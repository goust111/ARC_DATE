mbo/88e364bc/31/code.py:727:    if not bool(np.all(drilled_or_room[yellow_cells])):\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/31/code.py:735:    rooms = _build_chain(rng, grid, reserved, wall_color, direction)\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/31/code.py:736:    if rooms is None:\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/31/code.py:738:    if not _validate_topology(grid, rooms):\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/31/code.py:742:    if not _place_yellows(rng, rooms, direction, input_grid):\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/31/code.py:744:    if not _oracle_check(input_grid, rooms):\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/8/code.py:25:#    Small 1-cell-high corridor example moving right, listed from wall inward as [p0, p1, p2, p3, p4, p5, p6]:\n/home/lixinyu/snap/new/ceshi/code_combo/d59b0160/38/code.py:59:#     without turning the board into a maze.\n/home/lixinyu/snap/new/ceshi/code_combo/d59b0160/38/code.py:275:    \"\"\"Choose a compact rectangle that fits the local region and leaves room for peers.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/36a08778/33/code.py:3:# Name: 缺口穿透+通道宽度约束\n/home/lixinyu/snap/new/ceshi/code/8f3a5a89/D8/1/code.py:142:    Draw a 1-cell inner outline on the side of the maze that the corner marker can reach.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:9:   Original task: a 20x20 board contains 1-2 border legends and several irregular fenced rooms.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:10:   Yellow pixels move inside each enclosed room according to the direction encoded by the legend\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:11:   whose fill color matches that room's wall color.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:14:   10x10-12x12 and every enclosed room is now a strict axis-aligned rectangle with 1-cell-thick\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:17:   two separate orange rectangular rooms elsewhere on the board each contain 1-2 yellow pixels.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:19:   the room-recognition step is visually simpler because each room is an obvious rectangle.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:23:   over-simplifying into a single isolated yellow, the generator uses 1-2 rooms per sample and\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:24:   often places two rooms that share the same controlling legend color/direction. This repeated\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:30:   - Enclosed passable components must not touch the outer border: rectangular rooms are placed\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:32:   - Each room must have one dominant border color that maps to a legend color: each room uses a\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:34:   - If multiple yellows share a room, solver order matters: reverse construction respects the\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:38:   Rooms are placed by rectangle enumeration instead of random blob growth. Each room reserves its\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:39:   wall ring plus a one-cell moat, so rooms never overlap, never touch the legend, and never leak\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:44:   legend, rectangular rooms, and yellows sliding toward one side of each rectangle. No hidden\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:49:   A compact 4x4 cardinal legend leaves enough space for the rooms while preserving the same\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:66:    The dominant color of each legend rectangle is both the legend fill and the matching room-wall\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:148:    Slide yellow pixels inside compact rectangular rooms according to border legends.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:153:      matches the wall color of 1-2 interior rectangular rooms.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:154:    - Each room is a clean axis-aligned rectangle made from a 1-cell-thick colored wall, and the\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:155:      yellow pixels lie strictly inside those rooms.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:160:    - For every enclosed room, find the legend whose fill color matches that room's wall color.\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:161:    - Move all yellow pixels inside that room as far as possible in the decoded direction so they\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:165:    - The fusion changes the geometry, not the reasoning chain: the room is now an obvious\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:257:def _room_from_bbox(r0: int, c0: int, ih: int, iw: int) -> dict:\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:258:    \"\"\"Return wall/interior cell sets for a rectangular room.\"\"\"\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:293:def _room_candidates(occupied: np.ndarray, shapes: list[tuple[int, int]]) -> list[tuple[int, int, int, int]]:\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:311:def _place_rooms(rng: random.Random, occupied: np.ndarray, wall_color: int, direction: tuple[int, int]) -> list[dict] | None:\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:319:            rooms = []\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:321:            for room_idx in range(target_count):\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:324:                if target_count == 1 and room_idx == 0:\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:326:                candidates = _room_candidates(occ, shapes)\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:330:                room = _room_from_bbox(r0, c0, ih, iw)\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:331:                room[\"color\"] = wall_color\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:332:                room[\"dir\"] = direction\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:333:                rooms.append(room)\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:334:                _reserve_bbox(occ, room[\"bbox\"], 1)\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:335:            if len(rooms) == target_count:\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:336:                return rooms\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:409:def _place_yellows(rng: random.Random, rooms: list[dict], input_grid: np.ndarray) -> np.ndarray | None:\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:411:    for room in rooms:\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:412:        region_set = room[\"interior\"]\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:413:        dr, dc = room[\"dir\"]\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:430:        room[\"outputs\"] = set(outputs)\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:434:def _validate_topology(struct_grid: np.ndarray, rooms: list[dict]) -> bool:\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:443:    expected = [room[\"interior\"] for room in rooms]\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:460:    rooms = _place_rooms(rng, occupied, wall_color, direction)\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:461:    if not rooms:\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:464:    for room in rooms:\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/code.py:465:        for r, c in room[\"walls\"]:\n/home/lixinyu/snap/new/ceshi/code_combo/88e364bc/33/