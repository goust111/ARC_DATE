{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py',\n'/home/lixinyu/snap/new/ARC_code/train/6cbe9eb8.py',\n'/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py',\n'/home/lixinyu/snap/new/ARC_code/eval/89565ca0.py',\n'/home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py',\n'/home/lixinyu/snap/new/ARC_code/train/278e5215.py',\n'/home/lixinyu/snap/new/ARC_code/eval/581f7754.py',\n'/home/lixinyu/snap/new/ARC_code/train/458e3a53.py',\n]\nfor path in files:\n    print(f'FILE: {path}')\n    text = Path(path).read_text()\n    lines = text.splitlines()\n    for name in ('main', 'generate_input'):\n        start = None\n        for i, line in enumerate(lines):\n            if line.startswith(f'def {name}('):\n                start = i\n                break\n        if start is None:\n            continue\n        end = len(lines)\n        for j in range(start + 1, len(lines)):\n            if lines[j].startswith('def ') and not lines[j].startswith(f'def {name}('):\n                end = j\n                break\n        print(f'--- {name} ---')\n        for line in lines[start:end]:\n            print(line)\n        print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfiles = [\n'/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py',\n'/home/lixinyu/snap/new/ARC_code/train/6cbe9eb8.py',\n'/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py',\n'/home/lixinyu/snap/new/ARC_code/eval/89565ca0.py',\n'/home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py',\n'/home/lixinyu/snap/new/ARC_code/train/278e5215.py',\n'/home/lixinyu/snap/new/ARC_code/eval/581f7754.py',\n'/home/lixinyu/snap/new/ARC_code/train/458e3a53.py',\n]\nfor path in files:\n    print(f'FILE: {path}')\n    text = Path(path).read_text()\n    lines = text.splitlines()\n    for name in ('main', 'generate_input'):\n        start = None\n        for i, line in enumerate(lines):\n            if line.startswith(f'def {name}('):\n                start = i\n                break\n        if start is None:\n            continue\n        end = len(lines)\n        for j in range(start + 1, len(lines)):\n            if lines[j].startswith('def ') and not lines[j].startswith(f'def {name}('):\n                end = j\n                break\n        print(f'--- {name} ---')\n        for line in lines[start:end]:\n            print(line)\n        print()\nPY\"","aggregated_output":"FILE: /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\n--- main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\n\n\n--- generate_input ---\ndef generate_input():\n    for _ in range(_MAX_RETRIES):\n        r = _gen_attempt()\n        if r is not None:\n            return r\n    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n\nFILE: /home/lixinyu/snap/new/ARC_code/train/6cbe9eb8.py\n--- main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Rebuild the foreground rectangles as a largest-to-smallest lower-left nesting.\n\n    Input structure\n    - A periodic wallpaper background is overlaid by foreground colors that each form a rectangular frame or solid rectangle.\n    - The largest foreground rectangle is the output frame; smaller foreground rectangles are the objects to nest inside it.\n    - A frame may be partially hidden by a smaller rectangle, but its visible pixels still determine its bbox.\n\n    Rule\n    - Ignore the wallpaper and crop the result to the largest foreground rectangle's bbox size.\n    - Sort foreground rectangles by bbox area from largest to smallest.\n    - Reconstruct each frame or solid rectangle, placing every next smaller rectangle in the lower-left of the current rectangle's usable region.\n\n    Key insight\n    - The scattered background colors are not objects; the meaningful order is the unique descending rectangle size chain, and each step nests into the previous rectangle's lower-left interior.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n\n    items = _foreground_rectangles(g)\n    outer = items[0]\n    out = np.zeros((int(outer[\"height\"]), int(outer[\"width\"])), dtype=int)\n\n    region = _paint_item(out, outer, 0, 0)\n    for item in items[1:]:\n        rr, cc, rh, rw = region\n        h = int(item[\"height\"])\n        w = int(item[\"width\"])\n        assert h <= rh and w <= rw, \"nested rectangle must fit in parent usable region\"\n        r = rr + rh - h\n        c = cc\n        region = _paint_item(out, item, r, c)\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n_RNG = np.random.default_rng()\n\n# Colors and sentinels.\nCOLOR_VALUES, FOREGROUND_COLORS = tuple(range(10)), tuple(range(1, 10))\nTRANSPARENT = -1\n# Rectangle chain counts.\nITEM_COUNT_RANGE, THREE_ITEM_FRAME_OPTIONS = (3, 4), (1, 2)\nFOUR_ITEM_FRAME_COUNT = 2\n# Solid rectangle dimensions.\nINNER_SOLID_HEIGHT_RANGE, INNER_SOLID_WIDTH_RANGE = (2, 3), (2, 3)\nSECOND_SOLID_MAX_HEIGHT, SECOND_SOLID_MAX_WIDTH = 9, 9\n# Frame growth and bounds.\nFRAME_MIN_GROWTH, INNER_FRAME_MAX_GROWTH = 2, 5\nINNER_FRAME_MAX_HEIGHT, INNER_FRAME_MAX_WIDTH = 13, 11\nOUTER_FRAME_MIN_HEIGHT, OUTER_FRAME_MIN_WIDTH = 8, 8\nOUTER_FRAME_MAX_HEIGHT, OUTER_FRAME_MAX_WIDTH = 15, 13\n# Wallpaper canvas bounds and margin around the outer rectangle.\nCANVAS_HEIGHT_RANGE, CANVAS_WIDTH_RANGE = (13, 19), (22, 27)\nCANVAS_BORDER_MARGIN = 1\n# Wallpaper tile/color sampling.\nWALLPAPER_COLOR_COUNT_RANGE = (2, 4)\nZERO_WALLPAPER_ROLL_RANGE = (0, 4)\nZERO_WALLPAPER_THRESHOLD = 3\nTILE_SIZE_2 = 2\nTILE_SIZE_OPTIONS, TILE3_SIGN_OPTIONS = (2, 3), (1, 2)\n# Visibility/oracle retry limits.\nVISIBLE_OUTER_MIN_COMPONENT, MAX_VISIBLE_OUTER_COMPONENTS = 3, 4\nGENERATION_RETRY_LIMIT = 300\n\n\n\n--- generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid input\")\n\nFILE: /home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py\n--- main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert a rough nested line drawing into a clean canonical frame-and-dot diagram.\n\n    Input structure:\n    - The grid has one background color and one foreground color.\n    - Foreground 4-connected objects are rough closed frames or small filled blobs.\n    - Frames may contain other frames/blobs; blobs outside a frame remain outside it.\n\n    Rule:\n    - Detect the containment tree of foreground objects using holes of each frame object.\n    - Replace every blob with one foreground pixel.\n    - Replace every frame with a rectangular border padded two cells around its direct children.\n    - Place siblings by their original row/column overlap and order, with one empty cell between canonical objects.\n\n    Key insight: The exact wobbly geometry is irrelevant; only enclosure plus relative sibling positions define the output.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    fg_colors = sorted(set(map(int, g.flatten())) - {bg})\n    assert len(fg_colors) == 1\n    fg = int(fg_colors[0])\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[fg], return_format=\"dict\")\n    assert comps\n\n    nodes: list[_Node] = []\n    holes: list[list[np.ndarray]] = []\n    for comp in comps:\n        coords = np.asarray(comp[\"coords\"], dtype=int)\n        node = _Node(\n            coords=coords,\n            bbox=tuple(map(int, comp[\"bbox\"])),\n            center=coords.mean(axis=0),\n        )\n        node_holes = _component_holes(g.shape, coords)\n        node.is_frame = bool(node_holes)\n        nodes.append(node)\n        holes.append(node_holes)\n\n    assert any(node.is_frame for node in nodes)\n    for node_i, node in enumerate(nodes):\n        containers = []\n        for frame_i, frame in enumerate(nodes):\n            if node_i == frame_i or not frame.is_frame:\n                continue\n            if any(np.all(hole[tuple(node.coords.T)]) for hole in holes[frame_i]):\n                containers.append(frame)\n        if containers:\n            node.parent = min(containers, key=lambda item: int(item.coords.shape[0]))\n            node.parent.children.append(node)\n\n    roots = [node for node in nodes if node.parent is None]\n    mask = _layout_root(roots)\n    out = np.full(mask.shape, bg, dtype=int)\n    out[mask] = fg\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# ── CFG: tunable generation parameters ──────────────────────────────────────\n# Grid / canvas bounds\nGRID_MIN = 16              # minimum grid dimension (rows or cols)\nGRID_MAX = 25              # maximum grid dimension\nMAX_EXTRA_PAD = 12         # max total padding beyond drawing extent\nMAX_PAD_PER_SIDE = 6       # max padding on one side\n\n# Frame geometry\nFRAME_H_RANGE = (7, 20)    # allowed frame bbox height\nFRAME_W_RANGE = (7, 24)    # allowed frame bbox width\nFRAME_CORNER_MAX = 5       # max corner wobble displacement\nFRAME_MIN_EDGE = 2         # min straight-edge length between corners\nFRAME_TURN_RATIO = (0.34, 0.43)  # acceptable turn-ratio range for wobbly loops\nFRAME_RETRIES = 60         # retries per frame-mask generation\n\n# Blob geometry\nBLOB_SIZE_RANGE = (4, 11)  # blob pixel count range\nBLOB_BBOX_RANGE = (2, 5)   # blob bbox dimension range (exclusive upper)\n\n# Layout / arrangement\nARRANGE_GAP_COMPACT = (2, 3)   # inter-sibling gap range (compact mode)\nARRANGE_GAP_NORMAL = (2, 5)    # inter-sibling gap range (normal mode)\nARRANGE_EXTRA_SPAN = (0, 4)    # extra span added to cross-axis in arrangement\nFRAME_MARGIN_RANGE = (3, 5)    # margin around children inside a frame\nCOMPACT_MARGIN = 3             # fixed margin in compact mode\n\n# Outside blob placement\nOUTSIDE_GAP_RANGE = (2, 5)    # gap between frame and outside blob\n\n# Tree structure probabilities\nDEPTH1_PROB = 0.35             # probability of depth-1 (blobs-only) tree\nOUTSIDE_BLOB_PROB = 0.35       # probability of having an outside blob\nDEPTH1_INSIDE_RANGE = (1, 3)   # blobs inside single frame (depth-1)\nDEPTH2_INNER_BLOBS = (1, 2)    # blobs inside inner frame (depth-2)\nDEPTH2_OUTER_BLOBS = (0, 2)    # sibling blobs beside inner frame (depth-2)\nMAX_TOTAL_CHILDREN = 4         # max children before suppressing outside blob\n\n# Step-mix alternation bias\nSTEP_MIX_ALT_PROB = 0.7       # probability of alternating direction in corner wobble\n\n# Generation retry budget\nGEN_RETRIES = 300              # max attempts in generate_input()\n# ────────────────────────────────────────────────────────────────────────────\n\n\nclass _Obj:\n    def __init__(self, kind, children=None, outside_side=None):\n        self.kind = kind\n        self.children = list(children or [])\n        self.mask = None\n        self.rel = (0, 0)\n        self.pos = (0, 0)\n        self.outside_side = outside_side\n\n\n\n--- generate_input ---\ndef generate_input():\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 2d0172a1 input\")\n\nFILE: /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py\n--- main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert each colored partitioned frame into a horizontal bar whose length is its number of enclosed regions.\n\n    Input structure:\n    - Black background with several axis-aligned colored line drawings.\n    - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.\n    - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.\n\n    Rule:\n    - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.\n    - Count the 4-connected background regions fully enclosed by those reconstructed walls.\n    - The color with no enclosed region is the noise/pad color.\n    - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.\n\n    Key insight:\n    - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg == 0\n\n    counts: list[tuple[int, int, np.ndarray]] = []\n    for color in colors_present(g, exclude={bg}):\n        rooms = _room_count_for_color(g, int(color))\n        walls = _walls_for_color(g, int(color))\n        counts.append((int(color), int(rooms), walls))\n\n    drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]\n    pad_colors = [color for color, rooms, _walls in counts if rooms == 0]\n    assert drawings\n    assert len(pad_colors) == 1\n\n    pad = int(pad_colors[0])\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    for rooms in sorted({rooms for _color, rooms, _walls in drawings}):\n        group = [item for item in drawings if item[1] == rooms]\n        ordered.extend(_cover_order(g, group))\n\n    width = max(rooms for _color, rooms, _walls in ordered)\n\n    out = np.full((len(ordered), width), pad, dtype=int)\n    for r, (color, rooms, _walls) in enumerate(ordered):\n        out[r, :rooms] = int(color)\n    return out\n\n# --------------- generator (claude-opus-4-6) ---------------\n\n# ---- CFG: Tunable generation parameters ----\n_FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle\n_ROOM_COUNT_RANGE = (1, 6)            # rooms per frame\n_TIE_PROBABILITY = 0.35              # chance of one tied room-count pair\n_GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)\n    5: (25, 30, 25, 30, 16, 18),\n    4: (22, 30, 22, 30, 18, 22),\n    3: (20, 30, 20, 30, 22, 25),\n}\n_CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame\n_NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise\n_WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise\n_EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force\n_OVERLAP_RETRY = 100                 # attempts to place overlapping frame\n_GEN_RETRIES = 300                   # outer retry limit\n\n\n\n--- generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {_GEN_RETRIES} attempts\")\n\nFILE: /home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py\n--- main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the region enclosed by a wall sprite and radiate color outward through its opening.\n\n    Input structure:\n    - bg = most common color. Wall = most frequent non-bg color, forming a partial enclosure (e.g. U-shape).\n    - A fill-color pixel sits inside the enclosed area. Other non-bg pixels may act as obstacles.\n    Rule:\n    - Flood-fill the enclosed area with the fill color, radiating outward through the wall's open end.\n    - Obstacles cast \"shadows\" along the radiate direction, blocking fill behind them.\n\n    Key insight: The wall endpoints define the opening direction; fill radiates outward through it, and obstacles block propagation along that same axis.\n    \"\"\"\n    g = np.array(grid, copy=True)\n    h, w = g.shape\n\n    vals = np.unique(g)\n    bg = get_bg(g)\n\n    non_bg = [int(v) for v in vals if int(v) != bg]\n    assert non_bg, \"expected at least one non-background color\"\n\n    # Wall: most frequent non-background color.\n    wall = max(non_bg, key=lambda c: int((g == c).sum()))\n\n    wall_mask = g == wall\n\n    # Wall connected components (8-neigh).\n    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]\n    assert comps, \"expected at least one wall connected component\"\n\n    def sgn(x: int) -> int:\n        return (x > 0) - (x < 0)\n\n    other_colors = [c for c in non_bg if c != wall]\n    assert other_colors, \"expected at least one non-wall color (fill color)\"\n\n    # Pick fill color as the non-wall color closest (Manhattan distance) to the wall pixels.\n    wall_points = [p for comp in comps for p in comp]\n\n    def min_dist_to_wall(color: int) -> tuple[int, int]:\n        pts = list(zip(*np.where(g == color)))\n        pts = [(int(r), int(c)) for r, c in pts]\n        best_d = 10**9\n        for r, c in pts:\n            for wr, wc in wall_points:\n                d = abs(r - wr) + abs(c - wc)\n                if d < best_d:\n                    best_d = d\n                    if best_d == 0:\n                        return 0, len(pts)\n        return best_d, len(pts)\n\n    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))\n\n    fill_pos = list(zip(*np.where(g == fill)))\n    fill_pos = [(int(r), int(c)) for r, c in fill_pos]\n    if not fill_pos:\n        return g\n\n    # Choose the closest wall component to the fill seed (ties: larger component).\n    def comp_min_dist(comp: set[tuple[int, int]]) -> int:\n        best_d = 10**9\n        for r, c in fill_pos:\n            for wr, wc in comp:\n                d = abs(r - wr) + abs(c - wc)\n                if d < best_d:\n                    best_d = d\n                    if best_d == 0:\n                        return 0\n        return best_d\n\n    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))\n\n    comp_mask = np.zeros_like(wall_mask, dtype=bool)\n    for r, c in wall_comp:\n        comp_mask[r, c] = True\n\n    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:\n        out = []\n        for rr, cc in neighbors8(r, c):\n            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:\n                out.append((rr, cc))\n        return out\n\n    endpoints: list[tuple[int, int]] = []\n    for r, c in wall_comp:\n        if len(comp_neighbors(r, c)) == 1:\n            endpoints.append((r, c))\n\n    assert endpoints, \"expected wall component to have endpoints (degree-1 pixels)\"\n\n    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:\n        n1 = comp_neighbors(*ep)[0]\n        d1 = (sgn(n1[0] - ep[0]), sgn(n1[1] - ep[1]))  # inward\n        d_use = d1\n        is_12 = False\n        n2s = [p for p in comp_neighbors(*n1) if p != ep]\n        if n2s:\n            n2 = n2s[0]\n            d2 = (sgn(n2[0] - n1[0]), sgn(n2[1] - n1[1]))\n            if (d1[0] == 0) ^ (d1[1] == 0):\n                if d2[0] != 0 and d2[1] != 0:\n                    d_use = d2\n                    is_12 = True\n        return (-d_use[0], -d_use[1]), is_12\n\n    out_info = [outward_dir(ep) for ep in endpoints]\n    out_dirs = [d for d, _ in out_info]\n    tip_12 = [f for _, f in out_info]\n\n    dr_sum = sum(d[0] for d in out_dirs)\n    dc_sum = sum(d[1] for d in out_dirs)\n    rad = (sgn(dr_sum), sgn(dc_sum))\n\n    barrier = comp_mask.copy()\n\n    def add_ray(start: tuple[int, int], d: tuple[int, int], skip: int = 0) -> None:\n        rr, cc = start\n        for _ in range(skip):\n            rr += d[0]\n            cc += d[1]\n        while True:\n            rr += d[0]\n            cc += d[1]\n            if not (0 <= rr < h and 0 <= cc < w):\n                break\n            barrier[rr, cc] = True\n\n    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:\n        rr, cc = start\n        step = 0\n        while True:\n            step += 1\n            if step % 2 == 1:\n                rr += d[0]; cc += d[1]\n            else:\n                if rad[0] != 0:\n                    rr += d[0]\n                else:\n                    cc += d[1]\n            if not (0 <= rr < h and 0 <= cc < w):\n                break\n            barrier[rr, cc] = True\n\n    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):\n        if is_12:\n            add_ray_12(ep, d)\n        else:\n            add_ray(ep, d, skip=0)\n\n    passable = (~barrier) & ((g == bg) | (g == fill))\n    q = fill_pos[:]\n    seen = np.zeros_like(passable, dtype=bool)\n    for r, c in q:\n        if passable[r, c]:\n            seen[r, c] = True\n    while q:\n        r, c = q.pop()\n        for rr, cc in neighbors4(r, c):\n            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:\n                seen[rr, cc] = True\n                q.append((rr, cc))\n\n    filled_mask = (seen & (g == bg))\n\n    out = g.copy()\n    out[filled_mask] = fill\n\n    # Shadow behind obstacles (non-bg, non-fill, non-wall) along radiate direction.\n    obstacles = (g != bg) & (g != fill) & (g != wall)\n\n    def shadow_process(coords: list[tuple[int, int]]) -> None:\n        started = False\n        blocked = False\n        for r, c in coords:\n            if filled_mask[r, c]:\n                started = True\n            if started and obstacles[r, c]:\n                blocked = True\n                continue\n            if blocked and filled_mask[r, c]:\n                out[r, c] = bg\n                filled_mask[r, c] = False\n\n    if rad != (0, 0):\n        dr, dc = rad\n        if dr != 0 and dc == 0:\n            for c in range(w):\n                rows = range(h) if dr > 0 else range(h - 1, -1, -1)\n                shadow_process([(r, c) for r in rows])\n        elif dc != 0 and dr == 0:\n            for r in range(h):\n                cols = range(w) if dc > 0 else range(w - 1, -1, -1)\n                shadow_process([(r, c) for c in cols])\n        else:\n            # Diagonal scanlines\n            if dr == dc:\n                # r - c = const\n                for k in range(-(w - 1), h):\n                    coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]\n                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))\n                    shadow_process(coords)\n            else:\n                # r + c = const\n                for k in range(h + w - 1):\n                    coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]\n                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))\n                    shadow_process(coords)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom scipy.ndimage import distance_transform_cdt\n\n# -- Configuration constants --------------------------------------------------\n# Canvas size bounds\nGRID_H_VERT = (11, 18)       # height range when radiate_dir is vertical\nGRID_H_HORIZ = (8, 18)       # height range when radiate_dir is horizontal\nGRID_W = (15, 19)             # width range (all directions)\n\n# Wall geometry\nWALL_PIXELS_MIN = 17          # minimum wall pixel count\nWALL_PIXELS_MAX = 25          # maximum wall pixel count\nDEPTH_VERT = (5, 10)          # arm depth range for vertical radiate\nDEPTH_HORIZ = (6, 8)          # arm depth range for horizontal radiate\nGAP_VERT = (6, 7)             # endpoint gap for vertical radiate\nGAP_HORIZ = (5, 7)            # endpoint gap for horizontal radiate\nTIP_12_PROB = 0.5             # probability of 1:2 arm-angle mode (when eligible)\n\n# Placement margins\nOPEN_END_MARGIN = 3           # min cells from open end to radiate grid edge\n\n# Fill seed\nSEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]  # weighted choices for blob size\nSEED_DEPTH_LOOKBACK = 3       # seed must be within this many rows of closed end\n\n# Obstacles\nMAX_OBSTACLES = 5             # maximum obstacle pixel count\nOBSTACLE_IN_FILL_PROB = 0.65  # probability of forcing at least one obstacle in fill zone\nOBSTACLE_MIN_SEP = 2          # Chebyshev distance between obstacles (> this value)\n\n# Validation\nMIN_NEW_FILL = 20             # minimum newly-filled pixels for a valid output\nPALETTE_SIZE = (3, 5)         # number of distinct colors (bg + wall + fill + obstacle(s))\nGEN_RETRIES = 300             # max attempts in generate_input\n\n\n\n--- generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid b9e38dc0 input\")\n\nFILE: /home/lixinyu/snap/new/ARC_code/train/278e5215.py\n--- main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor the large mask crop column-by-column using the separate three-row palette strip.\n\n    Input structure:\n    - The background is the most common color.\n    - One large monochrome foreground object is the mask; its bbox is the output region and may contain background holes.\n    - The remaining foreground is a 3-row palette rectangle with the same width as the mask bbox: two identical color rows and one uniform row.\n\n    Rule:\n    - Crop to the mask object's bbox.\n    - For each output column, color mask pixels with the corresponding color from the repeated palette rows.\n    - Replace background holes inside the crop with the palette's uniform third-row color.\n\n    Key insight:\n    The grey object is only a stencil; its columns select colors from the legend, while its holes expose the legend's fill color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    mask_color = _unique_largest_non_bg_color(g, bg)\n\n    b = _mask_bbox(g, mask_color)\n    mask_crop = crop_bbox(g == int(mask_color), b)\n    height, width = map(int, mask_crop.shape)\n\n    column_colors, hole_color = _palette(g, bg, mask_color, width)\n    out = np.tile(column_colors, (height, 1))\n    out[~mask_crop] = hole_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, colors, and object bounds.\nBACKGROUND_COLOR, MASK_COLOR = 0, 5\nCOLOR_MIN, COLOR_MAX = 1, 9\nGRID_SIDE_MIN, GRID_SIDE_MAX = 10, 18\nMASK_SIDE_MIN, MASK_SIDE_MAX = 5, 10\nPALETTE_HEIGHT = 3\nGAP_MIN, GAP_MAX = 1, 3\n\n# Palette run construction.\nRUN_COUNT_OPTIONS = (4, 5)\nRUN_LENGTH_MIN, RUN_LENGTH_MAX = 1, 3\nCOLUMN_COLOR_DISTINCT_MIN, COLUMN_COLOR_DISTINCT_MAX = 3, 5\nUNUSED_COLOR_BIAS = 0.7\n\n# Mask density and retry budget.\nMASK_DENSITY_MIN, MASK_DENSITY_MAX = 0.60, 0.71\nGENERATION_ATTEMPTS = 300\n\n\n\n--- generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n\nFILE: /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\n--- main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\n\n--- generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 581f7754 input\")\n\nFILE: /home/lixinyu/snap/new/ARC_code/train/458e3a53.py\n--- main ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extract the compact table of solid cells hidden inside a separator lattice.\n\n    Input structure\n    - The grid has full-width and full-height bars of one separator color, dividing it into rectangular cells.\n    - Most cells contain a repeating multicolor pattern, while a contiguous rectangle of cells is solid monochrome.\n\n    Rule\n    - Split the input into lattice cells using the full separator rows and columns.\n    - Keep the cells whose full interior is one color, crop to their occupied rectangle, and output those colors.\n\n    Key insight\n    - The periodic pattern is noise; only completely solid lattice cells encode the reduced output grid.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    row_colors = {int(g[r, 0]) for r in range(h) if np.all(g[r, :] == g[r, 0])}\n    col_colors = {int(g[0, c]) for c in range(w) if np.all(g[:, c] == g[0, c])}\n    sep_colors = row_colors & col_colors\n    assert len(sep_colors) == 1, \"there must be exactly one row/column separator color\"\n    sep = next(iter(sep_colors))\n    assert row_colors == {sep}, \"all full rows must be separator rows\"\n    assert col_colors == {sep}, \"all full columns must be separator columns\"\n\n    sep_rows = [r for r in range(h) if np.all(g[r, :] == sep)]\n    sep_cols = [c for c in range(w) if np.all(g[:, c] == sep)]\n    assert sep_rows and sep_cols, \"separator lattice must have rows and columns\"\n\n    row_bands = _bands(h, sep_rows)\n    col_bands = _bands(w, sep_cols)\n\n    solid_cells = {}\n    for ri, (r0, r1) in enumerate(row_bands):\n        for ci, (c0, c1) in enumerate(col_bands):\n            cell = g[r0 : r1 + 1, c0 : c1 + 1]\n            if np.all(cell == cell[0, 0]):\n                solid_cells[(ri, ci)] = int(cell[0, 0])\n    assert solid_cells, \"must contain at least one solid lattice cell\"\n\n    solid_rows = [ri for ri, _ in solid_cells]\n    solid_cols = [ci for _, ci in solid_cells]\n    r0, r1 = min(solid_rows), max(solid_rows)\n    c0, c1 = min(solid_cols), max(solid_cols)\n\n    out = np.empty((r1 - r0 + 1, c1 - c0 + 1), dtype=int)\n    for ri in range(r0, r1 + 1):\n        for ci in range(c0, c1 + 1):\n            assert (ri, ci) in solid_cells, \"solid lattice cells must form a rectangle\"\n            out[ri - r0, ci - c0] = solid_cells[(ri, ci)]\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Lattice dimensions: valid (L, cell_size) pairs produce 27-30 square grids.\nVALID_LC = [(4, 6), (5, 5), (6, 4)]\nCOLOR_COUNT = 10\nSEPARATOR_WIDTH = 1\n# Solid rectangle: output block size in lattice coordinates.\nSOLID_SIZE_RANGE = (2, 3)\n# Pattern cells: diagonal variants are multicolor and solver-visible as non-solid.\nPATTERN_TILE_MIN_COLORS = 5\nPATTERN_CELL_MIN_COLORS = 2\nDIAGONAL_ID_BITS = 4\n# Retry budget: regenerate on rare validation failures.\nMAX_GENERATION_ATTEMPTS = 300\n\n\n\n--- generate_input ---\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 458e3a53 input\")\n\n","exit_code":0,"status":"completed"}}
