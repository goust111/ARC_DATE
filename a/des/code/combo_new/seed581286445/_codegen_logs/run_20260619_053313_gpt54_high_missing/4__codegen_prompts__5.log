{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '41,560p' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n# --------------- generator (attempt_1_distractor_network) ---------------\n\n# ========================== CFG ==========================\n# Canvas / grid\nGRID_H_RANGE = (8, 30)             # grid height bounds\nGRID_W_RANGE = (8, 30)             # grid width bounds\nBG_COLORS = [0, 5]                 # background color choices\n\n# Seeds\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n\n# Frame loops\nFRAME_COLORS_MAX = 4               # max distinct frame colors\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n\n# Line growth\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n\n# Distractor network\nDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\nDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\nDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\nDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\nDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\n\n# Generation\nGEN_RETRIES = 300                  # outer retry budget in generate_input()\n# =========================================================\n\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\nORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\ndef _in_bounds(h, w, r, c):\n    return 0 <= r < h and 0 <= c < w\n\n\n# ---------------------------------------------------------------------------\n# Frame geometry\n# ---------------------------------------------------------------------------\n\ndef _frame_ring_coords(r0, c0, ch, cw):\n    \"\"\"Return (ring_coords, cavity_coords) for a rounded-rect frame.\n\n    Frame bbox is [r0, r0+ch+1] x [c0, c0+cw+1] (inclusive).\n    Ring = bbox boundary minus 4 corners.\n    \"\"\"\n    H, W = ch + 2, cw + 2\n    ring = []\n    for dr in range(H):\n        for dc in range(W):\n            on_bdr = (dr == 0 or dr == H - 1 or dc == 0 or dc == W - 1)\n            corner = (dr in (0, H - 1)) and (dc in (0, W - 1))\n            if on_bdr and not corner:\n                ring.append((r0 + dr, c0 + dc))\n    cavity = [(r0 + 1 + dr, c0 + 1 + dc) for dr in range(ch) for dc in range(cw)]\n    return ring, cavity\n\n\ndef _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\n    \"\"\"Check that ring+cavity can be placed on canvas without conflicts.\n\n    Returns True if: ring and cavity cells are empty, no cavity cell is\n    8-adjacent to line_col, ring is not 8-adjacent to foreign colors, and\n    at least one ring cell is 8-adjacent to a line_col pixel.\n    \"\"\"\n    # Ring and cavity cells must all be empty\n    for rr, cc in ring:\n        if canvas[rr, cc] != -1:\n            return False\n    for rr, cc in cavity:\n        if canvas[rr, cc] != -1:\n            return False\n\n    # No cavity cell may be 8-adjacent to any line_col pixel\n    for cr, cc in cavity:\n        for nr, nc in neighbors8(cr, cc):\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n                return False\n\n    # Ring must not be 8-adjacent to any non-bg, non-line_col pixel\n    ring_set = set(ring)\n    for rr, cc in ring:\n        for nr, nc in neighbors8(rr, cc):\n            if not _in_bounds(h, w, nr, nc) or (nr, nc) in ring_set:\n                continue\n            v = canvas[nr, nc]\n            if v != -1 and v != line_col:\n                return False\n\n    # At least one ring cell must be 8-adjacent to a line_col pixel\n    for rr, cc in ring:\n        for nr, nc in neighbors8(rr, cc):\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n                return True\n    return False\n\n\n# ---------------------------------------------------------------------------\n# Line growth\n# ---------------------------------------------------------------------------\n\ndef _grow_line(grid, start, line_col, target_len, rng):\n    \"\"\"Grow a meandering 8-connected 1px-wide path of line_col from start.\"\"\"\n    h, w = grid.shape\n    path = [start]\n    dr_bias = 1 if start[0] < h // 2 else -1\n    dc_bias = 1 if start[1] < w // 2 else -1\n    cur = start\n    path_set = {start}\n    while len(path) < target_len:\n        # Build weighted direction list: diagonals preferred, bias-aligned boosted\n        dirs = []\n        for ddr, ddc in DIAG_DIRS:\n            aligned = (ddr == dr_bias or ddc == dc_bias)\n            w_d = DIAG_WEIGHT_ALIGNED if aligned else DIAG_WEIGHT_OTHER\n            dirs.extend([(ddr, ddc)] * w_d)\n        for ddr, ddc in ORTHO_DIRS:\n            aligned = (ddr == dr_bias and ddc == 0) or (ddc == dc_bias and ddr == 0)\n            w_d = ORTHO_WEIGHT_ALIGNED if aligned else ORTHO_WEIGHT_OTHER\n            dirs.extend([(ddr, ddc)] * w_d)\n        rng.shuffle(dirs)\n        placed = False\n        for ddr, ddc in dirs:\n            nr, nc = cur[0] + ddr, cur[1] + ddc\n            if not _in_bounds(h, w, nr, nc) or grid[nr, nc] != -1:\n                continue\n            # Keep path thin: reject if 8-adjacent to existing path (except cur)\n            if any((nnr, nnc) != cur and (nnr, nnc) in path_set\n                   for nnr, nnc in neighbors8(nr, nc)):\n                continue\n            # Strongly avoid grid border\n            if (nr == 0 or nc == 0 or nr == h - 1 or nc == w - 1) and rng.random() < BORDER_AVOIDANCE_PROB:\n                continue\n            cur = (nr, nc)\n            path.append(cur)\n            path_set.add(cur)\n            grid[nr, nc] = line_col\n            placed = True\n            break\n        if not placed:\n            if rng.random() < BIAS_FLIP_PROB:\n                dr_bias *= -1\n            if rng.random() < BIAS_FLIP_PROB:\n                dc_bias *= -1\n            break\n    return path\n\n\n# ---------------------------------------------------------------------------\n# Frame attachment\n# ---------------------------------------------------------------------------\n\ndef _halo_offsets(fh, fw):\n    \"\"\"Compute offsets around a frame bbox that lie outside it (the halo).\"\"\"\n    return [(dr, dc) for dr in range(-1, fh + 1) for dc in range(-1, fw + 1)\n            if not (0 <= dr < fh and 0 <= dc < fw)]\n\n\ndef _try_attach_frame(canvas, line_path, line_col, frame_col, rng, max_tries=FRAME_ATTACH_TRIES):\n    \"\"\"Try to place a frame loop 8-adjacent to some line pixel.\n\n    canvas is modified in place; returns (ring, cavity) or None on failure.\n    \"\"\"\n    h, w = canvas.shape\n    pad = FRAME_PLACEMENT_PAD\n    for _ in range(max_tries):\n        ch = rng.choice(CAVITY_SIZE_WEIGHTS)\n        cw = rng.choice(CAVITY_SIZE_WEIGHTS)\n        lp = rng.choice(line_path)\n        fh, fw = ch + 2, cw + 2\n        offsets = _halo_offsets(fh, fw)\n        rng.shuffle(offsets)\n        for dr, dc in offsets:\n            r0 = lp[0] - dr\n            c0 = lp[1] - dc\n            if r0 < pad or c0 < pad or r0 + fh > h - pad or c0 + fw > w - pad:\n                continue\n            ring, cavity = _frame_ring_coords(r0, c0, ch, cw)\n            if not _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\n                continue\n            for rr, cc in ring:\n                canvas[rr, cc] = frame_col\n            return ring, cavity\n    return None\n\n\ndef _try_attach_distractor_frame(canvas, frame_col, rng, max_tries=DISTRACTOR_FRAME_TRIES):\n    \"\"\"Place a loop in empty space, not touching any non-bg pixel.\"\"\"\n    h, w = canvas.shape\n    for _ in range(max_tries):\n        ch = rng.choice(DISTRACTOR_CAVITY_WEIGHTS)\n        cw = rng.choice(DISTRACTOR_CAVITY_WEIGHTS)\n        fh, fw = ch + 2, cw + 2\n        r0 = rng.randint(1, h - fh - 1)\n        c0 = rng.randint(1, w - fw - 1)\n        # Check the full bbox + 1-cell margin is empty\n        ok = True\n        for rr in range(r0 - 1, r0 + fh + 1):\n            for cc in range(c0 - 1, c0 + fw + 1):\n                if _in_bounds(h, w, rr, cc) and canvas[rr, cc] != -1:\n                    ok = False\n                    break\n            if not ok:\n                break\n        if not ok:\n            continue\n        ring, _ = _frame_ring_coords(r0, c0, ch, cw)\n        for rr, cc in ring:\n            canvas[rr, cc] = frame_col\n        return True\n    return None\n\n\ndef _try_place_distractor_network(canvas, line_col, frame_colors_pool, rng):\n    \"\"\"Place a disconnected line+frame distractor (no seed).\"\"\"\n    h, w = canvas.shape\n    for _ in range(DISTRACTOR_NETWORK_TRIES):\n        r = rng.randint(2, h - 3)\n        c = rng.randint(2, w - 3)\n        if any(canvas[r + dr, c + dc] != -1 for dr in range(-1, 2) for dc in range(-1, 2)):\n            continue\n        canvas[r, c] = line_col\n        target_len = rng.randint(*DISTRACTOR_LINE_LEN)\n        path = _grow_line(canvas, (r, c), line_col, target_len, rng)\n        if len(path) < 3:\n            for pr, pc in path:\n                canvas[pr, pc] = -1\n            continue\n        attached = 0\n        for _ in range(rng.randint(*DISTRACTOR_NETWORK_FRAMES)):\n            fc = rng.choice(frame_colors_pool)\n            if _try_attach_frame(canvas, path, line_col, fc, rng) is not None:\n                attached += 1\n        if attached > 0:\n            return True\n        for pr, pc in path:\n            canvas[pr, pc] = -1\n    return False\n\n\n# ---------------------------------------------------------------------------\n# Main generator\n# ---------------------------------------------------------------------------\n\ndef _corner_config(corner_kind, h, w, rng):\n    \"\"\"Return (seed_rc, first_line_rc) for corner_kind in {TL,TR,BL,BR}.\"\"\"\n    if corner_kind == 'TL':\n        seed = (0, 0)\n        first = rng.choice([(0, 1), (1, 0)])\n    elif corner_kind == 'TR':\n        seed = (0, w - 1)\n        first = rng.choice([(0, w - 2), (1, w - 1)])\n    elif corner_kind == 'BL':\n        seed = (h - 1, 0)\n        first = rng.choice([(h - 1, 1), (h - 2, 0)])\n    elif corner_kind == 'BR':\n        seed = (h - 1, w - 1)\n        first = rng.choice([(h - 1, w - 2), (h - 2, w - 1)])\n    else:\n        raise ValueError(corner_kind)\n    return seed, first\n\n\ndef _distribute_loop_budget(num_seeds, num_attached_target, rng):\n    \"\"\"Distribute attached-loop budget across seeds, guaranteeing >= 1 each.\"\"\"\n    seed_order = list(range(num_seeds))\n    rng.shuffle(seed_order)\n    per_seed = [0] * num_seeds\n    remaining = num_attached_target\n    # Guarantee at least 1 per seed\n    while remaining > 0 and any(per_seed[i] == 0 for i in range(num_seeds)):\n        for i in seed_order:\n            if per_seed[i] == 0 and remaining > 0:\n                per_seed[i] += 1\n                remaining -= 1\n    # Distribute remainder randomly\n    while remaining > 0:\n        per_seed[rng.choice(seed_order)] += 1\n        remaining -= 1\n    return per_seed\n\n\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\n    h = rng.randint(*GRID_H_RANGE)\n    w = rng.randint(*GRID_W_RANGE)\n    bg = rng.choice(BG_COLORS)\n    palette = [c for c in range(10) if c != bg]\n    rng.shuffle(palette)\n\n    num_seeds = rng.choice(SEED_COUNT_WEIGHTS)\n    if num_seeds * 2 > len(palette):\n        return None\n\n    canvas = -np.ones((h, w), dtype=int)\n\n    seed_colors = [palette.pop() for _ in range(num_seeds)]\n    line_colors = [palette.pop() for _ in range(num_seeds)]\n\n    all_corners = ['TL', 'TR', 'BL', 'BR']\n    rng.shuffle(all_corners)\n    corners_used = all_corners[:num_seeds]\n\n    num_frame_cols = rng.randint(1, min(FRAME_COLORS_MAX, len(palette)))\n    frame_colors_pool = [palette.pop() for _ in range(num_frame_cols)]\n\n    # Grow seed lines\n    lines_info = []\n    for i in range(num_seeds):\n        seed_rc, first_rc = _corner_config(corners_used[i], h, w, rng)\n        if canvas[seed_rc] != -1 or canvas[first_rc] != -1:\n            return None\n        canvas[seed_rc] = seed_colors[i]\n        canvas[first_rc] = line_colors[i]\n        target_len = rng.randint(LINE_LEN_RANGE[0], min(LINE_LEN_RANGE[1], h + w))\n        path = _grow_line(canvas, first_rc, line_colors[i], target_len, rng)\n        if len(path) < MIN_LINE_LEN:\n            return None\n        lines_info.append((seed_colors[i], seed_rc, line_colors[i], path))\n\n    # Decide loop counts and distribute across seeds\n    total_loops_target = rng.randint(num_seeds, TOTAL_LOOPS_MAX)\n    num_distractors_target = rng.randint(0, max(0, total_loops_target - num_seeds))\n    num_attached_target = total_loops_target - num_distractors_target\n    per_seed = _distribute_loop_budget(num_seeds, num_attached_target, rng)\n\n    # Attach frames to each seed's line\n    for i, (_, _, line_col, path) in enumerate(lines_info):\n        attached = 0\n        for _ in range(per_seed[i]):\n            fc = rng.choice(frame_colors_pool)\n            if _try_attach_frame(canvas, path, line_col, fc, rng) is not None:\n                attached += 1\n        if attached == 0:\n            return None\n\n    # Place distractors\n    if rng.random() < DISTRACTOR_NETWORK_PROB:\n        _try_place_distractor_network(canvas, rng.choice(line_colors), frame_colors_pool, rng)\n    else:\n        for _ in range(rng.randint(0, DISTRACTOR_SOLO_MAX)):\n            _try_attach_distractor_frame(canvas, rng.choice(frame_colors_pool), rng)\n\n    # Finalize grid\n    grid = np.where(canvas == -1, bg, canvas).astype(int)\n\n    # Validate bg is most common color\n    vals, cnts = np.unique(grid, return_counts=True)\n    if int(vals[np.argmax(cnts)]) != bg:\n        return None\n\n    # Validate each seed color appears exactly once\n    for seed_col, _, _, _ in lines_info:\n        if int((grid == seed_col).sum()) != 1:\n            return None\n\n    # Oracle check: solver must change at least one cell\n    try:\n        out = main(grid)\n    except Exception:\n        return None\n    if np.array_equal(out, grid):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exhausted attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '83,470p' /home/lixinyu/snap/new/ARC_code/train/d93c6891.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '83,470p' /home/lixinyu/snap/new/ARC_code/train/d93c6891.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each gray bar into its adjacent orange rectangle as full stripes from the contacted edge.\n\n    Input structure\n    - The scene uses black outside space, yellow fill, gray one-cell-thick bars, and solid orange rectangles.\n    - Each gray bar 4-touches exactly one orange rectangle; some orange rectangles have no touching gray bar.\n    - Gray bars touching the same orange rectangle all have the same orientation.\n\n    Rule\n    - Recolor every original gray cell to yellow.\n    - For each orange rectangle touched by gray bars, count the gray cells assigned to that rectangle.\n    - Horizontal gray bars repaint that many cells as complete orange rows starting from the contacted top or bottom row.\n    - Vertical gray bars repaint that many cells as complete orange columns starting from the contacted left or right column.\n    - Orange rectangles with no touching gray bar remain unchanged.\n\n    Key insight\n    - The gray pixels are not copied by shape; their count is transferred into the neighboring orange rectangle as edge-aligned row or column stripes.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    assert set(map(int, np.unique(g))) <= {Color.BLACK, Color.YELLOW, Color.GRAY, Color.ORANGE}\n\n    orange = find_components(g, bg=Color.YELLOW, colors=[Color.ORANGE], connectivity=4)\n    gray = find_components(g, bg=Color.YELLOW, colors=[Color.GRAY], connectivity=4)\n    assert orange and gray, \"expected orange rectangles and gray source bars\"\n\n    orange_index: dict[tuple[int, int], int] = {}\n    orange_bboxes: list[tuple[int, int, int, int]] = []\n    for i, obj in enumerate(orange):\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        assert obj[\"area\"] == bbox_h(obj[\"bbox\"]) * bbox_w(obj[\"bbox\"])\n        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == Color.ORANGE)\n        orange_bboxes.append((int(r0), int(c0), int(r1), int(c1)))\n        for r, c in obj[\"coords\"]:\n            orange_index[(int(r), int(c))] = i\n\n    source_by_target: dict[int, list[tuple[dict, list[tuple[int, int, int, int]]]]] = {}\n    for src in gray:\n        touched: dict[int, list[tuple[int, int, int, int]]] = {}\n        for sr_raw, sc_raw in src[\"coords\"]:\n            sr = int(sr_raw)\n            sc = int(sc_raw)\n            for tr, tc in neighbors4(sr, sc):\n                target_i = orange_index.get((int(tr), int(tc)))\n                if target_i is not None:\n                    touched.setdefault(target_i, []).append((int(tr), int(tc), sr, sc))\n\n        assert len(touched) == 1, \"each gray bar must touch exactly one orange rectangle\"\n        target_i = next(iter(touched))\n        source_by_target.setdefault(target_i, []).append((src, touched[target_i]))\n\n    out = g.copy()\n    out[g == Color.GRAY] = Color.YELLOW\n\n    for target_i, sources in source_by_target.items():\n        r0, c0, r1, c1 = orange_bboxes[target_i]\n        orientations = {_orientation(src[\"coords\"], contacts) for src, contacts in sources}\n        assert len(orientations) == 1, \"all gray bars for one orange rectangle must share orientation\"\n        count = sum(int(src[\"area\"]) for src, _contacts in sources)\n        contacts = [contact for _src, src_contacts in sources for contact in src_contacts]\n\n        if orientations == {\"horizontal\"}:\n            contact_rows = {tr for tr, _tc, _sr, _sc in contacts}\n            assert contact_rows <= {r0, r1}\n            _fill_rows(out, r0, c0, r1, c1, count, contact_rows)\n        else:\n            assert orientations == {\"vertical\"}\n            contact_cols = {tc for _tr, tc, _sr, _sc in contacts}\n            assert contact_cols <= {c0, c1}\n            _fill_cols(out, r0, c0, r1, c1, count, contact_cols)\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGRID_H_RANGE, GRID_W_RANGE = (10, 18), (14, 18)\nCONTENT_H_RANGE, CONTENT_W_RANGE = (6, 13), (12, 15)\nBORDER_RANGE = (0, 4)\n\nEDGES, HORIZONTAL_EDGES = (\"top\", \"bottom\", \"left\", \"right\"), (\"top\", \"bottom\")\nORANGE_COUNT_CHOICES, ORANGE_COUNT_WEIGHTS = [1, 2, 3, 4], [1, 2, 3, 4]\nORANGE_H_RANGE, ORANGE_W_RANGE = (1, 5), (2, 6)\nORANGE_AREA_RANGE = (4, 12)\nORANGE_PLACE_RETRIES = 80\n\nMAX_UNTOUCHED_ORANGES = 1\nBARS_PER_ORANGE_RANGE, TOTAL_BARS_RANGE = (1, 2), (2, 6)\nBAR_LENGTH_RANGE = (1, 7)\nBAR_COUNT_RETRIES = 50\n\nGENERATE_RETRIES = 300\n\n\ndef _place_orange(edge, cr0, cc0, cr1, cc1, occupied):\n    \"\"\"Try to place an orange rect flush against the given edge. Returns (or0,oc0,or1,oc1) or None.\"\"\"\n    for _ in range(ORANGE_PLACE_RETRIES):\n        oh = random.randint(*ORANGE_H_RANGE)\n        ow = random.randint(*ORANGE_W_RANGE)\n        if not (ORANGE_AREA_RANGE[0] <= oh * ow <= ORANGE_AREA_RANGE[1]):\n            continue\n        if edge in HORIZONTAL_EDGES:\n            or0 = cr0 if edge == 'top' else cr1 - oh + 1\n            or1 = or0 + oh - 1\n            lo, hi = cc0 + 1, cc1 - ow  # avoid touching perpendicular edges\n        else:\n            oc0 = cc0 if edge == 'left' else cc1 - ow + 1\n            oc1 = oc0 + ow - 1\n            lo, hi = cr0 + 1, cr1 - oh  # avoid touching perpendicular edges\n        if hi < lo:\n            continue\n        v = random.randint(lo, hi)\n        if edge in HORIZONTAL_EDGES:\n            oc0, oc1 = v, v + ow - 1\n        else:\n            or0, or1 = v, v + oh - 1\n        if or0 < cr0 or or1 > cr1 or oc0 < cc0 or oc1 > cc1:\n            continue\n        if occupied[or0:or1+1, oc0:oc1+1].any():\n            continue\n        return (or0, oc0, or1, oc1)\n    return None\n\n\ndef _make_canvas() -> tuple[np.ndarray, tuple[int, int, int, int]] | None:\n    content_h = random.randint(*CONTENT_H_RANGE)\n    content_w = random.randint(*CONTENT_W_RANGE)\n    border_top = random.randint(*BORDER_RANGE)\n    border_bottom = random.randint(*BORDER_RANGE)\n    border_left = random.randint(*BORDER_RANGE)\n    border_right = random.randint(*BORDER_RANGE)\n    grid_h = content_h + border_top + border_bottom\n    grid_w = content_w + border_left + border_right\n    if not (GRID_H_RANGE[0] <= grid_h <= GRID_H_RANGE[1] and GRID_W_RANGE[0] <= grid_w <= GRID_W_RANGE[1]):\n        return None\n\n    grid = np.full((grid_h, grid_w), Color.BLACK, dtype=int)\n    cr0, cc0 = border_top, border_left\n    cr1, cc1 = cr0 + content_h - 1, cc0 + content_w - 1\n    grid[cr0:cr1+1, cc0:cc1+1] = Color.YELLOW\n    return grid, (cr0, cc0, cr1, cc1)\n\n\ndef _place_oranges(content_box, occupied) -> list[tuple[str, int, int, int, int]] | None:\n    cr0, cc0, cr1, cc1 = content_box\n    num_orange = random.choices(ORANGE_COUNT_CHOICES, weights=ORANGE_COUNT_WEIGHTS)[0]\n    edges = random.sample(EDGES, num_orange)\n    orange_rects = []\n    for edge in edges:\n        result = _place_orange(edge, cr0, cc0, cr1, cc1, occupied)\n        if result is None:\n            return None\n        or0, oc0, or1, oc1 = result\n        occupied[or0:or1+1, oc0:oc1+1] = True\n        orange_rects.append((edge, or0, oc0, or1, oc1))\n    return orange_rects\n\n\ndef _choose_touched_oranges(num_orange):\n    max_untouched = min(MAX_UNTOUCHED_ORANGES, num_orange - 1)\n    num_untouched = random.randint(0, max_untouched) if num_orange > 1 else 0\n    indices = list(range(num_orange))\n    random.shuffle(indices)\n    untouched_set = set(indices[:num_untouched])\n    return [i for i in range(num_orange) if i not in untouched_set]\n\n\ndef _choose_bars_per_orange(touched_list):\n    for _ in range(BAR_COUNT_RETRIES):\n        bpo = [random.randint(*BARS_PER_ORANGE_RANGE) for _ in touched_list]\n        if TOTAL_BARS_RANGE[0] <= sum(bpo) <= TOTAL_BARS_RANGE[1]:\n            return bpo\n    return None\n\n\ndef _split_bar_lengths(total_gray, n_bars):\n    min_len, max_len = BAR_LENGTH_RANGE\n    if n_bars == 2 and total_gray >= 2:\n        lo_b1 = max(min_len, total_gray - max_len)\n        hi_b1 = min(total_gray - min_len, max_len)\n        if lo_b1 > hi_b1:\n            return None\n        b1 = random.randint(lo_b1, hi_b1)\n        return [b1, total_gray - b1]\n    if total_gray > max_len:\n        return None\n    return [total_gray]\n\n\ndef _place_bars(axis, fixed, span0, span1, lo_bound, hi_bound, bar_lengths, occupied):\n    placed_bars = []\n    for bl in bar_lengths:\n        sides = []\n        if span0 - lo_bound >= bl:\n            sides.append(0)\n        if hi_bound - span1 >= bl:\n            sides.append(1)\n        random.shuffle(sides)\n        placed = False\n        for s in sides:\n            b0 = (span0 - bl) if s == 0 else (span1 + 1)\n            b1 = b0 + bl - 1\n            cells = occupied[fixed, b0:b1+1] if axis == 'h' else occupied[b0:b1+1, fixed]\n            if b0 < lo_bound or b1 > hi_bound or cells.any():\n                continue\n            if axis == 'h':\n                occupied[fixed, b0:b1+1] = True\n                placed_bars.append(('h', fixed, b0, b1))\n            else:\n                occupied[b0:b1+1, fixed] = True\n                placed_bars.append(('v', b0, b1, fixed))\n            placed = True\n            break\n        if not placed:\n            return None\n    return placed_bars\n\n\ndef _plan_bars(orange_rects, touched_list, bpo, content_box, occupied):\n    \"\"\"Sample gray bars and return oracle metadata for expected output.\"\"\"\n    cr0, cc0, cr1, cc1 = content_box\n    bars_info = []\n    for idx, oi in enumerate(touched_list):\n        edge, or0, oc0, or1, oc1 = orange_rects[oi]\n        oh, ow = or1 - or0 + 1, oc1 - oc0 + 1\n        n_bars = bpo[idx]\n\n        if edge in HORIZONTAL_EDGES:\n            max_stripes, divisor = oh, ow\n        else:\n            max_stripes, divisor = ow, oh\n\n        stripe_count = random.randint(1, max_stripes)\n        total_gray = stripe_count * divisor\n        bar_lengths = _split_bar_lengths(total_gray, n_bars)\n        if bar_lengths is None:\n            return None\n\n        if edge == 'top':\n            bar_rc = or0\n        elif edge == 'bottom':\n            bar_rc = or1\n        elif edge == 'left':\n            bar_rc = oc0\n        else:\n            bar_rc = oc1\n        if edge in HORIZONTAL_EDGES:\n            placed_bars = _place_bars('h', bar_rc, oc0, oc1, cc0, cc1, bar_lengths, occupied)\n        else:\n            placed_bars = _place_bars('v', bar_rc, or0, or1, cr0, cr1, bar_lengths, occupied)\n        if placed_bars is None:\n            return None\n\n        bars_info.append((oi, placed_bars, edge, stripe_count))\n    return bars_info\n\n\ndef _render_input_grid(grid, orange_rects, bars_info):\n    for _, or0, oc0, or1, oc1 in orange_rects:\n        grid[or0:or1+1, oc0:oc1+1] = Color.ORANGE\n    for _, bars, _, _ in bars_info:\n        for bar in bars:\n            if bar[0] == 'h':\n                grid[bar[1], bar[2]:bar[3]+1] = Color.GRAY\n            else:\n                grid[bar[1]:bar[2]+1, bar[3]] = Color.GRAY\n\n\ndef _expected_output(grid, orange_rects, bars_info):\n    expected = grid.copy()\n    expected[grid == Color.GRAY] = Color.YELLOW\n    for oi, _, contact_side, stripe_count in bars_info:\n        _, or0, oc0, or1, oc1 = orange_rects[oi]\n        if contact_side == 'top':\n            expected[or0:or0+stripe_count, oc0:oc1+1] = Color.GRAY\n        elif contact_side == 'bottom':\n            expected[or1-stripe_count+1:or1+1, oc0:oc1+1] = Color.GRAY\n        elif contact_side == 'left':\n            expected[or0:or1+1, oc0:oc0+stripe_count] = Color.GRAY\n        else:\n            expected[or0:or1+1, oc1-stripe_count+1:oc1+1] = Color.GRAY\n    return expected\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    canvas = _make_canvas()\n    if canvas is None:\n        return None\n    grid, content_box = canvas\n    occupied = np.zeros(grid.shape, dtype=bool)\n\n    orange_rects = _place_oranges(content_box, occupied)\n    if orange_rects is None:\n        return None\n\n    touched_list = _choose_touched_oranges(len(orange_rects))\n    bpo = _choose_bars_per_orange(touched_list)\n    if bpo is None:\n        return None\n\n    bars_info = _plan_bars(orange_rects, touched_list, bpo, content_box, occupied)\n    if bars_info is None:\n        return None\n\n    _render_input_grid(grid, orange_rects, bars_info)\n    try:\n        output = main(grid)\n    except Exception:\n        return None\n    if not np.array_equal(output, _expected_output(grid, orange_rects, bars_info)):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATE_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATE_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
