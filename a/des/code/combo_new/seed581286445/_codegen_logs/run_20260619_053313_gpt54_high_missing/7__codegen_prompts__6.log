{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '6,120p;180,320p' /home/lixinyu/snap/new/ARC_code/train/41ace6b5.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Normalize vertical two-color bars between paired marker columns around the marker rows.\n\n    Input structure\n    - The background is the dominant color.\n    - A row of red marker pixels sits directly above a row of gray marker pixels\n      in the same alternating columns.\n    - The columns between adjacent markers contain vertical bars made from a\n      contiguous teal run above a contiguous blue run.\n\n    Rule\n    - Keep the marker pixels and all non-bar background cells fixed.\n    - Let h be the maximum teal-run height among the bar columns; paint teal in\n      every bar column for h rows ending at the red marker row.\n    - In each bar column, move its blue run to start at the gray marker row and\n      fill all lower cells in that column with maroon.\n\n    Key insight\n    - The marker rows are a baseline: teal is normalized into a common upper\n      band, while each blue run keeps its own height below the baseline.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H = g.shape[0]\n\n    blue = 1\n    red = 2\n    gray = 5\n    teal = 8\n    maroon = 9\n\n    red_coords = np.argwhere(g == red)\n    gray_coords = np.argwhere(g == gray)\n    assert red_coords.size > 0 and gray_coords.size > 0\n\n    red_rows = np.unique(red_coords[:, 0])\n    gray_rows = np.unique(gray_coords[:, 0])\n    assert len(red_rows) == 1 and len(gray_rows) == 1\n\n    red_row = int(red_rows[0])\n    gray_row = int(gray_rows[0])\n    assert gray_row == red_row + 1\n\n    marker_cols = np.where(g[red_row] == red)[0]\n    gray_cols = np.where(g[gray_row] == gray)[0]\n    assert marker_cols.size >= 2\n    assert np.array_equal(marker_cols, gray_cols)\n    assert np.all(np.diff(marker_cols) == 2)\n\n    bar_cols = [int((left + right) // 2) for left, right in zip(marker_cols, marker_cols[1:])]\n    assert bar_cols\n\n    max_teal_height = 0\n    blue_heights: list[int] = []\n\n    for c in bar_cols:\n        col = g[:, c]\n        non_bg_rows = np.where(col != bg)[0]\n        assert non_bg_rows.size > 0\n\n        first = int(non_bg_rows[0])\n        assert np.array_equal(non_bg_rows, np.arange(first, H))\n        assert np.all(np.isin(col[first:], [blue, teal]))\n\n        segment = col[first:]\n        blue_positions = np.where(segment == blue)[0]\n        teal_positions = np.where(segment == teal)[0]\n        assert blue_positions.size > 0 and teal_positions.size > 0\n        assert np.array_equal(teal_positions, np.arange(teal_positions.size))\n        assert np.array_equal(\n            blue_positions,\n            np.arange(teal_positions.size, teal_positions.size + blue_positions.size),\n        )\n\n        max_teal_height = max(max_teal_height, int(teal_positions.size))\n        blue_heights.append(int(blue_positions.size))\n\n    top_row = red_row - max_teal_height + 1\n    assert top_row >= 0\n\n    out = g.copy()\n    for c, blue_height in zip(bar_cols, blue_heights):\n        assert gray_row + blue_height <= H\n        out[:, c] = bg\n        out[top_row : red_row + 1, c] = teal\n        out[gray_row : gray_row + blue_height, c] = blue\n        out[gray_row + blue_height :, c] = maroon\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n_RNG = np.random.default_rng()\n\n# Colors.\nBG, BLUE, RED, GRAY, TEAL, MAROON = 7, 1, 2, 5, 8, 9\n# Canvas and marker layout.\nMIN_MARKERS, MAX_MARKERS_EXCL = 5, 9\nMARKER_STEP, MARKER_ROWS = 2, 2\nMIN_RED_ROW, MAX_RED_ROW = 2, 6\n# Bar height bounds.\nMIN_MAX_TEAL, MAX_MAX_TEAL_EXCL = 2, 5\nMIN_BLUE_HEIGHT, MIN_REQUIRED_BLUE_HEIGHT = 1, 2\nMIN_ROWS_BELOW_GRAY, MIN_INPUT_TEAL_HEIGHT = 2, 2\n# Retry budget.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _sample_layout():\n    \"\"\"Sample marker geometry and the output-side bar heights.\"\"\"\n    n_markers = int(_RNG.integers(MIN_MARKERS, MAX_MARKERS_EXCL))\n    size = MARKER_STEP * n_markers - 1\n    marker_cols = np.arange(0, size, MARKER_STEP)\n    bar_cols = np.arange(1, size, MARKER_STEP)\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        inp = _gen_attempt()\n        if inp is not None:\n            return inp\n    raise RuntimeError(\"failed to generate valid 41ace6b5 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '6,130p;427,560p' /home/lixinyu/snap/new/ARC_code/eval/3e6067c3.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Connect framed squares via colored bridges following a control-pixel sequence.\n\n    Input structure:\n    - bg = background. Border color forms equal-sized framed squares with unique inner fill colors.\n    - Control row below squares: colored pixels read left-to-right encode visitation order.\n\n    Rule:\n    - Start at the square matching first control color c0.\n    - For each consecutive pair (ci, ci+1), find the ci+1-colored square aligned in the same row or column band, preferring nearest.\n    - Draw a bridge colored ci between the pair, spanning the gap with inner-square thickness.\n\n    Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # border color = most common non-bg color\n    cnt = Counter(map(int, g.flatten()))\n    border = None\n    for col, _k in cnt.most_common():\n        if int(col) != int(bg):\n            border = int(col)\n            break\n    assert not (border is None)\n\n    # detect framed squares as connected components of the border color\n    lab, n = label_mask(g == int(border), connectivity=4)\n    frames: list[dict] = []\n    for cid in range(1, int(n) + 1):\n        pts = np.argwhere(lab == int(cid))\n        if int(pts.shape[0]) < 8:\n            continue\n        r0, c0 = pts.min(axis=0)\n        r1, c1 = pts.max(axis=0)\n        r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n        h = int(r1 - r0 + 1)\n        w = int(c1 - c0 + 1)\n        if h < 3 or w < 3:\n            continue\n\n        t = None\n        inner_col = None\n        for tt in range(1, int(min(h, w) // 2) + 1):\n            inner = g[int(r0 + tt) : int(r1 - tt) + 1, int(c0 + tt) : int(c1 - tt) + 1]\n            if inner.size == 0:\n                continue\n            if bool((inner == int(border)).any()):\n                continue\n            u = set(map(int, inner.flatten()))\n            if len(u) != 1:\n                continue\n\n            ok = True\n            if not bool((g[int(r0) : int(r0 + tt), int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r1 - tt) + 1 : int(r1) + 1, int(c0) : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c0) : int(c0 + tt)] == int(border)).all()):\n                ok = False\n            if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):\n                ok = False\n            if not ok:\n                continue\n\n            t = int(tt)\n            inner_col = int(next(iter(u)))\n            break\n\n        if t is None or inner_col is None:\n            continue\n\n        frames.append(\n            {\n                \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n                \"t\": int(t),\n                \"inner\": int(inner_col),\n                \"inner_bbox\": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),\n            }\n        )\n\n    assert not (not frames)\n\n    by: dict[int, list[dict]] = defaultdict(list)\n    for f in frames:\n        by[int(f[\"inner\"])].append(f)\n\n    max_frame_r = max(int(f[\"bbox\"][2]) for f in frames)\n\n    # control row = bottom-most row below the squares with >=2 non-bg pixels\n    ctrl_r = None\n    for r in range(int(H - 1), int(max_frame_r), -1):\n        if int((g[int(r)] != int(bg)).sum()) >= 2:\n            ctrl_r = int(r)\n            break\n    assert not (ctrl_r is None)\n\n    ctrl = [int(g[int(ctrl_r), int(c)]) for c in range(int(W)) if int(g[int(ctrl_r), int(c)]) != int(bg)]\n    assert not (len(ctrl) < 2)\n\n    def center(f: dict) -> tuple[int, int]:\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        return int((r0 + r1) // 2), int((c0 + c1) // 2)\n\n    def aligned(f1: dict, f2: dict) -> tuple[bool, bool]:\n        a = f1[\"inner_bbox\"]\n        b = f2[\"inner_bbox\"]\n        same_row = bool(int(a[0]) == int(b[0]) and int(a[2]) == int(b[2]))\n        same_col = bool(int(a[1]) == int(b[1]) and int(a[3]) == int(b[3]))\n        return same_row, same_col\n\n    # choose start frame\n    start_color = int(ctrl[0])\n    assert not (start_color not in by)\n    start_cands = by[start_color]\n    if len(start_cands) == 1:\n        cur = start_cands[0]\n    else:\n        nxt_color = int(ctrl[1])\n        nxt_cands = by.get(nxt_color, [])\n        best = None\n        bestf = None\n        for f in start_cands:\ndef generate_input() -> np.ndarray:\n    for _ in range(500):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid input after 500 attempts\")\n","exit_code":0,"status":"completed"}}
