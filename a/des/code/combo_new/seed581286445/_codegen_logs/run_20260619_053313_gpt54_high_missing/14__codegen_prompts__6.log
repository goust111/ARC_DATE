{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/320afe60.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, colors_present, find_components, get_bg, is_contiguous, paste\nimport itertools\nimport math\nimport random\n\n\nRED = Color.RED\nGREEN = Color.GREEN\n\n\ndef _component_mask(coords: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:\n    r0, c0, r1, c1 = bbox\n    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)\n    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True\n    return mask\n\n\ndef _has_flanked_boundary_gap(mask: np.ndarray) -> bool:\n    h, w = mask.shape\n\n    for c in range(w):\n        if not mask[0, c] and mask[0, :c].any() and mask[0, c + 1 :].any():\n            return True\n        if h > 1 and not mask[h - 1, c] and mask[h - 1, :c].any() and mask[h - 1, c + 1 :].any():\n            return True\n\n    for r in range(h):\n        if not mask[r, 0] and mask[:r, 0].any() and mask[r + 1 :, 0].any():\n            return True\n        if w > 1 and not mask[r, w - 1] and mask[:r, w - 1].any() and mask[r + 1 :, w - 1].any():\n            return True\n\n    return False\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide each foreground object horizontally to the edge indicated by whether its shape has an open notch.\n\n    Input structure:\n    - Yellow is the background and there is one blue foreground color.\n    - The foreground is split into separated 4-connected objects.\n    - Each object keeps its row span and shape in the output.\n\n    Rule:\n    - If an object's bbox border contains a background gap flanked by object pixels along that same border, slide it to the right edge and recolor it green.\n    - Otherwise slide the object to the left edge and recolor it red.\n    - Start from a blank background canvas; no moved objects overlap.\n\n    Key insight:\n    - The target side is encoded by the object's shape, not by its original position: open notches go right, while closed or solid shapes go left.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1, \"expected exactly one foreground color\"\n    fg = int(fg_colors[0])\n\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[fg])\n    assert components, \"expected at least one foreground object\"\n\n    out = np.full_like(g, bg)\n    W = g.shape[1]\n    for component in components:\n        bbox = tuple(map(int, component[\"bbox\"]))\n        r0, _c0, r1, _c1 = bbox\n        mask = _component_mask(component[\"coords\"], bbox)\n        h, w = mask.shape\n\n        has_open_notch = _has_flanked_boundary_gap(mask)\n        dst_c = W - w if has_open_notch else 0\n        color = GREEN if has_open_notch else RED\n        assert 0 <= dst_c and dst_c + w <= W, \"moved object must fit within the grid\"\n\n        dst = out[r0 : r1 + 1, dst_c : dst_c + w]\n        assert dst.shape == (h, w), \"destination slice must match object bbox\"\n        assert np.all(dst[mask] == bg), \"moved objects must not overlap\"\n        dst[mask] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and colors.\nBG, BLUE, RED, GREEN = Color.YELLOW, Color.BLUE, Color.RED, Color.GREEN\nGRID_H, GRID_W_MIN, GRID_W_MAX = 22, 19, 26\n\n# Object counts, dimensions, and row separation.\nOBJECT_COUNT_MIN, OBJECT_COUNT_MAX, NOTCH_OBJECT_COUNT = 3, 5, 2\nOBJECT_H_MIN, OBJECT_H_MAX, OBJECT_W_MIN, OBJECT_W_MAX = 2, 6, 2, 9\nMIN_ROW_GAP = 1\n\n# Shape density and carving probabilities.\nMIN_FILL_RATIO, CLOSED_LARGE_AREA_MIN = 0.64, 12\nNOTCH_INTERIOR_CARVE_PROB, EXTRA_CARVE_PROB = 0.45, 0.20\nCLOSED_CARVE_PROB_SMALL, CLOSED_CARVE_PROB_LARGE = 0.45, 0.88\n\n# Placement and retry limits.\nINTERIOR_COL_PAD, MAX_FOREGROUND_FRACTION = 1, 0.5\nGENERATION_RETRIES = 300\n\n\ndef _has_flanked_boundary_gap(mask: np.ndarray) -> bool:\n    h, w = mask.shape\n    for c in range(w):\n        if not mask[0, c] and mask[0, :c].any() and mask[0, c + 1 :].any():\n            return True\n        if h > 1 and not mask[h - 1, c] and mask[h - 1, :c].any() and mask[h - 1, c + 1 :].any():\n            return True\n    for r in range(h):\n        if not mask[r, 0] and mask[:r, 0].any() and mask[r + 1 :, 0].any():\n            return True\n        if w > 1 and not mask[r, w - 1] and mask[:r, w - 1].any() and mask[r + 1 :, w - 1].any():\n            return True\n    return False\n\n\ndef _patch(mask: np.ndarray, color: int) -> np.ndarray:\n    out = np.full(mask.shape, BG, dtype=int)\n    out[mask] = int(color)\n    return out\n\n\ndef _random_heights(n: int) -> list[int]:\n    usable = GRID_H - MIN_ROW_GAP * (n - 1)\n    choices = [\n        hs\n        for hs in itertools.product(range(OBJECT_H_MIN, OBJECT_H_MAX + 1), repeat=n)\n        if sum(hs) <= usable\n    ]\n    return list(random.choice(choices))\n\n\ndef _row_starts(heights: list[int]) -> list[int]:\n    free = GRID_H - sum(heights) - MIN_ROW_GAP * (len(heights) - 1)\n    gaps = [0] * (len(heights) + 1)\n    for _ in range(free):\n        gaps[random.randrange(len(gaps))] += 1\n\n    starts = []\n    r = gaps[0]\n    for i, h in enumerate(heights):\n        starts.append(r)\n        r += h\n        if i + 1 < len(heights):\n            r += MIN_ROW_GAP + gaps[i + 1]\n    return starts\n\n\ndef _carve_interior_rect(mask: np.ndarray, max_remove: int, probability: float) -> int:\n    if max_remove <= 0 or random.random() > probability:\n        return 0\n\n    h, w = mask.shape\n    choices = []\n    for r0 in range(1, h - 1):\n        for c0 in range(1, w - 1):\n            for r1 in range(r0, h - 1):\n                for c1 in range(c0, w - 1):\n                    area = (r1 - r0 + 1) * (c1 - c0 + 1)\n                    if area <= max_remove and np.all(mask[r0 : r1 + 1, c0 : c1 + 1]):\n                        choices.append((r0, c0, r1, c1, area))\n    if not choices:\n        return 0\n\n    r0, c0, r1, c1, area = random.choice(choices)\n    mask[r0 : r1 + 1, c0 : c1 + 1] = False\n    return int(area)\n\n\ndef _make_notch_mask(h: int, w: int) -> np.ndarray | None:\n    area = h * w\n    max_remove = area - math.ceil(area * MIN_FILL_RATIO)\n    edges = []\n    if w >= OBJECT_W_MIN + 1:\n        edges.extend([\"top\", \"bottom\"])\n    if h >= OBJECT_H_MIN + 1:\n        edges.extend([\"left\", \"right\"])\n    if not edges or max_remove < 1:\n        return None\n\n    mask = np.ones((h, w), dtype=bool)\n    edge = random.choice(edges)\n    edge_len = w if edge in {\"top\", \"bottom\"} else h\n    run = random.randint(1, min(edge_len - 2, max_remove))\n    start = random.randint(1, edge_len - run - 1)\n\n    if edge in {\"top\", \"bottom\"}:\n        depth = random.randint(1, min(h - 1, max_remove // run))\n        if edge == \"top\":\n            mask[:depth, start : start + run] = False\n        else:\n            mask[h - depth :, start : start + run] = False\n    elif edge == \"left\":\n        depth = random.randint(1, min(w - 1, max_remove // run))\n        mask[start : start + run, :depth] = False\n    else:\n        depth = random.randint(1, min(w - 1, max_remove // run))\n        mask[start : start + run, w - depth :] = False\n\n    removed = run * depth\n    removed += _carve_interior_rect(mask, max_remove - removed, NOTCH_INTERIOR_CARVE_PROB)\n    _carve_interior_rect(mask, max_remove - removed, EXTRA_CARVE_PROB)\n    if not _has_flanked_boundary_gap(mask):\n        return None\n    if not is_contiguous(mask.astype(int), background=0, connectivity=4):\n        return None\n    return mask\n\n\ndef _make_closed_mask(h: int, w: int) -> np.ndarray | None:\n    area = h * w\n    mask = np.ones((h, w), dtype=bool)\n    max_remove = area - math.ceil(area * MIN_FILL_RATIO)\n    probability = CLOSED_CARVE_PROB_LARGE if area >= CLOSED_LARGE_AREA_MIN else CLOSED_CARVE_PROB_SMALL\n    removed = _carve_interior_rect(mask, max_remove, probability)\n    _carve_interior_rect(mask, max_remove - removed, EXTRA_CARVE_PROB)\n    if _has_flanked_boundary_gap(mask):\n        return None\n    if not is_contiguous(mask.astype(int), background=0, connectivity=4):\n        return None\n    return mask\n\n\ndef _sample_layout() -> tuple[int, list[str], list[int], list[int]]:\n    W = random.randint(GRID_W_MIN, GRID_W_MAX)\n    n = random.randint(OBJECT_COUNT_MIN, OBJECT_COUNT_MAX)\n    kinds = [\"notch\"] * NOTCH_OBJECT_COUNT + [\"closed\"] * (n - NOTCH_OBJECT_COUNT)\n    random.shuffle(kinds)\n\n    heights = _random_heights(n)\n    starts = _row_starts(heights)\n    return W, kinds, heights, starts\n\n\ndef _sample_objects(grid_w: int, kinds: list[str], starts: list[int], heights: list[int]):\n    max_w = min(OBJECT_W_MAX, (grid_w - 1) // 2)\n\n    objects = []\n    for kind, r0, h in zip(kinds, starts, heights):\n        if kind == \"notch\":\n            widths = [w for w in range(OBJECT_W_MIN, max_w + 1) if w >= 3 or h >= 3]\n            w = random.choice(widths)\n            mask = _make_notch_mask(h, w)\n            color, edge_c = GREEN, grid_w - w\n        else:\n            w = random.randint(OBJECT_W_MIN, max_w)\n            mask = _make_closed_mask(h, w)\n            color, edge_c = RED, 0\n        if mask is None:\n            return None\n        objects.append((mask, r0, w, color, edge_c))\n    return objects\n\n\ndef _render_pair(objects, grid_w: int) -> tuple[np.ndarray, np.ndarray] | None:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/22208ba4.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import defaultdict\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the repeated boundary color's rectangles one block inward while leaving singleton boundary rectangles in place.\n\n    Input structure:\n    - The background is the most common color.\n    - Foreground objects are solid monochrome rectangles touching a grid corner.\n    - Exactly one foreground color appears as multiple separate 4-connected objects; other colors appear once.\n\n    Rule:\n    - Clear the multiple objects of the repeated color from their original positions.\n    - For each cleared rectangle, translate it away from the row and column border it touches by exactly its height and width.\n    - Keep singleton-color objects unchanged; overlapping translated rectangles of the same color merge.\n\n    Key insight:\n    - Multiplicity selects the moving color, and each boundary rectangle's touched edges determine its inward diagonal translation.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    by_color: dict[int, list[dict]] = defaultdict(list)\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        by_color[int(comp[\"color\"])].append(comp)\n\n    moving_colors = [color for color, comps in by_color.items() if len(comps) > 1]\n    assert len(moving_colors) == 1\n    moving_color = int(moving_colors[0])\n    moving_objects = by_color[moving_color]\n\n    out = g.copy()\n    for comp in moving_objects:\n        coords = comp[\"coords\"]\n        out[coords[:, 0], coords[:, 1]] = bg\n\n    for comp in moving_objects:\n        coords = comp[\"coords\"]\n        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n        height = int(r1 - r0 + 1)\n        width = int(c1 - c0 + 1)\n        assert int(comp[\"area\"]) == height * width\n\n        touches_top = r0 == 0\n        touches_bottom = r1 == H - 1\n        touches_left = c0 == 0\n        touches_right = c1 == W - 1\n        assert touches_top != touches_bottom\n        assert touches_left != touches_right\n\n        dr = height if touches_top else -height\n        dc = width if touches_left else -width\n        shifted = coords + np.array([dr, dc], dtype=int)\n        assert bool(\n            np.all(\n                (0 <= shifted[:, 0])\n                & (shifted[:, 0] < H)\n                & (0 <= shifted[:, 1])\n                & (shifted[:, 1] < W)\n            )\n        )\n\n        target = out[shifted[:, 0], shifted[:, 1]]\n        assert bool(np.all((target == bg) | (target == moving_color)))\n        out[shifted[:, 0], shifted[:, 1]] = moving_color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Corner and movement model.\nCORNERS = (\"TL\", \"TR\", \"BL\", \"BR\")\nDIAGONAL_PAIRS = ({\"TL\", \"BR\"}, {\"TR\", \"BL\"})\nINWARD_STEP_FACTOR = 2\nCOMPACT_CANVAS_FACTOR = 3\n\n# Canvas, object count, and retry bounds.\nGRID_ROW_BOUNDS = (7, 22)\nGRID_COL_BOUNDS = (7, 30)\nSQUARE_SIZE_BOUNDS = (1, 4)\nMOVING_COUNT_BOUNDS = (2, 4)\nGENERATION_RETRIES = 300\n\n# Color palette.\nCOLOR_VALUES = tuple(range(10))\n\ndef _corner_pos(corner: str, H: int, W: int, s: int) -> tuple[int, int]:\n    row = 0 if corner[0] == \"T\" else H - s\n    col = 0 if corner[1] == \"L\" else W - s\n    return row, col\n\n\ndef _shifted_pos(corner: str, H: int, W: int, s: int) -> tuple[int, int]:\n    row = s if corner[0] == \"T\" else H - INWARD_STEP_FACTOR * s\n    col = s if corner[1] == \"L\" else W - INWARD_STEP_FACTOR * s\n    return row, col\n\n\ndef _valid_sizes(s: int, moving_count: int) -> list[tuple[int, int]]:\n    sizes = []\n    min_h = max(GRID_ROW_BOUNDS[0], INWARD_STEP_FACTOR * s + 1)\n    min_w = max(GRID_COL_BOUNDS[0], INWARD_STEP_FACTOR * s + 1)\n    for H in range(min_h, GRID_ROW_BOUNDS[1] + 1):\n        for W in range(min_w, GRID_COL_BOUNDS[1] + 1):\n            bg_area = H * W - len(CORNERS) * s * s\n            if bg_area <= moving_count * s * s:\n                continue\n            compact = H < COMPACT_CANVAS_FACTOR * s and W < COMPACT_CANVAS_FACTOR * s\n            if moving_count == MOVING_COUNT_BOUNDS[1] - 1 and compact:\n                continue\n            sizes.append((H, W))\n    return sizes\n\n\ndef _pick_moving_corners(H: int, W: int, s: int, moving_count: int) -> set[str]:\n    if moving_count == len(CORNERS):\n        return set(CORNERS)\n    compact = H < COMPACT_CANVAS_FACTOR * s and W < COMPACT_CANVAS_FACTOR * s\n    if moving_count == MOVING_COUNT_BOUNDS[0] and compact:\n        return set(random.choice(DIAGONAL_PAIRS))\n    return set(random.sample(CORNERS, moving_count))\n\n\ndef _overlaps(a: tuple[int, int], b: tuple[int, int], s: int) -> bool:\n    ar, ac = a\n    br, bc = b\n    return ar < br + s and br < ar + s and ac < bc + s and bc < ac + s\n\n\ndef _sample_layout():\n    \"\"\"Return a collision-free layout tuple, or None when the sampled size cannot work.\"\"\"\n    s = random.randint(*SQUARE_SIZE_BOUNDS)\n    moving_count = random.randint(*MOVING_COUNT_BOUNDS)\n    sizes = _valid_sizes(s, moving_count)\n    if not sizes:\n        return None\n    H, W = random.choice(sizes)\n\n    moving = _pick_moving_corners(H, W, s, moving_count)\n    singletons = [corner for corner in CORNERS if corner not in moving]\n\n    shifted = {corner: _shifted_pos(corner, H, W, s) for corner in moving}\n    singleton_pos = {corner: _corner_pos(corner, H, W, s) for corner in singletons}\n    for moved_pos in shifted.values():\n        for kept_pos in singleton_pos.values():\n            if _overlaps(moved_pos, kept_pos, s):\n                return None\n    return H, W, s, moving, singletons, shifted, singleton_pos\n\n\ndef _sample_colors(singleton_count: int) -> tuple[int, int, list[int]]:\n    colors = list(COLOR_VALUES)\n    bg = random.choice(colors)\n    colors.remove(bg)\n    moving_color = random.choice(colors)\n    colors.remove(moving_color)\n    singleton_colors = random.sample(colors, singleton_count)\n    return bg, moving_color, singleton_colors\n\n\ndef _render_pair(H, W, s, bg, moving_color, moving, singletons, shifted, singleton_pos, singleton_colors):\n    \"\"\"Render the matching input/output grids for an accepted layout and palette.\"\"\"\n    rect = np.full((s, s), moving_color, dtype=int)\n    out = np.full((H, W), bg, dtype=int)\n    for corner in moving:\n        paste(out, rect, *shifted[corner])\n    for corner, color in zip(singletons, singleton_colors):\n        patch = np.full((s, s), color, dtype=int)\n        paste(out, patch, *singleton_pos[corner])\n\n    inp = out.copy()\n    for corner in moving:\n        r, c = shifted[corner]\n        inp[r : r + s, c : c + s] = bg\n    for corner in moving:\n        paste(inp, rect, *_corner_pos(corner, H, W, s))\n    return inp, out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    layout = _sample_layout()\n    if layout is None:\n        return None\n    H, W, s, moving, singletons, shifted, singleton_pos = layout\n    bg, moving_color, singleton_colors = _sample_colors(len(singletons))\n    inp, out = _render_pair(H, W, s, bg, moving_color, moving, singletons, shifted, singleton_pos, singleton_colors)\n    try:\n        return inp if np.array_equal(main(inp), out) else None\n    except AssertionError:\n        return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 22208ba4 input\")\n","exit_code":0,"status":"completed"}}
