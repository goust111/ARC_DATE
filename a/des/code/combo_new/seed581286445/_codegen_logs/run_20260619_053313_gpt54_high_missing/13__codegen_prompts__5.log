l] = a\n\n    if _most_common_color(grid) != bg:\n        return None\n\n    work = grid[:work_h]\n    portal_counts = Counter(int(work[r, c]) for cells in portals.values() for r, c in cells)\n    if any(count != 2 for count in portal_counts.values()):\n        return None\n\n    mapping = _color_mapping(grid, bg)\n    expected = _build_expected(grid, sources, portals, bg, mapping)\n    try:\n        actual = main(grid)\n    except Exception:\n        return None\n    if not np.array_equal(actual, expected):\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid portal-teleport ARC input\")\n","exit_code":0,"status":"completed"}}
