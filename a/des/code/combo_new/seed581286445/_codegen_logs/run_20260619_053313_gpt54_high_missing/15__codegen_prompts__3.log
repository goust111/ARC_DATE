{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/2601afb7.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import find_components, get_bg\n\n\ndef _extract_bars(g: np.ndarray, bg: int) -> list[dict[str, int]]:\n    height = g.shape[0]\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert len(components) >= 2\n\n    bars: list[dict[str, int]] = []\n    for comp in components:\n        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n        color = int(comp[\"color\"])\n        area = int(comp[\"area\"])\n\n        assert c0 == c1\n        assert r1 == height - 1\n        assert area == r1 - r0 + 1\n        assert bool(np.all(g[r0 : r1 + 1, c0] == color))\n\n        bars.append({\"color\": color, \"col\": c0, \"height\": area})\n\n    bars.sort(key=lambda bar: bar[\"col\"])\n    assert len({bar[\"col\"] for bar in bars}) == len(bars)\n    return bars\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Rotate each vertical bar's color one slot right and its height one slot left.\n\n    Input structure\n    - A dominant background surrounds several monochrome one-cell-wide vertical bars.\n    - Every bar is bottom-aligned and occupies a distinct column.\n    - The ordered bar slots are read from left to right.\n\n    Rule\n    - Keep the grid shape and the bar columns unchanged.\n    - At slot i, use the color from the previous slot cyclically.\n    - At slot i, use the height from the next slot cyclically.\n\n    Key insight\n    - Color and height are independent cyclic attributes of the ordered bar slots:\n      colors rotate right while heights rotate left.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height = g.shape[0]\n    bg = get_bg(g)\n    bars = _extract_bars(g, bg)\n\n    out = np.full_like(g, bg)\n    count = len(bars)\n    for i, bar in enumerate(bars):\n        color = bars[(i - 1) % count][\"color\"]\n        bar_height = bars[(i + 1) % count][\"height\"]\n        assert 1 <= bar_height <= height\n        out[height - bar_height : height, bar[\"col\"]] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n_RNG = np.random.default_rng()\n\n# Canvas/bar bounds.\nBAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE = 3, 6\nBACKGROUND_COLOR, MIN_BAR_HEIGHT = 7, 1\nBAR_COL_OFFSET, BAR_COL_STRIDE = 1, 2\n# Color and transform sampling.\nCOLOR_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nOUTPUT_COLOR_SHIFT, OUTPUT_HEIGHT_SHIFT = 1, -1\n# Retry limit.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _render_bars(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:\n    side = BAR_COL_STRIDE * n + BAR_COL_OFFSET\n    grid = np.full((side, side), BACKGROUND_COLOR, dtype=int)\n    for i, (color, bar_height) in enumerate(zip(colors, heights)):\n        col = BAR_COL_STRIDE * i + BAR_COL_OFFSET\n        grid[side - int(bar_height) : side, col] = int(color)\n    return grid\n\n\ndef _expected_output(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:\n    out_colors = np.roll(colors, OUTPUT_COLOR_SHIFT)\n    out_heights = np.roll(heights, OUTPUT_HEIGHT_SHIFT)\n    return _render_bars(n, out_colors, out_heights)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = int(_RNG.integers(BAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE))\n    side = BAR_COL_STRIDE * n + BAR_COL_OFFSET\n    colors = _RNG.choice(COLOR_POOL, size=n, replace=False)\n    heights = _RNG.integers(MIN_BAR_HEIGHT, side, size=n)\n    if len(set(map(int, heights))) == 1:\n        idx = int(_RNG.integers(n))\n        choices = [h for h in range(MIN_BAR_HEIGHT, side) if h != int(heights[idx])]\n        heights[idx] = int(_RNG.choice(choices))\n\n    grid = _render_bars(n, colors, heights)\n    if np.array_equal(main(grid), _expected_output(n, colors, heights)):\n        return grid\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/d749d46f.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import colors_present, find_components, get_bg\nimport random\n\n\ndef _assert_output_footprints_disjoint(dims: list[tuple[int, int]]) -> None:\n    occupied: set[tuple[int, int]] = set()\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {(r, cc) for r in range(short) for cc in range(c, c + long)}\n        assert not (occupied & cells), \"normalized output rectangles must not overlap\"\n        occupied |= cells\n        c += long + 1\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {\n            (r, cc)\n            for r in range(10 - long, 10)\n            for cc in range(c, c + short)\n        }\n        assert not (occupied & cells), \"normalized output rectangles must not overlap\"\n        occupied |= cells\n        c += short + 1\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Pack each solid foreground rectangle twice: wide across the top and tall from the bottom.\n\n    Input structure\n    The grid has one background color and one foreground color; the foreground forms\n    separate solid rectangles, ordered from left to right.\n\n    Rule\n    Build a 10-row background canvas whose width is the packed width of the wide\n    versions of the rectangles. For each source rectangle, paint a top-aligned\n    rectangle of shape min(h,w) by max(h,w), with one background column between\n    consecutive rectangles. Then, starting again from the left edge, paint a\n    bottom-aligned rectangle of shape max(h,w) by min(h,w) for each source rectangle,\n    again separated by one background column.\n\n    Key insight\n    The input rectangles are not copied in their original orientations; each object\n    contributes one horizontal-facing and one vertical-facing normalized rectangle,\n    preserving left-to-right object order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1\n    fg = fg_colors[0]\n\n    components = find_components(g, bg=bg, connectivity=4, colors=[fg])\n    assert components\n    components = sorted(components, key=lambda obj: (obj[\"bbox\"][1], obj[\"bbox\"][0]))\n\n    dims: list[tuple[int, int]] = []\n    for obj in components:\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        assert obj[\"area\"] == h * w\n        dims.append((h, w))\n\n    out_h = 10\n    out_w = sum(max(h, w) for h, w in dims) + len(dims) - 1\n    _assert_output_footprints_disjoint(dims)\n    out = np.full((out_h, out_w), bg, dtype=int)\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[:short, c : c + long] = fg\n        c += long + 1\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[out_h - long : out_h, c : c + short] = fg\n        c += short + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Color palette.\nCOLOR_VALUES = tuple(range(10))\n\n# Rectangle counts and dimensions.\nRECT_COUNT_MIN = 4\nRECT_COUNT_MAX = 6\nSHORT_SIDE_MIN = 1\nSHORT_SIDE_MAX = 3\nSIDE_SUM_MAX = 10\nLONG_SIDE_MAX = SIDE_SUM_MAX - SHORT_SIDE_MIN\n\n# Canvas and packing constraints.\nARC_GRID_MAX = 30\nOUTPUT_HEIGHT = 10\nGAP_WIDTH = 1\n\n# Retry policy.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_d749d46f_output_footprints_disjoint(dims):\n    occupied = set()\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {(r, c) for r in range(short) for c in range(col, col + long)}\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += long + GAP_WIDTH\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {\n            (r, c)\n            for r in range(OUTPUT_HEIGHT - long, OUTPUT_HEIGHT)\n            for c in range(col, col + short)\n        }\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += short + GAP_WIDTH\n\n    return True\n\n\ndef _sample_dimensions(n_rects):\n    \"\"\"Sample source rectangle dimensions under the output-width budget.\"\"\"\n    dims = []\n    remaining_budget = ARC_GRID_MAX - GAP_WIDTH * (n_rects - 1)\n\n    for i in range(n_rects):\n        rects_left = n_rects - i\n        min_needed = rects_left - 1\n        max_for_this = min(remaining_budget - min_needed, LONG_SIDE_MAX)\n        if max_for_this < SHORT_SIDE_MIN:\n            return None\n\n        short = random.randint(SHORT_SIDE_MIN, SHORT_SIDE_MAX)\n        max_long = min(SIDE_SUM_MAX - short, max_for_this)\n        if max_long < short:\n            short = SHORT_SIDE_MIN\n            max_long = min(LONG_SIDE_MAX, max_for_this)\n            if max_long < SHORT_SIDE_MIN:\n                return None\n\n        long = random.randint(short, max_long)\n        remaining_budget -= long\n\n        if random.random() < 0.5:\n            h, w = long, short\n        else:\n            h, w = short, long\n        dims.append((h, w))\n\n    return dims\n\n\ndef _input_shape(dims):\n    return max(h for h, _ in dims), sum(w for _, w in dims) + GAP_WIDTH * (len(dims) - 1)\n\n\ndef _background_is_dominant(dims, inp_h, inp_w):\n    fg_pixels = sum(h * w for h, w in dims)\n    total_pixels = inp_h * inp_w\n    bg_pixels = total_pixels - fg_pixels\n    return bg_pixels > fg_pixels\n\n\ndef _build_input_grid(dims, bg, fg, inp_h, inp_w):\n    grid = np.full((inp_h, inp_w), bg, dtype=int)\n    col = 0\n    for h, w in dims:\n        grid[:h, col:col + w] = fg\n        col += w + GAP_WIDTH\n    return grid\n\n\ndef _passes_solver_oracle(grid):\n    try:\n        out = main(grid)\n    except Exception:\n        return False\n    return out.shape[0] == OUTPUT_HEIGHT\n\n\ndef _gen_attempt():\n    \"\"\"Generate one valid input grid, or None when sampled dimensions fail constraints.\"\"\"\n    bg, fg = random.sample(COLOR_VALUES, 2)\n    n_rects = random.randint(RECT_COUNT_MIN, RECT_COUNT_MAX)\n    dims = _sample_dimensions(n_rects)\n    if dims is None:\n        return None\n\n    inp_h, inp_w = _input_shape(dims)\n    if inp_w > ARC_GRID_MAX:\n        return None\n    if not _gen_d749d46f_output_footprints_disjoint(dims):\n        return None\n    if inp_h > ARC_GRID_MAX or inp_h < 1:\n        return None\n    if not _background_is_dominant(dims, inp_h, inp_w):\n        return None\n\n    grid = _build_input_grid(dims, bg, fg, inp_h, inp_w)\n    if not _passes_solver_oracle(grid):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,300p' /home/lixinyu/snap/new/ARC_code/eval/9385bd28.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,300p' /home/lixinyu/snap/new/ARC_code/eval/9385bd28.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import get_bg\nimport random\nfrom collections import Counter\n\n\ndef _find_legend(g: np.ndarray, bg: int) -> tuple[int, list[tuple[int, int, int]]]:\n    \"\"\"\n    Legend is a vertical stack of pairs at bottom-left.\n    Each legend row: (marker_color at col c, fill_color at col c+1).\n    Returns (legend_col, entries) where entries are ordered bottom->top as (row, marker, fill).\n    \"\"\"\n    h, w = g.shape\n    start_r = None\n    start_c = None\n    for r in range(h - 1, -1, -1):\n        nz = np.flatnonzero(g[r, :] != bg)\n        if nz.size:\n            start_r = r\n            start_c = int(nz[0])\n            break\n    assert start_r is not None and start_c is not None and start_c < w - 1, \\\n        \"legend must exist at bottom-left with at least 2 columns\"\n\n    entries: list[tuple[int, int, int]] = []\n    c = start_c\n    for r in range(start_r, -1, -1):\n        nz = np.flatnonzero(g[r, :] != bg)\n        if nz.size == 0 or int(nz[0]) != c or int(g[r, c]) == bg:\n            break\n        marker = int(g[r, c])\n        fill = int(g[r, c + 1]) if c + 1 < w else bg\n        entries.append((r, marker, fill))\n    return c, entries\n\n\ndef _l_anchor_present(pts: set[tuple[int, int]], r: int, c: int, arm1: tuple[int, int], arm2: tuple[int, int]) -> bool:\n    \"\"\"\n    Marker corners are L-shapes:\n      TL: (r,c), (r,c+1), (r+1,c)\n      TR: (r,c), (r,c-1), (r+1,c)\n      BL: (r,c), (r,c+1), (r-1,c)\n      BR: (r,c), (r,c-1), (r-1,c)\n\n    This is more robust than checking only corner membership, especially when the bbox is 2-wide/2-tall\n    where L arms can overlap other bbox corners.\n    \"\"\"\n    (dr1, dc1) = arm1\n    (dr2, dc2) = arm2\n    return (r, c) in pts and (r + dr1, c + dc1) in pts and (r + dr2, c + dc2) in pts\n\n\ndef _diamond_mask(h: int, w: int, r0: int, r1: int, c0: int, c1: int, a: tuple[int, int], b: tuple[int, int]) -> np.ndarray:\n    \"\"\"\n    Mask for all cells inside [r0..r1]x[c0..c1] that lie on some shortest 4-neigh path between corners a and b:\n      dist(a,p) + dist(p,b) == dist(a,b)\n    \"\"\"\n    ar, ac = a\n    br, bc = b\n    dab = abs(ar - br) + abs(ac - bc)\n    m = np.zeros((h, w), dtype=bool)\n    for r in range(r0, r1 + 1):\n        for c in range(c0, c1 + 1):\n            if abs(r - ar) + abs(c - ac) + abs(r - br) + abs(c - bc) == dab:\n                m[r, c] = True\n    return m\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill rectangles between diagonal marker pairs using a color legend.\n\n    Input structure:\n    - bg grid with a vertical legend at the bottom-left: each row is a (marker_color, fill_color) pair.\n    - Scattered L-shaped corner markers of each marker color define opposite corners of axis-aligned rectangles.\n    - Some markers are solid 2×2 blocks instead of corner pairs.\n\n    Rule:\n    - Read legend bottom-to-top; for each entry find all pixels of that marker color.\n    - Determine which two bbox corners carry L-shaped anchors — the *other* diagonal defines the fill region.\n    - Fill the diamond (all shortest-path cells between those two corners) with the legend's fill color.\n    - Solid 2×2 marker blocks are simply recolored to the fill color.\n    - Later legend entries are protected from earlier fills.\n\n    Key insight: The L-shaped anchors sit on the marker diagonal; the fill goes on the opposite diagonal of the bounding box.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    bg = get_bg(g)\n    legend_c, entries = _find_legend(g, bg)\n    assert entries, \"legend must contain at least one (marker, fill) entry\"\n\n    legend_mask = np.zeros_like(g, dtype=bool)\n    for r, _, _ in entries:\n        if 0 <= r < h and 0 <= legend_c < w:\n            legend_mask[r, legend_c] = True\n        if 0 <= r < h and 0 <= legend_c + 1 < w:\n            legend_mask[r, legend_c + 1] = True\n\n    out = g.copy()\n\n    marker_order = [m for _, m, _ in entries]\n    marker_set = set(marker_order)\n\n    # Process legend entries bottom -> top; earlier entries must not destroy later marker pixels.\n    for i, (_, marker, fill) in enumerate(entries):\n        eff_fill = int(fill)\n        marker_pts = set(map(tuple, np.argwhere((g == marker) & (~legend_mask))))\n        if len(marker_pts) < 2:\n            continue\n\n        rs = [r for r, _ in marker_pts]\n        cs = [c for _, c in marker_pts]\n        rmin, rmax = min(rs), max(rs)\n        cmin, cmax = min(cs), max(cs)\n\n        # Protect legend cells and all marker pixels for entries that appear later (higher) in the legend.\n        future_markers = set(marker_order[i + 1 :])\n        protect = legend_mask.copy()\n        for fm in future_markers:\n            protect |= (g == fm) & (~legend_mask)\n\n        # Also protect current marker pixels in the common case (so markers remain visible),\n        # except when they form a solid 2x2 block (treated as a filled marker that gets recolored).\n        if rmax - rmin == 1 and cmax - cmin == 1 and len(marker_pts) == 4:\n            # Solid 2x2 marker: recolor these pixels directly.\n            block = np.zeros_like(g, dtype=bool)\n            for r, c in marker_pts:\n                block[r, c] = True\n            out[block & (~protect)] = eff_fill\n            continue\n        else:\n            protect |= (g == marker) & (~legend_mask)\n\n        if rmin == rmax or cmin == cmax:\n            continue\n\n        tl = (rmin, cmin)\n        tr = (rmin, cmax)\n        bl = (rmax, cmin)\n        br = (rmax, cmax)\n\n        tl_anchor = _l_anchor_present(marker_pts, tl[0], tl[1], (0, 1), (1, 0))\n        tr_anchor = _l_anchor_present(marker_pts, tr[0], tr[1], (0, -1), (1, 0))\n        bl_anchor = _l_anchor_present(marker_pts, bl[0], bl[1], (0, 1), (-1, 0))\n        br_anchor = _l_anchor_present(marker_pts, br[0], br[1], (0, -1), (-1, 0))\n\n        score_tlbr = int(tl_anchor) + int(br_anchor)\n        score_trbl = int(tr_anchor) + int(bl_anchor)\n        assert score_tlbr != 0 or score_trbl != 0, \"at least one diagonal must have an L-anchor\"\n        assert score_tlbr != score_trbl, \"diagonal scores must not tie (tie-break path is unreachable)\"\n        if score_tlbr > score_trbl:\n            a, b = tr, bl\n        else:\n            a, b = tl, br\n\n        diamond = _diamond_mask(h, w, rmin, rmax, cmin, cmax, a, b)\n        out[diamond & (~protect)] = eff_fill\n\n    return out\n\n# --------------- generator (C1) ---------------\n\n# ── CFG: canvas & grid ──────────────────────────────────────────────\nGRID_H_RANGE = (10, 19)          # grid height bounds\nGRID_W_RANGE = (10, 19)          # grid width bounds\n\n# ── CFG: legend ─────────────────────────────────────────────────────\nLEGEND_COL_RANGE = (0, 2)        # legend left column (marker at c, fill at c+1)\nLEGEND_ENTRY_RANGE = (2, 5)      # number of legend entries\n\n# ── CFG: marker types ──────────────────────────────────────────────\nNOOP_PROB = 0.3                  # prob of one noop entry (marker with no pixels)\nBLOCK_PROB = 0.25                # prob of one 2x2 block entry\n\n# ── CFG: L-pair bbox shape ──────────────────────────────────────────\nBBOX_H_MAX = 19                  # max bbox height\nBBOX_W_MAX = 12                  # max bbox width\nBBOX_SHAPE_WEIGHTS = [0.75, 0.15, 0.10]  # [both>=3, h=2/w>=4, h>=4/w=2]\nTLBR_PROB = 0.8                  # prob of TL-BR diagonal (vs TR-BL)\n\n# ── CFG: distractor ────────────────────────────────────────────────\nDISTRACTOR_PROB = 0.25           # prob of adding a non-legend L-pair\n\n# ── CFG: retry budgets ─────────────────────────────────────────────\nBLOCK_RETRIES = 100              # placement attempts for a 2x2 block\nLPAIR_RETRIES = 150              # placement attempts for an L-pair\nDISTRACTOR_RETRIES = 60          # placement attempts for distractor\nGEN_RETRIES = 300                # outer generate_input retry budget\n\n_L_OFFSETS = {\n    \"TL\": [(0, 0), (0, 1), (1, 0)],\n    \"TR\": [(0, 0), (0, -1), (1, 0)],\n    \"BL\": [(0, 0), (0, 1), (-1, 0)],\n    \"BR\": [(0, 0), (0, -1), (-1, 0)],\n}\n\n\ndef _l_pair_cells(rmin: int, cmin: int, rmax: int, cmax: int, diag: str) -> list[tuple[int, int]]:\n    \"\"\"Return the 6 cells for an L-pair at opposite bbox corners. diag in {'TLBR','TRBL'}.\"\"\"\n    if diag == \"TLBR\":\n        anchors = [(\"TL\", rmin, cmin), (\"BR\", rmax, cmax)]\n    else:\n        anchors = [(\"TR\", rmin, cmax), (\"BL\", rmax, cmin)]\n    cells: list[tuple[int, int]] = []\n    for name, r, c in anchors:\n        for dr, dc in _L_OFFSETS[name]:\n            cells.append((r + dr, c + dc))\n    return cells\n\n\ndef _l_pair_valid_bbox(h: int, w: int) -> bool:\n    \"\"\"True if (h, w) avoids an L-anchor score tie.\n\n    Fails for (2,2), (2,3), (3,2). Safe: h>=3 and w>=3, or h==2 and w>=4, or h>=4 and w==2.\n    \"\"\"\n    if h < 2 or w < 2:\n        return False\n    if h == 2 and w <= 3:\n        return False\n    if w == 2 and h <= 3:\n        return False\n    return True\n\n\ndef _pick_bbox_size(H: int, W: int) -> tuple[int, int] | None:\n    \"\"\"Pick a random valid L-pair bbox size that fits in (H, W).\"\"\"\n    shape_choice = random.choices(\n        [\"both_ge3\", \"h2_w_ge4\", \"h_ge4_w2\"],\n        weights=BBOX_SHAPE_WEIGHTS,\n    )[0]\n    if shape_choice == \"both_ge3\":\n        bh = random.randint(3, min(BBOX_H_MAX, H))\n        bw = random.randint(3, min(BBOX_W_MAX, W))\n    elif shape_choice == \"h2_w_ge4\":\n        bh = 2\n        w_hi = min(BBOX_W_MAX, W)\n        if w_hi < 4:\n            return None\n        bw = random.randint(4, w_hi)\n    else:\n        h_hi = min(BBOX_H_MAX, H)\n        if h_hi < 4:\n            return None\n        bh = random.randint(4, h_hi)\n        bw = 2\n    if bh > H or bw > W or not _l_pair_valid_bbox(bh, bw):\n        return None\n    return bh, bw\n\n\ndef _try_place_l_pair(H: int, W: int, color: int, retries: int,\n                      can_place, do_place) -> bool:\n    \"\"\"Try to place an L-pair of `color` on the grid within `retries` attempts.\n\n    Returns True on success, False if all attempts failed.\n    \"\"\"\n    for _ in range(retries):\n        size = _pick_bbox_size(H, W)\n        if size is None:\n            continue\n        bh, bw = size\n        rmin = random.randint(0, H - bh)\n        cmin = random.randint(0, W - bw)\n        diag = \"TLBR\" if random.random() < TLBR_PROB else \"TRBL\"\n        cells = _l_pair_cells(rmin, cmin, rmin + bh - 1, cmin + bw - 1, diag)\n        if can_place(cells):\n            do_place(cells, color)\n            return True\n    return False\n\n\ndef _build_legend(H, W, bg):\n    \"\"\"Create legend entries and the corresponding grid/mask arrays.\n\n    Returns (grid, legend_rows, legend_mask, legend_c, legend_bot) or None on failure.\n    \"\"\"\n    legend_c = random.randint(*LEGEND_COL_RANGE)\n    legend_bot = random.choice([H - 1, H - 2])\n    n_entries = random.randint(*LEGEND_ENTRY_RANGE)\n    if legend_bot - n_entries + 1 < 0:\n        return None\n\n    pool = [c for c in range(10) if c != bg]\n    if len(pool) < n_entries:\n        return None\n    marker_colors = random.sample(pool, n_entries)\n\n    grid = np.full((H, W), bg, dtype=int)\n    legend_rows: list[tuple[int, int, int]] = []\n    legend_mask = np.zeros((H, W), dtype=bool)\n    for i in range(n_entries):\n        r = legend_bot - i\n        m = marker_colors[i]\n        fill = random.randint(0, 9)\n        legend_rows.append((r, m, fill))\n        grid[r, legend_c] = m\n        legend_mask[r, legend_c] = True\n","exit_code":0,"status":"completed"}}
