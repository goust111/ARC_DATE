ghbors bg) act as anchors.\n  15: \n  16:     Rule:\n  17:     - Match each sprite to the border anchor sharing its marker color.\n  18:     - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n  19:     - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n  20: \n  21:     Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n  22:     \"\"\"\n  23:     g = np.array(grid, dtype=int)\n  24:     H, W = g.shape\n  25:     bg = int(get_bg(g))\n  26: \n  27:     def is_border(r: int, c: int) -> bool:\n  28:         return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n  29: \n  30:     # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n  31:     anchors_by_color: dict[int, tuple[int, int]] = {}\n  32:     for r in range(H):\n  33:         for c in range(W):\n  34:             if not is_border(r, c):\n  35:                 continue\n  36:             v = int(g[r, c])\n  37:             if v == int(bg):\n  38:                 continue\n  39:             ok = True\n  40:             for rr, cc in neighbors4(int(r), int(c)):\n  41:                 if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n  42:                     ok = False\n  43:                     break\n  44:             if ok and v not in anchors_by_color:\n  45:                 anchors_by_color[int(v)] = (int(r), int(c))\n  46: \n  47:     assert not (not anchors_by_color)\n  48: \n  49:     anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n  50: \n  51:     # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n  52:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n  53: \n  54:     def component_marker_color(coords: np.ndarray) -> int | None:\n  55:         # For multi-color sprites, the marker color is the least frequent color inside the component.\n  56:         vals = [int(g[int(r), int(c)]) for r, c in coords]\n  57:         cnt = Counter(vals)\n  58:         if len(cnt) <= 1:\n  59:             return None\n  60:         return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n  61: \n  62:     def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n  63:         # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n  64:         pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n  65:         if not pts:\n  66:             return None\n  67:         if len(pts) == 1:\n  68:             return pts[0]\n  69:         S = {(int(r), int(c)) for r, c in coords}\n  70:         for r, c in pts:\n  71:             for rr, cc in neighbors4(int(r), int(c)):\n  72:                 if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n  73:                     return (int(r), int(c))\n  74:         return pts[0]\n  75: \n  76:     moves: list[tuple[np.ndarray, int, int]] = []\n  77: \n  78:     for comp in comps:\n  79:         coords = comp[\"coords\"]\n  80:         if coords.size == 0:\n  81:             continue\n  82: \n  83:         # --- STEP 3) Decide marker color for this component. ---\n  84:         marker_col = component_marker_color(coords)\n  85:         if marker_col is None:\n  86:             # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n  87:             if int(coords.shape[0]) != 1:\n  88:                 continue\n  89:             r, c = map(int, coords[0])\n  90:             v = int(g[r, c])\n  91:             if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n  92:                 continue\n  93:             marker_col = int(v)\n  94: \n  95:         if int(marker_col) not in anchors_by_color:\n  96:             continue\n  97: \n  98:         mp = marker_pixel(coords, int(marker_col))\n  99:         if mp is None:\n 100:             continue\n 101: \n 102:         ar, ac = anchors_by_color[int(marker_col)]\n 103: \n 104:         # --- STEP 4) Compute translation (dr,dc). ---\n 105:         on_top_bottom = int(ar) in (0, int(H - 1))\n 106:         on_left_right = int(ac) in (0, int(W - 1))\n 107:         horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n 108: \n 109:         dr = 0\n 110:         dc = 0\n 111:         if horizontal:\n 112:             dc = int(ac - mp[1])\n 113:         else:\n 114:             dr = int(ar - mp[0])\n 115: \n 116:         moves.append((coords, int(dr), int(dc)))\n 117: \n 118:     out = g.copy()\n 119: \n 120:     # --- STEP 5) Apply all moves. ---\n 121:     # Clear moved components first (prevents collisions with their original locations).\n 122:     for coords, _dr, _dc in moves:\n 123:         out[coords[:, 0], coords[:, 1]] = int(bg)\n 124: \n 125:     # Paste moved components:\n 126:     # - clip out-of-bounds pixels\n 127:     # - do not overwrite existing non-bg pixels\n\n 574: \n 575: def _generated_grid_is_valid(inp, out, bg):\n 576:     \"\"\"Apply generator invariants and the solver oracle check.\"\"\"\n 577:     if not _bg_is_mode(inp, bg):\n 578:         return False\n 579:     return bool(np.array_equal(main(inp), out))\n 580: \n 581: \n 582: def generate_input() -> np.ndarray:\n 583:     for _ in range(_GEN_RETRY_LIMIT):\n 584:         grid = _gen_attempt()\n 585:         if grid is not None:\n 586:             return grid\n 587:     raise RuntimeError(\"failed to generate a valid 581f7754 input\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/5adee1b2.py =====\n   1: import numpy as np\n   2: \n   3: from arc_utils import find_components, get_bg, is_contiguous, object_interior\n   4: import random\n   5: \n   6: \n   7: def main(grid: np.ndarray) -> np.ndarray:\n   8:     \"\"\"\n   9:     Use the left-edge color legend to draw a padded rectangular halo around each matching object while preserving enclosed holes.\n  10: \n  11:     Input structure:\n  12:     - The grid has a dominant background color.\n  13:     - One or more two-row markers sit on the left edge; each marker is a 2x2 block whose left column is an object color and right column is its halo color.\n  14:     - Away from the markers, every source color from the legend appears as one or more 4-connected monochrome objects.\n  15: \n  16:     Rule:\n  17:     - Keep the input pixels unchanged.\n  18:     - For each source-color object, take its tight bbox expanded by one cell and clipped to the grid.\n  19:     - Recolor background pixels in that expanded region to the marker's halo color, except for background holes enclosed by the object.\n  20: \n  21:     Key insight:\n  22:     - The small left-edge bars are a legend: they map object colors to the colors used for the surrounding padded bbox.\n  23:     \"\"\"\n  24:     g = np.asarray(grid, dtype=int)\n  25:     bg = int(get_bg(g))\n  26:     out = g.copy()\n  27:     h, w = g.shape\n  28: \n  29:     markers: dict[int, int] = {}\n  30:     marker_source_cells: dict[int, set[tuple[int, int]]] = {}\n  31:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\"):\n  32:         r0, c0, r1, c1 = comp[\"bbox\"]\n  33:         height = int(r1 - r0 + 1)\n  34:         if c0 != 0 or c1 != 1 or height != 2 or int(comp[\"area\"]) != 4:\n  35:             continue\n  36: \n  37:         sub = g[r0 : r1 + 1, c0 : c1 + 1]\n  38:         assert np.all(sub != bg), \"legend marker must be a full 2x2 foreground block\"\n  39:         assert np.all(sub[:, 0] == sub[0, 0]), \"legend source column must be monochrome\"\n  40:         assert np.all(sub[:, 1] == sub[0, 1]), \"legend halo column must be monochrome\"\n  41:         source = int(sub[0, 0])\n  42:         halo = int(sub[0, 1])\n  43:         assert source != halo, \"legend source and halo colors must differ\"\n  44:         assert source not in markers, \"each source color must have exactly one legend marker\"\n  45: \n  46:         markers[source] = halo\n  47:         marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp[\"coords\"] if int(g[tuple(coord)]) == source}\n  48: \n  49:     assert markers, \"expected at least one left-edge legend marker\"\n  50: \n  51:     for source, halo in markers.items():\n  52:         objects = []\n  53:         for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format=\"dict\"):\n  54:             cells = {tuple(map(int, coord)) for coord in comp[\"coords\"]}\n  55:             if cells <= marker_source_cells[source]:\n  56:                 continue\n  57:             objects.append(comp)\n  58:         assert objects, \"each legend source color must label at least one non-marker object\"\n  59: \n  60:         for obj in objects:\n  61:             r0, c0, r1, c1 = obj[\"bbox\"]\n  62:             pr0 = max(0, int(r0) - 1)\n  63:             pc0 = max(0, int(c0) - 1)\n  64:             pr1 = min(h - 1, int(r1) + 1)\n  65:             pc1 = min(w - 1, int(c1) + 1)\n  66: \n  67:             patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)\n  68:             coords = obj[\"coords\"]\n  69:             patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source\n  70:             enclosed = object_interior(patch, background=bg)\n  71:             fill_mask = (patch == bg) & ~enclosed\n  72: \n  73:             input_region = g[pr0 : pr1 + 1, pc0 : pc1 + 1]\n  74:             target = out[pr0 : pr1 + 1, pc0 : pc1 + 1]\n  75:             assert np.all(input_region[fill_mask] == bg), \"halo cells must be background in the input\"\n  76:             assert np.all((target[fill_mask] == bg) | (target[fill_mask] == halo)), \"halo regions must not conflict\"\n  77:             target[fill_mask] = halo\n  78: \n  79:     return out\n  80: \n  81: # --------------- generator (att1, Claude) ---------------\n  82: \n  83: # Canvas and color palette.\n  84: BACKGROUND = 0\n  85: GRID_SIZE_MIN, GRID_SIZE_MAX = 20, 26\n  86: AVAILABLE_COLORS = tuple(range(1, 10))\n  87: \n  88: # Legend layout.\n  89: LEGEND_SOURCE_COL, LEGEND_HALO_COL = 0, 1\n  90: LEGEND_MARKER_SIZE, LEGEND_VERTICAL_GAP = 2, 3\n  91: \n  92: # Sprite geometry and acceptance.\n  93: SPRITE_SIZE, SPRITE_MIRROR_COLS = 5, 3\n  94: SPRITE_AREA_MIN, SPRITE_AREA_MAX = 12, 16\n  95: SPRITE_FILL_JITTER, MAX_INTERIOR_HOLES = 0.05, 3\n  96: SPRITE_RETRIES = 300\n  97: \n  98: # Object counts and placement.\n  99: INSTANCE_MIN, INSTANCE_MAX = 1, 3\n 100: OBJECT_MIN_COL, EDGE_CLIP_MARGIN = 2, 1\n 101: EDGE_CLIP_PROB, HALO_PADDING = 0.1, 1\n 102: PLACEMENT_RETRIES = 200\n 103: \n 104: # Whole-sample retry budget.\n 105: GENERATION_RETRIES = 300\n 106: \n 107: \n 108: def _make_sprite(color):\n 109:     \"\"\"Construct one LR-symmetric 4-connected sprite matching the configured area/hole bounds.\"\"\"\n 110:     target_area = random.randint(SPRITE_AREA_MIN, SPRITE_AREA_MAX)\n 111:     for _ in range(SPRITE_RETRIES):\n 112:         fill_p = target_area / (SPRITE_SIZE * SPRITE_SIZE) + random.uniform(-SPRITE_FILL_JITTER, SPRITE_FILL_JITTER)\n 113:         sprite = np.zeros((SPRITE_SIZE, SPRITE_SIZE), dtype=int)\n 114:         for r in range(SPRITE_SIZE):\n 115:             for c in range(SPRITE_MIRROR_COLS):\n 116:                 if random.random() < fill_p:\n 117:                     sprite[r, c] = color\n 118:                     sprite[r, SPRITE_SIZE - 1 - c] = color\n 119:         area = int(np.count_nonzero(sprite))\n 120:         if area != target_area:\n 121:             continue\n 122:         if not is_contiguous(sprite, background=BACKGROUND, connectivity=4):\n 123:             continue\n 124:         if not (np.any(sprite[0] != BACKGROUND) and np.any(sprite[-1] != BACKGROUND) and\n 125:                 np.any(sprite[:, 0] != BACKGROUND) and np.any(sprite[:, -1] != BACKGROUND)):\n 126:             continue\n 127:         padded = np.zeros((SPRITE_SIZE + 2, SPRITE_SIZE + 2), dtype=int)\n\n 252:         return None\n 253: \n 254:     inp, output = _render_output(grid, placements)\n 255:     if _matches_oracle(inp, output):\n 256:         return inp\n 257:     return None\n 258: \n 259: \n 260: def generate_input() -> np.ndarray:\n 261:     for _ in range(GENERATION_RETRIES):\n 262:         result = _gen_attempt()\n 263:         if result is not None:\n 264:             return result\n 265:     raise RuntimeError(f\"Failed to generate valid input after {GENERATION_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/aa62e3f4.py =====\n   9: \n  10: \n  11: def _unique_color_with_count(counts: Counter[int], colors: list[int], target_count: int) -> int:\n  12:     matches = [color for color in colors if counts[color] == target_count]\n  13:     assert len(matches) == 1, \"expected a unique structural color by area\"\n  14:     return int(matches[0])\n  15: \n  16: \n  17: def main(grid: np.ndarray) -> np.ndarray:\n  18:     \"\"\"\n  19:     Replace the outlined object with the outside contour of that outline in the marker color.\n  20: \n  21:     Input structure:\n  22:     - A dominant background surrounds one 8-connected foreground outline.\n  23:     - The outline is the unique largest foreground color.\n  24:     - One or more smaller interior colors are inside the outline; the marker color\n  25:       is the unique smallest non-outline color.\n  26: \n  27:     Rule:\n  28:     - Erase all original foreground pixels to background.\n  29:     - Paint every background pixel that is 4-adjacent to the outline with the\n  30:       marker color.\n  31:     - Keep the grid shape unchanged.\n  32: \n  33:     Key insight: The colored interior marker supplies the paint color, while the\n  34:     largest outline supplies only the contour whose outside edge is traced.\n  35:     \"\"