{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"我会先快速阅读参考题的 `main()` 和 `generate_input()` 实现方式，再据此设计这道题的识别逻辑和随机生成器，然后把代码写到指定路径并跑自检。"}}
{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/f0f8a26d.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/f0f8a26d.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, find_components, get_bg\nimport random\n\n\ndef _rotated_bar_coords(coords: np.ndarray) -> list[tuple[int, int]]:\n    r0, c0, r1, c1 = bbox_coords(coords)\n    height = r1 - r0 + 1\n    width = c1 - c0 + 1\n    area = int(coords.shape[0])\n\n    assert height == 1 or width == 1\n    length = max(height, width)\n    assert area == length\n    assert length % 2 == 1\n\n    cr = (r0 + r1) // 2\n    cc = (c0 + c1) // 2\n    half = length // 2\n\n    if length == 1:\n        return [(cr, cc)]\n    if height == 1:\n        return [(r, cc) for r in range(cr - half, cr + half + 1)]\n    return [(cr, c) for c in range(cc - half, cc + half + 1)]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Rotate every foreground bar 90 degrees around its own center on the same canvas.\n\n    Input structure\n    The background is the dominant color, and all foreground pixels share one color.\n    Each 4-connected foreground object is a solid one-cell-thick horizontal or vertical\n    bar with odd length, with single-pixel bars allowed.\n\n    Rule\n    Clear the canvas to the background, then redraw every bar with its midpoint, length,\n    and color preserved while swapping horizontal and vertical orientation.\n\n    Key insight\n    The bars are independent objects: their centers and lengths identify the output\n    placement, so no matching, ordering, or global symmetry is needed.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1\n\n    out = np.full_like(g, bg)\n    h, w = g.shape\n    components = find_components(\n        g,\n        bg=bg,\n        connectivity=4,\n        monochromatic=True,\n        colors=fg_colors,\n    )\n    assert components\n\n    for comp in components:\n        color = int(comp[\"color\"])\n        for r, c in _rotated_bar_coords(comp[\"coords\"]):\n            assert 0 <= r < h and 0 <= c < w\n            assert out[r, c] == bg\n            out[r, c] = color\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# Palette and canvas options.\nBG_COLOR = 7\nFG_COLORS = tuple(c for c in range(10) if c != BG_COLOR)\nGRID_SIDES = (9, 11, 13)\n\n# Bar counts and weighted odd-length sampling.\nMIN_BARS, EXTRA_LENGTH_CANDIDATES = 5, 5\nMAX_BARS_BY_SIDE = {9: 6, 11: 8, 13: 10}\nLENGTH_WEIGHT_BY_SIZE = {1: 8, 3: 56, 5: 26, 7: 6, 9: 3}\nDEFAULT_LENGTH_WEIGHT = 1\nORIENTATIONS = (\"H\", \"V\")\n\n# Retry and placement search limits.\nOUTER_ATTEMPTS, INNER_ATTEMPTS = 10, 50\nCENTER_TRIAL_LIMIT = 80\n\ndef _sample_lengths(N, K):\n    possible_lengths = list(range(1, N + 1, 2))\n    weights = [LENGTH_WEIGHT_BY_SIZE.get(l, DEFAULT_LENGTH_WEIGHT) for l in possible_lengths]\n    lengths = random.choices(possible_lengths, weights=weights, k=K + EXTRA_LENGTH_CANDIDATES)\n    lengths.sort(reverse=True)\n    return lengths\n\ndef _bar_pixels(cr, cc, length, orient):\n    half = length // 2\n    if orient == \"H\":\n        return {(cr, cc + d) for d in range(-half, half + 1)}\n    return {(cr + d, cc) for d in range(-half, half + 1)}\n\ndef _place_one_bar(N, length, occupied):\n    \"\"\"Return input pixels for one placed bar, mutating occupied on success.\"\"\"\n    half = length // 2\n    lo, hi = half, N - 1 - half\n    if lo > hi:\n        return None\n    orient = random.choice(ORIENTATIONS)\n    out_orient = \"V\" if orient == \"H\" else \"H\"\n    candidates = [(r, c) for r in range(lo, hi + 1) for c in range(lo, hi + 1)]\n    random.shuffle(candidates)\n\n    for cr, cc in candidates[:CENTER_TRIAL_LIMIT]:\n        inp_pixels = _bar_pixels(cr, cc, length, orient)\n        out_pixels = _bar_pixels(cr, cc, length, out_orient)\n        footprint = inp_pixels | out_pixels\n        if footprint & occupied:\n            continue\n        occupied |= footprint\n        return inp_pixels\n    return None\n\ndef _place_bars(N, K):\n    occupied = set()\n    bars_input = []\n    for length in _sample_lengths(N, K):\n        if len(bars_input) >= K:\n            break\n        inp_pixels = _place_one_bar(N, length, occupied)\n        if inp_pixels is not None:\n            bars_input.append(inp_pixels)\n    return bars_input if len(bars_input) >= K else None\n\ndef _gen_attempt(N: int, K: int) -> np.ndarray | None:\n    fg = random.choice(FG_COLORS)\n    bars_input = _place_bars(N, K)\n    if bars_input is None:\n        return None\n\n    grid = np.full((N, N), BG_COLOR, dtype=int)\n    for bar_pixels in bars_input:\n        for r, c in bar_pixels:\n            grid[r, c] = fg\n\n    try:\n        main(grid)\n    except Exception:\n        return None\n    return grid\n\ndef generate_input() -> np.ndarray:\n    for _outer in range(OUTER_ATTEMPTS):\n        N = random.choice(GRID_SIDES)\n        K = random.randint(MIN_BARS, MAX_BARS_BY_SIDE[N])\n        for _ in range(INNER_ATTEMPTS):\n            result = _gen_attempt(N, K)\n            if result is not None:\n                return result\n    raise RuntimeError(\"Failed to generate valid input after many attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/11dc524f.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/11dc524f.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste\nimport itertools\nimport random\n\n\ndef _intervals_overlap(a0: int, a1: int, b0: int, b1: int) -> bool:\n    return max(int(a0), int(b0)) <= min(int(a1), int(b1))\n\n\ndef _is_solid_2x2(comp: dict, g: np.ndarray) -> bool:\n    r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n    return (\n        int(comp[\"area\"]) == 4\n        and int(r1 - r0 + 1) == 2\n        and int(c1 - c0 + 1) == 2\n        and bool((g[r0 : r1 + 1, c0 : c1 + 1] == int(comp[\"color\"])).all())\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide the non-square sprite to the square anchor and replace the anchor with the sprite's mirror image.\n\n    Input structure:\n    - The background is the most common color.\n    - There is one 8-connected non-background sprite that is not a solid 2x2 square.\n    - There is one solid 2x2 square anchor in another non-background color.\n\n    Rule:\n    - Move the sprite straight toward the anchor along their unique cardinal separation until it touches the anchor's near edge.\n    - Reflect the moved sprite across that near edge and draw the reflected copy in the anchor color.\n    - Clear the original locations; the output keeps only the moved sprite and reflected anchor-color copy.\n\n    Key insight:\n    - The 2x2 square marks the mirror line: its side facing the sprite becomes the contact edge for a two-color reflected pair.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = map(int, g.shape)\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    assert len(comps) == 2\n\n    anchors = [comp for comp in comps if _is_solid_2x2(comp, g)]\n    assert len(anchors) == 1\n    anchor = anchors[0]\n\n    sprites = [comp for comp in comps if comp is not anchor]\n    assert len(sprites) == 1\n    sprite = sprites[0]\n    assert int(sprite[\"color\"]) != int(anchor[\"color\"])\n\n    sr0, sc0, sr1, sc1 = map(int, sprite[\"bbox\"])\n    ar0, ac0, ar1, ac1 = map(int, anchor[\"bbox\"])\n\n    candidates: list[tuple[str, int, int]] = []\n    if sc1 < ac0 and _intervals_overlap(sr0, sr1, ar0, ar1):\n        candidates.append((\"left\", 0, ac0 - sc1 - 1))\n    if sc0 > ac1 and _intervals_overlap(sr0, sr1, ar0, ar1):\n        candidates.append((\"right\", 0, ac1 + 1 - sc0))\n    if sr1 < ar0 and _intervals_overlap(sc0, sc1, ac0, ac1):\n        candidates.append((\"above\", ar0 - sr1 - 1, 0))\n    if sr0 > ar1 and _intervals_overlap(sc0, sc1, ac0, ac1):\n        candidates.append((\"below\", ar1 + 1 - sr0, 0))\n    assert len(candidates) == 1\n\n    side, dr, dc = candidates[0]\n    moved: list[tuple[int, int]] = []\n    mirrored: list[tuple[int, int]] = []\n    for r, c in sprite[\"coords\"]:\n        rr = int(r) + int(dr)\n        cc = int(c) + int(dc)\n        moved.append((rr, cc))\n        if side == \"left\":\n            mirrored.append((rr, 2 * ac0 - 1 - cc))\n        elif side == \"right\":\n            mirrored.append((rr, 2 * ac1 + 1 - cc))\n        elif side == \"above\":\n            mirrored.append((2 * ar0 - 1 - rr, cc))\n        else:\n            mirrored.append((2 * ar1 + 1 - rr, cc))\n\n    assert all(0 <= r < H and 0 <= c < W for r, c in moved)\n    assert all(0 <= r < H and 0 <= c < W for r, c in mirrored)\n    assert not (set(moved) & set(mirrored))\n\n    out = np.full_like(g, bg)\n    for r, c in moved:\n        out[r, c] = int(sprite[\"color\"])\n    for r, c in mirrored:\n        out[r, c] = int(anchor[\"color\"])\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom arc_utils import is_contiguous\n\n# ── Config ──────────────────────────────────────────────────────────────\nGRID_MIN, GRID_MAX = 10, 20        # canvas size range (rows and cols)\nSPRITE_AREA = 4                     # number of filled cells per sprite\nSPRITE_BBOX_SHAPES = [(2, 3), (3, 2), (3, 3)]  # allowed sprite bbox dims\nGAP_MIN, GAP_MAX = 2, 4            # empty-cell gap between sprite and anchor\nANCHOR_SIZE = 2                     # anchor is always a 2x2 solid square\nNUM_COLORS = 10                     # ARC color palette size\nSIDES = [\"left\", \"right\", \"above\", \"below\"]\nRETRY_LIMIT = 300                   # max attempts before raising\n\n\ndef _has_full_bbox(mask: np.ndarray) -> bool:\n    \"\"\"True if mask has at least one filled cell on each edge of its bounding box.\"\"\"\n    return (mask[0].any() and mask[-1].any() and\n            mask[:, 0].any() and mask[:, -1].any())\n\n\ndef _sprite_masks(axis: str) -> list[np.ndarray]:\n    \"\"\"Enumerate all valid 4-cell sprite masks for a given mirror axis.\n\n    A valid mask is 8-connected, spans its full bbox, and is NOT symmetric\n    along the given axis (lr or ud).\n    \"\"\"\n    flip = np.fliplr if axis == \"lr\" else np.flipud\n    out = []\n    for h, w in SPRITE_BBOX_SHAPES:\n        for cells in itertools.combinations(range(h * w), SPRITE_AREA):\n            mask = np.zeros((h, w), dtype=bool)\n            for cell in cells:\n                mask[cell // w, cell % w] = True\n            if not _has_full_bbox(mask):\n                continue\n            if not is_contiguous(mask, connectivity=8):\n                continue\n            if np.array_equal(mask, flip(mask)):\n                continue\n            out.append(mask)\n    return out\n\n\n_MASKS = {\"lr\": _sprite_masks(\"lr\"), \"ud\": _sprite_masks(\"ud\")}\n\n\ndef _paint_mask(grid: np.ndarray, mask: np.ndarray, r0: int, c0: int,\n                color: int, bg: int) -> None:\n    \"\"\"Stamp a boolean mask onto grid at (r0, c0) using the given color.\"\"\"\n    patch = np.full(mask.shape, bg, dtype=int)\n    patch[mask] = color\n    paste(grid, patch, r0, c0, transparent=bg)\n\n\ndef _rand_pair_origin(H: int, W: int, h: int, w: int, side: str,\n                      gap: int) -> tuple[int, int] | None:\n    \"\"\"Pick a random origin for the touching sprite+mirror pair.\n\n    Returns (row, col) of the output pair's top-left corner, or None if the\n    pair cannot fit on the grid with enough room for the input-side gap.\n    \"\"\"\n    if side in {\"left\", \"right\"}:\n        r_lo, r_hi = 0, H - h\n        total_w = 2 * w + (gap if side == \"right\" else 0)\n        c_lo = gap if side == \"left\" else 0\n        c_hi = W - total_w if side == \"right\" else W - 2 * w\n    else:\n        c_lo, c_hi = 0, W - w\n        total_h = 2 * h + (gap if side == \"below\" else 0)\n        r_lo = gap if side == \"above\" else 0\n        r_hi = H - total_h if side == \"below\" else H - 2 * h\n    if r_lo > r_hi or c_lo > c_hi:\n        return None\n    return random.randint(r_lo, r_hi), random.randint(c_lo, c_hi)\n\n\ndef _layout_for_side(side: str, pr: int, pc: int, h: int, w: int,\n                     gap: int, sprite: np.ndarray):\n    \"\"\"Compute output and input placement params for a given side.\n\n    Returns (sprite_r, sprite_c, mirror_r, mirror_c, flipped_sprite,\n             anchor_r, anchor_c, input_r, input_c).\n    \"\"\"\n    flip = np.fliplr if side in {\"left\", \"right\"} else np.flipud\n    flipped = flip(sprite)\n\n    if side == \"left\":\n        sr, sc = pr, pc                     # sprite at pair origin\n        mr, mc = sr, sc + w                  # mirror right of sprite\n        anchor_r = random.randint(sr, sr + h - ANCHOR_SIZE)\n        anchor_c = sc + w\n        input_r, input_c = sr, sc - gap\n    elif side == \"right\":\n        sr, sc = pr, pc + w                  # sprite right half\n        mr, mc = pr, pc                      # mirror left half\n        anchor_r = random.randint(sr, sr + h - ANCHOR_SIZE)\n        anchor_c = sc - ANCHOR_SIZE\n        input_r, input_c = sr, sc + gap\n    elif side == \"above\":\n        sr, sc = pr, pc                      # sprite at top\n        mr, mc = sr + h, sc                  # mirror below\n        anchor_r = sr + h\n        anchor_c = random.randint(sc, sc + w - ANCHOR_SIZE)\n        input_r, input_c = sr - gap, sc\n    else:  # below\n        sr, sc = pr + h, pc                  # sprite at bottom\n        mr, mc = pr, pc                      # mirror above\n        anchor_r = sr - ANCHOR_SIZE\n        anchor_c = random.randint(sc, sc + w - ANCHOR_SIZE)\n        input_r, input_c = sr + gap, sc\n\n    return sr, sc, mr, mc, flipped, anchor_r, anchor_c, input_r, input_c\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Try to build one valid (input, output) pair; return input or None.\"\"\"\n    H = random.randint(GRID_MIN, GRID_MAX)\n    W = random.randint(GRID_MIN, GRID_MAX)\n    bg = random.randrange(NUM_COLORS)\n    sprite_color, anchor_color = random.sample(\n        [c for c in range(NUM_COLORS) if c != bg], 2)\n\n    side = random.choice(SIDES)\n    axis = \"lr\" if side in {\"left\", \"right\"} else \"ud\"\n    sprite = random.choice(_MASKS[axis]).copy()\n    h, w = map(int, sprite.shape)\n    gap = random.randint(GAP_MIN, GAP_MAX)\n\n    origin = _rand_pair_origin(H, W, h, w, side, gap)\n    if origin is None:\n        return None\n    pr, pc = origin\n\n    (sr, sc, mr, mc, flipped,\n     anchor_r, anchor_c, input_r, input_c) = _layout_for_side(\n        side, pr, pc, h, w, gap, sprite)\n\n    # Build expected output\n    out = np.full((H, W), bg, dtype=int)\n    _paint_mask(out, sprite, sr, sc, sprite_color, bg)\n    _paint_mask(out, flipped, mr, mc, anchor_color, bg)\n\n    # Build input\n    inp = np.full((H, W), bg, dtype=int)\n    _paint_mask(inp, sprite, input_r, input_c, sprite_color, bg)\n    paste(inp, np.full((ANCHOR_SIZE, ANCHOR_SIZE), anchor_color, dtype=int),\n          anchor_r, anchor_c)\n\n    # Oracle validation\n    comps = find_components(inp, bg=bg, connectivity=8, monochromatic=True)\n    if len(comps) != 2:\n        return None\n    try:\n        solved = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(solved, out):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' /home/lixinyu/snap/new/ARC_code/train/ad173014.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' /home/lixinyu/snap/new/ARC_code/train/ad173014.py\"","aggregated_output":"import math\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, is_contiguous\nimport random\n\n\nRED = 2\nBLUE = 1\n\n\ndef _extract_frames(g: np.ndarray, bg: int) -> tuple[list[dict], list[np.ndarray]]:\n    red_components = components_mask(g == RED, connectivity=4)\n    assert len(red_components) >= 3\n\n    frames = []\n    for coords in red_components:\n        r0, c0, r1, c1 = bbox_coords(coords)\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        assert h == w and h >= 3\n\n        patch = g[r0 : r1 + 1, c0 : c1 + 1]\n        border = np.zeros((h, w), dtype=bool)\n        border[0, :] = True\n        border[-1, :] = True\n        border[:, 0] = True\n        border[:, -1] = True\n\n        assert int(border.sum()) == int(coords.shape[0])\n        assert np.all(patch[border] == RED)\n        assert np.all(patch[~border] != RED)\n\n        interior = patch[1:-1, 1:-1]\n        interior_colors = set(map(int, np.unique(interior))) - {int(bg)}\n        assert len(interior_colors) == 1\n        color = interior_colors.pop()\n        mask = interior == color\n        assert mask.any()\n\n        frames.append(\n            {\n                \"bbox\": (r0, c0, r1, c1),\n                \"center\": ((r0 + r1) / 2, (c0 + c1) / 2),\n                \"color\": color,\n                \"mask\": mask,\n            }\n        )\n\n    return frames, red_components\n\n\ndef _blue_cycle_edges(g: np.ndarray, red_components: list[np.ndarray]) -> set[tuple[int, int]]:\n    red_id = {}\n    for i, coords in enumerate(red_components):\n        for r, c in coords:\n            red_id[(int(r), int(c))] = i\n\n    edges = set()\n    for coords in components_mask(g == BLUE, connectivity=4):\n        touched = set()\n        for r, c in coords:\n            rr = int(r)\n            cc = int(c)\n            for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):\n                frame_id = red_id.get((nr, nc))\n                if frame_id is not None:\n                    touched.add(frame_id)\n        assert len(touched) == 2\n        a, b = touched\n        edges.add(tuple(sorted((a, b))))\n\n    n = len(red_components)\n    assert len(edges) == n\n    for i in range(n):\n        assert sum(i in edge for edge in edges) == 2\n    return edges\n\n\ndef _clockwise_order(frames: list[dict], edges: set[tuple[int, int]]) -> list[int]:\n    mean_r = sum(frame[\"center\"][0] for frame in frames) / len(frames)\n    mean_c = sum(frame[\"center\"][1] for frame in frames) / len(frames)\n    angles = [\n        math.atan2(frame[\"center\"][0] - mean_r, frame[\"center\"][1] - mean_c)\n        for frame in frames\n    ]\n    assert len({round(angle, 12) for angle in angles}) == len(angles)\n\n    order = sorted(range(len(frames)), key=lambda i: angles[i])\n    for a, b in zip(order, order[1:] + order[:1]):\n        assert tuple(sorted((a, b))) in edges\n    return order\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor each framed interior mask with the color from the next red frame clockwise around the blue connector cycle.\n\n    Input structure\n    - The grid contains hollow red square frames connected pairwise by blue line components.\n    - The blue components connect the frames into one cycle, with every frame touching exactly two blue components.\n    - Each frame interior contains background plus exactly one non-background color mask.\n\n    Rule\n    - Sort the red frames clockwise by their centers around the cycle.\n    - Keep each frame's interior mask shape in place, but recolor it with the interior color from the next clockwise frame.\n    - Leave the red frames, blue connectors, background, and interior background holes unchanged.\n\n    Key insight\n    - The colored masks do not move; the blue cycle gives the order in which their colors rotate.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    frames, red_components = _extract_frames(g, bg)\n    edges = _blue_cycle_edges(g, red_components)\n    order = _clockwise_order(frames, edges)\n\n    out = g.copy()\n    for k, frame_id in enumerate(order):\n        next_id = order[(k + 1) % len(order)]\n        r0, c0, r1, c1 = frames[frame_id][\"bbox\"]\n        interior = out[r0 + 1 : r1, c0 + 1 : c1]\n        interior[frames[frame_id][\"mask\"]] = frames[next_id][\"color\"]\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Palette constants.\nBG = 0\nCONNECTOR_BLUE = 1\nFRAME_RED = 2\nINTERIOR_COLORS = [3, 4, 5, 6, 7, 8, 9]\n\n# Canvas and frame bounds.\nFRAME_COUNT_RANGE = (3, 5)\nFRAME_SIZE_CHOICES = [5, 7]\nSMALL_FRAME_GRID_H_RANGE = (20, 27)\nSMALL_FRAME_GRID_W_RANGE = (21, 27)\nLARGE_FRAME_GRID_H_RANGE = (22, 27)\nLARGE_FRAME_GRID_W_RANGE = (23, 27)\nFRAME_GAP = 1\n\n# Interior mask density.\nMIN_INTERIOR_FILL = 0.30\nMAX_INTERIOR_FILL = 0.56\nMIN_INTERIOR_CELLS = 3\n\n# Angular placement.\nANGLE_PERTURB_RANGE = (-0.3, 0.3)\nMIN_RADIUS_PAD = 1\nMAX_RADIUS_PAD = 1\nANGLE_EPS = 1e-6\n\n# Connector constraints and retry budgets.\nMAX_TWO_TURN_TRIES = 20\nCONNECTOR_LENGTH_RANGE = (2, 24)\nGENERATION_ATTEMPTS = 300\n\nNEIGHBORS_8 = [\n    (dr, dc)\n    for dr in range(-1, 2)\n    for dc in range(-1, 2)\n    if not (dr == 0 and dc == 0)\n]\n\n\ndef _gen_mask(interior_size, color):\n    \"\"\"Generate an 8-connected mask for frame interior with fill 30-56%.\"\"\"\n    n = interior_size\n    total = n * n\n    min_fill = max(MIN_INTERIOR_CELLS, int(math.ceil(MIN_INTERIOR_FILL * total)))\n    max_fill = int(math.floor(MAX_INTERIOR_FILL * total))\n    target = random.randint(min_fill, max_fill)\n\n    mask = np.zeros((n, n), dtype=int)\n    start = (n // 2, n // 2)\n    mask[start] = color\n    filled = [start]\n    frontier = set()\n    _add_mask_frontier(frontier, mask, start)\n\n    while len(filled) < target and frontier:\n        cell = random.choice(list(frontier))\n        frontier.discard(cell)\n        mask[cell] = color\n        filled.append(cell)\n        _add_mask_frontier(frontier, mask, cell)\n\n    if len(filled) < min_fill:\n        return None\n    return mask\n\n\ndef _add_mask_frontier(frontier, mask, cell):\n    n = mask.shape[0]\n    for dr, dc in NEIGHBORS_8:\n        nr, nc = cell[0] + dr, cell[1] + dc\n        if 0 <= nr < n and 0 <= nc < n and mask[nr, nc] == 0:\n            frontier.add((nr, nc))\n\n\ndef _axis_path(start, end):\n    \"\"\"Return an inclusive straight segment between row- or column-aligned cells.\"\"\"\n    sr, sc = start\n    er, ec = end\n    if sr == er:\n        step = 1 if ec > sc else -1\n        return [(sr, c) for c in range(sc, ec + step, step)]\n    step = 1 if er > sr else -1\n    return [(r, sc) for r in range(sr, er + step, step)]\n\n\ndef _one_turn_path(start, corner, end):\n    return _axis_path(start, corner) + _axis_path(corner, end)[1:]\n\n\ndef _two_turn_vhv_path(start, mid_r, end):\n    _, sc = start\n    _, ec = end\n    corner1 = (mid_r, sc)\n    corner2 = (mid_r, ec)\n    return (\n        _axis_path(start, corner1)\n        + _axis_path(corner1, corner2)[1:]\n        + _axis_path(corner2, end)[1:]\n    )\n\n\ndef _two_turn_hvh_path(start, mid_c, end):\n    sr, _ = start\n    er, _ = end\n    corner1 = (sr, mid_c)\n    corner2 = (er, mid_c)\n    return (\n        _axis_path(start, corner1)\n        + _axis_path(corner1, corner2)[1:]\n        + _axis_path(corner2, end)[1:]\n    )\n\n\ndef _path_is_free(path, occupied):\n    return all(p not in occupied for p in path)\n\n\ndef _find_path(start, end, occupied):\n    \"\"\"Find an L-shaped path (0-2 turns) from start to end avoiding occupied cells.\"\"\"\n    sr, sc = start\n    er, ec = end\n\n    if sr == er or sc == ec:\n        path = _axis_path(start, end)\n        if _path_is_free(path, occupied):\n            return path\n\n    corners = [(sr, ec), (er, sc)]\n    random.shuffle(corners)\n    for corner in corners:\n        path = _one_turn_path(start, corner, end)\n        if _path_is_free(path, occupied):\n            return path\n\n    for _ in range(MAX_TWO_TURN_TRIES):\n        if sr != er and sc != ec:\n            mid_r = random.randint(min(sr, er), max(sr, er))\n            path = _two_turn_vhv_path(start, mid_r, end)\n            if _path_is_free(path, occupied):\n                return path\n\n            mid_c = random.randint(min(sc, ec), max(sc, ec))\n            path = _two_turn_hvh_path(start, mid_c, end)\n            if _path_is_free(path, occupied):\n                return path\n\n    return None\n\n\ndef _pick_attachment(frame_bbox, side, occupied):\n    \"\"\"Pick an attachment point on the given side of a frame border.\n    Returns (border_cell, connector_start) where connector_start is one step outside.\"\"\"\n    r0, c0, r1, c1 = frame_bbox\n","exit_code":0,"status":"completed"}}
