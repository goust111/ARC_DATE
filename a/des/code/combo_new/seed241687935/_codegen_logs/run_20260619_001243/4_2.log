+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+_RNG = np.random.default_rng()
+
+MIN_TEMPLATE_RECT = 3
+MAX_TEMPLATE_RECT = 7
+MIN_FRAGMENT_AREA = 3
+MIN_GRID_SIDE = 16
+MAX_GRID_SIDE = 30
+MIN_PAIRS = 2
+MAX_PAIRS = 4
+MAX_GENERATION_ATTEMPTS = 500
