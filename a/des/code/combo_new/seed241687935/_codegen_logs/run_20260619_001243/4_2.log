+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+_RNG = np.random.default_rng()
+
+MIN_TEMPLATE_RECT = 3
+MAX_TEMPLATE_RECT = 7
+MIN_FRAGMENT_AREA = 3
