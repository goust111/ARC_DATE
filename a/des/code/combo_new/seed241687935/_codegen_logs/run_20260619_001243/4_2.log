+def _mark_rect(blocked: np.ndarray, rect_h: int, rect_w: int, top: int, left: int, pad: int = 1) -> None:
+    h, w = blocked.shape
+    r0 = max(0, top - pad)
+    r1 = min(h, top + rect_h + pad)
