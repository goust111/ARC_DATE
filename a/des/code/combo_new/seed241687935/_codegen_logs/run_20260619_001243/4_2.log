+        vals.append(int(np.floor(start + (end - start) * t + 0.5)))
+    return tuple(vals)
+
+
+def _mask_from_template(rect_h: int, rect_w: int, orientation: str, seq: tuple[int, ...]) -> np.ndarray:
+    mask = np.zeros((rect_h, rect_w), dtype=bool)
