+    terminals: list[tuple[int, int]] = []
+    for r in range(h - 3):
+        for c in range(w - 3):
+            sub = grid[r : r + 4, c : c + 4]
+            if not np.all(sub[1:3, 1:3] == BLACK):
+                continue
+            if not np.all(sub[0, :] == GREY):
+                continue
+            if not np.all(sub[3, :] == GREY):
+                continue
+            if not np.all(sub[:, 0] == GREY):
+                continue
+            if not np.all(sub[:, 3] == GREY):
+                continue
+            terminals.append((r, c))
+    return terminals
+
