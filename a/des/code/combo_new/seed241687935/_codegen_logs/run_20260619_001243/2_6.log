+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and int(grid[nr, nc]) == GREY and (nr, nc) not in visited:
+                visited.add((nr, nc))
+                q.append((nr, nc))
+    return visited
