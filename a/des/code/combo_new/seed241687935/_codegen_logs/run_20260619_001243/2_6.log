+
+def _component_sites(
+    rows: int, cols: int, comp_index: dict[tuple[int, int], int]
+) -> dict[int, list[tuple[tuple[int, int], str]]]:
+    sites: dict[int, list[tuple[tuple[int, int], str]]] = {}
+    for r in range(rows):
+        for c in range(cols):
+            node = (r, c)
+            idx = comp_index[node]
+            bucket = sites.setdefault(idx, [])
+            if r == 0:
+                bucket.append((node, "U"))
+            if r == rows - 1:
