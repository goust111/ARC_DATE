+def _coarse_components(
+    rows: int,
+    cols: int,
+    edges: list[tuple[tuple[int, int], tuple[int, int]]],
+    cut_edges: set[tuple[tuple[int, int], tuple[int, int]]],
+):
+    adj: dict[tuple[int, int], list[tuple[int, int]]] = {(r, c): [] for r in range(rows) for c in range(cols)}
