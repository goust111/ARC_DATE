        if direction == "up" and rr - min_r < 2:
            continue
        if direction == "right" and max_c - cc < 2:
            continue
        if direction == "left" and cc - min_c < 2:
            continue
        candidates.append((rr, cc))
    if not candidates:
        return None
    return rng.choice(candidates)


