+    q = deque([(sr, sc, start_last)])
+    seen = {(sr, sc, start_last): 0}
+    dist[sr, sc] = 0
+
+    while q:
+        r, c, last_seg = q.popleft()
+        cur_d = seen[(r, c, last_seg)]
+        sid_here = int(seg_ids[r, c])
+        jid_here = int(jun_ids[r, c])
