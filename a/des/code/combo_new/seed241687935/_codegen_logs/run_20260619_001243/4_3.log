+            if state is None or state in seen:
+                continue
+
+            seen[state] = cur_d + 1
+            if dist[nr, nc] == -1 or cur_d + 1 < dist[nr, nc]:
+                dist[nr, nc] = cur_d + 1
+            q.append(state)
+
