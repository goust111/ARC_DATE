+            sid_next = int(seg_ids[nr, nc])
+            jid_next = int(jun_ids[nr, nc])
+            state: tuple[int, int, int] | None = None
+
+            if sid_here:
+                if sid_next == sid_here:
+                    state = (nr, nc, sid_here)
+                elif jid_next:
+                    state = (nr, nc, sid_here)
+            elif jid_here:
