+    adj: dict[int, set[int]] = {jid: set() for jid in range(1, jun_n + 1)}
+    for r in range(h):
+        for c in range(w):
+            jid = int(jun_ids[r, c])
+            if jid == 0:
+                continue
+            for dr, dc in DIR4:
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    sid = int(seg_ids[nr, nc])
+                    if sid:
+                        adj[jid].add(sid)
+
