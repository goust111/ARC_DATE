+        seg_ids, jun_ids, _widths, allowed = _branch_regions(comp_mask)
+        seed_dists = [(color, _seed_distances(comp_mask, seg_ids, jun_ids, allowed, pos)) for pos, color in seeds]
+
+        for r, c in comp:
+            if int(g[r, c]) == wall:
+                continue
