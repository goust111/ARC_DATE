+
+WALL_COLORS = [5, 6]
+MARKER_COLORS = [1, 2, 3, 4, 7, 8, 9]
+COMPONENT_TYPES = ["line", "branch_single_tie", "branch_single_wide", "branch_double"]
+GEN_ATTEMPTS = 400
+PLACE_ATTEMPTS = 80
