+                max(0, left + cc - SCATTER_PADDING) : min(gw, left + cc + SCATTER_PADDING + 1)] = True
+    return int(top), int(left)
+
+
+def _pair_components_for_uniqueness(grid: np.ndarray) -> bool:
+    bg = _bg_color(grid)
