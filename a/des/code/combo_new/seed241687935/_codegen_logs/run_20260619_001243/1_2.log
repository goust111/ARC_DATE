+
+def _random_partition(equal_area: bool) -> tuple[np.ndarray, np.ndarray] | None:
+    for _ in range(PARTITION_RETRIES):
+        rect_h = random.randint(*RECT_H_RANGE)
+        rect_w = random.randint(*RECT_W_RANGE)
+        total = rect_h * rect_w
+        if equal_area and total % 2 == 1:
