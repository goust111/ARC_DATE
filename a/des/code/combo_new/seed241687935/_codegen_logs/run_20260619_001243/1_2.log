+def _anchor_and_mover(a: dict, b: dict) -> tuple[dict, dict]:
+    if int(a["area"]) > int(b["area"]):
+        return a, b
+    if int(b["area"]) > int(a["area"]):
+        return b, a
+    if tuple(a["top_key"]) <= tuple(b["top_key"]):
