+def _solve_pairing(
+    components: list[dict],
+    grid_shape: tuple[int, int],
+    limit: int = 1,
+    reject_multi_placements: bool = False,
+) -> list[list[dict]]:
+    options = _pair_options(components, grid_shape, reject_multi_placements=reject_multi_placements)
+    if options is None:
+        return []
+
+    n = len(components)
+    used: set[int] = set()
+    current: list[dict] = []
+    solutions: list[list[dict]] = []
+
+    def bt() -> None:
+        if len(solutions) >= limit:
+            return
+        if len(used) == n:
+            solutions.append([dict(item) for item in current])
+            return
+        idx = min(i for i in range(n) if i not in used)
+        for opt in options[idx]:
+            a, b = opt["members"]
+            if a in used or b in used:
+                continue
+            used.add(a)
+            used.add(b)
+            current.append(opt)
+            bt()
+            current.pop()
+            used.remove(a)
+            used.remove(b)
+
+    bt()
+    return solutions
+
