+    a_full, b_full = part
+    a_area = int(a_full.sum())
+    b_area = int(b_full.sum())
+
+    if equal_area:
+        anchor_full, mover_full = random.choice([(a_full, b_full), (b_full, a_full)])
+    elif a_area > b_area:
+        anchor_full, mover_full = a_full, b_full
+    else:
