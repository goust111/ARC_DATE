+    for idx in order:
+        rect_h, rect_w = pairs[idx]["rect_shape"]
+        placed = False
+        for _ in range(PLACEMENT_RETRIES):
+            top = random.randint(0, h - rect_h)
+            left = random.randint(0, w - rect_w)
