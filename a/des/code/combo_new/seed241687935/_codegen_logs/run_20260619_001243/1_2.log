+    mover_rot = np.rot90(np.asarray(mover["mask"], dtype=bool), 2)
+    mh, mw = map(int, mover_rot.shape)
+    rel = [tuple(map(int, rc)) for rc in np.argwhere(mover_rot)]
+    anchor_cells = anchor["coord_set"]
+    placements = []
