 342: # ── Generator phases ─────────────────────────────────────────────
 343: 
 344: def _place_legends(rng: random.Random, grid: np.ndarray,
 345:                    ) -> tuple[np.ndarray, list[tuple[int, tuple[int,int]]]]:
 346:     """Place 1-2 legend patches at grid corners.
 347: 
 348:     Returns (legend_occupied mask, list of (wall_color, direction) pairs).
 349:     """
 350:     h, w = grid.shape
 351:     n_legends = rng.choice([1, 2])
 352:     corners = rng.sample(CORNERS, n_legends)
 353:     wall_colors = rng.sample(WALL_COLOR_CHOICES, n_legends)
 354: 
 355:     legend_occupied = np.zeros((h, w), dtype=bool)
 356:     legends = []
 357: 
 358:     for corner, wc in zip(corners, wall_colors):
 359:         if rng.random() < CARDINAL_PROB:
 360:             dr, dc = rng.choice(CARDINAL_DIRS)
 361:             patch = _legend_5x5(wc, dr, dc)
 362:         else:
 363:             dr, dc = rng.choice(DIAGONAL_DIRS)
 364:             patch = _legend_6x7(wc, dr, dc)
 365:         ph, pw = patch.shape
 366:         r0, c0 = _corner_origin(corner, h, w, ph, pw)
 367:         paste(grid, patch, r0, c0)
 368:         # Reserve legend cells + buffer.
 369:         r_lo, r_hi = max(0, r0 - LEGEND_BUFFER), min(h, r0 + ph + LEGEND_BUFFER)
 370:         c_lo, c_hi = max(0, c0 - LEGEND_BUFFER), min(w, c0 + pw + LEGEND_BUFFER)
 371:         legend_occupied[r_lo:r_hi, c_lo:c_hi] = True
 372:         legends.append((wc, (dr, dc)))
 373: 
 374:     return legend_occupied, legends
 375: 
 376: 
 377: def _grow_regions(rng: random.Random, legends: list[tuple[int, tuple[int,int]]],
 378:                   legend_occupied: np.ndarray,
 379:                   ) -> list[dict] | None:
 380:     """Grow irregular closed regions, one per assigned wall color.
 381: 
 382:     Returns list of region dicts or None on failure.
 383:     """
 384:     h, w = legend_occupied.shape
 385:     color_dir = {wc: d for wc, d in legends}
 386:     all_colors = [wc for wc, _ in legends]
 387: 
 388:     # Assign 1-3 regions per wall color, cap total.
 389:     region_colors = []
 390:     for c in all_colors:
 391:         region_colors.extend([c] * rng.randint(*REGIONS_PER_COLOR))
 392:     if len(region_colors) > MAX_TOTAL_REGIONS:
 393:         region_colors = rng.sample(region_colors, MAX_TOTAL_REGIONS)
 394:     rng.shuffle(region_colors)
 395: 
 396:     size_min, size_max = REGION_SIZE_BOUNDS[len(region_colors)]
 397:     occupied = legend_occupied.copy()
 398:     regions = []
 399: 
 400:     for rc in region_colors:
 401:         dr, dc = color_dir[rc]
 402:         target_size = rng.randint(size_min, size_max)
 403: 
 404:         # Build canvas: interior cells (not border) that are unoccupied.
 405:         canvas = np.ones((h, w), dtype=bool)
 406:         canvas[0, :] = False; canvas[-1, :] = False
 407:         canvas[:, 0] = False; canvas[:, -1] = False
 408:         canvas &= ~occupied
 409:         if not canvas.any():
 410:             continue
 411: 
 412:         blob = _try_grow_valid_blob(rng, canvas, occupied, target_size, h, w)
 413:         if blob is None:
 414:             continue
 415: 
 416:         walls = _blob_wall_cells(blob, h, w)
 417:         regions.append({'color': rc, 'dir': (dr, dc), 'interior': blob, 'walls': walls})
 418: 
 419:         # Reserve blob + walls + 1-cell buffer around walls.
 420:         reserve = blob | walls
 421:         extra = set()
 422:         for r, c in walls:
 423:             for nr, nc in neighbors4(r, c):
 424:                 if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in reserve:
 425:                     extra.add((nr, nc))
 426:         for r, c in reserve | extra:
 427:             occupied[r, c] = True
 428: 
 429:     if not regions:
 430:         return None
 431:     # Every legend color must have at least one region.
 432:     if {reg['color'] for reg in regions} != set(all_colors):
 433:         return None
 434:     return regions
 435: 
 436: 
 437: def _try_grow_valid_blob(rng: random.Random, canvas: np.ndarray,
 438:                          occupied: np.ndarray, target_size: int,
 439:                          h: int, w: int) -> set[tuple[int,int]] | None:
 440:     """Attempt up to BLOB_GROW_RETRIES random seeds to grow a valid blob."""
 441:     for _ in range(BLOB_GROW_RETRIES):
 442:         free = np.argwhere(canvas)
 443:         if len(free) == 0:
 444:             break
 445:         sr, sc = free[rng.randrange(len(free))]
 446:         cand = _grow_blob(canvas, (int(sr), int(sc)), target_size, rng)
 447:         if cand is None:
 448:             continue
 449:         # Fill interior holes until stable.
 450:         while True:
 451:             filled = _fill_holes(cand, h, w)
 452:             if filled == cand:
 453:                 break
 454:             cand = filled
 455:         # Absorbed cells must stay within canvas.
 456:         if any(not canvas[r, c] for r, c in cand):
 457:             continue
 458:         walls = _blob_wall_cells(cand, h, w)
 459:         # Walls must not overlap occupied cells or the grid border.
 460:         if any(occupied[wr, wc] or wr in (0, h - 1) or wc in (0, w - 1)
 461:                for wr, wc in walls):
 462:             continue
 463:         return cand
 464:     return None
 465: 
 466: 
 467: def _validate_topology(grid: np.ndarray, regions: list[dict]) -> bool:
 468:     """Check that every enclosed bg component matches exactly one region interior."""
 469:     h, w = grid.shape
 470:     labeled, n_comp = label_mask(grid == 0, connectivity=4)
 471:     bounded = []
 472:     for comp_id in range(1, n_comp + 1):
 473:         coords = np.argwhere(labeled == comp_id)
 474:         if any(r in (0, h - 1) or c in (0, w - 1) for r, c in coords):
 475:             continue
 476:         bounded.append({(int(r), int(c)) for r, c in coords})
 477:     region_sets = [reg['interior'] for reg in regions]
 478:     if len(bounded) != len(region_sets):
 479:         return False
 480:     return all(comp in region_sets for comp in bounded)
 481: 
 482: 
 483: def _place_yellows(rng: random.Random, regions: list[dict],
 484:                    grid: np.ndarray) -> bool:
 485:     """Choose yellow output positions and reverse-slide to derive input positions.
 486: 
 487:     Modifies grid in-place by painting yellow(4) at input positions.
 488:     Returns True on success.
 489:     """
 490:     for reg in regions:
 491:         blob = reg['interior']
 492:         dr, dc = reg['dir']
 493:         n_yellows = rng.choice(YELLOWS_PER_REGION)
 494: 
 495:         # Cells sorted by projection onto slide direction (farthest first).
 496:         cells_sorted = sorted(blob, key=lambda p: dr * p[0] + dc * p[1], reverse=True)
 497:         far_key = dr * cells_sorted[0][0] + dc * cells_sorted[0][1]
 498:         tier1 = [p for p in cells_sorted if dr * p[0] + dc * p[1] == far_key]
 499: 
 500:         # Pick output positions: first at the farthest tier, second one step behind or at tier1.
 501:         first = tier1[rng.randrange(len(tier1))]
 502:         output_positions = [first]
 503: 
 504:         if n_yellows == 2:
 505:             pr, pc = first[0] - dr, first[1] - dc
 506:             cands = ([(pr, pc)] if (pr, pc) in blob else []) + [p for p in tier1 if p != first]
 507:             if cands:
 508:                 second = cands[rng.randrange(len(cands))]
 509:                 if second != first:
 510:                     output_positions.append(second)
 511: 
 512:         # Reverse-slide: process in solver order (far-to-near).
 513:         out_sorted = sorted(output_positions, key=lambda p: dr * p[0] + dc * p[1], reverse=True)
 514:         already_stopped = set()
 515:         yellows_input = []
 516: 
 517:         for out_pos in out_sorted:
 518:             candidate = _find_reverse_slide(blob, out_pos, dr, dc, already_stopped,
 519:                                             yellows_input, rng)
 520:             if candidate is None:
 521:                 return False
 522:             yellows_input.append(candidate)
 523:             already_stopped.add(out_pos)
 524: 
 525:         for r, c in yellows_input:
 526:             grid[r, c] = 4
 527:     return True
 528: 
 529: 
 530: def _find_reverse_slide(blob: set, out_pos: tuple[int,int], dr: int, dc: int,
 531:                         already_stopped: set, existing_inputs: list,
 532:                         rng: random.Random) -> tuple[int,int] | None:
 533:     """Walk backwards from out_pos to find a valid input position 1..MAX_SLIDE_STEPS away."""
 534:     target_steps = rng.randint(1, MAX_SLIDE_STEPS)
 535:     for steps in range(target_steps, 0, -1):
 536:         r, c = out_pos
 537:         path_ok = True
 538:         for _ in range(steps):
 539:             pr, pc = r - dr, c - dc
 540:             if (pr, pc) not in blob or (pr, pc) in already_stopped or (pr, pc) in existing_inputs:
 541:                 path_ok = False
 542:                 break
 543:             if dr != 0 and dc != 0:
 544:                 if (pr + dr, pc) not in blob or (pr, pc + dc) not in blob:
 545:                     path_ok = False
 546:                     break
 547:             r, c = pr, pc
 548:         if not path_ok:
 549:             continue
 550:         if _forward_slide(blob, (r, c), dr, dc, already_stopped) == out_pos:
 551:             return (r, c)
 552:     return None
 553: 
 554: 
 555: def _oracle_check(input_grid: np.ndarray, regions: list[dict]) -> bool:
 556:     """Run the solver on input_grid and verify correctness."""
 557:     h, w = input_grid.shape
 558:     try:
 559:         solver_out = main(input_grid)
 560:     except Exception:
 561:         return False
 562:     # Non-yellow, non-bg cells must be identical.
 563:     struct_mask = (input_grid != 4) & (input_grid != 0)
 564:     if not np.array_equal(solver_out[struct_mask], input_grid[struct_mask]):
 565:         return False
 566:     # Yellow count must be preserved.
 567:     if (solver_out == 4).sum() != (input_grid == 4).sum():
 568:         return False
 569:     # All output yellows must lie inside known region interiors.
 570:     regions_mask = np.zeros((h, w), dtype=bool)
 571:     for reg in regions:
 572:         for r, c in reg['interior']:
 573:             regions_mask[r, c] = True
 574:     return bool(np.all(regions_mask[solver_out == 4]))
 575: 
 576: 
 577: # ── Main generator ────────────────────────────────────────────────
 578: 
 579: def _gen_attempt(rng: random.Random) -> np.ndarray | None:
 580:     h, w = GRID_H, GRID_W
 581:     grid = np.zeros((h, w), dtype=int)
 582: 
 583:     legend_occupied, legends = _place_legends(rng, grid)
 584:     regions = _grow_regions(rng, legends, legend_occupied)
 585:     if regions is None:
 586:         return None
 587: 
 588:     # Paint walls.
 589:     for reg in regions:
 590:         for r, c in reg['walls']:
 591:             grid[r, c] = reg['color']
 592: 
 593:     if not _validate_topology(grid, regions):
 594:         return None
 595: 
 596:     input_grid = grid.copy()
 597:     if not _place_yellows(rng, regions, input_grid):
 598:         return None
 599:     if not _oracle_check(input_grid, regions):
 600:         return None
 601:     return input_grid
 602: 
 603: 

 604: def generate_input() -> np.ndarray:
 605:     rng = random.Random()
 606:     for _ in range(GEN_RETRIES):
 607:         try:
 608:             g = _gen_attempt(rng)
 609:         except Exception:
 610:             continue
 611:         if g is not None:
 612:             return g
 613:     raise RuntimeError("generate_input: exceeded retries")


