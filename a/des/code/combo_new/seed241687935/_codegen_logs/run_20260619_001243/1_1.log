 169: """Generator for task 88e364bc (slide yellow in walled regions by legend arrows)."""
 170: import random
 171: import numpy as np
 172: 
 173: from arc_utils import label_mask, neighbors4, paste
 174: 
 175: # ── Configuration ─────────────────────────────────────────────────
 176: GRID_H, GRID_W = 20, 20
 177: 
 178: # Legend
 179: CARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]
 180: DIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]
 181: CORNERS = ['TL', 'TR', 'BL', 'BR']
 182: WALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}
 183: CARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)
 184: LEGEND_BUFFER = 1                          # cells of padding around legend patches
 185: 
 186: # Regions
 187: REGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color
 188: MAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20
 189: REGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}
 190:     1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),
 191: }
 192: BLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region
 193: 
 194: # Yellows
 195: YELLOWS_PER_REGION = [1, 2]                # choices per region
 196: MAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]
 197: 
 198: # Outer loop
 199: GEN_RETRIES = 300                          # max attempts in generate_input()
 200: 
 201: 
 202: # ── Legend patches ────────────────────────────────────────────────
 203: 
 204: def _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:
 205:     """5x5 cardinal legend. Canonical direction: (0, +1) right."""
 206:     g = np.full((5, 5), fill, dtype=int)
 207:     g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2
 208:     g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2
 209:     rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}
 210:     return np.rot90(g, rot[(dr, dc)])
 211: 
 212: 
 213: def _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:
 214:     """6x7 diagonal legend. Canonical direction: (+1, +1) down-right."""
 215:     g = np.full((6, 7), fill, dtype=int)
 216:     g[1, 3] = 1
 217:     g[2, 1] = 1; g[2, 4] = 1
 218:     g[3, 2] = 1; g[3, 5] = 2
 219:     g[4, 3] = 2
 220:     if (dr, dc) == (1, 1): return g
 221:     if (dr, dc) == (-1, 1): return np.flipud(g)
 222:     if (dr, dc) == (1, -1): return np.fliplr(g)
 223:     if (dr, dc) == (-1, -1): return np.rot90(g, 2)
 224:     raise ValueError((dr, dc))
 225: 
 226: 
 227: def _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:
 228:     """Top-left coordinate for a patch placed at the given grid corner."""
 229:     if corner == 'TL': return 0, 0
 230:     if corner == 'TR': return 0, w - pw
 231:     if corner == 'BL': return h - ph, 0
 232:     if corner == 'BR': return h - ph, w - pw
 233:     raise ValueError(corner)
