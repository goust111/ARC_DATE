    rp = 1 if right.kind=='tab' else 0
    mask=np.zeros((h, base_w+lp+rp), bool)
    c0=lp
    mask[:, c0:c0+base_w] = True
    if left.kind=='tab':
        mask[list(left.key), 0] = True
    elif left.kind=='notch':
        mask[list(left.key), c0] = False
    if right.kind=='tab':
        mask[list(right.key), c0+base_w] = True
    elif right.kind=='notch':
        mask[list(right.key), c0+base_w-1] = False
    return color,mask

