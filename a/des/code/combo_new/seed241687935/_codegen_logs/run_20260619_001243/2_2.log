+        assert cols.size > 0, "every horizontal piece row must be occupied"
+        assert np.all(mask[r, cols[0] : cols[-1] + 1]), "piece rows must stay contiguous"
+        first[r] = int(cols[0])
+        last[r] = int(cols[-1])
