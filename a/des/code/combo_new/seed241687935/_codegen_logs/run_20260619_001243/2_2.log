                blocked[rr0:rr1,cc0:cc1]=True
                placed=True
                break
            if not placed:
                ok=False; break
        if ok:
            return grid
    return None

for t in range(200):
    orient=random.choice(['h','v'])
    n=random.randint(3,5)
    if orient=='h':
        h=random.randint(5,8)
        patterns=pats(h)
        random.shuffle(patterns)
        patterns=patterns[:n-1]
        for _ in range(100):
            widths=[random.randint(3,6) for _ in range(n)]
            if 12<=sum(widths)<=24 and len(set(widths))>1:
                break
        left=[None]*n; right=[None]*n
        left[0]=Edge('flat',()); right[-1]=Edge('flat',())
        for i,pat in enumerate(patterns):
            if random.random()<0.5:
                right[i]=Edge('tab',pat); left[i+1]=Edge('notch',pat)
            else:
                right[i]=Edge('notch',pat); left[i+1]=Edge('tab',pat)
        pieces=[build_h(h,widths[i],left[i],right[i],i+1) for i in range(n)]
        if len({m.shape[1] for _,m in pieces})==1:
            continue
    else:
        w=random.randint(5,8)
        patterns=pats(w)
        random.shuffle(patterns)
