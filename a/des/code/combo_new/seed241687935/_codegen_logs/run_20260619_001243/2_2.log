            if 12<=sum(heights)<=24 and len(set(heights))>1:
                break
        top=[None]*n; bottom=[None]*n
        top[0]=Edge('flat',()); bottom[-1]=Edge('flat',())
        for i,pat in enumerate(patterns):
            if random.random()<0.5:
                bottom[i]=Edge('tab',pat); top[i+1]=Edge('notch',pat)
            else:
                bottom[i]=Edge('notch',pat); top[i+1]=Edge('tab',pat)
        pieces=[build_v(heights[i],w,top[i],bottom[i],i+1) for i in range(n)]
        if len({m.shape[0] for _,m in pieces})==1:
            continue
    grid=scatter(pieces)
    if grid is None:
        continue
    out=main(grid)
    if orient=='h':
        exp=solve([analyze_h(m,c) for c,m in pieces],True)
    else:
        exp=solve([analyze_v(m,c) for c,m in pieces],False)
    assert np.array_equal(out,exp)
print('all good')
