def analyze_v(mask,color):
    h,w=mask.shape
    first=[]; last=[]
    for c in range(w):
        rows=np.flatnonzero(mask[:,c])
        if rows.size==0 or np.any(~mask[rows[0]:rows[-1]+1, c]): raise ValueError('bad col')
        first.append(int(rows[0])); last.append(int(rows[-1]))
    top=classify(first)
    bottom=classify((h-1)-np.array(last))
    base=h-(top.kind=='tab')-(bottom.kind=='tab')
