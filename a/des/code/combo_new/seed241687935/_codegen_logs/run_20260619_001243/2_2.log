            rs=[p[0] for p in pts]; cs=[p[1] for p in pts]
            r0,r1=min(rs),max(rs); c0,c1=min(cs),max(cs)
            mask=np.zeros((r1-r0+1,c1-c0+1),bool)
            for x,y in pts: mask[x-r0,y-c0]=True
            out.append((color,mask))
    return out

def main(grid):
    pieces=comps(grid,0)
    cands=[]
    try:
        hs={m.shape[0] for _,m in pieces}
        if len(hs)==1:
            cands.append(solve([analyze_h(m,c) for c,m in pieces],True))
    except Exception:
        pass
    try:
        ws={m.shape[1] for _,m in pieces}
        if len(ws)==1:
            cands.append(solve([analyze_v(m,c) for c,m in pieces],False))
    except Exception:
        pass
    if not cands: raise ValueError('no')
    if len(cands)==1: return cands[0]
    if all(np.array_equal(cands[0], x) for x in cands[1:]): return cands[0]
    raise ValueError('amb')

def build_h(h, base_w, left, right, color):
    lp=1 if left.kind=='tab' else 0
    rp=1 if right.kind=='tab' else 0
    mask=np.zeros((h,base_w+lp+rp),bool)
    c0=lp
    mask[:,c0:c0+base_w]=True
    if left.kind=='tab': mask[list(left.key),0]=True
    elif left.kind=='notch': mask[list(left.key),c0]=False
    if right.kind=='tab': mask[list(right.key),c0+base_w]=True
    elif right.kind=='notch': mask[list(right.key),c0+base_w-1]=False
    return color,mask

def build_v(base_h, w, top, bottom, color):
    tp=1 if top.kind=='tab' else 0
    bp=1 if bottom.kind=='tab' else 0
    mask=np.zeros((base_h+tp+bp,w),bool)
    r0=tp
    mask[r0:r0+base_h,:]=True
    if top.kind=='tab': mask[0,list(top.key)] = True
    elif top.kind=='notch': mask[r0,list(top.key)] = False
    if bottom.kind=='tab': mask[r0+base_h,list(bottom.key)] = True
    elif bottom.kind=='notch': mask[r0+base_h-1,list(bottom.key)] = False
    return color,mask

def pats(length):
    return [(i,) for i in range(1,length-1)] + [tuple(range(i,i+2)) for i in range(1,length-2)]

def scatter(pieces):
    for _ in range(100):
        H=random.randint(18,30); W=random.randint(18,30)
        if sum(m.size for _,m in pieces) > H*W//2:
            continue
        blocked=np.zeros((H,W),bool)
        grid=np.zeros((H,W),int)
        order=sorted(range(len(pieces)), key=lambda i: pieces[i][1].size, reverse=True)
        ok=True
        for idx in order:
            color,mask=pieces[idx]
            ph,pw=mask.shape
