def match(a,b):
    return ((a.kind=='tab' and b.kind=='notch') or (a.kind=='notch' and b.kind=='tab')) and a.key==b.key

def solve(info, horizontal=True,bg=0):
    n=len(info)
    outs=[[] for _ in range(n)]
    ins=[[] for _ in range(n)]
    for i in range(n):
        for j in range(n):
            if i"'!=j and match(info[i].trail, info[j].lead):
                outs[i].append(j); ins[j].append(i)
    starts=[i for i,p in enumerate(info) if p.lead.kind=='"'flat']
    ends=[i for i,p in enumerate(info) if p.trail.kind=='flat']
    if len(starts)"'!=1 or len(ends)!=1: raise ValueError(('"'se',starts,ends))
    s,e=starts[0], ends[0]
    for i in range(n):
        if len(ins[i]) "'!= (0 if i==s else 1): raise ValueError(('"'in',i,ins))
        if len(outs[i]) "'!= (0 if i==e else 1): raise ValueError(('"'out',i,outs))
    order=[]; cur=s
    while True:
        if cur in order: raise ValueError('cycle')
        order.append(cur)
        if cur==e: break
        cur=outs[cur][0]
    if len(order)"'!=n: raise ValueError(order)
    if horizontal:
        cross=info[0].mask.shape[0]
        total=sum(info[i].base_len for i in order)
        out=np.zeros((cross,total),int)
