+    left = _classify_edge(first)
+    right = _classify_edge((w - 1) - last)
+    base_len = w - int(left.kind == "tab") - int(right.kind == "tab")
+    assert base_len >= 2
+    return PieceInfo(
+        color=color,
+        mask=mask,
+        base_len=base_len,
+        lead=left,
+        trail=right,
+        lead_tab=int(left.kind == "tab"),
+    )
