    mask:np.ndarray
    base_len:int
    lead:Edge
    trail:Edge
    lead_tab:int


def classify(arr):
    arr=np.asarray(arr,int)
    if not set(arr.tolist()) <= {0,1}:
        raise ValueError(arr)
    ones=int(arr.sum())
    n=arr.size
    if ones==0:
        return Edge('flat',())
    if 0 < ones < n/2:
        return Edge('notch', tuple(int(i) for i in np.where(arr==1)[0]))
    if ones > n/2:
        return Edge('tab', tuple(int(i) for i in np.where(arr==0)[0]))
    raise ValueError('amb')

def analyze_h(mask,color):
    h,w=mask.shape
    first=[]; last=[]
    for r in range(h):
        cols=np.flatnonzero(mask[r])
        if cols.size==0: raise ValueError('empty row')
        if np.any(~mask[r, cols[0]:cols[-1]+1]): raise ValueError('gap')
        first.append(int(cols[0])); last.append(int(cols[-1]))
    left=classify(first)
    right=classify((w-1)-np.array(last))
    base=w-(left.kind=='tab')-(right.kind=='tab')
    return Piece(color,mask,base,left,right,1 if left.kind=='tab' else 0)

def match(a,b):
    return ((a.kind=='tab' and b.kind=='notch') or (a.kind=='notch' and b.kind=='tab')) and a.key==b.key

def solve_h(pieces,bg=0):
    info=[analyze_h(mask,col) for col,mask in pieces]
    n=len(info)
    outs=[[] for _ in range(n)]
    ins=[[] for _ in range(n)]
    for i in range(n):
        for j in range(n):
