+from __future__ import annotations
+
+from collections import deque
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+@dataclass(frozen=True)
+class EdgeProfile:
+    kind: str
+    key: tuple[int, ...] = ()
+
+
+@dataclass
+class PieceInfo:
+    color: int
+    mask: np.ndarray
+    base_len: int
+    lead: EdgeProfile
+    trail: EdgeProfile
