+def _match_arrow(comp: dict) -> dict | None:
+    r0, c0, _r1, _c1 = comp["bbox"]
+    rel = {(r - r0, c - c0) for r, c in comp["coords"]}
+    for direction in _DIRS:
+        for length in _ARROW_LENGTHS:
+            expected, tip_rel = _arrow_template(direction, length)
