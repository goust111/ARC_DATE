+    counts: dict[int, int],
+    long_color: int,
+    short_color: int,
+) -> bool:
+    long_arm = counts[long_color]
+    short_arm = counts[short_color]
+    large_gap = short_arm + 1
+    small_gap = 1
+
+    options: list[tuple[tuple[int, int], tuple[int, int]]] = []
+    for dr_abs, dc_abs in ((small_gap, large_gap), (large_gap, small_gap)):
+        for dr_sign in (-1, 1):
+            for dc_sign in (-1, 1):
+                dr = dr_sign * dr_abs
+                dc = dc_sign * dc_abs
