+                row_lo = max(long_arm, short_arm - dr)
+                row_hi = min(shape[0] - 1 - long_arm, shape[0] - 1 - short_arm - dr)
+                col_lo = max(long_arm, short_arm - dc)
+                col_hi = min(shape[1] - 1 - long_arm, shape[1] - 1 - short_arm - dc)
