+def _seed_footprint(shape: tuple[int, int], seed: tuple[int, int], arm: int) -> set[tuple[int, int]]:
+    h, w = shape
+    r, c = seed
+    cells: set[tuple[int, int]] = set()
+    for delta in range(-arm, arm + 1):
+        rr = r + delta
+        if 0 <= rr < h:
+            cells.add((rr, c))
+        cc = c + delta
+        if 0 <= cc < w:
+            cells.add((r, cc))
+    return cells
