+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+WALL = 1
+PALETTE = tuple(range(2, 10))
+
+MIN_GRID = 16
+MAX_GRID = 30
+MIN_MARGIN = 2
+MAX_MARGIN = 5
+MIN_ROOM_SIZE = 3
+MIN_ROOMS = 2
+MAX_ROOMS = 5
+MIN_SEG_LEN = 2
+MAX_SEG_LEN = 4
+GEN_RETRIES = 400
+
+
+def neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _in_bounds(h: int, w: int, r: int, c: int) -> bool:
+    return 0 <= r < h and 0 <= c < w
+
+
+def _corner_bg(grid: np.ndarray) -> int:
+    corners = [
+        int(grid[0, 0]),
+        int(grid[0, -1]),
+        int(grid[-1, 0]),
+        int(grid[-1, -1]),
+    ]
+    return Counter(corners).most_common(1)[0][0]
+
+
+def _largest_non_bg_color(grid: np.ndarray, bg: int) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    options = [(int(v), int(c)) for v, c in zip(values, counts) if int(v) != int(bg)]
+    assert options, "expected at least one non-background color"
+    return max(options, key=lambda item: item[1])[0]
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for nr, nc in neighbors4(cr, cc):
+                    if _in_bounds(h, w, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
