+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+WALL = 1
+PALETTE = tuple(range(2, 10))
+
+MIN_GRID = 16
+MAX_GRID = 30
+MIN_MARGIN = 2
+MAX_MARGIN = 5
+MIN_ROOM_SIZE = 3
+MIN_ROOMS = 2
+MAX_ROOMS = 5
+MIN_SEG_LEN = 2
+MAX_SEG_LEN = 4
