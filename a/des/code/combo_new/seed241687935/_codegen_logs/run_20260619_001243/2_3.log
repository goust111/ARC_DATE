+    segment = max(comps, key=len)
+    assert len(segment) >= 2, "outer segment must be longer than the seed singleton"
+    rows = set(map(int, segment[:, 0]))
+    cols = set(map(int, segment[:, 1]))
+    if len(rows) == 1:
+        return "horizontal"
+    if len(cols) == 1:
