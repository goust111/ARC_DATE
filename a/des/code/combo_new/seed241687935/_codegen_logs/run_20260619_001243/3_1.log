+
+    rmin, rmax, cmin, cmax = _usable_bounds(h, w, side)
+    usable_h = rmax - rmin + 1
+    usable_w = cmax - cmin + 1
+    if min(usable_h, usable_w) <= 0:
+        return None
+
+    if usable_h * usable_w >= 130 and min(usable_h, usable_w) >= 9:
+        n_options = [2, 3, 4]
