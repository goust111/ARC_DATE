+    elif side == "left":
+        legend_mask[:, 0] = True
+    else:
+        legend_mask[:, w - 1] = True
+
+    counts_outside_legend = Counter(
+        int(v) for v in grid[~legend_mask].ravel() if int(v) != BACKGROUND
+    )
+    if counts_outside_legend.most_common(1)[0][0] != fence_color:
+        return None
+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return None
+    return grid
