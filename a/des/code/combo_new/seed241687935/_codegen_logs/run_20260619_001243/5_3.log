+    actual = main(grid)
+    if not np.array_equal(actual, expected):
+        return None
+    if np.array_equal(grid, actual):
+        return None
+    if len({spec["color"] for spec in specs}) < 2:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
