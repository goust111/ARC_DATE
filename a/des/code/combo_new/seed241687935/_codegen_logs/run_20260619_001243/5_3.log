+    right_margin = rng.randint(0, 1)
+    if legend_height + bottom_margin > h:
+        return None
+
+    legend_r0 = h - legend_height - bottom_margin
+    legend_c0 = w - 3 - right_margin
+    if legend_r0 < 0 or legend_c0 < 3:
