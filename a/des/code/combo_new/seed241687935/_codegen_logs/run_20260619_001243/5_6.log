--- 40: def main(grid: np.ndarray) -> np.ndarray:
040: def main(grid: np.ndarray) -> np.ndarray:
041:     """Extrapolate the moving sprite from a horizontal sequence of shared-border frames into the next standalone frame.
042: 
043:     Input structure
044:     - The grid is a row of equal-width framed panels sharing their vertical border columns.
045:     - Each panel has the same fill color and one identical interior sprite at the same local columns.
046:     - The sprite's top row changes by a constant amount from panel to panel.
047: 
048:     Rule
049:     - Build one output panel with the same height, frame color, fill color, and sprite.
050:     - Continue the sprite's diagonal motion one more panel to the right.
051:     - Because the output is a standalone panel, advance by the full panel width, not the shared-border spacing.
052: 
053:     Key insight
054:     - The panels are consecutive frames of motion; the output is the next frame after the sequence.
055:     """
056:     g = np.asarray(grid, dtype=int)
057:     h, w = g.shape
058:     frame = int(g[0, 0])
059:     assert h >= 3 and w >= 3
060:     assert np.all(g[0, :] == frame)
061:     assert np.all(g[-1, :] == frame)
062: 
063:     separators = [c for c in range(w) if np.all(g[:, c] == frame)]
064:     assert len(separators) >= 3
065:     assert separators[0] == 0 and separators[-1] == w - 1
066:     strides = [b - a for a, b in zip(separators, separators[1:])]
067:     assert len(set(strides)) == 1
068:     stride = strides[0]
069:     panel_w = stride + 1
070: 
071:     interior_values = []
072:     for c0, c1 in zip(separators, separators[1:]):
073:         interior_values.extend(g[1:-1, c0 + 1 : c1].ravel())
074:     fill = _unique_most_common(interior_values)
075: 
076:     panels = []
077:     for c0, c1 in zip(separators, separators[1:]):
078:         panel = g[:, c0 : c1 + 1]
079:         assert panel.shape == (h, panel_w)
080:         assert np.all(panel[0, :] == frame)
081:         assert np.all(panel[-1, :] == frame)
082:         assert np.all(panel[:, 0] == frame)
083:         assert np.all(panel[:, -1] == frame)
084:         panels.append(panel)
085: 
086:     template_sprite, template_mask, first_top, template_left = _extract_sprite(panels[0], fill)
087:     top_rows = [first_top]
088:     for panel in panels[1:]:
089:         sprite, sprite_mask, top, local_c0 = _extract_sprite(panel, fill)
090:         assert local_c0 == template_left
091:         assert sprite_mask.shape == template_mask.shape
092:         assert np.array_equal(sprite_mask, template_mask)
093:         assert np.array_equal(sprite[sprite_mask], template_sprite[template_mask])
094:         top_rows.append(top)
095: 
096:     deltas = [b - a for a, b in zip(top_rows, top_rows[1:])]
097:     assert len(deltas) >= 1 and len(set(deltas)) == 1
098:     next_top = _round_half_up(
099:         Fraction(top_rows[-1], 1) + Fraction(deltas[0] * panel_w, stride)
100:     )
101: 
102:     sprite_h, sprite_w = template_sprite.shape
103:     assert 1 <= next_top and next_top + sprite_h <= h - 1
104:     assert 1 <= template_left and template_left + sprite_w <= panel_w - 1
105: 
106:     out = np.full((h, panel_w), fill, dtype=int)
107:     out[0, :] = frame
108:     out[-1, :] = frame
109:     out[:, 0] = frame
110:     out[:, -1] = frame
111: 
112:     target = out[next_top : next_top + sprite_h, template_left : template_left + sprite_w]
113:     target[template_mask] = template_sprite[template_mask]
114:     return out
115: 
