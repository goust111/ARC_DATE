from __future__ import annotations
import numpy as np
from collections import deque

BLACK = 0
MAGENTA = 6
PALETTE = [1,2,3,4,5,7,8,9]


def connected_components(mask):
    H,W = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    comps=[]
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or seen[r,c]:
                continue
            q=deque([(r,c)])
            seen[r,c]=True
            coords=[]
            while q:
                x,y=q.popleft()
                coords.append((x,y))
                for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                    nx,ny=x+dx,y+dy
                    if 0<=nx<H and 0<=ny<W and mask[nx,ny] and not seen[nx,ny]:
                        seen[nx,ny]=True
                        q.append((nx,ny))
            comps.append(np.array(coords, dtype=int))
    return comps


def border_uniform(a, color, t):
    h,w=a.shape
    if t<=0 or t>min(h,w):
        return False
    m=np.zeros_like(a, dtype=bool)
    m[:t,:]=True
    m[h-t:,:]=True
    m[:,:t]=True
    m[:,w-t:]=True
    return bool(np.all(a[m]==color))


def extract_layers(a):
    arr=np.array(a, dtype=int)
    out=[]
    while True:
        h,w=arr.shape
        color=int(arr[0,0])
        t=0
        for k in range(1, min(h,w)+1):
            if border_uniform(arr,color,k):
                t=k
            else:
                break
        assert t>0
        out.append((color,t))
        if h<=2*t or w<=2*t:
            break
        arr=arr[t:h-t, t:w-t]
    return list(reversed(out))


def main(grid):
    g=np.asarray(grid, dtype=int)
    markers=np.argwhere(g==MAGENTA)
    comps=connected_components((g"'!=BLACK)&(g!=MAGENTA))
    structures=[]
    used=set()
    for coords in comps:
        r0,c0=coords.min(axis=0)
        r1,c1=coords.max(axis=0)
        sub=g[r0:r1+1, c0:c1+1]
        cand=[(int(r),int(c)) for r,c in markers if int(r)==int(r1)+1 and int(c0)<=int(c)<=int(c1)]
        assert len(cand)==1
        mr,mc=cand[0]
        used.add((mr,mc))
        layers=extract_layers(sub)
        structures.append((mc, sub.shape[1], layers))
    assert len(used)==len(markers)
    structures.sort(key=lambda x:x[0])
    height=sum(t for _,_,layers in structures for _,t in layers)
    width=max(w for _,w,_ in structures)
    out=np.zeros((height,width), dtype=int)
    r=0
    for _,_,layers in structures:
        for color,t in layers:
            out[r:r+t,:]=color
            r+=t
    return out


def build_structure(rng):
    n_layers=int(rng.integers(2,5))
    colors=rng.choice(PALETTE, size=n_layers, replace=False).tolist()
    center_t=int(rng.integers(1,4))
    mode=int(rng.integers(0,3))
    extra=int(rng.integers(0,5))
    if mode==0:
        center_h=center_t
        center_w=center_t+extra
    elif mode==1:
        center_h=center_t+extra
        center_w=center_t
    else:
        center_h=center_t
        center_w=center_t
    arr=np.full((center_h, center_w), colors[0], dtype=int)
    layers=[(colors[0], min(center_h, center_w))]
    for color in colors[1:]:
        t=int(rng.integers(1,4))
        new=np.full((arr.shape[0]+2*t, arr.shape[1]+2*t), color, dtype=int)
        new[t:t+arr.shape[0], t:t+arr.shape[1]]=arr
        arr=new
        layers.append((color,t))
    marker_col=int(rng.integers(0, arr.shape[1]))
    return arr, marker_col, layers


def generate_input():
    rng=np.random.default_rng()
    for _ in range(500):
        n=int(rng.integers(1,5))
        structs=[]
        total_out_h=0
        for _ in range(n):
            arr, marker_col, layers = build_structure(rng)
            structs.append((arr, marker_col, layers))
            total_out_h += sum(t for _,t in layers)
        if total_out_h>30:
            continue
        widths=[s[0].shape[1] for s in structs]
        heights=[s[0].shape[0]+1 for s in structs]
        gaps=[int(rng.integers(1,5)) for _ in range(max(0,n-1))]
        left=int(rng.integers(0,3))
        right=int(rng.integers(0,3))
        total_w=left+sum(widths)+sum(gaps)+right
        if total_w>30:
            continue
        max_h=max(heights)
        extra_h=int(rng.integers(0, min(30-max_h, 8)+1))
        H=max_h+extra_h
        if H>30:
            continue
        grid=np.zeros((H,total_w), dtype=int)
        x=left
        for i,(arr,mc,layers) in enumerate(structs):
            h,w=arr.shape
            top=int(rng.integers(0, H-(h+1)+1))
            grid[top:top+h, x:x+w]=arr
            grid[top+h, x+mc]=MAGENTA
            x += w + (gaps[i] if i < len(gaps) else 0)
        out=main(grid)
        if out.shape[0] <= 30 and out.shape[1] <= 30:
            return grid
    raise RuntimeError

