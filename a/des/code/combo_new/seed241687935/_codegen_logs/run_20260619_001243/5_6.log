045: GRID_AREA = GRID_SHAPE[0] * GRID_SHAPE[1]
046: 
047: # Palette: four distinct foreground colors, no background.
048: COLOR_POOL = np.arange(1, 10)
049: N_COLORS = 4
050: 
051: # Counts: largest, second, third are sampled; smallest is residual.
052: COUNT_RANGES = ((40, 55), (25, 35), (10, 20))
053: RESIDUAL_COUNT_RANGE = (2, 10)
054: COUNT_SAMPLE_RETRIES = 100
055: GENERATION_RETRIES = 300
056: 
057: 
058: def _sample_ranked_counts(rng: np.random.Generator) -> list[int] | None:
059:     """Return four distinct counts in descending rank ranges, summing to the grid area."""
060:     for _ in range(COUNT_SAMPLE_RETRIES):
061:         sampled = [int(rng.integers(lo, hi + 1)) for lo, hi in COUNT_RANGES]
062:         residual = GRID_AREA - sum(sampled)
063:         lo, hi = RESIDUAL_COUNT_RANGE
064:         counts = sampled + [residual]
065:         if lo <= residual <= hi and len(set(counts)) == N_COLORS:
066:             return counts
067:     return None
068: 
069: 
070: def _gen_attempt() -> np.ndarray | None:
071:     rng = np.random.default_rng()
072: 
073:     colors = rng.choice(COLOR_POOL, size=N_COLORS, replace=False).tolist()
074:     counts = _sample_ranked_counts(rng)
075:     if counts is None:
076:         return None
077: 
078:     pixels = np.repeat(colors, counts)
079:     rng.shuffle(pixels)
080:     return pixels.astype(int, copy=False).reshape(GRID_SHAPE)
