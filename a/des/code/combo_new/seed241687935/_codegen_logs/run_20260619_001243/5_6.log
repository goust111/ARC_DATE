006: def main(grid: np.ndarray) -> np.ndarray:
007:     """Pack all pixels into color-frequency runs along bottom-up columns.
008: 
009:     Input structure
010:     The input is a rectangular grid whose colors are all foreground material;
011:     only the number of pixels of each color matters. In the observed task
012:     instances, every present color has a distinct pixel count.
013: 
014:     Rule
015:     Count the pixels of each color and order the colors from most frequent to
016:     least frequent. Rewrite a same-size grid by placing each color's full count
017:     as one contiguous run while scanning columns from left to right and, within
018:     each column, from bottom to top.
019: 
020:     Key insight
021:     The output preserves the multiset of colors but discards all original
022:     positions, turning the grid into a frequency-sorted column packing.
023:     """
024:     g = np.asarray(grid, dtype=int)
025:     assert g.ndim == 2
026: 
027:     counts = Counter(map(int, g.ravel()))
028:     assert len(set(counts.values())) == len(counts), "color counts must have a unique rank"
029: 
030:     colors = sorted(counts, key=lambda color: -counts[color])
031:     out = np.empty_like(g)
032:     height, width = g.shape
033: 
034:     scan = ((r, c) for c in range(width) for r in range(height - 1, -1, -1))
035:     for color in colors:
036:         for _ in range(counts[color]):
037:             r, c = next(scan)
038:             out[r, c] = color
039: 
040:     return out
