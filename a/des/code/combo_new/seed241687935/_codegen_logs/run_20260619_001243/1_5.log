+        grid[cell] = GREY
+        blocked |= _moat_cells(shape, {cell})
+        placed_noise += 1
+        if placed_noise == target_noise:
+            break
+    if placed_noise == 0:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
