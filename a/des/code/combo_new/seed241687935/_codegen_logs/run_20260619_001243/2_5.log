+        return "R"
+    if r0 == r1 and c0 > c1:
+        return "L"
+    if c0 == c1 and r0 < r1:
+        return "D"
+    if c0 == c1 and r0 > r1:
+        return "U"
+    raise AssertionError("consecutive chain nodes must share a row or a column")
+
