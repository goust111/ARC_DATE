+
+def _boundary_of_shape(shape: np.ndarray) -> np.ndarray:
+    h, w = shape.shape
+    boundary = np.zeros((h, w), dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if not shape[r, c]:
+                continue
+            if r == 0 or c == 0 or r == h - 1 or c == w - 1:
+                boundary[r, c] = True
+                continue
+            for nr, nc in _neighbors4(r, c):
+                if not shape[nr, nc]:
+                    boundary[r, c] = True
+                    break
