+def _assign_depths(frames: list[dict[str, int]]) -> None:
+    memo: dict[int, int] = {}
+
+    def depth_of(idx: int) -> int:
+        if idx in memo:
+            return memo[idx]
+        frame = frames[idx]
+        containers = [j for j, other in enumerate(frames) if _strictly_contains(other, frame)]
+        if not containers:
+            memo[idx] = 1
+        else:
