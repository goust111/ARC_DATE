+    memo: dict[int, int] = {}
+
+    def depth_of(idx: int) -> int:
+        if idx in memo:
+            return memo[idx]
+        frame = frames[idx]
+        containers = [j for j, other in enumerate(frames) if _strictly_contains(other, frame)]
+        if not containers:
+            memo[idx] = 1
+        else:
+            parent = min(
+                containers,
+                key=lambda j: (frames[j]["r1"] - frames[j]["r0"] + 1) * (frames[j]["c1"] - frames[j]["c0"] + 1),
+            )
+            memo[idx] = depth_of(parent) + 1
+        return memo[idx]
