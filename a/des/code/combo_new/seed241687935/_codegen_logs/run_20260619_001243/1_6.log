+        int(outer["r0"]) < int(inner["r0"])
+        and int(outer["c0"]) < int(inner["c0"])
+        and int(outer["r1"]) > int(inner["r1"])
+        and int(outer["c1"]) > int(inner["c1"])
+    )
+
+
+def _find_frames(grid: np.ndarray) -> list[dict[str, int]]:
