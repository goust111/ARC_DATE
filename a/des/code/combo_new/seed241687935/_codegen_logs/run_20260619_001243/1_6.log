+    if len(dims) == 1:
+        h, w = dims[0]
+        return [(0, 0)], h, w
+
+    mode = rng.choice(("horizontal", "vertical", "diagonal"))
+    gaps = [rng.randint(*gap_range) for _ in range(len(dims) - 1)]
