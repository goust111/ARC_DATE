+        r0, c0, r1, c1 = (int(frame[k]) for k in ("r0", "c0", "r1", "c1"))
+        step = int(frame["depth"])
+        inner = out[r0 + 1 : r1, c0 + 1 : c1]
+        if inner.size == 0:
+            continue
