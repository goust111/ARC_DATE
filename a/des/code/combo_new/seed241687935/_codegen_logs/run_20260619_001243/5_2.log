+
+def _make_shape(scenario: str) -> set[tuple[int, int]]:
+    if scenario == "straight":
+        cells = _make_straight_shape()
+    elif scenario == "corner":
+        cells = _make_corner_shape()
+    elif scenario == "tee":
+        cells = _make_tee_shape()
+    else:
+        cells = _make_cross_shape()
