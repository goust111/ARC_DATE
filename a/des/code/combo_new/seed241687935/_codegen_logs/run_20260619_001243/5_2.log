+    bend_arm = random.choice(("up", "down", "left", "right"))
+    bend_len = random.randint(1, 3)
+    if bend_arm == "up":
+        endpoint = (-arms["up"], 0)
+        bend_dir = random.choice(((0, -1), (0, 1)))
+    elif bend_arm == "down":
+        endpoint = (arms["down"], 0)
+        bend_dir = random.choice(((0, -1), (0, 1)))
+    elif bend_arm == "left":
+        endpoint = (0, -arms["left"])
+        bend_dir = random.choice(((-1, 0), (1, 0)))
+    else:
+        endpoint = (0, arms["right"])
+        bend_dir = random.choice(((-1, 0), (1, 0)))
