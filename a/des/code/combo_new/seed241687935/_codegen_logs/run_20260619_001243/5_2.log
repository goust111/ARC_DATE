+def _place_shape(
+    cells: set[tuple[int, int]],
+    h: int,
+    w: int,
+    want_blocked: bool,
+) -> tuple[set[tuple[int, int]], set[tuple[int, int]]] | None:
+    shape_h, shape_w = _bbox_shape(cells)
+    feasible = []
+    blocked_feasible = []
+
+    for top in range(1, h - shape_h):
