+
+def _make_pattern_patch(cell_h: int, cell_w: int, palette: list[int]) -> np.ndarray | None:
+    inner_h_max = min(4, cell_h)
+    inner_w_max = min(4, cell_w)
+    dims = [(h, w) for h in range(2, inner_h_max + 1) for w in range(2, inner_w_max + 1)]
+    if not dims:
