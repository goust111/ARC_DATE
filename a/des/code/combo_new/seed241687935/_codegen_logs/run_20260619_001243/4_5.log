+        offset_r = random.randint(0, cell_h - shape_h)
+        offset_c = random.randint(0, cell_w - shape_w)
+
+        color_count = 1 if area <= 2 else random.choice([1, 1, 2])
+        colors = random.sample(palette, color_count)
+        assigned: dict[tuple[int, int], int] = {}
+        for cell in cells:
