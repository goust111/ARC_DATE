+    planned_stamps: dict[tuple[int, int], np.ndarray] = {}
+    for (rr, cc), direction in arrows.items():
+        dr, dc = DIRS[direction]
+        target = (rr + dr, cc + dc)
+        assert 0 <= target[0] < n_rows and 0 <= target[1] < n_cols, "arrow target out of bounds"
