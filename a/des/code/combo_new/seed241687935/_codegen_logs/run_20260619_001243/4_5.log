+) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    dr, dc = DIRS[direction]
+    arrows: list[tuple[int, int]] = []
+    gaps: list[tuple[int, int]] = []
+    for step in range(1, 2 * length + 1):
