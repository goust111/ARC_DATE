+def _rotate_clockwise(coords: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    height = max(r for r, _ in coords) + 1
+    return {(c, height - 1 - r) for r, c in coords}
+
+
+def _normalize(coords: set[tuple[int, int]]) -> frozenset[tuple[int, int]]:
