    col_bands = CELL_BANDS
    grid = np.full(GRID_SHAPE, Color.ORANGE, dtype=int)
    grid[list(SEPARATOR_INDICES), :] = Color.PINK
    grid[:, list(SEPARATOR_INDICES)] = Color.PINK
    return grid, row_bands, col_bands


