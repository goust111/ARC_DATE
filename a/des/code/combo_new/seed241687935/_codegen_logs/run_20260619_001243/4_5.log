+        if idx > start:
+            bands.append((start, idx))
+        start = idx + 1
+    if start < limit:
+        bands.append((start, limit))
+    if len(bands) < 2:
+        return None
+    size = bands[0][1] - bands[0][0]
+    if size <= 0:
