+        if 0 <= nr < h and 0 <= nc < w:
+            yield nr, nc
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    if not coords:
+        return False
+
+    seen = {coords[0]}
+    stack = [coords[0]]
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c, *mask.shape):
+            if mask[nr, nc] and (nr, nc) not in seen:
