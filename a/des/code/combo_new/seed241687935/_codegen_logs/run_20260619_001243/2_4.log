    h, w = mask.shape
    choices = []
    for r in range(h):
        for c in range(w):
            if mask[r, c]:
                continue
            touches = sum(
                0 <= r + dr < h and 0 <= c + dc < w and mask[r + dr, c + dc]
                for dr, dc in GEN_NEIGHBORS_4
            )
            if touches != 1:
                continue
            trial = mask.copy()
            trial[r, c] = True
            if not _has_hole(trial):
                choices.append((r, c))
    return choices


