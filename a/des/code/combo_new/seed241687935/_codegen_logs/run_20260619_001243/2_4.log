+
+    grid = _build_empty_grid(n, side)
+    expected = grid.copy()
+    branches = _branch_schedule(n * n)
+
+    for index, branch in enumerate(branches):
+        r = index // n
+        c = index % n
+        r0 = r * side + r
+        c0 = c * side + c
+
+        color = random.choice(PALETTE)
+        src_mask = _make_source(branch, side)
