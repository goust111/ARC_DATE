+import random
+
+import numpy as np
+
+
+BG = 0
+SEP = 2
+PALETTE = (1, 3, 4, 5, 6, 7, 8, 9)
+BRANCHES = ("horizontal", "vertical", "diagonal", "none")
+MAX_GENERATION_ATTEMPTS = 400
