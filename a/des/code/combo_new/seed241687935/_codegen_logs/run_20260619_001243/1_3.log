+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+MAROON = 9
+
+MARKER_TO_STEP = {
+    RED: (0, -1),
+    BLUE: (1, 0),
+    GREEN: (0, 1),
+    YELLOW: (-1, 0),
+}
+MARKER_COLORS = tuple(MARKER_TO_STEP)
