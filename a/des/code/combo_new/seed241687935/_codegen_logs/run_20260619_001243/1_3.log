+GRID_MIN, GRID_MAX = 16, 28
+REGION_COUNT_RANGE = (1, 4)
+SHAPE_ATTEMPTS = 40
+PLACE_ATTEMPTS = 120
+GEN_ATTEMPTS = 400
+
+RECT_SIZE_RANGE = (5, 8)
+TAB_SIZE_RANGE = (5, 8)
+TAB_DEPTH_RANGE = (3, 5)
+EXTRA_ORANGE_RANGE = (0, 5)
