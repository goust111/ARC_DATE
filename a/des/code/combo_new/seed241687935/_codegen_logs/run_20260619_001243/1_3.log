+        dr, dc = MARKER_TO_STEP[color]
+        r, c = start
+        hit_blocker = False
+        while in_bounds(g.shape, r, c):
+            cell = int(g[r, c])
+            if cell == BLACK:
+                current = int(out[r, c])
+                assert current in (BLACK, color), "different rays may not conflict on black cells"
