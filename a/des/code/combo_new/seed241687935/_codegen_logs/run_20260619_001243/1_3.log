+    for marker, color in extract_enclosed_regions(g):
+        start = marker[0], 0
+        if color == RED:
+            start = marker[0], g.shape[1] - 1
+        elif color == BLUE:
+            start = 0, marker[1]
+        elif color == YELLOW:
+            start = g.shape[0] - 1, marker[1]
