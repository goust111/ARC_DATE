+def add_extra_oranges(
+    grid: np.ndarray,
+    forbidden: set[tuple[int, int]],
+) -> None:
+    candidates = [
+        (r, c)
+        for r in range(grid.shape[0])
+        for c in range(grid.shape[1])
+        if grid[r, c] == BLACK and (r, c) not in forbidden
