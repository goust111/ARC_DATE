+        if use_orange and len(full_segment) < 3:
+            continue
+        if not use_orange and len(full_segment) < 2:
+            continue
+
+        seg_wo_hit = set(full_segment[:-1])
+        if seg_wo_hit & occupied_nonblack:
+            continue
+        if seg_wo_hit & occupied_filled:
+            continue
+        if set(full_segment) & reserved_paths:
