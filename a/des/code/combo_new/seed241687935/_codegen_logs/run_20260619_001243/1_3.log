+
+def boundary_mask(filled: np.ndarray) -> np.ndarray:
+    filled = np.asarray(filled, dtype=bool)
+    out = np.zeros_like(filled)
+    for r, c in np.argwhere(filled):
+        rr = int(r)
+        cc = int(c)
