+            assert cell in (GREY, ORANGE), "rays must stop on grey or orange blockers"
+            current = int(out[r, c])
+            assert current in (GREY, ORANGE, MAROON), "blocking cells may only be grey, orange, or already maroon"
+            out[r, c] = MAROON
+            hit_blocker = True
+            break
