+    del frame
+    ray_cells: set[tuple[int, int]] = set()
+    marker_positions = {tuple(m["pos"]) for m in markers}
+    results: list[dict[str, object]] = []
+
+    for marker in sorted(markers, key=lambda m: m["order"]):
+        r, c = marker["pos"]
+        dr, dc = DIRS[str(marker["side"])]
+        cur_r, cur_c = int(r), int(c)
+        painted = 0
+        reason = "border"
+
+        while True:
+            nr = int(cur_r + dr)
+            nc = int(cur_c + dc)
+            cell = int(out[nr, nc])
+            if cell == FRAME:
+                reason = "border"
+                break
+            if (nr, nc) in ray_cells:
+                reason = "ray"
+                break
+            if (nr, nc) in marker_positions or cell != bg:
+                reason = "occupied"
+                break
+
+            out[nr, nc] = int(marker["color"])
+            ray_cells.add((nr, nc))
+            painted += 1
+            cur_r, cur_c = nr, nc
+
+        results.append(
+            {
+                "marker": marker,
+                "reason": reason,
+                "painted": int(painted),
+            }
+        )
+
+    return results
+
