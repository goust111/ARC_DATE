+def _blank_frame_grid(inner_h: int, inner_w: int) -> np.ndarray:
+    grid = np.full((inner_h + 2, inner_w + 2), BG, dtype=int)
+    grid[0, :] = FRAME
+    grid[-1, :] = FRAME
+    grid[:, 0] = FRAME
+    grid[:, -1] = FRAME
