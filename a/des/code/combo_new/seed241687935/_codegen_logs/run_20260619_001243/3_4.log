+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+SIDE_PRIORITY = {"top": 0, "right": 1, "bottom": 2, "left": 3}
+DIRS = {
+    "top": (1, 0),
+    "right": (0, -1),
+    "bottom": (-1, 0),
+    "left": (0, 1),
