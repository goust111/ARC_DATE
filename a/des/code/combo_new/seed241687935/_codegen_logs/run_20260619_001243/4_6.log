+        axis_len = inner_w if side in ("up", "down") else inner_h
+        gap_len = random.randint(1, axis_len - 1)
+        gap_start = random.randint(0, axis_len - gap_len)
+        ring_points = _ring_pixels_from_spec(box, side, gap_start, gap_len)
