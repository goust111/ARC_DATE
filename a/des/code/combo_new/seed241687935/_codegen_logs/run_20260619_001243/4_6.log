+    for r, c in dot_positions:
+        grid[r, c] = dot_color
+
+
+def _choose_grid_shape() -> tuple[int, int]:
+    return random.randint(14, 30), random.randint(14, 30)
+
+
+def _choose_ring_count(h: int, w: int) -> int:
+    m = min(h, w)
+    if m < 18:
+        return random.randint(1, 2)
+    if m < 24:
