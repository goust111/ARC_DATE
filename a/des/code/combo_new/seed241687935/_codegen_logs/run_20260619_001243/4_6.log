+        return None
+
+    rings = _find_rings(grid, 0)
+    if len(rings) != ring_count:
+        return None
+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return None
+    if out.shape != grid.shape:
+        return None
+    return grid
