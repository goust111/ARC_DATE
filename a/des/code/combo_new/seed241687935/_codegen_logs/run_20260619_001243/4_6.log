+def _sample_dot_positions(
+    box: tuple[int, int, int, int], side: str, gap_start: int, gap_len: int, dot_count: int
+) -> tuple[list[tuple[int, int]], set[tuple[int, int]]]:
+    r0, c0, r1, c1 = box
+    rows = list(range(r0 + 1, r1))
