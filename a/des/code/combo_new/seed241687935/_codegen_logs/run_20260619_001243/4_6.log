+            "ring_points": ring_points,
+            "ring_color": ring_color,
+            "dot_positions": dot_positions,
+            "dot_color": dot_color,
+            "gap_side": side,
+            "gap_start": gap_start,
+            "gap_len": gap_len,
+            "leaker_count": len(leaking_dots),
+            "blocked_count": dot_count - len(leaking_dots),
