+def _side_cells(box: tuple[int, int, int, int], side: str) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = box
+    if side == "up":
+        return [(r0, c) for c in range(c0, c1 + 1)]
+    if side == "down":
+        return [(r1, c) for c in range(c0, c1 + 1)]
+    if side == "left":
+        return [(r, c0) for r in range(r0, r1 + 1)]
+    if side == "right":
