+        return {
+            "box": box,
+            "ring_points": ring_points,
+            "ring_color": ring_color,
+            "dot_positions": dot_positions,
+            "dot_color": dot_color,
+            "gap_side": side,
+            "gap_start": gap_start,
+            "gap_len": gap_len,
+            "leaker_count": leaker_count,
+            "blocked_count": dot_count - leaker_count,
