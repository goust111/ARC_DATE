+    reserved = np.zeros((h, w), dtype=bool)
+
+    total_leakers = 0
+    total_blockers = 0
+    for idx in range(ring_count):
+        candidate = _build_ring_candidate(
+            h=h,
+            w=w,
+            reserved=reserved,
+            ring_color=ring_colors[idx],
+            dot_color=dot_colors[idx],
+            side=directions[idx],
