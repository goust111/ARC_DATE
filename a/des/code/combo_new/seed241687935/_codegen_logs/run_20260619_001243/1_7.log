+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+RING = [2, 7, 4, 3, 8, 1, 6]  # red -> orange -> yellow -> green -> azure -> blue -> magenta
+RING_INDEX = {color: idx for idx, color in enumerate(RING)}
+GEN_ATTEMPTS = 400
