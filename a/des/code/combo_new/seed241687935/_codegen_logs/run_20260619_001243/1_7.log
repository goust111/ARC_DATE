+        spin = 1
+    elif RING[(RING_INDEX[first] - 1) % len(RING)] == second:
+        spin = -1
+    else:
+        return None
+
+    for a, b in zip(colors, colors[1:]):
+        if RING[(RING_INDEX[a] + spin) % len(RING)] != b:
+            return None
+    return spin
