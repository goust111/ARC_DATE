+        out[r, c] = RING[color_idx]
+    return out
+
+
+def _seed_colors(length: int, spin: int) -> list[int]:
+    start = random.randrange(len(RING))
+    return [RING[(start + spin * i) % len(RING)] for i in range(length)]
+
+
+def _paint_seed(
+    grid: np.ndarray,
+    orientation: str,
+    start: tuple[int, int],
+    colors: list[int],
+    forward_geom: bool,
+) -> None:
+    display = colors if forward_geom else list(reversed(colors))
+    r0, c0 = start
