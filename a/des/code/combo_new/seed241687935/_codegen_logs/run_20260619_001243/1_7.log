+    if len(colors) < 2:
+        return None
+    if any(color not in RING_INDEX for color in colors):
+        return None
+
+    first = colors[0]
+    second = colors[1]
+    if RING[(RING_INDEX[first] + 1) % len(RING)] == second:
+        spin = 1
+    elif RING[(RING_INDEX[first] - 1) % len(RING)] == second:
+        spin = -1
+    else:
+        return None
+
