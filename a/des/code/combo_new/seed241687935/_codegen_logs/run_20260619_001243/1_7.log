+        if orientation == "h":
+            grid[r0, c0 + i] = color
+        else:
+            grid[r0 + i, c0] = color
+
+
+def _build_candidate(
+    h: int,
+    w: int,
+    orientation: str,
+    length: int,
+    spin: int,
+    forward_geom: bool,
+) -> np.ndarray:
+    grid = np.full((h, w), BG, dtype=int)
+    colors = _seed_colors(length, spin)
+
+    center_r = (h - 1) / 2.0
+    center_c = (w - 1) / 2.0
