 121: def main(grid: np.ndarray) -> np.ndarray:
 122:     """
 123:     Extend scattered colored segments into a woven grid using the legend's top-to-bottom layering order.
 124: 
 125:     Input structure:
 126:     - The background is black.
 127:     - A small grey-framed vertical legend sits near the lower-right corner; its interior contains one colored pixel per row.
 128:     - Elsewhere, there are isolated single-cell-wide horizontal and vertical colored segments, and each segment has one adjacent magenta pixel beyond each endpoint along its extension axis.
 129: 
 130:     Rule:
 131:     - Read the legend interior from top to bottom to obtain the color priority, with higher rows meaning higher visual layers.
 132:     - For every segment, use the two magenta endpoint markers to confirm its axis, then extend the segment from both ends all the way to the grid boundary using the segment's own color.
 133:     - Remove all magenta markers, and whenever extended lines overlap, keep only the color whose legend entry is highest. Restore the legend unchanged.
 134: 
 135:     Key insight:
 136:     - The magenta pixels are directional endpoint cues, while the legend order controls occlusion at every crossing rather than acting as a color-substitution table.
 137:     """
 138:     g = np.asarray(grid, dtype=int)
 139:     bg = _background_color(g)
 140:     legend_colors, legend_mask = _legend_info(g, bg)
 141:     priority = {color: idx for idx, color in enumerate(legend_colors)}
 142: 
 143:     out = np.full(g.shape, bg, dtype=int)
 144:     top_rank = np.full(g.shape, len(legend_colors) + 1, dtype=int)
 145:     found_segment = False
 146: 
 147:     for color in legend_colors:
 148:         for comp in _components((g == color) & ~legend_mask):
 149:             found_segment = True
 150:             orient, axis_value = _segment_orientation(g, comp)
 151:             rank = priority[color]
 152:             if orient == "H":
 153:                 r = axis_value
 154:                 for c in range(g.shape[1]):
 155:                     if legend_mask[r, c]:
 156:                         continue
 157:                     if rank < top_rank[r, c]:
 158:                         top_rank[r, c] = rank
 159:                         out[r, c] = color
 160:             else:
 161:                 c = axis_value
 162:                 for r in range(g.shape[0]):
 163:                     if legend_mask[r, c]:
 164:                         continue
 165:                     if rank < top_rank[r, c]:
 166:                         top_rank[r, c] = rank
 167:                         out[r, c] = color
 168: 
 169:     if not found_segment:
 170:         raise AssertionError("main: expected at least one colored segment outside the legend")
 171: 
 172:     out[legend_mask] = g[legend_mask]
 173:     return out
