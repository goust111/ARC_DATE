 101: def _random_partition(total: int, parts: int) -> list[int]:
 102:     assert 1 <= parts <= total
 103:     if parts == 1:
 104:         return [total]
 105:     cuts = np.sort(RNG.choice(np.arange(1, total), size=parts - 1, replace=False))
