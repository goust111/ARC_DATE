+BG = 0
+GREY = 5
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+BRANCHES = ("open_open", "open_closed", "closed_closed")
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_RETRIES = 500
