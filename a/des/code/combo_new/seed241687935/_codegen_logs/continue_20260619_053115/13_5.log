+        row = random.randint(r0, r0 + h - 1)
+        top = row - 1
+        left = c0 + w
+        rel = [(0, 1), (1, 0), (2, 1)]
+    elif direction == "down":
+        col = random.randint(c0, c0 + w - 1)
+        top = r0 - 2
+        left = col - 1
+        rel = [(0, 0), (0, 2), (1, 1)]
