+            block_h = random.randint(1, min(4, grid_h - 3))
+            if grid_h - block_h - 2 < 1:
+                continue
+            r0 = random.randint(1, grid_h - block_h - 2)
+            trail_w = random.randint(1, min(4, grid_w - 5))
