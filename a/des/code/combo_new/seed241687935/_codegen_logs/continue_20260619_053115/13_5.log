+    cols = [c for _, c in coords]
+    r0 = min(rows)
+    c0 = min(cols)
+    rel = tuple(sorted((r - r0, c - c0) for r, c in coords))
+    return int(r0), int(c0), rel
+
+
+def _make_block(color: int, coords: list[tuple[int, int]], direction: str | None = None) -> dict:
+    r0, c0, rel = _normalize(coords)
+    return {
+        "color": int(color),
+        "r0": int(r0),
+        "c0": int(c0),
+        "rel": rel,
+        "direction": direction,
+    }
