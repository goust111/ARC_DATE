+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+ARROW_COLOR = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+
+DIR_ORDER = ("up", "down", "left", "right")
+DIR_VECS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+ARROW_PATTERNS = {
+    frozenset({(0, 0), (1, 1), (2, 0)}): "right",
+    frozenset({(0, 1), (1, 0), (2, 1)}): "left",
+    frozenset({(0, 0), (0, 2), (1, 1)}): "down",
+    frozenset({(1, 0), (0, 1), (1, 2)}): "up",
