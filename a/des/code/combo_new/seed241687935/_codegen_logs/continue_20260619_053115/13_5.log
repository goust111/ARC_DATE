+
+def _rect_cells(r0: int, c0: int, h: int, w: int) -> list[tuple[int, int]]:
+    return [(r, c) for r in range(r0, r0 + h) for c in range(c0, c0 + w)]
+
+
+def _make_boundary_block(h: int, w: int, color: int, direction: str) -> dict | None:
