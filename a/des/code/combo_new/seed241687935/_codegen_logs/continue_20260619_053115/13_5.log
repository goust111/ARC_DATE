+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+ARROW_COLOR = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+
+DIR_ORDER = ("up", "down", "left", "right")
