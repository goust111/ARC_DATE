+def _stop_reason(blocks: list[dict], idx: int, shape: tuple[int, int]) -> str:
+    h, w = shape
+    cells = _block_cells(blocks[idx])
+    dr, dc = DIR_VECS[str(blocks[idx]["direction"])]
+    shifted = {(r + dr, c + dc) for r, c in cells}
