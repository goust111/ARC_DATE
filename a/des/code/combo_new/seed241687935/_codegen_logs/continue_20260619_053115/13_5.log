+ARROW_PATTERNS = {
+    frozenset({(0, 0), (1, 1), (2, 0)}): "right",
+    frozenset({(0, 1), (1, 0), (2, 1)}): "left",
+    frozenset({(0, 0), (0, 2), (1, 1)}): "down",
+    frozenset({(1, 0), (0, 1), (1, 2)}): "up",
