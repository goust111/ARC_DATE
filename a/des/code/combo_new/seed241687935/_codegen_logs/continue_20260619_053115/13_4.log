    mask = np.zeros((n, n), dtype=bool)
    mask[MIDDLE_INSET:MIDDLE_INSET + m, MIDDLE_INSET:MIDDLE_INSET + m] = local
    if not _is_rot_asym(mask):
        return None
    return mask


