+        c0, c1 = obj["outer_c0"] - length, obj["outer_c0"] - 1
+    else:
+        r0, r1 = obj["win_r0"], obj["win_r1"]
+        c0, c1 = obj["outer_c1"] + 1, obj["outer_c1"] + length
+
+    r0 = max(0, r0)
+    c0 = max(0, c0)
+    r1 = min(height - 1, r1)
+    c1 = min(width - 1, c1)
+    if r0 > r1 or c0 > c1:
