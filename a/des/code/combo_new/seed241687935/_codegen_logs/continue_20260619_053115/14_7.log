+        c0, c1 = obj["win_c0"], obj["win_c1"]
+    elif direction == "down":
+        r0, r1 = obj["outer_r1"] + 1, obj["outer_r1"] + length
+        c0, c1 = obj["win_c0"], obj["win_c1"]
+    elif direction == "left":
