+        assert len(marker_positions) == 1, "each cavity must have exactly one adjacent colored marker"
+        marker_r, marker_c = next(iter(marker_positions))
+        cavities.append(
+            {
+                "cells": comp,
+                "mask": _mask_from_coords(comp),
+                "marker_color": int(mold[marker_r, marker_c]),
+            }
+        )
