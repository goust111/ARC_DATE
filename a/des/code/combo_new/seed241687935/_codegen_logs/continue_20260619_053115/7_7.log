+            occupied[marker] = True
+            placed[idx] = {
+                "side": side,
+                "mask": mask,
+                "marker_color": int(spec["marker_color"]),
+                "cells": cells,
+                "marker": marker,
+            }
+            success = True
+            break
+        assert success, "failed to place all cavities"
+
+    return [item for item in placed if item is not None]
+
