+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+MARKER_PALETTE = (1, 2, 3, 4, 6, 8, 9)
+GREY = 5
+ORANGE = 7
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
