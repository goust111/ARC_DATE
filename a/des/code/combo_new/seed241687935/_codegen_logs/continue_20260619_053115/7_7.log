+            key = _canonical_key(mask)
+            if key in used_keys:
+                continue
+            used_keys.add(key)
+            specs.append(
+                {
+                    "side": side,
+                    "mask": mask,
+                    "marker_rel": marker_rel,
+                    "marker_color": int(marker_color),
+                    "piece_mask": np.rot90(mask, random.randrange(4)),
