+def _grow_connected(h: int, w: int, start: tuple[int, int], target_area: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    occupied = {start}
+    frontier = set(_neighbors(start[0], start[1], h, w))
+    mask[start] = True
