+        grid[top, left + opening] = BG
+    elif entrance == RIGHT:
+        grid[top + opening, left + outer - 1] = BG
+    elif entrance == DOWN:
+        grid[top + outer - 1, left + opening] = BG
+    else:
+        grid[top + opening, left] = BG
