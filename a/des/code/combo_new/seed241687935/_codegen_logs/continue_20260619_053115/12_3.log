+    relative_rotations = [_rotation_index(base, room["interior"]) for room in rooms]
+    shift_counts = Counter((room["entrance"] + rot) % 4 for room, rot in zip(rooms, relative_rotations))
+    shift, count = shift_counts.most_common(1)[0]
