+
+    for idx in order:
+        h, w = shapes[idx]
+        if h + 2 > top_h or w + 2 > width:
+            return None
+        candidates: list[tuple[int, int]] = []
+        for r in range(1, top_h - h):
+            for c in range(1, width - w):
+                if occupied[r - 1 : r + h + 1, c - 1 : c + w + 1].any():
+                    continue
+                candidates.append((r, c))
+        if not candidates:
+            return None
+        pos = _randchoice(rng, candidates)
+        placements[idx] = pos
+        r, c = pos
