+        h, w = int(obj["h"]), int(obj["w"])
+        grid[r0 : r0 + h, c0 : c0 + w] = int(obj["color"])
+    for obj in marked:
+        r0, c0 = int(obj["r0"]), int(obj["c0"])
+        h, w = int(obj["h"]), int(obj["w"])
+        grid[r0 : r0 + h, c0 : c0 + w] = int(obj["color"])
+        for mr, mc in obj["markers"]:
