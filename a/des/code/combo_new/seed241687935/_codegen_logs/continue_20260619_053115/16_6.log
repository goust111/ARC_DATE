+        c_min, c_max = count + 1, w_grid - w - 2
+    else:
+        r_min, r_max = 1, h_grid - h - 2
+        c_min, c_max = 1, w_grid - w - count - 2
+
+    if r_min > r_max or c_min > c_max:
+        return None
+
+    for _ in range(PLACE_RETRIES):
+        r0 = rng.randint(r_min, r_max)
+        c0 = rng.randint(c_min, c_max)
