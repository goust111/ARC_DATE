+    span = h - 2
+    if span < count:
+        raise ValueError("shape too short for marker segment")
+    start = rng.choice(_centered_segment_starts(span, count))
+    col = 1 if direction == "left" else w - 2
+    return [(1 + start + offset, col) for offset in range(count)]
