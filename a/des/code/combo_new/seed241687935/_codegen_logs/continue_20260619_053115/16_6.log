+        shape_color, markers = _shape_and_markers(g, pts)
+        if not markers:
+            continue
+        for r, c in markers:
+            out[r, c] = shape_color
+        bbox = _bbox(pts)
+        direction = _direction_from_markers(markers, bbox)
+        _fill_extension(out, bg, shape_color, bbox, direction, len(markers))
