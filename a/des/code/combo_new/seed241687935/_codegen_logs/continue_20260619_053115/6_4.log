+BG = 0
+WALL = 5
+LAYOUTS = [(2, 2), (2, 3), (3, 2)]
+ROOM_SIZE_RANGE = (4, 5)
+BASE_MARGIN = 5
+MAX_TEMPLATE_DIM = 5
+MAX_GENERATION_ATTEMPTS = 300
+SIDES = ("top", "bottom", "left", "right")
+ANCHORS = ("tl", "tr", "bl", "br")
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
