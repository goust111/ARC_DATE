+def _random_connected_mask(
+    height: int,
+    width: int,
+    anchor: str,
+    rng: random.Random,
+) -> np.ndarray:
+    required = {
+        "tl": (0, 0),
+        "tr": (0, width - 1),
+        "bl": (height - 1, 0),
+        "br": (height - 1, width - 1),
