        roots=[u for u in rem if indeg[u]==0]
        assert len(roots)==1, (roots,edges)
        u=roots[0]
        order.append(u)
        rem.remove(u)
    bottom=order[0]
    out=np.full_like(g,bg)
    out[g==node_color]=node_color
    for r,c in paths[bottom]['cells']:
        out[r,c]=bottom
    return out


def choose_pair_bases(limit_low, limit_high, pair_count):
    # choose bases b with b,b+1 valid and gaps >=4 between pairs
    for _ in range(200):
        if pair_count==1:
            b=random.randint(limit_low, limit_high)
            return [b]
        b1=random.randint(limit_low, limit_high-5)
        b2=random.randint(b1+5, limit_high)
        return [b1,b2]
    raise RuntimeError


def generate_input():
    pair_count=random.choice([1,2])
    n=2*pair_count
