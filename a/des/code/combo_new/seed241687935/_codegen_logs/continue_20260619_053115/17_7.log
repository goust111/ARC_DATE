    for b in col_bases:
        grid[1:3,b:b+2]=NODE
        grid[H-3:H-1,b:b+2]=NODE
    h_ids=list(range(len(h_rows)))
    v_ids=list(range(len(v_cols)))
    random.shuffle(h_ids); random.shuffle(v_ids)
    start=random.choice(['H','V'])
    layer=[]
    for i in range(n):
