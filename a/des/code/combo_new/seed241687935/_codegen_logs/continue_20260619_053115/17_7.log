    colors=random.sample(PALETTE,2*n)
    h_color={i:colors.pop() for i in range(len(h_rows))}
    v_color={i:colors.pop() for i in range(len(v_cols))}
    # reassign by layer order? colors independent okay.
    # Need actual rank by layer using current colors
    rank=[]
    for orient,idx in layer:
        rank.append(h_color[idx] if orient=='H' else v_color[idx])
    # path cells map
    path_cells={}
    for i,r in enumerate(h_rows):
        color=h_color[i]
        cells=[(r,c) for c in range(3,W-3)]
        path_cells[color]=cells
    for i,c in enumerate(v_cols):
        color=v_color[i]
        cells=[(r,c) for r in range(3,H-3)]
        path_cells[color]=cells
    # paint by rank bottom->top
    for color in rank:
        for r,c in path_cells[color]:
            grid[r,c]=color
    return grid

for i in range(200):
    g=generate_input()
    o=main(g)
    assert g.shape==o.shape
