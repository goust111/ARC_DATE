import random
import numpy as np
from collections import Counter, defaultdict, deque

BG=0
NODE=5
PALETTE=[1,2,3,4,6,7,8,9]

def components(mask):
    H,W=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    out=[]
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or seen[r,c]:
                continue
            q=[(r,c)]
            seen[r,c]=True
            coords=[]
            while q:
                rr,cc=q.pop()
                coords.append((rr,cc))
                for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc]=True
                        q.append((nr,nc))
            out.append(coords)
    return out


def infer_node_color(g,bg):
    colors=[int(x) for x in np.unique(g) if int(x)"'!=bg]
    cands=[]
    for color in colors:
        comps=components(g==color)
        if comps and all(len(comp)==4 for comp in comps):
            ok=True
            for comp in comps:
                rs=[p[0] for p in comp]; cs=[p[1] for p in comp]
                if max(rs)-min(rs)!=1 or max(cs)-min(cs)!=1:
                    ok=False; break
            if ok:
                cands.append(color)
    assert len(cands)==1, cands
    return cands[0]


def main(grid):
    g=np.asarray(grid,dtype=int)
    bg=Counter(map(int,g.flat)).most_common(1)[0][0]
    node_color=infer_node_color(g,bg)
    node_comps=components(g==node_color)
    nodes=[]
    node_cells=set()
    for comp in node_comps:
        rs=[p[0] for p in comp]; cs=[p[1] for p in comp]
        r0,r1=min(rs),max(rs); c0,c1=min(cs),max(cs)
        nodes.append((r0,c0,r1,c1))
        node_cells.update(comp)
    path_endpoints=defaultdict(list)
    side_specs=[]
    for r0,c0,r1,c1 in nodes:
        side_specs.extend([])
        positions=[
            ((r0,c0-1),'"'L'),((r1,c0-1),'L'),((r0,c1+1),'R'),((r1,c1+1),'R'),
            ((r0-1,c0),'U'),((r0-1,c1),'U'),((r1+1,c0),'D'),((r1+1,c1),'D'),
        ]
        seen_colors=set()
        records=[]
        for (rr,cc),side in positions:
            if 0<=rr<g.shape[0] and 0<=cc<g.shape[1]:
                color=int(g[rr,cc])
                if color not in (bg,node_color):
                    assert color not in seen_colors
                    seen_colors.add(color)
                    records.append((color,side,rr,cc,(r0,c0,r1,c1)))
        assert len(records)==2, records
        for rec in records:
            path_endpoints[rec[0]].append(rec[1:])
    paths={}
    for color,recs in path_endpoints.items():
        assert len(recs)==2, (color,recs)
        sides=[r[0] for r in recs]
        if all(s in 'LR' for s in sides):
            row0,row1=recs[0][1],recs[1][1]
            assert row0==row1
            row=row0
            cols=sorted([recs[0][2],recs[1][2]])
            cells={(row,c) for c in range(cols[0],cols[1]+1)}
            orient='H'
        else:
            assert all(s in 'UD' for s in sides)
            col0,col1=recs[0][2],recs[1][2]
            assert col0==col1
            col=col0
            rows=sorted([recs[0][1],recs[1][1]])
            cells={(r,col) for r in range(rows[0],rows[1]+1)}
            orient='V'
        visible={(r,c) for r,c in np.argwhere(g==color)}
        assert visible <= cells
        paths[color]={'orient':orient,'cells':cells}
    edges=set()
    colors=sorted(paths)
    for i,a in enumerate(colors):
        for b in colors[i+1:]:
            if paths[a]['orient']==paths[b]['orient']:
                continue
            inter=paths[a]['cells'] & paths[b]['cells']
            inter=[p for p in inter if p not in node_cells]
            if not inter:
