+BLACK = 0
+GREY = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+RNG = np.random.default_rng()
+
+# Generator configuration.
+BOARD_MIN = 8
