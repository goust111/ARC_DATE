+            viable_by_piece[idx] = viable
+            piece_union = 0
+            for mask in viable:
+                piece_union |= mask
+            union_mask |= piece_union
+        if (union_mask | used_mask) != full_mask:
+            return False
+
+        needed = full_mask & ~used_mask
+        pivot = needed & -needed
+
+        candidate_groups = []
+        for idx in remaining:
+            covers = tuple(mask for mask in viable_by_piece[idx] if mask & pivot)
+            if covers:
