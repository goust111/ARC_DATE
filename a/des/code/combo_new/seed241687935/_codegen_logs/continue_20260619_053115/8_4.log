+import numpy as np
+
+from functools import lru_cache
+
+
+BLACK = 0
+GREY = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+RNG = np.random.default_rng()
+
+# Generator configuration.
+BOARD_MIN = 8
+BOARD_MAX = 11
+RECT_MIN = 3
+RECT_MAX = 5
+GROUP_COUNT_MIN = 2
+GROUP_COUNT_MAX = 4
+PIECE_COUNT_OPTIONS = (2, 3)
+MAX_GENERATION_ATTEMPTS = 400
