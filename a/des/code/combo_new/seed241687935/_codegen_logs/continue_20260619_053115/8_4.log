+
+@lru_cache(maxsize=None)
+def _can_tile_holey_rectangle(
+    shapes_key: tuple[tuple[tuple[int, int], ...], ...],
+    height: int,
+    width: int,
+    hole_r: int,
+    hole_c: int,
