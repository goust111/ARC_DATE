+
+def _neighbors4(r: int, c: int):
+    for dr, dc in NEIGHBORS4:
+        yield r + dr, c + dc
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(int(r), int(c))]
+            seen[r, c] = True
+            cells = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _normalize_shape(coords) -> tuple[tuple[int, int], ...]:
+    pts = [(int(r), int(c)) for r, c in coords]
+    r0 = min(r for r, _ in pts)
+    c0 = min(c for _, c in pts)
+    return tuple(sorted((r - r0, c - c0) for r, c in pts))
+
+
+def _shape_extent(shape: tuple[tuple[int, int], ...]) -> tuple[int, int]:
+    return max(r for r, _ in shape) + 1, max(c for _, c in shape) + 1
+
+
+def _canonical_shapes(shapes) -> tuple[tuple[tuple[int, int], ...], ...]:
