+    r1, c1 = coords.max(axis=0)
+    r0 = int(r0)
+    c0 = int(c0)
+    r1 = int(r1)
+    c1 = int(c1)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return None
+
+    box = grid[r0 : r1 + 1, c0 : c1 + 1]
+    if not (
+        np.all(box[0, :] == color)
+        and np.all(box[-1, :] == color)
+        and np.all(box[:, 0] == color)
+        and np.all(box[:, -1] == color)
+    ):
+        return None
+    if not np.all((box == BG) | (box == color)):
+        return None
+
+    inner = box[1:-1, 1:-1]
+    if inner.size == 0:
