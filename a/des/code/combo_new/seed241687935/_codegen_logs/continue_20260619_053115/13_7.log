+    patch[1:-1, 1:-1][hole_full] = BG
+    return patch
+
+
+def _crop_piece_patch(piece_color: int, hole_full: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    cropped, _ = _crop_true(hole_full)
+    patch = np.zeros(cropped.shape, dtype=int)
