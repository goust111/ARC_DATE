+def _extract_frames(grid: np.ndarray, frame_color: int) -> list[tuple[int, int, int, int]]:
+    frames: list[tuple[int, int, int, int]] = []
+    for coords in _components(grid == frame_color):
+        r0, c0, r1, c1 = _bbox(coords)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
