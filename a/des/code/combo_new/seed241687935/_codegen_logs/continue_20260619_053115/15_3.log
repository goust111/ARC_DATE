+def _boundary_background(grid: np.ndarray) -> int:
+    boundary = np.concatenate(
+        [
+            grid[0, :],
+            grid[-1, :],
+            grid[1:-1, 0],
+            grid[1:-1, -1],
+        ]
+    )
+    return Counter(map(int, boundary)).most_common(1)[0][0]
+
