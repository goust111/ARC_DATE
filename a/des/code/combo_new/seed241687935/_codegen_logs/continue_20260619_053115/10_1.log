+                    "c0": int(c0),
+                    "outer_h": outer_h,
+                    "outer_w": outer_w,
+                    "seed_dr": int(spec["seed_dr"]),
+                    "seed_dc": int(spec["seed_dc"]),
+                    "seed_color": int(spec["seed_color"]),
