+import random
+
+import numpy as np
+
+
+BG = 0
+ARROW_COLOR = 9
+GEN_ATTEMPTS = 400
+GEN_COLORS = (1, 2, 3, 4, 5, 6, 7, 8)
+
+ARROW_PATTERNS = {
+    "right": {(1, 0), (1, 1), (1, 2), (0, 2), (2, 2)},
+    "left": {(1, 0), (1, 1), (1, 2), (0, 0), (2, 0)},
+    "up": {(0, 0), (0, 1), (0, 2), (1, 1), (2, 1)},
+    "down": {(0, 1), (1, 1), (2, 1), (2, 0), (2, 2)},
+}
+
+HOLE_PLANS = (
+    (0, 1),
+    (0, 2),
+    (0, 3),
+    (0, 1, 1),
+    (0, 1, 2),
