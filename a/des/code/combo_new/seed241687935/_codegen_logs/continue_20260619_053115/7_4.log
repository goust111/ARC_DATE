+    gap_extras = _random_split(vertical_slack, len(sprites) + 1, rng)
+
+    row_positions: list[int] = []
+    cursor = (arrow_band if arrow_side == "top" else 0) + gap_extras[0]
+    for index, height in enumerate(heights):
