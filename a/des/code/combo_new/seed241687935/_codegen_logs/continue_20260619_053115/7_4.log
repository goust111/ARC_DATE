+        else:
+            if hole_count == 0:
+                h = rng.randint(3, 5)
+                w = rng.randint(3, 5)
+            elif hole_count == 1:
+                h = rng.randint(4, 5)
+                w = rng.randint(4, 5)
+            elif hole_count == 2:
+                h = rng.randint(4, 6)
+                w = rng.randint(4, 6)
+            else:
+                h = rng.randint(5, 6)
+                w = rng.randint(5, 6)
+
+            mask = np.ones((h, w), dtype=bool)
+            hole_cells = _sample_hole_cells(h, w, hole_count, rng)
+            if hole_cells is None:
+                continue
+            for r, c in hole_cells:
+                mask[r, c] = False
+
+            if hole_count:
+                for r, c in hole_cells:
+                    if rng.random() >= 0.35:
+                        continue
+                    dirs = list(_neighbors4(0, 0))
+                    rng.shuffle(dirs)
+                    for dr, dc in dirs:
+                        nr, nc = r + dr, c + dc
+                        if 1 <= nr < h - 1 and 1 <= nc < w - 1 and mask[nr, nc]:
+                            mask[nr, nc] = False
+                            trial = _trim_mask(mask)
+                            if _valid_mask(trial, hole_count):
+                                mask = trial
+                                h, w = mask.shape
+                            else:
+                                mask[nr, nc] = True
+                            break
+
+            for _ in range(rng.randint(0, 3 if hole_count else 4)):
+                h, w = mask.shape
+                boundary = [
+                    (r, c)
+                    for r in range(h)
+                    for c in range(w)
+                    if mask[r, c] and (r in (0, h - 1) or c in (0, w - 1))
+                ]
+                rng.shuffle(boundary)
+                removed = False
+                for r, c in boundary:
+                    trial = mask.copy()
+                    trial[r, c] = False
+                    trial = _trim_mask(trial)
+                    if _valid_mask(trial, hole_count):
+                        mask = trial
+                        removed = True
+                        break
+                if not removed:
+                    break
+
+        k = rng.randrange(4)
+        mask = np.rot90(mask, k)
+        if rng.random() < 0.5:
+            mask = np.fliplr(mask)
+        if rng.random() < 0.5:
