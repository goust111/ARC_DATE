+            out[mid_r, c0 + 1 : c0 + 1 + inner_w] = fill_color
+        else:
+            out[r0 + 1 : r0 + 1 + inner_h, c0 + 1] = fill_color
+            out[r0 + 1 : r0 + 1 + inner_h, c0 + inner_w] = fill_color
+    return out
