+        same_strip = np.array_equal(row2[c0 : c1 + 1], row[c0 : c1 + 1])
+        clean_margin = bool((row2[:c0] == BG).all() and (row2[c1 + 1 :] == BG).all())
+        if same_strip and clean_margin:
