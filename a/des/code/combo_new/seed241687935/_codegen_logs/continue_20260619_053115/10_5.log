+def _frame_specs(grid: np.ndarray, palette_top: int) -> list[tuple[int, int, int, int]]:
+    search = grid[:palette_top, :]
+    comps = _components4(search != BG)
+    frames: list[tuple[int, int, int, int]] = []
+    for comp in comps:
