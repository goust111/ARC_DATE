+def _apply_rule(grid: np.ndarray, frames: list[dict], pairs: list[dict]) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    h, w = out.shape
+    border_mask = np.zeros((h, w), dtype=bool)
+    interior_owner = np.full((h, w), -1, dtype=int)
