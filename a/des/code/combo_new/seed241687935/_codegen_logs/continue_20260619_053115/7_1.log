+        want_untouched = len(frames) > 1 and random.random() < 0.7
+        want_free = bool(free_coords) and random.random() < 0.5
+        min_pairs = 2 if max_pairs >= 2 else 1
+        target = random.randint(min_pairs, max_pairs)
+
