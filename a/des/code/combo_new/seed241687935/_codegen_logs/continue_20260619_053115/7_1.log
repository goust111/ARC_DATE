+    for idx, frame in enumerate(frames):
+        r0, c0, r1, c1 = frame["bbox"]
+        border_mask[r0 : r1 + 1, c0] = True
+        border_mask[r0 : r1 + 1, c1] = True
+        border_mask[r0, c0 : c1 + 1] = True
+        border_mask[r1, c0 : c1 + 1] = True
+        interior_owner[r0 + 1 : r1, c0 + 1 : c1] = idx
