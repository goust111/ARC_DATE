+        used: set[int] = set()
+
+        if want_priority:
+            frame_id = random.choice(list(multi_candidates))
+            chosen = random.sample(multi_candidates[frame_id], 2)
+            coords.extend(chosen)
+            used.update(chosen)
+
+        if not coords:
