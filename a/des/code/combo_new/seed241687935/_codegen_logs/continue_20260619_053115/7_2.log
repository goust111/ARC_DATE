+from __future__ import annotations
+
+from collections import Counter, defaultdict, deque
+
+import numpy as np
+
+
+BLACK = 0
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+RNG = np.random.default_rng()
