+    assert frames, "expected at least one frame"
+    assert len(marker_colors) == 1, "all markers must share one color"
+    return bg, frames
+
+
+def _transform(grid: np.ndarray) -> np.ndarray:
+    out = grid.copy()
+    bg, frames = _parse_scene(out)
