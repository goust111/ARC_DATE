+        return False
+    rel = {(int(r - r0), int(c - c0)) for r, c in coords}
+    for rr in range(h):
+        for cc in range(w):
+            on_perimeter = rr == 0 or rr == h - 1 or cc == 0 or cc == w - 1
+            if ((rr, cc) in rel) != on_perimeter:
