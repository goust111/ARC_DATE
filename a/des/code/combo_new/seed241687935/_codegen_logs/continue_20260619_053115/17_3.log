+        window = grid[top : top + patch.shape[0], left : left + patch.shape[1]]
+        window[patch == OBJECT_COLOR] = OBJECT_COLOR
+
+        reserved = bbox | rays
+        for r, c in reserved:
+            occupied[r, c] = True
+        _mark_buffer(buffer, reserved)
