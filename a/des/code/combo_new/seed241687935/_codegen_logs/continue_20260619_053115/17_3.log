+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+OBJECT_COLOR = 5
+PALETTE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS = ("up", "down", "left", "right")
+THICKNESS = 3
+GEN_RETRIES = 400
