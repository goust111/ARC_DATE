+    return None
+
+
+def _cavity_positions(mask: np.ndarray, hole_h: int, hole_w: int) -> list[tuple[int, int]]:
+    h, w = map(int, mask.shape)
+    out: list[tuple[int, int]] = []
+    for r in range(1, h - hole_h):
