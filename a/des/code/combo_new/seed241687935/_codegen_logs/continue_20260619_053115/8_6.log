+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = map(int, mask.shape)
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.asarray(cells, dtype=int))
+    return out
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _mask_from_coords(coords: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    out = np.zeros(shape, dtype=bool)
+    out[coords[:, 0], coords[:, 1]] = True
+    return out
+
+
+def _hole_infos(mask: np.ndarray) -> list[dict]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = map(int, mask.shape)
+    bg = ~mask
+    seen = np.zeros((h, w), dtype=bool)
+    holes: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if not bg[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            touches_border = False
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((cr, cc))
+                if cr == 0 or cr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_border = True
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and bg[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            if touches_border:
+                continue
+            coords = np.asarray(cells, dtype=int)
+            r0, c0, r1, c1 = _bbox(coords)
+            rel = coords - np.asarray([[r0, c0]])
+            hole_mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            hole_mask[rel[:, 0], rel[:, 1]] = True
+            holes.append({"coords": coords, "bbox": (r0, c0, r1, c1), "mask": hole_mask})
