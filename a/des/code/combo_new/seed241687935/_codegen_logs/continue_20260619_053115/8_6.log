+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+GRID_LIMIT = 30
+GEN_RETRIES = 400
+PAIR_RETRIES = 200
+TEMPLATE_RETRIES = 200
+PLACEMENT_RETRIES = 300
