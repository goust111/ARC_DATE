+def _canonical_key(mask: np.ndarray) -> tuple[int, int, bytes]:
+    best = None
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        key = (int(rot.shape[0]), int(rot.shape[1]), rot.astype(np.uint8).tobytes())
+        if best is None or key < best:
