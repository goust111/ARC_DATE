+
+
+def _build_pair(used_keys: set[tuple[int, int, bytes]], small_mode: bool) -> dict | None:
+    for _ in range(PAIR_RETRIES):
+        hole_h = random.randint(3, 4 if small_mode else 5)
+        if random.random() < 0.4:
+            hole_w = hole_h
