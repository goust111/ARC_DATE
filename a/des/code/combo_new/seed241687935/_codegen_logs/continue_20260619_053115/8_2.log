+    top = rng.randint(*FRAME_MARGIN_RANGE)
+    left = rng.randint(*FRAME_MARGIN_RANGE)
+    bottom = h - 1 - rng.randint(*FRAME_MARGIN_RANGE)
+    right = w - 1 - rng.randint(*FRAME_MARGIN_RANGE)
