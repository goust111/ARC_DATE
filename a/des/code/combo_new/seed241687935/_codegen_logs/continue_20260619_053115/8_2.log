+    top, bottom, left, right = cell
+    choices = []
+    if right - left >= 2 * MIN_CHILD_SPAN:
+        choices.append("v")
+    if bottom - top >= 2 * MIN_CHILD_SPAN:
+        choices.append("h")
+    if not choices:
+        return None
