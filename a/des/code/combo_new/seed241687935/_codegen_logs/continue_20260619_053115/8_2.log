+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or int(labels[r, c]) != 0:
+                continue
+            next_id += 1
+            q = deque([(r, c)])
+            labels[r, c] = next_id
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
