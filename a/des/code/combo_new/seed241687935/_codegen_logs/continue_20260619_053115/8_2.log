+def _share_boundary(cell_a: tuple[int, int, int, int], cell_b: tuple[int, int, int, int]) -> bool:
+    ta, ba, la, ra = cell_a
+    tb, bb, lb, rb = cell_b
+    if ra == lb or rb == la:
+        overlap = min(ba, bb) - max(ta, tb)
+        return overlap >= 2
+    if ba == tb or bb == ta:
+        overlap = min(ra, rb) - max(la, lb)
+        return overlap >= 2
