+    "down": (((0, 0), (0, 1), (0, 2), (1, 0)), ((0, 0), (0, 1), (0, 2), (1, 2))),
+    "left": (((0, 0), (0, 1), (1, 1), (2, 1)), ((2, 0), (0, 1), (1, 1), (2, 1))),
+    "right": (((0, 0), (1, 0), (2, 0), (0, 1)), ((0, 0), (1, 0), (2, 0), (2, 1))),
+}
+POINTER_BOX = {"up": (2, 3), "down": (2, 3), "left": (3, 2), "right": (3, 2)}
+MAX_GENERATION_ATTEMPTS = 400
