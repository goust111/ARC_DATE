+        shape = {start}
+        frontier = {start}
+        while len(shape) < target and frontier:
+            cell = random.choice(tuple(frontier))
+            frontier.remove(cell)
+            r, c = cell
+            neighbors = []
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < inner_h and 0 <= nc < inner_w and (nr, nc) not in shape:
