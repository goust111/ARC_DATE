+BG = 0
+MASK_COLOR = 9
+FRAME_COLOR_CHOICES = (5, 6, 7, 8)
+POINTER_COLOR_POOL = (1, 2, 3, 4, 5, 6, 7, 8)
+DIRECTIONS = ("up", "down", "left", "right")
+PAIR_COUNT_CHOICES = (2, 3, 4, 4)
+POINTER_SHAPES = {
