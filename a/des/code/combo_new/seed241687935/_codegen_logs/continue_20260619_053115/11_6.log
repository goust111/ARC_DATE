+def _paint_frame(grid: np.ndarray, r0: int, c0: int, inner_h: int, inner_w: int, frame_color: int) -> tuple[int, int, int, int]:
+    frame_h = inner_h + 2
+    frame_w = inner_w + 2
+    r1 = r0 + frame_h - 1
+    c1 = c0 + frame_w - 1
