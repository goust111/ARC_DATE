+                    "color": color,
+                    "coords": tuple(coords),
+                    "bbox": _bbox(coords),
+                }
+            )
+
+    return comps
+
+
+def _frame_info(comp: dict) -> dict | None:
+    coords = list(comp["coords"])
+    r0, c0, r1, c1 = comp["bbox"]
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    if height < 3 or width < 3:
+        return None
+
+    expected = set()
+    for rr in range(r0, r1 + 1):
+        expected.add((rr, c0))
+        expected.add((rr, c1))
+    for cc in range(c0, c1 + 1):
+        expected.add((r0, cc))
+        expected.add((r1, cc))
+
+    coord_set = set(coords)
+    if coord_set != expected:
+        return None
+
+    return {
+        "color": int(comp["color"]),
+        "coords": comp["coords"],
+        "coord_set": coord_set,
+        "bbox": comp["bbox"],
