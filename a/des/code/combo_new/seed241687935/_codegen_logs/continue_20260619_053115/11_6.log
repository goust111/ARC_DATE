+def _mark_rect(blocked: np.ndarray, r0: int, c0: int, height: int, width: int, pad: int = 1) -> None:
+    h, w = blocked.shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h, r0 + height + pad)
+    cc1 = min(w, c0 + width + pad)
+    blocked[rr0:rr1, cc0:cc1] = True
