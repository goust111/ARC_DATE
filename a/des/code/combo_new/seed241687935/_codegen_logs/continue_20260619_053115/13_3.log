+    rows = _sample_positions(rng, 1, body_h - 2, horiz_count)
+    cols = _sample_positions(rng, 1, body_w - 2, vert_count)
+    if rows is None or cols is None:
+        return None
+
+    min_row, max_row = min(rows), max(rows)
+    min_col, max_col = min(cols), max(cols)
