+    right_arm = random.randint(1, 4)
+    if receiver == "h":
+        while left_arm == right_arm:
+            right_arm = random.randint(1, 4)
+    cross_c = random.randint(3, w - 4)
+    h_lo = cross_c - left_arm
+    h_hi = cross_c + right_arm
+    if h_lo < 1 or h_hi > w - 2:
+        return None
+
+    # Vertical belt.
+    col = cross_c
+    up_arm = random.randint(1, 4)
