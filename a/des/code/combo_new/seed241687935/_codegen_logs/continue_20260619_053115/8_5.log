+        side_w = c1 - c0 + 1
+        if side_h != side_w or side_h < 7 or side_h % 2 == 0:
+            continue
+        border = set()
+        for c in range(c0, c1 + 1):
+            border.add((r0, c))
+            border.add((r1, c))
+        for r in range(r0, r1 + 1):
+            border.add((r, c0))
+            border.add((r, c1))
