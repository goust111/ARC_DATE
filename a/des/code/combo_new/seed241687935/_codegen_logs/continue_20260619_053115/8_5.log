+    placements: list[tuple[int, int]] = []
+    for case in cases:
+        side = int(case["side"])
+        positions: list[tuple[int, int]] = []
+        for top in range(1, h - side):
+            for left in range(1, w - side):
+                r0 = max(0, top - 1)
+                c0 = max(0, left - 1)
+                r1 = min(h, top + side + 1)
+                c1 = min(w, left + side + 1)
+                if not occupied[r0:r1, c0:c1].any():
