+def _paint_ring(canvas: np.ndarray, r0: int, c0: int, height: int, width: int, color: int) -> None:
+    r1 = r0 + height - 1
+    c1 = c0 + width - 1
+    canvas[r0, c0 : c1 + 1] = color
+    canvas[r1, c0 : c1 + 1] = color
+    canvas[r0 + 1 : r1, c0] = color
+    canvas[r0 + 1 : r1, c1] = color
