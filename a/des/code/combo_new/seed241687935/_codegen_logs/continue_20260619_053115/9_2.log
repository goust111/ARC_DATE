+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+AZURE = 8
+ARC_MAX = 30
+
+# Generator settings.
+COLOR_POOL = tuple(color for color in range(10) if color != AZURE)
+RING_COUNT_RANGE = (2, 4)
+RING_HEIGHT_RANGE = (4, 9)
+RING_WIDTH_MIN = 4
+GRID_HEIGHT_CAP = 24
+GRID_WIDTH_CAP = 24
+MIN_VISIBLE_CELLS = 6
+MIN_VISIBLE_SPAN = 3
+GEN_ATTEMPTS = 400
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    if np.any(grid == AZURE):
+        return AZURE
+    return _most_common_color(grid)
+
+
+def _ring_border_cells(
+    r0: int,
+    c0: int,
+    height: int,
+    width: int,
+    grid_height: int,
+    grid_width: int,
+) -> list[tuple[int, int]]:
+    r1 = r0 + height - 1
+    c1 = c0 + width - 1
+    cells: list[tuple[int, int]] = []
+
+    left = max(0, c0)
+    right = min(grid_width - 1, c1)
+    if left <= right:
+        if 0 <= r0 < grid_height:
+            for c in range(left, right + 1):
+                cells.append((r0, c))
+        if r1 != r0 and 0 <= r1 < grid_height:
+            for c in range(left, right + 1):
+                cells.append((r1, c))
+
+    top = max(0, r0 + 1)
+    bottom = min(grid_height - 1, r1 - 1)
+    if top <= bottom:
+        if 0 <= c0 < grid_width:
+            for r in range(top, bottom + 1):
+                cells.append((r, c0))
+        if c1 != c0 and 0 <= c1 < grid_width:
+            for r in range(top, bottom + 1):
+                cells.append((r, c1))
+
+    return cells
+
+
+def _paint_ring(canvas: np.ndarray, r0: int, c0: int, height: int, width: int, color: int) -> None:
+    r1 = r0 + height - 1
+    c1 = c0 + width - 1
