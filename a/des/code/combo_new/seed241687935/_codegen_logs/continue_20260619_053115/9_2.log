+    right = min(grid_width - 1, c1)
+    if left <= right:
+        if 0 <= r0 < grid_height:
+            for c in range(left, right + 1):
+                cells.append((r0, c))
+        if r1 != r0 and 0 <= r1 < grid_height:
+            for c in range(left, right + 1):
+                cells.append((r1, c))
+
+    top = max(0, r0 + 1)
+    bottom = min(grid_height - 1, r1 - 1)
+    if top <= bottom:
+        if 0 <= c0 < grid_width:
+            for r in range(top, bottom + 1):
+                cells.append((r, c0))
+        if c1 != c0 and 0 <= c1 < grid_width:
+            for r in range(top, bottom + 1):
+                cells.append((r, c1))
