+def _unique_topological_order(
+    colors: list[int], parents_by_color: dict[int, frozenset[int]]
+) -> list[int] | None:
+    above_to_below = {color: set() for color in colors}
+    indegree = {color: 0 for color in colors}
+
+    for color in colors:
