+            if cell in seen:
+                return True
+            seen.add(cell)
+    return False
+
+
+def _incoming_hits_solid_face(rays: list[dict], directions: tuple[str, ...]) -> bool:
+    for src_idx, ray in enumerate(rays):
+        hit = ray["hit"]
+        if hit is None:
+            continue
+        if directions[hit] == OPPOSITE[directions[src_idx]]:
