+
+
+def _object_cells(center: tuple[int, int], direction: str) -> list[tuple[int, int]]:
+    r, c = center
+    gap_r, gap_c = GAP_REL[direction]
+    cells = []
+    for dr in range(-1, 2):
+        for dc in range(-1, 2):
+            rr = r + dr
+            cc = c + dc
+            if (dr + 1, dc + 1) == (gap_r, gap_c):
