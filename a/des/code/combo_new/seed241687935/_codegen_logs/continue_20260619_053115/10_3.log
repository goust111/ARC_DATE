+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    objects, rays, incoming = _analyze_scene(g)
+    out = g.copy()
+
+    for obj, ray in zip(objects, rays):
+        path = ray["path"]
+        if not path:
+            continue
+        arr = np.array(path, dtype=int)
+        out[arr[:, 0], arr[:, 1]] = int(obj["color"])
