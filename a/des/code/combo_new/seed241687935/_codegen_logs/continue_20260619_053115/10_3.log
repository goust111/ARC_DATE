+            grid[r, c] = int(color)
+    return grid
+
+
+def _ray_paths_overlap(rays: list[dict]) -> bool:
+    seen = set()
+    for ray in rays:
+        for cell in ray["path"]:
+            if cell in seen:
+                return True
+            seen.add(cell)
+    return False
+
