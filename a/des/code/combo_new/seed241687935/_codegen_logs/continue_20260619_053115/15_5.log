+            colors = list(pair)
+            if rng.random() < 0.5:
+                horiz, vert = colors[0], colors[1]
+            else:
+                horiz, vert = colors[1], colors[0]
+            _paint_rectangle(grid, r0, c0, height, width, horiz, vert)
+            occupied[rr0:rr1, cc0:cc1] = True
+            placed = True
+            break
+        if not placed:
+            return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_RETRIES):
