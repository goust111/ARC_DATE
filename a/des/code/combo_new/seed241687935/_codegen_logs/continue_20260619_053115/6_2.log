+            placements = _all_placements(h, w, shape, forbidden)
+            if not placements:
+                return None
+            _top, _left, cells = random.choice(placements)
+            forbidden |= _buffer(cells, h, w, pad=1)
+            pieces.append(cells)
+        spec["pieces"] = pieces
+
+    grid = np.zeros((h, w), dtype=int)
