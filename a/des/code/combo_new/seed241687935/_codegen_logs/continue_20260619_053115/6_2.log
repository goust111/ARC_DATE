def norm(cells):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    mr,mc=min(rs),min(cs)
    return {(r-mr,c-mc) for r,c in cells}

def rot(cells):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    h=max(rs)+1; w=max(cs)+1
    return norm({(c,h-1-r) for r,c in cells})

def rots(c):
    ans=[]; cur=norm(c)
    for _ in range(4):
        ans.append(cur)
        cur=rot(cur)
    return ans

def sols(fixed, other):
    res=[]
    for dims,off in [((2,3),(0,1)),((3,2),(1,0))]:
        H,W=dims
