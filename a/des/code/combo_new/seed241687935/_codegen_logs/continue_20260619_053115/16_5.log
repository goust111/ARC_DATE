+
+        full_bg_rows = np.all(box == bg, axis=1)
+        full_bg_cols = np.all(box == bg, axis=0)
+        row_runs = _count_runs(np.any(box == color, axis=1))
+        col_runs = _count_runs(np.any(box == color, axis=0))
