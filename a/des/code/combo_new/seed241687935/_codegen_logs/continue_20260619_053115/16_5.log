+
+    horizontal_n = sum(spec["cut_axis"] == "horizontal" for spec in specs)
+    vertical_n = len(specs) - horizontal_n
+    if len(specs) >= 2 and (horizontal_n == 0 or vertical_n == 0):
+        return None
