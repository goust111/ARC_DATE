FIXED_WIDTH_CELLS = 7
NON_GROUP_ROWS = 4
GROUP_COUNTS = (3, 5)
GROUP_HEIGHT_BOUNDS = (1, 2)
GAP_BOUNDS = (1, 2)
FIRST_ACTIVE_ROW = 2

