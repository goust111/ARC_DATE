+    add([(0, w // 2)])
+    add([(h - 1, w // 2)])
+    add([(h // 2, 0)])
+    add([(h // 2, w - 1)])
+    add([(0, 0), (h - 1, w - 1)])
+    add([(0, w - 1), (h - 1, 0)])
+    add([(0, w // 2), (h - 1, w // 2)])
+    add([(h // 2, 0), (h // 2, w - 1)])
+    add([(0, 0), (0, w - 1), (h - 1, 0)])
+    add([(0, 0), (0, w - 1), (h - 1, w - 1)])
+    add([(0, 0), (h - 1, 0), (h - 1, w - 1)])
+    add([(0, w - 1), (h - 1, 0), (h - 1, w - 1)])
+    add([(0, 0), (1, min(1, w - 1)), (min(2, h - 1), min(2, w - 1))])
