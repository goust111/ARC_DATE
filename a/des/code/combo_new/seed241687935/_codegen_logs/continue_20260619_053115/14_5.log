+
+def _place_hit_pair(
+    shooter_spec: dict,
+    target_spec: dict,
+    objects: list[dict],
+    analysis: dict | None,
+    height: int,
+    width: int,
+    rng: random.Random,
+) -> tuple[list[dict], dict] | None:
+    reserved_paths = set() if analysis is None else set(analysis["reserved_paths"])
+    occupied = _occupied_cells(objects)
+    dr, dc = DIRS[shooter_spec["open_side"]]
+    if shooter_spec["area"] < 2:
+        return None
