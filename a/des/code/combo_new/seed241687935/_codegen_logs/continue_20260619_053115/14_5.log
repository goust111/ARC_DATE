+        trial = _analyze_placed(trial_objects, height, width)
+        if trial is None:
+            continue
+
+        idx = len(objects)
+        ray = trial["rays"][idx]
+        if ray["outcome"] != desired:
+            continue
+        if any(cell in reserved_paths for cell in ray["path"]):
