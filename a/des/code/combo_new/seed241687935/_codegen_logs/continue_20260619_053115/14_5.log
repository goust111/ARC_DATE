+    outcomes = Counter(ray["outcome"] for ray in analysis["rays"])
+    if outcomes["hit"] < 1 or outcomes["boundary"] < 1 or outcomes["clear"] < 1:
+        return None
+
+    grid = _build_grid(height, width, bg, objects)
+    parsed = _analyze_grid(grid)
