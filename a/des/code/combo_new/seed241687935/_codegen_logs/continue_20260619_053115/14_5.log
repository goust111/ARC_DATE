+        r = rng.randint(0, max_r)
+        max_c2 = max(0, width - spec["width"] - spec["area"] - 1)
+        c = rng.randint(0, min(max_c, max_c2))
+        return r, c
+
+    return rng.randint(0, max_r), rng.randint(0, max_c)
