+        if spec["open_side"] == "down":
+            max_r2 = max(0, height - spec["height"] - spec["area"] - 1)
+            r = rng.randint(0, min(max_r, max_r2))
+            c = rng.randint(0, max_c)
+            return r, c
+        if spec["open_side"] == "left":
+            r = rng.randint(0, max_r)
