+        field_h_max = 30 - strip_h - separation
+        field_w_max = 30
+    else:
+        strip_w = max(info["template"].shape[1] for info in infos) + 2
+        field_h_max = 30
+        field_w_max = 30 - strip_w - separation
+
+    if field_h_max < max(h for h, _ in rects) or field_w_max < max(w for _, w in rects):
+        return None
