+def _random_template(rng: random.Random) -> np.ndarray:
+    for _ in range(100):
+        h = rng.randint(2, 4)
+        w = rng.randint(2, 4)
+        target = rng.randint(max(2, (h * w) // 2), h * w - 1)
+        start = (rng.randrange(h), rng.randrange(w))
