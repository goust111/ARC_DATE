+import random
+from typing import Iterable
+
+import numpy as np
+
+
+AZURE = 8
+GREY = 5
+TEMPLATE_COLORS = (1, 2, 3, 4, 6, 7, 9)
+SIDES = ("top", "bottom", "left", "right")
+SEPARATIONS = (1, 2)
+MAX_RETRIES = 300
