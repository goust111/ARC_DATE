+def _random_object_patch(rng: np.random.Generator, area: int) -> np.ndarray:
+    dims = [(ph, pw) for ph in range(1, 4) for pw in range(1, 4) if ph * pw >= area]
+    ph, pw = dims[int(rng.integers(0, len(dims)))]
