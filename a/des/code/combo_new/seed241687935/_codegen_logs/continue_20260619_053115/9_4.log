+                b0, b1 = second["pos"], second["pos"] + second["bh"] - 1
+            else:
+                a0, a1 = first["pos"], first["pos"] + first["bw"] - 1
+                b0, b1 = second["pos"], second["pos"] + second["bw"] - 1
