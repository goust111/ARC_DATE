+    }
+
+
+def _assign_attach_offsets(blocks, side: str, rng: random.Random):
+    if len(blocks) == 1:
+        span = blocks[0]["bh"] if side in ("left", "right") else blocks[0]["bw"]
+        blocks[0]["attach"] = rng.randrange(span)
