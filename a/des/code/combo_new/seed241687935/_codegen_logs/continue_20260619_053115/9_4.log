+        for spec in items:
+            br0, bc0, br1, bc1 = spec["block"]["bbox"]
+            if direction == (0, 1):
+                dr, dc = 0, inner_c1 - bc1
+            elif direction == (0, -1):
+                dr, dc = 0, inner_c0 - bc0
+            elif direction == (1, 0):
+                dr, dc = inner_r1 - br1, 0
+            else:
+                dr, dc = inner_r0 - br0, 0
+            for r, c in spec["block"]["coords"]:
+                out[r + dr, c + dc] = spec["block"]["color"]
+
+    return out
+
+
+def _rects_overlap(a, b) -> bool:
+    ar0, ac0, ar1, ac1 = a
