+        seed = _tail_seed(comp["bbox"], direction)
+        block_idx = coord_to_comp.get(seed)
+        if block_idx is None or block_idx in seen_blocks or block_idx == frame_index:
+            continue
+        block = comps[block_idx]
+        if _arrow_direction(block) is not None:
