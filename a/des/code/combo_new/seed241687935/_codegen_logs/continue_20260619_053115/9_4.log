+    return True
+
+
+def _block_and_arrow_cells(spec, frame_bbox):
+    fr0, fc0, fr1, fc1 = frame_bbox
+    side = spec["side"]
+    pos = spec["pos"]
+    bh = spec["bh"]
+    bw = spec["bw"]
+    dist = spec["dist"]
