+        pos = rng.randint(0, ih - bh)
+    else:
+        pos = rng.randint(0, iw - bw)
+    dist = rng.randint(dist_lo, dist_hi)
+    return {
+        "side": side,
+        "pos": pos,
+        "bh": bh,
+        "bw": bw,
+        "dist": dist,
+        "out_rect": _relative_output_rect(side, pos, bh, bw, ih, iw),
+    }
+
+
+def _assign_attach_offsets(blocks, side: str, rng: random.Random):
+    if len(blocks) == 1:
