+    out = g.copy()
+
+    try:
+        frame, pushers = _extract_scene(g)
+    except ValueError:
+        return out
+
+    if not pushers:
+        return out
+
+    fr0, fc0, fr1, fc1 = frame["bbox"]
+    inner_r0, inner_c0 = fr0 + 1, fc0 + 1
+    inner_r1, inner_c1 = fr1 - 1, fc1 - 1
+
