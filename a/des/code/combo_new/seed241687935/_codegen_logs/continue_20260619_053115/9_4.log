+    return True
+
+
+def _make_counts(active_sides, want_stack: bool, rng: random.Random):
+    counts = {side: 1 for side in active_sides}
+    stack_side = rng.choice(active_sides) if want_stack else None
+    if stack_side is not None:
+        counts[stack_side] = 2
+    extra = [side for side in active_sides if side != stack_side and rng.random() < 0.35]
+    for side in extra:
+        counts[side] = 2
+    while sum(counts.values()) > len(BLOCK_COLORS):
+        shrinkable = [side for side, count in counts.items() if count == 2 and side != stack_side]
+        if not shrinkable:
+            break
+        counts[rng.choice(shrinkable)] = 1
+    return counts, stack_side
+
+
+def _gen_attempt(rng: random.Random):
+    ih = rng.randint(7, 10)
+    iw = rng.randint(7, 10)
+    frame_h = ih + 2
+    frame_w = iw + 2
+
+    active_count = rng.randint(2, 4)
+    active_sides = rng.sample(["left", "right", "top", "bottom"], active_count)
+    want_stack = rng.random() < 0.5
+    counts, stack_side = _make_counts(active_sides, want_stack, rng)
+
