+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+ARROW = 2
+FRAME = 5
+BLOCK_COLORS = (1, 3, 4, 6, 7, 8, 9)
+DIRS = {
+    "left": (0, 1),
+    "right": (0, -1),
+    "top": (1, 0),
+    "bottom": (-1, 0),
+}
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox(coords):
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components(grid: np.ndarray, bg: int):
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "coord_set": set(coords),
+                    "bbox": _bbox(coords),
+                }
+            )
+    return comps
+
+
+def _is_frame_component(comp) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    expected = set()
+    for c in range(c0, c1 + 1):
+        expected.add((r0, c))
+        expected.add((r1, c))
+    for r in range(r0 + 1, r1):
+        expected.add((r, c0))
+        expected.add((r, c1))
+    return comp["coord_set"] == expected
+
+
+def _arrow_direction(comp):
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    pts = {(r - r0, c - c0) for r, c in comp["coords"]}
+
+    if h == 3 and w >= 3:
+        if not all((1, cc) in pts for cc in range(w)):
+            return None
+        top = [cc for rr, cc in pts if rr == 0]
+        bottom = [cc for rr, cc in pts if rr == 2]
+        if len(top) != 1 or len(bottom) != 1 or top[0] != bottom[0]:
+            return None
+        if top[0] == 1:
+            return (0, -1)
+        if top[0] == w - 2:
+            return (0, 1)
+
+    if w == 3 and h >= 3:
+        if not all((rr, 1) in pts for rr in range(h)):
+            return None
+        left = [rr for rr, cc in pts if cc == 0]
+        right = [rr for rr, cc in pts if cc == 2]
+        if len(left) != 1 or len(right) != 1 or left[0] != right[0]:
+            return None
+        if left[0] == 1:
+            return (-1, 0)
+        if left[0] == h - 2:
+            return (1, 0)
+
+    return None
+
+
+def _tail_seed(arrow_bbox, direction):
+    r0, c0, r1, c1 = arrow_bbox
+    mid_r = (r0 + r1) // 2
+    mid_c = (c0 + c1) // 2
+    if direction == (0, 1):
+        return mid_r, c0 - 1
+    if direction == (0, -1):
+        return mid_r, c1 + 1
+    if direction == (1, 0):
+        return r0 - 1, mid_c
+    return r1 + 1, mid_c
+
+
+def _distance_from_frame(block_bbox, frame_bbox, direction):
+    br0, bc0, br1, bc1 = block_bbox
+    fr0, fc0, fr1, fc1 = frame_bbox
+    if direction == (0, 1):
+        return fc0 - bc1 - 1
+    if direction == (0, -1):
+        return bc0 - fc1 - 1
+    if direction == (1, 0):
+        return fr0 - br1 - 1
+    return br0 - fr1 - 1
+
+
+def _extract_scene(grid: np.ndarray):
+    g = np.asarray(grid, dtype=int)
+    bg = int(Counter(map(int, g.flat)).most_common(1)[0][0])
+    comps = _components(g, bg)
+
+    frame = None
+    frame_index = None
+    for idx, comp in enumerate(comps):
+        if _is_frame_component(comp):
+            if frame is None or len(comp["coords"]) > len(frame["coords"]):
+                frame = comp
+                frame_index = idx
+    if frame is None:
+        raise ValueError("frame not found")
+
+    coord_to_comp = {}
+    for idx, comp in enumerate(comps):
+        for cell in comp["coords"]:
+            coord_to_comp[cell] = idx
+
+    pushers = []
+    seen_blocks = set()
+    for idx, comp in enumerate(comps):
+        if idx == frame_index:
+            continue
+        direction = _arrow_direction(comp)
+        if direction is None:
+            continue
+        seed = _tail_seed(comp["bbox"], direction)
+        block_idx = coord_to_comp.get(seed)
+        if block_idx is None or block_idx in seen_blocks or block_idx == frame_index:
+            continue
+        block = comps[block_idx]
+        if _arrow_direction(block) is not None:
+            continue
