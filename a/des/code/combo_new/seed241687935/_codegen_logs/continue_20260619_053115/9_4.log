+        shrinkable = [side for side, count in counts.items() if count == 2 and side != stack_side]
+        if not shrinkable:
+            break
+        counts[rng.choice(shrinkable)] = 1
+    return counts, stack_side
+
+
+def _gen_attempt(rng: random.Random):
+    ih = rng.randint(7, 10)
+    iw = rng.randint(7, 10)
+    frame_h = ih + 2
+    frame_w = iw + 2
