+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            touches_boundary = False
+            while stack:
+                rr, cc = stack.pop()
+                if rr == 0 or rr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_boundary = True
+                for dr, dc in _DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and bool(bg[nr, nc]) and not bool(seen[nr, nc]):
