+
+    min_height = sum(spec["mask"].shape[0] for spec in specs) + len(specs) + 2
+    if min_height > 30:
+        return None
+    height = random.randint(max(14, min_height), min(30, max(18, min_height + 5)))
+
+    max_width = max(spec["mask"].shape[1] for spec in specs)
