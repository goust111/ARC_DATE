+
+    max_width = max(spec["mask"].shape[1] for spec in specs)
+    width = random.randint(max(12, max_width + 4), min(30, max(18, max_width + 10)))
+
+    survivors = [i for i, spec in enumerate(specs) if spec["branch"] != 2]
