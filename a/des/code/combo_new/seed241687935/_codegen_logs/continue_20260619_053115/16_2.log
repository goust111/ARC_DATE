+def _trace_arm(
+    adj: dict[tuple[int, int], list[tuple[int, int]]],
+    corner: tuple[int, int],
+    start: tuple[int, int],
+) -> int | None:
+    prev = corner
+    cur = start
+    length = 1
+    while True:
+        nxt = [p for p in adj[cur] if p != prev]
+        if not nxt:
+            return length
+        if len(nxt) != 1:
+            return None
+        prev, cur = cur, nxt[0]
+        length += 1
