+def _crop_to_fg(grid: np.ndarray, bg: int) -> np.ndarray:
+    coords = np.argwhere(grid != bg)
+    if coords.size == 0:
+        return grid.copy()
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return grid[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].copy()
