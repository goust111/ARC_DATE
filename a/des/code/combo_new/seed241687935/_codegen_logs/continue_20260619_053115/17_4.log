+            rect[cell] = int(random.choice(allowed))
+            reserved.add(cell)
+            filler_budget -= 1
+        elif extras and random.random() < 0.35:
+            rect[cell] = int(random.choice(extras))
+            reserved.add(cell)
+            filler_budget -= 1
+
