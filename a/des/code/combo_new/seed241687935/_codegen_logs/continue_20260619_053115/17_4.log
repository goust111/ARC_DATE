+    rect = np.full((rect_h, rect_w), RECT, dtype=int)
+
+    pair_colors = random.sample(PALETTE, pair_count)
+    extracted_colors = random.sample(PALETTE, pair_count)
+    intersections = list(zip(row_targets, col_targets))
