+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            parts.append(comp)
+    return parts
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _parse_arrow(coords: list[tuple[int, int]]) -> tuple[str, int, str] | None:
+    if len(coords) != 5:
+        return None
+    r0, c0, r1, c1 = _bbox(coords)
+    if r1 - r0 != 2 or c1 - c0 != 2:
+        return None
+    norm = frozenset((r - r0, c - c0) for r, c in coords)
+    for direction, pattern in ARROW_PATTERNS.items():
+        if norm != pattern:
+            continue
+        if direction in ("up", "down"):
+            return "col", c0 + 1, direction
+        return "row", r0 + 1, direction
+    return None
+
