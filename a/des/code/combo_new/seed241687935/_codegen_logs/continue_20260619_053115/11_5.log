+    """Normalize component cells to its bbox top-left and return a hashable signature."""
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))
