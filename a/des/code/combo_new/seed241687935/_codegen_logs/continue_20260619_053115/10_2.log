                    "color": obj["color"],
                    "area": obj["area"],
                    "coords": abs_coords,
                    "bbox": (top, left, top + h - 1, left + w - 1),
                }
            )
            break
        else:
            return None

    placed.sort(key=lambda item: item["bbox"][1])
    x_order_areas = [item["area"] for item in placed]
    if x_order_areas == sorted(x_order_areas):
        return None
    row_starts = {item["bbox"][0] for item in placed}
    if len(row_starts) == 1:
        return None
    return placed


