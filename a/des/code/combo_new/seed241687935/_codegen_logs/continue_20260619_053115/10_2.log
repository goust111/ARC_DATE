+        shelves.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "inner_left": c0 + 1,
+                "inner_right": c1 - 1,
+                "inner_top": r0,
+                "inner_bottom": r1 - 1,
+                "inner_w": c1 - c0 - 1,
+                "inner_h": r1 - r0,
+            }
+        )
