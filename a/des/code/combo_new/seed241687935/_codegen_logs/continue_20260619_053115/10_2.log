+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MAROON = 9
+CLUSTER_COLORS = (1, 2, 3, 4, 6, 7, 8)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+RNG = np.random.default_rng()
+MAX_GENERATION_ATTEMPTS = 400
