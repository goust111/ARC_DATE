+    expected = _build_expected(grid.shape, separator_row, placed_clusters, shelves)
+    actual = main(grid)
+    if not np.array_equal(actual, expected):
+        return None
+
+    if np.array_equal(actual, grid):
+        return None
+    return grid
+
