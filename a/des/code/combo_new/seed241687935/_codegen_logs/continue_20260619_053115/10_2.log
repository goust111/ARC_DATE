+def _find_shelves(grid: np.ndarray, separator_row: int) -> list[dict]:
+    lower = grid[separator_row + 1 :, :]
+    components = _monochrome_components(lower, lower == GREY, row_offset=separator_row + 1)
+    shelves: list[dict] = []
