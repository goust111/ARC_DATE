+    shelves: list[dict] = []
+    bottom = shelf_top + inner_h
+
+    for left in shelf_lefts:
+        right = left + outer_w - 1
+        grid[bottom, left : right + 1] = GREY
+        grid[shelf_top : bottom + 1, left] = GREY
+        grid[shelf_top : bottom + 1, right] = GREY
+        shelves.append(
