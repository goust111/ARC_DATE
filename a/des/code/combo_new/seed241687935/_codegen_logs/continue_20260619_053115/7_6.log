+
+
+def _build_span_points(
+    x0: int,
+    x1: int,
+    r0: int,
+    r1: int,
+    blocked_cols: set[int],
+    valid_rows: list[int],
+    rng: random.Random,
+) -> list[tuple[int, int]]:
+    assert x1 > x0
+    turn_candidates = [c for c in range(x0 + 1, x1) if c not in blocked_cols]
+
