+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) in pt_set:
+                neighbors.append((nr, nc))
+        nbrs[(r, c)] = neighbors
+
+    ends = [p for p, xs in nbrs.items() if len(xs) == 1]
