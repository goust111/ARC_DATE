+    if not _validate_simple_path(coords, height, width):
+        return None
+
+    grid = np.full((height, width), BG, dtype=int)
+    grid[sep_r, :] = GREY
+    for c in top_cols:
+        grid[: sep_r + 1, c] = GREY
+    for c in bottom_cols:
+        grid[sep_r:, c] = GREY
