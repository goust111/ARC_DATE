+    non_bg = row_vals[row_vals != bg]
+    assert non_bg.size > 0, "separator row must contain non-background pixels"
+    grey = int(np.bincount(non_bg, minlength=10).argmax())
+
+    def find_half_boundaries(row0: int, row1: int) -> list[int]:
