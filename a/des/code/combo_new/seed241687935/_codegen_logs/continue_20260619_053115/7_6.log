+            c0, c1 = top_intervals[idx]
+            area = out[:sep_r, c0 : c1 + 1]
+        else:
+            c0, c1 = bottom_intervals[idx]
+            area = out[sep_r + 1 :, c0 : c1 + 1]
+        area[area == BG] = color
+    return out
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
