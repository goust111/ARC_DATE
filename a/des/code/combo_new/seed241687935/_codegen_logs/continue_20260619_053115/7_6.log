+
+    left_ends = [p for p in ends if p[1] == 0]
+    right_ends = [p for p in ends if p[1] == w - 1]
+    assert len(left_ends) == 1 and len(right_ends) == 1, "path must start/end on left/right edges"
+
+    start = left_ends[0]
+    out = [start]
