+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BACKGROUND = 0
+FRAME_COLOR = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_RETRIES = 400
+SPRITE_RETRIES = 120
+
+
+def _mode_color(arr: np.ndarray) -> int:
+    vals, counts = np.unique(arr, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int) -> Iterable[tuple[int, int]]:
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _frame_bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int] | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    if r1 - r0 + 1 < 3 or c1 - c0 + 1 < 3:
+        return None
+    border = set()
+    for c in range(c0, c1 + 1):
+        border.add((r0, c))
+        border.add((r1, c))
+    for r in range(r0 + 1, r1):
+        border.add((r, c0))
+        border.add((r, c1))
+    if set(coords) != border:
+        return None
+    return r0, c0, r1, c1
+
+
+def _find_frame_color_and_boxes(grid: np.ndarray, bg: int) -> tuple[int, list[tuple[int, int, int, int]]]:
+    candidates: list[tuple[int, list[tuple[int, int, int, int]]]] = []
+    for color0 in np.unique(grid):
+        color = int(color0)
+        if color == bg:
+            continue
+        comps = _components(grid == color)
+        if not comps:
+            continue
+        boxes: list[tuple[int, int, int, int]] = []
+        ok = True
+        for comp in comps:
+            box = _frame_bbox(comp)
+            if box is None:
+                ok = False
+                break
+            boxes.append(box)
+        if ok:
+            candidates.append((color, sorted(boxes)))
+    assert len(candidates) == 1, "expected exactly one color used only for rectangular frames"
+    return candidates[0]
+
+
+def _mask_from_component(coords: list[tuple[int, int]]) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
+    return mask
+
+
+def _scale_mask(mask: np.ndarray, sy: int, sx: int) -> np.ndarray:
+    return np.repeat(np.repeat(mask, sy, axis=0), sx, axis=1)
+
