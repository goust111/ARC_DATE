+        return mask
+    raise RuntimeError("failed to build a nontrivial connected sprite")
+
+
+def _choose_scales(rng: random.Random, upper: int) -> tuple[int, int]:
+    if upper <= 1:
+        return 1, 1
+    if rng.random() < 0.5:
+        s = rng.randint(1, upper)
+        return s, s
+    sy = rng.randint(1, upper)
+    sx = rng.randint(1, upper)
