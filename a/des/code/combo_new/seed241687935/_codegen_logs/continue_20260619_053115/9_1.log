+    frame_zone_h, frame_zone_w, frame_positions = _layout_items(rng, frame_sizes, frame_rows, frame_cols)
+
+    indices = list(range(region_count))
+    rng.shuffle(indices)
+    if layout_mode == "right":
+        right_ids = indices
+        bottom_ids: list[int] = []
+    elif layout_mode == "bottom":
+        right_ids = []
+        bottom_ids = indices
+    else:
