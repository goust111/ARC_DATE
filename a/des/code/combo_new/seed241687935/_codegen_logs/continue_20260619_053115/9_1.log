+        expected[fr + 1 : fr + fh - 1, fc + 1 : fc + fw - 1][scaled] = color
+
+    for idx in right_ids:
+        sr, sc = right_positions_local[idx]
+        origin_r = right_origin[0] + sr
+        origin_c = right_origin[1] + sc
