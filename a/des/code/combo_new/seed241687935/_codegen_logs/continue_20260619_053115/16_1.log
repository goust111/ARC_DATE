+def _frame_patch(hole_count: int, orient: str, frame_color: int, bg: int) -> np.ndarray:
+    assert hole_count >= 1
+    if orient == "vertical":
+        inner_h = random.randint(2, 6)
+        inner_w = 2 * hole_count - 1 + random.randint(0, 3)
