+        r0, c0, r1, c1 = _bbox(comp)
+        er0 = max(0, r0 - 1)
+        ec0 = max(0, c0 - 1)
+        er1 = min(h - 1, r1 + 1)
+        ec1 = min(sep_col - 1, c1 + 1)
+        for r in range(er0, er1 + 1):
+            for c in range(ec0, ec1 + 1):
+                inside_bbox = r0 <= r <= r1 and c0 <= c <= c1
