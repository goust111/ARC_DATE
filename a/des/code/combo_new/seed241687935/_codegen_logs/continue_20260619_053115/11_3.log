   6: def main(grid: np.ndarray) -> np.ndarray:
   7:     """Normalize the framed input motif into a 5x5 icon and stamp two copies on a 15x15 canvas.
   8: 
   9:     Input structure
  10:     The input is a rounded rectangular frame: the four corners are the background
  11:     color, and every other outer-border pixel has one frame color. Non-background
  12:     pixels inside that frame are the motif to preserve.
  13: 
  14:     Rule
  15:     Make a 5x5 version of the rounded frame with a 3x3 interior. Crop the input
  16:     interior motif to its bounding box, center that crop in the 3x3 interior, and
  17:     paste the resulting 5x5 icon at upper-left positions (2, 2) and (8, 8) in a
  18:     15x15 background canvas.
  19: 
  20:     Key insight
  21:     The variable-size frame is only a carrier; the meaningful object is the
  22:     compact interior motif, which is normalized to the fixed 3x3 icon interior.
  23:     """
  24:     g = np.asarray(grid, dtype=int)
  25:     h, w = g.shape
  26:     assert h >= 3 and w >= 3
  27: 
  28:     corners = (g[0, 0], g[0, w - 1], g[h - 1, 0], g[h - 1, w - 1])
  29:     assert len(set(map(int, corners))) == 1
  30:     bg = int(corners[0])
  31: 
  32:     border = np.concatenate((g[0, :], g[h - 1, :], g[:, 0], g[:, w - 1]))
  33:     frame_colors = set(map(int, border)) - {bg}
  34:     assert len(frame_colors) == 1
  35:     (frame_color,) = tuple(frame_colors)
  36: 
  37:     assert np.all(g[0, 1 : w - 1] == frame_color)
  38:     assert np.all(g[h - 1, 1 : w - 1] == frame_color)
  39:     assert np.all(g[1 : h - 1, 0] == frame_color)
  40:     assert np.all(g[1 : h - 1, w - 1] == frame_color)
  41: 
  42:     icon = np.full((5, 5), bg, dtype=int)
  43:     icon[0, 1:4] = frame_color
  44:     icon[4, 1:4] = frame_color
  45:     icon[1:4, 0] = frame_color
  46:     icon[1:4, 4] = frame_color
  47: 
  48:     interior = g[1 : h - 1, 1 : w - 1]
  49:     motif_box = bbox(interior != bg)
  50:     assert motif_box is not None
  51:     r0, c0, r1, c1 = motif_box
  52:     motif = interior[r0 : r1 + 1, c0 : c1 + 1]
  53:     mh, mw = motif.shape
  54:     assert mh <= 3 and mw <= 3
  55: 
  56:     icon_r = 1 + (3 - mh) // 2
  57:     icon_c = 1 + (3 - mw) // 2
  58:     icon[icon_r : icon_r + mh, icon_c : icon_c + mw] = motif
  59: 
  60:     out = np.full((15, 15), bg, dtype=int)
  61:     out[2:7, 2:7] = icon
  62:     out[8:13, 8:13] = icon
  63:     return out
