   9: def main(grid: np.ndarray) -> np.ndarray:
  10:     """Expand the top-left seed mask into a recursive colored pattern and tile it across the full grid.
  11: 
  12:     Input structure
  13:     - The background is the dominant color.
  14:     - All foreground lies in a top-left rectangle whose last row and last column are a solid secondary color.
  15:     - Removing that secondary-color row and column leaves a seed region containing background plus one primary color.
  16: 
  17:     Rule
  18:     - Use the primary-color pixels in the seed as a binary mask.
  19:     - Replace each primary seed cell with a copy of the seed mask in the primary color, and each background seed cell
  20:       with a copy of the seed mask in the secondary color.
  21:     - Repeat and crop that expanded tile to the original grid shape.
  22: 
  23:     Key insight
  24:     The solid L-shaped secondary-color border is a legend, not output content; it supplies the color used when the
  25:     seed's background cells are expanded.
  26:     """
  27:     g = np.asarray(grid, dtype=int)
  28:     bg = int(get_bg(g))
  29: 
  30:     fg_bbox = bbox(g != bg)
  31:     assert fg_bbox is not None, "expected a top-left foreground legend"
  32:     r0, c0, r1, c1 = fg_bbox
  33:     assert r0 == 0 and c0 == 0, "foreground legend must be anchored at the top-left corner"
  34: 
  35:     legend_box = g[: r1 + 1, : c1 + 1]
  36:     seed_h = legend_box.shape[0] - 1
  37:     seed_w = legend_box.shape[1] - 1
  38:     assert seed_h >= 1 and seed_w >= 1, "legend must contain a non-empty seed plus border"
  39: 
  40:     secondary_border = np.concatenate((legend_box[:seed_h, seed_w], legend_box[seed_h, :]))
  41:     secondary_colors = np.unique(secondary_border)
  42:     assert secondary_colors.size == 1, "expected one solid secondary-color border"
  43:     secondary = int(secondary_colors[0])
  44:     assert secondary != bg, "secondary border must be foreground"
  45: 
  46:     seed = legend_box[:seed_h, :seed_w]
  47:     primary_colors = np.unique(seed[seed != bg])
  48:     assert primary_colors.size == 1, "seed must contain exactly one primary foreground color"
  49:     primary = int(primary_colors[0])
  50:     assert primary != secondary, "primary and secondary colors must be distinct"
  51:     assert np.all((seed == bg) | (seed == primary)), "seed may contain only background and primary colors"
  52:     assert np.any(seed == bg), "seed must include background cells that expand to the secondary color"
  53: 
  54:     seed_mask = seed == primary
  55:     H, W = g.shape
  56:     rows = np.arange(H)[:, None]
  57:     cols = np.arange(W)[None, :]
  58: 
  59:     inner_mask = seed_mask[rows % seed_h, cols % seed_w]
  60:     meta_mask = seed_mask[(rows // seed_h) % seed_h, (cols // seed_w) % seed_w]
  61: 
  62:     out = np.full(g.shape, bg, dtype=int)
  63:     out[inner_mask & meta_mask] = primary
  64:     out[inner_mask & ~meta_mask] = secondary
  65:     return out
