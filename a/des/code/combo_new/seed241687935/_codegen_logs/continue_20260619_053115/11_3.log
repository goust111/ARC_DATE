+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _choose_kept_indices(length: int, mode: str) -> list[int]:
+    bands = {
+        "sparse": (0.25, 0.45),
+        "medium": (0.45, 0.65),
+        "dense": (0.65, 0.82),
+    }
+    frac_lo, frac_hi = bands[mode]
