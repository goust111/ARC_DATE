  25: def main(grid: np.ndarray) -> np.ndarray:
  26:     """Assemble the foreground objects by docking equal-colored boundary markers edge-to-edge.
  27: 
  28:     Input structure
  29:     The grid has a dominant background color and several 4-connected multicolor foreground
  30:     objects.  One foreground color is the body color; the less frequent foreground colors are
  31:     boundary connector markers, and each marker color appears once as a free end or twice as a
  32:     matched docking pair.
  33: 
  34:     Rule
  35:     Crop each foreground object to its bounding box and translate the objects so that the two
  36:     occurrences of every paired connector color touch on their exposed boundary sides.  Preserve
  37:     each object's orientation and colors, then return the tight crop around the assembled
  38:     foreground on the original background color.
  39: 
  40:     Key insight
  41:     The colored marker pixels are ports: matching colors specify which objects must touch, and
  42:     the marker's side of its object determines the direction of the translation.
  43:     """
  44:     g = np.asarray(grid, dtype=int)
  45:     bg = get_bg(g)
  46: 
  47:     fg = g[g != bg]
  48:     assert fg.size > 0
  49:     values, counts = np.unique(fg, return_counts=True)
  50:     max_count = int(counts.max())
  51:     body_candidates = [int(v) for v, n in zip(values, counts) if int(n) == max_count]
  52:     assert len(body_candidates) == 1
  53:     body = body_candidates[0]
  54:     marker_colors = {int(v) for v in values if int(v) != body}
  55:     assert marker_colors
  56: 
  57:     components = find_components(g, bg=bg, connectivity=4, monochromatic=False)
  58:     assert len(components) >= 2
  59: 
  60:     sprites: list[np.ndarray] = []
  61:     marker_occurrences: dict[int, list[tuple[int, tuple[int, int], tuple[int, int]]]] = defaultdict(list)
  62:     for idx, comp in enumerate(components):
  63:         sprite = crop_bbox(g, comp["bbox"])
  64:         sprites.append(sprite)
  65:         marker_locs = np.argwhere(np.isin(sprite, list(marker_colors)))
  66:         assert marker_locs.size > 0
  67:         for rr, cc in marker_locs:
  68:             r, c = int(rr), int(cc)
  69:             direction = _connector_dir(sprite, r, c)
  70:             marker_occurrences[int(sprite[r, c])].append((idx, (r, c), direction))
  71: 
  72:     adjacency: list[list[tuple[int, tuple[int, int]]]] = [[] for _ in sprites]
  73:     paired_markers = 0
  74:     for occurrences in marker_occurrences.values():
  75:         assert len(occurrences) in (1, 2)
  76:         if len(occurrences) == 1:
  77:             continue
  78:         (a_idx, a_pos, a_dir), (b_idx, b_pos, b_dir) = occurrences
  79:         assert a_idx != b_idx
  80:         assert b_dir == (-a_dir[0], -a_dir[1])
  81:         delta = (a_pos[0] + a_dir[0] - b_pos[0], a_pos[1] + a_dir[1] - b_pos[1])
  82:         adjacency[a_idx].append((b_idx, delta))
  83:         adjacency[b_idx].append((a_idx, (-delta[0], -delta[1])))
  84:         paired_markers += 1
  85:     assert paired_markers == len(sprites) - 1
  86: 
  87:     placements: dict[int, tuple[int, int]] = {0: (0, 0)}
  88:     queue = deque([0])
  89:     while queue:
  90:         idx = queue.popleft()
  91:         base_r, base_c = placements[idx]
  92:         for nbr, (dr, dc) in adjacency[idx]:
  93:             pos = (base_r + dr, base_c + dc)
  94:             if nbr in placements:
  95:                 assert placements[nbr] == pos
  96:             else:
  97:                 placements[nbr] = pos
  98:                 queue.append(nbr)
  99:     assert len(placements) == len(sprites)
 100: 
 101:     placed_fg: list[tuple[int, int]] = []
 102:     for idx, sprite in enumerate(sprites):
 103:         base_r, base_c = placements[idx]
 104:         for rr, cc in np.argwhere(sprite != bg):
 105:             placed_fg.append((base_r + int(rr), base_c + int(cc)))
 106: 
 107:     r0 = min(r for r, _ in placed_fg)
 108:     c0 = min(c for _, c in placed_fg)
 109:     r1 = max(r for r, _ in placed_fg)
 110:     c1 = max(c for _, c in placed_fg)
 111:     out = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
 112: 
 113:     for idx, sprite in enumerate(sprites):
 114:         base_r, base_c = placements[idx]
 115:         rr, cc = base_r - r0, base_c - c0
 116:         mask = sprite != bg
 117:         target = out[rr : rr + sprite.shape[0], cc : cc + sprite.shape[1]]
 118:         assert target.shape == sprite.shape
 119:         assert not np.any((target != bg) & mask)
 120:         paste(out, sprite, rr, cc, transparent=bg)
 121: 
 122:     return out
 123: 
