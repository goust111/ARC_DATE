 102: def _gen_full_bbox_coords(rng, mh, mw, non_bg_count):
 103:     if mh == 1 and mw == 1:
 104:         return [(0, 0)]
 105: 
 106:     if mh == 1:
 107:         required = [(0, 0), (0, mw - 1)]
 108:     elif mw == 1:
 109:         required = [(0, 0), (mh - 1, 0)]
 110:     elif int(rng.integers(2)) == 0:
 111:         required = [(0, 0), (mh - 1, mw - 1)]
 112:     else:
 113:         required = [(0, mw - 1), (mh - 1, 0)]
 114: 
 115:     coords = list(required)
 116:     pool = [(r, c) for r in range(mh) for c in range(mw) if (r, c) not in coords]
 117:     need = non_bg_count - len(coords)
 118:     if need:
 119:         picked = rng.choice(len(pool), size=need, replace=False)
 120:         coords.extend(pool[int(i)] for i in np.atleast_1d(picked))
 121:     return coords
