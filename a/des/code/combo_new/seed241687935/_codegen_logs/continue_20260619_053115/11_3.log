  75: # --------------- generator (att2) ---------------
  76: 
  77: # Canvas, table, frame, and slot dimensions.
  78: CANVAS_MIN, CANVAS_MAX = 13, 19
  79: TABLE_ROWS_RANGE, TABLE_COLS_RANGE = (2, 3), (2, 3)
  80: ROW_SLOT_SIZE_RANGE, COL_SLOT_SIZE_RANGE = (3, 6), (3, 4)
  81: AXIS_OUTER_OPTIONS = AXIS_PADDING_OPTIONS = AXIS_SEPARATOR_OPTIONS = (1, 2)
  82: 
  83: # Object and palette sampling limits.
  84: N_COLORS, MAX_OBJECT_COLORS = 10, 6
  85: MAX_OBJECT_HEIGHT, MAX_OBJECT_WIDTH = 3, 2
  86: OBJECT_MARGIN, MAX_OBJECT_AREA = 1, 6
  87: 
  88: # Rejection sampling cap.
  89: GEN_RETRY_LIMIT = 300
  90: 
  91: 
  92: def _gen_axis_options(n_slots, slot_min, slot_max):
  93:     options = []
  94: 
  95:     def rec_slots(i, cur):
  96:         if i == n_slots:
  97:             rec_seps(0, [], cur)
  98:             return
  99:         for size in range(slot_min, slot_max + 1):
 100:             rec_slots(i + 1, cur + [size])
 101: 
 102:     def rec_seps(i, cur, slots):
 103:         if i == n_slots - 1:
 104:             for before in AXIS_OUTER_OPTIONS:
 105:                 for after in AXIS_OUTER_OPTIONS:
 106:                     for pad_before in AXIS_PADDING_OPTIONS:
 107:                         for pad_after in AXIS_PADDING_OPTIONS:
 108:                             total = (
 109:                                 before
 110:                                 + after
 111:                                 + pad_before
 112:                                 + pad_after
 113:                                 + sum(slots)
 114:                                 + sum(cur)
 115:                             )
 116:                             if 13 <= total <= 19:
 117:                                 options.append(
 118:                                     (
 119:                                         tuple(slots),
 120:                                         tuple(cur),
 121:                                         before,
 122:                                         after,
 123:                                         pad_before,
 124:                                         pad_after,
 125:                                         total,
 126:                                 )
 127:                             )
 128:             return
 129:         for sep in AXIS_SEPARATOR_OPTIONS:
 130:             rec_seps(i + 1, cur + [sep], slots)
 131: 
 132:     rec_slots(0, [])
 133:     return options
 134: 
