0096: def main(grid: np.ndarray) -> np.ndarray:
0097:     """
0098:     Move the small colored sprite into the hollow frame by stretching its shape to the frame interior.
0099: 
0100:     Input structure:
0101:     - The background is the dominant color.
0102:     - There are exactly two foreground colors: one forms a complete rectangular
0103:       one-pixel-thick frame, and the other forms one 4-connected sprite outside it.
0104:     - The frame interior is initially background.
0105: 
0106:     Rule:
0107:     - Clear the original sprite from its outside location.
0108:     - Map the sprite bbox to the frame interior bbox, sending bbox extremes to
0109:       interior extremes.
0110:     - Draw straight horizontal or vertical segments between mapped positions of
0111:       adjacent sprite pixels, then fill any enclosed background region inside
0112:       those drawn segments.
0113: 
0114:     Key insight:
0115:     The outside sprite is a miniature line/fill diagram for the frame interior,
0116:     not a bitmap to scale by block replication.
0117:     """
0118:     g = np.asarray(grid, dtype=int)
0119:     bg = get_bg(g)
0120:     colors = colors_present(g, exclude={bg})
0121:     assert len(colors) == 2, "expected one frame color and one sprite color"
0122: 
0123:     frame_candidates: list[tuple[int, tuple[int, int, int, int]]] = []
0124:     for color in colors:
0125:         frame_bbox = _rect_frame_bbox(g == int(color))
0126:         if frame_bbox is not None:
0127:             frame_candidates.append((int(color), frame_bbox))
0128:     assert len(frame_candidates) == 1, "expected a unique rectangular frame"
0129: 
0130:     frame_color, (fr0, fc0, fr1, fc1) = frame_candidates[0]
0131:     sprite_color = next(color for color in colors if color != frame_color)
0132:     sprite_components = find_components(g, bg=bg, colors=[sprite_color], connectivity=4)
0133:     assert len(sprite_components) == 1, "expected a single 4-connected sprite"
0134:     frame_region = np.zeros_like(g, dtype=bool)
0135:     frame_region[fr0 : fr1 + 1, fc0 : fc1 + 1] = True
0136:     assert not np.any((g == sprite_color) & frame_region), "sprite must start outside the frame"
0137: 
0138:     sr0, sc0, sr1, sc1 = sprite_components[0]["bbox"]
0139:     sprite = g[sr0 : sr1 + 1, sc0 : sc1 + 1] == sprite_color
0140: 
0141:     ir0, ic0 = fr0 + 1, fc0 + 1
0142:     ir1, ic1 = fr1 - 1, fc1 - 1
0143:     assert ir0 <= ir1 and ic0 <= ic1, "frame must have an interior"
0144:     interior = g[ir0 : ir1 + 1, ic0 : ic1 + 1]
0145:     assert np.all(interior == bg), "frame interior must start empty"
0146: 
0147:     stretched = _stretch_sprite(sprite, (ir1 - ir0 + 1, ic1 - ic0 + 1))
0148:     out = g.copy()
0149:     out[g == sprite_color] = bg
0150:     out[ir0 : ir1 + 1, ic0 : ic1 + 1][stretched] = sprite_color
0151:     return out

