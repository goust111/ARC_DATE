+
+def _build_hole_layout(interior_h: int, interior_w: int, n_holes: int) -> list[dict] | None:
+    shapes = []
+    seen = set()
+    max_h = min(SHAPE_MAX_SIDE, interior_h)
+    max_w = min(SHAPE_MAX_SIDE, interior_w)
+    for _ in range(400):
+        if len(shapes) == n_holes:
