+def _marker_side(marker: tuple[int, int], box: tuple[int, int, int, int]) -> str:
+    r, c = marker
+    r0, c0, r1, c1 = box
+    if c == c0 and r0 <= r <= r1:
+        return "left"
+    if c == c1 and r0 <= r <= r1:
+        return "right"
+    if r == r0 and c0 <= c <= c1:
