+        dc = marker[1] - anchor[1]
+        cut = [(r + dr, c + dc) for r, c in cells]
+        assert all(r0 <= rr <= r1 and c0 <= cc <= c1 for rr, cc in cut), "cut patch must stay inside the texture rectangle"
