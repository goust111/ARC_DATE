+            seed = (h - 2, ac)
+            allowed = lambda r, c: (r, c) == (ar, ac) or r < h - 1
+        elif side == "bottom":
+            ar, ac = 0, rng.randrange(w)
+            seed = (1, ac)
+            allowed = lambda r, c: (r, c) == (ar, ac) or r > 0
