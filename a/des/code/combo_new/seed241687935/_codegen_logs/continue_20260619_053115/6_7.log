+
+        grid = np.zeros((grid_h, grid_w), dtype=int)
+        current_row = top_pad
+        for band_idx, band in enumerate(bands):
+            band_left = random.randint(1, grid_w - band_widths[band_idx] - 1)
+            x = band_left
+            for obj_pos, obj_idx in enumerate(band):
