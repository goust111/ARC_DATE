+    bottom = _mode(grid[h - 1, 1 : w - 1] if w > 2 else grid[h - 1, :])
+    left = _mode(grid[1 : h - 1, 0] if h > 2 else grid[:, 0])
+    right = _mode(grid[1 : h - 1, w - 1] if h > 2 else grid[:, w - 1])
+    return top, bottom, left, right
