+        while stack:
+            r, c = stack.pop()
+            comp.append((r, c))
+            for nr, nc in _neighbors4(r, c):
+                if (nr, nc) in region_set and (nr, nc) not in seen and int(grid[nr, nc]) == color:
+                    seen.add((nr, nc))
+                    stack.append((nr, nc))
