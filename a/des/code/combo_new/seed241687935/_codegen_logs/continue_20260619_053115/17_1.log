+        interior, ring, marker = placement
+        reserved |= _dilate8(interior | ring)
+
+        for r, c in ring:
+            grid[r, c] = FENCE_COLOR
+
+        marker_color = rng.choice(marker_palette)
+        (r1, c1), (r2, c2) = marker
+        grid[r1, c1] = marker_color
+        grid[r2, c2] = marker_color
+
