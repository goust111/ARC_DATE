+def _detect_fence_color(grid: np.ndarray) -> int | None:
+    inner = np.asarray(grid[1:-1, 1:-1], dtype=int)
+    non_bg = inner[inner != BACKGROUND]
+    if non_bg.size == 0:
+        return None
+    return _mode(non_bg)
