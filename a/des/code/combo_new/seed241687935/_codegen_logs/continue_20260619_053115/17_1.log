+    grid[-1, :] = bottom
+    grid[1:-1, 0] = left
+    grid[1:-1, -1] = right
+    grid[0, 0] = top
+    grid[0, -1] = top
+    grid[-1, 0] = bottom
+    grid[-1, -1] = bottom
+
