+    if rng.random() < 0.5:
+        out = {(c, r) for r, c in out}
+    if rng.random() < 0.5:
+        max_r = max(r for r, _ in out)
+        out = {(max_r - r, c) for r, c in out}
+    if rng.random() < 0.5:
+        max_c = max(c for _, c in out)
+        out = {(r, max_c - c) for r, c in out}
+    return _normalize(out)
