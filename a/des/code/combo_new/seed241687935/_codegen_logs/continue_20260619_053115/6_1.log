+    return [(r0 + start + k, c1) for k in range(length)]
+
+
+def _placement_options(
+    h: int,
+    w: int,
+    oh: int,
+    ow: int,
+    side: str,
+    motif_rel: list[tuple[int, int]],
+    reserved_out: set[tuple[int, int]],
+    reserved_frame_pad: set[tuple[int, int]],
+) -> list[dict]:
+    options: list[dict] = []
