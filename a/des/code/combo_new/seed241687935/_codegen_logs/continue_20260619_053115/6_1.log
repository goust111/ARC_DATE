+    return out
+
+
+def _gap_cells_for_side(r0: int, c0: int, r1: int, c1: int, side: str, start: int, length: int) -> list[tuple[int, int]]:
+    if side == "top":
+        return [(r0, c0 + start + k) for k in range(length)]
+    if side == "bottom":
+        return [(r1, c0 + start + k) for k in range(length)]
+    if side == "left":
