+    return grid
+
+
+def _render_output(h: int, w: int, specs: list[dict]) -> np.ndarray:
+    grid = _render_input(h, w, specs)
+    out = grid.copy()
+    for spec in sorted(specs, key=lambda item: (item["bbox"][0], item["bbox"][1])):
