+def _extract_objects(grid: np.ndarray, bg: int) -> list[dict]:
+    objects: list[dict] = []
+    for color in sorted(set(map(int, grid.flatten())) - {int(bg)}):
+        color_mask = grid == int(color)
+        for pts in _components(color_mask):
