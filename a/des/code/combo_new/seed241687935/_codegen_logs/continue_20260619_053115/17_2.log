+            patch = left[r0 : r1 + 1, c0 : c1 + 1]
+            border = np.zeros_like(patch, dtype=bool)
+            border[0, :] = True
+            border[-1, :] = True
+            border[:, 0] = True
+            border[:, -1] = True
