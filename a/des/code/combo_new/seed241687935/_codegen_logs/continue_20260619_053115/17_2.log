+                for r, c in cells
+                for dr, dc in NEIGHBORS4
+                for nr, nc in [(r + dr, c + dc)]
+                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells
+            }
+        chosen = random.choice(tuple(frontier))
+        frontier.remove(chosen)
+        cells.add(chosen)
