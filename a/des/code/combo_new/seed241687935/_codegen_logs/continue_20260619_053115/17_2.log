+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+SEPARATOR_COLOR = 5
+FOREGROUND_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRIES = 400
+RECT_COUNT_RANGE = (2, 4)
+RECT_H_RANGE = (5, 8)
+RECT_W_RANGE = (5, 8)
