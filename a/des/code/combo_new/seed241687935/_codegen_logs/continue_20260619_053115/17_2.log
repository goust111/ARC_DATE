+def _random_connected_mask(h: int, w: int) -> np.ndarray:
+    area_max = h * w
+    target_area = random.randint(INNER_AREA_MIN, area_max)
+    cells = {(random.randrange(h), random.randrange(w))}
+    frontier = set()
+    while len(cells) < target_area:
