+    return None
+
+
+def _render_layout(height: int, width: int, patches: list[np.ndarray], positions: dict[int, tuple[int, int]]) -> np.ndarray:
+    canvas = np.zeros((height, width), dtype=int)
+    for idx, patch in enumerate(patches):
