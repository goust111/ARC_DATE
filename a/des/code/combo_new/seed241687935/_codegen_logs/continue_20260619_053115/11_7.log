+def _transform_coords(coords: list[tuple[int, int]], mode: str) -> list[tuple[int, int]]:
+    arr = np.array(coords, dtype=int)
+    r0, c0 = arr.min(axis=0)
+    r1, c1 = arr.max(axis=0)
