+            nc2 = cc2 - dr2
+        else:
+            raise ValueError(f"unknown transform mode: {mode}")
+        if (nr2 % 2) or (nc2 % 2):
+            raise ValueError("transform requires an integral bounding-box center placement")
+        out.append((nr2 // 2, nc2 // 2))
