+    rr0 = max(1, r0 - PADDING)
+    cc0 = max(1, c0 - PADDING)
+    rr1 = min(h - 2, r0 + size - 1 + PADDING)
+    cc1 = min(w - 2, c0 + size - 1 + PADDING)
