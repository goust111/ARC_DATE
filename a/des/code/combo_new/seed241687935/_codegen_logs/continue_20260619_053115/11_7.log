+def _find_components_monochrome(grid: np.ndarray, bg: int = BG) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = rr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            r0, c0 = arr.min(axis=0)
+            r1, c1 = arr.max(axis=0)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def _corner_colors(grid: np.ndarray) -> dict[str, int]:
+    return {
+        "TL": int(grid[0, 0]),
+        "TR": int(grid[0, -1]),
+        "BL": int(grid[-1, 0]),
+        "BR": int(grid[-1, -1]),
+    }
+
+
+def _touched_sides(coords: list[tuple[int, int]], h: int, w: int) -> set[str]:
+    sides: set[str] = set()
+    if any(r == 1 for r, _ in coords):
+        sides.add("top")
+    if any(r == h - 2 for r, _ in coords):
+        sides.add("bottom")
+    if any(c == 1 for _, c in coords):
+        sides.add("left")
+    if any(c == w - 2 for _, c in coords):
+        sides.add("right")
+    return sides
+
