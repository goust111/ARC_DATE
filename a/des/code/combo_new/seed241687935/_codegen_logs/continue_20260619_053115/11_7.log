from __future__ import annotations

from collections import Counter, deque
import random

import numpy as np


BG = 0
BORDER = 3
COLOR_POOL = (1, 2, 4, 5, 6, 7, 8, 9)
NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
BRANCH_PATTERNS = (
    (1, 1, 1),
