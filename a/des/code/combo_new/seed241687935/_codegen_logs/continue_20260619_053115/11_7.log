import numpy as np
from collections import deque

def conn(mask):
    cells=np.argwhere(mask)
    if len(cells)==0:return False
    seen={tuple(cells[0])}
    q=deque([tuple(cells[0])])
    while q:
        r,c=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<mask.shape[0] and 0<=nc<mask.shape[1] and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return len(seen)==len(cells)

def anti(mask):
    return np.rot90(mask.T,2)

def canon(mask):
    vars=[]
    for k in range(4):
        m=np.rot90(mask,k)
        vars.append(m)
        vars.append(np.fliplr(m))
    best=min((v.tobytes()+bytes(v.shape),i) for i,v in enumerate(vars))[1]
    return vars[best]

shapes=[]; seen=set()
for n in (2,3):
