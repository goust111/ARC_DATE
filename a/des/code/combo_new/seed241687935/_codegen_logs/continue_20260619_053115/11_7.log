+def _build_shape_library() -> list[np.ndarray]:
+    shapes: list[np.ndarray] = []
+    seen: set[bytes] = set()
+    n = 3
+    for bits in range(1, 1 << (n * n)):
+        flat = np.array([(bits >> i) & 1 for i in range(n * n)], dtype=bool)
