+def _quadrant_from_coords(coords: list[tuple[int, int]], h: int, w: int) -> str:
+    arr = np.array(coords, dtype=float)
+    top = float(arr[:, 0].mean()) < (h / 2.0)
+    left = float(arr[:, 1].mean()) < (w / 2.0)
+    if top and left:
+        return "TL"
+    if top and not left:
+        return "TR"
+    if not top and left:
+        return "BL"
+    return "BR"
+
