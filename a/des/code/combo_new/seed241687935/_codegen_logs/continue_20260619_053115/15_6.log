    fillable, n_bg, _exterior, long_count = fill_info
    out = grid.copy()
    out[fillable] = contour
    inp = out.copy()
    inp[fillable] = bg
    return inp, out, n_bg, long_count


def _gen_attempt() -> np.ndarray | None:
