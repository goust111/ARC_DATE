+        return None
+
+    seed_colors = {int(grid[r, c]) for r, c in seed_coords}
+    if len(seed_colors) != 1:
+        return None
+
+    return {
+        "color": int(color),
+        "r0": int(r0),
+        "c0": int(c0),
+        "r1": int(r1),
+        "c1": int(c1),
+        "direction": direction,
