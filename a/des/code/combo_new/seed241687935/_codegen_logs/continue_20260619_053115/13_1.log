+
+def _project_seed(seed_coords: list[tuple[int, int]], direction: str, frame_box: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = frame_box
+    rows = [r for r, _ in seed_coords]
+    cols = [c for _, c in seed_coords]
+    if direction == "up":
