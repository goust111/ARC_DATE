+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    bg = _get_bg(g)
+
+    for frame in _extract_frames(g):
+        projected = _project_seed(
+            frame["seed_coords"],
+            frame["direction"],
+            (frame["r0"], frame["c0"], frame["r1"], frame["c1"]),
+        )
+        for r, c in projected:
+            if 0 <= r < g.shape[0] and 0 <= c < g.shape[1] and int(g[r, c]) == bg:
+                out[r, c] = frame["color"]
+    return out
