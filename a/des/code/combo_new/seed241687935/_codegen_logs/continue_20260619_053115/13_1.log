+def _rect_with_pad(box: tuple[int, int, int, int], pad: int, height: int, width: int) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = box
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(height - 1, r1 + pad)
