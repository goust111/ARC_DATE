+        mask = _coords_to_mask(coords)
+        if mask.shape[0] < 2 or mask.shape[1] < 2:
+            continue
+        if int(mask.sum()) == mask.shape[0] * mask.shape[1]:
+            continue
+        if _is_asymmetric(mask):
+            return coords
+    raise RuntimeError("failed to create a non-symmetric seed")
