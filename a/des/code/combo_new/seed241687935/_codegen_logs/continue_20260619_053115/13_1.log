+
+def _parse_frame_component(grid: np.ndarray, bg: int, color: int, coords: list[tuple[int, int]]) -> dict | None:
+    coord_set = set(coords)
+    r0, c0, r1, c1 = _bbox(coords)
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
