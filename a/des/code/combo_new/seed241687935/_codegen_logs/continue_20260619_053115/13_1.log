+    axis = []
+    if all(r == r0 for r, c in missing):
+        direction = "up"
+        axis = sorted(c for _, c in missing)
+    elif all(r == r1 for r, c in missing):
+        direction = "down"
+        axis = sorted(c for _, c in missing)
+    elif all(c == c0 for r, c in missing):
+        direction = "left"
+        axis = sorted(r for r, _ in missing)
+    elif all(c == c1 for r, c in missing):
