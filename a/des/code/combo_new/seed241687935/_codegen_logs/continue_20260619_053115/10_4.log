+    neighbors: dict[tuple[int, int], list[tuple[int, int]]] = {}
+    for cell in coords:
+        r, c = cell
+        nbrs = []
+        for dr, dc in DIR8:
+            q = (r + dr, c + dc)
+            if q in coord_set:
+                nbrs.append(q)
+        neighbors[cell] = nbrs
+
