+    for cell in order[1:]:
+        color = int(grid[cell])
+        if color != current_color:
+            segments.append({"color": current_color, "cells": current_cells})
+            current_color = color
+            current_cells = [cell]
+        else:
+            current_cells.append(cell)
+    segments.append({"color": current_color, "cells": current_cells})
