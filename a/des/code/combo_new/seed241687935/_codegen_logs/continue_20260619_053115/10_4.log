+    order = []
+    prev = None
+    cur = start
+    while True:
+        order.append(cur)
+        next_cells = [q for q in neighbors[cur] if q != prev]
+        assert len(next_cells) <= 1, "path must not branch"
+        if not next_cells:
+            break
+        prev, cur = cur, next_cells[0]
