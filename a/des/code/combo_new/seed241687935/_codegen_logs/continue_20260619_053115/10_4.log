+def _is_filled_rectangle(component: dict) -> bool:
+    r0, c0, r1, c1 = component["bbox"]
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    return height >= 2 and width >= 2 and len(component["coords"]) == height * width
