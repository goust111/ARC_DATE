+    frame = np.full((h + 2, w + 2), BG, dtype=int)
+    frame[0, :] = FENCE
+    frame[-1, :] = FENCE
+    frame[:, 0] = FENCE
+    frame[:, -1] = FENCE
+    frame[1:-1, 1:-1] = interior
