+    c0 = max(0, c0 - 1)
+    r1 = min(grid.shape[0] - 1, r1 + 1)
+    c1 = min(grid.shape[1] - 1, c1 + 1)
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _build_case() -> tuple[np.ndarray, np.ndarray] | None:
+    n_fences = random.choice([1, 2, 3])
