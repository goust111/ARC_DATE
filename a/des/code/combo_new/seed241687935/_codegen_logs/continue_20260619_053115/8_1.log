+        if other == "top" and not np.all(sub[0, :]):
+            return None
+        if other == "right" and not np.all(sub[:, -1]):
+            return None
+        if other == "bottom" and not np.all(sub[-1, :]):
+            return None
+        if other == "left" and not np.all(sub[:, 0]):
+            return None
+
+    expected = np.zeros_like(sub, dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    gap = gap_info[side]
