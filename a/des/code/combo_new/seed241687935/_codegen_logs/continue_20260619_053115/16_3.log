+
+
+def _choose_colors() -> tuple[int, int, int, list[int]]:
+    palette = list(_RNG.choice(_COLORS, size=10, replace=False))
+    bg = int(palette[0])
+    border = int(palette[1])
+    marker = int(palette[2])
