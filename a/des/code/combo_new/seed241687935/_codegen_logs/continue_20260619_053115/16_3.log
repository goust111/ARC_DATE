+            and np.all(inner[-1, :] == bg)
+            and np.all(inner[:, 0] == bg)
+            and np.all(inner[:, -1] == bg)
+        ):
+            continue
+        if not np.any(inner[1:-1, 1:-1] != bg):
+            continue
+
+        counts = Counter(int(grid[r, c]) for r, c in comp)
+        if len(counts) != 2:
