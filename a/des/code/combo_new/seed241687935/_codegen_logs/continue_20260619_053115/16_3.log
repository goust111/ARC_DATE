+        on_horizontal_edge = mr in (r0, r1) and c0 < mc < c1
+        on_vertical_edge = mc in (c0, c1) and r0 < mr < r1
+        if on_horizontal_edge == on_vertical_edge:
+            continue
+
+        frames.append(
