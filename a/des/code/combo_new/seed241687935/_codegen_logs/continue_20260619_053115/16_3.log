+        }
+        detected_sig = {
+            (tuple(frame["bbox"]), int(frame["border_color"]), bool(frame["flip_lr"])) for frame in detected
+        }
+        if detected_sig != expected_sig:
+            continue
+        if not np.array_equal(main(grid), expected):
+            continue
+        return grid
+    raise RuntimeError("failed to generate a valid input")

