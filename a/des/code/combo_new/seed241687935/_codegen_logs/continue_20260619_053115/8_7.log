+    elif side == "bottom":
+        c0 = axis - child_w // 2
+        r0 = pr1 + bridge_len + 1
+        bridge = [(rr, axis) for rr in range(pr1 + 1, r0)]
+    elif side == "left":
+        r0 = axis - child_h // 2
