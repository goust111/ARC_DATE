+    placed = _place_groups(groups)
+    if placed is None:
+        return None
+    inp, expected = placed
+
+    if inp.ndim != 2 or expected.ndim != 2:
+        return None
+    if max(inp.shape) > BOARD_LIMIT or max(expected.shape) > BOARD_LIMIT:
+        return None
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
