+
+
+def _right_of(direction: tuple[int, int]) -> tuple[int, int]:
+    return _rotate_dir(direction, 1)
+
+
+def _rotate_cw(arr: np.ndarray, steps_cw: int) -> np.ndarray:
+    return np.rot90(arr, -steps_cw)
