        mask = np.fliplr(mask)
    return mask


def _make_mask(h: int, w: int, area: int) -> np.ndarray:
    """Grow an 8-connected mask from a line seed to the target area."""
    mask = _line_mask(h, w)
    while int(mask.sum()) < area:
        frontier = set()
