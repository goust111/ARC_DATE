+def _components8(mask: np.ndarray) -> list[np.ndarray]:
+    H, W = mask.shape
+    seen = np.zeros((H, W), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(H):
+        for c in range(W):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr in (-1, 0, 1):
