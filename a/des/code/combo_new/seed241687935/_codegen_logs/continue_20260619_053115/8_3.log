    h, w = nr * PANEL_STRIDE - SEPARATOR_WIDTH, nc * PANEL_STRIDE - SEPARATOR_WIDTH
    grid = np.full((h, w), BACKGROUND_COLOR, dtype=int)
    expected = np.full((h, w), BACKGROUND_COLOR, dtype=int)
    for canvas in (grid, expected):
