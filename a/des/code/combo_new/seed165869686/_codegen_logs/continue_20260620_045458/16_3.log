+
+
+def _frame_marker_positions(inner_h: int, inner_w: int, relation: str, rng: random.Random) -> list[tuple[int, int]]:
+    if relation == HORIZONTAL:
+        row = rng.randrange(inner_h)
+        c0, c1 = sorted(rng.sample(range(inner_w), 2))
