+def _texture_kind_from_demo(block: np.ndarray) -> str | None:
+    if block.shape != (3, 3):
+        return None
+    if not np.all((block == BLACK) | (block == GREEN)):
+        return None
+    for texture in (HSTRIPE, VSTRIPE, CHECKER):
