+
+
+def _place_legend(grid: np.ndarray, reserved: np.ndarray, rng: random.Random) -> tuple[int, int, int, int] | None:
+    h, w = grid.shape
+    positions, total_h, total_w = _legend_layout(rng)
+    margin_r = rng.randint(0, 1)
+    margin_c = rng.randint(0, 1)
