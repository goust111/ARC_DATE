+
+def _find_rectangular_frames(grid: np.ndarray) -> list[tuple[int, int, int, int]]:
+    frames: list[tuple[int, int, int, int]] = []
+    for comp in _components(grid == BLUE):
+        rows = [r for r, _ in comp]
+        cols = [c for _, c in comp]
