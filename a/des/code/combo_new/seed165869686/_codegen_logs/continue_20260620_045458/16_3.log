+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+
+HORIZONTAL = "horizontal"
+VERTICAL = "vertical"
+DIAGONAL = "diagonal"
+
+HSTRIPE = "horizontal_stripes"
+VSTRIPE = "vertical_stripes"
+CHECKER = "checkerboard"
