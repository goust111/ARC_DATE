+            comps.append(comp)
+    return comps
+
+
+def _classify_pair(points: list[tuple[int, int]]) -> str | None:
+    if len(points) != 2:
+        return None
+    (r0, c0), (r1, c1) = points
+    if r0 == r1 and c0 != c1:
+        return HORIZONTAL
+    if c0 == c1 and r0 != r1:
+        return VERTICAL
+    if abs(r0 - r1) == abs(c0 - c1) and r0 != r1:
+        return DIAGONAL
+    return None
+
+
+def _texture_grid(texture: str, h: int, w: int) -> np.ndarray:
+    rr, cc = np.indices((h, w))
+    if texture == HSTRIPE:
+        green_mask = (rr % 2) == 0
+    elif texture == VSTRIPE:
+        green_mask = (cc % 2) == 0
+    elif texture == CHECKER:
+        green_mask = ((rr + cc) % 2) == 0
