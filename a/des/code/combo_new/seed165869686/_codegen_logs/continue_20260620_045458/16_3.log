+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+
+HORIZONTAL = "horizontal"
+VERTICAL = "vertical"
+DIAGONAL = "diagonal"
+
+HSTRIPE = "horizontal_stripes"
+VSTRIPE = "vertical_stripes"
+CHECKER = "checkerboard"
+
+REL_TO_TEXTURE = {
+    HORIZONTAL: HSTRIPE,
+    VERTICAL: VSTRIPE,
+    DIAGONAL: CHECKER,
+}
+
+LEGEND_BLOCK_H = 5
+LEGEND_BLOCK_W = 3
+GEN_ATTEMPTS = 400
