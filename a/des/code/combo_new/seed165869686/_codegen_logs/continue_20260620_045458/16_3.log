+        total_h = 3 * LEGEND_BLOCK_H + 2 * gap
+        total_w = LEGEND_BLOCK_W
+    return positions, total_h, total_w
+
+
+def _legend_marker_positions(relation: str, rng: random.Random) -> list[tuple[int, int]]:
+    choices = {
+        HORIZONTAL: [
+            [(0, 0), (0, 1)],
+            [(0, 1), (0, 2)],
+            [(1, 0), (1, 1)],
+            [(1, 1), (1, 2)],
+            [(0, 0), (0, 2)],
