+    legend_mapping = _detect_legend_mapping(g)
+    out = g.copy()
+
+    for r0, c0, r1, c1 in _find_rectangular_frames(g):
+        interior = g[r0 + 1 : r1, c0 + 1 : c1]
+        red_points = [tuple(map(int, p)) for p in np.argwhere(interior == RED)]
