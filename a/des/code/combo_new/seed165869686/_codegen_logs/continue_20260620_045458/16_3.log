+    rr1 = min(h - 1, r1 + pad)
+    cc1 = min(w - 1, c1 + pad)
+    mask[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+
+
+def _legend_layout(rng: random.Random) -> tuple[list[tuple[int, int]], int, int]:
+    layout = rng.choice(("row", "column"))
