from itertools import combinations
from fractions import Fraction
import random, numpy as np

# helpers

def get_bg(g):
    vals, counts = np.unique(g, return_counts=True)
    return int(vals[np.argmax(counts)])

def comps_of_color(g, color):
    H,W=g.shape
    seen=np.zeros((H,W),bool)
    out=[]
    for r in range(H):
        for c in range(W):
            if g[r,c]"'!=color or seen[r,c]:
                continue
            stack=[(r,c)]
            seen[r,c]=True
            coords=[]
            while stack:
                rr,cc=stack.pop()
                coords.append((rr,cc))
                for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<H and 0<=nc<W and not seen[nr,nc] and g[nr,nc]==color:
                        seen[nr,nc]=True
                        stack.append((nr,nc))
            out.append(np.array(coords,dtype=int))
    return out

def main(grid):
    g=np.asarray(grid,dtype=int)
    H,W=g.shape
    bg=get_bg(g)
    out=g.copy()
    for color in [int(x) for x in np.unique(g) if int(x)!=bg]:
        comps=comps_of_color(g,color)
        assert len(comps)==2
        c1,c2=comps
        r1=Fraction(int(c1[:,0].sum()), len(c1)); r2=Fraction(int(c2[:,0].sum()), len(c2))
        x1=Fraction(int(c1[:,1].sum()), len(c1)); x2=Fraction(int(c2[:,1].sum()), len(c2))
        if r1==r2 and x1!=x2:
            axis2=x1+x2
            assert axis2.denominator==1
            axis2=int(axis2)
            for rr,cc in np.vstack([c1,c2]):
                rc=axis2-int(cc)
                assert 0<=rc<W
                if out[int(rr), rc] not in (bg, color):
                    raise AssertionError
                out[int(rr), rc]=color
        elif x1==x2 and r1!=r2:
            axis2=r1+r2
            assert axis2.denominator==1
            axis2=int(axis2)
            for rr,cc in np.vstack([c1,c2]):
                rr2=axis2-int(rr)
                assert 0<=rr2<H
                if out[rr2, int(cc)] not in (bg, color):
                    raise AssertionError
                out[rr2, int(cc)]=color
        else:
            raise AssertionError
    return out

# enumerate masks

def connected(mask):
    coords=[tuple(x) for x in np.argwhere(mask)]
