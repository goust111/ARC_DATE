+    order = sorted(range(len(fragments)), key=lambda idx: len(candidates[idx]))
+    used_holes: set[int] = set()
+    assignment: dict[int, tuple[int, int]] = {}
+
+    def dfs(pos: int) -> bool:
+        if pos == len(order):
+            return True
+        fi = order[pos]
+        for hi, k in candidates[fi]:
+            if hi in used_holes:
+                continue
+            used_holes.add(hi)
+            assignment[fi] = (hi, k)
+            if dfs(pos + 1):
+                return True
+            used_holes.remove(hi)
+            del assignment[fi]
