+import numpy as np
+
+
+BG = 0
+GREY = 5
+MAROON = 9
+PIECE_COLORS = (1, 2, 3, 4, 6, 7, 8)
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+CORNER_ORDER = ("tl", "tr", "br", "bl")
+CORNER_INDEX = {name: idx for idx, name in enumerate(CORNER_ORDER)}
+RNG = np.random.default_rng()
+GEN_RETRIES = 300
