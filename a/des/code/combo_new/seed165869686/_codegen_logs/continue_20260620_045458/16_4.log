+    blocked = board_mask | fragment_mask
+    reachable = _boundary_reachable(~blocked)
+    hole_area_mask = (~blocked) & (~reachable)
+
+    holes = []
+    for coords in _components(hole_area_mask):
+        values = {int(g[r, c]) for r, c in coords}
+        if MAROON not in values:
