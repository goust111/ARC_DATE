+    for (r, c), color in zip(target_cells, fill_values, strict=False):
+        out[r, c] = int(color)
+
+    return inp, out
+
+
+def _make_pair_component() -> tuple[np.ndarray, np.ndarray]:
+    inp, out = _canonical_pair()
+    transform_seed = random.randint(0, 7)
