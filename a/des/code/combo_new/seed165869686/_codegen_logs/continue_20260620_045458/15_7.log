+        if bg in colors:
+            continue
+        kind = "target" if len(colors) == 1 else "source"
+        rectangles.append(
+            {
+                "bbox": bbox,
+                "kind": kind,
+                "colors": colors,
+                "component": int(labels[comp[0][0], comp[0][1]]),
