+    r1 = min(occupied.shape[0], bottom + 1)
+    c1 = min(occupied.shape[1], right + 1)
+    return not occupied[r0:r1, c0:c1].any()
+
+
+def _render_global_scene(pair_count: int) -> tuple[np.ndarray, np.ndarray] | None:
