+from __future__ import annotations
+
+import random
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+BG = 0
+PATH_COLOR = 5
+SOURCE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+MASTER_SIZE = 30
+GENERATION_ATTEMPTS = 400
+PAIR_PLACEMENT_ATTEMPTS = 120
