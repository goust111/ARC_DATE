+def _block_support_mask(non_bg: np.ndarray) -> np.ndarray:
+    h, w = non_bg.shape
+    support = np.zeros((h, w), dtype=bool)
+    for r in range(h - 1):
+        for c in range(w - 1):
+            if non_bg[r : r + 2, c : c + 2].all():
+                support[r : r + 2, c : c + 2] = True
+    return support
+
