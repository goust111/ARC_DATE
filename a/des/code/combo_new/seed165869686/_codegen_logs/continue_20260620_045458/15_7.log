+def _find_pair_rectangles(grid: np.ndarray, bg: int) -> tuple[list[dict], np.ndarray, list[list[Coord]]]:
+    non_bg = grid != bg
+    labels, non_bg_components = _label_components(non_bg)
+    support = _block_support_mask(non_bg)
