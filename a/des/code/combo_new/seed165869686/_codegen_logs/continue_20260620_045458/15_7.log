+    out[:sh, :sw] = source_patch
+    inp[target_row : target_row + sh, target_col : target_col + sw] = PATH_COLOR
+    out[target_row : target_row + sh, target_col : target_col + sw] = PATH_COLOR
+
+    for r, c in path:
