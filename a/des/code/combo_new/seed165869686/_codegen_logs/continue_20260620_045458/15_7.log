+
+        rect_cells = set(_cells_in_bbox(source_bbox)) | set(_cells_in_bbox(target_bbox))
+        path_cells = [cell for cell in comp_cells if cell not in rect_cells]
+        assert path_cells, "each structure must contain a connecting path"
