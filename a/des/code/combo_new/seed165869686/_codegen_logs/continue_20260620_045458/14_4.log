  "type": "transform_in_place",
  "src": "horizontal orange seed row on green background",
  "transform": "copy the input; every two rows downward, fill each green midpoint of an active-background-active triplet in the previous active row, alternating new rows pink then orange until no triplet remains"
}
</annotation>
