+
+def _mix_color(colors: set[int]) -> int:
+    if len(colors) == 1:
+        return next(iter(colors))
+    key = frozenset(colors)
+    assert key in MIX_COLORS, "unexpected crossing color combination"
+    return MIX_COLORS[key]
