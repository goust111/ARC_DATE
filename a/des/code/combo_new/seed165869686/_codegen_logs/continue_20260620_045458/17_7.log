+        if len(neighbors) == 2:
+            same_row = neighbors[0][0] == neighbors[1][0] == int(r)
+            same_col = neighbors[0][1] == neighbors[1][1] == int(c)
+            if not (same_row or same_col):
+                return False
+        if len(neighbors) == 4:
+            expected = {
+                (int(r) - 1, int(c)),
+                (int(r) + 1, int(c)),
+                (int(r), int(c) - 1),
+                (int(r), int(c) + 1),
+            }
+            if set(neighbors) != expected:
+                return False
+    return True
+
+
+def _mode_colors(mode: str) -> tuple[int, int] | None:
+    if mode == "rb_cross":
+        return (2, 1)
+    if mode == "rg_cross":
+        return (2, 3)
+    if mode == "bg_cross":
+        return (1, 3)
+    return None
+
+
+def _gen_attempt() -> np.ndarray | None:
