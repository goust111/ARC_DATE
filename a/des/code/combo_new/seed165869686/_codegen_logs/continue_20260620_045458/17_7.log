+    markers: set[tuple[int, int]] = set()
+    for pipe in pipes:
+        pipe_cells.update(_pipe_cells(pipe))
+        source_pos, exit_pos = _pipe_endpoints(pipe)
+        markers.add(source_pos)
+        markers.add(exit_pos)
