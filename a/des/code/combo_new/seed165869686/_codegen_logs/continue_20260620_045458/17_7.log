+        right = (pipe["row"], pipe["end"] + 1)
+        if pipe["source_side"] == "left":
+            return left, right
+        return right, left
+    top = (pipe["start"] - 1, pipe["col"])
+    bottom = (pipe["end"] + 1, pipe["col"])
+    if pipe["source_side"] == "top":
+        return top, bottom
+    return bottom, top
