+        if not (0 <= r < height and 0 <= c < width):
+            return False
+
+    candidate_cells = set(_pipe_cells(pipe))
+    candidate_markers = {source_pos, exit_pos}
+    occupied_cells, occupied_markers = _occupied_sets(pipes)
