125:def _is_frame_component(component: dict) -> bool:
126:    r0, c0, r1, c1 = component["bbox"]
127:    h = r1 - r0 + 1
128:    w = c1 - c0 + 1
129:    if h < 3 or w < 3:
130:        return False
131:
132:    mask = np.zeros((h, w), dtype=bool)
133:    for r, c in component["coords"]:
134:        mask[r - r0, c - c0] = True
135:
136:    expected = np.zeros((h, w), dtype=bool)
137:    expected[0, :] = True
138:    expected[-1, :] = True
139:    expected[:, 0] = True
140:    expected[:, -1] = True
141:    return np.array_equal(mask, expected)
