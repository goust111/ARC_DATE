+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+GEN_RETRIES = 400
+GRID_H_RANGE = (20, 30)
+GRID_W_RANGE = (20, 30)
+LOOKUP_OFFSET_RANGE = (0, 1)
+MAX_EXTRA_BLOCKS = 2
+
+TOUCHSETS_BY_COUNT = {
+    0: [frozenset()],
+    1: [frozenset([edge]) for edge in ("top", "bottom", "left", "right")],
+    2: [
+        frozenset(["top", "left"]),
+        frozenset(["top", "right"]),
+        frozenset(["bottom", "left"]),
+        frozenset(["bottom", "right"]),
+        frozenset(["top", "bottom"]),
+        frozenset(["left", "right"]),
+    ],
+    3: [
+        frozenset(["top", "bottom", "left"]),
+        frozenset(["top", "bottom", "right"]),
+        frozenset(["top", "left", "right"]),
+        frozenset(["bottom", "left", "right"]),
+    ],
+}
+MAX_FREE_DIM_BY_COUNT = {0: 5, 1: 7, 2: 6, 3: 4}
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1))
+
+
+def _bbox_from_coords(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _all_components(grid: np.ndarray, exclude_mask: np.ndarray | None = None) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    if exclude_mask is not None:
+        seen |= np.asarray(exclude_mask, dtype=bool)
+
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == BG:
+                continue
+
+            color = int(g[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+
+            bbox = _bbox_from_coords(coords)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": bbox,
+                    "area": len(coords),
+                }
+            )
+
+    return comps
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) != color:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+
+            bbox = _bbox_from_coords(coords)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": bbox,
+                    "area": len(coords),
+                }
+            )
+
+    return comps
+
+
+def _is_frame_component(component: dict) -> bool:
+    r0, c0, r1, c1 = component["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in component["coords"]:
+        mask[r - r0, c - c0] = True
+
+    expected = np.zeros((h, w), dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    return np.array_equal(mask, expected)
+
+
+def _parse_lookup_frame(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> dict[int, int] | None:
+    r0, c0, r1, c1 = bbox
+    interior = np.asarray(grid[r0 + 1 : r1, c0 + 1 : c1], dtype=int)
+    mapping: dict[int, int] = {}
+    nonempty_rows = 0
+
+    for row in interior:
+        nz = np.flatnonzero(row != BG)
+        if len(nz) == 0:
+            continue
+
+        nonempty_rows += 1
