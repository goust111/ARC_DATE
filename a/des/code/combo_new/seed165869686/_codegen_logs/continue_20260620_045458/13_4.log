300:def _choose_lookup_layout(
301:    h: int, w: int, rng: random.Random
302:) -> tuple[tuple[int, int, int, int], dict[int, int], list[tuple[int, int]], list[int]]:
303:    left_pad = rng.randint(1, 2)
304:    right_pad = rng.randint(1, 2)
305:    top_pad = rng.randint(1, 2)
306:    bottom_pad = rng.randint(1, 2)
307:    row_gaps = [rng.randint(0, 1) for _ in range(3)]
308:
309:    row_positions: list[int] = []
310:    row = 1 + top_pad
311:    for i in range(4):
312:        row_positions.append(row)
313:        if i < 3:
314:            row += 1 + row_gaps[i]
315:
316:    outer_h = 1 + top_pad + 4 + sum(row_gaps) + bottom_pad + 1
317:    outer_w = 1 + left_pad + 5 + right_pad + 1
318:
319:    corner = rng.choice(["top_left", "top_right", "bottom_left", "bottom_right"])
320:    row_offset = rng.randint(*LOOKUP_OFFSET_RANGE)
321:    col_offset = rng.randint(*LOOKUP_OFFSET_RANGE)
322:
323:    if corner.startswith("top"):
324:        r0 = row_offset
325:    else:
326:        r0 = h - outer_h - row_offset
327:    if corner.endswith("left"):
328:        c0 = col_offset
329:    else:
330:        c0 = w - outer_w - col_offset
331:
332:    bbox = (r0, c0, r0 + outer_h - 1, c0 + outer_w - 1)
333:    marker_start_col = c0 + 1 + left_pad
334:    abs_rows = [r0 + rel_row for rel_row in row_positions]
335:
336:    lookup_colors = rng.sample(PALETTE, 4)
337:    mapping = {count: color for count, color in zip((1, 2, 3, 4), lookup_colors)}
338:    row_counts = rng.sample([1, 2, 3, 4], 4)
339:
340:    row_specs = [(abs_rows[i], row_counts[i]) for i in range(4)]
341:    return bbox, mapping, row_specs, [color for color in PALETTE if color not in lookup_colors]
342:
343:
344:def _draw_lookup(
345:    grid: np.ndarray, bbox: tuple[int, int, int, int], mapping: dict[int, int], row_specs: list[tuple[int, int]]
346:) -> None:
347:    r0, c0, r1, c1 = bbox
348:    grid[r0, c0 : c1 + 1] = GREY
349:    grid[r1, c0 : c1 + 1] = GREY
350:    grid[r0 : r1 + 1, c0] = GREY
351:    grid[r0 : r1 + 1, c1] = GREY
352:
353:    for row, count in row_specs:
354:        start_col = c0 + 2
355:        grid[row, start_col : start_col + count] = GREY
356:        grid[row, start_col + count] = mapping[count]
357:
358:
359:def _render_rect(grid: np.ndarray, bbox: tuple[int, int, int, int], color: int) -> None:
360:    r0, c0, r1, c1 = bbox
361:    grid[r0 : r1 + 1, c0 : c1 + 1] = color
362:
363:
364:def _expected_output(grid: np.ndarray, mapping: dict[int, int], blocks: list[dict]) -> np.ndarray:
365:    out = np.asarray(grid, dtype=int).copy()
366:    h, w = out.shape
367:    for block in blocks:
368:        bbox = block["bbox"]
369:        edge_count = _touch_count(bbox, h, w)
370:        if edge_count >= 1:
371:            r0, c0, r1, c1 = bbox
372:            out[r0 : r1 + 1, c0 : c1 + 1] = mapping[edge_count]
373:    return out
