247:def _mark_blocked(blocked: np.ndarray, bbox: tuple[int, int, int, int], pad: int = 1) -> None:
248:    h, w = blocked.shape
249:    r0, c0, r1, c1 = _expanded_bbox(bbox, h, w, pad=pad)
250:    blocked[r0 : r1 + 1, c0 : c1 + 1] = True
