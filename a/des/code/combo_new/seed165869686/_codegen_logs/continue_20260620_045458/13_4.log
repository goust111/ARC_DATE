+                    "color": color,
+                    "coords": coords,
+                    "bbox": bbox,
+                    "area": len(coords),
+                }
+            )
+
+    return comps
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) != color:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
