189:def _is_solid_rectangle(grid: np.ndarray, component: dict) -> bool:
190:    r0, c0, r1, c1 = component["bbox"]
191:    color = int(component["color"])
192:    return int(component["area"]) == (r1 - r0 + 1) * (c1 - c0 + 1) and np.all(
193:        np.asarray(grid[r0 : r1 + 1, c0 : c1 + 1], dtype=int) == color
194:    )
