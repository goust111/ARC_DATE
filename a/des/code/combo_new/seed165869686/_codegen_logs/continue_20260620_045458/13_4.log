252:
253:def _sample_interval(
254:    length: int, touch_start: bool, touch_end: bool, max_free_dim: int, rng: random.Random
255:) -> tuple[int, int] | None:
256:    if touch_start and touch_end:
257:        return 0, length - 1
258:
259:    if touch_start or touch_end:
260:        upper = min(max_free_dim, length - 1)
261:        if upper < 2:
262:            return None
263:        size = rng.randint(2, upper)
264:        return (0, size - 1) if touch_start else (length - size, length - 1)
265:
266:    upper = min(max_free_dim, length - 2)
267:    if upper < 2:
268:        return None
269:    size = rng.randint(2, upper)
270:    start = rng.randint(1, length - size - 1)
271:    return start, start + size - 1
272:
273:
274:def _try_place_block(blocked: np.ndarray, touch_count: int, rng: random.Random) -> tuple[int, int, int, int] | None:
275:    h, w = blocked.shape
276:    touchsets = list(TOUCHSETS_BY_COUNT[touch_count])
277:    rng.shuffle(touchsets)
278:
279:    for touchset in touchsets:
280:        for _ in range(80):
281:            row_interval = _sample_interval(
282:                h, "top" in touchset, "bottom" in touchset, MAX_FREE_DIM_BY_COUNT[touch_count], rng
283:            )
284:            col_interval = _sample_interval(
285:                w, "left" in touchset, "right" in touchset, MAX_FREE_DIM_BY_COUNT[touch_count], rng
286:            )
287:            if row_interval is None or col_interval is None:
288:                continue
289:
290:            r0, r1 = row_interval
291:            c0, c1 = col_interval
292:            if blocked[r0 : r1 + 1, c0 : c1 + 1].any():
293:                continue
294:
295:            return r0, c0, r1, c1
296:
297:    return None
