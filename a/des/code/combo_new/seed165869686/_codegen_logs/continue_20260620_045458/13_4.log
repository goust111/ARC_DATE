197:def _touch_count(bbox: tuple[int, int, int, int], h: int, w: int) -> int:
198:    r0, c0, r1, c1 = bbox
199:    return int(r0 == 0) + int(r1 == h - 1) + int(c0 == 0) + int(c1 == w - 1)
