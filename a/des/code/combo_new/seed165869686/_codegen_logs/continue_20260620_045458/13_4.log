144:def _parse_lookup_frame(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> dict[int, int] | None:
145:    r0, c0, r1, c1 = bbox
146:    interior = np.asarray(grid[r0 + 1 : r1, c0 + 1 : c1], dtype=int)
147:    mapping: dict[int, int] = {}
148:    nonempty_rows = 0
149:
150:    for row in interior:
151:        nz = np.flatnonzero(row != BG)
152:        if len(nz) == 0:
153:            continue
154:
155:        nonempty_rows += 1
156:        if len(nz) != int(nz[-1] - nz[0] + 1):
157:            return None
158:
159:        segment = row[nz[0] : nz[-1] + 1]
160:        count = len(segment) - 1
161:        if not 1 <= count <= 4:
162:            return None
163:        if not np.all(segment[:-1] == GREY):
164:            return None
165:
166:        color = int(segment[-1])
167:        if color in (BG, GREY) or count in mapping:
168:            return None
169:        mapping[count] = color
170:
171:    if nonempty_rows != 4 or set(mapping) != {1, 2, 3, 4}:
172:        return None
173:    return mapping
