201:
202:def main(grid: np.ndarray) -> np.ndarray:
203:    """
204:    Recolor each solid rectangle by looking up the number of grid borders it touches.
205:
206:    Input structure:
207:    - The background is black.
208:    - Several solid monochrome rectangles are scattered around the grid; some touch one or more outer borders and some stay fully internal.
209:    - One corner region contains a grey-framed lookup table whose four rows show 1-4 grey marker cells followed immediately by one colored pixel.
210:
211:    Rule:
212:    - Detect the lookup table and read its mapping from marker-count 1, 2, 3, and 4 to replacement colors.
213:    - Ignore the lookup table itself, then find every other 4-connected monochrome component and treat each one as a solid rectangle.
214:    - Count how many of the four outer grid borders each rectangle touches; keep rectangles with count 0 unchanged, and recolor every rectangle with count >= 1 to the lookup color for that count.
215:
216:    Key insight:
217:    - The recolor key is not the rectangle's size or position alone but the hidden count of distinct outer borders it meets, which must then be translated through the legend.
218:    """
219:    g = np.asarray(grid, dtype=int)
220:    assert g.ndim == 2, "expected a 2D grid"
221:    h, w = g.shape
222:
223:    lookup_bbox, mapping = _find_lookup(g)
224:    r0, c0, r1, c1 = lookup_bbox
225:
226:    exclude = np.zeros((h, w), dtype=bool)
227:    exclude[r0 : r1 + 1, c0 : c1 + 1] = True
228:
229:    out = g.copy()
230:    for component in _all_components(g, exclude_mask=exclude):
231:        assert _is_solid_rectangle(g, component), "all non-lookup components must be solid rectangles"
232:        edge_count = _touch_count(component["bbox"], h, w)
233:        if edge_count >= 1:
234:            br0, bc0, br1, bc1 = component["bbox"]
235:            out[br0 : br1 + 1, bc0 : bc1 + 1] = mapping[edge_count]
236:
237:    return out
