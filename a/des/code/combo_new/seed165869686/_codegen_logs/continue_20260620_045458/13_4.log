176:def _find_lookup(grid: np.ndarray) -> tuple[tuple[int, int, int, int], dict[int, int]]:
177:    candidates: list[tuple[tuple[int, int, int, int], dict[int, int]]] = []
178:    for component in _components_of_color(grid, GREY):
179:        if not _is_frame_component(component):
180:            continue
181:        mapping = _parse_lookup_frame(grid, component["bbox"])
182:        if mapping is not None:
183:            candidates.append((component["bbox"], mapping))
184:
185:    assert len(candidates) == 1, "expected exactly one valid lookup table"
186:    return candidates[0]
