240:def _expanded_bbox(
241:    bbox: tuple[int, int, int, int], h: int, w: int, pad: int = 1
242:) -> tuple[int, int, int, int]:
243:    r0, c0, r1, c1 = bbox
244:    return max(0, r0 - pad), max(0, c0 - pad), min(h - 1, r1 + pad), min(w - 1, c1 + pad)
