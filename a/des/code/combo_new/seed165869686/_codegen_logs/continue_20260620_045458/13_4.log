375:
376:def _gen_attempt(rng: random.Random) -> np.ndarray | None:
377:    h = rng.randint(*GRID_H_RANGE)
378:    w = rng.randint(*GRID_W_RANGE)
379:    grid = np.zeros((h, w), dtype=int)
380:    blocked = np.zeros((h, w), dtype=bool)
381:
382:    lookup_bbox, mapping, row_specs, source_palette = _choose_lookup_layout(h, w, rng)
383:    _draw_lookup(grid, lookup_bbox, mapping, row_specs)
384:    _mark_blocked(blocked, lookup_bbox, pad=1)
385:
386:    if len(source_palette) < 4:
387:        return None
388:
389:    blocks: list[dict] = []
390:    source_colors = rng.sample(source_palette, 4)
391:    for touch_count, color in zip((3, 2, 1, 0), source_colors):
392:        bbox = _try_place_block(blocked, touch_count, rng)
393:        if bbox is None or _touch_count(bbox, h, w) != touch_count:
394:            return None
395:        _render_rect(grid, bbox, color)
396:        _mark_blocked(blocked, bbox, pad=1)
397:        blocks.append({"bbox": bbox, "color": color})
398:
399:    for _ in range(rng.randint(0, MAX_EXTRA_BLOCKS)):
400:        touch_count = rng.choice([0, 1, 2, 3])
401:        bbox = _try_place_block(blocked, touch_count, rng)
402:        if bbox is None:
403:            break
404:        color = rng.choice(source_palette)
405:        _render_rect(grid, bbox, color)
406:        _mark_blocked(blocked, bbox, pad=1)
407:        blocks.append({"bbox": bbox, "color": color})
408:
409:    expected = _expected_output(grid, mapping, blocks)
410:    try:
411:        actual = main(grid)
412:    except Exception:
413:        return None
414:    if not np.array_equal(actual, expected):
415:        return None
416:
417:    return grid
