50:def _all_components(grid: np.ndarray, exclude_mask: np.ndarray | None = None) -> list[dict]:
51:    g = np.asarray(grid, dtype=int)
52:    h, w = g.shape
53:    seen = np.zeros((h, w), dtype=bool)
54:    if exclude_mask is not None:
55:        seen |= np.asarray(exclude_mask, dtype=bool)
56:
57:    comps: list[dict] = []
58:    for r in range(h):
59:        for c in range(w):
60:            if seen[r, c] or int(g[r, c]) == BG:
61:                continue
62:
63:            color = int(g[r, c])
64:            stack = [(r, c)]
65:            seen[r, c] = True
66:            coords: list[tuple[int, int]] = []
67:
68:            while stack:
69:                rr, cc = stack.pop()
70:                coords.append((int(rr), int(cc)))
71:                for nr, nc in _neighbors4(rr, cc):
72:                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
73:                        seen[nr, nc] = True
74:                        stack.append((int(nr), int(nc)))
75:
76:            bbox = _bbox_from_coords(coords)
77:            comps.append(
