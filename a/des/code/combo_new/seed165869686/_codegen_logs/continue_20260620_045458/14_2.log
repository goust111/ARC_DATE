+    h, w = shape
+
+    def rot(cell: tuple[int, int], turns_count: int) -> tuple[int, int]:
+        r, c = cell
+        hh, ww = h, w
+        for _ in range(turns_count % 4):
+            r, c = c, hh - 1 - r
+            hh, ww = ww, hh
+        return r, c
+
+    rotated_paths: list[dict] = []
+    for path in paths:
+        rotated_paths.append(
+            {
+                "color": path["color"],
+                "cells": [rot(cell, k) for cell in path["cells"]],
+                "marked": path["marked"],
