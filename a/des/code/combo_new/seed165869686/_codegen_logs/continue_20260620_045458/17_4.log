    deg = degrees(track)
    candidates = [cell for cell in track if deg[cell] <= 2]
    if len(candidates) < 4:
        candidates = list(track)
    dmap = all_dists(track)
    for _ in range(500):
        seed_count = random.choice([2, 2, 3, 4])
        seed_count = min(seed_count, len(candidates), len(SEED_POOL))
        if seed_count < 2:
            return None
        random.shuffle(candidates)
        picked = []
        for cell in candidates:
            if all(dmap[cell][other] >= 4 for other in picked):
                picked.append(cell)
                if len(picked) == seed_count:
                    break
        if len(picked) < seed_count:
            continue
        colors = random.sample(SEED_POOL, seed_count)
        h = max(r for r, _ in track) + 2
        w = max(c for _, c in track) + 2
        g = np.zeros((h, w), dtype=int)
        for r, c in track:
            g[r, c] = TRACK
        for (r, c), color in zip(picked, colors):
            g[r, c] = color
        out = main(g)
        white = np.any(out == WHITE)
        counts = Counter(int(x) for x in out.flat if int(x) in colors)
        if white != want_white:
            continue
        if any(counts[color] < 2 for color in colors):
            continue
        return g, out, picked
    return None

for i in range(20):
    mode = random.choice(['"'path','branch'])
    want_white = random.choice([True, False])
    ok = False
    for _ in range(200):
        ch = random.randint(4, 10)
        cw = random.randint(4, 10)
        target = random.randint(5, min(ch*cw, 18))
        built = build_path(ch, cw, target) if mode == 'path' else build_tree(ch, cw, target)
        if not built:
