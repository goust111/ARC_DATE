def coarse_neighbors(cell, ch, cw):
    r, c = cell
    for nr, nc in neighbors4(r, c):
        if 0 <= nr < ch and 0 <= nc < cw:
            yield nr, nc

def build_path(ch, cw, target, tries=200):
    for _ in range(tries):
        start = (random.randrange(ch), random.randrange(cw))
        path = [start]
        used = {start}
        while len(path) < target:
            ends = []
            if len(path) == 1:
                ends = [0]
            else:
                ends = [0, -1]
            cand = []
            for idx in ends:
                r, c = path[idx]
                for nbr in coarse_neighbors((r, c), ch, cw):
                    if nbr in used:
                        continue
                    cand.append((idx, nbr))
            if not cand:
                break
            idx, nbr = random.choice(cand)
            if idx == 0:
                path.insert(0, nbr)
            else:
                path.append(nbr)
            used.add(nbr)
        if len(path) >= max(4, target - 1):
            return set(path), {(path[i], path[i + 1]) for i in range(len(path) - 1)}
    return None

def build_tree(ch, cw, target, max_deg=3, tries=200):
    for _ in range(tries):
        start = (random.randrange(ch), random.randrange(cw))
        nodes = {start}
        edges = set()
        deg = Counter()
        while len(nodes) < target:
            options = []
            for node in nodes:
                if deg[node] >= max_deg:
                    continue
                for nbr in coarse_neighbors(node, ch, cw):
                    if nbr in nodes:
