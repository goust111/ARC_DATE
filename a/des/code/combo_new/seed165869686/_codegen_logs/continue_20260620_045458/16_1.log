+        gap_axis = sorted(c for _r, c in missing)
+        lo, hi = c0 + 1, c1 - 1
+    elif all(r == r1 for r, _c in missing):
+        side = "bottom"
+        gap_axis = sorted(c for _r, c in missing)
+        lo, hi = c0 + 1, c1 - 1
+    elif all(c == c0 for _r, c in missing):
+        side = "left"
+        gap_axis = sorted(r for r, _c in missing)
+        lo, hi = r0 + 1, r1 - 1
+    elif all(c == c1 for _r, c in missing):
