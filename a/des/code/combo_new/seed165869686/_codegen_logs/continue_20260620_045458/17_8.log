+def _choose_pattern(rng: random.Random) -> np.ndarray:
+    size = rng.choice(sorted(PATTERN_LIBRARY))
+    raw = rng.choice(PATTERN_LIBRARY[size])
+    return np.asarray(raw, dtype=int)
