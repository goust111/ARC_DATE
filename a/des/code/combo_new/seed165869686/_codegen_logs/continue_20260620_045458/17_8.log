+    target = canvas[r0:r1, c0:c1]
+    target[mask] = window[mask]
+
+
+def _roll_stamp_along_frame(
+    canvas: np.ndarray, frame_bbox: tuple[int, int, int, int], patch: np.ndarray, bg: int
