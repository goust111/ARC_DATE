  41: def main(grid: np.ndarray) -> np.ndarray:
  42:     """
  43:     Rotate each blue-started chain of bottom-aligned vertical bars into horizontal bars resting on the same baseline.
  44:     Input structure
  45:     - The grid has a background and bottom-aligned, one-cell-wide vertical bars.
  46:     - Blue bars are markers; red bars are body bars that may be chained after a marker.
  47:     Rule
  48:     - Starting at each blue bar, repeatedly include the next red bar whose column is exactly the current bar's column plus the current bar's height.
  49:     - Clear every included vertical bar, then redraw each included bar horizontally to the right from its original bottom cell, with length equal to its vertical height.
  50:     - Red bars that are not reached from a blue marker remain unchanged.
  51:     Key insight
  52:     - A vertical bar's height is also the width it occupies after rotation, so the chain follows immediate horizontal contact after each rotated bar.
  53:     """
  54:     g = np.asarray(grid, dtype=int)
  55:     bg = get_bg(g)
  56:     colors = set(map(int, np.unique(g))) - {bg}
  57:     assert colors <= {MARKER_COLOR, BODY_COLOR}
  58:     assert MARKER_COLOR in colors
  59: 
  60:     bars = _vertical_bars(g, bg)
  61:     by_col = {bar["col"]: bar for bar in bars}
  62:     assert len(by_col) == len(bars)
  63: 
  64:     baselines = {bar["bottom"] for bar in bars}
  65:     assert len(baselines) == 1
  66:     baseline = baselines.pop()
  67:     out = g.copy()
  68:     for bar in bars:
  69:         if bar["color"] != MARKER_COLOR:
  70:             continue
  71: 
  72:         group = [bar]
  73:         current = bar
  74:         while True:
  75:             next_col = current["col"] + current["height"]
  76:             next_bar = by_col.get(next_col)
  77:             if next_bar is None:
  78:                 break
  79:             if next_bar["color"] != BODY_COLOR:
  80:                 break
  81:             group.append(next_bar)
  82:             current = next_bar
  83: 
  84:         for item in group:
  85:             rows = item["coords"][:, 0]
  86:             cols = item["coords"][:, 1]
  87:             out[rows, cols] = bg
  88: 
  89:         for item in group:
  90:             col = item["col"]
  91:             height = item["height"]
  92:             assert col + height <= g.shape[1]
  93:             out[baseline, col : col + height] = item["color"]
  94: 
  95:     return out
