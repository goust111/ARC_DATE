+        row = random.randrange(0, height - length + 1)
+        if not _can_place(occupied, row, col, row + length - 1, col, pad=1):
+            continue
+        grid[row : row + length, col] = LINE_COLOR
+        _reserve(occupied, row, col, row + length - 1, col, pad=1)
+        return length
+
+    return None
