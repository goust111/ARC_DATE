+    random.shuffle(plan)
+    return plan
+
+
+def _divisibility_targets(count: int) -> list[bool]:
+    mode = random.choice(("divisible", "nondivisible", "mixed"))
+    if mode == "divisible":
+        return [True] * count
+    if mode == "nondivisible":
+        return [False] * count
+    targets = [True] * (count // 2) + [False] * (count - count // 2)
