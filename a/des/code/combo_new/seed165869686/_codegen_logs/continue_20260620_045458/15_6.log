+def _place_objects(objs: list[dict]) -> list[tuple[int, int]] | None:
+    occupied = np.zeros((CANVAS_SIZE, CANVAS_SIZE), dtype=bool)
+    placements: list[tuple[int, int] | None] = [None] * len(objs)
