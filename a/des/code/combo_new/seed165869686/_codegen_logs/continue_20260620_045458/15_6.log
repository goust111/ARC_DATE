+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _apply_op(mask: np.ndarray, op: int) -> np.ndarray:
+    if op == 0:
+        return mask.copy()
+    if op == 1:
+        return np.fliplr(mask)
+    if op == 2:
+        return np.flipud(mask)
+    if op == 3:
+        return np.rot90(mask, 2)
+    raise AssertionError(f"unknown transform op {op}")
