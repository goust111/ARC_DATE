+        return None
+
+    for color in colors[2:]:
+        if not _place_extra_shape(grid, reserved, int(color), rng):
+            return None
+
+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+
+    if np.array_equal(out, grid):
+        return None
+    if int(np.count_nonzero(out == GREY)) == 0:
+        return None
+    if int(np.count_nonzero(out == YELLOW)) != 0:
+        return None
+    return grid
