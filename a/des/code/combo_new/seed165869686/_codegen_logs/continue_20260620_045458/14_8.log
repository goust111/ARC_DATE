+def _find_light_side(grid: np.ndarray) -> str:
+    h, w = grid.shape
+    total_yellow = int(np.count_nonzero(grid == YELLOW))
+    assert total_yellow >= LIGHT_LEN_MIN, "expected a boundary light strip"
