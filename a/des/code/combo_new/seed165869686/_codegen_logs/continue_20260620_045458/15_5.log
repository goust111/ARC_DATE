+def _components8(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    visited = np.zeros_like(mask, dtype=bool)
+    components = []
+
+    for r_raw, c_raw in np.argwhere(mask):
+        r = int(r_raw)
+        c = int(c_raw)
+        if visited[r, c]:
+            continue
+
+        stack = [(r, c)]
+        visited[r, c] = True
+        coords = []
+        while stack:
+            rr, cc = stack.pop()
+            coords.append((rr, cc))
+            for dr in (-1, 0, 1):
+                for dc in (-1, 0, 1):
+                    if dr == 0 and dc == 0:
+                        continue
+                    nr = rr + dr
+                    nc = cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if not mask[nr, nc] or visited[nr, nc]:
+                        continue
+                    visited[nr, nc] = True
