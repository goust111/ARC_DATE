+    return matches[0]
+
+
+def _line_pixels_ahead(
+    coords: np.ndarray, center: tuple[int, int], direction: str
+) -> np.ndarray:
+    if coords.size == 0:
+        return coords
+
+    r0, c0 = center
+    dr, dc = ARROW_SPECS[direction]["vec"]
+    if dr == 0:
+        mask = coords[:, 0] == r0
+        if dc > 0:
+            mask &= coords[:, 1] > c0
+        else:
+            mask &= coords[:, 1] < c0
+    else:
