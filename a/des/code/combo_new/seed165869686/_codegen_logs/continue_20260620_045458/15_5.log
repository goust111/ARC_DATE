+            out[ahead[:, 0], ahead[:, 1]] = bg
+
+        dr, dc = ARROW_SPECS[direction]["vec"]
+        for step in range(2, 2 + len(ahead)):
+            rr = center[0] + step * dr
+            cc = center[1] + step * dc
+            assert 0 <= rr < g.shape[0] and 0 <= cc < g.shape[1]
+            assert int(out[rr, cc]) in (bg, color)
+            out[rr, cc] = color
+
+    return out
