+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+MAX_GENERATION_ATTEMPTS = 400
+MAX_GRID_SIDE = 30
+RNG = np.random.default_rng()
+
+ARROW_SPECS = {
+    "up": {
+        "vec": (-1, 0),
+        "offsets": {(0, 0), (-1, -1), (-1, 0), (-1, 1), (1, 0)},
+    },
+    "down": {
+        "vec": (1, 0),
+        "offsets": {(0, 0), (1, -1), (1, 0), (1, 1), (-1, 0)},
+    },
+    "left": {
+        "vec": (0, -1),
+        "offsets": {(0, 0), (-1, -1), (0, -1), (1, -1), (0, 1)},
+    },
+    "right": {
+        "vec": (0, 1),
+        "offsets": {(0, 0), (-1, 1), (0, 1), (1, 1), (0, -1)},
+    },
+}
+
+
+def get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components8(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    visited = np.zeros_like(mask, dtype=bool)
+    components = []
+
+    for r_raw, c_raw in np.argwhere(mask):
+        r = int(r_raw)
+        c = int(c_raw)
+        if visited[r, c]:
+            continue
+
+        stack = [(r, c)]
+        visited[r, c] = True
+        coords = []
+        while stack:
+            rr, cc = stack.pop()
+            coords.append((rr, cc))
+            for dr in (-1, 0, 1):
+                for dc in (-1, 0, 1):
+                    if dr == 0 and dc == 0:
+                        continue
+                    nr = rr + dr
+                    nc = cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if not mask[nr, nc] or visited[nr, nc]:
+                        continue
+                    visited[nr, nc] = True
+                    stack.append((nr, nc))
+
+        components.append(np.array(coords, dtype=int))
+
+    return components
+
+
+def _identify_arrow(component: np.ndarray) -> tuple[tuple[int, int], str]:
+    coords = {tuple(map(int, cell)) for cell in component.tolist()}
+    matches = []
+    for r, c in coords:
+        for direction, spec in ARROW_SPECS.items():
+            expected = {(r + dr, c + dc) for dr, dc in spec["offsets"]}
+            if expected == coords:
