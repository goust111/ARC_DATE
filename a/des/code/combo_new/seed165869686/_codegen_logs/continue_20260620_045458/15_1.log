+    region_r_off = rng.randint(1, main_h - pack_h)
+    region_c_off = rng.randint(1, w - pack_w - 1)
+    template_left = rng.randint(0, w - template_total_w)
+
+    grid = np.full((h, w), BACKGROUND, dtype=int)
