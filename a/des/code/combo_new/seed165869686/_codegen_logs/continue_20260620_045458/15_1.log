+    placements, _, _ = _pack_regions(specs, rng)
+    orient = rng.choice(("right", "bottom"))
+    grid = _render_input(specs, placements, orient, rng)
+    if grid is None:
+        return None
+
+    expected = _render_expected(grid, specs)
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
