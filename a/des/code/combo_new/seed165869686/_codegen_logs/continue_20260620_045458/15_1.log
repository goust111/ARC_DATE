+def _render_expected(grid: np.ndarray, specs: list[dict]) -> np.ndarray:
+    out = grid.copy()
+    for spec in specs:
+        r0, c0, r1, c1 = spec["region_bbox"]
+        out[r0 + 1 : r1, c0 + 1 : c1] = _tile_pattern(spec["pattern"], (spec["inner_h"], spec["inner_w"]))
+    return out
+
