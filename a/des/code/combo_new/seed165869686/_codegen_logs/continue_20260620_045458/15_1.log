+def _tile_pattern(pattern: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    ph, pw = pattern.shape
+    h, w = shape
+    rows = np.arange(h) % ph
+    cols = np.arange(w) % pw
+    return pattern[rows[:, None], cols[None, :]].copy()
