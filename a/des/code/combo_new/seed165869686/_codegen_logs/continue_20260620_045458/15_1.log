+    groups: dict[int, list[tuple[int, int, int, int]]] = {}
+    for value in np.unique(grid):
+        color = int(value)
+        if color == bg:
+            continue
+        boxes = []
+        for comp in _components(grid == color):
+            box = _bbox(comp)
+            if _is_rect_frame(grid, color, box):
