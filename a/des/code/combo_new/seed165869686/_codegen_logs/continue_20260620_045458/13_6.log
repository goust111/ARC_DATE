+    universe = [(r, c) for r in range(4) for c in range(4)]
+    shapes: set[tuple[tuple[int, int], ...]] = set()
+    for size in range(2, 5):
+        for combo in combinations(universe, size):
+            norm = _normalize(combo)
+            if _is_connected(norm):
