+def _sample_profile(length: int, max_depth: int) -> list[int]:
+    for _ in range(100):
+        depths = [random.randint(1, max_depth) for _ in range(length)]
+        if max(depths) < 2:
+            continue
+        if sum(depths) < 3:
+            continue
+        return depths
