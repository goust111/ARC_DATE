+        if np.any(comp[:, 0] == 0):
+            sides.append("top")
+        if np.any(comp[:, 0] == sub.shape[0] - 1):
+            sides.append("bottom")
+        if np.any(comp[:, 1] == 0):
+            sides.append("left")
+        if np.any(comp[:, 1] == sub.shape[1] - 1):
