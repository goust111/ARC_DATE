+def _fill_color_for_degree(degree: int) -> int:
+    if degree == 1:
+        return RED
+    if degree == 2:
+        return BLUE
+    if degree == 3:
+        return GREEN
+    if degree >= 4:
+        return YELLOW
+    return BLACK
