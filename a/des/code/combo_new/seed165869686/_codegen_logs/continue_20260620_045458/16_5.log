+
+def _sample_axis_sizes(rng: random.Random, count: int) -> list[int]:
+    while True:
+        sizes = [rng.randint(MIN_ROOM_SIZE, MAX_ROOM_SIZE) for _ in range(count)]
+        total = sum(sizes) + count + 1
