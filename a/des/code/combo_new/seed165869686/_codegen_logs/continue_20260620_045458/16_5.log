+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+SCENARIOS = (
+    frozenset({1, 2}),
+    frozenset({1, 2, 3}),
+    frozenset({1, 2, 4}),
+    frozenset({1, 2, 3, 4}),
+)
+
+MIN_ROOM_SIZE = 3
+MAX_ROOM_SIZE = 6
+MAX_GENERATION_TRIES = 400
