+
+
+def _degree_categories(degrees: dict[int, int]) -> set[int]:
+    cats: set[int] = set()
+    for degree in degrees.values():
+        if degree >= 4:
+            cats.add(4)
+        elif degree >= 1:
+            cats.add(degree)
+    return cats
+
+
+def _choose_door_edges(
+    nrows: int,
+    ncols: int,
+    adjacency: dict[int, list[int]],
