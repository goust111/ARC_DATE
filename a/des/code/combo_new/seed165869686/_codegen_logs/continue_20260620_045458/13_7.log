+
+def _bbox_intersection(a: BBox, b: BBox) -> BBox | None:
+    r0 = max(a[0], b[0])
+    c0 = max(a[1], b[1])
+    r1 = min(a[2], b[2])
+    c1 = min(a[3], b[3])
+    if r0 > r1 or c0 > c1:
+        return None
+    return int(r0), int(c0), int(r1), int(c1)
