    r0=max(a[0],b[0]); c0=max(a[1],b[1]); r1=min(a[2],b[2]); c1=min(a[3],b[3])
    return None if r0>r1 or c0>c1 else (r0,c0,r1,c1)

def render(shape, rects, order):
    g=np.full(shape,BG,int)
    for color in order:
