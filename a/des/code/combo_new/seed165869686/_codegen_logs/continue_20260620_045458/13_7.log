/bin/bash -lc "python - <<'PY'
import itertools, random, time
import numpy as np
from collections import defaultdict

BG = 0
GRID_MIN, GRID_MAX = 16, 28
RECT_COUNT_CHOICES = (3,4,5)
CORE_SIDE_MIN, CORE_SIDE_MAX = 2, 4
MAX_MARGIN = 8
MIN_RECT_SIDE = 5
MIN_RECT_AREA = 24
MIN_VISIBLE_PIXELS = 4
GEN_RETRY = 400

BBox = tuple[int,int,int,int]

def bbox_from_coords(coords):
    rows = coords[:,0]
    cols = coords[:,1]
    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())

def intersect(a,b):
    r0=max(a[0],b[0]); c0=max(a[1],b[1]); r1=min(a[2],b[2]); c1=min(a[3],b[3])
    return None if r0>r1 or c0>c1 else (r0,c0,r1,c1)

def render(shape, rects, order):
    out=np.full(shape, BG, dtype=int)
    for color in order:
        r0,c0,r1,c1=rects[color]
        out[r0:r1+1,c0:c1+1]=color
    return out

def visibility_edges(grid, rects):
    colors=list(rects)
    edges={c:set() for c in colors}
    indeg={c:0 for c in colors}
    for i,a in enumerate(colors):
        for b in colors[i+1:]:
            inter=intersect(rects[a], rects[b])
            if inter is None:
                continue
            r0,c0,r1,c1=inter
            region=grid[r0:r1+1, c0:c1+1]
            see_a=bool(np.any(region==a))
            see_b=bool(np.any(region==b))
            if see_a and see_b:
                return None
            if see_a:
                if a not in edges[b]:
                    edges[b].add(a); indeg[a]+=1
            elif see_b:
                if b not in edges[a]:
                    edges[a].add(b); indeg[b]+=1
    return edges, indeg

def consistent_orders(grid, rects, limit=2):
    res=visibility_edges(grid, rects)
    if res is None:
        return []
    edges, indeg0 = res
    remaining=set(rects)
    out=[]
    order=[]
    indeg=indeg0.copy()
    def rec():
        if len(out) >= limit:
            return
        if not remaining:
            cand=tuple(order)
            if np.array_equal(render(grid.shape, rects, cand), grid):
                out.append(cand)
            return
        avail=sorted(c for c in remaining if indeg[c]==0)
        for c in avail:
            remaining.remove(c)
            order.append(c)
            changed=[]
            for nxt in edges[c]:
                indeg[nxt]-=1
                changed.append(nxt)
            rec()
            for nxt in changed:
                indeg[nxt]+=1
            order.pop()
            remaining.add(c)
            if len(out) >= limit:
                return
    rec()
    return out

def visible_bbox_ok(grid, rects):
    for color, box in rects.items():
        coords=np.argwhere(grid==color)
        if coords.size==0:
            return False
        if bbox_from_coords(coords)"'!=box:
            return False
        if coords.shape[0] < MIN_VISIBLE_PIXELS:
            return False
    return True

def contains(a,b):
    return a[0] <= b[0] and a[1] <= b[1] and a[2] >= b[2] and a[3] >= b[3]

def has_non_nested_pair(boxes):
    boxes=list(boxes)
    for i,a in enumerate(boxes):
        for b in boxes[i+1:]:
            if not contains(a,b) and not contains(b,a):
                return True
    return False

def sample_rectangles():
    H=random.randint(GRID_MIN, GRID_MAX)
    W=random.randint(GRID_MIN, GRID_MAX)
    n=random.choice(RECT_COUNT_CHOICES)
    colors=random.sample(range(1,10),n)
    ch=random.randint(CORE_SIDE_MIN, min(CORE_SIDE_MAX, H-8))
    cw=random.randint(CORE_SIDE_MIN, min(CORE_SIDE_MAX, W-8))
    cr0=random.randint(3, H-ch-4)
    cc0=random.randint(3, W-cw-4)
    cr1=cr0+ch-1
    cc1=cc0+cw-1
    rects={}
    boxes=[]
    for color in colors:
        for _ in range(80):
            up=random.randint(1, min(MAX_MARGIN, cr0))
            down=random.randint(1, min(MAX_MARGIN, H-1-cr1))
            left=random.randint(1, min(MAX_MARGIN, cc0))
            right=random.randint(1, min(MAX_MARGIN, W-1-cc1))
            box=(cr0-up, cc0-left, cr1+down, cc1+right)
            h=box[2]-box[0]+1
            w=box[3]-box[1]+1
            if h < MIN_RECT_SIDE or w < MIN_RECT_SIDE or h*w < MIN_RECT_AREA:
                continue
            if box in boxes:
                continue
            if any(sum(abs(x-y) for x,y in zip(box, prev)) < 4 for prev in boxes):
                continue
            rects[color]=box
            boxes.append(box)
            break
        else:
            return None
    if not has_non_nested_pair(boxes):
        return None
    return (H,W,rects,tuple(random.sample(colors,n)))

def gen_one():
    for _ in range(GEN_RETRY):
        data=sample_rectangles()
        if data is None:
            continue
        H,W,rects,order=data
        inp=render((H,W),rects,order)
        if not visible_bbox_ok(inp,rects):
            continue
        orders=consistent_orders(inp, rects, limit=2)
        if orders != [order]:
            continue
        out=render((H,W), rects, order[1:]+order[:1])
        if np.array_equal(inp, out):
            continue
        return inp
    raise RuntimeError('"'failed')

start=time.time()
shapes=[]
for i in range(100):
    g=gen_one()
    shapes.append(g.shape)
print('ok', len(shapes), 'time', time.time()-start, 'sample shapes', shapes[:10])
