+    orders = _consistent_orders(g, rectangles, limit=2)
+    assert len(orders) == 1, "expected a unique stacking order"
+
+    order = orders[0]
+    new_order = order[1:] + order[:1]
+    return _render_scene(g.shape, rectangles, new_order)
+
