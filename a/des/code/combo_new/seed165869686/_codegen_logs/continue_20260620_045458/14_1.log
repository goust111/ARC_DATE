+            continue
+        enclosed.append(comp)
+    if not enclosed:
+        return None
+    chosen = max(enclosed, key=lambda comp: int(comp.shape[0]))
+    out = np.zeros_like(mask, dtype=bool)
+    out[chosen[:, 0], chosen[:, 1]] = True
+    return out
