+
+def _paint_hole_frame(
+    shape_mask: np.ndarray,
+    border_color: int,
+    fill_color: int,
+    hole_top_pad: int,
+    hole_left_pad: int,
+    hole_bottom_pad: int,
+    hole_right_pad: int,
+) -> tuple[np.ndarray, np.ndarray]:
