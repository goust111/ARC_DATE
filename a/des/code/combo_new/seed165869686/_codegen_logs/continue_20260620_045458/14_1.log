+            left = int(_RNG.integers(canvas_left, width - pw))
+            if not _can_place(occupied, top, left, ph, pw, pad=1):
+                continue
+            grid[top : top + ph, left : left + pw] = patch
+            expected[top + 1 : top + ph - 1, left + 1 : left + pw - 1] = palette_colors[palette_slot]
