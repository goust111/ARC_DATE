+            hole_mask,
+            border_color=border_color,
+            fill_color=filler_color,
+            hole_top_pad=hole_top_pad,
+            hole_left_pad=hole_left_pad,
+            hole_bottom_pad=hole_bottom_pad,
+            hole_right_pad=hole_right_pad,
