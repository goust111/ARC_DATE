+    row_idx = np.minimum((np.arange(target_h) * src_h) // target_h, src_h - 1)
+    col_idx = np.minimum((np.arange(target_w) * src_w) // target_w, src_w - 1)
+    return mask[row_idx[:, None], col_idx[None, :]]
