+_BG = 0
+_FRAME = 5
+_MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+_COUNT_RANGE = (2, 5)
+_SHAPE_SIZE_RANGE = (3, 6)
+_EXTRA_SLACK_MAX = 4
+_GEN_ATTEMPTS = 400
