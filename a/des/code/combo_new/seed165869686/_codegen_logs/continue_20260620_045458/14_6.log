+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 3 or w < 3:
+        return None
+    expected_area = 2 * h + 2 * w - 4
+    if int(coords.shape[0]) != expected_area:
+        return None
+    pts = {(int(r), int(c)) for r, c in coords}
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            on_border = r in (r0, r1) or c in (c0, c1)
+            present = (r, c) in pts
+            if on_border != present:
+                return None
+    return r0, c0, r1, c1
