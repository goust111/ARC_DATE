+            interior = canvas[r0 + 1 : r1, c0 + 1 : c1]
+            markers = np.argwhere(interior != bg)
+            if markers.shape[0] != 1:
+                continue
+            mr, mc = map(int, markers[0])
+            marker_color = int(interior[mr, mc])
+            if marker_color == color:
