+        slot_w = slot_cols * patch_w + (slot_cols - 1) * gap
+        if slot_h > main_h or slot_w + 1 > main_w:
+            return None
+        r0 = _randint(rng, 0, main_h - slot_h)
+        c0 = _randint(rng, 1, main_w - slot_w)
