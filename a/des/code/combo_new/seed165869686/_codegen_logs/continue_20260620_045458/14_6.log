+        for frame in valid_frames:
+            r0, c0, r1, c1 = frame["bbox"]
+            by_size[(int(r1 - r0 + 1), int(c1 - c0 + 1))].append(frame)
+        for size, frames in by_size.items():
+            groups.append({"border_color": color, "size": size, "frames": frames})
