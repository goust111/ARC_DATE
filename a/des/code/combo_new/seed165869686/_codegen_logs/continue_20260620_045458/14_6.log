+        main_h = main_h_base + _randint(rng, 0, min(_EXTRA_SLACK_MAX, 30 - main_h_base))
+        main_w = main_w_base + _randint(rng, 0, min(_EXTRA_SLACK_MAX, 29 - main_w_base))
