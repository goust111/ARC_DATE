+def _remove_bar(grid: np.ndarray, side: str) -> np.ndarray:
+    if side == "top":
+        return grid[1:, :]
+    if side == "bottom":
+        return grid[:-1, :]
+    if side == "left":
+        return grid[:, 1:]
+    if side == "right":
+        return grid[:, :-1]
+    raise ValueError(side)
