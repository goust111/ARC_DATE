+def _frame_bbox(coords: np.ndarray) -> tuple[int, int, int, int] | None:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 3 or w < 3:
+        return None
+    expected_area = 2 * h + 2 * w - 4
+    if int(coords.shape[0]) != expected_area:
+        return None
+    pts = {(int(r), int(c)) for r, c in coords}
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
