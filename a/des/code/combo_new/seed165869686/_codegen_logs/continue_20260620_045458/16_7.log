+def _gen_attempt() -> np.ndarray | None:
+    count = random.randint(4, 6)
+    categories = _planned_categories(count)
+    specs: list[dict[str, object]] = []
+
+    for category, color in zip(categories, random.sample(INPUT_COLORS, count)):
