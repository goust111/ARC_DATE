+            pts = np.array(coords, dtype=int)
+            r0, c0 = map(int, pts.min(axis=0))
+            r1, c1 = map(int, pts.max(axis=0))
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in coords:
+                mask[int(rr) - r0, int(cc) - c0] = True
+
+            objects.append(
