+        return random.randint(0, h - mh), w - mw
+    return random.randint(0, h - mh), random.randint(0, w - mw)
+
+
+def _planned_categories(count: int) -> list[str]:
+    cats = ["lr_only", "ud_only", "both", "none"]
+    for _ in range(count - 4):
