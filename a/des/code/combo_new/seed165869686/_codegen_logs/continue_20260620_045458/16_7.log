+        if not frontier:
+            return mask if _touches_all_sides(mask) else None
+
+        touches = {
+            "top": bool(mask[0, :].any()),
+            "bottom": bool(mask[-1, :].any()),
+            "left": bool(mask[:, 0].any()),
+            "right": bool(mask[:, -1].any()),
