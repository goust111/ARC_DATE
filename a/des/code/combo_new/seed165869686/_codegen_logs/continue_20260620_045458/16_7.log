+
+def _paste_mask(grid: np.ndarray, reserved: np.ndarray, r0: int, c0: int, mask: np.ndarray, color: int) -> None:
+    mh, mw = mask.shape
+    patch = grid[r0 : r0 + mh, c0 : c0 + mw]
