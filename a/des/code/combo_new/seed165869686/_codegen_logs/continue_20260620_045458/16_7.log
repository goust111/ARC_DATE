+
+        touches = {
+            "top": bool(mask[0, :].any()),
+            "bottom": bool(mask[-1, :].any()),
+            "left": bool(mask[:, 0].any()),
+            "right": bool(mask[:, -1].any()),
+        }
+        candidates = sorted(frontier)
+        weights: list[int] = []
+        for idx in candidates:
+            gain = 0
+            for r, c in orbits[int(idx)]:
+                if r == 0 and not touches["top"]:
+                    gain += 1
+                if r == h - 1 and not touches["bottom"]:
