+    patch = np.zeros((body_len + 1, 3), dtype=bool)
+    if direction == "down":
+        patch[:body_len, 0] = True
+        patch[:body_len, 2] = True
+        patch[0, :] = True
+        patch[body_len - 1, :] = True
+        patch[body_len, 1] = True
+    else:
+        patch[1:, 0] = True
+        patch[1:, 2] = True
+        patch[1, :] = True
+        patch[body_len, :] = True
+        patch[0, 1] = True
+    return patch
+
+
+def _decode_arrow(coords: np.ndarray) -> dict:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
