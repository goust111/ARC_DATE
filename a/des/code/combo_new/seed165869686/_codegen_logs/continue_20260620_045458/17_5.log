+            inner = (spec["arrow_top"] + 1, spec["arrow_left"] + 1, 1, body_len - 2)
+        elif direction == "left":
+            inner = (spec["arrow_top"] + 1, spec["arrow_left"] + 2, 1, body_len - 2)
+        elif direction == "down":
+            inner = (spec["arrow_top"] + 1, spec["arrow_left"] + 1, body_len - 2, 1)
+        else:
