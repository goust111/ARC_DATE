+            patch[2, :body_len] = True
+            patch[1, 0] = True
+            patch[1, body_len - 1] = True
+            patch[1, body_len] = True
+        else:
+            patch[0, 1:] = True
+            patch[2, 1:] = True
+            patch[1, 0] = True
+            patch[1, 1] = True
+            patch[1, body_len] = True
