+    for c in range(w):
+        if np.all(grid[:, c] == grid[0, c]):
+            candidates.add(int(grid[0, c]))
+    candidates.discard(BG)
+    assert len(candidates) == 1, "expected one divider color spanning full rows/cols"
+    return next(iter(candidates))
