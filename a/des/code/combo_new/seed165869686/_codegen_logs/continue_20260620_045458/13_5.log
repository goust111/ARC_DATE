+    split_rows = [-1] + [r for r in range(h) if np.all(grid[r, :] == divider)] + [h]
+    split_cols = [-1] + [c for c in range(w) if np.all(grid[:, c] == divider)] + [w]
+
+    regions = []
+    for r0, r1 in zip(split_rows, split_rows[1:]):
+        if r1 - r0 <= 1:
+            continue
+        for c0, c1 in zip(split_cols, split_cols[1:]):
+            if c1 - c0 <= 1:
