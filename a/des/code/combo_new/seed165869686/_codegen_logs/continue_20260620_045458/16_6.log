+
+def _find_target(obj: dict, rect_id: np.ndarray) -> int:
+    r0, c0, r1, c1 = obj["bbox"]
+    source_id = int(obj["index"])
+    direction = obj["direction"]
+    band = tuple(int(v) for v in obj["band"])
