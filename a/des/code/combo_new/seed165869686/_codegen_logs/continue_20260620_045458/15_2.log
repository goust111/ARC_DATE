+def _build_chain(rows: list[int]) -> list[tuple[int, int]]:
+    path = [(int(rows[0]), 0)]
+    for x in range(len(rows) - 1):
+        cur = int(rows[x])
+        nxt = int(rows[x + 1])
+        path.append((int(cur), int(x + 1)))
+        if nxt > cur:
