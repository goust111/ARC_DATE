+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+SKELETON = 5
+FRAGMENT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_GEN_ATTEMPTS = 500
