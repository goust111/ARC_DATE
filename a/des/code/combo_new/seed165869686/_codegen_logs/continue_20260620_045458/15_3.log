+            holes_local = _hole_components(local)
+            obj_holes: set[tuple[int, int]] = set()
+            for hole in holes_local:
+                for rr, cc in hole:
+                    obj_holes.add((int(r0 + rr), int(c0 + cc)))
+
+            hole_pixels |= obj_holes
+            objects.append(
+                {
+                    "color": color,
+                    "coords": tuple(coords),
+                    "hole_count": len(holes_local),
+                    "holes": obj_holes,
