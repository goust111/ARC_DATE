+def _paint_object(grid: np.ndarray, blocked: np.ndarray, mask: np.ndarray, color: int, top: int, left: int):
+    coords = np.argwhere(mask)
+    rows = top + coords[:, 0]
+    cols = left + coords[:, 1]
+    grid[rows, cols] = color
+    _stamp_blocked(blocked, mask, top, left)
