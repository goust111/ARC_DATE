+
+def _neighbors4(r: int, c: int):
+    for dr, dc in DIR4:
+        yield r + dr, c + dc
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[list[tuple[int, int]]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            parts.append(comp)
+    return parts
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    pts = np.argwhere(mask)
+    if len(pts) == 0:
+        return np.zeros((0, 0), dtype=bool)
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _hole_components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    holes: list[list[tuple[int, int]]] = []
+    for comp in _components(~mask):
+        if any(r in (0, h - 1) or c in (0, w - 1) for r, c in comp):
+            continue
+        holes.append(comp)
+    return holes
+
+
+def _hole_count(mask: np.ndarray) -> int:
+    return len(_hole_components(mask))
+
+
+def _analyze_objects(grid: np.ndarray):
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    objects = []
+    hole_pixels: set[tuple[int, int]] = set()
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == BG or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+
+            r0, c0, r1, c1 = _bbox(coords)
+            local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in coords:
+                local[rr - r0, cc - c0] = True
+
+            holes_local = _hole_components(local)
+            obj_holes: set[tuple[int, int]] = set()
+            for hole in holes_local:
+                for rr, cc in hole:
+                    obj_holes.add((int(r0 + rr), int(c0 + cc)))
+
+            hole_pixels |= obj_holes
+            objects.append(
+                {
+                    "color": color,
+                    "coords": tuple(coords),
+                    "hole_count": len(holes_local),
+                    "holes": obj_holes,
+                }
+            )
+
+    return objects, hole_pixels
