+        count = rng.choices([3, 4, 5], weights=[3, 3, 2])[0]
+        pair = rng.choice([(1, 2), (2, 1), (2, 2), (1, 3), (3, 1)])
+        rest = [0]
+        while len(rest) < count - 2:
+            rest.append(rng.choices([0, 1, 2, 3], weights=[3, 3, 2, 1])[0])
