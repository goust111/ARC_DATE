+    out = g.copy()
+    conflict_count = 0
+    unique_count = 0
+    for pos, claimers in claims.items():
+        if len(claimers) == 1:
+            obj = objects[claimers[0]]
+            out[pos] = int(obj["color"])
+            unique_count += 1
+        else:
+            conflict_count += 1
+
+    return out, {"objects": objects, "claims": claims, "conflict_count": conflict_count, "unique_count": unique_count}
