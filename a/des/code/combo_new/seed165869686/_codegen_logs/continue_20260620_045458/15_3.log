+def _can_place(blocked: np.ndarray, mask: np.ndarray, top: int, left: int) -> bool:
+    coords = np.argwhere(mask)
+    rows = top + coords[:, 0]
+    cols = left + coords[:, 1]
+    return not bool(np.any(blocked[rows, cols]))
+
