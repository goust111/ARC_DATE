+import numpy as np
+
+
+BG = 0
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRIES = 300
+PLACE_TRIES = 120
+COLOR_POOL = [1, 2, 3, 4, 5, 6, 7, 8, 9]
