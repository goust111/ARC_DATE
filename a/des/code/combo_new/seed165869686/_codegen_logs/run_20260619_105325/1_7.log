+            "down": [(int(r1 + 1), int(c)) for c in range(int(c0), int(c1 + 1))],
+            "left": [(int(r), int(c0 - 1)) for r in range(int(r0), int(r1 + 1))],
+            "right": [(int(r), int(c1 + 1)) for r in range(int(r0), int(r1 + 1))],
