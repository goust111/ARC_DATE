+    return True
+
+
+def _reserve(blocked: np.ndarray, cells: list[tuple[int, int]], *, pad: int) -> None:
+    h, w = blocked.shape
+    for r, c in cells:
+        r0 = max(0, int(r - pad))
+        r1 = min(h, int(r + pad + 1))
+        c0 = max(0, int(c - pad))
+        c1 = min(w, int(c + pad + 1))
+        blocked[r0:r1, c0:c1] = True
