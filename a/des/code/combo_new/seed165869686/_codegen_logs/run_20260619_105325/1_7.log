+def _trim_patch(patch: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(patch != 0)
+    r0, c0, r1, c1 = _bbox(coords)
+    out = np.zeros((int(r1 - r0 + 1), int(c1 - c0 + 1)), dtype=int)
+    sub = patch[r0 : r1 + 1, c0 : c1 + 1]
+    out[sub != 0] = sub[sub != 0]
+    return out
