+from __future__ import annotations
+
+import random
+import numpy as np
+
+
+BG = 0
+RED = 2
+GREY = 5
+MAROON = 9
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+KEY_COLORS = (1, 3, 4, 6, 7, 8)
+PAYLOAD_COLORS = (1, 3, 4, 6, 7, 8)
+SHAPE_LIBRARY = (
+    np.array([[1, 0], [1, 1]], dtype=bool),
+    np.array([[1, 0, 0], [1, 1, 1]], dtype=bool),
+    np.array([[1, 1, 1], [0, 1, 0]], dtype=bool),
+)
+
+GEN_RETRIES = 500
