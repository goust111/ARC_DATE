+def _can_place(occupied: np.ndarray, top: int, left: int, patch_shape: tuple[int, int], gap: int) -> bool:
+    height, width = map(int, occupied.shape)
+    ph, pw = map(int, patch_shape)
+    r0 = max(0, top - gap)
+    c0 = max(0, left - gap)
+    r1 = min(height, top + ph + gap)
+    c1 = min(width, left + pw + gap)
