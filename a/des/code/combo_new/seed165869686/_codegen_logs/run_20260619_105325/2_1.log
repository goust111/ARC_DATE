+        seed_color = int(inner[sr, sc])
+        assert seed_color in legend, "every seed color must appear in the legend"
+
+        pattern = legend[seed_color]
+        out[r0 + 1 : r1, c0 + 1 : c1] = _tile_pattern(inner.shape[0], inner.shape[1], pattern)
+
+    return out
