+    occupied = np.zeros_like(strip, dtype=bool)
+    r = 0
+    h = strip.shape[0]
+    while r < h:
+        if np.all(strip[r, :] == BLACK):
+            r += 1
+            continue
+        if r + ENTRY_HEIGHT > h:
+            return None
+
+        block = strip[r : r + ENTRY_HEIGHT, :]
+        if np.any((block == BLACK) | (block == GREY)):
