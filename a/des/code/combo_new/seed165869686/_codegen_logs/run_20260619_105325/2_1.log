+def _far_enough(
+    bbox: tuple[int, int, int, int],
+    placed: list[tuple[int, int, int, int]],
+    padding: int = 1,
+) -> bool:
+    r0, c0, r1, c1 = bbox
+    for pr0, pc0, pr1, pc1 in placed:
+        if not (r1 + padding < pr0 or pr1 + padding < r0 or c1 + padding < pc0 or pc1 + padding < c0):
