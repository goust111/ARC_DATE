+def _random_pattern(rng: random.Random, colors: list[int], seen: set[bytes]) -> np.ndarray:
+    while True:
+        palette = rng.sample(colors, rng.randint(2, min(4, len(colors))))
+        flat = [rng.choice(palette) for _ in range(PATTERN_SIZE * PATTERN_SIZE)]
