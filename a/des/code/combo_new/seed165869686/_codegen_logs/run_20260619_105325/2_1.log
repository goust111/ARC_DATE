+    if w >= ENTRY_WIDTH + 1 and np.all(g[:, ENTRY_WIDTH] == BLACK):
+        mapping = _parse_vertical_strip(g[:, :ENTRY_WIDTH])
+        if mapping is not None:
+            candidates.append(mapping)
+
+    if w >= ENTRY_WIDTH + 1 and np.all(g[:, -(ENTRY_WIDTH + 1)] == BLACK):
+        mapping = _parse_vertical_strip(g[:, -ENTRY_WIDTH:])
+        if mapping is not None:
