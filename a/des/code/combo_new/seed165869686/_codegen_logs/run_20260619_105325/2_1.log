+
+            if usable_r0 > usable_r1 - box_h + 1 or usable_c0 > usable_c1 - box_w + 1:
+                return []
+
+            r0 = rng.randint(usable_r0, usable_r1 - box_h + 1)
+            c0 = rng.randint(usable_c0, usable_c1 - box_w + 1)
