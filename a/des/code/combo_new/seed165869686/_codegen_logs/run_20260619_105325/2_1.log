+def _main_bounds(shape: tuple[int, int], orientation: str) -> tuple[int, int, int, int]:
+    h, w = shape
+    if orientation == "top":
+        return 4, 0, h - 1, w - 1
+    if orientation == "left":
+        return 0, 5, h - 1, w - 1
+    return 0, 0, h - 1, w - 6
