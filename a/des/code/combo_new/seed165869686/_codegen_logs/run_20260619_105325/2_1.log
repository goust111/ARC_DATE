+
+    if np.array_equal(out, grid):
+        return None
+    if set(seed_labels) != set(labels):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_MAX_RETRIES):
+        grid = _build_candidate(rng)
+        if grid is not None:
