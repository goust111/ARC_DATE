+    pattern_colors = palette[seed_count:]
+    pair_pool = list(combinations(seed_colors, 2))
+    random.shuffle(pair_pool)
+    pairs = [tuple(sorted(map(int, pair_pool[i]))) for i in range(n_keys)]
