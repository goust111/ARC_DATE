+    rings: list[dict] = []
+    for idx in range(ring_count):
+        force_clip = want_clip and idx == 0
+        ring = _sample_ring(grid_h, grid_w, reserved, ring_count, force_clip)
+        if ring is None:
+            return None
+        ring["color"] = int(colors[idx])
