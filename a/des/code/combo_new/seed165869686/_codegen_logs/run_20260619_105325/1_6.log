+def _clip_box(
+    box: tuple[int, int, int, int], grid_h: int, grid_w: int
+) -> tuple[int, int, int, int] | None:
+    r0, c0, height, width = box
+    rr0 = max(0, int(r0))
+    cc0 = max(0, int(c0))
+    rr1 = min(int(grid_h), int(r0 + height))
+    cc1 = min(int(grid_w), int(c0 + width))
