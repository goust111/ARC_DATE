+def _is_rectangular_ring(grid: np.ndarray, color: int) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(grid == int(color))
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
