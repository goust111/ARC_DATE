+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (18, 30)
+FRAME_H_RANGE = (5, 8)
+FRAME_W_RANGE = (5, 8)
+FRAME_MARGIN = 2
+GAP_RANGE = (2, 5)
+BAR_LEN_RANGE = (2, 4)
