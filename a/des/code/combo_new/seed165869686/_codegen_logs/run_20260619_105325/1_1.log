+                        for c in range(c0, c1 + 1):
+                            if int(grid[r0, c]) != (BLACK if c == sc else GREY):
+                                ok = False
+                                break
+                            if int(grid[r1, c]) != (BLACK if c == sc else GREY):
+                                ok = False
+                                break
+                        if not ok:
