+        rows_overlap = list(range(r0 + 1, r0 + min(h1, h2) - 1))
+        cols_overlap = [c for c in range(c0 + 1, c0 + min(w1, w3) - 1) if c in safe_cols]
+        if len(rows_overlap) < 2 or len(cols_overlap) < 2:
