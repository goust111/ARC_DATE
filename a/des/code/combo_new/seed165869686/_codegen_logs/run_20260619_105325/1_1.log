+            {"bbox": (r0, c0, r0 + h1 - 1, c0 + w1 - 1), "seed": (row1, col1)},
+            {"bbox": (r0b, c0, r0b + h2 - 1, c0 + w2 - 1), "seed": (row2, col2)},
