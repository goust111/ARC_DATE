+
+def _ray_cells(
+    grid: np.ndarray,
+    start: tuple[int, int],
+    direction: tuple[int, int],
+) -> tuple[list[tuple[int, int]], str]:
+    h, w = grid.shape
+    r, c = start
+    dr, dc = direction
+    cells: list[tuple[int, int]] = []
+    while True:
+        r += dr
+        c += dc
+        if not (0 <= r < h and 0 <= c < w):
+            return cells, "boundary"
+        if int(grid[r, c]) == GREY:
