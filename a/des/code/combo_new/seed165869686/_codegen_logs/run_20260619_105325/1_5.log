+        max_w = min(WINDOW_LONG_RANGE[1], inner_w - 2)
+        if max_h < WINDOW_SHORT_RANGE[0] or max_w < WINDOW_LONG_RANGE[0]:
+            return None
+        height = random.randint(WINDOW_SHORT_RANGE[0], max_h)
+        width = random.randint(WINDOW_LONG_RANGE[0], max_w)
