+
+def _place_obstacles(
+    grid: np.ndarray,
+    room: tuple[int, int, int, int],
+    windows: list[dict[str, object]],
+) -> bool:
+    corridor_sets = [_corridor_cells(room, window) for window in windows]
+    union = sorted(set().union(*corridor_sets))
