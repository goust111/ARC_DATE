+GEN_ATTEMPTS = 400
+ROOM_SIZE_RANGE = (12, 22)
+MARGIN_RANGE = (1, 4)
+WINDOW_SIDE_COUNT_RANGE = (2, 4)
+WINDOW_SHORT_RANGE = (2, 4)
+WINDOW_LONG_RANGE = (2, 5)
+WINDOW_TRIES = 100
+OBSTACLE_TRIES = 120
+MAX_OBSTACLES = 7
