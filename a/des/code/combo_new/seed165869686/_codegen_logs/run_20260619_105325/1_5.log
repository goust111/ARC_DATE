+        "bottom": r1 == inner_bottom and c0 > inner_left and c1 < inner_right,
+        "left": c0 == inner_left and r0 > inner_top and r1 < inner_bottom,
+        "right": c1 == inner_right and r0 > inner_top and r1 < inner_bottom,
