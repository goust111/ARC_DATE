+
+def _rand_margin_pair(max_total: int) -> tuple[int, int]:
+    pairs = [
+        (a, b)
+        for a in range(MARGIN_RANGE[0], MARGIN_RANGE[1] + 1)
+        for b in range(MARGIN_RANGE[0], MARGIN_RANGE[1] + 1)
+        if a + b <= max_total
