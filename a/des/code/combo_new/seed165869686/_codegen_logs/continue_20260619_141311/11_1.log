+def _frame_index_for_component(
+    coords: np.ndarray, frames: list[dict[str, object]]
+) -> int | None:
+    owner = None
+    for idx, frame in enumerate(frames):
+        r0, c0, r1, c1 = frame["bbox"]
+        inside = (
+            np.all(coords[:, 0] > r0)
+            and np.all(coords[:, 0] < r1)
+            and np.all(coords[:, 1] > c0)
+            and np.all(coords[:, 1] < c1)
