+
+def _render_case(specs: list[dict[str, object]]) -> tuple[np.ndarray, np.ndarray]:
+    gaps = [random.randint(1, 4) for _ in range(len(specs) - 1)]
+    left_margin = random.randint(0, 2)
+    right_margin = random.randint(0, 2)
