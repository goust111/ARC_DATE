import numpy as np, random
from collections import deque

def comps(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    out=[]
    for r in range(h):
        for c in range(w):
            if mask[r,c] and not seen[r,c]:
                q=deque([(r,c)]);seen[r,c]=1;pts=[]
                while q:
                    x,y=q.popleft();pts.append((x,y))
                    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                        nx,ny=x+dx,y+dy
                        if 0<=nx<h and 0<=ny<w and mask[nx,ny] and not seen[nx,ny]:
                            seen[nx,ny]=1;q.append((nx,ny))
                out.append(pts)
    return out

def shell(cav):
    h,w=cav.shape
    out=np.zeros((h+2,w+2),dtype=bool)
    for r in range(h):
        for c in range(w):
            if cav[r,c]:
                for dr in (-1,0,1):
                    for dc in (-1,0,1):
                        out[r+1+dr,c+1+dc]=True
    out[1:h+1,1:w+1] &= ~cav
    # Actually need keep border-only shell and cavity false
    shell=out.copy()
    shell[1:h+1,1:w+1][cav]=False
    return shell

def test(cav):
    sh=shell(cav)
    # components of shell should be 1
    if len(comps(sh))"'!=1:
        return False,'"'shell comps'
    # cavity not touching boundary in full canvas and only one interior bg comp
    bg=~sh
    h,w=sh.shape
    seen=np.zeros((h,w),dtype=bool)
    inside=[]
    for r in range(h):
        for c in range(w):
            if bg[r,c] and not seen[r,c]:
                q=deque([(r,c)]);seen[r,c]=1;pts=[];touch=False
                while q:
                    x,y=q.popleft();pts.append((x,y))
                    if x in (0,h-1) or y in (0,w-1): touch=True
                    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                        nx,ny=x+dx,y+dy
                        if 0<=nx<h and 0<=ny<w and bg[nx,ny] and not seen[nx,ny]:
                            seen[nx,ny]=1;q.append((nx,ny))
                if not touch: inside.append(pts)
    return (len(inside)==1 and set(inside[0])=={(r+1,c+1) for r,c in zip(*np.where(cav))}), len(inside)

# random connected cavity
for n in range(1,8):
    ok=0
    for _ in range(200):
        h=w=4
        cav=np.zeros((h,w),dtype=bool)
        cells=[(random.randrange(h),random.randrange(w))]
        cav[cells[0]]=1
        while cav.sum()<n:
            r,c=random.choice(list(zip(*np.where(cav))))
            opts=[]
            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                nr,nc=r+dr,c+dc
                if 0<=nr<h and 0<=nc<w and not cav[nr,nc]: opts.append((nr,nc))
            if not opts: continue
            cav[random.choice(opts)]=1
        good,res=test(cav)
        if good: ok+=1
        else:
            print('bad',n,res) ; print(cav.astype(int)); print(shell(cav).astype(int)); raise SystemExit
    print(n,ok)
