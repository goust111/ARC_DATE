+BG = 0
+BLUE = 1
+GREY = 5
+ORANGE = 7
+MAROON = 9
+
+NETWORK_COLORS = {GREY, ORANGE, BLUE}
+RESERVED_COLORS = {BG, BLUE, GREY, ORANGE, MAROON}
+SOURCE_COLORS = [2, 3, 4, 6, 8]
+
+GEN_RETRIES = 400
+LEAF_COUNT_CHOICES = [2, 3, 4]
+LEAF_COUNT_WEIGHTS = [3, 3, 2]
+FRAME_SIZES = [3, 4]
