+    color = int(comp["color"])
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+
+    if comp["area"] != int(border.sum()):
+        return False
+    if not np.all(patch[border] == color):
+        return False
+    if not np.all(patch[~border] == BG):
