+
+def _is_frame_component(grid: np.ndarray, comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+
+    color = int(comp["color"])
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+
+    if comp["area"] != int(border.sum()):
+        return False
+    if not np.all(patch[border] == color):
+        return False
+    if not np.all(patch[~border] == BG):
+        return False
+    return True
+
+
+def _has_hole(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    empty = ~mask
+    if not empty.any():
+        return False
+
+    seen = np.zeros((h, w), dtype=bool)
+    q = deque()
+    for r in range(h):
+        for c in range(w):
+            if r not in (0, h - 1) and c not in (0, w - 1):
+                continue
+            if empty[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c, h, w):
+            if empty[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
+
+    return bool(np.any(empty & ~seen))
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if len(pts) == 0:
+        return False
+
+    h, w = mask.shape
+    start_r, start_c = map(int, pts[0])
+    q = deque([(start_r, start_c)])
+    seen = np.zeros((h, w), dtype=bool)
+    seen[start_r, start_c] = True
+    count = 0
+
+    while q:
+        r, c = q.popleft()
+        count += 1
+        for nr, nc in _neighbors4(r, c, h, w):
+            if mask[nr, nc] and not seen[nr, nc]:
