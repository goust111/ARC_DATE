    return True


def _has_hole(mask: np.ndarray) -> bool:
    h, w = mask.shape
    empty = ~mask
    if not empty.any():
        return False

    seen = np.zeros((h, w), dtype=bool)
    q = deque()
    for r in range(h):
        for c in range(w):
            if r not in (0, h - 1) and c not in (0, w - 1):
                continue
            if empty[r, c] and not seen[r, c]:
                seen[r, c] = True
                q.append((r, c))

