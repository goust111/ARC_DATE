+        pos = _hit_source_candidate(
+            wall_cells,
+            source_positions,
+            used_rows,
+            used_cols,
+            contest["target"][1],
+            h,
+            w,
+        )
+        if pos is None:
+            return None
+        hit_positions.append(pos)
+        source_positions.add(pos)
+        used_rows.add(pos[0])
+        used_cols.add(pos[1])
