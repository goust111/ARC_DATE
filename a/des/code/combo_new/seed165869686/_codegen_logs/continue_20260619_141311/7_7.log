+
+
+def _hit_source_candidate(
+    wall_cells: set[tuple[int, int]],
+    source_positions: set[tuple[int, int]],
+    used_rows: set[int],
+    used_cols: set[int],
+    blocked_col: int,
+    h: int,
+    w: int,
+) -> tuple[int, int] | None:
+    walls = list(wall_cells)
