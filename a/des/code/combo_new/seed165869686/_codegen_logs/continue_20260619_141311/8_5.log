+        1: [(int(r), int(c + 1)) for r, c in ring if c == pw - 1],
+        2: [(int(r + 1), int(c)) for r, c in ring if r == ph - 1],
+        3: [(int(r), int(c - 1)) for r, c in ring if c == 0],
+    }
