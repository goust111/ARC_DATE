+    enclosed = []
+    for comp in bg_comps:
+        br0, bc0, br1, bc1 = map(int, comp["bbox"])
+        if br0 == 0 or bc0 == 0 or br1 == sub.shape[0] - 1 or bc1 == sub.shape[1] - 1:
+            continue
+        enclosed.append(comp)
