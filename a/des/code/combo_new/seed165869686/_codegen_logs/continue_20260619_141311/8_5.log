+        if r0 == 0 or c0 == 0 or r1 == h - 1 or c1 == w - 1:
+            continue
+        return True
+    return False
+
+
+def _is_rotation_asymmetric(mask: np.ndarray) -> bool:
+    base = np.asarray(mask, dtype=bool)
+    for turns in (1, 2, 3):
+        rot = _rotate_cw(base, turns)
+        if rot.shape == base.shape and np.array_equal(rot, base):
