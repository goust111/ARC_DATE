+        coords: list[tuple[int, int]] = []
+        while stack:
+            cr, cc2 = stack.pop()
+            coords.append((int(cr), int(cc2)))
+            for dr, dc in dirs:
+                nr = int(cr + dr)
+                nc = int(cc2 + dc)
+                if 0 <= nr < h and 0 <= nc < w and g[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
