+    if _get_bg(inp) != int(bg) or _get_bg(expected) != int(bg):
+        return None
+    if not np.array_equal(main(inp), expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_MAX_RETRIES):
+        grid = _build_case()
+        if grid is not None:
