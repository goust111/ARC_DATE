+        cs = [p[1] for p in coords]
+        comps.append(
+            {
+                "coords": coords,
+                "bbox": (min(rs), min(cs), max(rs), max(cs)),
+                "area": len(coords),
+            }
+        )
+    return comps
+
+
+def _mask_from_coords(coords: list[tuple[int, int]], shape: tuple[int, int]) -> np.ndarray:
