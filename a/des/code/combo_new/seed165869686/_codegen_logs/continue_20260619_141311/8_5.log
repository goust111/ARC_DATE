+    """
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    bg = _get_bg(g)
+    out = g.copy()
+
+    lock_comps = _components(g == int(OUTLINE_COLOR), connectivity=8)
+    assert lock_comps, "expected at least one grey lock"
+
+    locks: list[dict] = []
+    lock_id_by_cell: dict[tuple[int, int], int] = {}
+    for comp in lock_comps:
+        lock = {
+            "coords": comp["coords"],
+            "bbox": comp["bbox"],
