+    rs = [int(r) for r, _c in coords]
+    cs = [int(c) for _r, c in coords]
+    r0, c0, r1, c1 = min(rs), min(cs), max(rs), max(cs)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
