+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+RNG = np.random.default_rng()
+
+BG_COLOR = 0
+COLOR_POOL = (1, 2, 3, 4, 5, 6, 8, 9)
+ARC_MAX = 30
+MAX_GENERATION_ATTEMPTS = 400
+MAX_GROUP_ATTEMPTS = 200
