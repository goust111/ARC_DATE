+def _connected_components(mask: np.ndarray) -> list[dict]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            r0 = int(arr[:, 0].min())
+            c0 = int(arr[:, 1].min())
+            r1 = int(arr[:, 0].max())
+            c1 = int(arr[:, 1].max())
+            comps.append(
+                {
+                    "coords": arr,
+                    "bbox": (r0, c0, r1, c1),
+                    "area": int(len(coords)),
+                    "min_pos": min(coords),
+                }
+            )
+    return comps
+
+
+def _normalize_piece(coords: np.ndarray | list[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    arr = np.array(coords, dtype=int)
+    r0 = int(arr[:, 0].min())
+    c0 = int(arr[:, 1].min())
+    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in arr.tolist()))
+
