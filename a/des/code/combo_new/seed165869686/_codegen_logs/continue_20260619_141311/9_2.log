+
+def _infer_rectangle_dims(
+    pieces: list[tuple[tuple[int, int], ...]]
+) -> tuple[int, int]:
+    norm_pieces = tuple(sorted((tuple(sorted(piece)) for piece in pieces), key=lambda p: (-len(p), p)))
+    total_area = sum(len(piece) for piece in norm_pieces)
