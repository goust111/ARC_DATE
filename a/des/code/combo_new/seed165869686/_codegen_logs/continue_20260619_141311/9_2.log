+
+def _normalize_coords(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    shifted = sorted((int(r - r0), int(c - c0)) for r, c in coords)
+    return tuple(shifted)
+
+
+def _piece_shape(piece: tuple[tuple[int, int], ...]) -> tuple[int, int]:
