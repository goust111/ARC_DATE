+    full_mask = (1 << (rect_h * rect_w)) - 1
+    all_piece_bits = (1 << len(placements_by_piece)) - 1
+
+    @lru_cache(maxsize=None)
+    def search(used_mask: int, remaining_piece_bits: int) -> bool:
+        if remaining_piece_bits == 0:
+            return used_mask == full_mask
+
