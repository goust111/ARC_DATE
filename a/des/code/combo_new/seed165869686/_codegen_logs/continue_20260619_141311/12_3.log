+def _topological_order(edges: list[set[int]], tie_keys: list[tuple[int, int, int]]) -> list[int]:
+    indegree = [0] * len(edges)
+    for src, nbrs in enumerate(edges):
+        for dst in nbrs:
+            indegree[dst] += 1
