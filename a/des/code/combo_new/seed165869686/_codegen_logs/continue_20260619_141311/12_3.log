+    return [(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)]
+
+
+def _body_probe_cells(
+    marker_bbox: tuple[int, int, int, int], corner: str
+) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = marker_bbox
+    if corner == "tl":
+        return [(r0, c1 + 1), (r1, c1 + 1), (r1 + 1, c0), (r1 + 1, c1)]
+    if corner == "tr":
