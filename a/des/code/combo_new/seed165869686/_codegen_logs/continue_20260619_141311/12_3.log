+
+
+def _place_chain(rect_count: int) -> list[dict[str, int]] | None:
+    first = _rect_dict(0, 0, random.randint(RECT_SIDE_MIN, RECT_SIDE_MAX), random.randint(RECT_SIDE_MIN, RECT_SIDE_MAX))
