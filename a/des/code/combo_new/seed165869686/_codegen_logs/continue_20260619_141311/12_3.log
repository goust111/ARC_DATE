+
+
+def _shift_rects(rects: list[dict[str, int]]) -> tuple[list[dict[str, int]], tuple[int, int]] | None:
+    min_r = min(rect["bbox"][0] for rect in rects)
+    min_c = min(rect["bbox"][1] for rect in rects)
