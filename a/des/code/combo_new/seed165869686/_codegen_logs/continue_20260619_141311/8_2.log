+    missing: list[tuple[int, int]] = []
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            on_border = r in (r0, r1) or c in (c0, c1)
+            if not on_border:
+                continue
+            if (r, c) in coords:
