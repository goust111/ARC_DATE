+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GEN_RETRIES = 400
+GRID_MIN = 18
+GRID_MAX = 30
+FRAME_COUNT_RANGE = (2, 4)
+INNER_SIDE_RANGE = (3, 7)
+OBJECT_PAD = 1
