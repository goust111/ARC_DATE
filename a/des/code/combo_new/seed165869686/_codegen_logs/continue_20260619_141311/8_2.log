+    for frame in frames:
+        gap_h, gap_w = frame["gap_shape"]
+        matches = []
+        for idx, piece in enumerate(pieces):
+            if idx in used_piece_ids or int(piece["color"]) != int(frame["color"]):
+                continue
+            if tuple(piece["shape"]) != (int(gap_h), int(gap_w)):
