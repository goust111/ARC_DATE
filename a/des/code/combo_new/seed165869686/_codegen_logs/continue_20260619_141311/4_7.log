+            if int(g[r, c]) != int(bg):
+                continue
+            covering = [
+                tower
+                for tower in towers
+                if abs(r - tower["center"][0]) + abs(c - tower["center"][1]) <= int(tower["length"])
+            ]
+            if len(covering) < 2:
+                continue
+            top_length = max(int(tower["length"]) for tower in covering)
+            winners = sum(int(tower["length"]) == top_length for tower in covering)
+            if winners == 1:
