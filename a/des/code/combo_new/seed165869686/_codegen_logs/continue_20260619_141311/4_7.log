+import random
+
+import numpy as np
+
+
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+BG_COLOR = 0
+
+GEN_ATTEMPTS = 400
+PLACEMENT_ATTEMPTS = 250
+PAIR_ATTEMPTS = 500
