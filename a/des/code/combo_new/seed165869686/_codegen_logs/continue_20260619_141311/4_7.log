+    return _broadcast(g, towers, bg)
+
+
+def _paint_towers(shape: tuple[int, int], towers: list[dict], bg: int = BG_COLOR) -> np.ndarray:
+    grid = np.full(shape, int(bg), dtype=int)
+    for tower in towers:
+        for r, c in tower["pixels"]:
