+            return [tower_a, tower_b]
+        if mode == "tie_overlap" and summary["tie_overlap"] and not summary["unique_overlap"]:
+            return [tower_a, tower_b]
+
+    return None
+
+
+def _sample_lengths(mode: str, count: int) -> list[int]:
+    if mode == "strong_overlap":
