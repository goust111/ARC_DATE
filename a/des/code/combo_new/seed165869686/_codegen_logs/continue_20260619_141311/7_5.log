+                continue
+            color = int(g[start_r, start_c])
+            queue: deque[tuple[int, int]] = deque([(start_r, start_c)])
+            seen[start_r, start_c] = True
+            cells: list[tuple[int, int]] = []
+            r0 = r1 = start_r
+            c0 = c1 = start_c
+
+            while queue:
+                r, c = queue.popleft()
+                cells.append((r, c))
+                r0 = min(r0, r)
+                r1 = max(r1, r)
+                c0 = min(c0, c)
+                c1 = max(c1, c)
+                for nr, nc in _neighbors4(r, c):
