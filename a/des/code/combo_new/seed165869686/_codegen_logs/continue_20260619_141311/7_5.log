+            a = int(rect_ids[r, c])
+            b = int(rect_ids[r + 1, c])
+            if a != b:
+                neighbors[a].add(b)
+                neighbors[b].add(a)
+
+    for r in range(height):
+        for c in range(width - 1):
+            a = int(rect_ids[r, c])
+            b = int(rect_ids[r, c + 1])
+            if a != b:
