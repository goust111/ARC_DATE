+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+
+            expected_area = (r1 - r0 + 1) * (c1 - c0 + 1)
+            assert len(cells) == expected_area, "each color region must be a filled rectangle"
+            assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color), "rectangle bbox must be solid"
+
+            rect_id = len(rects)
