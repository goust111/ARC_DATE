+    cells: set[tuple[int, int, int]] = set()
+    if side == "top":
+        cursor = 0
+        for layer in layers:
+            sprite = layer["sprite"]
+            lh, lw = sprite.shape
+            left = (w - lw) // 2
+            for rr, cc in np.argwhere(sprite != BG):
+                cells.add((cursor + int(rr), left + int(cc), layer["color"]))
+            cursor += lh
+    elif side == "bottom":
+        cursor = h - 1
+        for layer in layers:
+            sprite = layer["sprite"]
+            lh, lw = sprite.shape
+            top = cursor - lh + 1
+            left = (w - lw) // 2
