+def _marker_side(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> str:
+    r0, c0, r1, c1 = bbox
+    mid_r = (r0 + r1) // 2
+    mid_c = (c0 + c1) // 2
+    sides = []
+    if r0 - 1 >= 0 and int(grid[r0 - 1, mid_c]) == MARKER:
+        sides.append("top")
+    if r1 + 1 < grid.shape[0] and int(grid[r1 + 1, mid_c]) == MARKER:
+        sides.append("bottom")
