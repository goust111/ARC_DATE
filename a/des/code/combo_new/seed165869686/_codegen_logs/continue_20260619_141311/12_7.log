+            return None
+        transformed = _arranged_cells_from_local(local, side)
+        for rr, cc, _ in transformed:
+            ar = bbox[0] + rr
+            ac = bbox[1] + cc
+            if not (0 <= ar < grid.shape[0] and 0 <= ac < grid.shape[1]):
+                return None
+
+    return grid
+
