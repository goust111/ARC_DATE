+        (int(r), int(c), int(local_grid[r, c]))
+        for r, c in np.argwhere(local_grid != BG)
+    }
+    output_cells = _arranged_cells_from_local(local_grid, side)
+    mid_r = h // 2
+    mid_c = w // 2
+    marker_by_side = {
+        "top": (-1, mid_c),
+        "bottom": (h, mid_c),
+        "left": (mid_r, -1),
+        "right": (mid_r, w),
+    }
