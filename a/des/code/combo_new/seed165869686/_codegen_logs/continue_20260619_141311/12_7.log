+    top = min_r - rng.randint(0, min(3, min_r))
+    left = min_c - rng.randint(0, min(3, min_c))
+    bottom = max_r + rng.randint(0, min(3, WORKSPACE - 1 - max_r))
+    right = max_c + rng.randint(0, min(3, WORKSPACE - 1 - max_c))
