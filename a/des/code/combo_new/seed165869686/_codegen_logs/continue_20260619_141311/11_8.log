                    if 0<=nx<h and 0<=ny<w and mask[nx,ny] and not seen[nx,ny]:
                        seen[nx,ny]=True; st.append((nx,ny))
            out.append(cc)
    return out

def make_core():
    H=W=10
    m=np.zeros((H,W),bool)
    h1=int(rng.integers(2,5)); w1=int(rng.integers(2,5))
    r1=int(rng.integers(2, H-h1-1)); c1=int(rng.integers(2, W-w1-1))
    m[r1:r1+h1,c1:c1+w1]=True
    for _ in range(int(rng.integers(1,4))):
