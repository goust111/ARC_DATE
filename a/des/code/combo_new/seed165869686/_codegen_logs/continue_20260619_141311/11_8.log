我找到一个更稳的生成思路：用“厚度为 2 的折线核心”做多次 4 邻域外扩，这样层数可以精确控制，外轮廓也比纯矩形更自然。先把这个方案跑一轮接受率。
exec
/bin/bash -lc "python - <<'PY'
import numpy as np
from numpy.random import default_rng

rng = default_rng(4)

def dilate(mask):
    p = np.pad(mask, 1, constant_values=False)
    return p[1:-1,1:-1] | p[:-2,1:-1] | p[2:,1:-1] | p[1:-1,:-2] | p[1:-1,2:]

def interior(mask):
    p = np.pad(mask, 1, constant_values=False)
    return mask & p[:-2,1:-1] & p[2:,1:-1] & p[1:-1,:-2] & p[1:-1,2:]

def peel(mask):
    dep = np.full(mask.shape,-1,int)
    cur = mask.copy()
    d=0
    while cur.any():
        fr = cur & ~interior(cur)
        if not fr.any():
            return None,None
        dep[fr]=d
        cur[fr]=False
        d+=1
    return dep,d

def comps(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,bool)
    out=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            st=[(r,c)]
            seen[r,c]=True
            cc=[]
            while st:
                x,y=st.pop(); cc.append((x,y))
                for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                    nx,ny=x+dx,y+dy
                    if 0<=nx<h and 0<=ny<w and mask[nx,ny] and not seen[nx,ny]:
                        seen[nx,ny]=True; st.append((nx,ny))
            out.append(cc)
    return out

def core(target):
    H=W=12
    m=np.zeros((H,W),bool)
    kind=int(rng.integers(0,4))
    if kind==0:  # horizontal bar
        w=int(rng.integers(2,6))
        m[5:7, 3:3+w]=True
    elif kind==1:  # vertical bar
        h=int(rng.integers(2,6))
        m[3:3+h, 5:7]=True
    elif kind==2:  # L
        h=int(rng.integers(3,7))
        w=int(rng.integers(3,7))
        m[5:7, 3:3+w]=True
        m[5:5+h, 3:5]=True
    else:  # step
        w1=int(rng.integers(2,5))
        w2=int(rng.integers(2,5))
        m[4:6, 2:2+w1]=True
        m[6:8, 4:4+w2]=True
    cells=np.argwhere(m)
    r0,c0=cells.min(0); r1,c1=cells.max(0)
    return m[r0:r1+1,c0:c1+1]

def make(target_layers):
    m=core(target_layers)
    for _ in range(target_layers-1):
        m=dilate(m)
    d,l=peel(m)
    if l "'!= target_layers:
        return None
    if any(len(comps(d==k))!=1 for k in range(l)):
        return None
    return m,d,l

for target in range(3,7):
    ok=0; sample=[]
    for i in range(1000):
        x=make(target)
        if x is not None:
            ok+=1
            if len(sample)<2:
                sample.append(x)
    print('"'target',target,'ok',ok)
    for m,d,l in sample:
        print('shape',m.shape)
        for r in range(m.shape[0]):
            print(''.join(str(d[r,c]) if m[r,c] else '.' for c in range(m.shape[1])))
        print()
