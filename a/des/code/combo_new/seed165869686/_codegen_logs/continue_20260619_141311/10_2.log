+        return [(near_r, near_c - i) for i in range(length)]
+    if direction == "left":
+        return [(near_r, near_c + i) for i in range(length)]
+    if direction == "down":
+        return [(near_r - i, near_c) for i in range(length)]
+    return [(near_r + i, near_c) for i in range(length)]
