+        grid[r, c] = color
+    for r, c in arrow:
+        grid[r, c] = RED
+
+    dr, dc = DIRS[direction]
+    dst_rr = src_rr + dr
+    dst_cc = src_cc + dc
+    dst_r0 = dst_rr * (region_h + 1)
+    dst_c0 = dst_cc * (region_w + 1)
+    target = {
+        (dst_r0 + r, dst_c0 + c)
+        for r, c in _target_cells(region_h, region_w, direction, near_r, near_c, length)
+    }
+    return band | arrow, target
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+
+    for _ in range(400):
