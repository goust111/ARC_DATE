+            continue
+
+        chosen = _choose_edges(rng, rows, cols)
+        if not chosen:
+            continue
+
+        grid = np.full((height, width), BLACK, dtype=int)
+        for rr in range(1, rows):
+            grid[rr * region_h + (rr - 1), :] = GREY
