+
+def _target_cells(
+    region_h: int,
+    region_w: int,
+    direction: str,
+    near_r: int,
+    near_c: int,
+    length: int,
+) -> list[tuple[int, int]]:
+    path = _snake_path(region_h, region_w, near_r, near_c, direction)
+    if length > len(path):
+        return []
+    return path[:length]
