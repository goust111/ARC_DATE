+        cells.append((near_r + tail_len + 1, near_c - 1))
+        cells.append((near_r + tail_len + 1, near_c + 1))
+    else:
+        assert direction == "up"
+        cells.extend((near_r - i, near_c) for i in range(1, tail_len + 3))
+        cells.append((near_r - tail_len - 1, near_c - 1))
+        cells.append((near_r - tail_len - 1, near_c + 1))
