+        src_r0, src_r1 = row_bounds[src_rr]
+        src_c0, src_c1 = col_bounds[src_cc]
+        dst_r0, dst_r1 = row_bounds[dst_rr]
+        dst_c0, dst_c1 = col_bounds[dst_cc]
