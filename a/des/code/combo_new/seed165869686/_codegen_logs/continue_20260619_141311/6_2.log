+    assert base <= total_width, "items do not fit"
+    extras = _split_slack(total_width - base, len(widths) + 1)
+    positions = []
+    x = extras[0]
+    for idx, width in enumerate(widths):
+        positions.append(x)
+        x += width
+        if idx != len(widths) - 1:
+            x += 1 + extras[idx + 1]
+    return positions
+
