+def _render_input(h: int, w: int, plans: list[dict[str, object]]) -> np.ndarray:
+    grid = np.full((h, w), BLACK, dtype=int)
+    for plan in plans:
+        _paint(grid, plan["wall"], GREY)
+        _paint(grid, plan["input_cells"], plan["color"])
