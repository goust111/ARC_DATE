+    for _ in range(200):
+        r0 = rng.randint(row_lo, row_hi)
+        c0 = rng.randint(col_lo, col_hi)
+        if _can_place(occupied, r0, c0, h, w):
+            _mark_placed(occupied, r0, c0, h, w)
