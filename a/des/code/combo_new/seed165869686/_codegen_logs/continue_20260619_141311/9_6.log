+def _place_box(occupied: np.ndarray, h: int, w: int, rng: random.Random) -> tuple[int, int] | None:
+    row_lo = OUTER_MARGIN
+    row_hi = occupied.shape[0] - OUTER_MARGIN - h
+    col_lo = OUTER_MARGIN
+    col_hi = occupied.shape[1] - OUTER_MARGIN - w
+    if row_hi < row_lo or col_hi < col_lo:
+        return None
