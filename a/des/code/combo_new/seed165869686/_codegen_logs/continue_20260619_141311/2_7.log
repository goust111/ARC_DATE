+def _component_coords(grid: np.ndarray, sr: int, sc: int, seen: np.ndarray) -> list[tuple[int, int]]:
+    color = int(grid[sr, sc])
+    q = deque([(sr, sc)])
+    seen[sr, sc] = True
+    coords: list[tuple[int, int]] = []
+    h, w = grid.shape
+
+    while q:
+        r, c = q.popleft()
+        coords.append((r, c))
+        for dr, dc in NEIGHBORS4:
+            nr = r + dr
