        "outer_w": inner_w + 2,
        "top": top,
        "bottom": bottom,
        "left": left,
        "right": right,
    }


def _layout_specs(
    specs: list[dict[str, int | str]], rng: np.random.Generator
) -> tuple[int, int, list[tuple[dict[str, int | str], int, int]]] | None:
    count = len(specs)
    for _ in range(120):
        order = list(specs)
        rng.shuffle(order)
        row_count = int(rng.integers(1, min(3, count) + 1))
