        idx = 0
        for size in row_sizes:
            groups.append(order[idx : idx + size])
            idx += size

        row_data: list[dict[str, object]] = []
        total_w = 0
        total_h = 0
        between_rows: list[int] = []

        for row_idx, group in enumerate(groups):
