+def _observed_row_color(row: np.ndarray) -> int | None:
+    visible = row[(row != BLACK) & (row != GRAY)]
+    if visible.size == 0:
+        return None
+    colors = np.unique(visible)
+    assert colors.size == 1, "each stripe row must have a single visible stripe color"
+    return int(colors[0])
+
