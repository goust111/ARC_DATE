+BLACK = 0
+GRAY = 5
+STRIPE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+PERIOD_CHOICES = (2, 3, 4)
+MASK_COUNT_CHOICES = (1, 2, 3)
+GEN_RETRIES = 400
