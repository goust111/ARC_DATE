+    if seq_len == 4:
+        n_objects = rng.choice([2, 3])
+        size_min = 27
+    elif seq_len == 3:
+        n_objects = rng.choice([2, 3, 4])
+        size_min = 24
+    else:
+        n_objects = rng.choice([2, 3, 4])
+        size_min = 20
+
