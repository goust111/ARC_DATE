+    if gap_dir is not None:
+        dr, dc = GAP_OFFSETS[gap_dir](size)
+        grid[r0 + dr, c0 + dc] = BG
+
+
+def _paint_ring(grid: np.ndarray, r0: int, c0: int, layers: int, colors: tuple[int, ...], gap_dir: str) -> None:
+    outer_size = 4 * layers - 1
+    for idx in range(layers):
