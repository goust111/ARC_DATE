+    objects.sort(key=lambda obj: obj["size"], reverse=True)
+    for obj in objects:
+        positions = _candidate_positions(occupied, obj["size"])
+        if not positions:
+            return None
+        r0, c0 = rng.choice(positions)
+        obj["r0"] = r0
+        obj["c0"] = c0
+        occupied[r0 - 1 : r0 + obj["size"] + 1, c0 - 1 : c0 + obj["size"] + 1] = True
