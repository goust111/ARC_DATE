+
+    counts = Counter(obj["direction"] for obj in objects)
+    assert all(count == 1 for count in counts.values())
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
