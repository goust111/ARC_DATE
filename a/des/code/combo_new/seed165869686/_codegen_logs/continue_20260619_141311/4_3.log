+            vr0 = random.randint(1, vr0_hi)
+        else:
+            vr0_lo = y + 2
+            vr0_hi = height - vh - 1
+            if vr0_lo > vr0_hi:
+                continue
+            vr0 = random.randint(vr0_lo, vr0_hi)
