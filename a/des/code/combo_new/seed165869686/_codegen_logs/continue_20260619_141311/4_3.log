+BG = 0
+WALL = 5
+BULB_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+SIDES = ("top", "bottom", "left", "right")
+ROOM_H_RANGE = (4, 8)
+ROOM_W_RANGE = (4, 8)
+GRID_RANGE = (16, 28)
