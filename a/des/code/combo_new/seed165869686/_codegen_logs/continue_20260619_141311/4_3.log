+    if side == "top":
+        door = (r0, c0 + door_offset)
+    elif side == "bottom":
+        door = (r1, c0 + door_offset)
+    elif side == "left":
+        door = (r0 + door_offset, c0)
+    else:
+        door = (r0 + door_offset, c1)
+
+    interior_rows = list(range(r0 + 1, r1))
+    interior_cols = list(range(c0 + 1, c1))
+    if side in ("left", "right") and random.random() < 0.5:
+        bulb_r = door[0]
+    else:
