+            hc0 = random.randint(1, hc0_hi)
+        else:
+            hc0_lo = x + 2
+            hc0_hi = width - hw - 1
+            if hc0_lo > hc0_hi:
+                continue
+            hc0 = random.randint(hc0_lo, hc0_hi)
+
+        if vert_side == "bottom":
+            vr0_hi = y - vh - 1
+            if vr0_hi < 1:
