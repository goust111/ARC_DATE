+                        continue
+                    if _rect_sum(bulb_ps, r0 + 1, c0 + 1, r1 - 1, c1 - 1) != 1:
+                        continue
+
+                    top = _rect_sum(wall_ps, r0, c0, r0, c1)
+                    bottom = _rect_sum(wall_ps, r1, c0, r1, c1)
+                    left = _rect_sum(wall_ps, r0, c0, r1, c0)
+                    right = _rect_sum(wall_ps, r0, c1, r1, c1)
