+                            continue
+                        door = (door_rows[0], c0)
+                    else:
+                        door_rows = [r for r in range(r0 + 1, r1) if int(g[r, c1]) != WALL]
+                        if len(door_rows) != 1 or int(g[door_rows[0], c1]) != BG:
+                            continue
+                        door = (door_rows[0], c1)
