+                        "side": side,
+                        "door": door,
+                        "bulb": bulb,
+                        "color": int(g[bulb]),
+                    }
+                    prev = best_by_bulb.get(bulb)
+                    if prev is None or box_h * box_w < (prev["bbox"][2] - prev["bbox"][0] + 1) * (
+                        prev["bbox"][3] - prev["bbox"][1] + 1
+                    ):
+                        best_by_bulb[bulb] = candidate
