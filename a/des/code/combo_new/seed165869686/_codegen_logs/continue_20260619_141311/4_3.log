+            if placed is None:
+                continue
+            forced_rooms, protected = placed
+            rooms.extend(forced_rooms)
+            used.extend(room["bbox"] for room in forced_rooms)
+            next_color = 2
+        elif mode == "cross":
+            placed = _place_cross(height, width, (colors[0], colors[1]))
+            if placed is None:
