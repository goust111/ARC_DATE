+
+def _place_islands(inner_h: int, inner_w: int, count: int) -> list[set[tuple[int, int]]] | None:
+    shape_pool = ISLAND_SHAPES_SMALL if count >= 3 else ISLAND_SHAPES_LARGE
+    for _ in range(80):
