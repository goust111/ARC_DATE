+        labels, comps = _label_components(scene != color)
+        interior_count = 0
+        interior_area = 0
+        for comp_id, coords in enumerate(comps, start=1):
+            if _touches_border(coords, scene.shape):
+                continue
+            rr, cc = coords[:, 0], coords[:, 1]
+            if not np.any(scene[rr, cc] == bg):
