+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(np.min(coords[:, 0])),
+        int(np.min(coords[:, 1])),
+        int(np.max(coords[:, 0])),
+        int(np.max(coords[:, 1])),
+    )
+
+
+def _touches_border(coords: np.ndarray, shape: tuple[int, int]) -> bool:
