+
+
+def _touches_border(coords: np.ndarray, shape: tuple[int, int]) -> bool:
+    h, w = shape
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return bool(
+        np.any(rows == 0)
+        or np.any(cols == 0)
+        or np.any(rows == h - 1)
+        or np.any(cols == w - 1)
+    )
+
+
+def _row_runs(active: np.ndarray) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    r = 0
+    while r < len(active):
+        if not active[r]:
+            r += 1
+            continue
+        start = r
+        while r + 1 < len(active) and active[r + 1]:
