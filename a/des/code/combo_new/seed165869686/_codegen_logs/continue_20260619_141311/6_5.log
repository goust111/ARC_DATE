+    regions = _region_cells(r_lines, c_lines)
+
+    counts = [int(rng.integers(1, 6)) for _ in regions]
+    if len(regions) > 1 and len(set(counts)) == 1:
+        counts[0] = 1 + (counts[0] % 5)
+    colors = [int(rng.choice(GEN_MARKER_COLORS)) for _ in regions]
