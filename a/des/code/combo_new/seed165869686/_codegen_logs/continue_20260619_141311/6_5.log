+        for j in range(len(c_lines) - 1):
+            rows = range(r_lines[i] + 1, r_lines[i + 1])
+            cols = range(c_lines[j] + 1, c_lines[j + 1])
+            regions.append([(r, c) for r in rows for c in cols])
+    return regions
+
