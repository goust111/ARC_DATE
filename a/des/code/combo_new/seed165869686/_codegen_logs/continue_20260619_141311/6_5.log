+    open_mask = (grid != GREY) & ~blocked
+    regions: list[list[tuple[int, int]]] = []
+    for comp in _components(open_mask):
+        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in comp):
+            continue
+        regions.append(comp)
+    return regions
