+
+
+def _legend_dims(sample_c0: int) -> tuple[int, int]:
+    inner_h = LEGEND_ROW_COUNT * LEGEND_ROW_H + (LEGEND_ROW_COUNT - 1) * LEGEND_ROW_GAP
+    inner_w = sample_c0 + LEGEND_SAMPLE_W
+    return inner_h + 2, inner_w + 2
