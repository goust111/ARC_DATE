+        c_max = w - net_w - 1
+    else:
+        c_min = 1
+        c_max = lc0 - net_w - 2
+    if c_min > c_max:
+        return None
+
+    r_min = 1
+    r_max = h - net_h - 1
+    if r_min > r_max:
+        return None
+
+    return int(rng.integers(r_min, r_max + 1)), int(rng.integers(c_min, c_max + 1))
