+def _draw_network(
+    grid: np.ndarray,
+    r0: int,
+    c0: int,
+    row_spans: list[int],
+    col_spans: list[int],
+) -> tuple[list[int], list[int]]:
+    r_lines = _line_positions(r0, row_spans)
+    c_lines = _line_positions(c0, col_spans)
+    for rr in r_lines:
+        grid[rr, c0 : c_lines[-1] + 1] = GREY
+    for cc in c_lines:
