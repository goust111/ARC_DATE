+
+def _draw_legend(
+    grid: np.ndarray,
+    corner: str,
+    sample_c0: int,
+    count_to_pattern: dict[int, np.ndarray],
+    row_order: list[int],
+) -> tuple[int, int, int, int]:
+    legend_h, legend_w = _legend_dims(sample_c0)
+    if corner == "tl":
