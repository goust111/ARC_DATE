 154: def _connected_mask(height: int, width: int, target_area: int) -> np.ndarray | None:
 155:     """Grow a connected mask with full row/column span to the target area."""
 156:     mask = np.zeros((int(height), int(width)), dtype=bool)
 157:     steps = ["D"] * (int(height) - 1) + ["R"] * (int(width) - 1)
 158:     random.shuffle(steps)
 159: 
 160:     r = c = 0
 161:     mask[r, c] = True
 162:     for step in steps:
 163:         if step == "D":
 164:             r += 1
 165:         else:
 166:             c += 1
 167:         mask[r, c] = True
 168: 
 169:     if int(mask.sum()) > int(target_area):
 170:         return None
 171: 
 172:     frontier: set[tuple[int, int]] = set()
 173: 
 174:     def add_frontier(rr: int, cc: int) -> None:
 175:         for nr, nc in _neighbors4(rr, cc, int(height), int(width)):
 176:             if not mask[nr, nc]:
 177:                 frontier.add((int(nr), int(nc)))
 178: 
 179:     for rr, cc in np.argwhere(mask):
 180:         add_frontier(int(rr), int(cc))
 181: 
 182:     while int(mask.sum()) < int(target_area):
 183:         if not frontier:
 184:             return None
 185:         cell = random.choice(tuple(frontier))
 186:         frontier.remove(cell)
 187:         rr, cc = cell
 188:         mask[rr, cc] = True
 189:         add_frontier(rr, cc)
 190: 
 191:     return mask
