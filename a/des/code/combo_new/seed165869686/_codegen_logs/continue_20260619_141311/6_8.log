  63:             divider_mask[:, int(c)] = True
  64: 
  65:     left_cols = (np.arange(W)[None, :] < int(fc0))
  66: 
  67:     # --- sprites: per-color 8-connected components in left area (excluding divider) ---
  68:     sprites = []
