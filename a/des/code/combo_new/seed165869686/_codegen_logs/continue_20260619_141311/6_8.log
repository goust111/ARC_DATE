+    if side == "down":
+        return r - 1, c
+    if side == "left":
+        return r, c + 1
+    return r, c - 1
+
+
+def _sample_notches(height: int, width: int, direction: str, holes: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    candidates = []
+    for side in DIR_ORDER:
+        if side == direction:
