 176: def main(grid: np.ndarray) -> np.ndarray:
 177:     """
 178:     Fill each gapped rectangular frame with a rotated and scaled copy of the loose template.
 179: 
 180:     Input structure:
 181:     - The background is black.
 182:     - The grid contains one small standalone multicolor template pattern.
 183:     - It also contains several one-pixel-thick rectangular frames whose interiors are black, and each frame has one continuous gap on exactly one side.
 184: 
 185:     Rule:
 186:     - Detect each rectangular frame and identify which side contains the gap.
 187:     - Rotate the template by the gap side: top -> 0 degrees, right -> 90 degrees clockwise, bottom -> 180 degrees, left -> 90 degrees counterclockwise.
 188:     - Count the gap width and use that value as the integer block-scaling factor for the rotated template.
 189:     - Center the scaled template inside the frame interior and paint it there, leaving the rest of the grid unchanged.
 190: 
 191:     Key insight:
 192:     - The gap encodes two visible signals at once: its side chooses the rotation, and its length chooses the scale.
 193:     """
 194:     g = np.asarray(grid, dtype=int)
 195:     assert g.ndim == 2
 196: 
 197:     comps = _components(g != 0)
 198:     frame_infos: list[dict[str, object]] = []
 199:     template_comps: list[list[tuple[int, int]]] = []
 200: 
 201:     for comp in comps:
 202:         info = _parse_frame(g, comp)
 203:         if info is None:
 204:             template_comps.append(comp)
 205:         else:
 206:             frame_infos.append(info)
 207: 
 208:     assert frame_infos, "expected at least one gapped frame"
 209:     assert len(template_comps) == 1, "expected exactly one standalone template"
 210: 
 211:     tr0, tc0, tr1, tc1 = _bbox(template_comps[0])
 212:     template = g[tr0 : tr1 + 1, tc0 : tc1 + 1].copy()
