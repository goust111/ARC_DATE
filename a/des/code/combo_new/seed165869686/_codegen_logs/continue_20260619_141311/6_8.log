 185: def main(grid: np.ndarray) -> np.ndarray:
 186:     """Fit each scattered colored fragment into the unique grey mold cavity with the same shape up to rotation or reflection.
 187: 
 188:     Input structure:
 189:     - The background is black.
 190:     - Several grey rectangular mold components each contain one enclosed black cavity.
 191:     - Outside the molds, several colored 4-connected fragments appear on the background.
 192: 
 193:     Rule:
 194:     - Extract every mold cavity as a normalized shape.
 195:     - Match each outside fragment to the unique cavity with the same shape under the 8 dihedral transforms.
 196:     - Erase the fragment from its source location and paint its color into the matched cavity.
 197:     - Keep the remaining grey mold pixels and all other background pixels unchanged.
 198: 
 199:     Key insight:
 200:     - Fragment-to-cavity correspondence is determined purely by shape equivalence under rotation and reflection, not by color or position.
 201:     """
 202:     g = np.asarray(grid, dtype=int)
 203:     assert g.ndim == 2 and g.size > 0
 204:     bg = _most_common_color(g)
 205: 
 206:     molds = _find_molds(g, bg)
 207:     assert molds, "expected at least one mold"
 208: 
 209:     pieces = _find_pieces(g, bg, molds)
 210:     assert pieces, "expected at least one piece"
 211:     assert len(pieces) == len(molds), "pieces and cavities must pair one-to-one"
 212: 
 213:     hole_by_signature: dict[tuple[int, int, tuple[int, ...]], dict] = {}
 214:     for mold in molds:
 215:         sig = _canonical_signature(mold["hole_mask"])
 216:         assert sig not in hole_by_signature, "cavity shapes must be uniquely matchable"
 217:         hole_by_signature[sig] = mold
 218: 
 219:     out = g.copy()
 220:     for piece in pieces:
 221:         out[piece["coords"][:, 0], piece["coords"][:, 1]] = bg
 222: 
 223:     used_holes: set[tuple[int, int, int, int]] = set()
 224:     for piece in pieces:
 225:         sig = piece["canon"]
 226:         assert sig in hole_by_signature, "piece shape must match a cavity"
 227:         mold = hole_by_signature[sig]
 228:         hole_bbox = mold["hole_bbox"]
 229:         assert hole_bbox not in used_holes, "multiple pieces cannot use the same cavity"
