+                count += 1
+                if cr in (0, h - 1) or cc in (0, w - 1):
+                    touches_edge = True
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if bool(empty[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            if not touches_edge:
+                total += count
+    return int(total)
+
+
+def _pointer_direction(pointer_rel: tuple[int, int], shape: tuple[int, int]) -> str:
+    pr, pc = pointer_rel
+    h, w = shape
+    sides = []
+    if pr == 0:
+        sides.append("up")
+    if pr == h - 1:
+        sides.append("down")
+    if pc == 0:
+        sides.append("left")
+    if pc == w - 1:
+        sides.append("right")
