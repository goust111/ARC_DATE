+
+
+def _side_cells(height: int, width: int, side: str) -> list[tuple[int, int]]:
+    if side == "up":
+        return [(0, c) for c in range(1, width - 1)]
+    if side == "down":
+        return [(height - 1, c) for c in range(1, width - 1)]
+    if side == "left":
