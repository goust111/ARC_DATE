+
+def _make_object(direction: str, body_color: int, pointer_color: int) -> dict[str, object] | None:
+    for _ in range(80):
+        repeats = random.randint(*GEN_REPEAT_COUNT)
+        max_h = GEN_SHAPE_SIDE[1]
+        max_w = GEN_SHAPE_SIDE[1]
+        if direction in ("left", "right"):
