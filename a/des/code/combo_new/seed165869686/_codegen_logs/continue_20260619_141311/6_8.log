 216:         side = str(info["side"])
 217:         scale = int(info["gap_width"])
 218:         bbox = info["bbox"]
 219:         rotated = np.rot90(template, ROTATION_K[side])
 220:         scaled = _scale_pattern(rotated, scale)
 221:         _fill_frame(out, bbox, scaled)
 222: 
 223:     return out
