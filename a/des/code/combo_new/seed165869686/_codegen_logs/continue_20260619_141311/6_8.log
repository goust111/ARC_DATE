+def _trail_geometry(height: int, width: int, direction: str, repeats: int) -> tuple[tuple[int, int], tuple[int, int]]:
+    if direction == "right":
+        return (height, width * (repeats + 1)), (0, 0)
+    if direction == "left":
+        return (height, width * (repeats + 1)), (0, width * repeats)
+    if direction == "down":
