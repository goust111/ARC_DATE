+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BG = 0
+DIR_ORDER = ("up", "down", "left", "right")
+DIR_TO_VEC = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+GEN_ATTEMPTS = 400
+GEN_OBJECT_COUNT = (2, 3)
+GEN_SHAPE_SIDE = (4, 6)
+GEN_REPEAT_COUNT = (1, 4)
+GEN_TRAIL_LIMIT = 20
+GEN_GAP = 1
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((int(cr), int(cc)))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _hole_pixel_count(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    empty = ~mask
+    seen = np.zeros((h, w), dtype=bool)
+    total = 0
+    for r in range(h):
+        for c in range(w):
+            if not bool(empty[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            count = 0
+            touches_edge = False
+            while stack:
+                cr, cc = stack.pop()
+                count += 1
+                if cr in (0, h - 1) or cc in (0, w - 1):
+                    touches_edge = True
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if bool(empty[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            if not touches_edge:
+                total += count
+    return int(total)
+
+
+def _pointer_direction(pointer_rel: tuple[int, int], shape: tuple[int, int]) -> str:
+    pr, pc = pointer_rel
+    h, w = shape
+    sides = []
+    if pr == 0:
+        sides.append("up")
+    if pr == h - 1:
+        sides.append("down")
+    if pc == 0:
+        sides.append("left")
+    if pc == w - 1:
