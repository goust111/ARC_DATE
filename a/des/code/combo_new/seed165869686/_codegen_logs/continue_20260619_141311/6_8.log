  70: def main(grid: np.ndarray) -> np.ndarray:
  71:     """
  72:     Reorder the vertical color-major blocks while preserving every block's internal pixels.
  73: 
  74:     Input structure
  75:     The grid is divided into vertical blocks, each with a unique dominant color.
  76:     Small marker pixels from other block colors may appear inside the blocks.
  77: 
  78:     Rule
  79:     If adjacent shared-color marker rows read exactly as the current block order
  80:     from right to left, reverse the blocks. Otherwise move the leftmost block to
  81:     the far right and shift the remaining blocks left.
  82: 
  83:     Key insight
  84:     The transformation acts on whole vertical blocks, so marker pixels move with
  85:     their source block instead of being recolored or independently rearranged.
  86:     """
  87:     g = np.asarray(grid, dtype=int)
  88:     assert g.ndim == 2, "expected a 2D grid"
  89: 
  90:     blocks = _vertical_blocks(g)
  91:     order = _block_order(g, blocks)
  92:     assert sorted(order) == list(range(len(blocks))), "block order must be a permutation"
  93: 
  94:     return np.concatenate([g[:, blocks[i][0] : blocks[i][1]] for i in order], axis=1)
