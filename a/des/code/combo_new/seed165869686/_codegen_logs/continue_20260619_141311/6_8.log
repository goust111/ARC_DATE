+                "direction": spec["direction"],
+                "repeats": spec["repeats"],
+                "body_color": spec["body_color"],
+                "top": top,
+                "left": left,
+                "height": spec["height"],
+                "width": spec["width"],
+                "rel_cells": [tuple(map(int, cell)) for cell in np.argwhere(spec["mask"]).tolist()],
+            }
+        )
