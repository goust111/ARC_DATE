+
+def _extract_structure(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    bg = _mode_color(g)
+    H, W = g.shape
+
+    candidates = []
+    for ih in range(1, H - 1):
+        if (H - 1) % (ih + 1) != 0:
+            continue
+        for iw in range(1, W - 1):
+            candidate = _try_parse_structure(g, bg, ih, iw)
