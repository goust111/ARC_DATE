+            return {
+                "color": int(color),
+                "tip": tip,
+                "dir": str(dir_key),
+                "arrow_cells": tuple(arrow_cells),
+                "path_cells": tuple(path_cells),
+                "wall_cells": tuple(sorted(wall_cells)),
+            }
