+        return segment
+    return None
+
+
+def _route_signature(
+    shape: tuple[int, int],
+    wall_map: dict[tuple[int, int], str],
+    arrow_cells: set[tuple[int, int]],
+    tip: tuple[int, int],
+    dir_key: str,
