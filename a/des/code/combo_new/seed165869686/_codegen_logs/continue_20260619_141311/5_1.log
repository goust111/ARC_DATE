+def _tile_pattern(mask: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    rows = np.arange(shape[0])[:, None] % 3
+    cols = np.arange(shape[1])[None, :] % 3
+    return mask[rows, cols]
