+    if sr == 0 and sc == 0:
+        return "top_left", seed_color
+    if sr == 0 and sc == inner.shape[1] - 1:
+        return "top_right", seed_color
+    if sr == inner.shape[0] - 1 and sc == 0:
+        return "bottom_left", seed_color
+    if sr == inner.shape[0] - 1 and sc == inner.shape[1] - 1:
