+            max_len_col = hit[1] if direction[1] == 1 else shape[1] - 1 - hit[1]
+            max_len = int(min(max_len_row, max_len_col))
+            if max_len < 2:
+                continue
+            lengths = list(range(2, max_len + 1))
+            random.shuffle(lengths)
