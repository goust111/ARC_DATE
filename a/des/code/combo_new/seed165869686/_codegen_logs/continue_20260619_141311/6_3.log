+def _cells_touch_occupied(cells: list[tuple[int, int]], occupied: set[tuple[int, int]]) -> bool:
+    cell_set = set(cells)
+    for r, c in cells:
+        for nr in range(r - 1, r + 2):
+            for nc in range(c - 1, c + 2):
+                if (nr, nc) in occupied and (nr, nc) not in cell_set:
+                    return True
+    return False
+
