+    r1, c1 = points.max(axis=0)
+    mask = np.zeros((int(r1 - r0 + 1), int(c1 - c0 + 1)), dtype=bool)
+    mask[points[:, 0] - r0, points[:, 1] - c0] = True
+    return (int(r0), int(c0), int(r1), int(c1)), mask
+
