+import random
+
+import numpy as np
+
+
+BG = 0
+GEN_RETRIES = 400
+OBJECT_RETRIES = 200
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.asarray(pts, dtype=int))
+    return comps
+
+
+def _tight_mask(points: np.ndarray) -> tuple[tuple[int, int, int, int], np.ndarray]:
+    r0, c0 = points.min(axis=0)
+    r1, c1 = points.max(axis=0)
+    mask = np.zeros((int(r1 - r0 + 1), int(c1 - c0 + 1)), dtype=bool)
+    mask[points[:, 0] - r0, points[:, 1] - c0] = True
+    return (int(r0), int(c0), int(r1), int(c1)), mask
+
+
+def _count_holes(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    holes = 0
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            touches_border = r in (0, h - 1) or c in (0, w - 1)
+            while stack:
+                cr, cc = stack.pop()
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        if nr in (0, h - 1) or nc in (0, w - 1):
+                            touches_border = True
+                        stack.append((nr, nc))
+            if not touches_border:
+                holes += 1
+    return holes
+
+
+def _find_header(grid: np.ndarray) -> tuple[int, list[int], int]:
+    h, w = grid.shape
+    best = None
+    for sep_row in range(1, h):
+        row = grid[sep_row]
+        uniq = np.unique(row)
+        if len(uniq) != 1 or int(uniq[0]) == BG:
+            continue
+        legend_row = grid[sep_row - 1]
+        cols = [int(c) for c in np.flatnonzero(legend_row != BG)]
+        if len(cols) < 2:
+            continue
