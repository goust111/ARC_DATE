    if len(uniq) "'!= 1:
        return None
    return uniq[0][1]


def valid(mask, protr, side, depth):
    if not protr.any():
        return False
    h, w = mask.shape
    area = int(protr.sum())
    if area > 6:
        return False
    coords = np.argwhere(protr)
    comps = component_coords(protr)
    if len(comps) != 1:
        return False
    if side == '"'top':
        if not protr[0, :].any() or area >= depth * w:
            return False
        contact = np.where(protr[depth - 1, :])[0]
    elif side == 'bottom':
        if not protr[h - 1, :].any() or area >= depth * w:
            return False
        contact = np.where(protr[h - depth, :])[0]
    elif side == 'left':
        if not protr[:, 0].any() or area >= depth * h:
            return False
        contact = np.where(protr[:, depth - 1])[0]
    else:
        if not protr[:, w - 1].any() or area >= depth * h:
            return False
        contact = np.where(protr[:, w - depth])[0]
    if contact.size == 0 or contact.size > 3:
        return False
    return np.all(np.diff(contact) == 1) if contact.size > 1 else True


def solve(grid):
    g = np.asarray(grid, dtype=int)
    vals, counts = np.unique(g, return_counts=True)
    bg = int(vals[np.argmax(counts)])
    non = g[g "'!= bg]
    wall = int(Counter(map(int, non)).most_common(1)[0][0])
    out = g.copy()
    keys = []
    for color in np.unique(g):
        color = int(color)
        if color in (bg, wall):
            continue
        for comp in component_coords(g == color):
            shape = normalize_coords(comp)
