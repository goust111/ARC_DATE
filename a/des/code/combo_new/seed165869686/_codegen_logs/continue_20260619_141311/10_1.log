            keys.append({'"'color': color, 'coords': comp, 'rots': rots})
    holes = []
    for comp in component_coords(g == bg):
        if np.any(comp[:,0] == 0) or np.any(comp[:,0] == g.shape[0]-1) or np.any(comp[:,1] == 0) or np.any(comp[:,1] == g.shape[1]-1):
            continue
        shape = extract_lock_shape(comp)
        if shape is not None:
            holes.append({'coords': comp, 'shape': shape})
    used = set()
    for key in keys:
        match = None
        for i, hole in enumerate(holes):
            if i in used:
                continue
            if hole['shape'] in key['rots']:
                if match is not None:
                    match = None
                    break
                match = i
        if match is None:
            continue
        used.add(match)
        out[key['coords'][:,0], key['coords'][:,1]] = bg
        out[holes[match]['coords'][:,0], holes[match]['coords'][:,1]] = key['color']
    return out


def gen_once():
    matched = random.randint(1, 3)
