+    unique_candidates: list[tuple[tuple[int, int], ...]] = []
+    seen = set()
+    for candidate in candidates:
+        if candidate in seen:
+            continue
+        seen.add(candidate)
+        unique_candidates.append(candidate)
+    return unique_candidates[0] if len(unique_candidates) == 1 else None
