+def _count_gray_segments(data: np.ndarray) -> int:
+    mask = np.asarray(data == GRAY, dtype=bool)
+    if mask.size == 0 or not bool(mask.any()):
+        return 0
+    starts = mask.copy()
+    starts[1:] &= ~mask[:-1]
+    return int(starts.sum())
