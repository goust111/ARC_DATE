+
+def _cells_are_isolated(occupied: np.ndarray, cells: list[tuple[int, int]]) -> bool:
+    own = set((int(r), int(c)) for r, c in cells)
+    for r, c in own:
+        for nr in range(int(r) - 1, int(r) + 2):
+            for nc in range(int(c) - 1, int(c) + 2):
