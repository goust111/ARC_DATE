+
+GEN_RETRIES = 400
+
+
+def _blocked_positions(blocked: np.ndarray, mask: np.ndarray, rng: random.Random) -> list[tuple[int, int]]:
+    h, w = blocked.shape
+    mh, mw = mask.shape
+    positions = [
+        (r0, c0)
+        for r0 in range(1, h - mh)
+        for c0 in range(1, w - mw)
