+import random
+from collections import deque
+
+import numpy as np
+
+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+BG = 0
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _tight_mask(points: list[tuple[int, int]]) -> tuple[np.ndarray, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in points:
+        mask[r - r0, c - c0] = True
+    return mask, r0, c0
+
+
+def _hole_count(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    holes = 0
+    for pts in _components(~mask):
+        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):
+            continue
+        holes += 1
+    return holes
+
+
+def _contour_cells(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    out: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            for dr, dc in DIR4:
+                nr, nc = r + dr, c + dc
+                if not (0 <= nr < h and 0 <= nc < w) or not mask[nr, nc]:
+                    out.append((r, c))
+                    break
+    return out
+
+
+def _crop(mask: np.ndarray) -> np.ndarray:
+    pts = np.argwhere(mask)
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return mask[r0 : r1 + 1, c0 : c1 + 1]
+
+
+def _flip_mask(mask: np.ndarray, rng: random.Random) -> np.ndarray:
+    out = mask
