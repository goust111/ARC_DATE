+        local_mask, r0, c0 = _tight_mask(pts)
+        holes = _hole_count(local_mask)
+        if not (0 <= holes < len(legend_colors)):
+            continue
+        contour_color = int(legend_colors[holes])
+        for lr, lc in _contour_cells(local_mask):
+            out[r0 + lr, c0 + lc] = contour_color
+    return out
