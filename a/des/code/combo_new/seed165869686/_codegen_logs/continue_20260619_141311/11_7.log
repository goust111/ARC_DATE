+    lr0, lc0 = legend_pts.min(axis=0)
+    lr1, lc1 = legend_pts.max(axis=0)
+    blocked[max(0, lr0 - 1) : min(h, lr1 + 2), max(0, lc0 - 1) : min(w, lc1 + 2)] = True
+
+    object_count = rng.randint(2, min(5, legend_len + 2))
