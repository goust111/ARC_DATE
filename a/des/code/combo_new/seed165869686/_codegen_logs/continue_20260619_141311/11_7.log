+
+
+def _make_hole_counts(count: int, max_holes: int, rng: random.Random) -> list[int]:
+    values = [0, rng.randint(1, max_holes)]
+    while len(values) < count:
+        values.append(rng.randint(0, max_holes))
+    rng.shuffle(values)
+    return values
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rng = random.Random()
+    h = rng.randint(16, 30)
+    w = rng.randint(16, 30)
