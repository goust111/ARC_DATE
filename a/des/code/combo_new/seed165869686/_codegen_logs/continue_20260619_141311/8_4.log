+    scaled_parts = {key: scale_patch(patches[key], scales[key]) for key in patches}
+    expected = assemble_output(scaled_parts, bg)
+    if max(expected.shape) > ARC_MAX_SIDE:
+        return None
+
+    try:
+        if not np.array_equal(main(grid), expected):
