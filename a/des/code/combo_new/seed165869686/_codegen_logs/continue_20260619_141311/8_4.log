+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        sample = sample_case()
+        if sample is not None:
+            grid, _expected = sample
+            return grid
+    raise RuntimeError("failed to generate a valid input for puzzle 4")

