+    grid[top_h, :] = SEPARATOR_COLOR
+    grid[:, left_w] = SEPARATOR_COLOR
+    paste(grid, tl, 0, 0)
+    paste(grid, tr, 0, left_w + 1)
+    paste(grid, bl, top_h + 1, 0)
