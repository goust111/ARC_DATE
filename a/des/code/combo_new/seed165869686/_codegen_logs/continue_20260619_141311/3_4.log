        assert 0 <= er < grid.shape[0] and 0 <= ec < grid.shape[1] and int(grid[er, ec]) == bg
        grid[er, ec] = MARKER_COLOR

    return list(range(OBJECT_COUNT_RANGE[0])) if False else ([1] if False else [])  # unreachable sentinel


def _used_bbox(grid: np.ndarray, bg: int) -> tuple[int, int, int, int]:
    pts = np.argwhere(grid != bg)
