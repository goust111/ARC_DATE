+    left = random.randint(0, min(PADDING_MAX, c0))
+    bottom = random.randint(0, min(PADDING_MAX, inp.shape[0] - 1 - r1))
+    right = random.randint(0, min(PADDING_MAX, inp.shape[1] - 1 - c1))
