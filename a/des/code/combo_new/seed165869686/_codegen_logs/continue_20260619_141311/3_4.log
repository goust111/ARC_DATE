+        coords = object_specs[dst_idx]["coords"]
+        out[coords[:, 0], coords[:, 1]] = int(object_specs[src_idx]["color"])
+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    bg = random.choice(BG_CHOICES)
