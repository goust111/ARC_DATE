+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+PATH_COLOR = 2
+MARKER_COLOR = 4
+
+BASE_SIZE = 30
+GEN_ATTEMPTS = 400
+OBJECT_COUNT_RANGE = (3, 5)
+AREA_CHOICES = tuple(range(3, 9))
+ROW_SPACING = 5
+RUN_LEN_RANGE = (9, 16)
+BG_CHOICES = (0, 1, 3, 5, 6, 7, 8, 9)
+PADDING_MAX = 2
