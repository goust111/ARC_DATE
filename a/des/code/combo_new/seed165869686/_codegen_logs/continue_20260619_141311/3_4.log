+def _path_start_and_order(grid: np.ndarray) -> tuple[list[tuple[int, int]], tuple[int, int]]:
+    path_mask = grid == PATH_COLOR
+    comps = _mask_components(path_mask)
+    assert len(comps) == 1, "expected one red path"
+    coords = comps[0]
+    h, w = grid.shape
