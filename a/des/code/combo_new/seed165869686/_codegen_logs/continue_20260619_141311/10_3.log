+import numpy as np
+
+
+BG_COLOR = 0
+SIDES = ("top", "bottom", "left", "right")
+
+# Generator configuration.
+PAIR_COUNT_RANGE = (2, 4)
+INTERIOR_HEIGHT_RANGE = (3, 6)
+INTERIOR_WIDTH_RANGE = (3, 6)
+WORK_CANVAS = 30
+PLACEMENT_PADDING = 1
+MAX_GENERATION_ATTEMPTS = 400
