+    counts_by_color = {int(v): int(c) for v, c in zip(values, counts)}
+    bg_count = counts_by_color.get(BG_COLOR, 0)
+    return bg_count > max((count for color, count in counts_by_color.items() if color != BG_COLOR), default=0)
+
