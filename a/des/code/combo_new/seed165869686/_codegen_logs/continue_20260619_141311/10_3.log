+
+    for spec in specs:
+        idx = int(spec["index"])
+        sr0, sc0 = fragment_positions[idx]
+        fragment_patch = spec["fragment_patch"]
+        _paste(inp, fragment_patch, sr0, sc0, transparent=BG_COLOR)
+
+        fr0, fc0 = frame_positions[idx]
+        fh, fw = spec["frame_patch"].shape
