+    if layers < 1:
+        return None
+    if side == "up":
+        r = layers
+        if r >= h:
+            return None
+        lo, hi = layers, w - 1 - layers
+        if lo > hi:
+            return None
+        return r, random.randint(lo, hi)
+    if side == "down":
+        r = h - 1 - layers
+        if r < 0:
+            return None
+        lo, hi = layers, w - 1 - layers
+        if lo > hi:
+            return None
+        return r, random.randint(lo, hi)
+    if side == "left":
+        c = layers
+        if c >= w:
+            return None
+        lo, hi = layers, h - 1 - layers
+        if lo > hi:
+            return None
+        return random.randint(lo, hi), c
+    c = w - 1 - layers
+    if c < 0:
+        return None
+    lo, hi = layers, h - 1 - layers
+    if lo > hi:
+        return None
+    return random.randint(lo, hi), c
+
+
+def _candidate_wall_position(
+    shape: tuple[int, int],
+    side: str,
+    layers: int,
+) -> tuple[tuple[int, int], set[tuple[int, int]]] | None:
+    h, w = shape
+    pad = layers + 1
+    row_lo, row_hi = pad, h - 1 - pad
+    col_lo, col_hi = pad, w - 1 - pad
+    if row_lo > row_hi or col_lo > col_hi:
+        return None
+
+    r = random.randint(row_lo, row_hi)
+    c = random.randint(col_lo, col_hi)
+    length = 3 if random.random() < 0.75 else 1
+    delta_span = [-1, 0, 1] if length == 3 else [0]
+    wall_cells: set[tuple[int, int]] = set()
+    if side == "up":
+        wr = r - layers - 1
+        for dc in delta_span:
+            wc = c + dc
+            if 0 <= wc < w:
+                wall_cells.add((wr, wc))
+    elif side == "down":
+        wr = r + layers + 1
+        for dc in delta_span:
+            wc = c + dc
+            if 0 <= wc < w:
+                wall_cells.add((wr, wc))
+    elif side == "left":
+        wc = c - layers - 1
+        for dr in delta_span:
+            wr = r + dr
+            if 0 <= wr < h:
+                wall_cells.add((wr, wc))
+    else:
+        wc = c + layers + 1
+        for dr in delta_span:
+            wr = r + dr
+            if 0 <= wr < h:
