+
+def _corner_points(shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    return [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]
+
+
+def _sign(x: int) -> int:
+    if x < 0:
+        return -1
+    if x > 0:
+        return 1
+    return 0
+
+
+def _component_from_start(mask: np.ndarray, start: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    sr, sc = start
+    if not mask[sr, sc]:
+        return []
+    stack = [(sr, sc)]
+    seen = {start}
+    points: list[tuple[int, int]] = []
+    while stack:
+        r, c = stack.pop()
+        points.append((r, c))
+        for dr, dc in CARDINALS:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return points
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), max(rows), min(cols), max(cols)
+
+
+def _inside_bbox(box: tuple[int, int, int, int], r: int, c: int) -> bool:
