+    for a, b in zip(lines, lines[1:], strict=False):
+        if a + 1 <= b - 1:
+            spans.append((a + 1, b - 1))
+    return spans
+
+
+def _legend_bbox_and_templates(grid: np.ndarray) -> tuple[tuple[int, int, int, int], dict[int, tuple[tuple[int, int], ...]]]:
