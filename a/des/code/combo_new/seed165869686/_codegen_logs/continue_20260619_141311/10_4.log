+
+def _free_steps_with_extra(
+    grid: np.ndarray,
+    r: int,
+    c: int,
+    dr: int,
+    dc: int,
+    extra_grey: set[tuple[int, int]],
+) -> int:
+    h, w = grid.shape
+    steps = 0
+    nr, nc = r + dr, c + dc
+    while 0 <= nr < h and 0 <= nc < w and int(grid[nr, nc]) != GREY and (nr, nc) not in extra_grey:
