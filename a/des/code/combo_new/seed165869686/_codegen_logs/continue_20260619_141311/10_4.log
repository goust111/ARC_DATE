+def _corner_points(shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    return [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]
+
+
+def _sign(x: int) -> int:
+    if x < 0:
+        return -1
+    if x > 0:
+        return 1
+    return 0
