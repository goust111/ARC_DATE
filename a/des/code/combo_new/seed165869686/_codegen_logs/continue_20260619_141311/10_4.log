+
+def _component_from_start(mask: np.ndarray, start: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    sr, sc = start
+    if not mask[sr, sc]:
+        return []
+    stack = [(sr, sc)]
+    seen = {start}
+    points: list[tuple[int, int]] = []
+    while stack:
+        r, c = stack.pop()
+        points.append((r, c))
+        for dr, dc in CARDINALS:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
