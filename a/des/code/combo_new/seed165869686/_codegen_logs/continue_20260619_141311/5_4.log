+                pattern_offset=(pattern_r, pattern_c),
+                pattern_mask=pattern_mask,
+            )
+            _mark_forbidden(occupied, union_bbox, pad=1)
+            placed = True
+            break
+
+        if not placed:
+            return None
+
+    frames = _find_u_frames(grid, 0)
+    if len(frames) != object_count:
