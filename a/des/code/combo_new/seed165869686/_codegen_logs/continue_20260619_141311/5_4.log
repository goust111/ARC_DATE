+
+
+def _u_mask(height: int, width: int, direction: str) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    if direction == "up":
+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[-1, :] = True
+    elif direction == "down":
+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[0, :] = True
+    elif direction == "left":
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, -1] = True
+    else:
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, 0] = True
+    return mask
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    pts = np.argwhere(mask)
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return mask[r0 : r1 + 1, c0 : c1 + 1]
+
+
+def _connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if len(pts) == 0:
+        return False
+    start = tuple(int(x) for x in pts[0])
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc]:
+                nxt = (nr, nc)
+                if nxt not in seen:
+                    seen.add(nxt)
+                    q.append(nxt)
+    return len(seen) == int(mask.sum())
+
+
+def _random_pattern(rng: random.Random, direction: str) -> np.ndarray:
+    for _ in range(200):
+        h = rng.randint(2, 4)
+        w = rng.randint(2, 4)
+        count = rng.randint(2, min(h * w - 1, 6))
+        mask = np.zeros((h, w), dtype=bool)
+        start = (rng.randrange(h), rng.randrange(w))
+        mask[start] = True
+        frontier = {start}
+        while int(mask.sum()) < count:
+            base = rng.choice(tuple(frontier))
+            neighbors = []
+            for nr, nc in ((base[0] - 1, base[1]), (base[0] + 1, base[1]), (base[0], base[1] - 1), (base[0], base[1] + 1)):
