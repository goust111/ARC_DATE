+                    neighbors.append((nr, nc))
+            if not neighbors:
+                frontier.discard(base)
+                if not frontier:
+                    break
+                continue
+            chosen = rng.choice(neighbors)
+            mask[chosen] = True
+            frontier.add(chosen)
