        return None
    width = random.randint(1, 2)
    if direction < 0:
        start = max(1, center - width + 1)
    else:
        start = center
    if start + width - 1 > w - 2:
        start = w - 1 - width
    cols = list(range(start, start + width))
    if any(not (1 <= c <= w - 2) for c in cols):
        return None
    return cols


