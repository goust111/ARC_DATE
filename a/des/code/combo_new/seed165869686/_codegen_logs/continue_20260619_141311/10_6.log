+        "terrain_stops": int(terrain_stops),
+        "tower_stops": int(tower_stops),
+        "overlap_higher": int(overlap_higher),
+        "overlap_equal": int(overlap_equal),
+        "ambiguous_ties": int(ambiguous_ties),
+        "changed_pixels": int(np.count_nonzero(out != g)),
