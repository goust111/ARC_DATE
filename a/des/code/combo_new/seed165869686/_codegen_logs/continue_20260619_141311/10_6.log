    for c in cols:
        surface[c] = min(int(surface[c]), random.randint(ridge_top, ridge_bottom))


def _sample_pair_columns(w: int, *, odd_gap: bool) -> tuple[int, int] | None:
    gaps = []
    for gap in range(5, min(12, w - 3)):
