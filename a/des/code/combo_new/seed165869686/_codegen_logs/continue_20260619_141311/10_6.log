+
+
+def _near_ridge_cols(w: int, anchor: int, direction: int) -> list[int] | None:
+    distance = random.randint(2, 4)
+    center = anchor + direction * distance
+    if not (1 <= center <= w - 2):
+        return None
+    width = random.randint(1, 2)
