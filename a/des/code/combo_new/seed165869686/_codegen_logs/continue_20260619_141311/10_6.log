+def _random_surface(h: int, w: int) -> np.ndarray:
+    low = max(4, h // 3)
+    high = h - 2
+    cur = random.randint(max(low, high - 5), high - 1)
+    surface = np.zeros(w, dtype=int)
+    for c in range(w):
+        surface[c] = int(cur)
+        cur = max(low, min(high, cur + random.choice([-1, 0, 0, 1])))
+
+    for _ in range(random.randint(1, 3)):
