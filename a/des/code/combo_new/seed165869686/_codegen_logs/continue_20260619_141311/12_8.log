+def _translated_bbox(shape: list[tuple[int, int]], r0: int, c0: int) -> tuple[int, int, int, int]:
+    rows = [r0 + r for r, _ in shape]
+    cols = [c0 + c for _, c in shape]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _region_is_clear(
+    grid: np.ndarray,
+    r0: int,
+    c0: int,
+    r1: int,
+    c1: int,
