+def _mirror_half(half: np.ndarray, bg: int, axis_color: int) -> np.ndarray:
+    h, half_w = half.shape
+    w = half_w * 2 + 1
+    axis = half_w
+    out = np.full((h, w), bg, dtype=int)
+    out[:, axis] = axis_color
+    out[:, :axis] = half
+    out[:, axis + 1 :] = np.fliplr(half)
+    return out
+
