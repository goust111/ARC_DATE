+    left_points: list[tuple[int, int]] = []
+    right_points: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(axis):
+            rc = w - 1 - c
+            if int(g[r, c]) == int(g[r, rc]):
+                continue
+            pairs.append((r, c, rc))
+            left_points.append((r, c))
+            right_points.append((r, rc))
