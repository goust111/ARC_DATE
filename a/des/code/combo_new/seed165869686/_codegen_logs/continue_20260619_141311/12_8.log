+            if shape is None:
+                continue
+            shape_h = max(r for r, _ in shape) + 1
+            shape_w = max(c for _, c in shape) + 1
+            if shape_w > usable_max_col + 1 or shape_h > h:
+                continue
+            r0 = random.randint(0, h - shape_h)
+            c0 = random.randint(0, usable_max_col - shape_w + 1)
