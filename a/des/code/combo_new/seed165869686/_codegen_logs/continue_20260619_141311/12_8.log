+        else:
+            out[coord] = random.choice(picked)
+    return out
+
+
+def _expected_output(
+    base: np.ndarray,
+    defect_points: list[tuple[int, int]],
+    defect_colors: dict[tuple[int, int], int],
+) -> np.ndarray:
