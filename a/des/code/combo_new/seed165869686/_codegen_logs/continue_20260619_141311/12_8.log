+def _build_base_grid(h: int, w: int, bg: int, axis_color: int, fg_colors: list[int]) -> np.ndarray | None:
+    axis = w // 2
+    left = np.full((h, axis), bg, dtype=int)
+    occupied = np.zeros((h, axis), dtype=bool)
