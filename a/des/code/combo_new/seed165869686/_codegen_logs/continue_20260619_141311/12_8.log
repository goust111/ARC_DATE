+            if not frontier:
+                break
+            cells.add(random.choice(frontier))
+        if len(cells) != target_area:
+            continue
+
+        shape = _normalize_cells(cells)
+        width = max(c for _, c in shape) + 1
+        if require_odd_width and width % 2 == 0:
+            continue
+        return shape
+    return None
+
