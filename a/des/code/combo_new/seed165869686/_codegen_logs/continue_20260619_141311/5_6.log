+        cols = coords[:, 1]
+        r0 = int(rows.min())
+        r1 = int(rows.max())
+        c0 = int(cols.min())
+        c1 = int(cols.max())
+        assert r0 < r1 and c0 < c1, "paired pixels must define a non-degenerate rectangle"
+
+        out[r0, c0 : c1 + 1] = int(color)
