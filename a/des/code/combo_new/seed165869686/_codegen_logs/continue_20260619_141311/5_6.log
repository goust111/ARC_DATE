    if layout is None:
        return None

    slot_rows, slot_cols = layout
    row_sizes = _random_partition(height, slot_rows, SLOT_MIN_SIZE)
    col_sizes = _random_partition(width, slot_cols, SLOT_MIN_SIZE)
