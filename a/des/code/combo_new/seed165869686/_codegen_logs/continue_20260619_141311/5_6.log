+    r0, c0, r1, c1 = box
+    if orientation == "main":
+        return (r0, c0), (r1, c1)
+    if orientation == "anti":
+        return (r0, c1), (r1, c0)
+    raise AssertionError(f"unknown orientation: {orientation}")
+
+
