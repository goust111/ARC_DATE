+def _foreground_colors_scan_order(grid: np.ndarray) -> list[int]:
+    seen: set[int] = set()
+    ordered: list[int] = []
+    for value in grid.ravel():
+        color = int(value)
+        if color != BG and color not in seen:
+            seen.add(color)
+            ordered.append(color)
+    return ordered
+
