+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+
+COLOR_ORDER = [BLUE, GREEN, ORANGE, RED, YELLOW]
+COLOR_DRAW_RANK = {color: rank for rank, color in enumerate(COLOR_ORDER)}
+
