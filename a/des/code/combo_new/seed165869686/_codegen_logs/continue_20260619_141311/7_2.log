    total = int(np.random.randint(total_lo, total_hi + 1))
    valid = [n for n in range(n_lo, n_hi + 1) if part_lo * n <= total <= part_hi * n]
    if not valid:
        return None
    n = int(np.random.choice(valid))
    return _gen_partition(total, n, part_lo, part_hi)


