    for h in range(MOVER_HEIGHT_RANGE[0], MOVER_HEIGHT_RANGE[1] + 1):
        cells = h * int(w)
        lo = max(MOVER_AREA_RANGE[0], _ceil_fraction(cells, *MOVER_MIN_DENSITY))
        hi = min(MOVER_AREA_RANGE[1], cells, int(max_area))
