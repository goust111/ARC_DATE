        ("BL", mid_r + 1, height, 0, mid_c, 1, -1),
        ("BR", mid_r + 1, height, mid_c + 1, width, 1, 1),
    ]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Grow each quadrant's colored seeds outward along the diagonal away from the central cross.

    Input structure:
