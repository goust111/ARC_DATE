        for pos in first_pool:
            if _is_compatible(pos, seeds, used_diagonals, dr, dc):
                chosen_first = pos
                break
        if chosen_first is None:
            continue

        seeds.append(chosen_first)
        used_diagonals.add(_diag_key(chosen_first[0], chosen_first[1], dr, dc))

