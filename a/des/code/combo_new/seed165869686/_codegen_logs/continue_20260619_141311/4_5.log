+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+
+MAX_ATTEMPTS = 400
+SHAPE_ATTEMPTS = 120
+PLACEMENT_ATTEMPTS = 120
+
+
+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    for dr, dc in DIRS:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            out.append((nr, nc))
+    return out
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = map(int, mask.shape)
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            comp: list[tuple[int, int]] = []
+            q = deque([(r, c)])
+            seen[r, c] = True
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _is_adjacent(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    return abs(a[0] - b[0]) + abs(a[1] - b[1]) == 1
+
+
+def _ordered_path(
+    component: list[tuple[int, int]],
+    source: tuple[int, int],
+    sink: tuple[int, int],
+    h: int,
+    w: int,
+) -> list[tuple[int, int]]:
+    comp_set = set(component)
+    start_cells = [cell for cell in _neighbors4(source[0], source[1], h, w) if cell in comp_set]
+    end_cells = {cell for cell in _neighbors4(sink[0], sink[1], h, w) if cell in comp_set}
+    assert len(start_cells) == 1
+    assert len(end_cells) == 1
+
+    seq = [source]
+    prev = source
+    cur = start_cells[0]
+    while True:
+        seq.append(cur)
+        next_cells = [cell for cell in _neighbors4(cur[0], cur[1], h, w) if cell in comp_set and cell != prev]
+        if cur in end_cells:
+            assert not next_cells
+            break
+        assert len(next_cells) == 1
+        prev, cur = cur, next_cells[0]
