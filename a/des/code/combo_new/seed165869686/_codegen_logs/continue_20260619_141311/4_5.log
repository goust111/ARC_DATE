+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+
+MAX_ATTEMPTS = 400
