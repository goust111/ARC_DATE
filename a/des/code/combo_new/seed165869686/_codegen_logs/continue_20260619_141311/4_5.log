+    for off_r, off_c in _candidate_offsets(shape, h, w, prefer_edge):
+        points = [(r + off_r, c + off_c) for r, c in shape["points"]]
+        tail = (shape["tail"][0] + off_r, shape["tail"][1] + off_c)
+        sink = (shape["sink"][0] + off_r, shape["sink"][1] + off_c)
