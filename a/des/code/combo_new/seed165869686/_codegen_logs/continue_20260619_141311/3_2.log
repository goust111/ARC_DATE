+            offsets = _generate_shape(side, size)
+            if offsets is None:
+                continue
+            result = _choose_exit_portal(
+                offsets,
+                h,
+                w,
+                output_occupied,
+                portal_occupied,
+                must_clip=idx in clip_indices,
+            )
+            if result is None:
+                continue
