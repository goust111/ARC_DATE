    r1, c1 = r0 + _GEN_SQUARE_LAST, c0 + _GEN_SQUARE_LAST
    if r0 <= r <= r1:
        if c == c0 - 1:
            return "left"
        if c == c1 + 1:
            return "right"
    if c0 <= c <= c1:
        if r == r0 - 1:
            return "above"
        if r == r1 + 1:
            return "below"
    return None


