+        p1 = next(iter(touched))
+        portal_color = portal_lookup[p1]
+        used_portal_colors.add(portal_color)
+        pa, pb = portal_pairs[portal_color]
+        p2 = pb if p1 == pa else pa
+        obj_color = int(comp["color"])
