    return np.array_equal(solved, expected)


def _gen_attempt() -> np.ndarray | None:
    H, W = _gen_choose_canvas_shape()
    colors = _gen_choose_square_colors()

    squares = _gen_place_squares(H, W, colors)
    if squares is None:
