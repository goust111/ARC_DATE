+        reverse=True,
+    )
+    for idx in order:
+        total_h = specs[idx]["inner_h"] + 2
+        total_w = specs[idx]["inner_w"] + 2
+        positions = []
+        for r0 in range(min_r0, h - total_h):
+            for c0 in range(min_c0, w - total_w):
+                if occupied[r0 - 1 : r0 + total_h + 1, c0 - 1 : c0 + total_w + 1].any():
+                    continue
+                positions.append((r0, c0))
