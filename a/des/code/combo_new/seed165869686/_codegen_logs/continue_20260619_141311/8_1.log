+def _frame_patch(inner_h: int, inner_w: int, bg: int) -> np.ndarray:
+    patch = np.full((inner_h + 2, inner_w + 2), bg, dtype=int)
+    patch[0, :] = GREY
+    patch[-1, :] = GREY
+    patch[:, 0] = GREY
+    patch[:, -1] = GREY
+    return patch
