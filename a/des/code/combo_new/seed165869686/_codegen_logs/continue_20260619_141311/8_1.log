+
+def _reserve(occupied: np.ndarray, r0: int, c0: int, h: int, w: int) -> None:
+    h0, w0 = occupied.shape
+    occupied[max(0, r0 - 1) : min(h0, r0 + h + 1), max(0, c0 - 1) : min(w0, c0 + w + 1)] = True
