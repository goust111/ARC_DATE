+def _bg_dominant(grid: np.ndarray, bg: int) -> bool:
+    counts = Counter(map(int, grid.flatten()))
+    return counts[bg] == max(counts.values())
+
+
+def _place_regions(
+    rng: random.Random,
+    occupied: np.ndarray,
+    h: int,
+    w: int,
+    min_r0: int,
+    min_c0: int,
+    specs: list[dict[str, int]],
