+    grid[lr0, lc0 : lc1 + 1] = GREY
+    grid[lr1, lc0 : lc1 + 1] = GREY
+    grid[lr0 : lr1 + 1, lc0] = GREY
+    grid[lr0 : lr1 + 1, lc1] = GREY
