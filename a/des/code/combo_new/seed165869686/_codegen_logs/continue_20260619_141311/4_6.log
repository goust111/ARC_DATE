+import random
+
+import numpy as np
+
+
+BLACK = 0
+GEN_SEPARATOR = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+TEMPLATE_WIDTH_SETS = ([2, 2, 3, 3], [2, 2, 2, 3, 3])
+TEMPLATE_HEIGHT_CHOICES = (2, 3)
