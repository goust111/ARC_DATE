+def _region_bboxes(mask: np.ndarray) -> list[tuple[int, int, int, int]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    boxes: list[tuple[int, int, int, int]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            r0 = r1 = r
+            c0 = c1 = c
+            while stack:
+                rr, cc = stack.pop()
