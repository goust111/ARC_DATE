+        patch[mask] = color
+        occ[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+        return True
+    return False
+
+
+def _gen_attempt() -> np.ndarray | None:
+    bg = 0
+    h = random.randint(22, 30)
+    w = random.randint(22, 30)
+    frame_color = random.randint(1, 9)
