+            rs = ir0 - mh
+            cs = ic0 + offset
+            patch = grid[rs:ir0, cs : cs + mw]
+        elif side == "bottom":
+            rs = ir1 + 1
+            cs = ic0 + offset
+            patch = grid[rs : rs + mh, cs : cs + mw]
+        elif side == "left":
+            rs = ir0 + offset
+            cs = ic0 - mw
+            patch = grid[rs : rs + mh, cs:ic0]
+        else:
+            rs = ir0 + offset
+            cs = ic1 + 1
+            patch = grid[rs : rs + mh, cs : cs + mw]
