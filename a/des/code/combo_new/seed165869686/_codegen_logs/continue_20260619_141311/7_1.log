+
+    used_shapes: set[tuple[tuple[int, int], ...]] = set()
+    notch_specs: dict[str, tuple[np.ndarray, int]] = {}
+    side_colors: dict[str, int] = {}
+
+    colors = [c for c in range(1, 10) if c != frame_color]
