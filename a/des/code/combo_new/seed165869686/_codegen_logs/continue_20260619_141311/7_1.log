+    inner_w = random.randint(6, 11)
+    thickness = {side: random.randint(2, 4) for side in SIDES}
+
+    outer_h = inner_h + thickness["top"] + thickness["bottom"]
+    outer_w = inner_w + thickness["left"] + thickness["right"]
+    if outer_h > h - 4 or outer_w > w - 4:
