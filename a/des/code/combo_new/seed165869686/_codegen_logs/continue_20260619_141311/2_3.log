+def _hole_count(mask: np.ndarray) -> int:
+    bg = ~mask
+    h, w = bg.shape
+    seen = np.zeros((h, w), dtype=bool)
+    holes = 0
+    for r in range(h):
+        for c in range(w):
+            if not bg[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            touches_border = False
+            while q:
+                rr, cc = q.popleft()
+                if rr in (0, h - 1) or cc in (0, w - 1):
+                    touches_border = True
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and bg[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            if not touches_border:
+                holes += 1
+    return int(holes)
