+def _can_place(occupied: np.ndarray, top: int, left: int, mask: np.ndarray, pad: int = 1) -> bool:
+    h, w = mask.shape
+    r0 = max(0, top - pad)
+    c0 = max(0, left - pad)
+    r1 = min(occupied.shape[0], top + h + pad)
+    c1 = min(occupied.shape[1], left + w + pad)
+    return not occupied[r0:r1, c0:c1].any()
