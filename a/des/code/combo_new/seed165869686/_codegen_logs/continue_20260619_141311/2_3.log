+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PALETTE = list(range(1, 10))
+GEN_RETRIES = 400
