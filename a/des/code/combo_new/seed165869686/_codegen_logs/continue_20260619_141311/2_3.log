+                grown[1:, :] = out
+                grown[0, c0 : c0 + width] = True
+            else:
+                grown = np.zeros((out.shape[0] + 1, out.shape[1]), dtype=bool)
+                grown[:-1, :] = out
+                grown[-1, c0 : c0 + width] = True
+            out = grown
+    return out
