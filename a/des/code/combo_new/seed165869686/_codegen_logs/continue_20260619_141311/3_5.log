+def _draw_frame(grid: np.ndarray, r0: int, c0: int, h: int, w: int, color: int) -> None:
+    grid[r0, c0 : c0 + w] = color
+    grid[r0 + h - 1, c0 : c0 + w] = color
+    grid[r0 : r0 + h, c0] = color
+    grid[r0 : r0 + h, c0 + w - 1] = color
