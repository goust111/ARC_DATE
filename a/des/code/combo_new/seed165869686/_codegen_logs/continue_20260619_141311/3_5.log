+    return {
+        "direction": direction,
+        "outer_color": outer_color,
+        "inner_color": inner_color,
+        "outer_h": outer_h,
+        "outer_w": outer_w,
+        "inner_h": inner_h,
+        "inner_w": inner_w,
+        "inner_r": inner_r,
+        "inner_c": inner_c,
+        "gap_span": (gap0, gap1),
+        "reserve_h": reserve_h,
+        "reserve_w": reserve_w,
+        "outer_origin": outer_origin,
+        "inner_patch": _random_inner_patch(rng, inner_h, inner_w, bg, inner_color),
