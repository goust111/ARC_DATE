+    _draw_frame(patch, 0, 0, h, w, frame_color)
+
+    interior_cells = [(r, c) for r in range(1, h - 1) for c in range(1, w - 1)]
+    if not interior_cells or rng.random() < 0.25:
+        return patch
+
+    max_cells = min(len(interior_cells), max(1, len(interior_cells) // 2 + 1))
