# Canvas and palette.
MIN_H, MAX_H = 6, 18
MIN_W, MAX_W = 8, 14
BG_GREY, BG_ORANGE = 5, 7
GREY_FRAC_MIN, GREY_FRAC_MAX = 0.2, 0.6

# Rectangle and band constraints.
MIN_RECTS, MAX_RECTS = 1, 8
MIN_BAND_SIZE, MAX_BAND_SIZE = 1, 6
BAND_GAP = 1
MIN_RECT_AREA, MAX_RECT_AREA = 2, 18
MAX_RECT_SIDE = 6
