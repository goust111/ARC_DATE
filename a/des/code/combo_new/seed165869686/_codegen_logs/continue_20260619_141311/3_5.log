+            for idx, inner in enumerate(closed_frames)
+            if idx not in used_closed
+            and _inside_with_moat(outer["bbox"], inner["bbox"])  # type: ignore[index]
+            and _gap_covers_inner(outer, inner["bbox"])  # type: ignore[index]
