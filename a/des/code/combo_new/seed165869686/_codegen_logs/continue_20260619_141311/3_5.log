+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+_DIRECTIONS = ("top", "bottom", "left", "right")
+_MAX_GROUPS = 4
+_MAX_ATTEMPTS = 400
+
+
+def _background_color(grid: np.ndarray) -> int:
+    corners = [int(grid[0, 0]), int(grid[0, -1]), int(grid[-1, 0]), int(grid[-1, -1])]
+    if len(set(corners)) == 1:
+        return corners[0]
+    return Counter(map(int, grid.flat)).most_common(1)[0][0]
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _draw_frame(grid: np.ndarray, r0: int, c0: int, h: int, w: int, color: int) -> None:
+    grid[r0, c0 : c0 + w] = color
+    grid[r0 + h - 1, c0 : c0 + w] = color
+    grid[r0 : r0 + h, c0] = color
+    grid[r0 : r0 + h, c0 + w - 1] = color
+
+
+def _erase_gap(
+    grid: np.ndarray,
+    r0: int,
+    c0: int,
+    h: int,
+    w: int,
+    side: str,
+    span: tuple[int, int],
+    bg: int,
+) -> None:
+    a, b = span
+    if side == "top":
+        grid[r0, c0 + a : c0 + b + 1] = bg
+    elif side == "bottom":
+        grid[r0 + h - 1, c0 + a : c0 + b + 1] = bg
+    elif side == "left":
+        grid[r0 + a : r0 + b + 1, c0] = bg
+    else:
+        grid[r0 + a : r0 + b + 1, c0 + w - 1] = bg
+
+
+def _frame_info(grid: np.ndarray, color: int, coords: np.ndarray, bg: int) -> dict[str, object] | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+
+    mask = np.zeros((h, w), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+
+    if np.any(mask & ~border):
+        return None
+
+    missing = border & ~mask
+    if not np.any(missing):
+        return {
+            "kind": "closed",
+            "color": int(color),
+            "bbox": (r0, c0, r1, c1),
+            "coords": coords,
+        }
+
+    side_masks = {
+        "top": missing[0, :],
+        "bottom": missing[-1, :],
