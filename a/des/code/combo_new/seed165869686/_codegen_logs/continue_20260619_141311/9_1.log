+
+
+def _display_sizes(hole: np.ndarray) -> list[int]:
+    if hole.shape == (1, 1):
+        return [3, 4]
+    return [4]
+
+
+def _make_stencil(hole: np.ndarray, size: int, rng: random.Random) -> np.ndarray:
+    inner_h = size - 2
+    inner_w = size - 2
+    hh, hw = hole.shape
