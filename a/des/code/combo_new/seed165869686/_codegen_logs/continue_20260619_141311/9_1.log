+    if not active_rows:
+        return groups
+    start = active_rows[0]
+    prev = active_rows[0]
+    for row in active_rows[1:]:
+        if row != prev + 1:
+            groups.append((start, prev))
+            start = row
+        prev = row
+    groups.append((start, prev))
+    return groups
+
+
+def _legend_mapping(grid: np.ndarray, bg: int, grey: int) -> tuple[int, dict[tuple[tuple[int, int], bytes], int]]:
