+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_GENERATION_ATTEMPTS = 400
+LEGEND_ENTRY_RANGE = (2, 4)
+FRAME_COUNT_RANGE = (2, 4)
+GRID_H_RANGE = (14, 30)
+GRID_W_RANGE = (18, 30)
