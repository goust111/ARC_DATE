+        if not placed:
+            return None
+
+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+    if out.shape != grid.shape:
+        return None
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
