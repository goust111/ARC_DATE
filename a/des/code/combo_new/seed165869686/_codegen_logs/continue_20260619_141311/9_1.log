+    assert coords.size > 0, "expected a non-empty shape"
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return np.asarray(mask[r0 : r1 + 1, c0 : c1 + 1], dtype=bool)
