+    out = g.copy()
+    for comp in _components(upper == shape_color):
+        r0, c0, r1, c1 = _bbox(comp)
+        mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        for r, c in comp:
