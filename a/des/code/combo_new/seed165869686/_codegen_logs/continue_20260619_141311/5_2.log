+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r0 in range(h):
+        for c0 in range(w):
+            if not mask[r0, c0] or seen[r0, c0]:
+                continue
+            stack = [(int(r0), int(c0))]
+            seen[r0, c0] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                comp.append((int(r), int(c)))
+                for rr, cc in _neighbors4(r, c):
+                    if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
+                        seen[rr, cc] = True
+                        stack.append((int(rr), int(cc)))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _analyze_shape(mask: np.ndarray) -> tuple[int, np.ndarray]:
+    """
+    Return (hole_count, outer_boundary_mask) for a single 4-connected shape mask.
+    Only boundary cells adjacent to the exterior background are marked.
+    """
+    h, w = mask.shape
+    padded = np.zeros((h + 2, w + 2), dtype=bool)
+    padded[1:-1, 1:-1] = mask
+    bg_mask = ~padded
+    seen = np.zeros_like(bg_mask, dtype=bool)
+    exterior = np.zeros_like(bg_mask, dtype=bool)
+    holes = 0
+
+    for r0 in range(h + 2):
+        for c0 in range(w + 2):
+            if not bg_mask[r0, c0] or seen[r0, c0]:
+                continue
+            stack = [(int(r0), int(c0))]
+            seen[r0, c0] = True
+            cells: list[tuple[int, int]] = []
+            touches_border = False
+            while stack:
+                r, c = stack.pop()
+                cells.append((int(r), int(c)))
+                if r == 0 or c == 0 or r == h + 1 or c == w + 1:
+                    touches_border = True
+                for rr, cc in _neighbors4(r, c):
+                    if 0 <= rr < h + 2 and 0 <= cc < w + 2 and bg_mask[rr, cc] and not seen[rr, cc]:
+                        seen[rr, cc] = True
+                        stack.append((int(rr), int(cc)))
+            if touches_border:
+                for r, c in cells:
+                    exterior[r, c] = True
+            else:
+                holes += 1
+
+    boundary = np.zeros_like(mask, dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            pr = r + 1
+            pc = c + 1
+            for rr, cc in _neighbors4(pr, pc):
+                if exterior[rr, cc]:
+                    boundary[r, c] = True
+                    break
