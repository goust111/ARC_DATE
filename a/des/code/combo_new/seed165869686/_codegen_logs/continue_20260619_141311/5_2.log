+        holes, boundary = _analyze_shape(mask)
+        if holes >= legend_len:
+            return None
+        if int(np.sum(mask & ~boundary)) == 0:
+            return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        sample = _make_sample()
+        if sample is None:
+            continue
+        out = main(sample)
+        if out.shape != sample.shape:
+            continue
+        if np.array_equal(out, sample):
