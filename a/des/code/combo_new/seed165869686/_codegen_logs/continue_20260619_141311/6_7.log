import random
DIRS=[(-1,0),(0,1),(1,0),(0,-1)]
LEFT={DIRS[i]:DIRS[(i-1)%4] for i in range(4)}
RIGHT={DIRS[i]:DIRS[(i+1)%4] for i in range(4)}

def add(a,b): return (a[0]+b[0],a[1]+b[1])

def legal(new,pos,occ,bound=8):
    if abs(new[0])>bound or abs(new[1])>bound or new in occ:
        return False
    neigh=0
    for d in DIRS:
        nb=add(new,d)
        if nb in occ:
            if nb"'!=pos:
                return False
            neigh+=1
    return neigh==1

def gen(total,start,end):
    path=[(0,0)]
    occ={(0,0)}
    def dfs(pos, prev, steps_done):
        if steps_done==total:
            return prev==end
        if steps_done==0:
            cands=[start]
        elif steps_done==total-1:
            cands=[end]
        else:
            cands=[prev, LEFT[prev], RIGHT[prev]]
            random.shuffle(cands)
