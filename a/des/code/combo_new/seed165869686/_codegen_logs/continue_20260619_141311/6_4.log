+    right = random.randint(0, min(3, inp.shape[1] - 1 - c1))
+    slc = (slice(r0 - top, r1 + bottom + 1), slice(c0 - left, c1 + right + 1))
+    return inp[slc].copy(), out[slc].copy()
+
