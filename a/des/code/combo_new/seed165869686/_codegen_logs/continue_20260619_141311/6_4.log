+def _place_patch(
+    canvas: np.ndarray,
+    reserved: np.ndarray,
+    patch: np.ndarray,
+    gap: int = PLACEMENT_GAP,
+) -> tuple[int, int] | None:
+    h, w = patch.shape
+    rows = list(range(canvas.shape[0] - h + 1))
+    cols = list(range(canvas.shape[1] - w + 1))
+    random.shuffle(rows)
+    random.shuffle(cols)
+    for r0 in rows:
+        for c0 in cols:
+            rr0 = max(0, r0 - gap)
+            cc0 = max(0, c0 - gap)
+            rr1 = min(canvas.shape[0], r0 + h + gap)
+            cc1 = min(canvas.shape[1], c0 + w + gap)
+            if np.any(reserved[rr0:rr1, cc0:cc1]):
