+    hole_by_signature: dict[tuple[int, int, tuple[int, ...]], dict] = {}
+    for mold in molds:
+        sig = _canonical_signature(mold["hole_mask"])
+        assert sig not in hole_by_signature, "cavity shapes must be uniquely matchable"
+        hole_by_signature[sig] = mold
