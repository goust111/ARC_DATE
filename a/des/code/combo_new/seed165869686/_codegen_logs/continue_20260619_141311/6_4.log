+            or np.any(comp[:, 1] == 0)
+            or np.any(comp[:, 1] == mask.shape[1] - 1)
+        ):
+            continue
+        return True
+    return False
+
+
+def _find_molds(grid: np.ndarray, bg: int) -> list[dict]:
