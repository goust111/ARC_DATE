+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+MOLD_COLOR = 5
+PIECE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GEN_ATTEMPTS = 500
+CANVAS_SIDE = 30
+PLACEMENT_GAP = 1
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((int(cr), int(cc)))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _tight_mask_from_coords(coords: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(coords)
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    out[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return out
+
+
+def _normalize_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    assert coords.size > 0
+    return _tight_mask_from_coords(coords)
+
+
+def _mask_signature(mask: np.ndarray) -> tuple[int, int, tuple[int, ...]]:
+    tight = _normalize_mask(np.asarray(mask, dtype=bool))
+    return (
+        int(tight.shape[0]),
+        int(tight.shape[1]),
+        tuple(int(x) for x in tight.ravel()),
+    )
