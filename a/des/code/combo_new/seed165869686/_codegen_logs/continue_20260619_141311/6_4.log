+
+def _apply_transform(mask: np.ndarray, op: int) -> np.ndarray:
+    out = np.rot90(np.asarray(mask, dtype=bool), op % 4)
+    if op >= 4:
+        out = np.fliplr(out)
+    return _normalize_mask(out)
