import numpy as np
DIRS=[(1,0),(-1,0),(0,1),(0,-1)]

def comp_count(mask):
    h,w=mask.shape
    seen=set(); n=0
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or (r,c) in seen: continue
            n+=1
            st=[(r,c)]; seen.add((r,c))
            while st:
                rr,cc=st.pop()
                for dr,dc in DIRS:
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and (nr,nc) not in seen:
                        seen.add((nr,nc)); st.append((nr,nc))
    return n

def full_bbox(mask):
    return mask[0,:].any() and mask[-1,:].any() and mask[:,0].any() and mask[:,-1].any()

def rings(n):
    a=np.zeros((n,n),dtype=bool)
    layers=(n+1)//2
    for r in range(n):
        for c in range(n):
            layer=min(r,c,n-1-r,n-1-c)
            a[r,c]=(layer%2==0)
    return a

def gate(a):
    n=a.shape[0]
    layers=(n+1)//2
    sides=['top','right','bottom','left']
    for layer in range(layers-1):
        side=sides[layer%4]
        if layer%2==0:
            # recolor one A ring cell to B
            if side=='top':
                a[layer, layer+1] = False
            elif side=='right':
                a[layer+1, n-1-layer] = False
            elif side=='bottom':
                a[n-1-layer, n-2-layer] = False
            else:
                a[n-2-layer, layer] = False
        else:
            # recolor one B ring cell to A
            if side=='top':
                a[layer, layer+1] = True
            elif side=='right':
                a[layer+1, n-1-layer] = True
            elif side=='bottom':
                a[n-1-layer, n-2-layer] = True
            else:
                a[n-2-layer, layer] = True
    return a

for n in [5,7,9,11]:
    a=gate(rings(n))
    b=~a
    print('n',n,'compA',comp_count(a),'compB',comp_count(b),'bboxA',full_bbox(a),'bboxB',full_bbox(b),'areas',a.sum(),b.sum())
    print(a.astype(int))
