+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1))
+
+
+def _connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+
+    h, w = mask.shape
+    start = tuple(map(int, coords[0]))
+    stack = [start]
+    seen = {start}
+
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return len(seen) == len(coords)
+
+
+def _crop_mask(mask: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        raise AssertionError("mask must be non-empty")
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    r0 = int(r0)
+    c0 = int(c0)
+    r1 = int(r1)
+    c1 = int(c1)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy(), (r0, c0, r1, c1)
+
+
+def _find_components(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if g[r, c] == BG or seen[r, c]:
+                continue
+
+            color = int(g[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+
+            while stack:
+                rr, cc = stack.pop()
+                assert int(g[rr, cc]) == color
+                coords.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(rr, cc):
