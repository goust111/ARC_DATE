    return mask[0,:].any() and mask[-1,:].any() and mask[:,0].any() and mask[:,-1].any()

def search(h,w,tries=20000,maxlen=30):
    for _ in range(tries):
        # start on random boundary
        boundary=[]
        for c in range(w): boundary.append((0,c)); boundary.append((h-1,c))
        for r in range(1,h-1): boundary.append((r,0)); boundary.append((r,w-1))
        start=random.choice(boundary)
        path=[start]; seen={start}
        while len(path)<maxlen:
            r,c=path[-1]
            moves=[]
            for dr,dc in DIRS:
                nr,nc=r+dr,c+dc
                if 0<=nr<h and 0<=nc<w and (nr,nc) not in seen:
                    moves.append((nr,nc))
            if not moves:
                break
            # bias toward unvisited boundary sides not yet touched
            sides_touched={
                'top': any(rr==0 for rr,cc in path),
                'bot': any(rr==h-1 for rr,cc in path),
                'left': any(cc==0 for rr,cc in path),
                'right': any(cc==w-1 for rr,cc in path),
            }
            need=[]
            for nr,nc in moves:
                score=0
                if nr==0 and not sides_touched['top']: score+=3
                if nr==h-1 and not sides_touched['bot']: score+=3
                if nc==0 and not sides_touched['left']: score+=3
                if nc==w-1 and not sides_touched['right']: score+=3
                score+=random.random()
                need.append((score,(nr,nc)))
            need.sort(reverse=True)
            pick=random.choice(need[:min(3,len(need))])[1]
            path.append(pick); seen.add(pick)
            a=np.zeros((h,w),dtype=bool)
            for rc in path: a[rc]=True
            b=~a
            if len(path)>=8 and full_bbox(a) and full_bbox(b) and comp_count(b)==1:
                print('found len',len(path),'start',start)
                print(a.astype(int))
                return True
    return False

for shape in [(5,5),(6,6),(7,7),(6,7),(7,8),(8,8)]:
    print('shape',shape,search(*shape))
