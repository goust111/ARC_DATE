import numpy as np, random

def cycle(h,w):
    assert w % 2 == 0 and h >= 2 and w >= 2
    path=[(0,0)]
    for r in range(h):
        if r==0:
            for c in range(1,w): path.append((r,c))
        elif r%2==1:
            for c in range(w-1,0,-1): path.append((r,c))
        else:
            for c in range(1,w): path.append((r,c))
    for r in range(h-1,0,-1):
        path.append((r,0))
    assert len(path)==h*w
    assert len(set(path))==h*w
    # adjacency with wrap
    for a,b in zip(path,path[1:]+path[:1]):
        assert abs(a[0]-b[0])+abs(a[1]-b[1])==1
    return path

def full_bbox(cells,h,w):
    rows=[r for r,c in cells]; cols=[c for r,c in cells]
    return min(rows)==0 and max(rows)==h-1 and min(cols)==0 and max(cols)==w-1

for h,w in [(4,4),(4,6),(5,4),(6,6)]:
    p=cycle(h,w)
    n=len(p)
    found=0
    for i in range(n):
        for L in range(1,n):
            a=[p[(i+k)%n] for k in range(L)]
            b=[p[(i+L+k)%n] for k in range(n-L)]
            if full_bbox(a,h,w) and full_bbox(b,h,w) and len(a)"'!=len(b):
                found+=1
                print('"'found',h,w,'i',i,'L',L,'areas',len(a),len(b))
                raise SystemExit
    print('none',h,w)
