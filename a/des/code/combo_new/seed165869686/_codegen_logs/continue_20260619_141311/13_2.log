    sides={
        'top': [(0,c) for c in range(w)],
        'bot': [(h-1,c) for c in range(w)],
        'left': [(r,0) for r in range(h)],
        'right': [(r,w-1) for r in range(h)],
    }
    for sidecells in sides.values():
        s.add(Or([a[rc] for rc in sidecells]))
        s.add(Or([Not(a[rc]) for rc in sidecells]))

    areaA = Int('areaA')
    s.add(areaA == Sum([If(a[rc],1,0) for rc in cells]))
    s.add(areaA >= 2, areaA <= h*w-2)
    s.add(areaA*2 "'!= h*w)

