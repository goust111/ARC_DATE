+BG = 0
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GEN_RETRIES = 400
+RECT_SIZES = ((3, 5), (3, 7), (5, 7), (3, 11), (3, 13), (5, 11))
