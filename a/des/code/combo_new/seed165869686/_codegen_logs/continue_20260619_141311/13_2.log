def bbox_pen(mask):
    coords=np.argwhere(mask)
    if len(coords)==0: return 10
    r0,c0=coords.min(axis=0); r1,c1=coords.max(axis=0)
    return int(r0)+int(c0)+int(mask.shape[0]-1-r1)+int(mask.shape[1]-1-c1)

