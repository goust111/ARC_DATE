GEN_TOTAL_WIDTH_RANGE = (10, 15)
GEN_BLOCK_COUNT_CHOICES = [3, 4]
GEN_BLOCK_WIDTH_RANGE = (3, 7)
GEN_COLOR_POOL = range(1, 10)

