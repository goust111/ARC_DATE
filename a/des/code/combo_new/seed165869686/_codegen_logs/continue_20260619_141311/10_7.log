+from __future__ import annotations
+
+import heapq
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+PIPE = 5
+VALVE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIR4 = ((1, 0), (-1, 0), (0, -1), (0, 1))
+BRANCH_MODES = ("up", "down", "both")
+ODD_GAPS = (3, 5)
+ODD_LENGTHS = (3, 5, 7)
