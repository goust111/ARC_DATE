+    if len(dot_colors) < 2:
+        return None
+
+    out = main(grid)
+    if out.shape != grid.shape or max(out.shape) > 30:
+        return None
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
