+import random
+
+import numpy as np
+
+
+BG = 8
+ANCHOR = 9
+CONFLICT = 2
+DOT_COLORS = (1, 3, 4, 5, 6, 7)
+ORIENTATIONS = ("up", "down", "left", "right")
+TRIANGLE_AREAS = (3, 6)
+GEN_RETRIES = 400
