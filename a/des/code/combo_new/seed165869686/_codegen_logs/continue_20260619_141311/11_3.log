+def _reflect(spec: dict[str, object], r: int, c: int) -> tuple[int, int]:
+    axis_index = int(spec["axis_index"])
+    if str(spec["axis_kind"]) == "row":
+        return 2 * axis_index - r, c
+    return r, 2 * axis_index - c
