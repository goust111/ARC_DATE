+        axis_index = r0
+        source_sign = 1
+    elif orientation == "down":
+        axis_kind = "row"
+        axis_index = r1
+        source_sign = -1
+    elif orientation == "left":
+        axis_kind = "col"
+        axis_index = c0
+        source_sign = 1
+    else:
