+    dot_mask = (g != bg) & (g != ANCHOR)
+    for r_raw, c_raw in np.argwhere(dot_mask):
+        r = int(r_raw)
+        c = int(c_raw)
+        color = int(g[r, c])
+        matched = [spec for spec in triangles if _classify(spec, r, c) is not None]
