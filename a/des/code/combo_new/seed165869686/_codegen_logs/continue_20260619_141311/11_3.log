+def _classify(spec: dict[str, object], r: int, c: int) -> str | None:
+    axis_kind = str(spec["axis_kind"])
+    axis_index = int(spec["axis_index"])
+    band = int(spec["band"])
+    source_sign = int(spec["source_sign"])
+    delta = r - axis_index if axis_kind == "row" else c - axis_index
+
+    if abs(delta) > band:
