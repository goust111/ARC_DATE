+def _region_slices(region_count: int, cell_h: int, cell_w: int) -> tuple[list[slice], list[slice]]:
+    row_slices = [
+        slice(1 + r * (cell_h + 1), 1 + r * (cell_h + 1) + cell_h)
+        for r in range(region_count)
+    ]
+    col_slices = [
