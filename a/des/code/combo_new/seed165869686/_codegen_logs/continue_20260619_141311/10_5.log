+    for r in range(height):
+        color = int(grid[r, 0])
+        if np.all(grid[r, :] == color):
+            row_lines.setdefault(color, []).append(int(r))
+
+    for c in range(width):
+        color = int(grid[0, c])
+        if np.all(grid[:, c] == color):
+            col_lines.setdefault(color, []).append(int(c))
+
