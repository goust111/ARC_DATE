+        for c0 in range(w - gw + 1):
+            rr0 = max(0, r0 - 1)
+            rr1 = min(h, r0 + gh + 1)
+            cc0 = max(0, c0 - 1)
+            cc1 = min(w, c0 + gw + 1)
