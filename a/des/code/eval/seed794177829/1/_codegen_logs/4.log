+    micro_frames = [frame for frame in frames if frame["shape"] == (3, 3)]
+    rooms = [frame for frame in frames if frame["shape"][0] >= 5 and frame["shape"][1] >= 5]
+    assert micro_frames and rooms, "expected both legend frames and rooms"
