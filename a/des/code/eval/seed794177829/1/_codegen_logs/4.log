+        grid[r0, rng.randint(c0 + 1, c1 - 1)] = bg
+    if "bottom" in combo:
+        grid[r1, rng.randint(c0 + 1, c1 - 1)] = bg
+    if "left" in combo:
+        grid[rng.randint(r0 + 1, r1 - 1), c0] = bg
+    if "right" in combo:
+        grid[rng.randint(r0 + 1, r1 - 1), c1] = bg
