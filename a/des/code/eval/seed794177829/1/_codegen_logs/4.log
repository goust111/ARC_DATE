+DIR_ORDER = ("top", "bottom", "left", "right")
+ALL_COMBOS = [
+    combo
+    for mask in range(1, 1 << len(DIR_ORDER))
+    for combo in [tuple(DIR_ORDER[i] for i in range(len(DIR_ORDER)) if mask & (1 << i))]
+]
