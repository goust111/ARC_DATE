+def _is_adjacent_pair(frame_bbox: tuple[int, int, int, int], symbol_bbox: tuple[int, int, int, int]) -> bool:
+    fr0, fc0, fr1, fc1 = frame_bbox
+    sr0, sc0, sr1, sc1 = symbol_bbox
