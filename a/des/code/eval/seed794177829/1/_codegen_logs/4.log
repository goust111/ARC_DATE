+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _frame_signature(patch: np.ndarray, wall: int, bg: int) -> tuple[str, ...] | None:
+    h, w = patch.shape
+    if h < 3 or w < 3:
+        return None
+    if np.any(patch[1:-1, 1:-1] != bg):
+        return None
+    if not (
+        int(patch[0, 0]) == wall
+        and int(patch[0, -1]) == wall
+        and int(patch[-1, 0]) == wall
+        and int(patch[-1, -1]) == wall
+    ):
+        return None
+
+    gaps: list[str] = []
+    side_lines = {
+        "top": patch[0, 1:-1],
+        "bottom": patch[-1, 1:-1],
+        "left": patch[1:-1, 0],
+        "right": patch[1:-1, -1],
+    }
+    for name in DIR_ORDER:
+        line = side_lines[name]
+        if np.any((line != wall) & (line != bg)):
+            return None
+        missing = int(np.sum(line == bg))
+        if missing > 1:
+            return None
+        if missing == 1:
+            gaps.append(name)
+
+    border_mask = np.zeros((h, w), dtype=bool)
+    border_mask[0, :] = True
+    border_mask[-1, :] = True
+    border_mask[:, 0] = True
+    border_mask[:, -1] = True
+    border = patch[border_mask]
+    if np.any((border != wall) & (border != bg)):
+        return None
