+    legend_map: dict[tuple[str, ...], np.ndarray] = {}
+    used_symbols: set[int] = set()
+    for frame in micro_frames:
+        matches = [i for i, sym in enumerate(symbols) if _is_adjacent_pair(frame["bbox"], sym["bbox"])]
