+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != bg):
+        frames = _collect_frames(grid, color, bg)
+        if not frames:
+            continue
+        score = (len(frames), sum(frame["area"] for frame in frames))
+        candidates.append((score, color))
