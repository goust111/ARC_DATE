+            if np.all(grid[:, c] == bg):
+                sides.append(("left", grid[:, :c]))
+                break
+    if np.any(grid[:, -1] != bg):
+        for c in range(w - 2, -1, -1):
+            if np.all(grid[:, c] == bg):
+                sides.append(("right", grid[:, c + 1 :]))
+                break
+    assert len(sides) == 1, "legend must occupy exactly one edge strip"
+    return sides[0]
