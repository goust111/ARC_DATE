+        out[r0 : r1 + 1, c1 + 1 : c1 + 1 + length] = color
+    elif direction == "up":
+        assert r0 - length >= 0
+        out[r0 - length : r0, c0 : c1 + 1] = color
+    else:
+        assert direction == "down"
+        assert r1 + length < out.shape[0]
+        out[r1 + 1 : r1 + 1 + length, c0 : c1 + 1] = color
