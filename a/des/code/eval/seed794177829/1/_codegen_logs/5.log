+    key_b = (int(rect_b["bbox"][0]), int(rect_b["bbox"][1]))
+    if key_a <= key_b:
+        return int(rect_a["id"]), int(rect_b["id"])
+    return int(rect_b["id"]), int(rect_a["id"])
