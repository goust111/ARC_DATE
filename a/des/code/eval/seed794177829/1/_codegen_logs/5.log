+def _winner_loser(rect_a: dict, rect_b: dict) -> tuple[int, int]:
+    area_a = int(rect_a["area"])
+    area_b = int(rect_b["area"])
+    if area_a != area_b:
+        if area_a > area_b:
+            return int(rect_a["id"]), int(rect_b["id"])
