+
+def _room_layout(rows: int, cols: int, rng: random.Random):
+    row_sizes = [rng.randint(*ROOM_SIZE_RANGE) for _ in range(rows)]
+    col_sizes = [rng.randint(*ROOM_SIZE_RANGE) for _ in range(cols)]
