+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MARKER_COLORS = (2, 1, 3, 4, 7, 9)
+OUTER_MARGIN = 2
+ROOM_COUNT_RANGE = (2, 4)
+ROOM_SIZE_RANGE = (2, 4)
+GEN_RETRIES = 400
+GRAPH_RETRIES = 200
