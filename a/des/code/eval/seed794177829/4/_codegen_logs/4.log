+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SCENARIOS = (
+    "full_cover_connected",
+    "full_cover_disconnected",
+    "partial_cover_connected",
+    "partial_cover_disconnected",
+)
+
+
+def _neighbors4(r: int, c: int):
