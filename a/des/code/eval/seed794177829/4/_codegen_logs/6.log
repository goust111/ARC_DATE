+
+def _frame_outside_neighbors(border: set[tuple[int, int]], bbox: tuple[int, int, int, int], h: int, w: int) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    out: set[tuple[int, int]] = set()
+    for r, c in border:
+        for nr, nc in _neighbors4(r, c):
+            if not (0 <= nr < h and 0 <= nc < w):
