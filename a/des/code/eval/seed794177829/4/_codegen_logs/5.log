+                "side": prev_side,
+                "kind": prev_kind,
+                "pos": _random_side_pos(prev_side, specs[i]["body_h"], specs[i]["body_w"]),
+            }
+        )
+        specs[i + 1]["features"].append(
+            {
+                "side": next_side,
+                "kind": next_kind,
+                "pos": _random_side_pos(next_side, specs[i + 1]["body_h"], specs[i + 1]["body_w"]),
+            }
+        )
