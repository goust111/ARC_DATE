+    for i in range(1, len(pieces)):
+        prev = placed[-1]
+        prev_piece = prev["piece"]
+        prev_shift = prev["shift"]
+        prev_feature = next(
+            feat
+            for feat in prev_piece["features"]
+            if feat["side"] == specs[i - 1]["features"][-1]["side"]
+        )
+        curr_feature = next(
+            feat
+            for feat in pieces[i]["features"]
+            if feat["side"] == specs[i]["features"][0]["side"]
