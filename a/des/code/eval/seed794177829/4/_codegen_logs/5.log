+        return "N"
+    if bottom == patch_h - 2 and rr == bottom + 1 and left + 1 <= cc <= right - 1:
+        return "S"
+    if left == 1 and cc == left - 1 and top + 1 <= rr <= bottom - 1:
+        return "W"
+    if right == patch_w - 2 and cc == right + 1 and top + 1 <= rr <= bottom - 1:
+        return "E"
+    return None
