+
+def _specs_from_chain(order: list[int], directions: list[str], link_modes: list[bool]) -> list[dict] | None:
+    n = len(order)
+    specs = [
+        {
+            "color": int(order[i]),
+            "body_h": random.randint(*BODY_H_RANGE),
+            "body_w": random.randint(*BODY_W_RANGE),
+            "features": [],
+        }
+        for i in range(n)
