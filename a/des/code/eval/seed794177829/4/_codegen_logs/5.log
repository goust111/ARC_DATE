+SIDES = ("N", "E", "S", "W")
+DIRS = {
+    "N": (-1, 0),
+    "E": (0, 1),
+    "S": (1, 0),
+    "W": (0, -1),
+}
+OPPOSITE = {"N": "S", "E": "W", "S": "N", "W": "E"}
+
+GEN_RETRIES = 500
+PIECE_COUNT_RANGE = (3, 5)
+BODY_H_RANGE = (4, 7)
+BODY_W_RANGE = (4, 7)
