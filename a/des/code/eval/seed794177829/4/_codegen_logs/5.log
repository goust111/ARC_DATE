+    return placed
+
+
+def _render_assembly(placed: list[dict]) -> np.ndarray:
+    all_cells: list[tuple[int, int]] = []
+    for item in placed:
+        tr, tc = map(int, item["shift"])
+        for r, c in item["piece"]["occ"]:
+            all_cells.append((int(r + tr), int(c + tc)))
