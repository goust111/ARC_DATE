+def _place_piece(
+    piece: dict,
+    translation: tuple[int, int],
+    occupied: set[tuple[int, int]],
+) -> set[tuple[int, int]] | None:
+    tr, tc = map(int, translation)
+    cells = {(int(r + tr), int(c + tc)) for r, c in piece["occ"]}
+    if cells & occupied:
+        return None
+    return cells
