+    rel = coords - np.array([r0, c0], dtype=int)
+    mask = np.zeros(patch.shape, dtype=bool)
+    mask[rel[:, 0], rel[:, 1]] = True
+    colors = sorted(set(map(int, patch[mask])))
+    return {
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "patch": patch,
+        "mask": mask,
+        "colors": colors,
+    }
