+    grid[lr : lr + lh, lc : lc + lw] = legend
+    rr0 = max(0, lr - 1)
+    rr1 = min(h, lr + lh + 1)
+    cc0 = max(0, lc - 1)
+    cc1 = min(w, lc + lw + 1)
+    blocked[rr0:rr1, cc0:cc1] = True
