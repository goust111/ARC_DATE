+        prev_piece = prev["piece"]
+        prev_shift = prev["shift"]
+        prev_feature = next(
+            feat
+            for feat in prev_piece["features"]
+            if feat["side"] == specs[i - 1]["features"][-1]["side"]
+        )
+        curr_feature = next(
+            feat
+            for feat in pieces[i]["features"]
+            if feat["side"] == specs[i]["features"][0]["side"]
+        )
+
+        world_r = int(prev_feature["cell"][0] + prev_shift[0])
+        world_c = int(prev_feature["cell"][1] + prev_shift[1])
+        shift = (int(world_r - curr_feature["cell"][0]), int(world_c - curr_feature["cell"][1]))
+        cells = _place_piece(pieces[i], shift, occupied)
+        if cells is None:
+            return None
+        occupied |= cells
+        placed.append({"piece": pieces[i], "shift": shift})
+
+    return placed
+
+
+def _scatter_on_canvas(patches: list[np.ndarray], legend: np.ndarray) -> np.ndarray | None:
+    h = random.randint(*GRID_H_RANGE)
+    w = random.randint(*GRID_W_RANGE)
+    grid = np.full((h, w), BG, dtype=int)
+    blocked = np.zeros((h, w), dtype=bool)
+
+    lh, lw = map(int, legend.shape)
+    corners = {
+        "tl": (0, 0),
+        "tr": (0, w - lw),
+        "bl": (h - lh, 0),
+        "br": (h - lh, w - lw),
+    }
+    corner = random.choice(sorted(corners))
+    lr, lc = corners[corner]
+    if lr < 0 or lc < 0:
+        return None
+
+    grid[lr : lr + lh, lc : lc + lw] = legend
+    rr0 = max(0, lr - 1)
+    rr1 = min(h, lr + lh + 1)
+    cc0 = max(0, lc - 1)
+    cc1 = min(w, lc + lw + 1)
+    blocked[rr0:rr1, cc0:cc1] = True
+
+    order = list(range(len(patches)))
+    random.shuffle(order)
+    for idx in order:
+        patch = patches[idx]
+        ph, pw = map(int, patch.shape)
+        spots = [
+            (r, c)
+            for r in range(h - ph + 1)
+            for c in range(w - pw + 1)
+            if not bool(blocked[r : r + ph, c : c + pw].any())
+            and not bool(blocked[max(0, r - 1) : min(h, r + ph + 1), max(0, c - 1) : min(w, c + pw + 1)].any())
+        ]
+        if not spots:
+            return None
+        r, c = random.choice(spots)
+        mask = patch != BG
+        grid[r : r + ph, c : c + pw][mask] = patch[mask]
+        blocked[max(0, r - 1) : min(h, r + ph + 1), max(0, c - 1) : min(w, c + pw + 1)] = True
+    return grid
+
+
+def _generate_case() -> tuple[np.ndarray, np.ndarray] | None:
+    n = random.randint(*PIECE_COUNT_RANGE)
+    colors = random.sample(PIECE_COLORS, n)
+    order = random.sample(colors, len(colors))
+    directions = _direction_chain(n)
+    link_modes = [bool(random.getrandbits(1)) for _ in range(n - 1)]
+    specs = _specs_from_chain(order, directions, link_modes)
+    if specs is None:
+        return None
+
+    try:
+        pieces = [
+            _materialize_piece(spec["color"], spec["body_h"], spec["body_w"], spec["features"])
+            for spec in specs
+        ]
+    except AssertionError:
+        return None
+    try:
+        assembled = _assemble(pieces)
+    except AssertionError:
+        return None
+    expected = _render_assembly(assembled)
+
+    legend = _make_legend(order)
+    grid = _scatter_on_canvas([piece["patch"] for piece in pieces], legend)
+    if grid is None:
+        return None
+    return grid, expected
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        case = _generate_case()
+        if case is None:
+            continue
+        grid, expected = case
+        try:
+            actual = main(grid)
+        except Exception:
+            continue
+        if np.array_equal(actual, expected):
+            return grid
+    raise AssertionError("failed to generate a valid puzzle instance")

