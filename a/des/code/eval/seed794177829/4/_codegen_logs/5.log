+    occupied = {(int(r), int(c)) for r, c in ordered_pieces[0]["occ"]}
+    unmatched = [
+        {
+            "piece_index": 0,
+            "feature_index": i,
+            "side": feat["side"],
+            "kind": feat["kind"],
+            "cell": tuple(map(int, feat["cell"])),
+        }
+        for i, feat in enumerate(ordered_pieces[0]["features"])
