+
+def _make_legend(order: list[int]) -> np.ndarray:
+    n = len(order)
+    size = 2 * n + 1
+    patch = np.full((size, size), BG, dtype=int)
+    patch[::2, :] = GREY
+    patch[:, ::2] = GREY
+    for i, color in enumerate(order):
+        patch[2 * i + 1, 2 * i + 1] = int(color)
+    return patch
