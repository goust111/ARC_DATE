+        blocked[max(0, r - 1) : min(h, r + ph + 1), max(0, c - 1) : min(w, c + pw + 1)] = True
+    return grid
+
+
+def _generate_case() -> tuple[np.ndarray, np.ndarray] | None:
+    n = random.randint(*PIECE_COUNT_RANGE)
