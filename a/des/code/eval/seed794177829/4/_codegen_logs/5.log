+                {
+                    "piece_index": int(piece_index),
+                    "feature_index": int(ni),
+                    "side": feat["side"],
+                    "kind": feat["kind"],
+                    "cell": (
+                        int(feat["cell"][0] + chosen["shift"][0]),
+                        int(feat["cell"][1] + chosen["shift"][1]),
