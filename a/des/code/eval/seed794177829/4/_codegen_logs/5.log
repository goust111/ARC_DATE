+
+def _side_from_missing(rr: int, cc: int, top: int, left: int, body_h: int, body_w: int) -> str | None:
+    bottom = int(top + body_h - 1)
+    right = int(left + body_w - 1)
+    if rr == top and left + 1 <= cc <= right - 1:
+        return "N"
+    if rr == bottom and left + 1 <= cc <= right - 1:
