+def _direction_chain(n_pieces: int) -> list[str]:
+    dirs = [random.choice(SIDES)]
+    while len(dirs) < n_pieces - 1:
+        prev = dirs[-1]
+        options = [side for side in SIDES if side != OPPOSITE[prev]]
+        dirs.append(random.choice(options))
