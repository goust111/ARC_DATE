+                    body = np.zeros((h, w), dtype=bool)
+                    body[top : top + body_h, left : left + body_w] = True
+                    outside = np.argwhere(mask & ~body)
+                    missing = np.argwhere(body & ~mask)
+                    side_seen: set[str] = set()
+                    feats: list[dict] = []
+                    valid = True
