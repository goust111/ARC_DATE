+    n = (h - 1) // 2
+    order: list[int] = []
+    for i in range(n):
+        color = int(patch[2 * i + 1, 2 * i + 1])
+        assert color not in (BG, GREY), "legend diagonal cells must contain piece colors"
+        order.append(color)
