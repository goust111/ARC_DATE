+        prev_kind = "protrusion" if link_modes[i] else "cavity"
+        next_kind = "cavity" if link_modes[i] else "protrusion"
+        specs[i]["features"].append(
+            {
+                "side": prev_side,
+                "kind": prev_kind,
+                "pos": _random_side_pos(prev_side, specs[i]["body_h"], specs[i]["body_w"]),
