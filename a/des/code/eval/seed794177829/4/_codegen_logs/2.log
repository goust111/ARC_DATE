+    h, w = map(int, shape)
+    if direction == "right":
+        arrow_r = 1 if h <= 14 else rng.randint(1, h - 6)
+        arrow_cells = [(arrow_r, 0), (arrow_r + 1, 0), (arrow_r + 1, 1)]
+    else:
