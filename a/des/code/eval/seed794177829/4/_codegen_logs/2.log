+    if not turn_choices or not no_turn_choices:
+        return None
+
+    fragments: list[dict] = []
+    used_colors: set[int] = set()
+    taken_initial_nubs: set[tuple[int, int]] = set()
+
+    turn_track, turn_candidates = rng.choice(turn_choices)
