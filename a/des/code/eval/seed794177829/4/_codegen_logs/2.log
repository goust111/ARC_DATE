+    bottom_neighbors = [(r1 + 1, c0), (r1 + 1, c1)]
+    if r1 + 1 < h:
+        matched = [cell for cell in bottom_neighbors if int(grid[cell]) == int(color)]
+        if len(matched) == 1:
+            sides.append(("top", matched[0]))
+    top_neighbors = [(r0 - 1, c0), (r0 - 1, c1)]
+    if r0 - 1 >= 0:
