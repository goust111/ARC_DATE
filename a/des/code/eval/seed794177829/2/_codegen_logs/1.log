+            if not frontier:
+                break
+            cells.add(frontier[int(rng.integers(0, len(frontier)))])
+        if len(cells) != area:
+            continue
+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in cells:
+            mask[r, c] = True
+        if full_bbox:
