+GRID_H_RANGE = (26, 34)
+GRID_W_RANGE = (26, 34)
+FRAME_COUNT_RANGE = (2, 5)
+FRAME_H_RANGE = (7, 10)
+FRAME_W_RANGE = (7, 10)
