+    out = g.copy()
+    used: set[int] = set()
+    moves: list[tuple[dict, dict]] = []
+    for frame in frames:
+        candidates = []
+        for idx, fragment in enumerate(fragments):
+            if idx in used:
+                continue
+            dist = _aligned_distance(frame, fragment)
+            if dist is not None:
