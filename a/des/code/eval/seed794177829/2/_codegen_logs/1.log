+def _find_frames(g: np.ndarray) -> tuple[int, list[dict]]:
+    bg = _most_common(g)
+    non_bg = g[g != bg]
+    assert non_bg.size > 0, "expected non-background structure"
+    frame_color = _most_common(non_bg)
