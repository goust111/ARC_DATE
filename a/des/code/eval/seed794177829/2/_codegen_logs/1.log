+                return None
+            marker_side = side
+            marker_idx = int(other_idx[0])
+            marker_color = int(arr[marker_idx])
+
+        allowed = (arr == frame_color) | (arr == bg) | ((arr != bg) & (arr != frame_color))
+        if not np.all(allowed):
