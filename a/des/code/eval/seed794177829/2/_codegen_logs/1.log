+from __future__ import annotations
+
+import numpy as np
+
+
+OPPOSITE = {"top": "bottom", "bottom": "top", "left": "right", "right": "left"}
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+BG = 0
+FRAME_COLOR = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
