+        assert int(shifted[:, 0].min()) >= int(fr0 + 1)
+        assert int(shifted[:, 0].max()) <= int(fr1 - 1)
+        assert int(shifted[:, 1].min()) >= int(fc0 + 1)
+        assert int(shifted[:, 1].max()) <= int(fc1 - 1)
