+        return None
+
+    lo = int(rng.integers(c0_min, columns[a]))
+    hi = int(rng.integers(columns[b] + 1, c1_max + 1))
+    if hi - lo + 1 < MIN_PATH_LEN:
+        return None
+
+    return {
