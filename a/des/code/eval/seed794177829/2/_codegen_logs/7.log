+GRID_MIN = 14
+GRID_MAX = 23
+MAX_H = 3
+MAX_V = 3
+MIN_GAP = 3
+MAX_GENERATION_ATTEMPTS = 400
+SCENE_ATTEMPTS = 400
+MIN_PATH_LEN = 5
+MAX_PATHS = 5
