+    )
+    intersections: dict[tuple[int, int], tuple[int, int]] = {}
+    for coord, ids in coord_map.items():
+        if len(ids) == 2:
+            intersections[coord] = (ids[0], ids[1])
+        else:
+            assert len(ids) == 1, "scene generation must avoid triple overlaps"
+    return intersections
