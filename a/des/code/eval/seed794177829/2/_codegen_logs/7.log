+def _validate_scene(paths: list[dict[str, object]], shape: tuple[int, int]) -> bool:
+    h, w = shape
+    line_cells = [_ordered_cells_from_def(path) for path in paths]
+    line_sets = [set(cells) for cells in line_cells]
