+    markers: list[dict[str, object]] = []
+
+    for r in range(h - 1):
+        for c in range(w - 1):
+            color = int(grid[r, c])
+            if color == BG:
+                continue
+            block = grid[r : r + 2, c : c + 2]
+            if not np.all(block == color):
+                continue
+
+            cells = frozenset(((r, c), (r + 1, c), (r, c + 1), (r + 1, c + 1)))
+            if cells in seen:
