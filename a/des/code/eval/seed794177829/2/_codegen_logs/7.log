+    nxt = continuations[0]
+    dr = int(nxt[0] - endpoint[0])
+    dc = int(nxt[1] - endpoint[1])
+    assert abs(dr) + abs(dc) == 1, "path must be orthogonal"
+
+    coords = [endpoint]
+    r, c = endpoint
+    while True:
+        nr = r + dr
+        nc = c + dc
+        if not _in_bounds(grid.shape, nr, nc) or int(grid[nr, nc]) == BG:
+            break
+        coords.append((nr, nc))
+        r, c = nr, nc
