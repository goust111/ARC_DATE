+        cols = [c - 2, c - 1] if path["source"] == "left" else [c + 1, c + 2]
+    else:
+        rows = [r - 2, r - 1] if path["source"] == "top" else [r + 1, r + 2]
+        cols = [c - 1, c] if bias == "left" else [c, c + 1]
