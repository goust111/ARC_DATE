+                for rr, cc in cells
+                for nbr in _neighbors(grid.shape, rr, cc)
+                if nbr not in cells and int(grid[nbr]) == color
+            }
+            if len(adjacent_same) != 1:
+                continue
+
+            endpoint = next(iter(adjacent_same))
+            seen.add(cells)
+            markers.append(
