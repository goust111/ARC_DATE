+    np.array([[1], [1]], dtype=int),
+    np.array([[1, 1, 1]], dtype=int),
+    np.array([[1], [1], [1]], dtype=int),
+    np.array([[1, 1], [1, 1]], dtype=int),
+    np.array([[1, 1, 1], [1, 1, 1]], dtype=int),
+    np.array([[1, 1], [1, 1], [1, 1]], dtype=int),
+)
+GEN_RETRIES = 400
