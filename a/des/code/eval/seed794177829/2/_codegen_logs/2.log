+    if not any(arrow["stop"] == "tail" for arrow in parsed_arrows):
+        return None
+
+    output = main(grid)
+    if output.shape != grid.shape:
+        return None
+    if np.array_equal(output, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
