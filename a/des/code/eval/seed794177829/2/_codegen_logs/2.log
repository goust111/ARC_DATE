+    rel_coords, rel_tail = _raw_arrow_relative(direction, tail_len, skew, anchor_row)
+    cells = {(int(tip_r + r), int(tip_c + c)) for r, c in rel_coords}
+    tail = {(int(tip_r + r), int(tip_c + c)) for r, c in rel_tail}
+    return {
+        "color": int(color),
+        "direction": direction,
