+    pts = [(int(r), int(c)) for r, c in coords]
+    min_r = min(r for r, _ in pts)
+    min_c = min(c for _, c in pts)
+    norm = tuple(sorted((int(r - min_r), int(c - min_c)) for r, c in pts))
+    return norm, (int(min_r), int(min_c))
