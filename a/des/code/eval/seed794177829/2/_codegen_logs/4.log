+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(mask.shape, r, c):
+            if bool(mask[nr, nc]) and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
