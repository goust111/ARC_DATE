+MARKER_POOL = [1, 3, 4, 6, 7, 8, 9]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _neighbors4(shape: tuple[int, int], r: int, c: int) -> list[tuple[int, int]]:
+    h, w = shape
+    out = []
+    for dr, dc in DIRS4:
+        nr = r + dr
+        nc = c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            out.append((nr, nc))
+    return out
