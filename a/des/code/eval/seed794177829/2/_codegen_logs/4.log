+    if kind == "line":
+        return tree
+
+    if kind == "single_t":
+        a = add_node()
+        b = add_node()
+        children = [a, b]
+        tree[first]["children"] = children
+        tree[first]["selected"] = rng.choice(children)
+        return tree
+
+    if kind == "chain_t":
+        j2 = add_node()
+        side = add_node()
+        a = add_node()
+        b = add_node()
+        tree[first]["children"] = [j2, side]
+        tree[first]["selected"] = j2
+        tree[j2]["children"] = [a, b]
+        tree[j2]["selected"] = rng.choice([a, b])
+        return tree
+
+    if kind == "side_t":
+        leaf = add_node()
+        j2 = add_node()
+        a = add_node()
+        b = add_node()
+        tree[first]["children"] = [leaf, j2]
+        tree[first]["selected"] = leaf
+        tree[j2]["children"] = [a, b]
+        tree[j2]["selected"] = rng.choice([a, b])
+        return tree
