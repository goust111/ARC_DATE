+
+def _opposite(direction: tuple[int, int]) -> tuple[int, int]:
+    return (-direction[0], -direction[1])
+
+
+def _plane_neighbors(cell: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = cell
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
