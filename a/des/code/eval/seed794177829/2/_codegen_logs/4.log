+) -> np.ndarray:
+    rows = [r for r, _ in used]
+    cols = [c for _, c in used]
+    min_r, max_r = min(rows), max(rows)
+    min_c, max_c = min(cols), max(cols)
+    bbox_h = max_r - min_r + 1
+    bbox_w = max_c - min_c + 1
+
+    top = rng.randint(*MARGIN_RANGE)
+    bottom = rng.randint(*MARGIN_RANGE)
+    left = rng.randint(*MARGIN_RANGE)
+    right = rng.randint(*MARGIN_RANGE)
+
+    h = max(GRID_MIN, bbox_h + top + bottom)
+    w = max(GRID_MIN, bbox_w + left + right)
+    h = min(h, GRID_MAX)
+    w = min(w, GRID_MAX)
+
+    extra_top = h - bbox_h - top - bottom
+    extra_left = w - bbox_w - left - right
+    top += rng.randint(0, max(0, extra_top))
+    left += rng.randint(0, max(0, extra_left))
