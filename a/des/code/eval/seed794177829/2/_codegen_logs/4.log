+    dfs(node)
+    return sizes
+
+
+def _make_topology(kind: str, rng: random.Random) -> dict[int, dict[str, object]]:
+    tree: dict[int, dict[str, object]] = {}
+
+    def add_node(children: list[int] | None = None, selected: int | None = None) -> int:
+        idx = len(tree)
