+    junction_info: dict[tuple[int, int], tuple[tuple[int, int], int]] = {}
+    for cell in coords:
+        if degrees[cell] < 3:
+            continue
+        markers = []
+        for nb in neighbors[cell]:
+            col = int(g[nb])
+            if col not in (bg, pipe_color, seed_color):
