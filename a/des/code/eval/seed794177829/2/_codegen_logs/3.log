+BG = 0
+MARKER_COLOR = 3
+PATTERN_COLOR = 9
+LINE_COLORS = (1, 2, 4, 6)
+
+TOP, RIGHT, BOTTOM, LEFT = range(4)
+ROTATIONS_CCW = {TOP: 0, RIGHT: 3, BOTTOM: 2, LEFT: 1}
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
