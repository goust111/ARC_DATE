+            sc = int(c0 + 1 + ref_c0)
+            sh, sw = map(int, stamp.shape)
+            assert sr + sh <= r1 and sc + sw <= c1, "rotated pattern must fit inside each cell"
+            out[sr : sr + sh, sc : sc + sw] = stamp
