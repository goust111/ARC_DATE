+            side = TOP if (i, j) == ref_cell else int(dirs[i, j])
+            stamp = np.rot90(ref_crop, ROTATIONS_CCW[int(side)])
+            sr = int(r0 + 1 + anchor_r)
+            sc = int(c0 + 1 + anchor_c)
+            sh, sw = map(int, stamp.shape)
+            out[sr : sr + sh, sc : sc + sw] = stamp
