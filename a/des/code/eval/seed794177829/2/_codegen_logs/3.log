+            sc = int(c0 + 1 + anchor_c)
+            sh, sw = map(int, stamp.shape)
+            out[sr : sr + sh, sc : sc + sw] = stamp
+    return out
+
+
+def _gen_attempt(rng: random.Random) -> Optional[np.ndarray]:
