+    shape: tuple[int, int], rects: list[dict], order: tuple[int, ...]
+) -> np.ndarray:
+    out = np.zeros(shape, dtype=int)
+    for idx in order:
+        r0, c0, r1, c1 = rects[idx]["bbox"]
+        out[r0 : r1 + 1, c0 : c1 + 1] = rects[idx]["color"]
+    return out
+
+
