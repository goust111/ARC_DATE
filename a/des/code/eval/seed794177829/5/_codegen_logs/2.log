+import random
+from collections import deque
+
+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+BG_COLOR = 8
+GEN_RETRIES = 300
+GRID_MIN = 16
+GRID_MAX = 40
+SCALE_OPTIONS = {
+    2: [(1, 2), (1, 3), (1, 4), (1, 5)],
+    3: [(1, 2, 3), (1, 2, 4), (1, 3, 4), (1, 2, 5)],
+    4: [(1, 2, 3, 4)],
+}
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
