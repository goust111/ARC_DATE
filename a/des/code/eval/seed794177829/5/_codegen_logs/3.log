+    cells = [(int(ar), int(ac))]
+    cells.extend((int(ar + dr), int(ac + dc)) for dr, dc in piece["body_rels"])
+    return cells
+
+
+def _far_enough(cells: list[tuple[int, int]], occupied: set[tuple[int, int]]) -> bool:
+    for r, c in cells:
+        for orow, ocol in occupied:
