+    search_order = sorted(colors, key=lambda color: (len(candidates[color]), color))
+    solutions: list[tuple[dict[int, tuple[int, int, int, int]], list[int]]] = []
+    chosen: dict[int, tuple[int, int, int, int]] = {}
