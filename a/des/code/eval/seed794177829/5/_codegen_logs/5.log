+
+# --------------- generator ---------------
+
+GEN_RETRIES = 400
+PLACEMENT_RETRIES = 200
+GRID_H_RANGE = (12, 20)
+LEFT_W_RANGE = (12, 16)
+RECT_COUNT_RANGE = (3, 5)
+RECT_H_RANGE = (3, 8)
+RECT_W_RANGE = (3, 8)
+RIGHT_MARGIN_RANGE = (4, 8)
+MAX_TOTAL_WIDTH = 30
+
+
+def _rect_area(rect: dict[str, int]) -> int:
+    return int(rect["h"] * rect["w"])
+
+
+def _protected_cells(rect: dict[str, int]) -> list[tuple[int, int]]:
