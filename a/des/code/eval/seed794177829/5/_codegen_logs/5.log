+def _find_separator(grid: np.ndarray) -> int:
+    cols = [c for c in range(grid.shape[1]) if np.all(grid[:, c] == MAROON)]
+    assert len(cols) == 1, "expected exactly one maroon separator column"
+    return int(cols[0])
