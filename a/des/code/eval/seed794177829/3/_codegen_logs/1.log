+        return "top"
+    if r == r1 and c0 < c < c1:
+        return "bottom"
+    if c == c0 and r0 < r < r1:
+        return "left"
+    if c == c1 and r0 < r < r1:
+        return "right"
+    return None
+
+
+def _child_offset(cavity_shape: tuple[int, int], child_shape: tuple[int, int], side: str) -> tuple[int, int]:
+    cav_h, cav_w = cavity_shape
+    ch, cw = child_shape
+    extra_r = cav_h - ch
+    extra_c = cav_w - cw
+    assert extra_r >= 0 and extra_c >= 0, "child must fit inside parent cavity"
+    if side == "top":
+        return 0, extra_c // 2
+    if side == "bottom":
+        return extra_r, extra_c // 2
+    if side == "left":
+        return extra_r // 2, 0
+    if side == "right":
+        return extra_r // 2, extra_c
