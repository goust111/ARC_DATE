+# --------------- generator ---------------
+
+BG = 0
+GRID_H_RANGE = (22, 30)
+GRID_W_RANGE = (22, 30)
+FRAME_COUNT_CHOICES = (2, 3)
+INNER_OUTER_H_RANGE = (4, 7)
+INNER_OUTER_W_RANGE = (4, 7)
+PRIMARY_EXTRA_RANGE = (1, 4)
+SECONDARY_EXTRA_RANGE = (0, 4)
+PLACEMENT_GAP = 1
+PLACEMENT_TRIES = 200
+GEN_RETRIES = 400
