+            c0 = rng.randint(1, gw - w - 1)
+            bbox = (r0, c0, r0 + h - 1, c0 + w - 1)
+            if any(_objects_too_close(bbox, other) for other in occupied):
+                continue
+            placements[key] = (r0, c0)
+            occupied.append(bbox)
+            placed = True
+            break
+        if not placed:
+            raise RuntimeError("failed to place all objects")
+
+    return placements
+
