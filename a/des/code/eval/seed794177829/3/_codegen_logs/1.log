+    for c in range(c0, c1 + 1):
+        pts.add((r0, c))
+        pts.add((r1, c))
+    for r in range(r0, r1 + 1):
+        pts.add((r, c0))
+        pts.add((r, c1))
+    return pts
+
+
+def _anchor_side(anchor: tuple[int, int], bbox: tuple[int, int, int, int]) -> str | None:
+    r, c = anchor
+    r0, c0, r1, c1 = bbox
