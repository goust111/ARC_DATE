+
+    sides_inner = [rng.choice(SIDES) for _ in range(n_frames)]
+    shapes_inner: list[tuple[int, int]] = [
+        (
+            rng.randint(*INNER_OUTER_H_RANGE),
+            rng.randint(*INNER_OUTER_W_RANGE),
+        )
+    ]
+    cur_h, cur_w = shapes_inner[0]
+    for i in range(1, n_frames):
