+    return placements
+
+
+def _anchor_position(side: str, top: int, left: int, shape: tuple[int, int], rng: random.Random) -> tuple[int, int]:
+    h, w = shape
+    if side == "top":
+        return top, left + rng.randint(1, w - 2)
