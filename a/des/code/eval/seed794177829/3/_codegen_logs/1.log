+
+    frame_color, frame_count = counts.most_common(1)[0]
+    if frame_count != len(coords) - 1:
+        return None
+
+    anchors = [(r, c) for r, c in coords if int(grid[r, c]) != int(frame_color)]
+    if len(anchors) != 1:
