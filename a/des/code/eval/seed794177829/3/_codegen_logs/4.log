+        col_lines = np.flatnonzero(np.all(grid == color, axis=0))
+        if len(row_lines) < 2 or len(col_lines) < 2:
+            continue
+        if row_lines[0] != 0 or row_lines[-1] != grid.shape[0] - 1:
+            continue
+        if col_lines[0] != 0 or col_lines[-1] != grid.shape[1] - 1:
