+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+
+BASE_COLORS = (BLUE, RED, YELLOW)
+MIXED_LINE_COLOR = {
+    frozenset((RED, BLUE)): MAGENTA,
+    frozenset((RED, YELLOW)): ORANGE,
+    frozenset((BLUE, YELLOW)): GREEN,
+}
+MIX_INPUT_PAIRS = ((RED, BLUE), (RED, YELLOW), (BLUE, YELLOW))
+
+GRID_MIN = 24
+GRID_MAX = 30
+GEN_RETRIES = 400
+PAIR_GAP_MIN = 6
