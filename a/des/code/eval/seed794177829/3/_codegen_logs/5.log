+    blocked_rects: list[tuple[int, int, int, int]],
+    pad: int = 1,
+) -> bool:
+    h, w = occupied.shape
+    sh, sw = shape.shape
+    if top < 0 or left < 0 or top + sh > h or left + sw > w:
+        return False
+    pts = mask_to_coords(shape, top, left)
