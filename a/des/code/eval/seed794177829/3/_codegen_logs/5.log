+    if get_bg(grid) != BG:
+        return None
+    if len(components_mask(grid == MAROON, connectivity=4)) != 2:
+        return None
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
