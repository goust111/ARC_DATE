+    frame_bbox = (frame_r0, frame_c0, frame_r0 + inner_h + 1, frame_c0 + inner_w + 1)
+    if frame_bbox[2] >= h or frame_bbox[3] >= w:
+        return None
+    if rect_overlap(frame_bbox, mask_bbox, pad=1):
