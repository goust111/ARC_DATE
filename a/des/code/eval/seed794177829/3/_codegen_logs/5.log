+
+    grid[mr0 : mr1 + 1, mc0 : mc1 + 1] = MAROON
+    occupied[mr0 : mr1 + 1, mc0 : mc1 + 1] = True
+
+    blocked_rects = [mask_bbox, frame_bbox, src_group_bbox]
+    remaining_colors = [c for c in SHAPE_COLORS if c not in occ_colors]
