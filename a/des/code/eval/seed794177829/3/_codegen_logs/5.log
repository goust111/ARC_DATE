+        gap = rng.randint(3, 6)
+        if side == "bottom":
+            frame_r0 = mr1 + gap + rng.randint(0, 2)
+        else:
+            frame_r0 = max(1, mr0 - gap - (inner_h + 2) - rng.randint(0, 2))
+        max_r0 = h - inner_h - 2
+        if frame_r0 > max_r0:
+            return None
+        frame_c0 = rng.randint(1, max(1, w - inner_w - 2))
