+        if int(clean[ra, ca]) == _BG or int(clean[rb, cb]) == _BG:
+            continue
+        if _same_neighbor_count(clean, ra, ca) < 2:
+            continue
+        if _same_neighbor_count(clean, rb, cb) < 2:
+            continue
+        pairs.append((pos_a, pos_b))
+    _RNG.shuffle(pairs)
+    return pairs
