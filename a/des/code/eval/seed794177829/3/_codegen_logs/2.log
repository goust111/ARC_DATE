+def _iter_mirror_pairs(
+    bbox: tuple[int, int, int, int], orientation: str
+) -> list[tuple[tuple[int, int], tuple[int, int]]]:
+    r0, c0, r1, c1 = bbox
+    pairs: list[tuple[tuple[int, int], tuple[int, int]]] = []
+    if orientation == "horizontal":
