+        seed = seed.reshape(top_rows + center_rows, cols)
+        seed = _smooth_array(seed)
+        top = seed[:top_rows]
+        middle = seed[top_rows:] if center_rows else np.empty((0, cols), dtype=int)
+        coarse = np.vstack([top, middle, top[::-1]])
+    else:
