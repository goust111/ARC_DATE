+        seed = _smooth_array(seed)
+        left = seed[:, :left_cols]
+        middle = seed[:, left_cols:] if center_cols else np.empty((rows, 0), dtype=int)
+        coarse = np.hstack([left, middle, left[:, ::-1]])
