+
+
+def _random_asymmetric(n: int, rng: random.Random) -> np.ndarray:
+    return np.array([[rng.random() < 0.45 for _ in range(n)] for _ in range(n)], dtype=bool)
+
+
+def _pattern_for_kind(kind: str, n: int, rng: random.Random) -> np.ndarray:
