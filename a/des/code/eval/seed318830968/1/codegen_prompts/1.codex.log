+
+def _try_place_rect(blocked: np.ndarray, shape: tuple[int, int], rng: random.Random) -> tuple[int, int] | None:
+    h, w = blocked.shape
+    ph, pw = shape
+    rows = list(range(h - ph + 1))
+    cols = list(range(w - pw + 1))
+    rng.shuffle(rows)
