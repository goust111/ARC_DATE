+
+BG = 0
+GREY = 5
+TYPE_ORDER = ("horizontal", "vertical", "rotational", "asymmetric")
+
+LEGEND_MASKS = {
+    "horizontal": np.array(
+        [
+            [1, 0, 0],
+            [0, 1, 1],
+            [1, 0, 0],
+        ],
+        dtype=bool,
+    ),
+    "vertical": np.array(
+        [
+            [1, 0, 1],
+            [0, 1, 0],
+            [0, 1, 0],
+        ],
+        dtype=bool,
+    ),
+    "rotational": np.array(
+        [
+            [1, 0, 0],
+            [0, 1, 0],
+            [0, 0, 1],
+        ],
+        dtype=bool,
+    ),
+    "asymmetric": np.array(
+        [
+            [1, 1, 0],
+            [0, 1, 0],
+            [0, 0, 0],
+        ],
+        dtype=bool,
+    ),
+}
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[counts.argmax()])
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _same_color_components(grid: np.ndarray, excluded: set[int]) -> list[tuple[int, list[tuple[int, int]]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[tuple[int, list[tuple[int, int]]]] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if seen[r, c] or color in excluded:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                pts.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append((color, pts))
+    return comps
+
+
+def _find_frames(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    frames: list[dict[str, object]] = []
+    for color, pts in _same_color_components(grid, {bg, GREY}):
+        r0, c0, r1, c1 = _bbox(pts)
+        if r1 - r0 < 2 or c1 - c0 < 2:
+            continue
+        border = set()
+        for c in range(c0, c1 + 1):
+            border.add((r0, c))
+            border.add((r1, c))
+        for r in range(r0 + 1, r1):
+            border.add((r, c0))
+            border.add((r, c1))
+        if set(pts) != border:
+            continue
+        frames.append(
+            {
+                "color": int(color),
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+            }
+        )
+    return frames
+
+
+def _tight_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    assert coords.size > 0
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]
