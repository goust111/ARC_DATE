+        direction = "up"
+    elif int(red_pts[:, 0].min()) > pr1:
+        direction = "down"
+    elif int(red_pts[:, 1].max()) < pc0:
+        direction = "left"
+    elif int(red_pts[:, 1].min()) > pc1:
+        direction = "right"
+    else:
+        raise AssertionError("arrow must lie entirely on one side of the pattern")
