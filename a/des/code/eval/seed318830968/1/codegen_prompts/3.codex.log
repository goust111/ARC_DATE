+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+ARROW = 2
+SEPARATOR = 6
+PATTERN_COLORS = (1, 3, 4, 5, 7, 8, 9)
+TRANSFORMS = (
+    (False, 0),
+    (False, 1),
+    (False, 2),
+    (False, 3),
+    (True, 0),
+    (True, 1),
+    (True, 2),
+    (True, 3),
+)
+DIRS = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
+ARROW_OFFSETS = {
+    "up": ((1, 0), (1, 1), (0, 1)),
+    "right": ((0, 0), (1, 0), (0, 1)),
+    "down": ((0, 0), (0, 1), (1, 0)),
+    "left": ((0, 1), (1, 1), (1, 0)),
