+        inp[rr * (region_h + 1) - 1, :] = SEPARATOR
+    for cc in range(1, cols):
+        inp[:, cc * (region_w + 1) - 1] = SEPARATOR
+
+    sources: list[dict] = []
+    existing_shapes: set[tuple[int, int, tuple[int, ...]]] = set()
+    random.shuffle(selected)
