                break
            below = int(g[int(nr), int(cc)])

            if below == int(shelf):
                seg = find_shelf_seg(nr, cc)
                if seg is None:
                    break
                a, b = seg
                left_bound = int(max(0, int(a - 1)))
                right_bound = int(min(int(W - 1), int(b + 1)))
                left, right = spread_limits(rr, cc, left_bound, right_bound)
                for x in range(left, right + 1):
