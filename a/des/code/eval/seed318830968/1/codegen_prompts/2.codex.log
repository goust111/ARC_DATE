+                pos += seg_len
+                if idx + 1 < len(spec["segments"]):
+                    pos += int(spec["gaps"][idx])
+            marker_row = spec["end"] + 1 if int(spec["direction"]) > 0 else spec["start"] - 1
+            inp[int(marker_row), col] = GREY_COLOR
+        _paint_object(out, spec)
+    return inp, out
