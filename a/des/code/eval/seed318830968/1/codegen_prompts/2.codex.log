+    inp, expected = _render_pair(h, w, specs)
+    if not np.array_equal(main(inp), expected):
+        return None
+
+    parsed = _extract_objects(inp, BG_COLOR)
+    if len(parsed) != object_count:
+        return None
+    return inp
+
