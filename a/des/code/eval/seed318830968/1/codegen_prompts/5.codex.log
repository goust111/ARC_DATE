+def _placement_bits(coords: list[tuple[int, int]], rect_w: int, off_r: int, off_c: int) -> int:
+    bits = 0
+    for rr, cc in coords:
+        bits |= 1 << ((off_r + rr) * rect_w + (off_c + cc))
+    return bits
