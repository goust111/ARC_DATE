+            rows = [rr for rr, _cc in coords]
+            cols = [cc for _rr, cc in coords]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            piece = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in coords:
