+def _transition_tags(rows: list[int]) -> set[str]:
+    tags: set[str] = set()
+    for a, b in zip(rows, rows[1:]):
+        if b < a:
+            tags.add("up")
+        elif b > a:
+            tags.add("down")
+        else:
+            tags.add("flat")
+    return tags
+
