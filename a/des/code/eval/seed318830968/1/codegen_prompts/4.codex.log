+        depth = sum(1 for r0, c0, r1, c1 in rectangles if r0 < r < r1 and c0 < c < c1)
+        info = {
+            "cells": cells,
+            "depth": int(depth),
+            "top": min(rr for rr, _ in cells),
+            "left": min(cc for _, cc in cells),
+        }
+        infos.append(info)
+    infos.sort(key=lambda info: (int(info["depth"]), int(info["top"]), int(info["left"])))
+    return infos
