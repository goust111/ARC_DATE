+    first = pts[int(rng.integers(len(pts)))]
+    chosen = [first]
+    while len(chosen) < count:
+        best = None
+        best_score = -1
+        for idx in rng.permutation(len(pts)):
+            pt = pts[int(idx)]
+            if pt in chosen:
+                continue
