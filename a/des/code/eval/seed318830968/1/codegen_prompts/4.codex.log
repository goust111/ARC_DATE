+    legend_colors = [int(v) for v in rng.choice(np.array(FILL_CHOICES), size=max_depth, replace=False).tolist()]
+    legend_mask = _paint_legend(grid, legend_colors, str(rng.choice(["tl", "tr", "bl", "br"])))
