+        candidates = [(r, 0) for r in range(h) if shell[r, 0]]
+        key = lambda rc: abs(rc[0] - (h - 1) / 2)
+    elif side == "right":
+        candidates = [(r, w - 1) for r in range(h) if shell[r, w - 1]]
+        key = lambda rc: abs(rc[0] - (h - 1) / 2)
+    elif side == "up":
