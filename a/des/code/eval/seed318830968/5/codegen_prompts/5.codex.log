+def shell_from_hole(hole_mask: np.ndarray) -> np.ndarray:
+    h, w = hole_mask.shape
+    shell = np.zeros((h + 2, w + 2), dtype=bool)
+    for r, c in np.argwhere(hole_mask):
+        rr = int(r) + 1
+        cc = int(c) + 1
+        shell[rr - 1 : rr + 2, cc - 1 : cc + 2] = True
