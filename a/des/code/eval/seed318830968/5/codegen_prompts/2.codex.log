+def _mark_blocked(blocked: np.ndarray, coords: np.ndarray, padding: int = 1) -> None:
+    h, w = blocked.shape
+    for r, c in coords:
+        r0 = max(0, int(r) - padding)
+        r1 = min(h - 1, int(r) + padding)
+        c0 = max(0, int(c) - padding)
+        c1 = min(w - 1, int(c) + padding)
