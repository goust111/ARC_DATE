+    remaining = list(posts)
+    order: List[Point] = []
+    while remaining:
+        remaining.sort(key=lambda p: (_manhattan(current, p), p[0], p[1]))
+        order.append(remaining.pop(0))
+        current = order[-1]
+    return order
+
