+    components.sort(key=lambda item: item[0])
+    return [cells for _, cells in components]
+
+
+def _draw_components(shape: tuple[int, int], components: list[list[Cell]], color: int) -> np.ndarray:
+    panel = np.full(shape, BLACK, dtype=int)
+    h, w = shape
+    cur_r = 0
+    cur_c = 0
+    shelf_h = 0
