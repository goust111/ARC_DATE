+                continue
+            seen[r, c] = True
+            queue = deque([(int(r), int(c))])
+            comp: list[Cell] = []
+            while queue:
+                rr, cc = queue.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
