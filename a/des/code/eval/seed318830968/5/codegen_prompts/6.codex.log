+        min_c = min(c for _, c in cells)
+        normalized = sorted((r - min_r, c - min_c) for r, c in cells)
+        order_key = min((rooms[idx].bbox[0], rooms[idx].bbox[1]) for idx in comp_indices)
+        components.append((order_key, normalized))
