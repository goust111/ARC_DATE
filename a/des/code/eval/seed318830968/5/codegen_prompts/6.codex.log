+    out = g.copy()
+    out[:, divider + 1 :] = assembled
+    return out
+
+
+def _inner_endpoint(n: int, side: str) -> Cell:
+    mid = n // 2
+    if side == "left":
+        return (mid, 0)
+    if side == "right":
+        return (mid, n - 1)
+    if side == "up":
+        return (0, mid)
+    if side == "down":
+        return (n - 1, mid)
+    raise ValueError(side)
+
+
+def _port_cell(n: int, side: str) -> Cell:
