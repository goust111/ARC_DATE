+def _reachable_info(n: int, current: Cell, end: Cell, visited: set[Cell]) -> tuple[bool, int, int]:
+    queue = deque([current])
+    seen = {current}
+    dist = {current: 0}
+    while queue:
+        rr, cc = queue.popleft()
+        for nr, nc in _neighbors4(rr, cc):
+            if not (0 <= nr < n and 0 <= nc < n):
+                continue
+            nxt = (nr, nc)
+            if nxt in seen:
+                continue
+            if nxt in visited and nxt != end:
+                continue
+            seen.add(nxt)
+            dist[nxt] = dist[(rr, cc)] + 1
+            queue.append(nxt)
