+
+BLACK = 0
+GREY = 5
+MAROON = 9
+PALETTE = (1, 2, 3, 4, 6, 7, 8)
+
+SIDES = ("up", "right", "down", "left")
+DELTA_TO_SIDE = {
+    (-1, 0): "up",
+    (0, 1): "right",
+    (1, 0): "down",
+    (0, -1): "left",
+}
