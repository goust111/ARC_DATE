+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Reassemble room-local path segments by matching equal-colored ports, then draw the assembled path on the right panel.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
