+
+def _draw_frame(grid: np.ndarray, box: tuple[int, int, int, int], color: int) -> None:
+    r0, c0, r1, c1 = box
+    grid[r0 : r1 + 1, c0] = color
+    grid[r0 : r1 + 1, c1] = color
