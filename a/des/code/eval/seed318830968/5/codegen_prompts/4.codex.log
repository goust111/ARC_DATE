+
+def _place_key_region(grid: np.ndarray) -> tuple[tuple[int, int, int, int], set[int]]:
+    h, w = grid.shape
+    frame_h = random.choice([5, 5, 6])
+    frame_w = random.choice([5, 6, 7])
+    side = random.choice(["top", "bottom", "left", "right"])
