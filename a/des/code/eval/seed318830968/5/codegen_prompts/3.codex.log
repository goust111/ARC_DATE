+        new_border = SYMMETRY_TO_BORDER[kind]
+        out[r0, c0 : c1 + 1] = new_border
+        out[r1, c0 : c1 + 1] = new_border
+        out[r0 : r1 + 1, c0] = new_border
+        out[r0 : r1 + 1, c1] = new_border
