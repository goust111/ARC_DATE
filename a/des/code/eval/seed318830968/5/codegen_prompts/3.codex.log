+
+def _apply_symmetry(arr: np.ndarray, kind: str) -> np.ndarray:
+    if kind == HORIZONTAL:
+        return np.flipud(arr)
+    if kind == VERTICAL:
+        return np.fliplr(arr)
+    if kind == ROTATION:
+        return np.rot90(arr, 2)
+    raise ValueError(kind)
+
+
+def _partner(shape: tuple[int, int], r: int, c: int, kind: str) -> tuple[int, int]:
+    h, w = shape
+    if kind == HORIZONTAL:
+        return h - 1 - r, c
+    if kind == VERTICAL:
+        return r, w - 1 - c
+    if kind == ROTATION:
+        return h - 1 - r, w - 1 - c
+    raise ValueError(kind)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    parts: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            queue = deque([(r, c)])
+            part: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                part.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            parts.append(part)
+    return parts
+
+
+def _find_frames(grid: np.ndarray) -> list[tuple[int, tuple[int, int, int, int]]]:
+    colors = [int(c) for c in np.unique(grid) if int(c) not in (BLACK, ORANGE)]
+    frames: list[tuple[int, tuple[int, int, int, int]]] = []
+    for color in colors:
+        for comp in _components(grid == color):
+            rows = [p[0] for p in comp]
+            cols = [p[1] for p in comp]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
