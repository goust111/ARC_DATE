+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+CYAN = 8
+BROWN = 9
+
+HORIZONTAL = "horizontal"
+VERTICAL = "vertical"
+ROTATION = "rotation"
+SYMMETRY_TYPES = (HORIZONTAL, VERTICAL, ROTATION)
+SYMMETRY_TO_BORDER = {
+    HORIZONTAL: RED,
+    VERTICAL: BLUE,
+    ROTATION: GREEN,
+}
