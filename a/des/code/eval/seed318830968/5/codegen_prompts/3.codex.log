+def _orbits(h: int, w: int, kind: str) -> list[tuple[tuple[int, int], ...]]:
+    seen: set[tuple[tuple[int, int], ...]] = set()
+    orbits: list[tuple[tuple[int, int], ...]] = []
+    for r in range(h):
+        for c in range(w):
+            orbit = tuple(sorted({(r, c), _partner((h, w), r, c, kind)}))
