+                continue
+            seen[r, c] = True
+            queue = deque([(r, c)])
+            part: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                part.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
