+        filled = int(mask.sum())
+        if not (min_cells <= filled <= max_cells):
+            continue
+        if len(np.unique(np.argwhere(mask)[:, 0])) < 2 or len(np.unique(np.argwhere(mask)[:, 1])) < 2:
