+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+GENERATE_RETRIES = 400
