+        cols = _sample_spaced(range(3, w - 1), count, 2)
+        if rows is None or cols is None:
+            return None
+        random.shuffle(cols)
+        centers = list(zip(rows, cols))
+        blocked = np.zeros((h, w), dtype=bool)
+        blocked[:, :2] = True
+        ok = True
+        for center in centers:
