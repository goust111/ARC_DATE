+def generate_input() -> np.ndarray:
+    for _ in range(GENERATE_RETRIES):
+        inp = _try_generate_case()
+        if inp is not None:
+            return inp
+    raise RuntimeError(f"generate_input failed after {GENERATE_RETRIES} attempts")

