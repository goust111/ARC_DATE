+    meta = {
+        "tower_count": len(towers),
+        "tower_colors": {int(color) for _r, _c, color in towers},
+        "ray_cells": int(paint_mask.sum()),
+        "conflict_cells": sum(1 for colors in covered_by.values() if len(colors) >= 2),
+        "tower_stops": int(tower_stop_count),
+    }
+    return out, meta
