+
+def _bfs_path(
+    start: tuple[int, int],
+    goal: tuple[int, int],
+    blocked: set[tuple[int, int]],
+    h: int,
+    w: int,
+) -> list[tuple[int, int]] | None:
+    if start in blocked or goal in blocked:
+        return None
+
+    q = deque([start])
+    prev: dict[tuple[int, int], tuple[int, int] | None] = {start: None}
+    dirs = list(DIRS4)
+    random.shuffle(dirs)
+
+    while q:
+        cell = q.popleft()
+        if cell == goal:
+            break
+        r, c = cell
+        for dr, dc in dirs:
+            nr = r + dr
+            nc = c + dc
+            nxt = (nr, nc)
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if nxt in blocked or nxt in prev:
+                continue
+            prev[nxt] = cell
+            q.append(nxt)
+
+    if goal not in prev:
+        return None
+
+    path: list[tuple[int, int]] = []
+    cur: tuple[int, int] | None = goal
+    while cur is not None:
+        path.append(cur)
+        cur = prev[cur]
+    path.reverse()
+    return path
+
+
+def _route_path(
+    start: tuple[int, int],
+    goal: tuple[int, int],
+    blocked: set[tuple[int, int]],
+    h: int,
+    w: int,
+) -> list[tuple[int, int]] | None:
+    strategies = ["direct", "waypoint"]
+    if random.random() < 0.55:
+        strategies.reverse()
+
+    for strategy in strategies:
+        if strategy == "direct":
+            path = _bfs_path(start, goal, blocked, h, w)
+            if path is not None:
+                return path
+            continue
+
+        free_cells = [
+            (r, c)
+            for r in range(h)
+            for c in range(w)
+            if (r, c) not in blocked and (r, c) not in (start, goal)
+        ]
+        random.shuffle(free_cells)
+        for waypoint in free_cells[:WAYPOINT_TRIES]:
+            if abs(waypoint[0] - start[0]) + abs(waypoint[1] - start[1]) < 3:
+                continue
+            if abs(waypoint[0] - goal[0]) + abs(waypoint[1] - goal[1]) < 3:
+                continue
+            first = _bfs_path(start, waypoint, blocked, h, w)
+            if first is None:
+                continue
+            blocked_second = set(blocked)
+            blocked_second.update(first[:-1])
+            second = _bfs_path(waypoint, goal, blocked_second, h, w)
+            if second is None:
+                continue
+            return first + second[1:]
