+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    if not np.array_equal(main(expected), expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _attempt_scene()
+        if grid is not None:
+            return grid
