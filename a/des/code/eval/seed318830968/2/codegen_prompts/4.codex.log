+    out = g.copy()
+    for comp in path_components:
+        touched: set[int] = set()
+        has_gate = False
+        for r, c in comp:
+            if int(g[r, c]) != GREY:
+                has_gate = True
+            for nr, nc in _neighbors4(r, c, h, w):
+                node_idx = node_by_pos.get((nr, nc))
+                if node_idx is not None:
