+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+NODE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GEN_ATTEMPTS = 400
+FIRST_NODE_TRIES = 48
+SECOND_NODE_TRIES = 64
+WAYPOINT_TRIES = 24
+
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    for dr, dc in DIRS4:
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            out.append((rr, cc))
+    return out
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _square_cells(top: int, left: int) -> list[tuple[int, int]]:
+    return [(r, c) for r in range(top, top + 3) for c in range(left, left + 3)]
+
+
+def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_nodes(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    nodes: list[dict] = []
+    for color in sorted(int(c) for c in np.unique(g)):
+        if color in (BG, GREY):
+            continue
+        for comp in _components(g == color):
+            if len(comp) != 9:
+                continue
+            r0, c0, r1, c1 = _bbox(comp)
+            if (r1 - r0, c1 - c0) != (2, 2):
+                continue
+            solid = True
+            for rr in range(r0, r1 + 1):
+                for cc in range(c0, c1 + 1):
+                    if int(g[rr, cc]) != color:
+                        solid = False
+                        break
+                if not solid:
+                    break
+            if not solid:
+                continue
+            nodes.append(
+                {
+                    "color": color,
+                    "cells": _square_cells(r0, c0),
+                    "bbox": (r0, c0, r1, c1),
+                }
+            )
+    nodes.sort(key=lambda node: node["bbox"])
+    return nodes
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Identify 3x3 colored node pairs linked by grey orthogonal paths.
+
+    When a path contains a single non-grey gate pixel, the two endpoint node
+    colors are swapped and the gate reverts to grey. Paths without a gate keep
+    both endpoint colors unchanged.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
+
+    nodes = _find_nodes(g)
