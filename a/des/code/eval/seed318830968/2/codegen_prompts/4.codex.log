+        if layout is None:
+            return None
+        node_a, node_b, path = layout
+        color_a = node_colors[2 * pair_idx]
+        color_b = node_colors[2 * pair_idx + 1]
+
+        for r, c in _square_cells(*node_a):
+            grid[r, c] = color_a
+        for r, c in _square_cells(*node_b):
+            grid[r, c] = color_b
+        for r, c in path:
