+import numpy as np
+
+
+BG = 0
+GREY = 5
+NODE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GEN_ATTEMPTS = 400
+FIRST_NODE_TRIES = 48
+SECOND_NODE_TRIES = 64
+WAYPOINT_TRIES = 24
