+        second_choices = random.sample(positions_b, min(len(positions_b), SECOND_NODE_TRIES))
+        for node_b in second_choices:
+            center_dist = abs((node_a[0] + 1) - (node_b[0] + 1)) + abs((node_a[1] + 1) - (node_b[1] + 1))
+            if center_dist < 10:
