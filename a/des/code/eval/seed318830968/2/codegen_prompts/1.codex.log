+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    n_pairs = int(rng.integers(MIN_PAIRS, MAX_PAIRS + 1))
+    n_extra_locks = int(rng.integers(0, MAX_EXTRA_LOCKS + 1))
