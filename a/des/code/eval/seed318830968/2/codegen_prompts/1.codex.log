+    canvas_w = int(rng.integers(22, 37))
+
+    key_colors = [int(x) for x in rng.choice(KEY_COLORS, size=n_pairs, replace=False)]
+    used_signatures: set[tuple[int, str, tuple[int, ...]]] = set()
+    objects: list[dict] = []
