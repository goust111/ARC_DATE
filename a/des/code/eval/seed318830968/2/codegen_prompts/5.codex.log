+UP, RIGHT, DOWN, LEFT = range(4)
+DIRS = {
+    UP: (-1, 0),
+    RIGHT: (0, 1),
+    DOWN: (1, 0),
+    LEFT: (0, -1),
+}
+
+REFLECT_BACKSLASH = {
+    RIGHT: DOWN,
+    DOWN: RIGHT,
+    LEFT: UP,
+    UP: LEFT,
+}
+REFLECT_SLASH = {
+    RIGHT: UP,
+    UP: RIGHT,
+    LEFT: DOWN,
+    DOWN: LEFT,
