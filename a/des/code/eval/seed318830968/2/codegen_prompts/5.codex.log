+REFLECT_BACKSLASH = {
+    RIGHT: DOWN,
+    DOWN: RIGHT,
+    LEFT: UP,
+    UP: LEFT,
+}
+REFLECT_SLASH = {
+    RIGHT: UP,
+    UP: RIGHT,
+    LEFT: DOWN,
+    DOWN: LEFT,
+}
