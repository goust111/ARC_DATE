+    r, c = start
+    run: list[tuple[int, int]] = []
+    while True:
+        r += dr
+        c += dc
+        if not _in_bounds(shape, r, c):
+            break
+        if (r, c) in occupied:
+            break
+        run.append((r, c))
+    return run
