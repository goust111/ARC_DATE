+
+
+def _commit_ray(
+    scene: dict[str, object],
+    plan: dict[str, object],
+    color: int,
+) -> None:
+    sources = scene["sources"]
+    targets = scene["targets"]
+    hit_targets = scene["hit_targets"]
+    path_cells = scene["path_cells"]
+    used = scene["used"]
+    mirrors = scene["mirrors"]
+    mirror_cells = scene["mirror_cells"]
