+SOURCE_COLORS = (1, 2, 3, 4, 6, 7)
+
+GEN_H_RANGE = (11, 17)
+GEN_W_RANGE = (11, 17)
+GEN_MAX_ATTEMPTS = 400
+GEN_PATH_ATTEMPTS = 80
+GEN_EXTRA_RAY_PROB = 0.55
+GEN_EXTRA_TARGET_PROB = 0.65
+GEN_EXTRA_MIRROR_PROB = 0.6
+GEN_EXTRA_TARGET_MAX = 2
+GEN_EXTRA_MIRROR_MAX = 3
