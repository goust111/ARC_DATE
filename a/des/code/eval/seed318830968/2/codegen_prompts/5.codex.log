+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _is_edge(shape: tuple[int, int], r: int, c: int) -> bool:
+    return r == 0 or c == 0 or r == shape[0] - 1 or c == shape[1] - 1
