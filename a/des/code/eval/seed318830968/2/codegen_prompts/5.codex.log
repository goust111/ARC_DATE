+    return rec(source, direction, turns, occupied | {source}, set(mirror_cells), [], [])
+
+
+def _plan_ray(
+    shape: tuple[int, int],
+    occupied: set[tuple[int, int]],
+    mirror_cells: set[tuple[int, int]],
+    mode: str,
+    turns_range: tuple[int, int],
+) -> dict[str, object] | None:
+    for _ in range(GEN_PATH_ATTEMPTS):
