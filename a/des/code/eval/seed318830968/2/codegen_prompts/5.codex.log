+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(*GEN_H_RANGE)
+    w = random.randint(*GEN_W_RANGE)
+    shape = (h, w)
+    scene: dict[str, object] = {
+        "used": set(),
+        "mirror_cells": set(),
+        "mirrors": [],
+        "sources": [],
+        "targets": [],
+        "path_cells": set(),
+        "hit_targets": {},
+        "untouched_targets": set(),
+    }
