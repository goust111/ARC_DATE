+            return None
+    for target in untouched_targets:
+        if int(out[target]) != AZURE:
+            return None
+    if not np.any(out != grid):
+        return None
+    if len(scene["sources"]) < 2:
+        return None
+    if len(scene["mirrors"]) < 1:
