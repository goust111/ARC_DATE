+def _search_path(
+    shape: tuple[int, int],
+    source: tuple[int, int],
+    direction: int,
+    mode: str,
+    turns: int,
+    occupied: set[tuple[int, int]],
+    mirror_cells: set[tuple[int, int]],
+) -> dict[str, object] | None:
+    assert mode in {"hit", "miss"}
+
+    def rec(
+        current: tuple[int, int],
+        current_direction: int,
+        turns_left: int,
