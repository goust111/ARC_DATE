0043:     r0, c0, r1, c1 = map(int, best[1])
0044:     box = crop_bbox(g, (r0, c0, r1, c1))
0045:     bh, bw = map(int, box.shape)
0046: 
0047:     # STEP 2) Inside the legend bbox, find the key column:
0048:     # leftmost column with any non-black pixels (the "key pixels").
0049:     key_col = None
