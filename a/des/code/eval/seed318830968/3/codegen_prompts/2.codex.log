+def _build_spec_patch(color: int, move: Coord, pieces: list[np.ndarray]) -> tuple[np.ndarray, np.ndarray] | None:
+    spans = [_shape_spans(piece, move) for piece in pieces]
+    max_cross = max(cross for _axial, cross in spans)
