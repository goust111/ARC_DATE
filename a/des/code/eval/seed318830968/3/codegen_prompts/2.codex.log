+
+def _bbox(coords: np.ndarray) -> BBox:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q: deque[Coord] = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[Coord] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _normalize(coords: np.ndarray) -> np.ndarray:
+    pts = coords.copy()
+    pts[:, 0] -= int(pts[:, 0].min())
+    pts[:, 1] -= int(pts[:, 1].min())
+    order = np.lexsort((pts[:, 1], pts[:, 0]))
+    return pts[order]
+
+
+def _transform_shape(coords: np.ndarray, rot: int, flip: bool) -> np.ndarray:
+    pts = coords.copy()
+    for _ in range(rot):
+        pts = np.stack([pts[:, 1], -pts[:, 0]], axis=1)
+    if flip:
+        pts[:, 1] *= -1
+    return _normalize(pts)
+
+
+def _random_polyomino(size: int) -> np.ndarray:
+    assert 2 <= size <= 5
+    for _ in range(100):
+        cells = {(0, 0)}
+        frontier = {(1, 0), (-1, 0), (0, 1), (0, -1)}
+        while len(cells) < size:
+            cell = random.choice(tuple(frontier))
+            frontier.discard(cell)
+            if cell in cells:
+                continue
+            cells.add(cell)
+            r, c = cell
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                nxt = (r + dr, c + dc)
+                if nxt not in cells:
+                    frontier.add(nxt)
+
+        pts = _normalize(np.array(sorted(cells), dtype=int))
+        pts = _transform_shape(pts, random.randrange(4), random.choice([False, True]))
+        r0, c0, r1, c1 = _bbox(pts)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if size == 4 and h == 2 and w == 2:
+            continue
+        return pts
+    raise RuntimeError("failed to sample polyomino")
