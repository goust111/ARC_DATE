+        if not _inside_bbox(shifted, (0, 0, ih - 1, iw - 1)):
+            return None
+        if np.any(occupied[shifted[:, 0], shifted[:, 1]]):
+            return None
+        while True:
+            nxt = _translate(shifted, dr, dc)
+            if not _inside_bbox(nxt, (0, 0, ih - 1, iw - 1)):
+                break
+            if np.any(occupied[nxt[:, 0], nxt[:, 1]]):
