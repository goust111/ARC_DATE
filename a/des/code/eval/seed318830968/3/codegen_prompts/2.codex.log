+        for piece in pieces:
+            shift = np.array([1 + cross_origin, cursor_right - int(piece[:, 1].max())], dtype=int)
+            placed = piece + shift
+            outside_positions.append(placed)
+            cursor_right = int(placed[:, 1].min()) - random.choice(extra_gap_choices)
