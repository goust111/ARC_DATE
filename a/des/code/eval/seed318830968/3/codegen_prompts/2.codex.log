+    ih, iw = interior_shape
+    fh, fw = ih + 2, iw + 2
+    line_len = random.randint(1, 3)
+    extra_gap_choices = [2, 3]
+
+    outside_positions: list[np.ndarray] = []
+    if dr == 1:
