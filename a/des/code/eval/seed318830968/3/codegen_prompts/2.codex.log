+    pts = {tuple(map(int, p)) for p in coords}
+    perim: list[Coord] = []
+    for c in range(c0, c1 + 1):
+        perim.append((r0, c))
+        perim.append((r1, c))
+    for r in range(r0 + 1, r1):
+        perim.append((r, c0))
+        perim.append((r, c1))
+    perim_set = set(perim)
+    if pts - perim_set:
+        return None
+    missing = sorted(perim_set - pts)
+    if len(missing) != 1:
+        return None
+    gap = missing[0]
+    gr, gc = gap
+    if gr in (r0, r1) and gc in (c0, c1):
+        return None
