+    dr, dc = move
+    t = _entry_steps(coords, move, interior_bbox)
+    shifted = coords + np.array([dr * t, dc * t], dtype=int)
+    assert _inside_bbox(shifted, interior_bbox)
+    assert not np.any(occupied[shifted[:, 0], shifted[:, 1]])
