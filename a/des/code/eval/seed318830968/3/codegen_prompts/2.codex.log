+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+
+BG = 8
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 9]
+DIRS = [(1, 0), (-1, 0), (0, 1), (0, -1)]
+GENERATION_ATTEMPTS = 400
+PLACEMENT_ATTEMPTS = 200
