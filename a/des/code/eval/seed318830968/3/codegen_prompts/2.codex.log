+        inp = np.full((H, W), BG, dtype=int)
+        out = np.full((H, W), BG, dtype=int)
+        for idx, (patch_inp, patch_out) in enumerate(patches):
+            top, left = positions[idx]
+            _overlay(inp, patch_inp, top, left)
+            _overlay(out, patch_out, top, left)
+        return inp, out
+    return None
+
