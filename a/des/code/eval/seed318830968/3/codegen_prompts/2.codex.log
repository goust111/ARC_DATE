+def _fragment_distance(frame_bbox: BBox, move: Coord, frag_bbox: BBox) -> int:
+    r0, c0, r1, c1 = frame_bbox
+    fr0, fc0, fr1, fc1 = frag_bbox
+    dr, dc = move
+    if dr == 1:
