+        legend = _build_legend(rng, side, main_h, main_w, patterns, order)
+        if legend is None:
+            continue
+
+        if side == "right":
+            grid = np.concatenate([main_grid, legend], axis=1)
+        else:
+            grid = np.concatenate([main_grid, legend], axis=0)
+
+        try:
+            produced = main(grid)
+        except Exception:
+            continue
+        if np.array_equal(produced, expected):
+            return grid
+    return None
