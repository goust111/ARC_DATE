+def _rect_contains(outer: tuple[int, int, int, int], inner: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = outer
+    rr0, cc0, rr1, cc1 = inner
+    return r0 < rr0 and c0 < cc0 and rr1 < r1 and cc1 < c1
