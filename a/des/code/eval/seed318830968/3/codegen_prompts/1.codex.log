+        ph, pw = pattern.shape
+        pr = int(rng.integers(0, band_h - ph + 1))
+        pc = int(rng.integers(2, inner.shape[1] - pw + 1))
+        band[pr : pr + ph, pc : pc + pw] = pattern
+        row += band_h
+        if idx < len(gap_sizes):
+            row += gap_sizes[idx]
+    return legend
+
+
