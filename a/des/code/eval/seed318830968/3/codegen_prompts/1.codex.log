+    out = main_grid.copy()
+    roots = [idx for idx, parent in enumerate(parents) if parent is None]
+    assert roots, "no top-level frame structures found"
+    for root in roots:
+        chain = [root]
+        node = root
+        while children[node]:
+            child = min(children[node], key=lambda idx: rings[idx]["area"])
+            chain.append(child)
+            node = child
+        depth = len(chain)
