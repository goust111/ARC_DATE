+            expected[inner_top : inner_top + spec["inner_h"], inner_left : inner_left + spec["inner_w"]] = patch
+
+        legend = _build_legend(rng, side, main_h, main_w, patterns, order)
+        if legend is None:
+            continue
+
+        if side == "right":
+            grid = np.concatenate([main_grid, legend], axis=1)
+        else:
+            grid = np.concatenate([main_grid, legend], axis=0)
+
+        try:
+            produced = main(grid)
+        except Exception:
+            continue
+        if np.array_equal(produced, expected):
+            return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate a valid input after {MAX_GENERATION_ATTEMPTS} attempts")

