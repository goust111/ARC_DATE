+
+def _parse_legend(legend: np.ndarray) -> dict[int, np.ndarray]:
+    inner = legend[1:-1, 1:-1]
+    row_intervals = _find_intervals(np.any(inner != BG, axis=1))
+    mapping: dict[int, np.ndarray] = {}
