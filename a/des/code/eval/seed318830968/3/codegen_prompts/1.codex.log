+        r0, c0, r1, c1 = rings[chain[-1]]["bbox"]
+        inner_h = r1 - r0 - 1
+        inner_w = c1 - c0 - 1
+        assert inner_h > 0 and inner_w > 0
+        patch = _tile_pattern(inner_h, inner_w, mapping[depth])
+        out[r0 + 1 : r1, c0 + 1 : c1] = patch
+    return out
+
