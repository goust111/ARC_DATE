+import math
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+MAROON = 9
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+MAX_GENERATION_ATTEMPTS = 400
