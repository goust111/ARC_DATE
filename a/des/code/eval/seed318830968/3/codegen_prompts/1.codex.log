+            ww = c1 - c0 + 1
+            if hh < 3 or ww < 3:
+                continue
+            local = np.zeros((hh, ww), dtype=bool)
+            for r, c in comp:
+                local[r - r0, c - c0] = True
+            if np.array_equal(local, _border_mask(hh, ww)):
+                rings.append({"color": col, "bbox": (r0, c0, r1, c1), "area": hh * ww})
+    return rings
