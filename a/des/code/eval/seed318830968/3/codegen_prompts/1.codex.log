+        assert count > 0
+        pat_mask = (band != BG) & (band != MAROON)
+        assert np.any(pat_mask), "missing pattern sample"
+        rows, cols = np.where(pat_mask)
+        pr0, pr1 = int(rows.min()), int(rows.max())
+        pc0, pc1 = int(cols.min()), int(cols.max())
