+    elif family == 1:
+        pattern[:, ::2] = a
+        pattern[:, 1::2] = b
+    elif family == 2:
+        pattern[::2, :] = a
+        pattern[1::2, :] = b
+    elif family == 3:
+        pattern[:, :] = a
+        pattern[height // 2, :] = b
+        pattern[:, width // 2] = b
+    elif family == 4:
+        pattern[:, :] = a
+        pattern[0, :] = b
+        pattern[-1, :] = b
+        pattern[:, 0] = b
+        pattern[:, -1] = b
+    else:
