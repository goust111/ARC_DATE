+    h, w = grid.shape
+    candidates = []
+    for comp in grey_components:
+        r0, c0, r1, c1 = _bbox_from_coords(comp)
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        if hh < 3 or ww < 3:
+            continue
+        local = np.zeros((hh, ww), dtype=bool)
