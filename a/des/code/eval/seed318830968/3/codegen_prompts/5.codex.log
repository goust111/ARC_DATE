+        if not _place_triggers(grid, anchors, direction, line_offset, int(stamp.shape[0])):
+            continue
+
+        trigger_colors = {int(color) for color in grid.ravel() if int(color) in (RED, BLUE, GREEN)}
+        if trigger_colors != {RED, BLUE, GREEN}:
