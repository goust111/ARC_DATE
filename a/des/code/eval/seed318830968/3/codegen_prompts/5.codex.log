+    cells = {(sr + k * dr, sc + k * dc) for k in range(int(length))}
+    er = sr + (length - 1) * dr
+    ec = sc + (length - 1) * dc
+    if direction == RIGHT:
+        cells.add((er - 1, ec - 1))
+        cells.add((er + 1, ec - 1))
+    elif direction == LEFT:
+        cells.add((er - 1, ec + 1))
+        cells.add((er + 1, ec + 1))
+    elif direction == DOWN:
+        cells.add((er - 1, ec - 1))
+        cells.add((er - 1, ec + 1))
+    else:
