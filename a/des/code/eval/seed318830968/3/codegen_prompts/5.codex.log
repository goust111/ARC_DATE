    """Return all (h, w) bboxes where area fits with fill_ratio >= MIN_FILL_RATIO_X10/10."""
    dims = []
    for h in range(1, BBOX_MAX + 1):
        for w in range(1, BBOX_MAX + 1):
            if area > h * w:
