+
+    bbox = (r0, c0, r0 + size - 1, c0 + size - 1)
+    anchors = []
+    step = 1
+    while True:
+        rr, cc = _stamp_anchor(bbox, step, direction)
+        if rr < 0 or cc < 0 or rr + size > height or cc + size > width:
