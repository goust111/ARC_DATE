+            grid[rr, cc] = color
+            occupied.add((rr, cc))
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        stamp = _make_sprite()
+        direction = random.choice(DIRECTIONS)
