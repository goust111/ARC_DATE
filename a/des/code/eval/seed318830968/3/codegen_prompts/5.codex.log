+
+
+def _multi_trigger_positions(
+    anchor: tuple[int, int],
+    direction: tuple[int, int],
+    line_offset: int,
+    size: int,
+    count: int,
+) -> list[tuple[int, int]]:
+    ar, ac = anchor
+    if direction in (LEFT, RIGHT):
+        row = ar + ((line_offset + 1) % size)
+        if count == 2:
+            cols = [ac, ac + size - 1]
+        else:
+            cols = [ac, ac + 2, ac + 4]
+        return [(row, col) for col in cols]
+
+    col = ac + ((line_offset + 1) % size)
+    if count == 2:
+        rows = [ar, ar + size - 1]
+    else:
+        rows = [ar, ar + 2, ar + 4]
+    return [(row, col) for row in rows]
+
+
+def _single_trigger_position(
+    anchor: tuple[int, int],
+    direction: tuple[int, int],
+    line_offset: int,
+    occupied: set[tuple[int, int]],
+    grid: np.ndarray,
+    size: int,
+) -> tuple[int, int] | None:
+    ar, ac = anchor
+    candidates = []
+    for rr in range(ar, ar + size):
+        for cc in range(ac, ac + size):
+            if (rr, cc) in occupied:
+                continue
+            if int(grid[rr, cc]) != BLACK:
+                continue
+            if direction in (LEFT, RIGHT) and rr == ar + line_offset:
