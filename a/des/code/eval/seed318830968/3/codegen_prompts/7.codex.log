+BG = 8
+BLACK = 0
+GREY = 5
+MAROON = 9
+OBJECT_COLORS = (1, 2, 3, 4, 6, 7)
+RESERVED_COLORS = {BG, BLACK, GREY, MAROON}
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+STYLE_BY_DIRECTION = {
+    "horizontal": "solid",
+    "vertical": "dashed",
+    "diagonal": "double",
+}
