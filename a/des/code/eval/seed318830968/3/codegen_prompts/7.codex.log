+
+def _legend_mapping(legend: np.ndarray) -> dict[str, str]:
+    is_separator = np.all(legend == GREY, axis=0)
+    patches: list[np.ndarray] = []
+    c = 0
+    while c < legend.shape[1]:
+        while c < legend.shape[1] and is_separator[c]:
+            c += 1
+        if c >= legend.shape[1]:
