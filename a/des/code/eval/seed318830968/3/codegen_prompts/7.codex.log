+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _same_color_components(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    comps: list[dict[str, object]] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if visited[r, c] or color == bg:
+                continue
+
+            stack = [(r, c)]
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and int(grid[nr, nc]) == color:
+                        visited[nr, nc] = True
+                        stack.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": _bbox_from_coords(arr),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def _ring_cells(
+    shape: tuple[int, int], bbox: tuple[int, int, int, int], dist: int
+) -> list[tuple[int, int]]:
+    h, w = shape
+    r0, c0, r1, c1 = bbox
+    rr0 = r0 - dist
+    rr1 = r1 + dist
+    cc0 = c0 - dist
+    cc1 = c1 + dist
+    cells: set[tuple[int, int]] = set()
+
+    for c in range(cc0, cc1 + 1):
+        if 0 <= rr0 < h and 0 <= c < w:
+            cells.add((rr0, c))
+        if 0 <= rr1 < h and 0 <= c < w:
+            cells.add((rr1, c))
+    for r in range(rr0 + 1, rr1):
+        if 0 <= r < h and 0 <= cc0 < w:
+            cells.add((r, cc0))
+        if 0 <= r < h and 0 <= cc1 < w:
+            cells.add((r, cc1))
+    return sorted(cells)
+
+
+def _direction_from_bbox(bbox: tuple[int, int, int, int]) -> str:
+    r0, c0, r1, c1 = bbox
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    if width > height:
+        return "horizontal"
+    if height > width:
+        return "vertical"
+    return "diagonal"
+
+
+def _paint_border(
