+        overlap = False
+        for i in range(len(bboxes)):
+            ring_i = _ring_area((top_h, top_w), bboxes[i], styles[i])
+            for j in range(i + 1, len(bboxes)):
+                ring_j = _ring_area((top_h, top_w), bboxes[j], styles[j])
+                if ring_i & ring_j:
