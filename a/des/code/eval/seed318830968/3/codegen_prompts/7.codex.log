+        if any(v == MAROON for v in ring2_vals):
+            style = "double"
+        elif any(v == BLACK for v in ring1_vals):
+            style = "dashed"
+        else:
+            style = "solid"
+        mapping[direction] = style
+
+    assert set(mapping) == {"horizontal", "vertical", "diagonal"}
+    return mapping
+
