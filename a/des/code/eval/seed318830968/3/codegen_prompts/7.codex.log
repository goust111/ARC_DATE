+RESERVED_COLORS = {BG, BLACK, GREY, MAROON}
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+STYLE_BY_DIRECTION = {
+    "horizontal": "solid",
+    "vertical": "dashed",
