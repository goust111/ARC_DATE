+    h, w = shape
+    r0, c0, r1, c1 = bbox
+    rr0 = r0 - dist
+    rr1 = r1 + dist
+    cc0 = c0 - dist
+    cc1 = c1 + dist
+    cells: set[tuple[int, int]] = set()
