+def _ring_cells(
+    shape: tuple[int, int], bbox: tuple[int, int, int, int], dist: int
+) -> list[tuple[int, int]]:
+    h, w = shape
+    r0, c0, r1, c1 = bbox
+    rr0 = r0 - dist
+    rr1 = r1 + dist
+    cc0 = c0 - dist
+    cc1 = c1 + dist
+    cells: set[tuple[int, int]] = set()
+
+    for c in range(cc0, cc1 + 1):
+        if 0 <= rr0 < h and 0 <= c < w:
+            cells.add((rr0, c))
+        if 0 <= rr1 < h and 0 <= c < w:
+            cells.add((rr1, c))
+    for r in range(rr0 + 1, rr1):
