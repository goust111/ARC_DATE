+
+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    separator_rows = np.where(np.all(g == GREY, axis=1))[0]
+    assert len(separator_rows) > 0
+    sep = int(separator_rows[-1])
+
+    top = g[:sep, :].copy()
+    legend = g[sep + 1 :, :]
+    mapping = _legend_mapping(legend)
