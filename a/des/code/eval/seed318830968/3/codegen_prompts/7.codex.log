+def _build_top_canvas(
+    top_h: int,
+    top_w: int,
+    directions: list[str],
+    colors: list[int],
+    require_overlap: bool,
+) -> np.ndarray | None:
+    used_areas: set[int] = set()
+    masks = []
+    for direction in directions:
+        mask = _make_object_mask(direction, used_areas)
+        used_areas.add(int(mask.sum()))
+        masks.append(mask)
