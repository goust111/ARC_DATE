+) -> dict | None:
+    temp_min = max(11, 2 * min_depth + 7)
+    for _ in range(SHAPE_TRIES):
+        h = rng.randint(temp_min, max(temp_min, 17))
+        w = rng.randint(temp_min, max(temp_min, 17))
