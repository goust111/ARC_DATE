+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+COLOR_POOL = tuple(c for c in range(10) if c not in (BG, WALL))
+
+GEN_MAX_ATTEMPTS = 250
+GRID_H_RANGE = (24, 34)
+GRID_W_RANGE = (24, 34)
+LEGEND_LENGTHS = (2, 3, 4)
+REGION_COUNT_CHOICES = (2, 3, 4)
+SHAPE_TRIES = 200
+PLACEMENT_TRIES = 250
