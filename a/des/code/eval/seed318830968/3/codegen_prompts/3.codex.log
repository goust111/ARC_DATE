+) -> tuple[int, int] | None:
+    h, w = forbidden.shape
+    rh, rw = region["height"], region["width"]
+    row_lo = 1
+    col_lo = 1
+    row_hi = h - rh - 1
+    col_hi = w - rw - 1
+    if row_hi < row_lo or col_hi < col_lo:
+        return None
+    occupied_local = region["cells"] | region["boundary"]
+    for _ in range(PLACEMENT_TRIES):
