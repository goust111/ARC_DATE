+
+        for _ in range(rng.randint(1, 4)):
+            side = rng.choice(("T", "B", "L", "R", "TL", "TR", "BL", "BR"))
+            if side == "T" and core_h >= 4 and core_w >= 4:
+                depth = rng.randint(1, min(2, core_h - 2))
