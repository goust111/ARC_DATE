+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+
+    legend_cells, palette = _detect_legend(g)
+    work = g.copy()
+    for r, c in legend_cells:
+        work[r, c] = BG
