+            dr, dc = rng.choice(((1, 0), (-1, 0), (0, 1), (0, -1)))
+            sr, sc = center[0] + dr, center[1] + dc
+            if 1 <= sr < h - 1 and 1 <= sc < w - 1:
+                cells.add((sr, sc))
+
+        stalled = 0
+        while len(cells) < target_area and stalled < target_area * 3:
+            frontier = []
+            weights = []
+            seen = set()
+            for r, c in list(cells):
+                for nr, nc in neighbors4(r, c):
+                    if not (1 <= nr < h - 1 and 1 <= nc < w - 1):
+                        continue
+                    if (nr, nc) in cells or (nr, nc) in seen:
+                        continue
+                    seen.add((nr, nc))
+                    deg = sum((xr, xc) in cells for xr, xc in neighbors4(nr, nc))
+                    dist_to_center = abs(nr - center[0]) + abs(nc - center[1])
+                    weight = deg * deg + max(1, 10 - dist_to_center)
+                    frontier.append((nr, nc))
+                    weights.append(weight)
+            if not frontier:
+                break
+            cells.add(rng.choices(frontier, weights=weights, k=1)[0])
+            stalled += 1
+
+        if len(cells) < target_area_lo:
+            continue
+        if _has_hole(cells, h, w):
+            continue
+
+        boundary = _boundary_of(cells, h, w)
+        if not boundary:
+            continue
+        boundary_mask = np.zeros((h, w), dtype=bool)
+        for r, c in boundary:
+            boundary_mask[r, c] = True
+        if len(_components(boundary_mask)) != 1:
+            continue
+
+        dists = _distance_layers(list(cells), boundary_mask)
+        max_depth = max(dists.values())
+        if max_depth < min_depth:
+            continue
+
+        ch, cw, cropped_cells, cropped_boundary = _crop_shape(cells, boundary)
+        cropped_wall = np.zeros((ch, cw), dtype=bool)
+        for r, c in cropped_boundary:
+            cropped_wall[r, c] = True
