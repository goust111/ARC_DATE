+    q: deque[tuple[int, int]] = deque()
+    for r, c in region_cells:
+        if any(0 <= nr < h and 0 <= nc < w and wall_mask[nr, nc] for nr, nc in neighbors4(r, c)):
+            dist[(r, c)] = 0
+            q.append((r, c))
+    assert q, "region must have an inner layer adjacent to a wall"
+    while q:
+        r, c = q.popleft()
