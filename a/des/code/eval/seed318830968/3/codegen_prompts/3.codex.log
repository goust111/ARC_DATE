+def _boundary_of(cells: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:
+    boundary: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
