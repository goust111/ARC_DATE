+
+
+def _has_hole(cells: set[tuple[int, int]], h: int, w: int) -> bool:
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
+    for comp in _components(~mask):
