+        return {
+            "height": ch,
+            "width": cw,
+            "cells": cropped_cells,
+            "boundary": cropped_boundary,
+            "dists": cropped_dists,
+            "seed_local": seed,
+            "category": category,
+        }
+    return None
+
+
+def _legend_cells(h: int, w: int, corner: str, colors: list[int]) -> list[tuple[int, int]]:
+    length = len(colors)
+    if corner == "TL":
