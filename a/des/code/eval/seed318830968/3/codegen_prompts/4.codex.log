    dr, dc = vec
    return -dc, dr


def _turn_kind(prev_vec: tuple[int, int], next_vec: tuple[int, int]) -> str | None:
    if _rot_ccw(prev_vec) == next_vec:
        return "L"
    if _rot_cw(prev_vec) == next_vec:
        return "R"
    return None


def _neighbors4(cell: tuple[int, int]) -> tuple[tuple[int, int], ...]:
