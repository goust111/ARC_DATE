/bin/bash -lc "python - <<'PY'
from random import sample

def cw(v):
    dr,dc=v; return (dc,-dr)
def ccw(v):
    dr,dc=v; return (-dc,dr)
def fold(path, marks):
    pts=[list(p) for p in path]
    for k in marks:
        prev=(pts[k][0]-pts[k-1][0], pts[k][1]-pts[k-1][1])
        nxt=(pts[k+1][0]-pts[k][0], pts[k+1][1]-pts[k][1])
        if ccw(prev)==nxt:
            rot=ccw
        elif cw(prev)==nxt:
            rot=cw
        else:
            return None
        pr,pc=pts[k]
        for j in range(k+1,len(pts)):
            dr=pts[j][0]-pr; dc=pts[j][1]-pc
            rr,cc=rot((dr,dc))
            pts[j]=[pr+rr,pc+cc]
    return [tuple(p) for p in pts]

def snake(rows,width,gap):
    pts=[(0,0)]
    r=c=0
    dir=1
    for row in range(rows):
        target_c=width-1 if dir==1 else 0
        while c"'!=target_c:
            c+=dir
            pts.append((r,c))
        if row==rows-1:
            break
        for _ in range(gap):
            r+=1
            pts.append((r,c))
        dir*=-1
    return pts

def turns(path):
    out=[]
    for i in range(1,len(path)-1):
        a=(path[i][0]-path[i-1][0], path[i][1]-path[i-1][1])
        b=(path[i+1][0]-path[i][0], path[i+1][1]-path[i][1])
        if a!=b: out.append(i)
    return out

def norm(pts):
    rs=[r for r,c in pts]; cs=[c for r,c in pts]
    r0,c0=min(rs),min(cs)
    return sorted((r-r0,c-c0) for r,c in pts)

examples=[(6,3,3,(5,12,15,22)),(7,4,2,(10,20)),(5,3,3,(5,12,15))]
for ex in examples:
    rows,width,gap,marks=ex
    path=snake(rows,width,gap)
    f1=fold(path,marks)
    rpath=list(reversed(path))
    marks2=tuple(len(path)-1-m for m in reversed(marks))
    f2=fold(rpath,marks2)
    print(ex, norm(f1)==norm(f2), len(set(f1)), len(set(f2)))
