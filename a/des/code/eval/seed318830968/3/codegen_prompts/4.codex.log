from itertools import combinations

def cw(v):
    dr,dc=v; return (dc,-dr)
def ccw(v):
    dr,dc=v; return (-dc,dr)

def fold(path, marks):
    pts=[list(p) for p in path]
    for k in marks:
        prev=(pts[k][0]-pts[k-1][0], pts[k][1]-pts[k-1][1])
        nxt=(pts[k+1][0]-pts[k][0], pts[k+1][1]-pts[k][1])
        if ccw(prev)==nxt:
            rot=ccw
        elif cw(prev)==nxt:
            rot=cw
        else:
            return None
        pr,pc=pts[k]
        for j in range(k+1,len(pts)):
            dr=pts[j][0]-pr; dc=pts[j][1]-pc
            rr,cc=rot((dr,dc))
            pts[j]=[pr+rr,pc+cc]
    return [tuple(p) for p in pts]

def render(path, marks):
    pts=fold(path, marks)
    if pts is None:
        return None
    last={}
    n=len(pts)
    for i,p in enumerate(pts):
        if i==0 or i==n-1:
            color='G'
        elif i in marks:
            color='M'
        else:
            color='O'
        last[p]=color
    rs=[r for r,c in last]; cs=[c for r,c in last]
    r0,c0=min(rs),min(cs)
    H=max(rs)-r0+1; W=max(cs)-c0+1
    arr=[['.' for _ in range(W)] for _ in range(H)]
    for (r,c),v in last.items():
        arr[r-r0][c-c0]=v
    return tuple(''.join(row) for row in arr)

def snake(rows,width,gap):
    pts=[(0,0)]
    r=c=0
    dir=1
