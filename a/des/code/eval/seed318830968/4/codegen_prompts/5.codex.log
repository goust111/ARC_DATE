+        grid[int(r), 0] = _RULER
+    for c in col_lines:
+        grid[0, int(c)] = _RULER
+    for frag in placed:
+        r0 = int(frag["r0"])
+        c0 = int(frag["c0"])
+        grid[r0 : r0 + int(frag["h"]), c0 : c0 + int(frag["w"])] = int(frag["color"])
+    return grid
