+# Visible warm-to-cool order for duplicate-size tie-breaking.
+_SPECTRUM_ORDER = (2, 7, 4, 3, 8, 1, 6, 9)
+_SPECTRUM_RANK = {color: i for i, color in enumerate(_SPECTRUM_ORDER)}
+
