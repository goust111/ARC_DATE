+    h, w = g.shape
+    bg = _mode_color(g)
+    ruler, slots, row_lines, col_lines = _slot_specs(g)
+    fragments = _extract_fragments(g, bg, ruler)
+    assert len(fragments) == len(slots), "fragment count must match slot count"
