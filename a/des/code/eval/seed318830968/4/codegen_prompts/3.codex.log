+        ]
+        rng.shuffle(multi_options)
+        for shape_id in multi_options:
+            picked = _pick_multi_arrows(rng, shapes[shape_id], candidates_by_shape[shape_id])
+            if picked is not None:
+                selection.extend(picked)
