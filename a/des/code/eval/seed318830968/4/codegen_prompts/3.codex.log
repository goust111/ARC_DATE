+    if direction == "left":
+        return bool(np.all(grid[r, hit + 1 : c + 1] == BG))
+    if direction == "down":
+        return bool(np.all(grid[r:hit, c] == BG))
+    return bool(np.all(grid[hit + 1 : r + 1, c] == BG))
