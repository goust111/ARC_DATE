+    uniq: dict[tuple[tuple[int, int], str, int], dict[str, object]] = {}
+    for cand in selection:
+        uniq[(cand["tail"], cand["direction"], cand["length"])] = cand
+    selection = list(uniq.values())
+    return selection or None
