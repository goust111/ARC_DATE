+import random
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+BG = 8
+GREY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 9)
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+DIRS8 = DIRS4 + ((1, 1), (1, -1), (-1, 1), (-1, -1))
+ARROW_DIRS = ("right", "left", "down", "up")
+MAX_GENERATION_ATTEMPTS = 300
