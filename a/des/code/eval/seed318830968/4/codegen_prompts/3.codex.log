+    return shapes, shape_id_grid
+
+
+def _ray_target(shape_id_grid: np.ndarray, arrow: dict[str, object]) -> int:
+    r, c = arrow["tip"]
+    dr, dc = arrow["delta"]
+    while _in_bounds(shape_id_grid.shape, r, c):
