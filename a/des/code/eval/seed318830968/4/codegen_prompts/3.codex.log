+
+def _chamfer_frame(h: int, w: int) -> np.ndarray:
+    mask = _rect_frame(h, w)
+    mask[0, 0] = False
+    mask[0, -1] = False
+    mask[-1, 0] = False
+    mask[-1, -1] = False
+    return mask
+
+
+def _shape_template(rng: random.Random) -> dict[str, object]:
+    kind = rng.choice(("rect", "rect", "chamfer"))
+    if kind == "rect":
+        h = rng.randint(3, 5)
+        w = rng.randint(3, 5)
+        frame = _rect_frame(h, w)
+    else:
+        h = rng.randint(4, 5)
+        w = rng.randint(4, 5)
