+        frame_mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        frame_mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+        enclosed = _enclosed_mask(frame_mask)
