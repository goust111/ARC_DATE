+def _stripe_order_key(arrow: dict[str, object], vertical: bool) -> tuple[int, int]:
+    tr, tc = arrow["tail"]
+    return (tc, tr) if vertical else (tr, tc)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
