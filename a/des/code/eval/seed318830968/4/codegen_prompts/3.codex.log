+        for direction, line_hits in hits.items():
+            for axis_value, hit_value in line_hits.items():
+                if direction in {"right", "left"}:
+                    r = axis_value
+                    if not (1 <= r < h - 1):
+                        continue
+                    span = 6 if direction == "right" else w - 6
+                    tips = _candidate_tip_range(hit_value, span, direction)
