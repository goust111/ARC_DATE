+def _rect_frame(h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _chamfer_frame(h: int, w: int) -> np.ndarray:
+    mask = _rect_frame(h, w)
+    mask[0, 0] = False
+    mask[0, -1] = False
+    mask[-1, 0] = False
+    mask[-1, -1] = False
+    return mask
