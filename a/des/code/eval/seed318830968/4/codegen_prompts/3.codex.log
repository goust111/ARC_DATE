+def _draw_arrows(grid: np.ndarray, arrows: list[dict[str, object]]) -> None:
+    for arrow in arrows:
+        for r, c in arrow["grey_cells"]:
+            grid[r, c] = GREY
+        tr, tc = arrow["tail"]
+        grid[tr, tc] = int(arrow["color"])
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(18, 26)
+    w = rng.randint(18, 26)
