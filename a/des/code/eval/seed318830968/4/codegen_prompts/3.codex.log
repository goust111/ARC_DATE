+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _component_coords(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    neigh = DIRS4 if connectivity == 4 else DIRS8
+    components: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                cr, cc = queue.popleft()
+                coords.append((cr, cc))
+                for dr, dc in neigh:
+                    nr, nc = cr + dr, cc + dc
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+    return components
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _enclosed_mask(frame_mask: np.ndarray) -> np.ndarray:
+    h, w = frame_mask.shape
+    open_mask = ~frame_mask
+    seen = np.zeros_like(frame_mask, dtype=bool)
+    queue: deque[tuple[int, int]] = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if open_mask[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                queue.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if open_mask[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                queue.append((r, c))
+
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in DIRS4:
+            nr, nc = r + dr, c + dc
+            if _in_bounds(frame_mask.shape, nr, nc) and open_mask[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                queue.append((nr, nc))
+
+    return open_mask & ~seen
+
+
+def _build_arrow(direction: str, tip: tuple[int, int], length: int) -> dict[str, object]:
+    r, c = tip
+    if direction == "right":
+        shaft = [(r, cc) for cc in range(c - length, c)]
+        head = [(r - 1, c), (r + 1, c)]
+        tail = (r, c - length - 1)
+        delta = (0, 1)
+    elif direction == "left":
+        shaft = [(r, cc) for cc in range(c + 1, c + length + 1)]
+        head = [(r - 1, c), (r + 1, c)]
+        tail = (r, c + length + 1)
+        delta = (0, -1)
+    elif direction == "down":
+        shaft = [(rr, c) for rr in range(r - length, r)]
+        head = [(r, c - 1), (r, c + 1)]
+        tail = (r - length - 1, c)
+        delta = (1, 0)
+    else:
+        shaft = [(rr, c) for rr in range(r + 1, r + length + 1)]
+        head = [(r, c - 1), (r, c + 1)]
+        tail = (r + length + 1, c)
+        delta = (-1, 0)
+
+    grey_cells = shaft + head
+    cells = grey_cells + [tail]
+    return {
+        "direction": direction,
+        "tip": tip,
+        "length": int(length),
+        "shaft": shaft,
+        "head": head,
+        "grey_cells": grey_cells,
+        "tail": tail,
+        "cells": cells,
+        "delta": delta,
+    }
+
+
+def _detect_arrows(grid: np.ndarray) -> list[dict[str, object]]:
+    h, w = grid.shape
