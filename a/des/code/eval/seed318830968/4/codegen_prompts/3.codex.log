+def _can_place(occupied: np.ndarray, top: int, left: int, h: int, w: int, gap: int = 2) -> bool:
+    h0, w0 = occupied.shape
+    r0 = max(0, top - gap)
+    c0 = max(0, left - gap)
+    r1 = min(h0, top + h + gap)
+    c1 = min(w0, left + w + gap)
+    return not np.any(occupied[r0:r1, c0:c1])
