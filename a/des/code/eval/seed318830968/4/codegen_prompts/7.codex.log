+    ("R", -1): (2, 0),
+    ("R", 1): (0, 0),
+    ("L", -1): (2, 2),
+    ("L", 1): (0, 2),
+    ("D", -1): (0, 2),
+    ("D", 1): (0, 0),
+    ("U", -1): (2, 2),
