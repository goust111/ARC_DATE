+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+AZURE = 8
+MAROON = 9
+
+PALETTE_PATCH = np.array([[RED, BLUE], [GREEN, YELLOW]], dtype=int)
+CYCLE_ORDER = [RED, BLUE, GREEN, YELLOW]
