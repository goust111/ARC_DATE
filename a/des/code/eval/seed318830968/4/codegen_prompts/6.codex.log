+def _reserve(occupied: np.ndarray, origin: tuple[int, int], shape: tuple[int, int]) -> None:
+    h, w = occupied.shape
+    r0, c0 = origin
+    sh, sw = shape
+    occupied[max(0, r0 - 1) : min(h, r0 + sh + 1), max(0, c0 - 1) : min(w, c0 + sw + 1)] = True
+
