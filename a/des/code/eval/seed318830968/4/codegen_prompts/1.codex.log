+        candidates.append(opts)
+    order = sorted(range(len(frames)), key=lambda idx: len(candidates[idx]))
+    used: set[int] = set()
+    assignment: list[tuple[int, int] | None] = [None] * len(frames)
+
+    def dfs(pos: int) -> bool:
+        if pos == len(order):
+            return True
+        fi = order[pos]
+        for pi, rot in candidates[fi]:
