+def _sorted_coords(coords: np.ndarray, rotation_cw: int) -> list[tuple[int, int]]:
+    pts = [(int(r), int(c)) for r, c in coords]
+    rot = int(rotation_cw) % 4
+    if rot == 0:
+        key = lambda rc: (rc[0], rc[1])
+    elif rot == 1:
+        key = lambda rc: (-rc[1], rc[0])
+    elif rot == 2:
+        key = lambda rc: (-rc[0], -rc[1])
+    else:
