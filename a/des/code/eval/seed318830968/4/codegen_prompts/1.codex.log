+def _has_internal_hole(mask: np.ndarray) -> bool:
+    m = _normalize_mask(mask)
+    if m.size == 0:
+        return False
+    h, w = m.shape
+    empty = ~m
+    seen = np.zeros((h, w), dtype=bool)
+    stack: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in (0, w - 1):
+            if empty[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if empty[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+    while stack:
+        cr, cc = stack.pop()
+        for dr, dc in DIRS4:
+            nr, nc = cr + dr, cc + dc
+            if 0 <= nr < h and 0 <= nc < w and empty[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                stack.append((nr, nc))
