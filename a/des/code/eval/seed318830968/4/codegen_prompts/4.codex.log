+            colors = {int(p["color"]) for p in props}
+            if len(colors) != 1:
+                claimed[key] = None
+                continue
+            prop = props[0]
+            claimed[key] = int(prop["color"])
+            new_frontier.append(prop)
+        frontier = new_frontier
+        t += 1
+
+    for key, color in claimed.items():
+        if color is None:
+            continue
+        if key[0] == "seg":
