+def _candidate_cells(orient: str, fixed: int, start: int, end: int) -> set[tuple[int, int]]:
+    if orient == "H":
+        return {(fixed, c) for c in range(start, end + 1)}
+    return {(r, fixed) for r in range(start, end + 1)}
