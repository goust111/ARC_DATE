+                            "type": "seg",
+                            "segment": seg["id"],
+                            "index": idx,
+                            "dir": direction,
+                            "color": color,
+                        }
+                    )
+
+        new_frontier = []
+        for key, props in proposals.items():
+            if key in claimed:
