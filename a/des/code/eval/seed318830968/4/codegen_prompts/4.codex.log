+                node = nodes[state["node"]]
+                if node["wide"]:
+                    out_sides = [side for side in node["incidents"] if side != state["enter_side"]]
+                else:
+                    straight = OPPOSITE[state["enter_side"]]
+                    out_sides = [straight] if straight in node["incidents"] else []
+                for side in out_sides:
