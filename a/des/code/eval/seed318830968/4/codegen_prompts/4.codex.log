+def _valid_new_strip(strips: list[dict], cand: dict, parent_id: int | None, attach_pos: tuple[int, int] | None) -> bool:
+    start = min(cand["start"], cand["end"])
+    end = max(cand["start"], cand["end"])
+    if end - start < 6:
+        return False
