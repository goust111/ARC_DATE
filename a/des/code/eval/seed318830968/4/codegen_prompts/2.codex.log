 483: def _place_yellows(rng: random.Random, regions: list[dict],
 484:                    grid: np.ndarray) -> bool:
 485:     """Choose yellow output positions and reverse-slide to derive input positions.
 486: 
 487:     Modifies grid in-place by painting yellow(4) at input positions.
 488:     Returns True on success.
 489:     """
 490:     for reg in regions:
 491:         blob = reg['interior']
 492:         dr, dc = reg['dir']
 493:         n_yellows = rng.choice(YELLOWS_PER_REGION)
 494: 
 495:         # Cells sorted by projection onto slide direction (farthest first).
 496:         cells_sorted = sorted(blob, key=lambda p: dr * p[0] + dc * p[1], reverse=True)
 497:         far_key = dr * cells_sorted[0][0] + dc * cells_sorted[0][1]
 498:         tier1 = [p for p in cells_sorted if dr * p[0] + dc * p[1] == far_key]
 499: 
 500:         # Pick output positions: first at the farthest tier, second one step behind or at tier1.
 501:         first = tier1[rng.randrange(len(tier1))]
 502:         output_positions = [first]
 503: 
 504:         if n_yellows == 2:
 505:             pr, pc = first[0] - dr, first[1] - dc
 506:             cands = ([(pr, pc)] if (pr, pc) in blob else []) + [p for p in tier1 if p != first]
 507:             if cands:
 508:                 second = cands[rng.randrange(len(cands))]
 509:                 if second != first:
 510:                     output_positions.append(second)
 511: 
 512:         # Reverse-slide: process in solver order (far-to-near).
 513:         out_sorted = sorted(output_positions, key=lambda p: dr * p[0] + dc * p[1], reverse=True)
 514:         already_stopped = set()
 515:         yellows_input = []
 516: 
 517:         for out_pos in out_sorted:
 518:             candidate = _find_reverse_slide(blob, out_pos, dr, dc, already_stopped,
 519:                                             yellows_input, rng)
 520:             if candidate is None:
 521:                 return False
 522:             yellows_input.append(candidate)
 523:             already_stopped.add(out_pos)
 524: 
 525:         for r, c in yellows_input:
 526:             grid[r, c] = 4
 527:     return True
