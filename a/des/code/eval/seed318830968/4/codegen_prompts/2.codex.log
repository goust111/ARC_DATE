 407: def _place_palette(grid, occ, pal, side, rng):
 408:     """Place palette on the chosen edge and mark its occupancy (with 1-cell padding)."""
 409:     H, W = grid.shape
 410:     pal_h, pal_w = pal.shape
 411:     if side == 'top':
 412:         pr0, pc0 = 0, rng.randint(0, W - pal_w)
 413:     elif side == 'bottom':
 414:         pr0, pc0 = H - pal_h, rng.randint(0, W - pal_w)
 415:     elif side == 'left':
 416:         pr0, pc0 = rng.randint(0, H - pal_h), 0
 417:     else:
 418:         pr0, pc0 = rng.randint(0, H - pal_h), W - pal_w
 419:     grid[pr0:pr0 + pal_h, pc0:pc0 + pal_w] = pal
 420:     occ[max(0, pr0 - 1):min(H, pr0 + pal_h + 1),
 421:         max(0, pc0 - 1):min(W, pc0 + pal_w + 1)] = True
 422: 
 423: 
 424: def _find_valid_positions(H, W, occ, mask, holes):
 425:     """Find all (r0, c0) where mask fits without overlap and holes don't touch grid boundary."""
 426:     sh, sw = mask.shape
 427:     positions = []
 428:     for r0 in range(H - sh + 1):
 429:         for c0 in range(W - sw + 1):
 430:             if occ[max(0, r0 - 1):min(H, r0 + sh + 1),
 431:                    max(0, c0 - 1):min(W, c0 + sw + 1)].any():
 432:                 continue
 433:             if any(r0 + hr == 0 or c0 + hc == 0 or r0 + hr == H - 1 or c0 + hc == W - 1
 434:                    for hpts in holes for hr, hc in hpts):
 435:                 continue
 436:             positions.append((r0, c0))
 437:     return positions
 438: 
 439: 
 440: def _paint_sprite(grid, r0, c0, mask, color, fill, holes):
 441:     """Render a sprite onto the grid: border cells in color, hole cells in fill (if given)."""
 442:     grid[r0:r0 + mask.shape[0], c0:c0 + mask.shape[1]][mask] = color
 443:     if fill is not None:
 444:         for hpts in holes:
 445:             for hr, hc in hpts:
 446:                 grid[r0 + hr, c0 + hc] = fill
