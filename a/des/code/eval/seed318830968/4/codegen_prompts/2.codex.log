  58: def main(grid: np.ndarray) -> np.ndarray:
  59:     """Fill each plus-shaped background notch with the color of the frame side it opens toward.
  60: 
  61:     Input structure
  62:     - A one-cell-thick rectangular frame has four solid-colored sides and neutral corner pixels.
  63:     - The frame interior contains a dominant background color and one foreground object color.
  64:     - Some object boundaries contain five-pixel plus-shaped background notches.
  65: 
  66:     Rule
  67:     - Find every background plus whose opposite side is supported by foreground object pixels and whose open side faces one frame side.
  68:     - Recolor the five pixels of that plus with the color of the facing frame side.
  69:     - Leave all other pixels unchanged.
  70: 
  71:     Key insight
  72:     The frame side colors are direction labels for the open notches in the foreground object.
  73:     """
  74:     g = np.asarray(grid, dtype=int)
  75:     assert g.ndim == 2, "expected a 2D grid"
  76:     h, w = g.shape
  77:     assert h >= 5 and w >= 5, "expected room for a frame and plus notches"
  78: 
  79:     side_color = {
  80:         "top": _uniform_side(g[0, 1:-1]),
  81:         "bottom": _uniform_side(g[-1, 1:-1]),
  82:         "left": _uniform_side(g[1:-1, 0]),
  83:         "right": _uniform_side(g[1:-1, -1]),
  84:     }
  85:     bg, obj = _interior_colors(g[1:-1, 1:-1])
  86: 
  87:     out = g.copy()
  88:     painted: set[tuple[int, int]] = set()
  89:     notch_count = 0
  90:     for r in range(1, h - 1):
  91:         for c in range(1, w - 1):
  92:             cross = tuple((r + dr, c + dc) for dr, dc in _CROSS)
  93:             if not all(int(g[rr, cc]) == bg for rr, cc in cross):
  94:                 continue
  95: 
  96:             dirs = _direction_for_notch(g, r, c, obj)
  97:             assert len(dirs) <= 1, "expected each plus notch to open in at most one direction"
  98:             if not dirs:
  99:                 continue
 100: 
 101:             notch_count += 1
 102:             color = side_color[dirs[0]]
 103:             for cell in cross:
 104:                 assert cell not in painted, "expected non-overlapping plus notches"
 105:                 painted.add(cell)
 106:                 out[cell] = color
 107: 
 108:     assert notch_count > 0, "expected at least one plus notch"
 109:     return out
 110: 
