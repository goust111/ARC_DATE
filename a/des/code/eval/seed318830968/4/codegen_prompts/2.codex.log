 140: def _build_padded(frame_coords, inner_coords, h, w):
 141:     local = np.full((h + 2 * PAD, w + 2 * PAD), BG, dtype=int)
 142:     for r, c in frame_coords:
 143:         local[PAD + r, PAD + c] = LOCAL_FRAME_COLOR
 144:     for r, c in inner_coords:
 145:         local[PAD + r, PAD + c] = LOCAL_INNER_COLOR
 146:     return local
