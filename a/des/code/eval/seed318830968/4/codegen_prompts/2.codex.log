 294: def _gen_attempt() -> np.ndarray | None:
 295:     bg = int(np.random.randint(COLOR_COUNT))
 296:     palette = [color for color in range(COLOR_COUNT) if color != bg]
 297:     anchor_color, right1, right2, below1 = map(
 298:         int, np.random.choice(palette, NON_BG_COLOR_COUNT, replace=False)
 299:     )
 300: 
 301:     s = int(np.random.randint(ANCHOR_SIZE_RANGE[0], ANCHOR_SIZE_RANGE[1]))
 302:     nh = int(np.random.randint(REPEAT_COUNT_RANGE[0], REPEAT_COUNT_RANGE[1]))
 303:     nv = int(np.random.randint(REPEAT_COUNT_RANGE[0], REPEAT_COUNT_RANGE[1]))
 304:     struct_h = 2 * s + FRAME_PERIOD * nv + STRUCTURE_FIXED_PAD
 305:     struct_w = 2 * s + FRAME_PERIOD * nh + STRUCTURE_FIXED_PAD
 306: 
 307:     top, bottom = _choose_margins(struct_h)
 308:     left, right = _choose_margins(struct_w)
 309:     rows, cols = struct_h + top + bottom, struct_w + left + right
 310:     sr0, sc0 = top + SOURCE_OUTER_MARGIN, left + SOURCE_OUTER_MARGIN
 311: 
 312:     out, box = _build_output(
 313:         rows,
 314:         cols,
 315:         bg,
 316:         anchor_color,
 317:         right1,
 318:         right2,
 319:         below1,
 320:         sr0,
 321:         sc0,
 322:         s,
 323:         nh,
 324:         nv,
 325:     )
 326:     inp = _derive_input(out, bg, *box)
 327: 
 328:     try:
 329:         if np.array_equal(main(inp), out):
 330:             return inp
 331:     except Exception:
 332:         return None
 333:     return None
