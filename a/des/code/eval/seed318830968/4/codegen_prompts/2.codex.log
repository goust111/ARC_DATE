  40: 
  41:     Key insight
  42:     - Edge contact gives the slide direction; the output is the set of opposite-edge black rectangles plus their orange trails.
  43:     """
  44:     g = np.asarray(grid, dtype=int)
  45:     assert g.ndim == 2
  46:     h, w = g.shape
  47:     assert h > 0 and w > 0
  48: 
  49:     moving = Color.BLACK
  50:     trail = Color.ORANGE
  51:     assert np.any(g == moving), "expected at least one black rectangle"
  52:     assert np.any(g == trail), "expected orange trail color to be present"
  53: 
  54:     out = g.copy()
  55:     targets: list[BBox] = []
  56:     for coords in components_mask(g == moving, connectivity=4):
  57:         r0, c0, r1, c1 = bbox_coords(coords)
  58:         rect_h = r1 - r0 + 1
  59:         rect_w = c1 - c0 + 1
  60:         assert int(coords.shape[0]) == rect_h * rect_w, "black mask must be a solid rectangle"
  61: 
  62:         side = _edge_side((r0, c0, r1, c1), g.shape)
  63:         if side == "top":
  64:             out[:, c0 : c1 + 1] = trail
  65:             targets.append((h - rect_h, c0, h - 1, c1))
  66:         elif side == "bottom":
  67:             out[:, c0 : c1 + 1] = trail
  68:             targets.append((0, c0, rect_h - 1, c1))
  69:         elif side == "left":
  70:             out[r0 : r1 + 1, :] = trail
  71:             targets.append((r0, w - rect_w, r1, w - 1))
  72:         else:
  73:             assert side == "right"
  74:             out[r0 : r1 + 1, :] = trail
  75:             targets.append((r0, 0, r1, rect_w - 1))
  76: 
  77:     for r0, c0, r1, c1 in targets:
  78:         out[r0 : r1 + 1, c0 : c1 + 1] = moving
  79: 
  80:     return out
  81: 
  82: # --------------- generator (att1) ---------------
  83: 
  84: # Canvas and palette.
  85: MIN_H, MAX_H = 6, 18
  86: MIN_W, MAX_W = 8, 14
  87: BG_GREY, BG_ORANGE = 5, 7
  88: GREY_FRAC_MIN, GREY_FRAC_MAX = 0.2, 0.6
  89: 
  90: # Rectangle and band constraints.
  91: MIN_RECTS, MAX_RECTS = 1, 8
  92: MIN_BAND_SIZE, MAX_BAND_SIZE = 1, 6
  93: BAND_GAP = 1
  94: MIN_RECT_AREA, MAX_RECT_AREA = 2, 18
  95: MAX_RECT_SIDE = 6
  96: SOURCE_EDGE_OFFSET = 1
  97: 
  98: # Retry limits.
  99: TARGET_COUNT_ATTEMPTS = 300
 100: ANY_COUNT_ATTEMPTS = 100
 101: 
 102: 
 103: def _partition_bands(
 104:     total: int, n: int, min_size: int, max_size: int, min_gap: int = 0
 105: ) -> list[tuple[int, int]] | None:
 106:     """Place n non-overlapping inclusive bands inside [0, total - 1]."""
 107:     if n == 0:
 108:         return []
 109: 
 110:     needed = n * min_size + (n - 1) * min_gap
 111:     if needed > total:
 112:         return None
 113: 
 114:     effective_max = min(max_size, total - (n - 1) * (min_size + min_gap))
 115:     if effective_max < min_size:
 116:         return None
 117: 
 118:     widths = [random.randint(min_size, effective_max) for _ in range(n)]
 119:     total_used = sum(widths) + (n - 1) * min_gap
 120:     if total_used > total:
 121:         excess = total_used - total
 122:         indices = list(range(n))
 123:         random.shuffle(indices)
 124:         for i in indices:
 125:             shrink = min(widths[i] - min_size, excess)
 126:             widths[i] -= shrink
 127:             excess -= shrink
 128:             if excess == 0:
 129:                 break
 130:         if excess > 0:
 131:             return None
 132: 
 133:     remaining = total - sum(widths) - (n - 1) * min_gap
 134:     extra_gaps = [0] * (n + 1)
 135:     for _ in range(remaining):
 136:         extra_gaps[random.randint(0, n)] += 1
 137: 
 138:     bands = []
 139:     pos = 0
 140:     for i in range(n):
 141:         pos += extra_gaps[i]
 142:         if i > 0:
 143:             pos += min_gap
 144:         bands.append((pos, pos + widths[i] - 1))
 145:         pos += widths[i]
 146:     return bands
 147: 
 148: 
 149: def _choose_orientation_counts(n_rects: int) -> tuple[int, int] | None:
 150:     max_vert = min(n_rects, (MAX_W - SOURCE_EDGE_OFFSET) // 2)
 151:     max_horiz = min(n_rects, (MAX_H - SOURCE_EDGE_OFFSET) // 2)
 152:     feasible = [(v, n_rects - v) for v in range(n_rects + 1)
 153:                 if v <= max_vert and (n_rects - v) <= max_horiz]
 154:     if not feasible:
 155:         return None
 156:     return random.choice(feasible)
 157: 
 158: 
 159: def _choose_canvas(n_vert: int, n_horiz: int) -> tuple[int, int] | None:
 160:     min_h = max(MIN_H, 2 * n_horiz + 1) if n_horiz > 0 else MIN_H
 161:     min_w = max(MIN_W, 2 * n_vert + 1) if n_vert > 0 else MIN_W
 162:     if min_h > MAX_H or min_w > MAX_W:
 163:         return None
 164:     return random.randint(min_h, MAX_H), random.randint(min_w, MAX_W)
 165: 
 166: 
 167: def _interior_bands(total: int, n: int) -> list[tuple[int, int]] | None:
 168:     raw = _partition_bands(total - 2, n, MIN_BAND_SIZE, MAX_BAND_SIZE, BAND_GAP)
 169:     if raw is None:
 170:         return None
 171:     return [(a + SOURCE_EDGE_OFFSET, b + SOURCE_EDGE_OFFSET) for a, b in raw]
 172: 
 173: 
 174: def _rect_span_for_band(band_size: int, travel: int) -> int | None:
 175:     max_len = min(MAX_RECT_SIDE, travel // 2 - 1, MAX_RECT_AREA // band_size)
 176:     min_len = max(MIN_BAND_SIZE, -(-MIN_RECT_AREA // band_size))
 177:     if min_len > max_len:
 178:         return None
 179:     return random.randint(min_len, max_len)
 180: 
 181: 
 182: def _build_rects(H: int, W: int, n_vert: int, n_horiz: int) -> list[tuple[int, int, int, int, str]] | None:
 183:     """Return destination rectangles plus their original source edge."""
 184:     vert_edges = [random.choice(["top", "bottom"]) for _ in range(n_vert)]
 185:     horiz_edges = [random.choice(["left", "right"]) for _ in range(n_horiz)]
 186: 
 187:     col_bands = _interior_bands(W, n_vert)
 188:     if col_bands is None:
 189:         return None
 190:     row_bands = _interior_bands(H, n_horiz)
 191:     if row_bands is None:
 192:         return None
 193: 
 194:     rects = []
 195:     for i, (c0, c1) in enumerate(col_bands):
 196:         rect_w = c1 - c0 + 1
 197:         rect_h = _rect_span_for_band(rect_w, H)
 198:         if rect_h is None:
 199:             return None
 200:         se = vert_edges[i]
 201:         if se == "top":
 202:             dr0, dr1 = H - rect_h, H - 1
 203:         else:
 204:             dr0, dr1 = 0, rect_h - 1
 205:         rects.append((dr0, c0, dr1, c1, se))
 206: 
 207:     for i, (r0, r1) in enumerate(row_bands):
 208:         rect_h = r1 - r0 + 1
 209:         rect_w = _rect_span_for_band(rect_h, W)
 210:         if rect_w is None:
 211:             return None
 212:         se = horiz_edges[i]
 213:         if se == "left":
 214:             dc0, dc1 = W - rect_w, W - 1
 215:         else:
 216:             dc0, dc1 = 0, rect_w - 1
 217:         rects.append((r0, dc0, r1, dc1, se))
 218: 
 219:     return rects
 220: 
 221: 
 222: def _random_background(shape: tuple[int, int], grey_frac: float) -> np.ndarray:
 223:     return np.where(np.random.random(shape) < grey_frac, BG_GREY, BG_ORANGE).astype(int)
 224: 
 225: 
 226: def _render_output(H: int, W: int, rects: list[tuple[int, int, int, int, str]], grey_frac: float) -> np.ndarray:
 227:     output = _random_background((H, W), grey_frac)
 228: 
 229:     for (dr0, dc0, dr1, dc1, se) in rects:
 230:         if se in ("top", "bottom"):
 231:             output[:, dc0:dc1 + 1] = BG_ORANGE
 232:         else:
 233:             output[dr0:dr1 + 1, :] = BG_ORANGE
 234: 
 235:     for (dr0, dc0, dr1, dc1, _) in rects:
 236:         output[dr0:dr1 + 1, dc0:dc1 + 1] = 0
 237:     return output
 238: 
 239: 
 240: def _invert_output_to_input(
 241:     output: np.ndarray, rects: list[tuple[int, int, int, int, str]], grey_frac: float
 242: ) -> np.ndarray:
 243:     H, W = output.shape
 244:     inp = output.copy()
 245: 
 246:     for (dr0, dc0, dr1, dc1, se) in rects:
 247:         if se in ("top", "bottom"):
 248:             inp[:, dc0:dc1 + 1] = _random_background((H, dc1 - dc0 + 1), grey_frac)
 249:         else:
 250:             inp[dr0:dr1 + 1, :] = _random_background((dr1 - dr0 + 1, W), grey_frac)
 251: 
 252:     for (dr0, dc0, dr1, dc1, se) in rects:
 253:         rh, rw = dr1 - dr0 + 1, dc1 - dc0 + 1
 254:         if se == "top":
 255:             inp[0:rh, dc0:dc1 + 1] = 0
 256:         elif se == "bottom":
 257:             inp[H - rh:H, dc0:dc1 + 1] = 0
 258:         elif se == "left":
 259:             inp[dr0:dr1 + 1, 0:rw] = 0
 260:         else:
 261:             inp[dr0:dr1 + 1, W - rw:W] = 0
 262: 
 263:     return inp
 264: 
 265: 
 266: def _is_valid_pair(inp: np.ndarray, output: np.ndarray) -> bool:
 267:     try:
 268:         return bool(np.array_equal(main(inp), output))
 269:     except Exception:
 270:         return False
 271: 
 272: 
 273: def _gen_attempt_with_count(n_rects: int) -> np.ndarray | None:
 274:     """Generate a valid input with exactly n_rects black rectangles."""
 275:     counts = _choose_orientation_counts(n_rects)
 276:     if counts is None:
 277:         return None
 278:     n_vert, n_horiz = counts
 279: 
 280:     canvas = _choose_canvas(n_vert, n_horiz)
 281:     if canvas is None:
 282:         return None
 283:     H, W = canvas
 284: 
 285:     rects = _build_rects(H, W, n_vert, n_horiz)
 286:     if rects is None:
 287:         return None
 288: 
 289:     grey_frac = random.uniform(GREY_FRAC_MIN, GREY_FRAC_MAX)
 290:     output = _render_output(H, W, rects, grey_frac)
 291:     inp = _invert_output_to_input(output, rects, grey_frac)
 292:     return inp if _is_valid_pair(inp, output) else None
 293: 
 294: 
 295: def generate_input() -> np.ndarray:
 296:     target_count = random.randint(MIN_RECTS, MAX_RECTS)
 297:     for _ in range(TARGET_COUNT_ATTEMPTS):
 298:         result = _gen_attempt_with_count(target_count)
 299:         if result is not None:
 300:             return result
 301:     for _ in range(ANY_COUNT_ATTEMPTS):
 302:         result = _gen_attempt_with_count(random.randint(MIN_RECTS, MAX_RECTS))
 303:         if result is not None:
 304:             return result
 305:     raise RuntimeError(f"Failed to generate valid input after {TARGET_COUNT_ATTEMPTS + ANY_COUNT_ATTEMPTS} attempts")
END_FILE
