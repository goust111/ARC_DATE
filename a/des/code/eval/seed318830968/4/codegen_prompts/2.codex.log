 131: def _fill_mask(local, frame_color):
 132:     frame = local == frame_color
 133:     return (local == BG) & _neighbor_mask(frame, DIAGONALS) & ~_neighbor_mask(frame, ORTHOGONALS)
 134: 
 135: 
 136: def _count_fill(local, frame_color):
 137:     return int(np.count_nonzero(_fill_mask(local, frame_color)))
