 205: def _choose_margins(struct_len: int) -> tuple[int, int]:
 206:     pairs = [
 207:         (before, after)
 208:         for before in MARGIN_CHOICES
 209:         for after in MARGIN_CHOICES
 210:         if MIN_TOTAL_MARGIN <= before + after
 211:         and CANVAS_MIN_SIZE <= struct_len + before + after <= CANVAS_MAX_SIZE
 212:     ]
 213:     return pairs[int(np.random.randint(len(pairs)))]
