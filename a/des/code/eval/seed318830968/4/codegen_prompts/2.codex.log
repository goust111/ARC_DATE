 173: def _choose_notches(r0, c0, h, w, count):
 174:     edges = random.sample(_EDGES, count)
 175:     random.shuffle(edges)
 176:     choices = {edge: _candidate_notches(r0, c0, h, w, edge) for edge in edges}
 177: 
 178:     def search(i, chosen, carved, protected):
 179:         if i == len(edges):
 180:             return chosen
 181:         options = choices[edges[i]][:]
 182:         random.shuffle(options)
 183:         for notch in options:
 184:             cross = set(notch["cross"])
 185:             support = set(notch["support"])
 186:             if cross & carved or cross & protected or support & carved:
 187:                 continue
 188:             result = search(i + 1, chosen + [notch], carved | cross, protected | support)
 189:             if result is not None:
 190:                 return result
 191:         return None
 192: 
 193:     return search(0, [], set(), set())
