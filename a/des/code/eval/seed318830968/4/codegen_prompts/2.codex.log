 144: def _notch_cells(r, c, direction):
 145:     dr, dc = _GEN_DIRECTIONS[direction]
 146:     pr, pc = -dc, dr
 147:     cross = tuple((r + rr, c + cc) for rr, cc in _GEN_CROSS)
 148:     support = (
