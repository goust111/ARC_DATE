 150:         (r - dr + pr, c - dc + pc),
 151:         (r - dr - pr, c - dc - pc),
 152:         (r + 2 * pr, c + 2 * pc),
 153:         (r - 2 * pr, c - 2 * pc),
 154:     )
 155:     open_side = (
 156:         (r + 2 * dr, c + 2 * dc),
 157:         (r + dr + pr, c + dc + pc),
 158:         (r + dr - pr, c + dc - pc),
 159:     )
 160:     return {"direction": direction, "cross": cross, "support": support, "open_side": open_side}
