 112: 
 113: # Canvas and palette.
 114: _GEN_GRID_SIZE, _GEN_CORNER_COLOR = 30, 0
 115: _GEN_COLOR_POOL, _GEN_PALETTE_SIZE = range(1, 10), 6
 116: 
 117: # Object size and total filled-area budget.
 118: _OBJECT_COUNT_MIN, _OBJECT_COUNT_MAX = 3, 4
