  17: def main(grid: np.ndarray) -> np.ndarray:
  18:     """
  19:     Paint the inner foreground color into every background pixel that touches the enclosing frame only diagonally.
  20: 
  21:     Input structure:
  22:     - The grid has one dominant background color and exactly two foreground colors.
  23:     - One foreground color is an enclosing frame: its bbox strictly contains the bbox of the other, inner color.
  24: 
  25:     Rule:
  26:     - Keep all existing pixels unchanged.
  27:     - For each background pixel, if it is diagonally adjacent to the frame color and has no orthogonal adjacency to the frame color, recolor it to the inner color.
  28: 
  29:     Key insight: The inner color marks the color to use, while the frame's diagonal-only background neighbors define the cells to add.
  30:     """
  31:     g = np.asarray(grid, dtype=int)
  32:     bg = int(get_bg(g))
  33:     colors = colors_present(g, exclude={bg})
  34:     assert len(colors) == 2, f"expected exactly two foreground colors, got {colors}"
  35: 
  36:     boxes: dict[int, tuple[int, int, int, int]] = {}
  37:     for color in colors:
  38:         b = bbox(g == int(color))
  39:         assert b is not None, f"foreground color {color} has no bbox"
  40:         boxes[int(color)] = b
  41: 
  42:     role_pairs = [
  43:         (outer, inner)
  44:         for outer in colors
  45:         for inner in colors
  46:         if outer != inner and _strictly_contains(boxes[int(outer)], boxes[int(inner)])
  47:     ]
  48:     assert len(role_pairs) == 1, f"expected one enclosing frame color, got {role_pairs}"
  49:     frame_color, inner_color = map(int, role_pairs[0])
  50: 
  51:     assert len(components_mask(g != bg, connectivity=8)) == 1, "all foreground must be one 8-connected component"
  52: 
  53:     out = g.copy()
  54:     H, W = g.shape
  55:     for r in range(H):
  56:         for c in range(W):
  57:             if int(g[r, c]) != bg:
  58:                 continue
  59: 
  60:             has_diagonal_frame = any(
  61:                 in_bounds(g.shape, r + dr, c + dc) and int(g[r + dr, c + dc]) == frame_color
  62:                 for dr, dc in DIAGONALS
  63:             )
  64:             if not has_diagonal_frame:
  65:                 continue
  66: 
  67:             has_orthogonal_frame = any(
  68:                 in_bounds(g.shape, r + dr, c + dc) and int(g[r + dr, c + dc]) == frame_color
  69:                 for dr, dc in ORTHOGONALS
  70:             )
  71:             if not has_orthogonal_frame:
  72:                 has_orthogonal_inner = any(
  73:                     in_bounds(g.shape, r + dr, c + dc) and int(g[r + dr, c + dc]) == inner_color
  74:                     for dr, dc in ORTHOGONALS
  75:                 )
  76:                 assert not has_orthogonal_inner, "new pixel must not be orthogonally adjacent to inner color"
  77:                 out[r, c] = inner_color
  78: 
  79:     return out
