+
+def _frame_from_color(grid: np.ndarray, color: int) -> dict | None:
+    pts = np.argwhere(grid == int(color))
+    if len(pts) == 0:
+        return None
+
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    r0 = int(r0)
+    c0 = int(c0)
+    r1 = int(r1)
+    c1 = int(c1)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 5 or w < 5:
+        return None
+
+    expected = 2 * h + 2 * w - 5
+    if len(pts) != expected:
+        return None
+
+    gap = None
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            on_border = r in (r0, r1) or c in (c0, c1)
+            v = int(grid[r, c])
+            if on_border:
+                if v == int(color):
+                    continue
+                if gap is not None or v != BG:
+                    return None
+                gap = (r, c)
+            elif v == int(color):
+                return None
+
+    if gap is None:
+        return None
+    side = _gap_side((r0, c0, r1, c1), gap)
+    if side is None:
+        return None
+
+    axis = int(gap[1] if side in {"top", "bottom"} else gap[0])
+    return {
+        "color": int(color),
+        "bbox": (r0, c0, r1, c1),
+        "gap": (int(gap[0]), int(gap[1])),
+        "side": side,
+        "axis": axis,
+    }
