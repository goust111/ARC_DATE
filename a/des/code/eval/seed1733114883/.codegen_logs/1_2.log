+def _gap_side(bbox: tuple[int, int, int, int], gap: tuple[int, int]) -> str | None:
+    r0, c0, r1, c1 = bbox
+    gr, gc = gap
+    if gr == r0 and c0 < gc < c1:
+        return "top"
+    if gc == c1 and r0 < gr < r1:
+        return "right"
+    if gr == r1 and c0 < gc < c1:
+        return "bottom"
+    if gc == c0 and r0 < gr < r1:
+        return "left"
+    return None
