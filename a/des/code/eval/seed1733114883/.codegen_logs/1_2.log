+
+def _extract_frames(grid: np.ndarray) -> list[dict]:
+    colors = sorted(int(v) for v in np.unique(grid) if int(v) != BG)
+    frames = []
+    for color in colors:
+        frame = _frame_from_color(grid, color)
+        if frame is not None:
+            frames.append(frame)
