+    pad_bottom = random.randint(1, 4)
+    pad_left = random.randint(1, 4)
+    pad_right = random.randint(1, 4)
+    dr = pad_top - min_r
+    dc = pad_left - min_c
+    height = max_r - min_r + 1 + pad_top + pad_bottom
+    width = max_c - min_c + 1 + pad_left + pad_right
