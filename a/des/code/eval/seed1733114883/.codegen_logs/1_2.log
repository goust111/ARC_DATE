+    if left == right:
+        if side in {"top", "right"}:
+            cells = [(r, left) for r in range(top, bottom + 1)]
+        else:
+            cells = [(r, left) for r in range(bottom, top - 1, -1)]
+        return _rotate_to_start(cells, start)
