+    h, w = grid.shape
+    seed_h, seed_w = _shape_dims(seed)
+    height_choices = [value for value in OUTER_SIZES if value >= seed_h + 4 and value <= h]
+    width_choices = [value for value in OUTER_SIZES if value >= seed_w + 4 and value <= w]
