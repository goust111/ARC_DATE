+    if get_bg(grid) != bg:
+        return None
+
+    expected = _expected_output(grid, objects)
+    actual = main(grid)
+    if not np.array_equal(actual, expected):
+        return None
+    if np.array_equal(actual, grid):
+        return None
+    return grid
