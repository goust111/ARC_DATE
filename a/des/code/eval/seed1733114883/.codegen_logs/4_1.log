+    true_count = count // 2
+    if count % 2 == 1 and rng.random() < 0.5:
+        true_count += 1
+    flags = [True] * true_count + [False] * (count - true_count)
+    rng.shuffle(flags)
+    if count >= 2 and all(flags):
