+) -> dict | None:
+    if len(coords) != 7:
+        return None
+    pts = set(coords)
+    rmin, cmin, rmax, cmax = _bbox(coords)
+    matches = []
+    for br in range(rmin - 1, rmax + 1):
+        for bc in range(cmin - 1, cmax + 1):
+            block = {
+                (br, bc),
+                (br, bc + 1),
+                (br + 1, bc),
+                (br + 1, bc + 1),
+            }
+            if not block <= pts:
+                continue
+            arrow = pts - block
+            for direction, pattern in ARROW_PATTERNS.items():
+                expected = {(br + dr, bc + dc) for dr, dc in pattern}
+                if arrow == expected:
+                    matches.append((br, bc, direction))
+    if len(matches) != 1:
+        return None
+
+    br, bc, direction = matches[0]
+    r0, c0, r1, c1 = frame_bbox
+    if direction == "R":
+        dist = c0 - (bc + 1) - 1
+        if not (bc + 1 < c0 and r0 + 1 <= br <= r1 - 2):
+            return None
+    elif direction == "L":
+        dist = bc - c1 - 1
+        if not (bc > c1 and r0 + 1 <= br <= r1 - 2):
+            return None
+    elif direction == "D":
+        dist = r0 - (br + 1) - 1
+        if not (br + 1 < r0 and c0 + 1 <= bc <= c1 - 2):
+            return None
+    else:
+        dist = br - r1 - 1
+        if not (br > r1 and c0 + 1 <= bc <= c1 - 2):
+            return None
+    if dist < 1:
+        return None
+
+    return {
+        "block_r": br,
+        "block_c": bc,
+        "dir": direction,
+        "dist": int(dist),
+    }
