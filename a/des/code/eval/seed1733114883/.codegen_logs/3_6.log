+    "R": {(0, 2), (1, 3), (2, 2)},
+    "L": {(0, -1), (1, -2), (2, -1)},
+    "D": {(2, 0), (3, 1), (2, 2)},
+    "U": {(-1, 0), (-2, 1), (-1, 2)},
