+def _rect_fits(r: int, c: int, inner_bbox: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = inner_bbox
+    return r0 <= r and c0 <= c and r + 1 <= r1 and c + 1 <= c1
