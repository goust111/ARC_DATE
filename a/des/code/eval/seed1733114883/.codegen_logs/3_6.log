+def _parse_scene(grid: np.ndarray) -> tuple[int, dict, list[dict]]:
+    bg = _mode_color(grid)
+    frame = _detect_frame(grid, bg)
+    objects = _detect_objects(grid, bg, frame)
+    return bg, frame, objects
