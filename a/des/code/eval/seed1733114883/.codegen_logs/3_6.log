+def _entry_position(obj: dict, frame_bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = frame_bbox
+    if obj["dir"] == "R":
+        return obj["block_r"], c0 + 1
+    if obj["dir"] == "L":
+        return obj["block_r"], c1 - 2
+    if obj["dir"] == "D":
+        return r0 + 1, obj["block_c"]
+    return r1 - 2, obj["block_c"]
+
