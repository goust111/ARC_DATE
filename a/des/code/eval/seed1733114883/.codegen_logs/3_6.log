+            r0, c0, r1, c1 = _bbox(comp)
+            height = r1 - r0 + 1
+            width = c1 - c0 + 1
+            if height < 10 or width < 10:
+                continue
+            border_size = 2 * (height + width) - 4
+            if len(comp) != border_size:
+                continue
+            ok = True
+            for rr in range(r0, r1 + 1):
+                if int(grid[rr, c0]) != color or int(grid[rr, c1]) != color:
+                    ok = False
