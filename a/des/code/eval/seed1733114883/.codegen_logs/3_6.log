+    if desc is None:
+        return False
+    asc_objects = sorted(objects, key=lambda obj: (obj["dist"], obj["block_r"], obj["block_c"], obj["color"]))
+    asc = _simulate_objects(shape, frame["bbox"], asc_objects)
+    if asc is None:
