+                continue
+            stack = [(int(r), int(c))]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in NEIGHBORS8:
+                    rr = cr + dr
+                    cc2 = cc + dc
