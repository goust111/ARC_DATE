+    return out
+
+
+_PROTO_STRINGS = [
+    ["1100", "1000", "1010", "0011"],
+    ["1110", "0010", "0110", "0100"],
+    ["1000", "1110", "0010", "0011"],
+    ["1110", "1000", "1110", "0011"],
+    ["1100", "0110", "0010", "1011"],
