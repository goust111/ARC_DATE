+        if len(variants) >= 4:
+            return mask
+
+    fallback = np.zeros((h, w), dtype=bool)
+    fallback[0, : max(2, w - 1)] = True
+    fallback[:, 0] = True
+    fallback[h - 1, max(0, w // 2 - 1) :] = True
+    if h > 2:
