+        used_colors.add(color)
+
+    extra_tower_count = random.randint(*EXTRA_TOWER_COUNT_RANGE)
+    for _ in range(extra_tower_count):
+        spot = _find_isolated_spot(h, w, occupied, legend_row_set, blocked_rows, blocked_cols)
