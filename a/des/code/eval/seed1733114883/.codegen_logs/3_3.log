+    legend_rows: set[int],
+    blocked_rows: set[int],
+    blocked_cols: set[int],
+) -> tuple[int, int] | None:
+    candidates = [
+        (r, c)
+        for r in range(1, h - 1)
+        for c in range(2, w - 1)
+        if r not in legend_rows
+        and r not in blocked_rows
+        and c not in blocked_cols
+        and (r, c) not in occupied
