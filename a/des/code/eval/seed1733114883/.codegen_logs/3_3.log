+) -> bool:
+    return all(max(abs(r - rr), abs(c - cc)) > moat for rr, cc in occupied)
+
+
+def _find_isolated_spot(
+    h: int,
+    w: int,
+    occupied: set[tuple[int, int]],
+    legend_rows: set[int],
+    blocked_rows: set[int],
+    blocked_cols: set[int],
+) -> tuple[int, int] | None:
+    candidates = [
