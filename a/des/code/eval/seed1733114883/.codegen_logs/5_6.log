+def _generate_attempt(rng: random.Random) -> np.ndarray | None:
+    n_rows = rng.choice(ROW_COUNT_OPTIONS)
+    n_cols = rng.choice(COL_COUNT_OPTIONS)
+    row_sizes = _sample_axis(rng, n_rows)
+    col_sizes = _sample_axis(rng, n_cols)
