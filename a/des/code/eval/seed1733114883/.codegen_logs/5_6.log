+                                    "bucket": odd_bucket,
+                                    "sources": list(odd_choice),
+                                    "parity": "odd",
+                                },
+                                {
+                                    "bucket": even_bucket,
+                                    "sources": list(even_choice),
+                                    "parity": "even",
+                                },
+                            ]
