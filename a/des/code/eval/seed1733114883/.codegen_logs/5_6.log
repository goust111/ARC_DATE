+    odd_buckets = cells[:]
+    even_buckets = cells[:]
+    rng.shuffle(odd_buckets)
+    rng.shuffle(even_buckets)
+
+    for odd_bucket in odd_buckets:
+        odd_counts = [k for k in (1, 3) if k <= len(source_map[odd_bucket])]
