+def _choose_primary_groups(
+    rng: random.Random, n_rows: int, n_cols: int
+) -> list[dict] | None:
+    cells = [(r, c) for r in range(n_rows) for c in range(n_cols)]
+    source_map = {cell: _candidate_sources(cell, n_rows, n_cols) for cell in cells}
