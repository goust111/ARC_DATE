+                lengths.append(nxt)
+            if not dropped:
+                continue
+            local_cells = {(r, c) for r, width in enumerate(lengths) for c in range(width)}
+        else:
+            cut_h = int(_RNG.integers(2, rect_h))
+            cut_w = int(_RNG.integers(2, rect_w))
+            upper = min(cut_h * cut_w, max_small_area)
+            if upper < 2:
