+    cols = [c for _, c in pts]
+    r0, c0 = min(rows), min(cols)
+    norm = tuple(sorted((r - r0, c - c0) for r, c in pts))
+    h = max(r for r, _ in norm) + 1
+    w = max(c for _, c in norm) + 1
+    return h, w, norm
