+        pair_places = [p for p in placements if int(p["pair_idx"]) == pair_idx]
+        top = min(int(p["top"]) for p in pair_places)
+        left = min(int(p["left"]) for p in pair_places)
+        anchors[pair_idx] = (top, left)
