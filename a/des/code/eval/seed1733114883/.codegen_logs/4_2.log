+        return None
+
+    corner = ("tl", "tr", "bl", "br")[int(_RNG.integers(4))]
+    small_cells = _transform_corner_cells(local_cutout, rect_h, rect_w, corner)
+    rect_cells = {(r, c) for r in range(rect_h) for c in range(rect_w)}
