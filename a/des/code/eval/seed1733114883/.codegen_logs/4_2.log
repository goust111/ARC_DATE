+    pairs = []
+    for pair_idx, spec in enumerate(pair_specs):
+        pairs.append(
+            {
+                "h": int(spec["rect_h"]),
+                "w": int(spec["rect_w"]),
+                "area": int(spec["area"]),
+                "big_color": int(spec["big_color"]),
+                "small_color": int(spec["small_color"]),
