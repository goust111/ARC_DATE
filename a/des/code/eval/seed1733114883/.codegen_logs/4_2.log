+    bg = int(_RNG.integers(10))
+    palette = [c for c in range(10) if c != bg]
+    pair_count = int(_RNG.integers(PAIR_COUNT_RANGE[0], PAIR_COUNT_RANGE[1] + 1))
+    if 2 * pair_count > len(palette):
