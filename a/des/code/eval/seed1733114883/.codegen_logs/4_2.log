+def _generate_pair_spec(big_color: int, small_color: int) -> dict | None:
+    rect_h = int(_RNG.integers(RECT_DIM_MIN, RECT_DIM_MAX + 1))
+    rect_w = int(_RNG.integers(RECT_DIM_MIN, RECT_DIM_MAX + 1))
