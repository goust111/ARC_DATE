+
+def _boundary_cells(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    out: list[tuple[int, int]] = []
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        for dr, dc in DIRS4:
+            nr, nc = rr + dr, cc + dc
+            if not (0 <= nr < h and 0 <= nc < w and mask[nr, nc]):
+                out.append((rr, cc))
+                break
+    return out
+
+
+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    out[1:, :] |= mask[:-1, :]
+    out[:-1, :] |= mask[1:, :]
+    out[:, 1:] |= mask[:, :-1]
+    out[:, :-1] |= mask[:, 1:]
+    out[1:, 1:] |= mask[:-1, :-1]
+    out[1:, :-1] |= mask[:-1, 1:]
+    out[:-1, 1:] |= mask[1:, :-1]
+    out[:-1, :-1] |= mask[1:, 1:]
+    return out
