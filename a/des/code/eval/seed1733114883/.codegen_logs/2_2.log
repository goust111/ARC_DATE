+def _apply_tabs(owner: np.ndarray) -> np.ndarray | None:
+    out = owner.copy()
+    for kind, fixed, start, end, a, b in _boundary_segments(owner):
+        if end - start + 1 < 3:
+            return None
+        pivot = random.randint(start + 1, end - 1)
+        if kind == "v":
+            if random.choice([True, False]):
+                out[pivot, fixed] = a
+            else:
+                out[pivot, fixed - 1] = b
+        else:
+            if random.choice([True, False]):
+                out[fixed, pivot] = a
+            else:
+                out[fixed - 1, pivot] = b
+    if not _connected_owner(out):
+        return None
+    return out
+
