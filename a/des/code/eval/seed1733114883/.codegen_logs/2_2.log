+        bar_w = random.randint(3, 5)
+        rest_w = random.randint(4, 7)
+        h = sum(heights)
+        w = bar_w + rest_w
+        owner = np.zeros((h, w), dtype=int)
+        if mode == "left":
+            owner[:, :bar_w] = 0
+            c0 = bar_w
+        else:
+            owner[:, w - bar_w :] = 0
