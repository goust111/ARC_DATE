+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_PAIR_OFFSETS = 12
+GEN_RETRIES = 300
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _mask_from_coords(coords: list[tuple[int, int]]) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
+    return mask
+
+
+def _boundary_cells(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    out: list[tuple[int, int]] = []
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        for dr, dc in DIRS4:
+            nr, nc = rr + dr, cc + dc
+            if not (0 <= nr < h and 0 <= nc < w and mask[nr, nc]):
+                out.append((rr, cc))
+                break
+    return out
+
+
+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    out[1:, :] |= mask[:-1, :]
+    out[:-1, :] |= mask[1:, :]
+    out[:, 1:] |= mask[:, :-1]
+    out[:, :-1] |= mask[:, 1:]
+    out[1:, 1:] |= mask[:-1, :-1]
+    out[1:, :-1] |= mask[:-1, 1:]
+    out[:-1, 1:] |= mask[1:, :-1]
+    out[:-1, :-1] |= mask[1:, 1:]
+    return out
+
+
+def _paste(dst: np.ndarray, src: np.ndarray, r0: int, c0: int) -> None:
+    h, w = src.shape
+    mask = src != BG
+    dst[r0 : r0 + h, c0 : c0 + w][mask] = src[mask]
+
+
+def _extract_legend(grid: np.ndarray) -> tuple[np.ndarray, list[int]]:
+    h, w = grid.shape
+    candidates = []
+    for coords in _components(grid != BG):
+        r0, c0, r1, c1 = _bbox(coords)
+        if r0 != r1:
+            continue
+        vals = {int(grid[r, c]) for r, c in coords}
+        if len(vals) < 2:
+            continue
+        if r0 not in (0, h - 1):
+            continue
+        if c0 != 0 and c1 != w - 1:
+            continue
+        full = grid[r0, c0 : c1 + 1]
+        if np.any(full == BG):
+            continue
+        candidates.append((c1 - c0 + 1, r0, c0, c1))
+    if not candidates:
+        raise ValueError("legend strip not found")
+    _, r0, c0, c1 = max(candidates)
+    mask = np.zeros_like(grid, dtype=bool)
+    mask[r0, c0 : c1 + 1] = True
+    colors = [int(x) for x in grid[r0, c0 : c1 + 1]]
+    return mask, colors
+
