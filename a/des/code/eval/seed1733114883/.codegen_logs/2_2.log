+
+def _contact_count(set_a: set[tuple[int, int]], coords_b: list[tuple[int, int]], dr: int, dc: int) -> int:
+    total = 0
+    for r, c in coords_b:
+        rr = r + dr
+        cc = c + dc
+        for sr, sc in DIRS4:
+            if (rr + sr, cc + sc) in set_a:
