+def _make_owner() -> np.ndarray:
+    family = random.choice(["strip", "t", "plus"])
+    if family == "strip":
+        owner = _family_strip()
+    elif family == "t":
+        owner = _family_t()
+    else:
+        owner = _family_plus()
+    perm = list(range(int(owner.max()) + 1))
+    random.shuffle(perm)
+    remapped = owner.copy()
+    for old, new in enumerate(perm):
+        remapped[owner == old] = new
+    return remapped
+
