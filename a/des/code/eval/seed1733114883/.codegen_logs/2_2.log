+    owner[:, :left_w] = 0
+    owner[:, left_w + center_w :] = 1
+    owner[:top_h, left_w : left_w + center_w] = 2
+    owner[top_h : top_h + center_h, left_w : left_w + center_w] = 3
+    owner[top_h + center_h :, left_w : left_w + center_w] = 4
+    return owner
