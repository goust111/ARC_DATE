+        assert int(np.sum(grid == RED)) == 3
+        assert int(np.sum(grid == ANCHOR)) == 1
+        expected = _grow(seed, (r0, c0, r0 + h, c0 + w), direction, grid.shape)
+        actual = main(grid)
+        assert np.array_equal(actual, expected), "generator should only emit solvable instances"
