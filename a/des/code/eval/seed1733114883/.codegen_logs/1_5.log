+def generate_input() -> np.ndarray:
+    for _attempt in range(GEN_ATTEMPTS):
+        h = random.randint(3, 4)
+        w = random.randint(3, 4)
+        H = random.randint(max(GRID_MIN, h + 4), GRID_MAX)
+        W = random.randint(max(GRID_MIN, w + 4), GRID_MAX)
