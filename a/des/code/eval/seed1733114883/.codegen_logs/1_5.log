+    r0, c0, r1, c1 = seed_bbox
+    out[r0:r1, c0:c1] = seed_patch
+    current_bbox = tuple(map(int, seed_bbox))
+    current_dir = direction
+    while True:
+        next_bbox = _next_bbox(current_bbox, current_dir)
+        if not _fits_bbox(next_bbox, shape):
