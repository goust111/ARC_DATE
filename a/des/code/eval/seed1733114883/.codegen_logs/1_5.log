+    if len(pts) != 3:
+        return False
+    degrees = []
+    for r, c in pts:
+        degree = 0
+        for dr, dc in ORTHO:
+            degree += int((int(r + dr), int(c + dc)) in pts)
+        degrees.append(degree)
+    return sorted(degrees) == [1, 1, 2]
