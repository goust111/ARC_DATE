+            bbox = (int(r0), int(c0), int(r0 + h), int(c0 + w))
+            if not _arrow_fits(r0, c0, h, w, direction, (H, W)):
+                continue
+            if _max_steps(bbox, direction, (H, W)) == int(target_steps):
