+        for cc in range(max(0, int(ac) - 1), min(w, int(ac) + 2)):
+            if rr == int(ar) and cc == int(ac):
+                continue
+            v = int(seed_patch[rr, cc])
+            if v not in {BG, RED, ANCHOR}:
