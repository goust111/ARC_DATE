+def _grow(seed_patch: np.ndarray, seed_bbox: tuple[int, int, int, int], direction: str, shape: tuple[int, int]) -> np.ndarray:
+    out = np.full(shape, BG, dtype=int)
+    r0, c0, r1, c1 = seed_bbox
