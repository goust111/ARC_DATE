+def _arrow_direction(red_coords: np.ndarray, seed_bbox: tuple[int, int, int, int]) -> str:
+    r0, c0, r1, c1 = seed_bbox
+    rows = red_coords[:, 0]
+    cols = red_coords[:, 1]
