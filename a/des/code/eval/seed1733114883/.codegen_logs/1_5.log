+CW = {"up": "right", "right": "down", "down": "left", "left": "up"}
+ORTHO = ((1, 0), (-1, 0), (0, 1), (0, -1))
+CORNERS = ("tl", "tr", "bl", "br")
+PATTERN_KINDS = ("rows", "cols", "checker", "frame", "quadrants")
+
