+                (int(r0 + t + 1), int(c0 + w)),
+                (int(r0 + t + tip_end), int(c0 + w + 1)),
+            ]
+        return [
+            (int(r0 + t), int(c0 - 1)),
+            (int(r0 + t + 1), int(c0 - 1)),
+            (int(r0 + t + tip_end), int(c0 - 2)),
+        ]
+
+    t = random.randint(0, w - 2)
+    tip_end = random.randint(0, 1)
+    if direction == "down":
+        return [
+            (int(r0 + h), int(c0 + t)),
+            (int(r0 + h), int(c0 + t + 1)),
+            (int(r0 + h + 1), int(c0 + t + tip_end)),
+        ]
+    return [
+        (int(r0 - 1), int(c0 + t)),
+        (int(r0 - 1), int(c0 + t + 1)),
+        (int(r0 - 2), int(c0 + t + tip_end)),
+    ]
