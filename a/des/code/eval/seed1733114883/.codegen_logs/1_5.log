+        candidates.append("right")
+    if int(cols.max()) == int(c0 - 1) and bool(np.all(cols <= int(c0 - 1))):
+        candidates.append("left")
+    if int(rows.min()) == int(r1) and bool(np.all(rows >= int(r1))):
+        candidates.append("down")
