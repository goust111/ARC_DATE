+
+def _fits_bbox(bbox: tuple[int, int, int, int], shape: tuple[int, int]) -> bool:
+    r0, c0, r1, c1 = bbox
+    return 0 <= int(r0) and 0 <= int(c0) and int(r1) <= int(shape[0]) and int(c1) <= int(shape[1])
