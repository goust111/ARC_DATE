+
+
+def _ray_cells_for_chain(chain: list[dict]) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for depth, box in enumerate(chain, start=1):
+        gr, gc = box["gap"]
+        if box["side"] == "top":
+            dr, dc = -1, 0
+        elif box["side"] == "bottom":
+            dr, dc = 1, 0
+        elif box["side"] == "left":
+            dr, dc = 0, -1
