+    frames: list[dict] = []
+    for comp in _components(working == frame_color):
+        rows = [r for r, _ in comp]
+        cols = [c for _, c in comp]
+        r0 = min(rows)
+        r1 = max(rows)
+        c0 = min(cols)
+        c1 = max(cols)
+        assert r1 - r0 >= 2 and c1 - c0 >= 2, "frame must be at least 3x3"
+
