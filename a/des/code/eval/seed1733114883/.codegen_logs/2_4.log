+def _find_color_strip(grid: np.ndarray, bg: int) -> list[tuple[int, int]]:
+    candidates = _strip_candidates(grid, bg)
+    assert len(candidates) == 1, "expected exactly one corner color strip"
+    return candidates[0]["coords"]
