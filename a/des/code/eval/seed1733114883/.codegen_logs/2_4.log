+def _random_bbox_chain(depth: int) -> list[dict]:
+    inner_h = random.randint(*INNER_SIZE_RANGE)
+    inner_w = random.randint(*INNER_SIZE_RANGE)
+    boxes = [{"bbox": (0, 0, inner_h - 1, inner_w - 1)}]
+    for _ in range(depth - 1):
