+        for top, left in candidates[:200]:
+            r0 = top - max_depth
+            c0 = left - max_depth
+            r1 = top + gh + max_depth - 1
+            c1 = left + gw + max_depth - 1
+            if reserved[r0 : r1 + 1, c0 : c1 + 1].any():
+                continue
+            placed = (top, left)
+            reserved[r0 : r1 + 1, c0 : c1 + 1] = True
+            break
