+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _full_perimeter(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    cells = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _strip_candidates(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    candidates: list[dict] = []
+    for top in (True, False):
+        for left in (True, False):
+            c = 0 if left else w - 1
+            dc = 1 if left else -1
+            r = 0 if top else h - 1
+            step = 1 if top else -1
+            coords: list[tuple[int, int]] = []
+            while 0 <= r < h and int(grid[r, c]) != bg:
+                if 0 <= c + dc < w and int(grid[r, c + dc]) != bg:
+                    coords = []
+                    break
+                coords.append((r, c))
+                r += step
+            if not coords:
+                continue
+            if 0 <= r < h and int(grid[r, c]) != bg:
+                continue
+            rows = [rr for rr, _ in coords]
+            if len(set(rows)) != len(rows):
+                continue
+            coords.sort()
+            candidates.append({"coords": coords, "corner": ("top" if top else "bottom", "left" if left else "right")})
+    return candidates
