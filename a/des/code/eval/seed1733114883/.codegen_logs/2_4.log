    widths = [
        list(ws)
        for ws in itertools.product(MOVER_WIDTH_OPTIONS, repeat=int(count))
        if sum(ws) + MIN_COLUMN_GAP * (int(count) - 1) <= int(n) - 2 * EDGE_MARGIN
