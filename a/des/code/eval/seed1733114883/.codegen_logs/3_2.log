+def _paste_patch(canvas: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
+    view = canvas[r0 : r0 + h, c0 : c0 + w]
+    mask = patch != int(BG)
+    view[mask] = patch[mask]
