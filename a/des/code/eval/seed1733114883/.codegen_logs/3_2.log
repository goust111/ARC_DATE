+import numpy as np
+
+
+BG = 0
+FRAME = 5
+PIECE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GEN_RETRIES = 300
