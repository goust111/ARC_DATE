+    col_lines = [int(left + j * (cell_w + 1)) for j in range(cols + 1)]
+    for r in row_lines:
+        canvas[r, left : col_lines[-1] + 1] = FRAME
+    for c in col_lines:
+        canvas[top : row_lines[-1] + 1, c] = FRAME
+    return row_lines, col_lines
