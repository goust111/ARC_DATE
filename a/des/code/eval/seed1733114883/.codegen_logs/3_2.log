+        out[r, c0 : c1 + 1] = int(frame_color)
+    for c in col_lines:
+        out[r0 : r1 + 1, c] = int(frame_color)
+    for slot in slots:
+        color = int(piece_by_key[slot["key"]])
+        out[slot["r0"] : slot["r1"] + 1, slot["c0"] : slot["c1"] + 1] = int(color)
+    return out
