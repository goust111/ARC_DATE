+        return patch
+    if side == "bottom":
+        patch = np.full((cell_h + 1, cell_w), BG, dtype=int)
+        patch[:-1, :] = int(piece_color)
+        patch[-1, list(signature)] = FRAME
+        return patch
+    if side == "left":
+        patch = np.full((cell_h, cell_w + 1), BG, dtype=int)
+        patch[:, 1:] = int(piece_color)
+        patch[list(signature), 0] = FRAME
+        return patch
