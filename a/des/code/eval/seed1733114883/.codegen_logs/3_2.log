+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Match grey-toothed monochrome pieces to uniquely notched frame cells, rotate them,
+    and move them into the framed region on the right.
+    """
+    g = np.asarray(grid, dtype=int)
