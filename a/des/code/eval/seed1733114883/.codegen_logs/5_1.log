+
+
+def _plan_path_recursive(
+    current: tuple[int, int],
+    dir_idx: int,
+    remaining: int,
+    causes: tuple[str, ...],
+    occupied: np.ndarray,
+    rng: np.random.Generator,
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]]] | None:
+    free_cells, blocked_by_boundary = _forward_free(current, dir_idx, occupied)
