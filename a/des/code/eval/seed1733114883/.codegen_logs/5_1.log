+def _forward_free(
+    current: tuple[int, int],
+    dir_idx: int,
+    occupied: np.ndarray,
+) -> tuple[list[tuple[int, int]], bool]:
+    h, w = occupied.shape
+    dr, dc = DIRS[dir_idx]
+    cells: list[tuple[int, int]] = []
+    rr = current[0] + dr
+    cc = current[1] + dc
+    while 0 <= rr < h and 0 <= cc < w and not occupied[rr, cc]:
