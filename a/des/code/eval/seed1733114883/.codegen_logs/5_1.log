+            if plan is None:
+                continue
+            path_cells, obstacle_cells = plan
+            return {
+                "bbox": bbox,
+                "gap": gap,
+                "dir_idx": dir_idx,
+                "regions": regions,
+                "path": path_cells,
+                "obstacles": obstacle_cells,
+                "segments": [(int(region["color"]), int(region["area"])) for region in regions],
