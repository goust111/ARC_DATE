+def _paint_branch(
+    out: np.ndarray,
+    reserved: np.ndarray,
+    gap: tuple[int, int],
+    dir_idx: int,
+    segments: list[tuple[int, int]],
+) -> None:
+    h, w = out.shape
+    current = gap
+    current_dir = dir_idx
+    for color, length in segments:
+        for _ in range(length):
+            for _turns in range(4):
