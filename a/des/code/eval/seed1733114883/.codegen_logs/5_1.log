+    for profile in profiles:
+        for r0, c0 in positions:
+            r1 = r0 + fh - 1
+            c1 = c0 + fw - 1
+            rs0 = max(0, r0 - 1)
+            cs0 = max(0, c0 - 1)
+            rs1 = min(h, r1 + 2)
+            cs1 = min(w, c1 + 2)
