+        for rr, cc in path_part:
+            new_occ[rr, cc] = True
+        tail = _plan_path_recursive(
+            path_part[-1],
+            (dir_idx + 1) % 4,
+            remaining - step_count,
+            causes[1:],
+            new_occ,
