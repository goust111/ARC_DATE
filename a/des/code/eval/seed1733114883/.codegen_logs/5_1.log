+                if 0 <= nr < h and 0 <= nc < w and not reserved[nr, nc] and int(out[nr, nc]) == BLACK:
+                    out[nr, nc] = int(color)
+                    current = (nr, nc)
+                    break
+                current_dir = (current_dir + 1) % 4
+            else:
+                return
