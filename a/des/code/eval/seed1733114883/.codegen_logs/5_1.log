+
+BLACK = 0
+GREY = 5
+MAROON = 9
+REGION_COLORS = (1, 2, 3, 4, 6, 7, 8)
+
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+SIDE_TO_DIR = {"top": 0, "right": 1, "bottom": 2, "left": 3}
+
+GRID_H_RANGE = (18, 29)
+GRID_W_RANGE = (18, 29)
