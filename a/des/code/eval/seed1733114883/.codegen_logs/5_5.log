  38: def main(grid: np.ndarray) -> np.ndarray:
  39:     """
  40:     Infer the background, rotate the whole input 90 degrees counterclockwise, and stack two framed copies vertically.
  41: 
  42:     Input structure:
  43:     - Blue is absent from the input.
  44:     - One rare marker color appears in exactly two pixels.
  45:     - The background is the unique non-marker color whose removal leaves exactly two 4-connected foreground objects, each with one marker pixel and one body color.
  46:     - The whole grid, including background and foreground objects, is the sprite to transform.
  47: 
  48:     Rule:
  49:     - Rotate the entire input grid 90 degrees counterclockwise.
  50:     - Create a blue one-pixel frame around two vertical copies of the rotated grid.
  51:     - Use the input background color for the two endpoints of every horizontal frame/separator row.
  52: 
  53:     Key insight: The output is not a crop of the foreground objects; it is two copies of the complete rotated input, separated and enclosed by a newly added blue border.
  54:     """
  55:     g = np.asarray(grid, dtype=int)
  56:     assert g.ndim == 2
