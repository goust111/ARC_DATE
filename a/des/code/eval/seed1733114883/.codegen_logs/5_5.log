 128:     # Source = corner with >=2 strictly-outward (canonical dr<0 or dc<0) colored cells
 129:     # of a single color.
 130:     def _is_outward(off): return off[0] < 0 or off[1] < 0
 131:     sources = []
 132:     for c_key, items in per_corner.items():
 133:         outward = [(o, v) for (o, v) in items if _is_outward(o)]
 134:         if len(outward) >= 2:
 135:             colors = {v for (_, v) in outward}
 136:             assert len(colors) == 1, (
 137:                 f"source {c_key} has mixed outward colors: {colors}"
 138:             )
 139:             sources.append(c_key)
 140:     assert sources, "at least one source corner (pre-drawn outward pattern) required"
