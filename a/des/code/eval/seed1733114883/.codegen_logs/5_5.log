  28:     upper_left = _repeat_2x2(np.rot90(g, 2))
  29:     upper_right = _repeat_2x2(np.rot90(g, -1))
  30:     lower_left = _repeat_2x2(np.rot90(g, 1))
  31:     lower_right = _repeat_2x2(g)
  32: 
  33:     return np.block([[upper_left, upper_right], [lower_left, lower_right]])
