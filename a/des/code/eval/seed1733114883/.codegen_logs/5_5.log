 195:         # Map stripe color -> direction (0=up, 1=right, 2=down, 3=left)
 196:         dirs = {}
 197:         r0, r1, c0, c1 = reg["r0"], reg["r1"], reg["c0"], reg["c1"]
 198:         if r0 - 1 >= 0:
 199:             mc = Counter(grid[r0 - 1, c0:c1 + 1].tolist()).most_common(1)[0][0]
 200:             if mc in stripe_colors:
 201:                 dirs[int(mc)] = 0
