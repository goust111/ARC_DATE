  63:         for r in range(H):
  64:             row = grid[r, :]
  65:             if (row == row[0]).all() and row[0] != bg:
  66:                 top_h += 1
  67:             else:
  68:                 break
  69:         if top_h:
  70:             stripe[:top_h, :] = True
  71:             colors.add(int(grid[0, 0]))
  72:         # Bottom edge
