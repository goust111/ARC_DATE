  81:     def downsample_blocks(mask: np.ndarray) -> np.ndarray | None:
  82:         hh, ww = mask.shape
  83:         if hh % k != 0 or ww % k != 0:
  84:             return None
  85:         out_h, out_w = int(hh // k), int(ww // k)
  86:         out = np.zeros((out_h, out_w), dtype=bool)
  87:         for r in range(out_h):
  88:             for c in range(out_w):
  89:                 block = mask[int(r * k) : int((r + 1) * k), int(c * k) : int((c + 1) * k)]
