 179:     def regions_from_stripes(stripe_mask):
 180:         # Regions are connected components of all non-stripe cells.
 181:         non = ~stripe_mask
 182:         lab, n = label(non)
 183:         regs = []
 184:         for k in range(1, n + 1):
 185:             coords = np.argwhere(lab == k)
 186:             r0, c0 = coords.min(axis=0)
 187:             r1, c1 = coords.max(axis=0)
 188:             if (r1 - r0 + 1) >= 5 and (c1 - c0 + 1) >= 5:
 189:                 regs.append({"r0": int(r0), "r1": int(r1), "c0": int(c0), "c1": int(c1)})
 190:         return regs
