+def _detect_frames(grid: np.ndarray) -> tuple[int, list[dict[str, int | tuple[int, int, int, int] | str]]]:
+    g = np.asarray(grid, dtype=int)
+    if g.ndim != 2 or g.size == 0:
+        raise AssertionError("input must be a non-empty 2D grid")
