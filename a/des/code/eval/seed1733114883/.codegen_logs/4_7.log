+    if touch == "left":
+        return (int(r0), int(c0), int(r1), min(int(w - 1), int(2 * c1 - c0)))
+    return (int(r0), max(0, int(2 * c0 - c1)), int(r1), int(c1))
+
+
+def _placement_is_clipped(
+    box: tuple[int, int, int, int],
+    touch: str,
