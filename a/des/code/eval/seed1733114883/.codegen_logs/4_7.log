+    dirs = list(TOUCH_SIDES)
+    rng.shuffle(dirs)
+    size_hi = FRAME_OUTER_MAX_LARGE if n_frames <= 3 else FRAME_OUTER_MAX_SMALL
+    specs: list[dict[str, int | str | bool]] = []
