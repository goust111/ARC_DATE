+        return (int(r0), int(c0), min(int(h - 1), int(2 * r1 - r0)), int(c1))
+    if touch == "bottom":
+        return (max(0, int(2 * r0 - r1)), int(c0), int(r1), int(c1))
+    if touch == "left":
