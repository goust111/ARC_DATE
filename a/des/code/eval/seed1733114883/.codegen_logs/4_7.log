+    if touch == "bottom":
+        return int(2 * r0 - r1) < 0
+    if touch == "left":
+        return int(2 * c1 - c0) > w - 1
+    return int(2 * c0 - c1) < 0
+
+
+def _marker_cells(
+    box: tuple[int, int, int, int],
+    touch: str,
+    offset: int,
+) -> set[tuple[int, int]]:
