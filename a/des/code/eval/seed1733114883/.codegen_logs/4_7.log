+
+
+def _random_marker_offset(rng: random.Random, box: tuple[int, int, int, int], touch: str) -> int:
+    r0, c0, r1, c1 = box
+    inner_h = int(r1 - r0 - 1)
+    inner_w = int(c1 - c0 - 1)
