+    touches: list[str] = []
+    if mr0 == 0:
+        touches.append("top")
+    if mr1 == inner_h - 1:
+        touches.append("bottom")
+    if mc0 == 0:
+        touches.append("left")
+    if mc1 == inner_w - 1:
+        touches.append("right")
+    if len(touches) != 1:
+        raise AssertionError("marker must touch exactly one inner wall")
