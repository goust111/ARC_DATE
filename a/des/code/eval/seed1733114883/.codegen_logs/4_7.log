+    elif touch == "bottom":
+        sr = r0 + inner_h - 1
+        sc = c0 + 1 + offset
+    elif touch == "left":
+        sr = r0 + 1 + offset
+        sc = c0 + 1
+    else:
+        sr = r0 + 1 + offset
+        sc = c0 + inner_w - 1
+    return {
+        (int(sr), int(sc)),
+        (int(sr + 1), int(sc)),
+        (int(sr), int(sc + 1)),
+        (int(sr + 1), int(sc + 1)),
+    }
+
+
+def _random_marker_offset(rng: random.Random, box: tuple[int, int, int, int], touch: str) -> int:
+    r0, c0, r1, c1 = box
+    inner_h = int(r1 - r0 - 1)
