            rr = box_r0 + r * TILE
            cc = abs_c0 + c * TILE
            out[rr : rr + TILE, cc : cc + TILE] = filled
            patches[r][c] = filled
    return out


def _random_tile(rng: np.random.Generator, marker: int, body_palette: list[int]) -> np.ndarray:
    while True:
        patch = np.empty((TILE, TILE), dtype=int)
        patch[0, 0] = marker
