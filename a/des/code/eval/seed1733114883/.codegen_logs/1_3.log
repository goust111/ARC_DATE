+        tiles[marker] = patch.copy()
+    return tiles
+
+
+def _parse_canvas(right: np.ndarray, bg: int) -> tuple[tuple[int, int, int, int], list[list[np.ndarray]]]:
+    pts = np.argwhere(right != bg)
