+import numpy as np
+from collections import deque
+
+
+TILE = 3
+BG = 0
+SEP = 5
+RETRIES = 300
+ALL_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            q = deque([(r, c)])
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _find_separator(grid: np.ndarray, bg: int) -> tuple[int, int]:
+    h, w = grid.shape
+    candidates: list[tuple[int, int]] = []
+    for c in range(w):
+        color = int(grid[0, c])
+        if color == bg:
+            continue
+        if np.all(grid[:, c] == color):
+            candidates.append((c, color))
+    assert len(candidates) == 1, "expected one full-height separator"
+    return candidates[0]
+
+
+def _parse_directory(left: np.ndarray, bg: int) -> dict[int, np.ndarray]:
+    tiles: dict[int, np.ndarray] = {}
+    comps = _components(left != bg)
+    assert len(comps) >= 2, "expected multiple directory tiles"
+    for comp in comps:
+        rows = [r for r, _ in comp]
+        cols = [c for _, c in comp]
+        r0, r1 = min(rows), max(rows)
+        c0, c1 = min(cols), max(cols)
+        patch = left[r0 : r1 + 1, c0 : c1 + 1]
