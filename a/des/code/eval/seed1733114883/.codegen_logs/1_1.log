+            r = int(r_raw)
+            c = int(c_raw)
+            rr, cc = _mirror_point(lens, r, c)
+            if not (0 <= rr < h and 0 <= cc < w):
+                return None
+            if int(grid[rr, cc]) != BLACK:
+                return None
