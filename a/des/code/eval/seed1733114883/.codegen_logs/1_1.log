    length = max(h, w)
    if length == 1:
        coords.add((0, 0))
    else:
        for i in range(length):
            r = (i * (h - 1) + (length - 1) // 2) // (length - 1)
            c = (i * (w - 1) + (length - 1) // 2) // (length - 1)
            coords.add((int(r), int(c)))

    while len(coords) < size:
        frontier = []
        for r, c in coords:
            for dr in (-1, 0, 1):
                for dc in (-1, 0, 1):
                    if dr == 0 and dc == 0:
                        continue
