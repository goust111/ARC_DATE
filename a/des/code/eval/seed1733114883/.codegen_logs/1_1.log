+def _find_lenses(grid: np.ndarray) -> tuple[list[dict[str, int]], np.ndarray]:
+    h, w = grid.shape
+    lens_mask = np.zeros((h, w), dtype=bool)
+    lenses: list[dict[str, int]] = []
+
+    for comp in _monochromatic_components(grid):
