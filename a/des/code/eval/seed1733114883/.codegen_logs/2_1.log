+def _footprint_clear(occ: np.ndarray, r0: int, c0: int, h: int, w: int) -> bool:
+    rr0 = max(0, r0 - BUFFER)
+    cc0 = max(0, c0 - BUFFER)
+    rr1 = min(occ.shape[0], r0 + h + BUFFER)
+    cc1 = min(occ.shape[1], c0 + w + BUFFER)
+    return not occ[rr0:rr1, cc0:cc1].any()
