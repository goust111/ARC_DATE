+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    if not np.any(out != grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
