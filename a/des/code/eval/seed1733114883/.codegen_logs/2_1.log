+def _background_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not mask[r, c]:
+                continue
+            queue = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            for qr, qc in queue:
+                comp.append((qr, qc))
+                for dr, dc in ORTHO_DIRS:
+                    nr, nc = qr + dr, qc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            parts.append(comp)
+    return parts
+
+
+def _set_connected(cells: set[tuple[int, int]]) -> bool:
+    if not cells:
+        return False
+    start = next(iter(cells))
+    queue = [start]
+    seen = {start}
+    for r, c in queue:
+        for dr, dc in ORTHO_DIRS:
+            nxt = (r + dr, c + dc)
+            if nxt in cells and nxt not in seen:
+                seen.add(nxt)
+                queue.append(nxt)
+    return len(seen) == len(cells)
+
+
+def _interior_mask(boundary_mask: np.ndarray) -> np.ndarray:
+    h, w = boundary_mask.shape
+    open_mask = ~boundary_mask
+    outside = np.zeros((h, w), dtype=bool)
+    queue: list[tuple[int, int]] = []
+
+    def push(r: int, c: int) -> None:
+        if open_mask[r, c] and not outside[r, c]:
+            outside[r, c] = True
+            queue.append((r, c))
+
+    for r in range(h):
+        push(r, 0)
+        push(r, w - 1)
+    for c in range(w):
+        push(0, c)
+        push(h - 1, c)
+
+    for qr, qc in queue:
+        for dr, dc in ORTHO_DIRS:
+            nr, nc = qr + dr, qc + dc
+            if 0 <= nr < h and 0 <= nc < w and open_mask[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                queue.append((nr, nc))
+
+    return open_mask & ~outside
