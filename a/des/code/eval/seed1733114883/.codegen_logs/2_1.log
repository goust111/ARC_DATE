+
+def _legend_side(bbox: tuple[int, int, int, int], h: int, w: int) -> str | None:
+    r0, c0, r1, c1 = bbox
+    sides = []
+    if r0 == 0:
+        sides.append("top")
+    if r1 == h - 1:
+        sides.append("bottom")
+    if c0 == 0:
+        sides.append("left")
+    if c1 == w - 1:
+        sides.append("right")
+    if len(sides) != 1:
+        return None
+    return sides[0]
