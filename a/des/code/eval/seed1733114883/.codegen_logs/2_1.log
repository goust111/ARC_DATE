+    margin = band + 2
+    if side == "top":
+        return margin, h - 2, 1, w - 2
+    if side == "bottom":
+        return 1, h - margin - 1, 1, w - 2
+    if side == "left":
+        return 1, h - 2, margin, w - 2
+    return 1, h - 2, 1, w - margin - 1
