+            if seen[r, c] or not mask[r, c]:
+                continue
+            queue = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            for qr, qc in queue:
+                comp.append((qr, qc))
+                for dr, dc in ORTHO_DIRS:
+                    nr, nc = qr + dr, qc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            parts.append(comp)
+    return parts
