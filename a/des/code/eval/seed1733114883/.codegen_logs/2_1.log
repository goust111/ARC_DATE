+def _extract_legend(grid: np.ndarray, bg: int) -> tuple[dict[int, np.ndarray], np.ndarray]:
+    h, w = grid.shape
+    candidates: list[tuple[str, tuple[int, int, int, int], np.ndarray]] = []
