+    region_cols = random.randint(*REGION_COLS_RANGE)
+    row_heights = [random.randint(*REGION_HEIGHT_RANGE) for _ in range(region_rows)]
+    col_widths = [random.randint(*REGION_WIDTH_RANGE) for _ in range(region_cols)]
