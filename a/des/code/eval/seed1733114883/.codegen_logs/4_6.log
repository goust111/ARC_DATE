+
+def _most_common_color(grid: np.ndarray) -> int:
+    counts = np.bincount(np.asarray(grid, dtype=int).ravel(), minlength=10)
+    return int(np.argmax(counts))
+
+
+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    for dr, dc in DIRS4:
+        rr = int(r + dr)
+        cc = int(c + dc)
+        if 0 <= rr < h and 0 <= cc < w:
+            out.append((rr, cc))
+    return out
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((int(cr), int(cc)))
+                for nr, nc in _neighbors4(int(cr), int(cc), h, w):
+                    if bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _stamp_cells(
+    shape_cells: list[tuple[int, int]],
+    anchor: tuple[int, int],
+    height: int,
+    width: int,
+) -> tuple[set[tuple[int, int]], bool]:
+    cells: set[tuple[int, int]] = set()
+    clipped = False
+    ar, ac = anchor
+    for sr, sc in shape_cells:
+        rr = int(ar + sr)
+        cc = int(ac + sc)
+        if 0 <= rr < height and 0 <= cc < width:
+            cells.add((rr, cc))
+        else:
+            clipped = True
+    return cells, clipped
+
+
+def _separate_from(
+    cells: set[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+    height: int,
+    width: int,
+) -> bool:
+    if cells & occupied:
+        return False
+    for r, c in cells:
+        for nr, nc in _neighbors4(int(r), int(c), height, width):
+            if (nr, nc) in occupied and (nr, nc) not in cells:
+                return False
+    return True
