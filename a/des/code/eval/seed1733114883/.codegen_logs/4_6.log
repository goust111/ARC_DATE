+REGION_ROWS_RANGE = (2, 4)
+REGION_COLS_RANGE = (2, 4)
+REGION_HEIGHT_RANGE = (6, 10)
+REGION_WIDTH_RANGE = (6, 10)
+LINE_COLOR_COUNT_RANGE = (3, 5)
+LINE_COLOR_ATTEMPTS = 120
+REGION_CONTENT_ATTEMPTS = 160
+GENERATE_ATTEMPTS = 400
