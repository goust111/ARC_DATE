+            r1 = int(row_lines[i + 1] - 1)
+            c0 = int(col_lines[j] + 1)
+            c1 = int(col_lines[j + 1] - 1)
+            rh = int(r1 - r0 + 1)
+            cw = int(c1 - c0 + 1)
