+        rel_cells = [(int(r - tr0), int(c - tc0)) for r, c in template]
+
+        for rr, cc in template:
+            out[r0 + rr, c0 + cc] = stamp_color
+
+        markers = [(int(r), int(c)) for r, c in np.argwhere(region == MAROON)]
+        for mr, mc in markers:
