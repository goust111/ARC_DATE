+    available = [c for c in range(10) if c not in (bg, GREY, MAROON)]
+    min_count = min(LINE_COLOR_COUNT_RANGE[0], len(available))
+    max_count = min(LINE_COLOR_COUNT_RANGE[1], len(available))
+    for _ in range(LINE_COLOR_ATTEMPTS):
