+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
+    bg = _most_common_color(g)
+
+    line_mask = (g != bg) & (g != GREY) & (g != MAROON)
+    region_comps = _components(~line_mask)
+    out = g.copy()
+    out[g == MAROON] = bg
