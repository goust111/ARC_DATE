+def _graph_distances(graph: dict[int, dict[int, list[tuple[int, int]]]], start: int) -> dict[int, int]:
+    dist = {start: 0}
+    queue = deque([start])
+    while queue:
+        node = queue.popleft()
+        for nxt in graph[node]:
+            if nxt in dist:
+                continue
+            dist[nxt] = dist[node] + 1
+            queue.append(nxt)
+    return dist
