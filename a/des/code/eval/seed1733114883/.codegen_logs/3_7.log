+        for j in range(i + 1, len(rects)):
+            segment = _shared_wall_segment(rect_a, rects[j])
+            if segment is None:
+                continue
+            graph[i][j] = segment
+            graph[j][i] = segment
+            edges.append((i, j, segment))
+    return graph, edges
