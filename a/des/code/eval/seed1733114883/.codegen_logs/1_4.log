+    canvas[frame_r + frame_h - 1, frame_c : frame_c + frame_w] = GREY
+    canvas[frame_r : frame_r + frame_h, frame_c] = GREY
+    canvas[frame_r : frame_r + frame_h, frame_c + frame_w - 1] = GREY
