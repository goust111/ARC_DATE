+    cursor = int(frame_r)
+    for h in row_heights[:-1]:
+        cursor += int(h + 1)
+        canvas[cursor, frame_c : frame_c + frame_w] = GREY
+
+    cursor = int(frame_c)
+    for w in col_widths[:-1]:
+        cursor += int(w + 1)
+        canvas[frame_r : frame_r + frame_h, cursor] = GREY
