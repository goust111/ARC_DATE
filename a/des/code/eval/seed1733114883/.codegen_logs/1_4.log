+def _draw_frame(canvas: np.ndarray, frame_r: int, frame_c: int, row_heights: list[int], col_widths: list[int]) -> None:
+    frame_h = int(sum(row_heights) + len(row_heights) + 1)
+    frame_w = int(sum(col_widths) + len(col_widths) + 1)
