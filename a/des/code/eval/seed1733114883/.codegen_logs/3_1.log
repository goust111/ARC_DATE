+                return True
+            chosen.pop()
+            used_anchors.difference_update(item["anchors"])
+        return False
+
+    if not backtrack(0):
+        return None
+    chosen.sort(key=lambda item: int(item["start_idx"]))
+    return chosen
+
+
+def _legend_options(
+    pair_index: int, pairs: list[dict[str, object]], h: int, w: int
+) -> list[tuple[int, int, set[tuple[int, int]]]]:
