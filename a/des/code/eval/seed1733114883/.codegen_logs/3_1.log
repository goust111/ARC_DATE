+            used_cells.difference_update(cells)
+        return False
+
+    if not backtrack(0):
+        return None
+    return [pos for pos in placements if pos is not None]
+
+
+def _build_input_and_output() -> tuple[np.ndarray, np.ndarray] | None:
+    pair_count = random.randint(3, 5)
