+def _line_cells(a: tuple[int, int], b: tuple[int, int]) -> set[tuple[int, int]]:
+    r1, c1 = a
+    r2, c2 = b
+    if r1 == r2:
+        lo, hi = sorted((c1, c2))
+        return {(r1, c) for c in range(lo, hi + 1)}
+    if c1 == c2:
+        lo, hi = sorted((r1, r2))
+        return {(r, c1) for r in range(lo, hi + 1)}
+    raise AssertionError("segment must be axis-aligned")
