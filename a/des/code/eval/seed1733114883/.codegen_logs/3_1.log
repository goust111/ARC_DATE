+    seen: set[tuple[tuple[int, int], tuple[int, int]]] = set()
+    for i, side_a in enumerate(SIDES):
+        for side_b in SIDES[i + 1 :]:
+            for p1 in positions[side_a]:
+                for p2 in positions[side_b]:
