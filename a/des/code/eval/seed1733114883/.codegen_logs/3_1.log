+            outer = int(sub[0, 0])
+            inner = int(sub[1, 1])
+            if outer == BG or inner == BG or inner == outer:
+                continue
+            ring = [int(sub[r, c]) for r in range(3) for c in range(3) if (r, c) != (1, 1)]
+            if any(v != outer for v in ring):
