+        for r in range(1, h - 1)
+        for c in range(1, w - 1)
+        if int(g[r, c]) != BG
+    }
+
+    out = g.copy()
+    blocked = set(static_blocked)
+    for pair in pairs:
+        outer = int(pair["color"])
