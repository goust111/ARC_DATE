+        return {(r, c1) for r in range(lo, hi + 1)}
+    raise AssertionError("segment must be axis-aligned")
+
+
+def _path_info(
+    p1: tuple[int, int], p2: tuple[int, int], h: int, w: int
+) -> dict[str, object] | None:
+    i1 = _perimeter_index(p1, h, w)
