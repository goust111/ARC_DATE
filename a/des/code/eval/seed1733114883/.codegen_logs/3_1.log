+def _border_positions(h: int, w: int) -> dict[str, list[tuple[int, int]]]:
+    return {
+        "top": [(0, c) for c in range(1, w - 1)],
+        "right": [(r, w - 1) for r in range(1, h - 1)],
+        "bottom": [(h - 1, c) for c in range(1, w - 1)],
+        "left": [(r, 0) for r in range(1, h - 1)],
+    }
