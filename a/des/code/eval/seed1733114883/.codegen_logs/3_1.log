+def _perimeter_index(pos: tuple[int, int], h: int, w: int) -> int:
+    r, c = pos
+    if r == 0:
+        return c - 1
+    if c == w - 1:
+        return (w - 2) + (r - 1)
+    if r == h - 1:
+        return (w - 2) + (h - 2) + (w - 2 - c)
+    if c == 0:
+        return (w - 2) + (h - 2) + (w - 2) + (h - 2 - r)
+    raise AssertionError("position is not on the non-corner border")
