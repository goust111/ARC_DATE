+def _paint_legend(grid: np.ndarray, top_left: tuple[int, int], outer: int, inner: int) -> None:
+    r0, c0 = top_left
+    grid[r0 : r0 + 3, c0 : c0 + 3] = outer
+    grid[r0 + 1, c0 + 1] = inner
