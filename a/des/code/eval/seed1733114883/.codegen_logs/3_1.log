+    if r == 0:
+        return (1, c)
+    if r == h - 1:
+        return (h - 2, c)
+    if c == 0:
+        return (r, 1)
+    if c == w - 1:
+        return (r, w - 2)
+    raise AssertionError("position is not on the border")
