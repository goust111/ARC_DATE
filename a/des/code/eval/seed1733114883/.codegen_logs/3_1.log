+            placements[pair_idx] = (r0, c0)
+            used_cells.update(cells)
+            if backtrack(depth + 1):
+                return True
+            placements[pair_idx] = None
+            used_cells.difference_update(cells)
+        return False
+
+    if not backtrack(0):
+        return None
+    return [pos for pos in placements if pos is not None]
