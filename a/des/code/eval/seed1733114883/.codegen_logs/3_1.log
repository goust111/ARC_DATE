+SIDES = ("top", "right", "bottom", "left")
+BRANCH_TYPES = ("both", "h_only", "v_only")
+MAX_ATTEMPTS = 600
+
+
+def _perimeter_index(pos: tuple[int, int], h: int, w: int) -> int:
+    r, c = pos
+    if r == 0:
