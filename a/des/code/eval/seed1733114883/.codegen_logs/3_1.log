+def _random_derangement(values: list[int]) -> list[int]:
+    while True:
+        perm = values[:]
+        random.shuffle(perm)
+        if all(a != b for a, b in zip(values, perm, strict=False)):
+            return perm
+
+
+def _grid_bounds_for_pairs(pair_count: int) -> tuple[int, int]:
+    min_size = {3: 18, 4: 20, 5: 22}[pair_count]
+    return min_size, 25
