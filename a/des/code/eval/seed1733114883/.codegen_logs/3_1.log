+
+def _pick_pairs(
+    h: int, w: int, branches: list[str]
+) -> list[dict[str, object]] | None:
+    pool = _pair_pool(h, w)
+    chosen: list[dict[str, object]] = []
+    used_anchors: set[tuple[int, int]] = set()
+    search_branches = branches[:]
