+            if not set(selected).isdisjoint(old["cand_h"]):
+                return False
+            if not set(selected).isdisjoint(old["cand_v"]):
+                return False
+        return True
+
+    def backtrack(depth: int) -> bool:
+        if depth == len(search_branches):
+            return True
+        branch = search_branches[depth]
