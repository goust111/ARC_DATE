+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Decode 3x3 color legends and connect matching border anchor pairs with recolored L paths.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
+    assert h >= 5 and w >= 5
