+        cand_h = set(other["cand_h"])
+        cand_v = set(other["cand_v"])
+        if idx != pair_index:
+            forbidden.update(cand_h)
+            forbidden.update(cand_v)
+            continue
+        branch = str(pair["branch"])
+        if branch == "both":
+            forbidden.update(cand_h)
+            forbidden.update(cand_v)
+        elif branch == "h_only":
+            forbidden.update(cand_h)
+            required = cand_v
+        else:
+            forbidden.update(cand_v)
+            required = cand_h
