+    options: list[tuple[int, int, set[tuple[int, int]]]] = []
+    for r0 in range(1, h - 3):
+        for c0 in range(1, w - 3):
+            cells = _legend_cells((r0, c0))
+            if cells & forbidden:
+                continue
+            if required and not (cells & required):
+                continue
+            options.append((r0, c0, cells))
