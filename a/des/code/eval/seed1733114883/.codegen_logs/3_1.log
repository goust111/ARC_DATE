+    for c in range(w - 2, 0, -1):
+        v = int(grid[h - 1, c])
+        if v != BG:
+            border.setdefault(v, []).append((h - 1, c))
+    for r in range(h - 2, 0, -1):
+        v = int(grid[r, 0])
+        if v != BG:
