+    i1 = _perimeter_index(p1, h, w)
+    i2 = _perimeter_index(p2, h, w)
+    start, end = (p1, p2) if i1 <= i2 else (p2, p1)
+    start_idx = min(i1, i2)
+    s = _inward_point(start, h, w)
+    t = _inward_point(end, h, w)
+    if s[0] == t[0] or s[1] == t[1]:
+        return None
+    if abs(s[0] - t[0]) < 2 or abs(s[1] - t[1]) < 2:
+        return None
