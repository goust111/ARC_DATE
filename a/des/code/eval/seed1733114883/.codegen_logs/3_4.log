+def _sample_inner_dims(rng: random.Random, fence_count: int, seed_count: int) -> tuple[int, int]:
+    side_cap = {3: 8, 4: 7, 5: 6}[fence_count]
+    mode = rng.random()
+    if mode < 0.25 and side_cap >= 5:
