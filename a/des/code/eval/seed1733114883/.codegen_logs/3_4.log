+        positions = [(rng.randrange(inner_h), cols[0]), (rng.randrange(inner_h), cols[1]), (rng.randrange(inner_h), cols[2])]
+    else:
+        positions = _quadrant_seed_positions(rng, inner_h, inner_w)
+
+    for (dr, dc), color in zip(positions, colors):
