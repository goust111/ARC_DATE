+
+def _sample_inner_dims(
+    rng: random.Random, max_inner_h: int, max_inner_w: int, seed_count: int
+) -> tuple[int, int]:
+    inner_h = rng.randint(4, max_inner_h)
+    inner_w = rng.randint(4, max_inner_w)
