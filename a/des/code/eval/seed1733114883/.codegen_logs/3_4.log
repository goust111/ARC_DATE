+    placed: list[dict[str, int]] = []
+
+    for spec in specs:
+        oh = spec["outer_h"]
+        ow = spec["outer_w"]
+        if oh + 2 > h or ow + 2 > w:
+            return None
+
+        for _ in range(PLACEMENT_TRIES):
+            r0 = rng.randint(1, h - oh - 1)
+            c0 = rng.randint(1, w - ow - 1)
+            r1 = r0 + oh - 1
+            c1 = c0 + ow - 1
+
+            rr0 = max(0, r0 - 1)
+            cc0 = max(0, c0 - 1)
+            rr1 = min(h - 1, r1 + 1)
+            cc1 = min(w - 1, c1 + 1)
