+def _draw_fence(grid: np.ndarray, spec: dict[str, int]) -> None:
+    r0, c0, r1, c1 = spec["r0"], spec["c0"], spec["r1"], spec["c1"]
+    grid[r0, c0 : c1 + 1] = FENCE
+    grid[r1, c0 : c1 + 1] = FENCE
+    grid[r0 : r1 + 1, c0] = FENCE
+    grid[r0 : r1 + 1, c1] = FENCE
