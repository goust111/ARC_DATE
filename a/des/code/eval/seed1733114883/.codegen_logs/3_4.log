+    if sorted(found_counts) != sorted(expected_counts):
+        return False
+
+    out = main(grid)
+    if out.shape != grid.shape or np.array_equal(out, grid):
+        return False
+    if not np.array_equal(out[grid == FENCE], grid[grid == FENCE]):
+        return False
+    return True
