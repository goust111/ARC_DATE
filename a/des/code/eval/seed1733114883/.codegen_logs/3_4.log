+        if odd_choices and rng.random() < 0.55:
+            inner_h = rng.choice(odd_choices)
+        if odd_choices and rng.random() < 0.55:
+            inner_w = rng.choice(odd_choices)
+
+    return inner_h, inner_w
+
+
+def _try_place_boxes(
+    rng: random.Random, h: int, w: int, counts: list[int]
+) -> list[dict[str, int]] | None:
+    specs: list[dict[str, int]] = []
+    for seed_count in counts:
+        inner_h, inner_w = _sample_inner_dims(rng, len(counts), seed_count)
+        specs.append(
+            {
+                "seed_count": seed_count,
+                "inner_h": inner_h,
+                "inner_w": inner_w,
+                "outer_h": inner_h + 2,
+                "outer_w": inner_w + 2,
+            }
+        )
+
+    specs.sort(key=lambda item: item["outer_h"] * item["outer_w"], reverse=True)
