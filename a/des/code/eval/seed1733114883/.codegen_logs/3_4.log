+BG = 0
+FENCE = 5
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GRID_MIN = 18
+GRID_MAX = 25
+GEN_RETRIES = 400
+
+_COUNT_CYCLE = 0
