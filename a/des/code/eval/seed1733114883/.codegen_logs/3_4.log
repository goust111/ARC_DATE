+def _nearest_seed_color(
+    seeds: list[tuple[int, int, int]], corner_r: int, corner_c: int
+) -> int:
+    sr, sc, color = min(
+        seeds,
+        key=lambda item: (
+            abs(item[0] - corner_r) + abs(item[1] - corner_c),
+            item[0],
+            item[1],
+        ),
+    )
+    assert isinstance(sr, int) and isinstance(sc, int)
