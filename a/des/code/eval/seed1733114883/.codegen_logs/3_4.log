+        (near(0, mid_r - 1, False), near(mid_c, inner_w - 1, True)),
+        (near(mid_r, inner_h - 1, True), near(0, mid_c - 1, False)),
+        (near(mid_r, inner_h - 1, True), near(mid_c, inner_w - 1, True)),
+    ]
