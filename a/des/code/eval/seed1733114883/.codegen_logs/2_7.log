+def _path_is_clear(grid: np.ndarray, bg: int, src: tuple[int, int], dst: tuple[int, int]) -> bool:
+    sr, sc = src
+    dr, dc = dst
+    if sr == dr:
+        left = min(sc, dc) + _FRAME_SIZE
+        right = max(sc, dc)
+        if right <= left:
+            return False
+        return bool(np.all(grid[sr : sr + _FRAME_SIZE, left:right] == bg))
