+        colors = sorted(set(map(int, np.unique(patch))) - {BG, GREY})
+        assert len(colors) == 1, "piece border color must be unique"
+        pieces.append({"color": colors[0], "mask": mask})
+    pieces.sort(key=lambda item: item["color"])
+    return pieces
