+
+
+def _place_pieces(
+    rng: random.Random,
+    grid: np.ndarray,
+    occ: np.ndarray,
+    pieces: list[np.ndarray],
+    min_col: int,
+) -> bool:
+    h, w = grid.shape
+    order = sorted(pieces, key=lambda patch: patch.shape[0] * patch.shape[1], reverse=True)
+    for patch in order:
+        ph, pw = map(int, patch.shape)
+        positions = [
