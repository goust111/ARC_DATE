+TOOTH_COLORS = (BLUE, RED, GREEN, YELLOW, MAGENTA)
+CARDINAL_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+
+CW = 1
+CCW = -1
+
+MAX_SIDE = 30
+MAX_GEARS = 8
+STEP_CHOICES = (4, 5, 6)
+MARGIN_CHOICES = (1, 2, 3)
