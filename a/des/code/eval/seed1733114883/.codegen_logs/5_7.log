+    return (int(top_margin + 1 + lr * step), int(left_margin + 1 + lc * step))
+
+
+def _render_gear(grid: np.ndarray, center: tuple[int, int], teeth: tuple[int, int, int, int], *, driver: bool, spin: int) -> None:
+    r, c = center
