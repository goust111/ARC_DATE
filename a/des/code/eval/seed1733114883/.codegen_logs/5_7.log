+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+AZURE = 8
+MAROON = 9
+
+TOOTH_COLORS = (BLUE, RED, GREEN, YELLOW, MAGENTA)
+CARDINAL_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+
+CW = 1
+CCW = -1
+
+MAX_SIDE = 30
+MAX_GEARS = 8
+STEP_CHOICES = (4, 5, 6)
+MARGIN_CHOICES = (1, 2, 3)
+MAX_GENERATION_ATTEMPTS = 400
