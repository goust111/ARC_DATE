+    expected = _expected_from_scene(grid, bg, frames)
+    if np.array_equal(grid, expected):
+        return None
+
+    k = random.randrange(4)
+    inp = np.rot90(grid, k).copy()
+    out = np.rot90(expected, k).copy()
