+def _detect_frames(grid: np.ndarray) -> tuple[int, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    bg = int(Counter(map(int, g.flat)).most_common(1)[0][0])
+    frames: list[dict] = []
+    marker_total = int(np.count_nonzero(g == MARKER_COLOR))
