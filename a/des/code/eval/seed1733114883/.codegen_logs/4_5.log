+
+def _copy_masks(grid: np.ndarray) -> tuple[list[tuple[int, int, int, int]], list[np.ndarray]]:
+    copy_comps = _components(grid == GRAY)
+    assert len(copy_comps) >= 3, "expected at least three gray source copies"
