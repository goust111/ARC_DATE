+    margin_top = 1 + (depth + 1 if side == "top" else 0)
+    margin_bottom = 1 + (depth + 1 if side == "bottom" else 0)
+    margin_left = 1 + (depth + 1 if side == "left" else 0)
+    margin_right = 1 + (depth + 1 if side == "right" else 0)
+
