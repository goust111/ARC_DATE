+# --------------- generator ---------------
+
+GRID_MIN = 18
+GRID_MAX = 30
+K_CHOICES = (3, 4, 5)
+PROTOTYPE_DIM_RANGE = range(5, 9)
+LEGEND_SIDES = ("top", "bottom", "left", "right")
+LEGEND_DEPTH_CHOICES = (1, 2, 3)
+PROTOTYPE_MODES = ("solid", "light_bites", "deep_bites")
