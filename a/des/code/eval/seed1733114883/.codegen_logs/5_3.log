+def _choose_mirror_target(grid: np.ndarray, scene: dict, rng: random.Random) -> np.ndarray | None:
+    coverage = np.asarray(scene["coverage"], dtype=int)
+    primary: list[tuple[int, int]] = []
+    fallback: list[tuple[int, int]] = []
