+    rng.shuffle(shuffled)
+
+    for cell in shuffled:
+        if all(max(abs(int(cell[0]) - int(other[0])), abs(int(cell[1]) - int(other[1]))) > min_chebyshev for other in chosen):
+            return (int(cell[0]), int(cell[1]))
+
+    if shuffled:
+        cell = shuffled[0]
+        return (int(cell[0]), int(cell[1]))
+
+    return None
