+                mirror_kind = mirrors.get((int(r), int(c)))
+                if mirror_kind is not None:
+                    if reflections == 1:
+                        break
+                    if mirror_kind == "\\":
+                        dr, dc = BACKSLASH_REFLECT[(int(dr), int(dc))]
+                    else:
+                        dr, dc = SLASH_REFLECT[(int(dr), int(dc))]
+                    reflections = 1
+                    used_reflection = True
