  18: def main(grid: np.ndarray) -> np.ndarray:
  19:     """
  20:     Extract the compact table of solid cells hidden inside a separator lattice.
  21: 
  22:     Input structure
  23:     - The grid has full-width and full-height bars of one separator color, dividing it into rectangular cells.
  24:     - Most cells contain a repeating multicolor pattern, while a contiguous rectangle of cells is solid monochrome.
  25: 
  26:     Rule
  27:     - Split the input into lattice cells using the full separator rows and columns.
  28:     - Keep the cells whose full interior is one color, crop to their occupied rectangle, and output those colors.
  29: 
  30:     Key insight
  31:     - The periodic pattern is noise; only completely solid lattice cells encode the reduced output grid.
  32:     """
  33:     g = np.asarray(grid, dtype=int)
  34:     h, w = g.shape
  35: 
  36:     row_colors = {int(g[r, 0]) for r in range(h) if np.all(g[r, :] == g[r, 0])}
  37:     col_colors = {int(g[0, c]) for c in range(w) if np.all(g[:, c] == g[0, c])}
  38:     sep_colors = row_colors & col_colors
  39:     assert len(sep_colors) == 1, "there must be exactly one row/column separator color"
  40:     sep = next(iter(sep_colors))
  41:     assert row_colors == {sep}, "all full rows must be separator rows"
  42:     assert col_colors == {sep}, "all full columns must be separator columns"
  43: 
  44:     sep_rows = [r for r in range(h) if np.all(g[r, :] == sep)]
  45:     sep_cols = [c for c in range(w) if np.all(g[:, c] == sep)]
  46:     assert sep_rows and sep_cols, "separator lattice must have rows and columns"
  47: 
  48:     row_bands = _bands(h, sep_rows)
  49:     col_bands = _bands(w, sep_cols)
  50: 
  51:     solid_cells = {}
  52:     for ri, (r0, r1) in enumerate(row_bands):
  53:         for ci, (c0, c1) in enumerate(col_bands):
  54:             cell = g[r0 : r1 + 1, c0 : c1 + 1]
  55:             if np.all(cell == cell[0, 0]):
  56:                 solid_cells[(ri, ci)] = int(cell[0, 0])
  57:     assert solid_cells, "must contain at least one solid lattice cell"
  58: 
  59:     solid_rows = [ri for ri, _ in solid_cells]
  60:     solid_cols = [ci for _, ci in solid_cells]
  61:     r0, r1 = min(solid_rows), max(solid_rows)
  62:     c0, c1 = min(solid_cols), max(solid_cols)
  63: 
  64:     out = np.empty((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
  65:     for ri in range(r0, r1 + 1):
  66:         for ci in range(c0, c1 + 1):
  67:             assert (ri, ci) in solid_cells, "solid lattice cells must form a rectangle"
