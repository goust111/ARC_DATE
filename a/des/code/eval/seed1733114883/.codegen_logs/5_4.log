 154: def _connected_mask(height: int, width: int, target_area: int) -> np.ndarray | None:
 155:     """Grow a connected mask with full row/column span to the target area."""
 156:     mask = np.zeros((int(height), int(width)), dtype=bool)
 157:     steps = ["D"] * (int(height) - 1) + ["R"] * (int(width) - 1)
 158:     random.shuffle(steps)
 159: 
 160:     r = c = 0
 161:     mask[r, c] = True
 162:     for step in steps:
 163:         if step == "D":
 164:             r += 1
 165:         else:
 166:             c += 1
 167:         mask[r, c] = True
 168: 
 169:     if int(mask.sum()) > int(target_area):
 170:         return None
