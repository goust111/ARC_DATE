+    return arr
+
+
+def _make_grid(path: list[tuple[int, int]]) -> tuple[np.ndarray, list[np.ndarray]]:
+    room_rows = max(r for r, _ in path) + 1
+    room_cols = max(c for _, c in path) + 1
