 358:         bc = rng.randint(2, w - 2)
 359:         n = rng.randint(1, h - 2)
 360:         s = rng.randint(1, h - 1 - n + 1)
 361:         sprite[s:s + n, bc] = True
 362:     # Optionally remove border cells for irregularity
 363:     if rng.random() < _P_BORDER_REMOVAL:
 364:         bcells = [(r, c) for r in range(h) for c in range(w)
 365:                   if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]
 366:         rng.shuffle(bcells)
 367:         for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:
 368:             test = sprite.copy()
 369:             test[cr, cc] = False
 370:             if _get_enclosed_holes(test):
 371:                 sprite = test
 372:     if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:
