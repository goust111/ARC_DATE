+def _choose_start(rooms: list[dict], adj: dict[int, list[int]], active: set[int]) -> int:
+    degrees = {idx: sum(int(nb in active) for nb in adj[idx]) for idx in active}
+    isolated = [idx for idx, deg in degrees.items() if deg == 0]
+    if len(isolated) == 1:
