+
+def _neighbors(cell: tuple[int, int], room_rows: int, room_cols: int):
+    r, c = cell
+    if r > 0:
+        yield (r - 1, c)
+    if r + 1 < room_rows:
+        yield (r + 1, c)
+    if c > 0:
+        yield (r, c - 1)
+    if c + 1 < room_cols:
+        yield (r, c + 1)
+
+
+def _remaining_connected(
+    room_rows: int, room_cols: int, visited: set[tuple[int, int]]
