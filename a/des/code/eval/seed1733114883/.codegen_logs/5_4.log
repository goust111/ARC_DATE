+            rr = a[0]
+            cc = min(a[1], b[1]) + 1
+            wall_c = int(wall_cols[cc])
+            door_r = random.randint(int(wall_rows[rr] + 1), int(wall_rows[rr + 1] - 1))
+            grid[door_r, wall_c] = BACKGROUND
