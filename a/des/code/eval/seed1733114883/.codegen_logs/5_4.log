+def _pattern(room_h: int, room_w: int) -> np.ndarray:
+    ph = random.randint(1, min(PATTERN_HEIGHT_MAX, room_h - 2))
+    pw = random.randint(1, min(PATTERN_WIDTH_MAX, room_w - 2))
