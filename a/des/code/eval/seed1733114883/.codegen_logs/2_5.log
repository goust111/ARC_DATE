+BG = 0
+WIRE = 5
+RECEIVER = 9
+SIGNAL_COLORS = (1, 2, 3, 4, 6, 7, 8)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_RETRIES = 400
