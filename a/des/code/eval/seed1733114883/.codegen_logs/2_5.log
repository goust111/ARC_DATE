+    return candidates[0][1], candidates[0][2]
+
+
+def _find_sources(grid: np.ndarray, legend_mask: np.ndarray) -> list[dict[str, object]]:
+    mask = (grid != BG) & (grid != WIRE) & (grid != RECEIVER) & (~legend_mask)
