+        raise AssertionError("sources not found")
+    return sources
+
+
+def _find_receivers(grid: np.ndarray) -> list[dict[str, object]]:
+    receivers: list[dict[str, object]] = []
+    for pts in _component_cells(grid == RECEIVER):
+        if len(pts) != 8:
