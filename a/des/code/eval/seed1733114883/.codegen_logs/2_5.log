+    for pts in _component_cells(mask):
+        if len(pts) != 9:
+            continue
+        r0, c0, r1, c1 = _bbox(pts)
+        if (r1 - r0, c1 - c0) != (2, 2):
+            continue
+        color = int(grid[r0, c0])
+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        if np.all(patch == color):
+            sources.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "cells": set(pts),
