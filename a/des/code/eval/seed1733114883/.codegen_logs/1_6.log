+    grid: np.ndarray,
+    adjacency: dict[tuple[int, int], tuple[tuple[int, int], ...]],
+    prev: tuple[int, int] | None,
+    curr: tuple[int, int],
+) -> tuple[tuple[int, int], ...]:
+    neighbors = adjacency[curr]
+    if prev is None:
+        candidates = list(neighbors)
+    else:
+        candidates = [cell for cell in neighbors if cell != prev]
