+    blocked: set[tuple[int, int]] = set()
+    claimed_terminals: set[tuple[int, int]] = set()
+
+    active: list[tuple[int, tuple[int, int] | None, tuple[int, int]]] = [
+        (int(color), None, cell) for color, cell in sources
