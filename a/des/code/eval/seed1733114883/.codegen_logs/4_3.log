+def _can_extend(path_set: set[tuple[int, int]], prev: tuple[int, int], nxt: tuple[int, int], h: int, w: int) -> bool:
+    r, c = nxt
+    if not (1 <= r < h - 1 and 1 <= c < w - 1):
+        return False
+    if nxt in path_set:
+        return False
+    for nb in _neighbors4(r, c, h, w):
+        if nb in path_set and nb != prev:
+            return False
+    return True
+
