+def _gate_capacity(candidates: list[dict[str, object]]) -> int:
+    last = -10**9
+    count = 0
+    for cand in sorted(candidates, key=lambda x: int(x["index"])):
+        idx = int(cand["index"])
+        if idx - last <= 1:
+            continue
+        last = idx
+        count += 1
+    return int(count)
