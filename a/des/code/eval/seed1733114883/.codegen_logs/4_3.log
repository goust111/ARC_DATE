+            down = (cur[0] + 1, cur[1])
+            if up not in path_set and down not in path_set and 0 <= up[0] < h and down[0] < h:
+                pair = (up, down)
+        elif prev[1] == cur[1] == nxt[1]:
+            left = (cur[0], cur[1] - 1)
+            right = (cur[0], cur[1] + 1)
+            if left not in path_set and right not in path_set and 0 <= left[1] < w and right[1] < w:
+                pair = (left, right)
