+    for ordered in ordered_paths:
+        current_color = GREY
+        start = ordered[0]
+        for cell in ordered:
+            if cell in gate_by_cell:
+                current_color = int(gate_by_cell[cell])
+            r, c = cell
+            if cell == start:
+                out[r, c] = MAROON
+            else:
+                out[r, c] = int(current_color)
