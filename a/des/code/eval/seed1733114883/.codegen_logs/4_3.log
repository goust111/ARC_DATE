+def _place_patch(dst: np.ndarray, patch: np.ndarray, bg: int, top: int, left: int) -> None:
+    pts = np.argwhere(patch != bg)
+    for pr, pc in pts:
+        dst[top + int(pr), left + int(pc)] = int(patch[int(pr), int(pc)])
