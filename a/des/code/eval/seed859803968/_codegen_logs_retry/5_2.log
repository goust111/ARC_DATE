+    out = g.copy()
+    for cell, colors in reached.items():
+        out[cell] = _mix_color(colors)
+    return out
+
+
+# --------------- generator ---------------
+
+GEN_ATTEMPTS = 400
+SIZE_RANGE = (11, 18)
+FAMILIES = ("plus", "elbow")
+MODES = ("pair_only", "single_pair", "pair_triple", "triple_only")
+TRANSFORMS = (
