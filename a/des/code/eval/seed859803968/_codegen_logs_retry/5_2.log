+def _mix_color(colors: set[int]) -> int:
+    if not colors:
+        return GREY
+    if len(colors) == 1:
+        return next(iter(colors))
+    mixed = MIX_COLORS.get(frozenset(colors))
+    assert mixed is not None, "unexpected color combination"
+    return mixed
