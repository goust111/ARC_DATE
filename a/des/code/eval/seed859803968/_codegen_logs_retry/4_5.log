+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+MAROON = 9
+
+EMITTER_COLORS = (RED, BLUE, YELLOW)
