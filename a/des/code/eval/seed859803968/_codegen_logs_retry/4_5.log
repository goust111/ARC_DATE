+def _count_mirrors(grid: np.ndarray) -> int:
+    return len(_find_mirrors(grid)) // 2
+
+
+def _mix_counts(mask: np.ndarray) -> Counter:
+    cnt = Counter()
+    for value in mask.flat:
+        cnt[int(value)] += 1
+    cnt.pop(0, None)
+    return cnt
