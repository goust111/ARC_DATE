+}
+
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+DIRS = (UP, DOWN, LEFT, RIGHT)
+
+TOP = "top"
+BOTTOM = "bottom"
+LEFT_SIDE = "left"
+RIGHT_SIDE = "right"
+SIDES = (TOP, BOTTOM, LEFT_SIDE, RIGHT_SIDE)
+
+MAX_GEN_ATTEMPTS = 600
