    height, width = opened.shape
    n_walls = (height - 1) // 2

    finals: list[tuple[int, int]] = []
    drop_counts: list[int] = []

    for pipe_idx in range(n_walls):
        for start_c in (0, width - 1):
            r = 2 * pipe_idx
            c = start_c
            drops = 0
            while True:
                seg = _find_segment(opened, r, c)
                if seg is None:
