+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            out.append((r + dr, c + dc))
+    return out
+
+
+def _side_of_dir(d: tuple[int, int]) -> str:
+    if d == UP:
+        return TOP
+    if d == DOWN:
+        return BOTTOM
+    if d == LEFT:
+        return LEFT_SIDE
+    if d == RIGHT:
+        return RIGHT_SIDE
+    raise ValueError(f"unknown direction {d}")
+
+
+def _opposite_dir(d: tuple[int, int]) -> tuple[int, int]:
+    dr, dc = d
+    return (-dr, -dc)
+
+
+def _opposite_side(side: str) -> str:
