+                        "legend_pos": (legend_top, legend_left),
+                        "grey_patch": grey_patch,
+                        "grey_pos": (grey_top, grey_left),
+                        "expected_patch": expected_patch,
+                        "grey_mask": grey_mask,
+                    }
+                )
