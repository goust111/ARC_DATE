+        r0, c0, r1, c1 = _bbox(coords)
+        patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+        rel = coords - np.array([r0, c0], dtype=int)
+        patch[rel[:, 0], rel[:, 1]] = grid[coords[:, 0], coords[:, 1]]
+        mask = patch != bg
