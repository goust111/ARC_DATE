+        c0 = rng.randint(2, grid_w - box_w - 3)
+        box = (r0, c0, r0 + box_h - 1, c0 + box_w - 1)
+        if not _bbox_conflicts(box, reserved, gap=1):
+            reserved.append(box)
+            return r0, c0
