+        if not _bbox_conflicts(box, reserved, gap=1):
+            reserved.append(box)
+            return r0, c0
+    raise RuntimeError("failed to place grey object in the interior")
+
+
+def _generate_case(rng: random.Random | None = None) -> tuple[np.ndarray, np.ndarray]:
