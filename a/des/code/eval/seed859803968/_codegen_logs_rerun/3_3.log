+        return False
+    want: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        want.add((r0, c))
+        want.add((r1, c))
+    for r in range(r0 + 1, r1):
+        want.add((r, c0))
+        want.add((r, c1))
+    return set(points) == want
