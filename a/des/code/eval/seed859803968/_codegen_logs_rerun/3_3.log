+    for depth, frame in enumerate(frames_outer_to_inner):
+        fr0, fc0, fr1, fc1 = frame["bbox"]
+        rel_bbox = (fr0 - r0, fc0 - c0, fr1 - r0, fc1 - c0)
+        rel_bboxes.append(rel_bbox)
+        canvas[_frame_mask((h, w), rel_bbox)] = FRAME_COLORS[depth % 2]
