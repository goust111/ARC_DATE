+
+def _paint_mask_clipped(
+    out: np.ndarray,
+    mask: np.ndarray,
+    color: int,
+    top: int,
+    left: int,
+    clip_bbox: tuple[int, int, int, int],
+) -> None:
+    h, w = mask.shape
+    cr0, cc0, cr1, cc1 = clip_bbox
+    r0 = max(top, cr0)
+    c0 = max(left, cc0)
+    r1 = min(top + h - 1, cr1)
+    c1 = min(left + w - 1, cc1)
+    if r0 > r1 or c0 > c1:
+        return
+    mr0 = r0 - top
+    mc0 = c0 - left
+    mr1 = mr0 + (r1 - r0 + 1)
+    mc1 = mc0 + (c1 - c0 + 1)
