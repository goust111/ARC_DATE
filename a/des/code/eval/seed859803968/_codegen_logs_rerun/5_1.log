+    for spec in sorted(block_specs, key=lambda item: -len(holes[item["side"]])):
+        side = spec["side"]
+        chosen = None
+        for sprite_mask in _edge_sprite_choices(side):
+            for r0, c0 in _zone_positions(frame_bbox, side):
