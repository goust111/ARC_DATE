+    holes: dict[str, list[int]],
+    blocks: list[dict],
+) -> np.ndarray:
+    out = inp.copy()
+    fr0, fc0, fr1, fc1 = frame_bbox
+    inner_clip = (fr0 + 1, fc0 + 1, fr1 - 1, fc1 - 1)
+    for block in blocks:
+        r0, c0, r1, c1 = block["bbox"]
+        out[r0 : r1 + 1, c0 : c1 + 1] = bg
+    for block in blocks:
