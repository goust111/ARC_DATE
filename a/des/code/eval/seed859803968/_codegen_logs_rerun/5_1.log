+    for r in holes["right"]:
+        grid[r, fc1] = bg
+    return grid
+
+
+def _free_positions(occ: np.ndarray, shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = occ.shape
+    ph, pw = shape
+    positions = []
