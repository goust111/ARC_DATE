+    cells: set[tuple[int, int]] = set()
+    for top, left in origins:
+        for rr, cc in np.argwhere(mirrored):
+            r = int(top + rr)
+            c = int(left + cc)
+            if not (inner_clip[0] <= r <= inner_clip[2] and inner_clip[1] <= c <= inner_clip[3]):
