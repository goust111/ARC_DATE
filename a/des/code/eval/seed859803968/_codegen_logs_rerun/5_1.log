+    choices: list[np.ndarray] = []
+    for mask in base:
+        choice = mask.copy()
+        if side in ("top", "bottom") and random.random() < 0.5:
+            choice = np.fliplr(choice)
+        if side in ("left", "right") and random.random() < 0.5:
