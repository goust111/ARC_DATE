+
+
+def _nearest_edge(
+    block_bbox: tuple[int, int, int, int], frame_bbox: tuple[int, int, int, int]
+) -> str:
+    br0, bc0, br1, bc1 = block_bbox
+    fr0, fc0, fr1, fc1 = frame_bbox
+    distances = {
+        "top": br0 - fr0,
+        "bottom": fr1 - br1,
+        "left": bc0 - fc0,
+        "right": fc1 - bc1,
+    }
+    return min(EDGE_ORDER, key=lambda side: (distances[side], EDGE_ORDER.index(side)))
