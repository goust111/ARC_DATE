+
+def _neighbors4(r: int, c: int, h: int, w: int) -> Iterable[tuple[int, int]]:
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            queue = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            head = 0
+            while head < len(queue):
+                cr, cc = queue[head]
+                head += 1
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            r0, c0 = arr.min(axis=0)
+            r1, c1 = arr.max(axis=0)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def _component_mask(comp: dict) -> np.ndarray:
+    r0, c0, r1, c1 = comp["bbox"]
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    coords = comp["coords"]
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask
+
+
+def _is_perimeter_component(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    if r1 - r0 < 4 or c1 - c0 < 4:
+        return False
+    for r, c in comp["coords"]:
+        if r not in (r0, r1) and c not in (c0, c1):
+            return False
+    return True
+
+
+def _find_frame(comps: list[dict]) -> dict:
+    frame_candidates = [comp for comp in comps if _is_perimeter_component(comp)]
+    assert frame_candidates, "frame not found"
+    return max(frame_candidates, key=lambda comp: comp["area"])
+
+
+def _is_inner_block(comp: dict, frame_bbox: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    fr0, fc0, fr1, fc1 = frame_bbox
+    return (
+        comp["area"] == 4
+        and r1 - r0 == 1
+        and c1 - c0 == 1
+        and fr0 < r0 <= r1 < fr1
+        and fc0 < c0 <= c1 < fc1
+    )
+
+
+def _edge_holes(
+    grid: np.ndarray, frame_bbox: tuple[int, int, int, int], bg: int
+) -> dict[str, list[int]]:
+    fr0, fc0, fr1, fc1 = frame_bbox
+    return {
+        "top": [c for c in range(fc0 + 1, fc1) if int(grid[fr0, c]) == bg],
+        "bottom": [c for c in range(fc0 + 1, fc1) if int(grid[fr1, c]) == bg],
+        "left": [r for r in range(fr0 + 1, fr1) if int(grid[r, fc0]) == bg],
+        "right": [r for r in range(fr0 + 1, fr1) if int(grid[r, fc1]) == bg],
