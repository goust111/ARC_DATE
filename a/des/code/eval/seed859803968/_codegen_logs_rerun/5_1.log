+                if any(proj_occ[r, c] for r, c in proj_cells):
+                    continue
+                if any(proj_occ[r, c] for r, c in block_cells):
+                    continue
+                chosen = {
+                    "color": spec["color"],
+                    "side": side,
+                    "bbox": bbox,
+                    "sprite_mask": sprite_mask,
+                    "mirrored_mask": mirrored,
+                    "projected_cells": proj_cells,
