+    frame = _find_frame(comps)
+    frame_bbox = frame["bbox"]
+    holes = _edge_holes(g, frame_bbox, bg)
+
+    blocks: dict[int, dict] = {}
+    sprites: dict[int, dict] = {}
+    for comp in comps:
+        if comp is frame:
+            continue
+        color = int(comp["color"])
+        if _is_inner_block(comp, frame_bbox):
+            blocks[color] = comp
+        else:
+            sprites[color] = comp
