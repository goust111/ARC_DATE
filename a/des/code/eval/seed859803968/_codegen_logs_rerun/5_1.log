+
+
+def _free_positions(occ: np.ndarray, shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = occ.shape
+    ph, pw = shape
+    positions = []
+    for r0 in range(h - ph + 1):
+        for c0 in range(w - pw + 1):
+            rr0 = max(0, r0 - 1)
+            cc0 = max(0, c0 - 1)
+            rr1 = min(h, r0 + ph + 1)
+            cc1 = min(w, c0 + pw + 1)
+            if occ[rr0:rr1, cc0:cc1].any():
