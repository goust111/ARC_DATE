+    left = patch[:, 0]
+    right = patch[:, -1]
+    bottom = patch[-1, :]
+    wall_candidates = (set(map(int, left)) & set(map(int, right)) & set(map(int, bottom))) - {int(bg)}
+    assert wall_candidates, "failed to identify container wall color"
+    wall = int(sorted(wall_candidates)[0])
