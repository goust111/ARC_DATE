+GEN_ATTEMPTS = 300
+OBJECT_BUILD_ATTEMPTS = 200
+PLACEMENT_ATTEMPTS = 250
+MASK_ATTEMPTS = 200
+GRID_MIN = 24
+GRID_MAX = 40
+OBJ_COUNT_RANGE = (2, 4)
+NOISE_MAX = 6
