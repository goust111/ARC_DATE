+
+            inp_grid[r0 : r0 + oh, c0 : c0 + ow] = inp_obj
+            out_grid[r0 : r0 + oh, c0 : c0 + ow] = out_obj
+            blocked[rr0:rr1, cc0:cc1] = True
+            placements.append((r0, c0, oh, ow))
+            placed = True
+            break
+        if not placed:
+            return None
+
+    noise_colors = list(range(1, 10))
+    free = np.argwhere(~blocked & (inp_grid == 0))
+    if len(free):
