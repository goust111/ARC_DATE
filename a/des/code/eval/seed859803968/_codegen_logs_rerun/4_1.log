+def _choose_object_types(n: int, rng: np.random.Generator) -> list[str]:
+    base = ["h", "v", "hv"]
+    perm = [base[i] for i in rng.permutation(len(base))]
+    out = []
+    while len(out) < n:
+        out.extend(perm)
+        perm = [base[i] for i in rng.permutation(len(base))]
