+        seed_center_r = seed["top"] + cr
+        seed_center_c = seed["left"] + cc
+        gap_r, gap_c = frame["gap"]
+        r0, c0, r1, c1 = frame["bbox"]
+
+        anchor_row = seed_center_r
+        anchor_col = seed_center_c
+        if frame["side"] in ("top", "bottom"):
+            anchor_col = gap_c
+        else:
+            anchor_row = gap_r
+
