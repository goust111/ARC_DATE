+def _aligned_positions(base: int, step: int, low: int, high: int) -> list[int]:
+    if low > high:
+        return []
+    start = base
+    while start < low:
+        start += step
+    while start - step >= low:
+        start -= step
+    out = []
+    cur = start
+    while cur <= high:
+        out.append(int(cur))
+        cur += step
+    return out
