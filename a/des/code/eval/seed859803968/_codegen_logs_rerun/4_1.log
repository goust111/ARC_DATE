+        out = np.zeros((outer_h, outer_w), dtype=int)
+        _draw_frame(inp, border_color, side)
+        _draw_frame(out, border_color, side)
+        _paint_local_seed(inp, seed_top, seed_left, mask, seed_color)
+        for top, left in tiles:
