+def _paint_seed(out: np.ndarray, top: int, left: int, mask: np.ndarray, color: int, bg: int) -> None:
+    patch = out[top : top + mask.shape[0], left : left + mask.shape[1]]
+    fill = mask & (patch == bg)
+    patch[fill] = int(color)
