+        if kind == "h" and h_sym and not v_sym:
+            return mask
+        if kind == "v" and v_sym and not h_sym:
+            return mask
+        if kind == "hv" and h_sym and v_sym and int(mask.sum()) < mask.size:
+            return mask
+    raise RuntimeError(f"failed to make {kind} seed")
