+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    out = g.copy()
+
+    frames: list[tuple[int, dict, int]] = []
+    for color in sorted(set(map(int, np.unique(g))) - {bg}):
+        for comp in _components_for_color(g, color):
+            frame = _frame_from_component(comp)
+            if frame is not None:
