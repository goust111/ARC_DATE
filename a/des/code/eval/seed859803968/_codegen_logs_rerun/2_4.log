+
+def _bend_feature(
+    rng: random.Random,
+    cells: set[tuple[int, int]],
+    h: int,
+    w: int,
+    forbidden: set[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    base_r, base_c = rng.choice(tuple(cells))
+    dr1, dc1 = rng.choice(NEIGHBORS4)
+    if dr1 == 0:
+        turn_options = ((1, 0), (-1, 0))
+    else:
+        turn_options = ((0, 1), (0, -1))
