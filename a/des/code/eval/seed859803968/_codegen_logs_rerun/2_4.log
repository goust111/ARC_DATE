+
+def _random_shortest_path(
+    rng: random.Random,
+    h: int,
+    w: int,
+    start: tuple[int, int],
+    goal: tuple[int, int],
+    blocked: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    if start == goal:
+        return [start]
+
+    blocked = set(blocked)
+    blocked.discard(start)
+    blocked.discard(goal)
+    queue = deque([start])
+    parents: dict[tuple[int, int], tuple[int, int] | None] = {start: None}
+
+    while queue:
+        cur = queue.popleft()
+        neighbors = _neighbors4(cur[0], cur[1], h, w)
+        rng.shuffle(neighbors)
+        for nxt in neighbors:
+            if nxt in blocked or nxt in parents:
+                continue
+            parents[nxt] = cur
+            if nxt == goal:
+                path = [goal]
+                node = cur
+                while node is not None:
+                    path.append(node)
+                    node = parents[node]
+                path.reverse()
+                return path
+            queue.append(nxt)
+    return None
+
+
+def _line_feature(
+    rng: random.Random,
+    cells: set[tuple[int, int]],
+    h: int,
+    w: int,
