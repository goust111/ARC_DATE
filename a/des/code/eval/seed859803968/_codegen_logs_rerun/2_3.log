+            stack = [(int(r0), int(c0))]
+            seen[r0, c0] = True
+            coords: list[tuple[int, int]] = []
+
+            while stack:
+                r, c = stack.pop()
+                coords.append((int(r), int(c)))
+                for dr in (-1, 0, 1):
+                    for dc in (-1, 0, 1):
+                        if dr == 0 and dc == 0:
+                            continue
