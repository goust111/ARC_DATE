+def _sample_directions(n_arrows: int) -> list[str]:
+    horizontal = random.choice([["left"], ["right"], ["left", "right"]])
+    vertical = random.choice([["up"], ["down"], ["up", "down"]])
+    seed = horizontal + vertical
+
+    if len(seed) > n_arrows:
+        random.shuffle(seed)
+        return seed[:n_arrows]
+
+    remaining = [d for d in DIRECTIONS if d not in seed]
+    random.shuffle(remaining)
+    dirs = seed + remaining[: max(0, min(4, n_arrows) - len(seed))]
+    while len(dirs) < n_arrows:
