+        < int(spec["body_len"])
+        for spec in specs
+    }
+    if len(used_dirs) < 2 or len(used_trunc) < 2:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _generate_once()
+        if grid is not None:
