+        top = shelf_row - sh
+        left = target_col - sw // 2
+        assert top >= 0 and left >= 0 and left + sw <= w
+        _place_patch(out, sprite_patch, top, left)
+    return out
+
+
+def _gen_attempt(rng: random.Random) -> Optional[np.ndarray]:
