+            return top, left
+    return None
+
+
+def _build_expected_output(
+    shape: Tuple[int, int],
+    shelf_row: int,
+    marker_map: Dict[int, int],
+    sprite_by_color: Dict[int, np.ndarray],
+) -> np.ndarray:
