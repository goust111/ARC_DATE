+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 8
+PALETTE = [c for c in range(10) if c != BG]
+GEN_RETRIES = 400
+LAYOUT_OPTIONS = [(2, 2), (2, 3), (3, 2), (3, 3), (3, 3)]
+BODY_SIZE_CHOICES = (3, 4, 5)
+SCATTER_RETRIES = 40
+POSITION_RETRIES = 200
