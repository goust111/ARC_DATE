+    if strip.any():
+        return None
+    missing = np.flatnonzero(~line)
+    if missing.size == 0:
+        return "smooth", None
+    if missing.size == 1 and int(missing[0]) not in (0, length - 1) and np.count_nonzero(line) == length - 1:
+        return "slot", int(missing[0])
+    return None
