+
+def _render_piece_mask(
+    body_h: int, body_w: int, sides: dict[str, tuple[str, int | None]]
+) -> np.ndarray:
+    top_tooth = sides["top"][0] == "tooth"
+    bottom_tooth = sides["bottom"][0] == "tooth"
+    left_tooth = sides["left"][0] == "tooth"
+    right_tooth = sides["right"][0] == "tooth"
