+def _matches_boundary(piece: dict, r: int, c: int, rows: int, cols: int) -> bool:
+    expectations = {
+        "top": r == 0,
+        "bottom": r == rows - 1,
+        "left": c == 0,
+        "right": c == cols - 1,
+    }
+    for side, needs_smooth in expectations.items():
+        if (piece["sides"][side][0] == "smooth") != needs_smooth:
+            return False
