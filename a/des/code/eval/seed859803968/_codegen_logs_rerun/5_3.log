+    out = np.full((sum(row_heights), sum(col_widths)), -1, dtype=int)
+    for r, row in enumerate(layout):
+        for c, piece_idx in enumerate(row):
+            piece = pieces[piece_idx]
+            top = row_starts[r] - piece["body_r0"]
+            left = col_starts[c] - piece["body_c0"]
