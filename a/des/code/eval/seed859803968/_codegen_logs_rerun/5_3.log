+    return None
+
+
+def _gen_attempt() -> tuple[np.ndarray, np.ndarray] | None:
+    built = _build_canonical_pieces()
+    if built is None:
+        return None
+    pieces, expected = built
+    transform = random.randrange(8)
+    transformed = []
+    for piece in pieces:
+        transformed.append(
