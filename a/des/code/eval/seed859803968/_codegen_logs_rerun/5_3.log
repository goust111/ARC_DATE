+
+def _apply_transform(arr: np.ndarray, code: int) -> np.ndarray:
+    if code == 0:
+        return arr.copy()
+    if code == 1:
+        return np.rot90(arr, 1).copy()
+    if code == 2:
+        return np.rot90(arr, 2).copy()
+    if code == 3:
+        return np.rot90(arr, 3).copy()
+    if code == 4:
+        return np.fliplr(arr).copy()
+    if code == 5:
+        return np.flipud(arr).copy()
+    if code == 6:
+        return arr.T.copy()
+    if code == 7:
