+                    body_c0 = left_tooth
+                    body_h = h - top_tooth - bottom_tooth
+                    body_w = w - left_tooth - right_tooth
+                    if body_h < 3 or body_w < 3:
+                        continue
+                    body_r1 = body_r0 + body_h - 1
+                    body_c1 = body_c0 + body_w - 1
