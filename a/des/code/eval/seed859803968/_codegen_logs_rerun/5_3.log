+            for c in range(cols):
+                if grid[r][c] != -1:
+                    continue
+                choices = [i for i in boundary_candidates[(r, c)] if fits(i, r, c)]
+                if not choices:
+                    return
+                if best_choices is None or len(choices) < len(best_choices):
