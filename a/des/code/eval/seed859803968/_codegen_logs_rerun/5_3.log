+            assert all(value is not None for value in row_heights)
+            assert all(value is not None for value in col_widths)
+            solutions.append(
+                (
+                    layout,
+                    tuple(int(value) for value in row_heights),
+                    tuple(int(value) for value in col_widths),
+                )
+            )
