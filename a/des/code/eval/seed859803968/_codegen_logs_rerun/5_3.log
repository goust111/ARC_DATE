+                r1 = min(height, top + h + 1)
+                c0 = max(0, left - 1)
+                c1 = min(width, left + w + 1)
+                if occupied[r0:r1, c0:c1].any():
+                    continue
+                occupied[r0:r1, c0:c1] = True
+                placements[idx] = (top, left)
+                placed = True
+                break
+            if not placed:
+                ok = False
+                break
