    out = set(cells)
    shape = (n, n)
    for r, c in cells:
        for dr, dc in GAP_DIRECTIONS:
            nr, nc = r + dr, c + dc
            if in_bounds(shape, nr, nc):
                out.add((nr, nc))
    return out


