+    return mapping, specs
+
+
+def _place_groups(canvas_h: int, canvas_w: int, specs: list[dict[str, object]]) -> list[dict[str, object]] | None:
+    placed: list[dict[str, object]] = []
+    blocked: set[tuple[int, int]] = set()
+
+    for spec in specs:
