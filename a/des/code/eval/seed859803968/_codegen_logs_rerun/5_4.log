+    if direction == "right":
+        return [(0, 2), (0, 3), (bend, 3)]
+    raise AssertionError(f"unknown direction {direction}")
+
+
+def _guarded(coords: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:
+    guard: set[tuple[int, int]] = set()
+    for r, c in coords:
