 103: def _partition_bands(
 104:     total: int, n: int, min_size: int, max_size: int, min_gap: int = 0
 105: ) -> list[tuple[int, int]] | None:
 106:     """Place n non-overlapping inclusive bands inside [0, total - 1]."""
 107:     if n == 0:
 108:         return []
 109: 
 110:     needed = n * min_size + (n - 1) * min_gap
 111:     if needed > total:
