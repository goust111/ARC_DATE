 204: def _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:
 205:     """5x5 cardinal legend. Canonical direction: (0, +1) right."""
 206:     g = np.full((5, 5), fill, dtype=int)
 207:     g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2
 208:     g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2
 209:     rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}
 210:     return np.rot90(g, rot[(dr, dc)])
