移动规则我采用“以像素边为准的离散接触”：例如向右滑时，棋子的最右列会停在另一棋子的最左列或内侧边框列上。这样既符合“接触边缘即停”，也能自然产生 1 列/1 行的部分重叠，从而出现 `yellow`。现在先用一个临时原型验证这个模型和生成器通过率。
exec
/bin/bash -lc "python - <<'PY'
import random
import numpy as np

BG=0; Y=4; F=5; S=3
SIDES=['top','right','bottom','left']
MOVE={'top':(1,0),'right':(0,-1),'bottom':(-1,0),'left':(0,1)}
COLORS=[1,2,3,6,7,8,9]

def overlap1(a0,a1,b0,b1):
    return not (a1 < b0 or b1 < a0)

def move(positions, color, side, H, W):
    r,c = positions[color]
    if side=='top':
        target = H-2
        for oc,(or0,oc0) in positions.items():
            if oc==color or or0 <= r:
                continue
            if overlap1(c,c+2,oc0,oc0+2):
                target = min(target, or0)
        return max(r, target-2), c
    if side=='bottom':
        target = 1
        for oc,(or0,oc0) in positions.items():
            if oc==color or or0 >= r:
                continue
            if overlap1(c,c+2,oc0,oc0+2):
                target = max(target, or0+2)
        return min(r, target), c
    if side=='left':
        target = W-2
        for oc,(or0,oc0) in positions.items():
            if oc==color or oc0 <= c:
                continue
            if overlap1(r,r+2,or0,or0+2):
                target = min(target, oc0)
        return r, max(c, target-2)
    if side=='right':
        target = 1
        for oc,(or0,oc0) in positions.items():
            if oc==color or oc0 >= c:
                continue
            if overlap1(r,r+2,or0,or0+2):
                target = max(target, oc0+2)
        return r, min(c, target)

def simulate(positions, instr, H, W):
    pos = dict(positions)
    dists=[]
    for color, side in instr:
        nr,nc = move(pos,color,side,H,W)
        r,c = pos[color]
        dists.append(abs(nr-r)+abs(nc-c))
        pos[color]=(nr,nc)
    cover = np.zeros((H,W), int)
    for color,(r,c) in pos.items():
        cover[r:r+3,c:c+3]+=1
    return pos, cover, dists

def separated(a,b,pad=1):
    ar,ac=a; br,bc=b
    return (ar+2+pad < br) or (br+2+pad < ar) or (ac+2+pad < bc) or (bc+2+pad < ac)

def gen_one(rng, want_overlap):
    for _ in range(5000):
        n = rng.choice([4,5])
        H = rng.randint(13 if want_overlap else 15, 18)
        W = rng.randint(13 if want_overlap else 15, 18)
        coords=[(r,c) for r in range(1,H-3) for c in range(1,W-3)]
        rng.shuffle(coords)
        pos=[]
        for rc in coords:
            if all(separated(rc,p) for p in pos):
                pos.append(rc)
                if len(pos)==n:
                    break
        if len(pos)<n:
            continue
        cols = rng.sample(COLORS,n)
        positions=dict(zip(cols,pos))
        sides=SIDES.copy()
        if n==5:
            sides.append(rng.choice(SIDES))
        ok=False
        for _ in range(200):
            rng.shuffle(sides)
            items=list(positions.items())
            rng.shuffle(items)
            instr=[(color,side) for (color,_),side in zip(items,sides)]
            good=True
            # simple wall eligibility
            for color,side in instr:
                r,c=positions[color]
                if side=='top' and r>=H-4: good=False
                if side=='bottom' and r<=1: good=False
                if side=='left' and c>=W-4: good=False
                if side=='right' and c<=1: good=False
            if not good:
                continue
            _, cover, dists = simulate(positions,instr,H,W)
            yc=(cover>=2).sum()
            if min(dists)<=0:
                continue
            if want_overlap and not (0<yc<=6):
                continue
            if (not want_overlap) and yc"'!=0:
                continue
            return True, n, H, W, yc, dists, instr, positions
    return False

rng=random.Random(0)
for want in [False, True]:
    succ=0
    for i in range(100):
        if gen_one(rng, want)[0]: succ+=1
    print('"'want', want, 'succ', succ)
