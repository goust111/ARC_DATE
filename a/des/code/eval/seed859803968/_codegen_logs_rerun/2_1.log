+BG = 0
+FRAME = 5
+PIECE = 9
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRIES = 300
