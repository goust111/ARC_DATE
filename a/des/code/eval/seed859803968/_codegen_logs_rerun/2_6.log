+    if int(comp["area"]) < 2:
+        return False
+    same_row = int(comp["r0"]) == int(comp["r1"])
+    same_col = int(comp["c0"]) == int(comp["c1"])
+    if same_row == same_col:
+        return False
+    expected_len = int(comp["c1"] - comp["c0"] + 1) if same_row else int(comp["r1"] - comp["r0"] + 1)
+    return expected_len == int(comp["area"])
+
