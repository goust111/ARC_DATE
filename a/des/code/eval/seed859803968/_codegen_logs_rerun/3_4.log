+
+    rect_area_sum = sum(int(h * w) for h, w in (item["rect_shape"] for item in items))
+    h = int(rng.integers(GRID_H_RANGE[0], GRID_H_RANGE[1]))
+    w = int(rng.integers(GRID_W_RANGE[0], GRID_W_RANGE[1]))
