+        "square_idx": int(best["square_idx"]),
+        "distance": int(best["distance"]),
+        "tail": (int(tail_r), int(tail_c)),
+        "tail_dir": (int(dr), int(dc)),
+        "plus_center": (int(plus_center[0]), int(plus_center[1])),
