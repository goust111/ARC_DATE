+def _choose_targets(rng: np.random.Generator, candidates: dict[int, list[dict]], color_budget: int) -> list[int] | None:
+    eligible = [sq_idx for sq_idx, opts in candidates.items() if opts]
+    if len(eligible) < 2 or color_budget < 2:
