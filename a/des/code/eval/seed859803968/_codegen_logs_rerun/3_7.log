+    if len(grouped) == 1:
+        best = next(iter(grouped.values()))
+    else:
+        best = min(grouped.values(), key=lambda cand: (cand["distance"], cand["square_idx"]))
+    tail_r, tail_c = best["tail"]
+    dr, dc = best["tail_dir"]
+    plus_center = (tail_r + 2 * dr, tail_c + 2 * dc)
+    return {
