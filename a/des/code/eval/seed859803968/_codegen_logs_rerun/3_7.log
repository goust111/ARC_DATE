+            c0 = int(rng.integers(2, w - 4))
+            square = {"color": colors[idx], "r0": r0, "c0": c0, "r1": r0 + 2, "c1": c0 + 2}
+            reserve = _square_reserve(square, h, w)
+            if reserve & reserve_union:
+                continue
+            squares.append(square)
+            reserve_union |= reserve
+            placed = True
+            break
