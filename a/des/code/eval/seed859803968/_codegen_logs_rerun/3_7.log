+
+    if duplicate_mode:
+        base = int(rng.choice(np.array(duplicateable, dtype=int)))
+        others = [sq_idx for sq_idx in eligible if sq_idx != base]
+        max_lines = min(color_budget, 5, len(others) + 2)
+        if max_lines < 3:
+            return None
+        line_count = int(rng.integers(3, max_lines + 1))
+        extra = line_count - 2
+        chosen = [base, base]
+        if extra:
