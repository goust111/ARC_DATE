+    if any(len(dists) != len(set(dists)) for dists in per_square_distances.values()):
+        return None
+
+    out = main(grid)
+    if out.shape != grid.shape or np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
