+                    "row": int(cells[0][0]),
+                    "start": int(min(c for _, c in cells)),
+                    "end": int(max(c for _, c in cells)),
+                }
+            )
+        else:
+            lines.append(
+                {
+                    "color": int(color),
+                    "cells": cells,
+                    "axis": "v",
+                    "col": int(cells[0][1]),
+                    "start": int(min(r for r, _ in cells)),
+                    "end": int(max(r for r, _ in cells)),
