+
+
+def _square_reserve(square: dict, h: int, w: int) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for rr in range(square["r0"] - 1, square["r1"] + 2):
+        for cc in range(square["c0"] - 1, square["c1"] + 2):
+            if 0 <= rr < h and 0 <= cc < w:
+                cells.add((rr, cc))
