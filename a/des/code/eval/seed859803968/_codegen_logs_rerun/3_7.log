+from __future__ import annotations
+
+from collections import defaultdict
+import numpy as np
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(vals[counts.argmax()])
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components_by_color(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == bg:
+                continue
+            color = int(g[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            coords.sort()
+            rows = [rr for rr, _ in coords]
+            cols = [cc for _, cc in coords]
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                }
+            )
+    return comps
+
+
+def _is_square(comp: dict) -> bool:
+    coords = comp["coords"]
+    r0, c0, r1, c1 = comp["bbox"]
+    if len(coords) != 9 or r1 - r0 != 2 or c1 - c0 != 2:
+        return False
+    coord_set = set(coords)
+    for rr in range(r0, r1 + 1):
+        for cc in range(c0, c1 + 1):
+            if (rr, cc) not in coord_set:
+                return False
+    return True
+
+
+def _is_line(comp: dict) -> bool:
+    coords = comp["coords"]
+    r0, c0, r1, c1 = comp["bbox"]
+    if not (3 <= len(coords) <= 8):
+        return False
+    coord_set = set(coords)
+    if r0 == r1:
+        return all((r0, cc) in coord_set for cc in range(c0, c1 + 1))
+    if c0 == c1:
+        return all((rr, c0) in coord_set for rr in range(r0, r1 + 1))
+    return False
+
+
+def _extract_scene(grid: np.ndarray) -> tuple[int, list[dict], list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    bg = _bg_color(g)
+    squares: list[dict] = []
+    lines: list[dict] = []
+    for comp in _components_by_color(g, bg):
+        if _is_square(comp):
+            r0, c0, r1, c1 = comp["bbox"]
+            squares.append(
+                {
+                    "color": int(comp["color"]),
+                    "r0": int(r0),
+                    "c0": int(c0),
+                    "r1": int(r1),
+                    "c1": int(c1),
+                }
+            )
+        elif _is_line(comp):
+            r0, c0, r1, c1 = comp["bbox"]
+            if r0 == r1:
+                lines.append(
+                    {
+                        "color": int(comp["color"]),
+                        "axis": "h",
+                        "row": int(r0),
+                        "start": int(c0),
+                        "end": int(c1),
+                        "cells": [(int(r0), cc) for cc in range(c0, c1 + 1)],
+                    }
+                )
+            else:
+                lines.append(
+                    {
+                        "color": int(comp["color"]),
+                        "axis": "v",
+                        "col": int(c0),
+                        "start": int(r0),
+                        "end": int(r1),
+                        "cells": [(rr, int(c0)) for rr in range(r0, r1 + 1)],
+                    }
+                )
+    return bg, squares, lines
