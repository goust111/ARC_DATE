+
+def _sample_pair_spec(color_a: int, color_b: int) -> dict:
+    axis = random.choice(("h", "v"))
+    if axis == "h":
+        rect_h = random.randint(*H_RECT_H_RANGE)
+        rect_w = random.randint(*H_RECT_W_RANGE)
+    else:
