    return grid


def _expected_output(grid, coords, direction):
    expected = grid.copy()
    ordered = sorted(coords) if direction == "row" else sorted(coords, key=lambda rc: (rc[1], rc[0]))
    for i, (r, c) in enumerate(ordered):
