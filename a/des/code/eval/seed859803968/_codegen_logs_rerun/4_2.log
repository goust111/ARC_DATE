    try:
        if np.array_equal(main(grid), _expected_output(grid, coords, direction)):
            return grid
    except AssertionError:
        pass
    return None


def generate_input():
    for _ in range(MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 9473c6fb input")

