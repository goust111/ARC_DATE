+BG = 5
+FG_COLORS = tuple(c for c in range(10) if c != BG)
+GRID_H_RANGE = (12, 22)
+GRID_W_RANGE = (12, 22)
+PAIR_COUNT_CHOICES = (1, 2, 3)
+PAIR_COUNT_WEIGHTS = (3, 5, 2)
+H_RECT_H_RANGE = (2, 5)
+H_RECT_W_RANGE = (4, 8)
+V_RECT_H_RANGE = (4, 8)
+V_RECT_W_RANGE = (2, 5)
+SHIFT_RANGE = (2, 4)
