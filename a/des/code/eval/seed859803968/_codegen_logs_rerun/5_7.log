+PATTERN_COLORS = (0, 1, 6, 7)
+OUTER_SIZE_CHOICES = ((5, 5), (5, 7), (7, 5), (7, 7))
+GRID_MIN = 24
+GRID_MAX = 30
+LEGEND_INNER_H = 11
+LEGEND_INNER_W_RANGE = (7, 9)
+CONTAINER_COUNT_RANGE = (3, 5)
