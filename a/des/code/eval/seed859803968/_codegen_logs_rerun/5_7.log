+        return False
+    if r1 - r0 + 1 < 8 or c1 - c0 + 1 < 6:
+        return False
+    expected = {(r0, c) for c in range(c0, c1 + 1)}
+    expected |= {(r, c0) for r in range(r0, r1 + 1)}
+    return expected == {tuple(map(int, p)) for p in comp["coords"]}
