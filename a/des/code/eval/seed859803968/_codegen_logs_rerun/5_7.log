+import random
+from collections import deque
+
+import numpy as np
+
+
+BACKGROUND = 8  # azure
+CONTAINER_BORDER = 5  # grey
+LEGEND_BORDER = 9  # maroon
+TYPE_TO_MARKER = {"lr": 4, "ud": 3, "none": 2}  # yellow, green, red
+PATTERN_COLORS = (0, 1, 6, 7)
+OUTER_SIZE_CHOICES = ((5, 5), (5, 7), (7, 5), (7, 7))
+GRID_MIN = 24
