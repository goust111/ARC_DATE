+LEGEND_PATTERN_TO_KIND = {tuple(sorted(v)): k for k, v in LEGEND_PATTERNS.items()}
+
+GRID_SIDE_RANGE = (22, 30)
+OBJECT_COUNT_RANGE = (3, 6)
+BASE_SIZE_RANGE = (3, 7)
+BASE_AREA_RANGE = (6, 20)
+MASK_ATTEMPTS = 80
+PERTURB_ATTEMPTS = 240
+PLACEMENT_ATTEMPTS = 120
