+
+def _legend_entry_patch(color: int, kind: str) -> np.ndarray:
+    patch = np.zeros((LEGEND_ENTRY_H, LEGEND_ENTRY_W), dtype=int)
+    patch[:, :2] = color
+    for r, c in LEGEND_PATTERNS[kind]:
+        patch[r, c] = LEGEND_MARKER
