+            if any(0 <= nr < h and 0 <= nc < w and mask[nr, nc] for nr, nc in _neighbors4(r, c)):
+                cells.append((r, c))
+    return cells
+
+
+def _removable_cells(mask: np.ndarray) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
