+    patch = np.zeros((height, LEGEND_ENTRY_W), dtype=int)
+    for idx, kind in enumerate(order):
+        r0 = idx * (LEGEND_ENTRY_H + LEGEND_GAP)
+        patch[r0 : r0 + LEGEND_ENTRY_H, :] = _legend_entry_patch(mapping[kind], kind)
