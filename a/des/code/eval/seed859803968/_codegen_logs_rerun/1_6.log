+def _reserve(mask: np.ndarray, top: int, left: int, h: int, w: int) -> None:
+    r0 = max(0, top - 1)
+    c0 = max(0, left - 1)
+    r1 = min(mask.shape[0], top + h + 1)
+    c1 = min(mask.shape[1], left + w + 1)
