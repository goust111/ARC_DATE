+    grid_w = rng.randint(max(GRID_SIDE_RANGE[0], legend.shape[1] + 8), GRID_SIDE_RANGE[1] + 2)
+    grid = np.zeros((grid_h, grid_w), dtype=int)
+    reserved = np.zeros_like(grid, dtype=bool)
