+        if mask[:, 0].sum() == 0 and mask[:, -1].sum() == 0:
+            continue
+        return mask
+    return None
+
+
+def _adjacent_empty_cells(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    cells: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c]:
