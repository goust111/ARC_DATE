+    if dist_h < dist_v:
+        return KIND_H, best[KIND_H][2], dist_h
+    if dist_v < dist_h:
+        return KIND_V, best[KIND_V][2], dist_v
+
+    best_hv = best[KIND_HV]
+    assert best_hv is not None and best_hv[0] == dist_h
