+def _solve_local_object(observed: np.ndarray) -> tuple[str, np.ndarray, int]:
+    assert observed.ndim == 2 and observed.dtype == bool
+    assert observed.any()
+    best = _repair_candidates(observed)
+    best_h = best[KIND_H]
+    best_v = best[KIND_V]
+    assert best_h is not None and best_v is not None
+
+    if best_h[0] < best_v[0]:
+        return KIND_H, best_h[2], best_h[0]
+    if best_v[0] < best_h[0]:
+        return KIND_V, best_v[2], best_v[0]
+
+    best_hv = best[KIND_HV]
+    assert best_hv is not None and best_hv[0] == best_h[0]
+    return KIND_HV, best_hv[2], best_hv[0]
