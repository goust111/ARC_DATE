+
+def _has_vertical_symmetry(mask: np.ndarray) -> bool:
+    _h, w = mask.shape
+    for axis2 in range(2 * w - 1):
+        ok = True
+        for c in range(w):
+            cc = axis2 - c
+            if 0 <= cc < w:
+                if not np.array_equal(mask[:, c], mask[:, cc]):
+                    ok = False
