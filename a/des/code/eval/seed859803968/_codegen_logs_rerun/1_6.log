+KIND_H = "H"
+KIND_V = "V"
+KIND_HV = "HV"
+KINDS = (KIND_H, KIND_V, KIND_HV)
+
+LEGEND_ENTRY_H = 3
+LEGEND_ENTRY_W = 5
+LEGEND_GAP = 1
+LEGEND_PATTERNS = {
+    KIND_H: ((1, 2), (1, 3), (1, 4)),
+    KIND_V: ((0, 2), (1, 2), (2, 2)),
+    KIND_HV: ((0, 3), (1, 2), (1, 3), (1, 4), (2, 3)),
+}
+LEGEND_PATTERN_TO_KIND = {tuple(sorted(v)): k for k, v in LEGEND_PATTERNS.items()}
+
+GRID_SIDE_RANGE = (20, 26)
+OBJECT_COUNT_RANGE = (3, 4)
+BASE_SIZE_RANGE = (3, 5)
+BASE_AREA_RANGE = (5, 12)
