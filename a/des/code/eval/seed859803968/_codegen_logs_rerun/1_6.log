+
+
+def _build_object(kind: str, rng: random.Random) -> tuple[np.ndarray, np.ndarray] | None:
+    for _ in range(MASK_ATTEMPTS):
+        base = _generate_base_mask(kind, rng)
+        if base is None:
+            continue
+        perturbed = _perturb_base(base, kind, rng)
+        if perturbed is not None:
+            return perturbed
