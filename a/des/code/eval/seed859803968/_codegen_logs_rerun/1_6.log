+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+CYAN = 8
+BROWN = 9
+
+BG = BLACK
+OBJECT_COLOR = GREY
+REPAIR_COLOR = YELLOW
+LEGEND_MARKER = CYAN
+LEGEND_COLOR_POOL = (BLUE, RED, GREEN, MAGENTA, ORANGE, BROWN)
+
+KIND_H = "H"
+KIND_V = "V"
+KIND_HV = "HV"
+KINDS = (KIND_H, KIND_V, KIND_HV)
