+        valid = True
+
+        for op in pattern:
+            if op == "remove":
+                choices = [cell for cell in _removable_cells(observed) if cell not in used]
+            else:
+                choices = [cell for cell in _adjacent_empty_cells(observed) if cell not in used]
+            if not choices:
+                valid = False
+                break
+            r, c = rng.choice(choices)
+            observed[r, c] = not observed[r, c]
