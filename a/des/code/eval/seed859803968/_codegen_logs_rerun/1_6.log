+    r1, c1 = coords.max(axis=0) + 1
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _has_horizontal_symmetry(mask: np.ndarray) -> bool:
+    h, _w = mask.shape
+    for axis2 in range(2 * h - 1):
