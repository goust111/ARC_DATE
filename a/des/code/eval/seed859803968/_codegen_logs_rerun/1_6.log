+LEGEND_ENTRY_H = 3
+LEGEND_ENTRY_W = 5
+LEGEND_GAP = 1
+LEGEND_PATTERNS = {
+    KIND_H: ((1, 2), (1, 3), (1, 4)),
+    KIND_V: ((0, 2), (1, 2), (2, 2)),
+    KIND_HV: ((0, 3), (1, 2), (1, 3), (1, 4), (2, 3)),
