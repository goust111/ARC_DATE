+    def consider(candidate: np.ndarray, dist: int) -> None:
+        if candidate.sum() == 0 or not _is_connected(candidate):
+            return
+        h_sym = _has_horizontal_symmetry(candidate)
+        v_sym = _has_vertical_symmetry(candidate)
+        if not (h_sym or v_sym):
