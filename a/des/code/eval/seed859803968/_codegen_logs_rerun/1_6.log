+from __future__ import annotations
+
+import random
+from collections import deque
+from itertools import combinations
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+CYAN = 8
+BROWN = 9
+
+BG = BLACK
+OBJECT_COLOR = GREY
+REPAIR_COLOR = YELLOW
+LEGEND_MARKER = CYAN
+LEGEND_COLOR_POOL = (BLUE, RED, GREEN, MAGENTA, ORANGE, BROWN)
+
+KIND_H = "H"
+KIND_V = "V"
+KIND_HV = "HV"
+KINDS = (KIND_H, KIND_V, KIND_HV)
+
+LEGEND_ENTRY_H = 3
+LEGEND_ENTRY_W = 5
+LEGEND_GAP = 1
+LEGEND_PATTERNS = {
+    KIND_H: ((1, 2), (1, 3), (1, 4)),
+    KIND_V: ((0, 2), (1, 2), (2, 2)),
+    KIND_HV: ((0, 3), (1, 2), (1, 3), (1, 4), (2, 3)),
+}
+LEGEND_PATTERN_TO_KIND = {tuple(sorted(v)): k for k, v in LEGEND_PATTERNS.items()}
+
+GRID_SIDE_RANGE = (22, 30)
+OBJECT_COUNT_RANGE = (3, 6)
+BASE_SIZE_RANGE = (3, 7)
+BASE_AREA_RANGE = (6, 20)
+MASK_ATTEMPTS = 80
+PERTURB_ATTEMPTS = 240
+PLACEMENT_ATTEMPTS = 120
+GEN_RETRIES = 300
