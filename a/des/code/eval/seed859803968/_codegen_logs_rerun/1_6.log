+def _repair_candidates(observed: np.ndarray) -> dict[str, tuple[int, bytes, np.ndarray] | None]:
+    h, w = observed.shape
+    all_positions = list(range(h * w))
+    best: dict[str, tuple[int, bytes, np.ndarray] | None] = {k: None for k in KINDS}
