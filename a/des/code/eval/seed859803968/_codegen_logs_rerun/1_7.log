+                w = random.randint(4, 8)
+            area = int(h * w)
+            if area in used_areas:
+                continue
+
+            if kind == "V":
+                piece_a, piece_b, rect, bits = _split_vertical(h, w, color_a, color_b)
+                signature = ("V", h, _canonical_profile(bits))
+            else:
