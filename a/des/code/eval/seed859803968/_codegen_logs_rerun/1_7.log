+    cut_hi = h - 3
+    assert cut_lo <= cut_hi
+    cut = random.randint(cut_lo, cut_hi)
+    boundary = cut + indicator if top_tabs else cut - indicator
+    assert int(boundary.min()) >= 2 and int(boundary.max()) <= h - 2
