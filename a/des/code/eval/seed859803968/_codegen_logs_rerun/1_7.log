+def _piece_info(patch: np.ndarray, coords: np.ndarray) -> dict:
+    colors = [int(v) for v in np.unique(patch) if int(v) != BLACK]
+    assert len(colors) == 1, "each piece must be monochrome"
+    color = int(colors[0])
+    mask = patch == color
+    h, w = mask.shape
