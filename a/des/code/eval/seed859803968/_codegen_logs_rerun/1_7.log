+        ph, pw = patch.shape
+        assert row + ph <= h, "stacked output exceeds canvas height"
+        assert start_c + pw <= w, "stacked output exceeds canvas width"
+        out[row : row + ph, start_c : start_c + pw] = patch
+        row += int(ph + 1)
+    return out
