+
+BLACK = 0
+GREY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+MAX_GRID = 30
+GEN_ATTEMPTS = 400
+
+OPPOSITE = {"N": "S", "S": "N", "E": "W", "W": "E"}
