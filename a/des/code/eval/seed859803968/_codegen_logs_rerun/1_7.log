+def _find_separator(grid: np.ndarray) -> int:
+    cols = [c for c in range(grid.shape[1]) if bool(np.all(grid[:, c] == GREY))]
+    assert len(cols) == 1, "expected exactly one grey separator column"
+    return int(cols[0])
