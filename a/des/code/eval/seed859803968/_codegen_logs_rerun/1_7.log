+    row_good = True
+    row_mins: list[int] = []
+    row_maxs: list[int] = []
+    for r in range(h):
+        cols = np.flatnonzero(mask[r])
+        if cols.size == 0 or int(cols[-1] - cols[0] + 1) != int(cols.size):
+            row_good = False
+            break
