+
+def _profiles_complement(a: tuple[int, ...], b: tuple[int, ...]) -> bool:
+    if len(a) != len(b) or not a:
+        return False
+    sums = [int(x) + int(y) for x, y in zip(a, b)]
+    return len(set(sums)) == 1 and sums[0] > 0
