+        choices = [
+            spec_idx
+            for spec_idx in by_piece[int(pivot)]
+            if all(member in remaining for member in specs[spec_idx]["members"])
+        ]
+        if not choices:
+            return None
+        for spec_idx in choices:
+            i, j = specs[spec_idx]["members"]
+            tail = search(remaining - {int(i), int(j)})
+            if tail is not None:
