+    search_order = sorted(colors, key=lambda color: (len(candidates[color]), -len(visible[color])))
+    chosen_idx: dict[int, int] = {}
+    chosen_nodes: list[int] = []
+
+    def dfs(pos: int, edges: set[tuple[int, int]]) -> tuple[dict[int, Rect], list[int]] | None:
