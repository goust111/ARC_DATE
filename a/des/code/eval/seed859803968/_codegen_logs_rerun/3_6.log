+
+def _visible_edges_ok(inp: np.ndarray, rectangles: dict[int, Rect], order: list[int], corner: str) -> bool:
+    visible_sides = {
+        "tl": ("top", "left"),
+        "tr": ("top", "right"),
+        "bl": ("bottom", "left"),
+        "br": ("bottom", "right"),
+    }[corner]
+
+    for color in order[:-1]:
+        r0, c0, r1, c1 = rectangles[color]
