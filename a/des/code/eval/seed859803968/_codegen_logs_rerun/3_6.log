+        return (0, c0, height - 1, c1)
+    if side == "bottom":
+        return (h - height, c0, h - 1, c1)
+    if side == "left":
+        return (r0, 0, r1, width - 1)
+    if side == "right":
+        return (r0, w - width, r1, w - 1)
