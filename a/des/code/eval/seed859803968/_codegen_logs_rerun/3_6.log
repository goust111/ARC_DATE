+        return []
+
+    h, w = core.shape
+    vr0 = int(coords[:, 0].min())
+    vr1 = int(coords[:, 0].max())
+    vc0 = int(coords[:, 1].min())
+    vc1 = int(coords[:, 1].max())
+    candidates: set[Rect] = set()
