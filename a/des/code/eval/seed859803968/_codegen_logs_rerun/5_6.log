   255	def _inflate(cells: set[tuple[int, int]], radius: int = 1) -> set[tuple[int, int]]:
   256	    inflated: set[tuple[int, int]] = set()
   257	    for r, c in cells:
   258	        for dr in range(-radius, radius + 1):
   259	            for dc in range(-radius, radius + 1):
   260	                inflated.add((r + dr, c + dc))
   260	                inflated.add((r + dr, c + dc))
   261	    return inflated
   262	
   263	
   264	def _sample_shape(color: int) -> dict[str, object] | None:
   265	    turns = random.choice(TURN_COUNT_CHOICES)
   266	    directions = [random.choice(DIRS)]
   267	    for _ in range(turns):
   268	        directions.append(random.choice(_perpendiculars(directions[-1])))
   269	    lengths = [random.randint(SEGMENT_LEN_MIN, SEGMENT_LEN_MAX) for _ in directions]
   270	
   271	    route = [(0, 0)]
   272	    vertices = [(0, 0)]
   273	    pos = (0, 0)
   274	    for direction, length in zip(directions, lengths):
   275	        for _ in range(length):
   276	            pos = _add(pos, direction)
   277	            route.append(pos)
   278	        vertices.append(pos)
   279	
   280	    if len(route) != len(set(route)):
   281	        return None
   282	
   283	    start_stub_len = random.randint(STUB_LEN_MIN, STUB_LEN_MAX)
   284	    end_stub_len = random.randint(STUB_LEN_MIN, STUB_LEN_MAX)
   285	    start_stub = [_add(route[0], directions[0], -i) for i in range(start_stub_len)]
   286	    end_stub = [_add(route[-1], directions[-1], i) for i in range(end_stub_len)]
   287	
   288	    route_set = set(route)
   289	    if (set(start_stub[1:]) & route_set) or (set(end_stub[1:]) & route_set):
   290	        return None
   291	    if set(start_stub[1:]) & set(end_stub[1:]):
   292	        return None
   293	
   294	    turn_station_cells: set[tuple[int, int]] = set()
   295	    for i in range(1, len(vertices) - 1):
   296	        vertex = vertices[i]
   297	        turn_station_cells.add(_add(vertex, directions[i - 1], -1))
   298	        turn_station_cells.add(vertex)
   299	        turn_station_cells.add(_add(vertex, directions[i]))
   300	
   301	    candidates: list[tuple[int, int]] = []
   302	    global_start = 0
   303	    for i, length in enumerate(lengths):
   304	        has_prev = i > 0
   305	        has_next = i < len(lengths) - 1
   306	        min_local = 3 if has_prev else 2
   307	        max_local = length - 4 if has_next else length - 3
   308	        for local in range(min_local, max_local + 1):
   309	            candidates.append((global_start + local, global_start + local + 1))
   310	        global_start += length
   311	
   312	    if not candidates:
   313	        return None
   314	
   315	    random.shuffle(candidates)
   316	    straight_station: tuple[tuple[int, int], tuple[int, int]] | None = None
   317	    for a_idx, b_idx in candidates:
   318	        cell_a = route[a_idx]
   319	        cell_b = route[b_idx]
   320	        if cell_a in turn_station_cells or cell_b in turn_station_cells:
   321	            continue
   322	        station_cells = {cell_a, cell_b}
   323	        if station_cells & set(start_stub[1:]):
   324	            continue
   325	        if station_cells & set(end_stub[1:]):
   326	            continue
   327	        straight_station = (cell_a, cell_b)
   328	        break
   329	    if straight_station is None:
   330	        return None
   331	
   332	    straight_cells = set(straight_station)
   333	    station_cells = turn_station_cells | straight_cells
   334	    if len(station_cells) != len(turn_station_cells) + 2:
   335	        return None
   336	
   337	    visible_cells = station_cells | set(start_stub) | set(end_stub)
   338	    if len(visible_cells) != len(station_cells) + len(set(start_stub)) + len(set(end_stub)):
   339	        return None
   340	
   341	    occupied = route_set | set(start_stub[1:]) | set(end_stub[1:])
   342	    allowed_edges: set[frozenset[tuple[int, int]]] = set()
   343	    for seq in (route, start_stub, end_stub):
   344	        for a, b in zip(seq, seq[1:]):
   345	            allowed_edges.add(frozenset((a, b)))
   346	    for cell in occupied:
   347	        for direction in DIRS:
   348	            nei = _add(cell, direction)
   349	            if nei in occupied and frozenset((cell, nei)) not in allowed_edges:
   350	                return None
   351	
   352	    reserve = _inflate(route_set | set(start_stub) | set(end_stub), radius=1)
   353	
   354	    return {
   355	        "color": color,
   356	        "route": route,
   357	        "paint_cells": [cell for cell in route if cell not in station_cells and cell not in {route[0], route[-1]}],
   358	        "turn_station_cells": turn_station_cells,
   359	        "straight_station": straight_station,
   360	        "start_stub": start_stub,
   361	        "end_stub": end_stub,
   362	        "reserve": reserve,
   363	    }
   364	
   365	
   366	def _feasible_offsets(shape: dict[str, object], blocked: np.ndarray) -> list[tuple[int, int]]:
   367	    reserve = list(shape["reserve"])
   368	    min_r = min(r for r, _c in reserve)
   369	    max_r = max(r for r, _c in reserve)
   370	    min_c = min(c for _r, c in reserve)
   371	    max_c = max(c for _r, c in reserve)
   372	
   373	    offsets: list[tuple[int, int]] = []
   374	    for off_r in range(-min_r, blocked.shape[0] - max_r):
   375	        for off_c in range(-min_c, blocked.shape[1] - max_c):
   376	            ok = True
   377	            for r, c in reserve:
   378	                if blocked[r + off_r, c + off_c]:
   379	                    ok = False
   380	                    break
   381	            if ok:
   382	                offsets.append((off_r, off_c))
   383	    return offsets
   384	
   385	
   386	def _translate_cells(cells: list[tuple[int, int]] | set[tuple[int, int]], offset: tuple[int, int]) -> list[tuple[int, int]]:
   387	    off_r, off_c = offset
   388	    return [(r + off_r, c + off_c) for r, c in cells]
   389	
   390	
   391	def _build_scene() -> tuple[np.ndarray, np.ndarray] | None:
   392	    h = random.randint(GRID_MIN, GRID_MAX)
   393	    w = random.randint(GRID_MIN, GRID_MAX)
   394	    pair_count = random.randint(PAIR_COUNT_MIN, PAIR_COUNT_MAX)
   395	    colors = random.sample(COLOR_POOL, pair_count)
   396	
   397	    shapes: list[dict[str, object]] = []
   398	    for color in colors:
   399	        for _ in range(MAX_SHAPE_ATTEMPTS):
   400	            shape = _sample_shape(color)
   401	            if shape is not None:
   402	                shapes.append(shape)
   403	                break
   404	        else:
   405	            return None
   406	
   407	    shapes.sort(key=lambda item: len(item["reserve"]), reverse=True)
   408	    blocked = np.zeros((h, w), dtype=bool)
   409	    placed: list[dict[str, object]] = []
   410	
   411	    for shape in shapes:
   412	        offsets = _feasible_offsets(shape, blocked)
   413	        if not offsets:
   414	            return None
   415	        offset = random.choice(offsets)
   416	
   417	        reserve_cells = _translate_cells(shape["reserve"], offset)
   418	        for r, c in reserve_cells:
   419	            blocked[r, c] = True
   420	
   421	        placed.append(
   422	            {
   423	                "color": shape["color"],
   424	                "paint_cells": _translate_cells(shape["paint_cells"], offset),
   425	                "turn_station_cells": _translate_cells(shape["turn_station_cells"], offset),
   426	                "straight_station": _translate_cells(list(shape["straight_station"]), offset),
   427	                "start_stub": _translate_cells(shape["start_stub"], offset),
   428	                "end_stub": _translate_cells(shape["end_stub"], offset),
   429	            }
   430	        )
   431	
   432	    inp = np.full((h, w), BLACK, dtype=int)
   433	    for item in placed:
   434	        color = int(item["color"])
   435	
   436	        for r, c in item["start_stub"]:
   437	            inp[r, c] = GREY
   438	        for r, c in item["end_stub"]:
   439	            inp[r, c] = GREY
   440	
   441	        start_color = item["start_stub"][-1]
   442	        end_color = item["end_stub"][-1]
   443	        inp[start_color] = color
   444	        inp[end_color] = color
   445	
   446	        for r, c in item["turn_station_cells"]:
   447	            assert inp[r, c] == BLACK
   448	            inp[r, c] = MAROON
   449	        for r, c in item["straight_station"]:
   450	            assert inp[r, c] == BLACK
   451	            inp[r, c] = MAROON
   452	
   453	    out = inp.copy()
   454	    for item in placed:
   455	        color = int(item["color"])
   456	        for r, c in item["paint_cells"]:
   457	            assert out[r, c] == BLACK
   458	            out[r, c] = color
   459	
   460	    if not np.array_equal(main(inp), out):
   461	        return None
   462	    return inp, out
   463	
   464	
   465	def generate_input() -> np.ndarray:
   466	    for _ in range(MAX_LAYOUT_ATTEMPTS):
   467	        scene = _build_scene()
   468	        if scene is not None:
   469	            return scene[0]
   470	    raise RuntimeError("failed to generate a valid input")

