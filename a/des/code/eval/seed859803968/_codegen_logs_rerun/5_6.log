+        for r, c in item["paint_cells"]:
+            assert out[r, c] == BLACK
+            out[r, c] = color
+
+    if not np.array_equal(main(inp), out):
+        return None
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
