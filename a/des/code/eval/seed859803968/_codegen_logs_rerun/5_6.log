+    offsets: list[tuple[int, int]] = []
+    for off_r in range(-min_r, blocked.shape[0] - max_r):
+        for off_c in range(-min_c, blocked.shape[1] - max_c):
+            ok = True
+            for r, c in reserve:
+                if blocked[r + off_r, c + off_c]:
