+def _pass_station(
+    entry: tuple[int, int],
+    direction: tuple[int, int],
+    station: dict[str, object],
+) -> tuple[tuple[int, int], tuple[int, int]]:
+    if station["kind"] == "straight":
+        axis = station["axis"]
+        assert (axis == "h" and direction[0] == 0) or (axis == "v" and direction[1] == 0)
