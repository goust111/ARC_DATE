+    lengths = [random.randint(SEGMENT_LEN_MIN, SEGMENT_LEN_MAX) for _ in directions]
+
+    route = [(0, 0)]
+    vertices = [(0, 0)]
+    pos = (0, 0)
+    for direction, length in zip(directions, lengths):
