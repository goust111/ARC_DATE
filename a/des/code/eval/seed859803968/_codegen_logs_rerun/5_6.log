+    end_stub = [_add(route[-1], directions[-1], i) for i in range(end_stub_len)]
+
+    route_set = set(route)
+    if (set(start_stub[1:]) & route_set) or (set(end_stub[1:]) & route_set):
+        return None
+    if set(start_stub[1:]) & set(end_stub[1:]):
