+    w = random.randint(GRID_MIN, GRID_MAX)
+    pair_count = random.randint(PAIR_COUNT_MIN, PAIR_COUNT_MAX)
+    colors = random.sample(COLOR_POOL, pair_count)
+
+    shapes: list[dict[str, object]] = []
+    for color in colors:
