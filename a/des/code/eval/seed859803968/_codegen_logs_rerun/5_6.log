+    out = g.copy()
+    for color in sorted(by_color):
+        pair = by_color[color]
+        assert len(pair) == 2, "each endpoint color must appear exactly twice"
+        paint = _trace_pair(g, stations, station_by_cell, pair[0], pair[1])
+        for r, c in paint:
+            assert int(out[r, c]) == BLACK
+            out[r, c] = color
+
+    return out
+
