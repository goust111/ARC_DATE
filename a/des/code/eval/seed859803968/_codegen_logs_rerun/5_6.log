+def _parse_segments(grid: np.ndarray) -> list[dict[str, object]]:
+    colored = np.argwhere((grid != BLACK) & (grid != GREY) & (grid != MAROON))
+    segments: list[dict[str, object]] = []
+
+    for rr, cc in colored:
+        r = int(rr)
+        c = int(cc)
+        color = int(grid[r, c])
+        grey_dirs = []
+        for direction in DIRS:
