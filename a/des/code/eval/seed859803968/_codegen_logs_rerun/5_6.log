+        cells = sorted(comp)
+        cellset = set(cells)
+
+        if len(cells) == 2:
+            same_row = cells[0][0] == cells[1][0] and abs(cells[0][1] - cells[1][1]) == 1
+            same_col = cells[0][1] == cells[1][1] and abs(cells[0][0] - cells[1][0]) == 1
