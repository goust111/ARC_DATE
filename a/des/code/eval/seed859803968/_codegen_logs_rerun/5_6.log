+
+        placed.append(
+            {
+                "color": shape["color"],
+                "paint_cells": _translate_cells(shape["paint_cells"], offset),
+                "turn_station_cells": _translate_cells(shape["turn_station_cells"], offset),
+                "straight_station": _translate_cells(list(shape["straight_station"]), offset),
