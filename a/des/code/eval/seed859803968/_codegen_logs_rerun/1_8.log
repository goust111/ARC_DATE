+        return None
+    if set(row_outputs + col_outputs) != set(SIGNAL_COLORS):
+        return None
+
+    grid = _build_input(gate_rows, gate_cols, row_inputs, col_inputs, gate_types)
+    out = main(grid)
+
+    if np.array_equal(out, grid):
