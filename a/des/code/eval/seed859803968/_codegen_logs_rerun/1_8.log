+        if gate_types[i][j] == ORANGE:
+            seen_swap = True
+        else:
+            seen_keep = True
+    return seen_swap and seen_keep
+
+
+def _gen_attempt() -> np.ndarray | None:
+    row_count = random.randint(2, 4)
+    col_count = random.randint(2, 4)
+
+    gate_rows = _choose_positions(row_count, (3, 5), (4, 6))
