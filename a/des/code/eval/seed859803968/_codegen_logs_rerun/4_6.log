+    driver_idx = next(iter(driver_candidates))
+
+    gears: list[dict] = []
+    for idx, comp in enumerate(comps):
+        cells = set(comp["cells"])
+        if idx == driver_idx:
+            cells.add((red_r, red_c))
+        rows = [r for r, _ in cells]
+        cols = [c for _, c in cells]
+        gear = {
+            "color": int(comp["color"]),
+            "cells": cells,
