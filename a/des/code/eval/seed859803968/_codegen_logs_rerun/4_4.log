+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+BG = 8
+BORDER = 3
+PEEL_COLORS = (4, 2, 9)  # yellow, red, maroon
+ISLAND_COLORS = (1, 5, 6, 7)
+
+GEN_RETRIES = 400
+LOCAL_RETRIES = 200
