+def _label_components(mask: np.ndarray) -> tuple[np.ndarray, list[list[tuple[int, int]]]]:
+    m = np.asarray(mask, dtype=bool)
+    h, w = m.shape
+    labels = np.zeros((h, w), dtype=int)
+    comps: list[list[tuple[int, int]]] = []
+    next_id = 0
+
+    for r in range(h):
+        for c in range(w):
+            if not m[r, c] or labels[r, c] != 0:
+                continue
+            next_id += 1
+            labels[r, c] = next_id
+            q = deque([(int(r), int(c))])
+            cells: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if not m[nr, nc] or labels[nr, nc] != 0:
+                        continue
+                    labels[nr, nc] = next_id
+                    q.append((nr, nc))
+            comps.append(cells)
+    return labels, comps
+
+
+def _touches_edge(cells: list[tuple[int, int]], h: int, w: int) -> bool:
+    return any(r == 0 or r == h - 1 or c == 0 or c == w - 1 for r, c in cells)
+
+
+def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _region_info(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+
+    bg_labels, bg_comps = _label_components(g == BG)
+    region_ids = [
+        comp_id
+        for comp_id, cells in enumerate(bg_comps, start=1)
+        if not _touches_edge(cells, h, w)
+    ]
+    region_id_set = set(region_ids)
+
+    island_counts = {comp_id: 0 for comp_id in region_ids}
+    island_mask = (g != BG) & (g != BORDER)
+    _, island_comps = _label_components(island_mask)
+    for island_cells in island_comps:
+        adjacent_regions = set()
+        for r, c in island_cells:
+            for dr, dc in DIR4:
+                nr = r + dr
+                nc = c + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    adj_id = int(bg_labels[nr, nc])
+                    if adj_id in region_id_set:
+                        adjacent_regions.add(adj_id)
+        if len(adjacent_regions) == 1:
+            region_id = next(iter(adjacent_regions))
+            island_counts[region_id] += 1
+
+    info: list[dict] = []
+    for region_id in region_ids:
+        cells = bg_comps[region_id - 1]
+        cell_set = set(cells)
+        layer0 = [
+            (r, c)
+            for r, c in cells
+            if any(
+                0 <= r + dr < h
+                and 0 <= c + dc < w
+                and int(g[r + dr, c + dc]) == BORDER
+                for dr, dc in DIR4
+            )
+        ]
+        assert layer0, "every enclosed region must have background adjacent to the green border"
+
+        dist: dict[tuple[int, int], int] = {}
+        q = deque()
+        for cell in layer0:
+            dist[cell] = 0
+            q.append(cell)
+
+        while q:
+            r, c = q.popleft()
+            next_dist = dist[(r, c)] + 1
+            for dr, dc in DIR4:
+                nr = r + dr
+                nc = c + dc
+                nxt = (nr, nc)
+                if nxt not in cell_set or nxt in dist:
+                    continue
+                dist[nxt] = next_dist
+                q.append(nxt)
