+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Count islands inside each green-bounded region, then peel that many background
+    layers inward with the fixed yellow/red/maroon sequence.
+    """
+    g = np.asarray(grid, dtype=int)
