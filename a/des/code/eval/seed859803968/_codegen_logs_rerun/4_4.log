+
+        dist: dict[tuple[int, int], int] = {}
+        q = deque()
+        for cell in layer0:
+            dist[cell] = 0
+            q.append(cell)
+
+        while q:
+            r, c = q.popleft()
+            next_dist = dist[(r, c)] + 1
+            for dr, dc in DIR4:
+                nr = r + dr
+                nc = c + dc
+                nxt = (nr, nc)
+                if nxt not in cell_set or nxt in dist:
+                    continue
+                dist[nxt] = next_dist
+                q.append(nxt)
+
+        layers = [[] for _ in range(len(PEEL_COLORS))]
+        for cell, depth in dist.items():
+            if depth < len(PEEL_COLORS):
+                layers[depth].append(cell)
+
+        info.append(
+            {
+                "bbox": _bbox(cells),
+                "cells": cells,
+                "islands": island_counts[region_id],
+                "layers": layers,
