+            max_c = inner_w - shape_w - 1
+            if max_r < 1 or max_c < 1:
+                continue
+            base_r = rng.randint(1, max_r)
+            base_c = rng.randint(1, max_c)
+            cells = [(base_r + r, base_c + c) for r, c in shape]
+            if any(occupied[r, c] for r, c in cells):
+                continue
