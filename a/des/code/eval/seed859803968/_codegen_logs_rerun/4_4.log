+        q = deque()
+        for cell in layer0_local:
+            dist[cell] = 0
+            q.append(cell)
+
+        while q:
+            r, c = q.popleft()
+            next_dist = dist[(r, c)] + 1
+            for dr, dc in DIR4:
+                nr = r + dr
+                nc = c + dc
+                nxt = (nr, nc)
+                if not (0 <= nr < local_h and 0 <= nc < local_w):
+                    continue
