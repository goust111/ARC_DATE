+    max_tracks = min(MAX_TRACKS, len(TRACK_COLORS))
+    track_count = random.randint(1, max_tracks)
+    colors = random.sample(TRACK_COLORS, track_count)
+
+    blocked = np.zeros((h, w), dtype=bool)
+    objects: list[dict[str, object]] = []
+
