+        for bits in range(1, 1 << total):
+            mask = np.zeros((size, size), dtype=bool)
+            for idx in range(total):
+                if bits & (1 << idx):
+                    mask[idx // size, idx % size] = True
+            if not np.all(mask.any(axis=0)) or not np.all(mask.any(axis=1)):
+                continue
