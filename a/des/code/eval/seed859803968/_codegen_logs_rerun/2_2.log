+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+GREY = 5
+TRACK_COLORS = (1, 2, 3, 6, 7, 8, 9)
+
+GRID_MIN = 14
+GRID_MAX = 24
+MAX_TRACKS = 4
+MAX_TRACK_LEN = 11
