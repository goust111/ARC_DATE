+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not bool(mask[r, c]):
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _mask_connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return False
+    seen = np.zeros_like(mask, dtype=bool)
+    start = tuple(map(int, pts[0]))
+    q = deque([start])
+    seen[start] = True
+    count = 0
+    while q:
+        r, c = q.popleft()
+        count += 1
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                seen[nr, nc] = True
+                q.append((nr, nc))
+    return count == int(mask.sum())
+
+
+def _is_asymmetric(mask: np.ndarray) -> bool:
+    for turns in range(4):
+        rotated = np.rot90(mask, turns)
+        for flipped in (False, True):
+            cand = np.fliplr(rotated) if flipped else rotated
+            if turns == 0 and not flipped:
+                continue
+            if cand.shape == mask.shape and np.array_equal(cand, mask):
+                return False
+    return True
