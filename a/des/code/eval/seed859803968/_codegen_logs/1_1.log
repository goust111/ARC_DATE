+        r0, c0, r1, c1 = _bbox(coords)
+        stamp = panel[r0 : r1 + 1, c0 : c1 + 1] == color
+        stamps[color] = stamp
+    assert stamps, "legend panel must contain at least one stamp"
+    return stamps
