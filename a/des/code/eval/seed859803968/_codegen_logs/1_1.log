+def _apply_notch(patch: np.ndarray, side: str, pos: int, depth: int) -> bool:
+    trial = patch.copy()
+    if side == "top":
+        trial[1 : 1 + depth, pos] = GREY
+    elif side == "bottom":
+        trial[-1 - depth : -1, pos] = GREY
+    elif side == "left":
+        trial[pos, 1 : 1 + depth] = GREY
+    else:
+        trial[pos, -1 - depth : -1] = GREY
