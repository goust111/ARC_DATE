+
+
+def _seed_candidates(
+    grid: np.ndarray,
+    terrain_bbox: tuple[int, int, int, int],
+    legend_positions: set[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    r0, c0, r1, c1 = terrain_bbox
+    candidates: list[tuple[int, int]] = []
+    for r in range(1, h - 1):
