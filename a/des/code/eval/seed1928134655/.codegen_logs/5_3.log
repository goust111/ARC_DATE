+    if edge == "left":
+        return [(start + i, 0) for i in range(length)]
+    return [(start + i, w - 1) for i in range(length)]
+
+
+def _seed_candidates(
+    grid: np.ndarray,
+    terrain_bbox: tuple[int, int, int, int],
+    legend_positions: set[tuple[int, int]],
+) -> list[tuple[int, int]]:
