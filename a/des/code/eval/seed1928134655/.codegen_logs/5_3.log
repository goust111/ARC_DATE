+        if not seeds[int(color)]:
+            continue
+        inner_next = inside_masks[i + 1] if i + 1 < len(inside_masks) else empty
+        fill_mask = inside_masks[i] & ~inner_next & (out == bg)
+        out[fill_mask] = int(color)
+    return out
