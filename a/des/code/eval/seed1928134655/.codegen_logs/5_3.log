+    bottom_steps = [rng.randint(2, 4) for _ in range(n_layers - 1)]
+    left_steps = [rng.randint(2, 4) for _ in range(n_layers - 1)]
+    right_steps = [rng.randint(2, 4) for _ in range(n_layers - 1)]
