    positions = _legend_positions_for(edge, start, n, h, w)
    for (r, c), color in zip(positions, colors):
        grid[r, c] = int(color)
    return positions


def _gen_attempt(rng: random.Random) -> np.ndarray | None:
    h = rng.randint(18, 28)
    w = rng.randint(18, 30)
    n_layers = rng.randint(2, 4)
    colors = rng.sample(COLOR_POOL, n_layers)
