+    top_margin = 4 if edge == "top" else 2
+    bottom_margin = 4 if edge == "bottom" else 2
+    left_margin = 4 if edge == "left" else 2
+    right_margin = 4 if edge == "right" else 2
+
+    if outer_h > h - top_margin - bottom_margin:
