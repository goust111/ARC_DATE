+            if (r, c) in legend_positions or int(grid[r, c]) != BG:
+                continue
+            if r0 - 1 <= r <= r1 + 1 and c0 - 1 <= c <= c1 + 1:
+                continue
+            if all(int(grid[r + dr, c + dc]) == BG for dr, dc in NEIGHBORS8):
