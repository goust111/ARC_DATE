+        start = rng.randint(1, w - n - 1)
+    else:
+        if h < n + 2:
+            return None
+        start = rng.randint(1, h - n - 1)
+    positions = _legend_positions_for(edge, start, n, h, w)
+    for (r, c), color in zip(positions, colors):
