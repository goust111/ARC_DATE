+def _choose_flag_rows(rng: random.Random, heights: list[int], legend_top: int) -> list[int] | None:
+    count = len(heights)
+    max_starts = [legend_top - height for height in heights]
+    rows: list[int] = []
+
+    def rec(i: int, prev: int) -> bool:
