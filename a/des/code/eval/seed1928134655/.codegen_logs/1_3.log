+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input grid")

