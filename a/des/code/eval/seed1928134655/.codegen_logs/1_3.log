+        return (-1, 0)
+    if r == r1 and c0 < c < c1:
+        return (1, 0)
+    if c == c0 and r0 < r < r1:
+        return (0, -1)
+    if c == c1 and r0 < r < r1:
+        return (0, 1)
+    return None
+
+
+def _detect_frames(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    frames: list[dict[str, object]] = []
+    for color in np.unique(grid):
+        color = int(color)
