+    height: int, width: int, points: list[tuple[int, int]]
+) -> set[tuple[int, int]]:
+    pts: set[tuple[int, int]] = set()
+    for r, c in points:
+        for rr in range(max(0, r - RESERVE_RADIUS), min(height, r + RESERVE_RADIUS + 1)):
