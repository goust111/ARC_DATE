from __future__ import annotations

import random

import numpy as np


BG = 0
MARKER = 9
FRAME_COLORS = (1, 2, 3, 4, 5, 6, 7, 8)
DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]

