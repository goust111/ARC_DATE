+        box_w = random.randint(*FRAME_W_RANGE)
+        area = (box_h - 2) * (box_w - 2)
+        anchor = _sample_bbox(height, width, box_h, box_w, direction, truncated, area)
+        if anchor is None:
+            continue
+        r0, c0 = anchor
+        r1 = r0 + box_h - 1
+        c1 = c0 + box_w - 1
