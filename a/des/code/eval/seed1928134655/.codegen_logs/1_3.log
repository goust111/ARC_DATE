+    for r in range(max(0, r0 - RESERVE_RADIUS), min(height, r1 + RESERVE_RADIUS + 1)):
+        for c in range(max(0, c0 - RESERVE_RADIUS), min(width, c1 + RESERVE_RADIUS + 1)):
