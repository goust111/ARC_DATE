+
+
+def _random_shortest_path(
+    start: tuple[int, int], goal: tuple[int, int], blocked: np.ndarray
+) -> list[tuple[int, int]] | None:
+    h, w = blocked.shape
+    q = deque([start])
+    prev = {start: None}
+    while q:
+        cur = q.popleft()
+        if cur == goal:
+            break
+        nbrs = list(DIR4)
+        random.shuffle(nbrs)
+        for dr, dc in nbrs:
+            nr = cur[0] + dr
+            nc = cur[1] + dc
+            nxt = (nr, nc)
+            if not _in_bounds(h, w, nr, nc) or blocked[nr, nc] or nxt in prev:
+                continue
+            prev[nxt] = cur
+            q.append(nxt)
