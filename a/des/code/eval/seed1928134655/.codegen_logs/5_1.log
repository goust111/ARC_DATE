+    if side == "left":
+        return (r0 + 1, c0 - 1), (r0 + 1, c0 - 2), (0, -1)
+    return (r0 + 1, c0 + 3), (r0 + 1, c0 + 4), (0, 1)
+
+
+def _cargo_cells_for_mouth(
