+
+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    bg = _border_bg(g)
+    mapping, legend_mask = _find_legend(g, bg)
+    pipes = _find_pipe_infos(g, legend_mask, bg)
