+            if c0 - 1 >= 0 and not legend_mask[r0 + 1, c0 - 1] and int(g[r0 + 1, c0 - 1]) == color:
+                exits.append(("left", (r0 + 1, c0 - 1)))
+            if c0 + 3 < w and not legend_mask[r0 + 1, c0 + 3] and int(g[r0 + 1, c0 + 3]) == color:
