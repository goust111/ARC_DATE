+def _legend_layout(
+    h: int,
+    w: int,
+    pairs: list[tuple[int, int]],
+    side: str,
+) -> tuple[np.ndarray, np.ndarray]:
+    grid = np.zeros((h, w), dtype=int)
+    mask = np.zeros((h, w), dtype=bool)
+    n = len(pairs)
+    if side in ("top", "bottom"):
+        start = random.randint(1, w - n - 1)
+        for i, (cargo, pipe) in enumerate(pairs):
+            c = start + i
+            if side == "top":
+                grid[0, c] = cargo
+                grid[1, c] = pipe
+                mask[0:2, c] = True
+            else:
+                grid[h - 1, c] = cargo
+                grid[h - 2, c] = pipe
+                mask[h - 2 : h, c] = True
+    else:
+        start = random.randint(1, h - n - 1)
+        for i, (cargo, pipe) in enumerate(pairs):
+            r = start + i
+            if side == "left":
+                grid[r, 0] = cargo
+                grid[r, 1] = pipe
+                mask[r, 0:2] = True
+            else:
+                grid[r, w - 1] = cargo
+                grid[r, w - 2] = pipe
+                mask[r, w - 2 : w] = True
+    return grid, mask
+
