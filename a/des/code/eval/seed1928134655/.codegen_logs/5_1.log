+
+def _find_pipe_infos(g: np.ndarray, legend_mask: np.ndarray, bg: int) -> dict[int, dict]:
+    h, w = g.shape
+    color_cells: dict[int, set[tuple[int, int]]] = {}
+    for color in np.unique(g):
