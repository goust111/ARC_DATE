+
+def _cargo_cells_for_mouth(
+    h: int,
+    w: int,
+    mouth: tuple[int, int],
+    direction: tuple[int, int],
+    reserved: np.ndarray,
+) -> list[tuple[int, int]] | None:
+    dr, dc = direction
+    pr, pc = -dc, dr
+    offsets = [
+        (dr, dc),
+        (dr + pr, dc + pc),
+        (dr - pr, dc - pc),
+    ]
+    patterns = {
+        1: [[0]],
+        2: [[0, 1], [0, 2]],
+        3: [[0, 1, 2]],
+    }
+    size = random.choice([1, 2, 3])
+    pattern_list = patterns[size][:]
+    random.shuffle(pattern_list)
+
+    for pat in pattern_list:
+        cells = []
+        ok = True
+        for idx in pat:
