+    for pipe_color, payloads in by_pipe.items():
+        payloads.sort()
+        slots = pipes[pipe_color]["fill_order"]
+        assert len(payloads) <= len(slots), "warehouse capacity exceeded"
+        for idx, (_, _, _, cargo_color) in enumerate(payloads):
+            rr, cc = slots[idx]
+            out[rr, cc] = cargo_color
+
+    return out
