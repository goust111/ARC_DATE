+        return None
+
+    path = []
+    cur = goal
+    while cur is not None:
+        path.append(cur)
+        cur = prev[cur]
+    path.reverse()
+    return path
+
+
+def _legend_layout(
+    h: int,
+    w: int,
+    pairs: list[tuple[int, int]],
+    side: str,
+) -> tuple[np.ndarray, np.ndarray]:
+    grid = np.zeros((h, w), dtype=int)
+    mask = np.zeros((h, w), dtype=bool)
+    n = len(pairs)
+    if side in ("top", "bottom"):
+        start = random.randint(1, w - n - 1)
