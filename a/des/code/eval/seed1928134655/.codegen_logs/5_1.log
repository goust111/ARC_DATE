+def _side_geometry(r0: int, c0: int, side: str) -> tuple[tuple[int, int], tuple[int, int], tuple[int, int]]:
+    if side == "top":
+        return (r0 - 1, c0 + 1), (r0 - 2, c0 + 1), (-1, 0)
+    if side == "bottom":
+        return (r0 + 3, c0 + 1), (r0 + 4, c0 + 1), (1, 0)
+    if side == "left":
