+            warehouse = {(rr, cc) for rr in range(r0, r0 + 3) for cc in range(c0, c0 + 3)}
+            cells = color_cells.get(color, set())
+            path_cells = cells - warehouse
+            if exits[0][1] not in path_cells:
+                continue
+            if not path_cells:
