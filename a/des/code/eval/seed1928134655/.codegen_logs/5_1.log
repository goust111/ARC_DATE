+
+
+def _validate_generated_grid(g: np.ndarray, expected_pairs: dict[int, int]) -> bool:
+    try:
+        bg = _border_bg(g)
+        mapping, legend_mask = _find_legend(g, bg)
+        if mapping != expected_pairs:
