+            side = exits[0][0]
+            infos[color] = {
+                "warehouse_top_left": (r0, c0),
+                "warehouse_cells": warehouse,
+                "entry_side": side,
+                "open_end": open_ends[0],
+                "fill_order": _warehouse_fill_order(r0, c0, side),
+            }
