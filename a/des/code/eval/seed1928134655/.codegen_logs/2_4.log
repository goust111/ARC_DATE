+    return out, {
+        "mix_map": mix_map,
+        "legend_mask": legend_mask,
+        "legend_bbox": legend_bbox,
+        "arrows": arrows,
+        "collisions": collisions,
+        "blocked_hits": blocked_hits,
+    }
