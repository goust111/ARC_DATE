+    grid[:leg_h, :leg_w] = BG
+    grid[0, :leg_w] = GREY
+    grid[leg_h - 1, :leg_w] = GREY
+    grid[:leg_h, 0] = GREY
+    grid[:leg_h, leg_w - 1] = GREY
