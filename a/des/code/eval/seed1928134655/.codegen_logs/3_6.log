+            wall_cells |= wall_seg
+            occupied_input |= candidate_input | wall_seg
+            reserved |= dynamic_zone | wall_seg
+            objects.append(
+                {
+                    "color": color,
+                    "cells": object_cells,
+                    "arrow": arrow_cells,
+                    "direction": direction,
+                    "distance": distance,
