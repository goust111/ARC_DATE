+def _make_arrow(
+    r0: int, c0: int, h: int, w: int, direction: str, attach: int, shaft_len: int
+) -> set[tuple[int, int]]:
+    r1 = r0 + h - 1
+    c1 = c0 + w - 1
+
+    if direction == "right":
+        attach_r = r0 + attach
+        far_c = c1 + shaft_len
