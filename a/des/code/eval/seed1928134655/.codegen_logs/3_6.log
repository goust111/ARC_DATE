+            inp[r, c] = obj["color"]
+
+    expected = _render_scene((H, W), wall_cells, objects)
+    return inp, expected
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_SCENE_ATTEMPTS):
+        built = _build_scene()
+        if built is None:
+            continue
+        inp, expected = built
+        actual = main(inp)
+        if not np.array_equal(actual, expected):
+            continue
+
+        colors = sorted(set(int(v) for v in np.unique(inp)) - {BG, GREY})
+        if len(colors) < 2:
+            continue
+        if sum(int(np.count_nonzero(inp == GREY)) > 0 for _ in [0]) != 1:
+            continue
+        return inp
