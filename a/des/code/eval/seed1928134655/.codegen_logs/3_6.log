+    if all(c < c0 for _r, c in arrow_cells):
+        far_c = c0 - shaft_len
+        for attach_r in range(r0, r1 + 1):
+            expected = {(attach_r, c) for c in range(far_c, c0)}
+            expected.add((attach_r - 1, far_c))
+            expected.add((attach_r + 1, far_c))
