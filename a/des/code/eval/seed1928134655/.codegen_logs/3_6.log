+            (attach_r - 1, far_c),
+            (attach_r + 1, far_c),
+        }
+    if direction == "left":
+        attach_r = r0 + attach
+        far_c = c0 - shaft_len
+        return {(attach_r, c) for c in range(far_c, c0)} | {
+            (attach_r - 1, far_c),
+            (attach_r + 1, far_c),
+        }
+    if direction == "down":
+        attach_c = c0 + attach
+        far_r = r1 + shaft_len
+        return {(r, attach_c) for r in range(r1 + 1, far_r + 1)} | {
+            (far_r, attach_c - 1),
+            (far_r, attach_c + 1),
+        }
+    attach_c = c0 + attach
+    far_r = r0 - shaft_len
+    return {(r, attach_c) for r in range(far_r, r0)} | {
+        (far_r, attach_c - 1),
+        (far_r, attach_c + 1),
+    }
+
+
+def _position_ranges(
+    H: int, W: int, h: int, w: int, direction: str, attach: int, mode: str, distance: int
+) -> list[tuple[int, int]]:
+    positions: list[tuple[int, int]] = []
+
+    if direction in ("right", "left"):
+        row_lo = max(0, 1 - attach)
+        row_hi = min(H - h, H - 2 - attach)
+        if row_lo > row_hi:
+            return []
+
+        if direction == "right":
+            if mode == "boundary":
+                for clearance in (distance - 2, distance - 1):
+                    c0 = W - w - clearance
+                    if 0 <= c0 <= W - w:
+                        for r0 in range(row_lo, row_hi + 1):
+                            positions.append((r0, c0))
+            else:
+                col_lo, col_hi = 0, W - w - distance
+                if col_lo <= col_hi:
+                    for r0 in range(row_lo, row_hi + 1):
+                        for c0 in range(col_lo, col_hi + 1):
+                            positions.append((r0, c0))
+        else:
+            if mode == "boundary":
+                for clearance in (distance - 2, distance - 1):
+                    c0 = clearance
+                    if 0 <= c0 <= W - w:
+                        for r0 in range(row_lo, row_hi + 1):
