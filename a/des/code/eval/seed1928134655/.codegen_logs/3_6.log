+
+    if direction == "left":
+        wall_col = c0 - stop_steps - 1
+        block_coords = [(r, wall_col) for r in range(r0, r1 + 1) if (r, wall_col) not in arrow_at]
+        random.shuffle(block_coords)
+        for block_r, _wall_c in block_coords:
