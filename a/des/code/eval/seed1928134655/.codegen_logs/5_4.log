    sides: dict[str, tuple | None] = {}
    accounted = np.zeros_like(patch, dtype=bool)
    accounted[br0 : br1 + 1, bc0 : bc1 + 1] = sub == body_color

    def tooth_feature(side: str) -> tuple | None:
        if side == "top":
