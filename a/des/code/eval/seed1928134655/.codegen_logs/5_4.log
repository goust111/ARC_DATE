+import numpy as np
+
+
+SIDE_ORDER = ("top", "right", "bottom", "left")
+OPPOSITE = {"top": "bottom", "right": "left", "bottom": "top", "left": "right"}
+ROTATIONS = (0, 1, 2, 3)
+BG = 0
+LAYOUT_CHOICES = ("row2", "row3", "row4", "col2", "col3", "col4", "grid")
+SIZE_MIN = 4
+SIZE_MAX = 6
+GEN_RETRIES = 400
