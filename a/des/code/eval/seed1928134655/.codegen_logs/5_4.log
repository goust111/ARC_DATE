+                pieces[bottom_idx]["sides"]["top"] = ("slot", off)
+            else:
+                pieces[top_idx]["sides"]["bottom"] = ("slot", off)
+                pieces[bottom_idx]["sides"]["top"] = ("tooth", off, int(pieces[top_idx]["color"]))
