+    if np.any((patch != bg) & ~accounted):
+        return None
+
+    return {"color": body_color, "h": h, "w": w, "sides": sides}
+
+
+def _piece_variants(patch: np.ndarray, bg: int) -> list[dict]:
+    variants: list[dict] = []
+    seen: set[tuple] = set()
