+    idx = 0
+    for rr in range(rows):
+        for cc in range(cols):
+            h = int(row_heights[rr])
+            w = int(col_widths[cc])
+            color = int(piece_colors[idx])
+            r0 = int(row_starts[rr])
+            c0 = int(col_starts[cc])
