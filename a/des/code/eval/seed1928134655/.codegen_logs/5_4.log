                return None
            cols = np.flatnonzero(patch[br0 - 1, bc0 : bc1 + 1] != bg)
            if len(cols) > 1:
                return None
            if len(cols) == 1:
                off = int(cols[0])
                accounted[br0 - 1, bc0 + off] = True
                return ("tooth", off, int(patch[br0 - 1, bc0 + off]))
        elif side == "bottom":
            if br1 == patch.shape[0] - 1:
