+            if len(rows) > 1:
+                return None
+            if len(rows) == 1:
+                off = int(rows[0])
+                accounted[br0 + off, bc1 + 1] = True
+                return ("tooth", off, int(patch[br0 + off, bc1 + 1]))
+        return None
