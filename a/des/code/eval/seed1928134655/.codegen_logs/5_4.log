+        if len(set(map(int, above))) != 1:
+            return False
+        neighbor_id = int(above[0])
+        neighbor = placements[neighbor_id]
+        nmeta = neighbor["meta"]
+        if int(neighbor["r"]) + int(nmeta["h"]) != r or int(neighbor["c"]) != c or int(nmeta["w"]) != w:
+            return False
+        if not _match_features(nmeta, "bottom", meta, "top"):
