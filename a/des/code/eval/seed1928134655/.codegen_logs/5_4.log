+            right_idx = index_at[(rr, cc + 1)]
+            off = random.randint(1, int(row_heights[rr]) - 2)
+            if random.random() < 0.5:
+                pieces[left_idx]["sides"]["right"] = ("tooth", off, int(pieces[right_idx]["color"]))
