+    first_two = random.sample(DIR4, 2)
+    for dr, dc in first_two:
+        nxt = (dr, dc)
+        cells.append(nxt)
+        cell_set.add(nxt)
+
+    while len(cells) < count:
+        options = []
+        for cell in cells:
+            r, c = cell
+            for dr, dc in DIR4:
+                nxt = (r + dr, c + dc)
+                if nxt in cell_set:
+                    continue
+                if _neighbor_count(nxt, cell_set) == 1:
+                    options.append(nxt)
