+    except AssertionError:
+        return None
+
+    if np.array_equal(grid, out):
+        return None
+    if int((grid == marker_color).sum()) != 1:
+        return None
+    if int((out == marker_color).sum()) != gear_count:
+        return None
+
+    return grid
+
