+
+    adj: dict[int, list[int]] = {idx: [] for idx in range(len(gears))}
+    for i in range(len(gears)):
+        r1, c1 = gears[i]["center"]
+        for j in range(i + 1, len(gears)):
+            r2, c2 = gears[j]["center"]
+            if (abs(r1 - r2) == 6 and c1 == c2) or (abs(c1 - c2) == 6 and r1 == r2):
+                adj[i].append(j)
