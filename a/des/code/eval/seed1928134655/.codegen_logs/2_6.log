+        if left >= c0 + 1:
+            cols.append(left)
+            added = True
+        if right <= c1 - 1:
+            cols.append(right)
+            added = True
+        if not added:
+            break
+        offset += 1
+
+    coords: list[tuple[int, int]] = []
+    for c in cols:
+        for r in range(r1 - 1, r0, -1):
+            coords.append((r, c))
+    return coords
+
