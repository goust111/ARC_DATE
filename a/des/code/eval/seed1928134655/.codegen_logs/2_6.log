+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+COLOR_POOL = tuple(c for c in range(10) if c not in (BLACK, GREY))
+
+GEN_ATTEMPTS = 400
+MAX_GRID_H = 34
+MAX_GRID_W = 32
