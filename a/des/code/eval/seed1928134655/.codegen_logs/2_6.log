+def _settle_coords(r0: int, c0: int, r1: int, c1: int, gap0: int, gap1: int) -> list[tuple[int, int]]:
+    cols = list(range(gap0, gap1 + 1))
+    offset = 1
+    while True:
+        added = False
+        left = gap0 - offset
+        right = gap1 + offset
+        if left >= c0 + 1:
+            cols.append(left)
+            added = True
+        if right <= c1 - 1:
+            cols.append(right)
+            added = True
+        if not added:
+            break
+        offset += 1
+
+    coords: list[tuple[int, int]] = []
+    for c in cols:
+        for r in range(r1 - 1, r0, -1):
+            coords.append((r, c))
+    return coords
+
+
+def _pipe_fill_coords(pipe_rows: list[int], gap0: int, gap1: int) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    for r in pipe_rows:
+        for c in range(gap0, gap1 + 1):
+            coords.append((r, c))
+    return coords
