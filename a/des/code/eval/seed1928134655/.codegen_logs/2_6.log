+    bottom = grid[r1, c0 + 1 : c1]
+    if bottom.size == 0 or np.any((bottom != BLACK) & (bottom != GREY)):
+        return None
+    runs = _black_runs(bottom == BLACK)
+    if len(runs) != 1:
+        return None
+    rel0, rel1 = runs[0]
+    if rel1 - rel0 + 1 not in (1, 2):
+        return None
