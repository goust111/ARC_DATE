+        color = int(colored[0])
+        count = int(colored.size)
+
+        for r, c in _settle_coords(r0, c0, r1, c1, gap0, gap1)[:count]:
+            out[r, c] = color
+        for r, c in _pipe_fill_coords(pool["pipe_rows"], gap0, gap1)[:count]:
