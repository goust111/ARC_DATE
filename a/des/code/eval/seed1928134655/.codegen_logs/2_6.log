+    for pool in pools:
+        r0, c0, r1, c1 = pool["bbox"]
+        interior = out[r0 + 1 : r1, c0 + 1 : c1]
+        interior[(interior != BLACK) & (interior != GREY)] = BLACK
+
+    for pool in pools:
+        r0, c0, r1, c1 = pool["bbox"]
+        gap0, gap1 = pool["gap"]
+        source = g[r0 + 1 : r1, c0 + 1 : c1]
+        colored = source[(source != BLACK) & (source != GREY)]
+        if colored.size == 0:
+            continue
