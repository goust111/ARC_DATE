+
+def _choose_axes(rng: random.Random, width: int, num_axes: int) -> list[int] | None:
+    if num_axes == 1:
+        if width < 15:
+            return None
+        return [rng.randint(6, width - 7)]
+
+    pairs: list[tuple[int, int]] = []
+    for a0 in range(6, width - 12):
