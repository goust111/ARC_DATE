+    signs = {1 if diff > 0 else -1 for diff in diffs}
+    if len(signs) != 1:
+        return None
+    side = int(next(iter(signs)))
+    dist = min(abs(diff) for diff in diffs)
+    return dist, side
+
+
+def main(grid: np.ndarray) -> np.ndarray:
