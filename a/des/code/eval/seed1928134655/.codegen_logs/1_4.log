+    return mask
+
+
+def _component_axis_distance(
+    comp: list[tuple[int, int]], axis: dict[str, object]
+) -> tuple[int, int] | None:
+    pos = int(axis["pos"])
+    if axis["kind"] == "v":
+        diffs = [c - pos for _r, c in comp]
+    else:
