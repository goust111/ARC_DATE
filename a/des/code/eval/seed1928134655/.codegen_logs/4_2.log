0032: def main(grid: np.ndarray) -> np.ndarray:
0033:     """Move the colored object from the lower bracket lane to the upper bracket lane and drop it to the bottom edge.
0034: 
0035:     Input structure
0036:     - The background is the dominant color.
0037:     - One frame color forms exactly two 4-connected bracket objects: a top-edge bracket open downward and a bottom-edge bracket open upward.
0038:     - One other 4-connected foreground object sits in the lower bracket's interior column span.
0039: 
0040:     Rule
0041:     - Remove the movable object from its original cells.
0042:     - Keep its shape and color unchanged.
0043:     - Paste it with its bbox columns aligned to the top bracket's interior columns and with its bbox bottom aligned to the grid bottom.
0044: 
0045:     Key insight
0046:     - The lower bracket identifies the object's source lane; the upper bracket provides the target lane, and the final vertical placement is bottom-aligned.
0047:     """
0048:     g = np.asarray(grid, dtype=int)
0049:     height, width = g.shape
0050:     bg = get_bg(g)
0051: 
0052:     components_by_color = {}
0053:     bracket_candidates = []
0054:     for color in colors_present(g, exclude={bg}):
0055:         components = find_components(
0056:             g,
0057:             bg=bg,
0058:             colors=[color],
0059:             connectivity=4,
0060:             monochromatic=True,
0061:         )
0062:         components_by_color[color] = components
0063:         top = [component for component in components if _is_top_bracket(component)]
0064:         bottom = [
0065:             component for component in components
0066:             if _is_bottom_bracket(component, height)
0067:         ]
0068:         if len(components) == 2 and len(top) == 1 and len(bottom) == 1:
0069:             bracket_candidates.append((color, top[0], bottom[0]))
0070: 
0071:     assert len(bracket_candidates) == 1
0072:     frame_color, top_bracket, bottom_bracket = bracket_candidates[0]
0073: 
0074:     movers = [
0075:         component
0076:         for color, components in components_by_color.items()
0077:         if color != frame_color
0078:         for component in components
0079:     ]
0080:     assert len(movers) == 1
0081:     mover = movers[0]
0082: 
0083:     _, mc0, _, mc1 = mover["bbox"]
0084:     _br0, bc0, _br1, bc1 = bottom_bracket["bbox"]
0085:     _tr0, tc0, _tr1, tc1 = top_bracket["bbox"]
0086:     assert (mc0, mc1) == (bc0 + 1, bc1 - 1)
0087:     assert bbox_w(mover["bbox"]) == tc1 - tc0 - 1
0088: 
0089:     patch = crop_bbox(g, mover["bbox"])
0090:     dest_r = height - patch.shape[0]
0091:     dest_c = tc0 + 1
0092:     assert dest_r >= 0
0093:     assert dest_c >= 0 and dest_c + patch.shape[1] <= width
0094: 
0095:     out = g.copy()
0096:     mover_coords = mover["coords"]
0097:     out[mover_coords[:, 0], mover_coords[:, 1]] = bg
0098: 
0099:     colored_patch = patch != bg
0100:     target = out[dest_r:dest_r + patch.shape[0], dest_c:dest_c + patch.shape[1]]
0101:     assert np.all(target[colored_patch] == bg)
