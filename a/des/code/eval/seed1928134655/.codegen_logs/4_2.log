0204: def _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:
0205:     """5x5 cardinal legend. Canonical direction: (0, +1) right."""
0206:     g = np.full((5, 5), fill, dtype=int)
0207:     g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2
0208:     g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2
0209:     rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}
0210:     return np.rot90(g, rot[(dr, dc)])
0211: 
0212: 
0213: def _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:
0214:     """6x7 diagonal legend. Canonical direction: (+1, +1) down-right."""
0215:     g = np.full((6, 7), fill, dtype=int)
0216:     g[1, 3] = 1
0217:     g[2, 1] = 1; g[2, 4] = 1
0218:     g[3, 2] = 1; g[3, 5] = 2
0219:     g[4, 3] = 2
0220:     if (dr, dc) == (1, 1): return g
0221:     if (dr, dc) == (-1, 1): return np.flipud(g)
0222:     if (dr, dc) == (1, -1): return np.fliplr(g)
0223:     if (dr, dc) == (-1, -1): return np.rot90(g, 2)
0224:     raise ValueError((dr, dc))
0225: 
