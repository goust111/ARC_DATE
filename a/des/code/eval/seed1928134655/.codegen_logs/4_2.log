+            seen[r, c] = True
+            touches_border = False
+            while stack:
+                cr, cc = stack.pop()
+                if cr == 0 or cr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_border = True
+                for nr, nc in _neighbors4(cr, cc, h, w):
