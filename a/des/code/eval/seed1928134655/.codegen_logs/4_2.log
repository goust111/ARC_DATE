0117:     h, w = g.shape
0118:     bg = get_bg(g)
0119: 
0120:     mover = 4  # yellow in ARC
0121:     dirs = _legend_directions(g, bg)
0122:     assert dirs, "legend_directions must find at least one legend; grid should always have border legends"
0123: 
0124:     passable = (g == bg) | (g == mover)
0125:     out = g.copy()
