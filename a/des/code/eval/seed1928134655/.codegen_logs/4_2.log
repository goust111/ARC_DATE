+
+
+def _grow_connected_mask(h: int, w: int, area: int, rng: random.Random) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    seed = (rng.randrange(h), rng.randrange(w))
+    mask[seed] = True
