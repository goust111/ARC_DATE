+    for idx in order:
+        patch = items[idx]["patch"]
+        ph, pw = patch.shape
+        if ph + 2 > h or pw + 2 > w:
+            return None
+        placed = False
+        for _ in range(PLACEMENT_RETRIES):
+            r0 = rng.randint(1, h - ph - 1)
+            c0 = rng.randint(1, w - pw - 1)
+            rect = (r0, c0, r0 + ph - 1, c0 + pw - 1)
+            if _rect_conflicts(rect, rects):
+                continue
+            rects.append(rect)
+            pos[idx] = (r0, c0)
+            placed = True
+            break
+        if not placed:
+            return None
+    return pos
+
