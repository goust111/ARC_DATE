+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid lock-key ARC sample")

