0149:             mask = np.zeros((height, width), dtype=bool)
0150:             mask[np.unravel_index(cells, (height, width))] = True
0151:             if not mask.any(axis=0).all() or not mask.any(axis=1).all():
0152:                 continue
0153:             if is_contiguous(mask.astype(int), background=0, connectivity=4):
0154:                 masks.append(mask)
