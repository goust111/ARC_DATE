+def _solve_assignment(options: list[list[int]]) -> Optional[list[int]]:
+    order = sorted(range(len(options)), key=lambda i: len(options[i]))
+    used: set[int] = set()
+    assign = [-1] * len(options)
+
+    def backtrack(pos: int) -> bool:
+        if pos == len(order):
+            return True
+        lid = order[pos]
+        for kid in options[lid]:
+            if kid in used:
+                continue
+            used.add(kid)
+            assign[lid] = kid
+            if backtrack(pos + 1):
+                return True
+            used.remove(kid)
+            assign[lid] = -1
+        return False
+
+    if backtrack(0):
+        return assign
+    return None
+
