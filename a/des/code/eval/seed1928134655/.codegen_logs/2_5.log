+    height = int(r1 - r0 + 1)
+    width = int(c1 - c0 + 1)
+    if height < 3 or width < 3:
+        return None
+
+    pts = {(int(r), int(c)) for r, c in coords}
+    matches: list[tuple[str, str]] = []
+    for missing_side, opening in (
+        ("top", "up"),
+        ("right", "right"),
+        ("bottom", "down"),
+        ("left", "left"),
+    ):
+        expected = _frame_cells(height, width, missing_side, r0, c0)
+        if pts == expected:
