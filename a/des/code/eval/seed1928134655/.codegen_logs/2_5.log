+def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    h, w = grid.shape
+    mask = grid == color
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            queue = deque([(r, c)])
+            pts: list[tuple[int, int]] = []
+            while queue:
+                cr, cc = queue.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            components.append(np.array(pts, dtype=int))
+    return components
+
+
+def _frame_cells(
+    height: int,
+    width: int,
+    missing_side: str,
+    row_offset: int = 0,
+    col_offset: int = 0,
+) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    if missing_side != "top":
+        for c in range(width):
+            cells.add((row_offset, col_offset + c))
+    if missing_side != "bottom":
+        for c in range(width):
+            cells.add((row_offset + height - 1, col_offset + c))
+    if missing_side != "left":
+        for r in range(height):
+            cells.add((row_offset + r, col_offset))
+    if missing_side != "right":
+        for r in range(height):
+            cells.add((row_offset + r, col_offset + width - 1))
+    return cells
