+
+BLACK = 0
+COLOR_ORDER = (1, 2, 3, 4, 6, 7, 8, 9)  # Blue, Red, Green, Yellow, Magenta, Orange, Azure, Maroon
+DIRECTIONS = ("up", "right", "down", "left")
+DIR_TO_ROT = {"up": 0, "right": 1, "down": 2, "left": 3}
