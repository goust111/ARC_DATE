+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
