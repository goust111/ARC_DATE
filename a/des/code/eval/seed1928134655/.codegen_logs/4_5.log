+
+
+def _random_profile(dim: int) -> tuple[int, ...]:
+    run_count = random.randint(2, min(5, dim))
+    cuts = sorted(random.sample(range(1, dim), run_count - 1))
+    vals: list[int] = []
+    last = 0
+    sign = random.choice([-1, 1])
