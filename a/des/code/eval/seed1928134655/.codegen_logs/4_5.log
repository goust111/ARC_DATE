+    order = list(range(piece_count))
+    order.sort(key=lambda idx: piece_arrays[idx].shape[0] * piece_arrays[idx].shape[1], reverse=True)
+    random.shuffle(order)
+    placements: dict[int, tuple[int, int]] = {}
+    for idx in order:
