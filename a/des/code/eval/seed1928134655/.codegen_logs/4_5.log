+def _place_blocked(blocked: np.ndarray, r0: int, c0: int, h: int, w: int, margin: int = 1) -> None:
+    rr0 = max(0, r0 - margin)
+    cc0 = max(0, c0 - margin)
+    rr1 = min(blocked.shape[0], r0 + h + margin)
+    cc1 = min(blocked.shape[1], c0 + w + margin)
