+    bottom_margin = random.randint(0, 2)
+    right_margin = random.randint(0, 2)
+    palette_top = grid_h - palette_h - bottom_margin
+    palette_left = grid_w - palette_w - right_margin
+    if palette_top < 0 or palette_left < 0:
