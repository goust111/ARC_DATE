+    for r0 in range(h - rh + 1):
+        for c0 in range(w - rw + 1):
+            if not np.any(occupied[r0 : r0 + rh, c0 : c0 + rw] & reserve):
+                out.append((r0, c0))
+    return out
+
+
+def _paint_region(
