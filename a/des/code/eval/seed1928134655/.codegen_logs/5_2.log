import itertools

def rot(shape):
    return frozenset((c, -r) for r, c in shape)

pts = [(r, c) for r in (-1, 0, 1) for c in (-1, 0, 1)]
res = []
for k in (4, 5):
    for comb in itertools.combinations(pts, k):
        s = frozenset(comb)
        if (0, 0) not in s or (-1, 0) not in s:
            continue
        rs = [r for r, _ in s]
        cs = [c for _, c in s]
        if min(rs) "'!= -1 or max(rs) != 1 or min(cs) != -1 or max(cs) != 1:
            continue
        rots = [s]
        cur = s
        for _ in range(3):
            cur = rot(cur)
            rots.append(cur)
        if len(set(rots)) != 4:
            continue
        res.append(s)
print(len(res))
for s in res[:20]:
    print(sorted(s))
