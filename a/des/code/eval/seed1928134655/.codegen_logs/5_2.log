+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BG or visited[r, c]:
+                continue
+            q = deque([(r, c)])
+            visited[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and int(grid[nr, nc]) == color:
+                        visited[nr, nc] = True
+                        q.append((nr, nc))
+            coords = np.array(cells, dtype=int)
+            r0 = int(coords[:, 0].min())
+            c0 = int(coords[:, 1].min())
+            r1 = int(coords[:, 0].max())
+            c1 = int(coords[:, 1].max())
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "coord_set": set(cells),
+                    "bbox": (r0, c0, r1, c1),
+                    "area": len(cells),
+                }
+            )
+    return comps
+
+
+def _perimeter_cells(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    cells = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _gap_side(missing: set[tuple[int, int]], r0: int, c0: int, r1: int, c1: int) -> str | None:
+    if not missing:
+        return None
+    rows = {r for r, _ in missing}
+    cols = {c for _, c in missing}
+    if len(rows) == 1:
+        row = next(iter(rows))
+        ordered = sorted(cols)
+        if any(b != a + 1 for a, b in zip(ordered, ordered[1:])):
+            return None
+        if row == r0:
+            return "up"
+        if row == r1:
+            return "down"
+    if len(cols) == 1:
+        col = next(iter(cols))
+        ordered = sorted(rows)
+        if any(b != a + 1 for a, b in zip(ordered, ordered[1:])):
+            return None
+        if col == c0:
+            return "left"
+        if col == c1:
