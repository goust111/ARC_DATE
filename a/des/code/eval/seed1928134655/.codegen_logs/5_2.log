+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _rotate_offsets(offsets: frozenset[tuple[int, int]], turns: int) -> frozenset[tuple[int, int]]:
+    out = set(offsets)
+    for _ in range(turns % 4):
+        out = {(c, -r) for r, c in out}
+    return frozenset(out)
