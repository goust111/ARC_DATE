    'sq2': np.array([[1,1],[1,1]], dtype=bool),
    'rect23': np.array([[1,1,1],[1,1,1]], dtype=bool),
    'rect32': np.array([[1,1],[1,1],[1,1]], dtype=bool),
    'notch33': np.array([[1,1,1],[1,1,1],[1,1,0]], dtype=bool),
    'p32': np.array([[1,1],[1,1],[1,0]], dtype=bool),
