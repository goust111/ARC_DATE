            occ=set(); good=True
            anchors={a for a,_ in combo}
            for a,cells in combo:
                if occ & cells:
                    good=False; break
                if any(other in cells for other in anchors if other"'!=a):
                    good=False; break
                occ|=cells
            if good:
                best=k; found=True
        if not found:
            break
    return len(cands), best
for name, shape in shapes.items():
    print(name)
    for scale in [2,3]:
        print('"' ', scale, max_non_overlap(shape, scale))
