    'full33': np.array([[1,1,1],[1,1,1],[1,1,1]], dtype=bool),
}

def normalize(mask):
    coords=np.argwhere(mask)
    r0,c0=coords.min(0)
    r1,c1=coords.max(0)
    return mask[r0:r1+1,c0:c1+1]

def trans(mask):
    out=[]
    for k in range(4):
        rot=np.rot90(mask,k)
        for arr in [rot, np.fliplr(rot)]:
            arr=normalize(arr)
            sig=(arr.shape, tuple(arr.astype(int).ravel()))
            if sig not in {(a.shape, tuple(a.astype(int).ravel())) for a in out} and arr[0,0]:
                out.append(arr)
    return out

all_shapes=[]
for name, mask in shapes.items():
    for i, arr in enumerate(trans(mask)):
        all_shapes.append((f'{name}_{i}', arr))

bigs=[]
for name, sm in all_shapes:
    for scale in [2,3]:
        filled=np.kron(sm, np.ones((scale,scale),dtype=bool))
        bigs.append((name,scale,filled))

for bname,scale,filled in bigs:
    matches=[]
    for sname, sm in all_shapes:
        bh,bw=filled.shape; sh,sw=sm.shape
        if bh%sh==0 and bw%sw==0 and bh//sh==bw//sw and bh//sh>=2:
            k=bh//sh
            if np.array_equal(np.kron(sm, np.ones((k,k),dtype=bool)), filled):
                matches.append((sname,k))
    if len(matches)>1:
        print(bname, scale, 'matches', matches)
