+def _boundary_mode(grid: np.ndarray) -> int:
+    boundary = np.concatenate((grid[0], grid[-1], grid[1:-1, 0], grid[1:-1, -1]))
+    values, counts = np.unique(boundary, return_counts=True)
+    return int(values[np.argmax(counts)])
