+        return None
+    for _ in range(PLACEMENT_RETRIES * 2):
+        top = rng.randint(1, blocked.shape[0] - ph - 1)
+        left = rng.randint(1, blocked.shape[1] - pw - 1)
+        if np.any(blocked[top : top + ph, left : left + pw]):
+            continue
+        return top, left
+    return None
+
