+        grid[coords[:, 0], coords[:, 1]] = fill_color
+        grid[top + marker_local[0], left + marker_local[1]] = MARKER
+        _mark_blocked(blocked, top, left, top + piece_mask.shape[0] - 1, left + piece_mask.shape[1] - 1, pad=1)
