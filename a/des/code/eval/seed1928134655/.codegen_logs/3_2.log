+def _mask_signature(mask: np.ndarray) -> Tuple[Tuple[int, int], ...]:
+    variants = []
+    for k in range(4):
+        rot = _trim(np.rot90(mask, k))
+        variants.append(tuple(map(tuple, np.argwhere(rot).tolist())))
