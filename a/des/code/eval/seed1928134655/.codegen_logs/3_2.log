+        piece_mask = _trim(np.rot90(hole["mask"], scatter_k))
+        marker_local = _rotate_coord(hole["marker_local"], hole["mask"].shape, scatter_k)
+        placement = _place_piece_bbox(rng, blocked, piece_mask.shape)
