+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+GEN_RETRIES = 400
+MIN_OBJECTS = 2
+MAX_OBJECTS = 5
+PADDING = 1
