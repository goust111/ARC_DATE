+GREY = 5
+PALETTE = [0, 1, 2, 3, 4, 6, 7, 8, 9]
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+GEN_RETRIES = 400
+MIN_OBJECTS = 2
+MAX_OBJECTS = 5
+PADDING = 1
