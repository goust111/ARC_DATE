+def _expanded(cells: set[tuple[int, int]], h: int, w: int, pad: int = PADDING) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for dr in range(-pad, pad + 1):
+            for dc in range(-pad, pad + 1):
