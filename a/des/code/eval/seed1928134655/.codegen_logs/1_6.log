+        dr, dc = obj["delta"]
+
+        out[int(r0) : int(r0 + side), int(c0) : int(c0 + side)] = int(GREY)
+
+        nr0 = int(r0 + dr)
+        nc0 = int(c0 + dc)
+        out[int(nr0) : int(nr0 + side), int(nc0) : int(nc0 + side)] = int(color)
+
+    return out
+
