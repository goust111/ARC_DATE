    for dist in range(CLOSE_DIST_MIN, close_max + 1):
        options.append((KIND_CLOSE, dist))
    if margin >= side_len:
        for dist in range(side_len, min(margin, DIST_MAX) + 1):
            options.append((KIND_FAR, dist))
    return options


def _gen_d6e50e54_side_cap(margin, side_len):
