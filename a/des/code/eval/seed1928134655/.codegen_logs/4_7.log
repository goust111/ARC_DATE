+def _network_neighbors(grid: np.ndarray, r: int, c: int) -> list[tuple[int, int]]:
+    return [
+        (nr, nc)
+        for nr, nc in _neighbors4(grid.shape, r, c)
+        if int(grid[nr, nc]) in NETWORK_COLORS
+    ]
