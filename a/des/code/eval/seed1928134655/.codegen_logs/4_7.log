+    adjacency = {idx: sorted(neighbors) for idx, neighbors in adjacency_sets.items()}
+    for idx, node in enumerate(nodes):
+        degree = len(adjacency[idx])
+        kind = node["kind"]
+        if kind == "source":
+            assert degree == 1
+        elif kind == "sink":
+            assert degree == 1
+        elif kind == "merge":
