def _gen_split_marker_total(total: int, caps: list[int]) -> list[int] | None:
    counts: list[int] = []
    remaining = int(total)
    for i, cap in enumerate(caps):
        rest = caps[i + 1 :]
        lo = max(1, remaining - sum(rest))
        hi = min(int(cap), remaining - len(rest))
