+    frozenset({RED}): RED,
+    frozenset({BLUE}): BLUE,
+    frozenset({YELLOW}): YELLOW,
+    frozenset({RED, BLUE}): MAGENTA,
+    frozenset({RED, YELLOW}): ORANGE,
+    frozenset({BLUE, YELLOW}): GREEN,
+    frozenset({RED, BLUE, YELLOW}): MAROON,
