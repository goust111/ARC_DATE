+    while queue:
+        src, dst, signal = queue.popleft()
+        node = nodes[dst]
+        kind = node["kind"]
+
+        if kind == "sink":
+            sink_signals[dst] = sink_signals.get(dst, frozenset()) | signal
+            continue
+
+        if kind == "merge":
+            arrivals = merge_arrivals[dst]
+            arrivals[src] = arrivals.get(src, frozenset()) | signal
+            if len(arrivals) == len(adjacency[dst]) - 1:
