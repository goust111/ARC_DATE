            if dest in used_dest or src in used_src:
                continue
            if any(abs(src[0] - old[0]) + abs(src[1] - old[1]) == 1 for old in used_src):
                continue
            result = rec(
                i + 1,
                close_index,
                used_dest | {dest},
                used_src | {src},
                assigned + [(dest, src)],
            )
            if result is not None:
                return result
        return None

    close_indices = list(range(len(slots)))
    random.shuffle(close_indices)
