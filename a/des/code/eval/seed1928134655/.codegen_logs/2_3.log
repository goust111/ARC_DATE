+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    row_count, col_count = _choose_layout(rng)
+    color_count = row_count * col_count
+    colors = [int(c) for c in rng.choice(COLOR_POOL, size=color_count, replace=False)]
