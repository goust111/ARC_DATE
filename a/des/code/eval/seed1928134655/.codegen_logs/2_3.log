+def _can_place(coords: list[tuple[int, int]], occupied: np.ndarray) -> bool:
+    coord_set = set(coords)
+    h, w = occupied.shape
+    for r, c in coords:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        if occupied[r, c]:
