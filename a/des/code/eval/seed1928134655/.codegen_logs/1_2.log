+def _augment_mask(mask: np.ndarray) -> np.ndarray:
+    result = mask.copy()
+    h, w = result.shape
+    target_additions = random.randint(0, max(1, min((h * w) // 6, 5)))
+
+    for _ in range(target_additions):
+        occupied = np.argwhere(result)
+        candidates: set[tuple[int, int]] = set()
+        for r, c in occupied:
+            for dr, dc in _neighbor_dirs(8):
+                nr = int(r + dr)
+                nc = int(c + dc)
+                if 0 <= nr < h and 0 <= nc < w and not result[nr, nc]:
+                    candidates.add((nr, nc))
+        if not candidates:
+            break
+
+        tried = list(candidates)
+        random.shuffle(tried)
+        accepted = False
+        for nr, nc in tried:
+            trial = result.copy()
+            trial[nr, nc] = True
+            if _valid_pair_mask(trial):
+                result = trial
+                accepted = True
+                break
+        if not accepted:
+            break
+
+    return result
+
+
+def _make_pair_masks(height: int, width: int) -> tuple[np.ndarray, np.ndarray] | None:
+    for _ in range(SHAPE_RETRIES):
+        mask = _random_monotone_path_mask(height, width)
+        mask = _augment_mask(mask)
