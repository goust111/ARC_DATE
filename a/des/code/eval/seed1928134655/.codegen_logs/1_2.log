from z3 import *
from itertools import product

def find(H,W):
    boundary=[(r,c) for r in range(H) for c in range(W) if r in (0,H-1) or c in (0,W-1)]
    for rootA in boundary:
        for rootB in boundary:
            if rootA==rootB:
                continue
            A=[[Bool(f'a_{r}_{c}') for c in range(W)] for r in range(H)]
            s=Solver(); s.set(timeout=2000)
            ra,ca=rootA; rb,cb=rootB
            s.add(A[ra][ca])
            s.add(Not(A[rb][cb]))
            # both colors on every side
            for edge in [
                [(0,c) for c in range(W)],
                [(H-1,c) for c in range(W)],
                [(r,0) for r in range(H)],
                [(r,W-1) for r in range(H)],
            ]:
                s.add(Or([A[r][c] for r,c in edge]))
                s.add(Or([Not(A[r][c]) for r,c in edge]))
            total = Sum([If(A[r][c],1,0) for r in range(H) for c in range(W)])
            s.add(total "'!= H*W-total)
            maxd=H*W
            dA=[[Int(f'"'dA_{r}_{c}') for c in range(W)] for r in range(H)]
            dB=[[Int(f'dB_{r}_{c}') for c in range(W)] for r in range(H)]
            for r in range(H):
                for c in range(W):
                    s.add(Implies(A[r][c], And(dA[r][c] >= 0, dA[r][c] <= maxd)))
                    s.add(Implies(Not(A[r][c]), dA[r][c] == -1))
                    s.add(Implies(Not(A[r][c]), And(dB[r][c] >= 0, dB[r][c] <= maxd)))
                    s.add(Implies(A[r][c], dB[r][c] == -1))
            s.add(dA[ra][ca] == 0)
            s.add(dB[rb][cb] == 0)
            for r in range(H):
                for c in range(W):
                    if (r,c)"'!=(ra,ca):
                        nbrs=[And(A[nr][nc], dA[nr][nc] < dA[r][c])
                              for nr,nc in ((r+1,c),(r-1,c),(r,c+1),(r,c-1))
                              if 0<=nr<H and 0<=nc<W]
                        s.add(Implies(A[r][c], Or(nbrs)))
                    if (r,c)!=(rb,cb):
                        nbrs=[And(Not(A[nr][nc]), dB[nr][nc] < dB[r][c])
                              for nr,nc in ((r+1,c),(r-1,c),(r,c+1),(r,c-1))
                              if 0<=nr<H and 0<=nc<W]
                        s.add(Implies(Not(A[r][c]), Or(nbrs)))
            if s.check()==sat:
                m=s.model()
                mask=[[is_true(m.evaluate(A[r][c])) for c in range(W)] for r in range(H)]
                print('"'found roots',rootA,rootB,'size',H,W,'area',sum(sum(row) for row in mask), flush=True)
                for r in range(H):
                    print(''.join('A' if mask[r][c] else '.' for c in range(W)), flush=True)
                print(flush=True)
                return True
    return False

for dims in [(6,7),(7,7),(7,8),(8,8)]:
    print('search',dims, flush=True)
    ok=find(*dims)
    print('result',dims,ok, flush=True)
    if ok:
        break
