def analyze(mask):
    H=len(mask); W=len(mask[0])
    def comps(val):
        seen=[[False]*W for _ in range(H)]
        cnt=0
        for r in range(H):
            for c in range(W):
                if mask[r][c]"'!=val or seen[r][c]:
                    continue
                cnt+=1
                q=deque([(r,c)]); seen[r][c]=True
                while q:
