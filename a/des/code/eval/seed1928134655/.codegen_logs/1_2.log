import random, math
from collections import deque
H=W=8

def analyze(mask):
    def comps(val):
        seen=[[False]*W for _ in range(H)]
        cnt=0
        for r in range(H):
            for c in range(W):
                if mask[r][c]"'!=val or seen[r][c]:
                    continue
                cnt+=1
                q=deque([(r,c)]); seen[r][c]=True
                while q:
                    x,y=q.popleft()
                    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                        nx,ny=x+dx,y+dy
                        if 0<=nx<H and 0<=ny<W and mask[nx][ny]==val and not seen[nx][ny]:
                            seen[nx][ny]=True; q.append((nx,ny))
        return cnt
    ca=comps(True); cb=comps(False)
    score=(ca-1)*50 + (cb-1)*50
    for edge in [
        [(0,c) for c in range(W)],[(H-1,c) for c in range(W)],[(r,0) for r in range(H)],[(r,W-1) for r in range(H)]
    ]:
        vals=[mask[r][c] for r,c in edge]
        if not any(vals): score+=20
        if all(vals): score+=20
    area=sum(mask[r][c] for r in range(H) for c in range(W))
    if area==H*W-area: score+=3
    return score,ca,cb,area

best=None
for restart in range(200):
    mask=[[random.random()<0.5 for c in range(W)] for r in range(H)]
    score,ca,cb,area=analyze(mask)
    T=10.0
    for step in range(4000):
        if score==0:
            break
        r=random.randrange(H); c=random.randrange(W)
        mask[r][c]=not mask[r][c]
        nscore,nca,ncb,narea=analyze(mask)
        if nscore<score or random.random()<math.exp((score-nscore)/max(T,1e-6)):
            score,ca,cb,area=nscore,nca,ncb,narea
        else:
            mask[r][c]=not mask[r][c]
        T*=0.999
    score,ca,cb,area=analyze(mask)
    if best is None or score<best[0]:
        best=(score,[row[:] for row in mask],ca,cb,area)
        print('"'best',best[0],'restart',restart,'ca',ca,'cb',cb,'area',area, flush=True)
        for r in range(H):
            print(''.join('A' if best[1][r][c] else '.' for c in range(W)), flush=True)
        print(flush=True)
    if score==0:
        print('FOUND', flush=True)
        break
print('final',best[0],best[2],best[3],best[4], flush=True)
