import random
from collections import deque

def conn(mask, conn8=True):
    H=len(mask); W=len(mask[0])
    pts=[(r,c) for r in range(H) for c in range(W) if mask[r][c]]
    if not pts: return False
    dirs=[(1,0),(-1,0),(0,1),(0,-1)]
    if conn8:
        dirs += [(1,1),(1,-1),(-1,1),(-1,-1)]
    seen={pts[0]}; q=deque([pts[0]])
    while q:
        r,c=q.popleft()
        for dr,dc in dirs:
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and mask[nr][nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return len(seen)==len(pts)

def monotone(H,W):
    r=c=0
    cells={(0,0)}
    while r<H-1 or c<W-1:
        opts=[]
        if r<H-1: opts.append((r+1,c))
        if c<W-1: opts.append((r,c+1))
        r,c=random.choice(opts)
        cells.add((r,c))
    mask=[[False]*W for _ in range(H)]
    for r,c in cells: mask[r][c]=True
    return mask

for H,W in [(5,5),(5,7),(7,8)]:
    ok=0
    for _ in range(1000):
        A=monotone(H,W)
        B=[[not A[r][c] for c in range(W)] for r in range(H)]
        if conn(A,True) and conn(B,True):
            ok+=1
    print(H,W,ok)
