        A=grow(H,W,target)
        if len(A)"'!=target: continue
        Am=[[False]*W for _ in range(H)]
        for r,c in A: Am[r][c]=True
        ca,acells=ncomp(Am,H,W)
        if ca!=1: continue
        Bm=[[not Am[r][c] for c in range(W)] for r in range(H)]
        cb,bcells=ncomp(Bm,H,W)
        if cb!=1: continue
        if not bbox_full(acells[0],H,W): continue
        if not bbox_full(bcells[0],H,W): continue
        print('"'found size',H,W,'area',len(A),'attempt',attempt, flush=True)
        for r in range(H):
