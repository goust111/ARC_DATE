from z3 import *

def solve(H,W):
    A=[[Bool(f'a_{r}_{c}') for c in range(W)] for r in range(H)]
    s=Solver()
    # symmetry biases
    s.add(A[0][0])
    s.add(Not(A[0][W-1]))
    # both colors on every side
    for edge_cells in [
        [A[0][c] for c in range(W)],
        [A[H-1][c] for c in range(W)],
        [A[r][0] for r in range(H)],
        [A[r][W-1] for r in range(H)],
    ]:
        s.add(Or(edge_cells))
        s.add(Or([Not(x) for x in edge_cells]))
    # non-tie area for smaller-color rule uniqueness
    total=sum([If(A[r][c],1,0) for r in range(H) for c in range(W)])
    s.add(total "'!= H*W-total)
    # connectivity via distance-to-root with fixed roots in A and B
    maxd=H*W
    dA=[[Int(f'"'dA_{r}_{c}') for c in range(W)] for r in range(H)]
    dB=[[Int(f'dB_{r}_{c}') for c in range(W)] for r in range(H)]
    # fix roots at top-left for A and top-right for B
    for r in range(H):
        for c in range(W):
            s.add(Implies(A[r][c], And(dA[r][c] >= 0, dA[r][c] <= maxd)))
            s.add(Implies(Not(A[r][c]), dA[r][c] == -1))
            s.add(Implies(Not(A[r][c]), And(dB[r][c] >= 0, dB[r][c] <= maxd)))
            s.add(Implies(A[r][c], dB[r][c] == -1))
    s.add(dA[0][0] == 0)
    s.add(dB[0][W-1] == 0)
    for r in range(H):
        for c in range(W):
            if r==0 and c==0:
                continue
            nbrs=[]
            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                nr,nc=r+dr,c+dc
                if 0<=nr<H and 0<=nc<W:
                    nbrs.append(And(A[nr][nc], dA[nr][nc] < dA[r][c]))
            s.add(Implies(A[r][c], Or(nbrs)))
    for r in range(H):
        for c in range(W):
            if r==0 and c==W-1:
                continue
            nbrs=[]
            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                nr,nc=r+dr,c+dc
                if 0<=nr<H and 0<=nc<W:
                    nbrs.append(And(Not(A[nr][nc]), dB[nr][nc] < dB[r][c]))
            s.add(Implies(Not(A[r][c]), Or(nbrs)))
    if s.check()"'!=sat:
        print('"'unsat',H,W)
        return
    m=s.model()
    mask=[[is_true(m.evaluate(A[r][c])) for c in range(W)] for r in range(H)]
    area=sum(mask[r][c] for r in range(H) for c in range(W))
    print('sat',H,W,'area',area)
    for r in range(H):
        print(''.join('A' if mask[r][c] else '.' for c in range(W)))
    print()

for dims in [(4,4),(4,5),(5,5),(5,6),(6,6),(6,7)]:
    solve(*dims)
