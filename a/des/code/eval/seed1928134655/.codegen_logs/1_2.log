                        if 0<=nx<H and 0<=ny<W and mask[nx][ny]==val and not seen[nx][ny]:
                            seen[nx][ny]=True; q.append((nx,ny))
        return cnt
    score=0
    ca=comps(True); cb=comps(False)
    score += (ca-1)*20 + (cb-1)*20
    edges=[[(0,c) for c in range(W)],[(H-1,c) for c in range(W)],[(r,0) for r in range(H)],[(r,W-1) for r in range(H)]]
    for edge in edges:
        vals=[mask[r][c] for r,c in edge]
        if not any(vals): score+=10
        if all(vals): score+=10
    area=sum(mask[r][c] for r in range(H) for c in range(W))
    if area==H*W-area: score+=5
    return score,ca,cb,area

