import random
from collections import deque
H=W=8
allcells=[(r,c) for r in range(H) for c in range(W)]

def comp(mask,val):
    seen=[[False]*W for _ in range(H)]
    cells=[]
    for r in range(H):
        for c in range(W):
            if mask[r][c]"'!=val or seen[r][c]: continue
            q=deque([(r,c)]); seen[r][c]=True; cur=[]
            while q:
                x,y=q.popleft(); cur.append((x,y))
                for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                    nx,ny=x+dx,y+dy
                    if 0<=nx<H and 0<=ny<W and mask[nx][ny]==val and not seen[nx][ny]:
                        seen[nx][ny]=True; q.append((nx,ny))
            cells.append(cur)
    return cells

def valid(path):
    mask=[[False]*W for _ in range(H)]
    for r,c in path: mask[r][c]=True
    ca=comp(mask,True)
    cb=comp(mask,False)
    if len(ca)!=1 or len(cb)!=1: return False
    for cells in (ca[0],cb[0]):
        rs=[r for r,c in cells]; cs=[c for r,c in cells]
        if min(rs)!=0 or max(rs)!=H-1 or min(cs)!=0 or max(cs)!=W-1:
            return False
    a=len(path)
    return a != H*W-a

for attempt in range(200000):
    start=random.choice(allcells)
    path=[start]; used={start}
    # grow random path
    for _ in range(random.randint(18,32)):
        r,c=path[-1]
        nbr=[(r+dr,c+dc) for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)) if 0<=r+dr<H and 0<=c+dc<W and (r+dr,c+dc) not in used]
        # prefer boundary-touching new cells if missing edges
        if not nbr: break
        edges={
            '"'top': any(rr==0 for rr,cc in path),
            'bottom': any(rr==H-1 for rr,cc in path),
            'left': any(cc==0 for rr,cc in path),
            'right': any(cc==W-1 for rr,cc in path),
        }
        need=[]
        if not edges['top']: need.extend([p for p in nbr if p[0]==0])
        if not edges['bottom']: need.extend([p for p in nbr if p[0]==H-1])
        if not edges['left']: need.extend([p for p in nbr if p[1]==0])
        if not edges['right']: need.extend([p for p in nbr if p[1]==W-1])
        if need and random.random()<0.8:
            nxt=random.choice(need)
        else:
            nxt=random.choice(nbr)
        path.append(nxt); used.add(nxt)
        if len(path)>=18 and valid(path):
            print('found attempt',attempt,'len',len(path))
            mask=[[False]*W for _ in range(H)]
            for r,c in path: mask[r][c]=True
            for r in range(H):
                print(''.join('A' if mask[r][c] else '.' for c in range(W)))
            raise SystemExit
print('none')
