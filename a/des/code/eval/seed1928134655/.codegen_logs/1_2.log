+    if height >= width:
+        for r in range(height):
+            if style == 0:
+                c = int(round(r * (width - 1) / max(1, height - 1)))
+            elif style == 1:
+                c = int((r * (width - 1)) // max(1, height - 1))
+            else:
+                c = int(-(-r * (width - 1) // max(1, height - 1)))
+            mask[r, c] = True
+    else:
+        for c in range(width):
