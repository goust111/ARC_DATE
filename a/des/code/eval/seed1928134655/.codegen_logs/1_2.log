import random
from collections import deque

def ncomp(mask,H,W):
    seen=[[False]*W for _ in range(H)]
    count=0; cells=[]
    for r in range(H):
        for c in range(W):
            if not mask[r][c] or seen[r][c]:
                continue
            count+=1
            q=deque([(r,c)]); seen[r][c]=True; cur=[]
            while q:
                x,y=q.popleft(); cur.append((x,y))
                for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                    nx,ny=x+dx,y+dy
                    if 0<=nx<H and 0<=ny<W and mask[nx][ny] and not seen[nx][ny]:
                        seen[nx][ny]=True; q.append((nx,ny))
            cells.append(cur)
    return count,cells

def bbox_full(cells,H,W):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    return min(rs)==0 and max(rs)==H-1 and min(cs)==0 and max(cs)==W-1

def grow(H,W,target):
    allcells=[(r,c) for r in range(H) for c in range(W)]
    seed=random.choice(allcells)
    A={seed}
    frontier=[]
    in_front=set()
    def add_front(cell):
        r,c=cell
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and (nr,nc) not in A and (nr,nc) not in in_front:
                frontier.append((nr,nc)); in_front.add((nr,nc))
    add_front(seed)
    while len(A)<target and frontier:
        idx=random.randrange(len(frontier)); cell=frontier.pop(idx); in_front.remove(cell)
        A.add(cell); add_front(cell)
    return A

