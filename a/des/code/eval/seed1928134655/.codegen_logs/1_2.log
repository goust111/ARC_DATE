import random
from collections import deque

def comp(mask):
    H=len(mask); W=len(mask[0])
    seen=[[False]*W for _ in range(H)]
    cnt=0; cells=[]
    for r in range(H):
        for c in range(W):
            if not mask[r][c] or seen[r][c]:
                continue
            cnt+=1
            q=deque([(r,c)]); seen[r][c]=True; cur=[]
            while q:
                x,y=q.popleft(); cur.append((x,y))
                for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                    nx,ny=x+dx,y+dy
                    if 0<=nx<H and 0<=ny<W and mask[nx][ny] and not seen[nx][ny]:
                        seen[nx][ny]=True; q.append((nx,ny))
            cells.append(cur)
    return cnt,cells

def bbox_full(cells,H,W):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    return min(rs)==0 and max(rs)==H-1 and min(cs)==0 and max(cs)==W-1

def maze(mh,mw):
    H,W=2*mh+1,2*mw+1
    g=[[0]*W for _ in range(H)]  # 0 wall, 1 corridor
    cells=[(r,c) for r in range(mh) for c in range(mw)]
    stack=[random.choice(cells)]
    seen={stack[0]}
    while stack:
        r,c=stack[-1]
        gr,gc=2*r+1,2*c+1
        g[gr][gc]=1
        nbr=[]
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<mh and 0<=nc<mw and (nr,nc) not in seen:
                nbr.append((nr,nc,dr,dc))
        if nbr:
            nr,nc,dr,dc=random.choice(nbr)
            seen.add((nr,nc)); stack.append((nr,nc))
            g[gr+dr][gc+dc]=1
            g[2*nr+1][2*nc+1]=1
        else:
            stack.pop()
    # open all cell centers maybe tree already
    # edge openings on each side at existing corridor-adjacent odd coords
    top_choices=[c for c in range(1,W,2) if g[1][c]==1]
    bot_choices=[c for c in range(1,W,2) if g[H-2][c]==1]
    left_choices=[r for r in range(1,H,2) if g[r][1]==1]
    right_choices=[r for r in range(1,H,2) if g[r][W-2]==1]
    g[0][random.choice(top_choices)]=1
    g[H-1][random.choice(bot_choices)]=1
    g[random.choice(left_choices)][0]=1
    g[random.choice(right_choices)][W-1]=1
    return g

for mh,mw in [(2,2),(2,3),(3,3),(3,4)]:
    ok=0
    for _ in range(1000):
        g=maze(mh,mw)
        H,W=len(g),len(g[0])
        A=[[cell==1 for cell in row] for row in g]
        B=[[not cell for cell in row] for row in A]
        ca,ac=comp(A); cb,bc=comp(B)
        if ca==1 and cb==1 and bbox_full(ac[0],H,W) and bbox_full(bc[0],H,W):
            ok+=1
            if ok<=3:
                print('maze ok',mh,mw)
                for r in range(H):
                    print(''.join('A' if A[r][c] else '.' for c in range(W)))
                print()
    print('ok count',ok,'for',mh,mw)
