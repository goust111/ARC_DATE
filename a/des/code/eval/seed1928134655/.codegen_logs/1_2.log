from collections import deque

def comp(mask):
    H=len(mask); W=len(mask[0])
    seen=[[False]*W for _ in range(H)]
    cnt=0; cells=[]
    for r in range(H):
        for c in range(W):
            if not mask[r][c] or seen[r][c]: continue
            cnt+=1
            q=deque([(r,c)]); seen[r][c]=True; cur=[]
            while q:
                x,y=q.popleft(); cur.append((x,y))
                for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                    nx,ny=x+dx,y+dy
                    if 0<=nx<H and 0<=ny<W and mask[nx][ny] and not seen[nx][ny]:
                        seen[nx][ny]=True; q.append((nx,ny))
            cells.append(cur)
    return cnt,cells

def bbox_full(cells,H,W):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    return min(rs)==0 and max(rs)==H-1 and min(cs)==0 and max(cs)==W-1

def spiral(n):
    g=[[False]*n for _ in range(n)]
    top,left=0,0
    bottom,right=n-1,n-1
    while top<=bottom and left<=right:
        for c in range(left,right+1): g[top][c]=True
        top+=2
        if top>bottom: break
        for r in range(top-1,bottom+1): g[r][right]=True
        right-=2
        if left>right: break
        for c in range(right+1,left-1,-1): g[bottom][c]=True
        bottom-=2
        if top>bottom: break
        for r in range(bottom+1,top-1,-1): g[r][left]=True
        left+=2
    return g

for n in range(5,13):
