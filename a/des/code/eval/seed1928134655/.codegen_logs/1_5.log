+    for r in range(h):
+        for c in range(w):
+            if visited[r, c] or not bool(mask[r, c]):
+                continue
+            visited[r, c] = True
+            stack = [(r, c)]
+            comp = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((int(rr), int(cc)))
+                for dr, dc in neigh:
