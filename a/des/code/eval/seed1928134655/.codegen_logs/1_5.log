+        locks.append(
+            {
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "indicator_pos": indicator_pos,
+                "indicator_color": indicator_color,
+                "inner_mask": inner_mask,
+                "inner_origin": (int(r0 + inner_r0), int(c0 + inner_c0)),
+                "inner_shape": (int(inner_h), int(inner_w)),
