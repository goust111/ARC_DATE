+
+        placed_key = np.rot90(item["key_mask_input"], item["rotation_to_fit"])
+        kh, kw = placed_key.shape
+        out[inner_r0 : inner_r0 + kh, inner_c0 : inner_c0 + kw][placed_key] = int(item["color"])
