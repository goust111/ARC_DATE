+    cols = np.where(mask.any(axis=0))[0]
+    assert rows.size > 0 and cols.size > 0
+    r0 = int(rows[0])
+    r1 = int(rows[-1])
+    c0 = int(cols[0])
+    c1 = int(cols[-1])
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy(), r0, c0
