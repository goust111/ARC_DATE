+
+def _place_patch(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int) -> None:
+    mask = patch != bg
+    target = grid[r0 : r0 + patch.shape[0], c0 : c0 + patch.shape[1]]
+    target[mask] = patch[mask]
+
