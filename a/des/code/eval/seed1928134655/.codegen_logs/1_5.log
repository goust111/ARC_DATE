+    locks = []
+    indicator_positions: set[tuple[int, int]] = set()
+    indicator_colors = set()
+
+    for comp in grey_comps:
+        r0, c0, r1, c1 = comp["bbox"]
+        assert r1 + 1 < h and c1 + 1 < w, "indicator pixel must fit at lower-right exterior"
