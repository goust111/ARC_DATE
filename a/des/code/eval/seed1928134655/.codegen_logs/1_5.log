+
+def _find_color_components(
+    grid: np.ndarray,
+    excluded: set[int] | None = None,
+    colors: set[int] | None = None,
+    connectivity: int = 8,
+) -> list[dict]:
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
