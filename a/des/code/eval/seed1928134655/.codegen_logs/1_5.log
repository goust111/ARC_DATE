+def _can_place(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int, pad: int) -> bool:
+    h, w = grid.shape
+    ph, pw = patch.shape
+    if r0 < 0 or c0 < 0 or r0 + ph > h or c0 + pw > w:
+        return False
+    for rr, cc in np.argwhere(patch != bg):
+        gr = int(r0 + rr)
+        gc = int(c0 + cc)
+        r1 = max(0, gr - pad)
+        r2 = min(h, gr + pad + 1)
+        c1 = max(0, gc - pad)
