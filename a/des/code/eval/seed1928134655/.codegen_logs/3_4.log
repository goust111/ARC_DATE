+    return [(int(r0), int(c0)) for r0, c0 in positions if (r0, c0) is not None]
+
+
+def _sample_votes(
+    rng: np.random.Generator,
+    branch: str,
+) -> tuple[list[int], tuple[int, ...]]:
+    if branch == "majority":
+        counts = tuple(int(v) for v in MAJORITY_PATTERNS[int(rng.integers(0, len(MAJORITY_PATTERNS)))])
+    else:
