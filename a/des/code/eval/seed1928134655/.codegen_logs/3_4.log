+
+
+def _draw_frame(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int, gap: tuple[int, int]) -> None:
+    for r, c in _perimeter_coords(r0, c0, r1, c1):
+        if (int(r), int(c)) != (int(gap[0]), int(gap[1])):
