+    for comp in _components(grey_mask):
+        rs = [r for r, _c in comp]
+        cs = [c for _r, c in comp]
+        r0, r1 = min(rs), max(rs)
+        c0, c1 = min(cs), max(cs)
+        if r1 - r0 < 4 or c1 - c0 < 4:
+            continue
+
+        perimeter = set(_perimeter_coords(r0, c0, r1, c1))
+        coords = set(comp)
+        if not coords.issubset(perimeter):
