+            patch[::2, :] = int(fill_color)
+        else:
+            patch[:, ::2] = int(fill_color)
+        out[r0 + 1 : r1, c0 + 1 : c1] = patch
+
+    return out
+
+
+# --------------- generator ---------------
+
+GRID_H_RANGE = (18, 31)
+GRID_W_RANGE = (18, 31)
+N_RECTS_RANGE = (2, 6)
+INNER_SIDE_RANGE = (3, 7)
+PLACEMENT_PAD = 2
+MAX_ATTEMPTS = 400
