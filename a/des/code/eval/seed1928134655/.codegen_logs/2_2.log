+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(coords)
+    return out
+
+
+def _extract_objects(grid: np.ndarray) -> list[dict[str, int | tuple[int, int, int, int] | str]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    comps = _components(g[1:-1, 1:-1] != 0)
+    objects: list[dict[str, int | tuple[int, int, int, int] | str]] = []
+    for comp in comps:
+        rows = [r + 1 for r, _c in comp]
+        cols = [c + 1 for _r, c in comp]
+        r0, r1 = min(rows), max(rows)
+        c0, c1 = min(cols), max(cols)
+        color = int(g[rows[0], cols[0]])
+        patch = g[r0 : r1 + 1, c0 : c1 + 1]
+        assert np.all(patch == color)
+        hh = int(r1 - r0 + 1)
+        ww = int(c1 - c0 + 1)
+        assert hh % 2 == 1 and ww % 2 == 1
+        touches = []
+        if r0 == 1:
+            touches.append("top")
+        if r1 == h - 2:
+            touches.append("bottom")
+        if c0 == 1:
+            touches.append("left")
+        if c1 == w - 2:
+            touches.append("right")
+        assert len(touches) == 1
+        objects.append(
+            {
+                "color": color,
+                "r0": r0,
+                "c0": c0,
+                "r1": r1,
+                "c1": c1,
+                "h": hh,
+                "w": ww,
+                "area": hh * ww,
+                "side": touches[0],
+            }
+        )
+    return objects
+
+
+def _label_color(grid: np.ndarray, obj: dict[str, int | tuple[int, int, int, int] | str]) -> int:
+    g = np.asarray(grid, dtype=int)
