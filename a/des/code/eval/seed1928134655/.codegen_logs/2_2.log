+    r0, c0, r1, c1 = int(obj["r0"]), int(obj["c0"]), int(obj["r1"]), int(obj["c1"])
+    if side == "top":
+        vals = np.unique(g[0, c0 : c1 + 1])
+    elif side == "bottom":
+        vals = np.unique(g[g.shape[0] - 1, c0 : c1 + 1])
+    elif side == "left":
+        vals = np.unique(g[r0 : r1 + 1, 0])
+    else:
+        vals = np.unique(g[r0 : r1 + 1, g.shape[1] - 1])
