import random
import numpy as np

p = Path('/home/lixinyu/snap/a/des/seed1928134655/1/7.py')
mod = SourceFileLoader('dbg_arc_task', str(p)).load_module()

for trial in range(10):
    h = random.randint(mod.MIN_GRID_SIZE, mod.MAX_GRID_SIZE)
    w = random.randint(mod.MIN_GRID_SIZE, mod.MAX_GRID_SIZE)
    bg, wall = random.sample(mod.PALETTE, 2)
    grid = np.full((h, w), bg, dtype=int)
    outer_h = random.randint(10, h - 4)
    outer_w = random.randint(10, w - 4)
    outer_r0 = random.randint(2, h - outer_h - 2)
    outer_c0 = random.randint(2, w - outer_w - 2)
    outer = (outer_r0, outer_c0, outer_r0 + outer_h - 1, outer_c0 + outer_w - 1)
    mod._draw_rectangle(grid, outer, wall)
    depth = random.choice([1, 2])
    parent = outer
    ok = True
    info = {'trial': trial, 'h':h, 'w':w, 'outer':outer, 'depth':depth}
    for level in range(depth):
        child = mod._sample_child_bbox(parent)
        info[f'child{level}'] = child
        if child is None:
            ok = False
            info['fail'] = 'child_none'
            break
        mod._draw_rectangle(grid, child, wall)
        side = mod._draw_bridge(grid, parent, child, wall)
        info[f'side{level}'] = side
        parent = child
    if not ok:
        print(info)
        continue
    comps, labels = mod._components(grid == bg)
    info['ncomp'] = len(comps)
    info['ext'] = sum(mod._touches_edge(comp, h, w) for comp in comps)
    info['sizes'] = [len(comp) for comp in comps]
    print(info)
