+import random
+from collections import Counter
+
+import numpy as np
+
+
+PALETTE = tuple(range(10))
+MIN_GRID_SIZE = 16
+MAX_GRID_SIZE = 24
+MIN_RECT_SIZE = 5
+MIN_GAP = 2
+MAX_GAP = 5
