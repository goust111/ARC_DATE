+import numpy as np
+
+
+BG = 0
+WALL = 5
+TOWER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+EDGES = ("top", "bottom", "left", "right")
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
