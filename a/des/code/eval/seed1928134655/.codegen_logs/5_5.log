+
+def _parse_legend(grid: np.ndarray) -> tuple[str, dict[int, int], dict[int, tuple[int, int]], np.ndarray]:
+    candidates = _legend_candidates(grid)
+    assert len(candidates) == 1, "expected exactly one valid legend edge"
