+def _legend_candidates(grid: np.ndarray) -> list[tuple[str, dict[int, int], dict[int, tuple[int, int]], np.ndarray]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    candidates = []
