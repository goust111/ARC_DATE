+def _block_flags(n_links: int) -> list[bool]:
+    flags = [random.random() < 0.55 for _ in range(n_links)]
+    if n_links >= 2:
+        if not any(flags):
+            flags[random.randrange(n_links)] = True
+        if all(flags):
+            flags[random.randrange(n_links)] = False
+    return flags
