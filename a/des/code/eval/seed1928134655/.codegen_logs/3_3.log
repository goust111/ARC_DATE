+
+    for src, dst in zip(towers, towers[1:]):
+        if src["r0"] == dst["r0"]:
+            r0 = src["r0"]
+            c0 = min(src["c0"], dst["c0"])
+            c1 = max(src["c0"], dst["c0"])
+            reserve[max(1, r0 - 2) : min(h, r0 + 4), max(0, c0 - 1) : min(w, c1 + 3)] = True
+        else:
+            c0 = src["c0"]
+            r0 = min(src["r0"], dst["r0"])
+            r1 = max(src["r0"], dst["r0"])
