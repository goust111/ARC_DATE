+    for bc in range(col + 1, grid.shape[1]):
+        if (
+            _clear_horizontal(grid, pre_r, col, bc)
+            and _clear_vertical(grid, bc, top, bottom)
+            and _clear_horizontal(grid, after_r, bc, col)
