            if not owners[r][c - 1] or not owners[r][c + 1]:
                continue
            if owner in owners[r][c - 1] or owner in owners[r][c + 1]:
                continue

            rr = r
            while in_bounds(rr) and keep[rr, c] and owners[rr][c] == {owner}:
                keep[rr, c] = False
                rr += away_step

    return keep


