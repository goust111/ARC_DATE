+def _room_objects(
+    g: np.ndarray, interior: tuple[int, int, int, int], marker: tuple[int, int]
+) -> list[tuple[int, list[tuple[int, int]]]]:
+    r0, c0, r1, c1 = interior
+    visited: set[tuple[int, int]] = set()
