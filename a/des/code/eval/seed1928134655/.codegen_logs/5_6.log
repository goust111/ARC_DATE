    top_h = random.randint(_BAND_SIZE_MIN, _BAND_SIZE_MAX)
    bot_h = random.randint(_BAND_SIZE_MIN, _BAND_SIZE_MAX)
    left_w = random.randint(_BAND_SIZE_MIN, _BAND_SIZE_MAX)
