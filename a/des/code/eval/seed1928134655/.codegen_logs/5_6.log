+
+def _arrow_cells(frame: tuple[int, int, int, int], side: str) -> tuple[tuple[int, int], ...]:
+    r0, c0, r1, c1 = frame
+    mid_r = (r0 + r1) // 2
+    mid_c = (c0 + c1) // 2
+    if side == "top":
