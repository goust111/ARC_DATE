+def _push_info(
+    coords: list[tuple[int, int]], side: str, interior: tuple[int, int, int, int]
+) -> tuple[int, int, int]:
+    r0, c0, r1, c1 = interior
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    if side == "top":
+        return 1, 0, r1 - max(rows)
+    if side == "bottom":
