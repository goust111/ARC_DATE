+import numpy as np
+
+
+BG = 0
+SEP = 9
+ARC_MAX = 30
+GEN_RETRIES = 500
+CORNER_MODES = ("TL", "TR", "BL", "BR")
+PALETTE = tuple(c for c in range(10) if c not in (BG, SEP))
+OBJECT_COUNT_RANGE = (2, 4)
+TOP_SIZE_RANGE = (2, 4)
+EXTRA_MAX = 3
