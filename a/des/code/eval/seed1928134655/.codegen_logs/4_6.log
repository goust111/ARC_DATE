+def _segments(line: np.ndarray) -> list[tuple[int, int]]:
+    idx = np.flatnonzero(line)
+    if idx.size == 0:
+        return []
+    segs: list[tuple[int, int]] = []
+    start = prev = int(idx[0])
+    for value in idx[1:]:
+        cur = int(value)
+        if cur == prev + 1:
+            prev = cur
+            continue
+        segs.append((start, prev))
+        start = prev = cur
+    segs.append((start, prev))
+    return segs
