+def _pattern_index(seed_r: int, seed_c: int, r: int, c: int, direction: str) -> tuple[int, int]:
+    if direction in ("TL", "TR"):
+        pr = (seed_r - r) % 3
+    else:
+        pr = (r - seed_r) % 3
+
+    if direction in ("TL", "BL"):
+        pc = (seed_c - c) % 3
+    else:
+        pc = (c - seed_c) % 3
+
+    return pr, pc
