+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MAROON = 9
+SEED_COLORS = [1, 2, 3, 4, 6, 7, 8]
+CORNERS = ("TL", "TR", "BL", "BR")
+BRANCHES = ("TL", "TR", "BL", "BR", "CENTER")
+
+RECT_COUNT_RANGE = (2, 5)
+INNER_H_RANGE = (5, 11)
+INNER_W_RANGE = (5, 11)
+MAX_GENERATION_ATTEMPTS = 400
