+    if len(_find_frames(grid, GREY)) != n_rects:
+        return None
+    if len(_parse_dictionary(grid)) != n_rects:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
