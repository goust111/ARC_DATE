+        "TR": r * r + (w - 1 - c) * (w - 1 - c),
+        "BL": (h - 1 - r) * (h - 1 - r) + c * c,
+        "BR": (h - 1 - r) * (h - 1 - r) + (w - 1 - c) * (w - 1 - c),
