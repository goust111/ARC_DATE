+        idx = order[i]
+        local = sorted(
+            candidates[idx],
+            key=lambda cand: (-_bit_count(int(cand["bits"]) & ~covered), tuple(cand["pos"])),
+        )
+        for cand in local:
+            new_covered = int(covered | int(cand["bits"]))
+            if (new_covered | suffix_union[i + 1]) != union_bits:
+                continue
+            picks[i] = cand
+            dfs(i + 1, new_covered)
+            if len(solutions) >= max_solutions:
+                return
+        picks[i] = None
+
+    dfs(0, 0)
+    return solutions
