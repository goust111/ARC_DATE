+def _solve_placements(
+    canvas_black: np.ndarray, shapes: list[np.ndarray], max_solutions: int = 2
+) -> list[list[tuple[int, int]]]:
+    h, w = canvas_black.shape
+    union_bits = 0
+    for idx, value in enumerate(canvas_black.ravel()):
+        if bool(value):
+            union_bits |= 1 << idx
