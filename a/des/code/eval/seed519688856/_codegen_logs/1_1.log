+    positions = []
+    cursor = strip_r0
+    for shape in legend_shapes:
+        c = legend_c0 + (strip_w - shape.shape[1]) // 2
+        positions.append((int(cursor), int(c)))
+        cursor += int(shape.shape[0]) + gap
+    return (int(height), int(width)), (int(grid_r0), int(grid_c0)), positions
