+) -> tuple[tuple[int, int], tuple[int, int], list[tuple[int, int]]]:
+    grid_h = n_rows * cell_size + (n_rows + 1)
+    grid_w = n_cols * cell_size + (n_cols + 1)
+    gap = 2
