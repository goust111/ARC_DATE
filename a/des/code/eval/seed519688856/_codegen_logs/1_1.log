+            start = top + (cell_size - bridge_len) // 2
+            col = v_lines[gc + 1]
+            out[start : start + bridge_len, col] = BRIDGE_COLOR
+
+    for gr in range(n_rows - 1):
+        for gc in range(n_cols):
