+def _detect_grid(g: np.ndarray, bg: int) -> tuple[int, list[int], list[int], int]:
+    counts = Counter(map(int, g.ravel()))
+    candidates = [color for color, _count in counts.most_common() if color != bg]
+    for line_color in candidates:
