+    grid_w = n_cols * cell_size + (n_cols + 1)
+
+    for i in range(n_rows + 1):
+        rr = grid_r0 + i * (cell_size + 1)
+        grid[rr, grid_c0 : grid_c0 + grid_w] = GRID_COLOR
+    for j in range(n_cols + 1):
