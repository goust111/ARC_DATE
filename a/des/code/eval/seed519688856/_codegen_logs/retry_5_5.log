+    patch[mask] = GREY
+    if orientation == "top":
+        label_pos = (top + mask.shape[0], left + mask.shape[1] // 2)
+    else:
+        label_pos = (top + mask.shape[0] // 2, left + mask.shape[1])
+    grid[label_pos] = label_color
+    return label_pos
