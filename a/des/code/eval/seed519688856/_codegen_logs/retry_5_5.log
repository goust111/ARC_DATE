+
+def _vote_plan(colors: list[int], winner: int) -> list[int]:
+    others = [color for color in colors if color != winner]
+    _RNG.shuffle(others)
+    if len(colors) == 2:
+        return [winner] * 3 + [others[0]]
+    return [winner] * 3 + [others[0]] * 2 + [others[1]]
