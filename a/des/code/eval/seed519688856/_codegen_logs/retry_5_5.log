+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+GREEN = 3
+GREY = 5
+ORANGE = 7
+MAROON = 9
+VOTE_COLORS = (BLUE, GREEN, ORANGE)
