+        half_w = max(obj_w, tpl_w) // 2
+        candidates: list[tuple[int, int]] = []
+        for r in range(r_min + half_h, r_max - half_h + 1):
+            for c in range(c_min + half_w, c_max - half_w + 1):
+                rr0 = r - half_h - 1
+                cc0 = c - half_w - 1
+                rr1 = r + half_h + 1
+                cc1 = c + half_w + 1
