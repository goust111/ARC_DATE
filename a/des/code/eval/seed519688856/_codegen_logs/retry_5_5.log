+        object_specs.append(
+            {
+                "winner": winner,
+                "obj_mask": obj_mask,
+                "tpl_mask": template_masks[chosen_colors.index(winner)],
+                "votes": _vote_plan(chosen_colors, winner),
+            }
+        )
+
+    if orientation == "top":
+        min_w = sum(widths) + sum(gaps) + 4
+        w_low = max(24, min_w + 2)
+        w_high = w_low + 7
+        h_low = max(24, max_h + 18)
+        h_high = h_low + 6
+    else:
