+    if area_hi < area_lo:
+        area_hi = area_lo
+
+    for _ in range(POLY_TRIES):
+        target = int(rng.integers(area_lo, area_hi + 1))
+        start = (int(rng.integers(0, h)), int(rng.integers(0, w)))
+        cells = {start}
+        while len(cells) < target:
+            frontier: list[tuple[int, int]] = []
+            for r, c in cells:
