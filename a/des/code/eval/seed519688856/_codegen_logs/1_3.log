+
+    side, gap0, gap1 = gaps[0]
+    return {
+        "bbox": bbox,
+        "local_mask": mask,
+        "side": side,
+        "gap0": gap0,
+        "gap1": gap1,
+        "area": int(h * w),
+        "shape": (int(h), int(w)),
