+    if side in ("top", "bottom"):
+        left = int(round(gap_center - 0.5 * (pw - 1)))
+        top = int(h - 1 - ph) if side == "top" else 1
+    else:
+        top = int(round(gap_center - 0.5 * (ph - 1)))
+        left = int(w - 1 - pw) if side == "left" else 1
+    return int(top), int(left)
