+def _make_piece_mask(rng: np.random.Generator, h: int, w: int) -> np.ndarray:
+    area_lo = max(h + w - 1, int(np.ceil(0.45 * h * w)))
+    area_hi = max(area_lo, int(np.floor(0.72 * h * w)))
+    if area_hi >= h * w:
+        area_hi = h * w - 1
+    if area_hi < area_lo:
+        area_hi = area_lo
