+def _frame_patch(frame: dict, bg: int, include_piece: bool) -> np.ndarray:
+    h, w = frame["shape"]
+    color = int(frame["color"])
+    patch = np.full((h, w), bg, dtype=int)
+    patch[0, :] = color
+    patch[-1, :] = color
+    patch[:, 0] = color
+    patch[:, -1] = color
+    gap0 = int(frame["gap0"])
+    gap1 = int(frame["gap1"])
+    side = frame["side"]
+    if side == "top":
+        patch[0, gap0 : gap1 + 1] = bg
+    elif side == "bottom":
+        patch[-1, gap0 : gap1 + 1] = bg
+    elif side == "left":
+        patch[gap0 : gap1 + 1, 0] = bg
+    else:
