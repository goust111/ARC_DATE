+# --------------- generator ---------------
+
+BG = 8
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+DIRECTIONS = ["top", "bottom", "left", "right"]
+
+GRID_H_RANGE = (22, 31)
+GRID_W_RANGE = (22, 31)
+N_FRAMES_CHOICES = [2, 3]
+OVERLAP_PROB = 0.5
+FRAME_GAP = 1
+PIECE_GAP = 1
+MAX_GEN_TRIES = 400
+POLY_TRIES = 80
