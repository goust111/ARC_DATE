+GRID_H_RANGE = (22, 31)
+GRID_W_RANGE = (22, 31)
+N_FRAMES_CHOICES = [2, 3]
+OVERLAP_PROB = 0.5
+FRAME_GAP = 1
+PIECE_GAP = 1
