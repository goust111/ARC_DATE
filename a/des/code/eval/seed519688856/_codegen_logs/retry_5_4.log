+    interior_cells = (ch - 2) * (cw - 2)
+    target_nodes = random.randint(6, min(12, interior_cells + 2))
+    max_nodes = min(interior_cells + 2, target_nodes + random.randint(1, 4))
+
+    path = [start_inner]
+    visited = {start_inner}
+
+    def dfs(cur: tuple[int, int]) -> list[tuple[int, int]] | None:
+        if cur == end_inner:
