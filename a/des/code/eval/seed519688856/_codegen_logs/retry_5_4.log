+
+def _neighbors(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out = []
+    for dr, dc in DIRS4:
+        nr = r + dr
+        nc = c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            out.append((nr, nc))
+    return out
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _adjacent_path_cells(mask: np.ndarray, r0: int, c0: int, path_set: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    h, w = mask.shape
+    adj: set[tuple[int, int]] = set()
+    for rr in range(h):
+        for cc in range(w):
+            if not mask[rr, cc]:
+                continue
+            gr = r0 + rr
+            gc = c0 + cc
+            for dr, dc in DIRS4:
+                cell = (gr + dr, gc + dc)
+                if cell in path_set:
+                    adj.add(cell)
+    return adj
+
+
+def _apply_gates(shape: np.ndarray, gates: list[int]) -> np.ndarray:
+    out = shape.copy()
+    for color in gates:
+        if color == GREEN:
+            out = np.rot90(out, -1)
+        elif color == YELLOW:
+            out = np.fliplr(out)
+        elif color == MAGENTA:
+            out = np.flipud(out)
+        else:
+            raise AssertionError(color)
+    return out
+
