    inp = out.copy()
    for r, c in reflected:
        inp[r, c] = BG_COLOR

    if np.array_equal(main(inp), out):
        return inp
    return None


def generate_input():
    for _ in range(GEN_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
