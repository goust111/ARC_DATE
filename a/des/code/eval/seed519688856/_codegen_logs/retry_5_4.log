+def _count_turns(path: list[tuple[int, int]]) -> int:
+    turns = 0
+    for (r0, c0), (r1, c1), (r2, c2) in zip(path, path[1:], path[2:], strict=False):
+        d1 = (r1 - r0, c1 - c0)
+        d2 = (r2 - r1, c2 - c1)
+        if d1 != d2:
