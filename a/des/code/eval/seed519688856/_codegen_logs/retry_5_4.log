+            if not np.array_equal(main(grid), expected):
+                continue
+            return grid, expected
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        generated = _candidate_grid()
+        if generated is not None:
+            grid, _ = generated
+            return grid
