+def _monotone_path(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = start
+    tr, tc = end
+    path = [(r, c)]
+    while (r, c) != (tr, tc):
+        options = []
+        if r != tr:
+            options.append((r + (1 if tr > r else -1), c))
+        if c != tc:
+            options.append((r, c + (1 if tc > c else -1)))
+        r, c = random.choice(options)
+        path.append((r, c))
+    return path
+
