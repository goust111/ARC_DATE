+def _find_coarse_path(
+    ch: int,
+    cw: int,
+    start: tuple[int, int],
+    end: tuple[int, int],
+) -> list[tuple[int, int]] | None:
+    start_inner = _inward_neighbor(start, ch, cw)
+    end_inner = _inward_neighbor(end, ch, cw)
+    if start_inner == end_inner:
+        return None
