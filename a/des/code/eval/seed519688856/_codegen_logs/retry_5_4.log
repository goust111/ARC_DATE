+        cell
+        for cell in endpoints
+        if any(red_mask[nr, nc] for nr, nc in _neighbors(cell[0], cell[1], g.shape[0], g.shape[1]))
+    ]
+    end_candidates = [
+        cell
+        for cell in endpoints
+        if any(grey_mask[nr, nc] for nr, nc in _neighbors(cell[0], cell[1], g.shape[0], g.shape[1]))
+    ]
