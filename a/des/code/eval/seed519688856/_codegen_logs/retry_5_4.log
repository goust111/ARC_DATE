+        "top": [(0, c) for c in range(2, cw - 2)],
+        "bottom": [(ch - 1, c) for c in range(2, cw - 2)],
+        "left": [(r, 0) for r in range(2, ch - 2)],
+        "right": [(r, cw - 1) for r in range(2, ch - 2)],
