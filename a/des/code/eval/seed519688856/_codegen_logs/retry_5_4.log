+        return random.sample(list(GATE_COLORS), 2)
+    if count >= 3 and random.random() < 0.5:
+        colors = list(GATE_COLORS)
+        while len(colors) < count:
+            colors.append(random.choice(GATE_COLORS))
+        random.shuffle(colors)
+        return colors
