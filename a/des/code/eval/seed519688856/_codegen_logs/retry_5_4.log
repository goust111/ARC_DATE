+def _inward_neighbor(cell: tuple[int, int], ch: int, cw: int) -> tuple[int, int]:
+    r, c = cell
+    if r == 0:
+        return 1, c
+    if r == ch - 1:
+        return ch - 2, c
+    if c == 0:
