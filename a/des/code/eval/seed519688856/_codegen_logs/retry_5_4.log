+import random
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+AZURE = 8
+
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+PATH_COLORS = (AZURE, GREEN, YELLOW, MAGENTA)
+GATE_COLORS = (GREEN, YELLOW, MAGENTA)
+CORNER_TO_OFFSET = {
+    "TL": (0, 0),
+    "TR": (0, -1),
+    "BL": (-1, 0),
+    "BR": (-1, -1),
+}
+
+GEN_SIZE_CHOICES = (3, 4)
+GEN_COARSE_MIN = 6
+GEN_COARSE_MAX = 10
+GEN_MAX_ATTEMPTS = 500
+GEN_PATH_ATTEMPTS = 120
+GEN_SHAPE_ATTEMPTS = 120
+GEN_GATE_MARGIN = 2
