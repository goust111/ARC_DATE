+    for room in rooms:
+        patch = room["patch"]
+        ph, pw = patch.shape
+        placed = False
+        for _ in range(250):
+            r0 = rng.randint(2, h - ph - 2)
+            c0 = rng.randint(2, w - pw - 2)
