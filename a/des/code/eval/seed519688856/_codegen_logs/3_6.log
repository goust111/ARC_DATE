+
+
+def _make_straight_pair(h: int, w: int, color_a: int, color_b: int) -> dict | None:
+    horizontal = random.random() < 0.5
+    if horizontal:
+        max_gap = min(STRAIGHT_GAP_MAX, w - 2 * BLOCK)
