+    }
+
+
+def _make_elbow_pair(h: int, w: int, color_a: int, color_b: int) -> dict | None:
+    row_limit = min(ELBOW_OFFSET_MAX, h - BLOCK)
+    col_limit = min(ELBOW_OFFSET_MAX, w - BLOCK)
