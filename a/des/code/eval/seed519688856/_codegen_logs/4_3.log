+        if np.array_equal(patch, np.flipud(patch)):
+            continue
+        if np.array_equal(patch, np.fliplr(patch)):
+            continue
+        final_patch = _apply_markers(patch, marker_colors)
+        if np.array_equal(final_patch, patch):
