+        if any(grid[r, c] != BG for r, c in cells):
+            continue
+        grid[r0 : r0 + 3, c0 : c0 + 3] = patch
+        return True
+    return False
+
+
+def _symmetry_functions():
+    return [
+        lambda a: a.copy(),
+        lambda a: np.rot90(a, 1).copy(),
+        lambda a: np.rot90(a, 2).copy(),
+        lambda a: np.rot90(a, 3).copy(),
