+        lambda a: np.flipud(a).copy(),
+        lambda a: a.T.copy(),
+        lambda a: np.fliplr(a.T).copy(),
+    ]
+
+
+def _gen_attempt() -> np.ndarray | None:
+    height = random.randint(MIN_H, MAX_H)
+    width = random.randint(MIN_W, MAX_W)
