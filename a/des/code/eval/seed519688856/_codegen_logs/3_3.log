+    return None
+
+
+def _validate_generated(grid: np.ndarray, expected: dict[int, tuple[str, int | None]]) -> bool:
+    try:
+        arrows = _extract_arrows(grid)
+        rays = _compute_rays(arrows, grid.shape)
+    except AssertionError:
+        return False
