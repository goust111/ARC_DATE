+    if branch == "pair":
+        return (0, 1) in patterns and (1, 2) not in patterns and (0, 2) not in patterns and all(
+            len(p) <= 2 for p in patterns
+        )
+    if branch == "chain":
+        return (0, 1) in patterns and (1, 2) in patterns and (0, 2) not in patterns and all(
