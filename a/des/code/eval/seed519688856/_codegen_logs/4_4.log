+        r0 = wall_rows[rr] + 1
+        r1 = wall_rows[rr + 1] - 1
+        for cc in range(len(wall_cols) - 2):
+            wall_c = wall_cols[cc + 1]
+            openings = [r for r in range(r0, r1 + 1) if int(grid[r, wall_c]) != WALL]
+            assert len(openings) <= 1
