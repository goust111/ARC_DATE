+    rows = [int(r) for r, count in enumerate(counts) if int(count) > grid.shape[1] // 2]
+    assert rows and rows[0] == 0 and rows[-1] == grid.shape[0] - 1
+    assert all(b - a >= 2 for a, b in zip(rows, rows[1:]))
+    return rows
