+        color = colors[0]
+        mask = patch == color
+        rows, cols = np.where(mask)
+        top = int(rows.min())
+        bottom = int(rows.max())
+        left = int(cols.min())
+        right = int(cols.max())
+        height = bottom - top + 1
+        width = right - left + 1
