+    n_cols = rng.choice(ROOM_COLS_CHOICES)
+    room_heights = [rng.randint(ROOM_SIDE_MIN, ROOM_SIDE_MAX) for _ in range(n_rows)]
+    room_widths = [rng.randint(ROOM_SIDE_MIN, ROOM_SIDE_MAX) for _ in range(n_cols)]
