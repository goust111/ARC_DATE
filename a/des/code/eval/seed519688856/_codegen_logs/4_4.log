  "src": "small colored sprite s outside the frame",
  "dst": "hollow rectangular frame interior d",
  "match_cond": "unique s maps to unique d; s.bbox extremes align to d.bbox extremes",
  "transform": "clear s; stretch s into d by mapping bbox extremes, drawing 4-adjacent segments, and filling enclosed regions"
}
</annotation>
</reference_puzzle>

