+
+def _expand_rect(rect: tuple[int, int, int, int], pad: int, h: int, w: int) -> tuple[int, int, int, int]:
+    return (
+        max(0, rect[0] - pad),
+        max(0, rect[1] - pad),
+        min(h - 1, rect[2] + pad),
