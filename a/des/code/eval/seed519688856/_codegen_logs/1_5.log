+            dr = nb[0] - hub[0]
+            dc = nb[1] - hub[1]
+            ext = (nb[0] + dr, nb[1] + dc)
+            if 0 <= ext[0] < 3 and 0 <= ext[1] < 3 and ext not in nodes:
+                nodes.add(ext)
