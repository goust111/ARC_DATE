+    idx = 0
+    for rr, (r0, r1) in enumerate(row_ranges):
+        for cc, (c0, c1) in enumerate(col_ranges):
+            region_h = r1 - r0
+            region_w = c1 - c0
+            seed_h = random.randint(3, min(5, region_h - 2))
