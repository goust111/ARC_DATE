+                rows = [p[0] for p in union]
+                cols = [p[1] for p in union]
+                r0, r1 = min(rows), max(rows)
+                c0, c1 = min(cols), max(cols)
+                rect_h = r1 - r0 + 1
+                rect_w = c1 - c0 + 1
