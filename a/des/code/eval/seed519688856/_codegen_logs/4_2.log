+def _random_connected_subset(h: int, w: int, target_area: int) -> np.ndarray | None:
+    start = (int(_RNG.integers(h)), int(_RNG.integers(w)))
+    chosen = {start}
+    frontier = set(_neighbors4(start[0], start[1], h, w))
+    while len(chosen) < target_area:
