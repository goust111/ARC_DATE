+        if r_min > height - OUTER:
+            return None
+        r0 = int(rng.integers(r_min, height - OUTER + 1))
+        c0 = int(rng.integers(0, width - OUTER + 1))
+        src = _build_box(r0, c0, "up", src_template)
+        blk_dir = str(rng.choice(np.array(["up", "left", "right"], dtype=object)))
