+def _expanded_overlap(a: Box, b: Box, margin: int = 1) -> bool:
+    return not (
+        a.r1 + margin < b.r0
+        or b.r1 + margin < a.r0
+        or a.c1 + margin < b.c0
+        or b.c1 + margin < a.c0
+    )
