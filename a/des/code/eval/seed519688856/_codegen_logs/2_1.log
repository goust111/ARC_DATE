+
+BG = 0
+FRAME = 5
+INNER = 3
+OUTER = INNER + 2
+PALETTE = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)
+DIR_ORDER = ("up", "down", "left", "right")
+MAX_GENERATION_ATTEMPTS = 400
