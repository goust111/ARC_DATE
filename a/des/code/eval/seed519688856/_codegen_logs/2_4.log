+def _parse_legends(grid: np.ndarray) -> tuple[int, list[dict]]:
+    legend_w, sep_rows = _legend_layout(grid)
+    entries: list[dict] = []
+    for top, bottom in zip(sep_rows, sep_rows[1:]):
+        if bottom <= top + 1:
