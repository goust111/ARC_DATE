+        r0 = top + 1
+        r1 = bottom - 1
+        entry = grid[r0 : r1 + 1, :legend_w]
+        border_colors = [int(color) for color in np.unique(entry) if int(color) not in {BLACK, GREY, AZURE}]
+        assert len(border_colors) == 1, "each legend entry must have one fingerprint color"
