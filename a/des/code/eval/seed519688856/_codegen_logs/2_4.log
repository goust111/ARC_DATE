+    regions: list[dict] = []
+    for color, entries in by_color.items():
+        for coords in _components(grid == color):
+            box = _bbox(coords)
+            if box[3] < legend_w:
+                continue
+            local = _coords_to_mask(coords, box)
+            if not _mask_is_perimeter(local):
