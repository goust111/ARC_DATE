def _touch_side(
    r: int, c: int, square: tuple[int, int, int, int, int]
) -> str | None:
    r0, c0, r1, c1, _color = square
    if r0 <= r <= r1:
        if c == c0 - 1:
            return "left"
        if c == c1 + 1:
            return "right"
    if c0 <= c <= c1:
        if r == r0 - 1:
            return "above"
        if r == r1 + 1:
            return "below"
    return None


def _target_for_marker(
    r: int, c: int, side: str, square: tuple[int, int, int, int, int]
) -> tuple[int, int]:
    r0, c0, r1, c1, color = square
    if color == Color.PINK:
        if side in {"left", "right"}:
            return r, (c0 + c1) // 2
        return (r0 + r1) // 2, c

    assert color == Color.GREY
    if side == "left":
        return r, c0
    if side == "right":
        return r, c1
    if side == "above":
        return r0, c
    assert side == "below"
    return r1, c


