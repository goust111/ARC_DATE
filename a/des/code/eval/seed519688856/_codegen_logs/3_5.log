+            {
+                "color": color,
+                "direction": direction,
+                "group": group,
+                "rect_bbox": rect_bbox,
+                "small_spec": small_spec,
+            }
+        )
+
+    specs.sort(key=lambda item: item["group"].shape[0] * item["group"].shape[1], reverse=True)
+
+    grid = np.full((h, w), BLACK, dtype=int)
+    blocked = np.zeros((h, w), dtype=bool)
+    placed_any = False
+    for spec in specs:
+        group = np.asarray(spec["group"], dtype=int)
+        gh, gw = group.shape
+        if gh > h - 2 or gw > w - 2:
