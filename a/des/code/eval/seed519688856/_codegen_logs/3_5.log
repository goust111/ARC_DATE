+    rect_bbox: tuple[int, int, int, int], shape: np.ndarray, direction: str
+) -> tuple[int, int]:
+    r0, c0, r1, c1 = rect_bbox
+    rect_h = r1 - r0 + 1
+    rect_w = c1 - c0 + 1
+    shape_h, shape_w = shape.shape
+    assert shape_h <= rect_h and shape_w <= rect_w, "stamp must fit inside the rectangle"
+
