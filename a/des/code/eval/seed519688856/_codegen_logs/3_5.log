+
+BLACK = 0
+MAROON = 9
+PALETTE = (1, 2, 3, 4, 5, 6, 7, 8)
+GEN_RETRIES = 400
+
+DIRECTIONS = (
+    "up_left",
+    "up",
+    "up_right",
+    "left",
+    "right",
+    "down_left",
+    "down",
+    "down_right",
