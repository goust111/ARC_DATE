+
+def _direction_from_centers(small_coords: np.ndarray, big_coords: np.ndarray) -> str:
+    sr, sc = float(small_coords[:, 0].mean()), float(small_coords[:, 1].mean())
+    br, bc = float(big_coords[:, 0].mean()), float(big_coords[:, 1].mean())
+    dr = sr - br
