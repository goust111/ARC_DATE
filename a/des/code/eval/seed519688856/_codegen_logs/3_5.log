+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != BLACK):
+        comps = _components4(grid == color)
+        assert len(comps) == 2, "each foreground color must form exactly one pair"
+        infos: list[dict[str, object]] = []
+        for coords in comps:
