+        outer_h = inner_h + 2
+        outer_w = inner_w + 2
+
+        placed = False
+        for _ in range(ROOM_PLACE_ATTEMPTS):
+            r0 = rng.randint(1, h - outer_h - 1)
+            c0 = rng.randint(1, w - outer_w - 1)
