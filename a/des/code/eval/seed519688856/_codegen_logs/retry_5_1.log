+def _draw_room(grid: np.ndarray, r0: int, c0: int, inner_h: int, inner_w: int) -> None:
+    outer_h = inner_h + 2
+    outer_w = inner_w + 2
+    grid[r0 : r0 + outer_h, c0 : c0 + outer_w] = GREY
+    grid[r0 + 1 : r0 + 1 + inner_h, c0 + 1 : c0 + 1 + inner_w] = BLACK
+
