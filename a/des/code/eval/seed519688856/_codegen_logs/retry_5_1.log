+def _reserve(mask: np.ndarray, r0: int, c0: int, r1: int, c1: int) -> bool:
+    h, w = mask.shape
+    rr0 = max(0, r0 - 1)
+    cc0 = max(0, c0 - 1)
+    rr1 = min(h, r1 + 2)
+    cc1 = min(w, c1 + 2)
+    if mask[rr0:rr1, cc0:cc1].any():
+        return False
+    mask[rr0:rr1, cc0:cc1] = True
+    return True
