7: def main(grid: np.ndarray) -> np.ndarray:
8:     """
9:     Complete the scene by adding the point-reflected copy of the colored object across the central marker.
10: 
11:     Input structure
12:     - The grid has odd dimensions, a dominant background, and a center-row marker color appearing only at the left edge, center, and right edge.
13:     - A single divider color fills the center column except for the center marker.
14:     - All remaining foreground pixels form the object to copy, entirely on the left side of the divider.
15:     Rule
16:     - Keep the input unchanged.
17:     - For every object pixel, paint the pixel rotated 180 degrees around the center marker with the same color.
18:     Key insight
19:     - The center marker is the rotation center; the yellow-looking divider is not mirrored, it only separates the source from the empty target side.
20:     """
21:     g = np.asarray(grid, dtype=int)
22:     assert g.ndim == 2
23:     h, w = g.shape
24:     assert h % 2 == 1 and w % 2 == 1
25: 
26:     cr, cc = h // 2, w // 2
27:     bg = int(get_bg(g))
28: 
29:     marker_color = int(g[cr, cc])
30:     assert marker_color != bg
31:     marker_mask = g == marker_color
32:     expected_markers = np.zeros(g.shape, dtype=bool)
33:     expected_markers[cr, 0] = True
34:     expected_markers[cr, cc] = True
35:     expected_markers[cr, w - 1] = True
36:     assert np.array_equal(marker_mask, expected_markers)
37: 
38:     center_col = g[:, cc]
39:     divider_colors = {int(color) for color in np.unique(center_col) if int(color) != marker_color}
40:     assert len(divider_colors) == 1
41:     divider_color = next(iter(divider_colors))
42:     assert divider_color != bg
43:     expected_divider = np.zeros(g.shape, dtype=bool)
44:     expected_divider[:, cc] = True
45:     expected_divider[cr, cc] = False
46:     assert np.array_equal(g == divider_color, expected_divider)
47: 
48:     source_mask = (g != bg) & (g != marker_color) & (g != divider_color)
49:     source_coords = np.argwhere(source_mask)
50:     assert source_coords.size > 0
51:     assert np.all(source_coords[:, 1] < cc)
52: 
53:     out = g.copy()
54:     for r, c in source_coords:
55:         rr = 2 * cr - int(r)
56:         rc = 2 * cc - int(c)
57:         assert 0 <= rr < h and 0 <= rc < w
58:         assert out[rr, rc] == bg
59:         out[rr, rc] = g[r, c]
60: 
61:     return out
