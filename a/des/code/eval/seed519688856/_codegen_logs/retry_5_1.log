+        transformed = out[r0 + 1 : r0 + 1 + inner_h, c0 + 1 : c0 + 1 + inner_w]
+        fill = FILL_BY_SYMMETRY[symmetry]
+        if not np.all(transformed[inside == BLACK] == fill):
+            return None
+        if not np.all(transformed[inside == RED] == RED):
