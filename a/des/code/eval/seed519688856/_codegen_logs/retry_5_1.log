+        if not red_cells:
+            continue
+        sr0, sc0, sr1, sc1 = _bbox(red_cells)
+        seed_mask = np.zeros((sr1 - sr0 + 1, sc1 - sc0 + 1), dtype=bool)
+        for r, c in red_cells:
+            seed_mask[r - sr0, c - sc0] = True
+        symmetry = _classify_symmetry(seed_mask)
