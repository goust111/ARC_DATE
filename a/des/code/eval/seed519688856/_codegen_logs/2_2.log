+        out[coords[:, 0], coords[:, 1]] = bg
+        fragments_by_slot[color_to_slot[color]].append(
+            {
+                "color": color,
+                "patch": patch,
+                "left": int(comp["bbox"][1]),
+                "top": int(comp["bbox"][0]),
+            }
+        )
