+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c]:
+                continue
+            color = int(g[r, c])
+            if color in blocked:
+                seen[r, c] = True
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in N4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "area": int(arr.shape[0]),
+                    "bbox": (
+                        int(arr[:, 0].min()),
+                        int(arr[:, 1].min()),
+                        int(arr[:, 0].max()),
+                        int(arr[:, 1].max()),
+                    ),
+                }
+            )
+    return comps
