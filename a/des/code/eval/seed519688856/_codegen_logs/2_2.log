+def _random_positive_partition(total: int, parts: int) -> list[int]:
+    if parts == 1:
+        return [int(total)]
+    cuts = np.sort(RNG.choice(np.arange(1, total), size=parts - 1, replace=False))
+    vals = np.diff(np.concatenate(([0], cuts, [total])))
+    return [int(v) for v in vals]
