+
+def _interval_choices(height: int, prev: tuple[int, int]) -> list[tuple[int, int]]:
+    low, high = prev
+    choices: list[tuple[int, int]] = []
+    for a in range(height):
+        for b in range(a, height):
+            if not (b < low or a > high):
