0104: def _sample_counts(rng: np.random.Generator, n_frames: int, total_match: int) -> list[int]:
0105:     """Distribute total_match sprites across n_frames, each capped at MAX_DOTS_PER_FRAME."""
0106:     counts = [0] * n_frames
0107:     order = rng.permutation(n_frames)
0108:     remaining = total_match
