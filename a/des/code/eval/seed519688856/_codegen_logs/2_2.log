+        prev = _interval_choices(height, prev)[int(RNG.integers(0, len(_interval_choices(height, prev))))]
+        intervals[c] = prev
+    mask = np.zeros((height, width), dtype=bool)
+    for c, interval in enumerate(intervals):
+        a, b = interval
+        mask[a : b + 1, c] = True
+    return mask
