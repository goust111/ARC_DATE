+    for _ in range(rows + 1):
+        grid[divider, c0 : c1 + 1] = FRAME
+        divider += slot_h + 1
+    slots = []
+    cur = r0 + 1
+    for _ in range(rows):
+        slots.append((int(cur), int(cur + slot_h - 1)))
+        cur += slot_h + 1
+    return (r0, c0, r1, c1), slots
