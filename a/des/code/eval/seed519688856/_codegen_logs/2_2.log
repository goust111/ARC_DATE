+def _draw_frame(grid: np.ndarray, r0: int, c0: int, rows: int, slot_h: int, inner_w: int) -> tuple[tuple[int, int, int, int], list[tuple[int, int]]]:
+    frame_h = rows * slot_h + rows + 1
+    frame_w = inner_w + 2
+    r1 = r0 + frame_h - 1
+    c1 = c0 + frame_w - 1
+    grid[r0 : r1 + 1, c0] = FRAME
+    grid[r0 : r1 + 1, c1] = FRAME
