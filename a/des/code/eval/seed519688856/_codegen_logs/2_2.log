0110:         frames_left = n_frames - pos - 1
0111:         lo = max(0, remaining - MAX_DOTS_PER_FRAME * frames_left)
0112:         hi = min(MAX_DOTS_PER_FRAME, remaining)
0113:         val = int(rng.integers(lo, hi + 1))
0114:         counts[int(idx)] = val
0115:         remaining -= val
0116:     return counts
