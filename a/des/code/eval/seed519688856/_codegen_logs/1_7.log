+            if not (len(rows) == 1 and len(cols) == 2) and not (len(rows) == 2 and len(cols) == 1):
+                continue
+            axis, track_cell, offtrack = _portal_axis_and_track_cell(g, comp)
+            info = {
+                "color": color,
