+        particle = (r0 if sign > 0 else r0 + length - 1, c) if spec["kind"] == "src" else None
+        orange = (particle[0] - 1, particle[1]) if spec["kind"] == "src" and sign > 0 else None
+        if spec["kind"] == "src" and sign < 0:
