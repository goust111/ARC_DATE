+    all_cells = set(track_cells)
+    all_cells.add(portal_off)
+    if particle is not None:
+        all_cells.add(particle)
+        all_cells.add(orange)
+    return {
+        "track_cells": track_cells,
+        "particle": particle,
+        "orange": orange,
+        "portal_track": portal_track,
+        "portal_off": portal_off,
+        "all_cells": all_cells,
+    }
