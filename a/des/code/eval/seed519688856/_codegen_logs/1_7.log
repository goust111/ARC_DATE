+    grid[or_r, or_c] = int(spec["portal_color"])
+    if spec["kind"] == "src":
+        rr, cc = placed["particle"]
+        mr, mc = placed["orange"]
+        grid[rr, cc] = int(spec["particle_color"])
+        grid[mr, mc] = ORANGE
+
