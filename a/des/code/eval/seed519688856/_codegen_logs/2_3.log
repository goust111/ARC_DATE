+def _sample_random_room(h: int, w: int, room_h: int, room_w: int, occupied: np.ndarray) -> dict[str, int] | None:
+    max_r0 = h - room_h - 1
+    max_c0 = w - room_w - 1
+    if max_r0 < 1 or max_c0 < 1:
+        return None
+    r0 = random.randint(1, max_r0)
+    c0 = random.randint(1, max_c0)
