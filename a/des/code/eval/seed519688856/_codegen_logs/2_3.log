+    for side in SIDES:
+        for door in _door_positions(room, side):
+            path, stop_type = _trace_ray_path(grid, door, side)
+            candidates.append({"door": door, "side": side, "path": path, "stop_type": stop_type})
+    return candidates
+
+
+def _desired_sides(room_count: int) -> list[str]:
