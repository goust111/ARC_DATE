+def _room_centers(rooms: list[dict[str, int]], axis: str) -> list[float]:
+    if axis == "row":
+        return [0.5 * (room["r0"] + room["r1"]) for room in rooms]
+    return [0.5 * (room["c0"] + room["c1"]) for room in rooms]
