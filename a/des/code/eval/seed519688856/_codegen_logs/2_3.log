+                    inner_w = c1 - c0 - 1
+                    interior_area = inner_h * inner_w
+                    if _rect_sum(wall_ps, r0 + 1, c0 + 1, r1 - 1, c1 - 1) != 0:
+                        continue
+                    if _rect_sum(bg_ps, r0 + 1, c0 + 1, r1 - 1, c1 - 1) != interior_area:
