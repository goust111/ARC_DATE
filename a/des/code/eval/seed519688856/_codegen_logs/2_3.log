    patch = np.full((height, width), _GEN_BG, dtype=int)
    if missing_side != "left":
        patch[:, 0] = _GEN_WALL
    if missing_side != "right":
        patch[:, -1] = _GEN_WALL
    patch[-1, :] = _GEN_WALL
    if gap is not None:
        patch[-1, gap] = _GEN_BG
    return patch


