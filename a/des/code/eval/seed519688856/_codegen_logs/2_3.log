+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+SIDE_STEPS = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+SIDES = tuple(SIDE_STEPS)
+VERTICAL_SIDES = ("top", "bottom")
+HORIZONTAL_SIDES = ("left", "right")
+
+GRID_H_RANGE = (15, 24)
+GRID_W_RANGE = (15, 24)
+ROOM_COUNT_RANGE = (2, 4)
+OUTER_SIZE_CHOICES = (5, 7, 9)
+ROOM_PADDING = 1
+ROOM_RETRIES = 120
+DOOR_RETRIES = 160
+MARKER_RETRIES = 160
+GEN_RETRIES = 400
