+def _sample_aligned_room(
+    h: int,
+    w: int,
+    room_h: int,
+    room_w: int,
+    occupied: np.ndarray,
+    anchors: list[dict[str, int]],
+) -> dict[str, int] | None:
+    for _ in range(24):
