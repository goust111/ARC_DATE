+def _room_signature(room: dict[str, object]) -> tuple[int, int, int, int, int, int, str]:
+    r0, c0, r1, c1 = room["bbox"]
+    dr, dc = room["door"]
+    return int(r0), int(c0), int(r1), int(c1), int(dr), int(dc), str(room["side"])
