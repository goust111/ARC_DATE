+    _edge_markers(grid, BLACK, GREY)
+    _ = main(grid)
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _build_candidate()
+        if grid is not None:
