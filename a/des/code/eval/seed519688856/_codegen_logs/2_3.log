+                    "door": tuple(pick["door"]),
+                    "side": str(pick["side"]),
+                    "ray_path": path,
+                    "stop_type": stop_type,
+                    "center_r": 0.5 * (room["r0"] + room["r1"]),
+                    "center_c": 0.5 * (room["c0"] + room["c1"]),
