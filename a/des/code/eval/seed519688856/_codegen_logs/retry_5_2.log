+def _candidate_ring_dims(area: int, max_h: int, max_w: int) -> list[tuple[int, int]]:
+    if (area + 4) % 2 != 0:
+        return []
+    total = (area + 4) // 2
+    dims = []
+    for h in range(max(3, max_h), total - 2 + 1):
+        w = total - h
+        if w < max(3, max_w):
+            continue
+        if h % 2 == 0 or w % 2 == 0:
+            continue
+        dims.append((h, w))
+    return dims
