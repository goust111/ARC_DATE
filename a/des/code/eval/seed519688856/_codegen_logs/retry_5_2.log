+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _ring_cycle(h: int, w: int) -> list[tuple[int, int]]:
+    pts = []
+    for c in range(w):
+        pts.append((0, c))
+    for r in range(1, h - 1):
+        pts.append((r, w - 1))
+    for c in range(w - 1, -1, -1):
