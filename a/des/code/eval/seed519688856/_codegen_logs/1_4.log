78:def main(grid: np.ndarray) -> np.ndarray:
79:    """
80:    Rebuild the foreground rectangles as a largest-to-smallest lower-left nesting.
81:
82:    Input structure
83:    - A periodic wallpaper background is overlaid by foreground colors that each form a rectangular frame or solid rectangle.
84:    - The largest foreground rectangle is the output frame; smaller foreground rectangles are the objects to nest inside it.
85:    - A frame may be partially hidden by a smaller rectangle, but its visible pixels still determine its bbox.
86:
87:    Rule
88:    - Ignore the wallpaper and crop the result to the largest foreground rectangle's bbox size.
89:    - Sort foreground rectangles by bbox area from largest to smallest.
90:    - Reconstruct each frame or solid rectangle, placing every next smaller rectangle in the lower-left of the current rectangle's usable region.
91:
92:    Key insight
93:    - The scattered background colors are not objects; the meaningful order is the unique descending rectangle size chain, and each step nests into the previous rectangle's lower-left interior.
94:    """
95:    g = np.asarray(grid, dtype=int)
96:    assert g.ndim == 2, "expected a 2D grid"
97:
98:    items = _foreground_rectangles(g)
99:    outer = items[0]
100:    out = np.zeros((int(outer["height"]), int(outer["width"])), dtype=int)
101:
102:    region = _paint_item(out, outer, 0, 0)
103:    for item in items[1:]:
104:        rr, cc, rh, rw = region
105:        h = int(item["height"])
106:        w = int(item["width"])
107:        assert h <= rh and w <= rw, "nested rectangle must fit in parent usable region"
108:        r = rr + rh - h
109:        c = cc
110:        region = _paint_item(out, item, r, c)
111:
112:    return out
