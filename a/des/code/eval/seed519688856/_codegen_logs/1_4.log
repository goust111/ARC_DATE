+        return [(frame_h + 1, anchor, RED), (frame_h, anchor - 1, RED), (frame_h, anchor + 1, RED)]
+    if direction == "left":
+        return [(anchor, -2, RED), (anchor - 1, -1, RED), (anchor + 1, -1, RED)]
