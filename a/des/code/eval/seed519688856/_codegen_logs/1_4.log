+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREY = 5
+MAROON = 9
+SPRITE_COLORS = (1, 3, 4, 6, 7, 8)
+DIR_VECTORS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
