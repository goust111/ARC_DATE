+
+def _place_specs(specs: list[dict[str, object]], h: int, w: int) -> list[dict[str, object]] | None:
+    blocked: set[tuple[int, int]] = set()
+    placed: list[dict[str, object]] = []
+
+    specs = sorted(
+        specs,
+        key=lambda spec: (
+            -len(spec["projected"]),
+            -spec["frame_h"] * spec["frame_w"],
+            0 if spec["edge_bias"] else 1,
