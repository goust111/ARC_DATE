+def _shift_sprite(
+    sprite_cells: list[tuple[int, int, int]], direction: str, distance: int
+) -> list[tuple[int, int, int]]:
+    dr, dc = DIR_VECTORS[direction]
+    return [(r + dr * distance, c + dc * distance, color) for r, c, color in sprite_cells]
