+def _render_output(specs: list[dict[str, object]], h: int, w: int) -> np.ndarray:
+    out = _render_input(specs, h, w)
+    out[out == MAROON] = BLACK
+    for spec in specs:
+        for r, c, color in spec["paint_output"]:
+            out[r, c] = color
+    return out
