+    if direction == "left":
+        return [(anchor, -2, RED), (anchor - 1, -1, RED), (anchor + 1, -1, RED)]
+    return [(anchor, frame_w + 1, RED), (anchor - 1, frame_w, RED), (anchor + 1, frame_w, RED)]
