+def _pad_points(points: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:
+    padded: set[tuple[int, int]] = set()
+    for r, c in points:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
