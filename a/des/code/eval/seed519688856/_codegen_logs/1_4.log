+def _frame_border_cells(frame_h: int, frame_w: int) -> list[tuple[int, int, int]]:
+    cells = []
+    for c in range(frame_w):
+        cells.append((0, c, GREY))
+        cells.append((frame_h - 1, c, GREY))
+    for r in range(1, frame_h - 1):
