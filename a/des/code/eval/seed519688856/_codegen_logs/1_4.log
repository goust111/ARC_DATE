+            reserve = {(r0 + r, c0 + c) for r, c in _reserve_cells(frame_h, frame_w, input_cells)}
+            reserve |= {(gr, gc) for gr, gc, _ in in_bounds_proj}
+            reserve = _pad_points(reserve, h, w)
+            if reserve & blocked:
+                continue
