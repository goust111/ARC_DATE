+            paint_input = [(r0 + r, c0 + c, color) for r, c, color in input_cells]
+            placed.append(
+                {
+                    **spec,
+                    "r0": r0,
+                    "c0": c0,
+                    "paint_input": paint_input,
+                    "paint_output": in_bounds_proj,
