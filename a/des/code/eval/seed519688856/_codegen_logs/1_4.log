+
+    return None
+
+
+def _find_arrows(grid: np.ndarray) -> list[dict[str, int]]:
+    arrows: list[dict[str, int]] = []
+    for comp in _components(grid == RED, connectivity=8):
+        arrow = _parse_arrow(comp)
+        if arrow is not None:
+            arrows.append(arrow)
