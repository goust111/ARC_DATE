+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+LEGEND_LEN = 4
+GEN_RETRIES = 400
+
+EDGE_NAMES = ("top", "bottom", "left", "right")
+LEGEND_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
