+BG = 0
+DIVIDER = 5
+CLOCK = 9
+PALETTE = [1, 2, 3, 4, 6, 7, 8]
+M_CHOICES = [5, 6, 7, 8, 9]
+MAX_ATTEMPTS = 400
+
+_BASE_CLOCK = {
+    "corners": [(0, 0), (0, 2), (2, 0), (2, 2)],
+    "center": (1, 1),
+    "pointer": {
+        0: (0, 1),  # up
+        1: (1, 2),  # right
+        2: (2, 1),  # down
+        3: (1, 0),  # left
+    },
+    "marker": {
+        0: (3, 1),   # pointer up -> marker below
+        1: (1, -1),  # pointer right -> marker left
+        2: (-1, 1),  # pointer down -> marker above
+        3: (1, 3),   # pointer left -> marker right
