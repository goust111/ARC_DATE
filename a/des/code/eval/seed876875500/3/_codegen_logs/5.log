+    out = np.full_like(g, BLACK)
+    out[grey_rows, :] = GREY
+    out[:, grey_cols] = GREY
+
+    for rr in range(rows):
+        for cc in range(cols):
+            cell = out[
+                grey_rows[rr] + 1 : grey_rows[rr + 1],
+                grey_cols[cc] + 1 : grey_cols[cc + 1],
