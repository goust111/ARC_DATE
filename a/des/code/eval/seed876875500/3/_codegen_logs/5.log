+    candidates: list[tuple[int, int, str, int, int]] = []
+    for rr in range(rows):
+        for cc in range(cols):
+            if fixed[rr, cc]:
+                continue
+            for direction, (dr, dc) in DIR_TO_DELTA.items():
+                nr = int(rr + dr)
+                nc = int(cc + dc)
+                if not (0 <= nr < rows and 0 <= nc < cols):
