+def _draw_strip(cell: np.ndarray, direction: str, color: int) -> None:
+    n = int(cell.shape[0])
+    center = n // 2
+    if direction == UP:
+        cell[: center + 1, center] = color
+    elif direction == DOWN:
+        cell[center:, center] = color
+    elif direction == LEFT:
