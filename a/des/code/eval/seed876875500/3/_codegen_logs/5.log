+    UP: frozenset({(0, 1), (1, 0), (1, 1)}),
+    DOWN: frozenset({(0, 0), (0, 1), (1, 0)}),
+    LEFT: frozenset({(0, 0), (0, 1), (1, 1)}),
+    RIGHT: frozenset({(0, 0), (1, 0), (1, 1)}),
+}
+SHAPE_TO_DIR = {shape: direction for direction, shape in DIR_TO_SHAPE.items()}
