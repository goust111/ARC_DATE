+    col_cut = width // 2
+    cells = [
+        (0, 0, row_cut - 1, col_cut - 1),
+        (0, col_cut + 1, row_cut - 1, width - 1),
+        (row_cut + 1, 0, height - 1, col_cut - 1),
+        (row_cut + 1, col_cut + 1, height - 1, width - 1),
