+def _legend_patch(patterns: dict[int, np.ndarray]) -> np.ndarray:
+    patch = np.full((LEGEND_HEIGHT, LEGEND_WIDTH), BLACK, dtype=int)
+    patch[0, :] = GREY
+    patch[-1, :] = GREY
+    patch[:, 0] = GREY
+    patch[:, -1] = GREY
