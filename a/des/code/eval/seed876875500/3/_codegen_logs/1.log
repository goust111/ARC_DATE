+
+def _make_object_patch(cell_h: int, cell_w: int, direction: str, span: int, color: int) -> np.ndarray | None:
+    if direction in {"left", "right"}:
+        sprite_w = span
+        max_h = min(3, cell_h - 4)
+        if max_h < 1:
+            return None
+        sprite_h = random.randint(1, max_h)
+    else:
+        sprite_h = span
+        max_w = min(3, cell_w - 4)
+        if max_w < 1:
