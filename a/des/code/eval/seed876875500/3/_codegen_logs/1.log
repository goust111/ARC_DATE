+    sample_colors = random.choices(NON_SPECIAL_COLORS, k=LEGEND_ROWS)
+    for row_idx in range(LEGEND_ROWS):
+        sep = row_idx * (LEGEND_ROW_HEIGHT + 1)
+        patch[sep, :] = GREY
