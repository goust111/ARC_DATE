+    extra = (node.h - 2) - (a.h + b.h + 3)
+    top_pad, gap_pad, _ = _split_extra(extra, 3)
+    ra0 = r0 + 2 + top_pad
+    rb0 = ra0 + a.h + 1 + gap_pad
+    ca0 = random.randint(c0 + 2, c0 + node.w - a.w - 2)
+    cb0 = random.randint(c0 + 2, c0 + node.w - b.w - 2)
