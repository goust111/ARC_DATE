+def _frame_bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int] | None:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return None
