+def _branch(with_grandchild: bool) -> LayoutNode:
+    kids = [LayoutNode(), LayoutNode()]
+    random.shuffle(kids)
+    root = LayoutNode(children=kids, orient=random.choice(("h", "v")))
+    if with_grandchild:
+        target = random.choice(kids)
+        target.children = [LayoutNode()]
+    return root
