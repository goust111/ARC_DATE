+    inp, expected = _crop_pair(inp, expected)
+    try:
+        if np.array_equal(main(inp), expected):
+            return inp
+    except Exception:
+        return None
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid nested-rectangle input")

