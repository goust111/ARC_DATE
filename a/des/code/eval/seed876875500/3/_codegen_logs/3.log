+        out = np.zeros((2 * h - 1, w), dtype=bool)
+        out[:h, :] |= mask
+        out[h - 1 :, :] |= np.flipud(mask)
+        return out
+    raise ValueError(axis)
+
+
+def _count_holes(mask: np.ndarray) -> int:
+    h, w = mask.shape
