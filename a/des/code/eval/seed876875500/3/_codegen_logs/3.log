+        if not placed:
+            return None
+
+    expected = _expected_output(grid.shape, dot_cols, specs)
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    if int(np.unique(grid).size) < 5:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(300):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid sample")

