+        h, w = mask.shape
+        max_top = bar_row - h - 1
+        if max_top < 0:
+            return None
+        for _ in range(300):
+            top = int(rng.integers(0, max_top + 1))
+            left = int(rng.integers(0, grid_w - w + 1))
