+        return half
+    raise RuntimeError("failed to build a valid half-shape")
+
+
+def _make_shape(hole_count: int, axis: str, rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    for _ in range(100):
