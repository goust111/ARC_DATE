+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            touches_edge = False
+            while stack:
+                cr, cc = stack.pop()
+                if cr == 0 or cr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_edge = True
+                for dr, dc in _DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and not mask[nr, nc]:
