+        )
+
+    assert len(merged) == len(dot_cols), "dot count must equal color-pair count"
+    merged.sort(key=lambda item: (int(item["holes"]), int(item["anchor"])))
+
+    out = np.full_like(g, bg)
+    for dot_col, item in zip(dot_cols, merged):
+        mask = item["mask"]
+        h, w = mask.shape
+        top = bar_row - h + 1
