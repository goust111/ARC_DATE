+
+    if random.choice((False, True)):
+        grid = grid.T.copy()
+
+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+
+    if out.shape != grid.shape or np.array_equal(grid, out):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
