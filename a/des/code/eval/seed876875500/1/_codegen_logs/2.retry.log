+from __future__ import annotations
+
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+BRANCHES = ("none", "single", "multi")
+GENERATION_RETRIES = 400
+GRID_H_RANGE = (12, 18)
+GRID_W_RANGE = (14, 20)
