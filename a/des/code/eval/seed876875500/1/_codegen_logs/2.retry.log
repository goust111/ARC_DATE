+
+
+def _bbox_in_bounds(shape: tuple[int, int], bbox: tuple[int, int, int, int]) -> bool:
+    h, w = shape
+    r0, c0, r1, c1 = bbox
+    return 0 <= r0 <= r1 < h and 0 <= c0 <= c1 < w
+
+
