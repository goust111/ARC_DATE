+            cells = set(_bbox_cells((r, c, r + 1, c + 1)))
+            assert not (cells & occupied), "overlapping 2x2 fragments are not allowed"
+            pieces.append((color, (r, c, r + 1, c + 1)))
+            occupied |= cells
