+@dataclass(frozen=True)
+class Track:
+    color: int
+    orientation: str  # "h" or "v"
+    fixed: int
+    lo: int
+    hi: int
+    direction: int  # +1 means lo -> hi, -1 means hi -> lo
+    piece_bbox: tuple[int, int, int, int]
+
+    def start_coord(self) -> int:
