+        if (nr, nc) in ((0, 0), (0, mask.shape[1] - 1), (mask.shape[0] - 1, mask.shape[1] - 1), (mask.shape[0] - 1, 0)):
+            alt = [step for step in moves if step != (dr, dc)]
+            if alt:
