+
+def _overlay(patches: list[np.ndarray], bg: int) -> np.ndarray:
+    assert patches
+    shape = patches[0].shape
+    assert all(p.shape == shape for p in patches)
+    out = np.full(shape, bg, dtype=int)
+    occupied = np.zeros(shape, dtype=int)
+    for patch in patches:
