+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Identify each sprite's unique corner instruction pixel, rotate the sprite accordingly,
+    then overlay all rotated sprites on a shared canvas; conflicts become color 9.
+    """
