+    templates: dict[str, tuple[np.ndarray, np.ndarray]] = {}
+    for comp in comps:
+        r0, c0, r1, c1 = _bbox(comp)
+        side_hits = []
+        if r1 < union_r0:
+            side_hits.append("up")
+        if r0 > union_r1:
+            side_hits.append("down")
+        if c1 < union_c0:
+            side_hits.append("left")
+        if c0 > union_c1:
+            side_hits.append("right")
