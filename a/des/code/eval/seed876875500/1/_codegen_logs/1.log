+    union_r0 = min(int(frame["bbox"][0]) for frame in frames)
+    union_c0 = min(int(frame["bbox"][1]) for frame in frames)
+    union_r1 = max(int(frame["bbox"][2]) for frame in frames)
+    union_c1 = max(int(frame["bbox"][3]) for frame in frames)
