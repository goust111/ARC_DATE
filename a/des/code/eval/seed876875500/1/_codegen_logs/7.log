+def _rects_too_close(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int) -> bool:
+    return not (
+        a[2] + pad <= b[0]
+        or b[2] + pad <= a[0]
+        or a[3] + pad <= b[1]
+        or b[3] + pad <= a[1]
+    )
+
+
+def _sample_maze_position(
+    h: int, w: int, maze_shape: tuple[int, int], legend_rect: tuple[int, int, int, int]
