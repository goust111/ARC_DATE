+    active = set(placed.values())
+    edges = {_norm_edge(placed[a], placed[b]) for a, b in BASE_EDGES}
+    protected = {
+        placed["cross"],
+        placed["tee"],
+        placed["corner"],
+        placed["endpoint"],
