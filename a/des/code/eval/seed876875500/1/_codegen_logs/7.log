+
+
+def _random_dihedral(arr: np.ndarray) -> np.ndarray:
+    out = arr
+    if bool(int(_RNG.integers(0, 2))):
+        out = np.fliplr(out)
+    out = np.rot90(out, int(_RNG.integers(0, 4)))
+    return out.copy()
+
+
+def _maze_patch(bg: int, wall: int) -> np.ndarray:
