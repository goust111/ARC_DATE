+OPENINGS_BY_CATEGORY = {
+    "straight": [(0, 2), (1, 3)],
+    "corner": [(0, 1), (1, 2), (2, 3), (3, 0)],
+    "tee": [(0, 1, 2), (1, 2, 3), (2, 3, 0), (3, 0, 1)],
+    "cross": [(0, 1, 2, 3)],
