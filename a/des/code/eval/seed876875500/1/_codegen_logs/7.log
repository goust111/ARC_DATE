+def _legend_candidates(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    candidates = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            center = int(grid[r, c])
+            if center == bg:
+                continue
+            patch = grid[r - 1 : r + 2, c - 1 : c + 2]
+            surround = np.delete(patch.reshape(-1), 4)
+            if np.any(surround == center):
+                continue
+            other = sorted({int(v) for v in surround if int(v) != bg})
+            if len(other) != 1:
+                continue
+            wall = other[0]
+            open_dirs = (
+                int(patch[0, 1]) == bg,
+                int(patch[1, 2]) == bg,
+                int(patch[2, 1]) == bg,
+                int(patch[1, 0]) == bg,
+            )
+            category = _classify_open_dirs(open_dirs)
+            if category not in CATEGORY_ORDER:
+                continue
+            candidates.append(
+                {
+                    "r": r,
+                    "c": c,
+                    "color": center,
+                    "wall": wall,
+                    "category": category,
+                }
+            )
+    return candidates
+
