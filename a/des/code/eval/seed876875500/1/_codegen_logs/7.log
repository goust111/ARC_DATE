+# --------------- generator ---------------
+
+GRID_H_RANGE = (24, 35)
+GRID_W_RANGE = (24, 35)
+LEGEND_SIZE = 7
+LEGEND_OFFSETS = [(0, 0), (0, 4), (4, 0), (4, 4)]
+LEGEND_CORNERS = ("top_left", "top_right", "bottom_left", "bottom_right")
+CELL_SIDE_RANGE = (4, 8)
+PLACEMENT_PADDING = 2
+GEN_RETRIES = 300
