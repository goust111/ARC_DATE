+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != value:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            coords = []
+            touches_border = r in (0, h - 1) or c in (0, w - 1)
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in ORTH_DIRS:
+                    nr, nc = rr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != value:
+                        continue
+                    seen[nr, nc] = True
+                    if nr in (0, h - 1) or nc in (0, w - 1):
+                        touches_border = True
+                    q.append((nr, nc))
+            components.append(
