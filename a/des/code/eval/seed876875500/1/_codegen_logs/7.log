+    if corner == "top_right":
+        return 0, w - LEGEND_SIZE, LEGEND_SIZE, w
+    if corner == "bottom_left":
+        return h - LEGEND_SIZE, 0, h, LEGEND_SIZE
+    return h - LEGEND_SIZE, w - LEGEND_SIZE, h, w
+
