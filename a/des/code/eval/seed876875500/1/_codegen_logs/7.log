+def _classify_open_dirs(open_dirs: tuple[bool, bool, bool, bool]) -> str | None:
+    up, right, down, left = open_dirs
+    degree = int(sum(open_dirs))
+    if degree == 1:
+        return "endpoint"
+    if degree == 2:
+        if (up and down) or (left and right):
+            return "straight"
+        return "corner"
+    if degree == 3:
