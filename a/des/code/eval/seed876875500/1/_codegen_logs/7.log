+    for (r0, c0), (r1, c1) in edges:
+        pr0, pc0 = 2 * r0 + 1, 2 * c0 + 1
+        pr1, pc1 = 2 * r1 + 1, 2 * c1 + 1
+        patch[(pr0 + pr1) // 2, (pc0 + pc1) // 2] = bg
+    return _random_dihedral(patch)
+
