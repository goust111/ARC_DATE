+def _build_object(kind: str, color: int, crowded: bool) -> dict[str, object] | None:
+    length_lo, length_hi = LARGE_OBJECT_LENGTH_RANGE if crowded else SMALL_OBJECT_LENGTH_RANGE
+    length = random.randint(length_lo, length_hi)
