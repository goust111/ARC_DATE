+def _local_neighbors(a: int, b: int, length: int, depth: int) -> Iterable[tuple[int, int]]:
+    for da, db in NEIGHBORS4:
+        na = a + da
+        nb = b + db
+        if 0 <= na < length and 0 <= nb < depth:
+            yield na, nb
