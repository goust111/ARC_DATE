+    n_source = len(source)
+    line_arr = shifted[:n_line]
+    source_arr = shifted[n_line : n_line + n_source]
+    reflected_arr = shifted[n_line + n_source :]
+
+    height = int(shifted[:, 0].max()) + 1
+    width = int(shifted[:, 1].max()) + 1
+    return {
+        "kind": kind,
+        "color": int(color),
+        "line": line_arr,
+        "source": source_arr,
+        "reflected": reflected_arr,
+        "height": height,
+        "width": width,
+    }
+
