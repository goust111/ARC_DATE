+def _map_local_point(kind: str, length: int, a: int, b: int, sigma: int) -> tuple[int, int]:
+    if kind == "horizontal":
+        return sigma * b, a
+    if kind == "vertical":
+        return a, sigma * b
+    if kind == "diag_down":
+        return a + sigma * b, a - sigma * b
+    if kind == "diag_up":
+        return a + sigma * b, (length - 1 - a) + sigma * b
+    raise AssertionError(f"unknown kind: {kind}")
