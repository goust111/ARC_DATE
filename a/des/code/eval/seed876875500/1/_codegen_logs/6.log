+    out = np.full(shape, bg, dtype=int)
+
+    for obj, (top, left) in zip(objects, placements):
+        color = int(obj["color"])
+
+        line = np.asarray(obj["line"], dtype=int)
+        source = np.asarray(obj["source"], dtype=int)
+        reflected = np.asarray(obj["reflected"], dtype=int)
+
