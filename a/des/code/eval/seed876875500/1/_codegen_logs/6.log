+        inp[top + source[:, 0], left + source[:, 1]] = GREY
+
+        out[top + line[:, 0], left + line[:, 1]] = color
+        out[top + source[:, 0], left + source[:, 1]] = GREY
+        for rr_raw, cc_raw in reflected:
+            rr = top + int(rr_raw)
+            cc = left + int(cc_raw)
+            if int(out[rr, cc]) == bg:
