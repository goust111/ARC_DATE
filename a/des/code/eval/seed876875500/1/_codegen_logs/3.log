+import random
+from collections import Counter
+
+import numpy as np
+
+
+SIDES = ("top", "bottom", "left", "right")
+PALETTE = tuple(range(10))
+GEN_RETRIES = 400
+PLACE_RETRIES = 200
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _fill_single_pixel_gaps(grid: np.ndarray, bg: int, color: int) -> np.ndarray:
+    mask = grid == color
+    filled = mask.copy()
+    h, w = grid.shape
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if int(grid[r, c]) != bg:
+                continue
+            if mask[r, c - 1] and mask[r, c + 1]:
+                filled[r, c] = True
+            if mask[r - 1, c] and mask[r + 1, c]:
+                filled[r, c] = True
+    return filled
+
+
+def _gap_indices(side_values: np.ndarray, bg: int, color: int) -> list[int] | None:
+    vals = [int(v) for v in side_values.tolist()]
+    if any(v not in (bg, color) for v in vals):
+        return None
+    gaps = [idx for idx, v in enumerate(vals) if v == bg]
+    for a, b in zip(gaps, gaps[1:]):
+        if b == a + 1:
+            return None
+    return gaps
+
+
+def _detect_rooms(grid: np.ndarray, bg: int) -> tuple[int, list[dict]]:
+    h, w = grid.shape
