+        grid[r0, c0 + col] = spec["bg"]
+    for col in spec["gaps"]["bottom"]:
+        grid[r1, c0 + col] = spec["bg"]
+    for row in spec["gaps"]["left"]:
+        grid[r0 + row, c0] = spec["bg"]
+    for row in spec["gaps"]["right"]:
+        grid[r0 + row, c1] = spec["bg"]
+
