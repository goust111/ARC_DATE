+                    "color": color,
+                    "gaps": {
+                        "top": [c0 + 1 + idx for idx in top],
+                        "bottom": [c0 + 1 + idx for idx in bottom],
+                        "left": [r0 + 1 + idx for idx in left],
+                        "right": [r0 + 1 + idx for idx in right],
+                    },
+                    "gap_count": gap_count,
