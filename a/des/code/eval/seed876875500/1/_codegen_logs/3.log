+            spec = {"bbox": bbox, "gaps": gaps, "n": n, "bg": bg}
+            _draw_room(grid, wall, spec)
+            specs.append(spec)
+            forbidden.append(bbox)
+            placed = True
+            break
+        if not placed:
+            return None
+
+    expected = _expected_from_specs(grid, legend, specs)
+    solved = _solve(grid)
+    if not np.array_equal(expected, solved):
+        return None
+    return grid
