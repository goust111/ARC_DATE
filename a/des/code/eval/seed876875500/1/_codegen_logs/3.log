+def _draw_room(grid: np.ndarray, wall: int, spec: dict) -> None:
+    r0, c0, r1, c1 = spec["bbox"]
+    grid[r0, c0 : c1 + 1] = wall
+    grid[r1, c0 : c1 + 1] = wall
+    grid[r0 : r1 + 1, c0] = wall
+    grid[r0 : r1 + 1, c1] = wall
