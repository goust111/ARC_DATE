+    extras = [(r, c) for r in range(h) for c in range(w) if not mask[r, c] and sum(mask[rr, cc] for rr, cc in _neighbors4(r, c, h, w)) >= 2]
+    random.shuffle(extras)
+    for r, c in extras[: random.randint(0, min(2, len(extras)))]:
