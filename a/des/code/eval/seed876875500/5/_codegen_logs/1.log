+            key_idx = key_candidates[0]
+            obj_idx = 1 - key_idx
+            key_coords = inner_abs[key_idx]
+            obj_coords = inner_abs[obj_idx]
+            if len(obj_coords) <= len(key_coords) + 1:
+                continue
+
+            or0, oc0, or1, oc1 = _bbox(obj_coords)
+            oh = or1 - or0 + 1
+            ow = oc1 - oc0 + 1
+            if len(obj_coords) <= 9 and oh <= 3 and ow <= 3:
+                continue
