+def _random_connected_mask(h: int, w: int, min_area: int) -> np.ndarray | None:
+    total = h * w
+    if total < min_area:
+        return None
+    upper = min(total, max(min_area, int(round(total * random.uniform(0.55, 0.9)))))
+    target = random.randint(min_area, upper)
