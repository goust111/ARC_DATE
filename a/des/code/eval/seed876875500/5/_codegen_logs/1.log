+    occupied = {start}
+    while len(occupied) < target:
+        frontier = []
+        weights = []
+        for r, c in occupied:
+            for nr, nc in _neighbors4(r, c, h, w):
+                if mask[nr, nc]:
+                    continue
+                cell = (nr, nc)
+                if cell not in frontier:
+                    frontier.append(cell)
+                    degree = sum(mask[rr, cc] for rr, cc in _neighbors4(nr, nc, h, w))
+                    weights.append(max(1, int(degree)) ** 2)
