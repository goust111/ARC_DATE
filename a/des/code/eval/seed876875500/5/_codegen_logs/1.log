+# --------------- generator ---------------
+
+BACKGROUND = 0
+ROOM_BORDER = 5
+FILL_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+ROOM_COUNT_CHOICES = (1, 2, 3)
