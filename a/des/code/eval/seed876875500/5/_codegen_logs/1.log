+    source_colors = chosen_colors[:room_count]
+    target_colors = chosen_colors[room_count:]
+
+    specs = []
+    for idx in range(room_count):
+        key_h, key_w, shape_a, shape_b = chosen_shapes[idx]
+        specs.append(
