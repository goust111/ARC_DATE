+            if any(all(r0 < r < r1 and c0 < c < c1 for r, c in comp) for r0, c0, r1, c1 in room_boxes):
+                continue
+            sig = _shape_signature(comp)
+            templates.setdefault(sig, []).append(color)
+    return templates
