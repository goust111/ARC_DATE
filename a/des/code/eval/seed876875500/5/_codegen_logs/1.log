+def _reserve_with_padding(reserved: np.ndarray, r0: int, c0: int, h: int, w: int) -> None:
+    H, W = reserved.shape
+    reserved[max(0, r0 - 1) : min(H, r0 + h + 1), max(0, c0 - 1) : min(W, c0 + w + 1)] = True
