+def _find_rooms(grid: np.ndarray, bg: int) -> list[dict]:
+    rooms: list[dict] = []
+    colors = [int(c) for c in np.unique(grid) if int(c) != bg]
+    for color in colors:
+        for comp in _components_mask(grid == color):
+            r0, c0, r1, c1 = _bbox(comp)
+            h = r1 - r0 + 1
