+                "key_h": key_h,
+                "key_w": key_w,
+                "key_rel": random.choice([shape_a, shape_b]),
+                "outer_h": random.randint(INNER_HEIGHT_RANGE[0], INNER_HEIGHT_RANGE[1]) + 2,
+                "outer_w": random.randint(INNER_WIDTH_RANGE[0], INNER_WIDTH_RANGE[1]) + 2,
+            }
