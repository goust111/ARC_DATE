+from __future__ import annotations
+
+import itertools
+import random
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+BG_COLOR = 0
+GREY_COLOR = 5
+ENDPOINT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+LINE_MODES = ("diag", "shallow", "steep")
+MODE_VECTORS = {
+    "diag": ((1, 1),),
+    "shallow": ((1, 2), (1, 3), (2, 3)),
+    "steep": ((2, 1), (3, 1), (3, 2)),
+}
+
+GRID_H_RANGE = (14, 22)
+GRID_W_RANGE = (14, 22)
+PAIR_RANGE = (2, 5)
+LEGEND_ROWS_RANGE = (1, 3)
+PLAY_MARGIN = 1
+MIN_ENDPOINT_GAP = 2
+MAX_GENERATION_ATTEMPTS = 500
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _components4(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for sr, sc in np.argwhere(mask):
+        sr, sc = int(sr), int(sc)
+        if seen[sr, sc]:
+            continue
+        seen[sr, sc] = True
+        q = deque([(sr, sc)])
+        comp: list[tuple[int, int]] = []
+        while q:
+            r, c = q.popleft()
+            comp.append((r, c))
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _round_half_up(value: float) -> int:
+    return int(np.floor(value + 0.5))
+
+
+def _raster_line(p0: tuple[int, int], p1: tuple[int, int]) -> list[tuple[int, int]]:
+    r0, c0 = p0
+    r1, c1 = p1
+    dr = r1 - r0
+    dc = c1 - c0
+    assert dr != 0 and dc != 0
+
+    if abs(dc) > abs(dr):
+        if c0 > c1:
+            r0, c0, r1, c1 = r1, c1, r0, c0
+            dr = r1 - r0
+            dc = c1 - c0
+        cells = []
+        for c in range(c0, c1 + 1):
+            t = (c - c0) / dc
+            r = _round_half_up(r0 + dr * t)
+            cells.append((r, c))
+        return cells
+
+    if r0 > r1:
+        r0, c0, r1, c1 = r1, c1, r0, c0
+        dr = r1 - r0
+        dc = c1 - c0
+    cells = []
+    for r in range(r0, r1 + 1):
+        t = (r - r0) / dr
+        c = _round_half_up(c0 + dc * t)
+        cells.append((r, c))
+    return cells
+
+
+def _legend_info(grid: np.ndarray, bg: int) -> tuple[np.ndarray, dict[frozenset[int], int]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    comps = _components4(g != bg)
+    candidates = []
+    for comp in comps:
+        r0, c0, r1, c1 = _bbox(comp)
+        box_h = r1 - r0 + 1
+        box_w = c1 - c0 + 1
+        if box_w != 3 or len(comp) != box_h * box_w:
+            continue
+        touches_corner = (
+            (r0 == 0 and c0 == 0)
+            or (r0 == 0 and c1 == w - 1)
+            or (r1 == h - 1 and c0 == 0)
+            or (r1 == h - 1 and c1 == w - 1)
+        )
+        if touches_corner:
+            candidates.append((comp, (r0, c0, r1, c1)))
+    assert len(candidates) == 1, "expected exactly one corner legend"
+
+    comp, (r0, c0, r1, c1) = candidates[0]
+    mask = np.zeros_like(g, dtype=bool)
+    for r, c in comp:
+        mask[r, c] = True
+
+    mapping: dict[frozenset[int], int] = {}
