+
+def _room_boxes(h_lines: list[int], v_lines: list[int]) -> dict[Room, Box]:
+    boxes: dict[Room, Box] = {}
+    for rr in range(len(h_lines) - 1):
+        for cc in range(len(v_lines) - 1):
+            r0 = int(h_lines[rr] + 1)
+            r1 = int(h_lines[rr + 1] - 1)
+            c0 = int(v_lines[cc] + 1)
+            c1 = int(v_lines[cc + 1] - 1)
+            assert r0 <= r1 and c0 <= c1
