+        return True
+    return False
+
+
+def _horizontal_door(grid: np.ndarray, v_lines: list[int], wall_row: int, room_col: int) -> bool:
+    c0 = int(v_lines[room_col] + 1)
+    c1 = int(v_lines[room_col + 1])
+    segment = grid[int(wall_row), c0:c1]
