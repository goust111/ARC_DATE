+        components.append(comp)
+    return components
+
+
+def _paint_room(out: np.ndarray, box: Box, count: int) -> None:
+    r0, r1, c0, c1 = box
+    patch = out[r0 : r1 + 1, c0 : c1 + 1]
+    if count == 0:
