+
+
+def _room_graph(
+    grid: np.ndarray,
+    h_lines: list[int],
+    v_lines: list[int],
+) -> dict[Room, set[Room]]:
+    room_rows = len(h_lines) - 1
+    room_cols = len(v_lines) - 1
+    graph: dict[Room, set[Room]] = {
+        (rr, cc): set() for rr in range(room_rows) for cc in range(room_cols)
