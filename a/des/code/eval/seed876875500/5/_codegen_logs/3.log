+        num_horizontal = num_segments // 2
+
+        min_h = max(12, 3 * num_segments + 1)
+        grid_h = random.randint(min_h, min_h + 8)
+        left_w = random.randint(7, 13)
+        right_w = random.randint(3, 6)
+        total_w = left_w + 1 + right_w
+
