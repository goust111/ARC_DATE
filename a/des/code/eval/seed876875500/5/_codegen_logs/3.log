+    for i in range(len(cols) - 1):
+        for _ in range(vertical_steps[i]):
+            r += 1
+            path.append((r, c))
+        step = 1 if cols[i + 1] > c else -1
+        for _ in range(abs(cols[i + 1] - c)):
+            c += step
