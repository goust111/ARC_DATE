+    palette_colors = _extract_palette_colors(right)
+    path = _ordered_path(left)
+    segments, turns = _split_segments(path)
+    segment_colors = _segment_colors(palette_colors, turns)
+
+    assert len(segments) == len(segment_colors)
+    out = left.copy()
