+        ("right", [(r, W - 1) for r in range(1, H - 1)]),
+    ]
+    for direction, cells in edge_specs:
+        for r, c in cells:
+            color = int(g[r, c])
+            if color == BG:
+                continue
+            assert color not in directions
+            directions[color] = direction
+            marker_cells.add((int(r), int(c)))
