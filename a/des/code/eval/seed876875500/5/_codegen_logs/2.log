+def _box_far_enough(
+    box: tuple[int, int, int, int],
+    boxes: list[tuple[int, int, int, int]],
+    *,
+    gap: int = 1,
+) -> bool:
+    r0, c0, r1, c1 = box
+    for br0, bc0, br1, bc1 in boxes:
+        if not (r1 < br0 - gap or br1 < r0 - gap or c1 < bc0 - gap or bc1 < c0 - gap):
+            return False
+    return True
+
+
+def _add_rect_spec(
+    specs: list[dict],
+    boxes: list[tuple[int, int, int, int]],
+    *,
+    color: int,
+    direction: str,
+    r0: int,
+    c0: int,
+    h: int,
+    w: int,
+) -> bool:
+    box = (int(r0), int(c0), int(r0 + h - 1), int(c0 + w - 1))
+    if not _box_far_enough(box, boxes, gap=1):
+        return False
+    boxes.append(box)
+    specs.append(
+        {
+            "color": int(color),
+            "direction": direction,
+            "r0": int(r0),
+            "c0": int(c0),
+            "h": int(h),
+            "w": int(w),
