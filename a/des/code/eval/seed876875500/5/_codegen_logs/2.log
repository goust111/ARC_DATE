+def _decode_markers(grid: np.ndarray) -> tuple[dict[int, str], set[tuple[int, int]]]:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    assert H >= 3 and W >= 3
+    assert int(g[0, 0]) == BG and int(g[0, W - 1]) == BG
+    assert int(g[H - 1, 0]) == BG and int(g[H - 1, W - 1]) == BG
