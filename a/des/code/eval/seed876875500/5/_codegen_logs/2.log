+                "colors": [int(obj["color"]) for obj in group],
+                "areas": [int(obj["area"]) for obj in group],
+                "top_rows": [int(obj["top_row"]) for obj in group],
+                "fused": bool(fused),
+                "winner_color": int(winner["color"]),
+                "winner_type": winner_type if fused else "none",
+            }
+        )
