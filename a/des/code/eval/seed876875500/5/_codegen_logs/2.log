+    if len(colors) >= 3:
+        extra_dir_choices = [d for d in DIR_TO_VEC if d != pair_dir]
+        extra_dir = random.choice(extra_dir_choices)
+        zone_map = {
+            "up": ((H // 2, H - 2), (1, max(1, W // 3))),
+            "down": ((1, max(1, H // 3)), (W // 2, W - 2)),
+            "left": ((H // 2, H - 2), (W // 2, W - 2)),
