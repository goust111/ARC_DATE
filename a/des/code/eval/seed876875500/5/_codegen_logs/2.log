+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _sort_cells(cells: list[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    return tuple(sorted((int(r), int(c)) for r, c in cells))
