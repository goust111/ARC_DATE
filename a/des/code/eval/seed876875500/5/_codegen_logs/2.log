+
+def _render_grid(H: int, W: int, specs: list[dict]) -> np.ndarray:
+    grid = np.full((H, W), BG, dtype=int)
+    for spec in specs:
+        r0 = int(spec["r0"])
+        c0 = int(spec["c0"])
+        h = int(spec["h"])
+        w = int(spec["w"])
+        grid[r0 : r0 + h, c0 : c0 + w] = int(spec["color"])
