+def _touching(a: tuple[tuple[int, int], ...], b: tuple[tuple[int, int], ...]) -> bool:
+    bset = set(b)
+    for r, c in a:
+        for nr, nc in _neighbors4(int(r), int(c)):
+            if (int(nr), int(nc)) in bset:
+                return True
+    return False
