+import numpy as np
+
+
+Coord = tuple[int, int]
+
+YELLOW = 4
+GREY = 5
+DIRS: tuple[Coord, ...] = ((-1, 0), (1, 0), (0, -1), (0, 1))
+FRAGMENT_LENGTHS = (2, 3, 4)
+LEG_LENGTHS = (1, 2, 3)
+TEMP_GROUP_SHAPE = (25, 25)
+MAX_GROUP_EXTENT = 16
+GROUP_BUILD_ATTEMPTS = 120
+FRAGMENT_PLACEMENT_ATTEMPTS = 120
+SCENE_GENERATION_ATTEMPTS = 400
+
+
+@dataclass(frozen=True)
+class Fragment:
