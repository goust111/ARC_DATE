AVAILABLE_COLORS = [SOURCE_COLOR] + DISTRACTOR_COLORS

# Staircase geometry and edge placement.
STAIR_HEIGHT_RANGE = (3, 5)
STAIR_MAX_WIDTH = 8
STAIR_WIDTH_EXTRA = 4
EDGE_SIDES = ("left", "right")
LEFT_CORNERS = ("tl", "bl")
RIGHT_CORNERS = ("tr", "br")

# Cutout geometry and line-of-sight requirements.
