+def stamp_cells(mask: np.ndarray, center_r: int, center_c: int, h: int, w: int) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    mr = mask.shape[0] // 2
+    mc = mask.shape[1] // 2
