+    r1, c1 = grey.max(axis=0)
+    mask = top[r0 : r1 + 1, c0 : c1 + 1] == TEMPLATE_COLOR
+    assert mask.shape[0] % 2 == 1 and mask.shape[1] % 2 == 1
+    return mask, sep
