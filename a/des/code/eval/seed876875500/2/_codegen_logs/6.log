+def extract_template_mask(grid: np.ndarray) -> tuple[np.ndarray, int]:
+    sep_rows = [r for r in range(grid.shape[0]) if np.all(grid[r] == SEPARATOR_COLOR)]
+    assert len(sep_rows) == 1
