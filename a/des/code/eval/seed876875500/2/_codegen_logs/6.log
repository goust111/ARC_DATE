+def _desired_directions(count: int) -> list[int]:
+    dirs = [UP, RIGHT, DOWN, LEFT]
+    random.shuffle(dirs)
+    chosen = dirs[: min(count, 4)]
+    while len(chosen) < count:
+        chosen.append(random.choice(dirs))
+    random.shuffle(chosen)
+    return chosen
