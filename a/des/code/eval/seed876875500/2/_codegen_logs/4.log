+        if rect is None:
+            continue
+
+        stats = _overlap_stats(rect, lowers)
+        if stats is None:
+            continue
+        overlap_count, _ = stats
+        if require_overlap and overlap_count == 0:
+            continue
+        return rect
+    return None
+
+
+def _sample_scene() -> np.ndarray | None:
+    body_h = random.randint(*BODY_HEIGHT_RANGE)
+    body_w = random.randint(*BODY_WIDTH_RANGE)
+    rect_count = random.randint(*RECT_COUNT_RANGE)
+
