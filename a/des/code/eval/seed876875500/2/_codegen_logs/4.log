+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+Rect = tuple[int, int, int, int]
+
+
+COLOR_POOL = tuple(range(10))
+GEN_RETRIES = 400
+
+BODY_HEIGHT_RANGE = (12, 18)
+BODY_WIDTH_RANGE = (14, 22)
+RECT_COUNT_RANGE = (3, 5)
+RECT_SIDE_RANGE = (4, 8)
+
+MAX_BODY_FILL_FRACTION = 0.5
+MAX_OVERLAPS_PER_RECT = 2
+MAX_OVERLAP_FRACTION = 0.45
+PLACEMENT_RETRIES = 180
+LEGEND_RETRIES = 120
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _bbox(coords: np.ndarray) -> Rect:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _area(rect: Rect) -> int:
+    r0, c0, r1, c1 = rect
+    return int(r1 - r0 + 1) * int(c1 - c0 + 1)
+
+
+def _intersection(a: Rect, b: Rect) -> Rect | None:
+    r0 = max(a[0], b[0])
+    c0 = max(a[1], b[1])
+    r1 = min(a[2], b[2])
+    c1 = min(a[3], b[3])
+    if r0 > r1 or c0 > c1:
+        return None
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _strictly_inside(inner: Rect, outer: Rect) -> bool:
+    return bool(
+        inner[0] > outer[0]
+        and inner[1] > outer[1]
+        and inner[2] < outer[2]
+        and inner[3] < outer[3]
+    )
+
+
+def _render_body(
+    height: int,
+    width: int,
+    bg: int,
+    rectangles: dict[int, Rect],
+    order: list[int],
+) -> np.ndarray:
+    out = np.full((height, width), bg, dtype=int)
+    for color in order:
+        r0, c0, r1, c1 = rectangles[int(color)]
+        out[r0 : r1 + 1, c0 : c1 + 1] = int(color)
+    return out
+
+
+def _legend_order(row: np.ndarray, bg: int) -> list[int]:
+    return [int(v) for v in row if int(v) != bg]
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Recover each partially occluded solid rectangle from its visible bbox, then redraw
+    all rectangles using the new bottom legend order from bottom to top.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.shape[0] >= 2
+
+    bg = _bg_color(g)
+    body = g[:-1, :]
+    legend = g[-1, :]
+    order = _legend_order(legend, bg)
+    assert order and len(order) == len(set(order))
+
+    body_colors = {int(v) for v in np.unique(body) if int(v) != bg}
+    assert body_colors == set(order)
+
+    rectangles: dict[int, Rect] = {}
+    for color in order:
+        coords = np.argwhere(body == int(color))
+        assert coords.size > 0
+        rectangles[int(color)] = _bbox(coords)
+
+    return _render_body(body.shape[0], body.shape[1], bg, rectangles, order)
+
+
+def _visible_bbox_matches(body: np.ndarray, color: int, rect: Rect) -> bool:
+    coords = np.argwhere(body == int(color))
+    return bool(coords.size > 0 and _bbox(coords) == rect)
+
+
+def _union_area(height: int, width: int, rectangles: dict[int, Rect]) -> int:
+    mask = np.zeros((height, width), dtype=bool)
+    for r0, c0, r1, c1 in rectangles.values():
+        mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    return int(mask.sum())
+
+
+def _sample_spaced_positions(length: int, n: int) -> list[int] | None:
+    if length < 2 * n - 1:
+        return None
+    candidates = list(range(length))
+    for _ in range(LEGEND_RETRIES):
+        picked = sorted(random.sample(candidates, n))
+        if all(b - a >= 2 for a, b in zip(picked, picked[1:])):
+            return picked
+    return None
+
+
+def _sample_free_rect(height: int, width: int) -> Rect:
+    rect_h = random.randint(RECT_SIDE_RANGE[0], min(RECT_SIDE_RANGE[1], height))
+    rect_w = random.randint(RECT_SIDE_RANGE[0], min(RECT_SIDE_RANGE[1], width))
+    r0 = random.randint(0, height - rect_h)
+    c0 = random.randint(0, width - rect_w)
+    return int(r0), int(c0), int(r0 + rect_h - 1), int(c0 + rect_w - 1)
+
+
+def _sample_inner_box(rect: Rect) -> Rect | None:
+    r0, c0, r1, c1 = rect
+    inner_h = r1 - r0 - 1
+    inner_w = c1 - c0 - 1
+    if inner_h <= 0 or inner_w <= 0:
+        return None
+    box_h = random.randint(1, min(3, inner_h))
+    box_w = random.randint(1, min(3, inner_w))
+    box_r0 = random.randint(r0 + 1, r1 - box_h)
+    box_c0 = random.randint(c0 + 1, c1 - box_w)
+    return int(box_r0), int(box_c0), int(box_r0 + box_h - 1), int(box_c0 + box_w - 1)
+
+
+def _sample_rect_covering_box(height: int, width: int, box: Rect) -> Rect | None:
+    rect_h = random.randint(RECT_SIDE_RANGE[0], min(RECT_SIDE_RANGE[1], height))
+    rect_w = random.randint(RECT_SIDE_RANGE[0], min(RECT_SIDE_RANGE[1], width))
+
+    min_r0 = max(0, box[2] - rect_h + 1)
+    max_r0 = min(box[0], height - rect_h)
+    min_c0 = max(0, box[3] - rect_w + 1)
+    max_c0 = min(box[1], width - rect_w)
+    if min_r0 > max_r0 or min_c0 > max_c0:
+        return None
+
+    r0 = random.randint(min_r0, max_r0)
+    c0 = random.randint(min_c0, max_c0)
+    return int(r0), int(c0), int(r0 + rect_h - 1), int(c0 + rect_w - 1)
+
+
+def _overlap_stats(rect: Rect, lowers: list[Rect]) -> tuple[int, int] | None:
+    overlap_count = 0
+    overlap_area = 0
+    for lower in lowers:
+        inter = _intersection(rect, lower)
+        if inter is None:
+            continue
+        if not _strictly_inside(inter, lower):
+            return None
+        overlap_count += 1
+        overlap_area += _area(inter)
+
+    if overlap_count > MAX_OVERLAPS_PER_RECT:
+        return None
+    if overlap_area > MAX_OVERLAP_FRACTION * _area(rect):
+        return None
+    return overlap_count, overlap_area
+
+
+def _sample_rect(height: int, width: int, lowers: list[Rect], require_overlap: bool) -> Rect | None:
+    for _ in range(PLACEMENT_RETRIES):
+        rect: Rect | None
+        if lowers and (require_overlap or random.random() < 0.65):
+            target = random.choice(lowers)
+            box = _sample_inner_box(target)
+            if box is None:
+                continue
+            rect = _sample_rect_covering_box(height, width, box)
+        else:
