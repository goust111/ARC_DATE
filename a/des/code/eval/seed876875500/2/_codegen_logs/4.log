            if int(out[r, c]) == bg:
                out[r, c] = col_color

    for r in stripe_rows:
        for c in stripe_cols:
            if int(out[r, c]) == bg:
                out[r, c] = int(pair_to_mix[(int(row_colors[r]), int(col_colors[c]))])

