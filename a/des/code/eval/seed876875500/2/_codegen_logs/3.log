+
+
+def _union_ring_cells(spec: dict, h: int, w: int) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = _spec_box(spec)
+    cells: set[tuple[int, int]] = set()
+    for layer in range(1, spec["distinct"] + 1):
+        cells.update(_ring_cells(r0, c0, r1, c1, layer, h, w))
+    return cells
