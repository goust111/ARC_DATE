+    return grid
+
+
+def _intended_overlap_ok(specs: list[dict], h: int, w: int, overlap_case: bool) -> bool:
+    unions = [_union_ring_cells(spec, h, w) for spec in specs]
+    pair_hits = set()
+    for i in range(len(specs)):
