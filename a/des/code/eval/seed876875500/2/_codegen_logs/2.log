+def _stair_line(length: int, low: int, high: int, rng: random.Random) -> np.ndarray | None:
+    if low > high:
+        return None
+    cur = rng.randint(low, high)
+    vals = []
+    while len(vals) < length:
+        seg = rng.randint(1, 3)
