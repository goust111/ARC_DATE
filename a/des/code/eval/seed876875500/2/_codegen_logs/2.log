+    grid_w = frame_w + rng.randint(10, 16)
+    fr0 = (grid_h - frame_h) // 2 + rng.randint(-1, 1)
+    fc0 = (grid_w - frame_w) // 2 + rng.randint(-2, 2)
+    fr0 = max(2, min(fr0, grid_h - frame_h - 2))
+    fc0 = max(2, min(fc0, grid_w - frame_w - 2))
+    fr1 = fr0 + frame_h - 1
+    fc1 = fc0 + frame_w - 1
