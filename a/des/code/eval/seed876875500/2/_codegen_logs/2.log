+def _bbox_gap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> int:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+
+    def gap1(x0: int, x1: int, y0: int, y1: int) -> int:
+        if y1 < x0:
+            return x0 - y1
+        if x1 < y0:
+            return y0 - x1
+        return 0
+
+    return gap1(ar0, ar1, br0, br1) + gap1(ac0, ac1, bc0, bc1)
+
