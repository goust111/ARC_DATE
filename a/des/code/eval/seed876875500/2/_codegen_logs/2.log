+            for r, c in comp:
+                patch[r - r0, c - c0] = True
+            ring = np.zeros((h, w), dtype=bool)
+            ring[0, :] = True
+            ring[-1, :] = True
+            ring[:, 0] = True
+            ring[:, -1] = True
+            if not np.array_equal(patch, ring):
