+    inner = g[fr0 + 1 : fr1, fc0 + 1 : fc1]
+    hole_infos = []
+    for comp in _components(inner == bg):
+        if any(r == 0 or c == 0 or r == inner.shape[0] - 1 or c == inner.shape[1] - 1 for r, c in comp):
+            continue
