+    if kind == "t3v":
+        vcut = _stair_line(h, min_w, w - min_w, rng)
+        hcut = _stair_line(w, min_h, h - min_h, rng)
+        if vcut is None or hcut is None:
+            return None
+        right = cols >= vcut[:, None]
+        top = rows < hcut[None, :]
+        labels = np.zeros((h, w), dtype=int)
+        labels[right & top] = 1
+        labels[right & ~top] = 2
+        return labels
