+        if not np.array_equal(main(inp), target):
+            return None
+    except AssertionError:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
+        grid = _generate_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid sample")

