+    c1 = c0 + size + 1
+    patch[r0, c0 : c1 + 1] = GRAY
+    patch[r1, c0 : c1 + 1] = GRAY
+    patch[r0 : r1 + 1, c0] = GRAY
+    patch[r0 : r1 + 1, c1] = GRAY
+
