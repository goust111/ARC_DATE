                "mask": mask,
                "bbox": bbox,
                "socket_mask": sock,
                "cavity_mask": cavity,
                "cavity_bbox": cav_bbox,
                "open_dir": open_dir,
                "swap_needed": swap_needed,
                "single_piece": single_piece,
