+
+def _random_manhattan_path(
+    start: tuple[int, int],
+    end: tuple[int, int],
+) -> list[tuple[int, int]]:
+    r, c = start
+    tr, tc = end
+    out = [(r, c)]
+    while (r, c) != (tr, tc):
+        moves = []
+        if r < tr:
+            moves.append((1, 0))
+        elif r > tr:
+            moves.append((-1, 0))
+        if c < tc:
+            moves.append((0, 1))
+        elif c > tc:
+            moves.append((0, -1))
+        dr, dc = random.choice(moves)
+        r += dr
+        c += dc
+        out.append((r, c))
+    return out
+
+
+def _random_shape(size: int, anchor_row: int) -> np.ndarray:
+    assert 0 <= anchor_row < size
+    target_min = size + 2
+    center = (size // 2, size // 2)
+
+    for _ in range(200):
+        required = {
+            center,
+            (anchor_row, size - 1),
+            (random.randrange(size), 0),
+            (0, random.randrange(size)),
+            (size - 1, random.randrange(size)),
+        }
+        cells = {center}
+        for pt in required:
+            cells.update(_random_manhattan_path(center, pt))
+
+        target_area = random.randint(max(target_min, len(cells)), size * size - 1)
+        while len(cells) < target_area:
+            frontier = []
+            for r, c in sorted(cells):
+                for dr, dc in DIRS4:
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < size and 0 <= nc < size and (nr, nc) not in cells:
+                        frontier.append((nr, nc))
+            if not frontier:
+                break
+            cells.add(random.choice(frontier))
+
+        mask = np.zeros((size, size), dtype=bool)
+        for r, c in cells:
+            mask[r, c] = True
+
+        if not mask[:, 0].any() or not mask[:, -1].any() or not mask[0, :].any() or not mask[-1, :].any():
+            continue
+        if not bool(mask[anchor_row, size - 1]):
+            continue
