+            continue
+        if not bool(np.all(patch[~border_mask] == BLACK)):
+            continue
+        candidates.append((int(h * w), (int(r0), int(c0), int(r1), int(c1))))
+    assert len(candidates) == 1, "expected exactly one maroon output frame"
+    return candidates[0][1]
