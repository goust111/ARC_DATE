+
+def _extract_pairs(grid: np.ndarray) -> list[dict[str, object]]:
+    pairs: list[dict[str, object]] = []
+    colors = sorted(set(map(int, grid.flatten())) - {BLACK, GREY, MAROON})
+    for color in colors:
