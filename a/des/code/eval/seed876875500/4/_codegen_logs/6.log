+def _is_filled_rectangle(grid: np.ndarray, color: int, coords: np.ndarray) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    area = int((r1 - r0 + 1) * (c1 - c0 + 1))
+    return int(coords.shape[0]) == area and bool(np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == int(color)))
