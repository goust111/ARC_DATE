+        r0, c0, r1, c1 = _bbox(coords)
+        h = int(r1 - r0 + 1)
+        w = int(c1 - c0 + 1)
+        if h < 3 or w < 3:
+            continue
+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        border_mask = np.zeros((h, w), dtype=bool)
+        border_mask[0, :] = True
+        border_mask[-1, :] = True
+        border_mask[:, 0] = True
+        border_mask[:, -1] = True
