+    conflict = []
+    row_only = []
+    col_only = []
+    both = []
+    neither = []
+
+    for r in range(rows):
+        if r == sample_row:
+            continue
+        for c in range(cols):
+            if c == sample_col:
+                continue
+            rr = int(row_colors[r])
+            cc = int(col_colors[c])
+            if rr != BG and cc != BG:
+                both.append((r, c))
+                if rr != cc:
+                    conflict.append((r, c))
+            elif rr != BG:
+                row_only.append((r, c))
+            elif cc != BG:
+                col_only.append((r, c))
+            else:
