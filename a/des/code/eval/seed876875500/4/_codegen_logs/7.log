+    for r in range(rows):
+        r0 = 1 + r * (cell_size + 1)
+        r1 = r0 + cell_size
+        for c in range(cols):
+            c0 = 1 + c * (cell_size + 1)
+            c1 = c0 + cell_size
+            grid[r0:r1, c0:c1] = int(cells[r, c])
