+def _line_indices(grid: np.ndarray, color: int, axis: int) -> list[int]:
+    if axis == 0:
+        return [idx for idx in range(grid.shape[0]) if np.all(grid[idx, :] == color)]
+    return [idx for idx in range(grid.shape[1]) if np.all(grid[:, idx] == color)]
