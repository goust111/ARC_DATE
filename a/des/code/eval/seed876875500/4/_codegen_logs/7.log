+        has_neither = any(row_colors[r] == BG and col_colors[c] == BG for r in other_rows for c in other_cols)
+        has_conflict = any(
+            row_colors[r] != BG and col_colors[c] != BG and row_colors[r] != col_colors[c]
+            for r in other_rows
+            for c in other_cols
+        )
