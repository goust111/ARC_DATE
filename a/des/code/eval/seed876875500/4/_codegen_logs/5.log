+
+
+def _place_path(
+    grid: np.ndarray,
+    occupied: set[tuple[int, int]],
+    grey_cells: set[tuple[int, int]],
+    receiver_cells: set[tuple[int, int]],
+    side: str,
+    emitter_color: int,
+    reflections: int,
+    rng: random.Random,
+) -> tuple[dict[str, object], set[tuple[int, int]], set[tuple[int, int]], set[tuple[int, int]]] | None:
+    h, w = grid.shape
+    emitters = _edge_positions(side, h, w)
+    rng.shuffle(emitters)
+
+    for emitter in emitters:
+        if emitter in occupied:
+            continue
+        result = _extend_path(
+            h,
+            w,
+            emitter,
+            SIDE_TO_DIR[side],
+            reflections,
+            occupied | {emitter},
+            grey_cells,
+            receiver_cells,
+            rng,
+        )
+        if result is None:
+            continue
