+        key=lambda i: (len(placements[i]), -int(fragments[i]["size"])),
+    )
+    total = 0
+
+    def search(depth: int, occupied: int) -> None:
+        nonlocal total
+        if total >= limit:
+            return
+        if depth == len(order):
+            total += 1
+            return
+        index = order[depth]
+        for mask in placements[index]:
+            if occupied & mask:
+                continue
+            search(depth + 1, occupied | mask)
+            if total >= limit:
