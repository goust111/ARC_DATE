+def _randint(low: int, high: int) -> int:
+    return int(RNG.integers(low, high + 1))
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int, height: int, width: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < height:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < width:
+        yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    height, width = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    result: list[list[tuple[int, int]]] = []
+    for r in range(height):
+        for c in range(width):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, height, width):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            result.append(cells)
+    return result
+
+
+def _normalize_fragment(cells: list[tuple[int, int]]) -> dict[str, object]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    r0, c0 = min(rows), min(cols)
+    local = tuple(sorted((r - r0, c - c0) for r, c in cells))
+    height = max(rows) - r0 + 1
+    width = max(cols) - c0 + 1
+    return {
+        "cells": local,
+        "height": int(height),
+        "width": int(width),
+        "size": int(len(cells)),
+    }
+
+
+def _factor_pairs(area: int) -> list[tuple[int, int]]:
+    pairs: list[tuple[int, int]] = []
+    for h in range(1, int(area ** 0.5) + 1):
+        if area % h != 0:
+            continue
+        w = area // h
+        pairs.append((h, w))
+        if h != w:
+            pairs.append((w, h))
+    pairs.sort()
+    return pairs
+
+
+def _placement_masks(fragment: dict[str, object], height: int, width: int) -> list[int]:
+    frag_h = int(fragment["height"])
+    frag_w = int(fragment["width"])
+    if frag_h > height or frag_w > width:
+        return []
+    cells = fragment["cells"]
+    placements: list[int] = []
+    for r0 in range(height - frag_h + 1):
+        for c0 in range(width - frag_w + 1):
+            mask = 0
+            for r, c in cells:
+                bit = (r0 + r) * width + (c0 + c)
+                mask |= 1 << bit
+            placements.append(mask)
+    return placements
+
+
+def _count_tilings_for_dims(
+    fragments: list[dict[str, object]],
+    height: int,
+    width: int,
+    limit: int = 2,
+) -> int:
+    placements = [_placement_masks(fragment, height, width) for fragment in fragments]
+    if any(not options for options in placements):
+        return 0
+
+    order = sorted(
+        range(len(fragments)),
+        key=lambda i: (len(placements[i]), -int(fragments[i]["size"])),
+    )
+    total = 0
+
+    def search(depth: int, occupied: int) -> None:
+        nonlocal total
+        if total >= limit:
+            return
+        if depth == len(order):
+            total += 1
+            return
+        index = order[depth]
+        for mask in placements[index]:
+            if occupied & mask:
+                continue
+            search(depth + 1, occupied | mask)
+            if total >= limit:
