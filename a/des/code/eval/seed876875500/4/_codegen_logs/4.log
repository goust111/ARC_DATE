+    grid = _scatter_fragments(rectangles)
+    if grid is None:
+        return None
+
+    expected = _expected_output(rectangles)
+    try:
+        actual = main(grid)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
