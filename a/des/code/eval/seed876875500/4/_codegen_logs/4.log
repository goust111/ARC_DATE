+    return anchor
+
+
+def _stack_rectangles(rectangles: list[dict[str, int]], bg: int) -> np.ndarray:
+    out_h = max(int(rectangle["height"]) for rectangle in rectangles)
+    out_w = max(int(rectangle["width"]) for rectangle in rectangles)
