+    cuts = sorted(int(x) for x in RNG.choice(np.arange(1, total), size=count - 1, replace=False))
+    values: list[int] = []
+    prev = 0
+    for cut in cuts + [total]:
+        values.append(cut - prev)
+        prev = cut
+    return values
