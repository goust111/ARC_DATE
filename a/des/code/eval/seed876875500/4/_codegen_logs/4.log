+        best_options: list[int] | None = None
+
+        for index in remaining:
+            options = [
+                mask
+                for mask in placements[index]
+                if (mask & target_mask) and not (occupied & mask)
+            ]
+            if not options:
+                continue
+            if best_options is None or len(options) < len(best_options):
+                best_index = index
+                best_options = options
