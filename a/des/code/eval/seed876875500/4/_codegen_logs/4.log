+
+        ok = True
+        for _ in range(count - 1):
+            candidates: list[tuple[int, int]] = []
+            for h in range(2, cur_h + 1):
+                for w in range(2, cur_w + 1):
+                    area = h * w
+                    if area >= cur_h * cur_w:
