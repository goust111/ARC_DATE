+
+def _gen_attempt() -> np.ndarray | None:
+    rect_count = _randint(*RECT_COUNT_RANGE)
+    dims = _sample_nested_dims(rect_count)
+    if dims is None:
+        return None
+
+    colors = list(RNG.choice(COLOR_POOL, size=rect_count, replace=False))
