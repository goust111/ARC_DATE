+    items: list[tuple[int, dict[str, object]]] = []
+    for rectangle in rectangles:
+        color = int(rectangle["color"])
+        for fragment in rectangle["fragments"]:
+            items.append((color, fragment))
+
+    RNG.shuffle(items)
