+    corners = [(0, 0), (0, grid_w - 1), (grid_h - 1, 0), (grid_h - 1, grid_w - 1)]
+    anchor_r, anchor_c = corners[_randint(0, 3)]
+    grid[anchor_r, anchor_c] = ANCHOR_COLOR
