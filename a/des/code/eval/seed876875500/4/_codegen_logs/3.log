+def _apply_sequence(seed: np.ndarray, legend: list[int], frame_colors: Iterable[int]) -> np.ndarray:
+    out = seed.copy()
+    color_to_index = {color: idx for idx, color in enumerate(legend)}
+    for color in frame_colors:
