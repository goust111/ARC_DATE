+    if r1 > r0:
+        for c in range(c1, c0 - 1, -1):
+            coords.append((r1, c))
+    if c1 > c0:
+        for r in range(r1 - 1, r0, -1):
+            coords.append((r, c0))
+    return coords
+
+
