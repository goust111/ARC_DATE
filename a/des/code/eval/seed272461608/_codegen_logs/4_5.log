+
+def _sample_shortened(span: int) -> tuple[int, int]:
+    while True:
+        start_gap = random.randint(2, max(2, span - 4))
+        end_gap = random.randint(2, max(2, span - start_gap - 2))
+        if span - start_gap - end_gap >= 2:
