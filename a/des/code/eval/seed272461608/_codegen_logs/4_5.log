+    for r, c in _sample_cells(_interior_cells(h, w), (1, 3)):
+        if int(patch[r, c]) == BG:
+            patch[r, c] = YELLOW
+
+    for r, c in _sample_cells(_outside_cells(h, w), (0, 2)):
+        if int(patch[r, c]) == BG:
+            patch[r, c] = YELLOW
