+                    if seen[rr, cc] or int(g[rr, cc]) != color:
+                        continue
+                    seen[rr, cc] = True
+                    stack.append((rr, cc))
+
+            rows = [r for r, _ in coords]
+            cols = [c for _, c in coords]
+            r1 = min(rows)
+            r2 = max(rows)
+            c1 = min(cols)
+            c2 = max(cols)
+            mask = np.zeros((r2 - r1 + 1, c2 - c1 + 1), dtype=bool)
+            rel_coords: list[tuple[int, int]] = []
+            for r, c in coords:
+                rr = r - r1
+                cc = c - c1
+                mask[rr, cc] = True
+                rel_coords.append((rr, cc))
+
+            components.append(
