+    total_boxes = sum((mask.shape[0] + 2) * (mask.shape[1] + 2) for pair in shapes for mask in pair)
+    side = max(
+        GEN_GRID_MIN,
+        int(np.ceil(np.sqrt(total_boxes * random.uniform(1.35, 1.8)))),
