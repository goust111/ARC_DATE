+GEN_PAIR_COUNT_CHOICES = (2, 3, 4)
+GEN_BBOX_HEIGHTS = (3, 4, 5, 6)
+GEN_BBOX_WIDTHS = (3, 4, 5, 6)
+GEN_REPEAT_SIZE_PROB = 0.35
+GEN_GRID_MIN = 14
+GEN_GRID_MAX = 28
+GEN_PLACEMENT_PAD = 1
