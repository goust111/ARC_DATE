import random, numpy as np

NEI=[(1,0),(-1,0),(0,1),(0,-1)]

def build(h,w,sr,sc,cuts):
    oh,ow=h-sr,w-sc
    A=np.zeros((h,w),dtype=bool)
    B=np.zeros((h,w),dtype=bool)
    # exclusive regions
    for r in range(h):
        for c in range(w):
            if r < sr or c < sc:
                A[r,c]=True
            else:
                u,v=r-sr,c-sc
                if 0<=u<oh and 0<=v<ow:
                    if v < cuts[u]:
                        A[r,c]=True
                    else:
                        B[u,v]=True
                else:
                    raise RuntimeError
    for r in range(h):
        for c in range(w):
            if r >= h-sr or c >= w-sc:
                B[r,c]=True
    return A,B

def conn(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:return False
    H,W=mask.shape
    st=[tuple(map(int,pts[0]))]; seen={st[0]}
    while st:
        r,c=st.pop()
        for dr,dc in NEI:
            rr,cc=r+dr,c+dc
            if 0<=rr<H and 0<=cc<W and mask[rr,cc] and (rr,cc) not in seen:
                seen.add((rr,cc)); st.append((rr,cc))
    return len(seen)==int(mask.sum())

def bbox_full(mask):
    pts=np.argwhere(mask)
    r0,c0=pts.min(axis=0); r1,c1=pts.max(axis=0)
    return (r0,c0,r1,c1)==(0,0,mask.shape[0]-1,mask.shape[1]-1)

def pairable(A,B):
    h,w=A.shape
    area=A.sum()+B.sum()
    sols=[]
    for dr in range(-h,h+1):
      for dc in range(-w,w+1):
        if dr==0 and dc==0: continue
        rmin=min(0,dr); cmin=min(0,dc)
        H=max(h,dr+h)-rmin; W=max(w,dc+w)-cmin
        if H*W"'!=area: continue
        canvas=np.zeros((H,W),dtype=int)
        overlap=False
        for r,c in np.argwhere(A):
          rr,cc=r-rmin,c-cmin
          canvas[rr,cc]+=1
          if canvas[rr,cc]>1: overlap=True
        for r,c in np.argwhere(B):
          rr,cc=r+dr-rmin,c+dc-cmin
          canvas[rr,cc]+=1
          if canvas[rr,cc]>1: overlap=True
        if not overlap and canvas.all():
          sols.append((dr,dc))
    return sols

for _ in range(20):
    h=random.randint(3,5); w=random.randint(3,5)
    sr=random.randint(0,h-2)
    sc=random.randint(1,w-1)
    oh=h-sr; ow=w-sc
    rows=list(range(oh))
    random.shuffle(rows)
    z=rows[0]; o=rows[-1]
    cuts=[random.randint(0,ow) for _ in range(oh)]
    cuts[z]=0; cuts[o]=ow
    A,B=build(h,w,sr,sc,cuts)
    if not (conn(A) and conn(B) and bbox_full(A) and bbox_full(B)):
        print('"'bad connectivity/bbox',h,w,sr,sc,cuts)
        print(A.astype(int)); print(B.astype(int)); break
    sols=pairable(A,B)
    print((h,w,sr,sc,cuts), len(sols), sols[:5], np.argwhere(A)[:,1].mean(), np.argwhere(B)[:,1].mean())
