+def _gen_attempt() -> np.ndarray | None:
+    pair_count = random.choice(GEN_PAIR_COUNT_CHOICES)
+    shapes = _pick_pair_shapes(pair_count)
+    colors = random.sample(range(1, 10), 2 * pair_count)
+    rendered = _render_pair_grid(shapes, colors)
