+def _render_pair_grid(shapes: list[tuple[np.ndarray, np.ndarray]], colors: list[int]) -> tuple[np.ndarray, np.ndarray] | None:
+    total_boxes = sum((mask.shape[0] + 2) * (mask.shape[1] + 2) for pair in shapes for mask in pair)
+    side = max(
