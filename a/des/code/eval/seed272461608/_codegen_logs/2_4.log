import random
from collections import deque

random.seed(0)
DIRS=[(1,0),(-1,0),(0,1),(0,-1)]

def connected(cells):
    if not cells: return False
    q=deque([next(iter(cells))]); seen={q[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in DIRS:
            nr,nc=r+dr,c+dc
            if (nr,nc) in cells and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return seen==cells

def grow_partition(H,W,areas):
    cells=[(r,c) for r in range(H) for c in range(W)]
    starts=random.sample(cells,3)
    groups=[{starts[i]} for i in range(3)]
    owners={starts[i]:i for i in range(3)}
    frontier=[set() for _ in range(3)]
    for i,(r,c) in enumerate(starts):
        for dr,dc in DIRS:
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and (nr,nc) not in owners:
                frontier[i].add((nr,nc))
    order=[i for i,a in enumerate(areas) for _ in range(a-1)]
    random.shuffle(order)
    for i in order:
        opts=list(frontier[i])
        if not opts:
            return None
        cell=random.choice(opts)
        groups[i].add(cell); owners[cell]=i
        for j in range(3):
            frontier[j].discard(cell)
        r,c=cell
        for dr,dc in DIRS:
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and (nr,nc) not in owners:
                frontier[i].add((nr,nc))
    if len(owners)"'!=H*W: return None
    return groups

def pair_ok(groups,a,b,c):
    for r,cc in groups[c]:
        neigh=set()
        for dr,dc in DIRS:
            nr,nc=r+dr,cc+dc
            for lab,g in enumerate(groups):
                if (nr,nc) in g:
                    neigh.add(lab)
        if a in neigh and b in neigh:
            return True
    return False

for H,W in [(4,4),(4,5),(5,4),(5,5)]:
    seen=set(); found=0
    print('"'SIZE',H,W)
    for _ in range(200000):
        # sample areas 3..8 summing H*W
        cand=[]
        for a in range(3,9):
            for b in range(3,9):
                c=H*W-a-b
                if 3<=c<=8:
                    cand.append((a,b,c))
        if not cand: break
        areas=random.choice(cand)
        groups=grow_partition(H,W,areas)
        if not groups: continue
        if any(not connected(g) for g in groups): continue
        if not (pair_ok(groups,0,1,2) and pair_ok(groups,0,2,1) and pair_ok(groups,1,2,0)):
            continue
        # canonical string
        arr=[['?']*W for _ in range(H)]
        labs='ABC'
        for i,g in enumerate(groups):
            for r,c in g: arr[r][c]=labs[i]
        s='\\n'.join(''.join(row) for row in arr)
        if s in seen: continue
        seen.add(s)
        print('areas',areas)
        print(s)
        print()
        found+=1
        if found>=8: break
    print('found',found)
