+        "A": {tuple(connectors[("A", "B")]), tuple(connectors[("A", "C")])},
+        "B": {tuple(connectors[("A", "B")]), tuple(connectors[("B", "C")])},
+        "C": {tuple(connectors[("A", "C")]), tuple(connectors[("B", "C")])},
+    }
