+    for spec in ordered_specs:
+        min_r, min_c, max_r, max_c = spec["bbox"]
+        row_lo = -min_r
+        row_hi = h - 1 - max_r
+        col_lo = -min_c
+        col_hi = w - 1 - max_c
+        if row_lo > row_hi or col_lo > col_hi:
