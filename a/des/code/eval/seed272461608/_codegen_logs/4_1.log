+def _padded(coords: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:
+    padded: set[tuple[int, int]] = set()
+    for r, c in coords:
+        for rr in range(r - 1, r + 2):
+            for cc in range(c - 1, c + 2):
+                if 0 <= rr < h and 0 <= cc < w:
