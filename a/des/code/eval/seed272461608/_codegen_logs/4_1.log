+
+    seed_specs: list[dict] = []
+    for color, side in zip(seed_colors, seed_sides, strict=False):
+        r, c = positions[side]
+        seed_specs.append(
+            {
+                "color": int(color),
+                "wall": side,
+                "r": int(r),
+                "c": int(c),
+                "distance": _axis_distance(int(r), int(c), 0, 0, ih + 1, iw + 1, gap_side),
