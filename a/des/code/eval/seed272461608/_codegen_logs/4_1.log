+                expected[int(r + shift_r), int(c + shift_c)] = int(color)
+            reserved |= _padded(translated, h, w)
+            placed = True
+            break
+
+        if not placed:
+            return None
+
+    return grid, expected
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(18, 30)
+    w = rng.randint(18, 30)
+    obj_count = rng.randint(1, 3)
