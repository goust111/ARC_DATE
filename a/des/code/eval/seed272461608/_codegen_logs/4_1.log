+            shift_r = rng.randint(row_lo, row_hi)
+            shift_c = rng.randint(col_lo, col_hi)
+            translated = {(int(r + shift_r), int(c + shift_c)) for r, c in spec["footprint"]}
+            if any(cell in reserved for cell in translated):
