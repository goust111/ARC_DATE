+    expected = np.zeros((h, w), dtype=int)
+    reserved: set[tuple[int, int]] = set()
+
+    ordered_specs = sorted(
+        specs,
+        key=lambda spec: (
+            -len(spec["footprint"]),
+            -(spec["bbox"][2] - spec["bbox"][0] + 1) * (spec["bbox"][3] - spec["bbox"][1] + 1),
