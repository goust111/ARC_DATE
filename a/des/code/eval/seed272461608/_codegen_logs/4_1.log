+    max_r = max(r for r, _ in footprint)
+    min_c = min(c for _, c in footprint)
+    max_c = max(c for _, c in footprint)
+
+    return {
+        "input_map": input_map,
+        "output_map": output_map,
+        "footprint": footprint,
+        "bbox": (int(min_r), int(min_c), int(max_r), int(max_c)),
+    }
