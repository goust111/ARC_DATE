+    if total < count * 2:
+        return None
+    for _ in range(300):
+        cuts = sorted(rng.sample(range(1, total), count - 1))
+        prev = 0
+        widths = []
+        for cut in cuts + [total]:
+            widths.append(cut - prev)
+            prev = cut
+        if min(widths) >= 2 and len(set(widths)) == count:
+            return widths
+    return None
+
+
+def _split_options(room: tuple[int, int, int, int]) -> list[tuple[str, list[int]]]:
+    r0, r1, c0, c1 = room
