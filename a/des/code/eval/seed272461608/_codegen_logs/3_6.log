+            elif branch == "exact":
+                current_len = target_len
+                final_len = target_len
+                stop_extra = None
+            elif branch == "extend_clear":
+                min_len = max(thickness + 1, target_len - 3)
+                if min_len > target_len - 1:
+                    continue
+                current_len = _randint(min_len, target_len - 1)
