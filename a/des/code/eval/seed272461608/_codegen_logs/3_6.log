+def _branch_list(n: int) -> list[str]:
+    branches = ["clip", "extend_clear", "extend_blocked"]
+    extras = ["clip", "extend_clear", "extend_blocked", "exact"]
+    while len(branches) < n:
+        branches.append(str(_RNG.choice(extras)))
+    _RNG.shuffle(branches)
