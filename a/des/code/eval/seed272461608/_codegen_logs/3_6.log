+        return None
+
+    bands = _place_bands(height, thicknesses)
+    if bands is None:
+        return None
+
+    max_target = max(ruler_lengths)
+    min_width = max(14, max_target + 7)
+    max_width = max(min_width, max_target + 13)
+    width = _randint(min_width, max_width)
+
