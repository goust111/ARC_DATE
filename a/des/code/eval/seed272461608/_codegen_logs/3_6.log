+    color_to_len = scene["color_to_len"]
+
+    out = g.copy()
+    for bar in scene["bars"]:
+        color = int(bar["color"])
+        target = int(color_to_len[color])
+        r0, c0, r1, c1 = map(int, bar["bbox"])
