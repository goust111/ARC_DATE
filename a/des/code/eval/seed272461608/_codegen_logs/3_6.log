+    if side == "left":
+        ruler_values = grid[:, 0]
+        ruler_mask = np.zeros_like(grid, dtype=bool)
+        ruler_mask[:, 0] = True
+        expected_orientation = "horizontal"
+    else:
+        ruler_values = grid[0, :]
