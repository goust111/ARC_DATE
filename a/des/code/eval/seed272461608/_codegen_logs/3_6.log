+    top_blocked = r0 == 0 or np.all(grid[r0 - 1, c0 : c1 + 1] != bg)
+    bottom_blocked = r1 == h - 1 or np.all(grid[r1 + 1, c0 : c1 + 1] != bg)
+    if top_blocked == bottom_blocked:
+        return None
+    return "top" if top_blocked else "bottom"
