+        if bar["orientation"] == "horizontal":
+            length = c1 - c0 + 1
+            if bar["anchor"] == "left":
+                if length > target:
+                    out[r0 : r1 + 1, c0 + target : c1 + 1] = bg
+                    length = target
+                    c1 = c0 + target - 1
+                while length < target:
+                    nc = c1 + 1
+                    if nc >= g.shape[1] or not np.all(g[r0 : r1 + 1, nc] == bg):
+                        break
+                    out[r0 : r1 + 1, nc] = color
+                    c1 = nc
+                    length += 1
+            else:
+                if length > target:
+                    out[r0 : r1 + 1, c0 : c1 - target + 1] = bg
+                    length = target
+                    c0 = c1 - target + 1
+                while length < target:
