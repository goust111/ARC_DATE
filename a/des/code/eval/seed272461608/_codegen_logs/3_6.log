+                    out[r0 + target : r1 + 1, c0 : c1 + 1] = bg
+                    length = target
+                    r1 = r0 + target - 1
+                while length < target:
+                    nr = r1 + 1
+                    if nr >= g.shape[0] or not np.all(g[nr, c0 : c1 + 1] == bg):
+                        break
+                    out[nr, c0 : c1 + 1] = color
+                    r1 = nr
+                    length += 1
+            else:
+                if length > target:
+                    out[r0 : r1 - target + 1, c0 : c1 + 1] = bg
+                    length = target
+                    r0 = r1 - target + 1
+                while length < target:
+                    nr = r0 - 1
+                    if nr < 0 or not np.all(g[nr, c0 : c1 + 1] == bg):
+                        break
+                    out[nr, c0 : c1 + 1] = color
+                    r0 = nr
+                    length += 1
