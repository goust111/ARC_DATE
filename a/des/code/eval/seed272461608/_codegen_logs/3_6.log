+    width = _randint(min_width, max_width)
+
+    colors = list(map(int, _RNG.choice(_PALETTE, size=n_bars + 2, replace=False)))
+    bg = colors[0]
+    obstacle_color = colors[1]
+    bar_colors = colors[2:]
+    _RNG.shuffle(bar_colors)
