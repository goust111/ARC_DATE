+            turns = {idx: int((ori - orientations[0]) % 4) for idx, ori in enumerate(orientations)}
+            if {int(v) for v in turns.values()} != {0, 1, 2, 3}:
+                continue
+            candidates.append((int(border.sum()), bbox, turns))
