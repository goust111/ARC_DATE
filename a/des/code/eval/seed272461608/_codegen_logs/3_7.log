+def _build_l_patch(orientation: int, size: int = 3) -> np.ndarray:
+    patch = np.zeros((size, size), dtype=bool)
+    if orientation == 0:
+        patch[-1, :] = True
+        patch[:, 0] = True
+    elif orientation == 1:
+        patch[0, :] = True
+        patch[:, 0] = True
+    elif orientation == 2:
+        patch[0, :] = True
+        patch[:, -1] = True
+    elif orientation == 3:
+        patch[-1, :] = True
+        patch[:, -1] = True
+    else:
