+                    local = np.zeros((pr1 - pr0 + 1, pc1 - pc0 + 1), dtype=bool)
+                    for rr, cc in cells:
+                        local[rr - pr0, cc - pc0] = True
+                    orientations.append(_classify_l(local))
+            except AssertionError:
+                continue
