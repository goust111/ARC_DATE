+    ph, pw = patch_mask.shape
+    if r0 < 0 or c0 < 0 or r0 + ph > h or c0 + pw > w:
+        return False
+    for rr, cc in np.argwhere(patch_mask):
+        r = int(r0 + rr)
+        c = int(c0 + cc)
