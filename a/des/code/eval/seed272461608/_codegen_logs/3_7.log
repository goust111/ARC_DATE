+
+def _touches_corner(bbox: tuple[int, int, int, int], shape: tuple[int, int]) -> bool:
+    r0, c0, r1, c1 = bbox
+    h, w = shape
+    return (
+        (r0 == 0 and c0 == 0)
+        or (r0 == 0 and c1 == w - 1)
+        or (r1 == h - 1 and c0 == 0)
+        or (r1 == h - 1 and c1 == w - 1)
