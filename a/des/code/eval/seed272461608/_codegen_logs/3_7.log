+    assert objects, "expected at least one non-legend object"
+
+    for color, cells in objects:
+        r0, c0, r1, c1 = _bbox(cells)
+        patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+        for rr, cc in cells:
+            patch[rr - r0, cc - c0] = color
