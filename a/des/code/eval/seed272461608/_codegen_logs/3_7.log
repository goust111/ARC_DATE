+    legend = np.zeros((5, 17), dtype=int)
+    legend[1:-1, 1:-1] = inner
+    legend[0, :] = frame_color
+    legend[-1, :] = frame_color
+    legend[:, 0] = frame_color
+    legend[:, -1] = frame_color
