+
+    out = g.copy()
+    object_cells = (g != bg) & (~legend_mask)
+    out[object_cells] = bg
+
+    objects: list[tuple[int, list[tuple[int, int]]]] = []
+    for color0 in np.unique(g[~legend_mask]):
+        color = int(color0)
+        if color == bg:
+            continue
+        for comp in _components((g == color) & (~legend_mask)):
+            objects.append((color, comp))
