+) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    hh, ww = rotated_shape
+    nr0 = (int(r0 + r1) - (int(hh) - 1)) // 2
+    nc0 = (int(c0 + c1) - (int(ww) - 1)) // 2
+    return int(nr0), int(nc0)
