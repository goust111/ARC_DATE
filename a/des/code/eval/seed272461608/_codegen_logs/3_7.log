+def _legend_position(shape: tuple[int, int], corner: str, legend_shape: tuple[int, int]) -> tuple[int, int]:
+    h, w = shape
+    lh, lw = legend_shape
+    if corner == "tl":
+        return 0, 0
+    if corner == "tr":
+        return 0, w - lw
+    if corner == "bl":
+        return h - lh, 0
+    return h - lh, w - lw
