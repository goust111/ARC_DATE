+def _mark_occupied(occupied: np.ndarray, patch_mask: np.ndarray, r0: int, c0: int) -> None:
+    ph, pw = patch_mask.shape
+    occupied[r0 : r0 + ph, c0 : c0 + pw] |= patch_mask
+
