+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            seen[r, c] = True
+            q: deque[tuple[int, int]] = deque([(int(r), int(c))])
+            cells: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((int(cr), int(cc)))
+                for dr, dc in DIR4:
+                    nr = cr + dr
+                    nc = cc + dc
