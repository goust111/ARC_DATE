+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_ATTEMPTS = 400
+GEN_SHAPE_ATTEMPTS = 200
+GEN_PLACE_ATTEMPTS = 300
+GEN_COLORS = list(range(10))
