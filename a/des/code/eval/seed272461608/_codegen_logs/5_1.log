+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(int(rr), int(cc)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((int(nr), int(nc)))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _enclosed_cells(border_mask: np.ndarray) -> np.ndarray:
+    h, w = border_mask.shape
+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if not border_mask[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((int(r), int(c)))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not border_mask[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((int(r), int(c)))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and not border_mask[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((int(nr), int(nc)))
+
+    return (~border_mask) & (~outside)
