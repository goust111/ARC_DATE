+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+
+
+def _neighbors4(r: int, c: int) -> tuple[Coord, Coord, Coord, Coord]:
+    return (r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[int(np.argmax(counts))])
+
+
+def _components(mask: np.ndarray) -> list[list[Coord]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[Coord]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[Coord] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _touches_border(cells: list[Coord], shape: tuple[int, int]) -> bool:
+    h, w = shape
+    return any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in cells)
+
+
+def _outside_bg_mask(grid: np.ndarray, bg: int) -> np.ndarray:
+    h, w = grid.shape
+    outside = np.zeros((h, w), dtype=bool)
+    q = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if int(grid[r, c]) == bg and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if int(grid[r, c]) == bg and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and int(grid[nr, nc]) == bg and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+    return outside
+
