+def _wall_color(grid: np.ndarray, bg: int) -> int:
+    vals, counts = np.unique(grid[grid != bg], return_counts=True)
+    assert len(vals) > 0, "expected at least one non-background color"
+    return int(vals[int(np.argmax(counts))])
