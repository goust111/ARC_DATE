+def _render_periodic(tile: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    pr, pc = tile.shape
+    h, w = shape
+    out = np.empty((h, w), dtype=int)
+    for r in range(h):
+        for c in range(w):
+            out[r, c] = int(tile[r % pr, c % pc])
+    return out
