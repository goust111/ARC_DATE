+    result = []
+    if rr > 0:
+        result.append((rr - 1, cc))
+    if rr + 1 < region_rows:
+        result.append((rr + 1, cc))
+    if cc > 0:
+        result.append((rr, cc - 1))
+    if cc + 1 < region_cols:
+        result.append((rr, cc + 1))
+    return result
+
+
+def _make_arrow_mask(direction: str, cell_h: int, cell_w: int) -> np.ndarray:
+    mask = np.zeros((cell_h, cell_w), dtype=bool)
