+def _blank_grid(region_rows: int, region_cols: int, cell_h: int, cell_w: int) -> np.ndarray:
+    height = region_rows * cell_h + region_rows + 1
+    width = region_cols * cell_w + region_cols + 1
+    grid = np.full((height, width), BLACK, dtype=int)
+    grid[:: cell_h + 1, :] = GREY
+    grid[:, :: cell_w + 1] = GREY
+    return grid
