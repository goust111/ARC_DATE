+    depths = {cell: 0 for cell in roots}
+
+    while len(assigned) < len(cells):
+        frontier: list[tuple[tuple[int, int], list[tuple[int, int]]]] = []
+        for cell in cells:
+            if cell in assigned:
+                continue
+            neighbors = [nbr for nbr in _neighbors(cell, region_rows, region_cols) if nbr in assigned]
