+    return patch
+
+
+def _expand_mask(mask: np.ndarray) -> np.ndarray:
+    expanded = mask.copy()
+    coords = np.argwhere(mask)
+    for rr, cc in coords:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr = int(rr + dr)
+                nc = int(cc + dc)
+                if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1]:
