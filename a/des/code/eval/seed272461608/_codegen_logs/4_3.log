+
+def _neighbors(cell: tuple[int, int], region_rows: int, region_cols: int) -> list[tuple[int, int]]:
+    rr, cc = cell
+    result = []
+    if rr > 0:
+        result.append((rr - 1, cc))
+    if rr + 1 < region_rows:
+        result.append((rr + 1, cc))
+    if cc > 0:
+        result.append((rr, cc - 1))
+    if cc + 1 < region_cols:
+        result.append((rr, cc + 1))
+    return result
