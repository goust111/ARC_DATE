+def _region_view(grid: np.ndarray, row_lines: list[int], col_lines: list[int], rr: int, cc: int) -> np.ndarray:
+    r0 = row_lines[rr] + 1
+    r1 = row_lines[rr + 1]
+    c0 = col_lines[cc] + 1
+    c1 = col_lines[cc + 1]
