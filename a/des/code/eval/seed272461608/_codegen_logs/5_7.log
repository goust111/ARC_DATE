+import numpy as np
+
+
+BG_COLOR = 3
+FRAME_COLOR = 9
+MARKER_COLOR = 7
+ITEM_COLORS = (0, 1, 2, 4, 5, 6, 8)
+
+DIRECTION_ORDER = ("up", "down", "left", "right")
+DELTAS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
