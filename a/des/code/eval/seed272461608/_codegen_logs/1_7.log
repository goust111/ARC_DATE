from __future__ import annotations
import random
from collections import Counter, deque
import numpy as np

MAX_DIM = 30
BG = 0
WALL = 5
FURNITURE_COLORS = [1,2,3,4,6,7,8,9]
ROOM_COUNT_RANGE = (2, 4)
INTERIOR_H_RANGE = (4, 7)
INTERIOR_W_RANGE = (4, 8)
GRID_MIN = 14
TRUNK_MARGIN = 3
