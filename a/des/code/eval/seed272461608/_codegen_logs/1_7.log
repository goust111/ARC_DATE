        mr,mc=missing[0]
        tip=(1-mr,1-mc)
        rooms.append((bg,wall,(r0,c0,r1,c1),(fr0+tip[0],fc0+tip[1]),TIP_TO_DIR[tip]))
    return rooms, bg, wall

