            rooms.append({'top':r,'left':c,'bottom':r+bh-1,'right':c+bw-1,'ih':ih,'iw':iw})
            r += bh + gaps[i+1]
        return H,W,rooms
    else:
        min_w = sum(box_w) + (n+1)
        if min_w > MAX_DIM: return None
        W = random.randint(max(GRID_MIN, min_w), min(MAX_DIM, min_w + 8))
        gaps = sample_gaps(W - sum(box_w), n+1, 1)
        if gaps is None: return None
        min_h = TRUNK_MARGIN + max(box_h) + 2
        if min_h > MAX_DIM: return None
        H = random.randint(max(GRID_MIN, min_h), min(MAX_DIM, min_h + 8))
