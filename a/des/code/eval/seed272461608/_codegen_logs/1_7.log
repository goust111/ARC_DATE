def neigh4(r,c):
    yield r-1,c
    yield r+1,c
    yield r,c-1
    yield r,c+1

def components(mask):
    h,w = mask.shape
    seen = np.zeros((h,w), dtype=bool)
    out=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            dq=deque([(r,c)])
            seen[r,c]=True
            cells=[]
            while dq:
                rr,cc=dq.popleft(); cells.append((rr,cc))
                for nr,nc in neigh4(rr,cc):
                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc]=True; dq.append((nr,nc))
            out.append(np.array(cells,dtype=int))
    return out

def bbox(coords):
    r0,c0 = coords.min(axis=0)
    r1,c1 = coords.max(axis=0)
    return int(r0),int(c0),int(r1),int(c1)

def mode(arr):
    cnt = Counter(map(int, arr.reshape(-1)))
    return max(cnt.items(), key=lambda kv:(kv[1],-kv[0]))[0]

def detect_wall(g,bg):
    h,w = g.shape
    cand=[]
    for color in map(int,np.unique(g)):
        if color==bg: continue
        comps=components(g==color)
        if len(comps)"'!=1: continue
        coords=comps[0]
        if any(r==0 or c==0 or r==h-1 or c==w-1 for r,c in coords):
            cand.append((len(coords),color))
    assert cand
    best=max(a for a,_ in cand)
    cols=[c for a,c in cand if a==best]
    assert len(cols)==1
    return cols[0]

def room_infos(g):
    g=np.asarray(g,dtype=int)
    bg=mode(g)
    wall=detect_wall(g,bg)
    h,w=g.shape
    rooms=[]
    for comp in components(g==bg):
        if any(r==0 or c==0 or r==h-1 or c==w-1 for r,c in comp):
            continue
        r0,c0,r1,c1=bbox(comp)
        comp_set=set(map(tuple,comp.tolist()))
        for rr in range(r0,r1+1):
            for cc in range(c0,c1+1):
                if g[rr,cc]==bg:
                    assert (rr,cc) in comp_set
        assert r0>0 and c0>0 and r1<h-1 and c1<w-1
        assert np.all(g[r0-1,c0:c1+1]==wall)
        assert np.all(g[r1+1,c0:c1+1]==wall)
        assert np.all(g[r0:r1+1,c0-1]==wall)
        assert np.all(g[r0:r1+1,c1+1]==wall)
        furn=[(rr,cc) for rr in range(r0,r1+1) for cc in range(c0,c1+1) if int(g[rr,cc]) not in {bg,wall}]
        assert furn
        furn_arr=np.array(furn,dtype=int)
        fcomps=components(np.isin(np.indices(g.shape).reshape(2,-1).T, [0]))
