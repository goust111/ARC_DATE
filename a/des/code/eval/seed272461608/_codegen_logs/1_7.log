ARROW_PATTERNS: dict[tuple[int, int], frozenset[tuple[int, int]]] = {
    (-1, -1): frozenset({(0, 0), (1, 0), (1, 1), (1, 2), (2, 1)}),
    (-1, 1): frozenset({(0, 2), (1, 0), (1, 1), (1, 2), (2, 1)}),
