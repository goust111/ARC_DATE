+            break
+        up = np.zeros_like(cur)
+        down = np.zeros_like(cur)
+        left = np.zeros_like(cur)
+        right = np.zeros_like(cur)
+        up[1:] = cur[:-1]
+        down[:-1] = cur[1:]
+        left[:, 1:] = cur[:, :-1]
+        right[:, :-1] = cur[:, 1:]
+        cur = cur & up & down & left & right
