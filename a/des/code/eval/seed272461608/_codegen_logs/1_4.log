+        r1 = min(grid.shape[0], top + sprite_h + PLACEMENT_PADDING)
+        c0 = max(0, left - PLACEMENT_PADDING)
+        c1 = min(grid.shape[1], left + sprite_w + PLACEMENT_PADDING)
