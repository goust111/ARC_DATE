+        width = rng.randint(2, 5)
+        heights = [rng.randint(1, depth) for _ in range(width)]
+        if max(heights) != depth:
+            continue
+        if len(set(heights)) == 1:
+            continue
+        mask = np.zeros((depth, width), dtype=bool)
+        for c, h in enumerate(heights):
+            mask[:h, c] = True
+        if int(mask.sum()) < 4:
