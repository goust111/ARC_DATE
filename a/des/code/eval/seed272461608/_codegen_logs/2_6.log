+        if r + 1 < h and not mask[r + 1, c]:
+            found.add((r + 1, c))
+        if c > 0 and not mask[r, c - 1]:
+            found.add((r, c - 1))
+        if c + 1 < w and not mask[r, c + 1]:
+            found.add((r, c + 1))
+    return list(found)
