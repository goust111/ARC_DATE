+
+def _monotone_corner_path(h: int, w: int) -> list[tuple[int, int]]:
+    start, end = random.choice([
+        ((0, 0), (h - 1, w - 1)),
+        ((0, w - 1), (h - 1, 0)),
+    ])
+    r, c = start
+    tr, tc = end
+    dr = 1 if tr >= r else -1
+    dc = 1 if tc >= c else -1
+
+    moves = [(dr, 0)] * abs(tr - r) + [(0, dc)] * abs(tc - c)
+    random.shuffle(moves)
+
+    path = [(r, c)]
+    for rr, cc in moves:
+        r += rr
+        c += cc
+        path.append((r, c))
+    return path
