+    mapping: dict[int, tuple[int, int, int]] = {}
+    for idx, source in enumerate(ring):
+        next_idx = (idx + 1) % 8
+        target = ring[next_idx]
+        dr, dc = RING_OFFSETS[next_idx]
+        mapping[source] = (target, dr, dc)
+    return mapping
