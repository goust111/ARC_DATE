+    seeds: list[tuple[int, int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            if r < 3 and c < 3:
+                continue
+            color = int(g[r, c])
+            if color in mapping:
+                seeds.append((r, c, color))
