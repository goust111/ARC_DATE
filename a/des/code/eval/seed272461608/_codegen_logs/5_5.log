+    for frame in frames:
+        frame["markers"] = sorted(set(frame["markers"]))
+
+    return frames
+
+
+def _layer_extents(layer: dict) -> tuple[int, int, int, int]:
+    h, w = layer["height"], layer["width"]
+    rows = [0, h - 1]
+    cols = [0, w - 1]
+    for dr, dc in layer["markers"]:
+        rows.append(dr)
+        cols.append(dc)
+    return min(rows), max(rows), min(cols), max(cols)
