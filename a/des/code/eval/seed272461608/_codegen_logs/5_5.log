+def _minimum_outer_size(layer_count: int, gaps: list[int]) -> int:
+    size = 3
+    for gap in reversed(gaps):
+        size += 2 * (gap + 1)
+    return size
+
+
+def _nested_bboxes(
+    top: int,
+    left: int,
+    outer_h: int,
+    outer_w: int,
+    gaps: list[int],
+) -> list[tuple[int, int, int, int]]:
+    bboxes = []
+    r0 = top
+    c0 = left
+    r1 = top + outer_h - 1
+    c1 = left + outer_w - 1
+    bboxes.append((r0, r1, c0, c1))
+    for gap in gaps:
+        inset = gap + 1
+        r0 += inset
+        c0 += inset
+        r1 -= inset
+        c1 -= inset
+        bboxes.append((r0, r1, c0, c1))
+    return bboxes
+
+
+def _place_marker(
+    grid: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    r0, r1, c0, c1 = bbox
+    side = rng.choice(("top", "bottom", "left", "right"))
+    length = rng.randint(1, 2)
+
+    if side in ("top", "bottom"):
+        if c1 - c0 + 1 < length:
+            return None
+        start = rng.randint(c0, c1 - length + 1)
+        row = r0 - 1 if side == "top" else r1 + 1
+        cells = [(row, start + offset) for offset in range(length)]
+    else:
+        if r1 - r0 + 1 < length:
+            return None
+        start = rng.randint(r0, r1 - length + 1)
+        col = c0 - 1 if side == "left" else c1 + 1
+        cells = [(start + offset, col) for offset in range(length)]
+
+    for r, c in cells:
+        if not (0 <= r < grid.shape[0] and 0 <= c < grid.shape[1]):
+            return None
+        if grid[r, c] != BG:
+            return None
+
+    for r, c in cells:
+        grid[r, c] = YELLOW
+    return cells
