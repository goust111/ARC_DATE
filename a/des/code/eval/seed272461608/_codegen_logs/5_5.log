+
+
+def _paint_frame(grid: np.ndarray, top: int, left: int, height: int, width: int, color: int) -> None:
+    bottom = top + height - 1
+    right = left + width - 1
+    grid[top, left : right + 1] = color
+    grid[bottom, left : right + 1] = color
