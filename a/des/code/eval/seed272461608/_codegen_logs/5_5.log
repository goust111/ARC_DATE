+        color = int(grid[coords[0][0], coords[0][1]])
+        bbox = _bbox(coords)
+        if not _is_rectangle_frame(grid, coords, color, bbox):
+            continue
+        r0, r1, c0, c1 = bbox
+        frames.append(
+            {
+                "bbox": bbox,
+                "color": color,
+                "height": r1 - r0 + 1,
+                "width": c1 - c0 + 1,
+                "markers": [],
+            }
+        )
