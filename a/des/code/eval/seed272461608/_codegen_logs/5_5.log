+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+YELLOW = 4
+DEPTH_FILL_COLORS = (5, 6, 7, 8)  # grey, magenta, orange, azure
+FRAME_COLOR_POOL = (1, 2, 3, 9)
+FRAME_GAP_IN_OUTPUT = 2
+MAX_GENERATION_ATTEMPTS = 300
+MAX_GRID_SIZE = 30
