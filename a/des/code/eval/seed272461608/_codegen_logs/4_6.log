+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[-1, :] = True
+        return mask
+    if direction == "down":
+        mask = np.zeros((depth + 1, opening_width + 2), dtype=bool)
+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[0, :] = True
+        return mask
+    if direction == "left":
+        mask = np.zeros((opening_width + 2, depth + 1), dtype=bool)
+        mask[0, :] = True
+        mask[-1, :] = True
