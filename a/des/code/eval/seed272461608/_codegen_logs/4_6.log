+from collections import defaultdict, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+DIRS = ("up", "down", "left", "right")
+GEN_RETRIES = 500
+PLACE_RETRIES = 200
+PARTICLE_COLORS = tuple(color for color in range(10) if color not in (BG, GREY))
