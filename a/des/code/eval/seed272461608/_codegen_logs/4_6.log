+    for r, c in coords:
+        local[r - r0, c - c0] = True
+
+    matches: list[dict] = []
+    if 3 <= h <= 5 and 4 <= w <= 6:
+        depth = h - 1
+        opening_width = w - 2
+        if 2 <= depth <= 4 and 2 <= opening_width <= 4:
