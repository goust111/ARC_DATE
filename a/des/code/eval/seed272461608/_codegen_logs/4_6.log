+
+    if np.array_equal(out, grid):
+        return None
+    if int(((out != BG) & (out != GREY)).sum()) < int(particle_mask.sum()):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
