+def _in_any_bbox(containers: list[dict], r: int, c: int) -> bool:
+    for cont in containers:
+        r0, c0, r1, c1 = cont["bbox"]
+        if r0 <= r <= r1 and c0 <= c <= c1:
+            return True
+    return False
+
+
+def _particle_hit(cont: dict, r: int, c: int) -> tuple[int, int] | None:
+    r0, c0, r1, c1 = cont["bbox"]
+    direction = cont["direction"]
+    if direction == "up":
+        if c0 < c < c1 and r < r0:
+            return r0 - r, c - (c0 + 1)
+        return None
+    if direction == "down":
+        if c0 < c < c1 and r > r1:
+            return r - r1, c - (c0 + 1)
+        return None
+    if direction == "left":
+        if r0 < r < r1 and c < c0:
+            return c0 - c, r - (r0 + 1)
+        return None
+    assert direction == "right"
+    if r0 < r < r1 and c > c1:
+        return c - c1, r - (r0 + 1)
+    return None
