+    return int(Counter(map(int, border.tolist())).most_common(1)[0][0])
+
+
+def _extract_regions(grid: np.ndarray) -> tuple[list[dict], list[int], list[int], dict[tuple[int, int], int]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    bg = _border_bg(g)
