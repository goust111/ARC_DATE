+    col_lo, col_hi = -min_c, w - 1 - max_c
+    if row_lo > row_hi or col_lo > col_hi:
+        return None
+
+    offsets = [
+        (random.randint(row_lo, row_hi), random.randint(col_lo, col_hi))
+        for _ in range(PLACEMENT_RETRIES)
