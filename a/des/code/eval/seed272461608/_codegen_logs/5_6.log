+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+CYAN = 8
+BROWN = 9
+
+GRADIENT_COLORS = [RED, ORANGE, YELLOW, GREEN, BLUE]
+PORTAL_COLORS = [MAGENTA, CYAN, BROWN, RED, GREEN, YELLOW, ORANGE, BLUE]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+MIN_SEGMENTS = 2
+MAX_SEGMENTS = 5
+MIN_SEGMENT_LEN = 3
+MAX_TOTAL_LEN = 42
+MIN_TOTAL_LEN = 15
+MIN_GRID = 18
+MAX_GRID = 28
+SEGMENT_RETRIES = 200
+PLACEMENT_RETRIES = 200
+GEN_RETRIES = 300
