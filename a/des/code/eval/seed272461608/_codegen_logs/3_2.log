+        max_parts = min(PIECE_COUNT_RANGE[1], area - 1)
+        if max_parts < PIECE_COUNT_RANGE[0]:
+            return None
+        n_parts = random.randint(PIECE_COUNT_RANGE[0], max_parts)
+        pieces = _build_fragments_for_rectangle(h, w, n_parts)
+        if pieces is None:
