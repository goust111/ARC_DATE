+
+def _bbox_shape(coords: tuple[tuple[int, int], ...]) -> tuple[int, int]:
+    arr = np.asarray(coords, dtype=int)
+    return int(arr[:, 0].max()) + 1, int(arr[:, 1].max()) + 1
