+
+        weights = [targets[i] - sizes[i] for i in growable]
+        label = random.choices(growable, weights=weights, k=1)[0]
+        cell = random.choice(tuple(frontiers[label]))
+        frontiers[label].remove(cell)
+        if labels[cell] != -1:
