        if upper < 1:
            counts[idx] = 1
            remaining_budget -= 1
        else:
            counts[idx] = int(rng.integers(1, upper + 1))
            remaining_budget -= counts[idx]

    total = sum(counts)
    if total < TOTAL_OBJECT_RANGE[0] or total > TOTAL_OBJECT_RANGE[1]:
        return None
    return counts


