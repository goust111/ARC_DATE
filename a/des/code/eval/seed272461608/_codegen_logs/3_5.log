+                -abs(cand[0] - next(iter(seeds))[0]) - abs(cand[1] - next(iter(seeds))[1]),
+            )
+            ranked.append((score, cand))
+        ranked.sort(reverse=True)
+        choice = ranked[0][1]
+        blob.add(choice)
+        frontier.remove(choice)
+        for dr, dc in DIRS4:
+            cand = (choice[0] + dr, choice[1] + dc)
+            if cand in zone and cand not in blob:
+                frontier.add(cand)
+
+    if len(blob) < target_size:
+        return None
+
+    r0, r1, c0, c1 = bbox(blob)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return None
+    area = (r1 - r0 + 1) * (c1 - c0 + 1)
+    if len(blob) == area:
+        removable = []
+        for cell in sorted(blob):
+            if cell in seeds:
+                continue
+            rest = blob - {cell}
+            start = next(iter(rest))
+            q = deque([start])
+            seen = {start}
+            while q:
+                cr, cc = q.popleft()
+                for dr, dc in DIRS4:
+                    nxt = (cr + dr, cc + dc)
+                    if nxt in rest and nxt not in seen:
+                        seen.add(nxt)
+                        q.append(nxt)
+            if seen == rest:
+                removable.append(cell)
+        if removable:
+            blob.remove(rng.choice(removable))
+    return blob
