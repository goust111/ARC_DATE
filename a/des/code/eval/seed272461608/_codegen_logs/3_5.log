+            for dc in range(-pad, pad + 1):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    out.add((nr, nc))
+    return out
+
+
+def shift_cells(cells: set[tuple[int, int]] | tuple[tuple[int, int], ...], dr: int, dc: int):
