+import numpy as np
+
+
+GREY = 5
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+COLOR_POOL = [0, 1, 2, 3, 4, 6, 7, 8, 9]
+GEN_ATTEMPTS = 400
+PAIR_ATTEMPTS = 120
