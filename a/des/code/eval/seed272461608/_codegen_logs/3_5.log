+def grow_blob(
+    zone: set[tuple[int, int]],
+    seeds: set[tuple[int, int]],
+    target_size: int,
+    rng: random.Random,
+) -> set[tuple[int, int]] | None:
+    if not seeds or not seeds.issubset(zone):
+        return None
