+            ) & shift_cells(all_local, dr, dc)
+            zone_b = shift_cells(
+                marker_layout_from_attach(marker_b.attach, marker_b.outdir, 7, 3, 3)[2], dr, dc
+            ) & shift_cells(all_local, dr, dc)
+
+            reserved = shift_cells(all_local, dr, dc)
+            if any(cell in forbidden for cell in reserved):
+                continue
+
+            zone_a = {
+                cell
+                for cell in reserved
+                if cell not in bridge and cell not in marker_cells_a and cell not in marker_cells_b
+                and any((cell[0] + dr2, cell[1] + dc2) in seeds_a for dr2, dc2 in [(0, 0), (-1, 0), (1, 0), (0, -1), (0, 1)])
+                or cell in seeds_a
+            }
+            zone_b = {
+                cell
+                for cell in reserved
+                if cell not in bridge and cell not in marker_cells_a and cell not in marker_cells_b
+                and any((cell[0] + dr2, cell[1] + dc2) in seeds_b for dr2, dc2 in [(0, 0), (-1, 0), (1, 0), (0, -1), (0, 1)])
