+        end_rows = [r for r, _ in end.attach]
+        if start_rows != end_rows:
+            return None
+        c1 = start.attach[0][1]
+        c2 = end.attach[0][1]
+        if start.outdir[1] == 1 and c1 > c2:
+            return None
+        if start.outdir[1] == -1 and c1 < c2:
+            return None
+        return {
+            (r, c)
+            for r in start_rows
+            for c in range(min(c1, c2), max(c1, c2) + 1)
