+def l_bridge(start: Marker, end: Marker) -> set[tuple[int, int]] | None:
+    if start.size != end.size:
+        return None
+    finish = (-end.outdir[0], -end.outdir[1])
+    if start.outdir[0] * finish[0] + start.outdir[1] * finish[1] != 0:
+        return None
+
+    if start.outdir[0] == 0 and finish[1] == 0:
