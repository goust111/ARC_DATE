+@dataclass(frozen=True)
+class Marker:
+    host_color: int
+    target_color: int
+    size: int
+    outdir: tuple[int, int]
+    cells: tuple[tuple[int, int], ...]
+    attach: tuple[tuple[int, int], ...]
