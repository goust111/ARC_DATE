+    out = g.copy()
+    done_pairs: set[frozenset[int]] = set()
+    for (a, b), ab_markers in sorted(by_key.items()):
+        pair_key = frozenset((a, b))
+        if a == b or pair_key in done_pairs:
+            continue
+        ba_markers = by_key.get((b, a), [])
+        if not ba_markers:
