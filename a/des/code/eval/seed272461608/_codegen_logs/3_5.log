+    marker_cells_b, seeds_b, zone_b = marker_layout_from_attach(attach_b, dir_b, depth_b, pad_b0, pad_b1)
+    all_cells = bridge | marker_cells_a | marker_cells_b | zone_a | zone_b
+    return (
