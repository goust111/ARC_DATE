+def detect_islands_and_markers(grid: np.ndarray):
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+    colors = [int(v) for v in np.unique(g) if int(v) != bg]
+    color_comps = {color: components_of_color(g, color) for color in colors}
