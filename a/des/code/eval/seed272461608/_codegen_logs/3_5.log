+    r2 = end.attach[0][0]
+    if start.outdir[0] == 1 and r1 > r2:
+        return None
+    if start.outdir[0] == -1 and r1 < r2:
+        return None
+    return {
+        (r, c)
+        for r in range(min(r1, r2), max(r1, r2) + 1)
+        for c in start_cols
