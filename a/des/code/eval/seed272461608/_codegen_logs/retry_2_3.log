import random

import numpy as np


BG = 0
WIRE = 5
PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]

GENERATION_ATTEMPTS = 500
CHAIN_ATTEMPTS = 200
PLACEMENT_ATTEMPTS = 200
MIN_SIDE = 16
MAX_SIDE = 30
MIN_SEG_LEN = 2
MAX_SEG_LEN = 7
MAX_TURNS = 3
MAX_CHAINS = 4


def _add(a: tuple[int, int], b: tuple[int, int], scale: int = 1) -> tuple[int, int]:
    return (a[0] + b[0] * scale, a[1] + b[1] * scale)


def _neg(d: tuple[int, int]) -> tuple[int, int]:
    return (-d[0], -d[1])


def _cw(d: tuple[int, int]) -> tuple[int, int]:
    return (d[1], -d[0])


def _in_bounds(shape: tuple[int, int], cell: tuple[int, int]) -> bool:
    r, c = cell
    return 0 <= r < shape[0] and 0 <= c < shape[1]


def _neighbors4(cell: tuple[int, int]) -> list[tuple[int, int]]:
    r, c = cell
    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]


def _neighbors8(cell: tuple[int, int]) -> list[tuple[int, int]]:
    r, c = cell
    return [
        (r + dr, c + dc)
        for dr in (-1, 0, 1)
        for dc in (-1, 0, 1)
        if dr != 0 or dc != 0
    ]


def _manhattan(a: tuple[int, int], b: tuple[int, int]) -> int:
    return abs(a[0] - b[0]) + abs(a[1] - b[1])


def _edge(a: tuple[int, int], b: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
    return (a, b) if a <= b else (b, a)


def _attached_block(anchor: tuple[int, int], side: tuple[int, int]) -> list[tuple[int, int]]:
    r, c = anchor
    if side == (0, 1):
        return [(r, c + 1), (r, c + 2), (r + 1, c + 1), (r + 1, c + 2)]
    if side == (0, -1):
        return [(r, c - 2), (r, c - 1), (r + 1, c - 2), (r + 1, c - 1)]
    if side == (1, 0):
        return [(r + 1, c), (r + 1, c + 1), (r + 2, c), (r + 2, c + 1)]
    if side == (-1, 0):
        return [(r - 2, c), (r - 2, c + 1), (r - 1, c), (r - 1, c + 1)]
    raise AssertionError(f"bad side: {side}")


def _bbox(cells: set[tuple[int, int]]) -> tuple[int, int, int, int]:
    rows = [r for r, _ in cells]
    cols = [c for _, c in cells]
    return min(rows), min(cols), max(rows), max(cols)


def _colored_components(g: np.ndarray) -> list[dict]:
    seen = np.zeros(g.shape, dtype=bool)
    comps = []
    for r in range(g.shape[0]):
        for c in range(g.shape[1]):
            color = int(g[r, c])
            if color in (BG, WIRE) or seen[r, c]:
                continue
            stack = [(r, c)]
            seen[r, c] = True
            coords = []
            while stack:
                rr, cc = stack.pop()
                coords.append((rr, cc))
                for nr, nc in _neighbors4((rr, cc)):
                    if _in_bounds(g.shape, (nr, nc)) and not seen[nr, nc] and int(g[nr, nc]) == color:
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            comps.append({"color": color, "coords": coords})
    return comps


def _is_source_component(coords: list[tuple[int, int]]) -> bool:
    if len(coords) != 4:
        return False
    cells = set(coords)
    r0, c0, r1, c1 = _bbox(cells)
    if (r1 - r0 + 1, c1 - c0 + 1) != (2, 2):
        return False
    return cells == {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}


def _find_sources(g: np.ndarray) -> list[list[tuple[int, int]]]:
    sources = []
    for comp in _colored_components(g):
        coords = comp["coords"]
        if _is_source_component(coords):
            sources.append(sorted(coords))
        else:
            assert len(coords) == 1, "non-source colored objects must be singleton relay nodes"
    assert sources, "expected at least one 2x2 source block"
    sources.sort()
    return sources


def _trace_chain(g: np.ndarray, source_cells: list[tuple[int, int]]) -> tuple[int, list[tuple[int, int]], tuple[int, int], tuple[int, int]]:
    source_set = set(source_cells)
    color = int(g[source_cells[0]])

    contacts = []
    for src in source_cells:
        for nb in _neighbors4(src):
            if _in_bounds(g.shape, nb) and int(g[nb]) == WIRE:
                contacts.append((src, nb))
    assert len(contacts) == 1, "source must touch exactly one wire endpoint"

    touch_source, start = contacts[0]
    direction = (start[0] - touch_source[0], start[1] - touch_source[1])
    assert direction in DIRS

    wire_cells = []
    pos = start
    seen_states = set()
    while True:
        state = (pos, direction)
        assert state not in seen_states, "wire chain must not loop"
        seen_states.add(state)
        assert int(g[pos]) == WIRE
        wire_cells.append(pos)

        ahead = _add(pos, direction)
        if not _in_bounds(g.shape, ahead) or int(g[ahead]) == BG:
            terminal = pos
            break
        if int(g[ahead]) == WIRE:
            pos = ahead
            continue

        assert ahead not in source_set, "signal must not run back into a source"
        new_direction = _cw(direction)
        next_wire = _add(ahead, new_direction)
        assert _in_bounds(g.shape, next_wire) and int(g[next_wire]) == WIRE
        direction = new_direction
        pos = next_wire

    return color, wire_cells, terminal, direction


def main(grid: np.ndarray) -> np.ndarray:
    """
    Follow each grey wire from its 2x2 colored source, rotate clockwise at every colored relay node,
    recolor the traversed wire, and stamp a matching 2x2 block at the terminal end.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    out = g.copy()
    for source_cells in _find_sources(g):
        color, wire_cells, terminal, final_direction = _trace_chain(g, source_cells)
        for r, c in wire_cells:
            out[r, c] = color
        for r, c in _attached_block(terminal, final_direction):
            assert _in_bounds(g.shape, (r, c))
            out[r, c] = color
    return out


def _build_local_chain(turns: int) -> dict | None:
    start_dir = DIRS[random.randrange(len(DIRS))]
    lengths = [random.randint(MIN_SEG_LEN, MAX_SEG_LEN) for _ in range(turns + 1)]

    source_cells = set()
    wire_cells: list[tuple[int, int]] = []
    node_cells: list[tuple[int, int]] = []
    allowed_edges: set[tuple[tuple[int, int], tuple[int, int]]] = set()

    pos = (0, 0)
    first_wire = pos
    for seg_idx, length in enumerate(lengths):
        direction = DIRS[(DIRS.index(start_dir) + seg_idx) % len(DIRS)]
        segment = [_add(pos, direction, step) for step in range(length)]
        wire_cells.extend(segment)
        for a, b in zip(segment, segment[1:]):
            allowed_edges.add(_edge(a, b))

        if seg_idx < turns:
            node = _add(segment[-1], direction)
            next_direction = _cw(direction)
            next_start = _add(node, next_direction)
            node_cells.append(node)
            allowed_edges.add(_edge(segment[-1], node))
            allowed_edges.add(_edge(node, next_start))
            pos = next_start

    last_direction = DIRS[(DIRS.index(start_dir) + turns) % len(DIRS)]
    terminal = wire_cells[-1]
    source_cells = set(_attached_block(first_wire, _neg(start_dir)))
    terminal_cells = set(_attached_block(terminal, last_direction))

    input_cells = source_cells | set(wire_cells) | set(node_cells)
    if len(input_cells) != len(source_cells) + len(wire_cells) + len(node_cells):
        return None
    if input_cells & terminal_cells:
        return None

    source_touch = [cell for cell in source_cells if _manhattan(cell, first_wire) == 1]
    terminal_touch = [cell for cell in terminal_cells if _manhattan(cell, terminal) == 1]
    if len(source_touch) != 1 or len(terminal_touch) != 1:
        return None

    for a in source_cells:
        for b in source_cells:
            if a < b and _manhattan(a, b) == 1:
                allowed_edges.add(_edge(a, b))
    allowed_edges.add(_edge(source_touch[0], first_wire))

    for cell in input_cells:
        for nb in _neighbors4(cell):
            if nb in input_cells and _edge(cell, nb) not in allowed_edges:
                return None

