+
+def _choose_mask_and_base(a: dict, b: dict) -> tuple[dict, dict]:
+    if a["area"] != b["area"]:
+        return (a, b) if a["area"] < b["area"] else (b, a)
+    a_key = (a["bbox"][0], a["bbox"][1])
+    b_key = (b["bbox"][0], b["bbox"][1])
+    return (a, b) if a_key <= b_key else (b, a)
