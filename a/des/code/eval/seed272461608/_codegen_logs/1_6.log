+    step = 1 if ec >= sc else -1
+    for cc in range(sc + step, ec + step, step):
+        cells.append((mid_row, cc))
+    step = 1 if er >= mid_row else -1
+    for rr in range(mid_row + step, er + step, step):
+        cells.append((rr, ec))
