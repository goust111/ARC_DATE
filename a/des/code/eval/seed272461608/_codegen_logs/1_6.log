+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+LINE_COLOR = 5
+FRAME_COLOR = 8
+OBJECT_COLORS = tuple(color for color in range(10) if color not in (0, LINE_COLOR, FRAME_COLOR))
+
+PAIR_COUNT_RANGE = (2, 3)
+AREA_RANGE = (3, 12)
