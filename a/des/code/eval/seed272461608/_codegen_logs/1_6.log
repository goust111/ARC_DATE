+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coords = np.array(cells, dtype=int)
+            idx = len(blocks)
+            block_id[coords[:, 0], coords[:, 1]] = idx
+            blocks.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": int(coords.shape[0]),
+                    "mask": _component_bitmap(coords),
