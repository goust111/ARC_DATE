+            continue
+        frames.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "inner_shape": (h - 2, w - 2),
+            }
+        )
+    return frames
+
+
+def _find_blocks(g: np.ndarray, bg: int) -> tuple[list[dict], np.ndarray]:
+    h, w = g.shape
+    block_id = np.full((h, w), -1, dtype=int)
+    seen = np.zeros((h, w), dtype=bool)
+    blocks: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color in (bg, LINE_COLOR, FRAME_COLOR) or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coords = np.array(cells, dtype=int)
+            idx = len(blocks)
+            block_id[coords[:, 0], coords[:, 1]] = idx
+            blocks.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": int(coords.shape[0]),
+                    "mask": _component_bitmap(coords),
+                }
+            )
+    return blocks, block_id
