+def _random_shape(area: int) -> np.ndarray:
+    dims = [
+        (h, w)
+        for h in range(2, 6)
+        for w in range(2, 6)
+        if h * w >= area and h * w <= max(area + 6, area * 2)
+    ]
+    assert dims
