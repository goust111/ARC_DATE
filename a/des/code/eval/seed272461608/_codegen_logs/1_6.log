+def _find_frames(g: np.ndarray, bg: int) -> list[dict]:
+    frames: list[dict] = []
+    for coords in _components(g == FRAME_COLOR):
+        r0, c0, r1, c1 = _bbox(coords)
+        h = int(r1 - r0 + 1)
+        w = int(c1 - c0 + 1)
