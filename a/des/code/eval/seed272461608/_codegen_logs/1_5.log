+    placed = _place_specs((h, w), specs)
+    if placed is None:
+        return None
+
+    inp = _render_input((h, w), placed)
+    expected = _expected_output(inp, placed)
+
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
