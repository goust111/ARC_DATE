+    kind, axis = candidates[0]
+    return kind, axis, (r0, c0, r1, c1)
+
+
+def _find_opening(
+    grid: np.ndarray,
+    wall_color: int,
+    bbox: tuple[int, int, int, int],
+    axis_kind: str,
+    axis: int,
+) -> tuple[tuple[int, int], tuple[int, int]]:
