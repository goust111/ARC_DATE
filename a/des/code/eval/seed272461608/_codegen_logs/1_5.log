+    r0, c0, r1, c1 = bbox
+    q = deque([opening])
+    seen = {opening}
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if not (r0 <= nr <= r1 and c0 <= nc <= c1):
+                continue
+            if (nr, nc) in seen or int(grid[nr, nc]) == wall_color:
