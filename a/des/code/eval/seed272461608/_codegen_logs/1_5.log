+            widths.append(hw)
+        if max(widths) == 1 and random.random() < 0.8:
+            idx = random.randrange(corridor_depth, len(widths))
+            widths[idx] = 2
+        if direction in {"left", "right"} and max(widths) < seed_count:
+            continue
+        return widths
+    return None
+
