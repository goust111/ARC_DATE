+        extra_w = int(_RNG.integers(8, 18))
+        h = max_h + extra_h + int(_RNG.integers(0, 7))
+        w = max(max_w + extra_w, int(np.ceil(np.sqrt(bbox_area * 3.2)))) + int(_RNG.integers(6, 15))
