+def _pair_components(comps: list[dict]) -> list[tuple[int, int]]:
+    n = len(comps)
+    assert n > 0 and n % 2 == 0
+    mates = [[] for _ in range(n)]
+    for i in range(n):
+        for j in range(i + 1, n):
