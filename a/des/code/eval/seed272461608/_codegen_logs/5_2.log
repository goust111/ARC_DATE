+
+def _tight_mask(mask: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox_of_mask(mask)
+    return np.asarray(mask[r0 : r1 + 1, c0 : c1 + 1], dtype=bool)
