+
+def _dihedral_variants(arr: np.ndarray) -> list[np.ndarray]:
+    out: list[np.ndarray] = []
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    for flipped in (False, True):
+        base = np.fliplr(arr) if flipped else arr
+        for k in range(4):
+            cur = np.rot90(base, k)
+            key = (tuple(map(int, cur.shape)), cur.tobytes())
+            if key in seen:
