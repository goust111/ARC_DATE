+def _component_mask(mask: np.ndarray, start: tuple[int, int], seen: np.ndarray) -> np.ndarray:
+    """Extract one 4-connected boolean component from `mask`."""
+    h, w = mask.shape
+    comp = np.zeros_like(mask, dtype=bool)
+    q = deque([start])
+    seen[start] = True
+    comp[start] = True
+    while q:
