+        key = (int(variant.shape[0]), int(variant.shape[1]), variant.tobytes())
+        if best is None or key < best:
+            best = key
+    assert best is not None
+    return best
+
+
+def _canonical_label_arr(labels: np.ndarray) -> tuple[np.ndarray, tuple[int, int, bytes]]:
