import numpy as np, math, time
from collections import deque
rng=np.random.default_rng(0)
DIR4=((1,0),(-1,0),(0,1),(0,-1))

def conn(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:return False
    seen=np.zeros_like(mask,dtype=bool)
    q=deque([tuple(pts[0])]); seen[tuple(pts[0])]=True; count=1; H,W=mask.shape
    while q:
        r,c=q.popleft()
        for dr,dc in DIR4:
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not seen[nr,nc]:
                seen[nr,nc]=True; count+=1; q.append((nr,nc))
    return count==len(pts)

def side_mask(mask):
    return [mask[0].any(), mask[-1].any(), mask[:,0].any(), mask[:,-1].any()]

def proto(h,w,tries=1000):
