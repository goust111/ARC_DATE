        for dr,dc in DIR4:
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return len(seen)==len(pts)

def touches(mask):
    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

def rand_path(start, targets, occupied, h, w):
    # randomized BFS over free cells; can end on target or adjacent tree cell in targets
    q=deque([start])
    parent={start:None}
    while q:
        cur=q.popleft()
        if cur in targets:
            path=[]; x=cur
            while x is not None:
                path.append(x); x=parent[x]
            return path[::-1]
        neigh=[]
        for dr,dc in DIR4:
            nr,nc=cur[0]+dr,cur[1]+dc
            nxt=(nr,nc)
            if not (0<=nr<h and 0<=nc<w):
                continue
            if nxt in parent:
                continue
            if occupied[nr,nc] and nxt not in targets:
                continue
            neigh.append(nxt)
        rng.shuffle(neigh)
        q.extend(neigh)
        for nxt in neigh:
            parent[nxt]=cur
    return None

def gen(h,w,tries=500):
    for _ in range(tries):
        hub=(int(rng.integers(1,h-1)), int(rng.integers(1,w-1)))
        anchors=[(0,int(rng.integers(1,w-1))), (h-1,int(rng.integers(1,w-1))), (int(rng.integers(1,h-1)),0), (int(rng.integers(1,h-1)),w-1)]
        occ=np.zeros((h,w),dtype=bool); occ[hub]=1
        ok=True
        for anc in anchors:
            targets=set(map(tuple,np.argwhere(occ)))
            path=rand_path(anc, targets, occ, h, w)
            if path is None:
                ok=False; break
            for p in path[:-1]:
                occ[p]=1
        if not ok: continue
        # add a few leaf branches
        pts=list(map(tuple,np.argwhere(occ)))
        rng.shuffle(pts)
        for base in pts[:3]:
            length=int(rng.integers(1,4))
            cur=base
            used={base}
            for _ in range(length):
                opts=[]
                for dr,dc in DIR4:
                    nr,nc=cur[0]+dr,cur[1]+dc
                    if 0<=nr<h and 0<=nc<w and not occ[nr,nc] and (nr,nc) not in used:
                        opts.append((nr,nc))
                if not opts: break
                cur=opts[int(rng.integers(len(opts)))]
                occ[cur]=1; used.add(cur)
        if touches(occ) and conn(~occ):
            return occ
    return None

for hw in [(5,6),(5,7),(5,8),(6,6),(6,7),(6,8),(7,7),(7,8)]:
    ok=0
    for _ in range(20):
        ok += gen(*hw) is not None
    print(hw,ok)
