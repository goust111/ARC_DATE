+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                comp[nr, nc] = True
+                q.append((nr, nc))
+    return comp
