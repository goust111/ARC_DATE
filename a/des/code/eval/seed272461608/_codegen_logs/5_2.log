import numpy as np, itertools
from collections import deque
rng=np.random.default_rng(0)
DIR4=((1,0),(-1,0),(0,1),(0,-1))

def conn(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:return False
    seen={tuple(pts[0])}; q=deque([tuple(pts[0])]); H,W=mask.shape
    while q:
        r,c=q.popleft()
        for dr,dc in DIR4:
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return len(seen)==len(pts)

def touches(mask):
    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

def proto(h,w,tries=3000):
    interior=[(r,c) for r in range(1,h-1) for c in range(1,w-1)]
    out=[]
    for _ in range(tries):
        start=interior[rng.integers(len(interior))]
        seen={start}; path=[start]; boundary_sides=set()
        target=int(rng.integers(max(6,(h+w)//2), min(h*w-1, h*w//2)+1))
        while len(path)<target:
            r,c=path[-1]
            opts=[]
            for dr,dc in DIR4:
                nr,nc=r+dr,c+dc
                if 0<=nr<h and 0<=nc<w and (nr,nc) not in seen:
                    score=0
                    if nr==0 and 't' not in boundary_sides: score+=2
                    if nr==h-1 and 'b' not in boundary_sides: score+=2
                    if nc==0 and 'l' not in boundary_sides: score+=2
                    if nc==w-1 and 'r' not in boundary_sides: score+=2
                    score += rng.random()
                    opts.append((score,(nr,nc)))
            if not opts: break
            opts.sort(reverse=True)
            p=opts[0][1]
            seen.add(p); path.append(p)
            nr,nc=p
            if nr==0: boundary_sides.add('t')
            if nr==h-1: boundary_sides.add('b')
            if nc==0: boundary_sides.add('l')
            if nc==w-1: boundary_sides.add('r')
        end=path[-1]
        if len(path)<6 or end[0] in (0,h-1) or end[1] in (0,w-1):
            continue
        m=np.zeros((h,w),dtype=bool)
        for p in path:m[p]=1
        if touches(m) and conn(~m):
            out.append(m)
    return out

def good(m):
    return conn(m) and touches(m) and conn(~m) and touches(~m)

def try_fix(m):
    H,W=m.shape
    occ=list(map(tuple,np.argwhere(m)))
    emp=list(map(tuple,np.argwhere(~m)))
    # 1 swap
    for rem in occ:
        base=m.copy(); base[rem]=0
        if not conn(base) or not touches(base):
            continue
        for add in emp:
            if base[add]: continue
            n=base.copy(); n[add]=1
            if good(n):
                return n,('swap1',rem,add)
    # remove 1 add 2 near boundary problem cells
    side_problem=[]
    comp=~m
    if not comp[0].any(): side_problem += [(0,c) for c in range(W) if m[0,c]]
    if not comp[-1].any(): side_problem += [(H-1,c) for c in range(W) if m[H-1,c]]
    if not comp[:,0].any(): side_problem += [(r,0) for r in range(H) if m[r,0]]
    if not comp[:,-1].any(): side_problem += [(r,W-1) for r in range(H) if m[r,W-1]]
    local=[p for p in emp if min(p[0],H-1-p[0],p[1],W-1-p[1])<=2]
    for rem in side_problem or occ:
        base=m.copy(); base[rem]=0
        if not conn(base) or not touches(base):
            continue
        for adds in itertools.combinations(local,2):
            if base[adds[0]] or base[adds[1]]: continue
            n=base.copy(); n[adds[0]]=1; n[adds[1]]=1
            if good(n):
                return n,('swap2',rem,adds)
    return None,None

for dims in [(5,6),(5,7),(6,6),(6,7)]:
    found=None
    protos=proto(*dims,tries=2000)
    print('dims',dims,'protos',len(protos))
    for i,m in enumerate(protos[:200]):
        n,info=try_fix(m)
        if n is not None:
            found=(n,info)
            break
    print('found',found is not None)
    if found:
        print(found[1])
        print(found[0].astype(int))
