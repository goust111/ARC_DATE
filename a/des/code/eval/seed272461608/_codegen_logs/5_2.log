+        key = (int(variant.shape[0]), int(variant.shape[1]), variant.tobytes())
+        if best_key is None or key < best_key:
+            best_key = key
+            best_arr = variant
+    assert best_arr is not None and best_key is not None
+    return best_arr, best_key
