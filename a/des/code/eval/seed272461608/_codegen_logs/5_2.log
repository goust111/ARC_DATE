+            mask = g == color
+            comp_mask = _component_mask(mask, (r, c), seen)
+            r0, c0, r1, c1 = _bbox_of_mask(comp_mask)
+            tight = np.asarray(comp_mask[r0 : r1 + 1, c0 : c1 + 1], dtype=bool)
+            comps.append(
