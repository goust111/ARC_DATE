            max_w_i = min(remaining_w - min_w, max_w)
        else:
            max_w_i = min(remaining_w, max_w)
        wm = _pick_dim(near_cols, min_w, max(min_w, max_w_i))
        if wm < 0:
            return None
        remaining_w -= wm
