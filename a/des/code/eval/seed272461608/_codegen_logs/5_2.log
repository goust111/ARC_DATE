+                if nr == 0 and "top" not in touched:
+                    score += 3.0
+                if nr == h - 1 and "bottom" not in touched:
+                    score += 3.0
+                if nc == 0 and "left" not in touched:
+                    score += 3.0
+                if nc == w - 1 and "right" not in touched:
