+        reserved = np.zeros((h, w), dtype=bool)
+        order = sorted(range(len(components)), key=lambda idx: components[idx]["patch"].size, reverse=True)
+        placed = True
+
+        for idx in order:
+            patch = components[idx]["patch"]
+            ph, pw = patch.shape
+            spots = []
+            for _ in range(90):
