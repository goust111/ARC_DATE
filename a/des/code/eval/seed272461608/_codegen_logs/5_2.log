+    area = h * w
+    min_len = max(8, h + w - 2)
+    max_len = max(min_len, min(area // 2, area - 8))
+
+    for _ in range(500):
+        start = interior[int(_RNG.integers(0, len(interior)))]
+        target_len = int(_RNG.integers(min_len, max_len + 1))
