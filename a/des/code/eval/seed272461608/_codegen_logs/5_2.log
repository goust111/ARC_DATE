+    out = np.empty(canon.shape, dtype=int)
+    out[canon == 1] = int(comp_a["color"])
+    out[canon == 2] = int(comp_b["color"])
+    return out, label_key
+
+
+def _compose_output(rectangles: list[tuple[np.ndarray, int, tuple[int, int, bytes]]]) -> np.ndarray:
+    assert rectangles
