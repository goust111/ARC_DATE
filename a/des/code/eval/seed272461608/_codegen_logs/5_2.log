+        if not _touches_all_sides(mask) or not _touches_all_sides(comp):
+            continue
+        if not _is_connected(comp):
+            continue
+        if _canonical_bool_key(mask) == _canonical_bool_key(comp):
+            continue
+        return mask
+    return None
+
+
+def _generate_shape_pair(h: int, w: int) -> tuple[np.ndarray, np.ndarray] | None:
+    base = _simple_path_mask(h, w)
+    if base is None:
+        return None
+    other = ~base
+    return _random_dihedral(base), _random_dihedral(other)
