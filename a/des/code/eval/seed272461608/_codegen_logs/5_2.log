+            seen.add((nr, nc))
+            if nr == 0:
+                touched.add("top")
+            if nr == h - 1:
+                touched.add("bottom")
+            if nc == 0:
+                touched.add("left")
+            if nc == w - 1:
+                touched.add("right")
