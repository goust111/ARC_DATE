+
+def _compose_output(rectangles: list[tuple[np.ndarray, int, tuple[int, int, bytes]]]) -> np.ndarray:
+    assert rectangles
+    ordered = sorted(
+        rectangles,
+        key=lambda item: (int(item[1]), int(item[0].shape[0]), int(item[0].shape[1]), item[2]),
