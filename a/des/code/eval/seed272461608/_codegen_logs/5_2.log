import numpy as np
from collections import deque
rng=np.random.default_rng(0)
DIR4=((1,0),(-1,0),(0,1),(0,-1))

def conn(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:return False
    seen={tuple(pts[0])}; q=deque([tuple(pts[0])]); H,W=mask.shape
    while q:
        r,c=q.popleft()
        for dr,dc in DIR4:
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return len(seen)==len(pts)

def touches(mask):
    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

def good(h,w,tries=2000):
    interior=[(r,c) for r in range(1,h-1) for c in range(1,w-1)]
    for _ in range(tries):
        start=interior[rng.integers(len(interior))]
        seen={start}; path=[start]
        target=int(rng.integers(max(6,(h+w)//2), min(h*w//2, h*w-2)+1))
        side_counts={'t':0,'b':0,'l':0,'r':0}
        while len(path)<target:
            r,c=path[-1]
            opts=[]
            for dr,dc in DIR4:
                nr,nc=r+dr,c+dc
                if not (0<=nr<h and 0<=nc<w) or (nr,nc) in seen:
                    continue
                score=rng.random()
                on_boundary = nr in (0,h-1) or nc in (0,w-1)
                if nr==0:
                    score += 4.0 if side_counts['t']==0 else -2.5*side_counts['t']
                if nr==h-1:
                    score += 4.0 if side_counts['b']==0 else -2.5*side_counts['b']
                if nc==0:
                    score += 4.0 if side_counts['l']==0 else -2.5*side_counts['l']
                if nc==w-1:
                    score += 4.0 if side_counts['r']==0 else -2.5*side_counts['r']
                if on_boundary:
                    score -= 0.5
                else:
                    score += 0.3
                opts.append((score,(nr,nc)))
            if not opts:
                break
            opts.sort(reverse=True)
            pick=opts[int(rng.integers(min(3,len(opts))))][1]
            path.append(pick); seen.add(pick)
            nr,nc=pick
            if nr==0: side_counts['t']+=1
            if nr==h-1: side_counts['b']+=1
            if nc==0: side_counts['l']+=1
            if nc==w-1: side_counts['r']+=1
        end=path[-1]
        if end[0] in (0,h-1) or end[1] in (0,w-1):
            continue
        m=np.zeros((h,w),dtype=bool)
        for p in path:m[p]=1
        comp=~m
        if not touches(m) or not touches(comp):
            continue
        if not conn(comp):
            continue
        return m, side_counts
    return None,None

for hw in [(5,6),(5,7),(5,8),(6,6),(6,7),(6,8),(7,7),(7,8)]:
    ok=0
    for _ in range(20):
        ok += good(*hw)[0] is not None
    print(hw,ok)
