+def _is_connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return False
+    seen = np.zeros_like(mask, dtype=bool)
+    comp = _component_mask(mask, tuple(map(int, pts[0])), seen)
+    return int(comp.sum()) == int(mask.sum())
+
