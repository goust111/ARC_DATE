+    max_len = max(min_len, min(area // 2, area - 8))
+
+    for _ in range(500):
+        start = interior[int(_RNG.integers(0, len(interior)))]
+        target_len = int(_RNG.integers(min_len, max_len + 1))
+        path = [start]
+        seen = {start}
+        touched: set[str] = set()
+
+        while len(path) < target_len:
+            r, c = path[-1]
+            options = []
+            for dr, dc in DIR4:
+                nr = r + dr
+                nc = c + dc
+                if not (0 <= nr < h and 0 <= nc < w):
+                    continue
+                if (nr, nc) in seen:
+                    continue
+                score = float(_RNG.random())
+                if nr == 0 and "top" not in touched:
+                    score += 3.0
+                if nr == h - 1 and "bottom" not in touched:
+                    score += 3.0
+                if nc == 0 and "left" not in touched:
+                    score += 3.0
+                if nc == w - 1 and "right" not in touched:
+                    score += 3.0
+                if 0 < nr < h - 1 and 0 < nc < w - 1:
+                    score += 0.4
+                options.append((score, (nr, nc)))
+            if not options:
+                break
+            options.sort(key=lambda item: item[0], reverse=True)
+            pick_idx = int(_RNG.integers(0, min(3, len(options))))
+            nr, nc = options[pick_idx][1]
+            path.append((nr, nc))
+            seen.add((nr, nc))
+            if nr == 0:
+                touched.add("top")
+            if nr == h - 1:
+                touched.add("bottom")
+            if nc == 0:
+                touched.add("left")
+            if nc == w - 1:
+                touched.add("right")
+
+        end_r, end_c = path[-1]
+        if len(path) < min_len or end_r in (0, h - 1) or end_c in (0, w - 1):
+            continue
+
+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in path:
+            mask[r, c] = True
+        comp = ~mask
+        if not _touches_all_sides(mask) or not _touches_all_sides(comp):
+            continue
+        if not _is_connected(comp):
+            continue
+        if _canonical_bool_key(mask) == _canonical_bool_key(comp):
+            continue
+        return mask
+    return None
+
