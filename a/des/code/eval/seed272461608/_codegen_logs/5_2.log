+    def search(used: int) -> list[tuple[int, int]] | None:
+        if used == full:
+            return []
+        if used in memo:
+            return memo[used]
+
+        i = 0
+        while (used >> i) & 1:
+            i += 1
+
+        result = None
+        for j in sorted(mates[i]):
+            if (used >> j) & 1:
