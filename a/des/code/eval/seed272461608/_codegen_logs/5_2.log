+        comp_b = {"color": color_b, "mask": mask_b}
+        comp_a["patch"] = _paint_component(mask_a, color_a)
+        comp_b["patch"] = _paint_component(mask_b, color_b)
+        components.extend([comp_a, comp_b])
+        pair_components.append((comp_a, comp_b))
