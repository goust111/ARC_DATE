+
+def _gen_attempt() -> np.ndarray | None:
+    pair_count = int(_RNG.integers(2, 5))
+
+    dims_pool = [
+        (5, 6),
+        (5, 7),
+        (5, 8),
+        (6, 6),
+        (6, 7),
+        (6, 8),
+        (7, 7),
+        (7, 8),
+    ]
+    _RNG.shuffle(dims_pool)
