+            patch = components[idx]["patch"]
+            ph, pw = patch.shape
+            spots = []
+            for _ in range(90):
+                top = int(_RNG.integers(0, h - ph + 1))
+                left = int(_RNG.integers(0, w - pw + 1))
+                if _reserve_ok(reserved, top, left, ph, pw):
