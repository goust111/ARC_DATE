import numpy as np, time, sys
from collections import deque
sys.setrecursionlimit(10000)
DIR4=((1,0),(-1,0),(0,1),(0,-1))

def conn(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:return False
    seen={tuple(pts[0])}; q=deque([tuple(pts[0])]); H,W=mask.shape
    while q:
        r,c=q.popleft()
        for dr,dc in DIR4:
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return len(seen)==len(pts)

def touches(mask):
    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

def side_names(r,c,h,w):
    out=[]
    if r==0: out.append('t')
    if r==h-1: out.append('b')
    if c==0: out.append('l')
    if c==w-1: out.append('r')
    return tuple(out)

def search(h,w,max_seconds=15):
    side_len={'t':w,'b':w,'l':h,'r':h}
    starts=[(r,c) for r in range(1,h-1) for c in range(1,w-1)]
    t0=time.time()
    best=[None]
    for target in range(max(8,h+w-2), min(h*w//2+2, h*w-3)):
        for start in starts:
            seen={start}; path=[start]; counts={'t':0,'b':0,'l':0,'r':0}; touched=set()
            def rec(cur):
                if time.time()-t0 > max_seconds:
                    return True
                if len(path)==target:
                    r,c=cur
                    if not (0<r<h-1 and 0<c<w-1 and len(touched)==4):
                        return False
                    m=np.zeros((h,w),dtype=bool)
                    for p in path:m[p]=1
                    comp=~m
                    if touches(comp) and conn(comp):
                        best[0]=m.copy()
                        return True
                    return False
                rem=target-len(path)
                miss=4-len(touched)
                if rem < miss:
                    return False
                r,c=cur
                opts=[]
                for dr,dc in DIR4:
                    nr,nc=r+dr,c+dc
                    nxt=(nr,nc)
                    if not (0<=nr<h and 0<=nc<w) or nxt in seen:
                        continue
                    new_touch=side_names(nr,nc,h,w)
                    bad=False
                    for s in new_touch:
                        if counts[s]+1 >= side_len[s]:
                            bad=True
                            break
                    if bad:
                        continue
                    score=0
                    # prioritize new sides and staying near boundary without consuming it all
                    for s in new_touch:
                        if s not in touched: score += 10
                    if nr in (0,h-1) or nc in (0,w-1): score += 1
                    score -= abs(nr-(h-1)/2)+abs(nc-(w-1)/2)
                    opts.append((score,nxt,new_touch))
