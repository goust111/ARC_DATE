    side_len={'t':w,'b':w,'l':h,'r':h}
    def side_of(cell):
        r,c=cell
        out=[]
        if r==0: out.append('t')
        if r==h-1: out.append('b')
        if c==0: out.append('l')
        if c==w-1: out.append('r')
        return out
    def lower_bound(cur, touched, used_boundary):
        r,c=cur
        miss=[]
        for s in 'tblr':
            if s not in touched: miss.append(s)
        if not miss:
            # need at least one move to an interior end if on boundary
            return 0 if 0<r<h-1 and 0<c<w-1 else 1
        dists=[]
        for s in miss:
            if s=='t': dists.append(r)
            elif s=='b': dists.append(h-1-r)
            elif s=='l': dists.append(c)
            else: dists.append(w-1-c)
        return max(dists)
    def search(path, seen, touched, side_counts, target):
        cur=path[-1]
        if len(path)==target:
            r,c=cur
            if 0<r<h-1 and 0<c<w-1 and len(touched)==4:
                m=np.zeros((h,w),dtype=bool)
                for p in path:m[p]=1
                comp=~m
                if touches(comp) and conn(comp):
                    return path
            return None
        if len(path)+lower_bound(cur,touched,side_counts)>target:
