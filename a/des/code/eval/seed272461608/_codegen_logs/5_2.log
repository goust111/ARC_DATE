+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(300):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid complementary-fragment puzzle")

