+
+def _random_dihedral(mask: np.ndarray) -> np.ndarray:
+    out = np.asarray(mask, dtype=bool)
+    if int(_RNG.integers(0, 2)):
+        out = np.fliplr(out)
+    return np.rot90(out, int(_RNG.integers(0, 4)))
