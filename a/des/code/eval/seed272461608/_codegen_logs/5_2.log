+            nr, nc = options[pick_idx][1]
+            path.append((nr, nc))
+            seen.add((nr, nc))
+            if nr == 0:
+                touched.add("top")
+            if nr == h - 1:
+                touched.add("bottom")
+            if nc == 0:
+                touched.add("left")
+            if nc == w - 1:
+                touched.add("right")
+
+        end_r, end_c = path[-1]
+        if len(path) < min_len or end_r in (0, h - 1) or end_c in (0, w - 1):
+            continue
