+    return comps
+
+
+def _are_complements(mask_a: np.ndarray, mask_b: np.ndarray) -> bool:
+    for variant in _dihedral_variants(mask_b):
+        if variant.shape == mask_a.shape and np.array_equal(variant, ~mask_a):
+            return True
+    return False
+
+
+def _pair_components(comps: list[dict]) -> list[tuple[int, int]]:
+    n = len(comps)
+    assert n > 0 and n % 2 == 0
+    mates = [[] for _ in range(n)]
+    for i in range(n):
+        for j in range(i + 1, n):
+            if _are_complements(comps[i]["mask"], comps[j]["mask"]):
+                mates[i].append(j)
+                mates[j].append(i)
