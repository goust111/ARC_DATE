import z3
import numpy as np

def find(h,w):
    n=h*w
    X=[[z3.Bool(f'x_{r}_{c}') for c in range(w)] for r in range(h)]
    O=[[z3.Int(f'o_{r}_{c}') for c in range(w)] for r in range(h)]
    R=[[z3.Bool(f'r_{r}_{c}') for c in range(w)] for r in range(h)]
    C=[[z3.Int(f'co_{r}_{c}') for c in range(w)] for r in range(h)]
    CR=[[z3.Bool(f'cr_{r}_{c}') for c in range(w)] for r in range(h)]
    s=z3.Solver()
    dirs=[(1,0),(-1,0),(0,1),(0,-1)]

    def neigh(r,c):
        return [(r+dr,c+dc) for dr,dc in dirs if 0<=r+dr<h and 0<=c+dc<w]

    # side touches for mask and complement
    s.add(z3.Or([X[0][c] for c in range(w)]))
    s.add(z3.Or([X[h-1][c] for c in range(w)]))
    s.add(z3.Or([X[r][0] for r in range(h)]))
    s.add(z3.Or([X[r][w-1] for r in range(h)]))
    s.add(z3.Or([z3.Not(X[0][c]) for c in range(w)]))
    s.add(z3.Or([z3.Not(X[h-1][c]) for c in range(w)]))
    s.add(z3.Or([z3.Not(X[r][0]) for r in range(h)]))
    s.add(z3.Or([z3.Not(X[r][w-1]) for r in range(h)]))

    # avoid trivial area extremes
    area=z3.Sum([z3.If(X[r][c],1,0) for r in range(h) for c in range(w)])
    s.add(area >= max(5, n//4), area <= n - max(5, n//4))

    # connectedness for mask
    s.add(z3.Sum([z3.If(R[r][c],1,0) for r in range(h) for c in range(w)]) == 1)
    for r in range(h):
        for c in range(w):
            s.add(O[r][c] >= 0, O[r][c] <= n)
            s.add(z3.Implies(R[r][c], X[r][c]))
            s.add(z3.Implies(z3.Not(X[r][c]), O[r][c] == 0))
            s.add(z3.Implies(R[r][c], O[r][c] == 1))
            smaller=[z3.And(X[nr][nc], O[nr][nc] > 0, O[nr][nc] < O[r][c]) for nr,nc in neigh(r,c)]
            s.add(z3.Implies(z3.And(X[r][c], z3.Not(R[r][c])), z3.And(O[r][c] > 1, z3.Or(smaller))))

    # connectedness for complement
    s.add(z3.Sum([z3.If(CR[r][c],1,0) for r in range(h) for c in range(w)]) == 1)
    for r in range(h):
        for c in range(w):
            s.add(C[r][c] >= 0, C[r][c] <= n)
            s.add(z3.Implies(CR[r][c], z3.Not(X[r][c])))
            s.add(z3.Implies(X[r][c], C[r][c] == 0))
            s.add(z3.Implies(CR[r][c], C[r][c] == 1))
            smaller=[z3.And(z3.Not(X[nr][nc]), C[nr][nc] > 0, C[nr][nc] < C[r][c]) for nr,nc in neigh(r,c)]
            s.add(z3.Implies(z3.And(z3.Not(X[r][c]), z3.Not(CR[r][c])), z3.And(C[r][c] > 1, z3.Or(smaller))))

    if s.check()"'!=z3.sat:
        print('"'unsat',h,w)
        return None
    m=s.model()
    arr=np.array([[bool(m.evaluate(X[r][c])) for c in range(w)] for r in range(h)], dtype=bool)
    return arr

for dims in [(5,6),(5,7),(6,6),(6,7)]:
    arr=find(*dims)
    print('dims',dims)
    print(arr.astype(int))
    print()
