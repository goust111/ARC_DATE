+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Pair complementary fragments, assemble each pair into a solid rectangle,
+    then sort the rectangles by area and place them left-to-right.
+    """
+    g = np.asarray(grid, dtype=int)
