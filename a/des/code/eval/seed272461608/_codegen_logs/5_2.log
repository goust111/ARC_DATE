+        assert options, "every fragment must have a complementary partner"
+
+    full = (1 << n) - 1
+    memo: dict[int, list[tuple[int, int]] | None] = {}
+
+    def search(used: int) -> list[tuple[int, int]] | None:
+        if used == full:
+            return []
+        if used in memo:
+            return memo[used]
+
+        i = 0
+        while (used >> i) & 1:
+            i += 1
+
+        result = None
+        for j in sorted(mates[i]):
+            if (used >> j) & 1:
+                continue
+            tail = search(used | (1 << i) | (1 << j))
+            if tail is None:
+                continue
+            result = [(i, j)] + tail
+            break
+        memo[used] = result
+        return result
