+    width = sum(int(rect.shape[1]) for rect, _, _ in ordered) + len(ordered) - 1
+    out = np.full((height, width), BG, dtype=int)
+    c = 0
+    for rect, _, _ in ordered:
+        h, w = rect.shape
+        out[:h, c : c + w] = rect
+        c += w + 1
