/bin/bash -lc "python - <<'PY'
import numpy as np
from collections import deque
rng=np.random.default_rng(0)
DIR4=((1,0),(-1,0),(0,1),(0,-1))

def conn(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:return False
    seen={tuple(pts[0])}; q=deque([tuple(pts[0])]); H,W=mask.shape
    while q:
        r,c=q.popleft()
        for dr,dc in DIR4:
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return len(seen)==len(pts)

def touches(mask):
    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

def proto(h,w,tries=2000):
    interior=[(r,c) for r in range(1,h-1) for c in range(1,w-1)]
    for _ in range(tries):
        start=interior[rng.integers(len(interior))]
        seen={start}; path=[start]; boundary_sides=set()
        target=int(rng.integers(max(6,(h+w)//2), min(h*w-1, h*w//2)+1))
        while len(path)<target:
            r,c=path[-1]
            opts=[]
            for dr,dc in DIR4:
                nr,nc=r+dr,c+dc
                if 0<=nr<h and 0<=nc<w and (nr,nc) not in seen:
                    score=0
                    if nr==0 and 't' not in boundary_sides: score+=2
                    if nr==h-1 and 'b' not in boundary_sides: score+=2
                    if nc==0 and 'l' not in boundary_sides: score+=2
                    if nc==w-1 and 'r' not in boundary_sides: score+=2
                    score += rng.random()
                    opts.append((score,(nr,nc)))
            if not opts: break
            opts.sort(reverse=True)
            p=opts[0][1]
            seen.add(p); path.append(p)
            nr,nc=p
            if nr==0: boundary_sides.add('t')
            if nr==h-1: boundary_sides.add('b')
            if nc==0: boundary_sides.add('l')
            if nc==w-1: boundary_sides.add('r')
        end=path[-1]
        if len(path)<6 or end[0] in (0,h-1) or end[1] in (0,w-1):
            continue
        m=np.zeros((h,w),dtype=bool)
        for p in path:m[p]=1
        if touches(m) and conn(~m):
            return m
    return None

def score(m):
    comp=~m
    return sum([conn(m), conn(comp), touches(m), touches(comp)])

def repair(m,steps=20000):
    cur=m.copy(); cur_score=score(cur)
    H,W=cur.shape
    best=cur.copy(); best_score=cur_score
    for t in range(steps):
        occ=list(map(tuple,np.argwhere(cur)))
        if not occ: break
        r,c=occ[rng.integers(len(occ))]
        neigh=[]
        for dr,dc in DIR4:
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and not cur[nr,nc]:
                neigh.append((nr,nc))
        if not neigh:
            continue
        nr,nc=neigh[rng.integers(len(neigh))]
        nxt=cur.copy(); nxt[r,c]=False; nxt[nr,nc]=True
        s=score(nxt)
        if s>=cur_score or rng.random()<0.05:
            cur=nxt; cur_score=s
            if s>best_score:
                best=nxt.copy(); best_score=s
            if s==4:
                return nxt
    return best

for hw in [(5,6),(5,7),(6,6),(6,7)]:
    found=None
    for k in range(50):
        m=proto(*hw)
        if m is None: continue
        r=repair(m,15000)
        if score(r)==4:
            found=r; break
    print('dims',hw,'found',found is not None)
    if found is not None:
        print(found.astype(int))
        print('comp')
        print((~found).astype(int))
