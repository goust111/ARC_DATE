+
+def _simple_path_mask(h: int, w: int) -> np.ndarray | None:
+    interior = [(r, c) for r in range(1, h - 1) for c in range(1, w - 1)]
+    if len(interior) < 2:
+        return None
+
+    area = h * w
+    min_len = max(8, h + w - 2)
+    max_len = max(min_len, min(area // 2, area - 8))
+
+    for _ in range(500):
+        start = interior[int(_RNG.integers(0, len(interior)))]
+        target_len = int(_RNG.integers(min_len, max_len + 1))
+        path = [start]
+        seen = {start}
+        touched: set[str] = set()
+
+        while len(path) < target_len:
+            r, c = path[-1]
+            options = []
+            for dr, dc in DIR4:
+                nr = r + dr
+                nc = c + dc
+                if not (0 <= nr < h and 0 <= nc < w):
+                    continue
+                if (nr, nc) in seen:
+                    continue
+                score = float(_RNG.random())
+                if nr == 0 and "top" not in touched:
+                    score += 3.0
+                if nr == h - 1 and "bottom" not in touched:
+                    score += 3.0
+                if nc == 0 and "left" not in touched:
+                    score += 3.0
+                if nc == w - 1 and "right" not in touched:
+                    score += 3.0
+                if 0 < nr < h - 1 and 0 < nc < w - 1:
+                    score += 0.4
