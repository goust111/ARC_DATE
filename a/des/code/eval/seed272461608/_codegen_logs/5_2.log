import numpy as np

def cycle_even_h(h,w):
    out=[]
    out += [(0,c) for c in range(w)]
    for r in range(1,h):
        cols=range(w-1,0,-1) if r%2==1 else range(1,w)
        out += [(r,c) for c in cols]
    out += [(r,0) for r in range(h-1,0,-1)]
    assert len(out)==h*w
    for a,b in zip(out,out[1:]+out[:1]):
        assert abs(a[0]-b[0])+abs(a[1]-b[1])==1
    assert len(set(out))==h*w
    return out

def cycle(h,w):
    if h%2==0:
        return cycle_even_h(h,w)
    base=cycle_even_h(w,h)
    return [(c,r) for r,c in base]

def touches(mask):
    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

def exists(h,w):
    cyc=cycle(h,w)
    n=len(cyc)
    ok=[]
    for s in range(n):
        for L in range(4,n-3):
            m=np.zeros((h,w),dtype=bool)
            for k in range(L):
                r,c=cyc[(s+k)%n]
                m[r,c]=1
            if touches(m) and touches(~m):
                ok.append((s,L,m.sum(),(~m).sum()))
                return ok[0]
    return None
for hw in [(4,4),(4,5),(5,6),(6,6),(6,7)]:
    print(hw, exists(*hw))
