+    mask_b = np.asarray(comp_b["mask"], dtype=bool)
+    assert _are_complements(mask_a, mask_b)
+
+    if _component_role_key(mask_b) < _component_role_key(mask_a):
+        comp_a, comp_b = comp_b, comp_a
