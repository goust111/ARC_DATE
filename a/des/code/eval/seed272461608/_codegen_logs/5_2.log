+        rect, label_key = _assemble_pair(comp_a, comp_b)
+        rectangles.append((rect, int(rect.shape[0] * rect.shape[1]), label_key))
+    return _compose_output(rectangles)
+
+
+def _gen_attempt() -> np.ndarray | None:
