+    best_key: tuple[int, int, bytes] | None = None
+    for variant in _dihedral_variants(np.asarray(labels, dtype=np.int8)):
+        key = (int(variant.shape[0]), int(variant.shape[1]), variant.tobytes())
+        if best_key is None or key < best_key:
+            best_key = key
+            best_arr = variant
