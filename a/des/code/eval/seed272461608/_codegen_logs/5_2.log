+def _component_role_key(mask: np.ndarray) -> tuple[tuple[int, int, bytes], int, int, bytes]:
+    tight = np.asarray(mask, dtype=bool)
+    return _canonical_bool_key(tight), int(tight.shape[0]), int(tight.shape[1]), tight.tobytes()
