+    h0, w0 = reserved.shape
+    r0 = max(0, top - 1)
+    c0 = max(0, left - 1)
+    r1 = min(h0, top + h + 1)
+    c1 = min(w0, left + w + 1)
+    reserved[r0:r1, c0:c1] = True
+
+
