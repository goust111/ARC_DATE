/bin/bash -lc "python - <<'PY'
import numpy as np
from collections import deque
rng=np.random.default_rng(0)
DIR4=((1,0),(-1,0),(0,1),(0,-1))

def conn(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:return False
    seen={tuple(pts[0])}; q=deque([tuple(pts[0])]); H,W=mask.shape
    while q:
        r,c=q.popleft()
        for dr,dc in DIR4:
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return len(seen)==len(pts)

def touches(mask):
    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

def random_tree_vertices(R,C):
    verts=[(r,c) for r in range(R) for c in range(C)]
    start=verts[rng.integers(len(verts))]
    in_tree={start}
    edges=[]
    while len(in_tree)<len(verts):
        frontier=[]
        for vr,vc in list(in_tree):
            for dr,dc in DIR4:
                nr,nc=vr+dr,vc+dc
                if 0<=nr<R and 0<=nc<C and (nr,nc) not in in_tree:
                    frontier.append(((vr,vc),(nr,nc)))
        a,b=frontier[rng.integers(len(frontier))]
        in_tree.add(b); edges.append((a,b))
    return edges

def embed(R,C,scale=3):
    H,W=scale*(R-1)+1, scale*(C-1)+1
    fine=np.zeros((H,W),dtype=bool)
    for (a,b) in random_tree_vertices(R,C):
        for vr,vc in [a,b]:
            fine[scale*vr, scale*vc]=1
        fr,fc=scale*a[0], scale*a[1]
        tr,tc=scale*b[0], scale*b[1]
        dr=np.sign(tr-fr); dc=np.sign(tc-fc)
        rr,cc=fr,fc
        while (rr,cc)"'!=(tr,tc):
            rr += dr; cc += dc; fine[rr,cc]=1
    return fine

for RC in [(3,4),(4,4),(4,5)]:
    found=0
    for _ in range(500):
        m=embed(*RC, scale=3)
        if touches(m) and conn(m) and touches(~m) and conn(~m):
            print('"'FOUND',RC,m.shape)
            print(m.astype(int))
            found=1
            break
    print('rc',RC,'found',found)
