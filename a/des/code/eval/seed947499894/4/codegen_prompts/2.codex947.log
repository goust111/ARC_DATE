+
+BODY_COLOR = 5
+ALL_COLORS = tuple(range(10))
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GENERATION_ATTEMPTS = 400
+PLACEMENT_SAMPLES = 240
