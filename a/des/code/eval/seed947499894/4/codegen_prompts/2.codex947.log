+            assert len(ordered) >= 3, "segment too short"
+            segments.append(
+                {
+                    "ordered": ordered,
+                    "endpoints": (ordered[0], ordered[-1]),
+                    "port_colors": (int(grid[ordered[0]]), int(grid[ordered[-1]])),
+                    "body": ordered[1:-1],
