+def _extract_segments(grid: np.ndarray, bg: int, legend_mask: np.ndarray):
+    h, w = grid.shape
+    mask = (grid != bg) & (~legend_mask)
+    seen = np.zeros_like(mask, dtype=bool)
+    segments = []
+
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp = []
+            while stack:
