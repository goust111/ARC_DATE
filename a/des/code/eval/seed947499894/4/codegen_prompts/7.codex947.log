+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.asarray(coords, dtype=int))
+    return comps
+
+
+def _frame_info(grid: np.ndarray, coords: np.ndarray, bg: int) -> dict | None:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    r0 = int(rows.min())
+    r1 = int(rows.max())
+    c0 = int(cols.min())
+    c1 = int(cols.max())
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+    if int(coords.shape[0]) != 2 * (h + w) - 4:
+        return None
+    for r, c in coords:
+        if int(r) not in (r0, r1) and int(c) not in (c0, c1):
+            return None
+    if not np.all(grid[r0 + 1 : r1, c0 + 1 : c1] == bg):
+        return None
+    return {"r0": r0, "c0": c0, "r1": r1, "c1": c1, "h": h, "w": w}
+
+
+def _find_slots(grid: np.ndarray, bg: int) -> tuple[int, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    groups: dict[tuple[int, int, int, int, int], list[dict]] = {}
+    for color in map(int, np.unique(g)):
