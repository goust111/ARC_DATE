+    for item, slot in zip(items, slots):
+        inner_r0 = slot["r0"] + 1
+        inner_c0 = slot["c0"] + 1
+        assert item["h"] <= slot["h"] - 2 and item["w"] <= slot["w"] - 2
+        out[inner_r0 : inner_r0 + item["h"], inner_c0 : inner_c0 + item["w"]] = item["color"]
+
