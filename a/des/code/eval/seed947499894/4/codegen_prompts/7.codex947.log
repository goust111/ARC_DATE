+COLORS = tuple(range(10))
+RECT_COUNT_RANGE = (3, 5)
+RECT_WIDTH_RANGE = (2, 6)
+SLOT_GAP_RANGE = (1, 3)
+STACK_SLOT_GAP_RANGE = (2, 4)
+TOP_BOTTOM_MARGIN_RANGE = (1, 2)
