        dims.append((rh, rw))

    anchor_r = random.randint(1, h - 2)
    anchor_c = random.randint(1, max(1, stack_c_max - 1))
    order = list(range(n_rects))
    random.shuffle(order)

    for color, (rh, rw) in zip(colors, dims):
        row_candidates = []
        col_candidates = []
        r_start = max(0, anchor_r - rh + 1)
        r_end = min(anchor_r, h - rh)
        c_start = max(0, anchor_c - rw + 1)
        c_end = min(anchor_c, stack_c_max - rw)
        if r_start > r_end or c_start > c_end:
