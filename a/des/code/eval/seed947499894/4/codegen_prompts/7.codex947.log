+SLOT_GAP_RANGE = (1, 3)
+STACK_SLOT_GAP_RANGE = (2, 4)
+TOP_BOTTOM_MARGIN_RANGE = (1, 2)
+LEFT_RIGHT_MARGIN_RANGE = (1, 2)
+INNER_EXTRA_RANGE = (0, 2)
+GEN_ATTEMPTS = 500
+
+
+def _height_range(n_rects: int) -> tuple[int, int]:
+    if n_rects >= 5:
+        return 2, 3
+    if n_rects == 4:
+        return 2, 4
+    return 2, 5
+
+
+def _rect_area(rect: dict) -> int:
+    return int((rect["r1"] - rect["r0"] + 1) * (rect["c1"] - rect["c0"] + 1))
+
+
+def _overlap_area(a: dict, b: dict) -> int:
+    r0 = max(int(a["r0"]), int(b["r0"]))
+    c0 = max(int(a["c0"]), int(b["c0"]))
+    r1 = min(int(a["r1"]), int(b["r1"]))
+    c1 = min(int(a["c1"]), int(b["c1"]))
+    if r0 > r1 or c0 > c1:
+        return 0
+    return int((r1 - r0 + 1) * (c1 - c0 + 1))
+
+
+def _render_input(
+    h: int,
+    w: int,
+    bg: int,
+    grey: int,
+    slots: list[dict],
+    rects: list[dict],
+    order: list[int],
+) -> np.ndarray:
+    grid = np.full((h, w), bg, dtype=int)
+    for slot in slots:
+        r0, c0, r1, c1 = slot["r0"], slot["c0"], slot["r1"], slot["c1"]
+        grid[r0, c0 : c1 + 1] = grey
+        grid[r1, c0 : c1 + 1] = grey
+        grid[r0 : r1 + 1, c0] = grey
+        grid[r0 : r1 + 1, c1] = grey
+    for idx in order:
+        rect = rects[idx]
+        grid[rect["r0"] : rect["r1"] + 1, rect["c0"] : rect["c1"] + 1] = rect["color"]
+    return grid
+
+
+def _expected_output(
+    h: int,
+    w: int,
+    bg: int,
+    grey: int,
+    slots: list[dict],
+    rects: list[dict],
+    visible_counts: dict[int, int],
+) -> np.ndarray:
+    out = np.full((h, w), bg, dtype=int)
+    for slot in slots:
+        r0, c0, r1, c1 = slot["r0"], slot["c0"], slot["r1"], slot["c1"]
+        out[r0, c0 : c1 + 1] = grey
+        out[r1, c0 : c1 + 1] = grey
+        out[r0 : r1 + 1, c0] = grey
+        out[r0 : r1 + 1, c1] = grey
+
+    ranked = sorted(
+        rects,
+        key=lambda rect: (-visible_counts[rect["color"]], rect["r0"], rect["c0"], rect["color"]),
+    )
+    for slot, rect in zip(sorted(slots, key=lambda item: item["r0"]), ranked):
+        rr = slot["r0"] + 1
+        cc = slot["c0"] + 1
+        rh = rect["r1"] - rect["r0"] + 1
+        rw = rect["c1"] - rect["c0"] + 1
+        out[rr : rr + rh, cc : cc + rw] = rect["color"]
+    return out
+
+
+def _sample_slots(n_rects: int, inner_h: int, inner_w: int, stack_w: int) -> tuple[int, int, list[dict]]:
+    slot_h = inner_h + 2
+    slot_w = inner_w + 2
+    slot_gap = random.randint(*SLOT_GAP_RANGE)
+    top_margin = random.randint(*TOP_BOTTOM_MARGIN_RANGE)
+    bottom_margin = random.randint(*TOP_BOTTOM_MARGIN_RANGE)
+    left_margin = random.randint(*LEFT_RIGHT_MARGIN_RANGE)
+    right_margin = random.randint(*LEFT_RIGHT_MARGIN_RANGE)
+    middle_gap = random.randint(*STACK_SLOT_GAP_RANGE)
+
+    h = top_margin + n_rects * slot_h + (n_rects - 1) * slot_gap + bottom_margin
+    w = left_margin + stack_w + middle_gap + slot_w + right_margin
+    slot_c0 = left_margin + stack_w + middle_gap
+    slots = []
+    row = top_margin
+    for _ in range(n_rects):
+        slots.append({"r0": row, "c0": slot_c0, "r1": row + slot_h - 1, "c1": slot_c0 + slot_w - 1})
+        row += slot_h + slot_gap
+    return h, w, slots
+
+
+def _sample_rects(
+    n_rects: int,
+    colors: list[int],
+    h: int,
+    stack_c_max: int,
+) -> tuple[list[dict], list[int]] | None:
+    h_lo, h_hi = _height_range(n_rects)
+    rects = []
+    dims = []
+    for _ in range(n_rects):
+        rh = random.randint(h_lo, h_hi)
+        rw = random.randint(*RECT_WIDTH_RANGE)
+        dims.append((rh, rw))
+
+    anchor_r = random.randint(1, h - 2)
+    anchor_c = random.randint(1, max(1, stack_c_max - 1))
+    order = list(range(n_rects))
+    random.shuffle(order)
+
+    for color, (rh, rw) in zip(colors, dims):
+        row_candidates = []
+        col_candidates = []
+        r_start = max(0, anchor_r - rh + 1)
+        r_end = min(anchor_r, h - rh)
+        c_start = max(0, anchor_c - rw + 1)
+        c_end = min(anchor_c, stack_c_max - rw)
+        if r_start > r_end or c_start > c_end:
+            return None
+
+        for r0 in range(r_start, r_end + 1):
+            local = anchor_r - r0
+            if rh >= 3 and 1 <= local <= rh - 2:
+                row_candidates.append(r0)
+        for c0 in range(c_start, c_end + 1):
+            local = anchor_c - c0
+            if rw >= 3 and 1 <= local <= rw - 2:
+                col_candidates.append(c0)
+        if not row_candidates:
+            row_candidates = list(range(r_start, r_end + 1))
+        if not col_candidates:
+            col_candidates = list(range(c_start, c_end + 1))
+
+        r0 = random.choice(row_candidates)
+        c0 = random.choice(col_candidates)
+        rects.append({"color": color, "r0": r0, "c0": c0, "r1": r0 + rh - 1, "c1": c0 + rw - 1})
+
+    return rects, order
+
+
+def _visibility_ok(grid: np.ndarray, rects: list[dict], order: list[int]) -> tuple[bool, dict[int, int]]:
+    visible_counts: dict[int, int] = {}
+    touched = 0
+    for rect in rects:
+        color = rect["color"]
+        coords = np.argwhere(grid == color)
+        if coords.size == 0:
+            return False, {}
+        rows = coords[:, 0]
+        cols = coords[:, 1]
+        bbox = (int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max()))
+        full_bbox = (rect["r0"], rect["c0"], rect["r1"], rect["c1"])
+        if bbox != full_bbox:
+            return False, {}
+        visible_counts[color] = int(coords.shape[0])
+        if visible_counts[color] < _rect_area(rect):
+            touched += 1
+
+    if len(set(visible_counts.values())) != len(rects):
+        return False, {}
+
+    top_order = tuple(rects[idx]["color"] for idx in reversed(order))
+    visible_order = tuple(
+        rect["color"]
+        for rect in sorted(rects, key=lambda item: (-visible_counts[item["color"]], item["r0"], item["c0"], item["color"]))
+    )
+    if visible_order == top_order:
+        return False, {}
+    if touched < max(1, len(rects) - 2):
+        return False, {}
+    return True, visible_counts
+
+
+def _gen_attempt() -> np.ndarray | None:
+    n_rects = random.randint(*RECT_COUNT_RANGE)
+    palette = list(COLORS)
+    bg, grey = random.sample(palette, 2)
+    rect_colors = random.sample([c for c in palette if c not in (bg, grey)], n_rects)
+
+    h_lo, h_hi = _height_range(n_rects)
+    max_rect_h = h_hi
+    max_rect_w = RECT_WIDTH_RANGE[1]
+    inner_h = random.randint(h_lo, max_rect_h + random.randint(*INNER_EXTRA_RANGE))
+    inner_w = random.randint(RECT_WIDTH_RANGE[0], max_rect_w + random.randint(*INNER_EXTRA_RANGE))
+
+    stack_w = max(inner_w + 4, random.randint(inner_w + 4, inner_w + 10))
+    h, w, slots = _sample_slots(n_rects, inner_h, inner_w, stack_w)
+    stack_c_max = slots[0]["c0"] - 2
+    if stack_c_max < inner_w + 1:
+        return None
+
+    sampled = _sample_rects(n_rects, rect_colors, h, stack_c_max)
+    if sampled is None:
+        return None
+    rects, order = sampled
+
+    max_h = max(rect["r1"] - rect["r0"] + 1 for rect in rects)
+    max_w = max(rect["c1"] - rect["c0"] + 1 for rect in rects)
+    if max_h > inner_h or max_w > inner_w:
+        return None
+
+    overlap_pairs = 0
+    for i in range(n_rects):
+        for j in range(i + 1, n_rects):
+            if _overlap_area(rects[i], rects[j]) > 0:
+                overlap_pairs += 1
+    if overlap_pairs < max(2, n_rects - 2):
+        return None
+
+    inp = _render_input(h, w, bg, grey, slots, rects, order)
+    if _most_common_color(inp) != bg:
+        return None
+
+    ok, visible_counts = _visibility_ok(inp, rects, order)
+    if not ok:
+        return None
+
+    expected = _expected_output(h, w, bg, grey, slots, rects, visible_counts)
+    if not np.array_equal(main(inp), expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate valid input after {GEN_ATTEMPTS} attempts")

