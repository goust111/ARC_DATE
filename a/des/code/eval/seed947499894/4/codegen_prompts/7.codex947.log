+    r1 = int(rows.max())
+    c0 = int(cols.min())
+    c1 = int(cols.max())
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+    if int(coords.shape[0]) != 2 * (h + w) - 4:
+        return None
+    for r, c in coords:
+        if int(r) not in (r0, r1) and int(c) not in (c0, c1):
