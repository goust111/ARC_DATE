import random, numpy as np

RECT_COUNT_RANGE=(3,5)
RECT_WIDTH_CAP={3:8,4:7,5:6}
HEIGHT_CAP={3:6,4:5,5:4}


def sample_dims(n):
    height_cap=HEIGHT_CAP[n]
    width_cap=RECT_WIDTH_CAP[n]
    for _ in range(200):
        top_h=random.randint(2, min(3, height_cap))
        top_w=random.randint(2, min(4, width_cap))
        dims=[(top_h,top_w)]
        h,w=top_h,top_w
        ok=True
        for _ in range(n-1):
            added=False
            for __ in range(100):
                at=random.randint(0, 1 if h < height_cap else 0)
                ab=random.randint(0, 1 if h < height_cap else 0)
                al=random.randint(0, 2 if w < width_cap else 0)
                ar=random.randint(0, 2 if w < width_cap else 0)
                if at+ab+al+ar==0:
                    continue
                nh=h+at+ab
                nw=w+al+ar
                if nh<=height_cap and nw<=width_cap:
                    h,w=nh,nw
                    dims.append((h,w))
                    added=True
                    break
            if not added:
                ok=False
                break
        if ok and len({d[0]*d[1] for d in dims})==n:
            return list(reversed(dims))
    return None


def render(H,W,rects):
    g=np.zeros((H,W),int)
    for color,r0,c0,r1,c1 in rects:
        g[r0:r1+1,c0:c1+1]=color
    return g

ok=0
reason={}
for _ in range(5000):
    n=random.randint(*RECT_COUNT_RANGE)
    dims=sample_dims(n)
    if dims is None:
        reason['dims_none']=reason.get('dims_none',0)+1; continue
    H=40; W=25; stack_c_max=12
    brh,brw=dims[0]
    if brw>stack_c_max: continue
    base_r0=random.randint(0,H-brh)
    base_c0=random.randint(0,stack_c_max-brw)
    rects=[]
    colors=random.sample(range(1,10), n)
    outer=(base_r0,base_c0,base_r0+brh-1,base_c0+brw-1)
    rects.append((colors[0],)+outer)
    good_place=True
    for i,(hh,ww) in enumerate(dims[1:], start=1):
        or0,oc0,or1,oc1=outer
        oh=or1-or0+1; ow=oc1-oc0+1
        rmin = or0 + (1 if ww == ow else 0)
        rmax = or1 - hh + 1 - (1 if ww == ow else 0)
        cmin = oc0 + (1 if hh == oh else 0)
        cmax = oc1 - ww + 1 - (1 if hh == oh else 0)
        if rmin > rmax or cmin > cmax:
            good_place=False
            break
        nr0=random.randint(rmin, rmax)
        nc0=random.randint(cmin, cmax)
        outer=(nr0,nc0,nr0+hh-1,nc0+ww-1)
        rects.append((colors[i],)+outer)
    if not good_place:
        reason['place_fail']=reason.get('place_fail',0)+1; continue
    g=render(H,W,rects)
    vis=[]
    valid=True
    for color,r0,c0,r1,c1 in rects:
        coords=np.argwhere(g==color)
        bbox=(coords[:,0].min(),coords[:,1].min(),coords[:,0].max(),coords[:,1].max()) if len(coords) else None
        if bbox"'!=(r0,c0,r1,c1):
            valid=False; reason['"'bbox']=reason.get('bbox',0)+1; break
        vis.append((color,len(coords)))
    if not valid: continue
    if len(set(v for _,v in vis))"'!=n:
        reason['"'tie']=reason.get('tie',0)+1; continue
    top_order=tuple(color for color, *_ in reversed(rects))
    vis_order=tuple(color for color,_ in sorted(vis,key=lambda x:-x[1]))
    if vis_order==top_order:
        reason['same_top']=reason.get('same_top',0)+1; continue
    ok+=1
print('ok',ok)
print(reason)
