+    items = []
+    for color in map(int, np.unique(g)):
+        if color in (bg, grey):
+            continue
+        coords = np.argwhere(g == color)
+        if coords.size == 0:
+            continue
+        rows = coords[:, 0]
+        cols = coords[:, 1]
+        r0 = int(rows.min())
+        r1 = int(rows.max())
+        c0 = int(cols.min())
+        c1 = int(cols.max())
+        items.append(
+            {
+                "color": color,
+                "visible": int(coords.shape[0]),
+                "h": r1 - r0 + 1,
+                "w": c1 - c0 + 1,
+                "bbox": (r0, c0, r1, c1),
+            }
+        )
