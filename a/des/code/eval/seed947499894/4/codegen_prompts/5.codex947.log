+
+def _choose_origin(
+    rel_cells: np.ndarray, shape: tuple[int, int], mode: str, rng: np.random.Generator
+) -> tuple[int, int] | None:
+    rows, cols = _safe_center_ranges(rel_cells, shape)
+    candidates = [
+        (r, c)
+        for r in rows
+        for c in cols
