+
+def _safe_center_ranges(rel_cells: np.ndarray, shape: tuple[int, int]) -> tuple[range, range]:
+    h, w = shape
+    rmin = int(rel_cells[:, 0].min())
+    rmax = int(rel_cells[:, 0].max())
