+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    h, w = mask.shape
+    start = tuple(int(x) for x in coords[0])
+    seen = {start}
+    stack = [start]
+    while stack:
+        r, c = stack.pop()
+        for rr, cc in _neighbors4(r, c, h, w):
+            if mask[rr, cc] and (rr, cc) not in seen:
+                seen.add((rr, cc))
+                stack.append((rr, cc))
+    return len(seen) == int(mask.sum())
