+    h, w = instruction_area.shape
+    centers = []
+    for r, c in coords:
+        r = int(r)
+        c = int(c)
+        if 0 < r < h - 1 and 0 < c < w - 1:
+            if (
+                grey_mask[r - 1, c]
+                and grey_mask[r + 1, c]
+                and grey_mask[r, c - 1]
+                and grey_mask[r, c + 1]
+            ):
