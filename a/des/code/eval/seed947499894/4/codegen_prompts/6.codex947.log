+    expected[:, 0] = True
+    expected[:, -1] = True
+    if np.array_equal(sub, expected):
+        return int(r0), int(c0), int(r1), int(c1)
+    return None
+
+
+def _find_frame(grid: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int]]:
