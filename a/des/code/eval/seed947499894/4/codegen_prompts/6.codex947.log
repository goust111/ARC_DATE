+        inner_w = random.randint(*INNER_W_RANGE)
+        frame_h = inner_h + 2
+        frame_w = inner_w + 2
+        if frame_h >= height - 1 or frame_w >= width - 1:
+            continue
+        r0 = random.randint(1, height - frame_h - 1)
+        c0 = random.randint(1, width - frame_w - 1)
