+    assert inner_values.size == 1, "interior must be monochrome"
+    return int(outer_values[0]), int(inner_values[0])
+
+
+def _orientation_side(patch: np.ndarray, bg: int) -> str:
+    mask = patch != bg
+    boundary = _component_boundary(mask)
