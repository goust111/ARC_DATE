+
+
+def _draw_frame(dst: np.ndarray, frame_bbox: tuple[int, int, int, int], color: int) -> None:
+    r0, c0, r1, c1 = frame_bbox
+    dst[r0, c0 : c1 + 1] = int(color)
+    dst[r1, c0 : c1 + 1] = int(color)
+    dst[r0 : r1 + 1, c0] = int(color)
+    dst[r0 : r1 + 1, c1] = int(color)
