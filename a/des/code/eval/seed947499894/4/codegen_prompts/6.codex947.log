+def _recolor_outer(patch: np.ndarray, bg: int, new_color: int) -> np.ndarray:
+    out = np.array(patch, copy=True)
+    boundary = _component_boundary(out != bg)
+    out[boundary] = int(new_color)
+    return out
+
