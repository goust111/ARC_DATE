+
+
+def _placement_origin(
+    patch: np.ndarray,
+    bg: int,
+    side: str,
+    key_coord: tuple[int, int],
+    frame_bbox: tuple[int, int, int, int],
+) -> tuple[int, int]:
+    mask = patch != bg
+    h, w = patch.shape
+    r0, c0, r1, c1 = frame_bbox
+    kr, kc = key_coord
