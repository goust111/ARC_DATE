+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+FRAME_COLOR = 3
+SIDES = ("top", "right", "bottom", "left")
+
+GRID_H_RANGE = (22, 30)
+GRID_W_RANGE = (22, 30)
+INNER_H_RANGE = (11, 17)
+INNER_W_RANGE = (11, 17)
+BASE_DIM_CHOICES = (3, 4, 5)
+GEN_RETRIES = 500
+LAYOUT_RETRIES = 120
