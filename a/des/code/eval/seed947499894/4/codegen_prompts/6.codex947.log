+    return int(kr - _frontier_anchor(mask, side)), int(c1 - w)
+
+
+def _paste_non_bg(dst: np.ndarray, patch: np.ndarray, top: int, left: int, bg: int) -> None:
+    h, w = patch.shape
+    view = dst[top : top + h, left : left + w]
+    mask = patch != bg
