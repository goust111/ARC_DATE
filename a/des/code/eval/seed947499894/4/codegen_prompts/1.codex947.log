+    if not np.all(sub[0, :] == color):
+        return None
+    if not np.all(sub[-1, :] == color):
+        return None
+    if not np.all(sub[:, 0] == color):
+        return None
+    if not np.all(sub[:, -1] == color):
+        return None
+    if height > 2 and width > 2 and np.any(sub[1:-1, 1:-1] == color):
