+    for r in range(h - 1):
+        if not np.array_equal(grid[r], grid[r + 1]):
+            continue
+        row = grid[r]
+        non_bg = row != bg
+        runs = _true_runs(non_bg)
+        if not runs or not all(end - start + 1 == 2 for start, end in runs):
