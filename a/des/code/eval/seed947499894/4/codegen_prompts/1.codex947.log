+        out[r0, c0 : c1 + 1] = mapped_border
+        out[r1, c0 : c1 + 1] = mapped_border
+        out[r0 : r1 + 1, c0] = mapped_border
+        out[r0 : r1 + 1, c1] = mapped_border
