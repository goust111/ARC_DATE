+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_RETRIES):
+        built = _build_case(rng)
+        if built is None:
+            continue
+        grid, expected = built
+        if np.array_equal(main(grid), expected):
+            return grid
+    raise RuntimeError("failed to generate a valid input")

