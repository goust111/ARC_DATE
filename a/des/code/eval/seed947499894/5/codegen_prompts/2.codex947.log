CROSS_AXIS_PADDING = 2

# Gate count, spacing, and wall thickness.
BETWEEN_GATE_COUNTS = (2, 3)
GATE_TOTAL_MIN, GATE_TOTAL_MAX = 2, 8
GATE_SPACING_MIN, GATE_SPACING_MAX = 2, 4
GATE_SEGMENT_LEN = 2

