+def _mark_rect(occupied: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int = 1) -> None:
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(occupied.shape[0] - 1, r0 + h - 1 + pad)
+    cc1 = min(occupied.shape[1] - 1, c0 + w - 1 + pad)
+    occupied[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
