+def _balanced_directions(rng: np.random.Generator, n: int) -> list[str]:
+    base = ["right", "down", "left", "up"]
+    out: list[str] = []
+    while len(out) < n:
+        block = list(base)
+        rng.shuffle(block)
+        out.extend(block)
+    return out[:n]
