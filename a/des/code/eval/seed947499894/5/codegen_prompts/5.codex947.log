+def _payload_patch(rng: np.random.Generator, inner_h: int, inner_w: int) -> np.ndarray | None:
+    size_cap = min(4, inner_h, inner_w)
+    if size_cap < 2:
+        return None
+    for _ in range(120):
+        ph = int(rng.integers(2, size_cap + 1))
+        pw = int(rng.integers(2, size_cap + 1))
