+    for src, dst in _pair_frames(loaded, empty):
+        sr0, sc0, sr1, sc1 = src["r0"], src["c0"], src["r1"], src["c1"]
+        out[sr0 + 1 : sr1, sc0 + 1 : sc1] = BLACK
+
+        payload = np.rot90(src["payload"], DIR_TO_ROT[src["direction"]])
