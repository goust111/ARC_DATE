+    loaded, empty = _classify_frames(grid)
+    if len(loaded) != n_pairs or len(empty) != n_pairs:
+        return None
+    if len(_pair_frames(loaded, empty)) != n_pairs:
+        return None
+
+    out = main(grid)
+    if out.shape != grid.shape or np.array_equal(out, grid):
+        return None
+    return grid
