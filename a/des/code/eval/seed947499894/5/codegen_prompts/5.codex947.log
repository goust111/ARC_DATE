+    "right": 0,
+    "down": 3,   # clockwise 90
+    "left": 2,
+    "up": 1,     # counter-clockwise 90
+}
+
+ARROW_SHAPES = {
+    "right": ((3, 2), {(0, 0), (1, 1), (2, 0)}),
+    "left": ((3, 2), {(0, 1), (1, 0), (2, 1)}),
+    "up": ((2, 3), {(1, 0), (0, 1), (1, 2)}),
+    "down": ((2, 3), {(0, 0), (1, 1), (0, 2)}),
