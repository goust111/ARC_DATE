+
+BLACK = 0
+BLUE = 1
+RED = 2
+PAYLOAD_COLORS = (3, 4, 5, 6, 7, 8, 9)
+
+DIR_TO_ROT = {
+    "right": 0,
+    "down": 3,   # clockwise 90
+    "left": 2,
+    "up": 1,     # counter-clockwise 90
+}
+
+ARROW_VARIANTS = {
+    "right": [
+        ((3, 2), {(0, 0), (1, 1), (2, 0)}),
+        ((2, 2), {(0, 0), (1, 1)}),
+    ],
+    "left": [
+        ((3, 2), {(0, 1), (1, 0), (2, 1)}),
+        ((2, 2), {(0, 1), (1, 0)}),
+    ],
+    "up": [
+        ((2, 3), {(1, 0), (0, 1), (1, 2)}),
+        ((2, 2), {(0, 1), (1, 0)}),
+    ],
+    "down": [
+        ((2, 3), {(0, 0), (1, 1), (0, 2)}),
+        ((2, 2), {(0, 0), (1, 1)}),
+    ],
+}
+
+GEN_RETRIES = 400
+PAIR_COUNT_RANGE = (2, 6)  # high exclusive
+INNER_SIZE_RANGE = (5, 9)  # high exclusive
+GRID_MAX = 35
