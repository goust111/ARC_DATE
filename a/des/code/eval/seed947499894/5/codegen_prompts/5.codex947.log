+def _arrow_cells(rng: np.random.Generator, inner_h: int, inner_w: int, direction: str) -> set[tuple[int, int]] | None:
+    variants = ARROW_VARIANTS[direction]
+    (ah, aw), rel = variants[int(rng.integers(len(variants)))]
