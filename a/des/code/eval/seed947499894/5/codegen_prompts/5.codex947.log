+def _expanded_cells(cells: set[tuple[int, int]], inner_h: int, inner_w: int) -> set[tuple[int, int]]:
+    blocked: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < inner_h and 0 <= nc < inner_w:
+                    blocked.add((nr, nc))
+    return blocked
