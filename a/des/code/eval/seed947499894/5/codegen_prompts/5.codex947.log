+        top = dst["r0"] + 1 + (inner_h - ph) // 2
+        left = dst["c0"] + 1 + (inner_w - pw) // 2
+        patch = out[top : top + ph, left : left + pw]
+        mask = payload != BLACK
+        patch[mask] = payload[mask]
