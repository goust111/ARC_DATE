+    "down": 3,   # clockwise 90
+    "left": 2,
+    "up": 1,     # counter-clockwise 90
+}
+
+ARROW_VARIANTS = {
+    "right": [
+        ((3, 2), {(0, 0), (1, 1), (2, 0)}),
+        ((2, 2), {(0, 0), (1, 1)}),
+    ],
+    "left": [
+        ((3, 2), {(0, 1), (1, 0), (2, 1)}),
+        ((2, 2), {(0, 1), (1, 0)}),
+    ],
+    "up": [
+        ((2, 3), {(1, 0), (0, 1), (1, 2)}),
+        ((2, 2), {(0, 1), (1, 0)}),
