+
+        rs = [r for r, _ in cells]
+        cs = [c for _, c in cells]
+        crop_h = max(rs) - min(rs) + 1
+        crop_w = max(cs) - min(cs) + 1
+        patch = np.full((crop_h, crop_w), BLACK, dtype=int)
+        color = int(rng.choice(PAYLOAD_COLORS))
+        for r, c in cells:
+            patch[r - min(rs), c - min(cs)] = color
