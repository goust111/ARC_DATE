+    ],
+    "left": [
+        ((3, 2), {(0, 1), (1, 0), (2, 1)}),
+        ((2, 2), {(0, 1), (1, 0)}),
+    ],
+    "up": [
+        ((2, 3), {(1, 0), (0, 1), (1, 2)}),
+        ((2, 2), {(0, 1), (1, 0)}),
+    ],
+    "down": [
+        ((2, 3), {(0, 0), (1, 1), (0, 2)}),
+        ((2, 2), {(0, 0), (1, 1)}),
