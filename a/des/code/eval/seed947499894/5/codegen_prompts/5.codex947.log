+def _classify_frames(grid: np.ndarray) -> tuple[list[dict], list[dict]]:
+    loaded: list[dict] = []
+    empty: list[dict] = []
+    for frame in _find_frames(grid):
+        interior = frame["interior"]
+        if np.all(interior == BLACK):
