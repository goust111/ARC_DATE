+    col_limit = inner_w - aw
+
+    def near_low(limit: int) -> int:
+        return int(rng.integers(0, min(2, limit) + 1))
+
+    def near_high(limit: int) -> int:
+        return int(limit - rng.integers(0, min(2, limit) + 1))
