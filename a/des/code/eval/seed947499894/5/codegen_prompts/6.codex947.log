+    rr0 = max(0, row - 1)
+    rr1 = min(grid.shape[0], row + h + 1)
+    cc0 = max(0, col - 1)
+    cc1 = min(grid.shape[1], col + w + 1)
+    return not bool(np.any(grid[rr0:rr1, cc0:cc1] != BG))
