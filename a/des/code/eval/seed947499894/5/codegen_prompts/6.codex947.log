+
+def _choose_counts(pedestal_count: int) -> list[int]:
+    max_layers = random.choice([1, 2, 3, 4])
+    counts = [random.randint(1, max_layers) for _ in range(pedestal_count)]
+    counts[random.randrange(pedestal_count)] = max_layers
+    return counts
