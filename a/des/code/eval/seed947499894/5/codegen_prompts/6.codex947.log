+def _sample_layout() -> tuple[int, int, int, int, int] | None:
+    H = random.randint(18, 25)
+    W = random.randint(22, 30)
+    pedestal_count = random.randint(2, 4)
+    gap = random.randint(1, 2)
+    max_base_w = (W - 2 - gap * (pedestal_count - 1)) // pedestal_count
+    if max_base_w < 4:
+        return None
