+def _paste(canvas: np.ndarray, sprite: np.ndarray, row: int, col: int, bg: int = BG) -> None:
+    h, w = sprite.shape
+    assert 0 <= row and 0 <= col and row + h <= canvas.shape[0] and col + w <= canvas.shape[1]
+    mask = sprite != bg
+    canvas[row : row + h, col : col + w][mask] = sprite[mask]
