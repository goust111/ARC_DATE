+def _can_place_scattered(grid: np.ndarray, sprite: np.ndarray, row: int, col: int) -> bool:
+    h, w = sprite.shape
+    if row < 0 or col < 0 or row + h > grid.shape[0] - 1 or col + w > grid.shape[1]:
+        return False
+    if row + h > grid.shape[0] - 2:
+        return False
