+    pedestals = _pedestals_from_bottom_row(g, bg=BG)
+    components = _find_components(g[:-1, :], bg=BG)
+    groups: dict[int, list[dict]] = {}
+    for comp in components:
+        groups.setdefault(int(comp["color"]), []).append(comp)
