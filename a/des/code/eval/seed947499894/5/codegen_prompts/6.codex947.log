+    left_margin = random.randint(1, W - total_span - 1)
+    pedestals: list[dict] = []
+    c = left_margin
+    for color in colors:
+        pedestals.append({"color": int(color), "c0": c, "c1": c + base_w - 1, "width": base_w})
+        c += base_w + gap
+    return pedestals
