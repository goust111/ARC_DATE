+
+def _build_pedestals(W: int, pedestal_count: int, base_w: int, gap: int, colors: list[int]) -> list[dict]:
+    total_span = pedestal_count * base_w + (pedestal_count - 1) * gap
+    left_margin = random.randint(1, W - total_span - 1)
