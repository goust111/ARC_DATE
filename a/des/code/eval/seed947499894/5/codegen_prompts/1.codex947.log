+        coords.add((r, c0))
+        coords.add((r, c1))
+    return coords
+
+
+def _extract_frame(comp: list[tuple[int, int]]) -> dict[str, object]:
+    coord_set = set(comp)
+    matches: list[dict[str, object]] = []
+    for bud in comp:
+        body = coord_set - {bud}
+        if not body:
