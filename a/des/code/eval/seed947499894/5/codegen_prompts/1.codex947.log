+        side = r1 - r0 + 1
+        if side < 5 or side != c1 - c0 + 1 or side % 2 == 0:
+            continue
+        center_r = r0 + side // 2
+        center_c = c0 + side // 2
+        direction = None
+        if bud == (r0 - 1, center_c):
+            direction = "up"
+        elif bud == (r1 + 1, center_c):
