+def _expected_output(inp: np.ndarray, specs: list[dict]) -> np.ndarray:
+    out = inp.copy()
+    for spec in specs:
+        kr0, kc0 = spec["key_pos"]
+        key = out[kr0 : kr0 + spec["key_h"], kc0 : kc0 + spec["key_w"]]
+        key[spec["key_mask"]] = BLACK
