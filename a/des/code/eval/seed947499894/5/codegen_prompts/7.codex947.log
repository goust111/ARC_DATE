+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _crop_component(coords: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = _bbox(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask, (r0, c0, r1, c1)
+
+
+def _variants(mask: np.ndarray) -> list[np.ndarray]:
+    out: list[np.ndarray] = []
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        for arr in (rot, np.fliplr(rot)):
+            key = ((int(arr.shape[0]), int(arr.shape[1])), arr.tobytes())
+            if key in seen:
+                continue
+            seen.add(key)
+            out.append(arr.copy())
+    return out
+
+
+def _shape_key(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    return min(
+        (((int(arr.shape[0]), int(arr.shape[1])), arr.tobytes()) for arr in _variants(mask)),
+        key=lambda item: (item[0][0], item[0][1], item[1]),
+    )
