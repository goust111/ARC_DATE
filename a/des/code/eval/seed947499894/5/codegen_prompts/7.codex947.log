+    used: set[int] = set()
+    for lock in locks:
+        shape = _shape_key(lock["hole_mask"])
+        candidates = by_shape.get(shape, [])
+        match_idx = next((idx for idx in candidates if idx not in used), None)
+        if match_idx is None:
