+
+BLACK = 0
+GREEN = 3
+ORANGE = 7
+MAROON = 9
+
+LOCK_FILL_COLORS = (1, 2, 4, 5, 6, 8)
+SIDES = ("top", "bottom", "left", "right")
+
+GEN_RETRIES = 400
