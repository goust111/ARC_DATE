+        inner = out[lr0 + 1 : lr0 + spec["lock_h"] - 1, lc0 + 1 : lc0 + spec["lock_w"] - 1]
+        cover = _tile_mask(spec["hole_mask"], inner.shape)
+        inner[(inner == spec["fill"]) & cover] = MAROON
+    return out
