+
+def _tile_mask(mask: np.ndarray, out_shape: tuple[int, int]) -> np.ndarray:
+    h, w = out_shape
+    rows = np.arange(h) % int(mask.shape[0])
+    cols = np.arange(w) % int(mask.shape[1])
+    return mask[rows[:, None], cols[None, :]]
