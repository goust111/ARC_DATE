+
+    for r, row in enumerate(assignments):
+        for c, color in enumerate(row):
+            if color is None:
+                continue
+            r0, r1 = row_spans[r]
+            c0, c1 = col_spans[c]
+            pattern = _sample_pattern(r1 - r0 + 1, c1 - c0 + 1)
+            ph = max(rr for rr, _ in pattern) + 1
+            pw = max(cc for _, cc in pattern) + 1
