+        start += cell_w + 1
+
+    grid[0, :] = GREY
+    grid[-1, :] = GREY
+    grid[:, 0] = GREY
+    grid[:, -1] = GREY
+    for _, r1 in row_spans[:-1]:
+        grid[r1 + 1, :] = GREY
+    for _, c1 in col_spans[:-1]:
