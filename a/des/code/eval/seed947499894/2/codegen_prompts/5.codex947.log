+def _generate_boundaries(piece_count: int, height: int, rng: random.Random) -> list[np.ndarray] | None:
+    base_widths = [rng.randint(3, 5) for _ in range(piece_count)]
+    internal: list[np.ndarray] = []
+    for _ in range(piece_count - 1):
