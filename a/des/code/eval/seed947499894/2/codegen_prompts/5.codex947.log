+    assert used.size > 0
+    labels = labels[:, int(used[0]) : int(used[-1]) + 1]
+    assert np.all(labels >= 0)
+    return labels
+
+
+def _render_output(labels: np.ndarray, colors: list[int]) -> np.ndarray:
+    out = np.full(labels.shape, GREY, dtype=int)
+    h, w = labels.shape
+    for r in range(h):
+        for c in range(w):
+            idx = int(labels[r, c])
+            if idx < 0 or idx >= len(colors) - 1:
+                continue
