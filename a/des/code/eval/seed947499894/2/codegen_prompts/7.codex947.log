+    mask = (patch != int(bg)) & (patch != int(wall_color))
+    pixels = [int(v) for v in patch[mask].tolist()]
+    counts = Counter(pixels)
+    primary = None if not counts else int(max(counts.items(), key=lambda item: (item[1], -item[0]))[0])
+    return {
