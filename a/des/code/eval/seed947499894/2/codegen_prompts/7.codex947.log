+def _read_liquid(grid: np.ndarray, bg: int, wall_color: int, container: dict[str, int]) -> dict[str, object]:
+    top = int(container["top"])
+    bottom = int(container["bottom"])
+    left = int(container["left"])
+    right = int(container["right"])
