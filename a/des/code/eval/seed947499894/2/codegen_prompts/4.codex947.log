+        if area == 1:
+            size = 1
+        else:
+            assert area == 4 and r1 - r0 == 1 and c1 - c0 == 1
+            expect = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
+            assert set(comp) == expect
+            size = 2
+        blocks.append(
+            {
+                "color": int(color),
+                "size": int(size),
+                "cells": tuple(sorted((int(r), int(c)) for r, c in comp)),
+            }
+        )
