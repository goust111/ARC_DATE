+                    if _row_sum(row_pref, r0, c0, c1) != width:
+                        continue
+                    if _row_sum(row_pref, r1, c0, c1) != width:
+                        continue
+                    if _col_sum(col_pref, c0, r0, r1) != height:
+                        continue
+                    if _col_sum(col_pref, c1, r0, r1) != height:
