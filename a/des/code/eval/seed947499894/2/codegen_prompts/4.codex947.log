+        preferred = [idx for idx in marker_slots if idx not in {cfg["anchor_idx"], (cfg["anchor_idx"] + 1) % len(cycle)}]
+        slots = preferred if len(preferred) >= cfg["k"] else marker_slots
+        if len(slots) < cfg["k"]:
