+    cycle = rect_info["cycle"]
+    length = len(cycle)
+    ar, ac = cycle[anchor_idx]
+    br, bc = cycle[(anchor_idx + 1) % length]
+    dr = br - ar
+    dc = bc - ac
+    out_r = -dc
+    out_c = dr
+    if size == 1:
+        cells = [(ar + out_r, ac + out_c)]
+    else:
