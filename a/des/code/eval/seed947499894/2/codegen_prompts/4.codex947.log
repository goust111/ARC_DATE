+    for r0 in range(h - 3):
+        for r1 in range(r0 + 3, h):
+            height = r1 - r0 + 1
+            if height < 4:
+                continue
+            for c0 in range(w - 3):
+                for c1 in range(c0 + 3, w):
+                    width = c1 - c0 + 1
+                    if width < 4:
