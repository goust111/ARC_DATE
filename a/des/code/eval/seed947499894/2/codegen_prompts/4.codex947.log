+    allowed = _touch_allowed_cells(rect_info, anchor_idx, size)
+    for r, c in cells:
+        for dr, dc in DIR4:
+            nr = r + dr
+            nc = c + dc
+            if (nr, nc) in rail_set and (nr, nc) not in allowed:
+                return None
