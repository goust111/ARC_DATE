+def _candidate_rectangles(grid: np.ndarray, track: int, marker: int) -> list[dict]:
+    rail_mask = (grid == int(track)) | (grid == int(marker))
+    h, w = grid.shape
+    row_pref, col_pref = _border_prefix(rail_mask)
