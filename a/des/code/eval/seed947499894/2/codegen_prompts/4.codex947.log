+
+def _valid_intersection(rect_a: tuple[int, int, int, int], rect_b: tuple[int, int, int, int]) -> bool:
+    shared = _rect_border_set(rect_a) & _rect_border_set(rect_b)
+    if not shared:
+        return True
+    if len(shared) != 1:
+        return False
+    point = next(iter(shared))
+    kind_a = _side_kind(rect_a, point)
+    kind_b = _side_kind(rect_b, point)
+    return {kind_a, kind_b} == {"H", "V"}
