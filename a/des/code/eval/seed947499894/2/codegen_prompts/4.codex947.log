+
+def _choose_block_config(
+    info: dict,
+    rect_id: int,
+    h: int,
+    w: int,
+    rail_set: set[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+    prefer_cross: bool | None,
+) -> dict | None:
