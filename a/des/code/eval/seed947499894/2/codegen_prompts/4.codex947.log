+
+def _infer_roles(grid: np.ndarray) -> tuple[int, int, int]:
+    counts = Counter(map(int, grid.flat))
+    bg = int(counts.most_common(1)[0][0])
+    non_bg = [c for c in counts if c != bg]
+    assert non_bg
+    track = int(max(non_bg, key=lambda c: (int(counts[c]), -int(c))))
