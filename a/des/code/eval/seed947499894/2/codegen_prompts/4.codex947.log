+            (ar + out_r, ac + out_c),
+            (ar + 2 * out_r, ac + 2 * out_c),
+            (ar + out_r + dr, ac + out_c + dc),
+            (ar + 2 * out_r + dr, ac + 2 * out_c + dc),
