+
+    candidates.sort(
+        key=lambda cand: (
+            cand["crosses"],
+            cand["size"] == 2,
+            -cand["k"],
+            -cand["anchor_idx"],
+        ),
+        reverse=True,
+    )
+    return random.choice(candidates[: min(8, len(candidates))])
