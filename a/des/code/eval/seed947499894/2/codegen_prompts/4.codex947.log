+                            "bbox": rect,
+                            "cycle": cycle,
+                            "index_of": {pt: idx for idx, pt in enumerate(cycle)},
+                        }
+                    )
+    return rects
+
+
+def _analyze_scene(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
