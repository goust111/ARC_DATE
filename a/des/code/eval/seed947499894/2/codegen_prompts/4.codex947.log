+    grid = _paint_scene(h, w, bg, track, marker, block_colors, rects)
+    if grid is None:
+        return None
+    counts = Counter(map(int, grid.flat))
+    if int(counts[bg]) <= max(int(counts[track]), int(counts[marker])):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
