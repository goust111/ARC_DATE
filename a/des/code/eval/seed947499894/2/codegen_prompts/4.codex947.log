+def _build_generator_rects(h: int, w: int) -> list[tuple[int, int, int, int]] | None:
+    base_h = random.randint(6, 9)
+    base_w = random.randint(6, 9)
+    if h < base_h + 8 or w < base_w + 8:
+        return None
+    r0 = random.randint(4, h - base_h - 4)
+    c0 = random.randint(4, w - base_w - 4)
+    rects = [(r0, c0, r0 + base_h - 1, c0 + base_w - 1)]
+
+    target_count = random.choice([2, 3])
+    while len(rects) < target_count:
+        placed = False
+        for _ in range(80):
+            parent = random.choice(rects)
+            pr0, pc0, pr1, pc1 = parent
+            if pr1 - pr0 < 4:
+                continue
+            cross_row = random.randint(pr0 + 2, pr1 - 2)
+            extend_down = random.choice([True, False])
+            if extend_down:
+                top = cross_row
+                low = pr1 + 2
+                high = min(h - 4, cross_row + 8)
