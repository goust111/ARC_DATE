+    r0, c0, r1, c1 = rect
+    r, c = point
+    horizontal = (r == r0 or r == r1) and c0 <= c <= c1
+    vertical = (c == c0 or c == c1) and r0 <= r <= r1
+    if horizontal and not vertical:
+        return "H"
+    if vertical and not horizontal:
+        return "V"
+    return "C"
