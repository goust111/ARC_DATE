+    table = {
+        (RIGHT, DOWN): ("\\", (1, 1)),
+        (DOWN, RIGHT): ("\\", (1, 1)),
+        (LEFT, UP): ("\\", (-1, -1)),
+        (UP, LEFT): ("\\", (-1, -1)),
+        (RIGHT, UP): ("/", (1, -1)),
+        (DOWN, LEFT): ("/", (1, -1)),
+        (LEFT, DOWN): ("/", (-1, 1)),
+        (UP, RIGHT): ("/", (-1, 1)),
