+    right_turn = {
+        (RIGHT, DOWN),
+        (DOWN, LEFT),
+        (LEFT, UP),
+        (UP, RIGHT),
+    }
+    left_turn = {
+        (RIGHT, UP),
+        (UP, LEFT),
+        (LEFT, DOWN),
+        (DOWN, RIGHT),
+    }
+    move = (incoming, outgoing)
+    if move in right_turn:
