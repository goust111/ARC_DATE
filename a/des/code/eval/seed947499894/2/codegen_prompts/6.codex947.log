+
+MIRROR_BASE = 5
+RECEIVER_COLOR = 8
+
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+DIRS = (UP, DOWN, LEFT, RIGHT)
+TURN_OPTIONS = {
+    UP: (LEFT, RIGHT),
+    DOWN: (LEFT, RIGHT),
+    LEFT: (UP, DOWN),
+    RIGHT: (UP, DOWN),
+}
+REFLECT = {
+    ("\\", RIGHT): DOWN,
+    ("\\", DOWN): RIGHT,
+    ("\\", LEFT): UP,
+    ("\\", UP): LEFT,
+    ("/", RIGHT): UP,
+    ("/", UP): RIGHT,
+    ("/", LEFT): DOWN,
+    ("/", DOWN): LEFT,
