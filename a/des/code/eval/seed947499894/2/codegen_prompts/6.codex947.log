+def _mirror_other(
+    hit: tuple[int, int], incoming: tuple[int, int], outgoing: tuple[int, int]
+) -> tuple[str, tuple[int, int]]:
+    right_turn = {
+        (RIGHT, DOWN),
+        (DOWN, LEFT),
+        (LEFT, UP),
+        (UP, RIGHT),
+    }
+    left_turn = {
+        (RIGHT, UP),
+        (UP, LEFT),
+        (LEFT, DOWN),
+        (DOWN, RIGHT),
+    }
+    move = (incoming, outgoing)
+    if move in right_turn:
+        if incoming in (RIGHT, DOWN):
