+def _cells_to_target(start: tuple[int, int], target: tuple[int, int]) -> list[tuple[int, int]]:
+    r0, c0 = start
+    r1, c1 = target
+    if r0 == r1:
+        step = 1 if c1 > c0 else -1
+        return [(int(r0), int(c)) for c in range(c0 + step, c1 + step, step)]
+    if c0 == c1:
