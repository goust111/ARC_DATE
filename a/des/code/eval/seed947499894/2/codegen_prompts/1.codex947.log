+
+    palette = [int(v) for v in rng.permutation(10)]
+    bg = palette[0]
+    border = palette[1]
+    key_colors = palette[2 : 2 + frame_count]
+    inner_colors = palette[2 + frame_count : 2 + 2 * frame_count]
+
+    specs: list[dict] = []
+    for i, spec in enumerate(shape_specs):
+        specs.append(
