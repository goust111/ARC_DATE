+        return None
+
+    if _bg_color(inp) != bg:
+        return None
+    if channel not in inp or noise not in inp:
+        return None
+    if np.array_equal(inp, expected):
+        return None
+    if not np.array_equal(main(inp), expected):
+        return None
+    return inp, expected
