+
+def _corridor_clear(
+    owner: np.ndarray,
+    reserved: np.ndarray,
+    cells: list[tuple[int, int]],
+    parent_bbox: tuple[int, int, int, int],
+    child_bbox: tuple[int, int, int, int],
+) -> bool:
+    h, w = owner.shape
+    for i, (r, c) in enumerate(cells):
+        if owner[r, c] >= 0 or reserved[r, c]:
+            return False
+        touches_parent = False
+        touches_child = False
