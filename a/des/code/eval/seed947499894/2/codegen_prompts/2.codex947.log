+from __future__ import annotations
+
+from collections import defaultdict
+import random
+
+import numpy as np
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(vals[counts.argmax()])
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.asarray(coords, dtype=int))
+    return out
+
+
+def _find_rectangles(grid: np.ndarray, bg: int) -> tuple[list[dict], np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    owner = np.full((h, w), -1, dtype=int)
+    rects: list[dict] = []
+
+    for color in map(int, np.unique(g)):
+        if color == bg:
+            continue
+        for coords in _components(g == color):
+            r0, c0 = coords.min(axis=0)
+            r1, c1 = coords.max(axis=0)
+            hh = int(r1 - r0 + 1)
+            ww = int(c1 - c0 + 1)
+            area = int(coords.shape[0])
+            if hh < 2 or ww < 2 or area != hh * ww:
+                continue
+            if not np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color):
+                continue
+            rid = len(rects)
+            owner[coords[:, 0], coords[:, 1]] = rid
+            rects.append(
+                {
+                    "id": rid,
+                    "color": color,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": area,
+                    "coords": coords,
+                }
+            )
+    return rects, owner
+
+
+def _intervals_1d(ids: np.ndarray) -> list[tuple[int, int, int]]:
+    out: list[tuple[int, int, int]] = []
+    i = 0
+    while i < len(ids):
+        rid = int(ids[i])
+        if rid < 0:
+            i += 1
+            continue
+        j = i
+        while j + 1 < len(ids) and int(ids[j + 1]) == rid:
+            j += 1
+        out.append((i, j, rid))
+        i = j + 1
+    return out
+
+
+def _longest_run(values: np.ndarray, color: int) -> int:
+    best = 0
+    cur = 0
+    for v in map(int, values):
+        if v == color:
+            cur += 1
+            if cur > best:
+                best = cur
+        else:
+            cur = 0
+    return best
+
+
+def _edges_for_channel(
+    grid: np.ndarray,
+    owner: np.ndarray,
+    bg: int,
+    aux_colors: list[int],
+    channel_color: int,
+) -> tuple[set[tuple[int, int]], int, int]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    allowed = np.asarray([bg] + aux_colors, dtype=int)
+    edges: set[tuple[int, int]] = set()
+    hits = 0
+    support = 0
+
+    for r in range(h):
+        intervals = _intervals_1d(owner[r])
+        for (_s1, e1, a), (s2, _e2, b) in zip(intervals, intervals[1:]):
+            corridor = g[r, e1 + 1 : s2]
+            if corridor.size == 0:
+                continue
+            if not np.all(np.isin(corridor, allowed)):
+                continue
+            run = _longest_run(corridor, channel_color)
+            if run < 2:
+                continue
+            edges.add((min(a, b), max(a, b)))
+            hits += 1
+            support += run
+
+    for c in range(w):
+        intervals = _intervals_1d(owner[:, c])
+        for (_s1, e1, a), (s2, _e2, b) in zip(intervals, intervals[1:]):
+            corridor = g[e1 + 1 : s2, c]
+            if corridor.size == 0:
+                continue
+            if not np.all(np.isin(corridor, allowed)):
+                continue
+            run = _longest_run(corridor, channel_color)
+            if run < 2:
+                continue
+            edges.add((min(a, b), max(a, b)))
+            hits += 1
+            support += run
+
+    return edges, hits, support
