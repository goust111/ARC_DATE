+BREAK_CHANNEL_PROB = 0.65
+BACKGROUND_NOISE_RANGE = (4, 14)
+FREE_PLACE_ATTEMPTS = 80
+ATTACH_PLACE_ATTEMPTS = 140
+GEN_ATTEMPTS = 500
