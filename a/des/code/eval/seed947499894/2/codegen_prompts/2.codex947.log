+def _in_bbox(r: int, c: int, bbox: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = bbox
+    return r0 <= r <= r1 and c0 <= c <= c1
+
+
+def _bbox_free(
+    owner: np.ndarray,
+    reserved: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    margin: int = 1,
+) -> bool:
+    h, w = owner.shape
+    r0, c0, r1, c1 = bbox
+    rr0 = max(0, r0 - margin)
+    cc0 = max(0, c0 - margin)
+    rr1 = min(h - 1, r1 + margin)
+    cc1 = min(w - 1, c1 + margin)
+    return not np.any(owner[rr0 : rr1 + 1, cc0 : cc1 + 1] >= 0) and not np.any(
+        reserved[rr0 : rr1 + 1, cc0 : cc1 + 1]
+    )
+
+
+def _corridor_clear(
+    owner: np.ndarray,
+    reserved: np.ndarray,
+    cells: list[tuple[int, int]],
+    parent_bbox: tuple[int, int, int, int],
+    child_bbox: tuple[int, int, int, int],
+) -> bool:
+    h, w = owner.shape
+    for i, (r, c) in enumerate(cells):
+        if owner[r, c] >= 0 or reserved[r, c]:
+            return False
+        touches_parent = False
+        touches_child = False
+        for nr, nc in _neighbors4(r, c, h, w):
+            if reserved[nr, nc]:
+                return False
+            if _in_bbox(nr, nc, parent_bbox):
+                if i != 0:
+                    return False
+                touches_parent = True
+                continue
+            if _in_bbox(nr, nc, child_bbox):
+                if i != len(cells) - 1:
+                    return False
+                touches_child = True
+                continue
+            if owner[nr, nc] >= 0:
+                return False
+        if i == 0 and not touches_parent:
+            return False
+        if i == len(cells) - 1 and not touches_child:
+            return False
+    return True
+
