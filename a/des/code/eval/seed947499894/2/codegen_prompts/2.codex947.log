+    for _ in range(count * 50):
+        r = random.randrange(h)
+        c = random.randrange(w)
+        if int(grid[r, c]) != bg:
+            continue
+        ok = True
+        for rr in range(max(0, r - 1), min(h, r + 2)):
+            for cc in range(max(0, c - 1), min(w, c + 2)):
+                if int(grid[rr, cc]) == noise:
+                    ok = False
+                    break
+            if not ok:
