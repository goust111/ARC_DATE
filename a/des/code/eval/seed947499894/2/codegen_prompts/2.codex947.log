+                {
+                    "id": rid,
+                    "group": gid,
+                    "color": rect_colors[color_i],
+                    "bbox": child_bbox,
+                    "area": (child_bbox[2] - child_bbox[0] + 1) * (child_bbox[3] - child_bbox[1] + 1),
+                }
+            )
+            color_i += 1
+            ids.append(rid)
+            for r, c in cells:
+                reserved[r, c] = True
+            connections.append({"a": parent_id, "b": rid, "cells": cells})
+
+        group_rect_ids.append(ids)
