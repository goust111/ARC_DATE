+            inp[r, c] = channel
+
+    for conn in connections:
+        cells = conn["cells"]
+        n = len(cells)
+        if n < 4 or random.random() >= BREAK_CHANNEL_PROB:
+            continue
+        options = [i for i in range(1, n - 1) if max(i, n - i - 1) >= 2]
+        if not options:
+            continue
+        idx = random.choice(options)
