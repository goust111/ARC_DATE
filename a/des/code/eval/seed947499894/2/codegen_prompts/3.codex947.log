+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+OPS = ("identity", "hflip", "vflip", "rot180")
+OP_SHAPES = {
+    "identity": [(0, 0)],
+    "hflip": [(0, 0), (0, 1)],
+    "vflip": [(0, 0), (1, 0)],
+    "rot180": [(0, 0), (0, 1), (1, 0), (1, 1)],
+    "seed": [(0, 0), (0, 1), (1, 0), (1, 1)],
+}
+GEN_RETRIES = 400
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _bands(lines: list[int]) -> list[tuple[int, int]]:
+    return [(int(a + 1), int(b)) for a, b in zip(lines, lines[1:]) if b - a > 1]
+
+
+def _payload_mask(cell: np.ndarray, bg: int, sep: int) -> np.ndarray:
