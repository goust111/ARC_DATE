+
+
+def _single_payload_color(cell: np.ndarray, bg: int, sep: int) -> int:
+    mask = _payload_mask(cell, bg, sep)
+    colors = np.unique(cell[mask])
+    assert colors.size == 1
+    return int(colors[0])
+
+
+def _decode_op(cell: np.ndarray, bg: int, sep: int) -> str:
