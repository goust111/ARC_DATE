+
+    col = int(RNG.choice(cols))
+    if direction == "down":
+        start = -(length + gap + 1)
+        line = [(start + i, col) for i in range(length)]
+        head = (start + length, col + diag)
+    else:
+        start = mask.shape[0] + gap + 1
+        line = [(start + i, col) for i in range(length)]
+        head = (start - 1, col + diag)
