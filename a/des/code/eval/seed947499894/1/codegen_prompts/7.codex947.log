+    np.array([[1, 1, 1], [0, 1, 0]], dtype=np.uint8),
+    np.array([[1, 1, 0], [0, 1, 1]], dtype=np.uint8),
+    np.array([[1, 1, 1], [1, 1, 0]], dtype=np.uint8),
