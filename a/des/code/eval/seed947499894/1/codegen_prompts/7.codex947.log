+        rel_c0 = min(in_c0, 0)
+        rel_r1 = max(in_r1, out_r1)
+        rel_c1 = max(in_c1, out_c1)
+
+        return {
+            "color": color,
+            "length": length,
+            "mask": mask,
+            "sprite_cells": sprite_cells,
+            "arrow_cells": arrow,
+            "out_mask": out_mask,
