+        out_c1 = out_mask.shape[1] - 1
+        rel_r0 = min(in_r0, 0)
+        rel_c0 = min(in_c0, 0)
+        rel_r1 = max(in_r1, out_r1)
+        rel_c1 = max(in_c1, out_c1)
