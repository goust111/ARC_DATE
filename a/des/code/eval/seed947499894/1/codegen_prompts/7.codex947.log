+    if direction in ("left", "right"):
+        row = int(RNG.choice(rows))
+        if direction == "right":
+            start = -(length + gap + 1)
+            line = [(row, start + i) for i in range(length)]
+            head = (row + diag, start + length)
+        else:
+            start = mask.shape[1] + gap + 1
+            line = [(row, start + i) for i in range(length)]
+            head = (row + diag, start - 1)
