+
+def _build_arrow(mask: np.ndarray, direction: str, length: int, gap: int, diag: int) -> list[tuple[int, int]]:
+    coords = np.argwhere(mask > 0)
+    rows = sorted({int(r) for r, _c in coords})
+    cols = sorted({int(c) for _r, c in coords})
