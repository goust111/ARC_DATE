+        return {
+            "color": color,
+            "length": length,
+            "mask": mask,
+            "sprite_cells": sprite_cells,
+            "arrow_cells": arrow,
+            "out_mask": out_mask,
+            "reserve_bbox": (rel_r0, rel_c0, rel_r1, rel_c1),
+        }
