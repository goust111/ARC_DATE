+def _spec_pairs(n: int) -> list[tuple[int, int]]:
+    base = list(zip(RNG.permutation(ARROW_COLORS), RNG.permutation([1, 2, 3])))
+    extra = [(int(RNG.choice(ARROW_COLORS)), int(RNG.integers(1, 4))) for _ in range(n - 3)]
+    pairs = base + extra
+    RNG.shuffle(pairs)
+    return pairs
