+    for spec in placed_specs:
+        ar, ac = spec["anchor"]
+        for dr, dc in spec["sprite_cells"]:
+            rr = ar + dr
+            cc = ac + dc
+            if inp[rr, cc] != BG:
+                return None
+            inp[rr, cc] = SPRITE_COLOR
