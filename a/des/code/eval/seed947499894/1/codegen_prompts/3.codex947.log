    target_r = mr0 - shift_up + _MARKER_TARGET_REL[0]
    target_c = mc0 + _MARKER_TARGET_REL[1]
    paste_r = target_r - sprite_patch.shape[0] + 1
    paste_c = target_c - sprite_patch.shape[1] + 1
