+    candidates: list[tuple[int, str, int]] = []
+    for color in colors:
+        coords = np.argwhere(window == color)
+        area = int(len(coords))
+        if not (1 <= area <= 5):
+            continue
+        contacts = _edge_contacts(coords, h, w)
+        if len(contacts) != 1:
+            continue
+        if len(_components(window == color)) != 1:
