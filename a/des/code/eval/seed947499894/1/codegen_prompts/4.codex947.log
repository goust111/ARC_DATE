+def _footprint_bounds(top: int, left: int, spec: dict[str, object]) -> tuple[int, int, int, int]:
+    h = int(spec["height"])
+    w = int(spec["width"])
+    side = str(spec["side"])
+    thickness = int(spec["thickness"])
