+GRID_MIN = 18
+GRID_MAX = 30
+OBJECT_COUNT_MIN = 2
+OBJECT_COUNT_MAX = 4
+RECT_SIDE_MIN = 3
+RECT_SIDE_MAX = 9
+BLOB_SIZE_MIN = 1
+BLOB_SIZE_MAX = 5
+SPEC_ATTEMPTS = 200
+SHAPE_ATTEMPTS = 200
+PLACEMENT_ATTEMPTS = 300
+GENERATION_ATTEMPTS = 400
