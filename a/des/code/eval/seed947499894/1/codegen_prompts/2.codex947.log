+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in cells:
+            mask[r, c] = True
+        mask = _trim(mask)
+        area = int(mask.sum())
+        mh, mw = mask.shape
+        if area < 4 or area > 8 or mh < 2 or mw < 3:
+            continue
+        if area == mh * mw:
+            continue
+        if len(_rot_sigs(mask)) < 4:
+            continue
+        if any(_same_mask(np.rot90(mask, k), np.fliplr(mask)) for k in range(4)):
+            continue
