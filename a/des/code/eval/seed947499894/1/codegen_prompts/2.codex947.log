+        assignment = _solve_assignment(pieces, holes)
+        if len(set(assignment)) != len(holes):
+            return False
+        out = main(g)
+        if out.shape != g.shape:
+            return False
+        if np.any((out != BG) & (out != TEMPLATE) & (out == MARKER)):
+            return False
+        return True
+    except Exception:
+        return False
