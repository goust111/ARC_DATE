+import numpy as np
+
+
+BG = 0
+MARKER = 2
+TEMPLATE = 7
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRIES = 300
+RNG = np.random.default_rng()
