+    blocked = [(tpl_r0, tpl_c0, tpl_r1, tpl_c1)]
+    for piece, zone_name in zip(pieces, zone_names):
+        patch = _build_piece_patch(rng, piece["mask"], piece["color"], piece["marker_count"])
