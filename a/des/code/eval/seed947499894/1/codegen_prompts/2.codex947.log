+        for local_mask, (rr, cc) in ((hole_a, row_info["a_pos"]), (hole_b, row_info["b_pos"])):
+            top = tpl_r0 + current_row + rr
+            left = tpl_c0 + x_offset + cc
+            _stamp_mask(grid, local_mask, top, left, BG)
