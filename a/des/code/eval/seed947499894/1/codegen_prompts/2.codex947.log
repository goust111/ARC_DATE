+def _make_pair_layout(hole_a: np.ndarray, hole_b: np.ndarray, gap: int):
+    ha, wa = hole_a.shape
+    hb, wb = hole_b.shape
+    row_h = max(ha, hb)
+    row_w = wa + gap + wb
+    return {
+        "row_h": row_h,
+        "row_w": row_w,
+        "a_pos": ((row_h - ha) // 2, 0),
+        "b_pos": ((row_h - hb) // 2, wa + gap),
+    }
+
+
+def _stamp_mask(canvas: np.ndarray, mask: np.ndarray, top: int, left: int, value: int) -> None:
