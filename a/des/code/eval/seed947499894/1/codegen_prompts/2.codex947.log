+def _place_piece_in_zone(
+    rng: np.random.Generator,
+    grid: np.ndarray,
+    patch: np.ndarray,
+    zone: tuple[int, int, int, int],
+    blocked: list[tuple[int, int, int, int]],
+) -> bool:
+    h, w = patch.shape
+    r0, c0, r1, c1 = zone
+    if r1 - r0 + 1 < h or c1 - c0 + 1 < w:
+        return False
+    rows = list(range(r0, r1 - h + 2))
+    cols = list(range(c0, c1 - w + 2))
+    rng.shuffle(rows)
+    rng.shuffle(cols)
+    for top in rows:
+        for left in cols:
