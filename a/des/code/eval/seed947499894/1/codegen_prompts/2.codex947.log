+        "bottom": (tpl_r1 + 2, 0, grid_h - 1, grid_w - 1),
+        "left": (0, 0, grid_h - 1, tpl_c0 - 2),
+        "right": (0, tpl_c1 + 2, grid_h - 1, grid_w - 1),
