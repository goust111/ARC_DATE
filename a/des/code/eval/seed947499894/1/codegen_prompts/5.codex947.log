+def _strip_exit_t(a: int, b: int, index: int) -> float | None:
+    delta = float(b - a)
+    if abs(delta) < 1e-9:
+        return None
+
+    lo = (index - 0.5 - a) / delta
+    hi = (index + 0.5 - a) / delta
+    enter = max(0.0, min(lo, hi))
+    leave = min(1.0, max(lo, hi))
+    eps = 1e-9
+    if leave < enter - eps:
+        return None
+    if leave <= eps or enter >= 1.0 - eps:
+        return None
