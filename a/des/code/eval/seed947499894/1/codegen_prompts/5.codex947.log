+    margin_after: int,
+) -> tuple[list[tuple[int, int]], list[int], int]:
+    segments: list[tuple[int, int]] = []
+    bands: list[int] = []
+    cur = margin_before
+    for i, size in enumerate(sizes):
+        segments.append((cur, cur + size - 1))
+        cur += size
+        if i < len(sizes) - 1:
