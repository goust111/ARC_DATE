+            seed_values = np.unique(patch[(patch != wall) & (patch != bg)])
+            assert len(seed_values) == 1, "each room must contain exactly one seed color"
+            rooms[(rr, cc)] = {
+                "bounds": (r0, r1, c0, c1),
+                "seed": int(seed_values[0]),
+            }
