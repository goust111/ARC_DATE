+import random
+from collections import Counter, defaultdict
+
+import numpy as np
+
+
+BG_COLOR = 0
+WALL_COLOR = 5
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_ATTEMPTS = 300
