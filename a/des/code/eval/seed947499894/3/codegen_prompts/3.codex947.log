+def _global_inside_mask(shape: tuple[int, int], coords: np.ndarray) -> np.ndarray:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    r0 = int(rows.min())
+    r1 = int(rows.max())
+    c0 = int(cols.min())
+    c1 = int(cols.max())
