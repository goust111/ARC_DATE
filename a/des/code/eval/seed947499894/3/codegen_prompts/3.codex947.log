+
+def _legend_mask_and_colors(grid: np.ndarray, bg: int) -> tuple[np.ndarray, list[int]]:
+    h, w = grid.shape
+    candidates: list[tuple[np.ndarray, list[int]]] = []
+    specs = [
+        (range(0, h), 0),
+        (range(h - 1, -1, -1), 0),
+        (range(0, h), w - 1),
+        (range(h - 1, -1, -1), w - 1),
+    ]
+
+    for row_iter, col in specs:
+        rows = list(row_iter)
+        if int(grid[rows[0], col]) == bg:
+            continue
+
+        seg = []
+        for r in rows:
+            if int(grid[r, col]) == bg:
