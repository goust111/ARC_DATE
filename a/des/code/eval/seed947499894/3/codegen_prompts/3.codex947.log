+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for nr, nc in _neighbors4(h, w, cr, cc):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _erode4(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    eroded = np.zeros_like(mask, dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            keep = True
+            for nr, nc in _neighbors4(h, w, r, c):
+                if not mask[nr, nc]:
+                    keep = False
+                    break
+            if keep and r not in (0, h - 1) and c not in (0, w - 1):
+                eroded[r, c] = True
+    return eroded
+
+
+def _boundary_from_filled(filled: np.ndarray) -> np.ndarray:
+    return filled & (~_erode4(filled))
+
+
+def _interior_from_boundary(boundary: np.ndarray) -> np.ndarray:
+    h, w = boundary.shape
+    outside = np.zeros((h, w), dtype=bool)
+    q = deque()
+
+    def maybe_push(r: int, c: int) -> None:
+        if not boundary[r, c] and not outside[r, c]:
+            outside[r, c] = True
+            q.append((r, c))
+
+    for r in range(h):
+        maybe_push(r, 0)
+        maybe_push(r, w - 1)
+    for c in range(w):
+        maybe_push(0, c)
+        maybe_push(h - 1, c)
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(h, w, r, c):
+            if not boundary[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+
+    return (~outside) & (~boundary)
