+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+# --------------- shared helpers ---------------
+
+BG_COLOR = 0
+GRID_H_RANGE = (18, 38)
+GRID_W_RANGE = (18, 38)
+DEPTH_OPTIONS = (2, 3, 4)
+DEPTH_WEIGHTS = (4, 4, 2)
+GROUP_COUNT_OPTIONS = (1, 2, 3)
+GROUP_COUNT_WEIGHTS = (3, 3, 2)
+COLOR_POOL = tuple(range(1, 10))
