+    eroded = np.zeros_like(mask, dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            keep = True
+            for nr, nc in _neighbors4(h, w, r, c):
+                if not mask[nr, nc]:
