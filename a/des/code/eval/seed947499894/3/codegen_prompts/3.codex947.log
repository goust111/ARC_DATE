import numpy as np

def rect(depth, ih, iw):
    h=ih+4*(depth-1); w=iw+4*(depth-1)
    g=np.zeros((h,w),int)
    for k in range(depth):
        t=2*k; b=h-1-2*k; l=2*k; r=w-1-2*k
        g[t,l:r+1]=1; g[b,l:r+1]=1; g[t:b+1,l]=1; g[t:b+1,r]=1
    print('depth',depth,'shape',g.shape)
    print('\\n'.join(''.join('#' if x else '.' for x in row) for row in g))
    print()
