import numpy as np
from collections import deque

def comps4(mask):
    h,w=mask.shape
    seen=np.zeros((h,w),bool)
    out=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            q=deque([(r,c)])
            seen[r,c]=True
            cells=[]
            while q:
                cr,cc=q.popleft(); cells.append((cr,cc))
                for nr,nc in [(cr-1,cc),(cr+1,cc),(cr,cc-1),(cr,cc+1)]:
                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc]=True; q.append((nr,nc))
            out.append(cells)
    return out

def erode4(mask):
    h,w=mask.shape; out=np.zeros_like(mask)
    for r in range(h):
      for c in range(w):
        if mask[r,c] and r not in (0,h-1) and c not in (0,w-1) and mask[r-1,c] and mask[r+1,c] and mask[r,c-1] and mask[r,c+1]:
          out[r,c]=1
    return out

def boundary(base,s):
    sh=np.kron(base,np.ones((s,s),dtype=int))
    bd=sh-erode4(sh)
    return bd.astype(bool)

cands={
'oct1':np.array([
[0,0,1,1,1,0,0],
