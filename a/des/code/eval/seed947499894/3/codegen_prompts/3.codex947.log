+            seg.append(r)
+        if len(seg) < 2:
+            continue
+
+        top = min(seg)
+        bottom = max(seg)
+        inward_col = 1 if col == 0 else w - 2
+        ok = True
+
+        for r in range(h):
+            if r < top or r > bottom:
+                if int(grid[r, col]) != bg:
+                    ok = False
+                    break
+        if not ok:
+            continue
+
+        for rr in range(max(0, top - 1), min(h, bottom + 2)):
+            if int(grid[rr, inward_col]) != bg:
+                ok = False
+                break
+        if not ok:
+            continue
+
+        mask = np.zeros((h, w), dtype=bool)
+        for r in seg:
+            mask[r, col] = True
