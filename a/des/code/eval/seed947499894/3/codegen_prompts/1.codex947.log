+def _draw_frame(
+    grid: np.ndarray,
+    top: int,
+    left: int,
+    height: int,
+    width: int,
+    border_color: int,
+    inner_color: int,
+    orientation: tuple[int, int],
+) -> None:
+    bottom = top + height - 1
+    right = left + width - 1
+    grid[top : bottom + 1, left] = border_color
+    grid[top : bottom + 1, right] = border_color
+    grid[top, left : right + 1] = border_color
+    grid[bottom, left : right + 1] = border_color
