    bg = get_bg(g)
    H, W = g.shape

    def bbox_gap(a, b) -> int:
        (ar0, ac0, ar1, ac1) = a
        (br0, bc0, br1, bc1) = b
        def gap1(x0, x1, y0, y1):
            if y1 < x0:
                return int(x0 - y1)
            if x1 < y0:
                return int(y0 - x1)
            return 0
        return gap1(ar0, ar1, br0, br1) + gap1(ac0, ac1, bc0, bc1)

    fg = g != int(bg)
    lab, n = label(fg, structure=STRUCT4)
