+    return None
+
+
+def _build_vertical_pair(rng: random.Random, color: int) -> dict | None:
+    rect_h = rng.randint(max(5, RECT_H_RANGE[0]), RECT_H_RANGE[1] - 1)
+    rect_w = rng.randint(RECT_W_RANGE[0], RECT_W_RANGE[1] - 1)
