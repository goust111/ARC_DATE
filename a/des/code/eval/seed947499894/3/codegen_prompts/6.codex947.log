+        assert 0 <= anchor_r <= h - rect_h and 0 <= anchor_c <= w - rect_w
+        assert not bool((out[anchor_r : anchor_r + rect_h, anchor_c : anchor_c + rect_w] != BG).any())
+        out[anchor_r : anchor_r + rect_h, anchor_c : anchor_c + rect_w] = color
+
+    return out
