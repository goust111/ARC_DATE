+        top_h = int(max(heights))
+        bottom_h = int(max(rect_h - val for val in heights))
+        top = np.zeros((top_h, rect_w), dtype=bool)
+        bottom = np.zeros((bottom_h, rect_w), dtype=bool)
+        for c, height in enumerate(heights):
