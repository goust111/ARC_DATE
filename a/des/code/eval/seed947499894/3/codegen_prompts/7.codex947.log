+def _segment_start_mask(seq: np.ndarray) -> np.ndarray:
+    starts = np.zeros(len(seq), dtype=bool)
+    if len(seq):
+        starts[0] = True
+        starts[1:] = seq[1:] != seq[:-1]
+    return starts
+
