  50: def main(grid: np.ndarray) -> np.ndarray:
  51:     """
  52:     Slide each inner colored object horizontally into the same-colored vertical wall until it touches an obstacle.
  53: 
  54:     Input structure
  55:     - The background is the dominant color.
  56:     - The only foreground colors are two non-background colors.
  57:     - One foreground color fills the left column and the other fills the right column.
  58:     - Extra 8-connected objects of each wall color appear away from that color's wall.
  59: 
  60:     Rule
  61:     - Clear the extra objects from their original positions.
  62:     - For each wall color, process its 8-connected extra objects from nearest to farthest from the matching wall.
  63:     - Slide each object horizontally toward its matching wall as far as possible without overlapping the wall or an already settled object of the same color.
  64:     - Keep the two vertical wall columns fixed.
  65: 
  66:     Key insight
  67:     - The side columns act like color-specific gravity walls: same-colored objects compact sideways against their own wall while preserving each object's shape.
  68:     """
  69:     g = np.asarray(grid, dtype=int)
  70:     assert g.ndim == 2 and min(g.shape) >= 2, "expected a non-empty 2D grid with two side columns"
  71: 
  72:     bg = get_bg(g)
  73:     w = g.shape[1]
  74:     left_color = int(g[0, 0])
  75:     right_color = int(g[0, w - 1])
  76: 
  77:     assert left_color != right_color, "left and right walls must have different colors"
  78:     assert bg not in {left_color, right_color}, "walls must be foreground colors"
  79:     assert np.all(g[:, 0] == left_color), "left wall must fill the full left column"
  80:     assert np.all(g[:, w - 1] == right_color), "right wall must fill the full right column"
  81:     assert set(map(int, np.unique(g))) == {int(bg), left_color, right_color}, "expected exactly background plus two wall colors"
  82: 
  83:     out = np.full_like(g, int(bg))
  84:     out[:, 0] = left_color
  85:     out[:, w - 1] = right_color
  86: 
  87:     placements: list[tuple[int, np.ndarray]] = []
  88:     for color, side_col, direction in ((left_color, 0, -1), (right_color, w - 1, 1)):
  89:         for coords in _settled_components(g, color, side_col, direction):
  90:             placements.append((color, coords))
  91: 
  92:     occupied = (out != bg)
  93:     for color, coords in placements:
  94:         assert not np.any(occupied[coords[:, 0], coords[:, 1]]), "different colors must not settle on the same pixel"
  95:         out[coords[:, 0], coords[:, 1]] = color
  96:         occupied[coords[:, 0], coords[:, 1]] = True
  97: 
  98:     assert int(np.sum(out == left_color)) == int(np.sum(g == left_color)), "left color count must be preserved"
  99:     assert int(np.sum(out == right_color)) == int(np.sum(g == right_color)), "right color count must be preserved"
 100:     return out
