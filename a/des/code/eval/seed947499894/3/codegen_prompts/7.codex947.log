DIRS=[(0,1),(1,0),(0,-1),(-1,0)]

def spiral(h,w):
    occupied=set()
    path=[]
    r=c=0
    d=0
    def ok(rr,cc, prev):
        if not (0<=rr<h and 0<=cc<w):
            return False
        if (rr,cc) in occupied:
            return False
        neigh=0
        for dr,dc in DIRS:
            nr,nc=rr+dr,cc+dc
            if (nr,nc) in occupied:
                if (nr,nc)"'!=prev:
                    neigh+=1
        return neigh==0
    while True:
        occupied.add((r,c))
        path.append((r,c))
        dr,dc=DIRS[d]
        nr,nc=r+dr,c+dc
        if ok(nr,nc,(r,c)):
            r,c=nr,nc
            continue
        nd=(d+1)%4
        dr,dc=DIRS[nd]
        nr,nc=r+dr,c+dc
        if ok(nr,nc,(r,c)):
            d=nd
            r,c=nr,nc
            continue
        break
    return path

for h in range(5,18):
  for w in range(5,18):
    path=spiral(h,w)
    cs=set(path)
    bad=False; ends=0
    for r,c in path:
      deg=sum(((r+dr,c+dc) in cs) for dr,dc in DIRS)
      if deg==1: ends+=1
      if deg>2: bad=True
    if bad or ends!=2:
      print('"'bad',h,w,len(path),ends,bad)
      raise SystemExit
print('all good')
for hw in [(9,9),(10,9),(11,13)]:
  h,w=hw
  print(hw, len(spiral(h,w)))
