   9: def main(grid: np.ndarray) -> np.ndarray:
  10:     """
  11:     Simulate tokens falling through a pipe network after gates rotate open.
  12: 
  13:     Input structure:
  14:     - Wall (0), bg (pipe fill), gate (horizontal 1×3 bars), token (small edge pixels).
  15: 
  16:     Rule:
  17:     - Rotate each gate into a vertical blocker; gate cells become bg.
  18:     - Tokens drop downward through bg, choosing the extreme column for their side (left→min, right→max).
  19:     - Tokens settle at true pipe ends (adjacent to wall/boundary), packing inward.
  20: 
  21:     Key insight: Tokens select drop columns by entry side and land at wall-bounded endpoints, ignoring blocker-bounded ones.
  22:     """
  23:     g = np.array(grid, dtype=int)
  24:     H, W = g.shape
  25:     colors = set(map(int, g.flatten()))
  26: 
  27:     # --- infer gate color: any color forming 4-ccs of size 3 with bbox 1x3 (horizontal) ---
  28:     gate = None
  29:     for col in sorted(colors):
  30:         if int(col) == 0:
  31:             continue
  32:         lab, n = label_mask(g == int(col), connectivity=4)
  33:         found = False
  34:         for k in range(1, int(n) + 1):
  35:             pts = np.argwhere(lab == int(k))
  36:             if int(pts.shape[0]) != 3:
  37:                 continue
  38:             r0, c0 = pts.min(axis=0)
  39:             r1, c1 = pts.max(axis=0)
  40:             if int(r1 - r0 + 1) == 1 and int(c1 - c0 + 1) == 3:
  41:                 found = True
  42:                 break
  43:         if found:
  44:             gate = int(col)
  45:             break
  46:     assert not (gate is None)
  47: 
  48:     # --- token/bg inference ---
  49:     cnt_all = Counter(map(int, g.flatten()))
  50:     cand_token = [c for c in colors if int(c) not in (0, int(gate))]
  51:     assert not (not cand_token)
  52:     token = int(min(cand_token, key=lambda c: (int(cnt_all[int(c)]), int(c))))
  53:     cand_bg = [c for c in colors if int(c) not in (0, int(gate), int(token))]
  54:     assert cand_bg
  55:     bg = int(max(cand_bg, key=lambda c: (int(cnt_all[int(c)]), -int(c))))
  56: 
  57:     # --- opened gate color (vertical post) ---
  58:     open_col = 6 if int(gate) == 7 and 6 not in colors else int(gate - 1) if int(gate) > 0 else 6
  59: 
  60:     # --- rotate gates (gates open into bg, center becomes vertical open_col) ---
  61:     out = g.copy()
  62:     lab, n = label_mask(out == int(gate), connectivity=4)
  63:     for k in range(1, int(n) + 1):
  64:         pts = np.argwhere(lab == int(k))
  65:         if int(pts.shape[0]) != 3:
  66:             continue
  67:         r0, c0 = pts.min(axis=0)
  68:         r1, c1 = pts.max(axis=0)
  69:         if int(r1 - r0 + 1) != 1 or int(c1 - c0 + 1) != 3:
  70:             continue
  71:         r = int(r0)
  72:         c0 = int(c0)
  73:         center_c = int(c0 + 1)
  74:         out[int(r), int(c0) : int(c0) + 3] = int(bg)
  75:         for rr in (int(r - 1), int(r), int(r + 1)):
  76:             if 0 <= int(rr) < H:
  77:                 out[int(rr), int(center_c)] = int(open_col)
  78: 
  79:     # helpers
  80:     def segments_in_row(r: int) -> list[tuple[int, int]]:
  81:         segs: list[tuple[int, int]] = []
