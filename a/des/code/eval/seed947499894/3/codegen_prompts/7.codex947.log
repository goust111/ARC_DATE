+    seq: list[int] = []
+    idx = 0
+    while len(seq) < length:
+        run_len = seg_lengths[idx % 3]
+        seq.extend([int(colors[idx % 3])] * run_len)
+        idx += 1
+    return np.array(seq[:length], dtype=int)
