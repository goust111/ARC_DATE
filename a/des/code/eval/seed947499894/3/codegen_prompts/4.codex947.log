-- main lines 18-78
0018: def main(grid: np.ndarray) -> np.ndarray:
0019:     """Erase the first border pixel hit by extending the red marker away from its pink trail.
0020: 
0021:     Input structure
0022:     - The dominant background surrounds a unique red marker and a four-pixel
0023:       pink trail.
0024:     - The pink pixels form one straight 8-connected ray starting next to the
0025:       red marker.
0026:     - In the opposite direction from that trail, the red marker faces a
0027:       non-background border or obstacle pixel beyond background cells.
0028: 
0029:     Rule
0030:     - Keep the whole grid fixed except for the first non-background pixel on
0031:       the ray from the red marker away from the pink trail.
0032:     - Recolor that one hit pixel to the background color.
0033: 
0034:     Key insight
0035:     - The pink trail marks where the red marker came from, so the edit is found
0036:       by ray-casting from the red marker in the opposite direction.
0037:     """
0038:     g = np.asarray(grid, dtype=int)
0039:     assert g.ndim == 2
0040:     H, W = g.shape
0041:     bg = get_bg(g)
0042: 
0043:     red_coords = np.argwhere(g == Color.RED)
0044:     assert len(red_coords) == 1
0045:     red_r, red_c = map(int, red_coords[0])
0046: 
0047:     pink_coords = [tuple(map(int, p)) for p in np.argwhere(g == Color.PINK)]
0048:     assert len(pink_coords) == 4
0049:     pink_set = set(pink_coords)
0050: 
0051:     trail_dirs: list[tuple[int, int]] = []
0052:     for dr, dc in DIRS8:
0053:         expected = {
0054:             (red_r + step * dr, red_c + step * dc)
0055:             for step in range(1, len(pink_coords) + 1)
0056:         }
0057:         if expected == pink_set:
0058:             trail_dirs.append((dr, dc))
0059:     assert len(trail_dirs) == 1
0060: 
0061:     trail_dr, trail_dc = trail_dirs[0]
0062:     ray_dr, ray_dc = -trail_dr, -trail_dc
0063: 
0064:     hits: list[tuple[int, int]] = []
0065:     r, c = red_r + ray_dr, red_c + ray_dc
0066:     while 0 <= r < H and 0 <= c < W:
0067:         if g[r, c] != bg:
0068:             assert g[r, c] not in (Color.RED, Color.PINK)
0069:             hits.append((r, c))
0070:             break
0071:         r += ray_dr
0072:         c += ray_dc
0073:     assert len(hits) == 1
0074: 
0075:     out = g.copy()
0076:     hit_r, hit_c = hits[0]
0077:     out[hit_r, hit_c] = bg
0078:     return out
