+from __future__ import annotations
+
+import itertools
+import random
+from collections import deque
+
+import numpy as np
+
+
+BACKGROUND = 0
+MARKER = 2
+FRAME_COLORS = (1, 3, 4, 5, 6, 7, 8, 9)
+DIR_VECTORS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+DIR_NAMES = tuple(DIR_VECTORS)
+SCENARIOS = ("mixed", "hit_only", "miss_only")
+GEN_RETRIES = 500
