0505:     """Single attempt to generate a valid input grid. Returns None on placement failure."""
0506:     H = random.randint(H_MIN, H_MAX)
0507:     W = random.randint(W_MIN, W_MAX)
0508:     inp = np.full((H, W), BG, dtype=int)
0509:     out = np.full((H, W), BG, dtype=int)
0510:     occupied = np.zeros((H, W), dtype=bool)
0511:     blue_mask = np.zeros((H, W), dtype=bool)
0512:     ray_mask = np.zeros((H, W), dtype=bool)
0513: 
0514:     # Place start segment (yellow cap + red column at bottom)
0515:     start_h = random.randint(START_H_MIN, START_H_MAX)
0516:     cap_r = H - start_h - 1
0517:     start_col = random.randint(START_COL_PAD, W - START_COL_PAD - 1)
0518:     inp[cap_r, start_col] = YELLOW
0519:     out[cap_r, start_col] = RED
0520:     ray_mask[cap_r, start_col] = True
0521:     occupied[cap_r, start_col] = True
0522:     for r in range(cap_r + 1, H):
0523:         inp[r, start_col] = RED
0524:         out[r, start_col] = RED
0525:         occupied[r, start_col] = True
0526: 
0527:     # Decide chain length and distractor count
0528:     chain_len = random.choices(range(len(CHAIN_LEN_WEIGHTS)), weights=CHAIN_LEN_WEIGHTS)[0]
0529:     min_dist = 1 if chain_len == 0 else 0
0530:     max_dist = min(MAX_DISTRACTORS, MAX_BLOB_COUNT - chain_len)
0531:     num_distractors = random.randint(min_dist, max_dist)
0532: 
0533:     # Build cascade chain
0534:     starts = [(cap_r, start_col)]
0535:     direction = UP
0536:     include_origin = True
0537:     for _ in range(chain_len):
0538:         blob = _candidate_next_blob(H, W, starts, direction, include_origin, occupied, blue_mask, ray_mask)
0539:         if blob is None:
0540:             return None
0541:         _mark_ray(out, ray_mask, blob["path"])
0542:         _place_blob(inp, occupied, blue_mask, blob)
0543:         paint_coords(out, blob["blue"], RED)
0544:         starts = blob["ports"]
0545:         direction = blob["spec"]["port_dir"]
0546:         include_origin = False
0547: 
0548:     # Final ray to grid boundary
0549:     final_path = _path_to_boundary(starts, direction, include_origin, H, W)
0550:     if any(blue_mask[r, c] for r, c in final_path):
0551:         return None
0552:     _mark_ray(out, ray_mask, final_path)
0553: 
0554:     # Place distractors
0555:     for _ in range(num_distractors):
0556:         if not _place_distractor(inp, occupied, blue_mask, ray_mask):
0557:             return None
0558: 
0559:     # Oracle check
0560:     if not np.array_equal(main(inp), out):
0561:         return None
0562:     return inp

