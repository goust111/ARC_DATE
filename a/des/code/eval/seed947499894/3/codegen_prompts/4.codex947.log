0070: def main(grid: np.ndarray) -> np.ndarray:
0071:     """
0072:     Recolor the row-wise passage indicated by wall pixels with the singleton marker color.
0073: 
0074:     Input structure:
0075:     - A dominant background contains one singleton marker pixel and one wall color.
0076:     - Wall pixels lie on several rows and form left/right limits around the marker column.
0077:     - Empty rows between the top and bottom wall rows are open horizontal passages.
0078: 
0079:     Rule:
0080:     - On a wall row, paint background pixels between the nearest wall strictly
0081:       left of the marker column and the nearest wall at or right of it; if only
0082:       one side is present, paint from that wall to the opposite grid edge.
0083:     - On empty rows between the top and bottom wall rows, paint the whole row.
0084:     - On empty rows outside the wall-row band, reuse the nearest end wall-row interval.
0085:     - Preserve wall pixels and the original marker pixel.
0086: 
0087:     Key insight:
0088:     - The wall color defines scanline limits relative to the marker column; the
0089:       marker color fills those implied horizontal spans rather than flood-filling
0090:       through connected background.
0091:     """
0092:     g = np.asarray(grid, dtype=int)
0093:     assert g.ndim == 2, "expected a 2D grid"
0094:     height, width = g.shape
0095: 
0096:     bg = get_bg(g)
0097:     fg_colors = colors_present(g, exclude={bg})
0098:     assert len(fg_colors) == 2, "expected exactly a marker color and a wall color"
0099: 
0100:     marker_colors = [color for color in fg_colors if int(np.count_nonzero(g == color)) == 1]
0101:     assert len(marker_colors) == 1, "expected a unique singleton marker color"
0102:     marker_color = int(marker_colors[0])
0103:     wall_colors = [color for color in fg_colors if int(color) != marker_color]
0104:     assert len(wall_colors) == 1, "expected one wall color"
0105:     wall_color = int(wall_colors[0])
0106: 
0107:     marker_coords = np.argwhere(g == marker_color)
0108:     assert marker_coords.shape == (1, 2), "expected exactly one marker pixel"
0109:     marker_row, marker_col = map(int, marker_coords[0])
0110:     _assert_wall_connectivity(g, wall_color, marker_col)
0111: 
0112:     row_intervals: dict[int, tuple[int, int]] = {}
0113:     for r in range(height):
0114:         wall_cols = np.flatnonzero(g[r] == wall_color)
0115:         if wall_cols.size:
0116:             row_intervals[int(r)] = _wall_row_interval(wall_cols, marker_col, width)
0117: 
0118:     assert row_intervals, "expected at least one wall row"
0119:     top_wall_row = min(row_intervals)
0120:     bottom_wall_row = max(row_intervals)
0121:     assert top_wall_row <= marker_row <= bottom_wall_row, "marker must lie within the wall-row band"
0122: 
0123:     out = g.copy()
0124:     for r in range(height):
0125:         if r in row_intervals:
0126:             start, stop = row_intervals[r]
0127:         elif top_wall_row < r < bottom_wall_row:
0128:             start, stop = 0, int(width) - 1
0129:         elif r < top_wall_row:
0130:             start, stop = row_intervals[top_wall_row]
0131:         else:
0132:             start, stop = row_intervals[bottom_wall_row]
0133: 
0134:         span = out[r, start : stop + 1]
0135:         span[span == bg] = marker_color
0136: 
0137:     return out
