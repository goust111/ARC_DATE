+        ]
+        traced = _trace_frame_option(frame, border_owner, bbox_mask, height, width)
+        hit = traced["hit"]
+        if hit is not None:
+            actions.append(
+                {
+                    "mode": "hit",
+                    "length": int(hit["length"]),
+                    "target": int(hit["target"]),
+                    "path": tuple(hit["path"]),
+                    "cells": frozenset(hit["path"]),
