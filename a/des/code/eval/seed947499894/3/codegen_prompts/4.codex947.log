+def _sample_axis_centers(rng: random.Random) -> tuple[list[int], int]:
+    count = rng.randint(2, 3)
+    centers = [rng.randint(2, 4)]
+    for _ in range(count - 1):
+        centers.append(centers[-1] + rng.randint(6, 9))
+    extent = centers[-1] + rng.randint(3, 5)
