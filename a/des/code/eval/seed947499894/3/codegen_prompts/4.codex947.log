0006: def main(grid: np.ndarray) -> np.ndarray:
0007:     """
0008:     Recolor a path-network by adjacent seed regions.
0009: 
0010:     Input structure:
0011:     - bg = most common color.
0012:     - Path color P forms a thin orthogonal network with a solid square hub (NxN).
0013:     - Seed colors appear in colored regions (non-bg, non-P) adjacent to path branches.
0014: 
0015:     Rule:
0016:     - Infer P as the non-bg color whose largest component is most network-like.
0017:     - Find the largest solid k×k all-P square (the hub); exclude it from recoloring.
0018:     - Recolor each path branch to the seed-region color it touches most.
0019:     - Recolor the hub center pixel to the seed whose branches touch the hub most.
0020: 
0021:     Key insight: The hub stays uncolored; branches inherit color from adjacent seed regions by adjacency count.
0022:     """
0023:     g = np.array(grid, dtype=int)
0024:     bg = int(get_bg(g))
0025:     H, W = g.shape
0026: 
0027:     colors = sorted({int(x) for x in np.unique(g)} - {int(bg)})
0028:     assert not (not colors)
0029: 
0030:     def comp_deg_score(mask: np.ndarray) -> float:
0031:         comps = components_mask(mask, connectivity=4)
0032:         if not comps:
0033:             return -1e9
0034:         best_pts = max(comps, key=lambda coords: int(coords.shape[0]))
0035:         best_sz = int(best_pts.shape[0])
0036: 
0037:         m = np.zeros(mask.shape, dtype=bool)
0038:         m[best_pts[:, 0], best_pts[:, 1]] = True
0039: 
0040:         deg2 = 0
0041:         deg4 = 0
0042:         for r, c in best_pts:
0043:             r = int(r)
0044:             c = int(c)
0045:             d = 0
0046:             if r > 0 and bool(m[r - 1, c]):
0047:                 d += 1
0048:             if r + 1 < H and bool(m[r + 1, c]):
0049:                 d += 1
0050:             if c > 0 and bool(m[r, c - 1]):
0051:                 d += 1
0052:             if c + 1 < W and bool(m[r, c + 1]):
0053:                 d += 1
0054:             if d == 2:
0055:                 deg2 += 1
0056:             elif d == 4:
0057:                 deg4 += 1
0058:         frac2 = deg2 / max(1, best_sz)
0059:         frac4 = deg4 / max(1, best_sz)
0060:         return float((frac2 - frac4) * best_sz)
0061: 
0062:     P = int(max(colors, key=lambda c: comp_deg_score(g == int(c))))
0063: 
0064:     # --- hub: largest solid k×k all-P square anywhere ---
0065:     mP = g == int(P)
0066:     ps = mP.astype(int).cumsum(axis=0).cumsum(axis=1)
0067: 
0068:     def rect_sum(r0: int, c0: int, r1: int, c1: int) -> int:
0069:         s = int(ps[int(r1), int(c1)])
0070:         if r0 > 0:
0071:             s -= int(ps[int(r0 - 1), int(c1)])
0072:         if c0 > 0:
0073:             s -= int(ps[int(r1), int(c0 - 1)])
0074:         if r0 > 0 and c0 > 0:
0075:             s += int(ps[int(r0 - 1), int(c0 - 1)])
0076:         return int(s)
0077: 
0078:     best = None  # (k, r0, c0)
0079:     max_k = int(min(H, W))
0080:     for k in range(2, max_k + 1):
0081:         found = None
0082:         for r0 in range(0, int(H - k + 1)):
0083:             r1 = int(r0 + k - 1)
0084:             for c0 in range(0, int(W - k + 1)):
0085:                 c1 = int(c0 + k - 1)
0086:                 if rect_sum(int(r0), int(c0), int(r1), int(c1)) == int(k * k):
0087:                     found = (int(k), int(r0), int(c0))
0088:         if found is not None:
0089:             best = found
