+from __future__ import annotations
+
+import random
+from itertools import combinations
+
+import numpy as np
+
+
+# ARC color roles used by this puzzle.
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+PIPE = 5
+MAGENTA = 6
+ORANGE = 7
+CYAN = 8
+MAROON = 9
+
+PRIMARY_SOURCE_COLORS = (RED, BLUE, YELLOW, CYAN)
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
