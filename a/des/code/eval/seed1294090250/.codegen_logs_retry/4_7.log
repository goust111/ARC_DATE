+def _mix_pair(a: int, b: int) -> int:
+    if a == b:
+        return int(a)
+    pair = frozenset((int(a), int(b)))
+    if pair == frozenset((RED, BLUE)):
+        return MAGENTA
+    if pair == frozenset((RED, YELLOW)):
+        return ORANGE
+    if pair == frozenset((BLUE, YELLOW)):
+        return GREEN
+    return MAROON
