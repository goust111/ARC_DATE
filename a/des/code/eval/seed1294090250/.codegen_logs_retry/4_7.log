+            sw = int(spec["width"])
+            placed = False
+            for _inner in range(120):
+                r0 = random.randint(0, h - sh)
+                c0 = random.randint(0, w - sw)
+                bbox = (r0, c0, r0 + sh - 1, c0 + sw - 1)
+                if all(not _bbox_overlaps(bbox, other, margin=1) for other in bboxes):
+                    bboxes.append(bbox)
+                    offsets.append((r0, c0))
