+        min_w = max(min_w, max_w * 2 + 3)
+    if min_h > 30 or min_w > 30:
+        return None
+
+    for _ in range(160):
+        h = random.randint(min_h, 30)
+        w = random.randint(min_w, 30)
+        bboxes: list[tuple[int, int, int, int]] = []
+        offsets: list[tuple[int, int]] = []
+        ok = True
+        for spec in specs:
