+
+def _paint_cells(grid: np.ndarray, cells: set[tuple[int, int]], color: int, offset: tuple[int, int]) -> None:
+    orow, ocol = offset
+    for r, c in cells:
+        grid[orow + r, ocol + c] = int(color)
