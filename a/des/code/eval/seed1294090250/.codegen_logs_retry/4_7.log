+
+def _delta_to_dir(a: tuple[int, int], b: tuple[int, int]) -> tuple[int, int]:
+    return int(b[0] - a[0]), int(b[1] - a[1])
+
+
+def _opposite(direction: tuple[int, int]) -> tuple[int, int]:
+    return -int(direction[0]), -int(direction[1])
