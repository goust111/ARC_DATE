+def _components4(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _largest_monochrome_component(grid: np.ndarray, bg: int) -> dict:
+    best = None
+    for color in np.unique(grid):
+        color = int(color)
+        if color == bg:
+            continue
+        for coords in _components4(grid == color):
+            item = {
+                "color": color,
+                "coords": coords,
+                "area": int(coords.shape[0]),
+                "bbox": _bbox(coords),
+            }
+            if best is None or item["area"] > best["area"]:
+                best = item
+    assert best is not None, "expected at least one foreground component"
+    return best
+
