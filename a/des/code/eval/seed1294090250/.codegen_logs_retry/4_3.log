+        r0 = center_r - height // 2
+        c0 = center_c - width // 2
+        nodes.append(
+            {
+                "id": node_id,
+                "color": int(palette[node_id]),
+                "pos": (r, c),
+                "center": (center_r, center_c),
+                "bbox": (r0, c0, r0 + height - 1, c0 + width - 1),
+                "mask": mask,
