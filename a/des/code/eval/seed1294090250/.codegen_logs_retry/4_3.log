import random
from collections import Counter

import numpy as np


DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
DIRECTION_VECTORS = {
    "up": (-1, 0),
    "down": (1, 0),
    "left": (0, -1),
    "right": (0, 1),
}


def _background_color(grid: np.ndarray) -> int:
    values, counts = np.unique(grid, return_counts=True)
    return int(values[np.argmax(counts)])


def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    comps: list[list[tuple[int, int]]] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            stack = [(r, c)]
            seen[r, c] = True
            comp: list[tuple[int, int]] = []
            while stack:
                cr, cc = stack.pop()
                comp.append((int(cr), int(cc)))
                for dr, dc in DIRS4:
                    nr = cr + dr
                    nc = cc + dc
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        stack.append((int(nr), int(nc)))
            comps.append(comp)
    return comps


def _border_mask(height: int, width: int) -> np.ndarray:
    mask = np.zeros((height, width), dtype=bool)
    mask[0, :] = True
    mask[-1, :] = True
    mask[:, 0] = True
    mask[:, -1] = True
    return mask


def _detect_frames(grid: np.ndarray) -> list[dict]:
    g = np.asarray(grid, dtype=int)
    bg = _background_color(g)
    frames: list[dict] = []

    for color in map(int, np.unique(g)):
        if color == bg:
            continue
        for comp in _components(g == color):
            rows = [r for r, _c in comp]
            cols = [c for _r, c in comp]
            r0 = min(rows)
            r1 = max(rows)
            c0 = min(cols)
            c1 = max(cols)
            height = r1 - r0 + 1
            width = c1 - c0 + 1
            if height < 3 or width < 3:
                continue

            local = np.zeros((height, width), dtype=bool)
            for r, c in comp:
                local[r - r0, c - c0] = True

            border = _border_mask(height, width)
            if np.any(local & ~border):
                continue

            missing = np.argwhere(border & ~local)
            if missing.shape[0] != 1:
                continue
            mr, mc = map(int, missing[0])
            if (mr in (0, height - 1)) and (mc in (0, width - 1)):
                continue

            if mr == 0:
                side = "up"
            elif mr == height - 1:
                side = "down"
            elif mc == 0:
                side = "left"
            elif mc == width - 1:
                side = "right"
            else:
                continue

            interior = g[r0 + 1 : r1, c0 + 1 : c1]
            if interior.size == 0:
                continue
            if np.any(interior == color):
                continue

            seed_mask = (interior != bg) & (interior != color)
            if not np.any(seed_mask):
                continue
            seed_values = np.unique(interior[seed_mask])
            if seed_values.size != 1:
                continue

            seed_color = int(seed_values[0])
            gap = (int(r0 + mr), int(c0 + mc))
            frames.append(
                {
                    "frame_color": color,
                    "seed_color": seed_color,
                    "seed_count": int(seed_mask.sum()),
                    "gap": gap,
                    "direction": side,
                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
                }
            )

    return frames


def main(grid: np.ndarray) -> np.ndarray:
    """
    Grow a seed-colored tentacle outward through each frame's unique 1-pixel gap.
    """
    g = np.asarray(grid, dtype=int)
    out = g.copy()

    for frame in _detect_frames(g):
        dr, dc = DIRECTION_VECTORS[frame["direction"]]
        start_r, start_c = frame["gap"]
        color = int(frame["seed_color"])
        length = int(frame["seed_count"])
        for step in range(length):
            rr = start_r + dr * step
            cc = start_c + dc * step
            if 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1]:
                out[rr, cc] = color

    return out


