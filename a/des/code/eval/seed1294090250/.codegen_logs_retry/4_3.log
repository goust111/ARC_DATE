+    max_col = max(node["bbox"][3] for node in nodes) + margin_c + 1
+    grid = np.full((max_row, max_col), int(bg), dtype=int)
+
+    for node in nodes:
+        r0, c0, r1, c1 = node["bbox"]
+        mask = node["mask"]
+        color = int(node["color"])
+        for dr in range(r1 - r0 + 1):
+            for dc in range(c1 - c0 + 1):
