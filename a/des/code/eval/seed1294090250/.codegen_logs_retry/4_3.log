+            left_r = int(node_a["center"][0])
+            start = int(node_a["bbox"][3]) + 1
+            end = int(node_b["bbox"][1]) - 1
+            assert start <= end
+            grid[left_r, start : end + 1] = BRIDGE_COLOR
+        else:
