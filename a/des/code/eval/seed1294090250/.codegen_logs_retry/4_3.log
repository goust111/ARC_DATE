+    nodes: list[dict] = []
+    for node_id, (r, c) in enumerate(positions):
+        height = rng.choice(NODE_SIZE_CHOICES)
+        width = rng.choice(NODE_SIZE_CHOICES)
+        center_r = row_centers[r]
+        center_c = col_centers[c]
