+    edge_set: set[tuple[int, int]] = set()
+    for info in bridge_infos:
+        color_a, color_b = info["neighbors"]
+        a = color_to_id[int(color_a)]
+        b = color_to_id[int(color_b)]
+        edge_set.add(tuple(sorted((a, b))))
