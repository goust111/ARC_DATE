+def _shortest_path(
+    shape: tuple[int, int],
+    start: tuple[int, int],
+    end: tuple[int, int],
+    blocked: set[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    h, w = shape
+    q = deque([start])
+    prev = {start: None}
+    while q:
+        cur = q.popleft()
+        if cur == end:
+            break
+        for nr, nc in _ordered_neighbors(cur, end):
