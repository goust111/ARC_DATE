+
+def extract_fragments(
+    grid: np.ndarray,
+    bg: int,
+    frame_cells: set[tuple[int, int]],
+    frame_markers: set[tuple[int, int]],
+) -> dict[int, dict]:
+    residual = grid != bg
+    for r, c in frame_cells:
+        residual[r, c] = False
+    for r, c in frame_markers:
+        residual[r, c] = False
