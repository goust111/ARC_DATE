+def connected_components(mask: np.ndarray, connectivity: int = 4) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    if connectivity == 4:
+        neigh = ((1, 0), (-1, 0), (0, 1), (0, -1))
+    else:
