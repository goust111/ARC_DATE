+    bg = _most_common_color(g)
+    sep_row, sep_color = _find_separator_row(g, bg)
+    legend_order = _extract_legend_order(g, bg, sep_color, sep_row)
+    canvas = g[sep_row + 1 :, :]
+    return _solve_canvas(canvas, legend_order, bg)
