+def _find_separator_row(grid: np.ndarray, bg: int) -> tuple[int, int]:
+    for r in range(grid.shape[0]):
+        row = grid[r]
+        if row[0] != bg and np.all(row == row[0]):
+            return r, int(row[0])
+    raise AssertionError("separator row not found")
