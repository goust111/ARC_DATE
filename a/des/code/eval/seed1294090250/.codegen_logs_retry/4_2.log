+def _extract_legend_order(grid: np.ndarray, bg: int, sep_color: int, sep_row: int) -> list[int]:
+    best_row = None
+    best_cols: list[int] = []
+    for r in range(sep_row):
+        cols = [c for c, v in enumerate(grid[r]) if int(v) not in (bg, sep_color)]
+        if len(cols) > len(best_cols):
+            best_row = r
+            best_cols = cols
