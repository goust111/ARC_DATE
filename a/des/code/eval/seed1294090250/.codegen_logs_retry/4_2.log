+PATH_COUNT_CHOICES = (2, 3, 4)
+PATH_TYPES = ("H", "V", "L")
+STRAIGHT_LEN_MIN = 5
+L_ARM_LEN_MIN = 3
+TOP_BLANK_MAX = 2
+MID_BLANK_MAX = 1
