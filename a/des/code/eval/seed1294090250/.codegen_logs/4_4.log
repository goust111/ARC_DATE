+import random
+from collections import deque
+
+import numpy as np
+
+
+ORANGE = 7
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+INSTRUCTIONS = ("flip_h", "flip_v", "rot_cw", "rot_ccw")
+PATTERN_CELLS = {
+    "flip_h": ((0, 0), (0, 1)),
+    "flip_v": ((0, 0), (1, 0)),
+    "rot_cw": ((0, 0), (0, 1), (1, 1)),
+    "rot_ccw": ((1, 0), (1, 1), (0, 1)),
+}
