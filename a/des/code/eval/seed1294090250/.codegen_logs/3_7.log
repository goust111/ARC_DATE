+            top_gap = random.choice(GAP_OPTIONS)
+            bottom_gap = random.choice(GAP_OPTIONS)
+            left_gap = random.choice(GAP_OPTIONS)
+            right_gap = random.choice(GAP_OPTIONS)
+
+            r0, c0, r1, c1 = inner_bbox
+            frame_bbox = (
