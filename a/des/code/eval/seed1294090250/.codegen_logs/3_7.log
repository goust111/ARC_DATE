+                c0 - left_gap - 1,
+                r1 + bottom_gap + 1,
+                c1 + right_gap + 1,
+            )
+
+            frame_choices = [color for color in COLOR_ORDER if color != carry]
+            frame_color = random.choice(frame_choices)
+            outcomes.append("frame" if COLOR_RANK[frame_color] < COLOR_RANK[carry] else "carry")
