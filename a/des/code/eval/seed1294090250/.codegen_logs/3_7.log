+        carry = int(core["color"])
+        inner_bbox = core["bbox"]
+        for frame in containing:
+            carry = _prefer_earlier(int(frame["color"]), carry)
+            r0, c0, r1, c1 = frame["bbox"]
+            ir0, ic0, ir1, ic1 = inner_bbox
