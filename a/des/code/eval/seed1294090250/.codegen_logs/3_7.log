+    h, w = _bbox_size(bbox)
+    if h < 3 or w < 3:
+        return False
+    expected: set[tuple[int, int]] = set()
+    r0, c0, r1, c1 = bbox
+    for r in range(r0, r1 + 1):
+        expected.add((r, c0))
+        expected.add((r, c1))
+    for c in range(c0, c1 + 1):
+        expected.add((r0, c))
+        expected.add((r1, c))
+    return comp["coord_set"] == expected
