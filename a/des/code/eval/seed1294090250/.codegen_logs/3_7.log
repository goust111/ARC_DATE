+def _components_by_color(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BG or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+            rows = [rr for rr, _ in coords]
+            cols = [cc for _, cc in coords]
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "coord_set": set(coords),
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _bbox_size(bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    return r1 - r0 + 1, c1 - c0 + 1
+
+
+def _bbox_area(bbox: tuple[int, int, int, int]) -> int:
+    h, w = _bbox_size(bbox)
+    return h * w
+
+
+def _strictly_contains(outer: tuple[int, int, int, int], inner: tuple[int, int, int, int]) -> bool:
+    or0, oc0, or1, oc1 = outer
+    ir0, ic0, ir1, ic1 = inner
+    return or0 < ir0 and oc0 < ic0 and or1 > ir1 and oc1 > ic1
+
