+def _scan_note_colors(
+    grid: np.ndarray, bg: int, sep_rows: list[int], sep_color: int
+) -> list[int]:
+    sep_set = set(sep_rows)
+    order: list[int] = []
+    seen: set[int] = set()
+
+    for r in range(grid.shape[0]):
+        if r in sep_set:
+            continue
+        for c in range(grid.shape[1]):
+            color = int(grid[r, c])
+            if color in (bg, sep_color):
