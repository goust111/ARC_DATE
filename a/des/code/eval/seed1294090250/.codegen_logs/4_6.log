+def _separator_spec(grid: np.ndarray, bg: int) -> tuple[list[int], int, int, int]:
+    height, width = map(int, grid.shape)
+    assert width > 0
+
+    rows: list[int] = []
+    colors: list[int] = []
+    for r in range(height):
+        row = grid[r]
+        first = int(row[0])
+        if first != bg and np.all(row == first):
+            rows.append(r)
+            colors.append(first)
