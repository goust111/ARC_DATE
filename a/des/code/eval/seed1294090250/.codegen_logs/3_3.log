+        fragment = fragments[0]
+        direction = _infer_direction(core["center"], fragment, trails)
+        trail_count = len(trails)
+
+        candidate_steps = {
+            step
+            for step in (
+                trail_count - 1,
+                trail_count,
+                trail_count + 1,
+                trail_count + 2,
+                trail_count + 3,
+            )
+            if step >= 1
+        }
+        candidate_steps.update(range(1, trail_count + 5))
