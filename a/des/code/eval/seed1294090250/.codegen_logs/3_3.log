+    occupied = set(core_set)
+    all_colors = [int(color) for color in np.unique(g) if int(color) != bg]
+
+    for color in all_colors:
+        color_mask = (g == color)
+        if not np.any(color_mask):
+            continue
+        for r, c in core_set:
+            color_mask[r, c] = False
+        if not np.any(color_mask):
+            continue
