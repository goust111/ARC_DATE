+    "NE": (-1, 1),
+    "E": (0, 1),
+    "SE": (1, 1),
+    "S": (1, 0),
+    "SW": (1, -1),
+    "W": (0, -1),
+    "NW": (-1, -1),
+}
+
+GEN_BG = 0
+GEN_GRID_MIN = 18
+GEN_GRID_MAX = 30
+GEN_CORE_SIZE_RANGE = (4, 6)
+GEN_FRAGMENT_COUNT_RANGE = (3, 5)
+GEN_TRAIL_COUNT_RANGE = (1, 3)
+GEN_MAX_ATTEMPTS = 300
