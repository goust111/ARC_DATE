+    picked = rng.sample(colors, 2 * object_count)
+    seed_colors = picked[:object_count]
+    frame_colors = picked[object_count:]
+
+    specs: list[dict] = []
+    used: set[tuple[int, int]] = set()
+    directions = list(DIRECTION_VECTORS)
