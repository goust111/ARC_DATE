+
+    for i, (frame_color, seed_color) in enumerate(zip(frame_colors, seed_colors)):
+        spec = _sample_spec(
+            rng,
+            height,
+            width,
+            used,
+            directions[i % len(directions)],
+            frame_color,
+            seed_color,
