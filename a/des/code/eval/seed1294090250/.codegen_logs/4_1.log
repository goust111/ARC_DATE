+                    "seed_color": seed_color,
+                    "seed_count": int(seed_mask.sum()),
+                    "gap": gap,
+                    "direction": side,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                }
+            )
+
+    return frames
