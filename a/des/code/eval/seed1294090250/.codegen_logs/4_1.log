+            c0 = rng.randint(min_c0, max_c0)
+            r1 = r0 + outer_h - 1
+            c1 = c0 + outer_w - 1
+
+            if direction in ("up", "down"):
+                gap = (r0 if direction == "up" else r1, rng.randint(c0 + 1, c1 - 1))
+            else:
+                gap = (rng.randint(r0 + 1, r1 - 1), c0 if direction == "left" else c1)
