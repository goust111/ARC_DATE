+        for ih in INNER_HEIGHT_RANGE
+        for iw in INNER_WIDTH_RANGE
+        if ih * iw >= seed_count
+    ]
+    rng.shuffle(shapes)
+
+    for inner_h, inner_w in shapes:
+        outer_h = inner_h + 2
+        outer_w = inner_w + 2
+
+        min_r0 = 1
+        max_r0 = height - outer_h - 1
+        min_c0 = 1
+        max_c0 = width - outer_w - 1
+
+        if direction == "up":
