+        elif direction == "down":
+            max_r0 = min(max_r0, height - outer_h - seed_count + 1)
+        elif direction == "left":
+            min_c0 = max(min_c0, seed_count - 1)
+        elif direction == "right":
+            max_c0 = min(max_c0, width - outer_w - seed_count + 1)
+
+        if min_r0 > max_r0 or min_c0 > max_c0:
+            continue
