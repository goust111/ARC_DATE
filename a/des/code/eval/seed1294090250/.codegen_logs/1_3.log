+
+def _ray_cells(pos: tuple[int, int], direction: tuple[int, int], start_step: int, end_step: int) -> list[tuple[int, int]]:
+    return [_ray_cell(pos, direction, step) for step in range(int(start_step), int(end_step) + 1)]
