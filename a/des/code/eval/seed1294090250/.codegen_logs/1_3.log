+        path = set()
+        step_c = 1 if cb > ca else -1
+        for cc in range(ca + step_c, cb + step_c, step_c):
+            path.add((int(ra), int(cc)))
+        step_r = 1 if ra > rb else -1
+        for rr in range(rb + step_r, ra + step_r, step_r):
+            path.add((int(rr), int(cb)))
+        if inter not in path:
