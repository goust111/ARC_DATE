+        runs = _legend_runs(grid[r])
+        if runs is None:
+            continue
+        mapping: dict[int, int] = {}
+        for c0, c1 in runs:
+            mapping[int(grid[r, c0])] = int(grid[r, c1])
+        if len(mapping) == len(runs):
+            return int(r), mapping, runs
+    raise AssertionError("failed to locate legend row")
+
