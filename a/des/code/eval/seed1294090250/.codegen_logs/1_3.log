+    return None
+
+
+def _collision_plan(rng: random.Random, seeds: list[tuple[int, int]]) -> tuple[tuple[int, int], set[tuple[int, int]]] | None:
+    pairs = list(combinations(range(len(seeds)), 2))
+    rng.shuffle(pairs)
+    for ia, ib in pairs:
+        ra, ca = map(int, seeds[ia])
+        rb, cb = map(int, seeds[ib])
