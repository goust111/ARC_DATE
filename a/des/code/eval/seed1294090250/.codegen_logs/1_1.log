+    return {
+        "trail": trail,
+        "final": final,
+        "travel": int(travel),
+        "dir": (dr, dc),
+        "initial": set(initial),
+    }
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Match each colored outer sprite to the same-colored gap marker on the hollow frame,
+    slide the sprite into the frame from that side, leave a grey trail, and park it
