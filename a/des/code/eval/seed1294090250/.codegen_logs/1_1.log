+
+def _place_shape(grid: np.ndarray, coords, color: int):
+    for r, c in coords:
+        grid[r, c] = color
+
+
+def _can_place_input_sprite(grid: np.ndarray, abs_coords, frame_bbox):
+    h, w = grid.shape
+    top, left, bottom, right = frame_bbox
