+        plans.append(plan)
+    return plans
+
+
+def _valid_output_interactions(plans, require_cross: bool):
+    crossed = False
+    for i in range(len(plans)):
+        for j in range(i + 1, len(plans)):
+            if plans[i]["final"] & plans[j]["final"]:
+                return False
+            if plans[i]["final"] & plans[j]["trail"]:
+                return False
+            if plans[j]["final"] & plans[i]["trail"]:
