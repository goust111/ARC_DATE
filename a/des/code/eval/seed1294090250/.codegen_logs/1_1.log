+
+
+def _pick_centers_for_side(rng: random.Random, side: str, frame_bbox, count: int, preset=None):
+    preset = [] if preset is None else list(preset)
+    top, left, bottom, right = frame_bbox
+    if side in ("top", "bottom"):
