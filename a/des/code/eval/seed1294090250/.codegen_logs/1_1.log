+    else:
+        candidates = list(range(top + 2, bottom - 1))
+
+    chosen = []
+    for val in preset:
+        if val not in candidates:
+            return None
+        chosen.append(val)
+
+    rng.shuffle(candidates)
+    for cand in candidates:
+        if len(chosen) >= count:
