+
+BLACK = 0
+GREY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+
+MIN_REGIONS = 3
+MAX_REGIONS = 5
+MIN_REGION_WIDTH = 5
+MAX_REGION_WIDTH = 8
+MIN_BODY_HEIGHT = 8
+MAX_BODY_HEIGHT = 15
+MIN_SHAPE_HEIGHT = 3
+MAX_SHAPE_HEIGHT = 6
