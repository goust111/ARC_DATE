+MIN_REGIONS = 3
+MAX_REGIONS = 5
+MIN_REGION_WIDTH = 5
+MAX_REGION_WIDTH = 8
+MIN_BODY_HEIGHT = 8
+MAX_BODY_HEIGHT = 15
