+    shape_colors: list[int],
+) -> tuple[dict[frozenset[int], int], list[tuple[int, int, int]]]:
+    adjacent_pairs = [(int(shape_colors[i]), int(shape_colors[i + 1])) for i in range(len(shape_colors) - 1)]
+    legend_pairs = list(adjacent_pairs)
