+    for i in range(len(bounds) - 1):
+        c0 = bounds[i] + 1
+        c1 = bounds[i + 1] - 1
+        assert c0 <= c1, "each stripe region must contain at least one column"
+        spans.append((int(c0), int(c1)))
+    return spans
+
