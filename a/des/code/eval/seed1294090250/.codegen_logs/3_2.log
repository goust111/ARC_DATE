+    horiz = [frame_top]
+    for size in room_heights:
+        horiz.append(horiz[-1] + size + 1)
+    vert = [frame_left]
+    for size in room_widths:
+        vert.append(vert[-1] + size + 1)
+
+    for r in horiz:
+        grid[r, frame_left : frame_right + 1] = WALL
+    for c in vert:
