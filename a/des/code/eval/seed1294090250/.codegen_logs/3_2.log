+def _connected_components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[list[tuple[int, int]]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            queue = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while queue:
