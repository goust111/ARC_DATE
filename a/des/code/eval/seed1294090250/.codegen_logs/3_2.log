+    colors = [int(v) for v in np.unique(grid) if int(v) != int(bg)]
+    if WALL in colors:
+        return WALL
+    assert colors
+    counts = {color: int(np.sum(grid == color)) for color in colors}
+    return max(colors, key=lambda color: counts[color])
