+        if c == 0 or not region_mask[r, c - 1]:
+            edge_map[(r + 1, c)] = ((r, c), (r, c))
+
+    assert edge_map
+    start_vertex = min(edge_map)
+    ordered: list[tuple[int, int]] = []
+    cur = start_vertex
+
+    for _ in range(len(edge_map) + 5):
+        nxt, cell = edge_map[cur]
