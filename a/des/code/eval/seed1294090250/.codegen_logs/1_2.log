    for i, j in pair_ids:
        key = (i, j) if i < j else (j, i)
        rel = relations[key]
        if rel["first"] is index_to_comp[i]:
            matched.append(rel)
        else:
            matched.append(_pair_relation(index_to_comp[i], index_to_comp[j]))
    return matched


def _edge_cells(comp: dict, side: str) -> list[tuple[int, int]]:
    coords = comp["coords"]
    if side == "left":
        edge = min(c for _r, c in coords)
        return [(r, c) for r, c in coords if c == edge]
    if side == "right":
        edge = max(c for _r, c in coords)
        return [(r, c) for r, c in coords if c == edge]
    if side == "top":
        edge = min(r for r, _c in coords)
