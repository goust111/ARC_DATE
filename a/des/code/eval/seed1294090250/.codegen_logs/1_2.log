+
+
+# --------------- generator ---------------
+
+GRID_H_RANGE = (16, 24)
+GRID_W_RANGE = (16, 24)
+PAIR_COUNT_RANGE = (2, 4)
+SHAPE_AREA_RANGE = (4, 8)
+SHAPE_BBOX_MAX = 4
+GAP_RANGE = (2, 6)
+PLACE_RETRIES = 120
+SHAPE_RETRIES = 120
