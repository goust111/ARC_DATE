+
+
+def _detect_frame(grid: np.ndarray, pts: list[tuple[int, int]], bg: int) -> dict | None:
+    r0, c0, r1, c1 = _bbox(pts)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
