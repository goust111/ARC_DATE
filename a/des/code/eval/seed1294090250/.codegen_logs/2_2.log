+from __future__ import annotations
+
+from collections import Counter, deque
+import math
+
+import numpy as np
+
+
+BG = 0
+LATTICE_COLOR = 2
+ROW_COLOR_POOL = np.array([1, 3, 4, 5, 6, 7, 8, 9], dtype=int)
+MAX_SIDE = 30
+MAX_GENERATION_ATTEMPTS = 500
