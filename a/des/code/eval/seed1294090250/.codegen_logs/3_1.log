+from __future__ import annotations
+
+import random
+import numpy as np
+
+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+SIDES = ("top", "bottom", "left", "right")
+SIDE_TO_ROT = {"bottom": 0, "right": 1, "top": 2, "left": 3}
+ALL_COLORS = tuple(range(10))
+
+GEN_RETRIES = 400
+PLACEMENT_RETRIES = 40
+CANVAS_MIN = 24
+CANVAS_MAX = 36
