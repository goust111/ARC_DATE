+def _render_frame_patch(
+    bg: int, frame_color: int, seed_color: int, inner_h: int, inner_w: int, side: str
+) -> np.ndarray:
+    patch = np.full((inner_h + 2, inner_w + 2), bg, dtype=int)
+    patch[0, :] = frame_color
+    patch[-1, :] = frame_color
