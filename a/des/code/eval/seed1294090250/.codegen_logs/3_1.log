+STAMP_TEMPLATES = (
+    _template(["111", "010", "020"]),
+    _template(["100", "111", "020"]),
+    _template(["001", "111", "020"]),
+    _template(["101", "111", "010", "020"]),
+    _template(["11111", "00100", "00200"]),
