+def _find_stamps(
+    grid: np.ndarray, bg: int, frame_boxes: list[tuple[int, int, int, int]]
+) -> dict[int, dict]:
+    outside = grid != bg
+    for r0, c0, r1, c1 in frame_boxes:
+        outside[r0 : r1 + 1, c0 : c1 + 1] = False
