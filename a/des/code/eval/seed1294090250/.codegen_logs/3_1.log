+def _seed_anchors(inner_h: int, inner_w: int) -> dict[str, tuple[int, int]]:
+    return {
+        "top": (0, inner_w // 2),
+        "bottom": (inner_h - 1, inner_w // 2),
+        "left": (inner_h // 2, 0),
+        "right": (inner_h // 2, inner_w - 1),
+    }
+
