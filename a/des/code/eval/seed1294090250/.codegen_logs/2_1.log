+THICKNESS_CHOICES = (1, 2)
+TOP_BOTTOM_DIMS = (2, 3, 4, 5)
+SIDE_SQUARE_DIMS = (2, 3, 4, 5)
+CORNERS = ("tl", "tr", "bl", "br")
+MAX_RETRIES = 300
