+    if not bg_mask.any():
+        return False
+    seen = np.zeros((h, w), dtype=bool)
+    stack: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in (0, w - 1):
+            if bg_mask[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if bg_mask[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+    while stack:
+        cr, cc = stack.pop()
+        for dr, dc in DIR4:
+            nr, nc = cr + dr, cc + dc
+            if 0 <= nr < h and 0 <= nc < w and bg_mask[nr, nc] and not seen[nr, nc]:
