+        target_w = int(c1 - c0 + 1)
+        mask = np.rot90(templates[color], ROT_K_BY_SIDE[frame["side"]])
+        assert mask.shape == (target_h, target_w)
+        patch = out[r0 : r1 + 1, c0 : c1 + 1]
+        assert np.all(patch[mask] == bg)
+        patch[mask] = color
+
+    return out
