+                        cavity_left,
+                        cavity_top + spec["cavity_h"] - 1,
+                        cavity_left + spec["cavity_w"] - 1,
+                    ),
+                }
+            )
+            placed = True
+            break
+        if not placed:
+            return None
+
+    expected = _expected_output(grid, frames, template_masks)
+    actual = main(grid)
+    if not np.array_equal(actual, expected):
+        return None
+
+    return grid
+
