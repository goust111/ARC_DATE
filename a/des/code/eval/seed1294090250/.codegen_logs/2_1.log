+        mask = np.rot90(mask, rng.randrange(4))
+        outer_h = cavity_h + 2 * thickness
+        outer_w = cavity_w + 2 * thickness
+        specs.append(
+            {
+                "anchor_color": color,
+                "side": side,
+                "thickness": thickness,
+                "cavity_h": cavity_h,
+                "cavity_w": cavity_w,
+                "outer_h": outer_h,
+                "outer_w": outer_w,
+            }
