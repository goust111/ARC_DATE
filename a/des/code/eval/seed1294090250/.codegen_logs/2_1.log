+
+def _boundary_background(grid: np.ndarray) -> int:
+    edge = np.concatenate((grid[0], grid[-1], grid[:, 0], grid[:, -1]))
+    return int(Counter(edge.tolist()).most_common(1)[0][0])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _has_hole(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    bg_mask = ~mask
+    if not bg_mask.any():
+        return False
+    seen = np.zeros((h, w), dtype=bool)
+    stack: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in (0, w - 1):
+            if bg_mask[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if bg_mask[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+    while stack:
+        cr, cc = stack.pop()
+        for dr, dc in DIR4:
+            nr, nc = cr + dr, cc + dc
+            if 0 <= nr < h and 0 <= nc < w and bg_mask[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                stack.append((nr, nc))
+    return bool(np.any(bg_mask & ~seen))
+
+
+def _frame_info(sub: np.ndarray, bg: int, origin_r: int, origin_c: int) -> dict | None:
+    comp_mask = sub != bg
+    if not (np.all(comp_mask[0]) and np.all(comp_mask[-1]) and np.all(comp_mask[:, 0]) and np.all(comp_mask[:, -1])):
+        return None
+
+    vals = sub[comp_mask]
+    colors = [int(v) for v in np.unique(vals)]
+    if len(colors) != 2:
+        return None
+
+    counts = Counter(vals.tolist())
+    singleton = [color for color, cnt in counts.items() if int(cnt) == 1]
+    if len(singleton) != 1:
+        return None
