+import random
+from collections import Counter
+
+import numpy as np
+
+
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+SIDE_ORDER = ("top", "right", "bottom", "left")
+ROT_K_BY_SIDE = {"top": 0, "right": 3, "bottom": 2, "left": 1}
+
+BG = 0
+FRAME = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
