+            branch_cells = _branch_cells(gap, direction, seed_count)
+            if any(not (0 <= rr < h and 0 <= cc < w) for rr, cc in branch_cells):
+                continue
+
+            interior_cells = [
+                (rr, cc)
+                for rr in range(r0 + 1, r0 + outer_h - 1)
+                for cc in range(c0 + 1, c0 + outer_w - 1)
