+
+            specs.append(
+                {
+                    "seed_color": entry["seed_color"],
+                    "branch_color": entry["branch_color"],
+                    "seed_count": seed_count,
+                    "gap": gap,
+                    "direction": direction,
+                }
+            )
+            reserved |= reserve
+            placed = True
