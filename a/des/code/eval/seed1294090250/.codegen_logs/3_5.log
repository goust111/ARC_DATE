+def _safe_branch_dirs(prev_dir: int, out_dir: int) -> list[int]:
+    priority = [((prev_dir + 1) % 4), prev_dir, ((prev_dir - 1) % 4)]
+    out_index = priority.index(out_dir)
+    return priority[out_index + 1 :]
