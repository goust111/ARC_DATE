+    if len(labels_by_type) < 2:
+        return None
+    if count >= 3 and any(labels_by_type[t] == 0 for t in ("R", "S", "L")):
+        return None
+
+    if not _validate_instance(base, expected, metas):
+        return None
+    return base
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
