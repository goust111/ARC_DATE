+    while True:
+        prev_r = -1 if prev is None else prev[0]
+        prev_c = -1 if prev is None else prev[1]
+        state = (pos[0], pos[1], heading, prev_r, prev_c)
+        if state in seen_states:
+            break
+        seen_states.add(state)
