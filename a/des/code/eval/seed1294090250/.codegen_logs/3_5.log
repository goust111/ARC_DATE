+    return {"R", "S", "L"} & set(labels) == set(labels) or bool(labels)
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    mh = rng.randint(8, 12)
+    mw = rng.randint(8, 12)
+    h, w = 2 * mh + 1, 2 * mw + 1
+
