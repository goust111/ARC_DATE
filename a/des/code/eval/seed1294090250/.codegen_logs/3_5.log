+
+def _rel_label(prev_dir: int, next_dir: int) -> str:
+    delta = (next_dir - prev_dir) % 4
+    if delta == 1:
+        return "R"
+    if delta == 0:
+        return "S"
+    if delta == 3:
+        return "L"
+    raise ValueError("reverse moves are not valid path steps")
