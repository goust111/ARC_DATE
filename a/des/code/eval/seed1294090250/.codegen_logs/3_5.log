+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+REL_PRIORITY = (1, 0, -1)
+REL_TO_LABEL = {1: "R", 0: "S", -1: "L"}
+SIDE_TO_DIR = {"top": 2, "right": 3, "bottom": 0, "left": 1}
+GEN_ATTEMPTS = 400
+PATH_ATTEMPTS = 120
+BRANCH_ATTEMPTS = 40
