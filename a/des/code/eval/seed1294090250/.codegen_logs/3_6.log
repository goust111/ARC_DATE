+
+
+def _gen_attempt() -> np.ndarray | None:
+    width = random.randint(*WIDTH_RANGE)
+    legend_height = random.randint(*LEGEND_HEIGHT_RANGE)
+    region_heights = [random.randint(*REGION_HEIGHT_RANGE) for _ in range(REGION_COUNT)]
