+def _transform_patch(mask: np.ndarray, transform: str) -> np.ndarray:
+    if transform == "identity":
+        return mask.copy()
+    if transform == "hflip":
+        return np.fliplr(mask)
+    if transform == "vflip":
+        return np.flipud(mask)
+    if transform == "rot90":
