+        grid[row : row + region_h, :] = region
+        row += region_h
+
+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
