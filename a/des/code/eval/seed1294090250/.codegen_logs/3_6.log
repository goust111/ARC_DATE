    """Choose 1..N_SOURCES_MAX source corners from frames larger than the minimum size."""
    eligible = [(fi, kind) for fi, f in enumerate(frames)
                if f['size'] >= SOURCE_MIN_SIZE for kind in CORNER_KINDS]
    if not eligible:
        return None
