+def _is_rect_ring(comp: dict) -> bool:
+    mask = _component_mask(comp)
+    h, w = mask.shape
+    if h < 3 or w < 3:
+        return False
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return bool(np.array_equal(mask, border))
+
+
+def _is_solid_block(comp: dict) -> bool:
+    return bool(np.all(_component_mask(comp)))
+
