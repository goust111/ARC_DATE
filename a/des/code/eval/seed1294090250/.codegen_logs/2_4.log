+GEN_BG = 0
+GEN_COLORS = tuple(range(1, 10))
+GEN_RING_COUNT_MIN = 2
+GEN_RING_COUNT_MAX = 4
+GEN_CORE_SIZE_MIN = 1
+GEN_CORE_SIZE_MAX = 3
+GEN_GAP_MIN = 1
+GEN_GAP_MAX = 3
+GEN_MARGIN_MIN = 1
+GEN_MARGIN_MAX = 4
+GEN_GRID_MAX = 30
+GEN_MAX_ATTEMPTS = 400
+
