+def _randint(rng: np.random.Generator, lo: int, hi: int) -> int:
+    return int(rng.integers(lo, hi + 1))
+
+
+def _expand_bbox(
+    inner: tuple[int, int, int, int],
+    top_gap: int,
+    bottom_gap: int,
+    left_gap: int,
+    right_gap: int,
