+    return int(colors[int(np.argmax(counts))])
+
+
+def _components(g: np.ndarray, bg: int) -> list[dict]:
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg or seen[r, c]:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            r0, c0 = np.min(arr, axis=0)
+            r1, c1 = np.max(arr, axis=0)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                }
+            )
+    return comps
+
+
+def _component_mask(comp: dict) -> np.ndarray:
+    r0, c0, r1, c1 = comp["bbox"]
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    rel = comp["coords"] - np.array([r0, c0], dtype=int)
+    mask[rel[:, 0], rel[:, 1]] = True
+    return mask
+
+
+def _is_rect_ring(comp: dict) -> bool:
+    mask = _component_mask(comp)
+    h, w = mask.shape
+    if h < 3 or w < 3:
+        return False
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return bool(np.array_equal(mask, border))
+
+
