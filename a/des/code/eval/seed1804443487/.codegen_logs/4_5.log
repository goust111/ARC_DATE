+        grid[cr, cc + step] = GEAR
+
+
+def _crop_with_margin(grid: np.ndarray, rng: random.Random) -> np.ndarray:
+    points = np.argwhere(grid != BG)
+    r0, c0 = points.min(axis=0)
+    r1, c1 = points.max(axis=0)
+    top = rng.randint(1, min(3, int(r0)))
