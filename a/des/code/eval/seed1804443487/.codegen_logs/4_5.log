+    coords: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        coords.append((r0, c))
+    for r in range(r0 + 1, r1 + 1):
+        coords.append((r, c1))
+    for c in range(c1 - 1, c0 - 1, -1):
+        coords.append((r1, c))
+    for r in range(r1 - 1, r0, -1):
+        coords.append((r, c0))
+    return coords
