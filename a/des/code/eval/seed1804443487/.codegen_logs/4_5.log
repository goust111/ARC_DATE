+    left = rng.randint(1, min(3, int(c0)))
+    bottom = rng.randint(1, min(3, int(grid.shape[0] - 1 - r1)))
+    right = rng.randint(1, min(3, int(grid.shape[1] - 1 - c1)))
+    return grid[r0 - top : r1 + bottom + 1, c0 - left : c1 + right + 1].copy()
