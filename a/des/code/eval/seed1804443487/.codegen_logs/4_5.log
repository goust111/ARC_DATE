+        return None
+
+    grid = np.full((BASE_CANVAS, BASE_CANVAS), BG, dtype=int)
+    for spec in placed:
+        _draw_track(grid, rng, spec)
+
+    grid = _crop_with_margin(grid, rng)
+    _validate_generated(grid, track_count)
+    return grid
+
