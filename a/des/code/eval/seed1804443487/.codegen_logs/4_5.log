+    up = arm_len(-1, 0)
+    down = arm_len(1, 0)
+    left = arm_len(0, -1)
+    right = arm_len(0, 1)
+    assert len(gear) == 1 + up + down + left + right
+    return up, down, left, right
+
+
+def _extract_tracks(grid: np.ndarray, bg: int) -> list[dict]:
+    tracks: list[dict] = []
+    for pts in _components(grid != bg):
