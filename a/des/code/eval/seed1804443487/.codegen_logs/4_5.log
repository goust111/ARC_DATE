+        gear_pts = [(r0 + 1 + r, c0 + 1 + c) for r, c in gear_comps[0]]
+        center = _find_gear_center(gear_pts)
+        up, down, left, right = _gear_lengths(gear_pts, center)
+        if max(up, down, left, right) > MAX_ARM:
