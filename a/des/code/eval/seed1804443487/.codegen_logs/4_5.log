+        for r0 in range(1, BASE_CANVAS - oh):
+            for c0 in range(1, BASE_CANVAS - ow):
+                bbox = (r0, c0, r0 + oh - 1, c0 + ow - 1)
+                if all(not _rectangles_too_close(bbox, other["bbox"], pad=1) for other in placed):
