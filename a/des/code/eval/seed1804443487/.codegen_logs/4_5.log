+            continue
+        row_cols = sorted(pc for pr, pc in pts if pr == r)
+        col_rows = sorted(pr for pr, pc in pts if pc == c)
+        if row_cols != list(range(min(row_cols), max(row_cols) + 1)):
+            continue
+        if col_rows != list(range(min(col_rows), max(col_rows) + 1)):
