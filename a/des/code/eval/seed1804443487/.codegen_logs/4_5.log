+    parities = [i % 2 for i in range(track_count)]
+    if track_count % 2 == 1:
+        parities[-1] = rng.randint(0, 1)
+    rng.shuffle(parities)
+
+    specs = [_make_track_spec(rng, parity) for parity in parities]
