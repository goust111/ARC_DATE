+        "outer_h": outer_h,
+        "outer_w": outer_w,
+        "token_count": rng.choice([1, 2]),
+    }
+
+
+def _place_specs(rng: random.Random, specs: list[dict]) -> list[dict] | None:
+    placed: list[dict] = []
+    order = sorted(specs, key=lambda spec: spec["outer_h"] * spec["outer_w"], reverse=True)
