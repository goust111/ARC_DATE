+                "tokens": tokens,
+                "gear": gear_pts,
+                "center": center,
+                "arms": (up, down, left, right),
+            }
+        )
+    return tracks
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Move each token around its rectangular track by the amount and direction
+    encoded by the interior gear.
