+
+def _vertical_marker_direction(grid: np.ndarray, row: int, col: int) -> str | None:
+    left = col > 0 and int(grid[row, col - 1]) == YELLOW
+    right = col + 1 < grid.shape[1] and int(grid[row, col + 1]) == YELLOW
+    if left == right:
+        return None
+    return "left" if left else "right"
