+def _copy_items(items: list[PipeItem]) -> list[PipeItem]:
+    return [
+        PipeItem(
+            axis=item.axis,
+            row=item.row,
+            col=item.col,
+            kind=item.kind,
+            direction=item.direction,
+            marker_row=item.marker_row,
+            marker_col=item.marker_col,
+        )
+        for item in items
