+
+def _horizontal_marker_direction(grid: np.ndarray, row: int, col: int) -> str | None:
+    up = row > 0 and int(grid[row - 1, col]) == YELLOW
+    down = row + 1 < grid.shape[0] and int(grid[row + 1, col]) == YELLOW
+    if up == down:
+        return None
+    return "up" if up else "down"
