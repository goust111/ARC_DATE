+            if not _coords_are_free(output_blocked, output_coords):
+                continue
+            _reserve_coords(input_blocked, input_coords, pad=1)
+            _reserve_coords(output_blocked, output_coords, pad=0)
+            pipes.append(pipe)
+            placed = True
+            break
