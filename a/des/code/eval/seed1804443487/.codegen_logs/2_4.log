+
+
+def _shift_items(items: list[PipeItem], dr: int, dc: int) -> None:
+    for item in items:
+        item.row += dr
+        item.col += dc
+        if item.kind == "valve":
+            assert item.marker_row is not None and item.marker_col is not None
+            item.marker_row += dr
+            item.marker_col += dc
