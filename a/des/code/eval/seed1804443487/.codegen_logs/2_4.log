+import random
+from dataclasses import dataclass
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+YELLOW = 4
+PIPE_COLOR_POOL = [1, 3, 5, 6, 7, 8, 9]
+
+SHIFT_BY_DIRECTION = {
+    "up": (-2, 0),
+    "down": (2, 0),
+    "left": (0, -2),
+    "right": (0, 2),
+}
+
+
+@dataclass
+class PipeItem:
+    axis: int
+    row: int
+    col: int
+    kind: str
+    direction: str | None = None
+    marker_row: int | None = None
+    marker_col: int | None = None
+
+
+@dataclass(frozen=True)
+class GenValve:
+    axis: int
+    direction: str
+
+
+@dataclass(frozen=True)
