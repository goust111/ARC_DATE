+BG = 0
+FRAME_COLORS = tuple(range(1, 10))
+OUTER_SIZE_CHOICES = {
+    1: (6, 8, 10, 12),
+    2: (6, 8, 10),
+    3: (6, 8),
+    4: (6, 8),
+}
+SEED_COUNT_CHOICES = (1, 2, 3)
+MAX_GEN_RETRIES = 400
+PLACEMENT_RETRIES = 200
+QUADRANTS = ("tl", "tr", "bl", "br")
