+                    "top": top,
+                    "left": left,
+                    **meta,
+                }
+            )
+            placed = True
+            break
+        if not placed:
+            return None
+
+    expected = _expected_output(grid, placed_regions)
+    actual = main(grid)
+    if np.array_equal(actual, expected):
+        return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid input")

