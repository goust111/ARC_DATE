+    h, w = occupied.shape
+    ph, pw = patch.shape
+    if top + ph > h or left + pw > w:
+        return False
+
+    for r, c in np.argwhere(patch != BG):
+        rr = top + int(r)
+        cc = left + int(c)
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
