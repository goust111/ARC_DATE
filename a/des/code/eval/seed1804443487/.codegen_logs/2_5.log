+GRID_H_RANGE = (18, 29)
+GRID_W_RANGE = (18, 31)
+RULE_COUNT_RANGE = (3, 6)
+REGION_COUNT_RANGE = (2, 5)
+LEGEND_TOP_OPTIONS = (0, 1)
+LEGEND_LEFT_RANGE = (1, 4)
+LEGEND_GAP_OPTIONS = (1, 2)
+REGION_START_GAP = 2
+
+BACKBONE_H_RANGE = (3, 6)
+BACKBONE_W_RANGE = (3, 7)
