        wide = _GEN_WIDE_WIDTH_CHOICES[0] if random.random() < _GEN_WIDEST_WIDTH_PROB else _GEN_WIDE_WIDTH_CHOICES[1]
        widths = [wide, available - wide]
        random.shuffle(widths)
    else:
