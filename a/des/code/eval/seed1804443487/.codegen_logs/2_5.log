+        on_outer_edge = cell[0] in (full_r0, full_r1) or cell[1] in (full_c0, full_c1)
+        edge_penalty = 0 if on_outer_edge else 1
+        candidates.append((degree * 10 + edge_penalty, cell, remaining, main_color))
