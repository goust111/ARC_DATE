    backbone_col = random.randrange(width)
    cells = {(r, backbone_col) for r in range(height)}
    while len(cells) < area:
        frontier = set()
        for r, c in cells:
            for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
