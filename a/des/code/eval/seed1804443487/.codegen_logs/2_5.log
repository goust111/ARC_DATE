+
+    main_cells = {cell for cell in region_cells if int(patch[cell]) == main_color}
+    assert all(
+        any(nb in main_cells for nb in _neighbors4(*cell))
+        for cell in main_cells
+    ), "region main-color cells must not look like indicators"
