+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    n_regions = random.randint(*REGION_COUNT_RANGE)
+    n_rules = random.randint(max(RULE_COUNT_RANGE[0], n_regions), RULE_COUNT_RANGE[1])
+
