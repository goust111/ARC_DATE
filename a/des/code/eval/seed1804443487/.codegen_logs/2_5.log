+    w = random.randint(max(GRID_W_RANGE[0], min_width), GRID_W_RANGE[1])
+    grid = np.full((h, w), BG, dtype=int)
+
+    x = left_margin
+    for i, src in enumerate(source_colors):
+        tile = _rule_tile(src, mapping[src])
+        _paste(grid, tile, top_margin, x)
+        x += tile.shape[1]
+        if i < len(gaps):
