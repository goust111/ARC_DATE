+    meta = {
+        "region_cells": region_cells,
+        "indicator": indicator,
+        "main_color": main_color,
+        "target_color": target_color,
+    }
+    return patch, meta
+
+
+def _can_place(
+    occupied: np.ndarray, patch: np.ndarray, top: int, left: int, row_min: int
+) -> bool:
+    if top < row_min:
+        return False
+    h, w = occupied.shape
+    ph, pw = patch.shape
+    if top + ph > h or left + pw > w:
+        return False
+
+    for r, c in np.argwhere(patch != BG):
