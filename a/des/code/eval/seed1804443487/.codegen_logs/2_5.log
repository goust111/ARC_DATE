+    left_margin = random.randint(*LEGEND_LEFT_RANGE)
+    gaps = [random.choice(LEGEND_GAP_OPTIONS) for _ in range(n_rules - 1)]
+    legend_width = n_rules * 3 + sum(gaps)
+    min_width = left_margin + legend_width + 1
+
