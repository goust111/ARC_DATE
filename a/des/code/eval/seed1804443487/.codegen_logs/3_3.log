+def _rect_for_arrow(arrow: dict, rects: list[dict], used: set[int]) -> dict | None:
+    dr, dc = arrow["dir"]
+    matches: list[tuple[int, dict]] = []
+    for idx, rect in enumerate(rects):
+        if idx in used:
+            continue
+        if (dr, dc) == (-1, 0):
+            ok = rect["r0"] == arrow["r1"] + 1 and rect["c0"] <= arrow["c0"] and rect["c1"] >= arrow["c1"]
+        elif (dr, dc) == (1, 0):
