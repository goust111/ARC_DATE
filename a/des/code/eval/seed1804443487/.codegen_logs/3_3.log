+    [
+        [0, 1, 0],
+        [1, 1, 0],
+        [1, 1, 1],
+    ],
+    dtype=int,
+)
+DIR_TO_TEMPLATE = {
+    (-1, 0): BASE_ARROW_UP,
+    (0, 1): np.rot90(BASE_ARROW_UP, 3),
+    (1, 0): np.rot90(BASE_ARROW_UP, 2),
+    (0, -1): np.rot90(BASE_ARROW_UP, 1),
+}
+DIRECTIONS = list(DIR_TO_TEMPLATE)
