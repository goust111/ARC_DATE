+        if direction is None:
+            continue
+        r0, c0, r1, c1 = _bbox(pts)
+        arrows.append({"dir": direction, "r0": r0, "c0": c0, "r1": r1, "c1": c1})
+    return arrows
+
+
+def _rect_for_arrow(arrow: dict, rects: list[dict], used: set[int]) -> dict | None:
+    dr, dc = arrow["dir"]
