+def _mode_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int) -> Iterable[tuple[int, int]]:
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _normalize_component(points: list[tuple[int, int]]) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(points)
+    arr = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    for r, c in points:
+        arr[r - r0, c - c0] = 1
+    return arr
+
+
+def _find_rectangles(grid: np.ndarray, bg: int) -> list[dict]:
+    rects: list[dict] = []
+    for color in np.unique(grid):
+        color = int(color)
+        if color in {bg, ARROW_COLOR, FENCE_COLOR}:
+            continue
+        for pts in _components(grid == color):
+            r0, c0, r1, c1 = _bbox(pts)
+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            if h < 2 or w < 2:
+                continue
+            if len(pts) != h * w:
+                continue
+            if not np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == color):
+                continue
+            rects.append(
+                {
+                    "color": color,
+                    "r0": r0,
+                    "c0": c0,
+                    "r1": r1,
+                    "c1": c1,
+                    "h": h,
+                    "w": w,
+                }
