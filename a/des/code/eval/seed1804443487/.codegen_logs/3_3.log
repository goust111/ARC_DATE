+            vals = grid[r0 : r1 + 1, col]
+            if np.all(vals != bg) and np.any(vals == FENCE_COLOR) and not np.any(vals == ARROW_COLOR):
+                return ("col", col)
+    elif (dr, dc) == (1, 0):
+        for row in range(arrow["r1"] + 1, h):
