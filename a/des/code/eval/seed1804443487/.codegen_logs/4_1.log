+    frame_idx = max(border_components, key=lambda i: len(fg_components[i]))
+    frame_comp = fg_components[frame_idx]
+    frame_set = set(frame_comp)
+    frame_color = Counter(int(g[r, c]) for r, c in frame_comp).most_common(1)[0][0]
