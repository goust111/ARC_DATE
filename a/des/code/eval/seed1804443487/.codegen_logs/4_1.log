+    for hole in _components_mask(g == bg):
+        if _touches_border(hole, h, w):
+            continue
+        hole_set = set(hole)
+        boundary = set()
+        valid = True
+        for r, c in hole:
+            for nr, nc in _neighbors4(r, c):
+                if not (0 <= nr < h and 0 <= nc < w):
+                    continue
+                if (nr, nc) in hole_set or int(g[nr, nc]) == bg:
+                    continue
+                boundary.add((nr, nc))
+                if (nr, nc) not in frame_set:
