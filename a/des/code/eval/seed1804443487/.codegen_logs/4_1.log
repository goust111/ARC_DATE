+    out = g.copy()
+    blob_shapes = Counter()
+    for i, comp in enumerate(fg_components):
+        if i == frame_idx:
+            continue
+        blob_shapes[_canonical_shape(comp)] += 1
+        for r, c in comp:
+            out[r, c] = bg
