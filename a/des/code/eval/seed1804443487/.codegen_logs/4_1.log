+            left = 0
+        else:
+            left = w - frame_w
+        return top, left, top + frame_h - 1, left + frame_w - 1
+
+    frame_h = rng.randint(7, min(10, h - 8))
+    frame_w = rng.randint(max(10, w // 2), w - 2)
+    left = rng.randint(1, w - frame_w - 1)
