+        for variant in variants:
+            sh, sw = _shape_dims(variant)
+            for rr in range(1, h - sh):
+                for cc in range(1, w - sw):
+                    abs_cells = _translate_shape(variant, rr, cc)
+                    cell_set = set(abs_cells)
