+def _find_mix_map(grid: np.ndarray, bg: int, towers: list[dict[str, int]]) -> dict[tuple[int, int], int]:
+    tower_mask = np.zeros_like(grid, dtype=bool)
+    for tower in towers:
+        tower_mask[tower["r"] : tower["r"] + 2, tower["c"] : tower["c"] + 2] = True
