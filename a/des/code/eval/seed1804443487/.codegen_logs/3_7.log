+def _is_exact_tower(grid: np.ndarray, r: int, c: int, bg: int) -> bool:
+    h, w = grid.shape
+    if r + 1 >= h or c + 1 >= w:
+        return False
+    color = int(grid[r, c])
+    if color == bg:
+        return False
+    block = grid[r : r + 2, c : c + 2]
+    if not np.all(block == color):
+        return False
