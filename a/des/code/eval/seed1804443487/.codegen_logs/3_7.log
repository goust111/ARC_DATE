+    orientation = random.choice(("left", "top"))
+    layout = random.choice(("cross", "grid"))
+    tower_count = 4 if layout == "cross" else random.choice((3, 4))
+    tower_colors = random.sample([color for color in ALL_COLORS if color != bg], tower_count)
