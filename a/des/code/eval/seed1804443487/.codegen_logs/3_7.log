+    positions = [(rows[0], cols[0]), (rows[0], cols[1]), (rows[1], cols[0]), (rows[1], cols[1])]
+    if tower_count == 3:
+        missing = random.randrange(4)
+        positions = [pos for i, pos in enumerate(positions) if i != missing]
+    random.shuffle(positions)
+    return positions
