+    r0 = RESERVED_BAND + 1 if orientation == "top" else SCENE_MARGIN
+    c0 = RESERVED_BAND + 1 if orientation == "left" else SCENE_MARGIN
+    r1 = h - 2 - SCENE_MARGIN
+    c1 = w - 2 - SCENE_MARGIN
