+
+ALL_COLORS = tuple(range(10))
+SIZE_MIN = 14
+SIZE_MAX = 26
+TOWER_GAP = 3
+TABLE_GAP = 2
+SCENE_MARGIN = 1
+RESERVED_BAND = 4
+MAX_ATTEMPTS = 400
