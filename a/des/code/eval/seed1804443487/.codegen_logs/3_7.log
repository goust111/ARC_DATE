+    rr0, rr1 = max(0, r - 1), min(h, r + 3)
+    cc0, cc1 = max(0, c - 1), min(w, c + 3)
+    hood = grid[rr0:rr1, cc0:cc1] == color
+    hood = hood.copy()
+    hood[r - rr0 : r - rr0 + 2, c - cc0 : c - cc0 + 2] = False
+    return not bool(hood.any())
