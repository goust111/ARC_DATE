+        dr = random.randint(2, max_dr)
+        dc = random.randint(2, max_dc)
+        return [
+            (mid_r, mid_c - dc),
+            (mid_r, mid_c + dc),
+            (mid_r - dr, mid_c),
+            (mid_r + dr, mid_c),
