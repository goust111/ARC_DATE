+        interior_h, interior_w = _choose_interior_sizes(kind)
+        frame_specs.append(
+            {
+                "seed_color": int(entry["seed_color"]),
+                "pattern_color": int(entry["pattern_color"]),
+                "mask": np.asarray(entry["mask"], dtype=int).copy(),
+                "interior_h": interior_h,
