+                "outer_h": interior_h + 2,
+                "outer_w": interior_w + 2,
+            }
+        )
+
+    grid = np.full((grid_h, grid_w), BG_COLOR, dtype=int)
+    _render_legend(grid, legend_top, entries)
+    placed = _place_frames(grid, legend_top, frame_specs)
