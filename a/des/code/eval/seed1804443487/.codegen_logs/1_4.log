+    side = spec["side"]
+    gap_length = int(spec["gap_length"])
+
+    panel[top, left : left + w] = ring_color
+    panel[top + h - 1, left : left + w] = ring_color
+    panel[top : top + h, left] = ring_color
+    panel[top : top + h, left + w - 1] = ring_color
