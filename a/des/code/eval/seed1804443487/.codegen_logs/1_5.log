+            placed = True
+            break
+        if not placed:
+            return False
+
+    return True
+
+
+def _build_attempt() -> np.ndarray | None:
+    num_stamps = random.randint(2, 4)
+    force_conflict = bool(random.getrandbits(1))
+    masks = _sample_stamp_shapes(num_stamps, force_conflict)
+    if masks is None:
