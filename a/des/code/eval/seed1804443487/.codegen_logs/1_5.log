+def _unique_orientations(mask: np.ndarray) -> list[np.ndarray]:
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    out: list[np.ndarray] = []
+    for rot in range(4):
+        cur = np.rot90(mask, rot)
+        for variant in (cur, np.fliplr(cur)):
+            key = (tuple(map(int, variant.shape)), variant.tobytes())
+            if key not in seen:
