+        stamps.append(
+            {
+                "bbox": comp["bbox"],
+                "mask": mask,
+                "rel": rel,
+                "area": int(comp["area"]),
+                "color": int(comp["colors"][0]),
+            }
+        )
+
+    stamps.sort(
+        key=lambda s: (
+            -int(s["area"]),
+            int(s["bbox"][0]),
+            int(s["bbox"][1]),
+            int(s["bbox"][2]),
+            int(s["bbox"][3]),
