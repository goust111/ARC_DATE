+            grid_slice = grid[top : top + ph, left : left + pw]
+            if np.any(grid_slice[stamp_mask] != BG):
+                continue
+            grid_slice[stamp_mask] = patch[stamp_mask]
+            grid[top : top + ph, left : left + pw] = grid_slice
