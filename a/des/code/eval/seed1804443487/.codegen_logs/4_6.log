+        )
+    return parts
+
+
+def _factor_pairs(area: int) -> list[tuple[int, int]]:
+    pairs: set[tuple[int, int]] = set()
+    for h in range(1, int(area**0.5) + 1):
+        if area % h == 0:
+            w = area // h
+            pairs.add((int(h), int(w)))
+            pairs.add((int(w), int(h)))
