+            board = np.zeros((h, w), dtype=bool)
+
+            def backtrack(depth: int) -> None:
+                if len(solutions) > 1:
+                    return
+                if depth == len(order):
+                    holes = np.argwhere(~board)
+                    if holes.shape[0] != missing:
