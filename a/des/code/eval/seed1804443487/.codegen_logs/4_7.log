+        ir0, ic0, ir1, ic1 = frame["interior"]
+        interior = out[ir0 : ir1 + 1, ic0 : ic1 + 1]
+        area = int(np.sum(interior == bg))
+        assert 1 <= area <= len(palette), "palette must cover the enclosed area"
