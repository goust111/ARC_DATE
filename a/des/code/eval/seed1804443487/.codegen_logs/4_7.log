+    inner_h: int,
+    inner_w: int,
+    gap_width: int,
+    start: int,
+) -> list[tuple[int, int]]:
+    outer_h = inner_h + 2
+    outer_w = inner_w + 2
+    transformed = []
+    for r, c in coords:
+        if side == "top":
+            transformed.append((r, start + c))
+        elif side == "bottom":
+            transformed.append((outer_h - 1 - r, start + c))
+        elif side == "left":
