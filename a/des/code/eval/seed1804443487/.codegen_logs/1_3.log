from __future__ import annotations

from dataclasses import dataclass

import numpy as np


BG = 0
END_COLOR = 7
START_COLOR = 9
ROOM_COLOR_POOL = (1, 2, 3, 4, 5, 6, 8)

MIN_ROOMS = 3
MAX_ROOMS = 6
INTERIOR_MIN = 3
INTERIOR_MAX = 6
OUTER_PAD_MIN = 1
OUTER_PAD_MAX = 3
LAYOUT_TRIES = 120
GEN_TRIES = 300


@dataclass(frozen=True)
class Room:
