+    wall_mask = (grid != BG) & (grid != START_COLOR) & (grid != END_COLOR)
+    wall_ps = _integral(wall_mask)
+    found: list[tuple[int, int, int, int, int, tuple[tuple[int, int], ...]]] = []
+
+    for r0 in range(h - 2):
