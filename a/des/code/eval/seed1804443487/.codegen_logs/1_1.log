+    def search(used_forbidden: set[tuple[int, int]], remaining: set[int]) -> bool:
+        if not remaining:
+            return True
+        best_i = None
+        best_options = None
+        for idx in sorted(remaining):
+            options = [cand for cand in cand_lists[idx] if cand["occ"].isdisjoint(used_forbidden)]
+            if not options:
