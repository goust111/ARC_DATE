+    norm = tuple(sorted((r - r0, c - c0, int(col)) for r, c, col in cells))
+    h = max(r for r, _, _ in norm) + 1
+    w = max(c for _, c, _ in norm) + 1
+    return norm, int(h), int(w)
+
