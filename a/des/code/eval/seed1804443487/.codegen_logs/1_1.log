+
+        by_side: dict[str, tuple[tuple[int, int, int], ...]] = {}
+        ok = True
+        for rot in rotations:
+            _anchor, rot_sides, _rh, _rw = _anchor_info(rot, anchor_color)
+            if len(rot_sides) != 1 or rot_sides[0] in by_side:
+                ok = False
