+        border = np.zeros((h, w), dtype=bool)
+        border[0, :] = True
+        border[-1, :] = True
+        border[:, 0] = True
+        border[:, -1] = True
+        if np.array_equal(sub, border):
+            candidates.append((len(comp), r0, c0, r1, c1))
