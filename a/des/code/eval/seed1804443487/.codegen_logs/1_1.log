+    assert len(pts) == 1, "piece must contain one anchor pixel"
+    r, c = pts[0]
+    sides = []
+    if r == 0:
+        sides.append("top")
+    if r == h - 1:
+        sides.append("bottom")
+    if c == 0:
+        sides.append("left")
+    if c == w - 1:
