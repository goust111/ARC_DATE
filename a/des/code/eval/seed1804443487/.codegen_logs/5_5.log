+    if len(solved) != 1:
+        return None
+
+    # The generator should only emit instances that the actual solver interprets identically.
+    expected = _build_expected(grid, placements, colors, comp_top, comp_left)
+    actual = main(grid)
+    if not np.array_equal(actual, expected):
+        return None
