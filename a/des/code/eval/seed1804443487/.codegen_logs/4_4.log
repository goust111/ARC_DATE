+        spec = mask_specs[idx]
+        crop = np.where(np.asarray(spec["mask_local"], dtype=bool), int(spec["mask_color"]), BG)
+        if layout == "row":
+            items.append({"row": 0, "col": idx, "crop": crop})
+        else:
+            items.append({"row": idx, "col": 0, "crop": crop})
