+def _mask_pattern(h: int, w: int, max_area: int) -> np.ndarray | None:
+    styles = np.array(["rect", "L", "stair", "T"], dtype=object)
+    for style in _RNG.permutation(styles):
+        mask = np.zeros((h, w), dtype=bool)
