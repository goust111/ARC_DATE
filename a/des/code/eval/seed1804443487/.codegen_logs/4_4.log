+        assert 0 <= idx < length, "separator index out of bounds"
+        if idx > start:
+            bands.append((start, idx))
+        start = idx + 1
+    if start < length:
+        bands.append((start, length))
+    assert bands, "separator lines must leave at least one panel"
+    return bands
