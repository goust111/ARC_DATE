+def _make_template() -> np.ndarray | None:
+    h = int(_RNG.integers(TEMPLATE_SIDE_MIN, TEMPLATE_SIDE_MAX + 1))
+    w = int(_RNG.integers(TEMPLATE_SIDE_MIN, TEMPLATE_SIDE_MAX + 1))
