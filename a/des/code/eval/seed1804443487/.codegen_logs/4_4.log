+def _apply_transform(mask: np.ndarray, transform_id: int) -> np.ndarray:
+    rotated = np.rot90(mask, transform_id % 4)
+    if transform_id >= 4:
+        rotated = np.fliplr(rotated)
+    return rotated.copy()
