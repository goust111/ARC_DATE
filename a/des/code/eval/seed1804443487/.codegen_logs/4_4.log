+
+
+def _panel_crops_from_specs(
+    layout: str,
+    ref_idx: int,
+    mask_specs: dict[int, dict[str, object]],
+) -> list[dict[str, object]]:
+    items: list[dict[str, object]] = []
+    for idx in range(len(mask_specs) + 1):
+        if idx == ref_idx:
