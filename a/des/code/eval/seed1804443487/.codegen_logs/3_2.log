+        row_colors: list[int] = []
+        ok = True
+        for r in range(r0, r1 + 1):
+            vals = {int(v) for v in grid[r, c0 : c1 + 1]}
+            if bg in vals or len(vals) != 1:
+                ok = False
+                break
+            row_colors.append(next(iter(vals)))
+        if not ok or len(set(row_colors)) != hh:
