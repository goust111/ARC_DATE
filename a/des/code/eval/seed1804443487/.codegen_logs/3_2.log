+        if not _legend_is_isolated(grid, bg, r0, c0, r1, c1):
+            continue
+
+        row_colors: list[int] = []
+        ok = True
+        for r in range(r0, r1 + 1):
+            vals = {int(v) for v in grid[r, c0 : c1 + 1]}
+            if bg in vals or len(vals) != 1:
+                ok = False
+                break
