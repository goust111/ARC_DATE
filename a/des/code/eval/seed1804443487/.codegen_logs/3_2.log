+    lc0 = int(legend_pts[:, 1].min())
+    lr1 = int(legend_pts[:, 0].max())
+    lc1 = int(legend_pts[:, 1].max())
+    if not _reserve(occupied, lr0, lc0, lr1 - lr0 + 1, lc1 - lc0 + 1, pad=2):
+        return None
