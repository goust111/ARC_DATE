+    assert len(candidates) == 1, "legend must be uniquely identifiable"
+    _, (r0, c0, r1, c1), row_colors = candidates[0]
+    legend_mask = np.zeros_like(grid, dtype=bool)
+    legend_mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    return row_colors, legend_mask
