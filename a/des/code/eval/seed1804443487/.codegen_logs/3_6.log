+    local = np.zeros((h, w), dtype=bool)
+    coords = component["coords"]
+    local[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    if not local[0, :].all():
+        return False
+    if not local[-1, :].all():
+        return False
