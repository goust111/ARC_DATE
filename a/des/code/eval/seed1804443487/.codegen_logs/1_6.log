+        placements.append(placement)
+        occupied_cells.update(placement["cells"])
+        ray_blockers.update(placement["box"])
+        arrow_halo.update(_expand(placement["box"], (h, w), pad=1))
+        previous_rays.update(placement["trace"]["painted"])
