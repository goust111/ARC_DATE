+    blockers = set(instruction_cells)
+    for color in sequence:
+        info = _arrow_info(g, color)
+        arrow_by_color[color] = info
+        blockers.update(info["cells"])
+
+    out = g.copy()
+    previous_rays: set[tuple[int, int]] = set()
+    traces: list[dict] = []
