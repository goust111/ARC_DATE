+
+        if nxt in blockers or nxt in painted_set:
+            return {
+                "painted": painted,
+                "turned": turned,
+                "post_turn_count": post_turn_count,
+                "pre_turn_count": len(painted) - post_turn_count,
+                "reason": "blocked",
+            }
