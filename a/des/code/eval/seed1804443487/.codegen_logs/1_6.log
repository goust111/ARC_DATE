+GEN_RETRIES = 400
+GRID_HEIGHT_RANGE = (12, 19)
+GRID_WIDTH_RANGE = (14, 23)
+ARROW_COUNT_RANGE = (5, 6)
+PALETTE = tuple(range(1, 10))
