+
+BG = 0
+
+UP = (-1, 0)
+RIGHT = (0, 1)
+DOWN = (1, 0)
+LEFT = (0, -1)
+
+CW_TURN = {
+    UP: RIGHT,
+    RIGHT: DOWN,
+    DOWN: LEFT,
+    LEFT: UP,
+}
+
+MISSING_TO_DIR = {
+    (0, 1): UP,
+    (0, 0): LEFT,
+    (1, 1): RIGHT,
+    (1, 0): DOWN,
+}
