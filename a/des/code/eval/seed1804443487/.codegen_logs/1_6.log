+    ray_blockers = set(instruction_cells)
+    arrow_halo: set[tuple[int, int]] = set()
+    previous_rays: set[tuple[int, int]] = set()
+    placements: list[dict] = []
+
+    for idx in range(count):
+        want_turn = idx >= 4
+        direction_order = directions[idx : idx + 1] if not want_turn else [UP, RIGHT, DOWN, LEFT]
+        if want_turn:
+            random.shuffle(direction_order)
