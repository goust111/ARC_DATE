+            "cells": arrow_cells,
+            "start": start,
+            "direction": direction,
+            "trace": trace,
+        }
+
+    candidates = [(r0, c0) for r0 in range(2, h - 2) for c0 in range(1, w - 2)]
+    random.shuffle(candidates)
+    for r0, c0 in candidates:
+        placement = try_box(r0, c0)
+        if placement is not None:
+            return placement
+
+    return None
+
+
+def _build_grid(
+    shape: tuple[int, int],
+    sequence_start: int,
+    colors: list[int],
+    placements: list[dict],
+) -> np.ndarray:
