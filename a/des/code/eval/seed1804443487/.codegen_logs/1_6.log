+    box = {(r0 + dr, c0 + dc) for dr in range(2) for dc in range(2)}
+    if min(r for r, _ in box) < 1:
+        return None
+    arrow_cells = box - {start}
+    return {
+        "box": box,
+        "cells": arrow_cells,
+        "start": start,
+        "direction": direction,
+    }
+
+
