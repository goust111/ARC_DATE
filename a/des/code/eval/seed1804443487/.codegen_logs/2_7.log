+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill each colored sampling frame with a rotated corner crop from the grey-framed source pattern.
+    """
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    out[out == RED] = BG
