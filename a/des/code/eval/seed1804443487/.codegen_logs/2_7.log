+def _crop_from_corner(src: np.ndarray, corner: str, height: int, width: int) -> np.ndarray:
+    if corner == "tl":
+        return src[:height, :width].copy()
+    if corner == "tr":
+        return src[:height, src.shape[1] - width :].copy()
+    if corner == "bl":
