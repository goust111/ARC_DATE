+        col = rng.choice(tuple(palette))
+        rh = rng.randint(1, max(1, height // 2))
+        rw = rng.randint(1, max(1, width // 2))
+        r0 = rng.randint(0, height - rh)
+        c0 = rng.randint(0, width - rw)
