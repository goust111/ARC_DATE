+        specs.append(
+            {
+                "corner": corner,
+                "side": side,
+                "color": color,
+                "inner_h": inner_h,
+                "inner_w": inner_w,
+            }
+        )
+
+    src = None
+    for _ in range(60):
+        candidate = _make_source_pattern(rng, src_h, src_w, source_colors)
+        signatures = set()
+        ok = True
+        for spec in specs:
+            patch = _crop_from_corner(
+                candidate,
+                str(spec["corner"]),
+                int(spec["inner_h"]),
+                int(spec["inner_w"]),
