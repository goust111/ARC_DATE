+def _find_frames(grid: np.ndarray) -> List[Dict[str, object]]:
+    frames: List[Dict[str, object]] = []
+    for color in np.unique(grid):
+        col = int(color)
+        if col in (BG, RED, GREY):
+            continue
+        for pts in _components(grid == col):
+            if not _is_rect_ring(pts):
