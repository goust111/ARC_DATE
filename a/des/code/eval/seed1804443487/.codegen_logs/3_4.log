+    for r in range(n_rows):
+        for c in range(n_cols):
+            top, left, bottom, right = _region_bounds(r, c, box)
+            if is_original[r, c]:
+                out[top + 1 : bottom, left + 1 : right] = rotated_originals[r][c]
+                continue
