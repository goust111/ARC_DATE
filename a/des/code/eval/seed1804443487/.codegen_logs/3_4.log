+            and int(np.count_nonzero(grid[r] == color)) > w // 2
+        ]
+        col_hits = [
+            c
+            for c in range(w)
+            if np.all((grid[:, c] == color) | (grid[:, c] == bg))
+            and int(np.count_nonzero(grid[:, c] == color)) > h // 2
