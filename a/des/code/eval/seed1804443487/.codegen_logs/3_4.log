+    if dr == -1 and dc == 0:
+        return side_a == "up" or side_b == "down"
+    if dr == 1 and dc == 0:
+        return side_a == "down" or side_b == "up"
+    if dr == 0 and dc == -1:
+        return side_a == "left" or side_b == "right"
+    if dr == 0 and dc == 1:
+        return side_a == "right" or side_b == "left"
+    raise ValueError((dr, dc))
