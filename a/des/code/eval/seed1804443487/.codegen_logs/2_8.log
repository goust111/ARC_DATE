+    h, w = mask.shape
+    grid[top : top + h, left : left + w][mask] = MAROON
+    marker_left = left + int(RNG.integers(0, w - decoration["count"] + 1))
+    grid[top + h, marker_left : marker_left + decoration["count"]] = YELLOW
