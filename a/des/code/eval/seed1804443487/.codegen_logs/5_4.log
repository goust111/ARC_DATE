+def _sample_spaced_values(start: int, stop: int, count: int, min_gap: int) -> list[int] | None:
+    values = list(range(start, stop))
+    if len(values) < count:
+        return None
+    for _ in range(200):
+        pool = values[:]
+        random.shuffle(pool)
+        chosen: list[int] = []
+        for value in pool:
+            if all(abs(int(value) - int(other)) >= min_gap for other in chosen):
+                chosen.append(int(value))
+                if len(chosen) == count:
+                    chosen.sort()
+                    return chosen
+    return None
