    in_heights = [int(sorted_heights[i]) for i in perm]
    inp = _draw_scene(n, base_r, base_color, bg, lefts, width, colors, in_heights)

    if np.array_equal(inp, out):
        return None
    if not np.array_equal(main(inp), out):
        return None
    return inp


