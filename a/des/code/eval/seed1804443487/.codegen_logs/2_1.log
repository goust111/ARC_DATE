    elif side == 'bottom':
        cols = list(range(c0 + 1, c1))
        random.shuffle(cols)
        for c in cols:
            border = (r1, c)
            outside = (r1 + 1, c)
            if outside not in occupied:
                return border, outside
    elif side == 'left':
        rows = list(range(r0 + 1, r1))
        random.shuffle(rows)
        for r in rows:
            border = (r, c0)
            outside = (r, c0 - 1)
            if outside not in occupied and 0 <= outside[1]:
                return border, outside
    elif side == 'right':
        rows = list(range(r0 + 1, r1))
        random.shuffle(rows)
        for r in rows:
            border = (r, c1)
            outside = (r, c1 + 1)
            if outside not in occupied:
