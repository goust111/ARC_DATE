+
+        lock = {
+            "color": int(pair["lock_meta"]["color"]),
+            "bbox": (r0, c0, r1, c1),
+            "side": side,
+            "gap_span": (c0 + gap0, c0 + gap1) if side in {"top", "bottom"} else (r0 + gap0, r0 + gap1),
+            "gap_width": int(pair["lock_meta"]["gap_width"]),
