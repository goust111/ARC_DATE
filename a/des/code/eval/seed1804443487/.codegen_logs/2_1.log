    return None, None


def _best_side(frame_bbox, target_r, target_c):
    """Determine which side of a frame is closest to a target point."""
    r0, c0, r1, c1 = frame_bbox
    cr = (r0 + r1) / 2
    cc = (c0 + c1) / 2
    dr = target_r - cr
    dc = target_c - cc

    if abs(dr) > abs(dc):
        return 'bottom' if dr > 0 else 'top'
    else:
        return 'right' if dc > 0 else 'left'


