+    shape = _sample_grid_shape(total_bbox_area, max_obj_h, max_obj_w)
+    if shape is None:
+        return None
+
+    boxes: list[tuple[int, int, int, int]] = []
+    for pair in pairs:
+        lock_pos = _place_patch(shape, pair["lock_patch"].shape, boxes)
+        if lock_pos is None:
