+            summary = _summary(trial)
+            if summary is None:
+                continue
+            if _mode_ok(summary, mode, require_prism_present=require_prism_present):
+                scene[:, :] = trial
+                used_colors.add(color)
+                return True
+    return False
+
+
+def _add_safe_marker(
+    scene: np.ndarray,
+    color: int,
+    forbidden_path: set[tuple[int, int]],
