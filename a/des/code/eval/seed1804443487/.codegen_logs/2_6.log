+        (r, c)
+        for r in range(h)
+        for c in range(w)
+        if (r, c) not in forbidden_path and _can_place_marker(scene, (r, c))
+    ]
+    random.shuffle(candidates)
+    if not candidates:
+        return False
+    scene[candidates[0]] = int(color)
+    return True
+
+
+def _build_scene() -> np.ndarray | None:
