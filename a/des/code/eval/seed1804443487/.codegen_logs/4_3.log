+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Find enclosed rooms, count same-colored corridor bars, then tile each room's stamp pattern.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg, _wall, rooms, room_mask = _extract_rooms(g)
