+        return None
+
+    palette = [c for c in range(1, 10)]
+    wall = rng.choice(palette)
+    palette.remove(wall)
+    if len(palette) < room_count:
+        return None
+    stamp_colors = rng.sample(palette, room_count)
+
+    grid = np.full((h, w), BG, dtype=int)
+    for room in rooms:
