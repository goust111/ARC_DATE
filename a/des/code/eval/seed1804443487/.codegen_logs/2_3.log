+            for rr, cc in coords:
+                frag_mask[rr - fr0, cc - fc0] = True
+            fragments[color] = {
+                "bbox": (fr0, fc0, fr1, fc1),
+                "mask": frag_mask,
+                "coords": coords,
+            }
