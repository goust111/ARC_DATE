+
+    local_holes = []
+    for sr0, sc0, sr1, sc1, region in segs:
+        if region["kind"] != "owner":
+            continue
+        hole_mask = region["spec"]["hole_mask"]
+        hh, hw = hole_mask.shape
+        top_lo = sr0 + 1
+        top_hi = sr1 - hh - 1
