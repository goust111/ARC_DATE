+def _region_spans(total: int, separators: list[int]) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    start = 0
+    for line in separators:
+        spans.append((start, line))
+        start = line + 1
+    spans.append((start, total))
+    return spans
