+
+def _render_expected(inp: np.ndarray, placements: list[dict[str, object]]) -> np.ndarray:
+    out = inp.copy()
+    for item in placements:
+        sr, sc = item["source_marker"]
+        tr, tc = item["target_marker"]
+        out[sr, sc] = BG
+        out[tr, tc] = BG
+    for item in placements:
