+import random
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+BG = 0
+SEPARATOR = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDE_TO_ROT = {"up": 0, "right": 3, "down": 2, "left": 1}
+SIDE_OFFSETS = {"up": (-1, 0), "right": (0, 1), "down": (1, 0), "left": (0, -1)}
