+        ph, pw = rotated.shape
+        top = item["target_marker"][0] - ph // 2
+        left = item["target_marker"][1] - pw // 2
+        _paint_mask(out, rotated, int(item["template_color"]), top, left)
+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
