+        left = rng.randint(1, sub_w - pw - 1)
+        dirs = rng.sample(["up", "right", "down", "left"], marker_count)
+        ok = True
+        for side in dirs:
+            dr, dc = SIDE_OFFSETS[side]
+            choices = _side_contacts(mask, side)
+            if not choices:
+                ok = False
+                break
