+def _equal_partition_size(total: int, separators: list[int]) -> int | None:
+    sizes: list[int] = []
+    prev = -1
+    for line in separators:
+        size = line - prev - 1
+        if size <= 0:
+            return None
+        sizes.append(size)
+        prev = line
+    tail = total - prev - 1
+    if tail <= 0:
+        return None
+    sizes.append(tail)
+    if len(set(sizes)) != 1:
+        return None
+    return sizes[0]
