+
+def _generate_case(rng: random.Random, scenario: str) -> tuple[np.ndarray, dict] | None:
+    h = rng.randint(12, 20)
+    w = rng.randint(12, 20)
+    palette = rng.sample(list(PIXEL_COLORS), rng.randint(3, 5))
