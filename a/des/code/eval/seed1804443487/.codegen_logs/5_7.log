+        return None
+    if not _points_inward(arrow["name"], r0, c0, h, w):
+        return None
+    if arrow["front_capacity"] < 2:
+        return None
+    return arrow
+
+
+def _detect_arrows(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
