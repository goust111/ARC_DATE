+
+
+def _register_arrow(arrow: dict, used_rows: set[int], used_cols: set[int]) -> None:
+    if arrow["name"] in ("right", "left"):
+        used_rows.add(arrow["center"][0])
+    else:
+        used_cols.add(arrow["center"][1])
+
+
+def _try_random_arrow(
