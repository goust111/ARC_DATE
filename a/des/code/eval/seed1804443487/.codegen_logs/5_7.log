+    elif name == "left":
+        tip = (r0 + 1, c0)
+        back_capacity = w - c0 - 3
+        front_capacity = c0
+        edge = "right"
+    elif name == "down":
+        tip = (r0 + 2, c0 + 1)
+        back_capacity = r0
+        front_capacity = h - r0 - 3
+        edge = "top"
+    else:
