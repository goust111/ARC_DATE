+
+
+def _points_inward(name: str, r0: int, c0: int, h: int, w: int) -> bool:
+    left_gap = c0
+    right_gap = w - c0 - 3
+    top_gap = r0
+    bottom_gap = h - r0 - 3
+    if name == "right":
+        return left_gap <= right_gap
+    if name == "left":
