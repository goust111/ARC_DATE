+
+    if scenario == "mixed":
+        if sum(1 for items in assignments.values() if items) < 2:
+            return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
