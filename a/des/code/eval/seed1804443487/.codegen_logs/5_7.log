+    elif edge == "right":
+        arrow = _arrow_from_bbox("left", center - 1, w - 3 - gap, h, w)
+    elif edge == "top":
+        arrow = _arrow_from_bbox("down", gap, center - 1, h, w)
+    else:
+        arrow = _arrow_from_bbox("up", h - 3 - gap, center - 1, h, w)
