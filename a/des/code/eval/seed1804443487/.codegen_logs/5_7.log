+        return _generate_tie_case(rng, h, w, palette)
+    if scenario == "cross":
+        return _generate_cross_case(rng, h, w, palette)
+    if scenario == "truncate":
+        return _generate_truncate_case(rng, h, w, palette)
+    return _generate_mixed_case(rng, h, w, palette)
