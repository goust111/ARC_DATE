+            claimants = _claimants(arrows, r, c)
+            if not claimants:
+                continue
+            best_idx = min(
+                claimants,
+                key=lambda item: (item[1], arrows[item[0]]["center"][0], arrows[item[0]]["center"][1]),
+            )[0]
