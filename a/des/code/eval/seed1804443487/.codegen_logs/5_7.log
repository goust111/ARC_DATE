+def _validate_generated(grid: np.ndarray, scenario: str, meta: dict) -> bool:
+    try:
+        arrows = _detect_arrows(grid)
+        if not arrows:
+            return False
+        assignments, owners = _collect_assignments(grid, arrows)
+        if sum(len(items) for items in assignments.values()) == 0:
+            return False
