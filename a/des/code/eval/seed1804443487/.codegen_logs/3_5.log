+        v_positions = _choose_vertical_positions((h, w), vertical_specs, 2, w // 2 - 3, 1, h // 3)
+        h_positions = _choose_horizontal_positions((h, w), horizontal_specs, h // 2, h - 3, w // 2 + 2, w - 3)
+        if v_positions is None or h_positions is None:
