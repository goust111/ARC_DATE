+
+def _fits(shape: tuple[int, int], cells: set[Cell]) -> bool:
+    h, w = shape
+    return all(0 <= r < h and 0 <= c < w for r, c in cells)
+
+
+def _expanded(cells: set[Cell]) -> set[Cell]:
