+
+def _abs_cells(spec: dict[str, object], origin: Cell) -> set[Cell]:
+    r0, c0 = origin
+    cells = {(r0 + r, c0 + c) for r, c in spec["cells"]}
+    for marker in spec["markers"]:
+        mr = r0 + int(marker["rel"][0])
+        mc = c0 + int(marker["rel"][1])
+        cells.add((mr, mc))
+    return cells
