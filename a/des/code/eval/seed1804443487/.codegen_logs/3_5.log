+        hi = min(8, box_h * box_w - 1)
+        if lo > hi:
+            continue
+        target = random.randint(lo, hi)
+
+        cells = {(random.randrange(box_h), random.randrange(box_w))}
+        frontier = {
+            nbr
+            for nbr in _neighbors4(*next(iter(cells)), (box_h, box_w))
+            if nbr not in cells
