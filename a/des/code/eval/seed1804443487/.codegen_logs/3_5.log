+    cur = c_min + extras[0]
+    for idx, spec in enumerate(specs):
+        placements.append((band_r, cur))
+        cur += int(spec["width"])
+        if idx + 1 < len(specs):
+            cur += PACK_GAP + extras[idx + 1]
+    return placements
