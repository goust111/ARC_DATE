+
+
+def _gen_attempt() -> np.ndarray | None:
+    mode = random.choice(("vertical", "horizontal", "mixed"))
+    if mode == "mixed":
+        h = random.randint(20, GRID_MAX)
+        w = random.randint(20, GRID_MAX)
