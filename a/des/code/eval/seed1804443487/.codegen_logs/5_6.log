+    for color, bbox, key in _parse_objects(g):
+        r0, c0, r1, c1 = bbox
+        direction = _direction_from_key(key, bbox)
+
+        out[key] = BG
+        out[r0 + 1 : r1, c0 + 1 : c1] = color
+
+        if direction == "up":
+            out[r0, c0 : c1 + 1] = BG
+        elif direction == "down":
+            out[r1, c0 : c1 + 1] = BG
+        elif direction == "left":
+            out[r0 : r1 + 1, c0] = BG
+        else:
+            out[r0 : r1 + 1, c1] = BG
+
+    return out
+
+
+def _ring_cells(r0: int, c0: int, h: int, w: int) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for c in range(c0, c0 + w):
+        cells.add((r0, c))
+        cells.add((r0 + h - 1, c))
+    for r in range(r0, r0 + h):
+        cells.add((r, c0))
+        cells.add((r, c0 + w - 1))
+    return cells
+
+
+def _sample_key(
+    rng: random.Random,
+    h: int,
+    w: int,
+    bbox: tuple[int, int, int, int],
+    direction: str,
+) -> tuple[int, int] | None:
+    r0, c0, r1, c1 = bbox
+    offset = rng.randint(KEY_OFFSET_MIN, KEY_OFFSET_MAX)
+
+    if direction == "up":
+        kr = r0 - offset
+        if kr < 0:
+            return None
+        low = max(0, c0 - 1)
+        high = min(w - 1, c1 + 1)
+        return kr, rng.randint(low, high)
+    if direction == "down":
+        kr = r1 + offset
+        if kr >= h:
+            return None
+        low = max(0, c0 - 1)
+        high = min(w - 1, c1 + 1)
+        return kr, rng.randint(low, high)
+    if direction == "left":
+        kc = c0 - offset
+        if kc < 0:
+            return None
+        low = max(0, r0 - 1)
+        high = min(h - 1, r1 + 1)
+        return rng.randint(low, high), kc
+
+    kc = c1 + offset
+    if kc >= w:
+        return None
+    low = max(0, r0 - 1)
+    high = min(h - 1, r1 + 1)
+    return rng.randint(low, high), kc
