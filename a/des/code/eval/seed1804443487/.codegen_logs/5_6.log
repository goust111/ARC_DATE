+    if direction == "down":
+        kr = r1 + offset
+        if kr >= h:
+            return None
+        low = max(0, c0 - 1)
+        high = min(w - 1, c1 + 1)
+        return kr, rng.randint(low, high)
+    if direction == "left":
+        kc = c0 - offset
+        if kc < 0:
+            return None
+        low = max(0, r0 - 1)
+        high = min(h - 1, r1 + 1)
+        return rng.randint(low, high), kc
+
+    kc = c1 + offset
+    if kc >= w:
+        return None
+    low = max(0, r0 - 1)
+    high = min(h - 1, r1 + 1)
+    return rng.randint(low, high), kc
+
+
