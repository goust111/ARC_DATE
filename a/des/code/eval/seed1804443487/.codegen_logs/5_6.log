+    center_c = (c0 + c1) / 2.0
+    dr = kr - center_r
+    dc = kc - center_c
+    if abs(dr) > abs(dc):
+        return "up" if dr < 0 else "down"
+    if abs(dc) > abs(dr):
+        return "left" if dc < 0 else "right"
+
+    candidates: list[tuple[int, str]] = []
+    if dr <= 0:
+        candidates.append((abs(kr - r0), "up"))
+    if dr >= 0:
+        candidates.append((abs(kr - r1), "down"))
+    if dc <= 0:
