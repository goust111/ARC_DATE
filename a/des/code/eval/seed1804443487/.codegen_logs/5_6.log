+    rs = [r for r, _ in occupied]
+    cs = [c for _, c in occupied]
+    r0 = max(0, min(rs) - 1)
+    r1 = min(h - 1, max(rs) + 1)
+    c0 = max(0, min(cs) - 1)
+    c1 = min(w - 1, max(cs) + 1)
