+    center_r = (r0 + r1) / 2.0
+    center_c = (c0 + c1) / 2.0
+    dr = kr - center_r
+    dc = kc - center_c
+    if abs(dr) > abs(dc):
+        return "up" if dr < 0 else "down"
+    if abs(dc) > abs(dr):
