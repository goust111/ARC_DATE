+    inner_h = r1 - r0 + 1
+    inner_w = c1 - c0 + 1
+    dr, dc = _center_mask(scaled, inner_h, inner_w)
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    sub = patch[dr : dr + scaled.shape[0], dc : dc + scaled.shape[1]]
