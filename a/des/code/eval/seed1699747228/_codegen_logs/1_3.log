+        return [1] * count
+    if random.random() < 0.25:
+        return [1] * count
+    scales = [random.randint(1, max_factor) for _ in range(count)]
+    scales[random.randrange(count)] = 1
+    if max(scales) == 1:
+        scales[random.randrange(count)] = max_factor
+    return scales
