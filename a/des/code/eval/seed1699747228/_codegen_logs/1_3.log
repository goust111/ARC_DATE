+    if big_case:
+        return random.randint(2, 3), 3, 3
+    if slot_rows == 3:
+        base_h = random.randint(2, 3)
+    else:
+        base_h = random.randint(3, 4)
+    if slot_cols == 3:
+        base_w = 3
+    else:
+        base_w = random.randint(3, 4)
+    return base_h, base_w, 2
