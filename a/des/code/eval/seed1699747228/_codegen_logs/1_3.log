+            out[r_start : r_end + 1, col] = FRAME
+
+    if not np.array_equal(main(inp), out):
+        return None
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        case = _make_case()
+        if case is not None:
+            return case[0]
+    raise RuntimeError("failed to generate a valid puzzle instance")

