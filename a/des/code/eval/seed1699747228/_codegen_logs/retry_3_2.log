+
+def _build_open_mask(grid: np.ndarray, fragments: list[dict[str, int | str]]) -> np.ndarray:
+    mask = grid == BLACK
+    for frag in fragments:
+        mask[int(frag["row"]), int(frag["col"])] = True
+    return mask
