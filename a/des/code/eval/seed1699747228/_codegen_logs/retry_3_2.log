+def _is_yellow_elbow(comp: list[tuple[int, int]]) -> bool:
+    if len(comp) != 3:
+        return False
+    rows = [r for r, _ in comp]
+    cols = [c for _, c in comp]
+    return max(rows) - min(rows) == 1 and max(cols) - min(cols) == 1
