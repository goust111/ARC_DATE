+        tail_len = rng.randint(*TAIL_LENGTH_RANGE)
+        mask = _object_mask(body_h, body_w, direction, tail_len)
+        objects.append(
+            {
+                "color": int(color),
+                "direction": direction,
+                "body_w": int(body_w),
+                "body_h": int(body_h),
+                "area": int(body_w * body_h),
+                "mask": mask,
+            }
+        )
