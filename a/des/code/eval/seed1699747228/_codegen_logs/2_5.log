+    if direction == "down":
+        mask = np.zeros((body_h + tail_len, body_w), dtype=bool)
+        mask[:body_h, :] = True
+        mask[body_h:, body_w // 2] = True
+        return mask
+    if direction == "left":
+        mask = np.zeros((body_h, body_w + tail_len), dtype=bool)
+        mask[:, tail_len:] = True
+        mask[body_h // 2, :tail_len] = True
+        return mask
+
+    mask = np.zeros((body_h, body_w + tail_len), dtype=bool)
+    mask[:, :body_w] = True
+    mask[body_h // 2, body_w:] = True
+    return mask
