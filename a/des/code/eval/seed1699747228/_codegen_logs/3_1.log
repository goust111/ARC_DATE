+            break
+        if not placed:
+            return None
+
+    for spec, placement in zip(frame_specs, placements):
+        assert placement is not None
+        top, left = placement
+        _draw_frame(grid, top, left, spec)
+
+    if _most_common_color(grid) != bg:
+        return None
+    if not np.any(grid == MAROON):
+        return None
+    _ = main(grid)
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
