+def _region_patch(mask: np.ndarray, seed: tuple[int, int], seed_color: int, wall_color: int) -> np.ndarray:
+    h, w = mask.shape
+    patch = np.full((h + 2, w + 2), BG, dtype=int)
+    for r, c in np.argwhere(mask):
