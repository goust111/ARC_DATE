+
+def _same_color_component(g: np.ndarray, start: tuple[int, int], color: int) -> list[tuple[int, int]]:
+    h, w = g.shape
+    seen = {start}
+    q = deque([start])
+    comp: list[tuple[int, int]] = []
+    while q:
+        r, c = q.popleft()
+        comp.append((int(r), int(c)))
