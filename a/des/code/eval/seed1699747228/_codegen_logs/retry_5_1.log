+        seed_color = int(region["seed_color"])
+        colored = sum(int(expected[r, c]) == seed_color for r, c in cells)
+        blacks = sum(int(expected[r, c]) == BG for r, c in cells if (r, c) != seed)
+        if colored < 3 or blacks == 0:
