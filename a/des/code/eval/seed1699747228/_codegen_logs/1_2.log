+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 8
+FRAME = 5
+MARKER = 9
+BODY_COLORS = (0, 1, 2, 3, 4, 6, 7)
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+PAIR_COUNT_CHOICES = (2, 3)
+RECT_SIZES = tuple(
+    (h, w)
+    for h in range(4, 7)
+    for w in range(4, 8)
