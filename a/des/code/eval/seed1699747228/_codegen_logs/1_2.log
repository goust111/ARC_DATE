+                rr0 = max(0, r0 - 1)
+                cc0 = max(0, c0 - 1)
+                rr1 = min(rows, r0 + ph + 1)
+                cc1 = min(left_width, c0 + pw + 1)
+                if occ[rr0:rr1, cc0:cc1].any():
