+    assert len(body_colors) == 1, "fragment must have one body color"
+    return _make_piece(
+        shape,
+        marker=marker,
+        body_color=int(next(iter(body_colors))),
+        global_coords=tuple((int(r), int(c)) for r, c in coords),
