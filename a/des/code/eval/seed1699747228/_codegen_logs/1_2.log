+                    continue
+                candidates.append((int(r0), int(c0)))
+        if not candidates:
+            return None
+        r0, c0 = random.choice(candidates)
+        placements[idx] = (r0, c0)
+        occ[max(0, r0 - 1) : min(rows, r0 + ph + 1), max(0, c0 - 1) : min(left_width, c0 + pw + 1)] = True
