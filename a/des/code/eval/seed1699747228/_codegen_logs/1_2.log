+        if r1 - r0 < 2 or c1 - c0 < 2:
+            continue
+        sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+        border = np.zeros(sub.shape, dtype=bool)
+        border[0, :] = True
+        border[-1, :] = True
