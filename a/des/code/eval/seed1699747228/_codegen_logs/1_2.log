+    for frame_idx, option in assignment.items():
+        frame = frames[frame_idx]
+        ir0 = frame["bbox"][0] + 1
+        ic0 = frame["bbox"][1] + 1
+        piece_a = fragments[option["pieces"][0]]
+        piece_b = fragments[option["pieces"][1]]
+        _paint_piece(
+            out,
+            piece_a,
+            (ir0 + option["tiling"]["a_offset"][0], ic0 + option["tiling"]["a_offset"][1]),
