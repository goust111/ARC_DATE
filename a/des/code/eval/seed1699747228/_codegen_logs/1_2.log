+    for fragment in fragments:
+        coords = fragment["global_coords"]
+        assert coords is not None
+        rr = np.array([r for r, _ in coords], dtype=int)
+        cc = np.array([c for _, c in coords], dtype=int)
+        out[rr, cc] = BG
