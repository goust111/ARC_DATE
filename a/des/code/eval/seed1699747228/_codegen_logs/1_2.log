+    ar = tiling["a_offset"][0] + marker_a[0]
+    ac = tiling["a_offset"][1] + marker_a[1]
+    br = tiling["b_offset"][0] + marker_b[0]
+    bc = tiling["b_offset"][1] + marker_b[1]
