+        return []
+
+    out: list[dict] = []
+    placements_a = _placements(piece_a, rect_shape)
+    placements_b = _placements(piece_b, rect_shape)
+    for placed_a in placements_a:
+        for placed_b in placements_b:
+            if np.any(placed_a["mask"] & placed_b["mask"]):
