+    expected = grid.copy()
+    key_meta = {spec["index"]: spec for spec in key_specs}
+    for spec in key_specs:
+        mask = spec["mask"]
+        h, w = mask.shape
+        sub = expected[spec["top"] : spec["top"] + h, spec["left"] : spec["left"] + w]
+        sub[mask] = BG
+
+    for spec in chest_specs:
