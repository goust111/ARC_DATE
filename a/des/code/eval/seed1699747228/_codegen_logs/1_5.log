+        pattern = spec["pattern"]
+        pr, pc = spec["pattern_pos"]
+        transformed = _transform_pattern(pattern)
+        sub = expected[top + pr : top + pr + pattern.shape[0], left + pc : left + pc + pattern.shape[1]]
+        sub[:] = BG
+        sub[transformed] = color
+
+    return grid, expected
+
