+                "lock": lock,
+                "lock_abs": [(int(r0 + r), int(c0 + c)) for r, c in lock_coords],
+                "pattern_bbox": (int(r0 + pr0), int(c0 + pc0), int(r0 + pr1), int(c0 + pc1)),
+                "pattern": pattern,
