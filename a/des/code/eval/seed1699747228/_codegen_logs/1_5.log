+    chest_order = list(range(pair_count))
+    rng.shuffle(key_order)
+    rng.shuffle(chest_order)
+
+    key_specs = []
+    key_x = int(rng.integers(1, 4))
+    max_key_bottom = 0
+    for idx in key_order:
+        tooth = teeth[idx]
+        key_mask = np.vstack([np.ones((2, 2), dtype=bool), tooth])
