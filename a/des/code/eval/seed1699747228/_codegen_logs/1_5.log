+                "key_index": key_idx,
+                "top": top,
+                "left": left,
+                "height": chest_h,
+                "width": chest_w,
+                "lock_c0": lock_c0,
+                "tooth": tooth,
+                "pattern": pattern,
+                "pattern_pos": (pat_r, pat_c),
+            }
