+            c0 = int(rng.integers(min_col, w - pw))
+            rr0 = max(0, r0 - 1)
+            rr1 = min(h, r0 + ph + 1)
+            cc0 = max(0, c0 - 1)
+            cc1 = min(w, c0 + pw + 1)
+            if used[rr0:rr1, cc0:cc1].any():
+                continue
+            used[rr0:rr1, cc0:cc1] = True
+            positions[idx] = (r0, c0)
+            placed = True
+            break
+        if not placed:
+            return None
+    return [(int(r), int(c)) for r, c in positions if r is not None and c is not None]
+
