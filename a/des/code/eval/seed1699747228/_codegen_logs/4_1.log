+MAX_GEN_ATTEMPTS = 400
+RNG = np.random.default_rng()
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _local_mask(coords: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    out[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return out
+
+
+def _fill_holes(mask: np.ndarray) -> np.ndarray:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    outside = ~mask
+    reached = np.zeros((h, w), dtype=bool)
+    q = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if outside[r, c] and not reached[r, c]:
+                reached[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if outside[r, c] and not reached[r, c]:
+                reached[r, c] = True
+                q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and outside[nr, nc] and not reached[nr, nc]:
+                reached[nr, nc] = True
+                q.append((nr, nc))
+    holes = outside & ~reached
+    return mask | holes
+
+
+def _canonical_key(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    variants: list[tuple[tuple[int, int], bytes]] = []
+    for flip in (False, True):
+        base = np.fliplr(mask) if flip else mask
+        for k in range(4):
+            cur = np.rot90(base, k)
+            variants.append((tuple(map(int, cur.shape)), cur.astype(np.uint8).tobytes()))
+    return min(variants)
