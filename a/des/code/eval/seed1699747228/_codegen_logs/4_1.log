+    used = np.zeros((h, w), dtype=bool)
+    positions: list[tuple[int, int] | None] = [None] * len(patches)
+    order = sorted(range(len(patches)), key=lambda i: int(np.prod(patches[i].shape)), reverse=True)
+    for idx in order:
