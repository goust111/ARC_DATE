+def _make_object_instance(template: np.ndarray, color: int, parity: int, rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray]:
+    for _ in range(80):
+        rot = int(rng.integers(0, 4))
+        flip = bool(rng.integers(0, 2))
