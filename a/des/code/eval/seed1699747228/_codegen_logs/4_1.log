+def _tight_crop(grid: np.ndarray, bg: int) -> np.ndarray:
+    pts = np.argwhere(grid != int(bg))
+    assert pts.size > 0
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return grid[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]
