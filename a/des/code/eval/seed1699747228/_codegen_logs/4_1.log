+def _extract_legend_map(grid: np.ndarray, legend_bbox: tuple[int, int, int, int], outline_color: int, bg: int) -> dict[tuple[tuple[int, int], bytes], int]:
+    r0, c0, r1, c1 = legend_bbox
+    inner = grid[r0 + 1 : r1, c0 + 1 : c1]
