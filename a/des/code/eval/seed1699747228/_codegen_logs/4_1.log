+    inner_h = max(col_heights) + 2 * pad
+    inner_w = sum(col_widths) + col_gap * max(0, ncols - 1) + 2 * pad
+    frame = np.full((inner_h + 2, inner_w + 2), BLACK, dtype=int)
+    frame[0, :] = GRAY
+    frame[-1, :] = GRAY
+    frame[:, 0] = GRAY
+    frame[:, -1] = GRAY
