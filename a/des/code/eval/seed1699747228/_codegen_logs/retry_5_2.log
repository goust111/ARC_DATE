+                comp.append((cr, cc))
+                for dr, dc in DIRS8:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
