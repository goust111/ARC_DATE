+def _find_rooms(grid: np.ndarray) -> list[dict[str, object]]:
+    rooms: list[dict[str, object]] = []
+    for pts in _components_of_color(grid, ROOM):
+        r0, c0, r1, c1 = _bbox(pts)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 3 or w < 3:
+            continue
+        expected = 2 * h + 2 * w - 4
+        if len(pts) != expected:
