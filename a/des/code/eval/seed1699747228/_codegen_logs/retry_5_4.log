+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+PATH = 5
+ROOM = 9
+GREEN = 3
+ORANGE = 7
+SOURCE_COLORS = (1, 2, 4, 6, 8)
+
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+DIRS = (UP, DOWN, LEFT, RIGHT)
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _neighbors8(r: int, c: int) -> list[tuple[int, int]]:
+    return [
+        (r - 1, c - 1),
+        (r - 1, c),
+        (r - 1, c + 1),
+        (r, c - 1),
+        (r, c + 1),
+        (r + 1, c - 1),
+        (r + 1, c),
+        (r + 1, c + 1),
+    ]
+
+
+def _in_bounds(shape: tuple[int, int], cell: tuple[int, int]) -> bool:
+    r, c = cell
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _turn_right(direction: tuple[int, int]) -> tuple[int, int]:
+    return {
+        UP: RIGHT,
+        RIGHT: DOWN,
+        DOWN: LEFT,
+        LEFT: UP,
+    }[direction]
+
+
+def _turn_left(direction: tuple[int, int]) -> tuple[int, int]:
+    return {
+        UP: LEFT,
+        LEFT: DOWN,
+        DOWN: RIGHT,
+        RIGHT: UP,
+    }[direction]
+
+
+def _opposite(direction: tuple[int, int]) -> tuple[int, int]:
+    return (-direction[0], -direction[1])
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]] | set[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_rooms(grid: np.ndarray) -> list[dict[str, object]]:
+    rooms: list[dict[str, object]] = []
+    for pts in _components_of_color(grid, ROOM):
+        r0, c0, r1, c1 = _bbox(pts)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 3 or w < 3:
+            continue
+        expected = 2 * h + 2 * w - 4
+        if len(pts) != expected:
+            continue
+        border = set(pts)
+        ok = True
+        for rr in range(r0, r1 + 1):
+            for cc in range(c0, c1 + 1):
+                on_border = rr in (r0, r1) or cc in (c0, c1)
+                if on_border != ((rr, cc) in border):
