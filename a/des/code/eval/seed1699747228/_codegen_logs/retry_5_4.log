+            break
+        if not placed:
+            return None
+    return inp, out
+
+
+def _generate_case() -> tuple[np.ndarray, np.ndarray]:
+    for _ in range(300):
+        height = random.randint(24, 36)
+        width = random.randint(24, 36)
+        num_modules = random.choice((3, 4))
+        modes = ["green", "orange", "none"]
+        if num_modules == 4:
