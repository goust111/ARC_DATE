222: def _nozzle_span(plus_mask: np.ndarray, direction: tuple[int, int]) -> tuple[int, int]:
223:     """Return (start, end) inclusive of nozzle cells along the cross-axis."""
224:     dr, dc = direction
225:     if dc == 0:  # vertical ray -- cross-axis is columns
226:         row = plus_mask.shape[0] - 1 if dr == 1 else 0
227:         cols = np.where(plus_mask[row])[0]
228:         return int(cols[0]), int(cols[-1])
