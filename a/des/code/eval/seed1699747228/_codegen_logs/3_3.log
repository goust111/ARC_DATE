393: def _build_input_from_output(
394:     out: np.ndarray, pluses: list[dict], bg: int, rng: np.random.Generator,
395: ) -> np.ndarray:
396:     """Erase non-pre-extended rays from the output to produce the input."""
397:     # Pick the pre-extended ray (prefer longest, ideally >= _PRE_EXT_IDEAL_UNITS)
398:     pre_idx = max(range(len(pluses)), key=lambda i: pluses[i]["units"])
399:     if pluses[pre_idx]["units"] < _PRE_EXT_IDEAL_UNITS:
400:         candidates = [i for i, p in enumerate(pluses) if p["units"] >= _PRE_EXT_IDEAL_UNITS]
401:         if candidates:
402:             pre_idx = int(rng.choice(candidates))
403: 
404:     inp = out.copy()
