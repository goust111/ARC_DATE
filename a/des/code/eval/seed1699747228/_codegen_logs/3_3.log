235: def _build_seed_tile(
236:     plus_mask: np.ndarray,
237:     direction: tuple[int, int],
238:     palette: list[int],
239:     rng: np.random.Generator,
240: ) -> np.ndarray | None:
241:     """Build a seed tile whose cross-axis matches the nozzle span.
242: 
243:     Returns None if cross-span exceeds _SEED_MAX_CROSS.
244:     """
245:     s, e = _nozzle_span(plus_mask, direction)
246:     cross = e - s + 1
247:     if cross > _SEED_MAX_CROSS:
248:         return None
249:     along = int(rng.choice(_SEED_ALONG_CHOICES))
250:     if along == 1 and cross == 1:
251:         along = 2  # avoid degenerate 1x1
252: 
253:     dr, dc = direction
254:     th, tw = (along, cross) if dc == 0 else (cross, along)
255: 
256:     n_cells = th * tw
257:     max_k = min(_SEED_MAX_COLORS, n_cells, len(palette))
258:     n_colors = int(rng.integers(1, max_k + 1))
259:     chosen = list(rng.choice(palette, size=n_colors, replace=False))
260:     vals = list(chosen) + list(rng.choice(chosen, size=n_cells - n_colors, replace=True))
261:     rng.shuffle(vals)
262:     return np.array(vals, dtype=int).reshape(th, tw)
