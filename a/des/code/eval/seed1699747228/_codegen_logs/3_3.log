367:                 H, W, (r0, c0, r0 + ph - 1, c0 + pw - 1), plus_shape, d, tile
368:             )
369:             # Check no collision with existing occupancy
370:             if any(occ[r, c] != 0 for r, c, _ in cells if 0 <= r < H and 0 <= c < W):
371:                 continue
372: 
373:             # Commit: mark occupancy and paint
374:             for r, c in plus_cells:
