+        hi = min(sr1, dr1)
+        if lo > hi:
+            return False
+        c_start = dc1 + 1 if direction == "left" else sc1 + 1
+        c_end = sc0 - 1 if direction == "left" else dc0 - 1
+        for r in range(lo, hi + 1):
