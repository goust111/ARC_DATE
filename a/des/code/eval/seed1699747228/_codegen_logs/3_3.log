280: def _project_tile_coords(
281:     H: int, W: int,
282:     plus_bbox: tuple[int, int, int, int],
283:     plus_mask: np.ndarray,
284:     direction: tuple[int, int],
285:     tile: np.ndarray,
286: ) -> tuple[list[tuple[int, int, int]], int, int]:
287:     """Compute (r, c, value) list for the full projected ray (seed + repetitions).
288: 
289:     Returns (cells, seed_r0, seed_c0).
290:     """
291:     pr0, pc0, pr1, pc1 = plus_bbox
292:     dr, dc = direction
293:     th, tw = tile.shape
294:     s, _ = _nozzle_span(plus_mask, direction)
295: 
296:     # Anchor the first tile adjacent to the nozzle edge
297:     if dc == 0:  # vertical
298:         c0 = pc0 + s
299:         r0 = (pr1 + 1) if dr == 1 else (pr0 - th)
300:     else:  # horizontal
301:         r0 = pr0 + s
302:         c0 = (pc1 + 1) if dc == 1 else (pc0 - tw)
303: 
304:     # Generate cells by tiling outward
305:     cells: list[tuple[int, int, int]] = []
306:     if dc == 0:  # vertical (up or down)
307:         r = r0
308:         step = th if dr == 1 else -th
309:         while (r < H) if dr == 1 else (r + th > 0):
310:             for i in range(th):
311:                 rr = r + i
312:                 if 0 <= rr < H:
313:                     for j in range(tw):
314:                         cells.append((rr, c0 + j, int(tile[i, j])))
315:             r += step
316:     else:  # horizontal (left or right)
317:         c = c0
318:         step = tw if dc == 1 else -tw
319:         while (c < W) if dc == 1 else (c + tw > 0):
320:             for i in range(th):
321:                 for j in range(tw):
322:                     cc = c + j
323:                     if 0 <= cc < W:
324:                         cells.append((r0 + i, cc, int(tile[i, j])))
325:             c += step
326: 
327:     return cells, r0, c0
