+        elif direction == "right":
+            if dc0 <= sc1 or not _interval_overlap(sr0, sr1, dr0, dr1):
+                continue
+            dist = dc0 - sc1 - 1
+        elif direction == "up":
+            if dr1 >= sr0 or not _interval_overlap(sc0, sc1, dc0, dc1):
+                continue
+            dist = sr0 - dr1 - 1
+        else:
+            if dr0 <= sr1 or not _interval_overlap(sc0, sc1, dc0, dc1):
