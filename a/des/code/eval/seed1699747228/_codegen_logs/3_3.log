265: def _compute_ray_units(direction: tuple[int, int], tile: np.ndarray,
266:                        r0: int, c0: int, ph: int, pw: int, H: int, W: int) -> int:
267:     """Compute how many tile repetitions fit along the ray direction."""
268:     dr, dc = direction
269:     th, tw = tile.shape
270:     if dr == 1:
271:         return (H - (r0 + ph)) // th
272:     elif dr == -1:
273:         return r0 // th
274:     elif dc == 1:
275:         return (W - (c0 + pw)) // tw
276:     else:
277:         return c0 // tw
