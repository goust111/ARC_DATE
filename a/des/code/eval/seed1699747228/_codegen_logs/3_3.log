+            top = rng.randint(row_lo, row_hi)
+            left = rng.randint(col_lo, col_hi)
+            available = r1 - (top + n - 1) if direction == "down" else top - r0
+            if available < 4:
+                continue
+            gap = rng.randint(1, available - 3)
+            dye_left = rng.randint(left, left + n - 2)
+            if direction == "down":
+                dye_top = top + n + gap
+                ray = (top + n, r1, left, left + n - 1)
