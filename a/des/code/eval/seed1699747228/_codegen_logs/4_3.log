        for r, c in to_clear:
            out[r, c] = 0

        # Add isolated bottom-right corner if it has no 4-neighbor walls.
        br = (h - 1, w - 1)
        if out[br] == 0:
            if all(
                not (inb(nr, nc) and out[nr, nc] == 8)
                for nr, nc in neighbors4(br[0], br[1])
