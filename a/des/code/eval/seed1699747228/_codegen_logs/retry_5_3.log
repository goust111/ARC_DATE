+def _seal_grid(grid: np.ndarray, doors: list[tuple[str, int, int, int]]) -> np.ndarray:
+    sealed = grid.copy()
+    for kind, fixed, start, end in doors:
+        if kind == "h":
+            sealed[fixed, start : end + 1] = GREEN
+        else:
+            sealed[start : end + 1, fixed] = GREEN
