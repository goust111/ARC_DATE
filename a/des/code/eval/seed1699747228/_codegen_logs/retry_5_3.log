+        return False
+    if int(grid[r0 - 1, col]) != GREEN or int(grid[r1 + 1, col]) != GREEN:
+        return False
+    if int(grid[r0 - 2, col]) != GREEN or int(grid[r1 + 2, col]) != GREEN:
