+
+def _draw_segment(
+    path: list[tuple[int, int]],
+    end: tuple[int, int],
+) -> None:
+    r0, c0 = path[-1]
+    r1, c1 = end
+    if r0 == r1:
+        step = 1 if c1 > c0 else -1
+        for c in range(c0 + step, c1 + step, step):
+            path.append((r0, c))
+    else:
+        step = 1 if r1 > r0 else -1
+        for r in range(r0 + step, r1 + step, step):
+            path.append((r, c0))
+
+
+def _build_top_path(
+    endpoint_row: int,
+    endpoint_col: int,
+    width: int,
+) -> list[tuple[int, int]] | None:
+    max_turns = min(4, endpoint_row // 2 - 1)
+    if max_turns < 2:
+        return None
+    horizontal_count = random.randint(2, max_turns)
+    vertical_lengths = _random_composition(
+        endpoint_row,
+        horizontal_count + 1,
+        min_each=2,
+    )
+    row_levels = []
+    total = 0
+    for length in vertical_lengths:
+        total += length
+        row_levels.append(total)
