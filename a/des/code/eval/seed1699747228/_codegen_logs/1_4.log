+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < h:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < w:
+        out.append((r, c + 1))
+    return out
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _trace_path(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    assert coords
+    coord_set = set(coords)
+    degrees: dict[tuple[int, int], int] = {}
+    for r, c in coords:
+        degrees[(r, c)] = sum((nr, nc) in coord_set for nr, nc in _neighbors4(r, c, h, w))
+
+    endpoints = [cell for cell, degree in degrees.items() if degree == 1]
+    assert len(endpoints) == 2
+    border_endpoints = [
+        (r, c)
+        for r, c in endpoints
+        if r in (0, h - 1) or c in (0, w - 1)
+    ]
+    assert len(border_endpoints) == 1
+
+    start = border_endpoints[0]
+    ordered = [start]
+    prev: tuple[int, int] | None = None
+    cur = start
+    while True:
+        next_cells = [
+            nb
+            for nb in _neighbors4(cur[0], cur[1], h, w)
+            if nb in coord_set and nb != prev
+        ]
+        if not next_cells:
+            break
+        assert len(next_cells) == 1
+        nxt = next_cells[0]
+        ordered.append(nxt)
+        prev, cur = cur, nxt
+
+    assert len(ordered) == len(coords)
+    assert ordered[-1] in endpoints and ordered[-1] != start
+    return ordered
+
