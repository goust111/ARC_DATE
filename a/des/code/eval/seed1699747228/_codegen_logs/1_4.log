+    sequence: list[int] = []
+    seen: set[int] = set()
+    for i in range(1, len(path) - 1):
+        sides = _gate_sides(path[i - 1], path[i], path[i + 1], grid.shape)
+        if sides is None:
+            continue
+        (r1, c1), (r2, c2) = sides
+        color = int(grid[r1, c1])
+        if color == int(grid[r2, c2]) and color not in (BG, GREY, MAROON):
+            assert color not in seen
+            seen.add(color)
