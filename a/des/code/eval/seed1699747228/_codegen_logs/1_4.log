+def _gate_sides(
+    prev: tuple[int, int],
+    cur: tuple[int, int],
+    nxt: tuple[int, int],
+    shape: tuple[int, int],
+) -> tuple[tuple[int, int], tuple[int, int]] | None:
+    h, w = shape
+    r, c = cur
+    if prev[0] == nxt[0]:
+        if 0 < r < h - 1:
+            return (r - 1, c), (r + 1, c)
+        return None
+    if prev[1] == nxt[1]:
+        if 0 < c < w - 1:
+            return (r, c - 1), (r, c + 1)
+        return None
+    return None
