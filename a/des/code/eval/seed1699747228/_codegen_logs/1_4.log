+    endpoints = [cell for cell, degree in degrees.items() if degree == 1]
+    assert len(endpoints) == 2
+    border_endpoints = [
+        (r, c)
+        for r, c in endpoints
+        if r in (0, h - 1) or c in (0, w - 1)
