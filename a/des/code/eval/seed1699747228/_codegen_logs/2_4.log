+
+def _boundary_pixels(coords: list[tuple[int, int]]) -> set[tuple[int, int]]:
+    pts = set(coords)
+    boundary: set[tuple[int, int]] = set()
+    for r, c in coords:
+        for dr, dc in DIR4:
+            if (r + dr, c + dc) not in pts:
