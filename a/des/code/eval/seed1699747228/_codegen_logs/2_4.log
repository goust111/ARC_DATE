+def _parse_legend(grid: np.ndarray) -> tuple[list[dict], np.ndarray]:
+    h, w = grid.shape
+    grey_comps = _component_list(grid == GREY, connectivity=8)
+    assert grey_comps, "expected grey outline entries on the right"
