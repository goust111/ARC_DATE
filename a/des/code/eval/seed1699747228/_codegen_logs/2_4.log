+def _fill_outline(outline: np.ndarray) -> np.ndarray:
+    h, w = outline.shape
+    outside = np.zeros((h, w), dtype=bool)
+    queue: deque[tuple[int, int]] = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if not outline[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                queue.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not outline[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                queue.append((r, c))
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in DIR4:
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w and not outline[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                queue.append((nr, nc))
+    return outline | ~outside
