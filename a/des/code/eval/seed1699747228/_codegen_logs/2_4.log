+def _outline_of(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = np.zeros((h, w), dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            for dr, dc in DIR4:
+                nr = r + dr
+                nc = c + dc
+                if not (0 <= nr < h and 0 <= nc < w) or not mask[nr, nc]:
+                    out[r, c] = True
+                    break
+    return out
