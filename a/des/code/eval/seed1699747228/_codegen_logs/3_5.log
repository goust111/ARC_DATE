+    for comp in _components(grid == GREY, connectivity=8):
+        diffs = {r - c for r, c in comp}
+        sums = {r + c for r, c in comp}
+        if len(diffs) == 1:
+            kind = "\\"
+        elif len(sums) == 1:
+            kind = "/"
+        else:
+            raise AssertionError("grey component is not a diagonal mirror")
+        for cell in comp:
+            mirrors[cell] = kind
+    return mirrors
