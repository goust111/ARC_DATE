+
+def _targets(grid: np.ndarray) -> tuple[list[list[tuple[int, int]]], dict[tuple[int, int], int]]:
+    groups = _components(grid == ORANGE, connectivity=4)
+    by_cell: dict[tuple[int, int], int] = {}
+    for idx, comp in enumerate(groups):
