+
+
+def _choice_range(lo: int, hi: int) -> list[int]:
+    if lo > hi:
+        return []
+    return list(range(lo, hi + 1))
+
+
+def _random_target_rows(hit_row: int, height: int, grid_h: int) -> list[int]:
+    lo = max(1, hit_row - height + 1)
+    hi = min(hit_row, grid_h - height - 2)
