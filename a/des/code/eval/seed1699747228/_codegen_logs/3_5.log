+def _mirror_kinds(grid: np.ndarray) -> dict[tuple[int, int], str]:
+    mirrors: dict[tuple[int, int], str] = {}
+    for comp in _components(grid == GREY, connectivity=8):
+        diffs = {r - c for r, c in comp}
+        sums = {r + c for r, c in comp}
+        if len(diffs) == 1:
+            kind = "\\"
+        elif len(sums) == 1:
+            kind = "/"
+        else:
