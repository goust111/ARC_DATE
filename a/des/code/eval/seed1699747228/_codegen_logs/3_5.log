+def _source_direction(r: int, c: int, h: int, w: int) -> tuple[int, int]:
+    on_top = r == 0
+    on_bottom = r == h - 1
+    on_left = c == 0
+    on_right = c == w - 1
+    sides = int(on_top) + int(on_bottom) + int(on_left) + int(on_right)
+    assert sides == 1, "sources must be on a unique edge"
