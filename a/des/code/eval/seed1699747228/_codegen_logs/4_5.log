+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 8
+YELLOW = 4
+MAROON = 9
+ORANGE = 7
+REGION_COLORS = [0, 1, 2, 3, 5, 6]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_H_RANGE = (15, 22)
+GRID_W_RANGE = (15, 22)
+REGION_COUNT_RANGE = (2, 4)
