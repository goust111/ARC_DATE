+            line: list[tuple[int, int]] = []
+            tr, tc = yr + dr, yc + dc
+            while (
+                len(line) < MAX_COUNTER
+                and _in_bounds(h, w, tr, tc)
+                and int(grid[tr, tc]) == BG
+            ):
+                line.append((tr, tc))
+                tr += dr
+                tc += dc
+            if not line:
