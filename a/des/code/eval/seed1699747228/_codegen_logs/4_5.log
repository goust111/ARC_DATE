+    best_dist = np.full((h, w), 10**9, dtype=int)
+    best_order = np.full((h, w), 10**9, dtype=int)
+    best_color = np.full((h, w), -1, dtype=int)
+
+    for order, source in enumerate(_extract_sources(g)):
+        region = set(source["region"])
