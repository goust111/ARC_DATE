+    c0, c1 = min(cols), max(cols)
+    if r1 - r0 + 1 < 3 or c1 - c0 + 1 < 3:
+        return None
+    if len(cells) >= (r1 - r0 + 1) * (c1 - c0 + 1):
+        return None
+
+    mask = np.zeros((bh, bw), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
