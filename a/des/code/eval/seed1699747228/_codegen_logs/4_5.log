+def _random_region_mask(rng: random.Random) -> np.ndarray | None:
+    bh = rng.randint(*REGION_BBOX_RANGE)
+    bw = rng.randint(*REGION_BBOX_RANGE)
+    area_max = bh * bw - 2
+    if area_max < REGION_AREA_MIN:
+        return None
