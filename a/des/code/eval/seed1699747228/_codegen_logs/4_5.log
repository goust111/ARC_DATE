+def _choose_counter_length(max_len: int, rng: random.Random) -> int:
+    choices = list(range(1, min(MAX_COUNTER, max_len) + 1))
+    short = [n for n in choices if n <= 2]
+    long = [n for n in choices if n >= 3]
