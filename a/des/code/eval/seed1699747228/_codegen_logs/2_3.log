+    rng.shuffle(shuffled_regions)
+
+    for region, count in zip(shuffled_regions, counts):
+        cells = _interior_cells(region)
+        if len(cells) < count:
+            return None
+        for r, c in _choose_seed_cells(cells, count, rng):
+            grid[r, c] = SEED
