+            for i, (r1, c1) in enumerate(candidate)
+            for r2, c2 in candidate[i + 1 :]
+        )
+        if score > best_score:
+            best = candidate
+            best_score = score
+    return best
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
