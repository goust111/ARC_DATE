+    except AssertionError:
+        return None
+
+    if np.count_nonzero(out == SEED) != 0:
+        return None
+    if np.array_equal(out, grid):
+        return None
+
+    detected_regions = _region_components(grid, WALL, LEGEND)
+    if len(detected_regions) != len(regions):
+        return None
+
+    return grid

