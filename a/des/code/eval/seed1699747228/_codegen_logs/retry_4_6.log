+def _tower_cells(anchor: tuple[int, int], direction: str) -> list[tuple[int, int]]:
+    r0, c0 = anchor
+    missing = MISSING_BY_DIR[direction]
+    cells: list[tuple[int, int]] = []
+    for dr in range(2):
+        for dc in range(2):
