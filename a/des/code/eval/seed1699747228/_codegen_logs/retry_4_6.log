            region = _same_color_component(g, (rr, cc), color)
            candidates.append(
                {
                    "marker": (int(yr), int(yc)),
                    "color": color,
                    "layers": layers,
                    "region": region,
                }
            )

        if len(candidates) == 1:
            sources.append(candidates[0])

    sources.sort(key=lambda item: item["marker"])  # deterministic tie-break
