+
+BG = 0
+GREY = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS = {
+    "right": (0, 1),
+    "left": (0, -1),
+    "down": (1, 0),
+    "up": (-1, 0),
+}
+MISSING_BY_DIR = {
+    "right": (0, 1),
+    "left": (0, 0),
+    "down": (1, 0),
+    "up": (1, 1),
+}
+EMITTER_BY_DIR = {
+    "right": (1, 1),
+    "left": (1, 0),
+    "down": (1, 1),
+    "up": (0, 1),
