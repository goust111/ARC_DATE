+    out[legend] = g[legend]
+    return out, {
+        "legend_bbox": legend_bbox,
+        "legend_rows": legend_rows,
+        "legend_mask": legend,
+        "mapping": mapping,
+        "towers": towers,
+        "paths": paths,
+    }
