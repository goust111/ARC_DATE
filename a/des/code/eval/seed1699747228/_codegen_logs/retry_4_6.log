+def _candidate_cols(
+    w: int,
+    edge: str,
+    legend_bbox: tuple[int, int, int, int],
+    left_band: int,
+    right_band: int,
+    need_right: bool,
+    need_left: bool,
+) -> list[int]:
+    _, c0, _, c1 = legend_bbox
+    col_min = 2
+    col_max = w - 3
+    if need_right:
+        col_min = max(col_min, left_band + 4)
+    if need_left:
+        col_max = min(col_max, right_band - 2)
+    cols: list[int] = []
+    for c in range(col_min, col_max + 1):
+        if edge in ("top", "bottom") and c0 - 1 <= c <= c1 + 1:
+            continue
+        cols.append(c)
+    return cols
