+def _spaced_values(
+    candidates: list[int], count: int, rng: random.Random, min_gap: int = 4
+) -> list[int] | None:
+    if count == 0:
+        return []
+    if count == 1:
+        if not candidates:
+            return None
+        return [rng.choice(candidates)]
+    pairs = [
+        (a, b)
+        for i, a in enumerate(candidates)
+        for b in candidates[i + 1 :]
+        if b - a >= min_gap
+    ]
+    if not pairs:
+        return None
+    pair = rng.choice(pairs)
+    return [pair[0], pair[1]]
