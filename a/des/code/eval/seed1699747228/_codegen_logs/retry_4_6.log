def _solve_with_fill(grid: np.ndarray) -> tuple[np.ndarray, set[tuple[int, int]]]:
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    base = g.copy()
    base[(base == YELLOW) | (base == MAROON)] = BG

    best_dist = np.full((h, w), 10**9, dtype=int)
