                    best_order[nr, nc] = order
                    best_color[nr, nc] = color

    out = base.copy()
    mask = best_color != -1
    out[mask] = best_color[mask]
    filled = {tuple(map(int, rc)) for rc in np.argwhere(mask)}
    return out, filled


