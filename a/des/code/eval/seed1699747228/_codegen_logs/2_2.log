+            sr, sc = (c, r) if swap_axes else (r, c)
+            h = row_heights[r]
+            w = col_widths[c]
+            slot_r0 = top_margin + sr * STEP
+            slot_c0 = left_margin + sc * STEP
+            piece = {
+                "id": color_idx,
+                "row": r,
+                "col": c,
+                "color": colors[color_idx],
+                "h": h,
+                "w": w,
+                "r0": slot_r0 + (CELL - h) // 2,
+                "c0": slot_c0 + (CELL - w) // 2,
