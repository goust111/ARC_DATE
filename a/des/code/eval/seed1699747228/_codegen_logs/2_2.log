+
+BLACK = 0
+GREY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+
+CELL = 4
+GAP = 3
+STEP = CELL + GAP
+GEN_RETRIES = 300
+LAYOUTS = ((2, 2), (2, 3), (3, 2))
