+def _nearest_up(pieces: Sequence[Piece], row: int, col: int) -> Piece | None:
+    candidates = [p for p in pieces if p["r1"] < row and p["c0"] <= col <= p["c1"]]
+    return max(candidates, key=lambda p: p["r1"]) if candidates else None
