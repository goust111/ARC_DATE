+def _find_frame_bbox(grid: np.ndarray, separator_row: int) -> Tuple[int, int, int, int]:
+    lower = grid[separator_row + 1 :, :]
+    candidates = []
+    for comp in _components(lower == GREY):
+        r0, c0, r1, c1 = _bbox(comp)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 3 or w < 3:
+            continue
+        if len(comp) != 2 * (h + w) - 4:
+            continue
+        ok = True
+        comp_set = set(comp)
+        for rr in range(r0, r1 + 1):
