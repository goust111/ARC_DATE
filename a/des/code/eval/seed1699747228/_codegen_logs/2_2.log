+
+def _nearest_down(pieces: Sequence[Piece], row: int, col: int) -> Piece | None:
+    candidates = [p for p in pieces if p["r0"] > row and p["c0"] <= col <= p["c1"]]
+    return min(candidates, key=lambda p: p["r0"]) if candidates else None
