+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            rows = [r for r, _ in coords]
+            cols = [c for _, c in coords]
+            rr0, rr1 = min(rows), max(rows)
+            cc0, cc1 = min(cols), max(cols)
+            mask = np.zeros((rr1 - rr0 + 1, cc1 - cc0 + 1), dtype=bool)
+            for r, c in coords:
+                mask[r - rr0, c - cc0] = True
+            out.append(
