+            queue = deque([(r0, c0)])
+            coords: list[tuple[int, int]] = []
+            while queue:
+                r, c = queue.popleft()
+                coords.append((r, c))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr = r + dr
+                    nc = c + dc
