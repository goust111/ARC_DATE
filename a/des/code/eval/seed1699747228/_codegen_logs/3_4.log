+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+AZURE = 8
+BROWN = 9
+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+DIGIT_TEMPLATES = {
+    1: np.array(
