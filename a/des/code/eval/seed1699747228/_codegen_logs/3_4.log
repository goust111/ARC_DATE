+def _sample_anchor_cells(rng: random.Random, points: list[tuple[int, int]], count: int) -> list[tuple[int, int]]:
+    pool = points[:]
+    rng.shuffle(pool)
+    chosen = [pool.pop()]
+    while len(chosen) < count:
+        best = None
+        best_score = -1
+        for pt in pool:
