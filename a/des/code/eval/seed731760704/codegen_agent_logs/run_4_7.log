+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+AZURE = 8
+SPRITE_COLORS = (1, 2, 3, 4, 5, 6, 7, 9)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+GEN_RETRIES = 300
+SHAPE_RETRIES = 500
+MODULE_RETRIES = 120
+PLACEMENT_RETRIES = 120
