def _gen_draw_frame(grid: np.ndarray, color: int) -> None:
    grid[[1, -1], :] = color
    grid[1:, [0, -1]] = color

def _gen_draw_outline(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int, color: int) -> None:
    grid[r0 : r1 + 1, [c0, c1]] = color
    grid[[r0, r1], c0 : c1 + 1] = color

