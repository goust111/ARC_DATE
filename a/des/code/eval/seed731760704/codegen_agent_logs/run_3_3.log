+    max_cols = max(
+        n
+        for n in range(3, 5)
+        if n * room_size + (n + 1) * gap <= 30
+    )
+    rows = rng.randint(3, max_rows)
+    cols = rng.randint(3, max_cols)
+    room_count = rng.randint(2, min(rows * cols, 6))
+    source_color = rng.choice(SIGNAL_COLORS)
+    target_type = rng.choice(BRANCH_TYPES)
