+def _direction_between(a: tuple[int, int], b: tuple[int, int]) -> str:
+    dr = int(b[0] - a[0])
+    dc = int(b[1] - a[1])
+    for name, (rr, cc) in DIRS.items():
+        if (dr, dc) == (rr, cc):
+            return name
