+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+SIGNAL_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+BRANCH_TYPES = ("all_narrow", "mixed", "all_wide")
+DIRS = {
+    "N": (-1, 0),
+    "S": (1, 0),
+    "W": (0, -1),
+    "E": (0, 1),
+}
+OPPOSITE = {"N": "S", "S": "N", "W": "E", "E": "W"}
+GEN_RETRIES = 400
