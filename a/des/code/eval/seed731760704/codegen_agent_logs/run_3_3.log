+            int(rec["offset"]),
+            int(rec["length"]),
+            rec["color"],
+            rng,
+        )
+
+    if not _validate_generated(grid, target_type, room_count):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid maze after retries")

