+def _slot_neighbors(slot: tuple[int, int], rows: int, cols: int) -> list[tuple[str, tuple[int, int]]]:
+    r, c = slot
+    out: list[tuple[str, tuple[int, int]]] = []
+    for name, (dr, dc) in DIRS.items():
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < rows and 0 <= nc < cols:
+            out.append((name, (nr, nc)))
+    return out
