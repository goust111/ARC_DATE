+    stub_recs: list[dict] = []
+    source_stub_id = 0
+    stub_recs.append(
+        {
+            "room": source_room,
+            "side": source_side,
+            "width": rng.choice([1, 2]),
+            "offset": None,
+            "length": rng.randint(2, gap),
+            "color": source_color,
+        }
+    )
