+    def walk_corridor(cid: int, from_room: int | None) -> None:
+        if cid in visited_corridors:
+            return
+        visited_corridors.add(cid)
+        if int(corridor_width[cid]) == 1:
+            _paint_black(out, corridor_cells[cid], source_color)
