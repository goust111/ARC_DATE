+            side
+            for side, _nb in _slot_neighbors(room, rows, cols)
+            if side not in room_links[room]
+        ]
+        if unused and len(room_links[room]) + len(unused) - 1 >= 2:
+            source_candidates.append(room)
+    if not source_candidates:
+        return None
