+            grid[rr0 + length - 1, cc0 + rng.randrange(width)] = color
+        return
+    if side == "W":
+        rr0 = r0 + offset
+        cc0 = c0 - length
+        grid[rr0 : rr0 + width, cc0:c0] = BLACK
