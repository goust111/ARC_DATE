+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+SIGNAL_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+BRANCH_TYPES = ("all_narrow", "mixed", "all_wide")
