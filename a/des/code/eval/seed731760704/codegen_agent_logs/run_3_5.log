+            cells = _build_object_cells(side, block_r, block_c, frame, rng)
+            if any(not (0 <= r < h and 0 <= c < w) for r, c in cells):
+                return None
+            if any(grid[r, c] != BLACK for r, c in cells):
+                return None
+            for r, c in cells:
+                grid[r, c] = color
+            object_cells[color] = cells
+            final_positions[color] = (final_r, final_c)
