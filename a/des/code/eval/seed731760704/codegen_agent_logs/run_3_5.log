+def _block_side(block_r: int, block_c: int, frame: tuple[int, int, int, int]) -> str:
+    fr0, fc0, fr1, fc1 = frame
+    if block_r + 1 < fr0:
+        return "top"
+    if block_r > fr1:
+        return "bottom"
+    if block_c + 1 < fc0:
+        return "left"
+    if block_c > fc1:
+        return "right"
+    raise ValueError("block is not outside the frame")
+
