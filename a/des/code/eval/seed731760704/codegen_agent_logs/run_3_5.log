+def _find_block(color_mask: np.ndarray) -> tuple[int, int]:
+    h, w = color_mask.shape
+    found: list[tuple[int, int]] = []
+    for r in range(h - 1):
+        for c in range(w - 1):
+            if color_mask[r : r + 2, c : c + 2].all():
+                found.append((r, c))
+    if not found:
+        raise ValueError("2x2 block not found")
+    return found[0]
