+    grid = np.full((h, w), BLACK, dtype=int)
+    fr0, fc0, fr1, fc1 = frame
+    grid[fr0, fc0 : fc1 + 1] = GREY
+    grid[fr1, fc0 : fc1 + 1] = GREY
+    grid[fr0 : fr1 + 1, fc0] = GREY
+    grid[fr0 : fr1 + 1, fc1] = GREY
