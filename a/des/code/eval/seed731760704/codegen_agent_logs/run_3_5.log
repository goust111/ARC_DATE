+    if side == "top":
+        return fr0 + 1, block_c
+    if side == "bottom":
+        return fr1 - 2, block_c
+    if side == "left":
+        return block_r, fc0 + 1
+    if side == "right":
+        return block_r, fc1 - 2
+    raise ValueError(side)
