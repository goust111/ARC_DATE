+    towers, prisms = _collect_objects(g, blocked_rows)
+    events: dict[tuple[int, int], list[tuple[int, int, int]]] = defaultdict(list)
+
+    queue: deque[tuple[int, int, int, int, int]] = deque()
+    for (r, c), color in sorted(towers.items()):
