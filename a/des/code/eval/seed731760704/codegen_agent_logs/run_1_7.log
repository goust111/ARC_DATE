+    inner_r1, inner_c1 = canvas_r1, canvas_c1
+    canvas_h = inner_r1 - inner_r0
+    canvas_w = inner_c1 - inner_c0
+    out[inner_r0:inner_r1, inner_c0:inner_c1] = BLACK
