+
+        marker_row = rng.randint(r0, r0 + region_h - 1)
+        grid[marker_row, c0 + region_w] = out_color
+
+        _mark_blocked(occupied, r0, c0, comp_h, comp_w, pad=1)
+        return (r0, c0)
+    return None
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    n_regions = rng.randint(2, 4)
