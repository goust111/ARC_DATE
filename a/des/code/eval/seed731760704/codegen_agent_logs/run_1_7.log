+    coords: list[tuple[int, int]] = [(0, 0)]
+    r = c = 0
+    for _ in range(steps - 1):
+        r += 1
+        coords.append((r, c))
+        c += 1
+        coords.append((r, c))
+    h = max(rr for rr, _ in coords) + 1
+    w = max(cc for _, cc in coords) + 1
+    mask = np.zeros((h, w), dtype=bool)
+    for rr, cc in coords:
+        mask[rr, cc] = True
+    return mask
+
+
+def _make_u(rng: random.Random) -> np.ndarray:
+    h = rng.randint(3, 5)
+    w = rng.randint(3, 5)
+    mask = np.zeros((h, w), dtype=bool)
+    mask[:, 0] = True
