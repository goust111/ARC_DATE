+    if not candidates:
+        return None
+
+    arrow_cells = random.choice(candidates)
+    all_cells = lock_cells | arrow_cells | cavity_cells
+    normalized_all = _normalize_cells(all_cells)
+    mask_all = _cells_to_mask(normalized_all)
