+    arrow_h, arrow_w = arrow_mask.shape
+    arrow_shape = _mask_to_cells(arrow_mask)
+    lock_r1 = lock_r0 + lock_h - 1
+    lock_c1 = lock_c0 + lock_w - 1
+
