+def _can_place(
+    occupied: np.ndarray,
+    shape_cells: set[tuple[int, int]],
+    top: int,
+    left: int,
+    pad: int,
+) -> bool:
+    h, w = occupied.shape
+    for r, c in shape_cells:
+        rr = top + r
+        cc = left + c
+        if not (0 <= rr < h and 0 <= cc < w):
+            return False
+        r0 = max(0, rr - pad)
+        r1 = min(h, rr + pad + 1)
+        c0 = max(0, cc - pad)
+        c1 = min(w, cc + pad + 1)
+        if np.any(occupied[r0:r1, c0:c1]):
+            return False
+    return True
+
+
+def _place_shape(
+    occupied: np.ndarray,
+    shape_cells: set[tuple[int, int]],
+    pad: int,
+) -> tuple[int, int] | None:
+    h, w = occupied.shape
+    shape_h = 1 + max(r for r, _ in shape_cells)
+    shape_w = 1 + max(c for _, c in shape_cells)
+    if shape_h > h or shape_w > w:
+        return None
+
+    positions = [(r, c) for r in range(h - shape_h + 1) for c in range(w - shape_w + 1)]
+    random.shuffle(positions)
+    for top, left in positions:
+        if _can_place(occupied, shape_cells, top, left, pad):
+            return top, left
+    return None
+
