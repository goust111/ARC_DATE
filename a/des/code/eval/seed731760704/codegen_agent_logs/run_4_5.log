+    if len(_components_from_mask(ring, conn8=True)) != 1:
+        return None
+    if not np.array_equal(_hole_mask(ring), cavity_patch):
+        return None
+
+    lock_h, lock_w = ring.shape
+    canvas_h = lock_h + 6
+    canvas_w = lock_w + 6
