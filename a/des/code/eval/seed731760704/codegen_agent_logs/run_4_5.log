+    lock_c0 = 3
+
+    lock_cells = {(lock_r0 + int(r), lock_c0 + int(c)) for r, c in np.argwhere(ring)}
+    cavity_cells = {
+        (lock_r0 + int(r), lock_c0 + int(c))
+        for r, c in np.argwhere(cavity_patch)
