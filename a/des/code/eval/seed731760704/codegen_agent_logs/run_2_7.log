+    objects: dict[int, tuple[tuple[int, int], ...]] = {}
+    for color in top_marks:
+        comps = _components_of_color(canvas, color)
+        assert len(comps) == 1
+        coords = tuple(sorted((r + 1, c + 1) for r, c in comps[0]))
+        objects[color] = coords
