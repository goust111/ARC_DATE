+def _extract_objects(grid: np.ndarray) -> tuple[int, dict[int, int], dict[int, int], dict[int, tuple[tuple[int, int], ...]]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
+    assert h >= 4 and w >= 4
