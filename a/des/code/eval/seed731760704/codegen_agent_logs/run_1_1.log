+
+def _ray_distance_to_wall_mask(mask: np.ndarray, r: int, c: int, dr: int, dc: int) -> int:
+    h, w = mask.shape
+    dist = 0
+    rr, cc = r + dr, c + dc
+    while 0 <= rr < h and 0 <= cc < w and bool(mask[rr, cc]):
