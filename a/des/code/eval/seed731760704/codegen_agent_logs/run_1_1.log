+    vdir: tuple[int, int],
+    mode: str,
+    rng: random.Random,
+) -> tuple[tuple[int, int], tuple[int, int], tuple[int, int]] | None:
+    h_positive = hdir == (0, 1)
+    v_positive = vdir == (1, 0)
+
+    for _ in range(120):
