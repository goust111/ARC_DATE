+        start = c
+        while c < top.size and int(top[c]) != BLACK:
+            c += 1
+        run = [int(v) for v in top[start:c]]
+        for i in range(0, len(run) - 1, 2):
+            seed_color = run[i]
+            dir_color = run[i + 1]
+            if dir_color in DIR_COLOR_TO_DELTA:
