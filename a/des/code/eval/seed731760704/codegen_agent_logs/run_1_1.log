+                h_choices = list(near_h)
+                v_choices = [d for d in far_v if d not in h_choices]
+            else:
+                far_h = range(max(h_lo, h_hi - 1), h_hi + 1)
+                near_v = range(v_lo, min(v_hi, v_lo + 1) + 1)
