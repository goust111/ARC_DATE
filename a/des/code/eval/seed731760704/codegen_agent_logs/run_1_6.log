+                    nc = int(c) + dc
+                    if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
+                        frontier.add((nr, nc))
+            if not frontier:
+                break
+            nr, nc = rng.choice(sorted(frontier))
