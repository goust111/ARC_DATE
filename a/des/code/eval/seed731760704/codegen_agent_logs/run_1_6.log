+    pairs: list[dict] = []
+    order = list(range(pair_count))
+    order.sort(
+        key=lambda idx: (
+            -(max(r for r, _ in shape_keys[idx]) + 1) * (max(c for _, c in shape_keys[idx]) + 1),
+            -len(shape_keys[idx]),
