+    row_pairs = 0
+    col_pairs = 0
+    mapped_winners = 0
+    unmapped_winners = 0
+    for group in groups.values():
+        winner, loser = sorted(group, key=lambda obj: (obj["top"], obj["left"]))
+        if winner["top"] == loser["top"]:
+            col_pairs += 1
+        else:
