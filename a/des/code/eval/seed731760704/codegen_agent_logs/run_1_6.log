+
+
+def _place_pair(
+    occupied: np.ndarray, h: int, w: int, relation: str, rng: random.Random
+) -> tuple[tuple[int, int], tuple[int, int]] | None:
+    positions = _feasible_positions(occupied, h, w)
+    rng.shuffle(positions)
+    for top1, left1 in positions:
+        temp = occupied.copy()
