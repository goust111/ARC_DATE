+) -> tuple[tuple[int, int], ...] | None:
+    for _ in range(200):
+        h = rng.randint(2, 5)
+        w = rng.randint(2, 5)
+        area = rng.randint(4, min(8, h * w))
+        mask = np.zeros((h, w), dtype=bool)
+        sr = rng.randrange(h)
+        sc = rng.randrange(w)
+        mask[sr, sc] = True
+
+        while int(mask.sum()) < area:
+            frontier: set[tuple[int, int]] = set()
+            for r, c in np.argwhere(mask):
+                for dr, dc in DIRS4:
+                    nr = int(r) + dr
+                    nc = int(c) + dc
+                    if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
+                        frontier.add((nr, nc))
+            if not frontier:
+                break
+            nr, nc = rng.choice(sorted(frontier))
+            mask[nr, nc] = True
+
+        mask = _crop_mask(mask)
+        key = tuple(sorted((int(r), int(c)) for r, c in np.argwhere(mask)))
+        if key in banned:
+            continue
+        if not 4 <= len(key) <= 8:
+            continue
+        return key
+    return None
+
+
+def _can_place(occupied: np.ndarray, top: int, left: int, h: int, w: int) -> bool:
+    grid_h, grid_w = occupied.shape
+    if top < 0 or left < 0 or top + h > grid_h or left + w > grid_w:
+        return False
+    r0 = max(0, top - 1)
+    c0 = max(0, left - 1)
+    r1 = min(grid_h, top + h + 1)
