+    grid = np.full((h, w), BG, dtype=int)
+    for pair in pairs:
+        _paint_shape(grid, pair["shape"], pair["winner_pos"][0], pair["winner_pos"][1], pair["winner_color"])
+        _paint_shape(grid, pair["shape"], pair["loser_pos"][0], pair["loser_pos"][1], pair["loser_color"])
