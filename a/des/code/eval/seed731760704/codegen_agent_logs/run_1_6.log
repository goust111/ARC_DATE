+
+    touching_corner = [
+        candidate
+        for candidate in candidates
+        if candidate[0][2] == h - 1 and candidate[0][3] == w - 1
+    ]
+    bbox, mapping = max(touching_corner or candidates, key=lambda item: item[0])
