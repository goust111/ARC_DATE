+def _find_mapping_table(g: np.ndarray) -> tuple[dict[int, int], np.ndarray]:
+    h, w = g.shape
+    candidates: list[tuple[tuple[int, int, int, int], dict[int, int]]] = []
+
+    for comp in _color_components(g, FRAME):
+        r0, c0, r1, c1 = _bbox(comp)
