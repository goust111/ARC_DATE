+    textures = []
+    for idx in texture_ids:
+        mask = TEXTURE_MASKS[int(idx)]
+        if rng.random() < 0.5:
+            mask = ~mask
+        a, b = map(int, rng.choice(COLORS, size=2, replace=False))
+        textures.append(np.where(mask, a, b).astype(int))
