+        h, w = w, h
+    h = max(GRID_SIDE_MIN, max_h + 2, h)
+    w = max(GRID_SIDE_MIN, max_w + 2, w)
+    h = min(GRID_SIDE_MAX, h)
+    w = min(GRID_SIDE_MAX, w)
