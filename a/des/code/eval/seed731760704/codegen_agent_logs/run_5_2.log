+    c1 = int(coords[:, 1].max())
+    return mask[r0 : r1 + 1, c0 : c1 + 1].astype(bool)
+
+
+def _transform_mask(mask: np.ndarray, rot_k: int, flipped: bool) -> np.ndarray:
+    arr = np.fliplr(mask) if flipped else mask
+    return _tight(np.rot90(arr, rot_k))
