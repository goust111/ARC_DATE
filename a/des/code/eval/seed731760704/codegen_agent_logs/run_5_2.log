+def _make_pair(existing_signatures: set[tuple[str, ...]]) -> dict[str, object] | None:
+    hole_count = random.choice(HOLE_COUNT_OPTIONS)
+    for _ in range(SHAPE_RETRIES):
+        filled = _build_outer_shape(hole_count)
+        if filled is None:
+            continue
