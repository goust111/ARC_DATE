+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            touches_edge = False
+            while q:
+                rr, cc = q.popleft()
+                comp.append((int(rr), int(cc)))
+                if rr == 0 or cc == 0 or rr == h - 1 or cc == w - 1:
+                    touches_edge = True
+                for dr, dc in NEIGHBORS4:
