+def _place_patch(grid: np.ndarray, occupied: np.ndarray, patch: np.ndarray) -> tuple[int, int] | None:
+    h, w = grid.shape
+    ph, pw = patch.shape
+    positions = [(r, c) for r in range(h - ph + 1) for c in range(w - pw + 1)]
+    random.shuffle(positions)
+    for r0, c0 in positions:
