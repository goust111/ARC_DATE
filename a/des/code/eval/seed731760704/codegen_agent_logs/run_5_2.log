+BG = 0
+LOCK_COLOR = 5
+KEY_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+# Generator bounds.
+PAIR_COUNT_MIN = 2
+PAIR_COUNT_MAX = 4
+OBJECT_PADDING = 1
+GRID_SIDE_MIN = 18
+GRID_SIDE_MAX = 36
+GEN_RETRIES = 400
+
+# Shape generation.
+CORE_H_RANGE = (5, 8)
+CORE_W_RANGE = (5, 8)
+EXTRUSION_THICK_RANGE = (1, 3)
+HOLE_COUNT_OPTIONS = (1, 2, 3)
+HOLE_RECT_SIZES = ((1, 1), (1, 2), (2, 1), (2, 2), (1, 3), (3, 1))
+SHAPE_RETRIES = 200
+HOLE_RETRIES = 200
