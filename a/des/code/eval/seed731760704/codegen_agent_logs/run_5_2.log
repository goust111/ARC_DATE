+def _gen_attempt() -> np.ndarray | None:
+    pair_count = random.randint(PAIR_COUNT_MIN, PAIR_COUNT_MAX)
+    colors = random.sample(KEY_COLORS, pair_count)
+    signatures: set[tuple[str, ...]] = set()
+    pairs: list[dict[str, object]] = []
+
