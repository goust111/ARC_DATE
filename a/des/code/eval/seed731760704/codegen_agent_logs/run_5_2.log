+    return tuple("".join("1" if cell else "0" for cell in row) for row in tight)
+
+
+def _canonical_signature(mask: np.ndarray) -> tuple[str, ...]:
+    variants = []
+    for flipped in (False, True):
+        for rot_k in range(4):
