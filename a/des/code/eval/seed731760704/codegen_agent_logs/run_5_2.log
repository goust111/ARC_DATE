+                else:
+                    canvas[r0 + core_h : r0 + core_h + ext_h, start_c : start_c + ext_w] = True
+            else:
+                ext_w = random.randint(*EXTRUSION_THICK_RANGE)
+                ext_h = random.randint(2, core_h)
+                start_r = r0 + random.randint(0, core_h - ext_h)
