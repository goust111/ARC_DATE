+    if not blank_cells:
+        return None
+
+    for job in chosen:
+        anchor_r, anchor_c = rng.choice(job["positions"])
+        grid[anchor_r, anchor_c] = rng.choice(seed_palette)
+
+    if _mode_color(grid) != bg:
+        return None
+
+    try:
+        parsed = _parse_grid(grid)
