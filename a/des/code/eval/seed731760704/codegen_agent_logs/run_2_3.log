+
+    blank_cells = {
+        (ri, ci)
+        for ri in range(row_count)
+        for ci in range(col_count)
+        if (ri, ci) != library_idx and all(job["cell_index"] != (ri, ci) for job in chosen)
+    }
+    if not blank_cells:
+        return None
+
+    for job in chosen:
+        anchor_r, anchor_c = rng.choice(job["positions"])
