+def _spans_from_sizes(sizes: list[int]) -> tuple[list[tuple[int, int]], list[int], int]:
+    spans = []
+    separators = []
+    pos = 0
+    for idx, size in enumerate(sizes):
+        spans.append((pos, pos + size - 1))
+        pos += size
+        if idx != len(sizes) - 1:
+            separators.append(pos)
+            pos += 1
