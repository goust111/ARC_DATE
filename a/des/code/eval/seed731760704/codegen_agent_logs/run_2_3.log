+    samples = _sample_specs(rng)
+    side = rng.choice(SIDE_CHOICES)
+    req_h, req_w = _layout_requirement(samples, side)
+
+    row_count = rng.randint(2, 4)
+    col_count = rng.randint(2, 4)
