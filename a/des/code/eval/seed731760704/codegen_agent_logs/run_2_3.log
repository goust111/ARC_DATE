+            return None
+        if parsed["blank_count"] < 1:
+            return None
+        _ = main(grid)
+    except AssertionError:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _generate_candidate(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

