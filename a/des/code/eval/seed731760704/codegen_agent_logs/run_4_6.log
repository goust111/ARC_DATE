+                    grid[r0, c0 + j] = int(color)
+            else:
+                for j, color in enumerate(seq):
+                    grid[r0 + j, c0] = int(color)
+            _mark_line(occupied, r0, c0, orient, length)
+            placed.append({"seq": seq, "orient": orient, "r0": r0, "c0": c0})
