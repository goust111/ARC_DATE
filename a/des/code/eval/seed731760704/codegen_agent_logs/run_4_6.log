+    expected = _expected_output(placed, mapping)
+    produced = main(grid)
+    if not np.array_equal(produced, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
