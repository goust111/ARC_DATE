+    orientations = [random.choice(("h", "v")) for _ in range(count)]
+    if count >= 2 and len(set(orientations)) == 1:
+        flip = random.randrange(count)
+        orientations[flip] = "v" if orientations[flip] == "h" else "h"
+    return orientations
