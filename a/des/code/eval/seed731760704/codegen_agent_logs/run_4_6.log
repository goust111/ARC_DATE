+def _runs(values: np.ndarray) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    start: int | None = None
+    for i, value in enumerate(values):
+        if bool(value):
+            if start is None:
+                start = int(i)
+        elif start is not None:
+            runs.append((start, int(i - 1)))
