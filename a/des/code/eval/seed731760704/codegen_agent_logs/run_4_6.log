+def _extract_lookup(table: np.ndarray) -> dict[tuple[int, ...], np.ndarray]:
+    assert np.all(table[0, :] == GREY) and np.all(table[-1, :] == GREY)
+    col_runs = _runs(np.all(table == GREY, axis=0))
+    assert len(col_runs) >= 3 and len(col_runs) % 2 == 1
