+def _expected_output(chromosomes: list[dict], mapping: dict[tuple[int, ...], np.ndarray]) -> np.ndarray:
+    ordered = sorted(chromosomes, key=lambda item: (int(item["c0"]), int(item["r0"])))
+    pieces: list[np.ndarray] = []
+    for chrom in ordered:
