    return random.choice(pairs)

def _gen_marker_columns(c0: int, c1: int, exit_side: int) -> tuple[int, int]:
    width = c1 - c0 + 1
    min_sep, max_sep = MARKER_SEPARATION_RANGE
    sep = random.randint(min_sep, min(max_sep, width - ADJACENT_CELL_OFFSET))
    if exit_side > 0:
