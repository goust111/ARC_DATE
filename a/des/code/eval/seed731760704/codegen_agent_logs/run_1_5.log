_RNG = np.random.default_rng()


def _get_bg(grid: np.ndarray) -> int:
    vals, counts = np.unique(grid, return_counts=True)
    return int(vals[int(np.argmax(counts))])


def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))


def _components(mask: np.ndarray) -> list[np.ndarray]:
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    out: list[np.ndarray] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            pts: list[tuple[int, int]] = []
            while q:
                rr, cc = q.popleft()
                pts.append((rr, cc))
                for nr, nc in _neighbors4(rr, cc):
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            out.append(np.asarray(pts, dtype=int))
    return out


def _color_components(grid: np.ndarray, color: int) -> list[dict]:
    comps = []
    for coords in _components(grid == color):
        r0 = int(coords[:, 0].min())
        c0 = int(coords[:, 1].min())
        r1 = int(coords[:, 0].max())
        c1 = int(coords[:, 1].max())
        mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
        mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
        comps.append(
            {
                "bbox": (r0, c0, r1, c1),
                "coords": coords,
                "mask": mask,
                "area": int(coords.shape[0]),
            }
        )
    return comps


def _ring_mask(h: int, w: int) -> np.ndarray:
    ring = np.zeros((h, w), dtype=bool)
    ring[0, :] = True
    ring[-1, :] = True
    ring[:, 0] = True
    ring[:, -1] = True
    return ring


def _frame_info(mask: np.ndarray) -> dict | None:
    h, w = mask.shape
    if h < 5 or w < 5:
        return None
    ring = _ring_mask(h, w)
    if bool((mask & ~ring).any()):
        return None
    missing = np.argwhere(ring & ~mask)
    if missing.shape[0] < 2 or missing.shape[0] > 4:
        return None
    if any((r in (0, h - 1) and c in (0, w - 1)) for r, c in missing):
        return None

    sides: list[str] = []
    if np.all(missing[:, 0] == 0):
        cols = sorted(int(c) for c in missing[:, 1])
        if cols == list(range(cols[0], cols[-1] + 1)):
            sides.append("top")
    if np.all(missing[:, 0] == h - 1):
        cols = sorted(int(c) for c in missing[:, 1])
        if cols == list(range(cols[0], cols[-1] + 1)):
            sides.append("bottom")
    if np.all(missing[:, 1] == 0):
        rows = sorted(int(r) for r in missing[:, 0])
        if rows == list(range(rows[0], rows[-1] + 1)):
            sides.append("left")
    if np.all(missing[:, 1] == w - 1):
        rows = sorted(int(r) for r in missing[:, 0])
        if rows == list(range(rows[0], rows[-1] + 1)):
            sides.append("right")
    if len(sides) != 1:
        return None

    return {
        "ring": ring,
        "missing": {tuple(map(int, x)) for x in missing},
        "gap_side": sides[0],
        "shape": (h, w),
    }


def _classify_arrow(mask: np.ndarray) -> str | None:
    h, w = mask.shape
    if not bool(mask.all()):
        return None
    if h == 1 and w == 2:
        return "h"
    if h == 2 and w == 1:
        return "v"
    return None


def _match_arrow(frame_bbox: tuple[int, int, int, int], arrows: list[dict], used: set[int]) -> str:
    r0, c0, r1, c1 = map(int, frame_bbox)
    matches: list[tuple[int, str]] = []
    for idx, arrow in enumerate(arrows):
