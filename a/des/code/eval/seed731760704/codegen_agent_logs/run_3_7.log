+def _in_bounds(height: int, width: int, r: int, c: int) -> bool:
+    return 0 <= r < height and 0 <= c < width
+
+
+def _is_edge(height: int, width: int, r: int, c: int) -> bool:
+    return r == 0 or r == height - 1 or c == 0 or c == width - 1
