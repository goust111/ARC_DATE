+    all_pairs = []
+    for i in range(n):
+        for j in range(i + 1, n):
+            ar, ac = _center(containers[i]["bbox"])
+            br, bc = _center(containers[j]["bbox"])
+            dist = abs(ar - br) + abs(ac - bc)
+            all_pairs.append((dist + rng.random(), i, j))
