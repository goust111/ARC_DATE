+def _expected_output(
+    grid: np.ndarray,
+    containers: list[dict],
+    edges: list[tuple[int, int]],
+    kinds: list[str],
+    container_colors: list[int],
+) -> np.ndarray:
+    out = grid.copy()
+    updated = list(container_colors)
+    used: set[int] = set()
+    for kind, (a, b) in zip(kinds, edges):
+        if kind in ("a", "b"):
