+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+def _background_color(grid: np.ndarray) -> int:
+    values = np.asarray(grid, dtype=int).ravel()
+    return int(np.bincount(values).argmax())
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.asarray(pts, dtype=int))
+    return comps
+
+
+def _bbox(points: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = points.min(axis=0)
+    r1, c1 = points.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _paint_frame(grid: np.ndarray, bbox: tuple[int, int, int, int], color: int) -> None:
+    r0, c0, r1, c1 = bbox
+    grid[r0, c0 : c1 + 1] = color
+    grid[r1, c0 : c1 + 1] = color
+    grid[r0 : r1 + 1, c0] = color
+    grid[r0 : r1 + 1, c1] = color
+
+
+def _center(bbox: tuple[int, int, int, int]) -> tuple[float, float]:
+    r0, c0, r1, c1 = bbox
+    return (r0 + r1) / 2.0, (c0 + c1) / 2.0
+
+
+def _boxes_too_close(
+    a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int
+) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return not (
+        ar1 + pad < br0
+        or br1 + pad < ar0
+        or ac1 + pad < bc0
+        or bc1 + pad < ac0
+    )
