+def _build_grid(
+    containers: list[dict],
+    paths: list[list[tuple[int, int]]],
+    container_colors: list[int],
+    valve_colors: list[int],
+    rng: random.Random,
+    shape: tuple[int, int],
+) -> np.ndarray:
+    grid = np.full(shape, BG, dtype=int)
