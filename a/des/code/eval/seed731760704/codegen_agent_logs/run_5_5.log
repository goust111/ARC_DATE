+
+def _find_path(
+    start: tuple[int, int], goal: tuple[int, int], occupied: np.ndarray
+) -> list[tuple[int, int]] | None:
+    if occupied[start] or occupied[goal]:
+        return None
+    h, w = occupied.shape
+    q = deque([start])
+    parent = {start: None}
+    while q:
+        cur = q.popleft()
+        if cur == goal:
+            break
+        for nxt in _neighbors4(cur[0], cur[1], h, w):
+            if nxt in parent:
+                continue
+            if nxt == goal:
+                if occupied[nxt]:
