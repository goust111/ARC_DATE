+
+def _place_containers(rng: random.Random, h: int, w: int):
+    n = rng.randint(*CONTAINER_COUNT_RANGE)
+    containers = []
+    for _ in range(200):
+        if len(containers) == n:
+            return containers
+        ih = rng.randint(*INTERIOR_H_RANGE)
+        iw = rng.randint(*INTERIOR_W_RANGE)
+        bh = ih + 2
+        bw = iw + 2
+        max_r0 = h - bh - 3
+        max_c0 = w - bw - 3
+        if max_r0 < 2 or max_c0 < 2:
+            return None
+        r0 = rng.randint(2, max_r0)
