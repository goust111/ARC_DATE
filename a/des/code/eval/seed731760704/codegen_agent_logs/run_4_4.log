+        coords, marker = _flip_vertical(coords, marker)
+    elif direction == "left":
+        coords, marker = _build_horizontal_base()
+    elif direction == "right":
+        coords, marker = _build_horizontal_base()
+        coords, marker = _flip_horizontal(coords, marker)
