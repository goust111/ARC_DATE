+    frame_h = out_h + 2
+    frame_w = out_w + 2
+    frame_left_margin = random.randint(*FRAME_MARGIN_RANGE)
+    min_width = frame_w + frame_left_margin + 1
+    assert width >= min_width
+    frame_c = random.randint(frame_left_margin, width - frame_w - 1)
