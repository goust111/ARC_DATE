+        if idx == clip_idx:
+            anchor_pool = [cell for cell in clipped if cell not in used_anchors]
+        else:
+            anchor_pool = [cell for cell in safe if cell not in used_anchors]
+            if not anchor_pool:
+                anchor_pool = [cell for cell in clipped if cell not in used_anchors]
