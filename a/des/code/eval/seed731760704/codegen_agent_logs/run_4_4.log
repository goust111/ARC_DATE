+    anchors: dict[int, tuple[int, int]] = {}
+    for r, c in np.argwhere(interior != BLACK):
+        color = int(interior[r, c])
+        assert color not in anchors, "each anchor color must appear exactly once"
+        anchors[color] = (int(r), int(c))
