+
+def _build_grid(
+    shapes: list[dict],
+    source_pos: dict[int, tuple[int, int]],
+    anchors: dict[int, tuple[int, int]],
+    top_h: int,
+    width: int,
+    out_shape: tuple[int, int],
+) -> np.ndarray:
