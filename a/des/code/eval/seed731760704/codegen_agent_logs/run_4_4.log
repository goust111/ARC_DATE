+    stamp_offsets: list[tuple[int, int]] = []
+    mr, mc = marker
+    for r, c in coords:
+        dr = int(r - mr)
+        dc = int(c - mc)
+        if direction in ("up", "down"):
+            stamp_offsets.append((-dr, dc))
+        else:
+            stamp_offsets.append((dr, -dc))
