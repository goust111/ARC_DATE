   207	    other_colors: list[int],
   208	) -> dict[int, int] | None:
   209	    for _ in range(40):
   210	        main_count = random.randint(2, min(5, core_area))
   211	        max_distractors = min(MAX_DISTRACTOR_COLORS, len(other_colors), core_area - main_count)
   212	        n_distractors = random.randint(0, max_distractors)
   213	        chosen = random.sample(other_colors, n_distractors)
   214	        counts = {main_key: main_count}
   215	        remaining = core_area - main_count
   216	        ok = True
   217	        for i, color in enumerate(chosen):
   218	            future_needed = len(chosen) - i - 1
   219	            cap = min(main_count - 1, remaining - future_needed)
   220	            if cap < 1:
   221	                ok = False
   222	                break
   223	            count = random.randint(1, cap)
   224	            counts[color] = count
   225	            remaining -= count
   226	        if ok:
   227	            return counts
   228	    return None
