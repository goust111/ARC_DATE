+def _render_input(tracks: list[dict], shape: tuple[int, int], rng: random.Random) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+
+    for track in tracks:
+        r0 = int(track["r0"])
+        c0 = int(track["c0"])
