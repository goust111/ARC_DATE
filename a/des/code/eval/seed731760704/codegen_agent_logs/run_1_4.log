+        area_c0 = c0 - 4
+        orange_col = area_c0
+        orange_r0 = area_r0 + rng.randint(0, 4 - step)
+        orange = [(int(orange_r0 + k), orange_col) for k in range(step)]
+        block_r = area_r0 + rng.choice((0, 2))
