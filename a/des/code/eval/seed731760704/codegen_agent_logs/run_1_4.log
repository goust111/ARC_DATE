+import itertools
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+MAROON = 9
+
+TRACK_COLORS = (1, 2, 5, 6, 8)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+DIR8 = DIR4 + ((1, 1), (1, -1), (-1, 1), (-1, -1))
+
+PLACEMENT_PAD = 4
+PLACEMENT_ATTEMPTS = 200
+GEN_RETRIES = 400
