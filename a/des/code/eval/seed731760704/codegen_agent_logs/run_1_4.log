+def _boxes_too_close(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return not (
+        int(ar1) < int(br0) - 1
+        or int(br1) < int(ar0) - 1
+        or int(ac1) < int(bc0) - 1
+        or int(bc1) < int(ac0) - 1
