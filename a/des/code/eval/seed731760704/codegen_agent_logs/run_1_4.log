+            if not ok:
+                continue
+
+            outcomes = {int(base_seq[(idx + delta) % n]) == int(dominant) for idx in combo}
+            if car_count >= 2 and len(outcomes) == 1 and len(set(base_seq)) == 2:
+                continue
+            valid.append(tuple(map(int, combo)))
+
+        if valid:
+            choice = list(rng.choice(valid))
+            choice.sort()
+            return choice
