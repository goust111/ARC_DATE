+    center_r = core_r0 + core_h // 2
+    center_c = core_c0 + core_w // 2
+    assert (mr, mc) == (center_r, center_c), "marker must sit at the core center"
+
+    return {
+        "body": body,
+        "marker": marker,
+        "core_h": core_h,
+        "core_w": core_w,
+        "sides": sides,
+    }
