def _dims(area: int) -> list[tuple[int, int]]:
    pairs = []
    for h in range(1, int(area**0.5) + 1):
        if area % h == 0:
            w = area // h
            pairs.append((h, w))
            if h != w:
                pairs.append((w, h))
    # Prefer close-to-square, then smaller height.
    pairs.sort(key=lambda t: (abs(t[0] - t[1]), t[0], t[1]))
