+BODY_COLORS = [1, 2, 3]
+TARGET_COLORS = [4, 5, 6, 7]
+MARKER_COLORS = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+LAYOUTS = [(1, 3), (1, 4), (1, 5), (2, 2), (2, 3), (3, 2)]
+DIM_CHOICES = [7, 9, 11]
+GRID_MIN = 28
+GRID_MAX = 40
+GEN_ATTEMPTS = 400
