+def _make_piece_patch(h: int, w: int, body: int, marker: int, sides: dict[str, tuple[int, int | None]]) -> np.ndarray:
+    top_tab = sides["N"][0] == 1
+    bottom_tab = sides["S"][0] == 1
+    left_tab = sides["W"][0] == 1
+    right_tab = sides["E"][0] == 1
