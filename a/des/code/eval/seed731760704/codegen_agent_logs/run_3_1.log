+    grid = _build_grid(specs)
+    if grid is None:
+        return None
+    if not _validate_generated_grid(grid, len(specs)):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
