  "src": "pattern sprites s outside frame sprites",
  "dst": "fill hollow rectangular frame sprites d",
  "match_cond": "s.color == d.color",
  "transform": "for each frame d: N = #{s | s.color == d.color}; draw N dots on mid-row(d), spaced by 2 from the right side"
}
</annotation>
</reference_puzzle>

