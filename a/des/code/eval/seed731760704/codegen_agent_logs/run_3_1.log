+    if inner_w > inner_h:
+        return "wide"
+    if inner_h > inner_w:
+        return "tall"
+    return "square"
+
+
+def _frame_records(grid: np.ndarray) -> list[dict[str, int]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    frames: list[dict[str, int]] = []
+    for coords in _grey_components(g):
+        rows = coords[:, 0]
+        cols = coords[:, 1]
+        r0 = int(rows.min())
+        r1 = int(rows.max())
+        c0 = int(cols.min())
+        c1 = int(cols.max())
+        outer_h = int(r1 - r0 + 1)
+        outer_w = int(c1 - c0 + 1)
+        assert outer_h >= 3 and outer_w >= 3, "frame must have non-empty interior"
