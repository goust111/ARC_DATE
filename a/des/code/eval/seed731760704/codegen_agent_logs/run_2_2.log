+def _component_center(coords: list[tuple[int, int]]) -> tuple[Fraction, Fraction]:
+    n = len(coords)
+    sr = sum(r for r, _ in coords)
+    sc = sum(c for _, c in coords)
+    return Fraction(sr, n), Fraction(sc, n)
