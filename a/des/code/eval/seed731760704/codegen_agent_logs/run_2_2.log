+def _sample_bbox_for_corner(corner: str, frame_h: int, frame_w: int, h: int, w: int) -> tuple[int, int, int, int]:
+    if corner == "tl":
+        return 0, 0, frame_h - 1, frame_w - 1
+    if corner == "tr":
+        return 0, w - frame_w, frame_h - 1, w - 1
+    if corner == "bl":
+        return h - frame_h, 0, h - 1, frame_w - 1
+    if corner == "br":
