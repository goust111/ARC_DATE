+        top, left = _ring_top_left(center_r, center_c, ring_h, ring_w)
+        cells = [(top + r, left + c) for r, c in plan["ring_cells"]]
+        if any(not (0 <= r < h and 0 <= c < w) for r, c in cells):
+            return None
+        if any((r, c) in occupied for r, c in cells):
+            return None
+        for r, c in cells:
+            occupied.add((r, c))
+            out[r, c] = int(color)
