+    grid_w: int,
+    ring_h: int,
+    ring_w: int,
+    forbidden_bbox: tuple[int, int, int, int],
+    existing: list[tuple[int, int, int, int]],
+) -> tuple[int, int] | None:
+    margin_r = ring_h + 3
+    margin_c = ring_w + 3
