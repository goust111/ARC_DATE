+
+def _can_place_cells(
+    cells: list[tuple[int, int]],
+    grid_h: int,
+    grid_w: int,
+    occupied: np.ndarray,
+    forbidden: np.ndarray,
+    pad: int,
+) -> bool:
+    for r, c in cells:
+        if not (0 <= r < grid_h and 0 <= c < grid_w):
+            return False
+        if bool(forbidden[r, c]):
+            return False
+        r0 = max(0, r - pad)
+        r1 = min(grid_h, r + pad + 1)
+        c0 = max(0, c - pad)
+        c1 = min(grid_w, c + pad + 1)
