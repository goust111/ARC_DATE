+    assert backtrack(0), "ring placements must be mutually non-overlapping"
+    for idx, (color, _placements) in enumerate(color_candidates):
+        cells = chosen[idx][4]
+        for r, c in cells:
+            out[r, c] = int(color)
+    return out
