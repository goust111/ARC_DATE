+def _ring_boundary_local(h: int, w: int) -> tuple[tuple[int, int], ...]:
+    return tuple(
+        (r, c)
+        for r in range(h)
+        for c in range(w)
+        if r in (0, h - 1) or c in (0, w - 1)
