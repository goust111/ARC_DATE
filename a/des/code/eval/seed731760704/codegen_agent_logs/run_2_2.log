+            return False
+        if bool(forbidden[r, c]):
+            return False
+        r0 = max(0, r - pad)
+        r1 = min(grid_h, r + pad + 1)
+        c0 = max(0, c - pad)
+        c1 = min(grid_w, c + pad + 1)
+        if bool(np.any(occupied[r0:r1, c0:c1])):
+            return False
+    return True
