+def _gen_attempt() -> np.ndarray | None:
+    n_objects = random.choice(OBJECT_COUNT_CHOICES)
+    side_min = GRID_MIN + 3 * (n_objects - 2)
+    H = random.randint(side_min, GRID_MAX)
+    W = random.randint(side_min, GRID_MAX)
