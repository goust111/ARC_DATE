+
+
+def _interior_with_filled_gap(
+    grid: np.ndarray, coords: list[tuple[int, int]], gap: list[tuple[int, int]]
+) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(coords)
+    pr0 = max(0, r0 - 1)
+    pc0 = max(0, c0 - 1)
+    pr1 = min(grid.shape[0] - 1, r1 + 1)
+    pc1 = min(grid.shape[1] - 1, c1 + 1)
