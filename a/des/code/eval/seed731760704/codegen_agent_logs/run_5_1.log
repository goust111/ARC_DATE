+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            yield rr, cc
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _outline(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = np.zeros_like(mask, dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            if r == 0 or c == 0 or r == h - 1 or c == w - 1:
+                out[r, c] = True
+                continue
+            for nr, nc in _neighbors4(r, c, h, w):
+                if not mask[nr, nc]:
+                    out[r, c] = True
+                    break
+    return out
+
+
+def _gap_on_row(grey_mask: np.ndarray, row: int, cols: list[int]) -> list[tuple[int, int]]:
+    if len(cols) < 3:
+        return []
+    lo = min(cols)
+    hi = max(cols)
+    missing = [c for c in range(lo, hi + 1) if not grey_mask[row, c]]
+    if not missing:
+        return []
+    if missing[0] == lo or missing[-1] == hi:
+        return []
+    if missing != list(range(missing[0], missing[-1] + 1)):
+        return []
+    return [(row, c) for c in missing]
+
+
+def _gap_on_col(grey_mask: np.ndarray, col: int, rows: list[int]) -> list[tuple[int, int]]:
+    if len(rows) < 3:
+        return []
+    lo = min(rows)
+    hi = max(rows)
+    missing = [r for r in range(lo, hi + 1) if not grey_mask[r, col]]
+    if not missing:
+        return []
+    if missing[0] == lo or missing[-1] == hi:
+        return []
+    if missing != list(range(missing[0], missing[-1] + 1)):
+        return []
+    return [(r, col) for r in missing]
+
