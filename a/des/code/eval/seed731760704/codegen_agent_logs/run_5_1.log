+            if placed is not None:
+                break
+        if placed is None:
+            return None
+        placed_regions.append(placed)
+        reserved_output |= placed["nonblack"] | placed["ray"]
+        occupied_nonblack |= placed["nonblack"]
+        spaced_nonblack |= _expand8(placed["nonblack"], H, W)
