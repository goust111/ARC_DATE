+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    best = int(np.max(counts))
+    winners = [int(v) for v, c in zip(values, counts) if int(c) == best]
+    assert len(winners) == 1
+    return winners[0]
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append(np.asarray(coords, dtype=int))
+    return comps
+
+
+def _l_patterns(height: int, width: int) -> list[np.ndarray]:
+    patterns = []
+
+    mask = np.zeros((height, width), dtype=bool)
+    mask[0, :] = True
+    mask[:, 0] = True
+    patterns.append(mask)
+
+    mask = np.zeros((height, width), dtype=bool)
+    mask[0, :] = True
+    mask[:, -1] = True
+    patterns.append(mask)
+
+    mask = np.zeros((height, width), dtype=bool)
+    mask[-1, :] = True
+    mask[:, 0] = True
+    patterns.append(mask)
+
+    mask = np.zeros((height, width), dtype=bool)
+    mask[-1, :] = True
+    mask[:, -1] = True
+    patterns.append(mask)
+
+    return patterns
+
+
+def _classify_hole(hole_mask: np.ndarray) -> str:
+    holes = _components(hole_mask)
+    assert len(holes) == 1
+    coords = holes[0]
+    rows = coords[:, 0]
+    cols = coords[:, 1]
