+    for _ in range(turn_after):
+        r += dr0
+        c += dc0
+        pts.append((r, c))
+    if turn_dir is not None:
+        dr1, dc1 = DIRS[turn_dir]
+        for _ in range(total_len - turn_after):
+            r += dr1
+            c += dc1
