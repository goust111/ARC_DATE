+    out = np.zeros((h, w), dtype=int)
+    for frag, (r0, c0) in zip(fragments, positions, strict=False):
+        for rr, cc, val in frag.input_cells:
+            inp[r0 + rr, c0 + cc] = val
+        for rr, cc, val in frag.output_cells:
