    for color in transformed:
        out[out == color] = BLACK
    for color, pts in transformed.items():
        for r, c in pts:
            out[r, c] = color
    return out


def _trace_arm(init_dir: str, total_len: int, turn_after: int, turn_dir: str | None) -> list[tuple[int, int]]:
    dr0, dc0 = DIRS[init_dir]
