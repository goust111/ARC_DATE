+def _bbox(points: set[tuple[int, int]] | list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    pts = list(points)
+    rs = [r for r, _ in pts]
+    cs = [c for _, c in pts]
+    return min(rs), min(cs), max(rs), max(cs)
+
