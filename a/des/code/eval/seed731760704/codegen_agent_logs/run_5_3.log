+def _dir_from_delta(dr: int, dc: int) -> str:
+    for name, (rr, cc) in DIRS.items():
+        if (dr, dc) == (rr, cc):
+            return name
+    raise ValueError(f"unknown direction for delta {(dr, dc)}")
