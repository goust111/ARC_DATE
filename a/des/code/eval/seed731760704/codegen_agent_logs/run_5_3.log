+    min_h = max(18, max(f.h for f in fragments) + 2)
+    min_w = max(18, max(f.w for f in fragments) + 2)
+    for _ in range(120):
+        h = rng.randint(min_h, 30)
+        w = rng.randint(min_w, 30)
+        positions = _place_fragments(rng, fragments, h, w)
