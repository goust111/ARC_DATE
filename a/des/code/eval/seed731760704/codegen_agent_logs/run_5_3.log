+def _make_fragment(rng: random.Random, color: int) -> Fragment | None:
+    for _ in range(400):
+        n = rng.randint(2, 4)
+        vertical_dir = rng.choice(("N", "S"))
+        horizontal_dir = rng.choice(("W", "E"))
