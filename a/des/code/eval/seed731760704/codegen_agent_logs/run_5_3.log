+
+BLACK = 0
+MAROON = 9
+PATH_COLORS = (1, 2, 3, 4, 5, 6, 7, 8)
+DIRS = {
+    "N": (-1, 0),
+    "S": (1, 0),
+    "W": (0, -1),
+    "E": (0, 1),
+}
+ORTHOGONAL = {
+    "N": ("W", "E"),
+    "S": ("E", "W"),
+    "W": ("S", "N"),
+    "E": ("N", "S"),
+}
