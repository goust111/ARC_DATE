+    for kind, idx, oh, ow in objects:
+        placed = False
+        for _ in range(PLACEMENT_RETRIES):
+            top = rng.randint(0, h - oh)
+            left = rng.randint(0, w - ow)
+            r0 = max(0, int(top - PADDING))
+            c0 = max(0, int(left - PADDING))
+            r1 = min(h, int(top + oh + PADDING))
