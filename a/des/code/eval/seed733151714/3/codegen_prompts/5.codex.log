+    grid_out = np.zeros((h, w), dtype=int)
+
+    specs: list[tuple[np.ndarray, np.ndarray, int, int]] = []
+    forced = ["missing", "extra"] + [None] * max(0, n_regions - 2)
+    rng.shuffle(forced)
