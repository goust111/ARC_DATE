def _pick_seed_color(seed_a: dict, seed_b: dict) -> int:
    if seed_a["area"] != seed_b["area"]:
        return int(seed_a["color"] if seed_a["area"] > seed_b["area"] else seed_b["color"])
    if seed_a["dist"] != seed_b["dist"]:
        return int(seed_a["color"] if seed_a["dist"] < seed_b["dist"] else seed_b["color"])
    return int(min(seed_a["color"], seed_b["color"]))


def main(grid: np.ndarray) -> np.ndarray:
    """
    Repair the missing quadrant pixels inside a fence using directional seed blocks.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    fence = _find_fence(g)
    fr0, fc0, fr1, fc1 = fence["bbox"]
    inner = g[fr0 + 1 : fr1, fc0 + 1 : fc1]
    quads = _quadrants(inner)

    canon = _reconstruct_canonical(quads)
    expected = _expected_quadrants(canon)

    missing_masks = []
    mismatch_counts = []
    for obs, exp in zip(quads, expected):
        missing = (obs == BLACK) & (exp != BLACK)
        wrong = (obs != exp) & ~missing
        missing_masks.append(missing)
        mismatch_counts.append(int(wrong.sum()))

    missing_counts = [int(mask.sum()) for mask in missing_masks]
    defect_idx = int(np.argmax(missing_counts))
    assert missing_counts[defect_idx] > 0, "expected a missing quadrant defect"
    assert missing_counts.count(missing_counts[defect_idx]) == 1, "defect quadrant must be unique"
    assert all(v == 0 for i, v in enumerate(mismatch_counts) if i != defect_idx), "unexpected non-missing mismatch"

    defect_expected_colors = np.unique(expected[defect_idx][missing_masks[defect_idx]])
    defect_expected_colors = defect_expected_colors[defect_expected_colors != BLACK]
    assert defect_expected_colors.size == 1, "missing region must correspond to one repair color"

    dir_a, dir_b = QUAD_TO_DIRS[defect_idx]
    seeds = _find_seed_blocks(g, fence["bbox"])
    fill_color = _pick_seed_color(seeds[dir_a], seeds[dir_b])

    out = g.copy()
    half = inner.shape[0] // 2
    if defect_idx == 0:
        rs = slice(fr0 + 1, fr0 + 1 + half)
        cs = slice(fc0 + 1, fc0 + 1 + half)
    elif defect_idx == 1:
        rs = slice(fr0 + 1, fr0 + 1 + half)
        cs = slice(fc0 + 1 + half, fc1)
    elif defect_idx == 2:
        rs = slice(fr0 + 1 + half, fr1)
        cs = slice(fc0 + 1 + half, fc1)
    else:
        rs = slice(fr0 + 1 + half, fr1)
        cs = slice(fc0 + 1, fc0 + 1 + half)
    patch = out[rs, cs].copy()
    patch[missing_masks[defect_idx]] = fill_color
    out[rs, cs] = patch
    return out


def _grow_polyomino(side: int, size: int, margin: int) -> np.ndarray | None:
    cells = [
        (r, c)
        for r in range(margin, side - margin)
        for c in range(margin, side - margin)
    ]
    if not cells:
        return None
    start = random.choice(cells)
    picked = {start}
    while len(picked) < size:
        frontier = []
        for r, c in picked:
            for dr, dc in DIRS4:
                nr, nc = r + dr, c + dc
                if margin <= nr < side - margin and margin <= nc < side - margin and (nr, nc) not in picked:
                    frontier.append((nr, nc))
        if not frontier:
            return None
        picked.add(random.choice(frontier))
    mask = np.zeros((side, side), dtype=bool)
    for r, c in picked:
        mask[r, c] = True
    return mask


