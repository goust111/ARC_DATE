+        covered[r0 : r1 + 1, c0 : c1 + 1] = True
+
+    legend_mask = (grid != BLACK) & (~covered)
+    pts = np.argwhere(legend_mask)
+    assert pts.size > 0, "expected a legend outside the frames"
+    r0 = int(pts[:, 0].min())
+    r1 = int(pts[:, 0].max())
+    c0 = int(pts[:, 1].min())
+    c1 = int(pts[:, 1].max())
