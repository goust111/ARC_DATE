+        (top, left, mid_r - 1, mid_c - 1),
+        (top, mid_c + 1, mid_r - 1, right),
+        (mid_r + 1, left, content_bottom, mid_c - 1),
+        (mid_r + 1, mid_c + 1, content_bottom, right),
