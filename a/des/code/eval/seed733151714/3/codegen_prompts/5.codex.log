+
+def _slot_rects(h: int, w: int) -> list[tuple[int, int, int, int]]:
+    content_bottom = h - LEGEND_ENTRY_H - 2
+    top = 1
+    left = 1
+    right = w - 2
+    mid_r = (top + content_bottom) // 2
+    mid_c = (left + right) // 2
