import random
from typing import Dict, List, Optional, Sequence, Tuple

import numpy as np


BLACK = 0
BLUE = 1
RED = 2
GREEN = 3
YELLOW = 4
GREY = 5
MAGENTA = 6
ORANGE = 7
AZURE = 8
MAROON = 9

HORIZONTAL = "horizontal"
VERTICAL = "vertical"
ROTATIONAL = "rotational"

LEGEND_COLOR_BY_KIND = {
    HORIZONTAL: RED,
    VERTICAL: BLUE,
    ROTATIONAL: GREEN,
}

GEN_RETRIES = 500


def _get_bg(grid: np.ndarray) -> int:
    vals, counts = np.unique(grid, return_counts=True)
    return int(vals[np.argmax(counts)])


def _bbox(coords: Sequence[Tuple[int, int]]) -> Tuple[int, int, int, int]:
    rows = [r for r, _ in coords]
    cols = [c for _, c in coords]
    return min(rows), min(cols), max(rows), max(cols)


def _components(mask: np.ndarray) -> List[List[Tuple[int, int]]]:
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    parts: List[List[Tuple[int, int]]] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            queue = [(r, c)]
            seen[r, c] = True
            coords: List[Tuple[int, int]] = []
            while queue:
                cr, cc = queue.pop()
                coords.append((cr, cc))
                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nr, nc = cr + dr, cc + dc
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        queue.append((nr, nc))
            parts.append(coords)
    return parts


def _monochrome_components(grid: np.ndarray, bg: int, bounds: Optional[Tuple[int, int, int, int]] = None) -> List[dict]:
    if bounds is None:
        r0, c0, r1, c1 = 0, 0, grid.shape[0] - 1, grid.shape[1] - 1
    else:
        r0, c0, r1, c1 = bounds
    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
    comps: List[dict] = []
    for color in sorted(int(v) for v in np.unique(sub) if int(v) != bg):
        for coords in _components(sub == color):
            abs_coords = [(r + r0, c + c0) for r, c in coords]
            comps.append(
                {
                    "color": color,
                    "coords": abs_coords,
                    "area": len(abs_coords),
                    "bbox": _bbox(abs_coords),
                }
            )
    return comps


def _is_rectangular_frame(comp: dict) -> bool:
    r0, c0, r1, c1 = comp["bbox"]
    h = r1 - r0 + 1
    w = c1 - c0 + 1
    if h < 3 or w < 3:
        return False
    want = {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1) if r in (r0, r1) or c in (c0, c1)}
    return set(comp["coords"]) == want


def _component_mask(grid: np.ndarray, comp: dict) -> np.ndarray:
    r0, c0, r1, c1 = comp["bbox"]
    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
    for r, c in comp["coords"]:
        mask[r - r0, c - c0] = True
    return mask


def _classify_pattern(mask: np.ndarray) -> str:
    horiz = bool(np.array_equal(mask, np.flipud(mask)))
    vert = bool(np.array_equal(mask, np.fliplr(mask)))
    rot = bool(np.array_equal(mask, np.rot90(mask, 2)))
    if horiz:
        return HORIZONTAL
    if vert:
        return VERTICAL
    if rot:
        return ROTATIONAL
    raise AssertionError("pattern must be horizontal, vertical, or 180-rotationally symmetric")


def _find_legend_and_regions(grid: np.ndarray, bg: int) -> Tuple[dict, List[dict]]:
    frames = [comp for comp in _monochrome_components(grid, bg) if _is_rectangular_frame(comp)]
    assert frames, "expected at least one frame"

    enriched = []
    for frame in frames:
        r0, c0, r1, c1 = frame["bbox"]
        inside = _monochrome_components(grid, bg, (r0 + 1, c0 + 1, r1 - 1, c1 - 1))
        enriched.append((frame, inside))

    legend_frame, legend_inside = max(enriched, key=lambda item: len(item[1]))
    assert len(legend_inside) >= 6, "legend frame should contain the most interior components"

    regions = []
    for frame, inside in enriched:
        if frame is legend_frame:
            continue
        assert len(inside) == 1, "each target frame must contain exactly one interior pattern"
        regions.append(frame)
    assert regions, "expected at least one target frame"
    return legend_frame, regions


def _extract_legend_map(grid: np.ndarray, legend_frame: dict, bg: int) -> Dict[str, int]:
    r0, c0, r1, c1 = legend_frame["bbox"]
    comps = _monochrome_components(grid, bg, (r0 + 1, c0 + 1, r1 - 1, c1 - 1))

    patterns = []
    markers = []
    for comp in comps:
        mask = _component_mask(grid, comp)
        h, w = mask.shape
        if comp["area"] == h * w and h <= 2 and w <= 2:
            markers.append(comp)
        else:
            patterns.append(comp)

    assert len(patterns) == 3 and len(markers) == 3, "legend must contain three patterns and three marker blocks"

    patterns.sort(key=lambda comp: (comp["bbox"][0] + comp["bbox"][2], comp["bbox"][1] + comp["bbox"][3]))
    markers.sort(key=lambda comp: (comp["bbox"][0] + comp["bbox"][2], comp["bbox"][1] + comp["bbox"][3]))

    mapping: Dict[str, int] = {}
    for pattern, marker in zip(patterns, markers):
        kind = _classify_pattern(_component_mask(grid, pattern))
        mapping[kind] = int(marker["color"])

    assert set(mapping) == {HORIZONTAL, VERTICAL, ROTATIONAL}, "legend must define all three symmetry classes"
    return mapping


def main(grid: np.ndarray) -> np.ndarray:
    """
    Recolor each grey frame according to the symmetry class of its enclosed pattern,
    with the color mapping read from the maroon-framed legend.
    """
    g = np.asarray(grid, dtype=int)
    bg = _get_bg(g)
    legend_frame, region_frames = _find_legend_and_regions(g, bg)
    legend_map = _extract_legend_map(g, legend_frame, bg)

    out = g.copy()
    for frame in region_frames:
        r0, c0, r1, c1 = frame["bbox"]
        inside = _monochrome_components(g, bg, (r0 + 1, c0 + 1, r1 - 1, c1 - 1))
        pattern = inside[0]
        kind = _classify_pattern(_component_mask(g, pattern))
        border_color = legend_map[kind]
        for r, c in frame["coords"]:
            out[r, c] = border_color
    return out


def _parse_mask(rows: Sequence[str]) -> np.ndarray:
    return np.array([[ch == "1" for ch in row] for row in rows], dtype=bool)


PATTERN_LIBRARY = {
    HORIZONTAL: {
        3: [
            _parse_mask(["110", "111", "110"]),
            _parse_mask(["011", "111", "011"]),
        ],
        4: [
            _parse_mask(["1100", "1111", "1111", "1100"]),
            _parse_mask(["0011", "1111", "1111", "0011"]),
        ],
    },
    VERTICAL: {
        3: [
            _parse_mask(["101", "111", "010"]),
            _parse_mask(["010", "111", "101"]),
        ],
        4: [
            _parse_mask(["1001", "1111", "0110", "0110"]),
            _parse_mask(["0110", "0110", "1111", "1001"]),
        ],
    },
    ROTATIONAL: {
        3: [
            _parse_mask(["110", "010", "011"]),
            _parse_mask(["011", "010", "110"]),
        ],
        4: [
            _parse_mask(["0011", "0110", "0110", "1100"]),
            _parse_mask(["0001", "0111", "1110", "1000"]),
        ],
    },
}

BOTH_AXIS_LIBRARY = {
    3: [
        _parse_mask(["111", "010", "111"]),
        _parse_mask(["101", "111", "101"]),
    ],
    4: [
        _parse_mask(["0110", "1111", "1111", "0110"]),
        _parse_mask(["1001", "1111", "1111", "1001"]),
    ],
}


def _sample_pattern(rng: random.Random, kind: str, allow_both_for_horizontal: bool) -> np.ndarray:
    size = rng.choice((3, 4))
    if kind == HORIZONTAL and allow_both_for_horizontal and rng.random() < 0.35:
        mask = rng.choice(BOTH_AXIS_LIBRARY[size])
    else:
        mask = rng.choice(PATTERN_LIBRARY[kind][size])
    assert _classify_pattern(mask) == kind
    return mask.copy()


def _build_region(mask: np.ndarray, color: int) -> np.ndarray:
    h, w = mask.shape
    tile = np.full((h + 2, w + 2), BLACK, dtype=int)
    tile[0, :] = GREY
    tile[-1, :] = GREY
    tile[:, 0] = GREY
    tile[:, -1] = GREY
    tile[1 : h + 1, 1 : w + 1][mask] = color
    return tile


def _build_legend(entries: List[Tuple[str, np.ndarray, int]], marker_side: str) -> np.ndarray:
    band_heights = [max(mask.shape[0], 2) for _, mask, _ in entries]
    band_widths = [mask.shape[1] + 1 + 2 for _, mask, _ in entries]
    inner_h = sum(band_heights) + (len(entries) - 1) + 2
    inner_w = max(band_widths) + 2

    inner = np.full((inner_h, inner_w), BLACK, dtype=int)
    row = 1
    for band_h, (kind, mask, pattern_color) in zip(band_heights, entries):
        marker_color = LEGEND_COLOR_BY_KIND[kind]
        content_w = mask.shape[1] + 1 + 2
        col0 = 1 + (inner_w - 2 - content_w) // 2
        pat_r = row + (band_h - mask.shape[0]) // 2
        block_r = row + (band_h - 2) // 2

        if marker_side == "left":
            inner[block_r : block_r + 2, col0 : col0 + 2] = marker_color
            pat_c = col0 + 3
        else:
            pat_c = col0
            inner[block_r : block_r + 2, pat_c + mask.shape[1] + 1 : pat_c + mask.shape[1] + 3] = marker_color

