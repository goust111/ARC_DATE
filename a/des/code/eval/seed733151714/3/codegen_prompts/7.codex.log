+                    "axis": "h",
+                    "color": int(up),
+                    "door_pixels": ((r - 1, c), (r + 1, c)),
+                }
+            elif left == right and left not in SPECIAL_COLORS:
+                locked[(r, c)] = {
+                    "axis": "v",
+                    "color": int(left),
+                    "door_pixels": ((r, c - 1), (r, c + 1)),
+                }
+    return locked
