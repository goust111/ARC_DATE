+
+def _row_col_starts(sizes):
+    starts = []
+    cursor = 1
+    for size in sizes:
+        starts.append(cursor)
+        cursor += int(size) + 1
+    return starts
+
+
+def _room_bbox(node, row_starts, col_starts, row_heights, col_widths):
