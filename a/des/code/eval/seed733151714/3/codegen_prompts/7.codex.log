+                continue
+            nxt_state = (tuple(nxt), collect(int(keymask), tuple(nxt)))
+            if nxt_state in pred:
+                continue
+            pred[nxt_state] = (node, keymask)
+            pred_edge[nxt_state] = ek
+            q.append(nxt_state)
+
+    if goal is None:
+        return None
+
+    nodes = []
+    edges = []
+    cur = goal
+    while cur is not None:
+        nodes.append(cur[0])
+        if cur != start_state:
+            edges.append(pred_edge[cur])
+        cur = pred[cur]
+    nodes.reverse()
+    edges.reverse()
+    return nodes, edges
