+def _gate_position(a, b, row_starts, col_starts, row_heights, col_widths, rng: np.random.Generator):
+    ar, ac = a
+    br, bc = b
+    if ar == br:
+        r0, r1, c0, c1 = _room_bbox(a, row_starts, col_starts, row_heights, col_widths)
