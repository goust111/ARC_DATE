+def _solve_node_graph(start, end, edge_colors, key_by_node):
+    adjacency = defaultdict(list)
+    for ek, color in edge_colors.items():
+        a, b = ek
+        adjacency[a].append((b, ek, color))
+        adjacency[b].append((a, ek, color))
