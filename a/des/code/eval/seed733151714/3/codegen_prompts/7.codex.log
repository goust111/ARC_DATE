+BLACK = 0
+YELLOW = 4
+GREY = 5
+MAROON = 9
+USABLE_COLORS = (1, 2, 3, 6, 7, 8)
+SPECIAL_COLORS = {BLACK, YELLOW, GREY, MAROON}
+RNG = np.random.default_rng()
