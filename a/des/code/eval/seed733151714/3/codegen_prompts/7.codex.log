+    for pos in spec["key_positions"].values():
+        if int(out[pos]) != BLACK:
+            return False
+    for pos in spec["gem_positions"].values():
+        if int(out[pos]) != BLACK:
+            return False
+    for ek in spec["route_edges"]:
