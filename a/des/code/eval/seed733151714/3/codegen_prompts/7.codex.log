+def _lattice_neighbors(node, rows: int, cols: int):
+    r, c = node
+    if r > 0:
+        yield (r - 1, c)
+    if r + 1 < rows:
+        yield (r + 1, c)
+    if c > 0:
+        yield (r, c - 1)
+    if c + 1 < cols:
+        yield (r, c + 1)
