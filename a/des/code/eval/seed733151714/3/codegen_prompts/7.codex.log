+    for edge_id in edge_path:
+        edge = layout["edges"][int(edge_id)]
+        if edge["color"] is None:
+            continue
+        for pos in edge["door_pixels"]:
+            opened.add(pos)
+    for pos in opened:
+        out[pos] = BLACK
