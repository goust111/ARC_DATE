+                continue
+            left = bool(passable[r, c - 1])
+            right = bool(passable[r, c + 1])
+            up = bool(passable[r - 1, c])
+            down = bool(passable[r + 1, c])
+            horiz = left and right and not up and not down
+            vert = up and down and not left and not right
+            if horiz ^ vert:
