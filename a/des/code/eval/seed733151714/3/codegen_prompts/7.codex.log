+    h, w = grid.shape
+    for dr, dc in ((2, 0), (-2, 0), (0, 2), (0, -2)):
+        rr = r + dr
+        cc = c + dc
+        mr = r + dr // 2
+        mc = c + dc // 2
+        if 0 <= rr < h and 0 <= cc < w and int(grid[rr, cc]) == int(color) and int(grid[mr, mc]) == BLACK:
+            return True
+    return False
