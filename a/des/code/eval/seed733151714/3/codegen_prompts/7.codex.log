+        second_choices = [nbr for nbr in _lattice_neighbors(first, rows, cols) if nbr != anchor and nbr not in used]
+        if second_choices:
+            second = second_choices[int(rng.integers(len(second_choices)))]
+            branch.append(second)
+    return branch
