+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if int(grid[r, c]) != BLACK:
+                continue
+            up = int(grid[r - 1, c])
+            down = int(grid[r + 1, c])
+            left = int(grid[r, c - 1])
+            right = int(grid[r, c + 1])
+            if up == down and up not in SPECIAL_COLORS:
