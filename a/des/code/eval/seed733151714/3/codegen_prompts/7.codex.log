+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(RNG)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid maze-door-gem sample")

