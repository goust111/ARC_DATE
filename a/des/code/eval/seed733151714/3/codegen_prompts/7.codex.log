+
+def _make_main_path(rows: int, cols: int, rng: np.random.Generator):
+    start_r = int(rng.integers(rows))
+    end_r = int(rng.integers(rows))
+    column_rows = [int(rng.integers(rows)) for _ in range(cols)]
