+    expected_gems = []
+    seen_nodes = set()
+    for node in spec["route_nodes"]:
+        if node in seen_nodes:
+            continue
+        seen_nodes.add(node)
+        if node in spec["gem_by_node"]:
+            expected_gems.append(int(spec["gem_by_node"][node]))
