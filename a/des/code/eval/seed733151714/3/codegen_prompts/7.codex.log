+    crop_r1 = min(h - 1, int(pts[:, 0].max()) + 1)
+    crop_c0 = max(0, int(pts[:, 1].min()) - 1)
+    crop_c1 = min(w - 1, int(pts[:, 1].max()) + 1)
+    grid = grid[crop_r0 : crop_r1 + 1, crop_c0 : crop_c1 + 1].copy()
