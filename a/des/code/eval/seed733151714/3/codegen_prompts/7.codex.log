+def _room_bbox(node, row_starts, col_starts, row_heights, col_widths):
+    r, c = node
+    r0 = int(row_starts[r])
+    c0 = int(col_starts[c])
+    return r0, r0 + int(row_heights[r]) - 1, c0, c0 + int(col_widths[c]) - 1
