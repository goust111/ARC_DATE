+++ b/a/des/seed733151714.arc-codegen-similar/3/3.py
@@ -0,0 +1,329 @@
+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # up, right, down, left
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                pts.append((rr, cc))
+                for dr, dc in DIRS:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_legend(g: np.ndarray) -> tuple[int, dict[int, int]]:
+    plus = np.array(
+        [
+            [False, True, False],
+            [True, True, True],
+            [False, True, False],
+        ],
+        dtype=bool,
+    )
+    candidates: list[tuple[int, int, int, dict[int, int]]] = []
+    h, w = g.shape
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            sub = g[r - 1 : r + 2, c - 1 : c + 2]
+            mask = (sub != BG) & (sub != FRAME)
+            if not np.array_equal(mask, plus):
+                continue
+            center = int(g[r, c])
+            color_to_dir = {
+                int(g[r - 1, c]): 0,
+                int(g[r, c + 1]): 1,
+                int(g[r + 1, c]): 2,
+                int(g[r, c - 1]): 3,
+            }
+            colors = [center] + list(color_to_dir)
+            if len(set(colors)) != 5:
+                continue
+            candidates.append((r, c, center, color_to_dir))
+    assert candidates, "expected a bottom-right legend cross"
+    _, _, center_color, color_to_dir = max(candidates, key=lambda item: (item[0], item[1]))
+    return center_color, color_to_dir
+
+
+def _find_frames(g: np.ndarray) -> list[tuple[int, int, int, int]]:
+    frames: list[tuple[int, int, int, int]] = []
+    for pts in _components(g == FRAME):
+        r0, c0, r1, c1 = _bbox(pts)
+        height = r1 - r0 + 1
+        width = c1 - c0 + 1
+        if height < 3 or width < 3:
+            continue
+        if len(pts) != 2 * (height + width) - 4:
+            continue
+        sub = g[r0 : r1 + 1, c0 : c1 + 1]
+        if not (
+            np.all(sub[0, :] == FRAME)
+            and np.all(sub[-1, :] == FRAME)
+            and np.all(sub[:, 0] == FRAME)
+            and np.all(sub[:, -1] == FRAME)
+        ):
+            continue
+        frames.append((r0, c0, r1, c1))
+    frames.sort()
+    return frames
+
+
+def _frame_seed(
+    g: np.ndarray, bbox: tuple[int, int, int, int]
+) -> tuple[int, tuple[int, int], tuple[int, int], int]:
+    r0, c0, r1, c1 = bbox
+    h, w = g.shape
