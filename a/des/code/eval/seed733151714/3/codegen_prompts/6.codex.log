    return r0 <= r <= r1 and c0 <= c <= c1


def _outside_both_frame_axes(p: tuple[int, int], b: tuple[int, int, int, int]) -> bool:
    r, c = p
    r0, c0, r1, c1 = b
    return (r < r0 - FRAME_RADIUS or r > r1 + FRAME_RADIUS) and (
