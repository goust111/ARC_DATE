+
+
+def _build_overlap_input() -> np.ndarray | None:
+    height = random.randint(12, 18)
+    width = random.randint(12, 20)
+    terrain_heights = _random_walk_heights(height, width)
+
+    gaps = [gap for gap in (3, 5, 7) if gap <= width - 5]
+    if not gaps:
