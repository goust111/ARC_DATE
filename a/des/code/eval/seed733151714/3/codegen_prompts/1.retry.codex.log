    38	def _l_anchor_present(pts: set[tuple[int, int]], r: int, c: int, arm1: tuple[int, int], arm2: tuple[int, int]) -> bool:
    39	    """
    40	    Marker corners are L-shapes:
    41	      TL: (r,c), (r,c+1), (r+1,c)
    42	      TR: (r,c), (r,c-1), (r+1,c)
    43	      BL: (r,c), (r,c+1), (r-1,c)
    44	      BR: (r,c), (r,c-1), (r-1,c)
    45	
    46	    This is more robust than checking only corner membership, especially when the bbox is 2-wide/2-tall
    47	    where L arms can overlap other bbox corners.
    48	    """
    49	    (dr1, dc1) = arm1
    50	    (dr2, dc2) = arm2
    51	    return (r, c) in pts and (r + dr1, c + dc1) in pts and (r + dr2, c + dc2) in pts
