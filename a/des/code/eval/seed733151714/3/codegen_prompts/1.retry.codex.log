    11	def main(grid: np.ndarray) -> np.ndarray:
    12	    """
    13	    Move the repeated boundary color's rectangles one block inward while leaving singleton boundary rectangles in place.
    14	
    15	    Input structure:
    16	    - The background is the most common color.
    17	    - Foreground objects are solid monochrome rectangles touching a grid corner.
    18	    - Exactly one foreground color appears as multiple separate 4-connected objects; other colors appear once.
    19	
    20	    Rule:
    21	    - Clear the multiple objects of the repeated color from their original positions.
    22	    - For each cleared rectangle, translate it away from the row and column border it touches by exactly its height and width.
    23	    - Keep singleton-color objects unchanged; overlapping translated rectangles of the same color merge.
    24	
    25	    Key insight:
    26	    - Multiplicity selects the moving color, and each boundary rectangle's touched edges determine its inward diagonal translation.
    27	    """
    28	    g = np.asarray(grid, dtype=int)
    29	    H, W = g.shape
    30	    bg = int(get_bg(g))
    31	
    32	    by_color: dict[int, list[dict]] = defaultdict(list)
    33	    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
    34	        by_color[int(comp["color"])].append(comp)
    35	
    36	    moving_colors = [color for color, comps in by_color.items() if len(comps) > 1]
    37	    assert len(moving_colors) == 1
    38	    moving_color = int(moving_colors[0])
    39	    moving_objects = by_color[moving_color]
    40	
    41	    out = g.copy()
    42	    for comp in moving_objects:
    43	        coords = comp["coords"]
    44	        out[coords[:, 0], coords[:, 1]] = bg
    45	
    46	    for comp in moving_objects:
    47	        coords = comp["coords"]
    48	        r0, c0, r1, c1 = map(int, comp["bbox"])
    49	        height = int(r1 - r0 + 1)
    50	        width = int(c1 - c0 + 1)
    51	        assert int(comp["area"]) == height * width
    52	
    53	        touches_top = r0 == 0
    54	        touches_bottom = r1 == H - 1
    55	        touches_left = c0 == 0
    56	        touches_right = c1 == W - 1
    57	        assert touches_top != touches_bottom
    58	        assert touches_left != touches_right
    59	
    60	        dr = height if touches_top else -height
    61	        dc = width if touches_left else -width
    62	        shifted = coords + np.array([dr, dc], dtype=int)
    63	        assert bool(
    64	            np.all(
    65	                (0 <= shifted[:, 0])
    66	                & (shifted[:, 0] < H)
    67	                & (0 <= shifted[:, 1])
    68	                & (shifted[:, 1] < W)
    69	            )
    70	        )
    71	
    72	        target = out[shifted[:, 0], shifted[:, 1]]
    73	        assert bool(np.all((target == bg) | (target == moving_color)))
    74	        out[shifted[:, 0], shifted[:, 1]] = moving_color
    75	
    76	    return out
