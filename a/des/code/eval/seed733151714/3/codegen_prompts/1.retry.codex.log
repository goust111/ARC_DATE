     8	def main(grid: np.ndarray) -> np.ndarray:
     9	    """
    10	    Match sprites to frames by connected-hole count, then nest each sprite inside its frame.
    11	
    12	    Input structure:
    13	    - bg = azure (8). Large hollow squares (frames) arranged in a grid; smaller filled squares (sprites) placed elsewhere.
    14	    - Each frame and sprite has a distinct color. Sprites may contain holes (non-sprite-color pixels).
    15	
    16	    Rule:
    17	    - Frames form a regular grid; some may be bg-colored (invisible).
    18	    - Count connected hole regions inside each frame's interior and each sprite.
    19	    - Pair each frame with the sprite sharing the same hole count.
    20	    - Place the matched sprite inside the frame border; recolor sprite holes to the frame's color.
    21	
    22	    Key insight: The matching key is the number of connected hole components, not hole area or color.
    23	    """
    24	    g = np.array(grid, dtype=int)
    25	    H, W = g.shape
    26	    BG = 8  # Azure background for this puzzle family
    27	
    28	    comps = find_components(g, bg=BG, connectivity=4, monochromatic=True, return_format="dict")
    29	
    30	    # Find square regions (lower fill threshold to catch sprites with holes).
    31	    MIN_FILL_RATIO = 0.5
    32	    square_regions: list[tuple[int, dict]] = []
    33	    for comp in comps:
    34	        b = comp["bbox"]
    35	        h = int(bbox_h(b))
    36	        w = int(bbox_w(b))
    37	        area = int(comp["area"])
    38	        if h == w and 4 <= h <= 10 and area >= int(h * h * MIN_FILL_RATIO):
    39	            square_regions.append((int(h), comp))
    40	
    41	    assert not (not square_regions)
    42	
    43	    # Group by size - frames are larger, sprites are smaller.
    44	    sizes: dict[int, list[dict]] = {}
    45	    for size, comp in square_regions:
    46	        sizes.setdefault(int(size), []).append(comp)
    47	
    48	    size_list = sorted(sizes.keys(), reverse=True)
    49	    frame_size = int(size_list[0])
    50	    sprite_size = int(size_list[1]) if len(size_list) > 1 else int(frame_size - 2)
    51	
    52	    frames = sizes.get(int(frame_size), [])
    53	    sprites_raw = sizes.get(int(sprite_size), [])
    54	    assert not (not frames)
    55	
    56	    # Determine frame grid structure from frame positions.
    57	    frame_positions = [(int(f["bbox"][0]), int(f["bbox"][1])) for f in frames]
    58	    min_r = min(r for r, c in frame_positions)
    59	    min_c = min(c for r, c in frame_positions)
    60	    max_r = max(r for r, c in frame_positions)
    61	    max_c = max(c for r, c in frame_positions)
    62	
    63	    n_rows = int((max_r - min_r) // frame_size + 1)
    64	    n_cols = int((max_c - min_c) // frame_size + 1)
    65	
    66	    # Build frame grid (including potential background-colored frames).
    67	    frame_grid = []
    68	    for ri in range(n_rows):
    69	        for ci in range(n_cols):
    70	            inp_r = int(min_r + ri * frame_size)
    71	            inp_c = int(min_c + ci * frame_size)
    72	            region = g[inp_r : inp_r + frame_size, inp_c : inp_c + frame_size]
    73	            border = np.concatenate([region[0, :], region[-1, :], region[:, 0], region[:, -1]])
    74	            frame_color = int(Counter(map(int, border.flatten())).most_common(1)[0][0])
