     8	def _find_legend(g: np.ndarray, bg: int) -> tuple[int, list[tuple[int, int, int]]]:
     9	    """
    10	    Legend is a vertical stack of pairs at bottom-left.
    11	    Each legend row: (marker_color at col c, fill_color at col c+1).
    12	    Returns (legend_col, entries) where entries are ordered bottom->top as (row, marker, fill).
    13	    """
    14	    h, w = g.shape
    15	    start_r = None
    16	    start_c = None
    17	    for r in range(h - 1, -1, -1):
    18	        nz = np.flatnonzero(g[r, :] != bg)
    19	        if nz.size:
    20	            start_r = r
    21	            start_c = int(nz[0])
    22	            break
    23	    assert start_r is not None and start_c is not None and start_c < w - 1, \
    24	        "legend must exist at bottom-left with at least 2 columns"
    25	
    26	    entries: list[tuple[int, int, int]] = []
    27	    c = start_c
    28	    for r in range(start_r, -1, -1):
    29	        nz = np.flatnonzero(g[r, :] != bg)
    30	        if nz.size == 0 or int(nz[0]) != c or int(g[r, c]) == bg:
    31	            break
    32	        marker = int(g[r, c])
    33	        fill = int(g[r, c + 1]) if c + 1 < w else bg
    34	        entries.append((r, marker, fill))
    35	    return c, entries
