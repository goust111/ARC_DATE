     8	def _runs(values):
     9	    runs = []
    10	    start = None
    11	    for i, value in enumerate(values):
    12	        if value and start is None:
    13	            start = i
    14	        elif not value and start is not None:
    15	            runs.append((start, i - 1))
    16	            start = None
    17	    if start is not None:
