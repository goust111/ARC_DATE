    22	def main(grid: np.ndarray) -> np.ndarray:
    23	    """
    24	    Expand the lower color grid by replacing each pixel with its matching top stencil.
    25	
    26	    Input structure
    27	    The input has a top legend and a lower dense color grid, separated by blank rows.
    28	    The legend contains left-to-right 2x2 color swatches and, to their right,
    29	    the same number of square neutral-color stencil masks.
    30	
    31	    Rule
    32	    Pair the swatches and stencil masks by left-to-right order. For every pixel in
    33	    the lower color grid, paste the paired stencil mask as one output block,
    34	    recoloring the mask pixels with that pixel's color and leaving mask holes as bg.
    35	
    36	    Key insight
    37	    The lower grid is not copied directly; it is an index grid whose colors select
    38	    the stencil shape from the legend, so each input pixel becomes one square block.
    39	    """
    40	    g = np.asarray(grid, dtype=int)
    41	    bg = get_bg(g)
    42	
    43	    row_runs = _runs(np.any(g != bg, axis=1))
    44	    assert len(row_runs) == 2
    45	    (top_r0, top_r1), (pattern_r0, pattern_r1) = row_runs
    46	    assert top_r0 == 0
    47	
    48	    stencil_size = top_r1 - top_r0 + 1
    49	    top = g[top_r0 : top_r1 + 1, :]
    50	    lower = g[pattern_r0 : pattern_r1 + 1, :]
    51	
    52	    pattern_box = bbox(lower != bg)
    53	    assert pattern_box is not None
    54	    pr0, pc0, pr1, pc1 = pattern_box
    55	    assert pr0 == 0 and pr1 == lower.shape[0] - 1
    56	    pattern = lower[:, pc0 : pc1 + 1]
    57	    assert np.all(pattern != bg)
    58	    pattern_colors = set(map(int, np.unique(pattern)))
    59	
    60	    top_colors = set(map(int, np.unique(top))) - {bg}
    61	    neutral_colors = top_colors - pattern_colors
    62	    assert len(neutral_colors) == 1
    63	    neutral = next(iter(neutral_colors))
    64	
    65	    swatches = []
    66	    for comp in find_components(top, bg=bg, colors=pattern_colors):
    67	        r0, c0, r1, c1 = comp["bbox"]
    68	        assert comp["area"] == 4
    69	        assert r1 - r0 + 1 == 2
    70	        assert c1 - c0 + 1 == 2
    71	        swatches.append((c0, int(comp["color"])))
    72	    assert len(swatches) == len(pattern_colors)
    73	    assert len({c0 for c0, _color in swatches}) == len(swatches)
    74	
    75	    swatch_colors = [color for _c0, color in sorted(swatches)]
    76	    assert set(swatch_colors) == pattern_colors
    77	
    78	    stencil_col_runs = _runs(np.any(top == neutral, axis=0))
    79	    assert len(stencil_col_runs) == len(swatch_colors)
    80	
    81	    stencils = {}
    82	    for color, (c0, c1) in zip(swatch_colors, stencil_col_runs):
    83	        assert c1 - c0 + 1 == stencil_size
    84	        mask = top[:, c0 : c1 + 1] == neutral
    85	        assert mask.shape == (stencil_size, stencil_size)
    86	        assert np.any(mask)
    87	        stencils[color] = mask
    88	
    89	    h, w = pattern.shape
    90	    out = np.full((h * stencil_size, w * stencil_size), bg, dtype=int)
    91	    for r in range(h):
    92	        for c in range(w):
    93	            color = int(pattern[r, c])
    94	            assert color in stencils
    95	            block = out[
    96	                r * stencil_size : (r + 1) * stencil_size,
    97	                c * stencil_size : (c + 1) * stencil_size,
    98	            ]
    99	            block[stencils[color]] = color
   100	    return out
