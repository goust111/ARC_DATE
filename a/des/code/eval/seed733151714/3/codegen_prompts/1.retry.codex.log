    54	def _diamond_mask(h: int, w: int, r0: int, r1: int, c0: int, c1: int, a: tuple[int, int], b: tuple[int, int]) -> np.ndarray:
    55	    """
    56	    Mask for all cells inside [r0..r1]x[c0..c1] that lie on some shortest 4-neigh path between corners a and b:
    57	      dist(a,p) + dist(p,b) == dist(a,b)
    58	    """
    59	    ar, ac = a
    60	    br, bc = b
    61	    dab = abs(ar - br) + abs(ac - bc)
    62	    m = np.zeros((h, w), dtype=bool)
    63	    for r in range(r0, r1 + 1):
    64	        for c in range(c0, c1 + 1):
    65	            if abs(r - ar) + abs(c - ac) + abs(r - br) + abs(c - bc) == dab:
    66	                m[r, c] = True
    67	    return m
