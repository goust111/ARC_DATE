    37	def _legend_mapping(g: np.ndarray, bg: int, grey: int) -> dict[int, int]:
    38	    """
    39	    Pick one 'legend' component per non-(bg,grey) color:
    40	      - component is at least 2x2,
    41	      - component does not touch the outer grid border (filters dividers).
    42	    Map hole_count -> legend_color.
    43	    """
    44	    h, w = g.shape
    45	    mapping: dict[int, int] = {}
    46	    colors = [c for c in sorted(set(map(int, np.unique(g)))) if c not in (bg, grey)]
    47	    for c in colors:
    48	        comps = components_mask(g == c, connectivity=4)
    49	        candidates = []
    50	        for pts in comps:
    51	            r0, c0, r1, c1 = bbox_coords(pts)
    52	            if r0 == 0 or c0 == 0 or r1 == h - 1 or c1 == w - 1:
    53	                continue
    54	            if (r1 - r0 + 1) < 2 or (c1 - c0 + 1) < 2:
    55	                continue
    56	            candidates.append((r0, c0, r1, c1))
    57	        if not candidates:
    58	            continue
    59	        assert len(candidates) == 1, f"color {c} must have exactly one legend component"
    60	        r0, c0, r1, c1 = candidates[0]
    61	        sub = (g[r0 : r1 + 1, c0 : c1 + 1] == c)
    62	        hc = _hole_count(sub)
    63	        assert hc not in mapping, f"legend hole count {hc} must map to exactly one color"
    64	        mapping[hc] = c
    65	    return mapping
