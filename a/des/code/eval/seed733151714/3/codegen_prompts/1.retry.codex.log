    86	        sprite_region = crop_bbox(g, b)
    87	        sprite_color = int(comp["color"])
    88	        hole_mask = sprite_region != int(sprite_color)
    89	        _lab, num_holes = label_mask(hole_mask, connectivity=4)
    90	        sprites.append({"color": int(sprite_color), "holes": int(num_holes), "content": sprite_region.copy(), "h": int(sprite_region.shape[0]), "w": int(sprite_region.shape[1])})
