+
+        bottom_margin = random.randint(*FRAME_MARGIN_RANGE)
+        right_margin = random.randint(*FRAME_MARGIN_RANGE)
+        frame_r = height - frame_h - bottom_margin
+        frame_c = width - frame_w - right_margin
