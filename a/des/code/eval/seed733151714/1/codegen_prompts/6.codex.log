+        return False
+    rr0 = max(0, r0 - padding)
+    cc0 = max(0, c0 - padding)
+    rr1 = min(height, r0 + h + padding)
+    cc1 = min(width, c0 + w + padding)
+    return not bool(occ[rr0:rr1, cc0:cc1].any())
