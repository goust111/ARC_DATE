+FRAME_MARGIN_RANGE = (1, 3)
+PLACEMENT_PADDING = 1
+BRANCH_RADIUS = 6
+BRANCH_LEN_RANGE = (2, 4)
+EXTRA_UNIQUE_BRANCH_PROB = 0.45
