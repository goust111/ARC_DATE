+    if min_h > GRID_HEIGHT_RANGE[1] or min_w > GRID_WIDTH_RANGE[1]:
+        return None
+
+    for _ in range(120):
+        height = random.randint(min_h, GRID_HEIGHT_RANGE[1])
+        width = random.randint(min_w, GRID_WIDTH_RANGE[1])
+        grid = np.full((height, width), BG, dtype=int)
