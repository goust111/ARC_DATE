+    if TRIPLE_OVERLAP in values:
+        out.add(3)
+    if any(v in SHAPE_COLOR_POOL for v in values):
+        out.add(1)
+    return out
+
+
+def _assemble_grid(
+    order: list[int],
+    rel_shapes: dict[int, tuple[tuple[int, int], ...]],
+    expected: np.ndarray,
+) -> np.ndarray | None:
+    frame_h, frame_w = expected.shape
+    patches = []
