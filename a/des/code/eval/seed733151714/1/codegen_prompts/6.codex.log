+        r0, c0, r1, c1 = _bbox(coords)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 3 or w < 3:
+            continue
+        sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+        border = np.zeros_like(sub, dtype=bool)
+        border[0, :] = True
+        border[-1, :] = True
+        border[:, 0] = True
+        border[:, -1] = True
+        if not np.all(sub[border] == FRAME):
+            continue
+        if np.any(sub[1:-1, 1:-1] != BG):
