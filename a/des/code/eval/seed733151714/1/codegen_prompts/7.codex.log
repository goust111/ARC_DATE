+def _layout_choices(n_regions: int) -> tuple[int, int]:
+    options = list(FACTOR_CHOICES[n_regions])
+    weights = []
+    for r, c in options:
+        weights.append(3 if r > 1 and c > 1 else 1)
+    return random.choices(options, weights=weights, k=1)[0]
