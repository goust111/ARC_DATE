+    return random.choices(options, weights=weights, k=1)[0]
+
+
+def _arrangement(shape: tuple[int, int], colors: list[int]) -> list[list[int]]:
+    rows, cols = shape
+    shuffled = colors[:]
+    random.shuffle(shuffled)
+    return [shuffled[i * cols : (i + 1) * cols] for i in range(rows)]
+
