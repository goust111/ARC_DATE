+def _balanced_symbols(n_regions: int) -> list[str]:
+    symbols = list(SYMBOLS)
+    extras = list(SYMBOLS)
+    random.shuffle(extras)
+    while len(symbols) < n_regions:
+        symbols.append(extras.pop())
+    random.shuffle(symbols)
+    return symbols
