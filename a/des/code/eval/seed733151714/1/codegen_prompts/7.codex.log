+
+def _symbol_shape(symbol: str) -> tuple[int, int]:
+    if symbol == "identity":
+        return 1, 1
+    if symbol == "hflip":
+        return 1, 3
+    if symbol == "vflip":
+        return 3, 1
+    if symbol == "rot90":
+        return 2, 2
+    raise AssertionError(symbol)
