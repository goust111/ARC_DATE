+
+def _render_expected(layout: list[list[int]], transformed: dict[int, np.ndarray], bg: int) -> np.ndarray:
+    rows = len(layout)
+    cols = len(layout[0])
+    cell_h, cell_w = next(iter(transformed.values())).shape
+    out = np.full((rows * cell_h, cols * cell_w), bg, dtype=int)
+    for r in range(rows):
