+    sh, sw = _symbol_shape(symbol)
+    choices: list[tuple[int, int]] = []
+    for top in range(1, size - sh):
+        for left in range(1, size - sw):
+            black_mask = _symbol_mask(size, symbol, top, left)
+            if symbol != "identity" and np.array_equal(
