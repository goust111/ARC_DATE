+    if len(coords) == 1:
+        return "identity"
+    if len(coords) == 3:
+        rows = sorted({int(r) for r, _ in coords})
+        cols = sorted({int(c) for _, c in coords})
+        if len(rows) == 1 and cols == list(range(cols[0], cols[0] + 3)):
+            return "hflip"
+        if len(cols) == 1 and rows == list(range(rows[0], rows[0] + 3)):
