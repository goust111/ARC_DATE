+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+AZURE = 8
+REGION_COLORS = (1, 2, 3, 4, 6, 7, 9)
+SYMBOLS = ("hflip", "vflip", "rot90", "identity")
