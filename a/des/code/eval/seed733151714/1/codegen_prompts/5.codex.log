import random
from collections import Counter,defaultdict
DIRS={\"up\":(-1,0),\"down\":(1,0),\"left\":(0,-1),\"right\":(0,1)}

def build():
    margin=random.choice([1,2])
    hs=[random.randint(3,4), random.randint(7,9)]
    ws=[random.randint(7,9), random.randint(3,4)]
    # randomize which row is small/big and which col is wide/narrow
    if random.random()<0.5: hs.reverse()
    if random.random()<0.5: ws.reverse()
    H=2*margin+2+sum(hs)+1
    W=2*margin+2+sum(ws)+1
    boxes=[]
    r=margin+1
    for h in hs:
        c=margin+1
        for w in ws:
            boxes.append((r,c,r+h-1,c+w-1))
            c+=w+1
        r+=h+1
    region_map=[[-1]*W for _ in range(H)]
    for idx,(r0,c0,r1,c1) in enumerate(boxes):
        for rr in range(r0,r1+1):
            for cc in range(c0,c1+1):
                region_map[rr][cc]=idx
    return margin,H,W,boxes,region_map,hs,ws

def infer(box, seed):
    r0,c0,r1,c1=box
    cr=(r0+r1)/2
    cc=(c0+c1)/2
    dr=seed[0]-cr
    dc=seed[1]-cc
    if abs(dr) < 1e-9 and abs(dc) < 1e-9:
        return None
    if abs(dr) > abs(dc):
        return 'down' if dr>0 else 'up'
    if abs(dc) > abs(dr):
        return 'right' if dc>0 else 'left'
    return None

def candidates(built):
    margin,H,W,boxes,region_map,hs,ws=built
    frame_top=margin; frame_left=margin; frame_bottom=H-margin-1; frame_right=W-margin-1
    out=[]
    for idx,box in enumerate(boxes):
        r0,c0,r1,c1=box
        h=r1-r0+1; w=c1-c0+1
        opts=[]
        for r in range(r0,r1+1):
            for c in range(c0,c1+1):
                d=infer(box,(r,c))
                if not d:
                    continue
                L=h if d in ('left','right') else w
                dr,dc=DIRS[d]
                er,ec=r+dr*L,c+dc*L
                if not (frame_top+1 <= er <= frame_bottom-1 and frame_left+1 <= ec <= frame_right-1):
                    continue
                target=region_map[er][ec]
                if target<0:
                    continue
                opts.append((d,target==idx,(r,c),(er,ec),target))
        out.append(opts)
    return out

def choose(cands):
    order=sorted(range(len(cands)), key=lambda i: len(cands[i]))
    used_draw=set(); used_seeds=[]
    chosen={}; dir_counts=Counter(); outcome=Counter()
    for pos,rid in enumerate(order):
        opts=[]
        missing={d for d in DIRS if dir_counts[d]==0}
        for d,same,seed,end,target in cands[rid]:
            r,c=seed
            r2,c2=end
            L=abs(r2-r)+abs(c2-c)
            dr=0 if r2==r else (1 if r2>r else -1)
            dc=0 if c2==c else (1 if c2>c else -1)
            draw=set((r+dr*k,c+dc*k) for k in range(1,L+1))
            draw|={(r2+fr,c2+fc) for fr in(-1,0,1) for fc in(-1,0,1)}
            if draw & used_draw or seed in used_draw or any(s in draw for s in used_seeds):
                continue
            opts.append((d,same,seed,draw))
        if not opts:
            return None
        opts.sort(key=lambda x: (0 if x[0] in missing else 1, dir_counts[x[0]], outcome[x[1]]))
        best=[o for o in opts if (0 if o[0] in missing else 1, dir_counts[o[0]], outcome[o[1]]) == (0 if opts[0][0] in missing else 1, dir_counts[opts[0][0]], outcome[opts[0][1]])]
        d,same,seed,draw=random.choice(best)
        chosen[rid]=(d,same,seed)
        used_draw|=draw
        used_seeds.append(seed)
        dir_counts[d]+=1
        outcome[same]+=1
    if set(d for d,_,_ in chosen.values())"'!=set(DIRS):
        return None
    if not (outcome[True] and outcome[False]):
        return None
    return chosen

success=0
for _ in range(200):
    built=build()
    cands=candidates(built)
    union={o[0] for opts in cands for o in opts}
    same=sum(1 for opts in cands for o in opts if o[1])
    diff=sum(1 for opts in cands for o in opts if not o[1])
    if union!=set(DIRS) or same==0 or diff==0 or any(not opts for opts in cands):
        continue
    if choose(cands):
        success+=1
        if success<10:
            print('"'hs ws',built[5],built[6],'per', [Counter((o[0],o[1]) for o in opts) for opts in cands])
print('success',success)
