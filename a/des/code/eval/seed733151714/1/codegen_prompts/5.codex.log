        random.shuffle(opts)
        for o in opts:
            if o['draw'] & used_draw or o['seed'] in used_draw or any(s in o['draw'] for s in seeds):
                continue
            chosen[rid]=o; seeds.append(o['seed']); used_draw.update(o['draw'])
