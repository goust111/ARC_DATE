+
+            stem = {
+                (int(seed_r + dr * step), int(seed_c + dc * step))
+                for step in range(1, length + 1)
+            }
+            flower = {
+                (int(end_r + fr), int(end_c + fc))
+                for fr in (-1, 0, 1)
+                for fc in (-1, 0, 1)
+            }
+            by_dir[direction].append(
+                {
+                    "region": region_idx,
+                    "seed": (int(seed_r), int(seed_c)),
+                    "dir": direction,
+                    "length": int(length),
+                    "endpoint": (int(end_r), int(end_c)),
+                    "target": int(target),
+                    "same": bool(target == region_idx),
+                    "stem": stem,
+                    "flower": flower,
+                    "draw": stem | flower,
