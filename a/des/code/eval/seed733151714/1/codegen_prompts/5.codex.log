+                        )
+                        flower_overlap += len(
+                            set(picks[i]["flower"]) & set(picks[j]["flower"])
+                        )
+                score = (flower_overlap * 10 + total_overlap, flower_overlap, total_overlap)
+                if best_score is None or score < best_score:
+                    best_score = score
+                    best_specs = [dict(pick) for pick in picks]
+                return
