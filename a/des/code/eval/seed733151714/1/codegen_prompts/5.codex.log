    dr=seed[0]-cr; dc=seed[1]-cc
    if abs(dr)<1e-9 and abs(dc)<1e-9: return None
    if abs(dr)>abs(dc): return 'down' if dr>0 else 'up'
    if abs(dc)>abs(dr): return 'right' if dc>0 else 'left'
    return None

def cands(b):
