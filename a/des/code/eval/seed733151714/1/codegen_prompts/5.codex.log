+                    "seed": (int(seed_r), int(seed_c)),
+                    "dir": direction,
+                    "length": int(length),
+                    "endpoint": (int(end_r), int(end_c)),
+                    "target": int(target),
+                    "same": bool(target == region_idx),
+                    "stem": stem,
+                    "flower": flower,
+                    "draw": stem | flower,
+                }
+            )
