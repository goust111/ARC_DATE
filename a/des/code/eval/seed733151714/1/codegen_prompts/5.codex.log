            for p in o['draw']: used_draw.remove(p)
            seeds.pop(); chosen.pop(rid)
        return False
    return bt(0)

for mode in ['wide','tall']:
    success=0
    for _ in range(1000):
        b=build(mode)
        if not b: continue
        cs=cands(b)
        if any(not x for x in cs): continue
        if search(cs): success+=1
    print(mode, success)
