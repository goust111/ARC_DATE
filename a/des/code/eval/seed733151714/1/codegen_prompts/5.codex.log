import random
from collections import Counter
DIRS={\"up\":(-1,0),\"down\":(1,0),\"left\":(0,-1),\"right\":(0,1)}

def build(mode):
    margin=1
    if mode=='h':
        rows=2
        cols=random.choice([3,4])
        hs=[random.randint(4,5) for _ in range(rows)]
        ws=[random.randint(7,10) for _ in range(cols)]
    else:
        rows=random.choice([3,4])
        cols=2
        hs=[random.randint(7,10) for _ in range(rows)]
        ws=[random.randint(4,5) for _ in range(cols)]
    H=2*margin+2+sum(hs)+(rows-1)
    W=2*margin+2+sum(ws)+(cols-1)
    if H>30 or W>30:
        return None
    boxes=[]
    r=margin+1
    for h in hs:
        c=margin+1
        for w in ws:
            boxes.append((r,c,r+h-1,c+w-1))
            c+=w+1
        r+=h+1
    region_map=[[-1]*W for _ in range(H)]
    for idx,(r0,c0,r1,c1) in enumerate(boxes):
        for rr in range(r0,r1+1):
            for cc in range(c0,c1+1):
                region_map[rr][cc]=idx
    return margin,H,W,boxes,region_map

def infer(box, seed):
    r0,c0,r1,c1=box
    cr=(r0+r1)/2
    cc=(c0+c1)/2
    dr=seed[0]-cr
    dc=seed[1]-cc
    if abs(dr) < 1e-9 and abs(dc) < 1e-9:
        return None
    if abs(dr) > abs(dc):
        return 'down' if dr>0 else 'up'
    if abs(dc) > abs(dr):
        return 'right' if dc>0 else 'left'
    return None

def scan(built):
    margin,H,W,boxes,region_map=built
    frame_top=margin; frame_left=margin; frame_bottom=H-margin-1; frame_right=W-margin-1
    same=diff=0
    dirs=Counter()
    per=[]
    for idx,box in enumerate(boxes):
        r0,c0,r1,c1=box
        h=r1-r0+1; w=c1-c0+1
        local=[]
        for r in range(r0,r1+1):
            for c in range(c0,c1+1):
                d=infer(box,(r,c))
                if not d:
                    continue
                L=h if d in ('left','right') else w
                dr,dc=DIRS[d]
                er,ec=r+dr*L,c+dc*L
                if not (frame_top+1 <= er <= frame_bottom-1 and frame_left+1 <= ec <= frame_right-1):
                    continue
                target=region_map[er][ec]
                if target < 0:
                    continue
                dirs[d]+=1
                same += target==idx
                diff += target"'!=idx
                local.append((d,target==idx))
        per.append(Counter(local))
    return H,W,dirs,same,diff,per

for mode in ['"'h','v']:
    ok=0
    for _ in range(20):
        built=build(mode)
        if not built: continue
        H,W,dirs,same,diff,per=scan(built)
        print(mode,H,W,dirs,same,diff)
        if same and diff:
            ok+=1
    print('mode',mode,'both',ok)
