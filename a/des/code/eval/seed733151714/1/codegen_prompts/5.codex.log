+
+    specs = _choose_specs(groups)
+    if specs is None:
+        return None
+
+    region_colors = random.sample(SEED_COLORS, 4)
+    for region_idx, spec in enumerate(specs):
+        sr, sc = spec["seed"]  # type: ignore[index]
+        grid[int(sr), int(sc)] = int(region_colors[region_idx])
