+            end_r = int(seed_r + dr * length)
+            end_c = int(seed_c + dc * length)
+            if not (
+                frame_top + 1 <= end_r <= frame_bottom - 1
+                and frame_left + 1 <= end_c <= frame_right - 1
+            ):
+                continue
+
+            target = int(region_map[end_r, end_c])
+            if target < 0:
