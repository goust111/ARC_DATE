    r0,c0,r1,c1=box
    cr=(r0+r1)/2; cc=(c0+c1)/2
    dr=seed[0]-cr; dc=seed[1]-cc
    if abs(dr)<1e-9 and abs(dc)<1e-9: return None
    if abs(dr)>abs(dc): return 'down' if dr>0 else 'up'
    if abs(dc)>abs(dr): return 'right' if dc>0 else 'left'
    return None

def cands(built):
    margin,H,W,boxes,region_map=built
    ft=fl=margin; fb=H-margin-1; fr=W-margin-1
    res=[]
    for idx,box in enumerate(boxes):
        r0,c0,r1,c1=box; h=r1-r0+1; w=c1-c0+1
        opts=[]
        for r in range(r0,r1+1):
            for c in range(c0,c1+1):
                d=infer(box,(r,c))
                if not d: continue
                L=h if d in ('left','right') else w
                dr,dc=DIRS[d]
                er,ec=r+dr*L,c+dc*L
                if not (ft+1 <= er <= fb-1 and fl+1 <= ec <= fr-1): continue
                target=region_map[er][ec]
                if target<0: continue
                draw={(r+dr*k,c+dc*k) for k in range(1,L+1)}
                draw|={(er+fr2,ec+fc2) for fr2 in(-1,0,1) for fc2 in(-1,0,1)}
                opts.append({'dir':d,'same':target==idx,'seed':(r,c),'draw':draw})
        res.append(opts)
    return res

