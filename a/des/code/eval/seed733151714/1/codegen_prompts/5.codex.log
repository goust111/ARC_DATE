+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+DIR_ORDER = ("up", "down", "left", "right")
+DIR_VECS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_RETRY_LIMIT = 300
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(int(r), int(c))]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _touches_edge(coords: np.ndarray, h: int, w: int) -> bool:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return bool(
+        np.any((rows == 0) | (rows == h - 1) | (cols == 0) | (cols == w - 1))
+    )
+
+
+def _direction_from_coords(
+    coords: np.ndarray, seed: tuple[int, int]
+) -> str | None:
+    center = coords.mean(axis=0)
+    dr = float(seed[0]) - float(center[0])
+    dc = float(seed[1]) - float(center[1])
+    if abs(dr) < 1e-9 and abs(dc) < 1e-9:
+        return None
+    if abs(dr) > abs(dc):
+        return "down" if dr > 0 else "up"
+    if abs(dc) > abs(dr):
+        return "right" if dc > 0 else "left"
+    return None
+
+
+def _extract_regions(
+    grid: np.ndarray,
+) -> tuple[list[dict[str, object]], np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    region_map = np.full((h, w), -1, dtype=int)
+    regions: list[dict[str, object]] = []
+
+    for coords in _components(g != GREY):
+        if _touches_edge(coords, h, w):
+            continue
