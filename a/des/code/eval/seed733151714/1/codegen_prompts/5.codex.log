        square = squares[idx]
        for target in _pink_targets_for_markers(markers, square):
            tr, tc = target
            assert g[tr, tc] == square[4]
            paint.add(target)

    for r, c in remove_sources:
        out[r, c] = bg
    for r, c in paint:
        out[r, c] = Color.MAROON

