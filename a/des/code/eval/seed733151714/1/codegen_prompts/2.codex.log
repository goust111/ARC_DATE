+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+DIRS: dict[str, tuple[int, int]] = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+OPPOSITE = {"up": "down", "down": "up", "left": "right", "right": "left"}
+
+
+def _neighbors4(r: int, c: int, height: int, width: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < height:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < width:
+        yield r, c + 1
+
+
+def _connected_components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    height, width = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    components: list[np.ndarray] = []
+    for r in range(height):
+        for c in range(width):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, height, width):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+    return components
+
+
+def _touches_border(coords: np.ndarray, height: int, width: int) -> bool:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return bool(
+        np.any(rows == 0)
+        or np.any(rows == height - 1)
+        or np.any(cols == 0)
+        or np.any(cols == width - 1)
+    )
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _infer_background(g: np.ndarray) -> int:
+    colors, counts = np.unique(g, return_counts=True)
+    return int(colors[int(np.argmax(counts))])
+
+
+def _infer_wall_color(g: np.ndarray, bg: int) -> int:
+    wall_pixels = g[g != int(bg)]
+    colors, counts = np.unique(wall_pixels, return_counts=True)
+    assert len(colors) > 0
+    return int(colors[int(np.argmax(counts))])
+
+
+def _monochrome_components(g: np.ndarray, excluded: set[int]) -> list[dict]:
+    height, width = g.shape
+    seen = np.zeros((height, width), dtype=bool)
+    components: list[dict] = []
+    for r in range(height):
+        for c in range(width):
+            color = int(g[r, c])
+            if color in excluded or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
