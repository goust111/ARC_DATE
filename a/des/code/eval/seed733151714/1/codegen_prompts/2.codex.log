+def _mask_value(mask: np.ndarray, r: int, c: int) -> bool:
+    height, width = mask.shape
+    return 0 <= r < height and 0 <= c < width and bool(mask[r, c])
+
+
+def _dilate4(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    out[1:, :] |= mask[:-1, :]
+    out[:-1, :] |= mask[1:, :]
