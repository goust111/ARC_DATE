+
+
+def _slot_positions(zone_h: int, zone_w: int) -> list[tuple[int, int]]:
+    del zone_h, zone_w
+    return [(1, 1), (1, 6), (4, 1), (4, 6)]
+
+
+def _place_keys(grid: np.ndarray, key_specs: list[dict], corner: str) -> bool:
