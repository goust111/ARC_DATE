+        return 0, 0, zone_h, zone_w
+    if corner == "tr":
+        return 0, width - zone_w, zone_h, zone_w
+    if corner == "bl":
+        return height - zone_h, 0, zone_h, zone_w
+    return height - zone_h, width - zone_w, zone_h, zone_w
+
