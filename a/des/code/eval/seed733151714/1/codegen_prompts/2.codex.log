+        for door in chosen:
+            rr, cc = door["cell"]
+            closed[rr, cc] = WALL_COLOR
+        rooms = [
+            coords
+            for coords in _connected_components(closed == BG_COLOR)
+            if not _touches_border(coords, patch.shape[0], patch.shape[1])
+        ]
+        if len(rooms) != 1:
+            continue
+
+        return {
+            "patch": patch,
+            "doors": chosen,
+            "door_count": door_count,
+            "key_rel_coords": key_rel_coords,
