+def _rectangles_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int) -> bool:
+    ar, ac, ah, aw = a
+    br, bc, bh, bw = b
+    return not (
+        ar + ah + pad <= br
+        or br + bh + pad <= ar
+        or ac + aw + pad <= bc
+        or bc + bw + pad <= ac
+    )
