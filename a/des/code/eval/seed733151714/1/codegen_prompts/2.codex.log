+
+def _door_candidates(
+    interior: np.ndarray,
+    wall: np.ndarray,
+    key_rel_coords: list[tuple[int, int]],
+) -> list[dict]:
+    height, width = interior.shape
+    candidates: list[dict] = []
+    for r, c in np.argwhere(wall):
+        inward_dirs = [
+            name
+            for name, (dr, dc) in DIRS.items()
+            if _mask_value(interior, int(r + dr), int(c + dc))
