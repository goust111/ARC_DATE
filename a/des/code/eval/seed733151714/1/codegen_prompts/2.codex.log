+BG_COLOR = 0
+WALL_COLOR = 9
+KEY_COLOR_POOL = [1, 2, 3, 4, 5, 6, 7, 8]
+DOOR_COUNT_OPTIONS = [3, 4, 5, 6]
+GRID_SIDE_MIN = 24
+GRID_SIDE_MAX = 32
+ROOM_COUNT_OPTIONS = [2, 3, 4]
+KEY_ZONE_SHAPE = (8, 12)
