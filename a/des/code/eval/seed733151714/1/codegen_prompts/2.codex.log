            for dr, dc in _rotate_key(key["rel_coords"], inward[0]):
                rr = int(door_r + dr)
                cc = int(door_c + dc)
                assert 0 <= rr < height and 0 <= cc < width
                assert int(out[rr, cc]) == int(bg)
                out[rr, cc] = int(key["color"])

    return out


