+    rooms: list[dict] = []
+    key_specs_by_area: dict[int, dict] = {}
+    for door_count, color in zip(door_counts, key_colors):
+        rel_coords = _key_rel_coords(door_count)
+        room = _generate_room_patch(rel_coords, door_count)
+        if room is None:
+            return None
+        rooms.append(room)
+        key_specs_by_area[int(door_count)] = {
+            "color": int(color),
