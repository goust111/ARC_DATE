+
+def _try_place_success(
+    grid: np.ndarray,
+    occupied: set[tuple[int, int]],
+    reserved: set[tuple[int, int]],
+    color: int,
+    rng: np.random.Generator,
+    force_turn: bool,
+) -> dict | None:
+    h, w = grid.shape
+    blocked = occupied | reserved
+    gap_choices = {3: [1], 4: [1, 2]}
+    max_seg = max(2, min(h, w) // 4)
