+def _draw_tower(grid: np.ndarray, color: int, light: tuple[int, int], direction: tuple[int, int]) -> None:
+    pointer, body, _start = _tower_geometry(light, direction)
+    grid[light] = color
+    grid[pointer] = color
+    for r, c in body:
+        grid[r, c] = GREY
