+            cell = int(g[r, c])
+            if cell == BG:
+                out[r, c] = color
+                r += dr
+                c += dc
+                continue
+            if cell == YELLOW:
+                orient = mirror_by_cell[(r, c)]
+                dr, dc = _reflect((dr, dc), orient)
+                r += dr
+                c += dc
+                continue
+            break
+
+    return out, hits
