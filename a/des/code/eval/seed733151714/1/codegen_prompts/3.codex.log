+    for tower in towers:
+        color = int(tower["color"])
+        dr, dc = tower["direction"]
+        r = tower["pointer"][0] + dr
+        c = tower["pointer"][1] + dc
+        seen: set[tuple[int, int, int, int]] = set()
+
+        while _in_bounds(g.shape, r, c):
+            state = (r, c, dr, dc)
+            if state in seen:
+                break
+            seen.add(state)
