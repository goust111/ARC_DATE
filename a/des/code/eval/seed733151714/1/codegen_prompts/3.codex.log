+    if side == "top":
+        gap = (r0, c0 + gap_offset)
+    elif side == "bottom":
+        gap = (r0 + size - 1, c0 + gap_offset)
+    elif side == "left":
+        gap = (r0 + gap_offset, c0)
+    else:
