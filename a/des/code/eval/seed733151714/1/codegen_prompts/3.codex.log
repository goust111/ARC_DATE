+    for _ in range(SUCCESS_PLACEMENT_TRIES):
+        size = int(rng.choice([3, 4]))
+        r_min = 2
+        c_min = 2
+        r_max = h - size - 2
+        c_max = w - size - 2
+        if r_max < r_min or c_max < c_min:
