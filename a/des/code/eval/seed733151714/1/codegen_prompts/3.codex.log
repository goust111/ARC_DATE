+        direction = TOWER_DIRS[int(rng.integers(0, len(TOWER_DIRS)))]
+        if direction == (1, 0):
+            continue
+        light = (
+            int(rng.integers(1, h - 3)),
+            int(rng.integers(1, w - 1)),
