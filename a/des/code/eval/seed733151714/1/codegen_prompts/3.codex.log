+def _gap_side(r0: int, c0: int, size: int, gap: tuple[int, int]) -> str | None:
+    r, c = gap
+    if r == r0 and c0 < c < c0 + size - 1:
+        return "top"
+    if r == r0 + size - 1 and c0 < c < c0 + size - 1:
+        return "bottom"
+    if c == c0 and r0 < r < r0 + size - 1:
+        return "left"
+    if c == c0 + size - 1 and r0 < r < r0 + size - 1:
+        return "right"
+    return None
