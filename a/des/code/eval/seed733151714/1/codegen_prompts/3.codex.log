+        (r, c)
+        for r in range(r0 + 1, r0 + size - 1)
+        for c in range(c0 + 1, c0 + size - 1)
+    }
+    return {
+        "size": size,
+        "top_left": top_left,
+        "side": side,
+        "gap": gap,
+        "border": border,
+        "interior": interior,
+    }
+
+
+def _path_to_boundary(
+    start: tuple[int, int], direction: tuple[int, int], shape: tuple[int, int]
+) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    r, c = start
+    dr, dc = direction
+    while _in_bounds(shape, r, c):
+        cells.append((r, c))
+        r += dr
+        c += dc
+    return cells
+
