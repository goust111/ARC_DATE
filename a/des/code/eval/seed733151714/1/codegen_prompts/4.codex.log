+def _solve(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    fr0, fc0, fr1, fc1 = _find_frame_bbox(g)
+    inner_h = fr1 - fr0 - 1
+    inner_w = fc1 - fc0 - 1
