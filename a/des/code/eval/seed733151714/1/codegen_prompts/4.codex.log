+                if _can_place(occ, r0, c0, ph, pw):
+                    candidates.append((r0, c0))
+        if not candidates:
+            return None
+        r0, c0 = rng.choice(candidates)
+        placements[idx] = (r0, c0)
+        occ[r0 : r0 + ph, c0 : c0 + pw] = True
+
+    return [(r, c) for r, c in placements if r is not None]
+
