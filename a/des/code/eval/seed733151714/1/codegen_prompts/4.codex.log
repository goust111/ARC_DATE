+    piece_map: dict[tuple[tuple[int, int | None, int | None], tuple[int, int | None, int | None]], np.ndarray] = {}
+    for piece in pieces:
+        key = (piece["row_sig"], piece["col_sig"])
+        assert key not in piece_map
