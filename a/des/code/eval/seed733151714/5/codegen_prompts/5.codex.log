+        counts: Counter[int] = Counter()
+        top: dict[int, tuple[int, int]] = {}
+        votes: list[tuple[int, int, int]] = []
+        black_cells = 0
+        for r, c in cells:
+            color = int(grid[r, c])
+            if color == BLACK:
+                black_cells += 1
