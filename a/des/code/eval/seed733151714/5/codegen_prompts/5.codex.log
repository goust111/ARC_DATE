+            r0 = row_lines[r] + 1
+            r1 = row_lines[r + 1] - 1
+            grid[r0 : r1 + 1, wall_c] = BLACK
+        else:
+            wall_r = row_lines[r + 1]
+            c0 = col_lines[c] + 1
+            c1 = col_lines[c + 1] - 1
+            grid[wall_r, c0 : c1 + 1] = BLACK
