+            return True
+    return False
+
+
+def _cell_targets(grid: np.ndarray, labels: np.ndarray, rid: int, r: int, c: int) -> set[int]:
+    targets = set()
+    for dr, dc in DIR4:
+        wr = r + dr
+        wc = c + dc
+        tr = r + 2 * dr
+        tc = c + 2 * dc
+        if not _in_bounds(grid.shape, wr, wc) or not _in_bounds(grid.shape, tr, tc):
+            continue
