+def _gap_side(gap: tuple[int, int], r0: int, c0: int, r1: int, c1: int) -> str | None:
+    r, c = gap
+    sides: list[str] = []
+    if r == r0 and c0 < c < c1:
+        sides.append("top")
+    if c == c1 and r0 < r < r1:
+        sides.append("right")
+    if r == r1 and c0 < c < c1:
+        sides.append("bottom")
+    if c == c0 and r0 < r < r1:
