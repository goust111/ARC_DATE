+        return 0, idx
+    if side == "right":
+        return idx, size - 1
+    if side == "bottom":
+        return size - 1, idx
+    return idx, 0
+
+
+def _place_turntable(
+    g: np.ndarray,
+    r0: int,
+    c0: int,
+    size: int,
+    ring_color: int,
+    side: str,
+    inner: np.ndarray,
+) -> None:
