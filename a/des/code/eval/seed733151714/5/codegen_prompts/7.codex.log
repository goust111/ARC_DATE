+def _can_place(blocked: np.ndarray, r0: int, c0: int, size: int) -> bool:
+    h, w = blocked.shape
+    if r0 < 1 or c0 < 1 or r0 + size >= h or c0 + size >= w:
+        return False
+    rr0 = max(0, r0 - PAD)
+    cc0 = max(0, c0 - PAD)
+    rr1 = min(h, r0 + size + PAD)
+    cc1 = min(w, c0 + size + PAD)
