+def _perimeter_coords(r0: int, c0: int, size: int) -> set[tuple[int, int]]:
+    coords: set[tuple[int, int]] = set()
+    r1 = r0 + size - 1
+    c1 = c0 + size - 1
+    for c in range(c0, c1 + 1):
+        coords.add((r0, c))
+        coords.add((r1, c))
+    for r in range(r0, r1 + 1):
