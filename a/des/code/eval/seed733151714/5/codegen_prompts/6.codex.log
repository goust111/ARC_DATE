+    r: int, c: int, center2: tuple[int, int], turns_cw: int
+) -> tuple[int, int]:
+    turns = turns_cw % 4
+    y2 = 2 * r - center2[0]
+    x2 = 2 * c - center2[1]
+    if turns == 1:
+        y2, x2 = x2, -y2
+    elif turns == 2:
