+            item["bbox"][0],
+        ),
+        reverse=True,
+    )
+
+    center2 = (
+        rings[0]["bbox"][0] + rings[0]["bbox"][2],
+        rings[0]["bbox"][1] + rings[0]["bbox"][3],
