+
+        left_space = _count_open_cells(shape, pivot, left_dir, all_nonblack | {hit})
+        right_space = _count_open_cells(shape, pivot, right_dir, all_nonblack | {hit})
+        if left_space > right_space:
+            mode = "left"
+            new_dir = left_dir
+        elif right_space > left_space:
+            mode = "right"
+            new_dir = right_dir
+        else:
