+
+def _space_count(
+    grid: np.ndarray,
+    nonblack: set[tuple[int, int]],
+    start: tuple[int, int],
+    direction: tuple[int, int],
+) -> int:
+    h, w = grid.shape
+    r, c = start
+    dr, dc = direction
+    count = 0
+    while True:
+        r += dr
+        c += dc
+        if not (0 <= r < h and 0 <= c < w):
+            break
+        if (r, c) in nonblack:
+            break
+        if int(grid[r, c]) != BLACK:
+            break
+        count += 1
+    return count
+
+
+def _reflected_direction(
+    grid: np.ndarray,
