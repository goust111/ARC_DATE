+                shape,
+                current,
+                current_dir,
+                local_nonblack,
+                global_nonblack | reserved_nonblack,
+                local_path,
+                global_path,
+                preferred_mode,
+            )
+            if not options:
+                success = False
+                break
+            option = random.choice(options)
+            for cell in option["advance_cells"]:
+                local_path.add(cell)
+            for cell in option["mirror_cells"]:
+                local_nonblack.add(cell)
+                mirrors.append(cell)
+            local_sight |= option["sight"]
+            current = option["pivot"]
+            current_dir = option["new_dir"]
+
+        if not success:
+            continue
