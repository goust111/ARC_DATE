+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+GREY = 5
+SEED_COLORS = (1, 2, 3, 6, 7, 8, 9)
+
+UP = (-1, 0)
+RIGHT = (0, 1)
+DOWN = (1, 0)
+LEFT = (0, -1)
+DIRS = (UP, RIGHT, DOWN, LEFT)
+RIGHT_TURN = {UP: RIGHT, RIGHT: DOWN, DOWN: LEFT, LEFT: UP}
+LEFT_TURN = {UP: LEFT, LEFT: DOWN, DOWN: RIGHT, RIGHT: UP}
