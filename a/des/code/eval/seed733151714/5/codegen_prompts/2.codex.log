+        sight = _line_to_boundary(shape, pivot, left_dir) | _line_to_boundary(shape, pivot, right_dir)
+        options.append(
+            {
+                "advance_cells": forward_cells,
+                "pivot": pivot,
+                "hit": hit,
+                "new_dir": new_dir,
+                "mode": mode,
+                "mirror_cells": random.choice(mirror_candidates),
+                "sight": sight,
+            }
+        )
