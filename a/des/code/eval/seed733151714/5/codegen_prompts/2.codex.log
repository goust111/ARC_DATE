+def _cells_along(start: tuple[int, int], direction: tuple[int, int], steps: int) -> list[tuple[int, int]]:
+    r, c = start
+    dr, dc = direction
+    return [(r + dr * i, c + dc * i) for i in range(1, steps + 1)]
