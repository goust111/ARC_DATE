+GRID_H_RANGE = (13, 22)
+GRID_W_RANGE = (13, 22)
+SEED_COUNT_CHOICES = (1, 2, 3)
+SEED_COUNT_WEIGHTS = (2, 3, 2)
+TURN_COUNT_CHOICES = (0, 1, 2, 3)
+TURN_COUNT_WEIGHTS = (1, 3, 3, 2)
