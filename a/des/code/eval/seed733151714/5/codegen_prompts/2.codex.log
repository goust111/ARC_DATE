+    return options
+
+
+def _build_ray(
+    shape: tuple[int, int],
+    color: int,
+    global_nonblack: set[tuple[int, int]],
+    global_path: set[tuple[int, int]],
+    reserved_nonblack: set[tuple[int, int]],
+    target_turns: int,
