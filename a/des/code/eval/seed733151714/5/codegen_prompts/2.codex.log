+        length = random.randint(MIRROR_LENGTH_RANGE[0], MIRROR_LENGTH_RANGE[1])
+        if orientation == "horizontal":
+            r = random.randrange(h)
+            c0 = random.randrange(w - length + 1)
+            cells = [(r, c0 + i) for i in range(length)]
