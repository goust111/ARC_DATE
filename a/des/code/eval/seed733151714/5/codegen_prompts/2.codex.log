+
+def _mirror_segments(
+    shape: tuple[int, int],
+    hit: tuple[int, int],
+    incoming: tuple[int, int],
+    blocked_nonblack: set[tuple[int, int]],
+    blocked_path: set[tuple[int, int]],
+    existing_grey: set[tuple[int, int]],
+) -> list[list[tuple[int, int]]]:
