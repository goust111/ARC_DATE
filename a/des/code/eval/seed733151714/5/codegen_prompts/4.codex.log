            }
        )
    assert receivers, "expected at least one receiver block"
    return receivers


def _resolve_color(color: int, mapping: dict[int, int]) -> int:
    cur = int(color)
    seen: set[int] = set()
    while cur in mapping and cur not in seen and mapping[cur] != cur:
