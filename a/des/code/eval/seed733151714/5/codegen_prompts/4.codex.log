+def _separator_row(g: np.ndarray) -> int:
+    rows = [r for r in range(g.shape[0]) if np.all(g[r, :] == YELLOW)]
+    assert len(rows) == 1, "expected exactly one full-width yellow separator row"
+    return int(rows[0])
