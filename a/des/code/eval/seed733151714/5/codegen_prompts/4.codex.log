+    multi_val = int(out[multi_bbox[0], multi_bbox[1]])
+    outside_val = int(out[out_bbox[0], out_bbox[1]])
+    if one_val == start_color or multi_val == start_color or outside_val != start_color:
+        return None
+    if one_val == multi_val:
+        return None
+
+    return grid
