+    max_total_h = max(int(tower["body_h"]) + 2 for tower in all_towers)
+    sep_row = random.randint(max_total_h + TOWER_BOTTOM_GAP_MIN, max_total_h + SEP_EXTRA_HEADROOM)
+    height = sep_row + 1 + lower_height
+    if height > MAX_GRID_H:
