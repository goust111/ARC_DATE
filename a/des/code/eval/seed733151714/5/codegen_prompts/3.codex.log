+    for i, (left_profile, right_profile, color) in enumerate(chain_profiles):
+        base = i * body_width
+        for row, (left, right) in enumerate(zip(left_profile, right_profile, strict=False)):
+            out[row, base + int(left) : base + body_width + int(right)] = int(color)
+    return out
+
