+    pieces: list[dict] = []
+    for color in sorted(int(c) for c in np.unique(grid) if int(c) != BG):
+        coords = np.argwhere(grid == color)
+        assert coords.size > 0, "piece color must occur"
+        r0, c0 = map(int, coords.min(axis=0))
+        r1, c1 = map(int, coords.max(axis=0))
