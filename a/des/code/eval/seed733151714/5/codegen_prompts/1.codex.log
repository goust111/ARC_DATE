+BG = 0
+GREY = 5
+FRAME_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+# Generator configuration.
+GEN_RETRIES = 400
+GRID_MIN = 20
+GRID_MAX = 30
+FRAME_COUNT_RANGE = (2, 4)
+USED_TEMPLATE_COUNT_RANGE = (2, 4)
+EXTRA_TEMPLATE_COUNT_RANGE = (0, 2)
+CELL_DIMS = (1, 2, 3, 4)
+ROOM_COUNT_CHOICES = (2, 3)
+DICT_GAP = 1
