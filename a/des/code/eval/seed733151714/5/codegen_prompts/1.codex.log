+import math
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+FRAME_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+# Generator configuration.
+GEN_RETRIES = 400
+GRID_MIN = 20
+GRID_MAX = 30
+FRAME_COUNT_RANGE = (2, 4)
