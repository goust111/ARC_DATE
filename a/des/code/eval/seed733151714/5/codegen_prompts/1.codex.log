+        size = (h - 2, w - 2)
+        if size in templates:
+            raise AssertionError("template sizes must be unique")
+        templates[size] = patch[1:-1, 1:-1].copy()
+        dict_mask[r0 : r1 + 1, c0 : c1 + 1] = True
