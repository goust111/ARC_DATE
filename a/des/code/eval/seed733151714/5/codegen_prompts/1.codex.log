+        dict_c = random.randint(1, w - dict_patch.shape[1] - 1)
+    elif side == "bottom":
+        dict_r = h - dict_patch.shape[0] - 1
+        dict_c = random.randint(1, w - dict_patch.shape[1] - 1)
+    elif side == "left":
+        dict_r = random.randint(1, h - dict_patch.shape[0] - 1)
+        dict_c = 1
+    else:
