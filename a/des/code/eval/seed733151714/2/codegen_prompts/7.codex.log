+        return False
+    out = main(grid)
+    if out.shape != grid.shape or int((out == RED).sum()) != 0:
+        return False
+    if np.array_equal(out, grid):
+        return False
+    return saw_single or saw_collision
+
+
+def generate_input() -> np.ndarray:
