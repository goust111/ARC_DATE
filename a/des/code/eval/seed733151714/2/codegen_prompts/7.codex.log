+    ((0, 0), (0, 1), (1, 1)): "right",
+    ((0, 1), (1, 0), (1, 1)): "down",
+    ((0, 0), (1, 0), (1, 1)): "left",
+    ((0, 0), (0, 1), (1, 0)): "up",
+}
+DIR_TO_ARROW = {v: k for k, v in ARROW_TO_DIR.items()}
+PALETTE = [0, 1, 3, 5, 6, 7, 8, 9]
