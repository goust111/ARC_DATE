+        (slice(top + 1, top + 1 + qh), slice(left + 1 + qw, left + 1 + 2 * qw)),
+        (slice(top + 1 + qh, top + 1 + 2 * qh), slice(left + 1, left + 1 + qw)),
+        (slice(top + 1 + qh, top + 1 + 2 * qh), slice(left + 1 + qw, left + 1 + 2 * qw)),
+    ]
