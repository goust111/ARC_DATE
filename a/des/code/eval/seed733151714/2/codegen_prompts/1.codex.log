+def _quadrant_slices(frame_bbox: tuple[int, int, int, int]) -> list[tuple[slice, slice]]:
+    r0, c0, r1, c1 = frame_bbox
+    inner_h = r1 - r0 - 1
+    inner_w = c1 - c0 - 1
+    qh = inner_h // 2
+    qw = inner_w // 2
