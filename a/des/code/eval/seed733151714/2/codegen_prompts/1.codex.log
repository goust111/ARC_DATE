+MAX_ATTEMPTS = 400
+GRID_MIN = 16
+GRID_MAX = 30
+FRAME_COUNT_RANGE = (2, 4)
+QUAD_SIZE_RANGE = (1, 4)
+PLACEMENT_GAP = 1
