+def _find_positions(mask: np.ndarray, h: int, w: int, gap: int) -> list[tuple[int, int]]:
+    gh, gw = mask.shape
+    out: list[tuple[int, int]] = []
+    for r in range(gh - h + 1):
+        for c in range(gw - w + 1):
+            rr0 = max(0, r - gap)
+            rr1 = min(gh, r + h + gap)
+            cc0 = max(0, c - gap)
+            cc1 = min(gw, c + w + gap)
