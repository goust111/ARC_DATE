+
+def _reserve_rect(mask: np.ndarray, top: int, left: int, h: int, w: int, gap: int) -> None:
+    rr0 = max(0, top - gap)
+    rr1 = min(mask.shape[0], top + h + gap)
+    cc0 = max(0, left - gap)
+    cc1 = min(mask.shape[1], left + w + gap)
+    mask[rr0:rr1, cc0:cc1] = True
