+        planned = _plan_lenses_for_tower(path, direction, lens_palette, int(color), scenario)
+        if planned is None:
+            return None
+        for lens in planned:
+            if any(not (0 <= r < h and 0 <= c < w) for r, c in lens["cells"]):
+                return None
+            if any(int(grid[r, c]) != int(bg) for r, c in lens["cells"]):
