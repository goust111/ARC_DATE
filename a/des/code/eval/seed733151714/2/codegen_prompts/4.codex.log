+def _ray_path(tip: tuple[int, int], direction: tuple[int, int], shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = map(int, shape)
+    dr, dc = direction
+    r, c = map(int, tip)
+    path: list[tuple[int, int]] = []
+    while True:
+        r += int(dr)
+        c += int(dc)
+        if not (0 <= r < h and 0 <= c < w):
