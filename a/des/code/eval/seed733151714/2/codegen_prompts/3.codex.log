+def _legend_from_tile(tile: np.ndarray, bg: int) -> tuple[int, int, np.ndarray] | None:
+    colors = [int(color) for color in np.unique(tile) if int(color) != bg]
+    for ink in colors:
+        pts = np.argwhere(tile == ink)
+        if pts.shape[0] < 2:
+            continue
+        r0, c0 = pts.min(axis=0)
+        r1, c1 = pts.max(axis=0)
+        if int(r1 - r0 + 1) != 3 or int(c1 - c0 + 1) != 3:
+            continue
+        bbox = tile[r0 : r1 + 1, c0 : c1 + 1]
+        if not set(map(int, np.unique(bbox))).issubset({bg, ink}):
+            continue
+        others = np.argwhere((tile != bg) & (tile != ink))
+        if others.shape[0] != 1:
+            continue
+        key_r, key_c = map(int, others[0])
+        if key_c >= int(c0):
+            continue
+        template = bbox == ink
+        if not bool(template[1, 1]):
+            continue
+        return ink, int(tile[key_r, key_c]), template
+    return None
