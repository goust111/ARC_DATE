+            _paint_seeds(grid, tile_r, tile_c, tile_h, tile_w, [(seed_r, seed_c, color)])
+        else:
+            pair = rng.sample(chosen_colors, 2)
+            seeds = _random_dual_seeds(rng, (tile_h, tile_w), pair[0], pair[1], templates)
