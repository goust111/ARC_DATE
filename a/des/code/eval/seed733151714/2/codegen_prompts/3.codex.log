+    color_b: int,
+    templates: dict[int, np.ndarray],
+) -> list[tuple[int, int, int]] | None:
+    h, w = tile_shape
+    min_total = max(6, min(h, w) + 1)
+    for _ in range(200):
+        r1 = rng.randrange(h)
+        c1 = rng.randrange(w)
+        r2 = rng.randrange(h)
+        c2 = rng.randrange(w)
