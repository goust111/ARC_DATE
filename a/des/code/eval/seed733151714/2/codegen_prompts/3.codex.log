+def _random_single_seed(
+    rng: random.Random,
+    tile_shape: tuple[int, int],
+    color: int,
+    templates: dict[int, np.ndarray],
+) -> tuple[int, int]:
+    h, w = tile_shape
+    for _ in range(80):
+        r = rng.randrange(h)
+        c = rng.randrange(w)
+        _, areas, _ = _grow_partition(tile_shape, [(r, c, color)], templates)
+        if areas.get(color, 0) >= max(3, min(h, w) - 1):
