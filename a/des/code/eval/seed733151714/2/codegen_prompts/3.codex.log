+                seed_r, seed_c = _random_single_seed(rng, (tile_h, tile_w), color, templates)
+                seeds = [(seed_r, seed_c, color)]
+            _paint_seeds(grid, tile_r, tile_c, tile_h, tile_w, seeds)
