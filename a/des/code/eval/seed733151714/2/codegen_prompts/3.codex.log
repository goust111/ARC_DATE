+def _spans(size: int, cuts: list[int]) -> list[tuple[int, int]] | None:
+    cuts = sorted(int(x) for x in cuts)
+    spans: list[tuple[int, int]] = []
+    start = 0
+    for cut in cuts:
+        if cut <= start or cut >= size:
