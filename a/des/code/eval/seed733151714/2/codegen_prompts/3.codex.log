+                    nr = r + dr
+                    nc = c + dc
+                    if nr < 0 or nr >= h or nc < 0 or nc >= w:
+                        continue
+                    if owners[nr, nc] != -1 or blocked[nr, nc]:
+                        continue
+                    key = (nr, nc)
+                    prev = claims.get(key)
+                    if prev is None:
+                        claims[key] = color
+                    elif prev != color:
+                        claims[key] = -1
