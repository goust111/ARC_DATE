+def _bbox_nonblack(grid: np.ndarray) -> tuple[int, int, int, int]:
+    pts = np.argwhere(grid != BG)
+    if pts.size == 0:
+        raise ValueError("grid must contain a non-black structure")
+    mins = pts.min(axis=0)
+    maxs = pts.max(axis=0)
+    return int(mins[0]), int(maxs[0]), int(mins[1]), int(maxs[1])
