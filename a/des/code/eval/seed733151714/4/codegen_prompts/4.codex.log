+    windows: list[dict[str, object]],
+) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    room_hits = {room: [] for room in rooms}
+
+    for spec in windows:
+        pos = min(spec["cells"])
+        color = int(spec["color"])
+        for room in spec["segment"]["rooms"]:
