+import random
+
+import numpy as np
+
+
+BG = 0
+WALL = 9
+FLOOR_COLORS = (1, 2, 3, 4, 5)
+WINDOW_COLORS = (6, 7, 8)
+
+ROOM_ROWS_RANGE = (2, 4)
+ROOM_COLS_RANGE = (2, 4)
+ROOM_HEIGHT_RANGE = (2, 5)
+ROOM_WIDTH_RANGE = (2, 5)
+MARGIN_RANGE = (1, 3)
