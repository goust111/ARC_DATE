+        if room_hits[room]:
+            color = min(room_hits[room], key=lambda item: item[0])[1]
+        out[top:bottom, left:right] = color
+    return out
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    room_rows = rng.randint(*ROOM_ROWS_RANGE)
