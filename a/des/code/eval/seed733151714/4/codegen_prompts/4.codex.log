+
+def _bbox_nonblack(grid: np.ndarray) -> tuple[int, int, int, int]:
+    pts = np.argwhere(grid != BG)
+    if pts.size == 0:
+        raise ValueError("grid must contain a non-black structure")
+    mins = pts.min(axis=0)
+    maxs = pts.max(axis=0)
+    return int(mins[0]), int(maxs[0]), int(mins[1]), int(maxs[1])
+
+
+def _consecutive_runs(lines: list[np.ndarray]) -> list[tuple[int, int]]:
+    runs = []
+    start = 0
+    while start < len(lines):
+        end = start + 1
+        while end < len(lines) and np.array_equal(lines[start], lines[end]):
+            end += 1
+        runs.append((start, end))
+        start = end
+    return runs
+
+
+def _validate_partition_runs(runs: list[tuple[int, int]]) -> None:
+    if len(runs) < 3:
+        raise ValueError("need at least one room band")
+    for idx, (start, end) in enumerate(runs):
+        length = end - start
+        if idx % 2 == 0:
+            if length != 1:
+                raise ValueError("wall bands must be one cell thick")
+        else:
+            if length < 2:
+                raise ValueError("room bands must be at least two cells thick")
+
+
+def _dominant_color(block: np.ndarray) -> int:
+    colors, counts = np.unique(block, return_counts=True)
+    return int(colors[np.argmax(counts)])
+
+
+def _room_bounds(wall_rows: list[int], wall_cols: list[int]) -> dict[tuple[int, int], tuple[int, int, int, int]]:
+    rooms = {}
+    for rr in range(len(wall_rows) - 1):
+        for cc in range(len(wall_cols) - 1):
+            rooms[(rr, cc)] = (
+                wall_rows[rr] + 1,
+                wall_rows[rr + 1],
+                wall_cols[cc] + 1,
+                wall_cols[cc + 1],
+            )
+    return rooms
+
+
+def _first_window_in_segment(segment: np.ndarray) -> tuple[int, int] | None:
+    idxs = np.flatnonzero(segment != WALL)
+    if idxs.size == 0:
+        return None
+    offset = int(idxs[0])
+    color = int(_dominant_color(segment[idxs]))
+    return offset, color
+
+
+def _analyze_layout(grid: np.ndarray) -> dict[str, object]:
+    g = np.asarray(grid, dtype=int)
+    r0, r1, c0, c1 = _bbox_nonblack(g)
+    sub = g[r0 : r1 + 1, c0 : c1 + 1]
+
+    row_runs = _consecutive_runs([sub[r, :] for r in range(sub.shape[0])])
+    col_runs = _consecutive_runs([sub[:, c] for c in range(sub.shape[1])])
+    _validate_partition_runs(row_runs)
+    _validate_partition_runs(col_runs)
+
+    wall_rows = [r0 + start for idx, (start, _end) in enumerate(row_runs) if idx % 2 == 0]
+    wall_cols = [c0 + start for idx, (start, _end) in enumerate(col_runs) if idx % 2 == 0]
+    rooms = _room_bounds(wall_rows, wall_cols)
+
