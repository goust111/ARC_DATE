+    marker_offsets = np.flatnonzero((marker_band == YELLOW) | (marker_band == ORANGE))
+    if marker_offsets.size != 1:
+        return None
+    if int(marker_offsets[0]) != marker_c - left:
+        return None
+
+    return {
+        "fill": fill,
+        "marker": int(grid[marker_r, marker_c]),
+        "top": rect_top,
+        "left": left,
+        "bottom": bottom,
+        "right": right,
+        "region": region.copy(),
+    }
