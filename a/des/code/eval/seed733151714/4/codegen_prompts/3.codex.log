+
+BLACK = 0
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+FILL_COLORS = (1, 2, 3, 6, 8, 9)
+
+GEN_RETRIES = 300
+GRID_HEIGHT_RANGE = (14, 24)
+GRID_WIDTH_RANGE = (14, 24)
+OBJECT_COUNT_RANGE = (2, 5)
+RECT_HEIGHT_RANGE = (4, 8)
