+    if region.shape[0] < 3 or region.shape[1] < 3:
+        return None
+    if not np.all((region == fill) | (region == BLACK)):
+        return None
+    if not np.all(region[0, :] == fill):
+        return None
+    if not np.all(region[-1, :] == fill):
+        return None
+    if not np.all(region[:, 0] == fill):
+        return None
+    if not np.all(region[:, -1] == fill):
+        return None
+    if not np.any(region == BLACK):
+        return None
+
