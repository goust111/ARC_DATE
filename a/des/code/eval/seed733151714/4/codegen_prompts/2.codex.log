+def _extract_segments(grid: np.ndarray) -> dict[int, tuple[tuple[str, int], ...]]:
+    top = np.asarray(grid[:-1], dtype=int)
+    colors = [int(c) for c in np.unique(top) if int(c) != BG]
+    segments: dict[int, tuple[tuple[str, int], ...]] = {}
+    for color in colors:
