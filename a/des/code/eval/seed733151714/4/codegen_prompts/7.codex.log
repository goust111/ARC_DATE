+        small_w = random.randint(*SMALL_SIDE_RANGE)
+        extra_w = random.randint(*EXTRA_SIDE_RANGE)
+        big = np.zeros((height, small_w + extra_w), dtype=int)
+        overlay = np.zeros((height, small_w), dtype=int)
+        axis = 1
+        span = small_w
+        leading = case == "right_big"
