+    overlay: np.ndarray,
+    overlap_blocked: np.ndarray,
+    overlay_blocked: np.ndarray,
+    palette: list[int],
+) -> None:
+    h, w = map(int, overlay.shape)
+    points = random.sample([(r, c) for r in range(h) for c in range(w)], 4)
+    conflict, big_only, small_only, both_black = points
