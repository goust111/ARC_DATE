+    dr, dc = direction
+    r, c = head[0] + dr, head[1] + dc
+    while _in_bounds(g.shape, r, c):
+        color = int(g[r, c])
+        if color == BG:
+            r += dr
+            c += dc
+            continue
+        if color == ARROW:
+            r += dr
+            c += dc
+            continue
+        return cell_to_object[(r, c)], (r, c)
