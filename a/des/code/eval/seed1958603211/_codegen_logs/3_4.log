+        texture = np.rot90(mapping[seed_color], -DIR_TO_ROT[direction])
+        fill = _tile_texture(texture, (r1 - r0 - 1, c1 - c0 - 1))
+        out[r0 + 1 : r1, c0 + 1 : c1] = fill
+    return out
