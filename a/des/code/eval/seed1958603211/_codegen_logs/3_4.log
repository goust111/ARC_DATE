+def _transform(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    mapping = _extract_legend(g)
+    rooms = _find_rooms(g)
