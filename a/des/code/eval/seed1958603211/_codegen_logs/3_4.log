+    ph, pw = panel.shape
+    if ph > grid_h or pw > grid_w:
+        return None
+
+    corner = rng.choice(["tl", "tr", "bl", "br"])
+    pr0, pc0 = _place_panel(grid, panel, corner)
+    occupied = np.zeros_like(grid, dtype=bool)
+    _reserve(occupied, pr0, pc0, pr0 + ph - 1, pc0 + pw - 1, pad=1)
+
