+        elif val == 1:
+            mask[r0 + dr, 0] = True
+    for dr, val in enumerate(right):
+        if val == -1:
+            mask[r0 + dr, c0 + slot_w - 1] = False
+        elif val == 1:
+            mask[r0 + dr, pw - 1] = True
