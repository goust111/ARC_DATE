+    return grid, expected
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_RETRIES):
+        try:
+            grid, expected = _build_case(rng)
+            if np.array_equal(main(grid), expected):
