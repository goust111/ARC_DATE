+def _negate_signature(
+    sig: tuple[tuple[int, ...], tuple[int, ...], tuple[int, ...], tuple[int, ...]]
+) -> tuple[tuple[int, ...], tuple[int, ...], tuple[int, ...], tuple[int, ...]]:
+    return tuple(tuple(-v for v in edge) for edge in sig)
