+    pieces = []
+    for coords in comps:
+        r0, c0, r1, c1 = _bbox(coords)
+        patch_mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        patch_mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+        colors = np.unique(grid[coords[:, 0], coords[:, 1]])
+        assert len(colors) == 1
+        color = int(colors[0])
