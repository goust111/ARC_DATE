+        vals = []
+        for dr in range(slot_h):
+            boundary = int(grid[r0 + dr, int(slot["left"])]) == int(frame_color)
+            inner = int(grid[r0 + dr, c0]) == int(frame_color)
+            vals.append(-1 if not boundary else 1 if inner else 0)
