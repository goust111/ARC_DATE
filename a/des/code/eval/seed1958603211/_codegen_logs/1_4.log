+
+def _draw_frame(
+    slot_h: int,
+    slot_w: int,
+    slot_sigs: list[tuple[tuple[int, ...], tuple[int, ...], tuple[int, ...], tuple[int, ...]]],
+) -> np.ndarray:
+    frame_h = int(2 * slot_h + 3)
+    frame_w = int(2 * slot_w + 3)
+    frame = np.full((frame_h, frame_w), BG, dtype=int)
+    frame[0, :] = FRAME
+    frame[-1, :] = FRAME
+    frame[:, 0] = FRAME
