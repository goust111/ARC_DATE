+        slot = slots[slot_idx]
+        piece = pieces[piece_idx]
+        cand = piece["candidates"][cand_idx]
+        top = int(slot["r0"] - cand["top_ext"] - fr0)
+        left = int(slot["c0"] - cand["left_ext"] - fc0)
+        rr, cc = np.nonzero(piece["mask"])
