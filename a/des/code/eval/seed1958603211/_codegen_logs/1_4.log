+    cross_r = int(np.argmax(row_counts[1:-1])) + 1
+    cross_c = int(np.argmax(col_counts[1:-1])) + 1
+
+    slot_h_top = int(cross_r - 1)
+    slot_h_bottom = int(sub.shape[0] - cross_r - 2)
