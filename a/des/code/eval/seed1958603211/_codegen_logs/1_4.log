+        {"r0": int(hr + 1), "c0": int(fc0 + 1), "top": int(hr), "bottom": int(fr1), "left": int(fc0), "right": int(vc)},
+        {"r0": int(hr + 1), "c0": int(vc + 1), "top": int(hr), "bottom": int(fr1), "left": int(vc), "right": int(fc1)},
