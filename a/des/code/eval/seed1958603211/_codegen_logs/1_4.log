+def _place_piece(output: np.ndarray, slot: dict, piece: dict) -> None:
+    top = int(slot["r0"] - piece["top_ext"])
+    left = int(slot["c0"] - piece["left_ext"])
+    rr, cc = np.nonzero(piece["mask"])
+    output[top + rr, left + cc] = int(piece["color"])
