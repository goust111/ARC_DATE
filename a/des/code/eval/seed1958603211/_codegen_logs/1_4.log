+
+    for dc, val in enumerate(top):
+        if val == -1:
+            mask[r0, c0 + dc] = False
+        elif val == 1:
+            mask[0, c0 + dc] = True
+    for dc, val in enumerate(bottom):
+        if val == -1:
+            mask[r0 + slot_h - 1, c0 + dc] = False
+        elif val == 1:
+            mask[ph - 1, c0 + dc] = True
