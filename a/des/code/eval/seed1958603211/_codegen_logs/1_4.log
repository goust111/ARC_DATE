+        for dc, val in enumerate(top):
+            if val == -1:
+                frame[int(slot["top"]), c0 + dc] = BG
+            elif val == 1:
+                frame[r0, c0 + dc] = FRAME
+        for dc, val in enumerate(bottom):
+            if val == -1:
+                frame[int(slot["bottom"]), c0 + dc] = BG
+            elif val == 1:
+                frame[r0 + slot_h - 1, c0 + dc] = FRAME
