+    colors = rng.sample([1, 2, 3, 4, 6, 7, 8, 9], 4)
+    pieces = []
+    for sig, color in zip(slot_sigs, colors):
+        piece_sig = _negate_signature(sig)
+        pieces.append(_build_piece(slot_h, slot_w, piece_sig, int(color)))
