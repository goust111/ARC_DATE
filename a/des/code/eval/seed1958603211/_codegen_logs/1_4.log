+        if tl_top == zero_w and tl_left == zero_h:
+            continue
+        if tr_top == zero_w and tr_right == zero_h:
+            continue
+        if bl_bottom == zero_w and bl_left == zero_h:
+            continue
+        if br_bottom == zero_w and br_right == zero_h:
