+def _normalize(cells: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], int, int]:
+    r0, c0, r1, c1 = _bbox(cells)
+    norm = tuple(sorted((int(r) - r0, int(c) - c0) for r, c in cells))
+    return norm, r1 - r0 + 1, c1 - c0 + 1
