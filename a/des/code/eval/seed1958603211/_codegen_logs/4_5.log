+def _bbox(cells: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[int, int, int, int]:
+    rows = [int(r) for r, _ in cells]
+    cols = [int(c) for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
