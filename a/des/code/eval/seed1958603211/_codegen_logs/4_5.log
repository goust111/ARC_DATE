+        while stack:
+            rr, cc = stack.pop()
+            comp.append((int(rr), int(cc)))
+            for dr, dc in DIR4:
+                nr, nc = rr + dr, cc + dc
+                if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc] and not seen[nr, nc]:
