+            c0 = rng.randint(0, width - bw)
+            er0 = max(0, r0 - 1)
+            ec0 = max(0, c0 - 1)
+            er1 = min(rect_zone_h, r0 + bh + 1)
+            ec1 = min(width, c0 + bw + 1)
+            if occupied[er0:er1, ec0:ec1].any():
+                continue
+            occupied[er0:er1, ec0:ec1] = True
+            placements[idx] = (r0, c0)
+            placed = True
+            break
+        if not placed:
+            return None
