+    rectangles_meta = []
+    for spec, placement in zip(rect_specs, placements):
+        assert placement is not None
+        r0, c0 = placement
+        r1 = r0 + spec["bbox_h"] - 1
+        c1 = c0 + spec["bbox_w"] - 1
+        _draw_dashed_rectangle(grid, r0, c0, r1, c1)
+
