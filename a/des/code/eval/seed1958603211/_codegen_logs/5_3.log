+import random
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREEN = 3
+YELLOW = 4
+AZURE = 8
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    pts = np.argwhere(mask)
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _shape_signature(mask: np.ndarray) -> tuple[tuple[int, int], tuple[tuple[int, ...], ...]]:
+    return mask.shape, tuple(tuple(int(v) for v in row) for row in mask.astype(int))
+
+
+def _maximal_step2_segments(indices: list[int]) -> list[tuple[int, int]]:
+    if len(indices) < 2:
+        return []
+    segments: list[tuple[int, int]] = []
+    start = indices[0]
+    prev = indices[0]
+    length = 1
+    for value in indices[1:]:
+        if value - prev == 2:
+            prev = value
+            length += 1
+            continue
+        if length >= 2:
+            segments.append((start, prev))
+        start = value
+        prev = value
+        length = 1
+    if length >= 2:
+        segments.append((start, prev))
+    return segments
+
+
+def _is_dashed_rectangle(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int) -> bool:
+    if r1 <= r0 or c1 <= c0:
+        return False
+    if (r1 - r0) % 2 != 0 or (c1 - c0) % 2 != 0:
+        return False
+    for c in range(c0, c1 + 1):
+        expected = (c - c0) % 2 == 0
+        if bool(grid[r0, c] == AZURE) != expected:
+            return False
+        if bool(grid[r1, c] == AZURE) != expected:
+            return False
+    for r in range(r0, r1 + 1):
+        expected = (r - r0) % 2 == 0
+        if bool(grid[r, c0] == AZURE) != expected:
+            return False
+        if bool(grid[r, c1] == AZURE) != expected:
+            return False
+    if r1 - r0 > 1 and c1 - c0 > 1 and np.any(grid[r0 + 1 : r1, c0 + 1 : c1] == AZURE):
+        return False
+    return True
