+    _shape(("###", ".#.")),
+    _shape(("#.", "#.", "##")),
+    _shape((".#", ".#", "##")),
+    _shape(("##.", ".##")),
+    _shape((".##", "##.")),
+    _shape((".#.", "###", ".#.")),
