+
+
+def _odd_at_least(value: int) -> int:
+    return value if value % 2 == 1 else value + 1
+
+
+def _draw_dashed_rectangle(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int) -> None:
+    for c in range(c0, c1 + 1, 2):
