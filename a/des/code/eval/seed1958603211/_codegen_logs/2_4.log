+
+def _border_cells(bbox: BBox) -> list[Coord]:
+    r0, c0, r1, c1 = bbox
+    cells: list[Coord] = []
+    for c in range(c0, c1 + 1):
+        cells.append((int(r0), int(c)))
+        cells.append((int(r1), int(c)))
+    for r in range(r0 + 1, r1):
