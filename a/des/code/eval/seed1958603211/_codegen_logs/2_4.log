+
+def _find_frames(grid: np.ndarray, bg: int) -> tuple[int, list[dict], np.ndarray]:
+    colors = [int(v) for v in np.unique(grid) if int(v) not in {bg, RED, BLUE}]
+    candidates: list[tuple[int, list[BBox]]] = []
