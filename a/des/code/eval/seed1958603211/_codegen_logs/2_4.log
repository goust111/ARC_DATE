+
+def _arrow_cells_rel(direction: str, tail_offset: int, head_variant: int, sh: int, sw: int) -> list[Coord]:
+    if direction == "right":
+        return [(tail_offset, sw), (tail_offset + 1, sw), (tail_offset + head_variant, sw + 1)]
+    if direction == "left":
