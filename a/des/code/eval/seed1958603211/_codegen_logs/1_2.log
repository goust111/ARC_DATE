+def _count_key(inner: np.ndarray, color: int) -> tuple[int, int]:
+    pts = np.argwhere(inner == color)
+    first = pts[np.lexsort((pts[:, 1], pts[:, 0]))][0]
+    return int(first[0]), int(first[1])
