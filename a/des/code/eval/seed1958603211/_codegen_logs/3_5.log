+def _seed_candidates(inner_h: int, inner_w: int, side: str) -> list[tuple[int, int]]:
+    candidates: list[tuple[int, int]] = []
+    for ir in range(inner_h):
+        for ic in range(inner_w):
+            distances = {
+                "top": ir + 1,
+                "bottom": inner_h - ir,
+                "left": ic + 1,
+                "right": inner_w - ic,
+            }
+            best = min(distances.values())
+            if best > 2:
