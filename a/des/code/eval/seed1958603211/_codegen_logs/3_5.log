+SIDES = ("top", "bottom", "left", "right")
+
+GEN_ATTEMPTS = 400
+LAYOUT_ATTEMPTS = 120
+GRID_MIN = 14
+GRID_MAX = 30
+OUTER_SIZE_MIN = 5
+OUTER_SIZE_MAX = 8  # exclusive
+GAP_MIN = 2
+GAP_MAX = 5  # exclusive
+MARGIN_MIN = 1
+MARGIN_MAX = 4  # exclusive
