+        "bottom": int(r1 - seed_r),
+        "left": int(seed_c - c0),
+        "right": int(c1 - seed_c),
+    }
+    best = min(distances.values())
+    matches = [side for side, dist in distances.items() if dist == best]
+    assert len(matches) == 1, "seed direction must be unambiguous"
+    return matches[0]
+
