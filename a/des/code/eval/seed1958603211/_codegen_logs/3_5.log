+            gaps = [int(rng.integers(GAP_MIN, GAP_MAX)) for _ in range(max(0, len(row) - 1))]
+            width = sum(int(specs[idx]["foot_w"]) for idx in row) + sum(gaps)
+            height = max(int(specs[idx]["foot_h"]) for idx in row)
+            row_widths.append(width)
