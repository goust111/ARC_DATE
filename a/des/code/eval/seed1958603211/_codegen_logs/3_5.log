+        row_y = top
+        for row_index, row in enumerate(rows):
+            slack_x = width - left - right - row_widths[row_index]
+            row_x = left + (0 if slack_x == 0 else int(rng.integers(0, slack_x + 1)))
+            cur_x = row_x
+            for pos, idx in enumerate(row):
