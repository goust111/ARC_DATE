+        bottom = int(rng.integers(MARGIN_MIN, MARGIN_MAX))
+        left = int(rng.integers(MARGIN_MIN, MARGIN_MAX))
+        right = int(rng.integers(MARGIN_MIN, MARGIN_MAX))
