+import math
+import random
+
+import numpy as np
+
+
+BG = 0
+COLORS = list(range(1, 10))
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(comp)
+    return out
+
+
+def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _outer_path(frame_bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = frame_bbox
+    path: list[tuple[int, int]] = []
+    for c in range(c0 - 1, c1 + 2):
+        path.append((r0 - 1, c))
+    for r in range(r0, r1 + 2):
+        path.append((r, c1 + 1))
+    for c in range(c1, c0 - 2, -1):
+        path.append((r1 + 1, c))
+    for r in range(r1, r0 - 1, -1):
+        path.append((r, c0 - 1))
+    return path
+
+
+def _find_template_bbox(grid: np.ndarray) -> tuple[int, int, int, int]:
+    h, w = grid.shape
+    candidates: list[tuple[int, int, tuple[int, int, int, int]]] = []
+    for comp in _components(grid != BG):
+        r0, c0, r1, c1 = _bbox(comp)
+        area = (r1 - r0 + 1) * (c1 - c0 + 1)
+        touches_corner = (r0 == 0 or r1 == h - 1) and (c0 == 0 or c1 == w - 1)
+        if not touches_corner:
+            continue
+        if len(comp) != area:
+            continue
+        if r1 == r0 and c1 == c0:
+            continue
+        candidates.append((area, r1 - r0 + 1, (r0, c0, r1, c1)))
