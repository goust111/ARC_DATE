+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    if height < 3 or width < 3:
+        return False, None
+    if len(comp) != 2 * (height + width) - 4:
+        return False, None
+    if np.any(grid[r0 + 1 : r1, c0 + 1 : c1] == color):
+        return False, None
+    if not np.all(grid[r0, c0 : c1 + 1] == color):
+        return False, None
+    if not np.all(grid[r1, c0 : c1 + 1] == color):
+        return False, None
+    if not np.all(grid[r0 : r1 + 1, c0] == color):
