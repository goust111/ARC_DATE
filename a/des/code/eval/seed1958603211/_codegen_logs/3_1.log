+
+
+def _sample_frame_spec(depth: int) -> dict:
+    inner_min = 3 if depth == 0 else _min_box_size(depth) + 2 * TOP_LEVEL_MARGIN
+    inner_h = random.randint(inner_min, inner_min + 4)
+    inner_w = random.randint(inner_min, inner_min + 6)
+    frame_h = inner_h + 2
+    frame_w = inner_w + 2
