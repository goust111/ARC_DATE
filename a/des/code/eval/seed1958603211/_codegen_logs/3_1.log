+
+TEMPLATE_ROWS = 4
+FRAME_COUNT_RANGE = (2, 4)
+GRID_SIDE_RANGE = (26, 36)
+FRAME_PAD = 2
+TEMPLATE_PAD = 1
+TOP_LEVEL_MARGIN = 1
+INNER_LEVEL_MARGIN = 2
+MAX_DEPTH = TEMPLATE_ROWS - 1
+GEN_ATTEMPTS = 400
+
+
+def _min_box_size(levels: int) -> int:
+    return 2 + 4 * max(0, levels - 1)
