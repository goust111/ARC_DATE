+        max(int(spec["height"]) for spec in specs) + 2 * FRAME_PAD + 2,
+        max(int(spec["width"]) for spec in specs) + 2 * FRAME_PAD + 2,
+        total_heights // 2 + 6,
+        total_widths // 2 + 6,
