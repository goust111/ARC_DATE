+def _gen_attempt() -> np.ndarray | None:
+    n_frames = random.randint(*FRAME_COUNT_RANGE)
+    depths = [random.randint(0, MAX_DEPTH) for _ in range(n_frames)]
+    specs = [_sample_frame_spec(depth) for depth in depths]
