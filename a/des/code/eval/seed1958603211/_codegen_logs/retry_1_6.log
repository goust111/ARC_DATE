+    bg, pipe, entries, entry_mask = _parse_structure(g)
+
+    pipe_like = (g == pipe) | entry_mask
+    dist = np.full((h, w), 10 ** 9, dtype=int)
+    owner = np.full((h, w), -1, dtype=int)
+    seen_dirs = [[set() for _ in range(w)] for _ in range(h)]
