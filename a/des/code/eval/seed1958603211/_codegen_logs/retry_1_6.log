+            end_col[row] = rng.randint(min_end, w - 3)
+
+    grid = np.full((h, w), BG, dtype=int)
+    for row in active_rows:
+        grid[row, start_col[row] : end_col[row] + 1] = PIPE
+    for col, r0, r1 in connectors:
+        lo, hi = sorted((r0, r1))
+        grid[lo : hi + 1, col] = PIPE
