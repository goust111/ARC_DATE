+    if len(recolored) < min(2, n_entries):
+        return None
+
+    if not any(int(out[row, w - 1]) != PIPE for row in exit_rows):
+        return None
+
+    if not np.any((grid == PIPE) & (out != PIPE)):
+        return None
+
+    if len(entries) != len(exit_rows):
+        return None
+
+    return grid
+
