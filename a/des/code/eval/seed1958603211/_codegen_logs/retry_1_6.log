+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(13, 21)
+    w = rng.randint(22, 30)
+    lane_rows = list(range(2, h - 1, 2))
+    if len(lane_rows) < 3:
