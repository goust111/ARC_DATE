        dominant_rows = range(0, GEN_SPLIT_INDEX) if side == "left" else range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_VW[0])
        accent_rows = range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_VW[0]) if side == "left" else range(0, GEN_SPLIT_INDEX)
