+    for color, dr, dc, length in instructions:
+        for _ in range(int(length)):
+            cur_r += int(dr)
+            cur_c += int(dc)
+            assert 0 <= cur_r < height and 0 <= cur_c < width, "decoded path must stay inside the grid"
+            if int(out[cur_r, cur_c]) == int(bg):
+                out[cur_r, cur_c] = int(color)
+
+    return out
+
