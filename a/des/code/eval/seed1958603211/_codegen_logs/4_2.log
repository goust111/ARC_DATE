+                    ("H", 1, random.randint(*SEGMENT_LENGTH_RANGE)),
+                    ("V", vertical_sign, random.randint(*SEGMENT_LENGTH_RANGE)),
+                    ("H", -1, random.randint(*SEGMENT_LENGTH_RANGE)),
