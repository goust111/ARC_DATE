+            cur_c += dc
+            visited.append((cur_r, cur_c))
+    return visited
+
+
+def _sample_specs(top_palette: bool) -> list[tuple[str, int, int]]:
+    vertical_sign = 1 if top_palette else -1
+    n_instructions = random.randint(*INSTRUCTION_COUNT_RANGE)
+    retrace = random.random() < 0.5
