+def _trace_offsets(specs: list[tuple[str, int, int]]) -> list[tuple[int, int]]:
+    cur_r = 0
+    cur_c = 0
+    visited = [(0, 0)]
+    for axis, sign, length in specs:
+        dr, dc = _step(axis, sign)
+        for _ in range(length):
