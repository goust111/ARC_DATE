+def _sample_specs(palette_r: int) -> list[tuple[str, int, int]]:
+    vertical_sign = 1 if palette_r == 0 else -1
+    n_instructions = random.randint(*INSTRUCTION_COUNT_RANGE)
+    retrace = random.random() < 0.5
