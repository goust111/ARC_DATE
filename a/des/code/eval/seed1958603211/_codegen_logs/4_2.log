+GRID_H_RANGE = (15, 26)
+GRID_W_RANGE = (16, 30)
+INSTRUCTION_COUNT_RANGE = (4, 6)
+SEGMENT_LENGTH_RANGE = (2, 5)
+MAX_VERTICAL_SEGMENTS = 2
+PALETTE_MIN_SEP = 2
+GEN_RETRIES = 500
+
+
+def _step(axis: str, sign: int) -> tuple[int, int]:
+    return (0, int(sign)) if axis == "H" else (int(sign), 0)
+
