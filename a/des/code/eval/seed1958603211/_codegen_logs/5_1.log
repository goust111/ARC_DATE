+        return None
+    if not np.array_equal(produced, expected):
+        return None
+    if np.array_equal(produced, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
