+
+BG = 0
+SIDES = ("top", "bottom", "left", "right")
+GEN_RETRIES = 300
+PLACE_TRIES = 80
+GRID_H_RANGE = (12, 24)
+GRID_W_RANGE = (12, 24)
+FRAME_COUNT_CHOICES = (1, 2, 3)
+FRAME_MARGIN = 2
+FRAME_INNER_H_RANGE = (2, 5)
+FRAME_INNER_W_RANGE = (2, 6)
