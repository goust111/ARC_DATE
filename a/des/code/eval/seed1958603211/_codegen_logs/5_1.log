+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+SIDES = ("top", "bottom", "left", "right")
+GEN_RETRIES = 300
+PLACE_TRIES = 80
+GRID_H_RANGE = (12, 24)
+GRID_W_RANGE = (12, 24)
