+        seed_r += r0 + 1
+        seed_c += c0 + 1
+        seed_color = int(grid[seed_r, seed_c])
+        if seed_color == color:
+            continue
+
+        if gap_r == r0:
+            side = "top"
+        elif gap_r == r1:
+            side = "bottom"
+        elif gap_c == c0:
+            side = "left"
+        elif gap_c == c1:
+            side = "right"
+        else:
