+    if side == "top":
+        out[r0 + 1 : seed_r + 1, seed_c] = fill_color
+    elif side == "bottom":
+        out[seed_r:r1, seed_c] = fill_color
+    elif side == "left":
+        out[seed_r, c0 + 1 : seed_c + 1] = fill_color
+    else:
