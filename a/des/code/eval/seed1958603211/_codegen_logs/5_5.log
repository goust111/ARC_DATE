+        color_counts = Counter(int(g[row, col]) for row, col in towers)
+        for row, col in sorted(towers):
+            color = int(g[row, col])
+            dr, dc = _tower_direction(g, row, col)
+            length = int(color_counts[color])
+            ray_row = row + 2 * dr
