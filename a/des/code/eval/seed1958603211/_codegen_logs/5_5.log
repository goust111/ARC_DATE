+                    return False
+            if len(
+                [
+                    1
+                    for dr, dc in DIRS
+                    if _in_bounds(grid.shape[0], grid.shape[1], row + dr, col + dc) and int(grid[row + dr, col + dc]) == GREEN
+                ]
+            ) != 1:
+                return False
+    return True
