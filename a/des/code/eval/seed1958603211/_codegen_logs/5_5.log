+
+    for group_size in sorted(groups, reverse=True):
+        eligible = [
+            idx
+            for idx, cand in enumerate(usable)
+            if idx not in used
+            and int(cand["max_run"]) >= group_size
+            and not _touches_existing_tower(int(cand["row"]), int(cand["col"]), chosen_towers)
+        ]
