+
+def _local_tower_candidates(interior: np.ndarray, boundary: np.ndarray) -> list[dict[str, int | tuple[int, int]]]:
+    candidates: list[dict[str, int | tuple[int, int]]] = []
+    for row, col in np.argwhere(interior):
