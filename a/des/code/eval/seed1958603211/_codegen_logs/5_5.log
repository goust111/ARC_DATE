+
+    bump_w = random.randint(1, 2)
+    span = random.randint(2, base_h - 1)
+    start = random.randint(0, base_h - span)
+    interior = np.zeros((base_h, base_w + bump_w), dtype=bool)
+    if side == "left":
+        interior[:, bump_w:] = True
