+import numpy as np
+
+
+BLACK = 0
+GREEN = 3
+PALETTE = [1, 2, 4, 5, 6, 7, 8, 9]
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_H_RANGE = (17, 25)
+GRID_W_RANGE = (17, 25)
+REGION_COUNT_CHOICES = [1, 2, 3]
+REGION_COUNT_WEIGHTS = [2, 3, 2]
+REGION_SHAPE_TRIES = 40
+REGION_PLACE_TRIES = 90
+MAX_GENERATION_ATTEMPTS = 400
+PLACEMENT_PAD = 1
+EDGE_MARGIN = 1
+
+GROUP_PATTERNS = {
+    1: [[1]],
+    2: [[2], [1, 1]],
+    3: [[3], [2, 1], [1, 1, 1]],
+    4: [[2, 2], [3, 1], [2, 1, 1], [1, 1, 1, 1]],
