+def _non_bg_runs(arr: np.ndarray, bg: int) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    start: int | None = None
+    for idx, value in enumerate(arr):
+        if int(value) != bg:
+            if start is None:
