+def _scene_bounds(h: int, w: int, edge: str) -> tuple[int, int, int, int]:
+    row_lo, row_hi = 1, h - 2
+    col_lo, col_hi = 1, w - 2
+    if edge == "top":
+        row_lo = 2
+    elif edge == "bottom":
