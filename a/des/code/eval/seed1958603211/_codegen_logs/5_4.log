+import random
+from collections import deque
+
+import numpy as np
+
+
+AZURE = 8
+BLACK = 0
+DIRS = {
+    "U": (-1, 0),
+    "D": (1, 0),
+    "L": (0, -1),
+    "R": (0, 1),
+}
+OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
+AXIS = {"U": "V", "D": "V", "L": "H", "R": "H"}
