+import random
+from collections import deque
+
+import numpy as np
+
+
+AZURE = 8
+BLACK = 0
+DIRS = {
+    "U": (-1, 0),
+    "D": (1, 0),
+    "L": (0, -1),
+    "R": (0, 1),
+}
+OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
+AXIS = {"U": "V", "D": "V", "L": "H", "R": "H"}
+ARROW_SHAPES = {
+    "U": [(-1, 0), (0, -1), (0, 0), (0, 1)],
+    "D": [(0, -1), (0, 0), (0, 1), (1, 0)],
+    "L": [(-1, 0), (0, -1), (0, 0), (1, 0)],
+    "R": [(-1, 0), (0, 0), (0, 1), (1, 0)],
+}
+GEN_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]
+GEN_SCENARIOS = ["no_cross", "h_shorter", "v_shorter", "tie"]
+GEN_RETRIES = 400
