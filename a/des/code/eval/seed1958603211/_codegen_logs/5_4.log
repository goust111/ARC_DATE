+            )
+        elif c1 == c2:
+            top, bottom = sorted(arrows, key=lambda item: item["center"][0])
+            if top["direction"] != "D" or bottom["direction"] != "U":
+                raise AssertionError("vertical arrow pairs must face each other")
+            col = top["center"][1]
