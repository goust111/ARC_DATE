+        base = _build_base_grid(h, w, list(zip(columns, heights)), signal_colors)
+        _out, meta = _solve(base)
+        towers = list(meta["towers"])
+        if _layout_matches(
+            towers,
+            blocked_required=blocked_required,
+            overlap_required=overlap_required,
+            meta=meta,
+        ):
