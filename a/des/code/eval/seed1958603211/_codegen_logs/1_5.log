+def _parse_scene(grid: np.ndarray) -> tuple[int, int, int, list[Tower], set[tuple[int, int]]]:
+    g = np.asarray(grid, dtype=int)
+    if g.ndim != 2:
+        raise ValueError("expected a 2D grid")
+
+    h, w = map(int, g.shape)
