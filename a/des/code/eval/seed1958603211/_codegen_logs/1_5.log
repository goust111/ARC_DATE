+def _tower_coverage(
+    grid: np.ndarray,
+    tower: Tower,
+    *,
+    ground_color: int,
+) -> tuple[list[int], bool]:
+    _, width = map(int, grid.shape)
+    covered = [tower.col]
+    blocked = False
