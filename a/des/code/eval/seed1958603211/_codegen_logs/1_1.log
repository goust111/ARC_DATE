+
+    grid[size, :] = DIVIDER
+    grid[size + 1 + middle_h, :] = DIVIDER
+
+    middle_r0 = size + 1
+    for anchor_row, anchor_col, color in anchors:
+        grid[middle_r0 + anchor_row, anchor_col] = color
