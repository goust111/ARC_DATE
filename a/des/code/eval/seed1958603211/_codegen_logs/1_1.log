+    top = g[:top_end, :]
+    middle = g[top_end + 1 : mid_end, :]
+    bottom = g[mid_end + 1 :, :]
+    assert top.size and middle.size and bottom.size
+
+    templates, size = _extract_templates(top, bg, divider_color)
