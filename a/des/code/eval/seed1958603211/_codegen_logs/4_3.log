+        for coords in _components(grid == color, DIR4):
+            if not _is_rect_frame(coords):
+                continue
+            frames.append({"color": color, "bbox": _bbox(coords), "coords": coords})
+    frames.sort(key=lambda item: (_area(item["bbox"]), item["bbox"]))
+    return frames
