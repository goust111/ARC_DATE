+    max_w = max(obj["patch"].shape[1] for obj in objects)
+    grid_h = rng.randint(max(GRID_MIN, max_h + 2), GRID_MAX)
+    grid_w = rng.randint(max(GRID_MIN, max_w + 2), GRID_MAX)
