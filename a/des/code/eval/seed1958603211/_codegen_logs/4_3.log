+        "sprite_box": sprite_box,
+        "nearest_box": nearest_box,
+    }
+
+
+def _reserve(
+    occupied: np.ndarray, r0: int, c0: int, r1: int, c1: int, halo: int = 1
+) -> None:
+    h, w = occupied.shape
+    rr0 = max(0, r0 - halo)
+    cc0 = max(0, c0 - halo)
+    rr1 = min(h - 1, r1 + halo)
+    cc1 = min(w - 1, c1 + halo)
+    occupied[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+
+
+def _is_free(
+    occupied: np.ndarray, r0: int, c0: int, r1: int, c1: int, halo: int = 1
+) -> bool:
+    h, w = occupied.shape
+    rr0 = max(0, r0 - halo)
+    cc0 = max(0, c0 - halo)
+    rr1 = min(h - 1, r1 + halo)
+    cc1 = min(w - 1, c1 + halo)
+    return not bool(occupied[rr0 : rr1 + 1, cc0 : cc1 + 1].any())
