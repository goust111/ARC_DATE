+    rr0 = max(0, r0 - halo)
+    cc0 = max(0, c0 - halo)
+    rr1 = min(h - 1, r1 + halo)
+    cc1 = min(w - 1, c1 + halo)
+    occupied[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
