+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = DIR4 + [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+
+GEN_RETRIES = 300
+GRID_MIN = 24
+GRID_MAX = 32
+GROUP_COUNT_RANGE = (2, 3)
+OUTER_COLOR_COUNT = 2
+SPRITE_COLOR_COUNT = 3
+PLACEMENT_ATTEMPTS = 600
+
+
+def _background_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray, neighbors: list[tuple[int, int]]) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in neighbors:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _shift_bbox(
+    box: tuple[int, int, int, int], dr: int, dc: int
+) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = box
+    return (r0 + dr, c0 + dc, r1 + dr, c1 + dc)
+
+
+def _area(box: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = box
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _strictly_contains(
+    outer: tuple[int, int, int, int], inner: tuple[int, int, int, int]
+) -> bool:
+    or0, oc0, or1, oc1 = outer
+    ir0, ic0, ir1, ic1 = inner
+    return or0 < ir0 and oc0 < ic0 and ir1 < or1 and ic1 < oc1
+
+
+def _is_rect_frame(coords: np.ndarray) -> bool:
