+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    if coords.shape[0] != 2 * h + 2 * w - 4:
+        return False
+    mask = np.zeros((h, w), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return bool(np.array_equal(mask, border))
