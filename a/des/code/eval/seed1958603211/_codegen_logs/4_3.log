+def _stamp_patch(grid: np.ndarray, patch: np.ndarray, top: int, left: int, bg: int) -> None:
+    h, w = patch.shape
+    window = grid[top : top + h, left : left + w]
+    mask = patch != bg
+    window[mask] = patch[mask]
