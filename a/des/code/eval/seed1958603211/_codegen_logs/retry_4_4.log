+    if cell_set & wall_cells:
+        return False
+    if cell_set & path_cells:
+        return False
+    for r, c in cell_set:
+        for nr, nc in [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]:
+            if (nr, nc) in wall_cells:
+                return False
