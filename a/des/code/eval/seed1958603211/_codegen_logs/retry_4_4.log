+            if not by_ray:
+                unhit_candidates.append((r, c))
+                continue
+
+            best_bounce = min(value[0] for value in by_ray.values())
+            best_colors = {value[1] for value in by_ray.values() if value[0] == best_bounce}
+            if len(best_colors) != 1:
