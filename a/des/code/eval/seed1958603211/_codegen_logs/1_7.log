+COUNT_PATTERNS = [
+    (1, 0),
+    (0, 1),
+    (1, 1),
+    (2, 1),
+    (1, 2),
+    (2, 2),
+    (3, 0),
+    (0, 3),
+]
+GRID_RANGES = {
+    2: ((18, 26), (18, 26)),
+    3: ((22, 29), (22, 29)),
+    4: ((25, 30), (25, 30)),
+}
+GEN_RETRIES = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in DIRS:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _count_symbols(interior: np.ndarray, color: int, horizontal: bool) -> int:
+    count = 0
+    for comp in _components(interior == color):
+        if len(comp) != 2:
+            continue
+        (r0, c0), (r1, c1) = sorted(comp)
+        if horizontal and r0 == r1 and abs(c1 - c0) == 1:
+            count += 1
+        if (not horizontal) and c0 == c1 and abs(r1 - r0) == 1:
+            count += 1
+    return count
+
+
+def _left_right(direction: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
+    dr, dc = direction
+    return (-dc, dr), (dc, -dr)
+
+
+def _draw_line(out: np.ndarray, start: tuple[int, int], direction: tuple[int, int], length: int, color: int) -> tuple[int, int]:
+    r, c = start
+    dr, dc = direction
+    for step in range(1, length + 1):
+        rr, cc = r + dr * step, c + dc * step
+        if 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1]:
+            out[rr, cc] = color
+    return r + dr * length, c + dc * length
+
+
+def _find_frames(grid: np.ndarray) -> list[dict]:
+    bg = _get_bg(grid)
+    frames: list[dict] = []
+    for color in np.unique(grid):
+        color = int(color)
+        if color in {bg, RED, BLUE}:
+            continue
+        mask = grid == color
+        rows = np.flatnonzero(mask.sum(axis=1) > 2)
+        cols = np.flatnonzero(mask.sum(axis=0) > 2)
+        if len(rows) != 2 or len(cols) != 2:
+            continue
+        r0, r1 = map(int, rows)
+        c0, c1 = map(int, cols)
+        if r1 - r0 < 2 or c1 - c0 < 2:
+            continue
