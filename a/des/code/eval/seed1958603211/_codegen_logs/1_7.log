+        mask = grid == color
+        rows = np.flatnonzero(mask.sum(axis=1) > 2)
+        cols = np.flatnonzero(mask.sum(axis=0) > 2)
+        if len(rows) != 2 or len(cols) != 2:
+            continue
+        r0, r1 = map(int, rows)
+        c0, c1 = map(int, cols)
+        if r1 - r0 < 2 or c1 - c0 < 2:
+            continue
