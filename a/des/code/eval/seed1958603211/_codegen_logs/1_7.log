+    return r + dr * length, c + dc * length
+
+
+def _find_frames(grid: np.ndarray) -> list[dict]:
+    bg = _get_bg(grid)
+    frames: list[dict] = []
+    for color in np.unique(grid):
+        color = int(color)
+        if color in {bg, RED, BLUE}:
