+        border = np.zeros_like(mask, dtype=bool)
+        border[r0, c0 : c1 + 1] = True
+        border[r1, c0 : c1 + 1] = True
+        border[r0 : r1 + 1, c0] = True
+        border[r0 : r1 + 1, c1] = True
+        if not np.array_equal(mask[r0 : r1 + 1, c0 : c1 + 1], border[r0 : r1 + 1, c0 : c1 + 1]):
