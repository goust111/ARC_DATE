+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    if out.shape != grid.shape:
+        return None
+    if np.array_equal(out, grid):
+        return None
+
+    if mode == "none":
+        expected = final_colors
+    else:
+        wall, parsed_rows, parsed_cols = _detect_walls(grid)
+        parsed_regions, parsed_neighbors, _r, _c = _region_defs(parsed_rows, parsed_cols)
