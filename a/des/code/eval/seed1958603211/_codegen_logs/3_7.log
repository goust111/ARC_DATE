+def _ranked_votes(patch: np.ndarray, wall: int) -> tuple[list[int], int]:
+    counts: Counter[int] = Counter()
+    order: dict[int, int] = {}
+    next_order = 0
+    for value in patch.ravel():
+        color = int(value)
+        if color in (BLACK, wall):
+            continue
+        counts[color] += 1
+        if color not in order:
+            order[color] = next_order
+            next_order += 1
