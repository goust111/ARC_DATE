+    prefs: dict[int, list[int]] = {}
+    totals: dict[int, int] = {}
+    for rid in range(n_regions):
+        pref, total = _default_votes(final_colors[rid], palette)
+        prefs[rid] = pref
+        totals[rid] = total
+    return final_colors, prefs, totals
