+    for _ in range(80):
+        mask = np.zeros((h, w), dtype=bool)
+        for _ in range(rng.randint(1, 3)):
+            rh = rng.randint(1, h)
+            rw = rng.randint(1, w)
+            r0 = rng.randint(0, h - rh)
+            c0 = rng.randint(0, w - rw)
+            mask[r0 : r0 + rh, c0 : c0 + rw] = True
