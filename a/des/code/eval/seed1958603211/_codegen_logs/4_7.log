+    pairs = list(zip(base_colors, target_colors))
+    rng.shuffle(pairs)
+    gap = rng.randint(1, 2)
+    width = len(pairs) * 2 + (len(pairs) - 1) * gap
+    row = np.full((1, width), int(bg), dtype=int)
+    c = 0
+    for i, (src, dst) in enumerate(pairs):
+        row[0, c] = int(src)
+        row[0, c + 1] = int(dst)
