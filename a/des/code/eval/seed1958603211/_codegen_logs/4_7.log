+
+def _find_board_boxes(grid: np.ndarray, bg: int) -> list[tuple[int, int, int, int]]:
+    groups: dict[tuple[int, int], list[tuple[int, int, int, int]]] = {}
+    for pts in _components(grid != bg):
+        r0, c0, r1, c1 = _bbox(pts)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
