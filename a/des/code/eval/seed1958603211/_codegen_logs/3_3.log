0083:     marker_choices = list(range(marker_min, MARKER_COL_RANGE[1] + 1))
0084:     marker_weights = [MARKER_WEIGHTS[0]] + [MARKER_WEIGHTS[1]] * (len(marker_choices) - 1)
0085:     marker_col = random.choices(marker_choices, weights=marker_weights, k=1)[0]
