0072:     first_rows = FIRST_ROWS_SINGLE if num_bars == 1 else FIRST_ROWS_MULTI
0073:     first_src_row = random.choice(first_rows)
0074:     height = ROW_STRIDE * (first_src_row + num_bars - 1)
0075: 
0076:     bar_lengths = random.sample(BAR_LENGTHS, k=num_bars)
0077:     start_cols = [random.randint(*START_COL_RANGE) for _ in range(num_bars)]
0078:     max_bar_end = max(c + length - 1 for c, length in zip(start_cols, bar_lengths))
0079: 
0080:     marker_min = max(MARKER_COL_RANGE[0], max_bar_end + 1)
0081:     if marker_min > MARKER_COL_RANGE[1]:
