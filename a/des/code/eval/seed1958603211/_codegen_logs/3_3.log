0010: def main(grid: np.ndarray) -> np.ndarray:
0011:     """Add a quantity-color label in the top marker column for each horizontal bar.
0012: 
0013:     Input structure
0014:     - The grid has a black background and one non-background marker pixel in the top row.
0015:     - Below the marker row, every non-empty source row contains one solid monochrome horizontal bar to the left of the marker column.
0016:     - Source rows are staggered every other row.
0017: 
0018:     Rule
0019:     - Copy the input grid.
0020:     - For each source bar, read its quantity as the bar length.
0021:     - Paint the quantity color in the marker column on the same row as the bar:
0022:       2->1, 3->4, 4->9, 5->6.
0023: 
0024:     Key insight
0025:     - The grey marker supplies the result column, while each bar supplies a small quantity with a fixed color code.
0026:     """
0027:     g = np.asarray(grid, dtype=int)
0028:     bg = get_bg(g)
0029:     assert bg == 0, "expected black background for square-digit labels"
0030: 
0031:     marker_cols = np.flatnonzero(g[0] != bg)
0032:     assert len(marker_cols) == 1, "expected exactly one top-row marker"
0033:     marker_c = int(marker_cols[0])
0034:     assert g[0, marker_c] == Color.GREY, "top-row marker must be grey"
0035: 
0036:     source_rows = [r for r in range(1, g.shape[0]) if np.any(g[r] != bg)]
0037:     assert source_rows, "expected at least one source bar"
0038:     first_source_row = source_rows[0]
0039: 
0040:     out = g.copy()
0041:     for bar_order, r in enumerate(source_rows):
0042:         assert (r - first_source_row) % 2 == 0, "source bars must follow the staggered row spacing"
0043:         cols = np.flatnonzero(g[r] != bg)
0044:         c0, c1 = int(cols[0]), int(cols[-1])
0045:         expected_cols = np.arange(c0, c1 + 1)
0046:         assert np.array_equal(cols, expected_cols), "source row must contain one contiguous bar"
0047:         assert np.unique(g[r, c0 : c1 + 1]).size == 1, "source bar must be monochrome"
0048:         assert c1 < marker_c, "source bar must lie to the left of the marker column"
0049:         assert g[r, marker_c] == bg, "marker-column output cell must be empty"
0050: 
0051:         bar_length = c1 - c0 + 1
0052:         assert 2 <= bar_length <= 5, "bar length quantity must be 2-5"
0053:         assert bar_length in _QUANTITY_TO_COLOR, "quantity must be one of 2, 3, 4, or 5"
0054:         out[r, marker_c] = _QUANTITY_TO_COLOR[bar_length]
0055: 
