+    short_hi = min(max_layers, max(1, legend_len - 1))
+    long_lo = legend_len + 1
+
+    if mode == "short":
+        count = random.randint(*FRAMEWORK_COUNT_BOUNDS)
+        return [random.randint(1, short_hi) for _ in range(count)]
+
