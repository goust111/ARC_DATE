+GEN_RETRIES = 400
+GEN_CELL_RANGE = (8, 10)
+GEN_GRID_ROWS = (3, 4)
+GEN_GRID_COLS = (3, 4)
+GEN_PIECE_COUNT = (2, 3)
+GEN_OCCUPIED_MAX = 2
+GEN_SOCKET_COUNT = (1, 4)
