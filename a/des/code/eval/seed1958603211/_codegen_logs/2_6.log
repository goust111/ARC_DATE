+
+    for (i, j), signature, piece in zip(target_cells, target_signatures, solved_pieces, strict=False):
+        r0 = 1 + i * (cell_h + 1)
+        c0 = 1 + j * (cell_w + 1)
+        slot_patch = _slot_with_sockets(cell_h, cell_w, signature, bg)
