+def _paint_piece(
+    mask: np.ndarray,
+    fill: int,
+    signature: tuple[int | None, ...],
+    bg: int,
+) -> np.ndarray:
+    patch = np.full(mask.shape, int(bg), dtype=int)
+    patch[mask] = int(fill)
+    anchors = _anchor_map(*mask.shape)
+    for side, color in zip(SIDE_ORDER, signature, strict=False):
+        if color is None:
+            continue
+        r, c = anchors[side]
+        assert bool(mask[r, c])
+        patch[r, c] = int(color)
+    return patch
+
+
+def _slot_with_sockets(
+    cell_h: int,
+    cell_w: int,
+    signature: tuple[int | None, ...],
+    bg: int,
+) -> np.ndarray:
+    patch = np.full((cell_h, cell_w), int(bg), dtype=int)
+    anchors = _anchor_map(cell_h, cell_w)
+    for side, color in zip(SIDE_ORDER, signature, strict=False):
+        if color is None:
+            continue
+        r, c = anchors[side]
+        patch[r, c] = int(color)
+    return patch
