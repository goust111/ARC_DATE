+
+    slots: list[dict] = []
+    for i in range(row_count):
+        for j in range(col_count):
+            if (i, j) == (bank_i, bank_j):
+                continue
+            r0, r1, c0, c1 = _cell_bounds(row_lines, col_lines, i, j)
+            patch = g[r0:r1, c0:c1]
+            fg = patch != int(bg)
+            interior_fg = fg & ~boundary
+            if bool(interior_fg.any()):
