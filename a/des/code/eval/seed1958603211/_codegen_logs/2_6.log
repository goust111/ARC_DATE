+def _cell_bounds(row_lines: list[int], col_lines: list[int], i: int, j: int) -> tuple[int, int, int, int]:
+    r0 = int(row_lines[i] + 1)
+    r1 = int(row_lines[i + 1])
+    c0 = int(col_lines[j] + 1)
+    c1 = int(col_lines[j + 1])
