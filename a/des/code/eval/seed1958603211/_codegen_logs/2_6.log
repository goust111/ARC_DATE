+    try:
+        actual = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(actual, expected):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
