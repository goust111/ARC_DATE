+
+def _boundary_mask(shape: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = True
+    mask[h - 1, :] = True
+    mask[:, 0] = True
+    mask[:, w - 1] = True
+    return mask
