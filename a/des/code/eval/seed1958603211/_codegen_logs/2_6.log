+    target_remove = random.randint(0, max(0, max_remove))
+    removed = 0
+    for r, c in removable:
+        if removed >= target_remove:
+            break
+        trial = mask.copy()
+        trial[r, c] = False
+        if int(trial.sum()) < min_area:
+            continue
+        if not _is_connected(trial):
