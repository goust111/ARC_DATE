+    pieces: list[np.ndarray] = []
+    bank_r0, bank_r1, bank_c0, bank_c1 = _cell_bounds(row_lines, col_lines, bank_i, bank_j)
+    bank_patch = g[bank_r0:bank_r1, bank_c0:bank_c1]
