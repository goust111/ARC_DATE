+
+def _direction_step(direction: str, shape_h: int, shape_w: int) -> tuple[int, int]:
+    unit_r, unit_c = UNIT_VECTORS[direction]
+    step = shape_w if direction in {"left", "right"} else shape_h
+    return unit_r * step, unit_c * step
