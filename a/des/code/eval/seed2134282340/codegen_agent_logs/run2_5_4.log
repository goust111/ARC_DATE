+BG = 0
+MAROON = 9
+PALETTE = (1, 2, 3, 4, 5, 6, 7, 8)
+GENERATE_RETRIES = 400
+PLACE_RETRIES = 250
+
+ARROW_PATTERNS = {
+    "right": frozenset({(1, 0), (1, 1), (1, 2), (0, 2), (2, 2)}),
+    "left": frozenset({(1, 0), (1, 1), (1, 2), (0, 0), (2, 0)}),
+    "down": frozenset({(0, 1), (1, 1), (2, 1), (2, 0), (2, 2)}),
+    "up": frozenset({(0, 1), (1, 1), (2, 1), (0, 0), (0, 2)}),
+}
+
+UNIT_VECTORS = {
+    "right": (0, 1),
+    "left": (0, -1),
+    "down": (1, 0),
+    "up": (-1, 0),
