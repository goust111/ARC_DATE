+        rows,
+        cols,
+        cell_size,
+        cell_categories,
+        category_colors,
+        grid_r0,
+        grid_c0,
+    )
+    if not np.array_equal(main(canvas), expected):
+        return None
+    return canvas
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
