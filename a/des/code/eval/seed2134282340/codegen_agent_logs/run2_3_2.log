+        [[rng.random() < prob for _ in range(w)] for _ in range((h + 1) // 2)],
+        dtype=bool,
+    )
+    mask = np.zeros((h, w), dtype=bool)
+    mask[: (h + 1) // 2, :] = seed
+    mask |= np.flipud(mask)
+    return mask
