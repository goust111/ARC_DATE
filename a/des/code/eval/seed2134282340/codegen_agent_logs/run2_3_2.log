+import random
+from typing import Dict, Iterable, List, Sequence, Tuple
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+CYAN = 8
+MAROON = 9
+
+CATEGORIES = ("horizontal", "vertical", "rotation", "asymmetric")
+PALETTE_COLORS = (BLUE, GREEN, YELLOW, MAGENTA, ORANGE, CYAN, MAROON)
+GEN_ATTEMPTS = 400
