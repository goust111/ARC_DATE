+            break
+        else:
+            return None
+
+    legend_examples: Dict[str, np.ndarray] = {}
+    for category in CATEGORIES:
+        for _ in range(200):
+            shape = _generate_shape(cell_size, category, rng, exact=True)
+            sig = _mask_signature(shape)
+            if sig in used:
