+        canvas_w = max(left_margin + gw + right_margin, legend_left + lw + rng.randint(1, 3))
+        canvas = np.zeros((canvas_h, canvas_w), dtype=int)
+        grid_r0 = top_margin
+        grid_c0 = left_margin
+        legend_r0 = grid_r0 + gh + gap
+        legend_c0 = legend_left
