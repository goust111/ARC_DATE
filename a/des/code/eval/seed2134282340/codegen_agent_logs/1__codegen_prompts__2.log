  99: def _make_image(h: int, w: int) -> np.ndarray:
 100:     counts = _bounded_counts(h * w)
 101:     colors = COLOR_PALETTE[:]
 102:     random.shuffle(colors)
 103:     image = np.empty((h, w), dtype=int)
 104:     path = _cell_path(h, w)
 105:     idx = 0
 106:     for color, count in zip(colors, counts):
 107:         for r, c in path[idx : idx + count]:
 108:             image[r, c] = color
 109:         idx += count
 110:     return image
