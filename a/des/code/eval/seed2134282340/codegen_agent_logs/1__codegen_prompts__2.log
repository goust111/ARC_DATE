   7: def main(grid: np.ndarray) -> np.ndarray:
   8:     """Remove the left control column and roll the remaining image downward by the red marker's row.
   9: 
  10:     Input structure
  11:     - The input is a rectangular grid with a one-cell-wide control column on the left.
  12:     - That control column is all pink except for exactly one red marker pixel.
  13:     - The columns to the right are the image that remains in the output.
  14: 
  15:     Rule
  16:     - Delete the left control column.
  17:     - Let r be the row index of the red marker in that column.
  18:     - Cyclically shift the remaining image downward by r rows.
  19: 
  20:     Key insight
  21:     - The red marker's vertical position encodes the row-roll amount; the pink
  22:       column is only a control strip and is removed after reading it.
  23:     """
  24:     g = np.asarray(grid, dtype=int)
  25:     assert g.ndim == 2
  26:     h, w = g.shape
  27:     assert h > 0 and w > 1
  28: 
  29:     control = g[:, 0]
  30:     marker_rows = np.where(control == Color.RED)[0]
  31:     assert marker_rows.size == 1
  32:     assert np.all((control == Color.PINK) | (control == Color.RED))
  33:     assert np.count_nonzero(control == Color.PINK) == h - 1
  34: 
  35:     shift = int(marker_rows[0])
  36:     return np.roll(g[:, 1:], shift=shift, axis=0)
  37: 
  38: # --------------- generator (att2) ---------------
