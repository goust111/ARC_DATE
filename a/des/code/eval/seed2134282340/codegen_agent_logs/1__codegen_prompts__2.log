  44: # Color balancing.
  45: COLOR_PALETTE = [Color.BLUE, Color.GREEN, Color.YELLOW, Color.GREY, Color.TEAL, Color.MAROON]
  46: COLOR_COUNT = 6
  47: CELLS_PER_COLOR_RANGE = (4, 9)
  48: # Layout sampling.
  49: PATH_MODES = ["row_snake", "col_snake", "row_runs", "col_runs", "diagonal"]
  50: ORIENTATION_CHOICES = [False, True]
  51: # Control strip and retry behavior.
  52: CONTROL_FILL_COLOR = Color.PINK
  53: CONTROL_MARKER_COLOR = Color.RED
  54: GENERATION_RETRIES = 300
  55: 
  56: 
  57: def _bounded_counts(total: int) -> list[int]:
  58:     counts = []
  59:     remaining = total
  60:     lo, hi = CELLS_PER_COLOR_RANGE
  61:     for i in range(COLOR_COUNT):
  62:         left = COLOR_COUNT - i - 1
  63:         low = max(lo, remaining - left * hi)
  64:         high = min(hi, remaining - left * lo)
  65:         value = random.randint(low, high)
  66:         counts.append(value)
  67:         remaining -= value
  68:     random.shuffle(counts)
  69:     return counts
  70: 
  71: 
  72: def _cell_path(h: int, w: int) -> list[tuple[int, int]]:
  73:     mode = random.choice(PATH_MODES)
  74:     if mode == "row_snake":
  75:         path = [(r, c) for r in range(h) for c in (range(w) if r % 2 == 0 else range(w - 1, -1, -1))]
  76:     elif mode == "col_snake":
  77:         path = [(r, c) for c in range(w) for r in (range(h) if c % 2 == 0 else range(h - 1, -1, -1))]
  78:     elif mode == "row_runs":
  79:         path = [(r, c) for r in range(h) for c in range(w)]
  80:     elif mode == "col_runs":
  81:         path = [(r, c) for c in range(w) for r in range(h)]
  82:     else:
  83:         path = []
  84:         for diag in range(h + w - 1):
  85:             cells = [(r, diag - r) for r in range(h) if 0 <= diag - r < w]
  86:             if diag % 2:
  87:                 cells.reverse()
  88:             path.extend(cells)
  89: 
  90:     if random.choice(ORIENTATION_CHOICES):
  91:         path = [(h - 1 - r, c) for r, c in path]
  92:     if random.choice(ORIENTATION_CHOICES):
  93:         path = [(r, w - 1 - c) for r, c in path]
  94:     if random.choice(ORIENTATION_CHOICES):
  95:         path.reverse()
  96:     return path
