+    extra_gap_need = n_objects - 1
+    if side in ("top", "bottom"):
+        min_h = max(18, legend_depth + 10)
+        min_w = max(18, legend_span + extra_gap_need + 4)
+    else:
+        min_h = max(18, legend_span + extra_gap_need + 4)
