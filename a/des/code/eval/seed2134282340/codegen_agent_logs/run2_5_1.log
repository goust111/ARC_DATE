+        expected[r0, c0 : c1 + 1] = target_color
+        expected[r1, c0 : c1 + 1] = target_color
+        expected[r0 : r1 + 1, c0] = target_color
+        expected[r0 : r1 + 1, c1] = target_color
+
+    try:
+        if np.array_equal(main(grid), expected):
+            return grid, expected
+    except Exception:
+        return None
+    return None
+
