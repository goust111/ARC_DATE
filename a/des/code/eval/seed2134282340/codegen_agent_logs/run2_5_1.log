+    h = random.randint(min_h, max_h)
+    w = random.randint(min_w, max_w)
+    grid = np.full((h, w), BG, dtype=int)
+    blocked = np.zeros((h, w), dtype=bool)
+
+    patch_order = list(range(n_objects))
+    random.shuffle(patch_order)
