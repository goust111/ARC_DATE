+        )
+        legend_span += int(entry_patch.shape[1] if side in ("top", "bottom") else entry_patch.shape[0])
+
+        sh, sw = fragment_mask.shape
+        fh = random.randint(sh + 4, min(sh + 7, 10))
+        fw = random.randint(sw + 4, min(sw + 7, 10))
