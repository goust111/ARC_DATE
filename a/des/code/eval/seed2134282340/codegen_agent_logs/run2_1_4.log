+        r0, c0 = map(int, coords.min(axis=0))
+        r1, c1 = map(int, coords.max(axis=0))
+        assert (r1 - r0, c1 - c0) == (1, 1), "tower must be a 2x2 block"
+        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color), "tower block must be solid"
+        towers[color] = {
