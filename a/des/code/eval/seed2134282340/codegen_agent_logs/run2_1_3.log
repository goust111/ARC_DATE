+                    total_right += int(move[1])
+                else:
+                    total_down += int(move[1])
+
+            commands.append(("pen_down", rng.choice(PATTERN_COLORS)))
+
+            for _ in range(rng.randint(1, 3 if segments > 1 else 4)):
+                move = _random_move(rng)
+                commands.append(move)
