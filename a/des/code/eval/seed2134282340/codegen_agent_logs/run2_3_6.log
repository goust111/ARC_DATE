+        "sprite": cropped,
+        "mask": cropped != BG,
+        "height": int(cropped.shape[0]),
+        "width": int(cropped.shape[1]),
+    }
+
+
+def _extract_components(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = map(int, g.shape)
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == BG or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            coord_arr = np.array(coords, dtype=int)
+            rows = coord_arr[:, 0]
+            cols = coord_arr[:, 1]
+            r0, r1 = int(rows.min()), int(rows.max())
+            c0, c1 = int(cols.min()), int(cols.max())
+            sprite = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+            sprite[rows - r0, cols - c0] = color
+            components.append(
