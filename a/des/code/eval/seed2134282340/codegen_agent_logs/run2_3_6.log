+
+def _place_sprites(sprites: list[np.ndarray], height: int) -> np.ndarray | None:
+    widths = [int(sprite.shape[1]) for sprite in sprites]
+    n = len(sprites)
+    feasible_lane_counts = [lane_count for lane_count in (2, 3) if lane_count <= n]
