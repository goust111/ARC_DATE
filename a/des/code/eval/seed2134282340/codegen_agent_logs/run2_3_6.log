+        sprite = np.zeros((h, out_w), dtype=int)
+        sprite[:, :wl][left_mask] = int(left["color"])
+        right_view = sprite[:, shift : shift + wr]
+        right_view[right_mask] = int(right["color"])
+        candidates.append(
+            {
+                "left_color": int(left["color"]),
+                "right_color": int(right["color"]),
+                "width": out_w,
+                "height": h,
+                "area": int(h * out_w),
+                "shift": shift,
+                "sprite": sprite,
