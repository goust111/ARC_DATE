+    return solved_pairs == expected_pairs and solved_areas == sorted(expected_areas)
+
+
+def _lane_assign(widths: list[int], lane_count: int) -> list[list[int]]:
+    lanes: list[list[int]] = [[] for _ in range(lane_count)]
