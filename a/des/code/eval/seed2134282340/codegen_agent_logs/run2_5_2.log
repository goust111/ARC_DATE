+from __future__ import annotations
+
+import random
+from collections import Counter, defaultdict
+
+import numpy as np
+
+
+BG_COLOR = 8
+SOURCE_COLOR = 4
+PATH_COLOR_POOL = [1, 2, 3, 5, 6, 7, 9]
+ROOM_BORDER_OFFSETS = [
+    (0, 0), (0, 1), (0, 2),
+    (1, 0),         (1, 2),
+    (2, 0), (2, 1), (2, 2),
+]
