+
+    expected = grid.copy()
+    for path in paths:
+        expected[path["room_center"]] = path["final_color"]
+
+    k = rng.randrange(4)
+    if k:
+        grid = np.rot90(grid, k)
+        expected = np.rot90(expected, k)
+    if rng.random() < 0.5:
+        grid = np.fliplr(grid)
+        expected = np.fliplr(expected)
+
+    bg = _bg_color(grid)
