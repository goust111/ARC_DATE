+
+def _center_rect(h: int, w: int) -> tuple[int, int, int, int]:
+    ch = 1 if h % 2 else 2
+    cw = 1 if w % 2 else 2
+    r0 = (h - ch) // 2
+    c0 = (w - cw) // 2
+    return r0, r0 + ch, c0, c0 + cw
