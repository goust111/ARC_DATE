+    objects: list[dict] = []
+    idx = 0
+    rows_expected: list[list[np.ndarray]] = []
+    for row_len in row_structure:
+        row_expected: list[np.ndarray] = []
+        for _ in range(row_len):
+            hole_target = int(rng.integers(1, 4))
