+
+def _sample_folds(rng: random.Random, height: int, width: int) -> tuple[list[tuple[str, int]], tuple[int, int]]:
+    for _ in range(120):
+        top, bottom = 0, height
+        left, right = 0, width
+        folds: list[tuple[str, int]] = []
+        target_len = rng.randint(2, 4)
+
+        while len(folds) < target_len:
