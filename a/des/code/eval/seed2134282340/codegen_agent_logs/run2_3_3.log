+                side = rng.choice(("top", "bottom"))
+                small = rng.randint(1, max_small)
+                if side == "top":
+                    axis = top + small
+                    top = axis + 1
+                else:
+                    axis = bottom - small - 1
+                    bottom = axis
+                folds.append(("H", axis))
+            else:
+                span = right - left
+                max_small = (span - 2) // 2
+                if max_small < 1:
+                    break
+                side = rng.choice(("left", "right"))
+                small = rng.randint(1, max_small)
+                if side == "left":
+                    axis = left + small
+                    left = axis + 1
+                else:
+                    axis = right - small - 1
+                    right = axis
