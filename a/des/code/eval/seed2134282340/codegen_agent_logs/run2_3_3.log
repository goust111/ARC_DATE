+        cols = np.unique(seg[:, 1])
+        if len(rows) == 1:
+            row = int(rows[0])
+            assert len(seg) == inner_w, "horizontal segment length must match the frame width"
+            assert len(cols) == inner_w, "horizontal segment must be contiguous"
