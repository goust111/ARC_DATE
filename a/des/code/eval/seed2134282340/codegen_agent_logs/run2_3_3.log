+def _sample_pattern(rng: random.Random, height: int, width: int) -> np.ndarray:
+    area = height * width
+    mask = np.zeros((height, width), dtype=bool)
+    stamp_count = rng.randint(4, 8)
+    for _ in range(stamp_count):
+        kind = rng.choice(("point", "hline", "vline", "rect"))
+        if kind == "point":
