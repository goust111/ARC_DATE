+    grid[rect_top + rect_h - 1, rect_left : rect_left + rect_w] = GRAY
+    grid[rect_top : rect_top + rect_h, rect_left] = GRAY
+    grid[rect_top : rect_top + rect_h, rect_left + rect_w - 1] = GRAY
