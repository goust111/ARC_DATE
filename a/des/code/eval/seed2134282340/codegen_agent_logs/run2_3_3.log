+    bar_len = len(colors)
+    min_col = 1
+    max_col = grid.shape[1] - bar_len - 1
+    if max_col < min_col:
+        min_col = 0
+        max_col = grid.shape[1] - bar_len
+    bar_col = rng.randint(min_col, max_col)
+    grid[bar_row, bar_col : bar_col + bar_len] = np.array(colors, dtype=int)
+    return grid
