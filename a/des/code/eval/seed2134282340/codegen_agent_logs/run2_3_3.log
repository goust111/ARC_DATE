+            continue
+        border_area = 2 * (h + w) - 4
+        if len(coords) != border_area:
+            continue
+        sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+        border = np.zeros_like(sub, dtype=bool)
+        border[0, :] = True
+        border[-1, :] = True
+        border[:, 0] = True
+        border[:, -1] = True
+        if np.all(sub[border] == GRAY) and np.all(sub[~border] != GRAY):
+            candidates.append((h * w, (r0, c0, r1, c1)))
