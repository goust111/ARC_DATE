+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        attempt = _gen_attempt(rng)
+        if attempt is None:
+            continue
+        grid, expected = attempt
+        try:
+            actual = main(grid)
+        except Exception:
+            continue
+        if np.array_equal(actual, expected):
+            return grid
+    raise RuntimeError("failed to generate a valid folding input")

