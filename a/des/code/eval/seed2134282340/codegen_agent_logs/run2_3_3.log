+        if np.all(sub[border] == GRAY) and np.all(sub[~border] != GRAY):
+            candidates.append((h * w, (r0, c0, r1, c1)))
+    assert candidates, "expected one gray rectangular frame"
+    return max(candidates, key=lambda item: item[0])[1]
