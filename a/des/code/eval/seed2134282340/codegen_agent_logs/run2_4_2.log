+        for piece_id in range(n_pieces):
+            coords = [tuple(map(int, rc)) for rc in np.argwhere(labels == piece_id)]
+            piece = _piece_from_coords(coords)
+            if int(piece["area"]) < MIN_PIECE_AREA:
+                break
