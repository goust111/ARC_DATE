+
+
+def _gen_attempt() -> np.ndarray | None:
+    n_regions = random.randint(2, 4)
+    n_legend = random.randint(max(3, n_regions), min(5, len(TEMPLATE_MASKS)))
+
+    colors = random.sample(AVAILABLE_COLORS, n_legend)
