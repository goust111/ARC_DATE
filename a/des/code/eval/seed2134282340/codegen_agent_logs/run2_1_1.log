+                    "color": int(spec["color"]),
+                    "offsets": spec["offsets"],
+                    "direction": str(spec["direction"]),
+                    "seed": (top + seed_r, left + seed_c),
+                    "gap": (top + gap_r, left + gap_c),
+                    "bbox": (top, left, top + bbox_h - 1, left + bbox_w - 1),
