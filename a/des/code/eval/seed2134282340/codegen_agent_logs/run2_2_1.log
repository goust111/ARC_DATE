+def _build_template_options() -> dict[tuple[int, int], dict[int, list[tuple[tuple[tuple[int, int], ...], tuple[int, int]]]]]:
+    by_dir: dict[tuple[int, int], dict[int, list[tuple[tuple[tuple[int, int], ...], tuple[int, int]]]]] = {
