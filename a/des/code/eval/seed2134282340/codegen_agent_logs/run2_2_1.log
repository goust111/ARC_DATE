+def _touches_body(body: set[tuple[int, int]], cell: tuple[int, int]) -> bool:
+    cr, cc = cell
+    for br, bc in body:
+        if max(abs(int(br - cr)), abs(int(bc - cc))) == 1:
+            return True
+    return False
