+        anchor_colors = [color for color, ct in counts.items() if int(color) != int(main_color) and int(ct) == 1]
+        assert len(anchor_colors) == 1, "each seed must have a unique single-pixel anchor"
+        anchor_color = int(anchor_colors[0])
