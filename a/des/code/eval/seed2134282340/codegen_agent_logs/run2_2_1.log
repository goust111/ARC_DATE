+def _components8(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if seen[rr, cc]:
+            continue
+        stack = [(rr, cc)]
+        seen[rr, cc] = True
+        comp: list[tuple[int, int]] = []
+        while stack:
+            cr, cc2 = stack.pop()
+            comp.append((int(cr), int(cc2)))
+            for dr in (-1, 0, 1):
+                for dc in (-1, 0, 1):
