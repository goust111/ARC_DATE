+        body = sorted((int(r), int(c)) for r, c in comp if int(left[r, c]) == int(main_color))
+        anchor_cells = [(int(r), int(c)) for r, c in comp if int(left[r, c]) == int(anchor_color)]
+        assert len(anchor_cells) == 1
+        anchor = anchor_cells[0]
