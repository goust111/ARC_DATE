+
+def _pattern_cells(
+    body: list[tuple[int, int]],
+    direction: tuple[int, int],
+    steps: int,
+    sep: int,
+    shape: tuple[int, int],
+) -> list[tuple[int, int]] | None:
+    h, w = shape
+    dr, dc = direction
+    base = [(int(r), int(2 * sep - c)) for r, c in body]
+    cells: list[tuple[int, int]] = []
+    for step in range(steps + 1):
+        for r, c in base:
+            rr = int(r + step * dr)
+            cc = int(c + step * dc)
+            if not (0 <= rr < h and sep < cc < w):
+                return None
+            cells.append((rr, cc))
