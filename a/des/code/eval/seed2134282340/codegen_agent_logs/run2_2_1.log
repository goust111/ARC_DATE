+
+        options = {
+            (-1, 0): [(r0 - 1, c) for c in range(c0, c1 + 1) if r0 > 0],
+            (1, 0): [(r1 + 1, c) for c in range(c0, c1 + 1) if r1 < 2],
+            (0, -1): [(r, c0 - 1) for r in range(r0, r1 + 1) if c0 > 0],
+            (0, 1): [(r, c1 + 1) for r in range(r0, r1 + 1) if c1 < 2],
