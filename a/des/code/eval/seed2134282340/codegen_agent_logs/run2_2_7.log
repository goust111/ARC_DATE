+        branches = ["h", "v", rng.choice(["d_hv", "d_vh"])]
+    else:
+        branches = ["h", "v", "d_hv", "d_vh"]
+        extras = pair_count - 4
+        for _ in range(extras):
+            branches.append(rng.choice(["h", "v", "d_hv", "d_vh"]))
