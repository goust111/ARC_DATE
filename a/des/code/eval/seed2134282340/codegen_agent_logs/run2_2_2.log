+def _mark_rect(reserved: np.ndarray, top: int, left: int, h: int, w: int, pad: int) -> None:
+    hh, ww = reserved.shape
+    r0 = max(0, top - pad)
+    c0 = max(0, left - pad)
+    r1 = min(hh, top + h + pad)
+    c1 = min(ww, left + w + pad)
+    reserved[r0:r1, c0:c1] = True
+
