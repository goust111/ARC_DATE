+        frame = frames[frame_index]
+        r0, c0, r1, c1 = frame["bbox"]
+        gap_mask = frame["gap_mask"]
+        for rr, cc in np.argwhere(gap_mask):
+            out[r0 + int(rr), c0 + int(cc)] = int(frame["color"])
+        out[r0 + 1 : r1, c0 + 1 : c1] = int(piece["color"])
