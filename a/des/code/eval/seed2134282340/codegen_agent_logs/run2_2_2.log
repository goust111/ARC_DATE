+
+def _build_frame_and_piece(spec: dict, frame_color: int, piece_color: int, rng: random.Random) -> dict | None:
+    need = int(spec.get("length", max(spec.get("arms", (0, 0)))))
+    lo = max(FRAME_SIDE_MIN, need)
