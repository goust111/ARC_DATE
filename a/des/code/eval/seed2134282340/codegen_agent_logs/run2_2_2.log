+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _background_color(grid: np.ndarray) -> int:
+    counts = np.bincount(grid.ravel(), minlength=10)
+    return int(np.argmax(counts))
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _mask_from_coords(coords: Iterable[tuple[int, int]]) -> np.ndarray:
+    coords = list(coords)
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    r0, c0 = min(rows), min(cols)
+    r1, c1 = max(rows), max(cols)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
+    return mask
+
+
+def _normalize_mask(mask: np.ndarray) -> np.ndarray:
+    pts = np.argwhere(mask)
+    assert len(pts) > 0
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].copy()
+
+
+def _shape_variants(mask: np.ndarray) -> list[np.ndarray]:
+    variants: list[np.ndarray] = []
+    seen = set()
+    for k in range(4):
+        rot = _normalize_mask(np.rot90(mask, k))
+        key = (rot.shape, rot.astype(np.uint8).tobytes())
+        if key in seen:
+            continue
+        seen.add(key)
+        variants.append(rot)
+    return variants
+
+
+def _shape_key(mask: np.ndarray) -> tuple[int, int, bytes]:
+    keys = []
+    for variant in _shape_variants(mask):
+        keys.append(
+            (int(variant.shape[0]), int(variant.shape[1]), variant.astype(np.uint8).tobytes())
+        )
+    return min(keys)
+
+
+def _same_shape_up_to_rotation(a: np.ndarray, b: np.ndarray) -> bool:
+    for variant in _shape_variants(a):
+        if variant.shape == b.shape and np.array_equal(variant, b):
+            return True
+    return False
+
+
+def _connected(coords: set[tuple[int, int]]) -> bool:
+    if not coords:
+        return False
+    start = next(iter(coords))
+    stack = [start]
+    seen = {start}
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in DIRS4:
+            nxt = (r + dr, c + dc)
+            if nxt in coords and nxt not in seen:
+                seen.add(nxt)
+                stack.append(nxt)
+    return len(seen) == len(coords)
+
+
+def _components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or visited[r, c]:
+                continue
+            queue = [(r, c)]
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
+            qi = 0
+            while qi < len(queue):
+                cr, cc = queue[qi]
+                qi += 1
+                coords.append((cr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc]:
+                        if int(grid[nr, nc]) == color:
+                            visited[nr, nc] = True
+                            queue.append((nr, nc))
+            r0, c0, r1, c1 = _bbox(coords)
+            rel = [(rr - r0, cc - c0) for rr, cc in coords]
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in rel:
+                mask[rr, cc] = True
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": mask,
+                    "rel_coords": rel,
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _boundary_cells(h: int, w: int) -> set[tuple[int, int]]:
+    cells = set()
+    for c in range(w):
+        cells.add((0, c))
+        cells.add((h - 1, c))
+    for r in range(h):
+        cells.add((r, 0))
+        cells.add((r, w - 1))
+    return cells
+
+
+def _analyze_frame(comp: dict, grid: np.ndarray, bg: int) -> dict | None:
+    base_r0, base_c0, base_r1, base_c1 = comp["bbox"]
+    color = int(comp["color"])
+    h_grid, w_grid = grid.shape
+    abs_coords = set((int(r), int(c)) for r, c in comp["coords"])
+
+    best = None
+    best_score = None
+    for r0 in [base_r0, base_r0 - 1]:
+        for c0 in [base_c0, base_c0 - 1]:
+            for r1 in [base_r1, base_r1 + 1]:
+                for c1 in [base_c1, base_c1 + 1]:
+                    if r0 < 0 or c0 < 0 or r1 >= h_grid or c1 >= w_grid:
+                        continue
+                    h = int(r1 - r0 + 1)
+                    w = int(c1 - c0 + 1)
+                    if h < 4 or w < 4:
+                        continue
+
+                    boundary = _boundary_cells(h, w)
+                    rel_set = set((r - r0, c - c0) for r, c in abs_coords)
+                    if any(cell not in boundary for cell in rel_set):
+                        continue
+
+                    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+                    valid = True
+                    for rr in range(h):
+                        for cc in range(w):
+                            cell = (rr, cc)
+                            value = int(sub[rr, cc])
+                            if cell in rel_set:
+                                if value != color:
+                                    valid = False
+                                    break
+                            elif value != bg:
+                                valid = False
+                                break
+                        if not valid:
+                            break
+                    if not valid:
+                        continue
+
+                    gap = boundary - rel_set
+                    if not (2 <= len(gap) <= 5):
+                        continue
+                    if not _connected(gap):
+                        continue
+
+                    gap_mask = np.zeros((h, w), dtype=bool)
+                    for rr, cc in gap:
+                        gap_mask[rr, cc] = True
+                    score = (h * w, len(gap))
+                    if best_score is None or score > best_score:
+                        best_score = score
+                        best = {
+                            "color": color,
+                            "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                            "gap_mask": gap_mask,
+                            "gap_shape": _normalize_mask(gap_mask),
+                        }
+
+    return best
+
+
+def _solve_assignment(pieces: list[dict], frames: list[dict]) -> list[int]:
+    candidates: list[list[int]] = []
+    for piece in pieces:
+        opts = []
+        for fi, frame in enumerate(frames):
+            if _same_shape_up_to_rotation(piece["shape"], frame["gap_shape"]):
+                opts.append(fi)
+        assert opts, "each piece must match at least one frame"
+        candidates.append(opts)
+
+    order = sorted(range(len(pieces)), key=lambda i: (len(candidates[i]), pieces[i]["area"]))
+    assignment = [-1] * len(pieces)
+    used: set[int] = set()
+
+    def dfs(pos: int) -> bool:
+        if pos == len(order):
+            return True
+        pi = order[pos]
+        for fi in candidates[pi]:
+            if fi in used:
+                continue
+            used.add(fi)
+            assignment[pi] = fi
+            if dfs(pos + 1):
+                return True
+            assignment[pi] = -1
+            used.remove(fi)
+        return False
+
+    assert dfs(0), "piece-frame matching must be unique and solvable"
+    return assignment
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    bg = _background_color(g)
+    comps = _components(g, bg)
+
+    frames: list[dict] = []
+    pieces: list[dict] = []
+    for comp in comps:
+        frame = _analyze_frame(comp, g, bg)
+        if frame is not None:
+            frames.append(frame)
+        else:
+            pieces.append(
+                {
+                    "color": int(comp["color"]),
+                    "coords": comp["coords"],
+                    "shape": _normalize_mask(comp["mask"]),
+                    "area": int(comp["area"]),
+                }
+            )
+
+    assert frames, "at least one frame is required"
+    assert len(frames) == len(pieces), "frames and pieces must pair one-to-one"
+
+    assignment = _solve_assignment(pieces, frames)
+    out = g.copy()
+
+    for piece in pieces:
+        for r, c in piece["coords"]:
+            out[r, c] = bg
+
+    for piece, frame_index in zip(pieces, assignment):
+        frame = frames[frame_index]
+        r0, c0, r1, c1 = frame["bbox"]
+        gap_mask = frame["gap_mask"]
+        for rr, cc in np.argwhere(gap_mask):
+            out[r0 + int(rr), c0 + int(cc)] = int(frame["color"])
+        out[r0 + 1 : r1, c0 + 1 : c1] = int(piece["color"])
+
+    return out
+
+
+SHAPE_SPECS = [
+    {"name": "line2", "kind": "line", "length": 2},
+    {"name": "line3", "kind": "line", "length": 3},
+    {"name": "line4", "kind": "line", "length": 4},
+    {"name": "line5", "kind": "line", "length": 5},
+    {"name": "corner3", "kind": "corner", "arms": (2, 2)},
+    {"name": "corner4", "kind": "corner", "arms": (2, 3)},
+    {"name": "corner5a", "kind": "corner", "arms": (2, 4)},
+    {"name": "corner5b", "kind": "corner", "arms": (3, 3)},
+]
+
+GRID_MIN = 18
+GRID_MAX = 30
+FRAME_SIDE_MIN = 4
+FRAME_SIDE_MAX = 8
+FRAME_PAD = 2
+PIECE_PAD = 1
+OUTER_ATTEMPTS = 400
+
+
+def _full_border_mask(h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _sample_gap_mask(spec: dict, h: int, w: int, rng: random.Random) -> np.ndarray | None:
+    gap = np.zeros((h, w), dtype=bool)
+    if spec["kind"] == "line":
+        length = int(spec["length"])
+        options = []
+        if w >= length:
+            options.extend(["top", "bottom"])
+        if h >= length:
+            options.extend(["left", "right"])
+        if not options:
+            return None
+        side = rng.choice(options)
+        if side == "top":
+            start = rng.randint(0, w - length)
+            gap[0, start : start + length] = True
+        elif side == "bottom":
+            start = rng.randint(0, w - length)
+            gap[h - 1, start : start + length] = True
+        elif side == "left":
+            start = rng.randint(0, h - length)
+            gap[start : start + length, 0] = True
+        else:
+            start = rng.randint(0, h - length)
+            gap[start : start + length, w - 1] = True
+        return gap
+
+    arm_a, arm_b = spec["arms"]
+    if rng.random() < 0.5:
+        horiz, vert = int(arm_a), int(arm_b)
+    else:
+        horiz, vert = int(arm_b), int(arm_a)
+    if w < horiz or h < vert:
+        return None
+
+    corner = rng.choice(["tl", "tr", "bl", "br"])
+    if corner == "tl":
+        gap[0, :horiz] = True
+        gap[:vert, 0] = True
+    elif corner == "tr":
+        gap[0, w - horiz : w] = True
+        gap[:vert, w - 1] = True
+    elif corner == "bl":
+        gap[h - 1, :horiz] = True
+        gap[h - vert : h, 0] = True
+    else:
+        gap[h - 1, w - horiz : w] = True
+        gap[h - vert : h, w - 1] = True
+    return gap
