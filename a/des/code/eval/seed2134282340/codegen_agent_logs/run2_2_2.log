+        out[ftop + 1 : ftop + fh - 1, fleft + 1 : fleft + fw - 1] = piece_color
+    return out
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    num_pairs = rng.choice([2, 3, 4])
+    shape_specs = rng.sample(SHAPE_SPECS, num_pairs)
