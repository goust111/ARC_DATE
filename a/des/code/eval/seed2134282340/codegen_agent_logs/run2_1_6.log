+                if portal is not None:
+                    area = (r1 - r + 1) * (c1 - c0 + 1)
+                    if area > best_area:
+                        best = portal
+                        best_area = area
+            for r0 in range(0, r - 1):
+                portal = _portal_from_box(g, bg, (r0, c0, r, c1), (r, c))
+                if portal is not None:
+                    area = (r - r0 + 1) * (c1 - c0 + 1)
+                    if area > best_area:
