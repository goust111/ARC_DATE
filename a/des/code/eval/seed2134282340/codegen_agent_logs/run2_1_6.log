+        mask[choice] = True
+        cells.add(choice)
+    return mask
+
+
+def _random_pattern(height: int, width: int, steps: int, palette: tuple[int, ...]) -> np.ndarray:
+    area = height * width
+    min_fill = max(4, area // 3)
+    max_fill = min(area - 1, (2 * area) // 3 + 1)
+    assert min_fill <= max_fill
+
+    for _ in range(200):
