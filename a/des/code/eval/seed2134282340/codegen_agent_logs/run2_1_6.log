+                if portal is not None:
+                    area = (r1 - r0 + 1) * (c1 - c + 1)
+                    if area > best_area:
+                        best = portal
+                        best_area = area
+            for c0 in range(0, c - 1):
+                portal = _portal_from_box(g, bg, (r0, c0, r1, c), (r, c))
+                if portal is not None:
+                    area = (r1 - r0 + 1) * (c - c0 + 1)
+                    if area > best_area:
+                        best = portal
+                        best_area = area
