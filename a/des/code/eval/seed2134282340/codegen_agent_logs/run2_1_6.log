+        src = filled[0]
+        dst = empty[0]
+        steps = (SIDE_TO_IDX[dst["side"]] - SIDE_TO_IDX[src["side"]]) % 4
+        rotated = np.rot90(src["inner"], -steps)
+        assert rotated.shape == dst["inner"].shape, "rotated payload must fit the exit portal"
