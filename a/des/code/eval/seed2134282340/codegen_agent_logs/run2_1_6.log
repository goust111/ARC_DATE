+        for r, c in cells:
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                nr = r + dr
+                nc = c + dc
+                if 0 <= nr < height and 0 <= nc < width and not mask[nr, nc]:
+                    frontier.append((nr, nc))
+        if not frontier:
+            break
