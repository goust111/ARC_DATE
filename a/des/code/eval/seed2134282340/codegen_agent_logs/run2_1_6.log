+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+YELLOW = 4
+SIDE_ORDER = ("top", "right", "bottom", "left")
+SIDE_TO_IDX = {side: idx for idx, side in enumerate(SIDE_ORDER)}
