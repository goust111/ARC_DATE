+    r0, c0, r1, c1 = box
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    candidates: list[str] = []
+    if marker == (r0, c0 + w // 2):
+        candidates.append("top")
+    if marker == (r0 + h // 2, c1):
+        candidates.append("right")
+    if marker == (r1, c0 + w // 2):
+        candidates.append("bottom")
+    if marker == (r0 + h // 2, c0):
