+def _grow_connected_mask(height: int, width: int, target: int) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    start = (random.randrange(height), random.randrange(width))
+    mask[start] = True
+    cells = {start}
+    while len(cells) < target:
