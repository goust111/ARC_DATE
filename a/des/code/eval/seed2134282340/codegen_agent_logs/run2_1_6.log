+    r0, c0, r1, c1 = box
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return None
+
+    try:
+        side = _marker_side(marker, box)
+    except AssertionError:
+        return None
+
+    border_color: int | None = None
+    for r in range(r0, r1 + 1):
