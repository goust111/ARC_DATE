+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+WALL_FRACTION = 0.6
+SEED_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+ROOM_COUNT_RANGE = (2, 4)
+ROOM_SIZE_RANGE = (2, 6)
