+
+def _sample_sizes(count: int) -> list[int]:
+    lo, hi = ROOM_SIZE_RANGE
+    return [random.randint(lo, hi) for _ in range(int(count))]
+
+
+def _wall_positions(sizes: list[int]) -> list[int]:
