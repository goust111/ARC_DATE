+
+        top_row = min(r for r, _c in region)
+        anchor_r, anchor_c = min(region)
+
+        for r, c in region:
+            if len(seeds) == 1:
+                out[r, c] = fill_color
+            elif len(seeds) == 2:
+                out[r, c] = fill_color if (r - top_row) % 2 == 0 else BLACK
+            else:
