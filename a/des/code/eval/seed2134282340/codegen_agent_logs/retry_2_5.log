+    "right": {(-1, 1), (0, -1), (0, 0), (0, 1), (1, 1)},
+    "up": {(-1, -1), (-1, 0), (-1, 1), (0, 0), (1, 0)},
+    "left": {(-1, -1), (0, -1), (0, 0), (0, 1), (1, -1)},
