+
+def _endpoint_side_nodes(nr: int, nc: int) -> dict[str, list[tuple[int, int]]]:
+    return {
+        "top": [(0, c) for c in range(1, nc - 1)],
+        "bottom": [(nr - 1, c) for c in range(1, nc - 1)],
+        "left": [(r, 0) for r in range(1, nr - 1)],
+        "right": [(r, nc - 1) for r in range(1, nr - 1)],
