    end: tuple[int, int],
    nr: int,
    nc: int,
    min_len: int,
    rng: random.Random,
) -> list[tuple[int, int]] | None:
    path = [start]
    seen = {start}

    def dfs(cur: tuple[int, int]) -> bool:
        if cur == end:
            return len(path) >= min_len

