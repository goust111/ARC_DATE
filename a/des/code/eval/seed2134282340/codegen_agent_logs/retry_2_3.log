+GEN_H_RANGE = (17, 27)
+GEN_W_RANGE = (17, 27)
+GEN_BRANCH_COUNT_CHOICES = [3, 4]
+GEN_BRANCH_LEN_RANGE = (1, 3)
+GEN_MAX_ATTEMPTS = 500
