+        side_branch = False
+        for odr, odc in ((dc, dr), (-dc, -dr)):
+            nr, nc = r + odr, c + odc
+            if _in_bounds((h, w), nr, nc) and _is_path_value(int(grid[nr, nc])):
+                side_branch = True
+                break
+        if side_branch:
+            break
+
+        removed.append((r, c))
+        nr, nc = r + dr, c + dc
+        if not (_in_bounds((h, w), nr, nc) and _is_path_value(int(grid[nr, nc]))):
