+def _lattice_neighbors(node: tuple[int, int], nr: int, nc: int) -> list[tuple[int, int]]:
+    r, c = node
+    out = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < nr:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < nc:
+        out.append((r, c + 1))
+    return out
