+    root_colors = [RED, BLUE, GREEN]
+    rng.shuffle(root_colors)
+    while len(root_colors) < len(roots):
+        root_colors.append(rng.choice([RED, BLUE, GREEN]))
+    signals = {node: color for node, color in zip(roots, root_colors)}
