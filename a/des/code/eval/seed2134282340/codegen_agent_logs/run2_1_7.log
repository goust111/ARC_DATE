+    out = g.copy()
+    used_piers: set[tuple[int, int]] = set()
+    for color, a, b in sorted(pair_items, key=lambda item: item[0]):
+        pier, path = _solve_pair(g, river_mask, bank_labels, piers, used_piers, a, b, bg)
+        used_piers.add(pier)
+        for cell in path:
