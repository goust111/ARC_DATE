+        return None
+
+    predicted = main(inp)
+    if not np.array_equal(predicted, out):
+        return None
+    if np.array_equal(inp, out):
+        return None
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        result = _build_scene()
+        if result is not None:
