+def _detect_frames(grid: np.ndarray, bg: int) -> list[dict]:
+    frames: list[dict] = []
+    colors = [int(c) for c in np.unique(grid) if int(c) != bg]
+    for color in colors:
+        for comp in _components(grid == color):
+            r0, c0, r1, c1 = _bbox(comp)
+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            if h < 5 or w < 5:
+                continue
+            comp_set = set(comp)
+            if any(r not in (r0, r1) and c not in (c0, c1) for r, c in comp_set):
+                continue
+            border = _perimeter_cells(r0, c0, r1, c1)
+            if len(comp_set) != len(border) - 1:
+                continue
+            missing = list(border - comp_set)
+            if len(missing) != 1:
+                continue
+            mr, mc = missing[0]
+            if (mr in (r0, r1)) and (mc in (c0, c1)):
+                continue
+            if mr == r0:
+                side = "top"
+                gap_index = mc - c0
+            elif mr == r1:
+                side = "bottom"
+                gap_index = mc - c0
+            elif mc == c0:
+                side = "left"
+                gap_index = mr - r0
+            else:
+                side = "right"
+                gap_index = mr - r0
+            frames.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "gap_side": side,
+                    "gap_index": gap_index,
