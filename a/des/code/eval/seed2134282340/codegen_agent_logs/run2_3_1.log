+from __future__ import annotations
+
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+BG = 0
+GEN_ATTEMPTS = 500
+GRID_H_RANGE = (20, 31)
+GRID_W_RANGE = (20, 31)
+FRAME_COUNT_RANGE = (1, 4)
+FRAME_H_RANGE = (7, 12)
+FRAME_W_RANGE = (7, 12)
+LEGEND_MAX_RANGE = (4, 8)
+PLACEMENT_PADDING = 2
+PLACEMENT_TRIES = 120
+
+
+@dataclass
+class _FrameSpec:
+    top: int
+    left: int
+    height: int
+    width: int
+    color: int
+    gap_side: str
+    gap_index: int
+    pattern_mask: np.ndarray
+    fill_color: int
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            stack = [(r, c)]
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    vals, cnts = np.unique(grid, return_counts=True)
+    return int(vals[int(np.argmax(cnts))])
+
+
+def _perimeter_cells(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    pts = set()
+    for c in range(c0, c1 + 1):
+        pts.add((r0, c))
+        pts.add((r1, c))
+    for r in range(r0, r1 + 1):
+        pts.add((r, c0))
+        pts.add((r, c1))
+    return pts
+
+
+def _detect_frames(grid: np.ndarray, bg: int) -> list[dict]:
+    frames: list[dict] = []
+    colors = [int(c) for c in np.unique(grid) if int(c) != bg]
+    for color in colors:
+        for comp in _components(grid == color):
+            r0, c0, r1, c1 = _bbox(comp)
+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            if h < 5 or w < 5:
+                continue
+            comp_set = set(comp)
+            if any(r not in (r0, r1) and c not in (c0, c1) for r, c in comp_set):
+                continue
+            border = _perimeter_cells(r0, c0, r1, c1)
+            if len(comp_set) != len(border) - 1:
+                continue
+            missing = list(border - comp_set)
+            if len(missing) != 1:
+                continue
+            mr, mc = missing[0]
+            if (mr in (r0, r1)) and (mc in (c0, c1)):
+                continue
+            if mr == r0:
+                side = "top"
+                gap_index = mc - c0
+            elif mr == r1:
+                side = "bottom"
+                gap_index = mc - c0
+            elif mc == c0:
+                side = "left"
+                gap_index = mr - r0
+            else:
+                side = "right"
+                gap_index = mr - r0
+            frames.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "gap_side": side,
+                    "gap_index": gap_index,
+                }
+            )
+    frames.sort(key=lambda item: (item["bbox"][0], item["bbox"][1]))
+    return frames
+
+
+def _legend_mapping(grid: np.ndarray, bg: int, frames: list[dict]) -> dict[int, int]:
+    residual = grid.copy()
+    for frame in frames:
+        r0, c0, r1, c1 = frame["bbox"]
+        residual[r0 : r1 + 1, c0 : c1 + 1] = bg
+
+    mapping: dict[int, int] = {}
+    for color in [int(c) for c in np.unique(residual) if int(c) != bg]:
+        for comp in _components(residual == color):
+            r0, c0, r1, c1 = _bbox(comp)
+            if r0 != r1:
+                continue
+            length = c1 - c0 + 1
+            if len(comp) != length:
+                continue
+            mapping[length] = color
+    return mapping
+
+
+def _project_mask(mask: np.ndarray, gap_side: str) -> np.ndarray:
+    h, w = mask.shape
+    proj = np.zeros((h, w), dtype=bool)
+    if gap_side in ("top", "bottom"):
+        counts = mask.sum(axis=0)
+        for c, count in enumerate(counts):
+            count = int(count)
+            if count == 0:
+                continue
+            if gap_side == "top":
+                proj[h - count :, c] = True
+            else:
+                proj[:count, c] = True
+    else:
+        counts = mask.sum(axis=1)
+        for r, count in enumerate(counts):
+            count = int(count)
+            if count == 0:
+                continue
+            if gap_side == "left":
+                proj[r, w - count :] = True
+            else:
+                proj[r, :count] = True
+    return proj
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    bg = _bg_color(g)
+    frames = _detect_frames(g, bg)
+    assert frames, "expected at least one gapped rectangular frame"
+    legend = _legend_mapping(g, bg, frames)
+    assert legend, "expected legend bars outside frames"
+
+    out = g.copy()
+    for frame in frames:
+        r0, c0, r1, c1 = frame["bbox"]
+        frame_color = int(frame["color"])
+        interior = g[r0 + 1 : r1, c0 + 1 : c1]
+        pattern = (interior != bg) & (interior != frame_color)
+        pixels = int(pattern.sum())
+        assert pixels > 0, "each frame must contain a non-empty inner pattern"
+        assert pixels in legend, "missing legend entry for pattern area"
