+def _legend_mapping(grid: np.ndarray, bg: int, frames: list[dict]) -> dict[int, int]:
+    residual = grid.copy()
+    for frame in frames:
+        r0, c0, r1, c1 = frame["bbox"]
+        residual[r0 : r1 + 1, c0 : c1 + 1] = bg
