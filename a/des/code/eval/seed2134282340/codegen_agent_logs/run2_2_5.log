            if backtrack(remaining):
                return board
            _apply(board, anchor_place, -1)
        return None

    # No anchor: just pack all pieces.
    def backtrack(rem: list[int]) -> bool:
        if not rem:
            return True
        best_pi = None
        best_options = None
        best_count = None
        for pi in rem:
            opts = []
            for var in piece_vars[pi]:
