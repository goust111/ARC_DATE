+        owner = _build_pair_owner(rng)
+        if owner is None:
+            return None
+        color_a, color_b, mix = map(int, colors[3 * pair_idx : 3 * pair_idx + 3])
+        patch_a = _make_piece_patch(owner == 1, color_a)
+        patch_b = _make_piece_patch(owner == 2, color_b)
+        pair_specs.append(
