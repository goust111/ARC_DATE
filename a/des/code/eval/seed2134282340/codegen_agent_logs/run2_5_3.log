+
+def _build_pair_owner(rng: np.random.Generator) -> np.ndarray | None:
+    orient = "v" if int(rng.integers(2)) == 0 else "h"
+    height = int(rng.integers(3, 7))
+    width = int(rng.integers(4, 8))
