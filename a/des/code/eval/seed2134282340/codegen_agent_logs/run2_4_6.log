+def _is_marker_column(col: np.ndarray) -> bool:
+    values = {int(v) for v in np.unique(col)}
+    if not values <= {BLACK, GREY} or GREY not in values:
+        return False
+    return bool(np.all(col[1:] != col[:-1]))
