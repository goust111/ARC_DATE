+            boundary_top = H - h
+            near_top = axis_hi + 2
+        if min_top > max_top:
+            return []
+        if role == "boundary":
+            tops = [boundary_top]
+        elif role == "near":
+            tops = [near_top]
+        else:
+            tops = list(range(min_top, max_top + 1))
+        positions = [(top, left) for top in tops for left in range(W - w + 1)]
