+import random
+
+import numpy as np
+
+
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+MAGENTA = 6
+ORANGE = 7
+MAROON = 9
+
+REFLECTION_COLORS = {
+    YELLOW: ORANGE,
+    ORANGE: RED,
+    RED: MAROON,
+    MAGENTA: MAROON,
