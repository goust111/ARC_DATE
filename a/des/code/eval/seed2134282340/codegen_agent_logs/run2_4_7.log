+def _find_river(grid: np.ndarray) -> tuple[str, int, int]:
+    blue = grid == BLUE
+    assert np.any(blue), "expected a blue river"
+
+    rows = np.flatnonzero(blue.any(axis=1))
+    cols = np.flatnonzero(blue.any(axis=0))
