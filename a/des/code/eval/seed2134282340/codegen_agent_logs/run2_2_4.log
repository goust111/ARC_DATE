+) -> np.ndarray:
+    canvas = np.full(shape, BG, dtype=int)
+    for color, (r0, c0, r1, c1) in zip(colors, boxes, strict=False):
+        canvas[r0 : r1 + 1, c0 : c1 + 1] = int(color)
+    return canvas
+
