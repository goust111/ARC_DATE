+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 8
+GREY = 5
+AXIS_COLOR_POOL = [0, 1, 2, 3, 4, 6, 7, 9]
+MIN_STRIP = 2
+MIN_GRID = 16
+MAX_GRID = 30
+MAX_GENERATION_ATTEMPTS = 400
