+def _interleave_axes(h_rows: list[int], v_cols: list[int], colors: list[int]) -> list[tuple[int, str, int]]:
+    h_queue = list(zip(colors[: len(h_rows)], ["h"] * len(h_rows), h_rows))
+    v_queue = list(zip(colors[len(h_rows) :], ["v"] * len(v_cols), v_cols))
