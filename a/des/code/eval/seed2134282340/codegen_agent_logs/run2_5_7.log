+            overlap = min(int(src["c1"]), int(open_c1)) - max(int(src["c0"]), int(open_c0)) + 1
+            if overlap > 0 and int(src["row"]) < int(container["top_row"]):
+                matches += 1
+        if matches != 1:
+            return None
+
+    expected = _expected_output(grid, placed_specs)
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
