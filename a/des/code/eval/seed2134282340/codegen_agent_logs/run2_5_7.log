+    if not ordered:
+        return []
+    runs: list[tuple[int, int]] = []
+    start = ordered[0]
+    prev = ordered[0]
+    for col in ordered[1:]:
+        if col == prev + 1:
+            prev = col
+            continue
+        runs.append((start, prev))
+        start = prev = col
+    runs.append((start, prev))
+    return runs
