+        runs = _row_runs(by_row[r])
+        if len(runs) < 2:
+            continue
+        left_wall = runs[0][1]
+        right_wall = runs[-1][0]
+        if right_wall - left_wall <= 1:
+            continue
+        interior_rows.append((int(r), int(left_wall + 1), int(right_wall - 1)))
+
