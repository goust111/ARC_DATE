+        _, color = hit
+        r0, c0, r1, c1 = frame["bbox"]
+        inner = out[r0 + 1 : r1, c0 + 1 : c1]
+        inner[inner == BLACK] = color
+    return out
+
+
+def _sample_scene() -> np.ndarray | None:
+    h = random.randint(*GRID_H_RANGE)
+    w = random.randint(*GRID_W_RANGE)
+    scene = {
