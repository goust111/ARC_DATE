+        protected = {OPPOSITE[d] for d in ray_dirs}
+        receiver = _build_frame(next_id, bbox, "receiver", _random_receiver_gaps(bbox, protected))
+        next_id += 1
+        _mark_bbox(local_occupied, receiver["bbox"])
+        local_frames.append(receiver)
