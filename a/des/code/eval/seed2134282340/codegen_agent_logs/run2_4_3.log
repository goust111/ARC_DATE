+) -> tuple[dict, dict] | None:
+    h, w = occupied.shape
+    rr0, rc0, rr1, rc1 = receiver["bbox"]
+
+    for _ in range(PLACEMENT_RETRIES):
+        if ray_dir in ("left", "right"):
