+    h, w = shape
+    dr, dc = DIRS[gap_side]
+    strip = _ray_start_strip(bbox, gap_side, gap)
+    path: list[tuple[int, int]] = []
+    while strip and all(0 <= r < h and 0 <= c < w for r, c in strip):
+        path.extend(strip)
+        strip = [(r + dr, c + dc) for r, c in strip]
+    return path
+
+
+def _place_stray_emitter(scene: dict) -> bool:
