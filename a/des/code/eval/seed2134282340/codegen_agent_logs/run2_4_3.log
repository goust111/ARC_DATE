+            color = random.choice(choices)
+            placed = _place_emitter_toward_receiver(local_occupied, receiver, ray_dir, color, next_id, space)
+            if placed is None:
+                ok = False
+                break
+            emitter, ray = placed
+            next_id += 1
+            local_colors.add(int(color))
+            _mark_bbox(local_occupied, emitter["bbox"])
