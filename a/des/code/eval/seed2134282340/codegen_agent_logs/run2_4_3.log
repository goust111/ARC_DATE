+
+BLACK = 0
+GRAY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
