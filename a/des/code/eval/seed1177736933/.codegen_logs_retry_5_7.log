+        if exposed:
+            boundary.add((r, c))
+    return {
+        "cells": placed,
+        "boundary": boundary,
+        "perimeter": perimeter,
+        "touch_count": len(touch_sides),
+        "touches_border": bool(touch_sides),
+    }
+
