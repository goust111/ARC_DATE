+        shape = _normalize(cells)
+        h, w = _shape_dims(shape)
+        if h <= 6 and w <= 6:
+            return shape
+    return _rectangle_shape()
+
+
+def _make_shape() -> set[tuple[int, int]]:
+    family = random.choice(SHAPE_FAMILIES)
+    if family == "rectangle":
+        shape = _rectangle_shape()
+    elif family == "l_shape":
+        shape = _l_shape()
+    elif family == "t_shape":
+        shape = _t_shape()
+    elif family == "notch":
