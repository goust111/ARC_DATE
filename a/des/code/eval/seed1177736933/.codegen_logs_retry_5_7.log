+    comp_set = {(int(r), int(c)) for r, c in comp}
+    boundary: set[tuple[int, int]] = set()
+    perimeter = 0
+    for r, c in comp_set:
+        exposed = False
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and int(grid[nr, nc]) == BG:
+                perimeter += 1
+                exposed = True
+        if exposed:
+            boundary.add((r, c))
