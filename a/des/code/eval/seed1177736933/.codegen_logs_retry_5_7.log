+def _buffered_cells(cells: set[tuple[int, int]], h: int, w: int, pad: int = 2) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for dr in range(-pad, pad + 1):
+            for dc in range(-pad, pad + 1):
