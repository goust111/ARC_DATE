+def _extract_layers(grid: np.ndarray, bg: int, marker_cells: list[tuple[int, int]]) -> dict[int, dict[str, np.ndarray | tuple[int, int, int, int]]]:
+    work = np.array(grid, dtype=int, copy=True)
+    for r, c in marker_cells:
+        work[r, c] = bg
