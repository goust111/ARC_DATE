+def _layer_order(layers: dict[int, dict[str, np.ndarray | tuple[int, int, int, int]]]) -> list[int]:
+    colors = list(layers)
+    edges = {color: set() for color in colors}
+    indeg = {color: 0 for color in colors}
+
+    for upper in colors:
+        coords = np.asarray(layers[upper]["coords"], dtype=int)
