+    if sep_col + 2 >= MAX_GRID_W:
+        return None
+
+    staff_top = int(_RNG.choice(TOP_MARGIN_OPTIONS))
+    staff_spacing = int(_RNG.choice(STAFF_SPACING_OPTIONS))
