+def _is_connected(mask: np.ndarray) -> bool:
+    cells = np.argwhere(mask)
+    if cells.size == 0:
+        return False
+    start = tuple(map(int, cells[0]))
+    seen = {start}
+    stack = [start]
+    h, w = mask.shape
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in _DIRS4:
+            rr = r + dr
+            cc = c + dc
+            nxt = (rr, cc)
+            if 0 <= rr < h and 0 <= cc < w and bool(mask[rr, cc]) and nxt not in seen:
+                seen.add(nxt)
+                stack.append(nxt)
+    return len(seen) == int(mask.sum())
