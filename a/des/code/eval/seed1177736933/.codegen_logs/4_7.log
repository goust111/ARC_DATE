+        stage[r0 : r0 + h, c0 : c0 + w] = patch
+    return stage
+
+
+def _parse_instance(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0
