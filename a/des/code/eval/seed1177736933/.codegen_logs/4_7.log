+def _is_asymmetric(mask: np.ndarray) -> bool:
+    for k in range(1, 4):
+        if np.array_equal(mask, np.rot90(mask, k)):
+            return False
+    for k in range(4):
+        if np.array_equal(mask, np.fliplr(np.rot90(mask, k))):
+            return False
+        if np.array_equal(mask, np.flipud(np.rot90(mask, k))):
