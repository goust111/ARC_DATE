+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+PALETTE = tuple(range(1, 10))
+BACKGROUND = 0
+RECT_COUNT_RANGE = (3, 5)
+CENTER_SIDE_MAX = 4
+OUTER_SIDE_MAX = 6
+SCENE_HEIGHT_RANGE = (9, 18)
+GRID_WIDTH_RANGE = (14, 26)
+TRAILING_MARKER_BLANKS = (1, 4)
+MAX_OUTPUT_SIDE = 30
