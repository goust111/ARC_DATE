+    frozenset({(0, 1), (1, 1), (2, 1), (2, 0), (2, 2)}): "down",
+    frozenset({(1, 0), (1, 1), (1, 2), (0, 0), (2, 0)}): "left",
+    frozenset({(1, 0), (1, 1), (1, 2), (0, 2), (2, 2)}): "right",
