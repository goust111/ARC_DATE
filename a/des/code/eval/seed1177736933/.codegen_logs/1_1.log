+
+def _bg_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == bg:
+                continue
+            color = int(g[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            coords = np.array(cells, dtype=int)
+            r0 = int(coords[:, 0].min())
+            c0 = int(coords[:, 1].min())
+            r1 = int(coords[:, 0].max())
+            c1 = int(coords[:, 1].max())
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "area": int(len(cells)),
+                }
+            )
+    return comps
+
+
+def _arrow_direction(coords: np.ndarray) -> str | None:
+    if len(coords) != 5:
+        return None
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    if r1 - r0 != 2 or c1 - c0 != 2:
+        return None
+    norm = frozenset((int(r - r0), int(c - c0)) for r, c in coords)
+    return ARROW_TEMPLATES.get(norm)
+
+
+def _boundary_coords(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    out = [(r0, c) for c in range(c0, c1 + 1)]
+    out.extend((r, c1) for r in range(r0 + 1, r1))
+    out.extend((r1, c) for c in range(c1, c0 - 1, -1))
+    out.extend((r, c0) for r in range(r1 - 1, r0, -1))
+    return out
+
+
+def _edge_coords(r0: int, c0: int, r1: int, c1: int, direction: str) -> list[tuple[int, int]]:
+    if direction == "up":
+        return [(r0, c) for c in range(c0, c1 + 1)]
+    if direction == "down":
+        return [(r1, c) for c in range(c0, c1 + 1)]
+    if direction == "left":
