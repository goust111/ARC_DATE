+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+ARROW_TEMPLATES = {
+    frozenset({(0, 1), (0, 0), (0, 2), (1, 1), (2, 1)}): "up",
+    frozenset({(0, 1), (1, 1), (2, 1), (2, 0), (2, 2)}): "down",
+    frozenset({(1, 0), (1, 1), (1, 2), (0, 0), (2, 0)}): "left",
+    frozenset({(1, 0), (1, 1), (1, 2), (0, 2), (2, 2)}): "right",
+}
+STEP_BY_DIR = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
