+DIR8 = DIR4 + [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+
+_RNG = np.random.default_rng()
+GEN_RETRIES = 300
+PATCH_RETRIES = 120
+MIN_ROOM_SIZE = 2
