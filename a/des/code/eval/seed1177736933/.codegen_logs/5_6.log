+
+def _build_partition(rng: np.random.Generator, inner_h: int, inner_w: int, chambers: int) -> np.ndarray | None:
+    inner = np.zeros((inner_h, inner_w), dtype=int)
+    rooms = [(0, 0, inner_h - 1, inner_w - 1)]
+
