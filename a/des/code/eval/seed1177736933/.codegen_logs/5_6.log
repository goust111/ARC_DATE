+
+
+def _paste(dst: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    h, w = patch.shape
+    dst[top : top + h, left : left + w] = patch
+
+
+def _validate_scene(grid: np.ndarray, expected_chambers: dict[int, int]) -> bool:
+    try:
