+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    blacks = _components(patch == BLACK)
+    h, w = patch.shape
+    count = 0
+    for comp in blacks:
+        if (
+            np.any(comp[:, 0] == 0)
+            or np.any(comp[:, 0] == h - 1)
+            or np.any(comp[:, 1] == 0)
+            or np.any(comp[:, 1] == w - 1)
