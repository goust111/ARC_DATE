+def _graph_components(n_nodes: int, edges: list[tuple[int, int]]) -> list[list[int]]:
+    adj = [set() for _ in range(n_nodes)]
+    for a, b in edges:
+        adj[int(a)].add(int(b))
+        adj[int(b)].add(int(a))
+
+    seen: set[int] = set()
+    comps: list[list[int]] = []
+    for start in range(n_nodes):
+        if start in seen:
+            continue
+        stack = [start]
+        seen.add(start)
+        comp: list[int] = []
+        while stack:
+            node = stack.pop()
+            comp.append(int(node))
+            for nxt in adj[node]:
+                if nxt not in seen:
+                    seen.add(int(nxt))
+                    stack.append(int(nxt))
+        comps.append(comp)
+    return comps
