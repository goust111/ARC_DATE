+        return None
+
+    local_path = _random_induced_path(frame_h - 2, frame_w - 2, rng)
+    colors = _path_colors(len(local_path), rng)
+    directions = [(b[0] - a[0], b[1] - a[1]) for a, b in zip(local_path, local_path[1:])]
