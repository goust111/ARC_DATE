+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+AZURE = 8
+BROWN = 9
+
+PATH_BODY_COLORS = (YELLOW, MAGENTA, AZURE, BROWN)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+FRAME_H_RANGE = (8, 16)
+FRAME_W_RANGE = (8, 14)
+GAP_RANGE = (1, 4)
+PATH_RETRY_LIMIT = 200
+GEN_RETRY_LIMIT = 400
