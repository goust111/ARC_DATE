+    pipe_axes: dict[tuple[int, int], set[str]] = {}
+    _add_horizontal(pipe_axes, trunk_row, sc1 + 1, fc0 - 1)
+
+    if local_side == "top":
+        lr0, lc0, lr1, lc1 = local_box
+        assert lc0 < local_attach < lc1
+        _add_vertical(pipe_axes, local_attach, lr1 + 1, trunk_row)
