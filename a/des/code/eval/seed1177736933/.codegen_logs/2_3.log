+def _boxes_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 0) -> bool:
+    return not (
+        a[2] + pad < b[0] - pad
+        or b[2] + pad < a[0] - pad
+        or a[3] + pad < b[1] - pad
+        or b[3] + pad < a[1] - pad
+    )
+
