+def _container_contacts(containers: list[dict[str, object]], pipe_mask: np.ndarray) -> list[list[tuple[int, int, int, int]]]:
+    h, w = pipe_mask.shape
+    contacts: list[list[tuple[int, int, int, int]]] = []
+    for obj in containers:
