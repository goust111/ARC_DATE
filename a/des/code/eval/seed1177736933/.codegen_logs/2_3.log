+                continue
+            other = int(container_of[nr, nc])
+            if other != -1:
+                if other not in reached:
+                    reached.add(other)
+                    seed(other)
+                continue
+            if not pipe_mask[nr, nc]:
+                continue
+            if (nr, nc) in valves and not _axis_allowed(int(g[nr, nc]), ndr, ndc):
