+def _reachable_containers(
+    grid: np.ndarray,
+    containers: list[dict[str, object]],
+    source_id: int,
+    container_of: np.ndarray,
+    pipe_mask: np.ndarray,
+    valves: set[tuple[int, int]],
+    contacts: list[list[tuple[int, int, int, int]]],
