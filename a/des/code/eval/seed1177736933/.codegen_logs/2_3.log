+            else:
+                ok = False
+
+            if not ok:
+                continue
+
+            for r in range(r0, r1 + 1):
+                for c in range(c0, c1 + 1):
+                    if marker is not None and (r, c) == marker:
+                        if int(g[r, c]) != YELLOW:
+                            ok = False
+                        continue
+                    if int(g[r, c]) != color:
