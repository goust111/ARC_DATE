+    valve_colors = {(trunk_row, col): color for col, color in zip(valve_cols, valve_palette, strict=True)}
+
+    for (r, c) in pipe_axes:
+        if grid[r, c] != BLACK:
+            return None
+    _render_pipes(grid, pipe_axes, valve_colors)
