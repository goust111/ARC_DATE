+
+    for color in map(int, np.unique(g)):
+        if color in (BLACK, YELLOW, GREY):
+            continue
+        for comp in _components(g == color):
+            r0, c0, r1, c1 = _bbox(comp)
+            hh = r1 - r0 + 1
+            ww = c1 - c0 + 1
+            area = int(comp.shape[0])
+            if hh < 3 or ww < 3:
+                continue
+
+            marker = None
+            if area == hh * ww:
+                ok = True
+            elif area == hh * ww - 1:
+                missing = []
+                for r in range(r0, r1 + 1):
+                    for c in range(c0, c1 + 1):
+                        if int(g[r, c]) != color:
+                            missing.append((r, c))
+                ok = len(missing) == 1
+                if ok:
