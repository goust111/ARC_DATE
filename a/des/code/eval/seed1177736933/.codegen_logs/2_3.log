+        seen: set[tuple[int, int, int, int]] = set()
+        for r in range(r0, r1 + 1):
+            for c in range(c0, c1 + 1):
+                for dr, dc in DIRS4:
+                    nr, nc = r + dr, c + dc
+                    if _inside((h, w), nr, nc) and pipe_mask[nr, nc]:
+                        seen.add((nr, nc, dr, dc))
+        contacts.append(sorted(seen))
+    return contacts
