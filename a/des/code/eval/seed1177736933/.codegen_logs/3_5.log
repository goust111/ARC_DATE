+def _gen_attempt() -> np.ndarray | None:
+    height = int(RNG.integers(*GEN_GRID_RANGE))
+    width = int(RNG.integers(*GEN_GRID_RANGE))
+    room_count = int(RNG.choice(GEN_ROOM_COUNT_CHOICES))
