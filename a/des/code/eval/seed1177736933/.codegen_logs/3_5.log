+    elif door == "W":
+        grid[top + 1 + inner_h // 2, left] = BG
+    elif door == "E":
+        grid[top + 1 + inner_h // 2, right] = BG
+    else:
+        raise AssertionError(f"unknown doorway side: {door}")
