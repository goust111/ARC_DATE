+    seed_count: int,
+) -> None:
+    outer_h = inner_h + 2
+    outer_w = inner_w + 2
+    bottom = top + outer_h - 1
+    right = left + outer_w - 1
+
+    grid[top, left : right + 1] = GEN_WALL
+    grid[bottom, left : right + 1] = GEN_WALL
+    grid[top : bottom + 1, left] = GEN_WALL
+    grid[top : bottom + 1, right] = GEN_WALL
+
+    if door == "N":
+        grid[top, left + 1 + inner_w // 2] = BG
+    elif door == "S":
