+        "gap": (int(gr), int(gc)),
+        "gap_dir": gap_dir,
+    }
+
+
+def _content_info(grid: np.ndarray, bg: int, frame: dict) -> dict:
+    r0, c0, r1, c1 = frame["bbox"]
+    inner = grid[r0 + 1 : r1, c0 + 1 : c1]
+    pts = np.argwhere(inner != bg)
