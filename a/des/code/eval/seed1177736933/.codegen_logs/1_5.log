+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Match each key to the same-colored lock, use the key opening to identify the
+    gap side, then release the hidden line through that gap.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
