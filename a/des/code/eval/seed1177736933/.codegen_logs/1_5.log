+import numpy as np
+
+
+DIRECTIONS = ("up", "right", "down", "left")
+OPPOSITE = {"up": "down", "down": "up", "left": "right", "right": "left"}
+KEY_MASKS = {
+    # The opening direction is an explicit convention shared by the solver and generator.
+    "up": np.array([[1, 1], [0, 1]], dtype=bool),
+    "right": np.array([[1, 1], [1, 0]], dtype=bool),
+    "down": np.array([[1, 0], [1, 1]], dtype=bool),
+    "left": np.array([[0, 1], [1, 1]], dtype=bool),
+}
+
+MIN_LOCKS = 2
+MAX_LOCKS = 4
+FRAME_H_RANGE = (5, 9)  # [lo, hi)
+FRAME_W_RANGE = (5, 10)  # [lo, hi)
+GRID_H_RANGE = (22, 33)  # [lo, hi)
+GRID_W_RANGE = (22, 33)  # [lo, hi)
+KEY_REACH = 4
+BASE_MARGIN = 3
+PLACEMENT_PAD = 1
+PATCH_ATTEMPTS = 60
+SCENE_ATTEMPTS = 400
+
+
+def get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for nr, nc in neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _monochrome_components(grid: np.ndarray, bg: int) -> list[dict]:
+    comps: list[dict] = []
+    for color in np.unique(grid):
+        color = int(color)
+        if color == bg:
+            continue
+        for coords in components_mask(grid == color):
+            bbox = bbox_coords(coords)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": [(int(r), int(c)) for r, c in coords],
+                    "bbox": bbox,
+                    "area": int(len(coords)),
+                }
+            )
+    return comps
+
+
+def _classify_key(comp: dict) -> dict | None:
+    if int(comp["area"]) != 3:
+        return None
+    r0, c0, r1, c1 = comp["bbox"]
+    if r1 - r0 + 1 != 2 or c1 - c0 + 1 != 2:
+        return None
+    mask = np.zeros((2, 2), dtype=bool)
+    for r, c in comp["coords"]:
+        mask[int(r) - r0, int(c) - c0] = True
+    opening = None
+    for direction, pattern in KEY_MASKS.items():
+        if np.array_equal(mask, pattern):
+            opening = direction
+            break
+    if opening is None:
+        return None
+    return {
+        "color": int(comp["color"]),
+        "coords": list(comp["coords"]),
+        "bbox": comp["bbox"],
+        "opening": opening,
+    }
+
+
+def _classify_frame(comp: dict) -> dict | None:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 4 or w < 4:
+        return None
+    coords = {(int(r), int(c)) for r, c in comp["coords"]}
+    border = set()
+    for c in range(c0, c1 + 1):
+        border.add((r0, c))
+        border.add((r1, c))
+    for r in range(r0, r1 + 1):
+        border.add((r, c0))
+        border.add((r, c1))
+    if coords - border:
+        return None
+    missing = sorted(border - coords)
+    if len(missing) != 1:
+        return None
+    gap = missing[0]
+    gr, gc = gap
+    if gr == r0 and c0 < gc < c1:
+        gap_dir = "up"
+    elif gr == r1 and c0 < gc < c1:
+        gap_dir = "down"
+    elif gc == c0 and r0 < gr < r1:
+        gap_dir = "left"
+    elif gc == c1 and r0 < gr < r1:
+        gap_dir = "right"
+    else:
+        return None
+    if len(coords) != len(border) - 1:
+        return None
+    return {
+        "color": int(comp["color"]),
+        "coords": list(comp["coords"]),
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "gap": (int(gr), int(gc)),
+        "gap_dir": gap_dir,
+    }
