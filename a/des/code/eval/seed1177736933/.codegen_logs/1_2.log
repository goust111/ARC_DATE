+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Overlay same-color fragment pairs inside the canvas-sized bbox and paint the
+    uncovered cells onto the solid grey canvas.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
