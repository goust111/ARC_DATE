+                continue
+            coords = comps[0]
+            h, w = _bbox_shape(coords)
+            if int(coords.shape[0]) == int(h * w):
+                canvas.append((int(color), h, w))
+        if len(canvas) != 1:
+            return False
+        canvas_color, canvas_h, canvas_w = canvas[0]
+
+        for color, comps in color_to_comps.items():
+            if int(color) == int(canvas_color):
