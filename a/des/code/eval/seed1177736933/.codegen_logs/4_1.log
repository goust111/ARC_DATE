+    gaps: list[dict] = []
+    for side, items in side_gaps.items():
+        if not items:
+            continue
+        if side in ("top", "bottom"):
+            gaps.append({"side": side, "coord": (r0 if side == "top" else r1, items[0])})
+        else:
