+    cc0 = max(0, c0 - pad)
+    rr1 = min(h - 1, r1 + pad)
+    cc1 = min(w - 1, c1 + pad)
+    return {(r, c) for r in range(rr0, rr1 + 1) for c in range(cc0, cc1 + 1)}
+
+
+def _sorted_sample(indices: list[int], count: int) -> list[int]:
