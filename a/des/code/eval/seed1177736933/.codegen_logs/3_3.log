+
+    hr0 = 1 + top_len
+    hr1 = hr0 + wh - 1
+    v1c0 = left_margin
+    v1c1 = v1c0 + wv1 - 1
+    v2c0 = v1c1 + 1 + bridge_len
+    v2c1 = v2c0 + wv2 - 1
