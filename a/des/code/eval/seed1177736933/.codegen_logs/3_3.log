+
+    def endpoint_from_side(seg: dict, side: str) -> int:
+        r0 = int(seg["r0"])
+        r1 = int(seg["r1"])
+        c0 = int(seg["c0"])
+        c1 = int(seg["c1"])
+        adjacent: list[tuple[int, int]] = []
+        if side == "left" and c0 > 0:
+            adjacent = [(r, c0 - 1) for r in range(r0, r1 + 1)]
