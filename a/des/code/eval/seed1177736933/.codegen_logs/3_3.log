+            v_hits[vi].append((int(ir0), int(ir1), int(node_id)))
+
+    def add_endpoint_node(kind: str, mask: list[tuple[int, int]] | None = None, color: int | None = None) -> int:
+        node_id = len(nodes)
+        nodes.append({"kind": kind, "mask": mask or [], "color": color})
