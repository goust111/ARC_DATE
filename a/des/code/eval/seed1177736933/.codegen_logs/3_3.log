+def _can_place_component(grid: np.ndarray, cells: set[tuple[int, int]]) -> bool:
+    h, w = grid.shape
+    for r, c in cells:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        if int(grid[r, c]) != BLACK:
