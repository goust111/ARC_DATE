+def _find_runs_1d(values: np.ndarray) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    n = int(values.size)
+    i = 0
+    while i < n:
+        if not bool(values[i]):
+            i += 1
+            continue
+        j = i
+        while j + 1 < n and bool(values[j + 1]):
+            j += 1
+        runs.append((int(i), int(j)))
+        i = j + 1
+    return runs
