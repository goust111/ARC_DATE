+def _paint_rect(grid: np.ndarray, r0: int, r1: int, c0: int, c1: int, color: int) -> None:
+    window = grid[r0 : r1 + 1, c0 : c1 + 1]
+    assert np.all((window == BLACK) | (window == color))
+    grid[r0 : r1 + 1, c0 : c1 + 1] = int(color)
