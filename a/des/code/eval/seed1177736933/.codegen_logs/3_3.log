+            cells = set(pipe) | {(r, c) for r, c, _ in points}
+            if not _can_place_component(grid, cells):
+                continue
+            for r, c in pipe:
+                grid[r, c] = GRAY
+            for r, c, val in points:
+                grid[r, c] = int(val)
