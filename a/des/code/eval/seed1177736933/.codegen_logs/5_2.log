+_RECT_MAX_SIDE = 7
+_GAP_RANGE = (1, 4)
+_SLOT_EXTRA_RANGE = (0, 3)
+_SLOT_GAP_RANGE = (1, 4)
+_MARGIN_RANGE = (1, 4)
+_BOTTOM_MARGIN_RANGE = (1, 3)
+_VERTICAL_GAP_RANGE = (2, 5)
