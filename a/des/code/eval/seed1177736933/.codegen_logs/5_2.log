+            continue
+
+        components = _connected_components(grid == slot_color)
+        if len(components) < 2:
+            continue
+
+        slots: list[dict[str, int]] = []
+        ok = True
+        for comp in components:
+            r0, c0, r1, c1 = _bbox(comp)
