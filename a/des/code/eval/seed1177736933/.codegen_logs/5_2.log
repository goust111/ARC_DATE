+        slots.sort(key=lambda slot: slot["c0"])
+        gaps = [slots[i + 1]["c0"] - slots[i]["c1"] - 1 for i in range(len(slots) - 1)]
+        if gaps and len(set(gaps)) != 1:
+            continue
+        if any(gap < 1 for gap in gaps):
