_PLACEMENT_PADDING = 1
_GROUP_PLACEMENT_TRIES = 250
_GENERATION_RETRIES = 400


def _distinct_compositions(total: int, parts: int) -> list[tuple[int, ...]]:
    out: list[tuple[int, ...]] = []

    def rec(remaining: int, need: int, used: set[int], prefix: list[int]) -> None:
        if need == 0:
