+        cc = int(c)
+        if seen[rr, cc]:
+            continue
+        stack = [(rr, cc)]
+        seen[rr, cc] = True
+        coords: list[tuple[int, int]] = []
+        while stack:
+            cr, cc = stack.pop()
+            coords.append((cr, cc))
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                nr = cr + dr
+                nc = cc + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
