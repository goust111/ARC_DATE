+import numpy as np
+
+
+_RNG = np.random.default_rng()
+_GEN_COUNTER = 0
+
+_BG = 0
+_GREY = 5
+_COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+_MAX_GENERATION_ATTEMPTS = 400
+
+_SOURCE_LINE_SIDES = ("top", "bottom", "left", "right")
+_ANCHOR_LINE_SIDES = ("top", "left")
