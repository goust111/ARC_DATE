+        if _shape_rotations_are_distinct(shape):
+            valid.append(shape)
+    assert valid
+    return valid
+
+
+_STAMP_LIBRARY = _valid_base_shapes()
+
+
+def _choose_stamp_specs(count: int) -> list[dict]:
+    global _GEN_COUNTER
