+
+
+def _find_workspace_frame(grid: np.ndarray, bg: int) -> dict:
+    candidates: list[dict] = []
+    for color in np.unique(grid):
+        color = int(color)
+        if color == bg:
+            continue
+        for coords in _components(grid == color):
+            if _is_rectangular_frame(coords):
+                r0, c0, r1, c1 = _bbox(coords)
+                candidates.append(
