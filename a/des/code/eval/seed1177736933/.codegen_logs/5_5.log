+def _paint_mask(out: np.ndarray, mask: np.ndarray, color: int, r0: int, c0: int) -> None:
+    h, w = mask.shape
+    assert 0 <= r0 <= out.shape[0] - h
+    assert 0 <= c0 <= out.shape[1] - w
+    window = out[r0 : r0 + h, c0 : c0 + w]
