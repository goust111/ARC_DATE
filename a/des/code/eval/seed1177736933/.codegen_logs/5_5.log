+    edge_col = 0 if side == "left" else w - 1
+    contacts = [r for r in range(h) if mask[r, edge_col]]
+    contact = int(contacts[int(_RNG.integers(len(contacts)))])
+    lo = contact - length + 1
+    hi = contact
