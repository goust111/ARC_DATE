+    _parse_shape(["1001", "1111"]),
+    _parse_shape(["111", "101", "101", "111"]),
+    _parse_shape(["1111", "1001", "1101", "1111"]),
+    _parse_shape(["1111", "1011", "1001", "1111"]),
