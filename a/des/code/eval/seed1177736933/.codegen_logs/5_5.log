+    r_lo = max(ir0 - min_line_r, ir0)
+    c_lo = max(ic0 - min_line_c, ic0)
+    r_hi = min(ir1 - max_line_r, ir1 - ph + 1)
+    c_hi = min(ic1 - max_line_c, ic1 - pw + 1)
+    if r_lo > r_hi or c_lo > c_hi:
+        return None
+
+    candidates = [
