+        start = int(_RNG.integers(-length + 1, w))
+        return [(row, start + i) for i in range(length)]
+    col = -1 if side == "left" else w
+    start = int(_RNG.integers(-length + 1, h))
+    return [(start + i, col) for i in range(length)]
