+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    expected = 2 * h + 2 * w - 4
+    if int(coords.shape[0]) != expected:
+        return False
+    pts = {(int(r), int(c)) for r, c in coords}
+    for r in range(r0, r1 + 1):
+        if (r, c0) not in pts or (r, c1) not in pts:
