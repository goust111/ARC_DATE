+    total_areas: list[int] = []
+    for cat, coverage in zip(categories, chosen_covs):
+        mask = _build_larger_stamp(frame_h, frame_w, coverage) if cat == "larger" else _build_smaller_stamp(frame_h, frame_w, coverage)
+        if mask is None:
