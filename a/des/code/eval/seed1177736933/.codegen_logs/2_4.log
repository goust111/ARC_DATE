+        sub = out[dst_r0 : dst_r0 + sh, dst_c0 : dst_c0 + sw]
+        if not np.array_equal(sub == int(item["color"]), mask):
+            return None
+
+    return grid, specs
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        result = _generate_case()
+        if result is not None:
