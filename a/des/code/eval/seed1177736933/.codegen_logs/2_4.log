+def _find_separator_structure(grid: np.ndarray, bg: int) -> tuple[int, int, list[int]]:
+    candidates: list[tuple[int, int, list[int], list[int]]] = []
+    for color in np.unique(grid):
+        color = int(color)
+        if color == bg:
