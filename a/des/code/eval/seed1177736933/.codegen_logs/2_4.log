+
+
+def _smaller_coverage_candidates(frame_h: int, frame_w: int) -> set[int]:
+    out: set[int] = set()
+    for h in range(1, frame_h + 1):
+        for w in range(1, frame_w + 1):
+            if h == frame_h and w == frame_w:
+                continue
+            out.update(range(h + w - 1, h * w + 1))
