+        dst_r0 = br0 + (row_h - sh) // 2
+        dst_c0 = sep_col + 1 + (right_w - sw) // 2
+        sub = out[dst_r0 : dst_r0 + sh, dst_c0 : dst_c0 + sw]
+        if not np.array_equal(sub == int(item["color"]), mask):
+            return None
