+    frame_comp: np.ndarray | None = None
+    stamp_comp: np.ndarray | None = None
+    stamp_color = -1
+
+    for comp in comps:
+        vals = np.unique(left_row[comp[:, 0], comp[:, 1]])
+        assert len(vals) == 1
+        color = int(vals[0])
+        if _is_rectangle_frame(comp):
+            assert frame_comp is None, "frame must be unique per row"
+            frame_comp = comp
+        else:
