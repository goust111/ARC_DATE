+
+def _row_bands(height: int, sep_rows: list[int]) -> list[tuple[int, int]]:
+    starts = [0] + [r + 1 for r in sep_rows]
+    ends = [r - 1 for r in sep_rows] + [height - 1]
+    return [(s, e) for s, e in zip(starts, ends) if s <= e]
