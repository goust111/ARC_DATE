+    r0, c0, r1, c1 = _bbox(coords)
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    wall = np.zeros(patch.shape, dtype=bool)
+    for r, c in coords:
+        wall[r - r0, c - c0] = True
