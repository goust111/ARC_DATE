+    H, W = blocked.shape
+    candidates: list[tuple[int, int]] = []
+    for r in range(1, H - h):
+        for c in range(1, W - w):
+            rr0 = max(0, r - pad)
+            cc0 = max(0, c - pad)
+            rr1 = min(H, r + h + pad)
