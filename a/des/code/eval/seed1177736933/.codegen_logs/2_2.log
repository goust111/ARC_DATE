+def _shape_to_mask(shape: tuple[tuple[int, int], ...]) -> np.ndarray:
+    rows = [r for r, _ in shape]
+    cols = [c for _, c in shape]
+    out = np.zeros((max(rows) + 1, max(cols) + 1), dtype=bool)
+    for r, c in shape:
