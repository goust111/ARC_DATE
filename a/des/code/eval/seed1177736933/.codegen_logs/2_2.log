+GRID_H_RANGE = (22, 30)
+GRID_W_RANGE = (22, 30)
+MOLD_COUNT_CHOICES = [1, 2, 3]
+FRAGMENT_COUNT_CHOICES = [1, 2, 3]
+INTERIOR_H_RANGE = (4, 7)
+INTERIOR_W_RANGE = (4, 7)
+COLOR_POOL = [0, 1, 2, 3, 4, 6, 7, 8, 9]
