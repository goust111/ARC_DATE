+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in NEIGH4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _bbox(coords: Iterable[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows, cols = zip(*coords)
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _trim(mask: np.ndarray) -> np.ndarray:
+    rows = np.any(mask, axis=1)
+    cols = np.any(mask, axis=0)
+    return mask[rows][:, cols]
+
+
+def _mask_to_shape(mask: np.ndarray) -> tuple[tuple[int, int], ...]:
+    coords = np.argwhere(mask)
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))
+
+
+def _shape_to_mask(shape: tuple[tuple[int, int], ...]) -> np.ndarray:
+    rows = [r for r, _ in shape]
+    cols = [c for _, c in shape]
+    out = np.zeros((max(rows) + 1, max(cols) + 1), dtype=bool)
+    for r, c in shape:
+        out[r, c] = True
+    return out
+
+
+def _mask_variants(mask: np.ndarray) -> list[np.ndarray]:
+    out: list[np.ndarray] = []
+    seen: set[tuple[bytes, tuple[int, int]]] = set()
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        for cand in (rot, np.fliplr(rot)):
+            trimmed = _trim(cand)
+            key = (trimmed.tobytes(), trimmed.shape)
+            if key in seen:
+                continue
+            seen.add(key)
+            out.append(trimmed)
+    return out
