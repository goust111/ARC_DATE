+    seen = np.zeros_like(passable, dtype=bool)
+    stack: list[tuple[int, int]] = []
+    ph, pw = passable.shape
+    for r in range(ph):
+        for c in (0, pw - 1):
+            if passable[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+    for c in range(pw):
+        for r in (0, ph - 1):
+            if passable[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
