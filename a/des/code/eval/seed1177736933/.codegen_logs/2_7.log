+
+    expected = _build_expected(grid, rooms, arrow_coords)
+    try:
+        if np.array_equal(main(grid), expected):
+            return grid
+    except Exception:
+        return None
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(300):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
