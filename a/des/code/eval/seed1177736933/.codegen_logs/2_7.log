+
+    if side == "left":
+        front_c = door_c - gap
+        row = door_r
+        cells.extend((row, front_c - k) for k in range(3))
+        cells.append((row + tip_sign, front_c))
+    elif side == "right":
+        front_c = door_c + gap
+        row = door_r
+        cells.extend((row, front_c + k) for k in range(3))
+        cells.append((row + tip_sign, front_c))
+    elif side == "top":
+        front_r = door_r - gap
+        col = door_c
+        cells.extend((front_r - k, col) for k in range(3))
+        cells.append((front_r, col + tip_sign))
+    else:
+        front_r = door_r + gap
+        col = door_c
+        cells.extend((front_r + k, col) for k in range(3))
+        cells.append((front_r, col + tip_sign))
