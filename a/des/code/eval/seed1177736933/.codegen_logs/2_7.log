+def _extract_furniture(grid: np.ndarray, room: dict, bg: int) -> dict:
+    r0, c0, r1, c1 = room["bbox"]
+    inner = grid[r0 + 1 : r1, c0 + 1 : c1]
+    mask = (inner != bg) & (inner != BLUE)
+    comps = _components(mask, connectivity=4)
