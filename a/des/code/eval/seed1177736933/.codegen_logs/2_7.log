+
+
+def _translated_coords(room: dict, furniture: dict, direction: tuple[int, int]) -> np.ndarray:
+    coords = furniture["coords"]
+    r0, c0, r1, c1 = room["bbox"]
+    dr, dc = direction
+
+    if (dr, dc) == (0, 1):
+        shift = (c1 - 1) - int(coords[:, 1].max())
+    elif (dr, dc) == (0, -1):
+        shift = (c0 + 1) - int(coords[:, 1].min())
+    elif (dr, dc) == (1, 0):
+        shift = (r1 - 1) - int(coords[:, 0].max())
+    else:
