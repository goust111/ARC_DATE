+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(18, 28)
+    w = random.randint(18, 28)
+    grid = np.full((h, w), BLACK, dtype=int)
+    room_count = random.randint(1, 3 if min(h, w) < 24 else 4)
+
