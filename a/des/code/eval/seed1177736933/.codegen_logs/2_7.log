        room["furniture"] = _extract_furniture(g, room, bg)

    arrows = _find_arrows(g, rooms)
    out = g.copy()
    used_rooms: set[int] = set()

    for arrow in arrows:
        coords = arrow["coords"]
        out[coords[:, 0], coords[:, 1]] = bg

