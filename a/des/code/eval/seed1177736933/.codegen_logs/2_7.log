+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+DIRS8 = DIRS4 + ((1, 1), (1, -1), (-1, 1), (-1, -1))
+PUSH_FROM_SIDE = {
+    "left": (0, 1),
+    "right": (0, -1),
+    "top": (1, 0),
+    "bottom": (-1, 0),
+}
+DOOR_SIDE_FROM_PUSH = {value: key for key, value in PUSH_FROM_SIDE.items()}
