+
+def _components(mask: np.ndarray, connectivity: int) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    steps = DIRS4 if connectivity == 4 else DIRS8
+    comps: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in steps:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _find_rooms(grid: np.ndarray) -> list[dict]:
+    rooms: list[dict] = []
+    for coords in _components(grid == BLUE, connectivity=4):
+        r0, c0, r1, c1 = _bbox(coords)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 4 or w < 4:
+            continue
+
+        expected = np.zeros((h, w), dtype=bool)
+        expected[0, :] = True
+        expected[-1, :] = True
+        expected[:, 0] = True
+        expected[:, -1] = True
+
+        actual = grid[r0 : r1 + 1, c0 : c1 + 1] == BLUE
+        if np.any(actual & ~expected):
+            continue
+
+        missing = np.argwhere(expected & ~actual)
+        if missing.shape != (1, 2):
+            continue
+        mr, mc = map(int, missing[0])
+        if (mr, mc) in {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}:
+            continue
+
+        if mr == 0:
+            door_side = "top"
+        elif mr == h - 1:
+            door_side = "bottom"
+        elif mc == 0:
+            door_side = "left"
+        else:
+            door_side = "right"
+
+        rooms.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "door": (r0 + mr, c0 + mc),
+                "door_side": door_side,
+            }
+        )
