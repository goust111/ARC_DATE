+        line_col = int(np.argmax(col_counts))
+        tip_col = 1 - line_col
+        tip_rows = np.flatnonzero(patch[:, tip_col])
+        if tip_rows.size != 1:
+            return None
+        tip_row = int(tip_rows[0])
+        if tip_row == 0:
+            direction = (-1, 0)
