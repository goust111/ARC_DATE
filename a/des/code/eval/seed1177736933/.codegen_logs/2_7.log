+        elif (dr, dc) == (0, -1):
+            delta = np.array([0, (c0 + 1) - int(original[:, 1].min())], dtype=int)
+        elif (dr, dc) == (1, 0):
+            delta = np.array([(r1 - 1) - int(original[:, 0].max()), 0], dtype=int)
+        else:
+            delta = np.array([(r0 + 1) - int(original[:, 0].min()), 0], dtype=int)
