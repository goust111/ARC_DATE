+    fr, fc = room["furniture_origin"]
+    shape = room["shape"]
+    color = room["color"]
+    for rr, cc in np.argwhere(shape):
+        grid[fr + int(rr), fc + int(cc)] = color
+
+
+def _draw_arrow(grid: np.ndarray, room: dict) -> np.ndarray:
