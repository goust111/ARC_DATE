+        return int(vertical_bands[center_c])
+    if dr != 0 and center_r in horizontal_bands:
+        return int(horizontal_bands[center_r])
+    if center_r in horizontal_bands:
+        return int(horizontal_bands[center_r])
+    if center_c in vertical_bands:
+        return int(vertical_bands[center_c])
