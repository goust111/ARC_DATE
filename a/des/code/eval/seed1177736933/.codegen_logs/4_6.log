+# --------------- generator ---------------
+
+BG_COLOR = 0
+OBSTACLE_COLOR = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+GRID_H_RANGE = (15, 21)
+GRID_W_RANGE = (15, 21)
+BAND_COUNT_CHOICES = (1, 2, 3)
+OBSTACLE_COUNT_CHOICES = (1, 2)
+ARROW_COUNT_RANGE = (3, 4)
+OBSTACLE_H_RANGE = (2, 5)
+OBSTACLE_W_RANGE = (2, 6)
