+
+    horizontal_bands: dict[int, int] = {}
+    vertical_bands: dict[int, int] = {}
+    for r in range(h):
+        row_vals = np.unique(g[r, :])
+        if row_vals.size == 1:
+            color = int(row_vals[0])
+            if color not in (bg, obstacle_color):
