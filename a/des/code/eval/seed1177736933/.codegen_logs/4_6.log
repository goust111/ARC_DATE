+    assert arrows, "expected at least one 3x3 arrow"
+    return bg, obstacle_mask, horizontal_bands, vertical_bands, arrows
+
+
+def _crossed_band_color(
+    direction: str,
+    center_r: int,
+    center_c: int,
+    horizontal_bands: dict[int, int],
+    vertical_bands: dict[int, int],
