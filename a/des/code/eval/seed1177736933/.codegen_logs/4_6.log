+
+def _select_arrows(candidates: list[dict]) -> list[dict] | None:
+    if not candidates:
+        return None
+
+    required = {"parallel", "perp", "cross0", "cross_pos", "stop_boundary", "stop_obstacle"}
+    if any("cross1" in cand["features"] for cand in candidates):
