        if len(chosen) == count:
            out.append(tuple(chosen))
            return
        for i in range(start, len(values)):
            if chosen and values[i] == chosen[-1] + 1:
                continue
            rec(i + 1, chosen + [values[i]])

    rec(0, [])
    return out

