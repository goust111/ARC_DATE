+        for _ in range(200):
+            oh = random.randint(*OBSTACLE_H_RANGE)
+            ow = random.randint(*OBSTACLE_W_RANGE)
+            if oh >= h - 2 or ow >= w - 2:
+                continue
+            r0 = random.randint(1, h - oh - 1)
+            c0 = random.randint(1, w - ow - 1)
+            r1 = r0 + oh - 1
+            c1 = c0 + ow - 1
+            if band_kind == "horizontal" and any(r in positions for r in range(r0, r1 + 1)):
+                continue
