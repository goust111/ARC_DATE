+
+def _place_obstacles(grid: np.ndarray, band_kind: str, positions: list[int], count: int) -> list[tuple[int, int, int, int]] | None:
+    h, w = grid.shape
+    boxes: list[tuple[int, int, int, int]] = []
+    for _ in range(count):
