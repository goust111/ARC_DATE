+    colors = random.sample(MARKER_COLORS, pair_count)
+    diags = [random.randint(0, 1) for _ in range(pair_count)]
+    markers = [_marker_positions(rect, diag) for rect, diag in zip(rects, diags)]
+    for color, pair in zip(colors, markers):
