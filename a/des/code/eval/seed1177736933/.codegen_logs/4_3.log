    return (r-5,c-2,r-1,c+2),(r-1,c)

def valid_end(side,end,h,w):
    (r0,c0,r1,c1),_ = screen_for(side,end)
    return 1 <= r0 and 1 <= c0 and r1 < h-1 and c1 < w-1

def find_path(start,end,nodes,forbidden,rng,target_min,target_max):
    allowed=(nodes-forbidden)|{start,end}
