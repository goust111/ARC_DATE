+    if side == "right":
+        return (r - 2, c - 5, r + 2, c - 1), (r, c - 1)
+    if side == "top":
+        return (r + 1, c - 2, r + 5, c + 2), (r + 1, c)
+    assert side == "bottom"
+    return (r - 5, c - 2, r - 1, c + 2), (r - 1, c)
