+    degree = Counter()
+    for edge in edges:
+        a, b = tuple(edge)
+        degree[a] += 1
+        degree[b] += 1
+
+    eligible_indices: list[int] = []
+    for i in range(1, len(main_path) - 1):
+        prev_node = main_path[i - 1]
+        cur = main_path[i]
+        nxt = main_path[i + 1]
+        turns = (cur[0] - prev_node[0], cur[1] - prev_node[1]) != (nxt[0] - cur[0], nxt[1] - cur[1])
