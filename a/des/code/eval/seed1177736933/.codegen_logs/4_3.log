+def _entry_node(side: str, end_node: tuple[int, int]) -> tuple[int, int]:
+    r, c = end_node
+    if side == "left":
+        return (r, c - STEP)
+    if side == "right":
+        return (r, c + STEP)
+    if side == "top":
+        return (r - STEP, c)
+    assert side == "bottom"
+    return (r + STEP, c)
