+        r0 = max(0, gr - pad)
+        c0 = max(0, gc - pad)
+        r1 = min(h, gr + pad + 1)
+        c1 = min(w, gc + pad + 1)
+        if occupied[r0:r1, c0:c1].any():
+            return False
+    return True
