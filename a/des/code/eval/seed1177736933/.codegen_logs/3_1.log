+def _can_place(
+    occupied: np.ndarray,
+    patch: np.ndarray,
+    top: int,
+    left: int,
+    pad: int,
+) -> bool:
+    h, w = occupied.shape
+    ph, pw = patch.shape
+    coords = np.argwhere(patch)
+    for rr, cc in coords:
