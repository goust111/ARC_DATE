+    if not np.all(out[: legend.shape[0], : legend.shape[1]] == BG):
+        return None
+    if np.count_nonzero((out != grid) & (out != BG)) == 0:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
