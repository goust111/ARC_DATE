+    top = int(RNG.integers(min_pad, max_pad + 1))
+    bottom = int(RNG.integers(min_pad, max_pad + 1))
+    left = int(RNG.integers(min_pad, max_pad + 1))
+    right = int(RNG.integers(min_pad, max_pad + 1))
