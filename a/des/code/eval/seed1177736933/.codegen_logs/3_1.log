+        row_y += row_heights[rr] + 1
+
+    return legend
+
+
+def _can_place(
+    occupied: np.ndarray,
+    patch: np.ndarray,
+    top: int,
+    left: int,
+    pad: int,
+) -> bool:
+    h, w = occupied.shape
+    ph, pw = patch.shape
