+        _paint_frame_patch(inp, top, left, spec["frame_h"], spec["frame_w"], spec["frame_color"], spec["gap_local"])
+        _paint_frame_patch(out, top, left, spec["frame_h"], spec["frame_w"], spec["frame_color"], spec["gap_local"])
