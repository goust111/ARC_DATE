+            key_mask, key_box = _mask_from_coords(key_comps[0])
+            key_global = (r0 + 1 + key_box[0], c0 + 1 + key_box[1], r0 + 1 + key_box[2], c0 + 1 + key_box[3])
+
+            frames.append(
+                {
+                    "color": int(color),
+                    "component_id": int(comp["id"]),
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "gap": (int(r0 + mr), int(c0 + mc)),
+                    "side": side,
+                    "key_mask": key_mask,
+                    "key_bbox": key_global,
