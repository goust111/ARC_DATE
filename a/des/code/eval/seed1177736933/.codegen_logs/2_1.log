+def _frame_spec(frame_color: int, key_color: int) -> dict:
+    key_mask = _random_connected_mask()
+    rot_k = random.randrange(4)
+    lock_mask = _trim(np.rot90(key_mask, rot_k))
+    side = random.choice(SIDES)
