+            missing = np.argwhere(border & ~comp["mask"])
+            if len(missing) != 1:
+                continue
+
+            mr, mc = int(missing[0, 0]), int(missing[0, 1])
+            side_hits = int(mr in (0, h - 1)) + int(mc in (0, w - 1))
+            if side_hits != 1:
