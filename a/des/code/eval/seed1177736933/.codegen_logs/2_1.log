+
+    return out
+
+
+def _rotations_are_distinct(mask: np.ndarray) -> bool:
+    return len(_unique_rotations(mask)) == 4
+
+
+def _random_connected_mask() -> np.ndarray:
+    for _ in range(200):
+        h = random.randint(2, 4)
+        w = random.randint(2, 4)
+        target = random.randint(3, min(6, h * w - 1))
+        start = (random.randrange(h), random.randrange(w))
+        cells = {start}
+        frontier = set()
+        for dr, dc in DIR4:
+            nr = start[0] + dr
+            nc = start[1] + dc
+            if 0 <= nr < h and 0 <= nc < w:
+                frontier.add((nr, nc))
+        while len(cells) < target and frontier:
+            nr, nc = random.choice(tuple(frontier))
+            frontier.remove((nr, nc))
+            cells.add((nr, nc))
+            for dr, dc in DIR4:
+                rr = nr + dr
+                cc = nc + dc
+                if 0 <= rr < h and 0 <= cc < w and (rr, cc) not in cells:
+                    frontier.add((rr, cc))
+
+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in cells:
+            mask[r, c] = True
+        mask = _trim(mask)
+        if mask.shape[0] < 2 or mask.shape[1] < 2:
+            continue
+        if not _rotations_are_distinct(mask):
