+        spec["lock_left"] = int(left)
+        spec["lock_bbox"] = (int(top), int(left), int(top + ph - 1), int(left + pw - 1))
+        _paint_mask(grid, mask, top, left, spec["frame_color"])
+        reserved_boxes.append(expanded)
