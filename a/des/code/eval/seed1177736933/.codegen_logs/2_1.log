                for _, k, opts_k in candidates:
                    remaining.remove(k)
                    pi = other_pis[k]
                    for pl in opts_k:
                        chosen[pi] = pl
                        if search(used | pl[0]):
                            return True
                    chosen.pop(pi, None)
                    remaining.add(k)
                return False

            if not search(legend_mask):
                return None
            return chosen


