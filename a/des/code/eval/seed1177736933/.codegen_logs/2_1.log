+    for idx, coords in enumerate(_components(grid == color)):
+        mask, box = _mask_from_coords(coords)
+        infos.append(
+            {
+                "id": int(idx),
+                "color": int(color),
+                "coords": [(int(r), int(c)) for r, c in coords],
+                "mask": mask,
+                "bbox": box,
