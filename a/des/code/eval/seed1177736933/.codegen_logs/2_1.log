+    if side == "down":
+        return int(r1 + 1), int(gc - (w // 2))
+    if side == "left":
+        return int(gr - (h // 2)), int(c0 - w)
+    if side == "right":
+        return int(gr - (h // 2)), int(c1 + 1)
+    raise ValueError(f"unknown side: {side}")
