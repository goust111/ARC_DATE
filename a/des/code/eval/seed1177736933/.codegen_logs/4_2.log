+from __future__ import annotations
+
+from collections import deque
+from itertools import combinations
+import random
+
+import numpy as np
+
+
+BOX_OUTER = 5
+BOX_INNER = 3
+DIRS = ("top", "bottom", "left", "right")
+TARGET_ANCHORS = {
+    "top": (0, 1),
+    "bottom": (2, 1),
+    "left": (1, 0),
+    "right": (1, 2),
+}
+
+GRID_RANGES = {
+    2: ((18, 24), (18, 24)),
+    3: ((22, 28), (22, 28)),
+    4: ((24, 30), (24, 30)),
+}
+BOX_COUNT_RANGE = (2, 4)
+BOX_EDGE_MARGIN = 3
+BOX_PADDING = 2
+GEN_ATTEMPTS = 500
