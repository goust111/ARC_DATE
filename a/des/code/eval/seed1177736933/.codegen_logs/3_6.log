+
+
+def _swept_rect_cells(pos: tuple[int, int], direction: str, distance: int) -> set[tuple[int, int]]:
+    dr, dc = DIR_VECS[direction]
+    swept: set[tuple[int, int]] = set()
+    for step in range(int(distance) + 1):
