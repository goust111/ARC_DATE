+
+    sequence = [int(g[r, w - 1]) for r in range(h) if int(g[r, w - 1]) != BG]
+    assert sequence, "expected a non-empty sequence bar in the rightmost column"
+    assert len(set(sequence)) == len(sequence), "sequence bar colors must be unique"
+
