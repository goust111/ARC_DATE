def min_side_anchor(mask):
    cnt={'U':int(mask[0,:].sum()),'D':int(mask[2,:].sum()),'L':int(mask[:,0].sum()),'R':int(mask[:,2].sum())}
    vals=list(cnt.values())
    m=min(vals)
    if vals.count(m)"'!=1:
        return None
    side=min(cnt,key=cnt.get)
    coords=[]
    if side=='"'U': coords=[(0,c) for c in range(3) if mask[0,c]]
    elif side=='D': coords=[(2,c) for c in range(3) if mask[2,c]]
    elif side=='L': coords=[(r,0) for r in range(3) if mask[r,0]]
    else: coords=[(r,2) for r in range(3) if mask[r,2]]
    if not coords:
        return None
    if side in 'UD':
        anchor=min(coords,key=lambda x:(abs(x[1]-1),x[1]))
