+        if pc < c0 and r0 <= pr <= r1 and np.all(grid[pr, pc + 1 : c0] == bg):
+            hits.append(("L", pad))
+        if pc > c1 and r0 <= pr <= r1 and np.all(grid[pr, c1 + 1 : pc] == bg):
