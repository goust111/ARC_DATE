+def main(grid: np.ndarray) -> np.ndarray:
+    """Match each stamp with its pad, rotate the stamp toward the pad, and stamp it in the pad's color."""
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0
