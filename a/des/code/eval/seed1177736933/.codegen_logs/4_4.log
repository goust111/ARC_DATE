+    bbox = (sr, sc, sr + sh - 1, sc + sw - 1)
+    corridor = corridor_cells(bbox, pad, pad_dir)
+    input_cells = stamp_coords | {pad}
+
+    if input_cells & blocked_input:
+        return None
+    if input_cells & reserved_output:
+        return None
+    if corridor & occupied_input:
+        return None
