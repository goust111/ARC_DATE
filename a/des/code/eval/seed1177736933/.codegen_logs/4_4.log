+        pr = sr - gap if pad_dir == "U" else sr + sh - 1 + gap
+    else:
+        pr = sr + random.randrange(sh)
+        pc = sc - gap if pad_dir == "L" else sc + sw - 1 + gap
+
+    pad = (pr, pc)
+    if not in_bounds(pad, shape):
+        return None
+
