+    pr, pc = pad
+    if direction == "U":
+        return {(r, pc) for r in range(pr + 1, r0)}
+    if direction == "D":
+        return {(r, pc) for r in range(r1 + 1, pr)}
+    if direction == "L":
+        return {(pr, c) for c in range(pc + 1, c0)}
+    if direction == "R":
+        return {(pr, c) for c in range(c1 + 1, pc)}
+    raise AssertionError("bad direction")
