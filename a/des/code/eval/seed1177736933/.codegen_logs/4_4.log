+
+
+def _connected(mask: np.ndarray) -> bool:
+    coords = [tuple(map(int, pos)) for pos in np.argwhere(mask)]
+    if not coords:
+        return False
+    queue = deque([coords[0]])
+    seen = {coords[0]}
+    h, w = mask.shape
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr, nc = r + dr, c + dc
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if not mask[nr, nc] or (nr, nc) in seen:
