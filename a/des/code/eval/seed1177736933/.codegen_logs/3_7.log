+def _nearest_side(inner_h: int, inner_w: int, r: int, c: int) -> str:
+    distances = {
+        "up": r + 1,
+        "down": inner_h - r,
+        "left": c + 1,
+        "right": inner_w - c,
+    }
+    best = min(distances.values())
+    winners = [side for side, dist in distances.items() if dist == best]
+    if len(winners) != 1:
+        raise AssertionError("defect has ambiguous nearest edge")
+    return winners[0]
