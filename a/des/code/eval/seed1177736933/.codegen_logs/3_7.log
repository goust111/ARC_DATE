                if 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1]:
                    out[rr, cc] = color
                rr += dr
                cc += dc
    return out


def _defect_groups(inner_h: int, inner_w: int) -> dict[str, list[tuple[int, int, int]]]:
    groups = {side: [] for side in SIDES}
    for r in range(inner_h):
