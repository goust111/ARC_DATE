+    if len(used_sides) < 2:
+        return None
+
+    total_area = sum(int(spec["expanded_h"]) * int(spec["expanded_w"]) for spec in specs)
+    max_h = max(int(spec["expanded_h"]) for spec in specs)
+    max_w = max(int(spec["expanded_w"]) for spec in specs)
