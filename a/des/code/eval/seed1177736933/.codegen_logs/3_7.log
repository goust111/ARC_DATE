+    r0, c0, r1, c1 = bbox
+    grid_r = r0 + 1 + inner_r
+    grid_c = c0 + 1 + inner_c
+    if side == "up":
+        return (r0 - 1, grid_c), (-1, 0)
+    if side == "down":
+        return (r1 + 1, grid_c), (1, 0)
+    if side == "left":
