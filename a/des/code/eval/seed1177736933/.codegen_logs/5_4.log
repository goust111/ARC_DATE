+def _make_stripe(length: int, rng: np.random.Generator) -> np.ndarray:
+    n_runs = int(rng.integers(3, min(6, length) + 1))
+    if n_runs == 1:
+        return np.full(length, int(rng.choice(STRIPE_COLORS)), dtype=int)
