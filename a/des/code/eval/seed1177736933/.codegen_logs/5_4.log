+        cols = [c for _, c in comp]
+        r0, r1 = min(rows), max(rows)
+        c0, c1 = min(cols), max(cols)
+        box_h = r1 - r0 + 1
+        box_w = c1 - c0 + 1
+        if box_h < ROOM_SIDE_MIN or box_w < ROOM_SIDE_MIN:
+            continue
