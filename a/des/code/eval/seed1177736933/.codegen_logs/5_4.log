+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
+    out = g.copy()
+
+    for room in _find_rooms(g):
+        r0 = int(room["r0"])
+        c0 = int(room["c0"])
+        r1 = int(room["r1"])
+        c1 = int(room["c1"])
+        side = str(room["side"])
+
+        if side == "up":
+            for c in range(c0 + 1, c1):
+                out[r0 + 1 : r1, c] = g[0, c]
+        elif side == "down":
+            for c in range(c0 + 1, c1):
+                out[r0 + 1 : r1, c] = g[h - 1, c]
+        elif side == "left":
+            for r in range(r0 + 1, r1):
+                out[r, c0 + 1 : c1] = g[r, 0]
+        elif side == "right":
+            for r in range(r0 + 1, r1):
+                out[r, c0 + 1 : c1] = g[r, w - 1]
+
+    return out
+
