+import numpy as np
+
+
+BG_COLOR = 0
+WALL_COLOR = 1
+STRIPE_COLORS = np.array([2, 3, 4, 5, 6, 7, 8, 9], dtype=int)
+ORIENTATIONS = ("up", "down", "left", "right")
+
+GRID_MIN = 14
+GRID_MAX = 25
+ROOMS_MIN = 1
+ROOMS_MAX = 4
+ROOM_SIDE_MIN = 4
+ROOM_SIDE_MAX = 8
+OUTER_MARGIN = 2
+ROOM_PAD = 1
+PLACEMENT_TRIES = 100
+GENERATION_RETRIES = 400
