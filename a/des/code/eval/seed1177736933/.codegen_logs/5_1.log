+GEN_RETRIES = 400
+GEN_K_CHOICES = (3, 4)
+GEN_REGION_COUNT_RANGE = (4, 6)
+GEN_LEGEND_GAP = 1
+GEN_BOX_PAD = 1
+GEN_PLACE_TRIES = 250
