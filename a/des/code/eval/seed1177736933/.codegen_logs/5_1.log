+            raise ValueError("seed bbox must match legend pattern size")
+        fill_color = mapping[_symmetry_kind(seed_patch)]
+
+        region = out[r0 + 1 : r1, c0 + 1 : c1]
+        region[region != SEED] = fill_color
+
+    return out
