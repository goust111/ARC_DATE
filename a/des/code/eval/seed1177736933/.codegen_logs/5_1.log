+
+BG = 0
+WALL = 5
+SEED = 9
+
+SYM_H = "horizontal"
+SYM_V = "vertical"
+SYM_R = "rot180"
+SYM_N = "none"
+SYMMETRY_KINDS = (SYM_H, SYM_V, SYM_R, SYM_N)
+
+FILL_COLORS = (1, 2, 3, 4, 6, 7, 8)
