+
+    return cells, sources, valves, want_tie, True
+
+
+def _build_zigzag_family(
+    rng: np.random.Generator,
+    want_tie: bool,
+) -> tuple[set[tuple[int, int]], list[tuple[int, int]], list[tuple[int, int]], bool, bool]:
+    trunk1 = trunk2 = trunk3 = 0
