+        lengths[str(open_pair[0])] = first
+        lengths[str(open_pair[1])] = second
+
+    for direction in blocked:
+        lengths[str(direction)] = int(rng.integers(4, 9))
+
+    def endpoint_for(direction: str) -> tuple[int, int]:
+        length = lengths[direction]
