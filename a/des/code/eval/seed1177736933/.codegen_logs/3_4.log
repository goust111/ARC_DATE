+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    rows = np.where(mask.any(axis=1))[0]
+    cols = np.where(mask.any(axis=0))[0]
+    assert rows.size and cols.size
+    return mask[rows[0] : rows[-1] + 1, cols[0] : cols[-1] + 1]
+
+
+def _mask_connected(mask: np.ndarray) -> bool:
+    cells = np.argwhere(mask)
+    if cells.size == 0:
+        return False
+    seen = set()
+    start = tuple(map(int, cells[0]))
+    q = deque([start])
+    seen.add(start)
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIRS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc]:
+                nxt = (nr, nc)
+                if nxt not in seen:
+                    seen.add(nxt)
+                    q.append(nxt)
+    return len(seen) == int(mask.sum())
+
+
+def _is_threefold(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    center = coords.mean(axis=0)
+    base = {tuple(map(int, xy)) for xy in coords}
+    for step in (1, 2):
+        theta = 2.0 * math.pi * step / 3.0
+        ct = math.cos(theta)
+        st = math.sin(theta)
+        rotated: set[tuple[int, int]] = set()
+        for r, c in coords:
+            rr = center[0] + ct * (r - center[0]) - st * (c - center[1])
+            cc = center[1] + st * (r - center[0]) + ct * (c - center[1])
+            rr_i = int(round(rr))
+            cc_i = int(round(cc))
+            if abs(rr - rr_i) > 1e-6 or abs(cc - cc_i) > 1e-6:
+                return False
+            rotated.add((rr_i, cc_i))
+        if rotated != base:
+            return False
+    return True
