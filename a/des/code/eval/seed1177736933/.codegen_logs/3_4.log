+
+def _orbits_180(h: int, w: int) -> list[list[tuple[int, int]]]:
+    seen: set[tuple[int, int]] = set()
+    orbits: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if (r, c) in seen:
+                continue
+            orbit = {(r, c), (h - 1 - r, w - 1 - c)}
+            seen |= orbit
+            orbits.append(sorted(orbit))
+    return orbits
+
+
+def _orbits_90(n: int) -> list[list[tuple[int, int]]]:
+    seen: set[tuple[int, int]] = set()
+    orbits: list[list[tuple[int, int]]] = []
+    for r in range(n):
+        for c in range(n):
+            if (r, c) in seen:
+                continue
+            orbit = set()
+            rr, cc = r, c
+            for _ in range(4):
+                orbit.add((rr, cc))
+                rr, cc = cc, n - 1 - rr
+            seen |= orbit
+            orbits.append(sorted(orbit))
+    return orbits
