+            arr = np.asarray(coords, dtype=int)
+            r0, c0 = arr.min(axis=0)
+            r1, c1 = arr.max(axis=0)
+            obj_mask = np.zeros((int(r1 - r0 + 1), int(c1 - c0 + 1)), dtype=bool)
+            obj_mask[arr[:, 0] - r0, arr[:, 1] - c0] = True
+            objects.append(
