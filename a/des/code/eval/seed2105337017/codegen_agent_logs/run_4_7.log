+def _has_bridge_segment(segments: list[dict], crossings: list[dict]) -> bool:
+    for seg in segments:
+        seen_lower = False
+        for cross_id in seg["crossings"]:
+            cross = crossings[int(cross_id)]
+            upper = cross["upper"]
+            if upper is None:
+                continue
+            if int(upper) == int(seg["id"]):
+                if seen_lower:
+                    return True
+            else:
+                seen_lower = True
