+    require_side_mix = len(crossings) >= 3 and random.random() < SIDE_MIX_PROB
+    upper_sides: set[str] = set()
+    for cross in crossings:
+        if random.random() < 0.5:
+            cross["upper"] = int(cross["h"])
+            upper_sides.add("h")
+        else:
+            cross["upper"] = int(cross["v"])
+            upper_sides.add("v")
