+    assert pointer_count == len(frames) - 1, "expected exactly one terminal frame without a pointer"
+
+    indegree = [0] * len(frames)
+    terminal_count = 0
+    for nxt in outgoing:
+        if nxt is None:
+            terminal_count += 1
+        else:
