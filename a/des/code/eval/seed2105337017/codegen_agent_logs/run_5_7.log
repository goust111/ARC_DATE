+    frames: list[tuple[int, int, int, int]] = []
+    if orientation == "horizontal":
+        for i in range(frame_count):
+            c0 = left + i * (inner_w + 1)
+            frames.append((top, c0, top + inner_h + 1, c0 + inner_w + 1))
+    else:
+        for i in range(frame_count):
