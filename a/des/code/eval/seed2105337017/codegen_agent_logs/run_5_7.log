+    ih, iw = map(int, inner.shape)
+    assert ih >= 3 and iw >= 3 and ih % 2 == 1 and iw % 2 == 1, "pointer midpoints must be unique"
+    pr, pc = map(int, points[0])
+    lookup = {
+        (0, iw // 2): (-1, 0),
+        (ih - 1, iw // 2): (1, 0),
+        (ih // 2, 0): (0, -1),
+        (ih // 2, iw - 1): (0, 1),
+    }
+    assert (pr, pc) in lookup, "pointer must lie at the midpoint of one interior side"
+    return lookup[(pr, pc)]
