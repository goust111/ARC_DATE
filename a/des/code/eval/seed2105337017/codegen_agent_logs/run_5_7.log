+def _pointer_direction(inner: np.ndarray) -> tuple[int, int] | None:
+    points = np.argwhere(inner == POINTER_COLOR)
+    assert points.shape[0] <= 1, "each frame may contain at most one pointer"
+    if points.shape[0] == 0:
