+    chain: list[int] = []
+    seen: set[int] = set()
+    cur: int | None = starts[0]
+    while cur is not None:
+        assert cur not in seen, "chain must be acyclic"
+        seen.add(cur)
+        chain.append(cur)
+        cur = outgoing[cur]
