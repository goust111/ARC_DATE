+def _sample_dimensions(orientation: str, inner_h: int, inner_w: int) -> tuple[int, int, int, int, int]:
+    axis_span = inner_w + 1 if orientation == "horizontal" else inner_h + 1
+    max_count_fit = (GRID_MAX - 3) // axis_span
