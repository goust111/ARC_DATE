+            bbox = (r0, c0, r0 + fh - 1, c0 + fw - 1)
+            spec["fence_bbox"] = bbox
+            _draw_frame(grid, bbox, int(spec["border"]))
+            _mark_bbox(occupied, bbox)
+            placed = True
+            break
+        if not placed:
+            return None
+
