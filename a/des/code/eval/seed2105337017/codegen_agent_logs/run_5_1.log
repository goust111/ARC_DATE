+def _mark_bbox(occupied: np.ndarray, bbox: tuple[int, int, int, int]) -> None:
+    r0, c0, r1, c1 = bbox
+    occupied[r0 : r1 + 1, c0 : c1 + 1] = True
+
+
+def _expected_output(grid: np.ndarray, bg: int, specs: list[dict]) -> np.ndarray:
+    out = grid.copy()
