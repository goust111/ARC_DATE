+            bbox = (r0, c0, r0 + int(spec["palette_h"]) - 1, c0 + int(spec["palette_w"]) - 1)
+            spec["palette_bbox"] = bbox
+            _place_palette(grid, bbox, int(spec["border"]), spec["pattern"])
