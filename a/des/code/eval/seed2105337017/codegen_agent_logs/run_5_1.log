+def _can_place_bbox(occupied: np.ndarray, r0: int, c0: int, height: int, width: int, pad: int = 1) -> bool:
+    h, w = occupied.shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h, r0 + height + pad)
+    cc1 = min(w, c0 + width + pad)
