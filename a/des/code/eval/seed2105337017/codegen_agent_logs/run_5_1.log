                "palette_w": tile_size + 2,
                "fence_h": inner_h + 2,
                "fence_w": inner_w + 2,
            }
        )

    total_fence_area = sum(int(spec["fence_h"] * spec["fence_w"]) for spec in specs)
    max_palette_h = max(int(spec["palette_h"]) for spec in specs)
    max_palette_w = max(int(spec["palette_w"]) for spec in specs)

