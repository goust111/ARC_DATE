    bg = _most_common_color(g)

    palettes: dict[int, np.ndarray] = {}
    palette_boxes: list[tuple[int, int, int, int]] = []
    fences: dict[int, list[tuple[int, int, int, int]]] = defaultdict(list)

    for color in map(int, np.unique(g)):
