+def _layout_line(total: int, sizes: list[int], margin: int = 1) -> list[int] | None:
+    need = sum(sizes) + (len(sizes) - 1) + 2 * margin
+    if need > total:
+        return None
+    extra = total - need
+    slots = [0] * (len(sizes) + 1)
+    for _ in range(extra):
+        slots[random.randrange(len(slots))] += 1
+    starts = []
+    pos = margin + slots[0]
+    for i, size in enumerate(sizes):
+        starts.append(pos)
