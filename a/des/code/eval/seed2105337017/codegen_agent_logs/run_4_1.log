+            c0 = grid.shape[1] - w
+            grid[r0 : r0 + tpl.shape[0], c0 : c0 + tpl.shape[1]] = tpl
+            placed.append((tpl, tpl == BLACK, r0, c0))
+    return placed
+
+
+def _can_place(occupied: np.ndarray, r0: int, c0: int, patch: np.ndarray) -> bool:
+    h, w = occupied.shape
+    ph, pw = patch.shape
