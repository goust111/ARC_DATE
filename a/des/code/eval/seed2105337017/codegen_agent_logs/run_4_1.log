+    room = {(r + 1, c + 1) for r, c in zip(*np.where(region_mask), strict=False)}
+    for r, c in room:
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) not in room:
+                boundary[nr, nc] = True
+    boundary[[r for r, _c in room], [c for _r, c in room]] = False
+    return boundary
