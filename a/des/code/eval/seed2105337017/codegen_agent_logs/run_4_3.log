+def crop_component(coords: list[tuple[int, int]]) -> tuple[tuple[int, int, int, int], np.ndarray]:
+    r0, c0, r1, c1 = bbox_from_coords(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
+    return (r0, c0, r1, c1), mask
+
