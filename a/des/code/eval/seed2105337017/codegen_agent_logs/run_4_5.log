+        num_colors = min(len(palette), rng.randint(2, min(4, len(palette))))
+        colors = rng.sample(palette, num_colors)
+        order = list(np.argwhere(mask))
+        rng.shuffle(order)
+        for i, (r, c) in enumerate(order):
