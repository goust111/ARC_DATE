+    if not np.all(grid[r1, c0 : c1 + 1] == MAROON):
+        raise ValueError("legend bottom border invalid")
+    if not np.all(grid[r0 : r1 + 1, c0] == MAROON):
+        raise ValueError("legend left border invalid")
