+
+
+def _make_legend(
+    rng: random.Random, mapping: dict[int, str]
+) -> np.ndarray:
+    inner_h = len(mapping) * 4
+    inner_w = 7
+    inner = np.zeros((inner_h, inner_w), dtype=int)
+    entries = list(mapping.items())
+    rng.shuffle(entries)
