+            pr = rng.randint(0, grid_h - patch_h)
+            pc = rng.randint(0, grid_w - patch_w)
+            if not _can_place(blocked, pr, pc, patch_h, patch_w, pad=1):
+                continue
+            border_pts = [(int(r), int(c)) for r, c in np.argwhere(border_mask)]
