+
+def _perimeter(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    border = np.zeros((h, w), dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            for nr, nc in _neighbors4(r, c):
+                if not (0 <= nr < h and 0 <= nc < w) or not mask[nr, nc]:
