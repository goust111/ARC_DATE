+    solved = main(grid)
+    if np.array_equal(solved, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        try:
+            grid = _gen_attempt(rng)
+        except Exception:
+            continue
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input: exceeded retries")

