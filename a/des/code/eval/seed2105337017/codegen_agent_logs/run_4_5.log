+def _normalize_points(points: list[tuple[int, int]] | np.ndarray) -> set[tuple[int, int]]:
+    pts = [(int(r), int(c)) for r, c in points]
+    r0 = min(r for r, _ in pts)
+    c0 = min(c for _, c in pts)
+    return {(r - r0, c - c0) for r, c in pts}
