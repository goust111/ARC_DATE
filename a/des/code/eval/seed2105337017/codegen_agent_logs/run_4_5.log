+
+TRANSFORM_SYMBOLS = {
+    "hflip": {(0, 0), (1, 0), (2, 0), (1, 1)},
+    "vflip": {(0, 0), (0, 1), (0, 2), (1, 1)},
+    "rot90": {(0, 0), (0, 1), (1, 1)},
