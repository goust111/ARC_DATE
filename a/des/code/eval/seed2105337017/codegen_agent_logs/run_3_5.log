+        rr = idx // cols
+        cc = idx % cols
+        r0 = _cell_origin(rr, cell_h, outer_border)
+        c0 = _cell_origin(cc, cell_w, outer_border)
+        patch = grid[r0 : r0 + cell_h, c0 : c0 + cell_w]
+        patch[mask] = int(color)
+
+    return grid
+
+
+def _render_expected_output(
+    grid: np.ndarray,
+    missing_masks: list[np.ndarray],
