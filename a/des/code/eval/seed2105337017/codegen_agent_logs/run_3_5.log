+
+def _completion_fill(reference_mask: np.ndarray, current_mask: np.ndarray, cell_shape: tuple[int, int]) -> np.ndarray:
+    cell_h, cell_w = map(int, cell_shape)
+    fills: dict[tuple[tuple[int, int], bytes], np.ndarray] = {}
