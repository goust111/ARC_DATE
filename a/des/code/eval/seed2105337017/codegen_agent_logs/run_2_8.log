+        grid = np.zeros((h, w), dtype=int)
+        forbidden = np.zeros((h, w), dtype=bool)
+
+        if side == "top":
+            pr0 = 0
+            pc0 = random.randint(0, w - pal_w)
+        elif side == "bottom":
+            pr0 = h - pal_h
+            pc0 = random.randint(0, w - pal_w)
+        elif side == "left":
