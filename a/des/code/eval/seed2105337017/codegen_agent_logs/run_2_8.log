+                    if not mask[nr, nc]:
+                        frontier.append((nr, nc))
+            if not frontier:
+                break
+            nr, nc = random.choice(frontier)
+            mask[nr, nc] = True
+            cells.append((nr, nc))
+        if int(mask.sum()) != target:
+            continue
+        coords = np.argwhere(mask)
+        r0, c0, r1, c1 = _bbox(coords)
+        if r0 != 0 or c0 != 0 or r1 != rows - 1 or c1 != cols - 1:
+            continue
+        return mask
+    return None
+
