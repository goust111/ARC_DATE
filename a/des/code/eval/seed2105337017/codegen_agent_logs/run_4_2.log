+def _gen_vertical_scene() -> np.ndarray | None:
+    height = random.randint(GRID_MIN, GRID_MAX)
+    width = random.randint(GRID_MIN, GRID_MAX)
+    grid = np.full((height, width), BG, dtype=int)
+
+    fence_rows_pool = list(range(6, height - 6))
