+        sr0, sc0, sr1, sc1 = spec["source_bbox"]
+        tr0, tc0, tr1, tc1 = spec["target_bbox"]
+        _ = (sr0, sc0, sr1, sc1)
+        for rr, cc in spec["furniture"]:
+            color = int(inp[rr, cc])
+            if spec["orient"] == "lr":
+                mr, mc = int(rr), 2 * int(door_c) - int(cc)
+            else:
+                mr, mc = 2 * int(door_r) - int(rr), int(cc)
+            assert tr0 < mr < tr1 and tc0 < mc < tc1
+            out[mr, mc] = color
+    return out
+
