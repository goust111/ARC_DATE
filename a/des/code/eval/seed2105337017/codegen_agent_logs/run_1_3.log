+def _grow_connected_shape(h: int, w: int, size: int) -> np.ndarray:
+    seed = (random.randrange(h), random.randrange(w))
+    selected = {seed}
+    frontier: set[tuple[int, int]] = set(_neighbors4(seed[0], seed[1], h, w))
