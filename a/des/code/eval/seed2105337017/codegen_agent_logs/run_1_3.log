+            c0 = max(0, left - PLACEMENT_MARGIN)
+            r1 = min(grid_h, top + pair_h + PLACEMENT_MARGIN)
+            c1 = min(grid_w, left + pair_w + PLACEMENT_MARGIN)
+            if occupancy[r0:r1, c0:c1].any():
+                continue
