+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    cropped = mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].copy()
+    if extra is None:
+        return cropped
+    extra = np.asarray(extra, dtype=bool)
+    return cropped, extra[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].copy()
