+
+
+def _assign_sources(
+    pipe: set[tuple[int, int]], h: int, w: int, rng: random.Random
+) -> tuple[dict[tuple[int, int], int], dict[tuple[int, int], tuple[int, int]]] | None:
+    mask = np.zeros((h, w), dtype=bool)
