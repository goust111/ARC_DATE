+        "down": bool(np.all(mask[-1, :])),
+        "left": bool(np.all(mask[:, 0])),
+        "right": bool(np.all(mask[:, -1])),
+    }
+    missing = [direction for direction, full in edge_full.items() if not full]
+    assert len(missing) == 1, "each frame must miss exactly one side"
+    direction = missing[0]
