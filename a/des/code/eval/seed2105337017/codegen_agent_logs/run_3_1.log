+    left_pad = max(int(templates["up"].shape[1]), int(templates["left"].shape[1])) + 2
+    right_pad = max(int(templates["right"].shape[1]), int(templates["down"].shape[1])) + 2
+    return top_pad, bottom_pad, left_pad, right_pad
