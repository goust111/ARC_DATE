+    if direction == "up":
+        assert int(mask[0, :].sum()) == 2 and mask[0, 0] and mask[0, -1]
+    elif direction == "down":
+        assert int(mask[-1, :].sum()) == 2 and mask[-1, 0] and mask[-1, -1]
+    elif direction == "left":
+        assert int(mask[:, 0].sum()) == 2 and mask[0, 0] and mask[-1, 0]
+    else:
+        assert int(mask[:, -1].sum()) == 2 and mask[0, -1] and mask[-1, -1]
