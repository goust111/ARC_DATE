+    for room in rooms:
+        room_id = int(room["id"])
+        own_area = int(room["area"])
+        candidates = [
+            other_id for other_id in graph[room_id] if int(rooms[other_id]["area"]) > own_area
+        ]
+        if not candidates:
+            final.append(int(room["color"]))
+            continue
