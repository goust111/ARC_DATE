+    bounds = [-1] + sorted(set(int(x) for x in lines)) + [int(length)]
+    spans: list[tuple[int, int]] = []
+    for a, b in zip(bounds, bounds[1:]):
+        start = int(a) + 1
+        end = int(b) - 1
+        if start <= end:
+            spans.append((start, end))
+    return spans
