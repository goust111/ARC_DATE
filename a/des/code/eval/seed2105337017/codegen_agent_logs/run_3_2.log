+                    "id": room_id,
+                    "row_band": ri,
+                    "col_band": ci,
+                    "r0": int(r0),
+                    "r1": int(r1),
+                    "c0": int(c0),
+                    "c1": int(c1),
+                    "height": height,
+                    "width": width,
+                    "color": color,
+                    "area": area,
+                    "rect_h": rect_h,
+                    "rect_w": rect_w,
