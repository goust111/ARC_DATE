+    ]
+    wall_cols = [
+        c for c in range(g.shape[1]) if bool(np.all(np.isin(g[:, c], (WALL, GATE))))
+    ]
+    assert len(wall_rows) >= 2 and len(wall_cols) >= 2, "expected room-separating walls"
+    return wall_rows, wall_cols
