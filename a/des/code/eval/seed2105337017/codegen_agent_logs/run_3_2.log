+def _compact_dims(area: int) -> tuple[int, int]:
+    """Pick the factor pair closest to square, then orient it wide."""
+    best_h = 1
+    for h in range(1, int(math.isqrt(int(area))) + 1):
+        if int(area) % h == 0:
+            best_h = h
+    return best_h, int(area) // best_h
