+def _adjacency(room_count: int, edges: list[tuple[int, int]]) -> dict[int, set[int]]:
+    graph: dict[int, set[int]] = {room_id: set() for room_id in range(int(room_count))}
+    for a, b in edges:
+        graph[int(a)].add(int(b))
+        graph[int(b)].add(int(a))
+    return graph
+
