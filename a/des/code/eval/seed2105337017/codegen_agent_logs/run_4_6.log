+def _repair_with_symmetry(block: np.ndarray, symmetry: str) -> np.ndarray | None:
+    repaired = block.copy()
+    h, w = repaired.shape
+    changed = True
+    while changed:
+        changed = False
+        for r in range(h):
+            for c in range(w):
+                if int(repaired[r, c]) != DAMAGE:
+                    continue
+                rr, cc = _partner((h, w), symmetry, r, c)
+                if int(repaired[rr, cc]) != DAMAGE:
