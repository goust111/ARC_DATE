+    return grid
+
+
+def _normalize_specs(specs: list[dict[str, int]]) -> list[tuple[int, ...]]:
+    return sorted(
+        (
+            int(spec["r0"]),
+            int(spec["c0"]),
+            int(spec["r1"]),
+            int(spec["c1"]),
+            int(spec["color"]),
+            int(spec["seed_count"]),
+        )
+        for spec in specs
+    )
+
+
+def _valid_generated_example(grid: np.ndarray, specs: list[dict[str, int]], bg: int) -> bool:
+    if _most_common_color(grid) != bg:
+        return False
