+        c0 = frame["c0"]
+        r1 = frame["r1"]
+        c1 = frame["c1"]
+        before = np.where(grid[r0 : r1 + 1, c0 : c1 + 1] == SEED_COLOR, bg, grid[r0 : r1 + 1, c0 : c1 + 1])
+        after = out[r0 : r1 + 1, c0 : c1 + 1]
+        if not np.array_equal(before, after):
+            changed += 1
