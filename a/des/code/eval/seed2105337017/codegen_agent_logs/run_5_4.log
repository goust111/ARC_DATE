+
+
+def _randint(lo: int, hi: int) -> int:
+    return int(RNG.integers(lo, hi))
+
+
+def _size_options(seed_count: int) -> list[tuple[int, int]]:
+    options = []
+    for height in range(5, 12):
+        for width in range(5, 12):
+            if (height - 2) * (width - 2) < seed_count:
+                continue
+            if seed_count == 3:
