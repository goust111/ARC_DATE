+        seed_count = int(np.count_nonzero(interior == SEED_COLOR))
+        assert 1 <= seed_count <= 4
+
+        frames.append(
+            {
+                "r0": int(r0),
+                "c0": int(c0),
+                "r1": int(r1),
+                "c1": int(c1),
+                "height": int(height),
+                "width": int(width),
+                "color": int(color),
+                "seed_count": int(seed_count),
+            }
+        )
