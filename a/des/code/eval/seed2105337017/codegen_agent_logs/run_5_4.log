+    if seed_count == 1:
+        return base
+    if seed_count == 2:
+        return np.flipud(base)
+    if seed_count == 3:
+        rotated = np.rot90(base, -1)
+        return _centered_clip(rotated, (height, width), bg)
+    if seed_count == 4:
