+
+
+def _gen_attempt() -> np.ndarray | None:
+    bg = int(NON_SEED_COLORS[_randint(0, len(NON_SEED_COLORS))])
+    specs = _build_spec_list(bg)
+    grid_h = _randint(*GRID_H_RANGE)
+    grid_w = _randint(*GRID_W_RANGE)
