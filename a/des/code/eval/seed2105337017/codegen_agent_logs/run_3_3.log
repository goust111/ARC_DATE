+        cur = path[idx]
+        nxt = path[idx + 1]
+        d_prev = (cur[0] - prev[0], cur[1] - prev[1])
+        d_next = (nxt[0] - cur[0], nxt[1] - cur[1])
+        if d_prev == d_next:
+            continue
+        turn = _cross(d_prev, d_next)
+        assert turn in (-1, 1), "turns must be 90 degrees"
+        mr = cur[0] + d_prev[0] - d_next[0]
+        mc = cur[1] + d_prev[1] - d_next[1]
