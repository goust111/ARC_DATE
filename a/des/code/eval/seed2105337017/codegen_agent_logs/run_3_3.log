+        prev = path[idx - 1]
+        cur = path[idx]
+        nxt = path[idx + 1]
+        d_prev = (cur[0] - prev[0], cur[1] - prev[1])
+        d_next = (nxt[0] - cur[0], nxt[1] - cur[1])
