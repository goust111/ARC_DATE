+    turn_ids = _turn_indices(path)
+    marker_colors = list(rng.sample(MARKER_POOL, len(turn_ids)))
+    for idx, color in zip(turn_ids, marker_colors, strict=False):
+        prev = path[idx - 1]
+        cur = path[idx]
