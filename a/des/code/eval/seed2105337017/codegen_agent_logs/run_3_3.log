+BG = 0
+BLUE = 1
+RED = 2
+PATH = 5
+MARKER_POOL = (3, 4, 6, 7, 8, 9)
+DIRS4 = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+MAX_GEN_ATTEMPTS = 300
