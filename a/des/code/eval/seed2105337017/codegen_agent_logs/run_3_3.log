+    for idx in range(bends):
+        anchors.append((turn_rows[idx], col_sequence[idx]))
+        anchors.append((turn_rows[idx], col_sequence[idx + 1]))
+    anchors.append((height - 1, col_sequence[-1]))
+
+    path: list[tuple[int, int]] = []
