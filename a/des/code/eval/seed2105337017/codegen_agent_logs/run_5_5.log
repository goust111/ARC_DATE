+def partition_rectangle(rect_h: int, rect_w: int, piece_count: int, tries: int = 300) -> list[tuple[tuple[int, int], ...]] | None:
+    cells = [(int(r), int(c)) for r in range(rect_h) for c in range(rect_w)]
