from collections import Counter
import hashlib
import numpy as np

RNG = np.random.default_rng(0)

NEI4 = [(-1,0),(1,0),(0,-1),(0,1)]


def get_bg(g):
    vals, counts = np.unique(g, return_counts=True)
    return int(vals[np.argmax(counts)])


def components_of_color(g, color):
    H,W = g.shape
    seen = np.zeros((H,W), dtype=bool)
    comps = []
    for r in range(H):
        for c in range(W):
            if seen[r,c] or int(g[r,c]) "'!= int(color):
                continue
            stack=[(r,c)]
            seen[r,c]=True
            cells=[]
            while stack:
                rr,cc=stack.pop()
                cells.append((rr,cc))
                for dr,dc in NEI4:
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<H and 0<=nc<W and not seen[nr,nc] and int(g[nr,nc])==int(color):
                        seen[nr,nc]=True
                        stack.append((nr,nc))
            comps.append(cells)
    return comps


def normalize(cells):
    r0=min(r for r,c in cells)
    c0=min(c for r,c in cells)
    return tuple(sorted((r-r0,c-c0) for r,c in cells))


def shape_dims(shape):
    return max(r for r,c in shape)+1, max(c for r,c in shape)+1


def count_tilings(shapes,h,w,limit=2):
    counts = Counter(tuple(shape) for shape in shapes)
    uniq = list(counts)
    placements=[]
    for shape in uniq:
        ph,pw = shape_dims(shape)
        cur=[]
        if ph>h or pw>w:
            return 0
        for dr in range(h-ph+1):
            for dc in range(w-pw+1):
                mask=0
                for r,c in shape:
                    mask |= 1<<((r+dr)*w+(c+dc))
                cur.append(mask)
        placements.append(cur)
    full = (1<<(h*w))-1
    init = tuple(counts[s] for s in uniq)
    memo={}
    def dfs(used, state):
        key=(used,state)
        if key in memo:
            return memo[key]
        if used == full:
            return 1
        idx = 0
        while (used>>idx)&1:
            idx += 1
        bit = 1<<idx
        total = 0
        state_list = list(state)
        for i,cnt in enumerate(state):
            if cnt == 0:
                continue
            state_list[i] -= 1
            next_state = tuple(state_list)
            state_list[i] += 1
            for mask in placements[i]:
                if not (mask & bit):
                    continue
                if mask & used:
                    continue
                total += dfs(used | mask, next_state)
                if total >= limit:
                    memo[key] = limit
                    return limit
        memo[key] = total
        return total
    return dfs(0, init)


def find_rect_dims(shapes):
    area = sum(len(shape) for shape in shapes)
    valid=[]
    for h in range(1, area+1):
        if area % h:
            continue
        w = area // h
        if count_tilings(shapes, h, w, limit=1) > 0:
            valid.append((h,w))
    return valid


def infer_group_rectangle(shapes):
    valid = find_rect_dims(shapes)
    if len(valid) != 1:
        raise ValueError(valid)
    return valid[0]


def main(grid):
    g=np.asarray(grid,dtype=int)
    bg=get_bg(g)
    groups=[]
    first_pos={}
    for r in range(g.shape[0]):
        for c in range(g.shape[1]):
            color=int(g[r,c])
            if color == bg or color in first_pos:
                continue
            first_pos[color]=(r,c)
    for color in [int(v) for v in np.unique(g) if int(v)!=bg]:
        comps=components_of_color(g,color)
        shapes=[normalize(comp) for comp in comps]
        h,w=infer_group_rectangle(shapes)
        groups.append({"color":color,"h":h,"w":w,"area":h*w,"first":first_pos[color]})
    groups.sort(key=lambda x:(-x['"'area'],-x['h'],-x['w'],x['first'][0],x['first'][1]))
    out_h = sum(g['h'] for g in groups) + max(0, len(groups)-1)
    out_w = max(g['w'] for g in groups)
    out=np.full((out_h,out_w), bg, dtype=int)
    r=0
    for i,grp in enumerate(groups):
        out[r:r+grp['h'], :grp['w']] = grp['color']
        r += grp['h']
        if i "'!= len(groups)-1:
            r += 1
    return out


def partition_rect(h,w,k,tries=300):
    cells=[(r,c) for r in range(h) for c in range(w)]
    for _ in range(tries):
        seed_idx = RNG.choice(len(cells), size=k, replace=False)
        pieces=[{cells[int(i)]} for i in seed_idx]
        owners={cells[int(i)]:j for j,i in enumerate(seed_idx)}
        front=[set() for _ in range(k)]
        def push_neighbors(cell,j):
            r,c=cell
            for dr,dc in NEI4:
                nr,nc=r+dr,c+dc
                nb=(nr,nc)
                if 0<=nr<h and 0<=nc<w and nb not in owners:
                    front[j].add(nb)
        for j in range(k):
            push_neighbors(cells[int(seed_idx[j])], j)
        ok=True
        while len(owners) < len(cells):
            choices=[j for j in range(k) if len(pieces[j])<6 and front[j]]
            if not choices:
                ok=False
                break
            weights=np.array([7-len(pieces[j]) for j in choices],dtype=float)
            weights /= weights.sum()
            j=int(RNG.choice(choices, p=weights))
            frontier=list(front[j])
            cell=frontier[int(RNG.integers(len(frontier)))]
            owners[cell]=j
            pieces[j].add(cell)
            for fj in front:
                fj.discard(cell)
            push_neighbors(cell,j)
        if ok and all(1<=len(p)<=6 for p in pieces):
            return [normalize(piece) for piece in pieces]
    return None


def make_group(used_areas, tries=400):
    candidates=[]
    for h in range(1,7):
        for w in range(1,7):
            area=h*w
            if area < 4 or area > 18 or area in used_areas:
                continue
            feasible=[k for k in range(2,5) if k <= area <= 6*k]
            if feasible:
                candidates.append((h,w,feasible))
    RNG.shuffle(candidates)
    for h,w,feasible in candidates:
        for _ in range(tries):
            k=int(RNG.choice(feasible))
            pieces=partition_rect(h,w,k)
            if not pieces:
                continue
            valid=find_rect_dims(pieces)
            if valid == [(h,w)]:
                return {"h":h,"w":w,"pieces":pieces,"area":h*w}
    return None


def can_place(shape, r0, c0, occ):
    H,W=occ.shape
    for r,c in shape:
        rr=r0+r; cc=c0+c
        if occ[rr,cc]:
            return False
        if occ[max(0,rr-1):min(H,rr+2), max(0,cc-1):min(W,cc+2)].any():
            return False
    return True


def scatter(groups, bg):
    fragments=[]
    for grp in groups:
        for shape in grp['"'pieces']:
            fragments.append((grp['color'], shape))
    fragments.sort(key=lambda x:(-(shape_dims(x[1])[0]*shape_dims(x[1])[1]), -len(x[1])))
    total=sum(len(s) for _,s in fragments)
    min_side=max(15, int(np.ceil(np.sqrt(total*7))))
    for _ in range(200):
        H=int(RNG.integers(min_side, min(31, min_side+8)))
        W=int(RNG.integers(min_side, min(31, min_side+8)))
        occ=np.zeros((H,W),dtype=bool)
        grid=np.full((H,W), bg, dtype=int)
        ok=True
        for color,shape in fragments:
            ph,pw=shape_dims(shape)
            r_start=1 if H-ph>=3 else 0
            c_start=1 if W-pw>=3 else 0
            r_end=H-ph-(1 if H-ph>=3 else 0)
            c_end=W-pw-(1 if W-pw>=3 else 0)
            positions=[(r,c) for r in range(r_start, r_end+1) for c in range(c_start, c_end+1)]
            RNG.shuffle(positions)
            placed=False
            for r0,c0 in positions:
                if can_place(shape,r0,c0,occ):
                    for r,c in shape:
                        rr=r0+r; cc=c0+c
                        occ[rr,cc]=True
                        grid[rr,cc]=color
                    placed=True
                    break
            if not placed:
                ok=False
                break
        if ok and (grid==bg).sum() > total:
            return grid
    return None


def generate_input():
    colors=list(range(10))
    for _ in range(300):
        num_groups=int(RNG.integers(2,5))
        bg=int(RNG.integers(10))
        palette=[c for c in colors if c"'!=bg]
        RNG.shuffle(palette)
        used_areas=set()
        groups=[]
        ok=True
        for gi in range(num_groups):
            grp=make_group(used_areas)
            if grp is None:
                ok=False; break
            grp['"'color']=palette[gi]
            used_areas.add(grp['area'])
            groups.append(grp)
        if not ok:
            continue
        grid=scatter(groups,bg)
        if grid is None:
            continue
        out=main(grid)
        expected=sorted([(g['area'],g['h'],g['w'],g['color']) for g in groups], reverse=True)
        found=[]
        row=0
        for i in range(len(groups)):
            while row < out.shape[0] and np.all(out[row]==bg):
                row+=1
            if row >= out.shape[0]:
                ok=False; break
            color=int(out[row,0])
            h=0
            while row+h < out.shape[0] and out[row+h,0] == color:
                h+=1
            w=int((out[row]"'!=bg).sum())
            found.append((h*w,h,w,color))
            row += h+1
        if not ok:
            continue
        return grid
    raise RuntimeError

sigs=set()
for i in range(50):
    inp=generate_input()
    out=main(inp)
    sigs.add(hashlib.md5(inp.tobytes()+str(inp.shape).encode()).hexdigest())
    assert isinstance(inp,np.ndarray)
    assert isinstance(out,np.ndarray)
print('"'variants',len(sigs))
print('sample in', inp.shape, 'out', out.shape)
