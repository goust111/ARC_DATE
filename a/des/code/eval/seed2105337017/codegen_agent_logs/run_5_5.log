from collections import Counter
import numpy as np

rng = np.random.default_rng(0)

def normalize(cells):
    rs = [r for r,c in cells]
    cs = [c for r,c in cells]
    r0,c0=min(rs),min(cs)
    return tuple(sorted((r-r0,c-c0) for r,c in cells))

def shape_dims(shape):
    return max(r for r,c in shape)+1, max(c for r,c in shape)+1

def count_tilings(shapes,h,w,limit=3):
    shapes = [tuple(shape) for shape in shapes]
    counts = Counter(shapes)
    uniq = list(counts)
    placements = []
    for shape in uniq:
        ph,pw=shape_dims(shape)
        cur=[]
        for dr in range(h-ph+1):
            for dc in range(w-pw+1):
                mask=0
                for r,c in shape:
                    idx=(r+dr)*w+(c+dc)
                    mask |= 1<<idx
                cur.append(mask)
        placements.append(cur)
    full=(1<<(h*w))-1
    init=tuple(counts[s] for s in uniq)
    memo={}
    def dfs(used,state):
        key=(used,state)
        if key in memo:
            return memo[key]
        if used == full:
            return 1
        first=0
        while used>>first & 1:
            first+=1
        bit=1<<first
        total=0
        lst=list(state)
        for i,cnt in enumerate(state):
            if cnt==0:
                continue
            lst[i]-=1
            nstate=tuple(lst)
            lst[i]+=1
            for mask in placements[i]:
                if not (mask & bit):
                    continue
                if mask & used:
                    continue
                total += dfs(used|mask,nstate)
                if total >= limit:
                    memo[key]=limit
                    return limit
        memo[key]=total
        return total
    return dfs(0,init)

def valid_dims(shapes):
    n=sum(len(s) for s in shapes)
    out=[]
    for h in range(1,n+1):
        if n%h:
            continue
        w=n//h
        if count_tilings(shapes,h,w,limit=1) > 0:
            out.append((h,w))
    return out

def partition_rect(h,w,k,tries=200):
    cells=[(r,c) for r in range(h) for c in range(w)]
    for _ in range(tries):
        seeds=rng.choice(len(cells), size=k, replace=False)
        owners={cells[i]:j for j,i in enumerate(seeds)}
        pieces=[{cells[i]} for i in seeds]
        front=[set() for _ in range(k)]
        def add_front(cell,j):
            r,c=cell
            for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                nb=(r+dr,c+dc)
                if 0<=nb[0]<h and 0<=nb[1]<w and nb not in owners:
                    front[j].add(nb)
        for j in range(k):
            add_front(cells[seeds[j]],j)
        success=True
        while len(owners)<len(cells):
            cand=[j for j in range(k) if len(pieces[j])<6 and front[j]]
            if not cand:
                success=False
                break
            sizes=np.array([len(pieces[j]) for j in cand],dtype=float)
            weights=(7-sizes)
            weights=weights/weights.sum()
            j=int(rng.choice(cand,p=weights))
            frontier=list(front[j])
            cell=frontier[int(rng.integers(len(frontier)))]
            owners[cell]=j
            pieces[j].add(cell)
            for fj in front:
                fj.discard(cell)
            add_front(cell,j)
        if success and all(1<=len(p)<=6 for p in pieces):
            return [normalize(list(p)) for p in pieces]
    return None

for _ in range(20):
    k=int(rng.integers(2,5))
    area=int(rng.integers(max(4,k+1), min(6*k,18)+1))
    dims=[(h, area//h) for h in range(1, area+1) if area%h==0 and max(h,area//h)<=6]
    if not dims:
        continue
    h,w=dims[int(rng.integers(len(dims)))]
    parts=partition_rect(h,w,k)
    if not parts:
        continue
    vd=valid_dims(parts)
    print((h,w), [len(p) for p in parts], vd)
