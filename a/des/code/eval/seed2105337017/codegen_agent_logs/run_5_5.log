from collections import Counter
import numpy as np
RNG = np.random.default_rng(3)
NEI4=[(-1,0),(1,0),(0,-1),(0,1)]

def get_bg(g):
    vals, counts = np.unique(g, return_counts=True)
    return int(vals[np.argmax(counts)])

def components_of_color(g, color):
    H,W=g.shape; seen=np.zeros((H,W),bool); out=[]
    for r in range(H):
        for c in range(W):
            if seen[r,c] or g[r,c]"'!=color: continue
            stack=[(r,c)]; seen[r,c]=True; cells=[]
            while stack:
                rr,cc=stack.pop(); cells.append((rr,cc))
                for dr,dc in NEI4:
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<H and 0<=nc<W and not seen[nr,nc] and g[nr,nc]==color:
                        seen[nr,nc]=True; stack.append((nr,nc))
            out.append(cells)
    return out

def normalize(cells):
    r0=min(r for r,c in cells); c0=min(c for r,c in cells)
    return tuple(sorted((r-r0,c-c0) for r,c in cells))

def shape_dims(shape): return max(r for r,c in shape)+1, max(c for r,c in shape)+1

def count_tilings(shapes,h,w,limit=2):
    counts=Counter(tuple(s) for s in shapes); uniq=list(counts); placements=[]
    for shape in uniq:
        ph,pw=shape_dims(shape)
        if ph>h or pw>w: return 0
        cur=[]
        for dr in range(h-ph+1):
            for dc in range(w-pw+1):
                mask=0
                for r,c in shape: mask|=1<<((r+dr)*w+(c+dc))
                cur.append(mask)
        placements.append(cur)
    full=(1<<(h*w))-1; init=tuple(counts[s] for s in uniq); memo={}
    def dfs(used,state):
        key=(used,state)
        if key in memo: return memo[key]
        if used==full: return 1
        idx=0
        while used>>idx &1: idx+=1
        bit=1<<idx; total=0; lst=list(state)
        for i,cnt in enumerate(state):
            if not cnt: continue
            lst[i]-=1; nstate=tuple(lst); lst[i]+=1
            for mask in placements[i]:
                if mask&used or not(mask&bit): continue
                total += dfs(used|mask,nstate)
                if total>=limit: memo[key]=limit; return limit
        memo[key]=total; return total
    return dfs(0,init)

def find_rect_dims(shapes):
    area=sum(len(s) for s in shapes)
    return [(h,area//h) for h in range(1,area+1) if area%h==0 and count_tilings(shapes,h,area//h,1)>0]

def partition_rect(h,w,k,tries=300):
    cells=[(r,c) for r in range(h) for c in range(w)]
    for _ in range(tries):
        idxs=RNG.choice(len(cells),size=k,replace=False)
        pieces=[{cells[int(i)]} for i in idxs]
        owners={cells[int(i)]:j for j,i in enumerate(idxs)}
        front=[set() for _ in range(k)]
        def add(cell,j):
            r,c=cell
            for dr,dc in NEI4:
                nr,nc=r+dr,c+dc
                nb=(nr,nc)
                if 0<=nr<h and 0<=nc<w and nb not in owners: front[j].add(nb)
        for j in range(k): add(cells[int(idxs[j])],j)
        ok=True
        while len(owners)<len(cells):
            cand=[j for j in range(k) if len(pieces[j])<6 and front[j]]
            if not cand: ok=False; break
            weights=np.array([7-len(pieces[j]) for j in cand],float); weights/=weights.sum()
            j=int(RNG.choice(cand,p=weights)); cell=list(front[j])[int(RNG.integers(len(front[j])))]
            owners[cell]=j; pieces[j].add(cell)
            for fj in front: fj.discard(cell)
            add(cell,j)
