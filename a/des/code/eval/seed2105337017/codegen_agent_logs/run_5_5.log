def can_place(shape,r0,c0,occ):
    H,W=occ.shape
    for r,c in shape:
        rr,cc=r0+r,c0+c
        if occ[rr,cc]: return False
        if occ[max(0,rr-1):min(H,rr+2),max(0,cc-1):min(W,cc+2)].any(): return False
    return True

