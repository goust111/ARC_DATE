+PANEL_WIDTH_RANGE = (11, 14)
+GRID_HEIGHT_RANGE = (18, 26)
+COLOR_COUNT_CHOICES = (3, 4)
+LEFT_ARM_RANGE = (1, 3)
+RIGHT_ARM_RANGE = (1, 2)
