    25	    fg_colors = [int(color) for color in np.unique(g) if int(color) != bg]
    26	    assert len(fg_colors) == 1
    27	
    28	    fg = g != bg
    29	    out = g.copy()
    30	    height, width = g.shape
    31	    groups = {"nw_se": [], "ne_sw": []}
