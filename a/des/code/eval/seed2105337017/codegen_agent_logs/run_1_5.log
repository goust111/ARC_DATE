+        return None
+
+    left_arm_max = 2 if panel_w <= 12 else LEFT_ARM_RANGE[1]
+    left_arms = [random.randint(LEFT_ARM_RANGE[0], left_arm_max) for _ in left_pairs]
+    right_arms = [random.randint(*RIGHT_ARM_RANGE) for _ in right_pairs]
+
