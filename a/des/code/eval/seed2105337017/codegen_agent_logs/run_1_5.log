+
+def _draw_cross(
+    panel: np.ndarray,
+    center_r: int,
+    center_c: int,
+    arm: int,
+    main_diag_color: int,
+    anti_diag_color: int,
+    center_color: int,
+) -> None:
+    for d in range(-arm, arm + 1):
+        panel[center_r + d, center_c + d] = main_diag_color
+        panel[center_r + d, center_c - d] = anti_diag_color
+    panel[center_r, center_c] = center_color
