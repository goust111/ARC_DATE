+    grid_w: int,
+    pad: int,
+) -> tuple[int, int] | None:
+    candidates = [
+        (r, c)
+        for r in range(grid_h - h + 1)
+        for c in range(grid_w - w + 1)
+        if _can_place_rect(r, c, h, w, reserved, grid_h, grid_w, pad)
+    ]
+    if not candidates:
+        return None
+    return candidates[int(_RNG.integers(len(candidates)))]
