+    used = {int(patch[r, c]) for r, c in np.argwhere(mask)}
+    if len(used) < 2:
+        coords = np.argwhere(mask)
+        patch[coords[0, 0], coords[0, 1]] = int(colors[0])
+        patch[coords[-1, 0], coords[-1, 1]] = int(colors[1])
+    return patch
