+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in _NEIGHBORS8:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
