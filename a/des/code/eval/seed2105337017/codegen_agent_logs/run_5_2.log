+def _stamp_patch(grid: np.ndarray, patch: np.ndarray, pos: tuple[int, int], mask: np.ndarray | None = None) -> None:
+    r0, c0 = pos
+    h, w = patch.shape
+    if mask is None:
+        grid[r0 : r0 + h, c0 : c0 + w] = patch
+        return
+    rr, cc = np.argwhere(mask).T
+    grid[r0 + rr, c0 + cc] = patch[rr, cc]
