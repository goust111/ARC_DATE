+    rel = coords - np.array([r0, c0], dtype=int)
+    mask = np.zeros((h, w), dtype=bool)
+    mask[rel[:, 0], rel[:, 1]] = True
+    colors = sorted({int(grid[r, c]) for r, c in coords})
+    return {
+        "coords_abs": coords,
+        "coords_rel": rel,
+        "bbox": (r0, c0, r1, c1),
+        "mask": mask,
+        "colors": colors,
+        "color": colors[0],
