+def _random_walk_profile(length: int, low: int, high: int, start: int) -> np.ndarray:
+    prof = np.empty(length, dtype=int)
+    prof[0] = start
+    for i in range(1, length):
+        opts = [v for v in (prof[i - 1] - 1, prof[i - 1], prof[i - 1] + 1) if low <= v <= high]
