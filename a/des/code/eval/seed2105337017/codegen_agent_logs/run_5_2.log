+) -> bool:
+    r1, c1 = r0 + h - 1, c0 + w - 1
+    if r0 < 0 or c0 < 0 or r1 >= grid_h or c1 >= grid_w:
+        return False
+    for rr0, cc0, rr1, cc1 in reserved:
+        if not (r1 + pad < rr0 or rr1 + pad < r0 or c1 + pad < cc0 or cc1 + pad < c0):
