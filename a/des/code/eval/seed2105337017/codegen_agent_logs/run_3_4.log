+            assert isinstance(pattern, list)
+            success = False
+            for _ in range(4):
+                arrow = int(pattern[int(state["index"])])
+                state["index"] = (int(state["index"]) + 1) % 4
+                dr, dc = ARROW_TO_DELTA[arrow]
+                r, c = state["pos"]
+                nr = int(r) + dr
+                nc = int(c) + dc
+                if not (0 <= nr < h and 0 <= nc < w):
+                    stats["blocked_boundary"] += 1
