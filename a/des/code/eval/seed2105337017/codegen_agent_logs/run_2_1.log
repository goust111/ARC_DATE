+def _legend_patch(template: np.ndarray, legend_color: int, seed_color: int) -> np.ndarray:
+    h, w = template.shape
+    patch = np.zeros((h + 4, w + 4), dtype=int)
+    patch[0, :] = legend_color
+    patch[-1, :] = legend_color
+    patch[:, 0] = legend_color
+    patch[:, -1] = legend_color
+    patch[2 : 2 + h, 2 : 2 + w][template] = seed_color
+    return patch
