+def _corner_offset(quadrant: str, box_h: int, box_w: int, shape_h: int, shape_w: int) -> tuple[int, int]:
+    top = 0 if quadrant in ("TL", "TR") else box_h - shape_h
+    left = 0 if quadrant in ("TL", "BL") else box_w - shape_w
