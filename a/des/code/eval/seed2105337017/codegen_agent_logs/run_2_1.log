+            depth = rng.randint(1, max(1, min(h - 1, h // 3 + 1)))
+            length = rng.randint(1, w - 1)
+            start = rng.randint(0, w - length)
+            rows = slice(0, depth) if side == "top" else slice(h - depth, h)
+            cand[rows, start : start + length] = False
+        else:
+            if h < 3:
