+
+
+def _seed_quadrant(seed_r: int, seed_c: int, r0: int, c0: int, r1: int, c1: int) -> str:
+    top = 2 * (seed_r - r0) < (r1 - r0)
+    left = 2 * (seed_c - c0) < (c1 - c0)
