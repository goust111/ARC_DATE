+    grid = np.full((rows, cols), BG, dtype=int)
+    occupied = np.zeros((rows, cols), dtype=bool)
+    for patch in patches:
+        locations = _candidate_locations(occupied, patch.shape, PLACEMENT_PAD)
+        if not locations:
