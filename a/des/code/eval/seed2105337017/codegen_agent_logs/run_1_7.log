+def _boundary_bg(grid: np.ndarray) -> int:
+    boundary = np.concatenate((grid[0, :], grid[-1, :], grid[:, 0], grid[:, -1]))
+    return int(Counter(map(int, boundary)).most_common(1)[0][0])
+
