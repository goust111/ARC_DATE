+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _components(mask: np.ndarray):
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            queue = deque([(r, c)])
+            pts = []
+            while queue:
+                cr, cc = queue.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(points):
+    rows = [p[0] for p in points]
+    cols = [p[1] for p in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _is_solid_rect(grid: np.ndarray, color: int, box):
+    r0, c0, r1, c1 = box
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    return np.all(patch == color)
+
+
+def _is_grey_ring(grid: np.ndarray, box):
+    r0, c0, r1, c1 = box
+    return (
+        np.all(grid[r0, c0 : c1 + 1] == GREY)
+        and np.all(grid[r1, c0 : c1 + 1] == GREY)
+        and np.all(grid[r0 : r1 + 1, c0] == GREY)
+        and np.all(grid[r0 : r1 + 1, c1] == GREY)
+    )
+
+
+def _find_containers(grid: np.ndarray):
+    h, w = grid.shape
+    containers = []
+    seen_outer = set()
+
+    def try_add(color: int, pts):
+        box = _bbox(pts)
+        r0, c0, r1, c1 = box
+        if r0 == 0 or c0 == 0 or r1 == h - 1 or c1 == w - 1:
+            return
