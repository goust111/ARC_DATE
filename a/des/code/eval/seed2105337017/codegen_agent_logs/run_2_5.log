+import random
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+
+SOURCE_COLORS = (RED, BLUE, YELLOW)
+MIX_COLORS = {
+    frozenset((RED, BLUE)): MAGENTA,
+    frozenset((RED, YELLOW)): ORANGE,
+    frozenset((BLUE, YELLOW)): GREEN,
+}
