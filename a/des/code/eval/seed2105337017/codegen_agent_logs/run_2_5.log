+    out[r0 : r1 + 1, c0 : c1 + 1] = color
+
+
+def _combine_colors(colors):
+    if not colors:
+        return None
+    unique = set(colors)
+    if len(unique) == 1:
+        return colors[0]
+    if len(unique) != 2:
+        raise AssertionError("unsupported number of incoming colors")
+    key = frozenset(unique)
+    if key not in MIX_COLORS:
