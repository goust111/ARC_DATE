+        r = rng.randint(r0 + 1, r1 - 1)
+        return (r, c1), (r, c1 + 1)
+    raise ValueError(side)
+
+
+def _line_cells(a, b):
+    (r0, c0), (r1, c1) = a, b
+    if r0 == r1:
