+
+def _pick_wall_cell(container, side: str, rng: random.Random):
+    r0, c0, r1, c1 = container["outer"]
+    if side == "top":
+        c = rng.randint(c0 + 1, c1 - 1)
+        return (r0, c), (r0 - 1, c)
+    if side == "bottom":
