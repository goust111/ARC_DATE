+    patch[thickness : h - thickness, thickness : w - thickness] = BG
+
+    if hole_count > 1:
+        base_mask = patch == int(color)
+        eligible = _eligible_hole_cells(base_mask)
+        chosen = _pick_isolated_cells(eligible, hole_count - 1)
