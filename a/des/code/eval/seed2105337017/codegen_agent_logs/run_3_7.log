+            cols = [cc for _, cc in cells]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            comps.append(
+                {
+                    "id": comp_id,
+                    "color": color,
+                    "cells": cells,
+                    "bbox": (r0, c0, r1, c1),
+                    "area": len(cells),
