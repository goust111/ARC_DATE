+def _stamp(out: np.ndarray, center_r: int, center_c: int, template: np.ndarray) -> None:
+    th, tw = template.shape
+    anchor_r = th // 2
+    anchor_c = tw // 2
+    for rr, cc in np.argwhere(template != BLACK):
+        tr = center_r + int(rr) - anchor_r
+        tc = center_c + int(cc) - anchor_c
