+    for point in set_a:
+        reflected = _reflect_point(point, axis_name, param)
+        if reflected != point and reflected not in set_b:
+            return False
+    for point in set_b:
+        reflected = _reflect_point(point, axis_name, param)
+        if reflected != point and reflected not in set_a:
