+        c0 += w
+        if idx != len(specs) - 1:
+            c0 += 1
+    return out
+
+
+def _valid_input(grid: np.ndarray, expected: np.ndarray) -> bool:
+    colors = [int(color) for color in np.unique(grid) if int(color) != BG]
+    if not colors:
