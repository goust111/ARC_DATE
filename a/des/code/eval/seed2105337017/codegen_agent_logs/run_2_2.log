+    if axis_name == "horizontal":
+        return param - r, c
+    if axis_name == "diag":
+        return c + param, r - param
+    return param - c, param - r
+
+
+def _symmetry_axes(
+    points: frozenset[tuple[int, int]] | set[tuple[int, int]]
+) -> list[tuple[str, int]]:
