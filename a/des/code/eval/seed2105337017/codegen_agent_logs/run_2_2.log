+        abs_coords = coords + np.array([r0, c0], dtype=int)
+        if np.any(grid[abs_coords[:, 0], abs_coords[:, 1]] != BG):
+            continue
+        grid[abs_coords[:, 0], abs_coords[:, 1]] = color
