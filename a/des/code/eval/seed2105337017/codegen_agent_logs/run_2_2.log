{
  "type": "move_in_order",
  "src": "monochromatic foreground objects using 8-connectivity, grouped by color",
  "dst": "bottom-aligned histogram columns in fixed palette order: grey, red, teal, maroon, pink",
  "transform": "count the 8-connected objects of each palette color and fill that many cells upward from the bottom of its column",
  "grid_shape": "height is the largest color object count; width is five palette columns"
}
</annotation>
</reference_puzzle>

