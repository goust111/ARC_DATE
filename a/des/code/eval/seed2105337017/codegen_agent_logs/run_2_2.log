+    out_h = max(item[1] for item in specs)
+    out_w = sum(item[2] for item in specs) + len(specs) - 1
+    out = np.full((out_h, out_w), BG, dtype=int)
+    c0 = 0
+    for idx, (_area, h, w, _mask_key, patch) in enumerate(specs):
+        out[:h, c0 : c0 + w] = patch
+        c0 += w
+        if idx != len(specs) - 1:
+            c0 += 1
+    return out
