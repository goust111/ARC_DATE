+    if not pts:
+        return False
+    stack = [next(iter(pts))]
+    seen = {stack[0]}
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in _NEIGHBORS8:
+            nxt = (r + dr, c + dc)
+            if nxt in pts and nxt not in seen:
+                seen.add(nxt)
+                stack.append(nxt)
+    return len(seen) == len(pts)
