+    total_bbox_area = sum(spec["frag_a"].size + spec["frag_b"].size for spec in pair_specs)
+    max_h = max(
+        max(spec["frag_a"].shape[0], spec["frag_b"].shape[0], spec["merged_patch"].shape[0]) for spec in pair_specs
