     9	def main(grid: np.ndarray) -> np.ndarray:
    10	    """Repack each non-background color group as a solid square ordered by increasing size.
    11	
    12	    Input structure
    13	    The grid has one dominant background color, and each other color has a
    14	    perfect-square pixel count. Those square side lengths are unique.
    15	
    16	    Rule
    17	    Convert every non-background color into a filled square whose side length is
    18	    the square root of its pixel count. Place the squares from left to right in
    19	    increasing side length, bottom-aligned, with one background column between
    20	    neighboring squares.
    21	
    22	    Key insight
    23	    The original geometry of each color is discarded; only the color's total
    24	    pixel count determines the size of its packed output square.
    25	    """
    26	    g = np.asarray(grid, dtype=int)
    27	    bg = get_bg(g)
    28	
    29	    specs: list[tuple[int, int]] = []
    30	    for color in colors_present(g, exclude={bg}):
    31	        count = int(np.count_nonzero(g == color))
    32	        side = math.isqrt(count)
    33	        assert side * side == count
    34	        specs.append((color, side))
    35	
    36	    assert specs
    37	    sides = [side for _color, side in specs]
    38	    assert len(set(sides)) == len(sides)
    39	
    40	    ordered = sorted(specs, key=lambda item: item[1])
    41	    height = max(side for _color, side in ordered)
    42	    width = sum(side for _color, side in ordered) + len(ordered) - 1
    43	    out = np.full((height, width), bg, dtype=int)
    44	
    45	    col = 0
    46	    for i, (color, side) in enumerate(ordered):
    47	        out[height - side : height, col : col + side] = color
    48	        col += side
    49	        if i != len(ordered) - 1:
    50	            col += 1
    51	
    52	    assert col == width
    53	    return out
