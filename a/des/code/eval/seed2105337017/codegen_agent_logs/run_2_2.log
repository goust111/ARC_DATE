+        comp_a = _grow_connected(valid, target_size, preferred, rng)
+        if comp_a is None or not any(c == half_w - 1 for _, c in comp_a):
+            continue
+        comp_b = frozenset((r, 2 * half_w - 1 - c) for r, c in comp_a)
+        if _validate_local_pair(comp_a, comp_b, "vertical"):
+            return comp_a, comp_b
+    return None
+
+
+def _make_horizontal_pair(rng: np.random.Generator) -> tuple[frozenset[tuple[int, int]], frozenset[tuple[int, int]]] | None:
+    for _ in range(_PAIR_RETRIES):
+        half_h = int(rng.integers(2, 5))
+        w = int(rng.integers(3, 7))
+        max_cells = half_h * w
+        target_max = min(max_cells - 1, 9)
