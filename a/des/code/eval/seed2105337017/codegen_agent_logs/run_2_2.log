+    r0, c0, r1, c1 = _bbox(pts)
+    axes: list[tuple[str, int]] = []
+
+    c_sum = c0 + c1
+    if all((r, c_sum - c) in pts for r, c in pts):
+        axes.append(("vertical", c_sum))
+
+    r_sum = r0 + r1
+    if all((r_sum - r, c) in pts for r, c in pts):
+        axes.append(("horizontal", r_sum))
