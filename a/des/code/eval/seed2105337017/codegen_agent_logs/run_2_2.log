+
+# --------------- generator ---------------
+
+_PAIR_RETRIES = 80
+_PLACE_RETRIES = 200
+_GEN_RETRIES = 400
+
+
+def _grow_connected(
+    valid: set[tuple[int, int]],
+    target_size: int,
+    preferred_starts: list[tuple[int, int]],
+    rng: np.random.Generator,
+) -> frozenset[tuple[int, int]] | None:
+    starts = [pt for pt in preferred_starts if pt in valid]
+    if not starts:
