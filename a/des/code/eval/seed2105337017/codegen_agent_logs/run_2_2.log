+    sums = [r + c for r, c in pts]
+    axis_sum = min(sums) + max(sums)
+    if axis_sum % 2 == 0:
+        b = axis_sum // 2
+        if all((b - c, b - r) in pts for r, c in pts):
+            axes.append(("anti", b))
