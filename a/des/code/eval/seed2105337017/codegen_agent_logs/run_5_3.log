+            is_valid_move = True
+        elif invalid:
+            pool = invalid
+            is_valid_move = False
+        else:
+            return None
+
+        min_count = min(counts[color] for color in pool)
+        least_used = [color for color in pool if counts[color] == min_count]
+        unused = [color for color in least_used if counts[color] == 0]
+        color = random.choice(unused or least_used)
