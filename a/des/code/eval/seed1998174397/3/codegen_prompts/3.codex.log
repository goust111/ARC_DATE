+    if bridge_directions != {"horizontal", "vertical"}:
+        return None
+
+    grid = np.full((h, w), BG, dtype=int)
+    _render_legend(grid, orientation, legend_colors)
+    _render_paths(grid, paths)
+
+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
