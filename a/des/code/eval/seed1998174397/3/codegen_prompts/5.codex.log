+    head = (rows < head_h) & (np.abs(cols - mid) <= rows + tip_extra)
+    stem = (rows >= head_h) & (np.abs(cols - mid) <= stem_half)
+    foot = (rows == size - 1) & (np.abs(cols - mid) <= foot_half)
