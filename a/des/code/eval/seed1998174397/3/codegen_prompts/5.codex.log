+def _draw_fence(size: int, gap_dir: str, marker_count: int, rng: random.Random) -> np.ndarray:
+    patch = np.full((size + 2, size + 2), BG, dtype=int)
+    patch[0, :] = GREY
+    patch[-1, :] = GREY
+    patch[:, 0] = GREY
+    patch[:, -1] = GREY
+
