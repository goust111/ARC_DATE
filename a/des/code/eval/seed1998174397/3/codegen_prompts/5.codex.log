+    if gap_dir == "up":
+        patch[0, gap_idx] = BG
+    elif gap_dir == "down":
+        patch[-1, gap_idx] = BG
+    elif gap_dir == "left":
+        patch[gap_idx, 0] = BG
+    elif gap_dir == "right":
+        patch[gap_idx, -1] = BG
