+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+GREY = 5
+MAROON = 9
+
+TEMPLATE_COLOR_POOL = [1, 3, 4, 6, 7, 8]
+DIRECTIONS = ("up", "right", "down", "left")
+ROTATION_K = {"up": 0, "right": 3, "down": 2, "left": 1}
