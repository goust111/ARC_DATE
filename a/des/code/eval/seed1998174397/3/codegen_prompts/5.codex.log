+def _library_patch(templates: list[np.ndarray]) -> np.ndarray:
+    size = int(templates[0].shape[0])
+    patch = np.full((size + 2, 4 * size + 5), BG, dtype=int)
+    patch[0, :] = MAROON
+    patch[-1, :] = MAROON
+    for k in range(5):
+        c = k * (size + 1)
+        patch[:, c] = MAROON
+    for i, tmpl in enumerate(templates):
+        c0 = 1 + i * (size + 1)
+        patch[1:-1, c0 : c0 + size] = tmpl
+    return patch
+
