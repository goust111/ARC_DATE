0098: def main(grid: np.ndarray) -> np.ndarray:
0099:     """
0100:     Replicate a pre-drawn corner pattern to every other marker-bearing corner.
0101: 
0102:     Input structure:
0103:     - bg = most frequent color. Hollow 0-frames (possibly partial L-shapes); each
0104:       frame-corner cell is either 0 or a painted (non-bg, non-0) color.
0105:     - >= 1 'source' corner: the pattern is already drawn (one color, both outward
0106:       cells and an inward-diagonal trail).
0107:     - Other corners: a single colored pixel on the inward diagonal at the pattern's
0108:       deepest (k,k) offset; the pixel's color is that corner's target color.
0109: 
0110:     Rule:
0111:     - Extract the canonical (TL-oriented) pattern from any source.
0112:     - For each non-source corner whose marker cell is colored, paint the same
0113:       pattern rotated to that corner's orientation, using the marker's color.
0114: 
0115:     Key insight: the pattern is symmetric about the corner's inward-diagonal axis
0116:     (canonical dr == dc), so it reflects cleanly across all four corner orientations.
0117:     Painting uses each target's OWN marker color, not the source color.
0118:     """
0119:     g = np.asarray(grid, dtype=int)
0120:     H, W = g.shape
0121:     bg = int(get_bg(g))
0122: 
