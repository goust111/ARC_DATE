+                max(0, top - CONTAINER_PAD),
+                max(0, left - CONTAINER_PAD),
+                min(grid.shape[0] - 1, bottom + CONTAINER_PAD),
+                min(grid.shape[1] - 1, right + CONTAINER_PAD),
+            )
