+def _find_legend_patterns(grid: np.ndarray, bg: int) -> dict[int, np.ndarray]:
+    mapping: dict[int, np.ndarray] = {}
+    for coords in _components(grid != bg):
+        r0, c0, r1, c1 = _bbox(coords)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
