+        if not (pattern[:, 1:] != pattern[:, :-1]).any():
+            continue
+        if not (pattern[1:, :] != pattern[:-1, :]).any():
+            continue
+        signature = (size, *map(int, pattern.flatten()))
+        if signature in used:
+            continue
+        used.add(signature)
+        return pattern
