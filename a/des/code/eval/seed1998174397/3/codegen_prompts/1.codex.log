+def _tile_pattern(pattern: np.ndarray, height: int, width: int) -> np.ndarray:
+    rows = np.arange(height)[:, None] % pattern.shape[0]
+    cols = np.arange(width)[None, :] % pattern.shape[1]
+    return pattern[rows, cols]
