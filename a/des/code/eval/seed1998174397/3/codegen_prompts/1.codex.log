+        label_color = int(first_col[int(label_rows[0])])
+        assert label_color not in mapping, "legend labels must be unique"
+        mapping[label_color] = pattern.copy()
+
+    assert mapping, "expected legend entries with label and pattern"
+    return mapping
+
