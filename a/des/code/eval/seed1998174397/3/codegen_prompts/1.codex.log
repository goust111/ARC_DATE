+def _random_pattern(size: int, color_pool: list[int], used: set[tuple[int, ...]]) -> np.ndarray | None:
+    options = [count for count in PATTERN_COLOR_COUNT_OPTIONS if count <= min(3, len(color_pool))]
+    if not options:
