+def _sample_inner_size(pattern_size: int) -> tuple[int, int]:
+    for _ in range(50):
+        h = random.randint(*CONTAINER_INNER_RANGE)
+        w = random.randint(*CONTAINER_INNER_RANGE)
+        if random.random() < 0.5 and h % pattern_size == 0 and w % pattern_size == 0:
+            continue
+        return h, w
