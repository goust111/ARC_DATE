+BG = 0
+GEN_ATTEMPTS = 400
+PAIR_ATTEMPTS = 150
+PAIR_COUNT_RANGE = (2, 4)
+GRID_H_RANGE = (18, 26)
+GRID_W_RANGE = (20, 30)
+RECT_H_RANGE = (3, 7)
+RECT_W_RANGE = (4, 7)
+BOX_PAD = 1
