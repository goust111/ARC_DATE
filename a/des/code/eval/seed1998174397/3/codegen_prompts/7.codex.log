        patch = out[r0 : r1 + 1, c0 : c1 + 1]
        patch[cavity["mask"]] = match["body_color"]

    return out


def _random_path(mask: np.ndarray, start: tuple[int, int], end: tuple[int, int], rng: random.Random) -> None:
    r, c = start
    tr, tc = end
    mask[r, c] = True
    while (r, c) != (tr, tc):
        choices = []
        if r < tr:
            choices.append((1, 0))
        elif r > tr:
            choices.append((-1, 0))
        if c < tc:
            choices.append((0, 1))
        elif c > tc:
            choices.append((0, -1))
        dr, dc = rng.choice(choices)
        r += dr
        c += dc
        mask[r, c] = True


def _random_shape(rng: random.Random) -> np.ndarray | None:
    for _ in range(MASK_RETRIES):
        h = rng.randint(3, 6)
        w = rng.randint(3, 6)
