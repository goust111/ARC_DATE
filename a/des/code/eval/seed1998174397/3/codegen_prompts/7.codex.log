21: def main(grid: np.ndarray) -> np.ndarray:
22:     """Expand each sparse color object into a filled rectangular region using its legend-paired fill color.
23: 
24:     Input structure
25:     A background-color grid has a two-column legend in columns 0 and 1, starting at row 0: each row gives
26:     a source color in the left column and that source color's fill color in the right column.  Outside the
27:     legend, the foreground pixels are sparse dot objects whose colors are exactly the legend source colors.
28: 
29:     Rule
30:     Clear the legend.  For each source color, take the bbox of all of its non-legend dots, expand that bbox
31:     by one pixel in every direction, and fill background cells inside the expanded rectangle with the paired
32:     legend fill color while preserving every original non-legend dot.
33: 
34:     Key insight
35:     The legend order is also the layer order: earlier legend rows are in front, so fill rectangles are painted
36:     from the last legend row back to the first and higher-priority fills overwrite lower-priority fills.
37:     """
38:     g = np.asarray(grid, dtype=int)
39:     bg = get_bg(g)
40:     H, W = g.shape
41:     assert W >= 2, "expected room for a two-column legend"
42: 
43:     pairs = _legend_pairs(g, bg)
44:     source_colors = {source for source, _fill in pairs}
45:     assert len(source_colors) == len(pairs), "legend source colors must be unique"
46: 
47:     legend_mask = np.zeros(g.shape, dtype=bool)
48:     legend_mask[: len(pairs), :2] = True
49:     dot_mask = (g != bg) & ~legend_mask
50:     assert dot_mask.any(), "expected source dots outside the legend"
51:     assert set(map(int, g[dot_mask])).issubset(source_colors), "outside dots must use legend source colors"
52: 
53:     dots_by_color: dict[int, np.ndarray] = {}
54:     all_dots = np.zeros(g.shape, dtype=bool)
55:     for source, _fill in pairs:
56:         coords = np.argwhere(dot_mask & (g == source))
57:         assert coords.size, "each legend source color must appear outside the legend"
58:         dots_by_color[source] = coords
59:         all_dots[coords[:, 0], coords[:, 1]] = True
60: 
61:     out = np.full_like(g, bg)
62:     for source, fill in reversed(pairs):
63:         r0, c0, r1, c1 = bbox_coords(dots_by_color[source])
64:         r0 = max(0, r0 - 1)
65:         c0 = max(0, c0 - 1)
66:         r1 = min(H - 1, r1 + 1)
67:         c1 = min(W - 1, c1 + 1)
68: 
69:         region = out[r0 : r1 + 1, c0 : c1 + 1]
70:         background_inside_region = ~all_dots[r0 : r1 + 1, c0 : c1 + 1]
71:         region[background_inside_region] = fill
72: 
73:     out[all_dots] = g[all_dots]
74:     return out
