7: def main(grid: np.ndarray) -> np.ndarray:
8:     """
9:     Turn a 4-cell-wide strip of 2x2 blocks into four nested corner-fill patterns.
10: 
11:     Input structure
12:     The input is an even-sized rectangle whose shorter dimension is four pixels.
13:     It can be partitioned exactly into 2x2 blocks, giving one block for each layer
14:     of the output quadrants.
15: 
16:     Rule
17:     Read the 2x2 blocks in reverse row-major order: bottom-right block first,
18:     moving left, then moving upward. For each block, send its top-left,
19:     top-right, bottom-left, and bottom-right pixels to the layer sequences of the
20:     upper-left, upper-right, lower-left, and lower-right output quadrants.
21: 
22:     Key insight
23:     Each input 2x2 block supplies the four colors for one concentric layer, and
24:     the layer order is the block order from bottom-right back to top-left.
25:     """
26:     g = np.asarray(grid, dtype=int)
27:     h, w = g.shape
28:     assert h % 2 == 0 and w % 2 == 0, "input must split into 2x2 blocks"
29:     assert min(h, w) == 4, "input must have one dimension of four pixels"
30: 
31:     n = max(h, w)
32:     blocks = []
33:     for br in range(h // 2 - 1, -1, -1):
34:         for bc in range(w // 2 - 1, -1, -1):
35:             block = g[2 * br : 2 * br + 2, 2 * bc : 2 * bc + 2]
36:             blocks.append(block.reshape(4))
37: 
38:     layers = np.asarray(blocks, dtype=int)
39:     assert layers.shape == (n, 4), "expected one 2x2 block per output layer"
40:     ul_seq, ur_seq, ll_seq, lr_seq = (layers[:, i] for i in range(4))
41: 
42:     out = np.empty((2 * n, 2 * n), dtype=int)
43:     for r in range(n):
44:         for c in range(n):
45:             out[r, c] = ul_seq[min(r, c)]
46:             out[r, n + c] = ur_seq[min(r, n - 1 - c)]
47:             out[n + r, c] = ll_seq[min(n - 1 - r, c)]
48:             out[n + r, n + c] = lr_seq[min(n - 1 - r, n - 1 - c)]
49: 
50:     return out
