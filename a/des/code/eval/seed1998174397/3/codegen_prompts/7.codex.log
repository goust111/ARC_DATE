+def _placement_masks(local: np.ndarray, shape: tuple[int, int], rect_h: int, rect_w: int) -> list[int]:
+    part_h, part_w = shape
+    base = [int(r) * rect_w + int(c) for r, c in local]
+    masks: list[int] = []
+    for dr in range(rect_h - part_h + 1):
