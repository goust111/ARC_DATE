+def _find_hint_mask(grid: np.ndarray, bg: int) -> np.ndarray:
+    h, w = grid.shape
+    counts = {int(color): int(np.count_nonzero(grid == color)) for color in np.unique(grid)}
+    candidates: list[tuple[int, int]] = []
+    for r in range(h - 1):
+        for c in range(w - 1):
+            sub = grid[r : r + 2, c : c + 2]
+            a = int(sub[0, 0])
+            b = int(sub[0, 1])
+            c1 = int(sub[1, 0])
+            d = int(sub[1, 1])
+            if a == bg or b == bg:
