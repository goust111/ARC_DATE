+        return True
+
+    return False
+
+
+def _gen_attempt() -> np.ndarray | None:
+    grid_h = random.randint(*GRID_H_RANGE)
+    grid_w = random.randint(*GRID_W_RANGE)
+    pair_count = random.randint(*PAIR_COUNT_RANGE)
+
+    available = list(range(1, 10))
