+                "marker_color": marker_colors[idx],
+                "body_color": body_colors[idx],
+                "hole_mask": hole_mask,
+                "hole_marker": _rotate_pos(base_mask.shape, base_marker, hole_rot),
+                "frag_mask": frag_mask,
