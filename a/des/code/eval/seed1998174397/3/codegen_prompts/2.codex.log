+        mask = np.zeros((h, w), dtype=bool)
+        targets = [
+            (0, rng.randrange(w)),
+            (h - 1, rng.randrange(w)),
+            (rng.randrange(h), 0),
+            (rng.randrange(h), w - 1),
+        ]
+        for target in targets:
