+def _rotate_pos(shape: tuple[int, int], pos: tuple[int, int], k: int) -> tuple[int, int]:
+    marker = np.zeros(shape, dtype=int)
+    marker[pos] = 1
+    rr, cc = np.argwhere(np.rot90(marker, k) == 1)[0]
+    return int(rr), int(cc)
