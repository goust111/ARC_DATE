+    hole_box_area = sum((spec["hole_mask"].shape[0] + 2) * (spec["hole_mask"].shape[1] + 2) for spec in specs)
+    frag_box_area = sum((spec["frag_mask"].shape[0] + 2) * (spec["frag_mask"].shape[1] + 2) for spec in specs)
