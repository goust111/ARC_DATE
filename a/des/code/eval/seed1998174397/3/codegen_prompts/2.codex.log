+
+    inp = target.copy()
+    for spec in specs:
+        hr, hc = spec["hole_pos"]
+        patch = inp[tr0 + hr : tr0 + hr + spec["hole_mask"].shape[0], tc0 + hc : tc0 + hc + spec["hole_mask"].shape[1]]
