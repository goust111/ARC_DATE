+        choices = []
+        if r < tr:
+            choices.append((1, 0))
+        elif r > tr:
+            choices.append((-1, 0))
+        if c < tc:
+            choices.append((0, 1))
+        elif c > tc:
+            choices.append((0, -1))
+        dr, dc = rng.choice(choices)
+        r += dr
+        c += dc
+        mask[r, c] = True
