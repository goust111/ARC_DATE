+
+    occ = np.zeros((H, W), dtype=bool)
+    occ[max(0, tr0 - 1) : min(H, tr0 + th + 1), max(0, tc0 - 1) : min(W, tc0 + tw + 1)] = True
+    frag_order = sorted(range(n_parts), key=lambda i: specs[i]["frag_mask"].shape[0] * specs[i]["frag_mask"].shape[1], reverse=True)
