+def _band_runs(values: np.ndarray) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    start = 0
+    while start < len(values):
+        color = int(values[start])
+        end = start + 1
+        while end < len(values) and int(values[end]) == color:
