    col_extent = int(c1 - c0 + 1)
    if row_extent >= col_extent:
        ordered = sorted(coords_list)
    else:
        ordered = sorted(coords_list, key=lambda rc: (rc[1], rc[0]))

    out = g.copy()
    for i, (r, c) in enumerate(ordered):
        out[r, c] = _CYCLE[i % len(_CYCLE)]

    return out

