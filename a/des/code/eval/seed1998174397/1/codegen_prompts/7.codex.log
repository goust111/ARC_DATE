+BG_COLOR = 4
+SHADOW_COLOR = 5
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+DIR8 = (
+    (-1, -1),
+    (-1, 0),
+    (-1, 1),
+    (0, -1),
+    (0, 1),
+    (1, -1),
