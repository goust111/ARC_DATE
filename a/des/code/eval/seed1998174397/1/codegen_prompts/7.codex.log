+                    "color": int(color),
+                    "coords": tuple(sorted(coords)),
+                    "coord_set": frozenset(coords),
+                    "shape": _normalize(coords),
+                    "area": int(len(coords)),
+                    "anchor": (int(anchor[0]), int(anchor[1])),
