+    padded = np.pad(mask, 1, constant_values=False)
+    out = np.zeros((h, w), dtype=bool)
+    for dr in range(3):
+        for dc in range(3):
+            out |= padded[dr : dr + h, dc : dc + w]
+    return out
+
+
+def _random_transform(mask: np.ndarray, rng: random.Random) -> np.ndarray:
