import random
from collections import Counter, deque
import hashlib
import numpy as np

BLACK = 0
GREY = 5
PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
GEN_RETRIES = 400
REGION_RETRIES = 200
PLACEMENT_RETRIES = 200


def neighbors4(r, c):
    yield r - 1, c
    yield r + 1, c
    yield r, c - 1
    yield r, c + 1


def components(mask: np.ndarray):
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    comps = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            pts = []
            while q:
                cr, cc = q.popleft()
                pts.append((cr, cc))
                for nr, nc in neighbors4(cr, cc):
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            comps.append(pts)
    return comps


def dilate8(mask: np.ndarray) -> np.ndarray:
    h, w = mask.shape
    padded = np.pad(mask, 1, constant_values=False)
    out = np.zeros((h, w), dtype=bool)
    for dr in range(3):
        for dc in range(3):
            out |= padded[dr : dr + h, dc : dc + w]
    return out


def crop_mask(mask: np.ndarray) -> np.ndarray:
    coords = np.argwhere(mask)
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()


def random_transform(mask: np.ndarray, rng: random.Random) -> np.ndarray:
    transformed = np.rot90(mask, rng.randrange(4))
    if rng.random() < 0.5:
        transformed = np.fliplr(transformed)
    if rng.random() < 0.5:
        transformed = np.flipud(transformed)
    return transformed.copy()


def connected(mask):
    comps = components(mask)
    return len(comps) == 1


def make_rect_shape(rng):
    h = rng.randint(3, 7)
    w = rng.randint(3, 7)
    return np.ones((h, w), dtype=bool)


def make_carved_shape(rng):
    h = rng.randint(4, 8)
    w = rng.randint(4, 8)
    for _ in range(80):
        mask = np.ones((h, w), dtype=bool)
        for _ in range(rng.randint(1, 3)):
            side = rng.choice([\"top\", \"bottom\", \"left\", \"right\"])
            if side in {\"top\", \"bottom\"}:
                notch_w = rng.randint(1, max(1, w - 1))
                start = rng.randint(0, w - notch_w)
                depth = rng.randint(1, max(1, h - 2))
                rows = slice(0, depth) if side == \"top\" else slice(h - depth, h)
                mask[rows, start : start + notch_w] = False
            else:
                notch_h = rng.randint(1, max(1, h - 1))
                start = rng.randint(0, h - notch_h)
                depth = rng.randint(1, max(1, w - 2))
                cols = slice(0, depth) if side == \"left\" else slice(w - depth, w)
                mask[start : start + notch_h, cols] = False
        if mask.sum() >= 6 and connected(mask):
            return crop_mask(mask)
    return make_rect_shape(rng)


def make_poly_shape(rng):
    h = rng.randint(4, 8)
    w = rng.randint(4, 8)
    target = rng.randint(max(6, (h * w) // 3), max(6, h * w - 2))
    mask = np.zeros((h, w), dtype=bool)
    start = (rng.randrange(h), rng.randrange(w))
    mask[start] = True
    frontier = set()
    for nr, nc in neighbors4(*start):
        if 0 <= nr < h and 0 <= nc < w:
            frontier.add((nr, nc))
    while mask.sum() < target and frontier:
        frontier_list = list(frontier)
        weights = []
        for r, c in frontier_list:
            adj = sum(1 for nr, nc in neighbors4(r, c) if 0 <= nr < h and 0 <= nc < w and mask[nr, nc])
            edge_bonus = 1 if 0 < r < h - 1 and 0 < c < w - 1 else 0
            weights.append(adj * 3 + edge_bonus + 1)
        choice = rng.choices(frontier_list, weights=weights, k=1)[0]
        frontier.remove(choice)
        mask[choice] = True
        for nr, nc in neighbors4(*choice):
            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
                frontier.add((nr, nc))
    for _ in range(2):
        to_add = []
        for r in range(h):
            for c in range(w):
                if mask[r, c]:
                    continue
                adj = sum(1 for nr, nc in neighbors4(r, c) if 0 <= nr < h and 0 <= nc < w and mask[nr, nc])
                if adj >= 3 or (adj == 2 and rng.random() < 0.35):
                    to_add.append((r, c))
        for pt in to_add:
            mask[pt] = True
    if mask.sum() < 6 or not connected(mask):
        return make_carved_shape(rng)
    return crop_mask(mask)


def make_shape(rng):
    style = rng.choice([\"rect\", \"carved\", \"poly\"])
    if style == \"rect\":
        mask = make_rect_shape(rng)
    elif style == \"carved\":
        mask = make_carved_shape(rng)
    else:
        mask = make_poly_shape(rng)
    return random_transform(mask, rng)


def sample_vote_positions(interior, rng, used_majorities):
    area = int(interior.sum())
    num_colors = rng.choice([2, 3])
    available_majorities = [c for c in PALETTE if c not in used_majorities]
    if not available_majorities:
        available_majorities = PALETTE[:]
    majority = rng.choice(available_majorities)
    others = [c for c in PALETTE if c "'!= majority]
    colors = [majority] + rng.sample(others, num_colors - 1)
    total_votes = rng.randint(num_colors + 1, max(num_colors + 1, area - 1))
    majority_count = rng.randint((total_votes // 2) + 1, total_votes - (num_colors - 1))
    remaining = total_votes - majority_count
    counts = [majority_count]
    for i in range(num_colors - 1):
        slots_left = num_colors - 1 - i
        max_take = remaining - (slots_left - 1)
        take = rng.randint(1, max_take)
        counts.append(take)
        remaining -= take
    if remaining:
        counts[-1] += remaining
    if max(counts[1:], default=0) >= counts[0]:
        return None
    cells = [tuple(pt) for pt in np.argwhere(interior)]
    rng.shuffle(cells)
    votes = {}
    idx = 0
    for color, count in zip(colors, counts):
        for _ in range(count):
            votes[cells[idx]] = color
            idx += 1
    return majority, votes


def make_region(rng, used_majorities):
    for _ in range(REGION_RETRIES):
        interior = make_shape(rng)
        area = int(interior.sum())
        if area < 6:
            continue
        padded = np.pad(interior, 1, constant_values=False)
        boundary = dilate8(padded) & ~padded
        if not boundary.any():
            continue
        sampled = sample_vote_positions(padded, rng, used_majorities)
        if sampled is None:
            continue
        majority, votes = sampled
        patch = np.zeros(padded.shape, dtype=int)
        patch[boundary] = GREY
        for (r, c), color in votes.items():
            patch[r, c] = color
        return {
            "patch": patch,
            "area": int(padded.sum()),
            "majority": majority,
            "shape": padded,
        }
    raise RuntimeError('"'region gen failed')


def place_regions(rng, regions):
    max_h = max(region['patch'].shape[0] for region in regions)
    max_w = max(region['patch'].shape[1] for region in regions)
    n = len(regions)
    size_floor_h = max(16, max_h + 4, 4 * n + 6)
    size_floor_w = max(16, max_w + 4, 4 * n + 6)
    H = rng.randint(size_floor_h, min(32, size_floor_h + 8))
    W = rng.randint(size_floor_w, min(32, size_floor_w + 8))
    grid = np.zeros((H, W), dtype=int)
    blocked = np.zeros((H, W), dtype=bool)
    order = regions[:]
    rng.shuffle(order)
    placements = []
    for region in order:
        patch = region['patch']
        ph, pw = patch.shape
        for _ in range(PLACEMENT_RETRIES):
            r0 = rng.randint(0, H - ph)
            c0 = rng.randint(0, W - pw)
            rr0 = max(0, r0 - 1)
            cc0 = max(0, c0 - 1)
            rr1 = min(H, r0 + ph + 1)
            cc1 = min(W, c0 + pw + 1)
            if blocked[rr0:rr1, cc0:cc1].any():
                continue
            grid[r0 : r0 + ph, c0 : c0 + pw][patch "'!= 0] = patch[patch != 0]
            blocked[r0 : r0 + ph, c0 : c0 + pw] = True
            placements.append((r0, c0, region))
            break
        else:
            return None
    return grid, placements


def generate_input():
    rng = random.Random()
    for _ in range(GEN_RETRIES):
        n = rng.randint(2, 5)
        regions = []
        used_areas = set()
        used_majorities = set()
        ok = True
        for _ in range(n):
            for _ in range(REGION_RETRIES):
                region = make_region(rng, used_majorities)
                if region['"'area'] in used_areas:
                    continue
                used_areas.add(region['area'])
                used_majorities.add(region['majority'])
                regions.append(region)
                break
            else:
                ok = False
                break
        if not ok:
            continue
        placed = place_regions(rng, regions)
        if placed is None:
            continue
        grid, _ = placed
        return grid
    raise RuntimeError('gen failed')


def main(grid):
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    comps = components(g "'!= GREY)
    regions = []
    for comp in comps:
        if any(r in (0, h - 1) or c in (0, w - 1) for r, c in comp):
            continue
        colors = [int(g[r, c]) for r, c in comp if int(g[r, c]) != BLACK]
        if not colors:
            continue
        neighbor_colors = set()
        for r, c in comp:
            for nr, nc in neighbors4(r, c):
                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in comp:
                    neighbor_colors.add(int(g[nr, nc]))
        if GREY not in neighbor_colors:
            continue
        majority = Counter(colors).most_common(1)[0][0]
        regions.append((len(comp), majority))
    if not regions:
        raise ValueError('"'no enclosed regions found')
    areas = [a for a, _ in regions]
    if len(set(areas)) "'!= len(areas):
        raise ValueError('"'ambiguous area ordering')
    regions.sort(key=lambda item: item[0], reverse=True)
    side = 2 * len(regions) - 1
    out = np.zeros((side, side), dtype=int)
    for layer, (_, color) in enumerate(regions):
        lo = layer
        hi = side - layer
        out[lo:hi, lo] = color
        out[lo:hi, hi - 1] = color
        out[lo, lo:hi] = color
        out[hi - 1, lo:hi] = color
    return out

sigs = set()
for i in range(200):
    inp = generate_input()
    out = main(inp)
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
    assert out.shape[0] == out.shape[1]
    # sanity: output side matches count of enclosed comps
    n = len([1 for comp in components(inp "'!= GREY) if not any(r in (0, inp.shape[0]-1) or c in (0, inp.shape[1]-1) for r,c in comp)])
    assert out.shape == (2*n-1, 2*n-1)
print('"'variants', len(sigs))
print('ok')
