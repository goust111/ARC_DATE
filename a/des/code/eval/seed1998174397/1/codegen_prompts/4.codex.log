+def _sample_votes(
+    interior_mask: np.ndarray, rng: random.Random, used_majorities: set[int]
+) -> tuple[int, dict[tuple[int, int], int]] | None:
+    area = int(interior_mask.sum())
+    num_colors = rng.choice([2, 3])
+    if area < num_colors + 2:
