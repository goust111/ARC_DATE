+    seen: set[int] = set()
+    cur = starts[0]
+    while cur is not None:
+        if cur in seen:
+            raise ValueError("cycle detected in chain reconstruction")
+        seen.add(cur)
+        order.append(cur)
+        cur = succ[cur]
