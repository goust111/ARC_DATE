+    if not pieces:
+        return []
+    knob_dirs = {piece["knob"] for piece in pieces}
+    notch_dirs = {piece["notch"] for piece in pieces}
+    if len(knob_dirs) != 1 or len(notch_dirs) != 1:
+        return None
