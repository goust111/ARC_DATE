+def _forward_key(delta: np.ndarray, direction: str) -> tuple[float, float, float] | None:
+    dr, dc = float(delta[0]), float(delta[1])
+    vr, vc = DIRS[direction]
+    proj = dr * vr + dc * vc
+    if proj <= 0:
+        return None
+    perp = dr * vc - dc * vr
+    dist2 = dr * dr + dc * dc
+    return float(proj), abs(float(perp)), float(dist2)
