+    positions: dict[int, tuple[int, int]] = {order[0]: (0, 0)}
+    for current, nxt in zip(order, order[1:]):
+        dr, dc = DIRS[pieces[current]["knob"]]
+        pr, pc = positions[current]
+        positions[nxt] = (pr + CHAIN_STEP * dr, pc + CHAIN_STEP * dc)
