+    top_margin = int(rng.integers(1, 5))
+    left_margin = int(rng.integers(1, 5))
+    bottom_margin = int(rng.integers(1, 5))
+    right_margin = int(rng.integers(1, 5))
+    extra_h = int(rng.integers(0, 5))
+    extra_w = int(rng.integers(0, 5))
