+    step_dir = pieces[0]["knob"]
+    axis = 1 if step_dir in {"left", "right"} else 0
+    other = 1 - axis
+    reverse = step_dir in {"left", "up"}
+    return sorted(
+        range(len(pieces)),
+        key=lambda idx: (float(pieces[idx]["center"][axis]), float(pieces[idx]["center"][other])),
