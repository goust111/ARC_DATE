+        canvas[6, 3] = True
+    elif notch_dir == "down":
+        canvas[5, 3] = False
+        canvas[0, 3] = True
+    elif notch_dir == "left":
+        canvas[3, 1] = False
+        canvas[3, 6] = True
+    elif notch_dir == "right":
+        canvas[3, 5] = False
+        canvas[3, 0] = True
+    else:
