+    out = g.copy()
+    for frame in frames:
+        marker_color = _marker_color_for_frame(g, frame, bg)
+        frag = _fragment_mask(g, frame, bg)
+        axis = _choose_axis(frag)
+        sym = _mirror_union(frag, axis)
