FRAME_COUNT_RANGE = (3, 5)
FRAME_SIZE_CHOICES = [5, 7]
SMALL_FRAME_GRID_H_RANGE = (20, 27)
SMALL_FRAME_GRID_W_RANGE = (21, 27)
