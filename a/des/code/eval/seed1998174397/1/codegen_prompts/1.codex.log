+def _reserve_ok(reserved: np.ndarray, bbox: tuple[int, int, int, int]) -> bool:
+    h, w = reserved.shape
+    r0, c0, r1, c1 = bbox
+    rr0 = max(0, r0 - 1)
+    cc0 = max(0, c0 - 1)
+    rr1 = min(h - 1, r1 + 1)
+    cc1 = min(w - 1, c1 + 1)
+    return not reserved[rr0 : rr1 + 1, cc0 : cc1 + 1].any()
