+            row_range, col_range = _side_ranges(height, width, frame_h, frame_w, side, marker_size)
+            if len(row_range) == 0 or len(col_range) == 0:
+                continue
+
+            r0 = random.choice(tuple(row_range))
+            c0 = random.choice(tuple(col_range))
+            r1 = r0 + frame_h - 1
