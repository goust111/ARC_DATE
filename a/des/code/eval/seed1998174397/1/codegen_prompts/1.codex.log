+    r0, c0, r1, c1 = frame["bbox"]
+    interior = grid[r0 + 1 : r1, c0 + 1 : c1]
+    mask = (interior != bg) & (interior != int(frame["color"]))
+    assert mask.any(), "frame interior must contain a fragment"
