import numpy as np


def axis_score(mask, axis):
    if axis == 'vertical':
        flipped = np.fliplr(mask)
    else:
        flipped = np.flipud(mask)
    return int(np.count_nonzero(mask & flipped))


def connected(mask):
    pts = list(zip(*np.where(mask)))
    if not pts:
        return False
    seen = {pts[0]}
    stack = [pts[0]]
    H,W = mask.shape
    while stack:
        r,c=stack.pop()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            rr,cc=r+dr,c+dc
            if 0<=rr<H and 0<=cc<W and mask[rr,cc] and (rr,cc) not in seen:
                seen.add((rr,cc)); stack.append((rr,cc))
    return len(seen)==len(pts)


