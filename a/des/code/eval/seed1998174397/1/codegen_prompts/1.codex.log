+def _candidate_bbox(frame_bbox: tuple[int, int, int, int], marker_bbox: tuple[int, int, int, int]) -> tuple[int, int, int, int]:
+    fr0, fc0, fr1, fc1 = frame_bbox
+    mr0, mc0, mr1, mc1 = marker_bbox
