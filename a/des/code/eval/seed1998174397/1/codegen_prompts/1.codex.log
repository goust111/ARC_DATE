+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+# Generator bounds.
+GRID_H_RANGE = (22, 30)
+GRID_W_RANGE = (22, 30)
