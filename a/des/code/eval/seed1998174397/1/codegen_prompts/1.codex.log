+        marker_color = colors[2 * index + 1]
+        placed = False
+
+        for _ in range(FRAME_PLACE_ATTEMPTS):
+            frame_h = random.randint(*FRAME_H_RANGE)
+            frame_w = random.randint(*FRAME_W_RANGE)
+            side = random.choice(["top", "bottom", "left", "right"])
