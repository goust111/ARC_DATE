+def _overlap_len(a0: int, a1: int, b0: int, b1: int) -> int:
+    return max(0, min(a1, b1) - max(a0, b0) + 1)
+
+
+def _marker_color_for_frame(grid: np.ndarray, frame: dict, bg: int) -> int:
+    r0, c0, r1, c1 = frame["bbox"]
+    frame_color = int(frame["color"])
+    candidates: list[int] = []
