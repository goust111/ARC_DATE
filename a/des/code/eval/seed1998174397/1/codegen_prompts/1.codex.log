            full = np.zeros((h,w),dtype=bool)
            full[:, :half_w] |= half
            for r,c in zip(*np.where(half)):
                full[r, w-1-c] = True
            side=random.choice(['left','right'])
            candidates=[]
            for r,c in zip(*np.where(full)):
                for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                    rr,cc=r+dr,c+dc
                    if 0<=rr<h and 0<=cc<w and not full[rr,cc]:
                        if side=='left' and cc < w-1-cc:
                            candidates.append((rr,cc))
                        if side=='right' and cc > w-1-cc:
                            candidates.append((rr,cc))
            random.shuffle(candidates)
