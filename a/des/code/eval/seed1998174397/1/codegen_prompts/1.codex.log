+                options.append((nr, nc))
+        if not options:
+            frontier.remove(cell)
+            continue
+        new_cell = random.choice(options)
+        half[new_cell] = True
+        frontier.add(new_cell)
+        frontier.add(cell)
+        count += 1
+
+    full = np.zeros((height, width), dtype=bool)
+    full[:half_h, :] |= half
+    for r, c in zip(*np.where(half)):
+        full[height - 1 - r, c] = True
+    return full
