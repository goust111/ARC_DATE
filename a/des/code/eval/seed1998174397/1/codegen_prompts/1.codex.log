            full=np.zeros((h,w),dtype=bool)
            full[:half_h,:] |= half
            for r,c in zip(*np.where(half)):
                full[h-1-r,c]=True
            side=random.choice(['top','bottom'])
            candidates=[]
            for r,c in zip(*np.where(full)):
                for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                    rr,cc=r+dr,c+dc
                    if 0<=rr<h and 0<=cc<w and not full[rr,cc]:
                        if side=='top' and rr < h-1-rr:
                            candidates.append((rr,cc))
                        if side=='bottom' and rr > h-1-rr:
                            candidates.append((rr,cc))
            random.shuffle(candidates)
            added=[]; used=set(); extra=random.randint(1,2)
            for cell in candidates:
                if cell not in used:
                    added.append(cell); used.add(cell)
                if len(added)>=extra:
                    break
            if not added:
                continue
            mask=full.copy()
            for cell in added:
                mask[cell]=True
        if not connected(mask):
            continue
        v=axis_score(mask,'vertical')
        hscore=axis_score(mask,'horizontal')
        if axis=='vertical' and v<=hscore:
            continue
        if axis=='horizontal' and hscore<=v:
            continue
        if abs(v-hscore)<2:
            continue
        return mask,v,hscore
    return None

for dims in [(5,5),(5,6),(6,5),(6,6),(7,8),(8,7)]:
    for axis in ['vertical','horizontal']:
        ok=0
