+    segments: list[list[tuple[int, int]]] = []
+    seg_start = 0
+    cur_dir = dirs[0]
+    for edge_idx in range(1, len(dirs)):
+        if dirs[edge_idx] != cur_dir:
+            segments.append(path[seg_start : edge_idx + 1])
+            seg_start = edge_idx + 1
+            cur_dir = dirs[edge_idx]
