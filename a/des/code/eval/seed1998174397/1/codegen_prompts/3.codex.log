+    return segments
+
+
+def _segment_dir(segment: list[tuple[int, int]]) -> tuple[int, int]:
+    assert len(segment) >= 2
+    dr = segment[1][0] - segment[0][0]
+    dc = segment[1][1] - segment[0][1]
