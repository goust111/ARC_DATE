+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
+    if dr != 0 or dc != 0
+)
+
+
+def _dominant_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    for dr, dc in DIRS4:
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            out.append((rr, cc))
+    return out
+
+
+def _components(mask: np.ndarray, connectivity: int) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    if connectivity == 4:
+        steps = DIRS4
+    else:
+        steps = DIRS8
+
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for dr, dc in steps:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _detect_arrows(grid: np.ndarray) -> dict[tuple[int, int], dict[str, object]]:
+    arrows: dict[tuple[int, int], dict[str, object]] = {}
+    for comp in _components(grid == ORANGE, connectivity=8):
+        assert len(comp) == 3, "each arrow must use exactly three orange pixels"
+        rows = [r for r, _ in comp]
+        cols = [c for _, c in comp]
