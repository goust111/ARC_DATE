+    separator = np.full((1, canvas_w), GREY, dtype=int)
+    inp = np.vstack([top, separator, lower])
+    actual = main(inp)
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _generate_case()
+        if grid is not None:
+            return grid
