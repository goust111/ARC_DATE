+        for r, c in cells:
+            for nr, nc in _neighbors4(r, c):
+                if 0 <= nr < TEMPLATE_WORKSPACE and 0 <= nc < TEMPLATE_WORKSPACE and (nr, nc) not in cells:
+                    frontier.add((nr, nc))
