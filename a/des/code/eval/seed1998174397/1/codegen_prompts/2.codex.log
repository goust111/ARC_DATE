+    canvas_h = random.randint(8, 14)
+    if random.random() < 0.65:
+        canvas_w = random.choice([13, 15, 17, 19, 21])
+    else:
+        canvas_w = random.choice([12, 14, 16, 18, 20])
+
+    masks = []
+    for _ in range(n_templates):
+        mask = _random_template_mask()
+        if mask is None:
