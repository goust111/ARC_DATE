+            if cand[1] >= root[1]:
+                continue
+            new_cells = set(cells)
+            new_cells.add(cand)
+            if _valid_template_cells(new_cells, root):
+                mask = _cells_to_mask(new_cells)
+                if mask.shape[0] <= 6 and mask.shape[1] <= 6:
+                    candidates.append(cand)
+        if not candidates:
+            break
+        cells.add(random.choice(candidates))
