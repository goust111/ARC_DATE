+    _ = _root_of_mask(mask)
+    return mask
+
+
+def _balanced_branches(count: int, width: int) -> list[str]:
+    use_center = width % 2 == 1 and count >= 3 and random.random() < 0.7
+    allowed = ["left", "right"] + (["center"] if use_center else [])
+    branches = allowed[:]
