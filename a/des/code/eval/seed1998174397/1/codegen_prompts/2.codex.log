+    leaf_count = 0
+    for cell in cells:
+        deg = sum((nr, nc) in cells for nr, nc in _neighbors4(*cell))
+        if cell == root:
+            if deg != 1:
+                return False
+        elif deg == 1:
+            return False
+        if deg == 1:
+            leaf_count += 1
+    return leaf_count == 1
