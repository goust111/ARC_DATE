+            row_hi = GEN_LOCAL_SIZE - 8 - (1 if kind == "double" else 0)
+            col_lo = 3
+            col_hi = GEN_LOCAL_SIZE - span - 4
+            if row_lo > row_hi or col_lo > col_hi:
