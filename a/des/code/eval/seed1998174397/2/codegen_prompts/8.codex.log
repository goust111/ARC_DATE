+        if c < line["c0"]:
+            dc = line["c0"] - c
+        elif c > line["c1"]:
+            dc = c - line["c1"]
+        return int(dr + dc)
+
+    if line["orientation"] == "h":
+        dr = abs(r - line["axis"])
+        dc = 0
+        if c < line["c0"]:
+            dc = line["c0"] - c
+        elif c > line["c1"]:
+            dc = c - line["c1"]
+        return int(dr + dc)
+
+    dc = abs(c - line["axis"])
+    dr = 0
+    if r < line["r0"]:
+        dr = line["r0"] - r
+    elif r > line["r1"]:
+        dr = r - line["r1"]
+    return int(dr + dc)
