+def _step_two_runs(vals: list[int]) -> list[list[int]]:
+    if not vals:
+        return []
+    runs: list[list[int]] = []
+    cur = [int(vals[0])]
+    for v in vals[1:]:
+        v = int(v)
+        if v - cur[-1] == 2:
+            cur.append(v)
+        else:
+            runs.append(cur)
+            cur = [v]
+    runs.append(cur)
+    return runs
