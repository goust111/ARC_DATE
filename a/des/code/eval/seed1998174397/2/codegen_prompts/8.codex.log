+
+def _paint_nonzero(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
+    sub = dst[r0 : r0 + h, c0 : c0 + w]
+    mask = patch != BG
