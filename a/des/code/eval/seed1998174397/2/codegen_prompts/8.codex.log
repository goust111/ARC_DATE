+            anchor_r = random.randint(row_lo, row_hi)
+            anchor_c = random.randint(col_lo, col_hi)
+        else:
+            row_lo = 3
+            row_hi = GEN_LOCAL_SIZE - span - 4
+            col_lo = 7
+            col_hi = GEN_LOCAL_SIZE - 8 - (1 if kind == "double" else 0)
+            if row_lo > row_hi or col_lo > col_hi:
