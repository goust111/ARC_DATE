+            chosen.append(line)
+
+    lines.extend(chosen)
+    lines.sort(key=lambda line: (line["r0"], line["c0"], line["kind"], line["orientation"]))
+    return lines
+
+
+def _point_line_distance(point: tuple[int, int], line: dict) -> int:
+    r, c = point
+    if line["kind"] == "double":
+        dr = 0
+        dc = 0
+        if r < line["r0"]:
+            dr = line["r0"] - r
+        elif r > line["r1"]:
+            dr = r - line["r1"]
+        if c < line["c0"]:
+            dc = line["c0"] - c
+        elif c > line["c1"]:
+            dc = c - line["c1"]
+        return int(dr + dc)
+
+    if line["orientation"] == "h":
+        dr = abs(r - line["axis"])
+        dc = 0
+        if c < line["c0"]:
+            dc = line["c0"] - c
+        elif c > line["c1"]:
+            dc = c - line["c1"]
+        return int(dr + dc)
