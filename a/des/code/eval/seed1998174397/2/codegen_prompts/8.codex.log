+        line["twoc"] = int(c0 + c1)
+    return line
+
+
+def _extract_lines(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    azure = g == MARKER
+    comps = _components(azure, connectivity=4)
+    lines: list[dict] = []
+    leftover: list[tuple[int, int]] = []
+
+    for comp in comps:
