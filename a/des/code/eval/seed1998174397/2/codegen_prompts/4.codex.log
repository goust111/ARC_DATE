+def _paste_non_bg(dest: np.ndarray, src: np.ndarray, top: int, left: int, bg: int) -> None:
+    h, w = src.shape
+    mask = src != bg
+    window = dest[top : top + h, left : left + w]
+    assert np.all(window[mask] == bg)
