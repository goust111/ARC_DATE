+    out = g.copy()
+    current = motif.copy()
+    for idx, frame in enumerate(frames[1:], start=1):
+        current = np.rot90(current, k=ROT_STEPS[frame_dirs[idx]])
+        top, left = _center_top_left(frame["bbox"], current.shape)
+        _paste_non_bg(out, current, top, left, bg)
+    return out
