+    pad_t = rng.randint(*FINAL_MARGIN_RANGE)
+    pad_b = rng.randint(*FINAL_MARGIN_RANGE)
+    pad_l = rng.randint(*FINAL_MARGIN_RANGE)
+    pad_r = rng.randint(*FINAL_MARGIN_RANGE)
