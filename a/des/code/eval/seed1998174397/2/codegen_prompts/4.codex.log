+SCRATCH_SHAPE = (80, 80)
+FRAME_COUNT_RANGE = (2, 4)
+PATTERN_SIZE_RANGE = (3, 5)
+INNER_PAD_RANGE = (2, 5)
+OUTER_MARGIN_RANGE = (1, 7)
+FINAL_MARGIN_RANGE = (1, 4)
+MAX_SIDE = 30
+MAX_GENERATION_ATTEMPTS = 400
