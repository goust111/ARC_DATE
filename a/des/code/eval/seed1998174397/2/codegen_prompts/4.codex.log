    inner_colors = [color for color in fg_colors if color != frame_color]

    bar_candidates: list[tuple[int, list[int], list[int]]] = []
    for color in inner_colors:
        rows = _full_inner_rows(g, color)
        cols = _full_inner_cols(g, color)
