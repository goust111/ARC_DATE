+
+def _arrow_points(frame_bbox: tuple[int, int, int, int], direction: str, rng: random.Random) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = frame_bbox
+    if direction == "up":
+        col = rng.randint(c0 + 1, c1 - 1)
+        return [(r0 - 1, col), (r0 - 2, col - 1), (r0 - 2, col + 1)]
