+
+def _arrow_shaft(coords: np.ndarray, direction: str) -> tuple[int, int]:
+    if direction == "up":
+        idx = int(np.argmax(coords[:, 0]))
+    elif direction == "down":
+        idx = int(np.argmin(coords[:, 0]))
+    elif direction == "left":
+        idx = int(np.argmax(coords[:, 1]))
+    else:
