+
+    inner_h = int(pattern.shape[0] + rng.randint(*INNER_PAD_RANGE))
+    inner_w = int(pattern.shape[1] + rng.randint(*INNER_PAD_RANGE))
+    frame_h = inner_h + 2
+    frame_w = inner_w + 2
+    sr = SCRATCH_SHAPE[0] // 2 - frame_h // 2
+    sc = SCRATCH_SHAPE[1] // 2 - frame_w // 2
