+def get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _bbox_area(bbox: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = bbox
+    return int((r1 - r0 + 1) * (c1 - c0 + 1))
+
+
+def _contains(outer: tuple[int, int, int, int], inner: tuple[int, int, int, int]) -> bool:
+    or0, oc0, or1, oc1 = outer
+    ir0, ic0, ir1, ic1 = inner
+    return or0 < ir0 and oc0 < ic0 and or1 > ir1 and oc1 > ic1
+
+
+def _color_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for nr in range(max(0, cr - 1), min(h, cr + 2)):
+                    for nc in range(max(0, cc - 1), min(w, cc + 2)):
+                        if nr == cr and nc == cc:
+                            continue
+                        if seen[nr, nc] or int(grid[nr, nc]) != color:
+                            continue
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            coords = np.array(pts, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox_from_coords(coords),
+                    "size": int(len(pts)),
+                }
+            )
+    return comps
+
+
+def _is_frame_component(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 3 or w < 3:
+        return False
+    if int(comp["size"]) != 2 * (h + w) - 4:
+        return False
+    pts = {tuple(map(int, p)) for p in comp["coords"]}
+    for r, c in pts:
+        if r not in (r0, r1) and c not in (c0, c1):
+            return False
+    for c in range(c0, c1 + 1):
+        if (r0, c) not in pts or (r1, c) not in pts:
+            return False
+    for r in range(r0, r1 + 1):
+        if (r, c0) not in pts or (r, c1) not in pts:
+            return False
+    return True
