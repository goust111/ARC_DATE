+    sr, sc = arrow["shaft"]
+    direction = arrow["direction"]
+    if direction == "up":
+        return sr == r0 - 1 and c0 < sc < c1
+    if direction == "down":
+        return sr == r1 + 1 and c0 < sc < c1
+    if direction == "left":
+        return sc == c0 - 1 and r0 < sr < r1
+    return sc == c1 + 1 and r0 < sr < r1
+
