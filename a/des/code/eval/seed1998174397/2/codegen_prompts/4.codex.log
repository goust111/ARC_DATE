+    cc = coords[:, 1] - int(coords[:, 1].min())
+    pts = frozenset((int(r), int(c)) for r, c in zip(rr, cc))
+    patterns = {
+        frozenset({(0, 0), (0, 2), (1, 1)}): "up",
+        frozenset({(0, 1), (1, 0), (1, 2)}): "down",
+        frozenset({(0, 0), (2, 0), (1, 1)}): "left",
+        frozenset({(1, 0), (0, 1), (2, 1)}): "right",
