+    min_c = min(c for _, c in points)
+    norm = sorted((r - min_r, c - min_c) for r, c in points)
+    return [(int(r), int(c)) for r, c in norm]
+
+
+def _shape_array(points: list[tuple[int, int]]) -> np.ndarray:
