+    side = frame["gap_side"]
+    if side == "top":
+        return int(r - frame["r0"])
+    if side == "bottom":
+        return int(frame["r1"] - r)
+    if side == "left":
+        return int(c - frame["c0"])
+    return int(frame["c1"] - c)
+
