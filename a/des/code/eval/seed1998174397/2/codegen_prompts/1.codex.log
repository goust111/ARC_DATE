+        if spec["side"] in ("top", "bottom"):
+            mask = np.flipud(mask)
+        else:
+            mask = np.fliplr(mask)
+        rr, cc = np.nonzero(mask)
+        base_r = spec["frame_top"] + spec["copy_r0"]
+        base_c = spec["frame_left"] + spec["copy_c0"]
+        out[base_r + rr, base_c + cc] = spec["seed_color"]
+    return out
