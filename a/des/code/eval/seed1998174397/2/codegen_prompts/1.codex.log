+def _seed_candidates(ih: int, iw: int, side: str, gap_start: int, gap_end: int, shape_cells: set[tuple[int, int]]):
+    band = 3
+    for r in range(1, ih + 1):
+        for c in range(1, iw + 1):
+            if (r, c) in shape_cells:
