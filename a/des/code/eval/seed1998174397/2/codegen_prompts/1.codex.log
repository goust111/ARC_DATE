+        "seed_c": int(seed_c),
+        "shape_color": int(shape_color),
+        "seed_color": int(seed_color),
+        "gap_start": int(gap_start),
+        "gap_end": int(gap_end),
+        "ih": int(ih),
+        "iw": int(iw),
+        "fh": int(fh),
+        "fw": int(fw),
+        "copy_r0": int(copy_r0),
+        "copy_c0": int(copy_c0),
+        "reserve_r0": int(reserve_r0),
+        "reserve_c0": int(reserve_c0),
+        "reserve_r1": int(reserve_r1),
+        "reserve_c1": int(reserve_c1),
