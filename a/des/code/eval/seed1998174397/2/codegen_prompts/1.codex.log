+def _find_frames(grid: np.ndarray) -> list[dict]:
+    frames: list[dict] = []
+    for comp in _components(grid == FRAME):
+        r0, c0, r1, c1 = _bbox(comp)
+        if r1 - r0 < 3 or c1 - c0 < 3:
