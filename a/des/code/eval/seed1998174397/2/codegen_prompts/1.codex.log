+def _extract_shape_and_seed(grid: np.ndarray, frame: dict):
+    r0, c0, r1, c1 = frame["r0"], frame["c0"], frame["r1"], frame["c1"]
+    sub = grid[r0 + 1 : r1, c0 + 1 : c1]
