+
+def _straight_trunk(
+    hub_r: int, hub_c: int, direction: str, length: int
+) -> tuple[set[tuple[int, int]], tuple[int, int], tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for step in range(1, length + 1):
