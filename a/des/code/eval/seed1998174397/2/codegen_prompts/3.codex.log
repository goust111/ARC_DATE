+        (1, split_c + 1, split_r - 2, w - split_c - 2),
+        (split_r + 1, 1, h - split_r - 2, split_c - 2),
+        (split_r + 1, split_c + 1, h - split_r - 2, w - split_c - 2),
+    ]
+
