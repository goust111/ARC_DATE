+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+AZURE = 8
+MAROON = 9
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+ORTHOGONAL = {
+    "up": ["left", "right"],
+    "down": ["left", "right"],
+    "left": ["up", "down"],
+    "right": ["up", "down"],
+}
+SOURCE_POOL = [BLUE, RED, GREEN, YELLOW, MAGENTA, ORANGE, AZURE, MAROON]
+KNOWN_MIXES = {
+    frozenset((RED, BLUE)): MAGENTA,
+    frozenset((RED, YELLOW)): ORANGE,
+    frozenset((BLUE, YELLOW)): GREEN,
+    frozenset((RED, GREEN)): MAROON,
+    frozenset((BLUE, GREEN)): AZURE,
+}
+KNOWN_PAIRS = [
+    (RED, BLUE),
+    (RED, YELLOW),
+    (BLUE, YELLOW),
+    (RED, GREEN),
+    (BLUE, GREEN),
+]
