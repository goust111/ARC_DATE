+def _reserve(blocked: np.ndarray, cells: list[tuple[int, int]] | set[tuple[int, int]], pad: int = 1) -> None:
+    h, w = blocked.shape
+    for r, c in cells:
+        rr0 = max(0, int(r - pad))
+        rr1 = min(h - 1, int(r + pad))
+        cc0 = max(0, int(c - pad))
+        cc1 = min(w - 1, int(c + pad))
+        blocked[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+
+
+def _can_reserve(
+    blocked: np.ndarray,
+    cells: list[tuple[int, int]] | set[tuple[int, int]],
+    pad: int = 1,
+    allow: set[tuple[int, int]] | None = None,
+) -> bool:
+    allow = allow or set()
+    h, w = blocked.shape
+    for r, c in cells:
+        rr0 = max(0, int(r - pad))
+        rr1 = min(h - 1, int(r + pad))
+        cc0 = max(0, int(c - pad))
+        cc1 = min(w - 1, int(c + pad))
+        for rr in range(rr0, rr1 + 1):
+            for cc in range(cc0, cc1 + 1):
+                if blocked[rr, cc] and (rr, cc) not in allow:
+                    return False
+    return True
+
+
+def _random_shortest_path(
+    start: tuple[int, int],
+    goal: tuple[int, int],
+    blocked: np.ndarray,
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    if blocked[start] or blocked[goal]:
+        return None
+
+    h, w = blocked.shape
+    q = deque([start])
+    parents: dict[tuple[int, int], tuple[int, int] | None] = {start: None}
+    dirs = DIRS[:]
+    rng.shuffle(dirs)
+
+    while q:
+        cur = q.popleft()
+        if cur == goal:
+            break
+        for dr, dc in dirs:
+            nr = int(cur[0] + dr)
+            nc = int(cur[1] + dc)
+            nxt = (nr, nc)
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if blocked[nr, nc] or nxt in parents:
+                continue
+            parents[nxt] = cur
+            q.append(nxt)
+
+    if goal not in parents:
+        return None
+
+    path: list[tuple[int, int]] = []
+    cur: tuple[int, int] | None = goal
+    while cur is not None:
+        path.append(cur)
+        cur = parents[cur]
+    path.reverse()
+    return path
+
+
+def _route_piecewise(
+    points: list[tuple[int, int]],
+    blocked: np.ndarray,
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    temp = blocked.copy()
+    full = [points[0]]
+    temp[points[0]] = False
+    for a, b in zip(points, points[1:]):
+        temp[a] = False
+        temp[b] = False
+        segment = _random_shortest_path(a, b, temp, rng)
