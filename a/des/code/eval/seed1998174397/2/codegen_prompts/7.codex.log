+def _corner_positions(h: int, w: int) -> list[tuple[int, int]]:
+    return [(0, 0), (0, w - 2), (h - 2, 0), (h - 2, w - 2)]
+
+
+def _find_table(grid: np.ndarray) -> tuple[dict[int, int], tuple[int, int]]:
+    h, w = grid.shape
