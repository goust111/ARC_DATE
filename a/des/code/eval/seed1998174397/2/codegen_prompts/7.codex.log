+
+def _reserve(blocked: np.ndarray, cells: list[tuple[int, int]] | set[tuple[int, int]], pad: int = 1) -> None:
+    h, w = blocked.shape
+    for r, c in cells:
+        rr0 = max(0, int(r - pad))
+        rr1 = min(h - 1, int(r + pad))
+        cc0 = max(0, int(c - pad))
+        cc1 = min(w - 1, int(c + pad))
+        blocked[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+
+
+def _can_reserve(
+    blocked: np.ndarray,
+    cells: list[tuple[int, int]] | set[tuple[int, int]],
+    pad: int = 1,
+    allow: set[tuple[int, int]] | None = None,
+) -> bool:
+    allow = allow or set()
+    h, w = blocked.shape
+    for r, c in cells:
+        rr0 = max(0, int(r - pad))
+        rr1 = min(h - 1, int(r + pad))
+        cc0 = max(0, int(c - pad))
+        cc1 = min(w - 1, int(c + pad))
+        for rr in range(rr0, rr1 + 1):
+            for cc in range(cc0, cc1 + 1):
+                if blocked[rr, cc] and (rr, cc) not in allow:
+                    return False
+    return True
+
+
+def _random_shortest_path(
+    start: tuple[int, int],
+    goal: tuple[int, int],
+    blocked: np.ndarray,
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    if blocked[start] or blocked[goal]:
+        return None
+
+    h, w = blocked.shape
+    q = deque([start])
+    parents: dict[tuple[int, int], tuple[int, int] | None] = {start: None}
+    dirs = DIRS[:]
