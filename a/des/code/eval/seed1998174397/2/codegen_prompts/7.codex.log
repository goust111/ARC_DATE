+
+def _random_shortest_path(
+    start: tuple[int, int],
+    goal: tuple[int, int],
+    blocked: np.ndarray,
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    if blocked[start] or blocked[goal]:
+        return None
+
+    h, w = blocked.shape
+    q = deque([start])
+    parents: dict[tuple[int, int], tuple[int, int] | None] = {start: None}
+    dirs = DIRS[:]
+    rng.shuffle(dirs)
+
+    while q:
+        cur = q.popleft()
+        if cur == goal:
+            break
+        for dr, dc in dirs:
+            nr = int(cur[0] + dr)
+            nc = int(cur[1] + dc)
+            nxt = (nr, nc)
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if blocked[nr, nc] or nxt in parents:
+                continue
+            parents[nxt] = cur
+            q.append(nxt)
