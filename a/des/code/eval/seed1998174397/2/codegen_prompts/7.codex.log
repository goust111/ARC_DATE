+
+BG = 0
+PATH = 5
+FILTER = 9
+PALETTE = (1, 2, 3, 4, 6, 7, 8)
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_H_RANGE = (18, 26)
+GRID_W_RANGE = (18, 26)
+PATH_COUNT_CHOICES = (3, 4)
+GEN_RETRIES = 700
+PLACEMENT_TRIES = 180
+WAYPOINT_TRIES = 24
+
+SOURCE_ENDPOINT_OFFSETS = (
+    (0, -1),
+    (1, -1),
+    (0, 2),
+    (1, 2),
+    (-1, 0),
