+    return path
+
+
+def _route_piecewise(
+    points: list[tuple[int, int]],
+    blocked: np.ndarray,
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    temp = blocked.copy()
+    full = [points[0]]
+    temp[points[0]] = False
+    for a, b in zip(points, points[1:]):
+        temp[a] = False
+        temp[b] = False
+        segment = _random_shortest_path(a, b, temp, rng)
+        if segment is None:
