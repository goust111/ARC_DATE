+
+    while q:
+        cur = q.popleft()
+        if cur == goal:
+            break
+        for dr, dc in dirs:
+            nr = int(cur[0] + dr)
+            nc = int(cur[1] + dc)
+            nxt = (nr, nc)
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if blocked[nr, nc] or nxt in parents:
+                continue
+            parents[nxt] = cur
+            q.append(nxt)
