+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREY = 5
+PALETTE_COLORS = (1, 3, 4, 6, 7, 8, 9)
+
+GEN_ATTEMPTS = 300
+SHAPE_ATTEMPTS = 200
+PLACE_ATTEMPTS = 200
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _erode4(mask: np.ndarray) -> np.ndarray:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    out = np.zeros((h, w), dtype=bool)
+    if h < 3 or w < 3:
+        return out
+    out[1:-1, 1:-1] = (
+        mask[1:-1, 1:-1]
+        & mask[:-2, 1:-1]
+        & mask[2:, 1:-1]
+        & mask[1:-1, :-2]
+        & mask[1:-1, 2:]
+    )
+    return out
+
+
+def _find_palette(grid: np.ndarray) -> tuple[int, list[int]]:
+    row = np.asarray(grid[-1], dtype=int)
+    w = row.shape[0]
+    candidates: list[tuple[int, list[int]]] = []
+    start = None
+    for c in range(w + 1):
+        value = int(row[c]) if c < w else BLACK
+        if value != BLACK and start is None:
+            start = c
+        elif value == BLACK and start is not None:
+            colors = row[start:c].tolist()
+            if len(colors) == 5 and len(set(int(x) for x in colors)) == 5:
+                candidates.append((start, [int(x) for x in colors]))
+            start = None
+    assert len(candidates) == 1, "expected exactly one 5-color palette on the bottom row"
+    return candidates[0]
+
+
