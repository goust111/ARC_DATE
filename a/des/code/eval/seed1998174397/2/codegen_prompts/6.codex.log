+            continue
+
+        interior = _erode4(mask)
+        if int(interior.sum()) < red_count + 1:
+            continue
+        if len(_components(interior)) != 1:
+            continue
+
+        boundary = mask & ~interior
+        if len(_components(boundary)) != 1:
+            continue
+        return boundary, interior
+    return None
+
