import random

import numpy as np


BG = 0
GREY = 5
STRIPE_COLORS = tuple(color for color in range(10) if color not in (BG, GREY))

GRID_H_RANGE = (8, 18)
GRID_W_RANGE = (8, 18)
STRIPE_COUNT_MIN = 2
STRIPE_COUNT_MAX = 4
MAX_GENERATION_ATTEMPTS = 300


def _visible_stripe_colors(values: np.ndarray) -> set[int]:
    return {int(value) for value in values if int(value) not in (BG, GREY)}


def _spaced_positions(length: int, count: int) -> list[int]:
    """Sample sorted positions with at least one empty cell between stripes."""
    bases = sorted(random.sample(range(length - count + 1), count))
    return [base + idx for idx, base in enumerate(bases)]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Resolve grey stripe intersections using a checkerboard weaving order.

    Horizontal stripes are numbered from top to bottom, vertical stripes from
    left to right. At a grey crossing, the horizontal color shows when the two
    indices have even sum; otherwise the vertical color shows.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    h, w = g.shape
    horizontal_rows: list[int] = []
    horizontal_colors: list[int] = []
    for r in range(h):
        row = g[r, :]
        visible = _visible_stripe_colors(row)
        if not np.any(row == BG) and len(visible) == 1:
            horizontal_rows.append(r)
            horizontal_colors.append(next(iter(visible)))

    vertical_cols: list[int] = []
    vertical_colors: list[int] = []
    for c in range(w):
        col = g[:, c]
        visible = _visible_stripe_colors(col)
        if not np.any(col == BG) and len(visible) == 1:
            vertical_cols.append(c)
            vertical_colors.append(next(iter(visible)))

    assert horizontal_rows, "expected at least one horizontal stripe"
    assert vertical_cols, "expected at least one vertical stripe"

    out = g.copy()
    for h_idx, (r, h_color) in enumerate(zip(horizontal_rows, horizontal_colors), start=1):
        for v_idx, (c, v_color) in enumerate(zip(vertical_cols, vertical_colors), start=1):
            if out[r, c] != GREY:
                continue
            out[r, c] = h_color if (h_idx + v_idx) % 2 == 0 else v_color

    return out


def _sample_counts(height: int, width: int) -> tuple[int, int] | None:
    h_max = min(STRIPE_COUNT_MAX, (height + 1) // 2, len(STRIPE_COLORS) - STRIPE_COUNT_MIN)
    if h_max < STRIPE_COUNT_MIN:
        return None
    h_count = random.randint(STRIPE_COUNT_MIN, h_max)

    v_max = min(STRIPE_COUNT_MAX, (width + 1) // 2, len(STRIPE_COLORS) - h_count)
    if v_max < STRIPE_COUNT_MIN:
        return None
    v_count = random.randint(STRIPE_COUNT_MIN, v_max)
    return h_count, v_count


def _gen_attempt() -> np.ndarray | None:
    height = random.randint(*GRID_H_RANGE)
    width = random.randint(*GRID_W_RANGE)
    counts = _sample_counts(height, width)
    if counts is None:
        return None

    h_count, v_count = counts
    rows = _spaced_positions(height, h_count)
    cols = _spaced_positions(width, v_count)
    palette = random.sample(STRIPE_COLORS, h_count + v_count)
    row_colors = palette[:h_count]
    col_colors = palette[h_count:]

    grid = np.full((height, width), BG, dtype=int)
    for r, color in zip(rows, row_colors):
        grid[r, :] = color
    for c, color in zip(cols, col_colors):
        grid[:, c] = color
    for r in rows:
        grid[r, cols] = GREY

    out = main(grid)
    assert not np.array_equal(out, grid)
    assert np.all(out[np.ix_(rows, cols)] != GREY)

    horizontal_wins = 0
    vertical_wins = 0
    for h_idx, (r, row_color) in enumerate(zip(rows, row_colors), start=1):
        for v_idx, (c, col_color) in enumerate(zip(cols, col_colors), start=1):
            if (h_idx + v_idx) % 2 == 0:
                assert int(out[r, c]) == row_color
                horizontal_wins += 1
            else:
                assert int(out[r, c]) == col_color
                vertical_wins += 1
    assert horizontal_wins > 0 and vertical_wins > 0

    return grid


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid weaving-stripe input")

