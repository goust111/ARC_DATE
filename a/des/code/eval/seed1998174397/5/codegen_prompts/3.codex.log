+def _solve_phases(
+    grid: np.ndarray,
+    horizontals: list[Segment],
+    verticals: list[Segment],
+    crossings: list[tuple[int, int, int, int]],
+    h_order: dict[tuple[int, int], int],
+    v_order: dict[tuple[int, int], int],
