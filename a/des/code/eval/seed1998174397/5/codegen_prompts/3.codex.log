+    crossings: list[tuple[int, int, int, int]] = []
+    h_items: dict[int, list[tuple[int, int]]] = {idx: [] for idx in range(len(horizontals))}
+    v_items: dict[int, list[tuple[int, int]]] = {idx: [] for idx in range(len(verticals))}
