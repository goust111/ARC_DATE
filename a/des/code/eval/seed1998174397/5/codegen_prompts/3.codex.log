+    h_wins: set[tuple[int, int]] = set()
+    v_wins: set[tuple[int, int]] = set()
+    for h_idx in range(h_count):
+        for v_idx in range(v_count):
+            visible = h_phase[h_idx] ^ (v_idx % 2)
+            if visible:
+                h_wins.add((h_idx, v_idx))
+            else:
