+        v_visible = phases[("v", v_idx)] ^ (v_order[(h_idx, v_idx)] % 2)
+        assert h_visible ^ v_visible, "exactly one segment must be visible at each crossing"
+        out[r, c] = horizontals[h_idx].color if h_visible else verticals[v_idx].color
