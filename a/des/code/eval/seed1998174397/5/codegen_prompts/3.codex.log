from __future__ import annotations

from dataclasses import dataclass
import random

import numpy as np


BG = 0
MARKER = 4
PATH_COLORS = [1, 2, 3, 5, 6, 7, 8, 9]
DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
GEN_ATTEMPTS = 500


def _mode_color(grid: np.ndarray) -> int:
    vals, counts = np.unique(grid, return_counts=True)
    return int(vals[int(np.argmax(counts))])


def _segment_cells(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
    (r0, c0), (r1, c1) = a, b
    if r0 == r1:
        step = 1 if c1 >= c0 else -1
        return [(int(r0), int(c)) for c in range(int(c0), int(c1) + step, step)]
    if c0 == c1:
        step = 1 if r1 >= r0 else -1
        return [(int(r), int(c0)) for r in range(int(r0), int(r1) + step, step)]
    raise ValueError("segments must be axis-aligned")


def _cross_dirs(kind: str) -> tuple[tuple[int, int], ...]:
    if kind == "h":
        return ((0, -1), (0, 1))
    if kind == "v":
        return ((-1, 0), (1, 0))
    raise ValueError("unknown crossing orientation")


def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
    return 0 <= r < shape[0] and 0 <= c < shape[1]


def _strictly_between(x: int, a: int, b: int) -> bool:
    return min(int(a), int(b)) < int(x) < max(int(a), int(b))


def _dir_allowed(
    cross_map: dict[tuple[int, int], dict[int, tuple[tuple[int, int], ...]]],
    color: int,
    cell: tuple[int, int],
    direction: tuple[int, int],
) -> bool:
    if cell not in cross_map:
        return True
    return direction in cross_map[cell][color]


def _trace_path(
    cells: set[tuple[int, int]],
    cross_map: dict[tuple[int, int], dict[int, tuple[tuple[int, int], ...]]],
    color: int,
    start: tuple[int, int],
) -> list[tuple[int, int]]:
    adj: dict[tuple[int, int], list[tuple[int, int]]] = {cell: [] for cell in cells}
    for r, c in cells:
        for dr, dc in DIRS4:
            nr, nc = int(r + dr), int(c + dc)
            nb = (nr, nc)
            if nb not in cells:
                continue
            if not _dir_allowed(cross_map, color, (r, c), (dr, dc)):
                continue
            if not _dir_allowed(cross_map, color, nb, (-dr, -dc)):
                continue
            adj[(r, c)].append(nb)

    degs = sorted(len(nbs) for nbs in adj.values())
    assert degs.count(1) == 2, "each recovered path must have exactly two endpoints"
    assert all(deg <= 2 for deg in degs), "recovered path may not branch"
    assert len(adj[start]) == 1, "yellow marker must touch a path endpoint"

    ordered: list[tuple[int, int]] = []
    seen: set[tuple[int, int]] = set()
    prev = None
    cur = start
    while True:
        ordered.append(cur)
        seen.add(cur)
        nxt = [nb for nb in adj[cur] if nb != prev]
        if not nxt:
            break
        assert len(nxt) == 1, "path traversal must be unambiguous"
        prev, cur = cur, nxt[0]

    assert seen == cells, "recovered path must be connected"
    return ordered


def main(grid: np.ndarray) -> np.ndarray:
    """
    Repaint orthogonal paths at crossings using an alternating weaving order.

    Input structure:
    - Background is black.
    - Several differently colored 1-pixel-wide orthogonal polylines are present.
    - A yellow singleton touches exactly one endpoint of each path.
    - Crossings show only one path color, hiding the other path at that cell.

    Rule:
    - Recover every full path, including the hidden crossing pixels.
    - From the yellow-marked endpoint of each path, its 1st, 3rd, 5th, ... crossing
      is "over"; its 2nd, 4th, 6th, ... crossing is "under".
    - At each crossing, the over-path is shown.
    - If both paths are over at the same crossing, the shorter recovered path wins.
    - Non-crossing cells remain unchanged.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    h, w = g.shape
    bg = _mode_color(g)

    path_colors = sorted(int(x) for x in np.unique(g) if int(x) not in {bg, MARKER})
    assert path_colors, "expected at least one path color"

    crossings: list[dict[str, object]] = []
    cross_map: dict[tuple[int, int], dict[int, tuple[tuple[int, int], ...]]] = {}
    for r in range(1, h - 1):
        for c in range(1, w - 1):
            left = int(g[r, c - 1])
            right = int(g[r, c + 1])
            up = int(g[r - 1, c])
            down = int(g[r + 1, c])
            if left != right or up != down:
                continue
            if left in {bg, MARKER} or up in {bg, MARKER} or left == up:
                continue
            visible = int(g[r, c])
            assert visible in {left, up}, "crossing center must show one of the two paths"
            pos = (int(r), int(c))
            crossings.append({"pos": pos, "h_color": left, "v_color": up})
            cross_map[pos] = {
                int(left): _cross_dirs("h"),
                int(up): _cross_dirs("v"),
            }

    cells_by_color: dict[int, set[tuple[int, int]]] = {
        color: set(map(tuple, np.argwhere(g == color))) for color in path_colors
    }
    for cross in crossings:
        pos = cross["pos"]
        h_color = int(cross["h_color"])
        v_color = int(cross["v_color"])
        cells_by_color[h_color].add(pos)
        cells_by_color[v_color].add(pos)

    marked_start: dict[int, tuple[int, int]] = {}
    marker_positions = list(map(tuple, np.argwhere(g == MARKER)))
    for mr, mc in marker_positions:
        touched = []
        for dr, dc in DIRS4:
            nr, nc = int(mr + dr), int(mc + dc)
            if not _in_bounds(g.shape, nr, nc):
                continue
            val = int(g[nr, nc])
            if val not in {bg, MARKER}:
                touched.append((val, (nr, nc)))
        assert len(touched) == 1, "each yellow marker must touch exactly one path endpoint"
        color, start = touched[0]
        assert color not in marked_start, "each path must have exactly one yellow marker"
        marked_start[color] = start

    assert set(marked_start) == set(path_colors), "every path color must have one marker"

    ordered_cells: dict[int, list[tuple[int, int]]] = {}
    path_lengths: dict[int, int] = {}
    over_state: dict[int, dict[tuple[int, int], bool]] = {}
    cross_positions = {tuple(c["pos"]) for c in crossings}
    for color in path_colors:
        ordered = _trace_path(cells_by_color[color], cross_map, color, marked_start[color])
        ordered_cells[color] = ordered
        path_lengths[color] = len(ordered)
        seen_crosses = 0
        state: dict[tuple[int, int], bool] = {}
        for cell in ordered:
            if cell in cross_positions:
                seen_crosses += 1
                state[cell] = bool(seen_crosses % 2 == 1)
        over_state[color] = state

    out = g.copy()
    for cross in crossings:
        pos = tuple(cross["pos"])
        h_color = int(cross["h_color"])
        v_color = int(cross["v_color"])
        h_over = bool(over_state[h_color][pos])
        v_over = bool(over_state[v_color][pos])
        if h_over and not v_over:
