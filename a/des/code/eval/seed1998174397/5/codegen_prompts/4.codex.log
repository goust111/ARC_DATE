+        "outline": outline,
+        "interior": interior,
+        "texture": texture,
+        "key": key,
+        "shape": outline.shape,
+    }
+
+
+def _render_patch(shape: dict, outline_color: int, with_texture: bool) -> np.ndarray:
+    patch = np.full(shape["shape"], BG_COLOR, dtype=int)
+    patch[shape["outline"]] = int(outline_color)
+    if with_texture:
