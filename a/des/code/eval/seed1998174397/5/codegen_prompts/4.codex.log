+    grid = _compose_input(panel_h, panel_w, shapes, left_positions, right_positions, left_colors, right_colors)
+    expected = _expected_output(grid, panel_w, shapes, right_positions)
+    produced = main(grid)
+    if not np.array_equal(produced, expected):
