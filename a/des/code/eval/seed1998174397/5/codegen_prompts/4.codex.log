+def _make_profile_notched() -> list[int]:
+    h = random.randint(*SHAPE_HEIGHT_RANGE)
+    wide = random.randint(3, SHAPE_HALF_WIDTH_RANGE[1])
+    narrow = random.randint(1, wide - 1)
+    top = random.randint(1, max(1, h // 3))
+    bottom = random.randint(1, max(1, h // 3))
+    if top + bottom >= h:
+        top = 1
+        bottom = 1
+    profile = [int(narrow)] * top + [int(wide)] * (h - top - bottom) + [int(narrow)] * bottom
