+                    chosen.add(random.choice(remaining))
+
+        mask = np.zeros_like(interior, dtype=bool)
+        for r, c in chosen:
+            mask[int(r), int(c)] = True
+
+        if np.array_equal(mask, np.fliplr(mask)):
