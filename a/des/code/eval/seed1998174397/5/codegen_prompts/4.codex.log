+    outside = np.zeros((h, w), dtype=bool)
+    stack: list[tuple[int, int]] = []
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if not outline_mask[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                stack.append((int(r), int(c)))
+    for c in range(w):
