+def _make_profile_walk() -> list[int]:
+    h = random.randint(*SHAPE_HEIGHT_RANGE)
+    hi = random.randint(3, SHAPE_HALF_WIDTH_RANGE[1])
+    profile = [random.randint(1, hi)]
+    for _ in range(h - 1):
+        step = random.choice((-1, 0, 1))
+        nxt = min(hi, max(1, profile[-1] + step))
+        profile.append(int(nxt))
+    if max(profile) == min(profile):
+        idx = random.randrange(h)
+        profile[idx] = min(hi, profile[idx] + 1)
