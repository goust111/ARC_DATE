+
+BACKGROUND = 0
+PALETTE = tuple(range(1, 10))
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+RNG = np.random.default_rng()
+
+GROUP_COUNT_RANGE = (3, 4)
+FRAGMENT_COUNT_VALUES = (2, 3, 4, 5, 6)
