+import numpy as np
+
+
+BACKGROUND = 0
+PALETTE = tuple(range(1, 10))
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+RNG = np.random.default_rng()
+
+GROUP_COUNT_RANGE = (3, 4)
+FRAGMENT_COUNT_VALUES = (2, 3, 4, 5, 6)
+TARGET_HEIGHT_RANGE = (2, 6)
+TARGET_WIDTH_RANGE = (2, 7)
+MAX_ROWS_PER_TARGET = 3
+LANE_GAP_RANGE = (1, 3)
+SHELF_GAP_RANGE = (2, 4)
+CANVAS_LIMIT = 30
+GEN_ATTEMPTS = 400
+GROUP_ATTEMPTS = 200
+
+
+def _randint(lo: int, hi: int) -> int:
+    return int(RNG.integers(lo, hi + 1))
+
+
+def _colors_present(grid: np.ndarray, exclude: set[int] | None = None) -> list[int]:
+    exclude = exclude or set()
+    return sorted(int(v) for v in np.unique(grid) if int(v) not in exclude)
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_components(grid: np.ndarray, color: int) -> list[dict[str, object]]:
+    h, w = map(int, grid.shape)
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict[str, object]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            seen[r, c] = True
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            r0, c0, r1, c1 = _bbox(coords)
+            comps.append(
+                {
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "height": r1 - r0 + 1,
+                    "width": c1 - c0 + 1,
+                    "area": len(coords),
+                }
+            )
+    return comps
+
