+def _extract_seed(grid: np.ndarray) -> np.ndarray:
+    mask = (grid != BG_COLOR) & (grid != GROW_COLOR)
+    coords = np.argwhere(mask)
+    assert coords.size > 0
+    r0, c0, r1, c1 = _bbox(coords)
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
