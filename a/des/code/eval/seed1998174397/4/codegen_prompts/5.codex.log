+                "corner": corner,
+                "mask": mask,
+                "anchor": anchor,
+                "pattern": _make_pattern(bg, color, pattern_kind),
+                "shape_pos": None,
+                "template_pos": None,
+            }
+        )
+
+    rng.shuffle(specs)
+    for spec in specs:
+        mask = spec["mask"]
+        bh, bw = mask.shape
+        placed = False
+        for _ in range(250):
