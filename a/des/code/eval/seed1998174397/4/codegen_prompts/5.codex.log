+            grid[top + ar, left + ac] = RED
+            placed = True
+            break
+        if not placed:
+            return None
+
+    rng.shuffle(specs)
+    for spec in specs:
+        placed = False
+        for _ in range(250):
+            top = rng.randint(0, H - 3)
+            left = rng.randint(0, W - 3)
+            if not _can_place_box(occupied, top, left, 3, 3, pad=1):
+                continue
+            _reserve_box(occupied, top, left, 3, 3)
+            spec["template_pos"] = (top, left)
+            patch = spec["pattern"]
+            for r in range(3):
