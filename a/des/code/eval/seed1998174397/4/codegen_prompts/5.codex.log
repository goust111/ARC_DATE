+
+RED = 2
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+CORNER_NAMES = ("TL", "TR", "BL", "BR")
+PATTERN_KINDS = ("checker_a", "checker_b", "stripe_v", "stripe_h")
+GEN_ATTEMPTS = 600
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    return Counter(map(int, grid.flat)).most_common(1)[0][0]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    parts: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            parts.append(pts)
+    return parts
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in points]
+    cs = [c for _, c in points]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _nearest_corner(anchor: tuple[int, int], bbox: tuple[int, int, int, int]) -> str:
+    r0, c0, r1, c1 = bbox
+    ar, ac = anchor
+    rel_r = ar - r0
+    rel_c = ac - c0
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    distances = [
+        rel_r + rel_c,
+        rel_r + (w - 1 - rel_c),
+        (h - 1 - rel_r) + rel_c,
+        (h - 1 - rel_r) + (w - 1 - rel_c),
+    ]
+    best = min(distances)
+    for name, dist in zip(CORNER_NAMES, distances):
+        if dist == best:
+            return name
+    raise AssertionError("unreachable")
+
+
+def _pattern_indices(
+    r: int,
+    c: int,
+    bbox: tuple[int, int, int, int],
+    corner: str,
+) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    if corner in ("TL", "TR"):
+        pr = (r - r0) % 3
+    else:
+        pr = (2 - ((r1 - r) % 3)) % 3
+    if corner in ("TL", "BL"):
+        pc = (c - c0) % 3
+    else:
+        pc = (2 - ((c1 - c) % 3)) % 3
+    return pr, pc
+
