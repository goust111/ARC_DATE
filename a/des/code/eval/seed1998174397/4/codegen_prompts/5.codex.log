+
+
+def _can_place_box(
+    occupied: np.ndarray,
+    top: int,
+    left: int,
+    h: int,
+    w: int,
+    pad: int = 1,
+) -> bool:
+    H, W = occupied.shape
+    if top < 0 or left < 0 or top + h > H or left + w > W:
+        return False
+    r0 = max(0, top - pad)
+    c0 = max(0, left - pad)
+    r1 = min(H, top + h + pad)
+    c1 = min(W, left + w + pad)
+    return not bool(occupied[r0:r1, c0:c1].any())
+
