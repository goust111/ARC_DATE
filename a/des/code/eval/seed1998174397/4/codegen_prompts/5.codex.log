+def _make_pattern(bg: int, color: int, kind: str) -> np.ndarray:
+    arr = np.full((3, 3), bg, dtype=int)
+    if kind == "checker_a":
+        for r in range(3):
+            for c in range(3):
+                if (r + c) % 2 == 0:
+                    arr[r, c] = color
+    elif kind == "checker_b":
+        for r in range(3):
+            for c in range(3):
+                if (r + c) % 2 == 1:
+                    arr[r, c] = color
+    elif kind == "stripe_v":
+        arr[:, ::2] = color
+    elif kind == "stripe_h":
+        arr[::2, :] = color
+    else:
+        raise ValueError(kind)
+    return arr
