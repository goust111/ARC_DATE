+
+def _nearest_corner(anchor: tuple[int, int], bbox: tuple[int, int, int, int]) -> str:
+    r0, c0, r1, c1 = bbox
+    ar, ac = anchor
+    rel_r = ar - r0
+    rel_c = ac - c0
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    distances = [
+        rel_r + rel_c,
+        rel_r + (w - 1 - rel_c),
+        (h - 1 - rel_r) + rel_c,
+        (h - 1 - rel_r) + (w - 1 - rel_c),
+    ]
+    best = min(distances)
+    for name, dist in zip(CORNER_NAMES, distances):
+        if dist == best:
+            return name
+    raise AssertionError("unreachable")
