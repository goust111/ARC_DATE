+
+
+RED = 2
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+CORNER_NAMES = ("TL", "TR", "BL", "BR")
+PATTERN_KINDS = ("checker_a", "checker_b", "stripe_v", "stripe_h")
