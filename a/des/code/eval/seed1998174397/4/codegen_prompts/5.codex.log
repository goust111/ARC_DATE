+def _eligible_anchors(mask: np.ndarray) -> dict[str, list[tuple[int, int]]]:
+    h, w = mask.shape
+    result = {name: [] for name in CORNER_NAMES}
+    bbox = (0, 0, h - 1, w - 1)
