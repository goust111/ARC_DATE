+        inner_h, inner_w = inner_shape
+        box_h, box_w = inner_h + 2, inner_w + 2
+
+        if side in ("up", "down"):
+            if w - box_w - 1 < 1:
+                continue
+            available_max = h - box_h - 1
+        else:
+            if h - box_h - 1 < 1:
+                continue
+            available_max = w - box_w - 1
+        if available_max < 1:
