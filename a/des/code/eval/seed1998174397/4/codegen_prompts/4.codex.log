  "match_cond": "s 4-touches d",
  "transform": "erase s to yellow; in each matched d, repaint |matched s cells| orange cells gray as complete rows for horizontal bars or complete columns for vertical bars from the touched edge"
}
</annotation>
</reference_puzzle>

