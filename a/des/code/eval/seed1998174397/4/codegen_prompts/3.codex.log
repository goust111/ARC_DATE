0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """
0009:     Slide multi-color sprites to align their marker pixels with matching isolated border anchors.
0010: 
0011:     Input structure:
0012:     - bg = most common color.
0013:     - Multi-color sprites in the interior; each has a minority-color "marker" pixel.
0014:     - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.
0015: 
0016:     Rule:
0017:     - Match each sprite to the border anchor sharing its marker color.
0018:     - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.
0019:     - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.
0020: 
0021:     Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.
0022:     """
0023:     g = np.array(grid, dtype=int)
0024:     H, W = g.shape
0025:     bg = int(get_bg(g))
0026: 
0027:     def is_border(r: int, c: int) -> bool:
0028:         return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))
0029: 
0030:     # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---
0031:     anchors_by_color: dict[int, tuple[int, int]] = {}
0032:     for r in range(H):
