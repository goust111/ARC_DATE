+            candidates: list[tuple[str, tuple[int, int]]] = []
+
+            # Vertical wall gap: passage is left <-> right, lock is above or below.
+            if 0 < c < w - 1 and int(g[r, c - 1]) != wall and int(g[r, c + 1]) != wall:
+                if r >= 2 and r + 1 < h:
