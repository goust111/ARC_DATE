/bin/bash -lc "python - <<'PY'
from itertools import permutations

def simulate(k, assign):
    opened = [False]*k  # door0..door{k-1}
    used_round = {i: None for i in range(1,k+1)}
    rounds=[]
    t=0
    while True:
        # components as intervals from internal opened doors only; door0 (outside) doesn't merge rooms
        comps=[]
        i=1
        while i<=k:
            comp=[i]
            while i<k and opened[i]:
                i+=1
                comp.append(i)
            comps.append(comp)
            i+=1
        ops=[]
        for comp in comps:
            boundary=set()
            if comp[0]==1 and not opened[0]:
                boundary.add(0)
            if comp[0]>1 and not opened[comp[0]-1]:
                boundary.add(comp[0]-1)
            if comp[-1]<k and not opened[comp[-1]]:
                boundary.add(comp[-1])
            for room in comp:
                d=assign[room]
                if used_round[room] is None and d in boundary and not opened[d]:
                    ops.append((room,d))
        if not ops:
            break
        t+=1
        for room,d in ops:
            used_round[room]=t
            opened[d]=True
        rounds.append(ops)
    return opened, used_round, rounds


def intervening_rooms(room, door):
    if door==0:
        return list(range(1, room))
    j=door
    if room <= j:
        return list(range(room+1, j+1))
    else:
        return list(range(j+1, room))

for k in range(3,7):
    print('k',k)
    good=[]
    for perm in permutations(range(k),k):
        assign={i+1:perm[i] for i in range(k)}
        opened, used_round, rounds = simulate(k, assign)
        if not all(opened):
            continue
        nonempty=len(rounds)
        if nonempty < 2:
            continue
        ok=True
        for room,d in assign.items():
            tr=used_round[room]
            if tr is None:
                ok=False; break
            for mid in intervening_rooms(room,d):
                tm=used_round[mid]
                if tm is None or tm >= tr:
                    ok=False; break
            if not ok:
                break
        if ok:
            good.append((assign,rounds))
            if len(good)>=20:
                break
    for assign, rounds in good[:10]:
        print(assign, rounds)
    print('count', len(good))
