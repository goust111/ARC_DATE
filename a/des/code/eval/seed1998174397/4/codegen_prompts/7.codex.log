+def _component_labels(out: np.ndarray, wall: int, doors: list[dict]) -> np.ndarray:
+    h, w = out.shape
+    blocked = out == wall
+    for door in doors:
+        if not door["opened"]:
+            gr, gc = door["gap"]
+            lr, lc = door["lock"]
+            blocked[gr, gc] = True
+            blocked[lr, lc] = True
+
+    labels = np.full((h, w), -1, dtype=int)
+    cid = 0
+    for r in range(h):
+        for c in range(w):
+            if blocked[r, c] or labels[r, c] >= 0:
+                continue
+            q = deque([(int(r), int(c))])
+            labels[r, c] = cid
+            while q:
+                cr, cc = q.popleft()
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
