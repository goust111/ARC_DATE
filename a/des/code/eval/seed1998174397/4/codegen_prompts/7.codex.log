+def _find_keys(g: np.ndarray, bg: int, wall: int, lock_positions: set[tuple[int, int]]) -> dict[int, tuple[int, int]]:
+    keys: dict[int, tuple[int, int]] = {}
+    h, w = g.shape
+    for r in range(h):
+        for c in range(w):
+            v = int(g[r, c])
+            if v in (bg, wall):
+                continue
+            if (r, c) in lock_positions:
