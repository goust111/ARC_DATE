+def _door_sides(gap: tuple[int, int], orient: str) -> list[tuple[int, int]]:
+    r, c = gap
+    if orient == "v":
+        return [(r, c - 1), (r, c + 1)]
+    return [(r - 1, c), (r + 1, c)]
