+
+    corridor_r = random.randint(top + 2, bottom - 2)
+    door_positions = {door: (corridor_r, wall_x[door]) for door in range(k)}
+
+    colors = random.sample([1, 2, 3, 4, 6, 7, 8, 9], k)
