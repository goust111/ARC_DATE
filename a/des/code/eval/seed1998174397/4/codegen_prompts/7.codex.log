+                if r + 2 < h and r - 1 >= 0:
+                    if (
+                        int(g[r + 1, c]) not in (bg, wall)
+                        and int(g[r + 2, c]) == wall
+                        and int(g[r - 1, c]) == wall
+                    ):
+                        candidates.append(("v", (r + 1, c)))
