from itertools import product, permutations

def simulate(k, assign):
    # rooms 1..k, doors 0..k-1 (door0 outer-left of room1, door i between i and i+1 for 1<=i<k)
    opened = [False]*k
    used = [False]*(k+1)
    # components as list of sets of rooms plus outside marker 0 maybe if door0 opened
    rooms = list(range(1,k+1))
    outside_connected = False
    changed = True
    rounds = []
    while changed:
        changed = False
        # build connected components of rooms using opened internal doors
        comps = []
        start = 1
        i=1
        while i<=k:
            comp=[i]
            while i<k and opened[i]:
                i+=1
                comp.append(i)
            comps.append(comp)
            i+=1
        # if outside door open, attach outside to first comp
        # determine openable keys in each comp
        round_ops=[]
        for comp in comps:
            left = 0 if comp[0]==1 and not opened[0] else None
            right = comp[-1] if comp[-1]<k and not opened[comp[-1]] else None
            boundary = set()
            if left is not None:
                boundary.add(0)
            if right is not None:
                boundary.add(comp[-1])
            if comp[0]>1 and not opened[comp[0]-1]:
                boundary.add(comp[0]-1)
            # left boundary internal door if not first room and unopened
            # Actually interval can have both left and right boundary internal doors.
            if comp[-1]<k and not opened[comp[-1]]:
                boundary.add(comp[-1])
            # If first comp and door0 unopened, boundary includes 0.
            # If comp starts >1, left boundary door index = comp[0]-1
            # if comp ends <k, right boundary door index = comp[-1]
            for room in comp:
                d = assign[room]
                if (not used[room]) and d in boundary and not opened[d]:
                    round_ops.append((room,d))
        # outside has no keys
        for room,d in round_ops:
            if used[room] or opened[d]:
                continue
            used[room]=True
            opened[d]=True
            changed = True
        rounds.append(round_ops)
    return opened, used, rounds

for k in range(3,7):
    doors = list(range(k))
    print('k',k)
    found=[]
    # allow duplicate door assignments? no, permutation of k doors to k rooms
    for perm in permutations(doors, k):
        assign={i+1:perm[i] for i in range(k)}
        opened,used,rounds=simulate(k,assign)
        if all(opened) and len([r for r in rounds if r])>=2:
            # avoid all keys opening first round
            if len(rounds[0])<k:
                found.append((assign,rounds))
                if len(found)>=10:
                    break
    for assign, rounds in found[:10]:
        print(assign, [ops for ops in rounds if ops])
    print('count',len(found))
