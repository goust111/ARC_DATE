+        placements_a = _placements_in_rectangle(shape_a, rect_h, rect_w)
+        placements_b = _placements_in_rectangle(shape_b, rect_h, rect_w)
+        found = False
+        for cells_a in placements_a:
+            for cells_b in placements_b:
