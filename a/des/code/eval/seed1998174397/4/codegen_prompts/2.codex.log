+    height, width = _shape_dims(shape)
+    cells = set(shape)
+    for corner_r in (0, height - 1):
+        for corner_c in (0, width - 1):
+            arm = {(corner_r, c) for c in range(width)} | {(r, corner_c) for r in range(height)}
+            if arm == cells:
