+def _collect_blocks(grid: np.ndarray) -> dict[tuple[int, int], list[int]]:
+    size_to_colors: dict[tuple[int, int], list[int]] = {}
+    for color in np.unique(grid):
+        color = int(color)
+        if color in (BG, GREY):
