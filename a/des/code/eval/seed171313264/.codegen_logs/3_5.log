+    if side == "top":
+        patch[:slot_h, offset : offset + slot_w] = BG
+    elif side == "bottom":
+        patch[full_h - slot_h :, offset : offset + slot_w] = BG
+    elif side == "left":
+        patch[offset : offset + slot_h, :slot_w] = BG
+    else:
+        patch[offset : offset + slot_h, full_w - slot_w :] = BG
+    return patch
