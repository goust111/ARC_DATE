+
+
+def _background_dominant(grid: np.ndarray, bg: int, sep_row: int) -> bool:
+    mask = np.ones_like(grid, dtype=bool)
+    mask[sep_row, :] = False
+    values = [int(v) for v in grid[mask].reshape(-1)]
+    counts = Counter(values)
+    if not counts:
+        return False
+    color, _ = counts.most_common(1)[0]
