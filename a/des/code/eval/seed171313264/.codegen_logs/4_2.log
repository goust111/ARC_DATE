+    return sources
+
+
+def _track_nodes(grid: np.ndarray, track_color: int, track_colors: set[int]) -> set[tuple[int, int]]:
+    nodes = {tuple(map(int, rc)) for rc in np.argwhere(grid == int(track_color))}
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
+            cell = int(grid[r, c])
