+import random
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+TRACK_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+COUNT_OPTIONS = [(1, 2), (2, 1), (2, 2), (2, 3), (3, 2), (3, 3)]
