                    out[r, a + i] = TOKEN
        else:
            for i in range(count):
                if b - i >= a:
                    out[r, b - i] = TOKEN

    return out, drop_counts


def _gen_attempt() -> np.ndarray | None:
    rng = np.random.default_rng()

