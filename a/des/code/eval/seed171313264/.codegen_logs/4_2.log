+    for r, c in np.argwhere(mask):
+        rr, cc = int(r), int(c)
+        if seen[rr, cc]:
+            continue
+        seen[rr, cc] = True
+        q = deque([(rr, cc)])
+        coords: list[tuple[int, int]] = []
+        while q:
+            cr, cc = q.popleft()
+            coords.append((cr, cc))
+            for nr, nc in _neighbors4(grid.shape, cr, cc):
+                if mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        comps.append(coords)
+    return comps
