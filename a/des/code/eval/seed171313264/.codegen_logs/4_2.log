+def _neighbor_positions(shape: tuple[int, int], coords: list[tuple[int, int]]) -> set[tuple[int, int]]:
+    coord_set = set(coords)
+    out: set[tuple[int, int]] = set()
+    for r, c in coords:
+        for nr, nc in _neighbors4(shape, r, c):
+            if (nr, nc) not in coord_set:
