+def _neighbors4(shape: tuple[int, int], r: int, c: int):
+    h, w = shape
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
