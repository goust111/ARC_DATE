+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+ROOT_SCRIPT_ORDER = {"yellow": 0, "green": 1, "blue": 2, "boundary": 3}
+GRID_MIN = 18
+GRID_MAX = 27
+SOURCE_MARGIN = 6
+GEN_ATTEMPTS = 500
