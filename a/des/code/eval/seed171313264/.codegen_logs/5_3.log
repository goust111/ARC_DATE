+
+def _cells_to_boundary(
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    shape: tuple[int, int],
+) -> list[tuple[int, int]]:
+    steps = _steps_to_boundary(start, direction, shape)
+    return _segment_cells(start, direction, steps)
+
+
+def _path_clear(grid: np.ndarray, cells: list[tuple[int, int]]) -> bool:
+    h, w = grid.shape
+    for r, c in cells:
