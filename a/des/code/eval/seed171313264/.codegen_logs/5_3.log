+    outcomes: list[tuple[np.ndarray, set[tuple[int, int]]]] = []
+    for lead in _shuffled(range(3, max_steps + 1), rng):
+        path_to_pivot = _segment_cells(start, direction, lead)
+        pre_cells = path_to_pivot[:-1]
