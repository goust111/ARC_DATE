+    roots = _parse_sources(g)
+    gates = _parse_gates(g)
+    endpoints = _trace_endpoints(g.shape, roots, gates)
+
+    out = g.copy()
+    for r, c in endpoints:
+        out[r, c] = ORANGE
+    return out
