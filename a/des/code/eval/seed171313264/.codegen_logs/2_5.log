+    r = 1
+    for room_h in row_sizes:
+        c = 1
+        for room_w in col_sizes:
+            grid[r : r + room_h, c : c + room_w] = bg
+            rooms.append((r, c, r + room_h - 1, c + room_w - 1))
+            c += room_w + 1
+        r += room_h + 1
