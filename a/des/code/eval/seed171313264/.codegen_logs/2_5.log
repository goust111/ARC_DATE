+import random
+from collections import deque
+
+import numpy as np
+
+
+GENERATE_ATTEMPTS = 400
+ROOM_COUNT_CHOICES = (3, 4)
+ROOM_SIDE_MIN = 9
+ROOM_SIDE_MAX = 12
+ARC_COLORS = tuple(range(10))
+
+SHAPE_LIBRARY: dict[int, tuple[tuple[tuple[int, int], ...], ...]] = {
+    2: (
+        ((0, 0), (0, 1)),
+    ),
+    3: (
+        ((0, 0), (0, 1), (0, 2)),
+        ((0, 0), (1, 0), (1, 1)),
