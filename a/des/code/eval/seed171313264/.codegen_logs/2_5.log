+
+def _touches_edge(coords: np.ndarray, h: int, w: int) -> bool:
+    return bool(
+        np.any(coords[:, 0] == 0)
+        or np.any(coords[:, 0] == h - 1)
+        or np.any(coords[:, 1] == 0)
