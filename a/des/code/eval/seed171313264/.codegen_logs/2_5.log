+
+DOT_PATTERNS: dict[int, tuple[tuple[tuple[int, int], ...], ...]] = {
+    2: (
+        ((-2, 0), (2, 0)),
+        ((0, -2), (0, 2)),
+        ((-2, -1), (2, 1)),
+        ((-1, -2), (1, 2)),
+    ),
+    3: (
+        ((-2, 0), (0, 0), (2, 0)),
+        ((0, -2), (0, 0), (0, 2)),
+        ((-2, -1), (0, 1), (2, -1)),
+        ((-1, -2), (1, 0), (-1, 2)),
+    ),
+    4: (
+        ((-2, -2), (-2, 2), (2, -2), (2, 2)),
+        ((-2, 0), (0, -2), (0, 2), (2, 0)),
+        ((-2, -1), (-2, 1), (2, -1), (2, 1)),
+    ),
+    5: (
+        ((-2, 0), (0, -2), (0, 0), (0, 2), (2, 0)),
