+def _expanded(points: set[tuple[int, int]], room_h: int, room_w: int) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    for r, c in points:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                rr, cc = r + dr, c + dc
+                if 0 <= rr < room_h and 0 <= cc < room_w:
+                    out.add((rr, cc))
+    return out
+
