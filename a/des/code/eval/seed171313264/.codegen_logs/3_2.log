+
+    found_components = _find_components(grid)
+    if len(found_components) != len(components):
+        return None
+    solutions, _compat2, _counts2 = _solve_components(found_components, limit=3)
+    if len(solutions) != 1:
+        return None
+    if not np.array_equal(main(grid), expected):
+        return None
+
+    return grid
