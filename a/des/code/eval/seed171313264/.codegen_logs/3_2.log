+
+def _render_candidate(candidate: dict, comp_a: dict, comp_b: dict) -> np.ndarray:
+    out_h, out_w = candidate["shape"]
+    out = np.zeros((out_h, out_w), dtype=int)
+
+    a_r, a_c = candidate["a_pos"]
+    b_r, b_c = candidate["b_pos"]
