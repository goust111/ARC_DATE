+        return None
+
+    grid_h = int(_RNG.integers(min_side, _GRID_MAX + 1))
+    grid_w = int(_RNG.integers(min_side, _GRID_MAX + 1))
+    grid = _place_patches(patches, grid_h, grid_w)
