+    if not bool(np.all(sub[0, :] == color)):
+        return None
+    if not bool(np.all(sub[-1, :] == color)):
+        return None
+    if not bool(np.all(sub[:, 0] == color)):
+        return None
+    if not bool(np.all(sub[:, -1] == color)):
+        return None
+    if not bool(np.all(sub[1:-1, 1:-1] == bg)):
+        return None
