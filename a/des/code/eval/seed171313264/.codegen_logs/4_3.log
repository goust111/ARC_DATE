+
+def _frame_position(grid_h: int, grid_w: int, frame_h: int, frame_w: int, corner: str) -> tuple[int, int]:
+    if corner == "tl":
+        return 0, 0
+    if corner == "tr":
+        return 0, grid_w - frame_w
+    if corner == "bl":
+        return grid_h - frame_h, 0
+    if corner == "br":
+        return grid_h - frame_h, grid_w - frame_w
+    raise AssertionError(corner)
