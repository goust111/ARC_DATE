+
+
+def _is_connected(cells: set[tuple[int, int]], h: int, w: int) -> bool:
+    if not cells:
+        return True
+    start = next(iter(cells))
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c, h, w):
+            if (nr, nc) in cells and (nr, nc) not in seen:
