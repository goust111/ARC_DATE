+        remaining_areas = [int(p["area"]) for p in pieces[idx + 1 :]]
+        for cand in candidates[idx]:
+            if int(cand["mask"]) & occupied:
+                continue
+            if idx > 0 and (int(cand["adj"]) & occupied) == 0:
+                continue
