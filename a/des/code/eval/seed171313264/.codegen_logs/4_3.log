+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+FRAME = 9
+PIECE_COLORS = (1, 2, 3, 4, 6, 7, 8)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRIES = 400
