+    placements: list[dict | None] = [None] * len(pieces)
+    solutions: list[list[dict]] = []
+    suffix_areas = [0] * (len(pieces) + 1)
+    for idx in range(len(pieces) - 1, -1, -1):
+        suffix_areas[idx] = suffix_areas[idx + 1] + int(pieces[idx]["area"])
