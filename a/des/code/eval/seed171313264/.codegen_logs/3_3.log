+    r0, c0, r1, c1 = bbox
+    grid[r0 - 1, c0 - 1 : c1 + 2] = GREY
+    grid[r1 + 1, c0 - 1 : c1 + 2] = GREY
+    grid[r0 - 1 : r1 + 2, c0 - 1] = GREY
+    grid[r0 - 1 : r1 + 2, c1 + 1] = GREY
