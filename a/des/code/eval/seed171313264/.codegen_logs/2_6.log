+    placed_rects: list[tuple[int, int, int]] = []
+    placed: list[dict] = []
+    order = list(range(len(sizes)))
+    random.shuffle(order)
+    for idx in order:
+        size = int(sizes[idx])
+        color = int(colors[idx])
