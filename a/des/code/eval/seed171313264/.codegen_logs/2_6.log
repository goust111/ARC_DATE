+
+def _turn_kind(prev_pt: tuple[int, int], cur_pt: tuple[int, int], next_pt: tuple[int, int]) -> str:
+    d1 = _step_dir(prev_pt, cur_pt)
+    d2 = _step_dir(cur_pt, next_pt)
