+
+
+def _anchor_at_turn(turn: tuple[int, int], size: int) -> tuple[int, int]:
+    # Even squares cannot be centered exactly on one cell; use upper-left-biased integer centering.
+    return int(turn[0] - size // 2), int(turn[1] - size // 2)
