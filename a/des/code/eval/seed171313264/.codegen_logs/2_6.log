+        kind = _turn_kind(points[i - 1], points[i], points[i + 1])
+        if kind == "straight":
+            continue
+        turn = points[i]
+        adj_markers = [(nr, nc) for nr, nc in _neighbors4(turn[0], turn[1], inp.shape[0], inp.shape[1]) if (nr, nc) in marker_map]
