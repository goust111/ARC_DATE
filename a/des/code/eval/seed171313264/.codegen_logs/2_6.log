+    return squares
+
+
+def _find_path_color(grid: np.ndarray, bg: int) -> int:
+    height, width = grid.shape
+    candidates: list[int] = []
+    for color in sorted(set(map(int, grid.flatten())) - {int(bg)}):
+        mask = grid == int(color)
+        comps = _component_coords(mask)
+        if len(comps) != 1:
