+        "color": int(color),
+        "size": int(size_r),
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "coords": coords,
+    }
+
+
+def _extract_squares(grid: np.ndarray, bg: int) -> list[dict]:
+    squares: list[dict] = []
