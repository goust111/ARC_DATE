+
+def _marker_for_turn(
+    grid: np.ndarray,
+    square_mask: np.ndarray,
+    path_color: int,
+    bg: int,
+    turn: tuple[int, int],
+) -> tuple[int, int, int]:
+    height, width = grid.shape
+    candidates: list[tuple[int, int, int]] = []
+    for nr, nc in _neighbors4(turn[0], turn[1], height, width):
