+        coords = comps[0]
+        if int(coords.shape[0]) < 3:
+            continue
+        deg1 = 0
+        ok = True
+        boundary_endpoints = 0
+        for r, c in coords:
+            degree = sum(1 for nr, nc in _neighbors4(int(r), int(c), height, width) if bool(mask[nr, nc]))
+            if degree == 1:
+                deg1 += 1
+                if int(r) in {0, height - 1} or int(c) in {0, width - 1}:
+                    boundary_endpoints += 1
+            elif degree != 2:
+                ok = False
+                break
