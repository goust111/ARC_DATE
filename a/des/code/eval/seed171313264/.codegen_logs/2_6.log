+    cur = tuple(map(int, start))
+    while True:
+        nbrs = [(nr, nc) for nr, nc in _neighbors4(cur[0], cur[1], height, width) if bool(path_mask[nr, nc])]
+        nxts = [pt for pt in nbrs if pt != prev]
+        if not nxts:
