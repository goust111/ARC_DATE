+def _ordered_turns(
+    grid: np.ndarray,
+    path_color: int,
+    squares: list[dict],
+    bg: int,
+) -> list[dict]:
+    path_mask = grid == int(path_color)
+    endpoints = _path_endpoints(path_mask)
+    square_mask = np.zeros_like(grid, dtype=bool)
+    for sq in squares:
