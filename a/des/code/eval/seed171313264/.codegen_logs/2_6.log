+def _step_dir(a: tuple[int, int], b: tuple[int, int]) -> tuple[int, int]:
+    dr = int(b[0] - a[0])
+    dc = int(b[1] - a[1])
+    return int(np.sign(dr)), int(np.sign(dc))
