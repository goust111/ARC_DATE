+    return int(candidates[0])
+
+
+def _path_endpoints(path_mask: np.ndarray) -> list[tuple[int, int]]:
+    height, width = path_mask.shape
+    endpoints: list[tuple[int, int]] = []
+    for r, c in np.argwhere(path_mask):
