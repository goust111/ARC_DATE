        return None

    expected_area = 2 * (outer_h + outer_w) - 4 - len(gaps)
    if len(coords) != expected_area:
        return None

    inner = g[r0 + 1 : r1, c0 + 1 : c1]
    colors_inside = {int(v) for v in np.unique(inner) if int(v) not in (BG, int(color))}
    if not colors_inside:
        return None

    return {
