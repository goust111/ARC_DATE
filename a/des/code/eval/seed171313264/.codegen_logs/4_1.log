+def random_connected_mask(q: int, rng: random.Random):
+    allowed = [(r, c) for r in range(1, q - 1) for c in range(1, q - 1)]
+    max_area = len(allowed)
+    for _ in range(200):
+        target = rng.randint(3, max(3, max_area - 1))
+        seed = rng.choice(allowed)
