+def box_is_free(reserved: np.ndarray, r0: int, c0: int, r1: int, c1: int, pad: int) -> bool:
+    h, w = reserved.shape
+    if r0 < 0 or c0 < 0 or r1 >= h or c1 >= w:
+        return False
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h - 1, r1 + pad)
+    cc1 = min(w - 1, c1 + pad)
+    return not reserved[rr0 : rr1 + 1, cc0 : cc1 + 1].any()
