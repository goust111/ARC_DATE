+        expected_quads = [np.rot90(base_mask, (4 - QUAD_ROTATIONS[idx]) % 4) for idx in range(4)]
+        gap_full = expected_quads[missing_idx]
+        gap_trim, (gr0, gc0) = trim_mask(gap_full)
