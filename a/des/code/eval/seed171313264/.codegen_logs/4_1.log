+
+def build_container(q: int, frame_color: int, missing_idx: int, rng: random.Random):
+    base_mask = random_connected_mask(q, rng)
+    side = 2 * q + 2
+    patch = np.full((side, side), BG, dtype=int)
+    patch[0, :] = frame_color
+    patch[-1, :] = frame_color
+    patch[:, 0] = frame_color
+    patch[:, -1] = frame_color
