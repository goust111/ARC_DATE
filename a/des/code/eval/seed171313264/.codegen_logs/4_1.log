+def marker_candidates(key_mask: np.ndarray):
+    h, w = key_mask.shape
+    occupied = {(r, c) for r, c in np.argwhere(key_mask)}
+    candidates = []
+    for mr in range(-1, h + 1):
+        for mc in range(-1, w + 1):
+            if (mr, mc) in occupied:
