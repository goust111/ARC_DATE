+            for r, c in list(cells):
+                for nr, nc in neighbors4(r, c):
+                    if (nr, nc) in cells:
+                        continue
+                    if 1 <= nr < q and 1 <= nc < q:
+                        frontier.append((nr, nc))
+            if not frontier:
+                break
+            cells.add(rng.choice(frontier))
