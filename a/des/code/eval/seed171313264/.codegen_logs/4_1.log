+        grid[marker] = spec["frame_color"]
+        reserve_box(reserved, gr0, gc0, gr1, gc1, pad=1)
+        spec["key_mask"] = key_mask
+        spec["key_bbox"] = (key_r0, key_c0, key_r0 + key_h - 1, key_c0 + key_w - 1)
+        spec["marker"] = marker
+    return specs
