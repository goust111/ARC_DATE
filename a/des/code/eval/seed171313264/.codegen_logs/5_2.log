+    if orientation == "H":
+        assert a.shape[0] == b.shape[0]
+        out = np.zeros((a.shape[0], a.shape[1] + b.shape[1]), dtype=bool)
+        out[:, : a.shape[1]] = a
+        out[:, a.shape[1] :] = b
+        return out
