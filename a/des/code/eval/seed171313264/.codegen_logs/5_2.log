+def _find_components_of_color(grid: np.ndarray, color: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r0 in range(h):
+        for c0 in range(w):
+            if seen[r0, c0] or int(g[r0, c0]) != color:
+                continue
+
+            seen[r0, c0] = True
+            q = deque([(r0, c0)])
+            coords: list[tuple[int, int]] = []
+            min_r = max_r = r0
+            min_c = max_c = c0
+
+            while q:
+                r, c = q.popleft()
+                coords.append((r, c))
+                min_r = min(min_r, r)
+                max_r = max(max_r, r)
+                min_c = min(min_c, c)
+                max_c = max(max_c, c)
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    rr = r + dr
+                    cc = c + dc
+                    if 0 <= rr < h and 0 <= cc < w and not seen[rr, cc] and int(g[rr, cc]) == color:
+                        seen[rr, cc] = True
+                        q.append((rr, cc))
+
+            mask = np.zeros((max_r - min_r + 1, max_c - min_c + 1), dtype=bool)
+            for r, c in coords:
+                mask[r - min_r, c - min_c] = True
+            comps.append(
+                {
+                    "bbox": (int(min_r), int(min_c), int(max_r), int(max_c)),
+                    "mask": mask,
+                    "area": int(mask.sum()),
+                }
+            )
