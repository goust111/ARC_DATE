+    for r in range(seam_row - 1, -1, -1):
+        intervals[r] = _choose_interval(width, intervals[r + 1], None)
+    for r in range(seam_row + 1, height):
+        intervals[r] = _choose_interval(width, intervals[r - 1], None)
