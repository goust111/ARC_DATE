+        path = list(placed["ordered"])
+        if marked and rng.random() < 0.5:
+            path.reverse()
+        marker_color = rng.choice(COLOR_POOL) if marked else None
+        path_infos.append({"path": path, "marked": marked, "marker_color": marker_color})
