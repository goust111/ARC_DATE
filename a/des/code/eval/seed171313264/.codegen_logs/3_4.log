+    gate_slots = []
+    for path_id, info in enumerate(path_infos):
+        if not info["marked"]:
+            continue
+        slots = _gate_slots_for_path(info["path"])
+        for slot in slots:
+            slot = dict(slot)
+            slot["path_id"] = path_id
+            gate_slots.append(slot)
