+    for path_id, info in enumerate(path_infos):
+        if info["marked"]:
+            marker = _marker_cell(info["path"])
+            if not _in_bounds(grid.shape, marker[0], marker[1]) or grid[marker] != BLACK or marker in occupied_color_cells:
