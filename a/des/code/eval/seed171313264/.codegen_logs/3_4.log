+    for rr, cc in coords:
+        start = (int(rr), int(cc))
+        if start in seen:
+            continue
+        queue = deque([start])
+        seen.add(start)
+        comp_cells: list[tuple[int, int]] = []
+        while queue:
+            cur = queue.popleft()
+            comp_cells.append(cur)
+            r, c = cur
+            for dr, dc in CARDINALS:
+                nr, nc = r + dr, c + dc
+                nxt = (nr, nc)
+                if not _in_bounds(grid.shape, nr, nc) or nxt in seen or grid[nr, nc] != GREY:
+                    continue
+                seen.add(nxt)
+                queue.append(nxt)
