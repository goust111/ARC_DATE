+        return [(0, 0)]
+    dirs = [(path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]) for i in range(len(path) - 1)]
+    bounds: list[tuple[int, int]] = []
+    start = 0
+    for i in range(len(dirs)):
+        if i == len(dirs) - 1 or dirs[i] != dirs[i + 1]:
+            bounds.append((start, i + 1))
+            start = i + 2
+    return bounds
