+def _paint_path(grid: np.ndarray, path: list[tuple[int, int]]) -> None:
+    for r, c in path:
+        grid[r, c] = GREY
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    height = rng.randint(16, 28)
+    width = rng.randint(16, 28)
+    grid = np.full((height, width), BLACK, dtype=int)
