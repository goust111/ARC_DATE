+    mask_a = np.zeros((h, w), dtype=bool)
+    mask_b = np.zeros((h, w), dtype=bool)
+    for r, c in cells_a:
+        mask_a[int(r), int(c)] = True
+    for r, c in cells_b:
+        mask_b[int(r), int(c)] = True
+    return mask_a, mask_b
