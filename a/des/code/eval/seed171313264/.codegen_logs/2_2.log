+    components = _find_components(g, bg)
+    n = len(components)
+    assert n > 0 and n % 2 == 0
+
+    fits_by_pair: dict[tuple[int, int], dict] = {}
+    for i in range(n):
+        for j in range(i + 1, n):
+            fits = _all_rectangle_fits(components[i], components[j], bg)
+            if fits:
+                fits_by_pair[(i, j)] = fits[0]
