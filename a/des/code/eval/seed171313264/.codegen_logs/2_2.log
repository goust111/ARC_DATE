+        return None
+    mask_b = ~mask_a
+    if not _cells_connected({tuple(map(int, cell)) for cell in np.argwhere(mask_a)}):
+        return None
+    if not _cells_connected({tuple(map(int, cell)) for cell in np.argwhere(mask_b)}):
+        return None
+    return mask_a, mask_b
