+BG = 0
+COLOR_POOL = tuple(range(1, 10))
+PAIR_COUNT_RANGE = (2, 4)
+RECT_HEIGHT_RANGE = (2, 6)
+RECT_WIDTH_RANGE = (2, 7)
+GRID_HEIGHT_RANGE = (18, 30)
+GRID_WIDTH_RANGE = (18, 30)
+MIN_PAIR_AREA = 6
+MAX_PAIR_AREA = 24
+PARTITION_ATTEMPTS = 80
+PLACEMENT_ATTEMPTS = 40
+GENERATION_ATTEMPTS = 300
