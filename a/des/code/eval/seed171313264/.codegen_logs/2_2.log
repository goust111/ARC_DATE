+    dilated[:, 1:] |= mask[:, :-1]
+    dilated[:, :-1] |= mask[:, 1:]
+    dilated[1:, 1:] |= mask[:-1, :-1]
+    dilated[1:, :-1] |= mask[:-1, 1:]
+    dilated[:-1, 1:] |= mask[1:, :-1]
+    dilated[:-1, :-1] |= mask[1:, 1:]
