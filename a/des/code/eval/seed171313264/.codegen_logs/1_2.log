        else:
            dc0, dc1 = 0, rect_w - 1
        rects.append((r0, dc0, r1, dc1, se))

    return rects


def _random_background(shape: tuple[int, int], grey_frac: float) -> np.ndarray:
    return np.where(np.random.random(shape) < grey_frac, BG_GREY, BG_ORANGE).astype(int)


