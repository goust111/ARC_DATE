GEN_SIDES = ["top", "right", "bottom", "left"]
GEN_SYMBOLIC_HW = (7, 6)
GEN_SYMBOLIC_VW = (6, 7)
GEN_DOMINANT_COUNT_RANGE = (13, 17)
GEN_ACCENT_COUNT_RANGE = (6, 8)
GEN_SPLIT_INDEX = 3

