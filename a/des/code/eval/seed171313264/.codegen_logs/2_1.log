+            c0 = int(rng.randint(1, W - fw - 1))
+            if not _box_is_free(occupied, r0, c0, fh, fw, pad=1):
+                continue
+            placed[idx] = dict(spec)
+            placed[idx]["fence_r0"] = int(r0)
+            placed[idx]["fence_c0"] = int(c0)
+            _mark_box(occupied, r0, c0, fh, fw, pad=1)
+            done = True
