+
+def _find_fence_groups(grid: np.ndarray, bg: int) -> dict[int, list[dict[str, int]]]:
+    h, w = grid.shape
+    groups: dict[int, list[dict[str, int]]] = {}
+    for color in map(int, np.unique(grid)):
