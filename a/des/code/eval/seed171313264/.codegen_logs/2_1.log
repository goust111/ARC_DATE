+    arr[mask] = int(color)
+    return arr
+
+
+def _tip_direction(mask: np.ndarray) -> str:
+    mask = _tight_crop(mask.astype(bool))
+    h, w = mask.shape
+    full_sides = []
+    if int(mask[0].sum()) == w:
+        full_sides.append("up")
+    if int(mask[-1].sum()) == w:
+        full_sides.append("down")
+    if int(mask[:, 0].sum()) == h:
+        full_sides.append("left")
+    if int(mask[:, -1].sum()) == h:
+        full_sides.append("right")
