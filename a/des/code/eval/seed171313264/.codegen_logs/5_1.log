+            c0 = max(0, left - 1)
+            r1 = min(height, top + rh + 1)
+            c1 = min(width, left + rw + 1)
+            if np.any(occupied[r0:r1, c0:c1]):
+                continue
+            patch = room_grid != BG
+            grid[top : top + rh, left : left + rw][patch] = room_grid[patch]
+            occupied[top : top + rh, left : left + rw] |= footprint
+            placed = True
+            break
+        if not placed:
+            return None
+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
