+GRID_W_RANGE = (24, 34)
+REGION_COUNT_RANGE = (1, 4)
+LEGEND_WIDTH = 6
+LEGEND_ENTRY_HEIGHT = 3
+LEGEND_GAP_CHOICES = (1, 2)
+PLAY_GAP = 2
+PLACEMENT_ATTEMPTS = 200
