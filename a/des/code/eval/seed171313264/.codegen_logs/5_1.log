+        template = template_map[key]
+        grid[row : row + 3, left : left + 3][marker] = legend_color
+        grid[row : row + 3, left + 3 : left + 6][template] = legend_color
+        row += LEGEND_ENTRY_HEIGHT
+        if idx < 3:
+            row += gaps[idx]
