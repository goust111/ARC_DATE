+
+    side_counts = Counter(spec["side"] for spec in specs)
+    if sum(side_counts.values()) != len(specs):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
