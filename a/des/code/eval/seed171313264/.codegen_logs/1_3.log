+        gap = spec["gap"]
+        for cell in border_cells(r0, c0, r1, c1):
+            if cell != gap:
+                grid[cell] = GEN_FRAME_COLOR
+        sr, sc = spec["seed"]
+        grid[sr, sc] = int(spec["seed_color"])
+    return grid
+
