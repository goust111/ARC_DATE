+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG_COLOR = 0
+GEN_FRAME_COLOR = 5
+GEN_GRID_H_RANGE = (14, 29)
+GEN_GRID_W_RANGE = (14, 29)
