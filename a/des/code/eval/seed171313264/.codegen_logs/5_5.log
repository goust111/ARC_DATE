+def _sample_legend_columns(width: int, count: int, rng: np.random.Generator) -> list[int]:
+    min_left = 1
+    min_right = 1
+    min_gap = 1
+    min_width = min_left + count + min_gap * (count - 1) + min_right
+    if min_width > width:
+        raise ValueError("legend does not fit")
