+
+
+def _shrink_connected_subset(mask: np.ndarray, target_area: int, rng: np.random.Generator) -> np.ndarray | None:
+    current = mask.copy()
+    while int(current.sum()) > target_area:
+        candidates = _removal_candidates(current)
+        if not candidates:
+            return None
