+    b0, b1, b2, b3 = comp_b["bbox"]  # type: ignore[index]
+    ha = int(a2 - a0 + 1)
+    wa = int(a3 - a1 + 1)
+    hb = int(b2 - b0 + 1)
+    wb = int(b3 - b1 + 1)
+    if (ha, wa) != (hb, wb):
+        return None
