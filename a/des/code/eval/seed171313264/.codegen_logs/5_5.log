+
+def _sample_orientations(n_pairs: int, rng: np.random.Generator) -> list[str]:
+    if n_pairs == 2:
+        values = ["h", "v"]
+    else:
+        values = ["h", "v", "h" if bool(rng.integers(2)) else "v"]
+    return [str(v) for v in rng.permutation(values)]
