+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _mask_connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return False
+    seen = {tuple(map(int, pts[0]))}
+    q = deque([tuple(map(int, pts[0]))])
+    h, w = mask.shape
+    while q:
+        r, c = q.popleft()
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def _spans_bbox(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any())
+
+
+def _component_mask(coords: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[int(r) - r0, int(c) - c0] = True
+    return mask
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict[str, object]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            bbox = bbox_coords(arr)
+            components.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "area": int(arr.shape[0]),
+                    "bbox": bbox,
+                    "mask": _component_mask(arr, bbox),
