+        hub = (int(rng.integers(h)), int(rng.integers(w)))
+        anchors = [
+            (0, int(rng.integers(w))),
+            (h - 1, int(rng.integers(w))),
+            (int(rng.integers(h)), 0),
+            (int(rng.integers(h)), w - 1),
