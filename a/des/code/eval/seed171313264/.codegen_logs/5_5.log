+from __future__ import annotations
+
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+GEN_RETRIES = 300
+PAIR_COUNT_CHOICES = (2, 3)
+GRID_H_MIN = 14
+GRID_H_MAX = 24
+GRID_W_MIN = 18
+GRID_W_MAX = 36
