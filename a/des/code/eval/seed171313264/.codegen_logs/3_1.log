+
+        seed_r, seed_c = map(int, coords[rng.randrange(len(coords))])
+        grid[seed_r, seed_c] = spec["color"]
+
+        spec["coords"] = coords
+        spec["seed"] = (seed_r, seed_c)
+        spec["pattern"] = pattern
+        legends.append({"color": spec["color"], "block": _legend_block(spec["color"], pattern)})
