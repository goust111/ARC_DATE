+        if total_w > grid.shape[1]:
+            return False
+        col = rng.randint(0, grid.shape[1] - total_w)
+        for idx, item in enumerate(order):
+            block = item["block"]
+            bh, bw = block.shape
+            top = grid.shape[0] - bh
+            if np.any(grid[top : top + bh, col : col + bw] != GEN_BG):
+                return False
