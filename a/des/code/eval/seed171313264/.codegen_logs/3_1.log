+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    padded = np.pad(mask, 1)
+    out = np.zeros_like(mask, dtype=bool)
+    for dr in range(3):
+        for dc in range(3):
+            out |= padded[dr : dr + h, dc : dc + w]
+    return out
