+            blob = blob[r0 : r1 + 1, c0 : c1 + 1]
+            if min(blob.shape) < 2 or int(blob.sum()) < 4:
+                continue
+            bbox_area = blob.shape[0] * blob.shape[1]
+            if bbox_area == int(blob.sum()) and rng.random() < 0.8:
