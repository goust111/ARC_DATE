+    legend_capacity = width if side == "bottom" else height
+    max_regions = min(MAX_REGIONS, max(1, (legend_capacity + 1) // 6))
+    n_regions = rng.randint(1, max_regions)
+    colors = rng.sample(list(GEN_COLORS), n_regions)
