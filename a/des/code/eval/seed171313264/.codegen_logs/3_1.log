+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    height = rng.randint(*GRID_H_RANGE)
+    width = rng.randint(*GRID_W_RANGE)
+    side = rng.choice(("bottom", "right"))
