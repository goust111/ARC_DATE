+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            queue: deque[tuple[int, int]] = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while queue:
+                cr, cc = queue.popleft()
+                comp.append((int(cr), int(cc)))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((int(nr), int(nc)))
+            comps.append(comp)
+    return comps
+
+
+def _flood_from_border(passable: np.ndarray) -> np.ndarray:
+    h, w = passable.shape
+    seen = np.zeros_like(passable, dtype=bool)
+    queue: deque[tuple[int, int]] = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if passable[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                queue.append((int(r), int(c)))
+    for c in range(w):
+        for r in (0, h - 1):
+            if passable[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                queue.append((int(r), int(c)))
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and passable[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                queue.append((int(nr), int(nc)))
+    return seen
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _mask_bbox(mask: np.ndarray) -> tuple[int, int, int, int]:
+    rows = np.where(mask.any(axis=1))[0]
+    cols = np.where(mask.any(axis=0))[0]
+    assert rows.size > 0 and cols.size > 0, "pattern must be nonempty"
+    return int(rows[0]), int(cols[0]), int(rows[-1]), int(cols[-1])
