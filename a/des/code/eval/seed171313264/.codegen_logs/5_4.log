+def _paste_nonzero(dst: np.ndarray, src: np.ndarray, top: int, left: int) -> bool:
+    h, w = src.shape
+    view = dst[top : top + h, left : left + w]
+    src_mask = src != BG
+    overlap = src_mask & (view != BG)
+    if bool(np.any(view[overlap] != src[overlap])):
+        return False
+    view[src_mask] = src[src_mask]
+    return True
