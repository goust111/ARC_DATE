+def _symmetry_flags(mask: np.ndarray) -> tuple[bool, bool, bool]:
+    lr = bool(np.array_equal(mask, np.fliplr(mask)))
+    ud = bool(np.array_equal(mask, np.flipud(mask)))
+    rot = bool(np.array_equal(mask, np.rot90(mask, 2)))
+    return lr, ud, rot
