+    n = len(bboxes)
+    starts = [int(box[start_idx]) for box in bboxes]
+    ends = [int(box[end_idx]) for box in bboxes]
+    order = sorted(range(n), key=lambda idx: (starts[idx], ends[idx], idx))
+    pos = [0] * n
+    for j in order:
+        best = 0
+        for i in order:
