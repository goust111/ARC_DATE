+def _transform_pattern(pattern: np.ndarray) -> np.ndarray:
+    mask = pattern != BG
+    assert bool(mask.any())
+    lr, ud, rot = _symmetry_flags(mask)
+    if lr:
+        return np.flipud(pattern)
+    if ud:
