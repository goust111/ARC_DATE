+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+WALL = 7
+
+LR_KIND = "lr"
+UD_KIND = "ud"
+ROT_KIND = "rot"
+NONE_KIND = "none"
+KINDS = (LR_KIND, UD_KIND, ROT_KIND, NONE_KIND)
+
+GEN_ATTEMPTS = 500
+LAYOUT_CHOICES = ((1, 2), (2, 1), (1, 3), (3, 1), (2, 2), (2, 3), (3, 2))
+ROOM_OUTER_RANGE = (7, 9)
+SEPARATED_GAP_RANGE = (1, 3)
+MARGIN_RANGE = (1, 4)
