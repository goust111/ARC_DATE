+    prob = random.uniform(0.28, 0.60)
+    for r in range(h):
+        for c in range(w):
+            if (r, c) in seen:
+                continue
+            rr, cc = h - 1 - r, w - 1 - c
+            value = random.random() < prob
+            mask[r, c] = value
+            mask[rr, cc] = value
