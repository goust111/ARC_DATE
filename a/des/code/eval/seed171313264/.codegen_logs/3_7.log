+def _ordered_pair(a: tuple[int, int], b: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
+    a = (int(a[0]), int(a[1]))
+    b = (int(b[0]), int(b[1]))
+    return (a, b) if a <= b else (b, a)
