+    def consider(values: np.ndarray, coords: list[tuple[int, int]]) -> None:
+        non_bg_idx = [i for i, v in enumerate(values) if int(v) != bg]
+        if len(non_bg_idx) < 2:
+            return
+        if non_bg_idx != list(range(non_bg_idx[0], non_bg_idx[-1] + 1)):
+            return
