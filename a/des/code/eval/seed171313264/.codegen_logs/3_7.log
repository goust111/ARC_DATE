+    assert len(candidates) == 1, "expected exactly one border priority strip"
+    return candidates[0]
+
+
+def _identify_scene(
+    grid: np.ndarray,
+) -> tuple[int, list[int], set[tuple[int, int]], dict[int, tuple[tuple[int, int], tuple[int, int]]], np.ndarray]:
