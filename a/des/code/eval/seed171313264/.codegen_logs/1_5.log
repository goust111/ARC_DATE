+TEMPLATE_COUNT_OPTIONS = (3, 4)
+TEMPLATE_HEIGHT_RANGE = (2, 4)
+TEMPLATE_WIDTH_RANGE = (2, 4)
+TEMPLATE_DENSITY_RANGE = (0.35, 0.75)
+TEMPLATE_RETRY_LIMIT = 200
