+    return out
+
+
+def _paste_nonzero(dst: np.ndarray, src: np.ndarray, top: int, left: int) -> None:
+    h, w = src.shape
+    view = dst[top : top + h, left : left + w]
+    mask = src != BG
+    view[mask] = src[mask]
