+def _left_components(g: np.ndarray, divider: int) -> list[tuple[int, np.ndarray]]:
+    left = g[:, :divider]
+    h, w = left.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[tuple[int, np.ndarray]] = []
