+                if not mask[r, c] and random.random() < density:
+                    mask[r, c] = True
+
+        if bool(mask.all()):
+            rr = random.randrange(h)
+            cc = random.randrange(w)
+            mask[rr, cc] = False
+
+        if int(mask.sum()) <= 1 or int((~mask).sum()) == 0:
+            continue
+
+        key = (h, w, tuple(int(v) for v in mask.ravel()))
+        if key in existing:
