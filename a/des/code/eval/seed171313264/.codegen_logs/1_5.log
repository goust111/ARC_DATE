+            else:
+                candidate[h - depth :, start:stop] = False
+        elif side in ("left", "right") and w >= 4:
+            depth = random.randint(1, min(2, w - 2))
+            start = random.randint(1, h - 2)
+            stop = random.randint(start + 1, h)
+            if side == "left":
+                candidate[start:stop, :depth] = False
+            else:
