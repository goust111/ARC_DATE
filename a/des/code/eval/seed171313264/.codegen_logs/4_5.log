def _ray_limit(
    cell: tuple[int, int],
    steps: int,
    direction: tuple[int, int],
    top: int,
    bottom: int,
    garden_w: int,
) -> int:
    r, c = cell
    dr, dc = direction
    limit = 0
    for step in range(1, int(steps) + 1):
        nr = int(r + dr * step)
        nc = int(c + dc * step)
        if nr < int(top) or nr > int(bottom) or nc < 0 or nc >= int(garden_w):
            break
        limit += 1
    return limit


