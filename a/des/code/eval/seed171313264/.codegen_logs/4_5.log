+        for r, c in _grown_cells(seed_cells, steps, legend[stripe_color], region_top, region_bottom, garden_w):
+            out[r, c] = ORANGE
+
+    assert prev_stripe == h - 1, "the final region must be closed by a bottom stripe"
+    return out
