+        shape = _flip_h(shape)
+    if random.random() < 0.5:
+        shape = _flip_v(shape)
+    return shape
+
+
+def _ray_limit(
+    cell: tuple[int, int],
+    steps: int,
+    direction: tuple[int, int],
+    top: int,
+    bottom: int,
+    garden_w: int,
+) -> int:
+    r, c = cell
+    dr, dc = direction
+    limit = 0
+    for step in range(1, int(steps) + 1):
+        nr = int(r + dr * step)
+        nc = int(c + dc * step)
