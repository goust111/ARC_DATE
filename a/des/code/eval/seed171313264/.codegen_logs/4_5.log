+def _legend_mapping(grid: np.ndarray, panel: tuple[int, int, int, int]) -> dict[int, tuple[int, int]]:
+    pr0, pc0, pr1, pc1 = panel
+    inner = grid[pr0 + 1 : pr1, pc0 + 1 : pc1]
