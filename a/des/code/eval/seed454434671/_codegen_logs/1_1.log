+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+GRAY = 5
+BG = 0
+COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MISSING_BY_DIR = {
+    "up": (0, 1),
+    "right": (1, 2),
+    "down": (2, 1),
+    "left": (1, 0),
+}
+QUADRANTS = {
+    "up": (0, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (1, 1),
+}
+SIDES = ["left", "right", "up", "down"]
+MAX_RETRIES = 400
