+
+
+def _random_templates(rng: random.Random, h: int, w: int) -> dict[str, np.ndarray]:
+    seen: set[tuple[int, ...]] = set()
+    templates: dict[str, np.ndarray] = {}
+    for direction in ["up", "right", "down", "left"]:
