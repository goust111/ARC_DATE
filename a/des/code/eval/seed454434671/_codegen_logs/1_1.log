+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _extract_templates(grid: np.ndarray) -> dict[str, np.ndarray]:
+    box = _bbox(grid == GRAY)
