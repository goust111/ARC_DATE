+    bg = int(Counter(map(int, g.ravel())).most_common(1)[0][0])
+    templates = _extract_templates(g)
+    out = g.copy()
+
+    for color in sorted(set(map(int, np.unique(g))) - {bg, GRAY}):
+        comps = _components_of_color(g, color)
+        seed = None
