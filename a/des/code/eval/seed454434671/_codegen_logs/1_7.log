+            return None
+        window[mask] = shelf_color
+        placed.append((row, col, mask))
+        cursor += extents[i]
+        if i < len(gaps):
+            cursor += gaps[i]
+    return placed
+
+
+def _build_expected(inp: np.ndarray, rooms: list[dict[str, object]], order: list[int]) -> np.ndarray:
+    out = inp.copy()
