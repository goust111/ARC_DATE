+
+    inp = np.full((height, width), BG, dtype=int)
+    for room, (top, left) in zip(rooms, locations):
+        markers = _draw_room(inp, room, top, left, wall_color, int(room["marker_color"]))
+        if markers is None:
+            return None
+
+    room_order = sorted(
+        range(n_rooms),
+        key=lambda idx: min(
+            int(r) * width + int(c)
+            for r, c in rooms[idx]["marker_positions"]
