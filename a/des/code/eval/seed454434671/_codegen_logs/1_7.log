+    bottom_pad = SHELF_THICKNESS + 1 if edge == "bottom" else 1
+    left_pad = SHELF_THICKNESS + 1 if edge == "left" else 1
+    right_pad = SHELF_THICKNESS + 1 if edge == "right" else 1
