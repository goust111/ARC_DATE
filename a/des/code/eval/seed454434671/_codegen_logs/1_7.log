+    if _place_shelf(inp, ordered_shelf_patterns, shelf_color, edge) is None:
+        return None
+
+    expected = _build_expected(inp, rooms, room_order)
+    try:
+        actual = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
