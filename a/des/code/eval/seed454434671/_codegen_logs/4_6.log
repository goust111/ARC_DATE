+def _cells_connected(cells):
+    cells = set(cells)
+    start = next(iter(cells))
+    seen = {start}
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if (nr, nc) in cells and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return len(seen) == len(cells)
+
+
+def _hole_free(cells, h, w):
+    filled = set(cells)
+    start = (-1, -1)
+    seen = {start}
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if not (-1 <= nr <= h and -1 <= nc <= w):
+                continue
+            if (nr, nc) in seen:
+                continue
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) in filled:
+                continue
+            seen.add((nr, nc))
+            q.append((nr, nc))
+    for r in range(h):
+        for c in range(w):
+            if (r, c) not in filled and (r, c) not in seen:
+                return False
+    return True
