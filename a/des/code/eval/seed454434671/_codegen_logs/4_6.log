+def _smaller_shapes(template):
+    parity = template["parity"]
+    return [
+        shape
+        for shape in SHAPES_BY_PARITY[parity]
+        if shape["area"] < template["area"] and shape["h"] <= template["h"] and shape["w"] <= template["w"]
+    ]
