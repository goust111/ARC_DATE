+            if c > 0 and r in staff_set and value == staff_color:
+                continue
+
+            target_row = _nearest_staff_row(int(r), staff_rows)
+            out[int(target_row), int(c)] = int(key_by_row[int(target_row)])
+
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
