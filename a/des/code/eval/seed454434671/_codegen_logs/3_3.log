    hits: list[int] = []
    for r in rows:
        c = side_col + dc
        while 0 <= c < g.shape[1]:
            if int(g[r, c]) == bg:
                c += dc
                continue
            source_id = source_ids.get((int(r), int(c)))
            if source_id is not None:
                hits.append(source_id)
            break
    return hits


