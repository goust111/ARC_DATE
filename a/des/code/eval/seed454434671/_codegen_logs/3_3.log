+        "nodes": nodes,
+        "parents": parents,
+        "valves": valves,
+        "valve_points": valve_points,
+    }
+
+
+def _build_star_three() -> dict[str, object]:
+    colors = random.sample(list(PRIMARY_TO_BITS), 3)
+    nodes = {
