+    for _ in range(rotation % 4):
+        r, c = c, -r
+    return int(r), int(c)
+
+
+def _random_length() -> int:
+    return random.randint(*LENGTH_RANGE)
+
+
+def _build_two_mix() -> dict[str, object]:
+    colors = random.sample(list(PRIMARY_TO_BITS), 2)
+    nodes = {
+        "S": (_random_length(), 0),
+        "J": (0, 0),
+        "A": (0, -_random_length()),
+        "B": (0, _random_length()),
