+            for _edge_id, msg in incoming:
+                bits |= msg
+            node_bits[node] = bits
+            return bits
+        return None
+
+    dfs(sink)
+
+    out = g.copy()
+    for edge_id, bits in edge_bits.items():
+        color = BITS_TO_COLOR[bits]
+        for r, c in edges[edge_id]["cells"]:
+            out[r, c] = color
+
+    for node, bits in node_bits.items():
+        out[node] = BITS_TO_COLOR[bits]
+
+    return out
+
