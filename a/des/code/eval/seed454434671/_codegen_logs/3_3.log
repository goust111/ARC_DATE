+                assert len(nxts) == 1, "degree-2 pipe cells must continue uniquely"
+                nxt = nxts[0]
+                used_segments.add(frozenset({cur, nxt}))
+                prev, cur = cur, nxt
+            path.append(cur)
+
+            edge_id = len(edges)
+            edges.append({"a": node, "b": cur, "cells": path})
+            adj[node].append((cur, edge_id))
+            adj[cur].append((node, edge_id))
