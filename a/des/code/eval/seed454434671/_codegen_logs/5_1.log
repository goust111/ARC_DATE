+    pairs: list[dict] = []
+    used: set[int] = set()
+    for (h, w), indices in groups.items():
+        by_mask: dict[bytes, list[int]] = defaultdict(list)
+        for idx in indices:
+            key = fragments[idx]["mask"].astype(np.uint8).tobytes()
+            by_mask[key].append(idx)
