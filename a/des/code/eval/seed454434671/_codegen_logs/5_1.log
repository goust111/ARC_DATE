+    for _ in range(PLACEMENT_ATTEMPTS):
+        H = int(RNG.integers(min_side, GRID_SIDE_MAX + 1))
+        W = int(RNG.integers(min_side, GRID_SIDE_MAX + 1))
+        grid = _place_patches(H, W, patches)
+        if grid is None:
+            continue
+        if np.array_equal(main(grid), expected):
+            return grid
+    return None
