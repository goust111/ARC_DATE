+def _stack_rectangles(pairs: list[dict]) -> np.ndarray:
+    assert pairs, "at least one complementary pair is required"
+    ordered = sorted(
+        pairs,
+        key=lambda pair: (
+            int(pair["area"]),
+            int(pair["h"]),
+            int(pair["w"]),
+            pair["signature"],
