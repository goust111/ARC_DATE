+        assert _is_connected(mask), "each color must form exactly one connected fragment"
+        fragments.append(
+            {
+                "color": color,
+                "r0": r0,
+                "c0": c0,
+                "h": int(mask.shape[0]),
+                "w": int(mask.shape[1]),
+                "mask": mask,
+            }
+        )
