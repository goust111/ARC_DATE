+def _generate_attempt() -> np.ndarray | None:
+    pair_count = int(RNG.choice(np.array(PAIR_COUNT_CHOICES, dtype=int)))
+    pair_specs = _sample_pair_specs(pair_count)
+    if pair_specs is None:
+        return None
