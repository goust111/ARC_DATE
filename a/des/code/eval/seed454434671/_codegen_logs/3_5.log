+        r, c = gap_r + dr, gap_c + dc
+        for _ in range(trunk_len):
+            if 0 <= r < h and 0 <= c < w:
+                out[r, c] = GREEN
+                trunk.append((r, c))
+            r += dr
+            c += dc
+
+        for idx, (_sr, _sc, color) in enumerate(seeds):
+            if 2 * idx >= len(trunk):
+                break
+            br, bc = trunk[2 * idx]
+            sdr, sdc = _branch_dir((dr, dc), idx)
+            for step in (1, 2):
+                rr = br + sdr * step
+                cc = bc + sdc * step
+                if 0 <= rr < h and 0 <= cc < w:
+                    out[rr, cc] = color
+
+    return out
