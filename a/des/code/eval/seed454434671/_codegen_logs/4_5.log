+
+
+def _find_sources(
+    grid: np.ndarray,
+    legend_bbox: tuple[int, int, int, int],
+    source_colors: set[int],
+    node_index: dict[tuple[int, int], int],
+    degrees: dict[tuple[int, int], int],
+) -> dict[int, int]:
+    r0, c0, r1, c1 = legend_bbox
+    base_colors: dict[int, int] = {}
