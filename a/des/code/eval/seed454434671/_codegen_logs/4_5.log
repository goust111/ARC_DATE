+
+def _parse_legend(
+    grid: np.ndarray,
+) -> tuple[tuple[int, int, int, int], dict[frozenset[int], int], dict[int, frozenset[int]], dict[frozenset[int], int], set[int]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    candidates = []
+    for r in range(h - 2):
+        for c in range(w - 2):
