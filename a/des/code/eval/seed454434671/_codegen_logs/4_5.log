+    return r, c
+
+
+def _reflect_cell(cell: tuple[int, int]) -> tuple[int, int]:
+    return cell[0], -cell[1]
+
+
+def _apply_transform(
+    cells: list[tuple[int, int]],
+    turns: int,
+    reflect: bool,
+) -> list[tuple[int, int]]:
