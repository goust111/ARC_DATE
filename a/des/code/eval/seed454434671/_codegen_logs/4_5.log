+        assert color in source_colors, "non-legend colored pixels must be signal sources"
+        touching = []
+        for dr, dc in DIRS4:
+            pipe_cell = (rr + dr, cc + dc)
+            if pipe_cell in node_index and degrees[pipe_cell] <= 1:
