+    seen_nodes: set[int] = set()
+    component_count = 0
+    for node_id in range(len(node_cells)):
+        if node_id in seen_nodes:
+            continue
+        component_count += 1
+        stack = [node_id]
+        seen_nodes.add(node_id)
+        while stack:
+            cur = stack.pop()
