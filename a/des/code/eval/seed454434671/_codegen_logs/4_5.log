+            end_id = node_index[cur]
+            seg_id = len(segments)
+            segments.append({"u": start_id, "v": end_id, "path": path})
+            adjacency[start_id].append((end_id, seg_id))
+            adjacency[end_id].append((start_id, seg_id))
