+
+def _leaf_branch(
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    rng: random.Random,
+    allow_bend: bool = True,
+) -> tuple[list[tuple[int, int]], tuple[int, int]]:
+    pos = start
+    path = [start]
+    leg1 = rng.randint(2, 4)
+    for _ in range(leg1):
+        pos = _add(pos, direction)
+        path.append(pos)
