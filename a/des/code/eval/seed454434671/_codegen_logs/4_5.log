+    out = g.copy()
+    for node_id, cell in enumerate(node_cells):
+        color = node_color(node_id)
+        if color is not None:
+            out[cell] = color
+
+    for segment in segments:
+        u = int(segment["u"])
+        v = int(segment["v"])
+        path = list(segment["path"])
+        forward = message(u, v)
+        backward = message(v, u)
