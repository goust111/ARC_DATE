+import numpy as np
+
+
+BG = 0
+PIPE = 5
+
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+MAGENTA = 6
+ORANGE = 7
+
+N = (-1, 0)
+S = (1, 0)
+W = (0, -1)
+E = (0, 1)
+DIRS4 = (N, S, W, E)
+LEFT_TURN = {N: W, W: S, S: E, E: N}
+RIGHT_TURN = {N: E, E: S, S: W, W: N}
+
+PRIMARY_COLORS = (RED, BLUE, YELLOW)
+PAIR_RESULTS = {
