+    forbidden: set[tuple[int, int]],
+    rng: random.Random,
+) -> tuple[list[tuple[int, int]], list[int]] | None:
+    segments = data["segments"]
+    degree = data["degree"]
+    open_cells = data["open_cells"]
+    row_id = data["row_id"]
