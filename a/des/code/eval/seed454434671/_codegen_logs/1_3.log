+
+    return legend, mask
+
+
+def _find_legend(grid: np.ndarray) -> Tuple[Dict[frozenset[int], int], np.ndarray]:
+    candidates = []
+    for top, left in ((True, True), (True, False), (False, True), (False, False)):
