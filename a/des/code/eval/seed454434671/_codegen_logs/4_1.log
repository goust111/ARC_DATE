+def _has_hole(mask: np.ndarray) -> bool:
+    bg = ~mask
+    if not np.any(bg):
+        return False
+
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    stack: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in (0, w - 1):
+            if bg[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
