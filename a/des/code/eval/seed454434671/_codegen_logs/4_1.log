+def _parse_legend(g: np.ndarray, bg: int) -> tuple[dict[int, np.ndarray], int]:
+    left = _legend_left(g, bg)
+    legend = g[:, left:]
+    h = legend.shape[0]
+    used = np.zeros_like(legend, dtype=bool)
+    mapping: dict[int, np.ndarray] = {}
