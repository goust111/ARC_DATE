+def _tight_mask(mask: np.ndarray) -> np.ndarray:
+    rows, cols = np.where(mask)
+    assert rows.size, "expected a nonempty mask"
+    return mask[rows.min() : rows.max() + 1, cols.min() : cols.max() + 1]
+
