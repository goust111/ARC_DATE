+    adj = _adjacency_from_crop(crop, placed_id, len(matched))
+    final_colors = orig_colors[:]
+    for i in range(len(matched)):
+        larger = [j for j in adj[i] if areas[j] > areas[i] and orig_colors[j] != orig_colors[i]]
+        if not larger:
