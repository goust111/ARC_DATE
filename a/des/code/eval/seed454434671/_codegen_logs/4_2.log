+        if not larger:
+            continue
+        max_area = max(areas[j] for j in larger)
+        best = sorted(j for j in larger if areas[j] == max_area)
+        chosen_colors = {orig_colors[j] for j in best}
+        if len(chosen_colors) == 1:
+            final_colors[i] = int(next(iter(chosen_colors)))
