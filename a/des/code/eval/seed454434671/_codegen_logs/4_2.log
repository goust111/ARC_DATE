+            test = np.zeros_like(grid, dtype=bool)
+            test[r0 : r0 + ph, c0 : c0 + pw][mask] = True
+            if bool((_dilated(occupied) & test).any()):
+                continue
+            _paint_mask(grid, mask, r0, c0, colors[idx])
+            occupied |= test
+            placed = True
+            break
+        if not placed:
+            return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    n = random.randint(3, 5)
