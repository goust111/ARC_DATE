+        cs = coords[:, 1]
+        return int(rs.min()), int(cs.min()), int(rs.max()), int(cs.max())
+    rs = [int(r) for r, _ in coords]
+    cs = [int(c) for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
