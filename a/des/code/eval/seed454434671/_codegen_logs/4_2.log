+    h, w = map(int, crop.shape)
+    adj = [set() for _ in range(count)]
+    for r in range(h):
+        for c in range(w):
+            if int(crop[r, c]) != GREY:
+                continue
+            if 0 < c < w - 1:
+                a = int(placed_id[r, c - 1])
+                b = int(placed_id[r, c + 1])
+                if a >= 0 and b >= 0 and a != b:
+                    adj[a].add(b)
+                    adj[b].add(a)
+            if 0 < r < h - 1:
+                a = int(placed_id[r - 1, c])
+                b = int(placed_id[r + 1, c])
+                if a >= 0 and b >= 0 and a != b:
+                    adj[a].add(b)
+                    adj[b].add(a)
