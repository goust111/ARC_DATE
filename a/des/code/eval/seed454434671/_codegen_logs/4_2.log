+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+PIECE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+GENERATION_ATTEMPTS = 400
+SHAPE_ATTEMPTS = 300
+PLACE_ATTEMPTS = 300
