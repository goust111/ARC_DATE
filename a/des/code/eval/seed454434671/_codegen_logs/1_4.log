+def _all_placements(region_h: int, region_w: int, mask: np.ndarray) -> list[set[tuple[int, int]]]:
+    mh, mw = mask.shape
+    placements: list[set[tuple[int, int]]] = []
+    for top in range(1, region_h - mh):
+        for left in range(1, region_w - mw):
+            cells = {
+                (top + dr, left + dc)
+                for dr in range(mh)
+                for dc in range(mw)
+                if mask[dr, dc]
