+        pointer_coords = coords[values == pointer_color]
+        fill_coords = coords[values == fill_color]
+        parsed_regions.append(
+            {
+                "bbox": _bbox(coords),
+                "direction": _decode_pointer(pointer_coords),
+                "fill_color": int(fill_color),
+                "fill_coords": fill_coords,
