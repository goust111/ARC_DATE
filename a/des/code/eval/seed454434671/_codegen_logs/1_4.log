+def _perimeter_cycle(rows: int, cols: int) -> list[tuple[int, int]]:
+    order: list[tuple[int, int]] = []
+    for c in range(cols):
+        order.append((0, c))
+    for r in range(1, rows):
+        order.append((r, cols - 1))
+    for c in range(cols - 2, -1, -1):
+        order.append((rows - 1, c))
+    for r in range(rows - 2, 0, -1):
+        order.append((r, 0))
+    return order
+
