+def _direction_between(src: tuple[int, int], dst: tuple[int, int]) -> str:
+    dr = dst[0] - src[0]
+    dc = dst[1] - src[1]
+    for direction, (rr, cc) in DIRS.items():
+        if (dr, dc) == (rr, cc):
+            return direction
+    raise AssertionError("cycle must move through side-adjacent cells")
+
