/home/lixinyu/snap/a/des/seed454434671/2/codegen_prompts/5.md:377:  "dst": "align to isolated border pixel d (same marker color)",
/home/lixinyu/snap/a/des/seed454434671/2/codegen_prompts/5.md:378:  "match_cond": "s.marker.color == d.color",
