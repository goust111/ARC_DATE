/home/lixinyu/snap/a/des/seed454434671/2/codegen_prompts/5.md:251:  "src": "black square",
/home/lixinyu/snap/a/des/seed454434671/2/codegen_prompts/5.md:252:  "path": "blue pixels \"water channel\" that is wide enough to pass through until \"stuck\" because of too narrow",
/home/lixinyu/snap/a/des/seed454434671/2/codegen_prompts/5.md:253:  "dst": "reach same sized red square or \"get stuck\" on the way where the blue path is too narrow",
/home/lixinyu/snap/a/des/seed454434671/2/codegen_prompts/5.md:254:  "transform": "cover the red square if reaching it"
