/home/lixinyu/snap/a/des/seed454434671/2/codegen_prompts/1.md:255:  "src": "hollow sprites with colored borders s",
/home/lixinyu/snap/a/des/seed454434671/2/codegen_prompts/1.md:256:  "dst": "interior of same sprite d",
/home/lixinyu/snap/a/des/seed454434671/2/codegen_prompts/1.md:257:  "match_cond": "d.fill_color == palette_lookup(s.border_color)",
/home/lixinyu/snap/a/des/seed454434671/2/codegen_prompts/1.md:258:  "path": "",
