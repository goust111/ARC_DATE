+                hi = int(cols[-1]) + c0
+                before = work[r, lo : hi + 1].copy()
+                work[r, lo : hi + 1] = True
+                if not np.array_equal(before, work[r, lo : hi + 1]):
+                    changed = True
+
+        for c in active_cols:
