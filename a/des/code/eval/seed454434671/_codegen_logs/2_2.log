+def _line_rows_and_cols(grid: np.ndarray) -> tuple[list[int], list[int]]:
+    line_rows = [int(r) for r in range(grid.shape[0]) if np.all(grid[r] == GREY)]
+    line_cols = [int(c) for c in range(grid.shape[1]) if np.all(grid[:, c] == GREY)]
