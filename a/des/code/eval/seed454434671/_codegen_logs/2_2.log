/home/lixinyu/snap/a/des/seed454434671/2/codegen_prompts/2.md:305:  "type": "move_to_match",
/home/lixinyu/snap/a/des/seed454434671/2/codegen_prompts/2.md:306:  "src": "gray one-cell-thick bars s",
/home/lixinyu/snap/a/des/seed454434671/2/codegen_prompts/2.md:307:  "dst": "4-adjacent solid orange rectangles d",
/home/lixinyu/snap/a/des/seed454434671/2/codegen_prompts/2.md:308:  "match_cond": "s 4-touches d",
/home/lixinyu/snap/a/des/seed454434671/2/codegen_prompts/2.md:309:  "transform": "erase s to yellow; in each matched d, repaint |matched s cells| orange cells gray as complete rows for horizontal bars or complete columns for vertical bars from the touched edge"
/home/lixinyu/snap/a/des/seed454434671/2/codegen_prompts/2.md:310:}
