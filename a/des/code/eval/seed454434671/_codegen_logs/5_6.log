+        ("top", seed_r - r0),
+        ("right", c1 - seed_c),
+        ("bottom", r1 - seed_r),
+        ("left", seed_c - c0),
+    ]
+    best = min(dist for _side, dist in distances)
+    sides = [side for side, dist in distances if dist == best]
+    assert len(sides) == 1
+    return sides[0], int(best)
