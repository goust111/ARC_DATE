+        grid[top : top + interior_h + 2, left] = FRAME_COLOR
+        grid[top : top + interior_h + 2, left + interior_w + 1] = FRAME_COLOR
+        grid[top + 1 + int(seed_r), left + 1 + int(seed_c)] = color
