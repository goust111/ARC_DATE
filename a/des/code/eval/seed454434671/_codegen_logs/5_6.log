+
+    cycle = _boundary_cycle(ir0, ic0, ir1, ic1)
+    cycle_index = {pos: idx for idx, pos in enumerate(cycle)}
+    idx = cycle_index[target]
+    budget = len(cycle)
+    for _ in range(budget - straight_len):
+        idx = (idx + 1) % len(cycle)
+        nxt = cycle[idx]
+        if nxt == seed:
+            break
+        if out[nxt] == BG:
+            out[nxt] = color
