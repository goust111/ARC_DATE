+        n_frames = int(rng.integers(1, 5))
+        height = int(rng.integers(18 + 2 * n_frames, 31))
+        width = int(rng.integers(18 + 2 * n_frames, 31))
+        specs = _sample_specs(rng, n_frames)
+        placed = _try_place_rectangles(height, width, specs, rng)
+        if placed is None:
