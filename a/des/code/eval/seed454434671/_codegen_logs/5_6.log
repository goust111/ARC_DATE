+        frame_w = int(spec["interior_w"]) + 2
+        if frame_h + 2 > height or frame_w + 2 > width:
+            return None
+
+        success = False
+        for _ in range(200):
+            top = int(rng.integers(1, height - frame_h))
+            left = int(rng.integers(1, width - frame_w))
