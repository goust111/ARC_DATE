+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = mask.copy()
+    coords = np.argwhere(mask)
+    for r, c in coords:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                rr = int(r) + dr
+                cc = int(c) + dc
+                if 0 <= rr < h and 0 <= cc < w:
