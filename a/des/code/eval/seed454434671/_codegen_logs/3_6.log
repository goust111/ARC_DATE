+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+RED = 2
+BLUE = 1
+GREEN = 3
+BORDER_TRANSFORMS = {RED: "h", BLUE: "v", GREEN: "n"}
+KEY_COLORS = (4, 6, 7, 8, 9)
+FRAME_SUBSETS = (
+    (RED, BLUE),
+    (RED, GREEN),
+    (BLUE, GREEN),
+    (RED, BLUE, GREEN),
+)
+GEN_ATTEMPTS = 300
