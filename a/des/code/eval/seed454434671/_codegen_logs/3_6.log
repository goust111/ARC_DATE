+
+def _find_keys(grid: np.ndarray, frames: list[dict], bg: int) -> dict[int, dict]:
+    h, w = grid.shape
+    outside = np.ones((h, w), dtype=bool)
+    for frame in frames:
+        r0, c0, r1, c1 = frame["bbox"]
+        outside[r0 : r1 + 1, c0 : c1 + 1] = False
