+PATTERN_TO_DIR = {
+    frozenset({(0, 0), (1, 0), (2, 0), (1, 1)}): ("R", (1, 1)),
+    frozenset({(1, 0), (0, 1), (1, 1), (2, 1)}): ("L", (1, 0)),
+    frozenset({(0, 0), (0, 1), (0, 2), (1, 1)}): ("D", (1, 1)),
+    frozenset({(0, 1), (1, 0), (1, 1), (1, 2)}): ("U", (0, 1)),
+}
+
+TIP_SHAPES = {
+    "R": ((0, 0), (-1, -1), (0, -1), (1, -1)),
+    "L": ((0, 0), (-1, 1), (0, 1), (1, 1)),
+    "D": ((0, 0), (-1, -1), (-1, 0), (-1, 1)),
+    "U": ((0, 0), (1, -1), (1, 0), (1, 1)),
+}
+
+DIR_ORDER = ("R", "L", "U", "D")
+COLOR_POOL = tuple(range(1, 10))
+
+GRID_H_RANGE = (14, 22)
+GRID_W_RANGE = (14, 22)
+PALETTE_SIZE_RANGE = (3, 6)
+CHAIN_GAP_RANGE = (4, 8)
