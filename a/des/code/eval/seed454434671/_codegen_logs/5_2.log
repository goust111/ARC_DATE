+    step = 0
+
+    while True:
+        step += 1
+        r += dr
+        c += dc
+        if not (0 <= r < shape[0] and 0 <= c < shape[1]):
+            return path, None, None
+        hit = owner.get((r, c))
+        if hit is not None and hit != idx:
+            return path, int(hit), step
