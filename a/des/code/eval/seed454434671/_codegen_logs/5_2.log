+        if trace["hit_target"] is None:
+            continue
+        next_target = int(trace["hit_target"])
+        next_time = int(time) + int(trace["hit_steps"])
+        heapq.heappush(
+            heap,
+            (
+                next_time,
+                arrows[next_target]["sort_key"],
+                arrows[target_id]["sort_key"],
+                target_id,
+                next_target,
+                int(color),
