+            boundary_count += 1
+            continue
+        initial_hit_count += 1
+        target_id = int(trace["hit_target"])
+        hit_steps = int(trace["hit_steps"])
+        heapq.heappush(
+            heap,
+            (
+                hit_steps,
+                arrows[target_id]["sort_key"],
+                arrow["sort_key"],
+                arrow["id"],
+                target_id,
+                arrow["color"],
+            ),
