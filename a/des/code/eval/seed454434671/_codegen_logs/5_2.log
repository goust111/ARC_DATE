+
+    heap: list[tuple[int, tuple[int, int, int, int], tuple[int, int, int, int], int, int, int]] = []
+    activated: set[int] = set()
+    incoming_color: dict[int, int] = {}
+    activation_order: list[tuple[int, int, int, int]] = []
