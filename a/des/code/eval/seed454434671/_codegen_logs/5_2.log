+
+
+def _try_add_isolated(
+    shape: tuple[int, int],
+    arrows: list[dict],
+    blocked: set[tuple[int, int]],
+    palette: list[int],
+) -> tuple[dict, set[tuple[int, int]]] | None:
+    for _ in range(ISOLATED_RETRIES):
