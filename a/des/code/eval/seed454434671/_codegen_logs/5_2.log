+            continue
+        if len({arrow["dir"] for arrow in metrics["arrows"]}) < 2:
+            continue
+        if not any(
+            metrics["incoming_color"][idx] != metrics["arrows"][idx]["color"]
+            for idx in metrics["incoming_color"]
+        ):
+            continue
+        if np.count_nonzero(metrics["output"] != metrics["grid"]) < 6:
