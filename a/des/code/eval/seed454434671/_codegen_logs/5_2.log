+                        continue
+                    temp = list(arrows) + [arrow]
+                    prev_idx = len(arrows) - 1
+                    new_idx = len(arrows)
+                    path, hit_target, _hit_steps = _trace_index(temp, prev_idx, shape)
+                    if hit_target != new_idx or not path:
+                        continue
+                    if i == length - 1:
+                        last_path, last_hit_target, _ = _trace_index(temp, new_idx, shape)
