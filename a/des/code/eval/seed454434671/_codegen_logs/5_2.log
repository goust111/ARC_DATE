+        "output": out,
+        "path_overlap": overlap,
+        "ambiguous_same_target": ambiguous,
+        "initial_hit_count": initial_hit_count,
+        "boundary_count": boundary_count,
+        "activated": activated,
+        "incoming_color": incoming_color,
+        "activation_order": activation_order,
