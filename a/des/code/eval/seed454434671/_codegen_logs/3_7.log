+        for cc, (_src_col, v_color, v_marked) in enumerate(verticals):
+            if h_marked and not v_marked:
+                color = h_color
+            elif v_marked and not h_marked:
+                color = v_color
+            else:
+                color = h_color if (rr + cc) % 2 == 0 else v_color
+            out[r0 + 1 + rr, c0 + 1 + cc] = color
+
+    return out
