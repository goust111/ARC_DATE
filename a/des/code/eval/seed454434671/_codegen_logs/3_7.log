+def _extract_strips(
+    grid: np.ndarray, cloth_h: int, cloth_w: int
+) -> tuple[list[tuple[int, int, bool]], list[tuple[int, int, bool]]]:
+    horizontals: list[tuple[int, int, bool]] = []
+    verticals: list[tuple[int, int, bool]] = []
+    used_markers: set[tuple[int, int]] = set()
