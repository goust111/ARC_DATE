+        if frame_candidates:
+            frames[color] = max(frame_candidates, key=lambda item: int(item["area"]))
+        if key_candidates:
+            keys[color] = min(key_candidates, key=lambda item: int(item["area"]))
+
+    return bg, frames, keys
