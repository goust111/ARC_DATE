+def _make_frame_patch(color: int, inner_h: int, inner_w: int) -> np.ndarray:
+    patch = np.zeros((inner_h + 2, inner_w + 2), dtype=int)
+    patch[0, :] = color
+    patch[-1, :] = color
+    patch[:, 0] = color
+    patch[:, -1] = color
+    return patch
