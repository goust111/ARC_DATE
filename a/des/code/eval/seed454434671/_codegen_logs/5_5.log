+    for color in sorted(set(frames) & set(keys)):
+        frame = frames[color]
+        key = keys[color]
+        horizontal = int(key["w"]) > int(key["h"])
+        gap = min(int(key["h"]), int(key["w"]))
+        _paint_stripes(out, frame, horizontal=horizontal, gap=gap)
+
+    return out
