+def _build_expected(grid: np.ndarray, specs: list[dict]) -> np.ndarray:
+    out = grid.copy()
+    for spec in specs:
+        _paint_stripes(out, spec["frame"], horizontal=spec["horizontal"], gap=spec["gap"])
+    return out
