+    min_inner_w = max(WINDOW_INNER_MIN, gap + 2 if not horizontal else WINDOW_INNER_MIN)
+    inner_h = rng.randint(min_inner_h, WINDOW_INNER_MAX)
+    inner_w = rng.randint(min_inner_w, WINDOW_INNER_MAX)
