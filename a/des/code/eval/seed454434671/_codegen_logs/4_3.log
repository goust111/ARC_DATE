+    if legend_color != LEGEND_COLOR or legend_top != scene_h + 1:
+        return None
+
+    found = _find_intersections(grid[:legend_top, :] != BG)
+    if len(found) != len(centers):
+        return None
+    if sorted((r, c, k) for r, c, k in found) != sorted(centers):
