+
+def _piece_sort_key(patch: np.ndarray) -> tuple[int, int, int, bytes]:
+    mask = patch != BG
+    return (
+        -int(mask.sum()),
+        -int(patch.shape[0]),
+        -int(patch.shape[1]),
