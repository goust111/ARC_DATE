+
+def _scatter_pieces(
+    patches: list[np.ndarray],
+    output_shape: tuple[int, int],
+    rng: random.Random,
+) -> np.ndarray | None:
+    count = len(patches)
+    rotations = [rng.randrange(4) for _ in range(count)]
+    if all(rot == 0 for rot in rotations):
