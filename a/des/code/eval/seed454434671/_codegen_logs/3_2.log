+
+def _can_scatter(occ: np.ndarray, cells: np.ndarray, top: int, left: int) -> bool:
+    H, W = occ.shape
+    for rr, cc in cells:
+        r = int(top + rr)
+        c = int(left + cc)
+        if bool(occ[max(0, r - 1) : min(H, r + 2), max(0, c - 1) : min(W, c + 2)].any()):
+            return False
+    return True
