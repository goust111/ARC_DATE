+                left = rng.randint(0, W - pw)
+                if _can_scatter(occ, cells, top, left):
+                    positions.append((top, left))
+                    if len(positions) >= 4:
+                        break
+
+            if not positions:
+                for top in range(H - ph + 1):
+                    for left in range(W - pw + 1):
+                        if _can_scatter(occ, cells, top, left):
+                            positions.append((top, left))
+                if not positions:
+                    ok = False
+                    break
+
+            top, left = rng.choice(positions)
+            rs = top + cells[:, 0]
+            cs = left + cells[:, 1]
+            grid[rs, cs] = patch[cells[:, 0], cells[:, 1]]
+            occ[rs, cs] = True
+
+        if ok:
