+        occ = np.zeros((H, W), dtype=bool)
+
+        order = list(range(count))
+        rng.shuffle(order)
+        ok = True
+
+        for idx in order:
+            patch = rotated[idx]
+            cells = np.argwhere(patch != BG)
+            ph, pw = map(int, patch.shape)
+            positions = []
+
+            for _ in range(40):
