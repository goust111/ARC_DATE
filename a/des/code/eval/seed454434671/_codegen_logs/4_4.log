+    frames = _extract_frames(g)
+    out = np.full_like(g, BG)
+
+    for frame in frames:
+        r0, c0, r1, c1 = frame.bbox
+        bbox = frame.bbox
+        if not frame.children and frame.anchored:
+            assert r1 - r0 + 1 >= 5 and c1 - c0 + 1 >= 5, "anchored leaf is too small to shrink"
