+        color = DEPTH_COLORS[frame.depth % len(DEPTH_COLORS)]
+        _draw_frame(out, bbox, color)
+
+    out[g == GREY] = GREY
+    return out
+
+
+# --------------- generator ---------------
+
+MIN_GRID = 18
+MAX_GRID = 30
+MAX_FRAMES = 7
+MAX_TREE_RETRIES = 400
+MAX_LAYOUT_RETRIES = 120
