+    grid[:, left_width] = GREY
+    grid[:, left_width + 1 :] = right
+
+    if np.any(left == BLACK) or np.any(left == GREY):
+        return None
+    if np.any(np.isin(stamp_colors, left_palette)):
+        return None
+
+    out = main(grid)
+    if out.shape != left.shape:
+        return None
+    if np.array_equal(out, left):
