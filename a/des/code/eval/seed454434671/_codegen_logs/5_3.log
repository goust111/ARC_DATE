+            q = deque([(r0, c0)])
+            seen[r0, c0] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                r, c = q.popleft()
+                coords.append((r, c))
+                for dr, dc in DIR4:
+                    rr = r + dr
+                    cc = c + dc
+                    if 0 <= rr < h and 0 <= cc < w and not seen[rr, cc] and int(g[rr, cc]) == color:
+                        seen[rr, cc] = True
+                        q.append((rr, cc))
