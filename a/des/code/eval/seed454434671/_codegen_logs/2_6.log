+            return mask
+    return None
+
+
+def _place_mask(
+    canvas: np.ndarray,
+    boxes: list[tuple[int, int, int, int]],
+    mask: np.ndarray,
+    color: int,
+) -> dict[str, object] | None:
+    height, width = canvas.shape
+    ph, pw = mask.shape
+    if ph + 2 > height or pw + 2 > width:
+        return None
+
+    min_r = 1
+    max_r = height - ph - 1
+    min_c = 1
+    max_c = width - pw - 1
+    if max_r < min_r or max_c < min_c:
+        return None
+
+    for _ in range(160):
