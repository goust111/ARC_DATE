+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME_COLOR = 5
+WINDOW_COLOR = 8
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+CORNER_BY_SIDE = {
+    "up": "top_left",
+    "right": "top_right",
+    "left": "bottom_left",
+    "down": "bottom_right",
+}
+STAMP_COLOR_POOL = (1, 2, 3, 4, 6, 7, 9)
+GEN_RETRIES = 300
