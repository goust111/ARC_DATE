+    h, w = occupied.shape
+    boxes: list[tuple[int, int, int, int]] = []
+    for outer_h, outer_w in sorted(sizes, key=lambda dims: dims[0] * dims[1], reverse=True):
+        candidates: list[tuple[int, int, int, int]] = []
+        for r0 in range(2, h - outer_h):
