+        bbox = random.choice(candidates)
+        boxes.append(bbox)
+        _reserve(occupied, bbox, pad=1)
+    random.shuffle(boxes)
+    return boxes
+
+
+def _gen_attempt() -> np.ndarray | None:
+    height = random.randint(30, 38)
+    width = random.randint(30, 38)
