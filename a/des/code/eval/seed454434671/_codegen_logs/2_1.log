+    assert inner.shape == (2, 2)
+    inner = inner + np.array([r0 + 1, c0 + 1])
+    (ra, ca), (rb, cb) = inner.tolist()
+    if ra == rb and abs(ca - cb) == 1:
+        if ra == r0 + 1:
+            return "up"
+        if ra == r1 - 1:
+            return "down"
+    if ca == cb and abs(ra - rb) == 1:
