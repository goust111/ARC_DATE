        stamps[corner] = grid[r0 : r1 + 1, c0 : c1 + 1].copy()
    assert set(stamps) == set(CORNER_BY_SIDE.values())
    return stamps


def _find_frames(grid: np.ndarray) -> list[tuple[int, int, int, int]]:
    frames: list[tuple[int, int, int, int]] = []
