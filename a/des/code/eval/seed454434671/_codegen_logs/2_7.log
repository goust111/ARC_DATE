+def _pattern_array(direction: str, color: int) -> np.ndarray:
+    pattern = ARROW_PATTERNS[direction]
+    h = max(r for r, _ in pattern) + 1
+    w = max(c for _, c in pattern) + 1
+    arr = np.full((h, w), BG, dtype=int)
+    for r, c in pattern:
