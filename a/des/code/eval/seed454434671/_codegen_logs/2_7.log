+def _expand_bbox(
+    r0: int, c0: int, r1: int, c1: int, h: int, w: int, pad: int
+) -> tuple[int, int, int, int]:
+    return max(0, r0 - pad), max(0, c0 - pad), min(h - 1, r1 + pad), min(w - 1, c1 + pad)
+
+
+def _free_envelope(
+    reserved: np.ndarray, r0: int, c0: int, r1: int, c1: int, pad: int
