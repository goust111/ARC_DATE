+def _line_between(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    (r0, c0), (r1, c1) = a, b
+    cells: list[tuple[int, int]] = []
+    if r0 == r1:
+        step = 1 if c1 > c0 else -1
+        for c in range(c0 + step, c1, step):
