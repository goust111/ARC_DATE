+    for r, c in np.argwhere((g == BLACK) & (coverage != 0)):
+        bits = int(coverage[r, c])
+        if bits & (bits - 1):
+            out[r, c] = YELLOW
+        else:
+            out[r, c] = bits.bit_length() - 1
+
+    return out
+
