+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+GREY = 5
+SOURCE_COLORS = (1, 2, 3, 6, 7, 8, 9)
+DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+
+def _components4(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for dr, dc in DIRS:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _mirror_orientations(grid: np.ndarray) -> tuple[np.ndarray, int]:
+    orient = np.full(grid.shape, -1, dtype=np.int8)
+    count = 0
+    for comp in _components4(grid == GREY):
+        rows = {r for r, _ in comp}
+        cols = {c for _, c in comp}
+        assert len(comp) >= 2
+        assert len(rows) == 1 or len(cols) == 1
+        value = 0 if len(rows) == 1 else 1
+        for r, c in comp:
+            orient[r, c] = value
+        count += 1
+    return orient, count
+
+
+def _trace_rays(grid: np.ndarray) -> tuple[np.ndarray, dict[str, int]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    orient, mirror_count = _mirror_orientations(g)
+    coverage = np.zeros((h, w), dtype=np.int32)
+
+    sources = [(int(r), int(c), int(g[r, c])) for r, c in np.argwhere((g != BLACK) & (g != GREY) & (g != YELLOW))]
+    stats = {
+        "blocked_side_hits": 0,
+        "colored_cells": 0,
+        "mirror_count": mirror_count,
+        "passes": 0,
+        "reflections": 0,
+        "source_count": len(sources),
+        "yellow_cells": 0,
+    }
+
+    q = deque()
+    for r, c, color in sources:
+        for dr, dc in DIRS:
+            q.append((r, c, dr, dc, 1, color))
+
+    while q:
+        r, c, dr, dc, can_reflect, color = q.popleft()
+        cur_r = int(r)
+        cur_c = int(c)
+
+        while True:
+            nr = cur_r + dr
+            nc = cur_c + dc
+            if not (0 <= nr < h and 0 <= nc < w):
+                break
+
+            value = int(g[nr, nc])
+            if value == GREY:
+                axis = int(orient[nr, nc])
+                parallel = (axis == 0 and dc != 0) or (axis == 1 and dr != 0)
+                if parallel:
+                    stats["passes"] += 1
+                    rr = nr
+                    cc = nc
+                    while 0 <= rr < h and 0 <= cc < w and int(g[rr, cc]) == GREY:
