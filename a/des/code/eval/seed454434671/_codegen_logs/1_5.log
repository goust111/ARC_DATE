+
+
+def _find_legend(grid: np.ndarray, bg: int):
+    h, w = grid.shape
+    candidates = []
+    for color in map(int, np.unique(grid)):
+        if color == bg:
+            continue
+        for cells in _components(grid == color):
+            bbox = _bbox(cells)
+            r0, c0, r1, c1 = bbox
+            if r1 - r0 + 1 < 6 or c1 - c0 + 1 < 11:
+                continue
+            if not (r0 == 0 or c0 == 0 or r1 == h - 1 or c1 == w - 1):
+                continue
