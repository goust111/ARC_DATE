+    colors = [endpoint_color_info["color"], channel_color_info["color"], node_color_info["color"]]
+    if len(set(colors)) != 3:
+        return None
+
+    return {
+        1: int(endpoint_color_info["color"]),
+        2: int(channel_color_info["color"]),
+        3: int(node_color_info["color"]),
