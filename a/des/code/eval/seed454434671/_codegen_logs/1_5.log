+
+
+def _make_t(rng: np.random.Generator):
+    dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    missing = int(rng.integers(0, 4))
+    cells = {(0, 0)}
+    for idx, (dr, dc) in enumerate(dirs):
+        if idx == missing:
+            continue
+        length = int(rng.integers(1, 4))
+        for step in range(1, length + 1):
+            cells.add((dr * step, dc * step))
