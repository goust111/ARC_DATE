+def _style_of_cell(cell, cell_set):
+    r, c = cell
+    neighbors = []
+    for dr, dc in DIR4:
+        if (r + dr, c + dc) in cell_set:
+            neighbors.append((dr, dc))
+    degree = len(neighbors)
+    if degree >= 3:
+        return 3, {(0, 0), (-1, 0), (1, 0), (0, -1), (0, 1)}
+    if degree <= 1:
+        return 1, {(0, 0)}
