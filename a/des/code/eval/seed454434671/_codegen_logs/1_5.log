+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _bbox(cells):
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _normalize(cells):
+    r0, c0, _, _ = _bbox(cells)
+    return sorted((r - r0, c - c0) for r, c in cells)
+
+
+def _components(mask: np.ndarray):
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            stack = [(r, c)]
+            cells = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(cells)
+    return comps
+
+
+def _perimeter_cells(bbox):
+    r0, c0, r1, c1 = bbox
+    cells = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _find_aligned_singleton(singletons, col, min_row):
+    candidates = [info for info in singletons if info["row"] > min_row and info["col"] == col]
+    if not candidates:
+        return None
+    return min(candidates, key=lambda info: info["row"])
+
+
+def _parse_legend(inner: np.ndarray, bg: int, border_color: int):
+    mask = (inner != bg) & (inner != border_color)
+    infos = []
+    for cells in _components(mask):
+        r0, c0, r1, c1 = _bbox(cells)
+        color = int(inner[cells[0][0], cells[0][1]])
+        infos.append(
+            {
+                "cells": cells,
+                "bbox": (r0, c0, r1, c1),
+                "area": len(cells),
+                "color": color,
