+
+def _make_line(rng: np.random.Generator):
+    length = int(rng.integers(4, 8))
+    return [(0, c) for c in range(length)]
+
+
+def _make_l(rng: np.random.Generator):
+    a = int(rng.integers(3, 7))
+    b = int(rng.integers(3, 7))
