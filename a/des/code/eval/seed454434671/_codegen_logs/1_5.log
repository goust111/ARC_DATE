+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PLUS_SHAPE = frozenset({(0, 1), (1, 0), (1, 1), (1, 2), (2, 1)})
+VBAR_SHAPE = frozenset({(0, 0), (1, 0), (2, 0)})
