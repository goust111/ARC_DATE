+    out[priority > 0] = paint[priority > 0]
+    return out
+
+
+def _random_transform(cells, rng: np.random.Generator):
+    rot = int(rng.integers(0, 4))
+    flip_r = bool(rng.integers(0, 2))
+    flip_c = bool(rng.integers(0, 2))
