+
+
+def _make_zigzag(rng: np.random.Generator):
+    lengths = [int(rng.integers(2, 5)) for _ in range(3)]
+    cells = {(0, 0)}
+    r, c = 0, 0
+    for dr, dc, steps in ((0, 1, lengths[0]), (1, 0, lengths[1]), (0, 1, lengths[2])):
+        for _ in range(steps):
+            r += dr
+            c += dc
+            cells.add((r, c))
