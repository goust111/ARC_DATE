+def _make_tree(rng: np.random.Generator):
+    dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    missing = int(rng.integers(0, 4))
+    arm_lengths = {}
+    cells = {(0, 0)}
+    active_dirs = []
+    for idx, (dr, dc) in enumerate(dirs):
+        if idx == missing:
+            continue
+        length = int(rng.integers(1, 4))
