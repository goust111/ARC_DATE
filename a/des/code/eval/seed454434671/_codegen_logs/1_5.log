+def _legend_bbox_for_edge(edge: str, h: int, w: int, rng: np.random.Generator):
+    if edge == "top":
+        return 0, int(rng.integers(0, w - LEGEND_W + 1)), LEGEND_H - 1, int(rng.integers(0, 1))
+    if edge == "bottom":
