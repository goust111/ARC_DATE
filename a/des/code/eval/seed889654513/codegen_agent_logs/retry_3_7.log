+        chosen_slots = [slots[idx] for idx in chosen_indices]
+
+        signatures: set[tuple[str, int, int]] = set()
+        okay = True
+        for (kind, code), (r, c) in zip(instructions, chosen_slots):
+            if kind == "move":
