+
+
+def _translation_span(instructions: list[tuple[str, int]]) -> tuple[int, int, int, int]:
+    dr = 0
+    dc = 0
+    min_dr = 0
+    max_dr = 0
+    min_dc = 0
+    max_dc = 0
