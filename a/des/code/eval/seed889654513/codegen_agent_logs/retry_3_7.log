+                options = [
+                    int(color)
+                    for color in DOMINO_SECOND_COLORS
+                    if color != code and (orient, code, int(color)) not in signatures
+                ]
+                if not options:
+                    okay = False
+                    break
+                second = int(_RNG.choice(np.array(options, dtype=int)))
+                grid[r, c] = code
+                grid[r + 1, c] = second
+                signatures.add((orient, code, second))
+        if not okay:
+            continue
