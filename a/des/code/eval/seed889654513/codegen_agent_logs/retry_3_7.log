+        max_dr = max(max_dr, dr)
+        min_dc = min(min_dc, dc)
+        max_dc = max(max_dc, dc)
+    return min_dr, max_dr, min_dc, max_dc
+
+
+def _mark_forbidden(mask: np.ndarray, r0: int, c0: int, r1: int, c1: int, pad: int = 1) -> None:
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
