+from __future__ import annotations
+
+import numpy as np
+
+
+DIRS = {
+    "N": (-1, 0),
+    "S": (1, 0),
+    "W": (0, -1),
+    "E": (0, 1),
+}
+OPPOSITE = {"N": "S", "S": "N", "W": "E", "E": "W"}
+COMPRESS_DELTA = {"N": (-2, 0), "S": (2, 0), "W": (0, -2), "E": (0, 2)}
