+        if len(nodes) < 2 or not any(adjacency):
+            return None
+        out = main(grid)
+        if not np.array_equal(main(out), out):
+            return None
+    except AssertionError:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
