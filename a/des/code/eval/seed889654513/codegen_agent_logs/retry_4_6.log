+    if len(rows) == 1:
+        row = rows[0]
+        c0 = cols[0]
+        length = len(cols)
+        assert cols == list(range(c0, c0 + length))
+        return {"color": color, "orientation": 0, "r": row, "c": c0, "length": length}
+    if len(cols) == 1:
+        col = cols[0]
+        r0 = rows[0]
+        length = len(rows)
+        assert rows == list(range(r0, r0 + length))
