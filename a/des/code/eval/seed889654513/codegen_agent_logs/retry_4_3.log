+        component = {
+            "source_color": source_color,
+            "source": source,
+            "route": route,
+            "route_set": route_set,
+            "endpoint": endpoint,
+            "final_dir": final_dir,
+            "intersections": intersections,
+            "stub_paths": stub_paths,
+            "markers": markers,
+            "extension": extension,
