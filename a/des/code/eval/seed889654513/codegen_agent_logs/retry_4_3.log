+                    free_len = step
+                    probe_occupied = probe_occupied | {cell}
+                if free_len == 0:
+                    valid = False
+                    break
+                stub_len = random.randint(1, free_len)
+                stub = []
+                for step in range(1, stub_len + 1):
+                    cell = _add(center, stub_dir, step)
+                    stub.append(cell)
