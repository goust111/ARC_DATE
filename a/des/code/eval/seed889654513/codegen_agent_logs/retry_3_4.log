+from collections import deque
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MAROON = 9
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8)
+
+GRID_H_MIN, GRID_H_MAX = 18, 30
+GRID_W_MIN, GRID_W_MAX = 18, 30
+GEN_ATTEMPTS = 300
