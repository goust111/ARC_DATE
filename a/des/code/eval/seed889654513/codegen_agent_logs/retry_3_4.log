+    patch_out[boundary] = GREY
+
+    for r, c in np.argwhere(interior):
+        rr, cc = int(r) + 1, int(c) + 1
+        if dist[r, c] % 2 == 1:
+            patch_out[rr, cc] = seed_color
+
+    sr, sc = seed_rc
+    patch_in[sr + 1, sc + 1] = seed_color
+    return patch_in, patch_out
