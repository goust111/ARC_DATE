+        if not placed:
+            return None
+
+    solved = main(inp)
+    if not np.array_equal(solved, out):
+        return None
+    if np.array_equal(inp, out):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
