+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _components4(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    assert len(coords) > 0
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return mask[r0 : r1 + 1, c0 : c1 + 1]
+
+
+def _dilate4(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    out[1:, :] |= mask[:-1, :]
+    out[:-1, :] |= mask[1:, :]
+    out[:, 1:] |= mask[:, :-1]
+    out[:, :-1] |= mask[:, 1:]
+    return out
+
+
+def _layer_distances(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    dist = np.zeros((h, w), dtype=int)
+    q: deque[tuple[int, int]] = deque()
+
+    for r, c in np.argwhere(mask):
+        is_boundary = False
+        for nr, nc in _neighbors4(int(r), int(c), h, w):
+            if not mask[nr, nc]:
+                is_boundary = True
+                break
+        if not is_boundary and (r == 0 or c == 0 or r == h - 1 or c == w - 1):
+            is_boundary = True
+        if is_boundary:
+            dist[r, c] = 1
+            q.append((int(r), int(c)))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c, h, w):
+            if mask[nr, nc] and dist[nr, nc] == 0:
+                dist[nr, nc] = dist[r, c] + 1
+                q.append((nr, nc))
+
+    assert np.all(dist[mask] > 0)
+    return dist
+
+
+def _has_hole(mask: np.ndarray) -> bool:
+    inv = ~mask
+    h, w = mask.shape
+    for comp in _components4(inv):
+        if not any(
