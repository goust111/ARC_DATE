+    out = np.full((h, w), BLACK, dtype=int)
+    reserved = np.zeros((h, w), dtype=bool)
+
+    demo_in, demo_out = _make_demo_box(rng)
+    dh, dw = demo_in.shape
+    if dh > h or dw > w:
+        return None
+
+    demo_positions = [
+        (0, 0),
+        (0, w - dw),
+        (h - dh, 0),
+        (h - dh, w - dw),
+        (0, max(0, (w - dw) // 2)),
+        (h - dh, max(0, (w - dw) // 2)),
+        (max(0, (h - dh) // 2), 0),
