+
+    while int(mask.sum()) < target:
+        frontier: set[tuple[int, int]] = set()
+        for r, c in np.argwhere(mask):
+            for nr, nc in _neighbors4(int(r), int(c), h, w):
+                if mask[nr, nc]:
