+def _partition_attempt(inner_h: int, inner_w: int, room_count: int, want_tie: bool) -> tuple[list[tuple[int, int, int, int]], list[tuple[str, int, int, int]]] | None:
+    rooms = [(0, 0, inner_h - 1, inner_w - 1)]
