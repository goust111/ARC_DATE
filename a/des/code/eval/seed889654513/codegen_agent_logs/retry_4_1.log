+def _ray_hit_room(
+    grid: np.ndarray,
+    frame: dict,
+    tip: tuple[int, int],
+    direction: tuple[int, int],
+) -> int:
+    h, w = grid.shape
+    r0, c0, r1, c1 = frame["bbox"]
+    room_lookup = frame["room_lookup"]
+    rr, cc = tip
+    entered = False
+    while True:
+        rr += direction[0]
+        cc += direction[1]
+        if not (0 <= rr < h and 0 <= cc < w):
+            break
+        inside = r0 <= rr <= r1 and c0 <= cc <= c1
+        if inside:
+            entered = True
+            room_idx = room_lookup.get((rr, cc))
+            if room_idx is not None:
