+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill partitioned rectangular rooms by area-ranked palette order, then mark the arrow-hit room as the exit.
+    """
+    g = np.asarray(grid, dtype=int)
+    out = np.array(g, copy=True)
