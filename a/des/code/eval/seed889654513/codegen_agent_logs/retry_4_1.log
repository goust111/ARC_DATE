+        side = random.choice(SIDES)
+        candidates = [idx for idx, room in enumerate(rooms) if _touches_side(room, side, inner_h, inner_w)]
+        if not candidates:
+            continue
+        exit_room_idx = random.choice(candidates)
+        bend = random.choice((-1, 1))
