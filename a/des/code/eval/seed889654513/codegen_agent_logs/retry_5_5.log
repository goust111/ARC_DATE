+import numpy as np
+
+
+GREY = 5
+MAROON = 9
+COLOR_ORDER = tuple(range(10))
+COLOR_RANK = {color: idx for idx, color in enumerate(COLOR_ORDER)}
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+SIDE_TO_VEC = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+GEN_RETRIES = 300
+GRID_MIN = 18
+GRID_MAX = 30
+BG_CHOICES = [0, 1, 2, 3, 4, 6, 7, 8]
+GAP_LENGTHS = (2, 3, 4)
+SIDES = ("top", "bottom", "left", "right")
