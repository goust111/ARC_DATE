+def _bbox_clear(blocked: np.ndarray, r0: int, c0: int, r1: int, c1: int, pad: int = 1) -> bool:
+    h, w = blocked.shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h, r1 + pad + 1)
+    cc1 = min(w, c1 + pad + 1)
