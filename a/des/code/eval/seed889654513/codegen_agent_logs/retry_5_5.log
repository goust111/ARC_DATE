+        if abs(int(r - handle[0])) + abs(int(c - handle[1])) == 1
+    ]
+    if not touching:
+        return None
+
+    dirs = {(int(handle[0] - r), int(handle[1] - c)) for r, c in touching}
+    if len(dirs) != 1:
+        return None
+    outward = next(iter(dirs))
+    if outward not in SIDE_TO_VEC.values():
+        return None
+
+    return {
+        "cells": cells,
+        "handle": handle,
+        "outward": outward,
+        "signature": (_normalize(cells), outward),
+    }
