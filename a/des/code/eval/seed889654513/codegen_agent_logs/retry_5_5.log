+            for c0 in range(1, w - 1):
+                for handle_idx in range(length):
+                    cells, handle = _key_cells_for_spec(spec, (r0, c0), handle_idx)
+                    union = cells + [handle]
+                    if any(not (0 <= r < h and 0 <= c < w) for r, c in union):
