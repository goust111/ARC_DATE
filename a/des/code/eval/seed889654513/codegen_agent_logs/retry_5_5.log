+
+
+def _sample_dot_values(count: int, palette: list[int]) -> list[int]:
+    tie_case = count in (3, 5) and random.random() < 0.35 and len(palette) >= 3
+    if tie_case and count == 3:
+        values = random.sample(palette, 3)
+    elif tie_case and count == 5:
