+
+    side_low = max(GRID_SIDE_RANGE[0], 10 + 4 * n)
+    side_high = max(side_low, GRID_SIDE_RANGE[1])
+    h = random.randint(side_low, side_high)
+    w = random.randint(side_low, side_high)
