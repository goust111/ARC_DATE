+
+    specs: list[dict[str, object]] = []
+    frame_sizes: list[tuple[int, int]] = []
+    external_sizes: list[tuple[int, int]] = []
+    for key, sprite_color, pointer_color, direction in zip(
+        keys, sprite_colors, pointer_colors, directions, strict=False
+    ):
