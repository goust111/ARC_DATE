+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+ORIENTATIONS = ("up", "down", "left", "right")
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((int(rr), int(cc)))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _container_pattern(orientation: str, depth: int) -> dict[str, object]:
+    walls: set[tuple[int, int]] = set()
+    if orientation == "up":
+        for r in range(depth):
+            walls.add((r, 0))
+            walls.add((r, 2))
+        for c in range(3):
+            walls.add((depth, c))
+        inside_from_deep = [(r, 1) for r in range(depth - 1, -1, -1)]
+        mouth = (-1, 1)
+        outward = (-1, 0)
+        shape = (depth + 1, 3)
+    elif orientation == "down":
+        for c in range(3):
+            walls.add((0, c))
+        for r in range(1, depth + 1):
+            walls.add((r, 0))
+            walls.add((r, 2))
+        inside_from_deep = [(r, 1) for r in range(1, depth + 1)]
+        mouth = (depth + 1, 1)
+        outward = (1, 0)
+        shape = (depth + 1, 3)
+    elif orientation == "left":
+        for c in range(depth):
+            walls.add((0, c))
+            walls.add((2, c))
+        for r in range(3):
+            walls.add((r, depth))
+        inside_from_deep = [(1, c) for c in range(depth - 1, -1, -1)]
+        mouth = (1, -1)
+        outward = (0, -1)
+        shape = (3, depth + 1)
+    elif orientation == "right":
+        for c in range(1, depth + 1):
+            walls.add((0, c))
+            walls.add((2, c))
+        for r in range(3):
+            walls.add((r, 0))
+        inside_from_deep = [(1, c) for c in range(1, depth + 1)]
+        mouth = (1, depth + 1)
+        outward = (0, 1)
+        shape = (3, depth + 1)
+    else:
+        raise ValueError(f"unknown orientation: {orientation}")
+    return {
+        "walls": walls,
+        "inside_from_deep": inside_from_deep,
+        "mouth": mouth,
+        "outward": outward,
+        "shape": shape,
+    }
+
+
+def _recognize_container(comp: list[tuple[int, int]]) -> dict[str, object] | None:
+    rows = [r for r, _ in comp]
+    cols = [c for _, c in comp]
+    r0 = min(rows)
+    c0 = min(cols)
+    r1 = max(rows)
+    c1 = max(cols)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    norm = {(r - r0, c - c0) for r, c in comp}
+
+    matches: list[tuple[str, int, dict[str, object]]] = []
+    if w == 3 and 4 <= h <= 6:
+        depth = h - 1
+        for orientation in ("up", "down"):
+            pattern = _container_pattern(orientation, depth)
+            if norm == pattern["walls"]:
+                matches.append((orientation, depth, pattern))
+    if h == 3 and 4 <= w <= 6:
+        depth = w - 1
+        for orientation in ("left", "right"):
+            pattern = _container_pattern(orientation, depth)
+            if norm == pattern["walls"]:
+                matches.append((orientation, depth, pattern))
+    if len(matches) != 1:
+        return None
+
+    orientation, depth, pattern = matches[0]
+    inside = [(r0 + dr, c0 + dc) for dr, dc in pattern["inside_from_deep"]]
+    mouth = (r0 + int(pattern["mouth"][0]), c0 + int(pattern["mouth"][1]))
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "orientation": orientation,
+        "depth": depth,
+        "inside_from_deep": inside,
+        "mouth": mouth,
+        "outward": pattern["outward"],
+    }
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Collect bullets along each container's opening axis and stack them by arrival order.
+
+    Input structure:
