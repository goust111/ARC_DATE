+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((int(rr), int(cc)))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _container_pattern(orientation: str, depth: int) -> dict[str, object]:
+    walls: set[tuple[int, int]] = set()
+    if orientation == "up":
+        for r in range(depth):
+            walls.add((r, 0))
+            walls.add((r, 2))
+        for c in range(3):
+            walls.add((depth, c))
+        inside_from_deep = [(r, 1) for r in range(depth - 1, -1, -1)]
+        mouth = (-1, 1)
+        outward = (-1, 0)
+        shape = (depth + 1, 3)
+    elif orientation == "down":
+        for c in range(3):
+            walls.add((0, c))
+        for r in range(1, depth + 1):
+            walls.add((r, 0))
+            walls.add((r, 2))
+        inside_from_deep = [(r, 1) for r in range(1, depth + 1)]
+        mouth = (depth + 1, 1)
+        outward = (1, 0)
+        shape = (depth + 1, 3)
+    elif orientation == "left":
+        for c in range(depth):
+            walls.add((0, c))
+            walls.add((2, c))
+        for r in range(3):
+            walls.add((r, depth))
+        inside_from_deep = [(1, c) for c in range(depth - 1, -1, -1)]
+        mouth = (1, -1)
+        outward = (0, -1)
+        shape = (3, depth + 1)
+    elif orientation == "right":
+        for c in range(1, depth + 1):
+            walls.add((0, c))
+            walls.add((2, c))
+        for r in range(3):
+            walls.add((r, 0))
+        inside_from_deep = [(1, c) for c in range(1, depth + 1)]
+        mouth = (1, depth + 1)
+        outward = (0, 1)
+        shape = (3, depth + 1)
+    else:
+        raise ValueError(f"unknown orientation: {orientation}")
+    return {
+        "walls": walls,
+        "inside_from_deep": inside_from_deep,
+        "mouth": mouth,
+        "outward": outward,
+        "shape": shape,
+    }
