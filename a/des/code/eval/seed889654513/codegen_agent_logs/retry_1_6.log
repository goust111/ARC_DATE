            used.add(j)
            chosen.append((min(best_i, j), max(best_i, j)))
            result = search(used, chosen)
            if result is not None:
                return result
            chosen.pop()
            used.remove(best_i)
            used.remove(j)
        return None

    result = search(set(), [])
    if result is None:
        raise ValueError("no valid pairing")
    return result


