+        patch[0, notch_start : notch_start + notch_len] = bg
+    elif side == "bottom":
+        patch[-1, notch_start : notch_start + notch_len] = bg
+    elif side == "left":
+        patch[notch_start : notch_start + notch_len, 0] = bg
+    else:
+        patch[notch_start : notch_start + notch_len, -1] = bg
+    return patch
