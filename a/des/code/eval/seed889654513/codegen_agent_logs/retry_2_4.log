+def _generate_top_shape(
+    rng: np.random.Generator,
+    signature: tuple[int, ...],
+    max_h: int,
+    max_w: int,
+    min_area: int,
+    max_area: int,
+) -> np.ndarray | None:
+    need_w = max(2, len(signature))
+    if max_h < 2 or max_w < need_w:
+        return None
+    sig_arr = np.asarray(signature, dtype=int)
+
+    for _ in range(200):
+        h = int(rng.integers(2, max_h + 1))
+        w = int(rng.integers(need_w, max_w + 1))
