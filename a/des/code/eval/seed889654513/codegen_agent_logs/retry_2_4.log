+    row_heights = [0, 0]
+    col_widths = [0, 0]
+    for (h, w), (sr, sc) in zip(sizes, chosen, strict=False):
+        row_heights[sr] = max(row_heights[sr], int(h))
+        col_widths[sc] = max(col_widths[sc], int(w))
