+    k = _rotation_k(src_frame["side"], dst_frame["side"])
+    rot_mask = np.rot90(src_mask, k)
+    edge = _edge_signature(rot_mask, dst_frame["side"])
+    if edge is None or edge[1] != dst_frame["notch_signature"]:
+        return None
