+def _find_unique_match(grid: np.ndarray) -> dict | None:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    frames = _attach_patterns(g, bg, _detect_frames(g, bg))
+    for idx, frame in enumerate(frames):
+        frame["index"] = int(idx)
