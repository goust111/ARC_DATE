+        if _place_pattern(rng, grid, frame, pat_mask, pattern_colors[idx], forbidden=forbidden) is None:
+            return None
+
+    if _get_bg(grid) != bg:
+        return None
+    match = _find_unique_match(grid)
+    if match is None:
+        return None
