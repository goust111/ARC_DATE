+            notch_start = int(rng.integers(1, outer_w - notch_len))
+        else:
+            notch_start = int(rng.integers(1, outer_h - notch_len))
+        specs.append(
+            {
+                "outer_h": outer_h,
+                "outer_w": outer_w,
+                "side": side,
+                "notch_len": notch_len,
+                "notch_start": notch_start,
+            }
+        )
+    return specs
