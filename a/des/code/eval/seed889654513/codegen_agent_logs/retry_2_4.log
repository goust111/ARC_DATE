+def _layout_frames(
+    rng: np.random.Generator,
+    sizes: list[tuple[int, int]],
+) -> tuple[tuple[int, int], list[tuple[int, int]]] | None:
+    n = len(sizes)
+    all_slots = [(0, 0), (0, 1), (1, 0), (1, 1)]
+    if n == 4:
+        chosen = all_slots
+    else:
+        drop = int(rng.integers(0, 4))
+        chosen = [slot for i, slot in enumerate(all_slots) if i != drop]
+    rng.shuffle(chosen)
