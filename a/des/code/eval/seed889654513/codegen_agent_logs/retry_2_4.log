+    for (h, w), (sr, sc) in zip(sizes, chosen, strict=False):
+        r_slack = row_heights[sr] - int(h)
+        c_slack = col_widths[sc] - int(w)
+        r0 = row_base[sr] + int(rng.integers(0, r_slack + 1))
+        c0 = col_base[sc] + int(rng.integers(0, c_slack + 1))
