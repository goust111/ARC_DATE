+        hi = min(int(max_area), int(h * w))
+        if lo > hi:
+            continue
+        target_area = int(rng.integers(lo, hi + 1))
+
+        while int(mask.sum()) < target_area:
+            frontier: list[tuple[int, int]] = []
+            weights: list[float] = []
+            for rr, cc in np.argwhere(mask):
+                r = int(rr)
+                c = int(cc)
+                for dr, dc in DIRS4:
+                    nr = r + dr
+                    nc = c + dc
+                    if not (0 <= nr < h and 0 <= nc < w) or mask[nr, nc]:
+                        continue
+                    if nr == 0:
