+def _frame_patch(
+    outer_h: int,
+    outer_w: int,
+    frame_color: int,
+    bg: int,
+    side: str,
+    notch_start: int,
+    notch_len: int,
+) -> np.ndarray:
+    patch = np.full((outer_h, outer_w), bg, dtype=int)
+    patch[0, :] = frame_color
+    patch[-1, :] = frame_color
+    patch[:, 0] = frame_color
+    patch[:, -1] = frame_color
