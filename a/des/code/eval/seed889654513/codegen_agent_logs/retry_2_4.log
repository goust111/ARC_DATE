+            return None
+
+    if _get_bg(grid) != bg:
+        return None
+    match = _find_unique_match(grid)
+    if match is None:
+        return None
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _build_input(rng)
+        if grid is not None:
