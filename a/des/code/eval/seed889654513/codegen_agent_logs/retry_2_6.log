+    return {(0, 1): "conflict", (1, 2): "conflict", (0, 2): "conflict"}
+
+
+def _pair_relation(
+    i: int, j: int, mode: str, overrides: dict[tuple[int, int], str]
+) -> str:
+    if i > j:
+        i, j = j, i
+    return overrides.get((i, j), "separate")
+
+
+def _place_seeds(
+    height: int,
+    width: int,
+    shapes: list[tuple[tuple[int, int], ...]],
+    sizes: list[int],
