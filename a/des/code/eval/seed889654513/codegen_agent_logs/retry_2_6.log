+            ("###", ".#."),
+            ("###", "#.."),
+            ("##.", ".##"),
+        ],
+    }
+    shapes: dict[int, list[tuple[tuple[int, int], ...]]] = {}
+    for size, patterns in base_patterns.items():
+        bucket: dict[tuple[tuple[int, int], ...], None] = {}
+        for pattern in patterns:
