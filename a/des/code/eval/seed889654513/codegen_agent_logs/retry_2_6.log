+    if mode == "one":
+        pair_options = [(a, b) for a in range(1, 5) for b in range(1, 5) if a + b >= MIN_COMPONENT_DISTANCE]
+        a, b = random.choice(pair_options)
+        return [a, b] + [random.randint(1, 4) for _ in range(seed_count - 2)]
