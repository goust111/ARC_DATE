+    for k in range(4):
+        rotated = np.rot90(arr, k)
+        for variant in (rotated, np.fliplr(rotated)):
+            coords = tuple((int(r), int(c)) for r, c in np.argwhere(variant))
+            variants[_normalize_cells(coords)] = None
