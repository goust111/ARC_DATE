+
+def _trim_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return np.array(mask[r0 : r1 + 1, c0 : c1 + 1], dtype=bool)
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if len(coords) == 0:
+        return False
+    seen = np.zeros_like(mask, dtype=bool)
+    stack = [tuple(map(int, coords[0]))]
+    seen[stack[0]] = True
+    count = 0
+    while stack:
+        r, c = stack.pop()
+        count += 1
+        for dr, dc in DIR4:
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < mask.shape[0] and 0 <= cc < mask.shape[1] and mask[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                stack.append((rr, cc))
+    return count == int(mask.sum())
+
+
+def _extract_components(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    seen = np.zeros_like(g, dtype=bool)
+    comps = []
+    for r in range(g.shape[0]):
+        for c in range(g.shape[1]):
+            color = int(g[r, c])
+            if color == 0 or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if (
+                        0 <= nr < g.shape[0]
+                        and 0 <= nc < g.shape[1]
+                        and not seen[nr, nc]
+                        and int(g[nr, nc]) == color
+                    ):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            rows = [rr for rr, _ in coords]
+            cols = [cc for _, cc in coords]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in coords:
+                mask[rr - r0, cc - c0] = True
+            comps.append(
+                {
+                    "color": color,
+                    "area": int(len(coords)),
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "mask": mask,
+                }
+            )
