+
+def _dihedral_masks(mask_a: np.ndarray, mask_b: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    board = np.zeros(mask_a.shape, dtype=int)
+    board[mask_a] = 1
+    board[mask_b] = 2
