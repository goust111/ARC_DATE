+def _can_place(occupied: np.ndarray, mask: np.ndarray, top: int, left: int) -> bool:
+    h, w = mask.shape
+    coords = np.argwhere(mask)
+    for rr, cc in coords:
+        r = int(top + rr)
+        c = int(left + cc)
+        r0 = max(0, r - 1)
+        r1 = min(occupied.shape[0], r + 2)
+        c0 = max(0, c - 1)
+        c1 = min(occupied.shape[1], c + 2)
+        if occupied[r0:r1, c0:c1].any():
