+        for r0 in range(h - ha + 1):
+            for c0 in range(w - wa + 1):
+                occ = np.zeros((h, w), dtype=bool)
+                rr = coords_a[:, 0] + r0
+                cc = coords_a[:, 1] + c0
+                occ[rr, cc] = True
+                placements_a.append((occ, rr, cc))
+        for occ_a, rr_a, cc_a in placements_a:
+            for r0 in range(h - hb + 1):
