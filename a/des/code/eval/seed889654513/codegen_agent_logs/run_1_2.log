+    stack = [tuple(map(int, coords[0]))]
+    seen[stack[0]] = True
+    count = 0
+    while stack:
+        r, c = stack.pop()
+        count += 1
+        for dr, dc in DIR4:
+            rr = r + dr
+            cc = c + dc
