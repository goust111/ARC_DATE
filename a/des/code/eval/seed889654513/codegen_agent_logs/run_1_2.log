+def _count_matchings(pair_map: dict[tuple[int, int], np.ndarray], n: int, limit: int = 2) -> int:
+    def search(used: set[int]) -> int:
+        if len(used) == n:
+            return 1
+
+        best_i = None
+        best_options = None
+        for i in range(n):
+            if i in used:
+                continue
+            options = []
+            for j in range(n):
+                if j == i or j in used:
+                    continue
+                if (min(i, j), max(i, j)) in pair_map:
+                    options.append(j)
+            if best_options is None or len(options) < len(best_options):
+                best_i = i
+                best_options = options
+        if not best_options:
+            return 0
+
+        total = 0
+        for j in best_options:
+            used.add(best_i)
+            used.add(j)
+            total += search(used)
+            used.remove(best_i)
+            used.remove(j)
+            if total >= limit:
