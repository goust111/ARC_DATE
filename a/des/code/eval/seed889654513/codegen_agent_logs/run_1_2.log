+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+COLOR_ORDER = {1: 0, 2: 1, 3: 2, 4: 3, 5: 4, 6: 5, 7: 6, 8: 7, 9: 8}
+RECT_DIMS_BY_AREA = {
+    4: [(2, 2)],
+    6: [(2, 3)],
+    8: [(2, 4)],
+    9: [(3, 3)],
+    10: [(2, 5)],
+    12: [(2, 6), (3, 4)],
