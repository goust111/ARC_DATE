+    return [patterns[key] for key in sorted(patterns, key=lambda k: _pattern_key(patterns[k]))]
+
+
+def _build_pair_map(comps: list[dict]) -> dict[tuple[int, int], np.ndarray]:
+    pair_map = {}
+    for i in range(len(comps)):
+        for j in range(i + 1, len(comps)):
+            rects = _pair_rectangles(comps[i], comps[j])
+            if rects:
+                pair_map[(i, j)] = rects[0]
+    return pair_map
+
+
+def _choose_matching(pair_map: dict[tuple[int, int], np.ndarray], n: int) -> list[tuple[int, int]]:
+    def search(used: set[int], chosen: list[tuple[int, int]]) -> list[tuple[int, int]] | None:
+        if len(used) == n:
+            return list(chosen)
+
+        best_i = None
+        best_options = None
+        for i in range(n):
+            if i in used:
+                continue
+            options = []
+            for j in range(i + 1, n):
+                if j in used or (i, j) not in pair_map:
+                    continue
+                rect = pair_map[(i, j)]
+                options.append((j, _rectangle_sort_key(rect), _pattern_key(rect)))
+            if best_options is None or len(options) < len(best_options):
+                best_i = i
+                best_options = options
+        if not best_options:
+            return None
+
+        for j, _sort_key, _pat_key in sorted(best_options, key=lambda item: (item[1], item[2], item[0])):
+            used.add(best_i)
+            used.add(j)
+            chosen.append((best_i, j))
+            result = search(used, chosen)
+            if result is not None:
+                return result
+            chosen.pop()
+            used.remove(best_i)
+            used.remove(j)
+        return None
+
+    result = search(set(), [])
+    if result is None:
+        raise ValueError("no valid pairing")
+    return result
+
+
+def _count_matchings(pair_map: dict[tuple[int, int], np.ndarray], n: int, limit: int = 2) -> int:
+    def search(used: set[int]) -> int:
+        if len(used) == n:
+            return 1
+
+        best_i = None
+        best_options = None
+        for i in range(n):
+            if i in used:
+                continue
+            options = [j for j in range(i + 1, n) if j not in used and (i, j) in pair_map]
+            if best_options is None or len(options) < len(best_options):
+                best_i = i
+                best_options = options
+        if not best_options:
+            return 0
+
+        total = 0
+        for j in best_options:
+            used.add(best_i)
+            used.add(j)
+            total += search(used)
+            used.remove(best_i)
+            used.remove(j)
+            if total >= limit:
+                return limit
+        return total
+
+    return search(set())
