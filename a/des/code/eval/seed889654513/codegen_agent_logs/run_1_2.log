+                    continue
+                if (min(i, j), max(i, j)) in pair_map:
+                    options.append(j)
+            if best_options is None or len(options) < len(best_options):
+                best_i = i
+                best_options = options
+        if not best_options:
+            return 0
+
+        total = 0
+        for j in best_options:
+            used.add(best_i)
+            used.add(j)
+            total += search(used)
+            used.remove(best_i)
+            used.remove(j)
