+
+def _is_full_rectangle(mask: np.ndarray) -> bool:
+    return int(mask.sum()) == int(mask.shape[0] * mask.shape[1])
+
+
+def _make_pair(area: int, color_a: int, color_b: int) -> dict | None:
+    dims = RECT_DIMS_BY_AREA[area]
