+
+def _gen_attempt() -> np.ndarray | None:
+    pair_count = int(_RNG.integers(PAIR_COUNT_RANGE[0], PAIR_COUNT_RANGE[1] + 1))
+    tie_branch = bool(_RNG.integers(0, 2))
+    areas = _choose_areas(pair_count, tie_branch)
