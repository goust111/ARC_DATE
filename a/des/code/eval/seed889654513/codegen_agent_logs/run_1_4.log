+        rotated = np.rot90(mask, k)
+        variants.append((tuple(map(int, rotated.shape)), rotated.tobytes()))
+    return min(variants)
+
+
+def _find_monochrome_components(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
