+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill every rectangular frame with the legend pattern selected by nesting depth.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = _corner_bg(g)
