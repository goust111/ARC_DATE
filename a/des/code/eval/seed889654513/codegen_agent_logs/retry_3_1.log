+from __future__ import annotations
+
+from collections import Counter
+from dataclasses import dataclass, field
+
+import numpy as np
+
+
+@dataclass
+class _Node:
+    color: int = -1
+    bbox: tuple[int, int, int, int] = (0, 0, 0, 0)
