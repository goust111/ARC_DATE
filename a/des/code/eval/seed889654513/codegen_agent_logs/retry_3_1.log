+    lr0, lc0, _, _ = legend_box
+    for i, pattern in enumerate(patterns):
+        patch = grid[lr0 : lr0 + 3, lc0 + 4 * i : lc0 + 4 * i + 3]
+        patch[pattern] = LEGEND_COLOR
+    return grid
