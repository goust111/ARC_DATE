+def _legend_bbox(shape: tuple[int, int], depth: int, corner: str) -> tuple[int, int, int, int]:
+    h, w = shape
+    box_w = 4 * depth - 1
+    if corner == "tl":
+        return (0, 0, 2, box_w - 1)
+    if corner == "tr":
+        return (0, w - box_w, 2, w - 1)
+    if corner == "bl":
+        return (h - 3, 0, h - 1, box_w - 1)
+    return (h - 3, w - box_w, h - 1, w - 1)
