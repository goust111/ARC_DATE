+    for min_dist in (4, 3, 2, 1, 0):
+        for _ in range(40):
+            chosen: list[tuple[int, int]] = []
+            for idx in RNG.permutation(len(candidates)):
+                r, c = candidates[int(idx)]
+                if all(abs(r - rr) + abs(c - cc) >= min_dist for rr, cc in chosen):
