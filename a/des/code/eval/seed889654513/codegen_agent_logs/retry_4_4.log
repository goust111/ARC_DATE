+
+def _build_top_layout(top_h: int, width: int) -> np.ndarray | None:
+    result = _partition_top(top_h, width)
+    if result is None:
+        return None
+    top, rooms = result
+    for room in rooms:
+        _add_protrusion(top, room)
+
+    comps = _connected_components(top != BLACK)
+    if len(comps) < ROOM_COUNT_RANGE[0]:
