+        max_seed = min(6, max(2, len(comp) // 4))
+        options = [n for n in range(1, max_seed + 1) if n % 2 == parity]
+        if not options:
+            return None
+        seed_count = int(RNG.choice(options))
+        positions = _sample_seed_positions(seeded_top, comp, seed_count)
