+    sep = _find_separator_row(g)
+    mapping = _legend_mapping(g, sep)
+    rooms = _room_components(g, sep)
+
+    out = g.copy()
+    top = g[:sep]
+    for comp in rooms:
+        rr = comp[:, 0]
+        cc = comp[:, 1]
+        values = top[rr, cc]
