+GEN_CELL_SIZE_RANGE = (3, 6)
+GEN_MARGIN_RANGE = (1, 3)
+GEN_GRID_LEGEND_GAP_RANGE = (2, 5)
+GEN_LEGEND_SIZE_RANGE = (1, 3)
+GEN_LEGEND_GAP_RANGE = (1, 2)
+GEN_ATTEMPTS = 500
