+def _symmetry_kind(mask: np.ndarray) -> int:
+    lr = np.array_equal(mask, np.fliplr(mask))
+    ud = np.array_equal(mask, np.flipud(mask))
+    mapping = {
+        (False, False): 0,
+        (True, False): 1,
+        (False, True): 2,
+        (True, True): 3,
