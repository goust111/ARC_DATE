+        else:
+            used_cols.append(coord)
+        specs.append({"axis": axis, "side": side, "coord": coord, "dkey": dkey})
+
+    if len(specs) > len(LINE_COLORS):
+        return None
+
+    colors = list(LINE_COLORS)
+    rng.shuffle(colors)
+    for spec, color in zip(specs, colors):
