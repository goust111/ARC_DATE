+        if not candidates:
+            return None
+        coord = rng.choice(candidates)
+        dkey = _distance_key(axis, coord, board_h, board_w)
+        used_dkeys.add(dkey)
+        if axis == "h":
+            used_rows.append(coord)
+        else:
+            used_cols.append(coord)
