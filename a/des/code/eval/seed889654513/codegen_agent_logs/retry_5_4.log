+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+BG = 0
+BOARD = 8
+LINE_COLORS = (1, 2, 3, 4, 5, 6, 7, 9)
+GEN_ATTEMPTS = 400
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _bbox(cells: list[tuple[int, int]] | set[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((int(rr), int(cc)))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _board_and_lines(
+    grid: np.ndarray,
+) -> tuple[int, int, tuple[int, int, int, int], np.ndarray, dict[int, dict[str, int]]]:
+    g = np.asarray(grid, dtype=int)
+    bg = _most_common_color(g)
+
+    vals, counts = np.unique(g[g != bg], return_counts=True)
+    assert len(vals) > 0, "expected a non-background board color"
+    board_color = int(vals[np.argmax(counts)])
+
+    board_cells = np.argwhere(g == board_color)
