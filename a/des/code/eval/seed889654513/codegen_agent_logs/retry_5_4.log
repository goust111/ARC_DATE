+
+    line_mask = board != BOARD
+    want_overlap = len(specs) >= 2 and rng.random() < 0.7
+    occupied_actual: set[tuple[int, int]] = set()
+    prior_final: set[tuple[int, int]] = set()
+
+    for spec in sorted(specs, key=lambda item: -int(item["dkey"])):
