+    num_v = rng.randint(1, 2) if mode in ("v", "hv") else 0
+
+    tasks: list[tuple[str, str]] = []
+    tasks.extend(("h", rng.choice(("top", "bottom"))) for _ in range(num_h))
+    tasks.extend(("v", rng.choice(("left", "right"))) for _ in range(num_v))
