+    if r0 > br1 and bc0 <= c1 and c0 <= bc1:
+        return "bottom"
+    if c1 < bc0 and br0 <= r1 and r0 <= br1:
+        return "left"
+    if c0 > bc1 and br0 <= r1 and r0 <= br1:
+        return "right"
