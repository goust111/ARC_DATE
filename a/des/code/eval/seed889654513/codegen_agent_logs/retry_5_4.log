+                rr = 2 * int(frag["line_abs"]) - aligned_r
+                cc = c
+                if br0 <= rr <= br1 and bc0 <= cc <= bc1:
+                    out[rr - br0, cc - bc0] = color
+        elif frag["side"] == "bottom":
+            delta_r = br1 + 1 - r0
+            for r, c in frag["cells"]:
+                aligned_r = r + delta_r
+                rr = 2 * int(frag["line_abs"]) - aligned_r
+                cc = c
+                if br0 <= rr <= br1 and bc0 <= cc <= bc1:
