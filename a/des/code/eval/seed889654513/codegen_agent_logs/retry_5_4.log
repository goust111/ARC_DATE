+    tasks.extend(("v", rng.choice(("left", "right"))) for _ in range(num_v))
+    rng.shuffle(tasks)
+
+    specs: list[dict[str, object]] = []
+    used_dkeys: set[int] = set()
+    used_rows: list[int] = []
+    used_cols: list[int] = []
+
+    for axis, side in tasks:
+        candidates = _candidate_positions(board_h if axis == "h" else board_w, side)
