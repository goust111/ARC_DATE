+            seen[r, c] = True
+            q = deque([(r, c)])
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((int(rr), int(cc)))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
