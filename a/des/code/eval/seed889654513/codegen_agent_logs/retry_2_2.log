+        trial_rect[marker_a] = MARKER
+        trial_rect[marker_b] = MARKER
+        frag_a = _fragment_from_patch(_make_patch_from_cells(a_cells, trial_rect, 0), 0)
+        frag_b = _fragment_from_patch(_make_patch_from_cells(b_cells, trial_rect, 0), 0)
