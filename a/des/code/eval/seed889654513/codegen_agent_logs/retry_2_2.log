+                    "markers": tuple(markers),
+                    "delta": (int(dr), int(dc)),
+                }
+            )
+    return candidates
+
+
+def _assemble_unique_pair(frag_a: dict, frag_b: dict) -> dict:
+    candidates = _assembly_candidates(frag_a, frag_b)
+    assert len(candidates) == 1, "pair must assemble into a rectangle in exactly one way"
+    return candidates[0]
