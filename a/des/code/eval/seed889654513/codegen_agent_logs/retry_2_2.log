+def _extract_fragments(grid: np.ndarray, bg: int) -> list[dict]:
+    parts = components_mask(grid != bg, connectivity=4)
+    return [_fragment_from_patch(grid[r0:r1 + 1, c0:c1 + 1], bg, (r0, c0))
+            for coords in parts
+            for (r0, c0, r1, c1) in [bbox_coords(coords)]]
