+        "shape": tuple(map(int, patch.shape)),
+        "coords": abs_coords,
+        "base_color": base_color,
+        "rel_values": rel_values,
+        "marker_rel": tuple(map(int, marker_coords[0])),
+        "center": (
+            float(abs_coords[:, 0].mean()),
+            float(abs_coords[:, 1].mean()),
