+            rect = np.full((rect_h, rect_w), base, dtype=int)
+            markers = []
+            for (r, c), value in frag_a["rel_values"].items():
+                rr = r - min_r
+                cc = c - min_c
+                rect[rr, cc] = int(value)
+                if int(value) == MARKER:
+                    markers.append((int(rr), int(cc)))
+            for (r, c), value in frag_b["rel_values"].items():
+                rr = r + dr - min_r
+                cc = c + dc - min_c
+                rect[rr, cc] = int(value)
+                if int(value) == MARKER:
+                    markers.append((int(rr), int(cc)))
+
+            candidates.append(
