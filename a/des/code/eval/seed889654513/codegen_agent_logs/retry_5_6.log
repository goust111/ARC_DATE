 265: def _paint(records: list[Record], n: int) -> tuple[np.ndarray, np.ndarray]:
 266:     inp = np.full((n, n), BG, dtype=int)
 267:     out = np.full((n, n), BG, dtype=int)
 268:     for rec in records:
 269:         hinge = rec["hinge"]
 270:         endpoint = rec["endpoint"]
 271:         inp[hinge] = HINGE
 272:         out[hinge] = HINGE
 273:         inp[endpoint] = END
 274:         out[endpoint] = END
 275:         for p in rec["fixed_red"]:
 276:             inp[p] = RED
 277:             out[p] = RED
 278:         for p in rec["tail"]:
 279:             inp[p] = RED
 280:         for p in rec["folded"]:
 281:             out[p] = RED
 282:     return inp, out
