 258:     fixed_len = random.choice(fixed_lengths)
 259:     orientations = sorted({key[3] for key in by_key if key[:2] == (total_len, fixed_len)})
 260:     orient = random.choice(orientations)
 261:     tail_len = total_len - fixed_len
