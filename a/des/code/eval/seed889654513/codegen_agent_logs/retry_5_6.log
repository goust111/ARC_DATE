+
+
+def _render_output(inp: np.ndarray, paths: list[dict]) -> np.ndarray:
+    out = np.array(inp, copy=True)
+    for path in paths:
+        for segment in path["segments"]:
+            color = int(segment["color"])
+            for r, c in segment["cells"]:
