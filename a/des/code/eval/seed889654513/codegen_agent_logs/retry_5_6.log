+def _detect_relays(grid: np.ndarray) -> dict[tuple[int, int], dict]:
+    h, w = grid.shape
+    relays: dict[tuple[int, int], dict] = {}
+    for r, c in zip(*np.where(grid == ORANGE)):
+        rr = int(r)
+        cc = int(c)
