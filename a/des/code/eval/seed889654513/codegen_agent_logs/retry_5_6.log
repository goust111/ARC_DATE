 285: def _place_records(n: int, rod_count: int) -> list[Record] | None:
 286:     """Sample non-touching rods and their fold envelopes for one grid."""
 287:     blocked: set[tuple[int, int]] = set()
 288:     records: list[Record] = []
 289:     red_total = 0
 290: 
 291:     for i in range(rod_count):
 292:         rec = _choose_record(n, blocked, rod_count, red_total, i == rod_count - 1)
 293:         if rec is None:
 294:             return None
 295:         records.append(rec)
 296:         red_total += int(rec["red_count"])
 297:         blocked |= _expanded(rec["envelope"], n)
 298:     return records
