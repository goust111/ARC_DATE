 240: def _invert_output_to_input(
 241:     output: np.ndarray, rects: list[tuple[int, int, int, int, str]], grey_frac: float
 242: ) -> np.ndarray:
 243:     H, W = output.shape
 244:     inp = output.copy()
 245: 
 246:     for (dr0, dc0, dr1, dc1, se) in rects:
 247:         if se in ("top", "bottom"):
 248:             inp[:, dc0:dc1 + 1] = _random_background((H, dc1 - dc0 + 1), grey_frac)
 249:         else:
 250:             inp[dr0:dr1 + 1, :] = _random_background((dr1 - dr0 + 1, W), grey_frac)
 251: 
 252:     for (dr0, dc0, dr1, dc1, se) in rects:
 253:         rh, rw = dr1 - dr0 + 1, dc1 - dc0 + 1
 254:         if se == "top":
 255:             inp[0:rh, dc0:dc1 + 1] = 0
 256:         elif se == "bottom":
 257:             inp[H - rh:H, dc0:dc1 + 1] = 0
 258:         elif se == "left":
 259:             inp[dr0:dr1 + 1, 0:rw] = 0
 260:         else:
 261:             inp[dr0:dr1 + 1, W - rw:W] = 0
 262: 
 263:     return inp
 264: 
