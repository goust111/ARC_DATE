+def _detect_receivers(grid: np.ndarray) -> list[dict]:
+    receivers: list[dict] = []
+    for comp in _components4(grid == GREY):
+        if len(comp) != 12:
+            continue
+        r0, c0, r1, c1 = _bbox(comp)
+        if (r1 - r0 + 1, c1 - c0 + 1) != (4, 4):
+            continue
+        frame, interior, _full = _receiver_cells((r0, c0))
