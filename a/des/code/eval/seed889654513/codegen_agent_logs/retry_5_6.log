 226: def _render_output(H: int, W: int, rects: list[tuple[int, int, int, int, str]], grey_frac: float) -> np.ndarray:
 227:     output = _random_background((H, W), grey_frac)
 228: 
 229:     for (dr0, dc0, dr1, dc1, se) in rects:
 230:         if se in ("top", "bottom"):
 231:             output[:, dc0:dc1 + 1] = BG_ORANGE
 232:         else:
 233:             output[dr0:dr1 + 1, :] = BG_ORANGE
 234: 
 235:     for (dr0, dc0, dr1, dc1, _) in rects:
 236:         output[dr0:dr1 + 1, dc0:dc1 + 1] = 0
 237:     return output
