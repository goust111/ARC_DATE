 431: 
 432:     inp = out_final.copy()
 433:     inp[inp == FILL] = BG
 434:     inp[hidden_placed] = WALL
 435: 
 436:     if not np.array_equal(main(inp), out_final):
 437:         return None
 438:     return inp
