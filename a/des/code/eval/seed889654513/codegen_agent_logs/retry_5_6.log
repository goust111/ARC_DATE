 394: 
 395:     reach = _flood_mask(marker_rc, structural, h, w)
 396:     reach_frac = reach.mean()
 397:     if not (REACH_RATIO_RANGE[0] <= reach_frac <= REACH_RATIO_RANGE[1]):
 398:         return None
 399: 
 400:     if not _validate_structural(structural, reach, h, w):
 401:         return None
 402: 
 403:     out = _paint_output(structural, reach, marker_rc)
 404: 
 405:     # FILL must form a single 4-connected ring (task-semantic invariant).
 406:     fill_mask = (out == FILL)
 407:     if not fill_mask.any() or len(components_mask(fill_mask, connectivity=4)) != 1:
 408:         return None
 409: 
 410:     # Decorations: visible (inside reach, kept as WALL in output) vs hidden
 411:     # (outside reach, erased to BG in output — input-only).
 412:     n_decor = rng.randint(*NUM_DECOR_RANGE)
 413:     n_visible = rng.randint(0, n_decor)
 414:     n_hidden = n_decor - n_visible
 415: 
