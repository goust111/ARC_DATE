+def _place_extra_receivers(
+    shape: tuple[int, int],
+    occupied: set[tuple[int, int]],
+    count: int,
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    h, w = shape
+    placed: list[tuple[int, int]] = []
