+def _simulate_launch(
+    grid: np.ndarray,
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    color: int,
+    relays: dict[tuple[int, int], dict],
+    receiver_by_border: dict[tuple[int, int], int],
+) -> dict | None:
