 423: def _find_obstacle_candidates(grid, bg, wall_color, nominal_fill_zone):
 424:     """Find bg cells far enough from wall for obstacle placement, using distance transform."""
 425:     wall_mask = grid == wall_color
 426:     # distance_transform_cdt with chessboard metric gives Chebyshev distance to wall
 427:     dist = distance_transform_cdt(~wall_mask, metric='taxicab')
 428:     far_from_wall = dist > 1
 429:     eligible = (grid == bg) & far_from_wall
 430:     all_coords = list(zip(*np.where(eligible)))
 431:     fill_coords = [p for p in all_coords if nominal_fill_zone[p[0], p[1]]]
 432:     random.shuffle(all_coords)
 433:     random.shuffle(fill_coords)
 434:     return [(int(r), int(c)) for r, c in all_coords], [(int(r), int(c)) for r, c in fill_coords]
