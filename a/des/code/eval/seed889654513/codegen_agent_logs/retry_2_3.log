+        offset = hit_r - pr
+    elif direction == LEFT and hit_c == pc + 1 and hit_r in (pr, pr + 1):
+        offset = hit_r - pr
+    elif direction == DOWN and hit_r == pr and hit_c in (pc, pc + 1):
+        offset = hit_c - pc
+    elif direction == UP and hit_r == pr + 1 and hit_c in (pc, pc + 1):
+        offset = hit_c - pc
