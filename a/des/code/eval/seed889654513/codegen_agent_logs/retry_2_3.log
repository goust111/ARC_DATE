+        rr, cc = r, c
+        dr, dc = DIRS[direction]
+        while True:
+            nr, nc = rr + dr, cc + dc
+            if not _in_bounds(h, w, nr, nc):
+                break
+            if int(out[nr, nc]) == AZURE:
