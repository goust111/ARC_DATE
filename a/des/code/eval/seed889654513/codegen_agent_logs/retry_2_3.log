+    source_sides = random.sample([EDGE_TOP, EDGE_RIGHT, EDGE_BOTTOM, EDGE_LEFT], k=side_count)
+    num_sources = random.choices([1, 2, 3], weights=[4, 4, 1], k=1)[0]
+    num_sources = max(num_sources, side_count)
