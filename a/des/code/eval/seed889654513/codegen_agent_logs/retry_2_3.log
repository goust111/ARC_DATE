+
+AZURE = 8
+RED = 2
+GREEN = 3
+WALL = 5
+BG_POOL = [0, 1, 4, 6, 7, 9]
+
+UP, RIGHT, DOWN, LEFT = range(4)
+DIRS = {
+    UP: (-1, 0),
+    RIGHT: (0, 1),
+    DOWN: (1, 0),
+    LEFT: (0, -1),
+}
+TURN_LEFT = {UP: LEFT, RIGHT: UP, DOWN: RIGHT, LEFT: DOWN}
+TURN_RIGHT = {UP: RIGHT, RIGHT: DOWN, DOWN: LEFT, LEFT: UP}
+PRISM_TURN = {RED: "L", GREEN: "R"}
