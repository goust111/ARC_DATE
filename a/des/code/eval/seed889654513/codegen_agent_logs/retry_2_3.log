+            return None
+    for r, c in walls:
+        if int(out[r, c]) != WALL:
+            return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate a valid splitter puzzle after {MAX_GENERATION_RETRIES} attempts")

