+    grid[r1, c0 : c1 + 1] = color
+    grid[r0 : r1 + 1, c0] = color
+    grid[r0 : r1 + 1, c1] = color
+
+
+def _detect_frames(grid: np.ndarray) -> tuple[list[dict], np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    frame_mask = np.zeros_like(g, dtype=bool)
+    frames: list[dict] = []
