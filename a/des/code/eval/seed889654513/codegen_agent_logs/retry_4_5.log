+def _transform_mask(mask: np.ndarray, depth: int) -> np.ndarray:
+    mode = (depth - 1) % 3
+    if mode == 0:
+        return np.flipud(mask)
+    if mode == 1:
+        return np.fliplr(mask)
+    return np.flipud(np.fliplr(mask))
