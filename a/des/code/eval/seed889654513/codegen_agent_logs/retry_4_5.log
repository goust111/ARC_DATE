+
+def _find_components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    components: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+    return components
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _bbox_from_mask(mask: np.ndarray) -> tuple[int, int, int, int]:
+    coords = np.argwhere(mask)
+    assert coords.size > 0
+    return _bbox_from_coords(coords)
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox_from_mask(mask)
+    return mask[r0 : r1 + 1, c0 : c1 + 1]
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    return int(mask.any()) == 0 or len(_find_components(mask)) == 1
+
+
+def _rect_frame_bbox(coords: np.ndarray) -> tuple[int, int, int, int] | None:
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+
+    if int(coords.shape[0]) != 2 * (h + w) - 4:
+        return None
+
+    local = np.zeros((h, w), dtype=bool)
+    local[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    expected = np.zeros((h, w), dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    if not np.array_equal(local, expected):
+        return None
+    return r0, c0, r1, c1
+
