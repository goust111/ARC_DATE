+
+def _pattern_patch(h: int, w: int, palette: list[int]) -> np.ndarray:
+    k = len(palette)
+    shift = random.randrange(k)
+    mode = random.choice(["diag", "bands", "checker", "mix"])
+    patch = np.empty((h, w), dtype=int)
+    for r in range(h):
+        for c in range(w):
+            if mode == "diag":
+                idx = (r + 2 * c + shift) % k
+            elif mode == "bands":
+                idx = ((r // 2) + c + shift) % k
+            elif mode == "checker":
+                idx = ((r // 2) + (c // 2) + shift) % k
+            else:
+                idx = (2 * r + 3 * c + shift) % k
+            patch[r, c] = palette[idx]
