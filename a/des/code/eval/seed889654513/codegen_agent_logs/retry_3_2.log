+            c0 = random.randint(min_col, grid_w - w - 1)
+            box = (r0, c0, r0 + h - 1, c0 + w - 1)
+            expanded = (r0 - 1, c0 - 1, r0 + h, c0 + w)
+            if any(_boxes_overlap(expanded, other) for other in blocked):
+                continue
