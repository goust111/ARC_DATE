+    if grid_h_min > GRID_H_RANGE[1]:
+        return None
+    grid_h = random.randint(grid_h_min, GRID_H_RANGE[1])
+    grid_w_min = max(2 * template_w + 4, 24)
+    if grid_w_min > GRID_W_MAX:
+        return None
+    grid_w = random.randint(grid_w_min, GRID_W_MAX)
