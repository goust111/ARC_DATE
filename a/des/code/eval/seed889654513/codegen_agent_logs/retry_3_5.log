+def _shape_relative(max_h: int, max_w: int) -> list[tuple[int, int]] | None:
+    families = ("rect", "hline", "vline", "ell", "diag_down", "diag_up", "plus", "frame")
+    weights = (5, 3, 3, 4, 2, 2, 2, 2)
+
+    for _ in range(20):
+        family = random.choices(families, weights=weights, k=1)[0]
+
