+def _groups(indices: list[int]) -> list[tuple[int, int]]:
+    if not indices:
+        return []
+
+    groups: list[tuple[int, int]] = []
+    start = prev = int(indices[0])
+    for idx in indices[1:]:
+        idx = int(idx)
+        if idx == prev + 1:
+            prev = idx
+            continue
+        groups.append((start, prev))
+        start = prev = idx
+    groups.append((start, prev))
+    return groups
