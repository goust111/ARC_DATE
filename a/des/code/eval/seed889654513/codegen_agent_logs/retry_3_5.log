+        if int(grid[r, 0]) != BLACK and np.all(grid[r, :] == grid[r, 0])
+    ]
+    col_candidates = [
+        int(c)
+        for c in range(w)
+        if int(grid[0, c]) != BLACK and np.all(grid[:, c] == grid[0, c])
