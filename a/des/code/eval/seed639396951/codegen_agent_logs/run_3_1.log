+    arr = [int(v) for v in line.tolist()]
+    pairs: list[tuple[int, int]] = []
+    i = 0
+    n = len(arr)
+    while i < n:
+        if arr[i] == bg:
+            i += 1
+            continue
+        run: list[int] = []
+        while i < n and arr[i] != bg:
+            run.append(arr[i])
+            i += 1
+        if len(run) < 2 or len(run) % 2 != 0:
+            return []
+        for j in range(0, len(run), 2):
+            pairs.append((run[j], run[j + 1]))
+    return pairs
