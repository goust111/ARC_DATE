+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(400):
+        grid = _candidate_grid(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input failed to produce a valid sample")

