+            sh = max(r for r, _ in shape) + 1
+            sw = max(c for _, c in shape) + 1
+            if sh > ih or sw > iw:
+                continue
+            r0 = int(rng.integers(0, ih - sh + 1))
+            c0 = int(rng.integers(0, iw - sw + 1))
