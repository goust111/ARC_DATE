+    fr0, fc0, fr1, fc1 = frag_bbox
+    frag_h = fr1 - fr0 + 1
+    frag_w = fc1 - fc0 + 1
+    if direction == "up":
+        return (r0 - frag_h, c0 + fc0, r0 - 1, c0 + fc1)
+    if direction == "down":
+        return (r1 + 1, c0 + fc0, r1 + frag_h, c0 + fc1)
+    if direction == "left":
+        return (r0 + fr0, c0 - frag_w, r0 + fr1, c0 - 1)
+    if direction == "right":
+        return (r0 + fr0, c1 + 1, r0 + fr1, c1 + frag_w)
