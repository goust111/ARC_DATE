+            return False
+        start = int(rng.integers(0, h - needed + 1))
+        col = 0 if side == "left" else w - 1
+        idx = start
+        for spec in specs:
+            a = int(spec["border_color"])
+            b = int(spec["target_color"])
+            if rng.integers(2):
+                a, b = b, a
