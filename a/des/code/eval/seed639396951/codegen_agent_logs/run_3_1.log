+    fr0, fc0, fr1, fc1 = frag_bbox
+    if direction == "up":
+        return (r0 - 1 - fr1, 0)
+    if direction == "down":
+        return (r1 + 1 - fr0, 0)
+    if direction == "left":
+        return (0, c0 - 1 - fc1)
+    if direction == "right":
+        return (0, c1 + 1 - fc0)
