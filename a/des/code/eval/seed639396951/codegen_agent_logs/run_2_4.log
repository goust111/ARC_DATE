+) -> None:
+    r0, r1 = span
+    band_h = r1 - r0
+    x = int(start_col)
+    for index, color in enumerate(order):
+        sprite = sprites[color]
+        top = r0 + (band_h - sprite["height"]) // 2
+        for dr, dc in sprite["cells"]:
+            rr = top + int(dr)
+            cc = x + int(dc)
