+
+
+def _normalize_cells(cells: set[tuple[int, int]]) -> dict:
+    arr = np.asarray(sorted(cells), dtype=int)
+    r0 = int(arr[:, 0].min())
+    c0 = int(arr[:, 1].min())
+    arr = arr - np.array([r0, c0], dtype=int)
+    return _sprite_from_component(-1, arr)
