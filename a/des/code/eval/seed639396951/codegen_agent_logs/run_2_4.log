+            return sprite
+    return None
+
+
+def _sequence_width(sprites: dict[int, dict], order: list[int], gaps: list[int], start_col: int) -> int:
+    width = int(start_col)
+    for i, color in enumerate(order):
+        width += int(sprites[color]["width"])
