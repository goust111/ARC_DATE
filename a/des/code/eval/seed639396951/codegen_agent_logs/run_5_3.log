+    bg = random.choice(NON_GREY_COLORS)
+    stamp_colors = random.sample([c for c in NON_GREY_COLORS if c != bg], n_stamps)
+
+    modes = [random.choice(PATTERN_MODES) for _ in range(n_stamps)]
+    stamp_masks = {
