+NON_GREY_COLORS = tuple(c for c in COLOR_POOL if c != GREY)
+
+GRID_WIDTH_MAX = 30
+STAMP_COUNT_RANGE = (2, 4)
+STAMP_HEIGHT_RANGE = (4, 8)
+STAMP_WIDTH_MIN = 4
