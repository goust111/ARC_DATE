    assert np.all(right[:-1] == bg), "canvas must start blank"

    out = np.full((canvas_h, canvas_w), bg, dtype=int)
    for color in sequence:
        mask = stamps[color]
        out[mask] = color
    return out


def _rect_hole_mask(h: int, w: int) -> np.ndarray:
    mask = np.ones((h, w), dtype=bool)
