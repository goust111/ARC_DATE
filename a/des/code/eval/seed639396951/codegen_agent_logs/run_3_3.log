+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+YELLOW = 4
+ORANGE = 7
+PATH_COLORS = (1, 2, 3, 5, 6, 8, 9)
+
+UP = (-1, 0)
+RIGHT = (0, 1)
+DOWN = (1, 0)
+LEFT = (0, -1)
+DIRS = (UP, RIGHT, DOWN, LEFT)
+DIR_PAIRS = tuple(
+    (DIRS[i], DIRS[j])
+    for i in range(len(DIRS))
