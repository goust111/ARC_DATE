+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= int(r) < int(shape[0]) and 0 <= int(c) < int(shape[1])
+
+
+def _rotate_offset(dr: int, dc: int, steps: int) -> tuple[int, int]:
+    steps = int(steps) % 4
+    if steps == 0:
+        return int(dr), int(dc)
+    if steps == 1:
+        return int(dc), -int(dr)
+    if steps == 2:
