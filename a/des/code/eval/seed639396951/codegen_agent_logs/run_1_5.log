+    inp, out = rendered
+
+    if not _input_structure_ok(inp, colors):
+        return None
+    if np.array_equal(inp, out):
+        return None
+    try:
+        pred = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(pred, out):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt(rng)
