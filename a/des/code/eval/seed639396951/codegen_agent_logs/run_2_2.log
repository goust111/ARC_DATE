+                        bottom_dirty = 0 if r1 + 1 == h else int(np.count_nonzero(occ[r1 + 1, c0 : c1 + 1]))
+                        left_dirty = 0 if c0 == 0 else int(np.count_nonzero(occ[r0 : r1 + 1, c0 - 1]))
+                        right_dirty = 0 if c1 + 1 == w else int(np.count_nonzero(occ[r0 : r1 + 1, c1 + 1]))
