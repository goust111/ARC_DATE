+
+def _expected_from_layout(
+    shape: tuple[int, int],
+    rects: list[dict],
+    adj: list[set[int]],
+    source: int,
+    markers: dict[int, tuple[int, int]],
+) -> np.ndarray:
+    out = np.full(shape, BLACK, dtype=int)
+    dist = _component_distances(adj, source)
+    for idx, rect in enumerate(rects):
+        if idx == source:
