+
+
+def _component_distances(adj: list[set[int]], source: int) -> list[int]:
+    dist = [-1] * len(adj)
+    dist[source] = 0
+    q = deque([source])
+    while q:
+        cur = q.popleft()
+        for nxt in adj[cur]:
+            if dist[nxt] == -1:
+                dist[nxt] = dist[cur] + 1
+                q.append(nxt)
