+
+def _choose_terminal_cells(
+    grid: np.ndarray,
+    rects: list[dict],
+    terminal_ids: set[int],
+    rng: random.Random,
+) -> dict[int, tuple[int, int]] | None:
+    markers = {}
+    for idx in terminal_ids:
