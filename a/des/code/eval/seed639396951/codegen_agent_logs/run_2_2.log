+MIN_SIZE = 2
+MAX_SIZE = 5
+MAX_TOTAL_RECTS = 9
+MAX_SPAN = 26
+MARGIN_RANGE = (1, 3)
+GEN_RETRIES = 500
+ATTACH_RETRIES = 120
+ISOLATED_RETRIES = 160
+PLACEMENT_SPAN = 12
