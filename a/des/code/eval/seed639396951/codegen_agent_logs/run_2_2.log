+            rects.append(cand)
+            adj.append(set())
+            new_idx = len(rects) - 1
+            adj[parent_idx].add(new_idx)
+            adj[new_idx].add(parent_idx)
+            comp_indices.append(new_idx)
+        components.append(comp_indices)
