        if r in intervals:
            start, stop = intervals[r]
        elif top < r < bottom:
            start, stop = 0, width - 1
        elif r < top:
            start, stop = intervals[top]
        else:
            start, stop = intervals[bottom]
        span = out[r, start : stop + 1]
        span[span == bg] = marker
    return out
