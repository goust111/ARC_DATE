+    r0: int,
+    r1: int,
+    c0: int,
+    c1: int,
+) -> int | None:
+    area = (r1 - r0 + 1) * (c1 - c0 + 1)
+    occ = _rect_sum(ps_occ, r0, r1, c0, c1)
+    if occ != area:
+        return None
+
+    red = _rect_sum(ps_red, r0, r1, c0, c1)
+    grey = _rect_sum(ps_grey, r0, r1, c0, c1)
+    yellow = _rect_sum(ps_yellow, r0, r1, c0, c1)
+    if red + grey + yellow != area:
+        return None
+    if yellow > 1:
+        return None
+    if red > 0 and grey == 0 and yellow == 0:
+        return RED
+    if grey > 0 and red == 0:
+        return GREY
+    return None
+
+
+def _extract_rectangles(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    occ = g != BLACK
+    ps_occ = _prefix(occ)
+    ps_red = _prefix(g == RED)
+    ps_grey = _prefix(g == GREY)
+    ps_yellow = _prefix(g == YELLOW)
+
+    candidates = []
+    for r0 in range(h):
+        for r1 in range(r0, h):
+            for c0 in range(w):
+                for c1 in range(c0, w):
+                    base = _rect_base_color(ps_occ, ps_red, ps_grey, ps_yellow, r0, r1, c0, c1)
+                    if base is None:
+                        continue
+
+                    ys = np.argwhere(g[r0 : r1 + 1, c0 : c1 + 1] == YELLOW)
+                    marker = None
+                    if ys.size:
+                        rr, cc = map(int, ys[0])
+                        marker = (r0 + rr, c0 + cc)
+                        if not (marker[0] in (r0, r1) or marker[1] in (c0, c1)):
+                            continue
+
+                    candidates.append(
+                        {
+                            "r0": r0,
+                            "c0": c0,
+                            "r1": r1,
+                            "c1": c1,
+                            "base": base,
+                            "marker": marker,
+                        }
+                    )
+
+    occ_pts = [tuple(map(int, pt)) for pt in np.argwhere(occ)]
+    index_of = {pt: i for i, pt in enumerate(occ_pts)}
+    full_mask = (1 << len(occ_pts)) - 1
+
+    cand_masks = []
+    cand_areas = []
+    by_cell = [[] for _ in occ_pts]
+    for idx, rect in enumerate(candidates):
+        mask = 0
+        area = 0
+        for r in range(rect["r0"], rect["r1"] + 1):
+            for c in range(rect["c0"], rect["c1"] + 1):
+                bit = 1 << index_of[(r, c)]
+                mask |= bit
+                area += 1
+        cand_masks.append(mask)
+        cand_areas.append(area)
+        for r in range(rect["r0"], rect["r1"] + 1):
+            for c in range(rect["c0"], rect["c1"] + 1):
+                by_cell[index_of[(r, c)]].append(idx)
+
+    best: list[int] | None = None
+
+    def search(covered: int, chosen: list[int]) -> None:
+        nonlocal best
+        if covered == full_mask:
+            if best is None or len(chosen) < len(best):
+                best = chosen.copy()
+            return
+        if best is not None and len(chosen) >= len(best):
+            return
+
+        target_cell = None
+        target_opts = None
+        for cell_idx in range(len(occ_pts)):
+            if (covered >> cell_idx) & 1:
+                continue
+            opts = [ci for ci in by_cell[cell_idx] if cand_masks[ci] & covered == 0]
+            if not opts:
+                return
+            if target_opts is None or len(opts) < len(target_opts):
+                target_cell = cell_idx
+                target_opts = opts
+                if len(target_opts) == 1:
+                    break
+
+        assert target_cell is not None and target_opts is not None
+        target_opts.sort(key=lambda ci: (-cand_areas[ci], candidates[ci]["r0"], candidates[ci]["c0"]))
+        for cand_idx in target_opts:
+            chosen.append(cand_idx)
+            search(covered | cand_masks[cand_idx], chosen)
+            chosen.pop()
+
+    search(0, [])
+    if best is None:
+        raise AssertionError("failed to recover rectangle cover")
+
+    rects = [candidates[idx] for idx in best]
+    rects.sort(key=lambda r: (r["r0"], r["c0"], r["r1"], r["c1"]))
+    return rects
