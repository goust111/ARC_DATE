+        for r, c in _rect_border_cells(rect):
+            for dr, dc in DIR4:
+                nr, nc = r + dr, c + dc
+                inside = rect["r0"] <= nr <= rect["r1"] and rect["c0"] <= nc <= rect["c1"]
