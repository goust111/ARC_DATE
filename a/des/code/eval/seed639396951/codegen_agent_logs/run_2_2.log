+    dist = [-1] * len(rects)
+    dist[source] = 0
+    q = deque([source])
+    while q:
+        cur = q.popleft()
+        for nxt in adj[cur]:
+            if dist[nxt] == -1:
+                dist[nxt] = dist[cur] + 1
+                q.append(nxt)
+
+    out = np.full_like(g, BLACK)
+    for i, rect in enumerate(rects):
+        if rect["base"] == RED:
+            color = RED
+        elif dist[i] == -1:
+            color = GREY
+        elif dist[i] % 2 == 1:
+            color = BLUE
+        else:
+            color = GREEN
