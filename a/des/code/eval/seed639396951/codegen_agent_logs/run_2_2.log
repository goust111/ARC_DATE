+def _shift_layout(rects: list[dict], top: int, left: int) -> list[dict]:
+    shifted = []
+    for rect in rects:
+        shifted.append(
+            {
+                "r0": rect["r0"] + top,
+                "c0": rect["c0"] + left,
+                "r1": rect["r1"] + top,
+                "c1": rect["c1"] + left,
+            }
