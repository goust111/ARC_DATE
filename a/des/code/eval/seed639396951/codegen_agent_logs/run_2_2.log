+                        area = (r1 - r0 + 1) * (c1 - c0 + 1)
+                        key = (area, 1 if marker is not None else 0, -r0, -c0)
+                        if best is None or key > best_key:
+                            best = {
+                                "r0": r0,
+                                "c0": c0,
+                                "r1": r1,
+                                "c1": c1,
+                                "base": base,
+                                "marker": marker,
+                            }
+                            best_key = key
