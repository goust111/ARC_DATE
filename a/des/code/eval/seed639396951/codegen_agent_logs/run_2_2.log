+    shifted = _shift_layout(rects, top_shift, left_shift)
+    grid = np.full((h, w), BLACK, dtype=int)
+    for idx, rect in enumerate(shifted):
+        color = RED if idx == source else GREY
+        grid[rect["r0"] : rect["r1"] + 1, rect["c0"] : rect["c1"] + 1] = color
