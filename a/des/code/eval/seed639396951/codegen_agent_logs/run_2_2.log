+    occ = _rect_sum(ps_occ, r0, r1, c0, c1)
+    if occ != area:
+        return None
+
+    red = _rect_sum(ps_red, r0, r1, c0, c1)
+    grey = _rect_sum(ps_grey, r0, r1, c0, c1)
+    yellow = _rect_sum(ps_yellow, r0, r1, c0, c1)
+    if red + grey + yellow != area:
+        return None
+    if yellow > 1:
+        return None
+    if red > 0 and grey == 0 and yellow == 0:
+        return RED
+    if grey > 0 and red == 0:
+        return GREY
+    return None
