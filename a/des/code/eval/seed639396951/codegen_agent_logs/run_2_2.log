+    out = np.full_like(g, BLACK)
+    for i, rect in enumerate(rects):
+        if rect["base"] == RED:
+            color = RED
+        elif dist[i] == -1:
+            color = GREY
+        elif dist[i] % 2 == 1:
+            color = BLUE
+        else:
+            color = GREEN
