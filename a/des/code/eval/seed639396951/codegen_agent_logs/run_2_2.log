+    dist = _component_distances(adj, source)
+    for idx, rect in enumerate(rects):
+        if idx == source:
+            color = RED
+        elif dist[idx] == -1:
+            color = GREY
+        elif dist[idx] % 2 == 1:
+            color = BLUE
+        else:
+            color = GREEN
+        out[rect["r0"] : rect["r1"] + 1, rect["c0"] : rect["c1"] + 1] = color
