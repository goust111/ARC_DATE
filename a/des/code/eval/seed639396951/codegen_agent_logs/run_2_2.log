+        cand = _try_attach(rects, parent_idx, rng)
+        if cand is None:
+            return None
+        rects.append(cand)
+        adj.append(set())
+        new_idx = len(rects) - 1
+        adj[parent_idx].add(new_idx)
+        adj[new_idx].add(parent_idx)
+        source_component.append(new_idx)
+        if step == 1:
+            forced_parent = new_idx
