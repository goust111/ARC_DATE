+        if max_overlap < 1:
+            return None
+        overlap = rng.randint(1, max_overlap)
+        starts = _starts_with_exact_overlap(parent["c0"], parent["c1"], w, overlap)
+        if not starts:
+            return None
+        c0 = rng.choice(starts)
