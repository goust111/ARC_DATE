+    return None
+
+
+def _try_isolated(rects: list[dict], rng: random.Random) -> dict | None:
+    for _ in range(ISOLATED_RETRIES):
+        h, w = _sample_dims(rng)
+        cand = _make_rect(
+            rng.randint(-PLACEMENT_SPAN, PLACEMENT_SPAN),
+            rng.randint(-PLACEMENT_SPAN, PLACEMENT_SPAN),
+            h,
+            w,
