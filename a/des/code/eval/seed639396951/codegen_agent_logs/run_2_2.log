+def _rect_border_cells(rect: dict) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = rect["r0"], rect["c0"], rect["r1"], rect["c1"]
+    cells = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        if r1 != r0:
+            cells.append((r1, c))
+    for r in range(r0 + 1, r1):
