+    return frames
+
+
+def _pattern_component(mask: np.ndarray, seeds: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    q = deque(seeds)
+    seen = set(seeds)
+    comp: list[tuple[int, int]] = []
+    while q:
+        r, c = q.popleft()
+        comp.append((r, c))
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
