+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+SEP = 5
+FRAME_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+DIR_ORDER = ["up", "right", "down", "left"]
+DIR_TO_GAP = {
+    "up": (0, 1),
+    "right": (1, 2),
+    "down": (2, 1),
+    "left": (1, 0),
+}
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _find_separator(grid: np.ndarray) -> int:
+    h, w = grid.shape
+    for c in range(1, w - 1):
+        col = grid[:, c]
+        if col[0] == BG:
+            continue
+        if np.all(col == col[0]) and np.any(grid[:, :c] != BG) and np.any(grid[:, c + 1 :] != BG):
+            return c
+    raise AssertionError("separator column not found")
+
+
+def _read_legend(legend: np.ndarray) -> dict[int, str]:
+    mapping: dict[int, str] = {}
+    for comp in _components(legend != BG):
+        r0, c0, r1, c1 = _bbox(comp)
+        if (r1 - r0 + 1, c1 - c0 + 1) != (3, 3):
+            continue
+        block = legend[r0 : r1 + 1, c0 : c1 + 1]
+        colors = {int(block[r, c]) for r, c in comp}
+        if len(colors) != 1 or len(comp) != 8:
+            continue
+        missing = [(r, c) for r in range(3) for c in range(3) if block[r, c] == BG]
+        if missing != [DIR_TO_GAP["up"]] and missing != [DIR_TO_GAP["right"]] and missing != [DIR_TO_GAP["down"]] and missing != [DIR_TO_GAP["left"]]:
+            continue
+        gap = missing[0]
+        direction = next(name for name, pos in DIR_TO_GAP.items() if pos == gap)
+        mapping[next(iter(colors))] = direction
+    if not mapping:
+        raise AssertionError("legend mapping not found")
+    return mapping
+
+
+def _is_frame(main_grid: np.ndarray, color: int, coords: list[tuple[int, int]]) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 4 or w < 4:
+        return False
+    block = main_grid[r0 : r1 + 1, c0 : c1 + 1]
+    if not np.all(block[0, :] == color):
+        return False
+    if not np.all(block[-1, :] == color):
+        return False
+    if not np.all(block[:, 0] == color):
+        return False
+    if not np.all(block[:, -1] == color):
+        return False
+    if np.any(block[1:-1, 1:-1] != BG):
+        return False
