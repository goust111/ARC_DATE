+                q.append((nr, nc))
+    return comp
+
+
+def _extract_pattern(
+    main_grid: np.ndarray, frame: dict[str, object], pattern_mask: np.ndarray
+) -> tuple[str, list[tuple[int, int]], np.ndarray]:
