+
+def _place_rect(
+    occ: np.ndarray, h: int, w: int, rng: random.Random, pad: int = 1
+) -> tuple[int, int] | None:
+    H, W = occ.shape
+    if h + 2 * pad > H or w + 2 * pad > W:
+        return None
+    for _ in range(300):
+        r = rng.randint(pad, H - h - pad)
+        c = rng.randint(pad, W - w - pad)
