+
+    ar0, ac0, ar1, ac1 = material_bbox
+    bundle[ar0 : ar1 + 1, ac0 : ac1 + 1] = True
+
+    sr0, sc0, sr1, sc1 = sweep_bbox
+    bundle[sr0 : sr1 + 1, sc0 : sc1 + 1] = True
+
