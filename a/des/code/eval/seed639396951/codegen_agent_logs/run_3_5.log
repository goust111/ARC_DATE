+
+
+def _material_size(rng: random.Random, shape_h: int, shape_w: int, area: int) -> tuple[int, int]:
+    mh = shape_h + rng.randint(0, 2)
+    mw = shape_w + rng.randint(0, 2)
+    if mh * mw <= area:
+        if rng.random() < 0.5:
