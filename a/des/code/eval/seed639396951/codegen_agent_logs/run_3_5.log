+def _is_solid_rect(mask: np.ndarray, coords: np.ndarray) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    return len(coords) == (r1 - r0 + 1) * (c1 - c0 + 1) and bool(mask[r0 : r1 + 1, c0 : c1 + 1].all())
