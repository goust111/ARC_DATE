+        mold_mask = np.zeros((mold_r1 - mold_r0 + 1, mold_c1 - mold_c0 + 1), dtype=bool)
+        mold_mask[mold[:, 0] - mold_r0, mold[:, 1] - mold_c0] = True
+        side, cavity = _extract_cavity(mold_mask)
