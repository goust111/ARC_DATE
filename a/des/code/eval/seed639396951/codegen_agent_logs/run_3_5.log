+        rr = coords[:, 0] + dr * (steps + 1)
+        cc = coords[:, 1] + dc * (steps + 1)
+        if np.any(rr < 0) or np.any(rr >= h) or np.any(cc < 0) or np.any(cc >= w):
+            break
