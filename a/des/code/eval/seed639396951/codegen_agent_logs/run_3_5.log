+        new_grid[mold_r0 : mold_r0 + mold_h, mold_c0 : mold_c0 + mold_w][mold_mask] = color
+        new_grid[mat_r0 : mat_r0 + mat_h, mat_c0 : mat_c0 + mat_w] = color
+        for r, c in wall_cells:
+            new_grid[r, c] = WALL
+        new_reserved |= pair_reserved
+        return new_grid, new_reserved
