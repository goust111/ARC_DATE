+            steps = rng.randint(2, max_steps - 1)
+        else:
+            steps = max_steps
+
+        final_bbox = (
+            start_bbox[0] + DIRS[side][0] * steps,
+            start_bbox[1] + DIRS[side][1] * steps,
+            start_bbox[2] + DIRS[side][0] * steps,
+            start_bbox[3] + DIRS[side][1] * steps,
