+
+    mold_h, mold_w = mold_mask.shape
+    cavity_local = np.argwhere(cavity)
+    cav_r0, cav_c0, cav_r1, cav_c1 = _bbox(cavity_local)
+
+    for _ in range(160):
+        mold_r0 = rng.randint(0, h - mold_h)
+        mold_c0 = rng.randint(0, w - mold_w)
+        start_bbox = (
+            mold_r0 + cav_r0,
+            mold_c0 + cav_c0,
+            mold_r0 + cav_r1,
+            mold_c0 + cav_c1,
+        )
