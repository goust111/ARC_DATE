+                wall_cells = [(wr, c) for c in range(final_bbox[1], final_bbox[3] + 1)]
+            elif side == "down":
+                wr = final_bbox[2] + 1
+                wall_cells = [(wr, c) for c in range(final_bbox[1], final_bbox[3] + 1)]
+            elif side == "left":
+                wc = final_bbox[1] - 1
+                wall_cells = [(r, wc) for r in range(final_bbox[0], final_bbox[2] + 1)]
+            else:
