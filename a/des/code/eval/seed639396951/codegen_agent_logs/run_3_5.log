+
+def _add_extra_walls(grid: np.ndarray, reserved: np.ndarray, rng: random.Random) -> tuple[np.ndarray, np.ndarray]:
+    h, w = grid.shape
+    new_grid = grid.copy()
+    new_reserved = reserved.copy()
+    target = rng.randint(1, 3)
