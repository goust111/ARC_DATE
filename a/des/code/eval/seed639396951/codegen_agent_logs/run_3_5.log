+        open_mask = mask.copy()
+        if side == "up":
+            open_mask[0, 1:-1] = False
+        elif side == "down":
+            open_mask[-1, 1:-1] = False
+        elif side == "left":
+            open_mask[1:-1, 0] = False
+        else:
+            open_mask[1:-1, -1] = False
