+def _background_color(grid: np.ndarray) -> int:
+    h, w = grid.shape
+    border = np.concatenate([grid[0, :], grid[-1, :], grid[1:-1, 0], grid[1:-1, -1]])
+    values, counts = np.unique(border, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
