+
+def _background_color(grid: np.ndarray) -> int:
+    h, w = grid.shape
+    border = np.concatenate([grid[0, :], grid[-1, :], grid[1:-1, 0], grid[1:-1, -1]])
+    values, counts = np.unique(border, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _coords_to_mask(coords: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask, (r0, c0, r1, c1)
+
+
+def _trim_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    assert coords.size > 0
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _mask_variants(mask: np.ndarray) -> list[np.ndarray]:
+    variants: list[np.ndarray] = []
+    seen: set[tuple[int, int, bytes]] = set()
+    for k in range(4):
+        rotated = np.rot90(mask, k)
+        for candidate in (rotated, np.fliplr(rotated)):
+            tight = _trim_mask(candidate)
+            key = (int(tight.shape[0]), int(tight.shape[1]), tight.tobytes())
+            if key in seen:
+                continue
+            seen.add(key)
+            variants.append(tight)
+    return variants
+
+
+def _shape_key(mask: np.ndarray) -> tuple[int, int, bytes]:
+    return min(
+        (int(variant.shape[0]), int(variant.shape[1]), variant.tobytes())
+        for variant in _mask_variants(mask)
+    )
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((int(cr), int(cc)))
+                for dr, dc in DIRS4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _color_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((int(cr), int(cc)))
+                for dr, dc in DIRS4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if (
+                        0 <= nr < h
+                        and 0 <= nc < w
+                        and not bool(seen[nr, nc])
+                        and int(grid[nr, nc]) == color
