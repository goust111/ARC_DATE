+    scan("top", [(r0 - 1, c) for c in range(c0, c1 + 1)])
+    scan("bottom", [(r1 + 1, c) for c in range(c0, c1 + 1)])
+    scan("left", [(r, c0 - 1) for r in range(r0, r1 + 1)])
+    scan("right", [(r, c1 + 1) for r in range(r0, r1 + 1)])
