+        frames = []
+        total_cells = 0
+        for comp in _components(grid == color):
+            if not _is_rect_frame(grid, color, comp):
+                continue
+            frames.append({"bbox": _bbox(comp), "color": color})
+            total_cells += int(comp.shape[0])
