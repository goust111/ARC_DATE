+def _stamp_origin(anchor: tuple[int, int], shape: tuple[int, int], side: str) -> tuple[int, int]:
+    ar, ac = anchor
+    ph, pw = shape
+    center_r = (ph - 1) // 2
+    center_c = (pw - 1) // 2
+    if side == "top":
+        return ar, ac - center_c
+    if side == "bottom":
+        return ar - (ph - 1), ac - center_c
+    if side == "left":
