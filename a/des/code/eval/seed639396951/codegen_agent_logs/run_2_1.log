+def _fits_with_padding(
+    occupied: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int
+) -> bool:
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(occupied.shape[0], r0 + h + pad)
+    cc1 = min(occupied.shape[1], c0 + w + pad)
+    return not bool(occupied[rr0:rr1, cc0:cc1].any())
