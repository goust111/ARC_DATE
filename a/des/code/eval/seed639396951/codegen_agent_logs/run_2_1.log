+    pattern = _pattern_from_items(source_items)
+    return {
+        "bg": bg,
+        "frame_color": frame_color,
+        "frames": frames,
+        "source": source_frame,
+        "anchors": anchors,
+        "markers": markers,
+        "pattern": pattern,
+    }
