+    for frame in frames:
+        items = _interior_items(g, frame, bg, frame_color)
+        if len(items) > 1:
+            if source_frame is not None:
+                raise ValueError("multiple source frames detected")
+            source_frame = frame
+            source_items = items
+        elif len(items) == 1:
+            rr, cc, color = items[0]
+            if color in anchors:
+                raise ValueError("anchor colors must be unique")
