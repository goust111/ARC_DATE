+    min_area = max(frame_cells * 2 + other_cells + 40, 22 * 22)
+    base = int(np.ceil(np.sqrt(min_area)))
+    grid_h = base + rng.randint(0, 5)
+    grid_w = base + rng.randint(0, 5)
+    if rng.random() < 0.5:
