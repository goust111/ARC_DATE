+        if score > best_score:
+            best_score = score
+            best_color = color
+            best_frames = frames
+    if best_color is None:
+        raise ValueError("failed to identify rectangular frame color")
+    best_frames.sort(key=lambda item: item["bbox"])
+    return int(best_color), best_frames
+
