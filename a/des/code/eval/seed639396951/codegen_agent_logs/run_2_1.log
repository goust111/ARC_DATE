+        pattern = np.full(mask.shape, -1, dtype=int)
+        coords = [tuple(map(int, pt)) for pt in np.argwhere(mask)]
+        if len(colors) == 1 or rng.random() < 0.45:
+            pattern[mask] = colors[0]
+            return pattern
