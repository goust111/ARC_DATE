+        for _ in range(300):
+            r0 = rng.randint(1, h - rh - 1)
+            c0 = rng.randint(1, w - rw - 1)
+            if not _fits_with_padding(occupied, r0, c0, rh, rw, pad):
+                continue
+            _mark_occupied(occupied, r0, c0, rh, rw, pad)
