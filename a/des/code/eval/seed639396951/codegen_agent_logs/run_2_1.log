+    out = g.copy()
+    pattern = scene["pattern"]
+    for color, side in scene["markers"].items():
+        target = scene["anchors"].get(color)
+        if target is None:
+            continue
+        _stamp_into_frame(out, pattern, target["frame"]["bbox"], target["anchor"], side)
