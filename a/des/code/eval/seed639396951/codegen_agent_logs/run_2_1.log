+    perim = np.zeros((h, w), dtype=bool)
+    perim[0, :] = True
+    perim[-1, :] = True
+    perim[:, 0] = True
+    perim[:, -1] = True
+    return bool(np.all(sub[perim] == color) and np.all(sub[~perim] != color))
