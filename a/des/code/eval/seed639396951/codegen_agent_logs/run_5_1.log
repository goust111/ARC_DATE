GRID_SIZE_MIN = 20
GRID_SIZE_MAX = 27

# Panel layout bounds and options.
MIN_PANEL_DIM = 9
MIN_VISIBLE_BORDERS = 2
BORDER_CHOICES = (0, 1)
OFFSET_MIN = 2
