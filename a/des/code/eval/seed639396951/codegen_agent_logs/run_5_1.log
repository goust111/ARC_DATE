+        fragments = [(r, c, int(target[r % th, c % tw])) for r, c in picks]
+        matches = []
+        for idx, template in enumerate(templates):
+            hh, ww = template.shape
+            if all(int(template[r % hh, c % ww]) == color for r, c, color in fragments):
+                matches.append(idx)
+        if matches == [template_idx]:
