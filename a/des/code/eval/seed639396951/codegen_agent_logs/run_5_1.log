+        top = int(region["top"])
+        left = int(region["left"])
+        mask = region["mask"]
+        template = templates[int(region["template_idx"])]
+        th, tw = template.shape
+        for r, c in np.argwhere(mask):
+            rr = top + int(r)
+            cc = left + int(c)
+            out[rr, cc] = int(template[int(r) % th, int(c) % tw])
+    return out
+
