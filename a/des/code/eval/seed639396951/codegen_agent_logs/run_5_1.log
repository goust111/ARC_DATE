+    elif family == "horizontal":
+        for r in range(h):
+            for c in range(w):
+                arr[r, c] = colors[r % len(colors)]
+    elif family == "checker":
+        for r in range(h):
+            for c in range(w):
+                arr[r, c] = colors[(r + c) % len(colors)]
+    elif family == "diag":
+        for r in range(h):
+            for c in range(w):
+                arr[r, c] = colors[(r + 2 * c) % len(colors)]
+    elif family == "rings":
+        for r in range(h):
+            for c in range(w):
+                dist = min(r, h - 1 - r, c, w - 1 - c)
+                arr[r, c] = colors[dist % len(colors)]
+    elif family == "quadrants":
+        mid_r = h // 2
+        mid_c = w // 2
+        for r in range(h):
+            for c in range(w):
