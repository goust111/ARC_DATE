+                left = c - off
+                if 1 <= left <= w - 4:
+                    if (
+                        g[r, left - 1] == grey
+                        and g[r, left + 3] == grey
+                        and bool(open_mask[r, left : left + 3].all())
+                    ):
+                        lane_masks[off][r, c] = True
+
+    return lane_masks
