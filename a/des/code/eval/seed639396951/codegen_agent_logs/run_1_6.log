 175: def _gen_covering_cells(rows, cols, count):
 176:     rows = list(rows)
 177:     cols = list(cols)
 178:     cells = set()
 179: 
 180:     shuffled_rows = rows[:]
 181:     random.shuffle(shuffled_rows)
 182:     for r in shuffled_rows:
 183:         cells.add((r, random.choice(cols)))
 184: 
 185:     for c in cols:
 186:         if all(cc != c for _rr, cc in cells):
 187:             cells.add((random.choice(rows), c))
 188: 
 189:     remaining = [(r, c) for r in rows for c in cols if (r, c) not in cells]
 190:     random.shuffle(remaining)
 191:     cells.update(remaining[: count - len(cells)])
 192:     return cells
