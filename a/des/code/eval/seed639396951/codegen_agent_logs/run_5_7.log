            for r, c in used:
                block_used[r - pair_row, c - c0] = True
            if np.any((block "'!= BG) & ~block_used):
                continue
            mapping = {}
            for _anchor, a, b, c in groups:
                key = frozenset((a, b))
                if a == b or key in mapping:
