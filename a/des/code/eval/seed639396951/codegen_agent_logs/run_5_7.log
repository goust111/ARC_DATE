        source_palette = random.sample(COLOR_POOL, n_sources)
        remaining = [c for c in COLOR_POOL if c not in source_palette]
        pair_keys = list(combinations(source_palette, 2))
        result_palette = random.sample(remaining, len(pair_keys))
        legend_entries = list(zip(pair_keys, result_palette))
        random.shuffle(legend_entries)

        g[0, cA] = source_palette[0]
        g[rB, 0] = source_palette[1]
