+    exit_ = (r + outgoing[0], c + outgoing[1])
+    assert 0 <= entry[0] < h and 0 <= entry[1] < w and int(grid[entry]) == BG
+    assert 0 <= exit_[0] < h and 0 <= exit_[1] < w and int(grid[exit_]) == BG
