        return [(r1,c) for c in range(c1,c2+step,step)]
    if c1==c2:
        step=1 if r2>=r1 else -1
        return [(r,c1) for r in range(r1,r2+step,step)]
    raise ValueError

def build(H,W,n):
  while True:
    cols=sorted(random.sample(range(2,W-2), 4 if n==3 else 3))
    rows=sorted(random.sample(range(2,H-2), 3))
    if any(b-a<2 for a,b in zip(cols,cols[1:])) or any(b-a<2 for a,b in zip(rows,rows[1:])):
      continue
    cA,c3,cI=cols[:3]
    cC=cols[3] if n==3 else None
    r1,rI,rB=rows
    from collections import Counter
    travel=[]
    travel += line((0,cA),(r1,cA))[1:]
    travel += line((r1,cA),(r1,cI))[1:]
    travel += line((r1,cI),(H-1,cI))[1:]
    travel += line((rB,0),(rB,c3))[1:]
    travel += line((rB,c3),(rI,c3))[1:]
    travel += line((rI,c3),(rI,W-1))[1:]
    if n==3:
      travel += line((H-1,cC),(0,cC))[1:]
    mirror_cells={(r1,cA),(r1,cI),(rB,c3),(rI,c3)}
    cnt=Counter(travel)
    allowed={(rI,cI)} | ({(rI,cC)} if n==3 else set())
    if any((cell in mirror_cells and k"'!=1) or (cell not in mirror_cells and k>1 and cell not in allowed) for cell,k in cnt.items()):
      continue
    g=np.zeros((H,W),dtype=int)
    g[0,cA]=1; g[rB,0]=2
    if n==3: g[H-1,cC]=3
    mirrors=[((r1,cA),(1,0),(0,1)),((r1,cI),(0,1),(1,0)),((rB,c3),(0,1),(-1,0)),((rI,c3),(-1,0),(0,1))]
    travel_set=set(travel)|mirror_cells|set(map(tuple,np.argwhere(g!=0)))
    ok=True
    for (r,c),incoming,outgoing in mirrors:
      entry=(r-incoming[0],c-incoming[1]); exit=(r+outgoing[0],c+outgoing[1])
      g[r,c]=MIRROR
      for dr,dc in CARD:
        p=(r+dr,c+dc)
        if p in {entry,exit}: continue
        if p in travel_set or not (0<=p[0]<H and 0<=p[1]<W): ok=False
        g[p]=SUPPORT
    if not ok: continue
    if random.choice([False,True]): g=np.flipud(g)
    if random.choice([False,True]): g=np.fliplr(g)
    return g

def legend_corners(g,m):
