+
+    travel_cells += _line_cells((r_b_turn, 0), (r_b_turn, c_b_turn))[1:]
+    travel_cells += _line_cells((r_b_turn, c_b_turn), (r_mix, c_b_turn))[1:]
+    travel_cells += _line_cells((r_mix, c_b_turn), (r_mix, w - 1))[1:]
