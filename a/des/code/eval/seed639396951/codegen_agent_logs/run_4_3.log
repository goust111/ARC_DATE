+    ar0, ac0, ar1, ac1 = arrow_box
+
+    if direction == "right":
+        if ac0 <= fc1 or not (fr0 <= line_index <= fr1):
+            return None
+        gap = ac0 - fc1 - 1
+    elif direction == "left":
+        if ac1 >= fc0 or not (fr0 <= line_index <= fr1):
+            return None
+        gap = fc0 - ac1 - 1
+    elif direction == "down":
