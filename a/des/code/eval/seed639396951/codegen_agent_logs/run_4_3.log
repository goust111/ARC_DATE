+def _sample_directions(count: int) -> list[str]:
+    dirs = list(DIRS.keys())
+    random.shuffle(dirs)
+    chosen = dirs[: min(count, len(dirs))]
+    while len(chosen) < count:
+        chosen.append(random.choice(dirs))
+    random.shuffle(chosen)
+    return chosen
