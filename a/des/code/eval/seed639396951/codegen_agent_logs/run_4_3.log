+        r0 = max(0, top - 1)
+        r1 = min(height, top + ph + 1)
+        c0 = max(0, left - 1)
+        c1 = min(width, left + pw + 1)
+        forbidden[r0:r1, c0:c1] = True
+
+        fr0, fc0, fr1, fc1 = obj["frame_bbox"]
+        placed[idx] = {
+            "color": int(obj["color"]),
+            "dir": str(obj["dir"]),
+            "steps": int(obj["steps"]),
+            "frame_bbox": (top + fr0, left + fc0, top + fr1, left + fc1),
+            "seed_coords": [(top + r, left + c) for r, c in obj["seed_coords"]],
+        }
