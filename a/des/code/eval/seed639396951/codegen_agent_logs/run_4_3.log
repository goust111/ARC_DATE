+
+def _is_rect_frame(grid: np.ndarray, comp: dict) -> bool:
+    color = int(comp["color"])
+    r0, c0, r1, c1 = map(int, comp["bbox"])
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
