+            base_c = c0 + 1
+            expected = {(tip_r, c) for c in range(c0, row_cols[-1] + 1)}
+            expected |= {(tip_r - 1, base_c), (tip_r + 1, base_c)}
+            if pts == expected and (tip_r - 1, base_c) in pts and (tip_r + 1, base_c) in pts:
