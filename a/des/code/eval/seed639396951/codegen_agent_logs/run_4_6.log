+            used_rows.add(row)
+            col = c0 if side == "left" else c1
+        markers.append((row, col))
+    return markers
+
+
+def _draw_rectangle(
+    grid: np.ndarray,
+    r0: int,
+    c0: int,
+    r1: int,
+    c1: int,
+    marker_color: int,
+    markers: list[tuple[int, int]],
+) -> None:
+    grid[r0 : r1 + 1, c0] = GREY
+    grid[r0 : r1 + 1, c1] = GREY
+    grid[r0, c0 : c1 + 1] = GREY
+    grid[r1, c0 : c1 + 1] = GREY
+    for r, c in markers:
+        grid[r, c] = marker_color
+
+
+def _render_expected(
+    grid: np.ndarray,
+    rects: list[dict[str, object]],
+    mapping: dict[int, int],
+) -> np.ndarray:
+    out = grid.copy()
+    for rect in rects:
+        r0, c0, r1, c1 = rect["frame"]
+        marker_color = int(rect["marker_color"])
+        fill_color = mapping[marker_color]
+        out[r0 + 1 : r1, c0 + 1 : c1] = fill_color
+        for mr, mc in rect["markers"]:
+            if mr == r0 or mr == r1:
+                out[r0 + 1 : r1, mc] = GREY
+            else:
+                out[mr, c0 + 1 : c1] = GREY
+        for mr, mc in rect["markers"]:
+            out[mr, mc] = marker_color
+    return out
+
