+def _centered_offset(outer: int, inner: int, rng: random.Random) -> int:
+    slack = outer - inner
+    mid = slack // 2
+    if slack <= 1:
+        return mid
+    jitter = rng.choice([-1, 0, 1])
+    return max(0, min(slack, mid + jitter))
