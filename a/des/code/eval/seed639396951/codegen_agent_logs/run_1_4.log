+    br0, bc0, br1, bc1 = big_box
+    if sr1 < br0:
+        return "up"
+    if sr0 > br1:
+        return "down"
+    if sc1 < bc0:
+        return "left"
+    if sc0 > bc1:
+        return "right"
+
+    (sr, sc) = _center_of_bbox(small_box)
+    (br, bc) = _center_of_bbox(big_box)
+    if abs(sr - br) >= abs(sc - bc):
+        return "up" if sr < br else "down"
+    return "left" if sc < bc else "right"
