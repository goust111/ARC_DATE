+        assert len(comps) == 2, "each non-background color must appear in exactly two components"
+        comps.sort(key=lambda pts: int(pts.shape[0]))
+        small, big = comps
+        assert small.shape[0] < big.shape[0], "same-color pair must have different sizes"
