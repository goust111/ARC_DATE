+
+def _paint_stripes(grid: np.ndarray, rect: dict[str, int | None], color: int) -> None:
+    r0, c0, r1, c1 = int(rect["r0"]), int(rect["c0"]), int(rect["r1"]), int(rect["c1"])
+    if r1 - r0 < 2 or c1 - c0 < 2:
