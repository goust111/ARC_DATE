+    if layout == "scatter":
+        count = random.randint(1, 4)
+        low, high = {1: (10, 20), 2: (12, 24), 3: (16, 28), 4: (20, 30)}[count]
+    elif layout == "adjacent":
+        count = random.randint(2, 4)
+        low, high = {2: (12, 24), 3: (16, 28), 4: (20, 30)}[count]
+    else:
