+            offset = _ceil_fraction(need) + random.randint(0, 2)
+            input_target = (anchor_centroid[0] + offset, anchor_centroid[1])
+        else:
+            max_rel = max(rel_rows)
+            need = anchor_centroid[0] + max_rel + sep_pattern
+            offset = _ceil_fraction(need) + random.randint(0, 2)
