+        "direction": direction,
+        "anchor_size": anchor_size,
+        "input_cells": (
+            [(r, c, color) for r, c in arrow_coords]
+            + [(r, c, GREY) for r, c in anchor_coords]
+            + [(r, c, color) for r, c in placed_pattern]
