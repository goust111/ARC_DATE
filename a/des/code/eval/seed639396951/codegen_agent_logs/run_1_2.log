+        tip,
+        (tr - dr, tc - dc),
+        (tr - 2 * dr, tc - 2 * dc),
+        (tr - 2 * dr + pr, tc - 2 * dc + pc),
+        (tr - 2 * dr - pr, tc - 2 * dc - pc),
+    }
