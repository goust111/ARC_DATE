+    dr, dc = DIRS[direction]
+    pr, pc = PERP[direction]
+    if arrow_size == 3:
+        return {
+            tip,
+            (tr - dr + pr, tc - dc + pc),
+            (tr - dr - pr, tc - dc - pc),
+        }
+    if arrow_size == 4:
+        return {
