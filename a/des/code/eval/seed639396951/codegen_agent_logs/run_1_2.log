+# --------------- generator ---------------
+
+GRID_H_RANGE = (18, 31)
+GRID_W_RANGE = (18, 31)
+GROUP_COUNT_RANGE = (2, 4)
+COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+PAD = 1
+PLACEMENT_ATTEMPTS = 150
+GEN_ATTEMPTS = 400
+
+INT_PATTERNS = [
