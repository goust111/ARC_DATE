+        marker_colors = values - {int(bg)}
+        assert len(marker_colors) == 1, "each target region must have one marker color"
+        marker = int(next(iter(marker_colors)))
+        marker_cells = [(r, c) for r, c in coords if int(frame[r, c]) == marker]
