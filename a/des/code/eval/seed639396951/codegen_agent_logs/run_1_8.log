+
+BG = 0
+GREY = 5
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MARKER_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+PATTERN_MODES = ("diag", "anti", "rows", "cols")
+LAYOUTS = ("v3", "h3", "grid4")
