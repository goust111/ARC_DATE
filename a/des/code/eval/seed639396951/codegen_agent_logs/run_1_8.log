+def _find_separator(grid: np.ndarray, bg: int) -> tuple[int, int]:
+    h = int(grid.shape[0])
+    candidates: list[tuple[int, int]] = []
+    for r in range(h):
+        row = grid[r]
+        if int(row[0]) == bg:
+            continue
