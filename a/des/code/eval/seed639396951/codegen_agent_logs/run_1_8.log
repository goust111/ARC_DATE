+            c += direction
+        if end is not None and r == end:
+            cells.add((int(r), int(c - direction)))
+            c -= direction
+    return cells
+
+
+def _make_horizontal_wall(w: int, base_r: int, rng: random.Random, can_up: bool, can_down: bool) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
