+
+def _layout_frame(rng: random.Random) -> tuple[np.ndarray, list[list[tuple[int, int]]]]:
+    layout = str(rng.choice(LAYOUTS))
+
+    for _ in range(120):
+        if layout == "v3":
+            inner_h = int(rng.randint(7, 11))
+            inner_w = int(rng.randint(13, 17))
+            c1 = int(rng.randint(4, inner_w - 8))
