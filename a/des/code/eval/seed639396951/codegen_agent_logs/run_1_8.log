+    body_values = {int(out[r, c]) for r, c in coords if (r, c) != marker}
+    if len(body_values) < 2:
+        ordered = sorted((r, c) for r, c in coords if (r, c) != marker)
+        for i, (r, c) in enumerate(ordered):
+            out[r, c] = int(body_colors[i % palette_size])
