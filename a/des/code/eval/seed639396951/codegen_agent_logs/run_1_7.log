+    if num_groups == 1:
+        return (2, 3, 4, 5), 27
+    if num_groups == 2:
+        return (2, 3, 4, 5), 19
+    if num_groups == 3:
+        return (2, 3, 4), 17
+    return (2, 3, 4), 15
+
+
