import hashlib
import random
import numpy as np

BLACK = 0
PALETTE = tuple(range(1, 10))
GROUP_GAP = 2
OUTER_MARGIN = 1
GRID_MAX = 42
EXTRA_SLACK_MAX = 6
MAX_GENERATION_ATTEMPTS = 300
ROW_PATTERNS = {
    1: [(1,)],
    2: [(2,), (1, 1)],
    3: [(3,), (2, 1), (1, 2)],
    4: [(4,), (2, 2), (3, 1), (1, 3)],
}


def neighbors4(r, c, h, w):
    if r > 0:
        yield r - 1, c
    if r + 1 < h:
        yield r + 1, c
    if c > 0:
        yield r, c - 1
    if c + 1 < w:
        yield r, c + 1


def components(mask):
    h, w = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    comps = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            stack = [(r, c)]
            seen[r, c] = True
            coords = []
            while stack:
                rr, cc = stack.pop()
                coords.append((rr, cc))
                for nr, nc in neighbors4(rr, cc, h, w):
                    if mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            comps.append(np.array(coords, dtype=int))
    return comps


def bbox(coords):
    return int(coords[:, 0].min()), int(coords[:, 1].min()), int(coords[:, 0].max()), int(coords[:, 1].max())


def is_ring(coords):
    r0, c0, r1, c1 = bbox(coords)
    h, w = r1 - r0 + 1, c1 - c0 + 1
    if h < 3 or w < 3 or len(coords) "'!= 2 * (h + w) - 4:
        return False
    local = np.zeros((h, w), dtype=bool)
    local[coords[:, 0] - r0, coords[:, 1] - c0] = True
    expected = np.zeros((h, w), dtype=bool)
    expected[0, :] = True
    expected[-1, :] = True
    expected[:, 0] = True
    expected[:, -1] = True
    return np.array_equal(local, expected)


def contains(outer, inner):
    or0, oc0, or1, oc1 = outer
    ir0, ic0, ir1, ic1 = inner
    return or0 < ir0 and oc0 < ic0 and or1 > ir1 and oc1 > ic1


def main(grid):
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    rings = []
    for comp in components(g != BLACK):
        assert is_ring(comp)
        rings.append((comp, bbox(comp)))
    bboxes = [box for _, box in rings]
    out = g.copy()
    for comp, box in rings:
        depth = 1 + sum(contains(other, box) for other in bboxes)
        if depth % 2 == 0:
            out[comp[:, 0], comp[:, 1]] = BLACK
    return out


def draw_ring(arr, box, color):
    r0, c0, r1, c1 = box
    arr[r0, c0:c1 + 1] = color
    arr[r1, c0:c1 + 1] = color
    arr[r0:r1 + 1, c0] = color
    arr[r0:r1 + 1, c1] = color


def profile(num_groups):
    if num_groups == 1:
        return (2, 3, 4, 5), 27
    if num_groups == 2:
        return (2, 3, 4, 5), 19
    if num_groups == 3:
        return (2, 3, 4), 17
    return (2, 3, 4), 15


def build_group(num_groups):
    layer_options, outer_max = profile(num_groups)
    layers = random.choice(layer_options)
    inner_max = outer_max - 4 * (layers - 1)
    if inner_max < 3:
        return None
    ih = random.randint(3, inner_max)
    iw = random.randint(3, inner_max)
    oh = ih + 4 * (layers - 1)
    ow = iw + 4 * (layers - 1)
    colors = random.sample(PALETTE, layers)
    inp = np.zeros((oh, ow), dtype=int)
    out = np.zeros_like(inp)
    for i, color in enumerate(colors):
        box = (2 * i, 2 * i, oh - 1 - 2 * i, ow - 1 - 2 * i)
        draw_ring(inp, box, color)
        if i % 2 == 0:
            draw_ring(out, box, color)
    return inp, out


def compositions(total, parts):
    if parts == 1:
        return [total]
    cuts = sorted(random.sample(range(total + parts - 1), parts - 1))
    values = []
    prev = -1
    for cut in cuts + [total + parts - 1]:
        values.append(cut - prev - 1)
        prev = cut
    return values


def pack_groups(groups):
    patterns = list(ROW_PATTERNS[len(groups)])
    random.shuffle(patterns)
    for pattern in patterns:
        indices = list(range(len(groups)))
        random.shuffle(indices)
        rows = []
        cursor = 0
        for row_size in pattern:
            rows.append(indices[cursor:cursor + row_size])
            cursor += row_size
        row_widths = []
        row_heights = []
        for row in rows:
            widths = [groups[idx][0].shape[1] for idx in row]
            heights = [groups[idx][0].shape[0] for idx in row]
            row_widths.append(sum(widths) + GROUP_GAP * max(0, len(row) - 1))
            row_heights.append(max(heights))
        content_w = max(row_widths)
        content_h = sum(row_heights) + GROUP_GAP * max(0, len(rows) - 1)
        min_h = content_h + 2 * OUTER_MARGIN
        min_w = content_w + 2 * OUTER_MARGIN
        if min_h > GRID_MAX or min_w > GRID_MAX:
            continue
        H = min_h + random.randint(0, min(EXTRA_SLACK_MAX, GRID_MAX - min_h))
        W = min_w + random.randint(0, min(EXTRA_SLACK_MAX, GRID_MAX - min_w))
        extra_v = H - min_h
        v_slack = compositions(extra_v, len(rows) + 1)
        positions = [None] * len(groups)
        row_top = OUTER_MARGIN + v_slack[0]
        for row_idx, row in enumerate(rows):
            row_h = row_heights[row_idx]
            row_w = row_widths[row_idx]
            start_c = OUTER_MARGIN + random.randint(0, W - 2 * OUTER_MARGIN - row_w)
            c = start_c
            for idx in row:
                patch_h, patch_w = groups[idx][0].shape
                positions[idx] = (row_top + random.randint(0, row_h - patch_h), c)
                c += patch_w + GROUP_GAP
            row_top += row_h
            if row_idx < len(rows) - 1:
                row_top += GROUP_GAP + v_slack[row_idx + 1]
        return H, W, positions
    return None


def gen_attempt():
    num_groups = random.choice((1, 2, 3, 4))
    groups = []
    for _ in range(num_groups):
        group = build_group(num_groups)
        if group is None:
            return None
        groups.append(group)
    packed = pack_groups(groups)
    if packed is None:
        return None
    h, w, positions = packed
    inp = np.zeros((h, w), dtype=int)
    out = np.zeros((h, w), dtype=int)
    for (group_in, group_out), (r, c) in zip(groups, positions):
        gh, gw = group_in.shape
        inp[r:r + gh, c:c + gw] = group_in
        out[r:r + gh, c:c + gw] = group_out
    try:
        if np.array_equal(main(inp), out):
            return inp
    except AssertionError:
        return None
    return None

sigs = set()
for i in range(200):
    for _ in range(MAX_GENERATION_ATTEMPTS):
        arr = gen_attempt()
        if arr is not None:
            break
    else:
        raise RuntimeError('"'generation failed')
    sigs.add(hashlib.md5(arr.tobytes() + str(arr.shape).encode()).hexdigest())
print('variants', len(sigs))
