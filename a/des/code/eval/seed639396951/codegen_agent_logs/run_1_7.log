+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+PALETTE = tuple(range(1, 10))
+
+# Generator layout controls.
+GROUP_GAP = 2
+OUTER_MARGIN = 1
+GRID_MAX = 42
+EXTRA_SLACK_MAX = 6
+MAX_GENERATION_ATTEMPTS = 300
+ROW_PATTERNS = {
+    1: [(1,)],
+    2: [(2,), (1, 1)],
+    3: [(3,), (2, 1), (1, 2)],
+    4: [(4,), (2, 2), (3, 1), (1, 3)],
+}
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _is_rectangular_ring(coords: np.ndarray) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    if len(coords) != 2 * (h + w) - 4:
+        return False
+
+    local = np.zeros((h, w), dtype=bool)
+    local[coords[:, 0] - r0, coords[:, 1] - c0] = True
+
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return np.array_equal(local, border)
+
+
+def _contains(outer: tuple[int, int, int, int], inner: tuple[int, int, int, int]) -> bool:
+    or0, oc0, or1, oc1 = outer
+    ir0, ic0, ir1, ic1 = inner
+    return or0 < ir0 and oc0 < ic0 and or1 > ir1 and oc1 > ic1
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Keep only odd-numbered layers in each nested rectangular ring group.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    rings: list[tuple[np.ndarray, tuple[int, int, int, int]]] = []
+    for comp in _components(g != BLACK):
+        assert _is_rectangular_ring(comp)
+        rings.append((comp, _bbox(comp)))
+
+    bboxes = [box for _, box in rings]
+    out = g.copy()
+    for comp, box in rings:
+        # A ring's layer index is exactly one plus the number of containing rings.
+        depth = 1 + sum(_contains(other, box) for other in bboxes)
+        if depth % 2 == 0:
+            out[comp[:, 0], comp[:, 1]] = BLACK
+    return out
+
