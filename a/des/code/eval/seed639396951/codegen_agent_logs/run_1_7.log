+    r0, c0, r1, c1 = box
+    arr[r0, c0 : c1 + 1] = color
+    arr[r1, c0 : c1 + 1] = color
+    arr[r0 : r1 + 1, c0] = color
+    arr[r0 : r1 + 1, c1] = color
+
+
