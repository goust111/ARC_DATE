import random, numpy as np

BLACK = 0
PALETTE = tuple(range(1,10))
GROUP_GAP = 2
OUTER_MARGIN = 1
GRID_MAX = 40
EXTRA_SLACK_MAX = 6


def neighbors4(r,c,H,W):
    if r>0: yield r-1,c
    if r+1<H: yield r+1,c
    if c>0: yield r,c-1
    if c+1<W: yield r,c+1

def components(mask):
    H,W = mask.shape
    seen = np.zeros_like(mask, bool)
    comps=[]
    for r in range(H):
        for c in range(W):
            if mask[r,c] and not seen[r,c]:
                stack=[(r,c)]
                seen[r,c]=True
                coords=[]
                while stack:
                    rr,cc=stack.pop()
                    coords.append((rr,cc))
                    for nr,nc in neighbors4(rr,cc,H,W):
                        if mask[nr,nc] and not seen[nr,nc]:
                            seen[nr,nc]=True
                            stack.append((nr,nc))
                comps.append(np.array(coords, int))
    return comps

def bbox(coords):
    return int(coords[:,0].min()), int(coords[:,1].min()), int(coords[:,0].max()), int(coords[:,1].max())

def is_ring(coords):
    r0,c0,r1,c1 = bbox(coords)
    h,w = r1-r0+1, c1-c0+1
    if h < 3 or w < 3 or len(coords) "'!= 2*(h+w)-4:
        return False
    m = np.zeros((h,w), bool)
    m[coords[:,0]-r0, coords[:,1]-c0] = True
    expected = np.zeros((h,w), bool)
    expected[0,:]=expected[-1,:]=expected[:,0]=expected[:,-1]=True
    return np.array_equal(m, expected)

def contains(o,i):
    or0,oc0,or1,oc1=o
    ir0,ic0,ir1,ic1=i
    return or0 < ir0 and oc0 < ic0 and or1 > ir1 and oc1 > ic1

def main(grid):
    g=np.asarray(grid,int)
    out=g.copy()
    rings=[]
    for comp in components(g!=0):
        if not is_ring(comp):
            print('"'not ring', bbox(comp), len(comp))
            return None
        rings.append((comp, bbox(comp)))
    bboxes=[b for _,b in rings]
    print('bboxes', bboxes)
    for comp,b in rings:
        depth=1+sum(contains(other,b) for other in bboxes)
        print('depth', b, depth)
        if depth%2==0:
            out[comp[:,0], comp[:,1]] = 0
    return out

def draw_ring(arr, box, color):
    r0,c0,r1,c1 = box
    arr[r0,c0:c1+1]=color; arr[r1,c0:c1+1]=color; arr[r0:r1+1,c0]=color; arr[r0:r1+1,c1]=color

def build_group(num_groups):
    if num_groups == 2:
        layer_options=(2,3,4,5); outer_max=21
    else:
        raise
    layers=random.choice(layer_options)
    inner_max=outer_max-4*(layers-1)
    ih=random.randint(3,inner_max); iw=random.randint(3,inner_max)
    oh=ih+4*(layers-1); ow=iw+4*(layers-1)
    colors=random.sample(PALETTE, layers)
    inp=np.zeros((oh,ow), int); out=np.zeros_like(inp)
    for i,color in enumerate(colors):
        box=(2*i,2*i,oh-1-2*i,ow-1-2*i)
        draw_ring(inp,box,color)
        if i%2==0: draw_ring(out,box,color)
    return inp,out

def comps(total, parts):
    if parts == 1: return [total]
    cuts=sorted(random.sample(range(total+parts-1), parts-1))
    vals=[]; prev=-1
    for cut in cuts+[total+parts-1]:
        vals.append(cut-prev-1); prev=cut
    return vals

def pack(groups):
