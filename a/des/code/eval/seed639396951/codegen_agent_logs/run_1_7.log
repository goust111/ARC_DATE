/bin/bash -lc "python - <<'PY'
import random, numpy as np
from collections import Counter

BLACK = 0
PALETTE = tuple(range(1,10))
GROUP_GAP = 2
OUTER_MARGIN = 1
GRID_MAX = 40
EXTRA_SLACK_MAX = 6
PACK_ATTEMPTS = 20


def build_group(num_groups):
    if num_groups == 1:
        layer_options = (2,3,4,5); outer_max = 27
    elif num_groups == 2:
        layer_options = (2,3,4,5); outer_max = 21
    elif num_groups == 3:
        layer_options = (2,3,4); outer_max = 17
    else:
        layer_options = (2,3,4); outer_max = 15
    layers = random.choice(layer_options)
    inner_max = outer_max - 4*(layers - 1)
    if inner_max < 3:
        return None
    ih = random.randint(3, inner_max)
    iw = random.randint(3, inner_max)
    oh = ih + 4 * (layers - 1)
    ow = iw + 4 * (layers - 1)
    colors = random.sample(PALETTE, layers)
    inp = np.zeros((oh, ow), dtype=int)
    out = np.zeros_like(inp)
    for i, color in enumerate(colors):
        r0 = c0 = 2 * i
        r1 = oh - 1 - 2 * i
        c1 = ow - 1 - 2 * i
        inp[r0, c0:c1 + 1] = color
        inp[r1, c0:c1 + 1] = color
        inp[r0:r1 + 1, c0] = color
        inp[r0:r1 + 1, c1] = color
        if i % 2 == 0:
            out[r0, c0:c1 + 1] = color
            out[r1, c0:c1 + 1] = color
            out[r0:r1 + 1, c0] = color
            out[r0:r1 + 1, c1] = color
    return inp, out


def compositions(total, parts):
    if parts == 1:
        return [total]
    cuts = sorted(random.sample(range(total + parts - 1), parts - 1))
    vals = []
    prev = -1
    for cut in cuts + [total + parts - 1]:
        vals.append(cut - prev - 1)
        prev = cut
    return vals


def row_patterns(n):
    if n == 1:
        return [(1,)]
    if n == 2:
        return [(2,), (1,1)]
    if n == 3:
        return [(3,), (2,1), (1,2)]
    return [(4,), (2,2), (3,1), (1,3)]


def pack(groups):
    patterns = row_patterns(len(groups))
    for _ in range(PACK_ATTEMPTS):
        pattern = random.choice(patterns)
        indices = list(range(len(groups)))
        random.shuffle(indices)
        rows = []
        cursor = 0
        for size in pattern:
            rows.append(indices[cursor:cursor + size])
            cursor += size
        row_heights = []
        row_widths = []
        row_gaps = []
        for row in rows:
            gaps = [GROUP_GAP + random.randint(0, 2) for _ in range(max(0, len(row) - 1))]
            widths = [groups[idx][0].shape[1] for idx in row]
            heights = [groups[idx][0].shape[0] for idx in row]
            row_gaps.append(gaps)
            row_widths.append(sum(widths) + sum(gaps))
            row_heights.append(max(heights))
        v_gaps = [GROUP_GAP + random.randint(0, 2) for _ in range(max(0, len(rows) - 1))]
        content_h = sum(row_heights) + sum(v_gaps)
        content_w = max(row_widths)
        H = content_h + 2 * OUTER_MARGIN + random.randint(0, EXTRA_SLACK_MAX)
        W = content_w + 2 * OUTER_MARGIN + random.randint(0, EXTRA_SLACK_MAX)
        if H > GRID_MAX or W > GRID_MAX:
            continue
        extra_v = H - 2 * OUTER_MARGIN - content_h
        v_slack = compositions(extra_v, len(rows) + 1)
        positions = [None] * len(groups)
        r = OUTER_MARGIN + v_slack[0]
        for row_idx, row in enumerate(rows):
            row_h = row_heights[row_idx]
            row_w = row_widths[row_idx]
            extra_h = W - 2 * OUTER_MARGIN - row_w
            start_c = OUTER_MARGIN + random.randint(0, extra_h)
            c = start_c
            for j, idx in enumerate(row):
                ph, pw = groups[idx][0].shape
                positions[idx] = (r + random.randint(0, row_h - ph), c)
                c += pw
                if j < len(row) - 1:
                    c += row_gaps[row_idx][j]
            r += row_h
            if row_idx < len(rows) - 1:
                r += v_gaps[row_idx] + v_slack[row_idx + 1]
        return H, W, positions
    return None

cnt = Counter(); ok = Counter(); packed = Counter()
for _ in range(1000):
    n = random.choice((1,2,3,4))
    cnt[n] += 1
    groups = []
    failed = False
    for _ in range(n):
        g = build_group(n)
        if g is None:
            failed = True
            break
        groups.append(g)
    if failed:
        continue
    pack_result = pack(groups)
    if pack_result is not None:
        packed[n] += 1
print('total', cnt)
print('packed', packed)
print({n: packed[n]/cnt[n] for n in cnt})
