+def _is_valid_instance(grid: np.ndarray, rects: Dict[int, Rect], order: List[int]) -> bool:
+    scene_rows = np.flatnonzero(np.any(grid[:-1] != BG, axis=1))
+    if scene_rows.size == 0:
+        return False
+    scene = grid[: int(scene_rows[-1]) + 1]
