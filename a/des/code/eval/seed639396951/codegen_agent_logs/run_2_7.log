+    scene_w = rng.randint(min_w, SCENE_W_RANGE[1])
+    return scene_h, scene_w
+
+
+def _sample_top_rect(scene_h: int, scene_w: int, n_cards: int, rng: random.Random) -> Rect | None:
+    margin = max(1, n_cards - 1)
