+
+def _render_scene(scene_h: int, scene_w: int, rects: Dict[int, Rect], order: List[int]) -> np.ndarray:
+    scene = np.full((scene_h, scene_w), BG, dtype=int)
+    for color in order:
+        r0, c0, r1, c1 = rects[color]
+        scene[r0 : r1 + 1, c0 : c1 + 1] = color
+    return scene
