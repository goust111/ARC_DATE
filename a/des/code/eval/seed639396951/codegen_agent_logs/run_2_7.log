+    grid = np.full((scene_h + gap + 1, scene_w), BG, dtype=int)
+    grid[:scene_h] = scene
+
+    start = rng.randint(0, scene_w - n_cards)
+    grid[-1, start : start + n_cards] = np.array(order, dtype=int)
+
+    if _is_valid_instance(grid, rects, order):
+        return grid
+    return None
+
