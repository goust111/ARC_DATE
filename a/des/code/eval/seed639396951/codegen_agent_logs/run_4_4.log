+
+BG_COLOR = 0
+WALL_COLOR = 1
+PALETTE_POOL = tuple(range(2, 10))
+
+GRID_H_RANGE = (22, 30)
+GRID_W_RANGE = (22, 30)
+ROOM_COUNT_OPTIONS = (4, 5, 6)
+ROOM_H_RANGE = (5, 9)
