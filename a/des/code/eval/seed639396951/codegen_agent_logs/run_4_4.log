+            "door_count": spec["door_count"],
+            "stripe": spec["stripe"],
+        }
+        _paint_room(out, room, palette[spec["door_count"] - 1], BG_COLOR)
+    return out
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(*GRID_H_RANGE)
