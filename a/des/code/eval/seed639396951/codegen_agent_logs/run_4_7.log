5: def main(grid: np.ndarray) -> np.ndarray:
6:     """
7:     Assemble colored sprites into a central bar's notches, chaining successive pieces along fixed-width strips.
8: 
9:     Input structure:
10:     - bg = most common color. Largest monochrome component is a solid "bar" with boundary notches (bg holes opening to its bbox edge).
11:     - Several smaller colored sprites scattered around the bar.
12: 
13:     Rule:
14:     - Each bar notch is filled by a root piece whose shape exactly covers the hole.
15:     - The root defines a strip (column-span or row-span) for its chain.
16:     - Successive pieces fill the bg cells inside the previous piece's bbox, locked to the same strip width.
17:     - Multiple chains grow independently from different bar notches.
18: 
19:     Key insight: The root piece's extent perpendicular to the chain direction locks the strip width for all subsequent pieces in that chain.
20:     """
21:     g = np.array(grid, dtype=int)
22:     H, W = g.shape
23:     DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
24: 
25:     bg = get_bg(g)
26: 
27:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
28:     comps.sort(key=lambda d: -d["area"])
29:     assert comps
30: 
31:     bar = comps[0]
32:     pieces_raw = comps[1:]
33: 
34:     out = np.full((H, W), int(bg), dtype=int)
35:     bar_r0, bar_c0, bar_r1, bar_c1 = map(int, bar["bbox"])
36:     bar_h, bar_w = bar_r1 - bar_r0 + 1, bar_c1 - bar_c0 + 1
37:     bar_color = int(bar["color"])
38:     bar_occ = set((int(r), int(c)) for r, c in bar["coords"])
39:     bar_mask = np.zeros((bar_h, bar_w), dtype=bool)
40:     for r, c in bar_occ:
41:         bar_mask[r - bar_r0, c - bar_c0] = True
42:     for r, c in bar_occ:
43:         out[r, c] = bar_color
44: 
45:     def shape_from_coords(coords: np.ndarray, bbox):
46:         r0, c0, r1, c1 = map(int, bbox)
47:         h, w = r1 - r0 + 1, c1 - c0 + 1
48:         rel = [(int(r - r0), int(c - c0)) for r, c in coords]
49:         rel_set = set(rel)
50:         return {"rel": rel, "rel_set": rel_set, "h": h, "w": w}
51: 
52:     pieces = []
53:     for p in pieces_raw:
54:         # For this puzzle, pieces are used in their original orientation (no rotation / flip).
55:         r0, c0 = map(int, p["bbox"][:2])
56:         pieces.append({"color": int(p["color"]), "shape": shape_from_coords(p["coords"], p["bbox"]), "orig": (r0, c0)})
57: 
58:     def bar_notches(bar_mask, bar_r0, bar_c0):
59:         empty = ~bar_mask
60:         h, w = map(int, empty.shape)
61:         notches = []
62:         for pts in components_mask(empty, connectivity=4):
63:             r = pts[:, 0]
64:             c = pts[:, 1]
65:             top = int((r == 0).sum())
66:             bottom = int((r == h - 1).sum())
67:             left = int((c == 0).sum())
68:             right = int((c == w - 1).sum())
69: 
70:             # Keep only holes that open to the bar bbox boundary.
71:             if top + bottom + left + right == 0:
72:                 continue
73: 
74:             hole_gl = set((bar_r0 + int(rr), bar_c0 + int(cc)) for rr, cc in pts)
75: 
76:             # Axis is determined by which bbox side has the widest mouth.
77:             side, mouth_n = max(
78:                 [(name, cnt) for name, cnt in [("top", top), ("bottom", bottom), ("left", left), ("right", right)] if cnt > 0],
79:                 key=lambda x: x[1],
80:             )
81:             axis = "cols" if side in ("top", "bottom") else "rows"
82:             notches.append({"axis": axis, "hole": hole_gl, "mouth_n": mouth_n})
83:         return notches
84: 
85:     notches = bar_notches(bar_mask, bar_r0, bar_c0)
86: 
87:     def pixels(v, top, left):
88:         return set((top + lr, left + lc) for lr, lc in v["rel"])
89: 
90:     def placement_pts(v, top, left, occ, must_cover=None, strip=None):
91:         if top < 0 or left < 0 or top + v["h"] > H or left + v["w"] > W:
92:             return None
93:         if strip is not None:
94:             axis, A, B = strip
95:             if axis == "cols":
96:                 if left != A or v["w"] != B - A + 1:
97:                     return None
98:             else:
99:                 if top != A or v["h"] != B - A + 1:
100:                     return None
101:         pts = pixels(v, top, left)
102:         if pts & occ:
103:             return None
104:         if must_cover is not None and not (must_cover <= pts):
105:             return None
106:         return pts
107: 
108:     def aligned_positions(axis, A, cover, v):
109:         if axis == "cols":
110:             left = A
111:             tops = set()
112:             for rN, cN in cover:
113:                 for lr, lc in v["rel"]:
114:                     if cN == left + lc:
115:                         tops.add(rN - lr)
116:             for top in tops:
117:                 yield top, left
118:         else:
119:             top = A
120:             lefts = set()
121:             for rN, cN in cover:
122:                 for lr, lc in v["rel"]:
123:                     if rN == top + lr:
124:                         lefts.add(cN - lc)
125:             for left in lefts:
126:                 yield top, left
127: 
128:     def touches(pts, other):
129:         for r, c in pts:
130:             for dr, dc in DIR4:
131:                 if (r + dr, c + dc) in other:
132:                     return True
133:         return False
134: 
135:     def hole_positions(hole, v):
136:         pos = set()
137:         for rH, cH in hole:
138:             for lr, lc in v["rel"]:
139:                 pos.add((rH - lr, cH - lc))
140:         return pos
141: 
142:     # Root candidates: fill the bar hole (no strip constraint yet).
143:     root_cands = []
144:     for ni, n in enumerate(notches):
145:         axis = n["axis"]
146: 
147:         for pi, p in enumerate(pieces):
148:             v = p["shape"]
149:             for top, left in hole_positions(n["hole"], v):
150:                 pts = placement_pts(v, top, left, bar_occ, must_cover=n["hole"])
151:                 if pts is None:
152:                     continue
153:                 if axis == "cols":
154:                     A, B = int(left), int(left + v["w"] - 1)
155:                 else:
156:                     A, B = int(top), int(top + v["h"] - 1)
157:                 mv = abs(int(top) - int(p["orig"][0])) + abs(int(left) - int(p["orig"][1]))
158:                 root_cands.append(
159:                     (
160:                         (int(mv), -int(n["mouth_n"])),
161:                         {"ni": ni, "pi": pi, "top": int(top), "left": int(left), "axis": axis, "A": A, "B": B, "shape": v},
162:                     )
163:                 )
164: 
165:     root_cands.sort(key=lambda x: x[0])
166:     cand_roots = [pair[1] for pair in root_cands[:20]]
167: 
168:     best_out = out.copy()
169:     best_key = None
170: 
171:     def search(out_grid, occ_set, chains, remaining):
172:         nonlocal best_out, best_key
173:         placed_cnt = len(pieces) - len(remaining)
174:         key = (placed_cnt, -len(remaining), -len(occ_set))
175:         if best_key is None or key > best_key:
176:             best_key = key
177:             best_out = out_grid.copy()
178:         if not remaining:
179:             return True
180: 
181:         def gen_extend_moves(chain, remaining_set):
182:             axis = chain["axis"]
183:             A, B = int(chain["A"]), int(chain["B"])
184:             head = chain["head"]
185:             head_pts = pixels(head["shape"], head["top"], head["left"])
186:             head_top, head_left = int(head["top"]), int(head["left"])
187:             head_h, head_w = int(head["shape"]["h"]), int(head["shape"]["w"])
188: 
189:             cavity = {
190:                 (r, c)
191:                 for r in range(head_top, head_top + head_h)
192:                 for c in range(head_left, head_left + head_w)
193:                 if out_grid[r, c] == bg
194:             }
195:             if not cavity:
196:                 return []
197: 
198:             moves = []
199:             for pi in remaining_set:
200:                 v = pieces[pi]["shape"]
201:                 for top, left in aligned_positions(axis, A, cavity, v):
202:                     pts = placement_pts(v, top, left, occ_set, must_cover=cavity, strip=(axis, A, B))
203:                     if pts is None:
204:                         continue
205:                     if not touches(pts, head_pts):
206:                         continue
207:                     moves.append((pi, top, left, pts, v))
208:             return moves
209: 
210:         # Try extending any chain.
211:         for ch in chains:
212:             moves = gen_extend_moves(ch, remaining)
213:             if not moves:
214:                 continue
215:             # small branching factor is enough for this puzzle
216:             for pi, top, left, pts, v in moves[:8]:
