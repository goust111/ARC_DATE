+def _sample_items() -> list[dict] | None:
+    n_items = int(_RNG.integers(3, 6))
+    for _ in range(80):
+        items: list[dict] = []
+        seen = set()
+        guard = 0
+        while len(items) < n_items and guard < 200:
+            guard += 1
+            mask = _random_shape()
+            key = _mask_key(mask)
