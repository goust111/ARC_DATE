+
+def _random_shape() -> np.ndarray:
+    for _ in range(120):
+        target_area = int(_RNG.integers(3, 8))
+        max_dim = int(_RNG.integers(3, 6))
+        cells = {(0, 0)}
+        for _step in range(target_area - 1):
+            frontier = set()
+            for r, c in cells:
+                for dr, dc in DIR4:
+                    p = (r + dr, c + dc)
