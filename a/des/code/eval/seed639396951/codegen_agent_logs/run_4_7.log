+def _build_expected(grid: np.ndarray, items: list[dict]) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    contacts = [int(item["contact"]) for item in items]
+    max_contact = max(contacts)
+    min_contact = min(contacts)
+    for item in items:
