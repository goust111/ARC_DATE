+        color = int(assignment["piece_color"])
+        if assignment["contact"] == max_contact:
+            fill = YELLOW
+        elif assignment["contact"] == min_contact:
+            fill = BLUE
+        else:
+            fill = color
+        coords = assignment["hole_coords"]
+        out[coords[:, 0], coords[:, 1]] = int(fill)
