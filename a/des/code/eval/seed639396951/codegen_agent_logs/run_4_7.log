32: def main(grid: np.ndarray) -> np.ndarray:
33:     """
34:     Move each right-side colored shape into the left slot whose template color is its exact complement.
35: 
36:     Input structure:
37:     - The grid has two equal-width slots separated by one background column.
38:     - Non-background rows form horizontal bands separated by all-background rows.
39:     - Each band has a shared template color in the left slot and one colored source shape in the right slot.
40: 
41:     Rule:
42:     - For each band, define its destination shape as the cells in the left slot not occupied by the template color.
43:     - Normalize every right-side source shape to right-slot coordinates and match it to the unique equal destination shape.
44:     - Clear the original right-side source pixels and paint the matched left-slot complement with the source color.
45: 
46:     Key insight:
47:     The right-side objects are not placed by row order; each one completes the unique left template whose missing cells have the same shape.
48:     """
49:     g = np.asarray(grid, dtype=int)
50:     h, w = g.shape
51:     bg = int(get_bg(g))
52:     assert w % 2 == 1, "canvas must contain two equal slots plus one separator column"
53:     slot_w = w // 2
54:     sep_c = slot_w
55: 
56:     bands = _active_row_spans(g, bg)
57:     assert bands, "grid must contain at least one active band"
58: 
59:     band_color_sets: list[set[int]] = []
60:     for r0, r1 in bands:
61:         colors = set(map(int, g[r0 : r1 + 1].ravel())) - {bg}
62:         assert colors, "each active band must contain foreground colors"
63:         band_color_sets.append(colors)
64: 
65:     shared_colors = set.intersection(*band_color_sets)
66:     assert len(shared_colors) == 1, "template color must be the only color shared by all bands"
67:     template_color = next(iter(shared_colors))
68: 
69:     dest_shapes: list[CoordSet] = []
70:     sources: list[tuple[int, CoordSet]] = []
71:     for band_i, (r0, r1) in enumerate(bands):
72:         block = g[r0 : r1 + 1]
73:         assert np.all(block[:, sep_c] == bg), "slot separator column must be background"
74: 
75:         left = block[:, :slot_w]
76:         right = block[:, sep_c + 1 :]
77:         assert np.all((left == bg) | (left == template_color)), "left slot must contain only template and background"
78: 
79:         template_mask = left == template_color
80:         for row in template_mask:
81:             cols = np.flatnonzero(row)
82:             assert cols.size > 0, "each template row must contain at least one pixel"
83:             expected = np.arange(int(cols[-1]) + 1)
84:             assert np.array_equal(cols, expected), "template pixels must be a left-anchored row prefix"
85: 
86:         dest_shapes.append(_coords(~template_mask))
87: 
88:         source_mask = right != bg
89:         assert np.any(source_mask), f"band {band_i} source shape must be non-empty"
90:         source_colors = set(map(int, right[source_mask].ravel()))
91:         assert len(source_colors) == 1, "each right slot must contain exactly one source color"
92:         source_color = next(iter(source_colors))
93:         assert source_color != template_color, "source color must differ from template color"
94:         source_shape = _coords(source_mask)
95:         sources.append((source_color, source_shape))
96: 
97:     out = g.copy()
98:     for r0, r1 in bands:
99:         right = out[r0 : r1 + 1, sep_c + 1 :]
100:         right[right != bg] = bg
101: 
102:     used_destinations: set[int] = set()
103:     for source_color, source_shape in sources:
104:         matches = [i for i, dest_shape in enumerate(dest_shapes) if dest_shape == source_shape]
105:         assert len(matches) == 1, "each source shape must match exactly one left-slot complement"
106:         dest_i = matches[0]
107:         assert dest_i not in used_destinations, "each destination complement must be filled once"
108:         used_destinations.add(dest_i)
109: 
110:         dest_r0, _ = bands[dest_i]
111:         for dr, dc in source_shape:
112:             rr = dest_r0 + dr
113:             assert out[rr, dc] == bg, "matched complement cells must be empty before painting"
114:             out[rr, dc] = source_color
115: 
116:     assert len(used_destinations) == len(bands), "all destination complements must be filled"
117:     assert out.shape == (h, w)
118:     return out
