+            for nc in range(max(0, cc - 1), min(w, cc + 2)):
+                if blocked[nr, nc]:
+                    return False
+    return True
+
+
+def _mark_forbidden(blocked: np.ndarray, mask: np.ndarray, top: int, left: int) -> None:
+    h, w = blocked.shape
+    for dr, dc in np.argwhere(mask):
