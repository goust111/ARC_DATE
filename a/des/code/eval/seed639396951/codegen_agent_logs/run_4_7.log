7: def main(grid: np.ndarray) -> np.ndarray:
8:     """
9:     Fill holes inside a large template frame using shape-matched outside sprites.
10: 
11:     Input structure:
12:     - bg = most common color. One large monochrome frame object (template).
13:     - Inside the frame: holes of various shapes (non-frame-color regions).
14:     - Outside the frame: small monochrome sprites scattered on bg.
15: 
16:     Rule:
17:     - Crop to the frame's bounding box; fill entirely with frame color.
18:     - For each hole, find an outside sprite whose shape matches (rotation/flip allowed).
19:     - Fill the hole with the matched sprite's color. If multiple sprites match, use the most frequent color.
20: 
21:     Key insight: Sprites act as shape-coded color keys — their shape identifies which hole they fill, their color determines the fill color.
22:     """
23:     g = np.array(grid, dtype=int)
24:     bg = int(get_bg(g))
25: 
26:     # STEP 1) Find the template frame: largest connected component of any non-bg color (8-connected).
27:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=True, return_format="dict")
28:     assert comps
29:     frame_area = max(int(comp["area"]) for comp in comps)
30:     frame_candidates = [comp for comp in comps if int(comp["area"]) == frame_area]
31:     assert len(frame_candidates) == 1
32:     frame = frame_candidates[0]
33:     frame_col = int(frame["color"])
34:     fb = frame["bbox"]
35:     r0, c0, r1, c1 = map(int, fb)
36: 
37:     sub = crop_bbox(g, fb)
38:     th, tw = sub.shape
39: 
40:     # STEP 2) Extract hole components inside the bbox (anything not equal to frame color), 4-connected.
41:     hole_mask = (sub != int(frame_col))
42:     holes: list[tuple[tuple[tuple[int, int], bytes], tuple[int, int], np.ndarray]] = []  # (key, (r0,c0), mask)
43:     for coords in components_mask(hole_mask, connectivity=4):
44:         hr0, hc0, hr1, hc1 = bbox_coords(coords)
45:         hh = int(hr1 - hr0 + 1)
46:         ww = int(hc1 - hc0 + 1)
47:         rel = coords - np.array([hr0, hc0])
48:         m = np.zeros((hh, ww), dtype=bool)
49:         m[rel[:, 0], rel[:, 1]] = True
50:         key = (m.shape, m.tobytes())
51:         holes.append((key, (int(hr0), int(hc0)), m))
52: 
53:     # STEP 3) Extract sprites outside the bbox.
54:     outside = g.copy()
55:     outside[r0 : r1 + 1, c0 : c1 + 1] = int(bg)
56:     spr_comps = find_components(outside, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
57: 
58:     # key -> color -> count
59:     sprites_by_key: dict[tuple[tuple[int, int], bytes], dict[int, int]] = {}
60: 
61:     def _all_mask_keys(mask: np.ndarray):
62:         """Generate keys for all rotations (and optional vertical flip) of a boolean mask."""
63:         m0 = mask.astype(bool)
64:         for flip in (False, True):
65:             m1 = np.flipud(m0) if flip else m0
66:             for k in range(4):
67:                 m2 = np.rot90(m1, k)
68:                 yield (m2.shape, m2.tobytes())
69: 
70:     for comp in spr_comps:
71:         coords = comp["coords"]
72:         bb = comp["bbox"]
73:         sr0, sc0, sr1, sc1 = map(int, bb)
74:         hh = int(sr1 - sr0 + 1)
75:         ww = int(sc1 - sc0 + 1)
76: 
77:         vals = [int(v) for v in g[coords[:, 0], coords[:, 1]]]
78:         scol = int(Counter(vals).most_common(1)[0][0])
79: 
80:         rel = coords - np.array([sr0, sc0])
81:         m = np.zeros((hh, ww), dtype=bool)
82:         m[rel[:, 0], rel[:, 1]] = True
83: 
84:         for key in _all_mask_keys(m):
85:             bucket = sprites_by_key.setdefault(key, {})
86:             bucket[scol] = int(bucket.get(scol, 0)) + 1
87: 
88:     # STEP 4) Render output: start from solid frame color, then fill each hole by shape match.
89:     out = np.full((th, tw), int(frame_col), dtype=int)
90:     for key, (hr0, hc0), hmask in holes:
91:         cmap = sprites_by_key.get(key)
92:         assert cmap is not None
93:         # choose the most frequent sprite color for this shape; break ties by preferring smaller color id
94:         scol = max(cmap.items(), key=lambda kv: (kv[1], -kv[0]))[0]
95:         patch = np.full(hmask.shape, int(scol), dtype=int)
96:         paste(out, patch, int(hr0), int(hc0), mask=hmask)
97: 
98:     return out
99: 
100: # --------------- generator (att1) ---------------
101: 
