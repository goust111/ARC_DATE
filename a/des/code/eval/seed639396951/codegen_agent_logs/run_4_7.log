103: NUM_COLORS = 10
104: GRID_SIZE = 30
105: 
106: # Frame bbox dimensions
107: FRAME_H_RANGE = (7, 13)
108: FRAME_W_RANGE = (7, 20)
109: 
110: # Hole layout
111: SHAPE_COUNT_RANGE = (3, 6)          # distinct canonical hole shapes
112: MIN_SHAPES = 3                       # minimum to accept a layout
113: SHAPE_MAX_AREA = 8                   # max cells per hole shape
114: FRAME_DENSITY_RANGE = (0.55, 0.92)   # fraction of frame_col in frame bbox
115: MIN_TOTAL_HOLES = 5                  # minimum hole instances
