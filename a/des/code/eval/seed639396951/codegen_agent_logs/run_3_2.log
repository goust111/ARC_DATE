        cursor = growth_bottom + int(spec["gap"]) + 1

    return grid


def _has_visible_growth(inp: np.ndarray, out: np.ndarray) -> bool:
    return bool(np.any(inp != out))


def _gen_attempt() -> np.ndarray | None:
