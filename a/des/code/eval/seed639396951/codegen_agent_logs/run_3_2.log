+    color = int(seed["color"])
+    r0 = int(seed["r0"])
+    c0 = int(seed["c0"])
+    h = int(seed["r1"]) - r0 + 1
+    n_layers = int(seed["size"])
+    soil_row = int(strip["row"])
+    left = int(strip["c0"])
+    right = int(strip["c1"])
+    grid_h, grid_w = map(int, out.shape)
+
