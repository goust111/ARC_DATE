se = sized[0]\n        sr0, sc0, sr1, sc1 = base[\"bbox\"]\n\n        pts_set = set(base[\"pts\"])\n        for comp in all_candidates:\n            if comp[\"id\"] == base[\"id\"]:\n                continue\n            r0, c0, r1, c1 = comp[\"bbox\"]\n            assert sr0 <= r0 and sr1 >= r1 and sc0 <= c0 and sc1 >= c1, (\n                f\"extra sprite component for color {src_col} is outside the base bbox\"\n            )\n            pts_set.update(comp[\"pts\"])\n\n        base_mask = np.zeros((sr1 - sr0 + 1, sc1 - sc0 + 1), dtype=bool)\n        for r, c in pts_set:\n            base_mask[r - sr0, c - sc0] = True\n        sprite_masks[src_col] = _apply_frame_rule(base_mask, frame_col)\n\n    out = crop.copy()\n    out[1:-1, 1:-1] = bg\n\n    for src_col, (pr0, pc0, pr1, pc1) in placeholders:\n        assert src_col in sprite_masks and src_col in color_map, (\n            f\"placeholder color {src_col} missing sprite or color mapping\"\n        )\n        tgt_col = int(color_map[src_col])\n        mask = sprite_masks[src_col]\n        sh, sw = mask.shape\n        assert (pr1 - pr0 + 1, pc1 - pc0 + 1) == (sh, sw), (\n            f\"placeholder size does not match transformed sprite for color {src_col}\"\n        )\n        patch = np.full((sh, sw), bg, dtype=int)\n        patch[mask] = tgt_col\n        paste(out, patch, pr0, pc0, transparent=bg)\n\n    return out\n\n\n# --------------- generator (o5x) ---------------\n\n# === CFG: tunables ===\nSPRITE_N_RANGE = (3, 6)             # NxN sprite/placeholder size, exclusive upper\nGRID_ROWS_RANGE = (2, 4)            # placeholder grid row count, exclusive upper\nGRID_COLS_RANGE = (3, 5)            # placeholder grid col count, exclusive upper\nTOTAL_BLOCKS_RANGE = (6, 10)        # total filled slots (inclusive)\nMAX_EMPTY_SLOTS = 2                 # max empty slots in the grid\nNUM_COLORS_RANGE = (2, 5)           # K = number of distinct placeholder colors (inclusive)\nSPRITE_FILL_MIN = 0.5               # min sprite fill ratio\nSPRITE_FILL_MAX = 0.9               # max sprite fill ratio (clamped to n*n-1)\nMIN_FRAME_H = 13                    # minimum frame height\nMIN_FRAME_W = 18                    # minimum frame width\nMAX_FRAME_DIM = 21                  # maximum frame height or width\nFRAME_MARGIN_SLACK = 4              # max extra padding inside frame beyond content\nCANVAS_H_RANGE = (22, 31)           # final grid height range, exclusive upper\nCANVAS_W_RANGE = (23, 31)           # final grid width range, exclusive upper\nFRAME_POS_JITTER_PROB = 0.25        # probability of non-edge frame placement per axis\nPATCH_PADDING = 1                   # min bg gap between placed patches\nGEN_RETRIES = 300                   # outer retry budget\nMASK_RETRIES = 200                  # retries for generating a visibly asymmetric sprite\n\n\ndef _legend(src: int, tgt: int) -> np.ndarray:\n    \"\"\"Build a 3x4 legend block mapping src color to tgt color.\"\"\"\n    return np.array(\n        [[src, src, tgt, tgt], [src, src, src, tgt], [src, src, tgt, tgt]],\n        dtype=int,\n    )\n\n\ndef _sprite_mask(n: int) -> np.ndarray:\n    \"\"\"Generate an NxN binary mask whose 90-degree rotation is visibly different.\"\"\"\n    lo = max((n * n + 1) // 2, int(np.ceil(SPRITE_FILL_MIN * n * n)))\n    hi = min(int(np.floor(SPRITE_FILL_MAX * n * n)), n * n - 1)\n\n    for _ in range(MASK_RETRIES):\n        target = random.randint(lo, hi)\n        mask = np.zeros((n, n), dtype=bool)\n        c = random.randrange(n)\n        for r in range(n):\n            c = max(0, min(n - 1, c + random.choice([-1, 0, 1])))\n            mask[r, c] = True\n        mask[random.randrange(n), :] = True\n\nexec\n/bin/bash -lc 'ls -ld /home/lixinyu/snap/new/ceshi/code_combo/edb79dae/25 || true' in /home/lixinyu/snap/new\n succeeded in 0ms:\ndrwxrwxr-x+ 3 lixinyu lixinyu 4096 May 15 08:55 /home/lixinyu/snap/new/ceshi/code_combo/edb79dae/25\n\ncodex\n规则已经明确成一个可实现的组合：保持“同色占位块选外部精灵”的骨架，但把“框架颜色”改成选择图案类型的控制码，图例改成“源色标签列 + 图案样本块”。接下来我会先把融合版设计分析写进文件注释，再实现一个统一解析器和一个保证可观察性的输出优先 generator。\ncodex\n我准备把融合做成“每个源色在框架外同时给出两种候选图案 legend，框架颜色决定选哪一类”。这样 `main()` 必须同时解析多色 legend 和多色框架编码，避免退化成“只看 legend 就够了”。\nexec\n/bin/bash -lc 'rg -n \"def find_components|def random_free_location|def paste\" /home/lixinyu/snap/new/solvers/arc_utils.py' in /home/lixinyu/snap/new\n succeeded in 0ms:\n308:def paste(\n404:def find_components(\n854:def random_free_location(\n\nexec\n/bin/bash -lc \"if [ -f /home/lixinyu/snap/new/ceshi/code_combo/edb79dae/25/code.py ]; then sed -n '1,260p' /home/lixinyu/snap/new/ceshi/code_combo/edb79dae/25/code.py; fi\" in /home/lixinyu/snap/new\n succeeded in 0ms:\n# Combo variant of edb79dae (index 25)\n# combo_spec: D11/3+D6/1\n# Name: 多色框架编码+多色图案重着色\n\nfrom __future__ import annotations\n\nimport itertools\nimport random\nimport sys\nfrom pathlib import Path\n\nimport numpy as np\n\nROOT = Path(\"/home/lixinyu/snap/new/solvers\")\nif str(ROOT) not in sys.path:\n    sys.path.append(str(ROOT))\n\nfrom arc_utils import bbox_coords, components_mask, find_components, get_bg, paste, random_free_location\n\n\n# Design analysis:\n# - concrete behavior:\n#   The original task used the frame only as a container, then used outside same-color sprites plus legends\n#   to repaint every placeholder with one flat target color. This fusion keeps the same object inventory\n#   but makes the frame color an active code with two simultaneous effects:\n#     blue frame (1): rotate every matched sprite 90 degrees clockwise, then repaint it with vertical stripes\n#                     alternating between the two legend colors.\n#     green frame (3): keep the sprite orientation, then repaint it with a checkerboard alternating between\n#                      the two legend colors.\n#   The outside legend for source color s is now an opaque N x 3 rectangle:\n#     column 0 = all s\n#     column 1 = all pattern color a\n#     column 2 = all pattern color b\n#   Example trace for a 4x4 placeholder of color 2:\n#     original: placeholder 2 -> outside color-2 sprite mask M -> legend 2->7 -> output is M filled with 7.\n#     fused blue frame: placeholder 2 -> outside color-2 sprite mask M -> rotate to rot90(M, clockwise)\n#     -> legend gives colors (8,4) -> fill rotated sprite with vertical 8/4 stripes clipped by the mask.\n#     fused green frame: same sprite lookup, but no rotation; legend colors (8,4) are arranged as a checker.\n#   The difference is therefore not just \"multicolor output\" and not just \"frame-coded transform\":\n#   the frame color selects both the geometric transform and the spatial repaint pattern.\n# - complexity calibration:\n#   Only two frame-rule categories are used, because ARC examples usually give just 2-4 demonstrations.\n#   A larger rule table would be underdetermined. The repaint families are also limited to two visible motifs\n#   (vertical stripes vs checkerboard), so the distinction is obvious by eye.\n# - implicit assumptions audit:\n#   The original solver assumed legends were two-color overlap glyphs and that repainting wrote one scalar color.\n#   Both assumptions break here, so the solver now:\n#     1. finds multicolor opaque legend rectangles with size N x 3,\n#     2. reads a source tag column plus a two-color palette,\n#     3. synthesizes the final N x N tile from the frame color,\n#     4. applies the frame-coded rotation before clipping the tile with the sprite mask.\n#   Sprite extraction still assumes exactly one same-color N x N bbox per placeholder color outside the frame,\n#   with any extra disconnected cells fully contained in that bbox; the generator preserves that.\n# - placement legality and cleanliness:\n#   Legends are opaque rectangles, sprites are monochrome-on-bg patches, and all outside patches are placed with\n#   a reserve grid plus one-cell padding, so they never overlap or merge accidentally. Frame colors are excluded\n#   from all other objects, preventing frame/sprite/legend ambiguity.\n# - visual observability:\n#   The blue rule is made visible by rejecting masks invariant under 90-degree rotation. Pattern visibility is\n#   backed by rejecting masks whose occupied cells would only hit one stripe/parity bucket. Thus the generated\n#   outputs cannot silently collapse back to a monochrome recolor or to an unobservable rotation.\n# - generator-backed new assumptions:\n#   Every placeholder color has exactly one legend palette, every legend uses two colors distinct from the source\n#   color, placeholders remain square NxN so rotation preserves bbox size, and the chosen frame color is random\n#   across samples so both frame-coded behaviors appear in the dataset.\n\n\nFRAME_RULES = {\n    1: {\"turns\": 1, \"pattern\": \"vertical\"},  # blue\n    3: {\"turns\": 0, \"pattern\": \"checker\"},   # green\n}\nFRAME_COLORS = tuple(sorted(FRAME_RULES))\nRESERVE_MARK = 10\n\n\ndef _find_frame(g: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int]]:\n    \"\"\"\n    Find a rectangular border component:\n      - all bbox-border cells are this color,\n      - bbox-interior is not entirely this color.\n    Return (frame_color, (r0,c0,r1,c1)).\n    \"\"\"\n    candidates = []\n    colors = [int(c) for c in np.unique(g) if int(c) != bg]\n    for col in colors:\n        for pts in components_mask(g == col, connectivity=4):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            if r1 - r0 < 2 or c1 - c0 < 2:\n                continue\n            sub = g[r0 : r1 + 1, c0 : c1 + 1]\n            border = np.zeros(sub.shape, dtype=bool)\n            border[0, :] = True\n            border[-1, :] = True\n            border[:, 0] = True\n            border[:, -1] = True\n            if not np.all(sub[border] == col):\n                continue\n            if np.all(sub[~border] == col):\n                continue\n            candidates.append((col, (r0, c0, r1, c1)))\n    assert len(candidates) == 1, f\"expected exactly one rectangular frame component, found