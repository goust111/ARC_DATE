rray, tile: np.ndarray, bg: int) -> np.ndarray:\n     out = np.full(mask.shape, bg, dtype=int)\n-    out[transformed] = tile[transformed]\n+    out[mask] = np.asarray(tile, dtype=int)[mask]\n     return out\n \n \n@@ -479,15 +539,17 @@\n \n     k = random.randint(*NUM_COLORS_RANGE)\n     src_cols = random.sample(usable, k)\n-    palette_pool = [c for c in usable if c not in src_cols]\n-    if len(palette_pool) < 2:\n-        return None\n+    masks = {src: _sprite_mask(n) for src in src_cols}\n \n-    masks = {src: _sprite_mask(n, frame_col) for src in src_cols}\n-    legend_palettes: dict[int, tuple[int, int]] = {}\n+    legend_tiles: dict[int, dict[str, np.ndarray]] = {}\n     for src in src_cols:\n-        color_a, color_b = random.sample(palette_pool, 2)\n-        legend_palettes[src] = (color_a, color_b)\n+        pool = [c for c in usable if c != src]\n+        if len(pool) < 2:\n+            return None\n+        color_a, color_b = random.sample(pool, 2)\n+        legend_tiles[src] = {\n+            family: _build_pattern_tile((n, n), family, color_a, color_b) for family in PATTERN_FAMILIES\n+        }\n \n     ch, cw = _content_extent(n, rows, cols)\n     min_fh = max(MIN_FRAME_H, ch + 4)\n@@ -500,25 +562,24 @@\n     left_margin = random.randint(1, x_margin - 1)\n \n     _, filled_slots = _choose_empty_slots(rows, cols, empty_count)\n-    cell_colors = {}\n+    cell_colors: dict[tuple[int, int], int] = {}\n     for slot, col in zip(filled_slots[:k], src_cols):\n         cell_colors[slot] = col\n     for slot in filled_slots[k:]:\n         cell_colors[slot] = random.choice(src_cols)\n-    if len(filled_slots) > k and all(sum(1 for val in cell_colors.values() if val == src) == 1 for src in src_cols):\n-        return None\n \n     input_frame = _make_bordered_frame(frame_h, frame_w, bg, frame_col)\n     output_frame = _make_bordered_frame(frame_h, frame_w, bg, frame_col)\n+    active_family = _frame_family(frame_col)\n     for (rr, cc), src in cell_colors.items():\n         r0 = 1 + top_margin + rr * (n + 1)\n         c0 = 1 + left_margin + cc * (n + 1)\n         paste(input_frame, np.full((n, n), src, dtype=int), r0, c0)\n-        color_a, color_b = legend_palettes[src]\n-        patterned = _patterned_sprite(masks[src], frame_col, color_a, color_b, bg)\n+        transformed = _apply_frame_rule(masks[src], frame_col)\n+        patterned = _patterned_sprite(transformed, legend_tiles[src][active_family], bg)\n         paste(output_frame, patterned, r0, c0, transparent=bg)\n \n-    ext_area = k * (n * n + 3 * n + 12)\n+    ext_area = k * (n * n + 2 * n * (n + 1) + 16)\n     possible_dims = [\n         (h, w)\n         for h in range(*CANVAS_H_RANGE)\n@@ -542,9 +603,9 @@\n \n     patches: list[tuple[np.ndarray, bool]] = []\n     for src in src_cols:\n-        color_a, color_b = legend_palettes[src]\n         patches.append((_colored_sprite(masks[src], src, bg), True))\n-        patches.append((_legend(src, color_a, color_b, n), False))\n+        for family in PATTERN_FAMILIES:\n+            patches.append((_legend(src, legend_tiles[src][family]), False))\n     random.shuffle(patches)\n     patches.sort(key=lambda item: item[0].size, reverse=True)\n     for patch, transparent in patches:\n\nexec\n/bin/bash -lc \"/home/xd/miniconda3/bin/python - <<'PY'\nimport importlib.util\nimport numpy as np\nfrom collections import Counter\n\nspec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code_combo/edb79dae/25/code.py')\nmod = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(mod)\n\nfamily_diffs = []\nmulticolor_counts = []\nframe_counts = Counter()\n\nfor _ in range(100):\n    inp = mod.generate_input()\n    out = mod.main(inp)\n    bg = mod.get_bg(inp)\n    frame_col, (r0, c0, r1, c1) = mod._find_frame(inp, bg)\n    frame_counts[frame_col] += 1\n\n    active_cells = set(map(int, np.unique(out))) - {bg, frame_col}\n    multicolor_counts.append(len(active_cells))\n\n    alt_frame = [c for c in mod.FRAME_COLORS if c \"'!= frame_col][0]\n    swapped = inp.copy()\n    swapped[r0:r1+1, c0] = alt_frame\n    swapped[r0:r1+1, c1] = alt_frame\n    swapped[r0, c0:c1+1] = alt_frame\n    swapped[r1, c0:c1+1] = alt_frame\n    alt_out = mod.main(swapped)\n    family_diffs.append(int(np.sum(out != alt_out)))\n\nprint('\"'frame_counts', dict(frame_counts))\nprint('family_diff_min', min(family_diffs))\nprint('family_diff_mean', round(sum(family_diffs) / len(family_diffs), 2))\nprint('family_diff_nonzero', sum(d > 0 for d in family_diffs), '/', len(family_diffs))\nprint('multicolor_min', min(multicolor_counts))\nprint('multicolor_mean', round(sum(multicolor_counts) / len(multicolor_counts), 2))\nprint('multicolor_ge2', sum(c >= 2 for c in multicolor_counts), '/', len(multicolor_counts))\nPY\" in /home/lixinyu/snap/new\ndiff --git a/ceshi/code_combo/edb79dae/25/code.py b/ceshi/code_combo/edb79dae/25/code.py\nindex 07daa00449d88022797bcc79ed9d83fc5698dd62..ed7905be4ed892cf4c2c1d5ce759e9c45d13a61f\n--- a/ceshi/code_combo/edb79dae/25/code.py\n+++ b/ceshi/code_combo/edb79dae/25/code.py\n@@ -19,59 +19,96 @@\n \n \n # Design analysis:\n-# - concrete behavior:\n-#   The original task used the frame only as a container, then used outside same-color sprites plus legends\n-#   to repaint every placeholder with one flat target color. This fusion keeps the same object inventory\n-#   but makes the frame color an active code with two simultaneous effects:\n-#     blue frame (1): rotate every matched sprite 90 degrees clockwise, then repaint it with vertical stripes\n-#                     alternating between the two legend colors.\n-#     green frame (3): keep the sprite orientation, then repaint it with a checkerboard alternating between\n-#                      the two legend colors.\n-#   The outside legend for source color s is now an opaque N x 3 rectangle:\n-#     column 0 = all s\n-#     column 1 = all pattern color a\n-#     column 2 = all pattern color b\n-#   Example trace for a 4x4 placeholder of color 2:\n-#     original: placeholder 2 -> outside color-2 sprite mask M -> legend 2->7 -> output is M filled with 7.\n-#     fused blue frame: placeholder 2 -> outside color-2 sprite mask M -> rotate to rot90(M, clockwise)\n-#     -> legend gives colors (8,4) -> fill rotated sprite with vertical 8/4 stripes clipped by the mask.\n-#     fused green frame: same sprite lookup, but no rotation; legend colors (8,4) are arranged as a checker.\n-#   The difference is therefore not just \"multicolor output\" and not just \"frame-coded transform\":\n-#   the frame color selects both the geometric transform and the spatial repaint pattern.\n-# - complexity calibration:\n-#   Only two frame-rule categories are used, because ARC examples usually give just 2-4 demonstrations.\n-#   A larger rule table would be underdetermined. The repaint families are also limited to two visible motifs\n-#   (vertical stripes vs checkerboard), so the distinction is obvious by eye.\n-# - implicit assumptions audit:\n-#   The original solver assumed legends were two-color overlap glyphs and that repainting wrote one scalar color.\n-#   Both assumptions break here, so the solver now:\n-#     1. finds multicolor opaque legend rectangles with size N x 3,\n-#     2. reads a source tag column plus a two-color palette,\n-#     3. synthesizes the final N x N tile from the frame color,\n-#     4. applies the frame-coded rotation before clipping the tile with the sprite mask.\n-#   Sprite extraction still assumes exactly one same-color N x N bbox per placeholder color outside the frame,\n-#   with any extra disconnected cells fully contained in that bbox; the generator preserves that.\n-# - placement legality and cleanliness:\n-#   Legends are opaque rectangles, sprites are monochrome-on-bg patches, and all outside patches are placed with\n-#   a reserve grid plus one-cell padding, so they never overlap or merge accidentally. Frame colors are excluded\n-#   from all other objects, preventing frame/sprite/legend ambiguity.\n-# - visual observability:\n-#   The blue rule is made visible by rejecting masks invariant under 90-degree rotation. Pattern visibility is\n-#   backed by rejecting masks whose occupied cells would only hit one stripe/parity bucket. Thus the generated\n-#   outputs cannot silently collapse back to a monochrome recolor or to an unobservable rotation.\n-# - generator-backed new assumptions:\n-#   Every placeholder color has exactly one legend palette, every legend uses two colors distinct from the source\n-#   color, placeholders remain square NxN so rotation preserves bbox size, and the chosen frame color is random\n-#   across samples so both frame-coded behaviors appear in the dataset.\n+# a) 具体化与行为追踪\n+#   原题流程是：\n+#     1. 框内实心占位块按颜色索引框外同色精灵。\n+#     2. 再读一个 source->target legend，把所有放入框内的精灵统一改成单色。\n+#   融合后改成：\n+#     1. 框外同色精灵仍然提供“形状”。\n+#     2. 每个 source 颜色在框外不再只有一个 legend，而是同时给出两种 multicolor legend：\n+#        - 条纹 legend\n+#        - 棋盘格 legend\n+#        二者都用同一个 source 标签列开头，右侧都是 N x N 的多色图案样本。\n+#     3. 框架颜色不再只是装饰，而是一个全局控制码：\n+#        - 蓝框(1): 精灵先顺时针旋转 90 度，再选“条纹 legend”进行重着色。\n+#        - 绿框(3): 精灵不旋转，改用“棋盘格 legend”进行重着色。\n+#   一个 4x4 的具体追踪例子：\n+#     - 原题：框内颜色 2 -> 取框外颜色 2 的精灵 M -> legend 说 2->7 -> 输出是单色 7 的 M。\n+#     - 融合蓝框：框内颜色 2 -> 取精灵 M -> 旋转成 rot90(M) -> 在颜色 2 的两个候选 legend 里，\n+#       选条纹 tile T_stripe -> 输出是被 rot90(M) 裁剪后的 T_stripe。\n+#     - 融合绿框：框内颜色 2 -> 取精灵 M -> 不旋转 -> 选棋盘格 tile T_checker -> 输出是被 M 裁剪后的 T_checker。\n+#   差异点不再是“纯重着色”或“纯框色控制”单独发生，而是框色同时决定几何变换和应读取哪类多色图案。\n+# b) 复杂度校准\n+#   只保留两个 frame-rule 档位，避免 ARC 训练样例过少时映射不可判定。\n+#   图案家族也只保留两类：vertical stripes 与 checkerboard；视觉差异稳定且不依赖颜色编号语义。\n+#   每个 source 同时出现两种候选 legend，防止规则退化成“只看唯一 legend 就够了”。\n+# c) 隐式假设审查\n+#   原 solver 的这些前提被打破了：\n+#     - legend 是两个颜色重叠得到的小双色 glyph。\n+#     - legend 只给一个目标色，写回时可以按像素直接填同一个标量。\n+#     - frame color 不参与真正决策。\n+#   新 solver 因此显式改成：\n+#     - 用 monochromatic=False 识别完整不透明 multicolor legend 矩形。\n+#     - 要求每个 source 对应两张 legend，且能按 tile 内容分类为条纹 / 棋盘格。\n+#     - 根据 frame color 先选 family，再选对应 legend tile，再裁剪到 sprite mask。\n+#   仍保留并由 generator 保证的前提：\n+#     - 每个 source 颜色在框外恰有一个同色 sprite bbox，尺寸与占位块一致。\n+#     - 占位块仍为方形 NxN，因此蓝框旋转后 bbox 不变。\n+# d) 放置合法性\n+#   generator 仍用 reserve 网格和 1-cell padding 放置外部对象，确保 sprite/legend/frame 互不重叠、不断开、不越界。\n+#   外部对象不复用任一 frame color，避免 frame/sprite/legend 解析歧义。\n+# e) 视觉可观察性\n+#   蓝框输出必须同时表现“旋转 + 条纹”；绿框必须表现“无旋转 + 棋盘格”。\n+#   为此 generator 拒绝：\n+#     - 对 90 度旋转不变的 sprite mask；\n+#     - 在蓝框规则下只会落到同一列奇偶类的 mask；\n+#     - 在绿框规则下只会落到同一棋盘奇偶类的 mask。\n+#   这样多色效果和 frame-coded 差异都能在少量样例中直接看到。\n+# f) 可视化整洁度\n+#   仍保持“一个框 + 框外模板与图例”的原布局，只是每个 source 多出一个候选 legend。\n+#   不在框内叠加额外标记；图案都在原 sprite bbox 内完成，因此输出区域仍然清晰。\n+# g) 变化的可推断性\n+#   颜色变化不靠隐式编号，而靠结构线索：\n+#     - 相同 source 的两个候选 legend 都可见；\n+#     - 框色稳定对应条纹或棋盘格；\n+#     - 同色占位块会重复出现，使同一 family 的图案在同一张图中多次重现。\n+# 9) main() 的新隐式假设与 generator 对应保证\n+#   - `_extract_legends` 假设 legend 是 N x (N+1) 的不透明矩形，首列全是 source 色。\n+#     generator 直接构造此矩形。\n+#   - `_classify_pattern_tile` 假设 tile 属于受限 family 集合。\n+#     generator 只产生 vertical/checker 两类 tile。\n+#   - 最终写回循环假设 frame 选择的 family 对每个 source 都存在。\n+#     generator 为每个 source 固定生成这两张 legend，solver 再按 frame color 选其中一张。\n \n \n FRAME_RULES = {\n-    1: {\"turns\": 1, \"pattern\": \"vertical\"},  # blue\n-    3: {\"turns\": 0, \"pattern\": \"checker\"},   # green\n+    1: {\"turns\": 1, \"family\": \"vertical\"},  # blue frame\n+    3: {\"turns\": 0, \"family\": \"checker\"},   # green frame\n }\n FRAME_COLORS = tuple(sorted(FRAME_RULES))\n+PATTERN_FAMILIES = tuple(sorted({str(rule[\"family\"]) for rule in FRAME_RULES.values()}))\n RESERVE_MARK = 10\n \n+# === CFG: tunables ===\n+SPRITE_N_RANGE = (3, 6)\n+GRID_ROWS_RANGE = (2, 4)\n+GRID_COLS_RANGE = (3, 5)\n+TOTAL_BLOCKS_RANGE = (6, 10)\n+MAX_EMPTY_SLOTS = 2\n+NUM_COLORS_RANGE = (2, 4)\n+SPRITE_FILL_MIN = 0.5\n+SPRITE_FILL_MAX = 0.9\n+MIN_FRAME_H = 13\n+MIN_FRAME_W = 18\n+MAX_FRAME_DIM = 21