tch.shape, FRAME_COL, dtype=int)\n    try:\n        r, c = random_free_location(reserve, blocker, transparent=bg, padding=PATCH_PADDING)\n    except ValueError:\n        return False\n    paste(reserve, blocker, r, c)\n    paste(grid, patch, r, c, transparent=bg if transparent else None)\n    return True\n\n\ndef _make_pattern_tile(mask: np.ndarray, src: int, usable: list[int]) -> tuple[np.ndarray, str] | None:\n    \"\"\"Pick a visible two-color pattern tile that uses both colors on occupied sprite cells.\"\"\"\n    n = int(mask.shape[0])\n    color_pool = [c for c in usable if c != src]\n    if len(color_pool) < 2:\n        return None\n\n    def build(name: str, a: int, b: int) -> np.ndarray:\n        rr, cc = np.indices((n, n))\n        if name == \"checker\":\n            selector = (rr + cc) % 2\n        elif name == \"vertical\":\n            selector = cc % 2\n        elif name == \"horizontal\":\n            selector = rr % 2\n        else:\n            selector = ((rr // 2) + cc) % 2\n        return np.where(selector == 0, int(a), int(b)).astype(int)\n\n    tries = [(random.sample(color_pool, 2), random.sample(PATTERN_NAMES, len(PATTERN_NAMES))) for _ in range(10)]\n    for (a, b), names in tries:\n        for name in names:\n            tile = build(name, a, b)\n            if len(set(map(int, np.unique(tile[mask])))) >= 2:\n                return tile, name\n    return None\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    struct = _choose_structure()\n    if struct is None:\n        return None\n    n, rows, cols, empty_count, _ = struct\n\n    bg = random.choice([c for c in range(10) if c != FRAME_COL])\n    usable = [c for c in range(10) if c not in (bg, FRAME_COL)]\n\n    k = random.randint(*NUM_COLORS_RANGE)\n    src_cols = random.sample(usable, k)\n    masks = {src: _sprite_mask(n) for src in src_cols}\n\n    patterns: dict[int, np.ndarray] = {}\n    pattern_names: dict[int, str] = {}\n    for src in src_cols:\n        built = _make_pattern_tile(masks[src], src, usable)\n        if built is None:\n            return None\n        tile, name = built\n        patterns[src] = tile\n        pattern_names[src] = name\n\n    if len(set(pattern_names.values())) == 1 and k > 1 and random.random() < 0.7:\n        return None\n\n    ch, cw = _content_extent(n, rows, cols)\n    min_fh = max(MIN_FRAME_H, ch + 4)\n    min_fw = max(MIN_FRAME_W, cw + 4)\n    frame_h = random.randint(min_fh, min(MAX_FRAME_DIM, max(min_fh, ch + 2 + FRAME_MARGIN_SLACK)))\n    frame_w = random.randint(min_fw, min(MAX_FRAME_DIM, max(min_fw, cw + 2 + FRAME_MARGIN_SLACK)))\n    y_margin = frame_h - 2 - ch\n    x_margin = frame_w - 2 - cw\n    top_margin = random.randint(1, y_margin - 1)\n    left_margin = random.randint(1, x_margin - 1)\n\n    _, filled_slots = _choose_empty_slots(rows, cols, empty_count)\n    cell_colors = {}\n    for slot, col in zip(filled_slots[:k], src_cols):\n        cell_colors[slot] = col\n    for slot in filled_slots[k:]:\n        cell_colors[slot] = random.choice(src_cols)\n    if any(sum(1 for s in cell_colors.values() if s == src) >= 2 for src in src_cols):\n        pass\n    elif len(filled_slots) > k:\n        return None\n\n    input_frame = _make_bordered_frame(frame_h, frame_w, bg)\n    output_frame = _make_bordered_frame(frame_h, frame_w, bg)\n    for (rr, cc), src in cell_colors.items():\n        r0 = 1 + top_margin + rr * (n + 1)\n        c0 = 1 + left_margin + cc * (n + 1)\n        paste(input_frame, np.full((n, n), src, dtype=int), r0, c0)\n        paste(output_frame, _patterned_sprite(masks[src], patterns[src], bg), r0, c0, transparent=bg)\n\n    ext_area = k * (n * n + n * (n + 1) + 12)\n    possible_dims = [\n        (h, w)\n        for h in range(*CANVAS_H_RANGE)\n        for w in range(*CANVAS_W_RANGE)\n        if h >= frame_h and w >= frame_w and h * w - frame_h * frame_w >= ext_area\n    ]\n    if not possible_dims:\n        return None\n    h, w = random.choice(possible_dims)\n    grid = np.full((h, w), bg, dtype=int)\n    reserve = np.full((h, w), bg, dtype=int)\n\n    fr0 = random.choice([0, h - frame_h])\n    fc0 = random.choice([0, w - frame_w])\n    if h - frame_h > 2 and random.random() < FRAME_POS_JITTER_PROB:\n        fr0 = random.randrange(0, h - frame_h + 1)\n    if w - frame_w > 2 and random.random() < FRAME_POS_JITTER_PROB:\n        fc0 = random.randrange(0, w - frame_w + 1)\n    paste(grid, input_frame, fr0, fc0)\n    paste(reserve, np.full((frame_h, frame_w), FRAME_COL, dtype=int), fr0, fc0)\n\n    patches: list[tuple[np.ndarray, bool]] = []\n    for src in src_cols:\n        patches.append((_colored_sprite(masks[src], src, bg), True))\n        patches.append((_legend(src, patterns[src]), False))\n    random.shuffle(patches)\n    patches.sort(key=lambda item: item[0].size, reverse=True)\n    for patch, transparent in patches:\n        if not _place_patch(grid, reserve, patch, bg, transparent=transparent):\n            return None\n\n    try:\n        if not np.array_equal(main(grid), output_frame):\n            return None\n    except Exception:\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        out = _gen_attempt()\n        if out is not None:\n            return out\n    raise RuntimeError(\"failed to generate valid edb79dae D6 input\")\n\n            ```\n\n    ## 你的任务\n\n    1. **理解原代码**: 弄清 `main()` 和 `generate_input()` 的逻辑。\n\n    2. **阅读参考代码**（如有）: 上面列出的已有单变体代码是各组成项单独实现的版本，帮助你理解每项变更的实现方式。融合版本应综合参考但不能简单拼接。\n\n    3. **设计分析（写代码前必须完成）**:\n\n       综合「融合描述」和「各组成项详情」，将融合规则落实到代码层面。融合描述给出了整体的 input→output 规则，各组成项详情给出了每项改动的具体含义——两者结合才是完整的实现规格。如果上面提供了原始任务规格（Spec），请将其作为设计分析的重要参考——spec 详细描述了原始任务中各对象的结构、空间关系、生成策略等，理解这些细节有助于你准确判断融合改动的影响范围和实现方式。\n\n       a) **具体化与行为追踪**: 融合后的变体在 ARC 的像素网格中具体长什么样？用一个具体小例子追踪：原始逻辑在每个被改动的环节是怎么执行的 → 融合后应该怎么执行的 → 二者的差异是什么。\n\n       b) **复杂度校准**: 检查你的设计是否过于简化。过于简化会导致两个问题：一是容易产生冲突或重复（例如不同对象变得难以区分，匹配出现歧义），二是变体的视觉效果不明显，肉眼看不出和原任务的区别。同时不要让关键自由度过多；如果规则依赖少数档位、类别或对应关系，应控制在少量取值，并让它们在每个样例中有重复支撑。\n\n       c) **隐式假设审查**: 各组成项的改动可能破坏原代码中的哪些隐式假设？多项改动叠加后是否引入新的冲突？逐行检查 main() 中与变体相关的代码段：每行代码依赖了什么前提？这个前提在融合后是否仍然成立？\n\n       d) **放置合法性**: 生成器在放置对象时，必须保证各个体之间不重叠、不越界，且放置结果符合题意。\n\n       e) **视觉可观察性**: ARC 要求人类从 2-4 个 input→output 样例中肉眼推断规则。禁止使用任何人类不可视因素参与排序等操作（例如黑色=0，禁用）。做一次思想实验：假设你是解题者，看到几组变体生成的 input→output，能否看出融合后的规则？注意不要使用颜色值等人类不可视因素。如果变体的变化规律在2-3组像素网格上无法推出（例如对大量纯色对称对象做不同变换、无法从少量例子归纳颜色对应关系、不同情况的变换涉及正逆向旋转镜像等多种不同变化等，即全部的变化逻辑或者说是变化规律无法在3个输入输出示例对中体现），就需要调整设计使差异可观察。\n\n       f) **可视化整洁度**: 即使逻辑合理，如果可视化后的输出网格看上去乱七八糟也不行。检查：同一网格区域是否存在多种元素覆盖叠加导致无法分辨哪个是哪个？不同对象、区域、标记之间在视觉上是否能清晰区分？如果融合后的网格在视觉上杂乱不堪，需要调整设计（如减少同一区域的叠加层次、增大对象间距、简化标记方式等）。\n\n       g) **变化的可推断性**: 如果融合涉及颜色映射或颜色变化，务必确保颜色种类不宜过多，且颜色变化必须有足够的结构性线索（如位置、形状、分区等伴随特征）让人类能从少量样例中推断出颜色变化规则。避免出现大量颜色变化却无任何提示的情况——如果解题者无法从样例归纳出\"什么条件导致什么颜色\"，这个融合设计就\n\n       将以上分析写在代码注释中或输出中，然后再开始写代码。\n\n    4. **修改 `main()`**: 按照融合描述和各组成项详情实现新规则。确保各项改动在推理链中有真正的协同，不是各改各的。\n    5. **修改 `generate_input()`**: 确保生成的输入能正确触发融合后的新规则。\n    6. **保证 generator 的正确性**: 沿用 output-first 模式或适当调整，但必须保证每个输入经过新 `main()` 后不崩溃、不触发 assert、输出正确。\n    7. **测试**: 运行以下测试，确保成功率 ≥ 80%:\n\n    ```bash\n    /home/xd/miniconda3/bin/python -c \"\n    import numpy as np, importlib.util, time, sys\n    spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code_combo/edb79dae/25/code.py')\n    mod = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(mod)\n    ok, fail = 0, 0\n    t0 = time.time()\n    for i in range(50):\n        try:\n            inp = mod.generate_input()\n            out = mod.main(inp)\n            ok += 1\n        except Exception as e:\n            fail += 1\n            if fail <= 3: print(f'Trial {i}: {e}')\n    elapsed = time.time() - t0\n    print(f'Success: {ok}/50, Time: {elapsed:.1f}s ({elapsed/50*1000:.0f}ms/call)')\n    if ok < 40: sys.exit(1)\n    \"\n    ```\n\n    如果测试失败，分析错误原因，修改代码，重新测试。反复直到通过。\n\n    8. **验证融合行为确实发生**: `main(input)==output` 只能验证求解器不报错，无法验证输入是否真正体现了融合描述中的特征行为——退化为原始行为的输入同样能通过。测试通过后，定义一个量化指标衡量融合核心行为，统计生成样本中该指标的分布。只有当关键控制变量不起作用、样本按融合逻辑执行与按原逻辑执行在相同输入上输出相同结果时，才算退化并需要修正生成器。\n    9. **审查 `main()` 的新隐式假设**: 修改 `main()` 后，它可能对输入产生原始版本中不存在的新假设（如对象间需特定空间关系、匹配特征需可区分、处理顺序依赖前一步结果等）。逐一检查 `main()` 中的每个循环、匹配和条件分支：这段逻辑对输入做了什么假设？`generate_input()` 是否通过构造保证了这些假设？\n\n    ## 参考资源\n    - `/home/lixinyu/snap/new/solvers/arc_utils.py` — 可用的工具函数\n    - `/home/lixinyu/snap/new/ARC-data/ARC-AGI-2/data/evaluation/edb79dae.json` — 原任务的 I/O 样例\n\n    ## 输出\n\n    将完整的融合变体代码（包含修改后的 `main()` 和 `generate_input()`）保存到:\n    `/home/lixinyu/snap/new/ceshi/code_combo/edb79dae/25/code.py`\n\n    代码文件开头加一段注释说明这是什么融合变体:\n    ```python\n    # Combo variant of edb79dae (index 25)\n    # combo_spec: D11/3+D6/1\n    # Name: 多色框架编码+多色图案重着色\n    ```\n\n    如果原始代码的 `main()` 已有四段式说明注释/文档字符串，则新代码也必须在 `main()` 上方写出同结构的四部分说明：\n    1. 开头概述\n    2. `Input structure:`\n    3. `Rule:`\n    4. `Key insight:`\n\n    确保目录 `/home/lixinyu/snap/new/ceshi/code_combo/edb79dae/25` 存在（如不存在则创建）。\n\n    - `/home/lixinyu/snap/new/arc2_solver_select/a395ee82.py` — 参考任务 a395ee82 的 solver（D6/1 的灵感来源）\ncodex\n先检查原始 `edb79dae` solver、两个单变体参考实现和目标目录状态，然后基于 spec 写出融合版的设计分析，再落到 `main()` 和 `generate_input()`。\nexec\n/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/solvers/arc_utils.py\" in /home/lixinyu/snap/new\n succeeded in 0ms:\n\"\"\"\nARC unified helper library (single file, canonical APIs).\n\nThis module is the single shared helper surface that *all* solver examples should\nuse (ARC-2 and migrated ARC-1 seeds), so they can appear together in one prompt\nwithout API confusion.\n\n## Conventions (non-negotiable)\n- Grid shape: `grid.shape == (H, W)` meaning `(rows, cols)`.\n- Indexing: always `grid[r, c]`.\n- Coords: always `(r, c)`.\n- BBox: `(r0, c0, r1, c1)` inclusive.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport math\nimport random\nimport itertools\nimport warnings\nfrom collections import Counter\nfrom typing import Iterable, Iterator, Sequence\n\nimport numpy as np\nfrom scipy.ndimage import label\nfrom scipy import ndimage\n\n# =============================================================================\n# Colors\n# =============================================================================\n\n\nclass Color:\n    \"\"\"ARC palette color ids (ints, not Enum).\"\"\"\n\n    BLACK = 0\n    BLUE = 1\n    RED = 2\n    GREEN = 3\n    YELLOW = 4\n    GREY = 5\n    GRAY = 5\n    PINK = 6\n    ORANGE = 7\n    TEAL = 8\n    MAROON = 9\n\n    WHITE = 10  # debug / visualization\n    PAD = 11\n\n    BACKGROUND = 0\n\n    ALL_COLORS = [BLACK, BLUE, RED, GREEN, YELLOW, GREY, PINK, ORANGE, TEAL, MAROON]\n    NOT_BLACK = [BLUE, RED, GREEN, YELLOW, GREY, PINK, ORANGE, TEAL, MAROON]\n\n\nARC_RGB = np.array(\n    [\n        (0x00, 0x00, 0x00),  # 0 black\n        (0x00, 0x74, 0xD9),  # 1 blue\n        (0xFF, 0x41, 0x36),  # 2 red\n        (0x2E, 0xCC, 0x40),  # 3 green\n        (0xFF, 0xDC, 0x00),  # 4 yellow\n        (0xA0, 0xA0, 0xA0),  # 5 grey\n        (0xF0, 0x12, 0xBE),  # 6 magenta/pink\n        (0xFF, 0x85, 0x1B),  # 7 orange\n        (0x7F, 0xDB, 0xFF),  # 8 teal/azure\n        (0x87, 0x0C, 0x25),  # 9 maroon\n        (0xFF, 0xFF, 0xFF),  # 10 white\n        (0x00, 0x00, 0x00),  # 11 pad fallback\n    ],\n    dtype=np.uint8,\n)\n\n\n# =============================================================================\n# Types + basics\n# =============================================================================\n\nBBox = tuple[int, int, int, int]  # (r0,c0,r1,c1) inclusive\nCoord = tuple[int, int]  # (r,c)\n\n\ndef get_bg(grid: np.ndarray) -> int:\n    \"\"\"Background color = most common value in the grid.\"\"\"\n    return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])\n\n\ndef colors_present(grid: np.ndarray, *, exclude: Iterable[int] | None = None) -> list[int]:\n    \"\"\"\n    Return the sorted unique colors present in `grid`.\n\n    Args:\n        exclude: optional iterable of colors to exclude (e.g. `{bg}`)\n    \"\"\"\n    cols = set(map(int, grid.flatten()))\n    if exclude is not None:\n        cols -= set(map(int, exclude))\n    return sorted(cols)\n\n\ndef in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:\n    \"\"\"Return True iff (r,c) is within a grid of shape (H,W).\"\"\"\n    H, W = map(int, shape)\n    return 0 <= int(r) < H and 0 <= int(c) < W\n\n\ndef neighbors4(r: int, c: int) -> Iterator[Coord]:\n    \"\"\"4-neighborhood of (r,c).\"\"\"\n    r = int(r)\n    c = int(c)\n    yield r - 1, c\n    yield r + 1, c\n    yield r, c - 1\n    yield r, c + 1\n\n\ndef neighbors8(r: int, c: int) -> Iterator[Coord]:\n    \"\"\"8-neighborhood of (r,c).\"\"\"\n    r = int(r)\n    c = int(c)\n    for dr in (-1, 0, 1):\n        for dc in (-1, 0, 1):\n            if dr == 0 and dc == 0:\n                continue\n            yield r + dr, c + dc\n\n\n\n\n\n\n# =============================================================================\n# Scaling\n# =============================================================================\n\n\ndef scale_sprite(sprite: np.ndarray, factor: int) -> np.ndarray:\n    \"\"\"\n    Scale a sprite by an integer factor using nearest-neighbor replication.\n\n    Returns an array of shape (h*factor, w*factor).\n    \"\"\"\n    k = int(factor)\n    if k <= 0:\n        raise ValueError(\"scale_sprite: factor must be >= 1\")\n    return np.kron(sprite, np.ones((k, k), dtype=sprite.dtype))\n\n\n# =============================================================================\n# Internal helpers (for legacy keyword aliases during migration)\n# =============================================================================\n\n\ndef _consume_alias(kwargs: dict, primary: str, aliases: Sequence[str]):\n    \"\"\"\n    Consume a keyword argument by primary name or any alias, ensuring no conflicts.\n\n    Returns:\n        (value, used_name) or (None, None) if not found.\n    \"\"\"\n    used = None\n    if primary in kwargs:\n        used = primary\n    else:\n        for a in aliases:\n            if a in kwargs:\n                used = a\n                break\n    if used is None:\n        return None, None\n    val = kwargs.pop(used)\n    names = [primary, *aliases]\n    for n in names:\n        if n != used and n in kwargs:\n            raise TypeError(f\"got multiple values for {primary}: {used} and {n}\")\n    return val, used\n\n\n# =============================================================================\n# Masks / coords\n# =============================================================================\n\n\ndef coords_where(mask: np.ndarray) -> np.ndarray:\n    \"\"\"Return coords where mask is True as an (N,2) array of (r,c).\"\"\"\n    return np.argwhere(mask)\n\n\n\n\n# =============================================================================\n# BBox\n# =============================================================================\n\n\ndef bbox_coords(coords: np.ndarray) -> BBox:\n    \"\"\"BBox of an (N,2) coords array (r,c). Returns (r0,c0,r1,c1) inclusive.\"\"\"\n    r0, c0 = coords.min(axis=0)\n    r1, c1 = coords.max(axis=0)\n    return int(r0), int(c0), int(r1), int(c1)\n\n\ndef bbox(mask: np.ndarray) -> BBox | None:\n    \"\"\"\n    Bounding box (bbox) of a boolean mask.\n\n    Args:\n        mask: boolean array where True indicates foreground.\n\n    Returns:\n        (r0,c0,r1,c1) inclusive, or None if the mask has no True values.\n    \"\"\"\n    coords = np.argwhere(mask)\n    if coords.size == 0:\n        return None\n    return bbox_coords(coords)\n\n\ndef bbox_mask(mask: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Return a boolean mask that is True exactly inside the bbox of `mask`.\n\n    This corresponds to `bounding_box_mask(...)` in the legacy seeds API.\n    If `mask` is empty, returns an all-False mask.\n    \"\"\"\n    out = np.zeros_like(mask, dtype=bool)\n    b = bbox(mask)\n    if b is None:\n        return out\n    r0, c0, r1, c1 = b\n    out[int(r0) : int(r1) + 1,