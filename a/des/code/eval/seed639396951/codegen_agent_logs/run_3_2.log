            cols = [cc for _, cc in coords]
            comps.append(
                {
                    "color": color,
                    "coords": coords,
                    "r0": min(rows),
                    "r1": max(rows),
                    "c0": min(cols),
                    "c1": max(cols),
                    "size": len(coords),
                }
            )

    return comps


def _soil_strips(grid: np.ndarray) -> list[dict]:
