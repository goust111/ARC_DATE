+def _soil_strips(grid: np.ndarray) -> list[dict]:
+    h, w = map(int, grid.shape)
+    strips: list[dict] = []
+    for r in range(h):
+        c = 0
+        while c < w:
+            if int(grid[r, c]) != MAROON:
+                c += 1
+                continue
+            c0 = c
+            while c + 1 < w and int(grid[r, c + 1]) == MAROON:
+                c += 1
+            strips.append({"row": r, "c0": c0, "c1": c})
+            c += 1
+    return strips
