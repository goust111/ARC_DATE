+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+GREY = 5
+PALETTE = tuple(range(10))
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+GEN_RETRIES = 400
+PLACEMENT_RETRIES = 300
+CANVAS_MAX = 30
+PIECE_SIZES = (5, 7)
+DIMENSION_OPTIONS = (
+    (1, 3),
+    (1, 4),
+    (1, 5),
+    (2, 2),
+    (2, 3),
