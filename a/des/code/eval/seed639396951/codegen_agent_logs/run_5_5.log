+
+def _dimension_choices_for_side(side: int) -> list[tuple[int, int]]:
+    valid = []
+    for rows, cols in DIMENSION_OPTIONS:
+        h_needed = rows * max(0, cols - 1)
+        v_needed = max(0, rows - 1) * cols
