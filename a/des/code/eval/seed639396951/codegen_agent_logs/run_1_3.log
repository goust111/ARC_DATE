+        if active_count > 1 and len(set(chosen)) == 1:
+            chosen[0] = active[0]
+            chosen[-1] = active[1]
+    rng.shuffle(chosen)
+    return chosen
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    palette_height = rng.choice(PALETTE_HEIGHT_CHOICES)
+    room_rows, room_cols = rng.choice(LAYOUTS)
