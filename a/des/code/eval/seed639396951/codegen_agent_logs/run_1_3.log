+    (1, 2),
+    (1, 3),
+    (1, 4),
+    (2, 2),
+    (2, 3),
+    (2, 4),
+    (3, 2),
+    (3, 3),
+    (3, 4),
+)
+ROOM_HEIGHT_RANGE = (3, 6)
+ROOM_WIDTH_RANGE = (3, 6)
+PALETTE_HEIGHT_CHOICES = (2, 3)
