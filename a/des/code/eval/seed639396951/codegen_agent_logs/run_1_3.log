+                continue
+            seen[r, c] = True
+            queue = deque([(r, c)])
+            cells: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                cells.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            components.append(cells)
+    return components
