+        rows = [r for r, _ in component]
+        cols = [c for _, c in component]
+        r0 = wall_top + 1 + min(rows)
+        r1 = wall_top + 1 + max(rows)
+        c0 = min(cols)
+        c1 = max(cols)
+        room = g[r0 : r1 + 1, c0 : c1 + 1]
+        if room.size != len(component):
+            continue
