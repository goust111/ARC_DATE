+    reps_r = (height + texture.shape[0] - 1) // texture.shape[0]
+    reps_c = (width + texture.shape[1] - 1) // texture.shape[1]
+    tiled = np.tile(texture, (reps_r, reps_c))
+    return tiled[:height, :width]
+
+
