+        if texture is None:
+            continue
+
+        out[r0 : r1 + 1, c0 : c1 + 1] = _tile_texture(texture, room.shape[0], room.shape[1])
+        processed += 1
+
+    assert processed > 0, "expected at least one seed-marked room"
+    return out
+
+
+def _make_texture(
+    rng: random.Random,
+    index_color: int,
+    height: int,
+    existing: list[np.ndarray],
+) -> np.ndarray:
