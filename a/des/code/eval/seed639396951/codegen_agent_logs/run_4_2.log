+    if crossings:
+        if len(crossings) >= 2:
+            forced = [0, 1]
+            random.shuffle(forced)
+            for idx, choice_idx in zip(range(2), forced, strict=False):
+                row, col, h_color, v_color = crossings[idx]
+                grid[row, col] = int((h_color, v_color)[choice_idx])
