+            if all(cell not in occupied for cell in cells):
+                candidates.append(
+                    {
+                        "cells": cells,
+                        "placements": ((seed_a, "U"), (seed_b, "D")),
+                    }
+                )
+
+    return candidates
+
+
+def _manual_output(grid: np.ndarray, placements: list[dict[str, object]]) -> np.ndarray:
+    out = grid.copy()
