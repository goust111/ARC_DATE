+
+    if seen_kinds["edge"] == 0 or seen_kinds["pair"] == 0:
+        return None
+
+    directions = {str(item["direction"]) for item in placements}
+    if not (directions & {"U", "D"}) or not (directions & {"L", "R"}):
+        return None
