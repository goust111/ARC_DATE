+def _bands(length: int) -> list[tuple[int, int]]:
+    usable_lo = 1
+    usable_hi = length - 2
+    mid = (usable_lo + usable_hi) // 2
+    bands = [(usable_lo, mid - 1), (mid + 1, usable_hi)]
+    assert all(hi - lo + 1 >= 5 for lo, hi in bands)
+    return bands
