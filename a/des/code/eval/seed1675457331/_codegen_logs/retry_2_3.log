+def _paint_template(grid: np.ndarray, mask: np.ndarray, color: int, top_left: tuple[int, int]) -> None:
+    r0, c0 = top_left
+    for rr, cc in np.argwhere(mask):
+        grid[r0 + int(rr), c0 + int(cc)] = int(color)
+
