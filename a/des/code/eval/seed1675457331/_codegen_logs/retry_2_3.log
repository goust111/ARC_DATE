+
+def _symmetry_type(mask: np.ndarray) -> str:
+    horizontal = np.array_equal(mask, np.flipud(mask))
+    vertical = np.array_equal(mask, np.fliplr(mask))
+    if horizontal and vertical:
+        return "hv"
+    if horizontal:
+        return "h"
+    if vertical:
+        return "v"
+    return "none"
