+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 8
+SEPARATOR = 5
+MAROON = 9
+PALETTE = (1, 2, 3, 4, 6, 7)
+CATEGORIES = ("h", "v", "hv", "none")
+MAX_GENERATION_ATTEMPTS = 400
