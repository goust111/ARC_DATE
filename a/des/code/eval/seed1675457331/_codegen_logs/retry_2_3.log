+        assert (r1 - r0 + 1, c1 - c0 + 1) == (2, 2)
+        assert len(comp["cells"]) == 4
+        cells = {(int(rr), int(cc + sep_col + 1)) for rr, cc in comp["cells"]}
+        assert len(_adjacent_marker_colors(cells, markers)) == 1
