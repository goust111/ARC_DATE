+    cell_w = 7
+    dict_h = cell_h + 2
+    dict_w = n_templates * cell_w + n_templates + 1
+
+    top_h = rng.randint(9, 15)
+    grid_w = rng.randint(max(dict_w, 24), max(dict_w, 24) + 10)
+    grid_h = top_h + dict_h
