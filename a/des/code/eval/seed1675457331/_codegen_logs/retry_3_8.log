+    out = np.zeros((FRAME_HEIGHT, width), dtype=bool)
+    out[0, :] = True
+    out[SLOT_SIZE + 1, :] = True
+    out[-1, :] = True
+    out[:, :: (SLOT_SIZE + 1)] = True
+    return out
