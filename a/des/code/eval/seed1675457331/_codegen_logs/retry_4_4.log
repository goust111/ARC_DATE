+                )
+                placed = True
+                break
+            if not placed:
+                ok = False
+                break
+
+        if not ok:
+            continue
+
+        expected = _render_expected(inp, metas)
+        if not np.array_equal(main(inp), expected):
+            continue
+        return inp
+
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
