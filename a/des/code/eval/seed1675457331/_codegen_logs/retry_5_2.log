/bin/bash -lc "python - <<'PY'
import random
DIRS=['E','S','W','N']
VEC={'E':(0,1),'S':(1,0),'W':(0,-1),'N':(-1,0)}
left={'E':'N','N':'W','W':'S','S':'E'}
right={'E':'S','S':'W','W':'N','N':'E'}

def edge_cells(a,b):
    r0,c0=a; r1,c1=b
    dr=(r1>r0)-(r1<r0); dc=(c1>c0)-(c1<c0)
    n=max(abs(r1-r0),abs(c1-c0))
    return {(r0+dr*i,c0+dc*i) for i in range(n+1)}

def valid(seq, lens):
    pts=[(0,0)]
    r=c=0
    for d,l in zip(seq,lens):
        vr,vc=VEC[d]
        r+=vr*l; c+=vc*l
        pts.append((r,c))
    if pts[-1]"'!=(0,0):
        return False
    m=len(seq)
    edges=[edge_cells(pts[i],pts[i+1]) for i in range(m)]
    for i in range(m):
        for j in range(i+1,m):
            inter=edges[i]&edges[j]
            if j==i+1 or (i==0 and j==m-1):
                if len(inter)!=1:
                    return False
            else:
                if inter:
                    return False
    # degree-2 cell graph
    cells=set().union(*edges)
    for r,c in cells:
        deg=sum(((r+dr,c+dc) in cells) for dr,dc in VEC.values())
        if deg!=2:
            return False
    return True


def fill_exists(seq,lens):
    pts=[(0,0)]
    r=c=0
    for d,l in zip(seq,lens):
        vr,vc=VEC[d]
        r+=vr*l; c+=vc*l
        pts.append((r,c))
    cells=set()
    for i in range(len(seq)):
        cells|=edge_cells(pts[i],pts[i+1])
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    minr,maxr=min(rs)-1,max(rs)+1
    minc,maxc=min(cs)-1,max(cs)+1
    H=maxr-minr+1; W=maxc-minc+1
    import collections
    blocked={(r-minr,c-minc) for r,c in cells}
    q=collections.deque()
    seen=set()
    for r in range(H):
        for c in range(W):
            if r in (0,H-1) or c in (0,W-1):
                if (r,c) not in blocked and (r,c) not in seen:
                    seen.add((r,c)); q.append((r,c))
    while q:
        r,c=q.popleft()
        for dr,dc in VEC.values():
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and (nr,nc) not in blocked and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return any((r,c) not in blocked and (r,c) not in seen for r in range(H) for c in range(W))

patterns=set()
for m in [6,8,10]:
    k=m//2
    for _ in range(20000):
        d0=random.choice(DIRS)
        seq=[d0]
        for i in range(1,m):
            seq.append(random.choice([left[seq[-1]],right[seq[-1]]]))
        vis_parity=0
        lens=[]
        r=c=0
        for i,d in enumerate(seq[:-2]):
            lo,hi=(2,4) if i%2==vis_parity else (2,8)
            l=random.randint(lo,hi)
            lens.append(l)
            vr,vc=VEC[d]
            r+=vr*l; c+=vc*l
        rem_r, rem_c = -r,-c
        d1,d2=seq[-2],seq[-1]
        # solve for l1,l2
        (vr1,vc1),(vr2,vc2)=VEC[d1],VEC[d2]
        # because orthogonal, one contributes row one contributes col maybe sign
        l1=l2=None
        if vr1!=0 and vc2!=0 and rem_c%vc2==0 and rem_r%vr1==0:
            a=rem_r//vr1; b=rem_c//vc2
            l1,l2=a,b
        elif vc1!=0 and vr2!=0 and rem_c%vc1==0 and rem_r%vr2==0:
            a=rem_c//vc1; b=rem_r//vr2
            l1,l2=a,b
        else:
            continue
        if l1 is None:
            continue
        if l1<1 or l2<1:
            continue
        for idx,l in zip([m-2,m-1],[l1,l2]):
            lo,hi=(2,4) if idx%2==vis_parity else (2,8)
            if not (lo<=l<=hi):
                break
        else:
            lens2=lens+[l1,l2]
            if valid(seq,lens2) and fill_exists(seq,lens2):
                patterns.add((m,tuple(seq)))
    print('"'m',m,'patterns',len([p for p in patterns if p[0]==m]))
    shown=[]
    for mm,seq in sorted(patterns):
        if mm==m and seq not in shown:
            print(seq)
            shown.append(seq)
            if len(shown)>=12:
                break
