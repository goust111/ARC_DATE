  57:         patch = crop_bbox(g, (r0, c0, r1, c1))
  58: 
  59:         # Isolate this component exactly (bbox rectangle may include background).
  60:         rel_coords = [(int(r) - r0, int(c) - c0) for r, c in comp["coords"]]
  61:         m = mask_from_coords(rel_coords, patch.shape)
  62:         pat = np.full_like(patch, bg)
