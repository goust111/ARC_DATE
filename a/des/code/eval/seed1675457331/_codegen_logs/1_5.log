  75:     for p in pieces:
  76:         h, w = map(int, p["mask"].shape)
  77:         if h == w and int(p["mask"].sum()) == int(h * w):
  78:             k = int(h) if k is None else min(int(k), int(h))
  79:     k = int(k or 1)
  80: 
  81:     def downsample_blocks(mask: np.ndarray) -> np.ndarray | None:
  82:         hh, ww = mask.shape
  83:         if hh % k != 0 or ww % k != 0:
  84:             return None
