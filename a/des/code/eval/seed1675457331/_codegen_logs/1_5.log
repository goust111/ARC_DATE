  65:         extracted.append(
  66:             {
  67:                 "c0": int(c0),
  68:                 "pat": pat,
  69:                 "shape_key": canonical_shape_key(m),
  70:             }
  71:         )
  72: 
  73:     freq = Counter(d["shape_key"] for d in extracted)
  74:     out = np.full((H, W), int(bg), dtype=int)
