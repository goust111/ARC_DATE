+    min_h = max(GRID_H_RANGE[0], band_h + max_region_h + 4)
+    min_w = max(GRID_W_RANGE[0], template_width + 2, max_region_w + 4)
+    if min_h > GRID_H_RANGE[1] or min_w > GRID_W_RANGE[1]:
+        return None
+
+    grid_h = rng.randint(min_h, GRID_H_RANGE[1])
