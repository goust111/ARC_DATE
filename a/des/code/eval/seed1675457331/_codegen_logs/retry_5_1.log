+    if center_filled:
+        filled.add(center)
+    else:
+        filled.discard(center)
+
+    color_choices = [c for c in PALETTE if c not in blocked_colors]
+    palette = rng.sample(color_choices, rng.randint(1, min(3, len(color_choices))))
