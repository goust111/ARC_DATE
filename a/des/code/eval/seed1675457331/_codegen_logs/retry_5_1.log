+            seed_c = rng.randint(inner_c0 + sw // 2, inner_c1 - sw // 2)
+            grid[seed_r, seed_c] = int(spec["seed_color"])
+            _mark_bbox(occupied, r0, c0, outer_h, outer_w, pad=1)
