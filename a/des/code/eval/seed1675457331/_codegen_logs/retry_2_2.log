+def _interval_conflicts(interval: tuple[int, int], used: list[tuple[int, int, str]]) -> bool:
+    a, b = interval
+    for ua, ub, _kind in used:
+        if not (b < ua - 1 or a > ub + 1):
+            return True
+    return False
