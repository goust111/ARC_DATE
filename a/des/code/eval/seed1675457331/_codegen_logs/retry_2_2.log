+def _gen_attempt() -> np.ndarray | None:
+    profiles = [
+        ["same", "mixed"],
+        ["same", "endpoint"],
+        ["mixed", "endpoint"],
+        ["same", "mixed", "endpoint"],
+    ]
+    profile = random.choice(profiles)
+
+    try:
+        (h, w), path = _build_path()
+    except RuntimeError:
+        return None
+
+    layout = _marker_layout(path, h, w, profile)
+    if layout is None:
+        return None
+    markers, blocks = layout
+
+    grid = np.full((h, w), BLACK, dtype=int)
+    for r, c in path:
+        grid[r, c] = GREY
+    for _idx, color, (r, c) in markers:
+        grid[r, c] = color
+    for a, b, _kind in blocks:
+        for idx in range(a, b + 1):
+            r, c = path[idx]
+            grid[r, c] = MAROON
+
+    if not _validate_input(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate valid input after {MAX_RETRIES} attempts")

