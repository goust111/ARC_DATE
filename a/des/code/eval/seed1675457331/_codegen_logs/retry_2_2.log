+
+BLACK = 0
+GREY = 5
+MAROON = 9
+ORANGE = 7
+MARKER_POOL = [1, 2, 3, 4, 6, 8]
+
+MIN_SIZE = 12
+MAX_SIZE = 18
+MAX_RETRIES = 400
+
+
+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < h:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < w:
+        out.append((r, c + 1))
+    return out
+
+
+def _bg_color(grid: np.ndarray) -> int:
