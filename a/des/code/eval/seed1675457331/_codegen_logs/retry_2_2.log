+        out = main(g)
+        if np.any(out == GREY) or np.any(out == MAROON):
+            return False
+        return True
+    except AssertionError:
+        return False
+
+
+def _gen_attempt() -> np.ndarray | None:
+    profiles = [
+        ["same", "mixed"],
+        ["same", "endpoint"],
+        ["mixed", "endpoint"],
+        ["same", "mixed", "endpoint"],
+    ]
