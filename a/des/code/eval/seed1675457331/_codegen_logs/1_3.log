+    row_widths = []
+    row_gaps = []
+    for count in row_counts:
+        gaps = [random.randint(2, 4) for _ in range(max(0, count - 1))]
+        row_widths.append(count * frame_size + sum(gaps))
+        row_gaps.append(gaps)
+
+    max_row_width = max(row_widths)
