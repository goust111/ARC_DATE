+            return False
+        middle = patch[:, 2:-2]
+        row_sums = middle.sum(axis=1)
+        return sorted(map(int, row_sums)) == [0, middle.shape[1]]
+    if w == 2 and h >= 5:
+        if not np.all(patch[:2, :]) or not np.all(patch[-2:, :]):
+            return False
+        middle = patch[2:-2, :]
