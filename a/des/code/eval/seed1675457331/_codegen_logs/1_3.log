+def _gen_attempt() -> np.ndarray | None:
+    frame_size = random.randint(5, 7)
+    inner_size = frame_size - 2
+
+    n_sources = random.randint(1, 3)
+    n_targets = random.randint(max(2, n_sources), 5)
+    if n_sources + n_targets > 6:
