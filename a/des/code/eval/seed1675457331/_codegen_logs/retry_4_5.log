+    h, w = scene.shape
+    candidates: list[Rect] = []
+    for r0 in range(r0_vis + 1):
+        for r1 in range(r1_vis, h):
+            for c0 in range(c0_vis + 1):
+                for c1 in range(c1_vis, w):
+                    rect = (r0, c0, r1, c1)
+                    if _rect_sum(prefix, rect) == total_visible:
+                        candidates.append(rect)
