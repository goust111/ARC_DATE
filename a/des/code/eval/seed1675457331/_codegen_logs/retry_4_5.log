+    score = 0
+    score += int(visible[r0, c0 : c1 + 1].any())
+    score += int(visible[r1, c0 : c1 + 1].any())
+    score += int(visible[r0 : r1 + 1, c0].any())
+    score += int(visible[r0 : r1 + 1, c1].any())
