+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+BG = 0
+
+LEGEND_W = 2
+LEGEND_H = 2
+LEGEND_GAP = 1
+
+MIN_RECTS = 3
+MAX_RECTS = 5
+MIN_SIDE = 3
+MAX_SIDE = 7
+
+BOARD_H_MIN = 12
+BOARD_H_MAX = 19
+BOARD_W_MIN = 12
+BOARD_W_MAX = 17
+LEGEND_SEP_MIN = 1
+LEGEND_SEP_MAX = 3
+
+GEN_RETRIES = 400
+TOP_RETRIES = 80
+RECT_RETRIES = 120
