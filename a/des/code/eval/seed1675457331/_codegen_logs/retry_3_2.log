+                [
+                    {"direction": "down", "stop": False, "final": (h - 2, 0)},
+                    {"direction": "left", "stop": False, "final": (h - 2, 0)},
+                ]
+            )
+            remaining_dirs = ["up", "right"]
+        else:
+            specs.extend(
+                [
+                    {"direction": "down", "stop": False, "final": (h - 2, w - 2)},
+                    {"direction": "right", "stop": False, "final": (h - 2, w - 2)},
+                ]
+            )
