+                    {"direction": "up", "stop": False, "final": (0, 0)},
+                    {"direction": "left", "stop": False, "final": (0, 0)},
+                ]
+            )
+            remaining_dirs = ["right", "down"]
+        elif corner == "top_right":
+            specs.extend(
+                [
+                    {"direction": "up", "stop": False, "final": (0, w - 2)},
+                    {"direction": "right", "stop": False, "final": (0, w - 2)},
+                ]
+            )
