+def _boxes_overlap(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    ar, ac = a
+    br, bc = b
+    return not (ar + 1 < br or br + 1 < ar or ac + 1 < bc or bc + 1 < ac)
