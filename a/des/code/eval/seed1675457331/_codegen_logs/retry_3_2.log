+        if overlap_mode:
+            assert has_overlap
+        else:
+            assert not has_overlap
+        assert np.array_equal(out, main(grid))
+    except Exception:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
