+            placed = {
+                **spec,
+                "length": length,
+                "cargo_color": int(colors[2 * idx]),
+                "arrow_color": int(colors[2 * idx + 1]),
+                "cargo_cells": cargo,
+                "arrow_cells": arrow,
+            }
+            blocked |= _expand(cells, h, w)
+            placed_specs.append(placed)
