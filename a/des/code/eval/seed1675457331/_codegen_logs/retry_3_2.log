+def _wall_spans(grid: np.ndarray, wall_color: int) -> dict[str, set[int]]:
+    h, w = grid.shape
+    spans = {"top": set(), "bottom": set(), "left": set(), "right": set()}
+    for c in range(w):
+        if int(grid[0, c]) == wall_color:
