+        start_c = c0 - 1
+        arrow = {(shaft_row, start_c - k) for k in range(length)}
+        tip_c = start_c - length
+        arrow |= {(shaft_row - 1, tip_c), (shaft_row, tip_c), (shaft_row + 1, tip_c)}
+        return cargo, arrow
