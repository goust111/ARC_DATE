+def _wall_cells_for_edge(edge: str, start: int, length: int, h: int, w: int) -> set[tuple[int, int]]:
+    if edge == "top":
+        return {(0, c) for c in range(start, start + length)}
+    if edge == "bottom":
+        return {(h - 1, c) for c in range(start, start + length)}
+    if edge == "left":
