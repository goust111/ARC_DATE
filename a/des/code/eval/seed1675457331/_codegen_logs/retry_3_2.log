+
+DIR_VECS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+PALETTE = [0, 1, 2, 3, 4, 6, 7, 8, 9]
+WALL_COLOR = 5
+GEN_ATTEMPTS = 500
