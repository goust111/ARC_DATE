+    cur = seq[0]
+    length = 1
+    for value in seq[1:]:
+        if value == cur:
+            length += 1
+        else:
+            runs.append((cur, length))
+            cur = value
+            length = 1
+    runs.append((cur, length))
+    return runs
+
