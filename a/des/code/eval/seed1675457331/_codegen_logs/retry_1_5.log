+def _can_place(forbidden: np.ndarray, mask: np.ndarray, r0: int, c0: int) -> bool:
+    h, w = mask.shape
+    H, W = forbidden.shape
+    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
+        return False
+    return not bool(np.any(forbidden[r0 : r0 + h, c0 : c0 + w] & mask))
