+
+def _build_piece(tooth_side: str, length: int, teeth: tuple[int, ...], depth: int, color: int) -> tuple[np.ndarray, np.ndarray]:
+    if tooth_side in ("top", "bottom"):
+        mask = np.ones((depth + 1, length), dtype=bool)
