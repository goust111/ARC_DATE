+        return int(gap["row"] - 1), int(gap["col"])
+    if side == "left":
+        assert option["tooth_side"] == "right"
+        return int(gap["row"]), int(gap["col"] - (w - 2))
+    assert side == "right"
+    assert option["tooth_side"] == "left"
