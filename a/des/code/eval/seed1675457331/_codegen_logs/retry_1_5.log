+def _frame_mask(height: int, width: int, gaps: dict[str, dict]) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    mask[0:2, :] = True
+    mask[-2:, :] = True
+    mask[:, 0:2] = True
+    mask[:, -2:] = True
+
+    top = gaps["top"]
+    s = int(top["start"])
+    e = s + int(top["length"])
+    mask[0, s:e] = False
+    for t in top["teeth"]:
+        mask[1, s + int(t)] = False
+
+    bottom = gaps["bottom"]
+    s = int(bottom["start"])
+    e = s + int(bottom["length"])
+    mask[-1, s:e] = False
+    for t in bottom["teeth"]:
+        mask[-2, s + int(t)] = False
+
+    left = gaps["left"]
+    s = int(left["start"])
+    e = s + int(left["length"])
+    mask[s:e, 0] = False
+    for t in left["teeth"]:
+        mask[s + int(t), 1] = False
+
+    right = gaps["right"]
+    s = int(right["start"])
+    e = s + int(right["length"])
+    mask[s:e, -1] = False
+    for t in right["teeth"]:
+        mask[s + int(t), -2] = False
