+def _dilate_mask(mask: np.ndarray, radius: int = 1) -> np.ndarray:
+    out = mask.copy()
+    for _ in range(radius):
+        grown = out.copy()
+        grown[:-1, :] |= out[1:, :]
+        grown[1:, :] |= out[:-1, :]
+        grown[:, :-1] |= out[:, 1:]
+        grown[:, 1:] |= out[:, :-1]
+        grown[:-1, :-1] |= out[1:, 1:]
+        grown[:-1, 1:] |= out[1:, :-1]
+        grown[1:, :-1] |= out[:-1, 1:]
+        grown[1:, 1:] |= out[:-1, :-1]
