+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+ARROW_MASKS = {
+    "up": np.array([[0, 1, 0], [1, 1, 1], [1, 1, 1]], dtype=bool),
+    "down": np.array([[1, 1, 1], [1, 1, 1], [0, 1, 0]], dtype=bool),
+    "left": np.array([[0, 1, 1], [1, 1, 1], [0, 1, 1]], dtype=bool),
+    "right": np.array([[1, 1, 0], [1, 1, 1], [1, 1, 0]], dtype=bool),
+}
+
