+def _grow_chain(
+    rect: dict,
+    occupied: np.ndarray,
+    original_mask: np.ndarray | None = None,
+) -> tuple[list[tuple[int, int, int, int]], str, bool]:
+    occ = occupied.copy()
+    boxes: list[tuple[int, int, int, int]] = []
