+        r0 = axis_r - (h - 1) // 2
+        max_c0 = blocker["c0"] - w - 3
+        if r0 < 1 or r0 + h > grid_h - 1 or max_c0 < 1:
+            return None
+        c0 = rng.randint(max(1, max_c0 - 6), max_c0)
+        return r0, c0
+    if direction == "left":
+        axis_r = rng.randint(blocker["r0"], blocker["r0"] + blocker["h"] - 1)
+        r0 = axis_r - (h - 1) // 2
+        min_c0 = blocker["c0"] + blocker["w"] + 2
