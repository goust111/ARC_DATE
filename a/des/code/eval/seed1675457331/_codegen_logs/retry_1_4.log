+            clear = rng.randint(1, high)
+        c0 = clear if direction == "left" else grid_w - w - clear
+        return r0, c0
+
+    c0 = rng.randint(1, grid_w - w - 1)
+    max_clear = grid_h - h - 1
+    if max_clear < 1:
+        return None
+    if plan == "long":
+        low = max(4, max_clear // 2)
+        if low > max_clear:
+            return None
+        clear = rng.randint(low, max_clear)
+    else:
+        high = min(4, max_clear)
+        if high < 1:
