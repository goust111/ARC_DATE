+
+def _clear_region(mask: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int = 0) -> bool:
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(mask.shape[0], r0 + h + pad)
+    cc1 = min(mask.shape[1], c0 + w + pad)
+    return not bool(mask[rr0:rr1, cc0:cc1].any())
