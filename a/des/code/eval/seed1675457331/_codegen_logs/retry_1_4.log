+
+def _axis_rc(r0: int, c0: int, h: int, w: int) -> tuple[int, int]:
+    return r0 + (h - 1) // 2, c0 + (w - 1) // 2
+
+
+def _patch_origin(r0: int, c0: int, h: int, w: int) -> tuple[int, int]:
