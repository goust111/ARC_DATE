+            direction = name
+            break
+    if direction is None:
+        return None
+
+    if int(np.count_nonzero(window == MAROON)) != int(np.count_nonzero(maroon_mask)):
+        return None
+
+    colors = set(map(int, np.unique(window)))
+    colors.discard(MAROON)
