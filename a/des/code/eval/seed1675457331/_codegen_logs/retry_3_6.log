+def _find_windows(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    windows: list[dict] = []
+    for r in range(h - WINDOW_SIZE + 1):
+        for c in range(w - WINDOW_SIZE + 1):
