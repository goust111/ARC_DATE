+    if not (
+        np.all(patch[0, :] == color)
+        and np.all(patch[-1, :] == color)
+        and np.all(patch[:, 0] == color)
+        and np.all(patch[:, -1] == color)
+        and np.all(patch[3, :] == color)
+        and np.all(patch[:, 3] == color)
+    ):
+        return None
+
+    patch_colors = {int(v) for v in np.unique(patch)}
+    if patch_colors - {bg, color}:
+        return None
+
