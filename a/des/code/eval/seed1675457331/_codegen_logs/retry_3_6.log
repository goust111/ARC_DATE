+            rr = work_r0 + BLOCK_STEP * i
+            cc = work_c0 + BLOCK_STEP * j
+            color = int(row_win["color"])
+            if int(row_win["color"]) != int(col_win["color"]):
+                color = int(col_win["color"])
+            out[rr : rr + BLOCK_SIZE, cc : cc + BLOCK_SIZE] = color
+
+    return out
