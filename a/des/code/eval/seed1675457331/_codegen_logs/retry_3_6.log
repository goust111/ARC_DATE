+    for name, (rows, cols) in PANE_SLICES.items():
+        pane = patch[rows, cols]
+        values = np.unique(pane)
+        if values.size != 1:
+            return None
+        value = int(values[0])
+        if value not in (bg, color):
+            return None
+        panes[name] = value == bg
+
+    return {
+        "color": color,
+        "active": panes["tl"],
+        "sig": (panes["tr"], panes["bl"], panes["br"]),
+    }
+
+
+def _find_windows(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    windows: list[dict] = []
