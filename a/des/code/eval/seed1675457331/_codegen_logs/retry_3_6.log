+COUNT_CHOICES = (3, 4)
+MARGIN_RANGE = (0, 1)
+SMALL_GAP_RANGE = (1, 2)
+WORK_GAP_RANGE = (1, 3)
+EXTRA_PAD_RANGE = (0, 2)
+PALETTE_SIZE_RANGE = (3, 6)
