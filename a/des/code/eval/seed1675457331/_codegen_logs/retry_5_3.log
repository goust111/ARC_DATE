+    ] = []
+    for idx, prism1, diag_lists in split_candidates:
+        options: list[tuple[int, list[tuple[int, int]], list[list[tuple[int, int]]]]] = []
+        max_k = min(len(diag_cells) for diag_cells in diag_lists) - 1
+        for k in range(max_k + 1):
