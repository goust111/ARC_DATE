+    row_segments: list[tuple[int, int]] = []
+    cursor = 1
+    for size in row_heights:
+        row_segments.append((cursor, cursor + size))
+        cursor += size + 1
+
+    col_segments: list[tuple[int, int]] = []
+    cursor = 1
+    for size in col_widths:
+        col_segments.append((cursor, cursor + size))
