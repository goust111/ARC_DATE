+    total_w = inner_w + 2
+    r0 = h - total_h
+    c0 = w - total_w
+    legend_bbox = (r0, c0, h - 1, w - 1)
+
+    out = np.array(grid, copy=True)
+    out[r0 : h, c0 : w] = bg
+    out[r0, c0:w] = GREY
+    out[h - 1, c0:w] = GREY
+    out[r0:h, c0] = GREY
+    out[r0:h, w - 1] = GREY
+
+    for idx, area in enumerate(entries):
+        rr = r0 + 1 + idx
+        out[rr, c0 + 1 : c0 + 1 + area] = bar_color
+        out[rr, c0 + 1 + area] = fill_colors[idx]
