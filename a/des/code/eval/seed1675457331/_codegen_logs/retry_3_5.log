+    out_h = max(rect.shape[0] for _, rect in rendered)
+    out_w = sum(rect.shape[1] for _, rect in rendered) + max(0, len(rendered) - 1)
+    out = np.full((out_h, out_w), bg, dtype=int)
+    c = 0
+    for _, rect in rendered:
+        rh, rw = rect.shape
+        out[:rh, c : c + rw] = rect
+        c += rw + 1
+    return out
