from collections import deque

def conn(bits,h,w,val=True):
    pts=[(i//w,i%w) for i,b in enumerate(bits) if b==val]
    if not pts: return False
    q=deque([pts[0]]); seen={pts[0]}
    S=set(pts)
    while q:
