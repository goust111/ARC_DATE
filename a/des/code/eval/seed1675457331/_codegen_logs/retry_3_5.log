+    gh_max = max(gh_min, 3 * h + 7)
+    gw_min = max(16, pair_count * (w + 5) + 6)
+    gw_max = max(gw_min, 2 * pair_count * (w + 4) + 10)
+    gh = random.randint(gh_min, gh_max)
+    gw = random.randint(gw_min, gw_max)
