    return len(seen)==len(S)

def touches_all(bits,h,w,val=True):
    pts=[(i//w,i%w) for i,b in enumerate(bits) if b==val]
    rows={r for r,c in pts}; cols={c for r,c in pts}
    return 0 in rows and h-1 in rows and 0 in cols and w-1 in cols

def rect(bits,h,w,val=True):
    pts=[(i//w,i%w) for i,b in enumerate(bits) if b==val]
    r0=min(r for r,c in pts); r1=max(r for r,c in pts); c0=min(c for r,c in pts); c1=max(c for r,c in pts)
    return all(bits[r*w+c]==val for r in range(r0,r1+1) for c in range(c0,c1+1))

