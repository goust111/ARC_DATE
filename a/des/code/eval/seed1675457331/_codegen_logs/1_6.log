+        ir0, ic0, ir1, ic1 = inner_bbox_rel
+        inner_bbox = (r0 + 1 + ir0, c0 + 1 + ic0, r0 + 1 + ir1, c0 + 1 + ic1)
+        expected_next = (r0 + 2, c0 + 2, r1 - 2, c1 - 2)
