+    hole = grid[r0 + 1 : r1, c0 + 1 : c1]
+    mask = hole != BG
+    fill_bbox = _bbox_of_mask(mask)
+    if fill_bbox is None:
+        return None
+
+    fr0, fc0, fr1, fc1 = fill_bbox
+    block = hole[fr0 : fr1 + 1, fc0 : fc1 + 1]
+    color = int(block[0, 0])
