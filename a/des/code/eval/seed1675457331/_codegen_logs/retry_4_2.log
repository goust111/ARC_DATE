+    out = g.copy()
+    for piece in pieces:
+        out[piece["coords"][:, 0], piece["coords"][:, 1]] = bg
+
+    for piece_idx, (hole_idx, _rotation) in matches.items():
+        piece = pieces[piece_idx]
+        hole = holes[hole_idx]
+        r0, c0 = hole["top_left"]
+        region = out[r0 : r0 + hole["mask"].shape[0], c0 : c0 + hole["mask"].shape[1]]
+        region[hole["mask"]] = int(piece["color"])
+
+    return out
+
+
+def _shape(rows: list[str]) -> np.ndarray:
+    return np.array([[ch == "1" for ch in row] for row in rows], dtype=bool)
+
+
+SHAPE_LIBRARY = [
+    _shape(["11", "11"]),
+    _shape(["1111"]),
+    _shape(["111", "010"]),
+    _shape(["110", "011"]),
+    _shape(["10", "10", "11"]),
+    _shape(["11", "11", "10"]),
+    _shape(["010", "111", "010"]),
+    _shape(["101", "111"]),
+    _shape(["110", "011", "001"]),
+    _shape(["100", "111", "001"]),
+    _shape(["011", "110", "010"]),
+    _shape(["111", "001", "001"]),
+]
