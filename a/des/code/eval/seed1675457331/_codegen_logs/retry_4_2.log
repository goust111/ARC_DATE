+    return pieces
+
+
+def _match_piece_to_hole(piece: dict, hole: dict) -> list[int]:
+    options: list[int] = []
+    for k in range(4):
+        rotated_mask = np.rot90(piece["mask"], k)
+        if rotated_mask.shape != hole["mask"].shape:
+            continue
