+
+def _can_place_mask(reserve: np.ndarray, mask: np.ndarray, r0: int, c0: int) -> bool:
+    h, w = reserve.shape
+    mh, mw = mask.shape
+    if r0 < 0 or c0 < 0 or r0 + mh > h or c0 + mw > w:
+        return False
+    cells = np.argwhere(mask)
+    for dr, dc in cells:
+        if reserve[int(r0 + dr), int(c0 + dc)]:
+            return False
