+        reserve[max(0, tr0 - 1) : min(h, tr0 + th + 1), max(0, tc0 - 1) : min(w, tc0 + tw + 1)] = True
+        placements: list[tuple[int, int] | None] = [None] * len(masks)
+        ok = True
