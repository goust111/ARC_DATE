+        region = input_grid[pr0 : pr0 + mask.shape[0], pc0 : pc0 + mask.shape[1]]
+        region[mask] = int(color)
+        region[int(anchor[0]), int(anchor[1])] = MARKER_COLOR
+
+    return input_grid, output
+
