+def _boundary_cells(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    cells: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            for dr, dc in NEIGHBORS4:
+                nr, nc = r + dr, c + dc
+                if nr < 0 or nr >= h or nc < 0 or nc >= w or not mask[nr, nc]:
+                    cells.append((r, c))
+                    break
