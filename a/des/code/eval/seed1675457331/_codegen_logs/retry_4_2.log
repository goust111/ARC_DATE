+        assert len(marker_coords) == 1, "each hole must have one marker"
+        mask, (hr0, hc0) = _tight_mask(coords)
+        anchor = (
+            int(marker_coords[0, 0] - hr0),
+            int(marker_coords[0, 1] - hc0),
