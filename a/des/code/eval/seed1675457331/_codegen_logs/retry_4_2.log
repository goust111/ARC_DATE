+        placements: list[tuple[int, int] | None] = [None] * len(masks)
+        ok = True
+        for idx in order:
+            mask = masks[idx]
+            mh, mw = mask.shape
+            candidates = [
+                (r0, c0)
+                for r0 in range(1, template_h - mh)
+                for c0 in range(1, template_w - mw)
