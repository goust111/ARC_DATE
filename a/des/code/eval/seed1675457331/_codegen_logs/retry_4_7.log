+def _split_rows(items: list[np.ndarray], row_count: int, rng: random.Random) -> list[list[np.ndarray]]:
+    if row_count == 1:
+        return [items]
+    cuts = sorted(rng.sample(range(1, len(items)), row_count - 1))
+    rows = []
+    start = 0
+    for cut in cuts + [len(items)]:
