+        assert 0 <= tr and 0 <= tc
+        assert tr + sh <= out.shape[0] and tc + sw <= out.shape[1]
+        mask = flipped != bg
+        dest = out[tr : tr + sh, tc : tc + sw]
+        assert not np.any(mask & (dest != bg)), "reflected sprite must land on background"
+        dest[mask] = flipped[mask]
+
+    return out
