+    if candidates:
+        candidates.sort(key=lambda item: (item[0], item[1]), reverse=True)
+        return candidates[0][2]
+
+    rooms: list[dict[str, object]] = []
+    for color in colors:
+        for comp in _components(grid == color):
+            spec = _room_spec_from_component(grid, color, comp, bg)
+            if spec is not None:
