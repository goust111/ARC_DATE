+        for idx, piece in enumerate(pieces):
+            pr0, pc0, pr1, pc1 = piece["bbox"]  # type: ignore[misc]
+            if side in (0, 2):
+                if not _interval_overlap(lo, hi, int(pc0), int(pc1)):
+                    continue
+                dist = int(pr0) - (r0 + 1) if side == 0 else (r1 - 1) - int(pr1)
+            else:
