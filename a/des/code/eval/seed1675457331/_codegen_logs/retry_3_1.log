+    runs: list[tuple[int, int]] = []
+    start = positions[0]
+    prev = positions[0]
+    for pos in positions[1:]:
+        if pos == prev + 1:
+            prev = pos
+            continue
+        runs.append((start, prev))
+        start = pos
+        prev = pos
+    runs.append((start, prev))
+    return runs
