+def crop_mask_from_points(points: list[tuple[int, int]]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox_coords(points)
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in points:
+        out[r - r0, c - c0] = True
+    return out
