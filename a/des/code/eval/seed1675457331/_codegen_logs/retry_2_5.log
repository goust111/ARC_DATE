+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+MAROON = 9
+
+DEPTH_COLORS = (RED, BLUE, GREEN, MAROON)
+MAX_GENERATION_ATTEMPTS = 400
+MAX_GROUP_ATTEMPTS = 120
+MAX_PATTERN_ATTEMPTS = 100
