+        return pts, sprite
+    return None
+
+
+def _make_group(rng: random.Random) -> dict | None:
+    depth_count = _choose_depth_count(rng)
+    for _ in range(MAX_GROUP_ATTEMPTS):
+        boxes = _grow_boxes(depth_count, rng)
+        if boxes is None:
+            continue
+        h, w = bbox_shape(boxes[0])
+        grid = np.full((h, w), BLACK, dtype=int)
+        layers: list[dict] = []
