+            r0, c0, r1, c1 = bbox
+            grid[r0 : r1 + 1, c0 : c1 + 1][ring_mask((r1 - r0 + 1, c1 - c0 + 1))] = DEPTH_COLORS[depth - 1]
+        ok = True
+        for depth, bbox in enumerate(boxes, start=1):
