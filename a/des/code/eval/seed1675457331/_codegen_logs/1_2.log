+def _draw_container(
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    rng: random.Random,
+    direction: str,
+) -> bool:
+    h, w = grid.shape
+    for _ in range(PLACEMENT_RETRIES):
+        ih = rng.randint(*INTERIOR_H_RANGE)
+        iw = rng.randint(*INTERIOR_W_RANGE)
+        fh = ih + 2
+        fw = iw + 2
