+        r0, c0, r1, c1 = tower["bbox"]
+        cr, cc = tower["center"]
+        starts = [
+            ((r0, cc), "U"),
+            ((r1, cc), "D"),
+            ((cr, c0), "L"),
+            ((cr, c1), "R"),
+        ]
+        for (sr, sc), name in starts:
+            dr, dc = DIRS[name]
+            rr, cc2 = sr, sc
+            dist = 0
+            current = base_color
+            while True:
+                rr += dr
+                cc2 += dc
+                dist += 1
+                if int(g[rr, cc2]) == border:
+                    meta["border_stops"] += 1
+                    break
+                if tower_mask[rr, cc2]:
+                    meta["tower_stops"] += 1
+                    break
+                if table_mask[rr, cc2]:
+                    meta["table_stops"] += 1
+                    break
