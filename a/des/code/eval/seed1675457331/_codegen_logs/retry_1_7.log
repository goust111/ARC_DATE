+        "blocks": 0,
+        "border_stops": 0,
+        "tower_stops": 0,
+        "table_stops": 0,
+    }
+
+    def paint(rr: int, cc: int, color: int, dist: int) -> None:
+        visit_count[rr, cc] += 1
