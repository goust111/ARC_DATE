+            "U": (r0, cc),
+            "D": (r1, cc),
+            "L": (cr, c0),
+            "R": (cr, c1),
+        }
+        for name, (sr, sc) in starts.items():
+            dr, dc = DIRS[name]
+            rr, cc2 = sr, sc
