+    seen = np.zeros_like(g, dtype=bool)
+    tower_mask = np.zeros_like(g, dtype=bool)
+    towers: list[dict] = []
+    filters: dict[tuple[int, int], int] = {}
+
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if seen[r, c] or table_mask[r, c]:
+                continue
+            color = int(g[r, c])
+            if color in (BG, border):
