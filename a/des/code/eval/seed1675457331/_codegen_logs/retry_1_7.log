+
+
+def _solve(grid: np.ndarray, return_meta: bool = False):
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
+    border = int(g[0, 0])
+    assert np.all(g[0, :] == border)
+    assert np.all(g[h - 1, :] == border)
+    assert np.all(g[:, 0] == border)
+    assert np.all(g[:, w - 1] == border)
