+
+def _place_extra_dots(
+    region: np.ndarray,
+    sr: int,
+    sc: int,
+    nearest: Tuple[int, int],
+    used: set,
+    dot_palette: List[int],
+    extras_needed: int,
+) -> bool:
+    h, w = region.shape
+    center = (sr + 1, sc + 1)
+    nearest_color = int(region[nearest])
+    candidates = []
+    for r in range(h):
+        for c in range(w):
+            if (r, c) in used:
