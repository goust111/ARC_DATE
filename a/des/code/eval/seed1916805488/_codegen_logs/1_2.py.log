+def _cells_in_quadrant(h: int, w: int, cr: int, cc: int, corner: str) -> List[Tuple[int, int]]:
+    out = []
+    row_range = range(0, cr) if corner[0] == "t" else range(cr + 1, h)
+    col_range = range(0, cc) if corner[1] == "l" else range(cc + 1, w)
