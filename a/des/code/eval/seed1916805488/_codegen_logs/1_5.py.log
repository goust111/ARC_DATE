+def _valid_placement(cells: list[tuple[int, int]], occupied: set[tuple[int, int]], h: int, w: int) -> bool:
+    cell_set = set(cells)
+    for r, c in cells:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        if (r, c) in occupied:
+            return False
