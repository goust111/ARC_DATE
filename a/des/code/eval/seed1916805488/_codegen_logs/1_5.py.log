+        blocked_by_object = False
+        added = 0
+
+        if domino["orientation"] == "h":
+            row = int(domino["cells"][0][0])
+            left_c = min(c for _, c in domino["cells"])
+            right_c = max(c for _, c in domino["cells"])
+            rays = [((0, -1), (row, left_c - 1)), ((0, 1), (row, right_c + 1))]
+        else:
