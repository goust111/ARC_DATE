+    inner_w = frames[0][3] - frames[0][1] - 1
+    assert inner_h == inner_w
+    k = inner_h
+    assert all((r1 - r0 - 1 == k and c1 - c0 - 1 == k) for r0, c0, r1, c1 in frames)
