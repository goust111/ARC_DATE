+    frames = []
+    for _ in range(num_groups):
+        r0 = frame_y
+        c0 = frame_x
+        r1 = r0 + frame_h - 1
+        c1 = c0 + frame_w - 1
+        grid[r0, c0 : c1 + 1] = GREY
+        grid[r1, c0 : c1 + 1] = GREY
+        grid[r0 : r1 + 1, c0] = GREY
+        grid[r0 : r1 + 1, c1] = GREY
+        frames.append((r0, c0, r1, c1))
+        frame_y = r1 + 1 + frame_gap
