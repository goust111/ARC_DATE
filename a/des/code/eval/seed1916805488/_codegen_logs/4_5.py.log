+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+MAX_RETRIES = 400
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _find_components(mask: np.ndarray):
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells = []
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(cells)
+    return comps
+
+
+def _bbox(cells):
+    rs = [r for r, _ in cells]
+    cs = [c for _, c in cells]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _is_frame_component(cells, grid: np.ndarray) -> bool:
+    r0, c0, r1, c1 = _bbox(cells)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return False
+    expected = set()
+    for c in range(c0, c1 + 1):
+        expected.add((r0, c))
+        expected.add((r1, c))
+    for r in range(r0, r1 + 1):
+        expected.add((r, c0))
+        expected.add((r, c1))
+    comp = set(cells)
+    if comp != expected:
+        return False
+    interior = grid[r0 + 1 : r1, c0 + 1 : c1]
+    return not np.any(interior == GREY)
+
+
+def _extract_blocks(grid: np.ndarray, k: int):
+    mask = (grid != BLACK) & (grid != GREY)
+    comps = _find_components(mask)
+    blocks = []
+    for cells in comps:
+        r0, c0, r1, c1 = _bbox(cells)
+        if r1 - r0 + 1 > k or c1 - c0 + 1 > k:
+            continue
+        colors = {int(grid[r, c]) for r, c in cells}
+        if len(colors) != 1:
+            continue
+        sprite = np.zeros((k, k), dtype=int)
+        color = next(iter(colors))
+        for r, c in cells:
+            sprite[r - r0, c - c0] = 1
+        blocks.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "color": color,
+                "sprite": sprite,
+                "top": r0,
+            }
+        )
+    return blocks
+
+
+def _trace_neighbor(grid: np.ndarray, block, direction, block_index_by_cell):
+    r0, c0, r1, c1 = block["bbox"]
+    dr, dc = direction
+    candidates = []
+    if dr == -1:
+        for c in range(c0, c1 + 1):
+            if r0 - 1 >= 0 and grid[r0 - 1, c] == GREY:
+                candidates.append((r0 - 1, c))
+    elif dr == 1:
+        for c in range(c0, c1 + 1):
+            if r1 + 1 < grid.shape[0] and grid[r1 + 1, c] == GREY:
+                candidates.append((r1 + 1, c))
+    elif dc == -1:
+        for r in range(r0, r1 + 1):
+            if c0 - 1 >= 0 and grid[r, c0 - 1] == GREY:
+                candidates.append((r, c0 - 1))
+    else:
+        for r in range(r0, r1 + 1):
+            if c1 + 1 < grid.shape[1] and grid[r, c1 + 1] == GREY:
+                candidates.append((r, c1 + 1))
+    if not candidates:
+        return None
+    sr, sc = candidates[0]
+    cr, cc = sr, sc
+    h, w = grid.shape
+    while 0 <= cr < h and 0 <= cc < w and grid[cr, cc] == GREY:
+        cr += dr
+        cc += dc
+    if not (0 <= cr < h and 0 <= cc < w):
+        return None
