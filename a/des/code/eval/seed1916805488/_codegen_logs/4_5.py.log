+            j = _trace_neighbor(grid, block, direction, block_index_by_cell)
+            if j is None or j == i:
+                continue
+            adj[i].add(j)
+            adj[j].add(i)
+    return adj
+
+
+def _group_indices(adj):
+    seen = set()
+    groups = []
+    for i in range(len(adj)):
