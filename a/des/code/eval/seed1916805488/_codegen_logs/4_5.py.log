+    # Reject accidental grey structures that look like extra frames.
+    frame_like = []
+    for cells in _find_components(grid == GREY):
+        if _is_frame_component(cells, grid):
+            frame_like.append(_bbox(cells))
+    if sorted(frame_like) != sorted(frames):
