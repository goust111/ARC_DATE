+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MAROON = 9
+PALETTE_POOL = [1, 2, 3, 4, 6, 7, 8]
+POSITIONS = ("tl", "tr", "bl", "br")
+MAX_GEN_ATTEMPTS = 400
