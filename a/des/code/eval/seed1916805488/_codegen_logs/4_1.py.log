14: def main(grid: np.ndarray) -> np.ndarray:
15:     """
16:     Fit a grey bar into a grey frame by aligning projections with colored columns, then stack colors above.
17: 
18:     Input structure:
19:     - bg, a grey structural color forming two components: a large rectangular frame (slot) and a smaller bar with upward projections.
20:     - Colored pixels inside the slot mark target columns.
21: 
22:     Rule:
23:     - Move the bar upward into the slot so its bottom edge sits one cell above the slot's interior bottom.
24:     - Shift it horizontally so the bar's upward projections align column-wise with the colored pixels in the slot.
25:     - Stack the colored pixels immediately above the bar projections in each column.
26: 
27:     Key insight: The bar's projections act as keys that must align with the colored-column "locks" in the slot.
28:     """
29:     g = np.asarray(grid, dtype=int)
30:     h, w = g.shape
31: 
32:     # Background: most frequent. "Grey" structural color: most frequent non-bg.
33:     bg = _bg_color(g)
34:     other = g[g != bg]
35:     if other.size == 0:
36:         return g.copy()
37:     grey = _most_common(other)
