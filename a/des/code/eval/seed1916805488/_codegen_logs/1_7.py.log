            cells.append((r, c))
        if i < len(rows) - 1:
            target = int(rows[i + 1])
            step = 1 if target > r else -1
            while r != target:
                r += step
                cells.append((r, c))

    if c != W - 1:
        return None
    if not _contains(WALL_LENGTH_RANGE, len(cells)):
        return None
    return cells


