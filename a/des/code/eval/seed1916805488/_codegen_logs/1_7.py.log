        h2 = random.randint(middle_min, W - 3)
        h1 = random.randint(1, W - 1 - h2 - 1)
        horiz = [h1, h2, W - 1 - h1 - h2]

    r, c = int(rows[0]), 0
    cells = [(r, c)]
    for i, h_run in enumerate(horiz):
