+            arm_h = rng.randint(2, 4)
+            arm_c = left + rng.randint(0, w - arm_w)
+            if side == "top":
+                arm_r = top - arm_h
+            else:
+                arm_r = top + h
+            canvas[arm_r : arm_r + arm_h, arm_c : arm_c + arm_w] = True
+        else:
+            arm_h = rng.randint(max(2, h // 3), max(2, h - 1))
