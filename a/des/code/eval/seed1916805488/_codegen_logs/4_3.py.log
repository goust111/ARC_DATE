+            occ[top : top + outer_h, left : left + outer_w] = True
+            cur_c = left + 2
+            for color, mask in seeds.items():
+                sh, sw = mask.shape
+                sr = top + 2 + rng.randint(0, inner_h - 2 - sh)
+                for r in range(sh):
