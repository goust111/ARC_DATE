+        if not placed:
+            return None
+
+    regions = _enclosed_regions(grid)
+    if len(regions) != count:
+        return None
+    found_colors = {color for color, _cells, _size in regions}
+    if found_colors != set(colors):
+        return None
+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+    if np.array_equal(out, grid):
+        return None
+    return grid
