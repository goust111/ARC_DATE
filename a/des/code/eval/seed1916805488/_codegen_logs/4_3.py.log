+def _tile_fill(out: np.ndarray, region: set[tuple[int, int]], color: int, seed: np.ndarray):
+    rows = [r for r, _ in region]
+    cols = [c for _, c in region]
+    r0, c0, r1, c1 = min(rows), min(cols), max(rows), max(cols)
+    sh, sw = seed.shape
+    for ar in range(r0, r1 + 1):
