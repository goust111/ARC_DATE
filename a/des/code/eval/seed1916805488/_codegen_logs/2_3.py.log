+                    "top": r,
+                    "left": c,
+                    "body": int(vals[np.argmax(cnts)]),
+                    "signal": int(vals[np.argmin(cnts)]),
+                    "signal_rc": (r + sr, c + sc),
+                    "cells": {(r + dr, c + dc) for dr in range(2) for dc in range(2)},
