+            vals, cnts = np.unique(block, return_counts=True)
+            if len(vals) != 2 or sorted(map(int, cnts)) != [1, 3]:
+                continue
+            if int(vals[np.argmax(cnts)]) == bg:
+                continue
+            signal_idx = np.argwhere(block != int(vals[np.argmax(cnts)]))
+            sr, sc = map(int, signal_idx[0])
+            candidates.append(
