+        comps = _components(grid == color)
+        for pts in comps:
+            if len(pts) != 4:
+                continue
+            r0, c0 = pts.min(axis=0)
+            r1, c1 = pts.max(axis=0)
+            if (r1 - r0, c1 - c0) != (1, 1):
+                continue
+            cells = {(int(r), int(c)) for r, c in pts}
+            if cells != {(int(r0), int(c0)), (int(r0), int(c1)), (int(r1), int(c0)), (int(r1), int(c1))}:
