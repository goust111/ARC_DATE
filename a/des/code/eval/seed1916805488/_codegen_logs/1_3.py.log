+        if a[0] == b[0] == c[0] == d[0]:
+            r = b[0]
+            c0 = min(b[1], c[1])
+            for side in (-1, 1):
+                cells = {(r, c0), (r, c0 + 1), (r + side, c0), (r + side, c0 + 1)}
+                if all(_in_bounds(shape, rr, cc) for rr, cc in cells) and _slot_is_clear(
