+    if edge == "top":
+        pos = start
+        for color, width in zip(colors, widths):
+            grid[0, pos : pos + width] = color
+            pos += width
+    elif edge == "bottom":
+        pos = start
+        for color, width in zip(colors, widths):
+            grid[-1, pos : pos + width] = color
+            pos += width
+    elif edge == "left":
+        pos = start
+        for color, width in zip(colors, widths):
+            grid[pos : pos + width, 0] = color
+            pos += width
+    else:
+        pos = start
+        for color, width in zip(colors, widths):
+            grid[pos : pos + width, -1] = color
+            pos += width
+
