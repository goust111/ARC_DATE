+def _edge_runs(seq, bg: int):
+    runs = []
+    i = 0
+    n = len(seq)
+    while i < n:
+        if int(seq[i]) == bg:
+            i += 1
+            continue
+        color = int(seq[i])
+        j = i
+        while j < n and int(seq[j]) == color:
+            j += 1
+        runs.append((color, j - i, i, j))
+        i = j
+    return runs
+
