+    interior_h = rng.randint(*INTERIOR_H_RANGE)
+    interior_w = rng.randint(*INTERIOR_W_RANGE)
+    if interior_h + 2 >= h or interior_w + 2 >= w:
+        return None
+
+    row_min = 1
+    row_max = h - interior_h - 2
+    col_min = 1
+    col_max = w - interior_w - 2
+    if edge == "top":
+        row_min = 2
+    if edge == "bottom":
