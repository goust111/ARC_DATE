+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
