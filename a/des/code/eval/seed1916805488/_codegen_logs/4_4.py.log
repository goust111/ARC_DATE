+    gr, gc = gap
+    if gr == r0:
+        side = "top"
+        step = (1, 0)
+        if gc != (c0 + c1) // 2:
+            raise AssertionError("top gap must be centered")
+    elif gr == r1:
+        side = "bottom"
+        step = (-1, 0)
+        if gc != (c0 + c1) // 2:
+            raise AssertionError("bottom gap must be centered")
+    elif gc == c0:
+        side = "left"
+        step = (0, 1)
+        if gr != (r0 + r1) // 2:
+            raise AssertionError("left gap must be centered")
+    elif gc == c1:
+        side = "right"
+        step = (0, -1)
