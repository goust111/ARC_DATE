+    top: int,
+    left: int,
+    layers: int,
+    outer_h: int,
+    outer_w: int,
+    border_color: int,
+    directions: list[str],
+) -> None:
+    for k in range(layers):
+        r0 = top + 2 * k
+        c0 = left + 2 * k
+        r1 = top + outer_h - 1 - 2 * k
+        c1 = left + outer_w - 1 - 2 * k
+        grid[r0, c0 : c1 + 1] = border_color
+        grid[r1, c0 : c1 + 1] = border_color
+        grid[r0 : r1 + 1, c0] = border_color
+        grid[r0 : r1 + 1, c1] = border_color
+
