+        for idx, frame in enumerate(group):
+            ray_color = seq[(idx + 1) % len(seq)]
+            region = _ring_mask(work.shape, group, idx)
+            gr, gc = frame["gap"]
+            dr, dc = frame["ray_step"]
+            rr, cc = gr + dr, gc + dc
+            while 0 <= rr < h and 0 <= cc < w and region[rr, cc]:
