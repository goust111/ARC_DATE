+
+    min_h = max(spec["outer_h"] for spec in group_specs) + 5
+    min_w = sum(spec["outer_w"] for spec in group_specs) + 2 * n_groups + 4
+    h = random.randint(max(14, min_h), max(22, min_h + 4))
+    w = random.randint(max(16, min_w), max(28, min_w + 6))
