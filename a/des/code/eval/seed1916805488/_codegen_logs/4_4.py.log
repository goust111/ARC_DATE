+        if side == "top":
+            grid[r0, (c0 + c1) // 2] = BG
+        elif side == "bottom":
+            grid[r1, (c0 + c1) // 2] = BG
+        elif side == "left":
+            grid[(r0 + r1) // 2, c0] = BG
+        else:
+            grid[(r0 + r1) // 2, c1] = BG
+
+
+def _group_bbox(layers: int, outer_h: int, outer_w: int) -> tuple[int, int]:
+    min_needed = 4 * (layers - 1) + 3
+    assert outer_h >= min_needed and outer_w >= min_needed
+    return outer_h, outer_w
+
+
+def _try_place_groups(
