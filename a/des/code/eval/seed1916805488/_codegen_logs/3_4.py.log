+        kh, kw = km.shape
+        placed = False
+        for _ in range(200):
+            top = rng.randint(0, h - kh)
+            left = rng.randint(0, w - kw)
+            box = (top, left, top + kh - 1, left + kw - 1)
+            if any(_boxes_overlap(box, old, gap=1) for old in key_boxes):
