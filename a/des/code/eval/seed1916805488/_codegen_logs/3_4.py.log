+def _components(mask: np.ndarray) -> List[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: List[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    pts = np.argwhere(mask)
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _shape_variants(mask: np.ndarray) -> list[np.ndarray]:
+    variants: list[np.ndarray] = []
+    seen = set()
+    for k in range(4):
+        rot = np.rot90(mask, -k)
+        key = (rot.shape, rot.tobytes())
+        if key not in seen:
+            seen.add(key)
+            variants.append(rot)
+    return variants
+
+
+def _shape_signature(mask: np.ndarray) -> tuple:
+    variants = _shape_variants(mask)
+    keys = sorted((v.shape[0], v.shape[1], v.tobytes()) for v in variants)
+    return keys[0]
+
+
+def _generate_shape_pool() -> list[np.ndarray]:
+    pool: list[np.ndarray] = []
+    seen_classes = set()
+    for h in (1, 2):
+        for w in (2, 3, 4):
+            for bits in range(1, 1 << (h * w)):
+                mask = np.zeros((h, w), dtype=bool)
+                for idx in range(h * w):
+                    if (bits >> idx) & 1:
