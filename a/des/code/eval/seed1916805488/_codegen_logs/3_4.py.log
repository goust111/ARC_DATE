+        outer_w = inner_w + 2
+        max_lock_left = inner_w - sw
+        if max_lock_left < 0:
+            return None
+        if max_lock_left >= 2:
+            lock_left = rng.randint(1, max_lock_left)
+        else:
+            lock_left = rng.randint(0, max_lock_left)
+        rotations = rng.randrange(4)
+        key_mask = np.rot90(shape, rotations)
+        frame_specs.append(
+            {
+                "lockhole": shape.copy(),
+                "color": color,
+                "outer_h": outer_h,
+                "outer_w": outer_w,
+                "lock_left": lock_left,
+                "rotations": rotations,
+                "key_mask": key_mask,
+            }
+        )
+
+    min_h = max(18, sum(spec["outer_h"] for spec in frame_specs[:2]) // 2 + 8)
+    min_w = max(20, sum(spec["outer_w"] for spec in frame_specs[:2]) // 2 + 8)
+    h = rng.randint(min_h, 29)
+    w = rng.randint(min_w, 31)
