+import random
+from collections import deque
+from typing import List
+
+import numpy as np
+
+
+BG = 0
+FRAME = 7
+KEY_COLORS = [1, 2, 3, 4, 5, 6, 8, 9]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_GENERATION_ATTEMPTS = 300
+
+
+def _components(mask: np.ndarray) -> List[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: List[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    pts = np.argwhere(mask)
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _shape_variants(mask: np.ndarray) -> list[np.ndarray]:
+    variants: list[np.ndarray] = []
+    seen = set()
+    for k in range(4):
+        rot = np.rot90(mask, -k)
+        key = (rot.shape, rot.tobytes())
+        if key not in seen:
+            seen.add(key)
+            variants.append(rot)
+    return variants
+
+
+def _shape_signature(mask: np.ndarray) -> tuple:
+    variants = _shape_variants(mask)
+    keys = sorted((v.shape[0], v.shape[1], v.tobytes()) for v in variants)
+    return keys[0]
+
+
+def _generate_shape_pool() -> list[np.ndarray]:
+    pool: list[np.ndarray] = []
+    seen_classes = set()
+    for h in (1, 2):
+        for w in (2, 3, 4):
+            for bits in range(1, 1 << (h * w)):
+                mask = np.zeros((h, w), dtype=bool)
+                for idx in range(h * w):
+                    if (bits >> idx) & 1:
+                        mask[idx // w, idx % w] = True
+                if mask.sum() < 2:
+                    continue
+                if not mask[-1].any():
+                    continue
+                if len(_components(mask)) != 1:
+                    continue
+                variants = _shape_variants(mask)
+                if len(variants) != 4:
+                    continue
+                sig = _shape_signature(mask)
+                if sig in seen_classes:
+                    continue
+                seen_classes.add(sig)
+                pool.append(mask.copy())
+    pool.sort(key=lambda m: (m.shape[0] * m.shape[1], int(m.sum()), m.shape, m.tobytes()))
+    return pool
+
+
+SHAPE_POOL = _generate_shape_pool()
+
+
+def _draw_frame_with_lockhole(
+    canvas: np.ndarray,
+    top: int,
+    left: int,
+    outer_h: int,
+    outer_w: int,
+    lockhole: np.ndarray,
+    lock_left: int,
+) -> None:
+    bottom = top + outer_h - 1
+    right = left + outer_w - 1
+    canvas[top, left : right + 1] = FRAME
+    canvas[bottom, left : right + 1] = FRAME
+    canvas[top : bottom + 1, left] = FRAME
+    canvas[top : bottom + 1, right] = FRAME
+
+    h, w = lockhole.shape
+    notch_left = left + 1 + lock_left
+    cap_row = bottom - h
+    canvas[cap_row : bottom + 1, notch_left : notch_left + w] = FRAME
+    for rr in range(h):
+        for cc in range(w):
+            if lockhole[rr, cc]:
+                canvas[bottom - h + 1 + rr, notch_left + cc] = BG
+
+
+def _find_frames(grid: np.ndarray) -> list[dict]:
+    comps = _components(grid == FRAME)
+    frames = []
+    for pts in comps:
+        rs = [r for r, _ in pts]
+        cs = [c for _, c in pts]
+        r0, r1 = min(rs), max(rs)
+        c0, c1 = min(cs), max(cs)
+        if r1 - r0 + 1 < 5 or c1 - c0 + 1 < 5:
+            continue
+        if not np.all(grid[r0, c0 : c1 + 1] == FRAME):
+            continue
+        if not np.all(grid[r0 : r1 + 1, c0] == FRAME):
