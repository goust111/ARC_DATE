+    lockhole: np.ndarray,
+    lock_left: int,
+) -> None:
+    bottom = top + outer_h - 1
+    right = left + outer_w - 1
+    canvas[top, left : right + 1] = FRAME
+    canvas[bottom, left : right + 1] = FRAME
+    canvas[top : bottom + 1, left] = FRAME
+    canvas[top : bottom + 1, right] = FRAME
