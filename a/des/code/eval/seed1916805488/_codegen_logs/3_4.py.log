+import random
+from collections import deque
+from typing import List
+
+import numpy as np
+
+
+BG = 0
+FRAME = 7
+KEY_COLORS = [1, 2, 3, 4, 5, 6, 8, 9]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
