+    for k in range(4):
+        rot = np.rot90(mask, -k)
+        key = (rot.shape, rot.tobytes())
+        if key not in seen:
+            seen.add(key)
+            variants.append(rot)
+    return variants
+
+
+def _shape_signature(mask: np.ndarray) -> tuple:
+    variants = _shape_variants(mask)
+    keys = sorted((v.shape[0], v.shape[1], v.tobytes()) for v in variants)
+    return keys[0]
+
