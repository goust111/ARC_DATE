+    h, w = mask.shape
+    H, W = occ.shape
+    r0 = max(0, top - 1)
+    c0 = max(0, left - 1)
+    r1 = min(H, top + h + 1)
+    c1 = min(W, left + w + 1)
+    return bool(np.any(occ[r0:r1, c0:c1]))
