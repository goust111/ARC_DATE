@@ -0,0 +1,310 @@
+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _component_points(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    count = int(mask.sum())
+    if count == 0:
+        return False
+    return len(_component_points(mask)) == 1
+
+
+def _bbox_from_points(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in points]
+    cs = [c for _, c in points]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _extract_objects(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    objects: list[dict] = []
+    for color in sorted(int(v) for v in np.unique(g) if int(v) != 0):
+        comps = _component_points(g == color)
+        for pts in comps:
+            r0, c0, r1, c1 = _bbox_from_points(pts)
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for r, c in pts:
+                mask[r - r0, c - c0] = True
+            objects.append(
+                {
+                    "color": int(color),
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": mask,
+                }
+            )
+    return objects
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Pair same-bbox fragments by geometric complementarity, merge each pair into a
+    two-color solid rectangle, then pack the rectangles left-to-right in
+    ascending area order with one black separator column.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    objects = _extract_objects(g)
+    assert objects and len(objects) % 2 == 0
+
+    groups: dict[tuple[int, int], list[dict]] = defaultdict(list)
+    for obj in objects:
+        groups[obj["mask"].shape].append(obj)
+
+    pairs: list[dict] = []
+    for dims, group in groups.items():
+        h, w = dims
+        full = np.ones((h, w), dtype=bool)
+        waiting: dict[bytes, list[dict]] = defaultdict(list)
+        for obj in sorted(group, key=lambda item: item["bbox"]):
+            key = obj["mask"].tobytes()
+            comp_key = (~obj["mask"] & full).tobytes()
+            if waiting[comp_key]:
+                mate = waiting[comp_key].pop()
+                union = obj["mask"] | mate["mask"]
+                overlap = obj["mask"] & mate["mask"]
+                assert not overlap.any()
+                assert union.all()
+                pair_anchor = min(obj["bbox"][:2], mate["bbox"][:2])
+                pairs.append(
+                    {
+                        "dims": dims,
+                        "a": mate,
+                        "b": obj,
+                        "area": h * w,
+                        "anchor": pair_anchor,
+                    }
+                )
+            else:
+                waiting[key].append(obj)
+        assert all(not pending for pending in waiting.values())
+
+    assert len(pairs) * 2 == len(objects)
+    pairs.sort(key=lambda item: (item["area"], item["dims"][0], item["dims"][1], item["anchor"]))
+
+    out_h = max(item["dims"][0] for item in pairs)
+    out_w = sum(item["dims"][1] for item in pairs) + len(pairs) - 1
+    out = np.zeros((out_h, out_w), dtype=int)
+
+    c = 0
+    for item in pairs:
+        h, w = item["dims"]
+        a_mask = item["a"]["mask"]
+        b_mask = item["b"]["mask"]
+        out[:h, c : c + w][a_mask] = int(item["a"]["color"])
+        out[:h, c : c + w][b_mask] = int(item["b"]["color"])
+        c += w + 1
+    return out
+
+
+# --------------- generator ---------------
+
+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (18, 30)
+PAIR_COUNT_RANGE = (2, 4)
+BBOX_H_RANGE = (2, 6)
+BBOX_W_RANGE = (2, 7)
+PLACEMENT_PAD = 1
+GEN_RETRIES = 400
+PARTITION_RETRIES = 200
+PLACEMENT_RETRIES = 200
+
+
+def _randint(bounds: tuple[int, int]) -> int:
+    return random.randint(bounds[0], bounds[1])
+
+
+def _spans_bbox(mask: np.ndarray) -> bool:
+    return bool(
+        np.any(mask[0, :])
+        and np.any(mask[-1, :])
+        and np.any(mask[:, 0])
+        and np.any(mask[:, -1])
+    )
+
+
+def _random_manhattan_path(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = a
+    tr, tc = b
+    steps: list[tuple[int, int]] = []
+    while r != tr or c != tc:
+        options: list[tuple[int, int]] = []
+        if r < tr:
+            options.append((r + 1, c))
+        elif r > tr:
+            options.append((r - 1, c))
+        if c < tc:
+            options.append((r, c + 1))
+        elif c > tc:
+            options.append((r, c - 1))
+        r, c = random.choice(options)
+        steps.append((r, c))
+    return steps
+
+
+def _random_partition(h: int, w: int) -> np.ndarray | None:
+    area = h * w
+    for _ in range(PARTITION_RETRIES):
+        top = (0, random.randrange(w))
+        bottom = (h - 1, random.randrange(w))
+        left = (random.randrange(h), 0)
+        right = (random.randrange(h), w - 1)
+        anchors = [top, left, bottom, right]
+        chosen = {anchors[0]}
+        cur = anchors[0]
+        for nxt in anchors[1:]:
+            for cell in _random_manhattan_path(cur, nxt):
+                chosen.add(cell)
+            cur = nxt
+
+        target_hi = max(len(chosen), area - 2)
+        target = random.randint(len(chosen), max(len(chosen), min(area - 2, int(area * 0.65))))
+        frontier = set()
+        for cell in tuple(chosen):
+            for nxt in _neighbors4(*cell):
+                if 0 <= nxt[0] < h and 0 <= nxt[1] < w and nxt not in chosen:
+                    frontier.add(nxt)
+        while len(chosen) < target and frontier:
+            cell = random.choice(tuple(frontier))
+            frontier.remove(cell)
+            chosen.add(cell)
+            for nxt in _neighbors4(*cell):
+                if 0 <= nxt[0] < h and 0 <= nxt[1] < w and nxt not in chosen:
+                    frontier.add(nxt)
+
+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in chosen:
+            mask[r, c] = True
+        other = ~mask
+        if not _is_connected(other):
+            continue
+        if not _spans_bbox(mask) or not _spans_bbox(other):
+            continue
+        if np.any(mask.all(axis=0)) or np.any(mask.all(axis=1)):
+            continue
+        return mask
+    return None
+
+
+def _place_patch(grid: np.ndarray, occupied: np.ndarray, patch: np.ndarray) -> bool:
+    h, w = grid.shape
+    ph, pw = patch.shape
+    for _ in range(PLACEMENT_RETRIES):
+        r0 = random.randint(0, h - ph)
+        c0 = random.randint(0, w - pw)
+        rr0 = max(0, r0 - PLACEMENT_PAD)
+        cc0 = max(0, c0 - PLACEMENT_PAD)
+        rr1 = min(h, r0 + ph + PLACEMENT_PAD)
+        cc1 = min(w, c0 + pw + PLACEMENT_PAD)
+        if occupied[rr0:rr1, cc0:cc1].any():
+            continue
+        mask = patch != 0
+        if not mask.any():
+            continue
+        grid[r0 : r0 + ph, c0 : c0 + pw][mask] = patch[mask]
+        occupied[r0 : r0 + ph, c0 : c0 + pw] |= mask
+        return True
+    return False
+
+
+def _build_patch(mask: np.ndarray, color: int) -> np.ndarray:
+    patch = np.zeros(mask.shape, dtype=int)
+    patch[mask] = int(color)
+    return patch
+
+
+def _sample_dims(n_pairs: int) -> list[tuple[int, int]] | None:
+    candidates = [
+        (h, w)
+        for h in range(BBOX_H_RANGE[0], BBOX_H_RANGE[1] + 1)
+        for w in range(BBOX_W_RANGE[0], BBOX_W_RANGE[1] + 1)
+        if h * w >= 4
+    ]
+    random.shuffle(candidates)
+    dims: list[tuple[int, int]] = []
+    used_areas: set[int] = set()
+    for h, w in candidates:
+        # Prefer unique areas so output ordering is visually unambiguous.
+        if h * w in used_areas and random.random() < 0.8:
+            continue
+        dims.append((h, w))
+        used_areas.add(h * w)
+        if len(dims) == n_pairs:
+            return dims
+    return None
+
+
+def _generate_one() -> np.ndarray | None:
+    n_pairs = _randint(PAIR_COUNT_RANGE)
+    dims = _sample_dims(n_pairs)
+    if dims is None:
+        return None
+
+    needed_colors = 2 * n_pairs
+    colors = random.sample(list(range(1, 10)), needed_colors)
+    H = _randint(GRID_H_RANGE)
+    W = _randint(GRID_W_RANGE)
+    grid = np.zeros((H, W), dtype=int)
+    occupied = np.zeros((H, W), dtype=bool)
+
+    pieces: list[np.ndarray] = []
+    for i, (h, w) in enumerate(dims):
+        mask = _random_partition(h, w)
+        if mask is None:
+            return None
+        pieces.append(_build_patch(mask, colors[2 * i]))
+        pieces.append(_build_patch(~mask, colors[2 * i + 1]))
+
+    random.shuffle(pieces)
+    for patch in pieces:
+        if not _place_patch(grid, occupied, patch):
+            return None
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    if out.size == 0 or np.count_nonzero(grid) == 0:
+        return None
+    if len(_extract_objects(grid)) != 2 * n_pairs:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _generate_one()
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate a valid input after {GEN_RETRIES} attempts")

