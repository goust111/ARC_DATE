+        bottom = (h - 1, random.randrange(w))
+        left = (random.randrange(h), 0)
+        right = (random.randrange(h), w - 1)
+        anchors = [top, left, bottom, right]
+        chosen = {anchors[0]}
+        cur = anchors[0]
+        for nxt in anchors[1:]:
