+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (18, 30)
+PAIR_COUNT_RANGE = (2, 4)
+BBOX_H_RANGE = (2, 6)
+BBOX_W_RANGE = (2, 7)
