+def _shape_templates(side: int) -> list[set[tuple[int, int]]]:
+    m = side // 2
+    return [
+        {(m, m)},
+        {(m - 1, m), (m, m), (m + 1, m)},
+        {(m, m - 1), (m, m), (m, m + 1)},
+        {(m - 1, m), (m, m - 1), (m, m), (m, m + 1), (m + 1, m)},
+        {(m - 1, m - 1), (m - 1, m), (m, m - 1), (m, m)},
+        {(m - 1, m - 1), (m, m), (m + 1, m + 1)},
+        {(m - 1, m + 1), (m, m), (m + 1, m - 1)},
+        {(m - 1, m - 1), (m, m - 1), (m + 1, m - 1), (m + 1, m), (m + 1, m + 1)},
+    ]
