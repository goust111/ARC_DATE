+    region[patch != BLACK] = patch[patch != BLACK]
+
+
+def _place_arrow(g: np.ndarray, src: tuple[int, int], dst: tuple[int, int], cell_size: int) -> None:
+    sr, sc = src
+    dr, dc = dst
+    r0, c0 = _cell_origin(src, cell_size)
