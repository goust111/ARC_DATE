+
+
+def _neighbors(cell: tuple[int, int], board_h: int, board_w: int) -> list[tuple[int, int]]:
+    rr, cc = cell
+    out = []
+    for dr, dc in DIRS.values():
+        nr, nc = rr + dr, cc + dc
+        if 0 <= nr < board_h and 0 <= nc < board_w:
+            out.append((nr, nc))
