+    starts = [cell for cell in occupied if indeg[cell] == 0]
+    assert starts
+
+    for start in starts:
+        if start in seen:
+            continue
+        chain: list[tuple[int, int]] = []
+        cur = start
+        local_seen: set[tuple[int, int]] = set()
+        while True:
+            assert cur not in local_seen
+            local_seen.add(cur)
+            seen.add(cur)
+            chain.append(cur)
+            if cur not in outgoing:
