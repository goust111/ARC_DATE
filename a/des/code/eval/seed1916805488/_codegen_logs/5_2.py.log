+import random
+from collections import Counter
+
+import numpy as np
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.asarray(pts, dtype=int))
+    return comps
+
+
+def _label_components(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    labels = np.zeros((h, w), dtype=int)
+    label = 0
+    for comp in _components(mask):
+        label += 1
+        labels[tuple(comp.T)] = label
+    return labels
+
+
+def _find_doors(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    doors: list[dict] = []
+    seen = set()
+
+    for r in range(1, h - 1):
+        for c in range(w - 3):
+            col = int(g[r, c])
+            if col == bg or int(g[r, c + 3]) != col:
+                continue
+            if int(g[r, c + 1]) != bg or int(g[r, c + 2]) != bg:
+                continue
+            if not (((g[r - 1, c + 1] != bg) or (g[r + 1, c + 1] != bg)) and ((g[r - 1, c + 2] != bg) or (g[r + 1, c + 2] != bg))):
+                continue
+            key = ("h", r, c)
+            if key not in seen:
+                seen.add(key)
+                doors.append(
+                    {
+                        "orientation": "h",
+                        "line": r,
+                        "start": c,
+                        "color": col,
+                        "frames": [(r, c), (r, c + 3)],
+                        "gap": [(r, c + 1), (r, c + 2)],
+                    }
+                )
+
+    for r in range(h - 3):
+        for c in range(1, w - 1):
+            col = int(g[r, c])
+            if col == bg or int(g[r + 3, c]) != col:
+                continue
+            if int(g[r + 1, c]) != bg or int(g[r + 2, c]) != bg:
+                continue
+            if not (((g[r + 1, c - 1] != bg) or (g[r + 1, c + 1] != bg)) and ((g[r + 2, c - 1] != bg) or (g[r + 2, c + 1] != bg))):
+                continue
+            key = ("v", r, c)
+            if key not in seen:
+                seen.add(key)
+                doors.append(
+                    {
+                        "orientation": "v",
+                        "line": c,
+                        "start": r,
+                        "color": col,
+                        "frames": [(r, c), (r + 3, c)],
+                        "gap": [(r + 1, c), (r + 2, c)],
+                    }
+                )
+
+    return doors
+
+
+def _room_masks(passable: np.ndarray, door: dict) -> tuple[np.ndarray, np.ndarray] | None:
+    blocked = passable.copy()
+    for r, c in door["gap"]:
+        blocked[r, c] = False
+    labels = _label_components(blocked)
+
+    side_a = []
+    side_b = []
+    if door["orientation"] == "h":
+        r = door["line"]
+        c0 = door["start"] + 1
+        for c in (c0, c0 + 1):
+            if r - 1 >= 0 and blocked[r - 1, c]:
+                side_a.append((r - 1, c))
+            if r + 1 < blocked.shape[0] and blocked[r + 1, c]:
+                side_b.append((r + 1, c))
+    else:
+        c = door["line"]
+        r0 = door["start"] + 1
+        for r in (r0, r0 + 1):
+            if c - 1 >= 0 and blocked[r, c - 1]:
+                side_a.append((r, c - 1))
+            if c + 1 < blocked.shape[1] and blocked[r, c + 1]:
+                side_b.append((r, c + 1))
+
+    if not side_a or not side_b:
+        return None
+    id_a = int(labels[side_a[0]])
+    id_b = int(labels[side_b[0]])
+    if id_a == 0 or id_b == 0 or id_a == id_b:
+        return None
+    return labels == id_a, labels == id_b
+
