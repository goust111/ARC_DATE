+                "line": wall_col,
+                "start": start,
+                "color": color,
+                "rooms": ((i, j), (i, j + 1)),
+                "frames": [(start, wall_col), (start + 3, wall_col)],
+                "gap": [(start + 1, wall_col), (start + 2, wall_col)],
