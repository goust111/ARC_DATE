+    passable = (g != wall) & (~door_mask)
+    pattern_mask = (g != bg) & (g != wall) & (~door_mask)
+    out = g.copy()
+
+    for door in doors:
+        room_pair = _room_masks(passable, door)
+        if room_pair is None:
+            continue
