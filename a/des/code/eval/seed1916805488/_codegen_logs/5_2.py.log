+    wall_candidates = [int(g[r, c]) for r in range(g.shape[0]) for c in range(g.shape[1]) if int(g[r, c]) != bg and not door_mask[r, c]]
+    if not wall_candidates:
+        return g.copy()
+    wall = Counter(wall_candidates).most_common(1)[0][0]
