+def _tower_cells(side: str, anchor: int, antenna_len: int, h: int, w: int) -> tuple[list[tuple[int, int]], tuple[int, int], tuple[int, int]]:
+    if side == "top":
+        cells = [(r, c) for r in range(3) for c in range(anchor - 1, anchor + 2)]
