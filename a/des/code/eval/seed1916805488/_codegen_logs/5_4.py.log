+                    pos = b
+                    dr = b[0] - a[0]
+                    dc = b[1] - a[1]
+                else:
+                    pos = a
+                    dr = a[0] - b[0]
+                    dc = a[1] - b[1]
+                color = int(relay["color"])
+                continue
