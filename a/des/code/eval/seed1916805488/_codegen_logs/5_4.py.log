+def _receiver_cells(hit: tuple[int, int], d: tuple[int, int], side: int) -> list[tuple[int, int]]:
+    r, c = hit
+    if d == (1, 0):
+        c0 = c - side
+        return [(r, c0), (r, c0 + 1), (r + 1, c0), (r + 1, c0 + 1)]
+    if d == (-1, 0):
