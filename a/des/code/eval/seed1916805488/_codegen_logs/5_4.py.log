+def _add(p: tuple[int, int], d: tuple[int, int], k: int = 1) -> tuple[int, int]:
+    return p[0] + d[0] * k, p[1] + d[1] * k
+
+
+def _perpendiculars(d: tuple[int, int]) -> list[tuple[int, int]]:
+    dr, dc = d
+    return [(-dc, dr), (dc, -dr)]
