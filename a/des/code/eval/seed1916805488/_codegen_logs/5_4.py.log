+import numpy as np
+
+
+GEN_RETRIES = 400
+GRID_H_RANGE = (24, 33)
+GRID_W_RANGE = (24, 33)
+GRAY = 5
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
