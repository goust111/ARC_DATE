+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+
+
+def _parse_legend_row(grid: np.ndarray) -> tuple[int, list[tuple[int, int, int]]]:
+    h, w = grid.shape
+    best: tuple[int, list[tuple[int, int, int]]] | None = None
+
