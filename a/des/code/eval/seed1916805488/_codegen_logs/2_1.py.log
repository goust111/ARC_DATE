+    gap: tuple[int, int] | None = None
+    for c in range(left + 1, right):
+        if grid[top, c] == BG:
+            assert gap is None
+            gap = (top, c)
+        if grid[bottom, c] == BG:
+            assert gap is None
+            gap = (bottom, c)
+    for r in range(top + 1, bottom):
+        if grid[r, left] == BG:
+            assert gap is None
+            gap = (r, left)
+        if grid[r, right] == BG:
+            assert gap is None
+            gap = (r, right)
+    assert gap is not None, "rectangle border must contain one gap"
+    return gap
+
