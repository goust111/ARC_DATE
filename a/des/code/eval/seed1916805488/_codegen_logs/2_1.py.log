+def _path_cells(seed: tuple[int, int], direction: tuple[int, int], shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    dr, dc = direction
+    rr, cc = seed
+    cells: list[tuple[int, int]] = []
+    while True:
