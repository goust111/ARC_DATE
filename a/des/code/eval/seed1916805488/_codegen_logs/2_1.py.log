+        left_dist = sc - left
+        right_dist = right - sc
+        assert left_dist != right_dist, "horizontal marker must imply a unique nearer side"
+        if left_dist < right_dist:
+            return (0, -1), (sr, left)
+        return (0, 1), (sr, right)
