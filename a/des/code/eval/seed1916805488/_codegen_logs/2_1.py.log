+    assert best is not None, f"no valid rectangle found for seed {seed}"
+    return best
+
+
+def _window_direction(
+    seed: tuple[int, int],
+    axis: str,
+    top: int,
+    left: int,
+    bottom: int,
+    right: int,
+) -> tuple[tuple[int, int], tuple[int, int]]:
+    sr, sc = seed
