+        cells.append((top, c))
+        cells.append((bottom, c))
+    for r in range(top + 1, bottom):
+        cells.append((r, left))
+        cells.append((r, right))
+    return cells
+
+
+def _draw_region(
+    grid: np.ndarray,
+    color: int,
+    top: int,
+    left: int,
+    bottom: int,
+    right: int,
+    seed: tuple[int, int],
+    gap: tuple[int, int],
