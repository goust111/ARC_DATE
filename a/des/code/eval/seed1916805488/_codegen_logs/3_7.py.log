+        carve_placed = None
+        if carve_mask is not None:
+            rs, cs = _paste_centered(rect["bbox"], carve_mask)
+            carve_placed = np.zeros((rs.stop - rs.start, cs.stop - cs.start), dtype=bool)
+            carve_placed |= carve_mask
+            out[rs, cs][carve_mask] = bg
