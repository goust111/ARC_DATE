+
+
+def _marker_modes() -> tuple[int, int]:
+    mode = random.choice(["grey_only", "black_only", "mixed"])
+    if mode == "grey_only":
+        return random.randint(2, 4), 0
+    if mode == "black_only":
+        return 0, random.randint(2, 4)
