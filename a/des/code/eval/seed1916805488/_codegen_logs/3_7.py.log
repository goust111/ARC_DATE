+def _valid_sample(grid: np.ndarray) -> bool:
+    try:
+        out = main(grid)
+    except Exception:
+        return False
+    if np.array_equal(out, grid):
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        h = random.randint(GRID_MIN, GRID_MAX)
+        w = random.randint(GRID_MIN, GRID_MAX)
