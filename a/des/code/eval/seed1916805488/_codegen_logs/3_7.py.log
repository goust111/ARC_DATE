+        for _ in range(200):
+            rh = random.randint(*RECT_SIDE_RANGE)
+            rw = random.randint(*RECT_SIDE_RANGE)
+            r0 = random.randint(1, h - rh - 2)
+            c0 = random.randint(1, w - rw - 2)
+            bbox = (r0, c0, r0 + rh - 1, c0 + rw - 1)
