+        if print_mask is not None:
+            rs, cs = _paste_centered(rect["bbox"], print_mask)
+            paintable = print_mask.copy()
+            if carve_placed is not None and carve_placed.shape == paintable.shape:
+                paintable &= ~carve_placed
