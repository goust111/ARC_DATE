+import random
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+ORANGE = 7
+MARKER_COLORS = [1, 2, 3, 4, 6, 8, 9]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRIES = 400
