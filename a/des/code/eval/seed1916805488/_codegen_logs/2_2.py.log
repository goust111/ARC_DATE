+    patch[mr, mc] = marker_color
+    return patch
+
+
+def _bbox_from_mask(mask: np.ndarray) -> tuple[int, int]:
+    pts = np.argwhere(mask)
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return int(r1 - r0 + 1), int(c1 - c0 + 1)
+
