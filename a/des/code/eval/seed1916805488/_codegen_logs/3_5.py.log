+    for source_room, (base_color, strength) in sources.items():
+        dist = {source_room: 0}
+        q = deque([source_room])
+        while q:
+            room = q.popleft()
+            if dist[room] == strength:
+                continue
+            for nxt in graph[room]:
+                if nxt not in dist:
+                    dist[nxt] = dist[room] + 1
