+    for ci in range(room_cols - 1):
+        wall_c = col_spans[ci][1] + 1
+        for ri, (r0, r1) in enumerate(row_spans):
+            door_r = rng.randint(r0, r1)
+            grid[door_r, wall_c] = BLACK
+
+
