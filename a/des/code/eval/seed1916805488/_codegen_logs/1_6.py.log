+
+SHAPE_LIBRARY = [
+    [(-1, -1), (-1, 0), (-1, 1), (0, 0), (1, 0)],  # T
+    [(-1, 0), (0, 0), (1, 0), (-1, 1)],  # L
+    [(-1, 0), (0, 0), (1, 0), (1, 1), (0, 1)],  # hook
