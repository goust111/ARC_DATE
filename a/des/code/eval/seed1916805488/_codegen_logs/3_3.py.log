+        cur_s = start_s
+        vertical_moves: list[tuple[int, int]] = []
+        ok = True
+        for i in range(vertical_count):
+            directions = []
+            if cur_s > 1:
+                directions.append(-1)
+            if cur_s < secondary_limit - 1:
+                directions.append(1)
+            if not directions:
+                ok = False
+                break
+            if i == 0:
+                sign = int(rng.choice(directions))
+            else:
