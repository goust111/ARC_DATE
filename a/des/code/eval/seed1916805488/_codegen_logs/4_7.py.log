+    for _ in range(100):
+        palette = rng.sample(COLOR_POOL, rng.randint(2, min(4, len(COLOR_POOL))))
+        arr = np.array([[rng.choice(palette) for _ in range(w)] for _ in range(h)], dtype=int)
+        if len(set(int(v) for v in arr.flat)) < 2:
+            continue
+        return arr
