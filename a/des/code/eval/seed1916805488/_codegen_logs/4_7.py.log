+    key_by_color = {k["color"]: k for k in keys}
+    chest_by_color = {}
+    for key in keys:
+        kr0, kc0, kr1, kc1 = key["bbox"]
+        kh, kw = key["mask"].shape
+        matches = []
+        for chest in chests:
