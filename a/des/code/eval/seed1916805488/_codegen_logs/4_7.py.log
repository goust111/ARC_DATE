+    top_h = max(item["panel_h"] for item in items) + 2
+    bottom_h = max(item["key"].shape[0] + item["pattern"].shape[0] + 5 for item in items) + 2
+    grid_h = top_h + 1 + bottom_h
+    if grid_w > 30 or grid_h > 30:
