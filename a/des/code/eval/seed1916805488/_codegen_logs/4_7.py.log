+def _is_rect_frame(grid: np.ndarray, color: int, coords: list[tuple[int, int]]) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return False
+    want = set(_frame_coords(r0, c0, r1, c1))
+    have = set(coords)
+    if have != want:
+        return False
+    return True
