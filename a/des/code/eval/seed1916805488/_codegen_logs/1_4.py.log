+def _random_root_box(
+    h: int,
+    w: int,
+    depth: int,
+    corner: str,
+    used: list[tuple[int, int, int, int]],
+    rng: random.Random,
+    extra_slack: int = 0,
+) -> tuple[int, int, int, int] | None:
+    min_h = _min_dim_for_depth(depth) + extra_slack
+    min_w = _min_dim_for_depth(depth) + extra_slack
+    if h < min_h + 2 or w < min_w + 2:
+        return None
+    col_lo = 1
+    col_hi = w - 2
+    if "left" in corner:
+        col_lo = 2
+    else:
+        col_hi = w - 3
+    for _ in range(60):
+        box_h = rng.randint(min_h, min(min_h + 8, h - 2))
+        box_w = rng.randint(min_w, min(min_w + 8, col_hi - col_lo + 1))
+        r0 = rng.randint(1, h - box_h - 1)
+        c0 = rng.randint(col_lo, col_hi - box_w + 1)
+        box = (r0, c0, r0 + box_h - 1, c0 + box_w - 1)
+        if all(not _boxes_interfere(box, other, pad=1) for other in used):
+            return box
+    return None
+
