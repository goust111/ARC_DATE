+                for c1 in range(c0 + 2, width):
+                    if g[r1, c1] != WALL:
+                        continue
+
+                    if np.any(g[r0, c0 : c1 + 1] == WALL):
+                        continue
+                    if not np.all(g[r0 + 1 : r1 + 1, c0] == WALL):
+                        continue
+                    if not np.all(g[r0 + 1 : r1 + 1, c1] == WALL):
+                        continue
+                    if not np.all(g[r1, c0 : c1 + 1] == WALL):
