+    if first_filled is None:
+        return None
+
+    filled = row_colors[first_filled:]
+    if any(color == BG for color in filled):
+        return None
+    if not 2 <= len(filled) <= 4:
+        return None
+    if len(set(filled)) != len(filled):
+        return None
+    return filled
