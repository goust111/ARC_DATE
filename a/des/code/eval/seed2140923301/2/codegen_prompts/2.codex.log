+                        "cells": cells,
+                        "bits": _bitmask_from_cells(cells, frame_bbox),
+                        "distance": abs(int(nr) - r0) + abs(int(nc) - c0),
+                    }
+                )
+    candidates.sort(key=lambda item: (int(item["distance"]), int(item["top_left"][0]), int(item["top_left"][1])))
+    return candidates
