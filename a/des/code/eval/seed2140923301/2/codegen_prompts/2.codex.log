+        positions_b = [
+            (r, c)
+            for r in range(inner_h - bh + 1)
+            for c in range(inner_w - bw + 1)
+        ]
+        random.shuffle(positions_b)
+        for br, bc in positions_b:
+            cells_b = set(_cells_from_mask(mask_b, br, bc))
+            overlap = len(cells_a & cells_b)
+            if overlap not in (1, 2):
