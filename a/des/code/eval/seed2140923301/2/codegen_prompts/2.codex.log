+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+NEIGHBORS8 = tuple(
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
