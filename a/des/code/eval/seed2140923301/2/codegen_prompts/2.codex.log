+def _bitmask_from_cells(cells: list[tuple[int, int]], frame_bbox: tuple[int, int, int, int]) -> int:
+    fr0, fc0, _fr1, fc1 = frame_bbox
+    width = fc1 - fc0 + 1
+    bits = 0
+    for r, c in cells:
+        idx = (r - fr0) * width + (c - fc0)
+        bits |= 1 << idx
+    return bits
