+
+BG = 0
+YELLOW = 4
+GREY = 5
+MAROON = 9
+PIECE_COLORS = (1, 2, 3, 6, 7, 8)
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+NEIGHBORS8 = tuple(
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
