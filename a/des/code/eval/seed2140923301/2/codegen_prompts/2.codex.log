+                    {
+                        "top_left": (int(nr), int(nc)),
+                        "cells": cells,
+                        "bits": _bitmask_from_cells(cells, frame_bbox),
+                        "distance": abs(int(nr) - r0) + abs(int(nc) - c0),
+                    }
