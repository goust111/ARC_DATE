+
+GRID_SIDE_RANGE = (26, 33)
+FRAME_INNER_H_RANGE = (7, 12)
+FRAME_INNER_W_RANGE = (7, 12)
+FRAME_MARGIN = 6
+PIECE_COUNT_RANGE = (2, 5)
+AREA_RANGE = (3, 6)
+MAX_MASK_SIDE = 4
+MAX_ATTEMPTS = 400
