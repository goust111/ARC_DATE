+    for nr in row_iter:
+        for nc in col_iter:
+            cells = _cells_from_mask(mask, int(nr), int(nc))
+            if all(fr0 <= rr <= fr1 and fc0 <= cc <= fc1 and int(grid[rr, cc]) == BG for rr, cc in cells):
+                candidates.append(
