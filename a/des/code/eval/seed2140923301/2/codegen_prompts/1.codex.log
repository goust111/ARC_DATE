+    n_rows, n_cols = rng.choice(ROOM_LAYOUTS)
+    n_rooms = n_rows * n_cols
+    row_heights = _sample_axis_sizes(rng, n_rows)
+    col_widths = _sample_axis_sizes(rng, n_cols)
+    margins = tuple(rng.randint(1, 4) for _ in range(4))
