+def _mark_blocked_cells(blocked: np.ndarray, cells: list[tuple[int, int]], pad: int = 1) -> None:
+    for r, c in cells:
+        rr0 = max(0, int(r) - pad)
+        cc0 = max(0, int(c) - pad)
+        rr1 = min(blocked.shape[0], int(r) + pad + 1)
+        cc1 = min(blocked.shape[1], int(c) + pad + 1)
+        blocked[rr0:rr1, cc0:cc1] = True
