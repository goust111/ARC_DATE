+    for cells in _components(grid == BG):
+        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in cells):
+            continue
+        cell_set = set(cells)
+        border_colors: set[int] = set()
+        wall_cells: set[tuple[int, int]] = set()
+        for r, c in cells:
+            for dr, dc in DIRS4:
+                nr = r + dr
+                nc = c + dc
