        return [c for c in cols if c < marker_col]
    return [c for c in cols if c > marker_col]


def _wall_has_intended_connectivity(wall_cols_by_row: dict[int, list[int]], marker_col: int) -> bool:
    if _wall_component_count(wall_cols_by_row) != EXPECTED_WALL_COMPONENTS:
        return False

