+def _mask_has_distinct_rotations(mask: np.ndarray) -> bool:
+    rots = [_rotate_cw(mask.astype(int), k).astype(bool) for k in range(4)]
+    for i in range(4):
+        for j in range(i + 1, 4):
+            if np.array_equal(rots[i], rots[j]):
+                return False
+    return True
