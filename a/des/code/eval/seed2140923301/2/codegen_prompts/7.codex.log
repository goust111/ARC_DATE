+
+    out = main(grid)
+    for r, c in anchors:
+        if int(out[r, c]) != int(grid[r, c]):
+            return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
