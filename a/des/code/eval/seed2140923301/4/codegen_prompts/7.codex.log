+            top1 = top
+            top2 = top + s1 + line_len
+            left1 = left + (box_w - s1) // 2
+            left2 = left + (box_w - s2) // 2
+            _draw_mask(grid, top1, left1, left_mask, GREY)
+            _draw_mask(grid, top2, left2, right_mask, GREY)
