+    r0, c0, r1, c1 = bbox
+    center_r2 = r0 + r1
+    center_c2 = c0 + c1
+    rotated: list[tuple[int, int]] = []
+    for r, c in coords:
+        dr2 = 2 * int(r) - center_r2
+        dc2 = 2 * int(c) - center_c2
+        if k == 1:
+            nr2 = center_r2 + dc2
+            nc2 = center_c2 - dr2
+        elif k == 2:
+            nr2 = center_r2 - dr2
+            nc2 = center_c2 - dc2
+        else:
+            nr2 = center_r2 - dc2
+            nc2 = center_c2 + dr2
+        assert nr2 % 2 == 0 and nc2 % 2 == 0, "rotation must land on integer pixels"
+        rotated.append((nr2 // 2, nc2 // 2))
+    return rotated
