+def _path_candidates(
+    current: tuple[int, int],
+    occupied: set[tuple[int, int]],
+    box_h: int,
+    box_w: int,
+) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    r, c = current
+    for dr, dc in DIRS4:
+        nr, nc = r + dr, c + dc
+        if not (0 <= nr < box_h and 0 <= nc < box_w):
