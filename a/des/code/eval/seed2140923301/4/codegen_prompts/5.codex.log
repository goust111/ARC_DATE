+    if r == 0:
+        sides.append("top")
+    if r == h - 1:
+        sides.append("bottom")
+    if c == 0:
+        sides.append("left")
+    if c == w - 1:
+        sides.append("right")
+    return sides[0] if len(sides) == 1 else None
