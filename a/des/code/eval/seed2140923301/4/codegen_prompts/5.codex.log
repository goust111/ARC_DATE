+
+def _component_edge_count(cells: list[tuple[int, int]]) -> int:
+    pts = set(cells)
+    edges = 0
+    for r, c in pts:
+        if (r + 1, c) in pts:
+            edges += 1
+        if (r, c + 1) in pts:
+            edges += 1
