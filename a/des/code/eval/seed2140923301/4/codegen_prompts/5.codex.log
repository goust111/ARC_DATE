+    if not any(branch_flags) or all(branch_flags):
+        return None
+    if not any(wrap_flags) or all(wrap_flags):
+        return None
+
+    out = main(grid)
+    if out.shape != grid.shape or np.array_equal(out, grid):
+        return None
+    return grid
