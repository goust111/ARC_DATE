+    q = deque([root])
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c, 10**9, 10**9):
+            if (nr, nc) in pts and (nr, nc) not in depths:
+                depths[(nr, nc)] = depths[(r, c)] + 1
+                q.append((nr, nc))
