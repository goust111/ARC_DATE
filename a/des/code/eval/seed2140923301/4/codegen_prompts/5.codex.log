+    weights: list[int] = []
+    r, c = current
+    for nr, nc in candidates:
+        dr, dc = nr - r, nc - c
+        weight = 1
+        if dr == 1:
+            weight += 4
+        if prev_dir is not None and (dr, dc) == prev_dir:
+            weight += 2
+        weights.append(weight)
+    return random.choices(candidates, weights=weights, k=1)[0]
