+    if r == 0:
+        sides.append("top")
+    if r == h - 1:
+        sides.append("bottom")
+    if c == 0:
+        sides.append("left")
+    if c == w - 1:
+        sides.append("right")
+    return sides[0] if len(sides) == 1 else None
+
+
+def _component_edge_count(cells: list[tuple[int, int]]) -> int:
+    pts = set(cells)
+    edges = 0
+    for r, c in pts:
+        if (r + 1, c) in pts:
+            edges += 1
+        if (r, c + 1) in pts:
+            edges += 1
+    return edges
+
+
+def _read_band(grid: np.ndarray, root: tuple[int, int]) -> list[int] | None:
+    h, w = grid.shape
