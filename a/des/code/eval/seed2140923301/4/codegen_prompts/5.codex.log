+            if not candidates:
+                break
+            nxt = _choose_step(current, candidates, prev_dir)
+            prev_dir = (nxt[0] - current[0], nxt[1] - current[1])
+            occupied.add(nxt)
+            current = nxt
+        if len(occupied) == target_depth + 1:
+            return occupied
+    return None
+
+
+def _grow_branch(
+    start: tuple[int, int],
+    occupied: set[tuple[int, int]],
