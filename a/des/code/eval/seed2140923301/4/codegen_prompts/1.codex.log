+    return r0, c0, r1, c1
+
+
+def _random_interior_mask(rng: random.Random, height: int, width: int) -> np.ndarray:
+    mask = np.ones((height, width), dtype=bool)
+    corners = ["tl", "tr", "bl", "br"]
