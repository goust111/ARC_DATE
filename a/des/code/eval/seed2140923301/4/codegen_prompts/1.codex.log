+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+GREY = 5
+COLOR_POOL = (2, 3, 4, 6, 7, 8, 9)
+
+LEFT_AREA_WIDTH = 4
+MAX_PATTERN_SIZE = 3
