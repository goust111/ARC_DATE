+    for idx, (seed_color, pattern) in enumerate(row_specs):
+        size = pattern.shape[0]
+        rs = cursor
+        re = cursor + size - 1
+        seed_r = rs + size // 2
+        seed_c = c0 + 2
+        grid[seed_r, seed_c] = seed_color
