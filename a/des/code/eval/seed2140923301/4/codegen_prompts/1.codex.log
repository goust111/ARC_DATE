+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    n_rows = rng.randint(2, 4)
+    row_sizes = [rng.choice((2, 3)) for _ in range(n_rows)]
+    legend_top = rng.randint(0, 2)
