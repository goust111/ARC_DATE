+def _outer_boundary(interior: np.ndarray) -> np.ndarray:
+    h, w = interior.shape
+    padded = np.zeros((h + 2, w + 2), dtype=bool)
+    padded[1:-1, 1:-1] = interior
+    boundary = np.zeros_like(padded)
+    cells = np.argwhere(padded)
+    for r, c in cells:
+        r = int(r)
+        c = int(c)
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if dr == 0 and dc == 0:
+                    continue
+                nr = r + dr
+                nc = c + dc
