+    rng.shuffle(assignments)
+
+    blueprints = [_make_region_blueprint(rng, row_specs[idx][0], row_specs[idx][1]) for idx in assignments]
+    blueprints.sort(key=lambda item: item["patch"].shape[0] * item["patch"].shape[1], reverse=True)
