+def _window_cell(room_h: int, room_w: int, side: str) -> tuple[int, int]:
+    if side == "top":
+        return 0, random.randint(1, room_w - 2)
+    if side == "bottom":
+        return room_h - 1, random.randint(1, room_w - 2)
+    if side == "left":
