+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+UP = (-1, 0)
+RIGHT = (0, 1)
+DOWN = (1, 0)
+LEFT = (0, -1)
+DIRS = (UP, RIGHT, DOWN, LEFT)
+
+LEFT_TURN = {
+    UP: LEFT,
+    LEFT: DOWN,
+    DOWN: RIGHT,
+    RIGHT: UP,
+}
+
+RIGHT_TURN = {
+    UP: RIGHT,
+    RIGHT: DOWN,
+    DOWN: LEFT,
+    LEFT: UP,
+}
+
+REFLECT = {
+    ("\\", UP): LEFT,
+    ("\\", LEFT): UP,
+    ("\\", DOWN): RIGHT,
+    ("\\", RIGHT): DOWN,
+    ("/", UP): RIGHT,
+    ("/", RIGHT): UP,
+    ("/", DOWN): LEFT,
+    ("/", LEFT): DOWN,
+}
+
+SIDE_TO_DIR = {
+    "top": DOWN,
+    "bottom": UP,
+    "left": RIGHT,
+    "right": LEFT,
+}
+
+SIDES = ("top", "bottom", "left", "right")
