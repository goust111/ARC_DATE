+def generate_input() -> np.ndarray:
+    global _NEXT_MODE_INDEX
+    mode = MODE_SEQUENCE[_NEXT_MODE_INDEX]
+    _NEXT_MODE_INDEX = (_NEXT_MODE_INDEX + 1) % len(MODE_SEQUENCE)
