+def _render_base(nodes: set[LogicalCoord], edges: set[Edge], gates: list[dict[str, object]], log_h: int, log_w: int) -> np.ndarray:
+    grid = np.full((2 * log_h + 1, 2 * log_w + 1), BLACK, dtype=int)
