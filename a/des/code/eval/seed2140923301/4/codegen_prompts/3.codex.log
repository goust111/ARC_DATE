+ORANGE = 7
+AZURE = 8
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+TRAVERSABLE = {GREEN, YELLOW, AZURE, MAGENTA, ORANGE, RED}
