+    leaves = []
+    for r, c in np.argwhere(np.isin(g, list(TRAVERSABLE))):
+        cell = (int(r), int(c))
+        if len(_undirected_neighbors(g, cell)) == 1:
+            leaves.append(cell)
+    return leaves
+
