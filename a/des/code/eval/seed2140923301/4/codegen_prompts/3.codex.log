+def _build_logical_tree(log_h: int, log_w: int, target_nodes: int) -> tuple[set[LogicalCoord], set[Edge]] | None:
+    start = (random.randrange(log_h), random.randrange(log_w))
+    nodes = {start}
+    edges: set[Edge] = set()
+    degree = {start: 0}
