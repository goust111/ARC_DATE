+        outs.append((nr, nc))
+    return outs
+
+
+def _reachable_cells(g: np.ndarray) -> set[Coord]:
+    gates, red_to_orange = _find_gates(g)
+    source = _find_source(g)
+    seen = {source}
+    queue = deque([source])
