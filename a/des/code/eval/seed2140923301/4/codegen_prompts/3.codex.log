+        parent, free_neighbors = random.choices(parents, weights=weights, k=1)[0]
+        child = random.choice(free_neighbors)
+        nodes.add(child)
+        edges.add(_edge(parent, child))
+        degree[parent] += 1
+        degree[child] = 1
