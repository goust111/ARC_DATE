COLOR_COUNT = 10
GRID_HEIGHT_RANGE = (20, 30)
GRID_WIDTH_RANGE = (20, 30)
PANEL_COUNT_RANGE = (2, 4)
PANEL_HEIGHT_RANGE = (5, 12)
PANEL_WIDTH_RANGE = (5, 10)
PANEL_PLACEMENT_TRIES = 50
