+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for dr, dc in DIR4:
