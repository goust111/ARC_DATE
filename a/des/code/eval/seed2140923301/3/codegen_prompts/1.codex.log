+        seeds: list[tuple[int, int]] = []
+        seed_set: set[tuple[int, int]] = set()
+        for r in range(r0 + 1, r1):
+            for c in range(c0 + 1, c1):
+                value = int(grid[r, c])
+                if value == BG:
+                    continue
+                assert value != border_color, "seed color must differ from border color"
+                seeds.append((r, c))
+                seed_set.add((r, c))
