        else:
            raise ValueError(side)
    return gaps


def _try_place_object(
    rng: random.Random,
    grid: np.ndarray,
    reserved: np.ndarray,
    border_color: int,
    seed_palette: list[int],
    mode: str,
) -> bool:
    h, w = grid.shape
    for _ in range(MAX_PLACE_TRIES):
        ih = rng.randint(2, 5)
        iw = rng.randint(2, 5)
        height = ih + 2
        width = iw + 2
        capacity = max(((ih * iw) + 1) // 2, 1)
        if mode == "truncated":
            max_seed = min(4, capacity)
            if max_seed < 2:
                continue
            seed_count = rng.randint(2, max_seed)
