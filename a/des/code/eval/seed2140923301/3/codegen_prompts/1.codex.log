+        legend_mask[r, c0 + 1] = True
+    return mapping, legend_mask
+
+
+def _gap_side(r: int, c: int, r0: int, c0: int, r1: int, c1: int) -> str:
+    if r == r0:
+        return "top"
+    if r == r1:
+        return "bottom"
+    if c == c0:
+        return "left"
+    if c == c1:
+        return "right"
