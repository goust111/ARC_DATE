+        assert seeds, "each frame must contain at least one seed"
+        for r, c in seeds:
+            for dr, dc in DIRS4:
+                nr, nc = r + dr, c + dc
+                assert (nr, nc) not in seed_set, "seeds must be non-adjacent"
