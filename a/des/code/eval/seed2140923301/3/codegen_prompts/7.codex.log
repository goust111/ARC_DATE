+        container,
+        source_row,
+        target_row,
+        valve_col,
+        colors,
+        random.choice([True, False]),
+        random.choice([True, False]),
+    ):
+        return None
+    return grid
+
+
+def _build_dual(h: int, w: int) -> np.ndarray | None:
+    grid = np.full((h, w), BG, dtype=int)
+    ch1 = random.randint(5, 7)
+    cw1 = random.randint(5, 7)
+    ch2 = random.randint(5, 7)
+    cw2 = random.randint(5, 7)
+
+    top1_hi = h // 2 - ch1 - 4
+    if top1_hi < 2:
