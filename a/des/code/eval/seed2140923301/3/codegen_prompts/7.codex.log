+def _build_solo_zigzag(h: int, w: int) -> np.ndarray | None:
+    grid = np.full((h, w), BG, dtype=int)
+    ch = random.randint(5, 7)
+    cw = random.randint(5, 7)
+    top = random.randint(h // 2, h - ch - 3)
