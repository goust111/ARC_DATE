+    total_area = sum((spec["height"] + 2) * (spec["width"] + 2) for spec in specs)
+    base = int(np.ceil(np.sqrt(total_area * 1.7)))
+    min_h = max(spec["height"] for spec in specs) + 2
+    min_w = max(spec["width"] for spec in specs) + 2
