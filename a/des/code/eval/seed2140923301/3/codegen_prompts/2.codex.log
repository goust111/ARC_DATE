+        first = legal[int(idx)]
+        first_box = _piece_box(first)
+        second_choices = [
+            pos
+            for pos in legal
+            if pos != first
+            and _boxes_separated(first_box, _piece_box(pos), gap=1)
+            and _pair_far_enough(first, pos)
