+    if seam == "\\":
+        options = (("tl", "br"), ("br", "tl"))
+    else:
+        options = (("tr", "bl"), ("bl", "tr"))
+    return options[int(rng.integers(0, len(options)))]
+
+
+def _candidate_positions(
+    shape: tuple[int, int],
+    used_boxes: list[tuple[int, int, int, int]],
+) -> list[tuple[int, int]]:
+    h, w = shape
+    positions: list[tuple[int, int]] = []
+    for r in range(h - 1):
+        for c in range(w - 1):
+            box = _piece_box((r, c))
+            if all(_boxes_separated(box, other, gap=1) for other in used_boxes):
+                positions.append((r, c))
+    return positions
+
+
+def _pair_far_enough(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    return abs(int(a[0]) - int(b[0])) + abs(int(a[1]) - int(b[1])) >= 5
+
+
+def _place_pair(
+    shape: tuple[int, int],
+    used_boxes: list[tuple[int, int, int, int]],
+    rng: np.random.Generator,
+) -> tuple[tuple[int, int], tuple[int, int]] | None:
+    legal = _candidate_positions(shape, used_boxes)
+    if len(legal) < 2:
