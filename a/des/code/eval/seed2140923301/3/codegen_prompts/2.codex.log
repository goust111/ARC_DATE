+BG = 0
+FOREGROUND_COLORS = tuple(range(1, 10))
+MISSING_TO_OCCUPIED = {
+    "tl": ((0, 1), (1, 0), (1, 1)),
+    "tr": ((0, 0), (1, 0), (1, 1)),
+    "bl": ((0, 0), (0, 1), (1, 1)),
+    "br": ((0, 0), (0, 1), (1, 0)),
+}
