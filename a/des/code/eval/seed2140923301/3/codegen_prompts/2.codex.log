+from __future__ import annotations
+
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+FOREGROUND_COLORS = tuple(range(1, 10))
+MISSING_TO_OCCUPIED = {
+    "tl": ((0, 1), (1, 0), (1, 1)),
+    "tr": ((0, 0), (1, 0), (1, 1)),
+    "bl": ((0, 0), (0, 1), (1, 1)),
+    "br": ((0, 0), (0, 1), (1, 0)),
+}
+MISSING_TO_CELL = {
+    "tl": (0, 0),
+    "tr": (0, 1),
+    "bl": (1, 0),
+    "br": (1, 1),
+}
+OPPOSITE_MISSING = {"tl": "br", "tr": "bl", "bl": "tr", "br": "tl"}
+GENERATION_ATTEMPTS = 400
