+    adjacency = {cell: _neighbors(cell, rows, cols) for cell in all_cells}
+
+    def backtrack(unmatched: frozenset[tuple[int, int]]) -> dict[tuple[int, int], tuple[int, int]] | None:
+        if not unmatched:
+            return {}
+        cell = min(unmatched)
+        nbrs = [n for n in adjacency[cell] if n in unmatched]
