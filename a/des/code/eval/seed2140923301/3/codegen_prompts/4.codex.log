+    c0, c1 = min(cols), max(cols)
+    assert (r1 - r0, c1 - c0) == (1, 1)
+    present = {(r - r0, c - c0) for r, c in coords}
+    missing = ({(0, 0), (0, 1), (1, 0), (1, 1)} - present).pop()
