+
+def _room_bounds(
+    room_r: int,
+    room_c: int,
+    wall_rows: list[int],
+    wall_cols: list[int],
+) -> tuple[int, int, int, int, int, int, int, int]:
+    wt = wall_rows[room_r]
+    wb = wall_rows[room_r + 1]
+    wl = wall_cols[room_c]
+    wr = wall_cols[room_c + 1]
+    return wt, wb, wl, wr, wt + 1, wb - 1, wl + 1, wr - 1
