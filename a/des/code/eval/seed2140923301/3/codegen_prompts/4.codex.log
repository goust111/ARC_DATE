+    "U": (-1, 0),
+    "R": (0, 1),
+    "D": (1, 0),
+    "L": (0, -1),
+}
+DIR_TO_MISSING = {
+    "U": (0, 0),
+    "R": (0, 1),
+    "D": (1, 1),
+    "L": (1, 0),
