+    h, w = patch.shape
+    if h < 3 or w < 3:
+        return False
+    if not np.all((patch == color) | (patch == bg)):
+        return False
+    if not np.all(patch[0, :] == color):
+        return False
+    if not np.all(patch[-1, :] == color):
+        return False
+    if not np.all(patch[:, 0] == color):
+        return False
+    if not np.all(patch[:, -1] == color):
+        return False
+    hole = patch == bg
+    area = int(hole.sum())
+    if area < 1 or area > 4:
+        return False
+    if hole[0, :].any() or hole[-1, :].any() or hole[:, 0].any() or hole[:, -1].any():
