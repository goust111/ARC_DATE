+    remaining = [shape for shape in _SHAPES if _rotation_key(shape) != _rotation_key(featured)]
+    chosen = [featured] + random.sample(remaining, num_pairs - 1)
+    random.shuffle(chosen)
+    return [shape.copy() for shape in chosen]
+
