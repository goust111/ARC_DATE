+
+def _rotation_variants(mask: np.ndarray) -> list[np.ndarray]:
+    variants: list[np.ndarray] = []
+    seen: set[tuple[int, int, bytes]] = set()
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        key = (int(rot.shape[0]), int(rot.shape[1]), rot.tobytes())
+        if key in seen:
