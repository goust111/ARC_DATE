+        ls = int(pair["lock_patch"].shape[0])
+        out[lr0 : lr0 + ls, lc0 : lc0 + ls] = int(pair["key_color"])
+        kr0, kc0 = pair["key_origin"]
+        key_mask = pair["key_patch"] == int(pair["key_color"])
