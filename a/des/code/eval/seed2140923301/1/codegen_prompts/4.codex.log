+    locks: list[dict] = []
+    keys: list[dict] = []
+    for obj in _find_color_components(grid, bg):
+        r0, c0, r1, c1 = obj["bbox"]
+        color = int(obj["color"])
+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        if _is_lock_patch(patch, color, bg):
+            hole = patch == bg
+            hole_coords = np.argwhere(hole)
+            locks.append(
