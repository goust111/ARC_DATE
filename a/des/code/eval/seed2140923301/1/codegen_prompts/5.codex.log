+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input after repeated attempts")

