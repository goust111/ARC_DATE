+    for size in range(2, 7):
+        for shape in sorted(shapes_by_size[size]):
+            rows = [r for r, _ in shape]
+            cols = [c for _, c in shape]
+            center = (_round_half_up(sum(rows) / size), _round_half_up(sum(cols) / size))
