+    center = _object_center(coords)
+    ar, ac = anchor
+    cr, cc = center
+    h, w = shape
+    size = len(coords)
+
+    if ar == cr:
+        step = 1 if ac > cc else -1
+        if step > 0:
+            max_shift = w - 1 - max(c for _, c in coords)
+        else:
+            max_shift = min(c for _, c in coords)
+        return 0, int(step * min(size, max_shift))
