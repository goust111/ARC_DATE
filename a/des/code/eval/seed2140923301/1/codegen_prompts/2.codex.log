+        fw = int(c1 - c0 + 1)
+        assert int(len(coords)) == fh * fw, "fragments must be solid rectangles"
+        fragments.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "shape": (fh, fw),
+                "area": int(len(coords)),
+                "color": int(color_vals[0]),
