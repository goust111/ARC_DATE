GRID_SIZE = 30

# Frame bbox dimensions
FRAME_H_RANGE = (7, 13)
FRAME_W_RANGE = (7, 20)

# Hole layout
SHAPE_COUNT_RANGE = (3, 6)          # distinct canonical hole shapes
MIN_SHAPES = 3                       # minimum to accept a layout
SHAPE_MAX_AREA = 8                   # max cells per hole shape
FRAME_DENSITY_RANGE = (0.55, 0.92)   # fraction of frame_col in frame bbox
MIN_TOTAL_HOLES = 5                  # minimum hole instances
PLACEMENT_RETRIES = 80               # retries per symmetric placement attempt
MULT_EVEN_WEIGHTS = ([1, 2], [4, 1])       # (values, weights) for even-dim frames
MULT_ODD_WEIGHTS = ([1, 2, 3], [3, 2, 1])  # (values, weights) for odd-dim frames

# Sprite scattering
WINNING_SPRITE_RANGE = (2, 5)        # winning-color sprites per hole shape
OTHER_COLOR_MAX = 2                  # max distinct losing colors per shape
SPRITE_PADDING = 1                   # Chebyshev separation (bg cells)

# Generation retry budget
MAX_GEN_ATTEMPTS = 300


