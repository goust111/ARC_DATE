+    return {
+        "bg": bg,
+        "sep": sep,
+        "bbox": (fr0, fc0, fr1, fc1),
+        "subgrid": sub,
+        "rows": len(row_lines) - 1,
+        "cols": len(col_lines) - 1,
+        "cells": cells,
+        "cell_map": cell_map,
