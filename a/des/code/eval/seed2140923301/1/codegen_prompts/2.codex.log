+    for spec in sorted(fragment_specs, key=lambda item: item["area"], reverse=True):
+        fh, fw = spec["shape"]
+        positions = [(r, c) for r in range(h - fh + 1) for c in range(w - fw + 1)]
+        random.shuffle(positions)
