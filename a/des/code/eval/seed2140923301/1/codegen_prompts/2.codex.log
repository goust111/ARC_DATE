+
+def _slot_fill_colors(template: dict) -> dict[tuple[int, int], int]:
+    cell_map = template["cell_map"]
+    rows = int(template["rows"])
+    cols = int(template["cols"])
+    fills: dict[tuple[int, int], int] = {}
