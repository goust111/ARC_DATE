+            region = band[:, c0 : c0 + GEN_LIBRARY_SPAN]
+            if not np.all(region[:, 3] == bg):
+                continue
+            if not np.all(region[:, 7] == bg):
+                continue
+            if not np.all(region[:, 11] == bg):
+                continue
