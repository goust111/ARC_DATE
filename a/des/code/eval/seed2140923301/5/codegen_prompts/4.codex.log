+        for c0 in range(w - GEN_LIBRARY_SPAN + 1):
+            if c0 > 0 and not np.all(band[:, :c0] == bg):
+                continue
+            if c0 + GEN_LIBRARY_SPAN < w and not np.all(band[:, c0 + GEN_LIBRARY_SPAN :] == bg):
