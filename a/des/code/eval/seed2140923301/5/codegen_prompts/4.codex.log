+    rays = [
+        ((r0 - 1, mid_c), (-1, 0)),
+        ((r1 + 1, mid_c), (1, 0)),
+        ((mid_r, c0 - 1), (0, -1)),
+        ((mid_r, c1 + 1), (0, 1)),
+    ]
+    hits: list[tuple[int, int]] = []
