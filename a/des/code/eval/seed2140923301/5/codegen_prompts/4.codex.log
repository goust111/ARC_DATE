+        return False
+    target = set()
+    for c in range(c0, c1 + 1):
+        target.add((r0, c))
+        target.add((r1, c))
+    for r in range(r0 + 1, r1):
+        target.add((r, c0))
+        target.add((r, c1))
+    return set(coords) == target
