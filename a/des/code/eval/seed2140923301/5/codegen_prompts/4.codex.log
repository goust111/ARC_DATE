+def _paste_patch(out: np.ndarray, patch: np.ndarray, center: tuple[int, int]) -> None:
+    h, w = out.shape
+    cr, cc = center
+    for dr in range(-1, 2):
+        for dc in range(-1, 2):
+            rr = int(cr + dr)
+            cc2 = int(cc + dc)
