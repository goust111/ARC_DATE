+            c0 = random.randint(0, width - mask_w)
+        elif side == "bottom":
+            r0 = height - mask_h
+            c0 = random.randint(0, width - mask_w)
+        elif side == "left":
+            r0 = random.randint(0, height - mask_h)
+            c0 = 0
+        else:
+            r0 = random.randint(0, height - mask_h)
+            c0 = width - mask_w
+
+        box = _box_cells(r0, c0, mask_h, mask_w)
+        padded = _padded_cells(box, height, width)
+        if not _fits(blocked, padded):
