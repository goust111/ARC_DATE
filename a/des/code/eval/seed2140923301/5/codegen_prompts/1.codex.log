+    border = _border_cells(r0, c0, r1, c1)
+    border_set = set(border)
+    cell_set = {tuple(map(int, rc)) for rc in coords}
+    if not cell_set <= border_set:
+        return None
+    if len(cell_set) != len(border) - 1:
+        return None
