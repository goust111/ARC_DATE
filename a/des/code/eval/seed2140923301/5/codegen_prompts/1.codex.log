+
+    missing = [cell for cell in border if cell not in cell_set]
+    if len(missing) != 1:
+        return None
+    gap_r, gap_c = missing[0]
+    if (gap_r, gap_c) in {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}:
+        return None
+
+    if gap_r == r0:
+        direction = (-1, 0)
+    elif gap_r == r1:
+        direction = (1, 0)
+    elif gap_c == c0:
+        direction = (0, -1)
+    else:
