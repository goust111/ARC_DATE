+    for k in range(4):
+        rotated = np.rot90(mask, k)
+        for variant in (rotated, np.fliplr(rotated)):
+            norm = _normalize_mask(variant)
+            key = (tuple(map(int, norm.shape)), norm.tobytes())
+            if key in seen:
+                continue
+            seen.add(key)
+            out.append(norm)
+    return out
