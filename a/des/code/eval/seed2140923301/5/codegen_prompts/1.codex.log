+def _normalize_mask(mask: np.ndarray) -> np.ndarray:
+    rows, cols = np.where(mask)
+    r0 = int(rows.min())
+    c0 = int(cols.min())
+    r1 = int(rows.max())
+    c1 = int(cols.max())
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    out[rows - r0, cols - c0] = True
+    return out
+
+
+def _mask_variants(mask: np.ndarray) -> list[np.ndarray]:
