+def _analyze_fence(
+    grid: np.ndarray,
+    fence_color: int,
+    coords: np.ndarray,
+    bg: int,
+) -> dict[str, object] | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return None
