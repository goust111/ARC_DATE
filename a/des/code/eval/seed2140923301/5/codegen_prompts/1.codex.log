+        assert fragment_color in template_areas, "missing matching edge template"
+        ray_length = int(template_areas[fragment_color])
+        gap_r, gap_c = fence["gap"]
+        dr, dc = fence["direction"]
+        rr = gap_r + dr
+        cc = gap_c + dc
