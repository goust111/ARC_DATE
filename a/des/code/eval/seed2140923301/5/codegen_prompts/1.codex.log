+    return {
+        "fence_color": int(fence_color),
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "gap": (int(gap_r), int(gap_c)),
+        "direction": direction,
+        "fragment_color": int(fragment_color),
+    }
