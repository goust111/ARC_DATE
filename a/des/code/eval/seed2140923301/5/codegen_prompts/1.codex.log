+
+def _border_cells(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        if r1 != r0:
+            cells.append((r1, c))
+    for r in range(r0 + 1, r1):
