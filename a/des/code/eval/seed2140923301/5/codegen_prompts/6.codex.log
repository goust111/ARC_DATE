+        for r, c in cells:
+            out[r, c] = src_color
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Connect color-paired singleton endpoints across quadrant dividers.
+
+    The input contains:
+    - a dominant background,
+    - one full-row and one full-column divider of the same grey color,
