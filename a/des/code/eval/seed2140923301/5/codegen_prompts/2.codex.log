+
+
+def _capacity_for_gap(gap: int, span: int) -> int:
+    return (gap * span + 1) // 2
+
+
+def _seed_count(depth: int, span: int, max_gap: int) -> tuple[int, int] | None:
+    modes: dict[str, list[int]] = {}
+    for gap in range(1, max_gap + 1):
