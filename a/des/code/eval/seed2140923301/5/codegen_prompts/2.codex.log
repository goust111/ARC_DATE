+CONTAINER_COUNT_WEIGHTS = (3, 4, 2)
+CONTAINER_HEIGHT_RANGE = (3, 7)
+CONTAINER_WIDTH_RANGE = (3, 7)
+MAX_NEAR_EDGE_GAP = 8
+PLACEMENT_TRIES = 120
+
+
+def _shape_cells(container: dict) -> set[tuple[int, int]]:
