+        for c in range(w):
+            if not closed[r, c] or labels[r, c] != -1:
+                continue
+            queue = deque([(r, c)])
+            labels[r, c] = room_id
+            coords = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
