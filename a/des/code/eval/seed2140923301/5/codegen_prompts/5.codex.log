+
+def _cell_start(index: int, cell_size: int) -> int:
+    return 1 + index * (cell_size + 1)
+
+
+def _room_mask(
+    room_cells: set[tuple[int, int]],
+    coarse_rows: int,
+    coarse_cols: int,
+    cell_size: int,
+) -> np.ndarray:
