+    max_rooms = min(coarse_rows * coarse_cols, group_count + ROOM_EXTRA_RANGE[1])
+    min_rooms = min(max_rooms, group_count + ROOM_EXTRA_RANGE[0])
+    if min_rooms < group_count + 1:
