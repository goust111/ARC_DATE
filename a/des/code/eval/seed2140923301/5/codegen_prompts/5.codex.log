+def _room_shape(coords: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    r0 = int(rows.min())
+    r1 = int(rows.max())
+    c0 = int(cols.min())
+    c1 = int(cols.max())
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[rows - r0, cols - c0] = True
+    return mask, (r0, c0, r1, c1)
+
