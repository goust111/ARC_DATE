+
+
+def _gen_attempt() -> np.ndarray | None:
+    cell_size = random.choice(CELL_SIZE_OPTIONS)
+    coarse_rows = random.randint(*COARSE_ROWS_RANGE)
+    coarse_cols = random.randint(*COARSE_COLS_RANGE)
