+    cuts = sorted(int(x) for x in rng.choice(np.arange(1, count), size=rows - 1, replace=False))
+    parts: list[int] = []
+    prev = 0
+    for cut in cuts + [count]:
+        parts.append(int(cut - prev))
+        prev = cut
+    return parts
