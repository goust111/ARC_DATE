+    width = int(rng.integers(5, 10))
+    distance = int(rng.integers(2, 5))
+    piece_orient = "h" if int(rng.integers(0, 2)) == 0 else "v"
+
+    ring = _build_ring_patch(color, height, width, side, gap_len)
+    if piece_orient == "h":
