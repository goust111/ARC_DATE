+        if piece_orient == "h":
+            allowed = list(range(0, width - gap_len + 1))
+            preferred = (width - gap_len) // 2
+        else:
+            allowed = list(range(1, width - 1))
+            preferred = width // 2
+        piece_c = _choose_near(rng, allowed, preferred)
+        if side == "top":
