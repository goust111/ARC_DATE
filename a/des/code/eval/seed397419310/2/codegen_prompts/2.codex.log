+def _choose_near(rng: np.random.Generator, allowed: list[int], preferred: int) -> int:
+    assert allowed
+    close = [v for v in allowed if abs(v - preferred) <= 2]
+    pool = close if close else allowed
+    idx = int(rng.integers(0, len(pool)))
+    return int(pool[idx])
