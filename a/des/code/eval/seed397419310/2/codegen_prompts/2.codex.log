+            ring_r = piece_h + distance
+        else:
+            ring_r = 0
+            piece_r = height + distance
+        canvas[ring_r : ring_r + height, :] = ring
+        canvas[piece_r : piece_r + piece_h, piece_c : piece_c + piece_w] = piece
+    else:
