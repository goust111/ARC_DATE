+
+    grid = np.zeros((grid_h, grid_w), dtype=int)
+    for patch, r0, c0 in placements:
+        h, w = patch.shape
+        region = grid[r0 : r0 + h, c0 : c0 + w]
+        if np.any((region != BG) & (patch != BG)):
