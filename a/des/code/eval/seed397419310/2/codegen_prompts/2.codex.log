+def _piece_matches_gap(piece_coords: np.ndarray, gap_shape: frozenset[tuple[int, int]]) -> bool:
+    bbox = _bbox(piece_coords)
+    mask = _component_mask(piece_coords, bbox)
+    seen: set[frozenset[tuple[int, int]]] = set()
+    for k in range(4):
