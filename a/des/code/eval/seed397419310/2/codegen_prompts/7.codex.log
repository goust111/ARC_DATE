+    blocked_for_offpath = _expand_cells(occupied | on_path_obstacles, h, w)
+    off_path_obstacles = _choose_off_path_obstacles(grid, blocked_for_offpath, rng)
+    for r, c in off_path_obstacles:
+        grid[r, c] = GREY
