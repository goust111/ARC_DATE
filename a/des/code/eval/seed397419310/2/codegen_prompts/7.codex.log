+    gap_cells = [(row, col) for row in range(top_row + 1, bottom_row)]
+    seed_cells = [(top_row, col), (bottom_row, col)]
+    footprint = set(seed_cells) | set(gap_cells) | set(left_path) | set(right_path)
+    return {
