+        return None
+    if not np.any(solved == YELLOW):
+        return None
+
+    extracted = _extract_pairs(grid)
+    if {pair["orientation"] for pair in extracted} != {"h", "v"}:
+        return None
+    if {bool(pair["clipped"]) for pair in extracted} != {False, True}:
+        return None
+
+    return grid
+
