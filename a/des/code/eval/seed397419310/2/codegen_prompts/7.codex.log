+    footprint = set(seed_cells) | set(gap_cells) | set(left_path) | set(right_path)
+    return {
+        "orientation": "v",
+        "distance": distance,
+        "seed_cells": seed_cells,
+        "gap_cells": gap_cells,
+        "paths": [left_path, right_path],
+        "footprint": footprint,
+        "clipped": left_len < distance or right_len < distance,
