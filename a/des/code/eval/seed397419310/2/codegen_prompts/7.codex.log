+def _neighbors8(r: int, c: int, h: int, w: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < h and 0 <= cc < w:
+                yield rr, cc
+
+
+def _expand_cells(cells: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:
+    expanded = set(cells)
+    for r, c in list(cells):
+        for rr, cc in _neighbors8(r, c, h, w):
+            expanded.add((rr, cc))
+    return expanded
