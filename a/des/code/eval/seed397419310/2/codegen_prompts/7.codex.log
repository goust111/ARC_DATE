+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+GREY = 5
+SEED_COLORS = np.array([1, 2, 3, 6, 7, 8, 9], dtype=int)
+
+GEN_ATTEMPTS = 500
+MIN_SIDE = 12
+MAX_SIDE = 19
+PAIR_COUNT_MIN = 2
+PAIR_COUNT_MAX = 4
+MAX_GAP = 6
