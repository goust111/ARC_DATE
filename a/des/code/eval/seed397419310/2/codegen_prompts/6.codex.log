+    c0 = int(cols.min())
+    r1 = int(rows.max())
+    c1 = int(cols.max())
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+    if int(coords.shape[0]) != 2 * (h + w) - 4:
+        return None
+    actual = {(int(r), int(c)) for r, c in coords}
+    expected = {
+        (r, c)
+        for r in range(r0, r1 + 1)
+        for c in range(c0, c1 + 1)
+        if r in (r0, r1) or c in (c0, c1)
+    }
+    if actual != expected:
+        return None
+    return {
+        "color": int(color),
+        "bbox": (r0, c0, r1, c1),
+    }
+
+
+def _extract_frame_pairs(grid: np.ndarray) -> dict[int, list[dict]]:
