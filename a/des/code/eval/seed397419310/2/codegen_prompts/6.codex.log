+    frame_h = inner_h + 2
+    frame_w = inner_w + 2
+    bridge_min = max(MIN_BRIDGE, k + 1 if k else MIN_BRIDGE)
+    bridge_len = random.randint(bridge_min, bridge_min + MAX_BRIDGE_EXTRA)
