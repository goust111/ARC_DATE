+        dst_shape = (dst_r1 - dst_r0 - 1, dst_c1 - dst_c0 - 1)
+        assert rotated.shape == dst_shape, f"rotated interior shape mismatch for color {color}"
+        out[dst_r0 + 1 : dst_r1, dst_c0 + 1 : dst_c1] = rotated
