+        w_hi = min(GRID_MAX, max(w_lo, min_w + 10))
+        if h_lo > h_hi or w_lo > w_hi:
+            continue
+
+        h = random.randint(h_lo, h_hi)
+        w = random.randint(w_lo, w_hi)
+        inp = np.zeros((h, w), dtype=int)
+        out = np.zeros((h, w), dtype=int)
+
