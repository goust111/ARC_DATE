+import random
+
+import numpy as np
+
+
+BG = 0
+YELLOW = 4
+GREY = 5
+
+BORDER_COLOR_POOL = (1, 2, 3, 6, 7, 8, 9)
+
+MIN_PAIRS = 1
+MAX_PAIRS = 3
+MIN_INTERIOR = 2
+MAX_INTERIOR = 5
+MIN_BRIDGE = 2
+MAX_BRIDGE_EXTRA = 3
+GRID_MIN = 14
+GRID_MAX = 30
+MAX_PATTERN_ATTEMPTS = 200
+MAX_GENERATION_ATTEMPTS = 400
