+
+def _components4(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _frame_from_component(coords: np.ndarray, color: int) -> dict | None:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    r0 = int(rows.min())
+    c0 = int(cols.min())
+    r1 = int(rows.max())
+    c1 = int(cols.max())
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+    if int(coords.shape[0]) != 2 * (h + w) - 4:
+        return None
+    actual = {(int(r), int(c)) for r, c in coords}
+    expected = {
+        (r, c)
+        for r in range(r0, r1 + 1)
+        for c in range(c0, c1 + 1)
+        if r in (r0, r1) or c in (c0, c1)
+    }
+    if actual != expected:
+        return None
+    return {
+        "color": int(color),
+        "bbox": (r0, c0, r1, c1),
+    }
+
+
+def _extract_frame_pairs(grid: np.ndarray) -> dict[int, list[dict]]:
+    frames_by_color: dict[int, list[dict]] = {}
+    for color in map(int, np.unique(grid)):
+        if color in {BG, YELLOW, GREY}:
+            continue
+        frames = []
+        for comp in _components4(grid == color):
+            frame = _frame_from_component(comp, color)
+            if frame is not None:
+                frames.append(frame)
+        if frames:
+            assert len(frames) == 2, f"expected exactly two frames for color {color}"
+            frames_by_color[color] = sorted(frames, key=lambda f: f["bbox"])
+    assert frames_by_color, "expected at least one frame pair"
+    return frames_by_color
+
+
+def _find_bridge(grid: np.ndarray, color: int, a: dict, b: dict) -> dict:
+    ar0, ac0, ar1, ac1 = a["bbox"]
+    br0, bc0, br1, bc1 = b["bbox"]
+    bridge_colors = np.array([GREY, YELLOW], dtype=int)
+    options: list[dict] = []
+
+    if ac1 < bc0:
+        left, right = a, b
+    elif bc1 < ac0:
+        left, right = b, a
+    else:
+        left = right = None
+
+    if left is not None:
+        lr0, lc0, lr1, lc1 = left["bbox"]
+        rr0, rc0, rr1, rc1 = right["bbox"]
+        c_start = lc1 + 1
+        c_end = rc0 - 1
+        if c_start <= c_end:
+            for r in range(max(lr0, rr0), min(lr1, rr1) + 1):
+                seg = grid[r, c_start : c_end + 1]
+                if seg.size == 0:
+                    continue
+                if np.all(np.isin(seg, bridge_colors)):
+                    options.append(
+                        {
+                            "orientation": "h",
+                            "row": int(r),
+                            "c_start": int(c_start),
+                            "c_end": int(c_end),
+                            "markers": int(np.sum(seg == YELLOW)),
+                        }
+                    )
+
+    if ar1 < br0:
+        top, bottom = a, b
+    elif br1 < ar0:
+        top, bottom = b, a
+    else:
+        top = bottom = None
+
+    if top is not None:
+        tr0, tc0, tr1, tc1 = top["bbox"]
+        br0, bc0, br1, bc1 = bottom["bbox"]
+        r_start = tr1 + 1
+        r_end = br0 - 1
