+def _draw_frame(grid: np.ndarray, top: int, left: int, h: int, w: int, color: int) -> None:
+    grid[top, left : left + w] = color
+    grid[top + h - 1, left : left + w] = color
+    grid[top : top + h, left] = color
+    grid[top : top + h, left + w - 1] = color
