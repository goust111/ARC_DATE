+def _make_pair(border_color: int, pattern_palette: list[int], k: int) -> tuple[np.ndarray, np.ndarray]:
+    orientation = random.choice(("h", "v"))
+    if k % 2 == 1:
+        side = random.randint(MIN_INTERIOR, MAX_INTERIOR)
