+            gaps = [random.randint(2, 4) for _ in range(len(row) - 1)]
+            col_gaps.append(gaps)
+            row_heights.append(max(int(inp.shape[0]) for inp, _ in row))
+            row_widths.append(sum(int(inp.shape[1]) for inp, _ in row) + sum(gaps))
