+                if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
+                    candidates.add((int(nr), int(nc)))
+        nr, nc = random.choice(tuple(candidates))
+        mask[nr, nc] = True
+        frontier.add((nr, nc))
+    return mask
