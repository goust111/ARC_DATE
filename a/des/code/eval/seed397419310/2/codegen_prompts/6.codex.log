+def _find_bridge(grid: np.ndarray, color: int, a: dict, b: dict) -> dict:
+    ar0, ac0, ar1, ac1 = a["bbox"]
+    br0, bc0, br1, bc1 = b["bbox"]
+    bridge_colors = np.array([GREY, YELLOW], dtype=int)
+    options: list[dict] = []
+
+    if ac1 < bc0:
+        left, right = a, b
+    elif bc1 < ac0:
+        left, right = b, a
+    else:
+        left = right = None
+
+    if left is not None:
+        lr0, lc0, lr1, lc1 = left["bbox"]
+        rr0, rc0, rr1, rc1 = right["bbox"]
+        c_start = lc1 + 1
+        c_end = rc0 - 1
+        if c_start <= c_end:
+            for r in range(max(lr0, rr0), min(lr1, rr1) + 1):
+                seg = grid[r, c_start : c_end + 1]
+                if seg.size == 0:
+                    continue
+                if np.all(np.isin(seg, bridge_colors)):
+                    options.append(
+                        {
+                            "orientation": "h",
+                            "row": int(r),
+                            "c_start": int(c_start),
+                            "c_end": int(c_end),
+                            "markers": int(np.sum(seg == YELLOW)),
+                        }
+                    )
+
+    if ar1 < br0:
+        top, bottom = a, b
+    elif br1 < ar0:
+        top, bottom = b, a
+    else:
+        top = bottom = None
+
+    if top is not None:
+        tr0, tc0, tr1, tc1 = top["bbox"]
+        br0, bc0, br1, bc1 = bottom["bbox"]
+        r_start = tr1 + 1
+        r_end = br0 - 1
+        if r_start <= r_end:
+            for c in range(max(tc0, bc0), min(tc1, bc1) + 1):
+                seg = grid[r_start : r_end + 1, c]
+                if seg.size == 0:
+                    continue
+                if np.all(np.isin(seg, bridge_colors)):
+                    options.append(
+                        {
+                            "orientation": "v",
+                            "col": int(c),
+                            "r_start": int(r_start),
+                            "r_end": int(r_end),
+                            "markers": int(np.sum(seg == YELLOW)),
+                        }
+                    )
+
+    assert len(options) == 1, f"expected a unique bridge for color {color}"
+    return options[0]
