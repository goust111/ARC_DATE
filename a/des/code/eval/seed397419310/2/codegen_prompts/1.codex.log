+
+
+def _random_pattern(rng: np.random.Generator) -> list[tuple[int, int]]:
+    noncenter = [offset for offset in NON_LABEL_OFFSETS if offset != (0, 0)]
+    count = int(rng.integers(1, len(noncenter) + 1))
