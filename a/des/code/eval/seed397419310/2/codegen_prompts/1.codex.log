+        for cc in range(c0, c1 + 1):
+            perimeter.add((r0, cc))
+            perimeter.add((r1, cc))
+        for rr in range(r0 + 1, r1):
+            perimeter.add((rr, c0))
+            perimeter.add((rr, c1))
+
+        is_ring = True
+        for rr, cc in perimeter:
