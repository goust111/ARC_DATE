+    out = np.full((r1 - r0 + 1, c1 - c0 + 1), BLACK, dtype=int)
+    inner_color = int(inner["color"])
+    out[0, :] = inner_color
+    out[-1, :] = inner_color
+    out[:, 0] = inner_color
+    out[:, -1] = inner_color
