+                        "color": int(color),
+                        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                        "area": int((r1 - r0 + 1) * (c1 - c0 + 1)),
+                    }
+                )
+    frames.sort(key=lambda item: (-int(item["area"]), item["bbox"]))
