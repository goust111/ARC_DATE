+from __future__ import annotations
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+AZURE = 8
+MAROON = 9
+
+PATH_COLORS = (BLUE, RED, GREEN, MAGENTA, ORANGE)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+COUNT_OPTIONS = tuple(range(2, 8))
+SIZE_OPTIONS = (
+    (2, 3),
+    (2, 4),
+    (2, 5),
+    (2, 6),
+    (3, 3),
+    (3, 4),
+    (3, 5),
+    (3, 6),
+    (3, 7),
+    (4, 4),
+    (4, 5),
+    (4, 6),
+    (4, 7),
+)
+PATCH_SIZE_OPTIONS = (
+    (5, 6),
+    (5, 7),
+    (6, 6),
+    (6, 7),
+    (6, 8),
+    (7, 7),
+    (7, 8),
+    (8, 8),
+    (8, 9),
+)
+GEN_ATTEMPTS = 500
