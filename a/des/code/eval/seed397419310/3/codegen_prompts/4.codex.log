+
+    legend = _make_legend_patch(cases)
+    lh, lw = legend.shape
+    H_min = max(lh + 2, 20)
+    W_min = max(lw + 15, 24)
+    H_max = max(H_min, 28)
+    W_max = max(W_min, 32)
