+    else:
+        special_shape = random.choice(ROTATE_SHAPES)
+
+    other_shapes = [name for name in SHAPES if name != special_shape]
+    chosen_shapes = [special_shape] + random.sample(other_shapes, n_entries - 1)
+    random.shuffle(chosen_shapes)
