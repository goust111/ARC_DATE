+
+        markers_by_size: dict[int, list[np.ndarray]] = {2: [], 3: []}
+        for size in candidate_sizes:
+            for subset in combinations(near_wall, size):
+                if not _is_connected_subset(subset):
+                    continue
+                marker = np.zeros((ih, iw), dtype=bool)
+                for r, c in subset:
+                    marker[r, c] = True
