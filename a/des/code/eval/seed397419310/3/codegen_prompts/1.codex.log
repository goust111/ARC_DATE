+
+            frames.append(candidate)
+            state["halos"] |= candidate["halo"]
+            state["input_cells"] |= set(candidate["grey_cells"]) | {candidate["seed"]}
+            state["output_cells"] |= candidate["output_cells"]
+            state["barriers"] |= candidate["border_all"]
