+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+SIDES = ("top", "bottom", "left", "right")
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+# --------------- solver ---------------
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _rect_border(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    cells = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _segment_cells(start: tuple[int, int], end: tuple[int, int]) -> set[tuple[int, int]]:
+    (r0, c0), (r1, c1) = start, end
+    cells = set()
+    if r0 == r1:
+        step = 1 if c1 >= c0 else -1
+        for c in range(c0, c1 + step, step):
+            cells.add((r0, c))
+        return cells
+    if c0 == c1:
+        step = 1 if r1 >= r0 else -1
+        for r in range(r0, r1 + step, step):
+            cells.add((r, c0))
+        return cells
+    raise ValueError("segment must be axis-aligned")
+
+
+def _trunk_cells(seed: tuple[int, int], center: tuple[int, int]) -> set[tuple[int, int]]:
+    sr, sc = seed
+    cr, cc = center
+    cells = _segment_cells((sr, sc), (sr, cc))
+    cells |= _segment_cells((sr, cc), (cr, cc))
+    return cells
+
+
+def _branch_cells(center: tuple[int, int], side: str, shape: tuple[int, int]) -> set[tuple[int, int]]:
+    h, w = shape
+    cr, cc = center
+    if side == "top":
+        return _segment_cells((cr, cc), (0, cc))
+    if side == "bottom":
+        return _segment_cells((cr, cc), (h - 1, cc))
+    if side == "left":
+        return _segment_cells((cr, cc), (cr, 0))
+    if side == "right":
+        return _segment_cells((cr, cc), (cr, w - 1))
+    raise ValueError(f"unknown side: {side}")
+
+
+def _analyze_frame(grid: np.ndarray, coords: np.ndarray) -> dict:
+    h, w = grid.shape
+    r0, c0, r1, c1 = _bbox(coords)
+    assert r1 - r0 >= 4 and c1 - c0 >= 4, "frame bbox too small"
+
+    border = _rect_border(r0, c0, r1, c1)
+    actual = {(int(r), int(c)) for r, c in coords}
+    assert actual <= border, "grey component must lie on a rectangle perimeter"
+
+    center = ((r0 + r1) // 2, (c0 + c1) // 2)
+    cr, cc = center
+    assert r0 < cr < r1 and c0 < cc < c1, "frame must have an interior center cell"
+
+    missing = sorted(border - actual)
+    assert 1 <= len(missing) <= 3, "expected 1 to 3 perimeter gaps"
+
+    corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
+    sides = []
+    seen_sides = set()
+    for gap in missing:
+        gr, gc = gap
+        assert gap not in corners, "gaps must not remove corners"
+        if gr == r0:
+            side = "top"
+            assert gc == cc, "top gap must align with center column"
+        elif gr == r1:
+            side = "bottom"
+            assert gc == cc, "bottom gap must align with center column"
+        elif gc == c0:
+            side = "left"
+            assert gr == cr, "left gap must align with center row"
+        elif gc == c1:
+            side = "right"
+            assert gr == cr, "right gap must align with center row"
+        else:
+            raise AssertionError("gaps must lie on the perimeter")
+        assert side not in seen_sides, "at most one gap per side"
+        seen_sides.add(side)
+        sides.append(side)
+
+    inner = grid[r0 + 1 : r1, c0 + 1 : c1]
+    seed_mask = (inner != BG) & (inner != FRAME)
+    seed_coords = np.argwhere(seed_mask)
+    assert seed_coords.shape == (1, 2), "each frame interior must contain one seed"
+    assert bool(np.all(inner[~seed_mask] == BG)), "non-seed interior must be black"
+    seed_r, seed_c = map(int, seed_coords[0])
+    seed = (r0 + 1 + seed_r, c0 + 1 + seed_c)
+
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "center": center,
+        "seed": seed,
+        "color": int(grid[seed]),
+        "sides": tuple(sides),
+        "border": border,
+    }
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Grow a colored trunk from each seed to its frame center, then send one
+    branch ray from that center through each frame gap out to the grid edge.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    frames = [_analyze_frame(g, comp) for comp in _components(g == FRAME)]
+    assert frames, "expected at least one grey frame"
+
+    out = g.copy()
+    for frame in frames:
+        color = int(frame["color"])
+        trunk = _trunk_cells(frame["seed"], frame["center"])
+        branches = set()
+        for side in frame["sides"]:
+            branches |= _branch_cells(frame["center"], side, g.shape)
+        for r, c in trunk | branches:
+            if g[r, c] != FRAME:
+                out[r, c] = color
+    return out
+
+
+# --------------- generator ---------------
+
+GRID_SIDE_RANGE = (18, 28)
+FRAME_COUNT_RANGE = (1, 3)
+FRAME_SIZE_OPTIONS = (5, 7, 9)
+MAX_ATTEMPTS = 400
+FRAME_TRIES = 300
+HALO_PAD = 1
+
+
+def _expanded_box_cells(
+    r0: int, c0: int, r1: int, c1: int, h: int, w: int, pad: int
+) -> set[tuple[int, int]]:
+    cells = set()
+    for r in range(max(0, r0 - pad), min(h - 1, r1 + pad) + 1):
+        for c in range(max(0, c0 - pad), min(w - 1, c1 + pad) + 1):
+            cells.add((r, c))
+    return cells
+
+
+def _gap_cell(r0: int, c0: int, r1: int, c1: int, side: str) -> tuple[int, int]:
+    cr = (r0 + r1) // 2
+    cc = (c0 + c1) // 2
+    if side == "top":
+        return (r0, cc)
+    if side == "bottom":
+        return (r1, cc)
+    if side == "left":
+        return (cr, c0)
+    if side == "right":
+        return (cr, c1)
+    raise ValueError(f"unknown side: {side}")
+
+
+def _candidate_frame(
+    h: int, w: int, color: int, force_off_center: bool
+) -> dict | None:
+    fh = random.choice(FRAME_SIZE_OPTIONS)
+    fw = random.choice(FRAME_SIZE_OPTIONS)
+    if fh + 2 >= h or fw + 2 >= w:
+        return None
+
+    r0 = random.randint(1, h - fh - 1)
+    c0 = random.randint(1, w - fw - 1)
+    r1 = r0 + fh - 1
+    c1 = c0 + fw - 1
+    center = ((r0 + r1) // 2, (c0 + c1) // 2)
+
+    gap_count = random.randint(1, 3)
+    sides = tuple(random.sample(SIDES, gap_count))
+    border_all = _rect_border(r0, c0, r1, c1)
+    gaps = {_gap_cell(r0, c0, r1, c1, side) for side in sides}
+    grey_cells = border_all - gaps
+
+    inner_cells = [
+        (r, c)
+        for r in range(r0 + 1, r1)
+        for c in range(c0 + 1, c1)
+    ]
+    if force_off_center:
+        seed_options = [cell for cell in inner_cells if cell != center]
+        if not seed_options:
+            return None
+    else:
+        if random.random() < 0.4:
+            seed_options = [center]
+        else:
+            seed_options = [cell for cell in inner_cells if cell != center]
+            if not seed_options:
+                seed_options = [center]
+    seed = random.choice(seed_options)
