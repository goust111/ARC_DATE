+
+
+# --------------- generator ---------------
+
+GRID_SIDE_RANGE = (18, 28)
+FRAME_COUNT_RANGE = (1, 3)
+FRAME_SIZE_OPTIONS = (5, 7, 9)
+MAX_ATTEMPTS = 400
+FRAME_TRIES = 300
+HALO_PAD = 1
+
