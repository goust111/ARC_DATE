+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+SIDES = ("top", "bottom", "left", "right")
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+# --------------- solver ---------------
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _rect_border(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    cells = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _segment_cells(start: tuple[int, int], end: tuple[int, int]) -> set[tuple[int, int]]:
+    (r0, c0), (r1, c1) = start, end
+    cells = set()
+    if r0 == r1:
+        step = 1 if c1 >= c0 else -1
+        for c in range(c0, c1 + step, step):
+            cells.add((r0, c))
+        return cells
+    if c0 == c1:
+        step = 1 if r1 >= r0 else -1
+        for r in range(r0, r1 + step, step):
+            cells.add((r, c0))
+        return cells
+    raise ValueError("segment must be axis-aligned")
+
+
+def _trunk_cells(seed: tuple[int, int], center: tuple[int, int]) -> set[tuple[int, int]]:
+    sr, sc = seed
+    cr, cc = center
+    cells = _segment_cells((sr, sc), (sr, cc))
+    cells |= _segment_cells((sr, cc), (cr, cc))
+    return cells
+
+
+def _branch_cells(center: tuple[int, int], side: str, shape: tuple[int, int]) -> set[tuple[int, int]]:
+    h, w = shape
+    cr, cc = center
+    if side == "top":
+        return _segment_cells((cr, cc), (0, cc))
+    if side == "bottom":
+        return _segment_cells((cr, cc), (h - 1, cc))
+    if side == "left":
+        return _segment_cells((cr, cc), (cr, 0))
+    if side == "right":
+        return _segment_cells((cr, cc), (cr, w - 1))
+    raise ValueError(f"unknown side: {side}")
+
+
+def _analyze_frame(grid: np.ndarray, coords: np.ndarray) -> dict:
+    h, w = grid.shape
+    r0, c0, r1, c1 = _bbox(coords)
+    assert r1 - r0 >= 4 and c1 - c0 >= 4, "frame bbox too small"
+
+    border = _rect_border(r0, c0, r1, c1)
+    actual = {(int(r), int(c)) for r, c in coords}
+    assert actual <= border, "grey component must lie on a rectangle perimeter"
+
+    center = ((r0 + r1) // 2, (c0 + c1) // 2)
+    cr, cc = center
+    assert r0 < cr < r1 and c0 < cc < c1, "frame must have an interior center cell"
+
+    missing = sorted(border - actual)
+    assert 1 <= len(missing) <= 3, "expected 1 to 3 perimeter gaps"
+
+    corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
+    sides = []
+    seen_sides = set()
+    for gap in missing:
+        gr, gc = gap
+        assert gap not in corners, "gaps must not remove corners"
+        if gr == r0:
+            side = "top"
+            assert gc == cc, "top gap must align with center column"
+        elif gr == r1:
+            side = "bottom"
+            assert gc == cc, "bottom gap must align with center column"
+        elif gc == c0:
+            side = "left"
+            assert gr == cr, "left gap must align with center row"
+        elif gc == c1:
+            side = "right"
+            assert gr == cr, "right gap must align with center row"
+        else:
+            raise AssertionError("gaps must lie on the perimeter")
+        assert side not in seen_sides, "at most one gap per side"
+        seen_sides.add(side)
+        sides.append(side)
