+def _segment_cells(start: tuple[int, int], end: tuple[int, int]) -> set[tuple[int, int]]:
+    (r0, c0), (r1, c1) = start, end
+    cells = set()
+    if r0 == r1:
+        step = 1 if c1 >= c0 else -1
+        for c in range(c0, c1 + step, step):
+            cells.add((r0, c))
+        return cells
+    if c0 == c1:
+        step = 1 if r1 >= r0 else -1
+        for r in range(r0, r1 + step, step):
