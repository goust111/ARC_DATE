+) -> list[tuple[int, int]]:
+    dr, dc = _ray_direction(side)
+    r, c = gap[0] + dr, gap[1] + dc
+    cells: list[tuple[int, int]] = []
+    while 0 <= r < h and 0 <= c < w:
+        cells.append((r, c))
+        r += dr
+        c += dc
+    return cells
+
+
+def _draw_object(
