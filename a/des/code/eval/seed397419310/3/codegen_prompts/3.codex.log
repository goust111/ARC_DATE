+GRID_MAX = 30
+OBJECT_COUNT_OPTIONS = (1, 2, 3, 4)
+OBJECT_COUNT_WEIGHTS = (3, 4, 3, 2)
+RECT_H_RANGE = (5, 10)
+RECT_W_RANGE = (5, 10)
+GAP_COUNT_RANGE = (1, 3)
