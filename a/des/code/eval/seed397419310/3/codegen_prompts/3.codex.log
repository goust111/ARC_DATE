+
+def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in cells]
+    cols = [c for _r, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _perimeter_cells(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    cells: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        if r1 != r0:
+            cells.append((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        if c1 != c0:
+            cells.append((r, c1))
+    return cells
+
+
+def _gap_side(gap: tuple[int, int], bbox: tuple[int, int, int, int]) -> str:
+    r, c = gap
+    r0, c0, r1, c1 = bbox
+    if r == r0:
+        return "top"
+    if r == r1:
+        return "bottom"
+    if c == c0:
+        return "left"
+    if c == c1:
+        return "right"
+    raise AssertionError(f"gap {gap} is not on bbox perimeter {bbox}")
+
+
+def _ray_direction(side: str) -> tuple[int, int]:
+    if side == "top":
+        return -1, 0
+    if side == "bottom":
+        return 1, 0
+    if side == "left":
