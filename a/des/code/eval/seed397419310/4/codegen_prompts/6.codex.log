            paste(grid, panel, pr * PANEL_STRIDE, pc * PANEL_STRIDE)
            paste(expected, out_panel, pr * PANEL_STRIDE, pc * PANEL_STRIDE)

    return grid if _matches_solver(grid, expected) else None



