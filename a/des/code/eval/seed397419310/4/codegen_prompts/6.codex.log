+        bottom_count = _pattern_count(bottom, bg)
+        if top_count < bottom_count:
+            return "top"
+        if bottom_count < top_count:
+            return "bottom"
+        if top.shape[0] <= bottom.shape[0]:
+            return "top"
+        return "bottom"
