+
+def _current_fold_lines(grid: np.ndarray) -> list[dict[str, int | str]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    lines: list[dict[str, int | str]] = []
+    for r in range(h):
+        if np.all(g[r, :] == RED):
+            lines.append({"orientation": "H", "index": int(r)})
+    for c in range(w):
+        if np.all(g[:, c] == RED):
+            lines.append({"orientation": "V", "index": int(c)})
+    return lines
