+    for c in range(w):
+        if np.all(g[:, c] == RED):
+            lines.append({"orientation": "V", "index": int(c)})
+    return lines
+
+
+def _pattern_count(region: np.ndarray, bg: int) -> int:
+    arr = np.asarray(region, dtype=int)
+    return int(np.count_nonzero((arr != bg) & (arr != RED)))
