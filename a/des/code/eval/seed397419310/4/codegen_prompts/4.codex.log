+    mid_r = (r0 + r1) // 2
+    mid_c = (c0 + c1) // 2
+    if direction == (-1, 0):
+        return r0, mid_c
+    if direction == (1, 0):
+        return r1, mid_c
+    if direction == (0, -1):
