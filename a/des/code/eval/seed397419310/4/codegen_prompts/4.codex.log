+
+def _divider_spans(indices: list[int], limit: int) -> list[tuple[int, int]]:
+    marks = [-1] + sorted(indices) + [limit]
+    spans = []
+    for left, right in zip(marks, marks[1:]):
+        if left + 1 <= right - 1:
+            spans.append((left + 1, right - 1))
+    return spans
