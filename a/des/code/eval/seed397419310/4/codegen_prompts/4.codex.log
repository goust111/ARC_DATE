+def _bfs_path(
+    src: tuple[int, int],
+    dst: tuple[int, int],
+    n_rows: int,
+    n_cols: int,
+    blocked: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    blocked = set(blocked)
+    blocked.discard(src)
+    blocked.discard(dst)
+    queue = deque([src])
+    prev = {src: None}
+    while queue:
+        cur = queue.popleft()
