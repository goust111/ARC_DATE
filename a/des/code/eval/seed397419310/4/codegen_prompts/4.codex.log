+
+GREEN = 3
+RED = 2
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+COLOR_POOL = [0, 1, 4, 5, 6, 7, 8, 9]
+GEN_RETRIES = 400
