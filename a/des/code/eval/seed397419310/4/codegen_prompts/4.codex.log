+    if not red_cells:
+        return None
+    if len(red_cells) != 1:
+        raise ValueError("each region must contain at most one red sign")
+    r, c = red_cells[0]
+    if r == r0 and c0 < c < c1:
+        return (-1, 0)
+    if r == r1 and c0 < c < c1:
+        return (1, 0)
+    if c == c0 and r0 < r < r1:
