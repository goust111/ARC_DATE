+
+
+def _outward_dirs(region: tuple[int, int], n_rows: int, n_cols: int) -> list[tuple[int, int]]:
+    r, c = region
+    dirs = []
+    if r == 0:
+        dirs.append((-1, 0))
+    if r == n_rows - 1:
+        dirs.append((1, 0))
+    if c == 0:
+        dirs.append((0, -1))
+    if c == n_cols - 1:
+        dirs.append((0, 1))
