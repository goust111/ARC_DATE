+    mid_c = (c0 + c1) // 2
+    if direction == (-1, 0):
+        return r0, mid_c
+    if direction == (1, 0):
+        return r1, mid_c
+    if direction == (0, -1):
+        return mid_r, c0
+    if direction == (0, 1):
