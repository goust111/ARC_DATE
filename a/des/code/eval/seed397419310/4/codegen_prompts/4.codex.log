+        col_hits = sum(bool(np.all(grid[:, c] == GREEN)) for c in range(grid.shape[1]))
+        if row_hits and col_hits:
+            return GREEN
+
+    best = None
+    for color in np.unique(grid):
+        color = int(color)
+        if color == bg:
