+        gr = int(top + rr)
+        gc = int(left + cc)
+        r0 = max(0, int(gr - pad))
+        r1 = min(H, int(gr + pad + 1))
+        c0 = max(0, int(gc - pad))
+        c1 = min(W, int(gc + pad + 1))
