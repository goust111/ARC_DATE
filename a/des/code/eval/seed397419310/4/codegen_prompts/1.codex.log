+    max_r = max(int(r) for r, _c in cells)
+    min_c = min(int(c) for _r, c in cells)
+    max_c = max(int(c) for _r, c in cells)
+
+    lo_r = int(-min_r)
+    hi_r = int(H - 1 - max_r)
+    lo_c = int(-min_c)
+    hi_c = int(W - 1 - max_c)
+    if lo_r > hi_r or lo_c > hi_c:
+        return None
