+
+    if _most_common_color(grid) != bg:
+        return None
+
+    depths = [frame["depth"] for frame in frame_records]
+    if depths.count(max(depths)) != 1:
+        return None
+
+    expected = _render_expected(grid, palette_row, palette_col, palette_colors, frame_records, main_depth)
+    try:
