import random
from collections import deque

def conn(cells,h,w):
    if not cells: return False
    s=set(cells)
    q=deque([next(iter(s))]); seen={q[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
            rr,cc=r+dr,c+dc
            if (rr,cc) in s and (rr,cc) not in seen:
                seen.add((rr,cc)); q.append((rr,cc))
    return len(seen)==len(s)

def full_bbox(cells,h,w):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1

def grow(h,w,k):
    cell=(random.randrange(h),random.randrange(w))
    s={cell}
    while len(s)<k:
        frontier=[]
        for r,c in list(s):
            for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
                rr,cc=r+dr,c+dc
                if 0<=rr<h and 0<=cc<w and (rr,cc) not in s:
                    frontier.append((rr,cc))
        if not frontier: return None
        s.add(random.choice(frontier))
    return s

for h in range(3,7):
  for w in range(3,9):
    n=h*w
    ok=0
    for _ in range(5000):
      k=random.randint(max(4,n//3), min(n-4,2*n//3))
      s=grow(h,w,k)
      if not s: continue
      t={(r,c) for r in range(h) for c in range(w)}-s
      if full_bbox(s,h,w) and full_bbox(t,h,w) and conn(t,h,w):
        ok+=1
    if ok:
      print((h,w),ok)
