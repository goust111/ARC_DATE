    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1

def gen(h,w,tries=50):
  all_cells={(r,c) for r in range(h) for c in range(w)}
  lo=max(4,h+w-2)
  hi=min(h*w-4, h*w-(h+w-2))
  if lo>hi:
    return None
  for _ in range(tries):
    target=random.randint(lo, hi)
    seed=random.choice(list(all_cells))
    A={seed}; B=all_cells-{seed}
    while len(A)<target:
      frontier=[]; seen=set()
      for r,c in list(A):
        for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
          t=(r+dr,c+dc)
          if t in B and t not in seen:
            seen.add(t); frontier.append(t)
      good=[]
      for t in frontier:
        B2=B-{t}
        if conn(B2):
          good.append(t)
      if not good:
