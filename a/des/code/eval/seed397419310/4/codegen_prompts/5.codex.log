from collections import deque

def conn(cells):
    s=set(cells)
    if not s: return False
    q=deque([next(iter(s))]); seen={q[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
            t=(r+dr,c+dc)
            if t in s and t not in seen:
                seen.add(t); q.append(t)
