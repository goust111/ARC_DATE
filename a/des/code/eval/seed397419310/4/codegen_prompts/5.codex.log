+def _place_pieces(grid_shape: tuple[int, int], pieces: list[dict]) -> np.ndarray | None:
+    h, w = grid_shape
+    grid = np.full((h, w), BG, dtype=int)
+    grid[-1, :] = GROUND
+    blocked = np.zeros((h - 1, w), dtype=bool)
