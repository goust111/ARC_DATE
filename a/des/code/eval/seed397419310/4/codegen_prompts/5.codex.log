import z3

def solve(h,w):
    N=h*w
    idx=lambda r,c:r*w+c
    x=[[z3.Bool(f'x_{r}_{c}') for c in range(w)] for r in range(h)]
    ordA=[[z3.Int(f'a_{r}_{c}') for c in range(w)] for r in range(h)]
    ordB=[[z3.Int(f'b_{r}_{c}') for c in range(w)] for r in range(h)]
    rootA=[[z3.Bool(f'ra_{r}_{c}') for c in range(w)] for r in range(h)]
    rootB=[[z3.Bool(f'rb_{r}_{c}') for c in range(w)] for r in range(h)]
    s=z3.Solver()
    cells=[x[r][c] for r in range(h) for c in range(w)]
    s.add(z3.PbGe([(v,1) for v in cells],1))
    s.add(z3.PbLe([(v,1) for v in cells],N-1))
    # touch all sides for both A and B
    for sideA,sideB in [
        ([x[0][c] for c in range(w)], [z3.Not(x[0][c]) for c in range(w)]),
        ([x[h-1][c] for c in range(w)], [z3.Not(x[h-1][c]) for c in range(w)]),
        ([x[r][0] for r in range(h)], [z3.Not(x[r][0]) for r in range(h)]),
        ([x[r][w-1] for r in range(h)], [z3.Not(x[r][w-1]) for r in range(h)]),
    ]:
        s.add(z3.Or(sideA))
        s.add(z3.Or(sideB))
    # exactly one root in A and B
    s.add(z3.PbEq([(rootA[r][c],1) for r in range(h) for c in range(w)],1))
    s.add(z3.PbEq([(rootB[r][c],1) for r in range(h) for c in range(w)],1))
    for r in range(h):
        for c in range(w):
            s.add(z3.Implies(rootA[r][c], x[r][c]))
            s.add(z3.Implies(rootB[r][c], z3.Not(x[r][c])))
            s.add(z3.Implies(x[r][c], z3.And(ordA[r][c] >= 0, ordA[r][c] < N)))
            s.add(z3.Implies(z3.Not(x[r][c]), ordA[r][c] == -1))
            s.add(z3.Implies(z3.Not(x[r][c]), z3.And(ordB[r][c] >= 0, ordB[r][c] < N)))
            s.add(z3.Implies(x[r][c], ordB[r][c] == -1))
            s.add(z3.Implies(rootA[r][c], ordA[r][c] == 0))
            s.add(z3.Implies(rootB[r][c], ordB[r][c] == 0))
            nA=[]; nB=[]
            for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
                rr,cc=r+dr,c+dc
                if 0<=rr<h and 0<=cc<w:
                    nA.append(z3.And(x[rr][cc], ordA[rr][cc] < ordA[r][c]))
                    nB.append(z3.And(z3.Not(x[rr][cc]), ordB[rr][cc] < ordB[r][c]))
            s.add(z3.Implies(z3.And(x[r][c], z3.Not(rootA[r][c])), z3.Or(nA)))
            s.add(z3.Implies(z3.And(z3.Not(x[r][c]), z3.Not(rootB[r][c])), z3.Or(nB)))
    if s.check()"'!=z3.sat:
        return None
    m=s.model()
    grid=[[1 if z3.is_true(m[x[r][c]]) else 0 for c in range(w)] for r in range(h)]
    return grid

for h,w in [(4,4),(4,5),(5,4),(5,5),(5,6),(6,6),(6,7),(7,7)]:
    g=solve(h,w)
    print('"'dims',h,w,'sat',g is not None)
