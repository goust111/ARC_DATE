        sa=len({0 if r==0 else 1 if r==h-1 else 2 if c==0 else 3 if c==w-1 else 9 for r,c in A2} & {0,1,2,3})
        sb=len({0 if r==0 else 1 if r==h-1 else 2 if c==0 else 3 if c==w-1 else 9 for r,c in B2} & {0,1,2,3})
        return (sa+sb, random.random())
      good.sort(key=score, reverse=True)
      t=good[0]
      A.add(t); B.remove(t)
    if len(A)==target and full_bbox(A,h,w) and full_bbox(B,h,w):
      return A,B
  return None

for dims in [(4,4),(4,5),(5,4),(5,5),(6,6)]:
  h,w=dims
  cnt=0
  for _ in range(20):
    if gen(h,w): cnt+=1
  print(dims,cnt)
