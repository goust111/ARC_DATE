    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1

def search(h,w,outer=100,steps=200):
    all_cells={(r,c) for r in range(h) for c in range(w)}
    for _ in range(outer):
        A={(0,0)}
        B=all_cells-A
        frontier=[(0,1),(1,0)]
        while len(A)<h*w-1 and steps>0:
            steps-=1
            cand=[]
            seen=set()
            for r,c in list(A):
