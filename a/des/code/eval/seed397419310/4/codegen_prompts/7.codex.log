+            return None
+        if mode == "clipped_overlap" and overlap <= legend_len:
+            return None
+        if mode == "plain_overlap" and overlap > legend_len:
+            return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
