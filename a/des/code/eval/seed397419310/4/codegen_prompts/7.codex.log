+
+
+def _sample_mode() -> str:
+    roll = random.random()
+    if roll < 0.35:
+        return "clipped_overlap"
+    if roll < 0.7:
+        return "plain_overlap"
+    return "scatter"
+
+
+def _sample_tower_count(mode: str) -> int:
