+    if mode == "plain_overlap":
+        return random.randint(2, min(4, TOWER_COUNT_RANGE[1]))
+    return random.randint(*TOWER_COUNT_RANGE)
+
+
+def _sample_legend_len(mode: str, n_towers: int) -> int:
