+    owner: dict[tuple[int, int], int] = {}
+    for idx, wall in enumerate(walls):
+        for cell in wall["interior"]:
+            assert cell not in owner
+            owner[cell] = idx
+
+    seeds = _seed_pixels(seed_half, seed_offset, bg, divider)
+    assert seeds
