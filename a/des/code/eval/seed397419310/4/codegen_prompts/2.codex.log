+    values, counts = np.unique(grid, return_counts=True)
+    order = np.argsort(-counts)
+    if len(order) < 2 or counts[order[0]] == counts[order[1]]:
+        return None
+    if int(values[order[0]]) != bg:
+        return None
+
+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+
+    if np.array_equal(out, grid):
+        return None
+    return grid
