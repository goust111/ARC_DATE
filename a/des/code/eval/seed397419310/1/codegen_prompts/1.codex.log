+        frame_h = int(spec["frame_h"])
+        frame_w = int(spec["frame_w"])
+        grid[fr0, fc0 : fc0 + frame_w] = FRAME
+        grid[fr0 + frame_h - 1, fc0 : fc0 + frame_w] = FRAME
+        grid[fr0 : fr0 + frame_h, fc0] = FRAME
+        grid[fr0 : fr0 + frame_h, fc0 + frame_w - 1] = FRAME
