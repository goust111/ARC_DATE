+                cc = seed_c + signs[1] * (copy_idx * step_w + sc)
+                if not (ir0 <= rr <= ir1 and ic0 <= cc <= ic1):
+                    pts = []
+                    break
+                pts.append((rr, cc))
+            if not pts:
+                break
+            for rr, cc in pts:
+                out[rr, cc] = color
+            copy_idx += 1
+
+    return out
+
+
+def _place_rect(
+    rng: random.Random,
+    occupied: np.ndarray,
+    rect_h: int,
+    rect_w: int,
+    pad: int,
+    tries: int = 200,
+) -> tuple[int, int] | None:
+    h, w = occupied.shape
