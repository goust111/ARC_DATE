+        "quadrant": quadrant,
+        "shape": shape,
+        "inner_h": inner_h,
+        "inner_w": inner_w,
+        "frame_h": inner_h + 2,
+        "frame_w": inner_w + 2,
+        "seed_rel": (seed_r, seed_c),
+        "copies": copies,
+    }
