+    return r0 <= r <= r1 and c0 <= c <= c1
+
+
+def _relative_quadrant(r: int, c: int, inner_h: int, inner_w: int) -> str | None:
+    top = 2 * r + 1 < inner_h
+    bottom = 2 * r + 1 > inner_h
+    left = 2 * c + 1 < inner_w
+    right = 2 * c + 1 > inner_w
+    if not (top or bottom) or not (left or right):
+        return None
+    if top and left:
+        return "TL"
+    if top and right:
+        return "TR"
+    if bottom and left:
+        return "BL"
+    if bottom and right:
+        return "BR"
+    return None
