+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(cells: Iterable[tuple[int, int]]) -> tuple[int, int, int, int]:
+    coords = list(cells)
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_legend(grid: np.ndarray) -> tuple[tuple[int, int, int, int], dict[frozenset[int], int], set[int]]:
+    maroon_comps = _components(grid == MAROON)
+    candidates: list[tuple[int, int, int, int]] = []
+    for comp in maroon_comps:
+        r0, c0, r1, c1 = _bbox(comp)
+        if r1 - r0 < 2 or c1 - c0 < 2:
+            continue
+        ok = True
+        for r in range(r0, r1 + 1):
+            for c in range(c0, c1 + 1):
+                border = r in (r0, r1) or c in (c0, c1)
+                if border:
+                    if int(grid[r, c]) != MAROON:
+                        ok = False
+                        break
+                else:
+                    if int(grid[r, c]) == MAROON:
+                        ok = False
+                        break
