+            cells.add((tr, c))
+        for r in range(min(tr, hr), max(tr, hr) + 1):
+            cells.add((r, hc))
+    return cells
+
+
+def _dilate(cells: set[tuple[int, int]], shape: tuple[int, int], radius: int = 1) -> set[tuple[int, int]]:
+    h, w = shape
+    expanded: set[tuple[int, int]] = set()
+    for r, c in cells:
