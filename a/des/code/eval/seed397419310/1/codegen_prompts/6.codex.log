+                deg += 1
+        degrees[(r, c)] = deg
+    return degrees
+
+
+def _valid_component(
+    shape: tuple[int, int],
+    pipe_cells: set[tuple[int, int]],
+    markers: dict[tuple[int, int], int],
+    occupied: set[tuple[int, int]],
+    blocked: set[tuple[int, int]],
