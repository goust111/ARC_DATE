+    pair_map: dict[frozenset[int], int] = {}
+    primaries: set[int] = set()
+    for row in inner:
+        a, b, result = map(int, row)
+        pair_map[frozenset((a, b))] = result
+        primaries.add(a)
+        primaries.add(b)
