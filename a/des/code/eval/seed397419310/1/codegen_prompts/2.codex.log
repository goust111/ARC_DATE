+
+
+def _marker_cells(shape: tuple[int, int], corner: str) -> tuple[set[tuple[int, int]], list[tuple[tuple[int, int], int]]]:
+    h, w = shape
+    if corner == "tl":
+        marker = {(0, 0), (0, 1), (1, 0), (1, 1)}
+        options = [((1, 2), 0), ((2, 1), 1)]
+    elif corner == "tr":
