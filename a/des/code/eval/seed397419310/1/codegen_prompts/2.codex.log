+        if idx > 0:
+            allowed.add(coords[idx - 1])
+        if idx + 1 < len(coords):
+            allowed.add(coords[idx + 1])
+        if is_first and idx == 0:
+            allowed |= marker
+        for nb in _neighbors4(*cell):
+            if nb in occupied and nb not in allowed:
