+def _choose_object_plan(lengths: list[int]) -> tuple[str, bool, list[list[int]]]:
+    mode = random.choice(("all_unique", "multi_unique", "multi_duplicate"))
+    include_unused = len(lengths) >= 3 and bool(random.getrandbits(1))
