+def _find_target_frame(grid: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int]]:
+    candidates: list[tuple[int, int, tuple[int, int, int, int]]] = []
+    for color in sorted(set(map(int, np.unique(grid))) - {int(bg)}):
