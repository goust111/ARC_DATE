+    else:
+        frame_c = left_margin
+        source_c = left_margin + frame_w + gap
+    return (height, width), (source_r, source_c), (frame_r, frame_c)
+
+
+def _place_vertical(
+    source_shape: tuple[int, int], frame_shape: tuple[int, int], source_top: bool
