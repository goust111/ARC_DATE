+    for comp in components:
+        for r, c in comp:
+            rr, cc = _mirror_coord(r, c, orientation, line_index)
+            color = int(g[line_index, cc]) if orientation == "h" else int(g[rr, line_index])
+            out[rr, cc] = color
+
+    return out
+
