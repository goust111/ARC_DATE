+        min_here = max(low, remaining - high * (parts - i - 1))
+        max_here = min(high, remaining - low * (parts - i - 1))
+        if min_here > max_here:
+            return None
+        value = random.randint(min_here, max_here)
+        out.append(value)
+        remaining -= value
+    return out if remaining == 0 else None
