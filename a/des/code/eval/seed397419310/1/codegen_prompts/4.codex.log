+        line = grid[r, :]
+        if np.any(line == bg):
+            continue
+        top_colors = _non_bg_colors(grid[:r, :], bg)
+        bottom_colors = _non_bg_colors(grid[r + 1 :, :], bg)
+        if len(top_colors) == 1 and not bottom_colors:
