        if 0 <= rr < r_count and 0 <= cc < c_count:
            yield rr, cc


def _edge(a, b):
    return frozenset((a, b))


def _component_duplicate_slots(foreground, equal_edges):
    parent = {cell: cell for cell in foreground}

    def find(cell):
        while parent[cell] != cell:
            parent[cell] = parent[parent[cell]]
            cell = parent[cell]
        return cell

    def union(a, b):
        ra, rb = find(a), find(b)
        if ra != rb:
            parent[rb] = ra

