+        return False
+    return True
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    pair_count = rng.choice(PAIR_COUNT_CHOICES)
+    main_colors = rng.sample(list(range(1, 10)), pair_count)
+    marker_pool = [c for c in range(1, 10) if c not in main_colors]
