+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+PAIR_COUNT_CHOICES = (2, 3, 4)
+SCALE_CHOICES = (2, 3, 4)
+GRID_MIN_SIDE = 18
+GRID_MAX_SIDE = 30
+MAX_GEN_ATTEMPTS = 400
+SHAPE_ATTEMPTS = 80
+PLACEMENT_ATTEMPTS = 300
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    return int(mask.sum()) > 0 and len(_components(mask)) == 1
+
+
+def _mask_variants(mask: np.ndarray) -> list[np.ndarray]:
+    variants: list[np.ndarray] = []
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    cur = mask
+    for _ in range(4):
+        for candidate in (cur, np.fliplr(cur)):
+            key = (candidate.shape, candidate.astype(np.uint8).tobytes())
+            if key not in seen:
+                seen.add(key)
+                variants.append(candidate.copy())
+        cur = np.rot90(cur)
+    return variants
+
+
