+        if int(mask.sum()) >= 7 and rng.random() < 0.6:
+            boundary = [(r, c) for r, c in np.argwhere(mask) if any(not mask[nr, nc] for nr, nc in _neighbors4(r, c, *mask.shape))]
+            rng.shuffle(boundary)
+            for r, c in boundary:
