+    mask = patch != BG
+    values, counts = np.unique(patch[mask], return_counts=True)
+    main_color = int(values[counts.argmax()])
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "patch": patch,
+        "mask": mask,
+        "colors": tuple(int(v) for v in values),
