+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+MIRROR = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GRID_H_RANGE = (15, 19)
+GRID_W_RANGE = (15, 19)
+STRIPE_COUNT_RANGE = (2, 4)
+STRIPE_LEN_RANGE = (3, 6)
+GAP_RANGE = (1, 4)
+GEN_ATTEMPTS = 400
