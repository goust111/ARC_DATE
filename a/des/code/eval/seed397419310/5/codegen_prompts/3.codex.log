+
+    occupied = np.zeros((grid_h, grid_w), dtype=bool)
+    for spec in sorted(specs, key=lambda s: int(s["outer_h"]) * int(s["outer_w"]), reverse=True):
+        spot = _find_free_spot(
+            rng,
+            occupied,
