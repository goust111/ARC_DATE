+
+    for spec, piece in fragment_jobs:
+        _paint_piece(
+            inp,
+            int(piece["scatter_top"]),
+            int(piece["scatter_left"]),
+            int(spec["color"]),
+            piece,
+        )
+
+    if np.array_equal(inp, expected):
+        return None
+    if not np.array_equal(main(inp), expected):
+        return None
+    return inp
