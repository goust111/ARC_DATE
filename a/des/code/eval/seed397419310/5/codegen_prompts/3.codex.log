+    if parts <= 0 or parts > _max_distinct_parts(total):
+        return None
+    for _ in range(100):
+        values = _partition_total(rng, total, parts)
+        if values is None:
+            continue
+        if len(set(values)) != len(values):
+            continue
+        return sorted(values, reverse=True)
+    return None
