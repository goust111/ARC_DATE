+    ir0 = top + 1
+    ic0 = left + 1
+    inner = target[ir0 : ir0 + spec["inner_h"], ic0 : ic0 + spec["inner_w"]]
+    if fill_empty:
+        inner[:, :] = spec["fill_color"]
+    else:
+        inner[:, :] = bg
