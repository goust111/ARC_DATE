  38: def main(grid: np.ndarray) -> np.ndarray:
  39:     """
  40:     Stamp recolored sprites into a framed region using placeholder positions and a color legend.
  41: 
  42:     Input structure:
  43:     - bg background, a rectangular single-color frame, colored placeholder cells inside the frame.
  44:     - Outside the frame: sprite shapes (one per placeholder color) and a small legend mapping each placeholder color to an output color.
  45: 
  46:     Rule:
  47:     - Find the frame and its interior placeholders.
  48:     - For each placeholder color, locate the matching-color sprite outside the frame.
  49:     - Stamp each sprite at the placeholder's position inside the frame.
  50:     - Recolor every stamped sprite to the output color defined by the legend.
  51: 
  52:     Key insight: The legend pairs (overlapping two-color glyphs outside the frame) dictate the final recoloring — placeholder color selects the shape, legend maps it to the output color.
  53:     """
  54:     g = np.asarray(grid, dtype=int)
  55:     bg = get_bg(g)
  56: 
  57:     frame_col, (fr0, fc0, fr1, fc1) = _find_frame(g, bg)
  58: 
  59:     crop = g[fr0 : fr1 + 1, fc0 : fc1 + 1]
  60:     H, W = crop.shape
  61:     assert H >= 3 and W >= 3, f"frame too small for interior: {(H, W)}"
  62: 
  63:     # Placeholder components inside the frame interior.
  64:     inner_mask = np.zeros((H, W), dtype=bool)
  65:     inner_mask[1:-1, 1:-1] = True
  66:     placeholder_colors = set(map(int, np.unique(crop[inner_mask]))) - {bg, frame_col}
  67:     assert placeholder_colors, "no placeholder colors found inside frame"
  68: 
  69:     placeholders: list[tuple[int, tuple[int, int, int, int]]] = []
  70:     for col in sorted(placeholder_colors):
  71:         for pts in components_mask((crop == col) & inner_mask, connectivity=4):
  72:             r0, c0, r1, c1 = bbox_coords(pts)
  73:             placeholders.append((col, (r0, c0, r1, c1)))
  74:     # Eval inputs use one placement bbox size per placeholder color.
  75:     phw: dict[int, tuple[int, int]] = {}
  76:     for col in placeholder_colors:
  77:         dims = [(b[2] - b[0] + 1, b[3] - b[1] + 1) for c, b in placeholders if c == col]
  78:         assert dims, f"no placeholder component found for color {col}"
  79:         unique_dims = sorted(set(dims))
  80:         assert len(unique_dims) == 1, f"ambiguous placeholder sizes for color {col}: {unique_dims}"
  81:         phw[col] = unique_dims[0]
  82: 
  83:     # Extract outside-frame components for sprite shapes and for legend color mapping.
  84:     outside = np.ones(g.shape, dtype=bool)
  85:     outside[fr0 : fr1 + 1, fc0 : fc1 + 1] = False
  86: 
  87:     # Collect all outside components (with ids) for later pairing.
  88:     comps = []
  89:     colors = [int(c) for c in np.unique(g) if int(c) not in (bg, frame_col)]
  90:     cid = 0
  91:     for col in colors:
  92:         for pts in components_mask((g == col) & outside, connectivity=4):
  93:             r0, c0, r1, c1 = bbox_coords(pts)
  94:             pts_tuples = [(int(r), int(c)) for r, c in pts]
  95:             comps.append(
  96:                 {
  97:                     "id": cid,
  98:                     "col": int(col),
  99:                     "pts": pts_tuples,
 100:                     "bbox": (r0, c0, r1, c1),
 101:                     "area": len(pts_tuples),
 102:                 }
 103:             )
 104:             cid += 1
 105: 
 106:     def _bbox_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
 107:         ar0, ac0, ar1, ac1 = a
 108:         br0, bc0, br1, bc1 = b
 109:         return not (ar1 < br0 or br1 < ar0 or ac1 < bc0 or bc1 < ac0)
 110: 
 111:     # Legend mapping: detect small two-color glyph regions where two components overlap in bbox
 112:     # and the union bbox contains only those two colors (no background).
 113:     color_map: dict[int, int] = {}
 114:     legend_ids: set[int] = set()
 115: 
 116:     for i in range(len(comps)):
 117:         for j in range(i + 1, len(comps)):
 118:             ci = comps[i]
 119:             cj = comps[j]
 120:             if ci["col"] == cj["col"]:
 121:                 continue
 122:             if not _bbox_overlap(ci["bbox"], cj["bbox"]):
 123:                 continue
 124:             r0 = min(ci["bbox"][0], cj["bbox"][0])
 125:             c0 = min(ci["bbox"][1], cj["bbox"][1])
 126:             r1 = max(ci["bbox"][2], cj["bbox"][2])
 127:             c1 = max(ci["bbox"][3], cj["bbox"][3])
 128:             # restrict to compact legend-like regions
 129:             if (r1 - r0 + 1) > 8 or (c1 - c0 + 1) > 8:
 130:                 continue
 131:             sub = g[r0 : r1 + 1, c0 : c1 + 1]
 132:             sub_colors = set(map(int, np.unique(sub))) - {frame_col}
 133:             if bg in sub_colors:
 134:                 continue
 135:             if len(sub_colors) != 2:
 136:                 continue
 137:             cset = set(sub_colors)
 138:             if ci["col"] not in cset or cj["col"] not in cset:
 139:                 continue
 140: 
 141:             # Decide source->target.
 142:             # If exactly one color is used as a placeholder inside the frame, that one is source.
 143:             if (ci["col"] in placeholder_colors) ^ (cj["col"] in placeholder_colors):
 144:                 src = ci["col"] if ci["col"] in placeholder_colors else cj["col"]
 145:                 tgt = cj["col"] if src == ci["col"] else ci["col"]
 146:             else:
 147:                 # Otherwise: the larger component in this pair is treated as the source.
 148:                 assert ci["area"] != cj["area"], f"ambiguous equal-area legend pair: {ci['col']} and {cj['col']}"
 149:                 if ci["area"] > cj["area"]:
 150:                     src, tgt = ci["col"], cj["col"]
 151:                 else:
 152:                     src, tgt = cj["col"], ci["col"]
 153: 
 154:             assert src in placeholder_colors, f"legend source color {src} is not a placeholder"
 155:             assert src not in color_map, f"duplicate legend mapping for placeholder color {src}"
 156:             color_map[src] = int(tgt)
 157:             legend_ids.add(ci["id"])
 158:             legend_ids.add(cj["id"])
 159:     assert set(color_map) == placeholder_colors, (
 160:         f"legend mappings {sorted(color_map)} do not match placeholders {sorted(placeholder_colors)}"
 161:     )
 162: 
 163:     # Sprite shapes: for each placeholder color, pick the non-legend component matching placeholder size.
 164:     sprite_coords: dict[int, tuple[tuple[tuple[int, int], ...], int, int]] = {}
 165:     for src_col in sorted(placeholder_colors):
 166:         all_candidates = [c for c in comps if c["col"] == src_col and c["id"] not in legend_ids]
 167:         assert all_candidates, f"no non-legend sprite found for color {src_col}"
 168:         want_h, want_w = phw[src_col]
 169:         sized = [
 170:             c
 171:             for c in all_candidates
 172:             if (c["bbox"][2] - c["bbox"][0] + 1) == want_h and (c["bbox"][3] - c["bbox"][1] + 1) == want_w
 173:         ]
 174:         assert len(sized) == 1, f"expected one size-matched sprite for color {src_col}, found {len(sized)}"
 175:         base = sized[0]
 176:         sr0, sc0, sr1, sc1 = base["bbox"]
 177: 
 178:         # Some sprites can be split into multiple 4-connected components of the same color.
 179:         # Merge any additional (non-legend) components fully contained in the chosen sprite bbox.
 180:         pts_set = set(base["pts"])
 181:         for c in all_candidates:
 182:             if c["id"] == base["id"]:
 183:                 continue
 184:             r0, c0, r1, c1 = c["bbox"]
 185:             assert sr0 <= r0 and sr1 >= r1 and sc0 <= c0 and sc1 >= c1, (
 186:                 f"extra sprite component for color {src_col} is outside the base bbox"
 187:             )
 188:             pts_set.update(c["pts"])
 189: 
 190:         coords = tuple(sorted((r - sr0, c - sc0) for r, c in pts_set))
 191:         sprite_coords[src_col] = (coords, sr1 - sr0 + 1, sc1 - sc0 + 1)
 192: 
 193:     # Build output crop: keep frame border, clear interior to bg, then paste recolored sprites.
 194:     out = crop.copy()
 195:     out[1:-1, 1:-1] = bg
 196: 
 197:     for src_col, (pr0, pc0, pr1, pc1) in placeholders:
 198:         assert src_col in sprite_coords and src_col in color_map, f"placeholder color {src_col} missing sprite or color mapping"
 199:         tgt_col = int(color_map[src_col])
 200:         coords, sh, sw = sprite_coords[src_col]
 201:         assert (pr1 - pr0 + 1, pc1 - pc0 + 1) == (sh, sw), (
 202:             f"placeholder size does not match sprite for color {src_col}"
 203:         )
 204:         assert pr0 + sh <= H and pc0 + sw <= W, f"sprite for color {src_col} does not fit at placeholder"
 205:         # Align sprite's bbox top-left to placeholder bbox top-left.
 206:         off_r = pr0
 207:         off_c = pc0
 208:         for dr, dc in coords:
 209:             rr, cc = off_r + dr, off_c + dc
 210:             out[rr, cc] = tgt_col
 211: 
 212:     return out

