 351: def _gen_attempt() -> np.ndarray | None:
 352:     # --- structure ---
 353:     struct = _choose_structure()
 354:     if struct is None:
 355:         return None
 356:     n, rows, cols, empty_count, _ = struct
 357: 
 358:     bg = random.choice([c for c in range(10) if c != FRAME_COL])
 359:     usable = [c for c in range(10) if c not in (bg, FRAME_COL)]
 360: 
 361:     # --- colors ---
 362:     k = random.randint(*NUM_COLORS_RANGE)
 363:     src_cols = random.sample(usable, k)
 364:     tgt_cols = [random.choice([c for c in usable if c != src]) for src in src_cols]
 365:     color_to_tgt = dict(zip(src_cols, tgt_cols))
 366:     masks = {src: _sprite_mask(n) for src in src_cols}
 367: 
 368:     # --- frame dimensions & margins ---
 369:     ch, cw = _content_extent(n, rows, cols)
 370:     min_fh = max(MIN_FRAME_H, ch + 4)
 371:     min_fw = max(MIN_FRAME_W, cw + 4)
 372:     frame_h = random.randint(min_fh, min(MAX_FRAME_DIM, max(min_fh, ch + 2 + FRAME_MARGIN_SLACK)))
 373:     frame_w = random.randint(min_fw, min(MAX_FRAME_DIM, max(min_fw, cw + 2 + FRAME_MARGIN_SLACK)))
 374:     y_margin = frame_h - 2 - ch
 375:     x_margin = frame_w - 2 - cw
 376:     top_margin = random.randint(1, y_margin - 1)
 377:     left_margin = random.randint(1, x_margin - 1)
 378: 
 379:     # --- slot assignment ---
 380:     _, filled_slots = _choose_empty_slots(rows, cols, empty_count)
 381:     cell_colors = {}
 382:     for slot, col in zip(filled_slots[:k], src_cols):
 383:         cell_colors[slot] = col
 384:     for slot in filled_slots[k:]:
 385:         cell_colors[slot] = random.choice(src_cols)
 386: 
 387:     # --- build input & output frames ---
 388:     input_frame = _make_bordered_frame(frame_h, frame_w, bg)
 389:     output_frame = _make_bordered_frame(frame_h, frame_w, bg)
 390:     for (rr, cc), src in cell_colors.items():
 391:         r0 = 1 + top_margin + rr * (n + 1)
 392:         c0 = 1 + left_margin + cc * (n + 1)
 393:         paste(input_frame, np.full((n, n), src, dtype=int), r0, c0)
 394:         paste(output_frame, _colored_sprite(masks[src], color_to_tgt[src], bg), r0, c0, transparent=bg)
 395: 
 396:     # --- canvas selection & frame placement ---
 397:     ext_area = k * (12 + n * n + 10)
 398:     possible_dims = [
 399:         (h, w)
 400:         for h in range(*CANVAS_H_RANGE)
 401:         for w in range(*CANVAS_W_RANGE)
 402:         if h >= frame_h and w >= frame_w and h * w - frame_h * frame_w >= ext_area
 403:     ]
 404:     if not possible_dims:
 405:         return None
 406:     h, w = random.choice(possible_dims)
 407:     grid = np.full((h, w), bg, dtype=int)
 408:     reserve = np.full((h, w), bg, dtype=int)
 409: 
 410:     fr0 = random.choice([0, h - frame_h])
 411:     fc0 = random.choice([0, w - frame_w])
 412:     if h - frame_h > 2 and random.random() < FRAME_POS_JITTER_PROB:
 413:         fr0 = random.randrange(0, h - frame_h + 1)
 414:     if w - frame_w > 2 and random.random() < FRAME_POS_JITTER_PROB:
 415:         fc0 = random.randrange(0, w - frame_w + 1)
 416:     paste(grid, input_frame, fr0, fc0)
 417:     paste(reserve, np.full((frame_h, frame_w), FRAME_COL, dtype=int), fr0, fc0)
 418: 
 419:     # --- place external patches (sprites + legends) ---
 420:     patches: list[tuple[np.ndarray, bool]] = []
 421:     for src, tgt in zip(src_cols, tgt_cols):
 422:         patches.append((_colored_sprite(masks[src], src, bg), True))
 423:         patches.append((_legend(src, tgt), False))
 424:     random.shuffle(patches)
 425:     patches.sort(key=lambda item: item[0].size, reverse=True)
 426:     for patch, transparent in patches:
 427:         if not _place_patch(grid, reserve, patch, bg, transparent=transparent):
 428:             return None
 429: 
 430:     # --- oracle check ---
 431:     try:
 432:         if not np.array_equal(main(grid), output_frame):
 433:             return None
 434:     except Exception:
 435:         return None
 436:     return grid

