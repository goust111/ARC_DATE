+    pr = spec["pattern_row"]
+    pc = spec["pattern_col"]
+    patch = inner[pr : pr + spec["pattern"].shape[0], pc : pc + spec["pattern"].shape[1]]
+    patch[spec["pattern"]] = BLACK
