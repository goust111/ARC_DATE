   215	    g = np.full((6, 7), fill, dtype=int)
   216	    g[1, 3] = 1
   217	    g[2, 1] = 1; g[2, 4] = 1
   218	    g[3, 2] = 1; g[3, 5] = 2
   219	    g[4, 3] = 2
   220	    if (dr, dc) == (1, 1): return g

