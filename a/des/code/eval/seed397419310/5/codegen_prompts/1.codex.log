  96: def main(grid: np.ndarray) -> np.ndarray:
  97:     """
  98:     Move the small colored sprite into the hollow frame by stretching its shape to the frame interior.
  99: 
 100:     Input structure:
 101:     - The background is the dominant color.
 102:     - There are exactly two foreground colors: one forms a complete rectangular
 103:       one-pixel-thick frame, and the other forms one 4-connected sprite outside it.
 104:     - The frame interior is initially background.
 105: 
 106:     Rule:
 107:     - Clear the original sprite from its outside location.
 108:     - Map the sprite bbox to the frame interior bbox, sending bbox extremes to
 109:       interior extremes.
 110:     - Draw straight horizontal or vertical segments between mapped positions of
 111:       adjacent sprite pixels, then fill any enclosed background region inside
 112:       those drawn segments.
 113: 
 114:     Key insight:
 115:     The outside sprite is a miniature line/fill diagram for the frame interior,
 116:     not a bitmap to scale by block replication.
 117:     """
 118:     g = np.asarray(grid, dtype=int)
 119:     bg = get_bg(g)
 120:     colors = colors_present(g, exclude={bg})
 121:     assert len(colors) == 2, "expected one frame color and one sprite color"
 122: 
 123:     frame_candidates: list[tuple[int, tuple[int, int, int, int]]] = []
 124:     for color in colors:
 125:         frame_bbox = _rect_frame_bbox(g == int(color))
 126:         if frame_bbox is not None:
 127:             frame_candidates.append((int(color), frame_bbox))
 128:     assert len(frame_candidates) == 1, "expected a unique rectangular frame"
 129: 
 130:     frame_color, (fr0, fc0, fr1, fc1) = frame_candidates[0]
 131:     sprite_color = next(color for color in colors if color != frame_color)
 132:     sprite_components = find_components(g, bg=bg, colors=[sprite_color], connectivity=4)
 133:     assert len(sprite_components) == 1, "expected a single 4-connected sprite"
 134:     frame_region = np.zeros_like(g, dtype=bool)
 135:     frame_region[fr0 : fr1 + 1, fc0 : fc1 + 1] = True
 136:     assert not np.any((g == sprite_color) & frame_region), "sprite must start outside the frame"
 137: 
 138:     sr0, sc0, sr1, sc1 = sprite_components[0]["bbox"]
 139:     sprite = g[sr0 : sr1 + 1, sc0 : sc1 + 1] == sprite_color
 140: 
 141:     ir0, ic0 = fr0 + 1, fc0 + 1
 142:     ir1, ic1 = fr1 - 1, fc1 - 1
 143:     assert ir0 <= ir1 and ic0 <= ic1, "frame must have an interior"
 144:     interior = g[ir0 : ir1 + 1, ic0 : ic1 + 1]
 145:     assert np.all(interior == bg), "frame interior must start empty"
 146: 
 147:     stretched = _stretch_sprite(sprite, (ir1 - ir0 + 1, ic1 - ic0 + 1))
 148:     out = g.copy()
 149:     out[g == sprite_color] = bg
 150:     out[ir0 : ir1 + 1, ic0 : ic1 + 1][stretched] = sprite_color
 151:     return out

