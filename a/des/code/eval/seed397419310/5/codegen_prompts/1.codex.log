+    max_h = max(spec["outer_h"] for spec in specs) + 2
+    max_w = max(spec["outer_w"] for spec in specs) + 2
+    total_area = sum(spec["outer_h"] * spec["outer_w"] for spec in specs)
+
+    dims = [
