+            r0, c0, r1, c1 = _bbox(coords)
+            if r1 - r0 + 1 < 3 or c1 - c0 + 1 < 3:
+                continue
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for r, c in coords:
+                mask[r - r0, c - c0] = True
+            if not _is_rect_outline(mask):
