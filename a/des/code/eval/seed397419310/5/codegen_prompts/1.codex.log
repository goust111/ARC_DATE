+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BLACK = 0
+MAX_GEN_ATTEMPTS = 500
+GRID_H_RANGE = (18, 28)
+GRID_W_RANGE = (18, 28)
+PAIR_COUNT_CHOICES = (2, 3)
+SHAPE_DIM_RANGE = (2, 4)
+SHAPE_AREA_RANGE = (3, 6)
+INNER_EXTRA_RANGE = (0, 3)
