+        r1, c1 = coords.max(axis=0)
+        size_r = int(r1 - r0 + 1)
+        size_c = int(c1 - c0 + 1)
+        if size_r != size_c:
+            continue
+        if int(coords.shape[0]) != size_r * size_c:
