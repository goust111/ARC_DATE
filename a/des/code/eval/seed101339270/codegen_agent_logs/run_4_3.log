+        for _ in range(rng.randint(0, max(1, w // 2))):
+            mask[rng.randrange(h), rng.randrange(w)] = True
+    elif mode == "col_stripes":
+        parity = rng.randrange(2)
+        for c in range(w):
+            if c % 2 == parity:
