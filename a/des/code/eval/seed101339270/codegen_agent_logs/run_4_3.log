+        density = rng.uniform(0.25, 0.65)
+        mask = np.array([[rng.random() < density for _ in range(w)] for _ in range(h)], dtype=bool)
+    elif mode == "row_stripes":
+        parity = rng.randrange(2)
+        for r in range(h):
+            if r % 2 == parity:
