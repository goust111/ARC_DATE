+def _make_pattern(rng: random.Random, h: int, w: int, palette: list[int]) -> np.ndarray:
+    colors = rng.sample(palette, k=rng.randint(2, min(4, len(palette))))
+    mode = rng.choice(("cells", "rows", "cols", "blocks"))
