+            inner_non_bg = {int(v) for v in inner.reshape(-1) if int(v) != BG}
+            if not inner_non_bg:
+                kind = "empty"
+            elif inner_non_bg <= {GREY}:
+                kind = "sieve"
+            else:
+                kind = "container"
+            frames.append(
+                {
+                    "color": color,
+                    "kind": kind,
+                    "bbox": (r0, c0, r1, c1),
+                    "inner": inner.copy(),
