+                continue
+            seen[r, c] = True
+            q: deque[tuple[int, int]] = deque([(int(r), int(c))])
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((int(rr), int(cc)))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = int(rr + dr), int(cc + dc)
