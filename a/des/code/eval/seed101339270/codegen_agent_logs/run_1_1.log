+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return bool(np.array_equal(mask, border))
+
+
+def _detect_arrow(coords: np.ndarray) -> str | None:
+    if len(coords) != 3:
