+from collections import Counter, deque
+
+import numpy as np
+
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+
+ARROW_PATTERNS = {
+    "up": np.array([[0, 1, 0], [1, 0, 1]], dtype=bool),
