+    colors = RNG.choice(PALETTE_COLORS, size=legend_len, replace=False)
+    return [int(x) for x in colors]
+
+
+def _compose_grid(
+    maze: np.ndarray,
+    paths: list[list[tuple[int, int]]],
+    legend: list[int],
+) -> tuple[np.ndarray, np.ndarray]:
