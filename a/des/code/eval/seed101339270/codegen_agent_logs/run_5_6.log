+
+    expected = _paint_paths(grid, paths, legend, row_offset=top, col_offset=left_margin)
+    return grid, expected
+
+
+def _gen_attempt() -> np.ndarray | None:
+    target_overflow = bool(int(RNG.integers(0, 2)))
