+
+def _paint_patch(grid: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    h, w = patch.shape
+    mask = patch != BLACK
+    grid[top : top + h, left : left + w][mask] = patch[mask]
+
+
+def _sample_rotations(count: int) -> list[int]:
+    if count <= 4:
+        choices = np.arange(4)
+        RNG.shuffle(choices)
