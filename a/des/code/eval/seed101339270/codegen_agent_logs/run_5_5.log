+    ((1, 2), (0, 2)),  # up
+    ((2, 3), (2, 4)),  # right
+    ((3, 2), (4, 2)),  # down
+    ((2, 1), (2, 0)),  # left
+)
+GREY_CELLS = ((0, 0), (0, 4), (2, 2), (4, 0), (4, 4))
+
+RNG = np.random.default_rng()
+LAYOUT_CHOICES = [(1, 2), (2, 1), (1, 3), (3, 1), (2, 2), (2, 3), (3, 2)]
+ROW_GAP_RANGE = (2, 6)
+COL_GAP_RANGE = (2, 6)
+GRID_H_RANGE = (18, 33)
+GRID_W_RANGE = (18, 33)
