                continue
            if len({door_color, top_color, bottom_color}) != 3:
                continue
            if int(g[r - 2, c]) != GREY or int(g[r + 3, c]) != GREY:
                continue
            side_band = [(rr, c - 1) for rr in range(r - 1, r + 3)] + [(rr, c + 1) for rr in range(r - 1, r + 3)]
            if not _check_bg_band(g, side_band):
