+    keys = _detect_keys(g)
+    key_by_colors: dict[frozenset[int], dict] = {}
+    for key in keys:
+        assert key["colors"] not in key_by_colors, "keys must have unique three-color signatures"
+        key_by_colors[key["colors"]] = key
