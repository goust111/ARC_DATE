+    return True
+
+
+def _detect_doors(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    doors: list[dict] = []
+    used = np.zeros((h, w), dtype=bool)
