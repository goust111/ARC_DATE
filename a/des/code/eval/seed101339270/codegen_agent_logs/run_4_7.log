+            if not _check_bg_band(g, side_band):
+                continue
+            used[r, c : c + 2] = True
+            doors.append(
+                {
+                    "orientation": "h",
+                    "door_cells": [(r, c), (r, c + 1)],
+                    "open_cells": [(r, c - 1), (r, c), (r, c + 1), (r, c + 2)],
