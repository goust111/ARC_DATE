) -> None:
    sr0, sr1, sc0, sc1 = map(int, src_bounds)
    dr0, dr1, dc0, dc1 = map(int, dst_bounds)
    src_coords = np.argwhere(g[sr0 : sr1 + 1, sc0 : sc1 + 1] == int(color))
    assert len(src_coords) > 0, "source region must contain seed-colored pixels"

