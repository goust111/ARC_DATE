+    expected = _expected_output(main_grid, rooms, templates)
+    try:
+        actual = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_GENERATION_ATTEMPTS):
+        grid = _generate_attempt()
