+        c1 = c0 + inner_w + 1
+
+        main_grid[r0, c0 : c1 + 1] = _WALL
+        main_grid[r1, c0 : c1 + 1] = _WALL
+        main_grid[r0 : r1 + 1, c0] = _WALL
+        main_grid[r0 : r1 + 1, c1] = _WALL
+        main_grid[r0 + 1 + seed_r, c0 + 1 + seed_c] = color
+
+    return main_grid
+
+
+def _expected_output(
