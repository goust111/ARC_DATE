+    main_grid = _render_main_grid(main_h, main_w, rooms)
+    legend = _render_legend(main_w, templates)
+    if legend is None:
+        return None
+
+    inp = np.full((main_h + 4, main_w), _BG, dtype=int)
+    inp[:main_h, :] = main_grid
+    inp[main_h, :] = _WALL
+    inp[main_h + 1 :, :] = legend
