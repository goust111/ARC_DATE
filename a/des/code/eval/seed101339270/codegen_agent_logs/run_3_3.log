+def _assign_arrows(candidates_by_obj: list[list[dict]], counts: list[int]) -> list[dict] | None:
+    for _ in range(80):
+        remaining = counts[:]
+        forbidden: set[tuple[int, int]] = set()
+        used_cells: set[tuple[int, int]] = set()
+        used_dirs = [set() for _ in counts]
+        chosen: list[dict] = []
+        failed = False
