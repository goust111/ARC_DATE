+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BACKGROUND = 0
+ARROW_COLOR = 2
+OBJECT_COLORS = (1, 3, 4, 5, 6, 7, 8, 9)
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+GENERATE_RETRIES = 400
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((int(cr), int(cc)))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((int(nr), int(nc)))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _boxes_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])
+
+
+def _pad_box(box: tuple[int, int, int, int], pad: int, h: int, w: int) -> tuple[int, int, int, int]:
+    return (
+        max(0, box[0] - pad),
+        max(0, box[1] - pad),
+        min(h - 1, box[2] + pad),
+        min(w - 1, box[3] + pad),
+    )
+
+
+def _scaled_bbox(box: tuple[int, int, int, int], k: int) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = box
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    new_h = h * k
+    new_w = w * k
+    # When parity prevents an exact discrete centering, bias toward top/left consistently.
+    nr0 = (r0 + r1 - new_h + 1) // 2
+    nc0 = (c0 + c1 - new_w + 1) // 2
+    return nr0, nc0, nr0 + new_h - 1, nc0 + new_w - 1
+
+
+def _find_objects(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    objects: list[dict] = []
