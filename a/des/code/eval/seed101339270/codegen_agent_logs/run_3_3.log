+    for obj in objects:
+        r0, c0, r1, c1 = obj["bbox"]
+        grid[r0 : r1 + 1, c0 : c1 + 1] = int(obj["color"])
+    for arrow in arrows:
+        for r, c in arrow["cells"]:
