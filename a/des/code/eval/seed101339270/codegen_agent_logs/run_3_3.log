+        for r0 in range(1, h - size):
+            for c0 in range(1, w - size):
+                r1 = r0 + size - 1
+                c1 = c0 + size - 1
+                if any(not (r1 < ur0 or r0 > ur1) for ur0, ur1 in used_row_spans):
