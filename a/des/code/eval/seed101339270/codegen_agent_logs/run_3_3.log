+        nr0, nc0, nr1, nc1 = _scaled_bbox(obj["bbox"], k)
+        rr0, cc0 = max(0, nr0), max(0, nc0)
+        rr1, cc1 = min(h - 1, nr1), min(w - 1, nc1)
