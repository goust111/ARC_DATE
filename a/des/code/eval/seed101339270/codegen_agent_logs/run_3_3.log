+            return None
+        if shaft[-1] != jr or shaft != list(range(shaft[0], jr + 1)):
+            return None
+    elif rel == {(0, -1), (0, 1), (1, 0)}:
+        direction = "up"
+        shaft = sorted(r for r, c in cells if c == jc)
