+                    for cand in candidates_by_obj[obj_idx]
+                    if cand["cells"].isdisjoint(forbidden) and cand["footprint"].isdisjoint(used_cells)
+                ]
+                if len(valid) < need:
+                    failed = True
+                    break
+                if best_valid is None or len(valid) < len(best_valid):
+                    best_obj = obj_idx
+                    best_valid = valid
+            if failed:
