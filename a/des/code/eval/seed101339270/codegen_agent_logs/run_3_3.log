+def _classify_arrow(comp: list[tuple[int, int]]) -> dict | None:
+    cells = set(comp)
+    deg: dict[tuple[int, int], int] = {}
+    for cell in cells:
+        deg[cell] = sum((nbr in cells) for nbr in _neighbors4(*cell))
