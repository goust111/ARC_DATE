+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+MAGENTA = 6
+
+FILL_COLORS = (RED, BLUE, YELLOW, MAGENTA)
+GEN_RETRIES = 300
+
+
+def _edge_key(a: tuple[int, int], b: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
+    return tuple(sorted((a, b)))
