+def _render_grid(shape: tuple[int, int], bg: int, pairs: list[Pair]) -> np.ndarray:
+    grid = np.full(shape, int(bg), dtype=int)
+    for color, a, b in pairs:
+        grid[a] = int(color)
+        grid[b] = int(color)
