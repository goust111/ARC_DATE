+    for color, a, b in pairs:
+        branch_a, branch_b, _truncated, _orientation = _pair_branches(a, b, g.shape)
+        for branch in (branch_a, branch_b):
+            for r, c in branch:
+                if seed_mask[r, c]:
+                    continue
+                prio = PRIORITY[color]
+                if prio > int(paint_priority[r, c]):
+                    paint_priority[r, c] = prio
+                    paint_color[r, c] = color
