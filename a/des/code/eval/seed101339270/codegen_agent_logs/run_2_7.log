+            shape,
+            pairs,
+            counts,
+            rng,
+            units=DIAGONAL_UNITS,
+            require_truncation=False,
+            allow_overlap=False,
+            require_overlap=False,
+        )
+        if pair is None:
+            return None
+        pairs.append(pair)
+        counts[pair[0]] += 1
+        filler_units = ((0, 1), (1, 0))
