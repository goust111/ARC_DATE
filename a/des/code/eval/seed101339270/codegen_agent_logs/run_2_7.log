+    pairs: list[Pair] = []
+    counts: Counter = Counter()
+    filler_units = UNITS
+
+    if scenario == "cross":
+        block = _make_cross_block(shape, rng)
+        if block is None:
+            return None
+        for pair in block:
+            pairs.append(pair)
+            counts[pair[0]] += 1
+        filler_units = ((0, 1), (1, 0))
+    elif scenario == "edge":
+        pair = _sample_pair(
+            shape,
+            pairs,
+            counts,
+            rng,
+            require_truncation=True,
+            allow_overlap=False,
+            require_overlap=False,
+        )
+        if pair is None:
+            return None
+        pairs.append(pair)
+        counts[pair[0]] += 1
+        filler_units = ((0, 1), (1, 0))
+    elif scenario == "diag":
