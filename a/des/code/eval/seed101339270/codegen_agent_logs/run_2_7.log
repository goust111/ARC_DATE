+
+    return True
+
+
+def _max_dist_for_unit(shape: tuple[int, int], unit: Point) -> int:
+    h, w = shape
+    if unit == (0, 1):
+        return w - 1
+    if unit == (1, 0):
+        return h - 1
+    return min(h, w) - 1
+
+
+def _random_endpoints(shape: tuple[int, int], unit: Point, dist: int, rng: random.Random) -> tuple[Point, Point]:
+    h, w = shape
+    if unit == (0, 1):
+        r = rng.randrange(h)
