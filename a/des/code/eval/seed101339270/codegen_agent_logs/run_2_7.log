+    out[mask] = paint_color[mask]
+    return out
+
+
+def _canonical_pairs(pairs: list[Pair]) -> list[tuple[int, Point, Point]]:
+    canon = []
+    for color, a, b in pairs:
+        p0, p1 = sorted((a, b))
+        canon.append((int(color), p0, p1))
+    canon.sort()
+    return canon
