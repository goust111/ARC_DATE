+        out = main(grid)
+    except AssertionError:
+        return None
+
+    if not np.any(out != grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt(RNG)
+        if grid is not None:
