+
+
+def _pair_stats(pairs: list[Pair], shape: tuple[int, int]) -> dict[str, object]:
+    hits = _line_hits(pairs, shape)
+    orientations = Counter()
+    has_truncation = False
+    for _color, a, b in pairs:
