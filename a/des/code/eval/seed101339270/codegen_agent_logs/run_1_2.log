+
+COLOR_IDS = tuple(range(10))
+TEMPLATE_COUNT_RANGE = (2, 4)
+ROW_COUNT_RANGE = (2, 4)
+COL_COUNT_RANGE = (2, 4)
+ROOM_HEIGHT_RANGE = (2, 6)
+ROOM_WIDTH_RANGE = (2, 7)
+TEMPLATE_HEIGHT_RANGE = (2, 4)
+TEMPLATE_WIDTH_RANGE = (2, 4)
