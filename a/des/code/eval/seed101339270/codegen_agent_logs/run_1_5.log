+
+def _sample_indicator_sides(count: int) -> list[str]:
+    sides = [random.choice(("top", "bottom")), random.choice(("left", "right"))]
+    remaining = [side for side in ("top", "bottom", "left", "right") if side not in sides]
+    random.shuffle(remaining)
