+
+    return None
+
+
+def _draw_frame(
+    grid: np.ndarray,
+    top: int,
+    left: int,
+    size: int,
+    color: int,
+    gap_side: str,
+) -> None:
+    bottom = top + size - 1
+    right = left + size - 1
