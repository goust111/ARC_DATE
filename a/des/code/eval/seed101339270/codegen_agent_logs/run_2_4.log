+def _bresenham(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    points: list[tuple[int, int]] = []
+    dr = abs(r1 - r0)
+    dc = abs(c1 - c0)
+    sr = 1 if r0 < r1 else -1
+    sc = 1 if c0 < c1 else -1
+    err = dc - dr
+    r, c = r0, c0
+    while True:
+        points.append((r, c))
+        if r == r1 and c == c1:
+            break
+        e2 = 2 * err
+        if e2 > -dr:
+            err -= dr
+            c += sc
+        if e2 < dc:
+            err += dc
+            r += sr
+    return points
+
+
+def _apply_operation(out: np.ndarray, frame: dict, color: int) -> None:
