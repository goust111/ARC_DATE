+    hits: dict[int, list[tuple[int, int, dict]]] = defaultdict(list)
+    for order, arrow in enumerate(arrows):
+        dr, dc = DIR_BY_NAME[arrow["direction"]]
+        r, c = arrow["ray_start"]
+        dist = 0
+        while 0 <= r < h and 0 <= c < w:
+            dist += 1
+            frame_idx = border_lookup.get((r, c))
+            if frame_idx is not None:
