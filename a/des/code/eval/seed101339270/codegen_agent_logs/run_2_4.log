+    if h == 3 and 4 <= w <= 6:
+        shaft_len = w - 1
+        if norm == _build_arrow_cells("right", 0, 0, shaft_len):
+            return {
+                "direction": "right",
+                "ray_start": (r0 + 1, c1 + 1),
+                "cells": set(coords),
+            }
+        if norm == _build_arrow_cells("left", 0, 0, shaft_len):
+            return {
+                "direction": "left",
+                "ray_start": (r0 + 1, c0 - 1),
+                "cells": set(coords),
+            }
+    if w == 3 and 4 <= h <= 6:
+        shaft_len = h - 1
+        if norm == _build_arrow_cells("up", 0, 0, shaft_len):
+            return {
+                "direction": "up",
+                "ray_start": (r0 - 1, c0 + 1),
+                "cells": set(coords),
+            }
+        if norm == _build_arrow_cells("down", 0, 0, shaft_len):
+            return {
+                "direction": "down",
+                "ray_start": (r1 + 1, c0 + 1),
+                "cells": set(coords),
+            }
