+def _parse_arrow(coords: list[tuple[int, int]]) -> dict | None:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
+    norm = {(r - r0, c - c0) for r, c in coords}
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
