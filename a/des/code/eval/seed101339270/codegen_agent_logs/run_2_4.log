+    for r, c in cells:
+        grid[r, c] = color
+        occupied.add((r, c))
+    for r, c in cells:
+        for rr in range(r - 1, r + 2):
+            for cc in range(c - 1, c + 2):
+                if 0 <= rr < h and 0 <= cc < w:
