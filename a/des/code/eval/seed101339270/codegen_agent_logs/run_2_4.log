+    arrow_targets = target_frames.copy()
+    if len(arrow_targets) < 2:
+        arrow_targets.append(target_frames[0])
+    multi = int(target_frames[int(RNG.integers(0, len(target_frames)))])
+    if RNG.random() < 0.65:
+        arrow_targets.append(multi)
+    if RNG.random() < 0.3:
