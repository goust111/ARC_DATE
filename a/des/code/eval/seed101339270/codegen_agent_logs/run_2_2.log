+START_COLOR = 9
+CCW_COLOR = 1
+CW_COLOR = 2
+HFLIP_COLOR = 3
+VFLIP_COLOR = 4
+OP_COLORS = (CCW_COLOR, CW_COLOR, HFLIP_COLOR, VFLIP_COLOR)
+DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+ALL_COLORS = tuple(range(10))
