+    sprite = grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+    anchor = (int(start_pos[0] - r0), int(start_pos[1] - c0))
+    corners = {
+        (0, 0),
+        (0, sprite.shape[1] - 1),
+        (sprite.shape[0] - 1, 0),
+        (sprite.shape[0] - 1, sprite.shape[1] - 1),
