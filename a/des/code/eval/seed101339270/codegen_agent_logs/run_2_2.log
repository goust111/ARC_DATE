+def _sprite_is_clear(sprite: np.ndarray) -> bool:
+    variants = [
+        np.rot90(sprite, -1),
+        np.rot90(sprite, 1),
+        np.fliplr(sprite),
+        np.flipud(sprite),
+    ]
+    return all(not np.array_equal(sprite, variant) for variant in variants)
