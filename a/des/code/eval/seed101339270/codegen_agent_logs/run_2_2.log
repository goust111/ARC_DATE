+) -> list[tuple[int, int]]:
+    visited: set[tuple[int, int]] = set()
+    current = start_pos
+    path: list[tuple[int, int]] = []
+    while True:
+        candidates: list[tuple[int, int]] = []
+        for dr, dc in DIRS:
+            rr, cc = current
+            while True:
+                rr += dr
+                cc += dc
+                if not _in_bounds(shape, rr, cc):
+                    break
+                pos = (rr, cc)
+                if pos in markers:
+                    if pos not in visited:
