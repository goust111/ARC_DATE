+
+def _random_sprite(bg: int) -> tuple[np.ndarray, tuple[int, int]]:
+    body_colors = [c for c in ALL_COLORS if c not in {bg, START_COLOR, *OP_COLORS}]
+    for _ in range(200):
+        h = random.randint(2, 4)
+        w = random.randint(2, 4)
