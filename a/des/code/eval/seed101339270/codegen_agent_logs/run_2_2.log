+
+def _path_counts(n_points: int, horizontal_first: bool) -> tuple[int, int]:
+    if horizontal_first:
+        return (n_points + 1) // 2, n_points // 2 + 1
+    return n_points // 2 + 1, (n_points + 1) // 2
