+    tr, tc = target
+    h, w = sprite.shape
+    top = int(tr - ar)
+    left = int(tc - ac)
+    assert top >= 0 and left >= 0 and top + h <= canvas.shape[0] and left + w <= canvas.shape[1]
+    patch = sprite != bg
+    sub = canvas[top : top + h, left : left + w]
+    sub[patch] = sprite[patch]
