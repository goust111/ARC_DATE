+    symmetry = int(rng.integers(0, 8))
+    transformed_input = _apply_symmetry(grid, symmetry)
+    transformed_expected = _apply_symmetry(expected, symmetry)
+    if not np.array_equal(main(transformed_input), transformed_expected):
