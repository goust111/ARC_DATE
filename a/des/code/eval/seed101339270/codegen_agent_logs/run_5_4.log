+
+    width = max(28, 2 * max_outer_w + int(rng.integers(14, 22)))
+    height = 2 + sum(band_heights) + (pair_count - 1)
+
+    grid = np.full((height, width), BLACK, dtype=int)
+    expected = np.full_like(grid, BLACK)
+
+    band_top = 1
+    for idx, spec in enumerate(specs):
