+    for frame in sources + receivers:
+        top = frame["top"]
+        left = frame["left"]
+        bottom = frame["bottom"]
+        right = frame["right"]
+        region = frame_mask[top : bottom + 1, left : right + 1]
+        assert not region.any(), "framed objects must be disjoint"
