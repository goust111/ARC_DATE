+def _apply_filters(pattern: np.ndarray, filters):
+    out = np.array(pattern, copy=True)
+    if not filters:
+        return out
+    if len(filters) == 1:
+        out[out == filters[0]] = BLACK
+        return out
+    for idx, color in enumerate(filters):
+        replacement = filters[(idx + 1) % len(filters)]
+        out[out == color] = replacement
+    return out
