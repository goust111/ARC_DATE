+        grid[receiver_top : receiver_top + outer_h, receiver_right] = BLUE
+        grid[receiver_top, receiver_left : receiver_right + 1] = BLUE
+        grid[receiver_top + outer_h - 1, receiver_left : receiver_right + 1] = BLUE
