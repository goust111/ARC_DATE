+        ][tile_mask] = sample_color
+
+        max_holes = max(1, min(6, int(pattern_cells.sum()) // 4))
+        hole_count = random.randint(1, max_holes)
+        hole_choices = random.sample(list(map(tuple, visible_cells)), hole_count)
+        for rr, cc in hole_choices:
