+        region_in = np.full((region_h, region_w), BACKGROUND, dtype=int)
+        region_out = np.full((region_h, region_w), BACKGROUND, dtype=int)
+        region_in[pattern_cells] = pattern_color
+        region_out[repeated & ~sample_box] = pattern_color
+        region_in[
