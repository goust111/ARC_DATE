+def _spans_between(start: int, end: int, separators: Iterable[int]) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    cur = start
+    for s in sorted(int(x) for x in separators if start <= int(x) < end):
+        if cur < s:
+            spans.append((cur, s))
+        cur = s + 1
+    if cur < end:
+        spans.append((cur, end))
+    return spans
