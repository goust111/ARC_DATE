+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BACKGROUND = 0
+SEPARATOR = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+LEGEND_SIDES = ("top", "bottom", "left", "right")
+REGION_LAYOUTS = ((1, 2), (2, 1), (1, 3), (3, 1), (2, 2))
+GEN_RETRIES = 400
+TILE_RETRIES = 200
