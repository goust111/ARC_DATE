+        sample_box = np.zeros((region_h, region_w), dtype=bool)
+        sample_box[anchor_r : anchor_r + tile_h, anchor_c : anchor_c + tile_w] = True
+        pattern_cells = repeated & ~sample_box
+        visible_cells = np.argwhere(pattern_cells)
