def _random_path(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
    r, c = start
    tr, tc = end
    steps = ["r"] * abs(tr - r) + ["c"] * abs(tc - c)
    random.shuffle(steps)
    dr = 1 if tr > r else -1
    dc = 1 if tc > c else -1
    path = [(r, c)]
    for step in steps:
        if step == "r":
            r += dr
        else:
            c += dc
        path.append((r, c))
    return path


