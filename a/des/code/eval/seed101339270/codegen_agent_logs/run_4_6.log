+    if patch_h + 2 > h or patch_w + 2 > w:
+        return False
+
+    for _ in range(PIECE_SOURCE_RETRIES):
+        top = random.randint(1, h - patch_h - 1)
+        left = random.randint(1, w - patch_w - 1)
