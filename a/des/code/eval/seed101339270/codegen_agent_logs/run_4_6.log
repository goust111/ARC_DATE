+) -> list[tuple[int, int]] | None:
+    h, w = allowed.shape
+    mr, mc = marker_cell
+    starters = [(nr, nc) for nr, nc in _neighbors4(mr, mc, h, w) if bool(allowed[nr, nc])]
+    if not starters:
+        return None
