+    frame_values = g[frame_mask]
+    grey = _most_common_color(frame_values)
+
+    exterior = _flood_border(~frame_mask)
+    interior = (~frame_mask) & (~exterior)
+    assert bool(interior.any()), "expected a non-empty outline interior"
