+        grey_cells = {seed}
+        frontier = set()
+        for nr, nc in _neighbors4(seed[0], seed[1], h, w):
+            if bool(allowed[nr, nc]) and (nr, nc) not in grey_cells:
+                frontier.add((nr, nc))
