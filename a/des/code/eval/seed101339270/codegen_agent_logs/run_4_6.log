+def _grow_piece(
+    allowed: np.ndarray, marker_cell: tuple[int, int], target_size: int
+) -> list[tuple[int, int]] | None:
+    h, w = allowed.shape
+    mr, mc = marker_cell
+    starters = [(nr, nc) for nr, nc in _neighbors4(mr, mc, h, w) if bool(allowed[nr, nc])]
+    if not starters:
+        return None
