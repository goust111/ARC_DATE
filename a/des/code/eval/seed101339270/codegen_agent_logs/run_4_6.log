+        if any(bool(forbidden[r, c]) for r, c, _ in placed):
+            continue
+        for r, c, color in placed:
+            grid[r, c] = int(color)
+        _mark_with_margin(forbidden, [(r, c) for r, c, _ in placed])
+        return True
+    return False
+
+
+def _gen_attempt() -> tuple[np.ndarray, np.ndarray] | None:
