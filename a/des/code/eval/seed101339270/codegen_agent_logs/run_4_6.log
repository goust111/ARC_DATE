+    for r in range(h):
+        for c in range(w):
+            if not bool(boundary[r, c]):
+                continue
+            inside = [(nr, nc) for nr, nc in _neighbors4(r, c, h, w) if bool(interior[nr, nc])]
+            if len(inside) != 1:
+                continue
+            nr, nc = inside[0]
+            candidates[(int(nr - r), int(nc - c))].append((int(r), int(c)))
