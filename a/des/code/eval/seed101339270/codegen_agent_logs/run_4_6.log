+        while len(grey_cells) < target_size and frontier:
+            cell = random.choice(tuple(frontier))
+            frontier.remove(cell)
+            if cell in grey_cells or not bool(allowed[cell]):
+                continue
+            grey_cells.add(cell)
+            for nr, nc in _neighbors4(cell[0], cell[1], h, w):
