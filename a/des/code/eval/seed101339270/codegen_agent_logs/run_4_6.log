+def _neighbors4(r: int, c: int, h: int, w: int):
+    for dr, dc in DIRS4:
+        nr = int(r) + int(dr)
+        nc = int(c) + int(dc)
+        if 0 <= nr < h and 0 <= nc < w:
+            yield nr, nc
