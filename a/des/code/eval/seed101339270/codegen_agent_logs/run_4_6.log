+    h, w = grid.shape
+    coords = [(r, c) for r, c, _ in piece_cells]
+    r0, c0, r1, c1 = _bbox(coords)
+    patch_h = int(r1 - r0 + 1)
+    patch_w = int(c1 - c0 + 1)
