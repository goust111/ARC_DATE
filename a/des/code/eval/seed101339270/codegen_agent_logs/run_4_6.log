+        out[wall_r, wall_c] = int(piece["color"])
+        marker_r, marker_c = piece["marker"]
+        out[marker_r, marker_c] = int(piece["color"])
+        for r, c in piece["grey_cells"]:
+            out[r, c] = GREY
+
+    inp = np.full((h, w), BG, dtype=int)
+    inp[boundary] = GREY
