+    comps = _components(g != bg)
+    assert comps, "expected at least one foreground component"
+    frame = max(comps, key=len)
+    frame_mask = np.zeros((h, w), dtype=bool)
+    for r, c in frame:
+        frame_mask[r, c] = True
