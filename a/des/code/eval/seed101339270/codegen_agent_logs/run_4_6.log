+            depth = random.randint(2, max_depth)
+            span = random.randint(3, frame_w - 2)
+            start = random.randint(c0 + 1, c0 + frame_w - span - 1)
+            filled[r0 - depth : r0, start : start + span] = True
+        elif side == "bottom":
