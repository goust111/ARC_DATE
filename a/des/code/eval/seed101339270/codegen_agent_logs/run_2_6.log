+def _render_mask(grid: np.ndarray, mask: np.ndarray, box: tuple[int, int, int, int], color: int) -> None:
+    r0, c0, _r1, _c1 = box
+    patch = grid[r0 : r0 + mask.shape[0], c0 : c0 + mask.shape[1]]
+    patch[mask] = color
