+    while len(fragment) < target:
+        frontier = []
+        for r, c in fragment:
+            for dr, dc in NEIGHBORS4:
+                nr, nc = r + dr, c + dc
+                if (
+                    0 <= nr < mask.shape[0]
+                    and 0 <= nc < mask.shape[1]
+                    and mask[nr, nc]
