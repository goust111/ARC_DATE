+    col_min = max(GRID_COLS_RANGE[0], max(w for _h, w in sizes) + 2)
+    if row_min > GRID_ROWS_RANGE[1] or col_min > GRID_COLS_RANGE[1]:
+        return None
+
+    for _ in range(PLACEMENT_RETRIES):
