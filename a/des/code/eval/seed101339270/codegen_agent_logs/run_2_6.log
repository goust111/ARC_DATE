+    filled = np.argwhere(mask)
+    for r, c in filled:
+        for dr, dc in NEIGHBORS4:
+            nr, nc = int(r + dr), int(c + dc)
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                frontier.append((nr, nc))
