+            actual = main(inp)
+        except AssertionError:
+            continue
+        if np.array_equal(actual, out):
+            return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
