+    bg, pair_colors, extra_colors = _choose_colors(pair_count, activator_total)
+
+    specs: list[dict[str, object]] = []
+    cursor = 0
+    for orientation, pair_color, act_count in zip(orientations, pair_colors, act_counts):
+        specs.append(
