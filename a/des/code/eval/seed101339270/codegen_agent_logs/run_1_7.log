+def _apply_record(grid: np.ndarray, record: dict[str, object]) -> None:
+    color = int(record["pair_color"])
+    start = int(record["start"])
+    end = int(record["end"])
+
+    if record["orientation"] == "h":
+        row = int(record["fixed"])
+        grid[row, start] = color
