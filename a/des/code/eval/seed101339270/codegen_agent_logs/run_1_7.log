+    for _ in range(PAIR_ATTEMPTS):
+        span = random.randint(min_span, max_span)
+        if orientation == "h":
+            row_lo = 1 if act_count > 0 else 0
+            row_hi = height - 2 if act_count > 0 else height - 1
+            if row_lo > row_hi:
