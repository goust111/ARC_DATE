+def _generate_attempt() -> np.ndarray | None:
+    height = random.randint(MIN_GRID_SIZE, MAX_GRID_SIZE)
+    width = random.randint(MIN_GRID_SIZE, MAX_GRID_SIZE)
+    pair_count = random.randint(MIN_PAIR_COUNT, MAX_PAIR_COUNT)
