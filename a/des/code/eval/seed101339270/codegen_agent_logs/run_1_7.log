+    if _most_common_color(grid) != int(bg):
+        return None
+
+    non_bg_counts = Counter(int(v) for v in grid.ravel() if int(v) != int(bg))
+    pair_like = 0
+    singleton_count = 0
+    for color, count in non_bg_counts.items():
+        if count == 2:
