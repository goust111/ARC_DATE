+            left = col - step
+            right = col + step
+            if 0 <= left < width:
+                out[row, left] = cell_color
+            if 0 <= right < width:
+                out[row, right] = cell_color
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Connect each same-color endpoint pair with a straight line and let crossed singleton pixels expand perpendicularly.
