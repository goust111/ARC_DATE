+def _sample_layout(rng: random.Random) -> tuple[list[dict], tuple[int, int]]:
+    rows, cols = rng.choice(LAYOUT_CHOICES)
+    sizes = [
+        (
+            rng.randint(*OUTER_H_RANGE),
