+    out = g.copy()
+    placements: list[list[tuple[int, int, int]]] = []
+    occupied_targets: set[tuple[int, int]] = set()
+
+    for room in rooms:
+        sprite = room["sprite"]
+        if sprite is None:
+            continue
+        for r, c in sprite["occupied_abs"]:
+            out[r, c] = bg
