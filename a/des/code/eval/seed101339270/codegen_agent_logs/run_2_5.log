+def _boundary_cells(mask: np.ndarray, side: str) -> set[tuple[int, int]]:
+    if side == "top":
+        edge = 0
+        return {(edge, c) for c in range(mask.shape[1]) if bool(mask[edge, c])}
+    if side == "bottom":
+        edge = mask.shape[0] - 1
+        return {(edge, c) for c in range(mask.shape[1]) if bool(mask[edge, c])}
+    if side == "left":
+        edge = 0
+        return {(r, edge) for r in range(mask.shape[0]) if bool(mask[r, edge])}
