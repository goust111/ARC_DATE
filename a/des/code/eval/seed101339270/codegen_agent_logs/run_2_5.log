+def _make_door(
+    bbox: tuple[int, int, int, int], side: str, start: int, color: int
+) -> dict:
+    r0, c0, r1, c1 = bbox
+    if side == "top":
+        cells = ((r0, start), (r0, start + 1))
+    elif side == "bottom":
+        cells = ((r1, start), (r1, start + 1))
+    elif side == "left":
+        cells = ((start, c0), (start + 1, c0))
+    elif side == "right":
+        cells = ((start, c1), (start + 1, c1))
+    else:
+        raise ValueError(side)
+    return {
+        "color": int(color),
+        "side": side,
+        "start": int(start),
+        "cells": tuple(cells),
