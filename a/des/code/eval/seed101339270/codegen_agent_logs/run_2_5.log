+) -> tuple[np.ndarray, np.ndarray, list[tuple[int, int, int]], int] | None:
+    target_rotation = (SIDE_TO_INDEX[source_door["side"]] - SIDE_TO_INDEX[target_door["side"]]) % 4
+
+    for _ in range(200):
