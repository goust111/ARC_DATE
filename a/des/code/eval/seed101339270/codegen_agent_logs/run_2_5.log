+    r0, c0 = int(rows.min()), int(cols.min())
+    r1, c1 = int(rows.max()), int(cols.max())
+    return mask[r0 : r1 + 1, c0 : c1 + 1], anchor_mask[r0 : r1 + 1, c0 : c1 + 1]
