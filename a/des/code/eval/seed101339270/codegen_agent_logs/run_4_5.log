+
+            missing = border - coord_set
+            if len(missing) != 1:
+                continue
+
+            marker = next(iter(missing))
+            if g[marker] != RED:
+                continue
+
+            expected_area = len(border) - 1
+            if len(coord_set) != expected_area:
