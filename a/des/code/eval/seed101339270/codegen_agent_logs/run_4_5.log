+
+def _dominant_color(grid: np.ndarray) -> int:
+    values = np.asarray(grid, dtype=int).ravel()
+    if values.size == 0:
+        return BG
+    if np.any(values == BG):
+        return BG
+    return int(np.bincount(values).argmax())
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _border_coords(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    cells: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        cells.append((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        cells.append((r, c1))
+    return cells
+
+
+def _marker_direction(bbox: tuple[int, int, int, int], marker: tuple[int, int]) -> str | None:
+    r0, c0, r1, c1 = bbox
+    mr, mc = marker
+    if mr == r0 and c0 < mc < c1:
+        return "U"
+    if mr == r1 and c0 < mc < c1:
+        return "D"
+    if mc == c0 and r0 < mr < r1:
+        return "L"
+    if mc == c1 and r0 < mr < r1:
+        return "R"
+    return None
+
+
+def _detect_rings(grid: np.ndarray, bg: int) -> list[Ring]:
+    g = np.asarray(grid, dtype=int)
+    rings: list[Ring] = []
+    colors = [int(v) for v in np.unique(g) if int(v) not in (bg, RED)]
+    for color in colors:
+        for coords in _components(g == color):
+            if coords.size == 0:
+                continue
+            bbox_ = _bbox(coords)
+            r0, c0, r1, c1 = bbox_
+            if r1 - r0 < 2 or c1 - c0 < 2:
+                continue
+
+            border = set(_border_coords(bbox_))
+            coord_set = {tuple(map(int, cell)) for cell in coords}
+            if not coord_set.issubset(border):
