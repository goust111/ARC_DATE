+    return result
+
+
+def _frame_position(
+    rng: random.Random,
+    h: int,
+    w: int,
+    fh: int,
+    fw: int,
+    direction: str,
+) -> tuple[int, int] | None:
+    margin = 1
+    spill = 4
+    r_min = margin
+    r_max = h - fh - margin
+    c_min = margin
+    c_max = w - fw - margin
+
+    if direction == "up":
+        r_min = spill
+    elif direction == "down":
+        r_max = h - fh - spill
+    elif direction == "left":
+        c_min = spill
+    else:
+        c_max = w - fw - spill
+
+    if r_min > r_max or c_min > c_max:
+        return None
+    return rng.randint(r_min, r_max), rng.randint(c_min, c_max)
