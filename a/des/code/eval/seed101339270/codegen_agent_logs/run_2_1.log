+def _boundary_distance(frame: dict, shape: tuple[int, int]) -> int:
+    h, w = shape
+    direction = frame["direction"]
+    if direction == "down":
+        return int(h - 1 - frame["r1"])
+    if direction == "up":
+        return int(frame["r0"])
+    if direction == "right":
+        return int(w - 1 - frame["c1"])
+    return int(frame["c0"])
