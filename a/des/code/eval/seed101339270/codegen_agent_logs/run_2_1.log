+def _frame_position(
+    rng: random.Random,
+    h: int,
+    w: int,
+    fh: int,
+    fw: int,
+    direction: str,
+) -> tuple[int, int] | None:
+    margin = 1
+    spill = 4
+    r_min = margin
+    r_max = h - fh - margin
+    c_min = margin
+    c_max = w - fw - margin
+
+    if direction == "up":
+        r_min = spill
+    elif direction == "down":
+        r_max = h - fh - spill
+    elif direction == "left":
+        c_min = spill
+    else:
+        c_max = w - fw - spill
+
+    if r_min > r_max or c_min > c_max:
+        return None
+    return rng.randint(r_min, r_max), rng.randint(c_min, c_max)
+
+
+def _expanded_overlap(placed: list[dict], r0: int, c0: int, r1: int, c1: int) -> bool:
+    for frame in placed:
+        if not (
+            r1 + 1 < frame["r0"] - 1
+            or frame["r1"] + 1 < r0 - 1
+            or c1 + 1 < frame["c0"] - 1
+            or frame["c1"] + 1 < c0 - 1
+        ):
+            return True
+    return False
