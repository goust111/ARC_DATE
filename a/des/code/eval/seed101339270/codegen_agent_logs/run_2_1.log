+            if not _can_place_content(direction, line_counts, nr, nc, line_limit):
+                continue
+            choices.append((nr, nc))
+        if not choices:
+            if len(frontier) >= target:
+                break
+            expandable = []
+            for fr, fc in frontier:
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
