+def _can_place_content(
+    direction: str,
+    counts: Counter,
+    r: int,
+    c: int,
+    line_limit: int,
+) -> bool:
+    key = c if direction in ("up", "down") else r
+    return int(counts[key]) < int(line_limit)
+
