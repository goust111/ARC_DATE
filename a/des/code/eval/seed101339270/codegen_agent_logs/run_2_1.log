+def _pour_order(frames: list[dict], shape: tuple[int, int]) -> list[dict]:
+    return sorted(
+        frames,
+        key=lambda frame: (
+            -_boundary_distance(frame, shape),
+            DIR_TIEBREAK[frame["direction"]],
+            int(frame["r0"]),
+            int(frame["c0"]),
