+def _is_connected(points: set[tuple[int, int]]) -> bool:
+    if not points:
+        return False
+    start = next(iter(points))
+    seen = {start}
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIR4:
+            nb = (r + dr, c + dc)
+            if nb in points and nb not in seen:
+                seen.add(nb)
+                q.append(nb)
+    return len(seen) == len(points)
+
