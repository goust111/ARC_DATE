+def _candidate_rectangle_dims(mask_a: np.ndarray, mask_b: np.ndarray) -> set[tuple[int, int]]:
+    pts_a = {(int(r), int(c)) for r, c in np.argwhere(mask_a)}
+    pts_b = {(int(r), int(c)) for r, c in np.argwhere(mask_b)}
