+            divider_rows = [rr for rr in range(1, h - 1) if sub[rr, :].all()]
+            allowed = np.zeros_like(sub, dtype=bool)
+            allowed[0, :] = True
+            allowed[-1, :] = True
+            allowed[:, 0] = True
+            allowed[:, -1] = True
