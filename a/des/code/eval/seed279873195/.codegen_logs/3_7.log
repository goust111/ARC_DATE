+            bbox = (prev_r0 + dr, prev_c0 + dc, prev_r0 + dr + h - 1, prev_c0 + dc + w - 1)
+            if bbox[2] >= TEMP_CANVAS - 2 or bbox[3] >= TEMP_CANVAS - 2:
+                continue
