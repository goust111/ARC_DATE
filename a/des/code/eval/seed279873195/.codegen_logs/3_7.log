+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+TEMP_CANVAS = 40
+LAYER_COUNTS = (3, 4)
+BASE_RECT_RANGE = (7, 12)
+UPPER_RECT_RANGE = (6, 10)
