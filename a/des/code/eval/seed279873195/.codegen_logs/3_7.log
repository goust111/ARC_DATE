+    r1 = min(TEMP_CANVAS - 1, r1 + pad_bottom)
+    c1 = min(TEMP_CANVAS - 1, c1 + pad_right)
+
+    grid = grid[r0 : r1 + 1, c0 : c1 + 1]
+    masks = [mask[r0 : r1 + 1, c0 : c1 + 1] for mask in masks]
