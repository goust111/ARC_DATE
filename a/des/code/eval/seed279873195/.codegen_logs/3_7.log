+
+    mode = random.randrange(8)
+    masks = [_apply_transform(mask, mode) for mask in masks]
+
+    grid = np.zeros((TEMP_CANVAS, TEMP_CANVAS), dtype=int)
+    for color, mask in zip(colors, masks):
