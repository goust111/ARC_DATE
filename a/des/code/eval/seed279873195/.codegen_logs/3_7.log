+    pad_right = random.randint(*PADDING_RANGE)
+    r0 = max(0, r0 - pad_top)
+    c0 = max(0, c0 - pad_left)
+    r1 = min(TEMP_CANVAS - 1, r1 + pad_bottom)
+    c1 = min(TEMP_CANVAS - 1, c1 + pad_right)
