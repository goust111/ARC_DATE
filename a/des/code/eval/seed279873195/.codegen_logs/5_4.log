+    side = separators[-1] + 1
+    inp = np.full((side, side), BG, dtype=int)
+    out = inp.copy()
+
+    inp[separators, :] = SEPARATOR_COLOR
+    inp[:, separators] = SEPARATOR_COLOR
+    out[separators, :] = SEPARATOR_COLOR
+    out[:, separators] = SEPARATOR_COLOR
+
+    for i, mask in enumerate(col_masks, start=1):
