+def _build_example() -> tuple[np.ndarray, np.ndarray] | None:
+    count = random.choice(GRID_SIZE_OPTIONS)
+    cell_size = random.randint(*CELL_SIZE_RANGE)
+    blank_count = random.choice(MISSING_COUNT_OPTIONS)
