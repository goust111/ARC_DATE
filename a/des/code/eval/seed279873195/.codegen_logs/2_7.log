+                continue
+            marker_pos = random.choice(marker_options)
+
+            color = random.choice(target_colors)
+            decoys.append(
+                {
+                    "orientation": orientation,
+                    "cells": list(cells),
+                    "marker_pos": (int(marker_pos[0]), int(marker_pos[1])),
+                    "marker_color": int(color),
+                }
