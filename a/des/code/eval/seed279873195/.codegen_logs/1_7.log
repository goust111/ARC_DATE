+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+ARROW = 9
+MARK_COLORS = (1, 2, 3, 4, 6, 7, 8)
+DIRS = ("up", "down", "left", "right")
+GEN_RETRIES = 300
+PLACE_RETRIES = 120
