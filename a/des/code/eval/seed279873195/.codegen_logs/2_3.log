+_RNG = random.Random()
+
+
+@dataclass(frozen=True)
+class Node:
+    r0: int
+    c0: int
+    r1: int
+    c1: int
+    seed_color: int | None
+    seed_count: int
+
+    @property
+    def outer_h(self) -> int:
+        return self.r1 - self.r0 + 1
+
+    @property
+    def outer_w(self) -> int:
+        return self.c1 - self.c0 + 1
+
+
+@dataclass(frozen=True)
+class Slot:
+    vr: int
+    vc: int
