+def _paint_widened(
+    grid: np.ndarray,
+    nodes: list[Node],
+    seeded: list[Node],
+    owner: np.ndarray,
+    dist: np.ndarray,
+    blocked: np.ndarray,
+    start_axes: list[dict[tuple[int, int], set[str]]],
