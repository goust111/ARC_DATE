+                    attached = False
+                    for br, bc in _border_cells(Node(r0, c0, r1, c1, seed_color, seed_count)):
+                        for nr, nc in _neighbors4(br, bc, h, w):
+                            if r0 <= nr <= r1 and c0 <= nc <= c1:
+                                continue
+                            if int(g[nr, nc]) == GREY:
