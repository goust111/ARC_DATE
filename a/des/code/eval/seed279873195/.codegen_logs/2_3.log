+from collections import defaultdict
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+BG = 8
+GREY = 5
+SEED_COLORS = (1, 2, 3, 4, 6)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+LATTICE_MARGIN = 8
+LATTICE_SPACING = 6
+CONNECTOR_LEN = 2
+GEN_RETRIES = 400
