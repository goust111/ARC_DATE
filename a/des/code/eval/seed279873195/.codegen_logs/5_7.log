+    inp, expected = placed
+
+    if np.array_equal(inp, expected):
+        return None
+    if not np.array_equal(main(inp), expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(400):
+        grid = _generate_attempt(rng)
+        if grid is not None:
+            return grid
