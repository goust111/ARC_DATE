+
+    order = sorted(range(len(shapes)), key=lambda i: int(shapes[i]["halo"].sum()), reverse=True)
+
+    for idx in order:
+        shape = shapes[idx]
+        color = colors[idx]
+        halo = shape["halo"]
+        sh, sw = halo.shape
+        if sh > h or sw > w:
