+    for r in range(h):
+        for c in range(w):
+            if int(grid[r, c]) != BG:
+                continue
+
+            neighbors: list[tuple[int, int]] = []
+            valid = True
+            for dr, dc in DIRS8:
+                nr, nc = r + dr, c + dc
+                if not _in_bounds(h, w, nr, nc):
+                    continue
+                if int(grid[nr, nc]) != color:
