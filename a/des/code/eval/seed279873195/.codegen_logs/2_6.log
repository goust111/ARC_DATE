+def _is_connected(coords: set[tuple[int, int]]) -> bool:
+    if not coords:
+        return False
+    remaining = set(coords)
+    stack = [next(iter(remaining))]
+    seen = set()
+    while stack:
+        cell = stack.pop()
+        if cell in seen:
+            continue
+        seen.add(cell)
+        r, c = cell
+        for nxt in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if nxt in remaining and nxt not in seen:
