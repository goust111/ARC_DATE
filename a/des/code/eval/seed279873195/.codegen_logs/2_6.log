+    rows = [r for r, _c in cells]
+    cols = [c for _r, c in cells]
+    r0, c0 = min(rows), min(cols)
+    r1, c1 = max(rows), max(cols)
+    norm = frozenset((r - r0, c - c0) for r, c in cells)
+    return norm, int(r1 - r0 + 1), int(c1 - c0 + 1)
