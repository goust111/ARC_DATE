+
+def _reserve_box(reserved: np.ndarray, bbox):
+    h, w = reserved.shape
+    r0, c0, r1, c1 = bbox
+    reserved[max(0, r0 - 1) : min(h, r1 + 2), max(0, c0 - 1) : min(w, c1 + 2)] = True
