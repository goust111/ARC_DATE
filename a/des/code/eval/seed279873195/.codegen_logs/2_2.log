+
+def _balanced_statuses(rng: random.Random, n: int):
+    if n == 1:
+        return [bool(rng.randrange(2))]
+    success_count = n // 2
+    if n % 2 == 1 and rng.randrange(2):
+        success_count += 1
+    statuses = [True] * success_count + [False] * (n - success_count)
+    rng.shuffle(statuses)
+    return statuses
