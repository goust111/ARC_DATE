+    if side == "bottom":
+        return [(r, axis_coord) for r in range(r1 + 1, h)]
+    if side == "left":
+        return [(axis_coord, c) for c in range(0, c0)]
+    return [(axis_coord, c) for c in range(c1 + 1, w)]
