+    rows = _sample_spaced_positions(n_h, row_lo, row_hi, POSITION_GAP, rng)
+    cols = _sample_spaced_positions(n_v, col_lo, col_hi, POSITION_GAP, rng)
+    if rows is None or cols is None:
