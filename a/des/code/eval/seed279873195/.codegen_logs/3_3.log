+
+    grid = np.zeros((height, width), dtype=int)
+    h_c0, h_c1 = 3, width - 4
+    v_r0, v_r1 = 2, legend_top - 4
+
+    horizontals: list[dict[str, int | str]] = []
+    for idx, row in enumerate(rows):
+        color = colors[idx]
+        grid[row, h_c0 : h_c1 + 1] = color
