+
+BG = 0
+INTERSECTION = 6
+TRACK_COLORS = (1, 2, 3, 4, 5, 7, 8, 9)
+TRACK_SPLITS = ((1, 1), (1, 2), (2, 1), (2, 2), (1, 3), (3, 1))
+POSITION_GAP = 3
+GEN_RETRIES = 400
