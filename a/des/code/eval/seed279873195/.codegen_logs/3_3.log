+def _trace_track(
+    grid: np.ndarray,
+    color: int,
+    start: tuple[int, int],
+    step: tuple[int, int],
+) -> tuple[list[tuple[int, int]], tuple[int, int]]:
+    r, c = start
+    dr, dc = step
+    path: list[tuple[int, int]] = []
+
+    while True:
