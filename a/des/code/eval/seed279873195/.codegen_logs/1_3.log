+    left_zone = (1, 1, h - 1, split - 1)
+    right_zone = (1, split + 1, h - 1, w - 1)
+    if layout == "lr":
+        return left_zone, right_zone
+    return right_zone, left_zone
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
