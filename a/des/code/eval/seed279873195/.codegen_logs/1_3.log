+        shape, shape_size = _normalize(cells)
+        if shape_size != (h, w):
+            continue
+        if (0, 0) not in shape:
+            continue
+        if shape in used:
+            continue
+        used.add(shape)
+        return shape, shape_size
+    return None
+
+
