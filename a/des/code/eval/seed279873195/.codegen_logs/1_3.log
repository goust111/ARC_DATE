+def _bbox(points: Iterable[tuple[int, int]]) -> tuple[int, int, int, int]:
+    pts = [(int(r), int(c)) for r, c in points]
+    rs = [r for r, _ in pts]
+    cs = [c for _, c in pts]
+    return min(rs), min(cs), max(rs), max(cs)
