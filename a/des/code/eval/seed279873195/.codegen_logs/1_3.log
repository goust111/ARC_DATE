+    return None
+
+
+def _draw_pair(grid: np.ndarray, obj: dict[str, object], top: int, left: int) -> None:
+    color = int(obj["color"])
+    for dr, dc in obj["shape"]:  # type: ignore[index]
+        grid[top + dr, left + dc] = GREY
+    for dr, dc in obj["pad"]:  # type: ignore[index]
