+    canvas_order.sort(key=lambda i: canvas_shapes[i][0] * canvas_shapes[i][1], reverse=True)
+
+    grid = np.full((h, w), BLACK, dtype=int)
+    blocked = np.zeros((h, w), dtype=bool)
+    pair_zone, canvas_zone = _zones_for_layout(layout, h, w, rng)
