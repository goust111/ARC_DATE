+        return False
+    for c in range(c0, c1 + 1):
+        if grid[r0, c] != MAROON or grid[r1, c] != MAROON:
+            return False
+    for r in range(r0, r1 + 1):
+        if grid[r, c0] != MAROON or grid[r, c1] != MAROON:
+            return False
+    if np.any(grid[r0 + 1 : r1, c0 + 1 : c1] == MAROON):
+        return False
+    return len(pts) == 2 * ((r1 - r0 + 1) + (c1 - c0 + 1)) - 4
