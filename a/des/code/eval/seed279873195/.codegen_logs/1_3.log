+
+BLACK = 0
+GREY = 5
+MAROON = 9
+INK_COLORS = [1, 2, 3, 4, 6, 7, 8]
+
+GEN_ATTEMPTS = 400
+MIN_PAIRS = 2
+MAX_PAIRS = 4
+PLACEMENT_GAP = 2
+LAYOUTS = ("tb", "bt", "lr", "rl")
