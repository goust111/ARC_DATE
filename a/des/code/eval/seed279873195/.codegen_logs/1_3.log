+
+    canvas_specs: list[dict[str, object]] = []
+    for idx in canvas_order:
+        color = colors[idx]
+        height, width, shape_h, shape_w = canvas_shapes[idx]
+        pos = _place_rect(blocked, canvas_zone, height, width, rng)
+        if pos is None:
