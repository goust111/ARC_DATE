+    open_count = rng.randint(1, wall_count - 1)
+    total_blocks = rng.randint(
+        max(EXTRA_BLOCK_GOAL[0], open_count),
+        min(EXTRA_BLOCK_GOAL[1], len(BLOCK_COLORS)),
