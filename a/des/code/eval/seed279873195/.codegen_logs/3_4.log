+        if side == "top":
+            br1 = r0 - corridor - 1
+            br0 = br1 - bh + 1
+            bc0_lo = max(0, gc - bw + 1)
+            bc0_hi = min(gc, w_grid - bw)
+            if bc0_lo > bc0_hi:
+                continue
+            bc0 = rng.randint(bc0_lo, bc0_hi)
+            bc1 = bc0 + bw - 1
+        elif side == "bottom":
+            br0 = r1 + corridor + 1
+            br1 = br0 + bh - 1
+            bc0_lo = max(0, gc - bw + 1)
+            bc0_hi = min(gc, w_grid - bw)
+            if bc0_lo > bc0_hi:
+                continue
+            bc0 = rng.randint(bc0_lo, bc0_hi)
+            bc1 = bc0 + bw - 1
+        elif side == "left":
+            bc1 = c0 - corridor - 1
+            bc0 = bc1 - bw + 1
+            br0_lo = max(0, gr - bh + 1)
+            br0_hi = min(gr, h_grid - bh)
+            if br0_lo > br0_hi:
+                continue
+            br0 = rng.randint(br0_lo, br0_hi)
+            br1 = br0 + bh - 1
+        else:
+            bc0 = c1 + corridor + 1
+            bc1 = bc0 + bw - 1
+            br0_lo = max(0, gr - bh + 1)
+            br0_hi = min(gr, h_grid - bh)
+            if br0_lo > br0_hi:
+                continue
+            br0 = rng.randint(br0_lo, br0_hi)
+            br1 = br0 + bh - 1
+
+        if not _bbox_free(reserved, br0, bc0, br1, bc1):
+            continue
