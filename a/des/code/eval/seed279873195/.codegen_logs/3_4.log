+        if h_grid - bh - 1 < 1 or w_grid - bw - 1 < 1:
+            continue
+        r0 = rng.randint(1, h_grid - bh - 1)
+        c0 = rng.randint(1, w_grid - bw - 1)
+        r1 = r0 + bh - 1
+        c1 = c0 + bw - 1
