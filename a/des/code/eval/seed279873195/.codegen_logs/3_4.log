+def _mark_bbox(reserved: np.ndarray, r0: int, c0: int, r1: int, c1: int, pad: int = 1) -> None:
+    h, w = reserved.shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h - 1, r1 + pad)
