+    is_bottom = gr == r1 and c0 < gc < c1
+    is_left = gc == c0 and r0 < gr < r1
+    is_right = gc == c1 and r0 < gr < r1
+    matches = [side for side, ok in zip(SIDES, (is_top, is_bottom, is_left, is_right)) if ok]
+    if len(matches) != 1:
+        return None
+    return matches[0]
