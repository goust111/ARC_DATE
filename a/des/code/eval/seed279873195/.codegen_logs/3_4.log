+    return walls
+
+
+def _ray_color(grid: np.ndarray, gap: tuple[int, int], side: str) -> int | None:
+    h, w = grid.shape
+    dr, dc = SIDE_TO_DIR[side]
+    r, c = gap
+    while True:
+        r += dr
+        c += dc
+        if not (0 <= r < h and 0 <= c < w):
+            return None
+        value = int(grid[r, c])
+        if value == BG:
