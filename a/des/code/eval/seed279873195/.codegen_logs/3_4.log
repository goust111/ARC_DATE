+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _component_coords(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
