+    h, w = g.shape
+    containers = []
+    used_centers = set()
+    for r0 in range(h - 2):
+        for c0 in range(w - 2):
+            patch = g[r0 : r0 + 3, c0 : c0 + 3]
+            if int(patch[1, 1]) != BLACK:
