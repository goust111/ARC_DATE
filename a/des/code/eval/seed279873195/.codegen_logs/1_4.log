+) -> tuple[dict[tuple[int, int], list[tuple[int, int]]], dict[tuple[int, int], int]]:
+    node_set = set(nodes)
+    root = nodes[0]
+    parent = {root: None}
+    order = [root]
+    stack = [root]
+    while stack:
+        node = stack.pop()
