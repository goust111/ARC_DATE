+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+MAROON = 9
+
+PRIMARY_COLORS = (BLUE, RED, YELLOW)
+COLOR_TO_BIT = {
+    BLUE: 1,
+    RED: 2,
+    YELLOW: 4,
+}
+MASK_TO_COLOR = {
+    1: BLUE,
+    2: RED,
+    4: YELLOW,
+    3: MAGENTA,  # blue + red
+    5: GREEN,    # blue + yellow
+    6: ORANGE,   # red + yellow
+    7: MAROON,   # blue + red + yellow
