        # Trim bg border rows/cols from sprite
        mask = (sprite != bg)
        rows_any = np.any(mask, axis=1)
        cols_any = np.any(mask, axis=0)
        if not rows_any.any():
            continue
        r0, r1 = np.where(rows_any)[0][[0, -1]]
        c0, c1 = np.where(cols_any)[0][[0, -1]]
        sprite = sprite[r0:r1+1, c0:c1+1]

        sh, sw = sprite.shape
