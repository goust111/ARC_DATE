+def _find_source_blocks(g: np.ndarray) -> list[dict]:
+    h, w = g.shape
+    sources = []
+    used = set()
+    for r0 in range(h - 2):
+        for c0 in range(w - 2):
+            bbox = (r0, c0, r0 + 2, c0 + 2)
+            if bbox in used:
