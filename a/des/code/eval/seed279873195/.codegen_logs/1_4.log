    return adj


def _orient_tree_component(
    nodes: list[tuple[int, int]],
    adj: dict[tuple[int, int], list[tuple[int, int]]],
    source_bits: dict[tuple[int, int], int],
    sink_nodes: set[tuple[int, int]],
