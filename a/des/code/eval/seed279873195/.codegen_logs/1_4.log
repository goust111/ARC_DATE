+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+MAROON = 9
+
+PRIMARY_COLORS = (BLUE, RED, YELLOW)
+COLOR_TO_BIT = {
+    BLUE: 1,
+    RED: 2,
+    YELLOW: 4,
+}
