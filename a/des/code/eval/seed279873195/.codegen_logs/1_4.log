+            if indeg_work[nxt] == 0:
+                q.append(nxt)
+    if seen != len(nodes):
+        raise AssertionError("directed pipe graph must be a DAG")
+    return masks
+
+
+def _mask_to_output_color(mask: int) -> int:
+    if mask not in MASK_TO_COLOR:
+        raise AssertionError("unsupported color mixture")
+    return MASK_TO_COLOR[mask]
+
+
