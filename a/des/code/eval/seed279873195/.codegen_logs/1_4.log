+    1: BLUE,
+    2: RED,
+    4: YELLOW,
+    3: MAGENTA,  # blue + red
+    5: GREEN,    # blue + yellow
+    6: ORANGE,   # red + yellow
+    7: MAROON,   # blue + red + yellow
