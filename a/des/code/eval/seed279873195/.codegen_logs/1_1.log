+        elif kind == "vertical":
+            p = random.uniform(0.25, 0.75)
+            mask = np.zeros((size, size), dtype=bool)
+            for c in range((size + 1) // 2):
+                col = np.random.rand(size) < p
+                mask[:, c] = col
+                mask[:, size - 1 - c] = col
+        elif kind == "rot180":
