+    placements: list[dict | None] = [None] * len(placed_specs)
+    for idx in order:
+        spec = placed_specs[idx]
+        outer_h = int(spec["outer_h"])
+        outer_w = int(spec["outer_w"])
+        max_r0 = limit_row - outer_h + 1
+        max_c0 = w - outer_w - 1
+        if max_r0 < 1 or max_c0 < 1:
+            return None
+        success = False
+        for _ in range(PLACEMENT_ATTEMPTS):
