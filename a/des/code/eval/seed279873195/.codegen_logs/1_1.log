+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                if rr > 0 and bool(mask[rr - 1, cc]) and not bool(seen[rr - 1, cc]):
+                    seen[rr - 1, cc] = True
+                    q.append((rr - 1, cc))
+                if rr + 1 < h and bool(mask[rr + 1, cc]) and not bool(seen[rr + 1, cc]):
+                    seen[rr + 1, cc] = True
+                    q.append((rr + 1, cc))
+                if cc > 0 and bool(mask[rr, cc - 1]) and not bool(seen[rr, cc - 1]):
+                    seen[rr, cc - 1] = True
+                    q.append((rr, cc - 1))
+                if cc + 1 < w and bool(mask[rr, cc + 1]) and not bool(seen[rr, cc + 1]):
+                    seen[rr, cc + 1] = True
+                    q.append((rr, cc + 1))
+            comps.append(np.array(cells, dtype=int))
+    return comps
