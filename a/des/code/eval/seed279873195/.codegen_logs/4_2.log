+    path_index = {cell: idx for idx, cell in enumerate(path)}
+    pipe_set = set(path)
+
+    filter_candidates = []
+    for frag in fragments:
+        body = frag["body"]  # type: ignore[assignment]
+        for i in range(1, len(body) - 2):
+            a = body[i]
+            b = body[i + 1]
+            if a[0] == b[0]:
+                offsets = [(-1, 0), (1, 0)]
+            else:
