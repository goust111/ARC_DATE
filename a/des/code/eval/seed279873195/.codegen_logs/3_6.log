+    palette = [1, 2, 4, 5, 6, 7, 8, 9]
+    if n_frames + chain_len - 1 > len(palette):
+        return None
+    sampled = rng.sample(palette, n_frames + chain_len - 1)
+    frame_colors = sampled[:n_frames]
+    chain = [OUTER_PATTERN_COLOR] + sampled[n_frames:]
