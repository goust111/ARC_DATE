+    if sorted(tuple(frame["bbox"]) for frame in frames) != sorted(frame_bboxes):
+        return None
+    if any(not _collect_first_layer(grid, bbox, chain[0]) for bbox in frame_bboxes):
+        return None
+
+    try:
