+    if r < row_lo:
+        nr = r + 1
+    elif r > row_hi:
+        nr = r - 1
+    else:
+        nr = r
+
+    if c < col_lo:
+        nc = c + 1
+    elif c > col_hi:
+        nc = c - 1
+    else:
+        nc = c
+
+    return nr, nc
