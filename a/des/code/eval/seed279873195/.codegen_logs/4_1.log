+            for idx, sprite in enumerate(sprites):
+                if idx in used:
+                    continue
+                rotated = _rot_cw(sprite["mask"], turns)
+                if rotated.shape == hole["mask"].shape and np.array_equal(rotated, hole["mask"]):
