+def _find_holes_in_frame(grid: np.ndarray, frame: dict) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    r0, c0, r1, c1 = frame["bbox"]
+    inner = g[r0 + 1 : r1, c0 + 1 : c1] == BG
