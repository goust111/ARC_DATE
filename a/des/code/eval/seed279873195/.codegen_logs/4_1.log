        max(top_right["inner_w"] + 2, bottom_right["inner_w"] + 2),
    ]
    row_heights = [
        max(top_left["inner_h"] + 2, top_right["inner_h"] + 2),
        max(bottom_left["inner_h"] + 2, bottom_right["inner_h"] + 2),
