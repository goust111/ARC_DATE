+
+def _random_connected_mask() -> np.ndarray | None:
+    for _ in range(200):
+        h = _RNG.randint(2, 4)
+        w = _RNG.randint(2, 4)
+        max_cells = min(h * w - 1, 7)
+        if max_cells < 3:
+            continue
+        target = _RNG.randint(3, max_cells)
+        start = (_RNG.randrange(h), _RNG.randrange(w))
+        cells = {start}
+        frontier = set()
+        for nr, nc in _neighbors4(*start):
