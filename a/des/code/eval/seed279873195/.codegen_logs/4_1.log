+def _layout_holes(hole_masks: list[np.ndarray]) -> tuple[int, int, list[tuple[int, int, np.ndarray]]]:
+    margin = 1
+    if len(hole_masks) == 1:
+        hole = hole_masks[0]
+        hh, hw = hole.shape
+        extra_h = _RNG.randint(0, 2)
+        extra_w = _RNG.randint(0, 2)
