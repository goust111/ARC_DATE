+def _find_frames(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    frames: list[dict] = []
+    for color in sorted(int(v) for v in np.unique(g) if int(v) != BG):
+        color_mask = g == color
