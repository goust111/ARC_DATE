import random
from collections import deque

import numpy as np


BG_COLOR = 0
FRAME_COLOR = 5
SHADOW_COLOR = 9
PATTERN_COLORS = [1, 2, 3, 4, 6, 7, 8]
SIDES = ("up", "down", "left", "right")
DIR_BY_SIDE = {
    "up": (-1, 0),
    "down": (1, 0),
    "left": (0, -1),
    "right": (0, 1),
}

GRID_H_RANGE = (18, 30)
GRID_W_RANGE = (18, 30)
FRAME_COUNT_BY_AREA = (
    (520, (3, 4)),
    (0, (2, 3)),
)
FRAME_H_RANGE = (5, 10)
FRAME_W_RANGE = (5, 10)
FRAME_PLACEMENT_TRIES = 140
GENERATION_ATTEMPTS = 400
PADDING = 1


def _neighbors4(r: int, c: int):
    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
        yield r + dr, c + dc


def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    parts: list[list[tuple[int, int]]] = []

    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            seen[r, c] = True
            q = deque([(r, c)])
            coords: list[tuple[int, int]] = []
            while q:
                cr, cc = q.popleft()
                coords.append((cr, cc))
                for nr, nc in _neighbors4(cr, cc):
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            parts.append(coords)

    return parts


def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
    rows = [r for r, _ in coords]
    cols = [c for _, c in coords]
    return min(rows), min(cols), max(rows), max(cols)


def _box_in_bounds(box: tuple[int, int, int, int], h: int, w: int) -> bool:
    r0, c0, r1, c1 = box
    return 0 <= r0 <= r1 < h and 0 <= c0 <= c1 < w


def _boxes_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])


def _expand_box(
    box: tuple[int, int, int, int], pad: int, h: int, w: int
) -> tuple[int, int, int, int]:
    r0, c0, r1, c1 = box
    return max(0, r0 - pad), max(0, c0 - pad), min(h - 1, r1 + pad), min(w - 1, c1 + pad)


def _frame_border_cells(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
    cells: list[tuple[int, int]] = []
    for c in range(c0, c1 + 1):
        cells.append((r0, c))
        cells.append((r1, c))
    for r in range(r0 + 1, r1):
        cells.append((r, c0))
        cells.append((r, c1))
    return cells


def _shift_box(
    box: tuple[int, int, int, int], dr: int, dc: int, dist: int
) -> tuple[int, int, int, int]:
    r0, c0, r1, c1 = box
    return r0 + dr * dist, c0 + dc * dist, r1 + dr * dist, c1 + dc * dist


def _system_geometry(
    r0: int, c0: int, outer_h: int, outer_w: int, side: str
) -> dict[str, tuple[int, int, int, int] | int | str]:
    r1 = r0 + outer_h - 1
    c1 = c0 + outer_w - 1
    src_box = (r0, c0, r1, c1)
    safe_box = (r0 + 2, c0 + 2, r1 - 2, c1 - 2)
    dr, dc = DIR_BY_SIDE[side]
    dist = (outer_h - 2) if dr else (outer_w - 2)
    dst_safe_box = _shift_box(safe_box, dr, dc, dist)
    footprint = (
        min(src_box[0], dst_safe_box[0]),
        min(src_box[1], dst_safe_box[1]),
        max(src_box[2], dst_safe_box[2]),
        max(src_box[3], dst_safe_box[3]),
    )
    return {
        "src_box": src_box,
        "safe_box": safe_box,
        "dst_safe_box": dst_safe_box,
        "footprint": footprint,
        "dist": dist,
        "side": side,
    }


def _frame_from_component(grid: np.ndarray, coords: list[tuple[int, int]]) -> dict:
    r0, c0, r1, c1 = _bbox(coords)
    assert r1 - r0 + 1 >= 5 and c1 - c0 + 1 >= 5, "frame must have room for a non-touching pattern"

    border = set(_frame_border_cells(r0, c0, r1, c1))
    coord_set = set(coords)
    assert coord_set <= border, "gray component must lie on its rectangle border"

    missing = [cell for cell in border if cell not in coord_set]
    assert len(missing) == 1, "frame must have exactly one missing border pixel"
    gap_r, gap_c = missing[0]
    assert int(grid[gap_r, gap_c]) == BG_COLOR, "gap pixel must be black"

    on_top = gap_r == r0
    on_bottom = gap_r == r1
    on_left = gap_c == c0
    on_right = gap_c == c1
    assert sum((on_top, on_bottom, on_left, on_right)) == 1, "gap must lie on a single side"
    assert not ((on_top or on_bottom) and (on_left or on_right)), "gap must not be on a corner"

    if on_top:
        side = "up"
    elif on_bottom:
        side = "down"
    elif on_left:
        side = "left"
    else:
        side = "right"

    interior = grid[r0 + 1 : r1, c0 + 1 : c1]
    pattern_mask = (interior != BG_COLOR) & (interior != FRAME_COLOR)
    assert pattern_mask.any(), "each frame must contain a pattern"
    assert not pattern_mask[0, :].any()
    assert not pattern_mask[-1, :].any()
    assert not pattern_mask[:, 0].any()
    assert not pattern_mask[:, -1].any()
    assert len(_components(pattern_mask)) == 1, "pattern inside each frame must be 4-connected"

    return {
        "bbox": (r0, c0, r1, c1),
        "side": side,
        "pattern_mask": pattern_mask,
    }


def _find_frames(grid: np.ndarray) -> list[dict]:
    frame_mask = grid == FRAME_COLOR
    frames = [_frame_from_component(grid, comp) for comp in _components(frame_mask)]
    frames.sort(key=lambda item: item["bbox"])
    return frames


def main(grid: np.ndarray) -> np.ndarray:
    """
    Move each interior pattern out of its gray frame in the direction of the frame's unique gap.
    The original pattern position becomes a maroon shadow, and frame pixels stay unchanged.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    out = g.copy()
    frames = _find_frames(g)
