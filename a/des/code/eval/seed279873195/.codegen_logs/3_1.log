def _candidate_dimensions(h: int, w: int, side: str, rng: random.Random) -> tuple[int, int] | None:
    max_h = min(FRAME_H_RANGE[1], h - 2)
    max_w = min(FRAME_W_RANGE[1], w - 2)
    if side in ("left", "right"):
        max_w = min(max_w, (w + 2) // 2)
    else:
        max_h = min(max_h, (h + 2) // 2)
    if max_h < FRAME_H_RANGE[0] or max_w < FRAME_W_RANGE[0]:
        return None
    outer_h = rng.randint(FRAME_H_RANGE[0], max_h)
    outer_w = rng.randint(FRAME_W_RANGE[0], max_w)
    return outer_h, outer_w


def _place_system(
    grid: np.ndarray,
    reserved: list[tuple[int, int, int, int]],
    color: int,
    side: str,
    rng: random.Random,
) -> bool:
    h, w = grid.shape
    dims = _candidate_dimensions(h, w, side, rng)
    if dims is None:
        return False
    outer_h, outer_w = dims

    for _ in range(FRAME_PLACEMENT_TRIES):
        r0 = rng.randint(0, h - outer_h)
        c0 = rng.randint(0, w - outer_w)
        geometry = _system_geometry(r0, c0, outer_h, outer_w, side)
        footprint = geometry["footprint"]
        if not _box_in_bounds(footprint, h, w):
            continue
        padded = _expand_box(footprint, PADDING, h, w)
        if any(_boxes_overlap(padded, prev) for prev in reserved):
            continue

        src_r0, src_c0, src_r1, src_c1 = geometry["src_box"]
        grid[src_r0 : src_r1 + 1, src_c0] = FRAME_COLOR
        grid[src_r0 : src_r1 + 1, src_c1] = FRAME_COLOR
        grid[src_r0, src_c0 : src_c1 + 1] = FRAME_COLOR
        grid[src_r1, src_c0 : src_c1 + 1] = FRAME_COLOR

        if side == "up":
            gap = (src_r0, rng.randint(src_c0 + 1, src_c1 - 1))
        elif side == "down":
            gap = (src_r1, rng.randint(src_c0 + 1, src_c1 - 1))
        elif side == "left":
            gap = (rng.randint(src_r0 + 1, src_r1 - 1), src_c0)
        else:
            gap = (rng.randint(src_r0 + 1, src_r1 - 1), src_c1)
        grid[gap] = BG_COLOR

        safe_r0, safe_c0, safe_r1, safe_c1 = geometry["safe_box"]
        mask = _random_connected_mask(safe_r1 - safe_r0 + 1, safe_c1 - safe_c0 + 1, rng)
        patch = grid[safe_r0 : safe_r1 + 1, safe_c0 : safe_c1 + 1]
        patch[mask] = color

        reserved.append(padded)
        return True

    return False


def _validate_generated(grid: np.ndarray, expected_count: int) -> bool:
    try:
        frames = _find_frames(grid)
        if len(frames) != expected_count:
            return False

        used_dest: set[tuple[int, int]] = set()
        seen_colors: set[int] = set()
        for frame in frames:
            r0, c0, r1, c1 = frame["bbox"]
            side = frame["side"]
            dr, dc = DIR_BY_SIDE[side]
            dist = (r1 - r0 - 1) if dr else (c1 - c0 - 1)
            interior = grid[r0 + 1 : r1, c0 + 1 : c1]
            colors = set(map(int, np.unique(interior))) - {BG_COLOR, FRAME_COLOR}
            if len(colors) != 1:
                return False
            color = next(iter(colors))
            if color in seen_colors:
                return False
            seen_colors.add(color)

            pattern_mask = (interior != BG_COLOR) & (interior != FRAME_COLOR)
            for ir, ic in np.argwhere(pattern_mask):
                src_r = int(r0 + 1 + ir)
                src_c = int(c0 + 1 + ic)
                dst = (src_r + dr * dist, src_c + dc * dist)
                if not (0 <= dst[0] < grid.shape[0] and 0 <= dst[1] < grid.shape[1]):
                    return False
                if int(grid[dst]) != BG_COLOR or dst in used_dest:
                    return False
                used_dest.add(dst)

        out = main(grid)
        if np.array_equal(out, grid):
            return False
    except Exception:
        return False
    return True


def _gen_attempt(rng: random.Random) -> np.ndarray | None:
    h = rng.randint(*GRID_H_RANGE)
    w = rng.randint(*GRID_W_RANGE)
    grid = np.full((h, w), BG_COLOR, dtype=int)

    frame_count = _choose_frame_count(h, w, rng)
    if frame_count > len(PATTERN_COLORS):
        return None

    colors = rng.sample(PATTERN_COLORS, frame_count)
    sides = rng.sample(SIDES, frame_count)
    reserved: list[tuple[int, int, int, int]] = []

    for color, side in zip(colors, sides):
        if not _place_system(grid, reserved, color, side, rng):
            return None

    if not _validate_generated(grid, frame_count):
        return None
    return grid


def generate_input() -> np.ndarray:
    rng = random.Random()
    for _ in range(GENERATION_ATTEMPTS):
        grid = _gen_attempt(rng)
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid input")

