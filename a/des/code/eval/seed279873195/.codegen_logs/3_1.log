+def _make_system(direction: str, rng: random.Random) -> tuple[np.ndarray, np.ndarray] | None:
+    gap_width = rng.randint(*GAP_WIDTH_RANGE)
+    shape = _choose_shape(direction, gap_width, rng)
+    if shape is None:
+        return None
+    ph, pw = map(int, shape.shape)
+
