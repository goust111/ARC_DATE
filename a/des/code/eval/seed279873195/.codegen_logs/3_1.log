            assert 0 <= dst_r < g.shape[0] and 0 <= dst_c < g.shape[1]
            out[src_r, src_c] = SHADOW_COLOR
            out[dst_r, dst_c] = int(g[src_r, src_c])

    return out


def _random_connected_mask(h: int, w: int, rng: random.Random) -> np.ndarray:
    area = h * w
    if area == 1:
