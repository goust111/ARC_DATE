+            assert out[rr, cc] == bg, "teleported pattern cannot overwrite walls or existing content"
+            out[rr, cc] = g[r, c]
+
+    return out
+
+
+def _build_top_room(inner_h, inner_w, portal_col):
+    portal = (0, portal_col)
