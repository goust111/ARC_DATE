+import random
+from collections import Counter, defaultdict, deque
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+PATTERN = 4
+PORTAL_COLORS = (1, 2, 3, 6, 7, 8, 9)
+SIDE_ORDER = ("top", "right", "bottom", "left")
+SIDE_TO_IDX = {side: idx for idx, side in enumerate(SIDE_ORDER)}
+
+GRID_MIN_SIDE = 18
+GRID_MAX_SIDE = 30
+ROOM_GAP = 1
