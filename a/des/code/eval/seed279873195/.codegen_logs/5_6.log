+        "portal": (pr, pc),
+        "portal_color": int(grid[pr, pc]),
+        "side": side,
+        "side_idx": SIDE_TO_IDX[side],
+        "pattern": pattern,
+    }
+
+
+def _extract_rooms(grid, bg):
