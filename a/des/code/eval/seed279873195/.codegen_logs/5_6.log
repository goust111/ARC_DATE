+    out = g.copy()
+    for color, pair in by_color.items():
+        assert len(pair) == 2, f"portal color {color} must appear in exactly two rooms"
+        sources = [room for room in pair if room["pattern"]]
+        targets = [room for room in pair if not room["pattern"]]
