+
+
+def _rot_cw(coord, turns):
+    r, c = coord
+    turns %= 4
+    if turns == 0:
+        return int(r), int(c)
+    if turns == 1:
+        return int(c), int(-r)
+    if turns == 2:
+        return int(-r), int(-c)
+    return int(-c), int(r)
+
+
+def _bbox(coords):
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components(mask):
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        q = deque([(r, c)])
+        seen[r, c] = True
+        pts = []
+        while q:
+            rr, cc = q.popleft()
+            pts.append((rr, cc))
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                nr, nc = rr + dr, cc + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        comps.append(pts)
+    return comps
+
+
+def _normalize_shape(coords):
+    r0, c0, _, _ = _bbox(coords)
+    return tuple(sorted((r - r0, c - c0) for r, c in coords))
+
+
+def _rotate_many(coords, turns):
+    return [_rot_cw(coord, turns) for coord in coords]
+
+
+def _component_to_room(grid, pts, bg):
+    if len(pts) < 8:
+        return None
+
+    r0, c0, r1, c1 = _bbox(pts)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return None
+
+    comp = set(pts)
+    border = set()
+    for c in range(c0, c1 + 1):
+        border.add((r0, c))
+        border.add((r1, c))
+    for r in range(r0 + 1, r1):
+        border.add((r, c0))
+        border.add((r, c1))
+    if comp != border:
+        return None
+
+    colors = Counter(int(grid[r, c]) for r, c in pts)
+    wall_color, _ = colors.most_common(1)[0]
+    portal_cells = [(r, c) for r, c in pts if int(grid[r, c]) != wall_color]
+    if len(portal_cells) != 1:
+        return None
+
+    pr, pc = portal_cells[0]
+    if (pr in (r0, r1)) and (pc in (c0, c1)):
+        return None
+    if pr == r0:
+        side = "top"
+    elif pc == c1:
+        side = "right"
+    elif pr == r1:
+        side = "bottom"
+    elif pc == c0:
+        side = "left"
+    else:
+        return None
+
+    inner_fg = []
+    for r in range(r0 + 1, r1):
+        for c in range(c0 + 1, c1):
+            if int(grid[r, c]) != bg:
+                inner_fg.append((r, c))
+
+    pattern = []
+    if inner_fg:
+        sub = np.zeros((r1 - r0 - 1, c1 - c0 - 1), dtype=bool)
+        for r, c in inner_fg:
