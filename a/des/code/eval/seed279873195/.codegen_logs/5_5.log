+
+def _find_legend_bbox(grid: np.ndarray) -> tuple[int, int, int, int]:
+    candidates: list[tuple[int, tuple[int, int, int, int]]] = []
+    for comp in _components(grid == MAROON):
+        r0, c0, r1, c1 = _bbox(comp)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
