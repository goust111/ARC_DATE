+    c0 = max(0, left)
+    r1 = min(h - 1, bottom)
+    c1 = min(w - 1, right)
+    if r0 > r1 or c0 > c1:
+        return []
+    return [(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)]
