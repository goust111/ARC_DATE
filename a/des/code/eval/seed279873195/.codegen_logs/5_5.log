+        elif corner == 1:
+            legend_top, legend_left = 1, w - lw - 1
+        elif corner == 2:
+            legend_top, legend_left = h - lh - 1, 1
+        else:
+            legend_top, legend_left = h - lh - 1, w - lw - 1
+        _place_patch(grid, legend, legend_top, legend_left)
+        legend_cells = [
