+
+def _marker_candidates(shape: list[tuple[int, int]], direction: str) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = _bbox(shape)
+    out: list[tuple[int, int]] = []
+    for r, c in shape:
+        on_top = r == r0
+        on_right = c == c1
+        on_bottom = r == r1
+        on_left = c == c0
+        if direction == "up" and on_top and not on_left and not on_right and not on_bottom:
+            out.append((r, c))
+        elif direction == "right" and on_right and not on_top and not on_bottom and not on_left:
+            out.append((r, c))
+        elif direction == "down" and on_bottom and not on_left and not on_right and not on_top:
+            out.append((r, c))
+        elif direction == "left" and on_left and not on_top and not on_bottom and not on_right:
