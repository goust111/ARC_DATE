+
+def _marker_candidates(shape: list[tuple[int, int]], direction: str) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = _bbox(shape)
+    out: list[tuple[int, int]] = []
+    for r, c in shape:
+        if r not in (r0, r1) and c not in (c0, c1):
+            continue
