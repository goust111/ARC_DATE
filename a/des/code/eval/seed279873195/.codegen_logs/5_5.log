+            grid[top0 + grey_local[0], left0 + grey_local[1]] = GREY
+            _mark_blocked(blocked, shape_cells + stamp_region, margin=1)
+
+        if ok:
+            return grid
+
+    raise RuntimeError("failed to generate a valid input")

