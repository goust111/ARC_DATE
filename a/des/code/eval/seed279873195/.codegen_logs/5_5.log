+        left = grey_c - size // 2
+    elif direction == "down":
+        top = grey_r + 2
+        left = grey_c - size // 2
+    elif direction == "left":
+        top = grey_r - size // 2
+        left = grey_c - size - 1
+    else:
+        top = grey_r - size // 2
+        left = grey_c + 2
+    return top, left, top + size - 1, left + size - 1
