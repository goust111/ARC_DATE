+def _place_patch(grid: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    h, w = patch.shape
+    grid[top : top + h, left : left + w] = patch
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
