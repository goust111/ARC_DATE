+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+MAROON = 9
+PALETTE = (1, 2, 3, 4, 6, 7, 8)
+DIR_ORDER = ("up", "right", "down", "left")
+DIR_STEPS = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _outline_mask(size: int) -> np.ndarray:
+    mask = np.zeros((size, size), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _square_outline_coords(top: int, left: int, size: int) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    bottom = top + size - 1
+    right = left + size - 1
+    for c in range(left, right + 1):
+        coords.append((top, c))
+        if bottom != top:
+            coords.append((bottom, c))
+    for r in range(top + 1, bottom):
+        coords.append((r, left))
+        if right != left:
+            coords.append((r, right))
+    return coords
+
+
+def _stamp_bbox_from_grey(grey_r: int, grey_c: int, size: int, direction: str) -> tuple[int, int, int, int]:
+    if direction == "up":
+        top = grey_r - size - 1
+        left = grey_c - size // 2
+    elif direction == "down":
+        top = grey_r + 2
+        left = grey_c - size // 2
+    elif direction == "left":
+        top = grey_r - size // 2
+        left = grey_c - size - 1
+    else:
+        top = grey_r - size // 2
+        left = grey_c + 2
+    return top, left, top + size - 1, left + size - 1
+
+
+def _stamp_region_in_bounds(
+    h: int, w: int, top: int, left: int, bottom: int, right: int
+) -> list[tuple[int, int]]:
+    r0 = max(0, top)
+    c0 = max(0, left)
+    r1 = min(h - 1, bottom)
+    c1 = min(w - 1, right)
+    if r0 > r1 or c0 > c1:
+        return []
+    return [(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)]
+
+
+def _find_legend_bbox(grid: np.ndarray) -> tuple[int, int, int, int]:
+    candidates: list[tuple[int, tuple[int, int, int, int]]] = []
+    for comp in _components(grid == MAROON):
+        r0, c0, r1, c1 = _bbox(comp)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 3 or w < 3:
+            continue
+        border = _outline_mask(h)
+        if border.shape != (h, h) and h != w:
+            border = np.zeros((h, w), dtype=bool)
+            border[0, :] = True
+            border[-1, :] = True
+            border[:, 0] = True
+            border[:, -1] = True
+        else:
+            border = np.zeros((h, w), dtype=bool)
+            border[0, :] = True
+            border[-1, :] = True
+            border[:, 0] = True
+            border[:, -1] = True
+        if len(comp) != int(border.sum()):
+            continue
+        if np.array_equal(grid[r0 : r1 + 1, c0 : c1 + 1] == MAROON, border):
+            candidates.append((h * w, (r0, c0, r1, c1)))
