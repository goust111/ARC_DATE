+        return None
+
+    max_r = max(y + obj["patch"].shape[0] for obj, y, _ in placements)
+    max_c = max(x + obj["patch"].shape[1] for obj, _, x in placements)
+    grid = np.zeros((max_r, max_c), dtype=int)
+    expected = np.zeros_like(grid)
