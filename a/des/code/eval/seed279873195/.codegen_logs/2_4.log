+        grid[r0 + grey_pos[0], c0 + grey_pos[1]] = GRAY
+        assignments.append(
+            {
+                "row_idx": int(row_idx),
+                "col_idx": int(col_idx),
+                "direction": direction,
+                "color": int(color),
+                "side": side,
+            }
+        )
+
+    expected = _render_expected(
