+    full = np.full((main_h, legend_w + 1 + main_w), BLACK, dtype=int)
+    full[:, legend_w] = GREY
+    _paint_legend(full[:, :legend_w], mapping)
+    full[:, legend_w + 1 :] = main
+
+    try:
+        out = main_func = main(full)
+    except Exception:
+        return None
+
+    if out.shape != main.shape:
+        return None
+    if not bool((out == GREY).any()):
+        return None
+    if not bool((out != BLACK).any()):
+        return None
+    return full
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid input")

