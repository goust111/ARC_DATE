+    colors = list(np.random.permutation(PIECE_COLORS)[: len(specs)])
+    groups: list[dict[str, object]] = []
+    for idx, (kind, a, b) in enumerate(specs):
+        scenario = _build_scenario(kind, a=a, b=b, h=main_h, w=main_w)
+        if scenario is None:
+            return None
+        placed = _place_scenario(
