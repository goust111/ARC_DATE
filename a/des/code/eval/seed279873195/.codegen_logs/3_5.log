+                return None
+        seed_r, seed_c_local, marker_r, marker_c_local, stamp_cells = placement
+        seed_c = separator_col + 1 + seed_c_local
+        marker_c = separator_col + 1 + marker_c_local
+        grid[seed_r, seed_c] = int(color)
+        grid[marker_r, marker_c] = YELLOW
