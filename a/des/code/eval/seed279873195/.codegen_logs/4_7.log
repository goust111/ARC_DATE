    rr1 = min(h - 1, r1 + margin)
    cc1 = min(w - 1, c1 + margin)
    return rr0, cc0, rr1, cc1


def _pick_cells(
    inner_h: int, inner_w: int, count: int
) -> list[tuple[int, int]]:
    cells = [(r, c) for r in range(inner_h) for c in range(inner_w)]
    return random.sample(cells, count)


