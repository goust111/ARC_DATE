    chosen = random.choice(lookups)
    return [chosen, chosen, chosen], chosen


def _reserve_box(
    reserve: np.ndarray, r0: int, c0: int, r1: int, c1: int, margin: int
) -> tuple[int, int, int, int]:
    h, w = reserve.shape
