+def _draw_dashed_border(grid: np.ndarray, box: tuple[int, int, int, int], color: int) -> None:
+    h, w = grid.shape
+    for idx, (r, c) in enumerate(_ordered_border(*box)):
+        if idx % 2 == 0 and 0 <= r < h and 0 <= c < w:
+            grid[r, c] = int(color)
