+    modes = ["all_same", "two_plus_one", "tie"]
+    random.shuffle(modes)
+    for mode in modes:
+        if mode == "all_same":
+            chosen = random.choice(lookups)
+            return [chosen, chosen, chosen], chosen
+        if mode == "two_plus_one" and len(lookups) >= 2:
+            chosen = random.choice(lookups)
