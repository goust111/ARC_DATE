+    map_c1 = map_c0 + 1
+    if map_r1 >= h:
+        return None
+    for idx, (src, tgt) in enumerate(mapping):
+        grid[map_r0 + idx, map_c0] = int(src)
+        grid[map_r0 + idx, map_c0 + 1] = int(tgt)
+    rr0, cc0, rr1, cc1 = _reserve_box(reserve, map_r0, map_c0, map_r1, map_c1, margin=1)
