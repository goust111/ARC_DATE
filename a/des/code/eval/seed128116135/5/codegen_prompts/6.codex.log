+import random
+from dataclasses import dataclass
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+GRAY = 5
+ORANGE = 7
+RECT_COLORS = (1, 3, 4, 6, 8, 9)
+GEN_RETRIES = 400
+PLACE_RETRIES = 200
+MIN_LINE_LEN = 4
