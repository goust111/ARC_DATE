+                {
+                    "orientation": "vertical",
+                    "a": (r, c),
+                    "b": (r, c + 1),
+                    "dir_a": (0, 1),
+                    "dir_b": (0, -1),
+                }
+            )
+    for r in range(n_rows - 1):
+        for c in range(n_cols):
+            edges.append(
+                {
+                    "orientation": "horizontal",
+                    "a": (r, c),
+                    "b": (r + 1, c),
+                    "dir_a": (1, 0),
+                    "dir_b": (-1, 0),
+                }
+            )
+    return edges
+
+
+def _ray_first_event(
+    stage: np.ndarray,
+    region: dict[str, Any],
+    direction: tuple[int, int],
+    sep_rows: list[int],
+    sep_cols: list[int],
+) -> str:
+    r, c = map(int, region["center"])
+    dr, dc = direction
