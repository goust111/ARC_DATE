+    for start, end, _ in runs:
+        abs_start = c0 + start
+        abs_end = c0 + end - 1
+        sample_cols = list(range(abs_start + 1, abs_end))
+        if not sample_cols:
+            sample_cols = list(range(abs_start, abs_end + 1))
+
+        votes = 0
+        for c in sample_cols:
+            rows = np.flatnonzero(path_mask[:, c])
+            assert rows.size > 0
+            if int(rows.max()) < r0:
+                votes -= 1
+            elif int(rows.min()) > r1:
+                votes += 1
