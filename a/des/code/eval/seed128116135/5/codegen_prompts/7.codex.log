+        coords = np.argwhere(comp)
+        if coords.size == 0:
+            continue
+        r0, c0, r1, c1 = _bbox_from_coords(coords)
+        local = comp[r0 : r1 + 1, c0 : c1 + 1]
+        h, w = local.shape
