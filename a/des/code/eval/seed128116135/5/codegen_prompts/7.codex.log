+    grid[fr1, fc0 : fc1 + 1] = GREY
+    grid[fr0 : fr1 + 1, fc0] = GREY
+    grid[fr0 : fr1 + 1, fc1] = GREY
+    grid[divider, fc0 : fc1 + 1] = GREY
+    grid[fr0 + 1 : divider, fc0 + 1 : fc1] = top_sample
+    grid[divider + 1 : fr1, fc0 + 1 : fc1] = bottom_sample
