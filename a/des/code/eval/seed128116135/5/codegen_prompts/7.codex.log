+            left = _random_color_block((h, half), colors, rng)
+            arr = np.concatenate([left, np.fliplr(left)], axis=1)
+        elif kind == "vertical":
+            half = int(rng.integers(2, 5))
+            w = int(rng.integers(3, 7))
+            top = _random_color_block((half, w), colors, rng)
+            arr = np.concatenate([top, np.flipud(top)], axis=0)
+        else:
+            h = int(rng.integers(4, 9))
+            w = int(rng.integers(4, 9))
+            if h % 2 == 1:
+                h += 1
+            if w % 2 == 1:
+                w += 1
+            arr = np.zeros((h, w), dtype=int)
+            filled = np.zeros((h, w), dtype=bool)
+            for r in range(h):
+                for c in range(w):
+                    if filled[r, c]:
+                        continue
+                    rr = h - 1 - r
+                    cc = w - 1 - c
+                    color = int(rng.choice(colors))
+                    arr[r, c] = color
+                    arr[rr, cc] = color
+                    filled[r, c] = True
+                    filled[rr, cc] = True
+        if _classify_symmetry(arr) == kind:
+            return arr
+    raise AssertionError(f"failed to create {kind} pattern")
+
+
+def _place_pattern(
+    grid: np.ndarray,
+    pattern: np.ndarray,
+    row_range: tuple[int, int],
+    col_range: tuple[int, int],
+    gap: int,
+    rng: np.random.Generator,
+) -> bool:
+    ph, pw = pattern.shape
+    rmin, rmax = row_range
+    cmin, cmax = col_range
+    if rmax - rmin + 1 < ph or cmax - cmin + 1 < pw:
+        return False
+    for _ in range(80):
+        r0 = int(rng.integers(rmin, rmax - ph + 2))
+        c0 = int(rng.integers(cmin, cmax - pw + 2))
+        rr0 = max(0, r0 - gap)
+        cc0 = max(0, c0 - gap)
+        rr1 = min(grid.shape[0], r0 + ph + gap)
+        cc1 = min(grid.shape[1], c0 + pw + gap)
+        if np.any(grid[rr0:rr1, cc0:cc1] != BLACK):
+            continue
+        grid[r0 : r0 + ph, c0 : c0 + pw] = pattern
+        return True
+    return False
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rng = np.random.default_rng()
+    sample_h = int(rng.integers(3, 6))
+    sample_w = int(rng.integers(4, 8))
+    colors = list(map(int, rng.choice(COLOR_POOL, size=int(rng.integers(3, 6)), replace=False)))
+    mapping = _random_derangement(colors, rng)
+
+    top_sample = _make_sample_pattern(sample_h, sample_w, colors, rng)
+    bottom_sample = top_sample.copy()
+    for color, target in mapping.items():
+        bottom_sample[top_sample == int(color)] = int(target)
+
+    kinds = ["none", "horizontal", "vertical", "rotation"]
+    rng.shuffle(kinds)
+    patterns = {kind: _make_pattern(kind, colors, rng) for kind in kinds}
+
+    tl_kind, tr_kind, bl_kind, br_kind = kinds
+    tl = patterns[tl_kind]
+    tr = patterns[tr_kind]
+    bl = patterns[bl_kind]
+    br = patterns[br_kind]
+
+    gap = 2
+    top_space = max(tl.shape[0], tr.shape[0]) + gap + 2 + int(rng.integers(0, 3))
+    bottom_space = max(bl.shape[0], br.shape[0]) + gap + 2 + int(rng.integers(0, 3))
+    left_space = max(tl.shape[1], bl.shape[1]) + gap + 2 + int(rng.integers(0, 3))
+    right_space = max(tr.shape[1], br.shape[1]) + gap + 2 + int(rng.integers(0, 3))
+
+    frame_h = 2 * sample_h + 3
+    frame_w = sample_w + 2
+    h = top_space + frame_h + bottom_space
+    w = left_space + frame_w + right_space
+    if h > 30 or w > 30:
+        return None
+
+    grid = np.zeros((h, w), dtype=int)
+    fr0 = top_space
+    fc0 = left_space
+    fr1 = fr0 + frame_h - 1
+    fc1 = fc0 + frame_w - 1
+    divider = fr0 + sample_h + 1
+
+    grid[fr0, fc0 : fc1 + 1] = GREY
+    grid[fr1, fc0 : fc1 + 1] = GREY
+    grid[fr0 : fr1 + 1, fc0] = GREY
+    grid[fr0 : fr1 + 1, fc1] = GREY
+    grid[divider, fc0 : fc1 + 1] = GREY
+    grid[fr0 + 1 : divider, fc0 + 1 : fc1] = top_sample
+    grid[divider + 1 : fr1, fc0 + 1 : fc1] = bottom_sample
+
+    placements = [
+        (tl, (1, fr0 - gap - tl.shape[0]), (1, fc0 - gap - tl.shape[1])),
+        (tr, (1, fr0 - gap - tr.shape[0]), (fc1 + gap, w - tr.shape[1] - 1)),
+        (bl, (fr1 + gap, h - bl.shape[0] - 1), (1, fc0 - gap - bl.shape[1])),
+        (br, (fr1 + gap, h - br.shape[0] - 1), (fc1 + gap, w - br.shape[1] - 1)),
+    ]
+
+    for pattern, rows, cols in placements:
+        if rows[0] > rows[1] or cols[0] > cols[1]:
+            return None
+        if not _place_pattern(grid, pattern, rows, cols, gap=1, rng=rng):
+            return None
+
+    try:
+        solved = main(grid)
+    except Exception:
+        return None
+    if solved.shape != grid.shape:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

