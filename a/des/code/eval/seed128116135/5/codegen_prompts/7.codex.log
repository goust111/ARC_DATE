+        bottom_sample[top_sample == int(color)] = int(target)
+
+    kinds = ["none", "horizontal", "vertical", "rotation"]
+    rng.shuffle(kinds)
+    patterns = {kind: _make_pattern(kind, colors, rng) for kind in kinds}
+
+    tl_kind, tr_kind, bl_kind, br_kind = kinds
+    tl = patterns[tl_kind]
+    tr = patterns[tr_kind]
+    bl = patterns[bl_kind]
+    br = patterns[br_kind]
