+    for pattern, rows, cols in placements:
+        if rows[0] > rows[1] or cols[0] > cols[1]:
+            return None
+        if not _place_pattern(grid, pattern, rows, cols, gap=1, rng=rng):
+            return None
+
+    try:
+        solved = main(grid)
+    except Exception:
+        return None
+    if solved.shape != grid.shape:
+        return None
+    return grid
