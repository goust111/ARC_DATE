+    rot = np.array_equal(arr, np.rot90(arr, 2))
+    if horiz and not vert and not rot:
+        return "horizontal"
+    if vert and not horiz and not rot:
+        return "vertical"
+    if rot and not horiz and not vert:
+        return "rotation"
+    if not horiz and not vert and not rot:
+        return "none"
+    return "ambiguous"
