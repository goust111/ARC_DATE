+    tl = patterns[tl_kind]
+    tr = patterns[tr_kind]
+    bl = patterns[bl_kind]
+    br = patterns[br_kind]
+
+    gap = 2
+    top_space = max(tl.shape[0], tr.shape[0]) + gap + 2 + int(rng.integers(0, 3))
+    bottom_space = max(bl.shape[0], br.shape[0]) + gap + 2 + int(rng.integers(0, 3))
+    left_space = max(tl.shape[1], bl.shape[1]) + gap + 2 + int(rng.integers(0, 3))
+    right_space = max(tr.shape[1], br.shape[1]) + gap + 2 + int(rng.integers(0, 3))
