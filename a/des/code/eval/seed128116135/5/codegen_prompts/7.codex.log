+def _apply_mapping(arr: np.ndarray, kind: str, mapping: dict[int, int]) -> np.ndarray:
+    out = arr.copy()
+    h, w = arr.shape
+    if kind == "horizontal":
+        rs = slice(0, h)
+        cs = slice(w // 2, w)
+    elif kind == "vertical":
+        rs = slice(h // 2, h)
+        cs = slice(0, w)
+    elif kind == "rotation":
+        rs = slice(h // 2, h)
+        cs = slice(w // 2, w)
+    else:
+        rs = slice(0, h)
+        cs = slice(0, w)
+
+    sub = out[rs, cs]
+    original = sub.copy()
+    for color, target in mapping.items():
