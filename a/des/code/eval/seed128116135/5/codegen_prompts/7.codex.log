+            bottom_h = h - rr - 2
+            if top_h <= 0 or top_h != bottom_h:
+                continue
+            expected = np.zeros_like(local, dtype=bool)
+            expected[0, :] = True
+            expected[-1, :] = True
+            expected[:, 0] = True
+            expected[:, -1] = True
+            expected[rr, :] = True
