+        (bl, (fr1 + gap, h - bl.shape[0] - 1), (1, fc0 - gap - bl.shape[1])),
+        (br, (fr1 + gap, h - br.shape[0] - 1), (fc1 + gap, w - br.shape[1] - 1)),
+    ]
