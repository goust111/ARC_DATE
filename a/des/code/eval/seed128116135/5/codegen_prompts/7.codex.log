    left_space = max(tl.shape[1], bl.shape[1]) + sep + 1 + int(rng.integers(0, 2))
    right_space = max(tr.shape[1], br.shape[1]) + sep + 1 + int(rng.integers(0, 2))
    frame_h = 2 * sample_h + 3
