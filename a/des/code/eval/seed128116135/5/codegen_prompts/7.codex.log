+    grid = np.zeros((h, w), dtype=int)
+    fr0 = top_space
+    fc0 = left_space
+    fr1 = fr0 + frame_h - 1
+    fc1 = fc0 + frame_w - 1
+    divider = fr0 + sample_h + 1
