+    row_specs: list[tuple[str, int]] = []
+    col_specs: list[tuple[str, int]] = []
+
+    row_sides = ["left", "right"]
+    col_sides = ["top", "bottom"]
+    rng.shuffle(row_sides)
+    rng.shuffle(col_sides)
