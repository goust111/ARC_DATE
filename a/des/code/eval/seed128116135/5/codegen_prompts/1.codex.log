+def _place_patch(grid: np.ndarray, occ: np.ndarray, patch: np.ndarray, rng: random.Random) -> bool:
+    gh, gw = grid.shape
+    ph, pw = patch.shape
+    spots = [(r, c) for r in range(gh - ph + 1) for c in range(gw - pw + 1)]
