+
+def _branch_dimensions(branch: str, seed_h: int, seed_w: int, rng: random.Random) -> tuple[int, int]:
+    if branch == "vertical":
+        inner_h = seed_h * rng.randint(2, 4) + rng.randint(0, seed_h - 1)
