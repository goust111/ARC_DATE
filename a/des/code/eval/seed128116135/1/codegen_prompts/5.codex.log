+    elif direction == "down":
+        start_r, start_c = bottom + 1, gap_c
+        cells = [(start_r, start_c + i) for i in range(len(payload))]
+    elif direction == "left":
+        start_r, start_c = gap_r, left - 1
+        cells = [(start_r + i, start_c) for i in range(len(payload))]
+    else:
