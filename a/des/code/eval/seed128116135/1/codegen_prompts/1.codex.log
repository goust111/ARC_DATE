+def _colorize_mask(mask: np.ndarray, colors: tuple[int, ...]) -> np.ndarray:
+    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    seeds = random.sample(coords, len(colors))
+    patch = np.zeros(mask.shape, dtype=int)
