+    if quad == (0, 0):
+        return arr.copy()
+    if quad == (0, 1):
+        return np.fliplr(arr)
+    if quad == (1, 0):
+        return np.flipud(arr)
+    if quad == (1, 1):
+        return np.flipud(np.fliplr(arr))
+    raise AssertionError(f"invalid quadrant {quad}")
