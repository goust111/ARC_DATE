0044:     assert start_region > 0, "lower-left corner must belong to a background region"
0045: 
0046:     wall_lab, n_walls = label_mask(g == wall, connectivity=4)
0047:     assert n_walls >= 1
0048: 
0049:     graph: dict[int, set[int]] = defaultdict(set)
0050:     for wall_id in range(1, n_walls + 1):
