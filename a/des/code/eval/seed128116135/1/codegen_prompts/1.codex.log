+        out.append((r - 1, c))
+    if r + 1 < h:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < w:
+        out.append((r, c + 1))
+    return out
+
+
+def _grow_connected_mask(h: int, w: int, area: int) -> np.ndarray:
+    cells = {(random.randrange(h), random.randrange(w))}
+    frontier = set(_neighbors(next(iter(cells)), h, w))
+    while len(cells) < area:
+        if not frontier:
+            return np.zeros((h, w), dtype=bool)
