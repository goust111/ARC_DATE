+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+FRAME_COLORS = (BLUE, RED, GREEN, YELLOW)
+PATTERN_COLORS = (5, 6, 7, 8, 9)
+MAX_GEN_RETRIES = 400
+
+_GEN_CALL_COUNT = 0
