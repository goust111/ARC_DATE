+        for outer_bbox, inner_bbox in zip(chain[:-1], chain[1:]):
+            mode = frames[outer_bbox]
+            assert mode in FRAME_COLORS, "frame colors must be blue/red/green/yellow"
+            _fill_gap(out, outer_bbox, inner_bbox, pattern, mode)
