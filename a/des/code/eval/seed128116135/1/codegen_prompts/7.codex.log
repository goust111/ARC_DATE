+        grid[cursor, :] = AZURE
+
+    cursor = 1 if outer_border else 0
+    if outer_border:
+        grid[:, 0] = AZURE
+    for idx, size in enumerate(col_sizes):
+        c0 = int(cursor)
+        c1 = int(cursor + size - 1)
+        col_spans.append((c0, c1))
+        cursor = int(c1 + 1)
+        if idx != len(col_sizes) - 1:
+            grid[:, cursor] = AZURE
+            cursor += 1
+    if outer_border:
+        grid[:, cursor] = AZURE
+
+    return grid, row_spans, col_spans
