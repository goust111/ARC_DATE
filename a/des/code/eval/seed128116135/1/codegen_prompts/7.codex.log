+                if (r - pr) % 2 == 0:
+                    out[r, c0 : c1 + 1] = color
+                else:
+                    out[r, c0 : c1 + 1] = BG
+        else:
+            for c in range(c0, c1 + 1):
+                if (c - pc) % 2 == 0:
