    out = g.copy()
    out[top + 1 : bottom, left + 1 : right] = BG

    gap_r, gap_c = gap
    if direction == "up":
        start_r, start_c = top - 1, gap_c
        cells = [(start_r, start_c + i) for i in range(len(payload))]
    elif direction == "down":
        start_r, start_c = bottom + 1, gap_c
        cells = [(start_r, start_c + i) for i in range(len(payload))]
    elif direction == "left":
