  55: def main(grid: np.ndarray) -> np.ndarray:
  56:     """
  57:     Fill partitioned regions with concentric colored bands derived from marker pixels.
  58: 
  59:     Input structure:
  60:     - Grid partitioned into regions by wall-colored lines.
  61:     - Each region has a dominant base color and a few isolated marker pixels of other colors at varying depths from the region boundary.
  62: 
  63:     Rule:
  64:     - For each region, read marker colors ordered by their Chebyshev distance from the boundary to build a color palette.
  65:     - If no marker sits on the boundary itself, the base color leads the palette.
  66:     - Paint every cell with palette[distance mod palette_length], producing repeating concentric rectangular frames that radiate inward.
  67: 
  68:     Key insight: Each marker's depth from the boundary defines its position in the cyclic palette; the pattern then tiles inward automatically.
  69:     """
  70:     g = np.asarray(grid, dtype=int)
  71:     h, w = g.shape
  72: 
  73:     # Global background and wall color (the main partition lines).
  74:     bg = _mode(g)
  75:     other = g[g != bg]
  76:     wall = bg if other.size == 0 else _mode(other)
  77: 
  78:     out = g.copy()
  79:     free = g != wall
  80:     comps = _cc4(free)
  81: 
  82:     for pts in comps:
  83:         # Build component mask
  84:         comp_mask = np.zeros((h, w), dtype=bool)
  85:         for r, c in pts:
  86:             comp_mask[r, c] = True
  87: 
  88:         vals = g[comp_mask]
  89:         base = _mode(vals)
  90:         dist = _boundary_distance(comp_mask)
  91: 
  92:         # Markers are cells whose color differs from the region base.
  93:         # Pick at most one marker color per distance (closest in reading order).
  94:         dist_to_color: dict[int, int] = {}
  95:         for r, c in pts:
  96:             v = int(g[r, c])
  97:             if v == base:
  98:                 continue
  99:             d = int(dist[r, c])
 100:             if d < 0:
 101:                 continue
 102:             if d not in dist_to_color:
 103:                 dist_to_color[d] = v
 104:             else:
 105:                 # stable tie-breaker: prefer earlier (r,c)
 106:                 pass
 107: 
 108:         palette: list[int] = []
 109:         if dist_to_color:
 110:             ds = sorted(dist_to_color.keys())
 111:             if ds[0] > 0:
 112:                 palette.append(int(base))
 113:             for d in ds:
 114:                 palette.append(int(dist_to_color[d]))
 115:         else:
 116:             palette = [int(base)]
 117: 
 118:         m = len(palette)
 119:         for r, c in pts:
 120:             d = int(dist[r, c])
 121:             out[r, c] = palette[d % m]
 122: 
