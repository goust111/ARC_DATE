+    if len(set(colors)) != len(colors):
+        return None
+    if _path_turns(path_list) < 1:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
