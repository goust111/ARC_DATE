+def _random_color() -> int:
+    return int(random.choice(INPUT_COLORS))
+
+
+def _augment_antennas(required: dict[str, int], extra_dirs: tuple[str, ...] | None = None) -> dict[str, int]:
+    antennas = dict(required)
