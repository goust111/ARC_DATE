+
+
+def _make_piece_patch(mask: np.ndarray, marker: int) -> np.ndarray:
+    patch = np.full(mask.shape, BG, dtype=int)
+    patch[mask] = MAROON
+    cells = [tuple(map(int, cell)) for cell in np.argwhere(mask)]
