+    slack = total_len - need
+    extras = _random_composition(slack, len(lengths) + 1)
+    starts: list[int] = []
+    cur = extras[0]
+    for i, length in enumerate(lengths):
+        starts.append(cur)
+        cur += length
+        if i + 1 < len(lengths):
+            cur += gap + extras[i + 1]
