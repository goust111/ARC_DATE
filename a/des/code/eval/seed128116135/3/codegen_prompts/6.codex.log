+def _random_partition(total: int, parts: int) -> list[int]:
+    out = [1] * parts
+    for _ in range(total - parts):
+        out[random.randrange(parts)] += 1
+    return out
+
+
+def _random_composition(total: int, bins: int) -> list[int]:
+    if bins == 1:
