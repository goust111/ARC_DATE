+def _frame_info(grid: np.ndarray, bg: int) -> dict:
+    counts = Counter(int(v) for v in grid.ravel() if int(v) != int(bg))
+    assert counts, "expected a non-background frame"
+    frame_color = counts.most_common(1)[0][0]
+    coords = np.argwhere(grid == int(frame_color))
+    r0, c0, r1, c1 = _bbox(coords)
+    thickness = min(
+        _run_len(grid, r0, c0, 1, 0, frame_color),
+        _run_len(grid, r0, c0, 0, 1, frame_color),
+        _run_len(grid, r0, c1, 1, 0, frame_color),
+        _run_len(grid, r0, c1, 0, -1, frame_color),
+        _run_len(grid, r1, c0, -1, 0, frame_color),
+        _run_len(grid, r1, c0, 0, 1, frame_color),
+        _run_len(grid, r1, c1, -1, 0, frame_color),
+        _run_len(grid, r1, c1, 0, -1, frame_color),
