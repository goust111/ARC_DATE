+    slot_mask = ring & (grid == int(bg))
+    slots: list[dict] = []
+    for coords in _components(slot_mask):
+        sr0, sc0, sr1, sc1 = _bbox(coords)
+        touched = []
+        if sr0 == r0:
+            touched.append("top")
+        if sr1 == r1:
+            touched.append("bottom")
+        if sc0 == c0:
+            touched.append("left")
+        if sc1 == c1:
+            touched.append("right")
