# Canvas and colors.
GEN_BG = 0
GEN_GRID_SHAPE = (30, 30)
GEN_MARKER_COLOR = 1
GEN_DOMINANT_COLOR = 8
GEN_ACCENT_COLORS = [2, 3, 4, 5, 6, 7, 9]

# Symbolic lattice layout.
GEN_SIDES = ["top", "right", "bottom", "left"]
GEN_SYMBOLIC_HW = (7, 6)
GEN_SYMBOLIC_VW = (6, 7)
GEN_DOMINANT_COUNT_RANGE = (13, 17)
GEN_ACCENT_COUNT_RANGE = (6, 8)
GEN_SPLIT_INDEX = 3

