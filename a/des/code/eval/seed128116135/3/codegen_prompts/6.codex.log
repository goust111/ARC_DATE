+    if coords.size == 0:
+        return False
+    seen = set()
+    stack = [tuple(map(int, coords[0]))]
+    target = int(mask.sum())
+    while stack:
+        cell = stack.pop()
+        if cell in seen:
+            continue
+        seen.add(cell)
+        r, c = cell
+        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc]:
+                stack.append((nr, nc))
