+    for piece, slot in matches:
+        sr0, sc0, sr1, sc1 = slot["bbox"]
+        tmask, fill = _transform_mask(piece["mask"], piece["side"], piece["marker"])
+        out[sr0 : sr1 + 1, sc0 : sc1 + 1][tmask] = int(fill)
