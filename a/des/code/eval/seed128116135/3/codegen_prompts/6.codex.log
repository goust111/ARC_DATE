+
+
+def _piece_side(piece_bbox: tuple[int, int, int, int], frame_bbox: tuple[int, int, int, int]) -> str:
+    pr0, pc0, pr1, pc1 = piece_bbox
+    fr0, fc0, fr1, fc1 = frame_bbox
+    if pr1 < fr0:
+        return "top"
+    if pr0 > fr1:
+        return "bottom"
+    if pc1 < fc0:
+        return "left"
+    if pc0 > fc1:
