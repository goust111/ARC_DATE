+        touched = []
+        if sr0 == r0:
+            touched.append("top")
+        if sr1 == r1:
+            touched.append("bottom")
+        if sc0 == c0:
+            touched.append("left")
+        if sc1 == c1:
+            touched.append("right")
+        assert len(touched) == 1, touched
+        side = touched[0]
+        if side in ("top", "bottom"):
+            assert sr1 - sr0 + 1 == t
+        else:
