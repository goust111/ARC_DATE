from __future__ import annotations

import random

import numpy as np


BG = 0
PALETTE = tuple(range(1, 10))

GRID_HEIGHT_RANGE = (10, 24)
GRID_WIDTH_RANGE = (10, 24)
OBJECT_COUNT_CAP = 5
RECT_SIZE_MIN = 2
RECT_SIZE_MAX = 8
RECT_PADDING = 1
