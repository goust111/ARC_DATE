+        if not comps:
+            continue
+        largest = max(comps, key=len)
+        r0, c0, r1, c1 = _bbox(largest)
+        if len(largest) < 8 or (r1 - r0 + 1) < 4 or (c1 - c0 + 1) < 4:
+            continue
