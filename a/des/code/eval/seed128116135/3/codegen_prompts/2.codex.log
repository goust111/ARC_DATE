+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        mask = patch == color
+        holes = []
+        for comp in _components_mask(~mask):
+            if any(
+                rr == 0 or cc == 0 or rr == mask.shape[0] - 1 or cc == mask.shape[1] - 1
+                for rr, cc in comp
+            ):
+                continue
+            markers: dict[int, list[tuple[int, int]]] = {}
+            for rr, cc in comp:
