def _on_side(r, c, ph, pw, side):
    if side == SIDE_TOP:
        return r == 0
    if side == SIDE_BOTTOM:
        return r == ph - 1
    if side == SIDE_LEFT:
        return c == 0
    return c == pw - 1


def _on_other_side(r, c, ph, pw, side):
    return (
        (side != SIDE_TOP and r == 0)
        or (side != SIDE_BOTTOM and r == ph - 1)
        or (side != SIDE_LEFT and c == 0)
        or (side != SIDE_RIGHT and c == pw - 1)
    )


