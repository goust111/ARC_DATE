+def _is_plus(cells: list[tuple[int, int]]) -> bool:
+    pts = {(int(r), int(c)) for r, c in cells}
+    if len(pts) != 5:
+        return False
+    for r, c in pts:
+        if {
+            (r, c),
+            (r - 1, c),
+            (r + 1, c),
+            (r, c - 1),
+            (r, c + 1),
+        } == pts:
