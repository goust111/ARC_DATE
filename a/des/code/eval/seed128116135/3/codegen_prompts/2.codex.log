+            return None
+        patches.append(patch)
+
+    grid = _place_patches(patches, bg)
+    if grid is None:
+        return None
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    if np.array_equal(out, grid):
+        return None
+    if int(np.sum(grid == bg)) <= max(int(np.sum(grid == color)) for color in np.unique(grid)):
+        return None
+    return grid
+
