+
+def _candidate_holes(h: int, w: int) -> list[tuple[int, int, int, int]]:
+    starts = [
+        (1, 1),
+        (1, w - 4),
+        (h - 4, 1),
+        (h - 4, w - 4),
+        ((h - 3) // 2, (w - 3) // 2),
+        (1, (w - 3) // 2),
+        (h - 4, (w - 3) // 2),
+        ((h - 3) // 2, 1),
+        ((h - 3) // 2, w - 4),
+    ]
+    rects = []
+    seen = set()
+    for r0, c0 in starts:
+        rect = (int(r0), int(c0), int(r0 + 2), int(c0 + 2))
+        if rect[0] < 1 or rect[1] < 1 or rect[2] >= h - 1 or rect[3] >= w - 1:
+            continue
+        if rect in seen:
+            continue
+        seen.add(rect)
+        rects.append(rect)
+    return rects
+
+
+def _hole_capacity(h: int, w: int) -> int:
+    rects = _candidate_holes(h, w)
+    best = 0
+    for _ in range(60):
+        random.shuffle(rects)
+        chosen: list[tuple[int, int, int, int]] = []
+        for rect in rects:
+            if any(_rects_too_close(rect, other) for other in chosen):
+                continue
+            chosen.append(rect)
+        best = max(best, len(chosen))
+    return best
+
+
+def _choose_holes(h: int, w: int, count: int) -> list[tuple[int, int, int, int]] | None:
+    if count == 0:
+        return []
+    rects = _candidate_holes(h, w)
+    for _ in range(120):
+        random.shuffle(rects)
+        chosen: list[tuple[int, int, int, int]] = []
+        for rect in rects:
+            if any(_rects_too_close(rect, other) for other in chosen):
+                continue
+            chosen.append(rect)
+            if len(chosen) == count:
