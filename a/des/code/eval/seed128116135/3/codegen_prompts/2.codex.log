+    for rect, payload in zip(hole_rects, payloads, strict=False):
+        r0, c0, r1, c1 = rect
+        patch[r0 : r1 + 1, c0 : c1 + 1] = bg
+        kind, value = payload
+        if kind == EMPTY:
+            continue
+        if kind == MARKER:
+            rr = random.randint(r0, r1)
+            cc = random.randint(c0, c1)
+            patch[rr, cc] = int(value)
+            continue
