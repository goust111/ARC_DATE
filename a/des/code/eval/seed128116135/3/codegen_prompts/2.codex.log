+        (1, w - 4),
+        (h - 4, 1),
+        (h - 4, w - 4),
+        ((h - 3) // 2, (w - 3) // 2),
+        (1, (w - 3) // 2),
+        (h - 4, (w - 3) // 2),
+        ((h - 3) // 2, 1),
+        ((h - 3) // 2, w - 4),
