+            mask = patch != bg
+            window[mask] = patch[mask]
+            placed_boxes.append(box)
+            break
+        else:
+            return None
+    return grid
+
+
+def _make_example() -> np.ndarray | None:
+    bg_choices = [color for color in COLOR_VALUES if color != GREY]
+    bg = random.choice(bg_choices)
+    spec_info = _build_specs(bg)
