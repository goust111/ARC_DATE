+                continue
+            if _hole_capacity(h, w) < hole_count:
+                continue
+            options.append((h, w))
+    return random.choice(options) if options else None
+
+
+def _render_shape(
+    color: int,
+    bg: int,
+    h: int,
+    w: int,
+    payloads: list[tuple[str, int | None]],
