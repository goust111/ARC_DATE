+    grid = _place_patches(patches, bg)
+    if grid is None:
+        return None
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    if np.array_equal(out, grid):
+        return None
+    other_counts = [int(np.sum(grid == color)) for color in np.unique(grid) if int(color) != bg]
+    if other_counts and int(np.sum(grid == bg)) <= max(other_counts):
+        return None
+    return grid
+
