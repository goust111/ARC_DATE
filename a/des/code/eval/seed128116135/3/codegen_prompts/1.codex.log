+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+FRAME = 8
+CONTENT = 2
+MIRROR = 3
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+GEN_RETRIES = 400
+PLACE_RETRIES = 160
+FRAME_MARGIN = 1
+RESERVE_PAD = 1
