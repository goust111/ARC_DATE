+def _patch_fits(base: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int) -> bool:
+    h, w = patch.shape
+    if r0 < 0 or c0 < 0 or r0 + h > base.shape[0] or c0 + w > base.shape[1]:
+        return False
+    coords = np.argwhere(patch != int(bg))
+    for rr, cc in coords:
+        if int(base[r0 + rr, c0 + cc]) != int(bg):
+            return False
+    return True
