+    h, w = grid.shape
+    dr, dc = ARROW_SPECS[arrow["direction"]]["forward"]
+    r, c = arrow["tip"][0] + dr, arrow["tip"][1] + dc
+    gap = 0
+    while _in_bounds(h, w, r, c):
+        value = int(grid[r, c])
+        if value == bg:
+            gap += 1
+            r += dr
+            c += dc
