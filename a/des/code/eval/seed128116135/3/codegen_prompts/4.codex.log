+    h, w = grid.shape
+    for _ in range(PAIR_PLACEMENT_TRIES):
+        tail_len = rng.randint(TAIL_LEN_MIN, TAIL_LEN_MAX)
+        gap = rng.randint(GAP_MIN, GAP_MAX)
