+        rooms: list[tuple[int, int, int, int]] = []
+        r0 = 1
+        for room_h in heights:
+            c0 = 1
+            for room_w in widths:
+                rooms.append((r0, c0, r0 + room_h - 1, c0 + room_w - 1))
+                c0 += room_w + 1
+            r0 += room_h + 1
+        return grid, rooms
+    raise RuntimeError("failed to build room partition")
+
