+        cycle = set(_clockwise_cycle(r0, c0, r1, c1))
+        by_color: dict[int, list[tuple[int, int]]] = defaultdict(list)
+        for r in range(r0, r1 + 1):
+            for c in range(c0, c1 + 1):
+                color = int(grid[r, c])
+                if color != bg:
+                    by_color[color].append((r, c))
+        pair_count = 0
+        for color, pts in by_color.items():
