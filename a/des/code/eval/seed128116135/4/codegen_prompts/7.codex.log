+    r_lo, r_hi, c_lo, c_hi = bounds
+    dr, dc = direction
+    steps = 0
+    while True:
+        nr = int(cross[0] + (steps + 1) * sign * dr)
+        nc = int(cross[1] + (steps + 1) * sign * dc)
+        if not (r_lo <= nr <= r_hi and c_lo <= nc <= c_hi):
+            return steps
+        steps += 1
+
+
