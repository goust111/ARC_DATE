+from __future__ import annotations
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+LINE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+GENERATION_ATTEMPTS = 500
+PAIR_PLACEMENT_ATTEMPTS = 300
+EXTRA_LINE_ATTEMPTS = 200
+DIRECTIONS = ((0, 1), (1, 0), (1, 1), (1, -1))
+SIDES = ("left", "right", "top", "bottom")
+
