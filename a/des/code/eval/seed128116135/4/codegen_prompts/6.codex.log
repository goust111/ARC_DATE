+def _current_side_color(grid: np.ndarray, layer: dict) -> int:
+    colors = []
+    for r, c in _side_coords(layer, layer["gap_side"]):
+        if (r, c) == layer["gap"]:
+            continue
+        val = int(grid[r, c])
+        if val != BG:
+            colors.append(val)
