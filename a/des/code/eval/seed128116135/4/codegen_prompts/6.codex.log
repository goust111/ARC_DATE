+    def collect(points: list[tuple[int, int]]) -> list[int]:
+        colors = []
+        for r, c in points:
+            if (r, c) == layer["gap"]:
+                continue
+            val = int(grid[r, c])
+            if val != BG:
+                colors.append(val)
+        return colors
+
+    colors = collect(core_coords)
+    if not colors:
+        colors = collect(coords)
+    assert colors, "gap side must keep at least one colored pixel"
+    color, _ = Counter(colors).most_common(1)[0]
+    return int(color)
