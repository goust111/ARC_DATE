+    all_comps = _components(g != bg)
+    piece_comps = [comp for comp in all_comps if set(comp) != legend_set]
+    assert len(piece_comps) == 4, "expected four puzzle pieces"
+    pieces = [_analyze_piece(g, comp) for comp in piece_comps]
