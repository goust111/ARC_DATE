+    grid_h = int(max(18, expected.shape[0] + 8) + rng.integers(0, 5))
+    grid_w = int(max(18, expected.shape[1] + 8) + rng.integers(0, 5))
+    canvas = np.full((grid_h, grid_w), BG, dtype=int)
