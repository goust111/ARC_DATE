+        "mask": mask,
+        "cells": [(int(r), int(c)) for r, c in zip(*np.where(mask))],
+        "base_h": int(base_h),
+        "base_w": int(base_w),
+        "base_r0": int(base_vert_shift),
+        "base_c0": int(base_horiz_shift),
+        "tab_side": tab_side,
+        "tab_offset": int(tab_offset),
+        "notch_side": notch_side,
+        "notch_offset": int(notch_offset),
