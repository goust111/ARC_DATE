+import numpy as np
+
+
+BG = 8  # azure
+OPPOSITE = {"left": "right", "right": "left", "top": "bottom", "bottom": "top"}
+COLOR_POOL = [c for c in range(10) if c != BG]
+RETRY_LIMIT = 300
