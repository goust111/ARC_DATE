101: def main(grid: np.ndarray) -> np.ndarray:
102:     """
103:     Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.
104: 
105:     Input structure:
106:     - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.
107:     - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.
108: 
109:     Rule:
110:     - For each enclosed region, identify its border color C and look up the legend with fill color C.
111:     - The direction from the legend's center dot to its indicator dot gives the slide direction.
112:     - All yellow pixels in that region slide in that direction, stacking against the far wall.
113: 
114:     Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.
115:     """
116:     g = np.asarray(grid, dtype=int)
117:     h, w = g.shape
118:     bg = get_bg(g)
119: 
120:     mover = 4  # yellow in ARC
121:     dirs = _legend_directions(g, bg)
122:     assert dirs, "legend_directions must find at least one legend; grid should always have border legends"
123: 
124:     passable = (g == bg) | (g == mover)
125:     out = g.copy()
126: 
127:     # Find enclosed passable regions (not connected to the outer border).
128:     for pts in components_mask(passable, connectivity=4):
129:         if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):
130:             continue  # outside background
131: 
132:         movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]
133:         if not movers:
134:             continue
135: 
136:         # Determine this region's border color by counting adjacent wall colors.
137:         border_counts: dict[int, int] = {}
138:         pset = {(int(r), int(c)) for r, c in pts}
139:         for r, c in pts:
140:             for nr, nc in neighbors4(r, c):
141:                 if not (0 <= nr < h and 0 <= nc < w):
142:                     continue
143:                 if (nr, nc) in pset:
144:                     continue
145:                 v = int(g[nr, nc])
146:                 if v == bg or v == mover:
147:                     continue
148:                 border_counts[v] = border_counts.get(v, 0) + 1
149:         if not border_counts:
150:             continue
151:         border_col = max(border_counts, key=border_counts.get)
152:         if border_col not in dirs:
153:             continue
154:         dr, dc = dirs[border_col]
155: 
156:         # Clear old movers.
157:         for r, c in movers:
158:             out[r, c] = bg
159: 
160:         # Slide and repaint.
161:         new_pts = _slide_points(pset, movers, dr, dc)
162:         for r, c in new_pts:
163:             out[r, c] = mover
164: 
165:     return out
166: 
