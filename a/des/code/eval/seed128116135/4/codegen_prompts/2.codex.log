+            notch_row = mask.shape[0] - 1
+        else:
+            raise AssertionError("expected a top/bottom notch")
+        misses = [
+            cc
+            for cc in range(base_w)
+            if not mask[notch_row, base_horiz_shift + cc]
+        ]
+        assert len(misses) == 1
+        notch_offset = int(misses[0])
