+
+
+def _build_piece(h: int, w: int, color: int, tab_side: str, tab_offset: int, notch_side: str, notch_offset: int) -> dict:
+    top_extra = 1 if tab_side == "top" else 0
+    bottom_extra = 1 if tab_side == "bottom" else 0
