26:     """
27:     Push the central solid rectangle to the grid edge, splitting the perpendicular target rectangle around its path.
28: 
29:     Input structure
30:     - The background is the dominant color.
31:     - There are exactly three monochrome foreground objects arranged on one
32:       horizontal or vertical axis.
33:     - The middle object on that axis is a solid rectangular moving object.
34:     - One end object is a solid rectangle or bar whose long side is perpendicular
35:       to the movement axis; this is the target to split.
36: 
37:     Rule
38:     - Move the middle rectangle along the axis toward the target until it is
39:       flush with the grid edge in that direction.
40:     - Clear the original middle rectangle and the original target.
41:     - Split the target through the moving rectangle's two-cell-wide path and
42:       shift the two halves one cell outward perpendicular to the movement.
43:     - Keep the other end object unchanged.
44: 
45:     Key insight
46:     - The non-target end object acts as a pusher; the central rectangle travels
47:       away from it through the perpendicular target, opening a matching gap.
48:     """
49:     g = np.asarray(grid, dtype=int)
50:     bg = get_bg(g)
51:     H, W = g.shape
52: 
53:     objects = find_components(g, bg=bg, connectivity=4, monochromatic=True)
54:     assert len(objects) == 3, "expected exactly three foreground objects"
55: 
56:     row_centers = [_center(obj, 0) for obj in objects]
57:     col_centers = [_center(obj, 1) for obj in objects]
58:     row_spread = max(row_centers) - min(row_centers)
59:     col_spread = max(col_centers) - min(col_centers)
60:     assert min(row_spread, col_spread) <= 0.5, "objects must share a row or column axis"
61:     axis = 0 if col_spread <= 0.5 else 1
62:     perp = 1 - axis
63: 
64:     ordered = sorted(objects, key=lambda obj: _center(obj, axis))
65:     axis_centers = [_center(obj, axis) for obj in ordered]
66:     assert axis_centers[0] < axis_centers[1] < axis_centers[2], "expected a unique middle object"
67: 
68:     source = ordered[1]
69:     end_objects = [ordered[0], ordered[2]]
70:     assert _is_solid_rectangle(g, source), "moving object must be a solid rectangle"
71: 
72:     target_candidates = [
73:         obj
74:         for obj in end_objects
75:         if _is_solid_rectangle(g, obj) and _span(obj, perp) > _span(obj, axis)
76:     ]
77:     assert len(target_candidates) == 1, "expected one perpendicular solid target"
78:     target = target_candidates[0]
79: 
80:     direction = -1 if _center(target, axis) < _center(source, axis) else 1
81: 
82:     sr0, sc0, sr1, sc1 = source["bbox"]
83:     tr0, tc0, tr1, tc1 = target["bbox"]
84:     source_lo = [sr0, sc0]
85:     source_hi = [sr1, sc1]
86:     target_lo = [tr0, tc0]
87:     target_hi = [tr1, tc1]
88: 
89:     source_perp_len = source_hi[perp] - source_lo[perp] + 1
90:     assert source_perp_len == 2, "moving object path must be two cells wide"
91:     assert target_lo[perp] <= source_lo[perp] <= source_hi[perp] <= target_hi[perp]
92:     assert (
93:         source_lo[perp] - target_lo[perp] == target_hi[perp] - source_hi[perp]
94:     ), "moving object must be centered across the target"
95: 
96:     out = g.copy()
97:     for r, c in source["coords"]:
98:         out[int(r), int(c)] = bg
99:     for r, c in target["coords"]:
100:         out[int(r), int(c)] = bg
101: 
102:     shift = source_perp_len // 2
103:     for r, c in target["coords"]:
104:         new_rc = [int(r), int(c)]
105:         if new_rc[perp] <= source_lo[perp]:
106:             new_rc[perp] -= shift
107:         else:
108:             assert new_rc[perp] >= source_hi[perp]
109:             new_rc[perp] += shift
110:         assert 0 <= new_rc[0] < H and 0 <= new_rc[1] < W, "shifted target must stay in bounds"
111:         out[new_rc[0], new_rc[1]] = int(target["color"])
112: 
113:     source_patch = crop_bbox(g, source["bbox"])
114:     if axis == 0:
115:         new_r = 0 if direction < 0 else H - source_patch.shape[0]
116:         new_c = source_lo[1]
117:     else:
118:         new_r = source_lo[0]
119:         new_c = 0 if direction < 0 else W - source_patch.shape[1]
120:     dest = out[new_r : new_r + source_patch.shape[0], new_c : new_c + source_patch.shape[1]]
121:     assert np.all(dest == bg), "moving object destination must be clear"
122:     paste(out, source_patch, new_r, new_c)
123:     return out
