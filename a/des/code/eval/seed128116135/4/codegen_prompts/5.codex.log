+    adj: dict[tuple[int, int], list[tuple[tuple[int, int], int]]] = {node: [] for node in degrees}
+    for idx, edge in enumerate(edges):
+        u = edge["u"]
+        v = edge["v"]
+        adj[u].append((v, idx))
+        adj[v].append((u, idx))
+
+    leaves = [node for node, nbrs in adj.items() if len(nbrs) == 1 and node != root]
