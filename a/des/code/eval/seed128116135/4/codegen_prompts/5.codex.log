+        start = random.choice(candidates)
+        if start == root and degrees[root] == 0:
+            directions = [_inward_dir(root, h, w)]
+        else:
+            directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]
+            random.shuffle(directions)
