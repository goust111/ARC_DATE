+        ((0, w - 1), (0, w - 2)),
+        ((h - 1, 0), (h - 2, 0)),
+        ((h - 1, 0), (h - 1, 1)),
+        ((h - 1, w - 1), (h - 2, w - 1)),
+        ((h - 1, w - 1), (h - 1, w - 2)),
+    ]
