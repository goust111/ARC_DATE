+
+    for edge in model["edges"]:
+        axis = edge["axis"]
+        if switch_spec["broken"].get(axis, False):
+            mr, mc = _segment_mid(edge["u"], edge["v"])
+            grid[mr, mc] = BLACK
+
+    sr, sc = model["source"]
+    grid[sr, sc] = RED
+
