+                cells = _segment_cells(start, end)
+                occupied.update(cells[1:])
+                edges.append({"u": start, "v": end, "axis": _edge_axis(start, end)})
+                nodes.append(end)
+                degrees[start] += 1
+                degrees[end] = 1
+                placed = True
+                break
