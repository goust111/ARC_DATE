+        if switch_spec is None:
+            continue
+
+        grid = _render_input(model, switch_spec)
+        expected = _expected_output(model, switch_spec, grid)
+
+        green_count = int(np.count_nonzero(expected == GREEN))
+        yellow_count = int(np.count_nonzero(expected == YELLOW))
+        if green_count == 0 or yellow_count == 0:
+            continue
+
+        if not np.array_equal(main(grid), expected):
+            continue
+        return grid
+
+    return None
