+    red_pixels = np.argwhere(grid == RED)
+    assert len(red_pixels) == 1
+    start = tuple(int(v) for v in red_pixels[0])
+    conductive = {RED, GREY}
+    conductive.update(s["color"] for s in _find_switches(grid))
