+        for nxt, edge_idx in model["adj"][node]:
+            edge = model["edges"][edge_idx]
+            axis = edge["axis"]
+            passable = True
+            if axis in switch_spec["broken"]:
+                passable = bool(switch_spec["broken"][axis])
+            if not passable:
+                continue
+            if nxt in seen:
+                continue
+            seen.add(nxt)
+            q.append(nxt)
+    return {leaf for leaf in model["leaves"] if leaf in seen}
