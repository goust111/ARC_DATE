+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(GRID_MIN, GRID_MAX)
+    w = random.randint(GRID_MIN, GRID_MAX)
+    model = _grow_tree(h, w)
+    if model is None:
+        return None
+
+    for _ in range(40):
