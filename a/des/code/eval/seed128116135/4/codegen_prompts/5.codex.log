+
+
+def _source_options(h: int, w: int):
+    return [
+        ((0, 0), (1, 0)),
+        ((0, 0), (0, 1)),
+        ((0, w - 1), (1, w - 1)),
+        ((0, w - 1), (0, w - 2)),
+        ((h - 1, 0), (h - 2, 0)),
+        ((h - 1, 0), (h - 1, 1)),
+        ((h - 1, w - 1), (h - 2, w - 1)),
+        ((h - 1, w - 1), (h - 1, w - 2)),
+    ]
+
+
+def _inward_dir(root: tuple[int, int], h: int, w: int) -> tuple[int, int]:
+    r, c = root
+    if c == 0:
+        return (0, 1)
+    if c == w - 1:
+        return (0, -1)
+    if r == 0:
+        return (1, 0)
+    return (-1, 0)
+
+
+def _can_add_segment(
+    start: tuple[int, int],
+    end: tuple[int, int],
+    occupied: set[tuple[int, int]],
+    h: int,
+    w: int,
+) -> bool:
+    cells = _segment_cells(start, end)
