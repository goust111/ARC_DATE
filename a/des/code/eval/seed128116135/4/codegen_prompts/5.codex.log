+        if axis not in switch_spec["broken"]:
+            continue
+        mr, mc = _segment_mid(edge["u"], edge["v"])
+        if switch_spec["broken"][axis]:
+            out[mr, mc] = switch_spec["colors"][axis]
+        else:
+            out[mr, mc] = BLACK
