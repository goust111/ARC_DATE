+def _find_switches(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    fixed = {BLACK, RED, GREEN, YELLOW, GREY}
+    switches = []
+    seen_colors = set()
+    edge_coords = []
+    for c in range(w):
+        edge_coords.append((0, c))
+        edge_coords.append((h - 1, c))
+    for r in range(1, h - 1):
+        edge_coords.append((r, 0))
+        edge_coords.append((r, w - 1))
