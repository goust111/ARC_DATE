+            continue
+        start = c
+        while c + 1 < w and mask[c + 1]:
+            c += 1
+        end = c
+        if end - start + 1 >= 5 and (end - start) % 2 == 0:
+            intervals.append((start, end))
+        c += 1
+    return intervals
+
+
+def _col_intervals(grid: np.ndarray, col: int) -> list[tuple[int, int]]:
