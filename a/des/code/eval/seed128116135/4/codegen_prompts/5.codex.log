+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+SWITCH_COLORS = (1, 6, 7, 8, 9)
+
+GEN_ATTEMPTS = 400
+GRID_MIN = 17
+GRID_MAX = 23
+EDGE_COUNT_RANGE = (4, 7)
