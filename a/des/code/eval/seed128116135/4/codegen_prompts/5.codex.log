+        parent = adj[leaf][0][0]
+        dr = 0 if leaf[0] == parent[0] else (1 if leaf[0] > parent[0] else -1)
+        dc = 0 if leaf[1] == parent[1] else (1 if leaf[1] > parent[1] else -1)
+        candidate_dirs = [(dr, dc), (dc, dr), (-dc, -dr), (-dr, -dc)]
+        bulb = None
+        for br, bc in candidate_dirs:
