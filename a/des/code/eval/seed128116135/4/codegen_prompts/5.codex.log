+    if any(cell in occupied for cell in cells[1:]):
+        return False
+
+    for idx, cell in enumerate(cells[1:], start=1):
+        prev = cells[idx - 1]
+        for nr, nc in _neighbors4(*cell):
+            if (nr, nc) in occupied and (nr, nc) != prev:
+                return False
