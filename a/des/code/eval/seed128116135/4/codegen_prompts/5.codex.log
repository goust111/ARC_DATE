+        placed = False
+        for dr, dc in directions:
+            max_dist = 0
+            rr, cc = start
+            while True:
+                rr += dr
+                cc += dc
+                if not (1 <= rr <= h - 2 and 1 <= cc <= w - 2):
+                    break
+                max_dist += 1
+            dists = [d for d in range(MIN_SEGMENT_DELTA, max_dist + 1, 2)]
+            random.shuffle(dists)
