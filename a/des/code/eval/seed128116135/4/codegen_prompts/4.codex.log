+    for top in range(g.shape[0] - CLOCK_SIZE + 1):
+        for left in range(g.shape[1] - CLOCK_SIZE + 1):
+            parsed = _parse_clock(g, top, left)
+            if parsed is not None:
+                clocks.append(parsed)
+    return clocks
+
+
