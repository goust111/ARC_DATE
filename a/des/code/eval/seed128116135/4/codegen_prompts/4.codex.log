+    assert clocks, "no valid clock found"
+
+    out = np.zeros((2, 2), dtype=int)
+    for r in range(2):
+        for c in range(2):
+            out[r, c] = _mode_color([int(clock[r, c]) for clock in clocks])
+    return out
+
+
