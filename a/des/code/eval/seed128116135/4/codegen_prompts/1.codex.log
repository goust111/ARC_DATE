+    cur = min(start_neighbors, key=lambda p: (p[1], p[0]))
+    prev = seed_pos
+
+    path: list[tuple[int, int]] = []
+    seen: set[tuple[int, int]] = set()
+    terminal_comp = None
+
+    while True:
