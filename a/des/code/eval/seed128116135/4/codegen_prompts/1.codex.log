+def _pipe_color(g: np.ndarray, bg: int) -> int:
+    counts = _color_counts(g)
+    non_bg = [(cnt, col) for col, cnt in counts.items() if col != bg]
+    assert non_bg, "grid must contain non-background pixels"
+    return max(non_bg)[1]
