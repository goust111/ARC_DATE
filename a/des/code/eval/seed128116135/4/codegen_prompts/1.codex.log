+
+def _find_seed(g: np.ndarray, bg: int, pipe: int) -> tuple[int, int]:
+    h, w = g.shape
+    candidates = []
+    for r in range(h):
+        for c in range(w):
+            v = int(g[r, c])
+            if v == bg or v == pipe:
+                continue
+            if any(_in_bounds(g.shape, nr, nc) and int(g[nr, nc]) == pipe for nr, nc in _neighbors4(r, c)):
