+            rectangular = len(cells) == (r1 - r0 + 1) * (c1 - c0 + 1)
+            comps.append(
+                {
+                    "cells": cells,
+                    "touches_border": touches_border,
+                    "rectangular": rectangular,
+                    "height": r1 - r0 + 1,
+                    "width": c1 - c0 + 1,
+                }
+            )
