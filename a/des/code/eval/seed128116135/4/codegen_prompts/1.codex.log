+
+def _expected_output(inp: np.ndarray, path_cells: set[tuple[int, int]], interior: list[tuple[int, int]], seed_color: int) -> np.ndarray:
+    out = inp.copy()
+    for r, c in path_cells:
+        out[r, c] = seed_color
+    for r, c in interior:
