+            if cid < 0:
+                continue
+            comp = bg_comps[cid]
+            if (
+                not comp["touches_border"]
+                and comp["rectangular"]
+                and comp["height"] <= 3
+                and comp["width"] <= 3
+            ):
+                found_terminal = cid
+                break
