+_CHAIN_LEN_RANGE = (3, 7)
+_ISOLATED_COUNT_RANGE = (0, 3)
+_REPEAT_COLOR_COUNT = 3
+_INTERIOR_MARGIN = 1
+_PATH_BUILD_ATTEMPTS = 160
