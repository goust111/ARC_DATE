+def _fg_components(grid: np.ndarray, bg: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen: set[tuple[int, int]] = set()
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if int(grid[r, c]) == bg or (r, c) in seen:
+                continue
+            stack = [(r, c)]
+            seen.add((r, c))
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if int(grid[nr, nc]) == bg or (nr, nc) in seen:
+                        continue
+                    seen.add((nr, nc))
+                    stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _build_adj(coords: list[tuple[int, int]]) -> dict[tuple[int, int], list[tuple[int, int]]]:
+    pts = set(coords)
+    adj: dict[tuple[int, int], list[tuple[int, int]]] = {pt: [] for pt in coords}
+    for r, c in coords:
+        for nr, nc in neighbors4(r, c):
+            if (nr, nc) in pts:
+                adj[(r, c)].append((nr, nc))
+    return adj
+
+
+def _trace_path(
+    start: tuple[int, int], adj: dict[tuple[int, int], list[tuple[int, int]]]
+) -> list[tuple[int, int]]:
+    path = [start]
+    prev = None
+    cur = start
+    while True:
+        nxts = [pt for pt in adj[cur] if pt != prev]
+        if not nxts:
+            break
+        if len(nxts) != 1:
+            return []
+        prev, cur = cur, nxts[0]
+        path.append(cur)
+    return path
+
+
+def _path_start(
