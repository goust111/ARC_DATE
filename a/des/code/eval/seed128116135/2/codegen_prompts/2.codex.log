+            return None
+        long_chain_count += 1
+
+    if long_chain_count != chain_count:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid domino-chain input")

