+    if repeat_counts is None:
+        return None
+    regular_assignments = _assign_regular_groups(regular_groups, repeat_palette, repeat_counts, rng)
+    if regular_assignments is None:
+        return None
+
+    grid = np.full((h, w), bg, dtype=int)
