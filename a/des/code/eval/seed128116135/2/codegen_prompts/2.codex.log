+            for color in option:
+                counts[color] += 1
+        return False
+
+    if rec(0):
+        return assignments
+    return None
+
+
+def _paint_structure(
+    grid: np.ndarray,
+    path: list[tuple[int, int]],
+    colors: list[int],
+) -> None:
+    for (r, c), color in zip(path, colors):
+        grid[r, c] = color
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rng = _RNG
