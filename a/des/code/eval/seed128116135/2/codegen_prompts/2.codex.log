+                continue
+            stack = [(r, c)]
+            seen.add((r, c))
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if int(grid[nr, nc]) == bg or (nr, nc) in seen:
