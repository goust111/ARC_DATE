+    path = [start]
+    prev = None
+    cur = start
+    while True:
+        nxts = [pt for pt in adj[cur] if pt != prev]
+        if not nxts:
+            break
+        if len(nxts) != 1:
+            return []
+        prev, cur = cur, nxts[0]
+        path.append(cur)
+    return path
+
+
+def _path_start(
+    grid: np.ndarray,
+    adj: dict[tuple[int, int], list[tuple[int, int]]],
+    color_counts: Counter,
+) -> tuple[int, int] | None:
