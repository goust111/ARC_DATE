+_RNG = np.random.default_rng()
+
+_GEN_RETRIES = 300
+_GRID_H_RANGE = (11, 18)
+_GRID_W_RANGE = (11, 18)
+_CHAIN_COUNT_RANGE = (1, 4)
+_CHAIN_LEN_RANGE = (3, 7)
+_ISOLATED_COUNT_RANGE = (0, 3)
