+            prev_b = path[2 * (domino_idx - 1) + 1]
+            cur_a = path[2 * domino_idx]
+            cur_b = path[2 * domino_idx + 1]
+            prev_horizontal = prev_a[0] == prev_b[0]
+            if prev_horizontal:
+                out[cur_a] = int(g[cur_b])
+                out[cur_b] = int(g[cur_a])
+
+    return out
+
+
+_RNG = np.random.default_rng()
+
+_GEN_RETRIES = 300
+_GRID_H_RANGE = (11, 18)
