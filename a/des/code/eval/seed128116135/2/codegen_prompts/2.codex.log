+    for r in range(h):
+        for c in range(w):
+            if int(grid[r, c]) == bg or (r, c) in seen:
+                continue
+            stack = [(r, c)]
+            seen.add((r, c))
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
