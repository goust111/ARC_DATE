+    rng.shuffle(color_pool)
+
+    chain_count = int(rng.integers(*_CHAIN_COUNT_RANGE))
+    isolated_count = int(rng.integers(*_ISOLATED_COUNT_RANGE))
+    if chain_count + _REPEAT_COLOR_COUNT > len(color_pool):
