+            prev_b = path[2 * (domino_idx - 1) + 1]
+            cur_a = path[2 * domino_idx]
+            cur_b = path[2 * domino_idx + 1]
+            prev_horizontal = prev_a[0] == prev_b[0]
+            if prev_horizontal:
