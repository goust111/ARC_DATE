+def _cell_is_valid(
+    cell: tuple[int, int],
+    h: int,
+    w: int,
+    path_set: set[tuple[int, int]],
+    prev: tuple[int, int] | None,
+    occupied: set[tuple[int, int]],
+) -> bool:
+    r, c = cell
+    if not (_INTERIOR_MARGIN <= r < h - _INTERIOR_MARGIN and _INTERIOR_MARGIN <= c < w - _INTERIOR_MARGIN):
+        return False
+    if cell in path_set or cell in occupied:
+        return False
+    for nbr in neighbors4(r, c):
+        if nbr in occupied:
+            return False
+        if nbr in path_set and nbr != prev:
+            return False
+    return True
+
+
+def _build_induced_path(
+    h: int,
+    w: int,
+    length: int,
+    occupied: set[tuple[int, int]],
+    rng: np.random.Generator,
+) -> list[tuple[int, int]] | None:
+    starts = [
+        (r, c)
+        for r in range(_INTERIOR_MARGIN, h - _INTERIOR_MARGIN)
+        for c in range(_INTERIOR_MARGIN, w - _INTERIOR_MARGIN)
+        if (r, c) not in _global_forbidden(occupied)
+    ]
+    rng.shuffle(starts)
+
+    def dfs(
+        path: list[tuple[int, int]],
+        path_set: set[tuple[int, int]],
+    ) -> list[tuple[int, int]] | None:
+        if len(path) == length:
+            return path.copy()
+
+        r, c = path[-1]
+        candidates = neighbors4(r, c)
+        rng.shuffle(candidates)
+        for nxt in candidates:
+            if not _cell_is_valid(nxt, h, w, path_set, path[-1], occupied):
+                continue
+            path.append(nxt)
+            path_set.add(nxt)
+            found = dfs(path, path_set)
+            if found is not None:
+                return found
+            path.pop()
+            path_set.remove(nxt)
+        return None
+
+    for start in starts[: min(len(starts), 40)]:
+        path = [start]
+        found = dfs(path, {start})
+        if found is not None:
+            return found
+    return None
+
+
+def _make_repeat_counts(
+    total: int, palette: list[int], rng: np.random.Generator
+) -> dict[int, int] | None:
+    if total < 2:
+        return None
+    counts = {color: 0 for color in palette}
+    remaining = total
+    while remaining > 0:
+        if remaining in (2, 3):
+            chunk = remaining
+        else:
+            chunk = int(rng.choice([2, 3]))
+            if remaining - chunk == 1:
+                chunk = 5 - chunk
+        counts[int(rng.choice(palette))] += chunk
+        remaining -= chunk
+    return counts
+
+
+def _assign_regular_groups(
+    group_sizes: list[int],
+    palette: list[int],
+    counts: dict[int, int],
+    rng: np.random.Generator,
+) -> list[tuple[int, ...]] | None:
+    assignments: list[tuple[int, ...]] = [tuple()] * len(group_sizes)
+
+    def rec(idx: int) -> bool:
+        if idx == len(group_sizes):
+            return True
+
+        options: list[tuple[int, ...]] = []
+        if group_sizes[idx] == 1:
+            options = [(color,) for color in palette if counts[color] > 0]
+        else:
+            for a in palette:
+                if counts[a] == 0:
+                    continue
+                for b in palette:
+                    if a == b or counts[b] == 0:
+                        continue
+                    options.append((a, b))
