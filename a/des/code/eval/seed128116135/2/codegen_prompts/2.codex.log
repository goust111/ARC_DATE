+        path_set = {start}
+
+        while len(path) < length:
+            r, c = path[-1]
+            candidates: list[tuple[int, float, tuple[int, int]]] = []
+            for nxt in neighbors4(r, c):
+                if not _cell_is_valid(nxt, h, w, path_set, path[-1], occupied):
+                    continue
+                trial_set = set(path_set)
+                trial_set.add(nxt)
+                onward = 0
+                for after in neighbors4(*nxt):
