+    if not _place_outside(rng, inp, frame_bbox, outside_stamps, bg):
+        return None
+
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(400):
+        built = _make_case(rng)
+        if built is None:
