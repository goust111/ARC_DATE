+def _place_inside_canvas(
+    rng: random.Random,
+    frame_bbox: tuple[int, int, int, int],
+    side: str,
+    stamp_rot: np.ndarray,
+    occupied: set[tuple[int, int]],
+    padded: set[tuple[int, int]],
