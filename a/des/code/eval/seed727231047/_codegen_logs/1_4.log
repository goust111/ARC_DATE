+    detour = random.randint(1, 2)
+    start_r = pr + CELL
+    turn_r = start_r + detour
+    path = _merge_path(
+        _vertical_segment(start_r, turn_r, center),
+        _horizontal_segment(turn_r, center, entry_c),
+        _vertical_segment(turn_r, endpoint_r, entry_c),
+    )
