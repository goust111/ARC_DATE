+    if branch == "right90":
+        return 1 if top_row else -1
+    if branch == "left180":
+        return 1 if top_row else -1
+    return -1 if top_row else 1
+
+
+def _canonical_attempt() -> tuple[np.ndarray, np.ndarray] | None:
