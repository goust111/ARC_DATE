+            full_rows, full_cols, cell = frame
+            cand = {
+                "color": color,
+                "bbox": (r0, c0, r1, c1),
+                "rows": [r0 + rr for rr in full_rows],
+                "cols": [c0 + cc for cc in full_cols],
+                "cell": cell,
+                "count": int(coords.shape[0]),
