+            continue
+        score = 0
+        for comp in _components(grid == color, connectivity=4):
+            ok, endpoints = _is_path_component(comp)
+            if not ok:
+                continue
+            touches = sum(_adjacent_to_frame(ep, frame_mask) for ep in endpoints)
+            if touches == 1:
+                score += 1
+        if score > best_score:
+            best_score = score
+            best_color = color
