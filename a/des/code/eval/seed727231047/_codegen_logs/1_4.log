+def _rotate_pair(inp: np.ndarray, out: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    k = random.randint(0, 3)
+    return np.rot90(inp, k).copy(), np.rot90(out, k).copy()
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
