+    degrees: dict[tuple[int, int], int] = {}
+    for rc in cells:
+        deg = 0
+        for dr, dc in NEIGH4:
+            if (rc[0] + dr, rc[1] + dc) in cells:
+                deg += 1
+        if deg > 2:
+            return False, []
+        degrees[rc] = deg
+    endpoints = [rc for rc, deg in degrees.items() if deg == 1]
+    return len(endpoints) == 2, endpoints
