+BRANCHES = ("straight", "left90", "right90", "left180", "right180")
+DIR_INDEX = {(-1, 0): 0, (0, 1): 1, (1, 0): 2, (0, -1): 3}
+NEIGH4 = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+NEIGH8 = [
+    (-1, -1),
+    (-1, 0),
+    (-1, 1),
+    (0, -1),
+    (0, 1),
