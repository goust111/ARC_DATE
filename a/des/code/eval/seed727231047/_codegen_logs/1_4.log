+        for j in range(len(cols) - 1):
+            if cols[j] < ec < cols[j + 1]:
+                return row, j
+    if er == r1 + 1:
+        row = len(rows) - 2
+        for j in range(len(cols) - 1):
+            if cols[j] < ec < cols[j + 1]:
+                return row, j
+    if ec == c0 - 1:
