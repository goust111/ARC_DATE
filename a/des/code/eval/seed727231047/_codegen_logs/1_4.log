+        for coords in _components(grid == color, connectivity=4):
+            r0, c0, r1, c1 = _bbox(coords)
+            submask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            submask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+            frame = _frame_candidate(submask)
+            if frame is None:
