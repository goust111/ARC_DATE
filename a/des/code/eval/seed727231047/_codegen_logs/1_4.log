+    grid[r0 : r0 + h, c0 + w - 1] = FRAME
+    grid[r0, c0 : c0 + w] = FRAME
+    grid[r0 + h - 1, c0 : c0 + w] = FRAME
+    for i in range(1, rows):
+        rr = r0 + i * (CELL + 1)
+        grid[rr, c0 : c0 + w] = FRAME
