+
+def _frame_output(rows: int, cols: int) -> np.ndarray:
+    h = rows * CELL + rows + 1
+    w = cols * CELL + cols + 1
+    out = np.full((h, w), BG, dtype=int)
+    _draw_frame(out, 0, 0, rows, cols)
