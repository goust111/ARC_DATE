+
+
+def _cw_turns(path: list[tuple[int, int]]) -> int:
+    dirs = [
+        (path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1])
+        for i in range(len(path) - 1)
+    ]
+    cw = 0
+    for d0, d1 in zip(dirs, dirs[1:]):
+        if d0 == d1:
+            continue
+        i0 = DIR_INDEX[d0]
+        i1 = DIR_INDEX[d1]
+        if i1 == (i0 - 1) % 4:
+            cw += 1
+        elif i1 == (i0 + 1) % 4:
+            cw -= 1
+        else:
