+
+def _adjacent_pattern_ids(
+    rc: tuple[int, int], pattern_ids: np.ndarray
+) -> set[int]:
+    h, w = pattern_ids.shape
+    ids: set[int] = set()
+    for dr, dc in NEIGH4:
+        nr, nc = rc[0] + dr, rc[1] + dc
+        if 0 <= nr < h and 0 <= nc < w and pattern_ids[nr, nc] >= 0:
+            ids.add(int(pattern_ids[nr, nc]))
