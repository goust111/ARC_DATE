+        v_end = (random.randint(v_end_min, h - 5), src[1])
+        if not _reserve_node(v_end, h, w, reserved_boxes, forbidden_box):
+            return None
+        nodes.append((v_end, False))
+
+        v_rows = _junction_rows(src[0], v_end[0], v_junction_count)
+        if v_rows is None:
