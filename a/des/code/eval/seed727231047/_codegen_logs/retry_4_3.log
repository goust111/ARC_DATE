+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+MAROON = 9
+
+PATH_COLORS = (BLUE, RED, GREEN, YELLOW)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+OUTER_RING = np.array(
+    [
+        [1, 1, 1],
+        [1, 0, 1],
+        [1, 1, 1],
+    ],
+    dtype=bool,
+)
