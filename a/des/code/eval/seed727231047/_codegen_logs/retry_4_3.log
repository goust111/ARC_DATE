+
+    use_vertical = random.random() < 0.6
+
+    lanes: list[dict] = []
+    nodes: list[tuple[tuple[int, int], bool]] = [(src, True)]
+
+    # Horizontal lane is always present.
+    h_junction_count = random.randint(1, 3 if w >= 26 else 2)
+    h_end_min = src[1] + 8 + 4 * (h_junction_count - 1)
+    if h_end_min > w - 5:
