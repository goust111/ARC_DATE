+
+
+def _draw_child_path(
+    grid: np.ndarray,
+    node_mask: np.ndarray,
+    parent: tuple[int, int],
+    child: tuple[int, int],
+    color: int,
+) -> bool:
+    pr, pc = parent
+    cr, cc = child
+
+    if pr == cr:
+        start = _attach(parent, "E" if cc > pc else "W")
+        end = _attach(child, "W" if cc > pc else "E")
