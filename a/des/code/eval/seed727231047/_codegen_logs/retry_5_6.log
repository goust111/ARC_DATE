+    row_runs = [run for run in _runs(full_rows) if run[1] - run[0] > 6]
+    assert row_runs, "failed to locate the pattern rows"
+    r0, r1_excl = max(row_runs, key=lambda rc: rc[1] - rc[0])
+    return int(r0), int(c0), int(r1_excl), int(c1_excl)
