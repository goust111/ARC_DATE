+def _random_runs(length: int, min_seg: int = 1, max_seg: int = 4) -> list[int]:
+    segments: list[int] = []
+    used = 0
+    while used < length:
+        remaining = length - used
+        seg = random.randint(min_seg, min(max_seg, remaining))
+        segments.append(seg)
+        used += seg
+    if sum(segments) > length:
+        segments[-1] -= sum(segments) - length
+    return segments
