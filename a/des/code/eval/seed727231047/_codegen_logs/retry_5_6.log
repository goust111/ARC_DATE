+MIN_GRID_SIDE = 14
+MAX_GRID_SIDE = 28
+MIN_PATTERN_HEIGHT = 7
+MAX_PATTERN_HEIGHT = 15
+MIN_PATTERN_WIDTH = 8
+MAX_PATTERN_WIDTH = 18
+MIN_MARGIN = 1
+MAX_MARGIN = 5
+MIN_STRIPES = 2
