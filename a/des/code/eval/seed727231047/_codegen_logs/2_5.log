+        defect_count = int(_RNG.integers(1, defect_cap + 1))
+        chosen = _RNG.choice(empty_indices, size=defect_count, replace=False)
+
+        defects: list[tuple[int, int]] = []
+        for idx in np.atleast_1d(chosen):
+            pair = pairs[int(idx)]
+            cell = pair[int(_RNG.integers(0, 2))]
+            mask[cell] = True
