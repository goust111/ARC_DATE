+    grid[bottom, left : right + 1] = int(color)
+    grid[top + 1 : bottom, left + 1 : right][inner_mask] = int(color)
+
+
+def _expected_output(grid: np.ndarray, specs: list[dict[str, object]], recycle_start: int) -> np.ndarray:
+    out = grid.copy()
+    for spec in specs:
