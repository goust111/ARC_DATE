+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+
+    for r0 in range(h):
+        for c0 in range(w):
+            color = int(g[r0, c0])
+            if color == bg or bool(seen[r0, c0]):
+                continue
+
+            stack = [(int(r0), int(c0))]
+            seen[r0, c0] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                coords.append((int(r), int(c)))
+                for dr, dc in _DIRS:
+                    nr = int(r + dr)
+                    nc = int(c + dc)
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if bool(seen[nr, nc]) or int(g[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+
+            rows = [r for r, _ in coords]
+            cols = [c for _, c in coords]
+            r1 = min(rows)
+            r2 = max(rows)
+            c1 = min(cols)
+            c2 = max(cols)
+            components.append(
+                {
+                    "color": color,
+                    "coords": np.array(coords, dtype=int),
+                    "bbox": (int(r1), int(c1), int(r2), int(c2)),
+                    "area": int(len(coords)),
+                }
+            )
+
+    return components
+
+
+def _is_solid_rect(component: dict) -> bool:
+    r0, c0, r1, c1 = component["bbox"]
+    return int(component["area"]) == int((r1 - r0 + 1) * (c1 - c0 + 1))
+
+
+def _point_in_box(r: int, c: int, box: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = box
+    return bool(r0 <= r <= r1 and c0 <= c <= c1)
