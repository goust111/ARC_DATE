+def _parse_arrow(component: dict) -> tuple[tuple[int, int], tuple[int, int], tuple[int, int]]:
+    pts = {tuple(map(int, rc)) for rc in component["coords"]}
+    candidates: list[tuple[int, int, int, int]] = []
+
+    for r, c in pts:
+        for dr, dc in _DIRS:
+            br = int(r - dr)
+            bc = int(c - dc)
+            pr1 = int(-dc)
+            pc1 = int(dr)
+            pr2 = int(dc)
+            pc2 = int(-dr)
+            required = {
+                (br, bc),
+                (br + pr1, bc + pc1),
+                (br + pr2, bc + pc2),
