+        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == int(block["color"]))
+        assert np.all(block_at[r0 : r1 + 1, c0 : c1 + 1] == -1)
+        block_at[r0 : r1 + 1, c0 : c1 + 1] = int(idx)
