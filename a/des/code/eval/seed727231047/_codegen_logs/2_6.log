+            target_col_offset = random.randint(0, bw - 1)
+            tc0 = int(line_c - target_col_offset)
+            if dr == 1:
+                tr0 = int(source_box[2] + gap)
+            else:
+                tr0 = int(source_box[0] - gap - bh + 1)
+            target_box = (int(tr0), int(tc0), int(tr0 + bh - 1), int(tc0 + bw - 1))
