+    candidates: list[tuple[int, int, int, int]] = []
+
+    for r, c in pts:
+        for dr, dc in _DIRS:
+            br = int(r - dr)
+            bc = int(c - dc)
+            pr1 = int(-dc)
+            pc1 = int(dr)
+            pr2 = int(dc)
+            pc2 = int(-dr)
