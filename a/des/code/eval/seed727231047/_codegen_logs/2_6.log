+    base_c = int(tip_c - dc)
+    allowed = {(int(tip_r), int(tip_c))}
+    cur_r, cur_c = int(tail_r), int(tail_c)
+    while True:
+        allowed.add((int(cur_r), int(cur_c)))
+        if (cur_r, cur_c) == (base_r, base_c):
+            break
+        cur_r += dr
+        cur_c += dc
