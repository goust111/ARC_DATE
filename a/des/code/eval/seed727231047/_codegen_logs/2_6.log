+_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+_MAX_GENERATION_ATTEMPTS = 400
+_CHAIN_COUNT_RANGE = (1, 3)
+_CHAIN_LENGTH_RANGE = (1, 4)
+_GRID_SIDE_RANGE = (18, 26)
+_BLOCK_HEIGHT_RANGE = (2, 4)
+_BLOCK_WIDTH_RANGE = (2, 4)
+_GAP_RANGE = (3, 6)
+_EXTEND_RETRIES = 120
+_INITIAL_BLOCK_RETRIES = 120
