+        cc = c + dc * k
+        assert int(grid[rr, cc]) == BLACK
+        grid[rr, cc] = end_color if k == length else GREY
+        endpoint = (rr, cc)
+    return endpoint
+
+
+def _to_actual(node: tuple[int, int], top_pad: int, left_pad: int) -> tuple[int, int]:
+    return top_pad + node[0] * STEP, left_pad + node[1] * STEP
