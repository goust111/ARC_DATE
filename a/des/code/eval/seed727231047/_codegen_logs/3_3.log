+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    lattice_rows = rng.randint(MIN_LATTICE, MAX_LATTICE)
+    lattice_cols = rng.randint(MIN_LATTICE, MAX_LATTICE)
