+                incoming_dir = outgoing_dir
+            assert len(nodes) == intersections
+            return nodes, start_incoming, turns
+    return None
+
+
+def _paint_line(grid: np.ndarray, start: tuple[int, int], end: tuple[int, int], color: int) -> None:
+    r0, c0 = start
+    r1, c1 = end
+    if r0 == r1:
