+            assert len(neighbor_dirs) == 4, "switch cells must be full cross intersections"
+            intersections += 1
+            travel_dir = _rot_cw(travel_dir) if color == RED else _rot_ccw(travel_dir)
+            assert travel_dir in neighbor_dirs
