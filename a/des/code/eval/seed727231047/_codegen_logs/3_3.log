+def _pipe_neighbor_dirs(grid: np.ndarray, r: int, c: int) -> list[int]:
+    result: list[int] = []
+    for dir_idx, (dr, dc) in enumerate(DIRS):
+        rr = r + dr
+        cc = c + dc
+        if _in_bounds(grid.shape, rr, cc) and _is_pipe(int(grid[rr, cc])):
+            result.append(dir_idx)
+    return result
