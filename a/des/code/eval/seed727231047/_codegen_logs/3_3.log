import random
DIRS=[(-1,0),(0,1),(1,0),(0,-1)]
LEFT='L'; RIGHT='R'

def turn_dir(d, t):
    return (d + (1 if t==RIGHT else -1)) % 4

def entry_cells(rows, cols, incoming):
    if incoming==1:
        return [(r,0) for r in range(rows)]
    if incoming==3:
        return [(r,cols-1) for r in range(rows)]
    if incoming==2:
        return [(0,c) for c in range(cols)]
    return [(rows-1,c) for c in range(cols)]

def can_exit(node, outgoing, rows, cols):
    r,c=node
    if outgoing==1:
        return c==cols-1
    if outgoing==3:
        return c==0
    if outgoing==2:
        return r==rows-1
    return r==0

def build(rows, cols, n, rng):
    def dfs(cur, incoming, idx):
        if idx == n-1:
            opts=[t for t in [LEFT,RIGHT] if can_exit(cur, turn_dir(incoming,t), rows, cols)]
            rng.shuffle(opts)
            if not opts:
                return None
            return [opts[0]]
        opts=[LEFT,RIGHT]
        rng.shuffle(opts)
        for t in opts:
            out=turn_dir(incoming,t)
            dr,dc=DIRS[out]
            nxt=(cur[0]+dr, cur[1]+dc)
            if not (0 <= nxt[0] < rows and 0 <= nxt[1] < cols):
                continue
