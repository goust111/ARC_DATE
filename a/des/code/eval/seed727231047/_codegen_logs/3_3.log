+
+        end_len = rng.choice(START_END_CHOICES)
+        last_r, last_c = _to_actual(nodes[-1], top_pad, left_pad)
+        _paint_stub(grid, (last_r, last_c), outgoing_dirs[-1], end_len, GREY)
+
+        for idx, node in enumerate(nodes):
