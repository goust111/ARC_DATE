+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+PIPE_COLORS = {GREY, RED, BLUE, GREEN}
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+LEFT = "L"
+RIGHT = "R"
+
+
