+        incoming_dir: int,
+        node_idx: int,
+    ) -> list[str] | None:
+        if node_idx == intersections - 1:
+            turn_options = [LEFT, RIGHT]
+            rng.shuffle(turn_options)
+            for turn in turn_options:
+                outgoing_dir = _apply_turn(incoming_dir, turn)
+                if _can_exit(current, outgoing_dir, rows, cols):
+                    return [turn]
+            return None
+
+        turn_options = [LEFT, RIGHT]
+        rng.shuffle(turn_options)
