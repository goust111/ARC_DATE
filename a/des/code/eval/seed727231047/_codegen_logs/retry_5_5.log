+        mid_gaps = [rng.randint(1, 4) for _ in range(4)]
+        mid_box = _expand_box(inner_spec["outer"], mid_gaps[0], mid_gaps[1], mid_gaps[2], mid_gaps[3])
+        mid_spec = _make_spec(colors[1], fills[1], level_ts[1], mid_box)
