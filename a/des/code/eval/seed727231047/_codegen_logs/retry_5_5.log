+    out = g.copy()
+    out[:-1] = main_area
+    return out
+
+
+def _shift_specs_into_grid(rng: random.Random, specs: list[dict], height: int, width: int) -> list[dict] | None:
+    min_r = min(int(spec["outer"][0]) for spec in specs)
+    min_c = min(int(spec["outer"][1]) for spec in specs)
