+        outer_gaps = [rng.randint(1, 4) for _ in range(4)]
+        outer_box = _expand_box(mid_spec["outer"], outer_gaps[0], outer_gaps[1], outer_gaps[2], outer_gaps[3])
+        outer_spec = _make_spec(colors[0], fills[0], level_ts[0], outer_box)
