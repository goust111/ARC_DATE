+    piece_coords = np.argwhere(piece_mask).astype(int)
+    all_rows = [int(v) for v in piece_coords[:, 0]] + [marker[0]]
+    all_cols = [int(v) for v in piece_coords[:, 1]] + [marker[1]]
+    r0 = min(all_rows)
+    c0 = min(all_cols)
+    r1 = max(all_rows)
+    c1 = max(all_cols)
