+        range(len(specs)),
+        key=lambda idx: components[idx]["height"] * components[idx]["width"],
+        reverse=True,
+    )
+
+    for idx in order:
+        comp = components[idx]
+        ch = comp["height"]
+        cw = comp["width"]
+        if h - ch <= 1 or w - cw <= 1:
+            return False
+        positions = [(r, c) for r in range(1, h - ch) for c in range(1, w - cw)]
+        random.shuffle(positions)
+        placed = False
+        for top, left in positions:
+            rs = top - 1
+            re = top + ch + 1
+            cs = left - 1
+            ce = left + cw + 1
+            if np.any(reserved[rs:re, cs:ce]):
