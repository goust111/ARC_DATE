+def _extract_fragments(grid: np.ndarray) -> list[dict]:
+    fragments: list[dict] = []
+    mask = (grid != BG) & (grid != AZURE)
+    for comp in _components(mask):
+        colors = {int(grid[r, c]) for r, c in comp}
+        if colors == {RED}:
+            continue
