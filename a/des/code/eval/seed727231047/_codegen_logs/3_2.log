+def _marker_side(marker: tuple[int, int], coords_set: set[tuple[int, int]]) -> str:
+    r, c = marker
+    hits: list[str] = []
+    if (r + 1, c) in coords_set:
+        hits.append("top")
+    if (r, c - 1) in coords_set:
+        hits.append("right")
+    if (r - 1, c) in coords_set:
+        hits.append("bottom")
+    if (r, c + 1) in coords_set:
+        hits.append("left")
