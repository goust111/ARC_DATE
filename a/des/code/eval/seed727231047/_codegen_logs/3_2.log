+    h, w = sub.shape
+    slots: list[dict] = []
+    for comp in _components(sub == BG):
+        touches_edge = np.any(
+            (comp[:, 0] == 0)
+            | (comp[:, 0] == h - 1)
+            | (comp[:, 1] == 0)
+            | (comp[:, 1] == w - 1)
