+                cells_b = [(rr, c_b + 1) for rr in range(r_b + 2, r_a + 1)]
+                if len(cells_a) < 3 or len(cells_b) < 3:
+                    continue
+                if any(filled[cell] for cell in cells_a) or any(filled[cell] for cell in cells_b):
