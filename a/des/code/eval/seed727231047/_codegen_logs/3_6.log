+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+LIGHTHOUSE_SIZE = 2
+GEN_RETRIES = 600
+
+RAY_SPECS = (
+    ("up", (-1, 0), (-1, 0)),
+    ("right", (0, 2), (0, 1)),
+    ("down", (2, 1), (1, 0)),
