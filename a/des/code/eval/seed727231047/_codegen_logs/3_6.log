+        _probe_corner_legend(g, 0, 1, 0),
+        _probe_corner_legend(g, 0, 1, w - 2),
+        _probe_corner_legend(g, h - 1, -1, 0),
+        _probe_corner_legend(g, h - 1, -1, w - 2),
