+    legend_mask, mapping, priority = _find_legend(g)
+    lighthouses = _find_lighthouses(g, legend_mask, set(mapping))
+    rays = _ray_lines(g, legend_mask, lighthouses)
+    claims = _claim_details(g, rays, mapping)
