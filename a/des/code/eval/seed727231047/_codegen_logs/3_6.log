+    if overlap_meta is not None:
+        ray_a = ray_by_key[(tuple(overlap_meta[0]["bbox"]), str(overlap_meta[0]["dir"]))]
+        ray_b = ray_by_key[(tuple(overlap_meta[1]["bbox"]), str(overlap_meta[1]["dir"]))]
