+
+def _room_gap_direction(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int) -> str | None:
+    if grid[r0, c0] != WALL or grid[r0, c1] != WALL or grid[r1, c0] != WALL or grid[r1, c1] != WALL:
+        return None
+    if np.any(grid[r0 + 1 : r1, c0 + 1 : c1] == WALL):
+        return None
