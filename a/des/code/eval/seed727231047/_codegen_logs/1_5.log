+
+
+def _room_wall_cells(room: dict[str, object]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = room["bbox"]
+    gap = room["gap"]
+    cells: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        cells.append((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        cells.append((r, c1))
+    uniq = []
+    seen = set()
