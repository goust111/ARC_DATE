+    gr, gc = gap
+    if gr == r0 and c0 < gc < c1:
+        side = "top"
+    elif gc == c1 and r0 < gr < r1:
+        side = "right"
+    elif gr == r1 and c0 < gc < c1:
+        side = "bottom"
+    elif gc == c0 and r0 < gr < r1:
+        side = "left"
+    else:
