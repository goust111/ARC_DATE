+    grid[r0 : r1 + 1, c1] = color
+    grid[gap] = 0
+
+
+def _build_relative_boxes(depth: int) -> list[tuple[int, int, int, int]]:
+    inner_h = random.randint(3, 6)
+    inner_w = random.randint(3, 7)
+    boxes = [(0, 0, inner_h - 1, inner_w - 1)]
+    cur = boxes[0]
+    for _ in range(depth - 1):
