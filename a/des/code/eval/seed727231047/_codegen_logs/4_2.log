   269	def _grow_shape(height: int, width: int, area: int) -> np.ndarray | None:
   270	    mask = np.zeros((height, width), dtype=bool)
   271	    start = (random.randrange(height), random.randrange(width))
   272	    mask[start] = True
   273	    frontier = set()
   274	
   275	    def add_frontier(r: int, c: int) -> None:
   276	        for dr, dc in DIRS4:
   277	            nr, nc = r + dr, c + dc
   278	            if 0 <= nr < height and 0 <= nc < width and not mask[nr, nc]:
   279	                frontier.add((int(nr), int(nc)))
   280	
   281	    add_frontier(*start)
   282	    while int(mask.sum()) < area:
   283	        if not frontier:
   284	            return None
   285	        cell = random.choice(tuple(frontier))
   286	        frontier.remove(cell)
   287	        rr, cc = cell
   288	        mask[rr, cc] = True
   289	        add_frontier(rr, cc)
   290	
   291	    tight = _tight_mask(mask)
   292	    if tight.shape[0] > GEN_SHAPE_BBOX[1] or tight.shape[1] > GEN_SHAPE_BBOX[1]:
   293	        return None
   294	    if tight.shape[0] < GEN_SHAPE_BBOX[0] and tight.shape[1] < GEN_SHAPE_BBOX[0]:
   295	        return None
   296	    return tight
