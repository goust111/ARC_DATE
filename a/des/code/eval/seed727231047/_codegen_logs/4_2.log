   562	            b = shuffled_indices[2 * pair_cursor + 1]
   563	            pair_cursor += 1
   564	            pair_map[assigned_global] = assigned_global + 1
   565	            pair_map[assigned_global + 1] = assigned_global
   566	            paired_slots.append((assigned_global, assigned_global + 1))
   567	            local.extend([a, b])
   568	            assigned_global += 2
   569	        else:
