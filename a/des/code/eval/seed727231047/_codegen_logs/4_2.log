   466	def _blocked_with_padding(blocked: np.ndarray, coords: np.ndarray) -> None:
   467	    h, w = blocked.shape
   468	    for r, c in coords:
   469	        for dr in (-1, 0, 1):
   470	            for dc in (-1, 0, 1):
   471	                nr, nc = int(r + dr), int(c + dc)
   472	                if 0 <= nr < h and 0 <= nc < w:
   473	                    blocked[nr, nc] = True
