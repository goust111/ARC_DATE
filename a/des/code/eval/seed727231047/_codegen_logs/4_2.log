+def _grow_shape(height: int, width: int, area: int) -> np.ndarray | None:
+    mask = np.zeros((height, width), dtype=bool)
+    start = (random.randrange(height), random.randrange(width))
+    mask[start] = True
+    frontier = set()
+
+    def add_frontier(r: int, c: int) -> None:
+        for dr, dc in DIRS4:
