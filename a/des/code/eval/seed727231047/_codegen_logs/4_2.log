   552	
   553	    slot_order: list[int] = []
   554	    paired_slots: list[tuple[int, int]] = []
   555	    assigned_global = 0
   556	    group_slot_indices: list[list[int]] = []
   557	    pair_cursor = 0
   558	    for group in groups:
   559	        local = []
   560	        if len(group) == 2:
