   527	    random.shuffle(shuffled_indices)
   528	    pair_map: dict[int, int] = {}
   529	    groups: list[list[np.ndarray]] = []
   530	    used: set[int] = set()
   531	
   532	    for pair_idx in range(pair_count):
   533	        a = shuffled_indices[2 * pair_idx]
   534	        b = shuffled_indices[2 * pair_idx + 1]
   535	        group = _build_pair_group(hole_masks[a], hole_masks[b])
   536	        if group is None:
   537	            return None
   538	        groups.append(group)
   539	        used.add(a)
   540	        used.add(b)
   541	
   542	    for idx in range(slot_count):
   543	        if idx in used:
   544	            continue
   545	        groups.append([_coords_from_mask(hole_masks[idx])])
   546	
   547	    template_h = random.randint(*GEN_TEMPLATE_SIDE)
   548	    template_w = random.randint(*GEN_TEMPLATE_SIDE)
   549	    slot_groups = _place_groups(template_h, template_w, groups)
   550	    if slot_groups is None:
