   442	def _compose_template(
   443	    template_h: int,
   444	    template_w: int,
   445	    slot_groups: list[list[np.ndarray]],
   446	    slot_colors: list[int],
   447	    template_color: int,
   448	    pair_map: dict[int, int],
   449	) -> tuple[np.ndarray, np.ndarray]:
   450	    template = np.full((template_h, template_w), int(template_color), dtype=int)
   451	    expected = template.copy()
   452	    slot_index = 0
   453	    for group in slot_groups:
   454	        for coords in group:
   455	            template[coords[:, 0], coords[:, 1]] = BG
   456	            slot_index += 1
   457	    slot_index = 0
   458	    for group in slot_groups:
   459	        for coords in group:
   460	            out_color = slot_colors[pair_map.get(slot_index, slot_index)]
   461	            expected[coords[:, 0], coords[:, 1]] = int(out_color)
   462	            slot_index += 1
   463	    return template, expected
