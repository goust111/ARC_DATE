+    if not _place_piece_patches(grid, (top, left, top + template_h - 1, left + template_w - 1), piece_patches):
+        return None
+
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid, expected
+
+
+def generate_input() -> np.ndarray:
