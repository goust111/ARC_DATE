+                "mask": mask,
+                "bbox": bbox,
+                "key": _rotation_key(mask),
+            }
+        )
+    slots.sort(key=lambda slot: (-int(slot["mask"].sum()), int(slot["bbox"][0]), int(slot["bbox"][1])))
+    for idx, slot in enumerate(slots):
+        slot["id"] = int(idx)
+    return slots
