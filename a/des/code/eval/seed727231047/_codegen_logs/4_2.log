   327	def _normalize_coord_groups(groups: list[np.ndarray]) -> tuple[list[np.ndarray], tuple[int, int]]:
   328	    all_coords = np.concatenate(groups, axis=0)
   329	    min_r = int(all_coords[:, 0].min())
   330	    min_c = int(all_coords[:, 1].min())
   331	    shifted = [coords - np.array([min_r, min_c], dtype=int) for coords in groups]
   332	    all_shifted = np.concatenate(shifted, axis=0)
   333	    height = int(all_shifted[:, 0].max()) + 1
   334	    width = int(all_shifted[:, 1].max()) + 1
   335	    return shifted, (height, width)
