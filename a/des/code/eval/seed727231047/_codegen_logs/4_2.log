   389	def _place_groups(
   390	    template_h: int, template_w: int, groups: list[list[np.ndarray]]
   391	) -> list[list[np.ndarray]] | None:
   392	    forbidden = np.zeros((template_h, template_w), dtype=bool)
   393	    placed: list[list[np.ndarray]] = []
   394	    random_order = list(range(len(groups)))
   395	    random.shuffle(random_order)
   396	    temp: dict[int, list[np.ndarray]] = {}
   397	    for group_idx in random_order:
   398	        group = groups[group_idx]
   399	        local_groups, shape = _normalize_coord_groups(group)
   400	        gh, gw = shape
   401	        candidates = [
   402	            (top, left)
   403	            for top in range(1, template_h - gh)
   404	            for left in range(1, template_w - gw)
   405	        ]
   406	        random.shuffle(candidates)
   407	        found = None
   408	        for top, left in candidates:
   409	            ok = True
   410	            for coords in local_groups:
   411	                shifted = coords + np.array([top, left], dtype=int)
   412	                for r, c in shifted:
   413	                    if forbidden[int(r), int(c)]:
   414	                        ok = False
   415	                        break
   416	                if not ok:
   417	                    break
   418	            if ok:
   419	                found = (top, left)
   420	                break
   421	        if found is None:
   422	            return None
   423	        top, left = found
   424	        shifted_group = []
   425	        for coords in local_groups:
   426	            shifted = coords + np.array([top, left], dtype=int)
   427	            shifted_group.append(shifted)
   428	        for coords in shifted_group:
   429	            _mark_forbidden(forbidden, coords)
   430	        temp[group_idx] = shifted_group
   431	    for group_idx in range(len(groups)):
   432	        placed.append(temp[group_idx])
   433	    return placed
