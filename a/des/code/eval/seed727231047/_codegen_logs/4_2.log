+        random.shuffle(candidates)
+        found = None
+        for top, left in candidates:
+            ok = True
+            for coords in local_groups:
+                shifted = coords + np.array([top, left], dtype=int)
+                for r, c in shifted:
+                    if forbidden[int(r), int(c)]:
+                        ok = False
+                        break
+                if not ok:
