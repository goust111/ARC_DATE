   233	    template_color, (r0, c0, r1, c1) = _find_template(g, bg)
   234	    template_crop = g[r0 : r1 + 1, c0 : c1 + 1].copy()
   235	
   236	    slots = _extract_slots(template_crop, bg)
   237	    pieces = _extract_pieces(g, bg, template_color)
   238	    assignment = _match_slots(slots, pieces)
   239	    piece_by_id = {int(piece["id"]): piece for piece in pieces}
   240	
   241	    owner = np.full(template_crop.shape, -1, dtype=int)
   242	    original_colors: list[int] = [0] * len(slots)
   243	    out = template_crop.copy()
   244	    for slot in slots:
   245	        sid = int(slot["id"])
   246	        pid = assignment[sid]
   247	        color = int(piece_by_id[pid]["color"])
   248	        original_colors[sid] = color
   249	        coords = slot["coords"]
   250	        out[coords[:, 0], coords[:, 1]] = color
   251	        owner[coords[:, 0], coords[:, 1]] = sid
   252	
   253	    neighbors = _slot_neighbors(template_crop, owner)
   254	    final_colors = original_colors[:]
   255	    for sid, adjacent in enumerate(neighbors):
   256	        if not adjacent:
   257	            continue
   258	        incoming = [original_colors[other] for other in adjacent]
   259	        if all(color == incoming[0] for color in incoming):
   260	            final_colors[sid] = incoming[0]
   261	
   262	    for slot in slots:
   263	        sid = int(slot["id"])
   264	        coords = slot["coords"]
   265	        out[coords[:, 0], coords[:, 1]] = int(final_colors[sid])
   266	    return out
