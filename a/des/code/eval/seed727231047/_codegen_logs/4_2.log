   338	def _build_pair_group(mask_a: np.ndarray, mask_b: np.ndarray) -> list[np.ndarray] | None:
   339	    coords_a = _coords_from_mask(mask_a)
   340	    coords_b = _coords_from_mask(mask_b)
   341	    ha, wa = mask_a.shape
   342	    hb, wb = mask_b.shape
   343	    candidates: list[tuple[int, int, int, int, np.ndarray, np.ndarray]] = []
   344	    for dr in range(-hb - 1, ha + 2):
   345	        for dc in range(-wb - 1, wa + 2):
   346	            shifted_b = coords_b + np.array([dr, dc], dtype=int)
   347	            set_a = {tuple(map(int, xy)) for xy in coords_a}
   348	            set_b = {tuple(map(int, xy)) for xy in shifted_b}
   349	            if set_a & set_b:
   350	                continue
   351	            direct_touch = False
   352	            near_wall = False
   353	            for ar, ac in set_a:
   354	                for br, bc in set_b:
   355	                    dist = abs(ar - br) + abs(ac - bc)
   356	                    if dist == 1:
   357	                        direct_touch = True
   358	                        break
   359	                    if (ar == br and abs(ac - bc) == 2) or (ac == bc and abs(ar - br) == 2):
   360	                        near_wall = True
   361	                if direct_touch:
   362	                    break
   363	            if direct_touch or not near_wall:
   364	                continue
   365	            norm_groups, shape = _normalize_coord_groups([coords_a, shifted_b])
   366	            height, width = shape
   367	            area = height * width
   368	            candidates.append((area, height, width, len(candidates), norm_groups[0], norm_groups[1]))
   369	    if not candidates:
   370	        return None
   371	    best_area = min(candidate[0] for candidate in candidates)
   372	    best = [candidate for candidate in candidates if candidate[0] == best_area]
   373	    _area, _height, _width, _idx, group_a, group_b = random.choice(best)
   374	    return [group_a, group_b]
