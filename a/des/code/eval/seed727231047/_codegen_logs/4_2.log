+    order = sorted((int(slot["id"]) for slot in slots), key=lambda sid: len(slot_candidates[sid]))
+    assignment: dict[int, int] = {}
+    used: set[int] = set()
+
+    def backtrack(i: int) -> bool:
+        if i == len(order):
+            return True
+        sid = order[i]
+        for pid in slot_candidates[sid]:
+            if pid in used:
+                continue
+            used.add(pid)
+            assignment[sid] = pid
+            if backtrack(i + 1):
+                return True
+            used.remove(pid)
+            del assignment[sid]
+        return False
