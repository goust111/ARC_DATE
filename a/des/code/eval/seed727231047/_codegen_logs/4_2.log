   377	def _mark_forbidden(forbidden: np.ndarray, coords: np.ndarray) -> None:
   378	    h, w = forbidden.shape
   379	    for r, c in coords:
   380	        for dr in range(-2, 3):
   381	            for dc in range(-2, 3):
   382	                if abs(dr) + abs(dc) > 2:
   383	                    continue
   384	                nr, nc = int(r + dr), int(c + dc)
   385	                if 0 <= nr < h and 0 <= nc < w:
   386	                    forbidden[nr, nc] = True
