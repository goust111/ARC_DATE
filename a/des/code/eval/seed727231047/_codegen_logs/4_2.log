   476	def _place_piece_patches(
   477	    grid: np.ndarray,
   478	    template_bbox: tuple[int, int, int, int],
   479	    piece_patches: list[np.ndarray],
   480	) -> bool:
   481	    h, w = grid.shape
   482	    blocked = np.zeros((h, w), dtype=bool)
   483	    tr0, tc0, tr1, tc1 = template_bbox
   484	    for r in range(max(0, tr0 - 1), min(h, tr1 + 2)):
   485	        for c in range(max(0, tc0 - 1), min(w, tc1 + 2)):
   486	            blocked[r, c] = True
   487	
   488	    order = list(range(len(piece_patches)))
   489	    random.shuffle(order)
   490	    for piece_idx in order:
   491	        patch = piece_patches[piece_idx]
   492	        coords = np.argwhere(patch != BG)
   493	        ph, pw = patch.shape
   494	        candidates = [
   495	            (top, left)
   496	            for top in range(h - ph + 1)
   497	            for left in range(w - pw + 1)
   498	        ]
   499	        random.shuffle(candidates)
   500	        placed = False
   501	        for top, left in candidates:
   502	            shifted = coords + np.array([top, left], dtype=int)
   503	            if any(blocked[int(r), int(c)] for r, c in shifted):
   504	                continue
   505	            grid[top : top + ph, left : left + pw][patch != BG] = patch[patch != BG]
   506	            _blocked_with_padding(blocked, shifted)
   507	            placed = True
   508	            break
   509	        if not placed:
   510	            return False
   511	    return True
