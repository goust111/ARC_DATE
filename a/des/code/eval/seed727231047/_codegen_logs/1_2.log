+def _render_rectangles(rectangles: list[tuple[int, int, int]]) -> np.ndarray:
+    out_h = sum(h for _color, h, _w in rectangles) + max(0, len(rectangles) - 1)
+    out_w = max(w for _color, _h, w in rectangles)
