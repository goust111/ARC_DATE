+            target = rng.randint(max(1, (height * width) // 4), max(1, (3 * height * width) // 4))
+            start = (rng.randrange(height), rng.randrange(width))
+            mask[start] = True
+            filled = [start]
+            while int(mask.sum()) < target:
+                base_r, base_c = rng.choice(filled)
