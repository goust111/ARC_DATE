+def _find_frames(grid: np.ndarray, bg: int) -> tuple[list[dict], dict[int, list[int]]]:
+    frames: list[dict] = []
+    next_id = 0
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != bg):
+        for comp in _components4(grid == color):
+            bbox = _frame_bbox(comp)
+            if bbox is None:
+                continue
