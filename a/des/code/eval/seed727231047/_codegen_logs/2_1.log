+    cursor = margin
+    for size in col_widths:
+        col_starts.append(cursor)
+        cursor += size + gap
+    width = cursor - gap + margin
+
+    frames = []
+    for slot_r, slot_c in used_slots:
+        cell_r0 = row_starts[slot_r]
+        cell_c0 = col_starts[slot_c]
+        cell_h = row_heights[slot_r]
+        cell_w = col_widths[slot_c]
