+            children[frame["parent"]].append(frame["id"])
+    return frames, children
+
+
+def _contains(outer: dict, inner: dict) -> bool:
+    return (
+        outer["r0"] < inner["r0"]
+        and inner["r1"] < outer["r1"]
+        and outer["c0"] < inner["c0"]
+        and inner["c1"] < outer["c1"]
+    )
+
