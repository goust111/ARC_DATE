+                col = int(max_col + gap())
+            else:
+                col = int(prev_pos[1] + prev["tab_offset"][1] - pieces[idx]["notch_offset"][1])
+                if col < 0:
+                    return None
+                row = int(max_row + gap())
+            positions.append((row, col))
+            max_row = max(max_row, int(row + pieces[idx]["h"]))
+            max_col = max(max_col, int(col + pieces[idx]["w"]))
