+    current = 0
+    expected = 1
+    while remaining:
+        matches = [idx for idx in remaining if _is_match(pieces[current], pieces[idx])]
+        if matches != [expected]:
+            return False
+        remaining.remove(expected)
+        current = expected
+        expected += 1
