+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+DIRS = ("N", "S", "W", "E")
+OPPOSITE = {"N": "S", "S": "N", "W": "E", "E": "W"}
+STEP = {"N": (-1, 0), "S": (1, 0), "W": (0, -1), "E": (0, 1)}
+
+MARKER_COLOR = 9
+PIECE_COUNT_RANGE = (3, 5)
+BASE_SIZE_OPTIONS = (3, 5)
+INPUT_GAP_RANGE = (2, 4)
+INPUT_MARGIN_RANGE = (2, 4)
+EXTRA_PAD_RANGE = (1, 4)
+GRID_MAX = 30
+GEN_ATTEMPTS = 400
