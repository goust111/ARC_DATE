+        pc = int(placements[idx][1] - min_c)
+        for r, c in piece["cells"]:
+            rr = int(pr + r)
+            cc = int(pc + c)
+            assert not occupied[rr, cc], "assembled chain must not overlap"
+            occupied[rr, cc] = True
+            out[rr, cc] = int(piece["color"])
