+
+        grid = _render_input(pieces, positions, bg)
+        if grid is None:
+            continue
+
+        expected = _expected_output(pieces, bg)
+        try:
+            actual = main(grid)
+        except Exception:
+            continue
+        if np.array_equal(actual, expected):
+            return grid
+
+    raise RuntimeError(f"failed to generate valid puzzle after {GEN_ATTEMPTS} attempts")

