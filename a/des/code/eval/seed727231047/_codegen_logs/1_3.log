+                    "color": color,
+                    "tail": (mid_r, c0),
+                    "tip": (mid_r, c1),
+                    "length": int(c1 - c0),
+                    "cells": cells,
+                }
+            if extras == {(r0, c0 + 1), (r1, c0 + 1)}:
+                return {
