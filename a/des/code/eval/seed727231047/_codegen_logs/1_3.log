+                    "color": color,
+                    "tail": (r0, mid_c),
+                    "tip": (r1, mid_c),
+                    "length": int(r1 - r0),
+                    "cells": cells,
+                }
+            if extras == {(r0 + 1, c0), (r0 + 1, c1)}:
