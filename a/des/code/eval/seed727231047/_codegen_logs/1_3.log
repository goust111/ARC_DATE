+def _paste(out: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    ph, pw = patch.shape
+    assert 0 <= top <= out.shape[0] - ph
+    assert 0 <= left <= out.shape[1] - pw
+    out[top : top + ph, left : left + pw] = patch
