+            rs = [r for r, _ in coords]
+            cs = [c for _, c in coords]
+            min_r = min(rs)
+            max_r = max(rs)
+            min_c = min(cs)
+            max_c = max(cs)
+            mask = np.zeros((max_r - min_r + 1, max_c - min_c + 1), dtype=bool)
