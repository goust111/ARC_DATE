+            stack = [(int(r0), int(c0))]
+            seen[r0, c0] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                coords.append((int(r), int(c)))
+                for dr, dc in _NEIGHBORS8:
+                    nr = int(r + dr)
+                    nc = int(c + dc)
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if bool(seen[nr, nc]) or int(g[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
