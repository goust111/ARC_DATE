+            mask = cand
+    assert _is_valid_pair_mask(mask)
+    return mask
+
+
+def _extract_components(grid: np.ndarray, bg: int = _BG) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
