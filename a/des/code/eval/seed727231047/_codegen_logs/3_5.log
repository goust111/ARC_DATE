+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _tight_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
