+import numpy as np
+from collections import deque
+
+
+BG = 0
+WALL = 5
+KEY_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+SIDES = ("top", "right", "bottom", "left")
+RNG = np.random.default_rng()
+
+MAX_GENERATION_ATTEMPTS = 400
+ROOM_COUNT_RANGE = (2, 5)
+GRID_SIDE_RANGE = (24, 31)
+ROOM_SIZE_RANGE = (8, 13)
