+MAX_BLOCKS = len(BLOCK_COLORS)
+MAX_SIDE = 30
+GEN_ATTEMPTS = 400
+DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]
+
+ARROW_PATTERNS = {
+    "R": {(1, 0), (1, 1), (1, 2), (0, 2), (2, 2)},
+    "L": {(1, 0), (1, 1), (1, 2), (0, 0), (2, 0)},
+    "D": {(0, 1), (1, 1), (2, 1), (2, 0), (2, 2)},
+    "U": {(0, 1), (1, 1), (2, 1), (0, 0), (0, 2)},
