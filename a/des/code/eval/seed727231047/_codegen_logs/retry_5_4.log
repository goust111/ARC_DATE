+BG = 0
+ARROW = 5
+GAP = 3
+BLOCK_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+BLOCK_SIZE_OPTIONS = [3, 4, 5]
+COMPONENT_OPTIONS = [
+    (1, 2),
+    (2, 1),
+    (1, 3),
+    (3, 1),
+    (2, 2),
+    (1, 4),
+    (4, 1),
+    (2, 3),
+    (3, 2),
