+def _draw_frame(out: np.ndarray, bbox: tuple[int, int, int, int]) -> None:
+    r0, c0, r1, c1 = bbox
+    out[r0 : r1 + 1, c0] = GREY
+    out[r0 : r1 + 1, c1] = GREY
+    out[r0, c0 : c1 + 1] = GREY
+    out[r1, c0 : c1 + 1] = GREY
