+    stack_len = max(INNER_SIZE, count * SHAPE_SIZE)
+    outer_len = stack_len + 2
+    if marker_dir == "up":
+        return (r0, c0, r0 + outer_len - 1, c1)
+    if marker_dir == "down":
+        return (r1 - outer_len + 1, c0, r1, c1)
+    if marker_dir == "left":
+        return (r0, c0, r1, c0 + outer_len - 1)
+    if marker_dir == "right":
