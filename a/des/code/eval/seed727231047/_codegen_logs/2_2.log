+            pts.append((r, c1))
+    return pts
+
+
+def _stamp_patch(
+    out: np.ndarray,
+    patch: np.ndarray,
+    color: int,
+    top: int,
+    left: int,
+    bounds: tuple[int, int, int, int],
+) -> None:
+    ir0, ic0, ir1, ic1 = bounds
+    rows, cols = np.where(patch)
+    for pr, pc in zip(rows.tolist(), cols.tolist()):
+        rr = top + pr
+        cc = left + pc
+        if ir0 <= rr <= ir1 and ic0 <= cc <= ic1:
+            out[rr, cc] = color
+
+
+def _apply_region_tiling(
+    out: np.ndarray,
+    side: str,
+    color: int,
+    patch: np.ndarray,
+    seed_top: int,
+    seed_left: int,
+    bounds: tuple[int, int, int, int],
+) -> None:
+    ir0, ic0, ir1, ic1 = bounds
+    out[ir0 : ir1 + 1, ic0 : ic1 + 1] = BG
+    ph, pw = patch.shape
+
+    if side == "top":
+        top = seed_top
+        while top <= ir1:
+            _stamp_patch(out, patch, color, top, seed_left, bounds)
+            top += ph
+    elif side == "bottom":
+        top = seed_top
+        while top + ph - 1 >= ir0:
+            _stamp_patch(out, patch, color, top, seed_left, bounds)
+            top -= ph
+    elif side == "left":
+        left = seed_left
+        while left <= ic1:
+            _stamp_patch(out, patch, color, seed_top, left, bounds)
+            left += pw
+    else:
+        left = seed_left
+        while left + pw - 1 >= ic0:
+            _stamp_patch(out, patch, color, seed_top, left, bounds)
+            left -= pw
