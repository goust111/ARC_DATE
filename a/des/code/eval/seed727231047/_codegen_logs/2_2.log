+BG = 0
+GEN_WALL = 5
+PALETTE = tuple(c for c in range(10) if c not in (BG, GEN_WALL))
+SIDES = ("top", "bottom", "left", "right")
+
+GRID_H_RANGE = (14, 30)
+GRID_W_RANGE = (14, 30)
+MAX_REGIONS = 5
+MIN_REGION_PAD = 1
+MAX_GEN_ATTEMPTS = 300
+MAX_REGION_PLACEMENT_ATTEMPTS = 80
