+    for r in range(3):
+        for c in range(3):
+            if r == 1 and c == 1:
+                continue
+            if int(pattern[r, c]) == YELLOW:
+                dirs.append((r - 1, c - 1))
+    return tuple(dirs)
+
+
+def _directions_to_pattern(directions: tuple[tuple[int, int], ...]) -> np.ndarray:
+    pattern = np.full((3, 3), BLACK, dtype=int)
+    pattern[1, 1] = YELLOW
+    for dr, dc in directions:
