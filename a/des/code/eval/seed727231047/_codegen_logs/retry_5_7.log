+        grid[top : top + PATTERN_SIZE, left : left + PATTERN_SIZE] = pattern_map[color]
+
+    if not _validate_grid(grid, room_count, set(colors)):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
