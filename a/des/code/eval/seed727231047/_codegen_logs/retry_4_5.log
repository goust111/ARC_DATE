+
+
+def _can_place(forbidden: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> bool:
+    ph, pw = patch.shape
+    return not bool(np.any(forbidden[r0 : r0 + ph, c0 : c0 + pw]))
