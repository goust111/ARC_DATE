+        used_cols.add(int(spec["col"]))
+
+    if len({tuple(spec["rank_key"]) for spec in specs}) != len(specs):
+        return None
+
+    crossings = _crossings_for_specs(specs, h, w)
+    if not crossings:
+        return None
+    if len(crossings) > max(4, num_paths + 1):
