+def depth_by_color_from_rings(rings: list[dict]) -> dict[int, int]:
+    bboxes_by_color: dict[int, set[tuple[int, int, int, int]]] = defaultdict(set)
+    for ring in rings:
+        bboxes_by_color[int(ring["color"])].add(tuple(map(int, ring["bbox"])))
