+    for cells, seed_color, (r0, c0, _r1, _c1) in _target_regions(g, legend_mask):
+        assert seed_color in mapping
+        tile = mapping[seed_color]
+        th, tw = tile.shape
+        for r, c in cells:
+            out[r, c] = tile[(r - r0) % th, (c - c0) % tw]
