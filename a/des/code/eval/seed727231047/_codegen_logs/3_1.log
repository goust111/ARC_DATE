+        shifted, (patch_h, patch_w) = _normalize(cells)
+        ring = set()
+        for r, c in shifted:
+            for nr, nc in _neighbors4(r, c):
+                if (nr, nc) not in shifted:
+                    ring.add((nr, nc))
+
+        if any(r < 0 or c < 0 or r >= patch_h or c >= patch_w for r, c in ring):
