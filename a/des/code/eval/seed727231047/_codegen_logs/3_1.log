+
+def _make_region_shape(rng: random.Random):
+    for _ in range(120):
+        canvas_h = rng.randint(5, 7)
+        canvas_w = rng.randint(5, 7)
+        base_h = rng.randint(2, min(4, canvas_h - 2))
+        base_w = rng.randint(2, min(4, canvas_w - 2))
