+    elif side == "bottom":
+        lr0, lc0 = height - legend_h, rng.randint(0, width - legend_w)
+    elif side == "left":
+        lr0, lc0 = rng.randint(0, height - legend_h), 0
+    else:
+        lr0, lc0 = rng.randint(0, height - legend_h), width - legend_w
