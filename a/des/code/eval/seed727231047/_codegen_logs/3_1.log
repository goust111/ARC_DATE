+
+def _normalize(points):
+    r0, c0, r1, c1 = _bbox(points)
+    shifted = {(r - r0 + 1, c - c0 + 1) for r, c in points}
+    return shifted, (r1 - r0 + 3, c1 - c0 + 3)
