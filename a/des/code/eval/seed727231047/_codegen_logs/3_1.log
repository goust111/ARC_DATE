+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+SIDES = ("top", "bottom", "left", "right")
