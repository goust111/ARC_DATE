+        cells = {
+            (r, c)
+            for r in range(base_r, base_r + base_h)
+            for c in range(base_c, base_c + base_w)
+        }
+
+        sides = list(SIDES)
+        rng.shuffle(sides)
+        added_arm = False
+        for side in sides[: rng.randint(1, 2)]:
