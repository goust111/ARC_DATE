+            placed = True
+            break
+        if not placed:
+            return None
+
+    _validate_instance(grid, colors, region_count)
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
