+def _dominant_quadrant(markers: np.ndarray, shape: tuple[int, int]) -> int:
+    h, w = map(int, shape)
+    counts = [0, 0, 0, 0]
+    for r, c in markers:
+        counts[_quadrant_index(float(r), float(c), h, w)] += 1
+    best = max(counts)
+    winners = [idx for idx, count in enumerate(counts) if count == best]
