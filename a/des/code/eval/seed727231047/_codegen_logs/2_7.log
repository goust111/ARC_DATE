+    # Generator-side validation keeps the random scene aligned with main().
+    _ = main(grid)
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
