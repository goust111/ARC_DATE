+def _horizontal_mask(shape: tuple[int, int], center_r: int, length: int, stripe_len: int) -> tuple[np.ndarray, list[tuple[int, int]]]:
+    h, w = shape
+    total_w = _chain_total(length, stripe_len)
+    mask = np.zeros((h, w), dtype=bool)
