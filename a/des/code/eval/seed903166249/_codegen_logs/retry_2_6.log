+    entries = list(color_to_op.items())
+    random.shuffle(entries)
+    sample_len = len(sample_seq)
+    height = 2 + len(entries) * 3 + (len(entries) - 1)
+    width = 2 + 3 + 1 + sample_len + 1 + sample_len
+    legend = np.full((height, width), BG, dtype=int)
+    legend[0, :] = GREY
+    legend[-1, :] = GREY
+    legend[:, 0] = GREY
