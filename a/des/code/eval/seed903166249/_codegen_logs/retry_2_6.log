+
+def _apply_op(seq: list[int], op: str) -> list[int]:
+    if op == "reverse":
+        return list(reversed(seq))
+    if op == "swap_pairs":
+        out = list(seq)
+        for i in range(0, len(out) - 1, 2):
+            out[i], out[i + 1] = out[i + 1], out[i]
+        return out
+    if op == "rotate_left":
+        return list(seq[1:] + seq[:1]) if seq else []
+    raise ValueError(op)
