+    if remaining > 0 and other_bases:
+        other = random.choice(other_bases)
+        counts[other] += 1
+        remaining -= 1
+
+    while remaining > 0:
+        choices = [i for i in range(n_bases) if counts[i] < 3]
+        idx = random.choice(choices)
