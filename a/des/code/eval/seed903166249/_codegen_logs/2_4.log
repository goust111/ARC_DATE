+    pieces = _extract_pieces(g[:-1, :])
+    grouped: dict[int, list[dict[str, object]]] = defaultdict(list)
+    for piece in pieces:
+        grouped[_assign_base(piece, base_cols)].append(piece)
+
+    out = np.zeros_like(g)
+    out[-1, :] = ground
+    layouts, top_row = _stack_layout(grouped, base_cols, h - 1)
+    assert top_row >= 0
+
