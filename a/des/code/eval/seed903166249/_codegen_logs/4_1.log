+        patch = out[fr0 + 1 + top_r : fr0 + 1 + top_r + sh, fc0 + 1 + top_c : fc0 + 1 + top_c + sw]
+        mask = sprite != BG
+        patch[mask] = sprite[mask]
+
+    return out
+
