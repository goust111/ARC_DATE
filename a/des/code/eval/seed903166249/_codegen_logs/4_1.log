+def main(grid: np.ndarray) -> np.ndarray:
+    return _solve(grid)
+
+
+def _mask_is_ring(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    if h < 3 or w < 3:
+        return False
+    expected = np.zeros_like(mask)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    return np.array_equal(mask, expected)
