+import random
+
+import numpy as np
+
+
+BG = 8
+DIVIDER = 5
+ANCHOR = 9
+BORDER_COLORS = (1, 2, 3, 4, 6, 7)
+SPRITE_COLORS = tuple(c for c in range(10) if c not in {BG, DIVIDER, ANCHOR})
+GEN_RETRIES = 400
