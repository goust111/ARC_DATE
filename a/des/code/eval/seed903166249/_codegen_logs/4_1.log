+    if not sizes:
+        return []
+    order = sorted(range(len(sizes)), key=lambda i: sizes[i][0] * sizes[i][1], reverse=True)
+    placed: dict[int, tuple[int, int]] = {}
+    for idx in order:
+        h, w = sizes[idx]
+        r_start = margin
+        r_stop = area_h - h - margin
+        c_start = margin
+        c_stop = area_w - w - margin
