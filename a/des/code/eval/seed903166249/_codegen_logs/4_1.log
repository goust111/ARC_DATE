+def _sample_offset(rng: random.Random, max_offset: int) -> int:
+    if max_offset <= 0:
+        return 0
+    branch = rng.randrange(3)
+    if branch == 0:
+        return 0
+    if branch == 1:
+        return max_offset
+    if max_offset == 1:
+        return rng.randint(0, 1)
+    return rng.randint(1, max_offset - 1)
