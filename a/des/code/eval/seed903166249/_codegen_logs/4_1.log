+def _is_rect_border_component(points: list[tuple[int, int]]) -> bool:
+    r0, c0, r1, c1 = _bbox(points)
+    h, w = r1 - r0 + 1, c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in points:
+        mask[r - r0, c - c0] = True
+    expected = np.zeros_like(mask)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    return np.array_equal(mask, expected)
+
