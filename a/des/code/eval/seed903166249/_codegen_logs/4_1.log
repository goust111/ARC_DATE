+def _extract_sprite(inner: np.ndarray) -> tuple[np.ndarray, tuple[int, int]]:
+    nz = np.argwhere(inner != BG)
+    assert len(nz) > 0, "legend interior must contain a sprite"
+    r0, c0 = nz.min(axis=0)
+    r1, c1 = nz.max(axis=0)
