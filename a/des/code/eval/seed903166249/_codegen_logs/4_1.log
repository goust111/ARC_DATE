+        r_start = margin
+        r_stop = area_h - h - margin
+        c_start = margin
+        c_stop = area_w - w - margin
+        if r_stop < r_start or c_stop < c_start:
+            return None
+        candidates: list[tuple[int, int]] = []
+        for r in range(r_start, r_stop + 1):
