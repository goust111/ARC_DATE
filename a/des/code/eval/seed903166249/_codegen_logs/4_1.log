+        return False
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in points:
+        mask[r - r0, c - c0] = True
+    expected = np.zeros_like(mask)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    return np.array_equal(mask, expected)
