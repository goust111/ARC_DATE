+
+    assignments = list(chosen)
+    while len(assignments) < len(fill_cells):
+        assignments.append(chosen[rng.randrange(len(chosen))])
+    rng.shuffle(assignments)
+    for (r, c), color in zip(fill_cells, assignments):
+        sprite[r, c] = color
