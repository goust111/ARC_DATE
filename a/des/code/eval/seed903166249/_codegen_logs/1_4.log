 177: def _place_orange(edge, cr0, cc0, cr1, cc1, occupied):
 178:     """Try to place an orange rect flush against the given edge. Returns (or0,oc0,or1,oc1) or None."""
 179:     for _ in range(ORANGE_PLACE_RETRIES):
