+AZURE = 8
+GREY = 5
+GREEN = 3
+MARKER_POOL = [0, 1, 2, 4, 6, 7, 9]
+BODY_SIZE_RANGE = (22, 30)
+PAIR_COUNT_RANGE = (2, 4)
+SPAN_CHOICES = (1, 2)
+DEPTH_CHOICES = (1, 2)
