+        mask_a, mask_b = _vertical_pair(h, w, depth, span, offset)
+
+    marker_cells = _marker_choices(mask_a, mask_b)
+    if len(marker_cells) < 2:
+        return None
+    pos1, pos2 = random.sample(marker_cells, 2)
+    return {
