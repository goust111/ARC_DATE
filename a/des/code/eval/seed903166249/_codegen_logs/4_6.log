+def _mode(values: np.ndarray) -> int:
+    flat = np.asarray(values, dtype=int).reshape(-1)
+    counts = np.bincount(flat, minlength=10)
+    best = int(np.argmax(counts))
+    ordered = np.sort(counts)[::-1]
