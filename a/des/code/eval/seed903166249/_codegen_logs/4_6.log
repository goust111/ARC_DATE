+    min_legend_w = 6 * pair_count + 3
+    body_w = random.randint(max(BODY_SIZE_RANGE[0], min_legend_w), BODY_SIZE_RANGE[1])
+    rendered = _render_pair_input_output(specs, body_h, body_w)
