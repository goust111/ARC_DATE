+def _body_bg_is_unique(grid: np.ndarray) -> bool:
+    counts = np.bincount(grid.reshape(-1), minlength=10)
+    return int(counts[AZURE]) > int(np.max(counts[[c for c in range(10) if c != AZURE]]))
