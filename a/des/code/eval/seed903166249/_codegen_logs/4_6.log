+        _paint_piece(body, first_mask, ar, ac, first_marker, first_pos)
+        _paint_piece(body, second_mask, br, bc, second_marker, second_pos)
+        out[ar : ar + spec["h"], ac : ac + spec["w"]] = spec["result_color"]
+
