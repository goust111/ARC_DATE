+
+def _legend_row(width: int, entries: list[tuple[int, int, int]]) -> np.ndarray:
+    row = np.full(width, GREY, dtype=int)
+    groups = entries[:]
+    random.shuffle(groups)
+    starts: list[int] = []
+    cursor = random.randint(0, 2)
+    for idx, _entry in enumerate(groups):
+        starts.append(cursor)
