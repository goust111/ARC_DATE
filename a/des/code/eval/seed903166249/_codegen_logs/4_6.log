+    assert region.shape == (h, w)
+    assert np.all(region[mask] == AZURE), "pieces must not overlap"
+    region[mask] = GREEN
+    mr, mc = marker_pos
+    assert bool(mask[mr, mc]), "marker must lie on the fragment"
+    region[mr, mc] = marker_color
