+    for rr, cc in _padded_cells(coords, gh, gw):
+        blocked[rr, cc] = True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = int(RNG.integers(20, 31))
+    w = int(RNG.integers(20, 31))
+    hole_count = int(RNG.choice([2, 3, 4]))
