+def _place_hole(mask: np.ndarray, side: str, top: int, left: int, th: int, tw: int) -> set[tuple[int, int]]:
+    h, w = mask.shape
+    coords = [(int(r), int(c)) for r, c in np.argwhere(mask)]
+    cells: set[tuple[int, int]] = set()
+    if side == "left":
+        for r, c in coords:
+            cells.add((top + r, c))
+    elif side == "right":
+        for r, c in coords:
