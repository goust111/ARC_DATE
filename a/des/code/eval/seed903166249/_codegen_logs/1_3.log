+def _group_consecutive(indices: list[int]) -> list[tuple[int, int]]:
+    if not indices:
+        return []
+    groups: list[tuple[int, int]] = []
+    start = prev = indices[0]
+    for idx in indices[1:]:
+        if idx == prev + 1:
+            prev = idx
+            continue
+        groups.append((start, prev + 1))
+        start = prev = idx
+    groups.append((start, prev + 1))
+    return groups
