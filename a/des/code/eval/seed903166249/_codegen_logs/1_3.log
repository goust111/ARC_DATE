+
+def _complement_spans(length: int, bands: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    prev = 0
+    for start, end in bands:
+        if prev < start:
+            spans.append((prev, start))
+        prev = end
+    if prev < length:
+        spans.append((prev, length))
+    return spans
