+        col_spans = _complement_spans(w, col_bands)
+        if len(row_spans) < 2 or len(col_spans) < 2:
+            continue
+        if len({r1 - r0 for r0, r1 in row_spans}) != 1:
+            continue
+        if len({c1 - c0 for c0, c1 in col_spans}) != 1:
+            continue
