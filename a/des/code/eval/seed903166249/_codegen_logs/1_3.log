+    DIR_UP: frozenset({(0, 1), (1, 0), (1, 1), (1, 2), (2, 1), (3, 1)}),
+    DIR_DOWN: frozenset({(0, 1), (1, 1), (2, 0), (2, 1), (2, 2), (3, 1)}),
+    DIR_LEFT: frozenset({(1, 0), (0, 1), (1, 1), (2, 1), (1, 2), (1, 3)}),
