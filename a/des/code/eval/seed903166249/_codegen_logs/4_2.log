+def _background_color(grid: np.ndarray) -> int:
+    corners = [
+        int(grid[0, 0]),
+        int(grid[0, -1]),
+        int(grid[-1, 0]),
+        int(grid[-1, -1]),
+    ]
+    return int(Counter(corners).most_common(1)[0][0])
+
+
+def _components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells = []
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = cr + dr
+                    nc = cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+            comps.append({"color": color, "cells": cells})
+    return comps
+
+
+def _segment_from_cells(cells: list[tuple[int, int]]) -> dict | None:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    r0 = min(rows)
+    r1 = max(rows)
+    c0 = min(cols)
+    c1 = max(cols)
+    size = len(cells)
+    if r0 == r1 and size == c1 - c0 + 1:
+        return {
+            "orientation": "h",
+            "row": r0,
+            "c0": c0,
+            "c1": c1,
+            "length": size,
+        }
+    if c0 == c1 and size == r1 - r0 + 1:
+        return {
+            "orientation": "v",
+            "col": c0,
+            "r0": r0,
+            "r1": r1,
+            "length": size,
+        }
+    return None
+
+
+def _detect_line_color(components: list[dict]) -> int | None:
+    scores: dict[int, tuple[int, int]] = {}
+    for comp in components:
+        seg = _segment_from_cells(comp["cells"])
+        if seg is None or int(seg["length"]) < 2:
+            continue
+        color = int(comp["color"])
+        total, count = scores.get(color, (0, 0))
+        scores[color] = (total + int(seg["length"]), count + 1)
+    if not scores:
+        return None
+    return max(scores.items(), key=lambda item: (item[1][0], item[1][1], -item[0]))[0]
