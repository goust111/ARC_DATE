+
+def _pair_segments(segments: list[dict]) -> list[tuple[dict, dict]]:
+    groups: dict[tuple, list[dict]] = defaultdict(list)
+    for seg in segments:
+        if seg["orientation"] == "h":
+            key = ("h", int(seg["c0"]), int(seg["c1"]))
+        else:
+            key = ("v", int(seg["r0"]), int(seg["r1"]))
+        groups[key].append(seg)
