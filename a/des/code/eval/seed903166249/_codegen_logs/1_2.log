+def _apply_transform(mask: np.ndarray, code: int) -> np.ndarray:
+    if code == 0:
+        return mask.copy()
+    if code == 1:
+        return np.rot90(mask, 1)
+    if code == 2:
+        return np.rot90(mask, 2)
+    if code == 3:
+        return np.rot90(mask, 3)
+    if code == 4:
+        return np.flipud(mask)
+    if code == 5:
+        return np.fliplr(mask)
+    if code == 6:
+        return mask.T
+    if code == 7:
+        return np.fliplr(mask.T)
