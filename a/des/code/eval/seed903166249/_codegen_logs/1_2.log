+        common = _grow_connected(h, w, common_size, rng)
+        if common is None:
+            continue
+        a_only = _grow_attached(h, w, common, a_size, rng)
+        if a_only is None:
+            continue
+        b_only = _grow_attached(h, w, common, b_size, rng, forbidden=a_only)
+        if b_only is None:
+            continue
