+        w = rng.randint(SHAPE_SIDE_RANGE[0], SHAPE_SIDE_RANGE[1])
+        total = h * w
+
+        common_max = min(COMMON_SIZE_MAX, total - 2)
+        if common_max < 1:
+            continue
+        common_size = rng.randint(1, common_max)
+
+        a_max = min(EXTRA_SIZE_MAX, total - common_size - 1)
+        if a_max < 1:
