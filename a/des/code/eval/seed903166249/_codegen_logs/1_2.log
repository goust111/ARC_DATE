+                "color": color,
+                "mask_a": mask_a,
+                "mask_b": mask_b,
+                "panel": _merge_masks(mask_a, mask_b, color),
+            }
+        )
+
+    ordered_panels = [
+        info["panel"]
+        for color in ORDERED_PAIR_COLORS
+        for info in pair_infos
+        if int(info["color"]) == color
+    ]
+    strip = _build_strip(ordered_panels)
