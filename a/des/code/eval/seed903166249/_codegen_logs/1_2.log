+    rng.shuffle(candidates_a)
+    for top_a, left_a in candidates_a:
+        temp = blocked.copy()
+        _mark_blocked(temp, top_a, left_a, mask_a.shape)
+        candidates_b = [pos for pos in _valid_positions(mask_b, temp) if pos > (top_a, left_a)]
+        if not candidates_b:
+            continue
