+                    if g[rr, cc] == color:
+                        anchors.append((rr, cc))
+            if not (1 <= len(anchors) <= 2):
+                continue
+            frame_mask[coords[:, 0], coords[:, 1]] = True
+            for rr, cc in anchors:
+                anchor_mask[rr, cc] = True
+            frames.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "anchors": tuple(sorted(anchors)),
+                }
