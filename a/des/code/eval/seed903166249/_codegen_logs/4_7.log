+def _blocked_seed(
+    grid: np.ndarray,
+    reserved: np.ndarray,
+    offsets: tuple[tuple[int, int], ...],
+    main_left: int,
+) -> tuple[tuple[int, int], set[tuple[int, int]], set[tuple[int, int]]] | None:
+    h, w = grid.shape
+    long_offsets = [offset for offset in offsets if max(abs(offset[0]), abs(offset[1])) >= 2]
+    assert long_offsets
