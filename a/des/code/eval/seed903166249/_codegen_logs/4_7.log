+def _edge_seed(
+    grid: np.ndarray,
+    reserved: np.ndarray,
+    offsets: tuple[tuple[int, int], ...],
+    main_left: int,
+) -> tuple[tuple[int, int], set[tuple[int, int]], set[tuple[int, int]]] | None:
+    h, w = grid.shape
+    for _ in range(PLACEMENT_RETRIES):
+        r = random.randint(0, h - 1)
