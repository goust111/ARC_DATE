+
+def _in_main(r: int, c: int, h: int, w: int, main_left: int) -> bool:
+    return 0 <= r < h and main_left <= c < w
+
+
+def _rect_cells(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
