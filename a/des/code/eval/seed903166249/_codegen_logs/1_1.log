from __future__ import annotations

import random
from collections import Counter

import numpy as np


BLACK = 0
GREY = 5
SEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)

_RNG = random.Random()

FRAME_COUNT_OPTIONS = (2, 3, 4)
FRAME_H_RANGE = (5, 7)
FRAME_W_RANGE = (5, 7)
TOTAL_SEEDS_MIN = 3
TOTAL_SEEDS_MAX = 5
ROW_SHIFT_RANGE = (0, 3)
EDGE_SLACK_RANGE = (1, 3)
GENERATION_RETRIES = 400


def _randint(lo: int, hi: int) -> int:
    return _RNG.randint(int(lo), int(hi))


def _components(mask: np.ndarray) -> list[np.ndarray]:
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    comps: list[np.ndarray] = []
    for r in range(h):
        for c in range(w):
            if not bool(mask[r, c]) or bool(seen[r, c]):
                continue
            stack = [(r, c)]
            seen[r, c] = True
            pts: list[tuple[int, int]] = []
            while stack:
                rr, cc = stack.pop()
                pts.append((rr, cc))
                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            comps.append(np.array(pts, dtype=int))
    return comps


def _border_mask(height: int, width: int) -> np.ndarray:
    mask = np.zeros((int(height), int(width)), dtype=bool)
    mask[0, :] = True
    mask[-1, :] = True
    mask[:, 0] = True
    mask[:, -1] = True
    return mask


def _paint_border(out: np.ndarray, r0: int, c0: int, r1: int, c1: int, color: int) -> None:
    h, w = out.shape
    if r1 < 0 or c1 < 0 or r0 >= h or c0 >= w:
        return

    top = max(int(r0), 0)
    left = max(int(c0), 0)
    bottom = min(int(r1), int(h - 1))
    right = min(int(c1), int(w - 1))
    if top > bottom or left > right:
        return

    if 0 <= r0 < h:
        out[int(r0), left : right + 1] = int(color)
    if r1 != r0 and 0 <= r1 < h:
        out[int(r1), left : right + 1] = int(color)
    if 0 <= c0 < w:
        out[top : bottom + 1, int(c0)] = int(color)
    if c1 != c0 and 0 <= c1 < w:
        out[top : bottom + 1, int(c1)] = int(color)


def _extract_frames(grid: np.ndarray) -> list[dict]:
    grey_comps = _components(grid == GREY)
    frames: list[dict] = []
    for comp in grey_comps:
