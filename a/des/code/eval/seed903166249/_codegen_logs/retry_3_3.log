+import itertools
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+CYAN = 8
+BROWN = 9
+
+UP = (-1, 0)
+RIGHT = (0, 1)
+DOWN = (1, 0)
+LEFT = (0, -1)
+DIRS = (UP, RIGHT, DOWN, LEFT)
+
+TURN_COLORS = (RED, BLUE, GREEN, YELLOW)
+BULB_COLORS = (GREEN, YELLOW, MAGENTA, CYAN, BROWN)
+
+_GEN_ATTEMPTS = 300
+_GEN_COUNTER = 0
+
+
+def _turn(direction: tuple[int, int], color: int) -> tuple[int, int]:
+    idx = DIRS.index(direction)
+    if color == RED:
+        return DIRS[(idx + 1) % 4]
+    if color == BLUE:
+        return DIRS[(idx - 1) % 4]
+    if color == GREEN:
+        return direction
+    if color == YELLOW:
