+        rr, cc = r + dr, c + dc
+        if not _in_bounds((h, w), rr, cc):
+            continue
+        color = int(g[rr, cc])
+        if color in (BLACK, GREY, ORANGE):
+            continue
+        found = None
+        for r0 in (rr - 1, rr):
+            for c0 in (cc - 1, cc):
+                if not _in_bounds((h - 1, w - 1), r0, c0):
+                    continue
+                block = g[r0 : r0 + 2, c0 : c0 + 2]
+                if np.all(block == color):
+                    found = (r0, c0)
+        if found is not None:
+            return found
+    return None
+
+
+def _trace_signal(grid: np.ndarray) -> tuple[np.ndarray, tuple[int, ...], tuple[int, int], tuple[int, int]]:
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    start = _find_start(g)
+    junctions = _junction_mask(g)
+    traversable = (g == GREY) | junctions
+    neighbors: list[tuple[int, int, tuple[int, int]]] = []
+    for dr, dc in DIRS:
+        rr, cc = start[0] + dr, start[1] + dc
+        if _in_bounds(g.shape, rr, cc) and bool(traversable[rr, cc]):
+            neighbors.append((rr, cc, (dr, dc)))
+    assert len(neighbors) == 1, "start must touch exactly one path endpoint"
+
+    visited_turns: list[int] = []
+    seen: set[tuple[int, int, tuple[int, int]]] = set()
+    out[start] = ORANGE
+    cur_r, cur_c, direction = neighbors[0]
+
+    while True:
+        state = (cur_r, cur_c, direction)
+        assert state not in seen, "signal path must not cycle"
+        seen.add(state)
+        out[cur_r, cur_c] = ORANGE
+
+        if bool(junctions[cur_r, cur_c]):
+            color = int(g[cur_r, cur_c])
+            visited_turns.append(color)
+            direction = _turn(direction, color)
+
+        nr, nc = cur_r + direction[0], cur_c + direction[1]
+        if not _in_bounds(g.shape, nr, nc) or not bool(traversable[nr, nc]):
+            bulb = _adjacent_bulb_block(g, cur_r, cur_c)
+            assert bulb is not None, "path endpoint must touch a 2x2 bulb"
+            br, bc = bulb
+            out[br : br + 2, bc : bc + 2] = ORANGE
+            return out, tuple(visited_turns), (cur_r, cur_c), bulb
+
+        cur_r, cur_c = nr, nc
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    return _trace_signal(np.asarray(grid, dtype=int))[0]
+
+
+_NODE_NAMES = ("A", "B", "C", "D")
+_NODE_GRAPH = {
+    "A": {UP: "A_N", RIGHT: "B", DOWN: "C", LEFT: "A_W"},
+    "B": {UP: "B_N", RIGHT: "B_E", DOWN: "D", LEFT: "A"},
+    "C": {UP: "A", RIGHT: "D", DOWN: "C_S", LEFT: "C_W"},
+    "D": {UP: "B", RIGHT: "D_E", DOWN: "D_S", LEFT: "C"},
+}
+_BULB_ENDPOINTS = ("A_W", "B_N", "B_E", "C_W", "C_S", "D_E", "D_S")
+_GEN_BULB_COLORS = (BLUE, RED, GREEN, YELLOW, MAGENTA, CYAN, BROWN)
+
+
+def _simulate_square(instructions: tuple[int, int, int, int]) -> dict[str, object] | None:
+    colors = dict(zip(_NODE_NAMES, map(int, instructions)))
+    node = "A"
+    incoming = DOWN
+    seen: set[tuple[str, tuple[int, int]]] = set()
+    visited: list[int] = []
+
+    while True:
+        state = (node, incoming)
+        if state in seen:
+            return None
+        seen.add(state)
+        color = colors[node]
+        visited.append(color)
+        outgoing = _turn(incoming, color)
+        target = _NODE_GRAPH[node][outgoing]
+
+        if target == "A_N":
+            return None
+        if target not in colors:
+            return {"visited": tuple(visited), "end": target}
+
+        node = target
+        incoming = outgoing
+
+
+def _build_square_grid(instructions: tuple[int, int, int, int], bulb_colors: tuple[int, ...]) -> np.ndarray:
+    start_len = random.randint(4, 6)
+    north_b_len = random.randint(2, min(4, start_len - 1))
+    west_a_len = random.randint(2, 4)
+    west_c_len = random.randint(2, 4)
+    east_b_len = random.randint(2, 4)
+    east_d_len = random.randint(2, 4)
+    south_c_len = random.randint(2, 4)
+    south_d_len = random.randint(2, 4)
+    row_gap = random.randint(5, 7)
+    col_gap = random.randint(5, 7)
+
+    top_row = start_len + 1
+    left_col = max(west_a_len, west_c_len) + 2
+    bottom_row = top_row + row_gap
+    right_col = left_col + col_gap
+
+    height = max(bottom_row + south_c_len + 3, bottom_row + south_d_len + 3)
+    width = max(right_col + east_b_len + 3, right_col + east_d_len + 3)
+    grid = np.full((height, width), BLACK, dtype=int)
+
+    grid[top_row, left_col : right_col + 1] = GREY
+    grid[bottom_row, left_col : right_col + 1] = GREY
+    grid[top_row : bottom_row + 1, left_col] = GREY
+    grid[top_row : bottom_row + 1, right_col] = GREY
+
+    grid[0, left_col] = ORANGE
+    grid[1:top_row, left_col] = GREY
+    grid[top_row - north_b_len : top_row, right_col] = GREY
+    grid[top_row, left_col - west_a_len : left_col] = GREY
+    grid[bottom_row, left_col - west_c_len : left_col] = GREY
+    grid[top_row, right_col + 1 : right_col + east_b_len + 1] = GREY
+    grid[bottom_row, right_col + 1 : right_col + east_d_len + 1] = GREY
+    grid[bottom_row + 1 : bottom_row + south_c_len + 1, left_col] = GREY
+    grid[bottom_row + 1 : bottom_row + south_d_len + 1, right_col] = GREY
+
+    node_cells = {
+        "A": (top_row, left_col),
+        "B": (top_row, right_col),
+        "C": (bottom_row, left_col),
+        "D": (bottom_row, right_col),
+    }
+    for node, color in zip(_NODE_NAMES, instructions):
+        r, c = node_cells[node]
+        grid[r, c] = int(color)
+
+    endpoints = {
+        "A_W": (top_row, left_col - west_a_len),
+        "B_N": (top_row - north_b_len, right_col),
+        "B_E": (top_row, right_col + east_b_len),
+        "C_W": (bottom_row, left_col - west_c_len),
+        "C_S": (bottom_row + south_c_len, left_col),
+        "D_E": (bottom_row, right_col + east_d_len),
+        "D_S": (bottom_row + south_d_len, right_col),
+    }
+    placements = {
+        "A_W": lambda r, c: (r + random.choice((-1, 0)), c - 2),
+        "B_N": lambda r, c: (r - 2, c + random.choice((-1, 0))),
+        "B_E": lambda r, c: (r + random.choice((-1, 0)), c + 1),
+        "C_W": lambda r, c: (r + random.choice((-1, 0)), c - 2),
+        "C_S": lambda r, c: (r + 1, c + random.choice((-1, 0))),
+        "D_E": lambda r, c: (r + random.choice((-1, 0)), c + 1),
+        "D_S": lambda r, c: (r + 1, c + random.choice((-1, 0))),
+    }
+    for endpoint, color in zip(_BULB_ENDPOINTS, bulb_colors):
+        er, ec = endpoints[endpoint]
+        br, bc = placements[endpoint](er, ec)
+        grid[br : br + 2, bc : bc + 2] = int(color)
+    return grid
+
+
+def _gen_attempt(required_turn: int) -> np.ndarray | None:
+    valid: list[tuple[tuple[int, int, int, int], dict[str, object]]] = []
+    for instructions in itertools.product(TURN_COLORS, repeat=4):
+        sim = _simulate_square(tuple(map(int, instructions)))
+        if sim is None:
+            continue
+        if required_turn not in sim["visited"]:
+            continue
+        valid.append((tuple(map(int, instructions)), sim))
+    if not valid:
+        return None
+
+    instructions, _sim = random.choice(valid)
+    bulb_colors = tuple(random.sample(_GEN_BULB_COLORS, len(_BULB_ENDPOINTS)))
+    grid = _build_square_grid(instructions, bulb_colors)
+    grid = np.rot90(grid, random.randint(0, 3))
+
+    try:
+        out, visited_turns, _endpoint, lit_bulb = _trace_signal(grid)
+    except AssertionError:
+        return None
+
+    if required_turn not in visited_turns:
+        return None
+    bulbs = _find_bulb_blocks(grid)
+    if len(bulbs) != len(_BULB_ENDPOINTS):
+        return None
+    lit_count = 0
+    for br, bc, _color in bulbs:
+        if np.all(out[br : br + 2, bc : bc + 2] == ORANGE):
+            lit_count += 1
+    if lit_count != 1:
+        return None
+    if all((br, bc) != lit_bulb for br, bc, _color in bulbs):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    global _GEN_COUNTER
+    required_turn = TURN_COLORS[_GEN_COUNTER % len(TURN_COLORS)]
+    for _ in range(_GEN_ATTEMPTS):
+        grid = _gen_attempt(required_turn)
+        if grid is not None:
+            _GEN_COUNTER += 1
+            return grid
+    raise RuntimeError("failed to generate a valid input for task 3")

