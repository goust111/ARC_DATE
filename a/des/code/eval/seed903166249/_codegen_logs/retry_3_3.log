+    grid[bottom_row, right_col + 1 : right_col + east_d_len + 1] = GREY
+    grid[bottom_row + 1 : bottom_row + south_c_len + 1, left_col] = GREY
+    grid[bottom_row + 1 : bottom_row + south_d_len + 1, right_col] = GREY
