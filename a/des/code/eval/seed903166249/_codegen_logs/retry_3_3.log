+        top_color = BLUE
+        bottom_color = random.choice((GREEN, RED, BLUE))
+    elif required_turn == GREEN:
+        start_side = random.choice((LEFT, RIGHT))
+        top_color = GREEN
+        bottom_color = random.choice(TURN_COLORS)
+    elif required_turn == YELLOW:
