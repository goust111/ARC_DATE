+import itertools
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+CYAN = 8
+BROWN = 9
+
+UP = (-1, 0)
+RIGHT = (0, 1)
+DOWN = (1, 0)
+LEFT = (0, -1)
+DIRS = (UP, RIGHT, DOWN, LEFT)
+
+TURN_COLORS = (RED, BLUE, GREEN, YELLOW)
+BULB_COLORS = (GREEN, YELLOW, MAGENTA, CYAN, BROWN)
+
+_GEN_ATTEMPTS = 300
+_GEN_COUNTER = 0
+
+
+def _turn(direction: tuple[int, int], color: int) -> tuple[int, int]:
+    if color == RED:
+        return {-1: LEFT, 1: RIGHT}[direction[0]] if direction[0] else {1: DOWN, -1: UP}[direction[1]]
+    if color == BLUE:
+        return {-1: RIGHT, 1: LEFT}[direction[0]] if direction[0] else {1: UP, -1: DOWN}[direction[1]]
+    if color == GREEN:
+        return direction
+    if color == YELLOW:
+        return (-direction[0], -direction[1])
+    raise AssertionError("unexpected turn color")
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _edge_positions(shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    cells: list[tuple[int, int]] = []
+    for c in range(w):
+        cells.append((0, c))
+        if h > 1:
+            cells.append((h - 1, c))
+    for r in range(1, h - 1):
+        cells.append((r, 0))
+        if w > 1:
+            cells.append((r, w - 1))
+    return cells
+
+
+def _junction_mask(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    mask = np.zeros_like(g, dtype=bool)
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if int(g[r, c]) not in TURN_COLORS:
+                continue
+            if (
+                int(g[r - 1, c]) == GREY
+                and int(g[r + 1, c]) == GREY
+                and int(g[r, c - 1]) == GREY
+                and int(g[r, c + 1]) == GREY
+            ):
+                mask[r, c] = True
+    return mask
+
+
+def _find_start(grid: np.ndarray) -> tuple[int, int]:
+    g = np.asarray(grid, dtype=int)
+    starts = [(r, c) for r, c in _edge_positions(g.shape) if int(g[r, c]) == ORANGE]
+    assert len(starts) == 1, "expected exactly one orange edge start"
+    return starts[0]
+
+
+def _find_bulb_blocks(grid: np.ndarray) -> list[tuple[int, int, int]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    blocks: list[tuple[int, int, int]] = []
+    for r in range(h - 1):
+        for c in range(w - 1):
+            color = int(g[r, c])
+            if color in (BLACK, GREY, ORANGE, RED, BLUE):
+                continue
+            block = g[r : r + 2, c : c + 2]
+            if np.all(block == color):
+                blocks.append((r, c, color))
+    return blocks
+
+
+def _adjacent_bulb_block(grid: np.ndarray, r: int, c: int) -> tuple[int, int] | None:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    for dr, dc in DIRS:
+        rr, cc = r + dr, c + dc
+        if not _in_bounds((h, w), rr, cc):
+            continue
+        color = int(g[rr, cc])
+        if color in (BLACK, GREY, ORANGE):
+            continue
+        found = None
+        for r0 in (rr - 1, rr):
+            for c0 in (cc - 1, cc):
+                if not _in_bounds((h - 1, w - 1), r0, c0):
+                    continue
+                block = g[r0 : r0 + 2, c0 : c0 + 2]
+                if np.all(block == color):
+                    found = (r0, c0)
