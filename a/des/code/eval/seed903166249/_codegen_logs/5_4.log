+    size = 2 * n - 1
+    assert size <= h and size <= w, "concentric square does not fit in output"
+    top = (h - size) // 2
+    left = (w - size) // 2
+    center_r = top + n - 1
+    center_c = left + n - 1
+
+    for radius, color in enumerate(layer_colors):
+        r0 = center_r - radius
+        r1 = center_r + radius
+        c0 = center_c - radius
+        c1 = center_c + radius
