+import numpy as np
+
+
+BLACK = 0
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+SHAPE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+GREY = 5
+GEN_RETRIES = 300
