+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            touches_border = False
+            while stack:
+                rr, cc = stack.pop()
+                if rr == 0 or cc == 0 or rr == h - 1 or cc == w - 1:
+                    touches_border = True
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and bg[nr, nc] and not seen[nr, nc]:
