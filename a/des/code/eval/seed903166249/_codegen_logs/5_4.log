+                continue
+            holes = [{seed} for seed in seeds]
+            occupied = set(seeds)
+
+            for idx, comp in enumerate(holes):
+                growth = random.randint(0, max(1, ((base_h - 2) * (base_w - 2)) // (hole_count * 5)))
+                for _ in range(growth):
+                    frontier: list[tuple[int, int]] = []
+                    for r, c in comp:
+                        for dr, dc in NEIGHBORS4:
