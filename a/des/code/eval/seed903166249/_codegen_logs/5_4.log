+def _place_shapes(
+    height: int,
+    width: int,
+    masks: list[np.ndarray],
+    colors: list[int],
+) -> np.ndarray | None:
+    canvas = np.full((height, width), BLACK, dtype=int)
+    reserved = np.zeros((height, width), dtype=bool)
+    order = sorted(range(len(masks)), key=lambda idx: int(masks[idx].sum()), reverse=True)
