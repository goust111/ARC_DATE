+        right_len = random.randint(*TERMINAL_SEGMENT_LEN_RANGE)
+        left_col = leftmost_col - left_len - 1
+        right_col = rightmost_col + right_len + 1
+        if left_col < 0 or right_col >= width:
+            return None
+        blocked_side = random.choice(("left", "right"))
+        horizontals.append(
