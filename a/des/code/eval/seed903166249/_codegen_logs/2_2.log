+def _make_monotone_path(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
+    dr = end[0] - start[0]
+    dc = end[1] - start[1]
+    assert dr != 0 or dc != 0
+
+    steps = ["v"] * abs(dr) + ["h"] * abs(dc)
+    random.shuffle(steps)
