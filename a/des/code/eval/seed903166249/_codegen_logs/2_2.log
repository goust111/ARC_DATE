+# --------------- generator ---------------
+
+GRID_H_RANGE = (12, 22)
+GRID_W_RANGE = (12, 22)
+PATH_COUNT_RANGE = (1, 3)
+COMPONENT_ATTEMPTS = 120
+GEN_ATTEMPTS = 400
