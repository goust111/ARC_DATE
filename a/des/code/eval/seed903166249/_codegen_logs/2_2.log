+    for comp in _parse_grid(g):
+        signal = int(comp["tx_color"])
+        base = int(comp["base_color"])
+        for r, c in comp["path"]:
+            cell_color = int(g[r, c])
+            if cell_color != base:
+                out[r, c] = signal
+                signal = cell_color
