+    for dr, dc in DIRS:
+        rr = int(r)
+        cc = int(c)
+        dist = 0
+        while True:
+            rr += int(dr)
+            cc += int(dc)
+            dist += 1
+            if not (0 <= rr < h and 0 <= cc < w):
