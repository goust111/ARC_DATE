+    if cols is None:
+        return None
+
+    min_len = max(5, int(np.ceil(0.55 * h)))
+    shared_mode: str | None = None
+    shared_value: int | None = None
+    if collision:
+        if rng.random() < 0.5:
+            shared_mode = "start"
+            high = h - min_len - 1
+            if high < 1:
+                return None
+            shared_value = int(rng.integers(1, high + 1))
+        else:
+            shared_mode = "end"
