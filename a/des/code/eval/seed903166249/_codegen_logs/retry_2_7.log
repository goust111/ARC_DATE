+
+
+def _collision_components(blocks: list[Block], proposed: dict[int, tuple[int, int]]) -> list[list[int]]:
+    alive_ids = [int(block.ident) for block in blocks if block.alive]
+    neighbors = {ident: set() for ident in alive_ids}
