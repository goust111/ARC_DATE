+def _find_blocks(grid: np.ndarray) -> list[Block]:
+    g = np.asarray(grid, dtype=int)
+    height, width = map(int, g.shape)
+    seen_centers: set[tuple[int, int]] = set()
+    blocks: list[Block] = []
