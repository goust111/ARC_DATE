+def _touch_or_overlap(pos_a: tuple[int, int], pos_b: tuple[int, int]) -> bool:
+    dr = abs(int(pos_a[0]) - int(pos_b[0]))
+    dc = abs(int(pos_a[1]) - int(pos_b[1]))
+    return (dr <= 2 and dc <= 3) or (dr <= 3 and dc <= 2)
