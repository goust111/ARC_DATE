+def _attempt_generate() -> np.ndarray | None:
+    overlap_mode = random.choice([False, True])
+    if overlap_mode:
+        height = random.randint(16, 22)
+        width = random.randint(16, 22)
+        fence_count = random.randint(2, 4)
