+
+def _pointer_direction(grid: np.ndarray, room: dict) -> str:
+    r0, c0, r1, c1 = room["bbox"]
+    coords = np.argwhere(grid[r0 + 1 : r1, c0 + 1 : c1] == ORANGE)
