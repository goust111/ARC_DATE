+
+def _wall_owner(boxes: list[tuple[int, int, int, int]]) -> dict[tuple[int, int], int]:
+    owner: dict[tuple[int, int], int] = {}
+    for idx, (r0, c0, r1, c1) in enumerate(boxes):
+        for cell in _border_cells(r0, c0, r1, c1):
+            owner[cell] = idx
+    return owner
