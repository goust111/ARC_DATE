+    elif door[0] == r1:
+        side = "down"
+    elif door[1] == c0:
+        side = "left"
+    else:
+        side = "right"
+
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "door": door,
+        "door_side": side,
+    }
