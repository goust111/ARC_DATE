+            break
+        cells.append((r, c))
+        r += dr
+        c += dc
+
+    branch = "wall" if blocker_room is not None else "edge"
+    return cells, branch, blocker_room, blocker_cell
+
+
+def _room_configs(
+    room_idx: int,
