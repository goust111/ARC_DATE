+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+PALETTE = (1, 2, 3, 5, 6, 7, 8, 9)
+SIDES = ("top", "right", "bottom", "left")
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+ROTATE_FROM_UP = {"top": 0, "right": 3, "bottom": 2, "left": 1}
+
+STAMP_SHAPES = (
