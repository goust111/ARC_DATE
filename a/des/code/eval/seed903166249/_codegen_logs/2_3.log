+        patch[0, gap_offset : gap_offset + gap_len] = BG
+    elif side == "bottom":
+        patch[-1, gap_offset : gap_offset + gap_len] = BG
+    elif side == "left":
+        patch[gap_offset : gap_offset + gap_len, 0] = BG
+    else:
+        patch[gap_offset : gap_offset + gap_len, -1] = BG
