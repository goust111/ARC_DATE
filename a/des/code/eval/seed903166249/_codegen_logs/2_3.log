+def _classify_gap(
+    missing: set[tuple[int, int]], bbox: tuple[int, int, int, int]
+) -> tuple[str, int, int] | None:
+    r0, c0, r1, c1 = bbox
+    if len(missing) not in (1, 2):
+        return None
