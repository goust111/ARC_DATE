+def _random_mask(shape: tuple[int, int], rng: random.Random) -> np.ndarray:
+    h, w = shape
+    mask = np.zeros((h, w), dtype=bool)
+    cells: set[tuple[int, int]] = set()
+    for r in range(h):
+        cells.add((r, rng.randrange(w)))
+    for c in range(w):
