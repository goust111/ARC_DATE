+    color_count = len(colors)
+    coords = [(r, c) for r in range(stamp_h) for c in range(stamp_w) if mask[r, c]]
+    if color_count == 1:
+        for r, c in coords:
+            stamp[r, c] = colors[0]
+    else:
+        rng.shuffle(coords)
+        split = rng.randint(1, len(coords) - 1)
+        first = set(coords[:split])
+        for r, c in coords:
