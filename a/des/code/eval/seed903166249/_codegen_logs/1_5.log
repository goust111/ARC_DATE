+def _count_runs(values: list[int]) -> int:
+    if not values:
+        return 0
+    values.sort()
+    runs = 1
+    prev = values[0]
+    for value in values[1:]:
+        if value != prev + 1:
+            runs += 1
+        prev = value
+    return runs
+
+
+def _region_side_count(grid: np.ndarray, cells: list[tuple[int, int]]) -> int:
+    h, w = grid.shape
