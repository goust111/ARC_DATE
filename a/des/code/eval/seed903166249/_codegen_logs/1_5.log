+        while c < w:
+            if int(grid[r, c]) != GREY or (c > 0 and int(grid[r, c - 1]) == GREY):
+                c += 1
+                continue
+            end = c
+            while end + 1 < w and int(grid[r, end + 1]) == GREY:
+                end += 1
+            if (r > 0 and np.any(grid[r - 1, c : end + 1] == GREY)) or (r + 1 < h and np.any(grid[r + 1, c : end + 1] == GREY)):
