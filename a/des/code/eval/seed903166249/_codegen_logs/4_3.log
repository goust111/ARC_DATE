    if missing_side != "right":
        patch[:, -1] = _GEN_WALL
    patch[-1, :] = _GEN_WALL
    if gap is not None:
        patch[-1, gap] = _GEN_BG
    return patch


def _gen_distractor_patches() -> list[np.ndarray]:
    patches: list[np.ndarray] = []

    for h in range(*_GEN_DISTRACTOR_H_RANGE):
