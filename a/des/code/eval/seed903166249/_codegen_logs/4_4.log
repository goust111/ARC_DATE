+    h, w = shape
+    for _ in range(80):
+        color_count = min(len(palette), rng.randint(2, min(4, len(palette))))
+        colors = rng.sample(palette, color_count)
+        patch = np.array([[colors[rng.randrange(color_count)] for _ in range(w)] for _ in range(h)], dtype=int)
