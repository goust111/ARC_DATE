+        marker_side, marker_color = marker_hits[0]
+        pieces.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "shape": patch.shape,
+                "patch": patch.copy(),
+                "marker_side": marker_side,
+                "marker_color": marker_color,
+            }
+        )
