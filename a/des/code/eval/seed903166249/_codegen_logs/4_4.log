+    expected = np.full_like(grid, BG_COLOR)
+    expected[tr0 : tr0 + template_h, tc0 : tc0 + template_w] = template
+    for spec in hole_specs:
+        fill = np.rot90(spec["piece_patch"], spec["rotation"]).copy()
