+    if mr == r0 - 1 and c0 <= mc <= c1:
+        return "top"
+    if mr == r1 + 1 and c0 <= mc <= c1:
+        return "bottom"
+    if mc == c0 - 1 and r0 <= mr <= r1:
+        return "left"
+    if mc == c1 + 1 and r0 <= mr <= r1:
+        return "right"
+    raise AssertionError("marker must sit on one hole side")
