+
+        neighbors = set()
+        valid_hole = True
+        for r, c in coords:
+            for nr, nc in _neighbors4(int(r), int(c), h, w):
+                if g[nr, nc] == bg:
+                    continue
+                neighbors.add((nr, nc))
+                if not template_mask[nr, nc]:
