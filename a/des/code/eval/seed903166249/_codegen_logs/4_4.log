+
+
+def _sample_branches(rng: random.Random, count: int) -> list[str]:
+    branches = ["same", "swapped", "square"]
+    if count == 3:
+        rng.shuffle(branches)
+        return branches
+    return rng.sample(branches, count)
+
+
+def _random_base_patch(
+    rng: random.Random,
+    shape: tuple[int, int],
+    palette: tuple[int, ...],
+    branch: str,
