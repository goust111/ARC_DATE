+    for spec in rng.sample(hole_specs, len(hole_specs)):
+        patch = spec["piece_patch"]
+        ph, pw = patch.shape
+        placed = False
+        for _ in range(PLACEMENT_RETRIES):
+            r0 = rng.randint(1, grid_h - ph - 1)
+            c0 = rng.randint(1, grid_w - pw - 1)
