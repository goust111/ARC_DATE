+    tr0 = top_margin
+    tc0 = left_margin
+    grid = np.full((grid_h, grid_w), BG_COLOR, dtype=int)
+    grid[tr0 : tr0 + template_h, tc0 : tc0 + template_w] = template
+
+    blocked = np.zeros_like(grid, dtype=bool)
+    _blocked_after_place(blocked, tr0, tc0, template_h, template_w)
