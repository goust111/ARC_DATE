                "marker_side": marker_side,
                "marker_color": marker_color,
            }
        )

    assert len(pieces) == len(holes), "piece count must equal hole count"
    return {
        "grid": g,
        "bg": bg,
        "template_mask": template_mask,
        "holes": holes,
        "pieces": pieces,
    }


