+
+
+def _build_template(
+    rng: random.Random,
+    hole_specs: list[dict],
+) -> tuple[np.ndarray, list[dict]]:
+    count = len(hole_specs)
+    rows = 1 if count == 2 and rng.random() < 0.5 else 2
+    cols = (count + rows - 1) // rows
+    slots = [(r, c) for r in range(rows) for c in range(cols)]
+    rng.shuffle(slots)
