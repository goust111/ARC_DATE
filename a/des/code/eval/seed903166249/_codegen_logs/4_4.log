+            if rotated.shape != hole["shape"]:
+                continue
+            if _rotate_side(piece["marker_side"], k) != hole["marker_side"]:
+                continue
+            rr, cc = _midpoint(rotated.shape, hole["marker_side"])
+            if int(rotated[rr, cc]) != hole["marker_color"]:
