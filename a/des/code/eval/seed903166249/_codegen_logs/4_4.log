+import random
+from collections import Counter
+
+import numpy as np
+
+
+SIDE_CCW = ("top", "left", "bottom", "right")
+BG_COLOR = 8
+TEMPLATE_COLOR = 5
+MARKER_POOL = (1, 2, 3, 4, 6, 7, 9)
+FILL_POOL = (0, 1, 2, 3, 4, 6, 7, 9)
