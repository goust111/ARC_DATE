def _has_hole(mask: np.ndarray) -> bool:
    bg = ~mask.astype(bool)
    if not bool(bg.any()):
        return False

    H, W = bg.shape
    seen = np.zeros_like(bg, dtype=bool)
    stack: list[tuple[int, int]] = []
    for r in range(H):
        for c in (0, W - 1):
            if bg[r, c] and not seen[r, c]:
                seen[r, c] = True
                stack.append((r, c))
    for c in range(W):
        for r in (0, H - 1):
            if bg[r, c] and not seen[r, c]:
                seen[r, c] = True
                stack.append((r, c))

    while stack:
        r, c = stack.pop()
        for dr, dc in GEN_NEIGHBORS_4:
            nr, nc = r + dr, c + dc
            if 0 <= nr < H and 0 <= nc < W and bg[nr, nc] and not seen[nr, nc]:
                seen[nr, nc] = True
                stack.append((nr, nc))
