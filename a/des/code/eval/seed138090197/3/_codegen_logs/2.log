+def _tight_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    assert coords.size, "expected a nonempty mask"
+    r0 = int(coords[:, 0].min())
+    r1 = int(coords[:, 0].max())
+    c0 = int(coords[:, 1].min())
+    c1 = int(coords[:, 1].max())
+    return mask[r0 : r1 + 1, c0 : c1 + 1].astype(bool)
+
