+            coords = np.asarray(pts, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": int(len(pts)),
+                }
+            )
+
+    return comps
