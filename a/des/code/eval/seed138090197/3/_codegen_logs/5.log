+
+def _bottom_marker_patch(proto: tuple[tuple[int, int], ...], marker_color: int) -> np.ndarray:
+    coords, h, w = _normalize(proto)
+    patch = np.zeros((h + 1, w), dtype=int)
+    for r, c in coords:
+        patch[r, c] = LEGEND_SHAPE_COLOR
