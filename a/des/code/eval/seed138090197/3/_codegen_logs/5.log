+    while unassigned:
+        frontier: list[tuple[tuple[int, int], int]] = []
+        for idx, group in enumerate(groups):
+            for cell in sorted(unassigned):
+                if any(abs(cell[0] - rr) + abs(cell[1] - cc) == 1 for rr, cc in group):
