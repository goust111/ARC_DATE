+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+TEMPLATE_COLOR = 5
+LEGEND_SHAPE_COLOR = 8
+PALETTE = (1, 2, 3, 4, 6, 7, 9)
+GEN_RETRIES = 400
+PLACE_RETRIES = 300
+
+SHAPE_LIBRARY: tuple[tuple[tuple[int, int], ...], ...] = (
+    ((0, 0), (1, 0), (2, 0), (2, 1)),
+    ((0, 1), (1, 0), (1, 1), (1, 2), (2, 1)),
+    ((0, 1), (0, 2), (1, 0), (1, 1), (2, 0)),
+    ((0, 0), (0, 1), (1, 0), (1, 1), (2, 0)),
+    ((0, 0), (0, 2), (1, 0), (1, 1), (1, 2)),
+    ((0, 0), (1, 0), (1, 1), (1, 2), (2, 2)),
+    ((0, 1), (1, 0), (1, 1), (2, 1), (2, 2)),
+    ((0, 0), (0, 1), (0, 2), (1, 0), (2, 0)),
