+        legend_w = max(p.shape[1] for p in legend_patches)
+        legend_h = sum(p.shape[0] for p in legend_patches) + 2 * (len(legend_patches) - 1)
+        min_h = max(20, template_h + 4, legend_h + 1)
+        min_w = max(20, template_w + legend_w + 4)
+    else:
