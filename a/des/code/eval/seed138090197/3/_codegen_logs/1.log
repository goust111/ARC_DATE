+        if any(_profiles_match(lock["side"], lock["profile"], side, prof) for lock in locks):
+            continue
+        patch = _render_key(side, prof, random.randint(*KEY_BASE_RANGE), color)
+        return {
+            "kind": "key",
+            "side": side,
+            "profile": prof,
