+    for r0 in range(h):
+        for c0 in range(w):
+            if seen[r0, c0] or int(g[r0, c0]) == int(bg):
+                continue
+            color = int(g[r0, c0])
+            q = deque([(r0, c0)])
+            seen[r0, c0] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                r, c = q.popleft()
+                coords.append((int(r), int(c)))
+                for dr, dc in DIR4:
+                    nr = int(r + dr)
+                    nc = int(c + dc)
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(g[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
