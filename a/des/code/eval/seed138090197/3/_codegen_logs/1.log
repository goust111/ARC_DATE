+
+
+def _build_case() -> tuple[np.ndarray, np.ndarray] | None:
+    n_pairs = random.randint(*PAIR_COUNT_RANGE)
+    n_extra = random.choice(EXTRA_KEY_CHOICES)
+    need_colors = n_pairs * 2 + n_extra
+    if need_colors > len(COLORS):
