    cols = sorted(c for _, c in coords)
    if rows[0] == rows[1] == rows[2] and cols == [cols[0], cols[0] + 1, cols[0] + 2]:
        return "h"
    if cols[0] == cols[1] == cols[2] and rows == [rows[0], rows[0] + 1, rows[0] + 2]:
