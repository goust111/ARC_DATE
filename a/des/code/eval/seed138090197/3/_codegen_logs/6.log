+GEN_WALL = 5
+GEN_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_H_MIN = 11
+GEN_H_MAX = 17
+GEN_W_MIN = 11
+GEN_W_MAX = 17
+GEN_ATTEMPTS = 300
+PAIR_ATTEMPTS = 120
+SHAPE_ATTEMPTS = 80
+
