+DIRS = ("left", "right", "up", "down")
+
+# --------------- solver ---------------
+
+
+def _most_common_color(arr: np.ndarray) -> int:
+    vals, counts = np.unique(arr, return_counts=True)
+    return int(vals[int(np.argmax(counts))])
