+                    "color": int(pair["color"]),
+                    "height": int(pair["height"]),
+                    "width": int(pair["width"]),
+                    "mask": np.asarray(mask, dtype=bool),
+                }
+            )
+
+    order = list(range(len(fragments)))
+    _RNG.shuffle(order)
+    order.sort(
