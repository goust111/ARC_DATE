+    size_cap = {1: 24, 2: 18, 3: 15}[container_count]
+    return frame_extra, margin_extra, size_cap
+
+
+def _build_cluster(color: int, bg: int, container_count: int) -> tuple[np.ndarray, np.ndarray]:
