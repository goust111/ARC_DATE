+
+def _dominant_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _round_half_up(value: float) -> int:
+    return int(np.floor(float(value) + 0.5))
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    height, width = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for row in range(height):
+        for col in range(width):
+            if not mask[row, col] or seen[row, col]:
+                continue
+            stack = [(row, col)]
+            seen[row, col] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                coords.append((r, c))
+                for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                    if 0 <= nr < height and 0 <= nc < width and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.asarray(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _component_center(coords: np.ndarray) -> tuple[int, int]:
+    row = _round_half_up(float(coords[:, 0].mean()))
+    col = _round_half_up(float(coords[:, 1].mean()))
+    return row, col
+
+
+def _make_component_patch(
+    coords: np.ndarray,
+    color: int,
+    bg: int,
+) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = _bbox(coords)
+    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+    rel = coords - np.array([r0, c0], dtype=int)
+    patch[rel[:, 0], rel[:, 1]] = int(color)
+    return patch, (r0, c0, r1, c1)
