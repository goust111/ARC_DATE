+    local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    rel = coords - np.array([r0, c0], dtype=int)
+    local[rel[:, 0], rel[:, 1]] = True
+
+    border = np.zeros_like(local, dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    if not np.array_equal(local, border):
+        return False
