    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
        yield r+dr,c+dc

def get_bg(g):
    vals, cnts = np.unique(g, return_counts=True)
    return int(vals[cnts.argmax()])

def build_path_mask(g):
    h,w=g.shape
    bg=get_bg(g)
