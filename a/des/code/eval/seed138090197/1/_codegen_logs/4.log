+import numpy as np
+
+
+GRAY = 5
+BG = 0
+LINE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GEN_RETRIES = 400
+LINE_RETRIES = 120
