+def _side_components(path: list[tuple[int, int]], comp_id: np.ndarray, comp_count: int) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    h, w = comp_id.shape
+    first_left: dict[int, int] = {}
+    first_right: dict[int, int] = {}
+
+    for i in range(len(path) - 1):
