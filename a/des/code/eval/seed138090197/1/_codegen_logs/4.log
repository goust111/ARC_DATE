+
+def _line_options(path: list[tuple[int, int]], path_mask: np.ndarray, used_cells: set[tuple[int, int]], idx: int) -> list[tuple[list[tuple[int, int]], tuple[int, int]]]:
+    h, w = path_mask.shape
+    if not (1 <= idx < len(path) - 1):
