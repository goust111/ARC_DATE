from collections import deque
import random, numpy as np

def neighbors4(r,c):
    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
        yield r+dr,c+dc

def comps(passable):
    h,w=passable.shape
    vis=np.zeros_like(passable,bool)
    idx=np.full((h,w),-1,int)
    out=[]
    for r in range(h):
        for c in range(w):
            if passable[r,c] and not vis[r,c]:
                q=deque([(r,c)]); vis[r,c]=True; pts=[]; cid=len(out)
                while q:
                    x,y=q.popleft(); pts.append((x,y)); idx[x,y]=cid
                    for nx,ny in neighbors4(x,y):
                        if 0<=nx<h and 0<=ny<w and passable[nx,ny] and not vis[nx,ny]:
                            vis[nx,ny]=True; q.append((nx,ny))
                out.append(pts)
    return out,idx

def classify(H,W,path):
    path_set=set(path)
    passable=np.ones((H,W),bool)
    for r,c in path_set: passable[r,c]=False
    components, comp_idx = comps(passable)
    sides=[]
    for cid in range(len(components)):
        minL=minR=None
        for i in range(len(path)-1):
            r,c=path[i]; nr,nc=path[i+1]
            dr,dc=nr-r,nc-c
            left=(-dc,dr); right=(dc,-dr)
            for x,y in ((r+left[0],c+left[1]),(nr+left[0],nc+left[1])):
                if 0<=x<H and 0<=y<W and comp_idx[x,y]==cid:
                    minL=i if minL is None else min(minL,i)
            for x,y in ((r+right[0],c+right[1]),(nr+right[0],nc+right[1])):
                if 0<=x<H and 0<=y<W and comp_idx[x,y]==cid:
                    minR=i if minR is None else min(minR,i)
        sides.append((cid,minL,minR))
    lc=sum(1 for _,l,r in sides if l is not None and r is None)
    rc=sum(1 for _,l,r in sides if r is not None and l is None)
    return lc,rc,sides

def build(H,W,k,start_col,start_left):
    # evenly spaced rows
    rows=[]
    cur=2
    for i in range(k):
        rows.append(cur)
        cur += 3
    if rows[-1] >= H-1: return None
    side=0 if start_left else W-1
    curr=(0,start_col)
    verts=[curr]
    for r in rows:
        if curr[0]"'!=r: verts.append((r,curr[1]))
        if curr[1]!=side: verts.append((r,side))
        curr=verts[-1]
        side = W-1 if side==0 else 0
    if curr[0]!=H-1: verts.append((H-1,curr[1]))
    path=[]
    for (r0,c0),(r1,c1) in zip(verts,verts[1:]):
        if r0==r1:
            step=1 if c1>c0 else -1
            for c in range(c0,c1+step,step):
                if not path or path[-1]!=(r0,c): path.append((r0,c))
        else:
            step=1 if r1>r0 else -1
            for r in range(r0,r1+step,step):
                if not path or path[-1]!=(r,c0): path.append((r,c0))
    return path

for k in [1,2,3,4,5]:
    H=3*k+4; W=14
    for start_left in [False,True]:
        path=build(H,W,k,5,start_left)
        lc,rc,sides=classify(H,W,path)
        print('"'k',k,'start_left',start_left,'counts',lc,rc)
