+        for x, y in ((r + left[0], c + left[1]), (nr + left[0], nc + left[1])):
+            if 0 <= x < h and 0 <= y < w:
+                cid = int(comp_id[x, y])
+                if cid >= 0:
+                    first_left.setdefault(cid, i)
