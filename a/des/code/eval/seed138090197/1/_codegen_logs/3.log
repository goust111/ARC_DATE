+def _seed_dirs(block: np.ndarray) -> set[str]:
+    dirs: set[str] = set()
+    if np.any(block[0, :] == MARKER):
+        dirs.add("up")
+    if np.any(block[-1, :] == MARKER):
+        dirs.add("down")
+    if np.any(block[:, 0] == MARKER):
+        dirs.add("left")
+    if np.any(block[:, -1] == MARKER):
+        dirs.add("right")
+    return dirs
