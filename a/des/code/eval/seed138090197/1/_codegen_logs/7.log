+    elif side == "bottom":
+        for i, bit in enumerate(pattern):
+            if bit:
+                grid[-1, start + i] = color
+    elif side == "left":
+        for i, bit in enumerate(pattern):
+            if bit:
+                grid[start + i, 0] = color
+    else:
+        for i, bit in enumerate(pattern):
+            if bit:
+                grid[start + i, -1] = color
+
