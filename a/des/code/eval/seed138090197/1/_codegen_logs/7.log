+        if r1 == h - 1:
+            reserved["bottom"][c0 : c1 + 1] = True
+        if c0 == 0:
+            reserved["left"][r0 : r1 + 1] = True
+        if c1 == w - 1:
+            reserved["right"][r0 : r1 + 1] = True
+    return reserved
