+    r0, c0, r1, c1 = rect
+    vr0 = max(0, r0)
+    vc0 = max(0, c0)
+    vr1 = min(h - 1, r1)
+    vc1 = min(w - 1, c1)
+    if vr0 > vr1 or vc0 > vc1:
+        return None
+    return vr0, vc0, vr1, vc1
