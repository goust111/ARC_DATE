+def _analyze_pair(mask_a: np.ndarray, mask_b: np.ndarray) -> np.ndarray | None:
+    full_ab = _completion(mask_a, mask_b)
+    if full_ab is None:
+        return None
+    full_ba = _completion(mask_b, mask_a)
+    if full_ba is None or not np.array_equal(full_ab, full_ba):
+        return None
+    return full_ab
