_GEN_V_WIDTH_RANGE = (3, 6)
_GEN_V_EXTRA_RANGE = (4, 10)
_GEN_H_WIDTH_RANGE = (11, 14)
_GEN_MAX_BODY_HEIGHT = 14
_GEN_MIN_MODE_GAP = 2
_GEN_MISSING_CORNERS = ("TL", "TR", "BL", "BR")

# Boundary source feature counts.
_GEN_PAIR_COUNT_RANGE = (1, 3)
_GEN_MAX_TABS = 4

