+    dim_floor = max(GEN_GRID_MIN, max_h + 2, max_w + 2, 12 + 3 * (pair_count - 1))
+    if dim_floor > GEN_GRID_MAX:
+        return None
+    h = random.randint(dim_floor, GEN_GRID_MAX)
+    w = random.randint(dim_floor, GEN_GRID_MAX)
+
+    objects = []
