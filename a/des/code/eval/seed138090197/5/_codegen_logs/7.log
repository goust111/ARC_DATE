+def _candidate_partners(index: int, remaining: tuple[int, ...], pair_info: dict[tuple[int, int], np.ndarray]) -> list[int]:
+    partners = []
+    for other in remaining:
+        if other == index:
+            continue
+        key = (index, other) if index < other else (other, index)
+        if key in pair_info:
+            partners.append(other)
+    return partners
