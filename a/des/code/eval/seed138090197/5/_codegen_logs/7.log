+            arr = np.array(sorted(coords), dtype=int)
+            r0 = int(arr[:, 0].min())
+            c0 = int(arr[:, 1].min())
+            r1 = int(arr[:, 0].max())
+            c1 = int(arr[:, 1].max())
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            mask[arr[:, 0] - r0, arr[:, 1] - c0] = True
+            comps.append(
+                {
