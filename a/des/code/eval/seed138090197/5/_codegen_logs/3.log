+_L_PATTERNS = [
+    frozenset(((-1, 0), (0, -1))),
+    frozenset(((-1, 0), (0, 1))),
+    frozenset(((1, 0), (0, -1))),
+    frozenset(((1, 0), (0, 1))),
+]
