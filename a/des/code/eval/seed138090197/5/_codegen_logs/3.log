+
+_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+_L_PATTERNS = [
+    frozenset(((-1, 0), (0, -1))),
+    frozenset(((-1, 0), (0, 1))),
+    frozenset(((1, 0), (0, -1))),
+    frozenset(((1, 0), (0, 1))),
+]
