+
+    extra_candidates = [
+        (r, c)
+        for r in range(r0, r1 + 1)
+        for c in range(c0, c1 + 1)
+        if grid[r, c] == _BG
+    ]
+    random.shuffle(extra_candidates)
+    extra_budget = random.randint(0, 1 if mode == "none" else 2)
