+    w = c1 - c0 + 1
+    row_origins = [r0 + _LEGEND_MARGIN, r0 + h - _LEGEND_SLOT - _LEGEND_MARGIN]
+    col_origins = [c0 + _LEGEND_MARGIN, c0 + w - _LEGEND_SLOT - _LEGEND_MARGIN]
+    slots = [(rr, cc) for rr in row_origins for cc in col_origins]
