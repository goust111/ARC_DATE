            expected[top:bottom, left + 1 : right] = _GEN_MARKER
        else:
            outside = [c for c in range(_GEN_W) if not (left <= c <= right)]
            marker_c = int(outside[int(np.random.randint(0, len(outside)))])
            expected[-1, :] = _GEN_MARKER
