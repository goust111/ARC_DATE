+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            stack = [(r, c)]
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(comp)
+    return out
+
+
+def _background_color(grid: np.ndarray) -> int:
+    colors, counts = np.unique(grid, return_counts=True)
+    return int(colors[np.argmax(counts)])
+
+
+def _extract_palette(region: np.ndarray, bg: int) -> np.ndarray | None:
+    comps = _components(region != bg)
+    if len(comps) != 1:
+        return None
+    r0, c0, r1, c1 = _bbox(comps[0])
+    palette = region[r0 : r1 + 1, c0 : c1 + 1]
+    if palette.shape[0] < 2 or palette.shape[1] < 2:
+        return None
+    if np.any(palette == bg):
+        return None
+    if len(np.unique(palette)) < 2:
+        return None
+    return palette.copy()
+
+
+def _extract_pieces(region: np.ndarray, bg: int) -> list[dict] | None:
+    comps = _components(region != bg)
+    if not comps:
+        return None
+    pieces: list[dict] = []
+    seen_colors: set[int] = set()
+    for comp in comps:
+        colors = {int(region[r, c]) for r, c in comp}
+        if len(colors) != 1:
+            return None
+        color = next(iter(colors))
+        if color in seen_colors:
+            return None
+        r0, c0, r1, c1 = _bbox(comp)
+        rel = tuple(sorted((r - r0, c - c0) for r, c in comp))
+        pieces.append(
+            {
+                "color": color,
+                "coords": comp,
+                "bbox": (r0, c0, r1, c1),
+                "shape": rel,
+                "area": len(comp),
+            }
+        )
+        seen_colors.add(color)
+    return pieces
+
+
