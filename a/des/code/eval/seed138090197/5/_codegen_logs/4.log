+
+BG = 0
+SEPARATOR = 5
+PALETTE_DIMS = ((2, 2), (2, 3), (3, 2))
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_ATTEMPTS = 400
