+    pieces: list[dict] = []
+    seen_colors: set[int] = set()
+    for comp in comps:
+        colors = {int(region[r, c]) for r, c in comp}
+        if len(colors) != 1:
+            return None
+        color = next(iter(colors))
+        if color in seen_colors:
+            return None
+        r0, c0, r1, c1 = _bbox(comp)
+        rel = tuple(sorted((r - r0, c - c0) for r, c in comp))
+        pieces.append(
+            {
