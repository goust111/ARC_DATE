+    assigned = piece_count
+    while assigned < area:
+        candidates = []
+        weights = []
+        for idx in range(piece_count):
+            if sizes[idx] >= targets[idx]:
+                continue
+            options = [cell for cell in frontiers[idx] if labels[cell] < 0]
