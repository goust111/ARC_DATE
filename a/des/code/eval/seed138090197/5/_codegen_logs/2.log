+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_RETRIES = 400
+GRID_MARGIN_RANGE = (2, 5)
+PATTERN_SIZE_RANGE = (7, 13)
+PATTERN_FILL_FRAC = (0.24, 0.46)
