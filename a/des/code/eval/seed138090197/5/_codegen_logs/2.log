import random
import numpy as np

BG = 0
DIR4 = [(-1,0),(1,0),(0,-1),(0,1)]


def rot90_cell(r,c,n):
    return c, n-1-r


def all_orbits(n):
    seen=set(); orbits=[]; cell_to_orbit={}
    for r in range(n):
        for c in range(n):
            if (r,c) in seen:
                continue
            orbit=[]
            rr,cc=r,c
            for _ in range(4):
                if (rr,cc) not in orbit:
                    orbit.append((rr,cc))
                rr,cc=rot90_cell(rr,cc,n)
            orbit=tuple(sorted(orbit))
            idx=len(orbits)
            orbits.append(orbit)
            for cell in orbit:
                seen.add(cell)
                cell_to_orbit[cell]=idx
    return orbits, cell_to_orbit


def orbit_graph(n):
    orbits, cell_to_orbit = all_orbits(n)
    adj=[set() for _ in orbits]
    for (r,c), i in cell_to_orbit.items():
        for dr,dc in DIR4:
            rr,cc=r+dr,c+dc
            if 0<=rr<n and 0<=cc<n:
                j=cell_to_orbit[(rr,cc)]
                if i"'!=j:
                    adj[i].add(j)
    return orbits, adj, cell_to_orbit


def connected(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:
        return False
    seen={tuple(map(int,pts[0]))}
    stack=[tuple(map(int,pts[0]))]
    h,w=mask.shape
    while stack:
        r,c=stack.pop()
        for dr,dc in DIR4:
            rr,cc=r+dr,c+dc
            if 0<=rr<h and 0<=cc<w and mask[rr,cc] and (rr,cc) not in seen:
                seen.add((rr,cc)); stack.append((rr,cc))
    return len(seen)==len(pts)


def bbox(mask):
    pts=np.argwhere(mask)
    r0,c0=pts.min(axis=0)
    r1,c1=pts.max(axis=0)
    return tuple(map(int,(r0,c0,r1,c1)))


def make_template(rng,n):
    orbits, adj, cell_to_orbit = orbit_graph(n)
    center = (n//2, n//2) if n%2 else (n//2-1, n//2-1)
    active={cell_to_orbit[center]}
    frontier=set(adj[next(iter(active))])
    boundary_orbits={i for i,orbit in enumerate(orbits) if any(r in (0,n-1) or c in (0,n-1) for r,c in orbit)}
    target = rng.randint(max(10, int(n*n*0.24)), max(12, int(n*n*0.46)))
    while frontier and (sum(len(orbits[i]) for i in active) < target or not (active & boundary_orbits)):
        cand=sorted(frontier)
        weights=[]
        for i in cand:
            bonus=2.0 if i in boundary_orbits and not (active & boundary_orbits) else 1.0
            weights.append(bonus + rng.random())
        chosen=rng.choices(cand, weights=weights, k=1)[0]
        active.add(chosen)
        frontier.remove(chosen)
        frontier.update(adj[chosen]-active)
    # optional extra growth
    extra_steps=rng.randint(0, max(1, n//3))
    for _ in range(extra_steps):
        if not frontier:
            break
        chosen=rng.choice(sorted(frontier))
        active.add(chosen)
        frontier.remove(chosen)
        frontier.update(adj[chosen]-active)

    mask=np.zeros((n,n), dtype=bool)
    for i in active:
        for r,c in orbits[i]:
            mask[r,c]=True
    return mask, orbits


def infer_color(local, bg=0):
    n=local.shape[0]
    orbits,_=all_orbits(n)
    best=None
    colors=[int(c) for c in np.unique(local) if int(c)!=bg]
    for color in colors:
        contradictions=0
        support=0
        count=int(np.count_nonzero(local==color))
        for orbit in orbits:
            vals=[int(local[r,c]) for r,c in orbit]
            if color in vals:
                support+=1
                if bg in vals:
                    contradictions+=1
        key=(contradictions, -support, -count, color)
        if best is None or key<best[0]:
            best=(key,color)
    return best[1]


def solve(grid):
    g=np.asarray(grid, dtype=int)
    bg=0
    pts=np.argwhere(g!=bg)
    r0,c0=pts.min(axis=0)
    r1,c1=pts.max(axis=0)
    n=r1-r0+1
    assert n==c1-c0+1
    local=g[r0:r1+1,c0:c1+1]
    fg=infer_color(local,bg)
    out=np.full_like(g,bg)
    orbits,_=all_orbits(n)
    for orbit in orbits:
        vals=[int(local[r,c]) for r,c in orbit]
        has_fg=fg in vals
        has_bg=bg in vals
        assert has_fg or has_bg
        assert not (has_fg and has_bg)
        fill=fg if has_fg else bg
        for r,c in orbit:
            out[r0+r,c0+c]=fill
    return out


def gen_once(rng):
    n=rng.randint(7,13)
    mask,orbits=make_template(rng,n)
    if not connected(mask):
        return None
    r0,c0,r1,c1=bbox(mask)
    if (r0,c0,r1,c1)!=(0,0,n-1,n-1):
        return None
    if mask.mean()<0.2 or mask.mean()>0.6:
        return None
    if np.count_nonzero(~mask)<8:
        return None
    colors=list(range(1,10))
    fg=rng.choice(colors)
    colors.remove(fg)
    rect_count=rng.randint(2,4)
    occ=np.zeros((n,n), dtype=bool)
    rects=[]
    for _ in range(200):
        occ.fill(False)
        rects.clear()
        num=rect_count
        blocked=np.zeros((n,n), dtype=bool)
        ok=True
        for k in range(num):
            placed=False
            for _ in range(100):
                h=rng.randint(1, max(1, min(4, n-3)))
                w=rng.randint(1, max(1, min(4, n-3)))
                rr=rng.randint(1, n-h-1)
                cc=rng.randint(1, n-w-1)
                if blocked[max(0,rr-1):min(n,rr+h+1), max(0,cc-1):min(n,cc+w+1)].any():
                    continue
                rects.append((rr,cc,h,w))
                occ[rr:rr+h, cc:cc+w]=True
                blocked[max(0,rr-1):min(n,rr+h+1), max(0,cc-1):min(n,cc+w+1)] = True
                placed=True
                break
            if not placed:
                ok=False
                break
        if not ok:
            continue
        if not (occ & mask).any() or not (occ & ~mask).any():
            continue
        if any(all(occ[r,c] for r,c in orbit) for orbit in orbits):
            continue
        visible_blue=np.count_nonzero(mask & ~occ)
        max_rect_area=max(h*w for _,_,h,w in rects)
        if visible_blue <= max_rect_area:
            continue
        break
    else:
        return None
    top,bottom,left,right=[rng.randint(1,4) for _ in range(4)]
    H=n+top+bottom; W=n+left+right
    grid=np.zeros((H,W), dtype=int)
    expected=np.zeros((H,W), dtype=int)
    grid[top:top+n, left:left+n][mask]=fg
    expected[top:top+n, left:left+n][mask]=fg
    for color,(rr,cc,h,w) in zip(rng.sample(colors,len(rects)), rects):
        grid[top+rr:top+rr+h, left+cc:left+cc+w]=color
    out=solve(grid)
    if not np.array_equal(out, expected):
        return None
    return grid, expected, fg

rng=random.Random(0)
count=0
for i in range(500):
    item=gen_once(rng)
    if item is None:
        continue
    count+=1
print('"'count', count)
assert count>300
print('ok')
