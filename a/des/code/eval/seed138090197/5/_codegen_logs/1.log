+        out[kr : kr + 2, kc : kc + 2] = BG
+        out[lr : lr + 2, lc : lc + 2] = np.array(
+            [[color, color], [color, int(key["inner"])]],
+            dtype=int,
+        )
+        fill_mask = (room_id == target_room) & (out == BG)
+        out[fill_mask] = int(key["inner"])
+
