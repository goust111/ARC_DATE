+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    n_objects = rng.randint(2, 4)
+    colors = rng.sample(list(STAMP_COLORS), n_objects)
+    side_groups = _assign_marker_sides(rng, n_objects)
