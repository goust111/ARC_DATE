+BG = 0
+FRAME = 5
+STAMP_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+SIDES = ("top", "bottom", "left", "right")
+GEN_ATTEMPTS = 400
+SHAPE_ATTEMPTS = 120
+REGION_ATTEMPTS = 120
