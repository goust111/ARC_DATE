+
+def _row_partition(rng: random.Random, n_items: int, n_rows: int) -> list[int]:
+    cuts = sorted(rng.sample(range(1, n_items), n_rows - 1))
+    sizes = []
+    prev = 0
+    for cut in cuts + [n_items]:
+        sizes.append(cut - prev)
+        prev = cut
+    return sizes
