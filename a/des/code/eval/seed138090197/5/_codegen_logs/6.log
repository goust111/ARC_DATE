+
+def _arrange_patches(rng: random.Random, patches: list[np.ndarray]) -> np.ndarray:
+    order = patches[:]
+    rng.shuffle(order)
+    row_count = rng.randint(1, min(3, len(order)))
+    row_sizes = _row_partition(rng, len(order), row_count)
