+
+
+def _random_stamp(rng: random.Random) -> np.ndarray:
+    for _ in range(SHAPE_ATTEMPTS):
+        target = rng.randint(3, 6)
+        cells = {(0, 0)}
+        while len(cells) < target:
+            frontier = {
+                (r + dr, c + dc)
+                for r, c in cells
+                for dr, dc in _neighbors4(0, 0)
+                if (r + dr, c + dc) not in cells
