+        dir_b = random.choice(DIRS)
+        flank_b = random.choice(PERPS[dir_b])
+        len_b = random.randint(TAIL_MIN, TAIL_MAX)
+        b = _build_arrow(shape, block_cell, dir_b, flank_b, len_b, colors[1])
+        if b is None:
