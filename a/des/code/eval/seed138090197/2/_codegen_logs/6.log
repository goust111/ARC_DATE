+    infos: list[dict[str, int | bool]] = []
+    prev = lo - 1
+    for next_cut in unique_cuts + [hi + 1]:
+        start = prev + 1
+        end = next_cut - 1
+        if start <= end:
+            broken_left = prev != lo - 1
+            broken_right = next_cut != hi + 1
+            shrunk_lo = start + (2 if broken_left else 0)
+            shrunk_hi = end - (2 if broken_right else 0)
+            infos.append(
