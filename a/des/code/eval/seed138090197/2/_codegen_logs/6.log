+def _segment_infos(path: dict[str, int | str], cuts: list[int]) -> list[dict[str, int | bool]]:
+    lo = int(path["lo"])
+    hi = int(path["hi"])
+    unique_cuts = sorted({int(cut) for cut in cuts if lo <= int(cut) <= hi})
