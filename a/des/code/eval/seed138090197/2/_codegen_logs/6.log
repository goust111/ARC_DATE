+BG = 0
+COLOR_POOL = tuple(range(1, 10))
+
+GRID_H_RANGE = (12, 18)
+GRID_W_RANGE = (12, 18)
+PATH_COUNT_RANGE = (3, 5)
+MIN_PATH_LEN = 5
+MAX_PATH_LEN = 9
