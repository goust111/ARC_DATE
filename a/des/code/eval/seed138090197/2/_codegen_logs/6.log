+
+
+def _canonicalize_paths(
+    paths: list[dict[str, int | str]]
+) -> dict[int, tuple[str, int, int, int]]:
+    return {
+        int(path["color"]): (
+            str(path["orient"]),
+            int(path["line"]),
+            int(path["lo"]),
+            int(path["hi"]),
