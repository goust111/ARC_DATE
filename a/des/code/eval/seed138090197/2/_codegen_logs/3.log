+        key_room_by_color[color] = room_id
+        key_positions.add((r, c))
+
+    open_doors = set()
+    for door in doors:
+        r, c = door["pos"]
+        if door["axis"] == "vertical":
+            room_a = int(room_labels[r, c - 1])
+            room_b = int(room_labels[r, c + 1])
+        else:
+            room_a = int(room_labels[r - 1, c])
+            room_b = int(room_labels[r + 1, c])
