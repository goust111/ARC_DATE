+            if color in (BLACK, WALL):
+                continue
+            vertical = (
+                grid[r - 1, c] == WALL
+                and grid[r + 1, c] == WALL
+                and grid[r, c - 1] != WALL
+                and grid[r, c + 1] != WALL
+            )
+            horizontal = (
+                grid[r, c - 1] == WALL
+                and grid[r, c + 1] == WALL
+                and grid[r - 1, c] != WALL
+                and grid[r + 1, c] != WALL
+            )
+            if vertical ^ horizontal:
+                doors.append({"pos": (r, c), "color": color, "axis": "vertical" if vertical else "horizontal"})
+            else:
+                keys.append((r, c, color))
+    return doors, keys
