+    closed_mask = g != WALL
+    for door in doors:
+        r, c = door["pos"]
+        closed_mask[r, c] = False
+    room_labels, _ = _label_components(closed_mask)
+
+    key_room_by_color: dict[int, int] = {}
+    key_positions = set()
+    for r, c, color in keys:
