+def _door_position(rect_a: tuple[int, int, int, int], rect_b: tuple[int, int, int, int]) -> tuple[int, int]:
+    ra0, ca0, ra1, ca1 = rect_a
+    rb0, cb0, rb1, cb1 = rect_b
+    if ra0 == rb0 and ra1 == rb1:
