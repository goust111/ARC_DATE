+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _find_separator_row(grid: np.ndarray) -> tuple[int, int]:
+    g = np.asarray(grid, dtype=int)
+    h, _w = g.shape
+    candidates = [
+        r
+        for r in range(1, h - 1)
+        if int(g[r, 0]) != BG and bool(np.all(g[r] == g[r, 0]))
+    ]
+    assert len(candidates) == 1, "expected one solid separator row"
+    row = int(candidates[0])
+    return row, int(g[row, 0])
+
+
+def _is_frame_component(coords: np.ndarray) -> bool:
+    r0, c0, r1, c1 = bbox_coords(coords)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return False
+    local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    local[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    border = np.zeros_like(local)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return bool(np.array_equal(local, border))
+
+
