+        patch = templates[color]
+        for pr, pc in np.argwhere(patch != BG):
+            rr = r + int(pr)
+            cc = c + int(pc)
+            if 0 <= rr < h and 0 <= cc < w:
+                out[rr, cc] = int(patch[pr, pc])
+    return out
