+    dst_h, dst_w = src_h, src_w
+    if mode == "row_only":
+        dst_h = _different_value(src_h)
+    elif mode == "col_only":
+        dst_w = _different_value(src_w)
+    elif mode == "both":
+        dst_h = _different_value(src_h)
+        dst_w = _different_value(src_w)
