+    sub = np.zeros((height, width), dtype=bool)
+    sub[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    expected = np.zeros_like(sub)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    if not np.array_equal(sub, expected):
+        return None
