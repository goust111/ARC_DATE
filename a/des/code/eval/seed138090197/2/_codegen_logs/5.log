+def _build_candidate() -> np.ndarray | None:
+    pair_count = random.choice(PAIR_COUNT_OPTIONS)
+    frame_colors = random.sample(COLOR_POOL, pair_count)
+    pair_modes = _sample_pair_modes(pair_count)
