+            off_axis_bonus = 2 if r != 0 and c != 0 else 0
+            interior_bonus = 1 if min_r < r < max_r and min_c < c < max_c else 0
+            weights.append(1 + 3 * neighbor_count + off_axis_bonus + interior_bonus)
