+            grid[seed_pos] = seed_colors[idx]
+            _mark_blocked(blocked, region_cells)
+            placed = True
+            break
+
+        if not placed:
+            return None
+
+    if not _valid_input(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GEN_ATTEMPTS):
