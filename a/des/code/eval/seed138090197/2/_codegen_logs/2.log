+def _mark_blocked(blocked: np.ndarray, cells: set[tuple[int, int]]) -> None:
+    h, w = blocked.shape
+    for r, c in cells:
+        for nr in range(r - 1, r + 2):
+            for nc in range(c - 1, c + 2):
+                if 0 <= nr < h and 0 <= nc < w:
+                    blocked[nr, nc] = True
+
