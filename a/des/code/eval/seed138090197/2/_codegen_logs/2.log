+ORTHOGONAL_PAIRS = (("U", "L"), ("U", "R"), ("D", "L"), ("D", "R"))
+OPPOSITE_PAIRS = (("U", "D"), ("L", "R"))
+CATEGORIES = ("plus", "tee", "corner", "corridor")
+GEN_ATTEMPTS = 400
