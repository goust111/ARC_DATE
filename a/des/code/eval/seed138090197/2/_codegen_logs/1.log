+
+    try:
+        produced = main(grid)
+    except AssertionError:
+        return None
+    if not np.array_equal(produced, solved):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
