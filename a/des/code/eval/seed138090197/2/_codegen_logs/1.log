+import numpy as np
+from collections import deque
+
+
+_RNG = np.random.default_rng()
+_GEN_RETRIES = 400
+
+_BG = 0
+_FRAME = 5
+_PALETTE = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)
+_DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
