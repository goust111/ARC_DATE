+    all_coords = np.asarray(list(pixels.keys()), dtype=int)
+    min_r, min_c = all_coords.min(axis=0)
+    max_r, max_c = all_coords.max(axis=0)
+    out = np.full((max_r - min_r + 1, max_c - min_c + 1), int(bg), dtype=int)
