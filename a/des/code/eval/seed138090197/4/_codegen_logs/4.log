+def _compose_output(objects: list[dict[str, object]], layers: list[int], bg: int) -> np.ndarray:
+    rank = {color: i for i, color in enumerate(layers)}
+    ordered = sorted(
+        objects,
+        key=lambda obj: (
+            rank[int(obj["color"])],
+            int(obj["bbox"][0]),
+            int(obj["bbox"][1]),
