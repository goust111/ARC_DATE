+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[counts.argmax()])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(np.asarray(coords, dtype=int))
+    return out
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1]
+
+
+def _has_hole(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    bg = ~mask
+    seen = np.zeros((h, w), dtype=bool)
+    q = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if bg[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if bg[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+    while q:
+        rr, cc = q.popleft()
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr = rr + dr
+            nc = cc + dc
+            if 0 <= nr < h and 0 <= nc < w and bg[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
+    return bool(np.any(bg & (~seen)))
+
+
+def _border_color(patch: np.ndarray, depth: int) -> int | None:
+    n = patch.shape[0]
+    r0 = depth
+    c0 = depth
+    r1 = n - 1 - depth
+    c1 = n - 1 - depth
+    vals = set(map(int, patch[r0, c0 : c1 + 1]))
+    vals.update(map(int, patch[r1, c0 : c1 + 1]))
+    vals.update(map(int, patch[r0 : r1 + 1, c0]))
+    vals.update(map(int, patch[r0 : r1 + 1, c1]))
+    if len(vals) != 1:
+        return None
+    return next(iter(vals))
+
+
+def _template_layers(patch: np.ndarray, bg: int) -> list[int] | None:
+    if patch.ndim != 2 or patch.shape[0] != patch.shape[1] or patch.shape[0] < 3:
+        return None
+    if np.any(patch == bg):
+        return None
+    n = patch.shape[0]
+    layers: list[int] = []
+    for depth in range((n + 1) // 2):
+        color = _border_color(patch, depth)
+        if color is None:
+            return None
+        if layers and color == layers[-1]:
+            return None
+        layers.append(int(color))
+    if len(layers) < 2:
+        return None
+    return layers
+
