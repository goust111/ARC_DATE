+    stem_w = random.randint(1, min(2, w))
+    mask[:bar_h, :] = True
+    col = random.randrange(w - stem_w + 1)
+    mask[:, col : col + stem_w] = True
+    return mask
+
+
+def _l_mask() -> np.ndarray:
