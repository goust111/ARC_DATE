+    placed = _place_objects(h, w, bg, template, corner, mode, layer_colors, counts)
+    if placed is None:
+        return None
+    grid, objects = placed
+
+    out = _compose_output(objects, layer_colors, bg)
+    rev = _compose_output(objects, list(reversed(layer_colors)), bg)
