+        coords = np.asarray(obj["coords"], dtype=int)
+        ar, ac = obj["anchor"]
+        rel = coords - np.array([[ar, ac]], dtype=int)
+        for rr, cc in rel:
+            pixels[(int(rr), int(cc))] = color
