+    groups = sorted(specs[1:], key=lambda spec: (int(spec["bbox_h"]) * int(spec["bbox_w"]), sum(spec["lengths"])), reverse=True)
+    for spec in groups:
+        placed = False
+        starts: list[tuple[int, int]] = []
+        max_r = h - int(spec["bbox_h"])
