+        random.shuffle(order)
+        depths = [int(depth_by_id[node_id]) for node_id in order]
+        if not _is_monotone_depths(depths):
+            return order
+    return order
+
+
+def _render_expected(root: dict[str, Any], bg: int, legend_order: list[int]) -> np.ndarray:
