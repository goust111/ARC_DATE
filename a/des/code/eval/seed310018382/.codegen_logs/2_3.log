+
+def _background_color(grid: np.ndarray) -> int:
+    corners = {
+        int(grid[0, 0]),
+        int(grid[0, -1]),
+        int(grid[-1, 0]),
+        int(grid[-1, -1]),
+    }
+    if len(corners) == 1:
+        return next(iter(corners))
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
