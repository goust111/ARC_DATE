+def _sample_mask(size: int, rule: str, *, require_unique: bool) -> np.ndarray | None:
+    min_area = max(4, size)
+    max_area = min(size * size - 4, size * size - 1)
+    if min_area > max_area:
+        return None
+    for _ in range(200):
