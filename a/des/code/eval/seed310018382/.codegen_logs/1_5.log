+        k = obj["scale"]
+        for pr, pc in obj["path"]:
+            rr0 = r0 + pr * k
+            cc0 = c0 + pc * k
+            out[rr0 : rr0 + k, cc0 : cc0 + k] = int(grey)
+    return out
+
