+    bg = _corner_bg(g)
+    sep_r, grey = _find_separator(g, bg)
+    top = g[:sep_r]
+    bottom = g[sep_r + 1 :]
+
+    top_colors = set(map(int, np.unique(top))) - {int(bg), int(grey)}
+    bottom_colors = set(map(int, np.unique(bottom))) - {int(bg), int(grey)}
+    assert top_colors
+    assert top_colors == bottom_colors
