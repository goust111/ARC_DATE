+    pts = np.argwhere(region == color)
+    assert pts.size > 0
+    r0, c0, r1, c1 = _bbox(pts)
+    patch = region[r0 : r1 + 1, c0 : c1 + 1]
+    assert bool((patch == color).all())
+    assert int(pts.shape[0]) == int(patch.size)
+    return int(r0), int(c0), int(r1), int(c1)
