+        border.add((r, c0))
+        border.add((r, c1))
+
+    if not points.issubset(border):
+        return None
+    if len(points) != len(border) - 1:
+        return None
+
+    missing = list(border - points)
+    if len(missing) != 1:
+        return None
+    gap_r, gap_c = missing[0]
