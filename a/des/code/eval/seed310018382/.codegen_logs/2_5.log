+def _build_base_shapes() -> list[np.ndarray]:
+    shapes = [
+        _square(3),
+        _square(5),
+        _plus(1, 1),
+        _plus(1, 2),
+        _plus(1, 3),
+        _plus(3, 1),
+        _plus(3, 2),
+        _diamond(1),
+        _diamond(2),
+        _diamond(3),
+        _ring(3),
+        _ring(5),
+        _ring(7),
+        _octagon(5, 1),
+        _octagon(7, 1),
+        _octagon(7, 2),
