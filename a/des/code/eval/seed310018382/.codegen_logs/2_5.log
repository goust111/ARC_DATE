+def _find_rooms(grid: np.ndarray, bg: int) -> list[dict]:
+    rooms: list[dict] = []
+    for color in map(int, np.unique(grid)):
+        if color == bg:
+            continue
+        for coords in _components(grid == color):
+            info = _room_info(coords)
+            if info is None:
