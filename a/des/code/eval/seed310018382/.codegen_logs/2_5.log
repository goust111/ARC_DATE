+DIRECTIONS = ("up", "down", "left", "right")
+
+GRID_HEIGHT_RANGE = (24, 36)
+GRID_WIDTH_RANGE = (24, 36)
+ROOM_COUNT_RANGE = (2, 4)
+INNER_HEIGHT_RANGE = (5, 8)
+INNER_WIDTH_RANGE = (5, 8)
+ROOM_SPACING_PAD = 2
