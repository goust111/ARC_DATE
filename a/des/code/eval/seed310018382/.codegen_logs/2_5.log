+    outer_w = inner_w + 2
+
+    grid[top, left : left + outer_w] = ROOM_COLOR
+    grid[top + outer_h - 1, left : left + outer_w] = ROOM_COLOR
+    grid[top : top + outer_h, left] = ROOM_COLOR
+    grid[top : top + outer_h, left + outer_w - 1] = ROOM_COLOR
+
+    if direction == "up":
