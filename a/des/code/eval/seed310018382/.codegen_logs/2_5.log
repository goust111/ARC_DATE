+
+
+def _build_base_shapes() -> list[np.ndarray]:
+    shapes = [
+        _square(3),
+        _square(5),
+        _plus(1, 1),
+        _plus(1, 2),
+        _plus(1, 3),
+        _plus(3, 1),
+        _plus(3, 2),
+        _diamond(1),
+        _diamond(2),
+        _diamond(3),
+        _ring(3),
+        _ring(5),
+        _ring(7),
+        _octagon(5, 1),
+        _octagon(7, 1),
+        _octagon(7, 2),
+    ]
+    out: list[np.ndarray] = []
+    seen: set[tuple[int, int, bytes]] = set()
+    for shape in shapes:
+        if not _is_hv_symmetric(shape):
+            continue
+        center_r = shape.shape[0] // 2
+        center_c = shape.shape[1] // 2
+        if not (
