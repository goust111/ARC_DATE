    rr1, cc1 = max(rows), max(cols)
    assert rr1 - rr0 == 1 and cc1 - cc0 == 1, "marker must occupy a 2x2 block"
    rel = {(int(r - rr0), int(c - cc0)) for r, c in pts}
    missing = ({(0, 0), (0, 1), (1, 0), (1, 1)} - rel).pop()
