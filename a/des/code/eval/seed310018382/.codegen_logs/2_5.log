+        if not _is_hv_symmetric(reduced):
+            continue
+        _, (rr0, cc0, rr1, cc1) = _tight_crop(reduced)
+        if int(r) < rr0:
+            candidates.append("up")
+        elif int(r) > rr1:
+            candidates.append("down")
+        elif int(c) < cc0:
+            candidates.append("left")
+        elif int(c) > cc1:
+            candidates.append("right")
