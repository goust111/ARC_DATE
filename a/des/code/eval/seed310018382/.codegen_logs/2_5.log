+
+def _translation_for_room(room_bbox: tuple[int, int, int, int], direction: str) -> tuple[int, int]:
+    r0, c0, r1, c1 = room_bbox
+    inner_h = r1 - r0 - 1
+    inner_w = c1 - c0 - 1
+    if direction == "up":
+        return -(inner_h + 1), 0
+    if direction == "down":
+        return inner_h + 1, 0
+    if direction == "left":
+        return 0, -(inner_w + 1)
+    assert direction == "right"
+    return 0, inner_w + 1
