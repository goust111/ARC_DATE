0012: def main(grid: np.ndarray) -> np.ndarray:
0013:     """
0014:     Recolor wall-separated background regions alternately, starting with grey in the lower-left region.
0015: 
0016:     Input structure
0017:     - The grid has one dominant background color and one foreground wall color.
0018:     - The wall pixels form one or more 4-connected one-cell-thick segments.
0019:     - Each wall segment separates exactly two 4-connected background regions.
0020:     Rule
0021:     - Keep all wall pixels unchanged.
0022:     - Label the 4-connected background regions and connect two labels when they
0023:       touch opposite sides of the same wall segment.
0024:     - Color the region containing the lower-left corner grey, then flip between
0025:       grey and green across every wall adjacency.
0026:     Key insight
0027:     - The red walls define a bipartite map of regions; the lower-left background
0028:       region fixes which side of the alternating coloring is grey.
0029:     """
0030:     g = np.asarray(grid, dtype=int)
0031:     assert g.ndim == 2
0032:     H, W = g.shape
0033: 
0034:     colors = set(map(int, g.flat))
0035:     assert len(colors) == 2, "expected exactly one background color and one wall color"
0036:     bg = get_bg(g)
0037:     wall_colors = colors - {int(bg)}
0038:     assert len(wall_colors) == 1
0039:     wall = int(next(iter(wall_colors)))
0040: 
0041:     bg_lab, n_regions = label_mask(g == int(bg), connectivity=4)
0042:     assert n_regions >= 2, "walls must split the background into multiple regions"
0043:     start_region = int(bg_lab[H - 1, 0])
0044:     assert start_region > 0, "lower-left corner must belong to a background region"
0045: 
0046:     wall_lab, n_walls = label_mask(g == wall, connectivity=4)
0047:     assert n_walls >= 1
0048: 
0049:     graph: dict[int, set[int]] = defaultdict(set)
0050:     for wall_id in range(1, n_walls + 1):
0051:         adjacent_regions: set[int] = set()
0052:         for r, c in np.argwhere(wall_lab == wall_id):
0053:             for rr, cc in neighbors4(int(r), int(c)):
0054:                 if 0 <= rr < H and 0 <= cc < W:
0055:                     region_id = int(bg_lab[rr, cc])
0056:                     if region_id > 0:
0057:                         adjacent_regions.add(region_id)
0058: 
0059:         assert len(adjacent_regions) == 2, "each wall segment must separate exactly two regions"
0060:         a, b = tuple(adjacent_regions)
0061:         graph[a].add(b)
0062:         graph[b].add(a)
0063: 
0064:     parity = {start_region: 0}
0065:     queue = deque([start_region])
0066:     while queue:
0067:         region = queue.popleft()
0068:         for neighbor in graph[region]:
0069:             neighbor_parity = 1 - parity[region]
0070:             if neighbor in parity:
0071:                 assert parity[neighbor] == neighbor_parity, "region graph must be bipartite"
0072:             else:
0073:                 parity[neighbor] = neighbor_parity
0074:                 queue.append(neighbor)
0075: 
0076:     assert set(parity) == set(range(1, n_regions + 1)), "all background regions must be wall-connected"
0077: 
0078:     out = g.copy()
0079:     for region_id, region_parity in parity.items():
0080:         out[bg_lab == region_id] = Color.GREY if region_parity == 0 else Color.GREEN
0081:     return out
0082: 
