+    mask = np.asarray(mask, dtype=bool)
+    assert mask.any(), "pattern mask must be non-empty"
+    pts = np.argwhere(mask)
+    candidates: list[str] = []
+    for r, c in pts:
+        reduced = mask.copy()
+        reduced[int(r), int(c)] = False
+        if not reduced.any():
