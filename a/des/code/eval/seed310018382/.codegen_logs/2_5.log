+def _room_total_bbox(top: int, left: int, inner_h: int, inner_w: int, direction: str) -> tuple[int, int, int, int]:
+    outer_h = inner_h + 2
+    outer_w = inner_w + 2
+    if direction == "up":
+        return top - inner_h, left, top + outer_h - 1, left + outer_w - 1
+    if direction == "down":
