+    center_c = w // 2
+    if direction == "up":
+        out = np.zeros((h + 1, w), dtype=bool)
+        out[1:, :] = base
+        out[0, center_c] = True
+        return out
+    if direction == "down":
+        out = np.zeros((h + 1, w), dtype=bool)
+        out[:-1, :] = base
+        out[h, center_c] = True
+        return out
