+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is None:
+            continue
+        try:
+            main(grid)
+        except AssertionError:
+            continue
+        return grid
+    raise RuntimeError("failed to generate a valid room-copy input")

