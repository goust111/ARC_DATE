+def _bbox_is_free(occupied: np.ndarray, bbox: tuple[int, int, int, int], pad: int) -> bool:
+    h, w = occupied.shape
+    r0, c0, r1, c1 = bbox
+    if not (0 <= r0 <= r1 < h and 0 <= c0 <= c1 < w):
+        return False
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h - 1, r1 + pad)
+    cc1 = min(w - 1, c1 + pad)
+    return not bool(occupied[rr0 : rr1 + 1, cc0 : cc1 + 1].any())
+
