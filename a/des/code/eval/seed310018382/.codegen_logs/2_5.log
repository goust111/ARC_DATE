+import random
+
+import numpy as np
+
+
+BG = 0
+ROOM_COLOR = 8
+PATTERN_COLORS = tuple(color for color in range(1, 10) if color != ROOM_COLOR)
+DIRECTIONS = ("up", "down", "left", "right")
+
+GRID_HEIGHT_RANGE = (24, 36)
+GRID_WIDTH_RANGE = (24, 36)
+ROOM_COUNT_RANGE = (2, 4)
