+
+def _shape_key(mask: np.ndarray) -> tuple[int, int, bytes]:
+    tight, _ = _tight_crop(mask)
+    return int(tight.shape[0]), int(tight.shape[1]), tight.tobytes()
+
+
+def _square(size: int) -> np.ndarray:
+    return np.ones((size, size), dtype=bool)
+
+
+def _plus(core: int, arm: int) -> np.ndarray:
+    size = core + 2 * arm
+    mask = np.zeros((size, size), dtype=bool)
+    start = arm
+    mask[:, start : start + core] = True
+    mask[start : start + core, :] = True
+    return mask
+
+
+def _diamond(radius: int) -> np.ndarray:
+    size = 2 * radius + 1
+    center = radius
+    mask = np.zeros((size, size), dtype=bool)
+    for r in range(size):
+        for c in range(size):
+            if abs(r - center) + abs(c - center) <= radius:
+                mask[r, c] = True
+    return mask
+
+
+def _ring(size: int) -> np.ndarray:
+    mask = np.ones((size, size), dtype=bool)
+    mask[1:-1, 1:-1] = False
+    return mask
+
+
+def _octagon(size: int, cut: int) -> np.ndarray:
+    mask = np.ones((size, size), dtype=bool)
+    for rr in range(cut):
+        for cc in range(cut - rr):
+            cells = [
+                (rr, cc),
+                (rr, size - 1 - cc),
+                (size - 1 - rr, cc),
+                (size - 1 - rr, size - 1 - cc),
+            ]
+            for r, c in cells:
+                mask[r, c] = False
+    return mask
+
+
+def _build_base_shapes() -> list[np.ndarray]:
+    shapes = [
+        _square(3),
+        _square(5),
+        _plus(1, 1),
+        _plus(1, 2),
+        _plus(1, 3),
+        _plus(3, 1),
+        _plus(3, 2),
+        _diamond(1),
+        _diamond(2),
+        _diamond(3),
+        _ring(3),
+        _ring(5),
+        _ring(7),
+        _octagon(5, 1),
+        _octagon(7, 1),
+        _octagon(7, 2),
+    ]
+    out: list[np.ndarray] = []
+    seen: set[tuple[int, int, bytes]] = set()
+    for shape in shapes:
