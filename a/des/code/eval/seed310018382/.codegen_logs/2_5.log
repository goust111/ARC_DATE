+        out[:-1, :] = base
+        out[h, center_c] = True
+        return out
+    if direction == "left":
+        out = np.zeros((h, w + 1), dtype=bool)
+        out[:, 1:] = base
+        out[center_r, 0] = True
+        return out
+    out = np.zeros((h, w + 1), dtype=bool)
+    out[:, :-1] = base
+    out[center_r, w] = True
+    return out
