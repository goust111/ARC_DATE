+def _bbox_is_free(occupied: np.ndarray, bbox: tuple[int, int, int, int], pad: int) -> bool:
+    h, w = occupied.shape
+    r0, c0, r1, c1 = bbox
+    if not (0 <= r0 <= r1 < h and 0 <= c0 <= c1 < w):
+        return False
