0238:         node = _Node(
0239:             coords=coords,
0240:             bbox=tuple(map(int, comp["bbox"])),
0241:             center=coords.mean(axis=0),
0242:         )
0243:         node_holes = _component_holes(g.shape, coords)
0244:         node.is_frame = bool(node_holes)
0245:         nodes.append(node)
0246:         holes.append(node_holes)
0247: 
0248:     assert any(node.is_frame for node in nodes)
0249:     for node_i, node in enumerate(nodes):
0250:         containers = []
0251:         for frame_i, frame in enumerate(nodes):
