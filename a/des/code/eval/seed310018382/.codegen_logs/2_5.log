+    max_row_offset = inner_h - ph
+    max_col_offset = inner_w - pw
+    row_offset = rng.randint(0, max_row_offset)
+    col_offset = rng.randint(0, max_col_offset)
+    inner_top = top + 1 + row_offset
+    inner_left = left + 1 + col_offset
