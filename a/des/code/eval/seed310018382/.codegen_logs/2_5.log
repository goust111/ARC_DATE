+def _sample_pattern(inner_h: int, inner_w: int, direction: str, rng: random.Random) -> np.ndarray | None:
+    candidates: list[np.ndarray] = []
+    for base in BASE_SHAPES:
+        mask = _add_protrusion(base, direction)
