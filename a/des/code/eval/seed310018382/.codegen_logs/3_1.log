+        k = rng.randrange(4)
+        mask = np.rot90(mask, k)
+        return _trim(mask)
+
+    h = rng.randint(2, 4)
+    w = rng.randint(2, 4)
+    total = h * w
+    target = rng.randint(max(3, total // 2), total - 1)
+    cells = {(rng.randrange(h), rng.randrange(w))}
+    while len(cells) < target:
