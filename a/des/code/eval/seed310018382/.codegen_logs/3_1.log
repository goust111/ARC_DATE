+def _frame_signature(coords: list[tuple[int, int]]) -> tuple[bool, tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
