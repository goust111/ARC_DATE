+    for _ in range(trials):
+        top = rng.randint(1, h - height - 1)
+        left = rng.randint(1, w - width - 1)
+        if _can_place(occ, top, left, height, width):
+            _mark_place(occ, top, left, height, width)
+            return top, left
+    return None
