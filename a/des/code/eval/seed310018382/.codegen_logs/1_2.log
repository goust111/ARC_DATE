+            if blocked[r0 : r0 + ph, c0 : c0 + pw].any():
+                continue
+            places.append((r0, c0))
+    if not places:
+        return None
+    return random.choice(places)
+
+
+def _make_piece(mask: np.ndarray, color: int) -> np.ndarray:
+    rot = np.rot90(mask, random.randint(0, 3))
+    patch = np.full(rot.shape, BG, dtype=int)
+    patch[rot] = int(color)
