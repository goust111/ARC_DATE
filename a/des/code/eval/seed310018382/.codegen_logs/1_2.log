+
+def _rotate_masks(mask: np.ndarray) -> list[np.ndarray]:
+    out: list[np.ndarray] = []
+    seen = set()
+    for k in range(4):
+        cur = np.rot90(mask, k)
+        key = (cur.shape, cur.tobytes())
+        if key in seen:
+            continue
+        seen.add(key)
+        out.append(cur)
+    return out
+
+
+def _canonical_key(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    return min((cur.shape, cur.tobytes()) for cur in _rotate_masks(mask))
