+    c = left_pad
+    for color, radius in zip(colors, radii):
+        grid[0, c] = int(color)
+        c += 1 + int(radius)
+    for color, (r, c) in zip(colors, seeds):
+        grid[r, c] = int(color)
+    return grid
+
+
+def _candidate_ok(
+    grid: np.ndarray,
+    colors: list[int],
+    seeds: list[tuple[int, int]],
+    radii: list[int],
+    mode: str,
+    overlap_pair: tuple[int, int] | None,
