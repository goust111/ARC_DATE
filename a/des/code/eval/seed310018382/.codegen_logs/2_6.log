+        r0 = max(hi_box[0], lo_box[0])
+        r1 = min(hi_box[1], lo_box[1])
+        c0 = max(hi_box[2], lo_box[2])
+        c1 = min(hi_box[3], lo_box[3])
+        if not np.all(out[r0 : r1 + 1, c0 : c1 + 1] == int(colors[hi_idx])):
