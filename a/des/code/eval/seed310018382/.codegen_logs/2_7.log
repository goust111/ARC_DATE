import itertools, numpy as np

def neigh4(rc):
    r,c=rc
    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
        yield r+dr,c+dc

def connected(cells):
    cells=set(cells)
    stack=[next(iter(cells))]
    seen={stack[0]}
    while stack:
        cur=stack.pop()
        for nb in neigh4(cur):
            if nb in cells and nb not in seen:
                seen.add(nb); stack.append(nb)
    return seen==cells

def tight_mask(cells):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    r0=min(rs); c0=min(cs)
    h=max(rs)-r0+1; w=max(cs)-c0+1
    arr=np.zeros((h,w),dtype=int)
    for r,c in cells: arr[r-r0,c-c0]=1
    return arr

def key(a): return tuple(map(tuple,a.tolist()))
lib=[]
seen=set()
for h in range(2,4):
  for w in range(2,4):
    pts=[(r,c) for r in range(h) for c in range(w)]
    for k in range(3,6):
      for comb in itertools.combinations(pts,k):
        if not connected(comb):
          continue
        arr=tight_mask(comb)
        if arr.shape"'!=(h,w):
          continue
        trans=[arr, np.fliplr(arr), np.flipud(arr), np.rot90(arr,2)]
        if any(np.array_equal(arr,t) for t in trans[1:]):
          continue
        canon=min(key(t) for t in trans)
        if canon in seen:
          continue
        seen.add(canon)
        lib.append(arr)
print('"'count',len(lib))
for arr in lib:
    print(arr.shape,'\\n',arr)
