import itertools, random
import numpy as np

BG=0
CORNER_COLORS=(2,1,3,4)
TRANSFORM_BY_COLOR={2:'identity',1:'hflip',3:'vflip',4:'rot180'}
REGION_OWNER={'top':'tl','right':'tr','bottom':'br','left':'bl'}


def region_map(h,w):
    reg=np.empty((h,w),dtype=object)
    for r in range(h):
        for c in range(w):
            if (r,c) in ((0,0),(0,w-1),(h-1,0),(h-1,w-1)):
                reg[r,c]='corner'
                continue
            y=r/(h-1)
            x=c/(w-1)
            if abs(y-x)<1e-9 or abs(y-(1-x))<1e-9:
                reg[r,c]='boundary'
            elif y < x and y < 1-x:
                reg[r,c]='top'
            elif y > x and y > 1-x:
                reg[r,c]='bottom'
            elif y > x and y < 1-x:
                reg[r,c]='left'
            else:
                reg[r,c]='right'
    return reg

for h,w in [(11,11),(11,15),(15,11),(13,17),(17,13)]:
    reg=region_map(h,w)
    counts={k:int((reg==k).sum()) for k in ['top','right','bottom','left','boundary']}
    print((h,w),counts)
