CYCLE_COUNT_CHOICES = [1, 2]             # independent cycles in the graph
PATH_LEN_CHOICES = [2, 3]               # shortest-path edge count between terminals
GAP_CHOICES = [2, 3]                     # gap between node square edge and cell boundary
