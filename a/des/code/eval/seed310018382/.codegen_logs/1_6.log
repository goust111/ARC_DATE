+
+def _get_bg(grid: np.ndarray) -> int:
+    corners = [
+        int(grid[0, 0]),
+        int(grid[0, -1]),
+        int(grid[-1, 0]),
+        int(grid[-1, -1]),
+    ]
+    if len(set(corners)) == 1:
+        return int(corners[0])
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
