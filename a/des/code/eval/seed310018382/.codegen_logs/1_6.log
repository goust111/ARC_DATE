+            if int(pts.shape[0]) < 8:
+                continue
+            r0, c0, r1, c1 = _bbox(pts)
+            if r1 - r0 < 2 or c1 - c0 < 2:
+                continue
+            if set(map(tuple, pts.tolist())) != _frame_cells(r0, c0, r1, c1):
+                continue
