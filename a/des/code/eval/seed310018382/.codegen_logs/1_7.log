+    right = random.randint(MIN_MARGIN, MAX_MARGIN)
+
+    height = top + max_r + 1 + bottom
+    width = left + max_c + 1 + right
+    if height > MAX_GRID_SIDE or width > MAX_GRID_SIDE:
+        return None
+
+    shifted: list[dict[str, int]] = []
+    for rect in rectangles:
+        shifted.append(
