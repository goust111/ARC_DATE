+MAX_GEN_TRIES = 500
+
+
+def _find_anchors(grid: np.ndarray) -> list[dict[str, int]]:
+    mask = grid == ORANGE
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    anchors: list[dict[str, int]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
