+
+BG = 0
+GREY = 5
+ORANGE = 7
+RECT_COLORS = (1, 2, 3, 4, 6, 8, 9)
+LAYER_LENGTHS = (1, 2, 3, 4, 5)
+
+MIN_RECT_COUNT = 2
+MAX_RECT_COUNT = 5
+MIN_RECT_HEIGHT = 5
