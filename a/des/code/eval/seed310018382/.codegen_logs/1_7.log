+
+    return {
+        "r0": int(r0),
+        "c0": int(c0),
+        "r1": int(r1),
+        "c1": int(c1),
+        "color": int(color),
+        "layer": int(layer),
+    }
+
+
+def _append_horizontal(prev: dict[str, int], layer: int, color: int) -> dict[str, int] | None:
