+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_TRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid overlap-filter puzzle")

