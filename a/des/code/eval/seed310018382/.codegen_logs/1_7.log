+                "c0": int(c0),
+                "r1": int(bottom),
+                "c1": int(right),
+                "color": int(color),
+                "layer": int(layer),
+            }
+        )
+
+    return rectangles
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Resolve grey overlap cells by painting each rectangle in ascending anchor-length order.
+    """
