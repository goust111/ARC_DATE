+    shifted = _shift_rectangles(rectangles)
+    if shifted is None:
+        return None
+    rectangles, shape = shifted
+
+    rendered = _render_pair(rectangles, shape)
+    if rendered is None:
+        return None
+    inp, out = rendered
+
+    try:
+        if np.array_equal(main(inp), out):
+            return inp
+    except AssertionError:
