+                "r0": int(rect["r0"]) + top,
+                "c0": int(rect["c0"]) + left,
+                "r1": int(rect["r1"]) + top,
+                "c1": int(rect["c1"]) + left,
+                "color": int(rect["color"]),
+                "layer": int(rect["layer"]),
+            }
+        )
+
+    return shifted, (height, width)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rect_count = random.randint(MIN_RECT_COUNT, MAX_RECT_COUNT)
