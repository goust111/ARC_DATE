+        path = _trace_ray(
+            g.shape,
+            source["endpoint"],  # type: ignore[arg-type]
+            source["direction"],  # type: ignore[arg-type]
+            absorbers_by_color.get(int(source["color"]), set()),
+        )
+        for cell in path:
