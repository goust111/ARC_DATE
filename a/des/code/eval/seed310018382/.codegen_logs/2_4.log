+        "coords": coords,
+        "endpoint": endpoint,
+        "direction_name": direction,
+        "direction": DIRS[direction],
+        "orientation": orientation,
+        "line": int(line),
+    }
+
+
+def _absorber_candidates(
+    source: dict[str, object],
+    required_lines: list[int],
+    occupied: np.ndarray,
+) -> list[tuple[int, int]]:
