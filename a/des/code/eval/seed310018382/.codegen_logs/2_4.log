+    endpoint_r, endpoint_c = template["endpoint"]
+
+    if direction == "right":
+        top = int(line - endpoint_r)
+        left = 0
+        orientation = "H"
+    elif direction == "left":
+        top = int(line - endpoint_r)
+        left = int(w - 3)
+        orientation = "H"
