+        {"cells": ((0, 0), (0, 1), (1, 1), (2, 1)), "endpoint": (2, 1)},
+    ],
+    "up": [
+        {"cells": ((0, 0), (1, 0), (2, 0), (2, 1)), "endpoint": (0, 0)},
