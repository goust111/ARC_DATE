+        ((2, 1), (2, 2)),
+        ((1, 1), (2, 1)),
+        ((2, 1), (3, 1)),
+    ),
+    "line3": (
+        ((2, 0), (2, 1), (2, 2)),
+        ((1, 1), (2, 1), (3, 1)),
+    ),
+    "el": (
+        ((1, 1), (2, 1), (2, 2)),
+        ((2, 1), (2, 2), (3, 1)),
+        ((2, 0), (2, 1), (3, 1)),
+        ((1, 1), (2, 0), (2, 1)),
+    ),
+}
