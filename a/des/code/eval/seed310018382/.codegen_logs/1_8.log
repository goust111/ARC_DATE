+
+BG = 0
+LOCK = 9
+DOOR_H = 5
+DOOR_W = 5
+ZONE_H = 5
+ZONE_W = 3
+GENERATION_ATTEMPTS = 400
+
+CANONICAL_SHAPES: dict[str, tuple[tuple[int, int], ...]] = {
+    "domino": ((0, 0), (0, 1)),
+    "line3": ((0, 0), (0, 1), (0, 2)),
+    "el": ((0, 0), (1, 0), (1, 1)),
+}
