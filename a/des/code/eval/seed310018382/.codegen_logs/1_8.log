+            lock_coords_abs = [
+                (r0 + rr, c0 + 1 + cc)
+                for rr, cc in zip(*np.where(lock_mask))
+            ]
+            door = {
+                "top": int(r0),
+                "left": int(c0),
+                "right": int(c0 + 4),
+                "color": int(color),
+                "center_col": int(c0 + 2),
+                "lock_shape": _normalize(lock_coords_abs),
+                "frame_cells": [(r0 + rr, c0) for rr in range(DOOR_H)] + [(r0 + rr, c0 + 4) for rr in range(DOOR_H)],
+                "lock_cells": lock_coords_abs,
+            }
+            doors.append(door)
