+    out = g.copy()
+    for points in _components(g != bg):
+        if not _is_rectangular_frame(points):
+            continue
+        orientation = _interior_l_orientation(g, bg, points)
+        new_color = palette[orientation]
+        for r, c in points:
+            out[r, c] = new_color
