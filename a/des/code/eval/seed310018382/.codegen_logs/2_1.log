+def _frame_marker_top_left(top: int, left: int, height: int, width: int) -> tuple[int, int]:
+    inner_h = height - 2
+    inner_w = width - 2
+    return top + 1 + inner_h // 2 - 1, left + 1 + inner_w // 2 - 1
