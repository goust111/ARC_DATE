+def _can_place(occupied: np.ndarray, top: int, left: int, height: int, width: int) -> bool:
+    h, w = occupied.shape
+    r0 = max(0, top - 1)
+    c0 = max(0, left - 1)
+    r1 = min(h, top + height + 1)
+    c1 = min(w, left + width + 1)
+    return not occupied[r0:r1, c0:c1].any()
