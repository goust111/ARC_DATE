 101: def _valid_run_lengths(width: int, n_runs: int) -> list[tuple[int, ...]]:
 102:     length_range = range(RUN_LENGTH_MIN, RUN_LENGTH_MAX + 1)
 103:     return [
 104:         tuple(int(x) for x in lengths)
 105:         for lengths in product(length_range, repeat=int(n_runs))
 106:         if sum(lengths) == int(width)
 107:     ]
 108: 
 109: 
 110: def _run_colors(colors: list[int], n_runs: int) -> list[int]:
 111:     seq: list[int] = []
 112:     unused = set(colors)
 113:     for i in range(int(n_runs)):
 114:         slots_left = int(n_runs) - i
 115:         choices = [c for c in colors if not seq or c != seq[-1]]
 116:         if len(unused) >= slots_left:
 117:             choices = [c for c in choices if c in unused]
 118:         elif unused and random.random() < UNUSED_COLOR_BIAS:
 119:             preferred = [c for c in choices if c in unused]
 120:             if preferred:
 121:                 choices = preferred
 122:         color = random.choice(choices)
 123:         seq.append(int(color))
 124:         unused.discard(int(color))
 125:     return seq
 126: 
 127: 
 128: def _palette_row(width: int, colors: list[int]) -> np.ndarray:
 129:     valid_counts = [
 130:         n_runs for n_runs in RUN_COUNT_OPTIONS if _valid_run_lengths(int(width), n_runs)
 131:     ]
 132:     n_runs = random.choice(valid_counts)
 133:     valid_lengths = _valid_run_lengths(int(width), n_runs)
 134:     lengths = random.choice(valid_lengths)
 135:     n_distinct = random.randint(
 136:         COLUMN_COLOR_DISTINCT_MIN, min(COLUMN_COLOR_DISTINCT_MAX, n_runs)
 137:     )
 138:     chosen = random.sample(colors, n_distinct)
 139:     seq = _run_colors(chosen, n_runs)
 140:     return np.repeat(seq, lengths).astype(int)

