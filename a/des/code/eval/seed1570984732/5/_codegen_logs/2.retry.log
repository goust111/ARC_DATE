+                            "u": i,
+                            "v": j,
+                            "axis": "v",
+                            "line": wall_col,
+                            "lo": row_lo,
+                            "hi": row_hi,
+                        }
+                    )
+            elif b1 == t2 or b2 == t1:
+                wall_row = b1 if b1 == t2 else b2
+                col_lo = max(l1, l2) + 1
+                col_hi = min(r1, r2) - 1
+                if col_lo <= col_hi:
+                    edges.append(
+                        {
+                            "u": i,
+                            "v": j,
+                            "axis": "h",
+                            "line": wall_row,
+                            "lo": col_lo,
+                            "hi": col_hi,
+                        }
+                    )
+    return edges
+
