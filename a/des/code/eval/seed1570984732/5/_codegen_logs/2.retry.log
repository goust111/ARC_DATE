+def _find_adjacencies(
+    rooms: list[tuple[int, int, int, int]]
+) -> list[dict[str, int | str]]:
+    edges: list[dict[str, int | str]] = []
+    for i, (t1, l1, b1, r1) in enumerate(rooms):
+        for j in range(i + 1, len(rooms)):
+            t2, l2, b2, r2 = rooms[j]
+            if r1 == l2 or r2 == l1:
+                wall_col = r1 if r1 == l2 else r2
+                row_lo = max(t1, t2) + 1
+                row_hi = min(b1, b2) - 1
+                if row_lo <= row_hi:
+                    edges.append(
