+    bg = _get_bg(g)
+    unique_colors = [int(v) for v in np.unique(g) if int(v) != bg]
+    frames: list[dict] = []
+    for color in unique_colors:
+        if int(np.count_nonzero(g == color)) <= 1:
+            continue
+        frames.append(_parse_frame(g, color, bg))
