+    r0, c0, r1, c1 = bbox
+    return (r0 + r1) // 2, (c0 + c1) // 2
+
+
+def _side_center(bbox: tuple[int, int, int, int], side: str) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    cr, cc = _center_of_bbox(bbox)
+    if side == "top":
+        return r0, cc
+    if side == "bottom":
+        return r1, cc
+    if side == "left":
+        return cr, c0
+    assert side == "right"
+    return cr, c1
+
+
+def _perimeter_coords(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    coords: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        coords.append((r0, c))
+        coords.append((r1, c))
+    for r in range(r0 + 1, r1):
+        coords.append((r, c0))
+        coords.append((r, c1))
+    return coords
+
+
+def _parse_frame(grid: np.ndarray, color: int, bg: int) -> dict:
+    coords = np.argwhere(grid == color)
+    if coords.size == 0:
+        raise ValueError("empty color")
+
+    bbox = _bbox(coords)
+    r0, c0, r1, c1 = bbox
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
