+        out[gap_r, gap_c] = int(bg)
+    return out
+
+
+def _draw_frame(
+    grid: np.ndarray,
+    center: tuple[int, int],
+    half_h: int,
+    half_w: int,
+    color: int,
+    gap_side: str,
+    bg: int,
+) -> dict:
