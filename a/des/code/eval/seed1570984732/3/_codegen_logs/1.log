+def _sample_template_mask() -> np.ndarray | None:
+    dims = random.choice(
+        ((1, 3), (3, 1), (3, 3), (3, 5), (5, 3), (5, 5))
+    )
+    h, w = dims
+    center = (h // 2, w // 2)
+    cells = {center}
+    targets = []
+    if h > 1:
