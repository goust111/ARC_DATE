+    max_area = h * w
+    target_area = random.randint(len(cells), max_area)
+    for _ in range(100):
+        if len(cells) >= target_area:
+            break
+        frontier = []
+        for r, c in cells:
+            for nr, nc in _neighbors4(r, c, h, w):
+                if (nr, nc) not in cells:
+                    frontier.append((nr, nc))
+        if not frontier:
+            break
+        cells.add(random.choice(frontier))
