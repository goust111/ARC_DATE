+def _random_path(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = start
+    tr, tc = end
+    cells = [(r, c)]
+    while (r, c) != (tr, tc):
+        move_row = r != tr and (c == tc or random.random() < 0.5)
+        if move_row:
+            r += 1 if tr > r else -1
+        else:
+            c += 1 if tc > c else -1
+        cells.append((r, c))
