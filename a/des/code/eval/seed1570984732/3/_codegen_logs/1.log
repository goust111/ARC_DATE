        patch[CROSSBAR_MID, :] = color
        patch[:, offset] = color
    else:
        offset = NEAR_END_OFFSET if direction == DIRECTIONS["V"][0] else FAR_END_OFFSET
        patch[:, CROSSBAR_MID] = color
