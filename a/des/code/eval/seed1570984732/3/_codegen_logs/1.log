+def _stamp(
+    out: np.ndarray,
+    color: int,
+    mask: np.ndarray,
+    seed_r: int,
+    seed_c: int,
+    interior_bbox: tuple[int, int, int, int],
+) -> None:
+    center_r = mask.shape[0] // 2
+    center_c = mask.shape[1] // 2
+    ir0, ic0, ir1, ic1 = interior_bbox
+    for mr, mc in np.argwhere(mask):
+        tr = seed_r + int(mr) - center_r
+        tc = seed_c + int(mc) - center_c
