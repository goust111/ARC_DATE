+def _frame_bboxes(region: np.ndarray) -> list[tuple[int, int, int, int]]:
+    infos: list[tuple[int, int, int, int]] = []
+    for comp in _components(region == FRAME):
+        r0, c0, r1, c1 = _bbox(comp)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
