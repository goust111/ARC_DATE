+    placed_boxes: list[tuple[int, int, int, int]] = []
+    order = sorted(patches, key=lambda item: int(item[1].sum()), reverse=True)
+    for color, patch in order:
+        ph, pw = map(int, patch.shape)
+        if rh < ph + 2 or rw < pw + 2:
+            return None
+        for _ in range(200):
