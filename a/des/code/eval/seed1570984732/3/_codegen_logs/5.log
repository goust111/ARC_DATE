+        width = left_margin + row_w + right_margin
+        c = left_margin
+        for obj in objs:
+            slack = row_h - obj["reserve_h"]
+            obj["reserve_r0"] = top_margin + (random.randint(0, slack) if slack else 0)
+            obj["reserve_c0"] = c
