+
+
+def _sample_marker_sides() -> dict[str, bool]:
+    return {side: bool(random.getrandbits(1)) for side in SIDES}
+
+
+def _reserve_size(mask: np.ndarray, markers: dict[str, bool]) -> tuple[int, int, int, int, int, int]:
