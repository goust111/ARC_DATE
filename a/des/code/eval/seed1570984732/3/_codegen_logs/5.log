+def _layout_objects(objs: list[dict]) -> tuple[int, int] | None:
+    margins = [random.randint(1, 3) for _ in range(4)]
+    top_margin, bottom_margin, left_margin, right_margin = margins
+    if len(objs) == 1:
+        obj = objs[0]
