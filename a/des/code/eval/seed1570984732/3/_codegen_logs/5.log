+    fh = ph + 4
+    fw = pw + 4
+    phase = obj["phase"]
+    rr, cc = np.indices((fh, fw))
+    border = _frame_border_mask(fh, fw)
+    active = border & (((rr + cc) & 1) == phase)
+    grid[fr0 : fr0 + fh, fc0 : fc0 + fw][active] = GREY
+
+    markers = obj["markers"]
