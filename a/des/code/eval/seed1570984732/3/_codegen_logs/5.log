+    gap = random.randint(1, 3)
+    row_h = max(obj["reserve_h"] for obj in objs)
+    row_w = sum(obj["reserve_w"] for obj in objs) + gap
+    col_h = sum(obj["reserve_h"] for obj in objs) + gap
