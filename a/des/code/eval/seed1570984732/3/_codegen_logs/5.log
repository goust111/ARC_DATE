+    width = left_margin + col_w + right_margin
+    r = top_margin
+    for obj in objs:
+        slack = col_w - obj["reserve_w"]
+        obj["reserve_r0"] = r
+        obj["reserve_c0"] = left_margin + (random.randint(0, slack) if slack else 0)
