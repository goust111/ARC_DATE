+
+
+def _build_region(spec: dict) -> np.ndarray:
+    patch = np.full((spec["h"], spec["w"]), spec["color"], dtype=int)
+    for r, c in spec["holes_local"]:
+        patch[r, c] = BLACK
+    mr, mc = spec["marker_local"]
+    patch[mr, mc] = ORANGE
