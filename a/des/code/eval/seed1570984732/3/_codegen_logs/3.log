+        for rr, cc in comp:
+            for dr, dc in DIRS4:
+                nr, nc = rr + dr, cc + dc
+                if 0 <= nr < solid.shape[0] and 0 <= nc < solid.shape[1]:
+                    if not black[nr, nc] and not solid[nr, nc]:
+                        boundary_ok = False
+                        break
