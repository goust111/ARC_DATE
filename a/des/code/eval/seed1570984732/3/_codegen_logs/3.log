+            return None
+
+    grid = np.full((height, width), BLACK, dtype=int)
+    occupied_input = set()
+    for spec in specs:
+        patch = _build_region(spec)
+        top, left = spec["top"], spec["left"]
+        bottom = top + spec["h"] - 1
+        right = left + spec["w"] - 1
+        if top < 0 or left < 0 or bottom >= height or right >= width:
+            return None
