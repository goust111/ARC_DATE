+
+
+def _stamp_cells(hole_cells: list[tuple[int, int]], center: tuple[int, int], marker: tuple[int, int], direction: str) -> list[tuple[int, int]]:
+    if not hole_cells:
+        return []
+    cr, cc = center
+    mr, mc = marker
+    if direction in ("up", "down"):
+        flipped = [(2 * cr - r, c) for r, c in hole_cells]
