+
+    orange_count = int((grid == ORANGE).sum())
+    if orange_count != len(specs):
+        return None
+
+    expected = _expected_output(grid, specs)
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
