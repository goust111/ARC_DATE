+
+
+def _piece_patch(body_h: int, body_w: int, side: str, protrusions: list[int], color: int) -> np.ndarray:
+    if side == "right":
+        patch = np.zeros((body_h, body_w + 1), dtype=int)
+        patch[:, :body_w] = color
+        for r, bit in enumerate(protrusions):
+            if bit:
+                patch[r, body_w] = color
+            else:
+                patch[r, body_w - 1] = BG
+        return patch
+
+    if side == "left":
+        patch = np.zeros((body_h, body_w + 1), dtype=int)
+        patch[:, 1:] = color
+        for r, bit in enumerate(protrusions):
+            if bit:
+                patch[r, 0] = color
+            else:
+                patch[r, 1] = BG
