from __future__ import annotations

import numpy as np


BG = 0
PALETTE = tuple(range(1, 10))
DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))


def _find_components(grid: np.ndarray) -> list[dict]:
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    seen = np.zeros((h, w), dtype=bool)
    comps: list[dict] = []

    for r in range(h):
        for c in range(w):
            color = int(g[r, c])
            if color == BG or seen[r, c]:
                continue

            stack = [(r, c)]
            seen[r, c] = True
            coords: list[tuple[int, int]] = []
            while stack:
                rr, cc = stack.pop()
                coords.append((rr, cc))
                for dr, dc in DIRS4:
                    nr = rr + dr
                    nc = cc + dc
                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
                        seen[nr, nc] = True
                        stack.append((nr, nc))

            arr = np.asarray(coords, dtype=int)
            r0 = int(arr[:, 0].min())
            c0 = int(arr[:, 1].min())
            r1 = int(arr[:, 0].max())
            c1 = int(arr[:, 1].max())
            comps.append(
                {
                    "color": color,
                    "coords": arr,
                    "bbox": (r0, c0, r1, c1),
                }
            )

    return comps


def _is_alternating(bits: np.ndarray) -> bool:
    return bits.size >= 2 and np.any(bits) and np.any(~bits) and np.all(bits[:-1] != bits[1:])


def _piece_mask(piece: dict) -> np.ndarray:
    r0, c0, r1, c1 = piece["bbox"]
    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
    for r, c in piece["coords"]:
        mask[int(r) - r0, int(c) - c0] = True
    return mask


def _profile_from_bits(bits: np.ndarray) -> tuple[int, ...]:
    return tuple(1 if bool(v) else -1 for v in bits.tolist())


def _analyze_piece(piece: dict) -> dict:
    mask = _piece_mask(piece)
    r0, c0, r1, c1 = piece["bbox"]
    h, w = mask.shape
    candidates: list[dict] = []

    if w >= 3 and np.all(mask[:, : w - 2]):
        outer = mask[:, w - 1]
        inner = mask[:, w - 2]
        if np.array_equal(outer, inner) and _is_alternating(outer):
            candidates.append(
