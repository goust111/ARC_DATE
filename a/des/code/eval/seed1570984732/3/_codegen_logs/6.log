+def _make_pair(color: int, rng: np.random.Generator) -> dict:
+    orientation = "horizontal" if int(rng.integers(0, 2)) == 0 else "vertical"
+    body_h = int(rng.integers(4, 8))
+    body_w = int(rng.integers(4, 8))
