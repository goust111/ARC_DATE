+    out = main(grid)
+    if out.shape != grid.shape:
+        return False
+    if int(np.sum(out == MAROON)) != len(starts):
+        return False
+    if np.array_equal(out, grid):
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    extra_count = random.randint(0, 2)
