+    dirs: list[int] = []
+    for idx, (dr, dc) in enumerate(DIRS):
+        rr, cc = r + dr, c + dc
+        if _inside(grid.shape, rr, cc) and int(grid[rr, cc]) in TRACK_COLORS:
+            dirs.append(idx)
+    return dirs
+
