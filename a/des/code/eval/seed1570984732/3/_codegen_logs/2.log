import random
from functools import lru_cache
from itertools import product

import numpy as np


BG = 0
PALETTE = tuple(range(1, 10))

FRAME_COUNT_RANGE = (2, 4)
INNER_DIM_RANGE = (5, 8)
GRID_EXTRA_MARGIN_RANGE = (8, 14)
GENERATION_ATTEMPTS = 500


def _components(mask: np.ndarray) -> list[np.ndarray]:
    h, w = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    comps: list[np.ndarray] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            stack = [(r, c)]
            seen[r, c] = True
            cells = []
            while stack:
                rr, cc = stack.pop()
                cells.append((rr, cc))
                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nr = rr + dr
                    nc = cc + dc
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            comps.append(np.array(cells, dtype=int))
    return comps


def _normalize(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
    r0 = int(coords[:, 0].min())
    c0 = int(coords[:, 1].min())
    shifted = coords - np.array([r0, c0], dtype=int)
    order = np.lexsort((shifted[:, 1], shifted[:, 0]))
    return tuple((int(shifted[i, 0]), int(shifted[i, 1])) for i in order)


@lru_cache(maxsize=None)
def _perimeter_cycle(h: int, w: int) -> tuple[tuple[int, int], ...]:
    cells = []
    for c in range(w):
        cells.append((0, c))
    for r in range(1, h - 1):
        cells.append((r, w - 1))
    for c in range(w - 1, -1, -1):
        cells.append((h - 1, c))
    for r in range(h - 2, 0, -1):
        cells.append((r, 0))
    return tuple(cells)


@lru_cache(maxsize=None)
def _fragment_placements(fragment: tuple[tuple[int, int], ...], h: int, w: int) -> tuple[int, ...]:
    perimeter = _perimeter_cycle(h, w)
    index = {cell: i for i, cell in enumerate(perimeter)}
    max_r = max(r for r, _ in fragment)
    max_c = max(c for _, c in fragment)
    placements: set[int] = set()
    for dr in range(h - max_r):
        for dc in range(w - max_c):
            bits = 0
            ok = True
            for r, c in fragment:
                idx = index.get((r + dr, c + dc))
                if idx is None:
                    ok = False
                    break
                bits |= 1 << idx
            if ok:
                placements.add(bits)
    return tuple(sorted(placements))


def _can_cover_perimeter(fragments: tuple[tuple[tuple[int, int], ...], ...], h: int, w: int) -> bool:
    placements = [_fragment_placements(fragment, h, w) for fragment in fragments]
    if any(not options for options in placements):
        return False
    order = sorted(range(len(fragments)), key=lambda i: len(placements[i]))

    def dfs(i: int, used: int) -> bool:
        if i == len(order):
            return True
        fragment_idx = order[i]
        for bits in placements[fragment_idx]:
            if used & bits:
                continue
            if dfs(i + 1, used | bits):
                return True
        return False

    return dfs(0, 0)


def _feasible_dimensions(fragments: tuple[tuple[tuple[int, int], ...], ...]) -> list[tuple[int, int]]:
    perimeter = sum(len(fragment) for fragment in fragments)
    if perimeter % 2 != 0:
        return []
    side_sum = perimeter // 2 + 2
    min_h = max(max(r for r, _ in fragment) + 1 for fragment in fragments)
    min_w = max(max(c for _, c in fragment) + 1 for fragment in fragments)
    dims = []
    for h in range(max(2, min_h), side_sum - 1):
        w = side_sum - h
        if w < max(2, min_w):
            continue
        if _can_cover_perimeter(fragments, h, w):
            dims.append((h, w))
    return dims


def _extract_fragments_by_color(grid: np.ndarray) -> dict[int, tuple[tuple[tuple[int, int], ...], ...]]:
    data: dict[int, tuple[tuple[tuple[int, int], ...], ...]] = {}
    for color in sorted(int(v) for v in np.unique(grid) if int(v) != BG):
        comps = _components(grid == color)
        normalized = tuple(sorted((_normalize(comp) for comp in comps), key=lambda frag: (len(frag), frag)))
        data[color] = normalized
    return data


def _choose_dimensions(
    options_by_color: dict[int, list[tuple[int, int]]],
) -> dict[int, tuple[int, int]]:
    if all(len(options) == 1 for options in options_by_color.values()):
        return {color: options[0] for color, options in options_by_color.items()}

    colors = sorted(options_by_color)
    solutions: set[tuple[tuple[int, int, int], ...]] = set()
    for choice in product(*(options_by_color[color] for color in colors)):
        items = []
        areas = []
        for color, (h, w) in zip(colors, choice):
            area = (h - 2) * (w - 2)
            items.append((color, h, w, area))
            areas.append(area)
        if len(set(areas)) != len(areas):
            continue
        items.sort(key=lambda item: item[3])
        if all(items[i + 1][1] == items[i][1] + 4 and items[i + 1][2] == items[i][2] + 4 for i in range(len(items) - 1)):
            solutions.add(tuple(sorted((color, h, w) for color, h, w, _ in items)))

    if len(solutions) != 1:
        raise ValueError("ambiguous rectangle reconstruction")
    return {color: (h, w) for color, h, w in next(iter(solutions))}


def _ordered_frames(grid: np.ndarray) -> list[tuple[int, int, int, int]]:
    fragments_by_color = _extract_fragments_by_color(grid)
    options_by_color = {color: _feasible_dimensions(fragments) for color, fragments in fragments_by_color.items()}
    if any(not options for options in options_by_color.values()):
        raise ValueError("failed to reconstruct a rectangle")
    chosen = _choose_dimensions(options_by_color)
    frames = [(color, h, w, (h - 2) * (w - 2)) for color, (h, w) in chosen.items()]
    frames.sort(key=lambda item: item[3])
    for i in range(len(frames) - 1):
        h0, w0 = frames[i][1], frames[i][2]
        h1, w1 = frames[i + 1][1], frames[i + 1][2]
        if h1 != h0 + 4 or w1 != w0 + 4:
            raise ValueError("reconstructed rectangles do not form the required nesting chain")
    return frames


def _draw_frame(grid: np.ndarray, color: int, r0: int, c0: int, h: int, w: int) -> None:
    r1 = r0 + h - 1
    c1 = c0 + w - 1
    grid[r0, c0 : c1 + 1] = color
    grid[r1, c0 : c1 + 1] = color
    grid[r0 : r1 + 1, c0] = color
    grid[r0 : r1 + 1, c1] = color


def _build_output(frames: list[tuple[int, int, int, int]]) -> np.ndarray:
    outer_h = frames[-1][1]
    outer_w = frames[-1][2]
    out = np.zeros((outer_h, outer_w), dtype=int)
    for color, h, w, _area in frames:
        r0 = (outer_h - h) // 2
        c0 = (outer_w - w) // 2
        _draw_frame(out, color, r0, c0, h, w)
    return out


def main(grid: np.ndarray) -> np.ndarray:
    g = np.asarray(grid, dtype=int)
    return _build_output(_ordered_frames(g))


def _side_cut_indices(h: int, w: int) -> list[list[int]]:
    cycle = _perimeter_cycle(h, w)
    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}
    groups = [[] for _ in range(4)]
    for idx, (r, c) in enumerate(cycle):
        if (r, c) in corners:
            continue
        if r == 0:
            groups[0].append(idx)
        elif c == w - 1:
            groups[1].append(idx)
        elif r == h - 1:
            groups[2].append(idx)
        else:
            groups[3].append(idx)
    return groups


def _split_frame_into_fragments(h: int, w: int, parts: int) -> list[np.ndarray]:
    cycle = _perimeter_cycle(h, w)
    cut_groups = _side_cut_indices(h, w)
    chosen_sides = random.sample(range(4), parts)
    cut_positions = sorted(random.choice(cut_groups[side]) for side in chosen_sides)
    fragments = []
    total = len(cycle)
    for i, start in enumerate(cut_positions):
        end = cut_positions[(i + 1) % parts]
        length = (end - start) % total
        if length == 0:
            length = total
        cells = np.array([cycle[(start + offset) % total] for offset in range(length)], dtype=int)
        local = np.array(_normalize(cells), dtype=int)
        fragments.append(local)
    random.shuffle(fragments)
    return fragments


def _bbox_shape(coords: np.ndarray) -> tuple[int, int]:
    return int(coords[:, 0].max()) + 1, int(coords[:, 1].max()) + 1


def _can_place_cells(occupied: np.ndarray, cells: np.ndarray) -> bool:
    h, w = occupied.shape
    for r, c in cells:
        for rr in range(max(0, int(r) - 1), min(h, int(r) + 2)):
            for cc in range(max(0, int(c) - 1), min(w, int(c) + 2)):
                if occupied[rr, cc]:
                    return False
    return True


def _scatter_fragments(fragments: list[dict], h: int, w: int) -> np.ndarray | None:
    grid = np.zeros((h, w), dtype=int)
    occupied = np.zeros((h, w), dtype=bool)
    order = sorted(
        fragments,
        key=lambda item: (
            _bbox_shape(item["coords"])[0] * _bbox_shape(item["coords"])[1],
            len(item["coords"]),
        ),
        reverse=True,
    )
    for fragment in order:
        coords = fragment["coords"]
        color = fragment["color"]
        fh, fw = _bbox_shape(coords)
        starts = [(r0, c0) for r0 in range(h - fh + 1) for c0 in range(w - fw + 1)]
        random.shuffle(starts)
        placed = False
        for r0, c0 in starts:
            shifted = coords + np.array([r0, c0], dtype=int)
            if not _can_place_cells(occupied, shifted):
                continue
            grid[shifted[:, 0], shifted[:, 1]] = color
            occupied[shifted[:, 0], shifted[:, 1]] = True
            placed = True
            break
        if not placed:
            return None
    return grid


def _build_expected(specs: list[tuple[int, int, int]]) -> np.ndarray:

