        specs = []
        fragments = []
        for idx, color in enumerate(colors):
            h = inner_h + 4 * idx
            w = inner_w + 4 * idx
            specs.append((color, h, w))
            part_count = random.randint(2, 4)
            for fragment in _split_frame_into_fragments(h, w, part_count):
                fragments.append({"color": color, "coords": fragment})

        outer_h = specs[-1][1]
        outer_w = specs[-1][2]
        grid_h = random.randint(outer_h + GRID_EXTRA_MARGIN_RANGE[0], outer_h + GRID_EXTRA_MARGIN_RANGE[1])
        grid_w = random.randint(outer_w + GRID_EXTRA_MARGIN_RANGE[0], outer_w + GRID_EXTRA_MARGIN_RANGE[1])
        grid = _scatter_fragments(fragments, grid_h, grid_w)
