+
+def _paint_mask(
+    grid: np.ndarray,
+    origin_r: int,
+    origin_c: int,
+    mask: np.ndarray,
+    color: int,
+) -> None:
+    for r, c in np.argwhere(mask):
+        grid[origin_r + int(r), origin_c + int(c)] = color
+
