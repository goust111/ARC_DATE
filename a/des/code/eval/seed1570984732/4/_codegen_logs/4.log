+def _pick_extra_dots(
+    name: str,
+    h: int,
+    w: int,
+    anchor: tuple[int, int],
+    anchor_dist: int,
+    count: int,
+    forbidden: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
