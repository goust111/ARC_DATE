+
+def _pick_anchor(
+    name: str,
+    h: int,
+    w: int,
+    offsets: list[tuple[int, int]],
+    layers: int,
+    prefer_clipped: bool,
+) -> tuple[tuple[int, int], set[tuple[int, int]], bool] | None:
+    candidates = []
