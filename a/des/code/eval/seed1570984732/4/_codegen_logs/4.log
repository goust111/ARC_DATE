+        "tl": {"r0": 0, "c0": 0, "h": cross_r, "w": cross_c},
+        "tr": {"r0": 0, "c0": cross_c + 1, "h": cross_r, "w": w - cross_c - 1},
+        "bl": {"r0": cross_r + 1, "c0": 0, "h": h - cross_r - 1, "w": cross_c},
+        "br": {"r0": cross_r + 1, "c0": cross_c + 1, "h": h - cross_r - 1, "w": w - cross_c - 1},
