+def _mark_blocked(blocked: set[tuple[int, int]], cell: tuple[int, int], h: int, w: int) -> None:
+    r, c = cell
+    blocked.add(cell)
+    for dr, dc in DIR8:
+        nr = r + dr
+        nc = c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            blocked.add((nr, nc))
