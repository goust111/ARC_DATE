+
+def get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components4(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _is_asymmetric(mask: np.ndarray) -> bool:
+    checks = [np.flipud(mask), np.fliplr(mask), np.rot90(mask, 2)]
+    if mask.shape[0] == mask.shape[1]:
+        checks.extend([np.rot90(mask, 1), np.rot90(mask, 3), mask.T, np.fliplr(mask.T)])
+    return all(not np.array_equal(mask, other) for other in checks)
+
+
+def _grow_connected_mask(h: int, w: int, target: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    center = (h // 2, w // 2)
+    mask[center] = True
+    while int(mask.sum()) < target:
+        frontier: set[tuple[int, int]] = set()
+        for r, c in np.argwhere(mask):
+            rr = int(r)
+            cc = int(c)
+            for dr, dc in DIR4:
+                nr = rr + dr
+                nc = cc + dc
+                if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
+                    frontier.add((nr, nc))
+        r, c = random.choice(tuple(frontier))
+        mask[r, c] = True
