+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+WALL_COLOR = 5
+MAROON_COLOR = 9
+PALETTE = [0, 1, 2, 3, 4, 6, 7, 8]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRIES = 400
+PLACEMENT_RETRIES = 60
+SEGMENT_LENGTHS = [2, 3, 4, 5]
