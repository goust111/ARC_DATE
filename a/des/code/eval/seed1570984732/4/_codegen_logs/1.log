+            hi = min(int(through), int(w) - int(length) - 1)
+        if hi < lo:
+            continue
+        starts = list(range(int(lo), int(hi) + 1))
+        random.shuffle(starts)
+        for start in starts:
+            cells = _request_segment_cells(orientation, int(fixed), int(start), int(length))
+            cell_set = set(cells)
+            ok = True
+            for r, c in cells:
