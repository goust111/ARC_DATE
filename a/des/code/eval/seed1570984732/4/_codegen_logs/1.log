+def _build_parallel_scene(height: int, width: int, colors: list[int]) -> np.ndarray | None:
+    axis = random.choice(["h", "v"])
+    seed_count = random.randint(2, min(4, len(colors)))
+    seeds: list[dict] = []
+    wall_requests: list[tuple[str, int, int]] = []
+
+    if axis == "h":
