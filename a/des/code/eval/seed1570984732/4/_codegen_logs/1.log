+def _build_cross_scene(height: int, width: int, colors: list[int], mixed: bool) -> np.ndarray | None:
+    if height < 8 or width < 8:
+        return None
+    rows = list(range(2, height - 2))
+    cols = list(range(2, width - 2))
+    if not rows or not cols:
+        return None
