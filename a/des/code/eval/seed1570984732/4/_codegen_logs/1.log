+    visits: dict[tuple[int, int], set[int]] = defaultdict(set)
+    bounced_by_color: dict[int, bool] = {}
+    for seed in seeds:
+        visited, bounced = _simulate_seed(
+            g,
+            int(bg),
+            int(wall_color),
+            seed["seed"],
+            seed["direction"],
+            int(seed["steps"]),
+        )
+        bounced_by_color[int(seed["color"])] = bool(bounced)
+        for cell in visited:
+            visits[cell].add(int(seed["color"]))
