+def _intersection_color(grid: np.ndarray, bg: int, wall_color: int) -> int:
+    used = {int(v) for v in np.unique(grid)}
+    if int(MAROON_COLOR) not in used:
+        return int(MAROON_COLOR)
+    for color in range(10):
