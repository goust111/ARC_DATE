+def _range_to_opposite_edge(shape: tuple[int, int], seed: tuple[int, int], direction: tuple[int, int]) -> int:
+    h, w = shape
+    r, c = seed
+    dr, dc = direction
+    if (dr, dc) == (-1, 0):
+        return int(r)
+    if (dr, dc) == (1, 0):
+        return int(h - 1 - r)
+    if (dr, dc) == (0, -1):
+        return int(c)
+    assert (dr, dc) == (0, 1)
+    return int(w - 1 - c)
