+            "wall_color": int(wall_color),
+            "merge_color": int(merge_color),
+            "seed_count": int(len(seeds)),
+            "maroon_count": int(sum(1 for colors in visits.values() if len(colors) >= 2)),
+            "bounced_by_color": bounced_by_color,
+        }
