+def _dihedral_masks(mask: np.ndarray) -> list[np.ndarray]:
+    out: list[np.ndarray] = []
+    seen: set[tuple[int, int, bytes]] = set()
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        for variant in (rot, np.fliplr(rot)):
+            key = (int(variant.shape[0]), int(variant.shape[1]), variant.tobytes())
+            if key in seen:
+                continue
+            seen.add(key)
+            out.append(variant.copy())
+    return out
