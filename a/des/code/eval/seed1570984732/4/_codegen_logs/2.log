        min_r = min(r for r, _, _ in coords)
        min_c = min(c for _, c, _ in coords)
        coords = [(r - min_r, c - min_c, col) for r, c, col in coords]
        pieces.append(
            {
                "name": "anchor",
                "cells": coords,
                "marker_color": int(marker_color),
            }
        )
        used.add(anchor_color)
        used.add(marker_color)

    for col in colors:
