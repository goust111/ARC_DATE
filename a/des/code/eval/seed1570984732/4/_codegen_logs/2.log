+    out = g[r0 : r1 + 1, c0 : c1 + 1].copy()
+    for piece_idx, hole_idx in enumerate(assignment):
+        coords = holes[hole_idx]["coords"]
+        out[coords[:, 0], coords[:, 1]] = int(pieces[piece_idx]["marker"])
+    return out
