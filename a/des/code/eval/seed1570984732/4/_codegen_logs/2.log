import math
import random
from collections import defaultdict

import numpy as np


BG = 0
SEPARATOR = 5
BOARD = 9
PIECE_COLORS = (1, 2, 3, 4, 6, 7, 8)

PAIR_COUNT_CHOICES = (2, 3, 4)
SHAPE_SIDE_MIN = 2
SHAPE_SIDE_MAX = 4
