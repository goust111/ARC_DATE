from __future__ import annotations

from collections import Counter, deque
import random

import numpy as np


BG = 0
TEMPLATE_COLOR = 8  # azure
SIDE_ORDER = ("top", "right", "bottom", "left")
GEN_RETRIES = 300


def _components_from_mask(mask: np.ndarray) -> list[np.ndarray]:
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    comps: list[np.ndarray] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            cells: list[tuple[int, int]] = []
            while q:
                cr, cc = q.popleft()
                cells.append((cr, cc))
                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            comps.append(np.array(cells, dtype=int))
    return comps


def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
    rows = coords[:, 0]
    cols = coords[:, 1]
    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())


def _rotate_side(side: str, steps_cw: int) -> str:
    idx = SIDE_ORDER.index(side)
    return SIDE_ORDER[(idx + steps_cw) % 4]


def _rotation_steps(piece_side: str, hole_side: str) -> int:
    return (SIDE_ORDER.index(hole_side) - SIDE_ORDER.index(piece_side)) % 4


def _find_template(grid: np.ndarray) -> dict:
    comps = _components_from_mask(grid != BG)
    assert comps, "expected at least one non-black component"
    coords = max(comps, key=len)
    r0, c0, r1, c1 = _bbox(coords)
    mask = np.zeros_like(grid, dtype=bool)
    mask[coords[:, 0], coords[:, 1]] = True
    values = [int(grid[r, c]) for r, c in coords]
    color = Counter(values).most_common(1)[0][0]
    assert color != BG, "template color cannot be black"
    return {"coords": coords, "bbox": (r0, c0, r1, c1), "mask": mask, "color": color}


def _find_hole_marker(
    grid: np.ndarray, bbox: tuple[int, int, int, int], bg: int, template_color: int
) -> tuple[str, tuple[int, int]]:
    r0, c0, r1, c1 = bbox
    strips = {
        "top": [(r0 - 1, c) for c in range(c0, c1 + 1)],
        "bottom": [(r1 + 1, c) for c in range(c0, c1 + 1)],
        "left": [(r, c0 - 1) for r in range(r0, r1 + 1)],
        "right": [(r, c1 + 1) for r in range(r0, r1 + 1)],
    }
    hits: list[tuple[str, tuple[int, int]]] = []
    for side, cells in strips.items():
        marked = [(r, c) for r, c in cells if int(grid[r, c]) not in (bg, template_color)]
        assert len(marked) <= 1, "each hole side may contain at most one marker"
        if marked:
            hits.append((side, marked[0]))
    assert len(hits) == 1, "each hole must have exactly one side marker"
    return hits[0]


def _find_holes(grid: np.ndarray, template: dict) -> list[dict]:
    tr0, tc0, tr1, tc1 = template["bbox"]
    sub = grid[tr0 : tr1 + 1, tc0 : tc1 + 1]
    holes: list[dict] = []
    for coords in _components_from_mask(sub == BG):
        if np.any(coords[:, 0] == 0) or np.any(coords[:, 1] == 0):
            continue
        if np.any(coords[:, 0] == sub.shape[0] - 1) or np.any(coords[:, 1] == sub.shape[1] - 1):
            continue
        global_coords = coords + np.array([tr0, tc0], dtype=int)
        bbox = _bbox(global_coords)
        hr0, hc0, hr1, hc1 = bbox
        h = hr1 - hr0 + 1
        w = hc1 - hc0 + 1
        assert len(global_coords) == h * w, "holes must be rectangular"
        side, marker_coord = _find_hole_marker(grid, bbox, BG, int(template["color"]))
        holes.append(
            {
                "bbox": bbox,
                "h": h,
                "w": w,
                "side": side,
                "marker_coord": marker_coord,
                "size_key": tuple(sorted((h, w))),
            }
        )
    assert holes, "template must contain at least one internal hole"
    return holes


def _piece_side_from_marker(marker: tuple[int, int], bbox: tuple[int, int, int, int]) -> str:
    mr, mc = marker
    r0, c0, r1, c1 = bbox
    sides = []
    if mr == r0:
        sides.append("top")
    if mr == r1:
        sides.append("bottom")
    if mc == c0:
        sides.append("left")
    if mc == c1:
        sides.append("right")
    assert len(sides) == 1, "piece marker must lie on exactly one side"
    return sides[0]


def _find_pieces(grid: np.ndarray, template: dict) -> list[dict]:
    mask = (grid != BG) & (~template["mask"])
    pieces: list[dict] = []
    for coords in _components_from_mask(mask):
        bbox = _bbox(coords)
        r0, c0, r1, c1 = bbox
        h = r1 - r0 + 1
        w = c1 - c0 + 1
        assert len(coords) == h * w, "pieces must fully occupy their bounding box"

        vals = [int(grid[r, c]) for r, c in coords]
        counts = Counter(vals)
        assert len(counts) == 2, "piece should contain one main color and one marker color"
        main_color = counts.most_common(1)[0][0]
        marker_coords = [(int(r), int(c)) for r, c in coords if int(grid[r, c]) != main_color]
        assert len(marker_coords) == 1, "piece must have exactly one marker pixel"
        marker = marker_coords[0]
        side = _piece_side_from_marker(marker, bbox)
        pieces.append(
            {
                "coords": coords,
                "bbox": bbox,
                "h": h,
                "w": w,
                "main_color": int(main_color),
                "marker_coord": marker,
                "side": side,
                "size_key": tuple(sorted((h, w))),
            }
        )
    assert pieces, "expected at least one fragment outside the template"
    return pieces


def _solve(grid: np.ndarray) -> np.ndarray:
    g = np.asarray(grid, dtype=int)
    out = g.copy()

    template = _find_template(g)
    holes = _find_holes(g, template)
    pieces = _find_pieces(g, template)

    assert len(holes) == len(pieces), "hole and piece counts must match"
    piece_by_key: dict[tuple[int, int], dict] = {}
    for piece in pieces:
        key = piece["size_key"]
        assert key not in piece_by_key, "piece dimensions must be unique up to rotation"
        piece_by_key[key] = piece

    for hole in holes:
        key = hole["size_key"]
        assert key in piece_by_key, "every hole must have a matching piece"
        piece = piece_by_key.pop(key)
        steps = _rotation_steps(piece["side"], hole["side"])
        if steps % 2 == 0:
            assert (piece["h"], piece["w"]) == (hole["h"], hole["w"])
        else:
            assert (piece["w"], piece["h"]) == (hole["h"], hole["w"])

        for r, c in piece["coords"]:
            out[int(r), int(c)] = BG

        hr0, hc0, hr1, hc1 = hole["bbox"]
        out[hr0 : hr1 + 1, hc0 : hc1 + 1] = int(piece["main_color"])
        mr, mc = hole["marker_coord"]
        out[mr, mc] = g[mr, mc]

    assert not piece_by_key, "all pieces must be consumed"
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Match each outside fragment to the uniquely-sized rectangular hole inside the
    central template, rotate by aligning the side marker, then fill the hole.
    """
    return _solve(grid)


def _side_marker_index(length: int, rng: random.Random) -> int:
    assert length >= 3, "markers are generated away from corners"
    return rng.randint(1, length - 2)


def _hole_marker_cell(bbox: tuple[int, int, int, int], side: str, rng: random.Random) -> tuple[int, int]:
    r0, c0, r1, c1 = bbox
    if side == "top":
        return r0 - 1, c0 + _side_marker_index(c1 - c0 + 1, rng)
    if side == "bottom":
        return r1 + 1, c0 + _side_marker_index(c1 - c0 + 1, rng)
    if side == "left":
        return r0 + _side_marker_index(r1 - r0 + 1, rng), c0 - 1
    return r0 + _side_marker_index(r1 - r0 + 1, rng), c1 + 1


def _piece_marker_local(h: int, w: int, side: str, rng: random.Random) -> tuple[int, int]:
    if side == "top":
        return 0, _side_marker_index(w, rng)
    if side == "bottom":
        return h - 1, _side_marker_index(w, rng)
    if side == "left":
        return _side_marker_index(h, rng), 0
    return _side_marker_index(h, rng), w - 1


def _pick_marker_color(rng: random.Random, exclude: set[int]) -> int:
    choices = [c for c in range(1, 10) if c not in exclude]
    assert choices
    return rng.choice(choices)


def _choose_size_specs(rng: random.Random, count: int) -> list[tuple[int, int]]:
    options = [(a, b) for a in range(3, 7) for b in range(a, 7)]
    keys = rng.sample(options, count)
    sizes = []
    for a, b in keys:
        if a != b and rng.random() < 0.5:
            sizes.append((b, a))
        else:
            sizes.append((a, b))
    return sizes


