+            holes = []
+            for hole_coords in _components_mask(sub == bg):
+                if (
+                    np.any(hole_coords[:, 0] == 0)
+                    or np.any(hole_coords[:, 0] == sub.shape[0] - 1)
+                    or np.any(hole_coords[:, 1] == 0)
+                    or np.any(hole_coords[:, 1] == sub.shape[1] - 1)
+                ):
+                    continue
