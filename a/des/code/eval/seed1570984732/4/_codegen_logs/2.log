HOLE_AREA_MAX = 8
BOARD_RETRIES = 80
PAIR_RETRIES = 300
GEN_RETRIES = 400
GRID_H_MIN = 11
GRID_H_MAX = 18
GRID_W_MAX = 30


def _neighbors4(r: int, c: int):
    yield r - 1, c
    yield r + 1, c
    yield r, c - 1
    yield r, c + 1


def _components_mask(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    comps: list[list[tuple[int, int]]] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            stack = [(r, c)]
            seen[r, c] = True
            comp: list[tuple[int, int]] = []
            while stack:
                rr, cc = stack.pop()
                comp.append((rr, cc))
                for nr, nc in _neighbors4(rr, cc):
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            comps.append(comp)
    return comps


def _normalize_coords(coords) -> tuple[tuple[tuple[int, int], ...], tuple[int, int]]:
    pts = [tuple(map(int, p)) for p in coords]
    r0 = min(r for r, _ in pts)
    c0 = min(c for _, c in pts)
    norm = tuple(sorted((r - r0, c - c0) for r, c in pts))
    return norm, (r0, c0)


def _coords_to_mask(coords: tuple[tuple[int, int], ...]) -> np.ndarray:
    if not coords:
        return np.zeros((0, 0), dtype=bool)
    h = max(r for r, _ in coords) + 1
    w = max(c for _, c in coords) + 1
    mask = np.zeros((h, w), dtype=bool)
    for r, c in coords:
        mask[r, c] = True
    return mask


def _is_connected(coords) -> bool:
    pts = {tuple(map(int, p)) for p in coords}
    if not pts:
        return False
    stack = [next(iter(pts))]
    seen = {stack[0]}
    while stack:
        r, c = stack.pop()
        for nr, nc in _neighbors4(r, c):
            if (nr, nc) in pts and (nr, nc) not in seen:
                seen.add((nr, nc))
                stack.append((nr, nc))
    return len(seen) == len(pts)


def _count_pair_compositions(
    piece_a: tuple[tuple[int, int], ...],
    piece_b: tuple[tuple[int, int], ...],
    hole: tuple[tuple[int, int], ...],
) -> int:
    hole_set = set(hole)
    b_norm = piece_b
    seen_offsets: set[tuple[int, int, int, int]] = set()
    for hr, hc in hole:
        for ar, ac in piece_a:
            tr = hr - ar
            tc = hc - ac
            placed_a = {(r + tr, c + tc) for r, c in piece_a}
            if not placed_a.issubset(hole_set):
                continue
            remaining = hole_set - placed_a
            if len(remaining) != len(piece_b):
                continue
            rem_norm, (rr0, cc0) = _normalize_coords(remaining)
            if rem_norm != b_norm:
                continue
            seen_offsets.add((tr, tc, rr0, cc0))
    return len(seen_offsets)


def _unique_assignment(edges: list[list[int]], n_holes: int) -> list[int]:
    order = sorted(range(len(edges)), key=lambda i: (len(edges[i]), i))
    used = [False] * n_holes
    assignment = [-1] * len(edges)
    solutions: list[list[int]] = []

    def dfs(k: int) -> None:
        if len(solutions) > 1:
            return
        if k == len(order):
            solutions.append(assignment.copy())
            return
        idx = order[k]
        for hole_idx in edges[idx]:
            if used[hole_idx]:
                continue
            used[hole_idx] = True
            assignment[idx] = hole_idx
            dfs(k + 1)
            assignment[idx] = -1
            used[hole_idx] = False

    dfs(0)
    assert len(solutions) == 1, "pair-to-hole matching must be unique"
    return solutions[0]


def _extract_board(board_region: np.ndarray):
    maroon_pts = np.argwhere(board_region == BOARD)
    assert len(maroon_pts) > 0, "board must contain maroon pixels"
    r0, c0 = maroon_pts.min(axis=0)
    r1, c1 = maroon_pts.max(axis=0)
    board = board_region[r0 : r1 + 1, c0 : c1 + 1].copy()
    assert np.all((board == BG) | (board == BOARD)), "board crop may only contain maroon and black"

    holes = []
    h, w = board.shape
    for comp in _components_mask(board == BG):
        if any(r in (0, h - 1) or c in (0, w - 1) for r, c in comp):
            continue
        norm, _ = _normalize_coords(comp)
        holes.append({"coords": comp, "norm": norm})
    return board, holes


def _extract_piece_pairs(left_region: np.ndarray):
    groups: dict[int, list[tuple[tuple[int, int], ...]]] = defaultdict(list)
    for comp in _components_mask(left_region != BG):
        colors = {int(left_region[r, c]) for r, c in comp}
        assert len(colors) == 1, "every left component must be monochrome"
        color = next(iter(colors))
        assert color not in {BG, SEPARATOR, BOARD}, "left pieces must use ordinary colors"
        norm, _ = _normalize_coords(comp)
        groups[color].append(norm)
    assert groups, "left region must contain pieces"
    items = []
    for color, parts in groups.items():
        assert len(parts) == 2, "each color must occur in exactly two fragments"
        items.append((int(color), parts))
    return items


