+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) != bg:
+                    boundary_colors.add(int(g[nr, nc]))
+        if len(boundary_colors) == 1:
+            fence_color = next(iter(boundary_colors))
+            candidates.append((len(comp), set(comp), int(fence_color)))
