        if len(inside)!=1: continue
        if len(inside[0])!=len(solid-fence): continue
        if maxdist(inside[0],fence)!=k: continue
        good+=1
        ss=slots(fence,solid,H,W)
        # simple greedy count of non-overlap lengths possible for 1..k not checked
        if len(ss)>=k:
            withslots+=1
    print('"'k',k,'good',good,'withslots>=k',withslots)
