+def _stripe_mapping(grid: np.ndarray, bg: int, fence_color: int) -> dict[int, int]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    mask = (g != bg) & (g != fence_color)
+    mapping: dict[int, int] = {}
