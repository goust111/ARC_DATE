+def _interior_layers(interior: set[tuple[int, int]], fence_mask: np.ndarray) -> dict[tuple[int, int], int]:
+    h, w = fence_mask.shape
+    dist: dict[tuple[int, int], int] = {}
+    q = deque()
+    for r, c in interior:
+        if any(
+            0 <= r + dr < h and 0 <= c + dc < w and bool(fence_mask[r + dr, c + dc])
