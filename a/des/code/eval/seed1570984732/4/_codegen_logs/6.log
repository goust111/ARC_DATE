+def _find_interior_and_fence(grid: np.ndarray) -> tuple[set[tuple[int, int]], int]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    bg = int(Counter(map(int, g.ravel())).most_common(1)[0][0])
