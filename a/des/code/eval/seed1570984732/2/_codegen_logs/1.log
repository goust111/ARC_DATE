+
+
+def _place_piece_anywhere(
+    grid: np.ndarray, blocked: np.ndarray, mask: np.ndarray, color: int, rng: random.Random
+) -> bool:
+    gh, gw = map(int, grid.shape)
+    ph, pw = map(int, mask.shape)
+    candidates = []
