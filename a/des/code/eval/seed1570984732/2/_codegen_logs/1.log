+    min_side = max(frame_size + 8, 18)
+    max_side = max(min_side, 28)
+    grid_h = rng.randint(min_side, max_side)
+    grid_w = rng.randint(min_side, max_side)
+    grid = np.zeros((grid_h, grid_w), dtype=int)
