+    return True
+
+
+def _generate_distractor_shape(
+    hole_keys: set[tuple[tuple[int, int], bytes]],
+    used_keys: set[tuple[tuple[int, int], bytes]],
+    max_side: int,
+    rng: random.Random,
+) -> np.ndarray | None:
