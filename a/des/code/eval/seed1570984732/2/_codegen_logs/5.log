+        mask = _random_shape(area, cell_h, cell_w)
+        if mask is None:
+            continue
+
+        h, w = mask.shape
+        rotated = _rotate_cw(mask, turns)
+        rh, rw = rotated.shape
+        max_top = cell_h - max(h, rh)
+        max_left = cell_w - max(w, rw)
+        if max_top < 0 or max_left < 0:
+            continue
