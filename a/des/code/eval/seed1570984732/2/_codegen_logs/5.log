+def _bands(length: int, separators: list[int]) -> list[tuple[int, int]]:
+    seps = sorted(int(s) for s in separators)
+    assert len(seps) == 2
+    bands: list[tuple[int, int]] = []
+    start = 0
+    for sep in seps:
+        assert start < sep < length
+        bands.append((start, sep))
+        start = sep + 1
+    assert start < length
+    bands.append((start, length))
+    return bands
