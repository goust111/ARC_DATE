+            tri, tci = 2 - ri, 2 - ci
+            tr0, tr1 = row_bands[tri]
+            tc0, tc1 = col_bands[tci]
+            cell_h = tr1 - tr0
+            cell_w = tc1 - tc0
+            assert local_r + rotated.shape[0] <= cell_h
+            assert local_c + rotated.shape[1] <= cell_w
+            _paste(out, rotated, tr0 + local_r, tc0 + local_c, bg)
+
+    return out
+
