+    ref[0, 0] = perm[0]
+    ref[0, 2] = perm[1]
+    ref[2, 2] = perm[2]
+    ref[2, 0] = perm[3]
+
+    top = int(RNG.integers(0, center_cell.shape[0] - 2))
+    left = int(RNG.integers(0, center_cell.shape[1] - 2))
+    center_cell[top : top + 3, left : left + 3] = ref
