+            inp[r0 : r0 + outer_h, c0] = BORDER
+            inp[r0 : r0 + outer_h, c0 + outer_w - 1] = BORDER
+            inp[r0 + 1 + sr, c0 + 1 + sc] = color
+
+            used_boxes.append(box)
+            region_specs.append((r0, c0, inner_h, inner_w, (sr, sc), color))
+            placed = True
+            break
