+
+
+def _generate_once() -> np.ndarray | None:
+    height = random.randint(18, 30)
+    width = random.randint(18, 30)
+    scene_r0 = 4
+    scene_c0 = 4
+    scene_h = height - scene_r0
+    scene_w = width - scene_c0
