+    seen = [False] * n
+    comps: list[list[int]] = []
+    for start in range(n):
+        if seen[start]:
+            continue
+        stack = [start]
+        seen[start] = True
+        comp = []
+        while stack:
+            node = stack.pop()
+            comp.append(node)
+            for nxt in graph[node]:
+                if not seen[nxt]:
+                    seen[nxt] = True
