+    else:
+        specs = [(2, "tie"), (2, "tie")]
+        specs.extend((1, "solo") for _ in range(int(RNG.integers(0, 2))))
+    RNG.shuffle(specs)
+    return [(int(size), mode) for size, mode in specs]
+
+
+def _place_horizontal(h: int, left_w: int, specs: list[tuple[int, str]]) -> np.ndarray | None:
