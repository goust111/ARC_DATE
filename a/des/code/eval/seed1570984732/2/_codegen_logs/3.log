+    gaps = [int(RNG.integers(GAP_RANGE[0], GAP_RANGE[1])) for _ in range(max(0, size - 1))]
+    total_gap = sum(gaps)
+    if positive_dir:
+        lo = total_gap
+        hi = axis_len - 4
+        if hi < lo:
+            return None
+        front = int(RNG.integers(lo, hi + 1))
+        anchors = [front]
+        pos = front
+        for gap in reversed(gaps):
+            pos -= gap
+            anchors.append(pos)
+        anchors.sort()
+        return anchors
+
+    lo = 1
+    hi = axis_len - 3 - total_gap
+    if hi < lo:
+        return None
+    front = int(RNG.integers(lo, hi + 1))
+    anchors = [front]
+    pos = front
+    for gap in gaps:
