+def _spaced_choices(pool: list[int], count: int, min_sep: int = 2) -> list[tuple[int, ...]]:
+    if count == 0:
+        return [()]
+    out = []
+    for combo in itertools.combinations(pool, count):
+        if all(combo[i + 1] - combo[i] >= min_sep for i in range(len(combo) - 1)):
+            out.append(combo)
+    return out
