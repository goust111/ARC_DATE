+def _draw_fence(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int, rows: list[int], cols: list[int]) -> None:
+    grid[r0, c0 : c1 + 1] = FENCE
+    grid[r1, c0 : c1 + 1] = FENCE
+    grid[r0 : r1 + 1, c0] = FENCE
+    grid[r0 : r1 + 1, c1] = FENCE
+    for r in rows:
+        grid[r, c0] = BG
+        grid[r, c1] = BG
+    for c in cols:
+        grid[r0, c] = BG
+        grid[r1, c] = BG
