+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    builder = _build_row_mode if rng.random() < 0.5 else _build_col_mode
+    built = builder(rng)
+    if built is None:
+        return None
+    inp, expected = built
+    if not np.array_equal(main(inp), expected):
+        return None
+    return inp
