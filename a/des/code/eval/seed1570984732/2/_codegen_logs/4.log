  "src": "marked horizontal bars and the vertical marker column",
  "transform": "recolor each row by the nearest source bar color; each source bar row becomes a marker separator row, and equal-distance rows between different bar colors become plain separator rows"
}
</annotation>
</reference_puzzle>

