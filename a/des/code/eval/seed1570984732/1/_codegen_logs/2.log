+LAYOUTS = [(2, 2), (2, 3), (3, 2), (2, 4), (4, 2)]
+CELL_H_RANGE = (5, 8)
+CELL_W_RANGE = (5, 8)
+FRAME_RIGHT_MARGIN = (1, 3)
+FRAME_GAP_RANGE = (3, 6)
+TOP_BOTTOM_MARGIN = (1, 4)
+GRID_EXTRA_HEIGHT = (0, 6)
+GEN_TRIES = 400
+PIECE_PADDING = 1
