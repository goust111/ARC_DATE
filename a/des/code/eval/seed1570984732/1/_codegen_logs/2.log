+                        break
+                if not ok:
+                    break
+            if not ok:
+                break
+        if not ok:
+            continue
+        grid[r0 : r0 + ph, c0 : c0 + pw][patch != BG] = patch[patch != BG]
+        occ[r0 : r0 + ph, c0 : c0 + pw] |= patch != BG
+        return r0, c0
