+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        h, w = patch.shape
+        rows = [r for r in range(h) if bool(np.all(patch[r] == color))]
+        cols = [c for c in range(w) if bool(np.all(patch[:, c] == color))]
+        if len(rows) < 2 or len(cols) < 2:
