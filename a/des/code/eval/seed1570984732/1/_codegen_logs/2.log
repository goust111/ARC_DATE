+        if len(set(row_gaps)) != 1 or len(set(col_gaps)) != 1:
+            continue
+        line_mask = np.zeros((h, w), dtype=bool)
+        line_mask[rows, :] = True
+        line_mask[:, cols] = True
+        if not bool(np.all((patch == color) == line_mask)):
