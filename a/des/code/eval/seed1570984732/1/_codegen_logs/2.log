+    for i in range(rows + 1):
+        rr = top + i * (cell_h + 1)
+        grid[rr, left : left + w] = FRAME
+    for j in range(cols + 1):
+        cc = left + j * (cell_w + 1)
+        grid[top : top + h, cc] = FRAME
+
