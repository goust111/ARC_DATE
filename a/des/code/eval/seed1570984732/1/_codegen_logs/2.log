+def _slot_bbox(top: int, left: int, cell_h: int, cell_w: int, coord: tuple[int, int]) -> tuple[int, int, int, int]:
+    r, c = coord
+    r0 = top + 1 + r * (cell_h + 1)
+    c0 = left + 1 + c * (cell_w + 1)
+    return r0, c0, r0 + cell_h - 1, c0 + cell_w - 1
