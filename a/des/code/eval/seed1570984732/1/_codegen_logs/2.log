+        if rows[0] != 0 or rows[-1] != h - 1 or cols[0] != 0 or cols[-1] != w - 1:
+            continue
+        row_gaps = [rows[i + 1] - rows[i] - 1 for i in range(len(rows) - 1)]
+        col_gaps = [cols[i + 1] - cols[i] - 1 for i in range(len(cols) - 1)]
+        if min(row_gaps) <= 0 or min(col_gaps) <= 0:
