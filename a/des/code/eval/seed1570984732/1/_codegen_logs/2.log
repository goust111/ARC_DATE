+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for dr, dc in DIR_STEP.values():
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
