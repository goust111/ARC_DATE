/bin/bash -lc "python - <<'PY'
import random, numpy as np

BG=0
SEP=5
COLOR_POOL=(1,2,3,4,6,7,8,9)
SCENE_H_RANGE=(8,18)
SCENE_W_RANGE=(10,24)
RECT_COUNT_RANGE=(2,5)
MAX_GEN=400
PLACEMENT_TRIES=300


def bbox(mask):
    pts=np.argwhere(mask)
    if pts.size==0:
        return None
    r0,c0=pts.min(axis=0)
    r1,c1=pts.max(axis=0)
    return int(r0),int(c0),int(r1),int(c1)


def extract_order(strip):
    cols=np.flatnonzero(strip"'!=BG)
    colors=[int(strip[c]) for c in cols]
    assert colors and len(colors)==len(set(colors))
    return colors


def infer(scene, order):
    present={int(v) for v in np.unique(scene) if int(v)!=BG}
    assert present == set(order)
    higher=np.zeros_like(scene, dtype=bool)
    rects={}
    for color in reversed(order):
        vis=scene==color
        b=bbox(vis)
        assert b is not None
        r0,c0,r1,c1=b
        box=np.zeros_like(scene, dtype=bool)
        box[r0:r1+1, c0:c1+1]=True
        assert not np.any(box & ~(vis | higher))
        rects[color]=b
        higher |= box
    return rects


def compose(order, rects):
    hs=[rects[c][2]-rects[c][0]+1 for c in order]
    ws=[rects[c][3]-rects[c][1]+1 for c in order]
    out=np.full((max(hs), sum(ws)+len(order)-1), BG, dtype=int)
    col=0
    for i,c in enumerate(order):
        h=hs[i]; w=ws[i]
        out[:h, col:col+w]=c
        col += w
        if i < len(order)-1:
            out[:, col]=SEP
            col += 1
    return out


def main(grid):
    g=np.asarray(grid, dtype=int)
    order=extract_order(g[-1])
    rects=infer(g[:-1], order)
    return compose(order, rects)


def sample_positions(width,n):
    base=sorted(random.sample(range(width-(n-1)), n))
    return [v+i for i,v in enumerate(base)]


def choose_dims(H,W):
    mode=random.randrange(3)
    if mode==0:
        h=random.randint(2, min(H,4))
        w=random.randint(4, min(W,8))
    elif mode==1:
        h=random.randint(4, min(H,8))
        w=random.randint(2, min(W,4))
    else:
        h=random.randint(2, min(H,7))
        w=random.randint(2, min(W,7))
    return h,w


def sample_bbox(H,W,higher, force_overlap):
    for _ in range(PLACEMENT_TRIES):
        h,w=choose_dims(H,W)
        r0=random.randint(0, H-h)
        c0=random.randint(0, W-w)
        box=np.zeros((H,W), dtype=bool)
        box[r0:r0+h,c0:c0+w]=True
        overlap=box & higher
        overlap_n=int(overlap.sum())
        if force_overlap and overlap_n==0:
            continue
        visible = box & ~higher
        vis_n=int(visible.sum())
        area=h*w
        if vis_n == 0:
            continue
        if vis_n < max(4, (area+4)//5):
            continue
        b=bbox(visible)
        if b != (r0,c0,r0+h-1,c0+w-1):
            continue
        return (r0,c0,r0+h-1,c0+w-1), overlap_n
    return None, None


def render(H,W, layers):
    scene=np.full((H,W), BG, dtype=int)
    rects={}
    for color,b in layers: # bottom to top
        r0,c0,r1,c1=b
        scene[r0:r1+1,c0:c1+1]=color
        rects[color]=b
    return scene, rects


def gen():
    for _ in range(MAX_GEN):
        n=random.randint(*RECT_COUNT_RANGE)
        H=random.randint(*SCENE_H_RANGE)
        W=random.randint(max(SCENE_W_RANGE[0], 2*n-1), SCENE_W_RANGE[1])
        order=random.sample(COLOR_POOL, n)
        higher=np.zeros((H,W), dtype=bool)
        top_down=[]
        overlap_layers=0
        ok=True
        for idx,color in enumerate(reversed(order)):
            force_overlap = idx > 0 and (random.random() < 0.75)
            if idx == n-1 and overlap_layers==0:
                force_overlap = True
            b, ov = sample_bbox(H,W,higher, force_overlap)
            if b is None:
                ok=False; break
            if ov:
                overlap_layers += 1
            top_down.append((color,b))
            r0,c0,r1,c1=b
            higher[r0:r1+1,c0:c1+1]=True
        if not ok or overlap_layers==0:
            continue
        layers=list(reversed(top_down))
        scene, rects=render(H,W,layers)
        out=compose(order, rects)
        if out.shape[0] > 30 or out.shape[1] > 30:
            continue
        strip=np.zeros(W, dtype=int)
        for cpos,color in zip(sample_positions(W,n), order):
            strip[cpos]=color
        inp=np.vstack([scene, strip[None,:]])
        try:
            got=main(inp)
        except Exception as e:
            # print('"'main fail', e)
            continue
        if not np.array_equal(got, out):
            print('mismatch')
            print(order)
            print(rects)
            return None
        return inp
    return None

count=0
sigs=set()
for i in range(200):
    arr=gen()
    if arr is None:
        print('gen failed at', i)
        break
    sigs.add((arr.shape, arr.tobytes()))
    count += 1
print('count', count, 'unique', len(sigs))
