+
+def _reserve(mask: np.ndarray, top: int, left: int, height: int, width: int, pad: int) -> None:
+    h, w = mask.shape
+    r0 = max(0, top - pad)
+    c0 = max(0, left - pad)
+    r1 = min(h, top + height + pad)
+    c1 = min(w, left + width + pad)
