+            _paste_non_bg(expected, entry["outline"], top, left, bg)
+            _fill_target(expected, top, left, entry["interior"], legend_textures[entry["category"]])
+            _reserve(reserved, top, left, entry["h"], entry["w"], pad=1)
+            placed = True
+            break
