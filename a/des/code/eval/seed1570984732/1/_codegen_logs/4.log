+    scene_left = legend_right + 3
+    if scene_left >= w - 4:
+        raise RuntimeError("not enough room for target shapes")
+
+    for entry in target_entries:
+        placed = False
+        for _ in range(PLACE_RETRIES):
+            top = random.randint(1, h - entry["h"] - 1)
+            left = random.randint(scene_left, w - entry["w"] - 1)
+            if not _can_place(reserved, top, left, entry["h"], entry["w"], pad=1):
