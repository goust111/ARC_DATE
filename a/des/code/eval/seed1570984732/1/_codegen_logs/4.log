+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+AZURE = 8
+
+MIN_GRID_H = 22
+MAX_GRID_H = 30
+MIN_GRID_W = 24
+MAX_GRID_W = 30
