+    has_r90 = tight.shape[0] == tight.shape[1] and bool(np.array_equal(tight, np.rot90(tight)))
+    if has_r90:
+        return "rot4"
+    if has_h and has_v:
+        return "both"
+    if has_h:
+        return "h"
+    if has_v:
+        return "v"
+    return "none"
