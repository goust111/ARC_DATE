+        cols = coords[:, 1]
+        r0, c0, r1, c1 = int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+        local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
