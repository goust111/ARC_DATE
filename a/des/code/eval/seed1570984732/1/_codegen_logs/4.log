+
+def _mode_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[counts.argmax()])
+
+
+def _bbox_from_mask(mask: np.ndarray) -> tuple[int, int, int, int]:
+    coords = np.argwhere(mask)
+    assert coords.size > 0
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _tight_crop(mask: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox_from_mask(mask)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _components(mask: np.ndarray, connectivity: int) -> list[np.ndarray]:
+    dirs = NEIGHBORS4 if connectivity == 4 else NEIGHBORS8
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in dirs:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = mask.copy()
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            src_r0 = max(0, -dr)
+            src_r1 = min(h, h - dr)
+            src_c0 = max(0, -dc)
+            src_c1 = min(w, w - dc)
+            dst_r0 = src_r0 + dr
+            dst_r1 = src_r1 + dr
+            dst_c0 = src_c0 + dc
+            dst_c1 = src_c1 + dc
+            out[dst_r0:dst_r1, dst_c0:dst_c1] |= mask[src_r0:src_r1, src_c0:src_c1]
+    return out
+
+
+def _outline_patch_from_interior(interior: np.ndarray) -> np.ndarray:
+    padded = np.pad(interior.astype(bool), 1)
+    outline = _dilate8(padded) & ~padded
+    patch = np.full(outline.shape, AZURE, dtype=int)
+    patch[outline] = BLACK
+    return patch
+
