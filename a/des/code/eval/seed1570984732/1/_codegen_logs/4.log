+        if not np.all(grid[sample_r0 : sample_r0 + tex_h, c1 + 1] == bg):
+            continue
+        texture = grid[sample_r0 : sample_r0 + tex_h, sample_c0 : sample_c0 + tex_w]
+        if texture.shape != (tex_h, tex_w):
+            continue
