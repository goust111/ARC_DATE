+def _variants(mask: np.ndarray) -> list[np.ndarray]:
+    seen: set[bytes] = set()
+    out: list[np.ndarray] = []
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        for candidate in (rot, np.fliplr(rot)):
+            key = candidate.tobytes() + bytes(candidate.shape)
+            if key in seen:
+                continue
+            seen.add(key)
+            out.append(candidate.copy())
+    return out
