+def _texture_pattern(kind: str, colors: list[int], shape: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    out = np.zeros((h, w), dtype=int)
+    for r in range(h):
+        for c in range(w):
+            if kind == "checker":
+                idx = (r + c) % len(colors)
+            elif kind == "vstripe":
+                idx = c % len(colors)
+            elif kind == "hstripe":
+                idx = r % len(colors)
+            elif kind == "diag_down":
+                idx = (r + 2 * c) % len(colors)
+            elif kind == "diag_up":
+                idx = (r - c) % len(colors)
+            else:
