+
+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = mask.copy()
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            src_r0 = max(0, -dr)
+            src_r1 = min(h, h - dr)
+            src_c0 = max(0, -dc)
+            src_c1 = min(w, w - dc)
+            dst_r0 = src_r0 + dr
+            dst_r1 = src_r1 + dr
+            dst_c0 = src_c0 + dc
+            dst_c1 = src_c1 + dc
+            out[dst_r0:dst_r1, dst_c0:dst_c1] |= mask[src_r0:src_r1, src_c0:src_c1]
+    return out
