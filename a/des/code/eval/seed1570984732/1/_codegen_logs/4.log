+                if open_cells[rr, cc] and not outside[rr, cc]:
+                    outside[rr, cc] = True
+                    stack.append((rr, cc))
+        for cc in range(local.shape[1]):
+            for rr in (0, local.shape[0] - 1):
+                if open_cells[rr, cc] and not outside[rr, cc]:
+                    outside[rr, cc] = True
+                    stack.append((rr, cc))
+        while stack:
+            rr, cc = stack.pop()
+            for dr, dc in NEIGHBORS4:
+                nr, nc = rr + dr, cc + dc
+                if 0 <= nr < local.shape[0] and 0 <= nc < local.shape[1]:
