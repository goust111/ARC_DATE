+
+def _generate_case() -> tuple[np.ndarray, np.ndarray]:
+    bg = AZURE
+    legend_shapes = {category: _sample_shape(category, (1,)) for category in CATEGORIES}
+    target_categories = list(CATEGORIES)
+    extra_count = random.randint(0, 3)
