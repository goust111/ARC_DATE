+        local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        local[rows - r0, cols - c0] = True
+        open_cells = ~local
+        outside = np.zeros_like(local, dtype=bool)
+        stack: list[tuple[int, int]] = []
+        for rr in range(local.shape[0]):
+            for cc in (0, local.shape[1] - 1):
