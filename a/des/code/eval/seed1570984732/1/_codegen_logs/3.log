+def _single_region_plan(h: int, w: int, axis_type: str) -> dict[str, object]:
+    for _ in range(200):
+        portal = _sample_portal(h, w, axis_type)
+        ar, ac = portal["anchor"]
+        if axis_type == "v":
+            end = (random.randint(1, h - 2), random.randint(1, w - 2))
+            if end[1] == ac:
+                continue
+            if abs(end[0] - ar) + abs(end[1] - ac) < 2:
+                continue
+            bend = (ar, end[1])
+        else:
+            end = (random.randint(1, h - 2), random.randint(1, w - 2))
+            if end[0] == ar:
+                continue
+            if abs(end[0] - ar) + abs(end[1] - ac) < 2:
+                continue
+            bend = (end[0], ac)
+        path = _segment((ar, ac), bend)
+        if bend != end:
