+    for i in range(n_pairs):
+        earlier = chain[i]
+        later = chain[i + 1]
+        earlier_axis = "v" if first_axis_vertical else "h"
+        later_axis = "h" if first_axis_vertical else "v"
+        spec = {"color": portal_colors[i], "regions": (earlier, later)}
+        pair_specs.append(spec)
