+            seen[r, c] = True
+            q = deque([(r, c)])
+            cells: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((int(cr), int(cc)))
+                for dr, dc in NEIGHBORS4:
