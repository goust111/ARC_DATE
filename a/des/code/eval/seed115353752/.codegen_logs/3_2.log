+    rel_cells = [_transform_point((r - marker[0], c - marker[1]), turns, flip) for r, c in cells]
+    rows = [r for r, _ in rel_cells]
+    cols = [c for _, c in rel_cells]
+    min_r, max_r = min(rows), max(rows)
+    min_c, max_c = min(cols), max(cols)
