+        except ValueError:
+            continue
+        key = _canonical_key(mask)
+        if key in seen:
+            continue
+        seen.add(key)
+        out.append(mask)
+    if len(out) != n:
+        raise ValueError("failed to sample distinct shapes")
+    return out
