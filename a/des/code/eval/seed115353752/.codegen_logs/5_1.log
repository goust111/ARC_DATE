+
+def _variants(mask: np.ndarray) -> list[np.ndarray]:
+    out: list[np.ndarray] = []
+    seen: set[bytes] = set()
+    for code in range(8):
+        variant = _transform(mask, code)
+        key = bytes([variant.shape[0], variant.shape[1]]) + variant.tobytes()
+        if key in seen:
+            continue
+        seen.add(key)
+        out.append(variant)
+    return out
