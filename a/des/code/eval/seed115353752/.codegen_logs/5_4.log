+        if _adjacent_to_color(grid, (rr, cc), GREY):
+            bulbs.append((rr, cc))
+    bulbs.sort()
+    assert bulbs, "expected at least one connected bulb"
+    return bulbs
+
+
+def _switch_edges(grid: np.ndarray) -> dict[tuple[int, int], set[tuple[int, int]]]:
+    edges: dict[tuple[int, int], set[tuple[int, int]]] = {}
+    h, w = grid.shape
