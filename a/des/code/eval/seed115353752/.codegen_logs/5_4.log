+import numpy as np
+
+
+BG = 0
+RED = 2
+GREEN = 3
+GREY = 5
+SOURCE_COL = 1
+
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SOURCE_COLOR_POOL = [1, 4, 6, 7, 8, 9]
+MAX_ATTEMPTS = 400
