+                continue
+            sub = np.zeros((h, w), dtype=bool)
+            sub[comp[:, 0] - r0, comp[:, 1] - c0] = True
+            border = np.zeros((h, w), dtype=bool)
+            border[0, :] = True
+            border[-1, :] = True
+            border[:, 0] = True
+            border[:, -1] = True
+            if np.array_equal(sub, border):
