+    sub[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return {
+        "color": int(color),
+        "anchor": anchor,
+        "bbox": (r0, c0, r1, c1),
+        "mask": sub,
+        "coords": coords,
+    }
