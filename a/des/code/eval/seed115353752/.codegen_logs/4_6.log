+    elif side == "left":
+        idx = np.flatnonzero(mask[:, 0])
+    else:
+        idx = np.flatnonzero(mask[:, -1])
+    assert len(idx) == 1, "the aligned source edge must have exactly one active pixel"
+    return int(idx[0])
