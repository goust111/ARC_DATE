+    while len(sides) < num_sources:
+        sides.append(str(SIDES[int(rng.integers(len(SIDES)))]))
+    rng.shuffle(sides)
+
+    want_overlap = bool(rng.integers(0, 2))
+    want_clip = bool(rng.integers(0, 2))
