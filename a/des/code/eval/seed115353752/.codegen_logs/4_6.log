+import numpy as np
+
+
+BG = 0
+FRAME = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+SIDES = ("top", "bottom", "left", "right")
+
+GEN_ATTEMPTS = 400
+ANCHOR_TRIES = 80
+PLACE_TRIES = 80
+
+INNER_H_RANGE = (8, 15)
+INNER_W_RANGE = (8, 15)
+TOP_MARGIN_RANGE = (5, 10)
+BOTTOM_MARGIN_RANGE = (3, 7)
+SIDE_MARGIN_RANGE = (4, 9)
+NUM_SOURCES_RANGE = (2, 6)
+SOURCE_H_RANGE = (2, 6)
+SOURCE_W_RANGE = (2, 6)
