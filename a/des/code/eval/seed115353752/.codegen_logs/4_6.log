+    num_sources = int(rng.integers(NUM_SOURCES_RANGE[0], NUM_SOURCES_RANGE[1]))
+    colors = list(rng.choice(COLOR_POOL, size=num_sources, replace=False))
+    base_sides = list(rng.permutation(SIDES))
