+        _aligned_edge_index(source["mask"], _anchor_side(anchor, frame_bbox))
+        sources.append(source)
+    return _build_output(g, frame_bbox, sources)
+
+
+def _on_forbidden_edge(cell: tuple[int, int], side: str, h: int, w: int, entry: tuple[int, int]) -> bool:
+    r, c = cell
+    if cell == entry:
+        return False
+    if side == "top":
+        return r == 0
+    if side == "bottom":
+        return r == h - 1
+    if side == "left":
+        return c == 0
+    return c == w - 1
+
+
+def _step_inward(cell: tuple[int, int], side: str) -> tuple[int, int]:
+    r, c = cell
+    if side == "top":
+        return r + 1, c
+    if side == "bottom":
+        return r - 1, c
+    if side == "left":
+        return r, c + 1
+    return r, c - 1
+
+
+def _connect_path(
+    start: tuple[int, int],
+    target: tuple[int, int],
+    side: str,
+    h: int,
+    w: int,
+    entry: tuple[int, int],
