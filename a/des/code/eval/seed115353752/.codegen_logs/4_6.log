+    if side == "top":
+        return r + 1, c
+    if side == "bottom":
+        return r - 1, c
+    if side == "left":
+        return r, c + 1
+    return r, c - 1
+
+
+def _connect_path(
+    start: tuple[int, int],
+    target: tuple[int, int],
+    side: str,
+    h: int,
+    w: int,
+    entry: tuple[int, int],
+) -> list[tuple[int, int]]:
