+
+def _project_cells(
+    mask: np.ndarray,
+    side: str,
+    anchor: tuple[int, int],
+    frame_bbox: tuple[int, int, int, int],
+) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = frame_bbox
+    h, w = mask.shape
+    k = _aligned_edge_index(mask, side)
+    cells: list[tuple[int, int]] = []
