+    for dr, dc in np.argwhere(mask):
+        if side == "top":
+            rr = r0 + 1 + int(dr)
+            cc = anchor[1] + int(dc) - k
+        elif side == "bottom":
+            rr = r1 - h + int(dr)
+            cc = anchor[1] + int(dc) - k
+        elif side == "left":
+            rr = anchor[0] + int(dr) - k
+            cc = c0 + 1 + int(dc)
+        else:
+            rr = anchor[0] + int(dr) - k
+            cc = c1 - w + int(dc)
