+        align = gc
+    elif gc == c1 and r0 < gr < r1:
+        side = "right"
+        align = gr
+    elif gr == r1 and c0 < gc < c1:
+        side = "bottom"
+        align = gc
+    elif gc == c0 and r0 < gr < r1:
+        side = "left"
+        align = gr
+    else:
+        return None
+
+    return {
+        "color": int(comp["color"]),
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "gap": (int(gr), int(gc)),
