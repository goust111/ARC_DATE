+def _sample_connected_shape(
+    rng: np.random.Generator,
+    max_h: int,
+    max_w: int,
+    area: int,
+) -> list[tuple[int, int]] | None:
+    dims = [(h, w) for h in range(1, max_h + 1) for w in range(1, max_w + 1) if h * w >= area]
+    if not dims:
+        return None
+    h, w = dims[int(rng.integers(0, len(dims)))]
