+        candidates = sorted((r, c) for r, c in coords if r == edge)
+        return candidates[len(candidates) // 2]
+    if side == "left":
+        edge = min(c for _, c in coords)
+        candidates = sorted((r, c) for r, c in coords if c == edge)
+        return candidates[len(candidates) // 2]
