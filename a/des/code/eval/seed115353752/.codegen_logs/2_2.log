+        return None
+    return candidates[int(rng.integers(0, len(candidates)))]
+
+
+def _patch_from_cells(cells: list[tuple[int, int]], color: int) -> np.ndarray:
+    h, w = _shape_dims(cells)
+    patch = np.full((h, w), BG, dtype=int)
+    for r, c in cells:
+        patch[r, c] = color
