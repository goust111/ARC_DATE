+        dc = align - anchor_c
+    elif side == "bottom":
+        dr = (r0 + 1) - min(rows)
+        dc = align - anchor_c
+    elif side == "left":
+        dr = align - anchor_r
+        dc = (c1 - 1) - max(cols)
+    else:
+        dr = align - anchor_r
+        dc = (c0 + 1) - min(cols)
