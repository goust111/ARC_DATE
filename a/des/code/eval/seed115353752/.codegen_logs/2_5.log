+
+
+def _in_bounds(h: int, w: int, r: int, c: int) -> bool:
+    return 0 <= r < h and 0 <= c < w
+
+
+def _perp(direction: tuple[int, int]) -> tuple[int, int]:
+    dr, dc = direction
+    return (1, 0) if dr == 0 else (0, 1)
