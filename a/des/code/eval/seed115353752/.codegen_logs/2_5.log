GRID_MIN = 18
GRID_MAX = 32
PLACEMENT_TRIES = 120
GENERATION_TRIES = 400

DIRS = {
    "right": (0, 1),
    "left": (0, -1),
    "down": (1, 0),
    "up": (-1, 0),
}

ARROW_TEMPLATES = {
    "stub": {
        "offsets": ((0, 0), (0, 1), (0, 2), (-1, 2), (1, 2)),
        "aim": (0, 2),
    },
    "tip": {
        "offsets": ((0, 0), (0, 1), (0, 2), (-1, 3), (0, 4), (1, 3)),
