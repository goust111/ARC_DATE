+
+def _transform_offset(
+    origin: tuple[int, int], direction: tuple[int, int], offset: tuple[int, int]
+) -> tuple[int, int]:
+    pr, pc = _perp(direction)
+    dr, dc = direction
+    off_r, off_c = offset
+    return (
+        origin[0] + off_r * pr + off_c * dr,
+        origin[1] + off_r * pc + off_c * dc,
+    )
