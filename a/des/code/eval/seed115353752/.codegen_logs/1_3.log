+    return abs(a[0] - b[0]) + abs(a[1] - b[1])
+
+
+def _find_nodes(grid: np.ndarray) -> dict[tuple[int, int], tuple[int, int]]:
+    h, w = grid.shape
+    nodes: dict[tuple[int, int], tuple[int, int]] = {}
+    used: set[tuple[int, int]] = set()
+    for r in range(1, h - 1):
