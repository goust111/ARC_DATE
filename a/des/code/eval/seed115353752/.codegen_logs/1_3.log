+
+
+def _sample_positions(
+    rng: random.Random,
+    count: int,
+    lo: int,
+    hi: int,
+    min_gap: int,
+) -> list[int] | None:
+    if count <= 0:
+        return []
+    if lo + (count - 1) * min_gap > hi:
+        return None
+    positions: list[int] = []
+    next_lo = lo
+    for idx in range(count):
+        remaining = count - idx - 1
+        max_pos = hi - remaining * min_gap
+        if next_lo > max_pos:
+            return None
+        pos = rng.randint(next_lo, max_pos)
+        positions.append(pos)
+        next_lo = pos + min_gap
+    return positions
