    dest_cells: list[tuple[int, int]] = []
    for r in range(cr - 1, cr + 2):
        for c in range(cc - 1, cc + 2):
            if 0 <= r < h and 0 <= c < w:
                dest_cells.append((r, c))
    dest_cells.sort()
    dest_set = set(dest_cells)

    # Infer floor color from the ring around the destination.
