+    seen = {start}
+    stack = [start]
+    chosen: set[int] = set()
+
+    while stack:
+        cell = stack[-1]
+        options = [(nbr, idx) for nbr, idx in adjacency[cell] if nbr not in seen]
+        if not options:
+            stack.pop()
