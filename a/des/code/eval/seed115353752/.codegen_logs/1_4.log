+    max_colors = min(3, len(palette), total - 1)
+    n_colors = random.randint(2, max_colors)
+    while n_colors >= 2:
+        majority_low = max(2, total // 2 + 1)
+        majority_high = total - (n_colors - 1)
+        if majority_low <= majority_high:
