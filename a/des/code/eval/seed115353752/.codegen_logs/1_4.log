+    for cell in range(n_rows * n_cols):
+        groups[uf.find(cell)].append(cell)
+
+    return {
+        "grid": g,
+        "bg": int(bg),
+        "grey": int(grey),
+        "row_lines": row_lines,
+        "col_lines": col_lines,
+        "row_spans": row_spans,
+        "col_spans": col_spans,
+        "cells": cells,
+        "groups": groups,
+        "n_rows": int(n_rows),
+        "n_cols": int(n_cols),
+        "bridges": bridges,
