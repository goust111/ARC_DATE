+    g = info["grid"]
+    bg = int(info["bg"])
+    grey = int(info["grey"])
+    cells: dict[int, tuple[int, int, int, int]] = info["cells"]  # type: ignore[assignment]
+    groups: dict[int, list[int]] = info["groups"]  # type: ignore[assignment]
