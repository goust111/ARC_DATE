+def _build_case() -> np.ndarray:
+    n_rows = random.randint(*CELL_ROW_RANGE)
+    n_cols = random.randint(*CELL_COL_RANGE)
+    row_sizes = [random.randint(*CELL_SIZE_RANGE) for _ in range(n_rows)]
