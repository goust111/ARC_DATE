+def _spans_from_lines(lines: list[int], limit: int) -> list[tuple[int, int]]:
+    assert len(lines) >= 2, "expected border-delimited table lines"
+    assert lines[0] == 0 and lines[-1] == limit - 1, "table should cover the full grid"
