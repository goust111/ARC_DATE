def _sample_frame_specs(template_count: int) -> list[dict[str, int]]:
    frame_count = random.randint(1, 4)
    counts = list(range(1, template_count + 1))
    random.shuffle(counts)
    picked = counts[: min(frame_count, template_count)]
    while len(picked) < frame_count:
        picked.append(random.randint(1, template_count))
    random.shuffle(picked)

    frames: list[dict[str, int]] = []
    for count in picked:
        inner_h = random.randint(3, 8)
        inner_w = random.randint(3, 8)
        frames.append(
            {
                "count": int(count),
                "h": int(inner_h + 2),
                "w": int(inner_w + 2),
            }
        )
    return frames


def _sample_grid_shape(frames: list[dict[str, int]], legend_w: int) -> tuple[int, int]:
    max_frame_h = max(frame["h"] for frame in frames)
    max_frame_w = max(frame["w"] for frame in frames)
    frame_area = sum(frame["h"] * frame["w"] for frame in frames)
    base = int(np.ceil(np.sqrt(frame_area + 3 * legend_w))) + 6
    h_min = max(14, max_frame_h + 2, base - 1)
    w_min = max(18, legend_w + 3, max_frame_w + 2, base + 1)
    h_max = max(h_min, min(30, h_min + 8))
    w_max = max(w_min, min(34, w_min + 10))
    return random.randint(h_min, h_max), random.randint(w_min, w_max)


def _gen_attempt() -> np.ndarray | None:
    templates = _sample_templates()
    legend = _legend_from_templates(templates)
    frames = _sample_frame_specs(len(templates))
    h, w = _sample_grid_shape(frames, legend.shape[1])
    if h < 3 or w < legend.shape[1]:
        return None

    grid = np.zeros((h, w), dtype=int)
    occupied = np.zeros((h, w), dtype=bool)

    legend_r0 = h - 3
    legend_c0 = w - legend.shape[1]
    grid[legend_r0:h, legend_c0:w] = legend
    _mark_occupied(occupied, legend_r0, legend_c0, 3, legend.shape[1])

    placed: list[dict[str, int]] = []
    order = sorted(range(len(frames)), key=lambda idx: -(frames[idx]["h"] * frames[idx]["w"]))
    for idx in order:
        frame = frames[idx]
        fh = int(frame["h"])
        fw = int(frame["w"])
        placed_here = False
        for _ in range(200):
            r0 = random.randint(0, h - fh)
            c0 = random.randint(0, w - fw)
            if not _can_place(occupied, r0, c0, fh, fw):
                continue
            frame["r0"] = int(r0)
            frame["c0"] = int(c0)
            _mark_occupied(occupied, r0, c0, fh, fw)
            placed.append(frame)
            placed_here = True
            break
        if not placed_here:
            return None

    for frame in placed:
        r0 = int(frame["r0"])
        c0 = int(frame["c0"])
        fh = int(frame["h"])
        fw = int(frame["w"])
        grid[r0, c0 : c0 + fw] = int(GREY)
        grid[r0 + fh - 1, c0 : c0 + fw] = int(GREY)
        grid[r0 : r0 + fh, c0] = int(GREY)
        grid[r0 : r0 + fh, c0 + fw - 1] = int(GREY)
        _scatter_interior_points(grid, r0, c0, fh, fw, int(frame["count"]))

    expected = _expected_output(grid, placed, templates)
    try:
        actual = main(grid)
    except Exception:
        return None
    if np.array_equal(actual, expected):
        return grid
    return None


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid input for ARC stamp-count puzzle")

