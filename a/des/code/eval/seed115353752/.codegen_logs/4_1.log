+    gh, gw = grid.shape
+    h, w = mask.shape
+    for _ in range(attempts):
+        top = rng.randint(0, gh - h)
+        left = rng.randint(0, gw - w)
+        if not _can_place_patch(grid, mask, top, left, pad=1, forbidden=forbidden):
