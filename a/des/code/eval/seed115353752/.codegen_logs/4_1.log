+        inner_corner_map = {
+            "tl": (r0 + 1, c0 + 1),
+            "tr": (r0 + 1, c1 - 1),
+            "bl": (r1 - 1, c0 + 1),
+            "br": (r1 - 1, c1 - 1),
+        }
+        marker_corners = [corner for corner, pos in inner_corner_map.items() if int(g[pos]) == YELLOW]
