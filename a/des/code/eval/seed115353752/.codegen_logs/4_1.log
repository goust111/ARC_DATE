+        for comp in _components_from_mask(gap_mask):
+            mask = _coords_to_mask((tuple(map(int, pt)) for pt in comp))
+            gaps.append(
+                {
+                    "cells": [tuple(map(int, pt)) for pt in comp],
+                    "mask": mask,
+                    "color": color,
+                }
+            )
+        containers.append(
+            {
+                "color": color,
+                "bbox": (r0, c0, r1, c1),
+                "corner": marker_corners[0],
+                "gaps": gaps,
+            }
