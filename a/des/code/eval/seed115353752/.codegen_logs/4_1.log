+        return True
+    return False
+
+
+def _render_frame(
+    grid: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    color: int,
+    gaps_local: list[dict] | None = None,
+) -> None:
+    r0, c0, r1, c1 = bbox
