+def _match_gaps_to_pieces(gaps: list[dict], pieces: list[dict]) -> dict[int, int]:
+    candidates: list[list[int]] = []
+    for gap in gaps:
+        gap_cands: list[int] = []
+        for piece_idx, piece in enumerate(pieces):
