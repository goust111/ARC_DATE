+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _perimeter_cells(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        if r1 != r0:
+            cells.append((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        if c1 != c0:
+            cells.append((r, c1))
+    return cells
+
+
+def _components_from_mask(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _coords_to_mask(coords: Iterable[tuple[int, int]]) -> np.ndarray:
+    pts = np.array(list(coords), dtype=int)
+    r0, c0, r1, c1 = _bbox(pts)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[pts[:, 0] - r0, pts[:, 1] - c0] = True
+    return mask
+
+
+def _mask_variants(mask: np.ndarray) -> list[np.ndarray]:
+    out: list[np.ndarray] = []
+    seen: set[tuple[int, int, bytes]] = set()
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        key = (int(rot.shape[0]), int(rot.shape[1]), rot.tobytes())
+        if key not in seen:
+            seen.add(key)
+            out.append(rot.copy())
+    return out
