+    return containers
+
+
+def _find_pieces(grid: np.ndarray) -> list[dict]:
+    pieces: list[dict] = []
+    for comp in _components_from_mask(np.asarray(grid) == GREY):
+        mask = _coords_to_mask((tuple(map(int, pt)) for pt in comp))
