+    inner_w: int,
+    direction: tuple[int, int],
+    palette: list[int],
+) -> np.ndarray | None:
+    corner = DIR_TO_CORNER[direction]
+    marker_pos = {
+        "tl": (0, 0),
+        "tr": (0, inner_w - 1),
+        "bl": (inner_h - 1, 0),
+        "br": (inner_h - 1, inner_w - 1),
