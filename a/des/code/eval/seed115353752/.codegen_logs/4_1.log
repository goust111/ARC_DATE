+BG = 0
+YELLOW = 4
+GREY = 5
+
+FRAME_COLOR_POOL = [1, 2, 3, 6, 7, 8, 9]
+GENERATE_RETRIES = 400
+DIR_TO_CORNER = {
+    (-1, 0): "tr",  # up
+    (0, -1): "tl",  # left
+    (0, 1): "br",   # right
+    (1, 0): "bl",   # down
+}
+CORNER_TO_DIR = {v: k for k, v in DIR_TO_CORNER.items()}
