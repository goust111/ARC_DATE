+
+def _find_containers(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    colors = [int(c) for c in np.unique(g) if int(c) not in (BG, YELLOW, GREY)]
+    containers: list[dict] = []
+    for color in colors:
+        coords = np.argwhere(g == color)
+        if coords.size == 0:
+            continue
