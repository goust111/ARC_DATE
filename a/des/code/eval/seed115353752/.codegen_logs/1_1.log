+        cols = range(c0 + 1, cc)
+    elif direction == "right":
+        rows = range(r0 + 1, cr)
+        cols = range(cc + 1, c1)
+    elif direction == "left":
+        rows = range(cr + 1, r1)
+        cols = range(c0 + 1, cc)
+    else:
