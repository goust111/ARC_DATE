+def _gen_attempt() -> np.ndarray | None:
+    rng = np.random.default_rng()
+    n_frames = int(rng.integers(MIN_FRAMES, MAX_FRAMES + 1))
+    bg = int(rng.integers(0, len(PALETTE)))
