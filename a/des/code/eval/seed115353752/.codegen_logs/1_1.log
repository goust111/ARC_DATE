+
+DIRECTIONS = ("up", "right", "left", "down")
+DIR_STEPS = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "left": (0, -1),
+    "down": (1, 0),
+}
+PALETTE = tuple(range(10))
+
+MIN_FRAMES = 3
+MAX_FRAMES = 5
+FRAME_SIZE_CHOICES = (7, 9, 11)
+MIN_CANVAS = 24
+MAX_CANVAS = 40
+FRAME_GAP = 1
+PLAN_ATTEMPTS = 80
+PLACEMENT_ATTEMPTS = 200
+MAX_ATTEMPTS = 400
