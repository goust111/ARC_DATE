+        assert frame_count == 1 and frame_bbox is not None, "each non-background color must have one frame"
+        frames[color] = {
+            "color": color,
+            "bbox": frame_bbox,
+            "center": _frame_center(frame_bbox),
+            "caps": _direction_capacities(frame_bbox),
