+        caps = frame["caps"]
+        r0, c0, r1, c1 = frame["bbox"]
+        for direction, length in counts.items():
+            assert length <= int(caps[direction]), "branch does not fit inside the target frame"
+            dr, dc = DIR_STEPS[direction]
