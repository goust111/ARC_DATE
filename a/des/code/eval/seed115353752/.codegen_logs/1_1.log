+    height, width = shape
+    order = sorted(range(len(sizes)), key=lambda idx: sizes[idx][0] * sizes[idx][1], reverse=True)
+    frames: list[dict[str, object] | None] = [None] * len(sizes)
+    placed_boxes: list[tuple[int, int, int, int]] = []
