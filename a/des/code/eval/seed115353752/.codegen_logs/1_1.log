+def _seed_quadrant_direction(
+    seed_pos: tuple[int, int], source_bbox: tuple[int, int, int, int]
+) -> str:
+    r, c = seed_pos
+    cr, cc = _frame_center(source_bbox)
+    if r < cr and c < cc:
+        return "up"
+    if r < cr and c > cc:
+        return "right"
+    if r > cr and c < cc:
+        return "left"
+    if r > cr and c > cc:
