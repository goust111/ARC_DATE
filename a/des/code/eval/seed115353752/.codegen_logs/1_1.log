+def _pick_seed_cell(
+    frame: dict[str, object],
+    direction: str,
+    occupied: set[tuple[int, int]],
+    rng: np.random.Generator,
+) -> tuple[int, int] | None:
+    cells = _quadrant_cells(frame, direction)
+    if not cells:
+        return None
