+    portal_color: int,
+    mode: str,
+) -> bool:
+    h, w = inp.shape
+
+    for _ in range(MODULE_RETRIES):
+        src_offsets = _grow_shape(mode)
+        dst_offsets = _mirror_offsets(src_offsets, mode)
+        portals = _sample_portals(mode, src_offsets, dst_offsets, h, w)
