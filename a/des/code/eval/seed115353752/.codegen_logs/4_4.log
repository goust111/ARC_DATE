+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+BRANCHES = ("row", "col", "diag")
+
+GEN_RETRIES = 300
+MODULE_RETRIES = 400
+SHAPE_RETRIES = 200
+MIN_MODULES = 2
+MAX_MODULES = 4
+PORTAL_SEP = 5
+DIAG_SEP = 3
