        seed_r = r0 + 1 + seed_r_rel
        seed_c = c0 + 1 + seed_c_rel
        touching: list[str] = []
        if seed_r == r0 + 1:
            touching.append("top")
        if seed_r == r1 - 1:
            touching.append("bottom")
        if seed_c == c0 + 1:
            touching.append("left")
        if seed_c == c1 - 1:
            touching.append("right")
        if len(touching) != 1:
            continue

        frames.append(
