+def _is_free(occupied: np.ndarray, r0: int, c0: int, h: int, w: int) -> bool:
+    H, W = occupied.shape
+    rr0 = max(0, r0 - PLACEMENT_PAD)
+    rr1 = min(H, r0 + h + PLACEMENT_PAD)
+    cc0 = max(0, c0 - PLACEMENT_PAD)
+    cc1 = min(W, c0 + w + PLACEMENT_PAD)
