+def _validate_frame(
+    g: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    frame_color: int,
+    side: str,
+    door: tuple[int, int],
+) -> None:
+    r0, c0, r1, c1 = bbox
+    dr, dc = door
+    assert r1 - r0 + 1 >= 5 and c1 - c0 + 1 >= 5, "frame must leave a nontrivial interior"
+
+    if side == "top":
+        assert dr == r0
+        assert (c1 - c0 + 1) % 2 == 1 and dc == (c0 + c1) // 2
+    elif side == "bottom":
+        assert dr == r1
+        assert (c1 - c0 + 1) % 2 == 1 and dc == (c0 + c1) // 2
+    elif side == "left":
+        assert dc == c0
+        assert (r1 - r0 + 1) % 2 == 1 and dr == (r0 + r1) // 2
+    else:
+        assert dc == c1
+        assert (r1 - r0 + 1) % 2 == 1 and dr == (r0 + r1) // 2
