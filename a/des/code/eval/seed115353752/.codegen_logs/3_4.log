+    door_len = w if side in {"top", "bottom"} else h
+    interior_area = (h - 2) * (w - 2)
+    max_count = min(MARKER_MAX, door_len - 2, interior_area)
+    counts = [n for n in range(1, max_count + 1) if n % 2 == parity]
+    if not counts:
+        return None
+    return int(rng.choice(counts))
