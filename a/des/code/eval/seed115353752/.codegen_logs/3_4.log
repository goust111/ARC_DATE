+def _door_cells(door: tuple[int, int], side: str, count: int) -> list[tuple[int, int]]:
+    before = (count - 1) // 2
+    after = count // 2
+    r, c = door
+    if side in {"top", "bottom"}:
+        return [(r, cc) for cc in range(c - before, c + after + 1)]
+    return [(rr, c) for rr in range(r - before, r + after + 1)]
