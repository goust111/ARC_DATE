+def _render_input(grid_h: int, grid_w: int, specs: list[dict[str, object]]) -> np.ndarray:
+    g = np.full((grid_h, grid_w), BG, dtype=int)
+    for spec in specs:
+        r0 = int(spec["r0"])
+        c0 = int(spec["c0"])
+        h = int(spec["h"])
+        w = int(spec["w"])
+        color = int(spec["color"])
+        reds = list(spec["reds"])
+
+        r1 = r0 + h - 1
+        c1 = c0 + w - 1
+        g[r0, c0 : c1 + 1] = color
+        g[r1, c0 : c1 + 1] = color
+        g[r0 : r1 + 1, c0] = color
+        g[r0 : r1 + 1, c1] = color
+        dr, dc = _door_position(spec)
+        g[dr, dc] = GREEN
+        for rr, cc in reds:
+            g[int(rr), int(cc)] = RED
+    return g
+
