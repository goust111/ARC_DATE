+            if grid_h - h <= EDGE_MARGIN or grid_w - w <= EDGE_MARGIN:
+                continue
+            r0 = int(rng.integers(EDGE_MARGIN, grid_h - h - EDGE_MARGIN + 1))
+            c0 = int(rng.integers(EDGE_MARGIN, grid_w - w - EDGE_MARGIN + 1))
+            if not _is_free(occupied, r0, c0, h, w):
