+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+GREEN = 3
+
+FRAME_COLORS = (1, 4, 5, 6, 7, 8, 9)
+SIDES = ("top", "bottom", "left", "right")
+
+GRID_MIN = 16
+GRID_MAX = 30
+OBJECT_COUNT_MIN = 2
+OBJECT_COUNT_MAX = 4
+OUTER_MIN = 5
