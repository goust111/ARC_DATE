+                "c0": c0,
+                "h": h,
+                "w": w,
+                "color": color,
+                "side": side,
+                "count": count,
+                "reds": reds,
+            }
+            specs.append(spec)
+            _occupy(occupied, r0, c0, h, w)
+            placed = True
+            break
