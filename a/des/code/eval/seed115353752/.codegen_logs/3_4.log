+    return None
+
+
+def _scan_run(g: np.ndarray, r: int, c: int, dr: int, dc: int, color: int) -> int:
+    h, w = g.shape
+    length = 0
+    rr, cc = r, c
+    while 0 <= rr < h and 0 <= cc < w and int(g[rr, cc]) == color:
+        length += 1
+        rr += dr
+        cc += dc
