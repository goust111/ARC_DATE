+    cols = np.arange(c0 + 1, c0 + w - 1)
+    cells = [(int(rr), int(cc)) for rr in rows for cc in cols]
+    picks = rng.choice(len(cells), size=count, replace=False)
+    return [cells[int(idx)] for idx in picks]
