+    return direction
+
+
+def _paths_and_rotations(template_edges: list[tuple[int, int]], slots: list[tuple[int, int]]) -> dict[int, list[tuple[int, int]]]:
+    edges: list[tuple[int, int, tuple[int, int]]] = []
+    for src, dst in template_edges:
