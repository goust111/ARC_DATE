+        ac = sc + outer_w
+    elif direction == (0, -1):
+        gap = sc - (dc + outer_w)
+        ar = random.randint(sr + 1, sr + outer_h - 3)
+        ac = dc + outer_w
+    elif direction == (1, 0):
+        gap = dr - (sr + outer_h)
+        ar = sr + outer_h
+        ac = random.randint(sc + 1, sc + outer_w - 3)
+    else:
