+
+
+def _place_arrow(
+    grid: np.ndarray,
+    src_box: tuple[int, int],
+    dst_box: tuple[int, int],
+    outer_h: int,
+    outer_w: int,
+    color: int,
+) -> tuple[int, int]:
+    sr, sc = src_box
+    dr, dc = dst_box
+    step = (int(np.sign(dr - sr)), int(np.sign(dc - sc)))
+    direction = step
+    assert direction in DIR_TO_ROT
+
+    if direction == (0, 1):
+        gap = dc - (sc + outer_w)
