+
+
+TEMPLATES = [
+    {
+        "name": "chain4",
+        "slots": [(0, 0), (0, 1), (1, 1), (1, 2)],
+        "edges": [(0, 1), (1, 2), (2, 3)],
+    },
+    {
+        "name": "star5",
+        "slots": [(1, 1), (0, 1), (1, 2), (2, 1), (1, 0)],
+        "edges": [(0, 1), (0, 2), (0, 3), (0, 4)],
+    },
+    {
+        "name": "merge5",
+        "slots": [(0, 0), (0, 1), (1, 0), (1, 1), (1, 2)],
+        "edges": [(0, 1), (0, 2), (1, 3), (2, 3), (3, 4)],
