+    {
+        "name": "merge6",
+        "slots": [(0, 1), (1, 1), (0, 2), (1, 2), (2, 1), (2, 2)],
+        "edges": [(0, 1), (1, 4), (0, 2), (2, 3), (3, 5), (5, 4)],
+    },
+]
