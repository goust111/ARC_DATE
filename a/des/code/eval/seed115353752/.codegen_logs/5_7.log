+        out[r, c] = _checker_color(int(r), int(c))
+
+    return out
+
+
+def _render_library(width: int, templates: list[tuple[int, frozenset[tuple[int, int]]]]) -> np.ndarray:
+    lib = np.full((3, width), BLUE, dtype=int)
