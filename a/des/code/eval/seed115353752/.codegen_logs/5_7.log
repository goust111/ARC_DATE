+        return None
+
+    for (r, c), color, sig in zip(centers, marker_colors, marker_signatures):
+        assert int(out[r, c]) == color
+        for dr, dc in sig:
+            assert int(out[r + dr, c + dc]) == color
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
