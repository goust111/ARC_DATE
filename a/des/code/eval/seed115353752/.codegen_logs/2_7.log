+def _find_separator_color(grid: np.ndarray) -> int:
+    candidates: list[int] = []
+    for color in np.unique(grid):
+        value = int(color)
+        if bool(np.any(np.all(grid == value, axis=1))) and bool(np.any(np.all(grid == value, axis=0))):
