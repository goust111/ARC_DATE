+def _is_l_shape(coords: np.ndarray) -> bool:
+    if len(coords) != 3:
+        return False
+    pts = {tuple(map(int, pt)) for pt in coords}
+    degrees = []
+    for r, c in pts:
+        deg = sum((nr, nc) in pts for nr, nc in _neighbors4(r, c))
+        degrees.append(deg)
+    degrees.sort()
+    return degrees == [1, 1, 2]
+
+
+def _find_frames(grid: np.ndarray, bg: int) -> list[dict]:
+    frames: list[dict] = []
+    for color in np.unique(grid):
+        color = int(color)
+        if color == bg:
+            continue
+        for comp in _components(grid == color):
+            r0, c0, r1, c1 = _bbox(comp)
+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            if h < 4 or w < 4:
+                continue
+            if len(comp) != 2 * (h + w) - 4:
+                continue
+            border = np.zeros((h, w), dtype=bool)
+            border[0, :] = True
+            border[-1, :] = True
+            border[:, 0] = True
+            border[:, -1] = True
+            occ = np.zeros((h, w), dtype=bool)
+            occ[comp[:, 0] - r0, comp[:, 1] - c0] = True
+            if not np.array_equal(occ, border):
