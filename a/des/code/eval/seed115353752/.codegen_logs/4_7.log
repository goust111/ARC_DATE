+def _extract_templates(grid: np.ndarray, bg: int, frames: list[dict]) -> dict[int, dict]:
+    reserved = np.zeros_like(grid, dtype=bool)
+    for frame in frames:
+        reserved[frame["cells"][:, 0], frame["cells"][:, 1]] = True
