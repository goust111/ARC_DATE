+def _sample_template(dominant: int, accent_pool: list[int]) -> np.ndarray:
+    h = random.randint(2, 4)
+    w = random.randint(2, 4)
+    patch = np.full((h, w), dominant, dtype=int)
+    area = h * w
+    max_accent_count = min(3, area - 2)
