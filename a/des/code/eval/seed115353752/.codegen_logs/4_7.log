        filled = _tile_pattern(pattern, (interior_h, interior_w), arrow["start_top"], arrow["start_left"])
        out[r0 + 1 : r1, c0 + 1 : c1] = filled
    return out


def _sample_template(dominant: int, accent_pool: list[int]) -> np.ndarray:
    h = random.randint(2, 4)
