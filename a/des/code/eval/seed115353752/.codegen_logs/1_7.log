+def _adjacent_rooms(room: Room, n_rows: int, n_cols: int) -> list[Room]:
+    r, c = room
+    out: list[Room] = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < n_rows:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < n_cols:
