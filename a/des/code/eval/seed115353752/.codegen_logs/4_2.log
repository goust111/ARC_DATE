+def _priority_from_legend(row: np.ndarray) -> list[int]:
+    colors = [int(v) for v in row if int(v) != BG]
+    assert colors, "legend must contain at least one color"
+    assert len(colors) == len(set(colors)), "legend colors must be unique"
+    return colors
