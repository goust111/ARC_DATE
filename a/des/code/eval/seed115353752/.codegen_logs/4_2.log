+    left = _trace_side(core, r, c, 0, -1)
+    right = _trace_side(core, r, c, 0, 1)
+    up = _trace_side(core, r, c, -1, 0)
+    down = _trace_side(core, r, c, 1, 0)
+    h_color = _resolve_axis_color([left, right], priority)
