+def _trace_side(core: np.ndarray, r: int, c: int, dr: int, dc: int) -> tuple[int | None, int]:
+    h, w = core.shape
+    steps = 0
+    nr, nc = r + dr, c + dc
+    while 0 <= nr < h and 0 <= nc < w:
+        steps += 1
+        value = int(core[nr, nc])
+        if value == BG:
+            return None, steps
+        if value != YELLOW:
