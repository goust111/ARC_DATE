+
+# --------------- generator ---------------
+
+COLOR_POOL = (1, 2, 3, 5, 6, 7, 8, 9)
+CORE_H_RANGE = (10, 18)
+GRID_W_RANGE = (14, 24)
+LINE_GAP = 2
+REGION_GAP = 3
+GEN_RETRIES = 400
+
+
+def _choose_spaced_values(count: int, lo: int, hi: int, min_gap: int, rng: random.Random) -> list[int] | None:
