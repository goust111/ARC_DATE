+ALLOWED_TEMPLATE_DIRS = (
+    frozenset(("U", "R")),
+    frozenset(("R", "D")),
+    frozenset(("D", "L")),
+    frozenset(("L", "U")),
+    frozenset(("U", "R", "D")),
