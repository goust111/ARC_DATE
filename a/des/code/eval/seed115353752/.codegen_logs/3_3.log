+    growth = 0
+    seeds = _list_seeds(work, WALL, set(templates))
+    assert seeds is not None
+    for r, c, color in seeds:
+        filled, reasons = _trace_seed(work, r, c, templates[color], WALL)
+        growth += len(filled)
+        reasons_seen.update(reasons)
