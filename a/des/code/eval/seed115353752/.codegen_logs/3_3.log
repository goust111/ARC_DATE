+import numpy as np
+
+
+BG = 0
+WALL = 5
+DIRS = {
+    "U": (-1, 0),
+    "R": (0, 1),
+    "D": (1, 0),
+    "L": (0, -1),
+}
+DIR_ORDER = ("U", "R", "D", "L")
+ALLOWED_TEMPLATE_DIRS = (
+    frozenset(("U", "R")),
+    frozenset(("R", "D")),
+    frozenset(("D", "L")),
+    frozenset(("L", "U")),
+    frozenset(("U", "R", "D")),
+    frozenset(("R", "D", "L")),
+    frozenset(("D", "L", "U")),
+    frozenset(("L", "U", "R")),
+    frozenset(("U", "R", "D", "L")),
+)
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
