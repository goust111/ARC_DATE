+
+def _candidate_seed_positions(
+    work: np.ndarray,
+    dirs: frozenset[str],
+    reserved: np.ndarray,
+    target_reason: str | None,
+) -> list[tuple[int, int, set[tuple[int, int]], list[str]]]:
+    h, w = work.shape
+    blocked_cells = _dilate8(work != BG) | reserved
+    candidates: list[tuple[int, int, set[tuple[int, int]], list[str]]] = []
+    for r in range(h):
+        for c in range(w):
