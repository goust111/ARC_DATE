+    if not candidates:
+        return None
+    best_score = max((degree, length) for degree, length, _ in candidates)
+    best_dirs = {dirs for degree, length, dirs in candidates if (degree, length) == best_score}
+    if len(best_dirs) != 1:
+        return None
+    return next(iter(best_dirs))
