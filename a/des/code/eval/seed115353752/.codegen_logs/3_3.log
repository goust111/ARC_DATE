+def _fits(mask: np.ndarray, patch_mask: np.ndarray, r0: int, c0: int) -> bool:
+    h, w = patch_mask.shape
+    return not bool((mask[r0 : r0 + h, c0 : c0 + w] & patch_mask).any())
