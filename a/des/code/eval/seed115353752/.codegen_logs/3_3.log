+    for cr, cc in cells:
+        runs: dict[str, list[int]] = {name: [] for name in DIR_ORDER}
+        ok = True
+        for r, c in cells:
+            if (r, c) == (cr, cc):
+                continue
+            dr = r - cr
+            dc = c - cc
+            if dr != 0 and dc != 0:
+                ok = False
+                break
+            if dr < 0:
+                runs["U"].append(-dr)
+            elif dr > 0:
+                runs["D"].append(dr)
+            elif dc < 0:
+                runs["L"].append(-dc)
+            elif dc > 0:
+                runs["R"].append(dc)
+        if not ok:
+            continue
+        dirs = frozenset(name for name in DIR_ORDER if runs[name])
+        if dirs not in ALLOWED_TEMPLATE_DIRS:
+            continue
+        lengths = {max(runs[name]) for name in dirs}
+        if len(lengths) != 1:
+            continue
+        length = next(iter(lengths))
+        if not (1 <= length <= 3):
+            continue
+        if any(sorted(set(runs[name])) != list(range(1, length + 1)) for name in dirs):
