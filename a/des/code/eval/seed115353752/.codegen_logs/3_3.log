+def _build_horizontal_case() -> np.ndarray | None:
+    n_templates = int(_RNG.integers(2, 4))
+    colors = random.sample(PALETTE, n_templates)
+    dirsets = random.sample(list(ALLOWED_TEMPLATE_DIRS), n_templates)
+    patches = []
