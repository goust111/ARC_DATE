+
+
+def _random_blob_patch() -> np.ndarray:
+    h = int(_RNG.integers(2, 5))
+    w = int(_RNG.integers(2, 6))
+    max_area = min(h * w, 8)
+    area = int(_RNG.integers(3, max_area + 1))
+    mask = np.zeros((h, w), dtype=bool)
+    start = (int(_RNG.integers(0, h)), int(_RNG.integers(0, w)))
+    mask[start] = True
