+            r0 = int(_RNG.integers(1, h - ph))
+            c0 = int(_RNG.integers(1, w - pw))
+            blocked = _dilate8(occupied)
+            if not _fits(blocked, patch_mask, r0, c0):
+                continue
+            work[r0 : r0 + ph, c0 : c0 + pw][patch_mask] = WALL
+            occupied[r0 : r0 + ph, c0 : c0 + pw] |= patch_mask
+            placed = True
+            break
+        if not placed:
