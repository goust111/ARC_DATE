+
+def _reconstruct_tracks(
+    grid: np.ndarray,
+) -> tuple[dict[int, dict[str, object]], dict[tuple[int, int], list[int]], dict[tuple[int, int], tuple[int, int]], dict[tuple[int, int], int]]:
