H_SPINE_RANGE = (4, 7)
V_SPINE_MIN = 4
V_SPINE_RIGHT_MARGIN = 5
BARRIER_PIXEL_MAX = 26
BARRIER_EXTRA_MIN = 3
VERTICAL_EXTRA_MAX = 14

