+    isolated_boxes = _place_isolated_boxes(h, w, occupied_boxes, isolated_count)
+
+    track_specs = [
+        _build_track(colors[0], root_bbox),
+        _build_track(colors[1], left_bbox),
+        _build_track(colors[2], right_bbox),
+    ]
