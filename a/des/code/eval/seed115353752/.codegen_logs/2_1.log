+
+
+def _place_regions(
+    core_h: int,
+    core_w: int,
+    specs: list[dict],
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    occ = np.zeros((core_h, core_w), dtype=bool)
+    placements: list[tuple[int, int]] = [(-1, -1)] * len(specs)
+    order = sorted(range(len(specs)), key=lambda i: int(np.prod(specs[i]["mask"].shape)), reverse=True)
+
+    for idx in order:
+        mask = specs[idx]["mask"]
+        h, w = mask.shape
+        candidates = []
