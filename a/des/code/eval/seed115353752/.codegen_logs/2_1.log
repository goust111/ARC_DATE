  86: def _gen_bounded_steps(total, slots, cap):
  87:     steps = []
  88:     remaining = total
  89:     for i in range(slots):
  90:         left = slots - i - 1
  91:         lo = max(0, remaining - cap * left)
  92:         hi = min(cap, remaining)
  93:         step = random.randint(lo, hi)
  94:         steps.append(step)
  95:         remaining -= step
  96:     return steps
