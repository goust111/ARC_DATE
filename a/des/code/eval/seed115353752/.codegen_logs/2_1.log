+        spans.add((r1 - r0 + 1) if side in ("top", "bottom") else (c1 - c0 + 1))
+    assert len(spans) == 1
+    k = spans.pop()
+
+    templates: dict[int, np.ndarray] = {}
+    for comp in edge_comps:
