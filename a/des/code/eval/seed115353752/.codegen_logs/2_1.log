+        if direction == "down" and not (dr > 0 and abs(dr) > abs(dc) + 0.4):
+            continue
+        if direction == "left" and not (dc < 0 and abs(dc) > abs(dr) + 0.4):
+            continue
+        if direction == "right" and not (dc > 0 and abs(dc) > abs(dr) + 0.4):
