+    if side == "top":
+        core = grid[k:, :].copy()
+    elif side == "bottom":
+        core = grid[:-k, :].copy()
+    elif side == "left":
+        core = grid[:, k:].copy()
+    else:
+        core = grid[:, :-k].copy()
+    return core, templates, side, k
