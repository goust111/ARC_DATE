+    specs: list[dict] = []
+    for color, direction in zip(colors, directions):
+        built = _make_region_mask(k, direction, rng, crowded)
+        if built is None:
+            return None
+        mask, marker = built
+        specs.append({"color": color, "direction": direction, "mask": mask, "marker": marker})
