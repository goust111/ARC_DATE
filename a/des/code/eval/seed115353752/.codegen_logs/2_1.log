+        assert len(vals) == 1
+        color = vals.pop()
+        assert color not in (BLACK, GREY)
+        r0, c0, r1, c1 = _bbox(comp)
+        patch = (grid[r0 : r1 + 1, c0 : c1 + 1] == color)
+        assert patch.shape == (k, k)
+        templates[color] = patch.copy()
+
+    if side == "top":
+        core = grid[k:, :].copy()
+    elif side == "bottom":
+        core = grid[:-k, :].copy()
+    elif side == "left":
+        core = grid[:, k:].copy()
+    else:
+        core = grid[:, :-k].copy()
