+def _validate_templates() -> None:
+    for size, masks in TEMPLATE_LIBRARY.items():
+        for mask in masks:
+            assert mask.shape == (size, size)
+            assert bool(mask[0, 0] and mask[0, -1] and mask[-1, 0] and mask[-1, -1])
