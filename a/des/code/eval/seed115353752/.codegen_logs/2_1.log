+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIRECTIONS = ("up", "right", "down", "left")
+PALETTE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
