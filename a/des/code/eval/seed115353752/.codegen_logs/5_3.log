+            "distance": distance,
+            "outer_h": outer_h,
+            "outer_w": outer_w,
+            "border_color": border_color,
+            "furniture_color": furniture_color,
+            "border_cells": border_cells,
+            "furniture_cells": furniture_cells,
+            "projection_cells": projection_cells,
+            "track_cells": sorted(track_cells),
+        }
+    return None
+
