+import random
+from collections import Counter
+
+import numpy as np
+
+
+DIR_VECS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+CARDINALS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _cc4(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        stack = [(r, c)]
+        seen[r, c] = True
+        comp: list[tuple[int, int]] = []
+        while stack:
+            cr, cc = stack.pop()
+            comp.append((cr, cc))
+            for dr, dc in CARDINALS:
+                nr = cr + dr
+                nc = cc + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+        comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _perimeter_cells(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    cells = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _room_from_component(
+    grid: np.ndarray,
+    color: int,
+    coords: list[tuple[int, int]],
+    bg: int,
+):
+    if len(coords) < 7:
+        return None
+    r0, c0, r1, c1 = _bbox(coords)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return None
+
+    coord_set = set(coords)
+    perimeter = _perimeter_cells(r0, c0, r1, c1)
+    if len(coord_set) != len(perimeter) - 1 or not coord_set.issubset(perimeter):
+        return None
+
+    missing = list(perimeter - coord_set)
+    if len(missing) != 1:
+        return None
+    door_r, door_c = missing[0]
+    if door_r == r0 and c0 < door_c < c1:
+        direction = "up"
+    elif door_r == r1 and c0 < door_c < c1:
+        direction = "down"
+    elif door_c == c0 and r0 < door_r < r1:
+        direction = "left"
+    elif door_c == c1 and r0 < door_r < r1:
+        direction = "right"
+    else:
+        return None
+
+    furniture: list[tuple[int, int, int]] = []
+    inside_colors = set()
+    empty_count = 0
+    for r in range(r0 + 1, r1):
+        for c in range(c0 + 1, c1):
+            val = int(grid[r, c])
+            if val == bg:
+                empty_count += 1
+            else:
+                if val == color:
+                    return None
+                furniture.append((r, c, val))
+                inside_colors.add(val)
+
+    if not furniture or len(inside_colors) != 1:
+        return None
+
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "border_color": color,
+        "direction": direction,
+        "door": (door_r, door_c),
+        "distance": empty_count,
+        "furniture": furniture,
+    }
+
+
+def _find_rooms(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+    rooms = []
+    for color in sorted(int(v) for v in np.unique(g) if int(v) != bg):
+        for comp in _cc4(g == color):
+            room = _room_from_component(g, color, comp, bg)
+            if room is not None:
+                rooms.append(room)
+    rooms.sort(key=lambda room: (room["bbox"][0], room["bbox"][1], room["border_color"]))
+    return rooms
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    out = g.copy()
+
+    for room in _find_rooms(g):
+        dr, dc = DIR_VECS[room["direction"]]
+        distance = int(room["distance"])
+        for r, c, val in room["furniture"]:
+            rr = r + dr * distance
+            cc = c + dc * distance
+            if 0 <= rr < h and 0 <= cc < w:
+                out[rr, cc] = val
+    return out
