+        dr, dc = DIR_VECS[room["direction"]]
+        distance = int(room["distance"])
+        for r, c, val in room["furniture"]:
+            rr = r + dr * distance
+            cc = c + dc * distance
+            if 0 <= rr < h and 0 <= cc < w:
+                out[rr, cc] = val
+    return out
+
+
+INTERIOR_OPTIONS = [
+    (2, 2),
+    (2, 3),
+    (2, 4),
+    (3, 2),
+    (3, 3),
+    (3, 4),
+    (4, 2),
+    (4, 3),
+]
+ROOM_COUNT_RANGE = (1, 3)
+GRID_H_RANGE = (15, 24)
+GRID_W_RANGE = (15, 24)
+ROOM_BUILD_ATTEMPTS = 80
+ROOM_PLACE_ATTEMPTS = 120
+GEN_ATTEMPTS = 400
+CLEARANCE = 1
+FG_COLORS = [1, 2, 3, 4, 5, 6, 7, 8, 9]
