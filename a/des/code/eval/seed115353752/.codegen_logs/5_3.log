+
+def _accessible_cells(direction: str, ih: int, iw: int, distance: int) -> list[tuple[int, int]]:
+    cells = []
+    if direction == "up":
+        max_row = min(ih - 1, distance - 2)
+        for r in range(max_row + 1):
+            for c in range(iw):
