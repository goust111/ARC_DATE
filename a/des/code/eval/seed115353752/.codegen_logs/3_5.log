            box_w = int(c1 - c0 + 1)
            if box_h < 3 or box_w < 3:
                continue
            sub = g[r0 : r1 + 1, c0 : c1 + 1]
            border = np.zeros_like(sub, dtype=bool)
            border[0, :] = True
            border[-1, :] = True
            border[:, 0] = True
            border[:, -1] = True
            if not bool((sub[border] == color).all()):
