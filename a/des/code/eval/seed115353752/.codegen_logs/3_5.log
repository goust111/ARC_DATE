+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+ARC_COLORS = tuple(range(1, 10))
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+MIN_LOOP_COUNT = 2
+MAX_LOOP_COUNT = 4
+MIN_SCENE_H = 14
+MAX_SCENE_H = 24
+MIN_SCENE_W = 16
+MAX_SCENE_W = 30
+MIN_OUTER = 7
+MAX_OUTER_H = 11
+MAX_OUTER_W = 12
+BOX_PAD = 2
+LEGEND_ROWS = 2
+SPLIT_PROB = 0.5
+MAX_GENERATION_ATTEMPTS = 400
