            interior = sub[1:-1, 1:-1]
            if interior.size == 0:
                continue
            if not bool(((interior == BG) | (interior == color)).all()):
                continue
            anchor_offsets = np.argwhere(interior == color)
            if int(anchor_offsets.shape[0]) != 1:
