+    while idx < n:
+        color = int(line[idx])
+        if color == bg:
+            idx += 1
+            continue
+        j = idx + 1
+        while j < n and int(line[j]) == color:
+            j += 1
+        if j - idx >= 2:
+            runs.append((idx, j - idx, color))
+        idx = j
+    return runs
