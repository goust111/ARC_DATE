+        return False
+    r0 = max(0, top - PLACEMENT_MARGIN)
+    c0 = max(0, left - PLACEMENT_MARGIN)
+    r1 = min(rows, top + h + PLACEMENT_MARGIN)
+    c1 = min(cols, left + w + PLACEMENT_MARGIN)
+    return not bool(blocked[r0:r1, c0:c1].any())
