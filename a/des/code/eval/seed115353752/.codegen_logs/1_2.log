+        positions = [
+            (r, c)
+            for r in range(h - ph + 1)
+            for c in range(w - pw + 1)
+            if _can_place(blocked, r, c, ph, pw)
+        ]
+        if not positions:
+            return None
+        top, left = random.choice(positions)
+        _paste_patch(grid, patch, top, left, bg)
+        blocked[top : top + ph, left : left + pw] = True
