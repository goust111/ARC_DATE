+def _paste_patch(grid: np.ndarray, patch: np.ndarray, top: int, left: int, bg: int) -> None:
+    h, w = patch.shape
+    region = grid[top : top + h, left : left + w]
+    mask = patch != int(bg)
+    region[mask] = patch[mask]
