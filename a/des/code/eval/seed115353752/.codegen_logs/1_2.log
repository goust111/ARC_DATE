+def _gen_attempt() -> np.ndarray | None:
+    bg = random.choice(PALETTE)
+    pair_count = random.randint(PAIR_COUNT_RANGE[0], PAIR_COUNT_RANGE[1])
+    colors = random.sample([c for c in PALETTE if c != bg], pair_count)
