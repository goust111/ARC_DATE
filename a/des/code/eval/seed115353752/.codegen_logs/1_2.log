+    for patch in ordered:
+        ph, pw = map(int, patch.shape)
+        positions = [
+            (r, c)
+            for r in range(h - ph + 1)
+            for c in range(w - pw + 1)
+            if _can_place(blocked, r, c, ph, pw)
