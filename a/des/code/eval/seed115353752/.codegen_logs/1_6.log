+
+def _grow_blob(
+    height: int,
+    width: int,
+    target_size: int,
+    mandatory: Iterable[tuple[int, int]],
+    rng: random.Random,
+) -> set[tuple[int, int]]:
+    cells = {tuple(cell) for cell in mandatory}
+    while len(cells) < target_size:
+        frontier: list[tuple[int, int]] = []
+        for r, c in cells:
