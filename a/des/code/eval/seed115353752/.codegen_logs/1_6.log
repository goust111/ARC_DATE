+def _color_blob(
+    cells: set[tuple[int, int]], colors: list[int], rng: random.Random
+) -> dict[tuple[int, int], int]:
+    pts = list(cells)
+    seed_pts = rng.sample(pts, len(colors))
+    colored: dict[tuple[int, int], int] = {}
+    for pt in pts:
