+def _mirror_point(
+    r: int, c: int, orientation: str, axis: int
+) -> tuple[int, int]:
+    if orientation == "vertical":
+        return r, 2 * axis + 1 - c
+    return 2 * axis + 1 - r, c
+
+
+def _evaluate_candidate(
+    grid: np.ndarray,
