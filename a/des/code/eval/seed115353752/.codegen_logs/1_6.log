+
+    if not pairs:
+        return None, anchor_mask, 0
+
+    mapping: dict[int, int] = {}
+    inverse_seen: dict[int, int] = {}
+    for p0, p1 in pairs:
+        src = int(grid[p0])
+        dst = int(grid[p1])
+        if src in mapping and mapping[src] != dst:
+            return None, anchor_mask, 0
+        if dst in inverse_seen and inverse_seen[dst] != src:
+            return None, anchor_mask, 0
