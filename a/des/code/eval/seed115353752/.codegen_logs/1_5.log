+    for idx, comp in enumerate(comps):
+        r0, c0, r1, c1 = _bbox(comp)
+        sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+        if np.all(sub != BLACK):
+            key = (c0, -(r1 - r0 + 1) * (c1 - c0 + 1))
+            if panel_key is None or key < panel_key:
+                panel_key = key
