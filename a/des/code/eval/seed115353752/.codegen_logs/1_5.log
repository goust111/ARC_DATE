+def _stack_pieces(pieces: list[np.ndarray], order: list[int]) -> np.ndarray:
+    out_h = max(int(pieces[i].shape[0]) for i in order)
+    out_w = max(int(pieces[i].shape[1]) for i in order)
+    out = np.full((out_h, out_w), BLACK, dtype=int)
+    for idx in order:
+        piece = pieces[idx]
+        h, w = piece.shape
