+    molds: list[dict] = []
+    for idx, comp in enumerate(comps):
+        if idx == panel_idx:
+            continue
+        r0, c0, r1, c1 = _bbox(comp)
+        sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+        if sub.shape[0] < 3 or sub.shape[1] < 3:
+            continue
+        if not (
+            np.all(sub[0, :] == GRAY)
+            and np.all(sub[-1, :] == GRAY)
+            and np.all(sub[:, 0] == GRAY)
+            and np.all(sub[:, -1] == GRAY)
