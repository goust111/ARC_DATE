+    row_gap = 1
+
+    col_widths: list[int] = []
+    col_heights: list[int] = []
+    for group in groups:
+        width = max(sizes[idx][1] for idx in group)
+        height = sum(sizes[idx][0] for idx in group) + row_gap * (len(group) - 1)
+        col_widths.append(width)
+        col_heights.append(height)
