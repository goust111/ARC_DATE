+    pr0, pc0, pr1, pc1 = _bbox(comps[panel_idx])
+    panel = {
+        "bbox": (pr0, pc0, pr1, pc1),
+        "sub": grid[pr0 : pr1 + 1, pc0 : pc1 + 1],
+    }
