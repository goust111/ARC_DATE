+def _parse_bands(panel: dict) -> list[dict]:
+    sub = panel["sub"]
+    r0 = panel["bbox"][0]
+    is_sep = np.all(sub == GRAY, axis=1)
+    bands: list[dict] = []
+    start = 0
+    while start < sub.shape[0]:
+        while start < sub.shape[0] and is_sep[start]:
