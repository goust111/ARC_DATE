+import numpy as np
+
+
+BLACK = 0
+GRAY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GEN_RETRIES = 300
