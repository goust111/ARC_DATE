+def _build_frame_bboxes(n_layers: int, cavity_h: int, cavity_w: int) -> list[tuple[int, int, int, int]]:
+    boxes = [(0, 0, cavity_h + 1, cavity_w + 1)]
+    while len(boxes) < n_layers:
