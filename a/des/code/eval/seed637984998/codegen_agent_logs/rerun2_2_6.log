+    min_r = min(bbox[0] for bbox in boxes)
+    min_c = min(bbox[1] for bbox in boxes)
+    shifted = [(r0 - min_r, c0 - min_c, r1 - min_r, c1 - min_c) for (r0, c0, r1, c1) in boxes]
+    return shifted
