+            grid[pos - 1, c0] = color
+            grid[pos + 1, c0] = color
+        else:
+            grid[pos, c1] = BG
+            grid[pos - 1, c1] = color
+            grid[pos + 1, c1] = color
+    grid[landmark] = GREEN
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(22, 30)
+    w = rng.randint(22, 30)
