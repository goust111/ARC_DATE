+) -> tuple[int, int] | None:
+    h, w = blocked.shape
+    if box_h + 2 * margin > h or box_w + 2 * margin > w:
+        return None
+    for _ in range(attempts):
+        r0 = rng.randint(margin, h - box_h - margin)
+        c0 = rng.randint(margin, w - box_w - margin)
+        r1 = r0 + box_h - 1
+        c1 = c0 + box_w - 1
+        rr0 = max(0, r0 - margin)
+        cc0 = max(0, c0 - margin)
+        rr1 = min(h - 1, r1 + margin)
+        cc1 = min(w - 1, c1 + margin)
