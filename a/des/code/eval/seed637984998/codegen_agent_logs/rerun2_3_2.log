+import random
+from collections import Counter, defaultdict
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+GREEN = 3
+FRAGMENT_COLORS = [2, 4, 5, 6, 7, 8, 9]
+FRAGMENT_SHAPES = [(1, 1), (1, 3), (3, 1), (3, 3)]
+GEN_ATTEMPTS = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(pts: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in pts]
+    cols = [c for _, c in pts]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _perimeter_cells(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    pts: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        pts.append((r0, c))
+        if r1 != r0:
+            pts.append((r1, c))
+    for r in range(r0 + 1, r1):
+        pts.append((r, c0))
+        if c1 != c0:
+            pts.append((r, c1))
+    return pts
+
+
+def _is_room_component(grid: np.ndarray, pts: list[tuple[int, int]], bg: int) -> bool:
