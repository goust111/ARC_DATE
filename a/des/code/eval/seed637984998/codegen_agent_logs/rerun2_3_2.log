+import random
+from collections import Counter, defaultdict
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+GREEN = 3
+FRAGMENT_COLORS = [2, 4, 5, 6, 7, 8, 9]
+FRAGMENT_SHAPES = [(1, 1), (1, 3), (3, 1), (3, 3)]
+GEN_ATTEMPTS = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(pts: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in pts]
+    cols = [c for _, c in pts]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _perimeter_cells(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    pts: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        pts.append((r0, c))
+        if r1 != r0:
+            pts.append((r1, c))
+    for r in range(r0 + 1, r1):
+        pts.append((r, c0))
+        if c1 != c0:
+            pts.append((r, c1))
+    return pts
+
+
+def _is_room_component(grid: np.ndarray, pts: list[tuple[int, int]], bg: int) -> bool:
+    colors = {int(grid[r, c]) for r, c in pts}
+    if BLUE not in colors:
+        return False
+    r0, c0, r1, c1 = _bbox(pts)
+    if r1 - r0 + 1 < 7 or c1 - c0 + 1 < 7:
+        return False
+    if any(not (r in (r0, r1) or c in (c0, c1)) for r, c in pts):
+        return False
+    inside = grid[r0 + 1 : r1, c0 + 1 : c1]
+    return int(np.count_nonzero(inside == GREEN)) == 1
+
+
+def _extract_room(grid: np.ndarray, pts: list[tuple[int, int]], bg: int) -> dict:
+    r0, c0, r1, c1 = _bbox(pts)
+    inside = grid[r0 + 1 : r1, c0 + 1 : c1]
+    landmark_local = np.argwhere(inside == GREEN)
+    assert len(landmark_local) == 1, "each room must contain one green landmark"
+    lr, lc = map(int, landmark_local[0])
+    landmark = (r0 + 1 + lr, c0 + 1 + lc)
+
+    marker_cells: dict[int, list[tuple[int, int]]] = defaultdict(list)
+    for r, c in _perimeter_cells((r0, c0, r1, c1)):
+        value = int(grid[r, c])
+        if value not in (bg, BLUE):
+            marker_cells[value].append((r, c))
+    assert marker_cells, "each room must expose at least one marked door"
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "landmark": landmark,
+        "markers": dict(marker_cells),
+    }
+
+
+def _extract_fragment(grid: np.ndarray, pts: list[tuple[int, int]]) -> dict:
+    r0, c0, r1, c1 = _bbox(pts)
+    color = int(grid[pts[0]])
+    assert color not in (BG, BLUE, GREEN)
+    assert all(int(grid[r, c]) == color for r, c in pts), "fragment must be monochrome"
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    assert h <= 3 and w <= 3, "fragment must be at most 3x3"
+    assert len(pts) == h * w, "fragment must be a solid rectangle"
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "shape": (h, w),
+        "area": h * w,
+        "color": color,
+        "pts": pts,
+    }
+
+
+def _fits_room_perimeter(pts: list[tuple[int, int]], bbox: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = bbox
+    return all(r0 <= r <= r1 and c0 <= c <= c1 and (r in (r0, r1) or c in (c0, c1)) for r, c in pts)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Match each monochrome fragment to the room whose door markers share its color,
+    erase the markers and source fragment, then center the fragment on the room's
+    green landmark. Larger fragments are painted first when a room receives more
+    than one fragment.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+
+    mask = (g != bg) & (g != GREEN)
+    room_components: list[list[tuple[int, int]]] = []
+    deferred_components: list[list[tuple[int, int]]] = []
+    for pts in _components(mask):
+        if _is_room_component(g, pts, bg):
+            room_components.append(pts)
+        else:
+            deferred_components.append(pts)
+
+    rooms = [_extract_room(g, pts, bg) for pts in room_components]
+    fragments: list[dict] = []
+    for pts in deferred_components:
+        colors = {int(g[r, c]) for r, c in pts}
+        if BLUE in colors:
+            assert any(_fits_room_perimeter(pts, room["bbox"]) for room in rooms), "blue residue must belong to a room perimeter"
+            continue
+        fragments.append(_extract_fragment(g, pts))
