+_RNG = random.Random()
+
+
+def _axis_runs(values: np.ndarray) -> list[tuple[int, int, int]]:
+    """Return (color, start, length) runs on one axis, skipping the corner cell."""
+    runs: list[tuple[int, int, int]] = []
+    seen_colors: set[int] = set()
+    i = 1
+    n = len(values)
+    while i < n:
