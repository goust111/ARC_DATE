+    if mode == "left_extra":
+        return _RNG.randint(1, 3), _RNG.randint(1, 2), 0
+    if mode == "top_extra":
+        return _RNG.randint(1, 3), 0, _RNG.randint(1, 2)
+    return _RNG.randint(1, 3), _RNG.randint(1, 2), _RNG.randint(1, 2)
