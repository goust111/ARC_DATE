+
+
+def _paint_board(
+    grid: np.ndarray,
+    board_top: int,
+    board_left: int,
+    board_h: int,
+    board_w: int,
+    board_color: int,
+    hole_shapes: list[np.ndarray],
+    hole_pos: list[tuple[int, int]],
