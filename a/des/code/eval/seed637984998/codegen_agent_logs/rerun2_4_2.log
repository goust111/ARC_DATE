+        return None
+
+    expected = _expected_output(grid, holes, pieces)
+    if np.array_equal(main(grid), expected):
+        return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _generate_attempt()
+        if grid is not None:
