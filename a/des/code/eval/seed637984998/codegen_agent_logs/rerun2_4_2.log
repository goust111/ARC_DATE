+BOARD_W_RANGE = (15, 21)
+HOLE_COUNT_RANGE = (2, 4)
+SHAPE_DIM_RANGE = (1, 5)
+SHAPE_AREA_MAX = 8
+GEN_ATTEMPTS = 400
+HOLE_PLACE_TRIES = 120
+PIECE_PLACE_TRIES = 200
