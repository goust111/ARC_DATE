+    g = np.asarray(grid, dtype=int)
+    bg = _background_color(g)
+
+    fg_components = _components(g != bg)
+    assert fg_components, "grid must contain foreground objects"
+    board_comp = max(fg_components, key=len)
+    board_cells = set(board_comp)
