+    candidates.sort(key=lambda item: (item[0], item[1]), reverse=True)
+    big = candidates[0][2]
+    small = candidates[0][3]
+    k = (big["bbox"][2] - big["bbox"][0] + 1) // (small["bbox"][2] - small["bbox"][0] + 1)
+    return big, small, int(k)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
