+                continue
+            k = big_h // small_h
+            if k <= 1 or big_w // small_w != k:
+                continue
+            projected = {(r // k, c // k) for r, c in big["local_coords"]}
+            if projected == small["local_coords"]:
+                candidates.append((big_h * big_w, len(big["coords"]), big, small))
