+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def _boundary(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = np.zeros((h, w), dtype=bool)
+    for r in range(h):
