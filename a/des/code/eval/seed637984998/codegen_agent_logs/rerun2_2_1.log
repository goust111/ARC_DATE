+    for comp in components:
+        if comp["bbox"] == big_ring["bbox"] and comp["coords"] == big_ring["coords"]:
+            continue
+        if comp["bbox"] == small_ring["bbox"] and comp["coords"] == small_ring["coords"]:
+            continue
+        coords = comp["coords"]
