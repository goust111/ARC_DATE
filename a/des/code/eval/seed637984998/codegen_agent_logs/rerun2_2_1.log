+        out[r, c] = color
+    return out
+
+
+def _connected(mask: np.ndarray, use_diagonal: bool = False) -> bool:
+    pts = np.argwhere(mask)
+    if len(pts) == 0:
+        return False
+    h, w = mask.shape
+    start = tuple(int(v) for v in pts[0])
