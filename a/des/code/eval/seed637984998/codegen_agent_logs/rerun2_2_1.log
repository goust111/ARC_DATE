+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = DIR4 + [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+GEN_ATTEMPTS = 400
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    vals, cnts = np.unique(grid, return_counts=True)
+    return int(vals[cnts.argmax()])
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _neighbors8(r: int, c: int) -> list[tuple[int, int]]:
+    return [
+        (r - 1, c),
+        (r + 1, c),
+        (r, c - 1),
+        (r, c + 1),
+        (r - 1, c - 1),
+        (r - 1, c + 1),
+        (r + 1, c - 1),
+        (r + 1, c + 1),
+    ]
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            r0 = r1 = r
+            c0 = c1 = c
+            while q:
+                rr, cc = q.popleft()
+                coords.append((int(rr), int(cc)))
+                r0 = min(r0, rr)
+                r1 = max(r1, rr)
+                c0 = min(c0, cc)
+                c1 = max(c1, cc)
+                for nr, nc in _neighbors8(int(rr), int(cc)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                }
+            )
+    return comps
+
+
+def _local_mask(comp: dict) -> np.ndarray:
+    r0, c0, r1, c1 = comp["bbox"]
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in comp["coords"]:
+        mask[r - r0, c - c0] = True
+    return mask
+
+
+def _enclosed_region(comp: dict) -> set[tuple[int, int]]:
+    r0, c0, _r1, _c1 = comp["bbox"]
+    mask = _local_mask(comp)
+    h, w = mask.shape
+    outside = np.zeros((h, w), dtype=bool)
+    q = deque()
+    for r in range(h):
+        for c in range(w):
+            if r in (0, h - 1) or c in (0, w - 1):
+                if not mask[r, c] and not outside[r, c]:
+                    outside[r, c] = True
+                    q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+    enclosed = set()
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] and not outside[r, c]:
+                enclosed.add((r0 + r, c0 + c))
+    return enclosed
+
+
+def _ring_pair(components: list[dict]) -> tuple[dict, dict, int]:
+    hollow = []
+    for comp in components:
+        interior = _enclosed_region(comp)
+        if interior:
+            item = dict(comp)
+            item["interior"] = interior
+            item["local_coords"] = {(r - comp["bbox"][0], c - comp["bbox"][1]) for r, c in comp["coords"]}
+            hollow.append(item)
+
+    candidates: list[tuple[int, int, dict, dict]] = []
+    for big in hollow:
+        br0, bc0, br1, bc1 = big["bbox"]
+        big_h = br1 - br0 + 1
+        big_w = bc1 - bc0 + 1
+        for small in hollow:
+            if big is small:
+                continue
+            sr0, sc0, sr1, sc1 = small["bbox"]
+            small_h = sr1 - sr0 + 1
+            small_w = sc1 - sc0 + 1
