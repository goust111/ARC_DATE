+def _gen_attempt() -> np.ndarray | None:
+    pair_count = random.randint(*PAIR_COUNT_BOUNDS)
+    dims = random.sample(RECT_DIMS, pair_count)
+    masks: list[tuple[np.ndarray, np.ndarray]] = []
+    for h, w in dims:
