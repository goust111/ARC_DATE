+    return [(int(r), int(c)) for r, c in placements if r is not None and c is not None]
+
+
+def _render_component(grid: np.ndarray, mask: np.ndarray, top: int, left: int, color: int) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    h, w = mask.shape
+    for r in range(h):
+        for c in range(w):
+            if bool(mask[r, c]):
+                rr = top + r
+                cc = left + c
