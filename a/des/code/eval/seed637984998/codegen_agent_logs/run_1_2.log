import random
from collections import deque

def conn(mask):
    h=len(mask); w=len(mask[0])
    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]]
    if not pts: return False
    q=deque([pts[0]]); seen={pts[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            rr,cc=r+dr,c+dc
            if 0<=rr<h and 0<=cc<w and mask[rr][cc] and (rr,cc) not in seen:
                seen.add((rr,cc)); q.append((rr,cc))
    return len(seen)==len(pts)

def bbox_full(mask):
    h=len(mask); w=len(mask[0])
    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]]
    rs=[r for r,c in pts]; cs=[c for r,c in pts]
    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1

def trial(h,w,n=10000):
    ok=0
    for _ in range(n):
        p=random.uniform(0.28,0.45)
        m=[[random.random()<p for c in range(w)] for r in range(h)]
        # force A/B on every side
        reqA=[(0,random.randrange(w)),(h-1,random.randrange(w)),(random.randrange(h),0),(random.randrange(h),w-1)]
        reqB=[(0,random.randrange(w)),(h-1,random.randrange(w)),(random.randrange(h),0),(random.randrange(h),w-1)]
        for r,c in reqA: m[r][c]=True
        for r,c in reqB: m[r][c]=False
        a=sum(sum(row) for row in m)
        if a<4 or a>h*w-4 or a*2==h*w: continue
        inv=[[not x for x in row] for row in m]
