+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _mask_connected(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+
+    start = tuple(int(v) for v in coords[0])
+    seen = {start}
+    queue: deque[tuple[int, int]] = deque([start])
+    while queue:
+        r, c = queue.popleft()
+        for rr, cc in _neighbors4(r, c, h, w):
+            if bool(mask[rr, cc]) and (rr, cc) not in seen:
+                seen.add((rr, cc))
+                queue.append((rr, cc))
+    return len(seen) == int(mask.sum())
+
+
+def _mask_bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return r0, c0, r1, c1
+
+
+def _touches_full_bbox(mask: np.ndarray) -> bool:
+    b = _mask_bbox(mask)
+    if b is None:
+        return False
+    r0, c0, r1, c1 = b
+    h, w = mask.shape
+    return r0 == 0 and c0 == 0 and r1 == h - 1 and c1 == w - 1
+
+
+def _find_components(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == BG or bool(seen[r, c]):
+                continue
+
+            queue: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+
+            rows = [rr for rr, _ in coords]
+            cols = [cc for _, cc in coords]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in coords:
+                mask[rr - r0, cc - c0] = True
+
+            components.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "shape": mask.shape,
+                    "mask": mask,
+                    "area": len(coords),
+                }
+            )
