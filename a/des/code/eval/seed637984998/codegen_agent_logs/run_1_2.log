+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+COLORS = tuple(range(1, 10))
+
+# Generator configuration.
+PAIR_COUNT_BOUNDS = (2, 4)
+RECT_DIMS = [
+    (4, 4),
+    (4, 5),
+    (4, 6),
+    (4, 7),
+    (5, 4),
+    (5, 5),
+    (5, 6),
+    (5, 7),
+    (6, 4),
+    (6, 5),
+    (6, 6),
+    (7, 4),
+    (7, 5),
+]
+GRID_SIDE_MIN = 20
+GRID_SIDE_MAX = 30
+BOX_PADDING = 1
+PLACEMENT_TRIES = 250
+PAIR_TRIES = 100
+GENERATION_TRIES = 300
