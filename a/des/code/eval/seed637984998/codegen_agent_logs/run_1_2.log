+def _make_scaffold_mask(h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    mode = random.choice(["top_bottom", "left_right"])
+
+    if mode == "top_bottom":
+        connector = random.randint(1, w - 2)
+        mask[0, :] = True
+        mask[-1, :] = True
