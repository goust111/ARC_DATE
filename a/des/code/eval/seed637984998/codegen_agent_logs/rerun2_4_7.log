+                assert 0 <= r < h and sep_col < c < w
+                assert out[r, c] in (BG, color)
+                out[r, c] = color
+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    pair_count = int(RNG.choice(GENERATOR_PAIR_COUNTS))
