+def _gen_attempt() -> np.ndarray | None:
+    pair_count = int(RNG.choice(GENERATOR_PAIR_COUNTS))
+    counts = sorted(RNG.choice(np.array(GENERATOR_COUNTS), size=pair_count, replace=False).tolist())
+
+    graphs = {}
+    for count in counts:
