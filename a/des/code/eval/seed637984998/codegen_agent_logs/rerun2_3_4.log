+def _pair_slots(n_markers: int) -> list[tuple[int, int]]:
+    pairs: list[tuple[int, int]] = []
+    i = 0
+    while i < n_markers:
+        if i + 1 < n_markers:
+            pairs.append((i, i + 1))
+        else:
+            pairs.append((i, 0))
+        i += 2
