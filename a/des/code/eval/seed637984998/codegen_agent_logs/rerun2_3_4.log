+        for left_slot, right_slot in _pair_slots(len(marker_indices)):
+            start_idx = int(marker_indices[left_slot])
+            end_idx = int(marker_indices[right_slot])
+            color_a = int(g[cycle[start_idx]])
+            color_b = int(g[cycle[end_idx]])
+            if color_a != color_b:
