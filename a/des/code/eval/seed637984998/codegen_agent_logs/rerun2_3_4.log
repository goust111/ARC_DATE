def _assign_marker_colors(count: int, fill_flags: list[bool]) -> list[int] | None:
    colors: list[int | None] = [None] * count
    for (a, b), should_fill in zip(_pair_slots(count), fill_flags):
        if colors[a] is None and colors[b] is None:
