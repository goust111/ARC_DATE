+    # Otherwise the 2x2 L gap is diagonal, so the prompt's horizontal priority applies.
+    if mr == 0 and r0 == 0:
+        return "up"
+    if mr == 1 and r1 == interior.shape[0] - 1:
+        return "down"
+    if mc == 0:
+        return "left"
+    return "right"
+
