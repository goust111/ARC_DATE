+def _pointer_anchor(direction: str, cell_h: int, cell_w: int, rng: random.Random) -> tuple[int, int]:
+    if direction == "up":
+        return 0, rng.randint(0, cell_w - 2)
+    if direction == "down":
+        return cell_h - 2, rng.randint(0, cell_w - 2)
