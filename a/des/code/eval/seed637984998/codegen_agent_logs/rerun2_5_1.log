+
+def _make_rect_union_room(inner_h: int, inner_w: int, target_area: int, rng: np.random.Generator) -> np.ndarray | None:
+    mask = np.zeros((inner_h, inner_w), dtype=bool)
+    max_rect_h = min(inner_h, 5)
+    max_rect_w = min(inner_w, 5)
