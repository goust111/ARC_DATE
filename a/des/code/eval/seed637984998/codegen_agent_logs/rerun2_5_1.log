+def _place_patch(grid: np.ndarray, blocked: np.ndarray, patch: np.ndarray, rng: np.random.Generator) -> bool:
+    h, w = grid.shape
+    ph, pw = patch.shape
+    if ph + 2 >= h or pw + 2 >= w:
