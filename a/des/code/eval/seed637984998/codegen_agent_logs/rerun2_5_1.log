+def _grey_components(grid: np.ndarray) -> tuple[list[dict], np.ndarray]:
+    comps = _components(grid == GREY)
+    ids = np.full(grid.shape, -1, dtype=int)
+    for idx, comp in enumerate(comps):
+        pts = comp["coords"]
+        ids[pts[:, 0], pts[:, 1]] = int(idx)
+    return comps, ids
+
