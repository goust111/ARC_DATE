+def _make_growth_room(inner_h: int, inner_w: int, target_area: int, rng: np.random.Generator) -> np.ndarray | None:
+    mask = np.zeros((inner_h, inner_w), dtype=bool)
+    start = (int(rng.integers(inner_h)), int(rng.integers(inner_w)))
+    mask[start] = True
+    frontier = set()
