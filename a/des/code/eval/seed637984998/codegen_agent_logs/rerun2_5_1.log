+def _components(mask: np.ndarray) -> list[dict]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            touches_boundary = r in (0, h - 1) or c in (0, w - 1)
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+                        if nr in (0, h - 1) or nc in (0, w - 1):
+                            touches_boundary = True
+            arr = np.array(coords, dtype=int)
+            r0 = int(arr[:, 0].min())
+            c0 = int(arr[:, 1].min())
+            r1 = int(arr[:, 0].max())
+            c1 = int(arr[:, 1].max())
+            comps.append(
+                {
+                    "coords": arr,
+                    "area": int(len(coords)),
+                    "bbox": (r0, c0, r1, c1),
+                    "touches_boundary": touches_boundary,
+                }
+            )
+    return comps
+
+
+def _fill_holes(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    for comp in _components(~mask):
+        if comp["touches_boundary"]:
+            continue
+        pts = comp["coords"]
+        out[pts[:, 0], pts[:, 1]] = True
+    return out
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int]:
+    pts = np.argwhere(mask)
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _ring_around(room: np.ndarray) -> np.ndarray:
+    h, w = room.shape
+    ring = np.zeros((h, w), dtype=bool)
+    for r, c in np.argwhere(room):
+        for dr, dc in DIR4:
+            nr, nc = int(r + dr), int(c + dc)
+            if 0 <= nr < h and 0 <= nc < w and not room[nr, nc]:
+                ring[nr, nc] = True
+    return ring
