+                return False
+            boundary = grey_comps[int(region["boundary_id"])]["coords"]
+            expected_color = legend_colors[int(region["dot_count"]) - 1]
+            if not np.all(out[boundary[:, 0], boundary[:, 1]] == expected_color):
+                return False
+        return True
+    except Exception:
+        return False
