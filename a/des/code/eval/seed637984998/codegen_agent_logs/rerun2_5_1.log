+def _components(mask: np.ndarray) -> list[dict]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            touches_boundary = r in (0, h - 1) or c in (0, w - 1)
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+                        if nr in (0, h - 1) or nc in (0, w - 1):
+                            touches_boundary = True
+            arr = np.array(coords, dtype=int)
+            r0 = int(arr[:, 0].min())
+            c0 = int(arr[:, 1].min())
+            r1 = int(arr[:, 0].max())
+            c1 = int(arr[:, 1].max())
+            comps.append(
+                {
+                    "coords": arr,
+                    "area": int(len(coords)),
+                    "bbox": (r0, c0, r1, c1),
+                    "touches_boundary": touches_boundary,
