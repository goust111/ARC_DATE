+    mask = _fill_holes(mask)
+    if int(mask.sum()) < target_area:
+        return None
+    r0, c0, r1, c1 = _bbox(mask)
+    bbox_area = (r1 - r0 + 1) * (c1 - c0 + 1)
+    if mask.sum() * 2 < bbox_area:
+        return None
+    return mask
