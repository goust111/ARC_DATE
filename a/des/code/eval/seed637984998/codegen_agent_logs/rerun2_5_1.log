+
+def _neighbor_count(mask: np.ndarray, r: int, c: int) -> int:
+    h, w = mask.shape
+    total = 0
+    for dr, dc in DIR4:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < h and 0 <= nc < w and mask[nr, nc]:
+            total += 1
+    return total
