+        (fr0 + frame_h + 1, 0, h - 2, fc0 - 2),
+        (fr0 + frame_h + 1, fc0 + frame_w + 1, h - 2, w - 2),
+    ]
+    valid_zones = [zone for zone in corner_zones if zone[0] <= zone[2] and zone[1] <= zone[3]]
