+def _sample_overlap_pair(total_len: int) -> tuple[tuple[int, int], tuple[int, int]]:
+    for _ in range(200):
+        max_len = min(4, total_len - 1)
+        if max_len < 2:
+            break
+        len1 = random.randint(2, max_len)
+        len2 = random.randint(2, max_len)
+        max_overlap = min(len1 - 1, len2)
