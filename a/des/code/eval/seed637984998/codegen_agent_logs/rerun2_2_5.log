+
+def _colors_in_scan_order(grid: np.ndarray, bg: int) -> list[int]:
+    colors: list[int] = []
+    seen = {int(bg)}
+    for raw in grid.ravel():
+        color = int(raw)
+        if color not in seen:
+            seen.add(color)
+            colors.append(color)
+    return colors
