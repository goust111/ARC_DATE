+        ra = random.randint(ra_min, ra_max)
+        cross_r = ra + delta
+        rb_min = cross_r + 2
+        rb_max = height - 2
+        if rb_min > rb_max:
+            return None
+        rb = random.randint(rb_min, rb_max)
+    else:
