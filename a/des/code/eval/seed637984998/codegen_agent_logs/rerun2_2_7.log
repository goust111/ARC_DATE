from __future__ import annotations

import numpy as np

from arc_utils import bbox_coords, components_mask, get_bg
import random


def _touches_edge(coords: np.ndarray, height: int, width: int) -> bool:
    rows = coords[:, 0]
    cols = coords[:, 1]
    return bool(
        np.any((rows == 0) | (rows == height - 1) | (cols == 0) | (cols == width - 1))
    )


def main(grid: np.ndarray) -> np.ndarray:
    """
    Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.

    Input structure
    - The most common color forms the outer background and all enclosed slot
      backgrounds.
    - The enclosed background components form a complete rectangular array of
      slots, ordered by their positions.
    - Each slot contains either no other color or exactly one object color.

    Rule
    - Find all 4-connected components of the most common color that do not touch
      the input edge.
    - Sort their bounding boxes into row and column order to define the output
      table.
    - For each slot, output its unique non-background color if present; otherwise
      output the background color.

    Key insight
    - The large grid is an expanded table: the enclosed background components are
      the cells, and any colored object drawn inside a cell is that cell's summary
      value.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    height, width = map(int, g.shape)

    bg = get_bg(g)
    slot_bboxes: list[tuple[int, int, int, int]] = []
    for coords in components_mask(g == bg, connectivity=4):
        if _touches_edge(coords, height, width):
            continue
        slot_bboxes.append(bbox_coords(coords))

    assert slot_bboxes, "expected enclosed background slots"
    row_starts = sorted({b[0] for b in slot_bboxes})
    col_starts = sorted({b[1] for b in slot_bboxes})
    assert len(slot_bboxes) == len(row_starts) * len(col_starts), (
        "expected a complete rectangular array of slots"
    )

    slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}
    assert len(slot_by_anchor) == len(slot_bboxes), "slot anchors must be unique"

    out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)
    for out_r, r0 in enumerate(row_starts):
        for out_c, c0 in enumerate(col_starts):
            assert (r0, c0) in slot_by_anchor, "missing slot in rectangular array"
            sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]
            window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]
            object_colors = np.unique(window[window != bg])
            assert object_colors.size <= 1, "each slot must contain at most one object color"
            if object_colors.size == 1:
                out[out_r, out_c] = int(object_colors[0])

    return out

# --------------- generator (att2) ---------------

# Canvas, table, frame, and slot dimensions.
CANVAS_MIN, CANVAS_MAX = 13, 19
TABLE_ROWS_RANGE, TABLE_COLS_RANGE = (2, 3), (2, 3)
ROW_SLOT_SIZE_RANGE, COL_SLOT_SIZE_RANGE = (3, 6), (3, 4)
AXIS_OUTER_OPTIONS = AXIS_PADDING_OPTIONS = AXIS_SEPARATOR_OPTIONS = (1, 2)

# Object and palette sampling limits.
N_COLORS, MAX_OBJECT_COLORS = 10, 6
MAX_OBJECT_HEIGHT, MAX_OBJECT_WIDTH = 3, 2
OBJECT_MARGIN, MAX_OBJECT_AREA = 1, 6

# Rejection sampling cap.
GEN_RETRY_LIMIT = 300


def _gen_axis_options(n_slots, slot_min, slot_max):
    options = []

    def rec_slots(i, cur):
        if i == n_slots:
            rec_seps(0, [], cur)
            return
        for size in range(slot_min, slot_max + 1):
            rec_slots(i + 1, cur + [size])

    def rec_seps(i, cur, slots):
        if i == n_slots - 1:
            for before in AXIS_OUTER_OPTIONS:
                for after in AXIS_OUTER_OPTIONS:
                    for pad_before in AXIS_PADDING_OPTIONS:
                        for pad_after in AXIS_PADDING_OPTIONS:
                            total = (
                                before
                                + after
                                + pad_before
                                + pad_after
                                + sum(slots)
                                + sum(cur)
                            )
                            if 13 <= total <= 19:
                                options.append(
                                    (
                                        tuple(slots),
                                        tuple(cur),
                                        before,
                                        after,
                                        pad_before,
                                        pad_after,
                                        total,
                                )
                            )
            return
        for sep in AXIS_SEPARATOR_OPTIONS:
            rec_seps(i + 1, cur + [sep], slots)

    rec_slots(0, [])
    return options


def _gen_positions(axis):
    sizes, seps, outer_before, _outer_after, pad_before, _pad_after, _total = axis
    starts = []
    pos = outer_before + pad_before
    for i, size in enumerate(sizes):
        starts.append(pos)
        pos += size
        if i < len(seps):
            pos += seps[i]
    return starts


def _gen_choose_axis(n_slots, slot_min, slot_max, other_axis=None, max_object_loss=0):
    options = _gen_axis_options(n_slots, slot_min, slot_max)
    if other_axis is None:
        return random.choice(options)

    good = []
    for axis in options:
        row_axis = axis if slot_max == ROW_SLOT_SIZE_RANGE[1] else other_axis
        col_axis = axis if slot_max == COL_SLOT_SIZE_RANGE[1] else other_axis
        height = row_axis[-1]
        width = col_axis[-1]
        frame_height = height - row_axis[2] - row_axis[3]
        frame_width = width - col_axis[2] - col_axis[3]
        slot_area = sum(row_axis[0]) * sum(col_axis[0])
        outer_bg = height * width - frame_height * frame_width
        bg_room = outer_bg + slot_area - max_object_loss
        frame_area = frame_height * frame_width - slot_area
        if bg_room > frame_area:
            good.append(axis)
    return random.choice(good or options)


def _gen_assign_colors(shape, bg, frame):
    n_slots = shape[0] * shape[1]
    filled_count = random.randint(1, n_slots - 1)
    filled = random.sample(range(n_slots), filled_count)
    colors = [c for c in range(N_COLORS) if c not in (bg, frame)]
    n_colors = random.randint(1, min(MAX_OBJECT_COLORS, filled_count, len(colors)))
    palette = random.sample(colors, n_colors)
    assignments = palette[:]
    assignments.extend(random.choice(palette) for _ in range(filled_count - n_colors))
    random.shuffle(assignments)

    out = np.full(shape, bg, dtype=int)
    for idx, color in zip(filled, assignments):
        out[idx // shape[1], idx % shape[1]] = color
    return out, filled_count


def _gen_object_shape(slot_h, slot_w):
    by_area = {}
    for obj_h in range(1, min(MAX_OBJECT_HEIGHT, slot_h - 2 * OBJECT_MARGIN) + 1):
        for obj_w in range(1, min(MAX_OBJECT_WIDTH, slot_w - 2 * OBJECT_MARGIN) + 1):
            by_area.setdefault(obj_h * obj_w, []).append((obj_h, obj_w))
    area = random.choice(list(by_area))
    return random.choice(by_area[area])


def _gen_choose_layout(rows, cols, filled_count):
    row_axis = _gen_choose_axis(rows, *ROW_SLOT_SIZE_RANGE)
    loss = MAX_OBJECT_AREA * filled_count
    col_axis = _gen_choose_axis(cols, *COL_SLOT_SIZE_RANGE, row_axis, max_object_loss=loss)
    return row_axis, col_axis, _gen_positions(row_axis), _gen_positions(col_axis)


def _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts):
    height = row_axis[-1]
    width = col_axis[-1]
    grid = np.full((height, width), bg, dtype=int)
    rt, rb = row_axis[2], row_axis[3]
    cl, cr = col_axis[2], col_axis[3]
    grid[rt : height - rb, cl : width - cr] = frame

    for r, slot_h in zip(row_starts, row_axis[0]):
        for c, slot_w in zip(col_starts, col_axis[0]):
            grid[r : r + slot_h, c : c + slot_w] = bg
    return grid


def _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts):
    for out_r, slot_r in enumerate(row_starts):
        slot_h = row_axis[0][out_r]
        for out_c, slot_c in enumerate(col_starts):
            color = int(out[out_r, out_c])
            if color == bg:
                continue
            slot_w = col_axis[0][out_c]
            obj_h, obj_w = _gen_object_shape(slot_h, slot_w)
            obj_r = random.randint(slot_r + OBJECT_MARGIN, slot_r + slot_h - obj_h - OBJECT_MARGIN)
            obj_c = random.randint(slot_c + OBJECT_MARGIN, slot_c + slot_w - obj_w - OBJECT_MARGIN)
            grid[obj_r : obj_r + obj_h, obj_c : obj_c + obj_w] = color


def _gen_is_valid(grid, out, bg, frame):
    counts = np.bincount(grid.ravel(), minlength=N_COLORS)
    if int(np.argmax(counts)) != bg:
        return False
    if counts[frame] <= max(counts[c] for c in range(N_COLORS) if c not in (bg, frame)):
        return False
    try:
        actual = main(grid)
    except Exception:
        return False
    return bool(np.array_equal(actual, out))


def _gen_attempt() -> np.ndarray | None:
    rows = random.randint(*TABLE_ROWS_RANGE)
    cols = random.randint(*TABLE_COLS_RANGE)
    bg, frame = random.sample(range(N_COLORS), 2)

    out, filled_count = _gen_assign_colors((rows, cols), bg, frame)
    row_axis, col_axis, row_starts, col_starts = _gen_choose_layout(rows, cols, filled_count)
    grid = _gen_render_frame(bg, frame, row_axis, col_axis, row_starts, col_starts)
    _gen_place_objects(grid, out, bg, row_axis, col_axis, row_starts, col_starts)

    if _gen_is_valid(grid, out, bg, frame):
        return grid
    return None


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRY_LIMIT):
import numpy as np
from collections import Counter, deque

from arc_utils import components_mask, get_bg, neighbors4, neighbors8
import random
def _components_mask(mask: np.ndarray, conn8: bool) -> list[list[tuple[int, int]]]:
    return [[(int(r), int(c)) for r, c in comp] for comp in components_mask(mask, connectivity=8 if conn8 else 4)]


def _touches_border(pts: list[tuple[int, int]], h: int, w: int) -> bool:
    return any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)


def _seed_pixels(g: np.ndarray, bg: int) -> list[tuple[int, int]]:
    h, w = g.shape
    vals, cnts = np.unique(g, return_counts=True)
    seeds: list[tuple[int, int]] = []
    for v, cnt in zip(vals, cnts):
        v = int(v)
        if v == bg or int(cnt) != 1:
            continue
        r, c = map(int, np.argwhere(g == v)[0])
        if r == 0 or c == 0 or r == h - 1 or c == w - 1:
            seeds.append((r, c))
    return seeds


def _nonbg_component8_from(g: np.ndarray, start: tuple[int, int], bg: int) -> set[tuple[int, int]]:
    h, w = g.shape
    st = [start]
    vis = {start}
    while st:
        r, c = st.pop()
        for nr, nc in neighbors8(r, c):
            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in vis and int(g[nr, nc]) != bg:
                vis.add((nr, nc))
                st.append((nr, nc))
    return vis


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fill enclosed regions along a line seeded by unique border pixels.

    Input structure:
    - bg = most common color.
    - Colored lines/drawings on the grid.
    - Unique single-pixel colors on the grid border mark seed endpoints of each line.

    Rule:
    - Each border seed pixel connects (8-connected) to a line drawing.
    - Find closed bg cavities whose boundary touches that line.
    - Flood-fill each such cavity with the seed pixel's color.

    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.
    """
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    bg = get_bg(g)

    out = g.copy()

    # Precompute background regions (4-connected). Exclude those containing background corners as "outside".
    bg_comps = _components_mask(g == bg, conn8=False)
    regions = []  # list of (set_pts, boundary_set, touches_border, size)
    for pts in bg_comps:
        region = set(pts)
        touches = _touches_border(pts, h, w)
        boundary = set()
        for r, c in region:
            for nr, nc in neighbors4(r, c):
                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:
                    boundary.add((nr, nc))
        regions.append((region, boundary, touches, len(region)))

    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}
    outside_idxs = set()
    for i, (reg, _, _, _) in enumerate(regions):
        if any(p in reg for p in corners if int(g[p]) == bg):
            outside_idxs.add(i)

    cavities = []
    for i, (reg, bnd, _, _) in enumerate(regions):
        if i in outside_idxs or not bnd:
            continue
        bcols = {int(g[p]) for p in bnd}
        cavities.append((reg, bnd, bcols))

    for sr, sc in _seed_pixels(g, bg):
        seed_col = int(g[sr, sc])

        neigh_cols = []
        for nr, nc in neighbors4(sr, sc):
            if 0 <= nr < h and 0 <= nc < w:
                v = int(g[nr, nc])
                if v != bg:
                    neigh_cols.append(v)
        assert neigh_cols, "seed pixel must have at least one non-bg neighbor"
        line_col = Counter(neigh_cols).most_common(1)[0][0]

        # Trace the connected "drawing" reachable from the seed (8-connected, non-background).
        traced = _nonbg_component8_from(g, (sr, sc), bg)

        for cav, boundary, bcols in cavities:
            if len(bcols) != 1:
                continue
            boundary_in_traced = boundary & traced
            if not boundary_in_traced:
                continue

            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.
            # This prevents filling regions that are only connected through other structures, not the line itself.
            ok = False
            for r, c in boundary_in_traced:
                for nr, nc in neighbors8(r, c):
                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:
                        ok = True
                        break
                if ok:
                    break
            if not ok:
                continue

            for r, c in cav:
                if int(out[r, c]) == bg:
                    out[r, c] = seed_col

    return out

# --------------- generator (attempt_1_distractor_network) ---------------

# ========================== CFG ==========================
# Canvas / grid
GRID_H_RANGE = (8, 30)             # grid height bounds
GRID_W_RANGE = (8, 30)             # grid width bounds
BG_COLORS = [0, 5]                 # background color choices

# Seeds
SEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)
MIN_LINE_LEN = 4                   # discard attempt if line shorter than this
LINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)

# Frame loops
FRAME_COLORS_MAX = 4               # max distinct frame colors
TOTAL_LOOPS_MAX = 9                # max total loops per grid
CAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)
DISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)
FRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge
FRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt
DISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement

# Line growth
DIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps
DIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps
ORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps
ORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps
BORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells
BIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck

# Distractor network
DISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames
DISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network
DISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range
DISTRACTOR_SOLO_MAX = 2            # max solo distractor frames
DISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network

# Generation
GEN_RETRIES = 300                  # outer retry budget in generate_input()
# =========================================================

DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
ORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]


def _in_bounds(h, w, r, c):
    return 0 <= r < h and 0 <= c < w


# ---------------------------------------------------------------------------
# Frame geometry
# ---------------------------------------------------------------------------

def _frame_ring_coords(r0, c0, ch, cw):
    """Return (ring_coords, cavity_coords) for a rounded-rect frame.

    Frame bbox is [r0, r0+ch+1] x [c0, c0+cw+1] (inclusive).
    Ring = bbox boundary minus 4 corners.
    """
    H, W = ch + 2, cw + 2
    ring = []
    for dr in range(H):
        for dc in range(W):
            on_bdr = (dr == 0 or dr == H - 1 or dc == 0 or dc == W - 1)
            corner = (dr in (0, H - 1)) and (dc in (0, W - 1))
            if on_bdr and not corner:
                ring.append((r0 + dr, c0 + dc))
    cavity = [(r0 + 1 + dr, c0 + 1 + dc) for dr in range(ch) for dc in range(cw)]
    return ring, cavity


def _validate_frame_placement(canvas, ring, cavity, line_col, h, w):
    """Check that ring+cavity can be placed on canvas without conflicts.

    Returns True if: ring and cavity cells are empty, no cavity cell is
    8-adjacent to line_col, ring is not 8-adjacent to foreign colors, and
    at least one ring cell is 8-adjacent to a line_col pixel.
    """
    # Ring and cavity cells must all be empty
    for rr, cc in ring:
        if canvas[rr, cc] != -1:
            return False
    for rr, cc in cavity:
        if canvas[rr, cc] != -1:
            return False

    # No cavity cell may be 8-adjacent to any line_col pixel
    for cr, cc in cavity:
        for nr, nc in neighbors8(cr, cc):
            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:
                return False

    # Ring must not be 8-adjacent to any non-bg, non-line_col pixel
    ring_set = set(ring)
    for rr, cc in ring:
        for nr, nc in neighbors8(rr, cc):
            if not _in_bounds(h, w, nr, nc) or (nr, nc) in ring_set:
                continue
            v = canvas[nr, nc]
            if v != -1 and v != line_col:
                return False

    # At least one ring cell must be 8-adjacent to a line_col pixel
    for rr, cc in ring:
        for nr, nc in neighbors8(rr, cc):
            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:
                return True
    return False


# ---------------------------------------------------------------------------
# Line growth
# ---------------------------------------------------------------------------

def _grow_line(grid, start, line_col, target_len, rng):
    """Grow a meandering 8-connected 1px-wide path of line_col from start."""
    h, w = grid.shape
    path = [start]
    dr_bias = 1 if start[0] < h // 2 else -1
    dc_bias = 1 if start[1] < w // 2 else -1
    cur = start
    path_set = {start}
    while len(path) < target_len:
        # Build weighted direction list: diagonals preferred, bias-aligned boosted
        dirs = []
        for ddr, ddc in DIAG_DIRS:
            aligned = (ddr == dr_bias or ddc == dc_bias)
            w_d = DIAG_WEIGHT_ALIGNED if aligned else DIAG_WEIGHT_OTHER
            dirs.extend([(ddr, ddc)] * w_d)
        for ddr, ddc in ORTHO_DIRS:
            aligned = (ddr == dr_bias and ddc == 0) or (ddc == dc_bias and ddr == 0)
from __future__ import annotations

from collections import Counter, deque
import numpy as np

from arc_utils import label_mask
import random


DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
UP = (-1, 0)
DOWN = (1, 0)
RIGHT = (0, 1)


class _DSU:
    def __init__(self, n: int):
        self.parent = list(range(int(n)))

    def find(self, x: int) -> int:
        x = int(x)
        while self.parent[x] != x:
            self.parent[x] = self.parent[self.parent[x]]
            x = self.parent[x]
        return int(x)

    def union(self, a: int, b: int) -> None:
        ra = self.find(a)
        rb = self.find(b)
        if ra != rb:
            self.parent[rb] = ra


def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
    return 0 <= int(r) < int(shape[0]) and 0 <= int(c) < int(shape[1])


def _opp(d: tuple[int, int]) -> tuple[int, int]:
    return (-int(d[0]), -int(d[1]))


def _stem_from_branches(branches: list[tuple[int, int]]) -> tuple[int, int]:
    assert len(branches) == 3
    branch_set = set(branches)
    for d in branches:
        if _opp(d) not in branch_set:
            return d
    raise AssertionError("T marker has no single stem")


def _parse_tetromino(cells: set[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int], list[tuple[int, int]]] | None:
    if len(cells) != 4:
        return None
    for r, c in cells:
        branches = [(dr, dc) for dr, dc in DIRS if (r + dr, c + dc) in cells]
        if len(branches) != 3:
            continue
        stem = _stem_from_branches(branches)
        expected = {(r, c), (r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)}
        expected.remove((r - stem[0], c - stem[1]))
        if cells == expected:
            bar = [d for d in branches if d != stem]
            assert len(bar) == 2 and bar[0] == _opp(bar[1])
            return (int(r), int(c)), stem, bar
    return None


def _label_base_components(g: np.ndarray, control: np.ndarray) -> tuple[np.ndarray, list[int], list[int]]:
    comp_id = np.full(g.shape, -1, dtype=int)
    comp_colors: list[int] = []
    comp_areas: list[int] = []
    cid = 0
    for col in sorted(set(map(int, g.ravel())) - {1}):
        labels, n_labels = label_mask((g == col) & (~control), connectivity=4)
        for k in range(1, int(n_labels) + 1):
            coords = np.argwhere(labels == k)
            if coords.size == 0:
                continue
            for rr, cc in coords:
                comp_id[int(rr), int(cc)] = cid
            comp_colors.append(int(col))
            comp_areas.append(int(len(coords)))
            cid += 1
    return comp_id, comp_colors, comp_areas


def _solve_unrotated(g: np.ndarray) -> np.ndarray:
    labels_1, n_1 = label_mask(g == 1, connectivity=4)
    one_components = {
        k: {tuple(map(int, xy)) for xy in np.argwhere(labels_1 == k)}
        for k in range(1, int(n_1) + 1)
    }
    one_sizes = {k: len(cells) for k, cells in one_components.items()}

    markers: list[dict] = []
    used_ones: set[tuple[int, int]] = set()
    control = np.zeros(g.shape, dtype=bool)

    for cells in one_components.values():
        parsed = _parse_tetromino(cells)
        if parsed is None:
            continue
        center, stem, bar = parsed
        markers.append({"kind": "normal", "center": center, "stem": stem, "bar": bar, "cells": cells})
        used_ones |= cells
        for r, c in cells:
            control[r, c] = True

    for r in range(g.shape[0]):
        for c in range(g.shape[1]):
            if int(g[r, c]) == 1:
                continue
            branches: list[tuple[int, int]] = []
            cells: list[tuple[int, int]] = []
            ok = True
            for d in DIRS:
                rr, cc = r + d[0], c + d[1]
                if not _in_bounds(g.shape, rr, cc) or int(g[rr, cc]) != 1:
                    continue
                label = int(labels_1[rr, cc])
                if one_sizes[label] == 1 and (rr, cc) not in used_ones:
                    branches.append(d)
                    cells.append((rr, cc))
                else:
                    ok = False
            if ok and len(branches) == 3:
                stem = _stem_from_branches(branches)
                bar = [d for d in branches if d != stem]
                assert len(bar) == 2 and bar[0] == _opp(bar[1])
                marker_cells = set(cells) | {(int(r), int(c))}
                markers.append(
                    {
                        "kind": "colored",
                        "center": (int(r), int(c)),
                        "stem": stem,
                        "bar": bar,
                        "cells": marker_cells,
                        "target_color": int(g[r, c]),
                    }
                )
                used_ones |= set(cells)
                for rr, cc in marker_cells:
                    control[rr, cc] = True

    all_one_cells = {tuple(map(int, xy)) for xy in np.argwhere(g == 1)}
    assert all_one_cells == used_ones, "all color-1 pixels must belong to a T control marker"

    for col in sorted(set(map(int, g.ravel())) - {1}):
        labels, n_labels = label_mask((g == col) & (~control), connectivity=4)
        for k in range(1, int(n_labels) + 1):
            coords = np.argwhere(labels == k)
            if len(coords) > 5:
                continue
            r0, c0 = coords.min(axis=0)
            r1, c1 = coords.max(axis=0)
            if len(coords) == (int(r1) - int(r0) + 1) * (int(c1) - int(c0) + 1):
                continue
            cells = {tuple(map(int, xy)) for xy in coords}
            markers.append({"kind": "small", "cells": cells})
            for rr, cc in cells:
                control[rr, cc] = True

    comp_id, comp_colors, comp_areas = _label_base_components(g, control)
    assert comp_colors, "at least one base region is required"
    dsu = _DSU(len(comp_colors))

    def first_component_from(center: tuple[int, int], direction: tuple[int, int], start: int) -> int | None:
        r, c = center
        step = int(start)
        while True:
            rr = r + direction[0] * step
            cc = c + direction[1] * step
            if not _in_bounds(g.shape, rr, cc):
                return None
            if comp_id[rr, cc] >= 0:
                return int(comp_id[rr, cc])
            step += 1

    def adjacent_component_counts(cells: set[tuple[int, int]]) -> Counter:
        counts: Counter = Counter()
        for r, c in cells:
            for dr, dc in DIRS:
                rr, cc = r + dr, c + dc
                if _in_bounds(g.shape, rr, cc) and comp_id[rr, cc] >= 0:
                    counts[int(comp_id[rr, cc])] += 1
        return counts

    for marker in markers:
        if marker["kind"] in {"normal", "colored"}:
            center = marker["center"]
            stem = marker["stem"]
            dest = first_component_from(center, stem, start=2)
            assert dest is not None, "T marker must point at a destination region"

            source_parts: list[int] = []
            for bar_dir in marker["bar"]:
                rr = center[0] + stem[0] + bar_dir[0]
                cc = center[1] + stem[1] + bar_dir[1]
                assert _in_bounds(g.shape, rr, cc) and comp_id[rr, cc] >= 0
                source_parts.append(int(comp_id[rr, cc]))
            source = source_parts[0]
            for part in source_parts[1:]:
                assert comp_colors[part] == comp_colors[source], "T source diagonals must share a color"
                dsu.union(source, part)

            for comp in adjacent_component_counts(marker["cells"]):
                if comp_colors[comp] == comp_colors[source]:
                    dsu.union(source, comp)
            marker["dest_comp"] = dest
            marker["source_comp"] = source
        else:
            counts = adjacent_component_counts(marker["cells"])
            assert counts, "small marker must touch its owner region"
            owner = max(counts, key=lambda c: (counts[c], comp_areas[c]))
            for comp in counts:
                if comp_colors[comp] == comp_colors[owner]:
                    dsu.union(owner, comp)
            marker["source_comp"] = owner

    root_color: dict[int, int] = {}
    for i, col in enumerate(comp_colors):
        root = dsu.find(i)
        root_color.setdefault(root, int(col))
        assert root_color[root] == int(col), "merged region colors must match"

    final_color = dict(root_color)
    for marker in markers:
        if marker["kind"] not in {"normal", "colored"}:
            marker["source"] = dsu.find(marker["source_comp"])
            continue
        dest = dsu.find(marker["dest_comp"])
        source = dsu.find(marker["source_comp"])
        marker["source"] = source
        replacement = int(marker["target_color"]) if marker["kind"] == "colored" else int(root_color[source])
        assert final_color[dest] in {root_color[dest], replacement}, "conflicting T controls for one region"
        final_color[dest] = replacement

    out = np.full(g.shape, -1, dtype=int)
    for r in range(g.shape[0]):
        for c in range(g.shape[1]):
            cid = int(comp_id[r, c])
            if cid >= 0:
                out[r, c] = int(final_color[dsu.find(cid)])

    for marker in markers:
        color = int(final_color[marker["source"]])
        for r, c in marker["cells"]:
            out[r, c] = color

    assert bool(np.all(out >= 0)), "all cells must be assigned"
    return out


