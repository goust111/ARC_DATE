+        return None
+    if wrap_mode != (len(rects) > seed_count):
+        return None
+    if len(set(seed_colors)) != len(seed_colors):
+        return None
+    if not np.array_equal(main(inp), expected):
+        return None
+    return inp, expected
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
