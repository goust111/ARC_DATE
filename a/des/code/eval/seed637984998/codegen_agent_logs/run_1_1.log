+    inner = g[r0 + 1 : r1, c0 + 1 : c1]
+    h, w = inner.shape
+    seen = np.zeros((h, w), dtype=bool)
+    regions: list[dict[str, object]] = []
+
+    for sr in range(h):
+        for sc in range(w):
+            if seen[sr, sc] or int(inner[sr, sc]) != BG:
+                continue
+            stack = [(sr, sc)]
+            seen[sr, sc] = True
+            coords: list[tuple[int, int]] = []
+            min_r = r0 + 1 + sr
+            min_c = c0 + 1 + sc
