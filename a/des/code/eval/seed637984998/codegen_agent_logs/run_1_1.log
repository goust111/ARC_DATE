+    height = _rect_h(rect)
+    if width % 2 == 1 and width >= 2 * MIN_REGION_SIDE + 1:
+        opts.append(("v", c0 + width // 2))
+    if height % 2 == 1 and height >= 2 * MIN_REGION_SIDE + 1:
+        opts.append(("h", r0 + height // 2))
