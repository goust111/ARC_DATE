+        root_opts = _split_options(root)
+        random.shuffle(root_opts)
+
+        for axis1, pos1 in root_opts:
+            first_children, wall1 = _apply_split(root, axis1, pos1)
+            child_indices = [0, 1]
+            random.shuffle(child_indices)
