+    table_mask = np.zeros_like(grid, dtype=bool)
+
+    for r0, blocks in block_rows.items():
+        if len(blocks) != 1:
+            continue
+        block_c0, out_color, block_coords = blocks[0]
+        markers = [(c0, turn, coords) for c0, turn, coords in marker_rows.get(r0, []) if c0 < block_c0]
