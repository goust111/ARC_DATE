+    pipe_count = entry_count + int(RNG.integers(EXTRA_PIPE_MAX + 1))
+    assignment = list(range(entry_count))
+    assignment.extend(int(v) for v in RNG.integers(0, entry_count, size=pipe_count - entry_count))
+    RNG.shuffle(assignment)
