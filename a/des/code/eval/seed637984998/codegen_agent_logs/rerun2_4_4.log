+    prev = None
+    cur = start
+    while len(ordered) < len(comp):
+        nxts = [nei for nei in _neighbors4(*cur) if nei in pts and nei != prev]
+        assert len(nxts) == 1, "pipe walk must stay unambiguous"
+        nxt = nxts[0]
+        ordered.append(nxt)
+        prev, cur = cur, nxt
