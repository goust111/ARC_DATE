+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATE_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid sample")

