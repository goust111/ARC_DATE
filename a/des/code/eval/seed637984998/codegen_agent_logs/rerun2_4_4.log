+    if len(rel) != 3:
+        return None
+    col_counts = [sum(dc == 0 for _, dc in rel), sum(dc == 1 for _, dc in rel)]
+    row_counts = [sum(dr == 0 for dr, _ in rel), sum(dr == 1 for dr, _ in rel)]
+    if sorted(col_counts) != [1, 2] or sorted(row_counts) != [1, 2]:
