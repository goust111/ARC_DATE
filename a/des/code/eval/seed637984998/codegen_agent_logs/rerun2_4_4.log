+    steps = [(r1 - r0, c1 - c0) for (r0, c0), (r1, c1) in zip(path, path[1:])]
+    turns: list[str] = []
+    for prev, cur in zip(steps, steps[1:]):
+        if prev == cur:
+            continue
+        cross = prev[0] * cur[1] - prev[1] * cur[0]
+        assert cross != 0, "path turn must be 90 degrees"
+        turns.append("L" if cross > 0 else "R")
