+    for comp in _components(grid != 0):
+        marker = _classify_marker(comp)
+        if marker is not None:
+            r0, c0, turn = marker
+            marker_rows[r0].append((c0, turn, comp))
+            continue
+        block = _classify_block(grid, comp)
+        if block is not None:
+            r0, c0, color = block
+            block_rows[r0].append((c0, color, comp))
