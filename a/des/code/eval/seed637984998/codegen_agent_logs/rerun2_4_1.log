+    r0, c0, r1, c1 = _bbox(coords)
+    height = int(r1 - r0 + 1)
+    width = int(c1 - c0 + 1)
+    if height < 3 or width < 3:
+        return False
+
+    frame = np.zeros((height, width), dtype=bool)
+    frame[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    expected = np.zeros_like(frame)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    return bool(np.array_equal(frame, expected))
