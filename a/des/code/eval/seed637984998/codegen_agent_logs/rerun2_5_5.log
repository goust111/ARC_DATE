    grid = np.full((height, width), GEN_BG, dtype=int)
    for r0, c0 in regions:
        _gen_stamp_region(grid, r0, c0)

    expected = _gen_expected_output(grid, regions)
    try:
        actual = main(grid)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return grid


