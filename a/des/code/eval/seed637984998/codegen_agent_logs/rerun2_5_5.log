+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q: deque[tuple[int, int]] = deque([(int(r), int(c))])
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((int(nr), int(nc)))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _ring_mask_from_bbox(shape: tuple[int, int], bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    mask = np.zeros(shape, dtype=bool)
+    mask[r0, c0 : c1 + 1] = True
+    mask[r1, c0 : c1 + 1] = True
+    mask[r0 : r1 + 1, c0] = True
+    mask[r0 : r1 + 1, c1] = True
+    return mask
+
+
+def _is_rect_ring(coords: np.ndarray) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    expected = 2 * h + 2 * w - 4
+    if len(coords) != expected:
+        return False
+    local = np.zeros((h, w), dtype=bool)
+    local[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return bool(np.array_equal(local, border))
+
+
+def _draw_ring(grid: np.ndarray, bbox: tuple[int, int, int, int], color: int) -> None:
+    r0, c0, r1, c1 = bbox
+    grid[r0, c0 : c1 + 1] = color
+    grid[r1, c0 : c1 + 1] = color
+    grid[r0 : r1 + 1, c0] = color
+    grid[r0 : r1 + 1, c1] = color
+
