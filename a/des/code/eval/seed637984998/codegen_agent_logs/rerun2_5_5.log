+    colors: list[int] = []
+    for comp in sorted(comps, key=lambda x: int(x[:, 0].min())):
+        vals = set(map(int, grid[comp[:, 0], comp[:, 1]]))
+        vals.discard(bg)
+        assert len(vals) == 1, "each legend block must be monochrome"
+        colors.append(vals.pop())
