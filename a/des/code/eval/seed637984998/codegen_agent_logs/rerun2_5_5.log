    paste(grid, GEN_PATCH, r0, c0)
    teal_count = random.randint(MIN_TEAL_INTERIOR, MAX_TEAL_INTERIOR)
    for rr, cc in random.sample(GEN_INTERIOR, teal_count):
        grid[r0 + rr + 1, c0 + cc + 1] = GEN_BG


