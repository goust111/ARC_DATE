+    size = int(patch.shape[0])
+    grid[top : top + size, left : left + size] = patch
+    occupied[top : top + size, left : left + size] = True
+
+
+def _expected_output(grid: np.ndarray, pair_specs: list[dict]) -> np.ndarray:
+    out = grid.copy()
+    for spec in pair_specs:
