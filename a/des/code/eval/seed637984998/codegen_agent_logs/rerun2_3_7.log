+def _neighbors4(r: int, c: int, size: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < size:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < size:
+        yield r, c + 1
