+        rotated = np.rot90(inner, -int(spec["turns_cw"]))
+        top = int(spec["canvas_top"])
+        left = int(spec["canvas_left"])
+        size = int(spec["size"])
+        frame_color = int(spec["frame_color"])
+
+        patch = out[top : top + size, left : left + size]
+        patch[0, :] = frame_color
+        patch[-1, :] = frame_color
+        patch[:, 0] = frame_color
+        patch[:, -1] = frame_color
+        patch[1:-1, 1:-1] = rotated
