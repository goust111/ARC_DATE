+PLACEMENT_RETRIES = 220
+GEN_RETRIES = 400
+ROOM_GAP = 1
+
+BASE_H_RANGE = (4, 8)
+BASE_W_RANGE = (4, 8)
+ARM_DEPTH_RANGE = (1, 3)
