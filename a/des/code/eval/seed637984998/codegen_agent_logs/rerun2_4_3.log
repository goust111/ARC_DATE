+BLACK = 0
+WALL = 5
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+# Generator configuration.
+GRID_H_RANGE = (22, 30)
+GRID_W_RANGE = (22, 30)
