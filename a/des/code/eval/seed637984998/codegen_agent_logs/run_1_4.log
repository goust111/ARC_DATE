+            focus_positions = []
+            compatible: dict[tuple[int, int], list[str]] = {}
+            valid = True
+            for idx in range(1, len(path) - 1):
+                cell = path[idx]
+                possible = _possible_categories(graph, path, idx)
+                if len(graph[cell]) >= 3 and not possible:
+                    valid = False
