def _render_grid(
    rows: int,
    cols: int,
    graph: dict[tuple[int, int], set[tuple[int, int]]],
    start_cell: tuple[int, int],
    start_port: int,
    end_cell: tuple[int, int],
    end_port: int,
    markers: dict[tuple[int, int], int],
    rng: random.Random,
) -> tuple[np.ndarray, tuple[int, int]]:
    maze_h = 2 * rows + 1
    maze_w = 2 * cols + 1
    maze = np.full((maze_h, maze_w), GREY, dtype=int)

    for cell, nbrs in graph.items():
        rr, cc = 2 * cell[0] + 1, 2 * cell[1] + 1
        maze[rr, cc] = BLACK
        for nb in nbrs:
            if nb < cell:
                continue
            dr = nb[0] - cell[0]
            dc = nb[1] - cell[1]
            maze[rr + dr, cc + dc] = BLACK

    for cell, color in markers.items():
        rr, cc = 2 * cell[0] + 1, 2 * cell[1] + 1
        maze[rr, cc] = color

    gap_cells = []
    marker_cells = []
    for cell, port, color in (
        (start_cell, start_port, next(v for v in {BLUE, RED} if v in markers.values() or True)),
        (end_cell, end_port, None),
    ):
        rr, cc = 2 * cell[0] + 1, 2 * cell[1] + 1
        dr, dc = DIRS[port]
        gap = (rr + dr, cc + dc)
        outside = (rr + 2 * dr, cc + 2 * dc)
        gap_cells.append(gap)
        marker_cells.append(outside)

    start_color = None
    exit_color = None
    for color in markers.values():
        if start_color is None:
            start_color = color
        elif color != start_color:
            exit_color = color
            break
    if exit_color is None:
        exit_color = RED if start_color == BLUE else BLUE

    external = [
        (start_cell, start_port, start_color),
        (end_cell, end_port, exit_color),
    ]
    for cell, port, color in external:
        rr, cc = 2 * cell[0] + 1, 2 * cell[1] + 1
        dr, dc = DIRS[port]
        maze[rr + dr, cc + dc] = BLACK

    pad_top = rng.randint(1, 3)
    pad_bottom = rng.randint(1, 3)
    pad_left = rng.randint(1, 3)
    pad_right = rng.randint(1, 3)
    grid = np.full((maze_h + pad_top + pad_bottom, maze_w + pad_left + pad_right), BLACK, dtype=int)
    grid[pad_top : pad_top + maze_h, pad_left : pad_left + maze_w] = maze

