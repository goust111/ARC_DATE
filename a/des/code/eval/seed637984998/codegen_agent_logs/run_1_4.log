+        boundary_dirs = _touching_boundary_dirs(cell, rows, cols)
+        if not boundary_dirs:
+            continue
+        only_neighbor = next(iter(nbrs))
+        preferred_port = _opposite(_cell_direction(cell, only_neighbor))
+        if preferred_port in boundary_dirs:
