+    grid, focus_pixel = _render_grid(
+        rows,
+        cols,
+        graph,
+        start_cell,
+        start_port,
+        end_cell,
+        end_port,
+        rebuilt,
+        start_color,
+        exit_color,
+        focus_cell,
+        rng,
