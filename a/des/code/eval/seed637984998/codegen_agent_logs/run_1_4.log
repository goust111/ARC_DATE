+    seen: set[tuple[int, int]] = set()
+    for r, c in _perimeter_cells(r0, c0, r1, c1):
+        if int(grid[r, c]) == GREY:
+            continue
+        if (r, c) in seen:
+            continue
+        seen.add((r, c))
+        if r == r0:
+            outside = (r - 1, c)
+            direction = 2
+        elif r == r1:
