+
+
+def _trace_route(
+    grid: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    start_gap: dict[str, int | tuple[int, int]],
+    goal_gap: dict[str, int | tuple[int, int]],
+) -> list[tuple[int, int]] | None:
