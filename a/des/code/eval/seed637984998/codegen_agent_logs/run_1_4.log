+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # U, R, D, L
+DIR_TO_INDEX = {d: i for i, d in enumerate(DIRS)}
+BRANCH_TARGETS = [
+    "prefer_left",
+    "prefer_right",
+    "fallback_straight_from_left",
+    "fallback_straight_from_right",
+    "fallback_other_to_left",
+    "fallback_other_to_right",
