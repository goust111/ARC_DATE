+                    "start_cell": start_cell,
+                    "start_port": start_port,
+                    "end_cell": end_cell,
+                    "end_port": end_port,
+                    "path": path,
+                    "compatible": compatible,
+                    "focus_positions": focus_positions,
+                }
+            )
