+    mirror_pairs: list[tuple[tuple[int, int], tuple[int, int], str]] = []
+    for comp in _components(g == GRAY, connectivity=8):
+        assert len(comp) == 2, "each gray mirror must be a 2-pixel component"
+        (r0, c0), (r1, c1) = sorted(comp)
