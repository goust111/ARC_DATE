+
+BLACK = 0
+YELLOW = 4
+GRAY = 5
+TOWER_PALETTE = (1, 2, 3, 6, 7, 8, 9)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_H_RANGE = (12, 19)
+GRID_W_RANGE = (12, 19)
+TOWER_COUNT_CHOICES = (2, 3)
+MIRROR_COUNT_RANGE = (1, 4)
+PLACEMENT_RETRIES = 160
+GENERATE_RETRIES = 400
+MIN_TOWER_MARGIN = 2
+MIN_TOWER_GAP = 4
+MAX_PAINT_FRAC_NUM = 9
+MAX_PAINT_FRAC_DEN = 20
