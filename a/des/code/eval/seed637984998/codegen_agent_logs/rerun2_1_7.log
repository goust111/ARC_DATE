+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((int(cr), int(cc)))
+                for dr, dc in steps:
+                    nr, nc = cr + dr, cc + dc
+                    if not _in_bounds(h, w, nr, nc):
