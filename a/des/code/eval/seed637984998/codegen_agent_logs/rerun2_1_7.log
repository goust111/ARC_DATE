+def _reflect(direction: tuple[int, int], mirror_kind: str) -> tuple[int, int]:
+    dr, dc = direction
+    if mirror_kind == "\\":
+        return dc, dr
+    assert mirror_kind == "/"
+    return -dc, -dr
