+
+def _place_frames(
+    grid: np.ndarray,
+    forbidden: np.ndarray,
+    specs: list[dict[str, object]],
+    sample_edge: str,
+    sample_h: int,
+    rng: np.random.Generator,
+) -> bool:
+    h, w = grid.shape
+    for spec in specs:
+        size = int(spec["size"])
+        outer = size + 2
+        if sample_edge == "top":
+            min_r = sample_h + 1
+            max_r = h - outer - 1
+        else:
+            min_r = 1
+            max_r = h - sample_h - outer - 1
+        min_c = 1
+        max_c = w - outer - 1
+        if min_r > max_r or min_c > max_c:
+            return False
+        placed = False
+        for _ in range(250):
+            or0 = int(rng.integers(min_r, max_r + 1))
+            oc0 = int(rng.integers(min_c, max_c + 1))
+            outer_bbox = (or0, oc0, or0 + outer - 1, oc0 + outer - 1)
+            r0 = or0 + 1
+            c0 = oc0 + 1
+            r1 = r0 + size - 1
+            c1 = c0 + size - 1
+            if forbidden[outer_bbox[0] : outer_bbox[2] + 1, outer_bbox[1] : outer_bbox[3] + 1].any():
+                continue
+            grid[r0, c0 : c1 + 1] = GREY
+            grid[r1, c0 : c1 + 1] = GREY
+            grid[r0 : r1 + 1, c0] = GREY
+            grid[r0 : r1 + 1, c1] = GREY
+            inner = spec["mask"]
+            color = int(spec["color"])
+            grid[r0 + 1 : r1, c0 + 1 : c1][inner] = color
+            _mark_rect(forbidden, outer_bbox, pad=1)
+            placed = True
+            break
+        if not placed:
+            return False
+    return True
+
+
+def _validate_grid(grid: np.ndarray) -> bool:
