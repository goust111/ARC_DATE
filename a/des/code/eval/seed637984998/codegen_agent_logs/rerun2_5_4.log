+
+
+def _gen_attempt() -> np.ndarray | None:
+    rng = _RNG
+    sample_h = int(rng.integers(8, 11))
+    widths = [int(rng.integers(8, 11)) for _ in range(3)]
+    gaps = [int(rng.integers(1, 4)) for _ in range(2)]
+    total_sample_w = int(sum(widths) + sum(gaps))
