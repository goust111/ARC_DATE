+
+    out = np.zeros((canvas_h, canvas_w), dtype=int)
+    for _area, _r0, _c0, pattern in patterns:
+        ph, pw = pattern.shape
+        top = (canvas_h - ph) // 2
+        left = (canvas_w - pw) // 2
