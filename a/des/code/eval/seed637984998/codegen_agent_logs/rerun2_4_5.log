+BLACK = 0
+GREY = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+
+STAMP_COUNT_RANGE = (2, 4)
+INTERIOR_HEIGHT_RANGE = (4, 8)
+INTERIOR_WIDTH_RANGE = (4, 8)
+COLOR_COUNT_RANGE = (2, 4)
