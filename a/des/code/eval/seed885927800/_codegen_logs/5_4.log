+    for color in sorted(set(map(int, np.unique(lower)))):
+        if color in (BLACK, RED, GREY, MAROON):
+            continue
+        comps = _components(lower == color, connectivity=8)
+        bodies = [comp for comp in comps if len(comp) >= 2]
+        if not bodies:
