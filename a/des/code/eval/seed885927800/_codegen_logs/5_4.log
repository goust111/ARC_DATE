+        reverse=True,
+    )
+    for nxt in candidates:
+        path.append(nxt)
+        used.add(nxt)
+        solved = _build_walk(path, used, target_len, inner_h, inner_w, rng)
+        if solved is not None:
+            return solved
+        used.remove(nxt)
+        path.pop()
+    return None
+
+
+def _marker_options(
+    endpoint: tuple[int, int],
+    path_set: set[tuple[int, int]],
+    inner_h: int,
+    inner_w: int,
+) -> list[tuple[int, int]]:
+    out = []
+    er, ec = endpoint
+    for dr, dc in DIRS8:
+        mr = er + dr
+        mc = ec + dc
+        marker = (mr, mc)
+        if not _in_bounds(inner_h, inner_w, mr, mc) or marker in path_set:
+            continue
+        touching = [p for p in path_set if max(abs(p[0] - mr), abs(p[1] - mc)) <= 1]
+        if touching == [endpoint] or set(touching) == {endpoint}:
+            out.append(marker)
