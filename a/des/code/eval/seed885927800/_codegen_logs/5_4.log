+
+
+def _path_candidates(
+    cur: tuple[int, int],
+    used: set[tuple[int, int]],
+    inner_h: int,
+    inner_w: int,
+) -> list[tuple[int, int]]:
+    out = []
+    r, c = cur
+    for dr, dc in DIRS8:
+        nr = r + dr
+        nc = c + dc
+        nxt = (nr, nc)
+        if not _in_bounds(inner_h, inner_w, nr, nc) or nxt in used:
+            continue
+        ok = True
+        for other in used:
+            if other == cur:
+                continue
+            if max(abs(other[0] - nr), abs(other[1] - nc)) <= 1:
+                ok = False
+                break
