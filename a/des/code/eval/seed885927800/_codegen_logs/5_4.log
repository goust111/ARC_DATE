+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Rebuild a fragment chain from endpoint markers and map its pixel colors onto template anchors.
+    """
+    g = np.asarray(grid, dtype=int)
+    divider = _find_divider(g)
