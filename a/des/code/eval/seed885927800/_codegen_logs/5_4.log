+    markers = []
+    for dr, dc in DIRS8:
+        nr = r + dr
+        nc = c + dc
+        if not _in_bounds(h, w, nr, nc):
+            continue
+        val = int(lower[nr, nc])
+        if val == BLACK or val == color:
+            continue
+        markers.append((nr, nc))
