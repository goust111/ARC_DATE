+                        "start_marker": (start_marker[0] + shift_r, start_marker[1] + shift_c),
+                        "end_marker": (end_marker[0] + shift_r, end_marker[1] + shift_c),
+                        "shape": (r1 - r0 + 1, c1 - c0 + 1),
+                    }
