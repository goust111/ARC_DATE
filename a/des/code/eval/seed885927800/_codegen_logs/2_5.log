+from __future__ import annotations
+
+import random
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+BACKGROUND = 0
+FRAME_COLOR = 5
+STAMP_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
