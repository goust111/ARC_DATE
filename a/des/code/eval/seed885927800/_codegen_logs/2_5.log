+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not mask[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in points]
+    cs = [c for _, c in points]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _crop_mask(points: list[tuple[int, int]]) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(points)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in points:
+        mask[r - r0, c - c0] = True
+    return mask
+
+
+def _border_cells(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _missing_corner_name(
+    missing: tuple[int, int], bbox: tuple[int, int, int, int]
+) -> str | None:
+    r0, c0, r1, c1 = bbox
+    if missing == (r0, c0):
+        return "tl"
+    if missing == (r0, c1):
+        return "tr"
+    if missing == (r1, c0):
+        return "bl"
+    if missing == (r1, c1):
+        return "br"
+    return None
+
+
+def _find_stamps(g: np.ndarray) -> dict[int, np.ndarray]:
+    stamps: dict[int, np.ndarray] = {}
+    for color in [int(v) for v in np.unique(g) if int(v) not in (BACKGROUND, FRAME_COLOR)]:
