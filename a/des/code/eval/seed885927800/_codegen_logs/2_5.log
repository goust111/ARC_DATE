+    top: int,
+    left: int,
+    inner_h: int,
+    inner_w: int,
+    corner: str,
+    anchor_rel: tuple[int, int],
+) -> None:
+    outer_h = inner_h + 2
+    outer_w = inner_w + 2
+    r0, c0 = top, left
