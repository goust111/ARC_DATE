13:     - bg = most common color.
14:     - Border-touching components cluster into anchor frames with interior bg cavities.
15:     - Non-border 2-color components are movable tools.
16: 
17:     Rule:
18:     - Match each tool to a frame whose cavity size equals one of its color-region counts.
19:     - Rotate/flip the tool so one color fills the cavity exactly; the other stays outside.
20:     - If the docking orientation uses a reflection, swap the tool's two colors.
21: 
22:     Key insight: Cavity size determines tool–frame pairing; reflection triggers color swap.
23:     """
24:     inp = grid
25:     g = inp.copy()
26:     bg = get_bg(g)
27:     H, W = g.shape
28: 
29:     def bbox_gap(a, b) -> int:
30:         (ar0, ac0, ar1, ac1) = a
31:         (br0, bc0, br1, bc1) = b
32:         def gap1(x0, x1, y0, y1):
33:             if y1 < x0:
34:                 return int(x0 - y1)
35:             if x1 < y0:
36:                 return int(y0 - x1)
37:             return 0
38:         return gap1(ar0, ar1, br0, br1) + gap1(ac0, ac1, bc0, bc1)
39: 
40:     fg = g != int(bg)
41:     lab, n = label(fg, structure=STRUCT4)
42:     fixed_mask = np.zeros((H, W), dtype=bool)
43:     fixed_components = []
44:     for cid in range(1, n + 1):
45:         pts = np.argwhere(lab == cid)
46:         pts_list = [(int(r), int(c)) for r, c in pts]
47:         touches = any(r == 0 or r == H - 1 or c == 0 or c == W - 1 for r, c in pts_list)
48:         if not touches:
49:             continue
50:         fixed_components.append({"pts": pts_list, "bbox": (int(pts[:,0].min()), int(pts[:,1].min()), int(pts[:,0].max()), int(pts[:,1].max()))})
51:         for r, c in pts_list:
52:             fixed_mask[r, c] = True
53: 
54:     assert not (not fixed_components)
55: 
56:     # Cluster fixed components into anchor frames.
57:     parent = list(range(len(fixed_components)))
58: 
59:     def find(x):
60:         while parent[x] != x:
61:             parent[x] = parent[parent[x]]
62:             x = parent[x]
63:         return x
64: 
65:     def union(a, b):
66:         ra, rb = find(a), find(b)
67:         if ra != rb:
68:             parent[rb] = ra
69: 
70:     for i in range(len(fixed_components)):
71:         for j in range(i + 1, len(fixed_components)):
72:             if bbox_gap(fixed_components[i]["bbox"], fixed_components[j]["bbox"]) <= 2:
73:                 union(i, j)
74: 
75:     groups: dict[int, list[int]] = {}
76:     for i in range(len(fixed_components)):
77:         groups.setdefault(find(i), []).append(i)
78: 
79:     anchor_groups = []
80:     for idxs in groups.values():
81:         pts = [p for i in idxs for p in fixed_components[i]["pts"]]
82:         rs = [r for r, _c in pts]
83:         cs = [c for _r, c in pts]
84:         bbox = (min(rs), min(cs), max(rs), max(cs))
85:         mask = np.zeros((H, W), dtype=bool)
86:         for r, c in pts:
87:             mask[r, c] = True
88:         sock = np.zeros((H, W), dtype=bool)
89:         for r in range(bbox[0], bbox[2] + 1):
90:             for c in range(bbox[1], bbox[3] + 1):
91:                 if int(g[r, c]) != int(bg):
92:                     continue
93:                 for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
94:                     rr, cc = r + dr, c + dc
95:                     if 0 <= rr < H and 0 <= cc < W and mask[rr, cc]:
96:                         sock[r, c] = True
97:                         break
98: 
99:         # Cavity = largest bg component inside bbox that is adjacent to the anchor pixels.
100:         cavity = np.zeros((H, W), dtype=bool)
101:         sub_bg = (g[bbox[0] : bbox[2] + 1, bbox[1] : bbox[3] + 1] == int(bg))
102:         sub_lab, sub_n = label(sub_bg, structure=STRUCT4)
103:         best_c = None  # (area, cid)
104:         for cid in range(1, sub_n + 1):
105:             ptsc = np.argwhere(sub_lab == cid)
106:             area = int(len(ptsc))
107:             # check adjacency to anchor within bbox
108:             adj = False
109:             for rr, cc in ptsc:
110:                 r = int(bbox[0] + rr)
111:                 c = int(bbox[1] + cc)
112:                 for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
113:                     r2, c2 = r + dr, c + dc
114:                     if bbox[0] <= r2 <= bbox[2] and bbox[1] <= c2 <= bbox[3] and mask[r2, c2]:
115:                         adj = True
116:                         break
117:                 if adj:
118:                     break
119:             if not adj:
120:                 continue
121:             cand = (area, -cid)
122:             if best_c is None or cand > best_c:
123:                 best_c = cand
124:                 best_id = cid
125:         if best_c is not None:
126:             ptsc = np.argwhere(sub_lab == best_id)
127:             for rr, cc in ptsc:
128:                 cavity[int(bbox[0] + rr), int(bbox[1] + cc)] = True
129:         cav_bbox = None
130:         if cavity.any():
131:             ptsc2 = np.argwhere(cavity)
132:             r0c, c0c = ptsc2.min(axis=0)
133:             r1c, c1c = ptsc2.max(axis=0)
134:             cav_bbox = (int(r0c), int(c0c), int(r1c), int(c1c))
135: 
136:         # swap rule for this anchor group: look for a color that appears in >=2 fixed sub-components
137:         # (within the group) with different sizes and larger-above-smaller.
138:         swap_needed = False
139:         for col in sorted({int(x) for x in np.unique(g[mask])} - {int(bg)}):
140:             sub = (g == int(col)) & mask
141:             labc, nc = label(sub, structure=STRUCT4)
142:             if nc < 2:
143:                 continue
144:             comps = []
145:             for cid in range(1, nc + 1):
146:                 ptsc = np.argwhere(labc == cid)
147:                 comps.append((int(len(ptsc)), float(ptsc[:, 0].mean()), float(ptsc[:, 1].mean())))
148:             comps.sort(reverse=True)
149:             (s0, r0, _c0), (s1, r1, _c1) = comps[0], comps[1]
150:             # Swap only when the larger component is vertically above the smaller one.
151:             if s0 != s1 and r0 < r1:
152:                 swap_needed = True
153:                 break
154: 
155:         # Dominant open direction: which side has the most bg neighbors.
156:         dir_list = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # U,D,L,R
157:         dir_counts = [0, 0, 0, 0]
158:         for r, c in pts:
159:             for di, (dr, dc) in enumerate(dir_list):
160:                 rr, cc = r + dr, c + dc
161:                 if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(bg):
162:                     dir_counts[di] += 1
163:         open_dir = dir_list[int(np.argmax(dir_counts))]
164:         _labg, _ng = label(mask, structure=STRUCT4)
165:         single_piece = int(_ng) == 1
166:         cavity_size = int(cavity.sum())
167: 
168:         anchor_groups.append(
169:             {
170:                 "mask": mask,
171:                 "bbox": bbox,
172:                 "socket_mask": sock,
173:                 "cavity_mask": cavity,
174:                 "cavity_bbox": cav_bbox,
175:                 "open_dir": open_dir,
176:                 "swap_needed": swap_needed,
177:                 "single_piece": single_piece,
178:                 "cavity_size": cavity_size,
179:                 "size": int(mask.sum()),
180:             }
181:         )
182:     anchor_groups.sort(key=lambda d: -d["size"])
183: 
184:     # Movable multi-color components are the remaining foreground pixels.
185:     mov_mask = fg & (~fixed_mask)
186:     mov_lab, mov_n = label(mov_mask, structure=STRUCT4)
187:     mov_comps = []
188:     for cid in range(1, mov_n + 1):
189:         pts = np.argwhere(mov_lab == cid)
190:         r0, c0 = pts.min(axis=0)
191:         r1, c1 = pts.max(axis=0)
192:         m = mov_lab[r0 : r1 + 1, c0 : c1 + 1] == cid
193:         patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()
194:         patch[~m] = 0
195:         mov_comps.append({"bbox": (int(r0), int(c0), int(r1), int(c1)), "mask": m, "patch": patch, "size": int(len(pts))})
196:     mov_comps.sort(key=lambda d: -d["size"])
197: 
198:     def choose_group(bbox) -> int:
199:         best_i = 0
200:         best_d = None
201:         for i, grp in enumerate(anchor_groups):
202:             d = bbox_gap(bbox, grp["bbox"])
203:             if best_d is None or d < best_d:
204:                 best_d = d
205:                 best_i = i
206:         return int(best_i)
207: 
208:     def gen_variants(patch: np.ndarray, mask: np.ndarray):
209:         """All unique dihedral variants, with a reflection flag."""
210:         base: list[tuple[np.ndarray, np.ndarray, bool]] = []
211:         for k in range(4):
212:             p = np.rot90(patch, k)
213:             m = np.rot90(mask, k)
214:             base.append((p, m, False))
215:             base.append((np.fliplr(p), np.fliplr(m), True))
216:         uniq: list[tuple[np.ndarray, np.ndarray, bool]] = []
217:         seen = set()
218:         for p, m, is_flip in base:
219:             key = (m.tobytes(), p[m].tobytes())
220:             if key in seen:
221:                 continue
222:             seen.add(key)
223:             uniq.append((p, m, is_flip))
224:         return uniq
225: 
226:     out = np.full_like(g, int(bg))
227:     out[fixed_mask] = g[fixed_mask]
228:     placed_global = fixed_mask.copy()
229:     placed_groups = [grp["mask"].copy() for grp in anchor_groups]
230: 
231:     group_for_comp: list[int]
232:     # Match condition (key): a tool can dock into a frame only if one of its two color-regions has
233:     # pixel-count equal to the frame's cavity size. Use this to assign tools to frames (one-to-one
234:     # when counts match), falling back to distance only if no such match exists.
235:     comp_color_counts: list[dict[int, int]] = []
236:     for comp in mov_comps:
237:         vals = [int(x) for x in comp["patch"][comp["mask"]].flatten() if int(x) != 0]
238:         comp_color_counts.append(dict(Counter(vals)))
239: 
240:     def compatible(ci: int, gi: int) -> bool:
241:         cav_sz = int(anchor_groups[gi]["cavity_size"])
