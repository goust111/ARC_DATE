+def _render_template_patch(spec: dict) -> np.ndarray:
+    patch = np.full((spec["outer_h"], spec["outer_w"]), FILL, dtype=int)
+    patch[0, :] = spec["border_color"]
+    patch[-1, :] = spec["border_color"]
+    patch[:, 0] = spec["border_color"]
+    patch[:, -1] = spec["border_color"]
+    hr0 = spec["hole_row"]
+    hc0 = spec["hole_col"]
+    hmask = spec["hole_mask"]
