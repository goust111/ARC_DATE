245:         import itertools
246: 
247:         best_perm = None
248:         best_score = None
249:         for perm in itertools.permutations(range(len(anchor_groups))):
250:             ok = True
251:             hits = 0
252:             dist_sum = 0
253:             for ci, gi in enumerate(perm):
254:                 if not compatible(ci, gi):
255:                     ok = False
256:                     break
257:                 hits += 1
258:                 dist_sum += bbox_gap(mov_comps[ci]["bbox"], anchor_groups[gi]["bbox"])
259:             if not ok:
