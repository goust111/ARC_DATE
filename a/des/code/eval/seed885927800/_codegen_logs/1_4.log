+
+def _sample_icon(kind: str) -> np.ndarray:
+    return random.choice(ICON_LIBRARY[kind]).copy()
+
+
+def _mark_neighbors(blocked: np.ndarray, mask: np.ndarray, top: int, left: int) -> None:
