+    for sprite in sprites:
+        sh, sw = sprite.shape
+        assert sw <= width
+        if x > 0 and x + sw > width:
+            y += row_height + 1
+            x = 0
+            row_height = 0
+        placements.append((sprite, y, x))
+        x += sw + 1
+        row_height = max(row_height, sh)
+        total_height = max(total_height, y + sh)
