+    assert shadow_spans, "expected at least one shadow segment"
+
+    scene = g[:divider_r, :]
+    components = _components(scene, bg)
+    assert components, "expected scene objects above the divider"
+
+    sources: dict[int, tuple[int, int]] = {}
+    obstacles: list[dict] = []
