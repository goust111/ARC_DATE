+def _border_background(g: np.ndarray) -> int:
+    border = np.concatenate((g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]))
+    vals, counts = np.unique(border, return_counts=True)
+    return int(vals[counts.argmax()])
