+        beam_top = int(src_r) + 1
+        beam_bottom = int(r0)
+        if beam_top >= beam_bottom:
+            continue
+        beam = out[beam_top:beam_bottom, int(c0) : int(c1) + 1]
+        beam[beam == bg] = color
+
+    return out
