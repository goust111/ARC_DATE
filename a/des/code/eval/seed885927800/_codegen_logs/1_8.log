+def _row_runs(row: np.ndarray, color: int) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    start = None
+    for c, value in enumerate(row.tolist()):
+        if int(value) == color:
+            if start is None:
+                start = c
+        elif start is not None:
+            runs.append((int(start), int(c - 1)))
+            start = None
+    if start is not None:
+        runs.append((int(start), int(len(row) - 1)))
+    return runs
+
+
+def _components(g: np.ndarray, bg: int) -> list[dict]:
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if seen[r, c] or color == bg:
+                continue
+
+            stack = [(int(r), int(c))]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = int(rr + dr)
+                    nc = int(cc + dc)
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            rows = [rr for rr, _cc in coords]
+            cols = [cc for _rr, cc in coords]
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "area": len(coords),
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                }
+            )
+
+    return comps
