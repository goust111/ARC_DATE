+
+def _build_straight_band(
+    rng: random.Random,
+    grid: np.ndarray,
+    h: int,
+    w: int,
+    split_r: int,
+    split_c: int,
+    quadrant: str,
+    colors: tuple[int, int],
+) -> None:
