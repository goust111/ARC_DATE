+        return 0, split_r - 1, 0, split_c - 1
+    if quadrant == "TR":
+        return 0, split_r - 1, split_c + 1, w - 1
+    if quadrant == "BL":
+        return split_r + 1, h - 1, 0, split_c - 1
+    if quadrant == "BR":
+        return split_r + 1, h - 1, split_c + 1, w - 1
+    raise AssertionError(quadrant)
