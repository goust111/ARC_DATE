+    start = tuple(map(int, coords[0]))
+    stack = [start]
+    seen = {start}
+    cells: list[tuple[int, int]] = []
+    h, w = mask.shape
+    while stack:
+        cur = stack.pop()
+        cells.append(cur)
+        for nr, nc in _neighbors4(cur):
+            if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and (nr, nc) not in seen:
