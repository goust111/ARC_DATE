+def _extract_stamps(grid: np.ndarray, top_limit: int, frame_color: int) -> list[dict]:
+    upper = np.asarray(grid[:top_limit, :], dtype=int)
+    colors = sorted(set(map(int, upper.flatten())) - {BG, int(frame_color)})
