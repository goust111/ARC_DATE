+    cell[key_r, 0] = color
+    sh, sw = shape.shape
+    sr = (cell.shape[0] - sh) // 2
+    sc = 2 + (cell.shape[1] - 2 - sw) // 2
+    view = cell[sr : sr + sh, sc : sc + sw]
+    view[shape] = color
