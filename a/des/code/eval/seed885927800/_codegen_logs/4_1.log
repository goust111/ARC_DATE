+
+    legend = np.full((2 + n * CELL_H + (n - 1), CELL_W + 2), bg, dtype=int)
+    _draw_box(legend, (0, 0, legend.shape[0] - 1, legend.shape[1] - 1), border)
+    cursor = 1
+    for idx, (color, shape) in enumerate(zip(colors, shapes)):
