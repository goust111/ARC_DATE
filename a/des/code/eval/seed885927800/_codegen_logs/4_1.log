+    min_dr = int(np.min(pts[:, 0] - cr))
+    max_dr = int(np.max(pts[:, 0] - cr))
+    min_dc = int(np.min(pts[:, 1] - cc))
+    max_dc = int(np.max(pts[:, 1] - cc))
