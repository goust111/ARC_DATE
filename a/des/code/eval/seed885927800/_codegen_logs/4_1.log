+    out: list[tuple[int, int]] = []
+    for r in range(inner_h):
+        for c in range(inner_w):
+            clipped = (
+                r + min_dr < 0
+                or r + max_dr >= inner_h
+                or c + min_dc < 0
+                or c + max_dc >= inner_w
+            )
+            if clipped == want_clip:
+                out.append((r, c))
+    return out
