+def _mask_center(mask: np.ndarray) -> tuple[int, int]:
+    pts = np.argwhere(mask)
+    return (
+        int((pts[:, 0].min() + pts[:, 0].max()) // 2),
+        int((pts[:, 1].min() + pts[:, 1].max()) // 2),
