+
+def _boxes_conflict(
+    box_a: tuple[int, int, int, int],
+    box_b: tuple[int, int, int, int],
+    gap: int,
+) -> bool:
+    ar0, ac0, ar1, ac1 = box_a
+    br0, bc0, br1, bc1 = box_b
+    return not (
+        ar1 + gap < br0
+        or br1 + gap < ar0
+        or ac1 + gap < bc0
+        or bc1 + gap < ac0
+    )
+
+
+def _place_box(
+    rng: random.Random,
+    taken: list[tuple[int, int, int, int]],
+    row_lo: int,
+    row_hi: int,
+    col_lo: int,
+    col_hi: int,
+    height: int,
+    width: int,
