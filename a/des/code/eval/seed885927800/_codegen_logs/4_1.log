+    if row_lo > row_hi or col_lo > col_hi:
+        return None
+    for _ in range(200):
+        r0 = rng.randint(row_lo, row_hi)
+        c0 = rng.randint(col_lo, col_hi)
+        box = (r0, c0, r0 + height - 1, c0 + width - 1)
+        if all(not _boxes_conflict(box, other, PLACEMENT_GAP) for other in taken):
+            return box
