+CELL_H = 7
+CELL_W = 7
+REGION_COUNT_RANGE = (2, 4)
+GRID_H_RANGE = (26, 40)
+GRID_W_RANGE = (26, 40)
+INNER_H_RANGE = (5, 10)
+INNER_W_RANGE = (5, 11)
+PLACEMENT_GAP = 2
+GEN_RETRIES = 400
