+def _stamp(
+    canvas: np.ndarray, shape: np.ndarray, anchor: tuple[int, int], color: int
+) -> None:
+    ar, ac = anchor
+    cr, cc = _mask_center(shape)
+    for rr, cc2 in np.argwhere(shape):
+        tr = ar + int(rr) - cr
+        tc = ac + int(cc2) - cc
+        if 0 <= tr < canvas.shape[0] and 0 <= tc < canvas.shape[1]:
+            canvas[tr, tc] = color
