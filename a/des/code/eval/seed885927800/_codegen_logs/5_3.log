+    colors = list(rng.sample(SEED_COLORS, total))
+    seeds: list[tuple[int, int, int]] = []
+    for pos, color in zip(chosen_green + chosen_yellow, colors):
+        r, c = pos
+        seeds.append((r, c, int(color)))
+        grid[r, c] = int(color)
