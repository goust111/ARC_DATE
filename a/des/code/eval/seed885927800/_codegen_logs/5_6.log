+            {
+                cell
+                for cell in _half_diamond_cells(
+                    int(tower["top_r"]),
+                    int(tower["col"]),
+                    int(tower["height"]),
+                    int(h),
+                    int(w),
+                )
+                if int(grid[cell]) == int(bg)
+            }
+        )
+    return coverages
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
