+            top_r = int(grid_h - 1 - height)
+            grid[top_r : grid_h - 1, int(col)] = int(body_colors[idx])
+            grid[top_r - 1, int(col)] = int(marker_colors[idx])
+
+        for row, idx in zip(priority_rows, priority_order):
+            grid[int(row), 0] = int(marker_colors[idx])
