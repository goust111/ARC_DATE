+def _apply_layer_flips(core: np.ndarray, n_layers: int) -> np.ndarray:
+    out = np.array(core, dtype=int, copy=True)
+    for layer in range(n_layers, 0, -1):
+        if layer % 2 == 1:
+            out = out[:, ::-1]
+        else:
+            out = out[::-1, :]
+    return out
+
