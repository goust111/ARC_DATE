+    coords = np.argwhere(mask)
+    pr0, pc0 = map(int, coords.min(axis=0))
+    pr1, pc1 = map(int, coords.max(axis=0))
+    return interior[pr0 : pr1 + 1, pc0 : pc1 + 1].copy()
