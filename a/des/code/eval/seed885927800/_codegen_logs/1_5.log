+def _extract_core(grid: np.ndarray, inner_frame: tuple[int, int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1, _ = inner_frame
+    interior = grid[r0 + 1 : r1, c0 + 1 : c1]
