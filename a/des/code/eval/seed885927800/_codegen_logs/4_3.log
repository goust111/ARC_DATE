+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    n_frames = int(rng.integers(2, 5))
+    frame_colors = [int(c) for c in rng.choice(FRAME_COLORS, size=n_frames, replace=False)]
