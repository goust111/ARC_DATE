+        for _ in range(PLACE_RETRIES):
+            top = int(rng.integers(1, height - spec["full_h"] - 1))
+            left = int(rng.integers(1, width - spec["full_w"] - 1))
+            if blocked[top - 1 : top + spec["full_h"] + 1, left - 1 : left + spec["full_w"] + 1].any():
+                continue
