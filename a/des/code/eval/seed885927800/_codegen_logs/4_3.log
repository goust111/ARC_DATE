+        frame_offset = (0, 0)
+        stamp_offset = (height, (width - size) // 2)
+    elif side == "left":
+        full_h, full_w = height, width + size
+        frame_offset = (0, size)
+        stamp_offset = ((height - size) // 2, 0)
+    else:
+        full_h, full_w = height, width + size
+        frame_offset = (0, 0)
+        stamp_offset = ((height - size) // 2, width)
