+        r0, c0, r1, c1 = spec["frame_bbox"]
+        if not _is_rect_frame(list(_frame_border_cells((r0, c0, r1, c1))), grid.shape):
+            return False
+        if not np.all(grid[r0 + 1 : r1, c0 + 1 : c1] == BG):
+            return False
+    return True
