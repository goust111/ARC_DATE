+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in cells:
+                neigh.append((nr - r, nc - c))
+        if len(neigh) != 2:
+            continue
+        if neigh[0][0] + neigh[1][0] != 0 or neigh[0][1] + neigh[1][1] != 0:
+            turns += 1
