+
+def _components_from_cells(cells):
+    remaining = set(cells)
+    comps = []
+    while remaining:
+        start = next(iter(remaining))
+        q = deque([start])
+        comp = set([start])
+        remaining.remove(start)
+        while q:
+            r, c = q.popleft()
+            for nr, nc in _neighbors4(r, c):
+                if (nr, nc) in remaining:
