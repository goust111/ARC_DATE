+    if len(cols) == 1:
+        c = cols[0]
+        seq = sorted(r for r, _ in pts)
+        if seq != list(range(seq[0], seq[-1] + 1)):
+            return None
+        return {
+            "orientation": "v",
+            "endpoints": [((seq[0], c), (seq[0] - 1, c)), ((seq[-1], c), (seq[-1] + 1, c))],
+            "length": len(seq),
