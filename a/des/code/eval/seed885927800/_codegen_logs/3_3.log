+            valid_fragments.append(comp)
+            for endpoint, gap in sig["endpoints"]:
+                gr, gc = gap
+                if 0 <= gr < h and 0 <= gc < w and int(g[gr, gc]) == int(bg):
+                    gap_map[(int(gr), int(gc))].append((int(frag_id), endpoint))
