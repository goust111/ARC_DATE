+    rows = sorted({r for r, _ in pts})
+    cols = sorted({c for _, c in pts})
+    if len(rows) == 1:
+        r = rows[0]
+        seq = sorted(c for _, c in pts)
+        if seq != list(range(seq[0], seq[-1] + 1)):
+            return None
+        return {
+            "orientation": "h",
+            "endpoints": [((r, seq[0]), (r, seq[0] - 1)), ((r, seq[-1]), (r, seq[-1] + 1))],
+            "length": len(seq),
