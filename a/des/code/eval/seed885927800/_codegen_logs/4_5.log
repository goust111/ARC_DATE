+
+def _is_connected(coords: set[tuple[int, int]]) -> bool:
+    if not coords:
+        return False
+    start = next(iter(coords))
+    stack = [start]
+    seen = {start}
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in coords and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
