GEN_GAP_SIX_POSITIONS = [1, 5, 9, 17, 21, 25]
GEN_SEVEN_FROM_MARKER = [2, 6, 10, 14, 18, 22, 26]
GEN_SEVEN_FROM_OTHER = [1, 5, 9, 13, 17, 21, 25]
GEN_SYMBOL_PATCH_SIZE = 3

# Generation retries.
GEN_MAX_ATTEMPTS = 300

