+    w = random.randint(*SHAPE_WIDTH_RANGE)
+    root = (random.randint(1, h - 2), random.randint(1, w - 2))
+
+    coords = {
+        root,
+        (root[0] - 1, root[1]),
+        (root[0] + 1, root[1]),
+        (root[0], root[1] - 1),
+        (root[0], root[1] + 1),
+    }
+    target = random.randint(SHAPE_CELL_RANGE[0], min(SHAPE_CELL_RANGE[1], h * w))
