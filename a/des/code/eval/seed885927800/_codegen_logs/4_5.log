+SHAPE_WIDTH_RANGE = (4, 7)
+SHAPE_CELL_RANGE = (8, 15)
+SHAPE_ATTEMPTS = 120
+GENERATION_ATTEMPTS = 400
+
+BODY_COLOR_POOL = tuple(range(10))
+MANDATORY_SEEDS = (RED, BLUE, GREEN, YELLOW)
