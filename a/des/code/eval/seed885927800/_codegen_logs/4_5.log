+def _far_enough(
+    coords: set[tuple[int, int]], used: set[tuple[int, int]], gap: int
+) -> bool:
+    for r, c in coords:
+        for rr in range(r - gap, r + gap + 1):
+            for cc in range(c - gap, c + gap + 1):
+                if (rr, cc) in used:
