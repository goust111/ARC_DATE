+    return rng.randint(r0 + 1, r1 - 1), c0
+
+
+def _paint_rectangle(
+    grid: np.ndarray,
+    color: int,
+    r0: int,
+    c0: int,
+    r1: int,
+    c1: int,
+    gap: tuple[int, int],
+    seed: tuple[int, int],
