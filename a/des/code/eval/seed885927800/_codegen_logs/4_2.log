    assert h >= 3 and w >= 3, "grid is too small for edge-to-edge paths"

    edge = _edge_mask(g.shape)
    colors = [int(color) for color in np.unique(g)]

    horizontals: list[dict[str, int]] = []
    verticals: list[dict[str, int]] = []
    leftovers: list[int] = []

