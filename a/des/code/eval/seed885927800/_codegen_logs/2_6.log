+            return None
+
+    expected = _expected_output(grid, switches)
+    if not np.array_equal(main(grid), expected):
+        return None
+    if np.array_equal(grid, expected):
+        return None
+    if len(_resolve_switches(grid)) != switched_count:
+        return None
+    return grid
