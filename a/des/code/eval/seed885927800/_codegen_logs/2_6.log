+            colors = [int(x) for x in colors]
+            counts = [int(x) for x in counts]
+            if len(colors) != 2 or sorted(counts) != [2, 2]:
+                continue
+            if BLACK in colors:
+                continue
+            switches.append({"r": r, "c": c, "colors": tuple(colors)})
+    return switches
+
+
