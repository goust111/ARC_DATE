+    net_w: int,
+    legend_w: int,
+) -> tuple[tuple[int, int], tuple[int, int]] | None:
+    row_pad = 4
+    col_pad = legend_w + 4
+    if corner == "tl":
+        row_lo, row_hi = row_pad, height - net_h - 2
+        col_lo, col_hi = col_pad, width - net_w - 2
+    elif corner == "tr":
+        row_lo, row_hi = row_pad, height - net_h - 2
+        col_lo, col_hi = 2, width - net_w - col_pad
+    elif corner == "bl":
+        row_lo, row_hi = 2, height - net_h - row_pad
+        col_lo, col_hi = col_pad, width - net_w - 2
+    else:
+        row_lo, row_hi = 2, height - net_h - row_pad
+        col_lo, col_hi = 2, width - net_w - col_pad
