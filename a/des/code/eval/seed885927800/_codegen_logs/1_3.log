+    return sources
+
+
+def _solve(
+    grid: np.ndarray,
+    *,
+    reject_ties: bool = False,
+    return_meta: bool = False,
+) -> np.ndarray | tuple[np.ndarray, dict[str, int]]:
+    g = np.asarray(grid, dtype=int)
