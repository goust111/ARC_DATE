+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+CORNERS = ("tl", "tr", "bl", "br")
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+GEN_RETRIES = 400
