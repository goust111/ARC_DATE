+        return None
+
+    if meta["tie_cells"] != 0:
+        return None
+    if meta["turned_claims"] == 0:
+        return None
+    if np.any(out == GREY):
+        return None
+    network_colors = set(map(int, np.unique(out[grid == GREY])))
+    if len(network_colors) < min(2, len(mapping)):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
