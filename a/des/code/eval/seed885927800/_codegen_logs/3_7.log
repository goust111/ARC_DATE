    diffs={op:int(np.count_nonzero(mask"'!=apply(mask,op))) for op in OPS}
    best=min(OPS,key=lambda op:(diffs[op], OPS.index(op)))
    return (best if diffs[best] <= 2 else '"'I'), diffs

def conn(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:return False
    H,W=mask.shape
    start=tuple(map(int,pts[0]))
    seen={start}; stack=[start]
    while stack:
        r,c=stack.pop()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); stack.append((nr,nc))
    return len(seen)==len(pts)

def full(mask):
    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

def grow(h,w,area):
    mask=np.zeros((h,w),bool)
    r=int(RNG.integers(h)); c=int(RNG.integers(w)); mask[r,c]=True
    while mask.sum()<area:
        frontier=[]
        for rr,cc in np.argwhere(mask):
