+    col_edges = [0]
+    for width in widths:
+        col_edges.append(col_edges[-1] + 1 + width)
+
+    for rr in row_edges:
+        grid[rr, :] = WALL
+    for cc in col_edges:
+        grid[:, cc] = WALL
