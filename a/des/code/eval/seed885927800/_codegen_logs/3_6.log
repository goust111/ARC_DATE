+        return [dominant, total - dominant]
+
+    for _ in range(50):
+        dominant = random.randint(max(2, total // 3 + 1), total - 2)
+        rem = total - dominant
+        a = random.randint(1, rem - 1)
+        b = rem - a
+        if dominant > max(a, b):
+            others = [a, b]
+            random.shuffle(others)
+            return [dominant] + others
+    return None
+
