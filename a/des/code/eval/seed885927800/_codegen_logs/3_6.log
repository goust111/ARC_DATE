+    n_rooms = n_room_rows * n_room_cols
+    directions = _balanced_prefix(tuple(DIRS), n_rooms)
+    truncates = _balanced_prefix((False, True), n_rooms)
+
+    idx = 0
+    for i in range(n_room_rows):
+        for j in range(n_room_cols):
+            top = row_edges[i] + 1
+            left = col_edges[j] + 1
+            room_h = heights[i]
