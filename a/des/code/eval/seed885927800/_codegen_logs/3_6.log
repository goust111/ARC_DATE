+        out[r0 : r1 + 1, c0 : c1 + 1] = packed
+
+    return out
+
+
+def _balanced_prefix(values: tuple[object, ...], n: int) -> list[object]:
+    bag: list[object] = []
+    while len(bag) < n:
+        chunk = list(values)
+        random.shuffle(chunk)
+        bag.extend(chunk)
+    return bag[:n]
+
+
+def _arrow_cells(head: tuple[int, int], direction: str) -> set[tuple[int, int]]:
+    hr, hc = head
