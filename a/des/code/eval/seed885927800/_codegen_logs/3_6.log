+    if max_pixels < 2:
+        return False
+
+    if truncate and max_pixels > capacity:
+        lo = capacity + 1
+        hi = min(max_pixels, capacity + 4)
+    else:
+        lo = 2
+        hi = min(max_pixels, capacity)
