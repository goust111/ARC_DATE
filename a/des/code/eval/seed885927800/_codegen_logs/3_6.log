+        dominant = random.randint(lo, total - 1)
+        return [dominant, total - dominant]
+
+    lo = max(2, total // 3 + 1)
+    hi = total - 2
+    if lo > hi:
+        return None
+    for _ in range(50):
+        dominant = random.randint(lo, hi)
+        rem = total - dominant
+        a = random.randint(1, rem - 1)
+        b = rem - a
+        if dominant > max(a, b):
+            others = [a, b]
+            random.shuffle(others)
+            return [dominant] + others
