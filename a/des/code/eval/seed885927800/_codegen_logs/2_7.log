+    out = main(grid)
+    return not np.array_equal(out, grid)
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    obj_count = rng.choice((2, 3, 4))
+    hole_counts = rng.sample((0, 1, 2, 3, 4), obj_count)
+    colors = rng.sample(OBJECT_COLORS, obj_count)
