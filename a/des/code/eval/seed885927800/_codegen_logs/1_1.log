+        tile = legend_map[seed_dirs[0]]
+        _tile_into(out, r0 + 1, c0 + 1, r1 - r0 - 1, c1 - c0 - 1, tile)
+
+    return out
+
+
+def _arrow_patch(color: int) -> np.ndarray:
+    patch = np.zeros((3, 3), dtype=int)
+    for name, coords in ARROW_PATTERNS.items():
+        if color == -1:
+            return patch
+    for r, c in ARROW_PATTERNS["up"]:
