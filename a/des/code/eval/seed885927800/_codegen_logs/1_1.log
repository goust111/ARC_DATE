+    row_gap = _interval_gap(ar0, ar1, br0, br1)
+    col_gap = _interval_gap(ac0, ac1, bc0, bc1)
+    row_overlap = row_gap == 0
+    col_overlap = col_gap == 0
+    if row_overlap and col_gap <= 2:
