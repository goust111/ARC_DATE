+        elif kind == "hstripe":
+            for r in range(h):
+                arr[r, :] = colors[r % len(colors)]
+        elif kind == "vstripe":
+            for c in range(w):
+                arr[:, c] = colors[c % len(colors)]
+        elif kind == "blocks":
+            for r in range(h):
+                for c in range(w):
+                    idx = (r >= h // 2) + 2 * (c >= w // 2)
+                    arr[r, c] = colors[idx % len(colors)]
+        else:
+            for r in range(h):
