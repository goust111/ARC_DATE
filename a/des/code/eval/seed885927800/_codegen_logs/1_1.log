+def _is_rect_frame(coords: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return False
+    want = set()
+    for r in range(r0, r1 + 1):
+        want.add((r, c0))
+        want.add((r, c1))
