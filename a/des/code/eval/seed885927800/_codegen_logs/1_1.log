+    "down": frozenset({(0, 1), (1, 1), (2, 0), (2, 1), (2, 2)}),
+    "left": frozenset({(0, 0), (1, 0), (1, 1), (1, 2), (2, 0)}),
+    "right": frozenset({(0, 2), (1, 0), (1, 1), (1, 2), (2, 2)}),
+}
+DIR_ORDER = ("up", "down", "left", "right")
+SIDE_ORDER = ("top", "bottom", "left", "right")
+
+GRID_MIN = 24
+GRID_MAX = 30
+FRAME_COUNT_MIN = 2
