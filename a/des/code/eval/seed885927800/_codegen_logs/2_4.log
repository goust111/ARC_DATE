+        col_hits = sum(int(np.count_nonzero(g[:, c] == color) >= max(2, (h + 1) // 2)) for c in range(w))
+        score = (row_hits > 0 and col_hits > 0, row_hits + col_hits, int(np.count_nonzero(g == color)))
+        if best_score is None or score > best_score:
