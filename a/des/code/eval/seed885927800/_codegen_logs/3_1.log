+
+
+def _build_pair_specs(n_pairs: int, colors: list[int]) -> tuple[list[dict], dict[tuple[str, int], set[tuple[int, ...]]]] | None:
+    pairs: list[dict] = []
+    used: dict[tuple[str, int], set[tuple[int, ...]]] = {}
+
