+            break
+        if not made:
+            return None
+
+    return pairs, used
+
+
+def _build_unmatched_specs(
+    n_unmatched: int,
+    colors: list[int],
+    offset: int,
+    used: dict[tuple[str, int], set[tuple[int, ...]]],
