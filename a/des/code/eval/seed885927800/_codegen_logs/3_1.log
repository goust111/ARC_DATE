+
+        for r, c in key["coords"]:
+            out[r, c] = BLACK
+
+        r0, c0, r1, c1 = lock["bbox"]
+        sub = out[r0 : r1 + 1, c0 : c1 + 1]
+        sub[sub == BLACK] = int(key["color"])
