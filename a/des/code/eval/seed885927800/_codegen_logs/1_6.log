+            specs[idx][f"{kind}_pos"] = (top, left)
+            placed_here = True
+            break
+        if not placed_here:
+            return None
+
+    if not _bg_is_dominant(grid, bg):
+        return None
+
+    expected = _build_expected(grid, specs, bg)
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid, expected
