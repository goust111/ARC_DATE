+def _generate_case(rng: np.random.Generator):
+    bg = int(rng.integers(10))
+    pair_count = int(rng.choice(PAIR_COUNT_CHOICES, p=PAIR_COUNT_WEIGHTS))
+    colors = [c for c in range(10) if c != bg]
+    rng.shuffle(colors)
