+
+        lr, lc = spec["lock_pos"]
+        lh, lw = spec["lock_patch"].shape
+        out[lr : lr + lh, lc : lc + lw] = int(spec["key_color"])
+    return out
+
+
+def _generate_case(rng: np.random.Generator):
