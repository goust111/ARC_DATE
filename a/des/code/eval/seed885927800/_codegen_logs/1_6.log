+        if color == bg:
+            continue
+        for coords in _components(g == color):
+            comps.append({"color": color, "coords": coords})
+
+    locks = []
+    keys = []
+    for comp in comps:
+        lock = _lock_from_component(g, comp["color"], comp["coords"], bg)
+        if lock is not None:
+            locks.append(lock)
+        else:
+            keys.append(
+                {
+                    "color": int(comp["color"]),
+                    "coords": comp["coords"],
+                    "shape": _normalize(comp["coords"]),
+                }
