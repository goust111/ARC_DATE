+
+def _rectangle_mask(h: int, w: int) -> np.ndarray:
+    return np.ones((h, w), dtype=bool)
+
+
+def _octagon_mask(h: int, w: int, cut: int) -> np.ndarray:
+    rows, cols = np.indices((h, w))
+    keep = (
+        (rows + cols >= cut)
+        & (rows + (w - 1 - cols) >= cut)
+        & ((h - 1 - rows) + cols >= cut)
+        & ((h - 1 - rows) + (w - 1 - cols) >= cut)
+    )
+    return keep.astype(bool)
+
