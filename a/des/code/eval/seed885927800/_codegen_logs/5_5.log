+            rr1 = min(draw_h, r0 + ph + PLACEMENT_PADDING)
+            cc0 = max(0, c0 - PLACEMENT_PADDING)
+            cc1 = min(draw_w, c0 + pw + PLACEMENT_PADDING)
+            if not occupied[rr0:rr1, cc0:cc1].any():
