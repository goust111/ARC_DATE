+    grid_out: np.ndarray,
+    occupied: np.ndarray,
+    patch_in: np.ndarray,
+    patch_out: np.ndarray,
+    draw_h: int,
+    draw_w: int,
+) -> bool:
+    ph, pw = patch_in.shape
+    options: list[tuple[int, int]] = []
+    for r0 in range(draw_h - ph + 1):
