+    height, width = map(int, out.shape)
+    for gear in gears:
+        for r, c in _clockwise_slots(int(gear.r0), int(gear.c0), int(gear.size)):
+            if _in_bounds(int(r), int(c), int(height), int(width)):
+                out[int(r), int(c)] = BG
