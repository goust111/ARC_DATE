+from collections import deque
+from dataclasses import dataclass
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+SIZES = (5, 7)
+PALETTE = (1, 3, 4, 5, 6, 7, 8, 9)
+GEN_ATTEMPTS = 400
+MAX_GRID_SIZE = 30
+_RNG = np.random.default_rng()
