+            c0 = int(_RNG.integers(int(min_c - span_c - 8), int(max_c + span_c + 9)))
+            spec = {
+                "size": int(sizes[idx]),
+                "color": int(colors[idx]),
+                "r0": int(r0),
+                "c0": int(c0),
+                "required": set(),
+                "used_sides": set(),
