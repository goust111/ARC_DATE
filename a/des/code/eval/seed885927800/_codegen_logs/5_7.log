+        min_r = min(int(box[0]) for box in boxes)
+        max_r = max(int(box[2]) for box in boxes)
+        min_c = min(int(box[1]) for box in boxes)
+        max_c = max(int(box[3]) for box in boxes)
+        span_r = int(max_r - min_r + 1)
+        span_c = int(max_c - min_c + 1)
+        for _ in range(240):
