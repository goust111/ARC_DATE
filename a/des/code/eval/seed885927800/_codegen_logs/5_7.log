+def _turn_directions(graph: list[set[int]], driver: int) -> dict[int, int]:
+    turns = {int(driver): 1}
+    queue: deque[int] = deque([int(driver)])
+    while queue:
+        cur = int(queue.popleft())
+        for nxt in graph[cur]:
+            expected = -int(turns[cur])
+            if int(nxt) in turns:
+                if int(turns[int(nxt)]) != int(expected):
