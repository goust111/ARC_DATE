+        raise ValueError("expected 2D grid")
+    height, width = map(int, g.shape)
+    colors = [int(c) for c in np.unique(g) if int(c) not in (BG, RED)]
+    gears: list[Gear] = []
+
+    for color in colors:
+        color_cells = {(int(r), int(c)) for r, c in np.argwhere(g == int(color))}
+        matches: list[Gear] = []
+        for size in SIZES:
