+                b_cols = {int(c) for r, c in teeth_b if int(r) == int(gear_b.r0 + gear_b.size)}
+                linked = bool(a_cols & b_cols)
+
+            if linked:
+                graph[i].add(int(j))
+                graph[j].add(int(i))
