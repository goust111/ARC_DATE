+    if count == 0:
+        return teeth
+    shift %= int(count)
+    if shift == 0:
+        return teeth
+    result = [False] * int(count)
+    for idx, present in enumerate(teeth):
+        if bool(present):
+            result[(int(idx) + int(shift)) % int(count)] = True
+    return tuple(result)
