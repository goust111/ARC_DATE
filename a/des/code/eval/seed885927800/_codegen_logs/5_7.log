+            c0 = int(parent["c0"] + parent["size"] + 3) if side == "R" else int(parent["c0"] - size - 3)
+            child = {
+                "size": int(size),
+                "color": int(color),
+                "r0": int(r0),
+                "c0": int(c0),
+                "required": set(),
+                "used_sides": {str(_OPPOSITE[side])},
