+                    teeth.add((int(coord[0]), int(coord[1])))
+        if not teeth:
+            slots = _clockwise_slots(int(spec["r0"]), int(spec["c0"]), int(spec["size"]))
+            coord = slots[int(_RNG.integers(0, int(len(slots))))]
+            teeth.add((int(coord[0]), int(coord[1])))
