+
+    layout = _build_layout(int(connected_count), int(isolated_count))
+    if layout is None:
+        return None
+    specs, driver = layout
+    red_cells, step_count = _driver_red_cells(specs[int(driver)])
+    grid = _render_grid(specs, int(driver), red_cells)
