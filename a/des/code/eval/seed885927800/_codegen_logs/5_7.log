+def _gen_attempt() -> np.ndarray | None:
+    connected_count = int(_RNG.integers(1, 6))
+    isolated_count = int(_RNG.integers(0, 3))
+    total = int(connected_count + isolated_count)
+    if total > len(PALETTE):
