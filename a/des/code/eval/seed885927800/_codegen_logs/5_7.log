+        for (r, c), present in zip(_clockwise_slots(int(gear.r0), int(gear.c0), int(gear.size)), rotated):
+            if bool(present) and _in_bounds(int(r), int(c), int(height), int(width)):
+                out[int(r), int(c)] = int(gear.color)
