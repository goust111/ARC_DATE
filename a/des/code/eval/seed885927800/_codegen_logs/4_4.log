+def _paint_l(out: np.ndarray, start: tuple[int, int], end: tuple[int, int], color: int) -> None:
+    r1, c1 = start
+    r2, c2 = end
+    c_lo, c_hi = sorted((c1, c2))
+    out[r1, c_lo : c_hi + 1] = color
+    r_lo, r_hi = sorted((r1, r2))
+    out[r_lo : r_hi + 1, c2] = color
