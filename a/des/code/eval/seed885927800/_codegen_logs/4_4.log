+
+_GEN_ATTEMPTS = 400
+_ROOM_SIZE_OPTIONS = (3, 5, 7)
+_COLOR_IDS = tuple(range(10))
+
+
+def _snake_order(n_room_rows: int, n_room_cols: int, by_rows: bool) -> list[tuple[int, int]]:
+    order: list[tuple[int, int]] = []
