+        for ri in range(n_room_rows):
+            cols = range(n_room_cols) if ri % 2 == 0 else range(n_room_cols - 1, -1, -1)
+            for ci in cols:
+                order.append((ri, ci))
+    else:
+        for ci in range(n_room_cols):
+            rows = range(n_room_rows) if ci % 2 == 0 else range(n_room_rows - 1, -1, -1)
+            for ri in rows:
