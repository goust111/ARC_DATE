+            entry_anchor = _door_anchor(parsed["doors"][path[idx - 1]], room_id)
+            exit_anchor = _door_anchor(parsed["doors"][path[idx]], room_id)
+            _paint_l(out, entry_anchor, exit_anchor, color)
