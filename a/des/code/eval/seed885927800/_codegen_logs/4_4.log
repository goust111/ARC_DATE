+    side = door["sides"][room_id]
+    if side == "top":
+        return (r + 1, c)
+    if side == "bottom":
+        return (r - 1, c)
+    if side == "left":
+        return (r, c + 1)
+    return (r, c - 1)
+
+
+def _room_center(room: dict) -> tuple[int, int]:
+    return ((room["top"] + room["bottom"]) // 2, (room["left"] + room["right"]) // 2)
