+    doors: list[dict] = []
+    room_to_doors: dict[int, list[int]] = defaultdict(list)
+    marker_colors: set[int] = set()
+
+    for ri in range(len(row_lines) - 2):
+        wall_row = row_lines[ri + 1]
+        for ci in range(len(col_lines) - 1):
+            left = col_lines[ci]
+            right = col_lines[ci + 1]
