+
+
+def _overlap_len(start_a: int, size_a: int, start_b: int, size_b: int) -> int:
+    end_a = start_a + size_a - 1
+    end_b = start_b + size_b - 1
+    return max(0, min(end_a, end_b) - max(start_a, start_b) + 1)
