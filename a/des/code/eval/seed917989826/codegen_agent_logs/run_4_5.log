+def _interior_cells(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    cells: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            ok = True
+            for dr, dc in DIRS4:
+                nr, nc = r + dr, c + dc
+                if not (0 <= nr < h and 0 <= nc < w and mask[nr, nc]):
+                    ok = False
+                    break
+            if ok:
+                cells.append((r, c))
+    return cells
+
