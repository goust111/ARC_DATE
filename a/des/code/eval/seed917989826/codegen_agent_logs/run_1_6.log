+def _marker_cells(
+    corner: tuple[int, int],
+    h_endpoint: tuple[int, int],
+    v_endpoint: tuple[int, int],
+) -> list[tuple[int, int]]:
+    r, c = corner
+    rows = [r - 1, r] if v_endpoint[0] < r else [r, r + 1]
+    cols = [c - 1, c] if h_endpoint[1] < c else [c, c + 1]
+    return [(rr, cc) for rr in rows for cc in cols]
