+        if h_dir == "right":
+            h_r0 = corner_r - h_attach
+            h_c0 = corner_c - h_gap - h_wire - (h_w - 1)
+        else:
+            h_r0 = corner_r - h_attach
+            h_c0 = corner_c + h_gap + h_wire
+
+        if v_dir == "down":
+            v_r0 = corner_r - v_gap - v_wire - (v_h - 1)
+            v_c0 = corner_c - v_attach
