+        if equal_area and frag_h.outer_r0 == frag_v.outer_r0:
+            continue
+
+        input_cells = frag_h.input_cells() | frag_v.input_cells()
+        if len(input_cells) != len(frag_h.input_cells()) + len(frag_v.input_cells()):
