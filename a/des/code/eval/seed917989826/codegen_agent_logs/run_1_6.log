+            wire_dir, wire_len, attach = parsed
+            key = (chip, outer_r0, outer_c0, outer_r1, outer_c1)
+            if key in seen_keys:
+                continue
+            seen_keys.add(key)
+            fragments.append(
+                Fragment(
+                    shell=shell,
+                    chip=chip,
+                    outer_r0=outer_r0,
+                    outer_c0=outer_c0,
+                    outer_h=outer_r1 - outer_r0 + 1,
+                    outer_w=outer_c1 - outer_c0 + 1,
+                    wire_dir=wire_dir,
+                    wire_len=wire_len,
