+        frag_h = Fragment(shell, chips[0], h_r0, h_c0, h_h, h_w, h_dir, h_wire, h_attach)
+        frag_v = Fragment(shell, chips[1], v_r0, v_c0, v_h, v_w, v_dir, v_wire, v_attach)
