+def _place_cross_pair(rng: np.random.Generator, row_lo: int, row_hi: int, col_lo: int, col_hi: int):
+    max_dr = row_hi - row_lo
+    max_dc = col_hi - col_lo
+    if max_dr < 2 or max_dc < 2:
