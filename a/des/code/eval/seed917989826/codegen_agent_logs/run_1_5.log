+
+
+def _neighbors4(cell: tuple[int, int], room_h: int, room_w: int) -> list[tuple[int, int]]:
+    r, c = cell
+    out = []
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
