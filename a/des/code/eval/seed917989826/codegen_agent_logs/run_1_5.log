0021: def main(grid: np.ndarray) -> np.ndarray:
0022:     """Expand each sparse color object into a filled rectangular region using its legend-paired fill color.
0023: 
0024:     Input structure
0025:     A background-color grid has a two-column legend in columns 0 and 1, starting at row 0: each row gives
0026:     a source color in the left column and that source color's fill color in the right column.  Outside the
0027:     legend, the foreground pixels are sparse dot objects whose colors are exactly the legend source colors.
0028: 
0029:     Rule
0030:     Clear the legend.  For each source color, take the bbox of all of its non-legend dots, expand that bbox
0031:     by one pixel in every direction, and fill background cells inside the expanded rectangle with the paired
0032:     legend fill color while preserving every original non-legend dot.
0033: 
0034:     Key insight
0035:     The legend order is also the layer order: earlier legend rows are in front, so fill rectangles are painted
0036:     from the last legend row back to the first and higher-priority fills overwrite lower-priority fills.
0037:     """
0038:     g = np.asarray(grid, dtype=int)
0039:     bg = get_bg(g)
0040:     H, W = g.shape
0041:     assert W >= 2, "expected room for a two-column legend"
0042: 
0043:     pairs = _legend_pairs(g, bg)
0044:     source_colors = {source for source, _fill in pairs}
0045:     assert len(source_colors) == len(pairs), "legend source colors must be unique"
0046: 
0047:     legend_mask = np.zeros(g.shape, dtype=bool)
0048:     legend_mask[: len(pairs), :2] = True
0049:     dot_mask = (g != bg) & ~legend_mask
0050:     assert dot_mask.any(), "expected source dots outside the legend"
0051:     assert set(map(int, g[dot_mask])).issubset(source_colors), "outside dots must use legend source colors"
0052: 
0053:     dots_by_color: dict[int, np.ndarray] = {}
0054:     all_dots = np.zeros(g.shape, dtype=bool)
0055:     for source, _fill in pairs:
0056:         coords = np.argwhere(dot_mask & (g == source))
0057:         assert coords.size, "each legend source color must appear outside the legend"
0058:         dots_by_color[source] = coords
0059:         all_dots[coords[:, 0], coords[:, 1]] = True
0060: 
0061:     out = np.full_like(g, bg)
0062:     for source, fill in reversed(pairs):
0063:         r0, c0, r1, c1 = bbox_coords(dots_by_color[source])
0064:         r0 = max(0, r0 - 1)
0065:         c0 = max(0, c0 - 1)
0066:         r1 = min(H - 1, r1 + 1)
0067:         c1 = min(W - 1, c1 + 1)
0068: 
0069:         region = out[r0 : r1 + 1, c0 : c1 + 1]
0070:         background_inside_region = ~all_dots[r0 : r1 + 1, c0 : c1 + 1]
0071:         region[background_inside_region] = fill
0072: 
