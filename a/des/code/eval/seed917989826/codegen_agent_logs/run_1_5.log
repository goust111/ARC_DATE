   300	        for r in range(room_h)
   301	        for c in range(room_w)
   302	        if not arrow_mask[r, c]
   303	    }
   304	    cells = _choose_connected_cells(available, room_h, room_w, rng, min_size=min_size, max_size=max_size)
   305	    pattern = np.full((room_h, room_w), BG, dtype=int)
   306	    _paint_cells(pattern, cells, color)
   307	    return pattern
   308	
   309	
   310	def _valid_directions(room_r: int, room_c: int, room_rows: int, room_cols: int) -> list[str]:
   311	    valid = []
   312	    for direction, (dr, dc) in ROOM_DELTAS.items():
   313	        nr = room_r + dr
   314	        nc = room_c + dc
   315	        if 0 <= nr < room_rows and 0 <= nc < room_cols:
   316	            valid.append(direction)
   317	    return valid
   318	
   319	
   320	def _paint_room(
   321	    grid: np.ndarray,
   322	    room_r: int,
   323	    room_c: int,
   324	    room_h: int,
   325	    room_w: int,
   326	    pattern: np.ndarray,
   327	    arrow_mask: np.ndarray,
   328	) -> None:
   329	    r0, c0 = _room_origin(room_r, room_c, room_h, room_w)
   330	    interior = grid[r0 : r0 + room_h, c0 : c0 + room_w]
   331	    write_mask = pattern != BG
   332	    interior[write_mask] = pattern[write_mask]
   333	    interior[arrow_mask] = ARROW_COLOR
   334	
   335	
   336	def _validate_generated(grid: np.ndarray) -> None:
   337	    parsed = _extract_rooms(grid)
   338	    directions = {room.direction for room in parsed["rooms"].values() if room.direction is not None}
   339	    if directions != set(ROOM_DELTAS):
   340	        raise AssertionError("generator must expose all four arrow directions")
   341	    if not any(room.direction is None for room in parsed["rooms"].values()):
   342	        raise AssertionError("generator must keep at least one stationary room")
   343	
   344	    incoming = _incoming_projections(parsed)
   345	    if not any(len(items) >= 2 for items in incoming.values()):
   346	        raise AssertionError("generator must create at least one multi-source target")
   347	
   348	    contested = False
   349	    overwrite_stationary = False
   350	    for target_idx, items in incoming.items():
   351	        target = parsed["rooms"][target_idx]
   352	        occupancy = np.zeros((target.height, target.width), dtype=int)
   353	        for _direction, pattern in items:
   354	            occupancy += (pattern != BG).astype(int)
   355	        contested |= bool(np.any(occupancy >= 2))
   356	        overwrite_stationary |= bool(
   357	            target.direction is None
   358	            and np.any((target.pattern != BG) & (occupancy >= 1))
   359	        )
   360	    if not contested:
   361	        raise AssertionError("generator must produce at least one true overlap conflict")
   362	    if not overwrite_stationary:
   363	        raise AssertionError("generator must let some projection overwrite a stationary pattern")
   364	
   365	    out = main(grid)
   366	    if np.array_equal(out, grid):
   367	        raise AssertionError("generated task must change under main()")
   368	
   369	
   370	def _gen_attempt(rng: random.Random) -> np.ndarray:
   371	    room_rows = rng.randint(3, 5)
   372	    room_cols = rng.randint(3, 5)
   373	    room_h = rng.randint(5, 7)
   374	    room_w = rng.randint(5, 7)
   375	    wall_color = 9
   376	    grid = _build_empty_grid(room_rows, room_cols, room_h, room_w, wall_color)
   377	
   378	    room_dirs: dict[tuple[int, int], str | None] = {}
   379	    arrow_masks: dict[tuple[int, int], np.ndarray] = {}
   380	    patterns: dict[tuple[int, int], np.ndarray] = {}
   381	
   382	    target = (rng.randrange(1, room_rows - 1), rng.randrange(1, room_cols - 1))
   383	    required_sources = {
   384	        (target[0] - 1, target[1]): "down",
   385	        (target[0] + 1, target[1]): "up",
   386	        (target[0], target[1] - 1): "right",
   387	        (target[0], target[1] + 1): "left",
   388	    }
   389	
   390	    for room_r in range(room_rows):
   391	        for room_c in range(room_cols):
   392	            room_dirs[(room_r, room_c)] = None
   393	            arrow_masks[(room_r, room_c)] = np.zeros((room_h, room_w), dtype=bool)
   394	            patterns[(room_r, room_c)] = np.full((room_h, room_w), BG, dtype=int)
   395	
   396	    for idx, direction in required_sources.items():
   397	        room_dirs[idx] = direction
   398	        arrow_masks[idx] = _arrow_mask_for_direction(room_h, room_w, direction, rng)
   399	
   400	    for room_r in range(room_rows):
   401	        for room_c in range(room_cols):
   402	            idx = (room_r, room_c)
   403	            if idx == target or idx in required_sources:
   404	                continue
   405	            if rng.random() < 0.4:
   406	                direction = rng.choice(_valid_directions(room_r, room_c, room_rows, room_cols))
   407	                room_dirs[idx] = direction
   408	                arrow_masks[idx] = _arrow_mask_for_direction(room_h, room_w, direction, rng)
   409	
   410	    free_for_conflict = None
   411	    for idx in required_sources:
   412	        free = {
   413	            (r, c)
   414	            for r in range(room_h)
   415	            for c in range(room_w)
   416	            if not arrow_masks[idx][r, c]
   417	        }
   418	        free_for_conflict = free if free_for_conflict is None else free_for_conflict & free
   419	    if free_for_conflict is None:
   420	        raise AssertionError("missing required source rooms")
   421	    shared_cells = _choose_connected_cells(
   422	        free_for_conflict,
   423	        room_h,
   424	        room_w,
   425	        rng,
   426	        min_size=2,
   427	        max_size=3,
   428	    )
   429	
   430	    central_colors = list(rng.sample(PATTERN_COLORS, 5))
   431	    source_items = list(required_sources.items())
   432	    rng.shuffle(source_items)
   433	    for idx, color in zip((item[0] for item in source_items), central_colors[:4]):
   434	        available = {
   435	            (r, c)
   436	            for r in range(room_h)
   437	            for c in range(room_w)
   438	            if not arrow_masks[idx][r, c]
   439	        }
   440	        cells = _extend_shape(shared_cells, available, room_h, room_w, rng, max_extra=2)
   441	        _paint_cells(patterns[idx], cells, color)
   442	
   443	    target_base = set(rng.sample(sorted(shared_cells), rng.randint(1, len(shared_cells))))
   444	    available_target = {(r, c) for r in range(room_h) for c in range(room_w)}
   445	    target_cells = _extend_shape(target_base, available_target, room_h, room_w, rng, max_extra=2)
   446	    _paint_cells(patterns[target], target_cells, central_colors[4])
   447	
   448	    for room_r in range(room_rows):
   449	        for room_c in range(room_cols):
   450	            idx = (room_r, room_c)
   451	            if np.any(patterns[idx] != BG):
   452	                continue
   453	            color = rng.choice(PATTERN_COLORS)
   454	            min_size = 1 if room_dirs[idx] is None else 2
   455	            max_size = 5 if room_dirs[idx] is None else 4
   456	            patterns[idx] = _random_room_pattern(
   457	                room_h,
   458	                room_w,
   459	                arrow_masks[idx],
   460	                rng,
   461	                color=color,
   462	                min_size=min_size,
   463	                max_size=max_size,
   464	            )
   465	
   466	    for room_r in range(room_rows):
   467	        for room_c in range(room_cols):
   468	            _paint_room(
   469	                grid,
   470	                room_r,
   471	                room_c,
   472	                room_h,
   473	                room_w,
   474	                patterns[(room_r, room_c)],
   475	                arrow_masks[(room_r, room_c)],
   476	            )
   477	
   478	    _validate_generated(grid)
   479	    return grid
   480	
   481	
   482	def generate_input() -> np.ndarray:
   483	    rng = random.Random()
   484	    for _ in range(GEN_ATTEMPTS):
   485	        try:
   486	            return _gen_attempt(rng)
   487	        except AssertionError:
   488	            continue
   489	    raise RuntimeError("failed to generate a valid room-projection puzzle")

