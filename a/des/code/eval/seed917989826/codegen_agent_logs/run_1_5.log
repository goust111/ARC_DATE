+    return {
+        "grid": g,
+        "wall_color": wall_color,
+        "wall_rows": wall_rows,
+        "wall_cols": wall_cols,
+        "room_h": room_h,
+        "room_w": room_w,
+        "room_rows": len(wall_rows) - 1,
+        "room_cols": len(wall_cols) - 1,
+        "rooms": room_map,
