+
+    for room_r in range(room_rows):
+        for room_c in range(room_cols):
+            _paint_room(
+                grid,
+                room_r,
+                room_c,
+                room_h,
+                room_w,
+                patterns[(room_r, room_c)],
+                arrow_masks[(room_r, room_c)],
+            )
