0017: def main(grid: np.ndarray) -> np.ndarray:
0018:     """
0019:     Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.
0020: 
0021:     Input structure
0022:     - The most common color forms the outer background and all enclosed slot
0023:       backgrounds.
0024:     - The enclosed background components form a complete rectangular array of
0025:       slots, ordered by their positions.
0026:     - Each slot contains either no other color or exactly one object color.
0027: 
0028:     Rule
0029:     - Find all 4-connected components of the most common color that do not touch
0030:       the input edge.
0031:     - Sort their bounding boxes into row and column order to define the output
0032:       table.
0033:     - For each slot, output its unique non-background color if present; otherwise
0034:       output the background color.
0035: 
0036:     Key insight
0037:     - The large grid is an expanded table: the enclosed background components are
0038:       the cells, and any colored object drawn inside a cell is that cell's summary
0039:       value.
0040:     """
0041:     g = np.asarray(grid, dtype=int)
