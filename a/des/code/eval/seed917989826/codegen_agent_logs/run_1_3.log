+ARRANGEMENTS = ((1, 2), (1, 3), (2, 2), (2, 3), (3, 1), (3, 2))
+INNER_SIZE_RANGE = (4, 6)
+LOCK_GAP_RANGE = (2, 4)
+CANVAS_EXTRA_RANGE = (8, 14)
