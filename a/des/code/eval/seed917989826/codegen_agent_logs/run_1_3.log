+                    cleaned = inner.copy()
+                    cleaned[cleaned == color] = bg
+                    matches.append(
+                        {
+                            "color": color,
+                            "bbox": square_bbox,
+                            "inner": cleaned,
+                        }
+                    )
+        unique = {}
+        for item in matches:
+            unique[item["bbox"]] = item
+        if len(unique) == 1:
