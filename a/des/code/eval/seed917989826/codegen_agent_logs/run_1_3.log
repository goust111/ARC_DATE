+    inner = pattern.copy()
+    inner[~visible] = lock_color
+
+    lock = np.full((n + 2, n + 2), lock_color, dtype=int)
+    lock[1:-1, 1:-1] = inner
+    key = np.where(visible, lock_color, BG).astype(int)
+
+    clean = inner.copy()
+    clean[clean == lock_color] = BG
+    return lock, key, clean
+
