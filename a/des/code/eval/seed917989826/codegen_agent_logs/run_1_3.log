+def _candidate_locks(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    found: list[dict] = []
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != bg):
+        comps = _components(grid == color)
+        matches: list[dict] = []
+        for size in range(4, min(h, w) + 1):
