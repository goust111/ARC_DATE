+
+def _frontier(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    cells = set()
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        for dr, dc in NEIGHBORS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
+                cells.add((nr, nc))
+    return list(cells)
