+                        and np.all(sub[:, 0] == color)
+                        and np.all(sub[:, -1] == color)
+                    ):
+                        continue
+                    inner = sub[1:-1, 1:-1]
+                    if inner.size == 0 or not np.any(inner == color) or not np.any(inner != color):
+                        continue
+                    visible = inner != color
+                    if not _touches_all_sides(visible):
+                        continue
