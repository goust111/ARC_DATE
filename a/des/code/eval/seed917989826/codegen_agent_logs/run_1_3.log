+        r0 = int(arr[:, 0].min())
+        c0 = int(arr[:, 1].min())
+        r1 = int(arr[:, 0].max())
+        c1 = int(arr[:, 1].max())
+        sub = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        sub[arr[:, 0] - r0, arr[:, 1] - c0] = True
+        comps.append({"coords": arr, "bbox": (r0, c0, r1, c1), "mask": sub})
+    return comps
