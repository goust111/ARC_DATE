+
+def _bbox_inside(outer: tuple[int, int, int, int], inner: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = outer
+    ir0, ic0, ir1, ic1 = inner
+    return r0 <= ir0 <= ir1 <= r1 and c0 <= ic0 <= ic1 <= c1
