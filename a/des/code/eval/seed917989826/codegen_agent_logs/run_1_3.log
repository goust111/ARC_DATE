+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[dict] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        seen[r, c] = True
+        q = deque([(r, c)])
+        coords: list[tuple[int, int]] = []
+        while q:
+            cr, cc = q.popleft()
+            coords.append((cr, cc))
+            for dr, dc in NEIGHBORS4:
+                nr, nc = cr + dr, cc + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
