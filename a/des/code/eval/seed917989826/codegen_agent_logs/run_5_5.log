+    width = int(grid.shape[1])
+    candidates: list[tuple[int, int, int, int]] = []
+    for idx1, (s1, e1, color1) in enumerate(groups):
+        for s2, e2, color2 in groups[idx1 + 1 :]:
+            if color1 != color2:
+                continue
+            panel_w1 = s1
