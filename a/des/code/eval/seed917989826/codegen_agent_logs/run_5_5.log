H_RANGE = (18, 24)            # grid height bounds (inclusive)
W_RANGE = (18, 24)            # grid width bounds (inclusive)
BORDER = 1                    # min bg gap between a frame and grid edge
FRAME_GAP = 4                 # min bg gap between two frames
