+def _branch_is_wide(mask: np.ndarray, pos: tuple[int, int], direction: tuple[int, int]) -> bool:
+    h, w = mask.shape
+    for side in _perp(direction):
+        run = 0
+        best = 0
+        for k in range(1, 6):
+            mr = pos[0] + direction[0] * k
+            mc = pos[1] + direction[1] * k
+            sr = mr + side[0]
+            sc = mc + side[1]
