+    if side == "top":
+        depth = min(r1 - r0, win_c - c0, c1 - win_c)
+        for d in range(depth + 1):
+            rr = r0 + d
+            for cc in range(win_c - d, win_c + d + 1):
+                cells.append((rr, cc))
+    elif side == "bottom":
+        depth = min(r1 - r0, win_c - c0, c1 - win_c)
+        for d in range(depth + 1):
