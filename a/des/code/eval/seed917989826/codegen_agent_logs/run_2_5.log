+    if "top" in sides and "bottom" in sides and overlap_mode != "vertical":
+        if rng.random() < 0.5:
+            positions.setdefault("top", _pick_local(width, "near_start", rng))
+            positions.setdefault("bottom", _pick_local(width, "near_end", rng))
+        else:
