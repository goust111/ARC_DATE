+    c0 = int(room["c0"])
+    r1 = int(room["r1"])
+    c1 = int(room["c1"])
+    grid[r0 - 1, c0 - 1 : c1 + 2] = wall
+    grid[r1 + 1, c0 - 1 : c1 + 2] = wall
+    grid[r0 : r1 + 1, c0 - 1] = wall
+    grid[r0 : r1 + 1, c1 + 1] = wall
