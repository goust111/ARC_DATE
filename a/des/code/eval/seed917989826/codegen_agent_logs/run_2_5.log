+    meta = {
+        "force_overlap": force_overlap,
+        "overlap_room": overlap_room,
+        "overlap_mode": overlap_mode if overlap_mode is not None else "",
+        "empty_room": empty_room,
+        "single_room": single_room,
+        "rich_room": rich_room,
+    }
