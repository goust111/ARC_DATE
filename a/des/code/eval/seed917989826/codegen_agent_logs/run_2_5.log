                cover_count[ir, ic] += 1

        mask = cover_count > 0
        region = out[r0 : r1 + 1, c0 : c1 + 1]
        region[mask] = fill[mask]

    return out


def _safe_span(length: int) -> tuple[int, int]:
    if length >= 4:
        return 1, length - 2
    return 0, length - 1


def _pick_local(length: int, mode: str, rng: np.random.Generator) -> int:
    lo, hi = _safe_span(length)
