+def _most_common_non_bg(grid: np.ndarray, bg: int) -> int | None:
+    values = grid[grid != bg]
+    if values.size == 0:
+        return None
+    cols, counts = np.unique(values, return_counts=True)
+    return int(cols[np.argmax(counts)])
