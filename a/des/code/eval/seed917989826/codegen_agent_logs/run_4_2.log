+
+            while stack:
+                r, c = stack.pop()
+                coords.append((int(r), int(c)))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr = int(r + dr)
+                    nc = int(c + dc)
+                    if 0 <= nr < height and 0 <= nc < width and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
