+_RNG = np.random.default_rng()
+
+_GEN_ATTEMPTS = 500
+_GRID_MIN = 24
+_GRID_MAX_EXCLUSIVE = 32
+_BORDER = 1
+_OPEN_MARGIN = 7
+_FRAG_REACH = 10
+_SIDE_MARGIN = 5
