+def _container_candidates(height: int, width: int, patch: np.ndarray, orientation: str) -> list[tuple[int, int]]:
+    h, w = map(int, patch.shape)
+    min_r = _BORDER
+    max_r = height - h - _BORDER
+    min_c = _BORDER
+    max_c = width - w - _BORDER
