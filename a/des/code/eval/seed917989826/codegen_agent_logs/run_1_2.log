+CONTENT_DIM_MAX = 4
+FRAGMENT_RETRIES = 40
+LAYOUT_RETRIES = 120
+CANVAS_EXTRA_MIN = 4
+CANVAS_EXTRA_MAX = 10
+OUTER_GAP_MIN = 1
+OUTER_GAP_MAX = 4
+RESERVE_PADDING = 2
