+def _factor_pairs(area: int) -> list[tuple[int, int]]:
+    pairs: list[tuple[int, int]] = []
+    for h in range(1, isqrt(area) + 1):
+        if area % h != 0:
+            continue
+        w = area // h
+        pairs.append((h, w))
+        if h != w:
+            pairs.append((w, h))
+    return pairs
