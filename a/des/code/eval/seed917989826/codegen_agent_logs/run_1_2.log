+                "owner_color": owner_color,
+                "content_color": content_color,
+                "direction": _primary_direction(comp["bbox"], frame["bbox"]),
+                "origin_bbox": comp["bbox"],
+                "component_area": int(comp["area"]),
+                "content_patch": content_patch,
+                "seq": seq,
