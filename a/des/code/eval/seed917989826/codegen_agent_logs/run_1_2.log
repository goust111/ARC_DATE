+PATTERN_BANK = [
+    ("top",),
+    ("bottom",),
+    ("left",),
+    ("right",),
+    ("top", "top"),
+    ("bottom", "bottom"),
+    ("left", "left"),
+    ("right", "right"),
+    ("top", "bottom"),
+    ("left", "right"),
+    ("top", "left"),
+    ("top", "right"),
+    ("bottom", "left"),
+    ("bottom", "right"),
