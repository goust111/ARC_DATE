+    source_cache: dict[int, int] = {}
+
+    def source_of(square_id: int) -> int:
+        if square_id in source_cache:
+            return source_cache[square_id]
+        seen: set[int] = set()
+        cur = square_id
+        while cur in pred:
+            assert cur not in seen, "arrow graph must be acyclic"
+            seen.add(cur)
+            cur = pred[cur]
