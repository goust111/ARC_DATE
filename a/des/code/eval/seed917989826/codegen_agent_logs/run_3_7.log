+    return None
+
+
+def _place_isolate(grid: np.ndarray, color: int) -> list[tuple[int, int]] | None:
+    h, w = grid.shape
+    positions = [(r, c) for r in range(h - 2) for c in range(w - 2)]
+    random.shuffle(positions)
