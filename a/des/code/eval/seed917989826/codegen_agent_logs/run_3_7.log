+
+def _random_structure() -> tuple[list[int], int]:
+    while True:
+        chain_count = random.randint(1, 3)
+        chain_lengths = [random.randint(2, 4) for _ in range(chain_count)]
+        isolate_count = random.randint(0, 2)
