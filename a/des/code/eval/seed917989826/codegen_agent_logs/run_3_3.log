/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/4.md:324:  "src": "top-left seed region containing background and one primary color, with a solid secondary-color L-shaped legend border",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/4.md:325:  "transform": "expand the seed mask once: primary seed cells become primary-color copies of the mask, background seed cells become secondary-color copies, and mask background stays background; tile/crop the expanded pattern to the full grid"
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/4.md:326:}
