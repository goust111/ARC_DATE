+
+BG = 0
+COLOR_POOL = tuple(range(1, 10))
+BASE_MASK_SHAPES = ((3, 3), (3, 4), (4, 4), (3, 5))
+PAIR_COUNT_RANGE = (2, 4)
+GRID_H_RANGE = (18, 24)
+GRID_W_RANGE = (18, 24)
+PLACEMENT_GAP = 1
+GEN_RETRIES = 400
