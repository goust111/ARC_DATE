/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/3.md:109:  "type": "symmetry/pattern",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/3.md:110:  "src": "rough two-color nested foreground drawing: closed frame objects and small blob objects",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/3.md:111:  "dst": "canonical frame-and-dot diagram preserving containment and sibling row/column order",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/3.md:112:  "transform": "replace each blob by one pixel; replace each frame by a rectangular border padded around its direct children; keep outside blobs outside the enclosing frame",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/3.md:113:  "grid_shape": "canonical crop; root-level outside blobs occupy a 3x3 bg slot"
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/3.md:114:}
