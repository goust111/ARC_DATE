/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/3.md:240:  "type": "move_in_order",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/3.md:241:  "src": "colored partitioned frame line drawings; ignore scattered pad-color pixels",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/3.md:242:  "dst": "stack one horizontal bar per frame, ordered by count of enclosed background regions then color id",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/3.md:243:  "transform": "bar length = number of enclosed 4-connected background regions; pad right with the scattered color",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/3.md:244:  "grid_shape": "height = number of frame colors, width = maximum enclosed-region count"
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/3.md:245:}
