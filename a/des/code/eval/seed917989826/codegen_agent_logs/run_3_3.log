/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/4.md:105:  "type": "move_to_match",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/4.md:106:  "src": "multi-color sprite s with a unique marker color (minority color inside s)",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/4.md:107:  "dst": "align to isolated border pixel d (same marker color)",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/4.md:108:  "match_cond": "s.marker.color == d.color",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/4.md:109:  "transform": "translate s: if d on top/bottom edge → align col(s.marker) to col(d); else → align row(s.marker) to row(d); clip out-of-bounds pixels"
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/4.md:110:}
