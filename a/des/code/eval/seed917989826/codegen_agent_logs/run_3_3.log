import numpy as np
from collections import defaultdict

def connected(mask):
    h,w=mask.shape
    pts=np.argwhere(mask)
    if len(pts)==0:
        return False
    seen={tuple(pts[0])}
    stack=[tuple(pts[0])]
    while stack:
        r,c=stack.pop()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            rr,cc=r+dr,c+dc
            if 0<=rr<h and 0<=cc<w and mask[rr,cc] and (rr,cc) not in seen:
                seen.add((rr,cc)); stack.append((rr,cc))
    return len(seen)==mask.sum()

def spans(mask):
    rows,cols=np.where(mask)
    return 0 in rows and mask.shape[0]-1 in rows and 0 in cols and mask.shape[1]-1 in cols

for dims in [(3,3),(3,4),(4,3),(3,5),(5,3),(4,4)]:
    h,w=dims
    n=h*w
    classes=[]
    seen=set()
    for bits in range(1,1<<n):
        if bits in seen:
            continue
        arr=np.array([(bits>>i)&1 for i in range(n)],dtype=bool).reshape(h,w)
        comp=~arr
        c_bits=((1<<n)-1)"'^bits
        seen.add(bits); seen.add(c_bits)
        if arr.sum()<3 or comp.sum()<3:
            continue
        if not spans(arr) or not spans(comp):
            continue
        if connected(arr) and connected(comp):
            classes.append(bits)
    print(dims, len(classes))
