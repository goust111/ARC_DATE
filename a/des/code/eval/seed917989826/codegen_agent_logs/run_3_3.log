/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/5.md:202:  "type": "move_along_path",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/5.md:203:  "src": "black square",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/5.md:204:  "path": "blue pixels \"water channel\" that is wide enough to pass through until \"stuck\" because of too narrow",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/5.md:205:  "dst": "reach same sized red square or \"get stuck\" on the way where the blue path is too narrow",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/5.md:206:  "transform": "cover the red square if reaching it"
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/5.md:207:}
