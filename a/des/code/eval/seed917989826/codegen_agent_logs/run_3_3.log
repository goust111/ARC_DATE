+def _connected(mask: np.ndarray, connectivity: int = 8) -> bool:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return False
+    h, w = mask.shape
+    nbrs = _neighbors(connectivity)
+    start = tuple(map(int, pts[0]))
+    stack = [start]
+    seen = {start}
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in nbrs:
