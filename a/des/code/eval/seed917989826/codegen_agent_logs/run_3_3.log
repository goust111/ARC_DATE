def find_cycle(h,w):
    N=h*w
    neigh={}
    for r in range(h):
      for c in range(w):
        v=(r,c)
        ns=[]
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
          rr,cc=r+dr,c+dc
          if 0<=rr<h and 0<=cc<w:
