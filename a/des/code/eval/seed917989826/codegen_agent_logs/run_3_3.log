/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/1.md:192:  "src": "sequence of equal rectangular panels ending with a blank/static template panel",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/1.md:193:  "dst": "next panel in the sequence",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/1.md:194:  "transform": "use the template panel as the output canvas; for each dynamic color absent from the template, follow its regular panel schedule and extrapolate the last two interval changes one more step along the changing row or column axis",
