    def dfs(v):
      if len(path)==N:
        return start in neigh[v]
      cand=[u for u in neigh[v] if u not in used]
      cand.sort(key=lambda u:(sum(1 for x in neigh[u] if x not in used), abs(u[0]-h//2)+abs(u[1]-w//2)))
