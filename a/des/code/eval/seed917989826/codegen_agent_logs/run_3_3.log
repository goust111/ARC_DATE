/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/7.md:247:  "type": "move_to_match",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/7.md:248:  "src": "multi-color sprite s with a unique marker color (minority color inside s)",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/7.md:249:  "dst": "align to isolated border pixel d (same marker color)",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/7.md:250:  "match_cond": "s.marker.color == d.color",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/7.md:251:  "transform": "translate s: if d on top/bottom edge → align col(s.marker) to col(d); else → align row(s.marker) to row(d); clip out-of-bounds pixels"
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/7.md:252:}
