/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/7.md:173:  "src": "non-background, non-maroon 4-connected objects touching maroon marker pixels",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/7.md:174:  "path": "move straight away from the maroon contact side along the matching row or column",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/7.md:175:  "dst": "furthest in-bounds position where the object reaches the grid edge",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/7.md:176:  "trajectory": "translate each object once, preserving its shape and color",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/7.md:177:  "transform": "clear each moving object from its original position; keep maroon markers unchanged"
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/7.md:178:}
