/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/3.md:364:  "type": "move_along_path",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/3.md:365:  "src": "two solid same-sized rectangular marker objects s sharing either a row span or a column span",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/3.md:366:  "path": "straight cardinal ray from each s facing edge toward the other marker, stopping after half of the background gap; an odd middle line stays background",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/3.md:367:  "trajectory": "paint the traversed gap rows/columns with s.color across the full grid span perpendicular to the path",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/3.md:368:  "transform": "keep the original marker rectangles and unpainted background cells unchanged"
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/3.md:369:}
