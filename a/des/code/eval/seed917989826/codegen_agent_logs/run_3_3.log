/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/4.md:281:  "type": "move_to_match",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/4.md:282:  "src": "edge-relative marker run s in a marked rectangle aligned with the plain rectangle row band",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/4.md:283:  "dst": "run d in the plain rectangle crop",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/4.md:284:  "match_cond": "s.nearest_edge_offsets == d.nearest_edge_offsets",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/4.md:285:  "transform": "paint each matched d with the shared marker color; keep base rectangle fill elsewhere",
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/4.md:286:  "grid_shape": "same shape as the plain rectangle"
/home/lixinyu/snap/a/des/seed917989826/3/codegen_prompts/4.md:287:}
