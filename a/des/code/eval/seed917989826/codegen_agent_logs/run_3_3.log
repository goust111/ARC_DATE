            if 0<=rr<h and 0<=cc<w and mask[rr,cc] and (rr,cc) not in seen:
                seen.add((rr,cc)); stack.append((rr,cc))
    return len(seen)==mask.sum()

def score(mask):
    h,w=mask.shape
    other=~mask
    if not connected(mask) or not connected(other):
        return -999
    def touches(m):
        rs,cs=np.where(m)
        return [0 in rs, h-1 in rs, 0 in cs, w-1 in cs]
    ta=touches(mask); tb=touches(other)
    return sum(ta)+sum(tb)

def random_partition(h,w):
    # vertical snake path prefix/suffix gives connected partition
    path=[]
    for c in range(w):
        rows=range(h) if c%2==0 else range(h-1,-1,-1)
        for r in rows:
            path.append((r,c))
    cut=random.randint(3,h*w-3)
    m=np.zeros((h,w),dtype=bool)
    for r,c in path[:cut]:
        m[r,c]=True
    return m

