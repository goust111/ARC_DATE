+    by_color: dict[int, list[dict[str, object]]] = defaultdict(list)
+    for comp in components:
+        by_color[int(comp["color"])].append(comp)
+
+    out_claims: dict[tuple[int, int], int] = {}
+    for color, pair in by_color.items():
