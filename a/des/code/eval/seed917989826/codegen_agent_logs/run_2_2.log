+            fb1 = int(first["bbox"][2])
+            sa0 = int(second["bbox"][0])
+            gap = int(sa0 - fb1 - 1)
+            shift_first = (gap // 2, 0)
+            shift_second = (-(gap - gap // 2), 0)
