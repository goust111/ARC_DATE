  "type": "transform_in_place",
  "src": "maroon marker pixels or segments adjacent to solid grey or pink 3x3 square objects",
  "transform": "erase grey squares after stamping maroon into each touched near-edge cell; keep grey-adjacent markers in place; keep pink squares, remove pink-adjacent markers, and stamp their maroon cells onto the matching middle row or column of the pink square"
}
</annotation>
</reference_puzzle>

