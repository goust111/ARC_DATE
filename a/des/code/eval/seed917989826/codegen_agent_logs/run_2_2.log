+        inp[raw_inp != -1] = raw_inp[raw_inp != -1]
+        out[raw_out != -1] = raw_out[raw_out != -1]
+
+        corners = ((0, 0), (0, width - 1), (height - 1, 0), (height - 1, width - 1))
+        marker = random.choice(corners)
