+def _build_strip_owner(rng: random.Random) -> np.ndarray:
+    if rng.random() < 0.5:
+        rows, cols = 1, rng.randint(3, 5)
+        cuts = sorted(rng.sample(range(1, cols), rng.randint(1, cols - 1)))
+        segments = [0] + cuts + [cols]
