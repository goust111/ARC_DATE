+def _build_cross_owner(rng: random.Random) -> np.ndarray:
+    owner = np.array(
+        [
+            [0, 0, 0],
+            [1, 2, 3],
+            [4, 4, 4],
+        ],
+        dtype=int,
+    )
+    if rng.random() < 0.5:
+        owner = owner.T
+    if rng.random() < 0.5:
+        owner = owner[::-1, :]
+    if rng.random() < 0.5:
+        owner = owner[:, ::-1]
+    ids = sorted(int(x) for x in np.unique(owner))
+    remap = {rid: i for i, rid in enumerate(ids)}
+    return np.vectorize(remap.get)(owner).astype(int)
