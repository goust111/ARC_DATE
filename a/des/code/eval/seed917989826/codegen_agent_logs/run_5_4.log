+    for rid, (r0, c0, r1, c1) in coarse_rects.items():
+        top = row_starts[r0]
+        left = col_starts[c0]
+        bottom = row_starts[r1] + row_heights[r1] - 1
+        right = col_starts[c1] + col_widths[c1] - 1
