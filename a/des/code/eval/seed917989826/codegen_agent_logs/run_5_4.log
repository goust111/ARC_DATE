+def _owner_adjacency(owner: np.ndarray) -> dict[int, set[int]]:
+    rows, cols = map(int, owner.shape)
+    adj = {int(rid): set() for rid in np.unique(owner)}
+    for r in range(rows):
+        for c in range(cols - 1):
+            a = int(owner[r, c])
+            b = int(owner[r, c + 1])
+            if a != b:
+                adj[a].add(b)
+                adj[b].add(a)
+    for r in range(rows - 1):
+        for c in range(cols):
+            a = int(owner[r, c])
+            b = int(owner[r + 1, c])
+            if a != b:
