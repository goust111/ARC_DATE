+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    mode = rng.choice(["tie", "block", "open"])
+    min_size = 4 if mode in {"tie", "block"} else 3
+    block_rows = rng.randint(min_size, 7)
+    block_cols = rng.randint(min_size, 7)
+
+    colors = SEED_COLORS[:]
