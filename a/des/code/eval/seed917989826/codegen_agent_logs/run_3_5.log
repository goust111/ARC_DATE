+    if np.array_equal(grid, out):
+        return None
+    if len(seeds) < 2:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(500):
+        grid = _gen_attempt(rng)
+        if grid is not None:
