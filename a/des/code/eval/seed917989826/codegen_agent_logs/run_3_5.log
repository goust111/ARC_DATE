+def _seed_has_room(block_rows: int, block_cols: int, block_r: int, block_c: int, dr: int, dc: int) -> bool:
+    nr = block_r + dr
+    nc = block_c + dc
+    return 0 <= nr < block_rows and 0 <= nc < block_cols
