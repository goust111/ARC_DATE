+    for br, r0 in enumerate(row_starts):
+        for bc, c0 in enumerate(col_starts):
+            patch = grid[r0 : r0 + 3, c0 : c0 + 3]
+            nz = [(rr, cc, int(patch[rr, cc])) for rr in range(3) for cc in range(3) if int(patch[rr, cc]) != bg]
