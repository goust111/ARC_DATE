+    grid[legend_r0, legend_c0 : legend_c1 + 1] = FRAME
+    grid[legend_r1, legend_c0 : legend_c1 + 1] = FRAME
+    grid[legend_r0 : legend_r1 + 1, legend_c0] = FRAME
