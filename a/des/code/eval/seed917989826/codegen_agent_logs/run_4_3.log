+
+def _bg_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(int(r), int(c))]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((int(cr), int(cc)))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = int(cr + dr)
+                    nc = int(cc + dc)
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in points]
+    cs = [c for _, c in points]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _rotate_cw(d: tuple[int, int]) -> tuple[int, int]:
+    dr, dc = d
+    return (int(dc), int(-dr))
+
+
+def _rotate_ccw(d: tuple[int, int]) -> tuple[int, int]:
+    dr, dc = d
+    return (int(-dc), int(dr))
+
+
+def _parse_legend(grid: np.ndarray, bg: int) -> dict[int, int]:
+    mapping: dict[int, int] = {}
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
+            rule = int(grid[r, c])
+            if rule not in (RED, BLUE):
+                continue
+            partners: list[int] = []
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                nr = int(r + dr)
+                nc = int(c + dc)
+                if not (0 <= nr < h and 0 <= nc < w):
+                    continue
+                val = int(grid[nr, nc])
+                if val == bg or val in (RED, BLUE):
+                    continue
+                partners.append(val)
+            if len(set(partners)) != 1:
+                continue
+            mapping[int(partners[0])] = 1 if rule == RED else -1
+    assert mapping, "expected at least one mirror rule in the legend"
+    return mapping
+
+
+def _arrow_direction(points: list[tuple[int, int]]) -> tuple[int, int] | None:
+    if len(points) != 3:
+        return None
+    r0, c0, r1, c1 = _bbox(points)
+    if r1 - r0 != 1 or c1 - c0 != 1:
+        return None
+    cells = {(int(r), int(c)) for r, c in points}
+    square = {
+        (int(r0), int(c0)),
+        (int(r0), int(c1)),
+        (int(r1), int(c0)),
+        (int(r1), int(c1)),
+    }
+    if len(cells) != 3 or not cells.issubset(square):
+        return None
+    missing = list(square - cells)
+    if len(missing) != 1:
+        return None
+    mr, mc = missing[0]
+    if (mr, mc) == (r0, c0):
+        return NW
+    if (mr, mc) == (r0, c1):
+        return NE
+    if (mr, mc) == (r1, c0):
+        return SW
+    return SE
