+def _place_segments(
+    hits: list[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+    path_cells: set[tuple[int, int]],
+    shape: tuple[int, int],
+) -> list[list[tuple[int, int]]] | None:
+    h, w = shape
+    placed: list[list[tuple[int, int]]] = []
+    occ = set(occupied)
+
+    for hit in hits:
+        hr, hc = hit
+        choices: list[list[tuple[int, int]]] = []
+        for orient in ("h", "v"):
+            for length in (2, 3, 4):
+                if orient == "h":
+                    for c0 in range(hc - length + 1, hc + 1):
+                        c1 = c0 + length - 1
+                        if c0 < 0 or c1 >= w:
+                            continue
+                        cells = [(int(hr), int(cc)) for cc in range(c0, c1 + 1)]
+                        if hit not in cells:
+                            continue
+                        bad = False
+                        for cell in cells:
+                            if cell != hit and (cell in occ or cell in path_cells):
+                                bad = True
+                                break
+                        if not bad:
+                            choices.append(cells)
+                else:
+                    for r0 in range(hr - length + 1, hr + 1):
+                        r1 = r0 + length - 1
+                        if r0 < 0 or r1 >= h:
+                            continue
+                        cells = [(int(rr), int(hc)) for rr in range(r0, r1 + 1)]
+                        if hit not in cells:
+                            continue
+                        bad = False
+                        for cell in cells:
+                            if cell != hit and (cell in occ or cell in path_cells):
+                                bad = True
+                                break
+                        if not bad:
+                            choices.append(cells)
+        if not choices:
+            return None
+        cells = random.choice(choices)
+        placed.append(cells)
+        occ.update(cells)
+    return placed
+
