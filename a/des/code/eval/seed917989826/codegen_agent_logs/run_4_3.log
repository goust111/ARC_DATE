+def _pattern_has_arrow_like_component(patch: np.ndarray) -> bool:
+    for color in set(int(v) for v in patch.flatten()):
+        for comp in _components(patch == color):
+            if _arrow_direction(comp) is not None:
+                return True
+    return False
