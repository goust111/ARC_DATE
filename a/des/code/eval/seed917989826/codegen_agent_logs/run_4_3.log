+                                bad = True
+                                break
+                        if not bad:
+                            choices.append(cells)
+        if not choices:
+            return None
+        cells = random.choice(choices)
+        placed.append(cells)
+        occ.update(cells)
+    return placed
+
+
+def _build_attempt() -> np.ndarray | None:
+    h = random.randint(19, 28)
+    w = random.randint(19, 28)
+    grid_shape = (int(h), int(w))
+
