+
+def _arrow_patch(color: int, bg: int, direction: tuple[int, int]) -> np.ndarray:
+    patch = np.full((2, 2), int(bg), dtype=int)
+    if direction == NW:
+        missing = (0, 0)
+    elif direction == NE:
+        missing = (0, 1)
+    elif direction == SW:
+        missing = (1, 0)
+    else:
+        missing = (1, 1)
+    for r in range(2):
+        for c in range(2):
+            if (r, c) != missing:
+                patch[r, c] = int(color)
+    return patch
+
+
+def _legend_cells(
+    corner: str,
+    orientation: str,
+    mirror_colors: list[int],
+    turns: list[int],
+    shape: tuple[int, int],
+) -> dict[tuple[int, int], int]:
+    h, w = shape
+    cells: dict[tuple[int, int], int] = {}
+    if orientation == "horizontal":
+        height = 2 * len(mirror_colors) - 1
+        width = 2
+        if corner in ("tl", "tr"):
+            r0 = 0
+        else:
+            r0 = h - height
+        if corner in ("tl", "bl"):
+            c0 = 0
+        else:
+            c0 = w - width
+        for i, (mirror, turn) in enumerate(zip(mirror_colors, turns, strict=True)):
+            rr = int(r0 + 2 * i)
+            cells[(rr, int(c0))] = int(mirror)
+            cells[(rr, int(c0 + 1))] = RED if int(turn) == 1 else BLUE
+    else:
+        height = 2
+        width = 2 * len(mirror_colors) - 1
+        if corner in ("tl", "tr"):
+            r0 = 0
+        else:
+            r0 = h - height
+        if corner in ("tl", "bl"):
+            c0 = 0
+        else:
+            c0 = w - width
+        for i, (mirror, turn) in enumerate(zip(mirror_colors, turns, strict=True)):
+            cc = int(c0 + 2 * i)
+            cells[(int(r0), cc)] = int(mirror)
+            cells[(int(r0 + 1), cc)] = RED if int(turn) == 1 else BLUE
