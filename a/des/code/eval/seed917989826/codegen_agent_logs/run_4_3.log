+    rr = int(ar + rotated.shape[0])
+    cc = int(ac + rotated.shape[1])
+    assert 0 <= ar and 0 <= ac and rr <= h and cc <= w, "terminal copy must fit"
+    out[ar:rr, ac:cc] = rotated
+    return out
