+    for r in range(h):
+        for c in range(w):
+            rule = int(grid[r, c])
+            if rule not in (RED, BLUE):
+                continue
+            partners: list[int] = []
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                nr = int(r + dr)
+                nc = int(c + dc)
+                if not (0 <= nr < h and 0 <= nc < w):
+                    continue
+                val = int(grid[nr, nc])
+                if val == bg or val in (RED, BLUE):
+                    continue
