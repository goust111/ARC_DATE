+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+RED = 2
+BLUE = 1
+
+NW = (-1, -1)
+NE = (-1, 1)
+SE = (1, 1)
+SW = (1, -1)
+DIAGS = (NW, NE, SE, SW)
+
+CORNERS = ("tl", "tr", "bl", "br")
+CORNER_TO_DIR = {
+    "tl": SE,
+    "tr": SW,
+    "bl": NE,
+    "br": NW,
+}
+DIR_TO_NAME = {
+    NW: "nw",
+    NE: "ne",
+    SE: "se",
+    SW: "sw",
+}
