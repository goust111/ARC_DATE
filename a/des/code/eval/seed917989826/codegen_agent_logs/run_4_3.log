+        cell = int(g[nr, nc])
+        if cell == bg:
+            out[nr, nc] = int(arrow_color)
+            r, c = int(nr), int(nc)
+            continue
+
+        if cell in mirror_colors:
+            r, c = int(nr), int(nc)
+            turn = int(mirror_turn[cell])
+            total_turns += turn
+            direction = _rotate_cw(direction) if turn == 1 else _rotate_ccw(direction)
+            continue
