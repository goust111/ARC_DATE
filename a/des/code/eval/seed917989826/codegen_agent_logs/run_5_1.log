        dr, dc = box["dot_cell"]
        out[int(dr), int(dc)] = bg
        for r, c in box["gap_cells"]:
            out[int(r), int(c)] = int(box["dot_color"])
    return out


def _can_place(occupied: np.ndarray, top: int, left: int, h: int, w: int, pad: int) -> bool:
    H, W = occupied.shape
    if top < 0 or left < 0 or top + h > H or left + w > W:
