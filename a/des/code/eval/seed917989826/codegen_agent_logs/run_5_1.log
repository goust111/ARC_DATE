+
+def _ring_mask(h: int, w: int, t: int) -> np.ndarray:
+    ring = np.zeros((h, w), dtype=bool)
+    ring[:t, :] = True
+    ring[h - t :, :] = True
+    ring[:, :t] = True
+    ring[:, w - t :] = True
