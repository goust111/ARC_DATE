+from __future__ import annotations
+
+from collections import defaultdict
+import random
+
+import numpy as np
+
+
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+BG = 0
+FRAME_THICKNESS = 2
+MAX_GENERATION_RETRIES = 400
+
+BOX_COUNT_CHOICES = (2, 3)
+GRID_SIDE_RANGE = {
+    2: (22, 28),
+    3: (26, 30),
+}
