+from __future__ import annotations
+
+from collections import defaultdict
+import random
+
+import numpy as np
+
+
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+BG = 0
+FRAME_THICKNESS = 2
+MAX_GENERATION_RETRIES = 400
+
+BOX_COUNT_CHOICES = (2, 3)
+GRID_SIDE_RANGE = {
+    2: (22, 28),
+    3: (26, 30),
+}
+BOX_H_RANGE = (8, 11)
+BOX_W_RANGE = (8, 12)
+BOX_PADDING = 2
+KEY_PADDING = 1
+PLACEMENT_RETRIES = 250
+
+SHAPE_LIBRARY = (
+    np.array([[1, 1, 1]], dtype=bool),
+    np.array([[1, 1, 1, 1]], dtype=bool),
+    np.array([[1, 0], [1, 1]], dtype=bool),
+    np.array([[1, 0, 0], [1, 1, 1]], dtype=bool),
+    np.array([[1, 1, 1], [0, 1, 0]], dtype=bool),
+    np.array([[0, 1, 1], [1, 1, 0]], dtype=bool),
+    np.array([[1, 1, 1], [1, 1, 0]], dtype=bool),
+    np.array([[1, 0, 1], [1, 1, 1]], dtype=bool),
+)
+SIDES = ("top", "bottom", "left", "right")
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _bbox_from_array(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            parts.append(coords)
+    return parts
+
+
+def _find_monochrome_components(grid: np.ndarray, bg: int) -> list[dict]:
+    comps: list[dict] = []
+    cid = 0
+    for color in sorted(set(map(int, grid.ravel())) - {bg}):
+        for coords in _components(grid == color):
+            arr = np.array(coords, dtype=int)
+            comps.append(
+                {
+                    "id": cid,
+                    "color": int(color),
+                    "coords": coords,
+                    "coords_arr": arr,
+                    "bbox": _bbox_from_array(arr),
+                    "area": int(len(coords)),
+                }
+            )
