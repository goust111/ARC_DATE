 155:         group = [item for item in drawings if item[1] == rooms]
 156:         ordered.extend(_cover_order(g, group))
 157: 
 158:     width = max(rooms for _color, rooms, _walls in ordered)
 159: 
 160:     out = np.full((len(ordered), width), pad, dtype=int)
 161:     for r, (color, rooms, _walls) in enumerate(ordered):
