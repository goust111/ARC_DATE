  43: 
  44: GRID_SHAPE = (10, 10)
  45: GRID_AREA = GRID_SHAPE[0] * GRID_SHAPE[1]
  46: 
  47: # Palette: four distinct foreground colors, no background.
  48: COLOR_POOL = np.arange(1, 10)
  49: N_COLORS = 4
  50: 
  51: # Counts: largest, second, third are sampled; smallest is residual.
  52: COUNT_RANGES = ((40, 55), (25, 35), (10, 20))
  53: RESIDUAL_COUNT_RANGE = (2, 10)
  54: COUNT_SAMPLE_RETRIES = 100
  55: GENERATION_RETRIES = 300
  56: 
  57: 
  58: def _sample_ranked_counts(rng: np.random.Generator) -> list[int] | None:
  59:     """Return four distinct counts in descending rank ranges, summing to the grid area."""
  60:     for _ in range(COUNT_SAMPLE_RETRIES):
  61:         sampled = [int(rng.integers(lo, hi + 1)) for lo, hi in COUNT_RANGES]
  62:         residual = GRID_AREA - sum(sampled)
  63:         lo, hi = RESIDUAL_COUNT_RANGE
  64:         counts = sampled + [residual]
  65:         if lo <= residual <= hi and len(set(counts)) == N_COLORS:
  66:             return counts
  67:     return None
  68: 
  69: 
  70: def _gen_attempt() -> np.ndarray | None:
  71:     rng = np.random.default_rng()
  72: 
  73:     colors = rng.choice(COLOR_POOL, size=N_COLORS, replace=False).tolist()
  74:     counts = _sample_ranked_counts(rng)
  75:     if counts is None:
  76:         return None
  77: 
  78:     pixels = np.repeat(colors, counts)
  79:     rng.shuffle(pixels)
  80:     return pixels.astype(int, copy=False).reshape(GRID_SHAPE)
