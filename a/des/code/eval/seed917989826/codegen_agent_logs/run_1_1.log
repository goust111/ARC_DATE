    min_w = max(GRID_W_RANGE[0], canvas_w + 4, max(spec["frame_w"] + pattern["width"] + 3 for spec, pattern in zip(frame_specs, patterns, strict=False)))
    if min_h > GRID_H_RANGE[1] or min_w > GRID_W_RANGE[1]:
