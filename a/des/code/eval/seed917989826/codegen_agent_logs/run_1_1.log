+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+DIRS = ("up", "down", "left", "right")
+
+# Generator tuning.
+GRID_H_RANGE = (24, 32)
+GRID_W_RANGE = (24, 32)
+FRAME_COUNT_OPTIONS = (2, 3, 4, 5)
+FRAME_INNER_H_RANGE = (4, 7)
+FRAME_INNER_W_RANGE = (4, 7)
