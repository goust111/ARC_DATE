    packed = _pack_pattern_crops((cr1 - cr0 + 1, cc1 - cc0 + 1), ordered, bg, canvas_color)
    out[cr0 : cr1 + 1, cc0 : cc1 + 1] = packed
    return out


def _gen_attempt() -> np.ndarray | None:
    bg = 0
