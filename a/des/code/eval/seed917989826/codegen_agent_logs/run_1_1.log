+def _parse_scene(grid: np.ndarray) -> tuple[int, dict, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    bg = int(Counter(map(int, g.ravel())).most_common(1)[0][0])
+    h, w = g.shape
