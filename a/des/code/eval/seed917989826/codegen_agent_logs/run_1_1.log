+def _pack_pattern_crops(
+    canvas_shape: tuple[int, int],
+    items: list[dict],
+    bg: int,
+    canvas_color: int,
+) -> np.ndarray:
+    ch, cw = canvas_shape
+    out = np.full((ch, cw), int(canvas_color), dtype=int)
+    cursor_r = 0
+    cursor_c = 0
+    row_h = 0
+    for item in items:
+        patch = item["pattern_patch"]
+        ph, pw = patch.shape
+        if cursor_c > 0 and cursor_c + pw > cw:
+            cursor_r += row_h
+            cursor_c = 0
+            row_h = 0
