+    rr0, rc0, rr1, rc1 = rel_rect
+    min_r = max(1 - rr0, 0 - rr0)
+    max_r = min(grid_h - 2 - rr1, grid_h - 1 - rr1)
+    min_c = max(1 - rc0, 0 - rc0)
