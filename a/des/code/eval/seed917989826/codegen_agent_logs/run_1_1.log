+
+def _pattern_push_top_left(frame: dict) -> tuple[int, int]:
+    r0, c0, r1, c1 = frame["bbox"]
+    pr0, pc0, pr1, pc1 = frame["pattern_bbox"]
+    ph = pr1 - pr0 + 1
+    pw = pc1 - pc0 + 1
+    direction = frame["direction"]
+    if direction == "up":
+        return r0 - ph, pc0
+    if direction == "down":
+        return r1 + 1, pc0
+    if direction == "left":
+        return pr0, c0 - pw
+    return pr0, c1 + 1
