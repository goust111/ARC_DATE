+
+    max_frame_area = max((r1 - r0 + 1) * (c1 - c0 + 1) for r0, c0, r1, c1 in (f["bbox"] for f in frame_infos))
+    canvas_candidates = [cand for cand in solid_candidates if cand["area"] > max_frame_area]
