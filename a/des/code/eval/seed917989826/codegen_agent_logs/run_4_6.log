) -> dict[str, object]:
    path = _path_for_pair(start, end, dark_parity)
    return {
        "type": pair_type,
        "color": int(color),
        "points": (tuple(start), tuple(end)),
        "path": tuple(path),
        "path_set": set(path),
    }


def _place_crossing_row_col(
    height: int,
