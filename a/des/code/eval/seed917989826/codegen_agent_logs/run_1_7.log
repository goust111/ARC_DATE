+        raise AssertionError("invalid component seed")
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for dr, dc in NEIGHBORS8:
+            nr, nc = r + dr, c + dc
+            if not _in_bounds(grid.shape, nr, nc):
+                continue
+            if (nr, nc) in blocked or (nr, nc) in seen:
