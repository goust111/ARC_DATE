+        sides = [above, below]
+    else:
+        col = int(mirror["axis"])
+        r0, r1 = map(int, mirror["span"])
+        left = []
+        right = []
+        if col > 0:
+            left = [(r, col - 1) for r in range(r0, r1 + 1) if int(grid[r, col - 1]) not in {BG, MIRROR}]
+        if col + 1 < grid.shape[1]:
