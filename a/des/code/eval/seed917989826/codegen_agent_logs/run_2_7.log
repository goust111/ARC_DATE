+        4: [[2, 1, 1], [2, 2], [3, 1]],
+        5: [[2, 1, 1, 1], [2, 2, 1], [3, 1, 1], [3, 2]],
+        6: [[2, 1, 1, 1, 1], [2, 2, 1, 1], [2, 2, 2], [3, 1, 1, 1], [3, 2, 1], [3, 3]],
+    }
+    return patterns[n]
