+from __future__ import annotations
+
+import numpy as np
+
+
+GREY = 5
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+COLOR_POOL = tuple(range(10))
+
+MIN_CANVAS = 18
+MAX_CANVAS = 34
+MAX_ATTEMPTS = 400
+PLACEMENT_ATTEMPTS = 300
+
+MIN_CONTAINERS = 3
+MAX_CONTAINERS = 6
+MIN_INTERIOR_H = 2
+MAX_INTERIOR_H = 5
+MIN_INTERIOR_W = 2
+MAX_INTERIOR_W = 6
+
+AREA_TO_DIMS: dict[int, list[tuple[int, int]]] = {}
+for _ih in range(MIN_INTERIOR_H, MAX_INTERIOR_H + 1):
