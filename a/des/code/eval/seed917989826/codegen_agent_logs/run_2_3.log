+    order = sorted(range(len(keys)), key=lambda i: len(candidates[i]))
+    solutions: list[list[tuple[int, int] | None]] = []
+    current: list[tuple[int, int] | None] = [None] * len(keys)
+    used_locks: set[int] = set()
