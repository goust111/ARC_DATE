+    hole_abs = [(r0 + int(rr), c0 + int(cc)) for rr, cc in hole_local]
+    return {
+        "color": color,
+        "bbox": (r0, c0, r1, c1),
+        "coords": coords,
+        "hole_bbox_local": (hr0, hc0, hr1, hc1),
+        "hole_mask": hole_tight,
