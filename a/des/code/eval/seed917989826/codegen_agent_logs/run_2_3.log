+    r0, c0, r1, c1 = comp["bbox"]
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    if patch.shape[0] < 4 or patch.shape[1] < 4:
+        return None
+    if not np.all((patch == color) | (patch == bg)):
+        return None
+    if not (
+        np.all(patch[0, :] == color)
+        and np.all(patch[-1, :] == color)
