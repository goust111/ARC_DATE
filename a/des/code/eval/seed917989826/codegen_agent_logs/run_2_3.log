+
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+
+# Generator colors.
+GEN_BG = 0
+GEN_LOCK = 5
+GEN_MARKER = 4
+GEN_KEY_COLORS = (1, 2, 3, 6, 7, 8, 9)
