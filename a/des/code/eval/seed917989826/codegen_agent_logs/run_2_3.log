+    def dfs(depth: int) -> None:
+        if len(solutions) > 1:
+            return
+        if depth == len(order):
+            solutions.append(current.copy())
+            return
+        key_idx = order[depth]
+        for lock_idx, rot in candidates[key_idx]:
