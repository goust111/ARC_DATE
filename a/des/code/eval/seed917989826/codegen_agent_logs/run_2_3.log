+def _stamp(occupied: np.ndarray, reserve_mask: np.ndarray, r0: int, c0: int) -> None:
+    h, w = reserve_mask.shape
+    block = occupied[r0 : r0 + h, c0 : c0 + w]
+    block[reserve_mask] = True
