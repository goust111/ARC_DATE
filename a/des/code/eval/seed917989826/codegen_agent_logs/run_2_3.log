+def _build_key_patch(mask: np.ndarray, key_color: int, marker_dir: int) -> np.ndarray:
+    key_cells = [tuple(map(int, xy)) for xy in np.argwhere(mask)]
+    if marker_dir == 0:
+        choices = [(r, c) for r, c in key_cells if r == 0]
+        kr, kc = random.choice(choices)
+        marker = (kr - 1, kc)
+    elif marker_dir == 1:
