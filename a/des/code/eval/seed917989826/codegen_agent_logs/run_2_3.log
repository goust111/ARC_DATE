+        if not placed:
+            return None
+
+    key_order = sorted(range(len(specs)), key=lambda i: specs[i]["key_patch"].size, reverse=True)
+    for idx in key_order:
+        spec = specs[idx]
+        placed = False
+        h, w = spec["key_patch"].shape
+        for _ in range(GEN_PLACE_ATTEMPTS):
