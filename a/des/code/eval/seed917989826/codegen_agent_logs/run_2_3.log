+
+
+def _match_keys_to_locks(keys: list[dict], locks: list[dict]) -> list[tuple[int, int]]:
+    assert len(keys) == len(locks), "expected one key per lock"
+    candidates: list[list[tuple[int, int]]] = []
+    for key in keys:
