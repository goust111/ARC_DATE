+def _shape_library() -> list[np.ndarray]:
+    raw = [
+        ("111", "100", "110"),
+        ("111", "001", "011"),
+        ("111", "010", "110"),
+        ("111", "010", "011"),
+        ("1110", "0011", "0010"),
+        ("0111", "1100", "0100"),
