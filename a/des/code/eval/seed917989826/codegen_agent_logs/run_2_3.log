+
+
+def _marker_side_for_key(key_bbox: tuple[int, int, int, int], marker: tuple[int, int]) -> int:
+    r0, c0, r1, c1 = key_bbox
+    mr, mc = marker
+    if mr == r0 - 1 and c0 <= mc <= c1:
+        return 0
+    if mc == c1 + 1 and r0 <= mr <= r1:
+        return 1
+    if mr == r1 + 1 and c0 <= mc <= c1:
+        return 2
+    if mc == c0 - 1 and r0 <= mr <= r1:
