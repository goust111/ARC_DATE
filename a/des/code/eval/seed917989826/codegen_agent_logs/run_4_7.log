+
+def _edge_counts(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    assert len(coords) > 0
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    tight = mask[r0 : r1 + 1, c0 : c1 + 1]
+    return np.array(
