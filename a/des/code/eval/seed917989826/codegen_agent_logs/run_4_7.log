+
+    for i in range(n_rows - 1):
+        for j in range(n_cols):
+            if int(door_dirs[i, j]) == DOWN and int(door_dirs[i + 1, j]) == UP:
+                color = _pick_color({bg, WALL_COLOR, int(room_colors[i, j]), int(room_colors[i + 1, j])})
