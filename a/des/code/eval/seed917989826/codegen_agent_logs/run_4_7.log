+
+    rooms = []
+    for i in range(len(row_bands) - 1):
+        for j in range(len(col_bands) - 1):
+            r0 = row_bands[i][1]
+            r1 = row_bands[i + 1][0]
+            c0 = col_bands[j][1]
+            c1 = col_bands[j + 1][0]
+            rooms.append(
+                {
+                    "row": i,
+                    "col": j,
+                    "r0": r0,
+                    "r1": r1,
+                    "c0": c0,
