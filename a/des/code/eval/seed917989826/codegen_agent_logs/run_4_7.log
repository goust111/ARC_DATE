+
+    for i in range(n_rows):
+        for j in range(n_cols - 1):
+            if int(door_dirs[i, j]) == RIGHT and int(door_dirs[i, j + 1]) == LEFT:
+                color = _pick_color({bg, WALL_COLOR, int(room_colors[i, j]), int(room_colors[i, j + 1])})
