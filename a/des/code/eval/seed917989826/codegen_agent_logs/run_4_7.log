+        cap_dir = -1 if RNG.random() < 0.5 else 1
+        max_cap = stem_col + 1 if cap_dir == -1 else w - stem_col
+        cap_len = int(RNG.integers(1, min(3, max_cap) + 1))
+        if cap_dir == -1:
+            mask[0, stem_col - cap_len + 1 : stem_col + 1] = True
+        else:
