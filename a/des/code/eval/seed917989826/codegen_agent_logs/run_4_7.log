+import numpy as np
+
+
+UP, RIGHT, DOWN, LEFT = range(4)
+DIRS4 = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+
+WALL_COLOR = 5
+MAX_GRID_SIDE = 30
+MAX_PATTERN_ATTEMPTS = 200
+MAX_GENERATION_ATTEMPTS = 300
+RNG = np.random.default_rng()
