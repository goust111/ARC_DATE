+        counts = _edge_counts(mask)
+        if int(np.argmax(counts)) != DOWN:
+            continue
+        if int(np.count_nonzero(counts == counts.max())) != 1:
+            continue
+        if any(np.array_equal(mask, np.rot90(mask, k)) for k in (1, 2, 3)):
+            continue
+        return mask
