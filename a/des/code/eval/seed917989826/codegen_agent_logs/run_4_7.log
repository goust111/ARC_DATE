+        nub_count = int(RNG.integers(1, 4))
+        for _ in range(nub_count):
+            if h < 4:
+                break
+            row = int(RNG.integers(1, h - 1))
+            nub_dir = cap_dir if RNG.random() < 0.35 else -cap_dir
