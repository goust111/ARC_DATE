+        room_heights = [int(row_bands[i + 1][0] - row_bands[i][1]) for i in range(len(row_bands) - 1)]
+        room_widths = [int(col_bands[i + 1][0] - col_bands[i][1]) for i in range(len(col_bands) - 1)]
+        if not room_heights or not room_widths:
