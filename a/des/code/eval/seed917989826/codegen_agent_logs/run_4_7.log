+
+def _group_runs(indices: list[int]) -> list[tuple[int, int]]:
+    if not indices:
+        return []
+    runs: list[tuple[int, int]] = []
+    start = prev = indices[0]
+    for idx in indices[1:]:
+        if idx == prev + 1:
+            prev = idx
+            continue
+        runs.append((start, prev + 1))
+        start = prev = idx
+    runs.append((start, prev + 1))
+    return runs
+
