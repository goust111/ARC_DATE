+def _make_down_mask(room_size: int) -> np.ndarray:
+    max_dim = room_size - 2
+    for _ in range(MAX_PATTERN_ATTEMPTS):
+        h = int(RNG.integers(3, max_dim + 1))
+        w = int(RNG.integers(3, max_dim + 1))
+        mask = np.zeros((h, w), dtype=bool)
+        mask[-1, :] = True
+
+        stem_col = int(RNG.integers(1, w - 1))
+        mask[:, stem_col] = True
