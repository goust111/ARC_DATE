+            nub_len = int(RNG.integers(1, min(2, max_nub) + 1))
+            if nub_dir == -1:
+                mask[row, stem_col - nub_len : stem_col] = True
+            else:
+                mask[row, stem_col + 1 : stem_col + 1 + nub_len] = True
