+    r1, c1 = start
+    r2, c2 = end
+    horizontal: list[tuple[int, int]] = []
+    vertical: list[tuple[int, int]] = []
+
+    cur_r, cur_c = r1, c1
+    if c1 != c2:
+        step_c = 1 if c2 > c1 else -1
+        while cur_c != c2:
+            cur_c += step_c
+            cell = (cur_r, cur_c)
+            if cell not in blocked:
+                horizontal.append(cell)
+    if r1 != r2:
+        step_r = 1 if r2 > r1 else -1
+        while cur_r != r2:
+            cur_r += step_r
+            cell = (cur_r, cur_c)
+            if cell not in blocked:
+                vertical.append(cell)
+
+    return horizontal, vertical
