+            spec = {
+                "border_color": int(border_color),
+                "inner_h": int(inner_h),
+                "inner_w": int(inner_w),
+                "outer_h": int(inner_h + 2),
+                "outer_w": int(inner_w + 2),
+                "hole_cells": tuple(hole_cells),
+                "hole_key": hole_key,
