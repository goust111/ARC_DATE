+def _can_place_box(occupied: np.ndarray, top: int, left: int, h: int, w: int, pad: int = 1) -> bool:
+    H, W = occupied.shape
+    if top < 1 or left < 1 or top + h > H - 1 or left + w > W - 1:
+        return False
+    r0 = max(0, top - pad)
+    c0 = max(0, left - pad)
