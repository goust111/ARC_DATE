from collections import Counter
import random

import numpy as np


_DIR_SPECS = {
    "right": {
        "head": [(0, 3), (1, 4), (2, 3)],
        "arrow_bbox": (0, 0, 2, 4),
        "project_delta": (0, 6),
        "reserve_bbox": (0, 0, 2, 8),
    },
