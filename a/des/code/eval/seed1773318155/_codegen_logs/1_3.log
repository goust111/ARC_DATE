+def _draw_container(grid: np.ndarray, spec: dict) -> None:
+    top = int(spec["top"])
+    left = int(spec["left"])
+    inner_h = int(spec["inner_h"])
+    inner_w = int(spec["inner_w"])
+    outer_h = int(spec["outer_h"])
+    outer_w = int(spec["outer_w"])
