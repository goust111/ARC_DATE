+def _find_fragments(grid: np.ndarray, containers: list[dict]) -> list[dict]:
+    owner = np.full(grid.shape, -1, dtype=int)
+    for idx, container in enumerate(containers):
+        r0, c0, r1, c1 = container["bbox"]
+        owner[r0 + 1 : r1, c0 + 1 : c1] = int(idx)
