+RED = 2
+GREEN = 3
+ORANGE = 7
+INPUT_BORDER_COLORS = (1, 4, 5, 6, 8, 9)
+
+GRID_H_RANGE = (20, 30)
+GRID_W_RANGE = (20, 30)
+CONTAINER_COUNT_RANGE = (2, 4)
+INNER_H_RANGE = (4, 8)
+INNER_W_RANGE = (4, 8)
+HOLE_AREA_MIN = 3
+HOLE_AREA_CAP = 8
+SHAPE_ATTEMPTS = 120
