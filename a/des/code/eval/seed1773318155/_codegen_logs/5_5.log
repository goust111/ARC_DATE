+    for r in range(h):
+        for c in range(w):
+            if visited[r, c] or int(grid[r, c]) != color:
+                continue
+            queue = deque([(r, c)])
+            visited[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while queue:
+                cr, cc = queue.popleft()
+                cells.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and int(grid[nr, nc]) == color:
