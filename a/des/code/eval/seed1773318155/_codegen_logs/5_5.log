+        row = rows[0]
+        ordered = sorted(cells, key=lambda p: p[1])
+        expected = [(row, c) for c in range(ordered[0][1], ordered[-1][1] + 1)]
+        assert ordered == expected, "horizontal segment must be contiguous"
+        return ordered, "H"
+
+    if len(cols) == 1:
+        col = cols[0]
