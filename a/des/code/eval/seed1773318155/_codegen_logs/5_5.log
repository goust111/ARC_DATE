+def _extract_segments(
+    grid: np.ndarray, bg: int, start_marker: tuple[int, int], end_marker: tuple[int, int]
+) -> list[dict]:
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    blocked = {start_marker, end_marker}
+    segments: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if visited[r, c]:
+                continue
+            if (r, c) in blocked or int(grid[r, c]) == bg:
+                continue
