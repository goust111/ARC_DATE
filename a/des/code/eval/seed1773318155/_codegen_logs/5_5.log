+    fill one-cell gaps using the color of the earlier segment, and mark turn
+    interiors in orange.
+    """
+    g = np.asarray(grid, dtype=int)
+    info = _analyze_grid(g)
+    bg = info["bg"]
+    segments = info["segments"]
+    path = info["path"]
