+END_COLOR = 2
+TURN_COLOR = 7
+ALL_COLORS = tuple(range(10))
+INPUT_COLOR_POOL = tuple(c for c in ALL_COLORS if c not in (START_COLOR, END_COLOR, TURN_COLOR))
