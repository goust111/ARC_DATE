+
+def _gap_midpoint(a: tuple[int, int], b: tuple[int, int]) -> tuple[int, int]:
+    dr = abs(a[0] - b[0])
+    dc = abs(a[1] - b[1])
+    assert (dr == 2 and dc == 0) or (dr == 0 and dc == 2), "connected endpoints must be one gap apart"
+    return ((a[0] + b[0]) // 2, (a[1] + b[1]) // 2)
+
+
+def _endpoint_links(
