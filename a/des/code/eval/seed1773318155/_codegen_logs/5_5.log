+            color = int(grid[r, c])
+            queue = deque([(r, c)])
+            visited[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while queue:
+                cr, cc = queue.popleft()
+                cells.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if not (0 <= nr < h and 0 <= nc < w):
