+def _ordered_path(
+    segments: list[dict],
+    endpoint_links: dict[tuple[int, int], list[tuple[str, tuple[int, int] | None]]],
+    start_ref: tuple[int, int],
+    end_ref: tuple[int, int],
+) -> list[tuple[int, int]]:
