+                bits = 0
+                for r, c in pts:
+                    rr = top + int(r)
+                    cc = left + int(c)
+                    if not union_mask[rr, cc]:
+                        ok = False
+                        break
+                    bits |= 1 << (rr * frame_w + cc)
+                if ok and bits not in seen:
+                    seen.add(bits)
+                    candidates.append(bits)
+    return candidates
