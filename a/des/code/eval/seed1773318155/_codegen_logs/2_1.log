+) -> bool:
+    h, w = grid.shape
+    occupied = np.zeros((h, w), dtype=bool)
+    r0, c0, r1, c1 = frame_box
+    occupied[max(0, r0 - 1) : min(h, r1 + 2), max(0, c0 - 1) : min(w, c1 + 2)] = True
+    for mask, color in zip(sprite_masks, colors, strict=False):
+        sh, sw = mask.shape
