+def _infer_frame(grid: np.ndarray) -> tuple[int, tuple[int, int, int, int]]:
+    g = np.asarray(grid, dtype=int)
+    candidates = []
+    for color in map(int, np.unique(g)):
+        if color == BLACK:
+            continue
+        coords = np.argwhere(g == color)
+        if coords.size == 0:
+            continue
