+def _mask_to_bits(mask: np.ndarray, top: int, left: int, width: int) -> int:
+    bits = 0
+    for r, c in np.argwhere(mask):
+        idx = (top + int(r)) * width + left + int(c)
+        bits |= 1 << idx
+    return bits
+
