+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 5 or w < 5:
+            continue
+        patch = g[r0 : r1 + 1, c0 : c1 + 1]
+        if not np.all((patch == color) | (patch == BLACK)):
+            continue
+        if not np.all(patch[0, :] == color):
+            continue
+        if not np.all(patch[-1, :] == color):
+            continue
+        if not np.all(patch[:, 0] == color):
+            continue
+        if not np.all(patch[:, -1] == color):
+            continue
+        if not np.any(patch[1:-1, 1:-1] == BLACK):
