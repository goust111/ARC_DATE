+    seen = set()
+    for k in range(4):
+        rot = _trim(np.rot90(mask, k))
+        key = (tuple(map(int, rot.shape)), rot.tobytes())
+        if key not in seen:
+            seen.add(key)
+            out.append(rot)
+    return out
