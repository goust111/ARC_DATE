+        min_c = min(cs)
+        norm = sorted((r - min_r, c - min_c) for r, c in cells)
+        h = max(r for r, _ in norm) + 1
+        w = max(c for _, c in norm) + 1
+        if h < 2 or w < 2 or h > 5 or w > 5:
+            continue
+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in norm:
