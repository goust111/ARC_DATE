+        rot_k = ROT_CCW_BY_SIDE[str(wall["side"])]
+        rotated = np.rot90(piece["mask"], rot_k)
+        gap_mask = wall["gap_mask"]
+        assert rotated.shape == gap_mask.shape and np.array_equal(rotated, gap_mask)
