+    max_parts = min(4, len(interior_cells))
+    part_choices = [n for n in range(1, max_parts + 1) if n <= len(interior_cells)]
+    n_parts = random.choice(part_choices)
+    regions = _partition_cells(interior_cells, n_parts)
+    if regions is None:
+        return None
