+        max(patch.shape[0] for patch in piece_patches),
+        14,
+    )
+    left_need = sum((patch.shape[0] + 3) * (patch.shape[1] + 3) for patch in template_patches)
+    right_need = sum((patch.shape[0] + 2) * (patch.shape[1] + 2) for patch in piece_patches)
