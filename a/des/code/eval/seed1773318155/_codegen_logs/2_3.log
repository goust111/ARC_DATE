+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+YELLOW = 4
+MAGENTA = 6
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+PALETTE = (1, 2, 3, 5, 7, 8, 9)
+
+GEN_RETRIES = 400
+SHAPE_RETRIES = 120
+PARTITION_RETRIES = 120
+PLACEMENT_RETRIES = 40
