+    for _ in range(PLACEMENT_RETRIES):
+        h = random.randint(max_h, max_h + 8)
+        left_w_min = max(
+            max(patch.shape[1] for patch in template_patches) + 3,
+            int(np.ceil(left_need / max(1, h - 2))) + 2,
