+    for col in cols[1:]:
+        if col == end + 1:
+            end = col
+        else:
+            runs.append((start, end))
+            start = end = col
+    runs.append((start, end))
+    runs.sort(key=lambda item: (item[1] - item[0], item[0]), reverse=True)
+    return runs[0]
