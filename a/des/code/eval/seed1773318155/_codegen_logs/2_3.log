+        for patch, (r0, c0) in zip(piece_patches, right_pos, strict=True):
+            _paste(inp[:, left_w + 1 :], patch, r0, c0, transparent=BG)
+
+        return inp, out
+
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
