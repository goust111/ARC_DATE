+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(int(r), int(c))]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]] | set[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, transparent: int = BG) -> None:
+    h, w = patch.shape
+    sub = dst[r0 : r0 + h, c0 : c0 + w]
+    mask = patch != transparent
+    sub[mask] = patch[mask]
+    dst[r0 : r0 + h, c0 : c0 + w] = sub
+
+
+def _boundary_mask(shape: np.ndarray) -> np.ndarray:
+    h, w = shape.shape
+    border = np.zeros((h, w), dtype=bool)
+    for r, c in np.argwhere(shape):
+        rr = int(r)
+        cc = int(c)
+        for dr, dc in DIR4:
+            nr = rr + dr
+            nc = cc + dc
+            if not (0 <= nr < h and 0 <= nc < w) or not shape[nr, nc]:
+                border[rr, cc] = True
+                break
+    return border
+
+
+def _shape_interior(shape: np.ndarray) -> np.ndarray:
+    border = _boundary_mask(shape)
+    return shape & ~border
+
+
+def _enclosed_from_border(border: np.ndarray) -> np.ndarray:
+    h, w = border.shape
+    free = ~border
+    outside = np.zeros((h, w), dtype=bool)
+    stack: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in (0, w - 1):
+            if free[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                stack.append((int(r), int(c)))
+    for c in range(w):
+        for r in (0, h - 1):
+            if free[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                stack.append((int(r), int(c)))
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in DIR4:
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w and free[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                stack.append((nr, nc))
+    return free & ~outside
