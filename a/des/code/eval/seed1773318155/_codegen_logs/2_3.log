+    if not target_set:
+        return []
+    max_r = max(r for r, _ in piece_cells)
+    max_c = max(c for _, c in piece_cells)
+    rows = [r for r, _ in target_set]
+    cols = [c for _, c in target_set]
+    placements = []
+    for r0 in range(min(rows), max(rows) - max_r + 1):
