+def _canonical_solution(placements: list[tuple[tuple[int, int], ...]] | tuple[tuple[tuple[int, int], ...], ...]) -> tuple[tuple[tuple[int, int], ...], ...]:
+    return tuple(sorted(tuple(sorted(cells)) for cells in placements))
