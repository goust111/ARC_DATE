+    for br, bc in boundary_cells:
+        inward = []
+        for dr, dc in DIR4:
+            nr = br + dr
+            nc = bc + dc
+            if 0 <= nr < shape.shape[0] and 0 <= nc < shape.shape[1] and interior_mask[nr, nc]:
+                inward.append((nr, nc))
