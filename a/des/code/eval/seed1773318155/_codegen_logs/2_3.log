+    boundary = _boundary_mask(shape)
+    boundary_cells = [tuple(map(int, cell)) for cell in np.argwhere(boundary)]
+    cell_to_piece: dict[tuple[int, int], int] = {}
+    for idx, region in enumerate(regions):
