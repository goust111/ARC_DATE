+    for _ in range(30):
+        new = shape.copy()
+        side = random.choice("TBLR")
+        if side in "TB":
+            if w < 3 or h < 4:
+                continue
+            span = random.randint(1, max(1, min(3, w - 2)))
+            c0 = random.randint(1, w - span - 1)
+            depth = random.randint(1, min(3, h - 3))
+            if side == "T":
+                new[:depth, c0 : c0 + span] = False
+            else:
+                new[h - depth :, c0 : c0 + span] = False
+        else:
