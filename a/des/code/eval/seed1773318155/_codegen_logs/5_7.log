+    if not blank_abs:
+        return None
+
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "direction": direction,
+        "body_color": color,
+        "stripe_color": stripe_color,
+        "blank_abs": blank_abs,
+        "shape_key": _normalize(blank_abs)[0],
