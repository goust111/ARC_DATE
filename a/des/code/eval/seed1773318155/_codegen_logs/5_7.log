+
+
+def _build_container_tile(
+    bg: int,
+    direction: str,
+    outer_h: int,
+    outer_w: int,
+    body_color: int,
+    stripe_color: int,
+    blank_shape: list[tuple[int, int]],
+) -> tuple[np.ndarray, list[tuple[int, int]]]:
+    tile = np.full((outer_h, outer_w), bg, dtype=int)
+
