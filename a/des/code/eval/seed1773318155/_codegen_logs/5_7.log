+    max_w = max(obj["tile"].shape[1] for obj in objects) + 2
+    padded_area = sum((obj["tile"].shape[0] + 2) * (obj["tile"].shape[1] + 2) for obj in objects)
+    min_area = max(total_fg * 2 + 20, padded_area + 10)
