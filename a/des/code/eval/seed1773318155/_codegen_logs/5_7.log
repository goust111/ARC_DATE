+                stripe_colors[i],
+                blank_shape,
+            )
+            stamp_tile, stamp_rel = _render_stamp_tile(bg, blank_shape, turns[i])
+            built = (
+                {
+                    "kind": "container",
+                    "tile": container_tile,
+                    "blank_rel": blank_rel,
+                    "stripe_color": stripe_colors[i],
+                },
+                {
+                    "kind": "stamp",
+                    "tile": stamp_tile,
+                    "stamp_rel": stamp_rel,
+                },
+            )
+            used_shapes.add(canonical)
