+    candidates = []
+    for h in range(GRID_SIDE_MIN, GRID_SIDE_MAX + 1):
+        for w in range(GRID_SIDE_MIN, GRID_SIDE_MAX + 1):
+            if h < max_h or w < max_w:
+                continue
+            if h * w < min_area:
