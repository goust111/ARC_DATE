+) -> bool:
+    return a[2] + pad < b[0] or b[2] + pad < a[0] or a[3] + pad < b[1] or b[3] + pad < a[1]
+
+
+def _blank_canvas_shape(direction: str, outer_h: int, outer_w: int) -> tuple[int, int]:
+    if direction in ("up", "down"):
