+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIRECTIONS = ("up", "down", "left", "right")
+STAMP_COLOR = 5
+MAX_GENERATION_ATTEMPTS = 400
+GRID_SIDE_MIN = 22
+GRID_SIDE_MAX = 30
+PLACEMENT_MARGIN = 1
