+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while queue:
+                cr, cc = queue.popleft()
+                coords.append((cr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _normalize(coords: list[tuple[int, int]]) -> tuple[tuple[tuple[int, int], ...], int, int]:
+    r0, c0, r1, c1 = _bbox(coords)
+    norm = tuple(sorted((r - r0, c - c0) for r, c in coords))
+    return norm, r1 - r0 + 1, c1 - c0 + 1
+
+
+def _rotation_keys(coords: list[tuple[int, int]]) -> list[tuple[tuple[int, int], ...]]:
+    key, h, w = _normalize(coords)
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in key:
+        mask[r, c] = True
+
+    keys: list[tuple[tuple[int, int], ...]] = []
+    cur = mask
+    for _ in range(4):
+        pts = tuple(sorted(tuple(map(int, p)) for p in np.argwhere(cur)))
+        if pts not in keys:
+            keys.append(pts)
+        cur = np.rot90(cur)
+    return keys
+
