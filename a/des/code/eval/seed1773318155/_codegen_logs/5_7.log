+def _rect_separated(
+    a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = PLACEMENT_MARGIN
+) -> bool:
+    return a[2] + pad < b[0] or b[2] + pad < a[0] or a[3] + pad < b[1] or b[3] + pad < a[1]
