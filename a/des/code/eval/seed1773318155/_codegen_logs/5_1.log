+        r0, c0, r1, c1 = frame_bbox
+        seeds = [
+            (r, c)
+            for r in range(r0 + 1, r1)
+            for c in range(c0 + 1, c1)
+            if int(grid[r, c]) != bg
+        ]
+        assert seeds, "each frame must contain at least one seed"
+        layouts.append(
+            {
+                "bbox": frame_bbox,
+                "outer_color": outer_color,
+                "inner_color": inner_color,
+                "seeds": seeds,
+            }
+        )
+
+    return layouts
