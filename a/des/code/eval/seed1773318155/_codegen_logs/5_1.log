+def _components(mask: np.ndarray) -> list[list[Coord]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[Coord]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            queue = deque([(r, c)])
+            comp: list[Coord] = []
+            while queue:
+                cr, cc = queue.popleft()
+                comp.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[Coord]) -> BBox:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _is_frame(grid: np.ndarray, coords: list[Coord], color: int) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    if height < 3 or width < 3:
+        return False
+    if len(coords) != 2 * (height + width) - 4:
+        return False
+
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    perimeter = np.zeros((height, width), dtype=bool)
+    perimeter[0, :] = True
+    perimeter[-1, :] = True
+    perimeter[:, 0] = True
+    perimeter[:, -1] = True
+    if not np.all(sub[perimeter] == color):
+        return False
+    if np.any(sub[~perimeter] == color):
+        return False
+    return True
