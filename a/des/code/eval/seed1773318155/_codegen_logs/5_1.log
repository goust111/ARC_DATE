+
+    if r0 == r1 and abs(c0 - c1) == 1:
+        row = r0
+        lo, hi = sorted((c0, c1))
+        if lo == fc0 - 2 and hi == fc0 - 1 and fr0 <= row <= fr1:
+            return (row, fc0 - 1), (row, fc0 - 2)
+        if lo == fc1 + 1 and hi == fc1 + 2 and fr0 <= row <= fr1:
+            return (row, fc1 + 1), (row, fc1 + 2)
