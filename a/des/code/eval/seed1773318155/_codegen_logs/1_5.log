+def _component_adjacency_rows(seed_grid: np.ndarray) -> tuple[int, int]:
+    same_edges = 0
+    diff_edges = 0
+    rows, cols = seed_grid.shape
+    for r in range(rows):
+        for c in range(cols):
+            if r + 1 < rows:
