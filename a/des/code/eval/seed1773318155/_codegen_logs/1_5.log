+    diff_edges = 0
+    rows, cols = seed_grid.shape
+    for r in range(rows):
+        for c in range(cols):
+            if r + 1 < rows:
+                if int(seed_grid[r, c]) == int(seed_grid[r + 1, c]):
+                    same_edges += 1
+                else:
+                    diff_edges += 1
+            if c + 1 < cols:
