+def _color_components(adjacency: list[set[int]], rng: random.Random) -> list[int] | None:
+    n = len(adjacency)
+    colors = [-1] * n
+    palette = [0, 1, 2, 3]
+
+    def choose_node() -> int | None:
+        best = None
+        best_key = None
+        for node in range(n):
+            if colors[node] != -1:
+                continue
+            used = {colors[other] for other in adjacency[node] if colors[other] != -1}
+            key = (len(used), len(adjacency[node]))
+            if best is None or key > best_key:
+                best = node
+                best_key = key
+        return best
+
+    def backtrack() -> bool:
+        node = choose_node()
+        if node is None:
+            return True
+        used = {colors[other] for other in adjacency[node] if colors[other] != -1}
+        options = [color for color in rng.sample(palette, len(palette)) if color not in used]
+        for color in options:
+            colors[node] = color
+            if backtrack():
+                return True
+        colors[node] = -1
+        return False
+
+    if backtrack():
+        return colors
+    return None
+
