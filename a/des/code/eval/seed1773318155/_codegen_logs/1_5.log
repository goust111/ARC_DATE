+
+
+def _build_partition(rows: int, cols: int, mode: str, rng: random.Random) -> list[set[tuple[int, int]]] | None:
+    area = rows * cols
+    components: list[set[tuple[int, int]]] = []
+    blocked: set[tuple[int, int]] = set()
+
+    if mode == "mix":
