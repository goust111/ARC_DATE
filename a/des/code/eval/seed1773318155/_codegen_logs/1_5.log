+
+BG = 0
+WALL = 9
+MERGE_FILL = 5
+PATTERN_COLORS = (1, 2, 3, 4, 6, 7, 8)
+GEN_RETRIES = 300
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+BASE_SHAPES = [
+    np.array(
