+    edge_colors = list(edge_map.values())
+    assert len(set(edge_colors)) == 4, "outer edge markers must be four distinct colors"
+
+    return {
+        "grid": g,
+        "bg": int(bg),
+        "grey": int(grey),
+        "core_bbox": core["bbox"],
+        "core_color": int(core_color),
+        "rings": rings,
+        "marker_colors": marker_colors,
+        "edge_map": edge_map,
+        "edge_pos": edge_pos,
+    }
