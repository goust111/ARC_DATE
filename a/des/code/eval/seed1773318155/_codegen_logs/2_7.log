+
+def _ring_info(grid: np.ndarray, coords: np.ndarray) -> dict:
+    bbox = _bbox(coords)
+    r0, c0, r1, c1 = bbox
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    sub = np.zeros((height, width), dtype=bool)
+    sub[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    border = _border_mask(height, width)
+    is_solid = bool(np.all(sub))
+    is_ring = bool(np.array_equal(sub, border))
+    return {
+        "coords": coords,
+        "bbox": bbox,
