+    if corner == "tr":
+        return r0, c1
+    if corner == "bl":
+        return r1, c0
+    if corner == "br":
+        return r1, c1
+    raise ValueError(corner)
+
+
+def _midpoints(bbox: tuple[int, int, int, int]) -> dict[str, tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    assert (r1 - r0 + 1) % 2 == 1 and (c1 - c0 + 1) % 2 == 1
+    rm = (r0 + r1) // 2
+    cm = (c0 + c1) // 2
+    return {
+        "top": (r0, cm),
+        "bottom": (r1, cm),
+        "left": (rm, c0),
+        "right": (rm, c1),
+    }
