+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+DIR_ORDER = ("top", "bottom", "left", "right")
+CORNERS = ("tl", "tr", "bl", "br")
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_RETRIES = 400
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.asarray(coords, dtype=int))
+    return out
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _border_mask(height: int, width: int) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _border_positions(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    pts: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        pts.append((r0, c))
+        if r1 != r0:
+            pts.append((r1, c))
+    for r in range(r0 + 1, r1):
+        pts.append((r, c0))
+        if c1 != c0:
+            pts.append((r, c1))
+    return pts
+
+
+def _set_border(grid: np.ndarray, bbox: tuple[int, int, int, int], color: int) -> None:
+    for r, c in _border_positions(bbox):
+        grid[r, c] = int(color)
+
+
+def _corner_coord(bbox: tuple[int, int, int, int], corner: str) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    if corner == "tl":
+        return r0, c0
+    if corner == "tr":
+        return r0, c1
+    if corner == "bl":
+        return r1, c0
+    if corner == "br":
+        return r1, c1
+    raise ValueError(corner)
+
+
+def _midpoints(bbox: tuple[int, int, int, int]) -> dict[str, tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    assert (r1 - r0 + 1) % 2 == 1 and (c1 - c0 + 1) % 2 == 1
+    rm = (r0 + r1) // 2
+    cm = (c0 + c1) // 2
+    return {
