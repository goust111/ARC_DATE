            for j, other in enumerate(comps)
            if j != idx and other["area"] > 1 and (r - 1, c) in other["coord_set"]
        ]
        if len(matches) == 1:
            labels.append({"label_idx": idx, "shape_idx": matches[0], "color": comp["color"]})

