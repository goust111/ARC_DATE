import random
from typing import Iterable

import numpy as np


DIVIDER_COLOR = 1
ARROW_COLOR = 2
PLACEHOLDER_COLOR = 5
FREE_COLORS = [0, 3, 4, 6, 7, 8, 9]
DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
