+    if r1 - r0 != 2 or c1 - c0 != 2:
+        return None
+    if not (c0 == 0 or c1 == width):
+        return None
+    rel = [(int(r - r0), int(c - c0)) for r, c in coords]
+    col_counts = {}
+    for _r, c in rel:
+        col_counts[c] = col_counts.get(c, 0) + 1
