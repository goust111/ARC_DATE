+        elif direction == "right":
+            offset_r = int(r + (h - rh) // 2)
+            offset_c = int(c + w)
+        elif direction == "up":
+            offset_r = int(r - rh)
+            offset_c = int(c + (w - rw) // 2)
+        else:
+            offset_r = int(r + h)
+            offset_c = int(c + (w - rw) // 2)
