+    ud = bool(np.array_equal(content, np.flipud(content)))
+    rot = bool(np.array_equal(content, np.rot90(content, 2)))
+    active = [name for name, flag in ((TYPE_LR, lr), (TYPE_UD, ud), (TYPE_ROT, rot)) if flag]
+    assert len(active) <= 1, "content symmetry must be unique"
+    return active[0] if active else TYPE_ASYM
