+        else:
+            mirrored = np.flipud(content)
+            offset_r = int(r - h) if direction == "up" else int(r + h)
+            offset_c = int(c)
+        items.append((mirrored, offset_r, offset_c))
+        return items
+    if kind == TYPE_ROT:
+        rotated = np.rot90(content, -1)
+        rh, rw = map(int, rotated.shape)
+        if direction == "left":
+            offset_r = int(r + (h - rh) // 2)
