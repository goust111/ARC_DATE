+def _gen_attempt() -> np.ndarray | None:
+    global _EXTRA_TYPE_INDEX
+    rng = random.Random()
+    h = rng.randint(26, 32)
+    w = rng.randint(26, 32)
+    bg = rng.randrange(10)
+    types = [TYPE_LR, TYPE_UD, TYPE_ROT, TYPE_ASYM]
+    if rng.random() < 0.5:
+        extra = OPTIONAL_EXTRA_TYPES[_EXTRA_TYPE_INDEX % len(OPTIONAL_EXTRA_TYPES)]
+        _EXTRA_TYPE_INDEX += 1
+        types.append(extra)
