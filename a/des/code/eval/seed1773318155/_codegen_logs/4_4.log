+    if direction == "up":
+        return [(-2, dc) for dc in range(w)]
+    if direction == "down":
+        return [(h + 1, dc) for dc in range(w)]
+    if direction == "left":
+        return [(dr, -2) for dr in range(h)]
+    if direction == "right":
+        return [(dr, w + 1) for dr in range(h)]
+    raise AssertionError(f"unknown direction: {direction}")
