+    max_r = max(rr for rr, _ in offsets)
+    min_c = min(cc for _, cc in offsets)
+    max_c = max(cc for _, cc in offsets)
+    row_lo = int(-min_r)
+    row_hi = int(h - 1 - max_r)
+    col_lo = int(-min_c)
+    col_hi = int(w - 1 - max_c)
