+                            "marker_color": marker_color,
+                            "direction": direction,
+                            "outer_bbox": (int(r0), int(c0), int(r1), int(c1)),
+                            "marker": (int(marker_r), int(marker_c)),
+                            "content_r": int(r0 + 1),
