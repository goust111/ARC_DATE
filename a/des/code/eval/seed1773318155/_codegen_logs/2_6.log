+import random
+from collections import deque
+
+import numpy as np
+
+
+DIR_VECS = {
+    "N": (-1, 0),
+    "S": (1, 0),
+    "W": (0, -1),
+    "E": (0, 1),
+}
+OPPOSITE = {
+    "N": "S",
+    "S": "N",
+    "W": "E",
+    "E": "W",
+}
+
+BG_COLORS = (0, 5)
+OBJECT_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+GRID_H_RANGE = (22, 31)
+GRID_W_RANGE = (22, 31)
+PAIR_COUNT_RANGE = (2, 4)
+CORE_SHORT_RANGE = (3, 5)
+CORE_LONG_RANGE = (3, 7)
+GAP_RANGE = (4, 10)
+MARGIN = 1
+GEN_ATTEMPTS = 400
+PAIR_PLACE_ATTEMPTS = 120
