+        for r, c in coords:
+            rr = int(r - r0)
+            cc = int(c - c0)
+            submask[rr, cc] = True
+            rel_coords.append((rr, cc))
+        direction, protrusion_rel, indent_rel = _decode_object(submask)
+        objects.append(
