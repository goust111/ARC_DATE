+            return None
+        dist = int(tc - sc)
+    elif direction == "W":
+        if sr != tr:
+            return None
+        dist = int(sc - tc)
+    elif direction == "S":
+        if sc != tc:
+            return None
+        dist = int(tr - sr)
+    else:
+        if sc != tc:
