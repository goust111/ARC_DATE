+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(GRID_H_RANGE[0], GRID_H_RANGE[1] - 1)
+    w = random.randint(GRID_W_RANGE[0], GRID_W_RANGE[1] - 1)
