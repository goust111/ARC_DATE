+    pairs: list[tuple[int, int, int]] = []
+    for dist, src_idx, tgt_idx in edges:
+        if src_idx in used or tgt_idx in used:
+            continue
+        used.add(src_idx)
+        used.add(tgt_idx)
+        pairs.append((src_idx, tgt_idx, dist))
+    return pairs
