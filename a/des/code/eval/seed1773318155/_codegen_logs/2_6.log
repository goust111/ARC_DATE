+def _checkerboard(shape: tuple[int, int], even_color: int, odd_color: int) -> np.ndarray:
+    h, w = shape
+    rr, cc = np.indices((h, w))
+    return np.where(((rr + cc) & 1) == 0, int(even_color), int(odd_color)).astype(int)
