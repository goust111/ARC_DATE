    walkable = np.zeros_like(g, dtype=bool)
    walkable[LEGEND_ROWS:, :] = g[LEGEND_ROWS:, :] != GREY

    seeds = np.argwhere((g[LEGEND_ROWS:, :] != BLACK) & (g[LEGEND_ROWS:, :] != GREY))
    seen_cells: set[tuple[int, int]] = set()

    for sr0, sc in seeds:
