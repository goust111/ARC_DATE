+    h, w = walkable.shape
+    q = deque([start])
+    seen = {start}
+    comp = [start]
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and walkable[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+                comp.append((nr, nc))
