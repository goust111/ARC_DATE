            continue

        seed = _pick_seed(rng, placed_cells, direction)
        if seed is None:
            continue

        for r, c in placed_shell:
            grid[r, c] = GREY
        grid[seed] = color
        for r, c in padded:
            blocked[r, c] = True

        return {
            "cells": placed_cells,
            "seed": seed,
            "color": color,

