+        positions.add((height - patch_h, int(c)))
+    for r in range(height - patch_h + 1):
+        positions.add((int(r), 0))
+        positions.add((int(r), width - patch_w))
+    positions_list = list(positions)
+    random.shuffle(positions_list)
