+def _paste(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int) -> None:
+    patch_h, patch_w = map(int, patch.shape)
+    region = grid[r0 : r0 + patch_h, c0 : c0 + patch_w]
+    mask = patch != int(bg)
+    region[mask] = patch[mask]
