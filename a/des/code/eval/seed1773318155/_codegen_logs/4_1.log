+                    "inner_r0": int(r0 + 1),
+                    "inner_c0": int(c0 + 1),
+                    "inner_h": int(inner_h),
+                    "inner_w": int(inner_w),
+                    "signature": tuple(map(int, signature)),
+                    "sprite_patch": sprite["patch"],
