+
+def _neighbors(r: int, c: int, height: int, width: int, connectivity: int):
+    deltas4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    deltas8 = deltas4 + [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+    deltas = deltas4 if connectivity == 4 else deltas8
+    for dr, dc in deltas:
+        nr = int(r + dr)
+        nc = int(c + dc)
+        if 0 <= nr < height and 0 <= nc < width:
+            yield nr, nc
