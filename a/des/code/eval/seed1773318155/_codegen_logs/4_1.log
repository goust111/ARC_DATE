+
+    grid = np.full((height, width), int(bg), dtype=int)
+    occupied = np.zeros((height, width), dtype=bool)
+
+    order = list(range(n_sprites))
+    order.sort(
+        key=lambda idx: int(np.count_nonzero(sprite_specs[idx]["patch"] != int(bg))),
+        reverse=True,
