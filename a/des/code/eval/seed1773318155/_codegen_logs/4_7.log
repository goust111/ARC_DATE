+CELL_WIDTH_RANGE = (4, 7)
+GRID_HEIGHT_MAX = 24
+GRID_WIDTH_MAX = 24
+MAX_NONEMPTY_REGIONS = 6
+MARKER_COUNT_CHOICES = (1, 1, 2, 2, 3)
