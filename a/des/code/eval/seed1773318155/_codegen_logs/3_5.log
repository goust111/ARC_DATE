+def _flip_pattern(pattern: dict, inner_shape: tuple[int, int], axis: str) -> dict:
+    h, w = inner_shape
+    if axis == "horizontal":
+        rel = {(r, w - 1 - c) for r, c in pattern["coords"]}
+    else:
+        rel = {(h - 1 - r, c) for r, c in pattern["coords"]}
+    return {"color": pattern["color"], "coords": rel}
