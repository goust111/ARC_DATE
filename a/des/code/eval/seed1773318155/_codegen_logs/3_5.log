+BG = 0
+FRAME = 5
+ARROW_COLOR_ORDER = [1, 2, 3, 4, 7, 9]  # blue, red, green, yellow, orange, maroon
+PATTERN_COLORS = [6, 8]
+SIDES_BY_AXIS = {
+    "horizontal": ("left", "right"),
+    "vertical": ("up", "down"),
+}
