            placed.append((best_direction, a, b))
            if search(next_remaining):
                return True
            placed.pop()
            free_cells.add(a)
            free_cells.add(b)
        return False

    if search(list(directions)):
        return placed
    return None


def _seed_position(cell: tuple[int, int]) -> tuple[int, int]:
    cell_r, cell_c = cell
