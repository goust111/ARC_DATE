+def _transform_path(
+    path: list[tuple[int, int]],
+    rows: int,
+    cols: int,
+    flip_v: bool,
+    flip_h: bool,
+) -> list[tuple[int, int]]:
+    out = []
+    for r, c in path:
+        nr = rows - 1 - r if flip_v else r
+        nc = cols - 1 - c if flip_h else c
+        out.append((nr, nc))
+    return out
+
+
+def _door_from_step(a: tuple[int, int], b: tuple[int, int]) -> str:
+    ar, ac = a
+    br, bc = b
+    if br == ar and bc == ac + 1:
+        return "right"
+    if br == ar and bc == ac - 1:
+        return "left"
+    if bc == ac and br == ar + 1:
+        return "down"
+    return "up"
