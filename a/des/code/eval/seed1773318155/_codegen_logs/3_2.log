+def _room_positions(
+    row_heights: list[int],
+    col_widths: list[int],
+    gap_y: int,
+    gap_x: int,
+    top: int,
+    left: int,
+) -> dict[tuple[int, int], tuple[int, int, int, int]]:
+    boxes = {}
+    y = top
+    for r, inner_h in enumerate(row_heights):
+        x = left
+        for c, inner_w in enumerate(col_widths):
+            boxes[(r, c)] = (y, y + inner_h + 1, x, x + inner_w + 1)
+            x += inner_w + 2 + gap_x
+        y += inner_h + 2 + gap_y
