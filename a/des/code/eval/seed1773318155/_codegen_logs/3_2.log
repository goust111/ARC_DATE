+BG = 0
+RED = 2
+WALL = 5
+STRIPE_PALETTE = [1, 3, 4, 6, 7, 8, 9]
+
+MAX_GRID_H = 30
+MAX_GRID_W = 30
+MAX_ROOM_INNER = 4
+GEN_RETRIES = 400
+
+DIM_OPTIONS = [
+    (1, 2),
+    (1, 3),
+    (1, 4),
+    (1, 5),
+    (1, 6),
+    (1, 7),
+    (2, 1),
+    (3, 1),
+    (4, 1),
+    (5, 1),
+    (6, 1),
+    (7, 1),
+    (2, 2),
+    (2, 3),
