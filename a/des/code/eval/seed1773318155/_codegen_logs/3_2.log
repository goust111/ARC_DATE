+        for c in cols_iter:
+            path.append((r, c))
+    return path
+
+
+def _col_snake(rows: int, cols: int) -> list[tuple[int, int]]:
+    path = []
+    for c in range(cols):
+        rows_iter = range(rows) if c % 2 == 0 else range(rows - 1, -1, -1)
+        for r in rows_iter:
+            path.append((r, c))
+    return path
+
+
+def _transform_path(
+    path: list[tuple[int, int]],
+    rows: int,
+    cols: int,
+    flip_v: bool,
+    flip_h: bool,
+) -> list[tuple[int, int]]:
+    out = []
+    for r, c in path:
+        nr = rows - 1 - r if flip_v else r
+        nc = cols - 1 - c if flip_h else c
+        out.append((nr, nc))
+    return out
+
+
+def _door_from_step(a: tuple[int, int], b: tuple[int, int]) -> str:
+    ar, ac = a
+    br, bc = b
+    if br == ar and bc == ac + 1:
+        return "right"
+    if br == ar and bc == ac - 1:
+        return "left"
+    if bc == ac and br == ar + 1:
