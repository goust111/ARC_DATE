+            c += length
+    else:
+        lengths = _segment_lengths(rng, grid.shape[0], len(colors))
+        col = 0 if side == "left" else grid.shape[1] - 1
+        r = 0
+        for color, length in zip(colors, lengths):
+            grid[r : r + length, col] = int(color)
+            r += length
