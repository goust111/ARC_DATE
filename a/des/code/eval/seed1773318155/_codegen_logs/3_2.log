+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+WALL = 5
+STRIPE_PALETTE = [1, 3, 4, 6, 7, 8, 9]
+
+MAX_GRID_H = 30
+MAX_GRID_W = 30
+MAX_ROOM_INNER = 4
+GEN_RETRIES = 400
+
+DIM_OPTIONS = [
+    (1, 2),
+    (1, 3),
+    (1, 4),
+    (1, 5),
+    (1, 6),
+    (1, 7),
+    (2, 1),
+    (3, 1),
+    (4, 1),
+    (5, 1),
+    (6, 1),
+    (7, 1),
+    (2, 2),
+    (2, 3),
+    (3, 2),
+]
+DIM_WEIGHTS = [1] * 12 + [3, 3, 3]
+SIDES = ("up", "down", "left", "right")
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _read_stripe(grid: np.ndarray) -> list[int]:
+    candidates = [
+        ("top", grid[0, :]),
+        ("bottom", grid[-1, :]),
+        ("left", grid[:, 0]),
+        ("right", grid[:, -1]),
+    ]
+    best_line = None
+    best_score = -1
+    for _name, line in candidates:
+        score = int(sum(int(v) not in (BG, RED, WALL) for v in line))
+        if score > best_score:
+            best_score = score
+            best_line = line
+    if best_line is None or best_score <= 0:
+        return []
+
+    colors: list[int] = []
+    prev = None
+    for value in map(int, best_line):
+        if value == prev:
+            continue
+        prev = value
+        if value not in (BG, RED, WALL):
+            colors.append(value)
+    return colors
+
+
+def _room_from_component(grid: np.ndarray, comp: list[tuple[int, int]]):
+    rs = [r for r, _ in comp]
+    cs = [c for _, c in comp]
+    r0, r1 = min(rs), max(rs)
+    c0, c1 = min(cs), max(cs)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return None
+
+    border = {
+        (r, c)
+        for r in range(r0, r1 + 1)
+        for c in range(c0, c1 + 1)
+        if r in (r0, r1) or c in (c0, c1)
+    }
+    cells = set(comp)
+    if not cells.issubset(border):
+        return None
+    missing = list(border - cells)
+    if len(missing) != 1:
+        return None
+    gap_r, gap_c = missing[0]
+    if (gap_r in (r0, r1)) and (gap_c in (c0, c1)):
+        return None
+
+    if gap_r == r0:
+        door = "up"
+    elif gap_r == r1:
+        door = "down"
+    elif gap_c == c0:
+        door = "left"
+    else:
+        door = "right"
+
+    inner = grid[r0 + 1 : r1, c0 + 1 : c1]
+    has_red = bool((inner == RED).any())
+    return {
+        "bbox": (r0, r1, c0, c1),
+        "door": door,
+        "has_red": has_red,
+    }
+
+
+def _find_rooms(grid: np.ndarray) -> list[dict]:
+    rooms = []
+    for comp in _components(grid == WALL):
+        room = _room_from_component(grid, comp)
+        if room is not None:
+            rooms.append(room)
+    return rooms
+
+
+def _interval_overlap(a0: int, a1: int, b0: int, b1: int) -> int:
+    return max(0, min(a1, b1) - max(a0, b0) + 1)
+
+
+def _next_room_index(rooms: list[dict], idx: int):
+    r0, r1, c0, c1 = rooms[idx]["bbox"]
+    door = rooms[idx]["door"]
+    best = None
+    best_key = None
+    for j, other in enumerate(rooms):
+        if j == idx:
+            continue
+        or0, or1, oc0, oc1 = other["bbox"]
+        if door == "right":
+            gap = oc0 - c1
+            align = _interval_overlap(r0 + 1, r1 - 1, or0 + 1, or1 - 1)
+        elif door == "left":
+            gap = c0 - oc1
+            align = _interval_overlap(r0 + 1, r1 - 1, or0 + 1, or1 - 1)
+        elif door == "down":
+            gap = or0 - r1
+            align = _interval_overlap(c0 + 1, c1 - 1, oc0 + 1, oc1 - 1)
+        else:
+            gap = r0 - or1
+            align = _interval_overlap(c0 + 1, c1 - 1, oc0 + 1, oc1 - 1)
+        if gap <= 0 or align <= 0:
+            continue
+        key = (gap, -align, or0, oc0)
+        if best_key is None or key < best_key:
