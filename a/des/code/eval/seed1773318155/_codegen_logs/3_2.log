+    if door in ("up", "down"):
+        gap_c = rng.randint(c0 + 1, c1 - 1)
+        gap_r = r0 if door == "up" else r1
+    else:
+        gap_r = rng.randint(r0 + 1, r1 - 1)
+        gap_c = c0 if door == "left" else c1
+    grid[gap_r, gap_c] = BG
