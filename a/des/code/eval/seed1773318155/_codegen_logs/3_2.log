def _corner_config(corner_kind, h, w, rng):
    """Return (seed_rc, first_line_rc) for corner_kind in {TL,TR,BL,BR}."""
    if corner_kind == 'TL':
        seed = (0, 0)
        first = rng.choice([(0, 1), (1, 0)])
    elif corner_kind == 'TR':
        seed = (0, w - 1)
