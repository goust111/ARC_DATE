+
+def _outer_sides(cell: tuple[int, int], rows: int, cols: int) -> list[str]:
+    r, c = cell
+    sides = []
+    if r == 0:
+        sides.append("up")
+    if r == rows - 1:
+        sides.append("down")
+    if c == 0:
+        sides.append("left")
+    if c == cols - 1:
+        sides.append("right")
+    return sides
