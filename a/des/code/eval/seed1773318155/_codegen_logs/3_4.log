 166: def _is_rot_asym(mask: np.ndarray) -> bool:
 167:     """True if mask is not invariant under any 90/180/270 rotation."""
 168:     return all(not np.array_equal(mask, np.rot90(mask, k)) for k in (1, 2, 3))
 169: 
