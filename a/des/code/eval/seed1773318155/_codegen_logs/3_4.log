 156: def _rot_orbit(r: int, c: int, n: int) -> set[tuple[int, int]]:
 157:     """Return the 4 positions in the 90-degree rotation orbit of (r, c) in an n*n grid."""
 158:     pts = set()
 159:     rr, cc = r, c
 160:     for _ in range(4):
 161:         pts.add((rr, cc))
 162:         rr, cc = n - 1 - cc, rr
 163:     return pts
