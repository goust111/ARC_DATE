+                "bbox": (r0, c0, r1, c1),
+                "marker_cells": markers,
+                "steps": len(markers),
+                "clockwise": side in {"top", "right"},
+                "obj_local": obj_local,
+                "obj_colors": colors,
+                "inner_h": inner.shape[0],
+                "inner_w": inner.shape[1],
