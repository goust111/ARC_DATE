 171: def _checker_perimeter(n: int, phase: int) -> np.ndarray:
 172:     """Checkerboard pattern restricted to the perimeter of an n*n grid."""
 173:     rr, cc = np.indices((n, n))
 174:     perim = (rr == 0) | (rr == n - 1) | (cc == 0) | (cc == n - 1)
 175:     return perim & (((rr + cc + phase) % 2) == 0)
 176: 
