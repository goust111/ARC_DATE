 178: def _band_cells(n: int, width: int) -> list[tuple[int, int]]:
 179:     """All (r, c) within `width` rows/cols of any edge in an n*n grid."""
 180:     rr, cc = np.indices((n, n))
 181:     inside = np.minimum(np.minimum(rr, cc), np.minimum(n - 1 - rr, n - 1 - cc)) < width
 182:     coords = np.argwhere(inside)
 183:     return [(int(r), int(c)) for r, c in coords]
