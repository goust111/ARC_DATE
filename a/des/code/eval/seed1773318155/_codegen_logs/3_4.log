  82: def main(grid: np.ndarray) -> np.ndarray:
  83:     """
  84:     Crop a board cluster and rotate its color layers based on outside cue sprites.
  85: 
  86:     Input structure:
  87:     - bg = most common color.
  88:     - A main multi-color board cluster (largest foreground region).
  89:     - Small monochrome cue sprites outside the board for the colors that rotate.
  90: 
  91:     Rule:
  92:     - Tight-crop around the board cluster.
  93:     - For each color layer inside the crop, find its same-color cue outside.
  94:     - Rotate that layer clockwise by (cue pixel count mod 4) × 90°.
  95:     - No outside cue → no rotation.
  96: 
  97:     Key insight: Cue sprite size mod 4 encodes rotation amount for its matching color layer.
  98:     """
  99:     g = np.array(grid, dtype=int)
 100:     bg = int(get_bg(g))
 101: 
 102:     # --- STEP 1) Crop the "board" cluster (drop distant sample sprites) ---
 103:     crop, (r0, c0, r1, c1), bg = crop_components_near_largest(g, bg=bg, margin=3, connectivity=8)
 104: 
 105:     # --- STEP 2) For each layer, rotate according to its unique outside cue size ---
 106:     colors = colors_present(crop, exclude={int(bg)})
 107:     assert colors, "expected the cropped board to contain foreground colors"
 108:     out = crop.copy()
 109: 
 110:     outside_grid = g.copy()
 111:     outside_grid[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = int(bg)
 112: 
 113:     for col in colors:
 114:         outside_comps = find_components(
 115:             outside_grid,
 116:             bg=int(bg),
 117:             connectivity=8,
 118:             monochromatic=True,
 119:             colors=[int(col)],
 120:             return_format="dict",
 121:         )
 122:         assert len(outside_comps) <= 1, f"expected at most one outside cue for color {col}"
 123:         cue_size = int(outside_comps[0]["area"]) if outside_comps else 0
 124:         rot_k = (-cue_size) % 4
 125:         if rot_k:
 126:             out = rotate_color_layer(out, int(col), int(rot_k), bg=int(bg))
 127: 
 128:     return out
