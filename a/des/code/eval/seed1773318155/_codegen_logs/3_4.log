 186: def _fill_to_count(mask: np.ndarray, candidates: list[tuple[int, int]], target: int) -> bool:
 187:     """Randomly set cells in mask until it reaches target count. Returns success."""
 188:     random.shuffle(candidates)
 189:     for r, c in candidates:
