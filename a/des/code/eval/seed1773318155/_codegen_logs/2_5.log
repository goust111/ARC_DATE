+BG = 0
+WALL = 1
+STAMP = 2
+SEP = 3
+
+LIB_WIDTH = 2
+LIB_GAP = 1
+SIDE_PRIORITY = ("up", "left", "right", "down")
+
+GEN_ROWS_RANGE = (15, 24)
+GEN_COLS_RANGE = (18, 28)
+GEN_ROOM_COUNTS = (1, 2, 3)
