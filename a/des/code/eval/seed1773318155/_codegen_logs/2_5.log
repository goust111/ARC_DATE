+def _normalize(coords: np.ndarray) -> np.ndarray:
+    arr = np.asarray(coords, dtype=int)
+    if arr.size == 0:
+        raise AssertionError("empty symbol")
+    return arr - arr.min(axis=0, keepdims=True)
