+def _rotate_coords(coords: np.ndarray, turns: int) -> np.ndarray:
+    out = _normalize(coords)
+    for _ in range(int(turns) % 4):
+        height = int(out[:, 0].max()) + 1
+        out = np.column_stack((out[:, 1], height - 1 - out[:, 0]))
+        out = _normalize(out)
+    return out
+
