+def _rotate_to_face(coords: np.ndarray, target_side: str) -> np.ndarray:
+    base = _normalize(coords)
+    if base.shape[0] == 1:
+        return base
+    for turns in range(4):
+        rotated = _rotate_coords(base, turns)
+        if target_side in _facing_sides(rotated):
