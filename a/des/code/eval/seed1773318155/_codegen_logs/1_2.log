+    out = g.copy()
+    for arrow in arrows:
+        dr, dc = _DIR_SPECS[arrow["direction"]]["project_delta"]
+        r0 = int(arrow["body_r"] + dr)
+        c0 = int(arrow["body_c"] + dc)
+        patch = patterns[arrow["body_color"]]
+        assert 0 <= r0 and r0 + 3 <= h and 0 <= c0 and c0 + 3 <= w
