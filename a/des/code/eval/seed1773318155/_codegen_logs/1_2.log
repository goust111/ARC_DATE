+    arrows: list[dict] = []
+
+    for r in range(h - 2):
+        for c in range(w - 2):
+            if bool(used[r : r + 3, c : c + 3].any()):
+                continue
+            body_color = int(g[r, c])
+            if body_color == int(bg):
