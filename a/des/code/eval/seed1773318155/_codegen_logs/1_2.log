+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Detect color-paired arrows and project the matched 3x3 pattern in the arrow's facing direction.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
+    bg = _get_bg(g)
