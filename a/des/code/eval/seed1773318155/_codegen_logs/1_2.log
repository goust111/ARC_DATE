+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_GENERATION_ATTEMPTS):
+        try:
+            inp, expected = _build_scene()
+        except RuntimeError:
+            continue
+        try:
+            actual = main(inp)
+        except Exception:
+            continue
+        if np.array_equal(actual, expected):
+            return inp
+    raise RuntimeError("failed to generate a valid input")

