+    arrows = _detect_arrows(g, bg)
+    arrow_mask = np.zeros((h, w), dtype=bool)
+    for arrow in arrows:
+        for rr, cc in arrow["cells"]:
+            arrow_mask[int(rr), int(cc)] = True
