+_GEN_BG = 0
+_GEN_ANCHOR_COLORS = [1, 2, 3]  # blue, red, green; alphabetical rank is handled by name lookup.
+_GEN_BODY_COLORS = [4, 5, 6, 7, 8, 9]
+_GEN_GRID_H_RANGE = (16, 22)
