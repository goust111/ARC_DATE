+        "h": h,
+        "w": w,
+        "fragments": [
+            {
+                "offset": (0, 0),
+                "cells": coords,
+                "body_color": int(body_color),
+                "anchor_color": int(anchor_color),
+                "candidates": candidates,
+            }
