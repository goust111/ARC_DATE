+    for entity in placed_entities:
+        rr0, cc0, rr1, cc1 = entity["reserve_box"]
+        final_reserved[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+        top = entity["top"]
+        left = entity["left"]
