+from __future__ import annotations
+
+from collections import defaultdict, deque
+import random
+
+import numpy as np
+
+
+_DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+_ARC_COLOR_NAMES = {
+    0: "black",
+    1: "blue",
+    2: "red",
+    3: "green",
+    4: "yellow",
+    5: "grey",
+    6: "magenta",
+    7: "orange",
+    8: "cyan",
+    9: "brown",
+}
