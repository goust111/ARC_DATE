+                continue
+
+            next_reserved = reserved.copy()
+            next_reserved[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+            placed_fragment = {
+                "coords": body,
+                "body_color": frag["body_color"],
+                "anchor": anchor,
+                "target": frag["target"],
+                "anchor_color": frag["anchor_color"],
+            }
+            result = backtrack(i + 1, next_reserved, placed + [placed_fragment])
+            if result is not None:
