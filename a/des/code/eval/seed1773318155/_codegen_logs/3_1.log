+
+def _random_transform(mask: np.ndarray) -> np.ndarray:
+    arr = np.array(mask, copy=True)
+    if random.random() < 0.5:
+        arr = np.fliplr(arr)
+    arr = np.rot90(arr, random.randrange(4))
+    return np.array(arr, copy=True)
