+    the anchor lands on that marker, then recolor any multi-fragment filled rectangle by the
+    alphabetically earliest anchor color in the group.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = _majority_color(g)
