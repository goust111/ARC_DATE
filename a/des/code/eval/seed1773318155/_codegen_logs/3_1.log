+
+def _reserve_box(shape: tuple[int, int], r0: int, c0: int, r1: int, c1: int, pad: int) -> tuple[int, int, int, int]:
+    return (
+        max(0, int(r0) - pad),
+        max(0, int(c0) - pad),
+        min(shape[0] - 1, int(r1) + pad),
+        min(shape[1] - 1, int(c1) + pad),
