+def _legend_positions(
+    height: int,
+    width: int,
+    count: int,
+    orientation: str,
+    rng: np.random.Generator,
+) -> list[tuple[int, int]] | None:
+    gaps = [int(rng.choice(LEGEND_GAP_CHOICES)) for _ in range(max(0, count - 1))]
+    span = LEGEND_SIZE * count + sum(gaps)
+    if orientation in ("top", "bottom"):
