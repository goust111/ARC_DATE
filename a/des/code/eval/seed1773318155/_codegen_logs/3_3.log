+def _seed_rotation(canvas: dict[str, int]) -> int:
+    mid_r = canvas["r0"] + (canvas["side"] - 1) // 2
+    mid_c = canvas["c0"] + (canvas["side"] - 1) // 2
+    top = canvas["seed_r"] <= mid_r
+    left = canvas["seed_c"] <= mid_c
+    if top and left:
+        return 0
+    if top and not left:
+        return 1
+    if not top and not left:
+        return 2
+    return 3
