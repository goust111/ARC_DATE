+def _rotate_offsets(offsets: list[tuple[int, int]], rotation: int) -> list[tuple[int, int]]:
+    if rotation == 0:
+        return [(dr, dc) for dr, dc in offsets]
+    if rotation == 1:
+        return [(dc, -dr) for dr, dc in offsets]
+    if rotation == 2:
+        return [(-dr, -dc) for dr, dc in offsets]
+    if rotation == 3:
+        return [(-dc, dr) for dr, dc in offsets]
+    raise ValueError(f"unsupported rotation {rotation}")
