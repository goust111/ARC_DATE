+def _interior_positions(canvas_r: int, canvas_c: int, side: int, quadrant: int) -> list[tuple[int, int]]:
+    mid_r = canvas_r + (side - 1) // 2
+    mid_c = canvas_c + (side - 1) // 2
+    if quadrant in (0, 1):
