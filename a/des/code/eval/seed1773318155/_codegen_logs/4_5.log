+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(14, 24)
+    w = random.randint(14, 24)
+    pipe_count = random.randint(1, 3)
+
+    pipe_colors = random.sample(list(PIPE_COLORS), pipe_count)
