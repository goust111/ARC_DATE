+            for r, c in locs
+            if _side_of(int(r), int(c), grid.shape[0], grid.shape[1]) is not None
+        ]
+        if len(border_hits) != 2:
+            return False
+
+    try:
+        actual = main(grid)
+    except Exception:
+        return False
+    return bool(np.array_equal(actual, expected))
+
