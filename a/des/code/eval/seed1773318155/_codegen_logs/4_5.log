+        collected: list[int] = []
+        object_cells: list[tuple[int, int]] = []
+        for r, c in path:
+            v = int(out[r, c])
+            if v != bg:
+                collected.append(v)
+                object_cells.append((r, c))
+
+        for r, c in object_cells:
+            out[r, c] = bg
