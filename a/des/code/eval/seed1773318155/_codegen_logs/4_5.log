+        object_cells.sort(key=order.get)
+        object_colors = random.sample(object_palette, object_count)
+        release_cells = [(goal[0] + i * SIDE_TO_DIR[side_out][0], goal[1] + i * SIDE_TO_DIR[side_out][1]) for i in range(tail_len)]
+
+        return {
