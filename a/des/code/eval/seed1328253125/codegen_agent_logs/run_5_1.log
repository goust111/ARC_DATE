+
+def _make_frame_shell(height: int, width: int, frame_color: int, bg: int, side: str, gap_pos: int) -> np.ndarray:
+    patch = np.full((height, width), bg, dtype=int)
+    patch[0, :] = frame_color
+    patch[-1, :] = frame_color
+    patch[:, 0] = frame_color
+    patch[:, -1] = frame_color
