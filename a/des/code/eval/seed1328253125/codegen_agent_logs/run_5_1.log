    base = sum(widths) + MIN_COLUMN_GAP * (len(widths) - 1)
    extra = int(n) - 2 * EDGE_MARGIN - base
    spaces = [0] * (len(widths) + 1)
    for _ in range(extra):
        spaces[random.randrange(len(spaces))] += 1

    cols: list[int] = []
    c = EDGE_MARGIN + spaces[0]
