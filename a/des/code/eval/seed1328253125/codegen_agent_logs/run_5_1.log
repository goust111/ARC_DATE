+LEGEND_LENGTHS = (1, 2, 3, 4, 5)
+GEN_ATTEMPTS = 400
+GEN_GRID_H_RANGE = (24, 31)
+GEN_GRID_W_RANGE = (24, 31)
+GEN_FRAME_COUNT_RANGE = (2, 5)
+GEN_FRAME_OUTER_H_RANGE = (7, 10)
+GEN_FRAME_OUTER_W_RANGE = (7, 10)
+GEN_FRAME_CLEARANCE = 1
+GEN_FRAME_MARGIN = 1
+GEN_LEGEND_MARGIN = 1
+GEN_LEGEND_ROW_GAPS = (1, 2)
+GEN_FRAME_TRIES = 200
