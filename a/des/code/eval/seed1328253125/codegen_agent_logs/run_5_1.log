+    out = g.copy()
+    for frame in frames:
+        r0 = int(frame["r0"])
+        c0 = int(frame["c0"])
+        r1 = int(frame["r1"])
+        c1 = int(frame["c1"])
+        side = str(frame["side"])
+        mode = "cols" if side in ("top", "bottom") else "rows"
