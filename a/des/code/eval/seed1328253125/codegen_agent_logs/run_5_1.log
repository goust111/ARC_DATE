+            marker_color = int(temp[r0, marker_c])
+            if marker_color in (bg, bar_color):
+                continue
+            if not _is_singleton_marker(temp, r0, marker_c, marker_color):
+                continue
+            groups.setdefault(bar_color, {})
+            groups[bar_color][width] = marker_color
