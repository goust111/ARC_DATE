+def _is_singleton_marker(grid: np.ndarray, row: int, col: int, color: int) -> bool:
+    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+        rr = row + dr
+        cc = col + dc
+        if 0 <= rr < grid.shape[0] and 0 <= cc < grid.shape[1] and int(grid[rr, cc]) == int(color):
