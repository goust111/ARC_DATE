                choices.append((h, area))
    if not choices:
        return None

    h, area = random.choice(choices)
    flat = random.choice(_mask_options(h, int(w), area))
    mask = np.zeros(h * int(w), dtype=bool)
    mask[list(flat)] = True
    return mask.reshape(h, int(w))


