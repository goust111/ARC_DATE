+        return False
+    if not np.array_equal(out[:, 0], grid[:, 0]):
+        return False
+    if not np.array_equal(out[:, -1], grid[:, -1]):
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    global _NEXT_CROSS
+
+    want_cross = _NEXT_CROSS
+    _NEXT_CROSS = not _NEXT_CROSS
+
