+def _choose_directions(want_cross: bool, increasing: bool) -> tuple[int, int]:
+    if increasing:
+        options = [(1, -1), (-1, 1)] if want_cross else [(1, 1), (-1, -1)]
+    else:
+        options = [(1, 1), (-1, -1)] if want_cross else [(1, -1), (-1, 1)]
+    return random.choice(options)
+
+
+def _build_case(
+    h: int,
+    w: int,
+    bg: int,
+    rows: list[int],
+    cols: list[int],
+    increasing: bool,
+    want_cross: bool,
