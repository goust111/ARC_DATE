+                return None
+            if (r, c) in projected:
+                return None
+            projected[(r, c)] = int(color)
+
+    for (r, c), color in projected.items():
+        out[r, c] = int(color)
+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    height = random.randint(*GRID_H_RANGE)
