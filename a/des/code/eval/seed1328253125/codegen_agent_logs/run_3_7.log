+    key_w = int(key["width"])
+
+    if orientation == "vertical":
+        wall_c0, wall_c1 = wall_bounds
+        row_min, row_max = 1, h - key_h - 2
+        if side == "left":
+            col_min, col_max = 1, wall_c0 - key_w - 2
+        else:
+            col_min, col_max = wall_c1 + 2, w - key_w - 2
+    else:
+        wall_r0, wall_r1 = wall_bounds
