+def _legend_mask(grid: np.ndarray, bg: int) -> np.ndarray:
+    assert int(grid[0, 0]) != bg
+    mask = np.zeros(grid.shape, dtype=bool)
+    queue = deque([(0, 0)])
+    mask[0, 0] = True
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors(r, c, grid.shape, 4):
+            if mask[nr, nc]:
