+GREY = 5
+ARROW_COLORS = (1, 2, 3, 4)
+TRANSFORMS = ("cw", "ccw", "flip", "rot180")
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
