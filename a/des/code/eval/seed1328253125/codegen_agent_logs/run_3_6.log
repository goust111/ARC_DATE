+        for j in range(i + 1, len(rooms)):
+            t2, b2, l2, r2 = rooms[j]
+            if r1 == l2 or r2 == l1:
+                overlap = min(b1, b2) - max(t1, t2) + 1
+                if overlap >= 3:
+                    pairs.append((i, j))
+            elif b1 == t2 or b2 == t1:
+                overlap = min(r1, r2) - max(l1, l2) + 1
+                if overlap >= 3:
