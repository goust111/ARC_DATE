+YELLOW = 4
+GRAY = 5
+MAGENTA = 6
+ORANGE = 7
+CYAN = 8
+BROWN = 9
+
+PALETTE_POOL = (BLUE, GREEN, YELLOW, MAGENTA, ORANGE, CYAN, BROWN)
+PALETTE_LENGTH = 5
+CORNERS = ("tl", "tr", "bl", "br")
+PALETTE_ORIENTATIONS = ("horizontal", "vertical")
+
+GRID_HEIGHT_RANGE = (18, 25)
+GRID_WIDTH_RANGE = (18, 25)
