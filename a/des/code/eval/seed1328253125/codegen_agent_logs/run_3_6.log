+def _touches_edge(coords: np.ndarray, shape: tuple[int, int]) -> bool:
+    height, width = map(int, shape)
+    return bool(
+        (coords[:, 0] == 0).any()
+        or (coords[:, 0] == height - 1).any()
+        or (coords[:, 1] == 0).any()
+        or (coords[:, 1] == width - 1).any()
+    )
+
