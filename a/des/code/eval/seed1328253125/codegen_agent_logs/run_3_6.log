+def _valid_frame(frame: tuple[int, int, int, int]) -> bool:
+    top, bottom, left, right = frame
+    return bool(
+        bottom - top - 1 >= 2 * MIN_ROOM_HEIGHT + 1
+        and right - left - 1 >= 2 * MIN_ROOM_WIDTH + 1
+    )
