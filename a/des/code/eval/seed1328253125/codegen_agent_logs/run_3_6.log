+            stack = [(r, c)]
+            labels[r, c] = comp_id
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, height, width):
+                    if bool(mask[nr, nc]) and int(labels[nr, nc]) == 0:
+                        labels[nr, nc] = comp_id
+                        stack.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+
