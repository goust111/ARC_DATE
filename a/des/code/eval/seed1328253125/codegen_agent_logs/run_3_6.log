+def _neighbors4(r: int, c: int, height: int, width: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < height:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < width:
+        out.append((r, c + 1))
+    return out
+
