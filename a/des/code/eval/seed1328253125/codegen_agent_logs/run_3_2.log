+from __future__ import annotations
+
+from collections import Counter
+from functools import lru_cache
+from itertools import combinations
+import random
+
+import numpy as np
+
+
+DIRS4 = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+SIDE_NAMES = ["top", "right", "bottom", "left"]
+MIN_PIECES = 2
+MAX_PIECES = 4
+MIN_PIECE_AREA = 5
+GEN_RETRIES = 400
