+def _anchor_side(mask: np.ndarray, r: int, c: int) -> int:
+    h, w = mask.shape
+    exposed = []
+    for side, (dr, dc) in enumerate(DIRS4):
+        nr, nc = int(r + dr), int(c + dc)
+        if nr < 0 or nc < 0 or nr >= h or nc >= w or not bool(mask[nr, nc]):
