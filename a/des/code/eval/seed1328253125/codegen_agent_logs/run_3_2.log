+
+DIRS4 = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+SIDE_NAMES = ["top", "right", "bottom", "left"]
+MIN_PIECES = 2
+MAX_PIECES = 4
+MIN_PIECE_AREA = 5
+GEN_RETRIES = 400
+PLACE_RETRIES = 400
