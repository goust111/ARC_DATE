+    mask_rot = np.rot90(mask, int(rot))
+    cells = [(int(r), int(c), int(patch_rot[r, c])) for r, c in np.argwhere(mask_rot)]
+    return {
+        "patch": patch_rot,
+        "mask": mask_rot,
+        "cells": cells,
+        "area": int(mask_rot.sum()),
+    }
