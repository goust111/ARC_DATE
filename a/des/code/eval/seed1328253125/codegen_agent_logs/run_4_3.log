+def _hole_size_choices(outer_h: int, outer_w: int) -> list[tuple[int, int]]:
+    choices = []
+    for hh in range(2, outer_h - 1):
+        if hh % 2 != outer_h % 2:
+            continue
+        for hw in range(2, outer_w - 1):
+            if hw % 2 != outer_w % 2:
+                continue
+            if min(hh, hw) < 2 or max(hh, hw) < 3:
+                continue
+            choices.append((hh, hw))
+    return choices
