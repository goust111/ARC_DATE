+        h, w = shape_mask.shape
+        block = grid[top : top + h, left : left + w]
+        block[shape_mask] = color
+    return grid
+
+
+def _expected_output(inp: np.ndarray, specs: list[dict[str, object]], half_w: int) -> np.ndarray:
+    out = inp.copy()
+    out[:, half_w + 1 :] = BG
