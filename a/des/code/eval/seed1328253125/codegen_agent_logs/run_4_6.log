+) -> list[tuple[int, int]] | None:
+    if not positions:
+        return None
+
+    pos_set = set(positions)
+    count = random.randint(2, 4) if overlap_mode else random.randint(1, 4)
+    first = random.choice(positions)
+    anchors = [first]
+
+    if overlap_mode:
+        offsets = [
+            (dr, dc)
+            for dr in range(-(ph - 1), ph)
+            for dc in range(-(pw - 1), pw)
