+    for spec in _region_specs(g):
+        current = spec["arrow"]
+        dir_idx = int(spec["dir_idx"])
+        color = int(spec["color"])
+        region = spec["region"]
+
+        for _ in range(int(spec["steps"])):
+            advanced = False
+            for turn in range(4):
+                next_dir = (dir_idx + turn) % 4
+                dr, dc = DIRS[next_dir]
+                nr = current[0] + dr
