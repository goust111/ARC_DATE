+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    n_objects = rng.randint(MIN_OBJECTS, MAX_OBJECTS)
+    min_side = 12 + 4 * n_objects
+    h = rng.randint(min_side, MAX_SIDE)
+    w = rng.randint(min_side, MAX_SIDE)
