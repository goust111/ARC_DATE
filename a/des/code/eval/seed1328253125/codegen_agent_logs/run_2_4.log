+def _reserve_box(r0: int, c0: int, outer_h: int, outer_w: int) -> tuple[int, int, int, int]:
+    top = r0 - RESERVE_MARGIN
+    left = c0 - RESERVE_MARGIN
+    bottom = r0 + outer_h + RESERVE_MARGIN
+    right = c0 + outer_w + RESERVE_MARGIN
