+        seed_r, seed_c = _room_seed_cell(r0, c0, inner_h, inner_w, corner)
+        dr, dc = DIRS[dir_idx]
+        arrow_r = seed_r + dr
+        arrow_c = seed_c + dc
+        grid[seed_r, seed_c] = color
+        grid[arrow_r, arrow_c] = MAROON
+
+        reserved[top:bottom, left:right] = True
