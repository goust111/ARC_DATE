+def _room_seed_cell(r0: int, c0: int, inner_h: int, inner_w: int, corner: str) -> tuple[int, int]:
+    if corner == "tl":
+        return r0 + 1, c0 + 1
+    if corner == "tr":
+        return r0 + 1, c0 + inner_w
+    if corner == "br":
+        return r0 + inner_h, c0 + inner_w
+    return r0 + inner_h, c0 + 1
