        else:
            c += 1
        cells.add((r, c))
    return cells


def _make_shape_mask(h: int, w: int) -> np.ndarray | None:
    path_area = h + w - 1
    upper = min(h * w - 1, max(path_area, (3 * h * w) // 4))
    if upper < path_area:
