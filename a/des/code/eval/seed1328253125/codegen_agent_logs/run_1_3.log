+    quadrant_colors = dict(zip(QUADRANT_IDS, random.sample(BACKGROUND_COLORS, len(BACKGROUND_COLORS))))
+    _fill_quadrants(grid, bounds, quadrant_colors)
+    _fill_quadrants(expected, bounds, quadrant_colors)
+    grid[axis_r, :] = ORANGE
