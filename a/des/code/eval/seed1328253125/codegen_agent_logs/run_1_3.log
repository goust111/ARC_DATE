            current = int(out[rr, cc])
            assert current in (target["bg"], MAROON, cross_color), "target quadrant must be otherwise empty"
            out[rr, cc] = source["bg"]

    return out


def _random_path(h: int, w: int) -> set[tuple[int, int]]:
    moves = ["D"] * (h - 1) + ["R"] * (w - 1)
    random.shuffle(moves)
    r = c = 0
