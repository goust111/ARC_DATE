BACKGROUND_COLOR, GUIDE_COLOR, NO_GUIDE_BASE_COLOR = 0, 4, 1
GUIDED_PALETTE = tuple(range(1, 10))
UNIQUE_SLOT_COLORS = tuple(range(2, 10))
SEPARATOR_COLORS = (2, 3, 5, 6, 7, 8, 9)

