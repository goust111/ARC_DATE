+
+        sr0, sr1, sc0, sc1 = bounds[source_q]
+        tr0, tr1, tc0, tc1 = bounds[target_q]
+        max_h = min(SHAPE_SIZE_RANGE[1], sr1 - sr0, tr1 - tr0)
