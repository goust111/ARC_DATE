+            cc = anchor_c + int(dc)
+            assert tr0 <= rr < tr1 and tc0 <= cc < tc1, "stamped shape must stay inside its target quadrant"
+            current = int(out[rr, cc])
+            assert current in (target["bg"], MAROON, cross_color), "target quadrant must be otherwise empty"
+            out[rr, cc] = source["bg"]
