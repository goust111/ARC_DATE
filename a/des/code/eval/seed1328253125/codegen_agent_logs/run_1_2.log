+    return all((nr, nc) not in set_b for r, c in seg_a for nr, nc in _neighbors4(r, c))
+
+
+def _valid_relative_offset(
+    endpoint_a: tuple[int, int],
+    endpoint_b: tuple[int, int],
+    row_sign: int,
+    col_sign: int,
