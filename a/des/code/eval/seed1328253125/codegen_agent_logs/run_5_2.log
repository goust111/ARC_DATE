+
+
+def _padded(cells: set[tuple[int, int]], shape: tuple[int, int], pad: int = 1) -> set[tuple[int, int]]:
+    h, w = shape
+    out = set()
+    for r, c in cells:
+        for dr in range(-pad, pad + 1):
+            for dc in range(-pad, pad + 1):
