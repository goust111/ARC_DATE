+import random
+from collections import Counter
+
+import numpy as np
+
+
+ARROW_COLOR = 5
+DIR_VECTORS = {
+    "right": (0, 1),
+    "left": (0, -1),
+    "down": (1, 0),
+    "up": (-1, 0),
+}
+DIR_SIDES = {
+    "right": ("right", "left"),
+    "left": ("left", "right"),
+    "down": ("bottom", "top"),
+    "up": ("top", "bottom"),
+}
+PERP = {
+    "right": (1, 0),
+    "left": (1, 0),
+    "down": (0, 1),
+    "up": (0, 1),
+}
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if dr or dc]
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _connected_components(mask: np.ndarray, connectivity: int) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    steps = DIR4 if connectivity == 4 else DIR8
+    comps: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not bool(mask[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in steps:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and bool(mask[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return r0, c0, r1, c1
+
+
+def _parse_arrow(coords: np.ndarray) -> dict | None:
+    cells = {tuple(map(int, rc)) for rc in coords}
+    if len(cells) < 4:
+        return None
+
+    for name, (dr, dc) in DIR_VECTORS.items():
+        pr, pc = PERP[name]
+        for tail in cells:
+            if (tail[0] - dr, tail[1] - dc) in cells:
+                continue
+
+            shaft = []
+            rr, cc = tail
+            while (rr, cc) in cells:
+                shaft.append((rr, cc))
+                rr += dr
+                cc += dc
+
+            if len(shaft) < 2:
+                continue
+
+            end = shaft[-1]
+            head1 = (end[0] + dr + pr, end[1] + dc + pc)
+            head2 = (end[0] + dr - pr, end[1] + dc - pc)
+            expected = set(shaft)
+            expected.add(head1)
+            expected.add(head2)
+            if expected != cells:
+                continue
+
+            return {
+                "direction": name,
+                "vec": (dr, dc),
+                "perp": (pr, pc),
+                "tail": tail,
+                "shaft_end": end,
+                "cells": expected,
+            }
+    return None
+
+
+def _find_objects(grid: np.ndarray, bg: int, arrow_color: int) -> tuple[list[dict], dict[tuple[int, int], int]]:
+    objects: list[dict] = []
