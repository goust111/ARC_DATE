+        for tail in cells:
+            if (tail[0] - dr, tail[1] - dc) in cells:
+                continue
+
+            shaft = []
+            rr, cc = tail
+            while (rr, cc) in cells:
+                shaft.append((rr, cc))
+                rr += dr
+                cc += dc
+
+            if len(shaft) < 2:
+                continue
+
+            end = shaft[-1]
+            head1 = (end[0] + dr + pr, end[1] + dc + pc)
+            head2 = (end[0] + dr - pr, end[1] + dc - pc)
+            expected = set(shaft)
+            expected.add(head1)
+            expected.add(head2)
+            if expected != cells:
