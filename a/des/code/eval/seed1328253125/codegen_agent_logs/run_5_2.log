+                    "coords": cell_set,
+                    "bbox": _bbox(coords),
+                }
+            )
+    return objects, cell_to_obj
+
+
+def _find_tail_object(arrow: dict, cell_to_obj: dict[tuple[int, int], int]) -> int:
+    dr, dc = arrow["vec"]
+    tr, tc = arrow["tail"]
+    direct = (tr - dr, tc - dc)
+    if direct in cell_to_obj:
+        return cell_to_obj[direct]
+
+    hits = set()
