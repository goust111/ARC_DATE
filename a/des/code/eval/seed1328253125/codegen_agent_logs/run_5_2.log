+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        scene = _scene_attempt()
+        if scene is None:
+            continue
+        inp, out = scene
+        try:
+            solved = main(inp)
+        except Exception:
+            continue
+        if np.array_equal(solved, out):
+            return inp
+    raise RuntimeError("failed to generate a valid input")

