+def _move_delta(direction: str, src_bbox: tuple[int, int, int, int], dst_bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    ar0, ac0, ar1, ac1 = src_bbox
+    br0, bc0, br1, bc1 = dst_bbox
+
+    if direction == "right":
+        gap = bc0 - ac1 - 1
+        return 0, -gap
+    if direction == "left":
+        gap = ac0 - bc1 - 1
+        return 0, gap
+    if direction == "down":
+        gap = br0 - ar1 - 1
+        return -gap, 0
+    gap = ar0 - br1 - 1
+    return gap, 0
