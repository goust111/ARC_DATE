+        for coords in fragment_coords:
+            out[coords[:, 0], coords[:, 1]] = bg
+        tr0, tc0, _, _ = template["bbox"]
+        for hole in template["holes"]:
+            abs_coords = hole["coords"] + np.array([tr0, tc0], dtype=int)
+            out[abs_coords[:, 0], abs_coords[:, 1]] = color
