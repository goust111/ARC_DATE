+def _mark_bbox(occ: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int = 1) -> None:
+    h0, w0 = occ.shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h0, r0 + h + pad)
+    cc1 = min(w0, c0 + w + pad)
+    occ[rr0:rr1, cc0:cc1] = True
