+def _pick_location(
+    occ: np.ndarray, patch_shape: tuple[int, int], attempts: int
+) -> tuple[int, int] | None:
+    h, w = patch_shape
+    grid_h, grid_w = occ.shape
+    if h + 2 > grid_h or w + 2 > grid_w:
+        return None
+    for _ in range(attempts):
+        r0 = random.randint(1, grid_h - h - 1)
+        c0 = random.randint(1, grid_w - w - 1)
