+
+
+def _crop_pair(input_mask: np.ndarray, repaired_mask: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    union = input_mask | repaired_mask
+    r0, c0, r1, c1 = _bbox_from_mask(union)
+    return input_mask[r0:r1, c0:c1].copy(), repaired_mask[r0:r1, c0:c1].copy()
