+def _component_cells(adj: dict[Coord, list[Coord]], start: Coord) -> set[Coord]:
+    seen = {start}
+    q = deque([start])
+    while q:
+        cell = q.popleft()
+        for nxt in adj[cell]:
+            if nxt not in seen:
+                seen.add(nxt)
+                q.append(nxt)
