+    colors = {int(v) for v in np.unique(g)}
+    non_bg = colors - {bg}
+    gray_candidates = non_bg - set(PRIMARY_COLORS)
+    assert len(gray_candidates) == 1, "expected exactly one gray network color"
+    gray = next(iter(gray_candidates))
