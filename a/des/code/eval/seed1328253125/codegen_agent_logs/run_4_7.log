+        significant, graph, edges, root = _compress_component(g, component, adj, gray_cells, source_cells)
+        children = {cell: [] for cell in significant}
+        parent_of: dict[Coord, Coord | None] = {root: None}
+        edge_to_parent: dict[Coord, int] = {}
