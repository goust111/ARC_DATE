+def _neighbors(shape: tuple[int, int], cell: Coord) -> list[Coord]:
+    h, w = shape
+    r, c = cell
+    out: list[Coord] = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < h:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < w:
+        out.append((r, c + 1))
+    return out
+
+
+def _signal_color(signal: frozenset[int]) -> int:
