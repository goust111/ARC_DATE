+            color = _signal_color(signal)
+            for path_cell in _edge_cells_from_child(edges[edge_to_parent[cell]], cell):
+                out[path_cell] = color
+
+        for cell in order:
+            signal = local_signal[cell]
+            if not signal or len(signal) == 3:
