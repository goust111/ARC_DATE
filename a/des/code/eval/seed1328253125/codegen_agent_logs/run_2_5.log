+    if parts == 1:
+        return [total]
+    cuts = sorted(rng.sample(range(1, total), parts - 1))
+    pieces: list[int] = []
+    prev = 0
+    for cut in cuts + [total]:
+        pieces.append(cut - prev)
+        prev = cut
+    return pieces
+
