+COLOR_POOL = tuple(range(1, 10))
+
+# Grid generation bounds.
+BODY_HEIGHT_RANGE = (5, 12)
+GRID_WIDTH_RANGE = (8, 18)
+COLOR_COUNT_RANGE = (2, 5)
