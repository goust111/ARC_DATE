+        ),
+        _mask_from_rows(
+            "#.#",
+            "#.#",
+            "###",
+        ),
+        _mask_from_rows(
+            "##.",
+            "#..",
+            "###",
+        ),
+    ),
+    5: (
+        _mask_from_rows(
+            "#....",
+            "#....",
+            "#....",
+            "#....",
+            "#####",
+        ),
+        _mask_from_rows(
