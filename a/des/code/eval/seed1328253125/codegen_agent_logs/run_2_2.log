+                and int(grid[r + 1, c]) == MAROON
+                and int(grid[r, c - 1]) != MAROON
+                and int(grid[r, c + 1]) != MAROON
+            )
+            horizontal_gap = (
+                int(grid[r, c - 1]) == MAROON
+                and int(grid[r, c + 1]) == MAROON
+                and int(grid[r - 1, c]) != MAROON
+                and int(grid[r + 1, c]) != MAROON
+            )
+            if vertical_gap == horizontal_gap:
+                continue
+            door_mask[r, c] = True
+            doors.append((r, c, "vertical" if vertical_gap else "horizontal"))
+    return door_mask, doors
