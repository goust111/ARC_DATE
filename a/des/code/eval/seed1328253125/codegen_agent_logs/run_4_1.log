+def _make_stamp_mask(rng: np.random.Generator) -> np.ndarray:
+    h = int(rng.integers(3, 6))
+    w = int(rng.integers(3, 6))
+    kind = int(rng.integers(6))
+    mask = np.zeros((h, w), dtype=bool)
+
+    if kind == 0:
+        mask[int(rng.integers(h)), :] = True
+        mask[:, int(rng.integers(w))] = True
+    elif kind == 1:
+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[int(rng.integers(h)), :] = True
+    elif kind == 2:
+        mask[:, 0] = True
+        mask[:, -1] = True
+        if rng.random() < 0.5:
+            mask[0, :] = True
+        else:
+            mask[-1, :] = True
+    elif kind == 3:
+        corner = int(rng.integers(4))
+        if corner == 0:
+            mask[0, :] = True
+            mask[:, 0] = True
+        elif corner == 1:
+            mask[0, :] = True
+            mask[:, -1] = True
+        elif corner == 2:
+            mask[-1, :] = True
+            mask[:, 0] = True
+        else:
+            mask[-1, :] = True
+            mask[:, -1] = True
+    elif kind == 4:
+        if rng.random() < 0.5:
+            mask[0, :] = True
+        else:
+            mask[-1, :] = True
+        mask[:, w // 2] = True
+    else:
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, 0] = True
+        mask[:, -1] = True
+        if h > 2 and w > 2:
+            side = int(rng.integers(4))
+            if side == 0:
+                mask[0, int(rng.integers(1, w - 1))] = False
