+    if kind == 0:
+        mask[int(rng.integers(h)), :] = True
+        mask[:, int(rng.integers(w))] = True
+    elif kind == 1:
+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[int(rng.integers(h)), :] = True
+    elif kind == 2:
+        mask[:, 0] = True
+        mask[:, -1] = True
