+        return False
+    mask = np.zeros((h, w), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    expected = np.zeros((h, w), dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
