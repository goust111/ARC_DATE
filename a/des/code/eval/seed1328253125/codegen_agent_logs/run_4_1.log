+        elif corner == 1:
+            mask[0, :] = True
+            mask[:, -1] = True
+        elif corner == 2:
+            mask[-1, :] = True
+            mask[:, 0] = True
+        else:
+            mask[-1, :] = True
+            mask[:, -1] = True
