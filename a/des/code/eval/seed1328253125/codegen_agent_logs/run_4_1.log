+    grid[r1, c0 : c1 + 1] = color
+    grid[r0 : r1 + 1, c0] = color
+    grid[r0 : r1 + 1, c1] = color
+
+
+def _place_templates(
+    grid: np.ndarray, rng: np.random.Generator, bg: int
+) -> tuple[list[np.ndarray], tuple[int, int, int, int]]:
