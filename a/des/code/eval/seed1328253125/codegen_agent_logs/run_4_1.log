+                dot_colors = rng.choice(dot_palette, size=target, replace=False)
+                _scatter_dots(grid, rng, bbox, stamp, dot_colors, bg)
+                reserved.append(bbox)
+                placed = True
+                break
+        if not placed:
+            return None
