+        inner_w = sw + 2 * int(rng.integers(1, 4))
+        outer_h = inner_h + 2
+        outer_w = inner_w + 2
+
+        max_r0 = bank_top - outer_h - 1
+        max_c0 = width - outer_w - 1
+        if max_r0 < 1 or max_c0 < 1:
+            return None
+
+        placed = False
+        for _ in range(200):
+            r0 = int(rng.integers(1, max_r0 + 1))
+            c0 = int(rng.integers(1, max_c0 + 1))
