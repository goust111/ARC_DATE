80:    direction = -1 if _center(target, axis) < _center(source, axis) else 1
81:
82:    sr0, sc0, sr1, sc1 = source["bbox"]
83:    tr0, tc0, tr1, tc1 = target["bbox"]
84:    source_lo = [sr0, sc0]
85:    source_hi = [sr1, sc1]
86:    target_lo = [tr0, tc0]
87:    target_hi = [tr1, tc1]
