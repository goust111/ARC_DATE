50:    cand_token = [c for c in colors if int(c) not in (0, int(gate))]
51:    assert not (not cand_token)
52:    token = int(min(cand_token, key=lambda c: (int(cnt_all[int(c)]), int(c))))
53:    cand_bg = [c for c in colors if int(c) not in (0, int(gate), int(token))]
54:    assert cand_bg
