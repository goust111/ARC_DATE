87:def main(grid: np.ndarray) -> np.ndarray:
88:    """
89:    Move the single marker to the endpoint reached by sliding along the obstacle contour.
90:
91:    Input structure:
92:    - A dominant background color fills the canvas.
93:    - One single-pixel marker sits away from a connected obstacle region of the
94:      remaining color.
95:    - The marker has exactly one horizontal or vertical sightline to the obstacle.
96:
97:    Rule:
98:    - Find the last background pixel before the obstacle along that sightline.
99:    - From that pixel, try the two diagonal turns that continue around the
100:      obstacle boundary.
101:    - Move the marker to the endpoint of the turn that remains 4-adjacent to the
102:      obstacle for the longest distance.
103:
104:    Key insight:
105:    The marker is not placed by distance to the obstacle; it first points to the
106:    obstacle, then follows the visible outside contour until that contour segment ends.
107:    """
108:    g = np.asarray(grid, dtype=int)
109:    bg = get_bg(g)
110:    marker = _unique_marker_color(g, bg)
111:    obstacle = _obstacle_color(g, bg, marker)
112:
113:    marker_coords = np.argwhere(g == marker)
114:    assert marker_coords.shape == (1, 2), "expected exactly one marker pixel"
115:    marker_pos = tuple(map(int, marker_coords[0]))
116:
117:    direction, contour_start = _sightline_to_obstacle(g, marker_pos, obstacle, bg)
118:    assert _adjacent_to_color(g, contour_start, obstacle), "contour must start next to obstacle"
119:    dest = _walk_contour(g, contour_start, direction, obstacle, bg)
120:    assert int(g[dest]) == bg, "destination should be background"
121:
122:    out = g.copy()
123:    out[marker_pos] = bg
124:    out[dest] = marker
125:    return out
