141:def _gen_transform(grid: np.ndarray, orientation: int) -> np.ndarray:
142:    if orientation == 0:
143:        return grid.copy()
144:    if orientation == 1:
145:        return np.flipud(grid).copy()
146:    if orientation == 2:
147:        return np.rot90(grid, 1).copy()
148:    return np.rot90(grid, -1).copy()
