155:def _gen_stair_patch(h: int, w: int, color: int, bg: int) -> np.ndarray:
156:    patch = np.full((h, w), bg, dtype=int)
157:    max_extra = w // 2 - 1
158:    thresholds = sorted(random.randint(1, h - 1) for _ in range(max_extra))
159:    for r in range(h):
160:        extra = sum(r >= threshold for threshold in thresholds)
161:        c0 = w // 2 - 1 - extra
162:        c1 = w // 2 + extra
163:        patch[r, c0 : c1 + 1] = color
164:    return patch
