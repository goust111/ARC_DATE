+def coords_to_mask(coords) -> np.ndarray:
+    r0, c0, r1, c1 = bbox_of(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
+    return mask
+
+
+def mask_coords(mask: np.ndarray):
+    return [(int(r), int(c)) for r, c in np.argwhere(mask)]
