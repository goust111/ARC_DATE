+    for frag in fragments:
+        placements = set()
+        for tr, tc in target_coords:
+            for fr, fc in frag:
+                dr = tr - fr
+                dc = tc - fc
+                bits = 0
+                ok = True
+                for rr, cc in frag:
+                    bit = index.get((rr + dr, cc + dc))
+                    if bit is None:
+                        ok = False
+                        break
+                    bits |= 1 << bit
+                if ok:
+                    placements.add(bits)
+        if not placements:
+            return False
+        positions_by_fragment.append(tuple(sorted(placements)))
+
+    order = sorted(range(len(fragments)), key=lambda i: len(positions_by_fragment[i]))
+    memo = set()
+
+    def dfs(k: int, covered: int) -> bool:
+        if k == len(order):
+            return covered == full_mask
+        state = (k, covered)
+        if state in memo:
+            return False
+        idx = order[k]
+        for bits in positions_by_fragment[idx]:
+            if bits & covered:
+                continue
+            if dfs(k + 1, covered | bits):
+                return True
+        memo.add(state)
+        return False
+
+    return dfs(0, 0)
