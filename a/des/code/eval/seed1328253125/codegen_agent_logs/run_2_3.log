+
+BG_COLOR = 8
+FRAME_COLOR = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 9)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDES = ("top", "bottom", "left", "right")
+
+MIN_FRAME_SIDE = 5
+MAX_GRID_SIDE = 30
+GEN_ATTEMPTS = 300
+FRAGMENT_TRIES = 200
+PLACE_TRIES = 200
+MIN_FRAGMENT_CELLS = 4
+MAX_FRAGMENT_SPAN = 12
