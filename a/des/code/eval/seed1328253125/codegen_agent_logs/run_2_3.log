+    forbidden_cut = None
+    if tooth_side is not None:
+        if tooth_side == "top":
+            anchor = (0, w // 2)
+            tooth = (1, w // 2)
+        elif tooth_side == "bottom":
+            anchor = (h - 1, w // 2)
+            tooth = (h - 2, w // 2)
+        elif tooth_side == "left":
+            anchor = (h // 2, 0)
+            tooth = (h // 2, 1)
+        else:
+            anchor = (h // 2, w - 1)
+            tooth = (h // 2, w - 2)
+        idx = order.index(anchor)
+        order = order[: idx + 1] + [tooth] + order[idx + 1 :]
+        forbidden_cut = idx + 1
+
+    return order, forbidden_cut
