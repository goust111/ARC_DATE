+def target_can_cover(fragments, target: np.ndarray) -> bool:
+    target_coords = [(int(r), int(c)) for r, c in np.argwhere(target)]
+    index = {coord: i for i, coord in enumerate(target_coords)}
+    full_mask = (1 << len(target_coords)) - 1
