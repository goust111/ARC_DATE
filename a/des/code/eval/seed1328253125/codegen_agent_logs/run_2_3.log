+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG_COLOR = 8
+FRAME_COLOR = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 9)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDES = ("top", "bottom", "left", "right")
