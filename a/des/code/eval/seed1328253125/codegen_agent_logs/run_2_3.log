+def frame_order(h: int, w: int, tooth_side: str | None):
+    order = []
+    for c in range(w):
+        order.append((0, c))
+    for r in range(1, h - 1):
+        order.append((r, w - 1))
+    for c in range(w - 1, -1, -1):
+        order.append((h - 1, c))
+    for r in range(h - 2, 0, -1):
+        order.append((r, 0))
+
+    forbidden_cut = None
+    if tooth_side is not None:
+        if tooth_side == "top":
+            anchor = (0, w // 2)
+            tooth = (1, w // 2)
+        elif tooth_side == "bottom":
+            anchor = (h - 1, w // 2)
+            tooth = (h - 2, w // 2)
+        elif tooth_side == "left":
+            anchor = (h // 2, 0)
+            tooth = (h // 2, 1)
+        else:
+            anchor = (h // 2, w - 1)
+            tooth = (h // 2, w - 2)
+        idx = order.index(anchor)
+        order = order[: idx + 1] + [tooth] + order[idx + 1 :]
+        forbidden_cut = idx + 1
