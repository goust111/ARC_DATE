+        shape_coords = []
+        for rr, cc in np.argwhere(spec["mask"]):
+            r = top + int(rr)
+            c = left + int(cc)
+            shape_coords.append((r, c))
+            if out[r, c] != BG_COLOR:
+                return None
+        for r, c in shape_coords:
+            out[r, c] = int(spec["color"])
+    return out
+
+
