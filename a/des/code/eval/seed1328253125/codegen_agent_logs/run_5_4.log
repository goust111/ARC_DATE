+
+def _build_region_seeds(
+    rows: int,
+    cols: int,
+    seed_palette: list[int],
+    rng: random.Random,
+) -> list[list[int | None]]:
+    grid: list[list[int | None]] = [[None for _ in range(cols)] for _ in range(rows)]
+    edges = _pick_disjoint_edges(rows, cols, 4, rng)
