+            incident = [
+                vertical_colors[(ci, ri)],
+                vertical_colors[(ci, ri + 1)],
+                horizontal_colors[(ri, ci)],
+                horizontal_colors[(ri, ci + 1)],
+            ]
+            out[row, col] = incident[0] if len(set(incident)) == 1 else wall_color
+
