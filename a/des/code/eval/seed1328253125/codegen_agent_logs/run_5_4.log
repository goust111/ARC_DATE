+    inner_r1 = r1 - 1 if r1 - r0 + 1 >= 3 else r1
+    inner_c0 = c0 + 1 if c1 - c0 + 1 >= 3 else c0
+    inner_c1 = c1 - 1 if c1 - c0 + 1 >= 3 else c1
