+def _branch_key(seed_a: int | None, seed_b: int | None) -> str:
+    if seed_a is None and seed_b is None:
+        return "none"
+    if seed_a is None or seed_b is None:
+        return "one"
+    if int(seed_a) == int(seed_b):
+        return "same"
+    return "different"
