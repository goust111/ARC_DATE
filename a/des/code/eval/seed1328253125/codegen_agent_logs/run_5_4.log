+
+def _edge_key(a: tuple[int, int], b: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
+    return (a, b) if a <= b else (b, a)
+
+
+def _trace_segments(wall_mask: np.ndarray, nodes: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = wall_mask.shape
