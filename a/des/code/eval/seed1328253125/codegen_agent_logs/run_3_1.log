+    return fences
+
+
+def _find_template(grid: np.ndarray, bg: int, fence: dict) -> dict:
+    h, w = grid.shape
+    gap_r, gap_c = fence["gap"]
+    dr, dc = SIDE_INFO[fence["side"]]["outside"]
+    tr, tc = gap_r + dr, gap_c + dc
