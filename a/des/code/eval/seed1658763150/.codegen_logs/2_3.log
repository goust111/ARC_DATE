+def _compress_indices(indices: Iterable[int]) -> list[int]:
+    values = sorted(int(v) for v in indices)
+    if not values:
+        return []
+    groups: list[list[int]] = [[values[0]]]
+    for value in values[1:]:
+        if value == groups[-1][-1] + 1:
+            groups[-1].append(value)
+        else:
