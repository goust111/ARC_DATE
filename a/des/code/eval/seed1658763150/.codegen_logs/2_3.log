+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+WALL = 1
+MARKER = 2
+PATTERN_COLORS = (3, 4, 5, 6, 7, 8, 9)
+
+GEN_RETRIES = 400
+DOOR_LAYOUT_RETRIES = 200
