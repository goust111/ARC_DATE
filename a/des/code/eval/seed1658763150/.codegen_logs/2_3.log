+def _line_positions(lengths: list[int], start: int) -> list[int]:
+    lines = [int(start)]
+    cursor = int(start)
+    for length in lengths:
+        cursor += int(length) + 1
+        lines.append(int(cursor))
+    return lines
+
+
+def _door_slots(start: int, end: int, rng: random.Random) -> list[int]:
