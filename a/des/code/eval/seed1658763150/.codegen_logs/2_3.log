+
+    for (i, j), cols in horizontal_doors.items():
+        row = h_lines[i + 1]
+        for col in cols:
+            grid[row, col] = BG
+    for (i, j), rows in vertical_doors.items():
+        col = v_lines[j + 1]
+        for row in rows:
+            grid[row, col] = BG
+
+    corner = rng.choice(("tl", "tr", "bl", "br"))
+    if corner == "tl":
+        grid[0, 0] = MARKER
+    elif corner == "tr":
+        grid[0, width - 1] = MARKER
+    elif corner == "bl":
+        grid[height - 1, 0] = MARKER
+    else:
+        grid[height - 1, width - 1] = MARKER
