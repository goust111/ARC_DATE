+
+def _rotate_variants(shape: np.ndarray) -> list[np.ndarray]:
+    variants: list[np.ndarray] = []
+    current = shape
+    for _ in range(4):
+        if not any(np.array_equal(current, seen) for seen in variants):
+            variants.append(current.copy())
+        current = np.rot90(current)
