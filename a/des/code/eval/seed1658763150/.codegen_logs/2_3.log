+    nr = len(row_sizes)
+    nc = len(col_sizes)
+    counts = np.zeros((nr, nc), dtype=int)
+    horizontal: dict[tuple[int, int], tuple[int, ...]] = {}
+    vertical: dict[tuple[int, int], tuple[int, ...]] = {}
