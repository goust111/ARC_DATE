+        sep_row = row_bounds[min(a[0], b[0]) + 1]
+        left = col_bounds[room_col]
+        right = col_bounds[room_col + 1]
+        start_min = left + 2
+        start_max = right - gap_width - 1
+        assert start_min <= start_max
+        start = rng.randint(start_min, start_max)
