+        path: list[tuple[int, int]],
+        used_h: set[int],
+        used_v: set[int],
+    ) -> list[tuple[int, int]] | None:
+        if len(path) == length:
+            return path.copy()
+
+        ri, ci = path[-1]
+        moves = []
+        for dr, dc in DIRS:
+            nr = ri + dr
+            nc = ci + dc
+            nxt = (nr, nc)
+            if not (0 <= nr < room_rows and 0 <= nc < room_cols):
+                continue
+            if nxt in path or nxt in reserved_rooms:
+                continue
+            kind, idx = _boundary_info((ri, ci), nxt)
+            if kind == "h":
+                if idx in used_h or idx in reserved_h:
+                    continue
+            else:
+                if idx in used_v or idx in reserved_v:
+                    continue
+            moves.append((nxt, kind, idx))
+        rng.shuffle(moves)
+
+        for nxt, kind, idx in moves:
+            path.append(nxt)
+            if kind == "h":
+                used_h.add(idx)
+            else:
+                used_v.add(idx)
+            result = dfs(path, used_h, used_v)
+            if result is not None:
+                return result
+            if kind == "h":
+                used_h.remove(idx)
+            else:
+                used_v.remove(idx)
+            path.pop()
+        return None
+
+    for start in starts:
+        result = dfs([start], set(), set())
+        if result is not None:
