+    sh, sw = shape.shape
+    shape_offsets = np.argwhere(shape)
+    candidates: list[np.ndarray] = []
+    for r0 in range(top + 1, bottom - sh + 1):
+        for c0 in range(left + 1, right - sw + 1):
