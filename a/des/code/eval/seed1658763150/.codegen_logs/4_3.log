+def _manual_expected(
+    grid: np.ndarray,
+    payload_specs: list[dict],
+    arrows: dict[tuple[int, int], tuple[int, int]],
+    boxes: dict[tuple[int, int], tuple[int, int, int, int]],
+    room_shape: tuple[int, int],
+) -> np.ndarray:
