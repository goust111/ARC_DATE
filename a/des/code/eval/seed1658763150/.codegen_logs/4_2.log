+def _vertical_choices(height: int, width: int) -> list[tuple[int, int, int, int]]:
+    choices: list[tuple[int, int, int, int]] = []
+    max_h = min(RECT_H_RANGE[1], (height - 2 * OUTER_MARGIN) // 2)
+    max_w = min(RECT_W_RANGE[1], width - 2 * OUTER_MARGIN)
