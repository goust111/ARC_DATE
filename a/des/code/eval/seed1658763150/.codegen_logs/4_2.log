+            parts = _count_grey_runs(g[r0, c0 : c1 + 1])
+            gap = c1 - c0 + 1
+            assert gap % parts == 0, "gap must split evenly into stripes"
+            stripe = gap // parts
+            for idx in range(parts):
+                value = left_rect["color"] if idx % 2 == 0 else BG
+                s0 = c0 + idx * stripe
+                s1 = s0 + stripe
+                out[left_rect["r0"] : left_rect["r1"] + 1, s0:s1] = value
+        else:
