+            assert left_rect["r0"] == right_rect["r0"] and left_rect["r1"] == right_rect["r1"], "horizontal pair must share row span"
+            assert left_rect["c1"] + 1 == c0 and right_rect["c0"] - 1 == c1, "bridge must exactly span the gap"
