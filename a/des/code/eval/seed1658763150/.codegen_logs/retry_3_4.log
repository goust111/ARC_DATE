# --------------- generator (attempt 3 (Codex)) ---------------

# --- Palette ---
BG = 0
GREY = 5
PALETTE = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)  # colors != bg and != grey

# --- Canvas geometry (fixed per spec) ---
H, W = 8, 20

# --- Frame (right-hand slot) ---
FRAME_R0, FRAME_C0 = 0, 9            # top-left of frame patch
FRAME_H, FRAME_W = 8, 11             # frame patch dimensions
LEFT_WALL_OPEN_ROWS = (4, 5)         # rows where the left wall of the frame is open

# --- Slot columns inside the frame ---
SLOT_COLS = [11, 13, 15, 17]         # absolute col indices
SLOT_LENS = [3, 4, 4, 3]             # per-col length counted from row 1
SLOT_TOP_ROW = 1                     # topmost interior row of slot columns

# --- Bar geometry ---
BAR_INPUT_C0 = 1                     # left column of bar in the input (pre-translation)
BAR_OUTPUT_C0 = 11                   # left column of bar in the expected output (post-translation)
BAR_R0 = 2                           # top row where bar patch is pasted
BAR_H, BAR_W = 4, 7                  # bar patch dimensions (4 rows tall, base at local row 3)
BAR_LOCAL_PROJ_COLS = [0, 2, 4, 6]   # bar projection columns within the patch
BAR_BASE_ABS_ROW = BAR_R0 + BAR_H - 1  # row 5, absolute row of bar base after paste

# --- Sampling parameters ---
HEIGHT0_RANGE = (2, 5)               # rng.integers(low, high) -> {2,3,4} for first proj
HEIGHT_REST_RANGE = (1, 5)           # rng.integers(low, high) -> {1,2,3,4} for other projs
MAX_ATTEMPTS = 300


def _frame_patch() -> np.ndarray:
    """Grey frame with top/bottom/right walls closed and a 2-cell gap in the left wall."""
    patch = np.zeros((FRAME_H, FRAME_W), dtype=int)
    patch[[0, -1], :] = GREY                       # top and bottom rows
    patch[:, -1] = GREY                            # right wall
    patch[:, 0] = GREY                             # left wall (solid...)
    patch[list(LEFT_WALL_OPEN_ROWS), 0] = BG       # ...with the opening carved out
    return patch


def _bar_patch(heights: list[int]) -> np.ndarray:
    """Horizontal bar base with 4 upward grey projections at local cols {0,2,4,6}."""
    patch = np.zeros((BAR_H, BAR_W), dtype=int)
    patch[-1, :] = GREY                            # full base row
    for local_c, height in zip(BAR_LOCAL_PROJ_COLS, heights):
        patch[BAR_H - height : BAR_H, local_c] = GREY
    return patch


def _paint_slot_column(grid: np.ndarray, col: int, length: int, color: int,
                       count: int, height: int | None) -> None:
    """Paint one slot column.

    Input mode (height=None): top (length-count) cells grey caps, bottom `count` cells the color.
    Output mode (height given): grey cap then up to (5-height) visible colored cells flush to top.
    """
    cap = length - count
    grid[SLOT_TOP_ROW : SLOT_TOP_ROW + cap, col] = GREY
    if height is None:
        grid[SLOT_TOP_ROW + cap : SLOT_TOP_ROW + length, col] = color
        return
    visible = min(count, BAR_BASE_ABS_ROW - height)  # = min(count, 5 - height)
    if visible > 0:
        row_end = BAR_BASE_ABS_ROW - height          # inclusive last colored row
        grid[row_end - visible + 1 : row_end + 1, col] = color


def _build_grid(heights: list[int], colors: list[int], colored_counts: list[int],
                bar_c0: int, output_mode: bool) -> np.ndarray:
    grid = np.zeros((H, W), dtype=int)
    paste(grid, _frame_patch(), FRAME_R0, FRAME_C0)
    paste(grid, _bar_patch(heights), BAR_R0, bar_c0)
    for col, length, color, count, height in zip(SLOT_COLS, SLOT_LENS, colors, colored_counts, heights):
        _paint_slot_column(grid, col, length, color, count, height if output_mode else None)
    return grid


def _sample_params(rng: np.random.Generator) -> tuple[list[int], list[int], list[int]]:
    colors = [int(v) for v in rng.choice(PALETTE, size=len(SLOT_COLS), replace=False)]
    colored_counts = [int(rng.integers(1, L + 1)) for L in SLOT_LENS]
    heights = [int(rng.integers(*HEIGHT0_RANGE))]
    heights.extend(int(rng.integers(*HEIGHT_REST_RANGE)) for _ in range(len(SLOT_COLS) - 1))
    return heights, colors, colored_counts


def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
    heights, colors, colored_counts = _sample_params(rng)
    grid = _build_grid(heights, colors, colored_counts, BAR_INPUT_C0, output_mode=False)
    expected = _build_grid(heights, colors, colored_counts, BAR_OUTPUT_C0, output_mode=True)

    if get_bg(grid) != BG:
        return None
    if sorted(colors_present(grid, exclude=[BG, GREY])) != sorted(colors):
        return None
    if not np.array_equal(main(grid), expected):
        return None
    return grid


def generate_input() -> np.ndarray:
    rng = np.random.default_rng()
    for _ in range(MAX_ATTEMPTS):
        grid = _gen_attempt(rng)
        if grid is not None:
            return grid
    raise RuntimeError(f"generate_input failed after {MAX_ATTEMPTS} attempts")
    if total_used > total:
        excess = total_used - total
        indices = list(range(n))
        random.shuffle(indices)
        for i in indices:
            shrink = min(widths[i] - min_size, excess)
            widths[i] -= shrink
            excess -= shrink
            if excess == 0:
                break
        if excess > 0:
            return None

    remaining = total - sum(widths) - (n - 1) * min_gap
    extra_gaps = [0] * (n + 1)
    for _ in range(remaining):
        extra_gaps[random.randint(0, n)] += 1

    bands = []
    pos = 0
    for i in range(n):
        pos += extra_gaps[i]
        if i > 0:
            pos += min_gap
        bands.append((pos, pos + widths[i] - 1))
        pos += widths[i]
    return bands


def _choose_orientation_counts(n_rects: int) -> tuple[int, int] | None:
    max_vert = min(n_rects, (MAX_W - SOURCE_EDGE_OFFSET) // 2)
    max_horiz = min(n_rects, (MAX_H - SOURCE_EDGE_OFFSET) // 2)
    feasible = [(v, n_rects - v) for v in range(n_rects + 1)
                if v <= max_vert and (n_rects - v) <= max_horiz]
    if not feasible:
        return None
    return random.choice(feasible)


def _choose_canvas(n_vert: int, n_horiz: int) -> tuple[int, int] | None:
    min_h = max(MIN_H, 2 * n_horiz + 1) if n_horiz > 0 else MIN_H
    min_w = max(MIN_W, 2 * n_vert + 1) if n_vert > 0 else MIN_W
    if min_h > MAX_H or min_w > MAX_W:
        return None
    return random.randint(min_h, MAX_H), random.randint(min_w, MAX_W)


def _interior_bands(total: int, n: int) -> list[tuple[int, int]] | None:
    raw = _partition_bands(total - 2, n, MIN_BAND_SIZE, MAX_BAND_SIZE, BAND_GAP)
    if raw is None:
        return None
    return [(a + SOURCE_EDGE_OFFSET, b + SOURCE_EDGE_OFFSET) for a, b in raw]


def _rect_span_for_band(band_size: int, travel: int) -> int | None:
    max_len = min(MAX_RECT_SIDE, travel // 2 - 1, MAX_RECT_AREA // band_size)
    min_len = max(MIN_BAND_SIZE, -(-MIN_RECT_AREA // band_size))
    if min_len > max_len:
        return None
    return random.randint(min_len, max_len)


def _build_rects(H: int, W: int, n_vert: int, n_horiz: int) -> list[tuple[int, int, int, int, str]] | None:
    """Return destination rectangles plus their original source edge."""
    vert_edges = [random.choice(["top", "bottom"]) for _ in range(n_vert)]
    horiz_edges = [random.choice(["left", "right"]) for _ in range(n_horiz)]

    col_bands = _interior_bands(W, n_vert)
    if col_bands is None:
        return None
    row_bands = _interior_bands(H, n_horiz)
    if row_bands is None:
        return None

    rects = []
    for i, (c0, c1) in enumerate(col_bands):
        rect_w = c1 - c0 + 1
        rect_h = _rect_span_for_band(rect_w, H)
        if rect_h is None:
            return None
        se = vert_edges[i]
        if se == "top":
            dr0, dr1 = H - rect_h, H - 1
        else:
            dr0, dr1 = 0, rect_h - 1
        rects.append((dr0, c0, dr1, c1, se))

    for i, (r0, r1) in enumerate(row_bands):
        rect_h = r1 - r0 + 1
        rect_w = _rect_span_for_band(rect_h, W)
        if rect_w is None:
            return None
        se = horiz_edges[i]
        if se == "left":
            dc0, dc1 = W - rect_w, W - 1
        else:
            dc0, dc1 = 0, rect_w - 1
        rects.append((r0, dc0, r1, dc1, se))

    return rects


def _random_background(shape: tuple[int, int], grey_frac: float) -> np.ndarray:
    return np.where(np.random.random(shape) < grey_frac, BG_GREY, BG_ORANGE).astype(int)


def _render_output(H: int, W: int, rects: list[tuple[int, int, int, int, str]], grey_frac: float) -> np.ndarray:
    output = _random_background((H, W), grey_frac)

    for (dr0, dc0, dr1, dc1, se) in rects:
        if se in ("top", "bottom"):
            output[:, dc0:dc1 + 1] = BG_ORANGE
        else:
            output[dr0:dr1 + 1, :] = BG_ORANGE

    for (dr0, dc0, dr1, dc1, _) in rects:
        output[dr0:dr1 + 1, dc0:dc1 + 1] = 0
    return output


def _invert_output_to_input(
    output: np.ndarray, rects: list[tuple[int, int, int, int, str]], grey_frac: float
) -> np.ndarray:
    H, W = output.shape
    inp = output.copy()

    for (dr0, dc0, dr1, dc1, se) in rects:
        if se in ("top", "bottom"):
            inp[:, dc0:dc1 + 1] = _random_background((H, dc1 - dc0 + 1), grey_frac)
        else:
            inp[dr0:dr1 + 1, :] = _random_background((dr1 - dr0 + 1, W), grey_frac)

    for (dr0, dc0, dr1, dc1, se) in rects:
        rh, rw = dr1 - dr0 + 1, dc1 - dc0 + 1
        if se == "top":
            inp[0:rh, dc0:dc1 + 1] = 0
        elif se == "bottom":
            inp[H - rh:H, dc0:dc1 + 1] = 0
        elif se == "left":
            inp[dr0:dr1 + 1, 0:rw] = 0
        else:
            inp[dr0:dr1 + 1, W - rw:W] = 0

    return inp


def _is_valid_pair(inp: np.ndarray, output: np.ndarray) -> bool:
    try:
        return bool(np.array_equal(main(inp), output))
    except Exception:
        return False


def _gen_attempt_with_count(n_rects: int) -> np.ndarray | None:
    """Generate a valid input with exactly n_rects black rectangles."""
    counts = _choose_orientation_counts(n_rects)
    if counts is None:
        return None
    n_vert, n_horiz = counts

    canvas = _choose_canvas(n_vert, n_horiz)
    if canvas is None:
        return None
    H, W = canvas

    rects = _build_rects(H, W, n_vert, n_horiz)
    if rects is None:
        return None

    grey_frac = random.uniform(GREY_FRAC_MIN, GREY_FRAC_MAX)
    output = _render_output(H, W, rects, grey_frac)
    inp = _invert_output_to_input(output, rects, grey_frac)
    return inp if _is_valid_pair(inp, output) else None


