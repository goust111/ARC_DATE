+def _dilate(coords: Iterable[Tuple[int, int]], h: int, w: int) -> set[Tuple[int, int]]:
+    out: set[Tuple[int, int]] = set()
+    for r, c in coords:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                rr = r + dr
+                cc = c + dc
+                if 0 <= rr < h and 0 <= cc < w:
+                    out.add((rr, cc))
