+        tr, tc = map(int, tower["center"])
+        signal = int(tower["color"])
+        for arm in tower["arms"]:
+            dr, dc = DIRS[arm]
+            r = tr + 2 * dr
+            c = tc + 2 * dc
+            while 0 <= r < h and 0 <= c < w:
+                if bool(static_blockers[r, c]):
+                    break
+                if bool(receiver_mask[r, c]):
+                    if int(out[r, c]) == YELLOW:
+                        out[r, c] = signal
+                    else:
