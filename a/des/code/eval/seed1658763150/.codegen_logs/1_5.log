+            tip = (tip_r, tip_c)
+            for extra in PERPENDICULARS[direction]:
+                pixels = _arrow_pixels(tip, direction, extra)
+                rows = [r for r, _ in pixels]
+                cols = [c for _, c in pixels]
+                if not all(r0 <= r <= r1 and c0 <= c <= c1 for r, c in pixels):
