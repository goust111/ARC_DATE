+    h, w = grid.shape
+    dr, dc = DIR_VECTORS[region.direction]
+    r, c = region.tip
+
+    while True:
+        nr, nc = r + dr, c + dc
+        assert 0 <= nr < h and 0 <= nc < w, "arrow path must hit a grey divider before leaving the grid"
