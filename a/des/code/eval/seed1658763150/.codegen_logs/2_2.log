+                grid[r, c] = sprite_color
+            _reserve(blocked, cells, h, w)
+            used_shadow_rows |= shadow_rows
+            top_rows.append(top_row)
+            placed = True
+            break
+        if not placed:
+            return None
+
+    if len(top_rows) < 2:
+        return None
+    if not any(row < light_row for row in top_rows):
+        return None
+    if not any(row > light_row for row in top_rows):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _sample_layout()
+        if grid is None:
