+def _trace_path(start: tuple[int, int], cells: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    path = [start]
+    prev: tuple[int, int] | None = None
+    cur = start
+    while True:
+        nxts = [pt for pt in _neighbors4(*cur) if pt in cells and pt != prev]
+        if not nxts:
+            break
+        if len(nxts) != 1:
