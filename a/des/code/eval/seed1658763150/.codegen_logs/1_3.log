+    divider_col, divider_color = _find_divider(g)
+    left = g[:, :divider_col]
+    learned = _learn_first_lengths(left)
+
+    out = g.copy()
+    out[out == YELLOW] = BG
+
+    row_lo, row_hi = 0, h
+    col_lo, col_hi = divider_col + 1, w
+    for yr, yc in np.argwhere(g == YELLOW):
+        if int(yc) <= divider_col:
