+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _perimeter_positions(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    pts: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        pts.append((r0, c))
+    for r in range(r0 + 1, r1):
+        pts.append((r, c1))
+    for c in range(c1, c0 - 1, -1):
+        pts.append((r1, c))
+    for r in range(r1 - 1, r0, -1):
+        pts.append((r, c0))
+    return pts
+
+
+def _find_fences(g: np.ndarray) -> list[tuple[int, int, int, int, int]]:
+    fences: list[tuple[int, int, int, int, int]] = []
+    for color in np.unique(g):
+        color = int(color)
+        if color == BG:
+            continue
+        coords = np.argwhere(g == color)
+        if coords.size == 0:
+            continue
+        r0, c0 = coords.min(axis=0)
+        r1, c1 = coords.max(axis=0)
+        r0 = int(r0)
+        c0 = int(c0)
+        r1 = int(r1)
+        c1 = int(c1)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 5 or w < 5:
+            continue
+
+        rel_r = coords[:, 0] - r0
+        rel_c = coords[:, 1] - c0
+        on_border = (rel_r == 0) | (rel_r == h - 1) | (rel_c == 0) | (rel_c == w - 1)
+        if not bool(np.all(on_border)):
+            continue
+
+        perimeter = 2 * (h + w) - 4
+        coverage = len(coords) / perimeter
+        if coverage < 0.65:
+            continue
+
+        if not (
+            np.any(coords[:, 0] == r0)
+            and np.any(coords[:, 0] == r1)
+            and np.any(coords[:, 1] == c0)
+            and np.any(coords[:, 1] == c1)
+        ):
+            continue
+
+        fences.append((r0, c0, r1, c1, color))
