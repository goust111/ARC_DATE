+def _occupy_box(occ: np.ndarray, r: int, c: int, ph: int, pw: int, pad: int) -> None:
+    h, w = occ.shape
+    rr0 = max(0, r - pad)
+    rr1 = min(h, r + ph + pad)
+    cc0 = max(0, c - pad)
+    cc1 = min(w, c + pw + pad)
+    occ[rr0:rr1, cc0:cc1] = True
