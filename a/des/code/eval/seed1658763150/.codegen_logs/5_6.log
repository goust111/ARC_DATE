+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+FENCE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GRID_H_RANGE = (18, 31)
+GRID_W_RANGE = (18, 31)
+REGION_COUNT_RANGE = (1, 4)  # high is exclusive
+REGION_H_RANGE = (8, 13)
+REGION_W_RANGE = (8, 13)
