+    if len(_mask_components(inp == GREY)) != obj_count:
+        return None
+    if int(np.count_nonzero((inp != BLACK) & (inp != GREY))) != obj_count:
+        return None
+
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
