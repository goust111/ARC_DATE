+def _place_room(
+    room: dict[str, object],
+    blocked: set[tuple[int, int]],
+    shape: tuple[int, int],
+) -> tuple[int, int] | None:
+    h, w = shape
+    box_h, box_w = room["shape"]
+    positions = [(r0, c0) for r0 in range(1, h - box_h) for c0 in range(1, w - box_w)]
