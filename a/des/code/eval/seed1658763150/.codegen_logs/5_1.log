+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= int(r) < int(shape[0]) and 0 <= int(c) < int(shape[1])
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(int(r) + dr, int(c) + dc) for dr, dc in DIRS4]
+
+
+def _components(cells: set[tuple[int, int]]) -> list[set[tuple[int, int]]]:
+    remaining = set(cells)
+    comps: list[set[tuple[int, int]]] = []
+    while remaining:
+        start = next(iter(remaining))
+        stack = [start]
+        comp = {start}
+        remaining.remove(start)
+        while stack:
+            r, c = stack.pop()
+            for nr, nc in _neighbors4(r, c):
+                if (nr, nc) in remaining:
+                    remaining.remove((nr, nc))
+                    comp.add((nr, nc))
+                    stack.append((nr, nc))
+        comps.append(comp)
+    return comps
+
+
+def _mask_components(mask: np.ndarray) -> list[set[tuple[int, int]]]:
+    coords = {tuple(map(int, pos)) for pos in np.argwhere(mask)}
+    return _components(coords)
+
+
+def _bbox(cells: set[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in cells]
+    cols = [c for _r, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _flood_from_border(walls: np.ndarray) -> np.ndarray:
+    h, w = walls.shape
+    reachable = np.zeros((h, w), dtype=bool)
+    stack: list[tuple[int, int]] = []
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if not walls[r, c] and not reachable[r, c]:
+                reachable[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not walls[r, c] and not reachable[r, c]:
+                reachable[r, c] = True
+                stack.append((r, c))
+
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and not walls[nr, nc] and not reachable[nr, nc]:
+                reachable[nr, nc] = True
+                stack.append((nr, nc))
+    return reachable
+
