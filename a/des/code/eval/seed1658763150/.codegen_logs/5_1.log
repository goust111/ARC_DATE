+def _boundary_of(interior: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    outer: set[tuple[int, int]] = set()
+    for r, c in interior:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                outer.add((r + dr, c + dc))
+    return outer - interior
