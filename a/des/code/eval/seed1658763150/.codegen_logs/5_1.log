+def _enclosed_after_closing(walls: np.ndarray, gap: tuple[int, int]) -> np.ndarray:
+    closed = walls.copy()
+    closed[int(gap[0]), int(gap[1])] = True
+    reachable = _flood_from_border(closed)
+    return (~closed) & (~reachable)
