+    length = int(room["length"])
+    ray_cells = set()
+    for k in range(length):
+        rr = r0 + gap_r + dr * k
+        cc = c0 + gap_c + dc * k
+        expected[rr, cc] = color
+        ray_cells.add((rr, cc))
+
+    absolute_room = {(r0 + r, c0 + c) for r, c in room["room_cells"]}
+    return absolute_room | ray_cells
