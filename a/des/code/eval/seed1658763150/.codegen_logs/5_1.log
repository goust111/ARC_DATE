+        interior_n = {(r + shift_r, c + shift_c) for r, c in interior}
+        boundary_n = {(r + shift_r, c + shift_c) for r, c in boundary}
+        gap_n = (gap[0] + shift_r, gap[1] + shift_c)
+        seed_n = (seed[0] + shift_r, seed[1] + shift_c)
