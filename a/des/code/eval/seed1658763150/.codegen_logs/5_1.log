+        return {
+            "color": int(color),
+            "step": tuple(step),
+            "interior": interior_n,
+            "boundary": boundary_n - {gap_n},
+            "room_cells": interior_n | boundary_n,
+            "gap": gap_n,
+            "seed": seed_n,
