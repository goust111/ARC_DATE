+def _analyze_region(
+    g: np.ndarray, grey_comp: set[tuple[int, int]]
+) -> tuple[int, int, int, int, int, int]:
+    r0, c0, r1, c1 = _bbox(grey_comp)
+    pr0 = max(0, r0 - 1)
+    pc0 = max(0, c0 - 1)
+    pr1 = min(g.shape[0] - 1, r1 + 1)
