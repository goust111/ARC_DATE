+    best_area = max(item[0] for item in candidates)
+    best = [item for item in candidates if item[0] == best_area]
+    assert len(best) == 1, "gap closure should be unique"
+    _area, black_count, seed_color, gap_r, gap_c, step_code = best[0]
+    step = {
+        -10: (-1, 0),
+        10: (1, 0),
+        -1: (0, -1),
+        1: (0, 1),
+    }[step_code]
