+
+    return {
+        "orientation": orientation,
+        "top_h": top_h,
+        "bottom_h": bottom_h,
+        "room_w": room_w,
+        "source_side": source_side,
+        "divider_color": divider_color,
+        "frame_colors": frame_colors,
+        "pattern": pattern,
+        "pattern_r0": row0,
+        "pattern_c0": col0,
+        "shape": (top_h + bottom_h + 3, room_w + 2),
