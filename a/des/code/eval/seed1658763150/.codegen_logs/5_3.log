+
+        found = None
+        for _ in range(PLACEMENT_ATTEMPTS):
+            r0 = random.randint(MODULE_MARGIN, h - mh - MODULE_MARGIN)
+            c0 = random.randint(MODULE_MARGIN, w - mw - MODULE_MARGIN)
