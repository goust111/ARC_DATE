+    pattern = module["pattern"]
+    divider_color = int(module["divider_color"])
+    pattern_cells = np.argwhere(pattern)
+
+    if module["orientation"] == "vertical":
+        room_h = int(module["room_h"])
+        left_w = int(module["left_w"])
+        right_w = int(module["right_w"])
