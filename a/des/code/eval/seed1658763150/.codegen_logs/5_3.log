+        if not _is_solid_rect(component):
+            continue
+        coords = component["coords"]
+        values = g[coords[:, 0], coords[:, 1]]
+        room = dict(component)
+        room["grey_coords"] = coords[values == GREY]
+        room["is_empty"] = bool(np.all(values == BLACK))
