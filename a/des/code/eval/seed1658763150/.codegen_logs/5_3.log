+
+def _draw_module(inp: np.ndarray, out: np.ndarray, module: dict, top: int, left: int) -> None:
+    mh, mw = module["shape"]
+    r0, c0 = int(top), int(left)
+    r1, c1 = r0 + mh - 1, c0 + mw - 1
