+    for grid in (inp, out):
+        grid[r0, c0 : c1 + 1] = int(top_color)
+        grid[r1, c0 : c1 + 1] = int(bottom_color)
+        grid[r0 : r1 + 1, c0] = int(left_color)
+        grid[r0 : r1 + 1, c1] = int(right_color)
