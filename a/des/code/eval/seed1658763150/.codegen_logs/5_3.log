+        divider_col = c0 + left_w + 1
+        for grid in (inp, out):
+            grid[r0 + 1 : r0 + room_h + 1, divider_col] = divider_color
+
+        if module["source_side"] == "left":
+            source_left = c0 + 1
+        else:
+            source_left = divider_col + 1
+        source_top = r0 + 1
+
+        for dr, dc in pattern_cells:
