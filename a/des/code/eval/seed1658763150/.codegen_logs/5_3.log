+
+    try:
+        if not np.array_equal(main(inp), out):
+            return None
+    except AssertionError:
+        return None
+
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input for puzzle 3")

