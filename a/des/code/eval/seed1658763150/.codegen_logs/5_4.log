from __future__ import annotations

import random

import numpy as np


BLACK = 0
COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))

# Generator bounds.
GRID_H_RANGE = (16, 24)
GRID_W_RANGE = (16, 24)
