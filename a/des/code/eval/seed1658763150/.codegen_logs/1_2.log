+    vals, counts = np.unique(grid[grid != int(bg)], return_counts=True)
+    assert len(vals) > 0, "expected a non-background color"
+    best = counts.max()
+    cands = vals[counts == best]
+    assert len(cands) == 1, "expected a unique dominant template color"
+    return int(cands[0])
