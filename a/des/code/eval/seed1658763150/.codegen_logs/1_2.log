+            if 0 < r < h - 1:
+                a = int(hole_ids[r - 1, c])
+                b = int(hole_ids[r + 1, c])
+                if a >= 0 and b >= 0 and a != b:
+                    pairs.add((min(a, b), max(a, b)))
+            if 0 < c < w - 1:
+                a = int(hole_ids[r, c - 1])
+                b = int(hole_ids[r, c + 1])
+                if a >= 0 and b >= 0 and a != b:
