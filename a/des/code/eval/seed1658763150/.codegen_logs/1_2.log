+                b = int(frag_id[r + 1, c])
+                if a >= 0 and b >= 0 and a != b:
+                    pairs.add((min(a, b), max(a, b)))
+            if 0 < c < w - 1:
+                a = int(frag_id[r, c - 1])
+                b = int(frag_id[r, c + 1])
+                if a >= 0 and b >= 0 and a != b:
