+    inner_w = max(c + mask.shape[1] for mask, (_r, c) in zip(slot_masks, positions, strict=False))
+    patch_h = inner_h + 2 * pad
+    patch_w = inner_w + 2 * pad
+    base = _irregular_template_rect(patch_h, patch_w)
