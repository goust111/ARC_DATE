+def _build_fragment_patch(
+    fragment_masks: list[np.ndarray], axis: str, adj_flags: list[bool]
+) -> tuple[np.ndarray, list[tuple[int, int]], list[int]] | None:
+    gaps = [1 if flag else random.randint(2, 4) for flag in adj_flags]
