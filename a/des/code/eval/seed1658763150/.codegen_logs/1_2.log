+    shifted: list[tuple[int, int]] = []
+    for idx, (mask, (r, c)) in enumerate(zip(slot_masks, positions, strict=False)):
+        rr = int(r + pad)
+        cc = int(c + pad)
+        base_view = base[rr : rr + mask.shape[0], cc : cc + mask.shape[1]]
+        assert bool(np.all(base_view[mask]))
