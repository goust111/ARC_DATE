+def _place_chain(
+    masks: list[np.ndarray],
+    axis: str,
+    gaps: list[int],
+    require_edges: list[bool],
+) -> list[tuple[int, int]] | None:
+    assert len(masks) >= 2
+    assert len(gaps) == len(masks) - 1
+    assert len(require_edges) == len(masks) - 1
+
+    positions: list[tuple[int, int]] = [(0, 0)]
+    for i in range(1, len(masks)):
+        prev = masks[i - 1]
+        curr = masks[i]
