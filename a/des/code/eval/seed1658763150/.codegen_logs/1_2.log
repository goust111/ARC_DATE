+            return None
+        cells = list(frontier)
+        random.shuffle(cells)
+        weights = []
+        for r, c in cells:
+            degree = sum(
+                1
+                for nr, nc in _neighbors4(r, c)
+                if 0 <= nr < side and 0 <= nc < side and bool(mask[nr, nc])
+            )
+            weights.append(3 if degree == 1 else 1)
+        choice = random.choices(cells, weights=weights, k=1)[0]
+        mask[choice] = True
