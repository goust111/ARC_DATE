+        for pts in _components(grid == int(color)):
+            r0, c0, r1, c1 = _bbox(pts)
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            mask[pts[:, 0] - r0, pts[:, 1] - c0] = True
+            frags.append(
+                {
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": mask,
+                    "color": int(color),
+                    "cells": [(int(rr), int(cc)) for rr, cc in pts],
+                    "area": int(len(pts)),
+                }
+            )
