+def _extract_slots(template_mask: np.ndarray) -> list[dict]:
+    bbox = _bbox(np.argwhere(template_mask))
+    r0, c0, r1, c1 = bbox
+    local = template_mask[r0 : r1 + 1, c0 : c1 + 1]
+    holes: list[dict] = []
+    for pts in _components(~local):
