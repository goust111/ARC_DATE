+        rows_b = {int(r + delta) for r in np.where(mask_b[:, 0])[0]}
+        return bool(rows_a & rows_b)
+    cols_a = {int(c) for c in np.where(mask_a[-1, :])[0]}
+    cols_b = {int(c + delta) for c in np.where(mask_b[0, :])[0]}
+    return bool(cols_a & cols_b)
