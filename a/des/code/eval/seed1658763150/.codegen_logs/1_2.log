+def _separator_pixels(template_mask: np.ndarray, slots: list[dict]) -> dict[tuple[int, int], list[tuple[int, int]]]:
+    slot_id = np.full(template_mask.shape, -1, dtype=int)
+    for idx, slot in enumerate(slots):
