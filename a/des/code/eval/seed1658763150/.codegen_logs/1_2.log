+def _fragment_adjacencies(grid: np.ndarray, bg: int, fragments: list[dict]) -> set[tuple[int, int]]:
+    frag_id = np.full(grid.shape, -1, dtype=int)
+    for idx, frag in enumerate(fragments):
+        for r, c in frag["cells"]:
