+    r0, c0, r1, c1 = _bbox(pts)
+    return np.asarray(mask[r0 : r1 + 1, c0 : c1 + 1], dtype=bool)
+
+
+def _mask_key(mask: np.ndarray) -> tuple[int, int, bytes]:
