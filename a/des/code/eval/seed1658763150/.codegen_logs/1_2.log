+        mask = np.zeros((hr1 - hr0 + 1, hc1 - hc0 + 1), dtype=bool)
+        mask[pts[:, 0] - hr0, pts[:, 1] - hc0] = True
+        holes.append(
+            {
+                "bbox": (r0 + hr0, c0 + hc0, r0 + hr1, c0 + hc1),
+                "mask": mask,
+                "cells": [(int(r0 + rr), int(c0 + cc)) for rr, cc in pts],
+                "area": int(len(pts)),
