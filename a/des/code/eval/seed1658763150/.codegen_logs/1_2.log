+
+def _largest_non_bg_color(grid: np.ndarray, bg: int) -> int:
+    vals, counts = np.unique(grid[grid != int(bg)], return_counts=True)
+    assert len(vals) > 0, "expected a non-background color"
+    best = counts.max()
