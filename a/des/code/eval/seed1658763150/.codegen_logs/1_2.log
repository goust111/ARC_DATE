+            expected_r = int(r)
+            expected_c = int(c)
+            # `_compose_grid` already placed the template at the unique grey component location.
+            # Recover the global offset from the slot positions.
+        # Color separators after the global offset is known below.
+
+    # Recover template top-left from one known slot cell.
+    first_slot_local = np.argwhere(slot_masks[0])[0]
+    first_slot_global = np.argwhere(expected == colors[0])
+    if len(first_slot_global) == 0:
