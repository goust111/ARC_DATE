+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+FRAGMENT_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+MAX_GENERATION_ATTEMPTS = 300
