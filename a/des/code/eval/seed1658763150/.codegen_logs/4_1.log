+
+BG = 0
+WALL = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GRID_MIN = 22
+GRID_MAX = 30
+TEMPLATE_COUNT_RANGE = (2, 4)
+REGION_EXTRA_RANGE = (0, 2)
