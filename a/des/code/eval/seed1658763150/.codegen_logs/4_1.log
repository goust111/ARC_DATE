+        assert r1 - r0 + 1 >= 3 and c1 - c0 + 1 >= 3, "legend frame must be at least 3x3"
+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        border = np.zeros_like(patch, dtype=bool)
+        border[0, :] = True
+        border[-1, :] = True
