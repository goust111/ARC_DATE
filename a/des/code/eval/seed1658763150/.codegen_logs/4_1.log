+    frontier = [start]
+    while frontier and int(mask.sum()) < area:
+        idx = rng.randrange(len(frontier))
+        r, c = frontier.pop(idx)
+        if mask[r, c]:
+            continue
+        mask[r, c] = True
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < height and 0 <= nc < width and not mask[nr, nc]:
+                frontier.append((nr, nc))
