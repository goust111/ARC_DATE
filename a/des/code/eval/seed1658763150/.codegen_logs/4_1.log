+        height = rng.randint(3, 5)
+        width = rng.randint(3, 5)
+        total = height * width
+        low = max(3, (total + 3) // 4)
+        high = max(low, min(total - 1, (2 * total) // 3))
+        area = rng.randint(low, high)
+        mask = _grow_connected_mask(height, width, area, rng)
