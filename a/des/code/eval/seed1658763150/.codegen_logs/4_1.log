+        if clipped:
+            height = rng.randint(max(4, ph - 1), min(9, ph + 3))
+            width = rng.randint(max(4, pw - 1), min(9, pw + 3))
+        else:
+            height = rng.randint(max(5, ph), min(10, ph + 4))
+            width = rng.randint(max(5, pw), min(10, pw + 4))
