+    out = g.copy()
+    for region in regions:
+        seed_r, seed_c = map(int, region["seed"])
+        color = int(region["color"])
+        mask = region["mask"]
+        pattern = templates[color]
+        for dr, dc in np.argwhere(pattern):
+            rr = seed_r + int(dr)
+            cc = seed_c + int(dc)
+            if 0 <= rr < g.shape[0] and 0 <= cc < g.shape[1] and mask[rr, cc]:
+                out[rr, cc] = color
