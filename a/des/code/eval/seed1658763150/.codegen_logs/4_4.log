+import numpy as np
+
+
+BG = 0
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+MAX_GENERATION_ATTEMPTS = 400
+PAIR_COUNT_CHOICES = (2, 3, 4)
+COLOR_POOL = tuple(range(1, 10))
