+            r0, c0, r1, c1 = _bbox_from_coords(coords)
+            rel = tuple(sorted((rr - r0, cc - c0) for rr, cc in coords))
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in rel:
+                mask[rr, cc] = True
+            objects.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "rel": rel,
+                    "mask": mask,
+                    "h": int(mask.shape[0]),
+                    "w": int(mask.shape[1]),
+                    "area": int(len(rel)),
