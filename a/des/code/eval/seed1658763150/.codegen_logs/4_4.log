        if not frontier:
            return False
        r, c = random.choice(tuple(frontier))
        mask[r, c] = True
    return True


def _gen_connected_corner_mask(corner: str, h: int, w: int) -> np.ndarray | None:
    sr, sc = _gen_source_local_corner(corner, h, w)
    er, ec = h - 1 - sr, w - 1 - sc
    mask = np.zeros((h, w), dtype=bool)

    if random.random() < 0.5:
