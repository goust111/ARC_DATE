+        top = int(obj["top"])
+        left = int(obj["left"])
+        view = out[top : top + 3, left : left + 3]
+        mask = patch != bg
+        view[mask] = patch[mask]
+
+    return out
+
+
+def _paint_arrow(grid: np.ndarray, direction: str, color: int, center: int) -> None:
+    h, w = grid.shape
+    if direction == "right":
+        patch = np.array([[1, 0], [1, 1], [1, 0]], dtype=int)
+        r0, c0 = center - 1, 0
+    elif direction == "left":
