+            for j in range(count):
+                shape = "U" if count == 2 else ("L_left" if rng.random() < 0.5 else "L_right")
+                patch = _paint_object_patch(direction, shape, object_colors[objects_added])
+                _place_patch(grid, patch, tops[j], left)
