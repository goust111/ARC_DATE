+        if picks is None:
+            return None
+        if direction == "right":
+            if all(final_lefts[i] - picks[i] >= 2 for i in range(count)):
+                return picks
+        else:
+            if all(picks[i] - final_lefts[i] >= 2 for i in range(count)):
+                return picks
