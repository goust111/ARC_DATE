+        side
+        for side, cond in (
+            ("top", r0 == 0),
+            ("bottom", r1 == h - 1),
+            ("left", c0 == 0),
+            ("right", c1 == w - 1),
+        )
+        if cond
+    }
+    if len(touches) != 1:
+        return None
+    side = next(iter(touches))
