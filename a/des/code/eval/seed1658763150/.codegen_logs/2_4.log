+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(400):
+        grid = _build_scene(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

