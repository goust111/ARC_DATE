+_DIRECTION_TURNS = {"up": 0, "right": 1, "down": 2, "left": 3}
+_PATTERNS_BY_DIRECTION: dict[str, list[np.ndarray]] = {}
+for _direction, _turns in _DIRECTION_TURNS.items():
