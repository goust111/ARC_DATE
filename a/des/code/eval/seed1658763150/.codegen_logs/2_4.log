+        else:
+            r0, r1 = sorted((mr0, mr1))
+            out[r0 : r1 + 1, mc0] = color
+
+    for obj in objects:
+        patch = obj["patch"]
+        top = int(obj["top"])
+        left = int(obj["left"])
+        view = out[top : top + 3, left : left + 3]
+        mask = patch != bg
+        view[mask] = patch[mask]
+
+    return out
+
+
+def _paint_arrow(grid: np.ndarray, direction: str, color: int, center: int) -> None:
+    h, w = grid.shape
