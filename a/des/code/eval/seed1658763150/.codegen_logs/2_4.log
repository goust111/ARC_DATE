+            proposals[idx] = shifted
+
+        if not proposals:
+            return
+
+        conflicts: set[int] = set()
+        items = list(proposals.items())
+        for i in range(len(items)):
+            idx_a, cells_a = items[i]
+            for j in range(i + 1, len(items)):
+                idx_b, cells_b = items[j]
