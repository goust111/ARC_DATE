+            grid[row_slice.start + lr, col_slice.start + lc] = color
+
+    for name, (mr, mc) in marker_starts.items():
+        rows, cols = quad_slices[name]
+        grid[rows.start + mr : rows.start + mr + 2, cols.start + mc : cols.start + mc + 2] = MARKER_COLOR
+
+    try:
