+def _local_to_global(name: str, q: int, r: int, c: int) -> Tuple[int, int]:
+    if name == "tl":
+        return r, c
+    if name == "tr":
+        return r, q - 1 - c
+    if name == "bl":
+        return q - 1 - r, c
+    if name == "br":
+        return q - 1 - r, q - 1 - c
+    raise ValueError(f"unknown quadrant: {name}")
+
+
+def _neighbors(r: int, c: int, h: int, w: int) -> List[Tuple[int, int]]:
+    out: List[Tuple[int, int]] = []
