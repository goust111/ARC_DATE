+        col_range = range(cross_col + 2, width - EDGE_BUFFER)
+
+    cells: list[tuple[int, int]] = []
+    for r in row_range:
+        for c in col_range:
+            if grid[r, c] == BLACK:
+                cells.append((r, c))
