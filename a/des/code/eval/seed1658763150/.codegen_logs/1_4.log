+        "tr": (_randint_inclusive(rng, 0, 1), width - 1 - _randint_inclusive(rng, 0, 1)),
+        "bl": (height - 1 - _randint_inclusive(rng, 0, 1), _randint_inclusive(rng, 0, 1)),
