+            prev[nxt] = cell
+            queue.append(nxt)
+    if goal not in prev:
+        return None
+
+    path: list[tuple[int, int]] = []
+    cur: tuple[int, int] | None = goal
+    while cur is not None:
+        path.append(cur)
+        cur = prev[cur]
+    path.reverse()
+    return path
