+    quadrant_colors: dict[str, int] = {}
+    label_mask = np.zeros_like(grid, dtype=bool)
+    for color in label_colors:
+        locations = np.argwhere(grid == color)
+        assert len(locations) == 1
+        cell = tuple(map(int, locations[0]))
