+QUADRANTS = ("tl", "tr", "bl", "br")
+LABEL_COLOR_BY_QUADRANT = {
+    "tl": BLUE,
+    "tr": RED,
+    "bl": GREEN,
+    "br": ORANGE,
+}
+ENDPOINT_COLORS = [YELLOW, MAGENTA, AZURE, MAROON]
+DIRS = [(-1, 0), (0, -1), (0, 1), (1, 0)]
