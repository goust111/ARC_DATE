+def _bfs_path(
+    blocked: np.ndarray, start: tuple[int, int], goal: tuple[int, int]
+) -> list[tuple[int, int]] | None:
+    height, width = blocked.shape
+    queue = deque([start])
+    prev: dict[tuple[int, int], tuple[int, int] | None] = {start: None}
+    while queue:
+        cell = queue.popleft()
+        if cell == goal:
