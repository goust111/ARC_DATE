+        a, b = cells
+        grid[a] = color
+        grid[b] = color
+        taken.extend([a, b])
+
+    try:
+        solved, records = _solve(grid, return_paths=True)
+    except AssertionError:
+        return None
+
+    if len(records) != 4:
