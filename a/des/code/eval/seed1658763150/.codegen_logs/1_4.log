+MIN_SIZE = 20
+MAX_SIZE = 25
+CROSS_MARGIN_MIN = 1
+CROSS_MARGIN_MAX = 3
+EDGE_BUFFER = 2
+OBSTACLE_COUNT_MIN = 3
+OBSTACLE_COUNT_MAX = 6
