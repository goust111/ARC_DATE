+def _full_bbox(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if len(pts) == 0:
+        return False
+    rows = pts[:, 0]
+    cols = pts[:, 1]
+    return (
+        int(rows.min()) == 0
+        and int(rows.max()) == mask.shape[0] - 1
+        and int(cols.min()) == 0
+        and int(cols.max()) == mask.shape[1] - 1
