+    order = sorted(range(len(shapes)), key=lambda i: -int(np.prod(np.asarray(shapes[i]["mask"]).shape)))
+    for idx in order:
+        shape = shapes[idx]
+        mask = np.asarray(shape["mask"], dtype=bool)
