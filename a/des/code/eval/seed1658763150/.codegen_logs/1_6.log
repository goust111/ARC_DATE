+def _random_path(start: tuple[int, int], end: tuple[int, int], rng: random.Random) -> list[tuple[int, int]]:
+    r, c = start
+    rr, cc = end
+    path = [(r, c)]
+    while (r, c) != (rr, cc):
+        options: list[tuple[int, int]] = []
+        if r < rr:
+            options.append((r + 1, c))
+        elif r > rr:
+            options.append((r - 1, c))
+        if c < cc:
+            options.append((r, c + 1))
+        elif c > cc:
+            options.append((r, c - 1))
+        r, c = rng.choice(options)
+        path.append((r, c))
+    return path
