+        reserved[r0 - 2 : r0 + sh + 2, c0 - 2 : c0 + sw + 2] = True
+    return True
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    height = rng.randint(GRID_SIDE_RANGE[0], GRID_SIDE_RANGE[1])
