+
+    for bbox, color in zip(frame_boxes, frame_colors):
+        r0, c0, r1, c1 = bbox
+        patch[r0, c0 : c1 + 1] = int(color)
+        patch[r1, c0 : c1 + 1] = int(color)
+        patch[r0 : r1 + 1, c0] = int(color)
+        patch[r0 : r1 + 1, c1] = int(color)
