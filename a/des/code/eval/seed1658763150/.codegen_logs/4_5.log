+    out = main(grid)
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _generate_once()
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate valid puzzle input after {MAX_GENERATION_ATTEMPTS} attempts")

