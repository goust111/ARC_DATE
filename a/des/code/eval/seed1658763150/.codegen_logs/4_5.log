+        patch[r1, lo : hi + 1] = BG
+    elif direction == "left":
+        patch[lo : hi + 1, c0] = BG
+    else:
+        patch[lo : hi + 1, c1] = BG
+
+
+def _build_tower(frame_colors: Sequence[int], core_color: int) -> np.ndarray:
+    layer_count = len(frame_colors)
