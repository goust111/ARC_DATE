+        patch[r0, lo : hi + 1] = BG
+    elif direction == "down":
+        patch[r1, lo : hi + 1] = BG
+    elif direction == "left":
+        patch[lo : hi + 1, c0] = BG
+    else:
+        patch[lo : hi + 1, c1] = BG
