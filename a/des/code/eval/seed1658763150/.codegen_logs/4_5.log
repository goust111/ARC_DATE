+    aligned = _open_intervals(core_start, core_end, side_ranges)
+    out = []
+    for layer in range(layer_count):
+        if layer == blocker:
+            interval = _random_side_interval(side_ranges[layer], outside_ranges)
+            assert interval is not None
+            out.append(interval)
+        else:
+            out.append(aligned[layer])
