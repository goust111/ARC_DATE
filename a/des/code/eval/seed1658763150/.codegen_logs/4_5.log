+    patches = []
+    cursor = 0
+    for layers in layer_counts:
+        tower_frame_colors = frame_colors[cursor : cursor + layers]
+        cursor += layers
+        core_color = random.choice(core_palette)
+        patch = _build_tower(tower_frame_colors, core_color)
