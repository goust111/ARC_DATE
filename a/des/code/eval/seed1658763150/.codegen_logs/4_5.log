+        min_c = extra_left
+        c0 = random.randint(min_c, max_c)
+        r0 = cursor
+        grid[r0 : r0 + patch.shape[0], c0 : c0 + patch.shape[1]] = patch
+        cursor += patch.shape[0] + gap
+    return grid
