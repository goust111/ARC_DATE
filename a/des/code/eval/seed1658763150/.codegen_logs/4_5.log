+    direction: str,
+    side_start: int,
+    side_end: int,
+    core_start: int,
+    core_end: int,
+    mode: str,
+) -> List[Optional[Tuple[int, int]]]:
+    assert side_start <= core_start <= core_end <= side_end
+
+    if mode == "open":
+        vis_start = random.randint(core_start, core_end)
+        vis_end = random.randint(vis_start, core_end)
+        return _open_intervals(layer_count, vis_start, vis_end, side_start, side_end)
+
+    if mode == "missing":
+        blocker = random.randrange(layer_count)
+        aligned = _open_intervals(layer_count, core_start, core_end, side_start, side_end)
