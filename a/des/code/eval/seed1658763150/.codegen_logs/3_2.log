+
+def _can_attach(
+    occupied: set[tuple[int, int]],
+    new_cells: set[tuple[int, int]],
+    current_exit: tuple[int, int],
+    next_entry: tuple[int, int],
+) -> bool:
+    if occupied & new_cells:
+        return False
+    return _cross_adjacencies(occupied, new_cells) == {(current_exit, next_entry)}
