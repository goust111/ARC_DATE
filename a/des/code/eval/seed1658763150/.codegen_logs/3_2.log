+    for start_idx in range(n):
+        for orient_idx, orient in enumerate(orientations[start_idx]):
+            if orient["entry_dir"] is not None:
+                continue
+            start_offset = (0, 0)
+            start_cells = {_add(cell, start_offset) for cell in fragments[start_idx]["coords"]}
+            dfs(
+                start_idx,
+                orient_idx,
+                start_offset,
