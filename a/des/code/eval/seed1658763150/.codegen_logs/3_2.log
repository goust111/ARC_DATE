+                used.add(int(next_idx))
+                placements.append((int(next_idx), int(next_orient_idx), next_offset))
+                dfs(
+                    next_idx,
+                    next_orient_idx,
+                    next_offset,
+                    used,
+                    occupied | next_cells,
+                    placements,
+                )
+                placements.pop()
+                used.remove(int(next_idx))
