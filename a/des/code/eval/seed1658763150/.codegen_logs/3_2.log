+def _normalize_sequence(seq: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    min_r = min(r for r, _ in seq)
+    min_c = min(c for _, c in seq)
+    return [(int(r - min_r), int(c - min_c)) for r, c in seq]
