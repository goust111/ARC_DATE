+                next_offset = _sub(next_entry_abs, next_entry_local)
+                next_cells = {_add(cell, next_offset) for cell in fragments[next_idx]["coords"]}
+                if not _can_attach(occupied, next_cells, current_exit, next_entry_abs):
+                    continue
