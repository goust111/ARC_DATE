+    for frag_idx, _orient_idx, offset in solution:
+        frag = fragments[int(frag_idx)]
+        for r, c in frag["coords"]:
+            rr, cc = _add((int(r), int(c)), offset)
+            painted.append((int(rr), int(cc), int(frag["color"])))
