+
+def _solve_fragments(fragments: list[dict]) -> list[tuple[int, int, tuple[int, int]]]:
+    orientations: list[list[dict]] = []
+    for frag_idx, frag in enumerate(fragments):
+        frag_orients = []
+        for entry_idx in (0, 1):
+            exit_idx = 1 - entry_idx
+            frag_orients.append(
