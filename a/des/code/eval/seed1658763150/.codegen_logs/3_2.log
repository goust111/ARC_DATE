+                    "frag_idx": int(frag_idx),
+                    "entry_idx": int(entry_idx),
+                    "exit_idx": int(exit_idx),
+                    "entry_dir": frag["endpoint_dirs"][entry_idx],
+                    "exit_dir": frag["endpoint_dirs"][exit_idx],
