_GEN_COLOR_COUNT_RANGE = (3, 7)
_GEN_PAINT_MODE_COUNT = 4
_GEN_KEEP_BASE_MODE_PROB = 0.65
_GEN_EXTRA_RECT_MIN, _GEN_EXTRA_RECT_SLACK = 0, 4

# Plus-mask placement controls.
