+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MAROON = 9
+PAINT_COLORS = (1, 2, 3, 4, 6, 7, 8)
+
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+CARDINALS = (UP, DOWN, LEFT, RIGHT)
+CLOCKWISE = {
+    UP: RIGHT,
+    RIGHT: DOWN,
+    DOWN: LEFT,
+    LEFT: UP,
+}
+HALO8 = tuple(
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
+)
+
+GEN_RETRIES = 500
+RAY_SOURCE_TRIES = 24
+RAY_SHAPE_TRIES = 20
