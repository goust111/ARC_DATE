def _spread_extra(widths, extra):
    widths = list(widths)
    for _ in range(int(extra)):
        widths[random.randrange(len(widths))] += 1
    return widths


def _blocked_from_heights(heights, H):
    first = []
    for h in heights:
        first.append(H - 1 if h == H else max(0, h - 1))
    return np.array(first, dtype=int)


def _pocket_count(heights):
    min_h = min(heights)
    count = 0
    in_run = False
    for h in heights:
        if h > min_h:
            if not in_run:
                count += 1
                in_run = True
        else:
            in_run = False
    return count


def _placement_runs(heights, H):
    """Return constant-depth pocket runs as (left, right, first_blocked_row)."""
    first_blocked = _blocked_from_heights(heights, H)
    min_h = min(heights)
    runs = []
    start = None
    depth = None
    for c, h in enumerate(heights + [min_h]):
        d = int(first_blocked[c]) if c < len(heights) else None
        ok = c < len(heights) and h > min_h and d >= 2
        if ok and start is None:
            start = c
            depth = d
        elif ok and d == depth:
            pass
        else:
            if start is not None:
                runs.append((start, c - 1, int(depth)))
                start = None
            if ok:
                start = c
                depth = d
    return runs


def _profile_is_valid(heights, H, W):
    if heights is None or len(heights) != W:
        return False
    min_distinct, max_distinct = DISTINCT_HEIGHT_COUNT_RANGE
    if not (min_distinct <= len(set(heights)) <= max_distinct):
        return False
    min_pockets, max_pockets = POCKET_COUNT_RANGE
    if not (min_pockets <= _pocket_count(heights) <= max_pockets):
        return False

    area = sum(H - h for h in heights if h < H)
    coverage = area / (H * W)
    min_coverage, max_coverage = OBSTACLE_COVERAGE_RANGE
    if not (min_coverage <= coverage <= max_coverage):
        return False
    if not any(h < H for h in heights):
        return False

    probe = np.zeros((H, W), dtype=int)
    for c, h in enumerate(heights):
        if h < H:
            probe[h:, c] = 1
    n_components = len(find_components(probe, bg=0, colors=[1], connectivity=4))
    min_components, max_components = OBSTACLE_COMPONENT_RANGE
    if not (min_components <= n_components <= max_components):
        return False
    return bool(_placement_runs(heights, H))


def _starts_from_actual_heights(actual_heights, H):
    return [H - h if h > 0 else H for h in actual_heights]


def _bottom_profile_is_eval_like(actual_heights, H, W):
    occupied = [h for h in actual_heights if h > 0]
    if not occupied:
        return False

    bottom_cols = len(occupied)
    total = sum(occupied)
    bottom3 = sum(min(h, BOTTOM_BAND_ROWS) for h in occupied)
    return (
        bottom_cols * BOTTOM_COLS_MIN_MULTIPLIER >= W
        and total * COLUMN_AVG_MAX_DEN <= bottom_cols * COLUMN_AVG_MAX_NUM
        and bottom3 * BOTTOM3_MIN_DEN >= total * BOTTOM3_MIN_NUM
    )


def _profile_bottom_heavy(H, W):
    for _ in range(PROFILE_RETRIES):
        actual = [1] * W

        if random.random() < LOW_COLUMN_EXTRA_PROB:
            for c in range(W):
                if random.random() < LOW_COLUMN_HEIGHT2_PROB:
                    actual[c] = 2

        n_runs = random.randint(1, min(TALL_RUN_COUNT_MAX, W))
        for _ in range(n_runs):
            width = 1
            if W >= TALL_RUN_WIDTH2_MIN_W and random.random() < TALL_RUN_WIDTH2_PROB:
                width = 2
            start = random.randint(0, W - width)
            tall = random.randint(min(H, SHORT_OBSTACLE_MAX_H), H)
            for c in range(start, start + width):
                actual[c] = max(actual[c], tall)

        if random.random() < MEDIUM_RUN_PROB:
            width = random.randint(1, min(MEDIUM_RUN_WIDTH_MAX, W))
            start = random.randint(0, W - width)
            medium = random.randint(MEDIUM_RUN_HEIGHT_MIN, min(H, SHORT_OBSTACLE_MAX_H))
            for c in range(start, start + width):
                actual[c] = max(actual[c], medium)

        heights = _starts_from_actual_heights(actual, H)
        if _bottom_profile_is_eval_like(actual, H, W) and _profile_is_valid(heights, H, W):
            return heights
    return None


def _place_width_runs(W, widths):
    total = sum(widths)
    if total > W:
        return None

    for _ in range(WIDTH_PLACEMENT_RETRIES):
        order = list(range(len(widths)))
        random.shuffle(order)
        occupied = [False] * W
        starts = [None] * len(widths)
        ok = True
        for idx in order:
            width = widths[idx]
            candidates = []
            for start in range(W - width + 1):
                if any(occupied[start : start + width]):
                    continue
                left_clear = start == 0 or not occupied[start - 1]
                right_clear = start + width == W or not occupied[start + width]
                if left_clear and right_clear:
                    candidates.append(start)
            if not candidates:
                ok = False
                break
            start = random.choice(candidates)
            starts[idx] = start
            for c in range(start, start + width):
                occupied[c] = True
        if ok:
            return starts
    return None


def _profile_sparse_posts(H, W):
    min_coverage, _ = OBSTACLE_COVERAGE_RANGE
    min_cols = max(
        math.ceil(W / SPARSE_POST_MIN_BOTTOM_FRAC),
        math.ceil(min_coverage * H * W),
    )
    max_cols = min(W - 1, math.floor(SPARSE_POST_MAX_BOTTOM_FRAC * W))
    if min_cols > max_cols:
        return None

    for _ in range(PROFILE_RETRIES):
        total_cols = random.randint(min_cols, max_cols)
        n_runs = random.randint(1, min(SPARSE_POST_RUN_COUNT_MAX, total_cols))
        widths = _spread_extra([1] * n_runs, total_cols - n_runs)

        starts = _place_width_runs(W, widths)
        if starts is None:
            continue

        actual = [0] * W
        for start, width in zip(starts, widths):
            post_h = 1 if random.random() < SPARSE_POST_HEIGHT1_PROB else min(2, H)
            for c in range(start, start + width):
                actual[c] = post_h

        heights = _starts_from_actual_heights(actual, H)
        if _bottom_profile_is_eval_like(actual, H, W) and _profile_is_valid(heights, H, W):
            return heights
    return None


def _make_profile(H, W):
    builders = [_profile_bottom_heavy] * BOTTOM_HEAVY_WEIGHT + [_profile_sparse_posts]
    random.shuffle(builders)
    for builder in builders:
        heights = builder(H, W)
        if _profile_is_valid(heights, H, W):
            return heights
    return None


def _shape_mask(max_h, max_w):
    """Sample a 4-connected object mask with a solid bottom row."""
    max_h = max(1, min(OBJECT_BBOX_MAX_H, int(max_h)))
    max_w = max(1, min(OBJECT_BBOX_MAX_W, int(max_w)))
    choices = []
    weights = []
    for h0 in range(1, max_h + 1):
        for w0 in range(1, max_w + 1):
            lo = w0 + max(0, h0 - 1)
            hi = min(OBJECT_AREA_RANGE[1], h0 * w0)
            if lo <= hi:
                choices.append((h0, w0, lo, hi))
                weights.append(w0 * w0)
    h, w, min_area, max_area = random.choices(choices, weights=weights, k=1)[0]

    target_area = random.randint(min_area, max_area)
    mask = np.zeros((h, w), dtype=bool)
    mask[-1, :] = True
    area = w

    prev_cols = list(range(w))
    for r in range(h - 2, -1, -1):
        c = random.choice(prev_cols)
        mask[r, c] = True
        area += 1
        prev_cols = [c]

    while area < target_area:
        frontier = []
        for r in range(h):
            for c in range(w):
                if mask[r, c]:
                    continue
                if (
                    (r > 0 and mask[r - 1, c])
                    or (r + 1 < h and mask[r + 1, c])
                    or (c > 0 and mask[r, c - 1])
                    or (c + 1 < w and mask[r, c + 1])
                ):
                    frontier.append((r, c))
        if not frontier:
            break
        r, c = random.choice(frontier)
        mask[r, c] = True
        area += 1
    return mask


def _choose_runs(runs, n_objects):
    pool = list(runs)
    chosen = []
    for _ in range(n_objects):
        weights = [(r[1] - r[0] + 1) ** 2 for r in pool]
        idx = random.choices(range(len(pool)), weights=weights, k=1)[0]
        chosen.append(pool.pop(idx))
    return chosen


def _stamp(grid, mask, r0, c0, bg, moving):
    patch = np.full(mask.shape, bg, dtype=int)
    patch[mask] = moving
    paste(grid, patch, r0, c0, transparent=bg)


def _render_obstacles(H, W, heights, bg, obstacle):
    base = np.full((H, W), bg, dtype=int)
    for c, h in enumerate(heights):
        if h < H:
            base[h:, c] = obstacle
    return base


def _place_settled_objects(base, runs, bg, moving):
    """Return settled output plus object specs (mask, row, col, lift)."""
    n_objects = random.randint(OBJECT_COUNT_RANGE[0], min(OBJECT_COUNT_RANGE[1], len(runs)))
    chosen = _choose_runs(runs, n_objects)

    out = base.copy()
    objects = []
    for c0_run, c1_run, free_depth in chosen:
        width = c1_run - c0_run + 1
        mask = _shape_mask(free_depth - 1, width)
        h, w = mask.shape
        c0 = random.randint(c0_run, c1_run - w + 1)
        r0 = free_depth - h
        if r0 < 1:
            return None, None
        shift = random.randint(MIN_LIFT_ROWS, min(MAX_LIFT_ROWS, r0))
        objects.append((mask, r0, c0, shift))
        _stamp(out, mask, r0, c0, bg, moving)
    return out, objects


def _lift_objects(base, objects, bg, moving):
    inp = base.copy()
    for mask, r0, c0, shift in objects:
        _stamp(inp, mask, r0 - shift, c0, bg, moving)
    return inp


def _components_are_valid(inp, bg, moving):
    comps = find_components(inp, bg=bg, colors=[moving], connectivity=4)
    if not (OBJECT_COUNT_RANGE[0] <= len(comps) <= OBJECT_COUNT_RANGE[1]):
        return False
    min_area, max_area = OBJECT_AREA_RANGE
    for comp in comps:
        r0, c0, r1, c1 = comp["bbox"]
        if not (
            min_area <= comp["area"] <= max_area
            and r1 - r0 + 1 <= OBJECT_BBOX_MAX_H
            and c1 - c0 + 1 <= OBJECT_BBOX_MAX_W
        ):
            return False
    return True


def _validate_generated_pair(base, inp, out, bg, obstacle, moving):
    blocked = _blocked_mask(base, obstacle)
    if np.any(blocked & (inp == moving)) or np.any(blocked & (out == moving)):
        return False

    try:
        _assert_output_separated(out, obstacle, moving)
    except AssertionError:
        return False

    if not _components_are_valid(inp, bg, moving):
        return False

    counts = np.bincount(inp.ravel(), minlength=PALETTE_SIZE)
    if counts[bg] <= max(counts[obstacle], counts[moving]):
        return False

    try:
        solved = main(inp)
    except Exception:
        return False
    return bool(np.array_equal(solved, out))


def _gen_attempt():
    """Build one output-first sample and validate it against the solver oracle."""
    H = random.randint(*GRID_H_RANGE)
    W = random.randint(*GRID_W_RANGE)
    heights = _make_profile(H, W)
    if heights is None:
        return None

    bg, obstacle, moving = random.sample(range(PALETTE_SIZE), 3)
    base = _render_obstacles(H, W, heights, bg, obstacle)
    runs = _placement_runs(heights, H)

    out, objects = _place_settled_objects(base, runs, bg, moving)
    if out is None:
        return None
    inp = _lift_objects(base, objects, bg, moving)

    if not _validate_generated_pair(base, inp, out, bg, obstacle, moving):
        return None
    return inp


def generate_input():

###FILE###
def main(grid: np.ndarray) -> np.ndarray:
    """
    Extend the diagonal blue ray through the grid, reflecting it off red line-segment mirrors.

    Input structure
    - Black-background grid with one diagonal 8-connected blue ray seed.
    - Red foreground objects, when present, are straight horizontal or vertical mirror segments.
    - Other foreground bars are transparent to the ray and may be overwritten where the ray crosses them.

    Rule
    - Start from the ray seed endpoint whose outward diagonal extension remains inside the grid.
    - Paint the ray continuously in that diagonal direction until it leaves the grid.
    - If the next cell is a red mirror, do not paint it; reflect by flipping the row direction on a horizontal mirror or the column direction on a vertical mirror.

    Key insight
    - The non-red bars are decoys: only red bars reflect the diagonal path, while all other crossed cells become blue.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    ray_color, seed = _ray_seed(g, bg)
    r, c, dr, dc = _initial_state(g.shape, seed)
    mirrors = _mirror_orientations(g, bg)

    out = g.copy()
    seen: set[tuple[int, int, int, int]] = set()
    while True:
        state = (r, c, dr, dc)
        assert state not in seen, "ray path must not loop"
        seen.add(state)

        nr, nc = r + dr, c + dc
        if not in_bounds(g.shape, nr, nc):
            break

        if int(g[nr, nc]) == Color.RED:
            orientation = mirrors.get((nr, nc))
            assert orientation is not None, "red cell must belong to a mirror segment"
            if orientation == "horizontal":
                dr = -dr
            else:
                assert orientation == "vertical"
                dc = -dc
            continue

        out[nr, nc] = ray_color
        r, c = nr, nc

    return out

# --------------- generator (att1) ---------------

# Canvas and color layout.
GRID_HEIGHT = 16
GRID_WIDTH = 16
BACKGROUND_COLOR = 0

# Ray and seed sampling ranges.
REFLECTION_COUNT_RANGE = (0, 4)
SEED_LENGTH_RANGE = (3, 6)
TOTAL_PATH_LENGTH_RANGE = (15, 16)
NEW_CELLS_RANGE = (9, 13)
DIAGONAL_CHOICES = (-1, 1)
START_EDGES = ("top", "bottom", "left", "right")

# Bar structure ranges and orientations.
BAR_LENGTH_RANGE = (4, 14)
MIRROR_ORIENTATIONS = ["horizontal", "vertical"]
DECOY_COUNT_RANGE = (0, 3)
DECOY_PLACEMENT_ATTEMPTS = 30

# Rejection sampling budget.
MAX_GENERATION_ATTEMPTS = 300


def _inside(r: int, c: int) -> bool:
    return 0 <= r < GRID_HEIGHT and 0 <= c < GRID_WIDTH


def _random_start_state() -> tuple[int, int, int, int]:
    """Choose a boundary cell with a diagonal direction whose backward extension is OOB."""
    edge = random.choice(START_EDGES)
    if edge == "top":
        return 0, random.randint(0, GRID_WIDTH - 1), 1, random.choice(DIAGONAL_CHOICES)
    if edge == "bottom":
        return (
            GRID_HEIGHT - 1,
            random.randint(0, GRID_WIDTH - 1),
            -1,
            random.choice(DIAGONAL_CHOICES),
        )
    if edge == "left":
        return random.randint(0, GRID_HEIGHT - 1), 0, random.choice(DIAGONAL_CHOICES), 1
    return (
        random.randint(0, GRID_HEIGHT - 1),
        GRID_WIDTH - 1,
        random.choice(DIAGONAL_CHOICES),
        -1,
    )


def _build_seed_cells(
    r0: int,
    c0: int,
    dr: int,
    dc: int,
    seed_len: int,
) -> list[tuple[int, int]] | None:
    cells = []
    for i in range(seed_len):
        sr, sc = r0 + i * dr, c0 + i * dc
        if not _inside(sr, sc):
            return None
        cells.append((sr, sc))
    return cells


def _split_path_segments(new_cells_needed: int, n_reflections: int) -> list[int] | None:
    """Partition painted cells across straight ray segments before each reflection."""
    if n_reflections == 0:
        return [new_cells_needed]
    if new_cells_needed < n_reflections + 1:
        return None

    cuts = sorted(random.sample(range(1, new_cells_needed), n_reflections))
    segments = []
    prev = 0
    for cut in cuts:
        segments.append(cut - prev)
        prev = cut
    segments.append(new_cells_needed - prev)
    return segments


def _walk_segment(
    r: int,
    c: int,
    dr: int,
    dc: int,
    seg_len: int,
    occupied: set[tuple[int, int]],
    path_cells: list[tuple[int, int]],
) -> tuple[int, int] | None:
    """Append seg_len new ray cells and return the segment endpoint."""
    for _ in range(seg_len):
        nr, nc = r + dr, c + dc
        if not _inside(nr, nc) or (nr, nc) in occupied:
            return None
        path_cells.append((nr, nc))
        occupied.add((nr, nc))
        r, c = nr, nc
    return r, c


def _reflected_direction(orientation: str, dr: int, dc: int) -> tuple[int, int]:
    if orientation == "horizontal":
        return -dr, dc
    return dr, -dc


def _segment_start_bounds(anchor: int, length: int, limit: int) -> tuple[int, int] | None:
    start_min = max(0, anchor - length + 1)
    start_max = min(anchor, limit - length)
    if start_min > start_max:
        return None

    interior_min = max(start_min, 1)
    interior_max = min(start_max, limit - length - 1) if length < limit else start_max
    if interior_min <= interior_max:
        return interior_min, interior_max
    return start_min, start_max


def _bar_cells_through(
    orientation: str,
    r: int,
    c: int,
    length: int,
) -> list[tuple[int, int]] | None:
    if orientation == "horizontal":
        bounds = _segment_start_bounds(c, length, GRID_WIDTH)
        if bounds is None:
            return None
        start = random.randint(*bounds)
        return [(r, start + j) for j in range(length)]

    bounds = _segment_start_bounds(r, length, GRID_HEIGHT)
    if bounds is None:
        return None
    start = random.randint(*bounds)
    return [(start + j, c) for j in range(length)]


def _try_place_mirror(
    r: int,
    c: int,
    dr: int,
    dc: int,
    occupied: set[tuple[int, int]],
) -> tuple[str, list[tuple[int, int]], int, int] | None:
    """Try both mirror orientations at the next ray cell and return the reflected direction."""
    mr, mc = r + dr, c + dc
    if not _inside(mr, mc) or (mr, mc) in occupied:
        return None

    orientations = MIRROR_ORIENTATIONS.copy()
    random.shuffle(orientations)
    for orientation in orientations:
        new_dr, new_dc = _reflected_direction(orientation, dr, dc)
        next_r, next_c = r + new_dr, c + new_dc
        if not _inside(next_r, next_c) or (next_r, next_c) in occupied:
            continue

        bar_len = random.randint(*BAR_LENGTH_RANGE)
        bar_cells = _bar_cells_through(orientation, mr, mc, bar_len)
        if bar_cells is None:
            continue

        bar_set = set(bar_cells)
        if bar_set & occupied:
            continue

        occupied |= bar_set
        return orientation, bar_cells, new_dr, new_dc
    return None


def _random_decoy_cells(orientation: str, length: int) -> list[tuple[int, int]] | None:
    if orientation == "horizontal":
        row = random.randint(0, GRID_HEIGHT - 1)
        start = random.randint(0, max(0, GRID_WIDTH - length))
        start = max(1, min(start, GRID_WIDTH - length - 1))
        if start < 0 or start + length > GRID_WIDTH:
            return None
        return [(row, start + j) for j in range(length)]

    col = random.randint(0, GRID_WIDTH - 1)
    start = random.randint(0, max(0, GRID_HEIGHT - length))
    start = max(1, min(start, GRID_HEIGHT - length - 1))
    if start < 0 or start + length > GRID_HEIGHT:
        return None
    return [(start + j, col) for j in range(length)]


def _place_decoys(
    occupied: set[tuple[int, int]],
    path_cells: list[tuple[int, int]],
) -> list[list[tuple[int, int]]]:
    decoy_bars = []
    path_set = set(path_cells)
    for _ in range(random.randint(*DECOY_COUNT_RANGE)):
        orientation = random.choice(MIRROR_ORIENTATIONS)
        length = random.randint(*BAR_LENGTH_RANGE)

        for _ in range(DECOY_PLACEMENT_ATTEMPTS):
            cells = _random_decoy_cells(orientation, length)
            if cells is None:
                continue

            cell_set = set(cells)
            if cell_set & occupied:
                continue
            if len(cell_set & path_set) > 2:
                continue

            decoy_bars.append(cells)
            occupied |= cell_set
            break
    return decoy_bars


def _paint_cells(grid: np.ndarray, cells: list[tuple[int, int]], color: int) -> None:
    for r, c in cells:
        grid[r, c] = color


def _render_input(
    seed_cells: list[tuple[int, int]],
    mirror_bars: list[tuple[str, list[tuple[int, int]]]],
    decoy_bars: list[list[tuple[int, int]]],
) -> np.ndarray:
    grid = np.full((GRID_HEIGHT, GRID_WIDTH), BACKGROUND_COLOR, dtype=int)
    _paint_cells(grid, seed_cells, Color.BLUE)
    for _orientation, bar_cells in mirror_bars:
        _paint_cells(grid, bar_cells, Color.RED)
    for cells in decoy_bars:
        _paint_cells(grid, cells, Color.GREEN)
    return grid


def _matches_solver_oracle(
    grid: np.ndarray,
    seed_cells: list[tuple[int, int]],
    path_cells: list[tuple[int, int]],
) -> bool:
    try:
        output = main(grid)
    except Exception:
        return False

    expected = grid.copy()
    _paint_cells(expected, path_cells, Color.BLUE)
    if not np.array_equal(output, expected):
        return False

    new_count = len(path_cells)
    total_path = len(seed_cells) + new_count
    return (
        NEW_CELLS_RANGE[0] <= new_count <= NEW_CELLS_RANGE[1]
        and TOTAL_PATH_LENGTH_RANGE[0] <= total_path <= TOTAL_PATH_LENGTH_RANGE[1]
    )


def _gen_attempt() -> np.ndarray | None:
    n_reflections = random.randint(*REFLECTION_COUNT_RANGE)
    r0, c0, dr, dc = _random_start_state()
    br, bc = r0 - dr, c0 - dc
    if _inside(br, bc):
        return None

    seed_len = random.randint(*SEED_LENGTH_RANGE)
    seed_cells = _build_seed_cells(r0, c0, dr, dc, seed_len)
    if seed_cells is None:
        return None

    total_target = random.randint(*TOTAL_PATH_LENGTH_RANGE)
    new_cells_needed = total_target - seed_len
    segments = _split_path_segments(new_cells_needed, n_reflections)
    if segments is None:
        return None

    r, c = seed_cells[-1]
    cur_dr, cur_dc = dr, dc
    occupied = set(seed_cells)
    path_cells: list[tuple[int, int]] = []
    mirror_bars: list[tuple[str, list[tuple[int, int]]]] = []

    for seg_idx, seg_len in enumerate(segments):
        endpoint = _walk_segment(r, c, cur_dr, cur_dc, seg_len, occupied, path_cells)
        if endpoint is None:
            return None
        r, c = endpoint

        if seg_idx < n_reflections:
            placed_mirror = _try_place_mirror(r, c, cur_dr, cur_dc, occupied)
            if placed_mirror is None:
                return None
            orientation, bar_cells, cur_dr, cur_dc = placed_mirror
            mirror_bars.append((orientation, bar_cells))

    final_nr, final_nc = r + cur_dr, c + cur_dc
    if _inside(final_nr, final_nc):
        return None

    decoy_bars = _place_decoys(occupied, path_cells)
    grid = _render_input(seed_cells, mirror_bars, decoy_bars)
    if not _matches_solver_oracle(grid, seed_cells, path_cells):
        return None

    return grid


