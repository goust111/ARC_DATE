from __future__ import annotations

import random
from typing import Dict, Iterable, List, Tuple

import numpy as np


BLACK = 0
BLUE = 1
RED = 2
GREEN = 3
YELLOW = 4
GREY = 5
MAGENTA = 6
ORANGE = 7
CYAN = 8
MAROON = 9

DIRS: Dict[str, Tuple[int, int]] = {
    "up": (-1, 0),
    "down": (1, 0),
    "left": (0, -1),
    "right": (0, 1),
}
VERTICAL = ("up", "down")
SIGNAL_COLORS = (BLUE, RED, GREEN, MAGENTA, CYAN)
GEN_RETRIES = 500


def _marker_length(grid: np.ndarray, r: int, c: int, side: str) -> int:
    dr, dc = DIRS[side]
    h, w = grid.shape
    length = 0
    rr = r + dr
    cc = c + dc
