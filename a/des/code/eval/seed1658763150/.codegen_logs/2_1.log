+
+
+def _render_legend(grid: np.ndarray, entries: list[tuple[int, np.ndarray]], rng: random.Random) -> None:
+    h, w = grid.shape
+    gap = rng.choice((0, 1))
+    legend_width = 3 * len(entries) + gap * (len(entries) - 1)
+    start_c = rng.randint(0, w - legend_width)
+    row0 = h - 3
+    c = start_c
