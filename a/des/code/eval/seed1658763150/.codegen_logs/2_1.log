+        "boundary": sorted(boundary),
+        "seed": seed,
+        "height": h,
+        "width": w,
+    }
+
+
+def _expanded_cells(cells: list[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:
+    expanded = set()
+    for r, c in cells:
+        for nr in range(r - 1, r + 2):
+            for nc in range(c - 1, c + 2):
+                if 0 <= nr < h and 0 <= nc < w:
+                    expanded.add((nr, nc))
