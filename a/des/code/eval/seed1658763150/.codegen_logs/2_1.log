+    legend = np.asarray(grid[-3:], dtype=int)
+    w = legend.shape[1]
+    mapping: dict[int, np.ndarray] = {}
+    c = 0
+    while c <= w - 3:
+        key = int(legend[0, c])
+        if key not in (BLACK, GREY, MAROON):
+            block = legend[:, c : c + 3]
+            mask = block == MAROON
+            # The keyed top-left cell is the anchored "growth" cell.
+            mask[0, 0] = True
+            mapping[key] = mask
+            c += 3
+        else:
+            c += 1
