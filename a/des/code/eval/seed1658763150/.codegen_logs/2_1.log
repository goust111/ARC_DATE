+        h, w = rng.choice(candidates)
+        cells = {(r, c) for r in range(h) for c in range(w)}
+        if h * w >= 4 and rng.random() < 0.5:
+            removable = [
+                (r, c)
+                for r, c in ((0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1))
+                if (r, c) in cells and (r, c) != (0, 0)
