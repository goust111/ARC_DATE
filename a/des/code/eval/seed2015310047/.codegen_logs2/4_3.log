+def _group_consecutive(indexes: list[int]) -> list[tuple[int, int]]:
+    groups: list[tuple[int, int]] = []
+    if not indexes:
+        return groups
+    start = prev = indexes[0]
+    for value in indexes[1:]:
+        if value == prev + 1:
+            prev = value
+            continue
+        groups.append((start, prev))
+        start = prev = value
+    groups.append((start, prev))
+    return groups
