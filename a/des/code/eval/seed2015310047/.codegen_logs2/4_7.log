GEN_SCALE_RANGE = (2, 5)
GEN_SEED_COUNTS = (2, 3)
GEN_SEED_FRACTION_RANGE = (0.20, 0.60)
GEN_FRAME_ROW_GAP = 2
GEN_FRAME_LEFT_MIN = 1
