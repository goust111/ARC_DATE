+    if local_r == h - 1:
+        hits.append("bottom")
+    if local_c == 0:
+        hits.append("left")
+    if local_c == w - 1:
+        hits.append("right")
+    assert len(hits) == 1, "yellow marker must lie on exactly one side"
+    return hits[0]
