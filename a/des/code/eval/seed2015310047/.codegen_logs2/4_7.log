        tr0, tc0, tr1, tc1 = target_bbox
        out[tr0 + 1 : tr1, tc0 + 1 : tc1] = mirrored

    return out


def _rectangles_too_close(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 1) -> bool:
    ar0, ac0, ar1, ac1 = a
