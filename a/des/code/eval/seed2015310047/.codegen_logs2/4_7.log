+            _frame_patch(empty_inner, tgt_side, tgt_marker),
+        ]
+        if add_far_empty:
+            far_side, far_marker = _sample_marker(outer_h, outer_w)
+            patches.append(_frame_patch(empty_inner, far_side, far_marker))
+
+        for box, patch in zip(boxes, patches):
