+
+    specs = []
+    for border_color, seed_color, direction in zip(border_colors, seed_colors, directions):
+        inner_h = random.randint(MIN_INNER, max_inner)
+        inner_w = random.randint(MIN_INNER, max_inner)
+        specs.append(
