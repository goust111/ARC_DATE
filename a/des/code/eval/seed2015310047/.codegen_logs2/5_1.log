+def _edge_strip(shape: tuple[int, int], side: str) -> np.ndarray:
+    h, w = shape
+    mask = np.zeros((h, w), dtype=bool)
+    if side == "top":
+        mask[:LEGEND_THICKNESS, :] = True
+    elif side == "bottom":
+        mask[h - LEGEND_THICKNESS :, :] = True
+    elif side == "left":
+        mask[:, :LEGEND_THICKNESS] = True
+    else:
+        mask[:, w - LEGEND_THICKNESS :] = True
+    return mask
