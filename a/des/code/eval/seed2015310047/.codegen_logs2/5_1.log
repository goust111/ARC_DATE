+
+    expected = _expected_output(grid, regions)
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+
+    found_regions = _find_regions(grid, bg)
+    if len(found_regions) != region_count:
+        return None
+    return grid
