+def _generate_once() -> np.ndarray | None:
+    region_count = random.randint(MIN_REGIONS, MAX_REGIONS)
+    side = random.choice(("top", "bottom", "left", "right"))
+
+    min_axis = max(GRID_MIN, 4 * region_count + 4)
+    if side in {"top", "bottom"}:
