+
+
+def _body_bounds(h: int, w: int, side: str) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = 1, 1, h - 2, w - 2
+    if side == "top":
+        r0 = LEGEND_THICKNESS + LEGEND_GAP
+    elif side == "bottom":
+        r1 = h - LEGEND_THICKNESS - LEGEND_GAP - 1
+    elif side == "left":
