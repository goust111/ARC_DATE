+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+LEGEND_THICKNESS = 3
+LEGEND_GAP = 1
+MIN_REGIONS = 2
+MAX_REGIONS = 4
+MIN_INNER = 3
+MAX_INNER_SMALL = 5
+MAX_INNER_LARGE = 6
