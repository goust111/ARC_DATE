+    axis_len = w if side in {"top", "bottom"} else h
+    positions = _sample_spaced_positions(axis_len, len(entries))
+    if positions is None:
+        return False
+
+    for (seed_color, (dr, dc)), pos in zip(entries, positions):
+        if side == "top":
+            key = (1, pos)
+        elif side == "bottom":
+            key = (h - 2, pos)
+        elif side == "left":
+            key = (pos, 1)
+        else:
+            key = (pos, w - 2)
