+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+LEGEND_THICKNESS = 3
+LEGEND_GAP = 1
+MIN_REGIONS = 2
+MAX_REGIONS = 4
+MIN_INNER = 3
+MAX_INNER_SMALL = 5
+MAX_INNER_LARGE = 6
+GRID_MIN = 20
+GRID_MAX = 28
+PLACEMENT_RETRIES = 200
+GEN_RETRIES = 400
+COLORS = tuple(range(10))
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    vals, cnts = np.unique(grid, return_counts=True)
+    return int(vals[int(np.argmax(cnts))])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((int(rr), int(cc)))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _perimeter_cells(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    cells = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _find_regions(grid: np.ndarray, bg: int) -> list[dict[str, int]]:
+    h, w = grid.shape
+    regions: list[dict[str, int]] = []
+    for color in (int(v) for v in np.unique(grid) if int(v) != bg):
+        for comp in _components(grid == color):
+            if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in comp):
+                continue
+            r0, c0, r1, c1 = _bbox(comp)
+            if r1 - r0 < 2 or c1 - c0 < 2:
+                continue
+            frame = _perimeter_cells(r0, c0, r1, c1)
+            if set(comp) != frame:
+                continue
+
+            interior = grid[r0 + 1 : r1, c0 + 1 : c1]
+            non_bg = np.argwhere(interior != bg)
+            if non_bg.shape[0] != 1:
+                continue
+            sr = int(non_bg[0, 0] + r0 + 1)
+            sc = int(non_bg[0, 1] + c0 + 1)
+            seed_color = int(grid[sr, sc])
+            if seed_color == color:
+                continue
+
+            regions.append(
+                {
+                    "border_color": int(color),
+                    "seed_color": int(seed_color),
+                    "r0": int(r0),
+                    "c0": int(c0),
+                    "r1": int(r1),
+                    "c1": int(c1),
+                    "seed_r": int(sr),
+                    "seed_c": int(sc),
+                }
+            )
+    return regions
