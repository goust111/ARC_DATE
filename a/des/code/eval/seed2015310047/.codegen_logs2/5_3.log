+    return _components(mask)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Keep only the interior pattern whose area matches the number of one-cell border gaps.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
