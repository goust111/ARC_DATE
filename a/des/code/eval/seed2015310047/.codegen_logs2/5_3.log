+
+# --------------- generator ---------------
+
+GEN_ATTEMPTS = 400
+GRID_ROWS_RANGE = (2, 3)
+GRID_COLS_RANGE = (2, 3)
+CELL_HEIGHT_RANGE = (6, 7)
+CELL_WIDTH_RANGE = (6, 7)
+MARGIN_RANGE = (0, 2)
