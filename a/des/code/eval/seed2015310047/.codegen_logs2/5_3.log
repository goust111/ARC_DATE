+
+
+def _paint_random_gaps(
+    patch: np.ndarray, bg: int, h_lines: list[int], v_lines: list[int]
+) -> tuple[np.ndarray, np.ndarray] | None:
+    nr = len(h_lines) - 1
+    nc = len(v_lines) - 1
+
