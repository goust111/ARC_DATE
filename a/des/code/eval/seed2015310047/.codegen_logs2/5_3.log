+        if best is None or score > best:
+            best = score
+            best_data = (int(color), h_rows, v_cols)
+
+    assert best_data is not None and best is not None and best[0] == 1
+    return best_data
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
