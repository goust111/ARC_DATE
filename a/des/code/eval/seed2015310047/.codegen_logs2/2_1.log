+def _find_legend(grid: np.ndarray, bg: int) -> tuple[int, int, int, dict[int, int], np.ndarray]:
+    best = None
+    h, w = grid.shape
+    search_rows = min(h, max(4, h // 3))
+    for r in range(search_rows):
