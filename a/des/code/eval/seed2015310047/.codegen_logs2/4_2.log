+    assert np.array_equal(out[:, wall_c + 1 :], grid[:, wall_c + 1 :])
+
+    left = _row_projection_colors(grid, wall_c, wall_color, bg, "left")
+    right = _row_projection_colors(grid, wall_c, wall_color, bg, "right")
+    for r in range(grid.shape[0]):
