+    return comps
+
+
+def _validate_generated_input(grid: np.ndarray) -> None:
+    assert isinstance(grid, np.ndarray)
+    assert grid.ndim == 2
+    assert np.any(grid == BACKGROUND)
+
+    bg = _dominant_color(grid)
+    assert bg == BACKGROUND
+    wall_c, wall_color = _find_wall(grid, bg)
