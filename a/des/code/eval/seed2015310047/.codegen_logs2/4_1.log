+def _draw_grid(h: int, w: int, boxes: list[dict]) -> np.ndarray:
+    grid = np.full((h, w), BG_COLOR, dtype=int)
+    colors = random.sample(SEED_COLORS, k=len(boxes))
+    for box, color in zip(boxes, colors):
+        box["color"] = int(color)
