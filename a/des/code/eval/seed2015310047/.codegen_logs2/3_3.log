+            raise ValueError(f"legend color {color} is absent from the canvas")
+        r0, c0 = pts.min(axis=0)
+        r1, c1 = pts.max(axis=0)
+        rects[color] = (int(r0), int(c0), int(r1), int(c1))
+
+    return _render_from_order(height, width, rects, legend_order)
