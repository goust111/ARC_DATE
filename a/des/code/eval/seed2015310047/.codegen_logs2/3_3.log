+    color = int(zone[start_r, start_c])
+    stack = [(start_r, start_c)]
+    visited[start_r, start_c] = True
+    cells: List[Tuple[int, int]] = []
+    h, w = zone.shape
+
+    while stack:
+        r, c = stack.pop()
+        cells.append((r, c))
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
