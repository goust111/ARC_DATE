+    min_area = max(6, (patch_h * patch_w) // 4)
+    if min_area >= patch_h * patch_w:
+        return None
+    area = random.randint(min_area, min(max_area, patch_h * patch_w - 1))
+    patch = _random_connected_mask(patch_h, patch_w, area)
+    if patch is None:
+        return None
+
