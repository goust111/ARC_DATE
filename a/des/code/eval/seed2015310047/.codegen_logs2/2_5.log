    left_mask = left != bg
    mid_mask = mid != bg

    a_points: list[tuple[int, int]] = []
    b_points: list[tuple[int, int]] = []
    for r in range(h):
        for c in range(region_w):
            left_on = bool(left_mask[r, c])
            mc = region_w - 1 - c
            mid_on = bool(mid_mask[r, mc])
