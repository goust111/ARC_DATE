+
+    pairs = list(zip(a_points, b_points))
+    counts = _line_counts(pairs, h, region_w)
+
+    out = np.asarray(grid, dtype=int).copy()
+    out[:, sep2 + 1 :] = bg
+    out[:, sep2 + 1 :][counts == 1] = RED
+    out[:, sep2 + 1 :][counts >= 2] = YELLOW
+    return out
