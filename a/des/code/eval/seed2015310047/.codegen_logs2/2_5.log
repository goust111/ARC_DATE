    out[:, sep2 + 1 :] = bg
    out[:, sep2 + 1 :][counts == 1] = RED
    out[:, sep2 + 1 :][counts >= 2] = YELLOW
    return out


def _random_connected_mask(height: int, width: int, area: int) -> np.ndarray | None:
    mask = np.zeros((height, width), dtype=bool)
