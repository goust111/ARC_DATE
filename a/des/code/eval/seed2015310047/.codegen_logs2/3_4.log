+from __future__ import annotations
+
+import random
+from itertools import combinations
+
+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+GREY = 5
+MAROON = 9
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_VISIBLE_COLORS = (1, 2, 3, 6, 7, 8)
+GEN_REGION_COLORS = (BLACK,) + GEN_VISIBLE_COLORS
