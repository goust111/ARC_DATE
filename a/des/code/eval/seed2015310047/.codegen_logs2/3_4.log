+def _arrow_info(grid: np.ndarray, cells: list[tuple[int, int]]) -> tuple[tuple[int, int], list[tuple[int, int]]] | None:
+    arrow = [(int(r), int(c)) for r, c in cells if int(grid[r, c]) == MAROON]
