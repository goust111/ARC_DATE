+def _random_partition(rows: int, cols: int) -> list[list[tuple[int, int]]]:
+    unassigned = {(r, c) for r in range(rows) for c in range(cols)}
+    groups: list[list[tuple[int, int]]] = []
+    size_choices = [1, 2, 2, 3, 3, 4]
