+
+
+def _assign_colors(n_regions: int, arrows: list[dict[str, object]]) -> dict[int, int]:
+    colors: dict[int, int] = {}
+    incoming: dict[int, list[int]] = {}
+    for arrow in arrows:
+        incoming.setdefault(int(arrow["target"]), []).append(int(arrow["source"]))
+
+    for target, sources in incoming.items():
+        if len(sources) > 1:
