+def _trace_target(
+    grid: np.ndarray,
+    labels: np.ndarray,
+    source: int,
+    start: tuple[int, int],
+    direction: tuple[int, int],
+) -> tuple[int, int] | None:
+    h, w = grid.shape
+    dr, dc = direction
+    r, c = start
+    dist = 0
+    while True:
+        nr, nc = r + dr, c + dc
+        if not (0 <= nr < h and 0 <= nc < w):
+            return None
