+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _perpendiculars(direction: tuple[int, int]) -> list[tuple[int, int]]:
+    dr, dc = direction
+    return [(-dc, dr), (dc, -dr)]
