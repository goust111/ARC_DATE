    root, children = _build_tree(specs)

    def build(color: int) -> np.ndarray:
        spec = specs[color]
        h, w = map(int, spec["shape"])
        out = np.full((h, w), BG, dtype=int)
        out[0, :] = color
        out[-1, :] = color
        out[:, 0] = color
        out[:, -1] = color

