    ph, pw = map(int, parent_shape)
    sh, sw = map(int, scaled_shape)
    centers = []
    for r in range(2, ph - 2):
        for c in range(2, pw - 2):
            top = r - sh // 2
            left = c - sw // 2
            if 1 <= top and top + sh <= ph - 1 and 1 <= left and left + sw <= pw - 1:
                centers.append((r, c))
