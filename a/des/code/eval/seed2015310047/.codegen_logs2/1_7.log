+def _find_plus_center(patch: np.ndarray) -> tuple[int, int] | None:
+    azure = np.argwhere(patch == AZURE)
+    if azure.size == 0:
+        return None
+    assert azure.shape[0] == 5, "azure marker must be a 5-cell plus"
+    azure_set = {tuple(map(int, pt)) for pt in azure}
