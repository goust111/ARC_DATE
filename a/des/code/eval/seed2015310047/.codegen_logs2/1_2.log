+def _extract_fragments(g: np.ndarray, stripe_mask: np.ndarray) -> list[dict]:
+    frag_mask = (g != BLACK) & (g != GREY) & (~stripe_mask)
+    fragments: list[dict] = []
+    for coords in _components(frag_mask):
+        mask, box = _tight_mask(coords)
