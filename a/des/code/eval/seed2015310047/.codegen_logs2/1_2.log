+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GRID_MIN = 22
+GRID_MAX = 30
