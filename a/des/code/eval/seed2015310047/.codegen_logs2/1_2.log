+def _detect_stripes(g: np.ndarray) -> tuple[dict[int, int], dict[int, int], np.ndarray]:
+    h, w = g.shape
+    row_stripes: dict[int, int] = {}
+    col_stripes: dict[int, int] = {}
+    for r in range(h):
+        if np.all(g[r, :] == g[r, 0]):
+            color = int(g[r, 0])
+            if color not in (BLACK, GREY):
+                row_stripes[int(r)] = color
