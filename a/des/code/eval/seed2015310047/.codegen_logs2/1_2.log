+        coords = np.argwhere(frag_mask) + np.array([[top, left]])
+        fragments.append({"coords": coords})
+
+    expected = _expected_output(grid, templates, fragments)
+    return grid, expected
+
+
+def generate_input() -> np.ndarray:
