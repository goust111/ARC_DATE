+        if len(holes) != 1:
+            continue
+
+        hole_rel = holes[0]
+        hole_mask, _ = _tight_mask(hole_rel)
+        hole_abs = hole_rel + np.array([[r0, c0]])
+        templates.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "direction": direction,
+                "hole_mask": hole_mask,
+                "hole_abs": hole_abs,
+            }
+        )
