+    order = sorted(range(len(templates)), key=lambda i: len(candidates[i]))
+    assignment: dict[int, tuple[int, int]] = {}
+    used: set[int] = set()
+
+    def backtrack(idx: int) -> bool:
+        if idx == len(order):
+            return True
+        ti = order[idx]
+        for fi, rot in candidates[ti]:
+            if fi in used:
+                continue
+            used.add(fi)
+            assignment[ti] = (fi, rot)
+            if backtrack(idx + 1):
+                return True
+            used.remove(fi)
+            assignment.pop(ti, None)
+        return False
