+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GRID_MIN = 22
+GRID_MAX = 30
+STRIPE_COUNT_RANGE = (2, 4)
+TEMPLATE_COUNT_RANGE = (2, 4)
+BAND_SIZE_RANGE = (5, 7)
+GEN_ATTEMPTS = 400
+PLACE_ATTEMPTS = 120
+SHAPE_ATTEMPTS = 200
