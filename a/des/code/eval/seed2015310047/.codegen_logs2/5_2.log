+        cells = {seed}
+        frontier = {p for p in _neighbors4(*seed) if 0 <= p[0] < h and 0 <= p[1] < w}
+        while len(cells) < area and frontier:
+            pick = rng.choice(tuple(frontier))
+            frontier.remove(pick)
+            cells.add(pick)
+            for np_r, np_c in _neighbors4(*pick):
