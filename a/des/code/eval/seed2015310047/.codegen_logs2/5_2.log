+def _find_fragments(grid: np.ndarray, bg: int, frame_colors: set[int], marker_positions: set[tuple[int, int]]) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    movable = g != bg
+    for fc in frame_colors:
+        movable &= g != int(fc)
+    fragments: list[dict] = []
