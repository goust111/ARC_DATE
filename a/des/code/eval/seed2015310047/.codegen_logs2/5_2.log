+        for r, c in frag["coords"]:
+            out[r, c] = bg
+
+    by_anchor: dict[int, list[dict]] = {}
+    for frag in fragments:
+        by_anchor.setdefault(int(frag["anchor_color"]), []).append(frag)
+
+    for frame in frames:
+        marker_color = int(frame["marker_color"])
