+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+FRAME_COLOR = 5
+GEN_RETRIES = 400
+PLACE_RETRIES = 250
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in DIR4:
+        yield r + dr, c + dc
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _components_from_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _coords_to_mask(coords: np.ndarray) -> tuple[np.ndarray, tuple[int, int]]:
+    r0, c0, r1, c1 = _bbox(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    shifted = coords - np.array([r0, c0], dtype=int)
+    mask[shifted[:, 0], shifted[:, 1]] = True
+    return mask, (r0, c0)
+
+
+def _touches_border(coords: np.ndarray, shape: tuple[int, int]) -> bool:
+    h, w = shape
+    return bool(
+        np.any(coords[:, 0] == 0)
+        or np.any(coords[:, 1] == 0)
+        or np.any(coords[:, 0] == h - 1)
+        or np.any(coords[:, 1] == w - 1)
+    )
+
+
+def _rotate_point_ccw(point: tuple[int, int], shape: tuple[int, int], k: int) -> tuple[int, int]:
+    r, c = map(int, point)
+    h, w = map(int, shape)
+    for _ in range(k % 4):
+        r, c = w - 1 - c, r
+        h, w = w, h
+    return int(r), int(c)
+
+
+def _mask_has_internal_hole(mask: np.ndarray) -> bool:
+    inv = ~mask
+    for comp in _components_from_mask(inv):
+        if not _touches_border(comp, mask.shape):
+            return True
+    return False
