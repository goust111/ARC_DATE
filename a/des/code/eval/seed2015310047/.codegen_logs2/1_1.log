+                frontier.append((rr, cc))
+                adj = sum(mask[nr, nc] for nr, nc in _neighbors4(rr, cc, h, w))
+                weights.append(int(adj))
+        if not frontier:
+            return None
+        choice = random.choices(frontier, weights=weights, k=1)[0]
