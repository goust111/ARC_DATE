+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+ALL_COLORS = tuple(range(1, 10))
+MAX_GENERATION_ATTEMPTS = 400
+
+N_COLORS_CHOICES = (2, 3, 4, 5)
+SEED_H_RANGE = (3, 7)
+SEED_W_RANGE = (3, 7)
+SEED_MARGIN_RANGE = (1, 3)
+GRID_H_RANGE = (14, 24)
+GRID_W_RANGE = (14, 24)
+PLACEMENT_RETRIES = 120
