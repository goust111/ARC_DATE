+
+
+def _partition_mask(mask: np.ndarray, n_regions: int) -> np.ndarray | None:
+    cells = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    if len(cells) < 2 * n_regions:
+        return None
+    seeds = random.sample(cells, n_regions)
