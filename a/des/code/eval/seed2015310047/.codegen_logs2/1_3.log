+def _render_instance(cells: np.ndarray, priority: list[int]):
+    cell_size = random.randint(1, 3)
+    rows, cols = cells.shape
+    board_h = rows * (cell_size + 1) + 1
+    board_w = cols * (cell_size + 1) + 1
+
+    top = random.randint(1, 3)
