+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+MAX_GENERATION_ATTEMPTS = 400
+LOGICAL_GENERATION_ATTEMPTS = 200
