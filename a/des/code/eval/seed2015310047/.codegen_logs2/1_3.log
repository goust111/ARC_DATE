+        summary, updated = _summarize_branches(cells, priority)
+        if summary["isolated"] < 1 or summary["majority"] < 1 or summary["tie"] < 1:
+            continue
+        if summary["stable_isolated"] < 1 or summary["changed_majority"] < 1 or summary["changed_tie"] < 1:
+            continue
