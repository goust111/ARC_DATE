+        patch_view = canvas[patch_r : patch_r + ph, patch_c : patch_c + pw]
+        patch_view[patch != bg] = patch[patch != bg]
+    else:
+        canvas_h = max(bh, ph) + 6
+        canvas_w = bw + pw + gap + 6
+        canvas = np.full((canvas_h, canvas_w), bg, dtype=int)
+        if direction == "left":
+            boundary_c = pw + gap + 2
+            patch_c = 2
+        else:
