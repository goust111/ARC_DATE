+        r0, c0, r1, c1 = _bbox(coords)
+        local_mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        local_mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
