+
+def _neighbors4(r: int, c: int):
+    for dr, dc in DIR4:
+        yield r + dr, c + dc
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _touches_edge(coords: np.ndarray, height: int, width: int) -> bool:
+    return bool(
+        np.any(coords[:, 0] == 0)
+        or np.any(coords[:, 0] == height - 1)
+        or np.any(coords[:, 1] == 0)
+        or np.any(coords[:, 1] == width - 1)
+    )
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    height, width = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    parts: list[np.ndarray] = []
+    for r in range(height):
+        for c in range(width):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if not (0 <= nr < height and 0 <= nc < width):
+                        continue
+                    if seen[nr, nc] or not mask[nr, nc]:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+            parts.append(np.asarray(coords, dtype=int))
+    return parts
+
+
+def _erode4(mask: np.ndarray) -> np.ndarray:
+    out = np.zeros_like(mask, dtype=bool)
+    if mask.shape[0] < 3 or mask.shape[1] < 3:
+        return out
+    out[1:-1, 1:-1] = (
+        mask[1:-1, 1:-1]
+        & mask[:-2, 1:-1]
+        & mask[2:, 1:-1]
+        & mask[1:-1, :-2]
+        & mask[1:-1, 2:]
+    )
+    return out
