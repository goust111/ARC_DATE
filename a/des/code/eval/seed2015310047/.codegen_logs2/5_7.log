+def _slot_count(interior: np.ndarray, stamp: np.ndarray) -> int:
+    count = 0
+    h, w = stamp.shape
+    for top in range(0, interior.shape[0] - h + 1, h):
+        for left in range(0, interior.shape[1] - w + 1, w):
+            if np.all(interior[top : top + h, left : left + w]):
