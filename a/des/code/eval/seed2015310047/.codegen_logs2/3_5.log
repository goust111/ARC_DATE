+    assert g.ndim == 2
+    bg = _most_common_color(g)
+    divider = _find_divider_row(g, bg)
+    templates = _extract_templates(g[:divider], bg)
+    scene = g[divider + 1 :].copy()
+    out, _metrics = _apply_growth(scene, templates, bg=bg)
