+def _scan_seeds(scene: np.ndarray, bg: int) -> list[tuple[int, int, int]]:
+    seeds: list[tuple[int, int, int]] = []
+    for r, c in np.argwhere((scene != bg) & (scene != ORANGE)):
+        seeds.append((int(r), int(c), int(scene[int(r), int(c)])))
+    seeds.sort()
