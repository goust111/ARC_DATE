+        row = grid[r]
+        if int(row[0]) == bg or not np.all(row == row[0]):
+            continue
+        if not np.any(grid[:r] != bg):
+            continue
+        if not np.any(grid[r + 1 :] != bg):
+            continue
+        candidates.append(r)
+
+    assert candidates, "expected a full-width divider row"
+    for r in candidates:
+        if int(grid[r, 0]) == GREY:
+            return int(r)
+    return int(candidates[0])
