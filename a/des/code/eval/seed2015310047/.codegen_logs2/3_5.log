+def _matches_kind(delta: dict[str, int], kind: str) -> bool:
+    if delta["placed"] <= 0:
+        return False
+    if kind == "edge":
+        return delta["edge"] > 0
+    if kind == "obstacle":
+        return delta["obstacle"] > 0
+    if kind == "overlap":
+        return delta["overlap"] > 0
+    if kind == "normal":
+        return delta["edge"] == 0 and delta["obstacle"] == 0 and delta["overlap"] == 0
