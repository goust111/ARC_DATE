+            cc1 = min(scene_w, c0 + ow + 1)
+            if occupied[rr0:rr1, cc0:cc1].any():
+                continue
+            occupied[r0 : r0 + oh, c0 : c0 + ow] = True
+            scene[r0 : r0 + oh, c0 : c0 + ow] = ORANGE
