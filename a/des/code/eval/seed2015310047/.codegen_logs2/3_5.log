+            return None
+    elif focus == "obstacle":
+        if not _try_add_seed(rng, base_scene, templates, seeds, "obstacle"):
+            return None
+    elif focus == "overlap":
+        if not _try_add_seed(rng, base_scene, templates, seeds, "normal"):
+            return None
+        if not _try_add_seed(rng, base_scene, templates, seeds, "overlap"):
