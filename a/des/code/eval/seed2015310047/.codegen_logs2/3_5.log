+def _valid_seed_spot(
+    r: int,
+    c: int,
+    base_scene: np.ndarray,
+    seeds: list[tuple[int, int, int]],
+) -> bool:
+    if int(base_scene[r, c]) == ORANGE:
+        return False
+    for sr, sc, _color in seeds:
+        if max(abs(sr - r), abs(sc - c)) <= 1:
+            return False
+    return True
