+    out = np.array(scene, dtype=int, copy=True)
+    obstacle_mask = out == ORANGE
+    for r, c, _color in seeds:
+        if 0 <= r < h and 0 <= c < w and not obstacle_mask[r, c]:
+            out[r, c] = bg
