+def _manhattan_path(
+    start: tuple[int, int],
+    end: tuple[int, int],
+    horizontal_first: bool,
+) -> list[tuple[int, int]]:
+    sr, sc = start
+    er, ec = end
+    cells = [(sr, sc)]
+    rr, cc = sr, sc
+
+    axes = ("h", "v") if horizontal_first else ("v", "h")
+    for axis in axes:
+        if axis == "h":
+            step = 1 if ec >= cc else -1
+            while cc != ec:
+                cc += step
+                cells.append((rr, cc))
+        else:
+            step = 1 if er >= rr else -1
+            while rr != er:
+                rr += step
+                cells.append((rr, cc))
