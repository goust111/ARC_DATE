+def _is_connected(mask: np.ndarray) -> bool:
+    cells = np.argwhere(mask)
+    if len(cells) == 0:
+        return False
+    seen = np.zeros_like(mask, dtype=bool)
+    stack = [tuple(map(int, cells[0]))]
+    seen[stack[0]] = True
+    count = 0
