+def _mask_to_rels(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    center_r = h // 2
+    center_c = w // 2
+    return [
+        (int(r - center_r), int(c - center_c))
+        for r, c in np.argwhere(mask.astype(bool))
+    ]
