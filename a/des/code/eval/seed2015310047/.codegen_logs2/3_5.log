+
+def _find_divider_row(grid: np.ndarray, bg: int) -> int:
+    h, w = grid.shape
+    candidates: list[int] = []
+    for r in range(1, h - 1):
+        row = grid[r]
+        if int(row[0]) == bg or not np.all(row == row[0]):
+            continue
+        if not np.any(grid[:r] != bg):
