+        mask = np.zeros((h, w), dtype=bool)
+        mask[center] = True
+
+        anchors = [
+            (0, rng.randrange(w)),
+            (h - 1, rng.randrange(w)),
+            (rng.randrange(h), 0),
+            (rng.randrange(h), w - 1),
+        ]
+        for anchor in anchors:
+            for cell in _manhattan_path(center, anchor, horizontal_first=bool(rng.randrange(2))):
+                mask[cell] = True
