+    for pool in pools:
+        if not pool:
+            continue
+        trial_positions = pool[:]
+        rng.shuffle(trial_positions)
+        for r, c in trial_positions[: max(60, min(len(trial_positions), 180))]:
+            if not _valid_seed_spot(r, c, base_scene, seeds):
+                continue
+            for color in colors:
