+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+ORANGE = 7
+TEMPLATE_COLORS = (1, 2, 3, 4, 6, 8, 9)
+
+GRID_WIDTH_RANGE = (16, 28)
+SCENE_HEIGHT_RANGE = (10, 16)
+TEMPLATE_COUNT_RANGE = (3, 5)
+OBSTACLE_COUNT_RANGE = (1, 3)
+SEED_EXTRA_RANGE = (0, 2)
+MAX_GENERATION_ATTEMPTS = 500
+PLACEMENT_ATTEMPTS = 250
