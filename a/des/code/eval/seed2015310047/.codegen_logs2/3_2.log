+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    pair_count = rng.choice(PAIR_COUNT_OPTIONS)
+    height = rng.randint(GRID_SIZE_RANGE[0], GRID_SIZE_RANGE[1])
+    width = rng.randint(GRID_SIZE_RANGE[0], GRID_SIZE_RANGE[1])
