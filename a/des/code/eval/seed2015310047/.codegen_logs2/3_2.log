+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+PIPE_COLORS = (BLUE, RED)
+FRAME_COLORS = (3, 4, 5, 6, 7, 8, 9)
+
+GRID_SIZE_RANGE = (30, 38)
+OUTER_SIZE_RANGE = (4, 6)
+PIPE_LEN_RANGE = (2, 5)
+PAIR_COUNT_OPTIONS = (4, 5)
+MAX_GENERATION_ATTEMPTS = 400
+PLACEMENT_ATTEMPTS = 200
