+    comps: list[dict[str, object]] = []
+    for r, c in np.argwhere(mask & ~seen):
+        if seen[int(r), int(c)]:
+            continue
+        stack = [(int(r), int(c))]
+        seen[int(r), int(c)] = True
+        cells: list[tuple[int, int]] = []
+        while stack:
+            cr, cc = stack.pop()
+            cells.append((cr, cc))
+            for nr, nc in _neighbors4(cr, cc):
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
