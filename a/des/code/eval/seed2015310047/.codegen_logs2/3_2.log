+        r0 = int(coords[:, 0].min())
+        c0 = int(coords[:, 1].min())
+        r1 = int(coords[:, 0].max())
+        c1 = int(coords[:, 1].max())
+        comps.append(
+            {
+                "coords": coords,
+                "bbox": (r0, c0, r1, c1),
+                "size": int(coords.shape[0]),
