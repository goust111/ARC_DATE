+            orient=orient,
+            frame_color=frame_color,
+            rng=rng,
+        ):
+            return None
+
+    op = rng.randrange(8)
+    grid = _apply_transform(grid, op)
+    expected = _apply_transform(expected, op)
+
+    try:
