+        assert has_a ^ has_b, "exactly one container in a pair must contain a pattern"
+        assert patch_a.shape == patch_b.shape, "paired containers must share the same interior size"
+
+        if has_a:
+            src_patch = patch_a
+            dst_bbox = (br0, bc0, br1, bc1)
+        else:
