+        out[dr0 : dr1 + 1, dc0 : dc1 + 1] = _transform_patch(src_patch, int(pipe["color"]), str(pipe["orient"]))
+
+    assert len(used) == 2 * len(pipes), "each pipe must connect two distinct containers"
+    return out
