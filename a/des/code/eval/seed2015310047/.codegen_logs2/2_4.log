+def _apply_simultaneous_shifts(
+    inner: np.ndarray, row_shifts: list[int], col_shifts: list[int]
+) -> np.ndarray:
+    inner_h, inner_w = inner.shape
+    out = np.full(inner.shape, -1, dtype=int)
