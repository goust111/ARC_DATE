+def _arrow_cells(side: str, absolute_idx: int, h: int, w: int) -> list[tuple[int, int]]:
+    if side == "top":
+        c = absolute_idx
+        return [(0, c), (1, c - 1), (1, c + 1)]
+    if side == "bottom":
+        c = absolute_idx
+        return [(h - 1, c), (h - 2, c - 1), (h - 2, c + 1)]
