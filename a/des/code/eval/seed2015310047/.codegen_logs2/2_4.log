+def _shift_vectors(inner: np.ndarray, arrows: list[tuple[str, int, int]]) -> tuple[list[int], list[int]]:
+    inner_h, inner_w = inner.shape
+    row_shifts = [0] * inner_h
+    col_shifts = [0] * inner_w
