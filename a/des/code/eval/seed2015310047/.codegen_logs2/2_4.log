+            assert idx not in used_rows, "each row may be controlled at most once"
+            used_rows.add(idx)
+            row_shifts[idx] = int(np.count_nonzero(inner[idx, :] == color))
+        elif side == "right":
+            assert idx not in used_rows, "each row may be controlled at most once"
+            used_rows.add(idx)
+            row_shifts[idx] = -int(np.count_nonzero(inner[idx, :] == color))
+        elif side == "top":
+            assert idx not in used_cols, "each column may be controlled at most once"
