+            col_shifts[idx] = int(np.count_nonzero(inner[:, idx] == color))
+        else:
+            assert side == "bottom"
+            assert idx not in used_cols, "each column may be controlled at most once"
+            used_cols.add(idx)
+            col_shifts[idx] = -int(np.count_nonzero(inner[:, idx] == color))
