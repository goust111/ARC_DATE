+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+WALL_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+FRAME_SIDE_OPTIONS = [5, 7, 9]
+GRID_H_RANGE = (28, 38)
+GRID_W_RANGE = (28, 38)
+WALL_COUNT_OPTIONS = [2, 3, 4]
+EDGE_MARGIN = 4
+MIN_FRAME_GAP = 6
+MAX_ATTEMPTS = 500
+
+PATTERN_TEMPLATES = [
+    np.array([[1]], dtype=bool),
+    np.array([[1, 1]], dtype=bool),
+    np.array([[1], [1]], dtype=bool),
+    np.array([[1, 1], [1, 0]], dtype=bool),
+    np.array([[1, 1], [1, 1]], dtype=bool),
+    np.array([[1, 1, 1]], dtype=bool),
+    np.array([[1], [1], [1]], dtype=bool),
+    np.array([[1, 1, 1], [0, 1, 0]], dtype=bool),
+    np.array([[1, 1, 0], [0, 1, 1]], dtype=bool),
+]
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((int(rr), int(cc)))
+                for dr, dc in DIRS4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _is_rect_frame(comp: list[tuple[int, int]]) -> tuple[int, int, int, int] | None:
+    r0, c0, r1, c1 = _bbox(comp)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 5 or w < 5:
+        return None
+    if h % 2 == 0 or w % 2 == 0:
+        return None
+    if len(comp) != 2 * h + 2 * w - 4:
+        return None
+    patch = np.zeros((h, w), dtype=bool)
+    for r, c in comp:
+        patch[r - r0, c - c0] = True
+    expected = np.zeros((h, w), dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    if not np.array_equal(patch, expected):
+        return None
+    return r0, c0, r1, c1
+
+
+def _extract_frames(grid: np.ndarray) -> list[dict]:
+    frames: list[dict] = []
+    colors = [int(v) for v in np.unique(grid) if int(v) not in {BG, GREY}]
+    for color in colors:
+        for comp in _components(grid == color):
+            box = _is_rect_frame(comp)
+            if box is not None:
+                frames.append({"color": int(color), "bbox": box})
