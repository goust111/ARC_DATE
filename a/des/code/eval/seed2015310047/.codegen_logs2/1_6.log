+        key_color = wall_colors[perm[i]]
+        assert key_color != color
+        sub[kr, kc] = key_color
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _build_input()
+        if grid is None:
+            continue
+        try:
+            out = main(grid)
+        except Exception:
+            continue
+        if np.array_equal(grid, out):
+            continue
+        return grid
+    raise RuntimeError("failed to generate a valid puzzle instance")

