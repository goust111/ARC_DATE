+    col = random.randint(EDGE_MARGIN, w - EDGE_MARGIN - total_w)
+    boxes: list[tuple[int, int, int, int]] = []
+    cur = col
+    for i, (bh, bw) in enumerate(sizes):
+        boxes.append((row, cur, row + bh - 1, cur + bw - 1))
+        if i < n - 1:
+            cur += bw + gaps[i]
+    if n == 2:
+        perm = [1, 0]
+    else:
