+    for r, c in comp:
+        patch[r - r0, c - c0] = True
+    expected = np.zeros((h, w), dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
