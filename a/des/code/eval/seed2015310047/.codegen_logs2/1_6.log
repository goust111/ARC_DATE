+def _bbox_gap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> int:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    row_gap = max(br0 - ar1 - 1, ar0 - br1 - 1, 0)
+    col_gap = max(bc0 - ac1 - 1, ac0 - bc1 - 1, 0)
+    return max(row_gap, col_gap)
