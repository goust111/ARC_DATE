+            r_max = h - EDGE_MARGIN - bh
+            c_min = EDGE_MARGIN
+            c_max = w - EDGE_MARGIN - bw
+            if r_min > r_max or c_min > c_max:
+                return None
+            r0 = random.randint(r_min, r_max)
+            c0 = random.randint(c_min, c_max)
