+    elif direction == "left":
+        dr, dc = 0, c0 - 1 - max_c
+    else:
+        dr, dc = 0, c1 + 1 - min_c
+    return [(r + dr, c + dc) for r, c in pattern]
+
+
+def main(grid: np.ndarray) -> np.ndarray:
