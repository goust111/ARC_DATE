+def _move_pattern(
+    pattern: list[tuple[int, int]],
+    src_box: tuple[int, int, int, int],
+    direction: str,
+) -> list[tuple[int, int]]:
+    rows = [r for r, _ in pattern]
+    cols = [c for _, c in pattern]
+    min_r = min(rows)
+    max_r = max(rows)
+    min_c = min(cols)
+    max_c = max(cols)
