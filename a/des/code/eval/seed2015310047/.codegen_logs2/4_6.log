+    h, w = grid.shape
+    dr, dc = direction
+    chain = COLOR_CHAINS[color]
+    attenuation = 0
+    dist = 0
+    r, c = start
+    claims: list[tuple[int, int, int, int, int, int]] = []
+
+    while True:
+        nr, nc = r + dr, c + dc
+        if not _in_bounds(h, w, nr, nc):
+            break
+        r, c = nr, nc
