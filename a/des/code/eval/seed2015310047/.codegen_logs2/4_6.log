+def _path_to_edge(start: tuple[int, int], direction: tuple[int, int], shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    dr, dc = direction
+    r, c = start
+    cells: list[tuple[int, int]] = []
+    while True:
+        r += dr
+        c += dc
+        if not _in_bounds(h, w, r, c):
+            break
+        cells.append((int(r), int(c)))
+    return cells
