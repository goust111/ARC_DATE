+    intervals: list[tuple[int, int, str]] = []
+    pos = gaps[0]
+    for i, (kind, length) in enumerate(zip(kinds, lengths)):
+        start = pos
+        end = start + length - 1
+        intervals.append((int(start), int(end), kind))
+        pos = end + 1 + gaps[i + 1]
