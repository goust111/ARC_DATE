+from __future__ import annotations
+
+import random
+from collections import Counter, defaultdict
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+AZURE = 8
+
+TOWER_COLORS = (RED, BLUE, GREEN)
+INPUT_COLORS = {BLACK, BLUE, RED, GREEN, GREY}
+RAY_DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
