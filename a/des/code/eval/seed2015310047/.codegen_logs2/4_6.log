+
+def _candidate_lane_towers(
+    grid: np.ndarray,
+    towers: list[tuple[int, int]],
+    rng: random.Random,
+) -> list[tuple[int, int, tuple[int, int], list[tuple[int, int]]]]:
+    h, w = grid.shape
+    out: list[tuple[int, int, tuple[int, int], list[tuple[int, int]]]] = []
+    rows = list(range(1, h - 1))
+    cols = list(range(1, w - 1))
