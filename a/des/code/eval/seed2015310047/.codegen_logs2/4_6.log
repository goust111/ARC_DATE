+    path: list[tuple[int, int]],
+    towers: list[tuple[int, int]],
+    protected: set[tuple[int, int]],
+    rng: random.Random,
+) -> tuple[set[tuple[int, int]], list[tuple[int, int]]] | None:
+    patterns = [
