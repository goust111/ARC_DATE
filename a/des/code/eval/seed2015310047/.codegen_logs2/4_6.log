+
+def _tower_cells(grid: np.ndarray) -> list[tuple[int, int, int]]:
+    towers: list[tuple[int, int, int]] = []
+    for r, c in np.argwhere(np.isin(grid, TOWER_COLORS)):
+        towers.append((int(r), int(c), int(grid[r, c])))
+    return towers
+
+
+def _trace_ray(
