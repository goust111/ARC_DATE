+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+AZURE = 8
+
+TOWER_COLORS = (RED, BLUE, GREEN)
+INPUT_COLORS = {BLACK, BLUE, RED, GREEN, GREY}
+RAY_DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+COLOR_CHAINS = {
+    RED: (RED, ORANGE, YELLOW),
+    BLUE: (BLUE, AZURE, GREY),
+    GREEN: (GREEN, YELLOW, ORANGE),
+}
+
+GEN_RETRIES = 400
+GRID_H_RANGE = (12, 18)
+GRID_W_RANGE = (12, 18)
+EXTRA_WALLS_RANGE = (0, 3)
+EXTRA_TOWER_PROB = 0.35
