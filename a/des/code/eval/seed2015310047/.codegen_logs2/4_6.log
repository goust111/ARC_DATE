+        else:
+            lengths.append(1)
+    required = sum(lengths) + len(kinds) + 1
+    if path_len < required:
+        return None
+
+    gaps = [1] * (len(kinds) + 1)
+    extra = path_len - required
+    for _ in range(extra):
+        gaps[rng.randrange(len(gaps))] += 1
+    rng.shuffle(gaps)
