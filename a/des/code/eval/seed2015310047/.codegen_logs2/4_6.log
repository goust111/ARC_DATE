+INPUT_COLORS = {BLACK, BLUE, RED, GREEN, GREY}
+RAY_DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+COLOR_CHAINS = {
+    RED: (RED, ORANGE, YELLOW),
+    BLUE: (BLUE, AZURE, GREY),
+    GREEN: (GREEN, YELLOW, ORANGE),
