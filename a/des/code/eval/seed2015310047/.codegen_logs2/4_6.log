+def _place_extra_tower(
+    grid: np.ndarray,
+    towers: list[tuple[int, int]],
+    color: int,
+    rng: random.Random,
+) -> tuple[int, int] | None:
+    h, w = grid.shape
+    candidates = [(r, c) for r in range(1, h - 1) for c in range(1, w - 1) if _can_place_tower(grid, (r, c), towers)]
+    if not candidates:
+        return None
+    r, c = rng.choice(candidates)
+    grid[r, c] = int(color)
