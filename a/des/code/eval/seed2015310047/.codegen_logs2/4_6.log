+        if not placed:
+            return None
+        protected.update(placed)
+
+    protected.update(path_a)
+    protected.update(path_b)
+    protected.add(a_pos)
+    protected.add(b_pos)
+    return protected, towers
+
+
+def _candidate_lane_towers(
+    grid: np.ndarray,
+    towers: list[tuple[int, int]],
+    rng: random.Random,
+) -> list[tuple[int, int, tuple[int, int], list[tuple[int, int]]]]:
