+            break
+        r, c = nr, nc
+        dist += 1
+
+        if int(grid[r, c]) == GREY:
+            while True:
+                nr, nc = r + dr, c + dc
+                if not _in_bounds(h, w, nr, nc):
+                    return claims
+                if int(grid[nr, nc]) != GREY:
+                    break
+                r, c = nr, nc
+                dist += 1
+
+            attenuation += 1
+            if attenuation >= len(chain):
+                break
+
+            r, c = nr, nc
+            dist += 1
+
+        if int(grid[r, c]) == BLACK:
+            claims.append((int(r), int(c), int(attenuation), int(dist), int(chain[attenuation]), int(tower_id)))
+
+    return claims
+
