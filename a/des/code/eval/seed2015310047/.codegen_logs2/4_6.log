+            d_hi = min(max_da, max_db, 5)
+            if d_hi < d_lo:
+                continue
+            da = rng.randint(d_lo, min(max_da, 5))
+            choices = [d for d in range(d_lo, min(max_db, 5) + 1) if d != da]
+            if not choices:
