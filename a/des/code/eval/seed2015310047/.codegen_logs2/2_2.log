+
+        dead_ends.append(
+            {
+                "terminal": (r, c),
+                "direction": (dr, dc),
+                "depth": int(depth),
+                "ahead": (ahead_r, ahead_c),
+                "region_id": int(region_id),
+                "owner": None if owner is None else int(owner),
