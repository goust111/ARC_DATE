+    max_count = max(counts.values())
+    candidates = [int(color) for color, count in counts.items() if count == max_count]
+    if len(candidates) == 1:
+        return candidates[0]
+
+    best_color = candidates[0]
+    best_key = None
+    for color in candidates:
