+        degrees = _path_degrees(mask)
+        key = (int(np.sum(degrees >= 3)), int(np.sum(degrees == 1)), int(mask.sum()))
+        if best_key is None or key > best_key:
+            best_key = key
+            best_color = int(color)
+    return best_color
