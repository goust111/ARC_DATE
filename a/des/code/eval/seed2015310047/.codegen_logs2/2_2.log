+def _path_neighbors(path_mask: np.ndarray, r: int, c: int) -> list[tuple[int, int]]:
+    h, w = path_mask.shape
+    out: list[tuple[int, int]] = []
+    for dr, dc in DIR4:
+        nr = int(r + dr)
+        nc = int(c + dc)
+        if _in_bounds(h, w, nr, nc) and bool(path_mask[nr, nc]):
+            out.append((nr, nc))
+    return out
