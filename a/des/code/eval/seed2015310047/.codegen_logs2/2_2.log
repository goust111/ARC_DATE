+def _path_degrees(path_mask: np.ndarray) -> np.ndarray:
+    degrees = np.zeros(path_mask.shape, dtype=int)
+    for r, c in np.argwhere(path_mask):
+        degrees[int(r), int(c)] = len(_path_neighbors(path_mask, int(r), int(c)))
+    return degrees
