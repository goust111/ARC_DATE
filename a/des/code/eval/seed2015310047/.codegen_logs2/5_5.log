+            return None
+        col0 = random.randint(usable_start, col0_hi)
+
+        row_lo = 2 + half
+        row_hi = h - 3 - half
+        row_lo, row_hi = _biased_center_range(row_lo, row_hi, side, h)
+        if row_lo > row_hi:
