+def _is_l_triomino(cells: list[tuple[int, int]]) -> bool:
+    if len(cells) != 3:
+        return False
+    rows = sorted({r for r, _ in cells})
+    cols = sorted({c for _, c in cells})
+    if len(rows) != 2 or len(cols) != 2:
+        return False
+    return len(set(cells)) == 3
