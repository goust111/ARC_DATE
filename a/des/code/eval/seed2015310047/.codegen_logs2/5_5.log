+    c0 = max(0, min(cols) - pad)
+    c1 = min(w - 1, max(cols) + pad)
+    return {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}
+
+
+def _biased_center_range(lo: int, hi: int, side: str, axis_len: int) -> tuple[int, int]:
+    if side == "top":
