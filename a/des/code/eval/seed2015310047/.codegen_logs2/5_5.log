+def _edge_runs(line: np.ndarray, bg: int) -> list[tuple[int, int, int]]:
+    runs: list[tuple[int, int, int]] = []
+    i = 0
+    n = len(line)
+    while i < n:
+        color = int(line[i])
+        if color == bg:
+            i += 1
+            continue
+        j = i
+        while j + 1 < n and int(line[j + 1]) == color:
+            j += 1
+        runs.append((i, j, color))
+        i = j + 1
+    return runs
