+    elif side == "bottom":
+        candidate_lo = max(lo, axis_len // 2)
+        if candidate_lo <= hi:
+            return candidate_lo, hi
+    elif side == "left":
+        candidate_hi = min(hi, axis_len // 2 - 1)
+        if lo <= candidate_hi:
+            return lo, candidate_hi
+    else:
+        candidate_lo = max(lo, axis_len // 2)
+        if candidate_lo <= hi:
+            return candidate_lo, hi
+    return lo, hi
