+
+SIDES = ("top", "bottom", "left", "right")
+PROFILE_VALUES = (3, 5, 7)
+MAX_GEN_ATTEMPTS = 300
+GRID_MIN = 18
+GRID_MAX = 24
+OBJECT_COUNT_MIN = 2
+OBJECT_COUNT_MAX = 4
+PLACEMENT_RETRIES = 120
+COLORS = tuple(range(10))
