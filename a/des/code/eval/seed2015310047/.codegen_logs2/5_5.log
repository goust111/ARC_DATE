+    except AssertionError:
+        return None
+
+    if out.shape != grid.shape or np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
