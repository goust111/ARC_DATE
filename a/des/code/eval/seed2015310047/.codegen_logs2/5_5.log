+            return None
+
+    if _get_bg(grid) != bg:
+        return None
+
+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+
+    if out.shape != grid.shape or np.array_equal(out, grid):
+        return None
+    return grid
