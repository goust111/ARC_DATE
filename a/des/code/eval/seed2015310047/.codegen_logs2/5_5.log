+            by_row[r].append(c)
+        for row in sorted(by_row):
+            span = max(by_row[row]) - min(by_row[row]) + 1
+            start, end = _segment_bounds(row, span)
+            assert 0 <= start and end < h
+            assert int(wall["start"]) <= start and end <= int(wall["end"])
