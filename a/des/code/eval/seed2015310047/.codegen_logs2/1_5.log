+def _make_side_tower(side: str, center: int, color: int, shape: tuple[int, int]) -> dict:
+    h, w = shape
+    if side == "left":
+        body = {(r, c) for r in range(center - 1, center + 2) for c in range(0, 3)}
+        antenna = (center, 3)
