+                reflections += 1
+                r, c = nr, nc
+                continue
+
+            cell_value = int(grid[nr, nc])
+            if cell_value != BLACK:
+                stop = "tower" if (nr, nc) in tower_cells else "marker"
+                stop_cell = (nr, nc)
