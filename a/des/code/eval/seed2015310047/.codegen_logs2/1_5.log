+    else:
+        bottom_choices = [c for c in _interior_cols(w) if c >= top_col + 3]
+        mirror_kind = "\\"
+    if not bottom_choices:
+        return None
+    bottom_col = random.choice(bottom_choices)
+
+    towers = [
