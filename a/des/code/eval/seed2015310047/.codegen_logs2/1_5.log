+            path.append((nr, nc))
+            hit_colors.setdefault((nr, nc), set()).add(int(tower["color"]))
+            r, c = nr, nc
+
+        records.append(
+            {
+                "color": int(tower["color"]),
+                "path": path,
+                "reflections": reflections,
+                "stop": stop,
+                "stop_cell": stop_cell,
+            }
+        )
