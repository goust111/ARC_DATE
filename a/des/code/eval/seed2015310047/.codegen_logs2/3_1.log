+def _unique_transform_signature(mask: np.ndarray) -> bool:
+    seen = set()
+    for name in TRANSFORMS:
+        arr = _apply_transform(mask, name)
+        seen.add(arr.tobytes())
+    return len(seen) == len(TRANSFORMS)
