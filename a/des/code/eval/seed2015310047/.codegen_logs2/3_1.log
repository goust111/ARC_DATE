+    examples: list[dict[str, object]] = []
+    target: dict[str, object] | None = None
+    for frame in frames:
+        filled = [i for i, q in enumerate(frame["quads"]) if bool(np.any(q["mask"]))]
+        if len(filled) == 4:
+            examples.append(frame)
+        elif len(filled) == 1:
