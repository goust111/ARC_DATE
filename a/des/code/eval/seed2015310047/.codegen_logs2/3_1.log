+    out = target["grid"].copy()
+    for q in target_quads:
+        out[q["rows"], q["cols"]] = BLACK
+    for idx, q in enumerate(target_quads):
+        filled = _apply_transform(base_mask, rule[idx])
+        sub = out[q["rows"], q["cols"]]
+        sub[filled] = seed_color
