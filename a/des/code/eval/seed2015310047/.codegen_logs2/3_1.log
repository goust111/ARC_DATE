+
+
+def _make_frame(side: int) -> np.ndarray:
+    size = 2 * side + 3
+    frame = np.zeros((size, size), dtype=int)
+    center = side + 1
+    frame[0, :] = FRAME_COLOR
+    frame[-1, :] = FRAME_COLOR
+    frame[:, 0] = FRAME_COLOR
+    frame[:, -1] = FRAME_COLOR
+    frame[center, :] = FRAME_COLOR
+    frame[:, center] = FRAME_COLOR
