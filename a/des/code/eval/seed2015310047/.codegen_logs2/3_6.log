+BLACK = 0
+FENCE_COLOR = 5
+PALETTE = tuple(color for color in range(1, 10) if color != FENCE_COLOR)
+SIDES = ("top", "bottom", "left", "right")
+
+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (18, 30)
+FENCE_COUNT_RANGE = (2, 5)
