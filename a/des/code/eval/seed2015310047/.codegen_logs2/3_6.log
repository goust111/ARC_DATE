+def _voting_mask(shape: tuple[int, int], gap_side: str) -> np.ndarray:
+    h, w = shape
+    mask = np.zeros((h, w), dtype=bool)
+    if gap_side == "top":
+        mask[h // 2 :, :] = True
+    elif gap_side == "bottom":
+        mask[: h // 2, :] = True
+    elif gap_side == "left":
+        mask[:, w // 2 :] = True
+    elif gap_side == "right":
