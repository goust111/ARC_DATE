+            if up == BLACK and down == BLACK and left != BLACK and right != BLACK:
+                doors.append(((r, c), "vertical"))
+            elif left == BLACK and right == BLACK and up != BLACK and down != BLACK:
+                doors.append(((r, c), "horizontal"))
