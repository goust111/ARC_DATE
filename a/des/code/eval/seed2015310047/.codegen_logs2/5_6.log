+
+    def vertical_segment(left_room: object, right_room: object) -> list[tuple[int, int]]:
+        left_box = room_boxes[left_room]
+        right_box = room_boxes[right_room]
+        wall_c = int(left_box[3] + 1)
+        r0 = max(int(left_box[0]), int(right_box[0]))
