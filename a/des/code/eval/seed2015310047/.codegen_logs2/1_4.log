+import random
+
+import numpy as np
+
+
+BG_COLOR = 0
+GREY_PATH = 5
+AZURE_END = 8
+MAROON_START = 9
+GATE_AND_TARGET_COLORS = [1, 2, 3, 4, 6, 7]
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_SIDE_RANGE = (18, 30)
+COARSE_SIDE_RANGE = (4, 8)
+COARSE_PATH_LEN_RANGE = (4, 11)
