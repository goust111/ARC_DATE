+def _build_piece_patch(mask: np.ndarray, body_color: int, teeth: list[tuple[int, int, int, int]]) -> np.ndarray:
+    patch = np.full(mask.shape, int(body_color), dtype=int)
+    for r, c, _direction, color in teeth:
