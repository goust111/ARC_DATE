+        mask[coords[:, 0] - hr0, coords[:, 1] - hc0] = True
+        abs_r0 = int(fr0 + hr0)
+        abs_c0 = int(fc0 + hc0)
+        boundary_teeth: dict[tuple[int, int], int] = {}
+        for lr, lc in np.argwhere(mask):
+            lr = int(lr)
+            lc = int(lc)
+            abs_r = int(abs_r0 + lr)
+            abs_c = int(abs_c0 + lc)
+            for dr, dc in DIRS:
+                nr = lr + dr
+                nc = lc + dc
+                if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and bool(mask[nr, nc]):
