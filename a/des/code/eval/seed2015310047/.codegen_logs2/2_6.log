+def _cell_on_border(mask: np.ndarray, r: int, c: int) -> bool:
+    h, w = mask.shape
+    for dr, dc in DIRS:
+        nr = int(r + dr)
+        nc = int(c + dc)
+        if not (0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc])):
+            return True
+    return False
+
