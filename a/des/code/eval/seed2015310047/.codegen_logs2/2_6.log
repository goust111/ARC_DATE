+        )
+    pieces.sort(key=lambda piece: (int(piece["bbox"][0]), int(piece["bbox"][1])))
+
+    return {
+        "bg": int(bg),
+        "frame_color": int(frame_color),
+        "holes": holes,
+        "pieces": pieces,
+    }
+
