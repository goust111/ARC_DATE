+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        exposed = []
+        for direction, (dr, dc) in enumerate(DIRS):
+            nr = r + dr
+            nc = c + dc
+            if not (0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc])):
