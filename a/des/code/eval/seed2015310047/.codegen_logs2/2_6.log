+
+
+def _random_teeth(mask: np.ndarray, tooth_palette: list[int]) -> list[tuple[int, int, int, int]] | None:
+    eligible = _eligible_teeth(mask)
+    if len(eligible) < 2:
+        return None
+
+    for _ in range(TEETH_RETRIES):
