+        piece_variants.append({"patch": rot_patch, "mask": rot_mask})
+
+    piece_reserved = np.zeros((grid_h, grid_w), dtype=bool)
+    piece_reserved[
+        max(0, rect_top - 1) : min(grid_h, rect_top + rect_h + 1),
+        max(0, rect_left - 1) : min(grid_w, rect_left + rect_w + 1),
+    ] = True
