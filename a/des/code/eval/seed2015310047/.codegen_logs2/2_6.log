+        mask = cand["mask"]
+        r0, c0, _r1, _c1 = hole["bbox"]
+        sub = out[int(r0) : int(r0) + patch.shape[0], int(c0) : int(c0) + patch.shape[1]]
+        sub[mask] = patch[mask]
