  "type": "transform_in_place",
  "src": "one singleton marker pixel and rows of wall-color pixels on a dominant background",
  "transform": "recolor background pixels in the scanline passage selected by the marker column: wall rows fill between nearest wall limits, empty interior rows fill full width, and empty exterior rows reuse the nearest end interval"
}
</annotation>
</reference_puzzle>

