+    for r in range(1, g.shape[0] - 1):
+        for c in range(1, g.shape[1] - 1):
+            if r < table_h and c < table_w:
+                continue
+            mixed = _crossing_result(g, r, c, path_colors, mapping)
+            if mixed is not None:
+                out[r, c] = int(mixed)
+
+    return out
