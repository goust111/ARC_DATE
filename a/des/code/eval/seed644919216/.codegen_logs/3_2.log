+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    assert h >= 3 and w >= 3, "grid must be large enough for a 2x2 mix table"
+    assert int(g[0, 0]) == bg, "top-left table corner must be background"
+
+    row_headers: list[int] = []
+    c = 1
