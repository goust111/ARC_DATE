+        out_w = max(board_w, piece_w)
+        inp = np.full((out_h, out_w), bg, dtype=int)
+        out = np.full((out_h, out_w), bg, dtype=int)
+        top_h = board_h if board_first else piece_h
+        inp[top_h, :] = sep_color
