+
+def _edge_profiles(mask: np.ndarray) -> tuple[tuple[int, ...], ...]:
+    return (
+        tuple(int(v) for v in mask[0, :]),
+        tuple(int(v) for v in mask[:, -1]),
+        tuple(int(v) for v in mask[-1, :]),
+        tuple(int(v) for v in mask[:, 0]),
