+    h, w = map(int, shape)
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return bool(
+        np.any((rows == 0) | (rows == h - 1) | (cols == 0) | (cols == w - 1))
+    )
+
+
+def _mask_signature(mask: np.ndarray) -> tuple[int, int, bytes]:
+    b = mask.astype(np.uint8, copy=False)
+    return int(b.shape[0]), int(b.shape[1]), b.tobytes()
