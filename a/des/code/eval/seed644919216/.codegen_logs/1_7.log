+def _uniform_separator(grid: np.ndarray, bg: int) -> tuple[str, int]:
+    h, w = grid.shape
+    for r in range(h):
+        row = grid[r, :]
+        if int(row[0]) != bg and bool(np.all(row == row[0])):
+            return "h", int(r)
+    for c in range(w):
+        col = grid[:, c]
+        if int(col[0]) != bg and bool(np.all(col == col[0])):
