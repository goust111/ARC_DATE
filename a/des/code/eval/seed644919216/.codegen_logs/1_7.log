+    br, bc = b
+    return (
+        ar + size + gap <= br
+        or br + size + gap <= ar
+        or ac + size + gap <= bc
+        or bc + size + gap <= ac
+    )
+
+
+def _place_boxes(
+    height: int, width: int, size: int, count: int, border: int, gap: int
