+        mask = _random_piece_mask(size)
+        if mask is None:
+            continue
+        sig = _canonical_signature(mask)
+        if sig in seen:
+            continue
+        seen.add(sig)
+        masks.append(mask)
+    if len(masks) != piece_count:
