+        elif style == "corners":
+            cells = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]
+        elif style == "block":
+            if h >= 2 and w >= 2:
+                r = random.randrange(h - 1)
+                c = random.randrange(w - 1)
+                cells = [(r, c), (r + 1, c), (r, c + 1), (r + 1, c + 1)]
+            elif h >= 2:
+                r = random.randrange(h - 1)
