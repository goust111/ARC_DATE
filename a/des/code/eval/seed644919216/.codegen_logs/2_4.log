+                (r, c)
+                for r in range(1, h - 1)
+                for c in range(1, w - 1)
+                if int(patch[r, c]) == base
+            ]
+            random.shuffle(base_cells)
+            for r, c in base_cells:
+                candidate = patch.copy()
+                candidate[r, c] = BG
+                if _is_connected(candidate != BG) and _non_singleton_non_bg(candidate):
+                    patch = candidate
