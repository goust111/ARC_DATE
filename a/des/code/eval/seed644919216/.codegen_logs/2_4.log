+            if accent_choices:
+                accent2 = random.choice(accent_choices)
+                cells2 = [(r, c) for r, c in _motif_cells(h, w) if int(patch[r, c]) == base]
+                if len(cells2) >= 2:
+                    for r, c in cells2:
