+    used_anchors: set[tuple[int, int]],
+    gap: int,
+) -> tuple[int, int] | None:
+    h, w = shape
+    for _ in range(200):
+        top = random.randint(0, canvas_h - h)
+        left = random.randint(0, canvas_w - w)
