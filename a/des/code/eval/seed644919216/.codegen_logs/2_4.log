+
+def _sample_free_position(
+    shape: tuple[int, int],
+    sig_pos: tuple[int, int],
+    canvas_h: int,
+    canvas_w: int,
+    existing_boxes: list[tuple[int, int, int, int]],
+    used_anchors: set[tuple[int, int]],
+    gap: int,
+) -> tuple[int, int] | None:
+    h, w = shape
+    for _ in range(200):
