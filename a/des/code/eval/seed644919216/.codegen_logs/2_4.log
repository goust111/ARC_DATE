+    out = lower.copy()
+    h, w = lower.shape
+    for (anchor_r, anchor_c), stamp in placed:
+        patch = np.asarray(stamp["patch"], dtype=int)
+        sig_r, sig_c = stamp["signature_pos"]
+        top = int(anchor_r - sig_r)
+        left = int(anchor_c - sig_c)
