+        w = random.randint(3, 6)
+        base = random.choice(STAMP_COLORS)
+        patch = np.full((h, w), base, dtype=int)
+
+        accent1 = random.choice([c for c in STAMP_COLORS if c != base])
+        for r, c in _motif_cells(h, w):
+            patch[r, c] = accent1
+
+        if random.random() < 0.4:
