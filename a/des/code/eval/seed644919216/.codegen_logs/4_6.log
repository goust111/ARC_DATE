+    stats = {"match": 0, "mismatch": 0, "straight": 0}
+
+    while True:
+        if current != start_coord and current in endpoints:
+            return current, stats
+        state = (current[0], current[1], direction[0], direction[1])
+        if state in seen:
+            return None
+        seen.add(state)
+
+        if current in intersections:
