+    for row_count, col_count in ((2, 2), (2, 3), (3, 2)):
+        rows = _sample_spaced_positions(rng, row_low, row_high, row_count, min_gap)
+        cols = _sample_spaced_positions(rng, col_low, col_high, col_count, min_gap)
