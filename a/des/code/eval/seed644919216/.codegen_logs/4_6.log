+            dest, stats = result
+            if dest in entrance_coords or dest in destinations or dest not in endpoint_coords:
+                ok = False
+                break
+            destinations.add(dest)
+            total_match += int(stats["match"])
+            total_mismatch += int(stats["mismatch"])
+            total_straight += int(stats["straight"])
+            traces.append(
