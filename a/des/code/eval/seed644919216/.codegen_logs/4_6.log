+        total_match = 0
+        total_mismatch = 0
+        total_straight = 0
+        ok = True
+        for entrance, color in zip(entrances, permuted_colors):
+            result = _simulate_network(
+                rows,
+                cols,
+                left_c,
+                right_c,
+                top_r,
+                bottom_r,
+                markers,
+                entrance,
+                int(color),
