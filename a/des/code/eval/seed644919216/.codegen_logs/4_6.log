+def _endpoint_direction(side: str) -> tuple[int, int]:
+    if side == "left":
+        return 0, 1
+    if side == "right":
+        return 0, -1
+    if side == "top":
+        return 1, 0
+    assert side == "bottom"
+    return -1, 0
