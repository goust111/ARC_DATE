+BG = 0
+PIPE = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_ATTEMPTS = 600
+ASSIGN_ATTEMPTS = 400
