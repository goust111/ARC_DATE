+            c = current[1]
+            idx = col_nodes.index(r)
+            next_idx = idx + 1 if dr > 0 else idx - 1
+            if not (0 <= next_idx < len(col_nodes)):
+                return None
+            current = (int(col_nodes[next_idx]), int(c))
