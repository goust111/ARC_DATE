+def _sample_spaced_positions(
+    rng: np.random.Generator,
+    low: int,
+    high: int,
+    count: int,
+    min_gap: int,
+) -> list[int] | None:
+    values = list(range(low, high + 1))
+    if len(values) < count:
+        return None
+    for _ in range(200):
+        chosen = sorted(int(x) for x in rng.choice(values, size=count, replace=False))
+        if all(b - a >= min_gap for a, b in zip(chosen, chosen[1:])):
+            return chosen
+    return None
