+                    "grid_row": rr,
+                    "grid_col": cc,
+                    "cell": cell,
+                    "dot_color": dot_color,
+                    "shape_color": shape_color,
+                    "bbox_h": bbox_r1 - bbox_r0 + 1,
+                    "bbox_w": bbox_c1 - bbox_c0 + 1,
+                    "bbox_area": (bbox_r1 - bbox_r0 + 1) * (bbox_c1 - bbox_c0 + 1),
+                    "cavity": cavity,
+                }
+            )
