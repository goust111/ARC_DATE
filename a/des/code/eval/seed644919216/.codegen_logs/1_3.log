+    need = target_h * target_w
+    for r0 in range(h - target_h + 1):
+        r1 = r0 + target_h - 1
+        for c0 in range(w - target_w + 1):
+            c1 = c0 + target_w - 1
+            if rect_sum(r0, c0, r1, c1) == need:
