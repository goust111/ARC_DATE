+
+def _children_from_parents(parents: list[int]) -> dict[int, list[int]]:
+    children: dict[int, list[int]] = {idx: [] for idx in range(len(parents))}
+    for child, parent in enumerate(parents):
+        if parent != -1:
+            children[parent].append(child)
+    return children
+
+
+def _selected_edges(children: dict[int, list[int]], bg: int, shape_colors: list[int]) -> tuple[list[int], list[int]]:
+    chosen_child = [-1] * len(shape_colors)
+    root = 0
+    path = [root]
+    current = root
+    while children[current]:
+        nxt = random.choice(children[current])
+        chosen_child[current] = nxt
+        path.append(nxt)
+        current = nxt
