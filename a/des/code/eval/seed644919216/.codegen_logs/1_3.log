+            if ch <= ph - 2 * pt and cw <= pw - 2 * pt:
+                candidates.append(parent)
+        if candidates:
+            parents[child] = min(candidates, key=lambda idx: (areas[idx], specs[idx][0] + specs[idx][1], idx))
