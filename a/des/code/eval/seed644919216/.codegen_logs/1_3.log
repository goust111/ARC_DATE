+
+def _spec_pool(cell_inner: int) -> list[tuple[int, int, int]]:
+    pool = []
+    for h in range(3, cell_inner):
+        for w in range(3, cell_inner):
+            max_t = min(2, (min(h, w) - 1) // 2)
+            for t in range(1, max_t + 1):
+                if h - 2 * t >= 1 and w - 2 * t >= 1:
+                    pool.append((h, w, t))
+    return pool
+
+
+def _spec_parent_map(specs: list[tuple[int, int, int]]) -> list[int]:
+    areas = [h * w for h, w, _t in specs]
+    parents = [-1] * len(specs)
+    for child, (ch, cw, _ct) in enumerate(specs):
+        candidates = []
+        for parent, (ph, pw, pt) in enumerate(specs):
+            if child == parent:
+                continue
+            if areas[parent] <= areas[child]:
+                continue
+            if ch <= ph - 2 * pt and cw <= pw - 2 * pt:
+                candidates.append(parent)
+        if candidates:
+            parents[child] = min(candidates, key=lambda idx: (areas[idx], specs[idx][0] + specs[idx][1], idx))
+    return parents
+
+
+def _sample_specs(parent_target: list[int], cell_inner: int) -> list[tuple[int, int, int]] | None:
+    pool = _spec_pool(cell_inner)
+    n = len(parent_target)
+
+    for _ in range(SPEC_SEARCH_ATTEMPTS):
+        specs = random.sample(pool, n)
+        areas = [h * w for h, w, _t in specs]
+        if len(set(areas)) != n:
+            continue
+        if max(range(n), key=lambda idx: areas[idx]) != 0:
+            continue
+        if _spec_parent_map(specs) == parent_target:
+            return specs
