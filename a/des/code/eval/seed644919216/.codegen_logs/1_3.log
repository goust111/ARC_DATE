+    return bg, sep, rows, cols, cells
+
+
+def _parent_map(cells: list[dict]) -> list[int]:
+    n = len(cells)
+    parents = [-1] * n
+    for child in range(n):
+        candidates = []
+        for parent in range(n):
+            if child == parent:
+                continue
+            if cells[parent]["bbox_area"] <= cells[child]["bbox_area"]:
