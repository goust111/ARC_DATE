+        return False
+    arr = cavity.astype(int)
+    prefix = arr.cumsum(axis=0).cumsum(axis=1)
+
+    def rect_sum(r0: int, c0: int, r1: int, c1: int) -> int:
+        total = int(prefix[r1, c1])
+        if r0 > 0:
+            total -= int(prefix[r0 - 1, c1])
+        if c0 > 0:
+            total -= int(prefix[r1, c0 - 1])
+        if r0 > 0 and c0 > 0:
+            total += int(prefix[r0 - 1, c0 - 1])
+        return total
