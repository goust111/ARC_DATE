def _children_from_parents(parents: list[int]) -> dict[int, list[int]]:
    children: dict[int, list[int]] = {idx: [] for idx in range(len(parents))}
    for child, parent in enumerate(parents):
        if parent != -1:
            children[parent].append(child)
    return children


def _selected_edges(children: dict[int, list[int]], bg: int, shape_colors: list[int]) -> tuple[list[int], list[int]]:
    chosen_child = [-1] * len(shape_colors)
    root = 0
    path = [root]
    current = root
    while children[current]:
        nxt = random.choice(children[current])
        chosen_child[current] = nxt
        path.append(nxt)
        current = nxt
        if current == nxt and not children[current]:
            break

    for node, kids in children.items():
        if not kids or chosen_child[node] != -1:
            continue
        chosen_child[node] = random.choice(kids)

    dot_colors = [bg] * len(shape_colors)
    for node, child in enumerate(chosen_child):
        if child != -1:
            dot_colors[node] = shape_colors[child]
    return dot_colors, path


def _draw_frame(cell: np.ndarray, color: int, spec: tuple[int, int, int]) -> None:
    h, w, t = spec
    r0 = random.randint(1, cell.shape[0] - h)
    c0 = random.randint(1, cell.shape[1] - w)
    cell[r0 : r0 + h, c0 : c0 + w] = color
    cell[r0 + t : r0 + h - t, c0 + t : c0 + w - t] = cell[0, 0]


def _render_input(
    rows: int,
    cols: int,
    sep: int,
    bg: int,
    specs: list[tuple[int, int, int]],
    shape_colors: list[int],
    dot_colors: list[int],
) -> np.ndarray:
    h = rows * (CELL_INNER + 1) + 1
    w = cols * (CELL_INNER + 1) + 1
    grid = np.full((h, w), bg, dtype=int)

    row_lines = [k * (CELL_INNER + 1) for k in range(rows + 1)]
    col_lines = [k * (CELL_INNER + 1) for k in range(cols + 1)]
    grid[row_lines, :] = sep
    grid[:, col_lines] = sep

    slots = [(r, c) for r in range(rows) for c in range(cols)]
    random.shuffle(slots)
    for node, (rr, cc) in enumerate(slots):
        r0 = row_lines[rr] + 1
        c0 = col_lines[cc] + 1
        cell = grid[r0 : r0 + CELL_INNER, c0 : c0 + CELL_INNER]
        if dot_colors[node] != bg:
            cell[0, 0] = dot_colors[node]
        _draw_frame(cell, shape_colors[node], specs[node])

    return grid


def _valid_instance(grid: np.ndarray, path_len: int) -> bool:
    try:
        out = main(grid)
    except Exception:
        return False
    if out.shape != grid.shape:
        return False
    _, sep, rows, cols, cells = _extract_cells(grid)
    if len(rows) - 1 < path_len:
        return False
    if sep == _most_common_color(grid):
        return False
    return len(cells) in (4, 6)


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        rows, cols = random.choice(LAYOUTS)
        parent_target = _topology(rows, cols)
        specs = _sample_specs(parent_target, CELL_INNER)
        if specs is None:
            continue

        palette = random.sample(list(range(10)), len(parent_target) + 2)
        bg, sep = palette[:2]
        shape_colors = palette[2:]

        children = _children_from_parents(parent_target)
        dot_colors, path = _selected_edges(children, bg, shape_colors)
        grid = _render_input(rows, cols, sep, bg, specs, shape_colors, dot_colors)

        if _valid_instance(grid, len(path)):
            return grid

    raise RuntimeError("failed to generate a valid input")

