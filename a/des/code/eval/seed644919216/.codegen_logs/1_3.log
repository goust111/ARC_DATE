                    int(cells[idx]["bbox_area"]),
                    int(cells[idx]["bbox_h"] + cells[idx]["bbox_w"]),
                    int(idx),
                ),
            )
    return parents


def main(grid: np.ndarray) -> np.ndarray:
    """
    Follow the color-indicated containment chain and pack its cells into the leftmost column.
    """
