+def _detect_lattice(grid: np.ndarray) -> tuple[int, list[int], list[int]]:
+    h, w = grid.shape
+    best: tuple[int, list[int], list[int], tuple[int, int, int, int]] | None = None
+
+    for color in map(int, np.unique(grid)):
