+                candidates.append(parent)
+        if candidates:
+            parents[child] = min(
+                candidates,
+                key=lambda idx: (
+                    int(cells[idx]["bbox_area"]),
+                    int(cells[idx]["bbox_h"] + cells[idx]["bbox_w"]),
+                    int(idx),
+                ),
+            )
+    return parents
