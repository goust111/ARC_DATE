+    out[rows, :] = sep
+    out[:, cols] = sep
+
+    for depth, idx in enumerate(path):
+        if depth >= len(rows) - 1:
+            break
+        r0, r1 = rows[depth], rows[depth + 1]
+        c0, c1 = cols[0], cols[1]
+        out[r0 + 1 : r1, c0 + 1 : c1] = cells[idx]["cell"]
+
+    return out
