+def _can_fit_rect(cavity: np.ndarray, target_h: int, target_w: int) -> bool:
+    h, w = cavity.shape
+    if target_h > h or target_w > w:
+        return False
+    arr = cavity.astype(int)
+    prefix = arr.cumsum(axis=0).cumsum(axis=1)
