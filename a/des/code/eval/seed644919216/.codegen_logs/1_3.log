+
+def _shape_mask(cell: np.ndarray, bg: int) -> tuple[np.ndarray, int]:
+    dot_color = int(cell[0, 0]) if int(cell[0, 0]) != bg else bg
+    mask = cell != bg
+    if dot_color != bg:
+        mask = mask.copy()
+        mask[0, 0] = False
+    return mask, dot_color
