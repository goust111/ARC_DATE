+            bbox_r0, bbox_c0, bbox_r1, bbox_c1 = _bbox_from_mask(mask)
+            cavity = _cavity_mask(mask)
+
+            colors = [int(v) for v in cell[mask]]
+            shape_color = int(Counter(colors).most_common(1)[0][0])
+            cells.append(
