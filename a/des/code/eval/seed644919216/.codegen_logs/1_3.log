+
+    row_lines = [k * (CELL_INNER + 1) for k in range(rows + 1)]
+    col_lines = [k * (CELL_INNER + 1) for k in range(cols + 1)]
+    grid[row_lines, :] = sep
+    grid[:, col_lines] = sep
+
+    slots = [(r, c) for r in range(rows) for c in range(cols)]
+    random.shuffle(slots)
+    for node, (rr, cc) in enumerate(slots):
+        r0 = row_lines[rr] + 1
+        c0 = col_lines[cc] + 1
