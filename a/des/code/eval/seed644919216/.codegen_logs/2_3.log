+    frame_bbox = (frame_r0, frame_c0, frame_r0 + frame_h - 1, frame_c0 + frame_w - 1)
+
+    boxes = _sample_block_boxes(height, width, block_size, count, frame_bbox, rng)
+    if boxes is None:
+        return None
