+    edges = _path_edges(g, bg, grey, frame_bbox)
+    solutions = _solve_layout(sorted(blocks), edges, shape, limit=None)
+    chosen = _choose_best_layout(solutions, _block_centers(blocks))
+    return _render_layout(chosen, block_size)
