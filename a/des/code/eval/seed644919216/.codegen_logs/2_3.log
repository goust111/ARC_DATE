+    The generator stays on 2x3 / 3x2 templates because a pure 2x2 adjacency graph is
+    structurally ambiguous under the stated rule.
+    """
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
+        grid = _make_attempt(rng)
+        if grid is not None:
