+
+
+def _draw_polyline(
+    cells: dict[tuple[int, int], int],
+    start: tuple[int, int],
+    first_dir: str,
+    first_len: int,
+    first_color: int,
+    second_dir: str | None = None,
+    second_len: int = 0,
+    second_color: int | None = None,
+) -> list[tuple[int, int]] | None:
+    trial = dict(cells)
+    first = _extend_path(trial, start, first_dir, first_len, first_color)
+    if first is None:
+        return None
+    full = list(first)
+    if second_dir is not None:
