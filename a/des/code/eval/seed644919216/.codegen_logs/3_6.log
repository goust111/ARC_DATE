+    for dr, dc in DIRS.values():
+        nbr = (r + dr, c + dc)
+        if cells.get(nbr) == color:
+            return True
+    return False
+
+
+def _extend_path(
+    cells: dict[tuple[int, int], int],
+    start: tuple[int, int],
