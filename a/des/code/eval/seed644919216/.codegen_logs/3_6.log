+DIRS = {
+    "N": (-1, 0),
+    "S": (1, 0),
+    "W": (0, -1),
+    "E": (0, 1),
+}
+PERP = {
+    "N": ("W", "E"),
+    "S": ("W", "E"),
+    "W": ("N", "S"),
+    "E": ("N", "S"),
+}
+OPPOSITE = {"N": "S", "S": "N", "W": "E", "E": "W"}
