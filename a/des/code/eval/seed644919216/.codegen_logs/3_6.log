+    w: int,
+) -> bool:
+    for r, c in coords:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        if (r, c) in occupied:
+            return False
+    for r, c in coords:
+        for dr, dc in DIRS.values():
+            nbr = (r + dr, c + dc)
+            if nbr in occupied and nbr not in coords:
+                return False
