+def _branch_directions(
+    rng: np.random.Generator,
+    cells: dict[tuple[int, int], int],
+    anchor: tuple[int, int],
+) -> list[str]:
+    occupied_dirs = [
+        direction
+        for direction, (dr, dc) in DIRS.items()
+        if (anchor[0] + dr, anchor[1] + dc) in cells
