+) -> list[tuple[int, int]] | None:
+    dr, dc = DIRS[direction]
+    occupied = set(cells)
+    path: list[tuple[int, int]] = []
+    prev = start
+    for step in range(1, length + 1):
+        cur = (start[0] + dr * step, start[1] + dc * step)
+        if cur in occupied:
+            return None
+        for nr, nc in ((cur[0] + ddr, cur[1] + ddc) for ddr, ddc in DIRS.values()):
+            if (nr, nc) in occupied and (nr, nc) != prev:
+                return None
+        occupied.add(cur)
+        path.append(cur)
+        prev = cur
+    for coord in path:
+        cells[coord] = color
+    return path
+
+
+def _draw_polyline(
+    cells: dict[tuple[int, int], int],
+    start: tuple[int, int],
+    first_dir: str,
+    first_len: int,
+    first_color: int,
+    second_dir: str | None = None,
+    second_len: int = 0,
+    second_color: int | None = None,
+) -> list[tuple[int, int]] | None:
+    trial = dict(cells)
+    first = _extend_path(trial, start, first_dir, first_len, first_color)
+    if first is None:
+        return None
+    full = list(first)
+    if second_dir is not None:
+        assert second_color is not None
+        second = _extend_path(trial, first[-1], second_dir, second_len, second_color)
+        if second is None:
+            return None
+        full.extend(second)
+    cells.clear()
+    cells.update(trial)
+    return full
+
+
+def _random_polyline(
+    rng: np.random.Generator,
+    cells: dict[tuple[int, int], int],
+    start: tuple[int, int],
+    initial_dir: str,
+    marker_color: int,
