+    h, w = grid.shape
+    if height > h or width > w:
+        return False
+
+    for _ in range(PLACEMENT_ATTEMPTS):
+        top = int(rng.integers(0, h - height + 1))
+        left = int(rng.integers(0, w - width + 1))
+        coords = {(top + r, left + c) for r, c in cells}
+        if not _can_place(occupied, coords, h, w):
