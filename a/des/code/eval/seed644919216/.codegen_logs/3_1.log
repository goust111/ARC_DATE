+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MAROON = 9
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8)
+
+GEN_ATTEMPTS = 400
+WORK_H = 32
+WORK_W = 32
+PLACEMENT_PADDING = 2
