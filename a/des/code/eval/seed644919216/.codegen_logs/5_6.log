+
+        values, counts = np.unique(full_in, return_counts=True)
+        bg_count = int(counts[np.where(values == bg)[0][0]])
+        if any(bg_count <= int(cnt) for val, cnt in zip(values.tolist(), counts.tolist(), strict=False) if int(val) != bg):
+            continue
