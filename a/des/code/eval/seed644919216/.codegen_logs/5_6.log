+def _prune_dead_ends(component: np.ndarray, terminals: set[tuple[int, int]]) -> np.ndarray:
+    active = component.copy()
+    deg = _degree_map(active)
+    q: deque[tuple[int, int]] = deque()
+    for r, c in np.argwhere(active):
+        cell = (int(r), int(c))
