+        local_in, local_out = designed
+        margins = (
+            random.randint(2, 6),
+            random.randint(2, 6),
+            random.randint(2, 6),
+            random.randint(2, 6),
+        )
+        full_in = _embed(local_in, bg, margins)
+        full_out = _embed(local_out, bg, margins)
+
+        if not np.array_equal(main(full_in), full_out):
