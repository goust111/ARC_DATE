+    stack = [(0, 0)]
+    visited = {(0, 0)}
+    while stack:
+        r, c = stack[-1]
+        options: list[tuple[int, int, int, int]] = []
+        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
+            nr = r + dr
+            nc = c + dc
