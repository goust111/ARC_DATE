+def _fits(occ: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int) -> bool:
+    H, W = occ.shape
+    r1 = r0 + h
+    c1 = c0 + w
+    if r0 < 1 or c0 < 1 or r1 > H - 1 or c1 > W - 1:
+        return False
