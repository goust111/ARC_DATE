+        out[base_r + r0 : base_r + r1 + 1, base_c + c0 : base_c + c1 + 1] = color
+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    room_count = random.choice(_ROOM_COUNT_CHOICES)
