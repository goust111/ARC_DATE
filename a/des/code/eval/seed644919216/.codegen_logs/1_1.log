+        rooms, walls, areas = random.choice(valid)
+        patch = np.full((inner_h + 2, inner_w + 2), bg, dtype=int)
+        patch[0, :] = fence_color
+        patch[-1, :] = fence_color
+        patch[:, 0] = fence_color
+        patch[:, -1] = fence_color
