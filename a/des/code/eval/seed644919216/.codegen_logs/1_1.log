+        return patch, rooms, areas
+    return None
+
+
+def _factor_pairs(n: int) -> list[tuple[int, int]]:
+    pairs = []
+    for h in range(1, int(n**0.5) + 1):
+        if n % h != 0:
+            continue
+        w = n // h
+        pairs.append((h, w))
+        if h != w:
+            pairs.append((w, h))
+    return pairs
+
+
+def _make_sample_patch(area: int, color: int, bg: int, fence_color: int) -> np.ndarray:
+    total = area + 1
