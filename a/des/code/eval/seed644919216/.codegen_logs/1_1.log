+_GEN_RETRIES = 400
+_GRID_H_RANGE = (20, 30)
+_GRID_W_RANGE = (22, 32)
+_OUTER_H_RANGE = (9, 13)
+_OUTER_W_RANGE = (10, 15)
+_ROOM_COUNT_RANGE = (2, 4)
+_MAX_ROOM_AREA = 16
