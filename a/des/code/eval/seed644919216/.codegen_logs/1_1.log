+def _random_colors(room_count: int) -> tuple[int, int, list[int]]:
+    colors = list(range(10))
+    bg = random.choice(colors)
+    rest = [c for c in colors if c != bg]
+    fence = random.choice(rest)
+    fill_colors = random.sample([c for c in rest if c != fence], room_count)
+    return int(bg), int(fence), [int(c) for c in fill_colors]
+
+
+def _split_room(
+    patch: np.ndarray, room: tuple[int, int, int, int], fence_color: int
+) -> list[tuple[int, int, int, int]] | None:
+    r0, c0, r1, c1 = room
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    options = []
+    if width >= 3:
+        options.append("v")
+    if height >= 3:
+        options.append("h")
+    if not options:
+        return None
+    orient = random.choice(options)
+    if orient == "v":
+        wall_c = random.randint(c0 + 1, c1 - 1)
+        patch[r0 : r1 + 1, wall_c] = fence_color
+        return [(r0, c0, r1, wall_c - 1), (r0, wall_c + 1, r1, c1)]
+    wall_r = random.randint(r0 + 1, r1 - 1)
+    patch[wall_r, c0 : c1 + 1] = fence_color
+    return [(r0, c0, wall_r - 1, c1), (wall_r + 1, c0, r1, c1)]
+
+
+def _make_fence_patch(room_count: int, bg: int, fence_color: int):
+    outer_h = random.randint(*_OUTER_H_RANGE)
+    outer_w = random.randint(*_OUTER_W_RANGE)
+    patch = np.full((outer_h, outer_w), bg, dtype=int)
+    patch[0, :] = fence_color
+    patch[-1, :] = fence_color
+    patch[:, 0] = fence_color
+    patch[:, -1] = fence_color
+
+    rooms = [(1, 1, outer_h - 2, outer_w - 2)]
+    for _ in range(30):
+        if len(rooms) >= room_count:
+            break
+        splittable = [room for room in rooms if room[2] - room[0] >= 2 or room[3] - room[1] >= 2]
+        if not splittable:
+            break
+        room = random.choice(splittable)
+        new_rooms = _split_room(patch, room, fence_color)
