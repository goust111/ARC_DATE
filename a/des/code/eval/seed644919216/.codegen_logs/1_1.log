+            left = wall_c - 1
+            right = inner_w - wall_c
+            top = wall_r - 1
+            bottom = inner_h - wall_r
+            if min(left, right, top, bottom) < 1:
+                continue
+            rooms = [
+                (1, 1, wall_r - 1, wall_c - 1),
+                (1, wall_c + 1, wall_r - 1, inner_w),
+                (wall_r + 1, 1, inner_h, wall_c - 1),
+                (wall_r + 1, wall_c + 1, inner_h, inner_w),
