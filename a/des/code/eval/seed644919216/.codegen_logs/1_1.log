+        area, color = entry
+        assert area not in mapping or mapping[area] == color
+        mapping[area] = color
+    assert mapping
+
+    r0, c0, r1, c1 = fence["bbox"]
+    sub = g[r0 : r1 + 1, c0 : c1 + 1]
+    out = g.copy()
