+    vals = [int(sub[r, c]) for r, c in pts]
+    interior_colors = {v for v in vals if v not in (bg, fence_color)}
+    if len(interior_colors) != 1:
+        return None
+    colored_count = sum(v not in (bg, fence_color) for v in vals)
+    if colored_count != 1:
