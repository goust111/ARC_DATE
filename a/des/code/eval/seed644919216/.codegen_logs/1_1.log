+        out[base_r + r0 : base_r + r1 + 1, base_c + c0 : base_c + c1 + 1] = color
+    return out
+
+
+def _coord_in_component(comp: dict, coord: tuple[int, int]) -> bool:
+    target = np.array(coord, dtype=int)
+    return bool(np.any(np.all(comp["coords"] == target, axis=1)))
