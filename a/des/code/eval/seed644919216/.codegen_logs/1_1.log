+import random
+from collections import deque
+
+import numpy as np
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _mask_components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _color_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            arr = np.array(pts, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": _bbox(arr),
+                    "area": int(len(arr)),
+                }
+            )
+    return comps
+
+
+def _component_local_mask(comp: dict) -> np.ndarray:
+    r0, c0, r1, c1 = comp["bbox"]
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    rel = comp["coords"] - np.array([r0, c0], dtype=int)
+    mask[rel[:, 0], rel[:, 1]] = True
+    return mask
+
+
+def _enclosed_regions(component_mask: np.ndarray) -> list[np.ndarray]:
+    free = ~component_mask
+    h, w = free.shape
+    seen = np.zeros((h, w), dtype=bool)
+    regions: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not free[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            touches_edge = False
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                if cr == 0 or cr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_edge = True
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if free[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            if not touches_edge:
+                regions.append(np.array(pts, dtype=int))
+    return regions
+
+
+def _sample_mapping_entry(
+    grid: np.ndarray, comp: dict, bg: int, fence_color: int
+) -> tuple[int, int] | None:
+    r0, c0, r1, c1 = comp["bbox"]
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    regions = _enclosed_regions(_component_local_mask(comp))
+    if len(regions) != 1:
+        return None
+    pts = regions[0]
+    vals = [int(sub[r, c]) for r, c in pts]
+    interior_colors = {v for v in vals if v not in (bg, fence_color)}
+    if len(interior_colors) != 1:
+        return None
+    colored_count = sum(v not in (bg, fence_color) for v in vals)
+    if colored_count != 1:
+        return None
+    bg_area = sum(v == bg for v in vals)
+    if bg_area <= 0:
+        return None
+    return int(bg_area), int(next(iter(interior_colors)))
+
