+            candidates.append((rooms, walls))
+    return candidates
+
+
+def _four_room_candidates(inner_h: int, inner_w: int):
+    candidates = []
+    for wall_c in range(2, inner_w):
+        for wall_r in range(2, inner_h):
+            left = wall_c - 1
