+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    if np.array_equal(inp, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

