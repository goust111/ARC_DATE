_GEN_SIZE = 20
_GEN_GLYPH_COLORS = [1, 2, 3, 6, 7]
_GEN_FRAME_COLORS = (1, 2, 5, 7, 9)
# Object counts and retry budget.
_GEN_MARKER_COUNT_RANGE = (1, 3)
