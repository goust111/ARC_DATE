+    pairs.sort(key=lambda hw: (abs(hw[0] - hw[1]), hw[0] + hw[1]))
+    top = pairs[: min(3, len(pairs))]
+    inner_h, inner_w = random.choice(top)
+    patch = np.full((inner_h + 2, inner_w + 2), bg, dtype=int)
+    patch[0, :] = fence_color
+    patch[-1, :] = fence_color
