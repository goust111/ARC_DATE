+    assert g.ndim == 2
+
+    bg = _bg_color(g)
+    comps = _color_components(g, bg)
+    assert comps
+
+    largest_area = max(comp["area"] for comp in comps)
+    largest_candidates = [comp for comp in comps if comp["area"] == largest_area]
+    assert len(largest_candidates) == 1
+    fence = largest_candidates[0]
