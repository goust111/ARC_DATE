+
+def _place_rect_patch(
+    grid: np.ndarray, occ: np.ndarray, patch: np.ndarray, pad: int
+) -> tuple[int, int] | None:
+    H, W = grid.shape
+    ph, pw = patch.shape
+    positions = []
+    for r0 in range(1, H - ph):
