+                (wall_r + 1, 1, inner_h, wall_c - 1),
+                (1, wall_c + 1, inner_h, inner_w),
+            ]
+            walls = [("v", wall_c, 1, inner_h), ("h", wall_r, 1, wall_c - 1)]
+            candidates.append((rooms, walls))
+
+            rooms = [
+                (1, 1, inner_h, wall_c - 1),
+                (1, wall_c + 1, wall_r - 1, inner_w),
