+    c1 = c0 + w
+    if r0 < 1 or c0 < 1 or r1 > H - 1 or c1 > W - 1:
+        return False
+    rs = max(0, r0 - pad)
+    cs = max(0, c0 - pad)
+    re = min(H, r1 + pad)
+    ce = min(W, c1 + pad)
+    return not occ[rs:re, cs:ce].any()
+
