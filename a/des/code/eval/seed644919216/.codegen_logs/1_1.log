+        valid = []
+        for rooms, walls in candidates:
+            areas = [_room_area(room) for room in rooms]
+            if len(set(areas)) != room_count or max(areas) > _MAX_ROOM_AREA:
+                continue
+            valid.append((rooms, walls, areas))
