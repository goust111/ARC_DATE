+) -> tuple[int, int] | None:
+    H, W = grid.shape
+    ph, pw = patch.shape
+    positions = []
+    for r0 in range(1, H - ph):
+        for c0 in range(1, W - pw):
+            if _fits(occ, r0, c0, ph, pw, pad):
+                positions.append((r0, c0))
+    if not positions:
+        return None
+    r0, c0 = random.choice(positions)
+    grid[r0 : r0 + ph, c0 : c0 + pw] = patch
+    occ[r0 : r0 + ph, c0 : c0 + pw] = True
+    return int(r0), int(c0)
