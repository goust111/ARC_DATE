+PIECE_COUNT_RANGE = (3, 5)
+PIECE_BOX_SIDE_RANGE = (2, 4)
+PIECE_AREA_RANGE = (3, 7)
+SHADOW_MARGIN = 3
+SHADOW_BOX_H_RANGE = (9, 14)
