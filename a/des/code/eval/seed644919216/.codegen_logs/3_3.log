+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < h:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < w:
+        out.append((r, c + 1))
+    return out
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]] | set[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _touches_border(points: list[tuple[int, int]] | set[tuple[int, int]], h: int, w: int) -> bool:
+    return any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in points)
+
+
+def _most_common_color(arr: np.ndarray) -> int:
+    vals, cnts = np.unique(arr, return_counts=True)
+    return int(vals[int(np.argmax(cnts))])
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    rows, cols = np.where(mask)
+    return mask[rows.min() : rows.max() + 1, cols.min() : cols.max() + 1]
+
+
+def _expanded_cells(cells: set[tuple[int, int]], h: int, w: int, radius: int = 1) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for dr in range(-radius, radius + 1):
+            for dc in range(-radius, radius + 1):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    out.add((nr, nc))
+    return out
+
+
+def _mask_to_cells(mask: np.ndarray, top: int, left: int) -> set[tuple[int, int]]:
+    pts: set[tuple[int, int]] = set()
+    for r, c in np.argwhere(mask):
+        pts.add((top + int(r), left + int(c)))
+    return pts
+
+
+def _random_manhattan_path(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = a
+    tr, tc = b
+    path = [(r, c)]
+    dr = 1 if tr > r else -1
+    dc = 1 if tc > c else -1
+    rem_r = abs(tr - r)
+    rem_c = abs(tc - c)
+    while rem_r > 0 or rem_c > 0:
+        axes: list[str] = []
+        if rem_r > 0:
+            axes.append("r")
+        if rem_c > 0:
+            axes.append("c")
+        axis = random.choice(axes)
+        if axis == "r":
+            r += dr
+            rem_r -= 1
+        else:
+            c += dc
+            rem_c -= 1
+        path.append((r, c))
+    return path
+
