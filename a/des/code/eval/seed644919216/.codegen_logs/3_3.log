+            placed = True
+            break
+        if not placed:
+            return None
+
+    return [p for p in placements if p is not None]
+
+
+def _build_expected_output(
+    h: int,
+    w: int,
+    shadow: set[tuple[int, int]],
+    piece_cells: list[set[tuple[int, int]]],
+    colors: list[int],
+) -> np.ndarray:
