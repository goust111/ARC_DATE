+            nc = lc0 + (c - fc0)
+            assert 0 <= nr < h and 0 <= nc < w, "translated fragment left the grid"
+            assert shadow_mask[nr, nc], "translated fragment must stay inside the shadow"
+            placed_cells.append((nr, nc))
