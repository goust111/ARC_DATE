+# --------------- generator ---------------
+
+BG_COLOR = 0
+SHADOW_COLOR = 5
+PIECE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GRID_H_RANGE = (18, 27)
+GRID_W_RANGE = (18, 27)
+PIECE_COUNT_RANGE = (3, 5)
+PIECE_BOX_SIDE_RANGE = (2, 4)
+PIECE_AREA_RANGE = (3, 7)
+SHADOW_MARGIN = 3
+SHADOW_BOX_H_RANGE = (9, 14)
+SHADOW_BOX_W_RANGE = (10, 16)
+SHADOW_DENSITY_RANGE = (0.50, 0.72)
+MAX_RETRIES = 400
