+        cover_counts[color] = len(placed_cells)
+        for nr, nc in placed_cells:
+            out[nr, nc] = color
+            covered[nr, nc] = True
+
+    fill_color = max(cover_counts.items(), key=lambda kv: kv[1])[0]
+    remainder = shadow_mask & ~covered
+    out[remainder] = fill_color
+    return out
