+
+def _grow_shadow(
+    seeds: set[tuple[int, int]], box_r0: int, box_c0: int, box_h: int, box_w: int, target_area: int
+) -> set[tuple[int, int]]:
+    shadow = set(seeds)
+    while len(shadow) < target_area:
