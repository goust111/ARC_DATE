+    while len(shadow) < target_area:
+        frontier: set[tuple[int, int]] = set()
+        for r, c in shadow:
+            for nr, nc in _neighbors4(r, c, box_r0 + box_h, box_c0 + box_w):
+                if box_r0 <= nr < box_r0 + box_h and box_c0 <= nc < box_c0 + box_w and (nr, nc) not in shadow:
