+def _gen_attempt() -> Optional[np.ndarray]:
+    path_count = random.randint(MIN_PATHS, MAX_PATHS)
+    height = path_count * BAND_PITCH + 1
+    width = random.randint(MIN_WIDTH, MAX_WIDTH)
