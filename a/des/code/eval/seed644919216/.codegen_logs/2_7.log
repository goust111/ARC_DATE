+
+def _nonblack_neighbor_dirs(grid: np.ndarray, r: int, c: int) -> list[tuple[int, int]]:
+    result: list[tuple[int, int]] = []
+    for dr, dc in DIRS:
+        rr, cc = r + dr, c + dc
+        if _in_bounds(grid.shape, rr, cc) and int(grid[rr, cc]) != BLACK:
+            result.append((dr, dc))
+    return result
