+
+def _choose_change_columns(endpoint_x: int, change_count: int) -> Optional[list[int]]:
+    cols: list[int] = []
+    min_x = 3
+    for idx in range(change_count):
+        remaining = change_count - idx - 1
+        max_x = endpoint_x - 2 - 3 * remaining
+        if min_x > max_x:
