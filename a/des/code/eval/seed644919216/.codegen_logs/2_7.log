+def _turn_color(in_dir: tuple[int, int], out_dir: tuple[int, int]) -> int:
+    delta = (DIR_TO_INDEX[out_dir] - DIR_TO_INDEX[in_dir]) % 4
+    if delta == 0:
+        return GREEN
+    if delta == 1:
+        return RED
+    if delta == 3:
+        return BLUE
+    raise ValueError(f"unsupported turn: {in_dir} -> {out_dir}")
