+            _apply_cells(grid, cells)
+    except ValueError:
+        return None
+
+    rotation = random.randrange(4)
+    grid = np.rot90(grid, rotation).copy()
+
+    if not _validate_generated_grid(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
