                    paste(canvas, dist_arr, pr, pc, transparent=bg)
                    paste(inp, dist_arr, pr, pc, transparent=bg)
                except ValueError:
                    pass  # skip distractor if no room

    # Oracle check
    result = main(inp)
    if not np.array_equal(result, out):
        return None

    return inp

