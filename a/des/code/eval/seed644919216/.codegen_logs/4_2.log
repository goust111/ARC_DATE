+        if idx in directions:
+            final_teeth = _rotate_teeth(gear["teeth"], directions[idx])
+        for side in final_teeth:
+            rr, cc = _tooth_cell(gear["center"], side)
+            out[rr, cc] = gear["color"]
+
+    return out
