+def _sample_pattern(inner_h: int, inner_w: int, count: int) -> list[tuple[int, int]]:
+    assert count >= 1
+    cells = [(r, c) for r in range(inner_h) for c in range(inner_w) if (r, c) != (0, 0)]
+    points = [(0, 0)]
