+            pattern, tile_shape = templates[int(seed_color)]
+            tile_h, tile_w = map(int, tile_shape)
+            for dr in range(-radius, radius + 1):
+                for dc in range(-radius, radius + 1):
+                    base_r = int(seed_r) + dr * tile_h
+                    base_c = int(seed_c) + dc * tile_w
