+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _is_rectangle_frame(coords: list[tuple[int, int]]) -> bool:
+    if not coords:
+        return False
+    r0, c0, r1, c1 = _bbox(coords)
+    if r1 - r0 < 3 or c1 - c0 < 3:
