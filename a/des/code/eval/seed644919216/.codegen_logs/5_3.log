+def _choose_shape(
+    inner_h: int, inner_w: int, force_single: bool = False
+) -> tuple[tuple[int, int], ...]:
+    if force_single:
+        return SEED_SHAPES[0]
+    fitting = []
+    for shape in SEED_SHAPES:
+        sh, sw = _shape_dims(shape)
