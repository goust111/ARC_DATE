+def _detect_checkerboard_pair(grid: np.ndarray, frame_color: int) -> tuple[int, int]:
+    colors = [int(c) for c in np.unique(grid) if int(c) != int(frame_color)]
+    rr, cc = np.indices(grid.shape)
+    parity = (rr + cc) & 1
+    usable = grid != int(frame_color)
