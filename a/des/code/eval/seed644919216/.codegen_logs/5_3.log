+
+def _paint_checkerboard(shape: tuple[int, int], bg_pair: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    rr, cc = np.indices((h, w))
+    parity = (rr + cc) & 1
+    out = np.full((h, w), int(bg_pair[0]), dtype=int)
+    out[parity == 1] = int(bg_pair[1])
+    return out
