+    assert start_rays, "expected at least one ray attached to a portal marker"
+    start_rays.sort(key=lambda item: (int(item["portal_id"]), int(item["color"])))
+    for ray in start_rays:
+        _extend_ray(
+            out,
+            int(ray["portal_id"]),
+            int(ray["color"]),
+            tuple(ray["direction"]),
+            portals,
+            pair_of,
+            marker_to_portal,
+            portal_body_cells,
+        )
