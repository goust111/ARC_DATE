+        marker_color = int(singleton_by_cell[marker_cell])
+        marker_votes[marker_color] += 1
+        raw_candidates.append(
+            {
+                "color": int(comp["color"]),
+                "coords": coords,
+                "bbox": comp["bbox"],
+                "marker": marker_cell,
