+
+def _side_from_marker(
+    bbox: tuple[int, int, int, int], marker: tuple[int, int]
+) -> tuple[int, int] | None:
+    r0, c0, r1, c1 = bbox
+    mr, mc = marker
+    if mr == r0 - 1 and c0 <= mc <= c1:
+        return (-1, 0)
+    if mr == r1 + 1 and c0 <= mc <= c1:
+        return (1, 0)
+    if mc == c0 - 1 and r0 <= mr <= r1:
+        return (0, -1)
+    if mc == c1 + 1 and r0 <= mr <= r1:
+        return (0, 1)
+    return None
