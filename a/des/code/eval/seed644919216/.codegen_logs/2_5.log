+    marker_to_portal: dict[tuple[int, int], int] = {}
+    by_shape: dict[tuple[tuple[int, int], tuple[tuple[int, int], ...]], list[int]] = {}
+    body_cells: set[tuple[int, int]] = set()
+    for portal in paired_portals:
