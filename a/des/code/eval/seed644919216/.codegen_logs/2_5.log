+
+    for pair_id in range(pair_count):
+        if not start_flags[pair_id]:
+            continue
+        marker = markers[(pair_id, "entry")]
+        max_len = _entry_ray_max_len(marker, side, grid.shape)
+        max_len = min(max_len, 4)
+        if max_len < 1:
