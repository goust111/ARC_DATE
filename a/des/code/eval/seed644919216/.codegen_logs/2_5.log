+
+    min_r = max(0, min(r for r, _ in all_cells) - 1)
+    max_r = min(grid.shape[0] - 1, max(r for r, _ in all_cells) + 1)
+    min_c = max(0, min(c for _, c in all_cells) - 1)
+    max_c = min(grid.shape[1] - 1, max(c for _, c in all_cells) + 1)
