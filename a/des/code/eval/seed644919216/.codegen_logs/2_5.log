+def _find_start_ray(
+    grid: np.ndarray,
+    portal: dict[str, object],
+    bg: int,
+    marker_color: int,
+    portal_body_cells: set[tuple[int, int]],
+) -> dict[str, object] | None:
+    dr, dc = portal["direction"]
+    mr, mc = portal["marker"]
+    nr, nc = int(mr + dr), int(mc + dc)
+    if not _in_bounds(grid.shape, nr, nc):
+        return None
+    if (nr, nc) in portal_body_cells:
+        return None
