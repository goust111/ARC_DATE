+    legend_c0 = int(c0_values[np.argmax(c0_counts)])
+    blocks = [(r0, color, comp) for r0, c0, color, comp in candidates if c0 == legend_c0]
+    blocks.sort(key=lambda item: item[0])
+
+    legend_mask = np.zeros((h, w), dtype=bool)
