+
+
+def _make_vertical_module(
+    rng: np.random.Generator, bg: int, portal_color: int, transform: str
+) -> dict[str, object]:
+    line_len = int(rng.integers(5, 9))
+    shape_h = int(rng.integers(2, min(5, line_len) + 1))
+    shape_w = int(rng.integers(2, 5))
