+        inp, expected = generated
+        try:
+            actual = main(inp)
+        except Exception:
+            continue
+        if np.array_equal(actual, expected):
+            return inp
+    raise RuntimeError(f"failed to generate a valid puzzle after {GEN_ATTEMPTS} attempts")

