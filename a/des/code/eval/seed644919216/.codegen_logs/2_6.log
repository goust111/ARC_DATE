    for r,c in pts:
        if (r-1,c) not in pts: edges.append(((r,c),(r,c+1)))
        if (r+1,c) not in pts: edges.append(((r+1,c),(r+1,c+1)))
        if (r,c-1) not in pts: edges.append(((r,c),(r+1,c)))
        if (r,c+1) not in pts: edges.append(((r,c+1),(r+1,c+1)))
