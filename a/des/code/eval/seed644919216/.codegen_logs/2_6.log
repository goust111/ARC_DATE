+def _fill_region(out: np.ndarray, cells: list[tuple[int, int]], tile: np.ndarray) -> None:
+    th, tw = tile.shape
+    r0 = min(r for r, _ in cells)
+    c0 = min(c for _, c in cells)
+    for r, c in cells:
