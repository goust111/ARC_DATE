+        if (r + 1, c) not in pts:
+            edges.add(((r + 1, c), (r + 1, c + 1)))
+        if (r, c - 1) not in pts:
+            edges.add(((r, c), (r + 1, c)))
+        if (r, c + 1) not in pts:
+            edges.add(((r, c + 1), (r + 1, c + 1)))
