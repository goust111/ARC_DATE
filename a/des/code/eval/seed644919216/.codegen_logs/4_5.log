+    return deltas[0]
+
+
+def _parse_stamp(
+    grid: np.ndarray,
+    coords: np.ndarray,
+    bg: int,
+    stamp_size: int,
+) -> tuple[np.ndarray, int, int]:
+    r0, c0, r1, c1 = _bbox(coords)
