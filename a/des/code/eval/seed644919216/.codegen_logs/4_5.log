+    top_markers = [(c, int(g[fr0, c])) for c in range(fc0 + 1, fc1) if int(g[fr0, c]) != frame_color]
+    left_markers = [(r, int(g[r, fc0])) for r in range(fr0 + 1, fr1) if int(g[r, fc0]) != frame_color]
