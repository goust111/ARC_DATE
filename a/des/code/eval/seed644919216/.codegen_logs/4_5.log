+
+def _uniform_spacing(positions: list[int]) -> int | None:
+    if len(positions) < 2:
+        return None
+    deltas = [b - a for a, b in zip(positions, positions[1:])]
+    if len(set(deltas)) != 1:
+        raise AssertionError("frame markers must be equally spaced")
+    return deltas[0]
