+    bg = _get_bg(g)
+    (fr0, fc0, fr1, fc1), frame_coords = _find_frame(g, bg)
+    frame_mask = np.zeros_like(g, dtype=bool)
+    frame_mask[frame_coords[:, 0], frame_coords[:, 1]] = True
+    frame_color = _dominant_color(g[frame_mask])
