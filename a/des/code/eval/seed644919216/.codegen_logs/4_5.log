+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME_COLOR = 5
+ALL_COLORS = tuple(range(10))
+MARKER_POOL = tuple(color for color in ALL_COLORS if color not in {BG, FRAME_COLOR})
+LAYOUT_OPTIONS = ((2, 2), (2, 3), (3, 2), (3, 3), (2, 4), (4, 2))
+STAMP_SIZE_RANGE = (2, 4)
+MAX_GENERATION_ATTEMPTS = 300
