+    row_counts = np.count_nonzero(sub != bg, axis=1)
+    col_counts = np.count_nonzero(sub != bg, axis=0)
+    sparse_rows = np.flatnonzero(row_counts == 1)
+    sparse_cols = np.flatnonzero(col_counts == 1)
