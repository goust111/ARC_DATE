+    assert candidates, "expected a hollow rectangular frame"
+    _, bbox, coords = max(candidates, key=lambda item: item[0])
+    return bbox, coords
+
+
+def _uniform_spacing(positions: list[int]) -> int | None:
+    if len(positions) < 2:
+        return None
+    deltas = [b - a for a, b in zip(positions, positions[1:])]
+    if len(set(deltas)) != 1:
