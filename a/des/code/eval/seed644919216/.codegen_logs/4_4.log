+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+ALL_COLORS = tuple(range(1, 10))
+MAX_GENERATION_ATTEMPTS = 400
+
+DIR_UP = (-1, 0)
+DIR_DOWN = (1, 0)
+DIR_LEFT = (0, -1)
+DIR_RIGHT = (0, 1)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _find_prisms(grid: np.ndarray) -> tuple[dict[tuple[int, int], tuple[int, int]], dict[tuple[int, int], tuple[int, int]]]:
+    h, w = grid.shape
+    prisms: dict[tuple[int, int], tuple[int, int]] = {}
+    prism_cells: dict[tuple[int, int], tuple[int, int]] = {}
+    used: set[tuple[int, int]] = set()
+    for r in range(h - 1):
+        for c in range(w - 1):
+            cells = ((r, c), (r, c + 1), (r + 1, c), (r + 1, c + 1))
+            if any(cell in used for cell in cells):
+                continue
+            a = int(grid[r, c])
+            b = int(grid[r, c + 1])
+            d = int(grid[r + 1, c + 1])
+            e = int(grid[r + 1, c])
+            if a == BG or b == BG or d == BG or e == BG:
+                continue
+            if a != d or b != e or a == b:
+                continue
+            prisms[(r, c)] = (a, b)
+            for cell in cells:
+                used.add(cell)
+                prism_cells[cell] = (r, c)
+    return prisms, prism_cells
+
+
+def _find_towers(grid: np.ndarray, prism_cells: dict[tuple[int, int], tuple[int, int]]) -> list[dict[str, object]]:
+    h, w = grid.shape
+    towers: list[dict[str, object]] = []
+    for color in map(int, np.unique(grid)):
+        if color == BG:
+            continue
+        mask = (grid == color).copy()
+        for r, c in prism_cells:
+            mask[r, c] = False
+        for comp in _components(mask):
+            if len(comp) != 2:
+                continue
+            (r0, c0), (r1, c1) = sorted(comp)
+            start: tuple[int, int] | None = None
+            direction: tuple[int, int] | None = None
+            if r0 == r1 and abs(c1 - c0) == 1:
+                left, right = sorted((c0, c1))
+                if left == 0 and right == 1:
+                    start = (r0, 2)
+                    direction = DIR_RIGHT
+                elif left == w - 2 and right == w - 1:
+                    start = (r0, w - 3)
+                    direction = DIR_LEFT
+            elif c0 == c1 and abs(r1 - r0) == 1:
+                top, bottom = sorted((r0, r1))
+                if top == 0 and bottom == 1:
+                    start = (2, c0)
+                    direction = DIR_DOWN
+                elif top == h - 2 and bottom == h - 1:
+                    start = (h - 3, c0)
+                    direction = DIR_UP
+            if start is None or direction is None:
+                continue
+            towers.append(
+                {
+                    "color": color,
+                    "cells": tuple(comp),
+                    "start": start,
+                    "dir": direction,
+                }
+            )
+    return towers
+
+
+def _find_bulbs(
+    grid: np.ndarray,
+    prism_cells: dict[tuple[int, int], tuple[int, int]],
+    tower_cells: set[tuple[int, int]],
+) -> dict[tuple[int, int], int]:
+    bulbs: dict[tuple[int, int], int] = {}
+    blocked = set(prism_cells) | tower_cells
+    for color in map(int, np.unique(grid)):
+        if color == BG:
+            continue
+        mask = (grid == color).copy()
+        for r, c in blocked:
+            mask[r, c] = False
+        for comp in _components(mask):
+            assert len(comp) == 1, "non-prism, non-tower objects must be singleton bulbs"
+            bulbs[comp[0]] = color
+    return bulbs
+
+
+def _split_from_prism(
+    grid: np.ndarray,
+    anchor: tuple[int, int],
+    direction: tuple[int, int],
+) -> list[tuple[int, int, int, int, int]]:
+    r, c = anchor
+    a = int(grid[r, c])
+    b = int(grid[r, c + 1])
+    if direction == DIR_DOWN:
+        return [
+            (r, c - 1, 0, -1, a),
+            (r, c + 2, 0, 1, b),
+        ]
+    if direction == DIR_UP:
+        return [
+            (r + 1, c - 1, 0, -1, b),
+            (r + 1, c + 2, 0, 1, a),
+        ]
+    if direction == DIR_RIGHT:
+        return [
+            (r - 1, c, -1, 0, a),
+            (r + 2, c, 1, 0, b),
+        ]
+    assert direction == DIR_LEFT
+    return [
+        (r - 1, c + 1, -1, 0, b),
+        (r + 2, c + 1, 1, 0, a),
+    ]
+
+
+def _simulate_scene(grid: np.ndarray, return_meta: bool = False):
