+
+
+def _build_single_prism() -> tuple[np.ndarray, dict[str, int]] | None:
+    h = random.randint(12, 18)
+    w = random.randint(12, 18)
+    grid = np.zeros((h, w), dtype=int)
+
+    add_second_tower = random.random() < 0.55
