+
+def _rect_distance(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> int:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    dr = max(0, br0 - ar1 - 1, ar0 - br1 - 1)
+    dc = max(0, bc0 - ac1 - 1, ac0 - bc1 - 1)
