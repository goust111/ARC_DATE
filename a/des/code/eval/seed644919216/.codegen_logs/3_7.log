+def _bbox(points: list[tuple[int, int]] | np.ndarray) -> tuple[int, int, int, int]:
+    pts = np.asarray(points, dtype=int)
+    return int(pts[:, 0].min()), int(pts[:, 1].min()), int(pts[:, 0].max()), int(pts[:, 1].max())
