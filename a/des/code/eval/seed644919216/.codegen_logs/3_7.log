+    return int(pts[:, 0].min()), int(pts[:, 1].min()), int(pts[:, 0].max()), int(pts[:, 1].max())
+
+
+def _split_spans(length: int, cuts: list[int]) -> list[tuple[int, int]]:
+    spans = []
+    start = 0
+    for cut in sorted(cuts):
+        if start < cut:
+            spans.append((start, cut))
+        start = cut + 1
+    if start < length:
+        spans.append((start, length))
+    return spans
+
+
