+import numpy as np
+
+
+AZURE = 8
+BLACK = 0
+GREY = 5
+MAROON = 9
+COLOR_POOL = [1, 2, 3, 4, 6, 7]
+
+H_ONLY = (True, False)
+V_ONLY = (False, True)
+BOTH = (True, True)
+NONE = (False, False)
+SYM_TYPES = [H_ONLY, V_ONLY, BOTH, NONE]
