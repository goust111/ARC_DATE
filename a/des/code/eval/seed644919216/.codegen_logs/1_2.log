+
+
+def _place_filler(
+    grid: np.ndarray,
+    reserved: np.ndarray,
+    protected: np.ndarray,
+    bg: int,
+    rng: np.random.Generator,
+) -> bool:
+    directions = list(ARROW_SPECS)
+    rng.shuffle(directions)
+    all_choices: list[tuple[str, int, int]] = []
+    for direction in directions:
