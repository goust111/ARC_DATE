+    current_color = int(scene["arrow_color"])
+    r, c = arrow["tip"]
+    dr, dc = arrow["step"]
+    path_cells: list[tuple[int, int]] = []
+    crossings = 0
+    painted = 0
+
+    while True:
+        r += dr
+        c += dc
+        if not _in_bounds(g.shape, r, c):
+            return {
+                "stop": "boundary",
+                "crossings": crossings,
+                "painted": painted,
+                "path_cells": tuple(path_cells),
+                "final_color": current_color,
+            }
+        if arrow_mask[r, c]:
+            return {
+                "stop": "arrow",
+                "crossings": crossings,
+                "painted": painted,
+                "path_cells": tuple(path_cells),
+                "final_color": current_color,
+            }
