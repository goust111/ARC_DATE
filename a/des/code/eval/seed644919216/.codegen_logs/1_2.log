+# rows 1/4/1 with the tip on the right and a two-pixel tail on the middle row.
+ARROW_SPECS = {
+    "R": {
+        "coords": ((0, 2), (1, 0), (1, 1), (1, 2), (1, 3), (2, 2)),
+        "tip": (1, 3),
+        "step": (0, 1),
