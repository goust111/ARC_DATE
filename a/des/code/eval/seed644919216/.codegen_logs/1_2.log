+    return out
+
+
+def _place_arrow(
+    grid: np.ndarray,
+    reserved: np.ndarray,
+    protected: np.ndarray,
+    bg: int,
+    direction: str,
+    top: int,
+    left: int,
+) -> dict[str, object]:
+    arrow = _build_arrow(direction, top, left)
+    for r, c in arrow["coords"]:
+        assert grid[r, c] == bg and not reserved[r, c] and not protected[r, c]
