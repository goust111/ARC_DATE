        "bg": bg,
        "arrow_color": arrow_color,
        "stripe_axis": stripe_axis,
        "stripe_mask": stripe_mask,
        "stripe_rows": stripe_rows,
        "stripe_cols": stripe_cols,
        "arrow_mask": arrow_mask,
        "arrows": arrows,
