+        "step": (-1, 0),
+        "size": (4, 3),
+    },
+    "D": {
+        "coords": ((0, 1), (1, 1), (2, 0), (2, 1), (2, 2), (3, 1)),
+        "tip": (3, 1),
+        "step": (1, 0),
+        "size": (4, 3),
+    },
