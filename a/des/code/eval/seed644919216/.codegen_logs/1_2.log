+        parallel_dirs = ["U", "D"]
+
+    crossing = _place_with_predicate(
+        grid,
+        reserved,
+        protected,
+        bg,
+        stripe_axis,
+        stripe_positions,
+        crossing_dirs,
+        lambda info: info["stop"] == "boundary" and info["crossings"] >= 1 and info["painted"] >= 2,
+        rng,
+    )
+    if crossing is None:
+        return None
+    crossing_arrow, crossing_info = crossing
+    for r, c in crossing_info["path_cells"]:
