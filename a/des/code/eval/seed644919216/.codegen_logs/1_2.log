+) -> tuple[dict[str, object], dict[str, object], dict[str, object]] | None:
+    pair_options: list[tuple[str, int, int, str, int, int, dict[str, object]]] = []
+    shooter_dirs = ["L", "R"]
+    blocker_dirs = ["L", "R"]
+
+    for shooter_dir in shooter_dirs:
