+                    scene = _scene_from_generation(pair_grid, stripe_axis, stripe_positions)
+                    shooter_scene_arrow = next(candidate for candidate in scene["arrows"] if candidate["tip"] == shooter["tip"])
+                    info = _trace_arrow(scene, shooter_scene_arrow)
