+
+
+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    h = int(rng.integers(GEN_SIZE_MIN, GEN_SIZE_MAX + 1))
+    w = int(rng.integers(GEN_SIZE_MIN, GEN_SIZE_MAX + 1))
