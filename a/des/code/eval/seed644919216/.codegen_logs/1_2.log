+        parallel_dirs = ["L", "R"]
+    else:
+        crossing_dirs = ["L", "R"]
+        parallel_dirs = ["U", "D"]
+
+    crossing = _place_with_predicate(
+        grid,
+        reserved,
+        protected,
+        bg,
+        stripe_axis,
+        stripe_set,
+        crossing_dirs,
+        lambda info: info["stop"] == "boundary" and info["crossings"] >= 1 and info["painted"] >= 2,
+        rng,
+    )
+    if crossing is None:
