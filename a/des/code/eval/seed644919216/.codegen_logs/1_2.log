+    stripe_count = int(rng.integers(GEN_STRIPE_COUNT_MIN, GEN_STRIPE_COUNT_MAX + 1))
+    stripe_positions = _sample_line_positions(h if stripe_axis == "horizontal" else w, stripe_count, rng)
+    if stripe_positions is None:
