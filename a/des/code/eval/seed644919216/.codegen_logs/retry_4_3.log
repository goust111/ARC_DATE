+    grid[row, col : col + len(seq)] = seq
+    grid[row + 1, col + int(panel["support_idx"])] = GREY
+
+
+def _expected_output(grid: np.ndarray, safes: list[dict], panels: list[dict]) -> np.ndarray:
+    out = grid.copy()
