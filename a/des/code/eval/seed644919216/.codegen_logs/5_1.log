+def _sample_segments_in_lane(lane_len: int, rng: np.random.Generator) -> list[tuple[int, int]] | None:
+    for _ in range(80):
+        count = int(rng.integers(1, 4))
+        lengths = [int(rng.integers(1, 4)) for _ in range(count)]
+        needed = sum(lengths) + max(0, count - 1)
+        if needed > lane_len:
+            continue
