+
+def _mark_reserved(mask: np.ndarray, cells: set[tuple[int, int]]) -> None:
+    h, w = mask.shape
+    for r, c in cells:
+        for rr in range(max(0, r - 1), min(h, r + 2)):
+            for cc in range(max(0, c - 1), min(w, c + 2)):
+                mask[rr, cc] = True
