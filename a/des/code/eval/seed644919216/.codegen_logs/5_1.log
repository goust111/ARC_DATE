+    movable_cells: list[list[tuple[int, int]]] = []
+    for start, length in segments:
+        cells: list[tuple[int, int]] = []
+        for offset in range(length):
+            if direction == 0:
+                cells.append((anchor[0] + start + offset, anchor[1]))
+            elif direction == 1:
+                cells.append((anchor[0] - start - offset, anchor[1]))
+            elif direction == 2:
