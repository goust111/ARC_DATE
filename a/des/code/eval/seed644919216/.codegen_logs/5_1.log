+    extra_space = int(rng.integers(0, 4))
+    required_space = total_movable_cells + extra_space + (1 if stop_with_wall else 0)
+
+    if direction == 0:
+        r0_low, r0_high = required_space, h - room_h - 1
+        c0_low, c0_high = 1, w - room_w - 1
+    elif direction == 1:
