+GRID_MIN = 18
+GRID_MAX = 30
+ROOM_COUNT_MIN = 1
+ROOM_COUNT_MAX = 3
+MAX_ATTEMPTS = 400
+ROOM_PLACE_ATTEMPTS = 200
