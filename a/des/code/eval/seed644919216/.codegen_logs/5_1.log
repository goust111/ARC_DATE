+        pos = gaps[0]
+        segments: list[tuple[int, int]] = []
+        for i, length in enumerate(lengths):
+            segments.append((pos, length))
+            pos += length + gaps[i + 1]
+        return segments
+    return None
+
+
+def _shape_from_pool(
+    pool: set[tuple[int, int]], size: int, rng: np.random.Generator
+) -> list[tuple[int, int]] | None:
