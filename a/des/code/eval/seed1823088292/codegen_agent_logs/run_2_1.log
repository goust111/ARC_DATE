+
+
+def _render_template(mask: np.ndarray, color_a: int, color_b: int, bg: int) -> np.ndarray:
+    size = mask.shape[0]
+    arr = np.full((size, size), bg, dtype=int)
+    for r in range(size):
+        for c in range(size):
