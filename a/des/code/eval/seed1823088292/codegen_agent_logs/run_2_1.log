+    return sub
+
+
+def _make_panel(
+    rng: random.Random,
+    masks: dict[str, np.ndarray],
+    demo_colors: dict[str, int],
+    border: int,
+    color_a: int,
+    color_b: int,
+    bg: int,
+) -> np.ndarray:
+    entries = [
+        _make_demo_subframe(masks["H"], "H", demo_colors["H"], border, color_a, color_b, bg),
+        _make_demo_subframe(masks["V"], "V", demo_colors["V"], border, color_a, color_b, bg),
