+        if color == bg:
+            continue
+        for coords in _components(grid == color):
+            r0, c0, r1, c1 = _bbox(coords)
+            if r1 - r0 < 2 or c1 - c0 < 2:
+                continue
+            expected = set()
+            for cc in range(c0, c1 + 1):
+                expected.add((r0, cc))
+                expected.add((r1, cc))
+            for rr in range(r0 + 1, r1):
+                expected.add((rr, c0))
+                expected.add((rr, c1))
