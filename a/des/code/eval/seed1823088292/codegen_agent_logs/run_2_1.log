+        density = rng.uniform(0.35, 0.65)
+        mask = np.array(
+            [[rng.random() < density for _ in range(size)] for _ in range(size)],
+            dtype=bool,
+        )
+        if mask.sum() < min_area or mask.sum() > max_area:
+            continue
+        if not mask[0, :].any() or not mask[-1, :].any() or not mask[:, 0].any() or not mask[:, -1].any():
+            continue
