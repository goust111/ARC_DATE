+MAX_GEN_ATTEMPTS = 400
+GRID_H_RANGE = (22, 31)
+GRID_W_RANGE = (24, 35)
+TEMPLATE_SIZE_CHOICES = (3, 4)
+TASK_COUNT_RANGE = (2, 6)
+TASK_INNER_CHOICES = (4, 6, 8, 10)
