+
+
+def _make_demo_subframe(
+    mask: np.ndarray,
+    orientation: str,
+    seed_color: int,
+    border: int,
+    color_a: int,
+    color_b: int,
+    bg: int,
+) -> np.ndarray:
+    size = mask.shape[0]
+    sub = np.full((size + 2, size + 5), bg, dtype=int)
+    sub[0, :] = border
+    sub[-1, :] = border
+    sub[:, 0] = border
+    sub[:, -1] = border
+
+    inner = sub[1:-1, 1:-1]
+    seed_row = (size - 2) // 2
+    if orientation == "H":
+        inner[seed_row, 0] = seed_color
+        inner[seed_row, 1] = seed_color
+    else:
+        inner[seed_row, 0] = seed_color
+        inner[seed_row + 1, 0] = seed_color
