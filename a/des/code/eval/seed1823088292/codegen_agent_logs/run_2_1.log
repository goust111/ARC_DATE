+    r0, c0, r1, c1 = frame["bbox"]
+    th, tw = template.shape
+    for rr in range(r0 + 1, r1):
+        for cc in range(c0 + 1, c1):
+            if (rr, cc) in seed_pts:
+                continue
+            if int(original[rr, cc]) != bg:
+                continue
+            if template[(rr - (r0 + 1)) % th, (cc - (c0 + 1)) % tw]:
