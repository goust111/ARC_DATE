+
+def _sample_sorted(pool: list[int], count: int, min_gap: int) -> list[int] | None:
+    if len(pool) < count:
+        return None
+    for _ in range(60):
+        vals = sorted(random.sample(pool, count))
+        if all(b - a >= min_gap for a, b in zip(vals, vals[1:])):
