+            next_pt = path["points"][idx + 1]
+            if prev_pt in path["turns"] or next_pt in path["turns"]:
+                return False, []
+            if prev_pt in path["endpoints"] or next_pt in path["endpoints"]:
+                return False, []
+        for a, b in zip(indices, indices[1:]):
