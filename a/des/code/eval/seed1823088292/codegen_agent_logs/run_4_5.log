+            if not ok:
+                return False, []
+            if point is None:
+                continue
+            if point in cross_points:
+                return False, []
+            cross_points.add(point)
+            crossings.append((i, j, paths[i]["index"][point]))
+            per_path_indices[i].append(paths[i]["index"][point])
+            per_path_indices[j].append(paths[j]["index"][point])
