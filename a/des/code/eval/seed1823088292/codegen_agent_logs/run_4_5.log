+            return False
+        if (r, c) in path["turns"] or (r, c) in path["endpoints"]:
+            return False
+        orient = _point_orientation(path, (r, c))
+        if orient is None:
+            return False
+        other = int(grid_main[r, c])
+        if orient == "h":
+            if r - 1 < 0 or r + 1 >= h:
