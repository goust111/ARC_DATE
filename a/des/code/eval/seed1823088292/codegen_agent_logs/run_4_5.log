+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+BREAK = 9
+PATH_COLORS = [1, 2, 3, 4, 5, 6, 7, 8]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SHAPES = ("h", "v", "L", "Zh", "Zv")
+GEN_ATTEMPTS = 500
+PATH_ATTEMPTS = 120
