+
+
+def _choose_counts(rng: random.Random, room1: dict, room2: dict, scenario: str) -> tuple[int, int]:
+    max1 = max(1, len(_room_inner_cells(room1)) - 1)
+    max2 = max(1, len(_room_inner_cells(room2)) - 1)
