+def _can_place(cells: set[tuple[int, int]], reserved: set[tuple[int, int]], h: int, w: int) -> bool:
+    if not cells:
+        return False
+    if any(not (0 <= r < h and 0 <= c < w) for r, c in cells):
+        return False
+    expanded = _expand_cells(cells, h, w, pad=1)
+    return expanded.isdisjoint(reserved)
