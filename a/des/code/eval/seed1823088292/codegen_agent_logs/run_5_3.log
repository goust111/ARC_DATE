+def _expand_cells(cells: set[tuple[int, int]], h: int, w: int, pad: int = 1) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for dr in range(-pad, pad + 1):
+            for dc in range(-pad, pad + 1):
+                nr = int(r + dr)
+                nc = int(c + dc)
+                if 0 <= nr < h and 0 <= nc < w:
+                    out.add((nr, nc))
+    return out
