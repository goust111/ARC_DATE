+def _generate_connected_mask(max_h: int, max_w: int, max_area: int) -> np.ndarray | None:
+    if max_h <= 0 or max_w <= 0 or max_area <= 0:
+        return None
+    for _ in range(80):
+        h = random.randint(1, max_h)
+        w = random.randint(1, max_w)
+        area = random.randint(1, min(max_area, h * w))
+        start = (random.randrange(h), random.randrange(w))
+        pts = {start}
+        frontier = {start}
+        while len(pts) < area:
+            cand = []
+            for r, c in frontier:
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in pts:
+                        cand.append((nr, nc))
+            if not cand:
+                break
+            cell = random.choice(cand)
+            pts.add(cell)
+            frontier.add(cell)
+        if len(pts) != area:
+            continue
+        rows = [r for r, _ in pts]
+        cols = [c for _, c in pts]
+        r0, r1 = min(rows), max(rows)
+        c0, c1 = min(cols), max(cols)
+        mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        for r, c in pts:
+            mask[r - r0, c - c0] = True
+        return mask
+    return None
