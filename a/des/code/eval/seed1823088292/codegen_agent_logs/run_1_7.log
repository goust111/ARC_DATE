+    inner_top = frame["r0"] + 1
+    inner_bottom = frame["r1"] - 1
+    inner_left = frame["c0"] + 1
+    inner_right = frame["c1"] - 1
+
+    for r, c in np.argwhere(patch != BG):
+        val = int(patch[r, c])
+        if corner == "TL":
