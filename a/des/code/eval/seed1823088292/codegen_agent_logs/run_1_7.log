+        frame_mask[frame["r0"] : frame["r1"] + 1, frame["c1"]] = True
+        frame_mask[frame["r0"], frame["c0"] : frame["c1"] + 1] = True
+        frame_mask[frame["r1"], frame["c0"] : frame["c1"] + 1] = True
