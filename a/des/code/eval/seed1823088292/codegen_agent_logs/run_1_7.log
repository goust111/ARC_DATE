+
+def _sample_patch(inner_h: int, inner_w: int, marker_kind: str, frame_color: int) -> tuple[np.ndarray, tuple[int, int]] | None:
+    max_area = max(1, (inner_h * inner_w) // 4)
+    max_dim = min(inner_h, inner_w, 4)
+    if max_dim <= 0:
+        return None
+    for _ in range(100):
