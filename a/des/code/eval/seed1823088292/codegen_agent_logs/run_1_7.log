+def _draw_marker(grid: np.ndarray, top: int, left: int, inner_h: int, inner_w: int, marker_kind: str) -> None:
+    cr = top + 1 + (inner_h - 1) // 2
+    cc = left + 1 + (inner_w - 1) // 2
