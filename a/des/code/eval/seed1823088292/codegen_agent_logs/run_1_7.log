+BG = 0
+AZURE = 8
+
+ROT4 = "rot4"
+MIRROR_LR = "mirror_lr"
+MIRROR_UD = "mirror_ud"
+
+CORNER_ORDER = ("TL", "TR", "BR", "BL")
+HORIZONTAL_OPPOSITE = {"TL": "TR", "TR": "TL", "BL": "BR", "BR": "BL"}
+VERTICAL_OPPOSITE = {"TL": "BL", "BL": "TL", "TR": "BR", "BR": "TR"}
