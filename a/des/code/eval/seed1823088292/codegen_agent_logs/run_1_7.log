+            cc = inner_left + gc + int(c)
+        elif corner == "TR":
+            rr = inner_top + gr + int(r)
+            cc = inner_right - gc - int(c)
+        elif corner == "BL":
+            rr = inner_bottom - gr - int(r)
+            cc = inner_left + gc + int(c)
+        else:
+            rr = inner_bottom - gr - int(r)
+            cc = inner_right - gc - int(c)
