+    r0, c0, r1, c1 = _bbox(pts)
+    assert r1 - r0 == 1 and c1 - c0 == 1, "L marker must occupy a 2x2 corner"
+    block = np.zeros((2, 2), dtype=bool)
+    for r, c in pts:
