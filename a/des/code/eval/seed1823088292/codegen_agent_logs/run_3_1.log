+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+PALETTE_H = 4
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+
+ORIENTATION_TO_INDEX = {"ul": 0, "ur": 1, "ll": 2, "lr": 3}
+INDEX_TO_OFFSETS = {
+    0: [(0, 0), (0, 1), (1, 0)],
+    1: [(0, 1), (0, 2), (1, 2)],
+    2: [(1, 0), (2, 0), (2, 1)],
+    3: [(1, 2), (2, 1), (2, 2)],
+}
+
+GEN_RETRIES = 400
+MIN_INNER_H = 3
+MAX_INNER_H = 5
+MIN_INNER_W = 3
+MAX_INNER_W = 6
+MIN_FRAMES = 1
+MAX_FRAMES = 4
+MIN_GRID_H = 14
+MAX_GRID_H = 24
+MAX_GRID_W = 34
+PALETTE_SIDES = ["top", "bottom", "left", "right"]
+
+
+def _neighbors4(r: int, c: int) -> Iterable[tuple[int, int]]:
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(points: Iterable[tuple[int, int]]) -> tuple[int, int, int, int]:
+    pts = list(points)
+    rows = [r for r, _ in pts]
+    cols = [c for _, c in pts]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _frame_mask(h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _find_palette(grid: np.ndarray) -> tuple[tuple[int, int, int, int], np.ndarray]:
+    mask = (grid != BG) & (grid != GREY)
+    h, w = grid.shape
+    candidates: list[tuple[int, tuple[int, int, int, int]]] = []
+    for comp in _components(mask):
+        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in comp):
+            continue
+        r0, c0, r1, c1 = _bbox(comp)
+        if r1 - r0 + 1 != PALETTE_H:
+            continue
+        patch_mask = mask[r0 : r1 + 1, c0 : c1 + 1]
+        if not np.all(patch_mask):
+            continue
+        candidates.append((patch_mask.size, (r0, c0, r1, c1)))
+    assert candidates, "palette not found"
+    _, box = max(candidates, key=lambda item: item[0])
+    r0, c0, r1, c1 = box
+    return box, grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _find_frames(grid: np.ndarray) -> list[tuple[int, int, int, int]]:
+    frames: list[tuple[int, int, int, int]] = []
+    for color in np.unique(grid):
+        color = int(color)
+        if color in (BG, GREY):
