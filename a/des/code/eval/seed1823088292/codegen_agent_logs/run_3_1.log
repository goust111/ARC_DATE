+    pr0, pc0, pr1, pc1 = palette_box
+    out[pr0 : pr1 + 1, pc0 : pc1 + 1] = BG
+    return out
+
+
+def _random_palette_rows(rng: random.Random, width: int) -> np.ndarray:
+    rows: list[np.ndarray] = []
+    seen: set[tuple[int, ...]] = set()
