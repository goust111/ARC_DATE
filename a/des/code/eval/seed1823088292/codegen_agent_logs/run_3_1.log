+    patterns = {
+        ((True, True), (True, False)): 0,
+        ((True, True), (False, True)): 1,
+        ((True, False), (True, True)): 2,
+        ((False, True), (True, True)): 3,
+    }
+    key = tuple(tuple(bool(v) for v in row) for row in block)
+    assert key in patterns, "invalid L marker shape"
+    return patterns[key]
