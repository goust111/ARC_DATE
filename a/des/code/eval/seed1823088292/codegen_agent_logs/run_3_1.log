+def _find_palette(grid: np.ndarray) -> tuple[tuple[int, int, int, int], np.ndarray]:
+    mask = (grid != BG) & (grid != GREY)
+    h, w = grid.shape
+    candidates: list[tuple[int, tuple[int, int, int, int]]] = []
+    for comp in _components(mask):
