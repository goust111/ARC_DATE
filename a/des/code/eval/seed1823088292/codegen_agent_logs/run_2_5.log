+        (spec["color"], spec["row"], spec["col"], spec["arm"]) for spec in specs
+    ):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
