+
+            next_assignment = assignment.copy()
+            next_assignment.update(option)
+            result = search(group_pos + 1, used_positions | set(new_positions), next_assignment)
+            if result is not None:
+                return result
+        return None
+
+    result = search(0, set(), {})
+    if result is None:
+        return None
+    return [result[idx] for idx in range(len(arms))]
