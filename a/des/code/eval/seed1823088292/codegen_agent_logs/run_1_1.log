+    mask = (sub != BLACK) & (sub != GREY)
+    coords = np.argwhere(mask)
+    assert coords.size > 0
+    colors = np.unique(sub[mask])
+    assert colors.size == 1
+    offsets = [(int(r), int(c)) for r, c in coords]
