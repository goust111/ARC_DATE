+            _draw_frame(out, frame["r0"], frame["c0"], frame["h"], frame["w"], legend_colors[frame["depth"] - 1])
+
+    for group in groups:
+        fill_color = int(group["fill_color"])
+        for frame in group["frames"]:
+            for dr, dc in group["fill_offsets"]:
+                rr = frame["r0"] + 1 + dr
+                cc = frame["c0"] + 1 + dc
+                if out[rr, cc] == BLACK:
+                    out[rr, cc] = fill_color
