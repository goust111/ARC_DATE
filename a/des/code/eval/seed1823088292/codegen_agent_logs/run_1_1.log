+        assert len(cells) == 2 * (h + w) - 4
+        cell_set = set(cells)
+        for c in range(c0, c1 + 1):
+            assert (r0, c) in cell_set
+            assert (r1, c) in cell_set
+        for r in range(r0, r1 + 1):
