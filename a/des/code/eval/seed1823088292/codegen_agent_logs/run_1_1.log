+    fill_offsets = [(int(r), int(c)) for r, c in np.argwhere(shape)]
+    leaf_r, leaf_c = positions[0]
+    dr, dc = group["fill_offset"]
+    return {
+        "frames": frames,
+        "fill_color": int(group["fill_color"]),
+        "fill_offsets": fill_offsets,
+        "fill_anchor": (leaf_r + 1 + dr, leaf_c + 1 + dc),
+        "shape": shape,
+    }
+
