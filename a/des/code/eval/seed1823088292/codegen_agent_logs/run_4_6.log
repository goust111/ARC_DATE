+            _RNG.shuffle(cells)
+            for anchor_r, anchor_c in cells:
+                shift_r = socket_r - anchor_r
+                shift_c = socket_c - anchor_c
+                placed = {(r + shift_r, c + shift_c) for r, c in ori}
+                if any(not (0 <= r < h and 0 <= c < w) for r, c in placed):
