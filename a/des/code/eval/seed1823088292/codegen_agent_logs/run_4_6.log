+    prev = None
+    cur = next(iter(touching))
+    segment = []
+    while True:
+        segment.append(cur)
+        forward = [nxt for nxt in _black_neighbors(grid, cur) if nxt != prev]
+        if len(forward) >= 2:
+            return segment
+        if not forward:
+            return segment
+        prev, cur = cur, forward[0]
