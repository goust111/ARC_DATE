from itertools import combinations
DIRS=[(-1,0),(1,0),(0,-1),(0,1)]

def norm(c):
    rs=[r for r,_ in c]; cs=[x for _,x in c]
    mr=min(rs); mc=min(cs)
    return tuple(sorted((r-mr,x-mc) for r,x in c))

def rot(coords):
    pts=list(coords)
    h=max(r for r,_ in pts)+1
    return norm([(c,h-1-r) for r,c in pts])

def rots(coords):
    out=[]; cur=tuple(coords)
    for _ in range(4):
        cur=rot(cur)
        if cur not in out: out.append(cur)
    return out

def canon(coords):
    return min(rots(norm(coords)))

def conn(coords):
    s=set(coords); st=[next(iter(s))]; seen={st[0]}
    while st:
        r,c=st.pop()
        for dr,dc in DIRS:
            q=(r+dr,c+dc)
            if q in s and q not in seen:
                seen.add(q); st.append(q)
    return len(seen)==len(s)

def complementary(a,b):
    ra=rots(norm(a)); rb=rots(norm(b))
    area=len(a)+len(b)
    rects=[]
    for h in range(1,area+1):
        if area%h==0:
            rects.append((h,area//h))
    for A in ra:
        ah=max(r for r,_ in A)+1; aw=max(c for _,c in A)+1
        A=set(A)
        for B in rb:
            bh=max(r for r,_ in B)+1; bw=max(c for _,c in B)+1
            B=set(B)
            for h,w in rects:
                if ah>h or aw>w or bh>h or bw>w: continue
                for ar in range(h-ah+1):
                    for ac in range(w-aw+1):
                        As={(r+ar,c+ac) for r,c in A}
                        for br in range(h-bh+1):
                            for bc in range(w-bw+1):
                                Bs={(r+br,c+bc) for r,c in B}
                                if As & Bs: continue
                                if len(As|Bs)==h*w: return True
    return False

pairs=[]
for h,w in [(2,2),(2,3),(3,2),(2,4),(4,2)]:
    cells=[(r,c) for r in range(h) for c in range(w)]
    for k in range(2,5):
        if not (2<=h*w-k<=4): continue
        for comb in combinations(cells,k):
            s=tuple(sorted(comb)); comp=tuple(sorted(set(cells)-set(comb)))
            if conn(s) and conn(comp):
                ca,cb=canon(s),canon(comp)
                pairs.append((ca,cb,h,w))
uniq=[]
seen=set()
for a,b,h,w in pairs:
    key=(a,b)
    if key not in seen:
        seen.add(key); uniq.append((a,b,h,w))
print('uniq',len(uniq))
# greedily find max set with no cross-compatibility
best=[]
items=uniq
# sort by total area maybe variety
for start in range(len(items)):
    chosen=[]
    for item in items[start:]+items[:start]:
        a,b,_,_=item
        ok=True
        for aa,bb,_,_ in chosen:
            if complementary(a,bb) or complementary(aa,b):
                ok=False; break
        if ok:
            chosen.append(item)
    if len(chosen)>len(best): best=chosen
print('best',len(best))
for a,b,h,w in best[:20]:
    print((h,w),a,b)
