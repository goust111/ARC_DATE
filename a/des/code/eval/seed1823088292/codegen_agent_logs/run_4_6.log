+            cur_r, cur_c = path[-1]
+            options = []
+            for dr, dc in DIRS4:
+                nr, nc = cur_r + dr, cur_c + dc
+                if not (margin <= nr < cell_h - margin and margin <= nc < cell_w - margin):
+                    continue
