+
+def _find_sprites(
+    grid: np.ndarray,
+    bg: int,
+    legend_mask: np.ndarray,
+    frame_mask: np.ndarray,
+) -> list[dict]:
+    active = (grid != bg) & (grid != GREY) & (~legend_mask) & (~frame_mask)
+    sprites = []
+    for comp in _color_components(grid, active):
+        mask, r0, c0 = _tight_mask(comp["coords"])
+        sprites.append(
+            {
+                "color": int(comp["color"]),
+                "coords": comp["coords"],
+                "mask": mask,
+                "top": r0,
+                "left": c0,
