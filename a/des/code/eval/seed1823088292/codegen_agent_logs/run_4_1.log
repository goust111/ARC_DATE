+    h = rng.randint(base_side, base_side + 10)
+    w = rng.randint(base_side, base_side + 10)
+    grid = np.full((h, w), BG, dtype=int)
+    blocked = np.zeros((h, w), dtype=bool)
+    _reserve_legend(blocked, legend_corner, frame_count)
