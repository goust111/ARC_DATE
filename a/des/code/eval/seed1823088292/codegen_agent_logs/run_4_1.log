+    legend_map, legend_mask = _detect_legend(g, bg)
+    frames, frame_mask = _find_frames(g, bg, legend_mask)
+    seeds = [_extract_seed_for_frame(g, frame) for frame in frames]
+    sprites = _find_sprites(g, bg, legend_mask, frame_mask)
