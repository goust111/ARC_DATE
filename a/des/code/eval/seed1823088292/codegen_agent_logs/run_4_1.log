+    positions = []
+    for bh, bw in sizes:
+        placed = None
+        for _ in range(250):
+            r = rng.randint(margin_from_edge, h - bh - margin_from_edge)
+            c = rng.randint(margin_from_edge, w - bw - margin_from_edge)
+            if not _box_free(blocked, r, c, bh, bw):
+                continue
+            placed = (r, c)
+            _mark_box(blocked, r, c, bh, bw)
