+        mapping: dict[int, int] = {}
+        ok = True
+        for cc in cols:
+            key = int(grid[r0, cc])
+            val = int(grid[r1, cc])
+            if key in mapping and mapping[key] != val:
+                ok = False
+                break
+            mapping[key] = val
+        if not ok or len(mapping) != len(cols):
+            continue
+        mask = np.zeros_like(grid, dtype=bool)
+        mask[r0, cols] = True
+        mask[r1, cols] = True
+        candidates.append((len(cols), mapping, mask))
