+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+
+GRID_H_RANGE = (14, 22)
+GRID_W_RANGE = (14, 22)
+WALL_COUNT_CHOICES = (2, 3, 4)
+WALL_LEN_CHOICES = (4, 6, 8)
+SOURCE_COUNT_MAX = 4
+MIN_RAY_PIXELS = 4
+GEN_RETRIES = 400
