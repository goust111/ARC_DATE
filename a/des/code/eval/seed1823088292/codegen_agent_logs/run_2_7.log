+        elif len(cols) == 1:
+            c = int(cols[0])
+            r0 = min(r for r, _ in cells)
+            r1 = max(r for r, _ in cells)
+            expected = {(r, c) for r in range(r0, r1 + 1)}
+            assert set(cells) == expected, "grey wall must be a solid vertical segment"
+            walls.append(
