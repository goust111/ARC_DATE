+    if r == h - 1:
+        dirs.append(UP)
+    if c == 0:
+        dirs.append(RIGHT)
+    if c == w - 1:
+        dirs.append(LEFT)
+    if len(dirs) != 1:
+        return None
+    return dirs[0]
