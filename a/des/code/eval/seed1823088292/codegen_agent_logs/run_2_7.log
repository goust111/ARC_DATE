+    scene, walls, wall_index, sources = _parse_scene(grid)
+    out = scene.copy()
+    painted: set[tuple[int, int]] = set()
+
+    for source in sources:
+        traced = _trace_ray(
+            scene,
+            walls,
+            wall_index,
+            source["pos"],
+            source["dir"],
+            source["color"],
+            painted,
+            set(),
+        )
+        for r, c, color in traced["pixels"]:
+            out[r, c] = int(color)
+        painted |= traced["positions"]
