+    for _ in range(h * w * 8):
+        nr = r + dr
+        nc = c + dc
+        if not (0 <= nr < h and 0 <= nc < w):
+            break
+        if (nr, nc) in extra_blocked or (nr, nc) in painted or (nr, nc) in local_positions:
