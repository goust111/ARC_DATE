+        touched_walls: list[int] = []
+        for idx, wall in enumerate(walls):
+            adjacent = False
+            for er, ec in wall["endpoints"]:
+                for r, c in comp:
+                    if abs(er - r) + abs(ec - c) == 1:
+                        adjacent = True
