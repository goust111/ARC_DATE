+            if random.random() < 0.5:
+                label_cells = [(wall["r0"] - 2, wall["c0"]), (wall["r0"] - 1, wall["c0"])]
+            else:
+                label_cells = [(wall["r1"] + 1, wall["c0"]), (wall["r1"] + 2, wall["c0"])]
+        else:
+            if random.random() < 0.5:
+                label_cells = [(wall["r0"], wall["c0"] - 2), (wall["r0"], wall["c0"] - 1)]
