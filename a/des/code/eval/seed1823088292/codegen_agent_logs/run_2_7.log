+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+
+GRID_H_RANGE = (14, 22)
+GRID_W_RANGE = (14, 22)
+WALL_COUNT_CHOICES = (2, 3, 4)
+WALL_LEN_CHOICES = (4, 6, 8)
+SOURCE_COUNT_MAX = 4
+MIN_RAY_PIXELS = 4
+GEN_RETRIES = 400
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((int(cr), int(cc)))
+                for dr, dc in (UP, DOWN, LEFT, RIGHT):
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(cells)
+    return comps
+
+
+def _on_edge(r: int, c: int, h: int, w: int) -> bool:
+    return r == 0 or r == h - 1 or c == 0 or c == w - 1
+
+
+def _edge_direction(r: int, c: int, h: int, w: int) -> tuple[int, int] | None:
+    dirs: list[tuple[int, int]] = []
+    if r == 0:
+        dirs.append(DOWN)
+    if r == h - 1:
+        dirs.append(UP)
+    if c == 0:
+        dirs.append(RIGHT)
+    if c == w - 1:
+        dirs.append(LEFT)
+    if len(dirs) != 1:
+        return None
+    return dirs[0]
+
+
