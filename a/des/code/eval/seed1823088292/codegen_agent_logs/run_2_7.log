+def _reflect_direction(wall: dict, hit_r: int, hit_c: int, direction: tuple[int, int]) -> tuple[int, int] | None:
+    dr, dc = direction
+    if wall["orientation"] == "v":
+        if dc == 0:
+            return None
+        dist_top = hit_r - wall["r0"]
+        dist_bottom = wall["r1"] - hit_r
+        if dist_top == dist_bottom:
+            return None
