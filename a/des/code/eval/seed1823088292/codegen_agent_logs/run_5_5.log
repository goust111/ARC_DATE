+    inner_h = h - t - b
+    inner_w = w - l - r
+    if inner_h < 2 or inner_w < 2:
+        return False
+    if t + b + l + r == 0:
+        return False
+
+    visible = np.ones((h, w), dtype=bool)
+    visible[t : t + inner_h, l : l + inner_w] = False
+    return bool(
+        visible[0, :].any()
+        and visible[-1, :].any()
+        and visible[:, 0].any()
+        and visible[:, -1].any()
