+
+    colors = random.sample(FRAGMENT_COLORS, 2 * n_pairs)
+    pairs: list[dict] = []
+    fragments: list[dict] = []
+
+    for i, (h, w) in enumerate(dims):
+        host_color = colors[2 * i]
