+
+        host_patch = np.full((h, w), BLACK, dtype=int)
+        host_patch[host_mask] = host_color
+        piece_patch = np.full(piece_mask.shape, BLACK, dtype=int)
+        piece_patch[piece_mask] = piece_color
+
