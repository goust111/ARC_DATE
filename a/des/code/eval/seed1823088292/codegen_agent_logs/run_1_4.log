   345	def _make_hollow_sprite(h, w, rng):
   346	    """Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX."""
   347	    sprite = np.ones((h, w), dtype=bool)
   348	    if h >= 3 and w >= 3:
   349	        sprite[1:-1, 1:-1] = False
   350	    # Optionally add internal horizontal wall
   351	    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:
   352	        br = rng.randint(2, h - 2)
   353	        n = rng.randint(1, w - 2)
   354	        s = rng.randint(1, w - 1 - n + 1)
   355	        sprite[br, s:s + n] = True
   356	    # Optionally add internal vertical wall
   357	    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:
   358	        bc = rng.randint(2, w - 2)
   359	        n = rng.randint(1, h - 2)
   360	        s = rng.randint(1, h - 1 - n + 1)
   361	        sprite[s:s + n, bc] = True
   362	    # Optionally remove border cells for irregularity
   363	    if rng.random() < _P_BORDER_REMOVAL:
   364	        bcells = [(r, c) for r in range(h) for c in range(w)
   365	                  if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]
   366	        rng.shuffle(bcells)
   367	        for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:
   368	            test = sprite.copy()
   369	            test[cr, cc] = False
   370	            if _get_enclosed_holes(test):
   371	                sprite = test
   372	    if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:
   373	        return None
   374	    return sprite
