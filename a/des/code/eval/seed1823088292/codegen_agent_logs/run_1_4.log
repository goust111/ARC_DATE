+
+
+def _container_mask(height: int, width: int, opening: str, pattern: str) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    path = _border_path(height, width, opening)
+    if pattern == "continuous":
+        chosen = path
+    else:
+        chosen = path[::2]
+    for r, c in chosen:
+        mask[r, c] = True
