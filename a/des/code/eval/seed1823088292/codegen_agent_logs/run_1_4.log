+    elif opening == "down":
+        for r in range(r1 + 1, r1 + corridor_depth + 1):
+            for c in range(c0 + 1, c1):
+                cells.append((r, c))
+    elif opening == "left":
+        for r in range(r0 + 1, r1):
+            for c in range(c0 - corridor_depth, c0):
+                cells.append((r, c))
+    else:
