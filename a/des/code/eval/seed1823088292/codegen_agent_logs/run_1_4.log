+
+def _solve(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    for container in _find_containers(g):
+        opening = container["opening"]
+        pattern = container["pattern"]
+        bbox = container["bbox"]
