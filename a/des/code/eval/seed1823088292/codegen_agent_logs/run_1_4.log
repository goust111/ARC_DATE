+def _fill_slots(bbox: tuple[int, int, int, int], opening: str, pattern: str) -> list[tuple[int, int]]:
+    cells = _interior_fill_order(bbox, opening)
+    if pattern == "continuous":
+        return cells
+    return [(r, c) for r, c in cells if (r + c) % 2 == 0]
