+        return top + right + bottom
+    if opening == "right":
+        top = [(0, c) for c in range(width - 1, -1, -1)]
+        left = [(r, 0) for r in range(1, height)]
+        bottom = [(height - 1, c) for c in range(1, width)]
+        return top + left + bottom
