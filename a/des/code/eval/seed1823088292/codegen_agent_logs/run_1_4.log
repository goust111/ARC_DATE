+def _interior_fill_order(bbox: tuple[int, int, int, int], opening: str) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    cells: list[tuple[int, int]] = []
+    if opening == "up":
+        for r in range(r1 - 1, r0, -1):
+            for c in range(c0 + 1, c1):
+                cells.append((r, c))
+    elif opening == "down":
+        for r in range(r0 + 1, r1):
+            for c in range(c0 + 1, c1):
+                cells.append((r, c))
+    elif opening == "left":
+        for c in range(c1 - 1, c0, -1):
+            for r in range(r0 + 1, r1):
+                cells.append((r, c))
+    else:
