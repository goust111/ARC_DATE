+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+MAROON = 9
+PORTAL_COLOR_POOL = [1, 2, 3, 5, 6, 7, 8]
+
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+DIRS = (UP, DOWN, LEFT, RIGHT)
+PERPENDICULARS = {
+    UP: (LEFT, RIGHT),
+    DOWN: (LEFT, RIGHT),
+    LEFT: (UP, DOWN),
+    RIGHT: (UP, DOWN),
+}
+
+MIN_PORTAL_PAIRS = 2
+MAX_PORTAL_PAIRS = 4
+MAX_USED_PORTALS = 3
+MIN_HEIGHT = 10
+MAX_HEIGHT = 18
+MIN_FINAL_GAP = 3
+MAX_FINAL_GAP = 5
+MAX_GENERATION_ATTEMPTS = 400
