+        while queue:
+            r, c = queue.popleft()
+            comp.append((int(r), int(c)))
+            for rr, cc in _neighbors4(int(r), int(c)):
+                if _in_bounds((h, w), int(rr), int(cc)) and not seen[rr, cc] and int(g[rr, cc]) == int(color):
