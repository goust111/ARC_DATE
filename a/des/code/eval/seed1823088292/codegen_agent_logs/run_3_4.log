+    assert direction == UP
+    assert hit_r == r0 + 1
+    offset = hit_c - c0
+    assert offset in (0, 1)
+    return int(pr0), int(pc0 + offset)
+
+
+def _simulate(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
