+    hole_view = patch[row_offset : row_offset + hole_h, col_offset : col_offset + hole_w]
+    hole_view[shape_mask] = _BG
+    patch[row_offset : row_offset + hole_h, col_offset : col_offset + hole_w] = hole_view
