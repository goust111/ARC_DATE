+                row
+                for row in range(0, max(0, height // 2 - 1))
+                if row + 2 < start
+            ]
+        if prism_rows is None or not arrow_candidates:
+            continue
+        return start, prism_rows, random.choice(arrow_candidates)
+    return None
+
+
+def _gen_attempt() -> np.ndarray | None:
