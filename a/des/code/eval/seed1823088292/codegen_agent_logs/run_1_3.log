+    out = g.copy()
+    for pair in pairs:
+        br, bc = pair["block"]
+        out[br : br + 2, bc : bc + 2] = BLACK
+
+    for pair in pairs:
+        color = int(pair["color"])
+        direction = pair["direction"]
+        dr, dc = DIRS[direction]
+        r, c = pair["block"]
+        trail_color = color
+
+        while True:
+            nr, nc = r + dr, c + dc
+            next_cells = _block_cells(nr, nc)
+            if not _cells_in_bounds(g.shape, next_cells):
