+                "fence_color": int(fence_color),
+                "pattern": pattern,
+                "fence_patch": fence_patch,
+                "envelope_patch": envelope_patch,
+            }
+        )
+
+    H = int(rng.integers(*GRID_H_RANGE))
+    W = int(rng.integers(*GRID_W_RANGE))
