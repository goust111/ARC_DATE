+            spots.append((r0, c0))
+    if not spots:
+        return None
+    return spots[int(rng.integers(0, len(spots)))]
+
+
+def _place_rect(occupied: np.ndarray, r0: int, c0: int, h: int, w: int) -> None:
+    occupied[r0 : r0 + h, c0 : c0 + w] = True
+
