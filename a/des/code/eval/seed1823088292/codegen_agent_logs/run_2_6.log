+
+
+def _make_pattern(rng: np.random.Generator, color_pool: list[int]) -> np.ndarray:
+    h = int(rng.integers(*PATTERN_DIM_RANGE))
+    w = int(rng.integers(*PATTERN_DIM_RANGE))
