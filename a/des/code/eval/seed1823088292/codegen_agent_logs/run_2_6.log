+    return ph + slack_h, pw + slack_w
+
+
+def _find_slot(
+    rng: np.random.Generator, occupied: np.ndarray, h: int, w: int
+) -> tuple[int, int] | None:
+    H, W = occupied.shape
+    spots: list[tuple[int, int]] = []
+    for r0 in range(1, H - h):
