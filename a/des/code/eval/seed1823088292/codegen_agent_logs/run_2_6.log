PATTERN_DIM_RANGE = (2, 6)
PATTERN_COLOR_COUNT_RANGE = (2, 4)
PADDING = 1
GEN_ATTEMPTS = 300


def _grow_mask(rng: np.random.Generator, h: int, w: int, area: int) -> np.ndarray:
    start = (int(rng.integers(0, h)), int(rng.integers(0, w)))
    cells = {start}
