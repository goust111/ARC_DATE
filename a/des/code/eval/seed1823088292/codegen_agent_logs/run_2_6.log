+        if ph > inner_h or pw > inner_w:
+            raise ValueError("pattern does not fit inside matching fence")
+        dst_r = r0 + 1 + (inner_h - ph) // 2
+        dst_c = c0 + 1 + (inner_w - pw) // 2
