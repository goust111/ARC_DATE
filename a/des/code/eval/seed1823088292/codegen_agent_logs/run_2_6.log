+    occupied = np.zeros((H, W), dtype=bool)
+    occupied[[0, -1], :] = True
+    occupied[:, [0, -1]] = True
+
+    objects: list[dict] = []
+    for idx, pair in enumerate(pairs):
+        objects.append({"kind": "fence", "pair": idx, "patch": pair["fence_patch"]})
+        objects.append({"kind": "envelope", "pair": idx, "patch": pair["envelope_patch"]})
+    rng.shuffle(objects)
