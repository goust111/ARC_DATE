+    ph, pw = map(int, pattern.shape)
+    patch = np.full((ph + 4, pw + 4), BG, dtype=int)
+    patch[0, :] = MAROON
+    patch[-1, :] = MAROON
+    patch[:, 0] = MAROON
+    patch[:, -1] = MAROON
