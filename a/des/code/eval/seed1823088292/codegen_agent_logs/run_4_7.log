+def _find_clocks(grid: np.ndarray) -> list[dict[str, int]]:
+    h, w = grid.shape
+    clocks: list[dict[str, int]] = []
+    for r in range(h - 2):
+        for c in range(w - 2):
+            info = _clock_info(grid[r : r + 3, c : c + 3])
+            if info is None:
