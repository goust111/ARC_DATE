+    color_counts = Counter(int(v) for v in patch.flat if int(v) != bg)
+    corners = {
+        "tl": (0, 0),
+        "tr": (0, w - 1),
+        "bl": (h - 1, 0),
+        "br": (h - 1, w - 1),
+    }
+    out = []
+    for name, (rr, cc) in corners.items():
+        value = int(patch[rr, cc])
+        if value != bg and value in frame_colors:
+            out.append((color_counts[value], name, value, rr, cc))
+    return sorted(out)
+
+
