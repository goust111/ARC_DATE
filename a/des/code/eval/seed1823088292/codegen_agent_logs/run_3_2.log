+
+def _place_piece_in_frame(out: np.ndarray, frame: dict, patch: np.ndarray, corner: str, bg: int) -> None:
+    r0, c0, r1, c1 = frame["bbox"]
+    ir0, ic0 = r0 + 1, c0 + 1
+    ir1, ic1 = r1 - 1, c1 - 1
