+def _make_piece_mask(height: int, width: int, corner: str, rng: random.Random) -> np.ndarray:
+    mask = np.ones((height, width), dtype=bool)
+
+    anchor = {
+        "tl": (0, 0),
+        "tr": (0, width - 1),
+        "bl": (height - 1, 0),
+        "br": (height - 1, width - 1),
+    }[corner]
+    protected = {anchor}
