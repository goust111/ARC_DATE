+
+
+def _required_subset_has_all_sides(corners: tuple[str, ...]) -> bool:
+    return (
+        any(c in corners for c in ("tl", "tr"))
+        and any(c in corners for c in ("bl", "br"))
+        and any(c in corners for c in ("tl", "bl"))
+        and any(c in corners for c in ("tr", "br"))
