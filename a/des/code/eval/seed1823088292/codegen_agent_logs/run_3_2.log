+    h, w = patch.shape
+    gh, gw = grid.shape
+    if h > gh or w > gw:
+        return None
+    positions = [(top, left) for top in range(gh - h + 1) for left in range(gw - w + 1)]
+    rng.shuffle(positions)
+    for top, left in positions:
+        r0 = max(0, top - pad)
+        c0 = max(0, left - pad)
+        r1 = min(gh, top + h + pad)
+        c1 = min(gw, left + w + pad)
