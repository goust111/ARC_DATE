+    top = ir0 if corner[0] == "t" else ir1 - h + 1
+    left = ic0 if corner[1] == "l" else ic1 - w + 1
+    assert ir0 <= top <= ir1 - h + 1
+    assert ic0 <= left <= ic1 - w + 1
+    mask = patch != bg
+    out[top : top + h, left : left + w][mask] = patch[mask]
