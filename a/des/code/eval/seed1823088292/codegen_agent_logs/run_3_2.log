+import math
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+GEN_RETRIES = 400
+CONTAINER_COUNT_CHOICES = (2, 3)
+INTERIOR_SIDE_MIN = 4
+INTERIOR_SIDE_MAX = 9
+PIECE_SIDE_MAX = 5
+PADDING = 1
+FRAME_COLOR_POOL = tuple(range(1, 10))
