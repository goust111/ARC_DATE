+    ("tl", "br"),
+    ("tr", "bl"),
+    ("tl", "tr", "bl"),
+    ("tl", "tr", "br"),
+    ("tl", "bl", "br"),
+    ("tr", "bl", "br"),
+    ("tl", "tr", "bl", "br"),
