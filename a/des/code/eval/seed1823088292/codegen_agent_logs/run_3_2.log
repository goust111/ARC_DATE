+    frame_mask = np.zeros_like(g, dtype=bool)
+    for frame in frames:
+        r0, c0, r1, c1 = frame["bbox"]
+        frame_mask[r0 : r1 + 1, c0] = True
+        frame_mask[r0 : r1 + 1, c1] = True
+        frame_mask[r0, c0 : c1 + 1] = True
+        frame_mask[r1, c0 : c1 + 1] = True
