+
+def _corner_limits(height: int, width: int, split_r: int, split_c: int) -> dict[str, tuple[int, int]]:
+    return {
+        "tl": (split_r, split_c),
+        "tr": (split_r, width - split_c),
+        "bl": (height - split_r, split_c),
+        "br": (height - split_r, width - split_c),
+    }
