+    for frame_color in frame_colors:
+        inner_h = rng.randint(INTERIOR_SIDE_MIN, INTERIOR_SIDE_MAX)
+        inner_w = rng.randint(INTERIOR_SIDE_MIN, INTERIOR_SIDE_MAX)
