+                continue
+            if len(pts) != 2 * (h + w) - 4:
+                continue
+            pset = {tuple(map(int, pt)) for pt in pts}
+            ok = True
+            for rr in range(r0, r1 + 1):
+                for cc in range(c0, c1 + 1):
