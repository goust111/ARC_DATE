+    if corner == "tl":
+        if width > 1:
+            protected.add((0, 1))
+        elif height > 1:
+            protected.add((1, 0))
+        protected.add((height - 1, rng.randrange(width)))
+        protected.add((rng.randrange(height), width - 1))
+    elif corner == "tr":
+        if width > 1:
+            protected.add((0, width - 2))
+        elif height > 1:
+            protected.add((1, width - 1))
+        protected.add((height - 1, rng.randrange(width)))
+        protected.add((rng.randrange(height), 0))
+    elif corner == "bl":
+        if width > 1:
+            protected.add((height - 1, 1))
