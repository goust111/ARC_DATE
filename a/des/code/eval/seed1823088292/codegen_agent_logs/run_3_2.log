+    return None
+
+
+def _paint_expected(
+    input_grid: np.ndarray, placed_containers: list[dict], placed_pieces: list[dict]
+) -> np.ndarray:
+    out = input_grid.copy()
+    for spec in placed_pieces:
+        top = spec["top"]
+        left = spec["left"]
+        patch = spec["patch"]
+        mask = patch != BG
