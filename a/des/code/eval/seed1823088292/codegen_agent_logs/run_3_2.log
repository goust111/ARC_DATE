+import math
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+GEN_RETRIES = 400
+CONTAINER_COUNT_CHOICES = (2, 3)
+INTERIOR_SIDE_MIN = 4
+INTERIOR_SIDE_MAX = 9
+PIECE_SIDE_MAX = 5
+PADDING = 1
+FRAME_COLOR_POOL = tuple(range(1, 10))
+CORNERS = ("tl", "tr", "bl", "br")
+VALID_CORNER_SETS = (
+    ("tl", "br"),
+    ("tr", "bl"),
+    ("tl", "tr", "bl"),
+    ("tl", "tr", "br"),
+    ("tl", "bl", "br"),
+    ("tr", "bl", "br"),
+    ("tl", "tr", "bl", "br"),
+)
+RNG = random.Random()
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def is_connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if len(pts) == 0:
+        return False
+    seen = np.zeros_like(mask, dtype=bool)
+    q = deque([tuple(map(int, pts[0]))])
+    seen[q[0]] = True
+    count = 0
+    while q:
+        r, c = q.popleft()
+        count += 1
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
+    return count == int(mask.sum())
+
+
+def _find_frames(grid: np.ndarray, bg: int) -> list[dict]:
+    frames = []
+    for color in np.unique(grid):
+        color = int(color)
+        if color == bg:
+            continue
+        for pts in components_mask(grid == color):
+            r0, c0, r1, c1 = bbox_coords(pts)
+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            if h < 3 or w < 3:
+                continue
+            if len(pts) != 2 * (h + w) - 4:
+                continue
+            pset = {tuple(map(int, pt)) for pt in pts}
+            ok = True
+            for rr in range(r0, r1 + 1):
+                for cc in range(c0, c1 + 1):
+                    on_perim = rr in (r0, r1) or cc in (c0, c1)
+                    if ((rr, cc) in pset) != on_perim:
+                        ok = False
+                        break
+                if not ok:
+                    break
+            if not ok:
+                continue
+            if not np.all(grid[r0 + 1 : r1, c0 + 1 : c1] == bg):
+                continue
+            frames.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                }
+            )
+    return frames
+
+
+def _component_patch(grid: np.ndarray, coords: np.ndarray, bg: int) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = bbox_coords(coords)
+    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+    for r, c in coords:
+        patch[int(r) - r0, int(c) - c0] = int(grid[int(r), int(c)])
+    return patch, (r0, c0, r1, c1)
+
+
+def _anchor_candidates(
+    patch: np.ndarray, frame_colors: set[int], bg: int
+) -> list[tuple[int, str, int, int, int]]:
+    h, w = patch.shape
+    color_counts = Counter(int(v) for v in patch.flat if int(v) != bg)
+    corners = {
+        "tl": (0, 0),
+        "tr": (0, w - 1),
+        "bl": (h - 1, 0),
+        "br": (h - 1, w - 1),
+    }
+    out = {}
+    for name, (rr, cc) in corners.items():
+        value = int(patch[rr, cc])
+        if value != bg and value in frame_colors:
+            out[(rr, cc)] = (color_counts[value], name, value, rr, cc)
+    return sorted(out.values())
