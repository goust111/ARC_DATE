+    return patch
+
+
+def _make_frame_patch(height: int, width: int, color: int) -> np.ndarray:
+    patch = np.full((height + 2, width + 2), BG, dtype=int)
+    patch[0, :] = color
+    patch[-1, :] = color
+    patch[:, 0] = color
+    patch[:, -1] = color
+    return patch
+
+
+def _try_place_patch(
+    grid: np.ndarray,
+    reserved: np.ndarray,
+    patch: np.ndarray,
