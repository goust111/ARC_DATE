+
+BLACK = 0
+WALL = 5
+SEED_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+SIDES = ("N", "E", "S", "W")
+ORIENT_SIDES = {"H": ("W", "E"), "V": ("N", "S")}
+
+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (18, 30)
