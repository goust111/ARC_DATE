+def _edge_midpoints(r0: int, c0: int, r1: int, c1: int) -> dict[str, tuple[int, int]]:
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    mid_r = r0 + (height - 1) // 2
+    mid_c = c0 + (width - 1) // 2
