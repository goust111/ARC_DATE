+        midpoints = _edge_midpoints(r0, c0, r1, c1)
+        matching = [name for name, point in midpoints.items() if point == marker]
+        assert len(matching) == 1, f"marker must sit on a unique bbox midpoint edge, got {marker} in {midpoints}"
