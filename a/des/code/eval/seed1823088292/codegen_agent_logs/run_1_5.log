+def _overlap_pair_directions() -> tuple[str, str]:
+    return random.choice(
+        [
+            ("right", "down"),
+            ("right", "up"),
+            ("left", "down"),
+            ("left", "up"),
+            ("down", "right"),
+            ("down", "left"),
+            ("up", "right"),
+            ("up", "left"),
