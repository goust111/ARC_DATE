+    keep: set[int] = set()
+    overlap_cells: set[tuple[int, int]] = set()
+    for cell, ids in owners.items():
+        if len(ids) >= 2:
+            keep.update(ids)
+            overlap_cells.add(cell)
+    return keep, overlap_cells, shadow_sets
