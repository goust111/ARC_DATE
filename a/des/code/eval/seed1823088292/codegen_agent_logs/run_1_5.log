+    direction = shape["direction"]
+    area = shape["area"]
+    if direction == "up":
+        return r0 - area >= 0
+    if direction == "down":
+        return r0 + shape["height"] + area <= height
+    if direction == "left":
+        return c0 - area >= 0
+    if direction == "right":
+        return c0 + shape["width"] + area <= width
+    return False
