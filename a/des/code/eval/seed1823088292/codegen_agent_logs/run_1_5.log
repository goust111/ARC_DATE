+    keep, overlap_cells, shadow_sets = _shadow_overlap_data(g, objects)
+
+    out = np.full_like(g, BLACK)
+    for idx, obj in enumerate(objects):
+        if idx not in keep:
+            continue
+        for r, c in obj["coords"]:
