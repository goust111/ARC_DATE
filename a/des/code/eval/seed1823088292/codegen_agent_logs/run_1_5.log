+BLACK = 0
+RED = 2
+GREY = 5
+OBJECT_COLORS = (1, 3, 4, 6, 7, 8, 9)
+DIRECTIONS = ("up", "down", "left", "right")
+SCENARIOS = ("overlap", "isolated", "mixed")
+MAX_GENERATION_ATTEMPTS = 400
