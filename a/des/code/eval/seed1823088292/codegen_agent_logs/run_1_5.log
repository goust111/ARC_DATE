+
+        objects.append(
+            {
+                "coords": sorted(coords),
+                "bbox": (r0, c0, r1, c1),
+                "area": len(coords),
+                "base_color": base_color,
+                "marker_color": marker_color,
+                "marker": marker,
+                "direction": direction,
+            }
+        )
