+    entries: list[tuple[int, int, int]] = []
+    c = 0
+    while c < width:
+        if c + ENTRY_WIDTH > width:
+            return None
+        entry = _parse_legend_entry(strip[:, c : c + ENTRY_WIDTH], bg)
+        if entry is None:
+            return None
+        entries.append(entry)
+        c += ENTRY_WIDTH
+        if c == width:
+            break
+        if c >= width or not np.all(strip[:, c] == bg):
+            return None
+        c += ENTRY_GAP
