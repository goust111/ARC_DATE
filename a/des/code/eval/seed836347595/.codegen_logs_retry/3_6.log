+CYAN = 8
+MAROON = 9
+
+PIPE_COLORS = (RED, BLUE, YELLOW, GREEN)
+MIX_TABLE = {
+    frozenset((RED, BLUE)): MAGENTA,
+    frozenset((RED, YELLOW)): ORANGE,
+    frozenset((BLUE, YELLOW)): GREEN,
+    frozenset((RED, GREEN)): MAROON,
+    frozenset((BLUE, GREEN)): CYAN,
+    frozenset((YELLOW, GREEN)): GREEN,
+}
