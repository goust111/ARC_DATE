+        ("top", "right", g[:LEGEND_HEIGHT, ::-1]),
+        ("bottom", "left", g[h - LEGEND_HEIGHT :, :]),
+        ("bottom", "right", g[h - LEGEND_HEIGHT :, ::-1]),
