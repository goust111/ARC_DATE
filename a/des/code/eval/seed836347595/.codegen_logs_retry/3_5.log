+            touches_side = (
+                (mr == r0 - 1 and c0 <= mc <= c1)
+                or (mr == r1 + 1 and c0 <= mc <= c1)
+                or (mc == c0 - 1 and r0 <= mr <= r1)
+                or (mc == c1 + 1 and r0 <= mr <= r1)
