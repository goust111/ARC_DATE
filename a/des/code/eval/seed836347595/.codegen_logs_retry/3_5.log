+
+
+def _points_to_mask(points: set[tuple[int, int]], shape: tuple[int, int]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for r, c in points:
+        mask[r, c] = True
+    return mask
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    total = int(mask.sum())
+    if total == 0:
+        return False
+    return len(_components(mask)) == 1
