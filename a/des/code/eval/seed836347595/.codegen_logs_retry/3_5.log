+    assert box is not None
+    r0, c0, r1, c1 = box
+    out = np.full((r1 - r0 + 1, c1 - c0 + 1), BLACK, dtype=int)
+    out[mask[r0 : r1 + 1, c0 : c1 + 1]] = int(color)
+    return out
+
