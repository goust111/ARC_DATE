+    path = [hit]
+    cur = hit
+    while cur != start:
+        cur = parent[cur]
+        assert cur is not None
+        path.append(cur)
+    path.reverse()
+    return path
+
+
+def _grow_connected_set(
+    domain: np.ndarray,
+    required: list[tuple[int, int]],
+    target_size: int,
+    rng: random.Random,
+) -> set[tuple[int, int]] | None:
+    cells: set[tuple[int, int]] = {required[0]}
+    for point in required[1:]:
+        if point in cells:
+            continue
+        path = _path_to_set(domain, point, cells)
+        if path is None:
+            return None
+        cells.update(path)
+
+    target = max(target_size, len(cells))
+    available = int(domain.sum())
+    target = min(target, available)
+
+    while len(cells) < target:
+        frontier = {
+            nbr
+            for r, c in cells
+            for nbr in _neighbors_in_domain(domain, r, c)
+            if nbr not in cells
