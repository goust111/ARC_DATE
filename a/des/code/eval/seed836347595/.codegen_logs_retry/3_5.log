+    q = deque([start])
+    parent = {start: None}
+    hit: tuple[int, int] | None = None
+    while q and hit is None:
+        r, c = q.popleft()
+        for nxt in _neighbors_in_domain(domain, r, c):
+            if nxt in parent:
+                continue
+            parent[nxt] = (r, c)
+            if nxt in targets:
+                hit = nxt
+                break
+            q.append(nxt)
