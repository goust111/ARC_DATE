+def _orbit_for_cell(sym: str, h: int, w: int, r: int, c: int) -> tuple[tuple[int, int], ...]:
+    rr, cc = _transform(sym, h, w, r, c)
+    if (rr, cc) == (r, c):
+        return ((r, c),)
+    pair = sorted(((r, c), (rr, cc)))
