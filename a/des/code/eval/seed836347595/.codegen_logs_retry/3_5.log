+    if sym == "H":
+        return bool(np.array_equal(mask, mask[::-1, :]))
+    if sym == "V":
+        return bool(np.array_equal(mask, mask[:, ::-1]))
+    if sym == "D":
+        return h == w and bool(np.array_equal(mask, mask.T))
+    raise ValueError(sym)
