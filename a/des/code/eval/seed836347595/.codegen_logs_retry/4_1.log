+                d = int(dval)
+                if s == BG and d == BG:
+                    continue
+                if s == BG or d == BG:
+                    valid = False
+                    break
+                prev_d = forward.get(s)
+                if prev_d is None:
+                    forward[s] = d
+                elif prev_d != d:
+                    valid = False
+                    break
+                prev_s = reverse.get(d)
+                if prev_s is None:
+                    reverse[d] = s
+                elif prev_s != s:
