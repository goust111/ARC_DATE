+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            parts.append(pts)
+    return parts
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _apply_transform(arr: np.ndarray, name: str) -> np.ndarray:
+    if name == "id":
+        return arr.copy()
+    if name == "rot90":
+        return np.rot90(arr, 1)
+    if name == "rot180":
+        return np.rot90(arr, 2)
+    if name == "rot270":
+        return np.rot90(arr, 3)
+    if name == "flip_ud":
+        return np.flipud(arr)
+    if name == "flip_lr":
+        return np.fliplr(arr)
+    if name == "transpose":
+        return arr.T
+    if name == "anti_transpose":
+        return np.fliplr(np.flipud(arr)).T
+    raise ValueError(f"unknown transform: {name}")
+
+
+def _recolor(arr: np.ndarray, mapping: dict[int, int]) -> np.ndarray:
+    out = np.zeros_like(arr)
+    nz = set(int(v) for v in np.unique(arr)) - {BG}
+    for color in nz:
+        if color not in mapping:
+            raise KeyError(color)
+        out[arr == color] = mapping[color]
+    return out
