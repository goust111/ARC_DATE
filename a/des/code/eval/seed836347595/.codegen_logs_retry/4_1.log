+    pair_count = demo_count + 1
+    pair_gap = rng.randint(1, 3)
+
+    left_margin = rng.randint(1, 3)
+    right_margin = rng.randint(1, 4)
+    top_margin = rng.randint(1, 3)
+    bottom_margin = rng.randint(1, 3)
