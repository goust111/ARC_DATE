+    demo_patterns: list[tuple[np.ndarray, np.ndarray]] = []
+    rows: list[int] = []
+    cur = top_margin
+    for idx in range(pair_count):
+        rows.append(cur)
+        cur += frame_size
+        if idx < pair_count - 1:
