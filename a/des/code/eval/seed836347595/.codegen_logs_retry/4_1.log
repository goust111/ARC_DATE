+def _recolor(arr: np.ndarray, mapping: dict[int, int]) -> np.ndarray:
+    out = np.zeros_like(arr)
+    nz = set(int(v) for v in np.unique(arr)) - {BG}
+    for color in nz:
+        if color not in mapping:
