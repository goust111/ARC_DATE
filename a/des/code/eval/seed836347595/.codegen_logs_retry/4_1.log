+    for name in TRANSFORM_NAMES:
+        forward: dict[int, int] = {}
+        reverse: dict[int, int] = {}
+        valid = True
+        for src, dst in demo_pairs:
+            transformed = _apply_transform(src, name)
+            if transformed.shape != dst.shape:
