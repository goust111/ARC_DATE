+        for pts in _components(g == color):
+            r0, c0, r1, c1 = _bbox(pts)
+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            if h < 3 or w < 3:
+                continue
+            perim = 2 * (h + w) - 4
+            if len(pts) != perim:
+                continue
+            pset = set(pts)
+            ok = True
+            for rr in range(r0, r1 + 1):
+                for cc in range(c0, c1 + 1):
+                    on_edge = rr in (r0, r1) or cc in (c0, c1)
+                    if on_edge != ((rr, cc) in pset):
+                        ok = False
+                        break
+                if not ok:
+                    break
+            if not ok:
+                continue
