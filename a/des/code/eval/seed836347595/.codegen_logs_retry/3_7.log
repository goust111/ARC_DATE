+def _fill_nested_regions(
+    crop: np.ndarray,
+    frames: list[dict],
+    palette: dict[int, np.ndarray],
+    crop_origin: tuple[int, int],
+) -> np.ndarray:
+    out = crop.copy()
+    base_r, base_c = crop_origin
+    rel_boxes = []
+    for frame in frames:
