+def _tile_pattern(
+    out: np.ndarray,
+    mask: np.ndarray,
+    pattern: np.ndarray,
+    anchor_r: int,
+    anchor_c: int,
+) -> None:
+    ph, pw = pattern.shape
+    rows, cols = np.where(mask)
+    for r, c in zip(rows, cols, strict=False):
+        out[int(r), int(c)] = int(pattern[(int(r) - anchor_r) % ph, (int(c) - anchor_c) % pw])
