+        if np.any(sub[:, 0] != marker):
+            continue
+        pattern = np.asarray(sub[:, 1:], dtype=int).copy()
+        vals = np.unique(pattern)
+        if vals.size < 2:
+            continue
+        mapping[marker] = pattern
