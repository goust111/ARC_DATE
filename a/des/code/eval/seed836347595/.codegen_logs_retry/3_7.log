+    g: np.ndarray,
+    bg: int,
+    outer_bbox: tuple[int, int, int, int],
+) -> dict[int, np.ndarray]:
+    mapping: dict[int, np.ndarray] = {}
+    for pts in _mask_components(g != bg):
