+def _pattern_mask(size: int, kind: str) -> np.ndarray:
+    rr, cc = np.indices((size, size))
+    if kind == "checker":
+        return (rr + cc) % 2 == 0
+    if kind == "vstripe":
+        return cc % 2 == 0
+    if kind == "hstripe":
+        return rr % 2 == 0
+    if kind == "upper_tri":
