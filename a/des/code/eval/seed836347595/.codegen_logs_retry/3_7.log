+        "width": int(width),
+        "frame_top": int(frame_top),
+        "frame_left": int(frame_left),
+        "palette_top": int(palette_top),
+        "palette_left": int(palette_left),
+        "frame_boxes_rel": frame_boxes_rel,
+        "frame_colors": frame_colors,
+        "palette_items": placed_items,
+    }
