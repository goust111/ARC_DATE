+    frame_left = int(spec["frame_left"])
+    palette_top = int(spec["palette_top"])
+    palette_left = int(spec["palette_left"])
+    height = int(spec["height"])
+    width = int(spec["width"])
+
+    inp = np.full((height, width), BG, dtype=int)
