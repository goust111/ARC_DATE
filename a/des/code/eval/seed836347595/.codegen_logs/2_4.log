+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+MARKER_COLORS = (BLUE, RED, GREEN)
+
+LOCK_H_RANGE = (10, 14)
+LOCK_W_RANGE = (8, 12)
+GRID_H_RANGE = (15, 23)
+LEFT_MARGIN_RANGE = (1, 4)
+RIGHT_MARGIN_RANGE = (1, 4)
+KEY_GAP_RANGE = (3, 6)
+SLOT_COUNT_CHOICES = (3, 4)
+SLOT_HEIGHT_CHOICES = (2, 2, 3, 3, 4)
+SLOT_WIDTH_CHOICES = (2, 2, 3)
+MAX_GENERATION_ATTEMPTS = 400
