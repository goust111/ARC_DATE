+
+def _slot_starts(profiles: list[tuple[int, ...]], lock_h: int) -> list[int]:
+    gap_count = len(profiles) + 1
+    gaps = [1] * gap_count
+    extra = lock_h - (sum(len(profile) for profile in profiles) + gap_count)
+    for _ in range(extra):
