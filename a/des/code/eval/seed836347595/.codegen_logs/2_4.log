+    for r in range(int(slot["top"]), int(slot["bottom"]) + 1):
+        for c in range(lc0, lc1 + 1):
+            value = int(g[r, c])
+            if value not in (BLACK, GREY, YELLOW):
+                out[r, lc0 : c + 1] = value
+
+    return out
