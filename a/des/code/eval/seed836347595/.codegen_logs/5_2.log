+def _chain_plan(colors: list[int], mapping: dict[int, int]) -> list[int] | None:
+    current = int(colors[0])
+    plan: list[int] = []
+    for _ in range(1, len(colors)):
+        if current not in mapping:
+            return None
+        current = int(mapping[current])
+        plan.append(int(current))
+    return plan
