+
+BG = 0
+GREY = 5
+PATH_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GRID_H_RANGE = (14, 24)
+GRID_W_RANGE = (14, 24)
+LEGEND_ENTRY_RANGE = (2, 4)
+CHAIN_COUNT_RANGE = (1, 4)
+COMPONENT_COUNT_CHOICES = [1, 2, 3, 4]
+COMPONENT_COUNT_WEIGHTS = [1, 4, 3, 2]
+FRAGMENT_COUNT_CHOICES = [1, 2, 3]
