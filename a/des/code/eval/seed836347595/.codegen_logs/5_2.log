+        orientation = "h" if r0 == r1 else "v"
+        if orientation == "h":
+            assert int(len(pts)) == c1 - c0 + 1, "horizontal segment must be solid after stitching"
+            line = r0
+            start = c0
+            end = c1
+        else:
+            assert int(len(pts)) == r1 - r0 + 1, "vertical segment must be solid after stitching"
+            line = c0
+            start = r0
+            end = r1
