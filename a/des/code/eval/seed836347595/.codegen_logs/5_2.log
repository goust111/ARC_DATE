+            start = c0
+            end = c1
+        else:
+            assert int(len(pts)) == r1 - r0 + 1, "vertical segment must be solid after stitching"
+            line = c0
+            start = r0
+            end = r1
+        for r, c in pts:
+            label[int(r), int(c)] = idx
+        comps.append(
