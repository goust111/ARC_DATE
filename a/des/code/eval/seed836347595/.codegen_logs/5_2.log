+
+def _mark_blocked(blocked: np.ndarray, r0: int, c0: int, r1: int, c1: int) -> None:
+    h, w = blocked.shape
+    rr0 = max(0, int(r0) - 1)
+    cc0 = max(0, int(c0) - 1)
+    rr1 = min(h - 1, int(r1) + 1)
+    cc1 = min(w - 1, int(c1) + 1)
+    blocked[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
