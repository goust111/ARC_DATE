+                current.append(nxt)
+                gaps.append((int(prev["end"]) + 1, int(col)))
+            else:
+                chains.append({"components": current, "gaps": gaps})
+                current = [nxt]
+                gaps = []
+        chains.append({"components": current, "gaps": gaps})
