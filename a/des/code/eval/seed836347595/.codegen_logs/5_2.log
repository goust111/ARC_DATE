+from __future__ import annotations
+
+from collections import defaultdict, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+PATH_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GRID_H_RANGE = (14, 24)
+GRID_W_RANGE = (14, 24)
