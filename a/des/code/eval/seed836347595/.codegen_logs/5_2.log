+def _legend_layout(
+    h: int,
+    w: int,
+    entries: list[tuple[int, int]],
+    bar_orientation: str,
+    corner: str,
+) -> tuple[list[tuple[int, int, int, int]], tuple[int, int, int, int]]:
+    count = len(entries)
+    if bar_orientation == "h":
+        box_h = 2 * count - 1
+        box_w = 3
+    else:
+        box_h = 3
+        box_w = 2 * count - 1
