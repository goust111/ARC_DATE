+    for r, c in np.argwhere(grid == GREY):
+        r = int(r)
+        c = int(c)
+        horiz = (
+            c - 1 >= 0
+            and c + 1 < w
+            and grid[r, c - 1] not in (BG, GREY)
+            and grid[r, c + 1] not in (BG, GREY)
+            and (r == 0 or grid[r - 1, c] == BG)
+            and (r == h - 1 or grid[r + 1, c] == BG)
