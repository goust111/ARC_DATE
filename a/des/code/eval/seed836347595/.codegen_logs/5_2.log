+            and (c + 2 >= w or grid[r, c + 2] == BG)
+        )
+        vert = (
+            r - 1 >= 0
+            and r + 1 < h
+            and grid[r - 1, c] not in (BG, GREY)
+            and grid[r + 1, c] not in (BG, GREY)
+            and (c == 0 or grid[r, c - 1] == BG)
+            and (c == w - 1 or grid[r, c + 1] == BG)
+            and (r - 2 < 0 or grid[r - 2, c] == BG)
+            and (r + 2 >= h or grid[r + 2, c] == BG)
