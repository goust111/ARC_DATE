+        variants2 = _fragment_variants(p2, zone_h, zone_w)
+        rng.shuffle(variants1)
+        rng.shuffle(variants2)
+        for frag1 in variants1:
+            set1 = set(frag1)
+            for frag2 in variants2:
+                set2 = set(frag2)
+                if set1 & set2:
+                    continue
+                occupied = set1 | set2
+                actual_branch = _classify_branch(p1, p2, occupied)
+                if actual_branch != branch:
+                    continue
