+    if np.array_equal(grid, expected):
+        return None
+    produced = main(grid)
+    if not np.array_equal(produced, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        try:
+            grid = _gen_attempt(rng)
+        except AssertionError:
