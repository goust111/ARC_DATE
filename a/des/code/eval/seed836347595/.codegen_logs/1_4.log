+def _bands(separators: list[int], size: int) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    start = 0
+    for sep in separators:
+        if start < sep:
+            spans.append((start, sep))
+        start = sep + 1
+    if start < size:
+        spans.append((start, size))
+    return spans
