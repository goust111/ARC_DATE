+        mask = np.repeat(mask, w, axis=1)
+    elif kind == "vstripe":
+        mask = ((cols + phase) % 2) == 0
+        mask = np.repeat(mask, h, axis=0)
+    elif kind == "checker":
+        mask = ((rows + cols + phase) % 2) == 0
