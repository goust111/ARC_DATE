+def _filled_patch(base: np.ndarray, depth_map: np.ndarray, pair: tuple[int, int]) -> np.ndarray:
+    x, y = pair
+    out = base.copy()
+    odd = depth_map % 2 == 1
+    even = depth_map > 0
+    even &= ~odd
+    out[odd] = x
+    out[even] = y
+    return out
