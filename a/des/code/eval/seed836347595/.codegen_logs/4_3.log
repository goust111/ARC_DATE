+    boundary_ids = set(int(v) for v in black_labels[0, :])
+    boundary_ids.update(int(v) for v in black_labels[-1, :])
+    boundary_ids.update(int(v) for v in black_labels[:, 0])
+    boundary_ids.update(int(v) for v in black_labels[:, -1])
