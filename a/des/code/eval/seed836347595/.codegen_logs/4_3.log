+    if axis == "v":
+        main_area = g[:, :sep]
+        sample_area = g[:, sep + 1 :]
+        sample_axis = "v"
+    else:
+        main_area = g[:sep, :]
+        sample_area = g[sep + 1 :, :]
+        sample_axis = "h"
