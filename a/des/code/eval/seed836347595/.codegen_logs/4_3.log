+    depth = {root: 0}
+    top_group = {root: 0}
+    queue = deque([root])
+    while queue:
+        current = queue.popleft()
+        for nxt in sorted(graph[current]):
+            if nxt in depth:
+                continue
+            depth[nxt] = depth[current] + 1
+            top_group[nxt] = nxt if current == root else top_group[current]
+            queue.append(nxt)
