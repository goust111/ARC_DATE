+    bboxes = [(0, 0, outer_h - 1, outer_w - 1)]
+    current = bboxes[0]
+    for level in range(1, level_count):
+        remain = level_count - level - 1
+        min_child_h = 3 + 4 * remain
+        min_child_w = 3 + 4 * remain
+
+        cur_h = current[2] - current[0] + 1
+        cur_w = current[3] - current[1] + 1
+        max_child_h = cur_h - 4
+        max_child_w = cur_w - 4
