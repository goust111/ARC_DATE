+    pair_for_group = {group_id: sample_pairs[i] for i, group_id in enumerate(group_ids)}
+
+    out = g.copy()
+    for region_id, comp in enumerate(black_comps, start=1):
+        d = depth[region_id]
+        if d == 0:
