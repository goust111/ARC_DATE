+def _components(mask: np.ndarray, connectivity: int) -> tuple[np.ndarray, list[dict[str, object]]]:
+    h, w = mask.shape
+    labels = np.zeros((h, w), dtype=int)
+    deltas = _NEIGHBORS4 if connectivity == 4 else _NEIGHBORS8
+    comps: list[dict[str, object]] = []
+
+    next_id = 0
+    for r0 in range(h):
+        for c0 in range(w):
+            if not mask[r0, c0] or labels[r0, c0] != 0:
+                continue
+            next_id += 1
+            labels[r0, c0] = next_id
+            queue = deque([(r0, c0)])
+            coords: list[tuple[int, int]] = []
+            min_r = max_r = r0
+            min_c = max_c = c0
+            while queue:
+                r, c = queue.popleft()
+                coords.append((r, c))
+                if r < min_r:
+                    min_r = r
+                if r > max_r:
+                    max_r = r
+                if c < min_c:
+                    min_c = c
+                if c > max_c:
+                    max_c = c
+                for dr, dc in deltas:
+                    rr = r + dr
+                    cc = c + dc
+                    if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and labels[rr, cc] == 0:
+                        labels[rr, cc] = next_id
+                        queue.append((rr, cc))
+            comps.append(
+                {
+                    "coords": np.array(coords, dtype=int),
+                    "bbox": (min_r, min_c, max_r, max_c),
+                    "area": len(coords),
+                }
+            )
+    return labels, comps
