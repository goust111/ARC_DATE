+    assert group_ids, "expected at least one enclosed structure"
+    group_ids.sort(
+        key=lambda region_id: (
+            -int(black_comps[region_id - 1]["area"]),
+            int(black_comps[region_id - 1]["bbox"][0]),
+            int(black_comps[region_id - 1]["bbox"][1]),
