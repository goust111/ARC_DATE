+
+            if search(depth + 1):
+                return True
+
+            occupied[r0 : r0 + h, c0 : c0 + w] = False
+            input_main[r0 : r0 + h, c0 : c0 + w] = BG
+            output_main[r0 : r0 + h, c0 : c0 + w] = BG
