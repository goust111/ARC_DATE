+_RNG = np.random.default_rng()
+_NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+_NEIGHBORS8 = _NEIGHBORS4 + [(-1, -1), (-1, 1), (1, -1), (1, 1)]
