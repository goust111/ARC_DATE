+def _generate_bboxes(level_count: int, group_count: int) -> list[tuple[int, int, int, int]] | None:
+    min_outer = 3 + 4 * (level_count - 1)
+    extra = 3 if group_count == 3 else 6
+    outer_h = _randint(min_outer + 1, min_outer + extra)
