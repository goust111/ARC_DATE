+    for comp in contour_comps:
+        adjacent: set[int] = set()
+        for r, c in comp["coords"]:
+            for dr, dc in _NEIGHBORS4:
+                rr = int(r) + dr
+                cc = int(c) + dc
+                if 0 <= rr < main.shape[0] and 0 <= cc < main.shape[1]:
+                    region_id = int(black_labels[rr, cc])
+                    if region_id > 0:
