+
+    if orientation == "v":
+        max_main_h = 28
+        max_main_w = 24
+    else:
+        max_main_h = 24
+        max_main_w = 28
+
+    min_main_h = max(18, max_h + 2, int(np.ceil(np.sqrt(total_patch_area * 0.9))))
+    min_main_w = max(18, max_w + 2, int(np.ceil(np.sqrt(total_patch_area * 0.9))))
+    if min_main_h > max_main_h or min_main_w > max_main_w:
