+        d = depth[region_id]
+        if d == 0:
+            continue
+        x, y = pair_for_group[top_group[region_id]]
+        fill_color = x if d % 2 == 1 else y
+        coords = comp["coords"]
+        out[coords[:, 0], coords[:, 1]] = fill_color
+    return out
