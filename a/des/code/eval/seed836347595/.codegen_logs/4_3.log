+        child_h = _randint(min_child_h, max_child_h)
+        child_w = _randint(min_child_w, max_child_w)
+        top = _randint(2, cur_h - child_h - 2)
+        left = _randint(2, cur_w - child_w - 2)
+
+        child = (
+            current[0] + top,
+            current[1] + left,
+            current[0] + top + child_h - 1,
+            current[1] + left + child_w - 1,
