+    next_id = 0
+    for r0 in range(h):
+        for c0 in range(w):
+            if not mask[r0, c0] or labels[r0, c0] != 0:
+                continue
+            next_id += 1
+            labels[r0, c0] = next_id
+            queue = deque([(r0, c0)])
+            coords: list[tuple[int, int]] = []
+            min_r = max_r = r0
