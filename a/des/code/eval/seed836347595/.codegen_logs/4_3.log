+
+def _render_structure(
+    bboxes: list[tuple[int, int, int, int]],
+    contour_color: int,
+) -> tuple[np.ndarray, np.ndarray]:
+    h = bboxes[0][2] + 1
+    w = bboxes[0][3] + 1
