+    pairs: list[tuple[int, int, int, int]] = []
+    for comp in comps:
+        r0, c0, r1, c1 = comp["bbox"]
+        assert (r1 - r0 + 1, c1 - c0 + 1) == (2, 2), "sample block must be 2x2"
