+def main(grid: np.ndarray) -> np.ndarray:
+    """Fill nested enclosed regions using sample pairs matched by outer-ring area."""
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    axis, sep = _find_separator(g, bg)
