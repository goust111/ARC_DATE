+                if c > max_c:
+                    max_c = c
+                for dr, dc in deltas:
+                    rr = r + dr
+                    cc = c + dc
+                    if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and labels[rr, cc] == 0:
+                        labels[rr, cc] = next_id
+                        queue.append((rr, cc))
+            comps.append(
+                {
