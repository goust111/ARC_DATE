+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h - 1, r1 + pad)
+    cc1 = min(w - 1, c1 + pad)
+    blocked[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+
+
+def _choose_seed_offset(inner_h: int, inner_w: int, direction: str) -> tuple[int, int]:
