+    high = size - outer - 1
+    if positive:
+        high = min(high, size - 2 - seed_offset - length)
+    else:
+        low = max(low, length - 1 - seed_offset)
+    if low > high:
+        return None
+    return low, high
+
+
+def _plan_room(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    ray_blocked: np.ndarray,
+    color: int,
+    direction: str,
+) -> dict[str, object] | None:
+    h, w = grid.shape
