+                    break
+            if bad:
+                continue
+
+            return {
+                "bbox": (r0, c0, r1, c1),
+                "seed": (seed_r, seed_c),
+                "color": color,
+                "direction": direction,
+                "length": length,
+                "ray": ray,
+            }
+    return None
+
+
+def _paint_room(grid: np.ndarray, room: dict[str, object]) -> None:
+    r0, c0, r1, c1 = room["bbox"]
+    grid[r0, c0 : c1 + 1] = MAROON
+    grid[r1, c0 : c1 + 1] = MAROON
+    grid[r0 : r1 + 1, c0] = MAROON
