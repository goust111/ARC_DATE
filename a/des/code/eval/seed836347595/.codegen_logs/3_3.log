+
+def _signature(coords: list[tuple[int, int]]) -> frozenset[tuple[int, int]]:
+    r0 = min(r for r, _ in coords)
+    c0 = min(c for _, c in coords)
+    return frozenset((r - r0, c - c0) for r, c in coords)
