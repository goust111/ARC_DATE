+    grid[r1, c0 : c1 + 1] = MAROON
+    grid[r0 : r1 + 1, c0] = MAROON
+    grid[r0 : r1 + 1, c1] = MAROON
+    sr, sc = room["seed"]
+    grid[sr, sc] = int(room["color"])
