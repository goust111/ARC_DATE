+    grid[r1, c0 : c1 + 1] = color
+    grid[r0 : r1 + 1, c0] = color
+    grid[r0 : r1 + 1, c1] = color
+    if fill is not None:
+        grid[r0 + 1 : r1, c0 + 1 : c1] = fill
+
+
+def _slot_bboxes(
+    height: int,
+    width: int,
+    frag_h: int,
+    frag_w: int,
