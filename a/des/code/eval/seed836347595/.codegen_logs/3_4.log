        rows = list(range(row_range[0], row_range[1] + 1))
        cols = list(range(col_range[0], col_range[1] + 1))
        random.shuffle(rows)
        random.shuffle(cols)
        positions = [(r0, c0) for r0 in rows for c0 in cols]
        random.shuffle(positions)


