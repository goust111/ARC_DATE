+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+PATTERN_COLORS = (0, 7, 8, 9)
+
+BG = YELLOW
+LINE_COLORS = (BLUE, RED)
+SIDES = ("top", "right", "bottom", "left")
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
