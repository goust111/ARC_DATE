+        (row0, left + idx * (frag_w + gap), row0 + frag_h - 1, left + idx * (frag_w + gap) + frag_w - 1)
+        for idx in range(count)
+    ]
+
+
+def _int_range(bounds: tuple[int, int], rng: np.random.Generator) -> int:
+    return int(rng.integers(bounds[0], bounds[1]))
+
+
