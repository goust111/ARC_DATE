231: def _bar_regions_disjoint(ray, bars):
232:     """Check that the diagonal flood regions of all bars are mutually disjoint."""
233:     claimed = set()
234:     for pair in bars:
235:         region = _diag_flood(ray, list(pair))
236:         if claimed & region:
