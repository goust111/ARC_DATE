64:     Replace each marker below the separator with the mapped top legend square centered on that marker.
65: 
66:     Input structure:
67:     - The background surrounds a top legend, one solid non-background separator row, and a lower marker field.
68:     - The legend contains equal-size filled square sprites, with a singleton marker below each sprite and aligned to its center column.
69:     - The lower field contains only background and marker colors from the legend.
70: 
71:     Rule:
72:     - Pair legend markers to legend sprites by left-to-right position.
73:     - Discard the legend and separator; keep the grid width and the rows below the separator.
74:     - In the lower field, replace every marker pixel by a filled square of the paired sprite color, centered at the marker location.
75: 
76:     Key insight: The top area is a positional color legend, and the actual output is the post-separator marker field expanded by that legend.
77:     """
78:     g = np.asarray(grid, dtype=int)
79:     bg = int(get_bg(g))
80:     sep = _solid_separator_row(g, bg)
81:     mapping, size = _legend_mapping(g, sep, bg)
82: 
83:     lower = g[sep + 1 :]
84:     out = np.full_like(lower, bg)
85:     radius = size // 2
86: 
87:     for r, c in np.argwhere(lower != bg):
88:         key = int(lower[r, c])
89:         assert key in mapping, "lower field marker must appear in the legend"
90:         r0 = int(r) - radius
91:         c0 = int(c) - radius
92:         r1 = r0 + size
93:         c1 = c0 + size
94:         assert 0 <= r0 and 0 <= c0 and r1 <= out.shape[0] and c1 <= out.shape[1], "expanded square must fit in output"
95:         assert np.all(out[r0:r1, c0:c1] == bg), "expanded squares must not overlap"
96:         out[r0:r1, c0:c1] = mapping[key]
97: 
98:     return out
99: 
100: # --------------- generator (o5x) ---------------
101: 
102: # Canvas and legend geometry.
103: BACKGROUND_COLOR, SEPARATOR_COLOR = 7, 6
104: FIELD_SHAPE = (13, 11)
105: FIELD_WIDTH = FIELD_SHAPE[1]
106: SQUARE_SIZE = 3
107: SQUARE_RADIUS = SQUARE_SIZE // 2
108: LEGEND_HEIGHT, LEGEND_MARKER_ROW, LEGEND_COLUMN_STRIDE = 6, 4, 4
109: 
110: # Palette and object counts.
111: PALETTE_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]
112: NUM_COLOR_PAIRS, SQUARE_COUNT_CHOICES = 3, [8, 9]
113: 
114: EMPTY, MAX_GENERATION_ATTEMPTS = 0, 300
115: 
116: 
117: def _color_pairs() -> tuple[list[int], list[int]]:
118:     """Return disjoint sprite and marker palettes in legend order."""
119:     picked = random.sample(PALETTE_COLORS, NUM_COLOR_PAIRS * 2)
120:     return picked[:NUM_COLOR_PAIRS], picked[NUM_COLOR_PAIRS:]
121: 
122: 
123: def _place_centers(n: int) -> list[tuple[int, int]] | None:
124:     """Place non-overlapping 3x3 squares and return their centers."""
125:     occ = np.full(FIELD_SHAPE, EMPTY, dtype=int)
126:     patch = np.ones((SQUARE_SIZE, SQUARE_SIZE), dtype=int)
127:     centers: list[tuple[int, int]] = []
128:     for _ in range(n):
129:         try:
130:             r0, c0 = random_free_location(occ, patch, transparent=EMPTY)
131:         except ValueError:
132:             return None
133:         paste(occ, patch, r0, c0)
134:         centers.append((r0 + SQUARE_RADIUS, c0 + SQUARE_RADIUS))
135:     return centers
136: 
137: 
138: def _touch_graph(centers: list[tuple[int, int]]) -> list[set[int]]:
139:     """Connect square indices whose rendered 3x3 blocks share an edge."""
140:     neighbors = [set() for _ in centers]
141:     for i, (r1, c1) in enumerate(centers):
142:         for j, (r2, c2) in enumerate(centers[i + 1 :], start=i + 1):
143:             dr = abs(r1 - r2)
144:             dc = abs(c1 - c2)
145:             if (dr == SQUARE_SIZE and dc < SQUARE_SIZE) or (dc == SQUARE_SIZE and dr < SQUARE_SIZE):
146:                 neighbors[i].add(j)
147:                 neighbors[j].add(i)
148:     return neighbors
149: 
150: 
151: def _assign_square_ids(centers: list[tuple[int, int]]) -> list[int] | None:
152:     """Assign all color ids while preventing same-color touching squares."""
153:     neighbors = _touch_graph(centers)
154:     order = list(range(len(centers)))
155:     random.shuffle(order)
156:     order.sort(key=lambda i: len(neighbors[i]), reverse=True)
157:     ids: list[int | None] = [None] * len(centers)
158:     required = set(range(NUM_COLOR_PAIRS))
159: 
160:     def backtrack(pos: int, used: set[int]) -> bool:
161:         if pos == len(order):
162:             return used == required
163:         if len(required - used) > len(order) - pos:
164:             return False
165:         i = order[pos]
166:         choices = list(range(NUM_COLOR_PAIRS))
167:         random.shuffle(choices)
168:         for color_id in choices:
169:             if any(ids[j] == color_id for j in neighbors[i]):
170:                 continue
171:             ids[i] = color_id
172:             if backtrack(pos + 1, used | {color_id}):
173:                 return True
174:             ids[i] = None
175:         return False
176: 
177:     if not backtrack(0, set()):
178:         return None
179:     return [int(x) for x in ids]
180: 
181: 
182: def _build_grids(
183:     centers: list[tuple[int, int]],
184:     square_ids: list[int],
185:     sprite_colors: list[int],
186:     marker_colors: list[int],
187: ) -> tuple[np.ndarray, np.ndarray]:
188:     """Return an assembled input grid and the matching oracle output."""
189:     out = np.full(FIELD_SHAPE, BACKGROUND_COLOR, dtype=int)
190:     lower = np.full(FIELD_SHAPE, BACKGROUND_COLOR, dtype=int)
191:     for (r, c), idx in zip(centers, square_ids):
192:         patch = np.full((SQUARE_SIZE, SQUARE_SIZE), sprite_colors[idx], dtype=int)
193:         paste(out, patch, r - SQUARE_RADIUS, c - SQUARE_RADIUS)
194:         lower[r, c] = marker_colors[idx]
195: 
196:     legend = np.full((LEGEND_HEIGHT, FIELD_WIDTH), BACKGROUND_COLOR, dtype=int)
197:     for i, (sprite, marker) in enumerate(zip(sprite_colors, marker_colors)):
198:         c0 = i * LEGEND_COLUMN_STRIDE
199:         legend[:SQUARE_SIZE, c0 : c0 + SQUARE_SIZE] = sprite
200:         legend[LEGEND_MARKER_ROW, c0 + SQUARE_RADIUS] = marker
201: 
202:     sep = np.full((1, FIELD_WIDTH), SEPARATOR_COLOR, dtype=int)
203:     return np.vstack([legend, sep, lower]), out
204: 
205: 
206: def _gen_attempt() -> np.ndarray | None:
207:     sprite_colors, marker_colors = _color_pairs()
208:     n_squares = random.choice(SQUARE_COUNT_CHOICES)
209:     centers = _place_centers(n_squares)
210:     if centers is None:
211:         return None
212:     square_ids = _assign_square_ids(centers)
213:     if square_ids is None:
214:         return None
215: 
216:     inp, out = _build_grids(centers, square_ids, sprite_colors, marker_colors)
217:     if np.array_equal(main(inp), out):
218:         return inp
219:     return None
220: 
221: 
222: def generate_input() -> np.ndarray:
223:     for _ in range(MAX_GENERATION_ATTEMPTS):
224:         inp = _gen_attempt()
225:         if inp is not None:
226:             return inp
227:     raise RuntimeError("failed to generate valid 20fb2937 input")

