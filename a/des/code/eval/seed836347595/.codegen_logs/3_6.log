35: def main(grid: np.ndarray) -> np.ndarray:
36:     """
37:     Complete a sparse grid by casting occluding diagonal rays from the longest run and filling the remaining diagonal-connected regions from the short bars.
38: 
39:     Input structure
40:     - Black-background grid with one unique longest 4-connected foreground object.
41:     - The longest object is a horizontal or vertical multicolor run; all other foreground objects are shorter monochrome bars.
42: 
43:     Rule
44:     - On a blank canvas, process the longest run from left to right or top to bottom; each pixel emits four 45-degree rays that stop at the first already-painted pixel.
45:     - Each remaining monochrome bar fills every still-blank pixel reachable from it by diagonal steps.
46: 
47:     Key insight
48:     - Earlier pixels in the long run occlude later diagonal rays, and those ray barriers partition the background into diagonal-connected regions for the short bars.
49:     """
50:     g = np.asarray(grid, dtype=int)
51:     bg = get_bg(g)
52:     H, W = g.shape
53: 
54:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=False)
55:     assert len(comps) >= 2, "expected a main run plus at least one short bar"
56: 
57:     max_area = max(int(comp["area"]) for comp in comps)
58:     main_candidates = [comp for comp in comps if int(comp["area"]) == max_area]
59:     assert len(main_candidates) == 1, "main run must be the unique largest foreground object"
60: 
61:     main = main_candidates[0]
62:     main_coords = _component_coords(main)
63:     assert len({int(g[r, c]) for r, c in main_coords}) >= 2, "main run must be multicolor"
64:     ordered_main = _ordered_straight_run(main_coords)
65: 
66:     out = np.full_like(g, bg)
67:     for r, c in ordered_main:
68:         color = int(g[r, c])
69:         assert color != bg
70:         assert out[r, c] == bg, "main source pixel unexpectedly already painted"
71:         out[r, c] = color
72:         for dr, dc in DIAG_DIRS:
73:             nr, nc = r + dr, c + dc
74:             while 0 <= nr < H and 0 <= nc < W and out[nr, nc] == bg:
75:                 out[nr, nc] = color
76:                 nr += dr
77:                 nc += dc
78: 
79:     main_set = set(main_coords)
80:     base = out.copy()
81:     fill_regions: list[tuple[int, set[tuple[int, int]]]] = []
82:     for comp in comps:
83:         coords = _component_coords(comp)
84:         if set(coords) == main_set:
85:             continue
86: 
87:         ordered_bar = _ordered_straight_run(coords)
88:         colors = {int(g[r, c]) for r, c in ordered_bar}
89:         assert len(colors) == 1, "short bar must be monochrome"
90:         color = next(iter(colors))
91:         assert color != bg
92:         assert all(base[r, c] == bg for r, c in ordered_bar), "short bar overlaps main rays"
93: 
94:         seen = set(ordered_bar)
95:         q = deque(ordered_bar)
96:         while q:
97:             r, c = q.popleft()
98:             for dr, dc in DIAG_DIRS:
99:                 nr, nc = r + dr, c + dc
100:                 if 0 <= nr < H and 0 <= nc < W and base[nr, nc] == bg and (nr, nc) not in seen:
101:                     seen.add((nr, nc))
102:                     q.append((nr, nc))
103:         fill_regions.append((color, seen))
104: 
105:     claimed: set[tuple[int, int]] = set()
106:     for color, region in fill_regions:
107:         assert claimed.isdisjoint(region), "short-bar diagonal regions must be disjoint"
108:         claimed.update(region)
109:         for r, c in region:
110:             out[r, c] = color
111: 
112:     for r, c in np.argwhere(g != bg):
113:         assert out[int(r), int(c)] == int(g[int(r), int(c)]), "input foreground must be preserved"
114: 
115:     return out
116: 
117: # --------------- generator (o5x) ---------------
118: 
119: # --- Configuration ---
120: GRID_SIZE_MIN, GRID_SIZE_MAX = 4, 10
121: RUN_LENGTH_MIN, RUN_LENGTH_MAX = 3, 7    # main run pixel count
122: POS_MARGIN = 1                            # perpendicular position inset from grid edges
123: COLOR_MIN, COLOR_MAX = 1, 9              # non-background color range (inclusive)
124: MAX_RETRIES = 300                         # generate_input() retry budget
125: 
126: _DIAG_DIRS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
127: _ORTH_DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
128: 
129: # Edge definitions: (name, pair_generator) -- each yields adjacent cell pairs along one edge.
130: _EDGE_DEFS = {
131:     "top":    lambda n: (((0, c), (0, c + 1)) for c in range(n - 1)),
132:     "bottom": lambda n: (((n - 1, c), (n - 1, c + 1)) for c in range(n - 1)),
133:     "left":   lambda n: (((r, 0), (r + 1, 0)) for r in range(n - 1)),
134:     "right":  lambda n: (((r, n - 1), (r + 1, n - 1)) for r in range(n - 1)),
135: }
136: 
137: 
138: def _diag_flood(ray, seeds):
139:     """BFS all zero-cells in *ray* diag-reachable from *seeds*. Returns the visited set (includes seeds)."""
140:     n = ray.shape[0]
141:     seen = set(seeds)
142:     q = deque(seeds)
143:     while q:
144:         r, c = q.popleft()
145:         for dr, dc in _DIAG_DIRS:
146:             nr, nc = r + dr, c + dc
147:             if 0 <= nr < n and 0 <= nc < n and ray[nr, nc] == 0 and (nr, nc) not in seen:
148:                 seen.add((nr, nc))
149:                 q.append((nr, nc))
150:     return seen
151: 
152: 
153: def _cast_main_rays(n, orientation, length, pos, colors):
154:     """Place the main run and cast 4 diagonal rays from each pixel (with occlusion). Returns (ray_grid, coords) or (None, None)."""
155:     ray = np.zeros((n, n), dtype=int)
156:     if orientation == "H":
157:         coords = [(pos, c) for c in range(n - length, n)]
158:     else:
159:         coords = [(r, pos) for r in range(n - length, n)]
160: 
161:     for (r, c), color in zip(coords, colors):
162:         if ray[r, c] != 0:
163:             return None, None
164:         ray[r, c] = color
165:         for dr, dc in _DIAG_DIRS:
166:             nr, nc = r + dr, c + dc
167:             while 0 <= nr < n and 0 <= nc < n and ray[nr, nc] == 0:
168:                 ray[nr, nc] = color
169:                 nr += dr
170:                 nc += dc
171:     return ray, coords
172: 
173: 
174: def _diag_labels(ray):
175:     """Label each diagonal-connected zero-region in *ray* with a unique integer. Non-zero cells get -1."""
176:     n = ray.shape[0]
177:     labels = np.full_like(ray, -1, dtype=int)
178:     next_label = 0
179:     for sr, sc in np.argwhere(ray == 0):
180:         sr, sc = int(sr), int(sc)
181:         if labels[sr, sc] >= 0:
182:             continue
183:         for cell in _diag_flood(ray, [(sr, sc)]):
184:             labels[cell] = next_label
185:         next_label += 1
186:     return labels
187: 
188: 
189: def _touches(cells, blocked):
190:     """True if any cell in *cells* is orthogonally adjacent to a cell in *blocked*."""
191:     for r, c in cells:
192:         for dr, dc in _ORTH_DIRS:
193:             if (r + dr, c + dc) in blocked:
194:                 return True
195:     return False
196: 
197: 
198: def _edge_pairs(ray, labels, excluded_edge, blocked):
199:     """Find valid size-2 bar placements along grid edges (excluding *excluded_edge* and cells adjacent to *blocked*)."""
200:     n = ray.shape[0]
201:     pairs = []
202:     for edge_name, gen_fn in _EDGE_DEFS.items():
203:         if edge_name == excluded_edge:
204:             continue
205:         for pair in gen_fn(n):
206:             if all(ray[p] == 0 for p in pair) and not _touches(pair, blocked):
207:                 pairs.append((pair, frozenset(int(labels[p]) for p in pair)))
208:     return pairs
209: 
210: 
211: def _choose_bars(ray, main_coords, orientation):
212:     """Select 1 or 2 compatible bar placements from grid edges."""
213:     excluded_edge = "right" if orientation == "H" else "bottom"
214:     labels = _diag_labels(ray)
215:     candidates = _edge_pairs(ray, labels, excluded_edge, set(main_coords))
216:     if not candidates:
217:         return None
218: 
219:     compatible_twos = []
220:     for i, (pair_a, labels_a) in enumerate(candidates):
221:         for pair_b, labels_b in candidates[i + 1:]:
222:             if labels_a & labels_b or _touches(pair_b, set(pair_a)):
223:                 continue
224:             compatible_twos.append((pair_a, pair_b))
225: 
226:     if compatible_twos and random.choice((1, 2)) == 2:
227:         return list(random.choice(compatible_twos))
228:     return [random.choice(candidates)[0]]
229: 
