241: 
242: def _build_output(ray, bars, bar_colors):
243:     """Overlay each bar's diagonal flood region onto the ray grid."""
244:     out = ray.copy()
245:     for pair, color in zip(bars, bar_colors):
246:         for r, c in _diag_flood(ray, list(pair)):
