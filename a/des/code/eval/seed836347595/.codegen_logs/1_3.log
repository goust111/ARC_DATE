+def _room_bbox_cells(room: dict[str, int]) -> set[tuple[int, int]]:
+    cells = set()
+    for r in range(room["r0"], room["r1"] + 1):
+        for c in range(room["c0"], room["c1"] + 1):
+            cells.add((r, c))
+    return cells
+
