+def _sample_route_points(
+    h: int,
+    w: int,
+    end: tuple[int, int],
+    final_dir: tuple[int, int],
+) -> list[tuple[int, int]] | None:
+    er, ec = end
+    horizontal = final_dir[0] == 0
+    if horizontal:
+        pattern = random.choices(["H0", "VH1", "HVH2"], weights=[1, 2, 4])[0]
+        if pattern == "H0":
