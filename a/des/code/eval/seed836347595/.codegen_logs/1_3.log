+
+def _valid_scene(inp: np.ndarray, meta: dict[str, object]) -> bool:
+    try:
+        out = main(inp)
+    except Exception:
+        return False
+
+    plans = meta["plans"]
+    rooms = meta["rooms"]
+    filled_rooms = 0
+    for plan in plans:
+        if plan["kind"] != "room":
+            continue
+        room = rooms[plan["room_index"]]
+        interior = out[room["r0"] + 1 : room["r1"], room["c0"] + 1 : room["c1"]]
+        if interior.size == 0 or not np.all(interior == int(plan["color"])):
+            return False
+        filled_rooms += 1
+
+    if filled_rooms == 0:
+        return False
+    if np.any(out == MAROON):
+        return False
+    if np.array_equal(inp, out):
+        return False
+    return True
