+        if extras_info is None:
+            continue
+        bend_cells, extra_gray = extras_info
+
+        return {
+            "start": start,
+            "marker": marker,
+            "first_dir": first_dir,
+            "route_cells": route_cells,
+            "bend_cells": bend_cells,
+            "extra_gray": extra_gray,
+            "points": points,
+        }
+    return None
