+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+GREEN = 3
+GRAY = 5
+MAROON = 9
+TOWER_COLORS = (1, 2, 4, 6, 7, 8)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_H_RANGE = (18, 24)
+GRID_W_RANGE = (18, 24)
+ROOM_COUNT_RANGE = (1, 3)
+ROOM_INNER_H_RANGE = (2, 5)
+ROOM_INNER_W_RANGE = (2, 6)
+ROOM_MARGIN = 3
+ROOM_GAP = 2
+TOWER_COUNT_RANGE = (1, 3)
+SCENE_RETRIES = 400
+ROOM_RETRIES = 120
+ROUTE_RETRIES = 240
