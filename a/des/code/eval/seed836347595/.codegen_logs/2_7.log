+        return False
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h - 1, r1 + pad)
+    cc1 = min(w - 1, c1 + pad)
+    return not bool(occ[rr0 : rr1 + 1, cc0 : cc1 + 1].any())
+
+
+def _draw_room(
+    grid: np.ndarray,
+    room: tuple[int, int, int, int],
+    window_count: int,
+    rng: random.Random,
+) -> None:
