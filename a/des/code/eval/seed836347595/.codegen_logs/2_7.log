    candidates.sort(key=lambda item: (item[0][2], item[0][1]))
    return candidates[-1]


def _room_bbox_if_valid(grid: np.ndarray, comp: list[tuple[int, int]]) -> tuple[int, int, int, int] | None:
    r0, c0, r1, c1 = _bbox(comp)
    if r1 - r0 < 2 or c1 - c0 < 2:
