+    _reserve(occ, palette_r0, palette_c0, palette_r0 + PALETTE_H - 1, palette_c0 + PALETTE_W - 1, pad=1)
+
+    room_count = rng.choice((3, 4, 5))
+    window_counts = rng.sample([1, 2, 3, 4, 5], room_count)
+    specs: list[tuple[int, int, int, int]] = []
