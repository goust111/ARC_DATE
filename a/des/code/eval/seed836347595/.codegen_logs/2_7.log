+    rooms: list[tuple[int, int, int, int, int]],
+    palette_colors: list[int],
+) -> np.ndarray:
+    out = grid.copy()
+    for r0, c0, r1, c1, window_count in rooms:
+        out[r0 + 1 : r1, c0 + 1 : c1] = int(palette_colors[window_count - 1])
+    return out
