from __future__ import annotations

import random
from collections import deque

import numpy as np


BLACK = 0
BLUE = 1
RED = 2
GREEN = 3
YELLOW = 4
GREY = 5
MAGENTA = 6
ORANGE = 7
AZURE = 8
BROWN = 9

PALETTE_COLORS = (RED, GREEN, MAGENTA, ORANGE, AZURE, BROWN)
PALETTE_H = 3
PALETTE_W = 11
MAX_GENERATION_ATTEMPTS = 400
MAX_ROOM_PLACEMENT_TRIES = 150


def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    comps: list[list[tuple[int, int]]] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            comp: list[tuple[int, int]] = []
            while q:
                rr, cc = q.popleft()
                comp.append((rr, cc))
                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nr, nc = rr + dr, cc + dc
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            comps.append(comp)
    return comps


def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
    rows = [r for r, _ in points]
    cols = [c for _, c in points]
    return min(rows), min(cols), max(rows), max(cols)


def _border_positions(
    r0: int,
    c0: int,
    r1: int,
    c1: int,
    include_corners: bool = True,
) -> list[tuple[int, int]]:
    pts: list[tuple[int, int]] = []
    for c in range(c0, c1 + 1):
        pts.append((r0, c))
        pts.append((r1, c))
    for r in range(r0 + 1, r1):
        pts.append((r, c0))
        pts.append((r, c1))
    if not include_corners:
        corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
        pts = [p for p in pts if p not in corners]
    return pts


def _find_palette(grid: np.ndarray) -> tuple[tuple[int, int, int, int], list[int]]:
    candidates: list[tuple[tuple[int, int, int, int], list[int]]] = []
    for comp in _components(grid == GREY):
        r0, c0, r1, c1 = _bbox(comp)
        if r1 - r0 + 1 != PALETTE_H or c1 - c0 + 1 != PALETTE_W:
            continue
        if len(comp) != 2 * (PALETTE_H + PALETTE_W) - 4:
            continue
        if not np.all(grid[r0, c0 : c1 + 1] == GREY):
            continue
        if not np.all(grid[r1, c0 : c1 + 1] == GREY):
            continue
        if not np.all(grid[r0:r1 + 1, c0] == GREY):
            continue
        if not np.all(grid[r0:r1 + 1, c1] == GREY):
            continue

        inner = grid[r0 + 1, c0 + 1 : c1]
        if inner.shape[0] != 9:
            continue

        colors: list[int] = []
        ok = True
        for idx, value in enumerate(inner):
            value = int(value)
            if idx % 2 == 0:
                if value in (BLACK, GREY):
                    ok = False
                    break
                colors.append(value)
            elif value != BLACK:
