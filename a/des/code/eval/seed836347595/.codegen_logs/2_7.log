            interior[interior == BLACK] = fill_color
    return out


def _draw_palette(grid: np.ndarray, r0: int, c0: int, colors: list[int]) -> None:
    grid[r0 : r0 + PALETTE_H, c0 : c0 + PALETTE_W] = BLACK
    grid[r0, c0 : c0 + PALETTE_W] = GREY
