+
+
+def _bbox_intersection(
+    a: tuple[int, int, int, int], b: tuple[int, int, int, int]
+) -> tuple[int, int, int, int] | None:
+    r0 = max(a[0], b[0])
+    c0 = max(a[1], b[1])
+    r1 = min(a[2], b[2])
+    c1 = min(a[3], b[3])
+    if r0 > r1 or c0 > c1:
+        return None
+    return r0, c0, r1, c1
+
+
+def _corner_local(h: int, w: int, corner: str) -> tuple[int, int]:
+    if corner == "tl":
