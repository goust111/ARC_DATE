+
+
+def _expected_output(pieces: list[Piece], inner_h: int, inner_w: int) -> np.ndarray:
+    out = np.full((inner_h + 2, inner_w + 2), BG, dtype=int)
+    out[0, :] = FRAME
+    out[-1, :] = FRAME
+    out[:, 0] = FRAME
+    out[:, -1] = FRAME
+    for piece in pieces:
