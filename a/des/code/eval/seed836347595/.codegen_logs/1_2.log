+        gr = piece.r + mr
+        gc = piece.c + mc
+        if grid[gr, gc] != piece.color:
+            return None
+        grid[gr, gc] = MARKER
+
+    return grid
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
