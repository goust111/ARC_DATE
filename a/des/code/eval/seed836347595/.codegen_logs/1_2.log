+
+
+def _layout_scene(
+    pieces: list[Piece], inner_h: int, inner_w: int, rng: random.Random
+) -> tuple[int, int, tuple[int, int, int, int]]:
+    cluster_h, cluster_w = _normalize_pieces(pieces)
+    frame_h = inner_h + 2
