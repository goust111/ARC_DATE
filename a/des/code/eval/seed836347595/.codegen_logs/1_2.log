+
+
+def _occupancy_without_markers(pieces: list[Piece]) -> dict[tuple[int, int], int] | None:
+    occ: dict[tuple[int, int], int] = {}
+    for piece in pieces:
+        for cell in _visible_cells(piece):
+            if cell in occ:
