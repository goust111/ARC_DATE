+CORNERS = ("tl", "tr", "bl", "br")
+SIDE_CORNERS = {
+    "left": {"tl", "bl"},
+    "right": {"tr", "br"},
+    "top": {"tl", "tr"},
+    "bottom": {"bl", "br"},
+}
+OPPOSITE_SIDE = {"left": "right", "right": "left", "top": "bottom", "bottom": "top"}
