+def _bbox(piece: Piece) -> tuple[int, int, int, int]:
+    return piece.r, piece.c, piece.r + piece.h - 1, piece.c + piece.w - 1
+
+
+def _bbox_intersection(
+    a: tuple[int, int, int, int], b: tuple[int, int, int, int]
