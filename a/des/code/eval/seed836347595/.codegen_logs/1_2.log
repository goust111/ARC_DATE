+from __future__ import annotations
+
+from collections import deque
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+MARKER = 9
+PIECE_COLORS = (1, 2, 3, 4, 6, 7, 8)
+CORNERS = ("tl", "tr", "bl", "br")
+SIDE_CORNERS = {
+    "left": {"tl", "bl"},
+    "right": {"tr", "br"},
+    "top": {"tl", "tr"},
+    "bottom": {"bl", "br"},
+}
+OPPOSITE_SIDE = {"left": "right", "right": "left", "top": "bottom", "bottom": "top"}
