+
+def count_turns(path: list[tuple[int, int]]) -> int:
+    if len(path) < 3:
+        return 0
+    dirs = []
+    for (r0, c0), (r1, c1) in zip(path, path[1:]):
+        dirs.append((r1 - r0, c1 - c0))
+    turns = 0
+    for d0, d1 in zip(dirs, dirs[1:]):
+        if d0 != d1:
+            turns += 1
+    return turns
