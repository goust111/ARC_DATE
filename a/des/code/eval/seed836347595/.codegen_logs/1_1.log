+        if len(regions) != target:
+            continue
+        dims = [(r1 - r0 + 1, c1 - c0 + 1) for r0, r1, c0, c1 in regions]
+        if any(h == w for h, w in dims):
+            continue
+        norm = {tuple(sorted((h, w))) for h, w in dims}
+        if len(norm) != target:
+            continue
+        return regions, walls
+    return None
