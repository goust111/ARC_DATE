+        frame_bbox,
+        bottom_anchor,
+    ):
+        return None
+
+    expected = np.full_like(grid, BG)
+    frame_in = grid[fr0 : fr1 + 1, fc0 : fc1 + 1]
+    frame_out = expected[fr0 : fr1 + 1, fc0 : fc1 + 1]
+    frame_out[frame_in != BG] = frame_in[frame_in != BG]
+    for spec in specs:
