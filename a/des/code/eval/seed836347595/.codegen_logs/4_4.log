+
+def _candidate_placements(
+    allowed: np.ndarray,
+    blocked: np.ndarray,
+    shape: tuple[tuple[int, int], ...],
+) -> list[list[tuple[int, int]]]:
+    h, w = allowed.shape
+    max_r = max(r for r, _ in shape)
