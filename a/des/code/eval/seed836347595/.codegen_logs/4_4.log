+        "conflict": big_fg & overlay_fg & (big != overlay),
+        "big_only": big_fg & ~overlay_fg,
+        "small_only": overlay_fg & ~big_fg,
+    }
+
+
+def _build_attempt() -> np.ndarray | None:
+    orientation, big_side, big_shape, zone_shape = _sample_geometry()
