+def _merge_layers(base: np.ndarray, overlay: np.ndarray) -> np.ndarray:
+    out = base.copy()
+    base_fg = base != BLACK
+    overlay_fg = overlay != BLACK
+
+    only_overlay = overlay_fg & ~base_fg
+    conflicts = overlay_fg & base_fg & (overlay != base)
