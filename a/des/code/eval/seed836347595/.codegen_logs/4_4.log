    """Return all valid (r0, c0, fallback_cells) placements for a h x w marker, cached."""
    key = (h, w)
    if key not in _PLACEMENT_CACHE:
        placements: list[tuple[int, int, list[tuple[int, int]]]] = []
        for r0 in range(_N - h + 1):
