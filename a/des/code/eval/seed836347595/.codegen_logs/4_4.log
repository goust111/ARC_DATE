+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        inp = _build_attempt()
+        if inp is not None:
+            return inp
+    raise RuntimeError("failed to generate a valid dashed-fold puzzle input")

