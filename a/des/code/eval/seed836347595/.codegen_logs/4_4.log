+            folded = np.fliplr(left)
+            overlay = np.zeros_like(big)
+            overlay[:, : left.shape[1]] = folded
+
+    assert GREY not in set(map(int, big.ravel())), "grey is reserved for the fold line"
+    return _merge_layers(big, overlay)
+
+
+def _zone_slice(
