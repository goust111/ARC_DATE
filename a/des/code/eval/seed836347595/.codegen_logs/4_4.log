+            big_coords = _map_zone_coords(coords, big_shape, small_span, orientation, big_side)
+            _mark_blocked(blocked_big, big_coords)
+            _paint(big, big_coords, color)
+            _paint(overlay_zone, coords, color)
+        elif mode == "conflict":
