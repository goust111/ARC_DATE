+                    ok = False
+                    break
+                edge = nz[0]
+                color = int(tile[edge])
+                direction = _EDGE_TO_DIR[edge]
+                if color in mapping or direction in seen_dirs:
+                    ok = False
+                    break
+                mapping[color] = direction
+                seen_dirs.add(direction)
