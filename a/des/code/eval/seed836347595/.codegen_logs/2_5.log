+    start = {(r, c): int(g[r, c]) for r, c in seed}
+    grown, _ = _grow_pattern(start, directions, g.shape)
+
+    out = g.copy()
+    for (r, c), color in grown.items():
+        if not reserved[r, c]:
+            out[r, c] = color
+    return out
