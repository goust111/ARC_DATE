+    (0, 1): (-1, 0),
+    (1, 2): (0, 1),
+    (2, 1): (1, 0),
+    (1, 0): (0, -1),
+}
+_DIR_TO_EDGE = {direction: edge for edge, direction in _EDGE_TO_DIR.items()}
+_LEGEND_TILES = ((0, 0), (0, 3), (3, 0), (3, 3))
