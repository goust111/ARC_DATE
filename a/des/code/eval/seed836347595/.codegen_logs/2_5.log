+            mapping: dict[int, tuple[int, int]] = {}
+            seen_dirs: set[tuple[int, int]] = set()
+            ok = True
+            for tr, tc in _LEGEND_TILES:
+                tile = patch[tr : tr + 3, tc : tc + 3]
+                if int(tile[1, 1]) != _BG:
+                    ok = False
