+        inner_h = er1 - er0 - 1
+        inner_w = ec1 - ec0 - 1
+        sh, sw = rotated.shape
+        top = er0 + 1 + (inner_h - sh) // 2
+        left = ec0 + 1 + (inner_w - sw) // 2
+        rr, cc = np.nonzero(rotated)
