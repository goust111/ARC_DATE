+import random
+from typing import Optional
+
+import numpy as np
+
+
+BG = 0
+YELLOW = 4
+COLOR_POOL = [1, 2, 3, 5, 6, 7, 8, 9]
+SIDE_ORDER = ["up", "left", "down", "right"]
+GEN_RETRIES = 300
+PLACE_RETRIES = 250
