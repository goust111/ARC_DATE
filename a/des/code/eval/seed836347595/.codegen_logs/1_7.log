+        else:
+            built = _build_band_program(band, width, 0, width - 1)
+            if built is None:
+                return None
+            start, steps = built
+        starts[int(color)] = tuple(map(int, start))
+        programs.append((int(color), steps))
+
+    return programs, starts
+
