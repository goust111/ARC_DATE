+            if extra is None:
+                continue
+            start_c, steps_c = extra
+            starts[int(colors[2])] = tuple(map(int, start_c))
+            programs.append((colors[2], steps_c))
+
+        return programs, starts
+
+    return None
+
+
+def _build_no_cross_scene(
