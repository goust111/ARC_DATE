+def _row_bands(height: int, count: int) -> list[tuple[int, int]] | None:
+    band_heights = [random.randint(2, 3) for _ in range(count)]
+    required = sum(band_heights) + (count - 1)
+    if required > height:
+        return None
+
+    extra = height - required
+    slots = [0] * (count + 1)
