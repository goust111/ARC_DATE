+def _separator_row(grid: np.ndarray) -> int:
+    rows = [r for r in range(grid.shape[0]) if np.all(grid[r, :] == DIVIDER)]
+    assert len(rows) == 1, "expected one full-width grey divider row"
+    return int(rows[0])
