+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 8
+DIVIDER = 5
+MIX = 9
+
+LEFT = 1
+DOWN = 2
+RIGHT = 3
+UP = 4
+
+DIR_TO_DELTA = {
+    LEFT: (0, -1),
+    DOWN: (1, 0),
+    RIGHT: (0, 1),
+    UP: (-1, 0),
+}
+
+BRUSH_COLORS = [0, 6, 7]
+GEN_RETRIES = 300
