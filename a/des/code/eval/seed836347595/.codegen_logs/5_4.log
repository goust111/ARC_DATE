+    expected = _build_expected(objects)
+    actual = main(grid)
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate input after {GEN_ATTEMPTS} attempts")

