+                        stack.append((nr, nc))
+            bbox = _bbox_from_coords(coords)
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": bbox,
+                    "mask": _mask_from_coords(coords),
+                }
+            )
