+                    placed = True
+                    break
+            if not placed:
+                return None
+        obj["sort_key"] = (
+            min(obj["part_0_bbox"][0], obj["part_1_bbox"][0]),
+            min(obj["part_0_bbox"][1], obj["part_1_bbox"][1]),
+        )
