+        for r, c in hole_positions:
+            shape[r, c] = False
+        parts = _grow_partition(shape)
+        if parts is None:
+            continue
+        mask_a, mask_b = parts
+        recon, recon_holes = _reconstruct_pair(_mask_from_coords([(r, c) for r, c in np.argwhere(mask_a)]), _mask_from_coords([(r, c) for r, c in np.argwhere(mask_b)]), color)
