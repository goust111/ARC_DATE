+import random
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MAROON = 9
+FRAGMENT_COLORS = (1, 2, 3, 4, 6, 7, 8)
+MAX_GENERATION_ATTEMPTS = 400
