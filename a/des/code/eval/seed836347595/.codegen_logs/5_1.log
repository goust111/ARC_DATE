+
+def _find_bottom_palette(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    if h < 2:
+        return []
+    tiles = []
+    for c in range(w - 1):
+        sub = grid[h - 2 : h, c : c + 2]
+        ok, base, shape = _is_palette_tile(sub)
+        if not ok:
+            continue
+        if c > 0 and np.any(grid[h - 2 : h, c - 1] != BLACK):
+            continue
+        if c + 2 < w and np.any(grid[h - 2 : h, c + 2] != BLACK):
