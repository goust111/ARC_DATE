+    mapping: dict[tuple[tuple[int, int], bytes], int] = {}
+    for tile in tiles:
+        key = _mask_key(tile["shape"])
+        assert key not in mapping, "palette shape keys must be unique"
+        mapping[key] = int(tile["color"])
+    return mapping, tiles
