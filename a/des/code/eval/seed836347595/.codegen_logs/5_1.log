+                out[r0 : r1 + 1, c1] = recolor
+                out[r0, c0 : c1 + 1] = recolor
+                out[r1, c0 : c1 + 1] = recolor
+
+            _mark_box(occupied, r0, c0, r1, c1, pad=1)
