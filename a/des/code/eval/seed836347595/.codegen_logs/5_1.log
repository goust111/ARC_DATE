+            r0 = random.randint(1, max_r1 - outer_h + 1)
+            c0 = random.randint(1, max_c1 - outer_w + 1)
+            r1 = r0 + outer_h - 1
+            c1 = c0 + outer_w - 1
+            if not _available_box(occupied, r0, c0, r1, c1, pad=1):
+                continue
