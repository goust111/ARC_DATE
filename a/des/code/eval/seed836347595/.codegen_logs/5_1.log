+            placed = True
+            break
+        if not placed:
+            return None
+
+    if not np.any(out != BLACK):
+        return None
+    return grid, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        case = _make_case()
+        if case is not None:
+            return case[0]
+    raise RuntimeError("failed to generate a valid input")

