+    out = g.copy()
+    for fence in fences:
+        r0, c0, r1, c1 = fence["bbox"]
+        interior = g[r0 + 1 : r1, c0 + 1 : c1]
+        shape_mask = (interior != BLACK) & (interior != GREY)
