+                inner[mask] = shape_color
+                out_inner = out[r0 + 1 : r1, c0 + 1 : c1]
+                out_inner[mask] = shape_color
+                recolor = shape_to_palette[name]
+                out[r0 : r1 + 1, c0] = recolor
+                out[r0 : r1 + 1, c1] = recolor
+                out[r0, c0 : c1 + 1] = recolor
