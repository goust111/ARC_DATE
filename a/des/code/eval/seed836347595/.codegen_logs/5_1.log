+        r0, c0, r1, c1 = _bbox(comp)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 4 or w < 4:
+            continue
+        local = np.zeros((h, w), dtype=bool)
+        for r, c in comp:
+            local[r - r0, c - c0] = True
+        ring = np.zeros((h, w), dtype=bool)
+        ring[0, :] = True
+        ring[-1, :] = True
+        ring[:, 0] = True
+        ring[:, -1] = True
+        if np.array_equal(local, ring):
