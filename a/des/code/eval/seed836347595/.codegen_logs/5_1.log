+            grid[r0 : r1 + 1, c1] = GREY
+            grid[r0, c0 : c1 + 1] = GREY
+            grid[r1, c0 : c1 + 1] = GREY
+            out[r0 : r1 + 1, c0] = GREY
+            out[r0 : r1 + 1, c1] = GREY
+            out[r0, c0 : c1 + 1] = GREY
+            out[r1, c0 : c1 + 1] = GREY
+
+            if spec["shape"] is not None:
