+def _neighbors(mask: np.ndarray, cell: Coord) -> list[Coord]:
+    h, w = mask.shape
+    r, c = cell
+    out: list[Coord] = []
+    for dr, dc in DIR4:
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < h and 0 <= cc < w and bool(mask[rr, cc]):
+            out.append((rr, cc))
+    return out
