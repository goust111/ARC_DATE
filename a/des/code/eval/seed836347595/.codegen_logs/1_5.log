+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SPECIAL_COLORS = {BLACK, BLUE, RED, GREEN, GREY, MAROON}
+CAR_COLORS = [YELLOW, PINK, ORANGE, CYAN]
