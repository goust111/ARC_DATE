+    for r in range(r0 + 1, r1 + 1):
+        cells.append((r, c1))
+    for c in range(c1 - 1, c0 - 1, -1):
+        cells.append((r1, c))
+    for r in range(r1 - 1, r0, -1):
+        cells.append((r, c0))
+    return cells
+
+
+def _rect_role(rect: Rect, cell: Coord) -> str:
+    r0, c0, r1, c1 = rect
