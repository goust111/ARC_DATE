+            cell_color = int(g[curr])
+            if cell_color == GREEN:
+                dest_track = analysis["cell_to_tracks"][curr]
+                assert len(dest_track) == 1
+                routed.append(
+                    {
+                        "color": int(track["color"]),
+                        "start_track": int(track["track_id"]),
+                        "start": track["car"],
+                        "arrow": track["arrow"],
+                        "dest": curr,
+                        "dest_track": int(dest_track[0]),
+                    }
+                )
+                break
