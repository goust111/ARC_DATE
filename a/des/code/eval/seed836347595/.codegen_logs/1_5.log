+    out = analysis["grid"].copy()
+    for track in analysis["tracks"]:
+        out[track["car"]] = GREY
+        out[track["arrow"]] = GREY
+
+    destinations = [item["dest"] for item in routed]
+    assert len(set(destinations)) == len(destinations), "cars must stop on distinct stations"
+    for item in routed:
