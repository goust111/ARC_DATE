+                family == other_family and _bbox_intersects(rect, other_rect, pad=1)
+                for other_rect, other_family in zip(rects, rect_families)
+            ):
+                continue
+
+            trial = rects + [rect]
+            info = _layout_info(trial, height, width)
+            if info is None:
+                continue
+
+            if rects:
