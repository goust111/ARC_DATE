RECT_ATTEMPTS = 240

Coord = tuple[int, int]
Rect = tuple[int, int, int, int]


def _add(a: Coord, b: Coord) -> Coord:
    return a[0] + b[0], a[1] + b[1]


def _sub(a: Coord, b: Coord) -> Coord:
    return a[0] - b[0], a[1] - b[1]


def _neg(a: Coord) -> Coord:
    return -a[0], -a[1]


def _neighbors(mask: np.ndarray, cell: Coord) -> list[Coord]:
    h, w = mask.shape
