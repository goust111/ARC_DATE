+                touches_existing = any(
+                    any(track_id == new_track_id for track_id, _role in owners)
+                    for cell, owners in info["entries"].items()
+                    if len(owners) == 2
+                )
+                if not touches_existing:
+                    continue
+
+            rects.append(rect)
+            rect_families.append(family)
