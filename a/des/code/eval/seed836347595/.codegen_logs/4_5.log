+        np.all(sub[0, :] == color)
+        and np.all(sub[-1, :] == color)
+        and np.all(sub[:, 0] == color)
+        and np.all(sub[:, -1] == color)
+    )
+    if not border_ok:
+        return False, np.zeros_like(sub, dtype=bool)
+    cavity = _enclosed_background(sub)
