+import numpy as np
+
+
+BG = 0
+COLOR_POOL = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+
+FRAME_COUNT_CHOICES = (2, 3)
+PIECE_COUNT_CHOICES = (2, 3)
+PIECE_AREA_VALUES = (2, 3, 4, 5, 6, 7)
+
+GROUP_RETRIES = 160
+GEN_RETRIES = 400
