+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    rows = np.any(mask, axis=1)
+    cols = np.any(mask, axis=0)
+    assert rows.any() and cols.any()
+    return mask[np.ix_(rows, cols)]
