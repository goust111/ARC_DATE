+def _touches_union(occ: np.ndarray, piece: np.ndarray, top: int, left: int) -> bool:
+    ph, pw = piece.shape
+    for r in range(ph):
+        for c in range(pw):
+            if not piece[r, c]:
+                continue
+            gr = top + r
+            gc = left + c
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                nr = gr + dr
+                nc = gc + dc
+                if 0 <= nr < occ.shape[0] and 0 <= nc < occ.shape[1] and occ[nr, nc]:
+                    return True
