+def _extract_color_components(grid: np.ndarray, color: int) -> list[dict]:
+    comps: list[dict] = []
+    for idx, coords in enumerate(_components(grid == color)):
+        r0, c0, r1, c1 = _bbox(coords)
+        comps.append(
+            {
+                "id": idx,
+                "bbox": (r0, c0, r1, c1),
+                "mask": _mask_from_coords(coords),
