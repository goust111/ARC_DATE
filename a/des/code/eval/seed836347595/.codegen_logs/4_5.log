+        window = remaining[best["r"] : best["r"] + ph, best["c"] : best["c"] + pw].copy()
+        window[best["mask"]] = False
+        remaining[best["r"] : best["r"] + ph, best["c"] : best["c"] + pw] = window
+        placements.append(
+            {
+                "id": info["id"],
+                "r": best["r"],
+                "c": best["c"],
+                "mask": best["mask"],
+            }
+        )
