+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Sort scattered monochrome fragments by color, rotate them, and place them into
+    same-colored frame cavities from largest area to smallest.
+    """
+    g = np.asarray(grid, dtype=int)
