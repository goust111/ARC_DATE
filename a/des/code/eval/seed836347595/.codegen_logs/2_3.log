  93: def main(grid: np.ndarray) -> np.ndarray:
  94:     """
  95:     Complete a four-corner framed rectangle from one decorated anchor rectangle and its diagonal mate.
  96: 
  97:     Input structure:
  98:     - The background is the dominant color.
  99:     - Two same-color solid rectangular anchors of the same size sit on opposite
 100:       diagonal corners, with the first anchor above-left of the second.
 101:     - The upper-left anchor has two one-cell-thick vertical control bars to its
 102:       right and two one-cell-thick horizontal control bars below it.
 103: 
 104:     Rule:
 105:     - Copy the anchor rectangle into the two missing corners of the implied
 106:       larger rectangle.
 107:     - Repeat the right-side control bars horizontally between the left and right
 108:       anchors, using their spacing as the period, and draw the outer top and
 109:       bottom borders in the first right-control color.
 110:     - Repeat the below-side control bars vertically between the top and bottom
 111:       anchors, using the same period, and draw the outer left and right borders
 112:       in the first below-control color.
 113: 
 114:     Key insight: The small control bars are the first two ticks of two periodic
 115:     frame patterns; the diagonal anchor supplies the opposite corner and the
 116:     missing two anchor copies.
 117:     """
 118:     g = np.asarray(grid, dtype=int)
 119:     bg = get_bg(g)
 120:     source, dest, right_controls, below_controls = _find_structure(g, bg)
 121: 
 122:     sr0, sc0, sr1, sc1 = source["bbox"]
 123:     dr0, dc0, dr1, dc1 = dest["bbox"]
 124:     anchor_color = int(source["color"])
 125:     assert int(dest["color"]) == anchor_color, "anchor colors must match"
 126:     assert bbox_h(source["bbox"]) == bbox_h(dest["bbox"]), "anchor heights must match"
 127:     assert bbox_w(source["bbox"]) == bbox_w(dest["bbox"]), "anchor widths must match"
 128:     assert sr0 > 0 and sc0 > 0, "upper-left anchor must have space for outer frame"
 129:     assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], "lower-right anchor must have space for outer frame"
 130: 
 131:     right_offsets = [int(comp["bbox"][1] - sc1) for comp in right_controls]
 132:     below_offsets = [int(comp["bbox"][0] - sr1) for comp in below_controls]
 133:     assert right_offsets == below_offsets and right_offsets[0] == 1, "control offsets must match from the anchor edge"
 134:     step = int(right_offsets[1] - right_offsets[0])
 135:     assert step > 0, "control bars must be separated"
 136:     period = 2 * step
 137:     assert (dc0 - 1 - sc1 - right_offsets[0]) % period == 0, "right frame must close next to the destination anchor"
 138:     assert (dr0 - 1 - sr1 - below_offsets[0]) % period == 0, "below frame must close next to the destination anchor"
 139: 
 140:     right_colors = [int(comp["color"]) for comp in right_controls]
 141:     below_colors = [int(comp["color"]) for comp in below_controls]
 142:     out = g.copy()
 143: 
 144:     _paint_rect(out, bg, sr0, dc0, sr1, dc1, anchor_color)
 145:     _paint_rect(out, bg, dr0, sc0, dr1, sc1, anchor_color)
 146: 
 147:     first_c = int(sc1 + right_offsets[0])
 148:     last_c = int(dc0 - 1)
 149:     for c in range(first_c, last_c + 1):
 150:         offset = int(c - sc1)
 151:         if (offset - right_offsets[0]) % period == 0:
 152:             color = right_colors[0]
 153:         elif (offset - right_offsets[1]) % period == 0:
 154:             color = right_colors[1]
 155:         else:
 156:             continue
