+def _sprite_components(
+    grid: np.ndarray,
+    frame_color: int,
+    bbox: tuple[int, int, int, int],
+) -> tuple[list[np.ndarray], dict[tuple[int, int], int]]:
+    r0, c0, r1, c1 = bbox
