+            rr = row + int(dr)
+            cc = col + int(dc)
+            assert 0 < rr < h and 0 < cc < w, "stamped copy must stay inside the interior"
+            base = int(g[rr, cc])
+            assert base == bg or (rr, cc) in line_cells, "stamped copy must not overwrite source stamps or rulers"
