+def _render(objects: list[dict], h: int, w: int) -> np.ndarray:
+    grid = np.full((h, w), BG, dtype=int)
+    for obj in objects:
+        grid[obj["r0"] : obj["r0"] + obj["h"], obj["c0"] : obj["c0"] + obj["w"]] = obj["color"]
+        for r, c in _arrow_cells(obj["r0"], obj["c0"], obj["h"], obj["w"], obj["dir"]):
+            grid[r, c] = RED
+    return grid
