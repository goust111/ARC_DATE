        elif 'left' in E and 'right' not in E: dv = 'L'
        elif 'right' in E and 'left' not in E: dv = 'R'
        else: dv = 'L'
        return dh, dv

    def touches_E(hs, vs):
        te = set()
        if hs in ('T','A'): te.add('top')
        if hs in ('B','A'): te.add('bottom')
        if vs in ('L','A'): te.add('left')
