+
+def _validate_generated(grid: np.ndarray, objects: list[dict]) -> bool:
+    try:
+        parsed, targets = _extract_scene(grid)
+    except AssertionError:
+        return False
+    by_color = {obj["color"]: obj for obj in parsed}
