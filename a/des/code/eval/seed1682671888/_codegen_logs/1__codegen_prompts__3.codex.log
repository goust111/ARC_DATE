+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _sample_case()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid room-push puzzle input")

