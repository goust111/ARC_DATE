+
+    if nonzero_rooms == 0:
+        rr, cc = rng.choice(room_cells)
+        r0 = wall_rows[rr] + 1
+        r1 = wall_rows[rr + 1] - 1
+        c0 = wall_cols[cc] + 1
+        c1 = wall_cols[cc + 1] - 1
+        side, door_r, door_c = door_info[(rr, cc)]
+        line = _line_cells(r0, r1, c0, c1, side, door_r, door_c)
+        free_line = [cell for cell in line if grid[cell] == BG]
+        if not free_line:
+            return None
+        grey_plan[(rr, cc)] = [rng.choice(free_line)]
