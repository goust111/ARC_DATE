+
+def _place_crossing_rect(
+    outer: tuple[int, int, int, int], inner: tuple[int, int, int, int], orient: str, max_area: int
+) -> tuple[int, int, int, int] | None:
+    or0, oc0, oh, ow = outer
+    ir0, ic0, ih, iw = inner
+    or1 = or0 + oh
+    oc1 = oc0 + ow
+    ir1 = ir0 + ih
+    ic1 = ic0 + iw
+    for _ in range(60):
+        if orient == "right":
+            boundary = ic0
+            a_span = boundary - oc0
+            x_span = oc1 - boundary
+            if a_span < 2 or x_span < 2:
+                continue
+            h_hi = min(ih, 6)
+            if h_hi < 3:
+                continue
+            h = _randint(3, h_hi)
+            r = _randint(ir0, ir1 - h)
+            left = _randint(1, min(a_span, 3))
+            right = _randint(1, min(x_span, 3))
+            w = left + right
+            if h * w >= max_area:
+                continue
+            c = boundary - left
+            return (r, c, h, w)
+        if orient == "left":
+            boundary = ic1
+            x_span = boundary - oc0
+            a_span = oc1 - boundary
+            if a_span < 2 or x_span < 2:
+                continue
+            h_hi = min(ih, 6)
+            if h_hi < 3:
+                continue
+            h = _randint(3, h_hi)
+            r = _randint(ir0, ir1 - h)
+            left = _randint(1, min(x_span, 3))
+            right = _randint(1, min(a_span, 3))
+            w = left + right
+            if h * w >= max_area:
+                continue
+            c = boundary - left
+            return (r, c, h, w)
+        if orient == "down":
+            boundary = ir0
+            a_span = boundary - or0
+            x_span = or1 - boundary
+            if a_span < 2 or x_span < 2:
+                continue
+            w_hi = min(iw, 6)
+            if w_hi < 3:
+                continue
+            w = _randint(3, w_hi)
+            c = _randint(ic0, ic1 - w)
+            top = _randint(1, min(a_span, 3))
+            bottom = _randint(1, min(x_span, 3))
+            h = top + bottom
+            if h * w >= max_area:
+                continue
+            r = boundary - top
+            return (r, c, h, w)
+        boundary = ir1
+        x_span = boundary - or0
+        a_span = or1 - boundary
+        if a_span < 2 or x_span < 2:
+            continue
+        w_hi = min(iw, 6)
+        if w_hi < 3:
+            continue
+        w = _randint(3, w_hi)
+        c = _randint(ic0, ic1 - w)
+        top = _randint(1, min(x_span, 3))
+        bottom = _randint(1, min(a_span, 3))
+        h = top + bottom
+        if h * w >= max_area:
+            continue
+        r = boundary - top
+        return (r, c, h, w)
