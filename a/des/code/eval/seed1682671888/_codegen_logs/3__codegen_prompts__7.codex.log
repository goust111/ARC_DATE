+
+
+def _place_crossing_rect(
+    outer: tuple[int, int, int, int], inner: tuple[int, int, int, int], orient: str, max_area: int
+) -> tuple[int, int, int, int] | None:
+    or0, oc0, oh, ow = outer
+    ir0, ic0, ih, iw = inner
+    or1 = or0 + oh
+    oc1 = oc0 + ow
+    ir1 = ir0 + ih
+    ic1 = ic0 + iw
+    for _ in range(60):
+        if orient == "right":
+            boundary = ic0
+            a_span = boundary - oc0
+            x_span = oc1 - boundary
+            if a_span < 2 or x_span < 2:
