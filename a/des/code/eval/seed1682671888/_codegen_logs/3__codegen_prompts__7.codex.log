+def _composite(
+    shape: tuple[int, int],
+    rects: list[dict[str, int | tuple[int, int, int, int]]],
+    recipe: dict[tuple[int, int], int],
+) -> np.ndarray:
+    out = np.zeros(shape, dtype=int)
+    for rect in rects:
+        color = int(rect["color"])
