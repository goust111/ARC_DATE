+                depth = rng.randint(1, max_depth)
+                r0 = rng.randint(1, h - 3)
+                r1 = rng.randint(r0 + 1, h - 2)
+                if edge == "left":
+                    mask[r0 : r1 + 1, 0:depth] = False
+                else:
+                    mask[r0 : r1 + 1, w - depth : w] = False
