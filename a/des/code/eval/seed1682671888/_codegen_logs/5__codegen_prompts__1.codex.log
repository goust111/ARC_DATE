+def _render_legend(
+    entries: list[dict[str, object]], bg: int, frame_color: int
+) -> np.ndarray:
+    n = len(entries)
+    inner_h = 4 * n - 1
+    inner_w = 9
+    inner = np.full((inner_h, inner_w), bg, dtype=int)
+    for idx, entry in enumerate(entries):
+        rs = idx * 4
+        template = entry["template"]
+        template_color = int(entry["template_color"])
