+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _dominant_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[int(np.argmax(counts))])
+
+
+def _tight_mask(points: list[tuple[int, int]]) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(points)
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in points:
+        out[r - r0, c - c0] = True
+    return out
+
+
+def _normalize_signature(cells: list[tuple[int, int, int]]) -> tuple[tuple[int, int, int], ...]:
+    rows = [r for r, _, _ in cells]
+    cols = [c for _, c, _ in cells]
+    r0 = min(rows)
+    c0 = min(cols)
+    return tuple(sorted((r - r0, c - c0, col) for r, c, col in cells))
