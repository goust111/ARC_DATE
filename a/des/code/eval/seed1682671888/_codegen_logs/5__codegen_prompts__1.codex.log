+def _can_place(occ: np.ndarray, r0: int, c0: int, h: int, w: int, gap: int) -> bool:
+    rr0 = max(0, r0 - gap)
+    cc0 = max(0, c0 - gap)
+    rr1 = min(occ.shape[0], r0 + h + gap)
+    cc1 = min(occ.shape[1], c0 + w + gap)
+    return not occ[rr0:rr1, cc0:cc1].any()
