+        return mask
+    return None
+
+
+def _place_signature(
+    interior: np.ndarray, signature: list[tuple[int, int, int]], rng: random.Random
+) -> list[tuple[int, int, int]] | None:
+    sig_h = max(r for r, _, _ in signature) + 1
+    sig_w = max(c for _, c, _ in signature) + 1
