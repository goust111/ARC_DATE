+def _build_case(rng: random.Random) -> tuple[np.ndarray, np.ndarray] | None:
+    h = rng.randint(24, 31)
+    w = rng.randint(24, 31)
+    all_colors = list(range(10))
+    bg, border_color, legend_frame = rng.sample(all_colors, 3)
