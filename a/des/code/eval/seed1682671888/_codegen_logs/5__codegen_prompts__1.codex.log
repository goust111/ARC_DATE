+        return False
+    expected = 2 * (h + w) - 4
+    if len(points) != expected:
+        return False
+    pset = set(points)
+    for r in range(r0, r1 + 1):
+        if (r, c0) not in pset or (r, c1) not in pset:
+            return False
+    for c in range(c0, c1 + 1):
