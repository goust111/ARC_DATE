+    np.array([[1, 0, 0], [1, 0, 0], [1, 1, 1]], dtype=bool),  # L
+    np.array([[1, 1, 1], [0, 1, 0], [0, 1, 0]], dtype=bool),  # T
+    np.array([[1, 0, 1], [1, 0, 1], [1, 1, 1]], dtype=bool),  # U
+    np.array([[0, 1, 1], [1, 1, 0], [1, 0, 0]], dtype=bool),  # zig
