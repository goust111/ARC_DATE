+
+    occ = np.zeros((h, w), dtype=bool)
+    _mark_occ(occ, legend_r0, legend_c0, legend.shape[0], legend.shape[1])
+    region_count = rng.randint(2, 4)
+
+    if region_count == 4:
+        size_choices = [2, 3]
+    elif region_count == 3:
+        size_choices = [2, 3, 4]
+    else:
+        size_choices = [3, 4, 5]
+    for _ in range(region_count):
