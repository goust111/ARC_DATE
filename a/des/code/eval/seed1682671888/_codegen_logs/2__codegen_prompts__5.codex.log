+    if mask_cells is None:
+        return None
+    if sum(cell in non_tower_coverage for cell in mask_cells) < 2:
+        return None
+
+    grid = np.zeros((height, width), dtype=int)
+    for tower in towers:
+        _draw_tower(grid, tower)
+    for r, c in mask_cells:
