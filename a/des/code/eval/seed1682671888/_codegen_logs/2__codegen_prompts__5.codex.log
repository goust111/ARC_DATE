+        towers.append({"center": (bottom_row, col), "color": colors[2], "antennas": _ordered_antennas(("up",))})
+    return towers
+
+
+def _forbidden_near_towers(towers: list[dict], height: int, width: int) -> set[tuple[int, int]]:
