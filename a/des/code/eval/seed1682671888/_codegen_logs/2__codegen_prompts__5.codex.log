+        return None
+
+    mixed_colors = {MAGENTA, YELLOW, AZURE}
+    if scenario == "triple":
+        if int((out == BROWN).sum()) == 0:
+            return None
+    else:
+        if int(sum((out == color).sum() for color in mixed_colors)) == 0:
+            return None
+
+    if int((grid == GRAY).sum()) < 4:
+        return None
+    return grid
