+    if actual_pairs != expected_pairs:
+        return None
+    if len(meta["filled_regions"]) != num_polygons:
+        return None
+    if actual_counts != sorted(expected_yellow_counts):
+        return None
+    if not np.any(out == BLUE) and not np.any(out == RED):
