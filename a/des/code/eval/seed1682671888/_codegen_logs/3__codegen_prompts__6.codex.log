+INPUT_COLORS = (1, 2, 3, 6, 7, 8, 9)
+BODY_COLORS = (3, 6, 7, 8, 9)
+
+GRID_H_RANGE = (18, 31)
+GRID_W_RANGE = (18, 31)
+NUM_POLYGONS_OPTIONS = (1, 2)
+NUM_DISTRACTORS_RANGE = (0, 3)
+RECT_SIDE_RANGE = (5, 11)
+PLACEMENT_PADDING = 2
+DISTRACTOR_LENGTH_RANGE = (3, 7)
+GENERATION_ATTEMPTS = 400
+PLACEMENT_ATTEMPTS = 120
