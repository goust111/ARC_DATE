+def _generate_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(*GRID_H_RANGE)
+    w = rng.randint(*GRID_W_RANGE)
+    grid = np.full((h, w), BG, dtype=int)
+    occupied = np.zeros((h, w), dtype=bool)
