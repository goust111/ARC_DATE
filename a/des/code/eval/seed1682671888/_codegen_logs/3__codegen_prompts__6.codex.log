+def _path_is_clear(grid: np.ndarray, p0: tuple[int, int], p1: tuple[int, int]) -> bool:
+    r0, c0 = p0
+    r1, c1 = p1
+    if r0 == r1:
+        lo, hi = sorted((c0, c1))
+        if hi - lo < 1:
+            return False
+        if hi - lo == 1:
+            return True
+        return bool(np.all(grid[r0, lo + 1 : hi] == BG))
+    if c0 == c1:
+        lo, hi = sorted((r0, r1))
+        if hi - lo < 1:
