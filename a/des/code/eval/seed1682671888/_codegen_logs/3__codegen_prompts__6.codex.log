+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _find_segments(grid: np.ndarray) -> list[dict]:
+    mask = (grid != BG) & (grid != YELLOW)
+    segments: list[dict] = []
+    for comp in _components(mask):
+        if len(comp) < 2:
+            continue
+        rows = [r for r, _ in comp]
+        cols = [c for _, c in comp]
+        if len(set(rows)) == 1:
+            row = rows[0]
+            ordered = sorted(comp, key=lambda p: p[1])
+            expected = list(range(ordered[0][1], ordered[-1][1] + 1))
+            if [c for _, c in ordered] != expected:
+                continue
+            axis = "h"
+        elif len(set(cols)) == 1:
+            col = cols[0]
+            ordered = sorted(comp, key=lambda p: p[0])
+            expected = list(range(ordered[0][0], ordered[-1][0] + 1))
+            if [r for r, _ in ordered] != expected:
+                continue
+            axis = "v"
+        else:
+            continue
+
+        endpoints = [ordered[0], ordered[-1]]
+        endpoint_colors = [int(grid[p]) for p in endpoints]
+        segments.append(
+            {
+                "coords": ordered,
+                "axis": axis,
+                "endpoints": endpoints,
+                "endpoint_colors": endpoint_colors,
+            }
+        )
+    return segments
