+            endpoints.append({"seg_id": seg_id, "coord": endpoint, "color": color})
+
+    by_color: dict[int, list[int]] = {}
+    for idx, endpoint in enumerate(endpoints):
+        by_color.setdefault(endpoint["color"], []).append(idx)
