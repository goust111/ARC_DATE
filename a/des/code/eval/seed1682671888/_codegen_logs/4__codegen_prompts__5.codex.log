+GEN_RETRIES = 400
+GRID_H_RANGE = (15, 24)
+GRID_W_RANGE = (15, 24)
+PAIR_COUNT_CHOICES = (1, 2, 3)
+DISTRACTOR_COUNT_CHOICES = (0, 1, 2)
+MAX_PAIR_PLACEMENT_TRIES = 300
+MAX_DISTRACTOR_TRIES = 200
