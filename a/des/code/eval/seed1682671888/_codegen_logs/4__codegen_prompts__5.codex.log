+    arrow_infos: list[dict] = []
+    arrow_mask = np.zeros_like(g, dtype=bool)
+    for color in np.unique(g):
+        color = int(color)
+        if color == bg:
+            continue
+        comps = _components(g == color, connectivity=8)
+        if len(comps) != 2:
