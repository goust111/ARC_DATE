+    object_mask = (g != bg) & (~arrow_mask)
+    comps = _components(object_mask, connectivity=4)
+    coord_to_comp: dict[tuple[int, int], int] = {}
+    for idx, comp in enumerate(comps):
+        for cell in comp:
+            coord_to_comp[cell] = idx
