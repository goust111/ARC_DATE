+            dst_dr, dst_dc = DIRS[target_dir]
+            src_anchor = (src_center[0] + 2 * src_dr, src_center[1] + 2 * src_dc)
+            dst_anchor = (dst_center[0] + 2 * dst_dr, dst_center[1] + 2 * dst_dc)
