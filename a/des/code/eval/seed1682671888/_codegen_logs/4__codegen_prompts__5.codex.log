+            _paint_shape(inp, src_anchor, src_shape)
+            _paint_shape(out, dst_anchor, dst_shape)
+            for r, c in src_arrow | dst_arrow:
+                inp[r, c] = int(arrow_color)
+            reserved |= _halo(footprint, (h, w))
