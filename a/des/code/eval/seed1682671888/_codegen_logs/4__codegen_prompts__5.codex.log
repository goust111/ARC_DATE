+    min_c = min(c for _, c in cells)
+    color_count = min(len(palette), rng.randint(1, 2))
+    colors = rng.sample(palette, color_count)
+    return [(r - min_r, c - min_c, int(rng.choice(colors))) for r, c in sorted(cells)]
