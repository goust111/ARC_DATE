+
+def _tile_starts(size: int, period: int, phase: int) -> list[int]:
+    start0 = (-phase) % period
+    starts = []
+    pos = start0
+    while pos + period <= size:
+        starts.append(pos)
+        pos += period
+    return starts
+
+
+def _boxes_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    return a[0] <= b[2] and b[0] <= a[2] and a[1] <= b[3] and b[1] <= a[3]
