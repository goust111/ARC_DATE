+def _pattern_pool(length: int) -> list[tuple[int, ...]]:
+    pairs: dict[tuple[int, ...], tuple[int, ...]] = {}
+    for bits_int in range(1, (1 << length) - 1):
+        bits = tuple((bits_int >> i) & 1 for i in range(length))
+        comp = _complement(bits)
+        key = min(bits, comp)
+        pairs[key] = key
+    return list(pairs.values())
+
