+        sl_r, sl_c = cell["slice"]
+        patch = out[sl_r, sl_c]
+        patch[np.asarray(cell["mask"], dtype=bool)] = int(cell["bg"])
+
+    for src, dst, (dr, dc) in valid_moves:
