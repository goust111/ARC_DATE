+GEN_RETRIES = 300
+CELL_SIZE_CHOICES = (5, 6)
+GRID_ROWS_RANGE = (2, 4)
+GRID_COLS_RANGE = (2, 4)
+ARROW_COUNT_RANGE = (1, 4)
+PATTERN_AREA_RANGE = (2, 5)
+SOURCE_PATTERN_PROB = 0.7
+OTHER_PATTERN_PROB = 0.55
+ACCENT_COLOR_PROB = 0.5
