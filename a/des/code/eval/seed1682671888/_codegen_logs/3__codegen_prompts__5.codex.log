+    g = np.asarray(grid, dtype=int)
+    row_cells, col_cells = _find_cell_layout(g)
+    cell_h = row_cells[0][1] - row_cells[0][0]
+    cell_w = col_cells[0][1] - col_cells[0][0]
+
+    info: dict[tuple[int, int], dict[str, object]] = {}
