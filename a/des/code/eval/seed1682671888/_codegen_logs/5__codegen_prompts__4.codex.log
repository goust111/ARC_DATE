+            block_sets = [bc0, bc1]
+            endpoint_touch: dict[tuple[int, int], int] = {}
+            ok = True
+            for cell in path_cells:
+                touch = {
+                    idx
+                    for idx, block in enumerate(block_sets)
+                    if any(nb in block for nb in _neighbors4(*cell))
