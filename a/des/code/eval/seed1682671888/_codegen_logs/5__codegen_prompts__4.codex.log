+            dirs = []
+            for a, b in zip(traced, traced[1:]):
+                dr = int(b[0] - a[0])
+                dc = int(b[1] - a[1])
+                dirs.append(DIR_FROM_DELTA[(dr, dc)])
+            candidates.append(
