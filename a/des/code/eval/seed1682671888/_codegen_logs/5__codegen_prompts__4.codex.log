+    cur = start
+    while True:
+        nxt = [p for p in _neighbors4(*cur) if p in path_cells and p != prev]
+        if not nxt:
+            break
+        assert len(nxt) == 1, "path must not branch"
+        prev, cur = cur, nxt[0]
+        path.append(cur)
