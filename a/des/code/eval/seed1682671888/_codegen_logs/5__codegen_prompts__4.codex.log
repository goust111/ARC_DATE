+    out[:, divider + 1 :] = bg
+    out[origin_r, origin_c] = origin_color
+
+    r, c = origin_r, origin_c
+    for item in instructions:
+        for d in item["dirs"]:
+            dr, dc = DIRS[d]
+            r += dr
+            c += dc
+            assert 0 <= r < h and divider + 1 <= c < w, "drawing left the canvas"
+            out[r, c] = int(item["color"])
