+                    continue
+                if sum((rr, cc) in used for rr, cc in _neighbors4(nr, nc)) != 1:
+                    continue
+                rows = [p[0] for p in path] + [nr]
+                cols = [p[1] for p in path] + [nc]
+                if max(rows) - min(rows) + 1 > max_span or max(cols) - min(cols) + 1 > max_span:
+                    continue
+                nbrs.append((nr, nc))
+            random.shuffle(nbrs)
+            for nr, nc in nbrs:
