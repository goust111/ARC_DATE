+        def dfs() -> bool:
+            if len(path) == num_cells:
+                return True
+            r, c = path[-1]
+            nbrs = []
+            dirs = list(DIRS.values())
+            random.shuffle(dirs)
+            for dr, dc in dirs:
+                nr, nc = r + dr, c + dc
