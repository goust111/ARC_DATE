+
+def _find_separator(grid: np.ndarray, bg: int) -> tuple[int, int]:
+    h, w = grid.shape
+    candidates: list[tuple[int, int]] = []
+    for c in range(1, w - 1):
+        col = grid[:, c]
+        value = int(col[0])
+        if value != bg and bool((col == value).all()):
+            candidates.append((c, value))
