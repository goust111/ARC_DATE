+def _scan_blocks(cells: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    blocks = []
+    for r, c in cells:
+        if _block_cells((r, c)).issubset(cells):
+            blocks.append((r, c))
+    return sorted(blocks)
