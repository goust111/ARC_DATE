+def _random_connected_mask(h: int, w: int, min_cells: int, max_cells: int) -> np.ndarray | None:
+    total = h * w
+    if total < min_cells:
+        return None
+    target = random.randint(min_cells, min(max_cells, total))
+    mask = np.zeros((h, w), dtype=bool)
