+    return None
+
+
+def _make_rot180_template(max_size: int) -> np.ndarray | None:
+    for _ in range(120):
+        h = random.randint(3, min(5, max_size))
+        w = random.randint(3, min(5, max_size))
+        qh = max(1, h // 2)
+        qw = max(1, w // 2)
+        base = _random_connected_mask(qh, qw, 1, max(1, qh * qw))
