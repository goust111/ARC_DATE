+    return None
+
+
+def _make_none_template(max_size: int) -> np.ndarray | None:
+    for _ in range(120):
+        h = random.randint(3, min(5, max_size))
+        w = random.randint(3, min(5, max_size))
+        mask = _random_connected_mask(h, w, 3, max(3, h * w - 1))
