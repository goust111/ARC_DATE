+
+def _make_horizontal_work(panel_size: int, color: int) -> np.ndarray | None:
+    side_h = panel_size // 2
+    base = _random_connected_mask(side_h, panel_size, panel_size, side_h * panel_size - 1)
+    if base is None:
+        return None
+    panel = np.full((panel_size, panel_size), BG, dtype=int)
