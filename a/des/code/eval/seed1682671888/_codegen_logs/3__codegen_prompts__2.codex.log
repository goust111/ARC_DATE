+def _paint_walls(
+    grid: np.ndarray,
+    row_seps: list[int],
+    col_seps: list[int],
+    horiz: list[list[int]],
+    vert: list[list[int]],
+) -> None:
+    m = len(row_seps) - 1
+    n = len(col_seps) - 1
+    for i in range(m + 1):
+        r = row_seps[i]
+        for j in range(n):
+            c0, c1 = col_seps[j], col_seps[j + 1]
+            grid[r, c0 : c1 + 1] = horiz[i][j]
+    for i in range(m):
+        r0, r1 = row_seps[i], row_seps[i + 1]
+        for j in range(n + 1):
+            c = col_seps[j]
+            grid[r0 : r1 + 1, c] = vert[i][j]
+
+
+def _wall_segment_color(
+    room: tuple[int, int], side: str, horiz: list[list[int]], vert: list[list[int]]
