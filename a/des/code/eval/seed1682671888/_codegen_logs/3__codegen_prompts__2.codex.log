+        for side in ("top", "bottom", "left", "right"):
+            color = _wall_color(g, room, side)
+            assert color not in wall_by_color
+            wall_by_color[color] = side
+        for key in keys:
+            key_color = int(g[key])
+            assert key_color in wall_by_color
+            side = wall_by_color[key_color]
