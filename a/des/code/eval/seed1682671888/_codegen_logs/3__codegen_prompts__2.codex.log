+def _edge_side(a: tuple[int, int], b: tuple[int, int], owner: tuple[int, int]) -> str:
+    if a[0] == b[0]:
+        left = a if a[1] < b[1] else b
+        right = b if a[1] < b[1] else a
+        return "right" if owner == left else "left"
+    top = a if a[0] < b[0] else b
+    bottom = b if a[0] < b[0] else a
+    return "bottom" if owner == top else "top"
+
+
+def _paint_walls(
+    grid: np.ndarray,
+    row_seps: list[int],
+    col_seps: list[int],
+    horiz: list[list[int]],
+    vert: list[list[int]],
+) -> None:
+    m = len(row_seps) - 1
+    n = len(col_seps) - 1
+    for i in range(m + 1):
+        r = row_seps[i]
+        for j in range(n):
+            c0, c1 = col_seps[j], col_seps[j + 1]
+            grid[r, c0 : c1 + 1] = horiz[i][j]
+    for i in range(m):
+        r0, r1 = row_seps[i], row_seps[i + 1]
+        for j in range(n + 1):
+            c = col_seps[j]
+            grid[r0 : r1 + 1, c] = vert[i][j]
+
+
+def _wall_segment_color(
+    room: tuple[int, int], side: str, horiz: list[list[int]], vert: list[list[int]]
+) -> int:
+    r, c = room
+    if side == "top":
+        return horiz[r][c]
+    if side == "bottom":
+        return horiz[r + 1][c]
+    if side == "left":
+        return vert[r][c]
+    if side == "right":
+        return vert[r][c + 1]
+    raise ValueError(side)
+
+
+def _door_for_edge(
+    a: tuple[int, int],
+    b: tuple[int, int],
+    row_seps: list[int],
+    col_seps: list[int],
