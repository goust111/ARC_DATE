+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+WALL_COLORS = (1, 3, 4, 5, 6, 7, 8, 9)
+
+GEN_RETRIES = 300
+ROOM_ROWS_RANGE = (2, 4)
+ROOM_COLS_RANGE = (2, 4)
+ROOM_SPAN_CHOICES = (3, 4, 5, 6)
+OPEN_EXTRA_PROB = 0.2
+PREOPEN_PROB = 0.45
+REACH_ALL_PROB = 0.5
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _max_run(arr: np.ndarray) -> int:
+    best = cur = 0
+    for v in arr:
+        if v != BG:
+            cur += 1
+            best = max(best, cur)
+        else:
+            cur = 0
+    return best
+
+
+def _detect_separator_rows(grid: np.ndarray) -> list[int]:
+    rows = [r for r in range(grid.shape[0]) if _max_run(grid[r]) >= 3]
+    assert len(rows) >= 2
+    return rows
+
+
+def _detect_separator_cols(grid: np.ndarray) -> list[int]:
+    cols = [c for c in range(grid.shape[1]) if _max_run(grid[:, c]) >= 3]
+    assert len(cols) >= 2
+    return cols
+
+
+def _find_room_index(pos: int, seps: list[int]) -> int:
+    for i in range(len(seps) - 1):
+        if seps[i] < pos < seps[i + 1]:
+            return i
+    raise AssertionError("position is not inside a room")
+
+
+def _wall_color(grid: np.ndarray, room: dict, side: str) -> int:
