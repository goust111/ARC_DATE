+    seen = np.zeros_like(passable, dtype=bool)
+    q = deque(seed_cells)
+    for r, c in seed_cells:
+        seen[r, c] = True
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
