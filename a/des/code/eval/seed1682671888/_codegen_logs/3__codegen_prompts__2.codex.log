+            continue
+        if any(abs(a[0] - br) + abs(a[1] - bc) <= 1 for br, bc in blocked):
+            continue
+        if any(abs(b[0] - br) + abs(b[1] - bc) <= 1 for br, bc in blocked):
+            continue
+        return a, b
+    return None
+
