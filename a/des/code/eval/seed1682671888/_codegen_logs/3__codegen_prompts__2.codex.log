+import numpy as np
+
+
+BG = 0
+RED = 2
+WALL_COLORS = (1, 3, 4, 5, 6, 7, 8, 9)
+
+GEN_RETRIES = 300
+ROOM_ROWS_RANGE = (2, 4)
+ROOM_COLS_RANGE = (2, 4)
+ROOM_SPAN_CHOICES = (3, 4, 5, 6)
