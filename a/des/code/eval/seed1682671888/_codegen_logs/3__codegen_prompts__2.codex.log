+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+WALL_COLORS = (1, 3, 4, 5, 6, 7, 8, 9)
+
+GEN_RETRIES = 300
+ROOM_ROWS_RANGE = (2, 4)
+ROOM_COLS_RANGE = (2, 4)
+ROOM_SPAN_CHOICES = (3, 4, 5, 6)
+OPEN_EXTRA_PROB = 0.2
+PREOPEN_PROB = 0.45
+REACH_ALL_PROB = 0.5
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _max_run(arr: np.ndarray) -> int:
+    best = cur = 0
+    for v in arr:
+        if v != BG:
+            cur += 1
+            best = max(best, cur)
+        else:
+            cur = 0
+    return best
+
+
+def _detect_separator_rows(grid: np.ndarray, sep_cols: list[int] | None = None) -> list[int]:
+    rows = []
+    h, w = grid.shape
+    if sep_cols is None:
+        col_mask = np.zeros(w, dtype=bool)
+        count_threshold = max(5, int(np.ceil(0.6 * w)))
+        score_threshold = 4
+    else:
+        col_mask = np.zeros(w, dtype=bool)
+        col_mask[sep_cols] = True
+        interior_cols = [c for c in range(w) if not col_mask[c]]
+        count_threshold = max(3, int(np.ceil(0.5 * max(1, len(interior_cols)))))
+        score_threshold = 3
+    for r in range(h):
+        count = 0
+        score = 0
+        for c in range(w):
+            if col_mask[c]:
+                continue
+            if grid[r, c] == BG:
+                continue
+            count += 1
+            if (c > 0 and grid[r, c - 1] != BG) or (c + 1 < w and grid[r, c + 1] != BG):
+                score += 1
+        if count >= count_threshold and score >= score_threshold:
+            rows.append(r)
+    assert len(rows) >= 2
+    return rows
+
+
+def _detect_separator_cols(grid: np.ndarray, sep_rows: list[int]) -> list[int]:
+    cols = []
+    h, w = grid.shape
+    row_mask = np.zeros(h, dtype=bool)
+    row_mask[sep_rows] = True
+    interior_rows = [r for r in range(h) if not row_mask[r]]
+    count_threshold = max(3, int(np.ceil(0.5 * max(1, len(interior_rows)))))
+    for c in range(w):
+        count = 0
+        score = 0
+        for r in interior_rows:
+            if grid[r, c] == BG:
+                continue
+            count += 1
+            if (r > 0 and grid[r - 1, c] != BG) or (r + 1 < h and grid[r + 1, c] != BG):
+                score += 1
+        if count >= count_threshold and score >= 3:
+            cols.append(c)
+    assert len(cols) >= 2
+    return cols
+
+
+def _find_room_index(pos: int, seps: list[int]) -> int:
