+    if side == "top":
+        vals = [int(v) for v in grid[r0, c0 + 1 : c1] if int(v) != BG]
+    elif side == "bottom":
+        vals = [int(v) for v in grid[r1, c0 + 1 : c1] if int(v) != BG]
+    elif side == "left":
+        vals = [int(v) for v in grid[r0 + 1 : r1, c0] if int(v) != BG]
+    elif side == "right":
+        vals = [int(v) for v in grid[r0 + 1 : r1, c1] if int(v) != BG]
+    else:
