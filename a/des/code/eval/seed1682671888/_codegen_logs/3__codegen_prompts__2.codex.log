+        cs = [c for _, c in comp]
+        room_id = (_find_room_index(rs[0], sep_rows), _find_room_index(cs[0], sep_cols))
+        assert all((_find_room_index(r, sep_rows), _find_room_index(c, sep_cols)) == room_id for r, c in comp)
+        if len(comp) == 1:
