+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    row_spans = _room_partitions(rng, ROOM_ROWS_RANGE)
+    col_spans = _room_partitions(rng, ROOM_COLS_RANGE)
+    m, n = len(row_spans), len(col_spans)
