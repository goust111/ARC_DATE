+def _paint_walls(
+    grid: np.ndarray,
+    row_seps: list[int],
+    col_seps: list[int],
+    horiz: list[list[int]],
+    vert: list[list[int]],
+) -> None:
+    m = len(row_seps) - 1
+    n = len(col_seps) - 1
