+    for r in range(m):
+        for c in range(n):
+            if r + 1 < m:
+                edges.append(((r, c), (r + 1, c), "h"))
+            if c + 1 < n:
+                edges.append(((r, c), (r, c + 1), "v"))
+    return edges
