+
+def _wall_segment_color(
+    room: tuple[int, int], side: str, horiz: list[list[int]], vert: list[list[int]]
+) -> int:
+    r, c = room
+    if side == "top":
+        return horiz[r][c]
+    if side == "bottom":
+        return horiz[r + 1][c]
+    if side == "left":
+        return vert[r][c]
+    if side == "right":
+        return vert[r][c + 1]
+    raise ValueError(side)
+
+
+def _door_for_edge(
+    a: tuple[int, int],
+    b: tuple[int, int],
+    row_seps: list[int],
+    col_seps: list[int],
+    rng: random.Random,
+) -> tuple[int, int]:
+    if a[0] == b[0]:
+        left = a if a[1] < b[1] else b
+        r0, r1 = row_seps[left[0]], row_seps[left[0] + 1]
+        c = col_seps[left[1] + 1]
+        interior = list(range(r0 + 1, r1))
+        assert interior
+        return (rng.choice(interior), c)
+    top = a if a[0] < b[0] else b
+    r = row_seps[top[0] + 1]
+    c0, c1 = col_seps[top[1]], col_seps[top[1] + 1]
