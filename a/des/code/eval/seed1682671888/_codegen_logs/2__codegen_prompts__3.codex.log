+    if len(active) != desired:
+        return None
+
+    rng.shuffle(key_colors)
+    room_key_shape = {}
+    for idx, item in enumerate(active):
+        shape = rng.choice(BASE_SHAPES)
+        color = key_colors[idx]
+        item["shape"] = shape
+        item["color"] = color
+        room_key_shape[item["source"]] = _canonical_shape(shape)
+
+    for item in active:
+        sr, sc = item["source"]
+        rows = row_rooms[sr]
+        cols = col_rooms[sc]
