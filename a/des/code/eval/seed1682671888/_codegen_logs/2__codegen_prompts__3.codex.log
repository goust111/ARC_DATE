+) -> np.ndarray:
+    out = grid.copy()
+    for item in active:
+        trg_r, trg_c = item["target"]
+        rr0, rr1 = row_rooms[trg_r]
+        cc0, cc1 = col_rooms[trg_c]
+        color = item["color"]
+        if item["side"] in {"top", "bottom"}:
+            for col in item["gap"]["cols"]:
+                out[rr0 : rr1 + 1, col] = color
+        else:
+            for row in item["gap"]["rows"]:
