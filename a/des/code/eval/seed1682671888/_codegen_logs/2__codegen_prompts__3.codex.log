+    out = g.copy()
+    for ri, (rr0, rr1) in enumerate(row_rooms):
+        for ci, (cc0, cc1) in enumerate(col_rooms):
+            key = _extract_key(g[rr0 : rr1 + 1, cc0 : cc1 + 1], bg)
+            if key is None:
+                continue
