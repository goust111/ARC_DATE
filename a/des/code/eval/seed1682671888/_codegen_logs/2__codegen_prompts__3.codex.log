+                for info in _gap_infos(seg, rr0, lc0):
+                    info["side"] = "left"
+                    info["target"] = (ri, ci - 1)
+                    candidates.append(info)
+            if ci + 1 < len(col_rooms):
+                rc0, rc1 = v_bands[ci + 1]
+                seg = g[rr0 : rr1 + 1, rc0 : rc1 + 1]
