                comp.append((cr, cc))
                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            comps.append(comp)
    return comps


def _border_cells(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
    cells = set()
    for c in range(c0, c1 + 1):
        cells.add((r0, c))
        cells.add((r1, c))
    for r in range(r0, r1 + 1):
        cells.add((r, c0))
        cells.add((r, c1))
    return cells


def _pot_info_from_component(comp: list[tuple[int, int]]) -> dict | None:
    coords = set(comp)
    rows = [r for r, _ in comp]
    cols = [c for _, c in comp]
    r0, r1 = min(rows), max(rows)
    c0, c1 = min(cols), max(cols)
    if r1 - r0 < 2 or c1 - c0 < 2:
        return None

    border = _border_cells(r0, c0, r1, c1)
    if not coords <= border:
        return None

    gaps = list(border - coords)
    if len(gaps) != 1:
        return None
    gap = gaps[0]

    directions = []
    if gap[0] == r0:
        directions.append((-1, 0))
    if gap[0] == r1:
        directions.append((1, 0))
    if gap[1] == c0:
        directions.append((0, -1))
    if gap[1] == c1:
        directions.append((0, 1))
    if len(directions) != 1:
        return None

    return {
        "bbox": (r0, c0, r1, c1),
        "gap": gap,
        "direction": directions[0],
        "border": border,
    }


def _trace_segment(
    start: tuple[int, int],
    direction: tuple[int, int],
    length: int,
    shape: tuple[int, int],
) -> tuple[list[tuple[int, int]], bool]:
    h, w = shape
    dr, dc = direction
    r, c = start
    cells: list[tuple[int, int]] = []

    for step in range(length):
        if not (0 <= r < h and 0 <= c < w):
            return cells, True
        cells.append((r, c))
