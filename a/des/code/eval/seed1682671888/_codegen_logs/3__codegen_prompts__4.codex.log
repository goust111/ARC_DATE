+def _build_equal_tiebreak(h: int, w: int) -> np.ndarray | None:
+    for _ in range(120):
+        d = random.randint(2, min(h, w) // 3 + 1)
+        c0 = random.randint(1, w - d - 4)
+        r0 = random.randint(1, h - d - 4)
+        col = c0 + d - 1
+        row = r0 + d - 1
+        c1 = random.randint(col + 1, w - 2)
+        r1 = random.randint(row + 1, h - 2)
+        if (c1 - c0) == (r1 - r0):
