+        a_idx, _ = traced_by[0]
+        b_idx, _ = traced_by[1]
+        pa = path_by_index[a_idx]
+        pb = path_by_index[b_idx]
+        da = pa["distance"][cell]
+        db = pb["distance"][cell]
+        if da != db:
+            kinds["unequal"] += 1
+        elif pa["total_length"] != pb["total_length"]:
+            kinds["equal_tiebreak"] += 1
+        else:
