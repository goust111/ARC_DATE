+def _hline(row: int, c0: int, c1: int, seed_color: int) -> dict:
+    return {"kind": "h", "row": row, "c0": c0, "c1": c1, "seed_side": "left", "color": seed_color}
+
+
+def _vline(col: int, r0: int, r1: int, seed_color: int) -> dict:
