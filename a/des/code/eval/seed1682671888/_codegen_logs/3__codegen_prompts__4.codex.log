+def _crossing_kinds(grid: np.ndarray) -> Counter:
+    paths, owners = _extract_seeded_paths(grid)
+    path_by_index = {path["index"]: path for path in paths}
+    kinds = Counter()
+    for cell, traced_by in owners.items():
