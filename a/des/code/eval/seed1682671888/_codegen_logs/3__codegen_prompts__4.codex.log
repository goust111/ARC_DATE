+            c1 = random.randint(c0 + 3, w - 2)
+            line = _hline(row, c0, c1, color)
+        else:
+            col = random.randint(1, w - 2)
+            r0 = random.randint(1, h - 5)
+            r1 = random.randint(r0 + 3, h - 2)
+            line = _vline(col, r0, r1, color)
+        if _render_lines(h, w, existing + [line]) is not None:
