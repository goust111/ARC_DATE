+        if scenario == "no_cross":
+            assert sum(kinds.values()) == 0
+        elif scenario == "unequal":
+            assert kinds["unequal"] >= 1
+        elif scenario == "equal_tiebreak":
+            assert kinds["equal_tiebreak"] >= 1
+        elif scenario == "mixed":
