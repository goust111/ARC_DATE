+            common = set(owners[(r, c)]) & set(owners[(rr, cc)])
+            if not common:
+                return None
+
+    for cell in owners:
+        deg = len(_grey_neighbors(grey_mask, cell[0], cell[1]))
+        if deg not in (1, 2, 4):
