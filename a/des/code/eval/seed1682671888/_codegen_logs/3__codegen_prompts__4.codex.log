+
+BG = 0
+GREY = 5
+YELLOW = 4
+SEED_COLORS = [1, 2, 3, 6, 7, 8, 9]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_H_RANGE = (12, 22)
+GRID_W_RANGE = (12, 22)
+GEN_RETRIES = 400
+SCENARIOS = ("no_cross", "unequal", "equal_tiebreak", "mixed")
