+        lines = [
+            _hline(row, c0, c1, random.choice(SEED_COLORS)),
+            _vline(col_a, r0_a, r1_a, random.choice(SEED_COLORS)),
+            _vline(col_b, r0_b, r1_b, random.choice(SEED_COLORS)),
