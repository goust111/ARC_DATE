+
+def _lattice_neighbors(node: tuple[int, int], rows: int, cols: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    r, c = node
+    for dr, dc in CARDINALS:
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < rows and 0 <= cc < cols:
+            out.append((rr, cc))
+    return out
+
+
+def _random_walk(
+    rows: int,
+    cols: int,
+    edges: int,
+    required: set[str],
+    rng: random.Random,
+) -> tuple[list[tuple[int, int]], list[str]] | None:
+    for _ in range(200):
+        nodes = [(
+            rng.randrange(rows),
+            rng.randrange(cols),
+        )]
+        used = {nodes[0]}
+        while len(nodes) < edges + 1:
+            cur = nodes[-1]
+            choices = [p for p in _lattice_neighbors(cur, rows, cols) if p not in used]
+            if not choices:
+                break
+            nxt = rng.choice(choices)
+            nodes.append(nxt)
+            used.add(nxt)
