+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+GREY = 5
+YELLOW = 4
+ORANGE = 7
+MAROON = 9
+INDICATORS = {YELLOW, ORANGE}
+CARDINALS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+
+GRID_HEIGHT_RANGE = (28, 36)
+PATH_COUNT_CHOICES = [1, 2, 3]
