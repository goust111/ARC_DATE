+        grid[translate(p)] = GREY
+    for p in network["stubs"]:
+        grid[translate(p)] = GREY
+    for p, color in network["indicators"].items():
+        grid[translate(p)] = color
+    grid[translate(network["start"])] = int(network["start_color"])
+    grid[translate(network["end"])] = MAROON
+    return True
