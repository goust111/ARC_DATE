+    out = g.copy()
+    for i, j in pairs:
+        a = fences[i]
+        b = fences[j]
+        assert a["group_count"] != b["group_count"], "paired group sizes must differ"
+        loser = a if a["group_count"] < b["group_count"] else b
+        color = loser["group_color"]
+        assert color is not None and loser["group_count"] > 0
