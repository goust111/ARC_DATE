+def _attempt_generate() -> tuple[np.ndarray, np.ndarray] | None:
+    n_shapes = random.randint(2, 4)
+    defect_counts = [random.randint(1, 5) for _ in range(n_shapes)]
+    legend_colors = random.sample(LEGEND_COLOR_POOL, 5)
