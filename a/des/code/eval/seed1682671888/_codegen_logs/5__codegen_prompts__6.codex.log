+    for i, color in enumerate(colors):
+        c = start + 2 * i
+        patch[:, c] = int(color)
+    return patch, start
+
+
+def _attempt_generate() -> tuple[np.ndarray, np.ndarray] | None:
+    n_shapes = random.randint(2, 4)
