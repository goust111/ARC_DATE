+        r1, c1 = coords.max(axis=0)
+        height = int(r1 - r0 + 1)
+        width = int(c1 - c0 + 1)
+        if height < 4 or width < 4:
+            continue
+        expected = 2 * (height + width) - 4
+        if int(coords.shape[0]) != expected:
