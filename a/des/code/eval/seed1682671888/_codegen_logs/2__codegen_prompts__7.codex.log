+            grid[:, start_col : start_col + region_w] = region
+
+        expected = _simulate(canvas, ops, bg)
+        if np.array_equal(expected, canvas):
+            continue
+        solved = _solve(grid)
+        if solved.shape != (canvas_h, canvas_w):
+            continue
+        if not np.array_equal(solved, expected):
