+    direction = _arrow_direction(region, bg, frame_bbox, frame_color)
+    return direction, overlay
+
+
+def _solve(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = _get_bg(g)
+    _sep_color, regions = _split_regions(g, bg)
