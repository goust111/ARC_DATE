+        patch = np.full(region.shape, BG, dtype=int)
+        patch[boundary] = 1
+        try:
+            _trace_cycle([tuple(map(int, p)) for p in np.argwhere(patch == 1)])
+        except AssertionError:
+            continue
+        return region
