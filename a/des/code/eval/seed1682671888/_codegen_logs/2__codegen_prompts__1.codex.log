+    bottom_h = rng.randint(2 * side + 4, 3 * side + 7)
+    left_w = rng.randint(2 * side + 4, 3 * side + 7)
+    right_w = rng.randint(2 * side + 4, 3 * side + 7)
+    h = top_h + 1 + bottom_h
