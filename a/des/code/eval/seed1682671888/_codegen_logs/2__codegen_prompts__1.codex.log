+
+def _anchor_options(name: str, bounds: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, r1, c0, c1 = bounds
+    opts: list[tuple[int, int]] = []
+    if name[0] == "T":
+        opts.extend((r0, c) for c in range(c0, c1))
