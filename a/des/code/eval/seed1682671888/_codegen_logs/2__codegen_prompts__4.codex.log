+
+    pieces = _extract_pieces(g)
+    order = _chain_order(pieces)
+    return _assemble_from_pieces(pieces, order)
+
+
+# --------------- generator ---------------
+
+COLOR_VALUES = tuple(range(10))
+GRID_MIN = 20
+GRID_MAX = 30
+PIECE_COUNT_RANGE = (3, 5)
+CORE_SIZE_RANGE = (2, 4)
+GROWTH_RANGE = (1, 3)
