+            marker_side = side_hits[0]
+            marker_index = mc if marker_side in ("top", "bottom") else mr
+
+        pieces[color] = {
+            "color": color,
+            "bbox": (r0, c0, r1, c1),
+            "h": int(r1 - r0 + 1),
+            "w": int(c1 - c0 + 1),
+            "marker_color": marker_color,
+            "marker_side": marker_side,
+            "marker_index": marker_index,
+        }
