+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    """Return 4-connected components as coordinate arrays."""
+    height, width = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+
+    for start_r, start_c in np.argwhere(mask):
+        if seen[start_r, start_c]:
+            continue
+        stack = [(int(start_r), int(start_c))]
+        seen[start_r, start_c] = True
+        coords: list[tuple[int, int]] = []
+        while stack:
+            r, c = stack.pop()
+            coords.append((r, c))
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                rr = r + dr
+                cc = c + dc
+                if 0 <= rr < height and 0 <= cc < width and mask[rr, cc] and not seen[rr, cc]:
+                    seen[rr, cc] = True
+                    stack.append((rr, cc))
+        comps.append(np.array(coords, dtype=int))
+
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(np.min(coords[:, 0])),
+        int(np.min(coords[:, 1])),
+        int(np.max(coords[:, 0])),
+        int(np.max(coords[:, 1])),
