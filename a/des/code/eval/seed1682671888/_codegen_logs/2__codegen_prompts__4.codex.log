+        if not placed:
+            return None
+
+    return grid
+
+
+def _specs_to_pieces(colors: list[int], dims: list[tuple[int, int]]) -> dict[int, dict]:
+    pieces: dict[int, dict] = {}
+    for idx, (color, (h, w)) in enumerate(zip(colors, dims)):
