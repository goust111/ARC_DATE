+            c0 = random.randint(0, width - pw)
+            rr0 = max(0, r0 - PLACEMENT_PADDING)
+            cc0 = max(0, c0 - PLACEMENT_PADDING)
+            rr1 = min(height, r0 + ph + PLACEMENT_PADDING)
