+        rr, cc = _stamp_position(anchor)
+        assert 0 <= rr and 0 <= cc
+        assert rr + 3 <= g.shape[0] and cc + 3 <= g.shape[1]
+        mask = patch != BG
+        out[rr : rr + 3, cc : cc + 3][mask] = patch[mask]
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
