+        return r, c - 1
+    if side == "bottom":
+        return r - 2, c - 1
+    if side == "left":
+        return r - 1, c
+    if side == "right":
+        return r - 1, c - 2
+    raise AssertionError(side)
+
+
+def _apply_motifs(
+    g: np.ndarray, anchors: dict[int, dict], patterns: dict[int, np.ndarray]
+) -> np.ndarray:
+    out = g.copy()
+    assert set(anchors) == set(patterns), "anchors and motifs must match by color"
+    for color, anchor in anchors.items():
