+
+    rng.shuffle(top_colors)
+    rng.shuffle(left_colors)
+    for color, c in zip(top_colors, col_centers):
+        grid[fr0 - 1, c] = color
+    for color, r in zip(left_colors, row_centers):
+        grid[r, fc0 - 1] = color
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
