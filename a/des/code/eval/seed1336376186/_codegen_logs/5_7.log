+from __future__ import annotations
+
+from collections import Counter, defaultdict
+import random
+
+import numpy as np
+
+
+BG = 0
+MARKER = 9
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PATH_COLORS = [1, 2, 3, 4, 5, 6, 7, 8]
