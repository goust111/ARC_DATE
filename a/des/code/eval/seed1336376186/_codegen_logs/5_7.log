+    out = mask.copy()
+    out[1:, :] |= mask[:-1, :]
+    out[:-1, :] |= mask[1:, :]
+    out[:, 1:] |= mask[:, :-1]
+    out[:, :-1] |= mask[:, 1:]
+    return out
+
+
+def _anchor_key(seg: dict) -> tuple[int, int]:
+    r0, c0, _r1, _c1 = seg["bbox"]
+    return int(r0), int(c0)
