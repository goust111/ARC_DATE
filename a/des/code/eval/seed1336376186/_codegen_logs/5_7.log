+    inp = np.full((h, w), BG, dtype=int)
+    marker_pos_to_seg: dict[tuple[int, int], int] = {}
+
+    for seg_idx, coords in enumerate(placed_seg_coords):
+        for rr, cc in coords:
+            inp[int(rr), int(cc)] = int(main_colors[seg_idx])
+
