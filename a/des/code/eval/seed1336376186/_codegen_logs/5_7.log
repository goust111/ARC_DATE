+            placed_marker_coords.append(final_marker_cells)
+            continue
+
+        obj_cells = _object_cells(final_seg_cells, final_marker_cells)
+        obj_arr = np.array(obj_cells, dtype=int)
+        or0, oc0, or1, oc1 = _bbox(obj_arr)
+        oh = int(or1 - or0 + 1)
+        ow = int(oc1 - oc0 + 1)
+
+        placed = False
+        for _ in range(120):
+            band = rng.choice(["below", "right"])
+            if band == "below":
+                row_lo = int(r1 + 2)
+                row_hi = int(h - oh)
+                col_lo = 0
+                col_hi = int(w - ow)
+            else:
+                row_lo = int(root_r0)
+                row_hi = int(h - oh)
+                col_lo = int(c1 + 2)
