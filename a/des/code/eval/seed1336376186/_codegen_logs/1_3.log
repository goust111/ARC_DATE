+
+def _order_path(mask: np.ndarray, start: Coord) -> list[Coord]:
+    cell_set = {tuple(map(int, cell)) for cell in np.argwhere(mask)}
+    ordered = [start]
+    prev: Coord | None = None
+    cur = start
+    while True:
