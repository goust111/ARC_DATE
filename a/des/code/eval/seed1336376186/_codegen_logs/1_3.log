+    return ordered
+
+
+def _endpoint_run_length(ordered: list[Coord], original_cells: set[Coord]) -> int:
+    assert ordered
+    assert ordered[0] in original_cells
+    if len(ordered) == 1:
+        return 1
+
+    run_len = 1
+    direction = (ordered[1][0] - ordered[0][0], ordered[1][1] - ordered[0][1])
