+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Copy each source-frame interior into its connected target frame after rotating
+    clockwise once per pipe bend.
+    """
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
