+
+def _rect_border_cells(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    return cells
