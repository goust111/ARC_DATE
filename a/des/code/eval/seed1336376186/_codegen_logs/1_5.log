+        sr0, sc0, sr1, sc1 = source["bbox"]
+        tr0, tc0, tr1, tc1 = target["bbox"]
+        src_patch = g[sr0 + 1 : sr1, sc0 + 1 : sc1]
+        rotated = np.rot90(src_patch, -(_count_bends(pipe) % 4))
