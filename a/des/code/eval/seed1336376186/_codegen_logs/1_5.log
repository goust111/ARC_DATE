+def _count_bends(pipe_cells: Iterable[tuple[int, int]]) -> int:
+    cells = set(pipe_cells)
+    bends = 0
+    for r, c in cells:
+        neigh = [(dr, dc) for dr, dc in DIR4 if (r + dr, c + dc) in cells]
+        if len(neigh) == 2 and neigh[0][0] != neigh[1][0] and neigh[0][1] != neigh[1][1]:
+            bends += 1
+    return bends
