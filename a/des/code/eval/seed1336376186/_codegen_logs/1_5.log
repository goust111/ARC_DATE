+    for pipe in _components(g == PIPE):
+        source_ids: set[int] = set()
+        target_ids: set[int] = set()
+        for r, c in pipe:
+            for dr, dc in DIR4:
+                nb = (r + dr, c + dc)
+                if nb in source_lookup:
+                    source_ids.add(source_lookup[nb])
+                if nb in target_lookup:
