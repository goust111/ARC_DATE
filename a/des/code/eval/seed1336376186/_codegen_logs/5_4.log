+    singletons: list[dict] = []
+    for comp in color_components:
+        r0, c0, r1, c1 = comp["bbox"]
+        if int(comp["area"]) == 4 and r1 - r0 == 1 and c1 - c0 == 1:
+            nodes.append(comp)
