+def _expected_from_layout(
+    labels: list[str],
+    original_colors: dict[str, int],
+    edges: list[tuple[str, str]],
+    priority: list[int],
+    slot_positions: dict[str, tuple[int, int]],
+) -> dict[str, int]:
