+    original_colors: dict[object, int],
+    edges: list[tuple[object, object]],
+    priority: list[int],
+    order_key,
+) -> dict[object, int]:
+    node_list = list(nodes)
+    preds = {node: [] for node in node_list}
+    succs = {node: [] for node in node_list}
+    indeg = {node: 0 for node in node_list}
