+
+def _parse_graph(grid: np.ndarray) -> tuple[list[dict], list[tuple[int, int]], list[int]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+
+    color_components = _monochromatic_components(g, ignore_colors={BG, GREY, ARROW})
