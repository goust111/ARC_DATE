+def _bbox_is_free(blocked: np.ndarray, bbox: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = bbox
+    return not bool(blocked[r0 : r1 + 1, c0 : c1 + 1].any())
+
