+            if not choices:
+                break
+            picked = rng.choice(choices)
+            cells.add(picked)
+            frontier.discard(picked)
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                nxt = (picked[0] + dr, picked[1] + dc)
+                if nxt not in cells:
