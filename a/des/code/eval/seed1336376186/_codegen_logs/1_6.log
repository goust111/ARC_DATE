+    key_cells = [(key_top + r, key_left + c) for r, c in key_shape]
+
+    closed = _closed_ring_mask(outer_h, outer_w, thickness)
+    gap = _gap_mask(outer_h, outer_w, thickness, side, gap_start, gap_len)
+    wall_cells = [
+        (int(r), int(c))
