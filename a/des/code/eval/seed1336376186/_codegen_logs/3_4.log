+    order = list(range(len(sizes)))
+    rng.shuffle(order)
+    top_margin = rng.randint(0, 2)
+    bottom_margin = rng.randint(0, 2)
+    cur_r = top_margin
+    positions: dict[int, tuple[int, int]] = {}
+    for i, idx in enumerate(order):
