+BG = 0
+FENCE = 5
+SIDES = ("top", "bottom", "left", "right")
+PALETTE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_RETRIES = 400
+MAX_GRID_DIM = 40
