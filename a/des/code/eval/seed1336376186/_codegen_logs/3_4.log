+        positions[idx] = (cur_r, 0)
+        cur_r += h
+        if i + 1 < len(order):
+            cur_r += rng.randint(1, 2)
+    total_h = cur_r + bottom_margin
+    total_w = max(w for _h, w in sizes)
+    return positions, total_h, total_w
