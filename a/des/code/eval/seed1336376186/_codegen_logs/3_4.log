+        side_bins = {side: () for side in SIDES}
+        for side in sides:
+            side_bins[side] = (rng.randrange(3),)
+        sig = _make_signature(
+            top=side_bins["top"],
+            bottom=side_bins["bottom"],
+            left=side_bins["left"],
+            right=side_bins["right"],
