+        positions[idx] = (0, cur_c)
+        cur_c += w
+        if i + 1 < len(order):
+            cur_c += rng.randint(1, 2)
+    total_w = cur_c + right_margin
+    total_h = max(h for h, _w in sizes)
+    return positions, total_h, total_w
