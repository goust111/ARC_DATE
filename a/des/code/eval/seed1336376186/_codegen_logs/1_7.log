+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((int(rr), int(cc)))
+                for dr, dc in deltas:
