+
+
+def _steps_to_edge(start: tuple[int, int], step: tuple[int, int], shape: tuple[int, int]) -> int:
+    return len(_ray_to_edge(start, step, shape))
+
+
+def _parse_scene(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
