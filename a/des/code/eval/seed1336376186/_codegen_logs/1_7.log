+import numpy as np
+
+
+BG = 0
+PRISM = 5
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+CARDINALS = (UP, DOWN, LEFT, RIGHT)
+COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_RETRIES = 400
