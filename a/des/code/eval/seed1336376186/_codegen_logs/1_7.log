+
+    return {
+        "grid": g,
+        "shape": (h, w),
+        "bg": int(bg),
+        "prisms": prisms,
+        "prism_by_cell": prism_by_cell,
+        "markers": marker_positions,
+        "towers": towers,
+    }
+
+
+def _solve(grid: np.ndarray, *, strict: bool = False, return_stats: bool = False):
+    scene = _parse_scene(grid)
+    g = scene["grid"]
+    h, w = scene["shape"]
