+    if not stats["diag_lengths"] or min(stats["diag_lengths"]) < 2:
+        return None
+    if blocker_dirs and (stats["orth_tower_stops"] + stats["diag_tower_stops"] == 0):
+        return None
+    if stats["orth_edge_stops"] == 0:
