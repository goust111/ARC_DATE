+    return [
+        (r + dr, c + dc)
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+        if not (dr == 0 and dc == 0)
+    ]
+
+
+def _components(mask: np.ndarray, connectivity: int) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    if connectivity == 4:
+        deltas = ((1, 0), (-1, 0), (0, 1), (0, -1))
+    else:
+        deltas = (
+            (1, 0),
+            (-1, 0),
