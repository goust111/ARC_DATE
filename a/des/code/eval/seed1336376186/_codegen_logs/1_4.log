                    ok = False
                if ok and (best_ok is None or key < best_ok[0]):
                    best_ok = (key, B)

        return (best_ok or best_all)[1]

    out = g.copy()
    for i in range(len(fr) - 1):
        r0, r1 = int(fr[i]), int(fr[i + 1])
        if int(r1 - r0) <= 1:
            continue
        rr0, rr1 = int(r0 + 1), int(r1 - 1)

