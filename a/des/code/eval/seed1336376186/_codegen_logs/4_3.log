        sep_r = (rr + 1) * cell_h + rr
        grid[sep_r, :] = SEP_COLOR
    for cc in range(region_cols - 1):
        sep_c = (cc + 1) * cell_w + cc
        grid[:, sep_c] = SEP_COLOR

