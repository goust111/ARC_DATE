+    grid[spec.r0 : spec.r1 + 1, spec.c1] = spec.color
+    grid[spec.r0, spec.c0 : spec.c1 + 1] = spec.color
+    grid[spec.r1, spec.c0 : spec.c1 + 1] = spec.color
+    grid[spec.gap] = bg
