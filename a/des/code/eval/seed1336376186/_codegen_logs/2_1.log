+                cc0 = max(0, int(c0 - pad))
+                rr1 = min(h, int(r0 + item_h + pad))
+                cc1 = min(w, int(c0 + item_w + pad))
+                if not occupied[rr0:rr1, cc0:cc1].any():
+                    candidates.append((int(r0), int(c0)))
