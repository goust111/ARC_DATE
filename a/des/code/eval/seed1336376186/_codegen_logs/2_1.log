+    return [(int(r), int(c)) for r, c in positions if r is not None and c is not None]
+
+
+def _make_input_and_output(rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray] | None:
+    n_frames = int(rng.choice(NUM_FRAME_CHOICES))
