+    template_by_shape: dict[tuple[int, int, tuple[tuple[int, int], ...]], dict] = {}
+    for tmpl in templates:
+        key = tmpl["shape_key"]
+        assert key not in template_by_shape, "template shapes must be unique"
+        template_by_shape[key] = tmpl
+
+    out = g.copy()
