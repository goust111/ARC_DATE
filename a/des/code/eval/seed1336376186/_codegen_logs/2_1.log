+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+# Generator configuration.
+GRID_H_RANGE = (20, 31)
+GRID_W_RANGE = (20, 31)
+NUM_FRAME_CHOICES = (2, 3)
+FRAME_INNER_H_PAD_RANGE = (2, 6)
+FRAME_INNER_W_PAD_RANGE = (2, 7)
+FRAME_PLACE_PADDING = 1
+TEMPLATE_PLACE_PADDING = 1
+MAX_GENERATION_ATTEMPTS = 300
