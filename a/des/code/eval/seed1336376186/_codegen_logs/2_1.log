        w_lo = max(GRID_W_RANGE[0], int(min_w))
        if h_lo >= GRID_H_RANGE[1] or w_lo >= GRID_W_RANGE[1]:
            return None
        h = int(rng.integers(h_lo, GRID_H_RANGE[1]))
        w = int(rng.integers(w_lo, GRID_W_RANGE[1]))
        if int(h * w) < int(total_area * 2.2):
