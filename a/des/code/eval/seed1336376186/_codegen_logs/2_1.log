+def _build_shape_library() -> list[dict]:
+    shapes_by_size: dict[int, set[tuple[tuple[int, int], ...]]] = {1: {((0, 0),)}}
+    for size in range(2, 7):
+        prev = shapes_by_size[int(size - 1)]
+        current: set[tuple[tuple[int, int], ...]] = set()
+        for shape in prev:
