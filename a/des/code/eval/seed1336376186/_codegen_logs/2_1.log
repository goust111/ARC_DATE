+    min_h = max(item["reserve_shape"][0] for item in items) + 2
+    min_w = max(item["reserve_shape"][1] for item in items) + 2
+    total_area = sum(int(item["reserve_shape"][0] * item["reserve_shape"][1]) for item in items)
