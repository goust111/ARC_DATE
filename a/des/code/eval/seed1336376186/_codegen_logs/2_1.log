+    return {
+        "shape_key": shape["key"],
+        "frame_patch": patch,
+        "template_patch": template,
+        "inner_h": inner_h,
+        "inner_w": inner_w,
+        "divider_interior_row": divider_interior_row,
+        "body_color": int(body_color),
+        "marker_color": int(marker_color),
+    }
+
+
+def _place_items(
+    rng: np.random.Generator,
+    canvas_shape: tuple[int, int],
