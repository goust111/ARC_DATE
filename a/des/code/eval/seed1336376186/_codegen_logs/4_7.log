+            cc1 = min(w, c + pw + pad)
+            if occupied[rr0:rr1, cc0:cc1].any():
+                continue
+            placements[idx] = (r, c)
+            occupied[r : r + ph, c : c + pw] = True
+            placed = True
+            break
+        if not placed:
+            return None
