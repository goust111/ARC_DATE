+            start_c = 1 + rng.randrange(inner_w - notch_w + 1)
+        elif side == "bottom":
+            start_r = outer_h - notch_h
+            start_c = 1 + rng.randrange(inner_w - notch_w + 1)
+        elif side == "left":
+            start_r = 1 + rng.randrange(inner_h - notch_h + 1)
+            start_c = 0
+        else:
+            start_r = 1 + rng.randrange(inner_h - notch_h + 1)
+            start_c = outer_w - notch_w
