+    occupied = np.zeros((h, w), dtype=bool)
+    placements: list[tuple[int, int] | None] = [None] * len(objects)
+
+    for idx in order:
+        patch = objects[idx]["input_patch"]
+        ph, pw = map(int, patch.shape)
+        placed = False
+        for _ in range(250):
