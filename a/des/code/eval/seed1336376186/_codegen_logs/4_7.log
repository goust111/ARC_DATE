+            continue
+        if side in ("left", "right") and inner_h < notch_h:
+            continue
+
+        outer_h = inner_h + 2
+        outer_w = inner_w + 2
+        notch_full = np.zeros((outer_h, outer_w), dtype=bool)
+
+        if side == "top":
