+        output_patch = input_patch.copy()
+
+        if matched:
+            if key_color is None:
+                continue
+            output_patch[notch_full] = key_color
+            for rr in range(1, outer_h - 1):
+                for cc in range(1, outer_w - 1):
+                    if not notch_full[rr, cc]:
