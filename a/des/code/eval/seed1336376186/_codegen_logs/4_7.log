+        inner_h = max(key_h * scale + extra_h, notch_h + 1)
+        if inner_w > 12 or inner_h > 12:
+            continue
+        if side in ("top", "bottom") and inner_w < notch_w:
+            continue
+        if side in ("left", "right") and inner_h < notch_h:
+            continue
+
+        outer_h = inner_h + 2
+        outer_w = inner_w + 2
