+    verticals = [_vertical(v_colors[i], cols[i], 0, height - 1) for i in range(v_count)]
+
+    h_mark_row = rows[h_mark_idx]
+    h_mark_col = cols[v_full_idx]
+    v_mark_row = rows[h_full_idx]
+    v_mark_col = cols[v_mark_idx]
