+        source_interior = g[sr0 + 1 : sr1, sc0 + 1 : sc1].copy()
+        target_interior = g[tr0 + 1 : tr1, tc0 + 1 : tc1]
+        assert source_interior.size > 0 and target_interior.size > 0
+        assert np.any(source_interior != BG), "source must contain a pattern"
