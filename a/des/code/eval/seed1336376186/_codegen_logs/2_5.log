+import random
+
+import numpy as np
+
+
+BG = 0
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDE_TO_K = {
+    "top": 0,
+    "right": 3,   # clockwise 90
+    "bottom": 2,
+    "left": 1,    # clockwise 270
+}
