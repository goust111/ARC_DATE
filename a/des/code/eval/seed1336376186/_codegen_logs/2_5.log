+        placements = []
+        for idx, obj in enumerate(row):
+            ph, pw = obj["patch"].shape
+            y = random.randint(0, row_h - ph)
+            placements.append((obj["id"], y, local_x))
+            local_x += pw
+            if idx == 0 and len(row) == 2:
+                local_x += gap
