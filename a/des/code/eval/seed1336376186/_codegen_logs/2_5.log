+def _components(mask: np.ndarray) -> list[dict]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            pts = np.asarray(coords, dtype=int)
+            r0, c0 = pts.min(axis=0)
+            r1, c1 = pts.max(axis=0)
+            local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            local[pts[:, 0] - r0, pts[:, 1] - c0] = True
+            comps.append({
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "local": local,
+            })
+    return comps
+
+
+def _classify_frame(local: np.ndarray, bbox: tuple[int, int, int, int]) -> dict | None:
+    h, w = local.shape
+    if h < 3 or w < 3:
+        return None
+
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+
+    if np.any(local & ~border):
+        return None
+
+    missing = border & ~local
+    missing_pts = np.argwhere(missing)
+    if missing_pts.size == 0:
+        if np.array_equal(local, border):
+            return {"kind": "source", "bbox": bbox, "side": None}
+        return None
+
+    if len(missing_pts) != 1:
+        return None
+
+    rr, cc = map(int, missing_pts[0])
+    on_h = rr == 0 or rr == h - 1
+    on_v = cc == 0 or cc == w - 1
+    if on_h == on_v:
+        return None
+
+    if rr == 0:
+        side = "top"
+    elif rr == h - 1:
+        side = "bottom"
+    elif cc == 0:
+        side = "left"
+    else:
+        side = "right"
+    return {"kind": "target", "bbox": bbox, "side": side}
