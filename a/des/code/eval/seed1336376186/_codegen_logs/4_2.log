+def _extract_holes(grid: np.ndarray, template: dict, bg: int) -> list[dict]:
+    h, w = grid.shape
+    template_mask = np.zeros((h, w), dtype=bool)
+    template_mask[template["coords"][:, 0], template["coords"][:, 1]] = True
+    r0, c0, r1, c1 = template["bbox"]
