+        mask = _mask_from_coords(coords)
+        pieces.append(
+            {
+                "coords": coords,
+                "mask": mask,
+                "key": _canonical_rot_key(mask),
+                "color": int(colors[0]),
+            }
+        )
+    return pieces
+
+
+def main(grid: np.ndarray) -> np.ndarray:
