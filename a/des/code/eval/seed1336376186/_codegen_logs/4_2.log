+    for hole in holes:
+        piece = piece_by_key.get(hole["key"])
+        assert piece is not None, "every hole must have a matching piece"
+        color = int(piece["color"])
+        out[hole["coords"][:, 0], hole["coords"][:, 1]] = color
+        for br, bc in hole["border"]:
+            out[br, bc] = color
