+
+
+def _extract_pieces(grid: np.ndarray, template: dict, bg: int) -> list[dict]:
+    h, w = grid.shape
+    keep = np.ones((h, w), dtype=bool)
+    keep[template["coords"][:, 0], template["coords"][:, 1]] = False
+    remain = (grid != int(bg)) & keep
+    pieces = []
+    for coords in _components(remain):
