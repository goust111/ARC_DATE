+            if any(_min_endpoint_distance(coord, cells) == 1 and other_ref != ref for other_ref, coord in endpoint_coords.items()):
+                continue
+            bad_touch = False
+            for cell in cells:
+                for neighbor in _neighbors4(cell):
+                    if neighbor in other_segment_cells:
+                        bad_touch = True
+                        break
+                if bad_touch:
