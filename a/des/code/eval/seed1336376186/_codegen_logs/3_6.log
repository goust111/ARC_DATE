+        return [
+            [(0, 1), (0, 2), (1, 1), (1, 2)],
+            [(-1, 1), (-1, 2), (0, 1), (0, 2)],
+        ]
+    if dr == 0 and dc == -1:
+        return [
+            [(0, -1), (0, -2), (1, -1), (1, -2)],
+            [(-1, -1), (-1, -2), (0, -1), (0, -2)],
+        ]
+    if dr == 1 and dc == 0:
+        return [
+            [(1, 0), (2, 0), (1, 1), (2, 1)],
+            [(1, -1), (2, -1), (1, 0), (2, 0)],
+        ]
+    return [
+        [(-1, 0), (-2, 0), (-1, 1), (-2, 1)],
+        [(-1, -1), (-2, -1), (-1, 0), (-2, 0)],
