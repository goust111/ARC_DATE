+    "step_r": ((0, 0), (1, 0), (1, 1), (2, 1)),
+    "step_l": ((0, 0), (1, -1), (1, 0), (2, -1)),
+    "fan5": ((0, 0), (1, 0), (2, -1), (2, 0), (2, 1)),
+    "sweep_r": ((0, 0), (1, 0), (2, 0), (2, 1), (2, 2)),
+    "sweep_l": ((0, 0), (1, 0), (2, -2), (2, -1), (2, 0)),
+    "cross5": ((0, 0), (1, -1), (1, 0), (1, 1), (2, 0)),
+}
+
+OVERLAP_TEMPLATES = [
+    ("hook_r", "sweep_l", 3),
+    ("hook_l", "sweep_l", 2),
+    ("sweep_r", "hook_r", 2),
+    ("T4", "sweep_l", 3),
