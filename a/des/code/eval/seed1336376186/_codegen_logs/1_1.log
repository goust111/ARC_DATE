+            color = int(grid[sr, sc])
+            if color in (BG_COLOR, FRAME_COLOR) or seen[sr, sc]:
+                continue
+            q = deque([(sr, sc)])
+            seen[sr, sc] = True
+            coords = []
+            while q:
+                r, c = q.popleft()
+                coords.append((int(r), int(c)))
+                for dr, dc in DIR4:
+                    nr, nc = r + dr, c + dc
+                    if not (r0 < nr < r1 and c0 < nc < c1):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
