+
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8)
+GEN_RETRIES = 300
+OBJECT_COUNT_RANGE = (3, 6)
+INNER_SIZE_RANGE = (8, 12)
+MARGIN_RANGE = (6, 9)
+PLACE_TRIES = 80
+
+
+def _actual_cells(
+    side: str,
+    frame: tuple[int, int, int, int],
+    anchor: int,
+    shape: tuple[tuple[int, int], ...],
