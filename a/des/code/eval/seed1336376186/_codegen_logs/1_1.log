+        start = min(mirror_cols) - span
+        end = min(mirror_cols)
+        return [(r, c) for r in range(min_r, max_r + 1) for c in range(start, end)]
+    start = max(mirror_cols) + 1
+    end = max(mirror_cols) + span + 1
+    return [(r, c) for r in range(min_r, max_r + 1) for c in range(start, end)]
