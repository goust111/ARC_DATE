+    r0, c0, r1, c1 = frame
+    touches = {
+        "top": [(r, c) for r, c in coords if r == r0 + 1],
+        "bottom": [(r, c) for r, c in coords if r == r1 - 1],
+        "left": [(r, c) for r, c in coords if c == c0 + 1],
+        "right": [(r, c) for r, c in coords if c == c1 - 1],
