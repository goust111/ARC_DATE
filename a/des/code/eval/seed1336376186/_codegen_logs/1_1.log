+def _mirror_coords(
+    coords: list[tuple[int, int]], side: str, frame: tuple[int, int, int, int]
+) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = frame
+    if side == "top":
+        return [(2 * r0 - r, c) for r, c in coords]
+    if side == "bottom":
+        return [(2 * r1 - r, c) for r, c in coords]
+    if side == "left":
