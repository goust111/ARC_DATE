'sweep_l': {(0,0),(1,0),(2,-2),(2,-1),(2,0)},
'cross5': {(0,0),(1,-1),(1,0),(1,1),(2,0)},
}

def place(shape, anchor):
    return {(d,p+anchor) for d,p in shape}

def bbox(cells):
    ds=[d for d,p in cells]; ps=[p for d,p in cells]
    return min(ds), max(ds), min(ps), max(ps)

def mirror(shape, anchor):
    return {(-1-d, p+anchor) for d,p in shape}

def ext(shape, anchor):
    cells=place(shape,anchor)
    _, maxd, minp, maxp = bbox(cells)
    span=maxp-minp+1
    min_mirror = -1 - maxd
    return {(r,c) for r in range(min_mirror - span, min_mirror) for c in range(minp,maxp+1)}

