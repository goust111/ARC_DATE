+def _pattern_mask(shape: tuple[int, int], seed: tuple[int, int], pattern: str) -> np.ndarray:
+    h, w = shape
+    rs, cs = seed
+    rr, cc = np.indices((h, w))
+    if pattern == "cross":
+        return (rr == rs) | (cc == cs)
+    if pattern == "x":
+        return np.abs(rr - rs) == np.abs(cc - cs)
+    if pattern == "fill":
+        return np.ones((h, w), dtype=bool)
+    if pattern == "border":
