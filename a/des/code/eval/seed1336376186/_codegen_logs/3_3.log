+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+COLOR_CYCLE = [RED, BLUE, GREEN, YELLOW]
+COLOR_INDEX = {color: idx for idx, color in enumerate(COLOR_CYCLE)}
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
