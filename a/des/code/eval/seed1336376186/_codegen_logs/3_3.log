+
+def _can_place_frame(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> bool:
+    h, w = grid.shape
+    r0, c0, r1, c1 = bbox
+    if r0 < 1 or c0 < 1 or r1 >= h - 1 or c1 >= w - 1:
+        return False
