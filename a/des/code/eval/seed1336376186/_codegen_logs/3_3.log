+
+        if not any(leaf not in seed_nodes for leaf in framed_leaves):
+            continue
+
+        colors = random.sample(SEED_COLORS, n_seeds)
+        seed_assignment = {node: color for node, color in zip(seed_nodes, colors, strict=False)}
