+    return None
+
+
+def _generate_attempt() -> np.ndarray | None:
+    coarse_rows = random.randint(*COARSE_ROWS)
+    coarse_cols = random.randint(*COARSE_COLS)
+    n_nodes = random.randint(NODE_COUNT[0], min(NODE_COUNT[1], coarse_rows * coarse_cols))
