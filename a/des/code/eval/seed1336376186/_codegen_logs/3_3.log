+
+def _bfs_distances(
+    adj: dict[tuple[int, int], list[tuple[int, int]]],
+    start: tuple[int, int],
+) -> dict[tuple[int, int], int]:
+    dist = {start: 0}
+    q = deque([start])
+    while q:
+        node = q.popleft()
+        for nxt in adj[node]:
+            if nxt not in dist:
+                dist[nxt] = dist[node] + 1
+                q.append(nxt)
+    return dist
