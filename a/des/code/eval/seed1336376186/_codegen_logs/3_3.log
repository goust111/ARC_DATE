+            continue
+        r0, c0, r1, c1 = _bbox(comp)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 3 or w < 3:
+            continue
+        if len(comp) != 2 * h + 2 * w - 4:
+            continue
+
+        comp_set = set(comp)
+        ok = True
+        for r in range(r0, r1 + 1):
+            for c in range(c0, c1 + 1):
+                on_border = r in (r0, r1) or c in (c0, c1)
+                if on_border != ((r, c) in comp_set):
+                    ok = False
+                    break
+                if not on_border and int(grid[r, c]) != BLACK:
+                    ok = False
+                    break
+            if not ok:
