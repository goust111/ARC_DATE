+
+def _abstract_adjacency(
+    nodes: list[tuple[int, int]],
+    edges: list[tuple[tuple[int, int], tuple[int, int]]],
+) -> dict[tuple[int, int], list[tuple[int, int]]]:
+    adj = {node: [] for node in nodes}
+    for a, b in edges:
+        adj[a].append(b)
+        adj[b].append(a)
+    return adj
