+
+def _grid_neighbors(node: tuple[int, int], rows: int, cols: int) -> list[tuple[int, int]]:
+    r, c = node
+    out = []
+    for dr, dc in DIRS4:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < rows and 0 <= nc < cols:
