+    def add_frontier(r: int, c: int) -> None:
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < height and 0 <= nc < width and not mask[nr, nc]:
