import random
from collections import deque

import numpy as np


BG = 0
TEMPLATE_COLOR = 5
PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
SIDES = ("top", "right", "bottom", "left")
GEN_RETRIES = 500


def _most_common_color(grid: np.ndarray) -> int:
    values, counts = np.unique(grid, return_counts=True)
    return int(values[np.argmax(counts)])


def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    out: list[list[tuple[int, int]]] = []

    for r in range(h):
        for c in range(w):
            if not bool(mask[r, c]) or bool(seen[r, c]):
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            comp: list[tuple[int, int]] = []
            while q:
                rr, cc = q.popleft()
                comp.append((rr, cc))
                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nr = rr + dr
                    nc = cc + dc
                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
                        seen[nr, nc] = True
                        q.append((nr, nc))
            out.append(comp)
    return out


def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
    rows = [r for r, _ in coords]
    cols = [c for _, c in coords]
    return min(rows), min(cols), max(rows), max(cols)


def _marker_side(marker_pos: tuple[int, int], shape: tuple[int, int]) -> str:
    r, c = marker_pos
    h, w = shape
    sides: list[str] = []
    if r == 0:
        sides.append("top")
    if r == h - 1:
        sides.append("bottom")
    if c == 0:
        sides.append("left")
    if c == w - 1:
        sides.append("right")
    assert len(sides) == 1, (marker_pos, shape, sides)
    return sides[0]


def _find_template(grid: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int]]:
    best: tuple[int, int, tuple[int, int, int, int]] | None = None

    for color in map(int, np.unique(grid)):
        if color == bg:
            continue
        for comp in _components(grid == color):
            r0, c0, r1, c1 = _bbox(comp)
            patch = grid[r0 : r1 + 1, c0 : c1 + 1]
            if not (
                np.all(patch[0, :] == color)
                and np.all(patch[-1, :] == color)
                and np.all(patch[:, 0] == color)
                and np.all(patch[:, -1] == color)
            ):
                continue
            if not np.any(patch == bg):
                continue
            area = len(comp)
            bbox_area = (r1 - r0 + 1) * (c1 - c0 + 1)
            cand = (area, bbox_area, (r0, c0, r1, c1))
            if best is None or cand[:2] > best[:2]:
                best = cand

    assert best is not None
    area, _bbox_area, bbox = best
    assert area > 0
    return TEMPLATE_COLOR if False else int(grid[bbox[0], bbox[1]]), bbox


def _find_slots(
    grid: np.ndarray,
    bg: int,
    template_color: int,
    template_bbox: tuple[int, int, int, int],
) -> list[dict]:
    h, w = grid.shape
    tr0, tc0, tr1, tc1 = template_bbox
    slots: list[dict] = []

    for comp in _components(grid == bg):
        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in comp):
            continue
        r0, c0, r1, c1 = _bbox(comp)
        if not (tr0 < r0 <= r1 < tr1 and tc0 < c0 <= c1 < tc1):
            continue
        if len(comp) != (r1 - r0 + 1) * (c1 - c0 + 1):
            continue
        if r0 - 1 < tr0 or c0 - 1 < tc0 or r1 + 1 > tr1 or c1 + 1 > tc1:
            continue

        marker: tuple[str, int] | None = None
        for cc in range(c0, c1 + 1):
            val = int(grid[r0 - 1, cc])
            if val != template_color:
                assert marker is None
                marker = ("top", val)
        for cc in range(c0, c1 + 1):
            val = int(grid[r1 + 1, cc])
            if val != template_color:
                assert marker is None
                marker = ("bottom", val)
        for rr in range(r0, r1 + 1):
            val = int(grid[rr, c0 - 1])
            if val != template_color:
                assert marker is None
                marker = ("left", val)
        for rr in range(r0, r1 + 1):
            val = int(grid[rr, c1 + 1])
            if val != template_color:
