# Canvas and colors.
GEN_BG = 0
GEN_GRID_SHAPE = (30, 30)
GEN_MARKER_COLOR = 1
GEN_DOMINANT_COLOR = 8
GEN_ACCENT_COLORS = [2, 3, 4, 5, 6, 7, 9]

