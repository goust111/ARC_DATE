+def _marker_side(marker_pos: tuple[int, int], shape: tuple[int, int]) -> str:
+    r, c = marker_pos
+    h, w = shape
+    sides: list[str] = []
+    if r == 0:
+        sides.append("top")
+    if r == h - 1:
+        sides.append("bottom")
+    if c == 0:
+        sides.append("left")
+    if c == w - 1:
+        sides.append("right")
