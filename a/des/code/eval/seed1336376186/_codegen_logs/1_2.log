+def _gen_attempt() -> np.ndarray | None:
+    pair_count = int(RNG.choice(PAIR_COUNT_VALUES, p=PAIR_COUNT_WEIGHTS / PAIR_COUNT_WEIGHTS.sum()))
+    colors = RNG.choice(np.array(BORDER_COLORS, dtype=int), size=pair_count, replace=False)
