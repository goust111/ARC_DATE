+def _north_exposed(region: np.ndarray) -> np.ndarray:
+    exposed = np.zeros_like(region, dtype=bool)
+    exposed[0, :] = region[0, :]
+    exposed[1:, :] = region[1:, :] & ~region[:-1, :]
