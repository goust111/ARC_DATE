+GEN_TEMPLATE = 5
+GEN_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+GEN_TEMPLATE_H = (6, 9)
+GEN_TEMPLATE_W = (6, 10)
+GEN_COLOR_COUNT = (2, 4)
+GEN_OUTER_MARGIN = (1, 2)
+GEN_SIDE_GAP = (1, 2)
