+def _sample_pair_specs(
+    pair: tuple[str, str], color: int, th: int, tw: int, prev_union: np.ndarray, want_overlap: bool
+) -> tuple[list[dict], np.ndarray]:
+    best_specs: list[dict] | None = None
+    best_union: np.ndarray | None = None
+    if want_overlap:
