+            touches_border = int(r0 == 0 or c0 == 0 or r1 == h - 1 or c1 == w - 1)
+            dist = abs((r0 + r1) / 2.0 - center_r) + abs((c0 + c1) / 2.0 - center_c)
+            candidates.append((area, -touches_border, -int(round(dist * 10)), color, len(coords), (r0, c0, r1, c1)))
