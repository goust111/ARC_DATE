+
+
+def _combo_valid(combo: tuple[dict, ...], require_overlap: bool) -> bool:
+    endpoints: set[int] = set()
+    for record in combo:
+        a, b = record["endpoints"]
+        if a in endpoints or b in endpoints:
+            return False
+        endpoints.add(a)
+        endpoints.add(b)
