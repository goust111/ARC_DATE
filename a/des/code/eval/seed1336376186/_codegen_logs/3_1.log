+
+def _rect_area(rect: tuple[int, int, int, int]) -> int:
+    r0, r1, c0, c1 = rect
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _split_options(rect: tuple[int, int, int, int]) -> list[str]:
+    r0, r1, c0, c1 = rect
+    options = []
+    if c1 - c0 + 1 >= 2 * MIN_REGION_SIDE + 1:
+        options.append("v")
+    if r1 - r0 + 1 >= 2 * MIN_REGION_SIDE + 1:
+        options.append("h")
+    return options
+
+
+def _apply_split(
+    grid: np.ndarray,
+    rects: list[tuple[int, int, int, int]],
+    index: int,
+    orientation: str,
+    cut: int,
+) -> None:
+    r0, r1, c0, c1 = rects.pop(index)
+    if orientation == "v":
+        grid[r0 - 1 : r1 + 2, cut] = GREY
+        rects.append((r0, r1, c0, cut - 1))
+        rects.append((r0, r1, cut + 1, c1))
+    else:
+        grid[cut, c0 - 1 : c1 + 2] = GREY
+        rects.append((r0, cut - 1, c0, c1))
+        rects.append((cut + 1, r1, c0, c1))
+
+
+def _generate_partition(rng: random.Random) -> np.ndarray | None:
+    h = rng.randrange(*GRID_H_RANGE)
+    w = rng.randrange(*GRID_W_RANGE)
+    grid = np.full((h, w), BLACK, dtype=int)
+    grid[0, :] = GREY
+    grid[-1, :] = GREY
+    grid[:, 0] = GREY
+    grid[:, -1] = GREY
+
+    rects = [(1, h - 2, 1, w - 2)]
+    target_regions = rng.randrange(*TARGET_REGION_RANGE)
+
+    for _ in range(target_regions - 1):
+        splittable = [(idx, _split_options(rect)) for idx, rect in enumerate(rects) if _split_options(rect)]
+        if not splittable:
+            break
+        weights = [_rect_area(rects[idx]) for idx, _ in splittable]
+        idx, options = rng.choices(splittable, weights=weights, k=1)[0]
+        orientation = rng.choice(options)
+        r0, r1, c0, c1 = rects[idx]
+        if orientation == "v":
