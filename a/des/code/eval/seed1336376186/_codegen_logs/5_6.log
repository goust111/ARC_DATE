+    template_w = int(rng.integers(6, min(11, half_w - 3)))
+    template_r0 = int(rng.integers(1, 4))
+    template_c0 = int(rng.integers(1, half_w - template_w))
+    template_bbox = (
+        template_r0,
+        template_c0,
+        template_r0 + template_h - 1,
+        template_c0 + template_w - 1,
