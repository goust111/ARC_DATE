+    return windows
+
+
+def _rotated_shape(h: int, w: int, k: int) -> tuple[int, int]:
+    return (h, w) if k % 2 == 0 else (w, h)
+
+
+def _destination_bbox(
+    sep: int, window_bbox: tuple[int, int, int, int], interior_shape: tuple[int, int], k: int
