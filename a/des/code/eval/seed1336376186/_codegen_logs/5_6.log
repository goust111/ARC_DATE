+        return None
+    if not np.any(out[:, sep + 1 :] != BG):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(MAX_GEN_ATTEMPTS):
