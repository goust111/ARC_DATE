+def _paint_window(
+    grid: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    mask: np.ndarray,
+    marker_color: int,
+    marker_pos: tuple[int, int],
+) -> None:
+    r0, c0, r1, c1 = bbox
+    grid[r0 : r1 + 1, c0 : c1 + 1] = BG
+    grid[r0, c0 : c1 + 1] = GREY
+    grid[r1, c0 : c1 + 1] = GREY
+    grid[r0 : r1 + 1, c0] = GREY
+    grid[r0 : r1 + 1, c1] = GREY
+
