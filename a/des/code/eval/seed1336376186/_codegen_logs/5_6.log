+    local[comp[:, 0] - r0, comp[:, 1] - c0] = True
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return bool(np.array_equal(local, border))
+
+
+def _find_windows(left: np.ndarray) -> list[tuple[int, int, int, int]]:
+    grey_comps = _components(left == GREY)
