+    grid[r0, c0 : c1 + 1] = GREY
+    grid[r1, c0 : c1 + 1] = GREY
+    grid[r0 : r1 + 1, c0] = GREY
+    grid[r0 : r1 + 1, c1] = GREY
+
+    interior = grid[r0 + 1 : r1, c0 + 1 : c1]
+    interior[mask] = RED
+    mr, mc = marker_pos
+    interior[mr, mc] = marker_color
