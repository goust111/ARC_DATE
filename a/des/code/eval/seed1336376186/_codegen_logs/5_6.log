+
+def _window_piece(template: np.ndarray, mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    piece = np.full((h, w), BG, dtype=int)
+    piece[mask] = template[:h, :w][mask]
+    return piece
