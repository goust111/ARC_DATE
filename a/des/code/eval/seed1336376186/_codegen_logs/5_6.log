+        if np.any(painted):
+            region = occupied[dr0 : dr1 + 1, dc0 : dc1 + 1]
+            assert not np.any(region & painted), "transformed pieces must not overlap"
+            out[dr0 : dr1 + 1, dc0 : dc1 + 1][painted] = rotated[painted]
+            region |= painted
