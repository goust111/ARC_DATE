+        piece = np.full((ih, iw), BG, dtype=int)
+        piece[mask] = template[:ih, :iw][mask]
+        rotated = np.rot90(piece, -k)
+
+        dr0, dc0, dr1, dc1 = _destination_bbox(sep, bbox, (ih, iw), k)
+        assert 0 <= dr0 <= dr1 < h
+        assert sep + 1 <= dc0 <= dc1 < w
