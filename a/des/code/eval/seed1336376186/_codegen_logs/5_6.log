+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+
+MARKER_TO_ROT = {
+    GREEN: 0,
+    YELLOW: 1,
+    BLUE: 2,
+    MAGENTA: 3,
+}
+
+TEMPLATE_COLORS = (7, 8, 9)
+MAX_GEN_ATTEMPTS = 300
