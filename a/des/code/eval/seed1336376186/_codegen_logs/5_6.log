+
+
+def _is_border_component(comp: np.ndarray) -> bool:
+    r0, c0, r1, c1 = _bbox(comp)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
