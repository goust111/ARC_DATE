+        marker_coords = np.argwhere(np.isin(interior, list(MARKER_TO_ROT)))
+        assert marker_coords.shape[0] == 1, "window must contain exactly one marker"
+        mr, mc = map(int, marker_coords[0])
+        k = MARKER_TO_ROT[int(interior[mr, mc])]
