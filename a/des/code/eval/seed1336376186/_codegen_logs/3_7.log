+def _infer_motion(patch: np.ndarray, fill: int) -> tuple[int, int]:
+    candidates = _symmetry_candidates(patch, fill)
+    assert len(candidates) == 1, "object must have a unique valid symmetry defect direction"
+    return candidates[0]
