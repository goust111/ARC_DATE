+
+def _pair_lists(mask: np.ndarray, orientation: str) -> tuple[list[tuple[tuple[int, int], tuple[int, int]]], list[tuple[int, int]]]:
+    h, w = mask.shape
+    pairs: list[tuple[tuple[int, int], tuple[int, int]]] = []
+    axes: list[tuple[int, int]] = []
+    for r in range(h):
