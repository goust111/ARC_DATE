+    inp = _render_input(objects, positions, (h, w))
+    expected = _render_output(objects, positions, (h, w))
+    if not np.array_equal(main(inp), expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GENERATE_RETRIES):
