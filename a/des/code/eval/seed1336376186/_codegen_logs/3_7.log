+    occ = np.zeros_like(interior, dtype=bool)
+    for a, b in chosen_pairs:
+        occ[a] = True
+        occ[b] = True
+
+    axis_take = 0
+    if axes:
+        axis_take = rng.randint(0, min(len(axes), max(1, len(axes) // 2)))
+    if axis_take:
+        for cell in rng.sample(axes, axis_take):
+            occ[cell] = True
