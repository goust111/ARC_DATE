+    return grid
+
+
+def _render_output(objects: list[dict], positions: list[tuple[int, int]], shape: tuple[int, int]) -> np.ndarray:
+    out = np.full(shape, BG, dtype=int)
+    merged = []
+    for obj, (r0, c0) in zip(objects, positions):
+        h, w = obj["patch"].shape
+        merged.append(
+            {
+                "bbox": (r0, c0, r0 + h - 1, c0 + w - 1),
+                "patch": obj["patch"],
+                "fill": obj["fill"],
+                "move": obj["move"],
+            }
+        )
