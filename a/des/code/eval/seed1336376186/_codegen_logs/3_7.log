+    if np.array_equal(occ, occ[::-1, :]):
+        signs = set()
+        ok = True
+        for r, c in orange:
+            mr = h - 1 - int(r)
+            if mr == int(r) or int(patch[mr, int(c)]) != fill:
+                ok = False
+                break
+            signs.add(1 if int(r) > mr else -1)
+        if ok and len(signs) == 1:
+            candidates.append((len(orange) * next(iter(signs)), 0))
