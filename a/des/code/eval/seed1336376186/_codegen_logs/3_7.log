+    for _ in range(PLACEMENT_RETRIES):
+        positions: list[tuple[int, int]] = []
+        ok = True
+        for obj in objects:
+            ph, pw = obj["patch"].shape
+            dr, dc = obj["move"]
+            min_r = 1 + max(0, -dr)
+            max_r = h - ph - 2 - max(0, dr)
+            min_c = 1 + max(0, -dc)
+            max_c = w - pw - 2 - max(0, dc)
+            if min_r > max_r or min_c > max_c:
