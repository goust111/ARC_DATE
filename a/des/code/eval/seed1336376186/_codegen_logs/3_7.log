+    for obj in sorted(objects, key=_paint_order, reverse=True):
+        patch = obj["patch"].copy()
+        patch[patch == ORANGE] = int(obj["fill"])
+        r0, c0, _r1, _c1 = obj["bbox"]
+        dr, dc = obj["move"]
+        _paste_stamp(out, patch, r0 + dr, c0 + dc)
