+BG = 0
+GREY = 5
+ORANGE = 7
+FILL_COLORS = (1, 2, 3, 4, 6, 8, 9)
+
+GRID_H_RANGE = (20, 30)
+GRID_W_RANGE = (20, 30)
+OBJECT_COUNT_RANGE = (2, 4)
