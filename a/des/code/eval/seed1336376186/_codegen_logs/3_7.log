+L_W_RANGE = (8, 12)
+DEFECT_COUNT_RANGE = (1, 4)
+LOCAL_RETRIES = 200
+PLACEMENT_RETRIES = 250
+GENERATE_RETRIES = 300
+OVERLAP_PROB = 0.35
