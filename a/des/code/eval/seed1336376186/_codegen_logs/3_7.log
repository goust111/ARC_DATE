+    src_r0 = rr0 - top
+    src_c0 = cc0 - left
+    src_r1 = src_r0 + (rr1 - rr0)
+    src_c1 = src_c0 + (cc1 - cc0)
+    src = patch[src_r0:src_r1, src_c0:src_c1]
