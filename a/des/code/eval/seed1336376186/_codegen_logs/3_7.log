+def _local_patch_from_pattern(
+    border: np.ndarray,
+    occ: np.ndarray,
+    fill: int,
+    orientation: str,
+    sign: int,
+    defect_count: int,
+    rng: random.Random,
+) -> np.ndarray | None:
