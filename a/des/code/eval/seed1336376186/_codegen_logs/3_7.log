+        dr, dc = obj["move"]
+        _paste_stamp(out, patch, r0 + dr, c0 + dc)
+    return out
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    count = rng.randint(OBJECT_COUNT_RANGE[0], OBJECT_COUNT_RANGE[1])
