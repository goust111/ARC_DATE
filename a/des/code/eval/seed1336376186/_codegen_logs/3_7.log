+def _paint_order(obj: dict) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = obj["bbox"]
+    return c1, r1, c0, r0
+
+
+def _paste_stamp(out: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    h, w = patch.shape
+    rr0 = max(0, top)
+    cc0 = max(0, left)
