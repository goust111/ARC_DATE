+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+ORANGE = 7
+FILL_COLORS = (1, 2, 3, 4, 6, 8, 9)
+
+GRID_H_RANGE = (20, 30)
+GRID_W_RANGE = (20, 30)
+OBJECT_COUNT_RANGE = (2, 4)
+RECT_H_RANGE = (7, 11)
+RECT_W_RANGE = (7, 11)
+L_H_RANGE = (8, 12)
+L_W_RANGE = (8, 12)
+DEFECT_COUNT_RANGE = (1, 4)
+LOCAL_RETRIES = 200
+PLACEMENT_RETRIES = 250
+GENERATE_RETRIES = 300
+OVERLAP_PROB = 0.35
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MOTION_CHOICES = (
+    ("vertical", -1),
+    ("vertical", 1),
+    ("horizontal", -1),
+    ("horizontal", 1),
+)
