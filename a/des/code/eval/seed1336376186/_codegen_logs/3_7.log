+def _components4(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _outside_mask(passable: np.ndarray) -> np.ndarray:
+    h, w = passable.shape
+    outside = np.zeros_like(passable, dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if passable[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if passable[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIR4:
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w and passable[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+    return outside
+
+
+def _symmetry_candidates(patch: np.ndarray, fill: int) -> list[tuple[int, int]]:
+    occ = (patch == fill) | (patch == ORANGE)
+    orange = np.argwhere(patch == ORANGE)
+    if orange.size == 0:
+        return []
+
+    h, w = patch.shape
+    candidates: list[tuple[int, int]] = []
+
+    if np.array_equal(occ, occ[:, ::-1]):
+        signs = set()
+        ok = True
+        for r, c in orange:
+            mc = w - 1 - int(c)
+            if mc == int(c) or int(patch[int(r), mc]) != fill:
+                ok = False
+                break
+            signs.add(1 if int(c) > mc else -1)
+        if ok and len(signs) == 1:
