+    if int(np.count_nonzero(occ)) <= defect_count:
+        return None
+    if not _is_symmetric(occ, orientation):
+        return None
+    other = "horizontal" if orientation == "vertical" else "vertical"
+    if _is_symmetric(occ, other):
