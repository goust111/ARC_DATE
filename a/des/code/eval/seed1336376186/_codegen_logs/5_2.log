+) -> list[tuple[int, int]]:
+    candidates = [node for node, neighbors in adj.items() if neighbors]
+    best: list[tuple[int, int]] = []
+    best_score = (-1, -1, -1)
+
+    for _ in range(SOURCE_SET_RETRIES):
+        order = candidates[:]
+        random.shuffle(order)
+        chosen: list[tuple[int, int]] = []
+        used: set[tuple[int, int]] = set()
+        for node in order:
+            neighbors = adj[node]
+            if node in used:
