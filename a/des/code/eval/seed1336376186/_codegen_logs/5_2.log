+
+def _paint_patch(
+    grid: np.ndarray,
+    box: tuple[int, int, int, int],
+    patch: np.ndarray,
+) -> tuple[int, int]:
+    r0, r1, c0, c1 = box
+    ph, pw = patch.shape
+    start_r = random.randint(r0, r1 - ph + 1)
+    start_c = random.randint(c0, c1 - pw + 1)
