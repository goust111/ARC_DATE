+    patches: dict[tuple[int, int], np.ndarray] = {}
+    occupied: dict[tuple[int, int], bool] = {}
+
+    for i, (r0, r1) in enumerate(row_bands):
+        for j, (c0, c1) in enumerate(col_bands):
+            box = (r0, r1, c0, c1)
+            regions[(i, j)] = box
+            region = g[r0 : r1 + 1, c0 : c1 + 1]
