+        box = (row_bands[i][0], row_bands[i][1], col_bands[j][0], col_bands[j][1])
+        _paint_patch(inp, box, patch)
+
+    expected = _render_expected(
+        inp,
+        row_bands,
+        col_bands,
+        sep_rows,
+        sep_cols,
+        row_gap_pos,
+        col_gap_pos,
+        sources,
+        source_patches,
+        adj,
+    )
+
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
