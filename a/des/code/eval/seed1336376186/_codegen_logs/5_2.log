+            col_gap_pos[sep_c] = random.randint(rng[0], rng[1])
+        else:
+            col_gap_pos[sep_c] = random.randint(r0, r1)
+
+    height = row_bands[-1][1] + 1
+    width = col_bands[-1][1] + 1
+    inp = np.full((height, width), BG, dtype=int)
