+
+def _neighbor_side(src: tuple[int, int], dst: tuple[int, int]) -> str:
+    sr, sc = src
+    dr, dc = dst
+    if dr == sr - 1 and dc == sc:
+        return "top"
+    if dr == sr + 1 and dc == sc:
+        return "bottom"
+    if dr == sr and dc == sc - 1:
+        return "left"
+    if dr == sr and dc == sc + 1:
+        return "right"
+    raise AssertionError("expected an orthogonally adjacent region")
