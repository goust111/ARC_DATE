+BG = 8
+GREY = 5
+MAROON = 9
+SCENE_COLORS = (0, 1, 2, 3, 4, 6, 7)
+STYLES = ("square", "diamond", "cross")
+GEN_RETRIES = 400
+
+STYLE_MASKS = {
+    "square": np.array(
+        [
+            [1, 1, 1],
+            [1, 0, 1],
+            [1, 1, 1],
+        ],
+        dtype=bool,
+    ),
+    "diamond": np.array(
+        [
