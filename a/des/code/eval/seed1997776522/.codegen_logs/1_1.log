+}
+
+STYLE_KEYS = {
+    tuple(tuple(int(v) for v in row) for row in mask.astype(int)): style
+    for style, mask in STYLE_MASKS.items()
+}
+DIGIT_KEYS = {
+    tuple(tuple(int(v) for v in row) for row in mask.astype(int)): digit
+    for digit, mask in DIGIT_MASKS.items()
