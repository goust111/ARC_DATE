+
+def _contiguous_runs(indices: list[int]) -> list[tuple[int, int]]:
+    if not indices:
+        return []
+    runs: list[tuple[int, int]] = []
+    start = prev = indices[0]
+    for idx in indices[1:]:
+        if idx == prev + 1:
+            prev = idx
+            continue
+        runs.append((int(start), int(prev)))
+        start = prev = idx
+    runs.append((int(start), int(prev)))
