+
+
+def _expected_output(assembled: np.ndarray, frame_color: int) -> np.ndarray:
+    h, w = assembled.shape
+    out = np.full((h + 2, w + 2), BLACK, dtype=int)
+    out[0, :] = frame_color
+    out[-1, :] = frame_color
