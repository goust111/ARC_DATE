+    raise RuntimeError("failed to sample a distinctive jagged profile")
+
+
+def _make_vertical_strips(rng: random.Random) -> tuple[list[np.ndarray], np.ndarray]:
+    count = rng.randint(2, 4)
+    height = rng.randint(4, 7)
