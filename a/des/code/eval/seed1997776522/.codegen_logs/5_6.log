+            stop = int(widths[idx] - right_gap[r])
+            assert stop > start
+            sprite[r, start:stop] = colors[idx]
+            for c in range(start, stop):
+                rr = r
+                cc = x + c
+                assert not filled[rr, cc]
+                filled[rr, cc] = True
