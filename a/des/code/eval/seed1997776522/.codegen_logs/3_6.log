+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+YELLOW = 4
+GEAR_COLORS = (1, 3, 5, 6, 7, 8, 9)
+
+TIP_ORDER = ("up", "right", "down", "left")
+TIP_OFFSETS = {
+    "up": (-2, 0),
+    "right": (0, 2),
+    "down": (2, 0),
+    "left": (0, -2),
+}
+BODY_OFFSETS = tuple(
+    (dr, dc)
+    for dr in range(-1, 2)
+    for dc in range(-1, 2)
+) + ((0, -2), (0, 2), (-2, 0), (2, 0))
+GEAR_OFFSETS = frozenset(BODY_OFFSETS)
+BODY_ONLY_OFFSETS = frozenset((dr, dc) for dr, dc in BODY_OFFSETS if (dr, dc) not in TIP_OFFSETS.values())
+GEAR_AREA = len(GEAR_OFFSETS)
+
+ARROW_SHAPES = {
+    "cw": ((0, 1), (1, 0), (1, 1)),
+    "ccw": ((0, 0), (1, 0), (1, 1)),
+}
+ARROW_BBOX_ANCHOR = {
+    "up": (-4, -1),
+    "right": (-1, 3),
+    "down": (3, -1),
+    "left": (-1, -4),
+}
+DIR_TO_STEP = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
+
+GEN_RETRIES = 300
+BOARD_SIDE_RANGE = (3, 5)
+CONNECTED_GEAR_RANGE = (2, 5)
+ISOLATED_GEAR_RANGE = (0, 2)
+MARGIN_RANGE = (2, 5)
