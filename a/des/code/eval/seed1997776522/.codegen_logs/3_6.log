+            if not ok or marker_dir is None:
+                continue
+
+            for dr in range(-2, 3):
+                for dc in range(-2, 3):
+                    rr = r + dr
+                    cc = c + dc
+                    if (dr, dc) in GEAR_OFFSETS:
+                        continue
+                    if int(g[rr, cc]) != BLACK:
+                        ok = False
