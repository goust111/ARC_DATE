+            if not ok:
+                continue
+
+            marker_dir = None
+            for direction in TIP_ORDER:
+                tr, tc = _tip_cell((r, c), direction)
+                value = int(g[tr, tc])
+                if value == RED:
+                    if marker_dir is not None:
