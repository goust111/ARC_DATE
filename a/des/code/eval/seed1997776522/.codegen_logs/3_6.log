+) -> dict[tuple[int, int], str]:
+    adj: dict[tuple[int, int], list[tuple[int, int]]] = {gear["cell"]: [] for gear in gears}
+    for a, b in edges:
+        adj[a].append(b)
+        adj[b].append(a)
+
+    depth = {driver_cell: 0}
+    queue: deque[tuple[int, int]] = deque([driver_cell])
+    while queue:
+        node = queue.popleft()
+        for nxt in adj[node]:
+            if nxt not in depth:
+                depth[nxt] = depth[node] + 1
+                queue.append(nxt)
+
