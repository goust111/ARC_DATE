+ISOLATED_GEAR_RANGE = (0, 2)
+MARGIN_RANGE = (2, 5)
+
+
+def _components4(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    mask = np.asarray(mask, dtype=bool)
