+    base_step = _rotation_step(drive_rotation)
+    for idx, gear in enumerate(gears):
+        if idx not in depth:
+            continue
+        step = base_step if depth[idx] % 2 == 0 else -base_step
+        old_idx = TIP_ORDER.index(gear["marker_dir"])
+        new_dirs[idx] = TIP_ORDER[(old_idx + step) % 4]
+    return new_dirs
