+
+def _gap_direction(
+    gap_r: int, gap_c: int, r0: int, c0: int, r1: int, c1: int
+) -> str | None:
+    if gap_r == r0 and c0 < gap_c < c1:
+        return "up"
+    if gap_r == r1 and c0 < gap_c < c1:
+        return "down"
+    if gap_c == c0 and r0 < gap_r < r1:
+        return "left"
+    if gap_c == c1 and r0 < gap_r < r1:
+        return "right"
+    return None
