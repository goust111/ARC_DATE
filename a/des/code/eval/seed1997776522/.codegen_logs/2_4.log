+import random
+import numpy as np
+
+
+BG = 0
+DIRECTIONS = ("up", "right", "down", "left")
+ROTATION_STEPS = {"up": 0, "right": 3, "down": 2, "left": 1}
+MAX_GENERATION_ATTEMPTS = 400
+MAX_PLACEMENT_ATTEMPTS = 500
