+    cell_size = random.choice(CELL_SIZES)
+    size = n * cell_size + (n - 1)
+    grid = np.full((size, size), BG, dtype=int)
+
+    for k in range(1, n):
+        pos = k * cell_size + (k - 1)
+        grid[pos, :] = SEP
