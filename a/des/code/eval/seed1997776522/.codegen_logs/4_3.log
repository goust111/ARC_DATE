+            col_diffs = [cols[i + 1] - cols[i] for i in range(len(cols) - 1)]
+            if len(set(row_diffs)) != 1 or len(set(col_diffs)) != 1:
+                continue
+            if row_diffs[0] != col_diffs[0]:
+                continue
+            cell_size = int(row_diffs[0] - 1)
