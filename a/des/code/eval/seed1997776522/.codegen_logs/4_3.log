+        cs = _cell_slice(col_idx, cell_size)
+        for key, color in zip(chosen_keys, chosen_colors, strict=False):
+            r, c = random.choice(groups[key])
+            grid[rs.start + r, cs.start + c] = int(color)
+
+    return grid
