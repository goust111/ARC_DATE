+    for row_idx in range(1, n):
+        for col_idx in range(1, n):
+            rs = _cell_slice(row_idx, cell_size)
+            cs = _cell_slice(col_idx, cell_size)
+            cell = g[rs, cs]
+            seed_mask = (cell != bg) & (cell != instr_color) & (cell != sep_color)
+            seeds = np.argwhere(seed_mask)
+            if seeds.size == 0:
+                continue
