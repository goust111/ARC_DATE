+            dc = col_dirs[col_idx - 1]
+            for sr, sc in seeds:
+                color = int(cell[int(sr), int(sc)])
+                r = int(sr)
+                c = int(sc)
+                while 0 <= r < cell_size and 0 <= c < cell_size:
