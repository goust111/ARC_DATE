+            continue
+        q = deque([start])
+        seen.add(start)
+        comp: list[tuple[int, int]] = []
+        while q:
+            cur = q.popleft()
+            comp.append(cur)
+            for nxt in _neighbors4(cur[0], cur[1], h, w):
+                if nxt in cells and nxt not in seen:
+                    seen.add(nxt)
+                    q.append(nxt)
+        comps.append(comp)
+    return comps
