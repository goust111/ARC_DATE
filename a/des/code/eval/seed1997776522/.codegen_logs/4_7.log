+def _components_from_cells(cells: set[tuple[int, int]], h: int, w: int) -> list[list[tuple[int, int]]]:
+    comps: list[list[tuple[int, int]]] = []
+    seen: set[tuple[int, int]] = set()
+    for start in cells:
