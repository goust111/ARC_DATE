+    return out
+
+
+def _choose_lengths(seg_count: int) -> list[int]:
+    lengths = [random.randint(1, 6) for _ in range(seg_count)]
+    if seg_count == 5 and random.random() < 0.5:
+        lengths[2] = random.randint(1, 7)
