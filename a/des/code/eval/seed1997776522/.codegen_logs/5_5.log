+def _choose_door_count(rng: random.Random) -> int:
+    choice = rng.choice((1, 2, 3))
+    if choice < 3:
+        return choice
+    return rng.randint(3, 4)
+
+
+def _choose_door_sides(rng: random.Random, door_count: int) -> list[str]:
