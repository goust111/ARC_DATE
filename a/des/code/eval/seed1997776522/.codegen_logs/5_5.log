    - Cells hit by multiple rays become magenta.
    """
    g = np.asarray(grid, dtype=int)
    out = g.copy()

    for room in _find_rooms(g):
        r0, c0, r1, c1 = room["bbox"]
        doors = room["doors"]
        if len(doors) == 1:
            fill = int(doors[0]["source"])
        elif len(doors) == 2:
            fill = RED
        else:
            fill = YELLOW

        hits: dict[tuple[int, int], int] = {}
