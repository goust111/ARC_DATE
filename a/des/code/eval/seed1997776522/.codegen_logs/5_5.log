import random
from collections import defaultdict

import numpy as np


BLACK = 0
RED = 2
YELLOW = 4
GREY = 5
MAGENTA = 6

SOURCE_COLORS = (1, 3, 7, 8, 9)

GRID_MIN = 18
GRID_MAX = 30
ROOM_COUNT_MIN = 1
ROOM_COUNT_MAX = 4
ROOM_PADDING = 3
OUTER_SIZE_MIN = 5
OUTER_SIZE_MAX = 11
GEN_RETRIES = 400


def _inside(h: int, w: int, r: int, c: int) -> bool:
    return 0 <= r < h and 0 <= c < w


def _prefix_sum(mask: np.ndarray) -> np.ndarray:
    return np.pad(mask.astype(np.int32), ((1, 0), (1, 0))).cumsum(0).cumsum(1)


def _rect_sum(prefix: np.ndarray, r0: int, c0: int, r1: int, c1: int) -> int:
    if r0 > r1 or c0 > c1:
        return 0
    return int(
        prefix[r1 + 1, c1 + 1]
        - prefix[r0, c1 + 1]
        - prefix[r1 + 1, c0]
        + prefix[r0, c0]
    )


def _find_corners(grid: np.ndarray) -> tuple[list[tuple[int, int]], ...]:
    h, w = grid.shape
    tl: list[tuple[int, int]] = []
    tr: list[tuple[int, int]] = []
    bl: list[tuple[int, int]] = []
    br: list[tuple[int, int]] = []

    for r in range(h):
        for c in range(w):
            if int(grid[r, c]) != GREY:
                continue
            if (
                r + 1 < h
                and c + 1 < w
                and int(grid[r, c + 1]) == GREY
                and int(grid[r + 1, c]) == GREY
                and int(grid[r + 1, c + 1]) == BLACK
            ):
                tl.append((r, c))
            if (
                r + 1 < h
                and c - 1 >= 0
                and int(grid[r, c - 1]) == GREY
                and int(grid[r + 1, c]) == GREY
                and int(grid[r + 1, c - 1]) == BLACK
            ):
                tr.append((r, c))
            if (
                r - 1 >= 0
                and c + 1 < w
                and int(grid[r, c + 1]) == GREY
                and int(grid[r - 1, c]) == GREY
                and int(grid[r - 1, c + 1]) == BLACK
            ):
                bl.append((r, c))
            if (
                r - 1 >= 0
                and c - 1 >= 0
                and int(grid[r, c - 1]) == GREY
                and int(grid[r - 1, c]) == GREY
                and int(grid[r - 1, c - 1]) == BLACK
            ):
                br.append((r, c))
    return tl, tr, bl, br


def _door_source(
    grid: np.ndarray,
    r: int,
    c: int,
    dr_out: int,
    dc_out: int,
    dr_in: int,
    dc_in: int,
) -> int | None:
    h, w = grid.shape
    ro, co = r + dr_out, c + dc_out
    ri, ci = r + dr_in, c + dc_in
    if not (_inside(h, w, ro, co) and _inside(h, w, ri, ci)):
        return None
    source = int(grid[ro, co])
    if source in (BLACK, GREY):
        return None
    if int(grid[ri, ci]) != BLACK:
        return None
    return source


def _analyze_room(
    grid: np.ndarray,
    prefix: np.ndarray,
    r0: int,
    c0: int,
    r1: int,
    c1: int,
) -> dict | None:
    if r1 - r0 < 4 or c1 - c0 < 4:
        return None
    if _rect_sum(prefix, r0 + 1, c0 + 1, r1 - 1, c1 - 1) != 0:
        return None

    doors: list[dict] = []

    for c in range(c0 + 1, c1):
        v = int(grid[r0, c])
        if v == GREY:
