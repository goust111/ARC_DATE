+    h, w = reserve.shape
+    positions: list[tuple[int, int]] = []
+    r_stop = h - outer_h - ROOM_PADDING + 1
+    c_stop = w - outer_w - ROOM_PADDING + 1
+    for r0 in range(ROOM_PADDING, r_stop):
