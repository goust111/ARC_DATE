+        if v == GREY:
+            continue
+        if v != BLACK:
+            return None
+        source = _door_source(grid, r1, c, 1, 0, -1, 0)
+        if source is None:
+            return None
+        doors.append({"pos": (r1, c), "dir": (-1, 0), "source": source})
+
