+        if v == GREY:
+            continue
+        if v != BLACK:
+            return None
+        source = _door_source(grid, r, c1, 0, 1, 0, -1)
+        if source is None:
+            return None
+        doors.append({"pos": (r, c1), "dir": (0, -1), "source": source})
+
+    if not doors:
+        return None
+
+    return {
