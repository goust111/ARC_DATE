+    for room in _find_rooms(g):
+        r0, c0, r1, c1 = room["bbox"]
+        doors = room["doors"]
+        if len(doors) == 1:
+            fill = int(doors[0]["source"])
+        elif len(doors) == 2:
+            fill = RED
+        else:
+            fill = YELLOW
+
+        hits: dict[tuple[int, int], int] = {}
+        for door in doors:
+            r, c = door["pos"]
+            dr, dc = door["dir"]
+            rr, cc = r + dr, c + dc
+            while r0 < rr < r1 and c0 < cc < c1:
+                hits[(rr, cc)] = hits.get((rr, cc), 0) + 1
+                rr += dr
+                cc += dc
+
+        for (r, c), count in hits.items():
