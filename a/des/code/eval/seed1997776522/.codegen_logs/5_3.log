+        if random.random() < 0.5:
+            r0, r1 = _random_span(h, 1, max(1, h - 1))
+            out[r0:r1, :] = color
+        else:
+            c0, c1 = _random_span(w, 1, max(1, w - 1))
+            out[:, c0:c1] = color
+
+    for _ in range(random.randint(1, 2)):
+        r0, r1 = _random_span(h, 1, max(1, h - 1))
+        c0, c1 = _random_span(w, 1, max(1, w - 1))
+        out[r0:r1, c0:c1] = random.choice(palette)
