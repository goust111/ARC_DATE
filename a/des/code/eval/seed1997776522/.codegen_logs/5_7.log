+def _pattern_patch(color: int, pattern_name: str) -> np.ndarray:
+    patch = np.full((3, 3), GREY, dtype=int)
+    for r, c in _PATTERN_SPECS[pattern_name]["cells"]:
+        patch[r, c] = color
