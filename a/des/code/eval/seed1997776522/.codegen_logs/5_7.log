+
+def _draw_seed_structure(grid: np.ndarray, seed: tuple[int, int, int, str]) -> None:
+    r, c, color, pattern_name = seed
+    grid[r - 4 : r - 1, c - 1 : c + 2] = _pattern_patch(color, pattern_name)
+    grid[r, c] = color
