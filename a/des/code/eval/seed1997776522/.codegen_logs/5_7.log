+    "vertical": {
+        "cells": ((0, 1), (1, 1), (2, 1)),
+        "dirs": ((-1, 0), (1, 0)),
+    },
+    "plus": {
+        "cells": ((0, 1), (1, 0), (1, 1), (1, 2), (2, 1)),
+        "dirs": ((-1, 0), (1, 0), (0, -1), (0, 1)),
+    },
+    "x": {
+        "cells": ((0, 0), (0, 2), (1, 1), (2, 0), (2, 2)),
+        "dirs": ((-1, -1), (-1, 1), (1, -1), (1, 1)),
+    },
+    "full": {
+        "cells": (
+            (0, 0), (0, 1), (0, 2),
