+BLACK = 0
+RED = 2
+YELLOW = 4
+GREY = 5
+
+SPECIAL_COLORS = {BLACK, RED, YELLOW, GREY}
+
+_PATTERN_SPECS: dict[str, dict[str, tuple[tuple[int, int], ...]]] = {
+    "horizontal": {
+        "cells": ((1, 0), (1, 1), (1, 2)),
+        "dirs": ((0, -1), (0, 1)),
