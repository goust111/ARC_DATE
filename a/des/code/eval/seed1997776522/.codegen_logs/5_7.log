+_GEN_SEED_COLORS = np.array([1, 3, 6, 7, 8, 9], dtype=int)
+_GEN_PATTERN_NAMES = tuple(_PATTERN_SPECS.keys())
+_GEN_TIE_MODES = ("horizontal", "vertical", "diag_down", "diag_up")
