+        next_frontiers = [set() for _ in seeds]
+        for (r, c), owner in proposals.items():
+            if owner == tied:
+                occupied[r, c] = tied
+                out[r, c] = YELLOW
+                continue
+            occupied[r, c] = owner
+            out[r, c] = seeds[owner][2]
+            next_frontiers[owner].add((r, c))
+        frontiers = next_frontiers
+
+    return out
