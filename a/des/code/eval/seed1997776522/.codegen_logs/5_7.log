+            if not np.all(grid[r - 1, c - 1 : c + 2] == BLACK):
+                continue
+            if not np.all((block == GREY) | (block == color)):
+                continue
+
+            pattern_cells = frozenset(
+                (rr, cc)
+                for rr in range(3)
+                for cc in range(3)
+                if int(block[rr, cc]) == color
+            )
+            dirs = _PATTERN_LOOKUP.get(pattern_cells)
+            if dirs is None:
+                continue
+            if (r, c) in seen_positions:
+                continue
