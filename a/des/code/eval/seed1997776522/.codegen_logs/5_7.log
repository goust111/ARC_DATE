+def _decode_seeds(grid: np.ndarray) -> list[_Seed]:
+    h, w = grid.shape
+    seeds: list[_Seed] = []
+    seen_positions: set[tuple[int, int]] = set()
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color in SPECIAL_COLORS:
+                continue
+            if r < 4 or c < 1 or c + 1 >= w:
+                continue
+            block = grid[r - 4 : r - 1, c - 1 : c + 2]
+            if block.shape != (3, 3):
