+    order = []
+    prev = -1
+    cur = start
+    while True:
+        order.append(cur)
+        nxt = [idx for idx in adj[cur] if idx != prev]
+        if not nxt:
+            break
+        assert len(nxt) == 1, "piece contacts must not branch"
+        prev, cur = cur, nxt[0]
+        assert len(order) <= len(pieces), "piece traversal looped unexpectedly"
