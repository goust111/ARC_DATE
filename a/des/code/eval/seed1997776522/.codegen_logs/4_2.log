+BG = 0
+GREY = 5
+COLOR_SEQUENCE = [2, 1, 3, 4, 6]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_MIN = 20
+GRID_MAX = 28
+LOGICAL_H_CHOICES = (3, 4, 5)
