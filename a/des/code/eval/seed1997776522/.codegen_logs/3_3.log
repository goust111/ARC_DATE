+
+def _neighbor(region: RegionId, direction: str, shape: tuple[int, int]) -> RegionId | None:
+    dr, dc = DIRS[direction]
+    nr = region[0] + dr
+    nc = region[1] + dc
+    if 0 <= nr < shape[0] and 0 <= nc < shape[1]:
+        return (nr, nc)
+    return None
