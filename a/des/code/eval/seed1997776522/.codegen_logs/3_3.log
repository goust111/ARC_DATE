+    expected = input_grid.copy()
+    winners: dict[RegionId, tuple[int, int]] = {}
+    for chain in chains:
+        terminal = chain[-1]
+        steps = len(chain) - 1
+        color = arrow_color_by_region[chain[0]]
+        previous = winners.get(terminal)
