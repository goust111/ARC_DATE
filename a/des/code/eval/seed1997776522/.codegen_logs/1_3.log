+    max_w = max(piece.shape[1] for piece in pieces)
+    grid_h = int(_RNG.integers(max(18, max_h + 3), GRID_MAX + 1))
+    grid_w = int(_RNG.integers(max(18, max_w + 3), GRID_MAX + 1))
