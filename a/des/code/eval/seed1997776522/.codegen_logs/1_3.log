+
+    height = len(left_piece["profile"])
+    total_w = int(left_piece["profile"][0] + right_piece["profile"][0])
+    rect = np.full((height, total_w), bg, dtype=int)
+    for r, w1 in enumerate(left_piece["profile"]):
