import random

BG,BLUE,RED,GREEN=0,1,2,3

def left(d):
    dr,dc=d
    return (-dc,dr)

def right(d):
    dr,dc=d
    return (dc,-dr)

def in_bounds(shape,rc):
    r,c=rc
    return 0<=r<shape[0] and 0<=c<shape[1]

def on_border(shape,rc):
    r,c=rc
    H,W=shape
    return r in (0,H-1) or c in (0,W-1)

def non_corner(shape,rc):
    r,c=rc
    H,W=shape
    return on_border(shape,rc) and not (r in (0,H-1) and c in (0,W-1))

def neigh(rc):
    r,c=rc
    for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
        yield (r+dr,c+dc)

def valid_step(shape,seen,current,nxt,allow_border=False):
    if not in_bounds(shape,nxt) or nxt in seen:
        return False
    if on_border(shape,nxt) and not allow_border:
        return False
    adj=[p for p in neigh(nxt) if p in seen]
    return adj==[current] or set(adj)=={current}

def forward_options(shape,seen,path,direction,min_len,min_turns):
    current=path[-1]
    turns=0
    for i in range(2,len(path)):
        a=path[i-2]; b=path[i-1]; c=path[i]
        if (b[0]-a[0],b[1]-a[1]) "'!= (c[0]-b[0],c[1]-b[1]):
            turns += 1
    options=[]
    finals=[]
    for nd in [direction,left(direction),right(direction)]:
        nxt=(current[0]+nd[0],current[1]+nd[1])
        extra=1 if nd!=direction else 0
        if not in_bounds(shape,nxt) or nxt in seen:
            continue
        if on_border(shape,nxt):
            if non_corner(shape,nxt) and len(path)+1>=min_len and turns+extra>=min_turns and valid_step(shape,seen,current,nxt,allow_border=True):
                finals.append((nd,nxt))
            continue
        if valid_step(shape,seen,current,nxt,allow_border=False):
            # must have at least one onward move or potential finish later maybe skip lookahead for now
            options.append((nd,nxt))
    return options, finals

def build(H,W,min_turns=3,max_steps=40):
    shape=(H,W)
    start=(0, random.randint(1,W-2))
    path=[start,(1,start[1])]
    seen=set(path)
    direction=(1,0)
    min_len=random.randint(max(8,min_turns+5), max(9, H+W-3))
    for step in range(max_steps):
        options, finals = forward_options(shape,seen,path,direction,min_len,min_turns)
        if finals and (not options or len(path)>=min_len and random.random()<0.35):
            nd,nxt=random.choice(finals)
            path.append(nxt)
            return path
        if not options:
            if finals:
                nd,nxt=random.choice(finals)
                path.append(nxt)
                return path
            return None
        weights=[]
        for nd,nxt in options:
            w=4 if nd==direction else 3
            if step<min_turns and nd==direction:
                w=1
            weights.append(w)
        nd,nxt=random.choices(options,weights=weights,k=1)[0]
        direction=nd
        path.append(nxt)
        seen.add(nxt)
    return None

def choose_start(path,shape):
    # endpoints are first/last by construction but choose lexicographically among border endpoints
    endpoints=[path[0],path[-1]]
    endpoints=sorted(endpoints,key=lambda rc:(0 if on_border(shape,rc) else 1, rc[0], rc[1]))
    return endpoints[0]

def ordered(path, start):
    return path if path[0]==start else list(reversed(path))

def analyze(path,shape):
    start=choose_start(path,shape)
    p=ordered(path,start)
    s0,s1=p[0],p[1]
    d=(s1[0]-s0[0],s1[1]-s0[1])
    left_pos=(s0[0]+left(d)[0], s0[1]+left(d)[1])
    right_pos=(s0[0]+right(d)[0], s0[1]+right(d)[1])
    if not (in_bounds(shape,left_pos) and in_bounds(shape,right_pos)):
        return None
    occ={*p, left_pos, right_pos}
    blocked=0; placed=0; seen_targets=set()
    lturn=rturn=0
    for i in range(1,len(p)-1):
        a,b,c=p[i-1],p[i],p[i+1]
        di=(b[0]-a[0], b[1]-a[1]); do=(c[0]-b[0], c[1]-b[1])
        if di==do: continue
        cross=di[0]*do[1]-di[1]*do[0]
        if cross>0:
            lturn+=1
            t=(b[0]+right(di)[0], b[1]+right(di)[1])
        else:
            rturn+=1
            t=(b[0]+left(di)[0], b[1]+left(di)[1])
        if t in occ:
            blocked+=1
        else:
            placed+=1; occ.add(t)
        if t in seen_targets:
            pass
        seen_targets.add(t)
    return dict(blocked=blocked,placed=placed,lturn=lturn,rturn=rturn,len=len(p))

