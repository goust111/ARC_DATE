+
+
+def _on_edge(shape: tuple[int, int], cell: Coord) -> bool:
+    r, c = cell
+    h, w = shape
+    return r in (0, h - 1) or c in (0, w - 1)
+
+
+def _is_corner(shape: tuple[int, int], cell: Coord) -> bool:
+    r, c = cell
