+def _neighbors4(cell: Coord) -> list[Coord]:
+    r, c = cell
+    return [(r + dr, c + dc) for dr, dc in DIRS4]
+
+
+def _path_neighbors(path_cells: set[Coord], cell: Coord) -> list[Coord]:
+    return [nbr for nbr in _neighbors4(cell) if nbr in path_cells]
