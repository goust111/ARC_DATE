def _in_bounds(shape: tuple[int, int], cell: Coord) -> bool:
    r, c = cell
    return 0 <= r < shape[0] and 0 <= c < shape[1]


def _on_edge(shape: tuple[int, int], cell: Coord) -> bool:
    r, c = cell
    h, w = shape
    return r in (0, h - 1) or c in (0, w - 1)


