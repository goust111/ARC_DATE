+    sep_rows = set(_row_start(row_heights, r) - 1 for r in range(1, rows))
+    sep_cols = set(_col_start(col_widths, c) - 1 for c in range(1, cols))
+    for r in sep_rows:
+        grid[r, :] = GREY
+    for c in sep_cols:
