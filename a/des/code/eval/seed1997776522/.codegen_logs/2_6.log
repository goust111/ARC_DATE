+
+def _region_colors(grid: np.ndarray, gap_mask: np.ndarray) -> tuple[np.ndarray, dict[int, int]]:
+    barrier = (grid == GREY) | gap_mask
+    labels, comps = _component_map(~barrier)
+    comp_color: dict[int, int] = {}
+    for idx, pts in enumerate(comps):
