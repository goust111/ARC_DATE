+def _draw_connector(grid: np.ndarray, p1: tuple[int, int], p2: tuple[int, int], color: int, rng: random.Random) -> None:
+    if p1[0] == p2[0] or p1[1] == p2[1]:
+        _draw_straight(grid, p1, p2, color)
+        return
+    bend_a = (p1[0], p2[1])
+    bend_b = (p2[0], p1[1])
