+        gap = (lane, b_c1 + 1)
+        return (lane, a_c0), gap, (lane, b_c1)
+    if cell_b[0] > cell_a[0]:
+        gap = (a_r1 + 1, lane)
+        return (a_r1, lane), gap, (b_r0, lane)
+    gap = (b_r1 + 1, lane)
+    return (a_r0, lane), gap, (b_r1, lane)
+
