+        return (a_r1, lane), gap, (b_r0, lane)
+    gap = (b_r1 + 1, lane)
+    return (a_r0, lane), gap, (b_r1, lane)
+
+
+def _build_grid(rng: random.Random) -> np.ndarray | None:
+    rows = rng.randint(3, 4)
+    cols = rng.randint(3, 4)
+    row_heights = [6] * rows
+    col_widths = [6] * cols
