+    if len(coords) < 2:
+        return False
+    if len(np.unique(coords[:, 0])) == 1:
+        xs = np.sort(coords[:, 1])
+        return bool(np.all(np.diff(xs) == 1))
+    if len(np.unique(coords[:, 1])) == 1:
+        xs = np.sort(coords[:, 0])
+        return bool(np.all(np.diff(xs) == 1))
+    return False
