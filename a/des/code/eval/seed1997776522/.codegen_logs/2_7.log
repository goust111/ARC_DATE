+        adj_ids: set[int] = set()
+        for r, c in comp:
+            for dr, dc in DIR8:
+                nr, nc = int(r + dr), int(c + dc)
+                if 0 <= nr < h and 0 <= nc < w and g[nr, nc] == GREY:
+                    adj_ids.add(int(grey_id[nr, nc]))
