+        assert vals.size == 1, "legend color block must be monochrome"
+        r0, c0, r1, c1 = _bbox(comp)
+        assert int(comp.shape[0]) == 2 and r1 == r0 + 1 and c0 == c1, "legend block must be 2x1"
