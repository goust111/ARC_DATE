+
+
+def _is_t_oriented(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    if h < 2 or w < 3:
+        return False
+    for bar_h in range(1, h):
+        for stem_w in range(1, w - 1):
+            for stem_left in range(1, w - stem_w):
+                cand = np.zeros((h, w), dtype=bool)
+                cand[:bar_h, :] = True
+                cand[:, stem_left : stem_left + stem_w] = True
