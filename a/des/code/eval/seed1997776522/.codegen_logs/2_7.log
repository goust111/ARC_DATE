+def _is_l_oriented(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    if h < 2 or w < 2:
+        return False
+    for bar_h in range(1, h):
+        for bar_w in range(1, w):
+            cand = np.zeros((h, w), dtype=bool)
+            cand[:bar_h, :] = True
+            cand[:, :bar_w] = True
+            if np.array_equal(mask, cand):
+                return True
