+
+def _classify_shape(mask: np.ndarray) -> str:
+    mask = _trim(np.asarray(mask, dtype=bool))
+    assert mask.any(), "empty shape"
+    if bool(mask.all()):
+        return "rectangle"
+    for rot in range(4):
+        cur = np.rot90(mask, rot)
