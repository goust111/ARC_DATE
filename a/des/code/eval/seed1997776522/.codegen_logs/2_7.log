+
+
+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    out = np.zeros((h, w), dtype=bool)
+    pts = np.argwhere(mask)
+    for r, c in pts:
+        for dr, dc in DIR8 + [(0, 0)]:
+            nr, nc = int(r + dr), int(c + dc)
+            if 0 <= nr < h and 0 <= nc < w:
+                out[nr, nc] = True
