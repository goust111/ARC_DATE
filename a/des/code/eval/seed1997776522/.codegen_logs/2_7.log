+def _build_grid(
+    field: np.ndarray, color_map: dict[str, int], rng: random.Random
+) -> tuple[np.ndarray, list[tuple[int, int, int, int]]]:
+    groups = []
+    order = list(SHAPES)
+    rng.shuffle(order)
+    for shape in order:
+        groups.append(_render_legend_group(shape, color_map[shape], rng))
