+    left = rng.randint(1, total_w - need_w + 1)
+    thumb_bboxes: list[tuple[int, int, int, int]] = []
+    cursor = left
+    for group in groups:
+        gh, gw = group.shape
+        top = total_h - gh
+        grid[top : top + gh, cursor : cursor + gw] = np.where(group != 0, group, grid[top : top + gh, cursor : cursor + gw])
