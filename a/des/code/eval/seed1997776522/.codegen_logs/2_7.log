+            return None
+        if require_shared:
+            best = max(score for _, _, score in positions)
+            pool = [(r, c) for r, c, score in positions if score >= best - 1]
+            top, left = rng.choice(pool)
+        else:
+            top, left, _ = rng.choice(positions)
