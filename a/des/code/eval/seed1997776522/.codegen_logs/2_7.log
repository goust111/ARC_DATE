+
+def _render_outline_patch(interior: np.ndarray) -> np.ndarray:
+    h, w = interior.shape
+    padded = np.zeros((h + 2, w + 2), dtype=bool)
+    padded[1 : 1 + h, 1 : 1 + w] = interior
+    border = _dilate8(padded) & (~padded)
+    patch = np.zeros((h + 2, w + 2), dtype=int)
+    patch[border] = GREY
+    return patch
+
