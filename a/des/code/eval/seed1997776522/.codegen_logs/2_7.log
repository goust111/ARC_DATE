+def _overlay_mask(field_shape: tuple[int, int], mask: np.ndarray, top: int, left: int) -> np.ndarray:
+    full = np.zeros(field_shape, dtype=bool)
+    h, w = mask.shape
+    full[top : top + h, left : left + w] = mask
