+        occupied |= placed_mask
+        coords = np.argwhere(placed_mask)
+        placed.append(
+            {
+                "shape": spec["shape"],
+                "mask": spec["mask"],
+                "area": spec["area"],
+                "top": top,
+                "left": left,
+                "coords": coords,
