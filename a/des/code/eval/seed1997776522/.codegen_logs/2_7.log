+        if len(grey_pts):
+            r0, c0 = grey_pts.min(axis=0)
+            r1, c1 = grey_pts.max(axis=0)
+            thumb_bboxes.append((int(top + r0), int(cursor + c0), int(top + r1), int(cursor + c1)))
+        cursor += gw + gap
