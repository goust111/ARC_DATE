+    specs: list[dict[str, object]] = []
+    for shape in shapes:
+        picked = None
+        for _ in range(100):
+            mask = _make_region_mask(shape, rng)
+            area = int(mask.sum())
+            if area in used_areas:
+                continue
+            picked = {"shape": shape, "mask": mask, "area": area}
+            used_areas.add(area)
+            break
+        if picked is None:
+            return None
+        specs.append(picked)
+    return specs
+
