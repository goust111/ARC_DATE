+    out = g.copy()
+    regions.sort(key=lambda item: (-int(item["area"]), tuple(int(x) for x in item["bbox"])))
+    for region in regions:
+        color = mapping[str(region["shape"])]
+        coords = region["coords"]
+        out[coords[:, 0], coords[:, 1]] = color
