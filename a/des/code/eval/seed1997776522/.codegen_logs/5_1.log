+        sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+        inner = sub[1:-1, 1:-1]
+        colors = {int(v) for v in np.unique(inner) if int(v) not in (bg, frame_color)}
+        frames.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "inner": inner.copy(),
+                "color_set": frozenset(colors),
