    vb=stair(n,1,1,2 if n>5 else 1)
    hb=stair(n,1,1,2 if n>5 else 1)
    g=np.zeros((n,n),int)
    for r in range(n):
        for c in range(n):
            if c<=vb[r]: g[r,c]=2
            elif r<=hb[c]: g[r,c]=3
            else: g[r,c]=1
    return g

def make_four(n):
    vb=stair(n,1,1,2 if n>5 else 1)
    hb=stair(n,2,1,2 if n>5 else 1)
    g=np.zeros((n,n),int)
    for r in range(n):
        for c in range(n):
            if c<=vb[r] and r<=hb[c]: g[r,c]=4
            elif c>vb[r] and r<=hb[c]: g[r,c]=2
            elif c<=vb[r] and r>hb[c]: g[r,c]=3
            else: g[r,c]=1
    return g

