+            continue
+        templates.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "grid": sub.copy(),
+                "color_set": frozenset(int(v) for v in np.unique(sub)),
+            }
+        )
+    templates.sort(key=lambda item: tuple(int(v) for v in item["bbox"]))
+    assert templates, "no templates found"
+    return templates
+
