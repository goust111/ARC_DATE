+from __future__ import annotations
+
+import itertools
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+MAX_GENERATION_ATTEMPTS = 300
+TEMPLATE_BUILD_ATTEMPTS = 120
