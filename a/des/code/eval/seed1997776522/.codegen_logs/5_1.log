+
+
+def _is_frame_component(grid: np.ndarray, color: int, coords: list[tuple[int, int]]) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h != w or h < 5:
