+        if color in (bg, frame_color):
+            continue
+        coords = list(map(tuple, np.argwhere(block == color)))
+        ranked.append(
+            {
+                "color": color,
+                "coords": coords,
+                "area": len(coords),
+                "desc": _descriptor(coords, block.shape),
+            }
+        )
+    ranked.sort(key=lambda item: -int(item["area"]))
+    areas = [int(item["area"]) for item in ranked]
