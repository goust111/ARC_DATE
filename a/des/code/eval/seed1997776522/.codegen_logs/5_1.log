+def _extract_frames(grid: np.ndarray, bg: int, frame_color: int) -> list[dict[str, object]]:
+    frames: list[dict[str, object]] = []
+    for coords in _components(grid == frame_color):
+        if not _is_frame_component(grid, frame_color, coords):
+            continue
