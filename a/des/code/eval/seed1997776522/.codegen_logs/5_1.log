+def _target_rotation(empty_inner: np.ndarray, template: np.ndarray, bg: int, frame_color: int) -> int:
+    region_sig = [str(part["desc"]) for part in _ranked_bg_regions(empty_inner, bg=bg, frame_color=frame_color)]
