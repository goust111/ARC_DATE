+    oriented = np.rot90(target_template["grid"], rot)
+
+    out = g.copy()
+    patch = out[r0 + 1 : r1, c0 + 1 : c1]
+    patch[patch == bg] = oriented[patch == bg]
+    out[r0 + 1 : r1, c0 + 1 : c1] = patch
