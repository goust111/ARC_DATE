    r0,r1=rs.min(),rs.max(); c0,c1=cs.min(),cs.max()
    cy=(shape[0]-1)/2; cx=(shape[1]-1)/2
    dy=((r0+r1)/2-cy)/max(cy,1)
    dx=((c0+c1)/2-cx)/max(cx,1)
    thr=0.18
    if abs(dx)<=thr and abs(dy)>thr:
