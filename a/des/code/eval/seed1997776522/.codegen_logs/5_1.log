from collections import deque

def comps(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,bool)
    out=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            q=deque([(r,c)]); seen[r,c]=True; pts=[]
            while q:
