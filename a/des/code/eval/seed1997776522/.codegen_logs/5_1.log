+def _random_stair(length: int, base: int, lo: int, hi: int) -> list[int]:
+    vals = [max(lo, min(hi, base + random.choice([-1, 0, 1])))]
+    for _ in range(length - 1):
+        vals.append(max(lo, min(hi, vals[-1] + random.choice([-1, 0, 1]))))
+    return vals
