+                elif r <= hb[c]:
+                    roles[r, c] = 1
+                else:
+                    roles[r, c] = 2
+            else:
+                if c <= vb[r] and r <= hb[c]:
+                    roles[r, c] = 0
+                elif c > vb[r] and r <= hb[c]:
+                    roles[r, c] = 1
+                elif c <= vb[r] and r > hb[c]:
