+def _canonical_frame_lines(kind: int, inner_size: int) -> np.ndarray:
+    lines = np.zeros((inner_size, inner_size), dtype=bool)
+    if kind == 2:
+        lines[:, 1] = True
+    elif kind == 3:
+        lines[:, 1] = True
+        lines[1, 2:] = True
+    elif kind == 4:
+        lines[:, 1] = True
+        lines[2, :] = True
