+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    if not (
+        np.all(sub[0, :] == color)
+        and np.all(sub[-1, :] == color)
+        and np.all(sub[:, 0] == color)
+        and np.all(sub[:, -1] == color)
