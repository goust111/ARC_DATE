import numpy as np, random

def stair(length, base, lo, hi):
    vals=[max(lo,min(hi,base+random.choice([-1,0,1])))]
    for _ in range(length-1):
        vals.append(max(lo,min(hi,vals[-1]+random.choice([-1,0,1]))))
    return vals

def desc(coords, shape):
    rs=np.array([r for r,c in coords]); cs=np.array([c for r,c in coords])
    r0,r1=rs.min(),rs.max(); c0,c1=cs.min(),cs.max()
    cy=(shape[0]-1)/2; cx=(shape[1]-1)/2
    dy=((r0+r1)/2-cy)/max(cy,1)
    dx=((c0+c1)/2-cx)/max(cx,1)
    thr=0.18
    if abs(dx)<=thr and abs(dy)>thr:
        return 'top' if dy<0 else 'bottom'
    if abs(dy)<=thr and abs(dx)>thr:
        return 'left' if dx<0 else 'right'
    return ('t' if dy<0 else 'b')+('l' if dx<0 else 'r')

def ranked_template(g):
    out=[]
    for color in sorted(set(g.ravel())):
        pts=list(map(tuple,np.argwhere(g==color)))
        out.append((len(pts),desc(pts,g.shape)))
    out.sort(key=lambda x:-x[0])
    return [(a,d) for a,d in out]

def make_two(n):
    vb=stair(n,1,1,2 if n>5 else 1)
    g=np.zeros((n,n),int)
    for r in range(n):
        for c in range(n):
            g[r,c]=1 if c>vb[r] else 2
    return g

def make_three(n):
    vb=stair(n,1,1,2 if n>5 else 1)
    hb=stair(n,1,1,2 if n>5 else 1)
    g=np.zeros((n,n),int)
    for r in range(n):
        for c in range(n):
            if c<=vb[r]: g[r,c]=2
            elif r<=hb[c]: g[r,c]=3
            else: g[r,c]=1
    return g

def make_four(n):
    vb=stair(n,1,1,2 if n>5 else 1)
    hb=stair(n,2,2,3 if n>6 else 2)
    g=np.zeros((n,n),int)
    for r in range(n):
