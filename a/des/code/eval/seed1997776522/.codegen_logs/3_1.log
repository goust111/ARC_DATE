+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PALETTE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_ATTEMPTS = 300
+TEMPLATE_ATTEMPTS = 200
