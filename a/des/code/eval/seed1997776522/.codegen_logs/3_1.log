+    return not occupied[rr0:rr1, cc0:cc1].any()
+
+
+def _mark_bbox(occupied: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int = 1) -> None:
+    H, W = occupied.shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(H, r0 + h + pad)
