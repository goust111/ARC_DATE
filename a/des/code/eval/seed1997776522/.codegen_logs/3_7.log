+                covered: list[int] = []
+                for r, c in cells:
+                    idx = (top + r) * w + (left + c)
+                    mask |= 1 << idx
+                    covered.append(idx)
+                placement_index = len(piece_placements)
+                piece_placements.append((mask, top, left))
+                for idx in covered:
+                    cover_lookup[idx].append((piece_index, placement_index))
+        placements_by_piece.append(piece_placements)
+
