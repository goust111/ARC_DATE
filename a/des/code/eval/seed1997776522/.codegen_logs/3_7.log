+        if len({piece["cells"] for piece in pieces}) != piece_count:
+            continue
+        irregular = sum(int(piece["area"]) != int(piece["shape"][0] * piece["shape"][1]) for piece in pieces)
+        if irregular < max(1, piece_count // 2):
