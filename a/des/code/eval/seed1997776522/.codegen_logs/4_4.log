+                continue
+            q = deque([(r, c)])
+            labels[r, c] = comp_id
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and labels[nr, nc] == -1:
+                        labels[nr, nc] = comp_id
+                        q.append((nr, nc))
