+
+def _perimeter(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = np.zeros_like(mask, dtype=bool)
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        for nr, nc in _neighbors4(rr, cc):
+            if nr < 0 or nr >= h or nc < 0 or nc >= w or not mask[nr, nc]:
+                out[rr, cc] = True
+                break
