+
+BG = 0
+BOUNDARY = 3
+DEPTH_FILL = {1: 1, 2: 4, 3: 6, 4: 7}
+MARKER_COLORS = (2, 5, 8, 9)
+
+MIN_DEPTH = 2
+MAX_DEPTH = 4
+MIN_SHAPE_DIM = 5
+MAX_INNER_SHAPE_DIM = 8
