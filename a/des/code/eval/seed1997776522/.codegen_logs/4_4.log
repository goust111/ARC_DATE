+    adj = _region_adjacency(labels, boundary_mask)
+    depths = {outside_id: 0}
+    q = deque([outside_id])
+    while q:
+        cur = q.popleft()
+        for nxt in adj[cur]:
+            if nxt not in depths:
+                depths[nxt] = depths[cur] + 1
+                q.append(nxt)
