+            cells = [(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1)]
+            rng.shuffle(cells)
+            cursor = 0
+            if rid == start_region:
+                sr, sc = cells[cursor]
+                grid[sr, sc] = MAROON
+                cursor += 1
+            for color in sorted(region_keys[rid]):
+                kr, kc = cells[cursor]
+                grid[kr, kc] = color
+                cursor += 1
