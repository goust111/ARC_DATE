+            top = _region_id(i, j, n_col_regions)
+            bottom = _region_id(i + 1, j, n_col_regions)
+            for c in range(c0 + 1, c1):
+                color = int(g[wall_r, c])
+                if color not in (BLACK, GREY):
+                    locks.append(Lock(wall_r, c, color, top, bottom))
