+    for i, (r0, r1) in enumerate(row_spans):
+        for j in range(n_col_regions - 1):
+            wall_c = col_spans[j][1]
+            left = _region_id(i, j, n_col_regions)
+            right = _region_id(i, j + 1, n_col_regions)
+            for r in range(r0 + 1, r1):
