+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+GRAY = 5
+TOWER_COLORS = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)
+DIR_STEPS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+CATEGORY_ORDER = ("tie", "multi", "single", "unhit")
