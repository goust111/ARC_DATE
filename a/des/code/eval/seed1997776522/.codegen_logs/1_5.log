+    require_stable: bool,
+) -> dict[str, object] | None:
+    mask = rng.choice(PATTERN_MASKS[size]).copy()
+    pattern = _paint_pattern(rng, mask, mapping, stable_colors, layers, require_stable)
+    if pattern is None:
