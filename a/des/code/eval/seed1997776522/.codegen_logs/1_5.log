+def _paint_pattern(
+    rng: random.Random,
+    mask: np.ndarray,
+    mapping: dict[int, int],
+    stable_colors: list[int],
+    steps: int,
+    require_stable: bool,
+) -> np.ndarray | None:
+    src_colors = list(mapping)
+    cells = [tuple(x) for x in np.argwhere(mask)]
+    max_colors = min(4, len(cells))
