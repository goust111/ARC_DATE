+    h, w = patch.shape
+    H, W = grid.shape
+    if h > H or w > W:
+        return None
+
+    r_lo = 1 if H - h >= 2 else 0
+    c_lo = 1 if W - w >= 2 else 0
+    r_hi = H - h - 1 if H - h >= 2 else H - h
+    c_hi = W - w - 1 if W - w >= 2 else W - w
+    if r_hi < r_lo or c_hi < c_lo:
+        return None
+
+    for _ in range(300):
+        r0 = rng.randint(r_lo, r_hi)
+        c0 = rng.randint(c_lo, c_hi)
