+    out = grid.copy()
+    for r0, c0, obj in placements:
+        layers = int(obj["layers"])
+        size = int(obj["size"])
+        center = out[r0 + layers : r0 + layers + size, c0 + layers : c0 + layers + size]
+        out[r0 + layers : r0 + layers + size, c0 + layers : c0 + layers + size] = _iterate_mapping(
+            center, mapping, layers
