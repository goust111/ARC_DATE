+def _sample_layers(rng: random.Random, count: int, style: str, cycle_len: int) -> list[int]:
+    allowed = list(LAYER_CHOICES)
+    if style == "cycle":
+        allowed = [n for n in allowed if n != cycle_len]
+    layers = [rng.choice(allowed) for _ in range(count)]
+    if len(set(layers)) == 1:
