+def _sample_mapping(rng: random.Random) -> tuple[str, list[tuple[int, int]], dict[int, int], list[int]]:
+    style = rng.choice(("cycle", "chain"))
+    pair_count = rng.choice(PAIR_COUNT_CHOICES)
