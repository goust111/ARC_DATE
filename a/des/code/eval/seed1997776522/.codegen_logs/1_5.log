+        placements.append((pos[0], pos[1], obj))
+
+    expected = _expected_output(grid, placements, mapping)
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
