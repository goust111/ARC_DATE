+    occ = np.zeros((H, W), dtype=bool)
+
+    legend_top = H - legend_height
+    legend_rows = list(range(legend_top, H, 2))
+    for r, (src, dst) in zip(legend_rows, legend_pairs):
+        grid[r, 0] = src
+        grid[r, 1] = dst
+    occ[max(0, legend_top - MIN_GAP) : H, 0 : min(W, 2 + MIN_GAP)] = True
