            cc1 = min(width, c1 + 2)
            if np.any(blocked[rr0:rr1, cc0:cc1]):
                continue

            blocked[rr0:rr1, cc0:cc1] = True
            slots.append((r0, r1, c0, c1))
            placed = True
            break

        if not placed:
            return None

    return slots


def _fill_case(
    grid: np.ndarray,
    bbox: tuple[int, int, int, int],
    axis: int,
    case: str,
    rng: np.random.Generator,
) -> None:
    mirror_bbox = _mirror_bbox(bbox, axis)

    if case == "copy":
