+    axis, color = divider_cols[0]
+    assert 0 < axis < w - 1, "divider must split the board"
+    return axis, color
+
+
+def _collect_rectangles(grid: np.ndarray, bg: int, divider: int) -> list[dict]:
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    rects = []
+
