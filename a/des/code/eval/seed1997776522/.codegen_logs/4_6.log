+    axis: int,
+    case: str,
+    rng: np.random.Generator,
+) -> None:
+    mirror_bbox = _mirror_bbox(bbox, axis)
+
+    if case == "copy":
+        color = int(rng.choice(PALETTE))
+        if rng.random() < 0.5:
+            _paint_rect(grid, bbox, color)
+        else:
