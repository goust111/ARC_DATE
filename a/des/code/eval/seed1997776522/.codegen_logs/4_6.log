        bbox = (r0, r1, left_start + c0, left_start + c1)
        _fill_case(grid, bbox, axis, case, rng)

    try:
        out = main(grid)
    except AssertionError:
        return None

    if np.array_equal(out, grid):
        return None
    if ORANGE not in out:

