+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+SYMMETRY_TYPES = ("horizontal_only", "vertical_only", "both")
+MAX_GENERATION_ATTEMPTS = 400
+GRID_SIDE_RANGE = (20, 31)
+INNER_SIZE_CHOICES = (3, 4)
+FRAME_COUNT = 3
+BLOCK_SIZE = 2
+PADDING = 1
+COLOR_POOL = tuple(range(10))
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict[str, object]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) != bg:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            rows = [rr for rr, _cc in coords]
+            cols = [cc for _rr, cc in coords]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            comps.append(
+                {
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "area": len(coords),
+                }
+            )
+    return comps
