+        dc = int((size - width) // 2 - min_c)
+    elif side == "left":
+        dr = int((size - height) // 2 - min_r)
+        dc = int(size - 1 - max_c)
+    else:
+        dr = int((size - height) // 2 - min_r)
+        dc = int(-min_c)
+
+    placed: list[tuple[int, int, int]] = []
+    for r, c, value in cells:
