+
+    pieces.sort(key=lambda item: (int(item[0]), int(item[1])))
+    out = np.full((canvas_size, canvas_size), BG, dtype=int)
+    for _count, _body, side, cells in pieces:
+        _paint_piece(out, cells, side)
+    return out
