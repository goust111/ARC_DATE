+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+MARKER = 9
+SIDES = ("top", "bottom", "left", "right")
+BODY_COLORS = (1, 2, 3, 4, 6, 7, 8)
+GEN_RETRIES = 300
