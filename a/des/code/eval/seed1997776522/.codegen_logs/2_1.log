+GROUP_SIDE_LIMIT = {1: 10, 2: 15, 3: 17, 4: 19}
+INNER_SIDE_MAX = {2: 7, 3: 6, 4: 5}
+PLACEMENT_RETRIES = 200
+GENERATION_RETRIES = 500
