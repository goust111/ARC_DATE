+    return out
+
+
+def _place_groups(
+    grid_h: int,
+    grid_w: int,
+    specs: list[dict],
+    legend_col: int,
+    legend_gap: int,
+) -> list[dict] | None:
+    occupied: list[tuple[int, int, int, int]] = []
+    placed: list[dict] = []
