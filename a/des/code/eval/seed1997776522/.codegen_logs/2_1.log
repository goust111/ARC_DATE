+
+    depths = [legend_len] + [random.randint(1, legend_len) for _ in range(group_count - 1)]
+    random.shuffle(depths)
+
+    specs: list[dict] = []
+    for depth in depths:
+        spec = _sample_group(depth)
+        if spec is None:
+            return None
+        specs.append(spec)
