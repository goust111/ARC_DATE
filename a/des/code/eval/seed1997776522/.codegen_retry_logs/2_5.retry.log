+            color = int(g[r, c])
+            if color in (BG, GREY):
+                continue
+            key = _neighbor_key(g, r, c)
+            if key:
+                seeds.append((r, c))
+
+    for r, c in seeds:
+        color = int(g[r, c])
+        key = _neighbor_key(g, r, c)
+        assert key in mapping, "workspace seed pattern missing from library"
+        _paint_pattern(out, mapping[key], r, c, color)
+
+    return out
