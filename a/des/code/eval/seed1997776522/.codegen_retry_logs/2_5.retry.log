+def _neighbor_key(grid: np.ndarray, r: int, c: int) -> tuple[tuple[int, int], ...]:
+    offsets = []
+    h, w = grid.shape
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < h and 0 <= cc < w and int(grid[rr, cc]) == GREY:
+                offsets.append((dr, dc))
+    return tuple(offsets)
