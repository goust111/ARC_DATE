+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Grow exterior spikes on a rectangular frame according to the side-bias and size of interior seed blocks.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
