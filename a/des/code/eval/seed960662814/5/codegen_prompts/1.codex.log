+            for cc in range(max(0, c - 1), min(w, c + 2)):
+                blocked[rr, cc] = True
+
+
+def _place_seeds_in_frame(rng: random.Random, ih: int, iw: int) -> list[dict] | None:
+    for _ in range(80):
