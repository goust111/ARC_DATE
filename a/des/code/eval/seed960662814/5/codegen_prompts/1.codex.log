+def _classify_direction(coords: list[tuple[int, int]], center_r: float, center_c: float) -> str:
+    mean_r, mean_c = _mean_coord(coords)
+    dr = mean_r - center_r
+    dc = mean_c - center_c
+    if abs(dr) > abs(dc):
+        return "down" if dr > 0 else "up"
+    return "right" if dc > 0 else "left"
