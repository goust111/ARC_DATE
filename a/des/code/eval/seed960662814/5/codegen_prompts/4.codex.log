+        for r, c, color in source_cells:
+            rr = int(r)
+            cc = int(2 * wall_col - c)
+            assert target_room["r0"] <= rr <= target_room["r1"]
+            assert target_room["c0"] <= cc <= target_room["c1"]
+            assert int(out[rr, cc]) == int(bg)
+            out[rr, cc] = int(color)
