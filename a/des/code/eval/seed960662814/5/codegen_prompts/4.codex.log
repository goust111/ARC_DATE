+def _connected(mask: np.ndarray) -> bool:
+    cells = [tuple(map(int, cell)) for cell in np.argwhere(mask)]
+    if not cells:
+        return False
+    seen = {cells[0]}
+    stack = [cells[0]]
+    h, w = mask.shape
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
