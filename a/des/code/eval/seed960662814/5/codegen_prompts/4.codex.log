+    room_rows: int,
+    room_cols: int,
+    boxes: dict[tuple[int, int], tuple[int, int, int, int]],
+    vertical_doors: dict[tuple[int, int], tuple[int, int]],
+    horizontal_doors: dict[tuple[int, int], tuple[int, int]],
