+    rooms = _all_rooms(room_rows, room_cols)
+    total_rooms = len(rooms)
+    min_sources = 2
+    max_sources = min(MAX_SOURCE_ROOMS, total_rooms - 1)
+    for _ in range(ASSIGNMENT_RETRIES):
