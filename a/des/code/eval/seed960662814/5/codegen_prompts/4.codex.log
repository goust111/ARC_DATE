+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+GEN_RETRIES = 400
+ASSIGNMENT_RETRIES = 200
+PATTERN_RETRIES = 80
+ROOM_COUNT_RANGE = (2, 4)
+ROOM_HEIGHT_RANGE = (5, 8)
+ROOM_WIDTH_RANGE = (5, 8)
+MAX_SOURCE_ROOMS = 6
