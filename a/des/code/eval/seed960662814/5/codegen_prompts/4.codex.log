+    return {
+        "grid": g,
+        "bg": bg,
+        "wall": wall,
+        "row_lines": row_lines,
+        "col_lines": col_lines,
+        "room_rows": room_rows,
+        "room_cols": room_cols,
+        "rooms": rooms,
+        "vertical_doors": vertical_doors,
+        "horizontal_doors": horizontal_doors,
+    }
