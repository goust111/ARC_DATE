+        best_dist = min(float(item["dist2"]) for item in candidates)
+        best = [item for item in candidates if float(item["dist2"]) == best_dist]
+        assert len(best) == 1
+        chosen = best[0]
+        source_cells = rooms[chosen["source"]]["cells"]
