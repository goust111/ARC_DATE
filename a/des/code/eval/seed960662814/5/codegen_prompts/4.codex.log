+def _paint_lattice(
+    grid: np.ndarray,
+    wall: int,
+    room_rows: int,
+    room_cols: int,
+    room_h: int,
+    room_w: int,
+) -> None:
+    height, width = grid.shape
+    for i in range(room_rows + 1):
+        row = int(i * (room_h + 1))
+        grid[row, :] = wall
+    for j in range(room_cols + 1):
+        col = int(j * (room_w + 1))
+        grid[:, col] = wall
