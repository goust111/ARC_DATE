+        )
+    if j + 1 < room_cols and rooms[(i, j + 1)]["cells"]:
+        door_r, door_c = vertical_doors[(i, j)]
+        candidates.append(
+            {
+                "source": (i, j + 1),
+                "flip": "horizontal",
+                "wall_col": int(door_c),
+                "dist2": (door_r - center_r) ** 2 + (door_c - center_c) ** 2,
+            }
+        )
+    if i > 0 and rooms[(i - 1, j)]["cells"]:
+        door_r, door_c = horizontal_doors[(i - 1, j)]
+        candidates.append(
