    frame_rot = random.randrange(4)
    piece_rot = random.randrange(4)
    cavity_for_frame = _rotate_mask(BASE_CAVITY, frame_rot)
    cavity_for_piece = _rotate_mask(BASE_CAVITY, piece_rot)

