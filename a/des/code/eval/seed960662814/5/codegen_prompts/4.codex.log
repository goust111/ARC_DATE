+        vertical_count = sum(1 for item in fills if item["flip"] == "vertical")
+        multi_count = sum(1 for item in fills if int(item["candidate_count"]) >= 2)
+        if horizontal_count == 0 or vertical_count == 0:
+            continue
+        if mode == "multi":
+            if multi_count == 0 or len(fills) < 3:
