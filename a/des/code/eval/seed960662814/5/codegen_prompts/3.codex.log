+def _find_towers(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    towers = []
+    for r, c in np.argwhere((g != int(bg)) & (g != GREY)):
+        towers.append({"pos": (int(r), int(c)), "color": int(g[int(r), int(c)])})
