+            rows = {r for r, _c in cells}
+            cols = {c for _r, c in cells}
+            if rows & reserved_rows or cols & reserved_cols:
+                continue
+            if any(cell in occupied for cell in cells):
+                continue
+            for cell in cells:
+                grid[cell] = GREY
+                occupied.add(cell)
+            placed = True
+            break
+        if not placed:
+            continue
+
