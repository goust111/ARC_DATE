+        pos = tower["pos"]
+        if pos == tower_pos:
+            continue
+        tr, tc = pos
+        if tr != ar and tc != ac:
+            continue
+        dist = abs(tr - ar) + abs(tc - ac)
+        cand = (int(dist), int(tr), int(tc))
+        if best is None or cand < best:
