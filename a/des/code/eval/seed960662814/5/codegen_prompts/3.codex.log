+def _trace_until_mirror(grid: np.ndarray, start: tuple[int, int], step: tuple[int, int]) -> tuple[list[tuple[int, int]], tuple[int, int] | None]:
+    g = np.asarray(grid, dtype=int)
+    dr, dc = step
+    r, c = start
+    path: list[tuple[int, int]] = []
+
+    while True:
