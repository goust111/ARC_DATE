+def _direction_hits(grid: np.ndarray, tower_pos: tuple[int, int]) -> list[tuple[int, int]]:
+    hits = []
+    for step in DIRS:
+        _path, hit = _trace_until_mirror(grid, tower_pos, step)
+        if hit is not None:
