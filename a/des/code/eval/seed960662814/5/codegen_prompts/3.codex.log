+def _reflect_ray_cells(shape: tuple[int, int], start: tuple[int, int], step: tuple[int, int]) -> list[tuple[int, int]]:
+    dr, dc = step
+    r, c = start
+    cells: list[tuple[int, int]] = []
+    while True:
+        r += dr
+        c += dc
+        if not _in_bounds(shape, r, c):
+            return cells
+        cells.append((int(r), int(c)))
