+    min_w = sum(outer_widths) + (container_count - 1) * 2 + 2
+    if min_w > GRID_W_RANGE[1]:
+        return None
+    grid_w = random.randint(max(GRID_W_RANGE[0], min_w), GRID_W_RANGE[1])
