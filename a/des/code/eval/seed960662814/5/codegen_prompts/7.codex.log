+    for comp in _components(grid == wall_color):
+        r0, c0, r1, c1 = _bbox(comp)
+        expected = set()
+        for r in range(r0, r1 + 1):
+            expected.add((r, c0))
+            expected.add((r, c1))
+        for c in range(c0, c1 + 1):
+            expected.add((r1, c))
