+    balls: list[tuple[int, int, int]] = []
+    h, w = g.shape
+    for r in range(h):
+        for c in range(w):
+            value = int(g[r, c])
+            if value in (bg, wall_color):
+                continue
+            if (r, c) in marker_positions:
+                continue
