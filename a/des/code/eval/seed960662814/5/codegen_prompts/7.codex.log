+        assert len(marker_cells) == 1, "each container must contain exactly one marker"
+        mr, mc = marker_cells[0]
+        containers.append(
+            {
+                "top": int(r0),
+                "left": int(c0),
+                "bottom": int(r1),
+                "right": int(c1),
