+def _layout_columns(widths: list[int], grid_w: int) -> list[int]:
+    n = len(widths)
+    gap_sizes = [1] + [2] * (n - 1) + [1]
+    slack = grid_w - (sum(widths) + sum(gap_sizes))
+    assert slack >= 0
+    for _ in range(slack):
+        gap_sizes[random.randrange(len(gap_sizes))] += 1
