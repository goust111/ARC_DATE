+    fg = np.argwhere(patch != bg)
+    for dr, dc in fg:
+        r = int(top + dr)
+        c = int(left + dc)
+        r0 = max(0, r - gap)
+        c0 = max(0, c - gap)
+        r1 = min(gh, r + gap + 1)
+        c1 = min(gw, c + gap + 1)
+        if np.any(grid[r0:r1, c0:c1] != bg):
