+    out = g.copy()
+    for color, pair in by_color.items():
+        assert len(pair) == 2, f"color {color} must appear in exactly two objects"
+        analyzed = []
+        for obj in pair:
+            holes = _enclosed_holes(obj, bg)
+            analyzed.append((obj, holes))
