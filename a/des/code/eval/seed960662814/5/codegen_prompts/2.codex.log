+def _attempt_example() -> tuple[np.ndarray, np.ndarray] | None:
+    n_pairs = random.randint(*GEN_PAIR_COUNT_RANGE)
+    min_side = GEN_MIN_SIDE_BASE + 2 * n_pairs
+    height = random.randint(min_side, GEN_MAX_SIDE)
