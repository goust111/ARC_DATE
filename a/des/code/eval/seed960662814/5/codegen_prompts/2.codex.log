+        cavity_abs[:, 1] += frame_left
+        piece_abs = np.argwhere(pair["piece_patch"] != GEN_BG)
+        piece_abs[:, 0] += piece_top
+        piece_abs[:, 1] += piece_left
+
+        placements.append(
+            {
+                "cavity_abs": cavity_abs,
+                "piece_abs": piece_abs,
+            }
+        )
+
+    expected = grid.copy()
+    for placement in placements:
