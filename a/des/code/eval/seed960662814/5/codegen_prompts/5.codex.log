+        for c in (0, w - 1):
+            if not_blocked[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not_blocked[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+    while q:
+        cr, cc = q.popleft()
+        for nr, nc in _neighbors4(cr, cc):
+            if 0 <= nr < h and 0 <= nc < w and not_blocked[nr, nc] and not seen[nr, nc]:
