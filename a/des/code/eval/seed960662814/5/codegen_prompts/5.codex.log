+                continue
+            color = int(grid[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
