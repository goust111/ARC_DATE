+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
