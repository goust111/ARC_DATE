+def _k_range(anchor_coord: int, offsets: np.ndarray, low: int, high: int, period: int) -> range:
+    lower = (low - anchor_coord - int(np.max(offsets))) / period
+    upper = (high - anchor_coord - int(np.min(offsets))) / period
