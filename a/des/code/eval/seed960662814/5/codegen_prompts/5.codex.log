+def _shape_to_cells(pixel: tuple[int, int], outward: tuple[int, int], shape: list[tuple[int, int]], tangent_flip: int) -> list[tuple[int, int]]:
+    pr, pc = pixel
+    orow, ocol = outward
+    if orow != 0:
