+        [(1, 0), (2, 0), (2, 1)],
+        [(1, 0), (2, 0), (2, -1)],
+    ],
+    4: [
+        [(1, 0), (2, 0), (3, 0), (4, 0)],
+        [(1, 0), (2, 0), (3, 0), (2, 1)],
+        [(1, 0), (2, 0), (3, 0), (2, -1)],
+        [(1, 0), (2, 0), (2, 1), (3, 1)],
+        [(1, 0), (2, 0), (2, -1), (3, -1)],
