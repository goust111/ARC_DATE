+
+BASELINE_COLOR = 5
+ALL_COLORS = tuple(range(10))
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+GENERATION_ATTEMPTS = 400
+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (20, 30)
+TOP_BAND_HEIGHT_RANGE = (2, 5)
+REGION_GAP_RANGE = (3, 7)
+RULER_COUNT_RANGE = (3, 5)
+BASE_RULER_LENGTH_RANGE = (2, 4)
+SHAPE_AREA_RANGE = (3, 6)
+SCALED_PAD = 1
+RULER_PAD = 1
+RULER_ROW_MARGIN = 1
+MAX_SHAPE_BBOX = 4
