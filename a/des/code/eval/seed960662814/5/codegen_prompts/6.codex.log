+    out = np.zeros((h * scale, w * scale), dtype=bool)
+    for r, c in np.argwhere(mask):
+        rr = int(r) * scale
+        cc = int(c) * scale
+        out[rr : rr + scale, cc : cc + scale] = True
+    return out
+
