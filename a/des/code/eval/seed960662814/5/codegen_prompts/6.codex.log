+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for rr, cc in comp["coords"]:
+        mask[int(rr) - r0, int(cc) - c0] = True
+    return int(r0), int(c0), mask
