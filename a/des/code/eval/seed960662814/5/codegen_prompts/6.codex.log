+            arr = np.array(coords, dtype=int)
+            r0 = int(arr[:, 0].min())
+            c0 = int(arr[:, 1].min())
+            r1 = int(arr[:, 0].max())
+            c1 = int(arr[:, 1].max())
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
