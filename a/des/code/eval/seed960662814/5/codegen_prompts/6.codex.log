+
+import numpy as np
+
+
+BASELINE_COLOR = 5
+ALL_COLORS = tuple(range(10))
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+GENERATION_ATTEMPTS = 400
+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (20, 30)
+TOP_BAND_HEIGHT_RANGE = (2, 5)
