        rr = int(r) * scale
        cc = int(c) * scale
        out[rr : rr + scale, cc : cc + scale] = True
    return out


def _apply_scaling(grid: np.ndarray, bg: int, shapes: list[dict], scales: dict[int, int]) -> np.ndarray:
    out = np.array(grid, dtype=int, copy=True)
