+        grey_mask = interior == GREY
+        interior[grey_mask] = color if color in active_colors else BLACK
+    return out
+
+
+def _build_case() -> tuple[np.ndarray, np.ndarray] | None:
+    h = random.randint(*GRID_HEIGHT_RANGE)
