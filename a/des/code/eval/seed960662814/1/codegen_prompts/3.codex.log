+        mask[r, c] = True
+    mask = np.rot90(mask, random.randrange(4))
+    if random.random() < 0.5:
+        mask = np.fliplr(mask)
+    new_coords = {(int(r), int(c)) for r, c in np.argwhere(mask)}
+    return _normalize_coords(new_coords)
