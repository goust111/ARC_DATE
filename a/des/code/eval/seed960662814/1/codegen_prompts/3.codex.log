+                rs = [rr for rr, _ in trial]
+                cs = [cc for _, cc in trial]
+                if max(rs) - min(rs) + 1 <= 5 and max(cs) - min(cs) + 1 <= 5:
+                    frontier.append(nxt)
+        coords.add(random.choice(frontier))
