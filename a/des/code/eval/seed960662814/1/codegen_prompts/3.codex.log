+def generate_input() -> np.ndarray:
+    global _GEN_CALL_COUNT
+    _GEN_CALL_COUNT += 1
+
+    required_direction = DIRECTIONS[(_GEN_CALL_COUNT - 1) % len(DIRECTIONS)]
+    require_truncation = ((_GEN_CALL_COUNT - 1) // len(DIRECTIONS)) % 2 == 1
