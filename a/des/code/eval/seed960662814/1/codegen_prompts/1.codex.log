+        return spec
+    return None
+
+
+def _draw_input(shape, specs):
+    g = np.full(shape, BLACK, dtype=int)
+    for spec in specs:
+        r0, c0, r1, c1 = spec["bbox"]
+        color = spec["color"]
+        g[r0, c0 : c1 + 1] = GREY
+        g[r1, c0 : c1 + 1] = GREY
+        g[r0 : r1 + 1, c0] = GREY
