+    inp = _draw_input((h, w), specs)
+    expected = _render_expected(inp, specs)
+    if expected is None:
+        return None
+    return inp, specs
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
