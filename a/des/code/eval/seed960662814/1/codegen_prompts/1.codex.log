+def _render_expected(inp: np.ndarray, specs):
+    out = inp.copy()
+    usage = np.zeros(inp.shape, dtype=int)
+    for spec in specs:
+        for r, c in _branch_cells(spec, inp.shape):
+            if inp[r, c] != BLACK:
