+                before = rng.randint(1, side_len - width - 3)
+                start = before
+                end = start + width - 1
+
+            if side == "top":
+                gap = (c0 + start + 1, c0 + end + 1)
+            elif side == "bottom":
+                gap = (c0 + start + 1, c0 + end + 1)
+            elif side == "left":
+                gap = (r0 + start + 1, r0 + end + 1)
+            else:
+                gap = (r0 + start + 1, r0 + end + 1)
