+    demo_colors = set(demo_info)
+    for comp in _components(mask):
+        r0, r1, c0, c1 = _bbox(comp)
+        patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+        marker_hits: list[tuple[int, int, int]] = []
