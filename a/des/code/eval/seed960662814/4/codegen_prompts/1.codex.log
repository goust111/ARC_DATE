+def _touches_all_sides(cells: set[tuple[int, int]], h: int, w: int) -> bool:
+    return (
+        any(r == 0 for r, _c in cells)
+        and any(r == h - 1 for r, _c in cells)
+        and any(c == 0 for _r, c in cells)
+        and any(c == w - 1 for _r, c in cells)
+    )
