+def _paste_transparent(out: np.ndarray, patch: np.ndarray, top: int, left: int, bg: int) -> None:
+    h, w = patch.shape
+    if top < 0 or left < 0 or top + h > out.shape[0] or left + w > out.shape[1]:
+        raise AssertionError("placement out of bounds")
