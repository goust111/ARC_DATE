+    if quadrant == "tr":
+        cursor_r, cursor_c = cross_r - 1, cross_c + 1
+        for patch in patches:
+            h, w = patch.shape
+            top = cursor_r - h + 1
+            left = cursor_c
+            _paste_transparent(out, patch, top, left, bg)
+            cursor_r = top - gap - 1
+            cursor_c = left + w + gap
+        return
+
+    if quadrant == "bl":
+        cursor_r, cursor_c = cross_r + 1, cross_c - 1
+        for patch in patches:
+            h, w = patch.shape
+            top = cursor_r
+            left = cursor_c - w + 1
+            _paste_transparent(out, patch, top, left, bg)
+            cursor_r = top + h + gap
+            cursor_c = left - gap - 1
+        return
