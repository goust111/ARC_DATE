+def _extract_sprites(
+    grid: np.ndarray,
+    bg: int,
+    grey: int,
+    cross_r: int,
+    cross_c: int,
+    demo_info: dict[int, dict[str, str]],
+) -> list[dict]:
+    h, w = grid.shape
+    mask = (grid != bg) & (grid != grey)
+    for r0, c0 in _corner_origins(h, w).values():
+        mask[r0 : r0 + 2, c0 : c0 + 2] = False
