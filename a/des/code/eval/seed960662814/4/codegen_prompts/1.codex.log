+def _corner_origins(h: int, w: int) -> dict[str, tuple[int, int]]:
+    return {
+        "tl": (0, 0),
+        "tr": (0, w - 2),
+        "bl": (h - 2, 0),
+        "br": (h - 2, w - 2),
+    }
+
+
+def _read_demo_info(grid: np.ndarray) -> dict[int, dict[str, str]]:
+    h, w = grid.shape
