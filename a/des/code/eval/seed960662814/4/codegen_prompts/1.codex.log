+
+def _place_from_center(
+    out: np.ndarray,
+    patches: list[np.ndarray],
+    quadrant: str,
+    cross_r: int,
+    cross_c: int,
+    bg: int,
+) -> None:
+    gap = 1
+    if quadrant == "tl":
+        cursor_r, cursor_c = cross_r - 1, cross_c - 1
+        for patch in patches:
+            h, w = patch.shape
+            top = cursor_r - h + 1
+            left = cursor_c - w + 1
