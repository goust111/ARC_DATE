+def _apply_transform(patch: np.ndarray, transform: str) -> np.ndarray:
+    if transform == "identity":
+        return patch.copy()
+    if transform == "hflip":
+        return np.fliplr(patch)
+    if transform == "vflip":
+        return np.flipud(patch)
+    if transform == "rot180":
+        return np.rot90(patch, 2)
