+    incoming: set[int] = set()
+    for trace in traces:
+        for target, _kind in trace["contacts"]:
+            incoming.add(int(target))
+
+    roots = [idx for idx in range(len(arrows)) if idx not in incoming]
+    if not roots:
+        roots = list(range(len(arrows)))
+
+    order: list[int] = []
+    seen: set[int] = set()
