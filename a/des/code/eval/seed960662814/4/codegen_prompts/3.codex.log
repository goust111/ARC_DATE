+            continue
+        seen.add(idx)
+        order.append(idx)
+        side_target = traces[idx]["side_target"]
+        if side_target is not None and side_target not in seen:
+            q.append(int(side_target))
+    return bg, arrows, traces, order
+
+
+def main(grid: np.ndarray) -> np.ndarray:
