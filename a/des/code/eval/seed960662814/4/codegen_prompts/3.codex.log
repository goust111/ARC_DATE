+ARROW_MASKS = {
+    (-1, 0): np.array([[1, 1, 1], [0, 1, 0], [0, 1, 0]], dtype=bool),
+    (1, 0): np.array([[0, 1, 0], [0, 1, 0], [1, 1, 1]], dtype=bool),
+    (0, -1): np.array([[1, 0, 0], [1, 1, 1], [1, 0, 0]], dtype=bool),
+    (0, 1): np.array([[0, 0, 1], [1, 1, 1], [0, 0, 1]], dtype=bool),
