+def _components(mask: np.ndarray, connectivity: int = 4) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    nbrs = _neighbors4 if connectivity == 4 else _neighbors8
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
