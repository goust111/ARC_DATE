+    shell = np.zeros_like(inner)
+    for r, c in np.argwhere(inner):
+        for nr, nc in _neighbors4(int(r), int(c)):
+            if 0 <= nr < shell.shape[0] and 0 <= nc < shell.shape[1] and not inner[nr, nc]:
