+    filled = np.zeros_like(inside, dtype=bool)
+    for place_r, place_c, patch, occupied in _extract_pieces(g, sep_col, bg):
+        for rr, cc in np.argwhere(occupied):
+            tr = origin[0] + place_r + int(rr)
