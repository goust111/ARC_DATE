+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    bg = _most_common_color(g)
+    sep_col = _find_separator_col(g, bg)
+    (r0, c0, r1, c1), wall, inside, origin = _find_container(g, sep_col, bg)
