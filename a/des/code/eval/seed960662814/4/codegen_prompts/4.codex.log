+                seen[r, c] = True
+                q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and not walls[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
+    return (~walls) & (~seen)
+
+
+def _find_separator_col(grid: np.ndarray, bg: int) -> int:
+    h, w = grid.shape
+    candidates = []
