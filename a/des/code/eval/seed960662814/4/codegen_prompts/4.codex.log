+    boxes: list[tuple[int, int, int, int]] = []
+    right_start = sep_col + 2
+    right_end = grid_w - 1
+    for patch in sorted(piece_patches, key=lambda p: int(p.shape[0] * p.shape[1]), reverse=True):
+        ph, pw = patch.shape
+        if right_end - right_start < pw:
+            return None
