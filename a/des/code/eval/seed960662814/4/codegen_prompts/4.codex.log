+        return None
+    return pieces, union, inner_h, inner_w
+
+
+def _build_container(
+    cell_colors: dict[tuple[int, int], int], inner_h: int, inner_w: int, outline_color: int
+) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
