+
+
+def _has_hole(cells: set[tuple[int, int]]) -> bool:
+    max_r = max(r for r, _ in cells) + 3
+    max_c = max(c for _, c in cells) + 3
+    occ = np.zeros((max_r, max_c), dtype=bool)
+    for r, c in cells:
