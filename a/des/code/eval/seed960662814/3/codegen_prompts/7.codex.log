+def _arrow_cells_for(room: tuple[int, int, int, int], direction: str, anchor: int) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = room
+    if direction == "right":
+        return {(anchor - 1, c1 + 1), (anchor + 1, c1 + 1), (anchor, c1 + 2)}
+    if direction == "left":
