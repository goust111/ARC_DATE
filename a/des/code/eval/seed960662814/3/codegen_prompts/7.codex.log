+        for r in range(r0, r1 + 1):
+            for c in range(c0, c1 + 1):
+                on_border = r in (r0, r1) or c in (c0, c1)
+                if on_border != (grid[r, c] == WALL):
+                    border_ok = False
+                    break
+            if not border_ok:
+                break
+        if border_ok:
+            rooms.append((r0, c0, r1, c1))
+    rooms.sort()
+    return rooms
