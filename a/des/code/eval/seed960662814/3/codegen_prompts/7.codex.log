+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+ARROW = 9
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+PALETTE = [1, 2, 3, 4, 6, 7, 8]
+ROOM_COUNT_CHOICES = [1, 2, 3]
+GRID_H_RANGE = (18, 29)
+GRID_W_RANGE = (18, 29)
+ROOM_OUTER_H_RANGE = (7, 11)
+ROOM_OUTER_W_RANGE = (7, 11)
+MAX_ATTEMPTS = 400
