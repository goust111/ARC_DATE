+    return shift >= mask.shape[0]
+
+
+def _sample_parallel_row(
+    interior_h: int, shape_h: int, stripe_row: int, rng: np.random.Generator
+) -> int | None:
+    candidates = [sr for sr in range(interior_h - shape_h + 1) if not (sr <= stripe_row < sr + shape_h)]
+    if not candidates:
