+    if not cells:
+        return None
+
+    full = [pos for pos in cells if _distance_to_inner_wall(inner_bbox, pos) >= depth]
+    truncated = [pos for pos in cells if _distance_to_inner_wall(inner_bbox, pos) < depth]
