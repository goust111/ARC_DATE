+        (int(frame["r0"]), int(frame["c0"]), int(frame["r1"]), int(frame["c1"])): frame for frame in frames
+    }
+    for group in groups:
+        depth = int(group["depth"])
+        inner_bbox = tuple(map(int, group["inner_bbox"]))
