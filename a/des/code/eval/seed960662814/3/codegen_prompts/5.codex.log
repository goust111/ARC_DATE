+
+        return {
+            "color": int(spec["color"]),
+            "core": core_global,
+            "spikes": spikes_global,
+            "shape": shape_global,
+            "shape_buffer": _dilate8(shape_global, shape),
+            "rays": ray_cells,
+        }
+    return None
+
+
+def _gen_attempt() -> np.ndarray | None:
+    height = random.randint(*GRID_H_RANGE)
+    width = random.randint(*GRID_W_RANGE)
