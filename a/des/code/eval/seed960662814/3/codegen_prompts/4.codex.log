+                "coords": tuple(sorted(comp)),
+                "shape": norm,
+                "anchor": (r0, c0),
+                "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                "centroid": (sum(rows) / len(rows), sum(cols) / len(cols)),
+            }
