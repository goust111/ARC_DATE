+def _normalize(coords):
+    pts = np.asarray(list(coords), dtype=int)
+    if pts.size == 0:
+        return tuple(), (0, 0)
+    r0 = int(pts[:, 0].min())
+    c0 = int(pts[:, 1].min())
+    norm = tuple(sorted((int(r - r0), int(c - c0)) for r, c in pts))
+    return norm, (r0, c0)
