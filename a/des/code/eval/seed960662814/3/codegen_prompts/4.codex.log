        norm, (hr0, hc0) = _normalize(abs_comp)
        rows = [r for r, _ in abs_comp]
        cols = [c for _, c in abs_comp]
        holes.append(
            {
                "coords": tuple(sorted(abs_comp)),
                "shape": norm,
                "anchor": (hr0, hc0),
                "bbox": (min(rows), min(cols), max(rows), max(cols)),
                "area": len(abs_comp),
            }
        )
    return (r0, c0, r1, c1), holes


def _detect_axes(grid):
    maroon_pts = np.argwhere(grid == MAROON)
    if len(maroon_pts) == 0:
        raise AssertionError("missing dashed axes")
    row_counts = Counter(int(r) for r, _ in maroon_pts)
    col_counts = Counter(int(c) for _, c in maroon_pts)
    axis_r = max(row_counts.items(), key=lambda kv: (kv[1], -abs(kv[0] - grid.shape[0] / 2)))[0]
    axis_c = max(col_counts.items(), key=lambda kv: (kv[1], -abs(kv[0] - grid.shape[1] / 2)))[0]
    return int(axis_r), int(axis_c)


def _piece_quadrant(piece, axis_r, axis_c):
    cr, cc = piece["centroid"]
    top = cr < axis_r
    left = cc < axis_c
    if top and left:
        return "ul"
    if top and not left:
        return "ur"
    if not top and left:
        return "ll"
    return "lr"


def main(grid: np.ndarray) -> np.ndarray:
    """
    Assemble scattered colored fragments into the grey board'"'s missing notches.

    The dashed maroon row/column define quadrants, and each quadrant fixes the
    rotation that must be applied before shape matching:
    upper-left -> 0 deg, upper-right -> 90 deg clockwise,
    lower-right -> 180 deg, lower-left -> 270 deg clockwise.
    \"\"\"
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    axis_r, axis_c = _detect_axes(g)
    board_bbox, holes = _board_and_holes(g)
    pieces = _find_components_by_color(g, PIECE_COLORS)

    if len(pieces) "'!= len(holes):
        raise AssertionError("piece/hole count mismatch")

    hole_map = defaultdict(list)
    for hole in holes:
        hole_map[hole["shape"]].append(hole)

    out = np.full((h, w), BG, dtype=int)
    r0, c0, r1, c1 = board_bbox
    board_mask = g[r0 : r1 + 1, c0 : c1 + 1] == GREY
    out[r0 : r1 + 1, c0 : c1 + 1][board_mask] = GREY

    used_holes = set()
    for piece in pieces:
        quadrant = _piece_quadrant(piece, axis_r, axis_c)
        rot_k = QUADRANT_ROTATIONS[quadrant]
        rotated_shape = _rotate_coords(piece["shape"], rot_k)
        candidates = [hole for hole in hole_map.get(rotated_shape, []) if hole["anchor"] not in used_holes]
        if len(candidates) != 1:
            raise AssertionError("shape match is not unique")
        hole = candidates[0]
        used_holes.add(hole["anchor"])
        for r, c in hole["coords"]:
            out[r, c] = piece["color"]

    if len(used_holes) != len(holes):
        raise AssertionError("not all holes were filled")
    return out


def _shape_variants(coords):
    return {_rotate_coords(coords, k) for k in range(4)}


_VALID_SHAPES = [shape for shape in SHAPE_LIBRARY if len(_shape_variants(shape)) == 4]


def _board_hole_orientations(shape):
    return list(_shape_variants(shape))


def _place_holes(board_h, board_w, hole_shapes):
    hole_mask = np.zeros((board_h, board_w), dtype=bool)
    padded = np.zeros((board_h, board_w), dtype=bool)
    placed = []
    side_cycle = ["top", "right", "bottom", "left"]
    random.shuffle(side_cycle)

    for idx, shape in enumerate(hole_shapes):
        variants = _board_hole_orientations(shape)
        random.shuffle(variants)
        sides = side_cycle[:]
        random.shuffle(sides)
        success = False
        for side in sides:
            options = []
            for orient in variants:
                rows = [r for r, _ in orient]
                cols = [c for _, c in orient]
                max_r = max(rows)
                max_c = max(cols)
                min_r = min(rows)
                min_c = min(cols)
                if side == "top":
                    offset_r = 0 - min_r
                    c_range = range(0 - min_c, board_w - max_c)
                    for offset_c in c_range:
                        options.append((orient, offset_r, offset_c))
                elif side == "bottom":
                    offset_r = board_h - 1 - max_r
                    c_range = range(0 - min_c, board_w - max_c)
                    for offset_c in c_range:
                        options.append((orient, offset_r, offset_c))
                elif side == "left":
                    offset_c = 0 - min_c
                    r_range = range(0 - min_r, board_h - max_r)
                    for offset_r in r_range:
                        options.append((orient, offset_r, offset_c))
                else:
                    offset_c = board_w - 1 - max_c
                    r_range = range(0 - min_r, board_h - max_r)
                    for offset_r in r_range:
                        options.append((orient, offset_r, offset_c))
            random.shuffle(options)
            for orient, offset_r, offset_c in options:
                abs_cells = [(r + offset_r, c + offset_c) for r, c in orient]
                rr = [r for r, _ in abs_cells]
                cc = [c for _, c in abs_cells]
                if min(rr) < 0 or min(cc) < 0 or max(rr) >= board_h or max(cc) >= board_w:
                    continue
                if any(hole_mask[r, c] for r, c in abs_cells):
                    continue
                local = np.zeros_like(hole_mask)
                for r, c in abs_cells:
                    local[r, c] = True
                dilated = local.copy()
                for r, c in abs_cells:
                    for dr, dc in DIR4:
                        nr = r + dr
                        nc = c + dc
                        if 0 <= nr < board_h and 0 <= nc < board_w:
                            dilated[nr, nc] = True
                if np.any(dilated & padded):
                    continue
                hole_mask |= local
                padded |= dilated
                placed.append(_normalize(abs_cells)[0])
                success = True
                break
            if success:
                break
        if not success:
            return None

    board = np.full((board_h, board_w), GREY, dtype=int)
    board[hole_mask] = BG
    grey_comps = _component_coords(board == GREY, connectivity=4)
    if len(grey_comps) != 1:
        return None
    hole_comps = [_normalize(comp)[0] for comp in _component_coords(board == BG, connectivity=4)]
    if len(hole_comps) != len(hole_shapes):
        return None
    if sorted(hole_comps) != sorted(placed):
        return None
    return board, hole_comps


def _scatter_positions(area, box_h, box_w, axis_r, axis_c, quadrant, occupied, grid_h, grid_w):
    if quadrant == "ul":
        r_lo, r_hi = 1, axis_r - box_h - 1
        c_lo, c_hi = 1, axis_c - box_w - 1
    elif quadrant == "ur":
        r_lo, r_hi = 1, axis_r - box_h - 1
        c_lo, c_hi = axis_c + 2, grid_w - box_w - 2
    elif quadrant == "ll":
        r_lo, r_hi = axis_r + 2, grid_h - box_h - 2
        c_lo, c_hi = 1, axis_c - box_w - 1
    else:
        r_lo, r_hi = axis_r + 2, grid_h - box_h - 2
        c_lo, c_hi = axis_c + 2, grid_w - box_w - 2
    if r_lo > r_hi or c_lo > c_hi:
        return None
    choices = [(r, c) for r in range(r_lo, r_hi + 1) for c in range(c_lo, c_hi + 1)]
    random.shuffle(choices)
    for r0, c0 in choices:
        cells = [(r0 + r, c0 + c) for r in range(box_h) for c in range(box_w)]
        pad = [(r0 + r + dr, c0 + c + dc) for r in range(box_h) for c in range(box_w) for dr in (-1, 0, 1) for dc in (-1, 0, 1)]
        if any((r, c) in occupied for r, c in cells):
            continue
        if any((r, c) in occupied for r, c in pad if 0 <= r < grid_h and 0 <= c < grid_w):
            continue
        return r0, c0
    return None


def _build_expected(board_origin, board, hole_info, piece_specs, grid_shape):
    out = np.full(grid_shape, BG, dtype=int)
    br, bc = board_origin
    grey_mask = board == GREY
    out[br : br + board.shape[0], bc : bc + board.shape[1]][grey_mask] = GREY
    for hole, spec in zip(hole_info, piece_specs):
        for r, c in hole["coords"]:
            out[r, c] = spec["color"]
    return out


def _gen_attempt():
    grid_h = random.randint(20, 27)
    grid_w = random.randint(22, 31)
    axis_r = random.randint(grid_h // 2 - 2, grid_h // 2 + 2)
    axis_c = random.randint(grid_w // 2 - 1, grid_w // 2 + 2)

    pieces_per_quadrant = random.choice([1, 2])
    quadrants = ["ul", "ur", "lr", "ll"] * pieces_per_quadrant
    random.shuffle(quadrants)
    n_pieces = len(quadrants)

    pool = _VALID_SHAPES[:]
    random.shuffle(pool)
    hole_shapes = pool[:n_pieces]

    board_h = random.randint(max(8, 3 * pieces_per_quadrant + 5), 12 + pieces_per_quadrant)
    board_w = random.randint(max(10, 4 * pieces_per_quadrant + 6), 15 + pieces_per_quadrant)
    if axis_c - board_w - 2 < 1:
        return None
    board_left = random.randint(1, axis_c - board_w - 2)
    board_top_lo = max(1, axis_r - board_h + 2)
    board_top_hi = min(grid_h - board_h - 2, axis_r - 1)
    if board_top_lo > board_top_hi:
        board_top_lo = max(1, min(grid_h - board_h - 2, axis_r - board_h // 2))
        board_top_hi = min(grid_h - board_h - 2, max(board_top_lo, axis_r))
    if board_top_lo > board_top_hi:
        return None
    board_top = random.randint(board_top_lo, board_top_hi)

    placed = _place_holes(board_h, board_w, hole_shapes)
    if placed is None:
        return None
    board, hole_shapes_exact = placed

    grid = np.full((grid_h, grid_w), BG, dtype=int)
    grid[board_top : board_top + board_h, board_left : board_left + board_w] = board

    # Dashed axes only on background cells to avoid semantic overlap.
    for c in range(0, grid_w, 2):
        if grid[axis_r, c] == BG:
            grid[axis_r, c] = MAROON
    for r in range(0, grid_h, 2):
        if grid[r, axis_c] == BG:
            grid[r, axis_c] = MAROON

    hole_info = []
    sub = grid[board_top : board_top + board_h, board_left : board_left + board_w]
    for comp in _component_coords(sub == BG, connectivity=4):
        abs_comp = [(board_top + r, board_left + c) for r, c in comp]
        norm, (r0, c0) = _normalize(abs_comp)
        rows = [r for r, _ in abs_comp]
        cols = [c for _, c in abs_comp]
        hole_info.append(
            {
                "coords": tuple(sorted(abs_comp)),
                "shape": norm,
                "anchor": (r0, c0),
                "bbox": (min(rows), min(cols), max(rows), max(cols)),
                "area": len(abs_comp),
            }
        )
    hole_info.sort(key=lambda item: item["anchor"])

    colors = PIECE_COLORS[:]
    random.shuffle(colors)
    while len(colors) < n_pieces:
        colors.append(random.choice(PIECE_COLORS))

    occupied = set((r, c) for r in range(grid_h) for c in range(grid_w) if grid[r, c] != BG)
    piece_specs = []
    holes_by_shape = {hole["shape"]: hole for hole in hole_info}
    for idx, quadrant in enumerate(quadrants):
        hole_shape = hole_shapes_exact[idx]
        if hole_shape not in holes_by_shape:
            return None
        inverse_rot = (-QUADRANT_ROTATIONS[quadrant]) % 4
        piece_shape = _rotate_coords(hole_shape, inverse_rot)
        box_h = max(r for r, _ in piece_shape) + 1
        box_w = max(c for _, c in piece_shape) + 1
        pos = _scatter_positions(len(piece_shape), box_h, box_w, axis_r, axis_c, quadrant, occupied, grid_h, grid_w)
        if pos is None:
            return None
        pr, pc = pos
        color = colors[idx]
        coords = []
        for dr, dc in piece_shape:
            rr = pr + dr
            cc = pc + dc
            if grid[rr, cc] != BG:
                return None
            grid[rr, cc] = color
            coords.append((rr, cc))
        for rr in range(pr - 1, pr + box_h + 1):
            for cc in range(pc - 1, pc + box_w + 1):
                if 0 <= rr < grid_h and 0 <= cc < grid_w:
                    occupied.add((rr, cc))
        piece_specs.append(
            {
                "quadrant": quadrant,
                "color": color,
                "shape": piece_shape,
                "coords": tuple(coords),
                "hole": holes_by_shape[hole_shape],
            }
        )

    expected = np.full((grid_h, grid_w), BG, dtype=int)
    grey_mask = board == GREY
    expected[board_top : board_top + board_h, board_left : board_left + board_w][grey_mask] = GREY
    for spec in piece_specs:
        for r, c in spec["hole"]["coords"]:
            expected[r, c] = spec["color"]

    try:
        actual = main(grid)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None

    # Keep the task non-degenerate: each non-zero rotation must matter.
    quad_has_distinct_rotation = {"ur": False, "lr": False, "ll": False}
    for spec in piece_specs:
        q = spec["quadrant"]
        if q == "ul":
            continue
        if _rotate_coords(spec["shape"], QUADRANT_ROTATIONS[q]) != spec["shape"]:
            quad_has_distinct_rotation[q] = True
    if not all(quad_has_distinct_rotation.values()):
        return None

    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid puzzle sample")
