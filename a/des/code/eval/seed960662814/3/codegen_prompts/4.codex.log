+    for comp in _component_coords(sub == BG, connectivity=4):
+        abs_comp = [(r0 + r, c0 + c) for r, c in comp]
+        norm, (hr0, hc0) = _normalize(abs_comp)
+        rows = [r for r, _ in abs_comp]
