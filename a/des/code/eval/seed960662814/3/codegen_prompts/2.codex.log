+GREY = 5
+AZURE = 8
+MAROON = 9
+SOURCE_COLORS = [1, 2, 3, 4, 6, 7]
+MAX_GENERATE_ATTEMPTS = 400
+NON_MAROON_KINDS = ["edge", "parallel", "turn_edge"]
+MAROON_KINDS = ["maroon", "turn_maroon"]
