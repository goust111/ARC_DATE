+        kinds.append(random.choice(MAROON_KINDS if random.random() < 0.7 else NON_MAROON_KINDS))
+    random.shuffle(kinds)
+    return kinds
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(19, 25)
