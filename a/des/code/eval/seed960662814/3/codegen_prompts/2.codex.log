+        if result is None:
+            continue
+        source_front, path = result
+        source_cells = sprite_cells_from_front(source_front, direction)
+        return {
+            "color": color,
+            "direction": direction,
+            "source_cells": source_cells,
+            "mirror_cells": mirror_cells,
+            "absorber": None,
+            "reserved": source_cells | set(path) | copy_cells | mirror_cells,
+        }
