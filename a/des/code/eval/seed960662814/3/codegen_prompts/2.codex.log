+            or not cells_in_zone(mirror_cells | copy_cells, zone)
+            or not free_of_reserved(mirror_cells | copy_cells, reserved)
+        ):
+            continue
+        result = choose_source_front(
+            endpoint,
+            direction,
+            zone,
+            grid.shape,
+            reserved | mirror_cells,
