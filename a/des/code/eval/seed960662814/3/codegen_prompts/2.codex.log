+    if not np.any(out == AZURE):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATE_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
