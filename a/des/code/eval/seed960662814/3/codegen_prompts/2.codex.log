+def trace_segment(start: tuple[int, int], direction: tuple[int, int], steps: int) -> list[tuple[int, int]]:
+    r, c = start
+    dr, dc = direction
+    return [(r + dr * k, c + dc * k) for k in range(1, steps + 1)]
