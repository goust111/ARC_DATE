import random
from collections import Counter
import numpy as np

BG=0

def bg(g):
    return 0 if (g==0).any() else Counter(map(int,g.ravel())).most_common(1)[0][0]

def comps(mask):
    h,w=mask.shape
    seen=np.zeros((h,w),dtype=bool)
    out=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            stack=[(r,c)]
            seen[r,c]=True
            pts=[]
            while stack:
                cr,cc=stack.pop()
                pts.append((cr,cc))
                for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                    nr,nc=cr+dr,cc+dc
                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc]=True
                        stack.append((nr,nc))
            out.append(pts)
    return out

def parse_strip(pts):
    rows=sorted({r for r,_ in pts})
    cols=sorted({c for _,c in pts})
    if len(rows)==1:
        row=rows[0]
        assert cols==list(range(cols[0], cols[-1]+1))
        return {'orientation':'H','row':row,'c0':cols[0],'c1':cols[-1]}
    if len(cols)==1:
        col=cols[0]
        assert rows==list(range(rows[0], rows[-1]+1))
        return {'orientation':'V','col':col,'r0':rows[0],'r1':rows[-1]}
    raise AssertionError

def pairs(g):
    out=[]
    for color in [int(x) for x in np.unique(g) if int(x)"'!=bg(g)]:
        cs=comps(g==color)
        assert len(cs)==2
        strips=[parse_strip(c) for c in cs]
        hs=[s for s in strips if s['"'orientation']=='H']
        vs=[s for s in strips if s['orientation']=='V']
        assert len(hs)==len(vs)==1
        out.append((color,hs[0],vs[0]))
    return out

def main(grid):
    g=np.asarray(grid,dtype=int)
    out=g.copy()
    bgc=bg(g)
    parsed=[]
    for color,h,v in pairs(g):
        rh=h['row']; cv=v['col']
        assert cv < h['c0'] or cv > h['c1']
        assert rh < v['r0'] or rh > v['r1']
        h_face = h['c1'] if h['c1'] < cv else h['c0']
        v_face = v['r1'] if v['r1'] < rh else v['r0']
        rr0,rr1=sorted((rh,v_face))
        cc0,cc1=sorted((h_face,cv))
        parsed.append((rr0,cc0,color,h,v,h_face,v_face))
    parsed.sort()
    for _,_,color,h,v,h_face,v_face in parsed:
        rh=h['row']; cv=v['col']
        rr0,rr1=sorted((rh,v_face))
        cc0,cc1=sorted((h_face,cv))
        for r in range(rr0,rr1+1):
            for c in range(cc0,cc1+1):
                if out[r,c]==bgc and (r+c)%2==0:
                    out[r,c]=color
        step=1 if cv>h_face else -1
        c=h_face+step
        while (step==1 and c<=cv) or (step==-1 and c>=cv):
            val=int(out[rh,c])
            if val not in (bgc,color):
                break
            out[rh,c]=color
            c+=step
        step=1 if rh>v_face else -1
        r=v_face+step
        while (step==1 and r<=rh) or (step==-1 and r>=rh):
            val=int(out[r,cv])
            if val not in (bgc,color):
                break
            out[r,cv]=color
            r+=step
    return out

def make_pair(color,case):
    h_left,v_above=case
    Lh=random.randint(3,8)
    Lv=random.randint(3,8)
    gap_c=random.randint(2,6)
    gap_r=random.randint(2,6)
    hh=gap_r+Lv
    ww=gap_c+Lh
    patch=np.zeros((hh,ww),dtype=int)
    if v_above:
        rh=hh-1; vr0=0; vr1=Lv-1
    else:
        rh=0; vr0=gap_r; vr1=gap_r+Lv-1
    if h_left:
        cv=ww-1; hc0=0; hc1=Lh-1
    else:
        cv=0; hc0=gap_c; hc1=gap_c+Lh-1
    patch[rh,hc0:hc1+1]=color
    patch[vr0:vr1+1,cv]=color
    return patch

def can(mask,r0,c0,h,w,pad=1):
    rr0=max(0,r0-pad); cc0=max(0,c0-pad); rr1=min(mask.shape[0],r0+h+pad); cc1=min(mask.shape[1],c0+w+pad)
    return not mask[rr0:rr1,cc0:cc1].any()

def reserve(mask,r0,c0,h,w,pad=1):
    rr0=max(0,r0-pad); cc0=max(0,c0-pad); rr1=min(mask.shape[0],r0+h+pad); cc1=min(mask.shape[1],c0+w+pad)
    mask[rr0:rr1,cc0:cc1]=True

def gen():
    n=random.choice([1,2,3,4])
    h=random.randint(max(12,8+4*n),30)
    w=random.randint(max(12,8+4*n),30)
    g=np.zeros((h,w),dtype=int)
    mask=np.zeros((h,w),dtype=bool)
    colors=random.sample(range(1,10),n)
    cases=[(True,True),(True,False),(False,True),(False,False)]
    chosen=random.sample(cases,k=min(n,4))
    while len(chosen)<n: chosen.append(random.choice(cases))
    random.shuffle(chosen)
