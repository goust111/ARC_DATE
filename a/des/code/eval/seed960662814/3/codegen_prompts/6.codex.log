+
+    try:
+        pairs = _extract_pairs(grid)
+        if len(pairs) != pair_count:
+            return None
+        out = main(grid)
+    except AssertionError:
+        return None
+
+    if out.shape != grid.shape or np.array_equal(out, grid):
+        return None
+    return grid
