+        col = int(v_strip["col"])
+        h_face = int(h_strip["c1"]) if int(h_strip["c1"]) < col else int(h_strip["c0"])
+        v_face = int(v_strip["r1"]) if int(v_strip["r1"]) < row else int(v_strip["r0"])
+
+        r0, r1 = sorted((row, v_face))
+        c0, c1 = sorted((h_face, col))
