    # validate
    ps=pairs(g)
    assert len(ps)==n
    o=main(g)
    assert isinstance(o,np.ndarray)
    assert o.shape==g.shape
    return g,o

for _ in range(20):
    x=gen()
    if x is None:
        print('"'none')
        continue
print('ok')
