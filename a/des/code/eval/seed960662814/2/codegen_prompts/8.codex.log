+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+MAROON = 9
+SIGNAL_COLORS = (1, 2, 3, 4, 6, 7, 8)
+
+DOWN = (1, 0)
+UP = (-1, 0)
+RIGHT = (0, 1)
+LEFT = (0, -1)
+
+GRID_H_MIN = 15
+GRID_H_MAX = 22
+GRID_W_MIN = 15
+GRID_W_MAX = 22
+RAY_COUNT_MIN = 2
+RAY_COUNT_MAX = 4
+MAX_GENERATE_ATTEMPTS = 400
