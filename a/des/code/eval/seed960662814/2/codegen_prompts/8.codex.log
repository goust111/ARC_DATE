+def _segment_cells(start: tuple[int, int], direction: tuple[int, int], length: int) -> list[tuple[int, int]]:
+    r0, c0 = start
+    dr, dc = direction
+    return [(r0 + dr * step, c0 + dc * step) for step in range(1, length + 1)]
