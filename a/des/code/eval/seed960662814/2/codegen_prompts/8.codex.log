+    ray_count = random.randint(RAY_COUNT_MIN, RAY_COUNT_MAX)
+    edges = ["top", "left"]
+    while len(edges) < ray_count:
+        edges.append(random.choice(["top", "left"]))
+    random.shuffle(edges)
