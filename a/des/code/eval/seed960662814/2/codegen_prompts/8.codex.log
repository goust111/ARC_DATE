+                if marker_rel is not None:
+                    break
+            if marker_rel is None:
+                continue
+            claimed |= cells
+            prisms.append(
+                {
+                    "top_left": (r0, c0),
+                    "body_color": body_color,
+                    "marker_color": marker_color,
