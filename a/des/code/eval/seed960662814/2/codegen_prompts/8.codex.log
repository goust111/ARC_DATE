+        exit_pos = (r0 + 2, c0 + 1) if mr == 1 else (r0 - 1, c0 + 1)
+    elif direction == LEFT:
+        if mc != 0:
+            return None
+        out_dir = DOWN if mr == 1 else UP
+        exit_pos = (r0 + 2, c0) if mr == 1 else (r0 - 1, c0)
