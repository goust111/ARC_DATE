+            if cells & target_mask or cells & claimed:
+                continue
+            window = grid[r0 : r0 + 2, c0 : c0 + 2]
+            counts = Counter(int(v) for v in window.ravel())
+            if len(counts) != 2:
+                continue
+            body_color = None
+            marker_color = None
+            for color, count in counts.items():
+                if count == 3:
+                    body_color = color
+                elif count == 1:
