+def _transform(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    bg = int(Counter(map(int, g.flat)).most_common(1)[0][0])
+    legend_mask, order, mix_map, wall = _parse_legend(g, bg)
+    h, w = g.shape
