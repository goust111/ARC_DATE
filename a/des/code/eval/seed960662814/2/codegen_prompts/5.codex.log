+    source_positions: dict[int, list[tuple[int, int]]] = {}
+    for color in order:
+        pts = [
+            (int(r), int(c))
+            for r, c in np.argwhere((g == int(color)) & (~legend_mask))
+        ]
+        assert len(pts) == 1, "each legend color must have exactly one source pixel"
