+    frontier: dict[int, list[tuple[int, int]]] = {}
+    for color, pts in source_positions.items():
+        frontier[int(color)] = list(pts)
+        for r, c in pts:
+            claimed[r, c] = True
+
+    while frontier:
+        proposals: dict[tuple[int, int], set[int]] = defaultdict(set)
+        for color, cells in frontier.items():
