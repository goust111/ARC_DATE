+            layer = int(dist[lr, lc])
+            color = int(master["color"]) if layer % 2 == 1 else int(child["color"])
+            gr = int(sr0 + lr)
+            gc = int(sc0 + lc)
+            assert int(out[gr, gc]) == int(bg), "expansion layers must only paint background"
+            out[gr, gc] = color
