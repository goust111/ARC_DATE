+    ph, pw = patch.shape
+    rows = range(int(pad), int(h - ph - pad + 1))
+    cols = range(int(pad), int(w - pw - pad + 1))
+    candidates = [(r, c) for r in rows for c in cols]
+    random.shuffle(candidates)
+    for r, c in candidates:
+        rr0 = int(r - pad)
+        cc0 = int(c - pad)
+        rr1 = int(r + ph + pad)
+        cc1 = int(c + pw + pad)
+        if reserved[rr0:rr1, cc0:cc1].any():
