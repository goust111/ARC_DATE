+
+def _valid_library() -> bool:
+    for mask in STAMP_LIBRARY:
+        comps = _components(mask, connectivity=4)
+        if len(comps) != 1:
+            return False
+        bottom = int(np.argwhere(mask)[:, 0].max())
+        if int(mask[bottom].sum()) != 1:
+            return False
