    irregular_dims = [d for d in dims if d[0] * d[1] > area]
    if irregular_dims and _RNG.random() < IRREGULAR_PROB:
        dims = irregular_dims
    h, w = dims[int(_RNG.integers(0, len(dims)))]
    mask = _make_mask(h, w, area)
