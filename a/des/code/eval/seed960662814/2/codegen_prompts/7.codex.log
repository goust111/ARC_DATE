+        side = _marked_side(patch)
+        if side is None:
+            continue
+
+        clean_border = patch[border_mask].copy()
+        clean_border[clean_border != FRAME_COLOR] = FRAME_COLOR
+        if not np.all(clean_border == FRAME_COLOR):
+            continue
