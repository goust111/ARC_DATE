+
+def _detect_containers(grid: np.ndarray, bg: int) -> list[dict]:
+    comps = _components((grid != bg) & (grid != FRAGMENT_COLOR))
+    containers: list[dict] = []
+
+    for comp in comps:
+        r0, c0, r1, c1 = _bbox(comp)
+        if r1 - r0 + 1 < 5 or c1 - c0 + 1 < 5:
+            continue
