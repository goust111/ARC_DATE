+def _marked_side(patch: np.ndarray) -> str | None:
+    sides = {
+        "top": patch[0, :],
+        "bottom": patch[-1, :],
+        "left": patch[:, 0],
+        "right": patch[:, -1],
+    }
+    marked: list[str] = []
+    for side, line in sides.items():
+        idx = np.flatnonzero(line != FRAME_COLOR)
+        if idx.size == 0:
+            continue
+        if idx[-1] - idx[0] + 1 != idx.size:
+            return None
+        if len(set(map(int, line[idx]))) != 1:
+            return None
+        marked.append(side)
+    if len(marked) != 1:
+        return None
+    return marked[0]
