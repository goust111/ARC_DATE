+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        border_mask = np.zeros_like(patch, dtype=bool)
+        border_mask[0, :] = True
+        border_mask[-1, :] = True
+        border_mask[:, 0] = True
+        border_mask[:, -1] = True
+        if np.any(patch[border_mask] == bg):
+            continue
