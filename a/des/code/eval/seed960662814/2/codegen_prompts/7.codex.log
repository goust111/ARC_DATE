+        placements.append((pick[0], pick[1], patch_name))
+        blocked[
+            max(0, pick[0] - PLACEMENT_PAD) : min(h, pick[0] + ph + PLACEMENT_PAD),
+            max(0, pick[1] - PLACEMENT_PAD) : min(w, pick[1] + pw + PLACEMENT_PAD),
+        ] = True
