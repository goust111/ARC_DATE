+
+
+def _band_segment(rng: np.random.Generator, length: int) -> tuple[int, int]:
+    band_len = int(rng.integers(2, length - 1))
+    start = int(rng.integers(1, length - band_len))
+    return start, start + band_len
+
+
+def _make_container(
+    rng: np.random.Generator,
+    bg: int,
