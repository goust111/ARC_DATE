+        max_r = max(r for r, _ in spec["arrow_cells"])
+        max_c = max(c for _, c in spec["arrow_cells"])
+        pr0 = max(0, top - 1)
+        pc0 = max(0, left - 1)
+        pr1 = min(instr_h - 1, top + max_r + 1)
+        pc1 = min(instr_w - 1, left + max_c + 1)
+        reserved[pr0 : pr1 + 1, pc0 : pc1 + 1] = True
