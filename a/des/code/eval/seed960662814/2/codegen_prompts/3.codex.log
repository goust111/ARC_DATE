+    rng = np.random.default_rng()
+    call_index = _GEN_COUNTER
+    _GEN_COUNTER += 1
+
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(rng, call_index)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid ARC instance")

