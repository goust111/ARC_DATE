+
+def _pick_seed_local(inner_size: int, quadrant: str) -> tuple[int, int]:
+    mid = inner_size // 2
+    if inner_size % 2 == 0:
+        top_rows = range(0, mid)
+        bottom_rows = range(mid, inner_size)
+        left_cols = range(0, mid)
+        right_cols = range(mid, inner_size)
+    else:
