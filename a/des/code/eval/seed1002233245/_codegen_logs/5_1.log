+                ok = False
+                break
+            patch[rr, cc] = frame_color
+        if not ok:
+            continue
+
+        patch[gap] = BG
+        sr, sc = start
+        rr0, rr1 = row_ranges[sr]
+        cc0, cc1 = col_ranges[sc]
+        candidates = [
+            (rr, cc)
+            for rr in range(rr0, rr1 + 1)
+            for cc in range(cc0, cc1 + 1)
+            if patch[rr, cc] == BG
