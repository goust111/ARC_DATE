+def _boxes_separated(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 0) -> bool:
+    return (
+        int(a[2]) + int(pad) < int(b[0])
+        or int(b[2]) + int(pad) < int(a[0])
+        or int(a[3]) + int(pad) < int(b[1])
+        or int(b[3]) + int(pad) < int(a[1])
