+        cells = {seed}
+        frontier = set(_neighbors4(seed[0], seed[1], h, w))
+        while len(cells) < target_cells and frontier:
+            cell = random.choice(tuple(frontier))
+            frontier.remove(cell)
+            cells.add(cell)
+            for nb in _neighbors4(cell[0], cell[1], h, w):
+                if nb not in cells:
