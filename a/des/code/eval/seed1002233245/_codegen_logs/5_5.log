+    band_a = g[:top_sep, :].copy()
+    band_b = g[top_sep + 1 : mid_sep, :].copy()
+    test_band = g[mid_sep + 1 :, :].copy()
+    assert band_a.size > 0 and band_b.size > 0 and test_band.size > 0
