+        top, left = pos
+        reserve_bbox(reserved, top, left, frame_h, frame_w, pad=1)
+        draw_frame(inp, top, left, inner_h, inner_w, FRAME_COLOR)
+        draw_frame(out, top, left, inner_h, inner_w, FRAME_COLOR)
