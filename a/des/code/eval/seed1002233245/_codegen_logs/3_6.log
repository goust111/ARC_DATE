+def pick_placement(
+    reserved: np.ndarray, obj_h: int, obj_w: int, pad: int = 1
+) -> tuple[int, int] | None:
+    h, w = reserved.shape
+    candidates: list[tuple[int, int]] = []
+    for top in range(1, h - obj_h):
+        for left in range(1, w - obj_w):
+            r0 = top - pad
+            c0 = left - pad
+            r1 = top + obj_h + pad
+            c1 = left + obj_w + pad
