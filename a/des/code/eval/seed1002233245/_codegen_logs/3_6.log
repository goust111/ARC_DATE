+    key_colors = [c for c in range(10) if c not in (bg, FRAME_COLOR, FRAGMENT_COLOR)]
+    if len(key_colors) < n_matched:
+        return None
+    random.shuffle(key_colors)
+    key_colors = key_colors[:n_matched]
