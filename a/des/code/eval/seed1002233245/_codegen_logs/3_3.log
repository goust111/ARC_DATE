+def _legend_lookup(g: np.ndarray) -> dict[frozenset[str], int]:
+    assert g.shape[0] >= 2 and g.shape[1] >= 2, "grid must fit the 2x2 legend"
+    legend = np.asarray(g[:2, :2], dtype=int)
+    return {
+        pair: int(legend[r, c])
+        for pair, (r, c) in CORNER_TO_LEGEND_POS.items()
+    }
+
