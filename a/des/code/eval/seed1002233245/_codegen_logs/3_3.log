+    for r_raw, c_raw in np.argwhere(mask):
+        r = int(r_raw)
+        c = int(c_raw)
+        if seen[r, c]:
+            continue
+        seen[r, c] = True
+        q = deque([(r, c)])
+        comp: list[tuple[int, int]] = []
+        while q:
+            cr, cc = q.popleft()
+            comp.append((cr, cc))
+            for dr, dc in SIDE_STEPS.values():
+                nr = cr + dr
+                nc = cc + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
