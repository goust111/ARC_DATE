+SIDE_STEPS = {
+    "U": (-1, 0),
+    "D": (1, 0),
+    "L": (0, -1),
+    "R": (0, 1),
+}
+OPPOSITE = {
+    "U": "D",
+    "D": "U",
+    "L": "R",
+    "R": "L",
+}
+CORNER_TO_LEGEND_POS = {
+    frozenset({"R", "D"}): (0, 0),
+    frozenset({"L", "D"}): (0, 1),
+    frozenset({"R", "U"}): (1, 0),
+    frozenset({"L", "U"}): (1, 1),
+}
+
+GEN_RETRIES = 400
+GEN_SIZE_MIN = 12
+GEN_SIZE_MAX = 20
+GEN_SEGMENT_COUNTS = (3, 5)
+GEN_GAP = 3
+
