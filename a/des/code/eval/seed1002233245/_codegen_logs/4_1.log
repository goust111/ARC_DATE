+from __future__ import annotations
+
+from collections import deque
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+@dataclass(frozen=True)
+class Container:
+    border_color: int
+    pattern_color: int
+    signal_color: int
+    bbox: tuple[int, int, int, int]
+    pattern_mask: np.ndarray
+    signal_pos: tuple[int, int]
