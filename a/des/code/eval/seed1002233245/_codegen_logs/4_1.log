+COLOR_POOL = list(range(1, 10))
+GRID_MIN, GRID_MAX = 20, 30
+PAIR_COUNT_CHOICES = (1, 2)
+INTERIOR_SHAPES = ((5, 5), (5, 7), (7, 5), (7, 7), (7, 9), (9, 7))
+GEN_RETRIES = 400
+PLACEMENT_RETRIES = 120
