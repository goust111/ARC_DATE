+
+
+def _container_from_spec(spec: ContainerSpec, top: int, left: int) -> Container:
+    h, w = spec.interior_shape
+    return Container(
+        border_color=spec.border_color,
+        pattern_color=spec.pattern_color,
+        signal_color=spec.signal_color,
