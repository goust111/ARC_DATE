+
+
+def _random_pattern(shape: tuple[int, int], signal_pos: tuple[int, int]) -> np.ndarray | None:
+    h, w = shape
+    allowed = [(r, c) for r in range(h) for c in range(w) if (r, c) != signal_pos]
+    max_area = min(8, len(allowed) - 1)
