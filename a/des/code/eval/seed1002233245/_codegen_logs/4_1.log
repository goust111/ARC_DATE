+                Container(
+                    border_color=int(color),
+                    pattern_color=pattern_color,
+                    signal_color=signal_color,
+                    bbox=(r0, c0, r1, c1),
+                    pattern_mask=pattern_mask.copy(),
+                    signal_pos=(int(signal_coords[0, 0]), int(signal_coords[0, 1])),
+                )
+            )
