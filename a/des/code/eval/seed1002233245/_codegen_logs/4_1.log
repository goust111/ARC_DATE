+            pattern_color=random.choice(pattern_pool),
+            signal_color=b_border,
+            interior_shape=shape,
+            pattern_mask=mask_a,
+            signal_pos=sig_a,
+        )
+        spec_b = ContainerSpec(
+            border_color=b_border,
+            pattern_color=random.choice(pattern_pool),
+            signal_color=a_border,
+            interior_shape=shape,
+            pattern_mask=mask_b,
+            signal_pos=sig_b,
