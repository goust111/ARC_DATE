+
+def _random_template_mask(rng: random.Random) -> np.ndarray:
+    h = rng.randint(2, 4)
+    w = rng.randint(2, 4)
+    mask = np.ones((h, w), dtype=bool)
+    cells = [(r, c) for r in range(h) for c in range(w)]
+    rng.shuffle(cells)
