+def _group_indices(n: int, groups: int, rng: random.Random) -> list[list[int]]:
+    ids = list(range(n))
+    rng.shuffle(ids)
+    out = [[] for _ in range(groups)]
+    for i, idx in enumerate(ids):
+        out[i % groups].append(idx)
+    for group in out:
