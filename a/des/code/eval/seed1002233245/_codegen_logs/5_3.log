+def _embed(zone: np.ndarray, target_h: int, rng: random.Random) -> tuple[np.ndarray, int]:
+    top = rng.randint(0, target_h - zone.shape[0])
+    canvas = np.full((target_h, zone.shape[1]), BG, dtype=int)
