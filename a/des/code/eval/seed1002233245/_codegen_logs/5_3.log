+    removed = 0
+    for r, c in cells:
+        if removed >= max_remove:
+            break
+        trial = mask.copy()
+        trial[r, c] = False
+        if not np.any(trial):
+            continue
+        if np.any(trial.sum(axis=0) == 0) or np.any(trial.sum(axis=1) == 0):
+            continue
+        if not _mask_connected(trial):
+            continue
+        mask = trial
+        removed += 1
+    return mask
