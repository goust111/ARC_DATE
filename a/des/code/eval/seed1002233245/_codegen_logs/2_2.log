+    row_bounds = [-1] + sorted(sep_rows) + [g.shape[0]]
+    col_bounds = [-1] + sorted(sep_cols) + [g.shape[1]]
+
+    for ri in range(len(row_bounds) - 1):
+        r0 = row_bounds[ri] + 1
+        r1 = row_bounds[ri + 1] - 1
+        if r0 > r1:
+            continue
+        for ci in range(len(col_bounds) - 1):
