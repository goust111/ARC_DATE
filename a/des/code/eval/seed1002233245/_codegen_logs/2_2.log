+    widths = [random.randint(10, 14) for _ in range(n_cols)]
+
+    line_count = (1 if top_border else 0) + (1 if left_border else 0) + (n_rows - 1) + (n_cols - 1)
+    palette = list(SEPARATOR_COLORS)
+    random.shuffle(palette)
