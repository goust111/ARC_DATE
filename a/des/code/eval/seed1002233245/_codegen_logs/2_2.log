+def _make_layout() -> tuple[np.ndarray, list[tuple[int, int]], list[tuple[int, int]], list[int | None], list[int | None]]:
+    mode = random.choice(("top_only", "left_only", "both"))
+    if mode == "top_only":
+        n_rows = random.randint(2, 4)
