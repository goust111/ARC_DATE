+            gbox = (gr, gc, gr + gh - 1, gc + gw - 1)
+            for kr in key_rows:
+                for kc in key_cols:
+                    kbox = (kr, kc, kr + kh - 1, kc + kw - 1)
+                    if _boxes_separated(gbox, kbox, pad=1):
