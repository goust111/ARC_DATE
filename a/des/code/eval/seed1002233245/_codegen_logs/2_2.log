+def _find_separator_rows(grid: np.ndarray, sep_cols: list[int]) -> tuple[list[int], dict[int, int]]:
+    rows: list[int] = []
+    colors: dict[int, int] = {}
+    keep = [c for c in range(grid.shape[1]) if c not in set(sep_cols)]
