+            out = main(grid)
+            assert isinstance(out, np.ndarray)
+            assert out.shape == grid.shape
+            assert np.any(out != grid)
+            assert not np.any(out == MAROON)
+            return grid
+        except AssertionError:
+            continue
+
+    raise RuntimeError("generator failed to produce a valid sample")

