+def _extract_templates(left: np.ndarray) -> Dict[int, List[int]]:
+    templates: Dict[int, List[int]] = {}
+    for comp in _components(left != BG):
+        pts = np.array(comp, dtype=int)
+        r0, c0 = pts.min(axis=0)
+        r1, c1 = pts.max(axis=0)
