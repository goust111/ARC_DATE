+def _find_separator(grid: np.ndarray) -> int:
+    candidates = [c for c in range(grid.shape[1]) if np.all(grid[:, c] == SEP)]
+    if not candidates:
+        raise ValueError("separator column not found")
+    if len(candidates) == 1:
+        return candidates[0]
+    for c in candidates:
+        if np.any(grid[:, :c] != BG) and np.any(grid[:, c + 1 :] != BG):
+            return c
+    return candidates[0]
+
