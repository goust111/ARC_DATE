+    for _ in range(PLACEMENT_RETRIES):
+        r0 = rng.randint(0, height - group_h)
+        c0 = rng.randint(0, width - group_w)
+        rr0 = max(0, r0 - 1)
+        cc0 = max(0, c0 - 1)
