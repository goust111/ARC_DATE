+    strips = {
+        "up": [(r0 - 1, c) for c in range(c0 + 1, c1)],
+        "down": [(r1 + 1, c) for c in range(c0 + 1, c1)],
+        "left": [(r, c0 - 1) for r in range(r0 + 1, r1)],
+        "right": [(r, c1 + 1) for r in range(r0 + 1, r1)],
