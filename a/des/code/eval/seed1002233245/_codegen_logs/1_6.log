+def _orientation_list(count: int) -> list[str]:
+    if count == 1:
+        return [random.choice(("horizontal", "vertical"))]
+    kinds = ["horizontal", "vertical"]
+    while len(kinds) < count:
+        kinds.append(random.choice(("horizontal", "vertical")))
