+
+def _min_component_distance(a: dict, b: dict) -> int:
+    best = 10**9
+    for ar, ac in a["coords"]:
+        for br, bc in b["coords"]:
+            dist = abs(ar - br) + abs(ac - bc)
+            if dist < best:
+                best = dist
+    return best
