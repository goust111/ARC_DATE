+
+def _nearest_marker(pattern: dict, components: list[dict]) -> dict:
+    ranked = []
+    for comp in components:
+        if comp is pattern or comp["color"] == pattern["color"]:
+            continue
+        ranked.append((_min_component_distance(pattern, comp), comp))
