+    comp = random.choice(comps)
+    comp_set = set(comp)
+    seed = random.choice(comp)
+    chosen = {seed}
+    frontier = {cell for cell in _neighbors4(seed[0], seed[1], *allowed.shape) if cell in comp_set}
