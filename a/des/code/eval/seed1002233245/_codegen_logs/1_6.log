+    ranked.sort(key=lambda item: item[0])
+    if len(ranked) > 1:
+        assert ranked[0][0] < ranked[1][0], "nearest non-matching component must be unique"
+    marker = ranked[0][1]
+    assert marker["size"] == 1, "nearest non-matching component must be the marker pixel"
+    return marker
