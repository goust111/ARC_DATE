+def _render_grid(
+    shape: tuple[int, int],
+    wall_cells: set[tuple[int, int]],
+    seeds: list[tuple[int, int, int]],
+) -> np.ndarray:
+    grid = np.full(shape, BLACK, dtype=int)
+    for r, c in wall_cells:
+        grid[r, c] = WALL
+    for r, c, color in seeds:
+        grid[r, c] = color
+    return grid
