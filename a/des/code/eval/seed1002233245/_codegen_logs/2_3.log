    if cell in wall_cells or cell in seed_cells or cell in protected_empty:
        return False
    for nr, nc in _neighbors4(r, c):
        if (nr, nc) in wall_cells:
            return False
    for nr, nc in _neighbors8(r, c):
        if (nr, nc) in seed_cells:
            return False
    return True


