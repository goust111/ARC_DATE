+
+def _can_place_wall(
+    shape: tuple[int, int],
+    cells: list[tuple[int, int]],
+    wall_cells: set[tuple[int, int]],
+    seed_cells: set[tuple[int, int]],
+    protected_empty: set[tuple[int, int]],
+) -> bool:
+    candidate = set(cells)
