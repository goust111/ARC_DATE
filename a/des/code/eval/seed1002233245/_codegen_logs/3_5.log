+    scene[0, :] = WALL
+    scene[-1, :] = WALL
+    scene[:, 0] = WALL
+    scene[:, -1] = WALL
+    for r0, _r1 in row_bounds[:-1]:
+        wall_r = _r1 + 1
+        scene[wall_r, :] = WALL
+    for c0, _c1 in col_bounds[:-1]:
