+                    "row": int(i),
+                    "col": int(j),
+                    "r0": int(r0),
+                    "r1": int(r1),
+                    "c0": int(c0),
+                    "c1": int(c1),
+                    "height": int(r1 - r0 + 1),
+                    "width": int(c1 - c0 + 1),
