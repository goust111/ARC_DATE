+    lamp_palette: list[int],
+    meta: dict,
+) -> np.ndarray | None:
+    scene, rooms = _build_scene(row_sizes, col_sizes, bg)
+    rooms_by_key = _room_map(rooms)
+    nr = len(row_sizes)
+    nc = len(col_sizes)
+
+    for r, c in required_doors:
+        scene[r, c] = bg
+    _add_extra_doors(scene, rooms_by_key, nr, nc, required_doors, bg)
