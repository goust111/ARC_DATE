+    else:
+        max_count = 0
+    assert max_count < len(legend_colors), "legend must cover every illumination count"
+
+    out = g.copy()
+    for count, color in enumerate(legend_colors):
+        out[bg_mask & (counts == count)] = int(color)
+    out[legend_mask] = int(bg)
+    return out
