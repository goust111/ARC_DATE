+
+    cursor = 1
+    for size in col_sizes:
+        c0 = cursor
+        c1 = c0 + int(size) - 1
+        col_bounds.append((c0, c1))
+        cursor = c1 + 2
+    scene_w = col_bounds[-1][1] + 2
+
+    scene = np.full((scene_h, scene_w), int(bg), dtype=int)
+    scene[0, :] = WALL
+    scene[-1, :] = WALL
+    scene[:, 0] = WALL
+    scene[:, -1] = WALL
+    for r0, _r1 in row_bounds[:-1]:
+        wall_r = _r1 + 1
+        scene[wall_r, :] = WALL
+    for c0, _c1 in col_bounds[:-1]:
+        wall_c = _c1 + 1
+        scene[:, wall_c] = WALL
