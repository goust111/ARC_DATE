+ROOM_SIZE_MIN = 4
+ROOM_SIZE_MAX = 6
+TOP_PAD_MAX = 2
+LEFT_PAD_MAX = 2
+BOTTOM_PAD_MAX = 2
+RIGHT_GAP_MIN = 1
+RIGHT_GAP_MAX = 2
+EXTRA_DOOR_PROB = 0.25
+EXTRA_OBSTACLE_PROB = 0.45
+SECOND_OBSTACLE_PROB = 0.25
