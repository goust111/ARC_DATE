+                    "coords": coords,
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                    "area": len(coords),
+                    "colors": {int(grid[rr, cc]) for rr, cc in coords},
+                }
+            )
+    return comps
+
