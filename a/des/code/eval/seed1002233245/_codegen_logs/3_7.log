+    r0, c0, r1, c1 = bbox
+    blocked = np.zeros_like(g, dtype=bool)
+    blocked[r0 : r1 + 1, c0 : c1 + 1] = True
+
+    for color in path_colors:
+        assert np.any((g == color) & ~blocked), "every matrix color must label a visible path"
+
+    out = g.copy()
+    out[blocked] = bg
