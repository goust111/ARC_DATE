+def _stack_order(
+    rects: dict[int, tuple[int, int, int, int]],
+    visible_masks: dict[int, np.ndarray],
+) -> list[int]:
+    colors = list(rects)
+    edges = {color: set() for color in colors}
+    indeg = {color: 0 for color in colors}
+
+    for a in colors:
+        ar0, ac0, ar1, ac1 = rects[a]
+        for b in colors:
+            if a == b:
