+        comps = _components(mask)
+        assert len(comps) == 1, "each color must form one visible component"
+        coords = comps[0]
+        r0, c0 = map(int, coords.min(axis=0))
+        r1, c1 = map(int, coords.max(axis=0))
+        infos[color] = (r0, c0, r1, c1)
+        visible_masks[color] = mask
