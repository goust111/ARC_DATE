+    left_piece = scene["pieces"][left_color]
+    options: list[dict] = []
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+
+    for top_op in OPS:
+        top_mask = _transform(top_piece, *top_op)
+        for left_op in OPS:
+            left_mask = _transform(left_piece, *left_op)
