+
+def _split_nonempty(items: list[int], groups: int, rng: random.Random) -> list[list[int]]:
+    if groups == 1:
+        return [items]
+    cuts = sorted(rng.sample(range(1, len(items)), groups - 1))
+    out = []
+    start = 0
+    for cut in cuts + [len(items)]:
+        out.append(items[start:cut])
+        start = cut
+    return out
+
