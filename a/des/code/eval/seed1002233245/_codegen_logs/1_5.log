+    degrees = [sum(neigh in cells for neigh in _neighbors4(*cell)) for cell in cells]
+    return max(degrees, default=0) <= 2 and sum(degree == 1 for degree in degrees) == 2
+
+
+def _order_path(
+    path_cells: set[tuple[int, int]],
+    start: tuple[int, int],
+    end: tuple[int, int],
