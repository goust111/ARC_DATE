+        if y1 < x0:
+            return int(x0 - y1 - 1)
+        if x1 < y0:
+            return int(y0 - x1 - 1)
+        return 0
+
+    return int(gap_1d(a[0], a[2], b[0], b[2]) + gap_1d(a[1], a[3], b[1], b[3]))
