+            comps.append(np.array(cells, dtype=int))
+
+    return comps
+
+
+def _bbox(cells: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(cells[:, 0].min()),
+        int(cells[:, 1].min()),
+        int(cells[:, 0].max()),
+        int(cells[:, 1].max()),
+    )
