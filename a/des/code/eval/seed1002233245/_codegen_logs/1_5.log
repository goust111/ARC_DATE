+
+def _rotate_dir(direction: tuple[int, int], turns: int) -> tuple[int, int]:
+    dr, dc = direction
+    turns %= 4
+    for _ in range(turns):
+        dr, dc = -dc, dr
+    return int(dr), int(dc)
+
+
+def _rotate_points(
+    points: list[tuple[int, int]], height: int, width: int, turns: int
+) -> tuple[list[tuple[int, int]], int, int]:
+    turns %= 4
+    if turns == 0:
