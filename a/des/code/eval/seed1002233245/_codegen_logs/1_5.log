+        dc1 = int(path[i][1] - path[i - 1][1])
+        dr2 = int(path[i + 1][0] - path[i][0])
+        dc2 = int(path[i + 1][1] - path[i][1])
+        if (dr1, dc1) != (dr2, dc2):
