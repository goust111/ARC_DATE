+    built_frames = []
+    for index in range(n_frames):
+        if index == 0:
+            frame = _build_frame(
+                role="start",
+                path_color=path_colors[index],
+                incoming_marker=None,
+                outgoing_marker=marker_colors[index],
+                frame_index=index,
+                rng=rng,
+            )
+        elif index == n_frames - 1:
+            frame = _build_frame(
+                role="end",
+                path_color=path_colors[index],
+                incoming_marker=marker_colors[index - 1],
+                outgoing_marker=None,
+                frame_index=index,
+                rng=rng,
+            )
+        else:
+            frame = _build_frame(
+                role="internal",
+                path_color=path_colors[index],
+                incoming_marker=marker_colors[index - 1],
+                outgoing_marker=marker_colors[index],
+                frame_index=index,
+                rng=rng,
+            )
+        if frame is None:
+            return None
