+        patch[1, 1:] = int(color)
+        patch[:, 0] = int(color)
+        return patch
+    if direction == "down":
+        patch = np.full((steps + 1, 3), BG, dtype=int)
+        patch[:steps, 1] = int(color)
+        patch[steps, :] = int(color)
+        return patch
+    if direction == "up":
+        patch = np.full((steps + 1, 3), BG, dtype=int)
