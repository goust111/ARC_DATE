+
+
+def _translated_cells(
+    cells: set[tuple[int, int]],
+    dr: int,
+    dc: int,
+    h: int,
+    w: int,
+) -> set[tuple[int, int]]:
+    out = set()
+    for r, c in cells:
+        rr = int(r + dr)
+        cc = int(c + dc)
+        if 0 <= rr < h and 0 <= cc < w:
