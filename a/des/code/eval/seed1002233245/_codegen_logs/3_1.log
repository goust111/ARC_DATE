+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    expected = 2 * (h + w) - 4
+    if len(coords) != expected:
+        return False
+    pts = set(coords)
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
