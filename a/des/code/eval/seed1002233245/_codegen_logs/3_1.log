+def _make_template(rng: random.Random) -> np.ndarray:
+    for _ in range(200):
+        h = rng.choice((3, 5))
+        w = rng.choice((3, 5))
+        cr, cc = h // 2, w // 2
+        mask = np.zeros((h, w), dtype=bool)
+        mask[cr, cc] = True
+
+        anchors = [
+            (0, rng.randrange(w)),
+            (h - 1, rng.randrange(w)),
+            (rng.randrange(h), 0),
+            (rng.randrange(h), w - 1),
