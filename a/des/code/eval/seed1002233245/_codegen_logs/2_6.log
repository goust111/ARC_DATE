+
+def _render_scene(h: int, w: int, shapes: list[dict], dots: dict[tuple[int, int], int]) -> np.ndarray:
+    out = np.full((h, w), BG, dtype=int)
+    for shape in shapes:
+        for r, c in shape["cells"]:
+            out[r, c] = int(shape["color"])
