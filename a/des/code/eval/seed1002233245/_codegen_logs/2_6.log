+            right_last = lefts[-1] + lengths[-1] - 1
+            if right_last + outer_gap + 2 >= w:
+                return None
+            tip_cols = [0] * count
+            tip_cols[-1] = right_last + outer_gap + 1
+            for idx in range(count - 1):
