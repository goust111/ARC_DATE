+
+def _arrow_cells(tip: tuple[int, int], direction: tuple[int, int]) -> set[tuple[int, int]]:
+    tr, tc = tip
+    return {(tr + dr, tc + dc) for dr, dc in ARROW_OFFSETS[direction]}
