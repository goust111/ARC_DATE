+def _components(mask: np.ndarray, conn8: bool) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    neigh = _neighbors8 if conn8 else _neighbors4
