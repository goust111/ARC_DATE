+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _count_components(mask: np.ndarray) -> int:
+    if not np.any(mask):
+        return 0
+    return len(_components(mask))
+
+
+def _tight_crop(mask: np.ndarray) -> np.ndarray:
+    rows, cols = np.where(mask)
+    if rows.size == 0:
+        return mask.copy()
+    return mask[rows.min() : rows.max() + 1, cols.min() : cols.max() + 1]
+
+
+def _dilate4(mask: np.ndarray) -> np.ndarray:
+    padded = np.pad(mask, 1, constant_values=False)
+    return (
+        padded[1:-1, 1:-1]
+        | padded[:-2, 1:-1]
+        | padded[2:, 1:-1]
+        | padded[1:-1, :-2]
+        | padded[1:-1, 2:]
+    )
+
+
+def _erode4(mask: np.ndarray) -> np.ndarray:
+    padded = np.pad(mask, 1, constant_values=False)
+    return (
+        padded[1:-1, 1:-1]
+        & padded[:-2, 1:-1]
+        & padded[2:, 1:-1]
+        & padded[1:-1, :-2]
+        & padded[1:-1, 2:]
+    )
+
+
+def _boundary4(mask: np.ndarray) -> np.ndarray:
+    return mask & ~_erode4(mask)
+
+
+def _dilate_n(mask: np.ndarray, steps: int) -> np.ndarray:
+    out = mask.copy()
+    for _ in range(steps):
+        out = _dilate4(out)
+    return out
+
+
+def _erode_n(mask: np.ndarray, steps: int) -> np.ndarray:
+    out = mask.copy()
+    for _ in range(steps):
+        out = _erode4(out)
+        if not np.any(out):
+            break
+    return out
+
+
+def _flood_from_border(passable: np.ndarray) -> np.ndarray:
+    h, w = passable.shape
+    out = np.zeros_like(passable, dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if passable[r, c] and not out[r, c]:
+                out[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if passable[r, c] and not out[r, c]:
+                out[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and passable[nr, nc] and not out[nr, nc]:
+                out[nr, nc] = True
+                q.append((nr, nc))
+    return out
+
+
+def _has_hole(mask: np.ndarray) -> bool:
+    if not np.any(mask):
+        return False
+    inv = ~mask
+    outside = _flood_from_border(inv)
+    return bool(np.any(inv & ~outside))
+
+
+def _reconstruct_region(loop_mask: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    passable = ~loop_mask
+    outside = _flood_from_border(passable)
+    interior = passable & ~outside
+    return loop_mask | interior, interior
