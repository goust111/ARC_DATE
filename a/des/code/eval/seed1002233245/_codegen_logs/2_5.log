+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+MARKER = 4
+
+GEN_ATTEMPTS = 400
+SHAPE_ATTEMPTS = 300
+PLACE_ATTEMPTS = 300
+
+GRID_H_RANGE = (30, 36)
+GRID_W_RANGE = (30, 36)
+COUNTS = (1, 2, 3, 4)
+CORNERS = ("tl", "tr", "bl", "br")
+NON_MARKER_COLORS = [1, 2, 3, 5, 6, 7, 8, 9]
