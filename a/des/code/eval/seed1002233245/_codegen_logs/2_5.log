+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Shrink each colored loop inward by its interior marker count and repaint it
+    using the palette row indexed by that same count.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
