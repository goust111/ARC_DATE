+        boundary = _boundary4(region)
+        if _count_components(boundary) != 1:
+            continue
+
+        interior = region & ~boundary
+        if int(np.count_nonzero(interior)) < marker_count:
+            continue
+
+        shrunk = _erode_n(region, marker_count)
+        if vanish:
+            if marker_count < 2 or np.any(shrunk):
+                continue
+        else:
