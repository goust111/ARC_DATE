+    specs.sort(key=lambda item: item["area"], reverse=True)
+    for spec in specs:
+        ok = _place_loop(
+            rng,
+            grid,
+            blocked,
+            spec["region"],
+            spec["markers"],
+            int(spec["loop_color"]),
