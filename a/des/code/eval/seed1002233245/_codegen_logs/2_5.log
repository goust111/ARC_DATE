+            return None
+
+    for row_idx, palette_color in enumerate(palette_colors):
+        rr = pr0 + row_idx
+        grid[rr, pc0] = MARKER
+        grid[rr, pc0 + 1] = palette_color
+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return None
+    if np.count_nonzero(out != BG) <= 2 * palette_rows:
+        return None
+    return grid
