+        r0 = max(int(coords[:, 0].min()) - 1, 0)
+        r1 = min(int(coords[:, 0].max()) + 1, g.shape[0] - 1)
+        c0 = max(int(coords[:, 1].min()) - 1, 0)
+        c1 = min(int(coords[:, 1].max()) + 1, g.shape[1] - 1)
