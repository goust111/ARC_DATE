+BG = 0
+MARKER = 4
+
+GEN_ATTEMPTS = 400
+SHAPE_ATTEMPTS = 300
+PLACE_ATTEMPTS = 300
+
+GRID_H_RANGE = (30, 36)
+GRID_W_RANGE = (30, 36)
+COUNTS = (1, 2, 3, 4)
