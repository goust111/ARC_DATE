+    rh, rw = region.shape
+    boundary = _boundary4(region)
+    for _ in range(PLACE_ATTEMPTS):
+        top = rng.randint(1, h - rh - 1)
+        left = rng.randint(1, w - rw - 1)
+        if np.any(blocked[top : top + rh, left : left + rw]):
+            continue
+        if np.any(grid[top : top + rh, left : left + rw] != BG):
+            continue
