+def _random_polyomino(
+    rng: random.Random,
+    min_h: int,
+    max_h: int,
+    min_w: int,
+    max_w: int,
+    min_area: int,
+    max_area: int,
+) -> np.ndarray:
+    h = rng.randint(min_h, max_h)
