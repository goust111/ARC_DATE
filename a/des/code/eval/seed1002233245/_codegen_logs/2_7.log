+    nodes: list[dict] = []
+    for idx, comp in enumerate(sorted(node_components, key=lambda comp: (comp["bbox"][0], comp["bbox"][1]))):
+        r0, c0, _, _ = comp["bbox"]
+        nodes.append(
+            {
+                "id": int(idx),
+                "r0": int(r0),
+                "c0": int(c0),
+                "cells": list(comp["cells"]),
+            }
+        )
