+        "coords": [(0, 0), (0, 1), (1, 1), (2, 1)],
+        "edges": [(0, 1), (1, 2), (2, 3)],
+    },
+    "zigzag4": {
+        "coords": [(0, 0), (0, 1), (1, 1), (1, 2)],
+        "edges": [(0, 1), (1, 2), (2, 3)],
+    },
