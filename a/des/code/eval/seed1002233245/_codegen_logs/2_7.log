+def _transformed_coords(coords: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    transforms = (
+        lambda r, c: (r, c),
+        lambda r, c: (r, -c),
+        lambda r, c: (-r, c),
+        lambda r, c: (-r, -c),
+        lambda r, c: (c, r),
+        lambda r, c: (c, -r),
+        lambda r, c: (-c, r),
+        lambda r, c: (-c, -r),
+    )
