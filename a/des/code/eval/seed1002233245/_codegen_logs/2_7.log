+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+BG_COLOR = 0
+GAP_RANGE = (3, 7)
+GEN_RETRIES = 400
+BRANCHES = ("odd", "even_diff", "even_equal")
+
+TEMPLATES = {
+    "pair": {
+        "coords": [(0, 0), (0, 1)],
+        "edges": [(0, 1)],
+    },
+    "path3": {
+        "coords": [(0, 0), (0, 1), (0, 2)],
+        "edges": [(0, 1), (1, 2)],
+    },
+    "turn3": {
+        "coords": [(0, 0), (0, 1), (1, 1)],
+        "edges": [(0, 1), (1, 2)],
+    },
