+def _random_gap(parity: str | None = None) -> int:
+    values = [value for value in range(GAP_RANGE[0], GAP_RANGE[1] + 1) if parity is None or value % 2 == (0 if parity == "even" else 1)]
+    return int(random.choice(values))
