+def _graph_degrees(node_count: int, edges: list[tuple[int, int]]) -> dict[int, int]:
+    degrees = {idx: 0 for idx in range(node_count)}
+    for a, b in edges:
+        degrees[int(a)] += 1
+        degrees[int(b)] += 1
