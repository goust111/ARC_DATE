+        color = int(comp["color"])
+        hh, ww = patch.shape
+        if hh < 3 or ww < 3:
+            continue
+        if not np.all(patch[0, :] == color) or not np.all(patch[-1, :] == color):
+            continue
+        if not np.all(patch[:, 0] == color) or not np.all(patch[:, -1] == color):
+            continue
+        inner = patch[1:-1, 1:-1]
