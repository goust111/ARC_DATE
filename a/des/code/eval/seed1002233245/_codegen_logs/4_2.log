+def _find_components(grid: np.ndarray, *, exclude: set[int] | None = None) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    excluded = set() if exclude is None else {int(x) for x in exclude}
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
