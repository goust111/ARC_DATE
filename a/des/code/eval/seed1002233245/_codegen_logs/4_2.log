+def _extract_blocks(grid: np.ndarray, slot_color: int) -> list[dict]:
+    blocks = [comp for comp in _find_components(grid, exclude={BG, slot_color}) if _is_solid_square(grid, comp)]
+    assert 2 <= len(blocks) <= 5, "expected 2-5 blocks"
