+def _transform_grid(grid: np.ndarray, rotate_k: int, flip_lr: bool) -> np.ndarray:
+    out = np.rot90(grid, int(rotate_k))
+    if flip_lr:
+        out = np.fliplr(out)
+    return out.copy()
