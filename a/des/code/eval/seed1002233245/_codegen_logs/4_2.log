+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if seen[r, c] or color in excluded:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            coords = []
+            r0 = r1 = r
+            c0 = c1 = c
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                r0 = min(r0, cr)
+                r1 = max(r1, cr)
+                c0 = min(c0, cc)
+                c1 = max(c1, cc)
+                for nr, nc in _neighbors4(cr, cc, g.shape):
+                    if seen[nr, nc] or int(g[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
