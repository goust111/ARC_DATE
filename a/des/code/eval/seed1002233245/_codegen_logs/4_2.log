+
+def _find_components(grid: np.ndarray, *, exclude: set[int] | None = None) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    excluded = set() if exclude is None else {int(x) for x in exclude}
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if seen[r, c] or color in excluded:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            coords = []
+            r0 = r1 = r
+            c0 = c1 = c
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                r0 = min(r0, cr)
+                r1 = max(r1, cr)
+                c0 = min(c0, cc)
+                c1 = max(c1, cc)
+                for nr, nc in _neighbors4(cr, cc, g.shape):
+                    if seen[nr, nc] or int(g[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _extract_slot(grid: np.ndarray) -> dict:
