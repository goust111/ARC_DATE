+def _solve_frame(out: np.ndarray, grid: np.ndarray, frame_color: int, candidate: dict[str, object]) -> None:
+    r0, c0, r1, c1 = candidate["bbox"]  # type: ignore[index]
+    branch = candidate["branch"]  # type: ignore[index]
