+    qw = int(spec["qw"])
+    r1 = r0 + 2 * qh + 2
+    c1 = c0 + 2 * qw + 2
+    frame_color = int(spec["frame_color"])
+    pattern_color = int(spec["pattern_color"])
+    branch = str(spec["branch"])
