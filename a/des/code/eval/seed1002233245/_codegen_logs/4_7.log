+    grid[r1, c0 : c1 + 1] = int(color)
+    grid[r0 : r1 + 1, c0] = int(color)
+    grid[r0 : r1 + 1, c1] = int(color)
+
+
+def _draw_marks(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int, color: int, branch: str) -> None:
