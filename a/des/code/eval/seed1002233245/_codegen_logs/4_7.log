+def _quadrant_slices(interior_shape: tuple[int, int]) -> dict[str, tuple[slice, slice]]:
+    h, w = map(int, interior_shape)
+    assert h >= 5 and w >= 5 and h % 2 == 1 and w % 2 == 1, "interior must have a center row and column"
