+    expected = np.zeros((h, w), dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    if not np.all(local[expected]):
+        return None
+
+    extras = local & ~expected
+    mid_r = h // 2
+    mid_c = w // 2
+    mark_positions = {
+        "top": (1, mid_c),
+        "bottom": (h - 2, mid_c),
+        "left": (mid_r, 1),
+        "right": (mid_r, w - 2),
+    }
+
+    marks: set[str] = set()
+    for name, (rr, cc) in mark_positions.items():
+        if extras[rr, cc]:
+            marks.add(name)
+            extras[rr, cc] = False
+    if np.any(extras):
+        return None
+
+    branch = _branch_from_marks(marks)
+    if branch is None:
+        return None
+
+    return {"bbox": (r0, c0, r1, c1), "branch": branch, "marks": marks}
