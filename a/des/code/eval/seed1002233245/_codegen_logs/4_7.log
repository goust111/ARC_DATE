+COL_MIRROR = {"TL": "TR", "TR": "TL", "BL": "BR", "BR": "BL"}
+TRANSLATION_TARGETS = {
+    "up": {"BL": "TL", "BR": "TR"},
+    "down": {"TL": "BL", "TR": "BR"},
+    "left": {"TR": "TL", "BR": "BL"},
+    "right": {"TL": "TR", "BL": "BR"},
+}
+
+MAX_GENERATION_ATTEMPTS = 400
+GRID_RANGE_BY_COUNT = {2: (18, 26), 3: (22, 28), 4: (26, 30)}
