+            return False
+        r0, c0 = random.choice(positions)
+        specs[idx]["r0"] = int(r0)
+        specs[idx]["c0"] = int(c0)
+        occupied[r0 : r0 + obj_h, c0 : c0 + obj_w] = True
+    return True
