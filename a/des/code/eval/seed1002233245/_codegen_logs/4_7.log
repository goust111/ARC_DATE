+    if branch == "tb":
+        target = ROW_MIRROR[source_quad]
+        return {target: _transform_patch(source_patch, source_quad, target)}
+    if branch == "lr":
+        target = COL_MIRROR[source_quad]
+        return {target: _transform_patch(source_patch, source_quad, target)}
+    if branch == "both":
