+        cavity = spec["cavity"]
+        pad_t, pad_l = spec["inner_offset"]
+        rr0 = fr + 1 + pad_t
+        cc0 = fc + 1 + pad_l
+        out[rr0 : rr0 + cavity.shape[0], cc0 : cc0 + cavity.shape[1]][cavity] = spec["color"]
+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    count = random.randint(2, 4)
+    colors = random.sample(PIECE_COLORS, count)
