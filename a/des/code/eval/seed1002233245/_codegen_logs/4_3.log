+    piece_positions: list[tuple[int, int]],
+    frame_specs: list[dict[str, Any]],
+    piece_patches: list[np.ndarray],
+) -> np.ndarray:
+    out = inp.copy()
+    out[sep + 1 :, :][inp[sep + 1 :, :] != BLACK] = BLACK
+    for idx, (fr, fc) in enumerate(frame_positions):
