+def _source_pattern(
+    grid: np.ndarray,
+    rooms: dict[RoomId, RoomBox],
+    pattern_color: int,
+    portal_cells: set[tuple[int, int]],
+) -> tuple[RoomId, np.ndarray]:
+    source_room = None
+    source_cells: list[tuple[int, int]] = []
+
+    for room_id, (r0, c0, h, w) in rooms.items():
+        cells = [
