+                mask=mask,
+                src_room=room_id,
+                dst_room=dst_room,
+                dst_box=rooms[dst_room],
+                axis=str(edge["axis"]),
+                offset=int(edge["offset"]),
+            )
+            _draw_mask(out, rooms[dst_room], transformed, top, left, pattern_color)
+            seen.add(dst_room)
+            masks[dst_room] = transformed
+            queue.append(dst_room)
