+            for j in range(pieces - 1):
+                lo = max(prev[j] - 1, 1 if j == 0 else cur[-1] + 1)
+                hi = min(prev[j] + 1, span - (pieces - 1 - j))
+                if hi < lo:
+                    ok = False
+                    break
+                cur.append(rng.randint(lo, hi))
+            if not ok:
