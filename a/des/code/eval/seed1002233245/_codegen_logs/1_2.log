+
+TOP_ARROW = frozenset({(0, 0), (0, 1), (1, 0)})
+BOTTOM_ARROW = frozenset({(0, 1), (1, 0), (1, 1)})
+LEFT_ARROW = frozenset({(0, 0), (1, 0), (1, 1)})
+RIGHT_ARROW = frozenset({(0, 0), (0, 1), (1, 1)})
