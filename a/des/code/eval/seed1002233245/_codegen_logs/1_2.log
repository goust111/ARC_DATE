+
+
+def _gen_one_object(
+    color: int,
+    direction: str,
+    grid_shape: tuple[int, int],
+    occupied_input: set[tuple[int, int]],
+    forbidden_input: set[tuple[int, int]],
+    occupied_output: set[tuple[int, int]],
+    forbidden_output: set[tuple[int, int]],
+    rng: random.Random,
