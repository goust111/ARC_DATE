+def _components4(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        stack = [(r, c)]
+        seen[r, c] = True
+        comp: list[tuple[int, int]] = []
+        while stack:
+            rr, cc = stack.pop()
+            comp.append((rr, cc))
+            for dr, dc in DIRS4:
