+
+
+def _relative_cells(mask: np.ndarray) -> list[tuple[int, int]]:
+    return [(int(r), int(c)) for r, c in np.argwhere(mask)]
+
+
+def _make_arrow(
+    direction: str,
+    rect_top: int,
+    rect_left: int,
+    rect_height: int,
+    rect_width: int,
+    grid_shape: tuple[int, int],
+    rng: random.Random,
+) -> tuple[set[tuple[int, int]], tuple[int, int]]:
+    h, w = grid_shape
+    if direction == "down":
