+    for r, c in pts:
+        here = [(nr, nc) for nr, nc in _neighbors4(r, c) if (nr, nc) in pts]
+        if len(here) != 2:
+            raise AssertionError("track component must be a simple 4-neighbor cycle")
+        neigh[(r, c)] = sorted(here)
