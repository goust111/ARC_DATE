+
+        car_count = rng.randint(1, 3)
+        loop_len = len(order)
+        if loop_len <= car_count:
+            continue
+
+        station_present = rng.random() < 0.5
+        station_should_hit = rng.random() < 0.5
+        delta = car_count if marker_color == CW_MARKER else -car_count
+
+        car_indices = None
