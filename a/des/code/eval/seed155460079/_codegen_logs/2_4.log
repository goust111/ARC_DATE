+BG = 0
+CCW_MARKER = 1  # blue
+CW_MARKER = 2   # red
+STATION = 3     # green
+TRACK_COLORS = [4, 5, 6, 7, 8, 9]
+
+GRID_TRACK_COUNT = [1, 2, 3]
