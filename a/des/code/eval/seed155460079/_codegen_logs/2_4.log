+        shift = len(cars) if marker_color == CW_MARKER else -len(cars)
+        loop_len = len(order)
+        for r, c in cars:
+            dst = order[(index_of[(r, c)] + shift) % loop_len]
+            color = STATION if station is not None and dst == station else int(g[r, c])
+            out[dst] = color
