+            "cells": set(order),
+            "height": bbox_h,
+            "width": bbox_w,
+            "track_color": track_color,
+            "marker": marker,
+            "marker_color": marker_color,
+            "car_indices": car_indices,
+            "car_colors": car_colors,
+            "station_index": station_index,
