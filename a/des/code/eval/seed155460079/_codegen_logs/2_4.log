+        target_bulges = rng.randint(0, 3)
+        applied = 0
+        local_attempts = 0
+        while applied < target_bulges and local_attempts < 40:
+            local_attempts += 1
+            cand = _bulge(order, rng.randrange(len(order)), inward=bool(rng.getrandbits(1)))
+            if cand is None:
+                continue
+            order = cand
+            applied += 1
