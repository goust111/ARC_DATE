+
+def _place_template(grid, rng, occupied):
+    h, w = grid.shape
+    wrapper_h, wrapper_w = _template_wrapper_size()
+    corners = [
+        (0, 0),
+        (0, w - wrapper_w),
+        (h - wrapper_h, 0),
+        (h - wrapper_h, w - wrapper_w),
+    ]
