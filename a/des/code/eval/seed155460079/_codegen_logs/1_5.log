+PATTERN_COLORS = [3, 4, 6, 7, 8, 9]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+ROTATION_MARKS = (
+    {"top", "left"},
+    {"top", "right"},
+    {"bottom", "left"},
+    {"bottom", "right"},
+)
