+            patch[mid_r, 0] = BLUE
+        elif corner == "tr":
+            patch[0, mid_c] = BLUE
+            patch[mid_r, -1] = BLUE
+        elif corner == "bl":
+            patch[-1, mid_c] = BLUE
+            patch[mid_r, 0] = BLUE
+        else:
+            patch[-1, mid_c] = BLUE
+            patch[mid_r, -1] = BLUE
