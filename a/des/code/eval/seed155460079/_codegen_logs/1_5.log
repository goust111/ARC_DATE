+        out[r0 + 1 : r1, c0 + 1 : c1] = _complete_inner(inner, mode)
+        out[r0, c0 : c1 + 1] = GREY
+        out[r1, c0 : c1 + 1] = GREY
+        out[r0 : r1 + 1, c0] = GREY
+        out[r0 : r1 + 1, c1] = GREY
+
+    return out
+
+
