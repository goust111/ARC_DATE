+        values = [int(v) for v in grid[r, c0 : c1 + 1]]
+        if any(v == BG for v in values):
+            continue
+        if any(v in (GREY, AZURE) for v in values):
+            continue
+        if len(set(values)) != len(values):
+            continue
+        if c0 > 0 and np.any(grid[r, :c0] != BG):
+            continue
