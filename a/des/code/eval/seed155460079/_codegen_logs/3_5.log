+def _find_priority_bar(grid: np.ndarray) -> tuple[int, list[int], dict[int, int]]:
+    h, w = grid.shape
+    for r in range(h - 1, -1, -1):
+        cols = [c for c in range(w) if int(grid[r, c]) != BG]
+        if len(cols) < 2:
