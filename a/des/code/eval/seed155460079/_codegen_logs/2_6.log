+
+BLACK = 0
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+GROUP_COLORS = (1, 2, 3, 6, 8, 9)
+
+LEGEND_BAND_HEIGHT = 3
+LEGEND_COLOR_BLOCK_WIDTH = 2
+GRID_WIDTH_RANGE = (22, 34)
+SCENE_HEIGHT_RANGE = (14, 24)
+GROUP_COUNT_RANGE = (2, 4)
+GENERATION_RETRIES = 400
+PLACEMENT_ATTEMPTS = 200
+GROUP_MARGIN = 2
