+def _fill_gap(grid: np.ndarray, outer: tuple[int, int, int, int], inner: tuple[int, int, int, int]) -> None:
+    r0, c0, r1, c1 = outer
+    ir0, ic0, ir1, ic1 = inner
+    gap = np.zeros_like(grid, dtype=bool)
+    gap[r0 + 1 : r1, c0 + 1 : c1] = True
+    gap[ir0 : ir1 + 1, ic0 : ic1 + 1] = False
+    grid[gap] = ORANGE
