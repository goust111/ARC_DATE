+def _build_input(
+    shape: tuple[int, int],
+    legend_top: int,
+    groups: list[dict[str, object]],
+    legend_order: list[int],
+    starts: list[int],
+) -> np.ndarray:
+    h, w = shape
+    grid = np.full((h, w), BLACK, dtype=int)
+    for group in groups:
+        color = int(group["color"])
+        for bbox in group["bboxes"]:
