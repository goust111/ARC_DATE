+def _shift_bboxes(
+    bboxes: list[tuple[int, int, int, int]], top: int, left: int
+) -> list[tuple[int, int, int, int]]:
+    return [(r0 + top, c0 + left, r1 + top, c1 + left) for r0, c0, r1, c1 in bboxes]
