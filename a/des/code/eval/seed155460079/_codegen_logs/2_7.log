+        path_set = _coords_to_set([(r, c) for r, c, _ in path_cells])
+        if len(path_set) != len(path_cells):
+            continue
+
+        footprint = list(path_set) + gap_cells
+        if any(blocked[r, c] for r, c in footprint):
+            continue
+        if any(int(grid[r, c]) != BACKGROUND for r, c in path_set):
+            continue
+        if any(int(grid[r, c]) != BACKGROUND for r, c in gap_cells):
+            continue
+
+        if orientation == "h":
+            for r, c in side_coords:
+                if (r > 0 and blocked[r - 1, c]) or (r + 1 < h and blocked[r + 1, c]):
+                    break
+            else:
+                return path_cells, gap_cells, int(mapping_lookup := 0)  # pragma: no cover
+        else:
+            for r, c in side_coords:
+                if (c > 0 and blocked[r, c - 1]) or (c + 1 < w and blocked[r, c + 1]):
+                    break
+            else:
+                return path_cells, gap_cells, int(mapping_lookup := 0)  # pragma: no cover
+
+    return None
+
+
+def _place_path_with_color(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    orientation: str,
+    same_color: bool,
+    base_colors: list[int],
+    mapping: dict[tuple[int, int], int],
+) -> tuple[list[tuple[int, int, int]], list[tuple[int, int]], int] | None:
+    h, w = grid.shape
+    for _ in range(PLACEMENT_RETRIES):
+        placed = _place_path(grid, blocked, orientation, same_color, base_colors)
+        if placed is None:
+            continue
+        path_cells, gap_cells, _dummy = placed
+        if orientation == "h":
+            row = gap_cells[0][0]
+            left_c = gap_cells[0][1] - 1
+            right_c = gap_cells[-1][1] + 1
+            left_color = next(color for rr, cc, color in path_cells if rr == row and cc == left_c)
+            right_color = next(color for rr, cc, color in path_cells if rr == row and cc == right_c)
+            bridge_color = int(mapping[(int(left_color), int(right_color))])
+            clear = all(
+                (row == 0 or int(grid[row - 1, c]) == BACKGROUND)
+                and (row + 1 >= h or int(grid[row + 1, c]) == BACKGROUND)
+                for _, c in gap_cells
+            )
+        else:
+            col = gap_cells[0][1]
+            top_r = gap_cells[0][0] - 1
+            bottom_r = gap_cells[-1][0] + 1
+            top_color = next(color for rr, cc, color in path_cells if rr == top_r and cc == col)
+            bottom_color = next(color for rr, cc, color in path_cells if rr == bottom_r and cc == col)
+            bridge_color = int(mapping[(int(top_color), int(bottom_color))])
+            clear = all(
+                (col == 0 or int(grid[r, col - 1]) == BACKGROUND)
+                and (col + 1 >= w or int(grid[r, col + 1]) == BACKGROUND)
+                for r, _ in gap_cells
+            )
+        if clear:
+            return path_cells, gap_cells, bridge_color
+    return None
+
+
+def _draw_path(grid: np.ndarray, blocked: np.ndarray, path_cells: list[tuple[int, int, int]], gap_cells: list[tuple[int, int]]) -> None:
+    for r, c, color in path_cells:
+        grid[r, c] = int(color)
+    _mark_buffer(blocked, [(r, c) for r, c, _ in path_cells] + gap_cells)
+
+
+def _build_case() -> np.ndarray | None:
+    h = random.randint(*GRID_HEIGHT_RANGE)
+    w = random.randint(*GRID_WIDTH_RANGE)
+    color_count = random.choice(LEGEND_COLOR_COUNT_OPTIONS)
+    base_colors, mapping, legend = _build_legend(color_count)
+
+    grid = np.full((h, w), BACKGROUND, dtype=int)
+    legend_h, legend_w = legend.shape
+    if legend_h + 3 >= h or legend_w + 3 >= w:
+        return None
+    grid[:legend_h, :legend_w] = legend
+
+    blocked = np.zeros((h, w), dtype=bool)
+    blocked[0, :] = True
+    blocked[h - 1, :] = True
+    blocked[:, 0] = True
+    blocked[:, w - 1] = True
+    _mark_buffer(
+        blocked,
+        [(r, c) for r in range(legend_h) for c in range(legend_w)],
+    )
+
+    expected = grid.copy()
+    path_specs = list(BRANCHES)
+    extra_count = random.randint(*EXTRA_PATH_COUNT_RANGE)
+    for _ in range(extra_count):
+        path_specs.append((random.choice(("h", "v")), random.choice((False, True))))
+    random.shuffle(path_specs)
+
+    for orientation, same_color in path_specs:
+        placed = _place_path_with_color(grid, blocked, orientation, same_color, base_colors, mapping)
+        if placed is None:
+            return None
+        path_cells, gap_cells, bridge_color = placed
+        _draw_path(grid, blocked, path_cells, gap_cells)
+        for r, c in gap_cells:
+            expected[r, c] = int(bridge_color)
+
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        case = _build_case()
+        if case is not None:
+            return case
+    raise RuntimeError("failed to generate a valid puzzle instance")

