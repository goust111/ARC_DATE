+    n = min(n_rows, n_cols)
+    assert n >= 2, "expected a legend with at least two row/column colors"
+    assert bool(np.all(grid[1 : n + 1, 0] != bg))
+    assert bool(np.all(grid[0, 1 : n + 1] != bg))
+    assert bool(np.all(grid[1 : n + 1, 1 : n + 1] != bg))
+    return int(n)
