+                path_cells.append((r + dir_a * step, c0, int(stub_color_a)))
+            for step in range(1, stub_b + 1):
+                path_cells.append((r + dir_b * step, c1, int(stub_color_b)))
+
+            gap_cells = [(r, c) for c in range(gap_start, gap_end)]
+            side_coords = gap_cells
+        else:
