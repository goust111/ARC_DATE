+                    break
+            else:
+                return path_cells, gap_cells, int(mapping[(left_color, right_color)])
+        else:
+            for r, c in side_coords:
+                if (c > 0 and blocked[r, c - 1]) or (c + 1 < w and blocked[r, c + 1]):
+                    break
+            else:
+                return path_cells, gap_cells, int(mapping[(left_color, right_color)])
+
+    return None
+
