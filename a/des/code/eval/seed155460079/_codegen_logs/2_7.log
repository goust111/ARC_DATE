+    mapping, legend_mask = _read_legend(g, bg)
+
+    out = g.copy()
+    _fill_horizontal_gaps(g, out, bg, mapping, legend_mask)
+    _fill_vertical_gaps(g, out, bg, mapping, legend_mask)
