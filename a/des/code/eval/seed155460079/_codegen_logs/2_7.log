    legend = np.full((color_count + 1, color_count + 1), BACKGROUND, dtype=int)
    legend[0, 1:] = np.array(col_order, dtype=int)
    legend[1:, 0] = np.array(row_order, dtype=int)
    for i, row_color in enumerate(row_order, start=1):
