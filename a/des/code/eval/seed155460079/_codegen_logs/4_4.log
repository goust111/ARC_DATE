+        h = rng.randint(5, 9)
+    else:
+        h = rng.randint(gap_len + 2, gap_len + 5)
+        w = rng.randint(5, 9)
+    patch = np.full((h, w), bg, dtype=int)
+    patch[0, :] = color
+    patch[-1, :] = color
+    patch[:, 0] = color
+    patch[:, -1] = color
