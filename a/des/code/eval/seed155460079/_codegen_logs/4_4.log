+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            rs = [p[0] for p in coords]
+            cs = [p[1] for p in coords]
+            r0, r1 = min(rs), max(rs)
+            c0, c1 = min(cs), max(cs)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "h": r1 - r0 + 1,
+                    "w": c1 - c0 + 1,
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _lock_info(grid: np.ndarray, bg: int, comp: dict):
+    r0, c0, r1, c1 = comp["bbox"]
