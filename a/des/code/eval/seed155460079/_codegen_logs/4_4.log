+    grid_w = rng.randint(22 + 2 * (n - 2), 30)
+    grid = np.full((grid_h, grid_w), bg, dtype=int)
+    used = np.zeros((grid_h, grid_w), dtype=bool)
+    length_to_handle = {gap_len: handle_color for gap_len, handle_color in zip(lengths, handle_colors)}
+    lock_boxes = []
