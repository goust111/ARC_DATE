+            cs = [p[1] for p in coords]
+            r0, r1 = min(rs), max(rs)
+            c0, c1 = min(cs), max(cs)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "h": r1 - r0 + 1,
