+
+    height = top_margin + mosaic_h + bottom_margin
+    width = left_margin + mosaic_w + right_margin
+    row0 = top_margin
+    col0 = left_margin
+    row1 = row0 + mosaic_h - 1
+    col1 = col0 + mosaic_w - 1
+
+    palette_size = random.randint(4, 6)
