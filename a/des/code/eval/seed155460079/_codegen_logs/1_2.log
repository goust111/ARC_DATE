+    for pr0, pc0, pr1, pc1 in placed:
+        if not (
+            r1 + PLACEMENT_PADDING < pr0
+            or pr1 + PLACEMENT_PADDING < r0
+            or c1 + PLACEMENT_PADDING < pc0
+            or pc1 + PLACEMENT_PADDING < c0
+        ):
