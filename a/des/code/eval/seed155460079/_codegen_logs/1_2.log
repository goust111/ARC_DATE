+OVERFLOW_SIZE_RANGE = (4, 9)
+PLACEMENT_PADDING = 2
+GENERATION_ATTEMPTS = 400
+PATCH_ATTEMPTS = 200
+PLACEMENT_ATTEMPTS = 200
