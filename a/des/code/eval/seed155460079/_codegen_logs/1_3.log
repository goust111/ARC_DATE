+        assert len(candidates) == 1, f"expected a unique placement for color {color}"
+        r0, c0 = candidates[0]
+        positions[int(color)] = (r0, c0)
+        rr = shape[:, 0] + r0
+        cc = shape[:, 1] + c0
+        occupied[rr, cc] = True
+
+    return positions
+
