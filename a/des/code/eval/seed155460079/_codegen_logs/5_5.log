+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+GRAY = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+
+NOTCH_LIBRARY = [
+    np.array([[1, 1], [1, 0]], dtype=bool),
+    np.array([[1, 1, 1], [1, 0, 0]], dtype=bool),
+    np.array([[1, 1, 1], [0, 1, 0]], dtype=bool),
+    np.array([[1, 1, 1], [1, 1, 0]], dtype=bool),
+]
+
+GRID_RANGE = (18, 30)
+RECT_SIDE_RANGE = (5, 8)
