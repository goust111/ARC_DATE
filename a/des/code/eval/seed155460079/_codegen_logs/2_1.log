+    out = g.copy()
+    lr0, lc0, lr1, lc1 = legend["bbox"]
+    out[lr0 : lr1 + 1, lc0 : lc1 + 1] = bg
+
+    for frame in frames:
+        entry = entry_map[frame["color"]]
+        _move_sprite_and_fill(out, g, bg, frame, entry["template"], entry["fill_color"], legend_mask)
+
+    return out
