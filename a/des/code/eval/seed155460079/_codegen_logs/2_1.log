+
+def _random_template(tile_size: int, rng: random.Random) -> np.ndarray:
+    for _ in range(200):
+        mask = np.zeros((tile_size, tile_size), dtype=bool)
+        corners = [(0, 0), (0, tile_size - 1), (tile_size - 1, 0), (tile_size - 1, tile_size - 1)]
