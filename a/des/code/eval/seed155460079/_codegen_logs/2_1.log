+GEN_BG = 0
+GEN_GRID_H = (22, 31)
+GEN_GRID_W = (24, 33)
+GEN_FRAME_COUNT = (2, 3)
+GEN_TILE_SIZES = (3, 4)
+GEN_INNER_H = (5, 10)
+GEN_INNER_W = (5, 11)
+GEN_SPRITE_LEN = (2, 4)
+GEN_ATTEMPTS = 400
