+
+def _component_from(mask: np.ndarray, start: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    sr, sc = start
+    assert 0 <= sr < h and 0 <= sc < w and bool(mask[sr, sc])
+    q = deque([start])
+    seen = {start}
+    pts: list[tuple[int, int]] = []
+    while q:
