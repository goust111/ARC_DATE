+        built = False
+        for overlap in overlap_options:
+            t1_len = random.choice(TAIL_LENGTHS)
+            t2_len = random.choice(TAIL_LENGTHS)
+            used_now = set(overlap)
+            upper_path = set(level_to_path[level + 1])
