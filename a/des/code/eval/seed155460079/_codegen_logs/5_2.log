import random, numpy as np
from collections import deque

BG=0
COLORS=tuple(range(1,10))
NEI=((1,0),(-1,0),(0,1),(0,-1))


def nbrs(p):
    r,c=p
    return [(r+dr,c+dc) for dr,dc in NEI]

def components(mask):
    h,w=mask.shape
    seen=np.zeros((h,w),dtype=bool)
    out=[]
    for r,c in np.argwhere(mask):
        r=int(r); c=int(c)
        if seen[r,c]:
            continue
        q=[(r,c)]
        seen[r,c]=True
        pts=[]
        while q:
            cr,cc=q.pop()
            pts.append((cr,cc))
            for dr,dc in NEI:
                nr,nc=cr+dr,cc+dc
                if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                    seen[nr,nc]=True
                    q.append((nr,nc))
        out.append(pts)
    return out

def shortest(mask,start,goal):
    h,w=mask.shape
    dq=deque([start])
    prev={start:None}
    while dq:
        cur=dq.popleft()
        if cur==goal:
            break
        for dr,dc in NEI:
            nr,nc=cur[0]+dr,cur[1]+dc
            nxt=(nr,nc)
            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and nxt not in prev:
                prev[nxt]=cur
                dq.append(nxt)
    if goal not in prev:
        raise ValueError('no path')
    path=[]
    cur=goal
    while cur is not None:
        path.append(cur)
        cur=prev[cur]
    return path[::-1]

def read_band(g):
    cols=np.where(g[-1]"'!=BG)[0]
    if len(cols)==0: raise ValueError
    if not np.all(np.diff(cols)==1): raise ValueError
    order=[int(g[-1,c]) for c in cols]
    return order, cols

def solve(g):
    g=np.array(g,int)
    h,w=g.shape
    order,cols=read_band(g)
    scene=g[:-1]
    full={}
    top=order[-1]
    full[top]=scene==top
    for i in range(len(order)-2,-1,-1):
        color=order[i]
        upper=order[i+1]
        seed=scene==color
        comps=components(seed)
        if len(comps)!=2:
            raise ValueError(('"'comp',color,len(comps)))
        attaches=[]
        upper_mask=full[upper]
        for comp in comps:
            adj=set()
            for r,c in comp:
                for dr,dc in NEI:
                    nr,nc=r+dr,c+dc
                    if 0<=nr<scene.shape[0] and 0<=nc<scene.shape[1] and upper_mask[nr,nc]:
                        adj.add((nr,nc))
            if len(adj)"'!=1:
                raise ValueError(('"'adj',color,adj))
            attaches.append(next(iter(adj)))
        path=shortest(upper_mask, attaches[0], attaches[1])
        mask=seed.copy()
        for r,c in path:
            mask[r,c]=True
        full[color]=mask
    out=np.zeros_like(g)
    canvas=out[:-1]
    for color in reversed(order):
        canvas[full[color]]=color
    out[-1, cols]=list(reversed(order))
    return out

def grow_path(length, blocked=None, tries=1000):
    blocked=set() if blocked is None else set(blocked)
