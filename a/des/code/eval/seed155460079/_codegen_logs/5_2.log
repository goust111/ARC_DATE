+BG = 0
+COLORS = tuple(range(1, 10))
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+MIN_OBJECTS = 3
+MAX_OBJECTS = 5
+TOP_LENGTHS = (6, 7, 8)
+TAIL_LENGTHS = (2, 3)
+SCENE_PADDING_MIN = 2
+SCENE_PADDING_MAX = 6
+GAP_ROWS = (1, 2, 3)
+GEN_ATTEMPTS = 400
+PATH_ATTEMPTS = 1200
+TAIL_ATTEMPTS = 1200
