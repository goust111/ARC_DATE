                if n in used or n in blocked:
                    continue
                adj_used={m for m in nbrs(n) if m in used}
                if adj_used"'!={tip}:
                    continue
                if any(m in blocked for m in nbrs(n)):
                    continue
                cand.append(n)
            if not cand:
                break
            x=random.choice(cand)
            path.append(x)
            used.add(x)
        if len(path)==length:
            return path
    return None

def grow_tail(base, length, blocked_above, used_new, tries=1000):
    blocked_above=set(blocked_above)
    used0=set(used_new)
    for _ in range(tries):
        tail=[]
        used=set(used0)
        tip=base
        ok=True
