import random
from typing import Iterable

import numpy as np


SIDES = ("top", "bottom", "left", "right")
DIR_FROM_SIDE = {
    "top": (-1, 0),
    "bottom": (1, 0),
    "left": (0, -1),
    "right": (0, 1),
}

BACKGROUND = 0
GRID_MIN = 22
GRID_MAX = 30
OBJECT_COUNT_CHOICES = (2, 3, 4)
OUTER_SIZE_CHOICES = (5, 7, 9)
PLACEMENT_RETRIES = 200
GENERATION_RETRIES = 300
COLORS = tuple(range(1, 10))


def _background(grid: np.ndarray) -> int:
    values, counts = np.unique(grid, return_counts=True)
    return int(values[np.argmax(counts)])


def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
    mask = grid == color
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    comps: list[np.ndarray] = []
    starts = np.argwhere(mask)
    for r, c in starts:
        r = int(r)
        c = int(c)
        if seen[r, c]:
            continue
        stack = [(r, c)]
        seen[r, c] = True
        pts: list[tuple[int, int]] = []
        while stack:
            cr, cc = stack.pop()
            pts.append((cr, cc))
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nr = cr + dr
                nc = cc + dc
                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                    seen[nr, nc] = True
                    stack.append((nr, nc))
        comps.append(np.asarray(pts, dtype=int))
    return comps


def _edge_marker_map(grid: np.ndarray, bg: int) -> dict[int, str]:
    h, w = grid.shape
    markers: dict[int, str] = {}
    for r in range(h):
        for c in range(w):
            if r not in (0, h - 1) and c not in (0, w - 1):
                continue
            color = int(grid[r, c])
            if color == bg:
                continue
            if r == 0 and c not in (0, w - 1):
                side = "top"
            elif r == h - 1 and c not in (0, w - 1):
                side = "bottom"
            elif c == 0 and r not in (0, h - 1):
                side = "left"
            elif c == w - 1 and r not in (0, h - 1):
                side = "right"
            else:
                continue
            markers[color] = side
    return markers


def _frame_info(
    grid: np.ndarray, coords: np.ndarray, color: int, bg: int
) -> dict[str, object] | None:
    h, w = grid.shape
    rows = coords[:, 0]
    cols = coords[:, 1]
    r0 = int(rows.min())
    r1 = int(rows.max())
    c0 = int(cols.min())
    c1 = int(cols.max())
    if r0 <= 0 or c0 <= 0 or r1 >= h - 1 or c1 >= w - 1:
        return None

    height = r1 - r0 + 1
    width = c1 - c0 + 1
    if height < 3 or width < 3 or height % 2 == 0 or width % 2 == 0:
        return None

    cells = {tuple(map(int, pt)) for pt in coords}
    perimeter: list[tuple[int, int]] = []
    for rr in range(r0, r1 + 1):
        perimeter.append((rr, c0))
        perimeter.append((rr, c1))
    for cc in range(c0 + 1, c1):
        perimeter.append((r0, cc))
        perimeter.append((r1, cc))
    perimeter_set = set(perimeter)
    if not cells <= perimeter_set:
        return None
    missing = sorted(perimeter_set - cells)
    if len(missing) != 1:
        return None
    gap_r, gap_c = missing[0]
    if gap_r in (r0, r1) and gap_c in (c0, c1):
        return None

    if gap_r == r0:
        gap_side = "top"
    elif gap_r == r1:
        gap_side = "bottom"
    elif gap_c == c0:
        gap_side = "left"
    else:
        gap_side = "right"

    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
    inner = patch[1:-1, 1:-1]
    seed_points = np.argwhere(inner != bg)
    if seed_points.shape[0] != 1:
        return None

    center_r = height // 2
    center_c = width // 2
    sr, sc = map(int, seed_points[0])
    if (sr, sc) != (center_r - 1, center_c - 1):
        return None

    seed_r = r0 + center_r
    seed_c = c0 + center_c
    seed_color = int(grid[seed_r, seed_c])
    if seed_color in (bg, color):
        return None

    return {
        "bbox": (r0, c0, r1, c1),
        "border_color": color,
        "seed_color": seed_color,
        "gap_side": gap_side,
    }


def main(grid: np.ndarray) -> np.ndarray:
    """
    Mirror each gapped rectangular frame according to the matching edge marker,
    then grow the mirrored copy outward through the gap direction.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    bg = _background(g)
    h, w = g.shape

    marker_side_by_color = _edge_marker_map(g, bg)
    frames: list[dict[str, object]] = []
