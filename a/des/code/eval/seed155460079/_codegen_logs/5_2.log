+    level_to_path: dict[int, list[tuple[int, int]]] = {}
+    visible_segments: dict[int, list[list[tuple[int, int]]]] = {}
+
+    top_path = _grow_path(random.choice(TOP_LENGTHS))
+    if top_path is None:
