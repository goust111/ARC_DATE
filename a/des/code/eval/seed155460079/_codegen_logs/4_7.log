+
+def _too_close(candidate: set[tuple[int, int]], occupied: set[tuple[int, int]]) -> bool:
+    for r, c in candidate:
+        for rr in range(r - 1, r + 2):
+            for cc in range(c - 1, c + 2):
+                if (rr, cc) in occupied:
+                    return True
