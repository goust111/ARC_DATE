+            for start_pos in candidates:
+                cells, markers = _translated_positions(segments[i], start_pos)
+                pts = cells | markers
+                if _too_close(pts, occupied):
+                    continue
+                starts.append(start_pos)
+                occupied |= pts
+                placed = True
+                break
+            if not placed:
+                ok = False
+                break
+
+        if ok:
