+
+def _rel_positions(seg: dict) -> set[tuple[int, int]]:
+    rel = set(seg["coords_local"])
+    rel.add(seg["start_vec"])
+    rel.add(_add(seg["end_local"], seg["end_vec"]))
+    return rel
