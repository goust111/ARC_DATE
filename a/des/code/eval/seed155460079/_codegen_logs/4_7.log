+def _render_input(
+    h: int,
+    side: int,
+    bg: int,
+    segments: list[dict],
+    starts: list[tuple[int, int]],
+) -> np.ndarray:
+    grid = np.full((h, 2 * side + 1), bg, dtype=int)
+    grid[:, side] = GREY
+    for seg, start_pos in zip(segments, starts, strict=True):
+        cells, markers = _translated_positions(seg, start_pos)
+        for r, c in cells:
+            grid[r, c] = seg["color"]
