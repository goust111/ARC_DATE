+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+AZURE = 8
+MAROON = 9
+
+SEPARATOR_COLORS = (BLUE, RED, GREEN, YELLOW, PINK, ORANGE, AZURE)
+MAX_GENERATION_ATTEMPTS = 400
