import random
from typing import Iterable

import numpy as np


SIDES = ("top", "bottom", "left", "right")
DIR_FROM_SIDE = {
    "top": (-1, 0),
    "bottom": (1, 0),
    "left": (0, -1),
    "right": (0, 1),
}

BACKGROUND = 0
GRID_MIN = 22
GRID_MAX = 30
