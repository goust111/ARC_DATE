+    min_c = margin
+    max_r = h - height - margin
+    max_c = w - width - margin
+    if max_r < min_r or max_c < min_c:
+        return None
+    for _ in range(PLACEMENT_ATTEMPTS):
+        top = random.randint(min_r, max_r)
+        left = random.randint(min_c, max_c)
