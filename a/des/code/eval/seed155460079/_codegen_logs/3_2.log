+def _most_common_color(grid: np.ndarray) -> int:
+    values = np.asarray(grid, dtype=int).ravel()
+    counts = np.bincount(values, minlength=10)
+    return int(np.argmax(counts))
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            rows = [rr for rr, _ in coords]
+            cols = [cc for _, cc in coords]
+            comps.append(
+                {
+                    "color": color,
+                    "coords": tuple(coords),
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _component_mask(comp: dict) -> np.ndarray:
+    r0, c0, r1, c1 = comp["bbox"]
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in comp["coords"]:
+        mask[int(r) - r0, int(c) - c0] = True
+    return mask
+
+
+def _is_frame(grid: np.ndarray, comp: dict, bg: int) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 4 or w < 4:
+        return False
+    if int(comp["area"]) != 2 * h + 2 * w - 4:
+        return False
+
+    color = int(comp["color"])
+    sub = np.asarray(grid[r0 : r1 + 1, c0 : c1 + 1], dtype=int)
+    if not np.all(sub[0, :] == color):
+        return False
+    if not np.all(sub[-1, :] == color):
+        return False
+    if not np.all(sub[:, 0] == color):
+        return False
+    if not np.all(sub[:, -1] == color):
+        return False
+    return bool(np.all(sub[1:-1, 1:-1] == bg))
+
+
+def _extract_objects(grid: np.ndarray) -> tuple[int, list[dict], list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    bg = _most_common_color(g)
+    comps = _find_components(g, bg)
+
+    slots: list[dict] = []
+    fragments: list[dict] = []
+    for comp in comps:
+        r0, c0, r1, c1 = comp["bbox"]
+        if _is_frame(g, comp, bg):
+            slots.append(
+                {
+                    "color": int(comp["color"]),
+                    "bbox": (r0, c0, r1, c1),
+                    "inner_h": r1 - r0 - 1,
+                    "inner_w": c1 - c0 - 1,
+                }
+            )
+            continue
+
+        fragments.append(
+            {
+                "color": int(comp["color"]),
+                "coords": tuple((int(r), int(c)) for r, c in comp["coords"]),
+                "bbox": (r0, c0, r1, c1),
+                "mask": _component_mask(comp),
+                "area": int(comp["area"]),
+            }
+        )
