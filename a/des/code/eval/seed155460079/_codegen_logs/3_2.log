+
+@lru_cache(maxsize=None)
+def _profile_options(inner_h: int, inner_w: int) -> tuple[tuple[int, ...], ...]:
+    options: list[tuple[int, ...]] = []
+    for split in itertools.product(range(1, inner_w), repeat=inner_h):
