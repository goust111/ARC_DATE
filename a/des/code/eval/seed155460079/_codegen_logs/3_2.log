+def _render_solution(grid: np.ndarray, bg: int, slots: list[dict], fragments: list[dict], assignment: list[tuple[int, int, np.ndarray, np.ndarray]]) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
