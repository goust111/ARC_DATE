+    slots.sort(key=lambda slot: (slot["bbox"][0], slot["bbox"][1], slot["inner_w"]))
+    fragments.sort(
+        key=lambda frag: (
+            frag["bbox"][1] + frag["bbox"][3],
+            frag["bbox"][1],
+            frag["bbox"][0],
+            frag["color"],
+        )
+    )
