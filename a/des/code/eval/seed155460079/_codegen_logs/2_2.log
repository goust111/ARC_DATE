+    return towers, body_mask
+
+
+def _cast_ray(start_r: int, start_c: int, dr: int, dc: int, body_mask: np.ndarray):
+    h, w = body_mask.shape
+    cells = []
+    row = int(start_r)
+    col = int(start_c)
+    while True:
+        row += int(dr)
+        col += int(dc)
+        if not (0 <= row < h and 0 <= col < w):
