+        if corner in ("tl", "bl"):
+            if grid[r, 0] in (BG, MAGENTA):
+                continue
+            cols = []
+            c = 0
+            while c < w and grid[r, c] not in (BG, MAGENTA):
+                cols.append(c)
+                c += 1
+            if c < w and grid[r, c] != BG:
+                continue
+        else:
+            if grid[r, w - 1] in (BG, MAGENTA):
+                continue
+            cols = []
+            c = w - 1
+            while c >= 0 and grid[r, c] not in (BG, MAGENTA):
+                cols.append(c)
+                c -= 1
