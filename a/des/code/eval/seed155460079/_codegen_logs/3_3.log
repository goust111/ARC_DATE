+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+MAGENTA = 6
+ORANGE = 7
+MAROON = 9
+
+RAIL_COLORS = (BLUE, RED, GREEN, YELLOW, ORANGE)
+GRID_H_RANGE = (16, 24)
+GRID_W_RANGE = (16, 24)
+PATH_LEN_RANGE = (6, 9)
+FINAL_PATH_LEN_RANGE = (5, 8)
