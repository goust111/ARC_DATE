+            return None
+
+    grid = _render_grid(h, w, legend_corner, legend_colors, source, occupied, visibility)
+
+    for color in legend_colors:
+        pts = np.argwhere(grid == color)
+        if len(pts) < 2:
+            return None
+        rows = np.unique(pts[:, 0])
+        cols = np.unique(pts[:, 1])
