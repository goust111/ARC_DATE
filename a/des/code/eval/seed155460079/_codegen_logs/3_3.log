+def _find_legend(grid: np.ndarray) -> tuple[list[tuple[int, int]], list[int]]:
+    h, w = grid.shape
+    candidates: list[list[tuple[int, int]]] = []
+    for corner in ("tl", "tr", "bl", "br"):
+        if corner in ("tl", "tr"):
+            r = 0
+            inward_r = 1
+        else:
+            r = h - 1
+            inward_r = h - 2
+
+        if corner in ("tl", "bl"):
+            if grid[r, 0] in (BG, MAGENTA):
+                continue
+            cols = []
+            c = 0
+            while c < w and grid[r, c] not in (BG, MAGENTA):
+                cols.append(c)
+                c += 1
