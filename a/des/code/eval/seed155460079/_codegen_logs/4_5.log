+def _port_cell(side: str, block_rc: tuple[int, int], offset: int) -> tuple[int, int]:
+    sr, sc = block_rc
+    if side == "top":
+        return sr + 2, sc + offset
+    if side == "bottom":
+        return sr - 1, sc + offset
+    if side == "left":
+        return sr + offset, sc + 2
+    if side == "right":
+        return sr + offset, sc - 1
+    raise AssertionError("bad side")
