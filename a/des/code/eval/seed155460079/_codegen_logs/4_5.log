+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            rs = [p[0] for p in coords]
+            cs = [p[1] for p in coords]
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (min(rs), min(cs), max(rs), max(cs)),
+                    "area": len(coords),
+                }
+            )
