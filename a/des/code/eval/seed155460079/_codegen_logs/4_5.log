+            for sc in range(0, w - 1):
+                candidates.append((sr, sc))
+    elif side == "bottom":
+        for sr in range(r1 + 3, h - 1):
+            for sc in range(0, w - 1):
+                candidates.append((sr, sc))
+    elif side == "left":
+        for sr in range(0, h - 1):
+            for sc in range(0, c0 - 3):
+                candidates.append((sr, sc))
+    else:
+        for sr in range(0, h - 1):
+            for sc in range(c1 + 3, w - 1):
