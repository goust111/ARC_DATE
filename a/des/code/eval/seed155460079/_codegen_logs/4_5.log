+        moat[r0 - 1, c0 : c1 + 1] = True
+    if r1 + 1 < h:
+        moat[r1 + 1, c0 : c1 + 1] = True
+    if c0 - 1 >= 0:
+        moat[r0 : r1 + 1, c0 - 1] = True
+    if c1 + 1 < w:
+        moat[r0 : r1 + 1, c1 + 1] = True
