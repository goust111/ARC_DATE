+    cur = goal
+    while cur is not None:
+        path.append(cur)
+        cur = parent[cur]
+    path.reverse()
+    return path
+
+
+def _side_counts(rng: random.Random) -> dict[str, int]:
+    total = rng.randint(4, 6)
+    sides = list(SIDES)
+    rng.shuffle(sides)
+    chosen = sides[:]
+    while len(chosen) < total:
+        chosen.append(rng.choice(SIDES))
