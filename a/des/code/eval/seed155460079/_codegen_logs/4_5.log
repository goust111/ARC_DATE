+def _contact_info(grid: np.ndarray, comp: dict, frame: dict) -> dict:
+    h, w = grid.shape
+    r0, c0, r1, c1 = frame["bbox"]
+    contacts = set()
+    for r, c in comp["coords"]:
+        for nr, nc in _neighbors4(r, c):
+            if not (0 <= nr < h and 0 <= nc < w):
