+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    if not np.all(patch[0, :] == color):
+        return None
+    if not np.all(patch[-1, :] == color):
+        return None
+    if not np.all(patch[:, 0] == color):
+        return None
+    if not np.all(patch[:, -1] == color):
