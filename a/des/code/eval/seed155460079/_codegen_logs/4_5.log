+    r0, c0, r1, c1 = bbox
+    total_cols = counts["top"] + counts["bottom"]
+    total_rows = counts["left"] + counts["right"]
+    col_slots = list(range(c0 + 1, c1))
+    row_slots = list(range(r0 + 1, r1))
+    rng.shuffle(col_slots)
+    rng.shuffle(row_slots)
