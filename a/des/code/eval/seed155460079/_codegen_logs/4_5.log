        patch[-1, start : start + gap_len] = bg
    elif side == "left":
        start = rng.randint(1, h - 1 - gap_len)
        patch[start : start + gap_len, 0] = bg
    else:
        start = rng.randint(1, h - 1 - gap_len)
        patch[start : start + gap_len, -1] = bg
    return patch


