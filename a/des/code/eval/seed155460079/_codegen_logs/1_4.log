+    bands = []
+    max_w = 0
+    for sequence, pattern in rows:
+        band = _make_row_band(
+            sequence,
+            pattern,
+            block_size=block_size,
+            left_pad=rng.randint(0, 2),
+            pattern_gap=rng.randint(1, 2),
+        )
+        bands.append(band)
+        max_w = max(max_w, band.shape[1])
