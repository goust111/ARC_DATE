+def _partition_sum(total: int, parts: int, rng: random.Random) -> list[int]:
+    assert parts >= 1 and total >= parts
+    if parts == 1:
+        return [total]
+    cuts = sorted(rng.sample(range(1, total), parts - 1))
+    values = []
+    prev = 0
+    for cut in cuts + [total]:
+        values.append(cut - prev)
+        prev = cut
+    return values
