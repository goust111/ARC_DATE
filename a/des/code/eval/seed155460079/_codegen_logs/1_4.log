+def _neighbors4(r: int, c: int, h: int, w: int) -> Iterable[tuple[int, int]]:
+    for dr, dc in DIRS4:
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            yield rr, cc
