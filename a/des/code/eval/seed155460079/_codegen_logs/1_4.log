+def _group_indices(indices: np.ndarray) -> list[tuple[int, int]]:
+    if len(indices) == 0:
+        return []
+    groups: list[tuple[int, int]] = []
+    start = prev = int(indices[0])
+    for value in indices[1:]:
+        value = int(value)
+        if value == prev + 1:
+            prev = value
