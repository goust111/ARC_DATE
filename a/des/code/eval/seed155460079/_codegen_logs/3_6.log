+def _winner_color(items, fallback):
+    if not items:
+        return fallback
+    max_size = max(item["size"] for item in items)
+    winners = [item for item in items if item["size"] == max_size]
+    if len(winners) == 1:
+        return winners[0]["color"]
+    return fallback
