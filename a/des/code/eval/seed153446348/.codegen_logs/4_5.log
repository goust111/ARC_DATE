+
+def _shape_kind_1() -> tuple[list[tuple[int, int]], int, int]:
+    h = int(_RNG.integers(6, 11))
+    w = int(_RNG.integers(6, 11))
+    cut_h = int(_RNG.integers(2, h - 2))
+    cut_w = int(_RNG.integers(2, w - 2))
+    return _rasterize_cycle(
