+        r1, c1 = vertices[(i + 1) % m]
+        dr = int(np.sign(r1 - r0))
+        dc = int(np.sign(c1 - c0))
+        assert dr == 0 or dc == 0
+        assert not (dr == 0 and dc == 0)
