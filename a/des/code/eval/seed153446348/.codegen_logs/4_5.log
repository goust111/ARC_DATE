    pts=[]
    for (r1,c1),(r2,c2) in zip(vertices, vertices[1:]+vertices[:1]):
        dr=(r2>r1)-(r2<r1); dc=(c2>c1)-(c2<c1)
        r,c=r1,c1
        pts.append((r,c))
        while (r,c)"'!=(r2,c2):
            r+=dr; c+=dc; pts.append((r,c))
    # dedupe preserving cycle? last equals first
    out=[]
    for p in pts[:-1]:
        if not out or p!=out[-1]: out.append(p)
    return out

def count(cycle):
    m=len(cycle)
    dirs=[]
    for i in range(m):
        r1,c1=cycle[i]; r2,c2=cycle[(i+1)%m]
        dirs.append((r2-r1,c2-c1))
    left=right=0
    for i in range(m):
        dr1,dc1=dirs[i-1]; dr2,dc2=dirs[i]
        cr=dr1*dc2-dc1*dr2
        if cr>0:left+=1
