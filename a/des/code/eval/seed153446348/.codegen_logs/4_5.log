+    cut_w = int(_RNG.integers(1, 4))
+    notch_left = int(_RNG.integers(cut_w + 2, w - 5))
+    notch_right = int(_RNG.integers(notch_left + 2, w - 2))
+    depth = int(_RNG.integers(2, h - 2))
