+    for i in range(m):
+        r0, c0 = cycle[i]
+        r1, c1 = cycle[(i + 1) % m]
+        area2 += r0 * c1 - c0 * r1
+    assert area2 != 0, "cycle area must be non-zero"
+    if area2 > 0:
