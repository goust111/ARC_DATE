import numpy as np

def boundary(mask):
    h,w=mask.shape
    out=np.zeros_like(mask)
    for r in range(h):
        for c in range(w):
            if not mask[r,c]:
                continue
            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                rr,cc=r+dr,c+dc
                if not (0<=rr<h and 0<=cc<w) or not mask[rr,cc]:
                    out[r,c]=1;break
    return out

def comps(mask):
    h,w=mask.shape
    seen=set(); arr=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or (r,c) in seen: continue
            st=[(r,c)]; seen.add((r,c)); pts=[]
            while st:
                p=st.pop(); pts.append(p)
                for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                    q=(p[0]+dr,p[1]+dc)
                    if 0<=q[0]<h and 0<=q[1]<w and mask[q] and q not in seen:
                        seen.add(q); st.append(q)
            arr.append(pts)
    return arr

