+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+
+    if np.array_equal(out, grid):
+        return None
+    if len(_components(grid == _GREY)) != object_count + 1:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid input")

