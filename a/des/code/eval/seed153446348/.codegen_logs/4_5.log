+
+    for r in range(h):
+        for c in (0, w - 1):
+            if bool(local_bg[r, c]) and not bool(seen[r, c]):
+                seen[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if bool(local_bg[r, c]) and not bool(seen[r, c]):
+                seen[r, c] = True
