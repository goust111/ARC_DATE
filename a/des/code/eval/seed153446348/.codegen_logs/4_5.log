+def _background_color(grid: np.ndarray) -> int:
+    corners = [int(grid[0, 0]), int(grid[0, -1]), int(grid[-1, 0]), int(grid[-1, -1])]
+    return Counter(corners).most_common(1)[0][0]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            comp: list[tuple[int, int]] = []
+            stack = [(r, c)]
+            seen[r, c] = True
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [p[0] for p in points]
+    cols = [p[1] for p in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _ordered_cycle(points: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    point_set = set(points)
+    neighbors: dict[tuple[int, int], list[tuple[int, int]]] = {}
+    for r, c in points:
+        ns = []
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            q = (r + dr, c + dc)
+            if q in point_set:
+                ns.append(q)
+        assert len(ns) == 2, "path component must be a simple 4-connected cycle"
+        neighbors[(r, c)] = sorted(ns)
+
+    start = min(points)
+    ordered = [start]
+    prev = start
+    curr = neighbors[start][0]
+    while curr != start:
+        ordered.append(curr)
+        n0, n1 = neighbors[curr]
+        nxt = n0 if n0 != prev else n1
+        prev, curr = curr, nxt
+        assert len(ordered) <= len(points), "cycle traversal exceeded component size"
+    assert len(ordered) == len(points), "cycle traversal missed component pixels"
+    return ordered
+
+
+def _clockwise_turn_counts(points: list[tuple[int, int]]) -> tuple[int, int]:
+    cycle = _ordered_cycle(points)
+    m = len(cycle)
+    dirs = []
+    for i in range(m):
+        r0, c0 = cycle[i]
+        r1, c1 = cycle[(i + 1) % m]
+        dirs.append((r1 - r0, c1 - c0))
+
+    left = 0
+    right = 0
+    for i in range(m):
+        dr0, dc0 = dirs[i - 1]
+        dr1, dc1 = dirs[i]
+        cross = dr0 * dc1 - dc0 * dr1
+        if cross > 0:
+            left += 1
+        elif cross < 0:
+            right += 1
+
+    area2 = 0
+    for i in range(m):
+        r0, c0 = cycle[i]
+        r1, c1 = cycle[(i + 1) % m]
+        area2 += r0 * c1 - c0 * r1
+    assert area2 != 0, "cycle area must be non-zero"
+    if area2 > 0:
+        left, right = right, left
+    return left, right
