+def _clockwise_turn_counts(points: list[tuple[int, int]]) -> tuple[int, int]:
+    cycle = _ordered_cycle(points)
+    m = len(cycle)
+    dirs = []
+    for i in range(m):
+        r0, c0 = cycle[i]
+        r1, c1 = cycle[(i + 1) % m]
+        dirs.append((r1 - r0, c1 - c0))
+
+    left = 0
+    right = 0
+    for i in range(m):
+        dr0, dc0 = dirs[i - 1]
+        dr1, dc1 = dirs[i]
+        cross = dr0 * dc1 - dc0 * dr1
+        if cross > 0:
+            left += 1
+        elif cross < 0:
+            right += 1
