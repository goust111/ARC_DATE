+def _place_cells(
+    all_cells: set[tuple[int, int]],
+    u_len: int,
+    depth: int,
+    total: int,
+    clusters: int,
+    used: set[tuple[int, int]],
+    attach_pool: set[tuple[int, int]] | None = None,
+    attach_bias: float = 0.0,
+) -> set[tuple[int, int]] | None:
