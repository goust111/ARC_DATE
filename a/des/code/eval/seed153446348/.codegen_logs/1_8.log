+        grid[r, c] = pattern_color
+    for u, v in side_b:
+        r, c = _to_grid(orientation, axis, 1, u, v)
+        grid[r, c] = pattern_color
+    return grid
+
+
+def _render_expected(
+    rows: int,
+    cols: int,
+    orientation: str,
