            if not path[r,c] and not ext[r,c]: ext[r,c]=True; q.append((r,c))
    for c in range(W):
        for r in (0,H-1):
            if not path[r,c] and not ext[r,c]: ext[r,c]=True; q.append((r,c))
    while q:
        r,c=q.popleft()
        for nr,nc in neighbors4(r,c):
            if 0<=nr<H and 0<=nc<W and not path[nr,nc] and not ext[nr,nc]:
                ext[nr,nc]=True; q.append((nr,nc))
    return (~path)&(~ext)

def valid(cyc, shape):
    H,W=shape
    if len(set(cyc))"'!=len(cyc): return False
    for r,c in cyc:
        if not (0<=r<H and 0<=c<W): return False
    n=len(cyc)
    s=set(cyc)
    for i in range(n):
        a=cyc[i]; b=cyc[(i+1)%n]
        if abs(a[0]-b[0])+abs(a[1]-b[1])!=1: return False
    for r,c in cyc:
        deg=sum((nr,nc) in s for nr,nc in neighbors4(r,c))
        if deg!=2: return False
    interior=interior_mask(cyc, shape)
    if interior.sum()==0: return False
    # check one component interior
    seen=np.zeros(shape,dtype=bool)
    comps=0
    for r in range(H):
        for c in range(W):
