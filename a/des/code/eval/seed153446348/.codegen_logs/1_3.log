    H,W=shape
    if len(cyc) < 8: return False
    if len(set(cyc))"'!=len(cyc): return False
    for r,c in cyc:
        if not (0<=r<H and 0<=c<W): return False
    n=len(cyc)
    s=set(cyc)
    for i in range(n):
        a=cyc[i]; b=cyc[(i+1)%n]
        if abs(a[0]-b[0])+abs(a[1]-b[1])!=1: return False
    for r,c in cyc:
        deg=sum((nr,nc) in s for nr,nc in neighbors4(r,c))
        if deg!=2: return False
    interior=interior_mask(cyc, shape)
    if interior.sum()==0: return False
    seen=np.zeros(shape,dtype=bool)
    comps=0
    for r in range(H):
        for c in range(W):
            if not interior[r,c] or seen[r,c]: continue
            comps+=1
            if comps>1:return False
            q=deque([(r,c)]); seen[r,c]=True
            while q:
                x,y=q.popleft()
                for nx,ny in neighbors4(x,y):
                    if 0<=nx<H and 0<=ny<W and interior[nx,ny] and not seen[nx,ny]:
                        seen[nx,ny]=True; q.append((nx,ny))
    return True

def delta(a,b):
    return b[0]-a[0], b[1]-a[1]

def rotate(lst,k):
    return lst[k:]+lst[:k]

def one_bump(cyc,shape):
    n=len(cyc)
    for _ in range(30):
        edge_idx=random.randrange(n)
        d=delta(cyc[edge_idx],cyc[(edge_idx+1)%n])
        s=edge_idx
        while delta(cyc[(s-1)%n],cyc[s])==d:
