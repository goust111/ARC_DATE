+def _build_patch(color: int) -> np.ndarray | None:
+    for _ in range(PATCH_RETRIES):
+        canvas_h = random.randint(*PATCH_CANVAS_RANGE)
+        canvas_w = random.randint(*PATCH_CANVAS_RANGE)
+        shape = (canvas_h, canvas_w)
