    for a,b in zip(seq, seq[1:]+seq[:1]):
        dr=b[0]-a[0]; dc=b[1]-a[1]
        rr=(dc,-dr)
        ll=(-dc,dr)
        right=sum(inside((r+rr[0], c+rr[1])) for r,c in (a,b))
        left=sum(inside((r+ll[0], c+ll[1])) for r,c in (a,b))
        total += right-left
    return total

