    for r in range(top+h-2, top, -1):
        cyc.append((r,left))
    return cyc

def interior_mask(cyc, shape):
    H,W=shape
    path=np.zeros(shape,dtype=bool)
    for r,c in cyc:path[r,c]=True
    ext=np.zeros(shape,dtype=bool)
    q=deque()
    for r in range(H):
        for c in (0,W-1):
            if not path[r,c] and not ext[r,c]: ext[r,c]=True; q.append((r,c))
    for c in range(W):
        for r in (0,H-1):
            if not path[r,c] and not ext[r,c]: ext[r,c]=True; q.append((r,c))
    while q:
        r,c=q.popleft()
        for nr,nc in neighbors4(r,c):
            if 0<=nr<H and 0<=nc<W and not path[nr,nc] and not ext[nr,nc]:
                ext[nr,nc]=True; q.append((nr,nc))
    return (~path)&(~ext)

