        rot=rotate(cyc,s)
        d=delta(rot[0],rot[1])
        run_edges=1
        while run_edges < len(rot)-1 and delta(rot[run_edges], rot[(run_edges+1)%len(rot)])==d:
            run_edges+=1
        m=run_edges+1
        if m<4:
            continue
        a=random.randint(0,m-4)
        b=random.randint(a+2,m-1)
        A=rot[a]; B=rot[b]
        dr,dc=d
        nr,nc=-dc,dr
        dist=b-a
        options=[]
        for depth in (1,2):
            candidate=[A]
            for k in range(1,depth+1):
                candidate.append((A[0]+nr*k, A[1]+nc*k))
            for t in range(1,dist+1):
                candidate.append((A[0]+nr*depth+dr*t, A[1]+nc*depth+dc*t))
            for k in range(depth-1,-1,-1):
                candidate.append((B[0]+nr*k, B[1]+nc*k))
            new=rot[:a] + candidate + rot[b+1:]
            if valid(new,shape):
                options.append(new)
        if options:
            return random.choice(options)
    return None

def gen():
    for _ in range(1000):
        H=random.randint(9,16); W=random.randint(9,16)
        top=random.randint(2,4); left=random.randint(2,4)
        max_h=H-top-2; max_w=W-left-2
        if max_h < 4 or max_w < 4: continue
        h=random.randint(4,max_h)
        w=random.randint(4,max_w)
        cyc=rectangle_cycle(top,left,h,w)
        if not valid(cyc,(H,W)): continue
        for __ in range(random.randint(1,4)):
            nxt=one_bump(cyc,(H,W))
            if nxt is not None:
                cyc=nxt
        if valid(cyc,(H,W)):
            return H,W,cyc
    return None

def adj_from_cycle(cyc):
    s={p:[] for p in cyc}
    for a,b in zip(cyc,cyc[1:]+cyc[:1]):
        s[a].append(b); s[b].append(a)
    return s

def trace(start, nxt, adj):
    seq=[start]
    prev=start; cur=nxt
    while cur != start:
        seq.append(cur)
        a,b=adj[cur]
        nxt2=b if a==prev else a
        prev,cur=cur,nxt2
    return seq

def score(seq, interior):
    H,W=interior.shape
    total=0
    def inside(p):
        r,c=p
