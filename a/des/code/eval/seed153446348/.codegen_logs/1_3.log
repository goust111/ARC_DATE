+def _rotate_list(items: list[tuple[int, int]], start: int) -> list[tuple[int, int]]:
+    return items[start:] + items[:start]
+
+
+def _delta(a: tuple[int, int], b: tuple[int, int]) -> tuple[int, int]:
+    return b[0] - a[0], b[1] - a[1]
