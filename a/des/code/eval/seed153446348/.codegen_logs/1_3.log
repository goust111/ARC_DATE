    H,W,cyc=gen()
    mask=np.zeros((H,W),dtype=bool)
    for r,c in cyc: mask[r,c]=True
    interior=interior_mask(cyc,(H,W))
    adj=adj_from_cycle(cyc)
    idx=random.randrange(len(cyc))
    seed=cyc[idx]
    n1,n2=adj[seed]
    s1=trace(seed,n1,adj)
    s2=trace(seed,n2,adj)
    sc1=score(s1,interior)
    sc2=score(s2,interior)
    # original clockwise sequence rotated to seed
    orig=cyc[idx:]+cyc[:idx]
    ok=(s1==orig and sc1>sc2) or (s2==orig and sc2>sc1)
    if not ok:
        print('"'failure',i,sc1,sc2,len(cyc))
        print('seed',seed)
        print('s1eq',s1==orig,'s2eq',s2==orig)
        break
else:
    print('orientation ok')
