+        cycle.append((top, c))
+    for r in range(top + 1, top + height):
+        cycle.append((r, left + width - 1))
+    for c in range(left + width - 2, left - 1, -1):
+        cycle.append((top + height - 1, c))
+    for r in range(top + height - 2, top, -1):
