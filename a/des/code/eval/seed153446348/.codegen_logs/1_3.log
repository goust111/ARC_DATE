import random
from collections import deque
import numpy as np
DIRS=[(-1,0),(1,0),(0,-1),(0,1)]

def neighbors4(r,c):
    for dr,dc in DIRS:
        yield r+dr,c+dc

def rectangle_cycle(top,left,h,w):
    cyc=[]
    for c in range(left,left+w):
        cyc.append((top,c))
    for r in range(top+1, top+h):
        cyc.append((r,left+w-1))
    for c in range(left+w-2, left-1, -1):
