    while run_edges < len(rot) and delta(rot[run_edges-1], rot[run_edges%len(rot)])==d:
        run_edges+=1
        if run_edges==len(rot): break
    m=run_edges+1
    if m<4:
        return None
    a=random.randint(0,m-4)
    b=random.randint(a+2,m-1)
    A=rot[a]; B=rot[b]
    dr,dc=d
    nr,nc=-dc,dr
    dist=b-a
    max_depth=2
    cand_options=[]
    for depth in range(1,max_depth+1):
        candidate=[A]
        for k in range(1,depth+1):
