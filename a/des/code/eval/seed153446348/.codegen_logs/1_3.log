+
+def _trace_cycle(
+    start: tuple[int, int],
+    nxt: tuple[int, int],
+    adjacency: dict[tuple[int, int], list[tuple[int, int]]],
+) -> list[tuple[int, int]]:
+    seq = [start]
+    prev = start
+    cur = nxt
+    while cur != start:
+        seq.append(cur)
+        a, b = adjacency[cur]
+        cur, prev = (b, cur) if a == prev else (a, cur)
