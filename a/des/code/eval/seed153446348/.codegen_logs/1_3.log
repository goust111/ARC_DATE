+        seed_coords = np.argwhere(patch == OUTLINE)
+        if seed_coords.shape[0] < 8:
+            continue
+        sr, sc = map(int, random.choice(seed_coords.tolist()))
+        patch = patch.copy()
+        patch[sr, sc] = int(color)
+        return patch
