def _delta(a: tuple[int, int], b: tuple[int, int]) -> tuple[int, int]:
    return b[0] - a[0], b[1] - a[1]


def _try_bump(cycle: list[tuple[int, int]], shape: tuple[int, int]) -> list[tuple[int, int]] | None:
    n = len(cycle)
    for _ in range(BUMP_RETRIES):
