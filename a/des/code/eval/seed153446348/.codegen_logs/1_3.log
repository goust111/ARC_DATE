+    score = 0
+    wrapped = seq[1:] + seq[:1]
+    for (r1, c1), (r2, c2) in zip(seq, wrapped):
+        dr = r2 - r1
+        dc = c2 - c1
+        right = (dc, -dr)
+        left = (-dc, dr)
+        score += inside(r1 + right[0], c1 + right[1])
+        score += inside(r2 + right[0], c2 + right[1])
+        score -= inside(r1 + left[0], c1 + left[1])
+        score -= inside(r2 + left[0], c2 + left[1])
