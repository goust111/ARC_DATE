    patch = np.full(shape, bg, dtype=int)
    patch[0, :] = frame_color
    patch[-1, :] = frame_color
    patch[:, 0] = frame_color
    patch[:, -1] = frame_color
    return patch


def _gen_frame_patch(
    target_mask: np.ndarray,
    seed_cells: np.ndarray,
    scale: int,
