+        local = original[r0 : r1 + 1, c0 : c1 + 1]
+        perimeter = np.zeros_like(local, dtype=bool)
+        perimeter[0, :] = True
+        perimeter[-1, :] = True
+        perimeter[:, 0] = True
+        perimeter[:, -1] = True
