+import numpy as np
+
+
+BACKGROUND = 0
+BORDER_COLOR = 5
+SIDES = ("top", "bottom", "left", "right")
+FILL_COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+
+RECT_COUNT_CHOICES = (2, 3, 4)
+GRID_SIDE_MIN = 18
+GRID_SIDE_MAX = 30
+RECT_OUTER_H_RANGE = (4, 9)
+RECT_OUTER_W_RANGE = (4, 10)
+PLACEMENT_GAP = 2
+NOISE_COUNT_MAX_EXTRA = 2
+MAX_GENERATION_ATTEMPTS = 300
