+def _sample_rect_sizes(count: int) -> list[tuple[int, int]] | None:
+    candidates: list[tuple[int, int, int]] = []
+    for h in range(RECT_OUTER_H_RANGE[0], RECT_OUTER_H_RANGE[1] + 1):
