+def _expected_output(
+    grid: np.ndarray,
+    legend_mask: np.ndarray,
+    rects: list[tuple[int, int, int, int]],
+    legend_colors: list[int],
+) -> np.ndarray:
+    return _render_output(grid, legend_mask, BORDER_COLOR, rects, legend_colors)
+
+
+def _gen_attempt() -> np.ndarray | None:
