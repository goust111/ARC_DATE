+        local = original[r0 : r1 + 1, c0 : c1 + 1]
+        perimeter = np.zeros_like(local, dtype=bool)
+        perimeter[0, :] = True
+        perimeter[-1, :] = True
+        perimeter[:, 0] = True
+        perimeter[:, -1] = True
+
+        side_counts = (
+            int(original[r0, c0 : c1 + 1].sum()),
+            int(original[r1, c0 : c1 + 1].sum()),
+            int(original[r0 : r1 + 1, c0].sum()),
+            int(original[r0 : r1 + 1, c1].sum()),
