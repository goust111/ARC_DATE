+def _neighbors(r: int, c: int, h: int, w: int, conn8: bool) -> list[tuple[int, int]]:
+    steps4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    steps = steps4 + [(-1, -1), (-1, 1), (1, -1), (1, 1)] if conn8 else steps4
+    out: list[tuple[int, int]] = []
+    for dr, dc in steps:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            out.append((nr, nc))
+    return out
