+        grown = np.zeros_like(out, dtype=bool)
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                grown |= padded[1 + dr : 1 + dr + h, 1 + dc : 1 + dc + w]
+        out = grown
+    return out
