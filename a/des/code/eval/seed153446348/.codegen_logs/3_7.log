+    col_nonzero = np.any(band != BACKGROUND, axis=0)
+    c = 0
+    while c < w:
+        if not col_nonzero[c]:
+            c += 1
+            continue
+        start = c
+        while c < w and col_nonzero[c]:
+            c += 1
+        if c - start != 2:
