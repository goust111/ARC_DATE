+        if color == BACKGROUND or not np.all(block == color):
+            return None
+        colors.append(color)
+        mask[:, start:c] = True
+    if len(colors) < 2:
+        return None
+    if np.any((band != BACKGROUND) & (~mask)):
+        return None
+    return colors, mask
+
+
+def _parse_vertical_legend(band: np.ndarray) -> tuple[list[int], np.ndarray] | None:
+    if band.shape[1] != 2:
+        return None
