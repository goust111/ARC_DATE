+    core_size = rng.choice((1, 2))
+    margin_choices = (1, 2) if crowded else (1, 2, 2, 3)
+    row_insets = [rng.choice(margin_choices) for _ in range(depth)]
+    col_insets = [rng.choice(margin_choices) for _ in range(depth)]
