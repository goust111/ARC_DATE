+    pad_c0 = max(0, c0 - PLACEMENT_PAD)
+    pad_r1 = min(grid.shape[0] - 1, r1 + PLACEMENT_PAD)
+    pad_c1 = min(grid.shape[1] - 1, c1 + PLACEMENT_PAD)
+    occupied[pad_r0 : pad_r1 + 1, pad_c0 : pad_c1 + 1] = True
