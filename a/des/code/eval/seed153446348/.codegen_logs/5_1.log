+
+def _sample_depths(rng: random.Random, n_groups: int) -> list[int]:
+    depths = [rng.choice((1, 3)), rng.choice((2, 4))]
+    while len(depths) < n_groups:
+        depths.append(rng.choice((1, 2, 3, 4)))
