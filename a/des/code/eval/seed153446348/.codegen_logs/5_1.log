+    for spec in sorted(specs, key=lambda item: item["outer_h"] * item["outer_w"], reverse=True):
+        h = int(spec["outer_h"])
+        w = int(spec["outer_w"])
+        max_top = grid.shape[0] - h
+        max_left = grid.shape[1] - w
+        if max_top < 0 or max_left < 0:
+            return None
+
+        success = False
