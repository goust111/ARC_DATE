+    if not np.array_equal(actual, expected):
+        return None
+
+    odd_present = any(int(spec["depth"]) % 2 == 1 for spec in placed)
+    even_present = any(int(spec["depth"]) % 2 == 0 for spec in placed)
+    if not (odd_present and even_present):
