+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _bbox_area(bbox: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = bbox
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
