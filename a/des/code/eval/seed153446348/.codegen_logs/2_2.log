+def _farthest_pair(component: list[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int], int]:
+    start = component[0]
+    a, _ = _farthest_from(component, start)
+    b, dist_map = _farthest_from(component, a)
+    return a, b, int(dist_map[b])
