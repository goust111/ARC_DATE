+BACKGROUND = 0
+TEMPLATE_COLOR = 5
+PIECE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+SIDES = ("top", "bottom", "left", "right")
+SHAPE_POOL = ((2, 2), (2, 3), (3, 2), (3, 3), (2, 4), (4, 2), (3, 4), (4, 3))
