+COLOR_POOL = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+OBJECT_COUNT_RANGE = (2, 4)
+INTERIOR_SIDE_RANGE = (4, 6)
+CANVAS_SIDE_RANGE = (20, 30)
+PLACEMENT_PADDING = 1
+SHAPE_TRIES = 200
+CASE_TRIES = 300
