+
+def _random_path(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = a
+    cells = [(int(r), int(c))]
+    while (r, c) != b:
+        options = []
+        if r < b[0]:
+            options.append((r + 1, c))
+        elif r > b[0]:
+            options.append((r - 1, c))
+        if c < b[1]:
+            options.append((r, c + 1))
+        elif c > b[1]:
+            options.append((r, c - 1))
+        r, c = random.choice(options)
+        cells.append((int(r), int(c)))
