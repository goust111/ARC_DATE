+def _extract_seeds(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seeds: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color in (BG, GREEN):
