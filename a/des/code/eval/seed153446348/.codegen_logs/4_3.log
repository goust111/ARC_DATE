+
+
+def _dirs_for_mode(
+    pos: tuple[int, int],
+    count: int,
+    mode: str,
+    h: int,
+    w: int,
+    occupied: set[tuple[int, int]],
+    forbidden: set[tuple[int, int]],
+) -> list[tuple[tuple[int, int], int]]:
