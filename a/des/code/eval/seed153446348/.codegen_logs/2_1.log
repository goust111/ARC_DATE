+
+def _bg_color(grid):
+    return Counter(int(x) for x in np.ravel(grid)).most_common(1)[0][0]
+
+
+def _trim(mask):
+    rows = np.any(mask, axis=1)
+    cols = np.any(mask, axis=0)
+    return mask[rows][:, cols]
+
+
+def _rotations(mask):
+    out = []
+    seen = set()
