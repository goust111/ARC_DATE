+        if not success:
+            return None
+
+    out = main(grid)
+    if not np.any(out == ORANGE):
+        return None
+
+    inner = grid[1:-1, 1:-1]
+    if not all(np.any(inner == color) for color in WALL_COLORS):
+        return None
+
+    if not np.any(out[0, 1:-1] == ORANGE):
+        return None
+    if not np.any(out[-1, 1:-1] == ORANGE):
+        return None
+    if not np.any(out[1:-1, 0] == ORANGE):
+        return None
+    if not np.any(out[1:-1, -1] == ORANGE):
+        return None
+
+    return grid
