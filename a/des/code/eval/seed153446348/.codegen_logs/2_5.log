import random
from collections import deque

def dilate8(S):
    out=set()
    for r,c in S:
        for dr in (-1,0,1):
            for dc in (-1,0,1):
                out.add((r+dr,c+dc))
    return out

def neighbors4(p):
    r,c=p
    return [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]

def comp_count(cells):
    cells=set(cells)
    seen=set(); cnt=0
    for p in list(cells):
        if p in seen: continue
        cnt+=1; q=[p]; seen.add(p)
        for x in q:
            for y in neighbors4(x):
                if y in cells and y not in seen:
                    seen.add(y); q.append(y)
    return cnt

def is_8_connected(S):
    S=set(S)
    p=next(iter(S)); seen={p}; q=[p]
    for x in q:
        r,c=x
        for dr in (-1,0,1):
            for dc in (-1,0,1):
                if dr==dc==0: continue
                y=(r+dr,c+dc)
                if y in S and y not in seen:
                    seen.add(y); q.append(y)
    return len(seen)==len(S)

def boundary(S):
    S=set(S)
    return dilate8(S)-S

def boundary_ok(B):
