+def _draw_closed_path(waypoints: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    assert len(waypoints) >= 4
+    cells: set[tuple[int, int]] = set()
+    for (r1, c1), (r2, c2) in zip(waypoints, waypoints[1:] + waypoints[:1]):
