+def _count_inner_regions(cells: list[tuple[int, int]] | set[tuple[int, int]]) -> int:
+    pts = [(int(r), int(c)) for r, c in cells]
+    rs = [r for r, _ in pts]
+    cs = [c for _, c in pts]
+    r0, r1 = min(rs) - 1, max(rs) + 1
+    c0, c1 = min(cs) - 1, max(cs) + 1
+    h, w = r1 - r0 + 1, c1 - c0 + 1
+
+    blocked = np.zeros((h, w), dtype=bool)
+    for r, c in pts:
+        blocked[r - r0, c - c0] = True
+
+    seen = np.zeros((h, w), dtype=bool)
+    q = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if not bool(blocked[r, c]) and not bool(seen[r, c]):
+                seen[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not bool(blocked[r, c]) and not bool(seen[r, c]):
+                seen[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and not bool(blocked[nr, nc]) and not bool(seen[nr, nc]):
+                seen[nr, nc] = True
+                q.append((nr, nc))
+
+    count = 0
+    for r in range(h):
+        for c in range(w):
+            if bool(blocked[r, c]) or bool(seen[r, c]):
+                continue
+            count += 1
+            seen[r, c] = True
+            q = deque([(r, c)])
+            while q:
+                rr, cc = q.popleft()
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not bool(blocked[nr, nc]) and not bool(seen[nr, nc]):
