+        if r1 == r2:
+            lo, hi = sorted((c1, c2))
+            for c in range(lo, hi + 1):
+                cells.add((int(r1), int(c)))
+        else:
+            lo, hi = sorted((r1, r2))
+            for r in range(lo, hi + 1):
+                cells.add((int(r), int(c1)))
+    return _trace_cycle(cells)
