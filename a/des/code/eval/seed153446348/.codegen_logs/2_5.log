    H,W=r1-r0+1,c1-c0+1
    mask=[[False]*W for _ in range(H)]
    for r,c in B: mask[r-r0][c-c0]=True
    seen=[[False]*W for _ in range(H)]
    q=deque()
    for r in range(H):
        for c in [0,W-1]:
            if not mask[r][c] and not seen[r][c]: seen[r][c]=1; q.append((r,c))
    for c in range(W):
        for r in [0,H-1]:
            if not mask[r][c] and not seen[r][c]: seen[r][c]=1; q.append((r,c))
    while q:
        r,c=q.popleft()
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and not mask[nr][nc] and not seen[nr][nc]: seen[nr][nc]=1; q.append((nr,nc))
    cnt=0
    for r in range(H):
        for c in range(W):
            if not mask[r][c] and not seen[r][c]:
                cnt+=1; seen[r][c]=1; q=deque([(r,c)])
                while q:
                    rr,cc=q.popleft()
                    for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                        nr,nc=rr+dr,cc+dc
                        if 0<=nr<H and 0<=nc<W and not mask[nr][nc] and not seen[nr][nc]: seen[nr][nc]=1; q.append((nr,nc))
    return cnt

for n in [1,2,3,4]:
    ok=0
    for _ in range(5000):
        # random set with target 4-comp count n and 8-connected
        cells=[(0,0)]
        while len(cells)<random.randint(n,n+4):
            r,c=random.choice(cells)
            dr,dc=random.choice([(a,b) for a in (-1,0,1) for b in (-1,0,1) if (a,b)!=(0,0)])
            p=(r+dr,c+dc)
            if p not in cells:
                cells.append(p)
        S=set(cells)
        if not is_8_connected(S) or comp_count(S)!=n:
            continue
        B=boundary(S)
        if boundary_ok(B) and count_regions(B)==n:
            ok+=1
            if ok==1:
                print('"'n',n,'example size',len(S),'B',len(B))
    print('n',n,'ok',ok)
