    while cur "'!= start:
        path.append(cur)
        nxts = [n for n in neighbors4(*cur) if n in cellset and n != prev]
        assert len(nxts) == 1
        prev, cur = cur, nxts[0]
    return path


def corner_indices(cycle):
    out = []
    n = len(cycle)
    for i, p in enumerate(cycle):
        a = cycle[i - 1]
        b = cycle[(i + 1) % n]
        d1 = (p[0] - a[0], p[1] - a[1])
        d2 = (b[0] - p[0], b[1] - p[1])
        if d1 != d2:
            out.append(i)
    return out


def corners_clockwise(cycle):
