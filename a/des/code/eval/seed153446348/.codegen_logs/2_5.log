    corners = [cycle[i] for i in idxs]
    area2 = 0
    for (r1,c1),(r2,c2) in zip(corners, corners[1:]+corners[:1]):
        area2 += c1 * r2 - c2 * r1
    if area2 < 0:
        idxs = list(reversed(idxs))
        corners = [cycle[i] for i in idxs]
    start = min(range(len(corners)), key=lambda i: corners[i])
    idxs = idxs[start:] + idxs[:start]
