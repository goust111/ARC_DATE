+
+def _place_corridor(
+    grid: np.ndarray,
+    blocked: set[tuple[int, int]],
+    rng: random.Random,
+    color: int,
+    exit_mode: str,
+    turn_mode: str,
+) -> dict[str, object] | None:
+    h, w = grid.shape
+    for _ in range(400):
+        built = _build_relative_path(rng, turn_mode)
+        if built is None:
