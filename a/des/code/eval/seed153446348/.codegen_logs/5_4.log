+                if nxt in used:
+                    ok = False
+                    break
+                for dr, dc in DIRS4:
+                    adj = (nxt[0] + dr, nxt[1] + dc)
+                    if adj in used and adj != path[-1]:
+                        ok = False
+                        break
+                if not ok:
+                    break
+                path.append(nxt)
+                used.add(nxt)
+            if not ok:
+                break
+        if not ok or len(path) < 2:
+            continue
+
+        start_out = (-seg_dirs[0][0], -seg_dirs[0][1])
+        end_out = seg_dirs[-1]
