+    if h != w or h < 3 or component["area"] != 4 * h - 4:
+        return False
+
+    r0, c0, r1, c1 = component["bbox"]
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    color = component["color"]
+    if not np.all(sub[0, :] == color):
+        return False
+    if not np.all(sub[-1, :] == color):
+        return False
+    if not np.all(sub[:, 0] == color):
+        return False
+    if not np.all(sub[:, -1] == color):
+        return False
+    if np.any(sub[1:-1, 1:-1] != bg):
