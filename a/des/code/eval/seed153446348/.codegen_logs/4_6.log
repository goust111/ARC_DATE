+    best: tuple[tuple[int, int, int], list[dict]] | None = None
+    for color, parts in by_color.items():
+        if len(parts) < 2:
+            continue
+        if max(part["bbox"][3] for part in parts) >= frame_left:
+            continue
+        if not all(_is_solid_square(grid, part) for part in parts):
+            continue
