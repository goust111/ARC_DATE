+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[counts.argmax()])
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+
+            color = int(grid[r, c])
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            r0 = r1 = r
+            c0 = c1 = c
+
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                r0 = min(r0, rr)
+                r1 = max(r1, rr)
+                c0 = min(c0, cc)
+                c1 = max(c1, cc)
+
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+
+            components.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "area": len(coords),
+                    "coords": coords,
+                }
+            )
+
+    return components
+
+
+def _bbox_size(component: dict) -> tuple[int, int]:
+    r0, c0, r1, c1 = component["bbox"]
+    return r1 - r0 + 1, c1 - c0 + 1
+
+
+def _is_solid_square(grid: np.ndarray, component: dict) -> bool:
+    h, w = _bbox_size(component)
+    if h != w or component["area"] != h * w:
+        return False
+    r0, c0, r1, c1 = component["bbox"]
+    return bool(np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == component["color"]))
+
+
+def _is_hollow_square_frame(grid: np.ndarray, component: dict, bg: int) -> bool:
+    h, w = _bbox_size(component)
+    if h != w or h < 3 or component["area"] != 4 * h - 4:
+        return False
+
+    r0, c0, r1, c1 = component["bbox"]
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    color = component["color"]
+    if not np.all(sub[0, :] == color):
+        return False
+    if not np.all(sub[-1, :] == color):
+        return False
+    if not np.all(sub[:, 0] == color):
+        return False
+    if not np.all(sub[:, -1] == color):
+        return False
+    if np.any(sub[1:-1, 1:-1] != bg):
+        return False
+    return True
+
