+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+SEPARATOR = 9
+
+HOLE_COUNTS = (0, 1, 2)
+LEGEND_COLORS = (1, 2, 3, 4, 6, 7, 8)
