+            while stack:
+                r, c = stack.pop()
+                if r == 0 or c == 0 or r == h - 1 or c == w - 1:
+                    touches_border = True
+                for rr, cc in _neighbors4(r, c):
+                    if 0 <= rr < h and 0 <= cc < w and bg_mask[rr, cc] and not seen[rr, cc]:
