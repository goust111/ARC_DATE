+                c = random.randint(1, outer_w - ww - 1)
+                good = True
+                for er, ec, eh, ew in rects:
+                    if not (
+                        r + hh + 1 <= er
+                        or er + eh + 1 <= r
+                        or c + ww + 1 <= ec
+                        or ec + ew + 1 <= c
+                    ):
+                        good = False
