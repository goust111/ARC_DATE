+                    if outer_h - hh - 2 >= 1 and outer_w - ww - 2 >= 1:
+                        choices.append((hh, ww))
+            if not choices:
+                return None
+            hh, ww = random.choice(choices)
+            placed = False
+            for _ in range(80):
+                r = random.randint(1, outer_h - hh - 1)
+                c = random.randint(1, outer_w - ww - 1)
+                good = True
+                for er, ec, eh, ew in rects:
+                    if not (
+                        r + hh + 1 <= er
+                        or er + eh + 1 <= r
+                        or c + ww + 1 <= ec
+                        or ec + ew + 1 <= c
+                    ):
+                        good = False
+                        break
+                if good:
+                    rects.append((r, c, hh, ww))
+                    placed = True
+                    break
+            if not placed:
+                ok = False
+                break
+        if ok:
+            return list(rects)
+    return None
+
