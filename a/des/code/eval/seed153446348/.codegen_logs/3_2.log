+            int(shapes[idx].sum()),
+        ),
+        reverse=True,
+    )
+
+    blocked = np.zeros((grid_h, left_w), dtype=bool)
+    placements: list[tuple[int, int] | None] = [None] * len(shapes)
+
+    for idx in order:
