+            cursor += inter_row_gap
+
+    for row_top, row, row_width, gaps in zip(row_tops, row_indices, row_widths, gaps_by_row):
+        x = random.randint(1, width - row_width - 1)
+        gap_iter = iter(gaps)
+        for j, idx in enumerate(row):
