def _enforce_branch_coverage(
    pattern: np.ndarray,
    mask: np.ndarray,
    sources: list[int],
    fillers: list[int],
) -> None:
    true_cells = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
    false_cells = [tuple(map(int, rc)) for rc in np.argwhere(~mask)]
    random.shuffle(true_cells)
    random.shuffle(false_cells)

