        for nh in range(h_min, h_max + 1)
        if rh + nh + ROW_GAP_MIN <= n
    ]
    if not pairs:
        return None
    rect_h, nonsplit_h = random.choice(pairs)
    min_w, max_w = RECT_WIDTH_RANGE[0], min(RECT_WIDTH_RANGE[1], n - LEFT_PATCH_CANVAS_PAD)
    if max_w < min_w:
        return None
