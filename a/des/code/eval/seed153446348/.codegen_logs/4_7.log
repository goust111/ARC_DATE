+    mr0, mc0, mr1, mc1 = mask_box
+    pr0, pc0, pr1, pc1 = pattern_box
+    mask = bottom[mr0 : mr1 + 1, mc0 : mc1 + 1]
+    pattern = bottom[pr0 : pr1 + 1, pc0 : pc1 + 1]
