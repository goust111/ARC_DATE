+            c0 = random.randint(0, width - 1)
+            c1 = random.randint(c0, width - 1)
+            mask[r0 : r1 + 1, c0 : c1 + 1] = True
+        extras = random.randint(0, max(1, (height * width) // 6))
+        for _ in range(extras):
