+    pattern = np.empty((height, width), dtype=int)
+    idx = 0
+    r0 = 0
+    for rh in row_segments:
+        c0 = 0
+        for cw in col_segments:
+            pattern[r0 : r0 + rh, c0 : c0 + cw] = int(block_colors[idx])
+            idx += 1
+            c0 += cw
