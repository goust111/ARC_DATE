            pattern[r0 : r0 + rh, c0 : c0 + cw] = int(block_colors[idx])
            idx += 1
            c0 += cw
        r0 += rh
    return pattern


def _build_mask(height: int, width: int, min_true: int, min_false: int) -> np.ndarray:
    mode = random.choice(["scatter", "bands", "rects"])
    mask = np.zeros((height, width), dtype=bool)

