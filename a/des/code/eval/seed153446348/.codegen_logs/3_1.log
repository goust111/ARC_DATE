+            candidates: list[tuple[int, int, int, int, int, int]] = []
+            for nid in neighbors[rid]:
+                ncolor = int(region_colors[nid])
+                if rounds[nid] < 0:
+                    continue
+                pair = (rid, nid) if rid < nid else (nid, rid)
+                seed_r, seed_c = seed_by_color[ncolor]
