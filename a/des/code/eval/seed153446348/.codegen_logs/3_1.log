+
+BG_COLOR = 0
+WALL_COLOR = 5
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+ROW_COUNT_RANGE = (3, 4)
+COL_COUNT_RANGE = (3, 4)
+CELL_HEIGHT_RANGE = (2, 5)
