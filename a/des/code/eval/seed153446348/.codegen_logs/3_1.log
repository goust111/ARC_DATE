+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG_COLOR = 0
+WALL_COLOR = 5
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+ROW_COUNT_RANGE = (3, 4)
+COL_COUNT_RANGE = (3, 4)
+CELL_HEIGHT_RANGE = (2, 5)
+CELL_WIDTH_RANGE = (2, 5)
+GRID_MIN_SIZE = 10
+GRID_MAX_SIZE = 24
