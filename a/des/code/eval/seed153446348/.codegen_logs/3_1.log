+    if fixed_row is None:
+        fixed_row = random.randint(r0, r1)
+    if fixed_col is None:
+        fixed_col = random.randint(c0, c1)
+
+    if toward == "left":
+        c = c0 if near else c1
+        return fixed_row, c
+    if toward == "right":
+        c = c1 if near else c0
+        return fixed_row, c
+    if toward == "top":
+        r = r0 if near else r1
+        return r, fixed_col
+    if toward == "bottom":
