+def _detect_wall_color(grid: np.ndarray, bg: int) -> int:
+    vals, cnts = np.unique(grid[grid != bg], return_counts=True)
+    assert vals.size > 0, "expected at least one wall color"
+    return int(vals[int(np.argmax(cnts))])
