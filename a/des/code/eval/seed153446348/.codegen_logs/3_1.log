+def _seed_to_boundary_distance(seed_pos: tuple[int, int], wall_cells: set[tuple[int, int]]) -> int:
+    sr, sc = seed_pos
+    return min(abs(sr - r) + abs(sc - c) for r, c in wall_cells)
