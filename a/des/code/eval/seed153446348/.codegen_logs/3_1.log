+    boundary_walls: dict[tuple[int, int], set[tuple[int, int]]],
+) -> tuple[list[int], list[int], dict]:
+    region_colors = [BG_COLOR] * len(regions)
+    seed_by_color: dict[int, tuple[int, int]] = {}
