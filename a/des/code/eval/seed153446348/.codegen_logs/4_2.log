+BG = 0
+RING = 5
+PALETTE_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_RETRIES = 400
+PLACE_RETRIES = 200
+
+
+def _components(mask: np.ndarray) -> tuple[np.ndarray, list[np.ndarray]]:
+    """Label 4-connected True components and return their coordinates."""
+    h, w = mask.shape
+    labels = np.full((h, w), -1, dtype=int)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] != -1:
+                continue
+            cid = len(comps)
+            q = deque([(r, c)])
+            labels[r, c] = cid
+            pts = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and labels[nr, nc] == -1:
+                        labels[nr, nc] = cid
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return labels, comps
