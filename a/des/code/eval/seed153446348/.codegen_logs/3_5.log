+        rng.shuffle(boundary_cells)
+        removal_goal = rng.randint(1, max(1, min(len(boundary_cells) - 1, h + w)))
+        removed = 0
+
+        for r, c in boundary_cells:
+            if removed >= removal_goal:
+                break
+            trial = mask.copy()
+            trial[r, c] = False
+            if int(trial.sum()) < 5:
