+    rect_r1 = rect_r0 + rect_h - 1
+    rect_c1 = rect_c0 + rect_w - 1
+    grid[rect_r0 : rect_r1 + 1, rect_c0 : rect_c1 + 1] = GREY
+
+    for (top, left), hole_mask, color in zip(placements, hole_masks, colors):
+        hr, hc = np.where(hole_mask)
