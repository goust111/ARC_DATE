+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GENERATE_MAX_RETRIES):
+        grid = _generate_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input: failed to create a valid puzzle instance")

