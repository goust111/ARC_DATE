+    max_h = max(mask.shape[0] for mask in hole_masks)
+    max_w = max(mask.shape[1] for mask in hole_masks)
+    rect_h = rng.randint(max(10, max_h + 5), max(14, max_h + 10))
+    rect_w = rng.randint(max(10, max_w + 5), max(16, max_w + 12))
