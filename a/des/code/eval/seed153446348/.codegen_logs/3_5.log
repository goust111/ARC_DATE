+        if not _place_patch(grid, blocked, piece_patches[index], rng):
+            return None
+
+    expected = _build_expected_output(grid.shape, (rect_r0, rect_c0, rect_r1, rect_c1))
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
+
