+    max_r = max(r for r, _ in offsets)
+    min_c = min(c for _, c in offsets)
+    max_c = max(c for _, c in offsets)
+    row_start = -min_r
+    row_stop = rect_h - 1 - max_r
+    col_start = -min_c
+    col_stop = rect_w - 1 - max_c
+    if row_start > row_stop or col_start > col_stop:
+        return None
