+def _transform(arr: np.ndarray, transform_id: int) -> np.ndarray:
+    out = np.array(arr, copy=True)
+    if transform_id >= 4:
+        out = np.fliplr(out)
+    out = np.rot90(out, transform_id % 4)
+    return np.array(out, copy=True)
+
