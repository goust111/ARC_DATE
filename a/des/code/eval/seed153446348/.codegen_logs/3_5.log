+                break
+            trial = mask.copy()
+            trial[r, c] = False
+            if int(trial.sum()) < 5:
+                continue
+            if not _is_connected(trial):
+                continue
+            if not _has_interior(trial):
+                continue
+            mask = trial
+            removed += 1
