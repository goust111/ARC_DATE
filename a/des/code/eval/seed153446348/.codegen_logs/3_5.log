+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+BORDER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+GENERATE_MAX_RETRIES = 500
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _most_common(values: np.ndarray) -> int:
+    vals, counts = np.unique(values, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _tight_mask(coords: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(coords)
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    out[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return out
+
+
+def _shape_boundary(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    boundary = np.zeros_like(mask, dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            if r == 0 or r == h - 1 or c == 0 or c == w - 1:
+                boundary[r, c] = True
+                continue
+            for nr, nc in _neighbors4(r, c):
+                if not mask[nr, nc]:
+                    boundary[r, c] = True
+                    break
+    return boundary
+
+
+def _has_interior(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if mask[r, c] and all(mask[nr, nc] for nr, nc in _neighbors4(r, c)):
+                return True
+    return False
+
+
+def _transform(arr: np.ndarray, transform_id: int) -> np.ndarray:
+    out = np.array(arr, copy=True)
+    if transform_id >= 4:
+        out = np.fliplr(out)
+    out = np.rot90(out, transform_id % 4)
+    return np.array(out, copy=True)
