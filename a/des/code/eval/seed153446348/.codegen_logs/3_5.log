            pa_c1 = W - 1 - border_right
            pb_c0 = border_left
            pb_c1 = W - 1 - border_right
    else:
        offset_cols = random.randint(OFFSET_MIN, min(OFFSET_MAX, W - 2 * MIN_PANEL_DIM))
        if random.random() < 0.5:
            pa_c0 = border_left
            pa_c1 = W - 1 - border_right - offset_cols
