+        "inner_r0": int(r0 + 1),
+        "inner_c0": int(c0 + 1),
+        "inner_h": int(inner.shape[0]),
+        "inner_w": int(inner.shape[1]),
+        "area": int(inner.shape[0] * inner.shape[1]),
+        "pattern_top": int(pr0),
+        "pattern_left": int(pc0),
