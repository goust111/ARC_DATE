+def _can_place(occupied: np.ndarray, r0: int, c0: int, h: int, w: int) -> bool:
+    rows, cols = occupied.shape
+    r1 = r0 + h - 1
+    c1 = c0 + w - 1
+    rr0 = max(0, r0 - 1)
+    rr1 = min(rows - 1, r1 + 1)
+    cc0 = max(0, c0 - 1)
+    cc1 = min(cols - 1, c1 + 1)
+    return not bool(occupied[rr0 : rr1 + 1, cc0 : cc1 + 1].any())
