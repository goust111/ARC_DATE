+    rel = coords - np.array([r0, c0], dtype=int)
+    mask[rel[:, 0], rel[:, 1]] = True
+
+    expected = np.zeros((h, w), dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
