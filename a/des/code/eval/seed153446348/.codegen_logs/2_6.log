+def _render_output_from_spec(inp: np.ndarray, frame_specs: list[dict]) -> np.ndarray:
+    out = inp.copy()
+    for i in range(len(frame_specs) - 1):
+        _stamp_projection(out, frame_specs[i], frame_specs[i + 1])
+    return out
