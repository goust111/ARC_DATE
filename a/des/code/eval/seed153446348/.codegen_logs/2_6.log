+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            cells: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
