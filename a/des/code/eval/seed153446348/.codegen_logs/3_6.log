+def _output_range(shape: dict[str, object], grid_h: int, grid_w: int) -> tuple[int, int, int, int]:
+    dr, dc = _shift_from_direction(
+        str(shape["direction"]),
+        int(shape["height"]),
+        int(shape["width"]),
+    )
+    return (
+        int(dr),
+        int(grid_h - int(shape["height"]) + dr),
+        int(dc),
+        int(grid_w - int(shape["width"]) + dc),
+    )
