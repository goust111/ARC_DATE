+        band_c0 = clo + cspan // 4
+        band_c1 = chi - cspan // 4
+        if band_r0 <= band_r1:
+            rlo, rhi = band_r0, band_r1
+        if band_c0 <= band_c1:
+            clo, chi = band_c0, band_c1
