+        protected = {
+            (0, int(rng.integers(1, width - 1))),
+            (height - 1, int(rng.integers(1, width - 1))),
+            (int(rng.integers(1, height - 1)), 0),
+            (int(rng.integers(1, height - 1)), width - 1),
+        }
