+
+def _shift_from_direction(direction: str, height: int, width: int) -> tuple[int, int]:
+    if direction == "up":
+        return -width, 0
+    if direction == "down":
+        return width, 0
+    if direction == "left":
+        return 0, -height
+    assert direction == "right"
