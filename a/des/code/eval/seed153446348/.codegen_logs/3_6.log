+        objects.append(
+            {
+                "index": int(index),
+                "coords": [(int(r), int(c)) for r, c in comp],
+                "base_color": int(base_color),
+                "marker": (int(marker_r), int(marker_c)),
+                "direction": direction_hits[0],
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "height": int(height),
+                "width": int(width),
+                "area": int(len(comp)),
+            }
