+    for obj in sorted(objects, key=lambda item: (int(item["area"]), int(item["index"]))):
+        dr, dc = _shift_from_direction(
+            str(obj["direction"]),
+            int(obj["height"]),
+            int(obj["width"]),
+        )
+        color = int(obj["base_color"])
+        for r, c in obj["coords"]:
+            rr = int(r) + int(dr)
+            cc = int(c) + int(dc)
+            if 0 <= rr < h and 0 <= cc < w:
