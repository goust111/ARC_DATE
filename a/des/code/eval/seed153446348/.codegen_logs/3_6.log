+def _input_origin(shape: dict[str, object], out_r0: int, out_c0: int) -> tuple[int, int]:
+    dr, dc = _shift_from_direction(
+        str(shape["direction"]),
+        int(shape["height"]),
+        int(shape["width"]),
+    )
+    return int(out_r0 - dr), int(out_c0 - dc)
+
+
+def _visible_output_cells(
+    shape: dict[str, object],
+    out_r0: int,
+    out_c0: int,
+    grid_h: int,
+    grid_w: int,
+) -> set[tuple[int, int]]:
