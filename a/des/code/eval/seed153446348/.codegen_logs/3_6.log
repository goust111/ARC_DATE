+            blocked[
+                int(in_r0) : int(in_r0) + int(shape["height"]),
+                int(in_c0) : int(in_c0) + int(shape["width"]),
+            ] = True
+            placements[idx] = {
+                "input_origin": (int(in_r0), int(in_c0)),
+                "output_origin": (int(out_r0), int(out_c0)),
+                "output_bbox": (
+                    int(out_r0),
+                    int(out_c0),
+                    int(shape["height"]),
+                    int(shape["width"]),
