+            out_r0, out_c0 = origin
+            in_r0, in_c0 = _input_origin(shape, out_r0, out_c0)
+            if not _can_place_input_bbox(
+                blocked,
+                in_r0,
+                in_c0,
+                int(shape["height"]),
+                int(shape["width"]),
+            ):
