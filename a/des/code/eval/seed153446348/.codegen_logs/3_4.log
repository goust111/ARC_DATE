+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+FRAME_COLOR = 9
+TEMPLATE_LIBRARY = (
+    (".#.", "###", ".#.", ".##"),
+    ("..#..", ".###.", "..#..", ".##.."),
+    ("..#..", "#####", "...#.", "..##."),
+    (".#.", "###", "##.", ".#."),
+    ("..#..", ".###.", "..##.", "...#.", ".###."),
+    ("..#..", ".###.", ".#...", ".##.."),
+)
+CELL_SIZES = (5, 7)
+COLOR_POOL = (1, 2, 3, 4, 5, 6, 7, 8)
+ORIENTATION_TO_OFFSET = {
+    0: lambda s: (0, s // 2),
+    1: lambda s: (s // 2, s - 1),
+    2: lambda s: (s - 1, s // 2),
+    3: lambda s: (s // 2, 0),
