PRIORITY = ("up", "right", "down", "left")
DIRECTION_MODES = {
    "up": [("up",), ("up", "right"), ("up", "down"), ("up", "left")],
    "right": [("right",), ("right", "down"), ("right", "left")],
    "down": [("down",), ("down", "left")],
    "left": [("left",)],
}
MAX_GENERATE_ATTEMPTS = 300
