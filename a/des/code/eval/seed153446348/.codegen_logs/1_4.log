+    except AssertionError:
+        return False
+
+    if len(arrows) != len(expected_hit_color):
+        return False
+
+    cell_to_target: dict[tuple[int, int], int] = {}
+    for idx, target in enumerate(targets):
+        for cell in target["cells"]:
+            cell_to_target[cell] = idx
+
