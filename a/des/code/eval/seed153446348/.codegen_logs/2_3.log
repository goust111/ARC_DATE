+        bbox_b = _bbox(comps[1])
+        ha = bbox_a[2] - bbox_a[0] + 1
+        wa = bbox_a[3] - bbox_a[1] + 1
+        hb = bbox_b[2] - bbox_b[0] + 1
+        wb = bbox_b[3] - bbox_b[1] + 1
+        assert (ha, wa) == (hb, wb), "paired shapes must share bbox dimensions"
