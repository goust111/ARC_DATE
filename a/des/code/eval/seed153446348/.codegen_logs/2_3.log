+        top_sum = bbox_a[0] + bbox_b[0]
+        left_sum = bbox_a[1] + bbox_b[1]
+        assert top_sum % 2 == 0 and left_sum % 2 == 0, "midpoint must align to the grid"
+        top = top_sum // 2
+        left = left_sum // 2
+        assert 0 <= top and top + ha <= g.shape[0]
+        assert 0 <= left and left + wa <= g.shape[1]
