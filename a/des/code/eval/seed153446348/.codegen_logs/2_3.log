+    max_fill = min(h * w, max(int(np.ceil(0.75 * h * w)), int(mask.sum())))
+    target = int(rng.integers(int(mask.sum()), max_fill + 1))
+    while int(mask.sum()) < target:
+        frontier = [
+            (r, c)
+            for r in range(h)
+            for c in range(w)
+            if not mask[r, c] and any(mask[nr, nc] for nr, nc in _neighbors4(r, c, h, w))
