+    for idx, order_idx in enumerate(order):
+        row = legend_top + 1 + 2 * idx
+        color = colors[int(order_idx)]
+        mode = modes[int(order_idx)]
+        grid[row, legend_left + 1 : legend_left + 1 + mode] = color
