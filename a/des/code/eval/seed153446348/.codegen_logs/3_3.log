+                                | ((grid == color_b) & expect_a)
+                            )
+                        )
+                    )
+                    matches = coverage - mismatch
+                    score = (mismatch == 0, matches, -mismatch, cell_size)
+                    if best_score is None or score > best_score:
+                        best_score = score
+                        best_params = (cell_size, row_phase, col_phase, flip, mismatch)
