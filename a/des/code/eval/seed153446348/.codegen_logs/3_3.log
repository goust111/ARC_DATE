+import itertools
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+COLOR_POOL = tuple(range(1, 10))
+CELL_SIZE_CHOICES = (2, 3)
+GRID_SIDE_RANGE = (18, 28)
+OCCLUDER_COLOR_COUNT_RANGE = (2, 4)
+OCCLUDER_COUNT_RANGE = (3, 6)
+RECT_CELLS_MIN = 1
+RECT_CELLS_MAX = 3
