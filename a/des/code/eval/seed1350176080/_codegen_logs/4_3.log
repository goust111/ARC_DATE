+UP = (-1, 0)
+RIGHT = (0, 1)
+DOWN = (1, 0)
+LEFT = (0, -1)
+DIRS = [UP, RIGHT, DOWN, LEFT]
+ROT_CW = {UP: RIGHT, RIGHT: DOWN, DOWN: LEFT, LEFT: UP}
