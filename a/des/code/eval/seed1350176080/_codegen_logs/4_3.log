+GRID_MIN = 24
+GRID_MAX = 34
+SEED_COUNT_CHOICES = [2, 3]
+MIRROR_COUNT_CHOICES = [1, 2, 3, 4]
+MAX_GENERATION_ATTEMPTS = 500
