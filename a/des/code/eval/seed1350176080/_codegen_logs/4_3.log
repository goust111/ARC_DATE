+def _find_seeds(grid: np.ndarray, bg: int, mirror_color: int) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    seeds: list[tuple[int, int]] = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            center = int(grid[r, c])
+            if center in (bg, mirror_color):
