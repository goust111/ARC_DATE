+
+def _region_patches(
+    rng: np.random.Generator, tile: np.ndarray, count: int
+) -> tuple[np.ndarray, np.ndarray]:
+    inner_h = int(rng.integers(4, 9))
+    inner_w = int(rng.integers(4, 11))
