+    if c0 - 1 >= 0:
+        probe_cols.append((0, c0 - 1))
+    if c0 + 1 < w:
+        probe_cols.append((1, c0 + 1))
+
+    for priority, col in probe_cols:
+        for sr in range(max(0, r0 - 1), min(h, r0 + 5)):
+            color = int(g[sr, col])
+            if color in (BLACK, GREY):
