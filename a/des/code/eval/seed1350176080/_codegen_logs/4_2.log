def _gen_marker_jobs(colors: list[int], rng: np.random.Generator) -> list[tuple[int, int]] | None:
    row_options = [_gen_valid_rows(color) for color in colors]
    choices: list[tuple[tuple[int, ...], list[tuple[int, int]]]] = []

    if len(colors) == 1:
