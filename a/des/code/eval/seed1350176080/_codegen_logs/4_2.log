+    free_c0: int,
+    rng: np.random.Generator,
+) -> bool:
+    h, w = inp.shape
+    free_r1 = h - 2
+    free_c1 = w - 2
+    order = sorted(
+        range(len(patches)),
+        key=lambda idx: patches[idx][0].shape[0] * patches[idx][0].shape[1],
+        reverse=True,
