def _gen_attempt() -> np.ndarray | None:
    rng = np.random.default_rng()

    marker_count = int(rng.integers(*_GEN_MARKER_COUNT_RANGE))
    active = list(rng.choice(_GEN_GLYPH_COLORS, size=marker_count + 1, replace=False))
