+        inp[box_r + 1 : box_r + 1 + count, left_margin] = marker_color
+        out[box_r + 1 : box_r + 1 + count, left_margin] = marker_color
+        legend_right = max(legend_right, box_c + box.shape[1] - 1)
+        current = box_r + box.shape[0]
+        if idx < len(gaps):
+            current += gaps[idx]
