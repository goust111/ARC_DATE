+        count = len(boundary_colors)
+        assert count in patterns
+        tile = patterns[count]
+        th, tw = tile.shape
+        rr0, cc0, _rr1, _cc1 = _bbox(comp)
+        for r0, c0 in comp_set:
+            out[r0, c0] = int(tile[(r0 - rr0) % th, (c0 - cc0) % tw])
