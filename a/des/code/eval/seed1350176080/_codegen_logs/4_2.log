+def _sample_box(tile: np.ndarray) -> np.ndarray:
+    interior = np.tile(tile, (2, 2))
+    h, w = interior.shape
+    box = np.full((h + 2, w + 2), BLACK, dtype=int)
+    box[0, :] = GREY
+    box[-1, :] = GREY
+    box[:, 0] = GREY
+    box[:, -1] = GREY
