+    edge_count = sum(len(v) for v in graph.values()) // 2
+    assert edge_count == len(nodes) - 1, "pipe network must be a tree"
+    assert all(1 <= len(v) <= 4 for v in graph.values()), "pipe degrees must stay within orthogonal limits"
+    return graph
