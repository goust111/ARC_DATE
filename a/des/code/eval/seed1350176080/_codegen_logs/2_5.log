+def _flip_cells(
+    cells: set[tuple[int, int]],
+    h: int,
+    w: int,
+    flip_ud: bool,
+    flip_lr: bool,
+) -> set[tuple[int, int]]:
+    out = set()
+    for r, c in cells:
