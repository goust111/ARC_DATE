+def _build_pipe_graph(mask: np.ndarray) -> dict[tuple[int, int], set[tuple[int, int]]]:
+    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    assert coords, "expected pipe pixels"
+    nodes = set(coords)
+    graph = {node: set() for node in nodes}
+    for r, c in nodes:
+        for dr, dc in DIR4:
+            nbr = (r + dr, c + dc)
+            if nbr in nodes:
