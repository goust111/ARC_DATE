+
+    flip_ud = random.random() < 0.5
+    flip_lr = random.random() < 0.5
+    if flip_ud:
+        grid = np.flipud(grid)
+        expected = np.flipud(expected)
+    if flip_lr:
+        grid = np.fliplr(grid)
+        expected = np.fliplr(expected)
+
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
