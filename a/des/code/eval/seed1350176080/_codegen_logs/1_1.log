+    seeds: dict[tuple[int, int], int] = {}
+
+    counts = Counter(int(value) for value in grid.ravel())
+    for color, count in counts.items():
+        if color == bg:
+            continue
+        coords = np.argwhere(grid == color)
+        if count == 2:
+            a = tuple(map(int, coords[0]))
+            b = tuple(map(int, coords[1]))
