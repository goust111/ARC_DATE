+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
