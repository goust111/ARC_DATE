+def _mask_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    h, w = mask.shape
+    start = tuple(map(int, coords[0]))
+    seen = {start}
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for rr, cc in _neighbors4(r, c, h, w):
+            if not mask[rr, cc] or (rr, cc) in seen:
