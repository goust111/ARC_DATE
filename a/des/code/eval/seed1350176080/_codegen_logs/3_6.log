+def _cells_connected(cells: set[tuple[int, int]]) -> bool:
+    if not cells:
+        return False
+    start = next(iter(cells))
+    seen = {start}
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for rr, cc in ((r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)):
+            if (rr, cc) in cells and (rr, cc) not in seen:
+                seen.add((rr, cc))
+                q.append((rr, cc))
+    return len(seen) == len(cells)
