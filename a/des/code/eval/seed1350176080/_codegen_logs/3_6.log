+
+
+def _partition_template(mask: np.ndarray, n_regions: int) -> list[set[tuple[int, int]]] | None:
+    for _ in range(PARTITION_RETRIES):
+        regions = _grow_partition(mask, n_regions)
+        if regions is None:
+            continue
+        if _valid_partition(mask, regions):
