+    fg_coords = np.argwhere(g == fg)
+    assert len(fg_coords) > 0, "expected foreground pixels"
+    r0 = int(fg_coords[:, 0].min())
+    r1 = int(fg_coords[:, 0].max())
+    assert marker_row == r0 - 1, "markers must sit directly above the copies"
