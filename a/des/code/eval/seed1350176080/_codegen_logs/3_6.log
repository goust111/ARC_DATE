+
+        patch = grid[row0 : row0 + h, c0 : c0 + w]
+        patch[copy] = fg
+
+        center = c0 + w // 2
+        centers.append(center)
+        grid[row0 - 1, center] = marker_colors[idx]
+        c0 += w + (gaps[idx] if idx < len(gaps) else 0)
+
+    return grid
+
