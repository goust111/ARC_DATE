+# --------------- generator ---------------
+
+PALETTE = tuple(range(10))
+COPY_COUNT_CHOICES = (2, 3, 4)
+HEIGHT_RANGE = (5, 8)
+WIDTH_CHOICES = (5, 7, 9)
+GAP_RANGE = (1, 3)
+TOP_MARGIN_RANGE = (0, 2)
+BOTTOM_MARGIN_RANGE = (0, 2)
+SIDE_MARGIN_RANGE = (0, 2)
