+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+
+INSTRUCTION_TO_TRANSFORM = {
+    RED: "hflip",
+    BLUE: "vflip",
+    GREEN: "cw",
+    YELLOW: "ccw",
+}
