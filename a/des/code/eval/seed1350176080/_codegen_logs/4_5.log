+    if transform == "hflip":
+        for r, c in coords:
+            out.add((height - 1 - int(r), int(c)))
+        return out
+    if transform == "vflip":
+        for r, c in coords:
+            out.add((int(r), width - 1 - int(c)))
+        return out
