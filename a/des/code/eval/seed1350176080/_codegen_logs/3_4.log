+
+    values, counts = np.unique(grid, return_counts=True)
+    freq = {int(v): int(c) for v, c in zip(values, counts, strict=False)}
+    bg_count = freq.pop(bg, 0)
+    if not freq or bg_count <= max(freq.values()):
+        return None
+
+    main(grid)
+    return grid
