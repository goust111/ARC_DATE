+        r0 = random.randint(0, h - ph)
+        c0 = random.randint(0, w - pw)
+        r_lo = max(0, r0 - 1)
+        r_hi = min(h, r0 + ph + 1)
+        c_lo = max(0, c0 - 1)
+        c_hi = min(w, c0 + pw + 1)
+        if blocked[r_lo:r_hi, c_lo:c_hi].any():
+            continue
+        grid[r0 : r0 + ph, c0 : c0 + pw] = patch
+        blocked[r_lo:r_hi, c_lo:c_hi] = True
+        return True
+    return False
