+    if not np.array_equal(patch, _reflect(patch, axis)):
+        return None
+
+    unique_axis_cells = [cell for cell in axis_fg_cells if counts.get(int(patch[cell]), 0) == 1]
+    if len(unique_axis_cells) == 1:
