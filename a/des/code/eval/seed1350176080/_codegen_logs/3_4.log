+    inconsistent: list[list[tuple[int, int]]] = []
+    axis_fg_cells: list[tuple[int, int]] = []
+    seen: set[tuple[tuple[int, int], tuple[int, int]]] = set()
+    h, w = patch.shape
+
+    for r in range(h):
+        for c in range(w):
+            mr, mc = _mirror_pos(r, c, patch.shape, axis)
+            a = (r, c)
+            b = (mr, mc)
+            key = (a, b) if a <= b else (b, a)
