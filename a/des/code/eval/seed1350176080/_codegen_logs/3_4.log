+        w = random.choice(ODD_PATCH_SIZES if branch == "delete" else PATCH_SIZE_CHOICES)
+    else:
+        h = random.choice(ODD_PATCH_SIZES if branch == "delete" else PATCH_SIZE_CHOICES)
+        w = random.choice(PATCH_SIZE_CHOICES)
+    return h, w
