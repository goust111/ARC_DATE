+
+def _axis_cells(shape: tuple[int, int], axis: str) -> list[tuple[int, int]]:
+    h, w = shape
+    if axis == "vertical":
+        if w % 2 == 0:
+            return []
+        return [(r, w // 2) for r in range(h)]
