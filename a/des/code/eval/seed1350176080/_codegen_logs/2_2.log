+
+def _random_shape() -> np.ndarray:
+    if random.random() < 0.5:
+        return np.rot90(random.choice(SYMMETRIC_MASKS), random.randrange(4)).copy()
+
+    for _ in range(100):
+        area = random.randint(4, 7)
+        height = random.randint(2, 4)
+        width = random.randint(2, 4)
