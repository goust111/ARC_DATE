+    for _ in range(250):
+        side = random.choice(SIDES)
+        if side == "top":
+            r_lo, r_hi = 1, tr0 - ph - 1
+            c_lo, c_hi = 1, w - pw - 1
+        elif side == "bottom":
+            r_lo, r_hi = tr1 + 2, h - ph - 1
+            c_lo, c_hi = 1, w - pw - 1
+        elif side == "left":
