+    h, w = mask.shape
+    min_r = min(0, red_rel[0])
+    max_r = max(h - 1, red_rel[0])
+    min_c = min(0, red_rel[1])
+    max_c = max(w - 1, red_rel[1])
+    patch = np.full((max_r - min_r + 1, max_c - min_c + 1), int(bg), dtype=int)
+    for r in range(h):
+        for c in range(w):
+            if bool(mask[r, c]):
