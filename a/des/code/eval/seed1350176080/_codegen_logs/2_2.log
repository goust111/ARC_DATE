+        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in cells):
+            continue
+        cell_set = set(cells)
+        boundary: set[tuple[int, int]] = set()
+        valid = True
+        for r, c in cells:
+            for dr, dc in DIRS4:
+                nr, nc = r + dr, c + dc
+                if (nr, nc) in cell_set:
+                    continue
