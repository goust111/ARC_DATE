+
+def _build_piece_patch(mask: np.ndarray, color: int, marker_abs: tuple[int, int], hole_bbox: tuple[int, int, int, int], bg: int) -> np.ndarray:
+    hr0, hc0, _hr1, _hc1 = hole_bbox
