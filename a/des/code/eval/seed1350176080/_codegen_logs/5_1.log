+    group_ids = [0] * len(values)
+    group_count = 0
+    last_value = None
+    for idx in order:
+        v = values[idx]
+        if last_value is None or v - last_value > tol:
+            group_count += 1
+        group_ids[idx] = group_count - 1
+        last_value = v
+    return group_ids, group_count
