+    if sc == c0 + 1 and r0 + 1 < sr < r1 - 1:
+        directions.append((0, -1))
+    if sc == c1 - 1 and r0 + 1 < sr < r1 - 1:
+        directions.append((0, 1))
+    if len(directions) != 1:
+        return None
+    return directions[0]
+
+
+def _marker_positions(
+    bbox: tuple[int, int, int, int],
+    side: str,
+) -> list[tuple[int, int]]:
