+        return [(r, c0 + 1) for r in range(r0 + 2, r1 - 1)]
+    return [(r, c1 - 1) for r in range(r0 + 2, r1 - 1)]
+
+
+def _side_capacity(height: int, width: int, side: str) -> int:
