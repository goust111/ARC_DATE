+def _is_rectangular_frame(coords: list[tuple[int, int]]) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    if height < 5 or width < 5:
+        return False
+    expected_area = 2 * (height + width) - 4
+    if len(coords) != expected_area:
