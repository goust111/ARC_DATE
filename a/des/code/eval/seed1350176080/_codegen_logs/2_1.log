+) -> tuple[int, int, int, int]:
+    return r0, c0, r0 + height - 1, c0 + width - 1
+
+
+def _seed_positions(bbox: tuple[int, int, int, int], side: str) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
