        "left": (0, -1),
        "right": (0, 1),
    }[direction]
    start_r, start_c = _ray_start(bbox, drdc)
    dr, dc = drdc
    return [(start_r + dr * k, start_c + dc * k) for k in range(length)]


def _expand_cells(cells: set[tuple[int, int]], shape: tuple[int, int]) -> set[tuple[int, int]]:
