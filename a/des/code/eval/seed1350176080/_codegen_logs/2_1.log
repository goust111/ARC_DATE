+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+GREY = 5
+COLORS = tuple(range(10))
+SIDES = ("top", "bottom", "left", "right")
+OUTER_SIZE_CHOICES = (5, 7, 9, 11)
+GEN_RETRY_LIMIT = 500
+OBJECT_RETRY_LIMIT = 400
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    mask = grid == int(color)
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    components: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or visited[r, c]:
+                continue
+            stack = [(r, c)]
+            visited[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not visited[nr, nc]:
+                        visited[nr, nc] = True
+                        stack.append((nr, nc))
+            components.append(comp)
+    return components
+
+
+def _is_rectangular_frame(coords: list[tuple[int, int]]) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    if height < 5 or width < 5:
+        return False
+    expected_area = 2 * (height + width) - 4
+    if len(coords) != expected_area:
+        return False
+    pts = set(coords)
+    for c in range(c0, c1 + 1):
+        if (r0, c) not in pts or (r1, c) not in pts:
+            return False
+    for r in range(r0 + 1, r1):
+        if (r, c0) not in pts or (r, c1) not in pts:
+            return False
+    return True
+
+
+def _seed_direction(
+    seed: tuple[int, int],
+    bbox: tuple[int, int, int, int],
+) -> tuple[int, int] | None:
+    sr, sc = seed
