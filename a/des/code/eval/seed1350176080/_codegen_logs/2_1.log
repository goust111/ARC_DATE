+GREY = 5
+COLORS = tuple(range(10))
+SIDES = ("top", "bottom", "left", "right")
+OUTER_SIZE_CHOICES = (5, 7, 9, 11)
+GEN_RETRY_LIMIT = 500
+OBJECT_RETRY_LIMIT = 400
