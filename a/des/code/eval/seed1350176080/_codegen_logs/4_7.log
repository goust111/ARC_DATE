+        placed = False
+        for _ in range(BAR_RETRIES):
+            r0 = _rand_int(OUTER_MARGIN, h - OUTER_MARGIN - bar_h)
+            c0 = _rand_int(OUTER_MARGIN, w - OUTER_MARGIN - bar_w)
