+            rr1 = min(h, r0 + bar_h + BAR_PAD)
+            cc0 = max(0, c0 - BAR_PAD)
+            cc1 = min(w, c0 + bar_w + BAR_PAD)
+            if reserve[rr0:rr1, cc0:cc1].any():
+                continue
