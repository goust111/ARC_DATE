+    leftovers = eligible[:]
+    _RNG.shuffle(leftovers)
+    for item in leftovers:
+        bar_id = id(item["bar"])
+        footprint = set(item["footprint"])
+        if bar_id in used_bars or blocked & footprint:
+            continue
+        chosen.append(item)
+        used_bars.add(bar_id)
+        blocked |= footprint
+        if len(chosen) == count:
