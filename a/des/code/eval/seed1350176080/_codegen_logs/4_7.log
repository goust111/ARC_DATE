+            {
+                "pos": (r, c),
+                "dir": (wall_r - r, wall_c - c),
+                "wall": (wall_r, wall_c),
+                "marker_color": marker_color,
+                "wall_color": wall_color,
+            }
+        )
+
+    return markers
+
+
+def _wall_thickness(grid: np.ndarray, wall: tuple[int, int], dr: int, dc: int) -> int:
+    h, w = grid.shape
+    r, c = wall
+    color = int(grid[r, c])
+    thickness = 0
+
+    while 0 <= r < h and 0 <= c < w and int(grid[r, c]) == color:
+        thickness += 1
+        r += dr
+        c += dc
