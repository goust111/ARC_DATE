+
+    return grid, bars
+
+
+def _site_ok(
+    grid: np.ndarray,
+    marker_pos: tuple[int, int],
+    wall_pos: tuple[int, int],
+    trace: list[tuple[int, int]],
+) -> bool:
+    h, w = grid.shape
+    mr, mc = marker_pos
