+def _same_color_component(
+    grid: np.ndarray,
+    start: tuple[int, int],
+    cache: dict[tuple[int, int], tuple[tuple[int, int], ...]],
+) -> tuple[tuple[int, int], ...]:
+    if start in cache:
+        return cache[start]
+
+    h, w = grid.shape
+    color = int(grid[start])
+    queue = deque([start])
+    seen = {start}
+    coords: list[tuple[int, int]] = []
+
+    while queue:
+        r, c = queue.popleft()
+        coords.append((r, c))
+        for rr, cc in _neighbors4(r, c, h, w):
+            if (rr, cc) in seen:
+                continue
+            if int(grid[rr, cc]) != color:
+                continue
+            seen.add((rr, cc))
+            queue.append((rr, cc))
+
+    component = tuple(coords)
+    for pos in component:
+        cache[pos] = component
+    return component
+
