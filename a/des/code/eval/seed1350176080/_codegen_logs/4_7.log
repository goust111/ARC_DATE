+                        "marker_pos": marker,
+                        "trace": tuple(trace),
+                        "footprint": frozenset([marker, *trace]),
+                    }
+                )
+
+            marker = (row, c0 + width)
+            wall = (row, c0 + width - 1)
+            trace = [(row, c0 - 1 - offset) for offset in range(thickness)]
+            if _site_ok(grid, marker, wall, trace):
+                sites.append(
+                    {
+                        "bar": bar,
+                        "marker_pos": marker,
+                        "trace": tuple(trace),
+                        "footprint": frozenset([marker, *trace]),
+                    }
+                )
+    else:
+        cols = list(range(c0 + 1, c0 + width - 1))
+        _RNG.shuffle(cols)
+        for col in cols:
+            marker = (r0 - 1, col)
+            wall = (r0, col)
+            trace = [(r0 + height + offset, col) for offset in range(thickness)]
+            if _site_ok(grid, marker, wall, trace):
+                sites.append(
+                    {
+                        "bar": bar,
+                        "marker_pos": marker,
+                        "trace": tuple(trace),
+                        "footprint": frozenset([marker, *trace]),
