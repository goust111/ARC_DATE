+    detected = _find_markers(grid)
+    if len(detected) != marker_count:
+        return None
+
+    out = main(grid)
+    if int(np.count_nonzero(out == YELLOW)) != expected_yellow:
+        return None
+
+    for site in sites:
+        mr, mc = site["marker_pos"]
+        if int(out[mr, mc]) != BLACK:
+            return None
+
+    return grid
