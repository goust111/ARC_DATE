+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+INPUT_COLORS = (1, 2, 3, 5, 6, 7, 8, 9)
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+_RNG = np.random.default_rng()
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    for dr, dc in DIR4:
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            yield rr, cc
+
+
+def _same_color_component(
+    grid: np.ndarray,
+    start: tuple[int, int],
+    cache: dict[tuple[int, int], tuple[tuple[int, int], ...]],
+) -> tuple[tuple[int, int], ...]:
+    if start in cache:
+        return cache[start]
+
+    h, w = grid.shape
+    color = int(grid[start])
+    queue = deque([start])
+    seen = {start}
+    coords: list[tuple[int, int]] = []
+
+    while queue:
+        r, c = queue.popleft()
+        coords.append((r, c))
+        for rr, cc in _neighbors4(r, c, h, w):
+            if (rr, cc) in seen:
+                continue
+            if int(grid[rr, cc]) != color:
+                continue
+            seen.add((rr, cc))
+            queue.append((rr, cc))
+
+    component = tuple(coords)
+    for pos in component:
+        cache[pos] = component
+    return component
+
+
+def _bbox(coords: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _is_same_color_marker(
+    component: tuple[tuple[int, int], ...],
+    pos: tuple[int, int],
+) -> bool:
+    if len(component) < 3:
+        return False
+
+    rest = [cell for cell in component if cell != pos]
+    r0, c0, r1, c1 = _bbox(rest)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+
+    if len(rest) != h * w:
+        return False
+    if min(h, w) not in (1, 2, 3):
+        return False
+    if h == w:
+        return False
+
+    or0, oc0, or1, oc1 = _bbox(component)
+    r, c = pos
+
+    if h > w:
+        return (
+            or0 == r0
+            and or1 == r1
+            and (oc1 - oc0 + 1) == w + 1
+            and r0 <= r <= r1
+            and c in (c0 - 1, c1 + 1)
+        )
+
+    return (
+        oc0 == c0
+        and oc1 == c1
+        and (or1 - or0 + 1) == h + 1
+        and c0 <= c <= c1
+        and r in (r0 - 1, r1 + 1)
+    )
+
+
+def _find_markers(grid: np.ndarray) -> list[dict[str, object]]:
+    h, w = grid.shape
+    comp_cache: dict[tuple[int, int], tuple[tuple[int, int], ...]] = {}
+    markers: list[dict[str, object]] = []
+
+    for r0, c0 in np.argwhere(grid != BLACK):
+        r = int(r0)
+        c = int(c0)
+        neighbors = [(rr, cc) for rr, cc in _neighbors4(r, c, h, w) if int(grid[rr, cc]) != BLACK]
+        if len(neighbors) != 1:
+            continue
