+        return None
+
+    for site in sites:
+        mr, mc = site["marker_pos"]
+        if int(out[mr, mc]) != BLACK:
+            return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid maze input")

