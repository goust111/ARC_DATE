+        trace_r = wall_r + dr * thickness
+        trace_c = wall_c + dc * thickness
+        for step in range(thickness):
+            rr = trace_r + dr * step
+            cc = trace_c + dc * step
+            if 0 <= rr < h and 0 <= cc < w:
