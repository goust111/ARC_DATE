+                        "bar": bar,
+                        "marker_pos": marker,
+                        "trace": tuple(trace),
+                        "footprint": frozenset([marker, *trace]),
+                    }
+                )
+
+            marker = (r0 + height, col)
+            wall = (r0 + height - 1, col)
+            trace = [(r0 - 1 - offset, col) for offset in range(thickness)]
+            if _site_ok(grid, marker, wall, trace):
+                sites.append(
+                    {
+                        "bar": bar,
