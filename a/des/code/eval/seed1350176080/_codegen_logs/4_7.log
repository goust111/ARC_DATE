+        cols = list(range(c0 + 1, c0 + width - 1))
+        _RNG.shuffle(cols)
+        for col in cols:
+            marker = (r0 - 1, col)
+            wall = (r0, col)
+            trace = [(r0 + height + offset, col) for offset in range(thickness)]
+            if _site_ok(grid, marker, wall, trace):
