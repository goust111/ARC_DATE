+
+    for _ in range(FRAGMENT_PLACEMENT_TRIES):
+        shape = _random_shape(rng)
+        sh, sw = _shape_dims(shape)
+        if open_side in ("up", "down"):
+            mouth_start = c0 + 2
+            mouth_len = (c1 - 1) - (c0 + 2) + 1
+            if sw > mouth_len:
+                continue
+            offsets = list(range(0, mouth_len - sw + 1))
+        else:
+            mouth_start = r0 + 2
+            mouth_len = (r1 - 1) - (r0 + 2) + 1
+            if sh > mouth_len:
