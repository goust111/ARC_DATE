+            gap = rng.randint(MIN_GAP, MAX_GAP)
+            if open_side == "up":
+                coords_in = _translate(shape, r0 - gap - sh, mouth_start + offset)
+            elif open_side == "down":
+                coords_in = _translate(shape, r1 + gap + 1, mouth_start + offset)
+            elif open_side == "left":
+                coords_in = _translate(shape, mouth_start + offset, c0 - gap - sw)
+            else:
