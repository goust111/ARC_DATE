+        bbox = (r0, c0, r1, c1)
+        wall_colors: dict[str, int] = {}
+        ok = True
+        for side in _closed_sides(open_side):
+            coords = _wall_coords(bbox, side)
+            vals = {int(grid[r, c]) for r, c in coords}
+            if len(vals) != 1:
+                ok = False
+                break
+            color = vals.pop()
+            if color in (BG, GREY):
