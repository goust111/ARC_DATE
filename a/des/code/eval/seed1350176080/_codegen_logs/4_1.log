+    zc0 = c0 - 1 - (OUTSIDE_DEPTH if open_side == "left" else 0)
+    zr1 = r1 + 1 + (OUTSIDE_DEPTH if open_side == "down" else 0)
+    zc1 = c1 + 1 + (OUTSIDE_DEPTH if open_side == "right" else 0)
