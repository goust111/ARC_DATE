+    grid[:top_h, :] = top
+    grid[top_h, :] = GREY
+
+    expected = grid.copy()
+    expected[top_h + 1 : top_h + 1 + fh, :fw] = folded
+
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
