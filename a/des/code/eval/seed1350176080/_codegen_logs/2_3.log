+
+def _pattern_choices(size: int, a: int, b: int) -> list[np.ndarray]:
+    if size == 2:
+        return [
+            np.array([[a, b], [b, a]], dtype=int),
+            np.array([[a, b], [a, b]], dtype=int),
+            np.array([[a, a], [b, b]], dtype=int),
+            np.array([[a, a], [a, b]], dtype=int),
+            np.array([[a, b], [b, b]], dtype=int),
