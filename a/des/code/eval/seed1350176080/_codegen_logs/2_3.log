+        np.array([[a, b, a], [a, b, a], [a, b, a]], dtype=int),
+        np.array([[a, a, a], [b, b, b], [a, a, a]], dtype=int),
+        base_l,
+        np.rot90(base_l, 1),
+        np.rot90(base_l, 2),
+        np.rot90(base_l, 3),
