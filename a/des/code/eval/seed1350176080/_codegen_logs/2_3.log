+        for r, c in comp:
+            for dr, dc in ORTHOGONAL_STEPS:
+                nr = r + dr
+                nc = c + dc
+                if 0 <= nr < h and 0 <= nc < w and border_owner[nr, nc] >= 0:
+                    touched.add(int(border_owner[nr, nc]))
+        if len(touched) != 2:
