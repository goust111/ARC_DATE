+    return lines
+
+
+def _tile_pattern(pattern: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    ph, pw = pattern.shape
+    rows = np.arange(h)[:, None] % ph
+    cols = np.arange(w)[None, :] % pw
+    return pattern[rows, cols]
