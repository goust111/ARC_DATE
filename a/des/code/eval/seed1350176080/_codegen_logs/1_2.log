+        piece_mask = np.rot90(_tight_mask(hole["mask"]), piece_rotations[i])
+        hole_specs.append(
+            {
+                "mask": oriented_hole,
+                "top": hole["top"],
+                "left": hole["left"],
+                "color": colors[i],
+            }
+        )
+        piece_specs.append({"mask": piece_mask, "color": colors[i]})
+
+    holes = _place_holes(board_h, board_w, [spec["mask"] for spec in hole_specs])
+    if holes is None:
+        return None
+
+    piece_specs = [{"mask": piece_specs[i]["mask"], "color": colors[i]} for i in range(hole_count)]
+    piece_placements = _place_pieces(grid_h, grid_w, board_bbox, piece_specs)
+    if piece_placements is None:
+        return None
+
+    grid = np.full((grid_h, grid_w), BLACK, dtype=int)
+    expected = np.full((grid_h, grid_w), BLACK, dtype=int)
+
+    br0, bc0, br1, bc1 = board_bbox
+    grid[br0 : br1 + 1, bc0 : bc1 + 1] = BOARD_COLOR
+    expected[br0 : br1 + 1, bc0 : bc1 + 1] = BOARD_COLOR
