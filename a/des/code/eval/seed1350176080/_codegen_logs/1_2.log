+def _touches_or_near(existing: set[tuple[int, int]], coords: list[tuple[int, int]]) -> bool:
+    if not existing:
+        return False
+    for r, c in coords:
+        for er, ec in existing:
+            if max(abs(r - er), abs(c - ec)) <= 1:
