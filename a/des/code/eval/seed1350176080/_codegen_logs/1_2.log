+        for _ in range(PIECE_PLACEMENT_RETRIES):
+            top = int(_RNG.integers(0, grid_h - h + 1))
+            left = int(_RNG.integers(0, grid_w - w + 1))
+            translated = [(top + r, left + c) for r, c in coords_local]
+            if any(blocked[r, c] for r, c in translated):
