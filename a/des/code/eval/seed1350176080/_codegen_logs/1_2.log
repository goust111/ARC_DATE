+    variants: list[np.ndarray] = []
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    for k in range(4):
+        rot = _tight_mask(np.rot90(mask, k))
+        key = (tuple(map(int, rot.shape)), rot.tobytes())
+        if key in seen:
