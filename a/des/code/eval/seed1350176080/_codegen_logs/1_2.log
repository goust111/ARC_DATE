+
+def _sample_distinct_shapes(count: int) -> list[np.ndarray] | None:
+    shapes = []
+    keys = set()
+    for _ in range(count * SHAPE_RETRIES):
+        area = int(_RNG.integers(HOLE_AREA_RANGE[0], HOLE_AREA_RANGE[1]))
+        shape = _random_shape(area)
+        if shape is None:
