+    board_pixels = int((grid == BOARD_COLOR).sum())
+    piece_totals = Counter(int(color) for color in colors)
+    if any(board_pixels <= total * max(int(spec["mask"].sum()) for spec in piece_specs) for total in piece_totals.values()):
+        return None
+    if _largest_non_black_color(grid) != BOARD_COLOR:
+        return None
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid, expected
