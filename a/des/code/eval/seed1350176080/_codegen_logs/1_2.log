+def _cells_to_mask(cells: set[tuple[int, int]]) -> np.ndarray:
+    norm = _normalize_cells(cells)
+    h = max(r for r, _ in norm) + 1
+    w = max(c for _, c in norm) + 1
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in norm:
+        mask[r, c] = True
+    return mask
