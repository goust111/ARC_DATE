+    best_score: tuple[int, int, int, int, int, int] | None = None
+    best_mask: np.ndarray | None = None
+    for bits in range(1 << len(tie_orbits)):
+        repaired = base.copy()
+        for i, orbit in enumerate(tie_orbits):
+            if (bits >> i) & 1:
