+
+def _transform_cell(r: int, c: int, shape: tuple[int, int], symmetry: str) -> tuple[int, int]:
+    h, w = shape
+    if symmetry == HORIZONTAL:
+        return h - 1 - r, c
+    if symmetry == VERTICAL:
+        return r, w - 1 - c
+    assert symmetry == ROT90
+    return c, h - 1 - r
