+            r0_hi = min(region.shape[0] - 1, br0 + SEARCH_PAD)
+            c0_lo = max(0, bc0 - SEARCH_PAD)
+            c0_hi = min(region.shape[1] - 1, bc0 + SEARCH_PAD)
+            for sr0 in range(r0_lo, r0_hi + 1):
