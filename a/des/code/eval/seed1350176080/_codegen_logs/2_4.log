+import numpy as np
+
+
+HORIZONTAL = "horizontal"
+VERTICAL = "vertical"
+ROT90 = "rot90"
+SYMMETRIES = (HORIZONTAL, VERTICAL, ROT90)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+SEARCH_PAD = 2
+MAX_ENUM_TIES = 10
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    colors, counts = np.unique(grid, return_counts=True)
+    return int(colors[np.argmax(counts)])
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    (r0, c0), (r1, c1) = coords.min(axis=0), coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop(mask: np.ndarray) -> np.ndarray:
+    box = _bbox(mask)
+    assert box is not None
+    r0, c0, r1, c1 = box
+    return mask[r0 : r1 + 1, c0 : c1 + 1]
+
+
+def _touches_all_edges(mask: np.ndarray) -> bool:
+    return bool(mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any())
+
+
+def _component_count(mask: np.ndarray) -> int:
+    if not mask.any():
+        return 0
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    count = 0
+    coords = np.argwhere(mask)
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        if seen[rr, cc]:
+            continue
+        count += 1
+        seen[rr, cc] = True
+        stack = [(rr, cc)]
+        while stack:
+            cr, cc = stack.pop()
+            for dr, dc in DIR4:
+                nr = cr + dr
+                nc = cc + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+    return count
+
+
+def _perimeter(mask: np.ndarray) -> int:
+    mask = np.asarray(mask, dtype=bool)
+    per = int(mask[0].sum() + mask[-1].sum() + mask[:, 0].sum() + mask[:, -1].sum())
+    per += int(np.sum(mask[1:, :] != mask[:-1, :]))
+    per += int(np.sum(mask[:, 1:] != mask[:, :-1]))
+    return per
+
