+
+def _paint_template(canvas: np.ndarray, top: int, left: int, interior: np.ndarray, color: int) -> None:
+    h, w = map(int, interior.shape)
+    patch = canvas[top : top + h + 2, left : left + w + 2]
+    patch[0, :] = int(color)
+    patch[-1, :] = int(color)
+    patch[:, 0] = int(color)
+    patch[:, -1] = int(color)
+    patch[1:-1, 1:-1] = interior
