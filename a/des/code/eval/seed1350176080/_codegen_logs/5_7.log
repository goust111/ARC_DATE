+        mask = np.ones((h, w), dtype=bool)
+        while int(mask.sum()) > target:
+            cells = [(r, c) for r in range(h) for c in range(w) if mask[r, c]]
+            random.shuffle(cells)
+            removed = False
+            for r, c in cells:
+                mask[r, c] = False
+                if _is_connected(mask) and _full_bbox(mask):
+                    removed = True
+                    break
+                mask[r, c] = True
+            if not removed:
