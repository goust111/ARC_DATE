+        base_c = pad_left + slot_c * (ZONE_SIZE + col_gap)
+        target_r = base_r + random.choice(TARGET_LOCAL_CHOICES)
+        target_c = base_c + random.choice(TARGET_LOCAL_CHOICES)
+        target_cells = [
+            (target_r, target_c),
+            (target_r, target_c + 1),
+            (target_r + 1, target_c),
+            (target_r + 1, target_c + 1),
