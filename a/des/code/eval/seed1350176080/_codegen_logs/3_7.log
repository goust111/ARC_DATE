+ARROW_SIGNATURES = _arrow_signatures()
+
+
+def _is_target_block(comp: dict[str, object]) -> bool:
+    if int(comp["area"]) != 4:
+        return False
+    r0, c0, r1, c1 = comp["bbox"]
+    return (r1 - r0 + 1) == 2 and (c1 - c0 + 1) == 2
+
+
