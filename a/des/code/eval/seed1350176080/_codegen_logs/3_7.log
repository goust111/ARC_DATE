            hits = _visible_source_ids(g, bg, source_ids, range(r0, r1 + 1), side_col, dc)
            if hits:
                assert len(set(hits)) == 1, "one side must see at most one source region"
                side_hits.append((len(hits), side))

        if side_hits:
