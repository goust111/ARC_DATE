+                continue
+            idx = len(comps)
+            q = deque([(r, c)])
+            labels[r, c] = idx
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((int(cr), int(cc)))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if bool(mask[nr, nc]) and int(labels[nr, nc]) == -1:
