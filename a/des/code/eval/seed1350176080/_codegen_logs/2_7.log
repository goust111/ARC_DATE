+def _label_components(mask: np.ndarray) -> tuple[np.ndarray, list[list[tuple[int, int]]]]:
+    h, w = mask.shape
+    labels = np.full((h, w), -1, dtype=int)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
