+                                ok = False
+                                break
+                            door_count += 1
+                        elif left == border:
+                            border_count += 1
+                        else:
+                            ok = False
+                            break
+
+                        if right == bg:
+                            if int(grid[r - 1, c1]) != border or int(grid[r + 1, c1]) != border:
+                                ok = False
+                                break
+                            door_count += 1
