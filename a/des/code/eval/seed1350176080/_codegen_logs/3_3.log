+from __future__ import annotations
+
+from collections import Counter
+from dataclasses import dataclass, field
+import random
+
+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDE_TO_DIR = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+OPPOSITE_SIDE = {
+    "top": "bottom",
+    "bottom": "top",
+    "left": "right",
+    "right": "left",
+}
+ALL_SIDES = ("top", "bottom", "left", "right")
+
+GRID_MIN = 18
+GRID_MAX = 30
+ROOM_OUTER_RANGE = (4, 7)
+AXIS_COUNT_CHOICES = (2, 3)
+GAP_RANGE = (2, 5)
+ROOM_COUNT_RANGE = (3, 6)
+GEN_RETRIES = 400
+
+
+@dataclass
+class DoorSpec:
+    side: str
+    pos: int
+    kind: str
+    target: int | None = None
+
+
+@dataclass
+class RoomSpec:
+    r0: int
+    c0: int
+    r1: int
+    c1: int
+    marker_color: int
+    marker_pos: tuple[int, int]
+    doors: list[DoorSpec] = field(default_factory=list)
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _find_room_for_marker(
+    grid: np.ndarray,
+    bg: int,
+    border: int,
+    marker_comp: list[tuple[int, int]],
