+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDE_TO_DIR = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+OPPOSITE_SIDE = {
+    "top": "bottom",
+    "bottom": "top",
+    "left": "right",
+    "right": "left",
+}
+ALL_SIDES = ("top", "bottom", "left", "right")
+
+GRID_MIN = 18
+GRID_MAX = 30
+ROOM_OUTER_RANGE = (4, 7)
+AXIS_COUNT_CHOICES = (2, 3)
+GAP_RANGE = (2, 5)
+ROOM_COUNT_RANGE = (3, 6)
