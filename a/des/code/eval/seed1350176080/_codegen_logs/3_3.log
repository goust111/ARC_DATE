+        c0 = col_starts[col]
+        r1 = r0 + row_sizes[row] - 1
+        c1 = c0 + col_sizes[col] - 1
+        marker_r = rng.randint(r0 + 1, r1 - 1)
+        marker_c = rng.randint(c0 + 1, c1 - 1)
+        room = RoomSpec(
