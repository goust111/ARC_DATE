+def _ordered_pair(axis: str, a: tuple[int, int], b: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
+    if axis == "h":
+        return (a, b) if a[1] < b[1] else (b, a)
+    return (a, b) if a[0] < b[0] else (b, a)
