+def _steps_to_boundary(shape: tuple[int, int], source: tuple[int, int], axis: str, sign: int) -> int:
+    r, c = source
+    if axis == "h":
+        return r if sign < 0 else shape[0] - 1 - r
+    return c if sign < 0 else shape[1] - 1 - c
