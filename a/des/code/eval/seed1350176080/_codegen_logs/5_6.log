+    valid_color_counts = [count for count in range(1, min(3, total_pairs) + 1) if total_pairs <= 2 * count]
+    num_colors = random.choice(valid_color_counts)
+    colors = random.sample(SEED_COLORS, num_colors)
+    counts = [1] * num_colors
