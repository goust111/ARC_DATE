+) -> tuple[int, int, str] | None:
+    sr, sc = start
+    pr, pc = partner
+    if sr == pr:
+        axis = "h"
+        step_r, step_c = 0, 1 if sc < pc else -1
+    else:
+        assert sc == pc
+        axis = "v"
+        step_r, step_c = 1 if sr < pr else -1, 0
