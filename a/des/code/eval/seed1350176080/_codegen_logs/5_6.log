+
+def _corridor_sources(pair: dict) -> list[tuple[int, int]]:
+    if pair["obstacle"] is None:
+        return []
+    axis = pair["axis"]
+    obs_r, obs_c = pair["obstacle"]
+    if axis == "h":
+        return [(obs_r, obs_c - 1), (obs_r, obs_c + 1)]
+    return [(obs_r - 1, obs_c), (obs_r + 1, obs_c)]
