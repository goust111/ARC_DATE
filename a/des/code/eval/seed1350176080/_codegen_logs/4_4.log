+                "branch": spec["branch"],
+                "color": spec["color"],
+                "hole_mask": spec["hole_mask"],
+                "hole_coords": [(top + int(r), left + int(c)) for r, c in hole_local],
+                "grey_coords": [(top + int(r), left + int(c)) for r, c in grey_local],
