+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+COLOR_TO_LIGHT = {
+    1: 8,  # blue -> azure
+    2: 7,  # red -> orange
+    3: 4,  # green -> yellow
+    6: 9,  # magenta -> maroon
+}
+KEY_COLORS = tuple(COLOR_TO_LIGHT.keys())
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_H_RANGE = (20, 30)
+GRID_W_RANGE = (22, 32)
+NUM_LOCKS_RANGE = (2, 4)
+LOCK_MARGIN_RANGE = (1, 3)
