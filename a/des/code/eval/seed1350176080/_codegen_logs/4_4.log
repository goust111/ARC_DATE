+
+def _mark_rect(mask: np.ndarray, top: int, left: int, height: int, width: int, pad: int) -> None:
+    h, w = mask.shape
+    r0 = max(0, top - pad)
+    c0 = max(0, left - pad)
+    r1 = min(h, top + height + pad)
+    c1 = min(w, left + width + pad)
+    mask[r0:r1, c0:c1] = True
+
+
+def _candidate_positions(
