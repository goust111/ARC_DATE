+
+def _rect_is_free(mask: np.ndarray, top: int, left: int, height: int, width: int, pad: int) -> bool:
+    h, w = mask.shape
+    r0 = max(0, top - pad)
+    c0 = max(0, left - pad)
+    r1 = min(h, top + height + pad)
+    c1 = min(w, left + width + pad)
+    return not bool(mask[r0:r1, c0:c1].any())
