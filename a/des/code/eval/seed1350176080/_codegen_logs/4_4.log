+
+def _coords_to_mask(coords) -> np.ndarray:
+    pts = [(int(r), int(c)) for r, c in coords]
+    max_r = max(r for r, _ in pts)
+    max_c = max(c for _, c in pts)
+    mask = np.zeros((max_r + 1, max_c + 1), dtype=bool)
+    for r, c in pts:
