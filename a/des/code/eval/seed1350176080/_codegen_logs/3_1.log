+    forbidden[0, :] = True
+    forbidden[-1, :] = True
+    forbidden[:, 0] = True
+    forbidden[:, -1] = True
+
+    used_shape_keys = set()
+    holes: list[dict] = []
+
+    for hole_index in range(int(n_holes)):
