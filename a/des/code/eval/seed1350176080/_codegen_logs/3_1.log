+def _random_polyomino(area: int, max_span: int = 4, tries: int = 80) -> np.ndarray | None:
+    for _ in range(int(tries)):
+        cells = {(0, 0)}
+        while len(cells) < int(area):
+            frontier = set()
+            for r, c in cells:
