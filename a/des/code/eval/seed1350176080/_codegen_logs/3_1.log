+def _build_colored_patch(
+    mask: np.ndarray,
+    subset: tuple[tuple[int, int], ...],
+    major_color: int,
+    minor_color: int,
+) -> np.ndarray:
+    patch = np.zeros(mask.shape, dtype=int)
+    patch[mask] = int(major_color)
+    for r, c in subset:
+        patch[int(r), int(c)] = int(minor_color)
+    return patch
+
