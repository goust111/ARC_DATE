+    order = sorted(
+        range(len(holes)),
+        key=lambda idx: (
+            len(holes[idx]["candidates"]),
+            -int(holes[idx]["area"]),
+            int(holes[idx]["top"]),
+            int(holes[idx]["left"]),
+        ),
+    )
+    used: set[int] = set()
+    assignment: dict[int, dict] = {}
+
+    def search(k: int) -> bool:
+        if int(k) == len(order):
+            return True
+        hole_index = int(order[k])
+        candidates = sorted(
+            holes[hole_index]["candidates"],
+            key=lambda cand: (
+                -cand["score"][0],
+                -cand["score"][1],
+                int(cand["piece"]),
+            ),
+        )
+        for cand in candidates:
+            piece_index = int(cand["piece"])
+            if piece_index in used:
