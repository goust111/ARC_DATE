+def _rects_overlap_with_gap(
+    a: tuple[int, int, int, int],
+    b: tuple[int, int, int, int],
+    gap: int = 1,
+) -> bool:
+    return not (
+        a[2] + int(gap) <= b[0]
+        or b[2] + int(gap) <= a[0]
+        or a[3] + int(gap) <= b[1]
+        or b[3] + int(gap) <= a[1]
+    )
