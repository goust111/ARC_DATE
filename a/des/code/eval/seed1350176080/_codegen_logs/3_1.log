+def _paste_mask(out: np.ndarray, patch: np.ndarray, top: int, left: int, mask: np.ndarray) -> None:
+    h, w = mask.shape
+    view = out[int(top) : int(top) + int(h), int(left) : int(left) + int(w)]
+    view[mask] = patch[mask]
