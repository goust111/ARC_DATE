+    for hole in holes:
+        candidates = []
+        for piece_index, piece in enumerate(pieces):
+            best_variant = None
+            best_score = None
+            for variant in piece["variants"]:
+                vm = variant["mask"]
+                if vm.shape != hole["mask"].shape or not np.array_equal(vm, hole["mask"]):
+                    continue
+                score = _orientation_score(
+                    variant["patch"],
+                    vm,
+                    int(hole["top"]),
