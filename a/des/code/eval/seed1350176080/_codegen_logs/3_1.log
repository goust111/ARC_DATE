+def _canonical_mask_key(mask: np.ndarray) -> tuple[int, int, bytes]:
+    keys = []
+    for k in range(4):
+        m = np.rot90(mask, k)
+        keys.append((int(m.shape[0]), int(m.shape[1]), m.tobytes()))
+        f = np.fliplr(m)
+        keys.append((int(f.shape[0]), int(f.shape[1]), f.tobytes()))
+    return min(keys)
