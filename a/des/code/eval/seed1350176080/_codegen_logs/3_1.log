+        rs = [r for r, _ in cells]
+        cs = [c for _, c in cells]
+        r0, c0 = min(rs), min(cs)
+        norm = sorted((int(r - r0), int(c - c0)) for r, c in cells)
+        h = max(r for r, _ in norm) + 1
+        w = max(c for _, c in norm) + 1
+        if h > int(max_span) or w > int(max_span):
