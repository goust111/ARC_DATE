+            -int(holes[idx]["area"]),
+            int(holes[idx]["top"]),
+            int(holes[idx]["left"]),
+        ),
+    )
+    used: set[int] = set()
+    assignment: dict[int, dict] = {}
+
+    def search(k: int) -> bool:
+        if int(k) == len(order):
+            return True
+        hole_index = int(order[k])
+        candidates = sorted(
+            holes[hole_index]["candidates"],
+            key=lambda cand: (
