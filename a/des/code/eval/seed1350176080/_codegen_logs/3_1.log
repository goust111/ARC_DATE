+        minor_color = int(piece_colors[2 * hole_index + 1])
+        placed = False
+        for _ in range(120):
+            area = random.randint(3, 7)
+            mask = _random_polyomino(area, max_span=4)
+            if mask is None:
+                continue
+            key = _canonical_mask_key(mask)
+            if key in used_shape_keys:
+                continue
+            mh, mw = map(int, mask.shape)
+            positions = []
