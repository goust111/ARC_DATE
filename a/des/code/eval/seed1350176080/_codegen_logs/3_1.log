+        frame_view[hole["mask"]] = int(bg)
+
+    transformed_pieces = []
+    for hole in holes:
+        variants = _dihedral_variants(hole["patch"], hole["mask"])
+        choice = random.choice(variants)
+        transformed_pieces.append(
+            {
+                "patch": choice["patch"],
+                "mask": choice["mask"],
