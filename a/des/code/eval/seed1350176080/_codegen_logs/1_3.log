+def _frame_patch(
+    inner_h: int,
+    inner_w: int,
+    template: np.ndarray,
+    template_top: int,
+    template_left: int,
+    side: str,
+    gap_starts: tuple[int, ...],
+    frame_color: int,
+    bg: int,
+) -> np.ndarray:
+    patch = np.full((inner_h + 2, inner_w + 2), int(bg), dtype=int)
+    patch[0, :] = int(frame_color)
+    patch[-1, :] = int(frame_color)
