+FRAME_COLOR = 3
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+SIDES = ("top", "bottom", "left", "right")
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
