+def _paste_clipped(out: np.ndarray, patch: np.ndarray, top: int, left: int, bg: int) -> None:
+    h, w = out.shape
+    ph, pw = patch.shape
+    r0 = max(0, int(top))
+    c0 = max(0, int(left))
+    r1 = min(h, int(top) + ph)
+    c1 = min(w, int(left) + pw)
