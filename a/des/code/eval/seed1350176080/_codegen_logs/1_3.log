+def _position_choices(
+    shape: tuple[int, int],
+    patch: np.ndarray,
+    template: np.ndarray,
+    side: str,
+    gap_starts: tuple[int, ...],
+    reserved: np.ndarray,
+    input_blocked: np.ndarray,
