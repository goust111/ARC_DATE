+    expanded[:, 1:] |= mask[:, :-1]
+    expanded[:, :-1] |= mask[:, 1:]
+    expanded[1:, 1:] |= mask[:-1, :-1]
+    expanded[1:, :-1] |= mask[:-1, 1:]
+    expanded[:-1, 1:] |= mask[1:, :-1]
+    expanded[:-1, :-1] |= mask[1:, 1:]
+    return expanded
+
+
+def _render_expected(rectangles: list[dict[str, object]]) -> np.ndarray:
