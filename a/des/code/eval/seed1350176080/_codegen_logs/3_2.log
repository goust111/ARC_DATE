+    if w_low > CANVAS_SIDE_MAX:
+        return None
+    w_high = min(CANVAS_SIDE_MAX, max(w_low + CANVAS_SLACK, h_low + 1))
+    W = int(_RNG.integers(w_low, w_high + 1))
