+MAX_RECT_H = 11
+MAX_RECT_W = 15
+MIN_PART_AREA = 3
+CANVAS_SIDE_MAX = 30
+CANVAS_SLACK = 5
+PLACEMENT_PADDING = 1
+GENERATION_RETRIES = 400
