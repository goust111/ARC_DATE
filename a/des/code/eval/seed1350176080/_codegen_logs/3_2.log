+    out_h, out_w = map(int, ordered[0]["dims"])
+    out = np.full((out_h, out_w), int(ordered[0]["color"]), dtype=int)
+    for item in ordered[1:]:
+        h, w = map(int, item["dims"])
+        r0 = (out_h - h) // 2
+        c0 = (out_w - w) // 2
+        out[r0 : r0 + h, c0 : c0 + w] = int(item["color"])
+    return out
