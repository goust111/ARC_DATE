+
+def _sample_rectangles() -> list[tuple[int, int]]:
+    n = int(_RNG.integers(PAIR_COUNT_RANGE[0], PAIR_COUNT_RANGE[1] + 1))
+
+    h = int(_RNG.integers(SMALLEST_H_RANGE[0], SMALLEST_H_RANGE[1] + 1))
+    w = h + int(_RNG.integers(SMALLEST_W_DELTA_RANGE[0], SMALLEST_W_DELTA_RANGE[1] + 1))
+    w = min(max(w, h), MAX_RECT_W)
+    sizes = [(h, w)]
+
+    while len(sizes) < n:
+        prev_h, prev_w = sizes[-1]
+        accepted = False
+        for _ in range(40):
+            dh = int(_RNG.integers(GROWTH_STEP_RANGE[0], GROWTH_STEP_RANGE[1] + 1))
+            dw = int(_RNG.integers(max(dh, GROWTH_STEP_RANGE[0]), GROWTH_STEP_RANGE[1] + 1))
+            nh = prev_h + 2 * dh
+            nw = prev_w + 2 * dw
+            if nh <= MAX_RECT_H and nw <= MAX_RECT_W and nh <= nw:
+                sizes.append((int(nh), int(nw)))
