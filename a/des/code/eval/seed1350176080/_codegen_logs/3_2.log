+    out_h, out_w = map(int, pairs[0]["dims"])
+    out = np.full((out_h, out_w), int(pairs[0]["color"]), dtype=int)
+
+    for item in pairs[1:]:
+        h, w = map(int, item["dims"])
+        r0 = (out_h - h) // 2
+        c0 = (out_w - w) // 2
+        out[r0 : r0 + h, c0 : c0 + w] = int(item["color"])
