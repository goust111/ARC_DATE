+    return out
+
+
+# --------------- generator helpers ---------------
+
+PALETTE = tuple(range(10))
+PAIR_COUNT_RANGE = (2, 4)  # inclusive
+SMALLEST_H_RANGE = (3, 5)
+SMALLEST_W_DELTA_RANGE = (0, 4)
+GROWTH_STEP_RANGE = (1, 2)
+MAX_RECT_H = 11
+MAX_RECT_W = 15
+MIN_PART_AREA = 3
+CANVAS_SIDE_MAX = 30
+CANVAS_SLACK = 5
