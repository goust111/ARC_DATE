+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    expanded = mask.copy()
+    expanded[1:, :] |= mask[:-1, :]
+    expanded[:-1, :] |= mask[1:, :]
+    expanded[:, 1:] |= mask[:, :-1]
+    expanded[:, :-1] |= mask[:, 1:]
+    expanded[1:, 1:] |= mask[:-1, :-1]
+    expanded[1:, :-1] |= mask[:-1, 1:]
+    expanded[:-1, 1:] |= mask[1:, :-1]
+    expanded[:-1, :-1] |= mask[1:, 1:]
