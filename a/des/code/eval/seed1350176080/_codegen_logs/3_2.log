+        cropped_a = mask_a[bbox_a[0] : bbox_a[2] + 1, bbox_a[1] : bbox_a[3] + 1]
+        cropped_b = mask_b[bbox_b[0] : bbox_b[2] + 1, bbox_b[1] : bbox_b[3] + 1]
