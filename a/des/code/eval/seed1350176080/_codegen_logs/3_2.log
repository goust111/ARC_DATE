+
+
+def _reconstruct_rectangle(mask_a: np.ndarray, mask_b: np.ndarray) -> tuple[int, int]:
+    solutions = _rectangle_solutions(mask_a, mask_b)
+    assert solutions, "fragment pair must reconstruct into at least one rectangle"
+    return solutions[0]
