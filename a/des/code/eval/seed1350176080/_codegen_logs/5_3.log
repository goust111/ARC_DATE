+
+
+def _generate_case(rng: random.Random) -> tuple[np.ndarray, np.ndarray]:
+    terminal_count = rng.choice((2, 3))
+    recipes = _sample_recipes(rng, terminal_count)
+    total_wires = sum(len(recipe) for recipe in recipes)
