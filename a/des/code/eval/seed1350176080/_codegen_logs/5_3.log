+    height = 6 * slot_count + rng.randint(4, 7)
+    source_left = rng.randint(1, 3)
+    width = rng.randint(max(24, total_wires + 18), max(30, total_wires + 24))
+    terminal_left = width - 5 - rng.randint(1, 3)
