+    transform_code = rng.randrange(8)
+    grid = _transform_grid(grid, transform_code)
+    expected = _transform_grid(expected, transform_code)
+    return grid, expected
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(300):
