+        _paint_segment(grid, (tr, lane), (tr, tc))
+        _paint_segment(expected, (sr, sc), (sr, lane))
+        _paint_segment(expected, (sr, lane), (tr, lane))
+        _paint_segment(expected, (tr, lane), (tr, tc))
