+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _shape_mask(kind: str, size: int) -> np.ndarray:
+    assert size >= 3 and size % 2 == 1
+    mid = size // 2
+    mask = np.zeros((size, size), dtype=bool)
+    if kind == "plus":
+        mask[mid, :] = True
+        mask[:, mid] = True
+    elif kind == "T":
+        mask[0, :] = True
+        mask[:, mid] = True
