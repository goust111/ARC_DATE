+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+SHAPES = ("plus", "T", "L")
+
+GEN_ATTEMPTS = 300
+GEN_MARKER_SIZE = 3
+GEN_STAMP_SIZES = (5, 7, 9)
+GEN_CONTAINER_COUNTS = (3, 4)
+GEN_EDGE_SIDES = ("top", "bottom", "left", "right")
