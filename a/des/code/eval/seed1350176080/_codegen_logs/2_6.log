+    for (r0, c0), kind, gap_count in zip(chosen_positions, kinds, gap_counts):
+        grid[r0, c0 : c0 + box_size] = BLACK
+        grid[r0 + box_size - 1, c0 : c0 + box_size] = BLACK
+        grid[r0 : r0 + box_size, c0] = BLACK
+        grid[r0 : r0 + box_size, c0 + box_size - 1] = BLACK
