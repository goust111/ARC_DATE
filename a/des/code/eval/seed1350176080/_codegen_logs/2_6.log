+    colors = [int(v) for v in np.unique(grid) if int(v) not in (bg, BLACK, GREY)]
+    for color in colors:
+        for coords in _components(grid == color):
+            if not _touches_edge(coords, h, w):
+                continue
+            r0, c0, r1, c1 = _bbox(coords)
+            patch = grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+            kind = _classify_shape(patch == color)
+            templates.setdefault(kind, []).append(patch)
+    return templates
+
+
+def _find_containers(grid: np.ndarray) -> list[dict[str, object]]:
+    h, w = grid.shape
+    containers: list[dict[str, object]] = []
+    for coords in _components(grid == BLACK):
+        if _touches_edge(coords, h, w):
+            continue
+        r0, c0, r1, c1 = _bbox(coords)
+        box_h = r1 - r0 + 1
+        box_w = c1 - c0 + 1
+        if box_h < 5 or box_w < 5:
+            continue
+        local = np.zeros((box_h, box_w), dtype=bool)
+        for r, c in coords:
+            local[r - r0, c - c0] = True
+        border = _perimeter_mask(box_h, box_w)
+        if np.any(local & ~border):
+            continue
+        gap_count = int(border.sum() - local.sum())
+        if not 1 <= gap_count <= 3:
+            continue
+        containers.append({"bbox": (r0, c0, r1, c1), "gaps": gap_count})
+    containers.sort(key=lambda d: (d["bbox"][0], d["bbox"][1]))
+    return containers
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    bg = _most_common_color(g)
+    templates = _find_templates(g, bg)
+    assert all(kind in templates for kind in SHAPES), "missing stamp template"
+
+    out = g.copy()
+    for container in _find_containers(g):
+        r0, c0, r1, c1 = container["bbox"]
+        gap_count = int(container["gaps"])
+        interior = g[r0 + 1 : r1, c0 + 1 : c1]
+        marker_mask = interior == GREY
+        assert marker_mask.any(), "each container must contain a grey marker"
+        kind = _classify_shape(marker_mask)
+
+        matches = []
+        for patch in templates[kind]:
+            rotated = _rotate_clockwise(patch, gap_count)
+            if rotated.shape == interior.shape:
