+        (top, col),
+        (top + size + gap1, col),
+        (top + 2 * size + gap1 + gap2, col),
+    ]
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    stamp_size = rng.choice(GEN_STAMP_SIZES)
