+
+    top_max = h - (3 * size + gap1 + gap2)
+    if top_max < 0:
+        raise RuntimeError("grid too small for left/right templates")
+    top = rng.randint(0, top_max)
+    col = 0 if side == "left" else w - size
+    return [
+        (top, col),
+        (top + size + gap1, col),
+        (top + 2 * size + gap1 + gap2, col),
+    ]
+
