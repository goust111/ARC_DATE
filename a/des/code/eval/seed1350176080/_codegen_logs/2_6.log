+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+SHAPES = ("plus", "T", "L")
+
+GEN_ATTEMPTS = 300
+GEN_MARKER_SIZE = 3
+GEN_STAMP_SIZES = (5, 7, 9)
+GEN_CONTAINER_COUNTS = (3, 4)
+GEN_EDGE_SIDES = ("top", "bottom", "left", "right")
+GEN_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+GEN_BUFFER = 2
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _touches_edge(coords: list[tuple[int, int]], h: int, w: int) -> bool:
+    return any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in coords)
+
+
+def _perimeter_mask(h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _shape_mask(kind: str, size: int) -> np.ndarray:
+    assert size >= 3 and size % 2 == 1
+    mid = size // 2
+    mask = np.zeros((size, size), dtype=bool)
+    if kind == "plus":
+        mask[mid, :] = True
+        mask[:, mid] = True
+    elif kind == "T":
+        mask[0, :] = True
+        mask[:, mid] = True
+    elif kind == "L":
+        mask[:, 0] = True
+        mask[-1, :] = True
