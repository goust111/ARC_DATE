+    raise RuntimeError("failed to choose separated gap cells")
+
+
+def _template_layout(
+    rng: random.Random,
+    h: int,
+    w: int,
+    size: int,
+    side: str,
+) -> list[tuple[int, int]]:
+    gap1 = rng.randint(1, 3)
+    gap2 = rng.randint(1, 3)
