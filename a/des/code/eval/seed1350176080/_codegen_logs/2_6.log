+    patch = grid[r0 : r0 + outer_h, c0 : c0 + outer_w]
+    border = _perimeter_mask(outer_h, outer_w)
+    border_vals = patch[border]
+    if np.any((border_vals != BLACK) & (border_vals != bg)):
