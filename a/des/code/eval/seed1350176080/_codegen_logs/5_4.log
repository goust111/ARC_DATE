+def _same_color_visible(colors: np.ndarray, r: int, c: int, direction: int) -> int:
+    dr, dc = DIR_VECS[direction]
+    nr, nc = colors.shape
+    color = int(colors[r, c])
+    seen = 0
+    rr = r + dr
+    cc = c + dc
