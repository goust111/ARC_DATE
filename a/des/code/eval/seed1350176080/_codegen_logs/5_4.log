+def _infer_grid_geometry(g: np.ndarray) -> tuple[int, int, list[int], list[int], int]:
+    h, w = g.shape
+    rows_by_color: dict[int, list[int]] = {}
+    cols_by_color: dict[int, list[int]] = {}
+
+    for r in range(h):
+        if np.all(g[r, :] == g[r, 0]):
+            rows_by_color.setdefault(int(g[r, 0]), []).append(r)
+    for c in range(w):
+        if np.all(g[:, c] == g[0, c]):
