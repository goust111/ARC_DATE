+    for r in range(h):
+        if np.all(g[r, :] == g[r, 0]):
+            rows_by_color.setdefault(int(g[r, 0]), []).append(r)
+    for c in range(w):
+        if np.all(g[:, c] == g[0, c]):
+            cols_by_color.setdefault(int(g[0, c]), []).append(c)
