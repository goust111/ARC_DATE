+    return corners
+
+
+def _render_input(colors: np.ndarray, directions: np.ndarray, corners: np.ndarray, cell_size: int) -> np.ndarray:
+    nr, nc = colors.shape
+    h = nr * (cell_size + 1) + 1
+    w = nc * (cell_size + 1) + 1
+    grid = np.full((h, w), BG, dtype=int)
