+    mins = coords.min(axis=0)
+    norm = frozenset((int(r - mins[0]), int(c - mins[1])) for r, c in coords)
+    assert norm in NORMALIZED_ARROW_PATTERNS, "invalid arrow sprite"
+    return NORMALIZED_ARROW_PATTERNS[norm]
