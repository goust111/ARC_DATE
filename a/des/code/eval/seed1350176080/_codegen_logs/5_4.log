+    row_steps = np.diff(row_lines)
+    col_steps = np.diff(col_lines)
+    assert row_steps.size > 0 and col_steps.size > 0
+    assert np.all(row_steps == row_steps[0])
+    assert np.all(col_steps == col_steps[0])
