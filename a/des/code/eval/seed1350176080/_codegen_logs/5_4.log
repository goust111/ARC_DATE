+    UP: ((0, 1), (1, 0), (1, 2)),
+    DOWN: ((0, 0), (0, 2), (1, 1)),
+    LEFT: ((0, 1), (1, 0), (2, 1)),
+    RIGHT: ((0, 0), (1, 1), (2, 0)),
+}
