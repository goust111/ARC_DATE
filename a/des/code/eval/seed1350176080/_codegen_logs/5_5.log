+def _find_thumbnail(left: np.ndarray, thumb_h: int, thumb_w: int) -> np.ndarray:
+    outer_h = thumb_h + 2
+    outer_w = thumb_w + 2
+    candidates: list[np.ndarray] = []
+    for r0 in range(left.shape[0] - outer_h + 1):
