+        [
+            [1, 2, 3],
+            [0, 2, 2],
+            [2, 2, 0],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [1, 2, 2],
+            [0, 3, 2],
+            [2, 2, 0],
+        ],
+        dtype=int,
+    ),
+    np.array(
