        r0 = tr * 3
        c0 = tc * 3
        output[r0 : r0 + 3, c0 : c0 + 3] = fixed

    return output


def _grow_connected_shape(height: int, width: int, count: int) -> list[tuple[int, int]]:
    start = (random.randrange(height), random.randrange(width))
