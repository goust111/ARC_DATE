+
+def _slot_for_marker(grid, bbox, template_color, marker_pos, delta, cell_to_slot):
+    r0, c0, r1, c1 = bbox
+    r, c = marker_pos
+    dr, dc = delta
+    r += dr
+    c += dc
+    crossed_template = False
+    while r0 <= r <= r1 and c0 <= c <= c1:
+        value = int(grid[r, c])
+        if value == template_color:
+            crossed_template = True
+            r += dr
+            c += dc
+            continue
