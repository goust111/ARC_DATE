+        r0 = int(rng.integers(0, height))
+        r1 = int(rng.integers(r0 + 1, height + 1))
+        tile[r0:r1, c] = color
+        return
+
+    if kind == "diag":
+        length = int(rng.integers(1, min(height, width) + 1))
+        r0 = int(rng.integers(0, height - length + 1))
+        c0 = int(rng.integers(0, width - length + 1))
+        for k in range(length):
