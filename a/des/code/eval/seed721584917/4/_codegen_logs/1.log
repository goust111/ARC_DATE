+        previous_bbox = (r0, c0, r1, c1)
+
+        used_mask[comp[:, 0], comp[:, 1]] = True
+        rings.append(
+            {
+                "layer": layer,
+                "color": color,
+                "bbox": (r0, c0, r1, c1),
+                "gap_abs": gap_abs,
+                "gap_sig": gap_sig,
+            }
+        )
+    return rings, used_mask
+
+
+def _extract_pieces(grid: np.ndarray, used_mask: np.ndarray) -> list[dict]:
+    comps = _components_mask((grid != BG) & (~used_mask))
+    pieces: list[dict] = []
+    for comp in comps:
