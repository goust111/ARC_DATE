+SHAPE_SPECS = [
+    ("line", 2),
+    ("line", 3),
+    ("line", 4),
+    ("line", 5),
+    ("corner", 2, 2),
+    ("corner", 2, 3),
+    ("corner", 2, 4),
+    ("corner", 3, 3),
