81: def _clockwise_order(frames: list[dict], edges: set[tuple[int, int]]) -> list[int]:
82:     mean_r = sum(frame["center"][0] for frame in frames) / len(frames)
83:     mean_c = sum(frame["center"][1] for frame in frames) / len(frames)
84:     angles = [
85:         math.atan2(frame["center"][0] - mean_r, frame["center"][1] - mean_c)
86:         for frame in frames
87:     ]
88:     assert len({round(angle, 12) for angle in angles}) == len(angles)
89: 
90:     order = sorted(range(len(frames)), key=lambda i: angles[i])
91:     for a, b in zip(order, order[1:] + order[:1]):
92:         assert tuple(sorted((a, b))) in edges
93:     return order
