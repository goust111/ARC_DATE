65:             cc = int(c)
66:             for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
67:                 frame_id = red_id.get((nr, nc))
68:                 if frame_id is not None:
69:                     touched.add(frame_id)
70:         assert len(touched) == 2
