+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+COLOR_POOL = tuple(range(1, 10))
+GEN_RETRIES = 400
+
+
+def _components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.asarray(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _normalize_coords(coords: Iterable[tuple[int, int]] | np.ndarray) -> tuple[tuple[int, int], ...]:
+    pts = np.asarray(list(coords), dtype=int)
+    pts = pts - pts.min(axis=0)
+    order = np.lexsort((pts[:, 1], pts[:, 0]))
+    pts = pts[order]
+    return tuple((int(r), int(c)) for r, c in pts)
+
+
+def _dihedral_variants(coords: Iterable[tuple[int, int]] | np.ndarray) -> list[tuple[tuple[int, int], ...]]:
+    pts = np.asarray(list(coords), dtype=int)
+    r = pts[:, 0]
+    c = pts[:, 1]
+    variants = [
+        np.stack([r, c], axis=1),
+        np.stack([r, -c], axis=1),
+        np.stack([-r, c], axis=1),
+        np.stack([-r, -c], axis=1),
+        np.stack([c, r], axis=1),
+        np.stack([c, -r], axis=1),
+        np.stack([-c, r], axis=1),
+        np.stack([-c, -r], axis=1),
+    ]
+    out: list[tuple[tuple[int, int], ...]] = []
+    seen: set[tuple[tuple[int, int], ...]] = set()
+    for variant in variants:
+        norm = _normalize_coords(variant)
+        if norm not in seen:
+            seen.add(norm)
+            out.append(norm)
+    return out
+
+
+def _canonical_shape(coords: Iterable[tuple[int, int]] | np.ndarray) -> tuple[tuple[int, int], ...]:
+    return min(_dihedral_variants(coords))
+
+
+def _coords_to_mask(coords: Iterable[tuple[int, int]] | np.ndarray) -> np.ndarray:
+    pts = np.asarray(list(coords), dtype=int)
+    h = int(pts[:, 0].max()) + 1
+    w = int(pts[:, 1].max()) + 1
+    mask = np.zeros((h, w), dtype=bool)
+    mask[pts[:, 0], pts[:, 1]] = True
+    return mask
+
+
+def _rect_border_coords(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        coords.append((r0, c))
+        if r1 != r0:
