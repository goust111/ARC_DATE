+def _contact_top_left_options(r: int, c: int, d: int) -> list[tuple[int, int]]:
+    if d == DOWN:
+        return [(r + 1, c), (r + 1, c - 1)]
+    if d == UP:
+        return [(r - 2, c), (r - 2, c - 1)]
+    if d == RIGHT:
+        return [(r, c + 1), (r - 1, c + 1)]
+    if d == LEFT:
+        return [(r, c - 2), (r - 1, c - 2)]
+    raise AssertionError("bad direction")
