+    LEFT: (0, -1),
+}
+REFLECT = {
+    "\\": {
+        UP: LEFT,
+        RIGHT: DOWN,
+        DOWN: RIGHT,
+        LEFT: UP,
+    },
+    "/": {
+        UP: RIGHT,
+        RIGHT: UP,
+        DOWN: LEFT,
+        LEFT: DOWN,
+    },
+}
+
+MIN_H = 10
+MAX_H = 18
+MIN_W = 10
+MAX_W = 18
+MAX_RETRIES = 400
