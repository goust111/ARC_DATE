 138:         seg = find_seg(segs, c)
 139:         if seg is None: continue
 140:         a, b = seg
 141:         entry = entry_from_above(r, seg)
 142:         if entry is not None:
 143:             # Pack to opposite end from entry
 144:             pack_end = b if (entry - a) <= (b - entry) else a
 145:         else:
