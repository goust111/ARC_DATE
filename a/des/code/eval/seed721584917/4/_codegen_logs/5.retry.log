  34: def main(grid: np.ndarray) -> np.ndarray:
  35:     """Paint the teal outline of the right triangle determined by the missing corner of the grey-marker square.
  36: 
  37:     Input structure
  38:     The grid is an orange background with exactly four foreground marker pixels of one color. The markers have a square bounding box: three markers are bbox corners, and the fourth marker is inside that square.
  39:     Rule
  40:     Find the one corner of the marker bounding square that has no marker. That missing corner is the right-angle vertex of a right isosceles triangle; paint its two axis-aligned legs and the opposite diagonal in teal, leaving existing marker pixels unchanged.
  41:     Key insight
  42:     The present corner marker opposite the missing corner is a decoy; the three triangle vertices are the missing corner and the two marker corners adjacent to it.
  43:     """
  44:     g = np.asarray(grid, dtype=int)
  45:     bg = get_bg(g)
  46: 
  47:     marker_colors = [int(c) for c in np.unique(g) if int(c) != bg]
  48:     assert len(marker_colors) == 1
  49:     marker = marker_colors[0]
  50:     assert marker != Color.TEAL and bg != Color.TEAL
  51: 
  52:     marker_coords = np.argwhere(g == marker)
  53:     assert marker_coords.shape == (4, 2)
  54:     r0, c0 = marker_coords.min(axis=0)
  55:     r1, c1 = marker_coords.max(axis=0)
  56:     r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))
  57:     assert r1 - r0 == c1 - c0
  58: 
  59:     corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
  60:     marker_set = {tuple(map(int, coord)) for coord in marker_coords}
  61:     missing_corners = corners - marker_set
  62:     assert len(missing_corners) == 1
  63:     assert len(marker_set & corners) == 3
  64: 
  65:     out = g.copy()
  66:     outline = _outline_from_missing_corner(r0, c0, r1, c1, missing_corners.pop())
  67:     for r, c in outline:
  68:         if out[r, c] == bg:
  69:             out[r, c] = Color.TEAL
  70: 
  71:     return out
