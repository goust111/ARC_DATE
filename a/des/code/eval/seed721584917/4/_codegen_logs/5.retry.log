+        stop_index = primary_tail.index(absorber_cell)
+        reserved_path |= set(primary_tail[:stop_index])
+        absorbers.add(absorber_cell)
+        object_cells.add(absorber_cell)
+    else:
+        reserved_path |= set(primary_tail)
