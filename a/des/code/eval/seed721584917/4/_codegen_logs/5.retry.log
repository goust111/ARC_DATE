  28:     water = int(min(non, key=lambda c: (int(cnt[int(c)]), int(c))))
  29:     other = [int(c) for c in non if int(c) != int(water)]
  30:     assert not (not other)
  31:     shelf = int(other[0])
  32: 
  33:     out = g.copy()
  34: 
  35:     # sources: 8-connected components of water that touch the top edge; start from their bottommost row
  36:     sources: list[tuple[int, int]] = []
  37:     for coords in components_mask(g == int(water), connectivity=8):
  38:         if coords.size == 0:
  39:             continue
  40:         if not bool((coords[:, 0] == 0).any()):
  41:             continue
  42:         rmax = int(coords[:, 0].max())
  43:         cols = sorted({int(c) for r, c in coords if int(r) == int(rmax)})
  44:         for c in cols:
  45:             sources.append((int(rmax), int(c)))
  46: 
  47:     # shelf segments (from original grid g)
  48:     shelf_segs: list[list[tuple[int, int]]] = [[] for _ in range(H)]
  49:     for r in range(H):
  50:         c = 0
  51:         while c < W:
  52:             if int(g[int(r), int(c)]) != int(shelf):
  53:                 c += 1
  54:                 continue
  55:             c0 = int(c)
  56:             while c + 1 < W and int(g[int(r), int(c + 1)]) == int(shelf):
  57:                 c += 1
  58:             shelf_segs[int(r)].append((int(c0), int(c)))
  59:             c += 1
  60: 
  61:     def find_shelf_seg(r: int, c: int) -> tuple[int, int] | None:
  62:         for a, b in shelf_segs[int(r)]:
  63:             if int(a) <= int(c) <= int(b):
  64:                 return (int(a), int(b))
  65:         return None
  66: 
  67:     def spread_limits(row: int, start_col: int, min_col: int, max_col: int) -> tuple[int, int]:
  68:         """
  69:         Expand horizontally only through contiguous bg cells on the current row.
  70: 
  71:         This prevents water from "jumping" over blockers that sit on the spread row.
  72:         """
  73:         left = int(start_col)
  74:         while left - 1 >= int(min_col) and int(g[int(row), int(left - 1)]) == int(bg):
  75:             left -= 1
  76: 
  77:         right = int(start_col)
  78:         while right + 1 <= int(max_col) and int(g[int(row), int(right + 1)]) == int(bg):
  79:             right += 1
  80: 
  81:         return (int(left), int(right))
  82: 
  83:     seen: set[tuple[int, int]] = set()
  84:     q = deque((int(r), int(c)) for r, c in sources)
  85: 
  86:     while q:
  87:         r, c = q.popleft()
  88:         if (int(r), int(c)) in seen:
  89:             continue
  90:         seen.add((int(r), int(c)))
  91: 
  92:         rr, cc = int(r), int(c)
  93:         out[rr, cc] = int(water)
  94: 
  95:         while True:
  96:             nr = int(rr + 1)
  97:             if nr >= H:
  98:                 break
  99:             below = int(g[int(nr), int(cc)])
 100: 
 101:             if below == int(shelf):
 102:                 seg = find_shelf_seg(nr, cc)
 103:                 if seg is None:
 104:                     break
 105:                 a, b = seg
 106:                 left_bound = int(max(0, int(a - 1)))
 107:                 right_bound = int(min(int(W - 1), int(b + 1)))
 108:                 left, right = spread_limits(rr, cc, left_bound, right_bound)
 109:                 for x in range(left, right + 1):
 110:                     if int(g[int(rr), int(x)]) == int(bg):
 111:                         out[int(rr), int(x)] = int(water)
 112:                 for nc in {left, right}:
 113:                     if int(nc) != int(cc):
 114:                         q.append((int(rr), int(nc)))
 115:                 break
 116: 
 117:             rr = nr
 118:             out[int(rr), int(cc)] = int(water)
 119: 
 120:     return out
