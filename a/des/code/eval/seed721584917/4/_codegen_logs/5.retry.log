+    meta = {
+        "mirrors": mirrors,
+        "emitters": emitters,
+        "absorbers": absorbers,
+        "ray_info": ray_info,
+        "painted": painted,
+        "intersection_cells": [cell for cell, colors in painted.items() if len(colors) >= 2],
+        "reflection_count": sum(info["reflections"] for info in ray_info),
+        "termination_types": [info["termination"] for info in ray_info],
+    }
