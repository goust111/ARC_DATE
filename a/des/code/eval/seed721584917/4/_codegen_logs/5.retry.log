  91: 
  92:     def find_seg(segs: list[tuple[int, int]], c: int) -> tuple[int, int] | None:
  93:         for a, b in segs:
  94:             if a <= c <= b: return (a, b)
  95:         return None
  96: 
  97:     def seg_exit(r: int, seg: tuple[int, int]) -> int | None:
  98:         """Return the single exit column, or None. Assert if >1 exit."""
  99:         a, b = seg
 100:         if r + 2 >= H: return None
 101:         drops = [c for c in range(a, b + 1)
 102:                  if int(out[r + 1, c]) == int(bg) and int(out[r + 2, c]) == int(bg)]
 103:         assert len(drops) <= 1, f"segment ({a},{b}) at row {r} has {len(drops)} exits: {drops}"
 104:         return drops[0] if drops else None
