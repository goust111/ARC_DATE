 110: def main(grid: np.ndarray) -> np.ndarray:
 111:     """
 112:     Drop the moving-color objects downward until they rest above a one-row cushion before the obstacle or bottom edge.
 113: 
 114:     Input structure:
 115:     - The grid has exactly three colors: empty background, a stationary obstacle/floor color, and a moving object color.
 116:     - The obstacle color is the unique non-background role that touches the bottom edge.
 117:     - Moving pixels start outside the obstacle cells, outside the row directly above each obstacle pixel, and outside the bottom row.
 118: 
 119:     Rule:
 120:     - Keep the background and obstacle pixels fixed.
 121:     - Treat obstacle pixels, cells directly above obstacle pixels, and the bottom row as blocked.
 122:     - Repeatedly move every 4-connected moving-color object one row down when its translated shape does not hit blocked cells or another moving object.
 123: 
 124:     Key insight: The visible floor has an invisible one-row cushion above it, so the objects fall under gravity but stop with one empty row before the floor or the grid bottom.
 125:     """
 126:     g = np.asarray(grid, dtype=int)
 127:     bg, obstacle, moving = _infer_roles(g)
 128:     _assert_obstacle_profile(g, obstacle)
 129:     blocked = _blocked_mask(g, obstacle)
 130:     assert not np.any(blocked & (g == moving)), "moving pixels must start in free cells"
 131: 
 132:     out = g.copy()
 133:     while True:
 134:         moves = _movable_components(out, bg, moving, blocked)
 135:         if not moves:
 136:             break
 137:         for coords, _ in moves:
 138:             out[coords[:, 0], coords[:, 1]] = bg
 139:         for _, shifted in moves:
 140:             out[shifted[:, 0], shifted[:, 1]] = moving
 141: 
 142:     _assert_output_separated(out, obstacle, moving)
 143:     return out
