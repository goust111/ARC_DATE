 104: def main(grid: np.ndarray) -> np.ndarray:
 105:     """
 106:     Extend marker tiles outward from '+' shapes by repeating them to the grid edge.
 107: 
 108:     Input structure:
 109:     - bg = most common color.
 110:     - A dominant non-bg color forms several '+'-shaped objects.
 111:     - Small colored patches (1–few cells) sit adjacent to each arm of a '+'.
 112: 
 113:     Rule:
 114:     - For each marker tile touching a '+', determine which side of the '+' it sits on.
 115:     - Project the tile away from the '+' in that direction, repeating the tile pattern periodically until the grid boundary.
 116:     - '+' pixels are never overwritten.
 117: 
 118:     Key insight: Each marker's attachment side determines its extension direction; the pattern repeats periodically, not as a single copy.
 119:     """
 120:     g = np.array(grid, dtype=int)
 121:     out = g.copy()
 122:     H, W = g.shape
 123: 
 124:     bg = int(get_bg(g))
 125:     plus_col = detect_dominant_big_component_color(g, bg=bg, min_h=3, min_w=3, connectivity=4)
 126:     if plus_col is None:
 127:         return out
 128: 
 129:     plus_lab, pn = label_mask(g == int(plus_col), connectivity=4)
 130:     non_mask = (g != int(bg)) & (g != int(plus_col))
 131:     mark_lab, _mn = label_mask(non_mask, connectivity=4)
 132: 
 133:     for pk in range(1, int(pn) + 1):
 134:         plus_mask = (plus_lab == int(pk))
 135:         plus_coords = np.argwhere(plus_mask)
 136:         if plus_coords.size == 0:
 137:             continue
 138: 
 139:         adj_ids: set[int] = set()
 140:         for r, c in plus_coords:
 141:             r = int(r)
 142:             c = int(c)
 143:             for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
 144:                 rr = r + dr
 145:                 cc = c + dc
 146:                 if 0 <= rr < H and 0 <= cc < W and int(mark_lab[rr, cc]) > 0:
 147:                     adj_ids.add(int(mark_lab[rr, cc]))
 148: 
 149:         for cid in sorted(adj_ids):
 150:             pts = np.argwhere(mark_lab == int(cid))
 151:             if pts.size == 0:
 152:                 continue
 153:             r0, c0, r1, c1 = bbox_coords(pts)
 154:             tile = crop_bbox(g, (int(r0), int(c0), int(r1), int(c1)))
 155: 
 156:             # Direction from plus -> marker (must be unique).
 157:             dirs: set[tuple[int, int]] = set()
 158:             for pr, pc in pts:
 159:                 pr = int(pr)
 160:                 pc = int(pc)
 161:                 for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
 162:                     rr = pr + dr
 163:                     cc = pc + dc
 164:                     if 0 <= rr < H and 0 <= cc < W and bool(plus_mask[rr, cc]):
 165:                         dirs.add((-int(dr), -int(dc)))
 166:             if len(dirs) != 1:
 167:                 continue
 168: 
 169:             dr, dc = next(iter(dirs))
 170: 
 171:             # Alignment check: seed cross-axis span must match arm tip span.
 172:             pr0, pc0 = plus_coords.min(axis=0)
 173:             pr1, pc1 = plus_coords.max(axis=0)
 174:             if dc == 0:  # vertical ray
 175:                 nozzle_row = int(pr1) if dr == 1 else int(pr0)
 176:                 nozzle_cols = sorted(int(cc) for cc in range(int(pc0), int(pc1) + 1) if plus_mask[nozzle_row, cc])
 177:                 seed_cols = list(range(int(c0), int(c1) + 1))
 178:                 assert seed_cols == nozzle_cols
 179:             else:  # horizontal ray
 180:                 nozzle_col = int(pc1) if dc == 1 else int(pc0)
 181:                 nozzle_rows = sorted(int(rr) for rr in range(int(pr0), int(pr1) + 1) if plus_mask[rr, nozzle_col])
 182:                 seed_rows = list(range(int(r0), int(r1) + 1))
 183:                 assert seed_rows == nozzle_rows
 184: 
 185:             extend_repeating_tile(
 186:                 out,
 187:                 tile,
 188:                 int(r0),
 189:                 int(c0),
 190:                 (int(dr), int(dc)),
 191:                 bg=int(bg),
 192:                 protect={int(plus_col)},
 193:             )
 194: 
 195:     return out
