+            cr = random.randint(2, tr - 2)
+        else:
+            cr = random.randint(tr + 2, h - 3)
+        primary_emitter = (0, cc)
+        primary_dir = DOWN
+    else:
+        if need_intersection:
+            cr = random.randint(tr + 2, h - 3)
+        else:
+            cr = random.randint(2, tr - 2)
