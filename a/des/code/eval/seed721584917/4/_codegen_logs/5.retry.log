+def _mirror_moat(top_left: tuple[int, int], h: int, w: int) -> set[tuple[int, int]]:
+    cells = _mirror_cells(top_left)
+    moat = set()
+    for r, c in cells:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
