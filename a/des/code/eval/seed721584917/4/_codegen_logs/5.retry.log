+        pos = extra_edges.pop()
+        emitters.append((pos[0], pos[1], color))
+        used_edges.add(pos)
+        object_cells.add(pos)
+
+    opposite_kind = "/" if primary_kind == "\\" else "\\"
+    extra_kinds = [opposite_kind]
+    extra_kinds.extend(random.choice(["\\", "/"]) for _ in range(random.randint(0, 2)))
