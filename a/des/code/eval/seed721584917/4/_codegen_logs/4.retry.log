+    order: list[tuple[dict, int]] = []
+
+    def visit(node: dict, depth: int) -> None:
+        order.append((node, depth))
+        for child in node["children"]:
+            visit(child, depth + 1)
+
+    for root in nodes:
+        visit(root, 0)
+    return order
