+def _extract_rectangles(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    bg = _background(g)
+    rects: list[dict] = []
+    for color in np.unique(g):
+        color = int(color)
+        if color == bg:
+            continue
+        pts = np.argwhere(g == color)
+        r0, c0 = pts.min(axis=0)
+        r1, c1 = pts.max(axis=0)
+        rects.append(
+            {
+                "color": color,
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "h": int(r1 - r0 + 1),
+                "w": int(c1 - c0 + 1),
