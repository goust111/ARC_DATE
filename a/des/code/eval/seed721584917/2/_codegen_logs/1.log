0009: def main(grid: np.ndarray) -> np.ndarray:
0010:     """Expand the top-left seed mask into a recursive colored pattern and tile it across the full grid.
0011: 
0012:     Input structure
0013:     - The background is the dominant color.
0014:     - All foreground lies in a top-left rectangle whose last row and last column are a solid secondary color.
0015:     - Removing that secondary-color row and column leaves a seed region containing background plus one primary color.
0016: 
0017:     Rule
0018:     - Use the primary-color pixels in the seed as a binary mask.
0019:     - Replace each primary seed cell with a copy of the seed mask in the primary color, and each background seed cell
0020:       with a copy of the seed mask in the secondary color.
0021:     - Repeat and crop that expanded tile to the original grid shape.
0022: 
0023:     Key insight
0024:     The solid L-shaped secondary-color border is a legend, not output content; it supplies the color used when the
0025:     seed's background cells are expanded.
0026:     """
0027:     g = np.asarray(grid, dtype=int)
0028:     bg = int(get_bg(g))
0029: 
0030:     fg_bbox = bbox(g != bg)
0031:     assert fg_bbox is not None, "expected a top-left foreground legend"
0032:     r0, c0, r1, c1 = fg_bbox
0033:     assert r0 == 0 and c0 == 0, "foreground legend must be anchored at the top-left corner"
0034: 
0035:     legend_box = g[: r1 + 1, : c1 + 1]
0036:     seed_h = legend_box.shape[0] - 1
0037:     seed_w = legend_box.shape[1] - 1
0038:     assert seed_h >= 1 and seed_w >= 1, "legend must contain a non-empty seed plus border"
0039: 
0040:     secondary_border = np.concatenate((legend_box[:seed_h, seed_w], legend_box[seed_h, :]))
0041:     secondary_colors = np.unique(secondary_border)
0042:     assert secondary_colors.size == 1, "expected one solid secondary-color border"
0043:     secondary = int(secondary_colors[0])
0044:     assert secondary != bg, "secondary border must be foreground"
0045: 
0046:     seed = legend_box[:seed_h, :seed_w]
0047:     primary_colors = np.unique(seed[seed != bg])
0048:     assert primary_colors.size == 1, "seed must contain exactly one primary foreground color"
0049:     primary = int(primary_colors[0])
0050:     assert primary != secondary, "primary and secondary colors must be distinct"
0051:     assert np.all((seed == bg) | (seed == primary)), "seed may contain only background and primary colors"
0052:     assert np.any(seed == bg), "seed must include background cells that expand to the secondary color"
0053: 
0054:     seed_mask = seed == primary
0055:     H, W = g.shape
0056:     rows = np.arange(H)[:, None]
0057:     cols = np.arange(W)[None, :]
0058: 
0059:     inner_mask = seed_mask[rows % seed_h, cols % seed_w]
0060:     meta_mask = seed_mask[(rows // seed_h) % seed_h, (cols // seed_w) % seed_w]
0061: 
0062:     out = np.full(g.shape, bg, dtype=int)
0063:     out[inner_mask & meta_mask] = primary
0064:     out[inner_mask & ~meta_mask] = secondary
0065:     return out
