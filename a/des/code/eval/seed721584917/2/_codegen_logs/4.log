+    for _ in range(100):
+        picks = sorted(random.sample(candidates, count))
+        ok = True
+        for i in range(count):
+            a = picks[i]
+            b = picks[(i + 1) % count]
+            dist = (b - a) % path_len
+            if dist <= 1:
+                ok = False
+                break
+        if ok:
