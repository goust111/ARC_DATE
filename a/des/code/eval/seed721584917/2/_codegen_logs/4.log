+    shift_r = -min_r
+    shift_c = -min_c
+    local_path = [(r + shift_r, c + shift_c) for r, c in path]
+    local_arrow = [(r + shift_r, c + shift_c) for r, c in arrow]
+
+    return {
+        "patch_h": max_r - min_r + 1,
+        "patch_w": max_c - min_c + 1,
+        "track_color": track_color,
