+    arrows: dict[int, dict] = {}
+    for color in sorted(track_colors):
+        comps = components_mask((grid == color) & (~track_mask))
+        decoded = [_decode_arrow(comp) for comp in comps]
+        valid = [item for item in decoded if item is not None]
+        if valid:
