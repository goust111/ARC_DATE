+GRID_H_RANGE = (18, 31)
+GRID_W_RANGE = (18, 31)
+TRACK_COUNT_CHOICES = (1, 2, 3, 4)
+TRACK_H_RANGE = (4, 9)
+TRACK_W_RANGE = (4, 11)
+MAX_GEN_RETRIES = 400
+MAX_PLACE_RETRIES = 120
