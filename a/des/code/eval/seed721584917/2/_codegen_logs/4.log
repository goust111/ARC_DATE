+        for r, c in obj["arrow"]:
+            grid[r0 + r, c0 + c] = obj["track_color"]
+        markers = obj["output_markers"] if use_output else obj["input_markers"]
+        for idx, color in markers.items():
+            mr, mc = obj["path"][idx]
+            grid[r0 + mr, c0 + mc] = color
