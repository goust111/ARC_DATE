+    neigh: dict[tuple[int, int], list[tuple[int, int]]] = {}
+    degree: dict[tuple[int, int], int] = {}
+    edges = 0
+    for p in pts:
+        cur = [q for q in neighbors4(*p) if q in pts]
+        neigh[p] = cur
+        degree[p] = len(cur)
+        edges += len(cur)
+    if edges // 2 != len(pts) - 1:
+        return None
+    if sum(d == 1 for d in degree.values()) != 2:
+        return None
+
+    bend = None
+    for p, cur in neigh.items():
+        if len(cur) != 2:
+            continue
+        (r1, c1), (r2, c2) = cur
+        if r1 != r2 and c1 != c2:
+            if bend is not None:
+                return None
+            bend = p
