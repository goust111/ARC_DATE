+def _find_arrows(grid: np.ndarray, tracks: list[dict]) -> dict[int, dict]:
+    track_mask = np.zeros(grid.shape, dtype=bool)
+    track_colors = set()
+    for track in tracks:
+        track_colors.add(track["track_color"])
+        for r, c in track["path"]:
+            track_mask[r, c] = True
