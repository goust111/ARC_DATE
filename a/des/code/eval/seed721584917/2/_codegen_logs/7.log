+def _build_axis_bounds(sizes: list[int]) -> list[tuple[int, int]]:
+    bounds = []
+    cursor = 0
+    for size in sizes:
+        start = cursor + 1
+        end = start + size - 1
+        bounds.append((start, end))
+        cursor = end + 1
