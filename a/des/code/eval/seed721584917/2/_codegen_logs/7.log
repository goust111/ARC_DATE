+}
+
+
+def _mode_color(values: np.ndarray) -> int:
+    vals = [int(v) for v in values.reshape(-1)]
+    return Counter(vals).most_common(1)[0][0]
+
+
+def _bg_color(grid: np.ndarray) -> int:
