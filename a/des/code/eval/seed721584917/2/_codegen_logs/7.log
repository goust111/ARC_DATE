+
+def _side_labels(lock: dict, labels: np.ndarray) -> tuple[int, int]:
+    first = set()
+    second = set()
+    if lock["orientation"] == "horizontal":
+        for r, c in lock["coords"]:
+            top = int(labels[r - 1, c])
+            bottom = int(labels[r + 1, c])
+            if top >= 0:
+                first.add(top)
+            if bottom >= 0:
+                second.add(bottom)
+    else:
+        for r, c in lock["coords"]:
+            left = int(labels[r, c - 1])
+            right = int(labels[r, c + 1])
+            if left >= 0:
+                first.add(left)
+            if right >= 0:
+                second.add(right)
