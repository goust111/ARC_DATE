+        rng.shuffle(shuffled)
+        selected = []
+        used_rooms = set()
+        for edge in shuffled:
+            if edge["a"] in used_rooms or edge["b"] in used_rooms:
+                continue
+            selected.append(edge)
+            used_rooms.add(edge["a"])
+            used_rooms.add(edge["b"])
+            if len(selected) == count:
