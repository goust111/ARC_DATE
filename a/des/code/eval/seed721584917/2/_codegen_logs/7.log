+def _build_rooms(
+    row_sizes: list[int], col_sizes: list[int]
+) -> tuple[dict[tuple[int, int], tuple[int, int, int, int]], list[tuple[int, int]], list[tuple[int, int]]]:
+    row_bounds = _build_axis_bounds(row_sizes)
+    col_bounds = _build_axis_bounds(col_sizes)
