+ROOM_COUNT_CHOICES = (2, 3, 4)
+ROOM_SIDE_MIN = 4
+ROOM_SIDE_MAX = 6
+PAIR_COUNT_CHOICES = (2, 3)
+MAX_GENERATION_ATTEMPTS = 400
+
+BASE_SHAPES = {
+    2: [
+        ((0, 0), (0, 1), (1, 0)),
+        ((0, 0), (0, 1), (1, 0), (1, 1)),
+    ],
+    3: [
+        ((0, 0), (1, 0), (1, 1), (1, 2)),
+        ((0, 1), (1, 0), (1, 1), (1, 2)),
+        ((0, 0), (1, 0), (2, 0), (2, 1)),
