+    out = g.copy()
+    for cell, tower_indices in hits.items():
+        emit_colors = {int(towers[i]["emit"]) for i in tower_indices}
+        if len(emit_colors) == 1:
+            out[cell] = next(iter(emit_colors))
+            continue
