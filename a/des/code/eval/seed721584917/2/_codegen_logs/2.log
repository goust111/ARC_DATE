+def _is_tower_window(window: np.ndarray, bg: int) -> bool:
+    if window.shape != (3, 3):
+        return False
+    emit = int(window[0, 0])
+    if emit == bg:
+        return False
+    if any(int(window[r, c]) != emit for r, c in _RING_COORDS):
+        return False
+    priority = int(window[1, 1])
+    return priority not in (bg, emit)
