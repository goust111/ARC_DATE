+    g = np.asarray(grid, dtype=int)
+    candidates: list[dict[str, object]] = []
+    for r0 in range(g.shape[0] - 2):
+        for c0 in range(g.shape[1] - 2):
+            window = g[r0 : r0 + 3, c0 : c0 + 3]
+            if not _is_tower_window(window, bg):
+                continue
+            candidates.append(
+                {
+                    "top": (r0, c0),
+                    "center": (r0 + 1, c0 + 1),
+                    "emit": int(window[0, 0]),
