+_DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+_RING_COORDS = (
+    (0, 0),
+    (0, 1),
+    (0, 2),
+    (1, 0),
+    (1, 2),
+    (2, 0),
+    (2, 1),
