+    for room in layout.rooms.values():
+        if room.is_empty:
+            continue
+
+        empty_neighbors = [
+            (side, neighbor, door)
+            for side, neighbor, door in _neighbors_with_doors(g, layout, room)
+            if neighbor.is_empty
