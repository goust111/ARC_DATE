+def _connected_shape(height: int, width: int, area: int, seed: tuple[int, int], rng: random.Random) -> set[tuple[int, int]]:
+    cells = {seed}
+    while len(cells) < area:
+        frontier = []
+        for rr, cc in cells:
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
