+PALETTE = tuple(range(10))
+MAX_GENERATION_RETRIES = 500
+CHAIN_PATTERNS = (
+    ("P", "E", "E"),
+    ("E", "E", "P"),
+    ("P", "E", "E", "P"),
+    ("P", "E", "E", "P", "P", "E", "E"),
