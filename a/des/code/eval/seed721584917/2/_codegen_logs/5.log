+    down = layout.rooms.get((room.row_idx + 1, room.col_idx))
+    if down is not None:
+        door = _horizontal_door(grid, layout.bg, layout.wall_rows[room.row_idx + 1], max(room.c0, down.c0), min(room.c1, down.c1))
