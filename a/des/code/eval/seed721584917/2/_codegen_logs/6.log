+
+def _random_template_shape() -> tuple[int, int, list[tuple[int, int]]]:
+    h, w = TEMPLATE_DIMS[int(RNG.integers(len(TEMPLATE_DIMS)))]
+    center_r = h // 2
+    center_c = w // 2
+    cells = {(center_r, c) for c in range(w)}
+    cells.update((r, center_c) for r in range(h))
