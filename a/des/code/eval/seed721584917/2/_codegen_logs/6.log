+
+def _choose_template(seed: tuple[int, int], templates: list[dict]) -> dict:
+    ranked = []
+    for template in templates:
+        dist = _template_distance(seed, template)
+        r0, c0, _, _ = template["bbox"]
+        ranked.append((dist, r0, c0, template))
