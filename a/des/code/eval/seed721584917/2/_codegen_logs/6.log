+        r0, c0, r1, c1 = bbox
+        rel_coords = sorted((int(r - r0), int(c - c0)) for r, c in map(tuple, comp))
+        templates.append(
+            {
+                "color": int(template_color),
+                "bbox": bbox,
+                "coords": [tuple(map(int, pt)) for pt in comp],
+                "rel_coords": rel_coords,
+                "h": int(r1 - r0 + 1),
+                "w": int(c1 - c0 + 1),
