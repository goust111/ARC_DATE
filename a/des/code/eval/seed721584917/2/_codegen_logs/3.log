+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict[str, object]] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            rows = [rr for rr, _ in cells]
+            cols = [cc for _, cc in cells]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in cells:
+                mask[rr - r0, cc - c0] = True
+
+            components.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": mask,
+                }
+            )
+
+    return components
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Pair fragments by identical bounding-box size, merge each pair into a full rectangle,
+    then stack the rectangles from smallest area to largest.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0
+
+    bg = _get_bg(g)
+    components = _find_components(g, bg)
+    assert components and len(components) % 2 == 0
+
+    groups: dict[tuple[int, int], list[dict[str, object]]] = defaultdict(list)
+    for comp in components:
+        mask = comp["mask"]
+        assert isinstance(mask, np.ndarray)
+        groups[tuple(map(int, mask.shape))].append(comp)
+
+    rectangles: list[np.ndarray] = []
+    for shape, pair in groups.items():
+        assert len(pair) == 2, f"expected exactly two fragments for size group {shape}"
+        a, b = pair
+        mask_a = np.asarray(a["mask"], dtype=bool)
+        mask_b = np.asarray(b["mask"], dtype=bool)
+        color_a = int(a["color"])
+        color_b = int(b["color"])
+
+        assert mask_a.shape == mask_b.shape
+        assert color_a != color_b
+        assert not np.any(mask_a & mask_b)
+        assert np.all(mask_a | mask_b)
+
+        rect = np.full(mask_a.shape, bg, dtype=int)
+        rect[mask_a] = color_a
+        rect[mask_b] = color_b
+        rectangles.append(rect)
