+from __future__ import annotations
+
+from collections import Counter, defaultdict
+import random
+
+import numpy as np
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict[str, object]] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            rows = [rr for rr, _ in cells]
+            cols = [cc for _, cc in cells]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in cells:
+                mask[rr - r0, cc - c0] = True
+
+            components.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": mask,
+                }
+            )
+
+    return components
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Pair fragments by identical bounding-box size, merge each pair into a full rectangle,
+    then stack the rectangles from smallest area to largest.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0
+
+    bg = _get_bg(g)
+    components = _find_components(g, bg)
+    assert components and len(components) % 2 == 0
+
+    groups: dict[tuple[int, int], list[dict[str, object]]] = defaultdict(list)
+    for comp in components:
+        mask = comp["mask"]
+        assert isinstance(mask, np.ndarray)
+        groups[tuple(map(int, mask.shape))].append(comp)
+
+    rectangles: list[np.ndarray] = []
+    for shape, pair in groups.items():
+        assert len(pair) == 2, f"expected exactly two fragments for size group {shape}"
+        a, b = pair
+        mask_a = np.asarray(a["mask"], dtype=bool)
+        mask_b = np.asarray(b["mask"], dtype=bool)
+        color_a = int(a["color"])
+        color_b = int(b["color"])
+
+        assert mask_a.shape == mask_b.shape
+        assert color_a != color_b
+        assert not np.any(mask_a & mask_b)
+        assert np.all(mask_a | mask_b)
+
+        rect = np.full(mask_a.shape, bg, dtype=int)
+        rect[mask_a] = color_a
+        rect[mask_b] = color_b
+        rectangles.append(rect)
+
+    rectangles.sort(key=lambda rect: (int(rect.shape[0] * rect.shape[1]), int(rect.shape[1])))
+
+    out_h = sum(int(rect.shape[0]) for rect in rectangles) + len(rectangles) - 1
+    out_w = max(int(rect.shape[1]) for rect in rectangles)
+    out = np.full((out_h, out_w), bg, dtype=int)
+
+    row = 0
+    for rect in rectangles:
+        h, w = map(int, rect.shape)
+        out[row : row + h, :w] = rect
+        row += h + 1
+
+    return out
+
+
+PALETTE = tuple(range(10))
+DIM_RANGE = range(3, 7)
+PAIR_COUNT_RANGE = (2, 4)
+GRID_SIDE_MIN = 18
+GRID_SIDE_MAX = 30
+PLACEMENT_PADDING = 1
+PLACEMENT_RETRIES = 300
+MAX_GENERATION_ATTEMPTS = 400
+TIE_AREA_PROB = 0.5
+
+
+def _cycle_even_width(h: int, w: int) -> list[tuple[int, int]]:
+    assert h >= 2 and w >= 2 and w % 2 == 0
+    cycle: list[tuple[int, int]] = []
+    for r in range(h):
+        cycle.append((r, 0))
+    for c in range(1, w):
+        if c % 2 == 1:
+            for r in range(h - 1, 0, -1):
+                cycle.append((r, c))
+        else:
+            for r in range(1, h):
+                cycle.append((r, c))
+    for c in range(w - 1, 0, -1):
+        cycle.append((0, c))
+    assert len(cycle) == h * w
+    return cycle
+
+
+def _hamiltonian_cycle(h: int, w: int, rng: random.Random) -> list[tuple[int, int]]:
+    assert h >= 2 and w >= 2 and (h % 2 == 0 or w % 2 == 0)
+    use_transpose = h % 2 == 0 and (w % 2 == 1 or rng.random() < 0.5)
+    if use_transpose:
+        base = _cycle_even_width(w, h)
+        cycle = [(c, r) for r, c in base]
+    else:
+        cycle = _cycle_even_width(h, w)
+    if rng.random() < 0.5:
+        cycle.reverse()
+    return cycle
+
+
+def _touches_all_sides(cells: list[tuple[int, int]], h: int, w: int) -> bool:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows) == 0 and max(rows) == h - 1 and min(cols) == 0 and max(cols) == w - 1
+
+
+def _mask_from_cells(cells: list[tuple[int, int]], h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
+    return mask
+
+
+def _component_count(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    count = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            count += 1
+            stack = [(r, c)]
+            seen[r, c] = True
+            while stack:
+                cr, cc = stack.pop()
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+    return count
+
+
+def _random_symmetry(mask_a: np.ndarray, mask_b: np.ndarray, rng: random.Random) -> tuple[np.ndarray, np.ndarray]:
+    if rng.random() < 0.5:
+        mask_a = np.flipud(mask_a)
+        mask_b = np.flipud(mask_b)
+    if rng.random() < 0.5:
+        mask_a = np.fliplr(mask_a)
+        mask_b = np.fliplr(mask_b)
+    if mask_a.shape[0] == mask_a.shape[1] and rng.random() < 0.5:
+        mask_a = mask_a.T
+        mask_b = mask_b.T
+    return np.array(mask_a, copy=True), np.array(mask_b, copy=True)
+
+
+def _generate_complementary_masks(h: int, w: int, rng: random.Random) -> tuple[np.ndarray, np.ndarray] | None:
+    cycle = _hamiltonian_cycle(h, w, rng)
+    n = len(cycle)
+    candidates: list[tuple[int, int]] = []
+
+    for start in range(n):
+        for length in range(2, n - 1):
+            arc_a = [cycle[(start + i) % n] for i in range(length)]
+            arc_b = [cycle[(start + i) % n] for i in range(length, n)]
+            if _touches_all_sides(arc_a, h, w) and _touches_all_sides(arc_b, h, w):
+                candidates.append((start, length))
+
+    if not candidates:
+        return None
+
+    balanced = [cand for cand in candidates if n // 3 <= cand[1] <= (2 * n) // 3]
+    start, length = rng.choice(balanced or candidates)
+    cells_a = [cycle[(start + i) % n] for i in range(length)]
+    mask_a = _mask_from_cells(cells_a, h, w)
+    mask_b = ~mask_a
+
+    assert _component_count(mask_a) == 1
+    assert _component_count(mask_b) == 1
+
+    if rng.random() < 0.5:
+        mask_a, mask_b = mask_b, mask_a
+
+    return _random_symmetry(mask_a, mask_b, rng)
+
+
+def _candidate_dims() -> list[tuple[int, int]]:
+    dims = []
+    for h in DIM_RANGE:
+        for w in DIM_RANGE:
+            if h % 2 == 0 or w % 2 == 0:
+                dims.append((h, w))
+    return dims
+
+
+def _choose_dims(pair_count: int, force_tie: bool, rng: random.Random) -> list[tuple[int, int]] | None:
+    dims = _candidate_dims()
+    if force_tie and pair_count >= 2:
