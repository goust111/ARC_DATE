+    for c in range(1, w):
+        if c % 2 == 1:
+            for r in range(h - 1, 0, -1):
+                cycle.append((r, c))
+        else:
+            for r in range(1, h):
+                cycle.append((r, c))
+    for c in range(w - 1, 0, -1):
+        cycle.append((0, c))
+    assert len(cycle) == h * w
+    return cycle
+
+
+def _hamiltonian_cycle(h: int, w: int, rng: random.Random) -> list[tuple[int, int]]:
+    assert h >= 2 and w >= 2 and (h % 2 == 0 or w % 2 == 0)
+    use_transpose = h % 2 == 0 and (w % 2 == 1 or rng.random() < 0.5)
+    if use_transpose:
+        base = _cycle_even_width(w, h)
+        cycle = [(c, r) for r, c in base]
+    else:
+        cycle = _cycle_even_width(h, w)
+    if rng.random() < 0.5:
+        cycle.reverse()
+    return cycle
+
+
+def _touches_all_sides(cells: list[tuple[int, int]], h: int, w: int) -> bool:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows) == 0 and max(rows) == h - 1 and min(cols) == 0 and max(cols) == w - 1
+
+
+def _mask_from_cells(cells: list[tuple[int, int]], h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
+    return mask
+
+
+def _component_count(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    count = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            count += 1
+            stack = [(r, c)]
+            seen[r, c] = True
+            while stack:
+                cr, cc = stack.pop()
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+    return count
+
+
+def _random_symmetry(mask_a: np.ndarray, mask_b: np.ndarray, rng: random.Random) -> tuple[np.ndarray, np.ndarray]:
+    if rng.random() < 0.5:
+        mask_a = np.flipud(mask_a)
+        mask_b = np.flipud(mask_b)
+    if rng.random() < 0.5:
+        mask_a = np.fliplr(mask_a)
+        mask_b = np.fliplr(mask_b)
+    if mask_a.shape[0] == mask_a.shape[1] and rng.random() < 0.5:
+        mask_a = mask_a.T
+        mask_b = mask_b.T
+    return np.array(mask_a, copy=True), np.array(mask_b, copy=True)
+
+
+def _generate_complementary_masks(h: int, w: int, rng: random.Random) -> tuple[np.ndarray, np.ndarray] | None:
+    cycle = _hamiltonian_cycle(h, w, rng)
+    n = len(cycle)
+    candidates: list[tuple[int, int]] = []
