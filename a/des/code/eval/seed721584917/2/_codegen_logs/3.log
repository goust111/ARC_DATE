        if not touch(list(aset),h,w):
            continue
        bset=set(cells)-aset
        if not touch(list(bset),h,w):
            continue
        ma=[[False]*w for _ in range(h)]
        mb=[[True]*w for _ in range(h)]
        for r,c in aset:
            ma[r][c]=True; mb[r][c]=False
        if comp_count(ma)==1 and comp_count(mb)==1:
            return True
    return False

for h in range(3,7):
    for w in range(3,7):
        ok=0
        for _ in range(20):
            if gen(h,w):
                ok+=1
        print((h,w), ok)
