+    out_w = max(int(rect.shape[1]) for rect in rectangles)
+    out = np.full((out_h, out_w), bg, dtype=int)
+
+    row = 0
+    for rect in rectangles:
+        h, w = map(int, rect.shape)
+        out[row : row + h, :w] = rect
+        row += h + 1
+
+    return out
