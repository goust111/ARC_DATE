+        if not tie_options:
+            return None
+        picked = list(rng.choice(tie_options))
+        used = set(picked)
+        used_areas = {picked[0][0] * picked[0][1]}
+        pool = [dim for dim in dims if dim not in used]
+        rng.shuffle(pool)
+        for dim in pool:
+            area = dim[0] * dim[1]
+            if area in used_areas:
+                continue
+            picked.append(dim)
+            used_areas.add(area)
+            if len(picked) == pair_count:
+                return picked
+        return None
