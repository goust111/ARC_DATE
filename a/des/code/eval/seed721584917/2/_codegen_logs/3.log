+def _touches_all_sides(cells: list[tuple[int, int]], h: int, w: int) -> bool:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows) == 0 and max(rows) == h - 1 and min(cols) == 0 and max(cols) == w - 1
