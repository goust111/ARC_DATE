import random

def neighbors4(r,c,h,w):
    for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
        if 0<=nr<h and 0<=nc<w:
            yield nr,nc

def comp_count(mask):
    h=len(mask); w=len(mask[0])
    seen=[[False]*w for _ in range(h)]
    cnt=0
    for r in range(h):
        for c in range(w):
            if not mask[r][c] or seen[r][c]:
                continue
            cnt+=1
            q=[(r,c)]; seen[r][c]=True
            while q:
                cr,cc=q.pop()
                for nr,nc in neighbors4(cr,cc,h,w):
                    if mask[nr][nc] and not seen[nr][nc]:
                        seen[nr][nc]=True; q.append((nr,nc))
    return cnt

def touch(cells,h,w):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1

def gen(h,w,tries=300):
    cells=[(r,c) for r in range(h) for c in range(w)]
    n=h*w
    for _ in range(tries):
        k=random.randint(max(4,n//3), min(n-4, 2*n//3))
        start=random.choice(cells)
        aset={start}
        while len(aset)<k:
            cand=[]
            for r,c in list(aset):
                for nr,nc in neighbors4(r,c,h,w):
                    if (nr,nc) not in aset:
                        cand.append((nr,nc))
            if not cand:
