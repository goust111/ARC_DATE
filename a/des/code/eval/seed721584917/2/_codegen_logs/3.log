+    force_tie = pair_count >= 2 and rng.random() < TIE_AREA_PROB
+    dims = _choose_dims(pair_count, force_tie, rng)
+    if dims is None:
+        return None
+
+    bg = rng.choice(PALETTE)
+    color_pool = [color for color in PALETTE if color != bg]
+    fragment_colors = rng.sample(color_pool, 2 * pair_count)
+
+    fragments: list[dict[str, object]] = []
+    for i, (h, w) in enumerate(dims):
+        masks = _generate_complementary_masks(h, w, rng)
+        if masks is None:
+            return None
+        mask_a, mask_b = masks
+        fragments.append({"mask": mask_a, "color": fragment_colors[2 * i]})
+        fragments.append({"mask": mask_b, "color": fragment_colors[2 * i + 1]})
+
+    reserve_area = sum((int(item["mask"].shape[0]) + 2) * (int(item["mask"].shape[1]) + 2) for item in fragments)
+    min_side = max(
+        GRID_SIDE_MIN,
+        max(int(item["mask"].shape[0]) for item in fragments) + 4,
+        max(int(item["mask"].shape[1]) for item in fragments) + 4,
+        int(np.ceil((reserve_area * 1.25) / GRID_SIDE_MAX)),
+    )
+    if min_side > GRID_SIDE_MAX:
+        return None
+
+    grid_h = rng.randint(min_side, GRID_SIDE_MAX)
+    min_width = max(min_side, int(np.ceil((reserve_area * 1.15) / grid_h)))
+    if min_width > GRID_SIDE_MAX:
+        return None
+    grid_w = rng.randint(min_width, GRID_SIDE_MAX)
+    if rng.random() < 0.5:
+        grid_h, grid_w = grid_w, grid_h
+
+    grid = np.full((grid_h, grid_w), bg, dtype=int)
+    reserved = np.zeros((grid_h, grid_w), dtype=bool)
+
+    rng.shuffle(fragments)
+    fragments.sort(key=lambda item: int(item["mask"].shape[0] * item["mask"].shape[1]), reverse=True)
+    for fragment in fragments:
+        if not _place_fragment(grid, reserved, np.asarray(fragment["mask"], dtype=bool), int(fragment["color"]), rng):
+            return None
+
+    values, counts = np.unique(grid, return_counts=True)
+    bg_count = int(counts[np.where(values == bg)[0][0]])
+    if any(int(count) >= bg_count for value, count in zip(values, counts) if int(value) != bg):
+        return None
+
+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+
+    if out.size == 0:
+        return None
+
+    components = _find_components(grid, bg)
+    if len(components) != 2 * pair_count:
+        return None
+
+    groups: dict[tuple[int, int], int] = defaultdict(int)
+    for comp in components:
+        mask = np.asarray(comp["mask"], dtype=bool)
+        groups[tuple(map(int, mask.shape))] += 1
+    if sorted(groups.values()) != [2] * pair_count:
+        return None
+
+    areas = [h * w for h, w in dims]
+    has_tie = len(areas) != len(set(areas))
+    if has_tie != force_tie:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

