+def _bfs_dist(
+    passable: np.ndarray,
+    blocked: dict[tuple[int, int], set[tuple[int, int]]],
+    start: tuple[int, int],
+) -> np.ndarray:
+    h, w = passable.shape
+    dist = -np.ones((h, w), dtype=int)
+    sr, sc = start
+    dist[sr, sc] = 0
+    q = deque([start])
