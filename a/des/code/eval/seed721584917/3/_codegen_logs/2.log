+
+YELLOW = 4
+GREY = 5
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+PALETTE = [0, 1, 2, 3, 6, 7, 8, 9]
+MAX_GENERATION_ATTEMPTS = 400
