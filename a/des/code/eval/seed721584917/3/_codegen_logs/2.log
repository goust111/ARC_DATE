+
+def _wall_cells(
+    hit: tuple[int, int], direction: str, length: int, offset: int
+) -> list[tuple[int, int]]:
+    r, c = map(int, hit)
+    cells: list[tuple[int, int]] = []
+    if direction in ("left", "right"):
