+        cols = [int(c - 2), int(c - 1)]
+    elif direction == "left":
+        rows = [int(r + shift), int(r + shift + 1)]
+        cols = [int(c + 1), int(c + 2)]
+    elif direction == "up":
+        rows = [int(r + 1), int(r + 2)]
+        cols = [int(c + shift), int(c + shift + 1)]
+    elif direction == "down":
+        rows = [int(r - 2), int(r - 1)]
+        cols = [int(c + shift), int(c + shift + 1)]
+    else:
+        raise ValueError(direction)
