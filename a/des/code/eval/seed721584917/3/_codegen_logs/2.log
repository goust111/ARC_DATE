+def _cycle_colors(arrows: list[dict]) -> list[int]:
+    cycle: list[int] = []
+    seen: set[int] = set()
+    for arrow in arrows:
+        color = int(arrow["color"])
+        if color not in seen:
+            seen.add(color)
+            cycle.append(color)
+    assert cycle
+    return cycle
