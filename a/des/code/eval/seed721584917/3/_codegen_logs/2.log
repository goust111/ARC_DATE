+def _ray_cells(tip: tuple[int, int], direction: str, steps: int) -> list[tuple[int, int]]:
+    dr, dc = DIRS[direction]
+    r, c = map(int, tip)
+    return [(int(r + dr * step), int(c + dc * step)) for step in range(1, int(steps) + 1)]
