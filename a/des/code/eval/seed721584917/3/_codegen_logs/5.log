+    left, right = (points[0], points[1]) if points[0][1] < points[1][1] else (points[1], points[0])
+
+    bbox = (min(r0, r1), min(c0, c1), max(r0, r1), max(c0, c1))
+    upper_is_left = bool(top[1] < bottom[1])
+    left_is_top = bool(left[0] < right[0])
