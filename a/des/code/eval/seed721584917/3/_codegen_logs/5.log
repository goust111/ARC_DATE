+    corners = {(0, 0), (0, width - 1), (height - 1, 0), (height - 1, width - 1)}
+    cells = [(r, c) for r in range(height) for c in range(width) if (r, c) not in corners]
+    if len(cells) < PATTERN_SIZE_RANGE[0]:
