+
+def _sample_dimensions(rng: random.Random, h: int, w: int, seed_count: int) -> tuple[int, int] | None:
+    max_h = min(FENCE_SIZE_RANGE[1] - 1, h - 2)
+    max_w = min(FENCE_SIZE_RANGE[1] - 1, w - 2)
