+def _find_fence_color_and_frames(
+    grid: np.ndarray, bg: int
+) -> tuple[int, list[tuple[int, int, int, int, list[tuple[int, int]]]]]:
+    candidates = []
+    for color in map(int, np.unique(grid)):
+        if color == bg:
