+def _box_has_clipped_branch(
+    box: tuple[int, int, int, int], sides: set[str], seed_count: int, h: int, w: int
+) -> bool:
+    r0, c0, r1, c1 = box
+    return (
+        ("top" in sides and r0 < seed_count)
+        or ("bottom" in sides and (h - 1 - r1) < seed_count)
