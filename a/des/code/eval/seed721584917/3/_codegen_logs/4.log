+def get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                pts.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _border_positions(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    pts: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        pts.append((r0, c))
+    for r in range(r0 + 1, r1):
+        pts.append((r, c1))
+    for c in range(c1, c0 - 1, -1):
+        pts.append((r1, c))
+    for r in range(r1 - 1, r0, -1):
+        pts.append((r, c0))
+    return pts
+
+
+def _dilate4(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    out[1:, :] |= mask[:-1, :]
+    out[:-1, :] |= mask[1:, :]
+    out[:, 1:] |= mask[:, :-1]
+    out[:, :-1] |= mask[:, 1:]
+    return out
+
+
+def _frame_components_for_color(grid: np.ndarray, color: int) -> list[tuple[int, int, int, int, list[tuple[int, int]]]] | None:
+    frames: list[tuple[int, int, int, int, list[tuple[int, int]]]] = []
+    mask = grid == color
+    for pts in _components(_dilate4(mask)):
+        frame_pts = [(r, c) for r, c in pts if mask[r, c]]
+        if not frame_pts:
+            continue
+        r0, c0, r1, c1 = _bbox(frame_pts)
+        if r1 - r0 < 2 or c1 - c0 < 2:
+            return None
+        border = set(_border_positions(r0, c0, r1, c1))
+        comp = set(frame_pts)
+        if not comp <= border:
+            return None
+        gaps = [pos for pos in border if pos not in comp]
+        if not 1 <= len(gaps) <= 4:
+            return None
+        frames.append((r0, c0, r1, c1, gaps))
