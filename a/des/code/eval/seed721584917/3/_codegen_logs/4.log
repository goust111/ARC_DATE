+            gaps_abs = {
+                side: (r0 + rel_r, c0 + rel_c) for side, (rel_r, rel_c) in gap_positions.items()
+            }
+
+            specs.append(
+                {
+                    "bbox": box,
+                    "gaps_abs": gaps_abs,
+                    "seed_count": seed_count,
+                    "seed_cells": seeds,
+                    "seed_color": seed_color,
+                }
