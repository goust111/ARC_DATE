+def _build_group_pattern(shapes: list[dict[str, object]], orientation: str | None) -> dict[str, object]:
+    placements: list[tuple[dict[str, object], int, int]] = [(shapes[0], 0, 0)]
+    line_cells: list[tuple[int, int]] = []
