+def _is_straight_segment(comp: dict[str, object]) -> bool:
+    h = int(comp["h"])
+    w = int(comp["w"])
+    return (h == 1 or w == 1) and int(comp["area"]) == max(h, w)
+
+
+def _detect_slots(grid: np.ndarray, bg: int) -> tuple[int, list[int]]:
+    h, _w = grid.shape
