+
+def _draw_chain(canvas: np.ndarray, shape: dict, depth: int, contour_color: int) -> None:
+    if shape["style"] == "rect":
+        for level in range(depth):
+            inset = 2 * level
+            _draw_rect_contour(
+                canvas,
+                shape["r0"] + inset,
+                shape["c0"] + inset,
+                shape["r1"] - inset,
+                shape["c1"] - inset,
