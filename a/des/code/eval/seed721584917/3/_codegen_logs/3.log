+    for cid in range(1, n_contours + 1):
+        reg_ids = set()
+        coords = np.argwhere(contour_labels == cid)
+        for r, c in coords:
+            for dr, dc in EIGHT_NEIGHBORS:
+                nr, nc = int(r + dr), int(c + dc)
+                if 0 <= nr < h and 0 <= nc < w:
