+    legend = _extract_legend_colors(g[:sep_row], bg)
+    bottom = g[sep_row + 1 :]
+    colors = [int(c) for c in np.unique(bottom) if int(c) != bg]
+    if not colors:
+        raise AssertionError("bottom area must contain contours")
