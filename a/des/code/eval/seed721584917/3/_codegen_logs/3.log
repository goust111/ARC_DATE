+    while q:
+        kind, idx = q.popleft()
+        if kind == "region":
+            depth = region_depth[idx]
+            for cid in region_to_contours[idx]:
+                if cid not in contour_depth:
+                    contour_depth[cid] = depth + 1
+                    q.append(("contour", cid))
+        else:
