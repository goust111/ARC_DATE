+
+
+def _scaled_window_offset(src_size: int, dst_size: int, offset: int) -> int:
+    if dst_size <= 3 or src_size <= 3:
+        return 1
+    mapped = 1 + int(round((offset - 1) * (dst_size - 3) / (src_size - 3)))
