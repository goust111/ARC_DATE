+    if len(np.unique(row[1:])) != 1:
+        return None
+    if int(row[0]) == int(row[1]):
+        return None
+    return {
+        "row": int(r0),
+        "gray_color": int(row[1]),
+        "key_color": int(row[0]),
+        "factor": int(width - 1),
+        "bbox": (r0, c0, r1, c1),
+    }
+
+
+def _scene_parts(grid: np.ndarray) -> tuple[int, list[dict], dict[int, int], tuple[int, int]]:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
