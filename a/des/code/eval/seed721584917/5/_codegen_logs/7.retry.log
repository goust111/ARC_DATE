+    canvas_h = max(template_column_height + random.randint(*CANVAS_EXTRA_RANGE), outer_size + 2 * margin_y)
+    canvas_w = outer_size + 2 * margin_x + random.randint(*CANVAS_EXTRA_RANGE)
+
