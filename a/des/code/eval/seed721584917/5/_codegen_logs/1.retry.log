+
+def _find_palette_band(grid: np.ndarray, bg: int) -> tuple[int, int, int, list[int]]:
+    h, w = grid.shape
+    candidates = []
+    for color in map(int, np.unique(grid)):
+        if color == bg:
+            continue
+        full_rows = [r for r in range(h) if np.all(grid[r, :] == color)]
+        if len(full_rows) < 2:
+            continue
