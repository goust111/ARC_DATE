+        if not mask.any():
+            continue
+        mask = _tight_crop(mask)
+        area = int(mask.sum())
+        if area < 8:
+            continue
+        if not _mask_is_connected(mask):
+            continue
+        if area == mask.size and random.random() < 0.8:
+            continue
+        if random.choice([False, True]):
+            mask = np.flipud(mask)
+        if random.choice([False, True]):
+            mask = np.fliplr(mask)
+        return np.asarray(mask, dtype=bool)
