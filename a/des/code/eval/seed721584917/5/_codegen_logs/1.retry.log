+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    h, w = mask.shape
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            shifted = np.zeros_like(mask)
+            r_src0 = max(0, -dr)
+            r_src1 = min(h, h - dr)
+            c_src0 = max(0, -dc)
+            c_src1 = min(w, w - dc)
+            r_dst0 = max(0, dr)
+            r_dst1 = min(h, h + dr)
+            c_dst0 = max(0, dc)
+            c_dst1 = min(w, w + dc)
