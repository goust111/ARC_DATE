+            notch_h = random.randint(1, h - 2)
+            notch_w = random.randint(1, w - 2)
+            if corner == "tl":
+                mask[:notch_h, :notch_w] = False
+            elif corner == "tr":
+                mask[:notch_h, w - notch_w :] = False
+            elif corner == "bl":
+                mask[h - notch_h :, :notch_w] = False
+            else:
+                mask[h - notch_h :, w - notch_w :] = False
