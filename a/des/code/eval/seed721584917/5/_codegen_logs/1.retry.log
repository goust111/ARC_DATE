+def _make_tile(seed_color: int, pattern_color: int, tile_h: int, tile_w: int) -> np.ndarray:
+    tile = np.full((tile_h, tile_w), BG, dtype=int)
+    tile[0, 0] = int(seed_color)
+    tile[_choose_pattern_mask(tile_h, tile_w)] = int(pattern_color)
