+            for bottom in full_rows[i + 1 :]:
+                if bottom - top < 2:
+                    continue
+                band = grid[top : bottom + 1, :]
+                sep_cols = [c for c in range(w) if np.all(band[:, c] == color)]
+                if len(sep_cols) < 3 or sep_cols[0] != 0 or sep_cols[-1] != w - 1:
+                    continue
