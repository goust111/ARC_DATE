+    min_width = max(GRID_W_RANGE[0], marker_width + 2)
+    if min_width >= GRID_W_RANGE[1]:
+        return None
+    scene_h = int(_RNG.integers(*SCENE_H_RANGE))
+    width = int(_RNG.integers(min_width, GRID_W_RANGE[1]))
