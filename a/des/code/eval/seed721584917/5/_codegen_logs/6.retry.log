+            arr = np.array(coords, dtype=int)
+            r0, c0 = arr.min(axis=0)
+            r1, c1 = arr.max(axis=0)
+            patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+            patch[arr[:, 0] - r0, arr[:, 1] - c0] = color
+            components.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "patch": patch,
+                }
+            )
