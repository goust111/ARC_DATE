+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            r0, c0 = arr.min(axis=0)
+            r1, c1 = arr.max(axis=0)
+            patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+            patch[arr[:, 0] - r0, arr[:, 1] - c0] = color
+            components.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "patch": patch,
+                }
+            )
+
+    return components
+
+
+def _classify_direction(component: dict) -> str:
+    r0, c0, r1, c1 = component["bbox"]
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+
+    if width > 2 * height:
+        return HORIZONTAL
+    if height > 2 * width:
+        return VERTICAL
+
+    rel = component["coords"] - np.array([r0, c0], dtype=int)
+    down_score = float(np.var(rel[:, 0] - rel[:, 1]))
+    up_score = float(np.var(rel[:, 0] + rel[:, 1]))
+    if down_score < up_score:
+        return DIAG_DOWN
+    if up_score < down_score:
+        return DIAG_UP
