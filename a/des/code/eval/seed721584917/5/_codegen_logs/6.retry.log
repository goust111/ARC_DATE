import numpy as np


HORIZONTAL = "horizontal"
VERTICAL = "vertical"
DIAG_DOWN = "diag_down"
DIAG_UP = "diag_up"

CANONICAL_DIRECTIONS = (HORIZONTAL, VERTICAL, DIAG_DOWN, DIAG_UP)
DIR_TO_MARKER = {
