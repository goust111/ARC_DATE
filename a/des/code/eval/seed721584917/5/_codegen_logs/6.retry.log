+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
