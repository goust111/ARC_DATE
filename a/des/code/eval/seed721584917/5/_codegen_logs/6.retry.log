+
+
+def _gen_attempt() -> np.ndarray | None:
+    bg = int(BG_CHOICES[int(_RNG.integers(0, len(BG_CHOICES)))])
+    active_dirs = _sample_active_directions()
+    counts = _sample_direction_counts(active_dirs)
+    total_objects = sum(counts.values())
