+DIAG_OPTIONS = [
+    (dr, dc)
+    for dr in range(1, 5)
+    for dc in range(1, 5)
+    if 3 <= dr + dc + 1 <= 8 and not ((dc + 1) > 2 * (dr + 1) or (dr + 1) > 2 * (dc + 1))
