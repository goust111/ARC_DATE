+            for c0 in range(width - pw + 1):
+                rr0 = max(0, r0 - 1)
+                rr1 = min(scene_h, r0 + ph + 1)
+                cc0 = max(0, c0 - 1)
+                cc1 = min(width, c0 + pw + 1)
+                if not blocked[rr0:rr1, cc0:cc1].any():
