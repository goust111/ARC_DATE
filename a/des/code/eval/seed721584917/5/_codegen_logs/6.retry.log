+        group = sorted(
+            [obj for obj in objects if obj["direction"] == direction],
+            key=lambda obj: (obj["bbox"][0], obj["bbox"][1]),
+        )
+        for obj in group:
+            patch = obj["patch"]
+            ph, pw = patch.shape
+            dst = out[cursor : cursor + ph, col0 : col0 + pw]
+            mask = patch != bg
+            dst[mask] = patch[mask]
+            cursor += ph
+
+    return out
+
+
