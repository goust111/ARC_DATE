+
+def _build_input(scene_h: int, width: int, bg: int, active_dirs: list[str], scene: np.ndarray) -> np.ndarray:
+    grid = np.full((scene_h + 2, width), bg, dtype=int)
+    grid[:scene_h, :] = scene
