+        r0, c0 = candidates[int(_RNG.integers(0, len(candidates)))]
+        mask = patch != bg
+        scene[r0 : r0 + ph, c0 : c0 + pw][mask] = patch[mask]
+        blocked[max(0, r0 - 1) : min(scene_h, r0 + ph + 1), max(0, c0 - 1) : min(width, c0 + pw + 1)] = True
+        used_top_rows[obj["direction"]].add(r0)
+        placed.append(
