+
+
+def _repeated_shuffle(rng: np.random.Generator, items: tuple[object, ...], count: int) -> list[object]:
+    pool: list[object] = []
+    while len(pool) < count:
+        chunk = list(items)
+        rng.shuffle(chunk)
