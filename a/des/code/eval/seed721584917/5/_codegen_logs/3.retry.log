+LAYOUT_CHOICES = (
+    (1, 2),
+    (2, 1),
+    (1, 3),
+    (3, 1),
+    (2, 2),
+    (2, 3),
+    (3, 2),
+)
+
+REGION_SIZE_MIN = 6
+REGION_SIZE_MAX = 9
