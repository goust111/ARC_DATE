+
+def _grow_connected(
+    rng: np.random.Generator,
+    allowed: set[tuple[int, int]],
+    count: int,
+    must_touch: set[tuple[int, int]] | None,
+) -> list[tuple[int, int]] | None:
+    if len(allowed) < count:
+        return None
+
+    starts = list(must_touch if must_touch is not None else allowed)
+    if not starts:
