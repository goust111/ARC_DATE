+    return parts
+
+
+def _separator_spec(grid: np.ndarray, bg: int) -> tuple[int, set[int], set[int]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    candidates: list[tuple[int, int, set[int], set[int]]] = []
+
+    for color in map(int, np.unique(g)):
