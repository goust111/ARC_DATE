+def _find_legend(grid: np.ndarray, bg: int):
+    candidates = []
+    for corner in CORNERS:
+        cand = _legend_candidate(grid, bg, corner)
+        if cand is not None:
+            candidates.append(cand)
+    assert len(candidates) == 1, "expected exactly one corner legend"
