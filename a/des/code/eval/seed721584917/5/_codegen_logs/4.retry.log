+    comps: list[dict] = []
+    for r0 in range(h):
+        for c0 in range(w):
+            color = int(grid[r0, c0])
+            if visited[r0, c0] or forbidden[r0, c0] or color == int(bg):
+                continue
+            stack = [(int(r0), int(c0))]
+            visited[r0, c0] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                coords.append((int(r), int(c)))
+                for dr, dc in DIR4:
