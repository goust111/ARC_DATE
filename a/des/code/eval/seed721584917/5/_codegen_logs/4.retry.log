+    cols, col_counts = np.unique(coords[:, 1], return_counts=True)
+    if int(row_counts.max()) < 3 or int(col_counts.max()) < 3:
+        return None
+    if int(np.count_nonzero(row_counts == row_counts.max())) != 1:
