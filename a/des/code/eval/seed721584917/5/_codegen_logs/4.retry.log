+    chosen = candidates[0]
+    r0, c0, height, width = chosen["rect"]
+    legend_mask = np.zeros_like(grid, dtype=bool)
+    legend_mask[r0 : r0 + height, c0 : c0 + width] = True
+    mappings = {idx + 1: group for idx, group in enumerate(chosen["groups"])}
