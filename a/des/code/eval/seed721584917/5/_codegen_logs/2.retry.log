+    if not _place_pieces(grid, frame_bbox, piece_patches, bg):
+        return None
+
+    counts = Counter(map(int, grid.reshape(-1)))
+    if counts[int(bg)] != max(counts.values()) or list(counts.values()).count(counts[int(bg)]) != 1:
+        return None
+
+    try:
+        out = main(grid)
