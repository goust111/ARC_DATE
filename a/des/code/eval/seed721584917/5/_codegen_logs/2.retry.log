+        occupied = np.zeros((frame_h, frame_w), dtype=bool)
+        used_keys: set[tuple[tuple[int, int], bytes]] = set()
+        notches: list[dict] = []
+        ok = True
+        for shape in plan:
+            notch = _sample_notch(shape, frame_h, frame_w, occupied, used_keys)
+            if notch is None:
