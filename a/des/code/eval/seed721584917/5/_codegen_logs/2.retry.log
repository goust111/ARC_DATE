+        key = _shape_key(local_mask)
+        if key in used_keys:
+            continue
+        if side == "top":
+            rr = 0
+            cc = random.randint(1, frame_w - box_w - 1)
+        elif side == "bottom":
+            rr = frame_h - box_h
+            cc = random.randint(1, frame_w - box_w - 1)
+        elif side == "left":
+            rr = random.randint(1, frame_h - box_h - 1)
+            cc = 0
+        else:
+            rr = random.randint(1, frame_h - box_h - 1)
+            cc = frame_w - box_w
