+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(out, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid puzzle input")

