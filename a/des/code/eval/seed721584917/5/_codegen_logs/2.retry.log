+# --------------- generator ---------------
+
+GRID_H_RANGE = (24, 31)
+GRID_W_RANGE = (24, 31)
+FRAME_H_RANGE = (11, 18)
+FRAME_W_RANGE = (11, 18)
+NOTCH_COUNT_RANGE = (3, 6)
+DEPTH_RANGE = (2, 4)
+SPAN_RANGE = (3, 7)
+GEN_ATTEMPTS = 400
+NOTCH_ATTEMPTS = 120
+PIECE_ATTEMPTS = 200
