+
+def _sample_frame_origin(grid_h: int, grid_w: int, frame_h: int, frame_w: int) -> tuple[int, int]:
+    base_r = (grid_h - frame_h) // 2
+    base_c = (grid_w - frame_w) // 2
+    r_min = 2
+    c_min = 2
+    r_max = grid_h - frame_h - 2
