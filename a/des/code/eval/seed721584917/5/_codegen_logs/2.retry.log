+            used_keys.add(_shape_key(notch["mask"]))
+            notches.append(notch)
+        if not ok:
+            continue
+
+        shape_counts = Counter(tuple(map(int, notch["mask"].shape)) for notch in notches)
+        if ambiguous and max(shape_counts.values()) < 2:
