+        for _j in range(length - 1):
+            prev = vals[-1]
+            lo = max(1, prev - 1)
+            hi = min(depth, prev + 1)
+            vals.append(random.randint(lo, hi))
+        if max(vals) < depth:
+            vals[random.randrange(length)] = depth
+        if len(set(vals)) == 1:
+            idx = random.randrange(length)
+            vals[idx] = depth - 1 if vals[idx] == depth else depth
