+        full_mask = np.zeros((frame_h, frame_w), dtype=bool)
+        full_mask[rr : rr + box_h, cc : cc + box_w] = local_mask
+        if bool((full_mask & blocked).any()):
+            continue
+        return {
+            "bbox": (int(rr), int(cc), int(rr + box_h - 1), int(cc + box_w - 1)),
+            "mask": local_mask,
+            "full_mask": full_mask,
