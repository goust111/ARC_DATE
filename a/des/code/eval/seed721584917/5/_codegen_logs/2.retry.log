+
+def _place_pieces(
+    grid: np.ndarray,
+    frame_bbox: tuple[int, int, int, int],
+    piece_patches: list[np.ndarray],
+    bg: int,
+) -> bool:
+    h, w = grid.shape
+    placed_rects = [frame_bbox]
