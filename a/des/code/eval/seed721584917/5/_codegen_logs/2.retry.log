+def _paint(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int) -> None:
+    h, w = patch.shape
+    sub = grid[r0 : r0 + h, c0 : c0 + w]
+    mask = patch != int(bg)
