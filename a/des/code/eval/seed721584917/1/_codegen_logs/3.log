+        rh, rw = rotated.shape
+        assert 0 <= top and 0 <= left and top + rh <= h and left + rw <= w
+        target_labels = labels[top : top + rh, left : left + rw]
+        assert np.all(target_labels == target_room), "moved pattern bbox must stay inside the neighboring room"
