+                    if 0 <= nr < h and 0 <= nc < w and not wall_mask[nr, nc] and labels[nr, nc] == -1:
+                        labels[nr, nc] = room_id
+                        q.append((nr, nc))
+            rooms.append(np.asarray(pts, dtype=int))
+            room_id += 1
