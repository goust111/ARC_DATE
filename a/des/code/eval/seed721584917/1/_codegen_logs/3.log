+def _key_candidates(room: Room, pattern_mask: np.ndarray, top: int, left: int) -> list[tuple[int, int]]:
+    pts = [(top + r, left + c) for r, c in np.argwhere(pattern_mask != 0)]
+    pr0, pc0 = top, left
