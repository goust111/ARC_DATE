+    used_signatures: set[tuple[int, ...]] = set()
+    pairs: list[dict] = []
+    used_inputs: list[tuple[int, int, int, int]] = []
+    used_outputs: list[tuple[int, int, int, int]] = []
+
+    for idx in range(pair_count):
