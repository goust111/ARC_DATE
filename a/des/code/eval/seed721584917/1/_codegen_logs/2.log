+    interior = [
+        (r, c)
+        for r in range(1, box_h - 1)
+        for c in range(1, box_w - 1)
+        if bool(mask[r, c])
+    ]
+    if interior:
+        return rng.choice(interior)
+    coords = [(int(r), int(c)) for r, c in np.argwhere(mask)]
+    return rng.choice(coords)
