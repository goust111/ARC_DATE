+def _find_matching(fragments: list[dict]) -> list[tuple[int, int]]:
+    n = len(fragments)
+    candidates = {
+        i: [j for j in range(n) if i != j and _can_pair(fragments[i], fragments[j])]
+        for i in range(n)
