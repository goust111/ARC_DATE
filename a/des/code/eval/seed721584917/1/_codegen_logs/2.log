+    for _ in range(400):
+        top = (0, rng.randrange(box_w))
+        bottom = (box_h - 1, rng.randrange(box_w))
+        left = (rng.randrange(box_h), 0)
+        right = (rng.randrange(box_h), box_w - 1)
