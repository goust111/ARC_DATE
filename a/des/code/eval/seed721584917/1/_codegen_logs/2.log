+        used_inputs.append(_box_from_tl(p1[0], p1[1], box_h, box_w))
+        used_inputs.append(_box_from_tl(p2[0], p2[1], box_h, box_w))
+        used_outputs.append(_box_from_tl(out_top, out_left, box_h, box_w))
+
+        pairs.append(
