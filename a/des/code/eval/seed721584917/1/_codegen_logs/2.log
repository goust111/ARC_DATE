+        comp: np.ndarray | None = None
+        for _ in range(200):
+            cand = _sample_mask(box_h, box_w, rng)
+            inv = ~cand
+            sig_a = _mask_signature(cand)
+            sig_b = _mask_signature(inv)
+            if sig_a in used_signatures or sig_b in used_signatures:
