+    for _ in range(400):
+        top = (0, rng.randrange(box_w))
+        bottom = (box_h - 1, rng.randrange(box_w))
+        left = (rng.randrange(box_h), 0)
+        right = (rng.randrange(box_h), box_w - 1)
+
+        cells = set(_random_path(top, bottom, rng))
+        cells.update(_random_path(left, rng.choice(tuple(cells)), rng))
+        cells.update(_random_path(right, rng.choice(tuple(cells)), rng))
+        if len(cells) > max_fill:
