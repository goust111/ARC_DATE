+
+def _random_path(start: tuple[int, int], goal: tuple[int, int], rng: random.Random) -> list[tuple[int, int]]:
+    r, c = start
+    path = [(r, c)]
+    while (r, c) != goal:
+        moves: list[tuple[int, int]] = []
+        if r < goal[0]:
+            moves.append((r + 1, c))
+        elif r > goal[0]:
+            moves.append((r - 1, c))
+        if c < goal[1]:
+            moves.append((r, c + 1))
+        elif c > goal[1]:
+            moves.append((r, c - 1))
+        r, c = rng.choice(moves)
+        path.append((r, c))
