+    out = np.full_like(g, bg)
+    for i, j in pairing:
+        a = fragments[i]
+        b = fragments[j]
+        color = _pair_border_color(a, b)
+        top = min(int(a["top_left"][0]), int(b["top_left"][0]))
+        left = min(int(a["top_left"][1]), int(b["top_left"][1]))
