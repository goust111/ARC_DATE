+def _draw_frame(out: np.ndarray, top: int, left: int, height: int, width: int, color: int, bg: int) -> None:
+    out[top : top + height, left : left + width] = bg
+    out[top, left : left + width] = color
+    out[top + height - 1, left : left + width] = color
