+def _box_from_tl(top: int, left: int, height: int, width: int) -> tuple[int, int, int, int]:
+    return top, left, top + height - 1, left + width - 1
+
+
+def _separate(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int = 1) -> bool:
+    return bool(
+        a[2] + gap < b[0]
+        or b[2] + gap < a[0]
+        or a[3] + gap < b[1]
+        or b[3] + gap < a[1]
