+        b1 = _box_from_tl(p1[0], p1[1], box_h, box_w)
+        b2 = _box_from_tl(p2[0], p2[1], box_h, box_w)
+        bo = _box_from_tl(out_top, out_left, box_h, box_w)
+        if not _separate(b1, b2, gap=1):
