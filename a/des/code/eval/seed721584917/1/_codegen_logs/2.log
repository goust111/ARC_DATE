+
+
+def _pick_window(mask: np.ndarray, rng: random.Random) -> tuple[int, int]:
+    box_h, box_w = mask.shape
+    interior = [
+        (r, c)
+        for r in range(1, box_h - 1)
+        for c in range(1, box_w - 1)
+        if bool(mask[r, c])
+    ]
