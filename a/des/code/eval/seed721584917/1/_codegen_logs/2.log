+        mask = np.zeros((box_h, box_w), dtype=bool)
+        for r, c in cells:
+            mask[r, c] = True
+
+        inv = ~mask
+        if not _touches_all_sides(mask) or not _touches_all_sides(inv):
+            continue
+        if len(_components(mask)) != 1 or len(_components(inv)) != 1:
