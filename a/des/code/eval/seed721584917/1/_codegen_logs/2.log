+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 8
+BLACK = 0
+PALETTE = (1, 2, 3, 4, 5, 6, 7, 9)
+GEN_RETRIES = 500
+
+
+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < h:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < w:
+        out.append((r, c + 1))
+    return out
+
+
+def _neighbors8(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w:
+                out.append((nr, nc))
+    return out
+
+
+def _components(mask: np.ndarray, connectivity: int = 4) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    neigh = _neighbors4 if connectivity == 4 else _neighbors8
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in neigh(rr, cc, h, w):
+                    if bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _touches_all_sides(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any())
+
+
+def _mask_signature(mask: np.ndarray) -> tuple[int, ...]:
+    return tuple(int(x) for x in mask.astype(np.uint8).ravel())
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _extract_fragments(grid: np.ndarray) -> tuple[list[dict], int, tuple[int, int]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    bg = _get_bg(g)
+    fg = (g != bg) & (g != BLACK)
+    seen = np.zeros((h, w), dtype=bool)
+    fragments: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not bool(fg[r, c]) or bool(seen[r, c]):
+                continue
+            color = int(g[r, c])
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors8(rr, cc, h, w):
+                    if bool(seen[nr, nc]) or not bool(fg[nr, nc]) or int(g[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+
+            r0, c0, r1, c1 = _bbox(coords)
+            sub = g[r0 : r1 + 1, c0 : c1 + 1]
+            mask = sub == color
+            wins = np.argwhere(sub == BLACK)
+            assert len(wins) == 1, "each fragment bbox must contain exactly one black window"
+            wr, wc = map(int, wins[0])
+            assert not bool(mask[wr, wc]), "window must be on an uncovered cell"
+            fragments.append(
+                {
+                    "color": color,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "top_left": (int(r0), int(c0)),
+                    "mask": mask,
+                    "window": (int(wr), int(wc)),
