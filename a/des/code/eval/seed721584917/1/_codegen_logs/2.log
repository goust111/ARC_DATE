+        if any(not _separate(b1, prev, gap=1) or not _separate(b2, prev, gap=1) for prev in used_inputs):
+            continue
+        if any(not _separate(bo, prev, gap=1) for prev in used_outputs):
+            continue
+        return p1, p2, (out_top, out_left)
+    return None
