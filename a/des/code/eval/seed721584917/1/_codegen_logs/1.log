+
+def _sample_pattern(
+    used_patterns: set[tuple[tuple[int, int], ...]], primary: tuple[int, int] | None = None
+) -> tuple[tuple[int, int], ...]:
+    choices = list(PRIMARY_PATTERNS[primary] if primary is not None else GENERAL_PATTERNS)
+    random.shuffle(choices)
+    for pattern in choices:
