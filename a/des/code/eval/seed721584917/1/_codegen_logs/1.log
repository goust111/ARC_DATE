+
+def _free_for_seed(
+    area: np.ndarray,
+    pos: tuple[int, int],
+    placed: dict[int, tuple[int, int]],
+    keep_clear_of_walls: bool,
+    forbidden: set[tuple[int, int]],
+) -> bool:
+    h, w = area.shape
+    r, c = pos
