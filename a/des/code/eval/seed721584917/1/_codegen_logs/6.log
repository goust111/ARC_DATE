+            components.append({"color": color, "cells": cells, "cell_set": set(cells), "area": len(cells)})
+    return components
+
+
+CARDINALS: dict[str, tuple[Vec, Vec]] = {
+    "right": ((0, 1), (1, 0)),
+    "left": ((0, -1), (1, 0)),
+    "down": ((1, 0), (0, 1)),
+    "up": ((-1, 0), (0, 1)),
+}
+
+
+def _build_arrow_templates() -> dict[frozenset[Coord], dict[str, object]]:
