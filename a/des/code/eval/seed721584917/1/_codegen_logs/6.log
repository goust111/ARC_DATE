+            for dc in (-1, 0, 1):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < shape[0] and 0 <= nc < shape[1]:
+                    padded.add((nr, nc))
+    return padded
+
+
+def _scenario_spec(
