+
+
+def _grid_size(count: int, rng: random.Random) -> tuple[int, int]:
+    ranges = {
+        1: (14, 18),
+        2: (18, 22),
+        3: (21, 24),
+    }
+    lo, hi = ranges[count]
+    return rng.randint(lo, hi), rng.randint(lo, hi)
+
+
