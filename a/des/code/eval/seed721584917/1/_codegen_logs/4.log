+    remaining = int(total)
+    for idx in range(parts):
+        if idx == parts - 1:
+            widths.append(remaining)
+            break
+        min_rest = (parts - idx - 1) * min_each
+        value = random.randint(min_each, remaining - min_rest)
+        widths.append(value)
+        remaining -= value
+    random.shuffle(widths)
+    return widths
