+        elif quadrant == "ne":
+            top_pad, left_pad, bottom_pad, right_pad = small(), large(), large(), small()
+        elif quadrant == "sw":
+            top_pad, left_pad, bottom_pad, right_pad = large(), small(), small(), large()
+        else:
+            top_pad, left_pad, bottom_pad, right_pad = large(), large(), small(), small()
