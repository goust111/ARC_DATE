+
+
+def _rects_intersect(a: tuple[int, int, int, int], b: tuple[int, int, int, int], margin: int = 0) -> bool:
+    ar0, ac0, ah, aw = a
+    br0, bc0, bh, bw = b
+    ar1 = ar0 + ah - 1
+    ac1 = ac0 + aw - 1
+    br1 = br0 + bh - 1
+    bc1 = bc0 + bw - 1
