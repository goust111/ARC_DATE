+def _source_pattern(grid: np.ndarray, frame: dict) -> np.ndarray:
+    r0, c0, r1, c1 = frame["bbox"]
+    interior = grid[r0 + 1 : r1, c0 + 1 : c1]
+    assert set(map(int, np.unique(interior))) <= {BLACK, GREY}
