+        (r0, c0): "tl",
+        (r0, c1): "tr",
+        (r1, c1): "br",
+        (r1, c0): "bl",
+    }
+    assert cell in mapping, "marker pixel must be at a frame corner"
+    return mapping[cell]
+
+
+def _corner_cell(bbox: tuple[int, int, int, int], turns_cw: int) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    mapping = {
+        0: (r0, c0),
+        1: (r0, c1),
+        2: (r1, c1),
+        3: (r1, c0),
+    }
+    return mapping[int(turns_cw)]
