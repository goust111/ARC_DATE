+        height = r1 - r0 + 1
+        width = c1 - c0 + 1
+        orientation = "H" if direction in ("R", "L") else "V"
+
+        out[comp[:, 0], comp[:, 1]] = bg
+
+        if orientation == "H":
+            rail_local = rail_abs - r0
+            out[rail_abs, c0 : c1 + 1] = RAIL
+        else:
+            rail_local = rail_abs - c0
