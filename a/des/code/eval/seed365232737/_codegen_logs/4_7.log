+        else:
+            patch[:, rail_local] = absorb
+        return patch
+
+    if (height, width) == (1, 2):
+        if orientation == "H":
+            front_c = 1 if direction == "R" else 0
+            patch[0, front_c] = absorb
+        else:
+            patch[0, rail_local] = absorb
+        return patch
+
+    if (height, width) == (2, 1):
+        if orientation == "H":
+            patch[rail_local, 0] = absorb
+        else:
