+        if hits:
+            side_hits["R"] = hits
+    if c0 - 1 >= 0:
+        hits = [r for r in range(r0, r1 + 1) if int(grid[r, c0 - 1]) not in (bg, slider_color)]
+        if hits:
+            side_hits["L"] = hits
+    if r1 + 1 < grid.shape[0]:
+        hits = [c for c in range(c0, c1 + 1) if int(grid[r1 + 1, c]) not in (bg, slider_color)]
+        if hits:
