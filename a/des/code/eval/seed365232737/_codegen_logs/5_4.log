+def _tiled_holes(stamp_patch: np.ndarray, bg: int, out_h: int, out_w: int) -> np.ndarray:
+    hole_mask = stamp_patch == int(bg)
+    rr = np.arange(int(out_h))[:, None] % hole_mask.shape[0]
+    cc = np.arange(int(out_w))[None, :] % hole_mask.shape[1]
