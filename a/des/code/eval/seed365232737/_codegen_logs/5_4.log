+        w = int(obj["width"])
+        holes = int(obj["holes"])
+        if 3 <= h <= 5 and 3 <= w <= 5 and 1 <= holes <= 3:
+            stamps.append(obj)
+        elif holes == 0:
+            canvases.append(obj)
+        else:
+            raise AssertionError("unexpected object shape")
+    assert len(stamps) == len(canvases) >= 2
+    return stamps, canvases
+
