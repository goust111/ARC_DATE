                "stamp_color": int(stamp_colors[i]),
                "canvas_color": int(canvas_colors[i]),
                "stamp_h": int(stamp_h),
                "stamp_w": int(stamp_w),
                "canvas_h": int(canvas_h),
                "canvas_w": int(canvas_w),
                "x_offset": int(x_offset),
