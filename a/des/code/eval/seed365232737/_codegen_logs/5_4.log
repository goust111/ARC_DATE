        canvas_heights.append(canvas_h)
        stamp_tops.append(random.randint(1, 3))

    width = int(left_margin + sum(canvas_widths) + sum(gaps) + right_margin)
    if width > GRID_W_MAX:
        return None

    x_positions: list[int] = []

