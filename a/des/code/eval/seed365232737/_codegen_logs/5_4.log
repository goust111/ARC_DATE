+    for stamp in sorted(stamps, key=lambda obj: (obj["bbox"][0], obj["bbox"][1])):  # type: ignore[index]
+        sr0, sc0, sr1, sc1 = stamp["bbox"]  # type: ignore[misc]
+        candidates: list[tuple[int, int, int, int]] = []
