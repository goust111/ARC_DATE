 147: def _inside_box(coords: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
 148:     r0, c0, r1, c1 = box
 149:     return (coords[:, 0] >= r0) & (coords[:, 0] <= r1) & (coords[:, 1] >= c0) & (coords[:, 1] <= c1)
