 137: def _expanded_bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
 138:     r0, c0, r1, c1 = bbox_coords(coords)
 139:     return (
 140:         max(0, r0 - BBOX_PAD),
 141:         max(0, c0 - BBOX_PAD),
 142:         min(GRID_HEIGHT - 1, r1 + BBOX_PAD),
 143:         min(GRID_WIDTH - 1, c1 + BBOX_PAD),
 144:     )
