 118: def _legal_origins(n_pairs: int, dot_rows: int, dot_cols: int) -> list[tuple[int, int]]:
 119:     origins: list[tuple[int, int]] = []
 120:     max_r = GRID_HEIGHT - 1 - BBOX_PAD - DOT_STRIDE * (dot_rows - 1)
 121:     max_c = GRID_WIDTH - 1 - BBOX_PAD - DOT_STRIDE * (dot_cols - 1)
 122:     for r in range(BBOX_PAD, max_r + 1):
 123:         for c in range(BBOX_PAD, max_c + 1):
 124:             box = _origin_bbox((r, c), dot_rows, dot_cols)
