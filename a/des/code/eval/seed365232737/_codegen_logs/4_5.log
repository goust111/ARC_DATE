 152: def _separated_by_gap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
 153:     return (
 154:         a[2] + NON_OVERLAP_GAP < b[0]
 155:         or b[2] + NON_OVERLAP_GAP < a[0]
 156:         or a[3] + NON_OVERLAP_GAP < b[1]
