 208: def main(grid: np.ndarray) -> np.ndarray:
 209:     """
 210:     Convert a rough nested line drawing into a clean canonical frame-and-dot diagram.
 211: 
 212:     Input structure:
 213:     - The grid has one background color and one foreground color.
 214:     - Foreground 4-connected objects are rough closed frames or small filled blobs.
 215:     - Frames may contain other frames/blobs; blobs outside a frame remain outside it.
 216: 
 217:     Rule:
 218:     - Detect the containment tree of foreground objects using holes of each frame object.
 219:     - Replace every blob with one foreground pixel.
 220:     - Replace every frame with a rectangular border padded two cells around its direct children.
 221:     - Place siblings by their original row/column overlap and order, with one empty cell between canonical objects.
 222: 
 223:     Key insight: The exact wobbly geometry is irrelevant; only enclosure plus relative sibling positions define the output.
 224:     """
 225:     g = np.asarray(grid, dtype=int)
 226:     bg = int(get_bg(g))
 227:     fg_colors = sorted(set(map(int, g.flatten())) - {bg})
 228:     assert len(fg_colors) == 1
 229:     fg = int(fg_colors[0])
 230: 
 231:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[fg], return_format="dict")
 232:     assert comps
 233: 
 234:     nodes: list[_Node] = []
 235:     holes: list[list[np.ndarray]] = []
 236:     for comp in comps:
 237:         coords = np.asarray(comp["coords"], dtype=int)
 238:         node = _Node(
 239:             coords=coords,
 240:             bbox=tuple(map(int, comp["bbox"])),
 241:             center=coords.mean(axis=0),
 242:         )
 243:         node_holes = _component_holes(g.shape, coords)
 244:         node.is_frame = bool(node_holes)
 245:         nodes.append(node)
 246:         holes.append(node_holes)
 247: 
 248:     assert any(node.is_frame for node in nodes)
 249:     for node_i, node in enumerate(nodes):
 250:         containers = []
 251:         for frame_i, frame in enumerate(nodes):
 252:             if node_i == frame_i or not frame.is_frame:
 253:                 continue
 254:             if any(np.all(hole[tuple(node.coords.T)]) for hole in holes[frame_i]):
 255:                 containers.append(frame)
 256:         if containers:
 257:             node.parent = min(containers, key=lambda item: int(item.coords.shape[0]))
 258:             node.parent.children.append(node)
 259: 
 260:     roots = [node for node in nodes if node.parent is None]
 261:     mask = _layout_root(roots)
 262:     out = np.full(mask.shape, bg, dtype=int)
 263:     out[mask] = fg
 264:     return out
