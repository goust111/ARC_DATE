+            if extra and int(mask.sum()) < target:
+                er, ec = extra[int(rng.integers(len(extra)))]
+                frontier.discard((er, ec))
+                mask[er, ec] = True
+                for nxt in _adjacent_open_cells(mask, er, ec):
+                    frontier.add(nxt)
