+
+def _neighbors_in_bounds(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    for dr, dc in NEIGHBORS4:
+        nr = r + dr
+        nc = c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            cells.append((nr, nc))
