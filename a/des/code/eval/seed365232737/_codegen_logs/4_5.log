  35:                 continue
  36:             v = int(g[r, c])
  37:             if v == int(bg):
  38:                 continue
  39:             ok = True
  40:             for rr, cc in neighbors4(int(r), int(c)):
  41:                 if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):
  42:                     ok = False
  43:                     break
