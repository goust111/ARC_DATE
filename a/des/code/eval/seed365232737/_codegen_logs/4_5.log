+    if not mask.any():
+        return None
+    mask = _crop_to_bbox(mask)
+    h, w = mask.shape
+    area = int(mask.sum())
+    if h < 5 or w < 5:
+        return None
+    if area < color_count * 6:
+        return None
+    if area >= h * w:
