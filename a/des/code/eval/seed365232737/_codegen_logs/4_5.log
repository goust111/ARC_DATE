 133: def _shift_is_valid(coords: np.ndarray, occupied: np.ndarray, dr: int, dc: int) -> bool:
 134:     rr = coords[:, 0] + dr
 135:     cc = coords[:, 1] + dc
 136:     return (
 137:         int(rr.min()) >= 0
 138:         and int(cc.min()) >= 0
 139:         and int(rr.max()) < occupied.shape[0]
 140:         and int(cc.max()) < occupied.shape[1]
 141:         and not bool(occupied[rr, cc].any())
 142:     )
