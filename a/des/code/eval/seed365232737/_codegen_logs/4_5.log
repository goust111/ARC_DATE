 124: def _coords_in_bounds(coords: np.ndarray, shape: tuple[int, int]) -> bool:
 125:     return (
 126:         int(coords[:, 0].min()) >= 0
 127:         and int(coords[:, 1].min()) >= 0
 128:         and int(coords[:, 0].max()) < shape[0]
 129:         and int(coords[:, 1].max()) < shape[1]
 130:     )
