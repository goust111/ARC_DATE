+    right_pad = int(rng.integers(1, 4))
+    gap = int(rng.integers(2, 6))
+    height = max(crop_h + int(rng.integers(2, 7)), len(order) + int(rng.integers(2, 7)))
+    width = left_pad + crop_w + gap + 1 + right_pad
