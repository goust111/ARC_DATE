 130: def _dot_coords(origin: tuple[int, int], dot_rows: int, dot_cols: int) -> np.ndarray:
 131:     rows = origin[0] + DOT_STRIDE * np.arange(dot_rows)
 132:     cols = origin[1] + DOT_STRIDE * np.arange(dot_cols)
 133:     rr, cc = np.meshgrid(rows, cols, indexing="ij")
 134:     return np.stack([rr.ravel(), cc.ravel()], axis=1).astype(int)
