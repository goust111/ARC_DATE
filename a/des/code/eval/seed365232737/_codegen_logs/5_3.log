+    count_map = {int(v): int(n) for v, n in zip(values, counts)}
+    if count_map[bg] != max(count_map.values()):
+        return False
+    if count_map[bg] == max(v for k, v in count_map.items() if k != bg):
+        return False
+    return True
+
+
