+def _tree_distances(source: tuple[int, int], adj: dict[tuple[int, int], list[tuple[int, int]]]) -> dict[tuple[int, int], int]:
+    dist = {source: 0}
+    q = deque([source])
+    while q:
+        cell = q.popleft()
+        for nbr in adj[cell]:
