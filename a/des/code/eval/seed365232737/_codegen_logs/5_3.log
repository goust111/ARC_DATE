+def _tree_adjacency(selected: set[tuple[int, int]], edges: list[tuple[tuple[int, int], tuple[int, int]]]) -> dict[tuple[int, int], list[tuple[int, int]]]:
+    adj = {cell: [] for cell in selected}
+    for a, b in edges:
