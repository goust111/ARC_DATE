+BLACK = 0
+PLATE_COLOR = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+SIDES = ("left", "right", "top", "bottom")
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = [
