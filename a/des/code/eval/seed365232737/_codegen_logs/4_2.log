+        assert c1 != c2, "paired marker colors must differ"
+        assert c1 not in color_map and c2 not in color_map, "marker colors must be unique"
+        color_map[c1] = c2
+        color_map[c2] = c1
+
+    marker_count = 0
+    pieces: list[dict[str, np.ndarray | int]] = []
