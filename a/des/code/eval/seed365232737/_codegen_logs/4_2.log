+
+
+def _place_notches(plate_h: int, plate_w: int, specs: list[dict[str, object]]) -> list[dict[str, object]] | None:
+    for _ in range(NOTCH_RETRIES):
+        used = np.zeros((plate_h, plate_w), dtype=bool)
+        placed: list[dict[str, object]] = []
+        ok = True
+        order = specs[:]
