+    occupied = np.zeros((height, width), dtype=bool)
+    used = [False] * len(pieces)
+    order = sorted(
+        range(len(pieces)),
+        key=lambda i: (
+            -int(pieces[i].shape[0]),
+            -_piece_dims(pieces[i])[0],
+            -_piece_dims(pieces[i])[1],
+        ),
