+def _components_of_mask(mask: np.ndarray) -> list[np.ndarray]:
+    """Return 4-connected components as coordinate arrays."""
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
