+    items = []
+    for color in np.unique(g):
+        color = int(color)
+        if color == 0:
+            continue
+        comps = _components_of_mask(g == color)
+        assert 2 <= len(comps) <= 4, "each color must appear in 2 to 4 fragments"
+        pieces = [_normalize_coords(comp) for comp in comps]
