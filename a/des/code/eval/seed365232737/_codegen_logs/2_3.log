+def _can_tile_rectangle(pieces: list[np.ndarray], height: int, width: int) -> bool:
+    """Exact-cover search over translations only."""
+    total_area = sum(int(piece.shape[0]) for piece in pieces)
+    if total_area != height * width:
+        return False
