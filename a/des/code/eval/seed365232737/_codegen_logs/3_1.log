+
+def _same_layout(specs_a: list[dict], specs_b: list[dict]) -> bool:
+    a = sorted(
+        (
+            spec["bbox"],
+            spec["direction"],
+            spec["gap0"],
+            spec["gap1"],
+            spec["seed_color"],
+            spec["seed_count"],
+        )
+        for spec in specs_a
+    )
+    b = sorted(
+        (
+            spec["bbox"],
+            spec["direction"],
+            spec["gap0"],
+            spec["gap1"],
+            spec["seed_color"],
+            spec["seed_count"],
+        )
+        for spec in specs_b
+    )
+    return a == b
