+    return _apply_beams(g, fences)
+
+
+def _choose_gap_len(rng: random.Random, seed_count: int) -> int:
+    if seed_count % 2 == 1:
+        return rng.choice([1, 3])
+    return rng.choice([1, 2, 3])
