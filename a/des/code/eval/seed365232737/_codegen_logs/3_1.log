+
+FENCE_COLOR = 5
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS = ("up", "down", "left", "right")
+GEN_RETRIES = 400
+PLACE_RETRIES = 250
