+            if min_h > max_h:
+                continue
+            rect_h = rng.randint(min_h, max_h)
+            if (rect_h - 2) * (rect_w - 2) < seed_count or rect_w < gap_len + 2:
+                continue
+            r0_lo = max(1, emitter["beam1"] - rect_h + 1)
