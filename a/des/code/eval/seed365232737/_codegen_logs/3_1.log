+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                if rr > 0 and mask[rr - 1, cc] and not seen[rr - 1, cc]:
+                    seen[rr - 1, cc] = True
+                    q.append((rr - 1, cc))
+                if rr + 1 < h and mask[rr + 1, cc] and not seen[rr + 1, cc]:
+                    seen[rr + 1, cc] = True
+                    q.append((rr + 1, cc))
+                if cc > 0 and mask[rr, cc - 1] and not seen[rr, cc - 1]:
+                    seen[rr, cc - 1] = True
+                    q.append((rr, cc - 1))
+                if cc + 1 < w and mask[rr, cc + 1] and not seen[rr, cc + 1]:
+                    seen[rr, cc + 1] = True
