+
+
+def _corridor_rect(
+    h: int,
+    w: int,
+    bbox: tuple[int, int, int, int],
+    direction: str,
+    beam0: int,
+    beam1: int,
+) -> tuple[int, int, int, int] | None:
+    r0, c0, r1, c1 = bbox
+    if direction == "up":
+        if r0 == 0:
+            return None
+        return 0, beam0, r0 - 1, beam1
+    if direction == "down":
+        if r1 == h - 1:
