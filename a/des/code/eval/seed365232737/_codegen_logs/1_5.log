+    out: list[dict] = []
+    seen = set()
+    for color in colors:
+        for comp in _components_mask(g == color):
+            r0, c0, r1, c1 = _bbox(comp)
+            if r1 - r0 + 1 < 4 or c1 - c0 + 1 < 4:
