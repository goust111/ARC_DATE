+            if rng.random() < 0.7:
+                mask[:, col_offset::step] ^= True
+            if rng.random() < 0.6:
+                rr0 = rng.randrange(h)
+                rr1 = rng.randrange(rr0, h)
+                mask[rr0 : rr1 + 1, rng.randrange(w)] = True
+            if rng.random() < 0.5 and h >= 3 and w >= 3:
+                cut_h = rng.randint(1, max(1, h // 2))
+                cut_w = rng.randint(1, max(1, w // 2))
+                r0 = rng.randint(0, h - cut_h)
