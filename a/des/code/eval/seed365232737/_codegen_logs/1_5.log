+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    n_sources = rng.randint(2, 4)
+    layout = rng.choice(("tb", "lr"))
+    src_rows, src_cols = _source_grid_shape(n_sources, layout, rng)
+    ih = rng.randint(4, 7)
