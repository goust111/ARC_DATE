+import numpy as np
+
+
+BG = 0
+TEMPLATE_BORDER = 5
+SOURCE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+MAX_GRID_SIDE = 28
+GEN_ATTEMPTS = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flat)).most_common(1)[0][0])
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.asarray(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _is_single_component(mask: np.ndarray) -> bool:
+    comps = _components_mask(mask)
+    return len(comps) == 1
+
+
+def _find_frame_candidates(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    colors = sorted(set(map(int, np.unique(g))) - {bg})
+    out: list[dict] = []
+    seen = set()
+    for color in colors:
+        for comp in _components_mask(g == color):
+            r0, c0, r1, c1 = _bbox(comp)
+            if r1 - r0 + 1 < 4 or c1 - c0 + 1 < 4:
+                continue
+            key = (r0, c0, r1, c1, color)
+            if key in seen:
+                continue
+            if not bool((g[r0, c0 : c1 + 1] == color).all()):
+                continue
+            if not bool((g[r1, c0 : c1 + 1] == color).all()):
+                continue
+            if not bool((g[r0 : r1 + 1, c0] == color).all()):
+                continue
+            if not bool((g[r0 : r1 + 1, c1] == color).all()):
+                continue
+            inner = g[r0 + 1 : r1, c0 + 1 : c1]
+            if inner.size == 0 or bool((inner == color).all()):
+                continue
+            out.append(
+                {
+                    "bbox": (r0, c0, r1, c1),
+                    "color": color,
+                    "outer_shape": (r1 - r0 + 1, c1 - c0 + 1),
+                    "inner": inner.copy(),
