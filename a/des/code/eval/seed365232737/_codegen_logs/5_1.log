+        for r, c in cells:
+            mask[r, c] = True
+        pts = np.argwhere(mask)
+        r0, c0 = pts.min(axis=0)
+        r1, c1 = pts.max(axis=0)
+        mask = mask[r0 : r1 + 1, c0 : c1 + 1]
+        if require_hflip_change and np.array_equal(mask, np.fliplr(mask)):
+            continue
