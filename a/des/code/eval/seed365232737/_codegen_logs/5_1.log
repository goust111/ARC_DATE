+
+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+
+    frames: list[dict] = []
+    nonframes: list[dict] = []
+    for color in sorted(int(c) for c in np.unique(g) if int(c) != bg):
+        frame_comp = None
+        for coords in _component_coords(g == color):
+            if _is_frame_component(coords):
