+    r, c = cell
+    out: list[tuple[int, int]] = []
+    for dr, dc in _NEIGHBORS4:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            out.append((nr, nc))
+    return out
