+
+    curr = path[-1]
+    prev_dir = None
+    if len(path) >= 2:
+        prev = path[-2]
+        prev_dir = (curr[0] - prev[0], curr[1] - prev[1])
+
+    options: list[tuple[int, float, tuple[int, int]]] = []
+    for nxt in _coarse_neighbors(curr, rows, cols):
+        if nxt in used:
