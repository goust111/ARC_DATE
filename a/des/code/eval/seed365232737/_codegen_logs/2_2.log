+def _place_legend(grid: np.ndarray) -> tuple[str, int]:
+    h, w = grid.shape
+    gap = random.choice(LEGEND_GAP_CHOICES)
+    pattern = [MAROON, ORANGE] + [BLACK] * gap + [ORANGE, AZURE]
+    span = len(pattern)
+    side = random.choice(LEGEND_SIDES)
