+    for coords in _components(g != bg):
+        colors = {int(g[r, c]) for r, c in coords}
+        if len(coords) == 1:
+            r, c = map(int, coords[0])
+            singletons.append({"row": r, "col": c, "color": int(g[r, c])})
+        elif len(colors) == 1 and _is_fence(coords):
+            fences.append(
