def _visible_count(
    offsets: tuple[tuple[int, int], ...],
    seed_r: int,
    seed_c: int,
    bbox: tuple[int, int, int, int],
) -> int:
    r0, c0, r1, c1 = bbox
    count = 0
    for dr, dc in offsets:
        rr = seed_r + dr
        cc = seed_c + dc
        if r0 < rr < r1 and c0 < cc < c1:
            count += 1
    return count


def _seed_positions(
    offsets: tuple[tuple[int, int], ...],
    bbox: tuple[int, int, int, int],
