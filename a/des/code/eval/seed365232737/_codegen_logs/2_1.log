+        grid[r1, c0 : c1 + 1] = fence_color
+        grid[r0 : r1 + 1, c0] = fence_color
+        grid[r0 : r1 + 1, c1] = fence_color
+
+        safe, clipped, useful = _seed_positions(spec["offsets"], bbox)
