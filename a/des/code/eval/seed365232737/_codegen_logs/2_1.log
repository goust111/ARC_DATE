+        cc = seed_c + dc
+        if r0 < rr < r1 and c0 < cc < c1:
+            count += 1
+    return count
+
+
+def _seed_positions(
+    offsets: tuple[tuple[int, int], ...],
+    bbox: tuple[int, int, int, int],
