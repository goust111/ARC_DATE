+    grid_h = random.randint(max(GRID_H_RANGE[0], max_template_h + 12), GRID_H_RANGE[1])
+    grid_w = random.randint(max(GRID_W_RANGE[0], total_template_w + 4), GRID_W_RANGE[1])
+    grid = np.zeros((grid_h, grid_w), dtype=int)
