+def _draw_lock_patch(size: int, frame_color: int, cover: int) -> np.ndarray:
+    patch = np.full((size + 2, size + 2), cover, dtype=int)
+    patch[0, :] = frame_color
+    patch[-1, :] = frame_color
+    patch[:, 0] = frame_color
+    patch[:, -1] = frame_color
+    return patch
