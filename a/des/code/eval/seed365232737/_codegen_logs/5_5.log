+        return False
+    r0 = max(0, top - gap)
+    c0 = max(0, left - gap)
+    r1 = min(rows, top + h + gap)
+    c1 = min(cols, left + w + gap)
+    return not blocked[r0:r1, c0:c1].any()
+
+
+def _occupy(blocked: np.ndarray, top: int, left: int, h: int, w: int, gap: int = 1) -> None:
+    rows, cols = blocked.shape
+    r0 = max(0, top - gap)
+    c0 = max(0, left - gap)
+    r1 = min(rows, top + h + gap)
+    c1 = min(cols, left + w + gap)
