+        return None
+    shaft_candidates = [color for color in color_set if color in lock_colors]
+    if len(shaft_candidates) != 1:
+        return None
+    shaft_color = int(shaft_candidates[0])
+    yellow = next(color for color in color_set if color != shaft_color)
