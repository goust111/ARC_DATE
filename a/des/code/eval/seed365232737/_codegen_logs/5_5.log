+def _read_codebook_candidate(
+    grid: np.ndarray,
+    bg: int,
+    lock_colors: set[int],
+    size: int,
+    tiles: list[tuple[int, int]],
+) -> dict[int, np.ndarray] | None:
+    patterns: dict[int, np.ndarray] = {}
