+    if row > sr and bottom_open:
+        dist = r1 - sr
+        frac = 0.0 if dist == 0 else (r1 - row) / dist
+        left_extent = int(np.floor(frac * (sc - c0)))
+        right_extent = int(np.floor(frac * (c1 - sc)))
+        return sc - left_extent, sc + right_extent
+
+    return c0, c1
+
+
+def _horizontal_limits(
+    col: int,
+    left_open: bool,
+    right_open: bool,
+    r0: int,
+    sr: int,
+    r1: int,
+    c0: int,
+    sc: int,
+    c1: int,
