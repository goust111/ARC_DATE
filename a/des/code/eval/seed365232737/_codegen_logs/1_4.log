+    open_sides = 0
+    room_patterns = set()
+    for room in rooms:
+        sides = room["sides"]
+        key = tuple(int(bool(sides[name])) for name in ("top", "bottom", "left", "right"))
+        room_patterns.add(key)
+        open_sides += sum(key)
+    return open_sides, len(room_patterns)
+
