+    for idx, c in enumerate(col_lines):
+        assert c == idx * col_step, "vertical grid lines must be periodic from the left edge"
+
+    room_h = row_step - 1
+    room_w = col_step - 1
+    assert room_h >= 1 and room_w >= 1
