+    row_lines = [idx * (room_h + 1) for idx in range(room_rows + 1)]
+    col_lines = [idx * (room_w + 1) for idx in range(room_cols + 1)]
+
+    grid[row_lines, :] = WALL
+    grid[:, col_lines] = WALL
