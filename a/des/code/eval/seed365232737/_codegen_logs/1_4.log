+                possible_sizes.append((room_h, room_w))
+
+    assert possible_sizes, "no valid room sizes"
+    room_h, room_w = rng.choice(possible_sizes)
+    return room_rows, room_cols, room_h, room_w
+
+
+def _apply_gap(
+    grid: np.ndarray,
+    orientation: str,
+    line_index: int,
+    start: int,
+    end: int,
+    rng: random.Random,
+) -> bool:
+    segment_len = end - start - 1
+    assert segment_len >= 1
+
+    if segment_len == 1:
+        gap_len = 1
+    else:
