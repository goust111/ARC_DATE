+            train_pos = red_positions[0]
+            train_idx = perimeter.index(train_pos)
+            tracks.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "perimeter": perimeter,
+                    "train_pos": train_pos,
+                    "train_idx": train_idx,
+                    "signal_color": signal_color,
+                    "gray_area": len(gray_comp),
