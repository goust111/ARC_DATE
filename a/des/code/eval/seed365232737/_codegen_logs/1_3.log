+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+YELLOW = 4
+GRAY = 5
+MAGENTA = 6
+TRACK_COLORS = [1, 3, 7, 8, 9]
+SPECIAL_COLORS = {BG, RED, YELLOW, GRAY, MAGENTA}
+SIDES = ("top", "bottom", "left", "right")
+MAX_ATTEMPTS = 500
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _perimeter_clockwise(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    pts: list[tuple[int, int]] = []
+    for c in range(c1, c0 - 1, -1):
+        pts.append((r0, c))
+    for r in range(r0 + 1, r1 + 1):
+        pts.append((r, c0))
+    for c in range(c0 + 1, c1 + 1):
+        pts.append((r1, c))
+    for r in range(r1 - 1, r0, -1):
+        pts.append((r, c1))
+    return pts
+
+
+def _outer_side_positions(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    pts: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        pts.append((r0 - 1, c))
+        pts.append((r1 + 1, c))
+    for r in range(r0, r1 + 1):
+        pts.append((r, c0 - 1))
+        pts.append((r, c1 + 1))
+    return pts
+
+
+def _gray_touches_track(gray_comp: list[tuple[int, int]], bbox: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = bbox
+    for r, c in gray_comp:
+        if r == r0 - 1 and c0 <= c <= c1:
+            return True
+        if r == r1 + 1 and c0 <= c <= c1:
+            return True
+        if c == c0 - 1 and r0 <= r <= r1:
+            return True
+        if c == c1 + 1 and r0 <= r <= r1:
+            return True
+    return False
+
