+import numpy as np
+
+
+BG = 0
+SHAPE_COLOR = 5
+SEPARATOR_COLOR = 6
+PALETTE_POOL = [1, 2, 3, 4, 7, 8, 9]
+N4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+PALETTE_BLOCK = 3
+PALETTE_GAP_RANGE = (1, 3)
+SHAPE_RETRIES = 200
+GENERATION_RETRIES = 300
