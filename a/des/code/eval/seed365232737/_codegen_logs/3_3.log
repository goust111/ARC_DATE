+
+def _split_positive(total: int, parts: int) -> list[int]:
+    assert 1 <= parts <= total
+    if parts == 1:
+        return [total]
+    cuts = sorted(random.sample(range(1, total), parts - 1))
+    prev = 0
+    out = []
