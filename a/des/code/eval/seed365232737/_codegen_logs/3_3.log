+        out.append(cut - prev)
+        prev = cut
+    return out
+
+
+def _layout_shapes(items: list[tuple[int, np.ndarray]]) -> tuple[int, int, list[tuple[int, np.ndarray, int, int]]]:
+    shuffled = items[:]
