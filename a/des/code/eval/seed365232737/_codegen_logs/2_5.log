+def _draw_wall(grid: np.ndarray, rect: tuple[int, int, int, int], orientation: str, pos: int, color: int) -> tuple[tuple[int, int, int, int], tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = rect
+    if orientation == "v":
