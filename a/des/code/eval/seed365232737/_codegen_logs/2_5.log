+def _make_legend(entries: list[tuple[int, np.ndarray]]) -> np.ndarray:
+    inner_h = 3 * len(entries) + max(0, len(entries) - 1)
+    inner_w = 4
+    patch = np.full((inner_h + 2, inner_w + 2), BLACK, dtype=int)
+    patch[0, :] = GREY
+    patch[-1, :] = GREY
+    patch[:, 0] = GREY
+    patch[:, -1] = GREY
+    row = 1
+    for idx, (color, pattern) in enumerate(entries):
