+            if line.size > 0 and int(line[0]) not in (BLACK, GREY, MAROON) and np.all(line == line[0]):
+                candidates.append(("top", line.size, int(line[0])))
+        if c1 < w - 1:
+            line = grid[r0 : r1 + 1, c1 + 1]
+            if line.size > 0 and int(line[0]) not in (BLACK, GREY, MAROON) and np.all(line == line[0]):
+                candidates.append(("right", line.size, int(line[0])))
+        if r1 < h - 1:
