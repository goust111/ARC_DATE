+    gap_specs: list[dict[str, object]] = []
+    for side, length, color in zip(sides, lengths, colors):
+        if side in {"top", "bottom"}:
+            inner_span = outer_w - 2 * GEN_THICKNESS
+        else:
+            inner_span = outer_h - 2 * GEN_THICKNESS
+        max_start = inner_span - length
+        if max_start < 0:
