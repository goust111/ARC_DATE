+            rr = int(rng.integers(0, grid_h - ph + 1))
+            cc = int(rng.integers(0, grid_w - pw + 1))
+            if not _can_place(forbidden, rr, cc, ph, pw):
+                continue
+            grid[rr : rr + ph, cc : cc + pw] = patch
+            _reserve(forbidden, rr, cc, ph, pw)
