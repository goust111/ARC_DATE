+    else:
+        shape = (length, GEN_THICKNESS)
+    patch = np.full(shape, color, dtype=int)
+    mr, mc = _marker_coord(shape, OPPOSITE[side], rng)
+    patch[mr, mc] = MARK
+    return patch
+
+
+def _draw_full_frame(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> None:
