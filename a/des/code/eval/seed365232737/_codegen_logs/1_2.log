+            r0, c0 = coords.min(axis=0)
+            r1, c1 = coords.max(axis=0)
+            sub = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            sub[coords[:, 0] - r0, coords[:, 1] - c0] = True
+            comps.append(
+                {
+                    "coords": coords,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "mask": sub,
+                    "area": int(len(cells)),
+                }
+            )
