+
+
+def _can_place(forbidden: np.ndarray, r: int, c: int, h: int, w: int) -> bool:
+    er0 = max(0, r - 1)
+    ec0 = max(0, c - 1)
+    er1 = min(forbidden.shape[0], r + h + 1)
+    ec1 = min(forbidden.shape[1], c + w + 1)
+    return not forbidden[er0:er1, ec0:ec1].any()
