+    uniq: list[tuple[int, int]] = []
+    seen: set[tuple[int, int]] = set()
+    for br, bc in candidates:
+        if (br, bc) in seen:
+            continue
+        seen.add((br, bc))
+        block = [(br + dr, bc + dc) for dr in range(2) for dc in range(2)]
+        if _in_bounds(block, h, w):
