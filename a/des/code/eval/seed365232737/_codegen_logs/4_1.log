+
+
+def _scan_frame_positions(
+    h: int,
+    w: int,
+    inner_h: int,
+    inner_w: int,
+    seed_inner: tuple[int, int],
+    direction: str,
+) -> tuple[range, range]:
+    outer_h = inner_h + 2
+    outer_w = inner_w + 2
+    inner_r, inner_c = seed_inner
+    length = inner_h * inner_w
+
+    row_lo = 0
+    row_hi = h - outer_h
