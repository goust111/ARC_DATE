+        r1 = min(h, r + pad + 1)
+        c0 = max(0, c - pad)
+        c1 = min(w, c + pad + 1)
+        if np.any(mask[r0:r1, c0:c1]):
+            return False
+    return True
+
+
+def _block_candidates(r0: int, c0: int, outer_h: int, outer_w: int, direction: str, h: int, w: int) -> list[tuple[int, int]]:
+    candidates: list[tuple[int, int]] = []
+    sides = {
+        "up": ("left", "right", "down"),
+        "down": ("left", "right", "up"),
+        "left": ("up", "down", "right"),
+        "right": ("up", "down", "left"),
