+    return uniq
+
+
+def _candidate_seed_positions(inner_h: int, inner_w: int, direction: str, prefer_tie: bool) -> list[tuple[int, int]]:
+    tie_positions: list[tuple[int, int]] = []
+    plain_positions: list[tuple[int, int]] = []
