+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _bbox(coords: Iterable[tuple[int, int]]) -> tuple[int, int, int, int]:
+    pts = list(coords)
+    rows = [r for r, _ in pts]
+    cols = [c for _, c in pts]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _frame_bbox_if_valid(grid: np.ndarray, color: int, coords: list[tuple[int, int]]) -> tuple[int, int, int, int] | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 4 or w < 4:
+        return None
+    if len(coords) != 2 * h + 2 * w - 4:
+        return None
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    if not np.all(patch[border] == color):
+        return None
+    if np.any(patch[~border] == color):
+        return None
+    return r0, c0, r1, c1
+
+
+def _is_2x2_block(coords: list[tuple[int, int]]) -> bool:
+    if len(coords) != 4:
+        return False
+    r0, c0, r1, c1 = _bbox(coords)
+    return r1 - r0 == 1 and c1 - c0 == 1
