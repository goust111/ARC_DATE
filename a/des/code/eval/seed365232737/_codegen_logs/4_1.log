+def _bbox(coords: Iterable[tuple[int, int]]) -> tuple[int, int, int, int]:
+    pts = list(coords)
+    rows = [r for r, _ in pts]
+    cols = [c for _, c in pts]
+    return min(rows), min(cols), max(rows), max(cols)
