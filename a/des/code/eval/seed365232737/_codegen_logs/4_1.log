+
+def _edge_distances(inner_r: int, inner_c: int, inner_h: int, inner_w: int) -> dict[str, int]:
+    return {
+        "top": inner_r,
+        "bottom": inner_h - 1 - inner_r,
+        "left": inner_c,
+        "right": inner_w - 1 - inner_c,
