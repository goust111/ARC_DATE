+    out = g.copy()
+    for bbox in _find_fences(g):
+        gaps = [pos for pos in _perimeter_positions(*bbox) if int(g[pos]) == BLACK]
+        bands = _side_bands(bbox, gaps, g)
+        _fill_fence(out, bbox, bands)
