+        placed = False
+        for _ in range(PLACEMENT_ATTEMPTS):
+            min_r0 = MAX_SOURCE_DIST
+            min_c0 = MAX_SOURCE_DIST
+            max_r0 = h - MAX_SOURCE_DIST - outer_h
