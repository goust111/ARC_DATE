+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+FENCE = 3
+SOURCE_COLORS = (1, 2, 4, 5, 6, 7, 8, 9)
+SIDES = ("top", "bottom", "left", "right")
+SIDE_PRIORITY = {"top": 0, "left": 1, "bottom": 2, "right": 3}
