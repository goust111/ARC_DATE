+            er0 = max(0, r0 - MAX_SOURCE_DIST)
+            ec0 = max(0, c0 - MAX_SOURCE_DIST)
+            er1 = min(h - 1, r1 + MAX_SOURCE_DIST)
+            ec1 = min(w - 1, c1 + MAX_SOURCE_DIST)
+            if occupied[er0 : er1 + 1, ec0 : ec1 + 1].any():
+                continue
+
+            bbox = (r0, c0, r1, c1)
+            gaps = _choose_gap_positions(bbox, counts, rng)
