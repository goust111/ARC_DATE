+
+GEN_HEIGHT_RANGE = (18, 26)
+GEN_WIDTH_RANGE = (18, 28)
+GEN_PAIR_COUNT_RANGE = (3, 5)
+GEN_NON_RED_POOL = (1, 3, 5, 6, 8, 9)
