+def _sample_extra_pair(color: int, existing: list[PairSpec], height: int, width: int) -> PairSpec | None:
+    for _ in range(GEN_EXTRA_PAIR_TRIES):
+        left = _sample_anchor(height, width)
+        right = _sample_anchor(height, width)
