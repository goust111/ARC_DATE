    area = H * H
    lo = max(MIN_OBJECTS, int(np.ceil(MIN_DENSITY * area / CELLS_PER_OBJECT)))
    hi = min(MAX_OBJECTS, int(np.floor(MAX_DENSITY * area / CELLS_PER_OBJECT)))
