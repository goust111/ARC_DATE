+def _path_cells(left: Coord, right: Coord) -> set[Coord]:
+    r0, c0 = left
+    r1, c1 = right
+    h_step = 1 if c1 >= c0 else -1
+    v_step = 1 if r1 >= r0 else -1
+    cells = {(r0, c) for c in range(c0, c1 + h_step, h_step)}
+    cells.update((r, c1) for r in range(r0, r1 + v_step, v_step))
