+    grid = np.full((height, width), BLACK, dtype=int)
+    grid[int(rows[0]), int(start_pad) : int(start_pad + start_len)] = RED
+
+    used_portal_cells: set[tuple[int, int]] = set()
+    future_path_cells: set[tuple[int, int]] = set()
