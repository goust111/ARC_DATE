+        if any(max(abs(r1 - r2), abs(c1 - c2)) <= 1 for r1, c1 in cells1 for r2, c2 in cells2):
+            continue
+
+        for r, c in all_cells:
+            grid[r, c] = int(color)
+        return True
+    return False
