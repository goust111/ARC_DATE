+    left_margin = random.randint(OUTER_MARGIN_RANGE[0], max_left)
+    max_bottom = min(OUTER_MARGIN_RANGE[1], GRID_MAX_SIZE - outer_h - top_margin)
+    max_right = min(OUTER_MARGIN_RANGE[1], GRID_MAX_SIZE - outer_w - left_margin)
