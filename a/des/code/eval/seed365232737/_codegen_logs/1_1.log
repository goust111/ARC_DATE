+    sr, sc = start
+    er, ec = end
+    dr = er - sr
+    dc = ec - sc
+    assert dr == 0 or dc == 0 or abs(dr) == abs(dc)
+    step_r = 0 if dr == 0 else dr // abs(dr)
+    step_c = 0 if dc == 0 else dc // abs(dc)
+    steps = max(abs(dr), abs(dc))
+    return [(sr + k * step_r, sc + k * step_c) for k in range(steps + 1)]
