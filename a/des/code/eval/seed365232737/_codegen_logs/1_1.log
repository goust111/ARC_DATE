+            pad_c0 = c0 - 1
+            pad_r1 = r0 + legend_h
+            pad_c1 = c0 + legend_w
+            blocked = False
+            for r in range(pad_r0, pad_r1 + 1):
+                for c in range(pad_c0, pad_c1 + 1):
