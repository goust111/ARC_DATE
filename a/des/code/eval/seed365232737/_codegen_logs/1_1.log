+    w: int,
+    n_pairs: int,
+    forbidden: set[Pos],
+) -> list[Pos]:
+    legend_h = n_pairs + 2
+    legend_w = 4
+    candidates: list[Pos] = []
+    for r0 in range(1, h - legend_h):
