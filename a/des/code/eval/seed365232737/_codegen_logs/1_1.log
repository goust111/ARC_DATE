+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[Pos] = []
+            while q:
