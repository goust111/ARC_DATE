+        arrows.append(
+            {
+                "side": side,
+                "anchor": anchor,
+                "lane": lane,
+                "shaft_color": shaft_color,
+                "tip_color": tip_color,
+                "cells": tuple(cells),
+                "dr": dr,
+                "dc": dc,
+            }
+        )
+        used.update(cells)
