def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    h, w = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    comps: list[list[tuple[int, int]]] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            stack = [(r, c)]
            seen[r, c] = True
            comp: list[tuple[int, int]] = []
            while stack:
                rr, cc = stack.pop()
                comp.append((rr, cc))
                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            comps.append(comp)
    return comps


def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
    rows = [r for r, _ in cells]
    cols = [c for _, c in cells]
    return min(rows), min(cols), max(rows), max(cols)


def _repeat_to_length(values: list[int], length: int) -> list[int]:
    if not values or length <= 0:
        return []
    if len(values) >= length:
        return values[:length]
    return [values[i % len(values)] for i in range(length)]


def _extract_block(
    g: np.ndarray,
    bbox: tuple[int, int, int, int],
    side: str,
) -> Optional[np.ndarray]:
    r0, c0, r1, c1 = bbox
    h, w = g.shape

    if side == "top":
        rows: list[int] = []
        rr = r0 - 1
        while rr >= 0 and bool(np.all(g[rr, c0 : c1 + 1] != BLACK)):
            rows.append(rr)
            rr -= 1
        if not rows:
            return None
        block = g[min(rows) : max(rows) + 1, c0 : c1 + 1]
    elif side == "bottom":
        rows = []
        rr = r1 + 1
        while rr < h and bool(np.all(g[rr, c0 : c1 + 1] != BLACK)):
            rows.append(rr)
            rr += 1
        if not rows:
            return None
        block = g[min(rows) : max(rows) + 1, c0 : c1 + 1]
    elif side == "left":
        cols: list[int] = []
        cc = c0 - 1
        while cc >= 0 and bool(np.all(g[r0 : r1 + 1, cc] != BLACK)):
            cols.append(cc)
            cc -= 1
        if not cols:
            return None
        block = g[r0 : r1 + 1, min(cols) : max(cols) + 1]
    else:
        cols = []
        cc = c1 + 1
        while cc < w and bool(np.all(g[r0 : r1 + 1, cc] != BLACK)):
            cols.append(cc)
            cc += 1
        if not cols:
            return None
        block = g[r0 : r1 + 1, min(cols) : max(cols) + 1]

    if not bool(np.all(block != BLACK)):
        return None
    return np.asarray(block, dtype=int).copy()


def _detect_frames(g: np.ndarray) -> list[dict]:
    frames: list[dict] = []
    for color in map(int, np.unique(g)):
        if color == BLACK:
            continue
        for cells in _components(g == color):
            r0, c0, r1, c1 = _bbox(cells)
            if r1 - r0 + 1 < 4 or c1 - c0 + 1 < 4:
                continue
            if any(r not in (r0, r1) and c not in (c0, c1) for r, c in cells):
                continue

            ok = True
            for r in range(r0, r1 + 1):
                for c in range(c0, c1 + 1):
                    v = int(g[r, c])
                    on_border = r in (r0, r1) or c in (c0, c1)
                    is_corner = r in (r0, r1) and c in (c0, c1)
                    if on_border:
                        if is_corner and v != color:
                            ok = False
