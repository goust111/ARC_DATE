+                "start": start,
+                "end": end,
+                "steps": abs(end[0] - start[0]) + abs(end[1] - start[1]),
+                "blocked_by_piece": blocked_by_piece,
+                "anchor": tuple(arrow["anchor"]),
+                "shaft_color": shaft_color,
+                "tip_color": int(arrow["tip_color"]),
