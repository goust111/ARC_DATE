+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+PALETTE = tuple(range(1, 10))
+SIDES = ("top", "bottom", "left", "right")
+
+# Generator configuration.
+GRID_H_RANGE = (10, 16)
+GRID_W_RANGE = (10, 16)
+PIECE_COUNT_CHOICES = (2, 3, 4)
+PIECE_COUNT_WEIGHTS = (3, 4, 3)
+INTERACTION_PROB = 0.6
+GEN_ATTEMPTS = 600
