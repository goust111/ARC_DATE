+        row_hi = h // 2 - 1 if pair_kind == "vertical" else h - 3
+        rows = range(2, row_hi + 1)
+        return [(r, lane) for r in rows]
+    if side == "bottom":
+        row_lo = h // 2 + 1 if pair_kind == "vertical" else 2
+        rows = range(row_lo, h - 2)
+        return [(r, lane) for r in rows]
+    if side == "left":
+        col_hi = w // 2 - 1 if pair_kind == "horizontal" else w - 3
+        cols = range(2, col_hi + 1)
+        return [(lane, c) for c in cols]
+    col_lo = w // 2 + 1 if pair_kind == "horizontal" else 2
+    cols = range(col_lo, w - 2)
+    return [(lane, c) for c in cols]
+
