+        shared = random.choice(shared_cols)
+        side_to_lane["top"] = shared
+        side_to_lane["bottom"] = shared
+    if pair_kind == "horizontal":
+        shared_rows = _lane_values_for_side("left", h, w)
+        if not shared_rows:
+            return None
+        shared = random.choice(shared_rows)
+        side_to_lane["left"] = shared
+        side_to_lane["right"] = shared
