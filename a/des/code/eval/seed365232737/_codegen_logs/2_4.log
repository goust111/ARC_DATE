from __future__ import annotations

from collections import Counter, deque
import random

import numpy as np


BLACK = 0
GRAY = 5
PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)

GRID_H_RANGE = (14, 24)
GRID_W_RANGE = (14, 24)
OBJECT_COUNT_CHOICES = (1, 2, 3)
OBJECT_COUNT_WEIGHTS = (2, 4, 3)
ORIENTATION_CHOICES = ("horizontal", "vertical")
RELATION_CHOICES = ("first_smaller", "second_smaller", "equal")
HALF_SHORT_RANGE = (2, 5)
HALF_LONG_EXTRA_RANGE = (1, 3)
SPAN_RANGE = (4, 8)
MARGIN = 1
PLACEMENT_GAP = 1
MAX_ATTEMPTS = 400
PER_OBJECT_ATTEMPTS = 80


def _components(mask: np.ndarray) -> list[np.ndarray]:
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    comps: list[np.ndarray] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            coords: list[tuple[int, int]] = []
            while q:
                cr, cc = q.popleft()
                coords.append((cr, cc))
                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            comps.append(np.array(coords, dtype=int))
    return comps


def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
    return (
        int(coords[:, 0].min()),
        int(coords[:, 1].min()),
        int(coords[:, 0].max()),
        int(coords[:, 1].max()),
    )


def _rare_color(patch: np.ndarray) -> int:
    colors = [int(v) for v in patch.ravel() if int(v) not in (BLACK, GRAY)]
    counts = Counter(colors)
    assert len(counts) == 2, "expected exactly two non-background non-gray colors"
    items = counts.most_common()
    assert items[0][1] != items[1][1], "expected a unique rarer color"
    return int(items[-1][0])


def _resolve_colors(candidates: list[int], rare: int) -> int:
    uniq = {int(v) for v in candidates}
    if len(uniq) == 1:
        return int(candidates[0])
    assert rare in uniq, "conflict must involve the rarer object color"
    return int(rare)


def _transform_object(
    patch: np.ndarray,
    top: int,
    left: int,
) -> tuple[tuple[int, int, int, int], dict[tuple[int, int], int]]:
    h, w = patch.shape
    gray_rows = [r for r in range(h) if np.all(patch[r, :] == GRAY)]
    gray_cols = [c for c in range(w) if np.all(patch[:, c] == GRAY)]
    assert len(gray_rows) + len(gray_cols) == 1, "expected one full gray fold axis"
    rare = _rare_color(patch)

    placements: dict[tuple[int, int], list[int]] = {}

    def add_pixel(rr: int, cc: int, color: int) -> None:
        placements.setdefault((rr, cc), []).append(int(color))

    if gray_rows:
        axis = gray_rows[0]
        top_h = axis
        bottom_h = h - axis - 1
        assert top_h > 0 and bottom_h > 0, "gray fold axis must split two non-empty halves"
        stationary_top = top_h <= bottom_h
        for r in range(h):
            for c in range(w):
                color = int(patch[r, c])
                if color == GRAY:
                    continue
                gr = top + r
                gc = left + c
                if r < axis:
                    if stationary_top:
                        add_pixel(gr, gc, color)
                    else:
                        add_pixel(top + (2 * axis - r), gc, color)
                else:
                    if stationary_top:
                        add_pixel(top + (2 * axis - r), gc, color)
                    else:
                        add_pixel(gr, gc, color)
    else:
        axis = gray_cols[0]
        left_w = axis
        right_w = w - axis - 1
        assert left_w > 0 and right_w > 0, "gray fold axis must split two non-empty halves"
        stationary_left = left_w <= right_w
        for r in range(h):
            for c in range(w):
                color = int(patch[r, c])
                if color == GRAY:
                    continue
                gr = top + r
                gc = left + c
                if c < axis:
                    if stationary_left:
                        add_pixel(gr, gc, color)
                    else:
                        add_pixel(gr, left + (2 * axis - c), color)
                else:
                    if stationary_left:
                        add_pixel(gr, left + (2 * axis - c), color)
                    else:
                        add_pixel(gr, gc, color)

    out_pixels = {
        pos: _resolve_colors(colors, rare)
        for pos, colors in placements.items()
    }
    rows = [r for r, _c in out_pixels]
    cols = [c for _r, c in out_pixels]
    out_bbox = (min(rows), min(cols), max(rows), max(cols))
    return out_bbox, out_pixels


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fold each rectangular object across its internal gray line.

    The larger half reflects onto the smaller half; equal halves fold bottom-up
    or right-to-left. At overlap conflicts, keep the color that is globally
    rarer within that object. The gray line disappears.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    out = np.full_like(g, BLACK)
    for coords in _components(g != BLACK):
        r0, c0, r1, c1 = _bbox(coords)
        patch = g[r0 : r1 + 1, c0 : c1 + 1]
        assert np.all(patch != BLACK), "each object must fill its rectangle"
        _out_bbox, pixels = _transform_object(patch, r0, c0)
        for (r, c), color in pixels.items():
            assert 0 <= r < g.shape[0] and 0 <= c < g.shape[1], "folded object must stay in bounds"
            assert out[r, c] == BLACK, "objects must remain disjoint after folding"
            out[r, c] = int(color)
    return out


def _sample_params() -> dict[str, int | str]:
    orient = random.choice(ORIENTATION_CHOICES)
    relation = random.choice(RELATION_CHOICES)
    short = random.randint(*HALF_SHORT_RANGE)
    if relation == "equal":
        first = second = short
    else:
        long_half = short + random.randint(*HALF_LONG_EXTRA_RANGE)
        if relation == "first_smaller":
            first, second = short, long_half
        else:
            first, second = long_half, short

    span = random.randint(*SPAN_RANGE)
    if orient == "horizontal":
        top_h, bottom_h = first, second
        assert top_h * span >= 4 and bottom_h * span >= 4
        return {
            "orient": orient,
            "top_h": top_h,
            "bottom_h": bottom_h,
            "height": top_h + 1 + bottom_h,
            "width": span,
        }

    left_w, right_w = first, second
    assert left_w * span >= 4 and right_w * span >= 4
    return {
        "orient": orient,
        "left_w": left_w,
        "right_w": right_w,
        "height": span,
        "width": left_w + 1 + right_w,
    }


def _object_windows(
    top: int,
    left: int,
    params: dict[str, int | str],
) -> tuple[tuple[int, int, int, int], tuple[int, int, int, int], tuple[int, int, int, int]]:
    h = int(params["height"])
    w = int(params["width"])
    in_box = (top, left, top + h - 1, left + w - 1)

    if params["orient"] == "horizontal":
        top_h = int(params["top_h"])
        bottom_h = int(params["bottom_h"])
        if top_h <= bottom_h:
            out_box = (top + top_h - bottom_h, left, top + top_h - 1, left + w - 1)
        else:
            out_box = (top + top_h + 1, left, top + 2 * top_h, left + w - 1)
    else:
        left_w = int(params["left_w"])
        right_w = int(params["right_w"])
        if left_w <= right_w:
            out_box = (top, left + left_w - right_w, top + h - 1, left + left_w - 1)
        else:
            out_box = (top, left + left_w + 1, top + h - 1, left + 2 * left_w)

    reserve = (
        min(in_box[0], out_box[0]),
        min(in_box[1], out_box[1]),
        max(in_box[2], out_box[2]),
        max(in_box[3], out_box[3]),
    )
    return in_box, out_box, reserve


def _fits(box: tuple[int, int, int, int], h: int, w: int) -> bool:
    r0, c0, r1, c1 = box
    return 0 <= r0 and 0 <= c0 and r1 < h and c1 < w


def _window_free(reserved: np.ndarray, box: tuple[int, int, int, int], gap: int) -> bool:
    r0, c0, r1, c1 = box
    rr0 = max(0, r0 - gap)
    cc0 = max(0, c0 - gap)
    rr1 = min(reserved.shape[0] - 1, r1 + gap)
    cc1 = min(reserved.shape[1] - 1, c1 + gap)
    return not bool(reserved[rr0 : rr1 + 1, cc0 : cc1 + 1].any())


def _mark_window(reserved: np.ndarray, box: tuple[int, int, int, int], gap: int) -> None:
    r0, c0, r1, c1 = box
    rr0 = max(0, r0 - gap)
    cc0 = max(0, c0 - gap)
    rr1 = min(reserved.shape[0] - 1, r1 + gap)

