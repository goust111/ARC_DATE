                    elif v != BLACK:
                        ok = False
                        break
                if not ok:
                    break
            if not ok:
                continue

            top_gaps = [c for c in range(c0 + 1, c1) if int(g[r0, c]) == BLACK]
            bottom_gaps = [c for c in range(c0 + 1, c1) if int(g[r1, c]) == BLACK]
            left_gaps = [r for r in range(r0 + 1, r1) if int(g[r, c0]) == BLACK]
            right_gaps = [r for r in range(r0 + 1, r1) if int(g[r, c1]) == BLACK]
            if not (top_gaps or bottom_gaps or left_gaps or right_gaps):
                continue

            gaps = {
                "top": top_gaps,
                "bottom": bottom_gaps,
                "left": left_gaps,
                "right": right_gaps,
            }
            blocks: dict[str, np.ndarray] = {}
            for side in SIDES:
                if not gaps[side]:
                    continue
                block = _extract_block(g, (r0, c0, r1, c1), side)
                if block is None:
                    ok = False
                    break
                blocks[side] = block
            if not ok:
                continue

            frames.append(
                {
                    "color": color,
                    "bbox": (r0, c0, r1, c1),
                    "gaps": gaps,
                    "blocks": blocks,
                }
            )

    frames.sort(key=lambda frame: (frame["bbox"][0], frame["bbox"][1], frame["color"]))
    if not frames:
        raise AssertionError("no valid gapped frames found")
    return frames


def _frame_operations_from_detected(frame: dict) -> list[tuple[tuple[int, int], list[tuple[int, int]], list[int]]]:
    r0, c0, r1, c1 = frame["bbox"]
    ops: list[tuple[tuple[int, int], list[tuple[int, int]], list[int]]] = []

    if frame["gaps"]["top"]:
        block = frame["blocks"]["top"]
        for gap_c in frame["gaps"]["top"]:
            src = [int(v) for v in block[::-1, gap_c - c0]]
            coords = [(r, gap_c) for r in range(r0 + 1, r1)]
            ops.append(((r0, gap_c), coords, _repeat_to_length(src, len(coords))))

    if frame["gaps"]["bottom"]:
        block = frame["blocks"]["bottom"]
        for gap_c in frame["gaps"]["bottom"]:
            src = [int(v) for v in block[:, gap_c - c0]]
            coords = [(r, gap_c) for r in range(r1 - 1, r0, -1)]
            ops.append(((r1, gap_c), coords, _repeat_to_length(src, len(coords))))

    if frame["gaps"]["left"]:
        block = frame["blocks"]["left"]
        for gap_r in frame["gaps"]["left"]:
            src = [int(v) for v in block[gap_r - r0, ::-1]]
            coords = [(gap_r, c) for c in range(c0 + 1, c1)]
            ops.append(((gap_r, c0), coords, _repeat_to_length(src, len(coords))))

    if frame["gaps"]["right"]:
        block = frame["blocks"]["right"]
        for gap_r in frame["gaps"]["right"]:
            src = [int(v) for v in block[gap_r - r0, :]]
            coords = [(gap_r, c) for c in range(c1 - 1, c0, -1)]
            ops.append(((gap_r, c1), coords, _repeat_to_length(src, len(coords))))

    return sorted(ops, key=lambda item: (item[0][0], item[0][1]))


def _apply_operations(out: np.ndarray, ops: list[tuple[tuple[int, int], list[tuple[int, int]], list[int]]]) -> None:
    for _key, coords, values in ops:
        for (r, c), v in zip(coords, values, strict=False):
            out[r, c] = int(v)


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fill each gapped rectangular frame by taking the rows or columns indexed by
    the border gaps from the touching side block and projecting them inward.
    """
    g = np.asarray(grid, dtype=int)
    frames = _detect_frames(g)

    out = g.copy()
    for frame in frames:
        _apply_operations(out, _frame_operations_from_detected(frame))
    return out


