+    if w >= 3:
+        for r in range(1, h - 1):
+            cells = [(r, 0), (r, 1), (r, 2)]
+            if any(cell in used for cell in cells):
+                continue
+            outer, mid, tip = [int(g[rr, c]) for rr, c in cells]
+            if outer == mid != BLACK and tip not in (BLACK, outer):
+                add_arrow("left", (r, 0), r, outer, tip, cells, 0, 1)
