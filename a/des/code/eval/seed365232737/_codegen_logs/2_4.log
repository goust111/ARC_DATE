import random
from typing import Optional

import numpy as np


BLACK = 0
GREY = 5
PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)

SIDES = ("top", "bottom", "left", "right")
GEN_RETRIES = 400
PLACE_TRIES = 120
