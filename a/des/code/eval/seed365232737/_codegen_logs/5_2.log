import z3, time, itertools

def sat(h,w,rootA,rootB,timeout=3000):
    N=h*w
    x=[[z3.Bool(f'x_{rootA}_{rootB}_{r}_{c}') for c in range(w)] for r in range(h)]
    ra=[[z3.Int(f'ra_{rootA}_{rootB}_{r}_{c}') for c in range(w)] for r in range(h)]
    rb=[[z3.Int(f'rb_{rootA}_{rootB}_{r}_{c}') for c in range(w)] for r in range(h)]
    s=z3.Solver(); s.set('timeout', timeout)
    ar,ac=rootA; br,bc=rootB
    s.add(x[ar][ac])
    s.add(z3.Not(x[br][bc]))
    dirs=[(1,0),(-1,0),(0,1),(0,-1)]
    for r in range(h):
        for c in range(w):
            s.add(ra[r][c]>=0, ra[r][c]<N, rb[r][c]>=0, rb[r][c]<N)
    s.add(ra[ar][ac]==0, rb[br][bc]==0)
    for r in range(h):
        for c in range(w):
            if (r,c)"'!=rootA:
                s.add(z3.Implies(x[r][c], z3.Or([z3.And(x[nr][nc], ra[nr][nc] < ra[r][c]) for dr,dc in dirs if 0<=(nr:=r+dr)<h and 0<=(nc:=c+dc)<w])))
            if (r,c)!=rootB:
                s.add(z3.Implies(z3.Not(x[r][c]), z3.Or([z3.And(z3.Not(x[nr][nc]), rb[nr][nc] < rb[r][c]) for dr,dc in dirs if 0<=(nr:=r+dr)<h and 0<=(nc:=c+dc)<w])))
    sides=[[(0,c) for c in range(w)],[(h-1,c) for c in range(w)],[(r,0) for r in range(h)],[(r,w-1) for r in range(h)]]
    for side in sides:
        s.add(z3.Or([x[r][c] for r,c in side]))
        s.add(z3.Or([z3.Not(x[r][c]) for r,c in side]))
    area=z3.Sum([z3.If(x[r][c],1,0) for r in range(h) for c in range(w)])
    s.add(area>=4, area<=N-4)
    res=s.check()
    if res==z3.sat:
        m=s.model()
        grid=[[1 if z3.is_true(m.eval(x[r][c])) else 0 for c in range(w)] for r in range(h)]
        return grid
    return None

for h,w in [(6,6),(6,7),(7,7)]:
    border=[(0,c) for c in range(w)] + [(h-1,c) for c in range(w)] + [(r,0) for r in range(1,h-1)] + [(r,w-1) for r in range(1,h-1)]
    found=None
    for a,b in itertools.permutations(border,2):
        g=sat(h,w,a,b,timeout=1000)
        if g:
            found=(a,b,g)
            break
    print('"'dims',h,w,'found',found is not None)
    if found:
        a,b,g=found
        print('roots',a,b)
        for row in g:
            print(''.join('#' if v else '.' for v in row))
        print()
