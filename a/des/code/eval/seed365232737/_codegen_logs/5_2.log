        cur_a, cur_b = row_label_cache[mask]
        # union-find for A and B separately
        def trans(prev_labels, cur_labels, want_bit):
            parent={}
            nodes=[]
            # create nodes for prev and cur frontier cells of this color
            for c,lbl in enumerate(prev_labels):
                if lbl:
                    node=('p',c)
                    parent[node]=node
                    nodes.append(node)
            for c,lbl in enumerate(cur_labels):
                if lbl:
                    node=('c',c)
                    parent[node]=node
                    nodes.append(node)
            def find(x):
                while parent[x]"'!=x:
                    parent[x]=parent[parent[x]]
                    x=parent[x]
                return x
            def union(x,y):
                rx,ry=find(x),find(y)
                if rx!=ry:
                    parent[ry]=rx
            # horizontal unions in current row by adjacent same color
            for c in range(w-1):
                if cur_labels[c] and cur_labels[c+1]:
                    union(('"'c',c),('c',c+1))
            # prev frontier same-label cells already connected
            label_first={}
            for c,lbl in enumerate(prev_labels):
                if lbl:
                    if lbl in label_first: union(('p',label_first[lbl]), ('p',c))
                    else: label_first[lbl]=c
            # vertical unions where same color in same column prev/current
            for c in range(w):
                if prev_labels[c] and cur_labels[c]:
                    union(('p',c),('c',c))
            # every prev component must connect to current row
            prev_roots={lbl:set() for lbl in set(prev_labels) if lbl}
            for c,lbl in enumerate(prev_labels):
                if lbl:
                    prev_roots[lbl].add(find(('p',c)))
            # canonical root rep per prev label
            for lbl in prev_roots:
                roots=prev_roots[lbl]
                if len(roots)"'!=1:
                    return None
                root=next(iter(roots))
                if not any(cur_labels[c] and find(('"'c',c))==root for c in range(w)):
                    return None
            # produce new labels on current row by connected components
            comp_map={}
            next_id=1
            new=[]
            for c,lbl in enumerate(cur_labels):
                if not lbl:
                    new.append(0)
                else:
                    root=find(('c',c))
                    if root not in comp_map:
                        comp_map[root]=next_id; next_id+=1
                    new.append(comp_map[root])
            return tuple(new)
        na=trans(prev_a, cur_a, 1)
        if na is None: return None
        nb=trans(prev_b, cur_b, 0)
        if nb is None: return None
        return canon(na), canon(nb)

    @lru_cache(None)
