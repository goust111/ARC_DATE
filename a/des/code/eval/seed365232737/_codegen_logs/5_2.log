from collections import defaultdict

def cycle(h,w):
    path=[]
    if h%2==0:
        path.append((0,0))
        for c in range(1,w):
            path.append((0,c))
        for r in range(1,h):
            if r%2==1:
                for c in range(w-1,0,-1):
                    path.append((r,c))
            else:
                for c in range(1,w):
                    path.append((r,c))
        for r in range(h-1,0,-1):
            path.append((r,0))
    else:
        # transpose construction for even w
        p=cycle(w,h)
