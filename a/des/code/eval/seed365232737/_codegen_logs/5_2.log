import random, math
from collections import deque
DIRS=[(1,0),(-1,0),(0,1),(0,-1)]

def conn(cells,h,w):
    if not cells: return False
    q=deque([next(iter(cells))]); seen={q[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in DIRS:
            nbr=(r+dr,c+dc)
            if nbr in cells and nbr not in seen:
                seen.add(nbr); q.append(nbr)
    return len(seen)==len(cells)

def full(cells,h,w):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1

def grow(h,w,tries=5000):
    allcells={(r,c) for r in range(h) for c in range(w)}
    for _ in range(tries):
        a={(random.randrange(h), random.randrange(w))}
        b={(random.randrange(h), random.randrange(w))}
        if a==b: continue
        fronts=[set(),set()]
        def upd(region,front):
            front.clear()
            for r,c in region:
                for dr,dc in DIRS:
                    nr,nc=r+dr,c+dc
                    if 0<=nr<h and 0<=nc<w and (nr,nc) not in a and (nr,nc) not in b:
                        front.add((nr,nc))
        upd(a,fronts[0]); upd(b,fronts[1])
        while len(a)+len(b)<h*w:
            cand=[]
            for i,front in enumerate(fronts):
                for cell in front:
                    # score cells that help touch new borders
                    reg=a if i==0 else b
                    rs=[r for r,c in reg]; cs=[c for r,c in reg]
                    needed=[]
                    if min(rs)>0: needed.append((0,cell[0]))
                    if max(rs)<h-1: needed.append((h-1,cell[0]))
                    if min(cs)>0: needed.append((0,cell[1]))
                    if max(cs)<w-1: needed.append((w-1,cell[1]))
                    d=min([abs(cell[0]-t)+abs(cell[1]-0) for t in []], default=0)
                    score=random.random()
                    r,c=cell
                    if min(rs)>0: score += 3/(1+r)
                    if max(rs)<h-1: score += 3/(1+(h-1-r))
                    if min(cs)>0: score += 3/(1+c)
                    if max(cs)<w-1: score += 3/(1+(w-1-c))
                    cand.append((score,i,cell))
            if not cand: break
            cand.sort(reverse=True)
            # probabilistic pick among top 10
            top=cand[:10]
            _,i,cell=random.choice(top)
            if cell in a or cell in b:
                continue
            (a if i==0 else b).add(cell)
            upd(a,fronts[0]); upd(b,fronts[1])
        if len(a)+len(b)==h*w and conn(a,h,w) and conn(b,h,w) and full(a,h,w) and full(b,h,w):
            return a,b
    return None,None

for dims in [(6,6),(7,7),(8,8),(8,9),(9,10),(10,10)]:
    a,b=grow(*dims,tries=200)
    print('dims',dims,'found',a is not None)
    if a:
        h,w=dims
        for r in range(h):
            print(''.join('#' if (r,c) in a else '.' for c in range(w)))
        print()
        break
