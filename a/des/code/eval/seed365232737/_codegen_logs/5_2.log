    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1

def search(h,w,limit_s=5.0):
    allcells={(r,c) for r in range(h) for c in range(w)}
    start=(0, random.randrange(1,w-1))
    deadline=time.time()+limit_s
    min_len=(h*w)//3
    max_len=(2*h*w)//3
    seen={start}
    path=[start]
    touched={ 'top', 'left' if start[1]==0 else None, 'right' if start[1]==w-1 else None, 'bottom' if start[0]==h-1 else None }
    touched.discard(None)

    def dfs(cur):
        if time.time()>deadline:
            return None
        if len(path)>=min_len and cur[0]==0 and cur"'!=start and {'"'top','left','right','bottom'}<=touched:
            A=set(path); B=allcells-A
            if conn(B,h,w) and full(A,h,w) and full(B,h,w):
                return list(path)
        if len(path)>=max_len:
            return None
        moves=[]
        r,c=cur
        for dr,dc in DIRS:
            nr,nc=r+dr,c+dc
            nxt=(nr,nc)
            if 0<=nr<h and 0<=nc<w and nxt not in seen:
                score=0
                if nr==0 and len(path)>=min_len-1: score+=2
                if nr==h-1 and 'bottom' not in touched: score+=3
                if nc==0 and 'left' not in touched: score+=3
                if nc==w-1 and 'right' not in touched: score+=3
                score+=random.random()
                moves.append((score,nxt))
        random.shuffle(moves)
        moves.sort(reverse=True)
        for _score,nxt in moves[:6]:
            seen.add(nxt); path.append(nxt)
            added=[]
            if nxt[0]==0: touched.add('top'); added.append('top')
            if nxt[0]==h-1: touched.add('bottom'); added.append('bottom')
            if nxt[1]==0: touched.add('left'); added.append('left')
            if nxt[1]==w-1: touched.add('right'); added.append('right')
            res=dfs(nxt)
            if res is not None:
                return res
            path.pop(); seen.remove(nxt)
            # recompute touched simply
            touched.clear()
            for rr,cc in path:
                if rr==0: touched.add('top')
                if rr==h-1: touched.add('bottom')
                if cc==0: touched.add('left')
                if cc==w-1: touched.add('right')
        return None

    return dfs(start)

for dims in [(8,8),(8,9),(9,10),(10,10)]:
    p=search(*dims,limit_s=4.0)
