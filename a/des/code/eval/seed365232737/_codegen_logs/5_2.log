from collections import deque
DIRS=[(1,0),(-1,0),(0,1),(0,-1)]

def spiral(h,w):
    cells=[]
    top,left,bottom,right=0,0,h-1,w-1
    while top<=bottom and left<=right:
        for c in range(left,right+1):
            cells.append((top,c))
        for r in range(top+1,bottom+1):
            cells.append((r,right))
        if top<bottom:
            for c in range(right-1,left,-1):
                cells.append((bottom,c))
        if left<right:
            for r in range(bottom,top+1,-1):
                cells.append((r,left+1))
        top += 2
        left += 2
        bottom -= 2
        right -= 2
        if top<=bottom and left<=right:
            cells.append((top-1,left))
    # dedupe preserving order if overlaps
    seen=set(); out=[]
    for x in cells:
        if x not in seen:
            seen.add(x); out.append(x)
    return set(out)

def conn(cells,h,w):
    if not cells: return False
    q=deque([next(iter(cells))]); seen={q[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in DIRS:
            nbr=(r+dr,c+dc)
            if nbr in cells and nbr not in seen:
                seen.add(nbr); q.append(nbr)
    return len(seen)==len(cells)

def full(cells,h,w):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1
for h,w in [(6,6),(7,7),(8,8),(8,9),(9,10),(10,10)]:
    A=spiral(h,w)
    B={(r,c) for r in range(h) for c in range(w)}-A
    print('dims',h,w,'A',len(A),conn(A,h,w),full(A,h,w),'B',len(B),conn(B,h,w),full(B,h,w))
    if conn(A,h,w) and conn(B,h,w) and full(A,h,w) and full(B,h,w):
        for r in range(h): print(''.join('#' if (r,c) in A else '.' for c in range(w)))
        print()
