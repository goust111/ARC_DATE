from functools import lru_cache


def canon(labels):
    mapping={}
    nxt=1
    out=[]
    for x in labels:
        if x==0:
            out.append(0)
        else:
            if x not in mapping:
                mapping[x]=nxt; nxt+=1
            out.append(mapping[x])
    return tuple(out)


def search(h,w):
