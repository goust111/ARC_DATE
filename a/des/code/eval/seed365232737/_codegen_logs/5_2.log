import random
from collections import defaultdict, deque
DIRS=[(1,0),(-1,0),(0,1),(0,-1)]

def rand_tree(h,w):
    start=(random.randrange(h), random.randrange(w))
    seen={start}
    parent={start:None}
    stack=[start]
    while stack:
        cur=stack[-1]
        r,c=cur
        nbrs=[(r+dr,c+dc) for dr,dc in DIRS if 0<=r+dr<h and 0<=c+dc<w and (r+dr,c+dc) not in seen]
        if nbrs:
            nxt=random.choice(nbrs)
            seen.add(nxt)
            parent[nxt]=cur
            stack.append(nxt)
        else:
            stack.pop()
    return parent

def bbox_full(cells,h,w):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1

def valid_cut(h,w,tries=200):
    allcells={(r,c) for r in range(h) for c in range(w)}
    for _ in range(tries):
        parent=rand_tree(h,w)
        children=defaultdict(list)
        root=None
        for v,p in parent.items():
            if p is None: root=v
            else: children[p].append(v)
        order=[]
        stack=[root]
        while stack:
            v=stack.pop()
            order.append(v)
            stack.extend(children[v])
        sub={}
        for v in reversed(order):
            s={v}
            for ch in children[v]:
                s |= sub[ch]
            sub[v]=s
        count=0
        for v,p in parent.items():
            if p is None: continue
            a=sub[v]
            b=allcells-a
            if bbox_full(a,h,w) and bbox_full(b,h,w):
                count+=1
                return True, len(a), len(b)
    return False,None,None

for h,w in [(4,4),(4,5),(5,5),(5,6),(6,6),(6,7),(7,7)]:
    found=0
    sizes=[]
    for i in range(100):
        ok,a,b=valid_cut(h,w,tries=50)
        if ok:
            found+=1
            sizes.append((a,b))
    print((h,w), found, sizes[:5])
