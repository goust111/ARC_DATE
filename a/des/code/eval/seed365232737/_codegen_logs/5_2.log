import random
from collections import deque

DIRS=[(1,0),(-1,0),(0,1),(0,-1)]

def connected(cells,h,w):
    if not cells:
        return False
    cells=set(cells)
    q=deque([next(iter(cells))])
    seen={q[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in DIRS:
            nr,nc=r+dr,c+dc
            if (nr,nc) in cells and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return len(seen)==len(cells)

def bbox_full(cells,h,w):
    rs=[r for r,c in cells]
    cs=[c for r,c in cells]
    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1

def rand_path(a,b,h,w):
    # random shortest path
    r,c=a
    path=[a]
    while (r,c)"'!=b:
        moves=[]
        if r<b[0]: moves.append((1,0))
        if r>b[0]: moves.append((-1,0))
        if c<b[1]: moves.append((0,1))
        if c>b[1]: moves.append((0,-1))
        dr,dc=random.choice(moves)
        r+=dr;c+=dc
        path.append((r,c))
    return path

def sample(h,w,tries=5000):
    allcells={(r,c) for r in range(h) for c in range(w)}
    for _ in range(tries):
        anchors=[(0, random.randrange(w)), (random.randrange(h), w-1), (h-1, random.randrange(w)), (random.randrange(h),0)]
        # avoid too many corners maybe not necessary
        order=[anchors[0], anchors[1], anchors[2], anchors[3]]
        cells=set()
        cur=order[0]
        cells.add(cur)
        ok=True
        for nxt in order[1:]:
            path=rand_path(cur,nxt,h,w)
            for p in path:
                cells.add(p)
            cur=nxt
        # grow a bit
        target=random.randint(max(4, (h*w)//4), min(h*w-4, (3*h*w)//4))
