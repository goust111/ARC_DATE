import random, math
import numpy as np
from collections import deque
TEMPLATE_FILL_FRACTION_RANGE=(0.48,0.84)
TEMPLATE_STOP_PROBABILITY=0.35
ORTHOGONAL_STEPS=((-1,0),(1,0),(0,-1),(0,1))
DIRS=ORTHOGONAL_STEPS

def gen_path(mask,a,b):
    r,c=a; tr,tc=b
    if random.random()<0.5:
        while r"'!=tr:
            mask[r,c]=True; r += 1 if tr>r else -1
        while c!=tc:
            mask[r,c]=True; c += 1 if tc>c else -1
    else:
        while c!=tc:
            mask[r,c]=True; c += 1 if tc>c else -1
        while r!=tr:
            mask[r,c]=True; r += 1 if tr>r else -1
    mask[tr,tc]=True

def orbit(side,r,c):
    last=side-1
    return {(r,c),(c,r),(last-r,c),(r,last-c),(last-r,last-c),(last-c,last-r),(c,last-r),(last-c,r)}

def add_orbit(mask,r,c):
    for rr,cc in orbit(mask.shape[0],r,c):
        mask[rr,cc]=True

def gen_template(side):
    min_fill,max_fill=TEMPLATE_FILL_FRACTION_RANGE
    min_area=int(math.ceil(min_fill*side*side)); max_area=int(math.floor(max_fill*side*side))
    for _ in range(100):
        target=random.randint(min_area,max_area)
        mask=np.zeros((side,side),dtype=bool)
        center=side//2; top_c=random.randrange(side)
        gen_path(mask,(center,center),(0,top_c))
        for r,c in list(map(tuple,np.argwhere(mask))):
            add_orbit(mask,int(r),int(c))
        if int(mask.sum())>max_area:
            continue
        target=max(target,int(mask.sum()))
        while int(mask.sum())<target:
            choices=[]
            for r,c in np.argwhere(mask):
                for dr,dc in ORTHOGONAL_STEPS:
                    nr,nc=r+dr,c+dc
                    if 0<=nr<side and 0<=nc<side and not mask[nr,nc]:
                        orb=orbit(side,int(nr),int(nc))
                        added=sum(1 for p in orb if not mask[p])
                        if added and int(mask.sum())+added<=max_area:
                            choices.append((int(nr),int(nc),added))
            if not choices:
                break
            if int(mask.sum())>=min_area and random.random()<TEMPLATE_STOP_PROBABILITY:
                break
            r,c,_=random.choice(choices); add_orbit(mask,r,c)
        if min_area<=int(mask.sum())<=max_area:
            return mask
    return None

def conn(mask):
    pts=set(map(tuple,np.argwhere(mask)))
    if not pts: return False
    q=deque([next(iter(pts))]); seen={q[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in DIRS:
            nbr=(r+dr,c+dc)
            if nbr in pts and nbr not in seen:
                seen.add(nbr); q.append(nbr)
    return len(seen)==len(pts)

def full(mask):
    pts=np.argwhere(mask)
    return pts[:,0].min()==0 and pts[:,0].max()==mask.shape[0]-1 and pts[:,1].min()==0 and pts[:,1].max()==mask.shape[1]-1

for side in [5,6,7,8,9,10]:
    found=0
    for _ in range(500):
        m=gen_template(side)
        if m is None: continue
        comp=~m
        if conn(m) and conn(comp) and full(m) and full(comp):
            found+=1
            if found==1:
                print('"'example side',side,'area',int(m.sum()))
                for r in range(side):
                    print(''.join('#' if m[r,c] else '.' for c in range(side)))
                print()
    print('side',side,'found',found)
