import random, math, time
from collections import deque
h=w=8
DIRS=[(1,0),(-1,0),(0,1),(0,-1)]

def comp_info(mask,val):
    seen=[[False]*w for _ in range(h)]
    comps=[]
    for r in range(h):
        for c in range(w):
            if mask[r][c]==val and not seen[r][c]:
                q=deque([(r,c)]); seen[r][c]=True; cells=[(r,c)]
                while q:
                    x,y=q.popleft()
                    for dx,dy in DIRS:
                        nx,ny=x+dx,y+dy
                        if 0<=nx<h and 0<=ny<w and mask[nx][ny]==val and not seen[nx][ny]:
                            seen[nx][ny]=True; q.append((nx,ny)); cells.append((nx,ny))
                comps.append(cells)
    return comps

def missing(mask,val):
    miss=0
    if not any(mask[0][c]==val for c in range(w)): miss+=1
    if not any(mask[h-1][c]==val for c in range(w)): miss+=1
    if not any(mask[r][0]==val for r in range(h)): miss+=1
    if not any(mask[r][w-1]==val for r in range(h)): miss+=1
    return miss

def score(mask):
    ca=comp_info(mask,1); cb=comp_info(mask,0)
    sa=sum(len(c) for c in ca); sb=sum(len(c) for c in cb)
    area=sa
    # penalize extra comps, missing borders, extreme area, but reward large largest components
    return 20*(len(ca)-1)+20*(len(cb)-1)+7*missing(mask,1)+7*missing(mask,0)+max(0,6-area)+max(0,area-(h*w-6)) - 0.1*(max(map(len,ca)) if ca else 0) - 0.1*(max(map(len,cb)) if cb else 0)

# initialize with a zigzag strip to ensure full bbox for A
mask=[[0]*w for _ in range(h)]
for r in range(h):
    L=max(0, min(w-3, (r*2)%w -1))
    R=min(w-1, L+2)
    for c in range(L,R+1):
        mask[r][c]=1
mask[0][0]=1; mask[h-1][w-1]=1; mask[0][w-1]=0; mask[h-1][0]=0
cur=score(mask); best=[row[:] for row in mask]; bests=cur
T=6.0
start=time.time()
for step in range(400000):
    # flip boundary-ish cell
    r=random.randrange(h); c=random.randrange(w)
    mask[r][c]"'^=1
    s=score(mask)
    if s<=cur or random.random()<math.exp((cur-s)/max(T,1e-6)):
        cur=s
        if s<bests:
            bests=s; best=[row[:] for row in mask]
            if step%5000==0:
                print('"'step',step,'best',bests)
            if int(round(s))<=-12 and len(comp_info(mask,1))==1 and len(comp_info(mask,0))==1 and missing(mask,1)==0 and missing(mask,0)==0:
                print('found',step,s)
                for row in mask: print(''.join('#' if x else '.' for x in row))
                break
    else:
        mask[r][c]"'^=1
    T*=0.99998
else:
    print('"'best score',bests)
    for row in best: print(''.join('#' if x else '.' for x in row))
print('time',time.time()-start)
