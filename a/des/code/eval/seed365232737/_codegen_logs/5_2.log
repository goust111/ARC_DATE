from collections import deque
import random
DIRS=[(-1,0),(1,0),(0,-1),(0,1)]

def cells_from_path(h,w,verts):
    edges=set()
    for (y1,x1),(y2,x2) in zip(verts, verts[1:]):
        if x1==x2:
            step=1 if y2>y1 else -1
            for y in range(y1, y2, step):
                a=(y,x1); b=(y+step,x1)
                edges.add(tuple(sorted((a,b))))
        else:
            step=1 if x2>x1 else -1
            for x in range(x1, x2, step):
                a=(y1,x); b=(y1,x+step)
                edges.add(tuple(sorted((a,b))))
    def blocked_between(cell, nbr):
        r,c=cell; nr,nc=nbr
        if nr==r-1:
            e=tuple(sorted(((r,c),(r,c+1))))
        elif nr==r+1:
            e=tuple(sorted(((r+1,c),(r+1,c+1))))
        elif nc==c-1:
            e=tuple(sorted(((r,c),(r+1,c))))
        elif nc==c+1:
            e=tuple(sorted(((r,c+1),(r+1,c+1))))
        else:
            raise
        return e in edges
    start=(0,0)
    q=deque([start])
    seen={start}
    while q:
        r,c=q.popleft()
        for dr,dc in DIRS:
            nr,nc=r+dr,c+dc
            if 0<=nr<h and 0<=nc<w and (nr,nc) not in seen and not blocked_between((r,c),(nr,nc)):
                seen.add((nr,nc)); q.append((nr,nc))
    A=seen
    B={(r,c) for r in range(h) for c in range(w)}-A
    return A,B

def full(cells,h,w):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1

def conn(cells,h,w):
    if not cells: return False
    q=deque([next(iter(cells))]); seen={q[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in DIRS:
            nr,nc=r+dr,c+dc
            if (nr,nc) in cells and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return len(seen)==len(cells)

def try_one(h,w):
    # require w>=6, h>=6 maybe
    a=random.randint(1,w-5)
    b=random.randint(a+1,w-3)
    c=random.randint(b+1,w-2)
    d=random.randint(c+1,w-1)
    u=random.randint(1,h-4)
    v=random.randint(u+1,h-2)
    t=random.randint(v+1,h-1)
    s=random.randint(1,t-1)
    verts=[(0,a),(u,a),(u,0),(v,0),(v,b),(h,b),(h,c),(t,c),(t,w),(s,w),(s,d),(0,d)]
    A,B=cells_from_path(h,w,verts)
    return verts,A,B

for h,w in [(6,7),(7,8),(8,9),(9,9)]:
    ok=0
    for _ in range(500):
        verts,A,B=try_one(h,w)
        if conn(A,h,w) and conn(B,h,w) and full(A,h,w) and full(B,h,w):
            ok+=1
            if ok==1:
                print('example dims',h,w,'verts',verts,'sizes',len(A),len(B))
                grid=[['#' if (r,c) in A else '.' for c in range(w)] for r in range(h)]
                for row in grid: print(''.join(row))
                print()
    print('dims',h,w,'ok',ok)
