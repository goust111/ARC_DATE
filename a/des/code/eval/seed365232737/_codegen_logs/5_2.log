import random, math
from collections import deque
DIRS=[(1,0),(-1,0),(0,1),(0,-1)]

def comp_count(mask):
    h=len(mask); w=len(mask[0])
    seen=[[False]*w for _ in range(h)]
    cnt=0
    for r in range(h):
        for c in range(w):
            if mask[r][c] and not seen[r][c]:
                cnt+=1
                q=deque([(r,c)]); seen[r][c]=True
                while q:
                    x,y=q.popleft()
                    for dx,dy in DIRS:
                        nx,ny=x+dx,y+dy
                        if 0<=nx<h and 0<=ny<w and mask[nx][ny] and not seen[nx][ny]:
                            seen[nx][ny]=True; q.append((nx,ny))
    return cnt

def missing(mask):
    h=len(mask); w=len(mask[0])
    miss=0
    if not any(mask[0][c] for c in range(w)): miss+=1
    if not any(mask[h-1][c] for c in range(w)): miss+=1
    if not any(mask[r][0] for r in range(h)): miss+=1
    if not any(mask[r][w-1] for r in range(h)): miss+=1
    return miss

def score(mask):
    h=len(mask); w=len(mask[0])
    compA=comp_count(mask)
    compB=comp_count([[not v for v in row] for row in mask])
    missA=missing(mask)
    missB=missing([[not v for v in row] for row in mask])
    area=sum(sum(row) for row in mask)
    total=h*w
    area_pen=0 if 2<=area<=total-2 else 10
    return 5*(compA-1)+5*(compB-1)+3*missA+3*missB+area_pen

def solve(h,w,steps=50000):
    # initial random balanced mask
    mask=[[random.random()<0.5 for _ in range(w)] for _ in range(h)]
    best=[row[:] for row in mask]
    bests=score(mask)
    cur=bests
    T=3.0
    for t in range(steps):
        r=random.randrange(h); c=random.randrange(w)
        mask[r][c]=not mask[r][c]
        s=score(mask)
        if s<=cur or random.random()<math.exp((cur-s)/max(0.001,T)):
            cur=s
            if s<bests:
                bests=s; best=[row[:] for row in mask]
                if s==0:
                    return best
        else:
            mask[r][c]=not mask[r][c]
        T*=0.9999
    return best if bests==0 else None

for h,w in [(3,3),(4,4),(4,5),(5,5),(5,6),(6,6)]:
    ok=0
    for i in range(20):
        res=solve(h,w,steps=10000)
        if res is not None:
            ok+=1
    print((h,w),ok)
