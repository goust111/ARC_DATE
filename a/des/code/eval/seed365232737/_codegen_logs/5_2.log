        a=[]; b=[]
        cur=0; label=0
        for c in range(w):
            bit=(mask>>c)&1
            if bit:
                if c==0 or ((mask>>(c-1))&1)==0:
                    label+=1
                a.append(label)
            else:
                a.append(0)
        label=0
        for c in range(w):
            bit=(mask>>c)&1
            if not bit:
                if c==0 or ((mask>>(c-1))&1)==1:
                    label+=1
                b.append(label)
            else:
                b.append(0)
