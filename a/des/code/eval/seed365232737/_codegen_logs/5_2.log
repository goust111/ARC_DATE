from collections import deque
DIRS=[(1,0),(-1,0),(0,1),(0,-1)]

def two_spirals(h,w):
    A=set(); B=set()
    r0,c0=0,0; r1,c1=h-1,w-1
    while r0<=r1 and c0<=c1:
        # A gets top row and right column
        for c in range(c0,c1+1):
            A.add((r0,c))
        for r in range(r0+1,r1+1):
            A.add((r,c1))
        # B gets bottom row (excluding bottom-right already taken) and left column (excluding top-left and bottom-left if already on bottom row)
        if r0<r1:
            for c in range(c0,c1):
                B.add((r1,c))
        for r in range(r0+1,r1):
            B.add((r,c0))
        r0 += 1; c0 += 1; r1 -= 1; c1 -= 1
    return A,B

def conn(cells,h,w):
    if not cells: return False
    q=deque([next(iter(cells))]); seen={q[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in DIRS:
            nbr=(r+dr,c+dc)
            if nbr in cells and nbr not in seen:
                seen.add(nbr); q.append(nbr)
    return len(seen)==len(cells)

def full(cells,h,w):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1
for h,w in [(4,4),(5,5),(6,6),(7,7),(8,8),(8,9),(9,10)]:
