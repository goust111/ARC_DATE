import z3

def find(h,w):
    N=h*w
    x=[[z3.Bool(f'x_{r}_{c}') for c in range(w)] for r in range(h)]
    ra=[[z3.Int(f'ra_{r}_{c}') for c in range(w)] for r in range(h)]
    rb=[[z3.Int(f'rb_{r}_{c}') for c in range(w)] for r in range(h)]
    s=z3.Solver()
    # symmetry/root choices
    s.add(x[0][0])        # top-left in A
    s.add(z3.Not(x[0][w-1]))  # top-right in B
    # ranks bounds
    for r in range(h):
        for c in range(w):
            s.add(ra[r][c] >= 0, ra[r][c] < N)
            s.add(rb[r][c] >= 0, rb[r][c] < N)
    # A connected to root (0,0)
    s.add(ra[0][0] == 0)
    for r in range(h):
        for c in range(w):
            if (r,c)==(0,0):
                continue
            nbrs=[]
            for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
                nr,nc=r+dr,c+dc
                if 0<=nr<h and 0<=nc<w:
                    nbrs.append(z3.And(x[nr][nc], ra[nr][nc] < ra[r][c]))
            s.add(z3.Implies(x[r][c], z3.Or(nbrs)))
    # B connected to root (0,w-1)
    s.add(rb[0][w-1] == 0)
    for r in range(h):
        for c in range(w):
            if (r,c)==(0,w-1):
                continue
            nbrs=[]
            for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
                nr,nc=r+dr,c+dc
                if 0<=nr<h and 0<=nc<w:
                    nbrs.append(z3.And(z3.Not(x[nr][nc]), rb[nr][nc] < rb[r][c]))
            s.add(z3.Implies(z3.Not(x[r][c]), z3.Or(nbrs)))
    # each side touched by both colors
    s.add(z3.Or([x[0][c] for c in range(w)]))
    s.add(z3.Or([z3.Not(x[0][c]) for c in range(w)]))
    s.add(z3.Or([x[h-1][c] for c in range(w)]))
    s.add(z3.Or([z3.Not(x[h-1][c]) for c in range(w)]))
    s.add(z3.Or([x[r][0] for r in range(h)]))
    s.add(z3.Or([z3.Not(x[r][0]) for r in range(h)]))
    s.add(z3.Or([x[r][w-1] for r in range(h)]))
    s.add(z3.Or([z3.Not(x[r][w-1]) for r in range(h)]))
    # nontrivial sizes
    area=z3.Sum([z3.If(x[r][c],1,0) for r in range(h) for c in range(w)])
    s.add(area >= 4, area <= N-4)
    if s.check() == z3.sat:
        m=s.model()
        grid=[[1 if z3.is_true(m.eval(x[r][c])) else 0 for c in range(w)] for r in range(h)]
        return grid
    return None

for dims in [(4,4),(4,5),(5,5),(5,6),(6,6),(6,7),(7,7)]:
    g=find(*dims)
    print('dims',dims,'found',g is not None)
    if g:
        for row in g:
            print(''.join('#' if v else '.' for v in row))
        print()
