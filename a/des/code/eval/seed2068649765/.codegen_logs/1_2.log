+    prev: tuple[int, int] | None = None
+    curr = start
+    while True:
+        nexts = [
+            (curr[0] + dr, curr[1] + dc)
+            for dr, dc in DIRS
+            if (curr[0] + dr, curr[1] + dc) in coords and (curr[0] + dr, curr[1] + dc) != prev
+        ]
+        if not nexts:
+            break
+        assert len(nexts) == 1, "path traversal must be unambiguous"
+        nxt = nexts[0]
+        ordered.append(nxt)
