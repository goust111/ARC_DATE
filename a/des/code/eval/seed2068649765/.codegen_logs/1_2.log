+    degrees: dict[tuple[int, int], int] = {}
+    endpoints: list[tuple[int, int]] = []
+    for r, c in coords:
+        deg = sum((r + dr, c + dc) in coords for dr, dc in DIRS)
+        assert 1 <= deg <= 2, "path must be a single-width non-branching polyline"
