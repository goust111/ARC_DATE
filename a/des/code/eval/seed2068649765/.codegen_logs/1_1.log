+    positions: list[tuple[int, int] | None] = [None] * len(patches)
+    boxes: list[tuple[int, int, int, int]] = []
+
+    for idx in order:
+        patch = patches[idx]
+        h, w = map(int, patch.shape)
+        if h > region_h or w > region_w:
+            return None
