+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+FRAME_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+ROOM_COUNTS = (1, 2, 3, 4, 5, 6)
+MIN_ROOM_SIZE = 2
+MAX_ROOM_SIZE = 7
+MAX_TEMPLATE_SIDE = 4
+FRAME_GAP = 2
+TEMPLATE_GAP = 1
