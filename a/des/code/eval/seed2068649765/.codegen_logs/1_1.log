+        while int(canvas.sum()) < area:
+            frontier: set[tuple[int, int]] = set()
+            for r, c in zip(*np.where(canvas), strict=False):
+                for nr, nc in _neighbors4(int(r), int(c), side, side):
+                    if not canvas[nr, nc]:
