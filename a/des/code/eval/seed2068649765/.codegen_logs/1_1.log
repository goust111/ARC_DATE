+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+FRAME_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+ROOM_COUNTS = (1, 2, 3, 4, 5, 6)
+MIN_ROOM_SIZE = 2
+MAX_ROOM_SIZE = 7
+MAX_TEMPLATE_SIDE = 4
+FRAME_GAP = 2
+TEMPLATE_GAP = 1
+
+GENERATION_RETRIES = 400
+SHAPE_RETRIES = 200
+FRAME_RETRIES = 120
+PLACEMENT_RETRIES = 300
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _coords_to_mask(
+    coords: list[tuple[int, int]] | tuple[tuple[int, int], ...]
+) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = _bbox(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
+    return mask, (r0, c0, r1, c1)
+
+
+def _trim(mask: np.ndarray) -> np.ndarray:
+    rows, cols = np.where(mask)
+    if rows.size == 0:
+        return np.zeros((0, 0), dtype=bool)
+    return mask[rows.min() : rows.max() + 1, cols.min() : cols.max() + 1].copy()
+
+
+def _template_lookup(grid: np.ndarray) -> dict[int, np.ndarray]:
+    templates: dict[int, np.ndarray] = {}
+    for comp in _components(grid == GREY):
+        mask, _ = _coords_to_mask(comp)
+        area = int(mask.sum())
+        templates[area] = mask
+    return templates
+
+
+def _enclosed_rooms(occupied: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = occupied.shape
+    bg_mask = ~occupied
+    seen = np.zeros((h, w), dtype=bool)
+    rooms: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bg_mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            touches_border = False
+            while q:
+                rr, cc = q.popleft()
+                comp.append((int(rr), int(cc)))
+                if rr == 0 or cc == 0 or rr == h - 1 or cc == w - 1:
+                    touches_border = True
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if bg_mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            if not touches_border:
+                rooms.append(comp)
+    return rooms
+
+
+def _room_key(room: list[tuple[int, int]]) -> tuple[int, int, int]:
+    top = min(r for r, _ in room)
+    left = min(c for _, c in room)
+    return (len(room), -top, -left)
+
