+    random.shuffle(template_items)
+    slot_size = max(max(mask.shape) for _count, mask in template_items) + 1
+    band_size = slot_size + 2
+    strip_len = len(template_items) * slot_size + (len(template_items) - 1) * TEMPLATE_GAP
