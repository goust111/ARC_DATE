+    width = min(area, MAX_TEMPLATE_SIDE)
+    height = (area + width - 1) // width
+    fallback = np.zeros((height, width), dtype=bool)
+    cells = area
+    for r in range(height):
+        for c in range(width):
+            if cells > 0:
+                fallback[r, c] = True
+                cells -= 1
