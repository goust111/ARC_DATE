+        row_sizes = _sample_sizes(room_rows, template_h)
+        col_sizes = _sample_sizes(room_cols, template_w)
+        height = 2 + sum(row_sizes) + (room_rows - 1)
+        width = 2 + sum(col_sizes) + (room_cols - 1)
+
+        patch = np.zeros((height, width), dtype=int)
+        patch[0, :] = color
+        patch[-1, :] = color
+        patch[:, 0] = color
+        patch[:, -1] = color
