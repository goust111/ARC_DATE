+def _border_mask(h: int, w: int) -> int:
+    mask = 0
+    for r in range(h):
+        for c in range(w):
+            if r in (0, h - 1) or c in (0, w - 1):
+                mask |= 1 << (r * w + c)
+    return mask
+
+
+def _placement_masks(shape: np.ndarray, h: int, w: int) -> list[int]:
+    sh, sw = _shape_dims(shape)
+    out: list[int] = []
+    for r0 in range(h - sh + 1):
+        for c0 in range(w - sw + 1):
+            mask = 0
+            for r, c in shape:
