+def _trace_path(path_mask: np.ndarray, start: tuple[int, int]) -> list[tuple[int, int]]:
+    order = [start]
+    prev = None
+    cur = start
+    while True:
+        nxts = [p for p in _neighbors4(cur[0], cur[1], path_mask.shape) if path_mask[p]]
+        if prev is not None:
+            nxts = [p for p in nxts if p != prev]
+        if not nxts:
