  43: def main(grid: np.ndarray) -> np.ndarray:
  44:     """
  45:     Within each horizontal pair of two-color panels, swap the motif masks and recolor each pasted mask with the source panel's base color.
  46: 
  47:     Input structure:
  48:     - A separator color forms full blank rows and at least one full blank column.
  49:     - The non-separator area is split into row bands, each containing exactly two same-shaped rectangular panels.
  50:     - Each panel has a dominant base color and one minority motif color.
  51: 
  52:     Rule:
  53:     - For every row band, clear each panel to its own base color.
  54:     - Paste the right panel's motif mask into the left panel using the right base color.
  55:     - Paste the left panel's motif mask into the right panel using the left base color.
  56: 
  57:     Key insight:
  58:     - The motif colors themselves are distractors; only each motif's shape mask and the two panel base colors are exchanged.
  59:     """
  60:     g = np.asarray(grid, dtype=int)
  61:     assert g.ndim == 2, "grid must be 2D"
  62: 
  63:     sep = _separator_color(g)
  64:     row_bands = _bands(np.where(~np.all(g == sep, axis=1))[0])
  65:     col_bands = _bands(np.where(~np.all(g == sep, axis=0))[0])
  66:     assert len(col_bands) == 2, f"expected exactly two panel columns, got {len(col_bands)}"
  67: 
  68:     out = g.copy()
  69:     (lc0, lc1), (rc0, rc1) = col_bands
  70:     for r0, r1 in row_bands:
  71:         left = g[r0 : r1 + 1, lc0 : lc1 + 1]
  72:         right = g[r0 : r1 + 1, rc0 : rc1 + 1]
  73:         assert left.shape == right.shape, "paired panels must have the same shape"
  74: 
  75:         left_base, left_motif = _base_and_motif_mask(left)
  76:         right_base, right_motif = _base_and_motif_mask(right)
  77: 
  78:         new_left = np.full(left.shape, left_base, dtype=int)
  79:         new_right = np.full(right.shape, right_base, dtype=int)
  80:         new_left[right_motif] = right_base
  81:         new_right[left_motif] = left_base
  82: 
  83:         out[r0 : r1 + 1, lc0 : lc1 + 1] = new_left
  84:         out[r0 : r1 + 1, rc0 : rc1 + 1] = new_right
  85: 
  86:     return out
