+def _all_packing_keys(fragments: list[dict], limit: int = 2) -> set[tuple]:
+    area = sum(int(frag["area"]) for frag in fragments)
+    keys: set[tuple] = set()
+    seen_dims: set[tuple[int, int]] = set()
