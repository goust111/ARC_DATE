+    out_h = max(h for _area, h, _w, _color in rects)
+    out_w = sum(w for _area, _h, w, _color in rects) + len(rects) - 1
+
+    out = np.zeros((out_h, out_w), dtype=int)
+    c0 = 0
+    for _area, h, w, color in rects:
+        out[out_h - h : out_h, c0 : c0 + w] = int(color)
+        c0 += w + 1
+    return out
