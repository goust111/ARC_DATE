+    neighbors = _neighbor_map(h, w)
+
+    for _ in range(PARTITION_ATTEMPTS):
+        work_sizes = list(sizes)
+        random.shuffle(work_sizes)
+        remaining = set(all_cells)
+        pieces: list[set[tuple[int, int]]] = []
+        ok = True
+
+        for size in work_sizes[:-1]:
+            piece = _random_connected_subset(remaining, int(size), neighbors)
+            if piece is None:
+                ok = False
+                break
+            pieces.append(piece)
+            remaining -= piece
+            if not _is_connected(remaining):
