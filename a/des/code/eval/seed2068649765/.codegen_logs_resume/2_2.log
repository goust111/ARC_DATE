+
+def _sample_piece_sizes(area: int, piece_count: int) -> list[int]:
+    sizes: list[int] = []
+    remaining = int(area)
+    for i in range(piece_count - 1):
+        pieces_left = piece_count - i - 1
+        lo = max(PIECE_AREA_RANGE[0], remaining - PIECE_AREA_RANGE[1] * pieces_left)
+        hi = min(PIECE_AREA_RANGE[1], remaining - PIECE_AREA_RANGE[0] * pieces_left)
+        size = random.randint(lo, hi)
+        sizes.append(int(size))
+        remaining -= int(size)
