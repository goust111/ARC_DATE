+    h_hi = max(h_lo, min(INPUT_SIDE_RANGE[1], base + 4))
+    w_lo = max(INPUT_SIDE_RANGE[0], min(INPUT_SIDE_RANGE[1], base - 1))
+    w_hi = max(w_lo, min(INPUT_SIDE_RANGE[1], base + 5))
