+    out = np.zeros((out_h, out_w), dtype=int)
+    c0 = 0
+    for group in ordered:
+        out[out_h - group["h"] : out_h, c0 : c0 + group["w"]] = int(group["color"])
+        c0 += int(group["w"]) + 1
+    return out
