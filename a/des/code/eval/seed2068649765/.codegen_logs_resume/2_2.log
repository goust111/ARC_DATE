+    shape: tuple[tuple[int, int], ...],
+    rect_h: int,
+    rect_w: int,
+) -> tuple[int, ...]:
+    frag_h, frag_w = _shape_dims(shape)
+    if frag_h > rect_h or frag_w > rect_w:
+        return ()
+
+    masks: list[int] = []
+    for r0 in range(rect_h - frag_h + 1):
+        for c0 in range(rect_w - frag_w + 1):
+            bits = 0
+            for r, c in shape:
+                bit = (r0 + r) * rect_w + (c0 + c)
+                bits |= 1 << int(bit)
+            masks.append(bits)
+    return tuple(masks)
