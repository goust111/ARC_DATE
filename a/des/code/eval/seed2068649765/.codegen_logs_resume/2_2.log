+def _normalize(cells: set[tuple[int, int]] | list[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    rows = [r for r, _c in cells]
+    cols = [c for _r, c in cells]
+    r0 = min(rows)
+    c0 = min(cols)
+    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in cells))
