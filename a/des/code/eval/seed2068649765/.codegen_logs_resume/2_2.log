+        return set(cells)
+
+    cell_list = list(cells)
+    for _ in range(SUBSET_ATTEMPTS):
+        seed = random.choice(cell_list)
+        subset = {seed}
+        while len(subset) < target_size:
+            frontier = {
+                nxt
+                for cell in subset
+                for nxt in neighbors[cell]
+                if nxt in cells and nxt not in subset
+            }
+            if not frontier:
+                break
+            best_score = max(
+                sum(1 for nxt in neighbors[cell] if nxt in cells and nxt not in subset)
+                for cell in frontier
