+    def search(remaining: tuple[int, ...], used: int, chosen: tuple[tuple[int, int], ...]) -> None:
+        if len(seen_keys) >= limit:
+            return
+        if not remaining:
+            if used == full_mask:
+                seen_keys.add(canonical(chosen))
+            return
+
+        uncovered = full_mask & ~used
+        if uncovered == 0:
+            return
+        first_bit = uncovered & -uncovered
