+
+def _generate_attempt() -> np.ndarray | None:
+    color_count = random.randint(COLOR_COUNT_RANGE[0], COLOR_COUNT_RANGE[1])
+    colors = random.sample(COLOR_POOL, color_count)
+    areas = random.sample(sorted(AREA_TO_DIMS), color_count)
