+
+def _sample_piece_sizes(area: int, piece_count: int) -> list[int]:
+    sizes: list[int] = []
+    remaining = int(area)
+    for i in range(piece_count - 1):
+        pieces_left = piece_count - i - 1
+        lo = max(PIECE_AREA_RANGE[0], remaining - PIECE_AREA_RANGE[1] * pieces_left)
+        hi = min(PIECE_AREA_RANGE[1], remaining - PIECE_AREA_RANGE[0] * pieces_left)
+        size = random.randint(lo, hi)
+        sizes.append(int(size))
+        remaining -= int(size)
+    sizes.append(int(remaining))
+    random.shuffle(sizes)
+    return sizes
+
+
+def _neighbor_map(h: int, w: int) -> dict[tuple[int, int], tuple[tuple[int, int], ...]]:
+    return {
+        (r, c): tuple(
+            (r + dr, c + dc)
+            for dr, dc in DIR4
+            if 0 <= r + dr < h and 0 <= c + dc < w
+        )
+        for r in range(h)
+        for c in range(w)
+    }
+
+
+def _random_connected_subset(
+    cells: set[tuple[int, int]],
+    target_size: int,
+    neighbors: dict[tuple[int, int], tuple[tuple[int, int], ...]],
+) -> set[tuple[int, int]] | None:
+    if target_size == len(cells):
+        return set(cells)
+
+    cell_list = list(cells)
+    for _ in range(SUBSET_ATTEMPTS):
+        seed = random.choice(cell_list)
+        subset = {seed}
+        while len(subset) < target_size:
+            frontier = {
+                nxt
+                for cell in subset
+                for nxt in neighbors[cell]
+                if nxt in cells and nxt not in subset
+            }
+            if not frontier:
+                break
+            best_score = max(
+                sum(1 for nxt in neighbors[cell] if nxt in cells and nxt not in subset)
+                for cell in frontier
+            )
+            options = [
+                cell
+                for cell in frontier
+                if sum(1 for nxt in neighbors[cell] if nxt in cells and nxt not in subset) == best_score
+            ]
+            subset.add(random.choice(options))
+
+        if len(subset) != target_size:
+            continue
+        remaining = cells - subset
+        if remaining and _is_connected(remaining):
+            return subset
+    return None
+
+
+def _partition_rectangle(h: int, w: int, sizes: list[int]) -> list[tuple[tuple[int, int], ...]] | None:
