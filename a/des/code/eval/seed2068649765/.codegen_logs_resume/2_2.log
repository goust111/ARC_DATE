+
+# --------------- generator ---------------
+
+COLOR_POOL = tuple(range(1, 10))
+AREA_TO_DIMS: dict[int, tuple[tuple[int, int], ...]] = {
+    6: ((2, 3), (3, 2)),
+    8: ((2, 4), (4, 2)),
+    9: ((3, 3),),
+    10: ((2, 5), (5, 2)),
+    12: ((2, 6), (3, 4), (4, 3), (6, 2)),
+    14: ((2, 7), (7, 2)),
+    15: ((3, 5), (5, 3)),
