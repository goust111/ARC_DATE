+        return False
+    start = next(iter(cells))
+    stack = [start]
+    seen = {start}
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in DIR4:
+            nxt = (r + dr, c + dc)
+            if nxt in cells and nxt not in seen:
+                seen.add(nxt)
+                stack.append(nxt)
+    return len(seen) == len(cells)
+
+
+def _is_rect(shape: tuple[tuple[int, int], ...]) -> bool:
+    h, w = _shape_dims(shape)
+    return len(shape) == h * w
