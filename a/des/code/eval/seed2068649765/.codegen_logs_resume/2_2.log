+
+def _neighbor_map(h: int, w: int) -> dict[tuple[int, int], tuple[tuple[int, int], ...]]:
+    return {
+        (r, c): tuple(
+            (r + dr, c + dc)
+            for dr, dc in DIR4
+            if 0 <= r + dr < h and 0 <= c + dc < w
+        )
+        for r in range(h)
+        for c in range(w)
+    }
