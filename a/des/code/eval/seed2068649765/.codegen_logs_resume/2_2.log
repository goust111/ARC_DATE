+
+def _shape_to_patch(shape: tuple[tuple[int, int], ...], color: int) -> np.ndarray:
+    h, w = _shape_dims(shape)
+    patch = np.zeros((h, w), dtype=int)
+    for r, c in shape:
+        patch[int(r), int(c)] = int(color)
+    return patch
+
+
+def _is_connected(cells: set[tuple[int, int]]) -> bool:
