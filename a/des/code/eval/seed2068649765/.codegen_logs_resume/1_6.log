+    key_cells = np.argwhere(key_arr != BG) + key_origin
+    all_cells = np.vstack([lock_cells, key_cells])
+    min_r = int(all_cells[:, 0].min())
+    min_c = int(all_cells[:, 1].min())
+    max_r = int(all_cells[:, 0].max())
+    max_c = int(all_cells[:, 1].max())
