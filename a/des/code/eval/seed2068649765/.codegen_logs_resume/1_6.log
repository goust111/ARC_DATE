+    return rel, gap, (frame_r0, frame_c0, frame_r0 + frame_h - 1, frame_c0 + frame_w - 1)
+
+
+def _parse_lock(comp: dict) -> dict | None:
+    coords = comp["coords"]
+    r0, c0, r1, c1 = comp["bbox"]
+    rel = {(r - r0, c - c0) for r, c in coords}
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
