+        frame_r0, frame_c0 = 2, 0
+        outer_h, outer_w = frame_h + 2, frame_w
+    elif side == "bottom":
+        frame_r0, frame_c0 = 0, 0
+        outer_h, outer_w = frame_h + 2, frame_w
+    elif side == "left":
+        frame_r0, frame_c0 = 0, 2
+        outer_h, outer_w = frame_h, frame_w + 2
+    else:
