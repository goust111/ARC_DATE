+def _paste_nonzero(dst: np.ndarray, src: np.ndarray, top: int, left: int) -> None:
+    sh, sw = src.shape
+    region = dst[top : top + sh, left : left + sw]
+    mask = src != BG
+    region[mask] = src[mask]
