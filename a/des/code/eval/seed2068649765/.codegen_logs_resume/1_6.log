+                    "kind": "key",
+                    "color": int(comp["color"]),
+                    "coords": list(coords),
+                    "bbox": comp["bbox"],
+                    "direction": "E",
+                    "teeth": teeth,
+                    "tip": (r0 + handle_row, c1),
