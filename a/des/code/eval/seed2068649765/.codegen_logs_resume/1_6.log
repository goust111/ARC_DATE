+def _path_clear(grid: np.ndarray, bg: int, start: tuple[int, int], direction: str, dist: int) -> bool:
+    dr, dc = DIRS[direction]
+    r, c = start
+    for step in range(1, dist + 1):
+        rr = r + dr * step
+        cc = c + dc * step
