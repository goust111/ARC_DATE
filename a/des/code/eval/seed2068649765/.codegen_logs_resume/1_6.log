+        return False
+    pairs = _pair_objects(grid, bg, locks, keys)
+    if pairs is None or len(pairs) != expected_pairs:
+        return False
+    try:
+        out = main(grid)
+    except Exception:
+        return False
+    return out.shape == grid.shape and not np.array_equal(out, grid)
