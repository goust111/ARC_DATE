+
+    if side in ("top", "bottom"):
+        mid_c = frame_w // 2
+        gap = (frame_r0 + (0 if side == "top" else frame_h - 1), frame_c0 + mid_c)
+        rel.remove(gap)
+        groove_rows = [0, 1] if side == "top" else [frame_h, frame_h + 1]
+        for rr in groove_rows:
