+    cluster = np.zeros((max_r - min_r + 1, max_c - min_c + 1), dtype=int)
+    _paste_nonzero(cluster, lock_arr, int(shift[0]), int(shift[1]))
+    _paste_nonzero(cluster, key_arr, int(key_origin[0] + shift[0]), int(key_origin[1] + shift[1]))
+
+    meta = {
+        "side": side,
+        "direction": direction,
+        "teeth": teeth,
+        "divisible": divisible,
