+        fr0, fc0, fr1, fc1 = frame_bbox_rel
+        gap = (r0 + gap_rel[0], c0 + gap_rel[1])
+        frame_bbox = (r0 + fr0, c0 + fc0, r0 + fr1, c0 + fc1)
+        ir0, ic0, ir1, ic1 = frame_bbox[0] + 1, frame_bbox[1] + 1, frame_bbox[2] - 1, frame_bbox[3] - 1
+        return {
+            "kind": "lock",
+            "color": int(comp["color"]),
+            "coords": list(coords),
+            "bbox": comp["bbox"],
+            "side": side,
