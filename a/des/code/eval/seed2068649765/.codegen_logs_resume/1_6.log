+    out = g.copy()
+    for key, lock, dist in pairs:
+        for r, c in key["coords"]:
+            out[r, c] = bg
+        dr, dc = DIRS[key["direction"]]
+        for r, c in key["coords"]:
+            out[r + dr * dist, c + dc * dist] = int(key["color"])
