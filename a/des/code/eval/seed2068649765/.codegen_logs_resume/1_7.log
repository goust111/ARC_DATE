+    templates: dict[str, np.ndarray] = {}
+
+    for name, (r0, r1, c0, c1) in bounds.items():
+        patch = grid[r0:r1, c0:c1]
+        seed_mask = (patch != BG) & (patch != TEMPLATE)
+        template_mask = patch == TEMPLATE
