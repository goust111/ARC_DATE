+        assert last_valid is not None, "sprite must be placeable on paired segment"
+        vals = sprite["values"]
+        out[last_valid[:, 0], last_valid[:, 1]] = vals
+        stopped[last_valid[:, 0], last_valid[:, 1]] = True
