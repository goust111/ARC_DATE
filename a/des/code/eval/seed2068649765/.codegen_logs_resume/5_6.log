        for pairs in PAIR_COUNT_RANGE
        for unpaired in UNPAIRED_COUNT_RANGE
        if MARKER_TOTAL_RANGE[0] <= 2 * pairs + unpaired <= MARKER_TOTAL_RANGE[1]
        and pairs + unpaired <= line_count
