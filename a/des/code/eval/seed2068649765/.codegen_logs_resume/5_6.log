+def _parse_scene(g: np.ndarray) -> dict[str, object]:
+    bg = _bg_color(g)
+    h, w = g.shape
+
+    segments: list[dict[str, object]] = []
+    segment_cells: set[Coord] = set()
+    marker_cells: set[Coord] = set()
+
