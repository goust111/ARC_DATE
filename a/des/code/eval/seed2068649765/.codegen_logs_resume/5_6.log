+            return pair[1]
+        return pair[0]
+
+    order = sorted(
+        sprites,
+        key=lambda s: (
+            int(s["arrival"]),
+            int(s["bbox"][0]),
+            int(s["bbox"][1]),
+            int(s["id"]),
