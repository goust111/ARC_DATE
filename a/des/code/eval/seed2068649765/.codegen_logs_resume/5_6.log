+    for r, c in line["cells"]:
+        grid[r, c] = int(line["color"])
+    mr, mc = map(int, line["marker"])
+    grid[mr, mc] = GREY
+    cells.add((mr, mc))
+    return cells
+
+
+def _fits_cells(cells: set[Coord], h: int, w: int) -> bool:
