+    marker_cells: set[Coord] = set()
+
+    for color in [int(c) for c in np.unique(g) if int(c) != bg]:
+        for comp in _components(g == color, connectivity=4):
+            info = _segment_info(g, bg, color, comp)
+            if info is None:
+                continue
