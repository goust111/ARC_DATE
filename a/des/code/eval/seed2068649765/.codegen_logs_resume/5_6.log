+BG = 0
+GREY = 5
+LINE_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+GRID_H_RANGE = (18, 24)
+GRID_W_RANGE = (18, 24)
+PAIR_COUNT_RANGE = (2, 3)
+LINE_LEN_RANGE = (4, 8)
