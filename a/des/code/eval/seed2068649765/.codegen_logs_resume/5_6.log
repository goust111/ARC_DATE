+def _line_spec(
+    color: int,
+    orientation: str,
+    anchor_r: int,
+    anchor_c: int,
+    length: int,
+    marked_side: str,
+) -> dict[str, object]:
+    cells, marker, unmarked, marked = _segment_cells(orientation, anchor_r, anchor_c, length, marked_side)
+    direction = (marked[0] - unmarked[0], marked[1] - unmarked[1])
+    return {
+        "color": color,
+        "orientation": orientation,
+        "length": length,
+        "cells": cells,
+        "marker": marker,
+        "unmarked": unmarked,
+        "marked": marked,
+        "dir": direction,
+    }
+
