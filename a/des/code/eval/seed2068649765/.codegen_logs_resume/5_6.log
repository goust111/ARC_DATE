                by_area.setdefault(int(mask.sum()), []).append((mask, r0, c0))
    return by_area


def _sample_mover_masks(n: int, widths: list[int], marker_count: int, max_fg: int) -> list[np.ndarray] | None:
    reserved_for_markers = MARKER_MAX_AREA * int(marker_count)
