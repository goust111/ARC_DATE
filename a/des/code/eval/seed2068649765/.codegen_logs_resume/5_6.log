+    for sprite in order:
+        target = target_segment(int(sprite["source_index"]), int(sprite["source_color"]))
+        move = (-int(target["dir"][0]), -int(target["dir"][1]))
+        contact0 = tuple(map(int, sprite["contact"]))
+        offset = tuple(map(int, sprite["offset"]))
