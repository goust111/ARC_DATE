+def _solve(g: np.ndarray, return_meta: bool = False):
+    scene = _parse_scene(g)
+    bg = int(scene["bg"])
+    segments = scene["segments"]
+    by_color = scene["by_color"]
+    sprites = scene["sprites"]
+
+    out = g.copy()
+    for sprite in sprites:
+        coords = sprite["coords"]
+        out[coords[:, 0], coords[:, 1]] = bg
