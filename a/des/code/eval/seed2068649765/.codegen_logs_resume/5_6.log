from __future__ import annotations

import random
from collections import Counter, defaultdict

import numpy as np


Coord = tuple[int, int]


def _neighbors(r: int, c: int, connectivity: int) -> list[Coord]:
    if connectivity == 4:
        return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
    return [
        (r + dr, c + dc)
        for dr in (-1, 0, 1)
        for dc in (-1, 0, 1)
        if (dr, dc) != (0, 0)
    ]


def _components(mask: np.ndarray, connectivity: int) -> list[np.ndarray]:
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    comps: list[np.ndarray] = []
    for r in range(h):
        for c in range(w):
            if not bool(mask[r, c]) or bool(seen[r, c]):
                continue
            stack = [(r, c)]
            seen[r, c] = True
            cells: list[Coord] = []
            while stack:
                cr, cc = stack.pop()
                cells.append((cr, cc))
                for nr, nc in _neighbors(cr, cc, connectivity):
                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            comps.append(np.array(cells, dtype=int))
    return comps


def _bg_color(g: np.ndarray) -> int:
    values, counts = np.unique(g, return_counts=True)
    return int(values[np.argmax(counts)])


def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    return int(r0), int(c0), int(r1), int(c1)


def _coord_set(coords: np.ndarray) -> set[Coord]:
    return {tuple(map(int, rc)) for rc in coords}


def _segment_info(g: np.ndarray, bg: int, color: int, coords: np.ndarray) -> dict[str, object] | None:
    r0, c0, r1, c1 = _bbox(coords)
    size = int(coords.shape[0])
    if size < 4:
        return None
    orientation: str
    step: Coord
    end0: Coord
    end1: Coord
    if r0 == r1 and size == c1 - c0 + 1:
        orientation = "h"
        step = (0, 1)
        end0 = (r0, c0)
        end1 = (r0, c1)
    elif c0 == c1 and size == r1 - r0 + 1:
        orientation = "v"
        step = (1, 0)
        end0 = (r0, c0)
        end1 = (r1, c0)
    else:
        return None

    ext0 = (end0[0] - step[0], end0[1] - step[1])
    ext1 = (end1[0] + step[0], end1[1] + step[1])
    h, w = g.shape

    ext_cells: list[tuple[Coord, Coord]] = []
