+def _source_offset_and_contact(size: int, orientation: str, preferred: Coord | None = None) -> tuple[Coord, Coord]:
+    if orientation == "h":
+        choices = [((-1, 0), (size - 1, c)) for c in range(size)] + [((1, 0), (0, c)) for c in range(size)]
+    else:
