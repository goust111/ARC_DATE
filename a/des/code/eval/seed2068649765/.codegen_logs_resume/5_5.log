+            rr == 0 or cc == 0 or rr == sub.shape[0] - 1 or cc == sub.shape[1] - 1
+            for rr, cc in comp
+        ):
+            continue
+        hr0, hc0, hr1, hc1 = _bbox(comp)
+        mask = np.zeros((hr1 - hr0 + 1, hc1 - hc0 + 1), dtype=bool)
+        for rr, cc in comp:
