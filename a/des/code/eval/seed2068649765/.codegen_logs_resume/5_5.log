+    rs = [rr for rr, _ in region_cells]
+    cs = [cc for _, cc in region_cells]
+    r0, c0, r1, c1 = min(rs), min(cs), max(rs), max(cs)
+    if r < r0:
+        return "top", BG
+    if r > r1:
+        return "bottom", BG
+    if c < c0:
+        return "left", BG
+    if c > c1:
+        return "right", BG
+    if r == r0:
+        return "top", int(region_color)
+    if r == r1:
+        return "bottom", int(region_color)
+    if c == c0:
