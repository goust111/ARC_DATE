+
+SHAPE_LIBRARY = _shape_library()
+
+
+def _holes_for_component(grid: np.ndarray, coords: list[tuple[int, int]]) -> list[dict]:
+    r0, c0, r1, c1 = _bbox(coords)
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    holes: list[dict] = []
+    for comp in _components(sub == BG):
