+import random
+from collections import deque
+
+import numpy as np
+
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+ARROW_PATTERNS = {
+    "up": np.array(
+        [
+            [0, 1, 0],
+            [0, 1, 0],
+            [1, 1, 1],
+        ],
+        dtype=bool,
+    ),
+    "down": np.array(
+        [
+            [1, 1, 1],
+            [0, 1, 0],
+            [0, 1, 0],
+        ],
+        dtype=bool,
+    ),
+    "left": np.array(
+        [
+            [0, 0, 1],
+            [1, 1, 1],
+            [0, 0, 1],
+        ],
+        dtype=bool,
+    ),
+    "right": np.array(
+        [
+            [1, 0, 0],
+            [1, 1, 1],
+            [1, 0, 0],
+        ],
+        dtype=bool,
+    ),
+}
+
+FIRST_DIR_BY_SIDE = {
+    "left": "right",
+    "right": "left",
+    "top": "down",
+    "bottom": "up",
+}
+
+ORTHOGONALS = {
+    "up": ("left", "right"),
+    "down": ("left", "right"),
+    "left": ("up", "down"),
+    "right": ("up", "down"),
+}
+
+GRID_H_RANGE = (18, 29)
+GRID_W_RANGE = (18, 29)
+NUM_OBJECTS_RANGE = (2, 4)
+ARROW_COUNT_VALUES = (1, 2, 3, 4)
+ARROW_COUNT_WEIGHTS = (2, 4, 3, 1)
+GEN_ATTEMPTS = 400
+SPEC_ATTEMPTS = 120
