+        r0, c0, r1, c1 = spec["cargo_bbox"]
+        grid[r0 : r1 + 1, c0 : c1 + 1] = color
+        for arrow in spec["arrows"]:
+            for r, c in _arrow_cells(arrow["center"], arrow["dir"]):
