+def _unique_best(items, key_fn):
+    keyed = sorted((key_fn(item), idx, item) for idx, item in enumerate(items))
+    assert keyed, "no candidates available"
+    if len(keyed) >= 2:
+        assert keyed[0][0] != keyed[1][0], "ambiguous minimum candidate"
