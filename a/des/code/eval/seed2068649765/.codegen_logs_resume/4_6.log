+
+def _bbox_clear(occupied: np.ndarray, top: int, left: int, h: int, w: int, pad: int) -> bool:
+    hh, ww = occupied.shape
+    r0 = max(0, top - pad)
+    r1 = min(hh, top + h + pad)
+    c0 = max(0, left - pad)
+    c1 = min(ww, left + w + pad)
+    return not occupied[r0:r1, c0:c1].any()
