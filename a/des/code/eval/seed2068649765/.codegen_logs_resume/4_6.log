+        if not np.all(comp_mask[r0 : r1 + 1, c1 + 1]):
+            return []
+        if not np.all(grid[r1 + 1, c0 : c1 + 1] == wall_color):
+            return []
+        if np.any(grid[r0 - 1, c0 : c1 + 1] != BG):
+            return []
+        opening = c1 - c0 + 1
+    elif side == "bottom":
