+        return False
+
+    r0, c0, r1, c1 = cavity_bbox
+    world_r0 = top + r0
+    world_c0 = left + c0
+    world_r1 = top + r1
+    world_c1 = left + c1
+    cargo_room = 5
+    if side == "top":
+        return world_r0 >= cargo_room
+    if side == "bottom":
+        return gh - world_r1 - 1 >= cargo_room
+    if side == "left":
+        return world_c0 >= cargo_room
+    return gw - world_c1 - 1 >= cargo_room
