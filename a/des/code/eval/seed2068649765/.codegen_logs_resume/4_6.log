+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _classify_components(grid: np.ndarray) -> tuple[list[dict], list[list[tuple[int, int]]]]:
+    cargos: list[dict] = []
+    containers: list[list[tuple[int, int]]] = []
+    for comp in _components(grid != BG):
+        r0, c0, r1, c1 = _bbox(comp)
+        vals = [int(grid[r, c]) for r, c in comp]
+        unique = set(vals)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if len(unique) == 1 and h == w and 1 <= h <= 3 and len(comp) == h * w:
+            cargos.append(
+                {
+                    "bbox": (r0, c0, r1, c1),
+                    "color": int(vals[0]),
+                    "size": int(h),
+                }
+            )
+        else:
+            containers.append(comp)
+    return cargos, containers
+
+
+def _extract_marker_sequence(
+    grid: np.ndarray,
+    rect: tuple[int, int, int, int],
+    side: str,
+    wall_color: int,
+) -> list[int]:
+    r0, c0, r1, c1 = rect
+    seq: list[int] = []
+    seen: set[int] = set()
+
+    if side == "top":
+        axis = [(r, (c0 - 1, c1 + 1)) for r in range(r0, r1 + 1)]
+    elif side == "bottom":
+        axis = [(r, (c0 - 1, c1 + 1)) for r in range(r1, r0 - 1, -1)]
+    elif side == "left":
+        axis = [((r0 - 1, r1 + 1), c) for c in range(c0, c1 + 1)]
+    else:
+        axis = [((r0 - 1, r1 + 1), c) for c in range(c1, c0 - 1, -1)]
+
+    for entry in axis:
+        colors: set[int] = set()
+        if side in ("top", "bottom"):
+            row, side_cols = entry
+            for col in side_cols:
+                color = int(grid[row, col])
+                if color not in (BG, wall_color):
+                    colors.add(color)
+        else:
+            side_rows, col = entry
+            for row in side_rows:
+                color = int(grid[row, col])
+                if color not in (BG, wall_color):
+                    colors.add(color)
+        if len(colors) > 1:
+            return []
+        if colors:
+            color = next(iter(colors))
+            if color in seen:
+                return []
+            seq.append(color)
+            seen.add(color)
+
+    return seq if 1 <= len(seq) <= 3 else []
