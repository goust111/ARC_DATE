+def _container_spec(marker_count: int, marker_colors: list[int], rng: random.Random) -> dict:
+    opening = rng.randint(2, 4)
+    while True:
+        sizes = []
+        for _ in range(marker_count):
+            if opening == 2 and rng.random() < 0.4:
+                sizes.append(3)
+            else:
+                sizes.append(rng.randint(1, 3))
