+def _intervals(separators: list[int], length: int) -> list[tuple[int, int]]:
+    bounds = [-1, *separators, int(length)]
+    spans = []
+    for i in range(len(bounds) - 1):
+        start = bounds[i] + 1
+        end = bounds[i + 1]
+        if end > start:
+            spans.append((int(start), int(end)))
+    return spans
