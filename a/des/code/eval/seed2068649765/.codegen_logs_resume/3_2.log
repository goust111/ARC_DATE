+
+def _shape_rotations(shape: tuple[tuple[int, int], ...]) -> list[tuple[tuple[int, int], ...]]:
+    mask = _shape_to_mask(shape)
+    rots: list[tuple[tuple[int, int], ...]] = []
+    cur = mask
+    for _ in range(4):
+        rots.append(_normalize_coords(np.argwhere(cur)))
+        cur = np.rot90(cur)
+    return rots
