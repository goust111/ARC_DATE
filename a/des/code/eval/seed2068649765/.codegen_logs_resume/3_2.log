+    if not np.array_equal(main(grid), expected):
+        return None
+    if len(np.unique(grid)) < 4:
+        return None
+    if _background_color(grid) != bg:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GEN_RETRIES):
