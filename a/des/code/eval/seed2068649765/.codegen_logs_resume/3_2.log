+def _shape_to_mask(shape: tuple[tuple[int, int], ...]) -> np.ndarray:
+    arr = np.asarray(shape, dtype=int)
+    mask = np.zeros((int(arr[:, 0].max()) + 1, int(arr[:, 1].max()) + 1), dtype=bool)
+    mask[arr[:, 0], arr[:, 1]] = True
+    return mask
