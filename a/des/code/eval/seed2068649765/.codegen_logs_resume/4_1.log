+        "side": side,
+        "cells": cluster_cells,
+        "frame_cells": frame,
+        "pieces": pieces,
+        "min_r": int(min_r),
+        "min_c": int(min_c),
+        "max_r": int(max_r),
+        "max_c": int(max_c),
+    }
