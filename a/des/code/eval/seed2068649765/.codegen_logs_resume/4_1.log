+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in coords:
+        rr = int(r - r0)
+        cc = int(c - c0)
+        if rr not in (0, h - 1) and cc not in (0, w - 1):
+            return None
+        mask[rr, cc] = True
+
+    if mask[1:-1, 1:-1].any():
+        return None
+    if not (mask[0, 0] and mask[0, -1] and mask[-1, 0] and mask[-1, -1]):
+        return None
+
+    side_arrays = {
+        "top": mask[0, :],
+        "bottom": mask[-1, :],
+        "left": mask[:, 0],
+        "right": mask[:, -1],
