+            return None
+        return int(fr0 - r1)
+    if side == "bottom":
+        if r0 <= fr1 or c0 < frame["gap_start"] or c1 > frame["gap_end"]:
+            return None
+        return int(r0 - fr1)
+    if side == "left":
+        if c1 >= fc0 or r0 < frame["gap_start"] or r1 > frame["gap_end"]:
+            return None
+        return int(fc0 - c1)
+    if c0 <= fc1 or r0 < frame["gap_start"] or r1 > frame["gap_end"]:
