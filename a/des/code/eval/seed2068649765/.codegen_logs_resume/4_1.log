+import numpy as np
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    vals = np.bincount(grid.ravel(), minlength=10)
+    return int(np.argmax(vals))
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return r0, c0, r1, c1
+
+
+def _components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            arr = np.array(pts, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": _bbox(arr),
+                    "area": int(len(pts)),
+                }
+            )
+    return comps
+
+
+def _shape_from_coords(coords: np.ndarray) -> dict:
+    r0, c0, r1, c1 = _bbox(coords)
+    rel = [(int(r - r0), int(c - c0)) for r, c in coords]
+    rel.sort()
+    rel_arr = np.array(rel, dtype=int)
+    return {
+        "rel": rel,
+        "h": int(r1 - r0 + 1),
+        "w": int(c1 - c0 + 1),
+        "max_r": int(rel_arr[:, 0].max()),
+        "max_c": int(rel_arr[:, 1].max()),
+        "center_r": float(rel_arr[:, 0].mean()),
+        "center_c": float(rel_arr[:, 1].mean()),
+    }
+
+
+def _gap_run(inner: np.ndarray) -> tuple[int, int] | None:
+    runs: list[tuple[int, int]] = []
+    start = None
+    for i, flag in enumerate(inner):
+        if not bool(flag):
