+    gap_side = None
+    gap_bounds = None
+    for side, arr in side_arrays.items():
+        inner = arr[1:-1]
+        run = _gap_run(inner)
+        if run is None:
+            if not bool(inner.all()):
+                return None
+            continue
+        if gap_side is not None:
