+    "2x3": [(0, 0), (0, 1), (0, 2), (1, 2), (1, 1), (1, 0)],
+    "3x3": [(0, 0), (0, 1), (0, 2), (1, 2), (2, 2), (2, 1), (2, 0), (1, 0)],
