        for anchor in anchors + [center]:
            for r, c in _random_path(anchor, center):
                mask[r, c] = True

        target = random.randint(min_fill, max_fill)
        frontier = {
            nb
            for r, c in zip(*np.where(mask), strict=False)
            for nb in _neighbors4(int(r), int(c), side)
