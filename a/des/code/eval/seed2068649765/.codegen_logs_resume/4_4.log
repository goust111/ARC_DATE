    random.shuffle(axes)
    for axis in axes:
        if axis == 0:
            step = 1 if tr >= r else -1
            while r != tr:
                r += step
                cells.append((r, c))
        else:
            step = 1 if tc >= c else -1
            while c != tc:
                c += step
                cells.append((r, c))
