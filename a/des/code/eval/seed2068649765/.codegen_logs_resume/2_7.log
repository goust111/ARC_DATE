+                    "color": int(color),
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "r0": int(r0),
+                    "c0": int(c0),
+                    "r1": int(r1),
+                    "c1": int(c1),
+                    "h": int(hh),
