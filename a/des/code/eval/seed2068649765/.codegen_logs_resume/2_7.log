+def _render_input(root: Node, rng: np.random.Generator) -> np.ndarray:
+    top = int(rng.integers(1, 5))
+    left = int(rng.integers(1, 5))
+    bottom = int(rng.integers(1, 5))
+    right = int(rng.integers(1, 5))
