def _gen_anchor(corner: str, n: int, h: int, w: int) -> tuple[int, int]:
    if corner == "TL":
        return 0, 0
    if corner == "TR":
        return 0, n - w
    if corner == "BR":
        return n - h, n - w
    if corner == "BL":
