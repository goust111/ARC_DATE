+        for r in range(g.shape[0]):
+            if active[r, c - 1] and active[r, c + 1]:
+                fills.append((int(r), int(c), int(out[r, c - 1])))
+
+    for r, c, color in fills:
+        out[r, c] = color
+
+    for r, c in anchor_coords:
+        out[r, c] = bg
+
