+    bands = sorted(_extract_bands(grid, bg), key=lambda band: band["col0"])
+    anchor_cols = sorted(int(c) for _r, c in np.argwhere(grid == YELLOW))
+    if len(anchor_cols) != len(bands) - 1:
+        return False
