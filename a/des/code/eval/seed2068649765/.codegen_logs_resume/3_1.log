+def _flood(seed_cells: list[tuple[int, int]], passable: np.ndarray) -> np.ndarray:
+    h, w = passable.shape
+    reached = np.zeros((h, w), dtype=bool)
+    q = deque()
+    for r, c in seed_cells:
+        if not passable[r, c] or reached[r, c]:
+            continue
+        reached[r, c] = True
+        q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIR4:
