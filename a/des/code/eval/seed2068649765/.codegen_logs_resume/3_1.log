@@ -0,0 +1,508 @@
+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+SEED_COLOR = 4
+MIRROR_COLOR = 5
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+BG_CHOICES = [0, 1, 2, 3, 6, 7, 8, 9]
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, cnts = np.unique(grid, return_counts=True)
+    return int(vals[int(np.argmax(cnts))])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _flood(seed_cells: list[tuple[int, int]], passable: np.ndarray) -> np.ndarray:
+    h, w = passable.shape
+    reached = np.zeros((h, w), dtype=bool)
+    q = deque()
+    for r, c in seed_cells:
+        if not passable[r, c] or reached[r, c]:
+            continue
+        reached[r, c] = True
+        q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and passable[nr, nc] and not reached[nr, nc]:
+                reached[nr, nc] = True
+                q.append((nr, nc))
+    return reached
+
+
+def _trace_path(
+    grid: np.ndarray,
+    seed_mask: np.ndarray,
+    trav_mask: np.ndarray,
+    start: tuple[int, int],
+) -> list[tuple[int, int]]:
+    path: list[tuple[int, int]] = []
+    visited: set[tuple[int, int]] = set()
+    prev: tuple[int, int] | None = None
+    cur = start
+    h, w = grid.shape
+
+    while True:
+        if cur in visited:
+            break
+        visited.add(cur)
+        path.append(cur)
+
+        nxts: list[tuple[int, int]] = []
+        for dr, dc in DIR4:
+            nr, nc = cur[0] + dr, cur[1] + dc
+            if 0 <= nr < h and 0 <= nc < w and trav_mask[nr, nc] and (nr, nc) != prev:
+                nxts.append((nr, nc))
+        if not nxts:
+            break
+
+        if len(nxts) == 1:
+            nxt = nxts[0]
+        else:
+            if prev is None:
+                away = [p for p in nxts if not any(seed_mask[p[0] + dr, p[1] + dc]
+                                                  for dr, dc in DIR4
+                                                  if 0 <= p[0] + dr < h and 0 <= p[1] + dc < w)]
+                nxt = away[0] if away else nxts[0]
+            else:
+                dr0 = cur[0] - prev[0]
+                dc0 = cur[1] - prev[1]
+                straight = [p for p in nxts if (p[0] - cur[0], p[1] - cur[1]) == (dr0, dc0)]
+                unused = [p for p in nxts if p not in visited]
+                if straight:
+                    nxt = straight[0]
+                elif unused:
+                    nxt = unused[0]
+                else:
+                    nxt = nxts[0]
+        if nxt in visited:
+            break
+        prev, cur = cur, nxt
+
+    return path
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill the activated corridor cells by tracing the seeded path inside each walled cavity.
+
+    Yellow marks the seed region only. The actual fill color is inferred from the
+    surrounding wall color of that cavity. Grey mirror cells are preserved.
+    """
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    bg = _get_bg(g)
+    out = g.copy()
+
+    seed_comps = _components(g == SEED_COLOR)
+    passable = (g == bg) | (g == SEED_COLOR) | (g == MIRROR_COLOR)
+
+    for comp in seed_comps:
+        seed_mask = np.zeros((h, w), dtype=bool)
+        for r, c in comp:
+            seed_mask[r, c] = True
+
+        cavity = _flood(comp, passable)
+
+        wall_colors = Counter()
+        for r, c in np.argwhere(cavity):
+            rr = int(r)
+            cc = int(c)
+            for dr, dc in DIR4:
+                nr, nc = rr + dr, cc + dc
+                if 0 <= nr < h and 0 <= nc < w and not cavity[nr, nc]:
+                    v = int(g[nr, nc])
+                    if v not in (bg, SEED_COLOR, MIRROR_COLOR):
+                        wall_colors[v] += 1
+        if not wall_colors:
+            continue
+        wall_color = int(wall_colors.most_common(1)[0][0])
+
+        trav_mask = cavity & ((g == bg) | (g == MIRROR_COLOR))
+        start_candidates: list[tuple[int, int, int, int]] = []
+        for r, c in np.argwhere(trav_mask):
+            rr = int(r)
+            cc = int(c)
+            seed_adj = 0
+            deg = 0
+            for dr, dc in DIR4:
+                nr, nc = rr + dr, cc + dc
+                if not (0 <= nr < h and 0 <= nc < w):
+                    continue
+                if seed_mask[nr, nc]:
+                    seed_adj += 1
+                if trav_mask[nr, nc]:
+                    deg += 1
+            if seed_adj:
