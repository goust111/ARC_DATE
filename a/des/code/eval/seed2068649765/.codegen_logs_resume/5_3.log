+        return {
+            "shape": (h, w),
+            "room_rows": room_rows,
+            "room_cols": room_cols,
+            "row_bounds": row_bounds,
+            "col_bounds": col_bounds,
+            "wall_rows": [0] + [r1 + 1 for _r0, r1 in row_bounds],
+            "wall_cols": [0] + [c1 + 1 for _c0, c1 in col_bounds],
