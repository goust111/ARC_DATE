+                rid = room_by_rc[(rr, cc)]
+                if cc + 1 < room_cols:
+                    nid = room_by_rc[(rr, cc + 1)]
+                    adj[rid].append(nid)
+                    adj[nid].append(rid)
+                    adj_pairs.append((rid, nid))
+                if rr + 1 < room_rows:
+                    nid = room_by_rc[(rr + 1, cc)]
+                    adj[rid].append(nid)
+                    adj[nid].append(rid)
+                    adj_pairs.append((rid, nid))
