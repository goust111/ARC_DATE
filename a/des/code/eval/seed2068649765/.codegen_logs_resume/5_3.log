+        sides.append("top")
+    if room["row"] == layout["room_rows"] - 1:
+        sides.append("bottom")
+    if room["col"] == 0:
+        sides.append("left")
+    if room["col"] == layout["room_cols"] - 1:
+        sides.append("right")
