+            cur += height + 1
+
+        cur = 1
+        for width in widths:
+            col_bounds.append((cur, cur + width - 1))
+            cur += width + 1
+
+        rooms = []
+        room_by_rc: dict[tuple[int, int], int] = {}
+        for rr, (r0, r1) in enumerate(row_bounds):
+            for cc, (c0, c1) in enumerate(col_bounds):
