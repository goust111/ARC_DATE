+def _random_simple_path(
+    adj: dict[int, list[int]],
+    start: int,
+    length: int,
+    rng: random.Random,
+) -> list[int] | None:
+    path = [start]
+    used = {start}
+
+    def dfs(cur: int) -> bool:
+        if len(path) == length:
+            return True
+        nbrs = [nbr for nbr in adj[cur] if nbr not in used]
+        rng.shuffle(nbrs)
+        for nbr in nbrs:
+            used.add(nbr)
+            path.append(nbr)
+            if dfs(nbr):
+                return True
+            path.pop()
+            used.remove(nbr)
+        return False
+
+    return path if dfs(start) else None
