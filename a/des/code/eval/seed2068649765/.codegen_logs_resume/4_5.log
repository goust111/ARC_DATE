+    start_rows = sorted(random.sample(odd_rows, n_paths))
+    remaining_rows = [r for r in odd_rows if r not in start_rows]
+    end_rows = random.sample(remaining_rows, n_paths)
+    sides = _sample_marker_sides(start_rows)
