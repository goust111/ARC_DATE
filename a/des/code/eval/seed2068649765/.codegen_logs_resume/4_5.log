+def _build_adjacency(mask: np.ndarray) -> dict[Coord, list[Coord]]:
+    h, w = mask.shape
+    adj: dict[Coord, list[Coord]] = {}
+    for r, c in map(tuple, np.argwhere(mask)):
+        cell = (int(r), int(c))
+        adj[cell] = [nb for nb in _neighbors4(cell[0], cell[1], h, w) if bool(mask[nb])]
+    return adj
