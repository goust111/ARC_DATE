+    for direction, color in direction_colors.items():
+        local[arm_masks[direction]] = int(color)
+    for direction in CENTER_PRIORITY:
+        if direction in direction_colors:
+            local[arm_masks["center"]] = int(direction_colors[direction])
+            break
+    return out
+
