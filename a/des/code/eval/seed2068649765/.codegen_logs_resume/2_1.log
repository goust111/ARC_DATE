+def _adjacent_colors(grid: np.ndarray, coords: list[tuple[int, int]], bg: int) -> set[int]:
+    height, width = grid.shape
+    colors: set[int] = set()
+    for r, c in coords:
+        for dr, dc in DIRS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < height and 0 <= nc < width:
+                color = int(grid[nr, nc])
+                if color != bg:
+                    colors.add(color)
+    return colors
