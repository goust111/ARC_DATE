+    frame_mask = g[fr0 : fr1 + 1, fc0 : fc1 + 1] == frame_color
+    h_span, v_span = _bar_spans(frame_mask)
+    local_arm_masks = _arm_masks_from_bbox(frame_mask, h_span, v_span)
