+def _base_mask() -> np.ndarray:
+    h = random.randint(2, 4)
+    w = random.randint(3, 4)
+    hole_c = random.randint(1, w - 2)
+    mask = np.ones((h, w), dtype=bool)
+    mask[0, hole_c] = False
+    return mask
