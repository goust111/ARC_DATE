+
+def _candidate_holes_for_bend(
+    shape: tuple[int, int],
+    bend: tuple[int, int],
+    mask: np.ndarray,
+    direction: tuple[int, int],
+) -> list[tuple[int, int]]:
+    h, w = shape
+    ph, pw = mask.shape
+    hole_r, hole_c = _hole_local(mask)
+
+    if direction in HORIZONTAL:
+        row = bend[0]
+        top = row - hole_r
+        if top < 0 or top + ph > h:
+            return []
+
+        min_col = hole_c
+        max_col = w - pw + hole_c
+        if direction == RIGHT:
+            stop = min(max_col, bend[1] - MIN_LEG)
