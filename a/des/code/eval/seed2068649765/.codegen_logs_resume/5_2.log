+            if len(comps) != 1:
+                return False
+            continue
+        if len(comps) != 2:
+            return False
+        try:
+            _parse_sprite(inp, color, comps[0])
+            _parse_sprite(inp, color, comps[1])
+        except AssertionError:
+            return False
+    if demo_colors != 1:
+        return False
+
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return False
+    return np.array_equal(actual, expected)
