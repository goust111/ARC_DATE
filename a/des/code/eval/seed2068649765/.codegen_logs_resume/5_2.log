+        horiz_dir = random.choice([LEFT, RIGHT])
+        vert_dir = random.choice([UP, DOWN])
+        horiz_mask = _rotated_mask(base, horiz_dir)
+        vert_mask = _rotated_mask(base, vert_dir)
+
+        bend = (random.randrange(h), random.randrange(w))
+        if bend in blocked:
