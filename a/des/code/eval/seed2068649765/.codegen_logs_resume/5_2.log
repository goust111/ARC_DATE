+def _try_place_pair(
+    shape: tuple[int, int],
+    color: int,
+    demo: bool,
+    blocked: set[tuple[int, int]],
+) -> dict[str, object] | None:
+    h, w = shape
+    for _ in range(PAIR_PLACE_RETRIES):
