+    out_h = max(patch.shape[0] for patch in scaled)
+    out_w = sum(patch.shape[1] for patch in scaled) + len(scaled) - 1
+    out = np.full((out_h, out_w), BG, dtype=int)
+    col = 0
+    for i, patch in enumerate(scaled):
