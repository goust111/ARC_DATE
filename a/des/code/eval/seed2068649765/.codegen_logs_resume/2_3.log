+            pad_right = 1 + (arrows["right"]["shaft_len"] + arrows["right"]["gap"] + 1 if "right" in arrows else 0)
+            pad_top = 1 + (arrows["above"]["shaft_len"] + arrows["above"]["gap"] + 1 if "above" in arrows else 0)
