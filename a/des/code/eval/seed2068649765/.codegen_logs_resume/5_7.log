+    if axis == "v" and short_side == "left":
+        simple = work[:, hinge + 1 :]
+    if axis == "v" and short_side == "right":
+        simple = work[:, :hinge]
+    if simple is None or np.array_equal(out, simple):
+        return None
+
+    return grid
