+# --------------- generator ---------------
+
+HEIGHT_RANGE = (14, 22)
+WIDTH_RANGE = (14, 22)
+PRIORITY_COLOR_COUNT = (4, 5)  # includes maroon
+FILL_TARGET = (0.18, 0.32)
+SHAPE_ATTEMPTS = 120
