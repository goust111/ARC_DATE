def _detect_legend(grid: np.ndarray) -> tuple[tuple[int, int, int, int], list[int]]:
    candidates: list[tuple[int, tuple[int, int, int, int], list[int]]] = []
    for corner in ("tl", "tr", "bl", "br"):
        bbox = _corner_scan_bbox(grid, corner)
