+            return height, random.randint(max(12, leg_w + 4), WIDTH_RANGE[1]), top_len, short_side
+        return None
+
+    min_left = 5
+    min_right = 5
+    if corner in {"tl", "bl"}:
+        min_left = max(min_left, leg_w + 2)
+    else:
