+            rows.sort()
+            candidates.append((rows[1] - rows[0], "v", c))
+
+    assert candidates, "failed to locate the hinge line"
+    candidates.sort(reverse=True)
+    best = candidates[0]
+    if len(candidates) > 1:
+        assert best[0] > candidates[1][0], "hinge line is ambiguous"
+    return best[1], best[2]
