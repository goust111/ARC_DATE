+    if not _place_conflict(grid, allowed, axis, short_side, hinge, sorted_paint[0], sorted_paint[-1]):
+        return None
+    if not _place_conflict(grid, allowed, axis, short_side, hinge, sorted_paint[-1], sorted_paint[1]):
