    return out


def _fold_vertical(grid: np.ndarray, fold_c: int, priority_rank: dict[int, int]) -> np.ndarray:
    left = grid[:, :fold_c]
    right = grid[:, fold_c + 1 :]
    if left.shape[1] <= right.shape[1]:
