+                out[r, c] = b
+            elif b == BG or a == b:
+                out[r, c] = a
+            else:
+                ra = priority_rank.get(a, default_rank)
+                rb = priority_rank.get(b, default_rank)
+                out[r, c] = a if ra <= rb else b
+    return out
