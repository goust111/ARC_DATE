+def _merge_arrays(base: np.ndarray, overlay: np.ndarray, priority_rank: dict[int, int]) -> np.ndarray:
+    out = np.array(base, copy=True)
+    default_rank = len(priority_rank) + 10
+    rows, cols = out.shape
+    for r in range(rows):
+        for c in range(cols):
+            a = int(base[r, c])
