+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _most_common_color(arr: np.ndarray) -> int:
+    vals = np.asarray(arr, dtype=int).ravel()
+    return int(np.bincount(vals, minlength=10).argmax())
+
+
+def _frame_component(grid: np.ndarray, coords: list[tuple[int, int]]) -> tuple[int, tuple[int, int, int, int]] | None:
+    colors = {int(grid[r, c]) for r, c in coords}
+    if len(colors) != 1:
+        return None
+
+    r0, c0, r1, c1 = _bbox(coords)
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    if height < 3 or width < 3:
+        return None
+
+    mask = np.zeros((height, width), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
+
+    border = np.zeros_like(mask)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    if not np.array_equal(mask, border):
+        return None
+
+    return next(iter(colors)), (r0, c0, r1, c1)
+
