+BG = 0
+ALL_COLORS = tuple(range(1, 10))
+GEN_RETRIES = 400
+LAYER_RANGE = (1, 5)
+INNER_HEIGHT_RANGE = (1, 8)
+INNER_WIDTH_RANGE = (1, 8)
+OUTER_MARGIN_RANGE = (3, 7)
