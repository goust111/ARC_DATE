+def _random_shape() -> tuple[np.ndarray, tuple[int, int]]:
+    for _ in range(200):
+        h = random.randint(3, 5)
+        w = random.randint(3, 5)
+        target = random.randint(max(4, (h + w) // 2), h * w - 1)
