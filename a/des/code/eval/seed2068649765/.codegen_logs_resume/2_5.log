+    positions: list[tuple[int, int] | None] = [None] * len(sprite_patches)
+    col = start_col
+    for gap_idx, sprite_idx in enumerate(order):
+        patch = sprite_patches[sprite_idx]
+        ph, pw = map(int, patch.shape)
