+    r0, c0, r1, c1 = frame_bbox
+    mr, mc = marker_pos
+    ar, ac = anchor
+    for sr, sc in np.argwhere(sprite_mask):
+        tr = int(mr + sr - ar)
+        tc = int(mc + sc - ac)
+        if r0 + 1 <= tr <= r1 - 1 and c0 + 1 <= tc <= c1 - 1:
+            out[tr, tc] = int(color)
