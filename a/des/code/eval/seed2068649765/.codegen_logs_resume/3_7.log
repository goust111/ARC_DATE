+        nr0, nc0, nr1, nc1 = _bbox(notch_coords)
+        notch_mask = np.zeros((nr1 - nr0 + 1, nc1 - nc0 + 1), dtype=bool)
+        notch_mask[notch_coords[:, 0] - nr0, notch_coords[:, 1] - nc0] = True
