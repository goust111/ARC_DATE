+def _extract_keys(grid: np.ndarray) -> list[dict]:
+    keys = []
+    for coords in _components(grid == KEY_COLOR):
+        r0, c0, r1, c1 = _bbox(coords)
+        mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+        keys.append(
