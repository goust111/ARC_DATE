+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _mask_key(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    return tuple(int(x) for x in mask.shape), mask.tobytes()
+
