+        notch_components = []
+        for comp in _components(sub_bg):
+            if np.any(comp[:, 0] == 0) or np.any(comp[:, 1] == 0) or np.any(comp[:, 0] == sub.shape[0] - 1) or np.any(comp[:, 1] == sub.shape[1] - 1):
+                notch_components.append(comp)
+        if len(notch_components) != 1:
+            continue
