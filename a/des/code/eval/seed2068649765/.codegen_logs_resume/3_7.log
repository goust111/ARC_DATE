+        if ring_count not in RECOLOR_BY_RINGS:
+            continue
+        locks.append(
+            {
+                "body_bbox": (r0, c0, r1, c1),
+                "notch_bbox": (r0 + nr0, c0 + nc0, r0 + nr1, c0 + nc1),
+                "notch_mask": notch_mask,
+                "ring_count": ring_count,
+            }
+        )
+    return locks
