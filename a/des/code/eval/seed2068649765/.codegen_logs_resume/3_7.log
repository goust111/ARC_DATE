+    def dfs(depth: int) -> bool:
+        if depth == len(order):
+            return True
+        lock_index = order[depth]
+        for key_index, rotation in candidates[lock_index]:
+            if key_index in used_keys:
+                continue
+            used_keys.add(key_index)
+            assignment[lock_index] = (key_index, rotation)
+            if dfs(depth + 1):
