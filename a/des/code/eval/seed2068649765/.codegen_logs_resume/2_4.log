+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if len(coords) == 0:
+        return False
+
+    h, w = mask.shape
+    start = tuple(map(int, coords[0]))
+    seen = {start}
+    stack = [start]
+
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c, h, w):
+            if mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+
+    return len(seen) == int(mask.sum())
+
+
+def _rows_cols_mixed(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    row_counts = mask.sum(axis=1)
+    col_counts = mask.sum(axis=0)
+    return bool(
+        np.all((row_counts > 0) & (row_counts < w))
+        and np.all((col_counts > 0) & (col_counts < h))
+    )
+
+
+def _valid_sprite_mask(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    area = h * w
+    filled = int(mask.sum())
+    min_filled = max(3, h)
+    max_filled = area - max(3, h)
+    if not (min_filled <= filled <= max_filled):
+        return False
+    if not _rows_cols_mixed(mask):
+        return False
+    if not _is_connected(mask):
+        return False
+    if np.array_equal(mask, np.fliplr(mask)):
+        return False
+    if np.array_equal(mask, np.flipud(mask)):
+        return False
+    if np.array_equal(mask, np.flipud(np.fliplr(mask))):
+        return False
+    return True
+
+
+def _grow_connected_mask(cell_size: int, target: int) -> np.ndarray:
+    mask = np.zeros((cell_size, cell_size), dtype=bool)
+    seed = (random.randrange(cell_size), random.randrange(cell_size))
+    mask[seed] = True
+    frontier = set(_neighbors4(seed[0], seed[1], cell_size, cell_size))
+
+    while int(mask.sum()) < target and frontier:
+        cell = random.choice(tuple(frontier))
+        frontier.remove(cell)
+        mask[cell] = True
+        for nb in _neighbors4(cell[0], cell[1], cell_size, cell_size):
+            if not mask[nb]:
+                frontier.add(nb)
+
+    return mask
+
+
+def _sample_sprite(cell_size: int, bg: int, fg: int) -> np.ndarray:
