        lower, upper = _gen_area_bounds(h, w)
        if _gen_base_area(kind, h, w) <= upper and lower <= upper:
            options.append((h, w))
    return options


def _gen_frontier_orbits(mask, kind, forbidden, limit):
    h, w = mask.shape
    seen = set()
    choices = []
    for r in range(h):
