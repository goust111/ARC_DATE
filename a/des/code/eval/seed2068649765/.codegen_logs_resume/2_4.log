+def _apply_cell_symmetry(cell: np.ndarray, row: int, col: int) -> np.ndarray:
+    out = np.array(cell, copy=True)
+    if row % 2:
+        out = np.flipud(out)
+    if col % 2:
+        out = np.fliplr(out)
+    return np.array(out, copy=True)
