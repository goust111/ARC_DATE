+    return True
+
+
+def _choose_tampered_positions(rows: int, cols: int) -> list[tuple[int, int]]:
+    up_positions = [(r, 0) for r in range(1, rows)]
+    left_positions = [(r, c) for r in range(rows) for c in range(1, cols)]
+
+    if random.random() < 0.5:
