+        candidates.append((int(color), row_intervals, col_intervals))
+
+    assert len(candidates) == 1, "expected one separator color with regular full lines"
+    return candidates[0]
+
+
+def _extract_cells(
+    grid: np.ndarray,
+    row_intervals: list[tuple[int, int]],
+    col_intervals: list[tuple[int, int]],
