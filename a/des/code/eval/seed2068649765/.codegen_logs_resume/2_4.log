+        for up_pt in up_positions
+        for left_pt in left_positions
+        if _valid_tampered_positions(rows, cols, [up_pt, left_pt])
+    ]
+    assert pairs, "expected at least one valid two-anomaly pair"
+    return random.choice(pairs)
