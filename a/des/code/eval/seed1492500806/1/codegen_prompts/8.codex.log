+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    根据房间边框上的彩色单像素门，在相邻房间的对齐门之间铺设走廊。
+
+    说明：
+    - 房间边框是单像素厚的矩形框，背景为 Black。
+    - 为避免使用 ARC 中不可见的“颜色名称字母序”语义，生成器只产生同色对齐门；
