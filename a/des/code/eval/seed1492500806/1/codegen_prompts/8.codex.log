+        v = int(grid[r1, c])
+        if v not in (bg, border):
+            doors["bottom"][int(c)] = v
+    for r in range(r0 + 1, r1):
+        v = int(grid[r, c0])
+        if v not in (bg, border):
+            doors["left"][int(r)] = v
+        v = int(grid[r, c1])
+        if v not in (bg, border):
+            doors["right"][int(r)] = v
+    return doors
