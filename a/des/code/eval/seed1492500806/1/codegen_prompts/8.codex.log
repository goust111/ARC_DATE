+from __future__ import annotations
+
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+BORDER = 5
+DOOR_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GRID_MAX = 30
+ROOM_ROWS_RANGE = (2, 4)
+ROOM_COLS_RANGE = (2, 4)
+MARGIN_RANGE = (1, 3)
+ROOM_OUTER_MIN = 5
+ROOM_OUTER_MAX = 8
