+    if side == "top":
+        return int(r0), int(c0 + offset)
+    if side == "bottom":
+        return int(r1), int(c0 + offset)
+    if side == "left":
+        return int(r0 + offset), int(c0)
+    assert side == "right"
+    return int(r0 + offset), int(c1)
+
+
+def _add_door(
+    doors: dict[tuple[int, int], dict[str, dict[int, int]]],
+    room_key: tuple[int, int],
+    side: str,
+    offset: int,
+    color: int,
+) -> None:
