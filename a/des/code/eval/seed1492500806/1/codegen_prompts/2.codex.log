+def _pipe_crosses(pipe: np.ndarray) -> np.ndarray:
+    h, w = pipe.shape
+    crosses = np.zeros((h, w), dtype=bool)
+    if h < 3 or w < 3:
+        return crosses
+    crosses[1:-1, 1:-1] = (
+        pipe[1:-1, 1:-1]
+        & pipe[1:-1, :-2]
+        & pipe[1:-1, 2:]
+        & pipe[:-2, 1:-1]
+        & pipe[2:, 1:-1]
+    )
+    return crosses
