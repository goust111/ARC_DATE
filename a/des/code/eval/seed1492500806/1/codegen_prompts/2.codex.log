+            v_dist = random.randint(2, h - 4)
+            if v_dist + 1 > w - 3:
+                return None
+            h_dist = random.randint(v_dist + 1, w - 3)
+        main_col = _distance_to_index(w, h_side, h_dist)
+        main_row = _distance_to_index(h, v_side, v_dist)
+
