        h_dist = distance
        v_dist = distance
        main_col = _distance_to_index(w, h_side, h_dist)
        main_row = _distance_to_index(h, v_side, v_dist)
        winner = "h"
    else:
        assert scenario == "shorter"
        h_side = random.choice(["left", "right"])
