+GEN_BG = 8
+GEN_FOREGROUND = [0, 1, 2, 3, 4, 5, 6, 7, 9]
+GEN_SEED_COUNT_CHOICES = [1, 2, 3]
+GEN_SIZE_CHOICES = [5, 7]
+GEN_MARKER_COUNT_RANGE = (2, 5)
+GEN_MAX_ATTEMPTS = 400
