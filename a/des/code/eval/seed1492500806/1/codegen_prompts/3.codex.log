+def _paste_clipped(dst: np.ndarray, src: np.ndarray, top: int, left: int) -> None:
+    h, w = dst.shape
+    sh, sw = src.shape
+    r0 = max(0, top)
+    c0 = max(0, left)
+    r1 = min(h, top + sh)
+    c1 = min(w, left + sw)
