+        rects.sort(key=lambda item: (item[2], item[0], item[1]), reverse=True)
+        areas = [area for _, _, area in rects]
+        assert len(areas) == len(set(areas)), "main: rectangle areas within a color group must be unique"
+        groups[color] = rects
