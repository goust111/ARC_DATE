+        if not np.all(sub[-1, :] == GREY):
+            continue
+        if not np.all(sub[:, 0] == GREY):
+            continue
+        if not np.all(sub[:, -1] == GREY):
+            continue
+        if h > 2 and w > 2 and np.any(sub[1:-1, 1:-1] == GREY):
