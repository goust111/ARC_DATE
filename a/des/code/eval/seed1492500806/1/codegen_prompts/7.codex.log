+    grid = np.full((grid_h, grid_w), BG, dtype=int)
+
+    baseline = top_margin + max_height - 1
+    left = left_margin
+    for pos, idx in enumerate(input_order):
+        item = containers[idx]
+        top = baseline - item["height"] + 1
+        _draw_container(
+            grid,
+            top=top,
