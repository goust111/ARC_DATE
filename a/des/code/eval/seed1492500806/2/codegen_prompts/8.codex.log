+        for r in range(height)
+        for c in range(width)
+        if (r, c) not in reserved and (r, c) not in halo
+    ]
+    if not free_cells:
+        free_cells = [(r, c) for r in range(height) for c in range(width) if (r, c) not in reserved]
+    if not free_cells:
+        return None
+
