+def _balanced_choices(options, count: int, rng: np.random.Generator):
+    options = list(options)
+    chosen = []
+    while len(chosen) < count:
+        order = list(rng.permutation(len(options)))
+        chosen.extend(options[i] for i in order)
+    return chosen[:count]
