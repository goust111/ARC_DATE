+def _room_seeds(grid: np.ndarray, room: dict[str, object], bg: int) -> list[tuple[int, int, int]]:
+    r0, c0, r1, c1 = room["bbox"]
+    wall_color = int(room["wall_color"])
+    seeds: list[tuple[int, int, int]] = []
+    for r in range(r0 + 1, r1):
