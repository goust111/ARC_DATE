+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                if cr > 0 and mask[cr - 1, cc] and not seen[cr - 1, cc]:
+                    seen[cr - 1, cc] = True
+                    stack.append((cr - 1, cc))
+                if cr + 1 < h and mask[cr + 1, cc] and not seen[cr + 1, cc]:
+                    seen[cr + 1, cc] = True
+                    stack.append((cr + 1, cc))
+                if cc > 0 and mask[cr, cc - 1] and not seen[cr, cc - 1]:
+                    seen[cr, cc - 1] = True
+                    stack.append((cr, cc - 1))
+                if cc + 1 < w and mask[cr, cc + 1] and not seen[cr, cc + 1]:
+                    seen[cr, cc + 1] = True
+                    stack.append((cr, cc + 1))
+            comps.append(coords)
+    return comps
+
+
+def _rectangle_perimeter(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    coords: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        coords.add((r0, c))
+        coords.add((r1, c))
+    for r in range(r0 + 1, r1):
+        coords.add((r, c0))
+        coords.add((r, c1))
+    return coords
