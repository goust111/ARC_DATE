+        min_h = INTERIOR_H_RANGE[0]
+        min_w = INTERIOR_W_RANGE[0]
+        if mode == "dual" and spec["alignment"] == "same_col":
+            min_h = max(min_h, 3)
+        if mode == "dual" and spec["alignment"] == "same_row":
+            min_w = max(min_w, 3)
