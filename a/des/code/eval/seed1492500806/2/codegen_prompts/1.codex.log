+        if mode == "dual" and spec["alignment"] == "same_row":
+            min_w = max(min_w, 3)
+        spec["interior_h"] = int(rng.integers(min_h, INTERIOR_H_RANGE[1]))
+        spec["interior_w"] = int(rng.integers(min_w, INTERIOR_W_RANGE[1]))
+        specs.append(spec)
+
+    return specs
+
+
+def _place_rooms(
+    h: int,
