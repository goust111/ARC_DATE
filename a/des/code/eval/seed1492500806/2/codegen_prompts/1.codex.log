+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+MAGENTA = 6
+AZURE = 8
+
+PRIMARY_COLORS = (RED, GREEN, BLUE)
+PRIMARY_TO_BIT = {
+    RED: 1,
+    GREEN: 2,
+    BLUE: 4,
+}
+BIT_TO_COLOR = {
+    1: RED,
+    2: GREEN,
+    4: BLUE,
+    3: YELLOW,   # red + green
+    5: MAGENTA,  # red + blue
+    6: AZURE,    # green + blue
+}
+DUAL_COLOR_PAIRS = (
+    (RED, BLUE),
+    (RED, GREEN),
+    (BLUE, GREEN),
+)
+DUAL_ALIGNMENTS = ("cross", "same_row", "same_col")
+
+GRID_H_RANGE = (12, 21)
+GRID_W_RANGE = (12, 21)
+INTERIOR_H_RANGE = (2, 8)
+INTERIOR_W_RANGE = (2, 8)
+ROOM_PADDING = 1
+OUTER_MARGIN = 1
+MAX_GENERATION_ATTEMPTS = 400
+ROOM_PLACEMENT_ATTEMPTS = 120
