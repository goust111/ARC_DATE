+
+def _rectangle_perimeter(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    coords: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        coords.add((r0, c))
+        coords.add((r1, c))
+    for r in range(r0 + 1, r1):
+        coords.add((r, c0))
+        coords.add((r, c1))
