+    if any(room["mode"] == "dual" for room in rooms):
+        if not np.any(np.isin(out, [YELLOW, MAGENTA, AZURE])):
+            return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
