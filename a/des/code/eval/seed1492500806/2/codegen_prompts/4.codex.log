+    majority_count = region_count - tie_count
+    modes = ["tie"] * tie_count + ["majority"] * majority_count
+    rng.shuffle(modes)
+
+    specs: list[dict] = []
+    for mode in modes:
+        shape = _make_shape(rng)
+        interior, boundary = _build_patch(shape)
+        votes = _sample_votes(rng, int(shape.sum()), mode)
+        specs.append(
+            {
