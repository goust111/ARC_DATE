+    if dr == 1:
+        r_max -= repeats * step
+    elif dr == -1:
+        r_min += repeats * step
+    if dc == 1:
+        c_max -= repeats * step
+    elif dc == -1:
+        c_min += repeats * step
+    return range(r_min, r_max + 1), range(c_min, c_max + 1)
+
+
+def _place_objects(H: int, W: int, specs: list[dict]) -> list[dict] | None:
+    occupied = np.zeros((H, W), dtype=bool)
+    placed: list[dict] = []
+
+    specs = sorted(
+        specs,
+        key=lambda spec: (
+            spec["repeats"] * spec["step"],
+            spec["mask"].shape[0] * spec["mask"].shape[1],
