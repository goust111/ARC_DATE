+    for marker in markers:
+        obj = _extract_object(g, marker, bg)
+        color = int(obj["color"])
+        dr, dc = obj["guide_vec"]
+        step = int(obj["step"])
+        repeats = int(obj["repeats"])
+        stamp = obj["stamp"]
+
+        for k in range(1, repeats + 1):
+            shift_r = dr * step * k
+            shift_c = dc * step * k
+            for r, c in stamp:
+                rr = r + shift_r
+                cc = c + shift_c
+                assert _in_bounds(out.shape, rr, cc), "stamped copy must fit inside the grid"
+                out[rr, cc] = color
