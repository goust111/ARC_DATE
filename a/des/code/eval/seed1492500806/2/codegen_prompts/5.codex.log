+    seen = set()
+    shape = grid.shape
+    while stack:
+        r, c = stack.pop()
+        if (r, c) in seen or (r, c) in banned or int(grid[r, c]) != int(color):
+            continue
+        seen.add((r, c))
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if _in_bounds(shape, nr, nc):
