+    n_objects = random.randint(*GEN_OBJECTS_RANGE)
+    side_lo, side_hi = GEN_SIDE_RANGE_BY_COUNT[n_objects]
+    H = random.randint(side_lo, side_hi)
+    W = random.randint(side_lo, side_hi)
+
