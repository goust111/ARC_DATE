+    branch_c = attach_c + (1 if attach_c == 0 else -1 if attach_c == w - 1 else random.choice([-1, 1]))
+    attach = (side_r, attach_c)
+    required = {attach, (side_r, branch_c), (inward_r, attach_c)}
