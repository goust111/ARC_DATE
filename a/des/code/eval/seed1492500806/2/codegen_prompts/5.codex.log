+def _is_connected(mask: np.ndarray) -> bool:
+    points = [tuple(map(int, pos)) for pos in np.argwhere(mask)]
+    if not points:
+        return False
+    stack = [points[0]]
+    seen = set()
+    while stack:
+        r, c = stack.pop()
+        if (r, c) in seen or not bool(mask[r, c]):
