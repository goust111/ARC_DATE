+    def search(chosen: list[tuple[int, int]]) -> list[tuple[int, int]] | None:
+        if len(chosen) == count:
+            return sorted(chosen)
+        pool = candidates[:]
+        random.shuffle(pool)
+        for span in pool:
+            if fits(span, chosen):
+                chosen.append(span)
+                found = search(chosen)
+                if found is not None:
