+        frag_coords = {(r - frag_bbox[0], c - frag_bbox[1]) for r, c in inside}
+        assert frag_coords == frag_shape == target_shape, f"fragment color {color} must match the gap rectangle"
+
+        if side in ("top", "bottom"):
