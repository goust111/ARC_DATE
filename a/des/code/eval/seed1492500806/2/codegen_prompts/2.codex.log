                    hits.append((steps, prev))
                break
            prev = (r, c)

    if not hits:
        return None
    min_steps = min(steps for steps, _target in hits)
    nearest = [target for steps, target in hits if steps == min_steps]
    assert len(set(nearest)) == 1, "nearest exact sightline target must be unique"
    return nearest[0]


