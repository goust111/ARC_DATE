+    grid = np.full(shape, BG, dtype=int)
+    r0, c0, r1, c1 = bbox
+    grid[r0 : r0 + thickness, c0 : c1 + 1] = FRAME
+    grid[r1 - thickness + 1 : r1 + 1, c0 : c1 + 1] = FRAME
+    grid[r0 : r1 + 1, c0 : c0 + thickness] = FRAME
+    grid[r0 : r1 + 1, c1 - thickness + 1 : c1 + 1] = FRAME
+    return grid
