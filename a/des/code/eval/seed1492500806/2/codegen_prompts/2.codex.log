+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME = 9
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8]
+
+GRID_H_RANGE = (18, 29)
+GRID_W_RANGE = (18, 29)
