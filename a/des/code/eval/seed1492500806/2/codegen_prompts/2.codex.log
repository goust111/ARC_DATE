+        coord = mc
+    elif mr == r1 + 1 and c0 + thickness <= mc <= c1 - thickness:
+        side = "bottom"
+        coord = mc
+    elif mc == c0 - 1 and r0 + thickness <= mr <= r1 - thickness:
+        side = "left"
+        coord = mr
+    elif mc == c1 + 1 and r0 + thickness <= mr <= r1 - thickness:
+        side = "right"
