+FRAME_MARGIN = 1
+FRAME_H_PAD = 6
+FRAME_W_PAD = 6
+GAP_COUNT_RANGE = (2, 6)
+GAP_LEN_RANGE = (2, 6)
+GAP_SEPARATION = 1
+GEN_RETRIES = 400
