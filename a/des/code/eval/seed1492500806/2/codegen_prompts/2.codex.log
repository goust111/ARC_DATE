+
+def _find_marker_target(
+    marker: tuple[int, int],
+    gaps: dict[str, list[tuple[int, int]]],
+    bbox: tuple[int, int, int, int],
+    thickness: int,
+) -> tuple[str, tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    mr, mc = marker
