+def _render_sources(
+    base: np.ndarray,
+    positions: list[tuple[int, int]],
+    colors: tuple[int, ...],
+) -> np.ndarray:
+    grid = base.copy()
+    for (r, c), color in zip(positions, colors):
+        grid[r, c] = color
+    return grid
+
