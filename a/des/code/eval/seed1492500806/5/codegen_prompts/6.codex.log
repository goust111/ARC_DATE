+def _gen_attempt() -> np.ndarray | None:
+    rng = random.Random()
+    want_truncated = rng.random() < 0.5
+    want_cross = rng.random() < 0.5
+    want_blocked = rng.random() < 0.5
+    want_unreflected = rng.random() < 0.5
