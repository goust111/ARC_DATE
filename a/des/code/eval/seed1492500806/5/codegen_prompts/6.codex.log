+        grid = np.full((h, w), BG, dtype=int)
+        coords = _mirror_coords(start, mirror_kind, length)
+        for r, c in coords:
+            grid[r, c] = MIRROR
+
+        if want_truncated:
+            full = _mirror_coords(start, mirror_kind, max_len)
+            br, bc = full[length]
+            grid[br, bc] = GRAY
