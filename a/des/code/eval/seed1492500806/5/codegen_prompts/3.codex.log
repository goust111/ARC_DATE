+    expected = _expected_from_specs(specs)
+    try:
+        if not np.array_equal(main(grid), expected):
+            return None
+    except Exception:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
