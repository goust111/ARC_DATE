+
+def _find_legend_mapping(grid: np.ndarray) -> dict[int, int]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    mapping: dict[int, int] = {}
+    for comp in _components(g == LEGEND_ON):
+        r0, c0, r1, c1 = _bbox(comp)
