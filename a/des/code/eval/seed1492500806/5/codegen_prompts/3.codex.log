+    r0, c0 = anchor
+    for i, (color, depth) in enumerate(rows):
+        rr = r0 + 2 * i
+        grid[rr, c0] = int(color)
+        grid[rr, c0 + 1 : c0 + 1 + int(depth)] = LEGEND_ON
+
+
