+def _sample_polyline() -> list[tuple[int, int]]:
+    shape = random.choice(("elbow", "zigzag"))
+    a = random.randint(*LENGTH_RANGE)
+    b = random.randint(*LENGTH_RANGE)
+    if shape == "elbow":
+        return [(0, 0), (0, a), (b, a)]
+    c = random.randint(*THIRD_SEGMENT_RANGE)
+    return [(0, 0), (0, a), (b, a), (b, a + c)]
