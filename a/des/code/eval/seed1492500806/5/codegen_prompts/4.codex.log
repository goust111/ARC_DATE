+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+AZURE = 8
+
+START = GREEN
+END = RED
+PATH = GREY
+ARROW = AZURE
+CARGO_COLORS = (BLUE, YELLOW, MAGENTA, ORANGE)
+PATHLIKE = frozenset({START, END, PATH, *CARGO_COLORS})
