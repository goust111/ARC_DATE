+
+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < h:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < w:
+        out.append((r, c + 1))
+    return out
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _sign(x: int) -> int:
+    return 0 if x == 0 else (1 if x > 0 else -1)
+
+
+def _trace_points(points: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    cells = [points[0]]
+    for (r0, c0), (r1, c1) in zip(points[:-1], points[1:], strict=True):
+        dr = _sign(r1 - r0)
+        dc = _sign(c1 - c0)
+        steps = abs(r1 - r0) + abs(c1 - c0)
+        assert (dr == 0) != (dc == 0)
+        for step in range(1, steps + 1):
+            cells.append((r0 + dr * step, c0 + dc * step))
+    return cells
+
+
+def _segment_arrows(points: list[tuple[int, int]]) -> list[tuple[int, int]]:
