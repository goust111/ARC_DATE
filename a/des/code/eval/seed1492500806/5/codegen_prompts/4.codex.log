+
+    max_cargo = min(4, len(cargo_candidates))
+    if max_cargo < 1:
+        return None
+    if max_cargo >= 2 and random.random() < 0.5:
+        cargo_count = random.randint(2, max_cargo)
+    else:
+        cargo_count = 1
+
+    final_start = len(path_order) - 1 - cargo_count
+    choices = cargo_candidates[:]
