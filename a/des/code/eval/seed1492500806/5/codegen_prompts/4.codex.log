+def _dilate(coords: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:
+    blocked = set()
+    for r, c in coords:
+        for rr in range(max(0, r - 1), min(h, r + 2)):
+            for cc in range(max(0, c - 1), min(w, c + 2)):
+                blocked.add((rr, cc))
+    return blocked
+
