+def _normalize_points(points: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    min_r = min(rows)
+    min_c = min(cols)
+    return [(r - min_r, c - min_c) for r, c in points]
+
