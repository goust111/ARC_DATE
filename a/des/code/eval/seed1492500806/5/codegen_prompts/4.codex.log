+def _transform_point(point: tuple[int, int], rot: int, flip: bool) -> tuple[int, int]:
+    r, c = point
+    if flip:
+        c = -c
+    rot %= 4
+    if rot == 0:
+        return r, c
+    if rot == 1:
+        return c, -r
+    if rot == 2:
+        return -r, -c
+    return -c, r
