+RING_INDEX = {color: idx for idx, color in enumerate(COLOR_RING)}
+
+MAX_INTERNAL_DEPTH = 4
+TRUNK_LEN_RANGE = (2, 4)
+TOP_PAD_RANGE = (1, 4)
+SIDE_PAD_RANGE = (1, 4)
+BOTTOM_PAD_RANGE = (1, 3)
+GEN_RETRIES = 400
+
+
+@dataclass
+class ParsedLeaf:
+    bbox: tuple[int, int, int, int]
+
+
+@dataclass
+class ParsedNode:
+    pos: tuple[int, int]
+    marker: int
+    left: ParsedNode | ParsedLeaf
+    right: ParsedNode | ParsedLeaf
+
+
+@dataclass
+class DesignLeaf:
+    endpoint: tuple[int, int]
+    bbox: tuple[int, int, int, int]
+
