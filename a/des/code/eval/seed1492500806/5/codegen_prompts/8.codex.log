+def _candidate_leaf_bbox(g: np.ndarray, endpoint: tuple[int, int]) -> tuple[int, int, int, int]:
+    r, c = endpoint
+    candidates = []
+    for dr in (0, 1):
+        for dc in (0, 1):
+            r0 = r - dr
+            c0 = c - dc
+            if _is_uniform_block(g, r0, c0, LEAF_COLOR):
+                candidates.append((r0, c0, r0 + 1, c0 + 1))
