+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+MAGENTA = 6
+ORANGE = 7
+AZURE = 8
+LEAF_COLOR = 9
+
+ROOT_COLORS = (BLUE, RED, YELLOW)
+MARKER_COLORS = (ORANGE, AZURE)
