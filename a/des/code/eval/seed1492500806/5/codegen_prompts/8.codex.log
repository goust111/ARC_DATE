+            c0 = c - dc
+            if _is_uniform_block(g, r0, c0, LEAF_COLOR):
+                candidates.append((r0, c0, r0 + 1, c0 + 1))
+    assert len(candidates) == 1, f"expected one leaf block containing {endpoint}, got {candidates}"
+    return candidates[0]
