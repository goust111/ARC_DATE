+def _follow_branch(
+    g: np.ndarray,
+    marker_pos: tuple[int, int],
+    direction: int,
+) -> tuple[tuple[int, int], str]:
+    r, c = marker_pos
+    k = 1
+    saw_gray = False
+    h, w = g.shape
+    while True:
+        rr = r - k
+        cc = c + direction * k
