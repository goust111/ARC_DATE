+        sr0, sc0, sr1, sc1 = r0 + row_shift, c0 + col_shift, r1 + row_shift, c1 + col_shift
+        assert np.all(grid[sr0 : sr1 + 1, sc0 : sc1 + 1] == BG)
+        grid[sr0 : sr1 + 1, sc0 : sc1 + 1] = LEAF_COLOR
+        leaf.bbox = (sr0, sc0, sr1, sc1)
