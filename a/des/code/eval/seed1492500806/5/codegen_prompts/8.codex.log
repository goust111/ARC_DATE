+    return candidates[0]
+
+
+def _follow_vertical_to_marker(g: np.ndarray, start: tuple[int, int]) -> tuple[int, int]:
+    r, c = start
+    assert r >= 0
+    while r >= 0 and int(g[r, c]) == GRAY:
