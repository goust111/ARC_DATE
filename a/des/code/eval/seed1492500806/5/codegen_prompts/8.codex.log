+def _find_blocks(g: np.ndarray, colors: set[int]) -> list[tuple[int, int, int, int, int]]:
+    blocks: list[tuple[int, int, int, int, int]] = []
+    h, w = g.shape
+    for r in range(h - 1):
+        for c in range(w - 1):
+            color = int(g[r, c])
+            if color not in colors:
+                continue
+            if np.all(g[r : r + 2, c : c + 2] == color):
+                blocks.append((r, c, r + 1, c + 1, color))
+    return blocks
