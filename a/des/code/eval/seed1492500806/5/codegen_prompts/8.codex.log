    sampled = _sample_objects(H, segs, selected_colors, colors)
    if sampled is None:
        return None

    objects, out = sampled
    inp = _render_input(H, objects)
    if _passes_oracle(inp, out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
