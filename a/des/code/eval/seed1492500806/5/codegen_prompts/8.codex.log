+def _is_uniform_block(g: np.ndarray, r0: int, c0: int, color: int) -> bool:
+    h, w = g.shape
+    if r0 < 0 or c0 < 0 or r0 + 1 >= h or c0 + 1 >= w:
+        return False
+    return bool(np.all(g[r0 : r0 + 2, c0 : c0 + 2] == color))
