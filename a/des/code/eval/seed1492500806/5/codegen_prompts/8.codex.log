+        right_color = _color_shift(incoming, 2)
+    else:
+        left_color = _color_shift(incoming, -1)
+        right_color = _color_shift(incoming, -2)
+
+    for child, color in ((node.left, left_color), (node.right, right_color)):
+        if isinstance(child, DesignLeaf):
+            colors[child.bbox] = color
+        else:
