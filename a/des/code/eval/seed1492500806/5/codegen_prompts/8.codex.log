+    edges: list[tuple[tuple[int, int], tuple[int, int]]],
+) -> None:
+    r, c = pos
+    markers.append((r, c, node.marker))
+    shift = shifts[level]
+    for direction, side_name in ((-1, "left"), (1, "right")):
