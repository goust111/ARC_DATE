+    h, w = patch.shape
+    gh, gw = grid.shape
+    rows = list(range(GEN_EDGE_MARGIN, gh - h - GEN_EDGE_MARGIN + 1))
+    cols = list(range(GEN_EDGE_MARGIN, gw - w - GEN_EDGE_MARGIN + 1))
+    random.shuffle(rows)
+    random.shuffle(cols)
+    for top in rows:
+        for left in cols:
+            box = (top, left, top + h - 1, left + w - 1)
