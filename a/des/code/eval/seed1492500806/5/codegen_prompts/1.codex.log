+def _paste_patch(grid: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    sub = grid[top : top + patch.shape[0], left : left + patch.shape[1]]
+    mask = patch != int(BG)
+    sub[mask] = patch[mask]
