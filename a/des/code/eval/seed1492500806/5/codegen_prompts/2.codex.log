+    for color in sorted(int(v) for v in np.unique(grid) if int(v) not in (bg, wall)):
+        for comp in _components(grid == color):
+            touches_edge = any(r == 0 or c == 0 or r == grid.shape[0] - 1 or c == grid.shape[1] - 1 for r, c in comp)
