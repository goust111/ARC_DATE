+            c0, c1 = min(cols), max(cols)
+            if (r1 - r0 + 1, c1 - c0 + 1) != (2, 2):
+                continue
+            local = np.zeros((2, 2), dtype=bool)
+            for r, c in comp:
+                local[r - r0, c - c0] = True
+            if local.sum() != 3:
+                continue
+            missing = np.argwhere(~local)
+            if len(missing) != 1:
+                continue
+            miss_r, miss_c = map(int, missing[0])
+            candidates.append(
