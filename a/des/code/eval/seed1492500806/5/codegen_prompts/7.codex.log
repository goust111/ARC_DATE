+        driver = _driver_index(gears, arrow)
+        dists = sorted(
+            min(
+                abs(r1 - r2) + abs(c1 - c2)
+                for r1, c1 in arrow["cells"]
+                for r2, c2 in gear["cells"]
+            )
+            for gear in gears
