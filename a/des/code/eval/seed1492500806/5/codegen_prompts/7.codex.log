+    start = min(cell_set)
+    prev = None
+    curr = start
+    seq = [start]
+    while True:
+        nbrs = adj[curr]
+        if prev is None:
+            nxt = nbrs[0]
+        else:
+            nxts = [n for n in nbrs if n != prev]
+            assert nxts, "cycle tracing failed"
+            nxt = nxts[0]
+        if nxt == start:
+            assert len(seq) == len(cell_set), "cycle closed too early"
+            break
+        prev, curr = curr, nxt
+        seq.append(curr)
+    return seq
