+        if np.array_equal(out, grid):
+            return None
+        _ = driver
+    except AssertionError:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid gear-rotation input")

