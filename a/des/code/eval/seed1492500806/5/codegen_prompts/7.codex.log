+
+
+def _is_connected(edges: list[list[int]]) -> bool:
+    seen = {0}
+    q = deque([0])
+    while q:
+        node = q.popleft()
+        for nxt in edges[node]:
+            if nxt not in seen:
+                seen.add(nxt)
+                q.append(nxt)
+    return len(seen) == len(edges)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    size = random.choice([5, 7, 9])
