+def _transform_cell(cell: tuple[int, int], corner: str, max_r: int, max_c: int) -> tuple[int, int]:
+    r, c = cell
+    if "bottom" in corner:
+        r = max_r - r
+    if "right" in corner:
+        c = max_c - c
+    return r, c
+
