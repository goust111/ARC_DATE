+        r0 = top_pad + rr * span
+        c0 = left_pad + cc * span
+        grid[r0 : r0 + size, c0 : c0 + size] = BG
+        grid[r0, c0 : c0 + size] = RING
+        grid[r0 + size - 1, c0 : c0 + size] = RING
+        grid[r0 : r0 + size, c0] = RING
+        grid[r0 : r0 + size, c0 + size - 1] = RING
