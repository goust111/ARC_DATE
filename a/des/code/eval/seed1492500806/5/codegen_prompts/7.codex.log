+
+def _sequence_is_clockwise(seq: list[tuple[int, int]]) -> bool:
+    area = 0
+    wrapped = seq[1:] + seq[:1]
+    for (r1, c1), (r2, c2) in zip(seq, wrapped):
+        x1, y1 = c1, -r1
+        x2, y2 = c2, -r2
+        area += x1 * y2 - x2 * y1
