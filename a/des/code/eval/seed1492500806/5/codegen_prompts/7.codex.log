+def _mesh(gear_a: dict, gear_b: dict, grid: np.ndarray, bg: int) -> bool:
+    h, w = grid.shape
+    other = gear_b["cell_set"]
+    for r, c in gear_a["cells"]:
+        for dr, dc in ORTHO_DIRS:
+            mr, mc = r + dr, c + dc
+            nr, nc = r + 2 * dr, c + 2 * dc
+            if not (0 <= mr < h and 0 <= mc < w and 0 <= nr < h and 0 <= nc < w):
+                continue
