+def _square_cycle(size: int) -> list[tuple[int, int]]:
+    cycle = []
+    for c in range(size):
+        cycle.append((0, c))
+    for r in range(1, size):
+        cycle.append((r, size - 1))
+    for c in range(size - 2, -1, -1):
+        cycle.append((size - 1, c))
+    for r in range(size - 2, 0, -1):
+        cycle.append((r, 0))
+    return cycle
+
