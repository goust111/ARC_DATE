+        cycle = _trace_cycle(comp)
+        gears.append(
+            {
+                "cells": comp,
+                "cell_set": set(comp),
+                "bbox": bbox,
+                "marker": marker_cells[0],
+                "marker_color": int(grid[marker_cells[0]]),
+                "cycle": cycle,
+            }
+        )
