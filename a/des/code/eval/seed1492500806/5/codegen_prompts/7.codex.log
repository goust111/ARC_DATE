+    out = g.copy()
+    for gear, direction in zip(gears, directions):
+        if direction == 0:
+            continue
+        cycle = gear["cycle"]
+        shift = direction if _sequence_is_clockwise(cycle) else -direction
+        idx = cycle.index(gear["marker"])
+        nr, nc = cycle[(idx + shift) % len(cycle)]
