+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+RING = 5
+ARROW = 8
+MARKER_COLORS = [1, 2, 3, 4, 6, 7, 9]
+SIZE_CONFIG = {
+    5: {"max_gears": 6, "max_side": 4},
+    7: {"max_gears": 5, "max_side": 3},
+    9: {"max_gears": 4, "max_side": 2},
