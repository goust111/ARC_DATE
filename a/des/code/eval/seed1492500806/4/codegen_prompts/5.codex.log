+        cols = frame_w + rng.randint(8, 12 + n_stamps)
+        min_free = sum((stamp["mask"].shape[0] + 2) * (stamp["mask"].shape[1] + 2) for stamp in stamps)
+        if rows * cols - frame_h * frame_w < min_free:
