+            uniq = _unique_rotation_count(mask, locator)
+            if uniq < 2:
+                continue
+            if require_four and uniq < 4:
+                continue
+            return {
+                "mask": mask,
+                "locator": locator,
+                "main_color": int(main_color),
+                "locator_color": int(locator_color),
