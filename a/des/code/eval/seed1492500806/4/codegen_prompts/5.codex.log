+        _mark_with_gap(blocked, coords)
+        occupied[coords[:, 0], coords[:, 1]] = True
+        placements[idx] = {
+            "top": int(top),
+            "left": int(left),
+            "coords": coords,
+            "anchor": (int(anchor[0]), int(anchor[1])),
+            "rotation": int(stamp["target_rotation"]),
+            "main_color": int(stamp["main_color"]),
+            "locator_color": int(stamp["locator_color"]),
