+def _find_canvas(grid: np.ndarray) -> tuple[int, int, int, int]:
+    grey_mask = grid == GREY
+    candidates: list[tuple[int, int, int, int]] = []
+    for pts in _components(grey_mask):
+        r0, c0, r1, c1 = _bbox(pts)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 3 or w < 3:
+            continue
+        expected = 2 * (h + w) - 4
+        if int(pts.shape[0]) != expected:
+            continue
