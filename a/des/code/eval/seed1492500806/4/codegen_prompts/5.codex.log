+        grid[frame[2], frame[1] : frame[3] + 1] = GREY
+        grid[frame[0] : frame[2] + 1, frame[1]] = GREY
+        grid[frame[0] : frame[2] + 1, frame[3]] = GREY
+
+        placements_global: list[dict[str, Any]] = []
+        anchor_map: dict[int, tuple[int, int]] = {}
