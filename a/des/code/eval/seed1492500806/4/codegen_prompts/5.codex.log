+            int(abs_coords[:, 0].min()) < ir0
+            or int(abs_coords[:, 0].max()) > ir1
+            or int(abs_coords[:, 1].min()) < ic0
+            or int(abs_coords[:, 1].max()) > ic1
+        ):
+            continue
