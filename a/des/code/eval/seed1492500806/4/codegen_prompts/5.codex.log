+def _random_connected_mask(rng: random.Random) -> np.ndarray | None:
+    for _ in range(SHAPE_RETRIES):
+        h = rng.randint(2, MAX_SHAPE_SIDE)
+        w = rng.randint(2, MAX_SHAPE_SIDE)
