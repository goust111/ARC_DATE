+def _stamp_patch(stamp: dict[str, Any]) -> np.ndarray:
+    patch = np.zeros(stamp["mask"].shape, dtype=int)
+    patch[stamp["mask"]] = int(stamp["main_color"])
+    lr, lc = stamp["locator"]
+    patch[lr, lc] = int(stamp["locator_color"])
