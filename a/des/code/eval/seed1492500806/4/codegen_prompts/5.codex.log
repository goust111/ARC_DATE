+        assert count_map[locator_color] == 1, "locator must be unique within its stamp"
+
+        sr0, sc0, sr1, sc1 = _bbox(pts)
+        mask = np.zeros((sr1 - sr0 + 1, sc1 - sc0 + 1), dtype=bool)
+        locator = None
