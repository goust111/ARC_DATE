+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+USABLE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+MIN_STAMPS = 2
+MAX_STAMPS = 4
+MIN_CANVAS = 8
+MAX_CANVAS = 12
+MAX_SHAPE_SIDE = 4
+MIN_SHAPE_CELLS = 3
+MAX_SHAPE_CELLS = 6
+GEN_RETRIES = 400
+TARGET_RETRIES = 40
+SOURCE_RETRIES = 160
+SHAPE_RETRIES = 120
+MAX_CANDIDATES_PER_STAMP = 12
+MAX_CANDIDATE_PRODUCT = 64
+STAMP_COUNT_CHOICES = [2, 2, 2, 3, 3, 4]
