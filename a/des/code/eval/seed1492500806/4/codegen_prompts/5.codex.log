+    loc_mask = np.zeros(mask.shape, dtype=bool)
+    loc_mask[locator] = True
+    rot_loc = np.rot90(loc_mask, k)
+    lr, lc = np.argwhere(rot_loc)[0]
+    return rot_mask, (int(lr), int(lc))
+
+
