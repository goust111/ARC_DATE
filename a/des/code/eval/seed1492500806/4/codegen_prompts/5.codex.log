+def _parse_anchors(grid: np.ndarray, frame: tuple[int, int, int, int]) -> dict[int, tuple[int, int]]:
+    r0, c0, r1, c1 = frame
+    inner = grid[r0 + 1 : r1, c0 + 1 : c1]
