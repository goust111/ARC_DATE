+                    if not np.any(occupied[other[0]["coords"][:, 0], other[0]["coords"][:, 1]]):
+                        continue
+                options.append(
+                    {
+                        "top": int(top),
+                        "left": int(left),
+                        "coords": coords.astype(int),
+                        "anchor": (int(anchor[0]), int(anchor[1])),
+                    }
+                )
+        if not options:
+            return None
+        chosen = rng.choice(options)
+        top = int(chosen["top"])
+        left = int(chosen["left"])
+        coords = chosen["coords"]
+        anchor = chosen["anchor"]
