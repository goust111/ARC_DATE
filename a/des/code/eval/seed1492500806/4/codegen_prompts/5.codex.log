+    return tuple(
+        (
+            tuple(rot_mask.shape),
+            rot_mask.tobytes(),
+            rot_loc[0],
+            rot_loc[1],
+        )
+        for rot_mask, rot_loc in (_rotate_stamp(mask, locator, k) for k in range(4))
