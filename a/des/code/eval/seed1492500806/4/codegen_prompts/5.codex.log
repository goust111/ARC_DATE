+        if not np.array_equal(expected, _render_output(grid.shape, details["frame"], details["solutions"][0])):
+            continue
+        return grid
+
+    return None
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _build_attempt(rng)
+        if grid is not None:
