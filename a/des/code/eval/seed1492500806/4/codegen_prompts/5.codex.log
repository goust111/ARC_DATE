+                if np.any(blocked[coords[:, 0], coords[:, 1]]):
+                    continue
+                anchor = (top + rot_loc[0], left + rot_loc[1])
+                options.append((top, left, coords.astype(int), anchor))
+        if not options:
+            return None
+        top, left, coords, anchor = rng.choice(options)
+        _mark_with_gap(blocked, coords)
