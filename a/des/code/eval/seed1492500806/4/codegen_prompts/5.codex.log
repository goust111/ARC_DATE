+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+USABLE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+MIN_STAMPS = 2
+MAX_STAMPS = 4
+MIN_CANVAS = 8
+MAX_CANVAS = 12
