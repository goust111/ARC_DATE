+def _mark_with_gap(mask: np.ndarray, coords: np.ndarray) -> None:
+    h, w = mask.shape
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        for nr in range(max(0, rr - 1), min(h, rr + 2)):
+            for nc in range(max(0, cc - 1), min(w, cc + 2)):
+                mask[nr, nc] = True
