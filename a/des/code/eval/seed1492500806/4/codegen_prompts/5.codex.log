+def _render_output(
+    shape: tuple[int, int], frame: tuple[int, int, int, int], solution: list[dict[str, Any]]
+) -> np.ndarray:
+    out = np.zeros(shape, dtype=int)
+    r0, c0, r1, c1 = frame
+    out[r0, c0 : c1 + 1] = GREY
+    out[r1, c0 : c1 + 1] = GREY
+    out[r0 : r1 + 1, c0] = GREY
+    out[r0 : r1 + 1, c1] = GREY
+    for placement in solution:
+        coords = placement["coords"]
+        out[coords[:, 0], coords[:, 1]] = int(placement["main_color"])
+    return out
+
