+    require_ambiguity = rng.random() < (0.35 if n_stamps < 4 else 0.2)
+    rotated_shapes = [_rotate_stamp(stamp["mask"], stamp["locator"], int(stamp["target_rotation"]))[0] for stamp in stamps]
