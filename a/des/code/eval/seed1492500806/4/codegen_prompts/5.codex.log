+
+
+def _build_attempt(rng: random.Random) -> np.ndarray | None:
+    n_stamps = rng.choice(STAMP_COUNT_CHOICES)
+    colors = USABLE_COLORS[:]
+    rng.shuffle(colors)
+    anchor_colors = colors[:n_stamps]
+    main_colors = colors[n_stamps : 2 * n_stamps]
