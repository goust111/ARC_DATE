+            anchor_c = frame_left + 1 + placement["anchor"][1]
+            grid[anchor_r, anchor_c] = int(placement["locator_color"])
+            anchor_map[int(placement["locator_color"])] = (anchor_r, anchor_c)
+            placements_global.append(
