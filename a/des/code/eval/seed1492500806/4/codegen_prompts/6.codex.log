+def _count_components(mask: np.ndarray, connectivity: int = 4) -> int:
+    n, m = mask.shape
+    visited = np.zeros_like(mask, dtype=bool)
+    count = 0
+    offsets = NEIGHBORS4 if connectivity == 4 else NEIGHBORS8
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if visited[r, c]:
