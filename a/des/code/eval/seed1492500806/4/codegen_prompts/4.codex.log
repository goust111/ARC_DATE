+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+CYAN = 8
+BROWN = 9
+
+SOURCE_POOL = (BLUE, RED, GREEN, MAGENTA, CYAN, BROWN)
+MIN_GEN_ATTEMPTS = 400
