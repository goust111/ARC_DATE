 115: def _gen_bounded_composition(total: int, parts: int, max_each: int) -> list[int] | None:
 116:     if parts <= 0 or total < parts or total > parts * max_each:
 117:         return None
 118: 
 119:     counts = []
 120:     remaining = total
 121:     for i in range(parts):
 122:         slots_left = parts - i - 1
 123:         lo = max(1, remaining - slots_left * max_each)
 124:         hi = min(max_each, remaining - slots_left)
 125:         counts.append(random.randint(lo, hi))
 126:         remaining -= counts[-1]
 127: 
 128:     random.shuffle(counts)
 129:     return counts
