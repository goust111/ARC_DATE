+
+BLACK = 0
+MAROON = 9
+COLOR_POOL = (1, 2, 3, 4, 5, 6, 7, 8)
+
+GRID_H_RANGE = (16, 28)
+GRID_W_RANGE = (16, 28)
+RECT_H_RANGE = (5, 11)
+RECT_W_RANGE = (5, 11)
