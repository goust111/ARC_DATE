+def _pattern_vertical(ih: int, iw: int, rng: random.Random) -> np.ndarray:
+    mask = np.zeros((ih, iw), dtype=bool)
+    phase = rng.randrange(2)
+    mask[:, phase::2] = True
+    return mask
+
+
+def _pattern_horizontal(ih: int, iw: int, rng: random.Random) -> np.ndarray:
+    mask = np.zeros((ih, iw), dtype=bool)
+    phase = rng.randrange(2)
+    mask[phase::2, :] = True
+    return mask
