+def _generate_instance(rng: random.Random) -> tuple[np.ndarray, np.ndarray] | None:
+    H = rng.randint(*GRID_H_RANGE)
+    W = rng.randint(*GRID_W_RANGE)
+    rect_count = rng.choices(RECT_COUNT_OPTIONS, weights=RECT_COUNT_WEIGHTS, k=1)[0]
