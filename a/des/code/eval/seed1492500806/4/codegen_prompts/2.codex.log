+        local_corners = [(0, 0), (0, c1 - c0), (r1 - r0, 0), (r1 - r0, c1 - c0)]
+        for (gr, gc), (lr, lc) in zip(corners, local_corners):
+            if int(inp[gr, gc]) != int(patch[lr, lc]):
+                return False
