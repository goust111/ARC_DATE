+        rng.shuffle(input_order)
+        if input_order == sorted_order:
+            continue
+        inp = _render((H, W), rects, input_order)
+        expected = _render((H, W), rects, sorted_order)
+        if _validate_instance(rects, inp, expected):
+            return inp, expected
+    return None
