+def _corners_conflict(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    return any(_point_in_bbox(point, b) for point in _bbox_corners(a)) or any(
+        _point_in_bbox(point, a) for point in _bbox_corners(b)
+    )
