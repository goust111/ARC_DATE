+
+
+def _pick_exit_to_boundary(
+    shape: Tuple[int, int], reserved: set[Coord]
+) -> tuple[Coord, Direction, List[Coord]]:
+    cells = _interior_cells(*shape)
+    for _ in range(400):
+        exit_portal = random.choice(cells)
