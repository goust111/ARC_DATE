+    input_path: set[Coord] = set()
+    extra_path: set[Coord] = set()
+    portal_colors: Dict[Coord, int] = {}
+    portal_dirs: Dict[Coord, Direction] = {}
+    endpoints_by_color: Dict[int, List[Coord]] = {color: [] for color in colors}
