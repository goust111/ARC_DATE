+def _interior_cells(h: int, w: int) -> List[Coord]:
+    return [(r, c) for r in range(1, h - 1) for c in range(1, w - 1)]
+
+
+def _available_grey_dirs(
+    shape: Tuple[int, int],
+    reserved: set[Coord],
+    portal: Coord,
+    blocked_side: Direction,
+) -> List[Direction]:
