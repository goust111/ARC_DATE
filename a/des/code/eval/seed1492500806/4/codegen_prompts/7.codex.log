+        if grey_count != 1:
+            return False
+
+    for marker in greys:
+        portal_count = sum(_add(marker, direction) in portals for direction in DIRS)
+        if portal_count != 1:
+            return False
+
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
