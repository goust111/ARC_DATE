+
+def _pick_free_endpoint(shape: Tuple[int, int], reserved: set[Coord]) -> tuple[Coord, Direction]:
+    cells = _interior_cells(*shape)
+    for _ in range(400):
+        portal = random.choice(cells)
+        if portal in reserved:
