+from __future__ import annotations
+
+from collections import Counter
+import random
+from typing import Dict, Iterable, List, Tuple
+
+import numpy as np
+
+
+Coord = Tuple[int, int]
+Direction = Tuple[int, int]
+
+
+BG = 0
+PATH = 3
+GREY = 5
+PORTAL_COLORS = [1, 2, 4, 6, 7, 8, 9]
+DIRS: List[Direction] = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_ATTEMPTS = 500
