import random
from collections import deque

import numpy as np


BLACK = 0
GRAY = 5
COLOR_POOL = tuple(color for color in range(1, 10) if color != GRAY)

GRID_H_RANGE = (20, 30)
GRID_W_RANGE = (20, 30)
PAIR_COUNT_RANGE = (2, 4)
KEY_INTERIOR_H_RANGE = (1, 4)
KEY_INTERIOR_W_RANGE = (1, 4)
LOCK_INTERIOR_MAX = 8
PLACEMENT_RETRIES = 200
GEN_ATTEMPTS = 300


def _components(mask: np.ndarray) -> list[np.ndarray]:
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    comps: list[np.ndarray] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            queue = deque([(r, c)])
            seen[r, c] = True
            coords: list[tuple[int, int]] = []
            while queue:
                cr, cc = queue.popleft()
                coords.append((cr, cc))
                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        queue.append((nr, nc))
            comps.append(np.array(coords, dtype=int))
    return comps


def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
    return (
        int(coords[:, 0].min()),
        int(coords[:, 1].min()),
        int(coords[:, 0].max()),
        int(coords[:, 1].max()),
    )


def _border_mask(h: int, w: int) -> np.ndarray:
    mask = np.zeros((h, w), dtype=bool)
    mask[0, :] = True
    mask[-1, :] = True
    mask[:, 0] = True
    mask[:, -1] = True
    return mask


def _find_locks_and_keys(grid: np.ndarray) -> tuple[list[dict], list[dict]]:
    g = np.asarray(grid, dtype=int)
    locks: list[dict] = []
    keys: list[dict] = []

    for coords in _components(g != BLACK):
        r0, c0, r1, c1 = _bbox(coords)
        sub = g[r0 : r1 + 1, c0 : c1 + 1]
        h, w = sub.shape
        if h < 3 or w < 3:
            continue

        border = _border_mask(h, w)
        border_vals = sub[border]
        interior = sub[1:-1, 1:-1]

        if np.all(border_vals != BLACK) and np.all(interior == BLACK):
