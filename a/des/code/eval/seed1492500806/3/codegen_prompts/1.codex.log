+def _turn_ccw(dr: int, dc: int) -> tuple[int, int]:
+    # The prompt fixes a 90-degree bend but leaves the handedness ambiguous.
+    # Use one consistent "mirror bend" convention across solver and generator.
+    return -dc, dr
