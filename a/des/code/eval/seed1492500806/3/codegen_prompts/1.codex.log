    grid = np.full((H, W), BACKGROUND_COLOR, dtype=int)
    for i, (start_r, end_c) in enumerate(zip(start_rows, end_cols)):
        min_first_col = end_cols[i + 1] + ENDPOINT_SPACING if i + 1 < n_walls else MIN_FIRST_STAIR_COL
