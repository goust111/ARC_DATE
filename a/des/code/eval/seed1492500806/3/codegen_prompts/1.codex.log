+    rr += dr0
+    cc += dc0
+    if not (0 <= rr < h and 0 <= cc < w):
+        return path
+    if (rr, cc) in seed_set:
+        return path
+    if not grey_mask[rr, cc]:
+        path.append((rr, cc))
+
+    dr, dc = _turn_ccw(dr0, dc0)
