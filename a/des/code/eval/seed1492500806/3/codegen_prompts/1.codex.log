+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BG = 0
+AXIS = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GRID_HEIGHT_RANGE = (10, 18)
+GRID_WIDTH_RANGE = (10, 18)
+AXIS_COUNT_CHOICES = (1, 2, 3)
