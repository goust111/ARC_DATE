+            if not _region_free(blocked, union_bbox, pad=1):
+                continue
+            _mark_blocked(blocked, union_bbox, pad=1)
+            key_cells = [(key_top + r, key_left + c) for r, c in obj["key_cells_local"]]
+            obj["key_cells"] = key_cells
+            obj["arrow_cells"] = arrow_cells
+            placed_key = True
