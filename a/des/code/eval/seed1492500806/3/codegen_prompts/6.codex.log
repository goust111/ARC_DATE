+
+BLACK = 0
+GREY = 5
+MAROON = 9
+FRAME_THICKNESS = 3
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8]
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDES = ["top", "bottom", "left", "right"]
