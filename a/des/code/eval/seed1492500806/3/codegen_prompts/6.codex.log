+        key_bbox = _bbox(key_cells)
+        arrow_options = []
+        for idx, arrow_cells in enumerate(arrow_components):
+            if idx in used_arrows:
+                continue
+            arrow_bbox = _bbox(arrow_cells)
+            direction = _direction_from_arrow(key_bbox, arrow_bbox)
+            if direction is None:
