+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    pair_count = 1 if rng.random() < 0.35 else 2
+    colors = rng.sample(PARENT_COLORS, 2 * pair_count)
+    pairs: list[dict] = []
