+        frame_left = 0
+        marker = [(frame_h // 2 - 1, frame_w + 1), (frame_h // 2, frame_w + 1)]
+        return {
+            "height": frame_h,
+            "width": frame_w + 2,
+            "frame_top": frame_top,
+            "frame_left": frame_left,
+            "marker": marker,
+        }
+    if side == "top":
+        frame_top = 2
+        frame_left = 0
+        mid = frame_w // 2 - 1
+        marker = [(0, mid), (0, mid + 1)]
+        return {
+            "height": frame_h + 2,
+            "width": frame_w,
+            "frame_top": frame_top,
+            "frame_left": frame_left,
+            "marker": marker,
+        }
+    frame_top = 0
+    frame_left = 0
+    mid = frame_w // 2 - 1
+    marker = [(frame_h + 1, mid), (frame_h + 1, mid + 1)]
