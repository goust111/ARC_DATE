+    raise RuntimeError("failed to generate parent masks")
+
+
+def _child_structure(frame_h: int, frame_w: int, side: str) -> dict:
+    if side == "left":
+        frame_top = 0
+        frame_left = 2
+        marker = [(frame_h // 2 - 1, 0), (frame_h // 2, 0)]
+        return {
+            "height": frame_h,
+            "width": frame_w + 2,
+            "frame_top": frame_top,
+            "frame_left": frame_left,
+            "marker": marker,
