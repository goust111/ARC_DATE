+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
