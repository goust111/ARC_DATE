+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+ARROW_COLOR = 9
+SIDE_COLOR_POOL = [1, 2, 3, 4, 5, 6, 7, 8]
+SIZE_OPTIONS = [5, 7, 9]
+CELL_GRID_RANGE = {5: (3, 6), 7: (3, 5), 9: (2, 4)}
+MAX_GENERATION_ATTEMPTS = 500
