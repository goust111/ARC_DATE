+def _find_gears(grid: np.ndarray, arrow_color: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    ring_mask = (g != BG) & (g != int(arrow_color))
+    black_mask = g == BG
+    ring_ii = _integral(ring_mask)
+    black_ii = _integral(black_mask)
