+            cell_index += 1
+
+    _draw_legend(grid, puzzle_height)
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _generate_case()
+        try:
+            out = main(grid)
