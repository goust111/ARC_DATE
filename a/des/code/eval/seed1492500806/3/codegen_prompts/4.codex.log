+        straight = True
+        max_len = 0
+        total = 0
+        for comp in comps:
+            rows = {r for r, _ in comp}
+            cols = {c for _, c in comp}
+            if len(rows) != 1 and len(cols) != 1:
+                straight = False
+                break
+            max_len = max(max_len, len(comp))
+            total += len(comp)
