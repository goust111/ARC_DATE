+    if not all(_piece_valid(mask) for mask in masks):
+        return False
+    non_rect = sum(not _mask_is_rectangle(mask) for mask in masks)
+    need_non_rect = 1 if n <= 3 else 2
+    return non_rect >= need_non_rect
