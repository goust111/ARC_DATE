+
+    patches = _piece_patches(labels, colors)
+    inp = _scatter_input(patches, (target_h, target_w))
+    if inp is None:
+        return None
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
