+        run = random.randint(1, min(3, length))
+        start = random.randint(int(seg["c0"]), int(seg["c1"]) - run + 1)
+        donor = random.choice(("top", "bottom"))
+        if donor == "top":
+            donor_id = int(seg["a"])
+            recv_id = int(seg["b"])
+            cells = [(int(seg["r"]), c) for c in range(start, start + run)]
+        else:
+            donor_id = int(seg["b"])
+            recv_id = int(seg["a"])
