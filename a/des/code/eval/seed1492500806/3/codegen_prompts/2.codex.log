+        ok = True
+        for patch in sorted(patches, key=lambda p: (-p.shape[0] * p.shape[1], -p.shape[0], -p.shape[1])):
+            ph, pw = patch.shape
+            candidates: list[tuple[int, int]] = []
+            for r0 in range(1, gh - ph - 1):
