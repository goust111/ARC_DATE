+def _render_solution(pieces: list[dict], target_shape: tuple[int, int], placements: dict[int, tuple[int, int]]) -> np.ndarray:
+    h, w = target_shape
+    out = np.full((h, w), BLACK, dtype=int)
+    for pi, piece in enumerate(pieces):
+        r0, c0 = placements[pi]
+        for dr, dc in piece["coords"]:
