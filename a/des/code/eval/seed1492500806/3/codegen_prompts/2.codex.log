+def _boundary_segments(labels: np.ndarray) -> list[dict]:
+    h, w = labels.shape
+    segs: list[dict] = []
+    for c in range(w - 1):
+        r = 0
+        while r < h:
+            left = int(labels[r, c])
+            right = int(labels[r, c + 1])
+            if left == right:
+                r += 1
