+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+AZURE = 8
+PIECE_COLORS = (1, 2, 3, 4, 6, 7, 9)
+
+TARGET_H_RANGE = (5, 8)
+TARGET_W_RANGE = (5, 9)
+PIECE_COUNT_RANGE = (3, 5)
+MIN_PIECE_AREA = 4
+GENERATION_RETRIES = 500
+CANVAS_MIN = 20
+CANVAS_MAX = 30
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((int(cr), int(cc)))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((int(nr), int(nc)))
+            out.append(comp)
+    return out
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return np.zeros((0, 0), dtype=bool)
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].copy()
+
+
+def _mask_connected(mask: np.ndarray) -> bool:
+    comps = _components(mask.astype(bool))
+    return len(comps) == 1
+
+
+def _mask_has_hole(mask: np.ndarray) -> bool:
+    inv = ~mask.astype(bool)
+    if not inv.any():
+        return False
+    h, w = inv.shape
+    seen = np.zeros_like(inv, dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if inv[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((int(r), int(c)))
+    for c in range(w):
+        for r in (0, h - 1):
+            if inv[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((int(r), int(c)))
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and inv[nr, nc] and not seen[nr, nc]:
