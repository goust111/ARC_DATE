+        start = random.randint(int(seg["r0"]), int(seg["r1"]) - run + 1)
+        donor = random.choice(("left", "right"))
+        if donor == "left":
+            donor_id = int(seg["a"])
+            recv_id = int(seg["b"])
+            cells = [(r, int(seg["c"])) for r in range(start, start + run)]
+        else:
+            donor_id = int(seg["b"])
+            recv_id = int(seg["a"])
+            cells = [(r, int(seg["c"]) + 1) for r in range(start, start + run)]
