+def _extract_legend(grid: np.ndarray) -> tuple[dict[int, int], set[tuple[int, int]]]:
+    h, w = grid.shape
+    assert w >= LEGEND_WIDTH
+
+    mapping: dict[int, int] = {}
+    legend_cells: set[tuple[int, int]] = set()
+    r = 0
