+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+FRAME_COLOR = 5
+SPRITE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+MAX_GENERATION_ATTEMPTS = 500
+PAIR_COUNT_OPTIONS = (2, 3)
+
+
+def _mask(rows: Iterable[str]) -> np.ndarray:
+    return np.array([[ch == "1" for ch in row] for row in rows], dtype=bool)
+
+
+SPRITE_PATTERNS = (
+    _mask(["111"]),
+    _mask(["1", "1", "1"]),
+    _mask(["11", "11"]),
+    _mask(["111", "111"]),
+    _mask(["111", "010"]),
+    _mask(["110", "011"]),
+    _mask(["111", "110"]),
+    _mask(["111", "011"]),
+    _mask(["11", "11", "10"]),
+    _mask(["11", "11", "01"]),
+    _mask(["010", "111", "010"]),
+    _mask(["111", "111", "010"]),
+    _mask(["010", "111", "111"]),
+)
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < h:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < w:
+        out.append((r, c + 1))
+    return out
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _center_from_bbox(bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    return (r0 + r1) // 2, (c0 + c1) // 2
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[dict]:
+    h, w = grid.shape
+    mask = grid == color
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": arr,
+                    "bbox": _bbox(arr),
+                }
+            )
+    comps.sort(key=lambda comp: comp["bbox"])
+    return comps
+
+
+def _is_frame_component(
+    grid: np.ndarray,
+    comp: dict,
+    color: int,
+    bg: int,
+) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    if int(comp["coords"].shape[0]) != 2 * (h + w) - 4:
+        return False
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return bool(np.all(patch[border] == color) and np.all(patch[~border] == bg))
+
+
+def _l_path(
+    start: tuple[int, int],
+    end: tuple[int, int],
+) -> list[tuple[int, int]]:
+    r0, c0 = start
+    r1, c1 = end
+    out: list[tuple[int, int]] = []
+    dc = 1 if c1 >= c0 else -1
+    for c in range(c0, c1 + dc, dc):
+        out.append((r0, c))
+    dr = 1 if r1 >= r0 else -1
+    for r in range(r0 + dr, r1 + dr, dr):
+        out.append((r, c1))
+    return out
+
+
+def _parse_grid(grid: np.ndarray) -> tuple[np.ndarray, int, int, np.ndarray, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    bg = _bg_color(g)
+    colors = [int(color) for color in np.unique(g) if int(color) != bg]
+    assert colors
+
+    comps_by_color = {color: _components_of_color(g, color) for color in colors}
+    frame_colors = [
+        color
+        for color, comps in comps_by_color.items()
+        if comps and all(_is_frame_component(g, comp, color, bg) for comp in comps)
+    ]
+    assert len(frame_colors) == 1
+    frame_color = frame_colors[0]
+
+    interiors = np.zeros_like(g, dtype=bool)
+    for comp in comps_by_color[frame_color]:
+        r0, c0, r1, c1 = comp["bbox"]
+        interiors[r0 + 1 : r1, c0 + 1 : c1] = True
+
+    pairs: list[dict] = []
+    for color, comps in comps_by_color.items():
+        if color == frame_color:
+            continue
+        assert len(comps) == 2
+        ordered = sorted(
+            comps,
+            key=lambda comp: (_center_from_bbox(comp["bbox"]), comp["bbox"]),
+        )
+        start = _center_from_bbox(ordered[0]["bbox"])
+        end = _center_from_bbox(ordered[1]["bbox"])
+        pairs.append({"color": color, "start": start, "end": end})
+
+    assert pairs
+    return g, bg, frame_color, interiors, pairs
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Reveal each same-color pair's horizontal-then-vertical path only inside grey frame interiors."""
+    g, bg, _frame_color, interiors, pairs = _parse_grid(grid)
+    out = g.copy()
+    for pair in pairs:
+        for r, c in _l_path(pair["start"], pair["end"]):
+            if interiors[r, c] and g[r, c] == bg:
+                out[r, c] = pair["color"]
+    return out
+
+
+def _cells_from_mask(
+    center: tuple[int, int],
+    mask: np.ndarray,
+) -> tuple[list[tuple[int, int]], tuple[int, int, int, int]]:
+    h, w = mask.shape
+    top = center[0] - (h - 1) // 2
+    left = center[1] - (w - 1) // 2
+    coords: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c]:
+                coords.append((top + r, left + c))
+    return coords, (top, left, top + h - 1, left + w - 1)
+
+
+def _coords_fit(
+    coords: list[tuple[int, int]],
+    shape: tuple[int, int],
+    col_band: tuple[int, int],
+    occupied: np.ndarray,
+) -> bool:
+    h, w = shape
+    c0, c1 = col_band
+    for r, c in coords:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        if not (c0 <= c <= c1):
+            return False
+        if occupied[r, c]:
+            return False
+    return True
+
+
+def _draw_frame(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    outer_bbox: tuple[int, int, int, int],
+) -> None:
+    r0, c0, r1, c1 = outer_bbox
+    h, w = grid.shape
+    grid[r0, c0 : c1 + 1] = FRAME_COLOR
+    grid[r1, c0 : c1 + 1] = FRAME_COLOR
+    grid[r0 : r1 + 1, c0] = FRAME_COLOR
+    grid[r0 : r1 + 1, c1] = FRAME_COLOR
+    br0 = max(0, r0 - 1)
+    bc0 = max(0, c0 - 1)
+    br1 = min(h - 1, r1 + 1)
+    bc1 = min(w - 1, c1 + 1)
+    blocked[br0 : br1 + 1, bc0 : bc1 + 1] = True
+
+
+def _place_horizontal_frame(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    row: int,
+    open_cols: list[int],
+    col_band: tuple[int, int],
+) -> bool:
+    h, _w = grid.shape
+    if len(open_cols) < 2:
+        return False
+    for _ in range(100):
+        inner_w = random.randint(2, min(4, len(open_cols)))
+        start_idx = random.randint(0, len(open_cols) - inner_w)
