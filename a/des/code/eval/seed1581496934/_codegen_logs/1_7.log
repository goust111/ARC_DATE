+
+def _mask(rows: Iterable[str]) -> np.ndarray:
+    return np.array([[ch == "1" for ch in row] for row in rows], dtype=bool)
+
+
+SPRITE_PATTERNS = (
+    _mask(["111"]),
+    _mask(["1", "1", "1"]),
+    _mask(["11", "11"]),
+    _mask(["111", "111"]),
+    _mask(["111", "010"]),
+    _mask(["110", "011"]),
+    _mask(["111", "110"]),
+    _mask(["111", "011"]),
+    _mask(["11", "11", "10"]),
+    _mask(["11", "11", "01"]),
+    _mask(["010", "111", "010"]),
+    _mask(["111", "111", "010"]),
