+        return True
+    return False
+
+
+def _place_decoy_frame(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    path_mask: np.ndarray,
+) -> bool:
+    h, w = grid.shape
+    for _ in range(100):
+        inner_h = random.randint(2, 4)
+        inner_w = random.randint(2, 5)
+        if h - inner_h - 2 < 1 or w - inner_w - 2 < 1:
+            return False
