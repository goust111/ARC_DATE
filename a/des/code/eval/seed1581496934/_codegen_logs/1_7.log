+    _mask(["111", "011"]),
+    _mask(["11", "11", "10"]),
+    _mask(["11", "11", "01"]),
+    _mask(["010", "111", "010"]),
+    _mask(["111", "111", "010"]),
+    _mask(["010", "111", "111"]),
+)
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < h:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < w:
+        out.append((r, c + 1))
+    return out
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _center_from_bbox(bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    return (r0 + r1) // 2, (c0 + c1) // 2
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[dict]:
+    h, w = grid.shape
+    mask = grid == color
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": arr,
+                    "bbox": _bbox(arr),
+                }
+            )
+    comps.sort(key=lambda comp: comp["bbox"])
+    return comps
+
+
+def _is_frame_component(
+    grid: np.ndarray,
+    comp: dict,
+    color: int,
+    bg: int,
+) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    if int(comp["coords"].shape[0]) != 2 * (h + w) - 4:
+        return False
