+def _l_path(
+    start: tuple[int, int],
+    end: tuple[int, int],
+) -> list[tuple[int, int]]:
+    r0, c0 = start
+    r1, c1 = end
+    out: list[tuple[int, int]] = []
+    dc = 1 if c1 >= c0 else -1
+    for c in range(c0, c1 + dc, dc):
+        out.append((r0, c))
+    dr = 1 if r1 >= r0 else -1
+    for r in range(r0 + dr, r1 + dr, dr):
+        out.append((r, c1))
+    return out
