+def _is_frame_component(
+    grid: np.ndarray,
+    comp: dict,
+    color: int,
+    bg: int,
+) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    if int(comp["coords"].shape[0]) != 2 * (h + w) - 4:
+        return False
