+        ic0 = random.randint(1, w - inner_w - 1)
+        ir1 = ir0 + inner_h - 1
+        ic1 = ic0 + inner_w - 1
+        outer = (ir0 - 1, ic0 - 1, ir1 + 1, ic1 + 1)
+        if blocked[outer[0] : outer[2] + 1, outer[1] : outer[3] + 1].any():
+            continue
+        if path_mask[outer[0] : outer[2] + 1, outer[1] : outer[3] + 1].any():
