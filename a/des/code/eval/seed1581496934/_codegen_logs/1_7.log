+SPRITE_PATTERNS = (
+    _mask(["111"]),
+    _mask(["1", "1", "1"]),
+    _mask(["11", "11"]),
+    _mask(["111", "111"]),
+    _mask(["111", "010"]),
+    _mask(["110", "011"]),
+    _mask(["111", "110"]),
+    _mask(["111", "011"]),
+    _mask(["11", "11", "10"]),
+    _mask(["11", "11", "01"]),
+    _mask(["010", "111", "010"]),
+    _mask(["111", "111", "010"]),
+    _mask(["010", "111", "111"]),
+)
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < h:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < w:
+        out.append((r, c + 1))
+    return out
