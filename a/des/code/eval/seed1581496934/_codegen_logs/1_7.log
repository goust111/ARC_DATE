+    for color, comps in comps_by_color.items():
+        if color == frame_color:
+            continue
+        assert len(comps) == 2
+        ordered = sorted(
+            comps,
+            key=lambda comp: (_center_from_bbox(comp["bbox"]), comp["bbox"]),
