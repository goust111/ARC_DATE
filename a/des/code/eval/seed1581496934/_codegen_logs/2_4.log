+    for (rs0, rs1), (cs0, cs1) in HALF_BLOCKS[side]:
+        patch = out[r0 + rs0 : r0 + rs1, c0 + cs0 : c0 + cs1]
+        patch[patch == int(lock["color"])] = int(fill_color)
+
