+
+BLACK = 0
+LOCK_COLOR = 5
+KEY_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS = ("up", "down", "left", "right")
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+RNG = np.random.default_rng()
+
+
+def _build_lock_masks() -> dict[str, np.ndarray]:
+    masks: dict[str, np.ndarray] = {}
+    for direction in DIRS:
+        mask = np.ones((5, 5), dtype=bool)
+        if direction == "up":
+            mask[0, 1:4] = False
+        elif direction == "down":
+            mask[4, 1:4] = False
+        elif direction == "left":
+            mask[1:4, 0] = False
+        else:
+            mask[1:4, 4] = False
+        masks[direction] = mask
+    return masks
+
+
+def _build_key_masks() -> dict[str, np.ndarray]:
+    masks: dict[str, np.ndarray] = {}
+
+    up = np.zeros((4, 3), dtype=bool)
+    up[1:, :] = True
+    up[0, 1] = True
+    masks["up"] = up
+
+    down = np.zeros((4, 3), dtype=bool)
+    down[:3, :] = True
+    down[3, 1] = True
+    masks["down"] = down
+
+    left = np.zeros((3, 4), dtype=bool)
+    left[:, 1:] = True
+    left[1, 0] = True
+    masks["left"] = left
+
+    right = np.zeros((3, 4), dtype=bool)
+    right[:, :3] = True
+    right[1, 3] = True
+    masks["right"] = right
+
+    return masks
