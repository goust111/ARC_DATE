+def _recolor_half(out: np.ndarray, lock: dict, fill_color: int, side: str) -> None:
+    r0, c0, _, _ = map(int, lock["bbox"])
+    for (rs0, rs1), (cs0, cs1) in HALF_BLOCKS[side]:
+        patch = out[r0 + rs0 : r0 + rs1, c0 + cs0 : c0 + cs1]
