+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+
+            pts = np.array(coords, dtype=int)
+            r0 = int(pts[:, 0].min())
+            c0 = int(pts[:, 1].min())
+            r1 = int(pts[:, 0].max())
+            c1 = int(pts[:, 1].max())
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            mask[pts[:, 0] - r0, pts[:, 1] - c0] = True
+            comps.append(
+                {
+                    "color": color,
+                    "coords": pts,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": mask,
+                    "area": int(mask.sum()),
+                    "center": pts.mean(axis=0),
+                }
+            )
