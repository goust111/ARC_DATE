+    "down": (((3, 5), (0, 2)), ((3, 5), (3, 5))),
+    "left": (((0, 2), (0, 2)), ((3, 5), (0, 2))),
+    "right": (((0, 2), (3, 5)), ((3, 5), (3, 5))),
