+    keys = sorted(keys, key=lambda obj: (obj["bbox"], int(obj["color"])))
+    n = len(locks)
+    if n == 0:
+        return []
+
+    dist = [[_distance_sq(locks[i], keys[j]) for j in range(n)] for i in range(n)]
+
+    @lru_cache(maxsize=None)
+    def solve(i: int, used_mask: int) -> tuple[float, tuple[int, ...]]:
+        if i == n:
