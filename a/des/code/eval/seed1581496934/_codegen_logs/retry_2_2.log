import random
from collections import defaultdict, deque

import numpy as np


BG = 0
PALETTE = tuple(range(1, 10))

PAIR_COUNT_RANGE = (2, 4)
RECT_H_RANGE = (4, 7)
RECT_W_RANGE = (4, 7)
MAX_OUTPUT_SIDE = 30
GRID_SIDE_RANGE = (18, 30)

PARTITION_ATTEMPTS = 250
PARTITION_MUTATION_TRIES = 40
PLACEMENT_ATTEMPTS = 250
GENERATION_ATTEMPTS = 400


def _neighbors4(r: int, c: int, h: int, w: int):
    if r > 0:
        yield r - 1, c
    if r + 1 < h:
        yield r + 1, c
    if c > 0:
        yield r, c - 1
    if c + 1 < w:
        yield r, c + 1


def _component_cells(mask: np.ndarray) -> list[tuple[int, int]]:
    h, w = mask.shape
    pts = np.argwhere(mask)
    if pts.size == 0:
        return []
    start = tuple(map(int, pts[0]))
    q = deque([start])
    seen = {start}
    out: list[tuple[int, int]] = []
    while q:
        r, c = q.popleft()
        out.append((r, c))
        for nr, nc in _neighbors4(r, c, h, w):
            if mask[nr, nc] and (nr, nc) not in seen:
                seen.add((nr, nc))
                q.append((nr, nc))
    return out


def _is_connected(mask: np.ndarray) -> bool:
    pts = np.argwhere(mask)
    return pts.size > 0 and len(_component_cells(mask)) == int(mask.sum())


def _full_bbox(mask: np.ndarray) -> bool:
    pts = np.argwhere(mask)
    if pts.size == 0:
        return False
    rs = pts[:, 0]
    cs = pts[:, 1]
    h, w = mask.shape
    return (
        int(rs.min()) == 0
        and int(rs.max()) == h - 1
        and int(cs.min()) == 0
        and int(cs.max()) == w - 1
    )


def _valid_partition(mask: np.ndarray) -> bool:
    other = ~mask
    return (
        0 < int(mask.sum()) < mask.size
        and _is_connected(mask)
        and _is_connected(other)
        and _full_bbox(mask)
        and _full_bbox(other)
    )


def _bbox_of_cells(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
    rs = [r for r, _ in cells]
    cs = [c for _, c in cells]
    return min(rs), min(cs), max(rs), max(cs)


def _hamiltonian_cycle_even_rows(h: int, w: int) -> list[tuple[int, int]]:
    cycle = [(0, 0)]
    for c in range(1, w):
        cycle.append((0, c))
    for r in range(1, h):
        if r % 2 == 1:
            cycle.append((r, w - 1))
            for c in range(w - 2, 0, -1):
                cycle.append((r, c))
        else:
            cycle.append((r, 1))
            for c in range(2, w):
                cycle.append((r, c))
    for r in range(h - 1, 0, -1):
        cycle.append((r, 0))
    return cycle


def _hamiltonian_cycle(h: int, w: int) -> list[tuple[int, int]] | None:
    if h >= 2 and w >= 2 and h % 2 == 0:
        cycle = _hamiltonian_cycle_even_rows(h, w)
    elif h >= 2 and w >= 2 and w % 2 == 0:
        cycle = [(c, r) for r, c in _hamiltonian_cycle_even_rows(w, h)]
    else:
        return None

    if len(cycle) != h * w or len(set(cycle)) != h * w:
        raise AssertionError("cycle construction must visit every cell exactly once")
    for i in range(len(cycle)):
        r0, c0 = cycle[i]
        r1, c1 = cycle[(i + 1) % len(cycle)]
        if abs(r0 - r1) + abs(c0 - c1) != 1:
            raise AssertionError("cycle construction must be 4-connected")
    return cycle


def _adjacent_cells(mask: np.ndarray, value: bool) -> list[tuple[int, int]]:
    h, w = mask.shape
    out: list[tuple[int, int]] = []
    for r in range(h):
        for c in range(w):
            if bool(mask[r, c]) != value:
                continue
            for nr, nc in _neighbors4(r, c, h, w):
                if bool(mask[nr, nc]) != value:
                    out.append((r, c))
                    break
    return out


def _mutate_partition(mask: np.ndarray) -> np.ndarray:
    best = mask
    for _ in range(PARTITION_MUTATION_TRIES):
        grow = random.random() < 0.5
        candidates = _adjacent_cells(~best if grow else best, True)
        random.shuffle(candidates)
        for r, c in candidates:
            trial = best.copy()
            trial[r, c] = grow
            if _valid_partition(trial):
                return trial
    return best


def _make_partition(h: int, w: int) -> tuple[np.ndarray, np.ndarray] | None:
    for _ in range(PARTITION_ATTEMPTS):
        mask = np.zeros((h, w), dtype=bool)
        row_modes: list[int] = []
        for r in range(h):
            if r == 0:
                mode = random.randint(0, 1)
            elif r == h - 1:
                mode = 1 - row_modes[0]
            else:
                if random.random() < 0.55:
                    mode = 1 - row_modes[-1]
                else:
                    mode = random.randint(0, 1)
            row_modes.append(mode)

            cut = random.randint(1, w - 2)
            if mode == 0:
                mask[r, : cut + 1] = True
            else:
                mask[r, cut:] = True

        other = ~mask
        if not (_full_bbox(mask) and _full_bbox(other)):
            continue
        if np.any(mask.all(axis=0)) or np.any(other.all(axis=0)):
            continue
        if np.any(mask.all(axis=1)) or np.any(other.all(axis=1)):
            continue
        if min(int(mask.sum()), int(other.sum())) < max(4, min(h, w) - 1):
            continue
        return mask, other
    return None


def _extract_fragments(grid: np.ndarray) -> list[dict]:
    g = np.asarray(grid, dtype=int)
    fragments: list[dict] = []
    for color in sorted(int(v) for v in np.unique(g) if int(v) != BG):
        pts = np.argwhere(g == color)
        cells = [(int(r), int(c)) for r, c in pts]
        r0, c0, r1, c1 = _bbox_of_cells(cells)
        mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
        for rr, cc in cells:
            mask[rr - r0, cc - c0] = True
        fragments.append(
            {
                "color": color,
                "cells": cells,
                "bbox": (r0, c0, r1, c1),
                "shape": mask,
                "anchor": (r0, c0),
                "area": len(cells),
            }
        )
    return fragments


def _pair_fragments(fragments: list[dict]) -> list[dict]:
    groups: dict[tuple[int, int], list[int]] = defaultdict(list)
    for idx, frag in enumerate(fragments):
        groups[tuple(map(int, frag["shape"].shape))].append(idx)

    pairs: list[dict] = []
    for dims, idxs in groups.items():
        sig_to_indices: dict[bytes, list[int]] = defaultdict(list)
        for idx in idxs:
            sig_to_indices[fragments[idx]["shape"].tobytes()].append(idx)

        used: set[int] = set()
        full = np.ones(dims, dtype=bool)
        for idx in sorted(idxs, key=lambda i: fragments[i]["anchor"]):
            if idx in used:
                continue
            need = np.logical_xor(full, fragments[idx]["shape"])
            candidates = [
                j
                for j in sig_to_indices.get(need.tobytes(), [])
                if j not in used and j != idx
            ]
            if not candidates:
                raise AssertionError("missing complementary fragment")
            mate = min(candidates, key=lambda j: fragments[j]["anchor"])
            used.add(idx)
            used.add(mate)

            a = fragments[idx]
            b = fragments[mate]
            h, w = dims
            rect = np.zeros((h, w), dtype=int)
            rect[a["shape"]] = int(a["color"])
            rect[b["shape"]] = int(b["color"])
            pairs.append(
                {
                    "rect": rect,
                    "h": h,
                    "w": w,
                    "area": h * w,
                    "anchor": min(a["anchor"], b["anchor"]),
                }
            )

        if len(used) != len(idxs):
            raise AssertionError("unpaired fragment remained in dimension group")

    return pairs



