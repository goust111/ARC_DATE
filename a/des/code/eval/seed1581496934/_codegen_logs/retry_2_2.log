from __future__ import annotations

import random

import numpy as np


BG = 0
PALETTE = tuple(range(1, 10))

# Generator configuration.
GRID_H_BOUNDS = (10, 18)
GRID_W_BOUNDS = (10, 18)
PAIR_COUNT_BOUNDS = (2, 5)
MAX_GENERATION_ATTEMPTS = 600
MAX_LAYOUT_ATTEMPTS = 200
MAX_SAMPLE_TRIES = 120
MAX_INTERSECTIONS = 6
MAX_FILL_RATIO = 0.42


def _path_cells(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
    """Reading-order endpoint A goes horizontal first, then vertical to B."""
    r0, c0 = map(int, a)
    r1, c1 = map(int, b)
    assert r0 != r1 and c0 != c1

    step_c = 1 if c1 > c0 else -1
    cells = [(r0, c) for c in range(c0, c1 + step_c, step_c)]

    step_r = 1 if r1 > r0 else -1
    cells.extend((r, c1) for r in range(r0 + step_r, r1 + step_r, step_r))
    return cells


def _extract_pairs(grid: np.ndarray) -> list[dict]:
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    pairs: list[dict] = []
    used_rows: set[int] = set()
    used_cols: set[int] = set()
    colors = [int(color) for color in np.unique(g) if int(color) != BG]
    assert colors, "expected at least one non-background color"

    for color in colors:
        pts = np.argwhere(g == int(color))
        assert int(pts.shape[0]) == 2, "each color must occur exactly twice"
        coords = sorted((int(r), int(c)) for r, c in pts)
        a, b = coords
        assert int(a[0]) != int(b[0]) and int(a[1]) != int(b[1]), "endpoints must differ in row and column"

        for r, c in (a, b):
            assert r not in used_rows, "no two endpoints may share a row"
            assert c not in used_cols, "no two endpoints may share a column"
            used_rows.add(int(r))
            used_cols.add(int(c))

        area = abs(int(a[0]) - int(b[0])) * abs(int(a[1]) - int(b[1]))
        pairs.append(
            {
                "color": int(color),
                "a": (int(a[0]), int(a[1])),
                "b": (int(b[0]), int(b[1])),
                "area": int(area),
            }
        )

    return pairs


def _ordered_pairs(grid: np.ndarray) -> list[dict]:
    pairs = _extract_pairs(grid)
    return sorted(
        pairs,
        key=lambda item: (
            int(item["area"]),
            int(item["a"][0]),
            int(item["a"][1]),
            int(item["b"][0]),
            int(item["b"][1]),
        ),
    )


def main(grid: np.ndarray) -> np.ndarray:
    """
    Connect each same-colored endpoint pair with an L path.

    Unlabeled endpoints are disambiguated by reading order: A is the earlier
    endpoint in (row, col) order, so the path always goes horizontal on A's
    row first, then vertical on B's column.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    out = np.full_like(g, BG)
    for pair in _ordered_pairs(g):
        for r, c in _path_cells(pair["a"], pair["b"]):
            if int(out[r, c]) == BG:
                out[r, c] = int(pair["color"])
    return out


def _intersection_cells(specs: list[dict]) -> set[tuple[int, int]]:
    cells: set[tuple[int, int]] = set()
    for i, left in enumerate(specs):
        hr = int(left["a"][0])
        hc0 = int(left["a"][1])
        hc1 = int(left["b"][1])
        lo = min(int(hc0), int(hc1))
        hi = max(int(hc0), int(hc1))
        for j, right in enumerate(specs):
            if i == j:
                continue
            vr0 = int(right["a"][0])
            vr1 = int(right["b"][0])
            vc = int(right["b"][1])
            if int(vr0) < int(hr) < int(vr1) and int(lo) < int(vc) < int(hi):
                cells.add((int(hr), int(vc)))
    return cells


def _sample_shape() -> tuple[int, int, int] | None:
    h = random.randint(*GRID_H_BOUNDS)
    w = random.randint(*GRID_W_BOUNDS)
    max_pairs = min(int(PAIR_COUNT_BOUNDS[1]), (h - 2) // 2, (w - 2) // 2)
    if max_pairs < int(PAIR_COUNT_BOUNDS[0]):
        return None
    n_pairs = random.randint(int(PAIR_COUNT_BOUNDS[0]), int(max_pairs))
    return int(h), int(w), int(n_pairs)


def _orientation_bits(n_pairs: int) -> list[int]:
    bits = [random.randint(0, 1) for _ in range(n_pairs)]
    if n_pairs >= 2 and len(set(bits)) == 1:
        bits[0] ^= 1
    return bits


def _make_cross_layout(rows: list[int], cols: list[int], n_pairs: int) -> tuple[list[int], list[int]]:
    top_rows = rows[:n_pairs]
    bottom_rows = rows[n_pairs:]
    random.shuffle(bottom_rows)

    left_cols = cols[:n_pairs]
    right_cols = cols[n_pairs:]
    random.shuffle(left_cols)
    random.shuffle(right_cols)
    bits = _orientation_bits(n_pairs)

    a_cols: list[int] = []
    b_cols: list[int] = []
    for i in range(n_pairs):
        if bits[i] == 0:
            a_cols.append(int(left_cols[i]))
            b_cols.append(int(right_cols[i]))
        else:
            a_cols.append(int(right_cols[i]))
            b_cols.append(int(left_cols[i]))
    return [int(r) for r in top_rows], [int(r) for r in bottom_rows], a_cols, b_cols


def _make_separate_layout(rows: list[int], cols: list[int], n_pairs: int) -> tuple[list[int], list[int]]:
    top_rows = rows[:n_pairs]
    bottom_rows = rows[n_pairs:]
    random.shuffle(bottom_rows)

    col_pairs = [(int(cols[2 * i]), int(cols[2 * i + 1])) for i in range(n_pairs)]
    random.shuffle(col_pairs)
    bits = _orientation_bits(n_pairs)

    a_cols: list[int] = []
    b_cols: list[int] = []
    for i, (c0, c1) in enumerate(col_pairs):
        if bits[i] == 0:
            a_cols.append(int(c0))
            b_cols.append(int(c1))
        else:
            a_cols.append(int(c1))
            b_cols.append(int(c0))
    return [int(r) for r in top_rows], [int(r) for r in bottom_rows], a_cols, b_cols


def _layout_specs(h: int, w: int, n_pairs: int, require_crossing: bool) -> list[dict] | None:
    row_pool = list(range(1, h - 1))
    col_pool = list(range(1, w - 1))
    colors = random.sample(PALETTE, n_pairs)

    for _ in range(MAX_LAYOUT_ATTEMPTS):
        rows = sorted(random.sample(row_pool, 2 * n_pairs))
        cols = sorted(random.sample(col_pool, 2 * n_pairs))

        if require_crossing:
            top_rows, bottom_rows, a_cols, b_cols = _make_cross_layout(rows, cols, n_pairs)
        else:
            top_rows, bottom_rows, a_cols, b_cols = _make_separate_layout(rows, cols, n_pairs)

        specs = []
        for i, color in enumerate(colors):
            top = int(top_rows[i])
            bottom = int(bottom_rows[i])
            a_col = int(a_cols[i])
            b_col = int(b_cols[i])
            specs.append(
                {
                    "color": int(color),
                    "a": (int(top), int(a_col)),
                    "b": (int(bottom), int(b_col)),
                    "area": int((bottom - top) * abs(b_col - a_col)),
                }
            )

        areas = [int(spec["area"]) for spec in specs]
        if any(area <= 0 for area in areas):
            continue
        if len(set(areas)) != len(areas):
            continue

        if any(int(spec["b"][0]) - int(spec["a"][0]) < 2 for spec in specs):
            continue

        if require_crossing and tuple(np.argsort(np.array(areas, dtype=int)).tolist()) == tuple(range(n_pairs)) and random.random() < 0.6:
            continue

        intersections = _intersection_cells(specs)
        if require_crossing:
            if not intersections or len(intersections) > MAX_INTERSECTIONS:
                continue
        elif intersections:
            continue

        return specs

    return None


def _grid_from_specs(h: int, w: int, specs: list[dict]) -> np.ndarray:
    grid = np.full((h, w), BG, dtype=int)
    for spec in specs:
        ar, ac = spec["a"]
        br, bc = spec["b"]
        color = int(spec["color"])
        assert int(grid[ar, ac]) == BG and int(grid[br, bc]) == BG
        grid[ar, ac] = int(color)
        grid[br, bc] = int(color)
    return grid


