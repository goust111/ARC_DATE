+
+    legend_items = list(mix_rules.items())
+    random.shuffle(legend_items)
+    legend_rows_data: list[tuple[int, int, int]] = []
+    for pair, result in legend_items:
+        a, b = tuple(pair)
+        if random.random() < 0.5:
