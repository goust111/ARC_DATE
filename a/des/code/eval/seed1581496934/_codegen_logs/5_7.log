                out[r, c] = color
        else:
            color = int(node_colors[edge["src"]])
            for r, c in edge["pixels_dir"]:
                out[r, c] = color
    return out


def _build_graph() -> tuple[
    set[tuple[int, int]],
    dict[tuple[int, int], list[tuple[int, int]]],
