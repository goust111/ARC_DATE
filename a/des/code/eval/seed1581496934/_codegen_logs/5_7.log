+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+AZURE = 8
+NODE_SIZE = 2
+VISIBLE_COLORS = tuple(color for color in range(1, 10) if color != GREY)
+INPUT_SIDES = {"left", "top"}
+OUTPUT_SIDES = {"right", "bottom"}
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GEN_RETRIES = 400
+ROW_COUNT_RANGE = (3, 5)
