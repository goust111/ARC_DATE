+    base_r = random.randint(0, rows - 2)
+    base_c = random.randint(0, cols - 3)
+    a = (base_r, base_c)
+    b = (base_r + 1, base_c)
+    c = (base_r, base_c + 1)
+    d = (base_r + 1, base_c + 1)
+    e = (base_r + 1, base_c + 2)
