+
+def _components(mask: np.ndarray) -> list[dict]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            r0, c0 = arr.min(axis=0)
+            r1, c1 = arr.max(axis=0)
+            comps.append(
+                {
+                    "coords": arr,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def _touch_side(bbox: tuple[int, int, int, int], cell: tuple[int, int]) -> str:
+    r0, c0, r1, c1 = bbox
+    r, c = cell
+    if c == c0 - 1 and r0 <= r <= r1:
+        return "left"
+    if c == c1 + 1 and r0 <= r <= r1:
+        return "right"
+    if r == r0 - 1 and c0 <= c <= c1:
+        return "top"
+    if r == r1 + 1 and c0 <= c <= c1:
+        return "bottom"
+    raise AssertionError(f"cell {cell} does not touch bbox {bbox}")
