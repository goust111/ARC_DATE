+        assert int(out[exit_r, exit_c]) == GREY, "exit must be a grey border cell"
+        out[exit_r, exit_c] = mirror_color
+    return out
+
+
+def _sample_room_spec(rng: random.Random, combo: tuple[str, tuple[int, int]]) -> dict:
+    orient, incoming = combo
