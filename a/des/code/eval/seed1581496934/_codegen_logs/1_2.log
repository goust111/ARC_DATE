+    mirror_color, entrance_color = rng.sample(PALETTE, 2)
+    room = np.full((room_h, room_w), BG, dtype=int)
+    room[0, :] = GREY
+    room[-1, :] = GREY
+    room[:, 0] = GREY
+    room[:, -1] = GREY
+    for r, c in mirror:
