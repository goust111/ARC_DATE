+    door_positions = frozenset(
+        (int(r - r0), int(c - c0))
+        for r, c in np.argwhere(local == DOOR)
+    )
+    return MazeSpec(
+        grid=g,
+        local=local.copy(),
+        offset=(r0, c0),
+        entrances=tuple(entrances),
+        door_positions=door_positions,
+    )
