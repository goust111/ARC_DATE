+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+AZURE = 8
+MAROON = 9
+
+WALL = GREY
+PASSAGE = AZURE
+DOOR = MAROON
+KEY_COLORS = (BLUE, RED, GREEN, YELLOW, MAGENTA)
