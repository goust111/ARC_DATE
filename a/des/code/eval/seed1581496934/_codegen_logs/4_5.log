+def _step(pos: tuple[int, int], dir_idx: int) -> tuple[int, int]:
+    dr, dc = DIRS[dir_idx]
+    return pos[0] + dr, pos[1] + dc
+
+
+def _turn_left(dir_idx: int) -> int:
