+            if not hits:
+                continue
+            hits.sort()
+            best = hits[0][0]
+            winners = [key_idx for step_count, key_idx in hits if step_count == best]
+            if len(hits) == 1:
+                kind = "solo"
+            elif len(winners) == 1:
+                kind = "winner"
+            else:
+                kind = "tie"
+            candidates.append(
+                {
+                    "pos": pos,
+                    "segment": seg_idx,
+                    "kind": kind,
+                    "hits": hits,
+                }
