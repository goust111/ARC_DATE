+    for color, opening in zip(colors, openings):
+        r, c = opening["pos"]
+        side = (int(opening["dir_idx"]) + 2) % 4
+        gr = top + r + DIRS[side][0]
+        gc = left + c + DIRS[side][1]
+        grid[gr, gc] = color
