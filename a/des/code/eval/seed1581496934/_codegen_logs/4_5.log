+def _far_enough(pos: tuple[int, int], chosen: list[dict[str, object]]) -> bool:
+    for other in chosen:
+        orow, ocol = other["pos"]
+        if abs(pos[0] - orow) + abs(pos[1] - ocol) < 4:
