+def _door_candidates(spec: MazeSpec, visit_maps: list[dict[tuple[int, int], int]]) -> list[dict[str, object]]:
+    entrance_set = {ent.pos for ent in spec.entrances}
+    candidates: list[dict[str, object]] = []
