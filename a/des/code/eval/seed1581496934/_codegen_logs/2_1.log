+def _rectangle_border_cells(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    border = set()
+    for c in range(c0, c1 + 1):
+        border.add((r0, c))
+        border.add((r1, c))
+    for r in range(r0 + 1, r1):
