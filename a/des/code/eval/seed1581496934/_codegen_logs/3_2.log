import numpy as np
H=W=8
N=64
FULL=(1<<64)-1

@nb.njit
def comps(mask):
    seen=np.uint64(0)
    cnt=0
    for i in range(N):
        b=np.uint64(1)<<np.uint64(i)
        if (mask & b) and not (seen & b):
            cnt+=1
            frontier=b
            seen |= b
            while frontier:
                nxt=np.uint64(0)
                bits=frontier
                for j in range(N):
                    bj=np.uint64(1)<<np.uint64(j)
                    if bits & bj:
                        r=j//W; c=j%W
                        if r>0: nxt |= np.uint64(1)<<np.uint64((r-1)*W+c)
                        if r+1<H: nxt |= np.uint64(1)<<np.uint64((r+1)*W+c)
                        if c>0: nxt |= np.uint64(1)<<np.uint64(r*W+c-1)
                        if c+1<W: nxt |= np.uint64(1)<<np.uint64(r*W+c+1)
                frontier = (nxt & mask) & ~seen
                seen |= frontier
    return cnt

@nb.njit
def side_count(mask):
    cnt=0
    ok=False
    for c in range(W):
        if mask & (np.uint64(1)<<np.uint64(c)): ok=True; break
    cnt += 1 if ok else 0
    ok=False
    base=(H-1)*W
    for c in range(W):
        if mask & (np.uint64(1)<<np.uint64(base+c)): ok=True; break
    cnt += 1 if ok else 0
    ok=False
    for r in range(H):
        if mask & (np.uint64(1)<<np.uint64(r*W)): ok=True; break
    cnt += 1 if ok else 0
    ok=False
    for r in range(H):
        if mask & (np.uint64(1)<<np.uint64(r*W+W-1)): ok=True; break
    cnt += 1 if ok else 0
    return cnt

@nb.njit
def score(mask):
    comp=(np.uint64(FULL) "'^ mask)
    a=0
    for i in range(N):
        if mask & (np.uint64(1)<<np.uint64(i)): a += 1
    b=N-a
    return -200*(comps(mask)-1)-200*(comps(comp)-1)+30*side_count(mask)+30*side_count(comp)-abs(a-b)

