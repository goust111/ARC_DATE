from z3 import *

def decode(task,w,h):
    arr=[-1]*(w*h)
    i=0
    for ch in task:
        if ch=='W': arr[i]=0; i+=1
        elif ch=='B': arr[i]=1; i+=1
        else: i += ord(ch)-96
    return [arr[r*w:(r+1)*w] for r in range(h)]

def solve(task):
    W=H=6
    clues=decode(task,W,H)
    x=[[Bool(f'x_{task}_{r}_{c}') for c in range(W)] for r in range(H)]
    da=[[Int(f'da_{task}_{r}_{c}') for c in range(W)] for r in range(H)]
    db=[[Int(f'db_{task}_{r}_{c}') for c in range(W)] for r in range(H)]
    s=Solver(); s.set(timeout=10000)
    for r in range(H):
        for c in range(W):
            if clues[r][c]==1: s.add(x[r][c])
            elif clues[r][c]==0: s.add(Not(x[r][c]))
    for r in range(H-1):
        for c in range(W-1):
            vals=[x[r][c],x[r+1][c],x[r][c+1],x[r+1][c+1]]
            s.add(Not(And(*vals)))
            s.add(Or(*vals))
    # find roots from first forced cells if any else corners
    rootA=(0,0); rootB=(0,5)
    s.add(x[rootA[0]][rootA[1]])
    s.add(Not(x[rootB[0]][rootB[1]]))
    N=W*H
    for r in range(H):
        for c in range(W):
            nbr=[(nr,nc) for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)] if 0 <= (nr:=r+dr) < H and 0 <= (nc:=c+dc) < W]
            s.add(If(x[r][c], And(da[r][c]>=0, da[r][c]<N), da[r][c]==-1))
            if (r,c)==rootA:
                s.add(da[r][c]==0)
            else:
                s.add(Implies(x[r][c], Or(*[And(x[nr][nc], da[nr][nc] < da[r][c]) for nr,nc in nbr])))
            s.add(If(Not(x[r][c]), And(db[r][c]>=0, db[r][c]<N), db[r][c]==-1))
            if (r,c)==rootB:
                s.add(db[r][c]==0)
            else:
                s.add(Implies(Not(x[r][c]), Or(*[And(Not(x[nr][nc]), db[nr][nc] < db[r][c]) for nr,nc in nbr])))
    if s.check()"'!=sat:
        return None
    m=s.model()
    return ['"''.join('#' if is_true(m.evaluate(x[r][c])) else '.' for c in range(W)) for r in range(H)]

tasks=['BfBWfBaWBBBaWcWWh','oBdBWWbWaBbWBd','eBbWbWaWbWbWBWdBbBf']
for t in tasks:
    g=solve(t)
    print('task',t)
    print('\\n'.join(g))
    print()
