import random, math
from collections import deque
rows=['........','..#.#...','#.#####.','#.#####.','###.....','##..###.','#.....#.','########']
mask=[[ch=='#' for ch in row] for row in rows]
h=w=8

def comps(mask,val):
    seen=set(); cnt=0
    for r in range(h):
        for c in range(w):
            if mask[r][c]==val and (r,c) not in seen:
                cnt+=1
                q=deque([(r,c)]); seen.add((r,c))
                while q:
                    rr,cc=q.popleft()
                    for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
                        nr,nc=rr+dr,cc+dc
                        if 0<=nr<h and 0<=nc<w and mask[nr][nc]==val and (nr,nc) not in seen:
                            seen.add((nr,nc)); q.append((nr,nc))
    return cnt

def sides(mask,val):
    return [any(mask[0][c]==val for c in range(w)),any(mask[h-1][c]==val for c in range(w)),any(mask[r][0]==val for r in range(h)),any(mask[r][w-1]==val for r in range(h))]

def score(mask):
    a=sum(cell for row in mask for cell in row); b=h*w-a
    sa=sum(sides(mask,True)); sb=sum(sides(mask,False))
    return -300*(comps(mask,True)-1)-300*(comps(mask,False)-1)+50*sa+50*sb-abs(a-b)

def ok(mask):
    return comps(mask,True)==1 and comps(mask,False)==1 and sum(sides(mask,True))==4 and sum(sides(mask,False))==4
best=score(mask); bestm=[row[:] for row in mask]
for step in range(300000):
    # bias edge cells and nearby bridges
    if random.random()<0.7:
        edge=random.choice([(0,random.randrange(w)),(h-1,random.randrange(w)),(random.randrange(h),0),(random.randrange(h),w-1), (1,random.randrange(w)),(h-2,random.randrange(w)),(random.randrange(h),1),(random.randrange(h),w-2)])
        r,c=edge
    else:
        r=random.randrange(h); c=random.randrange(w)
    mask[r][c]=not mask[r][c]
    ns=score(mask)
    if ns>=best or random.random()<0.003:
        if ns>best:
            best=ns; bestm=[row[:] for row in mask]
        if ok(mask):
            print('found',step)
            for row in mask:
                print(''.join('#' if x else '.' for x in row))
            raise SystemExit
    else:
        mask[r][c]=not mask[r][c]
print('best',best,'A',comps(bestm,True),sides(bestm,True),'B',comps(bestm,False),sides(bestm,False))
for row in bestm:
    print(''.join('#' if x else '.' for x in row))
