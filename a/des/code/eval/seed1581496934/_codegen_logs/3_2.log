import random
from collections import deque

def conn(cells,h,w):
    if not cells: return False
    cells=set(cells)
    q=deque([next(iter(cells))]); vis={q[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
            nr,nc=r+dr,c+dc
            if (nr,nc) in cells and (nr,nc) not in vis:
                vis.add((nr,nc)); q.append((nr,nc))
    return len(vis)==len(cells)

def touches(cells,h,w):
    return all([
        any(r==0 for r,c in cells),
        any(r==h-1 for r,c in cells),
        any(c==0 for r,c in cells),
        any(c==w-1 for r,c in cells),
    ])

def random_path(h,w,steps=18):
    start=(0,random.randrange(w))
    path=[start]
    seen={start}
    for _ in range(steps):
        r,c=path[-1]
        moves=[]
        for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
            nr,nc=r+dr,c+dc
            if 0<=nr<h and 0<=nc<w and (nr,nc) not in seen:
                moves.append((nr,nc))
        if not moves: break
        nxt=random.choice(moves)
        path.append(nxt); seen.add(nxt)
    return set(path)

for h,w in [(6,6),(7,7),(6,7)]:
    for _ in range(50000):
        A=random_path(h,w,steps=random.randrange((h+w)//2, h*w//2))
        B={(r,c) for r in range(h) for c in range(w) if (r,c) not in A}
        if touches(A,h,w) and touches(B,h,w) and conn(A,h,w) and conn(B,h,w):
