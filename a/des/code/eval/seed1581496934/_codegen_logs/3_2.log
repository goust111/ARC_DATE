from z3 import *

def attempt(W,H,timeout=10000):
    x=[[Bool(f'x_{r}_{c}') for c in range(W)] for r in range(H)]
    da=[[Int(f'da_{r}_{c}') for c in range(W)] for r in range(H)]
    db=[[Int(f'db_{r}_{c}') for c in range(W)] for r in range(H)]
    ra=[Bool(f'ra_{c}') for c in range(W)]
    rb=[Bool(f'rb_{c}') for c in range(W)]
    s=Solver(); s.set(timeout=timeout)
    # roots on top row for A, bottom row for B
    s.add(PbEq([(ra[c],1) for c in range(W)],1))
    s.add(PbEq([(rb[c],1) for c in range(W)],1))
    for c in range(W):
        s.add(Implies(ra[c], x[0][c]))
        s.add(Implies(rb[c], Not(x[H-1][c])))
    # both colors touch all four sides
    s.add(Or(*[x[0][c] for c in range(W)]), Or(*[Not(x[0][c]) for c in range(W)]))
    s.add(Or(*[x[H-1][c] for c in range(W)]), Or(*[Not(x[H-1][c]) for c in range(W)]))
    s.add(Or(*[x[r][0] for r in range(H)]), Or(*[Not(x[r][0]) for r in range(H)]))
    s.add(Or(*[x[r][W-1] for r in range(H)]), Or(*[Not(x[r][W-1]) for r in range(H)]))
    N=W*H
    for r in range(H):
      for c in range(W):
        nbr=[(nr,nc) for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)] if 0 <= (nr:=r+dr) < H and 0 <= (nc:=c+dc) < W]
        s.add(If(x[r][c], And(da[r][c]>=0, da[r][c]<N), da[r][c]==-1))
        if r==0:
            s.add(Implies(And(x[r][c], Not(ra[c])), Or(*[And(x[nr][nc], da[nr][nc] < da[r][c]) for nr,nc in nbr])))
            s.add(Implies(ra[c], da[0][c]==0))
        else:
            s.add(Implies(x[r][c], Or(*[And(x[nr][nc], da[nr][nc] < da[r][c]) for nr,nc in nbr])))
        s.add(If(Not(x[r][c]), And(db[r][c]>=0, db[r][c]<N), db[r][c]==-1))
        if r==H-1:
            s.add(Implies(And(Not(x[r][c]), Not(rb[c])), Or(*[And(Not(x[nr][nc]), db[nr][nc] < db[r][c]) for nr,nc in nbr])))
            s.add(Implies(rb[c], db[H-1][c]==0))
        else:
            s.add(Implies(Not(x[r][c]), Or(*[And(Not(x[nr][nc]), db[nr][nc] < db[r][c]) for nr,nc in nbr])))
    res=s.check()
    print('size',W,res)
    if res==sat:
        m=s.model()
        for r in range(H):
            print(''.join('#' if is_true(m.evaluate(x[r][c])) else '.' for c in range(W)))
        return True
    return False

for n in [6,7,8,9]:
    if attempt(n,n,timeout=8000):
        break
