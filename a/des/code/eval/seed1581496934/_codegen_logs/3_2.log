from z3 import *
from itertools import product

def solve(W,H,corner_vals):
  x=[[Bool(f'x_{r}_{c}') for c in range(W)] for r in range(H)]
  da=[[Int(f'da_{r}_{c}') for c in range(W)] for r in range(H)]
  db=[[Int(f'db_{r}_{c}') for c in range(W)] for r in range(H)]
  s=Solver(); s.set(timeout=8000)
  corners=[(0,0),(0,W-1),(H-1,0),(H-1,W-1)]
  for (r,c),v in zip(corners,corner_vals):
      s.add(x[r][c] if v else Not(x[r][c]))
  # both colors touch all four sides
  for exprs in [
      [x[0][c] for c in range(W)], [Not(x[0][c]) for c in range(W)],
      [x[H-1][c] for c in range(W)], [Not(x[H-1][c]) for c in range(W)],
      [x[r][0] for r in range(H)], [Not(x[r][0]) for r in range(H)],
      [x[r][W-1] for r in range(H)], [Not(x[r][W-1]) for r in range(H)],
  ]:
      s.add(Or(*exprs))
  N=W*H
  # choose first true corner as A root and first false corner as B root
  Acorner=None; Bcorner=None
  for (r,c),v in zip(corners,corner_vals):
      if v and Acorner is None: Acorner=(r,c)
      if (not v) and Bcorner is None: Bcorner=(r,c)
  if Acorner is None or Bcorner is None:
      return None
  for r in range(H):
    for c in range(W):
      nbr=[(nr,nc) for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)] if 0 <= (nr:=r+dr) < H and 0 <= (nc:=c+dc) < W]
      s.add(If(x[r][c], And(da[r][c]>=0, da[r][c]<N), da[r][c]==-1))
      if (r,c)==Acorner:
        s.add(da[r][c]==0)
      else:
        s.add(Implies(x[r][c], Or(*[And(x[nr][nc], da[nr][nc] < da[r][c]) for nr,nc in nbr])))
      s.add(If(Not(x[r][c]), And(db[r][c]>=0, db[r][c]<N), db[r][c]==-1))
      if (r,c)==Bcorner:
        s.add(db[r][c]==0)
      else:
        s.add(Implies(Not(x[r][c]), Or(*[And(Not(x[nr][nc]), db[nr][nc] < db[r][c]) for nr,nc in nbr])))
  res=s.check()
  if res==sat:
      m=s.model()
      return [''.join('#' if is_true(m.evaluate(x[r][c])) else '.' for c in range(W)) for r in range(H)]
  return None

for W,H in [(6,6),(7,7),(8,8)]:
  print('size',W)
  for vals in product([False,True], repeat=4):
    if all(vals) or not any(vals):
      continue
    g=solve(W,H,vals)
    if g:
      print('corners',vals)
      print('\\n'.join(g))
      raise SystemExit
print('none')
