import numba as nb
import numpy as np

H=W=5
N=H*W
FULL=(1<<N)-1

@nb.njit
def has_side(mask, side):
    if side==0:
        for c in range(W):
            if mask & (1<<c): return True
    elif side==1:
        base=(H-1)*W
        for c in range(W):
            if mask & (1<<(base+c)): return True
    elif side==2:
        for r in range(H):
            if mask & (1<<(r*W)): return True
    else:
        for r in range(H):
            if mask & (1<<(r*W+W-1)): return True
    return False

@nb.njit
def first_bit(mask):
    i=0
    while i<N:
        if mask & (1<<i):
            return i
        i+=1
    return -1

@nb.njit
def flood_component(mask):
    start=first_bit(mask)
    if start<0:
        return 0
    frontier=1<<start
    seen=0
    while frontier:
        seen |= frontier
        nxt=0
        bits=frontier
        i=0
        while bits:
            if bits & 1:
                r=i//W; c=i%W
                if r>0: nxt |= 1<<((r-1)*W+c)
                if r+1<H: nxt |= 1<<((r+1)*W+c)
                if c>0: nxt |= 1<<(r*W+c-1)
                if c+1<W: nxt |= 1<<(r*W+c+1)
            bits >>= 1
            i += 1
        frontier = (nxt & mask) & ~seen
    return seen

@nb.njit
def connected(mask):
    if mask==0: return False
    return flood_component(mask)==mask

@nb.njit
def search(limit):
    for mask in range(1, limit):
        comp=FULL "'^ mask
        if comp==0:
            continue
        if not (has_side(mask,0) and has_side(mask,1) and has_side(mask,2) and has_side(mask,3)):
            continue
        if not (has_side(comp,0) and has_side(comp,1) and has_side(comp,2) and has_side(comp,3)):
            continue
        if connected(mask) and connected(comp):
            return mask
    return -1

m=search(1<<N)
print('"'mask',m)
if m>=0:
    for r in range(H):
        row=''
        for c in range(W):
            row += '#' if m & (1<<(r*W+c)) else '.'
        print(row)
