from z3 import *

def solve(h,w,timeout=10000):
    N=h*w
    x=[[Bool(f'x_{r}_{c}') for c in range(w)] for r in range(h)]
    da=[[Int(f'da_{r}_{c}') for c in range(w)] for r in range(h)]
    db=[[Int(f'db_{r}_{c}') for c in range(w)] for r in range(h)]
    s=Solver(); s.set(timeout=timeout)
    # roots fixed: A at TL, B at TR
    s.add(x[0][0])
    s.add(Not(x[0][w-1]))
    # touch all sides for both
    s.add(Or(*[x[0][c] for c in range(w)]), Or(*[Not(x[0][c]) for c in range(w)]))
    s.add(Or(*[x[h-1][c] for c in range(w)]), Or(*[Not(x[h-1][c]) for c in range(w)]))
    s.add(Or(*[x[r][0] for r in range(h)]), Or(*[Not(x[r][0]) for r in range(h)]))
    s.add(Or(*[x[r][w-1] for r in range(h)]), Or(*[Not(x[r][w-1]) for r in range(h)]))
    # specifically make B touch left and bottom, A touch right and bottom
    s.add(Or(*[Not(x[h-1][c]) for c in range(w)]), Or(*[x[h-1][c] for c in range(w)]))
    s.add(Or(*[Not(x[r][0]) for r in range(h)]))
    s.add(Or(*[x[r][w-1] for r in range(h)]))
    # not trivial
    cells=[x[r][c] for r in range(h) for c in range(w)]
    s.add(PbGe([(v,1) for v in cells], 3), PbLe([(v,1) for v in cells], N-3))
    for r in range(h):
      for c in range(w):
        nbr=[(nr,nc) for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)] if 0 <= (nr:=r+dr) < h and 0 <= (nc:=c+dc) < w]
        # A distance from root (0,0)
        s.add(If(x[r][c], And(da[r][c] >= 0, da[r][c] < N), da[r][c] == -1))
        if (r,c)==(0,0):
          s.add(da[r][c]==0)
        else:
          s.add(Implies(x[r][c], Or(*[And(x[nr][nc], da[nr][nc] == da[r][c]-1) for nr,nc in nbr])))
        # B distance from root (0,w-1)
        s.add(If(Not(x[r][c]), And(db[r][c] >= 0, db[r][c] < N), db[r][c] == -1))
        if (r,c)==(0,w-1):
          s.add(db[r][c]==0)
        else:
          s.add(Implies(Not(x[r][c]), Or(*[And(Not(x[nr][nc]), db[nr][nc] == db[r][c]-1) for nr,nc in nbr])))
    # require opposite corners split
    s.add(x[h-1][0] == False)
    s.add(x[h-1][w-1] == True)
    res=s.check()
    print('check',res)
    if res"'!=sat:
        return None
    m=s.model()
    return [[1 if is_true(m.evaluate(x[r][c])) else 0 for c in range(w)] for r in range(h)]

for h,w in [(5,5),(6,6),(7,7)]:
    g=solve(h,w)
    print('"'size',h,w,g is not None)
    if g:
        for row in g:
