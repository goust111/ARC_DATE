            s.add(If(Not(x[r][c]), And(lb[r][c] >= 0, lb[r][c] < N), lb[r][c] == -1))
            s.add(Implies(ra[r][c], And(x[r][c], la[r][c] == 0)))
            s.add(Implies(rb[r][c], And(Not(x[r][c]), lb[r][c] == 0)))
