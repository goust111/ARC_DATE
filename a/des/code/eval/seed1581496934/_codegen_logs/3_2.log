from z3 import *

def solve(h,w):
    N=h*w
    x=[[Bool(f'x_{r}_{c}') for c in range(w)] for r in range(h)]
    la=[[Int(f'la_{r}_{c}') for c in range(w)] for r in range(h)]
    lb=[[Int(f'lb_{r}_{c}') for c in range(w)] for r in range(h)]
    ra=[[Bool(f'ra_{r}_{c}') for c in range(w)] for r in range(h)]
    rb=[[Bool(f'rb_{r}_{c}') for c in range(w)] for r in range(h)]
    s=Solver()
    # nontrivial
    cells=[x[r][c] for r in range(h) for c in range(w)]
    s.add(PbGe([(v,1) for v in cells], 2))
    s.add(PbLe([(v,1) for v in cells], N-2))
    # side touches for both colors
    def side_touch(val):
        return [
            Or(*[x[0][c] if val else Not(x[0][c]) for c in range(w)]),
            Or(*[x[h-1][c] if val else Not(x[h-1][c]) for c in range(w)]),
            Or(*[x[r][0] if val else Not(x[r][0]) for r in range(h)]),
            Or(*[x[r][w-1] if val else Not(x[r][w-1]) for r in range(h)]),
        ]
    s.add(*side_touch(True), *side_touch(False))
    # roots exactly one per color
    s.add(PbEq([(ra[r][c],1) for r in range(h) for c in range(w)],1))
    s.add(PbEq([(rb[r][c],1) for r in range(h) for c in range(w)],1))
    # labels and connectivity
    for r in range(h):
        for c in range(w):
            nbr=[(nr,nc) for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)] if 0 <= (nr:=r+dr) < h and 0 <= (nc:=c+dc) < w]
            s.add(Implies(x[r][c], And(la[r][c] >= 0, la[r][c] < N)))
            s.add(Implies(Not(x[r][c]), la[r][c] == -1))
            s.add(Implies(ra[r][c], And(x[r][c], la[r][c] == 0)))
            s.add(Implies(And(x[r][c], Not(ra[r][c])), Or(*[And(x[nr][nc], la[nr][nc] < la[r][c]) for nr,nc in nbr])))

            s.add(Implies(Not(x[r][c]), And(lb[r][c] >= 0, lb[r][c] < N)))
            s.add(Implies(x[r][c], lb[r][c] == -1))
            s.add(Implies(rb[r][c], And(Not(x[r][c]), lb[r][c] == 0)))
            s.add(Implies(And(Not(x[r][c]), Not(rb[r][c])), Or(*[And(Not(x[nr][nc]), lb[nr][nc] < lb[r][c]) for nr,nc in nbr])))
    # avoid symmetry: top-left in A
    s.add(x[0][0])
    # irregular: not all border, not rectangle maybe at least one interior cell of each color
    if h > 2 and w > 2:
        inner=[x[r][c] for r in range(1,h-1) for c in range(1,w-1)]
        s.add(Or(*inner))
        s.add(Or(*[Not(v) for v in inner]))
    # opposite corners not all same, helps anchors
    s.add(Or(x[0][0] "'!= x[0][w-1], x[0][0] != x[h-1][0], x[h-1][0] != x[h-1][w-1], x[0][w-1] != x[h-1][w-1]))
    if s.check()!=sat:
        return None
    m=s.model()
    g=[[1 if is_true(m.evaluate(x[r][c])) else 0 for c in range(w)] for r in range(h)]
    return g

for h,w in [(5,5),(5,6),(6,6),(6,7),(7,7)]:
    g=solve(h,w)
    print('"'size',h,w,'ok',g is not None)
    if g:
        for row in g:
            print(''.join('#' if v else '.' for v in row))
        break
