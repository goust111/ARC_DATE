import random, math
from collections import deque

def comps(mask,val):
    h=len(mask); w=len(mask[0]); seen=set(); cnt=0
    for r in range(h):
        for c in range(w):
            if mask[r][c]==val and (r,c) not in seen:
                cnt+=1
                q=deque([(r,c)]); seen.add((r,c))
                while q:
                    rr,cc=q.popleft()
                    for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
                        nr,nc=rr+dr,cc+dc
                        if 0<=nr<h and 0<=nc<w and mask[nr][nc]==val and (nr,nc) not in seen:
                            seen.add((nr,nc)); q.append((nr,nc))
    return cnt

def touches(mask,val):
    h=len(mask); w=len(mask[0])
    return sum([
        any(mask[0][c]==val for c in range(w)),
        any(mask[h-1][c]==val for c in range(w)),
        any(mask[r][0]==val for r in range(h)),
        any(mask[r][w-1]==val for r in range(h)),
    ])

def mono2(mask):
    h=len(mask); w=len(mask[0]); cnt=0
    for r in range(h-1):
        for c in range(w-1):
            vals={mask[r][c],mask[r+1][c],mask[r][c+1],mask[r+1][c+1]}
            if len(vals)==1: cnt+=1
    return cnt

def score(mask):
    h=len(mask); w=len(mask[0]); a=sum(cell for row in mask for cell in row); b=h*w-a
    return -100*(comps(mask,True)-1)-100*(comps(mask,False)-1)+20*touches(mask,True)+20*touches(mask,False)-30*mono2(mask)-abs(a-b)

