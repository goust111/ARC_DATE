                        nr,nc=rr+dr,cc+dc
                        if 0<=nr<h and 0<=nc<w and mask[nr][nc]==val and (nr,nc) not in seen:
                            seen.add((nr,nc)); q.append((nr,nc))
    return n

def touch(mask,val):
    h=len(mask); w=len(mask[0])
    return all([
        any(mask[0][c]==val for c in range(w)),
        any(mask[h-1][c]==val for c in range(w)),
        any(mask[r][0]==val for r in range(h)),
        any(mask[r][w-1]==val for r in range(h)),
    ])

def sample_row(w, prev=None):
    row=[False]*w
    k=random.choice([1,2])
    if prev is None:
        intervals=[]
        for _ in range(k):
            a=random.randrange(w); b=random.randrange(a,w)
            intervals.append((a,b))
    else:
        intervals=[]
        for a,b in prev:
            if random.random()<0.7:
                da=random.choice([-1,0,1]); db=random.choice([-1,0,1])
                na=max(0,min(w-1,a+da)); nb=max(na,min(w-1,b+db))
                intervals.append((na,nb))
        while len(intervals)<k:
            a=random.randrange(w); b=random.randrange(a,w)
            intervals.append((a,b))
    intervals=sorted(intervals)
    merged=[]
    for a,b in intervals:
        if not merged or a>merged[-1][1]+1:
            merged.append([a,b])
        else:
            merged[-1][1]=max(merged[-1][1],b)
    for a,b in merged:
        for c in range(a,b+1): row[c]=True
    return row, [tuple(x) for x in merged]

for h,w in [(8,8),(9,9),(8,9)]:
    for _ in range(100000):
        mask=[]; prev=None
        for r in range(h):
            row,prev=sample_row(w,prev)
            mask.append(row)
        if cc(mask,True)==1 and cc(mask,False)==1 and touch(mask,True) and touch(mask,False):
            print('found',h,w)
            for row in mask:
                print(''.join('#' if x else '.' for x in row))
            raise SystemExit
    print('none',h,w)
