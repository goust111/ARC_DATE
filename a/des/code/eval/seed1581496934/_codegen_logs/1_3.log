+    return [(top + r, left + c) for r, c in coords]
+
+
+def _find_components(grid: np.ndarray, skip: np.ndarray):
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    components = []
+    for r in range(h):
+        for c in range(w):
+            if skip[r, c] or visited[r, c] or int(grid[r, c]) == BG:
+                continue
+            color = int(grid[r, c])
+            queue = deque([(r, c)])
+            visited[r, c] = True
+            coords = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if skip[nr, nc] or visited[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    visited[nr, nc] = True
+                    queue.append((nr, nc))
+            norm, box_h, box_w = _normalize(coords)
+            components.append(
