+        overlap = len(set(norm) & set(mirrored))
+        if 0 < overlap < len(norm):
+            return {
+                "norm": norm,
+                "height": height,
+                "width": width,
+                "mirrored": mirrored,
+                "union": tuple(sorted(set(norm) | set(mirrored))),
+                "overlap": overlap,
+            }
+    return None
+
+
+def _can_place(coords, blocked: np.ndarray, pad: int = 1):
+    h, w = blocked.shape
+    for r, c in coords:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        r0 = max(0, r - pad)
+        r1 = min(h, r + pad + 1)
+        c0 = max(0, c - pad)
+        c1 = min(w, c + pad + 1)
+        if np.any(blocked[r0:r1, c0:c1]):
+            return False
+    return True
+
+
+def _mark(coords, blocked: np.ndarray, pad: int = 1):
+    h, w = blocked.shape
+    for r, c in coords:
+        r0 = max(0, r - pad)
+        r1 = min(h, r + pad + 1)
+        c0 = max(0, c - pad)
+        c1 = min(w, c + pad + 1)
+        blocked[r0:r1, c0:c1] = True
+
+
+def _place_shape(rng: random.Random, blocked: np.ndarray, shape_coords, box_h: int, box_w: int):
+    h, w = blocked.shape
