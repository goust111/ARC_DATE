+    with the legend's overlap color.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.shape[1] >= 2
+    h, w = g.shape
+
+    overlap_color = int(g[0, 1])
+    skip = np.zeros((h, w), dtype=bool)
+    skip[0, 0] = True
+    skip[0, 1] = True
