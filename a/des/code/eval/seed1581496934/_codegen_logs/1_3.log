+        overlap = len(set(norm) & set(mirrored))
+        if 0 < overlap < len(norm):
+            return {
+                "norm": norm,
+                "height": height,
+                "width": width,
+                "mirrored": mirrored,
+                "union": tuple(sorted(set(norm) | set(mirrored))),
+                "overlap": overlap,
+            }
+    return None
+
+
+def _can_place(coords, blocked: np.ndarray, pad: int = 1):
+    h, w = blocked.shape
+    for r, c in coords:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        r0 = max(0, r - pad)
