+
+
+def _build_path_with_first_dir(
+    shape: tuple[int, int],
+    forbidden: set[tuple[int, int]],
+    source_color: int,
+    first_dir: tuple[int, int],
+    steps: list[dict],
+):
+    local_forbidden = set(forbidden)
