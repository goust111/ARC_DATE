+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+COUNT = 9
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8)
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
