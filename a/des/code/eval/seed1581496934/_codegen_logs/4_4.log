+            pick = frontier[int(RNG.integers(0, len(frontier)))]
+            coords.add(pick)
+        if len(coords) != area:
+            continue
+        norm = _normalize(coords)
+        if _mirror_normalized(norm) == norm:
+            continue
+        return norm
+    raise RuntimeError("failed to sample a non-symmetric connected shape")
