+    left_span = (int(c0 + col_spans[0][0]), int(c0 + col_spans[0][1]))
+    right_span = (int(c0 + col_spans[1][0]), int(c0 + col_spans[1][1]))
+    assert left_span[1] - left_span[0] == right_span[1] - right_span[0], "table cells must share a width"
