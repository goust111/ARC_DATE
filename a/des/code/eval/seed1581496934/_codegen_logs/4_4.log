+    col_spans = [(col_runs[i][1] + 1, col_runs[i + 1][0] - 1) for i in range(len(col_runs) - 1)]
+    assert len(col_spans) == 2, "expected two table columns"
+    assert all(a <= b for a, b in row_spans)
+    assert all(a <= b for a, b in col_spans)
