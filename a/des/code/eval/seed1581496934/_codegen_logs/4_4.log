+def _paint_cell(grid: np.ndarray, row_span: tuple[int, int], col_span: tuple[int, int], coords: tuple[tuple[int, int], ...], color: int) -> None:
+    r0, r1 = row_span
+    c0, c1 = col_span
+    grid[r0 : r1 + 1, c0 : c1 + 1] = BLACK
+    for dr, dc in coords:
