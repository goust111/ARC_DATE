+        inner_h = max(6, top_stack + bottom_stack, mid_h + 2 * max(top_stack, bottom_stack), max(all_heights))
+        inner_w = max(6, left_stack + right_stack, mid_w + 2 * max(left_stack, right_stack), max(all_widths))
