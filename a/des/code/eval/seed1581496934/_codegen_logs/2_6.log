    needed = n_rects + 1  # base colors + marker
    if needed > len(NON_BG):
        return None
    chosen = random.sample(NON_BG, needed)
    plain_base, marker_color = chosen[0], chosen[-1]
    marked_bases = chosen[1:-1]
    return plain_base, marker_color, marked_bases


