+        right_stack, _ = _side_stats(side_to_patches["right"], axis=1)
+        _, mid_h = _side_stats(side_to_patches["left"] + side_to_patches["right"], axis=0)
+        _, mid_w = _side_stats(side_to_patches["top"] + side_to_patches["bottom"], axis=1)
