+
+def _compose_patches(patches: list[np.ndarray]) -> np.ndarray | None:
+    layouts = {2: [(1, 2), (2, 1)], 3: [(1, 3), (3, 1), (2, 2)]}[len(patches)]
+    random.shuffle(layouts)
+
+    for rows, cols in layouts:
+        order = list(patches)
+        random.shuffle(order)
