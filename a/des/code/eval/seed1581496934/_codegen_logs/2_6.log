+def _side_stats(patches: list[np.ndarray], axis: int) -> tuple[int, int]:
+    if not patches:
+        return 0, 0
+    spans = [patch.shape[axis] for patch in patches]
+    return sum(int(span) for span in spans), max(int(span) for span in spans)
