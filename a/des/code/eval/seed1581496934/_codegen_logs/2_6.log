+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+SIDES = ("top", "bottom", "left", "right")
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+MAX_GENERATION_ATTEMPTS = 300
+MAX_CLUSTER_ATTEMPTS = 200
+GRID_MIN = 18
+GRID_MAX = 42
