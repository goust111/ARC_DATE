+
+def _clear_with_gap(grid: np.ndarray, r0: int, c0: int, h: int, w: int) -> bool:
+    hh, ww = grid.shape
+    if r0 < 0 or c0 < 0 or r0 + h > hh or c0 + w > ww:
+        return False
+    rr0 = max(0, r0 - 1)
+    cc0 = max(0, c0 - 1)
