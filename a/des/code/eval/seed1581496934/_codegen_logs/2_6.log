+    for rows, cols in layouts:
+        order = list(patches)
+        random.shuffle(order)
+        cells = [None] * (rows * cols)
+        positions = list(range(rows * cols))
+        random.shuffle(positions)
+        for idx, patch in zip(positions, order):
