+        for side in SIDES:
+            items = sorted(
+                by_side[side],
+                key=lambda frag: (-int(frag["area"]), int(frag["bbox"][0]), int(frag["bbox"][1])),
+            )
+            offset = 0
+            for frag in items:
+                patch = frag["patch"]
+                mask = patch == color
+                h, w = patch.shape
+                if side == "top":
+                    rr = offset
+                    cc = (inner_w - w) // 2
+                    offset += h
+                elif side == "bottom":
+                    rr = inner_h - offset - h
+                    cc = (inner_w - w) // 2
+                    offset += h
+                elif side == "left":
+                    rr = (inner_h - h) // 2
+                    cc = offset
+                    offset += w
+                else:
+                    rr = (inner_h - h) // 2
+                    cc = inner_w - offset - w
+                    offset += w
