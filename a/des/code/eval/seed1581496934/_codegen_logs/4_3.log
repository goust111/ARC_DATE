+    for d in range(-2, 3):
+        assert int(grid[center_r + d, center_c]) == cross_color, "crosshair vertical arm must have length 5"
+        assert int(grid[center_r, center_c + d]) == cross_color, "crosshair horizontal arm must have length 5"
