+        cc = col_gaps[0]
+        for slot_c in range(slot_cols):
+            slots.append((rr, cc))
+            if slot_c + 1 < slot_cols:
+                cc += 2 + col_gaps[slot_c + 1]
+        if slot_r + 1 < slot_rows:
+            rr += 2 + row_gaps[slot_r + 1]
