+def _stamp(out: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = out.shape
+    ph, pw = patch.shape
+    for rr in range(ph):
+        for cc in range(pw):
+            val = int(patch[rr, cc])
+            if val == BLACK:
+                continue
+            tr = r0 + rr
+            tc = c0 + cc
+            if 0 <= tr < h and 0 <= tc < w:
+                out[tr, tc] = val
