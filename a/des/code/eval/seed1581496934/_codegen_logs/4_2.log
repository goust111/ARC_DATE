+        return style
+    return "horizontal" if style == "vertical" else "vertical"
+
+
+def _route_edge(
+    a: tuple[int, int],
+    b: tuple[int, int],
+    style: str | None,
+) -> tuple[list[tuple[int, int]], int, int]:
+    ra, ca = a
+    rb, cb = b
+
+    if ra == rb:
+        step = 1 if cb > ca else -1
+        path = [(ra, c) for c in range(ca + step, cb, step)]
+        return path, (1 if step > 0 else 3), (3 if step > 0 else 1)
