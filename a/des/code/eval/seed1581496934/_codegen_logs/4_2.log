+def _transform_point(pt: tuple[int, int], name: str, span: int) -> tuple[int, int]:
+    r, c = pt
+    last = span - 1
+    if name == "id":
+        return r, c
+    if name == "rot90":
+        return c, last - r
+    if name == "rot180":
+        return last - r, last - c
+    if name == "rot270":
+        return last - c, r
+    if name == "flip_h":
+        return r, last - c
+    if name == "flip_v":
+        return last - r, c
+    if name == "diag":
