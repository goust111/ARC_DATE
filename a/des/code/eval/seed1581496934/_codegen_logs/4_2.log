+BG = 0
+PIPE = 5
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # up, right, down, left
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+SCALE_CHOICES = (4, 5)
+PADDING_RANGE = (0, 4)
