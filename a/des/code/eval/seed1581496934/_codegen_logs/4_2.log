+        occupied_pipe.update(path_set)
+        used_dirs[u].add(dir_u)
+        used_dirs[v].add(dir_v)
+        neighbor_map_by_node[u].append((dir_u, v))
+        neighbor_map_by_node[v].append((dir_v, u))
