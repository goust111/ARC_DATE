+def _sample_family() -> tuple[dict[int, tuple[int, int]], list[tuple[int, int, str | None]]]:
+    bucket = random.choice((1, 2, 3, 4))
+    family = FAMILIES[random.choice(BRANCH_BUCKETS[bucket])]
+    nodes = dict(family["nodes"])
