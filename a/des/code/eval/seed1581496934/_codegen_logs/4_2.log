+            (0, 2, "horizontal"),
+            (0, 3, "vertical"),
+            (0, 4, "horizontal"),
+        ],
+    },
+    "cycle4": {
+        "nodes": {0: (0, 0), 1: (0, 4), 2: (4, 4), 3: (4, 0)},
