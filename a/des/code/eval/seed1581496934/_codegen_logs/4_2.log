+
+        end_touch_u = sum(abs(r - positions[u][0]) + abs(c - positions[u][1]) == 1 for r, c in path)
+        end_touch_v = sum(abs(r - positions[v][0]) + abs(c - positions[v][1]) == 1 for r, c in path)
+        if end_touch_u != 1 or end_touch_v != 1:
