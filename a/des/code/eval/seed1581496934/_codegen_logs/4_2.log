+    for c in range(port_a[1], bend[1] + dc, dc):
+        path.append((port_a[0], c))
+    dr = 1 if port_b[0] > bend[0] else -1
+    for r in range(bend[0] + dr, port_b[0] + dr, dr):
+        path.append((r, bend[1]))
+    return path, (1 if dc > 0 else 3), (3 if dc > 0 else 1)
+
