+        "edges": [(0, 1, "vertical"), (1, 2, None)],
+    },
+    "chain4": {
+        "nodes": {0: (0, 2), 1: (2, 2), 2: (2, 4), 3: (4, 4)},
+        "edges": [(0, 1, None), (1, 2, None), (2, 3, None)],
+    },
+    "star3": {
+        "nodes": {0: (2, 2), 1: (0, 0), 2: (0, 4), 3: (4, 2)},
+        "edges": [(0, 1, "vertical"), (0, 2, "horizontal"), (0, 3, None)],
+    },
+    "star4": {
+        "nodes": {0: (2, 2), 1: (0, 0), 2: (0, 4), 3: (4, 4), 4: (4, 0)},
+        "edges": [
