+def _pick_scattered_cells(cells: list[tuple[int, int]], count: int) -> list[tuple[int, int]]:
+    pool = list(cells)
+    random.shuffle(pool)
+    if count == 0:
+        return []
+
+    picked = [pool.pop()]
+    while len(picked) < count:
+        best_score = -1
+        best_cells: list[tuple[int, int]] = []
+        for cell in pool:
