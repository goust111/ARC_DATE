+            if c + 1 < cols and int(labels[r, c]) == int(labels[r, c + 1]):
+                grid[r0:r1, c1] = BLACK
+            if r + 1 < rows and int(labels[r, c]) == int(labels[r + 1, c]):
+                grid[r1, c0:c1] = BLACK
+
+    return grid
+
