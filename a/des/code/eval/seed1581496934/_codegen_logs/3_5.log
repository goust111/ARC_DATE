+    inner_w = int(pw + rng.integers(2, 4))
+    box_h = target_rows * inner_h + target_rows + 1
+    box_w = target_cols * inner_w + target_cols + 1
+    box_in = np.full((box_h, box_w), ORANGE, dtype=int)
+    box_out = np.full((box_h, box_w), ORANGE, dtype=int)
