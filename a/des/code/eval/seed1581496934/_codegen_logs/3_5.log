+    lr = (h - left.shape[0]) // 2
+    ar = (h - arrow.shape[0]) // 2
+    rr = (h - right.shape[0]) // 2
+    ac = left.shape[1] + gap1
+    rc = ac + arrow.shape[1] + gap2
