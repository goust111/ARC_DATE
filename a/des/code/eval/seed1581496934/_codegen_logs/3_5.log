+def _target_bbox(grid: np.ndarray, sep_row: int) -> tuple[int, int, int, int]:
+    orange = np.argwhere(grid[sep_row + 1 :] == ORANGE)
+    assert orange.size > 0, "expected orange partition lines below separator"
+    orange = orange.copy()
