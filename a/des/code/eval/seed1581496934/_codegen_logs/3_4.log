+            length = random.randint(4, max_len)
+            left_port = int(pieces["tl"]["ports"]["right"][1])
+            right_port = int(pieces["tr"]["ports"]["left"][1])
+            start_min = left_port + 2
+            start_max = right_port - length - 1
+            if start_min > start_max:
