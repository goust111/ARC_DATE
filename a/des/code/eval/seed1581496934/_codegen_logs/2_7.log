+        if plan is None:
+            return None
+        plans.append(_translate(plan, r0, c0))
+
+    grid, expected = _render(plans)
+    if np.array_equal(grid, expected):
+        return None
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
