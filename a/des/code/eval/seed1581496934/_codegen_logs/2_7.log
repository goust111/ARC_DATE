+def _distance_to_edge(pos: tuple[int, int], direction: tuple[int, int], h: int, w: int) -> int:
+    r, c = pos
+    dr, dc = direction
+    if dr == -1:
+        return r
+    if dr == 1:
+        return h - 1 - r
+    if dc == -1:
+        return c
+    return w - 1 - c
