+    ("\\", RIGHT): DOWN,
+    ("\\", DOWN): RIGHT,
+    ("\\", LEFT): UP,
+    ("\\", UP): LEFT,
+    ("/", RIGHT): UP,
+    ("/", UP): RIGHT,
+    ("/", LEFT): DOWN,
+    ("/", DOWN): LEFT,
