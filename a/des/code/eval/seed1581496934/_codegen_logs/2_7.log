+def _emitter_cells_from_start(start: tuple[int, int], direction: tuple[int, int]) -> set[tuple[int, int]]:
+    r, c = start
+    if direction == RIGHT:
+        rel = [(0, 0), (-1, 0), (0, 1)]
+    elif direction == LEFT:
+        rel = [(0, 0), (-1, 0), (0, -1)]
+    elif direction == DOWN:
+        rel = [(0, 0), (0, 1), (1, 0)]
+    else:
+        rel = [(0, 0), (0, -1), (1, 0)]
+    return {(r + dr, c + dc) for dr, dc in rel}
