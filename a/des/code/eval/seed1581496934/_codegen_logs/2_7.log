+    rows = {r for r, _ in cells}
+    cols = {c for _, c in cells}
+    if len(rows) != len(cells) or len(cols) != len(cells):
+        return None
+    pts = sorted(cells)
+    if len({r - c for r, c in pts}) == 1:
+        if all(pts[i + 1][0] - pts[i][0] == 1 and pts[i + 1][1] - pts[i][1] == 1 for i in range(len(pts) - 1)):
+            return "\\"
+    if len({r + c for r, c in pts}) == 1:
+        if all(pts[i + 1][0] - pts[i][0] == 1 and pts[i + 1][1] - pts[i][1] == -1 for i in range(len(pts) - 1)):
+            return "/"
+    return None
