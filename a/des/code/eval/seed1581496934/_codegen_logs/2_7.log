+def _turn_orientation(in_dir: tuple[int, int], out_dir: tuple[int, int]) -> str:
+    for orient, idir in REFLECT:
+        if idir == in_dir and REFLECT[(orient, in_dir)] == out_dir:
+            return orient
+    raise ValueError("invalid turn")
