+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    out = g.copy()
+
+    emitters: list[dict] = []
+    emitter_owner: dict[tuple[int, int], int] = {}
+    for color in np.unique(g):
+        color = int(color)
