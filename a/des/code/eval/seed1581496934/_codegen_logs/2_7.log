 224:                 # Vertical wall (flips dc): center pixel at (cur_r, cur_c+cur_dc)
 225:                 wr2, wc2 = cur_r, cur_c + cur_dc
 226:                 if 0 <= wc2 < W:
 227:                     w3v = [(wr2 + d, wc2) for d in (-1, 0, 1)]
 228:                     if all(0 <= r < H for r, _ in w3v):
 229:                         options.append((w3v, 'dc'))
 230:                     options.append(([(wr2, wc2)], 'dc'))
 231:                 if not options:
 232:                     ok = False; break
 233: 
 234:                 # Mix of 1-pixel and 3-pixel walls; shuffle with size preference
 235:                 _rng.shuffle(options)
 236:                 prefer_3 = _rng.random() < 0.6
 237:                 options.sort(key=lambda o: len(o[0]), reverse=prefer_3)
 238:                 chosen_wall = None
 239:                 for wpxs, flip in options:
 240:                     if any((r, c) in occupied or (r, c) in ray_set or (r, c) in arrow_set
 241:                            for r, c in wpxs):
