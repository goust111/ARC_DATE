+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+GRAY = 5
+MAROON = 9
+EMITTER_COLORS = [1, 2, 3, 4, 6, 7, 8]
+
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+DIRS = [UP, DOWN, LEFT, RIGHT]
+
+TURN_LEFT = {
+    UP: LEFT,
+    LEFT: DOWN,
+    DOWN: RIGHT,
+    RIGHT: UP,
+}
+TURN_RIGHT = {
+    UP: RIGHT,
+    RIGHT: DOWN,
+    DOWN: LEFT,
+    LEFT: UP,
+}
+REFLECT = {
+    ("\\", RIGHT): DOWN,
+    ("\\", DOWN): RIGHT,
+    ("\\", LEFT): UP,
+    ("\\", UP): LEFT,
+    ("/", RIGHT): UP,
+    ("/", UP): RIGHT,
+    ("/", LEFT): DOWN,
+    ("/", DOWN): LEFT,
+}
+
+GEN_ATTEMPTS = 400
