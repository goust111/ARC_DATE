+            rows, cols = 1, 2
+            slots = [(0, 0), (0, 1)]
+        else:
+            rows, cols = 2, 1
+            slots = [(0, 0), (1, 0)]
+    elif n_emitters == 3:
+        rows, cols = 2, 2
+        slots = [(0, 0), (0, 1), (1, 0), (1, 1)]
+        rng.shuffle(slots)
+        slots = slots[:3]
+    else:
+        rows, cols = 2, 2
+        slots = [(0, 0), (0, 1), (1, 0), (1, 1)]
+
+    row_heights = [rng.randint(10, 13) for _ in range(rows)]
+    col_widths = [rng.randint(10, 13) for _ in range(cols)]
+    gap = rng.randint(1, 2)
+    margin = rng.randint(1, 2)
+
+    row_starts = []
+    cur = margin
+    for h in row_heights:
+        row_starts.append(cur)
+        cur += h + gap
+
+    col_starts = []
+    cur = margin
+    for w in col_widths:
+        col_starts.append(cur)
+        cur += w + gap
+
+    boxes: list[tuple[int, int, int, int]] = []
+    for sr, sc in slots:
+        r0 = row_starts[sr]
+        c0 = col_starts[sc]
+        boxes.append((r0, c0, row_heights[sr], col_widths[sc]))
+    return boxes
