+def _layout_boxes(rng: random.Random, n_emitters: int) -> list[tuple[int, int, int, int]]:
+    if n_emitters == 1:
+        rows, cols = 1, 1
+        slots = [(0, 0)]
+    elif n_emitters == 2:
