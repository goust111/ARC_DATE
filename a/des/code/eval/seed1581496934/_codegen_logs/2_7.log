+    out = np.full((max_r, max_c), BLACK, dtype=int)
+
+    for plan in plans:
+        color = int(plan["color"])
+        for r, c in plan["emitter_cells"]:
+            grid[r, c] = color
+            out[r, c] = color
+        for mirror in plan["mirrors"]:
+            for r, c in mirror["cells"]:
