+    cur = margin
+    for w in col_widths:
+        col_starts.append(cur)
+        cur += w + gap
+
+    boxes: list[tuple[int, int, int, int]] = []
+    for sr, sc in slots:
+        r0 = row_starts[sr]
+        c0 = col_starts[sc]
