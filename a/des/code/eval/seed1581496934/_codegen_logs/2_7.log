+        direction = emitter["direction"]
+        seen: set[tuple[int, int, int, int]] = set()
+        while True:
+            state = (cur[0], cur[1], direction[0], direction[1])
+            if state in seen:
+                break
+            seen.add(state)
+            nr = cur[0] + direction[0]
+            nc = cur[1] + direction[1]
+            if not (0 <= nr < h and 0 <= nc < w):
+                break
+            nxt = (int(nr), int(nc))
+            if nxt in target_lookup:
