 245:                 if chosen_wall is None:
 246:                     ok = False; break
 247: 
 248:                 wpxs, flip = chosen_wall
 249:                 wcol = _rng.choice(palette)
 250:                 walls.append((wpxs, wcol))
 251: 
 252:                 # Bounce cell adopts wall color in output
 253:                 if ray_cells:
 254:                     lr, lc, _ = ray_cells[-1]
 255:                     ray_cells[-1] = (lr, lc, wcol)
 256:                 cur_col = wcol
 257:                 if flip == 'dr':
 258:                     cur_dr = -cur_dr
 259:                 else:
 260:                     cur_dc = -cur_dc
 261: 
 262:             if not ok or len(ray_cells) < 3:
 263:                 continue
 264: 
 265:             # Check no internal or external collisions
 266:             new_cells = set(arrow_pts) | ray_set
 267:             for wpxs, _ in walls:
 268:                 new_cells.update(wpxs)
 269:             expected_count = len(arrow_pts) + len(ray_cells) + sum(len(w) for w, _ in walls)
 270:             if len(new_cells) != expected_count or new_cells & occupied:
 271:                 continue
 272: 
 273:             # Commit
 274:             for r, c in arrow_pts:
 275:                 grid[r, c] = out[r, c] = color
 276:             for r, c, col in ray_cells:
 277:                 out[r, c] = col
 278:             for wpxs, wcol in walls:
 279:                 for r, c in wpxs:
 280:                     grid[r, c] = out[r, c] = wcol
 281:             occupied |= new_cells
 282:             placed = True
 283:             break
 284: 
 285:         if not placed:
 286:             return None
 287: 
