+def _render(plans: list[dict]) -> tuple[np.ndarray, np.ndarray]:
+    all_cells: set[tuple[int, int]] = set()
+    for plan in plans:
+        all_cells |= plan["emitter_cells"]
+        all_cells |= plan["ray_cells"]
