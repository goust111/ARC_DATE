  27:     start_candidates: list[tuple[int, int, int, list[tuple[int, int]]]] = []
  28: 
  29:     for col in colors_present(g, exclude={bg}):
  30:         for coords in components_mask(g == int(col), connectivity=8):
  31:             if coords.size == 0:
  32:                 continue
  33:             r0, c0 = coords.min(axis=0)
