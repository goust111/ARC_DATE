  60:     non_bg_colors = set(map(int, g.ravel())) - {bg}
  61:     sprite_colors = non_bg_colors - {line_color}
  62:     assert len(sprite_colors) == 1, "expected exactly one sprite color"
  63:     sprite_color = next(iter(sprite_colors))
  64: 
  65:     sprites = find_components(
  66:         g,
  67:         bg=bg,
  68:         colors=[sprite_color],
  69:         connectivity=4,
  70:         monochromatic=True,
