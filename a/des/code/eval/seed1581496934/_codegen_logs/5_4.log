  94: def main(grid: np.ndarray) -> np.ndarray:
  95:     """
  96:     Add the two missing colored arms of a centered diamond-sprite motif, or clear a completed motif to a blank square.
  97: 
  98:     Input structure
  99:     An 11x11 board has orange background and pink separator bars forming nine 3x3 cells. Occupied cells contain a four-pixel diamond sprite; the center cell and one neighboring cell are red, and a completed board may also contain one grey and one teal sprite.
 100: 
 101:     Rule
 102:     With only the two red sprites present, preserve the board and add grey and teal diamond sprites 135 degrees clockwise and counterclockwise from the non-center red arm. If those expected grey and teal sprites are already present, output an all-background square whose side length is the total number of sprite pixels.
 103: 
 104:     Key insight
 105:     The non-center red sprite is an eight-neighbor direction from the center; the other two colored arms are fixed rotations of that direction.
 106:     """
 107:     g = np.asarray(grid, dtype=int)
 108:     bg, row_bands, col_bands, sprites = _parse_board(g)
 109: 
 110:     red_positions = [pos for pos, color in sprites.items() if color == Color.RED]
 111:     assert len(red_positions) == 2 and (1, 1) in red_positions
 112:     red_arm_pos = [pos for pos in red_positions if pos != (1, 1)][0]
 113:     expected = _expected_added_sprites(red_arm_pos)
 114: 
 115:     non_red_sprites = {pos: color for pos, color in sprites.items() if color != Color.RED}
 116:     if non_red_sprites:
 117:         assert len(sprites) == 4
 118:         assert non_red_sprites == expected
 119:         side = len(sprites) * len(DIAMOND_CELLS)
 120:         return np.full((side, side), bg, dtype=int)
 121: 
 122:     out = g.copy()
 123:     for pos, color in expected.items():
 124:         assert pos not in sprites
 125:         _paint_diamond(out, row_bands, col_bands, pos, color, bg)
 126:     return out
