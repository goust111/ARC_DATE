+BLACK = 0
+MAROON = 9
+COLOR_POOL = (1, 2, 3, 4, 5, 6, 7, 8)
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GEN_ATTEMPTS = 400
+PANEL_ATTEMPTS = 250
+STAMP_ATTEMPTS = 200
