+                        "cells": cells,
+                        "cellset": set(cells),
+                        "bbox": (r, start, r, c - 1),
+                        "mask": np.ones((1, c - start), dtype=bool),
+                    }
+                )
+                start = None
+        if start is not None:
+            cells = [(r, cc) for cc in range(start, c1)]
+            gaps.append(
+                {
+                    "side": side,
+                    "cells": cells,
+                    "cellset": set(cells),
+                    "bbox": (r, start, r, c1 - 1),
+                    "mask": np.ones((1, c1 - start), dtype=bool),
+                }
+            )
+    for side in ("left", "right"):
+        c = c0 if side == "left" else c1
+        start = None
+        for r in range(r0 + 1, r1):
+            if grid[r, c] == BG:
+                if start is None:
+                    start = r
+            elif start is not None:
+                cells = [(rr, c) for rr in range(start, r)]
+                gaps.append(
+                    {
+                        "side": side,
+                        "cells": cells,
+                        "cellset": set(cells),
+                        "bbox": (start, c, r - 1, c),
+                        "mask": np.ones((r - start, 1), dtype=bool),
+                    }
+                )
+                start = None
+        if start is not None:
+            cells = [(rr, c) for rr in range(start, r1)]
+            gaps.append(
+                {
+                    "side": side,
+                    "cells": cells,
+                    "cellset": set(cells),
+                    "bbox": (start, c, r1 - 1, c),
+                    "mask": np.ones((r1 - start, 1), dtype=bool),
+                }
+            )
+    return gaps
