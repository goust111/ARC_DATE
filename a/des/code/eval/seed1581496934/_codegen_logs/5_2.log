+
+def _generate_scene(rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray] | None:
+    frame_count = _pick(rng, [2, 3])
+    gap_counts = _choose_gap_count_pattern(rng, frame_count)
+    total_pieces = sum(gap_counts)
