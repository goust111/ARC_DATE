+            dc = gap["bbox"][1] - oc0
+            content_cells = []
+            ok = True
+            for pr, pc in np.argwhere(rot_patch != BG):
+                gr = int(pr + dr)
+                gc = int(pc + dc)
+                if not (fr0 <= gr <= fr1 and fc0 <= gc <= fc1):
+                    ok = False
+                    break
+                color = int(rot_patch[pr, pc])
+                if color == owner_color:
+                    if (gr, gc) not in gap["cellset"]:
+                        ok = False
+                        break
+                else:
+                    if gr in (fr0, fr1) or gc in (fc0, fc1):
+                        ok = False
+                        break
