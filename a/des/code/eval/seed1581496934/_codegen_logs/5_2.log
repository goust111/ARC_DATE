+    crops = []
+    for frame in frames:
+        r0, c0, r1, c1 = frame["bbox"]
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        crop = np.full((h, w), BG, dtype=int)
+        crop[0, :] = frame["color"]
+        crop[-1, :] = frame["color"]
+        crop[:, 0] = frame["color"]
+        crop[:, -1] = frame["color"]
+        for match in matched_by_frame[frame["color"]]:
+            for gr, gc in match["content_cells"]:
+                lr = gr - r0
+                lc = gc - c0
