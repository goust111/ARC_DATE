+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _crop_mask(mask: np.ndarray) -> tuple[np.ndarray, tuple[int, int]]:
