+
+        occupied[base_r : base_r + h, base_c : base_c + w] = True
+        occupied[fill_r : fill_r + h, fill_c : fill_c + w] = True
+        return (int(base_r), int(base_c)), (int(fill_r), int(fill_c))
+    return None
