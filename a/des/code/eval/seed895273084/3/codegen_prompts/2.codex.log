+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRY_LIMIT):
+        grid = _generate_attempt()
+        if grid is None:
+            continue
+        try:
+            out = main(grid)
+        except Exception:
+            continue
+        if out.shape == grid.shape and isinstance(out, np.ndarray):
+            return grid
+    raise RuntimeError("failed to generate a valid input")

