+def _all_signatures() -> list[tuple[int, int, int, int]]:
+    signatures = []
+    for h in range(PIECE_SIDE_MIN, PIECE_SIDE_MAX + 1):
+        for w in range(PIECE_SIDE_MIN, PIECE_SIDE_MAX + 1):
+            for cut_h in range(1, h):
