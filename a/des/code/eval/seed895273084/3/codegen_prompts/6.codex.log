+        if orient is None:
+            raise AssertionError("marker must be a straight horizontal or vertical segment")
+        markers.append(
+            {
+                "points": comp,
+                "length": len(comp),
+                "orient": orient,
+            }
+        )
+
+    if not tracks:
+        raise AssertionError("expected at least one track")
