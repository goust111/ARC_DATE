+            r0 = rng.randint(area_r0, area_r1 - track_h + 1)
+            c0 = rng.randint(area_c0, area_c1 - track_w + 1)
+            r1 = r0 + track_h - 1
+            c1 = c0 + track_w - 1
+            specs.append(((r0, c0, r1, c1), orientation, marker_len))
+            placed = True
+            break
+        if not placed:
