+            track_h, track_w = dims
+            r0 = rng.randint(1, h - track_h - 1)
+            c0 = rng.randint(1, w - track_w - 1)
+            r1 = r0 + track_h - 1
+            c1 = c0 + track_w - 1
+
+            rr0 = max(0, r0 - 1)
+            cc0 = max(0, c0 - 1)
+            rr1 = min(h, r1 + 2)
+            cc1 = min(w, c1 + 2)
+            if reserved[rr0:rr1, cc0:cc1].any():
+                continue
+
+            reserved[rr0:rr1, cc0:cc1] = True
