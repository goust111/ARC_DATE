    if len(points) == 1:
        return "h"
    if len(rows) == 1 and cols == list(range(cols[0], cols[-1] + 1)):
        return "h"
    if len(cols) == 1 and rows == list(range(rows[0], rows[-1] + 1)):
        return "v"
    return None


def _analyze_tracks(grid: np.ndarray) -> tuple[int, list[dict]]:
    g = np.asarray(grid, dtype=int)
