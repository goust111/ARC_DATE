+        path = track["path"]
+        steps = int(track["steps"])
+        clockwise = bool(track["clockwise"])
+        vals = [int(g[r, c]) for r, c in path]
+        shift = steps if clockwise else -steps
+        new_vals = _rotate(vals, shift)
+        for (r, c), v in zip(path, new_vals):
