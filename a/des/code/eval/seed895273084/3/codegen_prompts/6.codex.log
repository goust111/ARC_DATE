+def _split_intervals(start: int, stop: int, parts: int) -> list[tuple[int, int]]:
+    span = stop - start + 1
+    base = span // parts
+    extra = span % parts
+    out = []
+    cur = start
+    for i in range(parts):
+        length = base + (1 if i < extra else 0)
+        out.append((cur, cur + length - 1))
+        cur += length
+    return out
+
