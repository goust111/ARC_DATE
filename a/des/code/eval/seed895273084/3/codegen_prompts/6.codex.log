+    specs: list[tuple[tuple[int, int, int, int], str, int]] = []
+    for idx in order:
+        orientation = orientations[idx]
+        marker_len = lengths[idx]
+        placed = False
+        for _ in range(PLACEMENT_RETRIES):
+            dims = _track_bbox_candidates(rng, h, w, orientation, marker_len)
+            if dims is None:
