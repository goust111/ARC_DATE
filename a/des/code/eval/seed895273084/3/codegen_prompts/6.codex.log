+        return None
+
+    h = rng.randint(min_h, GRID_H_RANGE[1])
+    w = rng.randint(min_w, GRID_W_RANGE[1])
+    bg = rng.choice(BG_CHOICES)
+    grid = np.full((h, w), bg, dtype=int)
