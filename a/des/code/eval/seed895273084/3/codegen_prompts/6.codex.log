+    return out
+
+
+def _choose_orientations(rng: random.Random, n: int) -> list[str]:
+    orientations = [rng.choice(["h", "v"]) for _ in range(n)]
+    if n >= 2 and len(set(orientations)) == 1:
+        orientations[0] = "h"
+        orientations[1] = "v"
+    rng.shuffle(orientations)
+    return orientations
+
+
+def _paint_track(
+    grid: np.ndarray,
+    rng: random.Random,
+    bbox: tuple[int, int, int, int],
+    orientation: str,
+    marker_len: int,
+    bg: int,
