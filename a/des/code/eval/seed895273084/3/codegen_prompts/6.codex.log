from __future__ import annotations

from collections import Counter, deque
import random

import numpy as np


TRACK_COLOR = 5   # grey
MARKER_COLOR = 9  # maroon
BG_CHOICES = [0, 1, 2, 3, 4, 6, 7, 8]
BEAD_COLORS = [c for c in range(10) if c not in (TRACK_COLOR, MARKER_COLOR)]

