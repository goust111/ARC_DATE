+
+def _ring_path(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    path: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        path.append((r0, c))
+    for r in range(r0 + 1, r1 + 1):
+        path.append((r, c1))
+    for c in range(c1 - 1, c0 - 1, -1):
+        path.append((r1, c))
+    for r in range(r1 - 1, r0, -1):
