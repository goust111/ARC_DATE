+    grid[r1, c0 : c1 + 1] = int(color)
+    grid[r0 : r1 + 1, c0] = int(color)
+    grid[r0 : r1 + 1, c1] = int(color)
+
+
+def _draw_marker(grid: np.ndarray, bbox: tuple[int, int, int, int], side: str, rng: random.Random) -> None:
+    r0, c0, r1, c1 = bbox
