+def _find_rectangles(grid: np.ndarray, bg: int, legend_mask: np.ndarray) -> list[dict[str, int]]:
+    h, w = grid.shape
+    seen = np.zeros_like(grid, dtype=bool)
+    rects: list[dict[str, int]] = []
+
