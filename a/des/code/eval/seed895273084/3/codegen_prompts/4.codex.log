+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(GEN_SIZE_MIN, GEN_SIZE_MAX)
+    w = random.randint(GEN_SIZE_MIN, GEN_SIZE_MAX)
+    bg = random.choice(GEN_PALETTE)
+    palette = [color for color in GEN_PALETTE if color != bg]
