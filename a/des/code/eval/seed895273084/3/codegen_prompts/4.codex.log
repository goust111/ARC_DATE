+def _validate_generated(grid: np.ndarray, groups: list[dict[str, object]]) -> bool:
+    bg = _get_bg(grid)
+    arrows = _find_arrows(grid, bg)
+    colors = {int(group["color"]) for group in groups}
+    if set(arrows) != colors:
+        return False
+
+    wall_mask = grid == WALL
+    out = main(grid)
+    if not np.all(out[wall_mask] == WALL):
+        return False
