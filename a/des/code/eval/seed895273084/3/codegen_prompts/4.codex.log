+        return []
+
+    wall_rows = [np.flatnonzero(wall_mask[:, c]).tolist() for c in range(w)]
+    wall_cols = [np.flatnonzero(wall_mask[r, :]).tolist() for r in range(h)]
+    buckets: dict[tuple[int, int, int], int] = defaultdict(int)
