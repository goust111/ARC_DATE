+    for group in groups:
+        color = int(group["color"])
+        scatter = list(group["scatter"])
+        expected = set(_project_positions(scatter, str(group["direction"]), wall_mask, grid.shape))
+        actual = {tuple(map(int, rc)) for rc in np.argwhere(out == color)}
+        if actual != expected:
