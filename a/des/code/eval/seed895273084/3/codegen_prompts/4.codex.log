+            else:
+                low = 1
+                high = int(wc - 3) if wc is not None else w - 3
+            cols = _sample_spaced(list(range(low, high + 1)), count) if low <= high else None
+            if cols is None:
+                ok = False
+                break
+            scatter_cells.update((int(row), int(c)) for c in cols)
+        if not ok:
