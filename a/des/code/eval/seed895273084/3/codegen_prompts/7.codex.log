+) -> dict[str, int] | None:
+    r0, c0, r1, c1 = _bbox(points)
+    outer_h = r1 - r0 + 1
+    outer_w = c1 - c0 + 1
+    inner_w = outer_w - 2
+    layer_count = outer_h - 1
+    if inner_w < 1 or inner_w > 3 or layer_count < 1:
+        return None
+
+    comp_mask = np.zeros((outer_h, outer_w), dtype=bool)
+    for r, c in points:
