+        c0 = int(placement["c0"])
+        inner_w = int(placement["inner_w"])
+        key_col = int(placement["key_col"])
+        key_order = list(placement["key_order"])
+        layer_count = len(key_order)
+        c1 = c0 + inner_w + 1
+        key_top = r0 - layer_count - 1
+
+        for idx, color in enumerate(key_order):
