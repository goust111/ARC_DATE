+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    container_count = rng.randint(*CONTAINER_COUNT_RANGE)
+    specs: list[dict[str, int]] = []
+    for _ in range(container_count):
+        specs.append(
