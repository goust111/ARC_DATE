+    return containers
+
+
+def _read_layer_colors(grid: np.ndarray, container: dict[str, int]) -> list[int]:
+    r0, c0, r1, c1 = container["r0"], container["c0"], container["r1"], container["c1"]
+    colors: list[int] = []
+    for r in range(r0, r1):
+        row = grid[r, c0 + 1 : c1]
+        value = int(row[0])
