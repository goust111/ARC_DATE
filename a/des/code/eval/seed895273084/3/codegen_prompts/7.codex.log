+    candidates: list[tuple[int, int, list[int]]] = []
+    for kc in range(c0 + 1, c1):
+        if int(grid[r0 - 1, kc]) != int(bg):
+            continue
+        if key_top > 0 and int(grid[key_top - 1, kc]) != int(bg):
+            continue
