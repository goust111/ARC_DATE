+        c0 = random.randint(0, width - room_w)
+        bbox = (r0, c0, r0 + room_h - 1, c0 + room_w - 1)
+        if any(_boxes_overlap(bbox, other, GEN_ROOM_PAD) for other in placed_boxes):
