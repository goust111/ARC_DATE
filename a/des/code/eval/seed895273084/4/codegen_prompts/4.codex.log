+    expected = _expected_from_specs(grid, specs)
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+
+    counts = Counter(int(spec["exit_dir"] == direction) for spec in specs for direction in _DIRECTIONS)
+    assert counts[1] == len(specs)
+    return grid
