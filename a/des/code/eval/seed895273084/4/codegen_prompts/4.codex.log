+    return int(
+        prefix[r1 + 1, c1 + 1]
+        - prefix[r0, c1 + 1]
+        - prefix[r1 + 1, c0]
+        + prefix[r0, c0]
+    )
+
+
+def _is_arrow_component(coords: np.ndarray) -> bool:
