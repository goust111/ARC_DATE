+
+
+# --------------- generator ---------------
+
+GEN_BG = 0
+GEN_WALL = 1
+GEN_ARROW = 2
+GEN_HEIGHT_RANGE = (18, 31)
+GEN_WIDTH_RANGE = (18, 31)
+GEN_ROOM_SIDE_RANGE = (6, 11)
+GEN_ROOM_PAD = 2
+GEN_PLACE_ATTEMPTS = 200
