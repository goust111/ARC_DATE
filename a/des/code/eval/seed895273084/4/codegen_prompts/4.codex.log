+    bg, wall_color, arrow_color, arrow_comps = _infer_colors(g)
+    rooms = _locate_rooms(g, wall_color, arrow_color, arrow_comps)
+    assert len(rooms) == len(arrow_comps), "each arrow must belong to one room"
