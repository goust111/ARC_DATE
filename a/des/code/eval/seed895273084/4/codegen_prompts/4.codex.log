+        patch = g[r0 : r1 + 1, c0 : c1 + 1]
+        wall_mask = patch == int(wall_color)
+        border = np.zeros((h, w), dtype=bool)
+        border[0, :] = True
+        border[-1, :] = True
+        border[:, 0] = True
+        border[:, -1] = True
