+def _neighbors(r: int, c: int, h: int, w: int, connectivity: int):
+    directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]
+    if connectivity == 8:
+        directions += [(1, 1), (1, -1), (-1, 1), (-1, -1)]
+    for dr, dc in directions:
+        nr = r + dr
+        nc = c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            yield nr, nc
