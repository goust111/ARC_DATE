+    if not cells:
+        return False
+    h, w = shape
+    start = next(iter(cells))
+    queue = deque([start])
+    seen = {start}
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors(r, c, h, w, connectivity):
+            if (nr, nc) in cells and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                queue.append((nr, nc))
+    return len(seen) == len(cells)
