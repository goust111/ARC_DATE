+            mate = min(candidates, key=lambda cand: (cand["bbox"][0], cand["bbox"][1], cand["id"]))
+            used.add(item["id"])
+            used.add(mate["id"])
+
+            merged = np.full(shape, bg, dtype=int)
+            merged[item["mask"]] = int(item["color"])
+            merged[mate["mask"]] = int(mate["color"])
