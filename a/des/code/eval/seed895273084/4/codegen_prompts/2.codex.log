+def _get_bg(grid: np.ndarray) -> int:
+    flat = np.asarray(grid, dtype=int).ravel()
+    if flat.size == 0:
+        return 0
+    counts = np.bincount(flat, minlength=max(10, int(flat.max()) + 1))
+    return int(np.argmax(counts))
