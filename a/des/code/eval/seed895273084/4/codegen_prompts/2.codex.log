def neighbors(r,c,h,w,conn):
    dirs=[(1,0),(-1,0),(0,1),(0,-1)]
    if conn==8:
        dirs += [(1,1),(1,-1),(-1,1),(-1,-1)]
    for dr,dc in dirs:
        nr,nc=r+dr,c+dc
        if 0<=nr<h and 0<=nc<w:
            yield nr,nc

def connected(cells,h,w,conn):
    if not cells:
        return False
    cells=set(cells)
    q=deque([next(iter(cells))])
    seen={q[0]}
    while q:
        r,c=q.popleft()
        for nb in neighbors(r,c,h,w,conn):
            if nb in cells and nb not in seen:
                seen.add(nb); q.append(nb)
    return len(seen)==len(cells)

def touches_all(cells,h,w):
    rows={r for r,c in cells}; cols={c for r,c in cells}
    return 0 in rows and h-1 in rows and 0 in cols and w-1 in cols

def comp(n,k,rng):
    cuts=sorted(rng.sample(range(1,n),k-1))
    prev=0
    arr=[]
    for x in cuts+[n]:
        arr.append(x-prev); prev=x
    return arr

