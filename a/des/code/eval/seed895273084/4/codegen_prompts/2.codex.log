    seq=['D']*(h-1)+['R']*(w-1)
    rng.shuffle(seq)
    # reject degenerate full-side cases
    prefD=0
    while prefD < len(seq) and seq[prefD]=='D': prefD+=1
    prefR=0
    while prefR < len(seq) and seq[prefR]=='R': prefR+=1
    if prefD==h-1 or prefR==w-1:
        return None
    r=c=0
    pts=[(0,0)]
    for s in seq:
        if s=='D': r+=1
        else: c+=1
        pts.append((r,c))
    return set(pts)

rng=random.Random(0)
