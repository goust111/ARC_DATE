+        r0 = 0
+        for i, rlen in enumerate(row_sizes):
+            c0 = 0
+            for j, clen in enumerate(col_sizes):
+                if (i + j + phase) % 2 == 0:
+                    mask[r0 : r0 + rlen, c0 : c0 + clen] = True
+                c0 += clen
+            r0 += rlen
+
+        if rng.random() < 0.5:
+            mask = np.flip(mask, axis=0)
+        if rng.random() < 0.5:
+            mask = np.flip(mask, axis=1)
