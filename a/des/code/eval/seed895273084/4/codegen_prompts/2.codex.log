import random
from collections import deque

def neighbors4(r,c,h,w):
    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
        nr,nc=r+dr,c+dc
        if 0<=nr<h and 0<=nc<w:
            yield nr,nc

def connected(cells,h,w):
    if not cells:
        return False
    cells=set(cells)
    q=deque([next(iter(cells))])
    seen={q[0]}
    while q:
        r,c=q.popleft()
        for nb in neighbors4(r,c,h,w):
            if nb in cells and nb not in seen:
                seen.add(nb);q.append(nb)
    return len(seen)==len(cells)

def touches_all(cells,h,w):
    rows={r for r,c in cells}; cols={c for r,c in cells}
    return 0 in rows and h-1 in rows and 0 in cols and w-1 in cols

rng=random.Random(0)
trials=10000
success=0
for _ in range(trials):
    h=rng.randint(4,7); w=rng.randint(4,7)
    cells={(r,c) for r in range(h) for c in range(w) if rng.random()<0.5}
    total=h*w
    if len(cells)<4 or len(cells)>total-4:
        continue
    other={(r,c) for r in range(h) for c in range(w) if (r,c) not in cells}
    if connected(cells,h,w) and connected(other,h,w) and touches_all(cells,h,w) and touches_all(other,h,w):
        success+=1
print('success',success,'rate',success/trials)
