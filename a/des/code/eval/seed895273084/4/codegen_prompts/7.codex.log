+        _paint_bridge(out, left, right)
+    return out
+
+
+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    pair_count = int(rng.integers(2, 5))
+    min_h = pair_count * MIN_BAND_HEIGHT + (pair_count - 1) + 2
