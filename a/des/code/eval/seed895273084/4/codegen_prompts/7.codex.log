+        right_rows = list(range(band_top, band_bottom - size_right + 2))
+        if not left_rows or not right_rows:
+            return None
+        left_row = int(rng.choice(np.array(left_rows, dtype=int)))
+        if len(right_rows) > 1 and rng.random() < 0.7:
