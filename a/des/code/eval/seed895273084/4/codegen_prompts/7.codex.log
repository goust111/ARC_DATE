+from __future__ import annotations
+
+from collections import defaultdict
+
+import numpy as np
+
+
+BG_COLORS = (0, 5)
+PAIR_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+TEXTURES = ("solid", "horizontal", "vertical")
+MAX_ATTEMPTS = 400
+MIN_BAND_HEIGHT = 5
