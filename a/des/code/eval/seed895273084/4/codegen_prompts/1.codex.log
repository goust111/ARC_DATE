+            grid[fr + frame_size - 1, fc : fc + frame_size] = frame_color
+            grid[fr : fr + frame_size, fc] = frame_color
+            grid[fr : fr + frame_size, fc + frame_size - 1] = frame_color
+            interior = grid[fr + 1 : fr + frame_size - 1, fc + 1 : fc + frame_size - 1]
