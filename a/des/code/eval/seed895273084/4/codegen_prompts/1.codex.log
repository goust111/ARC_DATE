+def _mark(blocked: np.ndarray, r0: int, c0: int, size: int) -> None:
+    h, w = blocked.shape
+    r1 = r0 + size - 1
+    c1 = c0 + size - 1
+    rr0 = max(0, r0 - 1)
+    cc0 = max(0, c0 - 1)
+    rr1 = min(h, r1 + 2)
+    cc1 = min(w, c1 + 2)
+    blocked[rr0:rr1, cc0:cc1] = True
+
