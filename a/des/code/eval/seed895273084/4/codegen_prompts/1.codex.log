+    h, w = blocked.shape
+    r1 = r0 + size - 1
+    c1 = c0 + size - 1
+    rr0 = max(0, r0 - 1)
+    cc0 = max(0, c0 - 1)
+    rr1 = min(h, r1 + 2)
+    cc1 = min(w, c1 + 2)
