+def _make_sprite_mask(size: int, direction: str, rng: random.Random) -> np.ndarray:
+    base = _make_base_mask(size, rng)
+    defect_up = _remove_top_chunk(base, rng)
+    return np.rot90(defect_up, ROTATIONS_FROM_UP[direction])
