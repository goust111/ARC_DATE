+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    interior_size = rng.choice(INTERIOR_SIZES)
+    frame_size = interior_size + 2
+    legend_width = 4 * ENTRY_W + 3 * ENTRY_GAP
