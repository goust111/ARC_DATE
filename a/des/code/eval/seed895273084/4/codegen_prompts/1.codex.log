+        for r in range(top, min(size, top + depth)):
+            span = half_width
+            if tapered:
+                span = max(0, half_width - (r - top))
+            remove[r, max(0, center - span) : min(size, center + span + 1)] = True
+        remove &= base
+        if np.any(remove):
+            choices.append(remove)
+
+    if not choices:
