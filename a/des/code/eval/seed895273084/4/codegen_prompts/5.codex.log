+        if seen & cells:
+            return False
+        seen |= cells
+    return True
+
+
+def _sample_columns(count: int) -> tuple[list[int], int]:
+    left_margin = random.randint(SIDE_MARGIN_MIN, SIDE_MARGIN_MAX)
+    right_margin = random.randint(SIDE_MARGIN_MIN, SIDE_MARGIN_MAX)
+    cols = [left_margin]
