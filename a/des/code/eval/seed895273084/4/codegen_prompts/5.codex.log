+        source_cell = (int(src["top_row"]), int(src["col"]))
+        for r, c in _ray_path(towers, src, dst):
+            if structural[int(r), int(c)] and (int(r), int(c)) != source_cell:
+                continue
+            out[int(r), int(c)] = color
+    return out
+
