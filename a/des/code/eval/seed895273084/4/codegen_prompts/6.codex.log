+    assert all(len(v) == 2 for v in nbrs.values()), "track must be a simple 4-connected cycle"
+
+    start = min(pts)
+    order = [start]
+    prev = None
+    cur = start
+    while True:
+        a, b = nbrs[cur]
+        nxt = a if a != prev else b
