  69: def main(grid: np.ndarray) -> np.ndarray:
  70:     """
  71:     Swap paired marker pixels across the largest foreground-color barrier, placing them just outside the barrier segment.
  72: 
  73:     Input structure:
  74:     - The background is the dominant color.
  75:     - One foreground color is the unique most frequent non-background color; its pixels form the stationary barrier.
  76:     - Other foreground pixels are single markers, sometimes paired on opposite sides of one contiguous barrier segment in the same row or column.
  77: 
  78:     Rule:
  79:     - Scan each row and column that crosses exactly one contiguous barrier segment.
  80:     - If the line has exactly one marker on each side of that segment, erase both source markers and place each marker in the cell immediately beyond the opposite side of the segment.
  81:     - Lines with markers on only one side are unchanged; the barrier remains unchanged.
  82: 
  83:     Key insight:
  84:     - The marker pairing is local to a row or column, and the destination is defined by the nearest cells outside the intervening barrier segment, not by the original distance from the barrier.
  85:     """
  86:     g = np.asarray(grid, dtype=int)
  87:     bg = get_bg(g)
  88:     barrier = _barrier_color(g, bg)
  89: 
  90:     clears: list[tuple[int, int]] = []
  91:     paints: list[tuple[int, int, int]] = []
  92:     height, width = g.shape
  93: 
  94:     for r in range(height):
  95:         for src, dst, color in _line_moves(g[r, :], barrier, bg):
  96:             clears.append((int(r), int(src)))
  97:             paints.append((int(r), int(dst), int(color)))
  98: 
  99:     for c in range(width):
 100:         for src, dst, color in _line_moves(g[:, c], barrier, bg):
 101:             clears.append((int(src), int(c)))
 102:             paints.append((int(dst), int(c), int(color)))
 103: 
 104:     assert clears, "expected at least one marker pair"
 105:     assert len(clears) == len(set(clears)), "a marker cannot move in two directions"
 106:     destinations = [(r, c) for r, c, _ in paints]
 107:     assert len(destinations) == len(set(destinations)), "destination cells must be unique"
 108:     assert all(int(g[r, c]) not in (int(bg), int(barrier)) for r, c in clears), "sources must be markers"
 109:     assert all(int(g[r, c]) == int(bg) for r, c, _ in paints), "destinations must start as background"
 110: 
 111:     out = g.copy()
 112:     for r, c in clears:
 113:         out[r, c] = int(bg)
 114:     for r, c, color in paints:
 115:         out[r, c] = int(color)
 116:     return out
