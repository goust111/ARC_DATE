import random
from collections import Counter, deque
import numpy as np

BG=0
YELLOW=4
GREY=5
TRAIN_COLORS=[1,2,3,6,7,8,9]

def neighbors4(r,c):
    return ((r-1,c),(r+1,c),(r,c-1),(r,c+1))

def components(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    out=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            q=deque([(r,c)])
            seen[r,c]=True
            comp=[]
            while q:
                cr,cc=q.popleft(); comp.append((cr,cc))
                for nr,nc in neighbors4(cr,cc):
                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc]=True; q.append((nr,nc))
            out.append(comp)
    return out

def cycle_order(comp):
    s=set(comp)
    nbr={p:[q for q in neighbors4(*p) if q in s] for p in s}
    assert all(len(v)==2 for v in nbr.values()), {k:v for k,v in nbr.items() if len(v)"'!=2}
    start=min(s)
    order=[start]
    prev=None
    cur=start
    while True:
        opts=nbr[cur]
        nxt=opts[0] if opts[0]!=prev else opts[1]
        if nxt==start:
            break
        order.append(nxt)
        prev,cur=cur,nxt
        if len(order)>len(s):
            raise AssertionError('"'loop too long')
    assert len(order)==len(s), (len(order), len(s))
    area2=0
    for (r1,c1),(r2,c2) in zip(order, order[1:]+order[:1]):
        area2 += c1*r2 - c2*r1
    if area2 < 0:
        order=order[:1]+list(reversed(order[1:]))
    return order

def interior_mask(comp):
    rs=[r for r,_ in comp]; cs=[c for _,c in comp]
    r0,r1=min(rs),max(rs); c0,c1=min(cs),max(cs)
    blocked=np.zeros((r1-r0+3,c1-c0+3),dtype=bool)
    for r,c in comp:
        blocked[r-r0+1,c-c0+1]=True
    outside=np.zeros_like(blocked,dtype=bool)
    q=deque()
    H,W=blocked.shape
    for r in range(H):
        for c in (0,W-1):
            if not blocked[r,c] and not outside[r,c]:
                outside[r,c]=True; q.append((r,c))
    for c in range(W):
        for r in (0,H-1):
            if not blocked[r,c] and not outside[r,c]:
                outside[r,c]=True; q.append((r,c))
    while q:
        r,c=q.popleft()
        for nr,nc in neighbors4(r,c):
            if 0<=nr<H and 0<=nc<W and not blocked[nr,nc] and not outside[nr,nc]:
                outside[nr,nc]=True; q.append((nr,nc))
    return (~blocked) & (~outside), (r0,c0)

def walk(vertices):
    order=[]
    pts=vertices+vertices[:1]
    for (r1,c1),(r2,c2) in zip(pts,pts[1:]):
        dr=0 if r1==r2 else (1 if r2>r1 else -1)
        dc=0 if c1==c2 else (1 if c2>c1 else -1)
        steps=max(abs(r2-r1),abs(c2-c1))
        for k in range(steps):
            order.append((r1+dr*k,c1+dc*k))
    return order

def make_rect(h,w):
    return walk([(0,0),(0,w-1),(h-1,w-1),(h-1,0)])

def make_notch(h,w,side,a,b,x):
    if side=='right':
        verts=[(0,0),(0,w-1),(a,w-1),(a,x),(b,x),(b,w-1),(h-1,w-1),(h-1,0)]
    elif side=='left':
        verts=[(0,0),(0,w-1),(h-1,w-1),(h-1,0),(b,0),(b,x),(a,x),(a,0)]
    elif side=='top':
        verts=[(0,0),(0,a),(x,a),(x,b),(0,b),(0,w-1),(h-1,w-1),(h-1,0)]
    elif side=='bottom':
        verts=[(0,0),(0,w-1),(h-1,w-1),(h-1,b),(x,b),(x,a),(h-1,a),(h-1,0)]
    return walk(verts)

def gen_shape(kind):
    if kind=='rect':
