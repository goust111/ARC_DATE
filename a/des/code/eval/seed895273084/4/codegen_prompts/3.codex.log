+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+
+    return comps
+
+
+def _touches_edge(cells: list[tuple[int, int]], h: int, w: int) -> bool:
+    return any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in cells)
+
+
+def _layer_distances_from_outline(
+    grid: np.ndarray, cells: list[tuple[int, int]]
+) -> dict[tuple[int, int], int]:
+    h, w = grid.shape
+    region = set(cells)
+    dist: dict[tuple[int, int], int] = {}
+    q = deque()
+
+    for r, c in cells:
+        if any(int(grid[nr, nc]) == OUTLINE for nr, nc in _neighbors4(r, c, h, w)):
+            dist[(r, c)] = 1
