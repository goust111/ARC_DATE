+
+BG = 0
+BLUE = 1
+SEED = 2
+GREEN = 3
+YELLOW = 4
+OUTLINE = 5
+MAGENTA = 6
+ORANGE = 7
+
+LAYER_COLORS = (BLUE, GREEN, YELLOW, MAGENTA, ORANGE)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+GRID_H_RANGE = (22, 30)
+GRID_W_RANGE = (22, 30)
+OBJECT_COUNT_VALUES = (1, 2, 3, 4)
+OBJECT_COUNT_WEIGHTS = (2, 4, 3, 1)
+MAX_SEEDS = 5
+EDGE_MARGIN = 1
+OBJECT_GAP = 2
+SHAPE_RETRIES = 80
+PLACEMENT_RETRIES = 120
+GEN_RETRIES = 400
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+
+    return comps
+
+
+def _touches_edge(cells: list[tuple[int, int]], h: int, w: int) -> bool:
+    return any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in cells)
+
+
+def _layer_distances_from_outline(
+    grid: np.ndarray, cells: list[tuple[int, int]]
+) -> dict[tuple[int, int], int]:
+    h, w = grid.shape
+    region = set(cells)
+    dist: dict[tuple[int, int], int] = {}
+    q = deque()
+
+    for r, c in cells:
+        if any(int(grid[nr, nc]) == OUTLINE for nr, nc in _neighbors4(r, c, h, w)):
+            dist[(r, c)] = 1
+            q.append((r, c))
