+
+    while q:
+        r, c = q.popleft()
+        nd = dist[(r, c)] + 1
+        for nr, nc in _neighbors4(r, c, h, w):
+            if (nr, nc) in region and (nr, nc) not in dist:
+                dist[(nr, nc)] = nd
+                q.append((nr, nc))
