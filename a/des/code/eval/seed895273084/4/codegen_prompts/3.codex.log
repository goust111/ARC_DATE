+    boundary = obj["boundary"]
+    seeds = obj["seeds"]
+
+    for r0, c0 in positions[:PLACEMENT_RETRIES]:
+        r1 = r0 + obj_h - 1
+        c1 = c0 + obj_w - 1
+        rs = max(0, r0 - OBJECT_GAP)
