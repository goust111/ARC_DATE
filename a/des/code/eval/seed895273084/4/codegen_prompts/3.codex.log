+BG = 0
+BLUE = 1
+SEED = 2
+GREEN = 3
+YELLOW = 4
+OUTLINE = 5
+MAGENTA = 6
+ORANGE = 7
+
+LAYER_COLORS = (BLUE, GREEN, YELLOW, MAGENTA, ORANGE)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+GRID_H_RANGE = (22, 30)
+GRID_W_RANGE = (22, 30)
+OBJECT_COUNT_VALUES = (1, 2, 3, 4)
+OBJECT_COUNT_WEIGHTS = (2, 4, 3, 1)
+MAX_SEEDS = 5
+EDGE_MARGIN = 1
+OBJECT_GAP = 2
+SHAPE_RETRIES = 80
+PLACEMENT_RETRIES = 120
+GEN_RETRIES = 400
