+import numpy as np
+
+
+BG = 0
+GREEN = 3
+GREY = 5
+MAROON = 9
+SOURCE_COLORS = [1, 2, 4, 6, 7, 8]
+SPECIAL = {BG, GREEN, GREY, MAROON}
