+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _orientation_map(cells: list[tuple[int, int]]) -> dict[tuple[int, int], str]:
+    orient: dict[tuple[int, int], str] = {}
+    for i, cell in enumerate(cells):
+        if i == 0:
+            nxt = cells[1]
+            orient[cell] = "H" if nxt[0] == cell[0] else "V"
+        elif i == len(cells) - 1:
+            prv = cells[-2]
+            orient[cell] = "H" if prv[0] == cell[0] else "V"
+        else:
+            prv, nxt = cells[i - 1], cells[i + 1]
+            if prv[0] == nxt[0] == cell[0]:
+                orient[cell] = "H"
+            elif prv[1] == nxt[1] == cell[1]:
+                orient[cell] = "V"
+            else:
+                orient[cell] = "HV"
+    return orient
