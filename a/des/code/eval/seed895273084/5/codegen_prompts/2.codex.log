+RECT_SIDE_MAX_EXCLUSIVE = 8
+MAX_GENERATION_ATTEMPTS = 300
+PAIR_SAMPLE_ATTEMPTS = 120
+SHAPE_SAMPLE_ATTEMPTS = 80
+PLACEMENT_ATTEMPTS = 500
+
