+        assert matches[j] == i, "pairing must be symmetric"
+        used.add(i)
+        used.add(j)
+
+        first = components[i]
+        second = components[j]
+        if tuple(first["bbox"][:2]) <= tuple(second["bbox"][:2]):
+            anchor, other = first, second
+        else:
+            anchor, other = second, first
+        assert _shape_matches_negative(anchor, other), "chosen anchor must match its partner"
+        pairs.append((anchor, other))
+
+    assert len(used) == n
+    return pairs
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Pair complementary fragments, complete rectangles, and pack them by area."""
+    g = np.asarray(grid, dtype=int)
