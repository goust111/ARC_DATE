+
+def _pair_components(components: list[dict[str, object]]) -> list[tuple[dict[str, object], dict[str, object]]]:
+    n = len(components)
+    assert n > 0 and n % 2 == 0, "expected a positive even number of fragments"
+
+    matches: list[int] = []
+    for i, anchor in enumerate(components):
