+
+def _build_template_cache() -> dict[str, dict[tuple[int, ...], list[np.ndarray]]]:
+    library: dict[str, dict[tuple[int, ...], list[np.ndarray]]] = {
+        side: defaultdict(list) for side in SIDES
+    }
