+    for h in range(1, 5):
+        for w in range(1, 5):
+            cell_count = h * w
+            coords = [(r, c) for r in range(h) for c in range(w)]
+            for area in range(3, 6):
+                if area > cell_count:
+                    continue
+                for subset in itertools.combinations(range(cell_count), area):
+                    mask = np.zeros((h, w), dtype=bool)
+                    for idx in subset:
