+        vectors.append((dr, dc))
+        shifted_green = {(r + dr, c + dc) for r, c in green}
+        shifted_anchors = {(r + dr, c + dc) for r, c in anchors}
+        green |= shifted_green
+        anchors |= shifted_anchors
+
+    return vectors
