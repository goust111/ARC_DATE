+            dr = random.randint(-max(1, height // 2), max(1, height // 2))
+        elif direction == "v":
+            dr_mag = random.randint(height + 2, height + 5)
+            dr = dr_mag if random.random() < 0.5 else -dr_mag
+            dc = random.randint(-max(1, width // 2), max(1, width // 2))
+        else:
