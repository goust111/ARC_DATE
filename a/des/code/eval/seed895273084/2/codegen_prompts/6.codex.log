+        grey_dirs.append(grey_dir)
+
+    cursor = 0
+    placements = []
+    width_need = 0
+    for dr, dc, (grey_dr, grey_dc) in zip(vectors, grey_dirs, strict=False):
+        rel_rows = (0, dr, grey_dr)
