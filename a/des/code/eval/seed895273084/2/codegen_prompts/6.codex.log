+    final_green = _final_green_offsets(offsets, vectors)
+    min_r, max_r, min_c, max_c = _bbox(final_green)
+    right_height = (max_r - min_r + 1) + random.randint(2, 5)
+    right_width = (max_c - min_c + 1) + random.randint(2, 5)
