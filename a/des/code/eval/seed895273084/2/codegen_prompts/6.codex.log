+        (row, col)
+        for row, col in neighbors
+        if 0 <= row < bbox_h and 0 <= col < bbox_w
+    ]
+    outside = [
+        (row, col)
+        for row, col in neighbors
+        if row < 0 or row >= bbox_h or col < 0 or col >= bbox_w
+    ]
+    return inside, outside
+
+
+def _sample_motif() -> tuple[list[tuple[int, int]], bool]:
