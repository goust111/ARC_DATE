+def _anchor_positions(vectors: list[tuple[int, int]]) -> set[tuple[int, int]]:
+    anchors = {(0, 0)}
+    for dr, dc in vectors:
+        translated = {(r + dr, c + dc) for r, c in anchors}
+        anchors |= translated
+    return anchors
