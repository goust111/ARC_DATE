+    for grey_dr, grey_dc in NEIGHBORS4:
+        if (grey_dr, grey_dc) == (dr, dc):
+            continue
+        if abs(grey_dr - dr) + abs(grey_dc - dc) == 1:
+            continue
+        choices.append((grey_dr, grey_dc))
+    return random.choice(choices) if choices else None
