+
+def _shape_candidates(cells: set[tuple[int, int]]) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    bbox_h = max(r for r, _c in cells) + 1
+    bbox_w = max(c for _r, c in cells) + 1
