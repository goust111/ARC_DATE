+
+def _trim_cells(cells: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    min_r = min(r for r, _c in cells)
+    min_c = min(c for _r, c in cells)
+    return {(r - min_r, c - min_c) for r, c in cells}
