    eroded[:, :-1] &= blue[:, 1:]   # neighbor right
    eroded[:, 1:]  &= blue[:, :-1]  # neighbor left
    rs, cs = np.where(eroded)
    coords = list(zip(rs.tolist(), cs.tolist()))
    random.shuffle(coords)
    return coords


