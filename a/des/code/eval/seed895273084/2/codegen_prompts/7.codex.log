+        for edge_key in shared:
+            dist1 = _edge_side_distances(nodes1, edge_key)
+            dist2 = _edge_side_distances(nodes2, edge_key)
+            u, v = edge_key
+            if (dist1[u] - dist2[u]) * (dist1[v] - dist2[v]) < 0:
