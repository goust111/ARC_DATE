+        raise ValueError("tree path not found")
+    nodes = [goal]
+    edges = []
+    cur = goal
+    while parent[cur] is not None:
+        prev, edge_key = parent[cur]
+        edges.append(edge_key)
+        nodes.append(prev)
+        cur = prev
+    nodes.reverse()
+    edges.reverse()
