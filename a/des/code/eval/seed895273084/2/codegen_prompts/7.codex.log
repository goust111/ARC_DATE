+    return None
+
+
+def _marker_candidates(
+    room_bbox: tuple[int, int, int, int], forbidden: set[tuple[int, int]]
+) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = room_bbox
+    candidates = []
+    for r in range(r0, r1 + 1):
