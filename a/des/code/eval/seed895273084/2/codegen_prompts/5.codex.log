+
+def _missing_side(r: int, c: int, h: int, w: int) -> str | None:
+    sides = []
+    if r == 0:
+        sides.append("top")
+    if r == h - 1:
+        sides.append("bottom")
+    if c == 0:
+        sides.append("left")
+    if c == w - 1:
+        sides.append("right")
