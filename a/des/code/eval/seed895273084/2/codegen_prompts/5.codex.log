+
+
+def _rotate_for_side(pattern: np.ndarray, side: str) -> np.ndarray:
+    ccw_turns = {"top": 0, "right": 3, "bottom": 2, "left": 1}[side]
+    return np.rot90(pattern, ccw_turns)
