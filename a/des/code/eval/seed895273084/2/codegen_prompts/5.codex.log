                continue
            nxt = rng.choice(neighbors)
            cells.add(nxt)
            frontier.append(nxt)

        if len(cells) < min_cells:
            continue

        mask = np.zeros((h, w), dtype=bool)
        for r, c in cells:
            mask[r, c] = True
        if np.all(mask) or not np.any(mask):
