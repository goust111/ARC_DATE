+            occupied[top : top + h, left : left + w] = True
+            placed = True
+            break
+        if not placed:
+            return None
+    return grid
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    pair_count = rng.randint(1, 3)
