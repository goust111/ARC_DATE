+        left = c0 + 1 + (inner_w - pw) // 2
+        view = out[top : top + ph, left : left + pw]
+        mask = pattern != AZURE
+        view[mask] = pattern[mask]
+
+    return out
+
+
+def _random_asymmetric_mask(h: int, w: int, rng: random.Random) -> np.ndarray:
+    min_cells = max(3, (h * w) // 4)
