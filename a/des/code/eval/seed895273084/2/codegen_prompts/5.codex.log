+        for _ in range(PLACEMENT_RETRIES):
+            top = rng.randint(0, canvas_h - h)
+            left = rng.randint(0, canvas_w - w)
+            if not _can_place(occupied, top, left, h, w):
+                continue
+            grid[top : top + h, left : left + w] = patch
+            occupied[top : top + h, left : left + w] = True
+            placed = True
