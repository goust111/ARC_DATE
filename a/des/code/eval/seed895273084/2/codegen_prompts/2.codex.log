+    if grid is None:
+        return None
+
+    if len(_components(grid, BG)) != piece_count:
+        return None
+    try:
+        solved = main(grid)
+    except AssertionError:
+        return None
+    if not np.array_equal(solved, expected):
+        return None
+    return grid
+
