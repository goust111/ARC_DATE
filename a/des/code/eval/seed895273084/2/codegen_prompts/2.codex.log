+    return None
+
+
+def _touching_without_overlap(cells_a: set[tuple[int, int]], cells_b: set[tuple[int, int]], delta: tuple[int, int]) -> bool:
+    dr, dc = delta
+    shifted_b = {(r + dr, c + dc) for r, c in cells_b}
+    if not cells_a.isdisjoint(shifted_b):
