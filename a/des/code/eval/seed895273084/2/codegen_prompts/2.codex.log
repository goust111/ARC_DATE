+            cols = [c0 for _, c0 in coords]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            patch = grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+            comps.append({"bbox": (r0, c0, r1, c1), "coords": coords, "patch": patch})
