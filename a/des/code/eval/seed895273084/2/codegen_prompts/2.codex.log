+
+
+def _match_delta(desc_a: dict, desc_b: dict) -> tuple[int, int] | None:
+    pa = desc_a["profile"]
+    pb = desc_b["profile"]
+    if desc_a["side"] == "right" and desc_b["side"] == "left":
