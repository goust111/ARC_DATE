296: def _build_ownership(N: int, p: int, tab_specs: dict) -> np.ndarray | None:
297:     """Build 2Nx2N quadrant-ownership grid with tab intrusions.
298: 
299:     tab_specs maps tab name -> (depth, direction) or None.
300:     Returns (2N,2N) array with values TL/TR/BL/BR, or None if any
301:     quadrant region is empty or not 8-connected.
302:     """
303:     S = 2 * N
304:     own = np.zeros((S, S), dtype=int)
305:     own[:N, :N] = TL
306:     own[:N, N:] = TR
307:     own[N:, :N] = BL
308:     own[N:, N:] = BR
309: 
310:     # H-tabs: single-column strips crossing the horizontal boundary (row N)
311:     for kind, col, up_owner, down_owner in [
312:         ('H_left',  p,         BL, TL),
313:         ('H_right', S - 1 - p, BR, TR),
314:     ]:
315:         spec = tab_specs.get(kind)
316:         if spec is None:
317:             continue
318:         depth, direction = spec
319:         if direction == 'up':
320:             own[N - depth:N, col] = up_owner
321:         else:
322:             own[N:N + depth, col] = down_owner
323: 
324:     # V-tabs: single-row strips crossing the vertical boundary (col N)
325:     for kind, row, left_owner, right_owner in [
326:         ('V_top', p,         TR, TL),
327:         ('V_bot', S - 1 - p, BR, BL),
328:     ]:
329:         spec = tab_specs.get(kind)
330:         if spec is None:
331:             continue
