    if grid is None:
        continue
    comps = mod._components(grid, mod.BG)
    print('component_count', len(comps))
    try:
        solved = mod.main(grid)
        print('main ok', solved.shape, 'expected', expected.shape, 'equal', np.array_equal(solved, expected))
    except AssertionError as e:
        print('main assertion', e)
    print()
