+
+
+def _side_descriptor(patch: np.ndarray, bg: int, side: str) -> dict:
+    mask = patch != bg
+    h, w = patch.shape
+    if side in ("left", "right"):
+        profile = []
+        boundary = []
+        for r in range(h):
