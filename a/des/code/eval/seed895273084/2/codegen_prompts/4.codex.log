+    row_size = (max(h1, h2), w1 + gap + w2)
+    col_size = (h1 + gap + h2, max(w1, w2))
+
+    row_score = max(row_size)
+    col_score = max(col_size)
+    if abs(row_score - col_score) <= 3:
+        layout = rng.choice(["row", "col"])
+    else:
+        layout = "row" if row_score < col_score else "col"
+
+    if layout == "row":
