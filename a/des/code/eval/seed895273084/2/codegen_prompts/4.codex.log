+    if r0 == r1 and len(comp) == c1 - c0 + 1:
+        if cells == {(r0, c) for c in range(c0, c1 + 1)}:
+            return {
+                "orientation": "H",
+                "color": int(color),
+                "index": int(r0),
+                "span0": int(c0),
+                "span1": int(c1),
