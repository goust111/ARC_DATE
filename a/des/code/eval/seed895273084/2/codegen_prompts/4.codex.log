+        prev = idx
+    return run
+
+
+def _frame_stripes(frame: dict, arrow: dict, stripes: list[dict]) -> list[dict]:
+    r0, c0, r1, c1 = frame["bbox"]
+    ar0, ac0, ar1, ac1 = arrow["bbox"]
+    direction = arrow["direction"]
+    if direction == "right":
+        candidates = [
+            s
+            for s in stripes
+            if s["orientation"] == "V"
+            and s["span0"] == r0 + 1
+            and s["span1"] == r1 - 1
+            and s["index"] < ac0
+        ]
+        candidates.sort(key=lambda s: -int(s["index"]))
+    elif direction == "left":
+        candidates = [
+            s
+            for s in stripes
+            if s["orientation"] == "V"
+            and s["span0"] == r0 + 1
+            and s["span1"] == r1 - 1
+            and s["index"] > ac1
+        ]
+        candidates.sort(key=lambda s: int(s["index"]))
+    elif direction == "down":
+        candidates = [
+            s
+            for s in stripes
+            if s["orientation"] == "H"
+            and s["span0"] == c0 + 1
+            and s["span1"] == c1 - 1
+            and s["index"] < ar0
+        ]
+        candidates.sort(key=lambda s: -int(s["index"]))
+    else:
+        candidates = [
+            s
+            for s in stripes
+            if s["orientation"] == "H"
+            and s["span0"] == c0 + 1
+            and s["span1"] == c1 - 1
