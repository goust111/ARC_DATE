+    cells = set(comp)
+    if c0 == c1 and len(comp) == r1 - r0 + 1:
+        if cells == {(r, c0) for r in range(r0, r1 + 1)}:
+            return {
+                "orientation": "V",
+                "color": int(color),
+                "index": int(c0),
+                "span0": int(r0),
+                "span1": int(r1),
