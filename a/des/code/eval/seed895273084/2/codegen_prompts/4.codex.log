+    inp = np.full((patch_h, patch_w), BG, dtype=int)
+    out = np.full_like(inp, BG)
+    _paint_frame(inp, fr0, fc0, fr1, fc1)
+    _paint_frame(out, fr0, fc0, fr1, fc1)
