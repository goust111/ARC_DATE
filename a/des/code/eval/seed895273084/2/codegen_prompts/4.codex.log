+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+ARROW = 2
+FRAME = 5
+STRIPE_PALETTE = [1, 3, 4, 6, 7, 8, 9]
+DIRECTIONS = ("up", "down", "left", "right")
+GEN_ATTEMPTS = 300
+
+ARROW_PATTERNS = {
+    "right": {
+        "cells": frozenset({(1, 0), (1, 1), (1, 2), (0, 2), (2, 2)}),
+        "tip": (1, 2),
+    },
+    "left": {
+        "cells": frozenset({(1, 0), (1, 1), (1, 2), (0, 0), (2, 0)}),
+        "tip": (1, 0),
+    },
+    "down": {
+        "cells": frozenset({(0, 1), (1, 1), (2, 1), (2, 0), (2, 2)}),
+        "tip": (2, 1),
+    },
+    "up": {
+        "cells": frozenset({(0, 0), (0, 1), (0, 2), (1, 1), (2, 1)}),
+        "tip": (0, 1),
+    },
+}
+
+ARROW_OFFSETS = {
+    "right": [(0, 0), (0, -1), (0, -2), (-1, 0), (1, 0)],
+    "left": [(0, 0), (0, 1), (0, 2), (-1, 0), (1, 0)],
+    "down": [(0, 0), (-1, 0), (-2, 0), (0, -1), (0, 1)],
+    "up": [(0, 0), (1, 0), (2, 0), (0, -1), (0, 1)],
+}
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while queue:
+                cr, cc = queue.popleft()
+                comp.append((int(cr), int(cc)))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _paint_frame(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int) -> None:
+    grid[r0, c0 : c1 + 1] = FRAME
+    grid[r1, c0 : c1 + 1] = FRAME
+    grid[r0 : r1 + 1, c0] = FRAME
+    grid[r0 : r1 + 1, c1] = FRAME
+
+
+def _find_frames(grid: np.ndarray) -> list[dict]:
+    frames: list[dict] = []
+    for comp in _components(grid == FRAME):
+        r0, c0, r1, c1 = _bbox(comp)
+        if r1 - r0 < 2 or c1 - c0 < 2:
+            continue
+        expected = set()
+        for c in range(c0, c1 + 1):
+            expected.add((r0, c))
+            expected.add((r1, c))
+        for r in range(r0 + 1, r1):
+            expected.add((r, c0))
+            expected.add((r, c1))
+        if set(comp) != expected:
+            continue
