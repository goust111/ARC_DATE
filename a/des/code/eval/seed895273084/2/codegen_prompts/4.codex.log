+    elif direction == "down":
+        for idx, color in enumerate(colors[: frame["inner_h"]]):
+            out[r1 - 1 - idx, c0 + 1 : c1] = int(color)
+    else:
+        for idx, color in enumerate(colors[: frame["inner_h"]]):
+            out[r0 + 1 + idx, c0 + 1 : c1] = int(color)
