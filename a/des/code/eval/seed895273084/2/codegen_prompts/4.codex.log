+        for idx, color in enumerate(colors[: frame["inner_w"]]):
+            out[r0 + 1 : r1, c1 - 1 - idx] = int(color)
+    elif direction == "left":
+        for idx, color in enumerate(colors[: frame["inner_w"]]):
