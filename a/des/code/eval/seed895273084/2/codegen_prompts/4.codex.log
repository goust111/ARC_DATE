+
+def _random_object(rng: random.Random, direction: str | None = None) -> tuple[np.ndarray, np.ndarray]:
+    direction = direction or rng.choice(DIRECTIONS)
+    inner_h = rng.randint(3, 5)
+    inner_w = rng.randint(3, 5)
