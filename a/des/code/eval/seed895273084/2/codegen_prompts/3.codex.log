+    grid = np.vstack([padded_top, separator, padded_bottom])
+    expected = _build_expected(grid, padded_top.shape[0], jobs)
+
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
