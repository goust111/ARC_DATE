+
+def _count_satellites(g: np.ndarray, r: int, c: int) -> int:
+    r0 = max(0, r - 3)
+    r1 = min(g.shape[0], r + 4)
+    c0 = max(0, c - 3)
+    c1 = min(g.shape[1], c + 4)
+    return int(np.count_nonzero(g[r0:r1, c0:c1] == SATELLITE))
