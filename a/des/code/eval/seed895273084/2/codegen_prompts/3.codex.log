def _neighbors8(r: int, c: int):
    for dr in (-1, 0, 1):
        for dc in (-1, 0, 1):
            if dr == 0 and dc == 0:
                continue
            yield r + dr, c + dc


def _is_connected8(coords: list[tuple[int, int]]) -> bool:
    if not coords:
        return False
    remaining = set(coords)
    stack = [coords[0]]
    seen = set()
    while stack:
        cell = stack.pop()
        if cell in seen:
            continue
        seen.add(cell)
        for nxt in _neighbors8(*cell):
            if nxt in remaining and nxt not in seen:
                stack.append(nxt)
    return len(seen) == len(remaining)


def _find_separator_row(g: np.ndarray) -> tuple[int, int]:
    rows = [
        int(r)
        for r in range(g.shape[0])
        if np.all(g[r, :] == g[r, 0]) and int(g[r, 0]) != BG
