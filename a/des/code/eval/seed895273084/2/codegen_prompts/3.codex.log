+        job["abs_center"] = (top.shape[0] + 1 + center[0], center[1])
+        r, c = center
+        color = int(job["color"])
+        bottom[r, c] = color
+        for dr, dc in job["satellites"]:
+            rr = r + dr
+            cc = c + dc
+            if bottom[rr, cc] != BG:
