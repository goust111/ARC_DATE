+
+BG = 0
+SATELLITE = 4
+SEPARATOR = 5
+PALETTE = [1, 2, 3, 6, 7, 8, 9]
+MAX_GENERATION_ATTEMPTS = 400
+
+
+TEMPLATE_LIBRARY = (
+    frozenset(
+        (dr, dc)
+        for dr in range(-1, 2)
+        for dc in range(-1, 2)
+        if (dr, dc) != (0, 0)
+    ),
+    frozenset(
+        (dr, dc)
+        for dr in range(-2, 3)
+        for dc in range(-2, 3)
