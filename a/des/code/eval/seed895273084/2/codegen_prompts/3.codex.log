+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+SATELLITE = 4
+SEPARATOR = 5
+PALETTE = [1, 2, 3, 6, 7, 8, 9]
+MAX_GENERATION_ATTEMPTS = 400
+
+
+TEMPLATE_LIBRARY = (
+    frozenset(
+        (dr, dc)
+        for dr in range(-1, 2)
+        for dc in range(-1, 2)
+        if (dr, dc) != (0, 0)
+    ),
+    frozenset(
+        (dr, dc)
+        for dr in range(-2, 3)
+        for dc in range(-2, 3)
+        if abs(dr) + abs(dc) == 2
+    ),
+    frozenset(
+        (dr, dc)
+        for dr in range(-2, 3)
+        for dc in range(-2, 3)
+        if max(abs(dr), abs(dc)) == 2
+    ),
+    frozenset(
+        (dr, dc)
+        for dr in range(-2, 3)
+        for dc in range(-2, 3)
+        if (abs(dr) == 2 and abs(dc) <= 1)
+        or (abs(dc) == 2 and abs(dr) <= 1)
+        or (abs(dr) == 1 and abs(dc) == 1)
+    ),
+    frozenset(
+        (dr, dc)
+        for dr in range(-2, 3)
+        for dc in range(-2, 3)
+        if abs(dr) + abs(dc) == 2 or (abs(dr) == abs(dc) and (dr, dc) != (0, 0))
+    ),
+)
