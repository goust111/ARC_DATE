+        return False
+    remaining = set(coords)
+    stack = [coords[0]]
+    seen = set()
+    while stack:
+        cell = stack.pop()
+        if cell in seen:
+            continue
+        seen.add(cell)
+        for nxt in _neighbors8(*cell):
