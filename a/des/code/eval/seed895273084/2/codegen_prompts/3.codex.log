+
+def _seed_positions(g: np.ndarray, sep_row: int) -> list[tuple[int, int]]:
+    lower = g[sep_row + 1 :]
+    coords = np.argwhere((lower != BG) & (lower != SATELLITE))
+    return [(sep_row + 1 + int(r), int(c)) for r, c in coords]
