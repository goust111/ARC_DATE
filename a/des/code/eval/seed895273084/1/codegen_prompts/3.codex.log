  43: def main(grid: np.ndarray) -> np.ndarray:
  44:     """
  45:     Push every colored object touching maroon markers straight outward until it reaches the grid edge.
  46: 
  47:     Input structure:
  48:     - The background is the dominant color.
  49:     - Maroon pixels are fixed markers.
  50:     - Every other foreground 4-connected object touches the marker pixels on exactly one cardinal side.
  51: 
  52:     Rule:
  53:     - Clear each non-background, non-maroon object from its original position.
  54:     - Translate it in the direction away from its maroon contact until the object reaches the grid boundary.
  55:     - Keep the maroon marker pixels unchanged.
  56: 
  57:     Key insight:
  58:     - The maroon contact side is a launcher: it determines a unique outward ray for the whole object, and the edge of the grid determines the translation distance.
  59:     """
  60:     g = np.asarray(grid, dtype=int)
  61:     bg = int(get_bg(g))
  62:     assert bg != MARKER_COLOR
  63:     assert bool(np.any(g == MARKER_COLOR))
  64: 
  65:     marker_components = find_components(
  66:         g,
  67:         bg=bg,
  68:         connectivity=4,
  69:         monochromatic=True,
  70:         colors=[MARKER_COLOR],
  71:         return_format="dict",
  72:     )
  73:     assert 1 <= len(marker_components) <= 3, "maroon markers must form 1-3 moderate components"
  74:     assert sum(int(comp["area"]) for comp in marker_components) <= 17, "maroon marker area must be moderate"
  75:     assert all(int(comp["area"]) <= 9 for comp in marker_components), "each maroon component must be moderate"
  76: 
  77:     out = g.copy()
  78:     placements: list[tuple[int, np.ndarray]] = []
  79:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
  80:         color = int(comp["color"])
  81:         if color == MARKER_COLOR:
  82:             continue
  83: 
  84:         coords = comp["coords"].astype(int, copy=False)
  85:         direction = _outward_direction(g, coords)
  86:         steps = _steps_to_edge(g.shape, coords, direction)
  87:         assert steps <= 8, "push distance must stay within the observed moderate range"
  88:         offset = np.array(direction, dtype=int) * steps
  89:         shifted = coords + offset
  90:         assert bool(
  91:             np.all(
  92:                 (0 <= shifted[:, 0])
  93:                 & (shifted[:, 0] < g.shape[0])
  94:                 & (0 <= shifted[:, 1])
  95:                 & (shifted[:, 1] < g.shape[1])
  96:             )
  97:         )
  98:         own = {tuple(coord) for coord in coords.tolist()}
  99:         for step in range(1, steps + 1):
 100:             swept = coords + np.array(direction, dtype=int) * step
 101:             for rr, cc in swept:
 102:                 loc = (int(rr), int(cc))
 103:                 assert loc in own or int(g[loc]) == bg, "object movement path must be unobstructed"
 104: 
 105:         out[coords[:, 0], coords[:, 1]] = bg
 106:         placements.append((color, shifted))
 107: 
 108:     assert placements
 109:     for color, coords in placements:
 110:         assert bool(np.all(out[coords[:, 0], coords[:, 1]] == bg)), "moved objects must not collide"
 111:         out[coords[:, 0], coords[:, 1]] = color
 112: 
 113:     return out
