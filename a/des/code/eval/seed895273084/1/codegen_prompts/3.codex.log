+    summaries: list[dict[str, object]] = []
+    for label, coords in components.items():
+        counts: dict[int, int] = {}
+        for tower_idx, by_component in enumerate(tower_reach):
+            count = len(by_component.get(label, ()))
+            if count > 0:
