+        c = int(c_raw)
+        arms = [(r + dr, c + dc) for dr, dc in DIRS4]
+        assert all(0 <= rr < h and 0 <= cc < w for rr, cc in arms), "tower center too close to edge"
+        assert all(int(grid[rr, cc]) == GREY for rr, cc in arms), "colored cell must be a tower center"
+        towers.append(
+            {
+                "center": (r, c),
+                "color": int(grid[r, c]),
+                "cells": {(r, c), *arms},
