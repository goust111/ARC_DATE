+
+def _make_seed_pattern(
+    rng: np.random.Generator, seed_h: int, seed_w: int, colors: np.ndarray
+) -> np.ndarray:
+    mode = str(rng.choice(["cells", "rows", "cols", "checker", "blocks"]))
+    patch = np.empty((seed_h, seed_w), dtype=int)
