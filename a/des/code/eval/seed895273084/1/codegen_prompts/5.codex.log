+    for _ in range(GROUP_RETRIES):
+        seed = _make_seed_pattern(rng, seed_h, seed_w, colors)
+        marker_color = int(rng.choice(np.unique(seed)))
+        scaled = _scale_nearest(seed, inner_h, inner_w)
+        if not np.any(scaled == marker_color):
