+
+def _build_group(
+    rng: np.random.Generator,
+) -> tuple[np.ndarray, np.ndarray] | None:
+    inner_h = int(rng.integers(3, 8))
+    inner_w = int(rng.integers(4, 9))
+    outer_h = inner_h + 2
+    outer_w = inner_w + 2
