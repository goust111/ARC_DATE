+        groups.append(group)
+
+    scene = _layout_scene(groups, rng)
+    if scene is None:
+        return None
+    inp, out = scene
+    if not np.array_equal(main(inp), out):
+        return None
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        pair = _generate_pair()
+        if pair is not None:
+            return pair[0]
+    raise RuntimeError("failed to generate a valid input")

