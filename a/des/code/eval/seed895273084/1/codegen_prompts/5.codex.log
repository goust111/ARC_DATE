+def _sample_seed_dim(rng: np.random.Generator, target: int, mode: str, cap: int) -> int:
+    if mode == "same":
+        return target
+    if mode == "up":
+        lo = 2
+        hi = max(2, target - 1)
+        return int(rng.integers(lo, hi + 1))
+    lo = target + 1
+    hi = max(lo, min(cap, target + 3))
+    return int(rng.integers(lo, hi + 1))
