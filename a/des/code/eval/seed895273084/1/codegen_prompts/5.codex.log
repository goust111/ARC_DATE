+
+def _seed_components(grid: np.ndarray, markers: list[dict[str, object]]) -> list[dict[str, object]]:
+    mask = (grid != BG) & (grid != GREY)
+    for marker in markers:
+        rr, cc = marker["pos"]  # type: ignore[index]
+        mask[rr, cc] = False
