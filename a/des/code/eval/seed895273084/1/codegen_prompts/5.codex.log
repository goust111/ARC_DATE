+def _random_composition(total: int, parts: int, rng: np.random.Generator) -> list[int]:
+    if parts == 1:
+        return [total]
+    cuts = sorted(rng.choice(np.arange(1, total), size=parts - 1, replace=False).tolist())
+    values: list[int] = []
+    prev = 0
+    for cut in cuts + [total]:
+        values.append(int(cut - prev))
+        prev = int(cut)
+    return values
