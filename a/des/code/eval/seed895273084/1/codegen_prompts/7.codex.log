+    assert r1 - r0 >= 2 and c1 - c0 >= 2, "canvas must enclose an interior"
+    border = np.zeros_like(g, dtype=bool)
+    border[r0, c0 : c1 + 1] = True
+    border[r1, c0 : c1 + 1] = True
