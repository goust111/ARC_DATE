+    info = _scene_info(grid)
+    if info["bg"] != BG:
+        return None
+    if info["left_wall"] != left_w or info["right_wall"] != left_w + 3:
+        return None
+    if info["filter_colors"] != set(filter_colors):
+        return None
+    if np.any(grid[:, info["right_wall"] + 1 :] != BG):
