+        r0, c0, r1, c1 = _bbox(comp)
+        mc0 = _mirror_col(left_wall, c1)
+        mc1 = _mirror_col(left_wall, c0)
+        center_r = (r0 + r1 + 1) // 2
+        center_c = (mc0 + mc1 + 1) // 2
+        out[center_r, center_c] = MARK_COLOR
