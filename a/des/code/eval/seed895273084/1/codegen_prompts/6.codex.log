+    left_wall, right_wall, wall_color = candidates[0]
+    assert wall_color == WALL_COLOR
+    assert grid.shape[1] == 2 * left_wall + 4
+    assert right_wall == left_wall + 3
+    return left_wall, right_wall, wall_color
+
+
+def _collect_filter_colors(
+    grid: np.ndarray,
+    left_wall: int,
+    wall_color: int,
+    bg: int,
+) -> set[int]:
