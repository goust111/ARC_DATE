+
+    row_width, col_starts = _template_row_layout(rect_w, n)
+    grid_w = row_width + random.randint(*GRID_EXTRA_WIDTH) + 2
+    grid_h = rect_h * 2 + random.randint(*GRID_EXTRA_HEIGHT) + 2
+    if grid_w < row_width + 2 or grid_h < rect_h * 2 + 4:
