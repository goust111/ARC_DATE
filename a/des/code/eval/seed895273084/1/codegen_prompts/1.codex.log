+
+def _template_row_layout(rect_w: int, n: int) -> tuple[int, list[int]]:
+    gaps = [random.choice(TEMPLATE_GAP_CHOICES) for _ in range(n - 1)]
+    width = n * rect_w + sum(gaps)
+    starts = [0]
+    for gap in gaps:
+        starts.append(starts[-1] + rect_w + gap)
