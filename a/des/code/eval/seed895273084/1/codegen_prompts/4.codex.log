+
+
+def _extract_lines(grid: np.ndarray, priority_colors: List[int]) -> List[Dict[str, int]]:
+    line_colors = [color for color in priority_colors if np.any(grid[:, 1:] == color)]
+    assert line_colors, "expected at least one colored line"
