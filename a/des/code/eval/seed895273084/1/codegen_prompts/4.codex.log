+
+BG = 0
+MAROON = 9
+COLOR_POOL = (1, 2, 3, 4, 5, 6, 7, 8)
+MAX_ATTEMPTS = 400
+
+
+def _priority_rows(grid: np.ndarray) -> Tuple[List[int], List[int]]:
+    rows = [int(r) for r in np.flatnonzero(grid[:, 0] != BG)]
