    # return first feasible anchor position only
    for r in range(H):
        for c in range(W):
            ok=True
            pts=[]
            for dr,dc in cells:
                rr=r+dr; cc=c+dc
                if rr<0 or rr>=H or cc<0 or cc>=W or (rr,cc) in occ:
                    ok=False; break
