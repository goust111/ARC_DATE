+            if placed is None:
+                continue
+            ar, ac, mask = placed
+            rest = rec(index + 1, occ_mask | mask)
+            if rest is not None:
+                return (((ar, ac), shape),) + rest
+        return None
+
+    result = rec(0, 0)
