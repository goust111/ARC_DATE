def first_place(H,W,cells,occ_mask):
    for r in range(H):
        for c in range(W):
            pts=[]
            ok=True
            for dr,dc in cells:
                rr=r+dr; cc=c+dc
                if rr<0 or rr>=H or cc<0 or cc>=W:
                    ok=False; break
                bit=1<<(rr*W+cc)
                if occ_mask & bit:
                    ok=False; break
                pts.append(bit)
            if ok:
                mask=0
                for b in pts: mask|=b
                return r,c,mask
    return None


def choose_specs(H,W):
    area=H*W
    for _ in range(100):
        n=random.randint(4,min(6, area//3))
        groups=sorted(random.randrange(4) for _ in range(n))
        counts=[groups.count(g) for g in range(4)]
        if max(counts)>MAX_CORE: continue
        if len([c for c in counts if c])<2: continue
        target=area-2*n
        opts=[]
        def rec(i, rem, acc):
            if i==4:
                if rem==0: opts.append(acc[:])
                return
            k=counts[i]
            for combo in COMBOS[k]:
                s=sum(combo)
                if s>rem: continue
                acc.append(combo)
                rec(i+1, rem-s, acc)
                acc.pop()
        rec(0,target,[])
        if not opts: continue
        choice=random.choice(opts)
        specs=[]
        for g in range(4):
            for k in choice[g]: specs.append((g,k))
        return specs
    return None


def search(H,W,specs):
    full=(1<<(H*W))-1
    @lru_cache(None)
    def rec(i, occ):
        if i==len(specs):
            return [] if occ==full else None
        g,k=specs[i]
        templs=T[g][k]
        # heuristic: fewer empty cells near top-left maybe better? just random order from pre-shuffle
        for cells in templs:
            placed=first_place(H,W,cells,occ)
            if not placed: continue
            r,c,mask=placed
            rest=rec(i+1, occ|mask)
            if rest is not None:
                return [((g,k),cells,(r,c),mask)] + rest
        return None
    return rec(0,0)

succ=0
for t in range(50):
    H=random.randint(4,6); W=random.randint(5,7)
    specs=choose_specs(H,W)
    if not specs: continue
    sol=search(H,W,tuple(specs))
    if sol is not None:
        succ+=1
        print('ok',H,W,specs)
print('succ',succ)
