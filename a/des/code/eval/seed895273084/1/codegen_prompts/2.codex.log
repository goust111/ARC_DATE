+        rec(0, target_core_sum, [])
+        if not options:
+            continue
+
+        sizes_by_group = random.choice(options)
+        specs: list[tuple[int, int]] = []
+        for group in range(4):
+            for core_size in sizes_by_group[group]:
+                specs.append((group, int(core_size)))
+        return specs
+    return None
