+def _first_feasible_mask(
+    out_h: int,
+    out_w: int,
+    shape: tuple[tuple[int, int], ...],
+    occ_mask: int,
+) -> tuple[int, int, int] | None:
+    for r in range(out_h):
+        for c in range(out_w):
+            mask = 0
+            ok = True
+            for dr, dc in shape:
+                rr = r + dr
+                cc = c + dc
+                if not (0 <= rr < out_h and 0 <= cc < out_w):
+                    ok = False
+                    break
+                bit = 1 << (rr * out_w + cc)
+                if occ_mask & bit:
