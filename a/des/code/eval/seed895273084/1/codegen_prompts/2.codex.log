+                "core_size": core_size,
+                "input_cells": tuple(sorted(input_cells)),
+                "bbox_area": (
+                    (max(r for r, _, _ in input_cells) - min(r for r, _, _ in input_cells) + 1)
+                    * (max(c for _, c, _ in input_cells) - min(c for _, c, _ in input_cells) + 1)
+                ),
+            }
+        )
