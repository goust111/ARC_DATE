+
+def _first_feasible_anchor(
+    out_h: int,
+    out_w: int,
+    occ: np.ndarray,
+    cells: tuple[tuple[int, int, int], ...],
+) -> tuple[int, int] | None:
+    for r in range(out_h):
+        for c in range(out_w):
+            ok = True
+            for dr, dc, _ in cells:
+                rr = r + dr
+                cc = c + dc
+                if not (0 <= rr < out_h and 0 <= cc < out_w) or occ[rr, cc]:
+                    ok = False
+                    break
+            if ok:
+                return (r, c)
