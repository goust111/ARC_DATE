+                if any(blocked[r, c] for r, c in coords):
+                    continue
+                for dr, dc, color in cells:
+                    grid[ar + dr, ac + dc] = int(color)
+                _mark_blocked(blocked, coords)
+                found = True
+                break
+            if not found:
+                placed_ok = False
+                break
+
+        if placed_ok:
+            return grid
+    return None
+
+
+BLUEPRINTS = _build_blueprints()
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        out_h, out_w, pieces, expected = _instantiate_layout(random.choice(BLUEPRINTS))
+        grid = _scatter_scene(out_h, out_w, pieces)
+        if grid is None:
+            continue
+        try:
+            actual = main(grid)
+        except Exception:
+            continue
+        if np.array_equal(actual, expected):
+            return grid
+    raise RuntimeError(f"Failed to generate a valid input after {GEN_ATTEMPTS} attempts")

Implemented the solver/generator, added cached layout blueprints to keep generation fast, passed the required validation, and removed the generated __pycache__.
  ✓ Design solver helpers for corner marker detection, piece extraction, grouping, and sequential anchor-based packing
  ✓ Implement random generator that partitions the target rectangle into connected multicolor pieces, scatters them, and validates assumptions
  ✓ Run the required 100-sample self-check, compile check, and remove __pycache__
