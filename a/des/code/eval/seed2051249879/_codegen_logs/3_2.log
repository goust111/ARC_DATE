+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+MAROON = 9
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+ALL_DIRS = ["U", "D", "L", "R"]
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
