+    rb, cb = _inside_origin(canvas_bbox, spec_b)
+    mask_a = spec_a["mask"]
+    mask_b = spec_b["mask"]
+    pts_a = {(ra + r, ca + c) for r, c in zip(*np.where(mask_a))}
+    pts_b = {(rb + r, cb + c) for r, c in zip(*np.where(mask_b))}
