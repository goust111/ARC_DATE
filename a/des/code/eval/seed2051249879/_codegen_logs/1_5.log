+            int(grid[r0, c0]),
+            int(grid[r0, c1]),
+            int(grid[r1, c0]),
+            int(grid[r1, c1]),
+        }
+        if len(corner_colors) != 1 or bg in corner_colors:
+            continue
+        color = next(iter(corner_colors))
+        if any(not (r in (r0, r1) or c in (c0, c1)) for r, c in comp):
