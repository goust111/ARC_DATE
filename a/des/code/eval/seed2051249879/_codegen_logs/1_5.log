+        return None
+    try:
+        got = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(got, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate valid input after {MAX_RETRIES} retries")

