+    for _ in range(MAX_SEED_LAYOUT_ATTEMPTS):
+        chosen_idx = rng.choice(len(cells), size=total, replace=False)
+        chosen = [cells[int(idx)] for idx in chosen_idx]
+        rng.shuffle(chosen)
