+            return None
+        for idx in map(int, gap_idx):
+            if side == "top":
+                cell = (r0, c0 + 1 + idx)
+            elif side == "bottom":
+                cell = (r1, c0 + 1 + idx)
+            elif side == "left":
+                cell = (r0 + 1 + idx, c0)
+            else:
+                cell = (r0 + 1 + idx, c1)
