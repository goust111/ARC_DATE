+def _sorted_seed_ranking(
+    seeds: dict[int, list[tuple[int, int]]],
+    gap_cell: tuple[int, int],
+) -> list[tuple[int, int]]:
+    gr, gc = gap_cell
+    ranked = []
+    visible_keys = set()
+    for color, coords in seeds.items():
+        ordered = tuple(sorted((int(r), int(c)) for r, c in coords))
