+        branch_cells = _visible_branch_cells(shape, frame)
+        bbox_cells = _bbox_cells(bbox)
+        if branch_cells & bbox_cells:
+            continue
+        if branch_cells & used_input:
+            continue
+        if branch_cells & used_output:
