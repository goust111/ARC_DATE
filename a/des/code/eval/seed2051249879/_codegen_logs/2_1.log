+OUTER_H_RANGE = (6, 10)
+OUTER_W_RANGE = (6, 10)
+MAX_GENERATION_ATTEMPTS = 400
+MAX_FRAME_ATTEMPTS = 200
+MAX_SEED_LAYOUT_ATTEMPTS = 200
