+def _find_frames(g: np.ndarray, bg: int) -> list[dict]:
+    h, w = g.shape
+    colors = [int(color) for color in np.unique(g) if int(color) != bg]
+    candidates: dict[tuple[int, int, int, int], dict] = {}
