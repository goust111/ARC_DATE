+    ordered = sorted(
+        candidates.values(),
+        key=lambda info: (
+            -((info["bbox"][2] - info["bbox"][0] + 1) * (info["bbox"][3] - info["bbox"][1] + 1)),
+            info["bbox"],
+        ),
+    )
+    chosen: list[dict] = []
+    used: set[tuple[int, int]] = set()
+    for info in ordered:
