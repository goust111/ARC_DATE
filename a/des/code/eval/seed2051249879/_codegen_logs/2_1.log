+    shape: tuple[int, int],
+    used_input: set[tuple[int, int]],
+    used_output: set[tuple[int, int]],
+) -> dict | None:
+    h, w = shape
+    for _ in range(MAX_FRAME_ATTEMPTS):
+        outer_h = int(rng.integers(*OUTER_H_RANGE))
+        outer_w = int(rng.integers(*OUTER_W_RANGE))
+        if outer_h >= h - 1 or outer_w >= w - 1:
+            continue
