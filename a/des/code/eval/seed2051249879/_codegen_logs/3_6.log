+            {
+                "color": int(color),
+                "orient": orient,
+                "coords": coords,
+                "endpoints": endpoints,
+                "edge_flags": edge_flags,
+                "gate_ids": gate_ids,
+                "gate_sides": gate_sides,
+                "conn_gate": [None, None],
+            }
