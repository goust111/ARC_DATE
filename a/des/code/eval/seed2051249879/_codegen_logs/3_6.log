        rect_w = c1 - c0 + 1
        rect_h = _rect_span_for_band(rect_w, H)
        if rect_h is None:
            return None
        se = vert_edges[i]
        if se == "top":
            dr0, dr1 = H - rect_h, H - 1
        else:
            dr0, dr1 = 0, rect_h - 1
        rects.append((dr0, c0, dr1, c1, se))

    for i, (r0, r1) in enumerate(row_bands):
        rect_h = r1 - r0 + 1
