+                "frag_lengths": frag_lengths,
+                "span": _path_span(frag_lengths),
+            }
+        )
+
+    needed_colors = isolated_count + sum(2 * spec["used_gates"] + 2 for spec in path_specs)
+    if needed_colors > 9:
