+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_ATTEMPTS = 400
+LENGTH_RANGE = (2, 5)
+SCENARIOS = ("simple", "chain", "double")
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[int(counts.argmax())])
