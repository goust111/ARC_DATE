+            and sum(bool(flag) for flag in frag["edge_flags"]) >= 2
+        ]
+        if len(isolated_fragments) < isolated_count:
+            return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
