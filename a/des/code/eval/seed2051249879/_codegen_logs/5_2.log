+            if new_uncovered and not new_uncovered.issubset(next_coverable):
+                continue
+            placed[best_idx] = (int(top), int(left))
+            recurse(new_covered, next_remaining, placed)
+            del placed[best_idx]
+            if len(solutions) >= max_solutions:
