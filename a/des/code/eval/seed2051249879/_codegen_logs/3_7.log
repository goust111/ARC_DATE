+RED = 2
+GREY = 5
+GRID_MAX = 30
+PATTERN_MIN = 15
+PATTERN_MAX = 25
+INNER_MIN = 3
+INNER_MAX = 5
+LAYOUTS = (
+    (2, 2),
+    (2, 3),
+    (3, 2),
+    (3, 3),
+    (2, 4),
