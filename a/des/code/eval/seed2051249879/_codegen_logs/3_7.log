+            right = random.randint(max(left + 2, 2 * width // 3), width - 2)
+            pattern[top, left : right + 1] = accent
+            pattern[bottom, left : right + 1] = accent
+            pattern[top : bottom + 1, left] = accent
+            pattern[top : bottom + 1, right] = accent
+        else:
