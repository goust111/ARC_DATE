+            stack = [(r, c)]
+            points: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                points.append((rr, cc))
+                for dr, dc in steps:
+                    nr = rr + dr
+                    nc = cc + dc
