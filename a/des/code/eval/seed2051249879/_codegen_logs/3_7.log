+def components_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    height, width = map(int, mask.shape)
+    seen = np.zeros_like(mask, dtype=bool)
+    if connectivity == 4:
+        steps = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    else:
+        steps = [
+            (-1, 0),
+            (1, 0),
+            (0, -1),
+            (0, 1),
