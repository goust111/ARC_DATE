+                if top < 0 or left < 0 or box[2] >= pattern_h or box[3] >= pattern_w:
+                    continue
+                overlap = False
+                for other in boxes:
+                    if not (box[2] < other[0] or other[2] < box[0] or box[3] < other[1] or other[3] < box[1]):
