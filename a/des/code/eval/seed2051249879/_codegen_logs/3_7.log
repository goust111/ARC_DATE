+    extra = int(length) - int(required)
+    if extra < 0:
+        return None
+    gaps = _random_composition(extra, count + 1)
+    starts: list[int] = []
+    pos = gaps[0]
+    for idx in range(count):
+        starts.append(int(pos))
+        pos += size
+        if idx + 1 < count:
+            pos += min_gap + gaps[idx + 1]
+    return starts
