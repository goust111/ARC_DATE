+    if style == 0:
+        cell_h = random.randint(2, 4)
+        cell_w = random.randint(2, 4)
+        idx = ((rr // cell_h) + 2 * (cc // cell_w) + ((rr + cc) // max(2, min(cell_h, cell_w)))) % len(colors)
+    elif style == 1:
+        slope = random.randint(2, 4)
+        idx = (((rr + 2 * cc) // slope) + (rr // random.randint(2, 4))) % len(colors)
+    else:
+        cell_h = random.randint(2, 4)
+        cell_w = random.randint(2, 4)
