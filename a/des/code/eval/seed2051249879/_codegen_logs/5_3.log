        (arm[0] + perps[1][0], arm[1] + perps[1][1]),
    }
    extras = set(arrow_cells) - {center, arm}
    if len(extras) != 1 or next(iter(extras)) not in foots:
        return None

    outside_positions: list[tuple[int, int]] = []
    for c in range(c0, c1 + 1):
