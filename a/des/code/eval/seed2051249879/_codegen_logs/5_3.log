from __future__ import annotations

from collections import Counter
import random

import numpy as np


BG = 0
LEGEND_BORDER = 5
LEGEND_ARROW = 1
LEGEND_SIDE = 7
LEGEND_GAP = 2
GEN_RETRIES = 400

DIR_TO_QUARTERS = {
    (-1, 0): 0,
    (0, 1): 1,
    (1, 0): 2,
    (0, -1): 3,
}

QUARTERS_TO_DIR = {
    0: (-1, 0),
    1: (0, 1),
    2: (1, 0),
    3: (0, -1),
}


def get_bg(grid: np.ndarray) -> int:
    values, counts = np.unique(grid, return_counts=True)
    return int(values[int(np.argmax(counts))])


def neighbors4(r: int, c: int) -> list[tuple[int, int]]:
    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]


def components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    h, w = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    out: list[list[tuple[int, int]]] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            stack = [(r, c)]
            seen[r, c] = True
            comp: list[tuple[int, int]] = []
            while stack:
                rr, cc = stack.pop()
                comp.append((rr, cc))
                for nr, nc in neighbors4(rr, cc):
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            out.append(comp)
    return out


def bbox_of(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
    rows = [r for r, _ in coords]
    cols = [c for _, c in coords]
    return min(rows), min(cols), max(rows), max(cols)


def _is_ring_component(coords: list[tuple[int, int]]) -> bool:
    r0, c0, r1, c1 = bbox_of(coords)
    h = r1 - r0 + 1
    w = c1 - c0 + 1
    if h < 3 or w < 3:
        return False
    expected: set[tuple[int, int]] = set()
    for c in range(c0, c1 + 1):
        expected.add((r0, c))
        expected.add((r1, c))
    for r in range(r0 + 1, r1):
        expected.add((r, c0))
        expected.add((r, c1))
    return set(coords) == expected


def _find_ring_frames(grid: np.ndarray, bg: int) -> list[dict]:
    frames: list[dict] = []
    for color in map(int, np.unique(grid)):
        if color == bg:
            continue
        for comp in components(grid == color):
            if not _is_ring_component(comp):
                continue
            r0, c0, r1, c1 = bbox_of(comp)
            frames.append(
                {
                    "color": color,
                    "bbox": (r0, c0, r1, c1),
                    "side_h": r1 - r0 + 1,
                    "side_w": c1 - c0 + 1,
                }
            )
    return frames


def _majority_color(values: list[int]) -> int:
    counts: dict[int, int] = {}
    order: list[int] = []
    for value in values:
        if value not in counts:
            counts[value] = 0
            order.append(value)
        counts[value] += 1
    best = order[0]
    for value in order[1:]:
        if counts[value] > counts[best]:
            best = value
    return best


def _rot_cw(pos: tuple[int, int], side: int) -> tuple[int, int]:
    r, c = pos
    return c, side - 1 - r


def _rotation_orbits(side: int) -> list[list[tuple[int, int]]]:
    seen: set[tuple[int, int]] = set()
    out: list[list[tuple[int, int]]] = []
    for r in range(side):
        for c in range(side):
            if (r, c) in seen:
                continue
            orbit: list[tuple[int, int]] = []
            cur = (r, c)
            for _ in range(4):
                if cur not in orbit:
                    orbit.append(cur)
                cur = _rot_cw(cur, side)
            for item in orbit:
                seen.add(item)
            out.append(orbit)
    return out


def _complete_patch(patch: np.ndarray, bg: int) -> np.ndarray:
    side_h, side_w = patch.shape
    assert side_h == side_w
    side = side_h
    out = patch.copy()
    for r in range(side):
        for c in range(side):
            if int(patch[r, c]) != bg:
                continue
            cur = (r, c)
            candidates: list[int] = []
            for _ in range(3):
                cur = _rot_cw(cur, side)
                value = int(patch[cur[0], cur[1]])
                if value != bg:
                    candidates.append(value)
            if candidates:
                out[r, c] = _majority_color(candidates)
    return out


def _parse_legend(frame: dict, grid: np.ndarray, bg: int) -> tuple[int, int] | None:
    r0, c0, r1, c1 = frame["bbox"]
    h = frame["side_h"]
    w = frame["side_w"]
    if h != w or h % 2 == 0 or h < 5:
        return None

    center = ((r0 + r1) // 2, (c0 + c1) // 2)
