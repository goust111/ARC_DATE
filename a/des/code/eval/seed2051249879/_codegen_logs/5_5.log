+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or visited[r, c]:
+                continue
+            stack = [(r, c)]
+            visited[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
