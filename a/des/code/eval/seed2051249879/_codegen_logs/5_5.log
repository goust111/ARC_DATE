+def _classify_hole_icon(mask: np.ndarray):
+    coords = np.argwhere(mask)
+    if len(coords) == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    sub = mask[r0 : r1 + 1, c0 : c1 + 1]
+    if h >= 3 and w >= 3:
