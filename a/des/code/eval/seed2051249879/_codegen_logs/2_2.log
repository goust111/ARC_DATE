+
+def _draw_slot_and_arrow(
+    template: np.ndarray,
+    top: int,
+    left: int,
+    height: int,
+    width: int,
+    direction: str,
+    arrow_offset: int,
+) -> None:
+    template[top : top + height, left : left + width] = BG
+    arrow = _arrow_patch(direction)
+    if direction == "up":
+        _place_patch(template, arrow, top + height, left + arrow_offset)
+    elif direction == "down":
