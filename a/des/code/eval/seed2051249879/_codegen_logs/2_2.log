+def _arrow_patch(direction: str) -> np.ndarray:
+    coords = ARROW_SHAPES[direction]
+    h = max(r for r, _ in coords) + 1
+    w = max(c for _, c in coords) + 1
+    patch = np.zeros((h, w), dtype=int)
+    for r, c in coords:
+        patch[r, c] = ORANGE
+    return patch
