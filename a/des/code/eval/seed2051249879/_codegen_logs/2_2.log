+def _place_patch(grid: np.ndarray, patch: np.ndarray, top: int, left: int, transparent: int = BG) -> None:
+    h, w = patch.shape
+    region = grid[top : top + h, left : left + w]
+    mask = patch != transparent
+    region[mask] = patch[mask]
