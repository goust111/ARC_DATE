+def _solve_weighted_assignment(candidates: list[list[tuple[int, int]]], count: int) -> list[int]:
+    order = sorted(range(count), key=lambda i: (len(candidates[i]), i))
+    chosen = [-1] * count
+    used = [False] * count
+    best: list[int] | None = None
