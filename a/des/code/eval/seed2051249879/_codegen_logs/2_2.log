+    def dfs(pos: int) -> bool:
+        nonlocal best
+        if pos == len(order):
+            best = chosen[:]
+            return True
+        item = order[pos]
+        for target, _score in sorted(candidates[item], key=lambda item_score: (item_score[1], item_score[0])):
