+    max_piece_width = max(p.shape[1] for p in piece_patches)
+    right_w = random.randint(max(10, max_piece_width + 6), 16)
+    right_canvas = _try_place_right_pieces(total_h, right_w, piece_patches)
+    if right_canvas is None:
