+def _coverage_counts(rects: list[tuple[int, int, int, int]], shape: tuple[int, int]) -> np.ndarray:
+    counts = np.zeros(shape, dtype=int)
+    for r0, c0, r1, c1 in rects:
+        counts[r0 : r1 + 1, c0 : c1 + 1] += 1
+    return counts
+
