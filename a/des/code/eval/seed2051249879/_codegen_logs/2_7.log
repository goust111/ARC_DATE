+def _render_input(rects: list[tuple[int, int, int, int]], colors: list[int], shape: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    canvas = np.full((h, w), BG, dtype=int)
+    for bbox, color in zip(rects, colors):
