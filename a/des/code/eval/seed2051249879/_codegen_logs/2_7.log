+        "TR": {"blocked": [(-1, 0), (0, 1)], "dirs": ((0, -1), (1, 0))},
+        "BL": {"blocked": [(1, 0), (0, -1)], "dirs": ((0, 1), (-1, 0))},
+        "BR": {"blocked": [(1, 0), (0, 1)], "dirs": ((0, -1), (-1, 0))},
+    }
