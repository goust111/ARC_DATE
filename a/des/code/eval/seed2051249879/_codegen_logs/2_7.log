+
+def _protected_cells(bbox: tuple[int, int, int, int], orient: str) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    cells: set[tuple[int, int]] = set()
+    if orient in ("TL", "TR"):
+        for c in range(c0, c1 + 1):
+            cells.add((r0, c))
+    else:
+        for c in range(c0, c1 + 1):
+            cells.add((r1, c))
+    if orient in ("TL", "BL"):
+        for r in range(r0, r1 + 1):
+            cells.add((r, c0))
+    else:
