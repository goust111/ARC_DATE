+def _bbox_area(bbox: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = bbox
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _run_length(mask: np.ndarray, r: int, c: int, dr: int, dc: int) -> int:
+    h, w = mask.shape
+    length = 0
+    rr, cc = r, c
+    while 0 <= rr < h and 0 <= cc < w and bool(mask[rr, cc]):
+        length += 1
+        rr += dr
+        cc += dc
+    return length
