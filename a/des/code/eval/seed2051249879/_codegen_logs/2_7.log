+            bbox = _bbox_from_corner(r, c, width, height, orient)
+            r0, c0, r1, c1 = bbox
+            if not (0 <= r0 <= r1 < h and 0 <= c0 <= c1 < w):
+                continue
+
+            if np.any((pts[:, 0] < r0) | (pts[:, 0] > r1) | (pts[:, 1] < c0) | (pts[:, 1] > c1)):
