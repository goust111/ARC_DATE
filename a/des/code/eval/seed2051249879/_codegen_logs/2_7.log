+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+MAGENTA = 6
+MAROON = 9
+RECT_PALETTE = (1, 2, 3, 4, 7, 8)
+ORIENTATIONS = ("TL", "TR", "BL", "BR")
+
+GRID_H_RANGE = (16, 20)
+GRID_W_RANGE = (16, 20)
+ZONE_SIZE_RANGE = (2, 3)
+GEN_RETRIES = 400
+BOX_SAMPLE_RETRIES = 120
