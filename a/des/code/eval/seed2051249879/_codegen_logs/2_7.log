+        region = np.s_[r0 : r1 + 1, c0 : c1 + 1]
+        prev = counts[region]
+        patch = out[region]
+        patch[prev == 0] = color
+        patch[prev == 1] = MAROON
+        patch[prev >= 2] = MAGENTA
+        out[region] = patch
+        counts[region] = prev + 1
