+    ranked = sorted(candidates, key=lambda b: (_bbox_area(b), b))
+    best_area = _bbox_area(ranked[0])
+    best = [bbox for bbox in ranked if _bbox_area(bbox) == best_area]
+    assert len(best) == 1, f"ambiguous reconstruction for color {color}"
+    return best[0]
