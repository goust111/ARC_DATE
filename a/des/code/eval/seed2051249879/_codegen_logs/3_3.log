+    ring = []
+    for r in range(h):
+        for c in range(w):
+            if not exterior[r, c]:
+                continue
+            for dr, dc in _N8:
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w and padded[nr, nc]:
