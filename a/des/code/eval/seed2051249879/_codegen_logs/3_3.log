+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for dr, dc in nbrs:
