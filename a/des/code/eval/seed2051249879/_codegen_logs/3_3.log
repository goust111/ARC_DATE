+    bg = rng.choice(_COLORS)
+    remaining = [c for c in _COLORS if c != bg]
+    legend_colors = rng.sample(remaining, 4)
+    remaining = [c for c in remaining if c not in legend_colors]
+    obj_color = rng.choice(remaining)
