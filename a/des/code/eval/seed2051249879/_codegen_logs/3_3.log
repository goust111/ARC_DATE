+    out = g.copy()
+    for pts in comps:
+        r0, c0, r1, c1 = _bbox(pts)
+        sub = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        sub[pts[:, 0] - r0, pts[:, 1] - c0] = True
+        holes = _hole_count(sub)
+        assert 0 <= holes < len(legend_colors)
+        border_color = legend_colors[holes]
