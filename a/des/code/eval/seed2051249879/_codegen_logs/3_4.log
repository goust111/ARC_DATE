+def _direction_map(legend_cell: np.ndarray) -> dict[int, tuple[int, int]]:
+    mapping = {
+        int(legend_cell[0, 0]): DIRS["up"],
+        int(legend_cell[0, -1]): DIRS["right"],
+        int(legend_cell[-1, 0]): DIRS["left"],
+        int(legend_cell[-1, -1]): DIRS["down"],
