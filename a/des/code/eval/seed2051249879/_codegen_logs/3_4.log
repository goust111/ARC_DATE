+    legend = _cell_view(grid, 0, 0, cell_size)
+    split = cell_size // 2
+    legend[:split, :split] = legend_colors["up"]
+    legend[:split, split:] = legend_colors["right"]
+    legend[split:, :split] = legend_colors["left"]
+    legend[split:, split:] = legend_colors["down"]
