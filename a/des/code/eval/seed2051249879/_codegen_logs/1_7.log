+from __future__ import annotations
+
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+
+SIDES = ("top", "bottom", "left", "right")
+GEN_RETRIES = 400
+PLACEMENT_RETRIES = 300
+OBJECT_RETRIES = 120
