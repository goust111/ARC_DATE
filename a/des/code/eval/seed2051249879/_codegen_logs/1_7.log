+        tip = r0 - length
+        for rr in range(tip, r0 + 1):
+            if 0 <= rr < h:
+                if 0 <= pos - 1 < w:
+                    out[rr, pos - 1] = BLUE
+                if 0 <= pos + 1 < w:
+                    out[rr, pos + 1] = BLUE
+        if 0 <= tip < h:
