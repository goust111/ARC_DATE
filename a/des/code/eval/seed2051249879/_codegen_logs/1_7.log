+def _render_input(h: int, w: int, objects: list[dict[str, object]]) -> np.ndarray:
+    canvas = np.full((h, w), BG, dtype=int)
+    for obj in objects:
+        r0 = int(obj["r0"])
+        c0 = int(obj["c0"])
