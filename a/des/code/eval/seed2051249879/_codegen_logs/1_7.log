+
+    for _ in range(count):
+        placed = False
+        for _ in range(PLACEMENT_RETRIES):
+            obj = _sample_object(rng)
+            if obj is None:
+                return None
+
+            ext = obj["extents"]
+            top = int(ext["top"])
+            bottom = int(ext["bottom"])
+            left = int(ext["left"])
+            right = int(ext["right"])
+            oh = int(obj["h"])
+            ow = int(obj["w"])
+
+            min_r0 = top + 1
+            max_r0 = h - oh - bottom - 1
+            min_c0 = left + 1
+            max_c0 = w - ow - right - 1
+            if min_r0 > max_r0 or min_c0 > max_c0:
