+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(pts: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(pts[:, 0].min()),
+        int(pts[:, 1].min()),
+        int(pts[:, 0].max()),
+        int(pts[:, 1].max()),
+    )
+
+
+def _is_rectangular_ring(pts: np.ndarray) -> bool:
+    r0, c0, r1, c1 = _bbox(pts)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return False
+    cells = {(int(r), int(c)) for r, c in pts}
+    expected = set()
+    for c in range(c0, c1 + 1):
+        expected.add((r0, c))
+        expected.add((r1, c))
+    for r in range(r0, r1 + 1):
+        expected.add((r, c0))
+        expected.add((r, c1))
+    return cells == expected
+
+
+def _parse_rod(grid: np.ndarray, pts: np.ndarray, rect: tuple[int, int, int, int]) -> tuple[str, int, int] | None:
+    r0, c0, r1, c1 = rect
+    rows = np.unique(pts[:, 0])
+    cols = np.unique(pts[:, 1])
+
+    if len(rows) == 1:
+        row = int(rows[0])
+        cmin = int(cols.min())
+        cmax = int(cols.max())
+        if len(pts) != cmax - cmin + 1:
+            return None
+        length = len(pts)
+        if cmin == c0 + 1 and grid[row, c0] == BLUE:
+            return "left", row, length
+        if cmax == c1 - 1 and grid[row, c1] == BLUE:
+            return "right", row, length
+        return None
+
+    if len(cols) == 1:
+        col = int(cols[0])
+        rmin = int(rows.min())
+        rmax = int(rows.max())
+        if len(pts) != rmax - rmin + 1:
+            return None
+        length = len(pts)
+        if rmin == r0 + 1 and grid[r0, col] == BLUE:
+            return "top", col, length
+        if rmax == r1 - 1 and grid[r1, col] == BLUE:
+            return "bottom", col, length
+        return None
+
+    return None
+
+
+def _draw_protrusion(
+    out: np.ndarray,
+    rect: tuple[int, int, int, int],
+    side: str,
+    pos: int,
+    length: int,
+) -> None:
+    h, w = out.shape
+    r0, c0, r1, c1 = rect
+
+    if side == "top":
+        if 0 <= r0 < h and 0 <= pos < w:
+            out[r0, pos] = BG
+        tip = r0 - length
+        for rr in range(tip, r0 + 1):
+            if 0 <= rr < h:
+                if 0 <= pos - 1 < w:
+                    out[rr, pos - 1] = BLUE
+                if 0 <= pos + 1 < w:
+                    out[rr, pos + 1] = BLUE
+        if 0 <= tip < h:
+            for cc in range(pos - 1, pos + 2):
+                if 0 <= cc < w:
+                    out[tip, cc] = BLUE
+        return
+
+    if side == "bottom":
+        if 0 <= r1 < h and 0 <= pos < w:
+            out[r1, pos] = BG
+        tip = r1 + length
+        for rr in range(r1, tip + 1):
+            if 0 <= rr < h:
+                if 0 <= pos - 1 < w:
+                    out[rr, pos - 1] = BLUE
+                if 0 <= pos + 1 < w:
+                    out[rr, pos + 1] = BLUE
+        if 0 <= tip < h:
+            for cc in range(pos - 1, pos + 2):
+                if 0 <= cc < w:
+                    out[tip, cc] = BLUE
+        return
+
+    if side == "left":
+        if 0 <= pos < h and 0 <= c0 < w:
+            out[pos, c0] = BG
+        tip = c0 - length
+        for cc in range(tip, c0 + 1):
+            if 0 <= cc < w:
+                if 0 <= pos - 1 < h:
+                    out[pos - 1, cc] = BLUE
+                if 0 <= pos + 1 < h:
+                    out[pos + 1, cc] = BLUE
+        if 0 <= tip < w:
+            for rr in range(pos - 1, pos + 2):
+                if 0 <= rr < h:
+                    out[rr, tip] = BLUE
+        return
+
+    if 0 <= pos < h and 0 <= c1 < w:
+        out[pos, c1] = BG
+    tip = c1 + length
+    for cc in range(c1, tip + 1):
+        if 0 <= cc < w:
+            if 0 <= pos - 1 < h:
+                out[pos - 1, cc] = BLUE
+            if 0 <= pos + 1 < h:
+                out[pos + 1, cc] = BLUE
+    if 0 <= tip < w:
+        for rr in range(pos - 1, pos + 2):
+            if 0 <= rr < h:
+                out[rr, tip] = BLUE
