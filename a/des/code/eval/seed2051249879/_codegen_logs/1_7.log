+def _render_output(h: int, w: int, objects: list[dict[str, object]]) -> np.ndarray:
+    canvas = np.full((h, w), BG, dtype=int)
+    for obj in objects:
+        r0 = int(obj["r0"])
+        c0 = int(obj["c0"])
+        oh = int(obj["h"])
+        ow = int(obj["w"])
+        rect = (r0, c0, r0 + oh - 1, c0 + ow - 1)
