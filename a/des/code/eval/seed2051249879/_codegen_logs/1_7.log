+                canvas,
+                rect,
+                str(rod["side"]),
+                c0 + int(rod["pos"]) if str(rod["side"]) in ("top", "bottom") else r0 + int(rod["pos"]),
+                int(rod["length"]),
+            )
+    return canvas
+
+
+def _place_objects(rng: np.random.Generator, h: int, w: int, count: int) -> list[dict[str, object]] | None:
+    reserved = np.zeros((h, w), dtype=bool)
