+            elif side == "bottom":
+                canvas[r1 - length : r1, c0 + pos] = RED
+            elif side == "left":
+                canvas[r0 + pos, c0 + 1 : c0 + 1 + length] = RED
+            else:
+                canvas[r0 + pos, c1 - length : c1] = RED
+    return canvas
