+
+def _neighbors(cell: Coord, shape: tuple[int, int]) -> list[Coord]:
+    h, w = shape
+    r, c = cell
+    result = []
+    for dr, dc in DIR4:
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            result.append((rr, cc))
+    return result
