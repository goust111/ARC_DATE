+def _partition_rectangle(h: int, w: int, piece_count: int) -> list[np.ndarray] | None:
+    cells = [(r, c) for r in range(h) for c in range(w)]
+    for _ in range(80):
+        seeds = random.sample(cells, piece_count)
+        labels = -np.ones((h, w), dtype=int)
+        sizes = [1] * piece_count
