+            pr0 = int(np.min(pts[:, 0]))
+            pc0 = int(np.min(pts[:, 1]))
+            pr1 = int(np.max(pts[:, 0]))
+            pc1 = int(np.max(pts[:, 1]))
+            patch = np.zeros((pr1 - pr0 + 1, pc1 - pc0 + 1), dtype=bool)
