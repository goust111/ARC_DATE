+        pieces: list[np.ndarray] = []
+        for idx in range(piece_count):
+            pts = np.argwhere(labels == idx)
+            pr0 = int(np.min(pts[:, 0]))
+            pc0 = int(np.min(pts[:, 1]))
+            pr1 = int(np.max(pts[:, 0]))
