+    bg = _get_bg(g)
+    out = g.copy()
+
+    for color in map(int, np.unique(g)):
+        if color == bg:
+            continue
+        frame = _find_frame_for_color(g, color)
+        if frame is None:
+            continue
+
+        frame_mask = np.zeros_like(g, dtype=bool)
+        for r, c in frame["coords"]:
+            frame_mask[r, c] = True
