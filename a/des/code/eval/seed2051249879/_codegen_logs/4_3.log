+    preferred: list[tuple[int, int]] = []
+    fr0, fc0, fr1, fc1 = frame_bbox
+
+    for r0 in range(h - ph + 1):
+        for c0 in range(w - pw + 1):
+            cells = _patch_cells(patch, r0, c0)
+            if any(blocked[r, c] for r, c in cells):
