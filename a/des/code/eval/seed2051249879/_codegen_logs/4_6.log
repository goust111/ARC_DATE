+        if cb is not None and rb is None:
+            cell_row = _cell_index(int(r), row_bands)
+            assert cell_row is not None
+            assert 0 < cb < len(col_bands) - 1
+            left = cb - 1
+            right = cb
+            d_left = abs(float(c) - col_centers[left])
+            d_right = abs(float(c) - col_centers[right])
