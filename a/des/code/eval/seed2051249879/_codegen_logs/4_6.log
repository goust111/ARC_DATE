+# --------------- generator ---------------
+
+_MAX_ATTEMPTS = 400
+_CELL_SIZE_OPTIONS = (5, 6)
+_LINE_THICKNESS_OPTIONS = (2, 3)
+_ROW_COUNT_RANGE = (2, 4)
+_COL_COUNT_RANGE = (2, 4)
+_MARGIN_RANGE = (1, 3)
+_FAMILY_NAMES = ("up", "down", "left", "right", "center")
+
+
+def _valid_dirs(n_rows: int, n_cols: int, cell: tuple[int, int]) -> list[str]:
+    r, c = cell
+    dirs: list[str] = []
+    if r > 0:
