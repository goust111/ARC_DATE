+GRID_HEIGHT_RANGE = (20, 30)
+GRID_WIDTH_RANGE = (20, 30)
+OBJECT_COUNT_RANGE = (2, 5)
+BORDER_MARGIN = 1
+SLOT_GAP = 1
+SLOT_MIN_HEIGHT = 4
+SLOT_MIN_WIDTH = 4
+ODD_LAYER_OPTIONS = (3, 5)
+EVEN_LAYER_OPTIONS = (2, 4, 6)
+CORE_SMALL_CAP = 4
+SINGLE_PIXEL_CORE_PROB = 0.25
+MAX_OBJECT_AREA_FRACTION = 0.42
