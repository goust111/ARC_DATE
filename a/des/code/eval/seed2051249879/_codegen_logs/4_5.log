+
+def _background_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _components4(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    components: list[np.ndarray] = []
+
+    for start_r, start_c in np.argwhere(mask):
+        r0 = int(start_r)
+        c0 = int(start_c)
+        if seen[r0, c0]:
+            continue
+
+        stack = [(r0, c0)]
+        seen[r0, c0] = True
+        coords: list[tuple[int, int]] = []
+        while stack:
+            r, c = stack.pop()
+            coords.append((r, c))
+            if r > 0 and mask[r - 1, c] and not seen[r - 1, c]:
+                seen[r - 1, c] = True
+                stack.append((r - 1, c))
+            if r + 1 < h and mask[r + 1, c] and not seen[r + 1, c]:
+                seen[r + 1, c] = True
+                stack.append((r + 1, c))
+            if c > 0 and mask[r, c - 1] and not seen[r, c - 1]:
+                seen[r, c - 1] = True
+                stack.append((r, c - 1))
+            if c + 1 < w and mask[r, c + 1] and not seen[r, c + 1]:
+                seen[r, c + 1] = True
+                stack.append((r, c + 1))
+        components.append(np.array(coords, dtype=int))
+
+    return components
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
