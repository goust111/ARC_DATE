+        width = random.randint(*RING_W_RANGE)
+        side = random.choice(GAP_SIDES)
+        if side in ("top", "bottom"):
+            gap_idx = random.randint(1, width - 2)
+        else:
+            gap_idx = random.randint(1, height - 2)
+        ring_specs.append(
+            {
+                "color": int(color),
+                "mode": mode,
+                "height": int(height),
+                "width": int(width),
+                "side": side,
+                "gap_idx": int(gap_idx),
