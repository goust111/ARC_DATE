+    row_gaps: list[list[int]] = []
+    for row in rows:
+        gaps = [random.randint(*ITEM_GAP_RANGE) for _ in range(max(0, len(row) - 1))]
+        width = sum(sizes[idx][1] for idx in row) + sum(gaps)
+        row_widths.append(int(width))
+        row_gaps.append(gaps)
