+def _fill_spiral(out: np.ndarray, ring: dict) -> None:
+    r0, c0, r1, c1 = ring["bbox"]
+    inner_h = int(r1 - r0 - 1)
+    inner_w = int(c1 - c0 - 1)
+    for rr, cc in _spiral_order(inner_h, inner_w, ring["side"], ring["offset"]):
+        out[r0 + 1 + rr, c0 + 1 + cc] = ORANGE
