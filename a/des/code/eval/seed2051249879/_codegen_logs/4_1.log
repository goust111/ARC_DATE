+                if len(vals) != 2:
+                    ok = False
+                    break
+                color_sets.append(vals)
+            if not ok:
+                continue
+
+            common = set.intersection(*color_sets)
+            if len(common) != 1:
+                continue
+            grey = next(iter(common))
+
+            mapping: dict[tuple[tuple[int, int], bytes], int] = {}
+            seen_fills: set[int] = set()
+            for pts in inner_comps:
