+        sub = g[r0 : r1 + 1, c0 : c1 + 1]
+        candidate_regions = []
+        for pts in _components(sub != fence_color):
+            if _touches_boundary(pts, sub.shape):
+                continue
+            vals = {int(sub[rr, cc]) for rr, cc in pts}
+            if grey in vals:
