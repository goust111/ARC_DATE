+        inside = expected[r0 + 1 : r1, c0 + 1 : c1]
+        inside[inside == bg] = fill_color
+
+    return grid, expected
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_ATTEMPTS):
