+                continue
+            r0, c0, r1, c1 = _bbox(comp)
+            sub = g[r0 : r1 + 1, c0 : c1 + 1]
+            inner_comps = [
+                pts for pts in _components(sub != color) if not _touches_boundary(pts, sub.shape)
+            ]
+            if len(inner_comps) < 2:
