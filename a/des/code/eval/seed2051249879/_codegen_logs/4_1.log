+    cell_w = max(mask.shape[1] for mask in shapes) + 2
+    ph, pw = _palette_dims(cell_h, cell_w, count, horizontal)
+    r0, c0 = _palette_origin(grid.shape[0], grid.shape[1], ph, pw, corner)
