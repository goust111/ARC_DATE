+        pc = _choose_embed_start(cell_w, shape.shape[1])
+        patch = grid[sr0 : sr0 + cell_h, sc0 : sc0 + cell_w]
+        patch[pr : pr + shape.shape[0], pc : pc + shape.shape[1]][shape] = grey
