+def _infer_palette(g: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int], dict[tuple[tuple[int, int], bytes], int], int]:
+    best = None
+    for color in sorted(int(v) for v in np.unique(g) if int(v) != bg):
