+        ir = r0 + 1 + _choose_embed_start(inner_h, shape_h)
+        ic = c0 + 1 + _choose_embed_start(inner_w, shape_w)
+        grid[ir : ir + shape_h, ic : ic + shape_w][shape] = grey
