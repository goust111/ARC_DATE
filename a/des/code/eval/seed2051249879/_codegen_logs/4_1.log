+    fences: list[tuple[int, int, int, int, int]] = []
+    order = sorted(
+        range(count),
+        key=lambda i: fence_shapes[i].shape[0] * fence_shapes[i].shape[1],
+        reverse=True,
+    )
+    for idx in order:
+        placement = _place_fence(
+            grid,
+            blocked,
+            border_color,
+            grey,
+            fence_shapes[idx],
+            fill_colors[idx],
