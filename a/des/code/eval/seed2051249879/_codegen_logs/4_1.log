+    expected[pr0 : pr1 + 1, pc0 : pc1 + 1] = grid[pr0 : pr1 + 1, pc0 : pc1 + 1]
+    _mark_blocked(blocked, pr0, pc0, pr1, pc1, _FENCE_PADDING)
+
+    order = sorted(
+        range(count),
+        key=lambda i: fence_shapes[i].shape[0] * fence_shapes[i].shape[1],
+        reverse=True,
+    )
+    for idx in order:
+        if not _place_fence(
+            grid,
+            expected,
+            blocked,
+            border_color,
+            grey,
+            fence_shapes[idx],
+            fill_colors[idx],
+        ):
