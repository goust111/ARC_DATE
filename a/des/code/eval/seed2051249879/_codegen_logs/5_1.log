+
+def _place_legends(grid: np.ndarray, occupied: np.ndarray, border_colors: list[int]) -> list[int]:
+    n = len(border_colors)
+    h, w = grid.shape
+    group_width = n * LEGEND_SIDE + (n - 1) * LEGEND_GAP
+    if group_width + 3 > w:
+        raise ValueError("legend strip does not fit")
