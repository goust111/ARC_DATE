+
+def _transform(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+    legends, legend_boxes = _extract_legends(g, bg)
+    out = g.copy()
+    for frame in _find_ring_frames(g, bg):
+        if frame["bbox"] in legend_boxes:
