+            keep = random.choices([1, 2, 3, 4], weights=[2, 4, 4, 1], k=1)[0]
+            if keep < 4:
+                partial_orbits += 1
+            if keep == 1:
+                visible_colors = [random.choice(colors)]
+            elif keep == 2:
+                color = random.choice(colors)
