+    dir_candidates = []
+    for direction in [(-1, 0), (0, 1), (1, 0), (0, -1)]:
+        nr = center[0] + direction[0]
+        nc = center[1] + direction[1]
+        if (nr, nc) in arrow_cells:
+            dir_candidates.append(direction)
+    if len(dir_candidates) != 1:
+        return None
