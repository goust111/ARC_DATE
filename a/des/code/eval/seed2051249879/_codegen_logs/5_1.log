+
+def _make_legend(direction: tuple[int, int]) -> np.ndarray:
+    arr = np.full((LEGEND_SIDE, LEGEND_SIDE), BG, dtype=int)
+    arr[0, :] = LEGEND_BORDER
+    arr[-1, :] = LEGEND_BORDER
+    arr[:, 0] = LEGEND_BORDER
+    arr[:, -1] = LEGEND_BORDER
+    for r, c in _legend_arrow_cells(direction):
+        arr[r, c] = LEGEND_ARROW
