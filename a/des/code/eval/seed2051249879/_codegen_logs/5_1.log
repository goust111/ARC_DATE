+    if top < 1 or left < 1 or top + side > h - 1 or left + side > w - 1:
+        return False
+    r0 = max(0, top - 1)
+    c0 = max(0, left - 1)
+    r1 = min(h, top + side + 1)
+    c1 = min(w, left + side + 1)
+    return not bool(occupied[r0:r1, c0:c1].any())
