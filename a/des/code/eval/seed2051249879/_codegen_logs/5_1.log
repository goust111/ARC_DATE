+    dr, dc = direction
+    arm = (center[0] + dr, center[1] + dc)
+    if direction == (-1, 0):
+        foot = (arm[0], arm[1] + 1)
+    elif direction == (0, 1):
+        foot = (arm[0] - 1, arm[1])
+    elif direction == (1, 0):
+        foot = (arm[0], arm[1] - 1)
+    else:
+        foot = (arm[0] + 1, arm[1])
+    return [center, arm, foot]
+
+
+def _make_legend(direction: tuple[int, int]) -> np.ndarray:
+    arr = np.full((LEGEND_SIDE, LEGEND_SIDE), BG, dtype=int)
