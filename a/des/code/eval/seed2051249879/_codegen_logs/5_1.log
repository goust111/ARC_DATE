+    if direction[0] == 0:
+        perps = [(-1, 0), (1, 0)]
+    else:
+        perps = [(0, -1), (0, 1)]
+    arm = (center[0] + direction[0], center[1] + direction[1])
+    foots = {
+        (arm[0] + perps[0][0], arm[1] + perps[0][1]),
+        (arm[0] + perps[1][0], arm[1] + perps[1][1]),
+    }
+    extras = set(arrow_cells) - {center, arm}
+    if len(extras) != 1 or next(iter(extras)) not in foots:
+        return None
