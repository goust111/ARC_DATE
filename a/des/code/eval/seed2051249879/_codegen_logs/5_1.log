+def _place_regions(grid: np.ndarray, occupied: np.ndarray, border_colors: list[int], pattern_colors: list[int]) -> bool:
+    h, w = grid.shape
+    sides = [random.randint(8, 12) for _ in border_colors]
+    random.shuffle(sides)
