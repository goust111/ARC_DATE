+    center = ((r0 + r1) // 2, (c0 + c1) // 2)
+    inner = grid[r0 + 1 : r1, c0 + 1 : c1]
+    arrow_cells = [(r0 + 1 + rr, c0 + 1 + cc) for rr, cc in zip(*np.where(inner != bg))]
