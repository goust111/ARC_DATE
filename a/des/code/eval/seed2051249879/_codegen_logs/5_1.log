+        if color == bg:
+            continue
+        for comp in components(grid == color):
+            if not _is_ring_component(comp):
+                continue
+            r0, c0, r1, c1 = bbox_of(comp)
+            frames.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "side_h": r1 - r0 + 1,
+                    "side_w": c1 - c0 + 1,
+                }
+            )
+    return frames
+
+
+def _majority_color(values: list[int]) -> int:
+    counts: dict[int, int] = {}
+    order: list[int] = []
+    for value in values:
