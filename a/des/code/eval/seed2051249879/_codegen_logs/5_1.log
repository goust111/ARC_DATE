+            frames.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "side_h": r1 - r0 + 1,
+                    "side_w": c1 - c0 + 1,
+                }
+            )
+    return frames
+
+
+def _majority_color(values: list[int]) -> int:
+    counts: dict[int, int] = {}
+    order: list[int] = []
+    for value in values:
+        if value not in counts:
+            counts[value] = 0
+            order.append(value)
+        counts[value] += 1
+    best = order[0]
+    for value in order[1:]:
+        if counts[value] > counts[best]:
+            best = value
+    return best
+
+
+def _rot_cw(pos: tuple[int, int], side: int) -> tuple[int, int]:
+    r, c = pos
+    return c, side - 1 - r
+
+
+def _rotation_orbits(side: int) -> list[list[tuple[int, int]]]:
+    seen: set[tuple[int, int]] = set()
+    out: list[list[tuple[int, int]]] = []
+    for r in range(side):
+        for c in range(side):
+            if (r, c) in seen:
+                continue
+            orbit: list[tuple[int, int]] = []
+            cur = (r, c)
+            for _ in range(4):
+                if cur not in orbit:
+                    orbit.append(cur)
+                cur = _rot_cw(cur, side)
+            for item in orbit:
+                seen.add(item)
+            out.append(orbit)
+    return out
