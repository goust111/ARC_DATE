+    corner = random.choice(["tl", "tr", "bl", "br"])
+    top = 1 if corner in {"tl", "tr"} else h - LEGEND_SIDE - 2
+    starts: list[int] = []
+    if corner in {"tl", "bl"}:
+        base = 2
+        for i in range(n):
+            starts.append(base + i * (LEGEND_SIDE + LEGEND_GAP))
+        label_dc = -1
+    else:
