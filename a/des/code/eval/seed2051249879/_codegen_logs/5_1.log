+    out: list[list[tuple[int, int]]] = []
+    for r in range(side):
+        for c in range(side):
+            if (r, c) in seen:
+                continue
+            orbit: list[tuple[int, int]] = []
+            cur = (r, c)
+            for _ in range(4):
+                if cur not in orbit:
+                    orbit.append(cur)
+                cur = _rot_cw(cur, side)
+            for item in orbit:
+                seen.add(item)
+            out.append(orbit)
+    return out
