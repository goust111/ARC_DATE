+def _parse_legend(frame: dict, grid: np.ndarray, bg: int) -> tuple[int, int] | None:
+    r0, c0, r1, c1 = frame["bbox"]
+    h = frame["side_h"]
+    w = frame["side_w"]
+    if h != w or h % 2 == 0 or h < 5:
+        return None
