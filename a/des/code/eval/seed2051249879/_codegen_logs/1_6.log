+            "direction": direction,
+            "key_mask": key_mask,
+            "lock_bbox": (top, left, top + lock_h - 1, left + lock_w - 1),
+        }
+    return None
+
+
+def _place_key(grid: np.ndarray, blocked: np.ndarray, spec: dict, rng: random.Random) -> bool:
