+import numpy as np
+
+
+AZURE = 8
+BLACK = 0
+OBJECT_COLORS = (1, 2, 3, 4, 5, 6, 7, 9)
+GEN_RETRIES = 400
+OBJECT_RETRIES = 120
+PLACEMENT_RETRIES = 120
