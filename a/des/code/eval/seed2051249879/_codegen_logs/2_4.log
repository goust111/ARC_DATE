+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            queue = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while queue:
+                cr, cc = queue.popleft()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _enclosed_regions(grid: np.ndarray) -> list[dict[str, object]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    passable = (g == AZURE) | (g == BLACK)
+    regions: list[dict[str, object]] = []
+    for comp in _components(passable):
+        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in comp):
+            continue
+        black_cells = [(r, c) for r, c in comp if int(g[r, c]) == BLACK]
+        border_colors = set()
+        for r, c in comp:
+            for nr, nc in _neighbors4(r, c):
+                if 0 <= nr < h and 0 <= nc < w and not passable[nr, nc]:
+                    border_colors.add(int(g[nr, nc]))
+        regions.append(
+            {
+                "coords": comp,
+                "bbox": _bbox(comp),
+                "black": black_cells,
+                "border_colors": border_colors,
+            }
+        )
+    return regions
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+
+    for region in _enclosed_regions(g):
+        coords = region["coords"]
+        black_cells = region["black"]
+        if not black_cells:
+            continue
