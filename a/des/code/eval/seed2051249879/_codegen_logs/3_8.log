import numpy as np


GREY = 5
MAX_GENERATION_ATTEMPTS = 300
COLOR_VALUES = tuple(range(10))
GRID_HEIGHT_RANGE = (10, 19)
GRID_WIDTH_RANGE = (10, 19)
OBJECT_COUNT_RANGE = (3, 6)
OVERLAP_SIZE_RANGE = (2, 5)
SEPARATED_SIZE_RANGE = (2, 4)

OVERLAP_OFFSETS = [
    (dy, dx)
    for dy in range(-2, 3)
    for dx in range(-2, 3)
    if (dy, dx) != (0, 0)
]
SEPARATED_OFFSETS = [
    (dy, dx)
    for dy in range(-4, 5)
    for dx in range(-4, 5)
    if (dy, dx) != (0, 0) and max(abs(dy), abs(dx)) >= 3
]


def _bg_color(grid: np.ndarray) -> int:
    values, counts = np.unique(grid, return_counts=True)
    return int(values[np.argmax(counts)])


def _components(mask: np.ndarray) -> list[np.ndarray]:
    h, w = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    comps: list[np.ndarray] = []

    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            stack = [(r, c)]
            seen[r, c] = True
            cells = []
            while stack:
                cr, cc = stack.pop()
                cells.append((cr, cc))
                for nr, nc in (
                    (cr - 1, cc),
                    (cr + 1, cc),
                    (cr, cc - 1),
                    (cr, cc + 1),
                ):
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            comps.append(np.array(cells, dtype=int))
    return comps


def _extract_objects(grid: np.ndarray, bg: int) -> list[dict]:
    objects: list[dict] = []
    for color in np.unique(grid):
        color = int(color)
        if color in (bg, GREY):
            continue
        for coords in _components(grid == color):
            rs = coords[:, 0]
            cs = coords[:, 1]
            objects.append(
                {
                    "color": color,
                    "coords": coords,
                    "bbox": (
                        int(rs.min()),
                        int(cs.min()),
                        int(rs.max()),
                        int(cs.max()),
                    ),
                }
            )
    objects.sort(key=lambda obj: (obj["bbox"][0], obj["bbox"][1], obj["color"]))
    return objects


def _object_mask(shape: tuple[int, int], objects: list[dict]) -> np.ndarray:
    mask = np.zeros(shape, dtype=bool)
    for obj in objects:
        coords = obj["coords"]
        mask[coords[:, 0], coords[:, 1]] = True
    return mask


def _visible_shadow_coords(
    coords: np.ndarray,
    dy: int,
    dx: int,
    shape: tuple[int, int],
    object_mask: np.ndarray,
) -> tuple[np.ndarray, np.ndarray]:
    h, w = shape
    rr = coords[:, 0] + dy
    cc = coords[:, 1] + dx
    inside = (0 <= rr) & (rr < h) & (0 <= cc) & (cc < w)
    if not np.any(inside):
        return np.empty(0, dtype=int), np.empty(0, dtype=int)
    rr = rr[inside]
    cc = cc[inside]
    visible = ~object_mask[rr, cc]
    return rr[visible], cc[visible]


def _evaluate_offset(
    grid: np.ndarray,
    objects: list[dict],
    object_mask: np.ndarray,
    grey_mask: np.ndarray,
    dy: int,
    dx: int,
) -> tuple[tuple[int, int, int], tuple[int, ...], tuple[int, ...]] | None:
