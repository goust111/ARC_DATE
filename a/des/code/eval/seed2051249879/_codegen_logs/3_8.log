+    (dy, dx)
+    for dy in range(-2, 3)
+    for dx in range(-2, 3)
+    if (dy, dx) != (0, 0)
+]
+SEPARATED_OFFSETS = [
+    (dy, dx)
+    for dy in range(-4, 5)
+    for dx in range(-4, 5)
+    if (dy, dx) != (0, 0) and max(abs(dy), abs(dx)) >= 3
+]
