+    ranked.sort(key=lambda item: item[0], reverse=True)
+    return ranked
+
+
+def _infer_shadow_offset(grid: np.ndarray, objects: list[dict]) -> tuple[int, int] | None:
+    ranked = _rank_offsets(grid, objects)
+    if not ranked:
