+    return None
+
+
+def layout_row(
+    rng: random.Random, sizes: list[tuple[int, int]], gap_lo: int, gap_hi: int
+) -> tuple[list[tuple[int, int]], int, int]:
+    x = 0
+    positions: list[tuple[int, int]] = []
+    max_h = max(h for h, _ in sizes)
+    for i, (h, w) in enumerate(sizes):
+        y = rng.randint(0, max_h - h)
+        positions.append((y, x))
+        x += w
+        if i != len(sizes) - 1:
+            x += rng.randint(gap_lo, gap_hi)
+    return positions, max_h, x
+
+
+def layout_frames(
+    rng: random.Random, sizes: list[tuple[int, int]]
+) -> tuple[list[tuple[int, int]], int, int]:
+    n = len(sizes)
+    order = list(range(n))
+    rng.shuffle(order)
+    row_count = 1 if n <= 2 or rng.random() < 0.45 else 2
+    if row_count == 1:
+        rows = [order]
+    else:
+        split = rng.randint(1, n - 1)
+        rows = [order[:split], order[split:]]
+
+    positions = [(-1, -1)] * n
+    y = 0
+    content_w = 0
+    for row_idx, row in enumerate(rows):
+        row_sizes = [sizes[i] for i in row]
+        row_pos, row_h, row_w = layout_row(rng, row_sizes, 2, 4)
+        for i, idx in enumerate(row):
