+    frame_sizes = [(int(r["frame_h"]), int(r["frame_w"])) for r in regions]
+    frame_pos_rel, top_h, top_w = layout_frames(rng, frame_sizes)
+
+    template_order = list(range(num_templates))
+    rng.shuffle(template_order)
