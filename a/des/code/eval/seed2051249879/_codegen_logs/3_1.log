+        off_c = rng.randint(0, extra_w)
+        fragments = choose_fragments(rng, shape, shape_h, shape_w, inner_h, inner_w, off_r, off_c)
+        if fragments is None:
+            continue
+        return {
+            "color": color,
+            "shape": shape,
+            "shape_h": shape_h,
+            "shape_w": shape_w,
+            "inner_h": inner_h,
+            "inner_w": inner_w,
+            "off_r": off_r,
+            "off_c": off_c,
+            "fragments": fragments,
+            "frame_h": inner_h + 2,
+            "frame_w": inner_w + 2,
