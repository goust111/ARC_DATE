+    frame_color = max(
+        candidates,
+        key=lambda color: (
+            len(candidates[color]),
+            sum((r1 - r0 + 1) * (c1 - c0 + 1) for r0, c0, r1, c1 in candidates[color]),
+        ),
+    )
+    frames = sorted(candidates[frame_color])
+    return int(frame_color), frames
+
