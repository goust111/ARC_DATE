+def _turn_count(path: list[tuple[int, int]]) -> int:
+    turns = 0
+    for i in range(2, len(path)):
+        d1 = (
+            path[i - 1][0] - path[i - 2][0],
+            path[i - 1][1] - path[i - 2][1],
+        )
+        d2 = (
+            path[i][0] - path[i - 1][0],
+            path[i][1] - path[i - 1][1],
+        )
+        turns += d1 != d2
+    return turns
