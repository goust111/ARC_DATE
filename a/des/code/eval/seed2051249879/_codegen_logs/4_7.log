+def _neighbors4(r: int, c: int, shape: tuple[int, int]) -> list[Coord]:
+    h, w = shape
+    out: list[Coord] = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < h:
+        out.append((r + 1, c))
