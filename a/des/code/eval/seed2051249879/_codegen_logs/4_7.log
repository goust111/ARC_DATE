+    if not candidates:
+        return None
+
+    max_rings = min(3, max(1, len(candidates) // 5))
+    wanted = random.randint(1, max_rings)
+    for _ in range(40):
+        chosen: list[Coord] = []
+        for cand in random.sample(candidates, len(candidates)):
+            if all(max(abs(cand[0] - rr), abs(cand[1] - cc)) > 4 for rr, cc in chosen):
+                chosen.append(cand)
