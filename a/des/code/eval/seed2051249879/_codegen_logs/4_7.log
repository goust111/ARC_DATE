+def _is_ring_site(cells: list[Coord], idx: int, path_set: set[Coord], shape: tuple[int, int]) -> bool:
+    h, w = shape
+    r, c = cells[idx]
+    if not (2 <= r < h - 2 and 4 <= c < w - 4):
+        return False
+
+    window = cells[idx - 2 : idx + 3]
+    if any(rr != r for rr, _cc in window):
