+BLACK = 0
+GREY = 5
+MAROON = 9
+KEY_COLORS = [1, 2, 3, 4, 6, 7, 8]
+COLOR_PRIORITY = {color: idx for idx, color in enumerate(KEY_COLORS)}
+MAX_GENERATION_ATTEMPTS = 400
