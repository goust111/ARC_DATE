+    w = c1 - c0 + 1
+    if h < MIN_FRAME_SIZE or w < MIN_FRAME_SIZE:
+        return False
+    if len(points) != 2 * (h + w) - 4:
+        return False
+    local = np.zeros((h, w), dtype=bool)
+    for r, c in points:
+        local[r - r0, c - c0] = True
+    return bool(
+        np.all(local[0, :])
+        and np.all(local[-1, :])
+        and np.all(local[:, 0])
+        and np.all(local[:, -1])
+        and not np.any(local[1:-1, 1:-1])
+    )
+
+
+def _detect_arrow(points: list[tuple[int, int]]) -> str:
