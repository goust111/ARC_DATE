+            {"bbox": (r2, w1 + gap, r2 + h2 - 1, w1 + gap + w2 - 1), "dir": "L"},
+        ]
+    else:
+        h1, w1 = d1
+        h2, w2 = d2
+        delta_low = -(w2 - MIN_OVERLAP)
+        delta_high = w1 - MIN_OVERLAP
+        c2 = random.randint(delta_low, delta_high)
