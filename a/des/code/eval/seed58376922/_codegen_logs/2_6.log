+def _separated(
+    a: tuple[int, int, int, int], b: tuple[int, int, int, int], min_gap: int = 2
+) -> bool:
+    hgap = max(0, b[1] - a[3] - 1, a[1] - b[3] - 1)
+    vgap = max(0, b[0] - a[2] - 1, a[0] - b[2] - 1)
+    if hgap == 0 and vgap == 0:
+        return False
+    return hgap >= min_gap or vgap >= min_gap
