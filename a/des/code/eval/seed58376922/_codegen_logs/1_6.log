+
+    inp, expected = _render_grid((h, w), legend_map, legend_corner, rays)
+    actual = main(inp)
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
