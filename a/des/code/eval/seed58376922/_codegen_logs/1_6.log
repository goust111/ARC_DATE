+        if c < w and (int(g[r0, c]) != bg or int(g[r1, c]) != bg):
+            return None
+    else:
+        cols_rev: list[int] = []
+        c = w - 1
+        while c >= 0 and int(g[r0, c]) != bg and int(g[r1, c]) != bg:
+            if int(g[r0, c]) == PRISM or int(g[r1, c]) == PRISM:
