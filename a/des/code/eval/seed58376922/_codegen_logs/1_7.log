+    pieces: List[Dict[str, object]] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(board[r, c])
+            if color == BG or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: List[Tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((cr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(board[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
