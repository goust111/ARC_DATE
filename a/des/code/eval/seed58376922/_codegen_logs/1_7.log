import random
from collections import deque


def normalize(cells):
    minr = min(r for r,c in cells)
    minc = min(c for r,c in cells)
    cells = sorted((r-minr, c-minc) for r,c in cells)
    h = max(r for r,c in cells)+1
    w = max(c for r,c in cells)+1
    return tuple(cells), h, w


def factor_pairs(n):
    out=[]
    for h in range(1,int(n**0.5)+1):
        if n%h==0:
            w=n//h
            out.append((h,w))
            if h"'!=w:
                out.append((w,h))
    return out


def solve(pieces, limit=2):
    area = sum(len(p['"'cells']) for p in pieces)
    best=[]
    for H,W in factor_pairs(area):
        if any(p['h']>H or p['w']>W for p in pieces):
            continue
        total = H*W
        placements=[]
        covers=[]
        ok=True
        for p in pieces:
            plist=[]
            cover=[[] for _ in range(total)]
            for dr in range(H-p['h']+1):
                for dc in range(W-p['w']+1):
                    bits=0
                    for r,c in p['cells']:
                        idx=(r+dr)*W+(c+dc)
                        bits |= 1<<idx
                    idxp=len(plist)
                    plist.append((bits,dr,dc))
                    b=bits
                    while b:
                        lsb=b & -b
                        idx=lsb.bit_length()-1
                        cover[idx].append(idxp)
                        b "'^= lsb
            if not plist:
                ok=False
                break
            placements.append(plist)
            covers.append(cover)
        if not ok:
            continue
        full=(1<<total)-1
        sols=[]
        def rec(occ, rem, cur):
            if len(sols)>=limit:
                return
            if not rem:
                sols.append(cur.copy())
                return
            missing=(~occ)&full
            lsb=missing & -missing
            cell=lsb.bit_length()-1
            options=[]
            for i in rem:
                for pi in covers[i][cell]:
                    bits,dr,dc=placements[i][pi]
                    if bits & occ:
                        continue
                    options.append((len(covers[i][cell]), -len(pieces[i]['"'cells']), i, pi))
            options.sort()
            for *_rest, i, pi in options:
                bits,dr,dc=placements[i][pi]
                rem.remove(i)
                cur[i]=(dr,dc)
                rec(occ|bits, rem, cur)
                rem.add(i)
                cur.pop(i)
                if len(sols)>=limit:
                    return
        rec(0,set(range(len(pieces))),{})
        for sol in sols:
            best.append((H,W,sol))
            if len(best)>=limit:
                return best
    return best


def partition(H,W,K,rng):
    cells=[(r,c) for r in range(H) for c in range(W)]
    seeds=rng.sample(cells,K)
    regions=[{s} for s in seeds]
    owner={s:i for i,s in enumerate(seeds)}
    unassigned=set(cells)-set(seeds)
    frontiers=[]
    for i in range(K):
        fs=set()
        r,c=seeds[i]
        for nr,nc in ((r+1,c),(r-1,c),(r,c+1),(r,c-1)):
            if 0<=nr<H and 0<=nc<W and (nr,nc) in unassigned:
                fs.add((nr,nc))
        frontiers.append(fs)
    target=[H*W//K]*K
    for i in range(H*W%K):
        target[i]+=1
    rng.shuffle(target)
    while unassigned:
        choices=[]
        for i,fs in enumerate(frontiers):
            if fs:
                deficit=max(target[i]-len(regions[i]),0)
                choices.extend([i]*(1+deficit))
        if not choices:
            return None
        i=rng.choice(choices)
        cell=rng.choice(tuple(frontiers[i]))
        regions[i].add(cell)
        owner[cell]=i
        unassigned.remove(cell)
        r,c=cell
        for j in range(K):
            frontiers[j].discard(cell)
        for nr,nc in ((r+1,c),(r-1,c),(r,c+1),(r,c-1)):
            if 0<=nr<H and 0<=nc<W and (nr,nc) in unassigned:
                frontiers[i].add((nr,nc))
    return regions

rng=random.Random(0)
for t in range(20):
    for _ in range(100):
        H=rng.randint(5,8); W=rng.randint(5,8); K=rng.randint(3,5)
        regs=partition(H,W,K,rng)
        pieces=[]
