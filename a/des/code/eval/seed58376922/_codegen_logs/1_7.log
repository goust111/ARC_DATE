+def _piece_complexity_ok(pieces: Sequence[Dict[str, object]]) -> bool:
+    non_rect = sum(int(piece["area"]) < int(piece["h"]) * int(piece["w"]) for piece in pieces)
+    if non_rect < 2:
+        return False
+    return True
+
