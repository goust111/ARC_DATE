+    ph, pw = pattern.shape
+    row_choices = [r for r in range(3 - ph + 1) if r <= 1 < r + ph]
+    off_r = rng.choice(row_choices)
+    off_c = rng.randint(0, 3 - pw)
+    patch = band[off_r : off_r + ph, off_c : off_c + pw]
