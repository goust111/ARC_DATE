+    if blocked_hits == 0 or clear_hits == 0:
+        return None
+
+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
