+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BG = 0
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+MAX_GENERATION_ATTEMPTS = 400
