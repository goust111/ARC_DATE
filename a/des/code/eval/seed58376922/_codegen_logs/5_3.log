import random
from collections import Counter

COLOR_POOL=(1,2,3,4,6,7,8,9)

def sample_band(active):
    L=random.randint(1,3)
    if L==1:
        return [random.choice(active)]
    t=random.random()
    if t<0.25:
        x=random.choice(active)
        return [x]*L
    if t<0.55:
        a,b=random.sample(active,2)
        band=[a]*L
        idx=random.randrange(L)
        band[idx]=b
        if b not in band:
            band[-1]=b
        return band
    if t<0.8 and L<=len(active):
        return random.sample(active,L)
    choices=random.sample(active,2)
    return [random.choice(choices) for _ in range(L)]

def branch(rb,cb):
    row_last={}
    for i,x in enumerate(rb):
        row_last[x]=i
    common=[x for x in row_last if x in set(cb)]
    return min(len(common),2)

ok=0
for _ in range(5000):
    n=random.randint(4,7)
    active=random.sample(COLOR_POOL, random.randint(3,5))
    rows=[sample_band(active) for _ in range(n)]
    cols=[sample_band(active) for _ in range(n)]
    cnt=Counter(branch(r,c) for r in rows for c in cols)
    total=n*n
    if cnt[0]>=max(2,total//8) and cnt[1]>=max(2,total//8) and cnt[2]>=max(2,total//8):
        ok+=1
print(ok)
