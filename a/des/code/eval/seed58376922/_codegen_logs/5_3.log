+    try:
+        for r in range(r0, r1 + 1):
+            band = _contiguous_band(grid[r, : c0 - 1], bg)
+            if any(int(x) == int(color) for x in band):
+                return False
+        for c in range(c0, c1 + 1):
+            band = _contiguous_band(grid[: r0 - 1, c], bg)
+            if any(int(x) == int(color) for x in band):
+                return False
+    except AssertionError:
