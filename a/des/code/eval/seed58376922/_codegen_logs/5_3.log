+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+BOARD_COLOR = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+BOARD_SIZES = (5, 6)
+MAX_GENERATION_ATTEMPTS = 500
