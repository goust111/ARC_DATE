+            moved_right = _move_component(bottom, -bottom_shift, 0, g)
+            axis_sum = int(top["red"][0] + top_shift + bottom["red"][0] - bottom_shift)
+            assert axis_sum % 2 == 1
+            assert (top["red"][0] + top_shift) + 1 == bottom["red"][0] - bottom_shift
