+def _place_patch(
+    inp: np.ndarray,
+    out: np.ndarray,
+    reserved: np.ndarray,
+    patch_in: np.ndarray,
+    patch_out: np.ndarray,
+) -> bool:
+    ph, pw = patch_in.shape
+    h, w = inp.shape
+    mask = (patch_in != BLACK) | (patch_out != BLACK)
+    padded = _dilate8(mask)
+
+    if ph > h or pw > w:
+        return False
+
+    positions = [(r, c) for r in range(h - ph + 1) for c in range(w - pw + 1)]
+    random.shuffle(positions)
+    for top, left in positions[:PLACE_ATTEMPTS]:
+        window = reserved[top : top + ph, left : left + pw]
+        if np.any(window & padded):
+            continue
+        _stamp(inp, patch_in, top, left)
+        _stamp(out, patch_out, top, left)
+        window |= padded
+        return True
+    return False
+
