    # Local pruning: remove diagonal-adjacent leaf pixels only near diagonal hints.
    m = out == int(fg)
    changed = True
    while changed:
        changed = False
        to_clear: list[tuple[int, int]] = []
        for r in range(H):
            for c in range(W):
