+            gap = int(right["red"][1] - left["red"][1] - 1)
+            assert gap >= 1
+            left_shift = gap // 2
+            right_shift = gap - left_shift
+            moved = _move_component(left, 0, left_shift, g)
+            moved_right = _move_component(right, 0, -right_shift, g)
