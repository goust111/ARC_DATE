+    min_h = max(patch_in.shape[0] for patch_in, _ in specs) + 2
+    min_w = max(patch_in.shape[1] for patch_in, _ in specs) + 2
+    if min_h > GRID_HEIGHT_RANGE[1] or min_w > GRID_WIDTH_RANGE[1]:
