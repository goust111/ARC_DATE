+def _place_patch(
+    inp: np.ndarray,
+    out: np.ndarray,
+    reserved: np.ndarray,
+    patch_in: np.ndarray,
+    patch_out: np.ndarray,
+) -> bool:
+    ph, pw = patch_in.shape
+    h, w = inp.shape
+    mask = (patch_in != BLACK) | (patch_out != BLACK)
+    padded = np.zeros((ph + 2, pw + 2), dtype=bool)
+    padded[1 : ph + 1, 1 : pw + 1] = mask
+    padded = _dilate8(padded)
