+                remainder = set(cells)
+                remainder.remove(cell)
+                if len(remainder) >= 3 and _set_connected({(int(p), int(a)) for p, a in remainder}):
+                    removable.append(cell)
+            shapes.append(
+                {
+                    "cells": tuple(sorted((int(p), int(a)) for p, a in cells)),
