+def _stamp(canvas: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    h, w = patch.shape
+    region = canvas[top : top + h, left : left + w]
+    mask = patch != BLACK
+    assert not np.any((region != BLACK) & mask)
+    region[mask] = patch[mask]
+
