+        return None
+    if not _set_connected(left_cells):
+        return None
+    if not _set_connected(right_cells):
+        return None
+    if _dominant_color(_object_values(left_cells, base_colors)) != main_color:
+        return None
+    if _dominant_color(_object_values(right_cells, base_colors, mirrored=True)) != main_color:
+        return None
