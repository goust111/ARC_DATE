+HALF_SHAPES = _enumerate_half_shapes()
+MAIN_COLORS = tuple(color for color in range(10) if color not in {BLACK, RED})
+GRID_HEIGHT_RANGE = (14, 24)
+GRID_WIDTH_RANGE = (14, 24)
