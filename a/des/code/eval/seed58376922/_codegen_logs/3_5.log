+
+BG = 8
+FRAME = 5
+WALL = 3
+PIECE_COLORS = [0, 1, 2, 3, 4, 6, 7, 9]
+
+LAYOUT_OPTIONS = [(1, 2), (1, 3), (2, 2), (2, 3), (3, 2)]
