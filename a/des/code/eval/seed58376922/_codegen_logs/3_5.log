+    if frame_r + frame_h >= grid_h or frame_c + frame_w >= grid_w:
+        frame_r = random.randint(1, grid_h - frame_h - 1)
+        frame_c = random.randint(1, grid_w - frame_w - 1)
+
+    slot_specs = []
