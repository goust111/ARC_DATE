+def _neighbors(r: int, c: int, h: int, w: int, conn8: bool = False):
+    dirs = DIR8 if conn8 else DIR4
+    for dr, dc in dirs:
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            yield rr, cc
+
+
+def _mask_components(mask: np.ndarray, conn8: bool = False) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
