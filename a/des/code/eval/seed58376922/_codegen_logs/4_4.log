+YELLOW = 4
+GREY = 5
+ORANGE = 7
+PIPE_COLORS = {GREY, YELLOW, ORANGE}
+INPUT_COLORS = (1, 2, 3, 6, 8, 9)
+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+DIR8 = (
+    (1, 0),
+    (-1, 0),
+    (0, 1),
+    (0, -1),
