+        arr = np.zeros((h, w), dtype=int)
+        for r in range(h):
+            for col in range(w):
+                arr[r, col] = a if (r + col + phase) % 2 == 0 else b
+
+        dominoes = []
+        for r in range(h):
+            for col in range(w - 1):
+                dominoes.append([(r, col), (r, col + 1)])
+        for r in range(h - 1):
+            for col in range(w):
