+    best = None
+    for pts in comps:
+        r0, c0, r1, c1 = _bbox(pts)
+        sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+        local_pts = [(r - r0, c - c0) for r, c in pts]
+        mask = _mask_from_points(sub.shape, local_pts)
+        colors = set(map(int, sub[mask]))
+        if len(colors) != 1:
