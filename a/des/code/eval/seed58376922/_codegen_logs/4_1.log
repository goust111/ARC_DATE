+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+BG = 0
+MARKER_COLOR = 1
+FRAME_COLOR_CHOICES = [2, 3, 4, 5, 6, 7, 8, 9]
+GEN_RETRIES = 300
+GRID_H_RANGE = (26, 34)
+GRID_W_RANGE = (26, 34)
