+        pr0, pc0 = r0 + 1 + rr0, c0 + 1 + cc0
+        pr1, pc1 = r0 + 1 + rr1, c0 + 1 + cc1
+        ph, pw = pr1 - pr0 + 1, pc1 - pc0 + 1
+
+        touched = []
+        if pr0 == r0 + 1:
+            touched.append(("top", pw))
+        if pr1 == r1 - 1:
+            touched.append(("bottom", pw))
