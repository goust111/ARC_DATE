+def _extract_partitions(grid: np.ndarray, frame: dict, bg: int) -> list[dict]:
+    r0, c0, r1, c1 = frame["bbox"]
+    frame_color = frame["color"]
+    inner = grid[r0 + 1 : r1, c0 + 1 : c1]
+    parts = []
+    for pts in _components(inner == bg):
