+                "bbox": (r0, c0, r1, c1),
+                "sub": sub.copy(),
+                "shape": tuple(map(int, sub.shape)),
+                "size_key": _size_key(sub.shape),
+                "marker_color": marker_color,
+                "marker_side": marked_side,
+            }
+        )
