+        counts = Counter(map(int, sub.reshape(-1)))
+        marker = None
+        for color, count in counts.items():
+            if count != 1:
+                continue
+            pos = np.argwhere(sub == color)
+            rr, cc = map(int, pos[0])
+            try:
