+GRID_H_RANGE = (20, 30)
+GRID_W_RANGE = (20, 30)
+PAIR_COUNT_OPTIONS = (2, 3, 4)
+PLACEMENT_PADDING = 3
+GEN_ATTEMPTS = 400
+PAIR_ATTEMPTS = 300
