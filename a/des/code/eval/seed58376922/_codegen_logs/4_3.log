+        if not (0 <= c < pos):
+            return None
+        sc = 2 * pos - c
+        if sc <= pos or sc >= w:
+            return None
+        return r, sc
+    if not (pos < c < w):
+        return None
+    sc = 2 * pos - c
+    if sc >= pos or sc < 0:
+        return None
+    return r, sc
