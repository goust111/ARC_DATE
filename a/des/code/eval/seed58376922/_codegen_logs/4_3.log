+                if 0 <= tr < h and _should_replace(int(out[tr, sc]), int(g[sr, sc])):
+                    out[tr, sc] = int(g[sr, sc])
+    else:
+        col = int(axis["pos"])
+        if axis["target"] == "left":
+            src = np.argwhere(g[:, col + 1 :] != BG)
+            src[:, 1] += col + 1
+            out[:, col + 1 :] = BG
+            for sr, sc in src:
+                tc = 2 * col - int(sc)
+                if 0 <= tc < w and _should_replace(int(out[sr, tc]), int(g[sr, sc])):
+                    out[sr, tc] = int(g[sr, sc])
