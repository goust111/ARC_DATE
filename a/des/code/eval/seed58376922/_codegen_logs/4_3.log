+
+def _draw_axes(pattern: np.ndarray, axes: Sequence[Dict[str, object]]) -> np.ndarray:
+    out = pattern.copy()
+    h, w = out.shape
+    for axis in axes:
+        color = int(axis["color"])
+        pos = int(axis["pos"])
+        if axis["orientation"] == "h":
+            out[pos, :] = color
+        else:
