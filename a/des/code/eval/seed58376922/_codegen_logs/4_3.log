+
+def _reverse_unfold(
+    rng: random.Random, final_pattern: np.ndarray, axes: Sequence[Dict[str, object]], instruction_mask: np.ndarray
+) -> Optional[np.ndarray]:
+    pattern = final_pattern.copy()
+    h, w = pattern.shape
