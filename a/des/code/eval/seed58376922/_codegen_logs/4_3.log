+def _mirror_to_source(
+    axis: Dict[str, object], cell: Tuple[int, int], shape: Tuple[int, int]
+) -> Optional[Tuple[int, int]]:
+    h, w = shape
+    r, c = cell
+    pos = int(axis["pos"])
+    if axis["orientation"] == "h":
+        if axis["target"] == "up":
+            if not (0 <= r < pos):
+                return None
+            sr = 2 * pos - r
+            if sr <= pos or sr >= h:
+                return None
+            return sr, c
+        if not (pos < r < h):
+            return None
+        sr = 2 * pos - r
+        if sr >= pos or sr < 0:
+            return None
+        return sr, c
