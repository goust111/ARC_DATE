+def _crop_non_bg(grid: np.ndarray) -> np.ndarray:
+    pts = np.argwhere(grid != BG)
+    if pts.size == 0:
+        return np.zeros((1, 1), dtype=int)
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
