+                    "color": color,
+                    "orientation": "h",
+                    "pos": row,
+                    "target": target,
+                    "marker_cells": marker_cells,
+                }
+            )
+        else:
+            assert len(col_candidates) == 1
+            col = int(col_candidates[0])
+            target, marker_cells = _find_vertical_marker(g, col, color)
+            axes.append(
