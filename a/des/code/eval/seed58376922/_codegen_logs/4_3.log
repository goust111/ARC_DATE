+def _mirror_to_source(
+    axis: Dict[str, object], cell: Tuple[int, int], shape: Tuple[int, int]
+) -> Optional[Tuple[int, int]]:
+    h, w = shape
+    r, c = cell
+    pos = int(axis["pos"])
+    if axis["orientation"] == "h":
+        if axis["target"] == "up":
+            if not (0 <= r < pos):
+                return None
+            sr = 2 * pos - r
+            if sr <= pos or sr >= h:
+                return None
+            return sr, c
+        if not (pos < r < h):
+            return None
+        sr = 2 * pos - r
+        if sr >= pos or sr < 0:
+            return None
+        return sr, c
+
+    if axis["target"] == "left":
+        if not (0 <= c < pos):
+            return None
+        sc = 2 * pos - c
+        if sc <= pos or sc >= w:
+            return None
+        return r, sc
+    if not (pos < c < w):
+        return None
+    sc = 2 * pos - c
+    if sc >= pos or sc < 0:
+        return None
+    return r, sc
