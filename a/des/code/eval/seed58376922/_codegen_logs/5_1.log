+    a, b = rng.sample(colors, 2)
+    tex = np.zeros((TEXTURE_SIZE, TEXTURE_SIZE), dtype=int)
+    for r in range(TEXTURE_SIZE):
+        for c in range(TEXTURE_SIZE):
+            if style == "checker":
+                tex[r, c] = a if (r + c) % 2 == 0 else b
+            elif style == "vstripe":
