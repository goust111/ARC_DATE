+    occupancy = np.zeros((h, main_w), dtype=bool)
+    for spec in sorted(region_specs, key=lambda item: item["outer_h"] * item["outer_w"], reverse=True):
+        oh = spec["outer_h"]
+        ow = spec["outer_w"]
+        placed = False
+        for _ in range(300):
