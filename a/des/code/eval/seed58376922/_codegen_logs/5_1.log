+    score = Counter(item["color"] for item in candidates)
+    border_color = max(
+        score,
+        key=lambda color: (
+            score[color],
+            sum(int(item["interior_local"].sum()) for item in candidates if item["color"] == color),
+        ),
+    )
+    regions = [item for item in candidates if item["color"] == border_color]
