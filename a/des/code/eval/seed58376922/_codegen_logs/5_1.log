+
+            occupancy[r0 : r0 + oh, c0 : c0 + ow] = True
+            placed = True
+            break
+        if not placed:
+            return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    """
+    Randomly generate enclosed regions with seed shapes and a right-side template strip.
+    """
+    for _ in range(300):
+        rng = random.Random()
+        grid = _gen_attempt(rng)
+        if grid is not None:
