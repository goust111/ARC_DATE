+
+def _translate_box(box: tuple[int, int, int, int], dr: int, dc: int) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = box
+    return (r0 + dr, c0 + dc, r1 + dr, c1 + dc)
