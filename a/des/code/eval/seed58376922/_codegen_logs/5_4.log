+            shifted: dict[tuple[int, int], int] = {}
+            failed = False
+            for (r, c), color in obj["cells"].items():
+                rr = r + dr
+                cc = c + dc
+                if not (0 <= rr < h and 0 <= cc < w):
+                    failed = True
