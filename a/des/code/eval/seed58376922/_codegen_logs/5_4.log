+                    dr, dc = blocked_delta
+                    translated_box = _translate_box(current, dr, dc)
+
+                dst = (src[0] + dr, src[1] + dc)
+                if not (0 <= dst[0] < h and 0 <= dst[1] < w):
+                    continue
+                if dst in local_input or not _chebyshev_clear(dst, occupied_input | local_input, 1):
