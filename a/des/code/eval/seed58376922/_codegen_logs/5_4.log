+    r0, c0, r1, c1 = box
+    return (r0 - pad, c0 - pad, r1 + pad, c1 + pad)
+
+
+def _box_size(box: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = box
+    return (r1 - r0 + 1, c1 - c0 + 1)
