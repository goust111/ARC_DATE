+    for idx, obj in enumerate(objects):
+        while True:
+            footprint = set(obj["cells"])
+            matches = _adjacent_portals(footprint, portals)
+            if len(matches) != 1:
+                obj["stop_reason"] = "no_portal" if len(matches) == 0 else "ambiguous"
