+
+
+def _chebyshev_clear(cell: tuple[int, int], occupied: set[tuple[int, int]], radius: int = 1) -> bool:
+    r, c = cell
+    for rr in range(r - radius, r + radius + 1):
+        for cc in range(c - radius, c + radius + 1):
+            if (rr, cc) in occupied:
