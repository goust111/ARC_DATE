+    min_r0 = 1
+    max_r0 = h - height - 1
+    min_c0 = 1
+    max_c0 = w - width - 1
+    if min_r0 > max_r0 or min_c0 > max_c0:
+        return None
+
+    for _ in range(80):
+        nr0 = random.randint(min_r0, max_r0)
+        nc0 = random.randint(min_c0, max_c0)
