+
+
+def _simulate(grid: np.ndarray) -> dict:
+    g = np.array(grid, dtype=int)
+    h, w = g.shape
+    bg = _bg_color(g)
+    comps = _components(g, bg)
+
+    portal_candidates: dict[int, list[tuple[int, int]]] = {}
+    objects: list[dict] = []
