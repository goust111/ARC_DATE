+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1)]
+PALETTE = tuple(range(1, 10))
+GEN_ATTEMPTS = 400
+OBJECT_ATTEMPTS = 200
