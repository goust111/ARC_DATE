+            if not failed:
+                grown = _grow_object(shifted, portal_color, h, w)
+                if grown is None:
+                    failed = True
+                else:
+                    grown_points = set(grown)
+                    for other_idx, other in enumerate(objects):
+                        if other_idx == idx:
+                            continue
+                        if grown_points & set(other["cells"]):
+                            failed = True
+                            break
+
+            if failed:
+                obj["stop_reason"] = "blocked"
+                break
