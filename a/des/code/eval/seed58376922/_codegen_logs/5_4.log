+        specs.append(spec)
+        existing_boxes.extend(spec["stage_boxes"])
+        occupied_input |= spec["input_cells"]
+
+    grid = _assemble_grid(h, w, specs)
+    analysis = _simulate(grid)
+    if not _matches_expectation(specs, analysis):
