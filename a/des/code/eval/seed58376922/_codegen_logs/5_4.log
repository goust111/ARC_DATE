+
+
+def _dilate8(points: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    for r, c in points:
+        for dr, dc in DIR8:
+            out.add((r + dr, c + dc))
