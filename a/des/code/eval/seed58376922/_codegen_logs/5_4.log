+
+
+def _sample_blocked_target(
+    current: tuple[int, int, int, int],
+    side: str,
+    h: int,
+    w: int,
+) -> tuple[int, int] | None:
+    height, width = _box_size(current)
+    if side == "left":
+        nc0 = random.randint(w - width + 1, w)
+        return (random.randint(0, h - height), nc0 - current[1])
+    if side == "right":
