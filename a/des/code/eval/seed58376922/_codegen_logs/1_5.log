+    if orientation == 1:
+        base = np.fliplr(base)
+    elif orientation == 2:
+        base = np.flipud(base)
+    elif orientation == 3:
+        base = np.flipud(np.fliplr(base))
+    return base
+
+
+def _sample_band_rows(rng: np.random.Generator, height: int, count: int) -> list[int] | None:
+    top_limit = max(6, height // 2 - 2)
