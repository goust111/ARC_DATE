+        return None
+
+    detected = _detect_frames(grid)
+    if len(detected) != len(frames):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
