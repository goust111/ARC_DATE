+        new_color = int(frame["color"])
+        crossed = [row for row in bands_desc if new_top <= row <= r0]
+        if crossed:
+            new_color = int(band_rows[crossed[-1]])
+        for r, c in frame["coords"]:
+            rr = int(r) - count
+            cc = int(c)
+            if 0 <= rr < g.shape[0] and 0 <= cc < g.shape[1] and rr not in band_rows:
+                out[rr, cc] = new_color
