+def _uniform_band_rows(grid: np.ndarray, bg: int) -> dict[int, int]:
+    bands: dict[int, int] = {}
+    for r in range(grid.shape[0]):
+        row = grid[r]
+        if row[0] != bg and np.all(row == row[0]):
+            bands[int(r)] = int(row[0])
+    return bands
