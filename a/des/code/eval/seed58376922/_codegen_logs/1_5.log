+def _detect_frames(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    bg = _bg_color(g)
+    band_rows = _uniform_band_rows(g, bg)
+    band_colors = set(band_rows.values())
