+        for dr, dc in frame["marker_coords"]:
+            grid[top + int(dr), left + int(dc)] = marker
+    return grid
+
+
+def _render_expected_output(
+    height: int,
+    width: int,
+    bg: int,
+    outline: int,
+    band_rows: list[int],
+    band_colors: list[int],
+    frames: list[dict],
+) -> np.ndarray:
