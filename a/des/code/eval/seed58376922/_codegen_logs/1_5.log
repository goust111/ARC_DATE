+        upper = int(min(height // 2, height - frame_h - 2))
+    elif branch < len(bands_desc):
+        lower = int(bands_desc[branch] + 1)
+        upper = int(bands_desc[branch - 1])
+    else:
+        lower = 1
+        upper = int(bands_desc[-1])
+    if lower > upper:
