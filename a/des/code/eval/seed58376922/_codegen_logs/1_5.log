+def _bg_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _cc4(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _uniform_band_rows(grid: np.ndarray, bg: int) -> dict[int, int]:
+    bands: dict[int, int] = {}
+    for r in range(grid.shape[0]):
+        row = grid[r]
+        if row[0] != bg and np.all(row == row[0]):
+            bands[int(r)] = int(row[0])
+    return bands
+
+
+def _enclosed_cells(shape: tuple[int, int], coords: np.ndarray) -> np.ndarray:
+    h, w = shape
+    r0, c0, r1, c1 = _bbox(coords)
+    if r0 == 0 or c0 == 0 or r1 == h - 1 or c1 == w - 1:
+        return np.empty((0, 2), dtype=int)
+
+    er0, ec0 = r0 - 1, c0 - 1
+    er1, ec1 = r1 + 1, c1 + 1
+    wall = np.zeros((er1 - er0 + 1, ec1 - ec0 + 1), dtype=bool)
+    for r, c in coords:
+        wall[int(r) - er0, int(c) - ec0] = True
+
+    seen = np.zeros_like(wall, dtype=bool)
+    q = deque()
+    hh, ww = wall.shape
+    border = set()
+    for rr in range(hh):
+        border.add((rr, 0))
+        border.add((rr, ww - 1))
+    for cc in range(ww):
+        border.add((0, cc))
+        border.add((hh - 1, cc))
+    for rr, cc in border:
+        if not wall[rr, cc] and not seen[rr, cc]:
+            seen[rr, cc] = True
+            q.append((rr, cc))
+    while q:
+        rr, cc = q.popleft()
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr, nc = rr + dr, cc + dc
+            if 0 <= nr < hh and 0 <= nc < ww and not wall[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
+
+    inside = []
+    for rr in range(hh):
+        for cc in range(ww):
