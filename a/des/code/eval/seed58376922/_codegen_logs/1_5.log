+def _shell_from_inner(inner: np.ndarray) -> np.ndarray:
+    pad = np.zeros((inner.shape[0] + 2, inner.shape[1] + 2), dtype=bool)
+    pad[1:-1, 1:-1] = inner
+    shell = np.zeros_like(pad)
+    h, w = pad.shape
+    for r in range(h):
+        for c in range(w):
