+    er0, ec0 = r0 - 1, c0 - 1
+    er1, ec1 = r1 + 1, c1 + 1
+    wall = np.zeros((er1 - er0 + 1, ec1 - ec0 + 1), dtype=bool)
+    for r, c in coords:
+        wall[int(r) - er0, int(c) - ec0] = True
+
+    seen = np.zeros_like(wall, dtype=bool)
+    q = deque()
+    hh, ww = wall.shape
+    border = set()
+    for rr in range(hh):
+        border.add((rr, 0))
+        border.add((rr, ww - 1))
+    for cc in range(ww):
+        border.add((0, cc))
+        border.add((hh - 1, cc))
+    for rr, cc in border:
+        if not wall[rr, cc] and not seen[rr, cc]:
+            seen[rr, cc] = True
+            q.append((rr, cc))
+    while q:
+        rr, cc = q.popleft()
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr, nc = rr + dr, cc + dc
+            if 0 <= nr < hh and 0 <= nc < ww and not wall[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
