+    for frame in frames:
+        count = int(frame["count"])
+        r0 = int(frame["bbox"][0])
+        new_top = r0 - count
+        new_color = int(frame["color"])
+        crossed = [row for row in bands_desc if new_top <= row <= r0]
+        if crossed:
