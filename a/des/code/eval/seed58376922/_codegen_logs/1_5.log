+            inside = _enclosed_cells(g.shape, coords)
+            if inside.size == 0:
+                continue
+            marker_count = sum(int(g[int(r), int(c)] != bg) for r, c in inside)
+            if marker_count >= len(inside):
+                continue
+            candidates.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "inside": inside,
+                    "bbox": _bbox(coords),
+                    "count": int(marker_count),
+                }
