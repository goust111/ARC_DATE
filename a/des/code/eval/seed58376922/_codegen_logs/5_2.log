+            valids = []
+            for k, cells in enumerate(rotated):
+                if all(0 <= ar + dr < inner_h and 0 <= ac + dc < inner_w for dr, dc in cells):
+                    valids.append(k)
+            if target_rot in valids and min(valids) == target_rot:
