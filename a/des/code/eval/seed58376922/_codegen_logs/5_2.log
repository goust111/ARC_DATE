+        rr1 = min(h, r0 + box_h + pad)
+        cc0 = max(0, c0 - pad)
+        cc1 = min(w, c0 + box_w + pad)
+        reserved[rr0:rr1, cc0:cc1] = True
+        return r0, c0
+    return None
