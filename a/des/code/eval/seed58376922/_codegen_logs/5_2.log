+def _components(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    if connectivity == 4:
+        neighbors = DIR4
+    else:
+        neighbors = DIR4 + [(-1, -1), (-1, 1), (1, -1), (1, 1)]
