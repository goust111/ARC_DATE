+        return None
+    max_r = h - box_h - 1
+    max_c = w - box_w - 1
+    if max_r < 1 or max_c < 1:
+        return None
+    for _ in range(500):
+        r0 = int(rng.integers(1, max_r + 1))
+        c0 = int(rng.integers(1, max_c + 1))
