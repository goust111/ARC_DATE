+
+def _candidate_anchors(
+    rel_cells: list[tuple[int, int]],
+    inner_h: int,
+    inner_w: int,
+    target_rot: int,
+) -> list[tuple[int, int]]:
+    rotated = [_rotate_rel_cells(rel_cells, k) for k in range(4)]
+    candidates: list[tuple[int, int, int]] = []
+    for ar in range(inner_h):
