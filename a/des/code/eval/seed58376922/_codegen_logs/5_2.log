            return None
        if side == "top":
            rr = int(pts[:, 0].min())
            cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])
            return ("h", int(rr), cols)
        if side == "bot":
            rr = int(pts[:, 0].max())
            cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])
