+
+
+def _build_expected(specs: list[dict[str, object]], shape: tuple[int, int], bg: int) -> np.ndarray:
+    out = np.full(shape, int(bg), dtype=int)
+    for spec in specs:
+        _paint_frame(out, spec, bg)
+    for spec in specs:
