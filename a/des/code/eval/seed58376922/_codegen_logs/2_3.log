+    primary_chain = random.choices([1, 2, 3], weights=[3, 4, 3], k=1)[0]
+    primary_dirs = (DOWN, RIGHT) if collision_mode else DIR_ORDER
+    primary = _try_random_chain_tower(
+        builder,
+        tower_colors[0],
+        primary_chain,
+        primary_dirs,
+        row_range=(1, h // 2),
