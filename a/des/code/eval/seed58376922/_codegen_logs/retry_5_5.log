+BG = 0
+POSITION_LABELS = {"TL": 2, "TR": 1, "BL": 3, "BR": 4}
+LABEL_TO_POSITION = {value: key for key, value in POSITION_LABELS.items()}
+POSITIONS = ("TL", "TR", "BL", "BR")
+BODY_POOL = (5, 6, 7, 8, 9)
+PATTERN_POOL = (1, 2, 3, 4)
+TARGET_POOL = tuple(range(1, 10))
+GEN_ATTEMPTS = 400
