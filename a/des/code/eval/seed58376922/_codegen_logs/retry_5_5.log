+    crop[crop == -1] = int(pattern_color)
+    mask = np.asarray(piece["mask"], dtype=bool)
+    h, w = crop.shape
+    view = out[top : top + h, left : left + w]
+    conflict = mask & (view != BG) & (view != crop)
+    if bool(conflict.any()):
+        raise AssertionError("piece overlap conflict")
