+    out = g.copy()
+    painted: set[tuple[int, int]] = set()
+
+    for source_color in sorted(source_colors):
+        starters = sorted(cell for cell, (color, _direction) in pointers.items() if color == source_color)
+        for starter in starters:
+            current = starter
