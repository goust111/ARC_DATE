+import random
+from typing import Callable
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR_TO_PATCH = {
+    (-1, 0): (0, 1),
+    (1, 0): (2, 1),
+    (0, -1): (1, 0),
+    (0, 1): (1, 2),
+}
+GEN_RETRIES = 300
