+
+BLACK = 0
+RED = 2
+GREY = 5
+AZURE = 8
+MAROON = 9
+FG_POOL = (1, 3, 4, 6, 7)
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+CORNER_COMBOS = {
+    n: tuple(combinations(((0, 0), (0, -1), (-1, 0), (-1, -1)), n))
+    for n in range(1, 5)
+}
