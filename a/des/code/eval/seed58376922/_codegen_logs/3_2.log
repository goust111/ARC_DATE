+    left_margin = random.randint(1, 2)
+    bottom_margin = random.randint(1, 2)
+    side_margin = random.randint(1, 2)
+    h = top_margin + rows * slot_h + bottom_margin
+    left_w = left_margin + cols * slot_w + side_margin
