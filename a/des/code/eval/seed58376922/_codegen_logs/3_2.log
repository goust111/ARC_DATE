+
+def _shape_plus(h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    cr = random.randrange(h)
+    cc = random.randrange(w)
+    vr = random.randint(0, cr)
+    vb = random.randint(0, h - 1 - cr)
