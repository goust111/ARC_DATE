+def _shape_rect(h: int, w: int) -> np.ndarray:
+    r0 = random.randint(0, h - 2)
+    r1 = random.randint(r0 + 1, h - 1)
+    c0 = random.randint(0, w - 2)
+    c1 = random.randint(c0 + 1, w - 1)
