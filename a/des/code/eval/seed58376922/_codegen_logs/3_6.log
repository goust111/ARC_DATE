+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+GREY = 5
+SHAPE_COLORS = (1, 3, 4, 6, 7, 8, 9)
+OPS = ("lr", "ud", "cw", "ccw")
+MAX_GRID_SIZE = 30
+GEN_RETRIES = 400
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, cnts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(cnts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.asarray(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _component_patch(grid: np.ndarray, coords: np.ndarray, bg: int) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = _bbox(coords)
+    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+    for r, c in coords:
+        patch[int(r) - r0, int(c) - c0] = int(grid[int(r), int(c)])
+    return patch, (r0, c0, r1, c1)
+
+
+def _is_rect_frame(grid: np.ndarray, color: int, coords: np.ndarray) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return (
+        int(coords.shape[0]) == int(border.sum())
+        and np.all(sub[border] == color)
+        and np.all(sub[~border] != color)
+    )
+
+
+def _find_lookup_frame(grid: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int]]:
+    candidates = []
+    for color in [int(v) for v in np.unique(grid) if int(v) != bg]:
+        for comp in _components(grid == color):
+            if not _is_rect_frame(grid, color, comp):
+                continue
+            r0, c0, r1, c1 = _bbox(comp)
+            inner = grid[r0 + 1 : r1, c0 + 1 : c1]
