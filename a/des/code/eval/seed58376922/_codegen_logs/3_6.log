+
+
+def _partition_counts(n: int) -> list[int]:
+    options = {
+        4: ([2, 2],),
+        5: ([2, 3], [3, 2], [2, 2, 1]),
+        6: ([3, 3], [2, 2, 2], [2, 3, 1]),
+    }
