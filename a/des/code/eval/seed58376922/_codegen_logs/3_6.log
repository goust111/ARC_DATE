+            seen = set()
+            for r, c in np.argwhere(mask):
+                for nr, nc in _neighbors4(int(r), int(c)):
+                    if 0 <= nr < size and 0 <= nc < size and not mask[nr, nc] and (nr, nc) not in seen:
