+def _classify_operator(patch: np.ndarray) -> str:
+    mask = patch == RED
+    h, w = mask.shape
+    area = int(mask.sum())
+    if area == 2 and h == 2 and w == 1:
+        return "lr"
+    if area == 2 and h == 1 and w == 2:
+        return "ud"
+    if area == 3 and h == 2 and w == 2:
+        if not mask[1, 0] and mask[1, 1]:
+            return "cw"
+        if mask[1, 0] and not mask[1, 1]:
+            return "ccw"
