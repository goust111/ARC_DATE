+
+def _random_mask(size: int) -> np.ndarray:
+    for _ in range(300):
+        target = random.randint(size + 1, size * size - 2)
+        mask = np.zeros((size, size), dtype=bool)
+        start = (random.randrange(size), random.randrange(size))
