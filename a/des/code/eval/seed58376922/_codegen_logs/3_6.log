+def _match_entry(patch: np.ndarray, entries: list[dict]) -> dict:
+    h, w = patch.shape
+    matches = []
+    for entry in entries:
+        kh, kw = entry["patch"].shape
+        if h % kh or w % kw:
+            continue
+        scale_h = h // kh
+        scale_w = w // kw
+        if scale_h != scale_w or scale_h < 1:
+            continue
