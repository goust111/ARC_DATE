def _layout_objects(patches: list[np.ndarray], legend_shape: tuple[int, int]) -> tuple[list[tuple[int, int]], tuple[int, int]]:
    n = len(patches)
    counts = _partition_counts(n)
    random.shuffle(patches)

    rows = []
    start = 0
    for count in counts:
        row_patches = patches[start : start + count]
        start += count
        gap_values = [random.randint(1, 2) for _ in range(max(0, len(row_patches) - 1))]
        row_h = max(p.shape[0] for p in row_patches)
        row_w = sum(p.shape[1] for p in row_patches) + sum(gap_values)
        rows.append((row_patches, gap_values, row_h, row_w))

    row_gap_values = [random.randint(1, 2) for _ in range(max(0, len(rows) - 1))]
    block_h = sum(row[2] for row in rows) + sum(row_gap_values)
    block_w = max(row[3] for row in rows)

    min_h = 1 + legend_shape[0] + random.randint(2, 4) + block_h + 1
    min_w = max(legend_shape[1] + 2, block_w + 2)
    if min_h > MAX_GRID_SIZE or min_w > MAX_GRID_SIZE:
        raise RuntimeError("layout does not fit")

