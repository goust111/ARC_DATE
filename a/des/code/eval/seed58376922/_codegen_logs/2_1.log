+                    "color": value,
+                    "start": (r, c),
+                    "current": (r, c),
+                    "direction": _direction_for_cell(r, c, frame_bbox),
+                    "steps": 0,
+                    "branches": [],
+                    "stop_reason": None,
+                    "on_midline": _on_midline(r, c, frame_bbox),
+                }
+            )
+
+    active = list(range(len(records)))
+    while active:
+        proposals: dict[tuple[int, int], list[int]] = {}
+        blocked: dict[int, str] = {}
+
+        for idx in active:
+            rec = records[idx]
+            r, c = rec["current"]
+            dr, dc = rec["direction"]
+            nr, nc = r + dr, c + dc
