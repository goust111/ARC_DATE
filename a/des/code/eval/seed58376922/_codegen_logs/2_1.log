+            continue
+        dr, dc = cand.direction
+        for gap in range(3, min(4, cand.steps_to_boundary) + 1):
+            other = by_pos.get((cand.pos[0] + gap * dr, cand.pos[1] + gap * dc))
+            if other is not None and other.direction == cand.direction:
