+            rec = records[idx]
+            rec["current"] = (nr, nc)
+            rec["steps"] = int(rec["steps"]) + 1
+            out[nr, nc] = int(rec["color"])
+            next_active.append(idx)
+
+        branch_proposals: dict[tuple[int, int], list[int]] = {}
+        for idx in next_active:
+            rec = records[idx]
+            if int(rec["steps"]) % 2 != 0:
+                continue
+            r, c = rec["current"]
+            dr, dc = rec["direction"]
+            for br, bc in ((r + dr, c), (r, c + dc)):
