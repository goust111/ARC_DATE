+    def trace(first_next: tuple[int, int]) -> list[tuple[int, int]] | None:
+        order = [start]
+        prev = start
+        cur = first_next
+        while cur != start:
+            order.append(cur)
+            nxts = [p for p in neigh[cur] if p != prev]
+            if len(nxts) != 1:
+                return None
+            prev, cur = cur, nxts[0]
+            if len(order) > len(contour):
+                return None
+        return order if len(order) == len(contour) else None
