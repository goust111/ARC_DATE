+def _make_shape(rng: random.Random) -> np.ndarray | None:
+    ph = rng.randint(10, 17)
+    pw = rng.randint(10, 17)
+    mt = rng.randint(1, 3)
+    mb = rng.randint(1, 3)
+    ml = rng.randint(1, 3)
