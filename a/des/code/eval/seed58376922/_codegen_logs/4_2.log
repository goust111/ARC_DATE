+def _inside_region(grid: np.ndarray, seed: tuple[int, int]) -> set[tuple[int, int]]:
+    h, w = grid.shape
+    sr, sc = seed
+    seen = {(sr, sc)}
+    q = deque([(sr, sc)])
+    while q:
+        r, c = q.popleft()
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in seen and int(grid[nr, nc]) in (BG, SEED):
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return seen
