+            comp: list[tuple[int, int]] = []
+            q = deque([(r, c)])
+            seen[r, c] = True
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in neighbors4(cr, cc):
