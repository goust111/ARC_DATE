+def _pick_segment(rng: random.Random, length: int) -> tuple[int, int] | None:
+    if length < 4:
+        return None
+    max_span = max(2, length - 2)
+    span = rng.randint(2, max_span)
+    max_start = length - span - 1
+    if max_start < 1:
+        return None
+    start = rng.randint(1, max_start)
+    return start, span
