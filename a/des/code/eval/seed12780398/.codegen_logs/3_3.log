+def _source_coord(grid: np.ndarray) -> tuple[int, int]:
+    h, w = grid.shape
+    coords = [(int(r), int(c)) for r, c in np.argwhere(grid == BLUE)]
+    border = [
+        (r, c)
+        for r, c in coords
+        if r == 0 or c == 0 or r == h - 1 or c == w - 1
+    ]
+    assert len(border) == 1, "expected one border source"
+    return border[0]
