+def _branch_width(
+    comp: list[tuple[int, int]],
+    node: tuple[int, int],
+    h: int,
+    w: int,
+) -> int:
+    nr, nc = node
+    comp_set = set(comp)
+    touches = sum((ar, ac) in comp_set for ar, ac in _neighbors4(nr, nc, h, w))
