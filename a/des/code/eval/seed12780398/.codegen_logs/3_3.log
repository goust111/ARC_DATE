+            else:
+                terminals.add(end)
+            edges.append(
+                {
+                    "start": (current_row, current_col),
+                    "end": end,
+                    "width": widths[direction],
+                    "top": current_top,
+                    "bottom": current_bottom,
+                }
+            )
