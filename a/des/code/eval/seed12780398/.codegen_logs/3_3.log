+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+AZURE = 8
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    for dr, dc in DIR4:
+        nr = r + dr
+        nc = c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            yield nr, nc
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _has_block(coords: list[tuple[int, int]]) -> bool:
+    pts = set(coords)
+    for r, c in coords:
+        if (r + 1, c) in pts and (r, c + 1) in pts and (r + 1, c + 1) in pts:
+            return True
+    return False
+
+
+def _source_coord(grid: np.ndarray) -> tuple[int, int]:
+    h, w = grid.shape
+    coords = [(int(r), int(c)) for r, c in np.argwhere(grid == BLUE)]
+    border = [
+        (r, c)
+        for r, c in coords
+        if r == 0 or c == 0 or r == h - 1 or c == w - 1
+    ]
+    assert len(border) == 1, "expected one border source"
+    return border[0]
+
+
+def _event_kind(grid: np.ndarray, rc: tuple[int, int]) -> str:
+    color = int(grid[rc])
+    if color == BLUE:
+        return "source"
+    if color == RED:
+        return "node"
+    if color == YELLOW:
+        return "terminal"
+    raise AssertionError("unexpected event color")
+
