+    terminals: set[tuple[int, int]] = set()
+    edges: list[dict[str, object]] = []
+
+    source_width = random.choice([1, 2])
+    edges.append(
+        {
+            "start": source,
+            "end": nodes[0],
+            "width": source_width,
+            "top": top,
+            "bottom": bottom,
+        }
+    )
