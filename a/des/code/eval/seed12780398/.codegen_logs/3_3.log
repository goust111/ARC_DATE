+    def follow_component(comp_idx: int, from_event: tuple[int, int]) -> None:
+        if comp_idx in visited_components:
+            return
+        visited_components.add(comp_idx)
+        for r, c in green_components[comp_idx]:
+            out[r, c] = AZURE
