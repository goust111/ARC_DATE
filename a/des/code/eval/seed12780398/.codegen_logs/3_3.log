+    grid = np.full((h, w), BLACK, dtype=int)
+    grid[source] = BLUE
+    for node in nodes:
+        if grid[node] != BLACK:
+            return None
+        grid[node] = RED
+    for terminal in terminals:
+        if grid[terminal] != BLACK:
+            return None
+        grid[terminal] = YELLOW
+
+    for edge in edges:
+        coords = _edge_cells(
+            edge["start"],
+            edge["end"],
+            int(edge["width"]),
+            int(edge["top"]),
+            int(edge["bottom"]),
+        )
+        if not coords:
+            return None
+        for r, c in coords:
+            if not (0 <= r < h and 0 <= c < w):
+                return None
+            if grid[r, c] != BLACK:
+                return None
+        for r, c in coords:
+            grid[r, c] = GREEN
