+    if "right" in dirs:
+        rows["right"] = row
+    if "up" in dirs:
+        lo = top + 1
+        hi = row - SHIFT_MIN
+        if lo > hi:
+            return None
+        rows["up"] = random.randint(lo, hi)
+    if "down" in dirs:
+        lo = row + SHIFT_MIN
+        hi = bottom - 1
+        if lo > hi:
+            return None
+        rows["down"] = random.randint(lo, hi)
+    return rows
