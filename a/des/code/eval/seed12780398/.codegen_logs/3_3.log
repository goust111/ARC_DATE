+    comp_events: list[set[tuple[int, int]]] = []
+    for idx, comp in enumerate(green_components):
+        events: set[tuple[int, int]] = set()
+        for r, c in comp:
+            for nr, nc in _neighbors4(r, c, h, w):
+                color = int(g[nr, nc])
+                if color in (BLUE, RED, YELLOW):
