+def _neighbors(shape: tuple[int, int], r: int, c: int) -> list[Coord]:
+    out: list[Coord] = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < shape[0]:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < shape[1]:
+        out.append((r, c + 1))
