    for mask in _marker_shapes():
        h, w = mask.shape
        max_r0 = min(int(n) - h - EDGE_MARGIN, max_bottom - h + 1)
        if max_r0 < EDGE_MARGIN:
            continue
        for r0 in range(EDGE_MARGIN, max_r0 + 1):
