+    - At a blue instruction cell, the same rule applies with a left turn.
+    - Signals ignore one another and only recolor gray receiver endpoints.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    out = g.copy()
