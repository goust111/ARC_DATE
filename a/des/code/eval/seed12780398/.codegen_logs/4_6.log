+def paste(dst: np.ndarray, src: np.ndarray, r0: int, c0: int, transparent: int | None = None) -> None:
+    h, w = src.shape
+    view = dst[r0 : r0 + h, c0 : c0 + w]
+    if transparent is None:
+        view[:] = src
+        return
+    mask = src != transparent
+    view[mask] = src[mask]
