+            row = labels[r]
+            cut = 0
+            while cut < w and int(row[cut]) == left_label:
+                cut += 1
+            if cut == 0 or cut == w:
+                ok = False
+                break
+            if not np.all(row[:cut] == left_label) or not np.all(row[cut:] == right_label):
+                ok = False
+                break
+            cuts.append(cut)
+        if ok and len(set(cuts)) > 1:
+            return True
+    return False
+
