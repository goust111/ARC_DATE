+        mask[pick] = True
+
+    return mask
+
+
+def _random_partition(h: int, w: int) -> tuple[np.ndarray, np.ndarray] | None:
+    total = int(h * w)
+    min_area = max(5, int(np.ceil(total * 0.28)))
+    max_area = min(total - 5, int(np.floor(total * 0.72)))
+    if min_area > max_area:
+        return None
+
+    candidates = [
+        area
+        for area in range(min_area, max_area + 1)
+        if abs(2 * area - total) >= 2
+    ]
+    if not candidates:
+        return None
+
+    for _ in range(180):
+        target_area = random.choice(candidates)
+        mask = _grow_connected_mask(h, w, target_area)
+        if mask is None:
+            continue
+        other = ~mask
+        if not (_connected(mask) and _connected(other)):
+            continue
+        if not (_edge_mixed(mask) and _edge_mixed(other)):
+            continue
+        if not (_irregular(mask) and _irregular(other)):
+            continue
+        if random.random() < 0.5:
+            mask = np.rot90(mask, random.randrange(4))
+            if random.random() < 0.5:
+                mask = np.fliplr(mask)
