+    ring_candidates = {
+        (1, c) for c in range(1, w - 1)
+    } | {
+        (h - 2, c) for c in range(1, w - 1)
+    } | {
+        (r, 1) for r in range(2, h - 2)
+    } | {
+        (r, w - 2) for r in range(2, h - 2)
+    }
+    ring_candidates = [cell for cell in ring_candidates if not mask[cell]]
+    random.shuffle(ring_candidates)
