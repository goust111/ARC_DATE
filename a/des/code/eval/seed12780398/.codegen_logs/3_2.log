+    return bool(np.array_equal(a["mask"], ~b["mask"]))
+
+
+def _choose_large_small(a: dict, b: dict) -> tuple[dict, dict]:
+    if int(a["area"]) > int(b["area"]):
+        return a, b
+    if int(b["area"]) > int(a["area"]):
+        return b, a
+    if tuple(map(int, a["bbox"])) <= tuple(map(int, b["bbox"])):
+        return a, b
+    return b, a
