+
+BG = 0
+DIRS = ((1, 0), (-1, 0), (0, 1), (0, -1))
+DIAG_DIRS = DIRS + ((1, 1), (1, -1), (-1, 1), (-1, -1))
+COLORS = tuple(range(1, 10))
