+        random.shuffle(frontier_list)
+        pick = None
+        for nr, nc in frontier_list:
+            trial = mask.copy()
+            trial[nr, nc] = True
+            if _edge_mixed(trial) and _connected(~trial):
+                pick = (nr, nc)
+                break
