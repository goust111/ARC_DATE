+
+def _neighbors(r: int, c: int, h: int, w: int):
+    for dr, dc in DIRS:
+        nr = int(r + dr)
+        nc = int(c + dc)
+        if 0 <= nr < h and 0 <= nc < w:
+            yield nr, nc
+
+
+def _neighbors8(r: int, c: int, h: int, w: int):
+    for dr, dc in DIAG_DIRS:
+        nr = int(r + dr)
+        nc = int(c + dc)
+        if 0 <= nr < h and 0 <= nc < w:
+            yield nr, nc
+
+
+def _mask_from_coords(coords: np.ndarray) -> tuple[tuple[int, int, int, int], np.ndarray]:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    mask = np.zeros((int(r1 - r0 + 1), int(c1 - c0 + 1)), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return (r0, c0, r1, c1), mask
+
+
+def _find_components(grid: np.ndarray) -> list[dict]:
+    h, w = map(int, grid.shape)
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == BG:
+                continue
+            color = int(grid[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+
+            while q:
+                cr, cc = q.popleft()
+                cells.append((int(cr), int(cc)))
+                for nr, nc in _neighbors8(cr, cc, h, w):
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+
+            coords = np.array(cells, dtype=int)
+            bbox, mask = _mask_from_coords(coords)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": bbox,
+                    "mask": mask,
+                    "shape": tuple(map(int, mask.shape)),
+                    "area": int(mask.sum()),
