+def _random_partition(h: int, w: int) -> tuple[np.ndarray, np.ndarray] | None:
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
