    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
        nr,nc=r+dr,c+dc
        if 0<=nr<h and 0<=nc<w:
            yield nr,nc

def connected(mask,h,w):
    if not mask: return False
    start=next(iter(mask))
    q=deque([start]); seen={start}
    while q:
        r,c=q.popleft()
        for nr,nc in nbrs(r,c,h,w):
            if (nr,nc) in mask and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return len(seen)==len(mask)

def fullbbox(mask,h,w):
    rows=[r for r,c in mask]; cols=[c for r,c in mask]
    return min(rows)==0 and max(rows)==h-1 and min(cols)==0 and max(cols)==w-1

