+    gap_top = random.randint(1, w - 2)
+    gap_bottom = random.randint(1, w - 2)
+    gap_left = random.randint(1, h - 2)
+    gap_right = random.randint(1, h - 2)
+    mask[0, gap_top] = False
+    mask[-1, gap_bottom] = False
+    mask[gap_left, 0] = False
+    mask[gap_right, -1] = False
