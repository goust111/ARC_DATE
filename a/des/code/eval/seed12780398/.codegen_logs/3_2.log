+                best_area = area
+                best_pairs = ((i, j),) + pairs
+
+        return best_count, best_area, best_pairs
+
+    return list(solve((1 << n) - 1)[2])
+
+
+def _paint_rectangle(out: np.ndarray, bbox: tuple[int, int, int, int], fill: int, border: int) -> None:
+    r0, c0, r1, c1 = map(int, bbox)
