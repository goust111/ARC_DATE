+
+def _random_partition(h: int, w: int) -> tuple[np.ndarray, np.ndarray] | None:
+    for _ in range(80):
+        split = random.randint(1, h - 2)
+        top_cuts = [random.randint(1, w - 2)]
+        for _row in range(1, split + 1):
+            prev = int(top_cuts[-1])
+            lo = max(1, prev - 1)
+            hi = min(w - 2, prev + 1)
+            top_cuts.append(random.randint(lo, hi))
