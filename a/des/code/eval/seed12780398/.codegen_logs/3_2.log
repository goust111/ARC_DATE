+    footprint = sum((h + 2 * PLACEMENT_MARGIN) * (w + 2 * PLACEMENT_MARGIN) for h, w in dims)
+    footprint += singleton_count * (1 + 2 * PLACEMENT_MARGIN) ** 2
+    side = int(np.ceil(np.sqrt(footprint * 1.35)))
