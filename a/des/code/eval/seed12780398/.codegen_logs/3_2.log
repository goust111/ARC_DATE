+
+
+def _random_partition(h: int, w: int) -> tuple[np.ndarray, np.ndarray] | None:
+    total = int(h * w)
+    min_area = max(5, int(np.ceil(total * 0.28)))
+    max_area = min(total - 5, int(np.floor(total * 0.72)))
+    if min_area > max_area:
