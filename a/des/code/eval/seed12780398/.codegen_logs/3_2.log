+
+def _best_pairs(comps: list[dict]) -> list[tuple[int, int]]:
+    n = len(comps)
+    candidates = [[False] * n for _ in range(n)]
+    for i in range(n):
+        for j in range(i + 1, n):
+            candidates[i][j] = _are_complements(comps[i], comps[j])
