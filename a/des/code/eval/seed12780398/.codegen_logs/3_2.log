+
+def _place_bbox(occupied: np.ndarray, h: int, w: int) -> tuple[int, int] | None:
+    H, W = map(int, occupied.shape)
+    positions = [
+        (r, c)
+        for r in range(H - h + 1)
+        for c in range(W - w + 1)
+        if _can_place(occupied, r, c, h, w)
