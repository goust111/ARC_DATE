+            parent[nxt] = cell
+            q.append(nxt)
+
+    if goal not in parent:
+        return None
+
+    path: list[tuple[int, int]] = []
+    cur: tuple[int, int] | None = goal
+    while cur is not None:
+        path.append(cur)
+        cur = parent[cur]
+    path.reverse()
+    return path
