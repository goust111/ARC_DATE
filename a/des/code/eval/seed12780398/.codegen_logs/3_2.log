+    cc0 = max(0, int(c0) - PLACEMENT_MARGIN)
+    rr1 = min(int(occupied.shape[0]), int(r0 + h + PLACEMENT_MARGIN))
+    cc1 = min(int(occupied.shape[1]), int(c0 + w + PLACEMENT_MARGIN))
+    return not bool(occupied[rr0:rr1, cc0:cc1].any())
