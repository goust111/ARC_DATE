+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == BG:
+                continue
+            color = int(grid[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
