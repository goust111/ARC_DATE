+    mask = np.zeros((h, w), dtype=bool)
+    current = anchors[0]
+    mask[current] = True
+    for anchor in anchors[1:]:
+        path = _random_shortest_path(current, anchor, mask)
+        if path is None:
+            return None
+        for cell in path:
+            mask[cell] = True
+        current = anchor
+
+    if int(mask.sum()) > int(target_area):
+        return None
+
+    while int(mask.sum()) < int(target_area):
