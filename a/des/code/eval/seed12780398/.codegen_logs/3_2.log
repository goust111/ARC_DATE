+    seen = np.zeros((h, w), dtype=bool)
+    start_r, start_c = map(int, coords[0])
+    q = deque([(start_r, start_c)])
+    seen[start_r, start_c] = True
+    total = 0
+
+    while q:
+        r, c = q.popleft()
+        total += 1
+        for nr, nc in _neighbors(r, c, h, w):
