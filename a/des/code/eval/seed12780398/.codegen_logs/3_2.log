+    total = int(h * w)
+    base_area = int(mask.sum())
+    min_teeth_for_a = max(0, total // 2 + 1 - base_area)
+    max_teeth_for_b = max(-1, (total - 1) // 2 - base_area)
+    want_a_larger = random.random() < 0.5
