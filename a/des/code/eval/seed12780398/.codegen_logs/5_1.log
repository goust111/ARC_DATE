+    for r in range(h):
+        for c in range(w):
+            if work[r, c] == bg or seen[r, c]:
+                continue
+            color = int(work[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
