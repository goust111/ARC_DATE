+
+def _local_to_interior(
+    local: set[tuple[int, int]],
+    side: str,
+    inner_h: int,
+    inner_w: int,
+) -> set[tuple[int, int]]:
+    mapped: set[tuple[int, int]] = set()
+    if side == "top":
+        for u, v in local:
