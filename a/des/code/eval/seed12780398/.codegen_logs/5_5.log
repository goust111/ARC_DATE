+        base_w = random.randint(2, 4)
+        min_cells = max(3, (base_h * base_w + 2) // 3)
+        max_cells = min(base_h * base_w - 1, min_cells + 3)
+        if min_cells > max_cells:
+            continue
+        mask = random_connected_mask(base_h, base_w, random.randint(min_cells, max_cells))
