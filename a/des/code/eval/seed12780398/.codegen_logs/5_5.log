+    r0, c0, r1, c1 = bbox_coords(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    expected = 2 * (h + w) - 4
+    if len(coords) != expected:
+        return False
+    local = np.zeros((h, w), dtype=bool)
+    local[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    if local[1:-1, 1:-1].any():
+        return False
+    return bool(
+        np.all(local[0, :])
+        and np.all(local[-1, :])
+        and np.all(local[:, 0])
+        and np.all(local[:, -1])
+    )
