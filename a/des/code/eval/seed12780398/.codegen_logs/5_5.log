+import random
+from typing import Iterable
+
+import numpy as np
+
+
+MARKER_FLIP = 1
+MARKER_ROTATE = 2
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+NON_MARKER_COLORS = tuple(c for c in range(10) if c not in (MARKER_FLIP, MARKER_ROTATE))
+MAX_GENERATION_ATTEMPTS = 300
