+        second = axis2 - first
+        used_first.add(int(first))
+        used_second.add(int(second))
+
+        if kind == "tb":
+            markers = ((0, int(first)), (other_limit - 1, int(second)))
+        else:
+            markers = ((int(first), 0), (int(second), other_limit - 1))
+        pairs.append(
+            {
+                "color": int(color),
+                "kind": kind,
+                "axis2": int(axis2),
+                "markers": tuple(sorted(markers)),
