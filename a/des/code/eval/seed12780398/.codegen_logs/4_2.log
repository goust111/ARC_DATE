+
+    ranked = sorted(
+        ((abs(int(other["axis2"]) / 2.0 - target_coord), int(other["color"]), other) for other in candidates),
+        key=lambda item: item[0],
+    )
+    if len(ranked) > 1:
+        assert abs(ranked[0][0] - ranked[1][0]) > 1e-9, "nearest recolor marker must be unique"
