+    all_pairs = tb_pairs + lr_pairs
+    pair_map = {int(pair["color"]): pair for pair in all_pairs}
+
+    grid = np.full((h, w), BG, dtype=int)
+    blocked = np.zeros((h, w), dtype=bool)
