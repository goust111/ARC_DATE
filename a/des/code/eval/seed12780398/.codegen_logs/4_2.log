    if c == 0:
        return "left"
    if c == w - 1:
        return "right"
    raise AssertionError("marker must lie on the border")


def _extract_marker_pairs(grid: np.ndarray, bg: int) -> dict[int, dict[str, object]]:
    g = np.asarray(grid, dtype=int)
