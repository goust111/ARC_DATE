+    deltas: list[int] = []
+    for i in range(1, len(dirs)):
+        if dirs[i] == dirs[i - 1]:
+            continue
+        diff = (dirs[i] - dirs[i - 1]) % 4
+        assert diff in (1, 3), "only quarter turns are allowed"
