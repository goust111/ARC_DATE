    return out


def _gen_attempt() -> np.ndarray | None:
    border_color, fill_color = random.sample(GEN_COLOR_POOL, 2)
    half_h = random.choice(GEN_HALF_HEIGHTS)
    upper_in = _gen_fc4aaf52_upper(half_h, border_color, fill_color)
