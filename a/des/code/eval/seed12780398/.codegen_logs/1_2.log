def _axis_scores(coords: list[tuple[int, int]], width: int = GRID_SIZE) -> dict[int, int]:
    """Return {axis_k: symmetric_pair_count} for every candidate vertical axis."""
    pts = {(int(r), int(c)) for r, c in coords}
