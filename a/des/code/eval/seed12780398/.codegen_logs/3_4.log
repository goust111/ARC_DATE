+                "direction": direction,
+                "gap_len": int(gap_len),
+                "height": int(frame_h),
+                "width": int(frame_w),
+                "gap_local_coords": gap_local,
+                "border_local_coords": _all_border_coords(frame_h, frame_w, direction, gap_start, gap_len),
