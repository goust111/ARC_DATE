+    return {
+        "color": color,
+        "coords": coords,
+        "direction": direction,
+    }
+
+
+def _match_sprite(mask: np.ndarray) -> dict:
+    for gap_len, variants in SPRITE_TEMPLATES.items():
+        for variant_idx, base in enumerate(variants):
+            for k in range(4):
+                cand = np.rot90(base, k)
+                if cand.shape == mask.shape and np.array_equal(cand, mask):
+                    return {
