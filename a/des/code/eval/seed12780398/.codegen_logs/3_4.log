+
+
+def _can_place_reserved(blocked: np.ndarray, bbox: tuple[int, int, int, int], top: int, left: int) -> bool:
+    br0, bc0, br1, bc1 = bbox
+    gr0, gc0, gr1, gc1 = top + br0, left + bc0, top + br1, left + bc1
