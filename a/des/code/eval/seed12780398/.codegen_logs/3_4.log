+    center = np.array([(r0 + r1) / 2.0, (c0 + c1) / 2.0], dtype=float)
+    center_end = min(
+        ends,
+        key=lambda pt: (pt[0] - center[0]) ** 2 + (pt[1] - center[1]) ** 2,
+    )
+    tip = ends[1] if ends[0] == center_end else ends[0]
+    dr = tip[0] - elbow[0][0]
+    dc = tip[1] - elbow[0][1]
