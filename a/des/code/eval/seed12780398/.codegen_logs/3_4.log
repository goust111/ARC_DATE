+    expected = _build_expected(grid, specs, bg)
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        candidate = _attempt_generate()
+        if candidate is not None:
+            return candidate
