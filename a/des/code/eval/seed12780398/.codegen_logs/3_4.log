+            if all(not blocked[top + r, left + c] for r, c in fg):
+                positions.append((int(top), int(left)))
+    return positions
+
+
+def _draw_points(grid: np.ndarray, points: list[tuple[int, int]], color: int) -> None:
+    for r, c in points:
