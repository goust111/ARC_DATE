+    sprites = _find_external_sprites(g, set(arrows_by_color), frames)
+    for color, sprite in sprites.items():
+        frame = arrows_by_color[color]["frame"]
+        arrow = arrows_by_color[color]["arrow"]
+        for r, c in sprite["coords"]:
