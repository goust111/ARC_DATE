   323	def _loop_ok(mask):
   324	    """Check that mask is a single 4-connected simple closed curve with exactly one hole."""
   325	    _, n = label_mask(mask, connectivity=4)
   326	    if n != 1:
   327	        return False
   328	    # Vectorized degree check: each True pixel must have exactly 2 True 4-neighbors
   329	    deg = np.zeros_like(mask, dtype=int)
   330	    deg[1:, :] += mask[:-1, :]
   331	    deg[:-1, :] += mask[1:, :]
   332	    deg[:, 1:] += mask[:, :-1]
   333	    deg[:, :-1] += mask[:, 1:]
   334	    if not np.all(deg[mask] == 2):
   335	        return False
   336	    inv_lab, inv_n = label_mask(~mask, connectivity=4)
   337	    boundary = set(inv_lab[0, :]) | set(inv_lab[-1, :]) | set(inv_lab[:, 0]) | set(inv_lab[:, -1])
   338	    return sum(1 for k in range(1, inv_n + 1) if k not in boundary) == 1
