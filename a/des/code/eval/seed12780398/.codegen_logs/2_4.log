+    if active_rows.size == 0:
+        return None
+    start = int(active_rows[0])
+    end = int(active_rows[-1]) + 1
+    if (end - start) % 2 != 0:
+        return None
+
+    mapping: dict[int, int] = {}
+    for r in range(start, end, 2):
+        block = strip[r : r + 2, :]
+        if block.shape != (2, 2):
+            return None
+        if not (np.all(block[:, 0] == block[0, 0]) and np.all(block[:, 1] == block[0, 1])):
+            return None
+        occ = int(block[0, 0])
+        src = int(block[0, 1])
