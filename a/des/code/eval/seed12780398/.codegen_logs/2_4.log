   306	    own[:N, N:] = TR
   307	    own[N:, :N] = BL
   308	    own[N:, N:] = BR
   309	
   310	    # H-tabs: single-column strips crossing the horizontal boundary (row N)
   311	    for kind, col, up_owner, down_owner in [
   312	        ('H_left',  p,         BL, TL),
   313	        ('H_right', S - 1 - p, BR, TR),
   314	    ]:
   315	        spec = tab_specs.get(kind)
   316	        if spec is None:
   317	            continue
   318	        depth, direction = spec
   319	        if direction == 'up':
   320	            own[N - depth:N, col] = up_owner
   321	        else:
   322	            own[N:N + depth, col] = down_owner
   323	
   324	    # V-tabs: single-row strips crossing the vertical boundary (col N)
   325	    for kind, row, left_owner, right_owner in [
   326	        ('V_top', p,         TR, TL),
   327	        ('V_bot', S - 1 - p, BR, BL),
   328	    ]:
   329	        spec = tab_specs.get(kind)
   330	        if spec is None:
   331	            continue
   332	        depth, direction = spec
   333	        if direction == 'left':
   334	            own[row, N - depth:N] = left_owner
   335	        else:
   336	            own[row, N:N + depth] = right_owner
   337	
   338	    # Verify all four quadrant regions are non-empty and 8-connected
   339	    for q in (TL, TR, BL, BR):
   340	        mask = (own == q).astype(int)
   341	        if mask.sum() == 0:
   342	            return None
   343	        if not is_contiguous(mask, background=0, connectivity=8):
   344	            return None
   345	    return own
