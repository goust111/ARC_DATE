    69	    matches: list[tuple[int, int, np.ndarray]] = []
    70	    for fg in colors:
    71	        bg = int(colors[0] if int(colors[1]) == int(fg) else colors[1])
    72	        visible = g == int(fg)
    73	        for pattern in _dihedral_variants(base):
    74	            for r in range(20 - H + 1):
    75	                for c in range(20 - W + 1):
    76	                    if np.array_equal(pattern[r : r + H, c : c + W], visible):
    77	                        matches.append((int(fg), int(bg), pattern))
