+    if side == "left":
+        gh = parallel_a + ph + parallel_b
+        gw = 2 + near_gap + pw + far_gap
+        return gh, gw, parallel_a, 2 + near_gap
+    gh = parallel_a + ph + parallel_b
+    gw = far_gap + pw + near_gap + 2
+    return gh, gw, parallel_a, far_gap
