+    for c in range(start, end, 2):
+        block = strip[:, c : c + 2]
+        if block.shape != (2, 2):
+            return None
+        if not (np.all(block[0] == block[0, 0]) and np.all(block[1] == block[1, 0])):
+            return None
+        occ = int(block[0, 0])
+        src = int(block[1, 0])
+        if occ == bg or src == bg or occ == src:
+            return None
+        if occ in mapping and mapping[occ] != src:
+            return None
+        mapping[occ] = src
+
+    if not mapping:
