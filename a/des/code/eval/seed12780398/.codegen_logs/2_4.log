   348	def _extract_piece(own: np.ndarray, q: int, color: int,
   349	                   marker_pos: tuple[int, int] | None = None) -> list[tuple[int, int, int]]:
   350	    """Extract cells for quadrant *q* in local (0-based) coordinates.
   351	
   352	    All cells get *color*, except *marker_pos* which gets MARKER_COLOR.
   353	    """
   354	    rows, cols = np.where(own == q)
   355	    min_r, min_c = rows.min(), cols.min()
   356	    cells = [(int(r) - min_r, int(c) - min_c, color) for r, c in zip(rows, cols)]
   357	    if marker_pos is not None:
