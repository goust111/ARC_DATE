    45	def main(grid: np.ndarray) -> np.ndarray:
    46	    """
    47	    Complete a visible crop into the shared 20x20 binary motif in its matching orientation.
    48	
    49	    Input structure:
    50	    - The grid is a two-color rectangular crop of one rotation/reflection of the same 20x20 motif.
    51	    - One color is the motif foreground and the other color is the motif background.
    52	
    53	    Rule:
    54	    - Try each input color as the foreground mask.
    55	    - Match that mask against every possible window in every dihedral orientation of the motif.
    56	    - Repaint the uniquely matched full 20x20 motif with the matched foreground/background colors.
    57	
    58	    Key insight:
    59	    - The examples are partial windows of one canonical binary pattern; the local crop is distinctive enough to identify the full orientation and offset.
    60	    """
    61	    g = np.asarray(grid, dtype=int)
    62	    H, W = map(int, g.shape)
    63	    assert H <= 20 and W <= 20
    64	
    65	    colors = colors_present(g)
    66	    assert len(colors) == 2
