+
+    if not have_interior_shape:
+        return None
+    if not _valid_generated_grid(grid, count):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt(rng)
