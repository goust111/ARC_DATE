+        for c in range(interior_w):
+            if object_mask[r, c]:
+                continue
+            fr, fc = r + 1, c + 1
+            touches_wall = False
+            for dr, dc in NEIGHBORS4:
+                nr, nc = fr + dr, fc + dc
+                if 0 <= nr < frame_mask.shape[0] and 0 <= nc < frame_mask.shape[1] and frame_mask[nr, nc]:
