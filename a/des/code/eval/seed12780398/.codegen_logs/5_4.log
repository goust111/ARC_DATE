+# --------------- generator ---------------
+
+GEN_ATTEMPTS = 400
+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (18, 30)
+COUNT_OPTIONS = (1, 2, 3)
+COUNT_WEIGHTS = (2, 4, 3)
+COLOR_POOL = tuple(range(10))
+PLACEMENT_PAD = 1
+STRUCTURE_TRIES = 120
+SHAPE_TRIES = 120
+PLAN_TRIES = 80
