+            back_gap = _randint(rng, 1, 5)
+            interior_h = open_gap + sh + back_gap
+            interior_w = left_gap + sw + right_gap
+            obj_top, obj_left = open_gap, left_gap
+            min_exit = sh + open_gap + 1
