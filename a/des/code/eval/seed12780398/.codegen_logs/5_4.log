+        land_r0 = obj_r0 + dr * distance
+        land_c0 = obj_c0 + dc * distance
+        land_r1 = obj_r1 + dr * distance
+        land_c1 = obj_c1 + dc * distance
+        span_r0 = min(0, land_r0)
+        span_c0 = min(0, land_c0)
