+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+DIRS = ("up", "down", "left", "right")
+DIR_VEC = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
+def get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            pts = [(r, c)]
+            while q:
+                cr, cc = q.popleft()
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+                        pts.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    pts = np.argwhere(mask)
+    assert len(pts) > 0
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return mask[r0 : r1 + 1, c0 : c1 + 1]
+
+
+def _boundary_mask(mask: np.ndarray) -> np.ndarray:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    out = np.zeros((h, w), dtype=bool)
+    for r, c in np.argwhere(mask):
+        for dr, dc in NEIGHBORS4:
+            nr, nc = int(r) + dr, int(c) + dc
+            if not (0 <= nr < h and 0 <= nc < w and mask[nr, nc]):
+                out[int(r), int(c)] = True
+                break
+    return out
+
+
+def _has_hole(mask: np.ndarray) -> bool:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    outside = np.zeros((h, w), dtype=bool)
+    q = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if not mask[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not mask[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for dr, dc in NEIGHBORS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+    return bool(np.any((~mask) & (~outside)))
+
+
+def _shape_has_interior(mask: np.ndarray) -> bool:
+    boundary = _boundary_mask(mask)
+    return bool(np.any(mask & (~boundary)))
+
+
+def _frame_pattern(height: int, width: int, opening: str) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    if opening == "up":
+        mask[0, 1:-1] = False
+    elif opening == "down":
+        mask[-1, 1:-1] = False
+    elif opening == "left":
+        mask[1:-1, 0] = False
+    elif opening == "right":
+        mask[1:-1, -1] = False
+    else:
+        raise ValueError(opening)
+    return mask
+
+
+def _match_frame(local_mask: np.ndarray) -> str | None:
+    h, w = local_mask.shape
+    if h < 3 or w < 3:
+        return None
+    for opening in DIRS:
+        if np.array_equal(local_mask, _frame_pattern(h, w, opening)):
