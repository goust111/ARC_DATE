+            "shape": shape,
+            "opening": opening,
+            "distance": int(distance),
+            "ammo": ammo,
+            "object_top": int(obj_top),
+            "object_left": int(obj_left),
+            "interior_h": int(interior_h),
+            "interior_w": int(interior_w),
+            "frame_h": int(frame_h),
+            "frame_w": int(frame_w),
