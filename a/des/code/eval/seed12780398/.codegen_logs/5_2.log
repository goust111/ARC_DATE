+FREE_COLORS = [0, 1, 3, 4, 6, 7, 8]
+LATTICE_SIDE_RANGE = (4, 6)
+STEP_CHOICES = [6, 7]
+NODE_COUNT_CHOICES = [1, 2, 3]
