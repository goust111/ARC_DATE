+def _boundary_starts(rows: int, cols: int) -> list[tuple[tuple[int, int], str]]:
+    starts: list[tuple[tuple[int, int], str]] = []
+    for c in range(cols):
+        starts.append(((0, c), "up"))
+        starts.append(((rows - 1, c), "down"))
