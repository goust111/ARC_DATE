+    terminal_centers: dict[int, tuple[int, int]] = {}
+    for terminal in terminals:
+        cr, cc = _center_for(terminal["cell"], step)
+        r0, c0 = cr - 1, cc - 1
+        grid[r0 : r0 + 3, c0 : c0 + 3] = MAROON
