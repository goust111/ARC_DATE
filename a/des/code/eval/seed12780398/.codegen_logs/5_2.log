+def _cell_neighbors(cell: tuple[int, int], rows: int, cols: int) -> list[tuple[str, tuple[int, int]]]:
+    r, c = cell
+    out = []
+    for side, (dr, dc) in SIDE_VECS.items():
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < rows and 0 <= nc < cols:
+            out.append((side, (nr, nc)))
+    return out
+
