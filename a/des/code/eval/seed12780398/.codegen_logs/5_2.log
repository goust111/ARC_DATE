+        if len(path) == node_count:
+            return list(path)
+        options = [cell for _side, cell in _cell_neighbors(path[-1], rows, cols) if cell not in path]
+        random.shuffle(options)
+        for nxt in options:
+            path.append(nxt)
+            result = dfs(path)
+            if result is not None:
+                return result
+            path.pop()
+        return None
