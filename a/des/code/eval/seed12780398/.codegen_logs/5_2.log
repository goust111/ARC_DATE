+def _assign_terminals(
+    specs: list[dict], rows: int, cols: int, path_cells: set[tuple[int, int]]
+) -> dict[int, dict] | None:
+    def backtrack(
+        remaining: set[int], occupied: set[tuple[int, int]], assigned: dict[int, dict]
+    ) -> dict[int, dict] | None:
+        if not remaining:
+            return assigned
