+        (int(r), int(c))
+        for r, c in np.argwhere(g == RED)
+        if r == 0 or c == 0 or r == g.shape[0] - 1 or c == g.shape[1] - 1
+    ]
+    assert len(source_pixels) == 1
+    src_r, src_c = source_pixels[0]
+    source_neighbors = [
