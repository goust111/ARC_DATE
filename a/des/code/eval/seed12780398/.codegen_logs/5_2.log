+def _side_between(src: tuple[int, int], dst: tuple[int, int]) -> str:
+    dr = dst[0] - src[0]
+    dc = dst[1] - src[1]
+    for side, (sdr, sdc) in SIDE_VECS.items():
+        if (dr, dc) == (sdr, sdc):
+            return side
