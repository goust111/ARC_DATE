+    order = sorted(
+        range(len(edges)),
+        key=lambda idx: -sum(len(incident[endpoint]) for endpoint in edges[idx]["ends"]),
+    )
+
+    def backtrack(pos: int) -> bool:
+        if pos == len(order):
+            return True
+        edge_index = order[pos]
+        edge = edges[edge_index]
+        a, b = edge["ends"]
