+
+def _box_border_is(patch: np.ndarray, color: int) -> bool:
+    return bool(
+        np.all(patch[0, :] == color)
+        and np.all(patch[2, :] == color)
+        and np.all(patch[:, 0] == color)
+        and np.all(patch[:, 2] == color)
+    )
+
+
+def _scan_objects(
+    grid: np.ndarray, bg: int
