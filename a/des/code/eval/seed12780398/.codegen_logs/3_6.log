+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+
+FILL_CYCLE = (RED, ORANGE, YELLOW, GREEN)
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
