+def _bfs_distances(graph: list[set[int]], start: int) -> dict[int, int]:
+    dist = {int(start): 0}
+    queue = deque([int(start)])
+    while queue:
+        node = queue.popleft()
+        for nxt in sorted(graph[node]):
+            if nxt in dist:
+                continue
+            dist[nxt] = dist[node] + 1
+            queue.append(nxt)
+    return dist
