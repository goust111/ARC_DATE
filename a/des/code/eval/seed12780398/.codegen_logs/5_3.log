+
+def _make_profile(rng: np.random.Generator, span: int, total: int) -> tuple[int, ...] | None:
+    candidates = []
+    for low in range(1, total - 1):
+        for high in range(low + 2, total):
+            candidates.append((low, high))
+    if not candidates:
