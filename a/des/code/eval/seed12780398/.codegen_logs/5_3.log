+            expected = _pack_rectangles(rectangles, grid_w, bg)
+            actual = main(grid)
+            if np.array_equal(actual, expected):
+                return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GENERATION_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
