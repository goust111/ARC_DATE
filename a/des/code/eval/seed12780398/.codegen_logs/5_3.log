+
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+ORIENTATION_PATTERNS = [
+    ("h", "v"),
+    ("h", "h"),
+    ("v", "v"),
+    ("h", "h", "v"),
+    ("h", "v", "v"),
+    ("h", "h", "v", "v"),
