+    w = max(profile)
+    mask = np.zeros((h, w), dtype=bool)
+    for r, width in enumerate(profile):
+        mask[r, w - width :] = True
+    return mask
+
+
+def _col_prefix_mask(profile: tuple[int, ...]) -> np.ndarray:
