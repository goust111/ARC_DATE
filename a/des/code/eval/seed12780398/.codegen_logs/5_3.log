+                    continue
+                built = {
+                    "orientation": "h",
+                    "mask_a": _row_prefix_mask(profile),
+                    "side_a": "left",
+                    "mask_b": _row_suffix_mask(other),
+                    "side_b": "right",
+                    "rect_shape": (rect_h, rect_w),
+                    "area": area,
