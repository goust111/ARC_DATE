+
+def _paint_mask(canvas: np.ndarray, mask: np.ndarray, color: int, r0: int, c0: int, bg: int) -> bool:
+    h, w = mask.shape
+    patch = canvas[r0 : r0 + h, c0 : c0 + w]
+    if np.any((patch != bg) & mask):
+        return False
+    patch[mask] = color
