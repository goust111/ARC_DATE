+        color_b = int(colors[color_idx + 1])
+        color_idx += 2
+        pieces.append({"mask": spec["mask_a"], "color": color_a})
+        pieces.append({"mask": spec["mask_b"], "color": color_b})
+        rectangles.append(
+            _render_spec(
+                spec["mask_a"],
+                spec["side_a"],
+                color_a,
+                spec["mask_b"],
+                spec["side_b"],
+                color_b,
