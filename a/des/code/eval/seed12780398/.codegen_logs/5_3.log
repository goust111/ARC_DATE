+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = cr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+            rows = [p[0] for p in coords]
+            cols = [p[1] for p in coords]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in coords:
+                mask[rr - r0, cc - c0] = True
+            components.append(
+                {
+                    "color": color,
+                    "mask": mask,
+                    "bbox": (r0, c0, r1, c1),
+                }
+            )
+    return components
+
+
+def _row_prefix_lengths(mask: np.ndarray) -> tuple[int, ...] | None:
+    lengths = []
+    for row in mask:
+        count = int(row.sum())
+        if count == 0:
+            return None
+        if not np.all(row[:count]) or np.any(row[count:]):
+            return None
+        lengths.append(count)
+    return tuple(lengths)
+
+
+def _row_suffix_lengths(mask: np.ndarray) -> tuple[int, ...] | None:
+    widths = []
+    w = mask.shape[1]
+    for row in mask:
+        count = int(row.sum())
+        if count == 0:
+            return None
+        start = w - count
+        if np.any(row[:start]) or not np.all(row[start:]):
+            return None
+        widths.append(count)
+    return tuple(widths)
+
+
+def _col_prefix_lengths(mask: np.ndarray) -> tuple[int, ...] | None:
+    heights = []
+    for col in mask.T:
+        count = int(col.sum())
+        if count == 0:
+            return None
+        if not np.all(col[:count]) or np.any(col[count:]):
+            return None
+        heights.append(count)
+    return tuple(heights)
+
+
+def _col_suffix_lengths(mask: np.ndarray) -> tuple[int, ...] | None:
+    heights = []
+    h = mask.shape[0]
+    for col in mask.T:
+        count = int(col.sum())
+        if count == 0:
+            return None
+        start = h - count
+        if np.any(col[:start]) or not np.all(col[start:]):
+            return None
+        heights.append(count)
+    return tuple(heights)
