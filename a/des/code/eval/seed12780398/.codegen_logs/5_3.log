+    w = len(profile)
+    mask = np.zeros((h, w), dtype=bool)
+    for c, height in enumerate(profile):
+        mask[:height, c] = True
+    return mask
+
+
+def _col_suffix_mask(profile: tuple[int, ...]) -> np.ndarray:
+    h = max(profile)
+    w = len(profile)
+    mask = np.zeros((h, w), dtype=bool)
+    for c, height in enumerate(profile):
+        mask[h - height :, c] = True
+    return mask
