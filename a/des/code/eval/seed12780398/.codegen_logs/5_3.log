+    for rect in rectangles:
+        h, w = rect.shape
+        if w > width:
+            raise AssertionError("packed rectangle wider than output width")
+        if col > 0 and col + w > width:
+            row += row_h + 1
+            col = 0
+            row_h = 0
+            wrapped = True
+        positions.append((row, col))
+        col += w + 1
+        row_h = max(row_h, h)
+    used_h = row + row_h
+    return positions, used_h, wrapped
