+                "mask_a": _col_prefix_mask(profile),
+                "side_a": "top",
+                "mask_b": _col_suffix_mask(other),
+                "side_b": "bottom",
+                "rect_shape": (rect_h, rect_w),
+                "area": area,
+            }
