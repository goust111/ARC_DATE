+    return tuple(heights)
+
+
+def _col_suffix_lengths(mask: np.ndarray) -> tuple[int, ...] | None:
+    heights = []
+    h = mask.shape[0]
+    for col in mask.T:
+        count = int(col.sum())
+        if count == 0:
+            return None
+        start = h - count
