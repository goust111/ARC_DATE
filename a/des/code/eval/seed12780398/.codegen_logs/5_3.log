+
+def _render_spec(mask_a: np.ndarray, side_a: str, color_a: int, mask_b: np.ndarray, side_b: str, color_b: int, bg: int) -> np.ndarray:
+    piece_a = {"mask": mask_a, "color": color_a}
+    piece_b = {"mask": mask_b, "color": color_b}
