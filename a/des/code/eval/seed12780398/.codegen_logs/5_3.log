+    used = [False] * len(components)
+    solutions: list[list[int]] = []
+
+    def backtrack(chosen: list[int]) -> None:
+        if len(solutions) > 1:
+            return
+        try:
+            first = next(i for i, flag in enumerate(used) if not flag)
