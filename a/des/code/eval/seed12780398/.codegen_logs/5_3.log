+def _row_suffix_lengths(mask: np.ndarray) -> tuple[int, ...] | None:
+    widths = []
+    w = mask.shape[1]
+    for row in mask:
+        count = int(row.sum())
+        if count == 0:
+            return None
+        start = w - count
+        if np.any(row[:start]) or not np.all(row[start:]):
+            return None
+        widths.append(count)
+    return tuple(widths)
