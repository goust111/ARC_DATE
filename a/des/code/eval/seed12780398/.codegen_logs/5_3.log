+    assert candidates, "expected at least one legal pairing candidate"
+    by_piece = {i: [] for i in range(len(components))}
+    for idx, cand in enumerate(candidates):
+        by_piece[cand["i"]].append(idx)
+        by_piece[cand["j"]].append(idx)
