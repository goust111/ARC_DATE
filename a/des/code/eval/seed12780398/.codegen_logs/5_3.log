+def _solve_pairs(components: list[dict], bg: int) -> list[dict]:
+    raw_candidates = []
+    for i, piece_a in enumerate(components):
+        for j in range(i + 1, len(components)):
+            piece_b = components[j]
+            for mode_a in piece_a["modes"]:
