+def _row_prefix_lengths(mask: np.ndarray) -> tuple[int, ...] | None:
+    lengths = []
+    for row in mask:
+        count = int(row.sum())
+        if count == 0:
+            return None
+        if not np.all(row[:count]) or np.any(row[count:]):
+            return None
+        lengths.append(count)
