+        placed = False
+        for _ in range(PLACEMENT_RETRIES):
+            r0 = int(rng.integers(0, grid_h - ph + 1))
+            c0 = int(rng.integers(0, grid_w - pw + 1))
+            r1 = r0 + ph
+            c1 = c0 + pw
+            rr0 = max(0, r0 - 1)
+            rr1 = min(grid_h, r1 + 1)
+            cc0 = max(0, c0 - 1)
+            cc1 = min(grid_w, c1 + 1)
+            if np.any(reserved[rr0:rr1, cc0:cc1]):
+                continue
+            grid[r0:r1, c0:c1][mask] = color
+            reserved[rr0:rr1, cc0:cc1] = True
+            placed = True
+            break
