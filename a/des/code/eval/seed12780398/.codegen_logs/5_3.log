+    return mask
+
+
+def _row_suffix_mask(profile: tuple[int, ...]) -> np.ndarray:
+    h = len(profile)
+    w = max(profile)
+    mask = np.zeros((h, w), dtype=bool)
+    for r, width in enumerate(profile):
