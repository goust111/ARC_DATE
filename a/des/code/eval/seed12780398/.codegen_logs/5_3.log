+                break
+            rect_w = int(vertical_spans[v_idx])
+            rect_h = int(rng.integers(5, 8))
+            profile = _make_profile(rng, rect_w, rect_h)
+            if profile is None:
+                continue
+            other = tuple(rect_h - v for v in profile)
+            area = rect_h * rect_w
+            if area in areas:
+                continue
+            built = {
+                "orientation": "v",
+                "mask_a": _col_prefix_mask(profile),
+                "side_a": "top",
