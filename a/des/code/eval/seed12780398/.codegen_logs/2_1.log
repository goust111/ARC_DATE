+def _parse_pattern_cell(cell: np.ndarray) -> np.ndarray:
+    pts = np.argwhere(cell != BG)
+    assert len(pts) > 0, "pattern cell must contain non-background colors"
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
