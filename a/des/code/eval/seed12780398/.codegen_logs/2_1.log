+                candidates.append((r, c))
+        if not candidates:
+            return None
+        tmp[idx] = rng.choice(candidates)
+        r, c = tmp[idx]
+        occupied[r : r + ph, c : c + pw] = True
+
+    for i in range(len(patches)):
+        placements.append(tmp[i])
+    return placements
+
+
+def _build_grid(
+    rng: random.Random,
+    legend_patch: np.ndarray,
+    orientation: str,
