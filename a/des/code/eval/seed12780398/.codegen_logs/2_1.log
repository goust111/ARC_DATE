+def _outside_mask(comp: np.ndarray) -> np.ndarray:
+    h, w = comp.shape
+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if not comp[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not comp[r, c] and not outside[r, c]:
