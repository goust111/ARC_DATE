+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+MAROON = 9
+PATTERN_COLORS = [1, 2, 3, 4, 6, 7, 8]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+SHAPES = [
+    (1, 1),
+    (1, 2),
+    (2, 1),
+    (2, 2),
+    (1, 3),
+    (3, 1),
+    (2, 3),
+    (3, 2),
+]
+
+SAMPLE_H = 3
+SAMPLE_W = 3
+PATTERN_BOX_H = 3
+PATTERN_BOX_W = 3
+GEN_RETRIES = 400
