NOTCH_N_RANGE = (1, 4)           # notch cell count (exclusive upper)
TOP_H_RANGE = (1, 4)             # top bar height (exclusive upper)
BOT_H_RANGE = (2, 4)             # bottom bar height (exclusive upper)
