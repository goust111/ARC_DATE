+    boundary = np.zeros((h, w), dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if not comp[r, c]:
+                continue
+            if r == 0 or r == h - 1 or c == 0 or c == w - 1:
+                boundary[r, c] = True
+                continue
+            for dr, dc in DIR4:
+                nr, nc = r + dr, c + dc
+                if outside[nr, nc]:
+                    boundary[r, c] = True
+                    break
