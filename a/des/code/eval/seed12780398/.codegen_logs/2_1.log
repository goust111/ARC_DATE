+def _carve_notches(
+    rng: random.Random,
+    mask: np.ndarray,
+    reserved: np.ndarray,
+) -> np.ndarray:
+    h, w = mask.shape
+    notch_count = rng.randint(0, 3)
+    for _ in range(notch_count):
+        for _try in range(30):
+            side = rng.choice(["top", "bottom", "left", "right"])
+            trial = mask.copy()
+            if side in ("top", "bottom"):
