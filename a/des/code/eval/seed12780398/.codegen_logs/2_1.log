+        legend_r = rng.randint(0, h - legend_h)
+        legend_c = w - legend_w
+        area_h = h
+        area_w = legend_c - 2
+        if area_w < 10:
+            return None
+        placements = _place_rectangles(rng, area_h, area_w, regions)
+        if placements is None:
+            return None
+        for rr, cc in placements:
+            pass
+    else:
+        w = rng.randint(max(28, legend_w), max(36, legend_w + 4))
+        h = rng.randint(18, 28)
+        if h <= legend_h + 8:
+            h = legend_h + rng.randint(9, 15)
+        grid = np.full((h, w), BG, dtype=int)
+        legend_r = h - legend_h
+        legend_c = rng.randint(0, w - legend_w)
+        area_h = legend_r - 2
+        area_w = w
+        if area_h < 10:
+            return None
