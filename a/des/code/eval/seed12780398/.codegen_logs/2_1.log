+    sorted_shapes = sorted(legend_shapes, key=lambda shape: shape[0] * shape[1])
+    mixed_candidates = [shape for shape in sorted_shapes if shape[0] * shape[1] > sorted_shapes[0][0] * sorted_shapes[0][1]]
