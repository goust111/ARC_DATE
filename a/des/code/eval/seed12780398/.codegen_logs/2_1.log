+def _boundary_mask(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    boundary = np.zeros((h, w), dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            if r == 0 or r == h - 1 or c == 0 or c == w - 1:
+                boundary[r, c] = True
