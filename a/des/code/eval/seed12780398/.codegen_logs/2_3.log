+    out = np.full((rows * cell_h, cols * cell_w), bg, dtype=int)
+    occupied = np.zeros_like(out, dtype=bool)
+    for r in range(rows):
+        for c in range(cols):
+            color = int(lookup[r, c])
+            piece = parsed[layout[r][c]]
+            base_r = r * cell_h
+            base_c = c * cell_w
+            for pr, pc in piece["coords"]:
