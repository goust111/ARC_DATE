_GEN_MARKER_COL_MIN, _GEN_MARKER_COL_STOP = 1, 9
_GEN_MARKER_SHAPE = ((0, 2), (1, 2), (2, 0), (2, 2), (3, 1))
_GEN_MARKER_ANCHOR_REL = (2, 0)
# Sprite shape and color sampling.
_GEN_SPRITE_COLORS = (1, 2, 3, 5, 8, 9)
