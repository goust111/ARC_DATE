+    return {
+        "color": int(piece["color"]),
+        "coords": piece["coords"],
+        "left": left,
+        "top": top,
+        "right": right,
+        "bottom": bottom,
+    }
+
+
+def _unique_map(values: list[tuple[tuple[int, ...], int]], name: str) -> dict[tuple[int, ...], int]:
+    out: dict[tuple[int, ...], int] = {}
+    for key, idx in values:
+        if not key:
+            continue
+        assert key not in out, f"duplicate {name} pattern"
+        out[key] = int(idx)
+    return out
+
+
