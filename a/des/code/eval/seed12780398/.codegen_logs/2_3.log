+    h, w = grid.shape
+    ph, pw = patch.shape
+    coords = [(int(r), int(c)) for r, c in np.argwhere(patch != bg)]
+    positions = []
+    row_range = range(1, h - ph) if require_margin else range(0, h - ph + 1)
+    col_range = range(1, w - pw) if require_margin else range(0, w - pw + 1)
+    for r0 in row_range:
+        for c0 in col_range:
