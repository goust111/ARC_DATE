+                cc = base_c + int(pc)
+                assert 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1], "assembled piece out of bounds"
+                assert not occupied[rr, cc], "interlocking pieces must not overlap"
+                occupied[rr, cc] = True
+                out[rr, cc] = color
