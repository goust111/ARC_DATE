+
+def _generate_case() -> tuple[np.ndarray, np.ndarray]:
+    rows, cols = random.choice(((2, 2), (2, 3), (3, 2), (2, 4), (4, 2)))
+    piece_count = rows * cols
+    cell_h = random.randint(6, 8)
+    cell_w = random.randint(6, 8)
