+
+def _matrix_patch(lookup: np.ndarray) -> np.ndarray:
+    rows, cols = lookup.shape
+    patch = np.full((2 * rows + 1, 2 * cols + 1), MATRIX_LINE, dtype=int)
+    patch[1::2, 1::2] = lookup
