+    if corner == "tr":
+        return grid[:height, w - width :], (0, w - width)
+    if corner == "bl":
+        return grid[h - height :, :width], (h - height, 0)
+    if corner == "br":
+        return grid[h - height :, w - width :], (h - height, w - width)
+    raise ValueError(f"unknown corner {corner}")
