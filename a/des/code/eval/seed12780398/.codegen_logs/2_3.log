+
+def _coords_to_patch(coords: tuple[tuple[int, int], ...], color: int, bg: int) -> np.ndarray:
+    max_r = max(r for r, _ in coords)
+    max_c = max(c for _, c in coords)
+    patch = np.full((max_r + 1, max_c + 1), bg, dtype=int)
+    for r, c in coords:
+        patch[r, c] = int(color)
