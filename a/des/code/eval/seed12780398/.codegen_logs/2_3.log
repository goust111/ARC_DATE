+from __future__ import annotations
+
+import itertools
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+MATRIX_LINE = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+GENERATE_ATTEMPTS = 400
+
+
+def _dominant_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _component_list(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((int(cr), int(cc)))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((int(nr), int(nc)))
+            out.append(coords)
+    return out
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _corner_region(grid: np.ndarray, corner: str, height: int, width: int) -> tuple[np.ndarray, tuple[int, int]]:
+    h, w = grid.shape
+    if corner == "tl":
+        return grid[:height, :width], (0, 0)
+    if corner == "tr":
+        return grid[:height, w - width :], (0, w - width)
+    if corner == "bl":
+        return grid[h - height :, :width], (h - height, 0)
+    if corner == "br":
+        return grid[h - height :, w - width :], (h - height, w - width)
+    raise ValueError(f"unknown corner {corner}")
+
+
+def _is_matrix_region(region: np.ndarray, bg: int) -> bool:
+    h, w = region.shape
+    if h < 5 or w < 5 or h % 2 == 0 or w % 2 == 0:
+        return False
+    line = int(region[0, 0])
+    if line == bg:
+        return False
+    for r in range(h):
+        for c in range(w):
+            val = int(region[r, c])
+            if r % 2 == 0 or c % 2 == 0:
+                if val != line:
+                    return False
+            elif val == bg or val == line:
+                return False
+    return True
+
