+
+BG = 0
+YELLOW = 4
+GREY = 5
+FRAME_COLORS = (1, 2, 3, 6, 7, 8, 9)
+MAX_LAYERS = 4
+GRID_MAX = 30
+GEN_RETRIES = 400
