+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _grow_bbox(bbox: tuple[int, int, int, int], layers: int) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = bbox
+    return (r0 - layers, c0 - layers, r1 + layers, c1 + layers)
+
+
+def _boxes_intersect(
+    a: tuple[int, int, int, int],
+    b: tuple[int, int, int, int],
+    pad: int = 0,
+) -> bool:
+    return not (
+        a[2] + pad < b[0]
+        or b[2] + pad < a[0]
+        or a[3] + pad < b[1]
+        or b[3] + pad < a[1]
+    )
+
+
+def _ring_cells(
+    bbox: tuple[int, int, int, int],
+    layer: int,
+    shape: tuple[int, int] | None = None,
+) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    rr0, cc0, rr1, cc1 = r0 - layer, c0 - layer, r1 + layer, c1 + layer
+    cells: set[tuple[int, int]] = set()
+    for c in range(cc0, cc1 + 1):
+        cells.add((rr0, c))
+        cells.add((rr1, c))
+    for r in range(rr0 + 1, rr1):
+        cells.add((r, cc0))
+        cells.add((r, cc1))
+    if shape is None:
+        return cells
+    h, w = shape
+    return {(r, c) for r, c in cells if 0 <= r < h and 0 <= c < w}
+
+
