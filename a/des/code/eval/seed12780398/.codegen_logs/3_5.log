+ORIENT_DELTAS = {
+    "H": (0, 1),
+    "V": (1, 0),
+    "D1": (1, 1),
+    "D2": (1, -1),
+}
+RIGHT_ANGLE_OPTIONS = (("H", "V"), ("D1", "D2"))
+SLANTED_OPTIONS = (("H", "D1"), ("H", "D2"), ("V", "D1"), ("V", "D2"))
