+    legend_mask = np.zeros_like(grid, dtype=bool)
+    legend_mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    return mapping, legend_mask
+
+
+def _evidence_color(
+    grid: np.ndarray,
+    legend_mask: np.ndarray,
+    r: int,
+    c: int,
+    orient: str,
+    allowed: set[int],
+) -> int | None:
+    dr, dc = ORIENT_DELTAS[orient]
+    r1, c1 = r - dr, c - dc
+    r2, c2 = r + dr, c + dc
