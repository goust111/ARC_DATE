+            near_row_edge = min(r0, h - 1 - r1) <= 1
+            near_col_edge = min(c0, w - 1 - c1) <= 1
+            if not (near_row_edge and near_col_edge):
+                continue
+            if len(comp) != _border_cell_count(hh, ww):
+                continue
+            border_ok = True
+            for rr in range(r0, r1 + 1):
