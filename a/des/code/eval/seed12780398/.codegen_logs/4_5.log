+    total_height = lengths["top"] + lengths["bottom"] + sum(lengths[f"gap{i}"] + 1 for i in range(m - 1))
+    left_lens = [lengths.get(f"L{i}", 0) for i in range(m)]
+    right_lens = [lengths.get(f"R{i}", 0) for i in range(m)]
