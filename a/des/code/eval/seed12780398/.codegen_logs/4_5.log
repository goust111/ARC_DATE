SQUARE_EDGE_GAP = 5                            # min gap from square to grid edges

# Obstacles
OBS_COUNT_4_PROB = 0.65                        # P(4 obstacles); else 3
OBS_THICKNESS_RANGE = (2, 4)                   # obstacle shorter-dimension bounds
OBS_SINGLE_MARGIN = 6                          # margin subtracted when only one side present
OBS_BOTH_GAP = 2                               # gap subtracted when both sides present

# Span selection
SPAN_MIN_MULT = 3                              # min obstacle length = SPAN_MIN_MULT * sz
SPAN_MAX_MULT = 14                             # max obstacle length = SPAN_MAX_MULT * sz
SPAN_COMPACT_PROB = 0.4                        # P(bias toward compact spans)

# Retry budget
MAX_RETRIES = 300



