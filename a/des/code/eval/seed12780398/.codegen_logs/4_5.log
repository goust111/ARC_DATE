+    mask = np.zeros((h, w), dtype=bool)
+    mask[trunk_row, left_endpoint : right_endpoint + 1] = True
+    intersections = {(trunk_row, c) for c in cols}
+    for i, c in enumerate(cols):
+        if up_lens[i] > 0:
+            mask[trunk_row - up_lens[i] : trunk_row + 1, c] = True
+        if down_lens[i] > 0:
