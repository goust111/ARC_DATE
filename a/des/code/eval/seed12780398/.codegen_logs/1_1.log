+def _touches_boundary(coords: np.ndarray, shape: tuple[int, int]) -> bool:
+    h, w = shape
+    return bool(
+        (coords[:, 0] == 0).any()
+        or (coords[:, 0] == h - 1).any()
+        or (coords[:, 1] == 0).any()
+        or (coords[:, 1] == w - 1).any()
