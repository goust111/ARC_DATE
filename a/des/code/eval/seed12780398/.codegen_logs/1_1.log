        out[r0 : r1 + 1, c0 : c1 + 1] = _tile(textures[room["seed"]], (r1 - r0 + 1, c1 - c0 + 1))
    return out


def _sample_canvas() -> tuple[np.ndarray, list[dict], dict[int, np.ndarray]] | None:
