+def _vary_mask(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    if random.random() < 0.5:
+        out = np.fliplr(out)
+    if random.random() < 0.5:
+        out = np.flipud(out)
+    out = np.rot90(out, random.randrange(4))
+    return out.copy()
+
