        grid[top + 2, wall_col + 1] = seed_color
        grid[top + 1 : top + 4, wall_col + 2 : wall_col + 5] = textures[seed_color]


def _expected_output(inp: np.ndarray, rooms: list[dict], textures: dict[int, np.ndarray]) -> np.ndarray:
    out = inp.copy()
