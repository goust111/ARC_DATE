            grid[seed_r, seed_c] = seed_color
            rooms.append({"bbox": (r0, c0, r1, c1), "seed": seed_color})
            room_index += 1
    return rooms


def _draw_dictionary(
    grid: np.ndarray,
    top: int,
    left: int,
    order: list[int],
    textures: dict[int, np.ndarray],
) -> None:
    width = ENTRY_STRIDE * len(order) + 1
