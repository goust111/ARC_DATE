+def _seed_order(seed: np.ndarray) -> list[int]:
+    h, w = seed.shape
+    top = 0
+    left = 0
+    bottom = h - 1
+    right = w - 1
+    order: list[int] = []
+    while top <= bottom and left <= right:
+        color = int(seed[top, left])
+        if not order or color != order[-1]:
+            order.append(color)
+        top += 1
+        left += 1
+        bottom -= 1
+        right -= 1
+    return order
+
