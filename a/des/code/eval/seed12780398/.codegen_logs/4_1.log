+def _background_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in ((cr + 1, cc), (cr - 1, cc), (cr, cc + 1), (cr, cc - 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_seed_bbox(grid: np.ndarray, bg: int) -> tuple[int, int, int, int]:
+    best_bbox = None
+    best_key = None
+    for comp in _components(grid != bg):
+        r0, c0, r1, c1 = _bbox(comp)
+        colors = {int(grid[r, c]) for r, c in comp}
+        if len(colors) < 3:
+            continue
+        key = (r0 + c0, r0, c0, (r1 - r0 + 1) * (c1 - c0 + 1))
+        if best_key is None or key < best_key:
+            best_key = key
+            best_bbox = (r0, c0, r1, c1)
+    if best_bbox is None:
+        raise ValueError("seed region not found")
+    return best_bbox
+
+
+def _seed_order(seed: np.ndarray) -> list[int]:
+    h, w = seed.shape
+    top = 0
+    left = 0
+    bottom = h - 1
+    right = w - 1
+    order: list[int] = []
+    while top <= bottom and left <= right:
+        color = int(seed[top, left])
+        if not order or color != order[-1]:
+            order.append(color)
+        top += 1
+        left += 1
+        bottom -= 1
+        right -= 1
+    return order
+
