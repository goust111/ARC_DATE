+    for _ in range(120):
+        center_h = rng.randint(2, 4 if layer_count == 4 else 5)
+        center_w = rng.randint(center_h, 6 if layer_count == 4 else 7)
+        if _best_factor_pair(center_h * center_w) != (center_h, center_w):
