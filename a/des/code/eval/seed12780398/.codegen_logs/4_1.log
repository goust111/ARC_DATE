+
+        spec = _reconstruct_structure(areas)
+        recovered = (
+            int(spec["inner_h"]),
+            int(spec["inner_w"]),
+            tuple(spec["thicknesses"]),
+            int(spec["outer_h"]),
+            int(spec["outer_w"]),
+        )
+        expected = (center_h, center_w, tuple(thicknesses), outer_h, outer_w)
+        if recovered != expected:
+            continue
+        return colors, areas, outer_h, outer_w, thicknesses
+
+    return None
