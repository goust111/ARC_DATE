+def _build_multi_target_case(
+    rng: random.Random,
+    rows: int,
+    cols: int,
+) -> Tuple[Tuple[int, int], List[Tuple[int, int]]]:
+    candidates = [
+        (r, c)
+        for r in range(rows)
+        for c in range(cols)
+        if (_neighbors((r, c), rows, cols).keys() & {"up", "down"})
+        and (_neighbors((r, c), rows, cols).keys() & {"left", "right"})
