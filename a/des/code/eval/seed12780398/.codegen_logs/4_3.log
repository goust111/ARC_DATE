+    sep_rows = _separator_rows(g)
+    sep_cols = _separator_cols(g)
+    row_spans = _spans(g.shape[0], sep_rows)
+    col_spans = _spans(g.shape[1], sep_cols)
+    assert row_spans and col_spans
