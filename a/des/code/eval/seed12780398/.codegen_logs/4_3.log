+def _neighbors(region: Tuple[int, int], rows: int, cols: int) -> Dict[str, Tuple[int, int]]:
+    r, c = region
+    result: Dict[str, Tuple[int, int]] = {}
+    if r > 0:
+        result["up"] = (r - 1, c)
+    if r + 1 < rows:
+        result["down"] = (r + 1, c)
+    if c > 0:
+        result["left"] = (r, c - 1)
+    if c + 1 < cols:
+        result["right"] = (r, c + 1)
+    return result
