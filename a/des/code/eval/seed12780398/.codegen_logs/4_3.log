    box_w = rng.randint(2, max_w)
    row_start = rng.randint(r_lo, r_hi - box_h + 1)
    col_start = rng.randint(c_lo, c_hi - box_w + 1)
    mask = _random_connected_shape(rng, box_h, box_w)

