+def _spans(length: int, separators: Sequence[int]) -> List[Tuple[int, int]]:
+    spans: List[Tuple[int, int]] = []
+    start = 0
+    for sep in separators:
+        if start <= sep - 1:
+            spans.append((start, sep - 1))
+        start = sep + 1
+    if start <= length - 1:
+        spans.append((start, length - 1))
+    return spans
+
