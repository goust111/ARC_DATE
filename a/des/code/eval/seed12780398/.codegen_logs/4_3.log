def _full_region_pattern(rng: random.Random, cell_h: int, cell_w: int) -> List[Tuple[int, int]]:
    row_margin = rng.randint(0, max(1, cell_h - 4))
    col_margin = rng.randint(0, max(1, cell_w - 4))
