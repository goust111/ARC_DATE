+def _make_partition_grid(rows: int, cols: int, cell_h: int, cell_w: int) -> Tuple[np.ndarray, List[Tuple[int, int]], List[Tuple[int, int]]]:
+    height = rows * cell_h + (rows - 1)
+    width = cols * cell_w + (cols - 1)
