+        if (mr, mc) in marker_cells:
+            return None
+        marker_cells.add((mr, mc))
+        grid[mr, mc] = RED
+
+    if not np.any(grid == RED):
+        return None
+    expected = grid.copy()
+    for edge in sorted(edges, key=lambda item: item["marker"]):  # type: ignore[index]
