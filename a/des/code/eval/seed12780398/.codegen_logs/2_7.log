+    def cells(self) -> set[tuple[int, int]]:
+        miss = self.missing_cell()
+        pts = set()
+        for dr in range(2):
+            for dc in range(2):
+                pt = (self.r0 + dr, self.c0 + dc)
+                if pt != miss:
+                    pts.add(pt)
+        return pts
