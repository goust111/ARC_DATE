+GEN_RETRIES = 300
+
+HORIZONTAL_OPTIONS = {
+    "facing": (("NE", "NW"), ("SE", "SW")),
+    "same": (("NW", "NW"), ("NE", "NE"), ("SW", "SW"), ("SE", "SE")),
+    "back": (("NW", "NE"), ("SW", "SE")),
+}
+VERTICAL_OPTIONS = {
+    "facing": (("SW", "NW"), ("SE", "NE")),
+    "same": (("NW", "NW"), ("NE", "NE"), ("SW", "SW"), ("SE", "SE")),
+    "back": (("NW", "SW"), ("NE", "SE")),
+}
+CORNER_OFFSETS = {
+    "NW": (0, 0),
+    "NE": (0, 1),
+    "SW": (1, 0),
+    "SE": (1, 1),
+}
+
