+        r0, c0, r1, c1 = _bbox(pts)
+        tile = _scaled_tile(textures[color], seed_count)
+        th, tw = tile.shape
+        for r, c in pts:
+            out[r, c] = int(tile[(r - r0) % th, (c - c0) % tw])
