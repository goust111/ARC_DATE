+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = np.zeros_like(mask, dtype=bool)
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            rs0 = max(0, -dr)
+            rs1 = min(h, h - dr)
+            cs0 = max(0, -dc)
+            cs1 = min(w, w - dc)
+            rd0 = max(0, dr)
+            rd1 = rd0 + (rs1 - rs0)
+            cd0 = max(0, dc)
+            cd1 = cd0 + (cs1 - cs0)
+            out[rd0:rd1, cd0:cd1] |= mask[rs0:rs1, cs0:cs1]
+    return out
