# Mover geometry and count.
MOVER_COUNT_RANGE = (1, 3)
MOVER_WIDTH_OPTIONS = (2, 3, 4)
MOVER_HEIGHT_RANGE = (2, 5)
MOVER_AREA_RANGE = (4, 10)
MOVER_MIN_DENSITY = (3, 4)
MOVER_MIN_COLUMN_STRIDE = 3
