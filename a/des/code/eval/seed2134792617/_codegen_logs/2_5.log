+            top, left = candidates[int(pick)]
+            if not _can_place_shape(spec["shape"], int(top), int(left), occ):
+                continue
+            placements[idx] = (int(top), int(left))
+            for r, c in spec["shape"]:
+                occ[int(top + r), int(left + c)] = True
+            break
