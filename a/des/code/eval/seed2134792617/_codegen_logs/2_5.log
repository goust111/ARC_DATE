+        sr, sc = map(int, seed[0])
+        cid = int(comp_labels[2 * sr, 2 * sc])
+        if cid == 0:
+            return None
+        coords = [(r + 1, c + 1) for r, c in comps[cid - 1]]
+        region_coords[region_id] = coords
+        region_areas[region_id] = len(coords)
