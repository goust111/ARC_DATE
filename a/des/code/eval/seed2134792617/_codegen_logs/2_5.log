+        weights = np.array([leaves[i][2] * leaves[i][3] for i in candidates], dtype=float)
+        pick_idx = int(candidates[int(RNG.choice(len(candidates), p=weights / weights.sum()))])
+        r0, c0, h, w = leaves.pop(pick_idx)
