+    crop = np.full((inner_h + 2, inner_w + 2), BG, dtype=int)
+    crop[0, :] = FRAME_COLOR
+    crop[-1, :] = FRAME_COLOR
+    crop[:, 0] = FRAME_COLOR
+    crop[:, -1] = FRAME_COLOR
+    crop[1:-1, 1:-1] = inner
+    return crop, region_coords, region_areas
