+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+BG = 0
+FRAME_COLOR = 5
+REGION_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+RNG = np.random.default_rng()
+GEN_RETRIES = 500
