+def _extract_regions(frame: np.ndarray, bg: int, frame_color: int) -> list[dict]:
+    labels, comps = _connected_components(frame == bg)
+    regions = []
+    for idx, coords in enumerate(comps, start=1):
+        shape, _, _ = _normalize_coords(coords)
+        regions.append(
+            {
+                "index": idx,
+                "coords": coords,
+                "shape": shape,
