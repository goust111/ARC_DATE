+def _connected_components(mask: np.ndarray) -> tuple[np.ndarray, list[list[tuple[int, int]]]]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    labels = np.zeros((h, w), dtype=int)
+    comps: list[list[tuple[int, int]]] = []
+    cid = 0
+    for r in range(h):
+        for c in range(w):
