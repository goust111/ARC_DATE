+    for c in range(c0, c1 + 1):
+        if c != c0 + gap_top_idx:
+            boundary_values.append(int(grid[r0, c]))
+        if c != c0 + gap_bottom_idx:
+            boundary_values.append(int(grid[r1, c]))
+    for r in range(r0 + 1, r1):
