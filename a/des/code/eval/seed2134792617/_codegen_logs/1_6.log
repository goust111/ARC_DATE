+            boundary_values.append(int(grid[r, c0]))
+        if r != r0 + gap_right_idx:
+            boundary_values.append(int(grid[r, c1]))
+    colors = set(boundary_values)
+    if bg in colors or len(colors) != 1:
+        return None
+
