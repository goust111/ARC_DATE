+    grid[cr0 : cr1 + 1, cc0 : cc1 + 1] = core_color
+
+    rings_inner_to_outer = _build_ring_spec(core_bbox, ring_count)
+    for ring, ring_color in zip(rings_inner_to_outer, ring_colors_inner_to_outer):
