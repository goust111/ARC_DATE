+
+def _orbit_touches(mask: np.ndarray, orb: tuple[tuple[int, int], ...]) -> bool:
+    h, w = mask.shape
+    for r, c in orb:
+        for nr, nc in _neighbors4(int(r), int(c)):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc]:
+                return True
+    return False
