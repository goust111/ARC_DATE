+    r0 = min(int(m["bbox"][0]) for m in molds)
+    c0 = min(int(m["bbox"][1]) for m in molds)
+    r1 = max(int(m["bbox"][2]) for m in molds)
+    c1 = max(int(m["bbox"][3]) for m in molds)
