+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(500):
+        built = _generate_example(rng)
+        if built is not None:
+            inp, _ = built
+            return inp
+    raise RuntimeError("failed to generate valid puzzle 7 input")

