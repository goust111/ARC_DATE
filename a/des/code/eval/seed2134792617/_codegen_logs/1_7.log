+    for i in range(0, len(run), 2):
+        mold_color = int(run[i])
+        rot_color = int(run[i + 1])
+        assert rot_color in ROTATION_COLOR_TO_K, "unknown rotation color"
+        mapping[mold_color] = int(ROTATION_COLOR_TO_K[rot_color])
