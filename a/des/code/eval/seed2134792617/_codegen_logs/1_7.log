+        hole_masks.append(mask)
+
+    source_patches: list[np.ndarray] = []
+    for hole_mask, rot_k in zip(hole_masks, rot_ks, strict=False):
+        patch = _sample_colored_patch(rng, hole_mask, rot_k, set(mold_colors))
+        if patch is None:
