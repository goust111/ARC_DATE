+def _sample_colored_patch(
+    rng: np.random.Generator, mask: np.ndarray, required_rot_k: int, forbidden_colors: set[int]
+) -> np.ndarray | None:
+    palette = [c for c in [1, 2, 3, 4, 6, 7, 8, 9] if c not in forbidden_colors]
+    cells = np.argwhere(mask)
+    for _ in range(300):
