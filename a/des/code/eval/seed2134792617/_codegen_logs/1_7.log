+        orbits: list[tuple[tuple[int, int], ...]] = []
+        seen: set[tuple[tuple[int, int], ...]] = set()
+        for r in range(size):
+            for cc in range(size):
+                if mask[r, cc]:
+                    continue
+                orb = _orbit((r, cc), size)
+                if orb not in seen:
+                    seen.add(orb)
+                    orbits.append(orb)
+        rng.shuffle(orbits)
+
+        min_extra = 0 if size == 3 else 1
+        max_extra = min(len(orbits), 1 if size == 3 else 4)
+        target_extra = int(rng.integers(min_extra, max_extra + 1))
+        added = 0
+        for orb in orbits:
+            if added >= target_extra:
+                break
+            if not _orbit_touches(mask, orb):
+                continue
+            if rng.random() < 0.75:
+                for r, c2 in orb:
+                    mask[r, c2] = True
+                added += 1
+
+        if size > 3 and added == 0:
+            continue
+        if mask.all():
+            continue
+        if not _is_connected(mask):
+            continue
+        if not np.array_equal(mask, np.rot90(mask, 1)):
+            continue
+        if not (mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any()):
+            continue
