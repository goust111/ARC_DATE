+    found: dict[tuple[tuple[int, int], bytes], np.ndarray] = {}
+    max_extra = min(len(orbits), 4 if size >= 7 else 3)
+    for extra_count in range(max_extra + 1):
+        for subset in combinations(orbits, extra_count):
+            mask = base.copy()
+            for orb in subset:
+                for r, c2 in orb:
+                    mask[r, c2] = True
+            if mask.all():
