+    inp = np.vstack([top, palette_row[np.newaxis, :]])
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp, expected
+
+
+def generate_input() -> np.ndarray:
