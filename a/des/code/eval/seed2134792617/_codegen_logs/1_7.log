+            candidates: list[tuple[int, int]] = []
+            for r in range(canvas_h - h + 1):
+                for c in range(canvas_w - w + 1):
+                    rr0 = max(0, r - gap)
+                    cc0 = max(0, c - gap)
+                    rr1 = min(canvas_h, r + h + gap)
+                    cc1 = min(canvas_w, c + w + gap)
+                    if not occ[rr0:rr1, cc0:cc1].any():
