+        seen: set[tuple[tuple[int, int], ...]] = set()
+        for r in range(size):
+            for cc in range(size):
+                if mask[r, cc]:
+                    continue
+                orb = _orbit((r, cc), size)
+                if orb not in seen:
+                    seen.add(orb)
+                    orbits.append(orb)
+        rng.shuffle(orbits)
