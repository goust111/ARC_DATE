+    if not np.array_equal(actual, expected):
+        return None
+    return inp, expected
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(500):
+        built = _generate_example(rng)
+        if built is not None:
