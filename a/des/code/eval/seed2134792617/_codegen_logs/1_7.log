+def _sample_symmetric_mask(
+    rng: np.random.Generator, used: set[tuple[tuple[int, int], bytes]], size: int
+) -> np.ndarray | None:
+    for _ in range(400):
+        c = size // 2
+        mask = np.zeros((size, size), dtype=bool)
+        mask[c, :] = True
+        mask[:, c] = True
