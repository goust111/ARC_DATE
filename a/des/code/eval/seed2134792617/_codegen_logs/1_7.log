+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(int(rr), int(cc)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            comps.append(np.asarray(cells, dtype=int))
+    return comps
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return r0, c0, r1, c1
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return None
+    return _bbox_from_coords(pts)
+
+
+def _shape_key(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    return tuple(map(int, mask.shape)), mask.astype(np.uint8).tobytes()
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, cnts = np.unique(grid, return_counts=True)
+    return int(vals[int(cnts.argmax())])
+
+
+def _find_material_frame(top: np.ndarray) -> tuple[int, int, int, int]:
+    gray_comps = _components(top == GRAY)
+    candidates: list[tuple[int, int, int, int]] = []
+    for comp in gray_comps:
+        r0, c0, r1, c1 = _bbox_from_coords(comp)
+        h = int(r1 - r0 + 1)
+        w = int(c1 - c0 + 1)
+        if h < 3 or w < 3:
+            continue
+        sub = top[r0 : r1 + 1, c0 : c1 + 1]
+        border = np.zeros((h, w), dtype=bool)
+        border[0, :] = True
+        border[-1, :] = True
+        border[:, 0] = True
+        border[:, -1] = True
+        if np.array_equal(sub == GRAY, border):
