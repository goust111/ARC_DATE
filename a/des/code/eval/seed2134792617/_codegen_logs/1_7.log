+    palette_pairs = list(zip(mold_colors, rot_ks, strict=False))
+    order = list(rng.permutation(len(palette_pairs)))
+    ordered_pairs = [palette_pairs[i] for i in order]
+    palette_len = 2 * len(ordered_pairs)
