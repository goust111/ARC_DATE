+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+GRAY = 5
+ROTATION_COLOR_TO_K = {
+    2: 0,  # red
+    3: 1,  # green
+    1: 2,  # blue
+    4: 3,  # yellow
+}
+ROTATION_K_TO_COLOR = {v: k for k, v in ROTATION_COLOR_TO_K.items()}
