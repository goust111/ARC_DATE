+def _is_connected(mask: np.ndarray) -> bool:
+    return len(_components(mask)) == 1
+
+
+def _hole_compatible(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    for comp in _components(~mask):
+        if not any(r == 0 or r == h - 1 or c == 0 or c == w - 1 for r, c in comp):
+            return False
+    return True
