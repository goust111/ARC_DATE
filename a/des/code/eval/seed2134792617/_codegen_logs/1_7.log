+def _orbit(cell: tuple[int, int], size: int) -> tuple[tuple[int, int], ...]:
+    r, c = cell
+    pts = []
+    for _ in range(4):
+        pts.append((int(r), int(c)))
+        r, c = c, size - 1 - r
+    return tuple(sorted(set(pts)))
