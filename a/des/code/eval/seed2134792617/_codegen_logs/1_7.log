+        rotated = np.rot90(source_patch, int(rot_k))
+        assert np.array_equal(rotated != bg, hole_mask), "rotated patch must fit its hole"
+        filled = top[r0 : r1 + 1, c0 : c1 + 1].copy()
+        target = filled[hr0 : hr1 + 1, hc0 : hc1 + 1]
