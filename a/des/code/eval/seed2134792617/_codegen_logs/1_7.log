+def _parse_palette(grid: np.ndarray, bg: int) -> dict[int, int]:
+    row = grid[-1]
+    cols = np.where(row != bg)[0]
+    assert cols.size >= 2 and cols.size % 2 == 0, "palette must occupy an even-length run"
+    start = int(cols[0])
+    end = int(cols[-1])
