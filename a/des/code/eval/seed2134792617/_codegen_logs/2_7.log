+) -> list[tuple[int, int]] | None:
+    cells: list[tuple[int, int]] = []
+    seen = set()
+    for (wr, wc), direction in zip(spec["windows"], spec["directions"]):
+        dr, dc = DIRS[direction]
+        ar, ac = top + wr, left + wc
