+
+
+def _border_key(a: tuple[int, int], b: tuple[int, int]) -> tuple[str, int, int]:
+    if a[0] == b[0]:
+        rr = int(a[0])
+        cc = min(int(a[1]), int(b[1]))
+        return ("v", rr, cc)
+    rr = min(int(a[0]), int(b[0]))
+    cc = int(a[1])
+    return ("h", rr, cc)
+
+
+def _border_candidates(
+    key: tuple[str, int, int], wall_rows: list[int], wall_cols: list[int]
+) -> list[tuple[int, int]]:
