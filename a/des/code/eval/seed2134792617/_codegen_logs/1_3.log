+def _render_output(
+    grid: np.ndarray,
+    events: list[dict[str, object]],
+) -> np.ndarray:
+    out = grid.copy()
+    for event in events:
+        top, left, bottom, right = map(int, event["target_bounds"])
+        row, col = map(int, event["start"])
+        dr, dc = map(int, event["step"])
+        for _ in range(int(event["length"])):
