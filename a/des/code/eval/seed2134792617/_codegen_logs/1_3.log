+        source_room = a if a_src else b
+        target_room = b if a_src else a
+        source = sources[source_room]
+        incoming[target_room] += 1
+        if door["kind"] == "h":
+            if source_room == a:
+                start = (int(coord[0] + 1), int(coord[1]))
+                step = (1, 0)
+            else:
+                start = (int(coord[0] - 1), int(coord[1]))
+                step = (-1, 0)
+        else:
+            if source_room == a:
+                start = (int(coord[0]), int(coord[1] + 1))
+                step = (0, 1)
+            else:
+                start = (int(coord[0]), int(coord[1] - 1))
+                step = (0, -1)
+        events.append(
