+    incoming: dict[tuple[int, int], int] = defaultdict(int)
+    for door in doors:
+        a = tuple(door["a"])
+        b = tuple(door["b"])
+        coord = tuple(door["coord"])
+        a_src = a in sources
+        b_src = b in sources
+        if a_src and b_src:
+            blocked += 1
+            continue
+        if not (a_src ^ b_src):
