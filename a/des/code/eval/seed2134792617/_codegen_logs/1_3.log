+    wall_cols: list[int],
+    sources: dict[tuple[int, int], dict[str, object]],
+    doors: list[dict[str, object]],
+) -> np.ndarray:
+    height = int(wall_rows[-1] + 1)
+    width = int(wall_cols[-1] + 1)
+    grid = np.full((height, width), BG_COLOR, dtype=int)
+    for row in wall_rows:
