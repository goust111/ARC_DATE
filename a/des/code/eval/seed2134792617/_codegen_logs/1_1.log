+            r0 = _rand_int(rng, 1, max_r0)
+            c0 = _rand_int(rng, 1, max_c0)
+            r1 = r0 + ph
+            c1 = c0 + pw
+            rr0 = r0 - 1
+            cc0 = c0 - 1
+            rr1 = min(h, r1 + 1)
+            cc1 = min(w, c1 + 1)
+            if np.any(occupied[rr0:rr1, cc0:cc1]):
+                continue
+
+            region = grid[r0:r1, c0:c1]
+            region[patch != 0] = patch[patch != 0]
+            occupied[r0:r1, c0:c1] = True
+            obj["top"] = int(r0)
+            obj["left"] = int(c0)
+            placed = True
+            break
+
+        if not placed:
+            return False
+
+    return True
+
+
+def _build_expected(
