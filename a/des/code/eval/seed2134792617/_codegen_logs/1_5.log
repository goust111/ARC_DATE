+def _border_values(patch: np.ndarray) -> list[int]:
+    vals = [int(x) for x in patch[0, :]]
+    vals += [int(x) for x in patch[-1, :]]
+    vals += [int(x) for x in patch[1:-1, 0]]
+    vals += [int(x) for x in patch[1:-1, -1]]
+    return vals
