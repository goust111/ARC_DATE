+    return False
+
+
+def _random_extension(
+    mask: np.ndarray,
+    forbidden: np.ndarray,
+    protected: set[tuple[int, int]],
+    max_degree: int,
+) -> bool:
+    starts = [
+        (int(r), int(c))
+        for r, c in np.argwhere(mask)
+        if (int(r), int(c)) not in protected and _degree(mask, (int(r), int(c))) < max_degree
