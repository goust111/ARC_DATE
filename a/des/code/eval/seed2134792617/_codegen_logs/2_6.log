+    if len(set(protected_steps)) != 1:
+        return False
+    tie_dist = protected_steps[0]
+    if tie_dist <= 0:
+        return False
+    all_steps = [int(root_dist[r, c]) for r, c in chosen_sources]
+    return min(all_steps) == tie_dist and sum(step == tie_dist for step in all_steps) >= 2
