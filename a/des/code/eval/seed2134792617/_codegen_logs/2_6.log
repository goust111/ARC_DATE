+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+WIRE = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+CORNERS = ("tl", "tr", "bl", "br")
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[counts.argmax()])
+
+
+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out = []
+    for dr, dc in DIRS4:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            out.append((nr, nc))
+    return out
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _parse_legend(
+    grid: np.ndarray,
+    bg: int,
+    wire_color: int,
+) -> tuple[list[int], np.ndarray]:
+    h, w = grid.shape
+    special_mask = (grid != bg) & (grid != wire_color)
+    candidates = []
+    for comp in _components(special_mask):
+        if len(comp) < 2:
+            continue
+        r0, c0, r1, c1 = _bbox(comp)
+        block = c1 - c0 + 1
+        height = r1 - r0 + 1
+        if c0 not in (0, w - block):
+            continue
+        if r0 != 0 and r1 != h - 1:
+            continue
+        if height % block != 0:
+            continue
+        if len(comp) != height * block:
+            continue
+
+        colors = []
+        ok = True
+        for i in range(height // block):
+            patch = grid[r0 + i * block : r0 + (i + 1) * block, c0 : c1 + 1]
+            vals = set(map(int, np.unique(patch)))
+            if len(vals) != 1:
+                ok = False
+                break
+            color = next(iter(vals))
+            if color in {bg, wire_color}:
+                ok = False
+                break
+            colors.append(color)
+
+        if not ok or len(colors) != len(set(colors)):
+            continue
+
+        if any(
+            grid[nr, nc] == wire_color
+            for r, c in comp
+            for nr, nc in _neighbors4(r, c, h, w)
+            if (nr, nc) not in comp
+        ):
+            continue
+        candidates.append((colors, comp))
+
+    assert len(candidates) == 1, "expected one corner legend"
+    colors, comp = candidates[0]
+    legend_mask = np.zeros_like(grid, dtype=bool)
+    for r, c in comp:
+        legend_mask[r, c] = True
+    return colors, legend_mask
+
+
+def _bfs_dist(network_mask: np.ndarray, start: tuple[int, int]) -> np.ndarray:
+    h, w = network_mask.shape
+    dist = np.full((h, w), -1, dtype=int)
+    sr, sc = start
+    dist[sr, sc] = 0
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c, h, w):
+            if network_mask[nr, nc] and dist[nr, nc] < 0:
+                dist[nr, nc] = dist[r, c] + 1
+                q.append((nr, nc))
+    return dist
