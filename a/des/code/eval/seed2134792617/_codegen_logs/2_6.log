+    best_rank = np.full((h, w), 10**9, dtype=int)
+    best_color = np.full((h, w), bg, dtype=int)
+    for r, c, color in source_cells:
+        dist = _bfs_dist(network_mask, (r, c))
+        reachable = dist >= 0
+        rank = priority_rank[color]
+        better = reachable & (
+            (dist < best_dist) | ((dist == best_dist) & (rank < best_rank))
