+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
