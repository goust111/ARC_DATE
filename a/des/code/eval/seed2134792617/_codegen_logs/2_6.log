+        for ar, ac in _neighbors4(nr, nc, h, w):
+            if mask[ar, ac] and (ar, ac) != prev:
+                bad = True
+                break
+        if bad:
+            break
+        length += 1
+        prev = (nr, nc)
+    return length
+
+
+def _grow_segment(
+    mask: np.ndarray,
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    length: int,
+) -> None:
+    dr, dc = direction
+    for step in range(1, length + 1):
+        mask[start[0] + dr * step, start[1] + dc * step] = True
+
+
+def _pick_root(
+    h: int,
+    w: int,
+    forbidden: np.ndarray,
+    lengths: dict[tuple[int, int], int],
+) -> tuple[int, int] | None:
+    candidates = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if forbidden[r, c]:
+                continue
+            cells = [(r, c)]
+            ok = True
+            for (dr, dc), length in lengths.items():
+                for step in range(1, length + 1):
+                    rr = r + dr * step
+                    cc = c + dc * step
+                    if not (0 < rr < h - 1 and 0 < cc < w - 1):
+                        ok = False
+                        break
+                    if forbidden[rr, cc]:
+                        ok = False
+                        break
+                    cells.append((rr, cc))
+                if not ok:
