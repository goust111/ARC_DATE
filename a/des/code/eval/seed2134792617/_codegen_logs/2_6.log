+
+def _max_extension_length(
+    mask: np.ndarray,
+    forbidden: np.ndarray,
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    max_degree: int,
+) -> int:
+    h, w = mask.shape
+    if _degree(mask, start) >= max_degree:
+        return 0
+
+    dr, dc = direction
+    prev = start
+    length = 0
+    while True:
+        nr = start[0] + dr * (length + 1)
+        nc = start[1] + dc * (length + 1)
+        if not (0 < nr < h - 1 and 0 < nc < w - 1):
