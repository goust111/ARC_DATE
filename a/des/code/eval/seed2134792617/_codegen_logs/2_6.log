+        return False
+    (r0, c0), (r1, c1) = neighbors
+    r, c = cell
+    dr0, dc0 = r0 - r, c0 - c
+    dr1, dc1 = r1 - r, c1 - c
+    return not (dr0 == -dr1 and dc0 == -dc1)
