+        _draw_frame(grid, top, left, GREY)
+        inner = grid[top + 1 : top + 1 + INNER, left + 1 : left + 1 + INNER]
+        inner[pattern] = ORANGE
+
+    if not _validate_instance(grid, positions, kinds):
+        return None
+    return grid
+
