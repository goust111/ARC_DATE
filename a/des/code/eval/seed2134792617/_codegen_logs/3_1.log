+def _extract_band(grid: np.ndarray, frame_bbox: tuple[int, int, int, int], bg: int) -> list[tuple[int, int]]:
+    _fr0, fc0, _fr1, _fc1 = frame_bbox
+    best_segments: list[tuple[int, int]] | None = None
+    best_key: tuple[int, int] | None = None
