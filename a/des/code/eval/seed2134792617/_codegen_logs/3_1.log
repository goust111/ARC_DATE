+    for c in range(fc0):
+        rows = np.flatnonzero(grid[:, c] != bg)
+        if rows.size == 0:
+            continue
+        if not np.array_equal(rows, np.arange(int(rows[0]), int(rows[-1]) + 1)):
+            continue
+
+        segments: list[tuple[int, int]] = []
+        used: set[int] = set()
+        cur_color = int(grid[int(rows[0]), c])
+        cur_len = 1
+        used.add(cur_color)
+        ok = True
+
+        for r in rows[1:]:
