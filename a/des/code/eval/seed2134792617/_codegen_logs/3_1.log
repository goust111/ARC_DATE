+        for dr in range(-padding, padding + 1):
+            for dc in range(-padding, padding + 1):
+                nr = ar + dr
+                nc = ac + dc
+                if 0 <= nr < h and 0 <= nc < w and int(grid[nr, nc]) != bg and not (dr == 0 and dc == 0):
