+            if np.array_equal(rows, np.arange(int(rows[0]), int(rows[-1]) + 1)):
+                colors = [int(g[int(r), c]) for r in rows]
+                if len(set(colors)) >= 2:
+                    band_col = int(c)
+                    work[rows, band_col] = bg
