+def _can_place_patch(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int, padding: int = 1) -> bool:
+    h, w = grid.shape
+    ph, pw = patch.shape
+    if r0 < 0 or c0 < 0 or r0 + ph > h or c0 + pw > w:
+        return False
+
+    coords = np.argwhere(patch)
+    for rr, cc in coords:
+        ar = int(r0 + rr)
+        ac = int(c0 + cc)
+        if int(grid[ar, ac]) != bg:
