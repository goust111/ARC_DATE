+    h, w = grid.shape
+    order = colors.copy()
+    random.shuffle(order)
+    for color in order:
+        patch = patterns[int(color)]
+        ph, pw = patch.shape
+        candidates = [
+            (r0, c0)
+            for r0 in range(1, h - ph)
+            for c0 in range(min_col, w - pw)
+        ]
+        random.shuffle(candidates)
