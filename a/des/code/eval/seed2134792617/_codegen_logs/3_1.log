+            used.add(color)
+            cur_color = color
+            cur_len = 1
+
+        if not ok:
+            continue
+        segments.append((cur_color, cur_len))
+        if len(segments) < 2:
+            continue
+
+        key = (int(rows.size), -int(c))
+        if best_key is None or key > best_key:
+            best_key = key
+            best_segments = segments
