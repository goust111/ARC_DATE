+    work = g.copy()
+    fr0, fc0, fr1, _fc1 = frame["bbox"]
+    frame_mask = np.zeros_like(work, dtype=bool)
+    frame_mask[fr0 : fr1 + 1, fc0 : fc0 + (fr1 - fr0 + 1)] = False
+    for rr, cc in frame["coords"]:
