+    grid[r0 + side - thickness : r0 + side, c0 : c0 + side] = color
+    grid[r0 : r0 + side, c0 : c0 + thickness] = color
+    grid[r0 : r0 + side, c0 + side - thickness : c0 + side] = color
+
+
