+from __future__ import annotations
+
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+@dataclass(frozen=True)
+class RectSpec:
+    top: int
+    left: int
+    bottom: int
+    right: int
+    gap_r: int
+    gap_c: int
+    dr: int
+    dc: int
+    seed_r: int
+    seed_c: int
+    seed_color: int
+
+    @property
+    def area(self) -> int:
+        return int((self.bottom - self.top - 1) * (self.right - self.left - 1))
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((int(cr), int(cc)))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _rectangle_boundary(top: int, left: int, bottom: int, right: int) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for c in range(left, right + 1):
+        cells.add((top, c))
+        cells.add((bottom, c))
+    for r in range(top, bottom + 1):
+        cells.add((r, left))
+        cells.add((r, right))
+    return cells
+
+
+def _extract_rectangles(grid: np.ndarray, bg: int) -> list[RectSpec]:
+    rectangles: list[RectSpec] = []
+    for color in np.unique(grid):
+        color = int(color)
+        if color == bg:
+            continue
+        for comp in _components(grid == color):
+            rows = [r for r, _ in comp]
+            cols = [c for _, c in comp]
+            top, bottom = min(rows), max(rows)
+            left, right = min(cols), max(cols)
+            if bottom - top < 2 or right - left < 2:
+                continue
+
+            comp_set = set(comp)
+            boundary = _rectangle_boundary(top, left, bottom, right)
+            if len(comp_set) != len(boundary) - 1:
+                continue
+            if not comp_set <= boundary:
+                continue
+
+            missing = list(boundary - comp_set)
+            if len(missing) != 1:
+                continue
+            gap_r, gap_c = missing[0]
+
+            on_horizontal = gap_r in (top, bottom)
+            on_vertical = gap_c in (left, right)
+            if on_horizontal == on_vertical:
+                continue
+
+            if gap_r == top:
+                dr, dc = -1, 0
+            elif gap_r == bottom:
+                dr, dc = 1, 0
+            elif gap_c == left:
+                dr, dc = 0, -1
+            else:
+                dr, dc = 0, 1
+
+            interior = grid[top + 1 : bottom, left + 1 : right]
+            if interior.size == 0:
+                continue
+            non_bg = np.argwhere(interior != bg)
+            if non_bg.shape[0] != 1:
