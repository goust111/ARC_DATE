+                    top=top,
+                    left=left,
+                    bottom=bottom,
+                    right=right,
+                    gap_r=gap_r,
+                    gap_c=gap_c,
+                    dr=dr,
+                    dc=dc,
+                    seed_r=seed_r,
+                    seed_c=seed_c,
+                    seed_color=seed_color,
+                )
+            )
