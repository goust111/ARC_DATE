+    sep_rows = np.where(np.all(g == GREY, axis=1))[0]
+    assert sep_rows.size == 1, "expected one full grey separator row"
+    sep = int(sep_rows[0])
+    assert 0 < sep < g.shape[0] - 1, "separator must split the grid into two non-empty regions"
