+
+BLACK = 0
+GREY = 5
+AZURE = 8
+
+FOUR_DIRS = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+# --------------- shared helpers ---------------
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
