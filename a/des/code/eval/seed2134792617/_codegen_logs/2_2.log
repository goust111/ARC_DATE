+    br1, bc1 = board_pixels.max(axis=0)
+    br0 = int(br0 + sep + 1)
+    br1 = int(br1 + sep + 1)
+    bc0 = int(bc0)
+    bc1 = int(bc1)
+
+    board = g[br0 : br1 + 1, bc0 : bc1 + 1]
+    assert np.all((board == AZURE) | (board == BLACK)), "board may only contain azure cells and black holes"
