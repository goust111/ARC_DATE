    def search(i):
        if i == len(scan_offsets):
            return 0 in values and span - 1 in values
        choices = list(range(span))
        random.shuffle(choices)
        for value in choices:
            if can_place(i, value):
                values.append(value)
                if search(i + 1):
                    return True
                values.pop()
        return False

    return values if search(0) else None


