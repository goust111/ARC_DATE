+PATH_MIN_RUNS = 4
+PATH_MAX_RUNS = 8
+PATH_MIN_LEN = 22
+PATH_MAX_LEN = 65
+RUN_LEN_RANGE = (3, 7)
+PATH_ATTEMPTS = 300
