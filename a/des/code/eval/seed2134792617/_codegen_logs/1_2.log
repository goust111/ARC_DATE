+def _valid_new_cell(cell: Coord, prev: Coord, occupied: set[Coord], h: int, w: int) -> bool:
+    r, c = map(int, cell)
+    if not (1 <= r < h - 1 and 1 <= c < w - 1):
+        return False
+    if cell in occupied:
+        return False
+    for nbr in _neighbors4(cell, h, w):
+        if nbr in occupied and nbr != prev:
+            return False
+    return True
+
