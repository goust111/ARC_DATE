+def _path_membership(length: int, intervals: list[tuple[int, int]]) -> list[int]:
+    membership = [-1] * length
+    for seg_id, (a, b) in enumerate(intervals):
+        for idx in range(a, b + 1):
+            membership[idx] = int(seg_id)
+    return membership
