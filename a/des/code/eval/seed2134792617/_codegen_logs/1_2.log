+    order: list[Coord] = []
+    prev: Coord | None = None
+    cur = endpoints[0]
+    while True:
+        order.append(cur)
+        nxts = [nxt for nxt in _neighbors4(cur, mask.shape[0], mask.shape[1]) if bool(mask[nxt]) and nxt != prev]
+        if not nxts:
