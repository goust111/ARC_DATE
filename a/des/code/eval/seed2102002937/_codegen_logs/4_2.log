+    assert rects
+    out_h = max(rect["shape"][0] for rect in rects)
+    out_w = sum(rect["shape"][1] for rect in rects) + len(rects) - 1
+    out = np.full((out_h, out_w), bg, dtype=int)
+
+    c = 0
+    for rect in rects:
+        h, w = rect["shape"]
+        out[:h, c : c + w] = int(rect["color"])
+        c += w + 1
+    return out
+
