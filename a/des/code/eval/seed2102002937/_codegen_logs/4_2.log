+def _joint_random_transforms(mask_a: np.ndarray, mask_b: np.ndarray, rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray]:
+    a = mask_a.copy()
+    b = mask_b.copy()
+    if int(rng.integers(0, 2)):
