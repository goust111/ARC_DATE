+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
