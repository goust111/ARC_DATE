+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+BG = 8
+GRID_MAX = 30
+GEN_RETRIES = 300
+_RNG = np.random.default_rng()
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _connected_components_for_color(grid: np.ndarray, color: int) -> list[dict]:
+    mask = grid == color
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            r0, c0 = arr.min(axis=0)
+            r1, c1 = arr.max(axis=0)
+            cropped = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            cropped[arr[:, 0] - r0, arr[:, 1] - c0] = True
+            comps.append(
+                {
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "mask": cropped,
+                }
+            )
+    return comps
+
+
+def _bbox_center(bbox: tuple[int, int, int, int]) -> tuple[float, float]:
+    r0, c0, r1, c1 = bbox
+    return ((r0 + r1) / 2.0, (c0 + c1) / 2.0)
+
+
+def _pair_center(comp_a: dict, comp_b: dict) -> tuple[float, float]:
+    ra, ca = _bbox_center(comp_a["bbox"])
+    rb, cb = _bbox_center(comp_b["bbox"])
+    return ((ra + rb) / 2.0, (ca + cb) / 2.0)
