+        accepted.sort(key=lambda item: item[0])
+        for ray_index, pos in accepted:
+            rays[ray_index]["path"].append(pos)
+            occupied.add(pos)
+            events.append((distance, ray_index, rays[ray_index]["color"], pos))
+            next_active.append(ray_index)
