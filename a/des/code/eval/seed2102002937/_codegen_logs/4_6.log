+    r0, c0, r1, c1 = rect["r0"], rect["c0"], rect["r1"], rect["c1"]
+    for c in range(c0 + 1, c1):
+        for pos, side in (((r0, c), "top"), ((r1, c), "bottom")):
+            path, stop = _trace_static(grid, pos, SIDE_TO_DIR[side])
+            candidates.append(
+                {
+                    "rect_index": rect_index,
+                    "pos": pos,
+                    "side": side,
+                    "dir": SIDE_TO_DIR[side],
+                    "path_len": len(path),
+                    "stop": stop,
+                }
+            )
