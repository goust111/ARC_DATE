+        nc = c0 + dc * distance
+        if not (0 <= nr < h and 0 <= nc < w):
+            return path, "boundary"
+        if int(grid[nr, nc]) != BG:
+            return path, "occupied"
+        path.append((nr, nc))
+        distance += 1
