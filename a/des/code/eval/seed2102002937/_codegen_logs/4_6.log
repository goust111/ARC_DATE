+        for pos, side in (((r, c0), "left"), ((r, c1), "right")):
+            path, stop = _trace_static(grid, pos, SIDE_TO_DIR[side])
+            candidates.append(
+                {
+                    "rect_index": rect_index,
+                    "pos": pos,
+                    "side": side,
+                    "dir": SIDE_TO_DIR[side],
+                    "path_len": len(path),
+                    "stop": stop,
