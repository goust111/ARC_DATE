+
+GRID_H_RANGE = (18, 26)
+GRID_W_RANGE = (18, 26)
+RECT_COUNT_CHOICES = (2, 3, 4)
+RECT_COUNT_WEIGHTS = (2, 3, 3)
+RECT_SIZE_RANGE = (3, 6)
