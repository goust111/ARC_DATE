+    seed_palette = color_order[4:]
+    legend_kind_order = random.sample(list(SYMMETRY_TYPES), len(SYMMETRY_TYPES))
+    legend_color_by_kind = {kind: color for kind, color in zip(legend_kind_order, legend_palette)}
