    yellow = _add(start, direction, -1)
    body = [_add(start, direction, -(step + 2)) for step in range(length)]
    return yellow, body


def _steps_until_exit(start: tuple[int, int], direction: tuple[int, int], height: int, width: int) -> int:
    steps = 0
    cell = start
