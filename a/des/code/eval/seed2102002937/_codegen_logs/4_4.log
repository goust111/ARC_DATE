def _fire_beam(out: np.ndarray, yellow: tuple[int, int], direction: tuple[int, int], length: int, color: int) -> None:
    height, width = out.shape
    r, c = yellow
    dr, dc = direction
    remaining = int(length)

    while remaining > 0:
        nr = int(r + dr)
        nc = int(c + dc)
        if not (0 <= nr < height and 0 <= nc < width):
            break

        cell = int(out[nr, nc])
        if cell == PRISM:
            out[nr, nc] = int(color)
            r, c = nr, nc
            dr, dc = _cw((dr, dc))
            continue

        if cell != BG:
            break

        out[nr, nc] = int(color)
        r, c = nr, nc
        remaining -= 1


