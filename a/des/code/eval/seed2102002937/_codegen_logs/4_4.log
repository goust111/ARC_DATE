+            placed = True
+            break
+        if not placed:
+            break
+    return extra
+
+
+def _gen_attempt() -> np.ndarray | None:
+    height = int(_RNG.integers(14, 23))
+    width = int(_RNG.integers(14, 23))
+    n_towers = 4 if float(_RNG.random()) < 0.55 else 3
+    categories = _choose_categories(n_towers)
