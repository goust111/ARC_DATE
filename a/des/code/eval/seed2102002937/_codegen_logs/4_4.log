+    for r, c in extra_prisms:
+        grid[r, c] = PRISM
+
+    try:
+        towers = _extract_towers(grid)
+        if len(towers) != n_towers:
+            return None
+        out = main(grid)
+    except AssertionError:
+        return None
+
+    if np.array_equal(out, grid):
+        return None
+    return grid
