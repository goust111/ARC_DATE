+                    rows2 = [p[0] for p in coords]
+                    cols2 = [p[1] for p in coords]
+                    rr0, rr1 = min(rows2), max(rows2)
+                    cc0, cc1 = min(cols2), max(cols2)
+
+                    if side == "top":
+                        if rr1 >= r0 or cc0 < gap0 or cc1 > gap1:
+                            continue
+                        distance = r0 - rr1
+                    elif side == "bottom":
