+        elif spec["side"] == "bottom":
+            grid[r1, gap0 : gap1 + 1] = BG
+        elif spec["side"] == "left":
+            grid[gap0 : gap1 + 1, c0] = BG
+        else:
+            grid[gap0 : gap1 + 1, c1] = BG
