+            "c0": c0,
+            "h": outer_h,
+            "w": outer_w,
+            "side": side,
+            "gap": (gap0, gap1),
+            "frame_color": frame_color,
+            "fill_color": fill_color,
+            "marker_coords": marker_coords,
+        }
