+        elif frame["side"] == "bottom":
+            out[r1, gap0 : gap1 + 1] = frame_color
+        elif frame["side"] == "left":
+            out[gap0 : gap1 + 1, c0] = frame_color
+        else:
+            out[gap0 : gap1 + 1, c1] = frame_color
