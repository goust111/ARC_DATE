+        occupied[pad_r0 : pad_r1 + 1, pad_c0 : pad_c1 + 1] = True
+        return {
+            "r0": r0,
+            "c0": c0,
+            "h": outer_h,
+            "w": outer_w,
+            "side": side,
+            "gap": (gap0, gap1),
+            "frame_color": frame_color,
+            "fill_color": fill_color,
+            "marker_coords": marker_coords,
