+
+        gap0, gap1 = spec["gap"]
+        if spec["side"] == "top":
+            grid[r0, gap0 : gap1 + 1] = BG
+        elif spec["side"] == "bottom":
+            grid[r1, gap0 : gap1 + 1] = BG
+        elif spec["side"] == "left":
+            grid[gap0 : gap1 + 1, c0] = BG
+        else:
+            grid[gap0 : gap1 + 1, c1] = BG
+
+        for r, c in spec["marker_coords"]:
