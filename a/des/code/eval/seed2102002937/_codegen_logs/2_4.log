+            return None
+        if missing.size > FRAME_GAP_RANGE[1]:
+            return None
+        gap0 = r0 + int(missing[0])
+        gap1 = r0 + int(missing[-1])
+
+    if side != "top" and not occ[0, :].all():
+        return None
+    if side != "bottom" and not occ[-1, :].all():
+        return None
