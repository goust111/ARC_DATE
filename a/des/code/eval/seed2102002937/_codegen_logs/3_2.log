def _touches_existing(coords: np.ndarray, occupied: np.ndarray) -> bool:
    n = occupied.shape[0]
    for r, c in coords:
        r = int(r)
        c = int(c)
        if occupied[r, c]:
            return True
        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
            rr = r + dr
            cc = c + dc
            if 0 <= rr < n and 0 <= cc < n and occupied[rr, cc]:
                return True
    return False


