        max_area = int(max_fg) - reserved_for_markers - used_area - MOVER_AREA_RANGE[0] * remaining
        mask = _sample_mover_mask(w, max_area)
        if mask is None:
            return None
        mover_masks.append(mask)
        used_area += int(mask.sum())
    return mover_masks


