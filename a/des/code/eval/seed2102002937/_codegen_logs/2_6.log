        if depth <= 0:
            continue
        mask[min(rows) - depth : min(rows), c] = True
        mask[max(rows) + 1 : max(rows) + 1 + depth, c] = True
    assert np.array_equal(mask, np.flipud(mask))
    assert not np.array_equal(mask, np.fliplr(mask))
    return mask


def _make_v_only(h: int, w: int) -> np.ndarray:
    cols = _center_cols(w)
