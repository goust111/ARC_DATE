+PATTERN_KINDS = ("h", "v", "hv", "none")
+LEGEND_ORDER = ("h", "v", "hv")
+
+GRID_HEIGHT_RANGE = (18, 26)
+GRID_WIDTH_RANGE = (23, 30)
