def _make_hv(h: int, w: int) -> np.ndarray:
    rows = _center_rows(h)
    cols = _center_cols(w)
    top_depth = min(rows)
    left_depth = min(cols)

    mask = np.zeros((h, w), dtype=bool)
    mask[rows, :] = True
    mask[:, cols] = True

    for c in range((w + 1) // 2):
        depth = random.randint(0, top_depth)
        if depth <= 0:
            continue
