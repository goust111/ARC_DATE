+
+
+BG = 0
+WALL = 5
+ARROW = 9
+RAY_COLORS = (1, 2, 3, 4, 6, 7, 8)
+
+DIR_VECS = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
+MISSING_BY_DIR = {
+    "up": (0, 0),
+    "right": (0, 1),
+    "down": (1, 1),
+    "left": (1, 0),
+}
+DIR_FROM_MISSING = {v: k for k, v in MISSING_BY_DIR.items()}
+SHAPE_BY_DIR = {
+    "up": frozenset({(0, 1), (1, 0), (1, 1)}),
+    "right": frozenset({(0, 0), (1, 0), (1, 1)}),
+    "down": frozenset({(0, 0), (0, 1), (1, 0)}),
+    "left": frozenset({(0, 0), (0, 1), (1, 1)}),
