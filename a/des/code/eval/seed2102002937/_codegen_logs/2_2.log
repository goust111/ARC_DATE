+            abs_arrows.append(
+                {
+                    "cells_abs": frozenset((r0 + 1 + rr, c0 + 1 + cc) for rr, cc in arrow["cells"]),
+                    "base_abs": (r0 + 1 + arrow["base"][0], c0 + 1 + arrow["base"][1]),
+                }
+            )
+
+        specs.append(
+            {
+                "box": box,
+                "side": side,
+                "color": color,
+                "direction": placed["direction"],
+                "branch": placed["branch"],
+                "arrows": abs_arrows,
+            }
