+def _free_to_wall(base: tuple[int, int], direction: str, h: int, w: int) -> int:
+    dr, dc = DIR_VECS[direction]
+    rr, cc = base
+    steps = 0
+    while True:
+        rr += dr
+        cc += dc
+        if not (0 <= rr < h and 0 <= cc < w):
+            return steps
+        steps += 1
