+def _arrow_candidates(h: int, w: int, direction: str) -> list[dict]:
+    shape = SHAPE_BY_DIR[direction]
+    miss_r, miss_c = MISSING_BY_DIR[direction]
+    out: list[dict] = []
+    next_id = 0
+    for r in range(h - 1):
+        for c in range(w - 1):
+            cells = frozenset((r + dr, c + dc) for dr, dc in shape)
+            base = (r + miss_r, c + miss_c)
