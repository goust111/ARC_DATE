+def _hit_step(shooter: dict, blocker: dict, direction: str, ray_len: int, h: int, w: int) -> int | None:
+    dr, dc = DIR_VECS[direction]
+    rr, cc = shooter["base"]
+    for step in range(1, ray_len + 1):
