+
+def _branch_targets(n_regions: int, rng: random.Random) -> list[str]:
+    targets: list[str] = []
+    base = ["full", "wall", "arrow"]
+    if n_regions >= 3:
+        rng.shuffle(base)
+        targets.extend(base)
+    else:
+        targets.extend(rng.sample(base, n_regions))
