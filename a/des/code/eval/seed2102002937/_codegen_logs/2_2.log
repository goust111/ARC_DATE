+def _build_canvas(rows: int, cols: int, row_heights: list[int], col_widths: list[int]) -> tuple[np.ndarray, list[int], list[int]]:
+    total_h = sum(row_heights) + rows + 1
+    total_w = sum(col_widths) + cols + 1
