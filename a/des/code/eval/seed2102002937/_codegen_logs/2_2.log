+    if len(initial) > target_n:
+        return None
+    initial_ids = {item["id"] for item in initial}
+    for _ in range(REGION_RETRIES):
+        chosen = list(initial)
+        rest = list(pool)
+        rng.shuffle(rest)
+        for cand in rest:
+            if cand["id"] in initial_ids:
+                continue
+            if all(not _arrow_conflict(cand, other) for other in chosen):
+                chosen.append(cand)
