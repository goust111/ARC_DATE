+    if len(pool) < ray_len:
+        return None
+    return _search_nonconflicting(
+        pool,
+        ray_len,
+        rng,
+        lambda chosen: all(item["reason"] == "full" for item in _ray_outcomes(chosen, direction, ray_len, h, w)),
