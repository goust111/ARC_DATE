+        assert len(directions) == 1, "all arrows in a region must point the same way"
+        direction = next(iter(directions))
+        ray_color = _region_emphasis_color(g, box, wall_color)
+        ray_len = len(arrows)
+        dr, dc = DIR_VECS[direction]
