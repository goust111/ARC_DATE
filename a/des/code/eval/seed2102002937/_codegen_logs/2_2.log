+
+
+def _arrow_conflict(a: dict, b: dict) -> bool:
+    if a["id"] == b["id"]:
+        return True
+    if a["base"] == b["base"]:
+        return True
+    if a["base"] in b["cells"] or b["base"] in a["cells"]:
+        return True
+    if a["cells"] & b["cells"]:
+        return True
+    for ra, ca in a["cells"]:
