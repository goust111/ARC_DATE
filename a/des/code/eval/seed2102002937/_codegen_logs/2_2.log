+                    "base_abs": (r0 + 1 + arrow["base"][0], c0 + 1 + arrow["base"][1]),
+                }
+            )
+
+        specs.append(
+            {
+                "box": box,
+                "side": side,
+                "color": color,
+                "direction": placed["direction"],
+                "branch": placed["branch"],
+                "arrows": abs_arrows,
