+            pool,
+            ray_len,
+            rng,
+            lambda trial: _branch_of(_ray_outcomes(trial, direction, ray_len, h, w), ray_len) == "wall"
+            and any(item["length"] > 0 for item in _ray_outcomes(trial, direction, ray_len, h, w)),
+            initial=[waller],
+        )
