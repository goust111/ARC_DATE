+
+    dr, dc = DIR_VECS[direction]
+    outcomes: list[dict] = []
+    for arrow in chosen:
+        rr, cc = arrow["base"]
+        painted = 0
+        reason = "full"
+        for step in range(1, ray_len + 1):
+            rr += dr
+            cc += dc
+            if not (0 <= rr < h and 0 <= cc < w):
