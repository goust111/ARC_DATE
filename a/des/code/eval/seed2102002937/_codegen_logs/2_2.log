+    if a["base"] == b["base"]:
+        return True
+    if a["base"] in b["cells"] or b["base"] in a["cells"]:
+        return True
+    if a["cells"] & b["cells"]:
+        return True
+    for ra, ca in a["cells"]:
+        for rb, cb in b["cells"]:
+            if abs(ra - rb) + abs(ca - cb) == 1:
+                return True
+    return False
