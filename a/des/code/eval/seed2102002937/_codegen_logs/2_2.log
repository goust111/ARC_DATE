+        for arrow in arrows:
+            br, bc = arrow["base"]
+            for step in range(1, ray_len + 1):
+                rr = br + dr * step
+                cc = bc + dc * step
+                if not (0 <= rr < h and 0 <= cc < w):
+                    break
+                if int(g[rr, cc]) != bg:
