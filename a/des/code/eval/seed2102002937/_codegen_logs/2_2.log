+def _branch_of(outcomes: list[dict], ray_len: int) -> str:
+    if any(item["reason"] == "arrow" for item in outcomes):
+        return "arrow"
+    if any(item["reason"] == "wall" and item["length"] < ray_len for item in outcomes):
+        return "wall"
+    return "full"
