+    used_keys = set()
+    matched_locks = set()
+    for marker in markers:
+        (mr, mc) = marker["coords"][0]
+        key_ids = set()
+        for nr, nc in _neighbors4(mr, mc):
+            idx = cell_to_part.get((nr, nc))
+            if idx is None:
+                continue
+            if parts[idx]["kind"] != "key":
