+            r0, c0, r1, c1 = _bbox(coords)
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": mask,
+                    "size": int(coords.shape[0]),
+                    "shape": (int(mask.shape[0]), int(mask.shape[1])),
+                }
