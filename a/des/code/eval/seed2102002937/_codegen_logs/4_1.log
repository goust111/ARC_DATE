+                    "color": color,
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": mask,
+                    "size": int(coords.shape[0]),
+                    "shape": (int(mask.shape[0]), int(mask.shape[1])),
+                }
