+
+RIGHT_OPEN = frozenset({(0, 0), (1, 0), (1, 1)})  # X. / XX
+LEFT_OPEN = frozenset({(0, 0), (0, 1), (1, 1)})   # XX / .X
+UP_OPEN = frozenset({(0, 1), (1, 0), (1, 1)})     # .X / XX
+DOWN_OPEN = frozenset({(0, 0), (0, 1), (1, 0)})   # XX / X.
