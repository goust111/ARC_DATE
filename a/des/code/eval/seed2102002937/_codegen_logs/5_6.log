+        placed = None
+        for _ in range(MAX_TOWER_TRIES):
+            lengths, colors = _sample_tower_spec(rng, desired)
+            min_r = 1 + lengths["up"]
+            max_r = h - 2 - lengths["down"]
+            min_c = 1 + lengths["left"]
