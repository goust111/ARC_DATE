+
+def _scan_arm(grid: np.ndarray, center: tuple[int, int], direction: str) -> tuple[int, list[tuple[int, int]]]:
+    h, w = grid.shape
+    sr, sc = ARM_START[direction]
+    dr, dc = ARM_STEP[direction]
