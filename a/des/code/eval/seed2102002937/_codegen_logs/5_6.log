+    if receiver_layout is None:
+        return None
+    receivers, _receiver_by_tower = receiver_layout
+
+    grid = _render_input(h, w, towers, receivers)
+    expected = _expected_output(grid, towers, receivers)
+    actual = main(grid)
+    if not np.array_equal(actual, expected):
