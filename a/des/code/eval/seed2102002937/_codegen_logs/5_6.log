+    if tower["desired"] == "none":
+        return []
+    if tower["desired"] == "single":
+        if not available:
+            return None
+        _dist2, r, c = rng.choice(available)
+        return [(r, c)]
+
+    assert tower["desired"] == "multi"
+    near_candidates = available[:]
+    rng.shuffle(near_candidates)
