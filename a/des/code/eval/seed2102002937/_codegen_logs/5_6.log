+
+def _rects_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    at, al, ab, ar = a
+    bt, bl, bb, br = b
+    return not (ab < bt or bb < at or ar < bl or br < al)
+
+
+def _neighbor_cells8(cell: tuple[int, int], h: int, w: int) -> set[tuple[int, int]]:
+    r, c = cell
