+def _expected_output(grid: np.ndarray, towers: list[dict], receivers: list[tuple[int, int, int]]) -> np.ndarray:
+    out = grid.copy()
+    for tower in towers:
+        for r, c in tower["arm_cells"]:
+            out[r, c] = BLACK
