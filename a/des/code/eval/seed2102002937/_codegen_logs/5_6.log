+# --------------- generator ---------------
+
+GRID_MIN = 22
+GRID_MAX = 30
+TOWER_COUNT_CHOICES = (2, 3)
+ARM_LENGTH_MIN = 1
+ARM_LENGTH_MAX = 5
+MAX_GENERATE_ATTEMPTS = 400
+MAX_TOWER_TRIES = 200
+EXTRA_RECEIVER_RANGE = (0, 2)
