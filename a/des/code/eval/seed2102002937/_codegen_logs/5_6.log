+        cr, cc = tower["center"]
+        top, left, bottom, right = tower["cover_bbox"]
+        r0, c0, r1, c1 = tower["body_bbox"]
+        candidates = []
+        for rr, cc2, color in receivers:
+            if top <= rr <= bottom and left <= cc2 <= right:
