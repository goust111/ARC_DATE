+    color = int(grid[r, c])
+    if color in (BLACK, GREY):
+        return 0, []
+
+    cells: list[tuple[int, int]] = []
+    while 0 <= r < h and 0 <= c < w and int(grid[r, c]) == color:
+        cells.append((r, c))
+        r += dr
+        c += dc
+    return len(cells), cells
