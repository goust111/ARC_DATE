+def _find_components(grid: np.ndarray, bg: int, blocked_rows: set[int] | None = None) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    blocked_rows = blocked_rows or set()
+    components: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if r in blocked_rows or seen[r, c]:
+                continue
+            color = int(g[r, c])
+            if color == bg:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if nr in blocked_rows or seen[nr, nc]:
+                        continue
+                    if int(g[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
