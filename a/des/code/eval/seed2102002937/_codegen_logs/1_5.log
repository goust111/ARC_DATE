+    length: int,
+    occupied: set[tuple[int, int]],
+    anchor: tuple[int, int] | None,
+) -> list[tuple[int, int]] | None:
+    cells: list[tuple[int, int]] = []
+    for step in range(length):
+        r = int(start[0] + direction[0] * step)
+        c = int(start[1] + direction[1] * step)
