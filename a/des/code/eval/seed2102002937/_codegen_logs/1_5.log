+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Reorder the path segments into one horizontal strip using the chain order
+    defined by endpoint adjacencies and the maroon start marker.
+    """
+    g = np.asarray(grid, dtype=int)
