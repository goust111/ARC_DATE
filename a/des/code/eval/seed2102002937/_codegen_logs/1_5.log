+    for i in range(len(segments)):
+        for j in range(i + 1, len(segments)):
+            if any(_manhattan(a, b) == 1 for a in endpoints[i] for b in endpoints[j]):
+                adjacency[i].add(j)
+                adjacency[j].add(i)
+    return adjacency
+
