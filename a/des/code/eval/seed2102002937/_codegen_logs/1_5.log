+
+BG = 0
+BASELINE_COLOR = 5
+MARKER_COLOR = 9
+PATH_COLOR_POOL = [1, 2, 3, 4, 6, 7, 8]
+
+DIRS = [(0, 1), (1, 0), (0, -1), (-1, 0)]
+MAX_GENERATION_ATTEMPTS = 400
