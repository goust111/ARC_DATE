+
+
+def _dir_index(direction: tuple[int, int]) -> int:
+    return DIRS.index(direction)
+
+
+def _candidate_next_dirs(direction: tuple[int, int]) -> list[tuple[int, int]]:
+    idx = _dir_index(direction)
