+def _positive_partition(rng: np.random.Generator, total: int, parts: int) -> list[int]:
+    if parts == 1:
+        return [int(total)]
+    cuts = sorted(int(x) for x in rng.choice(np.arange(1, total), size=parts - 1, replace=False))
