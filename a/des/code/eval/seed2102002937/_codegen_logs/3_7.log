 111:         lo = max(0, remaining - MAX_DOTS_PER_FRAME * frames_left)
 112:         hi = min(MAX_DOTS_PER_FRAME, remaining)
 113:         val = int(rng.integers(lo, hi + 1))
 114:         counts[int(idx)] = val
 115:         remaining -= val
