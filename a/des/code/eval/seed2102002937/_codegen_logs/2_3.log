+    if grid.shape[1] < 2:
+        return False
+    rows = [r for r in range(grid.shape[0]) if int(grid[r, 0]) != int(bg)]
+    if len(rows) < 2:
+        return False
+    for r in rows:
+        if int(grid[r, 1]) != int(bg):
+            return False
+        if r > 0 and int(grid[r - 1, 0]) != int(bg):
+            return False
+        if r + 1 < grid.shape[0] and int(grid[r + 1, 0]) != int(bg):
