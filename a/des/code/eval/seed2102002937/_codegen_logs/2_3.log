+def _partition_rectangle(h: int, w: int, n_parts: int) -> list[tuple[tuple[int, int], ...]] | None:
+    cells = [(r, c) for r in range(h) for c in range(w)]
+    sizes = _random_partition_sizes(h * w, n_parts)
+    seeds = random.sample(cells, n_parts)
