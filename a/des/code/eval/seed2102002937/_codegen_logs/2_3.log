+    r0 = 0
+    for item in groups:
+        h = int(item["h"])
+        w = int(item["w"])
+        c0 = (out_w - w) // 2
+        out[r0 : r0 + h, c0 : c0 + w] = int(item["color"])
+        r0 += h + 1
