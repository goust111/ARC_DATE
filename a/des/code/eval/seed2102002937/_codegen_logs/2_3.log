+    if max_parts < 2:
+        return None
+
+    for _ in range(200):
+        n_parts = random.randint(2, max_parts)
+        parts = _partition_rectangle(target_h, target_w, n_parts)
+        if parts is None:
+            continue
+
+        shapes = []
+        patches = []
+        non_rectangular = 0
