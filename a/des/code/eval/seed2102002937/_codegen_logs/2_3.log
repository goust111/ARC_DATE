+    if len(cols) < 2:
+        return False
+    for c in cols:
+        if int(grid[1, c]) != int(bg):
+            return False
+        if c > 0 and int(grid[0, c - 1]) != int(bg):
+            return False
+        if c + 1 < grid.shape[1] and int(grid[0, c + 1]) != int(bg):
