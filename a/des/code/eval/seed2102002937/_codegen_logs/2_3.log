+    expected = _build_expected(groups)
+    hint_axis = random.choice(["top", "left"])
+    grid = _scatter_fragments(groups, hint_axis, expected.shape)
+    if grid is None:
+        return None
+    if not _add_hint_strip(grid, groups, hint_axis):
+        return None
+
+    if int(_get_bg(grid)) != BG:
+        return None
+    try:
