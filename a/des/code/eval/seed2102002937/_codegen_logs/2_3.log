+    for h in range(1, int(total_area**0.5) + 1):
+        if total_area % h != 0:
+            continue
+        w = total_area // h
+        if h >= min_h and w >= min_w and _can_tile_rectangle(shapes, h, w):
+            candidates.add((int(h), int(w)))
