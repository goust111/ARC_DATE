+    try:
+        solved = main(grid)
+    except AssertionError:
+        return None
+    if not np.array_equal(solved, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    """
+    Generate a random valid input for the scattered-fragments rectangle puzzle.
+    """
