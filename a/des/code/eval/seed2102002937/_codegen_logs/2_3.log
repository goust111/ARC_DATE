+def _is_left_hint_col(grid: np.ndarray, bg: int) -> bool:
+    if grid.shape[1] < 2:
+        return False
+    rows = [r for r in range(grid.shape[0]) if int(grid[r, 0]) != int(bg)]
+    if len(rows) < 2:
+        return False
+    for r in rows:
