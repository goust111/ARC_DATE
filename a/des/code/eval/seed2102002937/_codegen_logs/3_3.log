+
+def _find_separator(grid: np.ndarray, bg: int) -> tuple[int, int]:
+    h, w = grid.shape
+    candidates: list[tuple[int, int]] = []
+    for c in range(1, w - 1):
+        value = int(grid[0, c])
+        if value == bg:
+            continue
+        if np.all(grid[:, c] == value) and np.any(grid[:, :c] == value):
+            candidates.append((c, value))
