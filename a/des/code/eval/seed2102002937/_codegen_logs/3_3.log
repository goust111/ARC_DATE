+LEFT_EXTRA_RANGE = (2, 5)
+FRAGMENT_COUNT_RANGE = (3, 5)
+SHADOW_BOX_H_RANGE = (5, 8)
+SHADOW_BOX_W_RANGE = (5, 8)
