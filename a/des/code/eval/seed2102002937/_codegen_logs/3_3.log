+    order = sorted(range(len(fragments)), key=lambda i: (fragments[i]["area"], i), reverse=True)
+    for idx in order:
+        mask = fragments[idx]["mask"]
+        r0, c0 = origins[idx]
+        for dr, dc in np.argwhere(mask):
+            out[r0 + int(dr), c0 + int(dc)] = int(fragments[idx]["color"])
+    return out
