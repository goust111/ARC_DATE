+def _partition_shadow(mask: np.ndarray, count: int, rng: random.Random) -> list[set[tuple[int, int]]] | None:
+    cells = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    if len(cells) < count * MIN_FRAGMENT_AREA:
+        return None
