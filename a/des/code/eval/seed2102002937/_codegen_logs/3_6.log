+
+
+def _random_seed_patch(h: int, w: int, bg: int, colors: list[int]) -> np.ndarray | None:
+    area = h * w
+    min_cells = max(2, (area + 3) // 4)
+    max_cells = area if area <= 2 else max(min_cells, area - 1)
+
+    for _ in range(80):
