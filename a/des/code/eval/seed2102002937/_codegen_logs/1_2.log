+def _normalize_coords(coords: list[tuple[int, int]] | set[tuple[int, int]]) -> tuple[frozenset[tuple[int, int]], int, int]:
+    r0, c0, r1, c1 = _bbox(coords)
+    normalized = frozenset((int(r - r0), int(c - c0)) for r, c in coords)
