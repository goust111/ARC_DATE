+    shape_a, ha, wa = _normalize_coords(fragment_a)
+    shape_b, hb, wb = _normalize_coords(fragment_b)
+    total_area = len(shape_a) + len(shape_b)
+    solutions: set[tuple[int, int]] = set()
+
+    for H, W in _candidate_dims(total_area):
