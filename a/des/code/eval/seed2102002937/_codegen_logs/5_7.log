+    for _ in range(50):
+        shape_h = rng.randint(min_dim, max_dim)
+        shape_w = rng.randint(min_dim, max_dim)
+        top = rng.randint(1, int(cell_size) - shape_h - 1)
+        left = rng.randint(1, int(cell_size) - shape_w - 1)
