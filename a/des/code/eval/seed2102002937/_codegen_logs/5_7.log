+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+MAROON = 9
+PALETTE = (1, 2, 3, 4, 5, 6, 7, 8)
+
+KEEP_TO_BAR = {
+    "left": "right",
+    "right": "left",
+    "top": "bottom",
+    "bottom": "top",
+}
+BAR_TO_KEEP = {bar: keep for keep, bar in KEEP_TO_BAR.items()}
+H_KEEP_SIDES = ("left", "right")
+V_KEEP_SIDES = ("top", "bottom")
+
+GRID_CHOICES = ((3, 3), (3, 4), (4, 3), (4, 4))
+CELL_SIZE_RANGE = (5, 8)
+GEN_RETRIES = 400
