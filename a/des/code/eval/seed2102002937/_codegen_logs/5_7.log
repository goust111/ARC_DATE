+            colors = [int(v) for v in np.unique(sub) if int(v) not in (BLACK, separator)]
+            assert len(colors) == 1, "each region must contain exactly one non-background color"
+            color = colors[0]
+            info = _control_info(sub, color)
+            if info is not None:
+                regions[(ri, ci)] = {
+                    "kind": "control",
+                    "color": color,
