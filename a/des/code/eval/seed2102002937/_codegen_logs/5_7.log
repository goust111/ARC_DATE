+    def feasible(start_idx: int) -> bool:
+        future = order[start_idx:]
+        for template_key, need in remaining.items():
+            if need < 0:
+                return False
+            available = sum(1 for control_key in future if template_key in neighbors[control_key])
+            if need > available:
