+
+def _edge_positions(size: int):
+    for c in range(size):
+        yield 0, c
+    for r in range(1, size - 1):
+        yield r, size - 1
+    for c in range(size - 1, -1, -1):
+        yield size - 1, c
+    for r in range(size - 2, 0, -1):
+        yield r, 0
+
+
+def _rotate_coord(coord: tuple[int, int], size: int, k: int) -> tuple[int, int]:
+    r, c = coord
+    for _ in range(k % 4):
