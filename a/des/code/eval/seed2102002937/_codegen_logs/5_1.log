+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _edge_positions(size: int):
+    for c in range(size):
+        yield 0, c
+    for r in range(1, size - 1):
+        yield r, size - 1
+    for c in range(size - 1, -1, -1):
+        yield size - 1, c
+    for r in range(size - 2, 0, -1):
+        yield r, 0
+
+
+def _rotate_coord(coord: tuple[int, int], size: int, k: int) -> tuple[int, int]:
+    r, c = coord
+    for _ in range(k % 4):
+        r, c = size - 1 - c, r
+    return r, c
+
+
+def _gap_side(coord: tuple[int, int], size: int) -> str:
+    r, c = coord
+    if r == 0:
+        return "U"
+    if c == size - 1:
+        return "R"
+    if r == size - 1:
+        return "D"
+    if c == 0:
+        return "L"
+    raise ValueError("gap must lie on the boundary")
+
+
+def _corner_distance(corner: str, coord: tuple[int, int], size: int) -> int:
+    r, c = coord
+    side = _gap_side(coord, size)
+    if corner == "TL":
+        return c if side == "U" else r
+    if corner == "TR":
+        return (size - 1 - c) if side == "U" else r
+    if corner == "BL":
+        return c if side == "D" else (size - 1 - r)
+    if corner == "BR":
