+    if row == rows - 1 and col == 0:
+        side = rng.choice(["D", "L"])
+        return ("D", rng.choice(small)) if side == "D" else ("L", rng.choice(large))
+    if row == rows - 1 and col == cols - 1:
+        side = rng.choice(["D", "R"])
+        return ("D", rng.choice(large)) if side == "D" else ("R", rng.choice(large))
