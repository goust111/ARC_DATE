  54:     def component_marker_color(coords: np.ndarray) -> int | None:
  55:         # For multi-color sprites, the marker color is the least frequent color inside the component.
  56:         vals = [int(g[int(r), int(c)]) for r, c in coords]
  57:         cnt = Counter(vals)
  58:         if len(cnt) <= 1:
