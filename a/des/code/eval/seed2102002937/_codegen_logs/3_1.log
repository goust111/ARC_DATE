+_SHAPE_LIBRARY = []
+for _base in _BASE_SHAPES:
+    for _variant in _transforms(_base):
+        sig = _shape_signature(_variant)
+        if sig not in { _shape_signature(x) for x in _SHAPE_LIBRARY }:
+            _SHAPE_LIBRARY.append(_variant)
+
