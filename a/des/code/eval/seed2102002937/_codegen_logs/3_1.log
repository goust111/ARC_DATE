+    out = g.copy()
+    for sig, bbox in frame_shapes.items():
+        fill_color = shape_to_fill[sig]
+        r0, c0, r1, c1 = bbox
+        out[r0, c0 : c1 + 1] = fill_color
+        out[r1, c0 : c1 + 1] = fill_color
+        out[r0 : r1 + 1, c0] = fill_color
+        out[r0 : r1 + 1, c1] = fill_color
+    return out
