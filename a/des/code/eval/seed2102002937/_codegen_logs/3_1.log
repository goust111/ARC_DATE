+_GRID_H_RANGE = (20, 29)
+_GRID_W_RANGE = (20, 29)
+_OBJECT_COUNT_CHOICES = (2, 3)
+_PALETTE = tuple(range(10))
+_GAP = 1
+_FRAME_MARGIN = 1
+_FRAME_OUTER_MIN = 5
+_FRAME_OUTER_MAX = 10
+_PLACEMENT_RETRIES = 150
+_GEN_RETRIES = 300
