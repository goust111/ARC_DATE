+    assert tgt_attach in parent, "channel path must connect the two frames"
+    path = []
+    cur = tgt_attach
+    while cur is not None:
+        path.append(cur)
+        cur = parent[cur]
+    path.reverse()
+    return path
+
+
+def _count_turns(path: list[tuple[int, int]]) -> int:
+    dirs = []
+    for i in range(len(path) - 1):
+        r0, c0 = path[i]
+        r1, c1 = path[i + 1]
+        dirs.append((r1 - r0, c1 - c0))
