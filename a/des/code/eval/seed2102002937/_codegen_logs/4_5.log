+def _rect_conflict(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int) -> bool:
+    ar, ac, ah, aw = a
+    br, bc, bh, bw = b
+    return not (
+        ar + ah + pad <= br
