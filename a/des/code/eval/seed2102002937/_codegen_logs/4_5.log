+    parent: dict[tuple[int, int], tuple[int, int] | None] = {src_attach: None}
+    q = deque([src_attach])
+    while q and tgt_attach not in parent:
+        cur = q.popleft()
+        for nxt in _neighbors4(*cur):
+            if nxt not in allowed or nxt in parent:
+                continue
+            parent[nxt] = cur
+            q.append(nxt)
