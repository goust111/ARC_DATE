+
+
+def _attachment_candidates(grid: np.ndarray, bbox: tuple[int, int, int, int], color: int) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    r0, c0, r1, c1 = bbox
+    out = []
+    for r, c in _ring_coords(bbox):
+        touched = False
+        for nr, nc in _neighbors4(r, c):
+            if not (0 <= nr < h and 0 <= nc < w):
