+
+        src_inner_h = sh - 2
+        src_inner_w = sw - 2
+        tgt_inner_h = th - 2
+        tgt_inner_w = tw - 2
+        if turns % 2 == 0:
+            max_ph = min(src_inner_h, tgt_inner_h, 4)
+            max_pw = min(src_inner_w, tgt_inner_w, 4)
+        else:
+            max_ph = min(src_inner_h, tgt_inner_w, 4)
+            max_pw = min(src_inner_w, tgt_inner_h, 4)
+        if max_ph < 2 or max_pw < 2:
