+def _ring_coords(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    coords = []
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            if r in (r0, r1) or c in (c0, c1):
+                coords.append((r, c))
+    return coords
