+    out = []
+    for r, c in _ring_coords(bbox):
+        touched = False
+        for nr, nc in _neighbors4(r, c):
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if r0 <= nr <= r1 and c0 <= nc <= c1:
+                continue
+            if int(grid[nr, nc]) == color:
+                touched = True
+                break
+        if touched:
+            out.append((r, c))
+    return out
