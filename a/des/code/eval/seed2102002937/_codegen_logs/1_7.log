+    bg: int = BG,
+) -> None:
+    top, left, height, width = rect
+    ph, pw = patch.shape
+    pr = top + (height - ph) // 2
+    pc = left + (width - pw) // 2
+    pts = np.argwhere(patch != bg)
+    for dr, dc in pts:
+        rr = pr + int(dr)
+        cc = pc + int(dc)
+        assert out[rr, cc] == bg
