+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+
+    local = np.zeros((h, w), dtype=bool)
+    local[rows - r0, cols - c0] = True
+
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+
+    if np.any(local & ~border):
+        return None
+
+    missing = np.argwhere(border & ~local)
+    if len(missing) != 1:
+        return None
