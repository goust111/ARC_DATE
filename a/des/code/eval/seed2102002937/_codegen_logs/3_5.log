+    blocked: set[tuple[int, int]],
+) -> list[dict]:
+    r0, c0, r1, c1 = bbox
+    rect_h = int(r1 - r0 + 1)
+    rect_w = int(c1 - c0 + 1)
+    candidates = []
+
+    for side in ("left", "right"):
+        max_depth = min(GEN_ARROW_DEPTH_MAX, rect_w)
+        for center in range(r0 + 1, r1):
