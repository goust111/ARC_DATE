    cells = [(r, c) for r in range(H) for c in range(W)]
    random.shuffle(cells)
    chosen: list[tuple[int, int]] = []
    sep = SCATTER_NEIGHBORHOOD
    for r, c in cells:
        if all(abs(r - rr) > sep or abs(c - cc) > sep for rr, cc in chosen):
