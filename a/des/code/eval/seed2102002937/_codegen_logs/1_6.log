+    counts = _coverage_counts(grid.shape, rectangles)
+    out = np.zeros_like(grid)
+    if legend_colors:
+        palette = np.array(legend_colors, dtype=int)
+        mask = counts > 0
+        out[mask] = palette[counts[mask] - 1]
+    out[:, legend_c] = grid[:, legend_c]
+    return out
