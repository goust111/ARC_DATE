+def _find_legend_column(grid: np.ndarray) -> int:
+    h, w = grid.shape
+    for c in range(w - 1, -1, -1):
+        rows = np.flatnonzero(grid[:, c] != BLACK)
+        if rows.size == 0:
+            continue
+        if np.all(np.diff(rows) > 1):
+            return int(c)
+    raise ValueError("legend column not found")
