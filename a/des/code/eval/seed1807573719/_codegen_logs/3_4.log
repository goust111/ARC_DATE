+    if ar0 == lr1 + 1 and max(lc0, ac0) <= min(lc1, ac1):
+        return "bottom"
+    if ac1 == lc0 - 1 and max(lr0, ar0) <= min(lr1, ar1):
+        return "left"
+    if ac0 == lc1 + 1 and max(lr0, ar0) <= min(lr1, ar1):
