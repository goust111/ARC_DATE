+
+def _arrow_side(lock_bbox: tuple[int, int, int, int], arrow_bbox: tuple[int, int, int, int]) -> str | None:
+    lr0, lc0, lr1, lc1 = lock_bbox
+    ar0, ac0, ar1, ac1 = arrow_bbox
