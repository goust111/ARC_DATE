+    pad_bottom = int(rng.integers(1, 4))
+    pad_left = int(rng.integers(1, 4))
+    pad_right = int(rng.integers(1, 4))
+    outer_h = int(hh + pad_top + pad_bottom)
+    outer_w = int(hw + pad_left + pad_right)
+    assert outer_h >= 4 and outer_w >= 4
