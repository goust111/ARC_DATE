+        for r, c in lock["arrow_coords"]:
+            out[int(r), int(c)] = bg
+        for r, c in lock["coords"]:
+            out[int(r), int(c)] = int(key["marker_color"])
+        for r, c in lock["hole_coords"]:
+            out[int(r), int(c)] = GREY
