+        target = int(rng.integers(4, 8))
+        cells = {(0, 0)}
+        while len(cells) < target:
+            frontier: list[tuple[int, int]] = []
+            for r, c in cells:
+                for dr, dc in DIR4:
+                    nr = int(r + dr)
+                    nc = int(c + dc)
+                    if abs(nr) > 3 or abs(nc) > 3 or (nr, nc) in cells:
