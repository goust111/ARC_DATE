+    if side == "top":
+        patch = np.full((outer_h + 2, outer_w), bg, dtype=int)
+        rect_r0, rect_c0 = 2, 0
+        arrow_r0 = 0
+        arrow_c0 = int(rng.integers(1, outer_w - 2))
+    elif side == "bottom":
+        patch = np.full((outer_h + 2, outer_w), bg, dtype=int)
+        rect_r0, rect_c0 = 0, 0
+        arrow_r0 = outer_h
+        arrow_c0 = int(rng.integers(1, outer_w - 2))
+    elif side == "left":
+        patch = np.full((outer_h, outer_w + 2), bg, dtype=int)
+        rect_r0, rect_c0 = 0, 2
+        arrow_r0 = int(rng.integers(1, outer_h - 2))
+        arrow_c0 = 0
+    else:
+        patch = np.full((outer_h, outer_w + 2), bg, dtype=int)
+        rect_r0, rect_c0 = 0, 0
+        arrow_r0 = int(rng.integers(1, outer_h - 2))
+        arrow_c0 = outer_w
