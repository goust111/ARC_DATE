+
+
+def _build_key_patch(shape: np.ndarray, marker_color: int, bg: int, rng: np.random.Generator) -> dict:
+    h, w = map(int, shape.shape)
+    canvas = np.full((h + 2, w + 2), bg, dtype=int)
+    canvas[1 : 1 + h, 1 : 1 + w][shape] = GREY
