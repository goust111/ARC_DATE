+    patch[arrow_r0 : arrow_r0 + 2, arrow_c0 : arrow_c0 + 2] = RED
+    miss_r, miss_c = _outward_missing_choices(side)[int(rng.integers(2))]
+    patch[int(arrow_r0 + miss_r), int(arrow_c0 + miss_c)] = bg
