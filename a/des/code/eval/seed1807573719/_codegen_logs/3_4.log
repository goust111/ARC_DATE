+        (hole_coords[:, 0] >= hole_r0)
+        & (hole_coords[:, 0] < hole_r0 + hh)
+        & (hole_coords[:, 1] >= hole_c0)
+        & (hole_coords[:, 1] < hole_c0 + hw)
