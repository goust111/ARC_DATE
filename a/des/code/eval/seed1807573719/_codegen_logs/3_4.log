+from __future__ import annotations
+
+import numpy as np
+
+
+GREY = 5
+RED = 2
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+OTHER_COLORS = [0, 1, 3, 4, 6, 7, 8, 9]
+MAX_GENERATION_ATTEMPTS = 400
