+def _find_locks(grid: np.ndarray, bg: int) -> list[dict]:
+    arrow_components = []
+    for coords in _components(grid == RED):
+        r0, c0, r1, c1 = _bbox(coords)
+        if int(coords.shape[0]) == 3 and (r1 - r0 + 1, c1 - c0 + 1) == (2, 2):
