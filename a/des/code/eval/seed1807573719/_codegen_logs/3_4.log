+
+def _find_keys(grid: np.ndarray, bg: int) -> list[dict]:
+    key_components = _components(grid == GREY)
+    keys: list[dict] = []
+    used_markers: set[tuple[int, int]] = set()
+    for coords in key_components:
+        marker_cells: dict[tuple[int, int], int] = {}
+        for r, c in coords:
+            for dr, dc in DIR4:
+                nr = int(r + dr)
+                nc = int(c + dc)
