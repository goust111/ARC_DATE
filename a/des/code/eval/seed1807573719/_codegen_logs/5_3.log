+def _length_pattern(count: int, allow_ties: bool) -> list[int]:
+    unique_patterns = {
+        3: [[1, 2, 3], [1, 2, 4]],
+        4: [[1, 2, 3, 4]],
+        5: [[1, 1, 2, 3, 4]],
