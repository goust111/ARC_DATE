+    if direction == "L":
+        return [(int(r0 + 1), int(c0 - 1 - k)) for k in range(length)]
+    if direction == "R":
+        return [(int(r0 + 1), int(c0 + 3 + k)) for k in range(length)]
+    raise AssertionError(f"bad direction {direction}")
