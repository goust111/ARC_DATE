                }
            )
    if h == 3 and 4 <= w <= 7 and area == 9 + (w - 3):
        length = w - 3
        sq_c = c1 - 2
        expected = _square_cells(r0, sq_c) | set(_antenna_cells(r0, sq_c, "L", length))
        if expected == cell_set:
