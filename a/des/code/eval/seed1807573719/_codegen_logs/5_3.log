+        5: [[1, 1, 2, 3, 4], [1, 2, 2, 3, 4], [1, 2, 3, 3, 4], [1, 1, 2, 2, 4]],
+    }
+    pool = tie_patterns[count] if allow_ties else unique_patterns[count]
