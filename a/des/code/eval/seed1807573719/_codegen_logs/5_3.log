+def _component_cells(grid: np.ndarray) -> list[tuple[int, list[tuple[int, int]]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[tuple[int, list[tuple[int, int]]]] = []
+    for r in range(h):
