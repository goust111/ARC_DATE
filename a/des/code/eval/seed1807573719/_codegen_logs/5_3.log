from __future__ import annotations

from collections import defaultdict, deque
import random

import numpy as np


BG = 0
YELLOW = 4
DIRS = {
    "U": (-1, 0),
    "D": (1, 0),
    "L": (0, -1),
    "R": (0, 1),
}
INPUT_COLORS = [1, 2, 3, 5, 6, 7, 8, 9]
