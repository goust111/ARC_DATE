+        for cell in _antenna_cells(r, c, direction, length):
+            grid[cell] = color
+    return grid
+
+
+def _gen_attempt() -> np.ndarray | None:
+    want_cross = bool(random.getrandbits(1))
+    allow_ties = bool(random.getrandbits(1))
