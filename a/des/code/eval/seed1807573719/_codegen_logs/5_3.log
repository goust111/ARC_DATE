+    if direction == "D":
+        return [(int(r0 + 3 + k), int(c0 + 1)) for k in range(length)]
+    if direction == "L":
+        return [(int(r0 + 1), int(c0 - 1 - k)) for k in range(length)]
+    if direction == "R":
