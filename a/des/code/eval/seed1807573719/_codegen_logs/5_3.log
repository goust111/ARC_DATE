+        if expected == cell_set:
+            candidates.append(
+                {
+                    "color": int(color),
+                    "square_r": int(sq_r),
+                    "square_c": int(c0),
+                    "dir": "U",
+                    "length": int(length),
+                    "tip": _antenna_cells(sq_r, c0, "U", length)[-1],
+                }
+            )
+        sq_r = r0
+        expected = _square_cells(sq_r, c0) | set(_antenna_cells(sq_r, c0, "D", length))
+        if expected == cell_set:
+            candidates.append(
+                {
+                    "color": int(color),
+                    "square_r": int(sq_r),
+                    "square_c": int(c0),
+                    "dir": "D",
+                    "length": int(length),
+                    "tip": _antenna_cells(sq_r, c0, "D", length)[-1],
