+def _count_interior_crossings(scene: dict) -> int:
+    bbox = scene["bbox"]
+    frame_color = scene["frame_color"]
+    grid = scene["grid"]
+    paths = [
+        _interior_pipe_cells(pipe, bbox, frame_color, grid)
+        for pipe in scene["pipes"]
+    ]
+    crossings = 0
+    for i in range(len(paths)):
+        for j in range(i + 1, len(paths)):
+            if paths[i] & paths[j]:
