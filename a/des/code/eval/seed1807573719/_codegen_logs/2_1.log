+            )
+        if int(g[r1, col]) == bg:
+            gaps.append(
+                {
+                    "side": "bottom",
+                    "pos": (r1, col),
+                    "corner_distance": _gap_distance("bottom", r1, col, bbox),
+                }
+            )
+    for row in range(r0 + 1, r1):
+        if int(g[row, c0]) == bg:
+            gaps.append(
+                {
+                    "side": "left",
+                    "pos": (row, c0),
+                    "corner_distance": _gap_distance("left", row, c0, bbox),
+                }
+            )
+        if int(g[row, c1]) == bg:
+            gaps.append(
+                {
+                    "side": "right",
+                    "pos": (row, c1),
+                    "corner_distance": _gap_distance("right", row, c1, bbox),
+                }
+            )
+
+    seed_mask = (g != bg) & (g != frame_color)
