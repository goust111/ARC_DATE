+    middle_cols = list(range(c0 + 3, c1 - 2))
+    low_rows = [r0 + 1, r0 + 2]
+    high_rows = [r1 - 2, r1 - 1]
+    low_cols = [c0 + 1, c0 + 2]
+    high_cols = [c1 - 2, c1 - 1]
