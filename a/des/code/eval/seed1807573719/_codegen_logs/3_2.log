+def _find_components(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    h, w = grid.shape
+    mask = grid == int(color)
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
