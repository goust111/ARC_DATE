+    if high > low and length >= 2 and len(set(seq)) == 1 and random.random() < 0.85:
+        idx = random.randrange(length)
+        alternatives = [v for v in range(low, high + 1) if v != seq[idx]]
+        seq[idx] = random.choice(alternatives)
+    return seq
