+
+
+RECT_H_RANGE = (2, 6)
+RECT_W_RANGE = (2, 6)
+PAIR_COUNT_CHOICES = (1, 2)
+MAX_OUTPUT_WIDTH = 26
+INPUT_H_RANGE = (16, 28)
+INPUT_W_MAX = 30
+INPUT_EXTRA_W_RANGE = (4, 10)
+PLACEMENT_PADDING = 1
+MAX_PAIR_ATTEMPTS = 120
+MAX_LAYOUT_ATTEMPTS = 120
