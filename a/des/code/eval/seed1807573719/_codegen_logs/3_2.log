def _gen_transform_coords(coords):
    arr = np.asarray(list(coords), dtype=int).copy()
    for _ in range(random.randrange(ROTATION_COUNT)):
        arr = np.column_stack((arr[:, 1], -arr[:, 0]))
    if random.random() < MIRROR_PROB:
