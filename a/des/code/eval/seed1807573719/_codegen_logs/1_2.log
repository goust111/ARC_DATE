    for i in range(n_segments):
        slots = n_segments - i - 1
        lo = max(SEGMENT_STEPS_MIN, remaining - SEGMENT_STEPS_MAX * slots)
        hi = min(SEGMENT_STEPS_MAX, remaining - SEGMENT_STEPS_MIN * slots)
