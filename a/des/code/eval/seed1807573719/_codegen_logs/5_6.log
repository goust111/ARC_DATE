+    while True:
+        assert cur in edges, "wall contour must be closed"
+        assert cur not in visited, "wall contour must be a single simple loop"
+        visited.add(cur)
+        nxt, cell = edges[cur]
+        walk.append(cell)
+        cur = nxt
+        if cur == start:
