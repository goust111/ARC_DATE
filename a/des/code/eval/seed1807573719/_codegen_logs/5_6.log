0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """
0009:     Use the left-edge color legend to draw a padded rectangular halo around each matching object while preserving enclosed holes.
0010: 
0011:     Input structure:
0012:     - The grid has a dominant background color.
0013:     - One or more two-row markers sit on the left edge; each marker is a 2x2 block whose left column is an object color and right column is its halo color.
0014:     - Away from the markers, every source color from the legend appears as one or more 4-connected monochrome objects.
0015: 
0016:     Rule:
0017:     - Keep the input pixels unchanged.
0018:     - For each source-color object, take its tight bbox expanded by one cell and clipped to the grid.
0019:     - Recolor background pixels in that expanded region to the marker's halo color, except for background holes enclosed by the object.
0020: 
0021:     Key insight:
0022:     - The small left-edge bars are a legend: they map object colors to the colors used for the surrounding padded bbox.
0023:     """
0024:     g = np.asarray(grid, dtype=int)
0025:     bg = int(get_bg(g))
0026:     out = g.copy()
0027:     h, w = g.shape
0028: 
0029:     markers: dict[int, int] = {}
0030:     marker_source_cells: dict[int, set[tuple[int, int]]] = {}
0031:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format="dict"):
0032:         r0, c0, r1, c1 = comp["bbox"]
0033:         height = int(r1 - r0 + 1)
0034:         if c0 != 0 or c1 != 1 or height != 2 or int(comp["area"]) != 4:
0035:             continue
0036: 
0037:         sub = g[r0 : r1 + 1, c0 : c1 + 1]
0038:         assert np.all(sub != bg), "legend marker must be a full 2x2 foreground block"
0039:         assert np.all(sub[:, 0] == sub[0, 0]), "legend source column must be monochrome"
0040:         assert np.all(sub[:, 1] == sub[0, 1]), "legend halo column must be monochrome"
0041:         source = int(sub[0, 0])
0042:         halo = int(sub[0, 1])
0043:         assert source != halo, "legend source and halo colors must differ"
0044:         assert source not in markers, "each source color must have exactly one legend marker"
0045: 
0046:         markers[source] = halo
0047:         marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp["coords"] if int(g[tuple(coord)]) == source}
0048: 
0049:     assert markers, "expected at least one left-edge legend marker"
0050: 
0051:     for source, halo in markers.items():
0052:         objects = []
0053:         for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format="dict"):
0054:             cells = {tuple(map(int, coord)) for coord in comp["coords"]}
0055:             if cells <= marker_source_cells[source]:
0056:                 continue
0057:             objects.append(comp)
0058:         assert objects, "each legend source color must label at least one non-marker object"
0059: 
0060:         for obj in objects:
0061:             r0, c0, r1, c1 = obj["bbox"]
0062:             pr0 = max(0, int(r0) - 1)
0063:             pc0 = max(0, int(c0) - 1)
0064:             pr1 = min(h - 1, int(r1) + 1)
0065:             pc1 = min(w - 1, int(c1) + 1)
0066: 
0067:             patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)
0068:             coords = obj["coords"]
0069:             patch[coords[:, 0] - pr0, coords[:, 1] - pc0] = source
0070:             enclosed = object_interior(patch, background=bg)
0071:             fill_mask = (patch == bg) & ~enclosed
0072: 
0073:             input_region = g[pr0 : pr1 + 1, pc0 : pc1 + 1]
0074:             target = out[pr0 : pr1 + 1, pc0 : pc1 + 1]
0075:             assert np.all(input_region[fill_mask] == bg), "halo cells must be background in the input"
0076:             assert np.all((target[fill_mask] == bg) | (target[fill_mask] == halo)), "halo regions must not conflict"
0077:             target[fill_mask] = halo
0078: 
0079:     return out
