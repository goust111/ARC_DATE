0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """
0009:     Complete the scene by adding the point-reflected copy of the colored object across the central marker.
0010: 
0011:     Input structure
0012:     - The grid has odd dimensions, a dominant background, and a center-row marker color appearing only at the left edge, center, and right edge.
0013:     - A single divider color fills the center column except for the center marker.
0014:     - All remaining foreground pixels form the object to copy, entirely on the left side of the divider.
0015:     Rule
0016:     - Keep the input unchanged.
0017:     - For every object pixel, paint the pixel rotated 180 degrees around the center marker with the same color.
0018:     Key insight
0019:     - The center marker is the rotation center; the yellow-looking divider is not mirrored, it only separates the source from the empty target side.
0020:     """
0021:     g = np.asarray(grid, dtype=int)
0022:     assert g.ndim == 2
0023:     h, w = g.shape
0024:     assert h % 2 == 1 and w % 2 == 1
0025: 
0026:     cr, cc = h // 2, w // 2
0027:     bg = int(get_bg(g))
0028: 
0029:     marker_color = int(g[cr, cc])
0030:     assert marker_color != bg
0031:     marker_mask = g == marker_color
0032:     expected_markers = np.zeros(g.shape, dtype=bool)
0033:     expected_markers[cr, 0] = True
0034:     expected_markers[cr, cc] = True
0035:     expected_markers[cr, w - 1] = True
0036:     assert np.array_equal(marker_mask, expected_markers)
0037: 
0038:     center_col = g[:, cc]
0039:     divider_colors = {int(color) for color in np.unique(center_col) if int(color) != marker_color}
0040:     assert len(divider_colors) == 1
0041:     divider_color = next(iter(divider_colors))
0042:     assert divider_color != bg
0043:     expected_divider = np.zeros(g.shape, dtype=bool)
0044:     expected_divider[:, cc] = True
0045:     expected_divider[cr, cc] = False
0046:     assert np.array_equal(g == divider_color, expected_divider)
0047: 
0048:     source_mask = (g != bg) & (g != marker_color) & (g != divider_color)
0049:     source_coords = np.argwhere(source_mask)
0050:     assert source_coords.size > 0
0051:     assert np.all(source_coords[:, 1] < cc)
0052: 
0053:     out = g.copy()
0054:     for r, c in source_coords:
0055:         rr = 2 * cr - int(r)
0056:         rc = 2 * cc - int(c)
0057:         assert 0 <= rr < h and 0 <= rc < w
0058:         assert out[rr, rc] == bg
0059:         out[rr, rc] = g[r, c]
0060: 
0061:     return out
