0055:     fr0, fc0, fr1, fc1 = int(ir0 - 1), int(ic0 - 1), int(ir1 + 1), int(ic1 + 1)
0056: 
0057:     # --- divider columns (fixed) on the left side ---
0058:     divider_mask = np.zeros((H, W), dtype=bool)
0059:     for c in range(0, max(0, int(fc0))):
0060:         colv = g[:, int(c)]
