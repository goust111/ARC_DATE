0099: def _gen_width_profile(span, max_width):
0100:     edge_width_hi = min(SOURCE_EDGE_WIDTH_RANGE[1], max_width)
0101:     start_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)
0102:     end_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)
0103:     min_up = (max_width - start_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP
0104:     min_down = (max_width - end_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP
0105:     if min_up + min_down + 1 > span:
0106:         return None
0107: 
0108:     peak_start = random.randint(min_up, span - 1 - min_down)
0109:     peak_end = random.randint(peak_start, span - 1 - min_down)
0110: 
0111:     widths = [start_width]
0112:     for step in _gen_bounded_steps(max_width - start_width, peak_start, WIDTH_STEP_CAP):
0113:         widths.append(widths[-1] + step)
0114: 
0115:     widths.extend([max_width] * (peak_end - peak_start))
0116: 
0117:     current = max_width
0118:     for step in _gen_bounded_steps(max_width - end_width, span - 1 - peak_end, WIDTH_STEP_CAP):
0119:         current -= step
0120:         widths.append(current)
0121: 
0122:     area = sum(widths)
0123:     if not SOURCE_PIXEL_RANGE[0] <= area <= SOURCE_PIXEL_RANGE[1]:
0124:         return None
0125:     return widths
