+    left: int,
+    inner_h: int,
+    inner_w: int,
+    source: tuple[int, int],
+    dye: tuple[int, int],
+) -> list[tuple[int, int]]:
+    bottom = top + inner_h + 1
+    right = left + inner_w + 1
+    grid[top:bottom + 1, left:right + 1] = GRAY
+    grid[top + 1:bottom, left + 1:right] = BG
