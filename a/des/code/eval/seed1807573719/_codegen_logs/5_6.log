0086: def _gen_bounded_steps(total, slots, cap):
0087:     steps = []
0088:     remaining = total
0089:     for i in range(slots):
0090:         left = slots - i - 1
0091:         lo = max(0, remaining - cap * left)
0092:         hi = min(cap, remaining)
0093:         step = random.randint(lo, hi)
0094:         steps.append(step)
0095:         remaining -= step
0096:     return steps
