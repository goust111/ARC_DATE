+                r0 = rng.randint(1, h - MIN_RAY_LEN - 4)
+                c0 = rng.randint(1, w - 5)
+            elif direction == "left":
+                if w < 8:
+                    return None
+                r0 = rng.randint(1, h - 5)
+                c0 = rng.randint(MIN_RAY_LEN, w - 4)
+            else:
+                if w < 8:
