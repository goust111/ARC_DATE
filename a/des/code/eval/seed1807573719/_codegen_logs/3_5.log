+            if int(band["color"]) == int(receiver["center_color"]):
+                continue
+            dr, dc = DIRS[str(band["direction"])]
+            pr, pc = dc, dr
+            for step in range(-2, 3):
+                ar = center[0] + dr * step
+                ac = center[1] + dc * step
+                for offset in (-1, 0, 1):
