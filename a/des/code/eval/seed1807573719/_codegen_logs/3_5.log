+                    "center": center,
+                    "mode": mode,
+                    "tower_color": int(tower["color"]),
+                    "center_color": int(center_color),
+                }
+            )
+            placed = True
+            break
+        if not placed:
+            return None
+
+    return receivers
+
+
+def _place_extra_receivers(
+    rng: random.Random,
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    guard: np.ndarray,
+    footprints: np.ndarray,
