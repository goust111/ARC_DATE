+        h = int(_RNG.integers(GRID_H_RANGE[0], GRID_H_RANGE[1]))
+        w = int(_RNG.integers(GRID_W_RANGE[0], GRID_W_RANGE[1]))
+        force_overlap = bool(int(_RNG.integers(0, 2)))
