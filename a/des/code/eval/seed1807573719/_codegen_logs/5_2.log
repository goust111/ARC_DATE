+def _cross_targets(
+    cells: set[tuple[int, int]],
+    direction: tuple[int, int],
+    step: int,
+    gap_start: int,
+    gap_end: int,
+    neighbor: dict,
+) -> set[tuple[int, int]]:
+    targets: set[tuple[int, int]] = set()
+    dr, dc = direction
+    for r, c in cells:
+        rr = r + dr * step
+        cc = c + dc * step
+        if dr != 0 and not (gap_start <= c <= gap_end):
+            continue
+        if dc != 0 and not (gap_start <= r <= gap_end):
+            continue
