+def _place_free_shape(
+    rng: random.Random,
+    region: dict,
+    forbidden: set[tuple[int, int]] | None = None,
+) -> set[tuple[int, int]] | None:
+    forbidden = forbidden or set()
+    height = region["r1"] - region["r0"] + 1
+    width = region["c1"] - region["c0"] + 1
