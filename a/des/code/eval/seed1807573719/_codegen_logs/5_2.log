+import random
+
+import numpy as np
+
+
+GRAY = 5
+BLACK = 0
+RED = 2
+MAROON = 9
+BASE_COLORS = (1, 3, 4, 6, 7, 8)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GENERATE_RETRIES = 400
