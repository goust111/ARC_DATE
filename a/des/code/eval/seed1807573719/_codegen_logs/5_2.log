+            top_lo = region["r0"]
+            top_hi = region["r1"] - shape_h + 1
+            left_lo = region["c0"]
+            left_hi = region["c1"] - shape_w + 1 - step
+        if top_lo > top_hi or left_lo > left_hi:
+            continue
+        top = rng.randint(top_lo, top_hi)
+        left = rng.randint(left_lo, left_hi)
