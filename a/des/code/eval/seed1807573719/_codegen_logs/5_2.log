+        shape_h, shape_w = _shape_size(shape)
+        top = rng.randint(region["r0"], region["r1"] - shape_h + 1)
+        left = rng.randint(region["c0"], region["c1"] - shape_w + 1)
+        cells = _shift_shape(shape, top, left)
+        if cells.isdisjoint(forbidden):
+            return cells
+    return None
