+
+def _ray_cells(shape: tuple[int, int], start: tuple[int, int], step: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    r, c = start
+    dr, dc = step
+    cells: list[tuple[int, int]] = []
