+def _between_cells(start: tuple[int, int], end: tuple[int, int], step: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = start
+    dr, dc = step
+    cells: list[tuple[int, int]] = []
+    r += dr
+    c += dc
