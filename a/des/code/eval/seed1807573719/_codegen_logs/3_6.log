BAR_COUNT_RANGE, FIRST_ROWS_SINGLE, FIRST_ROWS_MULTI = (1, 4), (2,), (1, 2)
ROW_STRIDE, BAR_LENGTHS, START_COL_RANGE = 2, (2, 3, 4, 5), (0, 2)
# Marker/canvas placement.
