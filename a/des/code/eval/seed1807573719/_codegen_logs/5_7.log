+BG = 0
+MAX_FRAGMENT_CELLS = 4
+
+LEGEND_RING_SIZE = 4
+LEGEND_ROW_H = 4
+LEGEND_ROW_GAP = 1
+LEGEND_ROWS = 3
+LEGEND_SAMPLE_TOP = 1
+LEGEND_SAMPLE_LEFT = 8
+LEGEND_W = 10
+LEGEND_H = LEGEND_ROWS * LEGEND_ROW_H + (LEGEND_ROWS - 1) * LEGEND_ROW_GAP
