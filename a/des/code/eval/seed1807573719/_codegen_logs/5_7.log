+def _draw_border(grid: np.ndarray, bbox: tuple[int, int, int, int], color: int, gaps: list[np.ndarray]) -> None:
+    r0, c0, r1, c1 = bbox
+    mask = _rect_border_mask(r1 - r0 + 1, c1 - c0 + 1)
+    for gap in gaps:
+        mask[gap[:, 0], gap[:, 1]] = False
