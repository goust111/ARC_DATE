+    corner, vrun, hrun = options[int(RNG.integers(len(options)))]
+    cells = set()
+    if corner == "tl":
+        for rr in range(vrun):
+            cells.add((rr, 0))
+        for cc in range(hrun):
+            cells.add((0, cc))
+    elif corner == "tr":
+        for rr in range(vrun):
+            cells.add((rr, w - 1))
+        for cc in range(hrun):
+            cells.add((0, w - 1 - cc))
+    elif corner == "bl":
+        for rr in range(vrun):
+            cells.add((h - 1 - rr, 0))
+        for cc in range(hrun):
+            cells.add((h - 1, cc))
+    else:
+        for rr in range(vrun):
+            cells.add((h - 1 - rr, w - 1))
