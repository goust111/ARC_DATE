+def _apply_pattern(
+    out: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    ring_color: int,
+    pattern: tuple[str, int | bool],
+    bg: int,
+) -> None:
+    r0, c0, r1, c1 = bbox
+    kind, param = pattern
+    for r in range(r0 + 1, r1):
+        for c in range(c0 + 1, c1):
+            if out[r, c] != bg:
+                continue
+            rr = r - (r0 + 1)
+            cc = c - (c0 + 1)
+            if kind == "solid_const":
+                out[r, c] = int(param)
+            elif kind == "solid_ring":
+                out[r, c] = int(ring_color)
+            elif kind == "hstripe":
+                use_ring = (rr % 2 == 0) if bool(param) else (rr % 2 == 1)
+                out[r, c] = int(ring_color) if use_ring else int(bg)
+            elif kind == "checker":
+                use_ring = ((rr + cc) % 2 == 0) if bool(param) else ((rr + cc) % 2 == 1)
+                out[r, c] = int(ring_color) if use_ring else int(bg)
+            else:
