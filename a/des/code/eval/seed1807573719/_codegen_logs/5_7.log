+def _touches(a: np.ndarray, b: np.ndarray) -> bool:
+    aset = {tuple(x) for x in a.tolist()}
+    for rr, cc in b.tolist():
+        for dr, dc in ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1)):
+            if (rr + dr, cc + dc) in aset:
+                return True
+    return False
+
