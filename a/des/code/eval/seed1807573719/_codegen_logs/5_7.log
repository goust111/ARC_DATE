+import numpy as np
+
+from collections import Counter, deque
+
+
+BG = 0
+MAX_FRAGMENT_CELLS = 4
+
+LEGEND_RING_SIZE = 4
+LEGEND_ROW_H = 4
+LEGEND_ROW_GAP = 1
+LEGEND_ROWS = 3
+LEGEND_SAMPLE_TOP = 1
+LEGEND_SAMPLE_LEFT = 8
+LEGEND_W = 10
+LEGEND_H = LEGEND_ROWS * LEGEND_ROW_H + (LEGEND_ROWS - 1) * LEGEND_ROW_GAP
+
+GRID_H_RANGE = (24, 31)
+GRID_W_RANGE = (24, 31)
+RING_COUNT_CHOICES = (3, 4)
+RING_SIDE_MIN = 6
+RING_SIDE_MAX = 10
+RING_RECT_GAP = 2
+FRAGMENT_PAD = 1
+GEN_RETRIES = 400
+
+RNG = np.random.default_rng()
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values = np.bincount(np.asarray(grid, dtype=int).ravel(), minlength=10)
+    return int(np.argmax(values))
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _rect_border_mask(h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _normalize_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1]
+
+
+def _canonical_shape(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
+    r0, c0, r1, c1 = _bbox(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    best = None
+    for k in range(4):
+        rot = _normalize_mask(np.rot90(mask, k))
+        key = tuple(map(tuple, np.argwhere(rot)))
+        if best is None or key < best:
+            best = key
+    assert best is not None
+    return best
+
+
+def _legend_origins(shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    return [
+        (0, 0),
+        (0, w - LEGEND_W),
+        (h - LEGEND_H, 0),
+        (h - LEGEND_H, w - LEGEND_W),
+    ]
