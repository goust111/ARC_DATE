+            cells.add((rr, w - 1))
+        for cc in range(hrun):
+            cells.add((0, w - 1 - cc))
+    elif corner == "bl":
+        for rr in range(vrun):
+            cells.add((h - 1 - rr, 0))
+        for cc in range(hrun):
