+def _random_line_gap(h: int, w: int) -> np.ndarray:
+    options = []
+    for length in range(2, 5):
+        if w - 2 >= length:
+            for side in ("top", "bottom"):
+                for start in range(1, w - length):
+                    options.append((side, start, length))
+        if h - 2 >= length:
