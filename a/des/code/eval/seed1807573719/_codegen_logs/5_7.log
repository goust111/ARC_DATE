+def _draw_legend(
+    grid: np.ndarray,
+    corner: int,
+    row_colors: list[int],
+    legend_patterns: dict[int, tuple[str, int | bool]],
+) -> tuple[int, int, int, int]:
+    h, w = grid.shape
+    if corner == 0:
+        r0, c0 = 0, 0
+    elif corner == 1:
+        r0, c0 = 0, w - LEGEND_W
+    elif corner == 2:
+        r0, c0 = h - LEGEND_H, 0
+    else:
+        r0, c0 = h - LEGEND_H, w - LEGEND_W
