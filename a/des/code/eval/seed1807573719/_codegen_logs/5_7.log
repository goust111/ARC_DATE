+GRID_H_RANGE = (24, 31)
+GRID_W_RANGE = (24, 31)
+RING_COUNT_CHOICES = (3, 4)
+RING_SIDE_MIN = 6
+RING_SIDE_MAX = 10
+RING_RECT_GAP = 2
