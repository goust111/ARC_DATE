+def _random_l_gap(h: int, w: int) -> np.ndarray:
+    options = []
+    for vrun, hrun in ((2, 2), (2, 3), (3, 2)):
+        if h >= vrun and w >= hrun:
+            options.append(("tl", vrun, hrun))
