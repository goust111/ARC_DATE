+                else:
+                    _cast_ray(out, g, start_r=r, start_c=c1 + 1, dr=0, dc=1, length=total, color=color, bg=bg)
+
+    return out
+
+
+# --------------- generator helpers ---------------
+
+GRID_H_RANGE = (18, 28)
+GRID_W_RANGE = (18, 28)
+ROOM_COUNT_RANGE = (2, 4)
+ROOM_H_RANGE = (5, 8)
+ROOM_W_RANGE = (5, 8)
+MAX_TOTAL_WINDOWS = 8
+MAX_SELECTED_WINDOWS = 3
+GEN_RETRY_LIMIT = 400
+PLACE_RETRIES = 250
