+        island2 = [(top + h1 + bridge_len + int(r), left + int(c)) for r, c in shape2]
+        bridge = [(top + h1 + i, left + connector_col) for i in range(bridge_len)]
+        return {
+            "islands": [(island1, color1), (island2, color2)],
+            "bridge": bridge,
+            "areas": (areas[0], areas[1]),
+            "colors": (color1, color2),
