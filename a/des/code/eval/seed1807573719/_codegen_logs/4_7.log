+
+
+def _build_horizontal_gadget(
+    slot: tuple[int, int, int, int], scenario: str, rng: np.random.Generator
+) -> dict | None:
+    sr0, sr1, sc0, sc1 = slot
+    slot_h = sr1 - sr0 + 1
+    slot_w = sc1 - sc0 + 1
+    usable_h = slot_h - 2 * SLOT_MARGIN
+    usable_w = slot_w - 2 * SLOT_MARGIN
