+        if gadget is None:
+            return None
+        _draw_gadget(grid, gadget)
+        gadgets.append(gadget)
+
+    if _most_common_color(grid) != BG_COLOR:
+        return None
+
+    expected = _expected_output(grid, gadgets)
+    try:
+        actual = main(grid)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+
+    return grid
+
