+def _draw_gadget(grid: np.ndarray, gadget: dict) -> None:
+    for cells, color in gadget["islands"]:
+        for r, c in cells:
+            grid[r, c] = color
+    for r, c in gadget["bridge"]:
+        grid[r, c] = BRIDGE_COLOR
+
