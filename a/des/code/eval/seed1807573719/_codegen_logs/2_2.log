+    role_map = {(r, c): "filled" for r in range(total_rows) for c in range(total_cols)}
+    piece_specs: list[dict] = []
+    offset = 0
+    for idx, col in enumerate(piece_cols):
+        owned = selected_rows[offset : offset + shares[idx]]
+        offset += shares[idx]
