+
+def _partition_with_min(total: int, parts: int, minimum: int) -> list[int]:
+    sizes = [minimum] * parts
+    for _ in range(total - minimum * parts):
+        sizes[random.randrange(parts)] += 1
+    random.shuffle(sizes)
+    return sizes
