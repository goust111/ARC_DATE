+def _layout_canvas(row_sizes: list[int], col_sizes: list[int], bg: int) -> tuple[np.ndarray, dict[tuple[int, int], tuple[int, int, int, int]]]:
+    h = sum(row_sizes) + len(row_sizes) + 1
