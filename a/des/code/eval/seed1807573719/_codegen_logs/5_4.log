+    return rects
+
+
+def _inside_bbox(r: int, c: int, box: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = box
+    return r0 <= r <= r1 and c0 <= c <= c1
+
+
+def _extract_key_mask(points: list[tuple[int, int]]) -> np.ndarray:
