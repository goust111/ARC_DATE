TRAIL_COLOR = int(Color.MAROON)
AVAILABLE_COLORS = [c for c in range(10) if c != TRAIL_COLOR]
MAX_GENERATION_ATTEMPTS = 300
SIDES = ("left", "right")

ROW_LAYOUTS = [
    (rows, floor_thick, empty_rows, rows - floor_thick - empty_rows)
    for rows in GRID_ROWS
