        out[floor_row, : trail_end + 1] = int(trail_color)
    else:
        trail_start = int(final_bottom_cols.min()) + 1
        assert trail_start < width, "trail must cover at least one floor pixel"
        out[floor_row, trail_start:] = int(trail_color)

