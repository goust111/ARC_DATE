+                continue
+            next_id += 1
+            labels[r0, c0] = next_id
+            queue: deque[tuple[int, int]] = deque([(r0, c0)])
+            coords: list[tuple[int, int]] = []
+            while queue:
+                r, c = queue.popleft()
+                coords.append((r, c))
+                for dr, dc in NEIGHBORS4:
