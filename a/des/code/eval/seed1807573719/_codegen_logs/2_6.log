+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+PALETTE_CANDIDATES = (
+    ("tl", "h"),
+    ("tl", "v"),
+    ("tr", "h"),
+    ("tr", "v"),
+    ("bl", "h"),
+    ("bl", "v"),
+    ("br", "h"),
+    ("br", "v"),
+)
