+        step = (0, 1) if orientation == "h" else (1, 0)
+    elif corner == "tr":
+        start = (0, width - 1)
+        step = (0, -1) if orientation == "h" else (1, 0)
+    elif corner == "bl":
+        start = (height - 1, 0)
+        step = (0, 1) if orientation == "h" else (-1, 0)
+    elif corner == "br":
+        start = (height - 1, width - 1)
+        step = (0, -1) if orientation == "h" else (-1, 0)
