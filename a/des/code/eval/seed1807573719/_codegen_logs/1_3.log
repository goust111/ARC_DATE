+def _boundary_anchors(h: int, w: int) -> list[tuple[int, int]]:
+    return [
+        (0, random.randrange(w)),
+        (h - 1, random.randrange(w)),
+        (random.randrange(h), 0),
+        (random.randrange(h), w - 1),
+    ]
