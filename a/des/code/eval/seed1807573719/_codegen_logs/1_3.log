 139: def _pick_spaced(candidates: list[int], n: int, min_spacing: int) -> list[int] | None:
 140:     """Pick up to n values from candidates with at least min_spacing between any two."""
 141:     if not candidates:
 142:         return None
 143:     if n == 1:
 144:         return [random.choice(candidates)]
 145:     random.shuffle(candidates)
 146:     picked: list[int] = []
 147:     for v in candidates:
 148:         if all(abs(v - p) >= min_spacing for p in picked):
 149:             picked.append(v)
 150:             if len(picked) == n:
 151:                 return picked
 152:     return picked if picked else None
 153: 
 154: 
 155: def _make_sprite(color: int, max_h: int, max_w: int) -> np.ndarray | None:
 156:     """Generate a single-color 8-connected sprite cropped to its bounding box."""
 157:     sh = min(random.choice([3, 3, 3, 4, 5]), max_h)
 158:     sw = min(random.choice([3, 3, 3, 4, 5]), max_w)
 159:     if sh < 1 or sw < 1:
 160:         return None
 161:     n_pixels = random.randint(3, min(9, sh * sw))
 162:     pixels = {(sh // 2, sw // 2)}
 163:     r, c = sh // 2, sw // 2
 164:     for _ in range(n_pixels * 30):
 165:         if len(pixels) >= n_pixels:
 166:             break
 167:         dr, dc = random.choice([(0, 1), (0, -1), (1, 0), (-1, 0),
 168:                                  (1, 1), (1, -1), (-1, 1), (-1, -1)])
 169:         nr, nc = r + dr, c + dc
 170:         if 0 <= nr < sh and 0 <= nc < sw:
 171:             pixels.add((nr, nc))
 172:             r, c = nr, nc
 173:     rows = [p[0] for p in pixels]
 174:     cols = [p[1] for p in pixels]
 175:     min_r, max_r = min(rows), max(rows)
 176:     min_c, max_c = min(cols), max(cols)
 177:     sprite = np.zeros((max_r - min_r + 1, max_c - min_c + 1), dtype=int)
 178:     for pr, pc in pixels:
 179:         sprite[pr - min_r, pc - min_c] = color
 180:     return sprite
 181: 
