+
+def _box_free(blocked: np.ndarray, r0: int, c0: int, r1: int, c1: int, pad: int = 1) -> bool:
+    hh, ww = blocked.shape
+    if r0 - pad < 0 or c0 - pad < 0 or r1 + pad >= hh or c1 + pad >= ww:
