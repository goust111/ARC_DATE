+def _connect_path(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = a
+    tr, tc = b
+    path = [(r, c)]
+    if random.random() < 0.5:
+        while c != tc:
+            c += 1 if tc > c else -1
+            path.append((r, c))
+        while r != tr:
+            r += 1 if tr > r else -1
+            path.append((r, c))
+    else:
