+        pieces.append({"bbox": bbox, "patch": patch, "shape": tuple(map(int, patch.shape))})
+    return pieces
+
+
+def _match_pieces_to_containers(pieces: list[dict], containers: list[dict]) -> dict[int, int]:
+    candidates: dict[int, list[int]] = {}
