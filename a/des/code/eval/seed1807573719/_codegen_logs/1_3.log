 156:     def station_groups():
 157:         # Stations are 9 pixels with no adjacent 8 in the 8-neighborhood.
 158:         # Station groups are 8-connected components of those station pixels.
 159:         # Station 9s have no adjacent 8 in 8-neighborhood
 160:         sm = np.zeros((H, W), dtype=bool)
 161:         for r in range(H):
 162:             for c in range(W):
 163:                 if grid[r, c] != 9:
 164:                     continue
 165:                 ok = all(grid[r+dr, c+dc] != 8
 166:                         for dr in (-1, 0, 1) for dc in (-1, 0, 1)
 167:                         if (dr != 0 or dc != 0) and 0 <= r+dr < H and 0 <= c+dc < W)
 168:                 if ok:
 169:                     sm[r, c] = True
 170:         # 8-connected clustering
 171:         struct = np.ones((3, 3), dtype=int)
 172:         lab, n = label(sm, structure=struct)
 173:         groups = []
 174:         for k in range(1, n + 1):
 175:             coords = np.argwhere(lab == k)
 176:             groups.append([(int(r), int(c)) for r, c in coords])
