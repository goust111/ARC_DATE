+def _piece_signature(arr: np.ndarray) -> bytes:
+    return arr.tobytes() + str(arr.shape).encode()
+
+
+def _generate_piece_patch(h: int, w: int) -> np.ndarray:
+    area = h * w
+    target_min = max(h + w - 2, (area * 2 + 4) // 5)
+    target_max = max(target_min, area - 1)
