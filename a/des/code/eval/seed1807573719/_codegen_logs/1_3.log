+            assignment[pi] = ci
+            if dfs(k + 1):
+                return True
+            used.remove(ci)
+            del assignment[pi]
+        return False
+
+    assert dfs(0)
+    return assignment
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    grid = np.asarray(grid, dtype=int)
