+        grid[r, c0] = GREEN
+        grid[r, c1] = GREEN
+    for c in range(c0, c1 + 1):
+        grid[r0, c] = GREEN
+        grid[r1, c] = GREEN
+    gr, gc = container["gap"]
+    grid[gr, gc] = BLACK
+    for r, c in container["marker_cells"]:
