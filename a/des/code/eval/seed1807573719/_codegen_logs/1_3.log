+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREEN = 3
+PIECE_COLORS = [1, 4, 5, 6, 7, 8, 9]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_H_RANGE = (22, 31)
+GRID_W_RANGE = (22, 33)
+PAIR_COUNTS = [2, 3, 4]
+INTERIOR_SIDE_RANGE = (3, 7)
+GEN_RETRIES = 500
+PATCH_RETRIES = 200
