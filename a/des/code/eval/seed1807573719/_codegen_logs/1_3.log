+
+def _draw_container_with_fixed_gap(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    container: dict,
+    gap_index: int,
+) -> dict | None:
+    r0, c0, r1, c1 = container["outer_bbox"]
