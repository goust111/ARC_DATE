 116: def _sample_object_dims(canvas_h: int, canvas_w: int) -> tuple[int, int] | None:
 117:     feasible_dims = [
 118:         (oh, ow)
 119:         for oh in range(*OBJECT_SHAPE_RANGES[0])
 120:         for ow in range(*OBJECT_SHAPE_RANGES[1])
 121:         if oh <= canvas_h and ow <= canvas_w and (
 122:             canvas_h - 2 * oh >= MIN_SEPARATION_GAP
 123:             or canvas_w - 2 * ow >= MIN_SEPARATION_GAP
 124:         )
 125:     ]
 126:     if not feasible_dims:
 127:         return None
 128:     return feasible_dims[int(np.random.randint(len(feasible_dims)))]
 129: 
