+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREEN = 3
+PIECE_COLORS = [1, 4, 5, 6, 7, 8, 9]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_H_RANGE = (22, 31)
+GRID_W_RANGE = (22, 33)
+PAIR_COUNTS = [2, 3, 4]
+INTERIOR_SIDE_RANGE = (3, 7)
+GEN_RETRIES = 500
+PATCH_RETRIES = 200
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _crop_patch(grid: np.ndarray, coords: list[tuple[int, int]]) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = _bbox(coords)
+    patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    for r, c in coords:
+        patch[r - r0, c - c0] = int(grid[r, c])
+    return patch, (r0, c0, r1, c1)
+
+
+def _paste_nonzero(dst: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    h, w = patch.shape
+    region = dst[top : top + h, left : left + w]
+    mask = patch != BLACK
+    region[mask] = patch[mask]
+
+
+def _unordered_shape(shape: tuple[int, int]) -> tuple[int, int]:
+    a, b = map(int, shape)
+    return (a, b) if a <= b else (b, a)
+
+
+def _find_containers(grid: np.ndarray) -> list[dict]:
+    red_lookup: dict[tuple[int, int], int] = {}
+    red_sizes: dict[int, int] = {}
+    for idx, comp in enumerate(_components(grid == RED)):
+        red_sizes[idx] = len(comp)
+        for cell in comp:
+            red_lookup[cell] = idx
+
+    containers = []
+    for comp in _components(grid == GREEN):
+        r0, c0, r1, c1 = _bbox(comp)
+        gap_cells = []
+        for r in range(r0, r1 + 1):
+            for c in range(c0, c1 + 1):
+                if r not in (r0, r1) and c not in (c0, c1):
+                    continue
+                if int(grid[r, c]) != GREEN:
+                    gap_cells.append((r, c))
+        assert len(gap_cells) == 1
+        gr, gc = gap_cells[0]
+        if gr == r0:
+            anchor = (r0 - 1, gc)
+        elif gr == r1:
+            anchor = (r1 + 1, gc)
+        elif gc == c0:
+            anchor = (gr, c0 - 1)
+        else:
+            anchor = (gr, c1 + 1)
+        assert anchor in red_lookup
+        containers.append(
+            {
+                "outer_bbox": (r0, c0, r1, c1),
+                "interior_top_left": (r0 + 1, c0 + 1),
+                "interior_shape": (r1 - r0 - 1, c1 - c0 - 1),
+                "lock": int(red_sizes[red_lookup[anchor]]),
+            }
+        )
+    return containers
+
+
+def _find_pieces(grid: np.ndarray) -> list[dict]:
+    piece_mask = (grid != BLACK) & (grid != RED) & (grid != GREEN)
+    pieces = []
+    for comp in _components(piece_mask):
+        patch, bbox = _crop_patch(grid, comp)
+        pieces.append({"bbox": bbox, "patch": patch, "shape": tuple(map(int, patch.shape))})
+    return pieces
+
+
+def _match_pieces_to_containers(pieces: list[dict], containers: list[dict]) -> dict[int, int]:
+    candidates: dict[int, list[int]] = {}
+    for pi, piece in enumerate(pieces):
+        ph, pw = piece["shape"]
+        cand = []
+        for ci, container in enumerate(containers):
+            ih, iw = container["interior_shape"]
+            if (ph, pw) == (ih, iw) or (ph, pw) == (iw, ih):
+                cand.append(ci)
+        assert cand
+        candidates[pi] = cand
+
+    order = sorted(candidates, key=lambda i: (len(candidates[i]), pieces[i]["shape"], pieces[i]["bbox"]))
+    used: set[int] = set()
+    assignment: dict[int, int] = {}
+
+    def dfs(k: int) -> bool:
+        if k == len(order):
+            return True
+        pi = order[k]
+        for ci in candidates[pi]:
+            if ci in used:
+                continue
+            used.add(ci)
+            assignment[pi] = ci
+            if dfs(k + 1):
+                return True
+            used.remove(ci)
+            del assignment[pi]
+        return False
+
+    assert dfs(0)
+    return assignment
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    grid = np.asarray(grid, dtype=int)
+    out = grid.copy()
+    containers = _find_containers(grid)
+    pieces = _find_pieces(grid)
+    assert len(containers) == len(pieces)
+
+    assignment = _match_pieces_to_containers(pieces, containers)
+    for piece_idx, container_idx in assignment.items():
+        piece = pieces[piece_idx]
+        container = containers[container_idx]
+        lock = int(container["lock"])
+        rotated = np.rot90(piece["patch"], -lock)
+        ih, iw = container["interior_shape"]
+        assert rotated.shape == (ih, iw)
+
+        pr0, pc0, pr1, pc1 = piece["bbox"]
+        out[pr0 : pr1 + 1, pc0 : pc1 + 1][piece["patch"] != BLACK] = BLACK
+
+        ir0, ic0 = container["interior_top_left"]
+        _paste_nonzero(out, rotated, ir0, ic0)
+    return out
+
+
+def _choose_locks(count: int) -> list[int]:
+    if count == 2:
+        locks = [2, random.choice([1, 3])]
+    elif count == 3:
+        locks = [1, 2, 3]
+    else:
+        locks = [1, 2, 3, random.choice([1, 2, 3])]
+    random.shuffle(locks)
+    return locks
+
+
+def _container_size_pool() -> list[tuple[int, int]]:
+    pairs = []
+    lo, hi = INTERIOR_SIDE_RANGE
+    for a in range(lo, hi):
+        for b in range(a + 1, hi):
+            pairs.append((a, b))
+    return pairs
+
+
+def _connect_path(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = a
+    tr, tc = b
+    path = [(r, c)]
+    if random.random() < 0.5:
+        while c != tc:
+            c += 1 if tc > c else -1
+            path.append((r, c))
+        while r != tr:
+            r += 1 if tr > r else -1
+            path.append((r, c))
+    else:
+        while r != tr:
+            r += 1 if tr > r else -1
+            path.append((r, c))
+        while c != tc:
+            c += 1 if tc > c else -1
+            path.append((r, c))
+    return path
+
+
+def _boundary_anchors(h: int, w: int) -> list[tuple[int, int]]:
+    return [
+        (0, random.randrange(w)),
+        (h - 1, random.randrange(w)),
+        (random.randrange(h), 0),
+        (random.randrange(h), w - 1),
+    ]
+
+
+def _piece_signature(arr: np.ndarray) -> bytes:
+    return arr.tobytes() + str(arr.shape).encode()
+
+
+def _generate_piece_patch(h: int, w: int) -> np.ndarray:
+    area = h * w
+    target_min = max(h + w - 2, (area * 2 + 4) // 5)
+    target_max = max(target_min, area - 1)
+
+    for _ in range(PATCH_RETRIES):
+        target = random.randint(target_min, target_max)
+        cells = set(_boundary_anchors(h, w))
+        anchors = list(cells)
+        random.shuffle(anchors)
+        cur = anchors[0]
+        for nxt in anchors[1:]:
+            for cell in _connect_path(cur, nxt):
+                cells.add(cell)
+            cur = nxt
+
+        while len(cells) < target:
+            frontier = []
+            for r, c in cells:
+                for dr, dc in DIRS4:
+                    nr = r + dr
+                    nc = c + dc
+                    if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
+                        frontier.append((nr, nc))
+            if not frontier:
+                break
+            cells.add(random.choice(frontier))
+
+        if len(cells) < target_min:
+            continue
+
+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in cells:
+            mask[r, c] = True
+        if len(_components(mask)) != 1:
+            continue
+        if not (mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any()):
+            continue
+
+        color_count = 2 if len(cells) < 7 else random.choice([2, 3])
+        palette = random.sample(PIECE_COLORS, color_count)
+        patch = np.zeros((h, w), dtype=int)
+        for r, c in sorted(cells):
+            patch[r, c] = random.choice(palette)
+        used_colors = {int(v) for v in patch[patch != BLACK]}
+        if len(used_colors) < 2:
+            continue
+        if np.array_equal(patch, np.rot90(patch, 2)):
+            continue
+        sigs = {_piece_signature(np.rot90(patch, k)) for k in range(4)}
+        if len(sigs) < 3:
+            continue
+        return patch
+    raise RuntimeError("failed to generate a non-degenerate piece patch")
+
+
+def _mark_blocked(blocked: np.ndarray, r0: int, c0: int, r1: int, c1: int, pad: int = 1) -> None:
+    h, w = blocked.shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h - 1, r1 + pad)
+    cc1 = min(w - 1, c1 + pad)
+    blocked[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+
+
+def _rectangle_free(blocked: np.ndarray, r0: int, c0: int, h: int, w: int) -> bool:
+    hh, ww = blocked.shape
+    if r0 < 0 or c0 < 0 or r0 + h > hh or c0 + w > ww:
+        return False
+    return not bool(blocked[r0 : r0 + h, c0 : c0 + w].any())
+
+
+def _draw_container(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    interior_h: int,
+    interior_w: int,
+    lock: int,
+    side: str,
+) -> dict | None:
+    outer_h = interior_h + 2
+    outer_w = interior_w + 2
+    gap_index = random.randint(1, (outer_w - 2) if side in ("top", "bottom") else (outer_h - 2))
+
+    candidates = []
+    for r0 in range(grid.shape[0]):
+        for c0 in range(grid.shape[1]):
+            r1 = r0 + outer_h - 1
+            c1 = c0 + outer_w - 1
+            if r1 >= grid.shape[0] or c1 >= grid.shape[1]:
+                continue
+            if side == "top":
+                marker_bbox = (r0 - lock, c0 + gap_index, r0 - 1, c0 + gap_index)
+            elif side == "bottom":
+                marker_bbox = (r1 + 1, c0 + gap_index, r1 + lock, c0 + gap_index)
+            elif side == "left":
+                marker_bbox = (r0 + gap_index, c0 - lock, r0 + gap_index, c0 - 1)
+            else:
+                marker_bbox = (r0 + gap_index, c1 + 1, r0 + gap_index, c1 + lock)
+
+            mr0, mc0, mr1, mc1 = marker_bbox
+            if mr0 < 0 or mc0 < 0 or mr1 >= grid.shape[0] or mc1 >= grid.shape[1]:
+                continue
+            rr0 = min(r0, mr0)
+            cc0 = min(c0, mc0)
+            rr1 = max(r1, mr1)
+            cc1 = max(c1, mc1)
+            if _rectangle_free(blocked, rr0 - 1, cc0 - 1, rr1 - rr0 + 3, cc1 - cc0 + 3):
+                candidates.append((r0, c0, marker_bbox))
+    if not candidates:
+        return None
+
+    r0, c0, marker_bbox = random.choice(candidates)
+    r1 = r0 + outer_h - 1
+    c1 = c0 + outer_w - 1
+
+    for r in range(r0, r1 + 1):
+        grid[r, c0] = GREEN
+        grid[r, c1] = GREEN
+    for c in range(c0, c1 + 1):
+        grid[r0, c] = GREEN
+        grid[r1, c] = GREEN
+
+    if side == "top":
+        gap = (r0, c0 + gap_index)
+        marker_cells = [(r0 - k, c0 + gap_index) for k in range(1, lock + 1)]
+    elif side == "bottom":
+        gap = (r1, c0 + gap_index)
+        marker_cells = [(r1 + k, c0 + gap_index) for k in range(1, lock + 1)]
+    elif side == "left":
+        gap = (r0 + gap_index, c0)
+        marker_cells = [(r0 + gap_index, c0 - k) for k in range(1, lock + 1)]
+    else:
+        gap = (r0 + gap_index, c1)
+        marker_cells = [(r0 + gap_index, c1 + k) for k in range(1, lock + 1)]
+    grid[gap] = BLACK
+    for cell in marker_cells:
+        grid[cell] = RED
+
+    all_cells = [(r0, c0), (r1, c1)] + marker_cells
+    rr0 = min(r for r, _ in all_cells)
+    cc0 = min(c for _, c in all_cells)
+    rr1 = max(r for r, _ in all_cells)
+    cc1 = max(c for _, c in all_cells)
+    _mark_blocked(blocked, rr0, cc0, rr1, cc1, pad=1)
+
+    return {
+        "outer_bbox": (r0, c0, r1, c1),
+        "interior_top_left": (r0 + 1, c0 + 1),
+        "interior_shape": (interior_h, interior_w),
+        "lock": lock,
+    }
+
+
+def _place_piece(grid: np.ndarray, blocked: np.ndarray, patch: np.ndarray) -> tuple[int, int] | None:
+    h, w = patch.shape
+    candidates = []
+    for r0 in range(grid.shape[0] - h + 1):
+        for c0 in range(grid.shape[1] - w + 1):
+            if _rectangle_free(blocked, r0, c0, h, w):
+                candidates.append((r0, c0))
+    if not candidates:
+        return None
+    r0, c0 = random.choice(candidates)
+    _paste_nonzero(grid, patch, r0, c0)
+    _mark_blocked(blocked, r0, c0, r0 + h - 1, c0 + w - 1, pad=1)
+    return r0, c0
+
+
+def _render_expected(containers: list[dict], final_patches: list[np.ndarray], shape: tuple[int, int]) -> np.ndarray:
+    out = np.zeros(shape, dtype=int)
+    for container in containers:
+        r0, c0, r1, c1 = container["outer_bbox"]
+        for r in range(r0, r1 + 1):
+            out[r, c0] = GREEN
+            out[r, c1] = GREEN
+        for c in range(c0, c1 + 1):
+            out[r0, c] = GREEN
+            out[r1, c] = GREEN
+        ir0, ic0 = container["interior_top_left"]
+        _paste_nonzero(out, final_patches[container["index"]], ir0, ic0)
+        side = container["side"]
+        gap_index = container["gap_index"]
+        if side == "top":
+            out[r0, c0 + gap_index] = BLACK
+            for k in range(1, container["lock"] + 1):
+                out[r0 - k, c0 + gap_index] = RED
+        elif side == "bottom":
+            out[r1, c0 + gap_index] = BLACK
+            for k in range(1, container["lock"] + 1):
+                out[r1 + k, c0 + gap_index] = RED
+        elif side == "left":
+            out[r0 + gap_index, c0] = BLACK
+            for k in range(1, container["lock"] + 1):
+                out[r0 + gap_index, c0 - k] = RED
+        else:
+            out[r0 + gap_index, c1] = BLACK
+            for k in range(1, container["lock"] + 1):
+                out[r0 + gap_index, c1 + k] = RED
+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(*GRID_H_RANGE)
+    w = random.randint(*GRID_W_RANGE)
+    grid = np.zeros((h, w), dtype=int)
+    blocked = np.zeros((h, w), dtype=bool)
+
+    pair_count = random.choice(PAIR_COUNTS)
+    size_pool = random.sample(_container_size_pool(), pair_count)
+    locks = _choose_locks(pair_count)
+
+    final_patches: list[np.ndarray] = []
+    containers: list[dict] = []
+    for idx, ((a, b), lock) in enumerate(zip(size_pool, locks)):
+        interior_h, interior_w = (a, b) if random.random() < 0.5 else (b, a)
+        side = random.choice(["top", "bottom", "left", "right"])
+        container = _draw_container(grid, blocked, interior_h, interior_w, lock, side)
+        if container is None:
+            return None
+        container["index"] = idx
+        container["side"] = side
+        container["gap_index"] = random.randint(1, (interior_w if side in ("top", "bottom") else interior_h))
+        # Rebuild the last container using the stored gap index for deterministic expected rendering.
+        r0, c0, r1, c1 = container["outer_bbox"]
+        grid[r0 : r1 + 1, c0 : c1 + 1] = BLACK
+        grid[grid == RED] = grid[grid == RED]
+        container = _draw_container_with_fixed_gap(grid, blocked, container, container["gap_index"])
+        if container is None:
+            return None
+        container["index"] = idx
+        container["side"] = side
+        final_patches.append(_generate_piece_patch(interior_h, interior_w))
+        containers.append(container)
+
+    expected = np.zeros_like(grid)
+    for container, final_patch in zip(containers, final_patches):
+        _render_container(expected, container)
+        ir0, ic0 = container["interior_top_left"]
+        _paste_nonzero(expected, final_patch, ir0, ic0)
+
+    for container, final_patch in zip(containers, final_patches):
+        input_patch = np.rot90(final_patch, container["lock"])
+        placed = _place_piece(grid, blocked, input_patch)
+        if placed is None:
+            return None
+
+    try:
+        if np.array_equal(main(grid), expected):
+            return grid
+    except Exception:
+        return None
+    return None
+
+
+def _render_container(grid: np.ndarray, container: dict) -> None:
+    r0, c0, r1, c1 = container["outer_bbox"]
+    for r in range(r0, r1 + 1):
+        grid[r, c0] = GREEN
+        grid[r, c1] = GREEN
+    for c in range(c0, c1 + 1):
+        grid[r0, c] = GREEN
+        grid[r1, c] = GREEN
+    side = container["side"]
+    gap_index = container["gap_index"]
+    if side == "top":
+        grid[r0, c0 + gap_index] = BLACK
+        for k in range(1, container["lock"] + 1):
+            grid[r0 - k, c0 + gap_index] = RED
+    elif side == "bottom":
+        grid[r1, c0 + gap_index] = BLACK
+        for k in range(1, container["lock"] + 1):
+            grid[r1 + k, c0 + gap_index] = RED
+    elif side == "left":
+        grid[r0 + gap_index, c0] = BLACK
+        for k in range(1, container["lock"] + 1):
+            grid[r0 + gap_index, c0 - k] = RED
+    else:
+        grid[r0 + gap_index, c1] = BLACK
+        for k in range(1, container["lock"] + 1):
+            grid[r0 + gap_index, c1 + k] = RED
+
+
+def _draw_container_with_fixed_gap(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    container: dict,
+    gap_index: int,
+) -> dict | None:
+    r0, c0, r1, c1 = container["outer_bbox"]
+    side = container["side"]
+    lock = container["lock"]
+    all_cells = []
+    for r in range(r0, r1 + 1):
+        all_cells.append((r, c0))
+        all_cells.append((r, c1))
+    for c in range(c0, c1 + 1):
+        all_cells.append((r0, c))
+        all_cells.append((r1, c))
+    if side == "top":
+        marker_cells = [(r0 - k, c0 + gap_index) for k in range(1, lock + 1)]
+    elif side == "bottom":
+        marker_cells = [(r1 + k, c0 + gap_index) for k in range(1, lock + 1)]
+    elif side == "left":
+        marker_cells = [(r0 + gap_index, c0 - k) for k in range(1, lock + 1)]
+    else:
+        marker_cells = [(r0 + gap_index, c1 + k) for k in range(1, lock + 1)]
+    for r, c in marker_cells:
+        if not (0 <= r < grid.shape[0] and 0 <= c < grid.shape[1]):
+            return None
+
+    _render_container(grid, {"outer_bbox": (r0, c0, r1, c1), "side": side, "gap_index": gap_index, "lock": lock})
+    rr0 = min([r0] + [r for r, _ in marker_cells])
+    cc0 = min([c0] + [c for _, c in marker_cells])
+    rr1 = max([r1] + [r for r, _ in marker_cells])
+    cc1 = max([c1] + [c for _, c in marker_cells])
+    _mark_blocked(blocked, rr0, cc0, rr1, cc1, pad=1)
+    return {
+        "outer_bbox": (r0, c0, r1, c1),
+        "interior_top_left": (r0 + 1, c0 + 1),
+        "interior_shape": (r1 - r0 - 1, c1 - c0 - 1),
+        "lock": lock,
+        "side": side,
+        "gap_index": gap_index,
+    }
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid input")

