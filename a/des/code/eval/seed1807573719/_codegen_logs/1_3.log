 185:             coords = np.argwhere(lab == k)
 186:             r0, c0 = coords.min(axis=0)
 187:             r1, c1 = coords.max(axis=0)
 188:             if (r1 - r0 + 1) >= 5 and (c1 - c0 + 1) >= 5:
 189:                 regs.append({"r0": int(r0), "r1": int(r1), "c0": int(c0), "c1": int(c1)})
 190:         return regs
 191: 
 192:     def boundary_dirs_for_region(reg, stripe_colors):
 193:         # For a region bbox, infer which stripe color borders each side.
 194:         # Returns map: stripe_color -> direction (0=up,1=right,2=down,3=left)
 195:         # Map stripe color -> direction (0=up, 1=right, 2=down, 3=left)
 196:         dirs = {}
 197:         r0, r1, c0, c1 = reg["r0"], reg["r1"], reg["c0"], reg["c1"]
 198:         if r0 - 1 >= 0:
 199:             mc = Counter(grid[r0 - 1, c0:c1 + 1].tolist()).most_common(1)[0][0]
 200:             if mc in stripe_colors:
 201:                 dirs[int(mc)] = 0
 202:         if r1 + 1 < H:
 203:             mc = Counter(grid[r1 + 1, c0:c1 + 1].tolist()).most_common(1)[0][0]
 204:             if mc in stripe_colors:
 205:                 dirs[int(mc)] = 2
 206:         if c0 - 1 >= 0:
 207:             mc = Counter(grid[r0:r1 + 1, c0 - 1].tolist()).most_common(1)[0][0]
 208:             if mc in stripe_colors:
 209:                 dirs[int(mc)] = 3
 210:         if c1 + 1 < W:
 211:             mc = Counter(grid[r0:r1 + 1, c1 + 1].tolist()).most_common(1)[0][0]
 212:             if mc in stripe_colors:
 213:                 dirs[int(mc)] = 1
 214:         return dirs
 215: 
 216:     def xform_coords(coords, shape, flip_ud, rot_k):
 217:         """Transform coords, return (list, new_shape)."""
 218:         result = transform_coords(coords, shape, flip_ud, rot_k)
 219:         new_shape = apply_transform(np.zeros(shape), flip_ud, rot_k).shape
 220:         return list(result), new_shape
 221: 
 222:     def choose_best_op(train, divider_dirs):
 223:         # Pick orientation (flip/rot) that makes divider-color marker pixels
 224:         # "face" the region boundary stripe of the same color.
 225:         bbox0 = train["bbox"]
 226:         H0, W0 = bbox0.shape
 227:         markers_by_color = defaultdict(list)
 228:         for v, r, c in train["marker_pixels"]:
 229:             if v in divider_dirs:
 230:                 markers_by_color[v].append((r, c))
 231:         assert markers_by_color, "Each train must expose divider-colored markers"
 232:         assert train["body9"], "Each train must carry at least one coupler"
 233:         ref_r = sum(r for r, _ in train["body9"]) / len(train["body9"])
 234:         ref_c = sum(c for _, c in train["body9"]) / len(train["body9"])
 235:         best, best_score = (False, 0), -1
 236:         for flip_ud in (False, True):
 237:             for k in range(4):
 238:                 ref_t = list(transform_coords([(int(round(ref_r)), int(round(ref_c)))], (H0, W0), flip_ud, k))
 239:                 rr_ref, cc_ref = ref_t[0]
 240:                 score = 0
 241:                 for color, pts in markers_by_color.items():
 242:                     mr, mc = sum(r for r, _ in pts) / len(pts), sum(c for _, c in pts) / len(pts)
 243:                     m_t = list(transform_coords([(int(round(mr)), int(round(mc)))], (H0, W0), flip_ud, k))
 244:                     rr_m, cc_m = m_t[0]
 245:                     dr, dc = rr_m - rr_ref, cc_m - cc_ref
 246:                     dirc = (0 if dr < 0 else 2) if abs(dr) >= abs(dc) else (3 if dc < 0 else 1)
 247:                     if dirc == divider_dirs[color]:
 248:                         score += 1
 249:                 if score > best_score:
 250:                     best_score, best = score, (flip_ud, k)
 251:         return best
 252: 
 253:     # 1) Detect stripes and partition into regions
 254:     edge_mask, edge_colors, edge_info = find_edge_stripes()
 255:     internal_mask, internal_colors = find_internal_stripes(edge_info)
 256:     stripe_mask = edge_mask | internal_mask
 257:     stripe_colors = edge_colors | internal_colors
 258:     regions = regions_from_stripes(stripe_mask)
 259: 
 260:     # 2) Station groups (targets)
 261:     groups = station_groups()
 262:     groups_by_size = defaultdict(list)
 263:     for g in groups:
 264:         groups_by_size[len(g)].append(g)
 265:     station_set = set(pt for g in groups for pt in g)
 266: 
 267:     # 3) Trains (sources): CCs (excluding stripes) that contain 8.
 268:     #    Also record train-attached 9 couplers (9s NOT part of stations).
 269:     comp_mask = (grid != bg) & (~stripe_mask)
 270:     lab, n = label(comp_mask)
 271:     trains = []
 272:     for k in range(1, n + 1):
 273:         coords = np.argwhere(lab == k)
 274:         vals = [int(grid[r, c]) for r, c in coords]
 275:         if 8 not in vals:
 276:             continue
 277:         r0, c0 = coords.min(axis=0)
 278:         r1, c1 = coords.max(axis=0)
 279:         bbox = grid[r0:r1 + 1, c0:c1 + 1].copy()
 280:         abs_coords = [(int(r), int(c)) for r, c in coords]
 281:         body9, marker_pixels = [], []
 282:         for r, c in abs_coords:
 283:             v = int(grid[r, c])
 284:             if v == 9 and (r, c) not in station_set:
 285:                 body9.append((int(r - r0), int(c - c0)))
 286:             if v in stripe_colors:
 287:                 marker_pixels.append((v, int(r - r0), int(c - c0)))
 288:         trains.append({
 289:             "abs_coords": abs_coords,
 290:             "bbox": bbox,
 291:             "body9": body9,
 292:             "marker_pixels": marker_pixels,
 293:         })
 294: 
 295:     out = grid.copy()
 296:     # 4) Clear trains from original positions (we'll redraw them docked).
 297:     for t in trains:
 298:         for r, c in t["abs_coords"]:
 299:             out[r, c] = bg
 300: 
 301:     # 5) Place each train by:
 302:     # - matching station group size by coupler count
 303:     # - choosing orientation by marker-vs-stripe rule
 304:     # - translating so couplers coincide exactly with station pixels
 305:     for t in trains:
 306:         n9 = len(t["body9"])
 307:         assert n9 > 0, "Each train must carry at least one coupler"
 308:         candidate_groups = groups_by_size.get(n9)
 309:         assert candidate_groups is not None and len(candidate_groups) == 1, (
 310:             f"Expected one station group for coupler count {n9}"
 311:         )
 312:         g = candidate_groups[0]
 313:         gset = set(g)
 314:         matching_regions = [
 315:             rr
 316:             for rr in regions
 317:             if all(rr["r0"] <= r <= rr["r1"] and rr["c0"] <= c <= rr["c1"] for r, c in g)
 318:         ]
 319:         assert len(matching_regions) == 1, "Each station group must belong to exactly one region"
 320:         reg = matching_regions[0]
 321:         divider_dirs = boundary_dirs_for_region(reg, stripe_colors)
 322:         op = choose_best_op(t, divider_dirs)
 323:         tbbox = apply_transform(t["bbox"], *op)
 324:         t_body9, (H1, W1) = xform_coords(t["body9"], t["bbox"].shape, *op)
 325:         body9_set = set(t_body9)
 326:         matching_offsets = {
 327:             (sr - br, sc - bc)
 328:             for br, bc in body9_set
 329:             for sr, sc in gset
 330:             if all((r + sr - br, c + sc - bc) in gset for r, c in body9_set)
 331:         }
 332:         assert len(matching_offsets) == 1, "Couplers must align to a unique station-group offset"
 333:         off_r, off_c = next(iter(matching_offsets))
 334:         # Validate and place (skip 9s - stations already exist)
 335:         ok = True
 336:         for r in range(H1):
 337:             for c in range(W1):
 338:                 v = int(tbbox[r, c])
 339:                 if v == bg or v == 9:
 340:                     continue
 341:                 rr, cc = r + off_r, c + off_c
 342:                 if not (reg["r0"] <= rr <= reg["r1"] and reg["c0"] <= cc <= reg["c1"]):
 343:                     ok = False
 344:                     break
 345:                 if stripe_mask[rr, cc] or (out[rr, cc] != bg and out[rr, cc] != 9):
 346:                     ok = False
 347:                     break
 348:             if not ok:
 349:                 break
 350:         assert ok, "Docked train must fit entirely within its target region"
 351:         for r in range(H1):
 352:             for c in range(W1):
 353:                 v = int(tbbox[r, c])
 354:                 if v != bg and v != 9:
 355:                     out[r + off_r, c + off_c] = v
 356:     return out
 357: 
 358: # --------------- generator (att2) ---------------
 359: 
 360: # ── Tunable constants ────────────────────────────────────────────────
 361: # Canvas / grid sizing
 362: GRID_H_RANGE = (13, 31)          # min/max+1 grid height
 363: GRID_W_RANGE = (16, 29)          # min/max+1 grid width
 364: GRID_MIN_AREA = 300              # minimum total cells
 365: MIN_REGION_DIM = 10              # each region >=10 in both dims
 366: MIN_REGION_DIRS = 3              # minimum boundary-stripe count per region
 367: INTERNAL_STRIPE_THICK = 2        # thickness of the internal divider
 368: 
 369: # Edge stripes
 370: STRIPE_THICK_RANGE = (2, 4)      # each edge stripe thickness
 371: 
 372: # Internal-stripe probability
 373: INTERNAL_PROB = 0.62
 374: 
 375: # Train / station counts
 376: TRAIN_COUNTS = [2, 3]            # possible number of trains per grid
 377: STATION_SIZES = [1, 2, 4]        # possible station sizes (1x1, 1x2, 2x2)
 378: 
 379: # Docked-patch body constraints
 380: BODY_MIN = 5                     # minimum 8-cells in train body
 381: BODY_MAX = 20                    # maximum 8-cells in train body
 382: PATCH_H_RANGE = (4, 9)           # docked patch bbox height limits
 383: PATCH_W_RANGE = (3, 8)           # docked patch bbox width limits
 384: 
 385: # Marker placement
 386: MARKER_DIST_RANGE = (2, 3)       # distance from coupler bbox to marker cell
 387: MARKER_JITTER = [-1, 0, 1]       # lateral jitter for marker position
 388: THREE_MARKER_PROB = 0.65          # probability of using 3 markers (vs 2)
 389: 
 390: # Growth / pathfinding
 391: BODY_GROWTH_ITERS = 160          # max iterations for body cell growth
 392: PATH_BOUNDS_PAD = 4              # padding around seed bbox for BFS bounds
 393: 
 394: # Retry budgets
 395: LAYOUT_RETRIES = 200             # attempts to find a valid layout
 396: DOCK_RETRIES = 20                # attempts per train to build+place a docked patch
 397: GENERATE_RETRIES = 300           # outer generate_input loop budget
 398: 
 399: # Color pool (excludes 8=train body, 9=coupler/station)
 400: COLOR_POOL = list(range(8))
 401: 
 402: # ── Constants ────────────────────────────────────────────────────────
 403: OPS = [(False, 0), (False, 1), (False, 2), (False, 3),
 404:        (True, 0), (True, 1), (True, 2), (True, 3)]
 405: DIRS4 = [(-1, 0), (0, 1), (1, 0), (0, -1)]
 406: 
 407: 
 408: # ── Primitives ───────────────────────────────────────────────────────
 409: 
 410: def _apply_transform(arr, flip_ud=False, rot_k=0):
 411:     out = np.flipud(arr) if flip_ud else arr
 412:     return np.rot90(out, int(rot_k))
 413: 
 414: 
 415: def _inverse_patch(patch, op):
 416:     """Find the pre-image of *patch* under *op* (brute-force over 8 ops)."""
 417:     for inv in OPS:
 418:         cand = _apply_transform(patch, *inv)
 419:         if np.array_equal(_apply_transform(cand, *op), patch):
 420:             return cand
 421:     raise ValueError("no inverse transform")
 422: 
 423: 
 424: def _valid_ops_for_patch(patch):
 425:     """Return ops whose inverse keeps patch within bbox size limits."""
 426:     hlo, hhi = PATCH_H_RANGE
 427:     wlo, whi = PATCH_W_RANGE
 428:     valid = []
 429:     for op in OPS:
 430:         h, w = _inverse_patch(patch, op).shape
 431:         if hlo <= h <= hhi and wlo <= w <= whi:
 432:             valid.append(op)
 433:     return valid
 434: 
 435: 
 436: def _bbox(coords):
 437:     rs = [r for r, _ in coords]
 438:     cs = [c for _, c in coords]
 439:     return min(rs), min(cs), max(rs), max(cs)
 440: 
 441: 
 442: def _dims(coords):
 443:     r0, c0, r1, c1 = _bbox(coords)
 444:     return r1 - r0 + 1, c1 - c0 + 1
 445: 
 446: 
 447: def _adjacent8(p, cells):
 448:     r, c = p
 449:     return any(abs(r - rr) <= 1 and abs(c - cc) <= 1 for rr, cc in cells)
 450: 
 451: 
 452: def _dilate(mask):
 453:     """8-connected dilation via numpy shifts."""
 454:     out = mask.copy()
 455:     out[1:, :] |= mask[:-1, :]
 456:     out[:-1, :] |= mask[1:, :]
 457:     out[:, 1:] |= mask[:, :-1]
 458:     out[:, :-1] |= mask[:, 1:]
 459:     out[1:, 1:] |= mask[:-1, :-1]
 460:     out[:-1, 1:] |= mask[1:, :-1]
 461:     out[1:, :-1] |= mask[:-1, 1:]
 462:     out[:-1, :-1] |= mask[1:, 1:]
 463:     return out
 464: 
 465: 
 466: def _path_to(body, goal, blocked, bounds):
 467:     """BFS from *body* to *goal*, adding the path into *body* (mutates)."""
 468:     if goal in body:
 469:         return True
 470:     r0, r1, c0, c1 = bounds
 471:     q = deque(body)
 472:     prev = {p: None for p in body}
 473:     dirs = DIRS4[:]
 474:     random.shuffle(dirs)
 475:     while q:
 476:         r, c = q.popleft()
 477:         for dr, dc in dirs:
 478:             p = (r + dr, c + dc)
 479:             if p in prev or p in blocked:
 480:                 continue
 481:             if not (r0 <= p[0] <= r1 and c0 <= p[1] <= c1):
 482:                 continue
 483:             prev[p] = (r, c)
 484:             if p == goal:
 485:                 cur = p
 486:                 while cur is not None:
 487:                     body.add(cur)
 488:                     cur = prev[cur]
 489:                 return True
 490:             q.append(p)
 491:     return False
 492: 
 493: 
 494: # ── Layout construction ──────────────────────────────────────────────
 495: 
 496: def _assign_region_dirs(regions, edge_col, top, bottom, left, right, H, W, internal):
 497:     """Populate each region's 'dirs' mapping (stripe_color -> direction)."""
 498:     for reg in regions:
 499:         dirs = {}
 500:         if top and reg["r0"] == top:
 501:             dirs[edge_col["top"]] = 0
 502:         if bottom and reg["r1"] == H - bottom - 1:
 503:             dirs[edge_col["bottom"]] = 2
 504:         if left and reg["c0"] == left:
 505:             dirs[edge_col["left"]] = 3
 506:         if right and reg["c1"] == W - right - 1:
 507:             dirs[edge_col["right"]] = 1
 508:         if internal:
 509:             kind, pos, col = internal
 510:             if kind == "v":
 511:                 dirs[col] = 1 if reg["c1"] == pos - 1 else 3
 512:             else:
 513:                 dirs[col] = 2 if reg["r1"] == pos - 1 else 0
 514:         reg["dirs"] = dirs
 515:         rh = reg["r1"] - reg["r0"] + 1
 516:         rw = reg["c1"] - reg["c0"] + 1
 517:         if rh < MIN_REGION_DIM or rw < MIN_REGION_DIM or len(dirs) < MIN_REGION_DIRS:
 518:             return False
 519:     return True
 520: 
 521: 
 522: def _layout():
 523:     """Build the background grid with edge/internal stripes and rectangular regions."""
 524:     for _ in range(LAYOUT_RETRIES):
 525:         use_internal = random.random() < INTERNAL_PROB
 526:         if use_internal:
 527:             orient = random.choice(["v", "h"])
 528:             if orient == "v":
 529:                 edges = ["left", "right", random.choice(["top", "bottom"])]
 530:             else:
 531:                 edges = ["top", "bottom", random.choice(["left", "right"])]
 532:         else:
 533:             orient = None
 534:             edges = random.sample(["top", "bottom", "left", "right"], random.choice([3, 4]))
 535: 
 536:         thick = {e: random.randint(*STRIPE_THICK_RANGE) for e in edges}
 537:         top, bottom = thick.get("top", 0), thick.get("bottom", 0)
 538:         left, right = thick.get("left", 0), thick.get("right", 0)
 539: 
 540:         # Min inner dimension needed for internal stripes (2 regions of >=10 + 2-thick divider)
 541:         min_inner_for_split = MIN_REGION_DIM * 2 + INTERNAL_STRIPE_THICK
 542:         candidates = []
 543:         for H in range(*GRID_H_RANGE):
 544:             for W in range(*GRID_W_RANGE):
 545:                 if H * W < GRID_MIN_AREA:
 546:                     continue
 547:                 ih, iw = H - top - bottom, W - left - right
 548:                 if ih < MIN_REGION_DIM or iw < MIN_REGION_DIM:
 549:                     continue
 550:                 if orient == "v" and iw < min_inner_for_split:
 551:                     continue
 552:                 if orient == "h" and ih < min_inner_for_split:
 553:                     continue
 554:                 candidates.append((H, W))
 555:         if not candidates:
 556:             continue
 557: 
 558:         H, W = random.choice(candidates)
 559:         pool = COLOR_POOL[:]
 560:         bg = random.choice(pool)
 561:         pool.remove(bg)
 562:         stripe_cols = random.sample(pool, len(edges) + int(use_internal))
 563:         edge_col = dict(zip(edges, stripe_cols[:len(edges)]))
 564:         internal_col = stripe_cols[-1] if use_internal else None
 565:         grid = np.full((H, W), bg, dtype=int)
 566: 
 567:         if top:    grid[:top, :] = edge_col["top"]
 568:         if bottom: grid[H - bottom:, :] = edge_col["bottom"]
 569:         if left:   grid[top:H - bottom, :left] = edge_col["left"]
 570:         if right:  grid[top:H - bottom, W - right:] = edge_col["right"]
 571: 
 572:         inner = {"r0": top, "r1": H - bottom - 1, "c0": left, "c1": W - right - 1}
 573:         regions, internal = [], None
 574:         if orient == "v":
 575:             lo, hi = left + MIN_REGION_DIM, W - right - MIN_REGION_DIM - INTERNAL_STRIPE_THICK
 576:             if lo > hi:
 577:                 continue
 578:             c = random.randint(lo, hi)
 579:             grid[top:H - bottom, c:c + INTERNAL_STRIPE_THICK] = internal_col
 580:             internal = ("v", c, internal_col)
 581:             regions = [
 582:                 {"r0": top, "r1": H - bottom - 1, "c0": left, "c1": c - 1},
 583:                 {"r0": top, "r1": H - bottom - 1, "c0": c + INTERNAL_STRIPE_THICK, "c1": W - right - 1},
 584:             ]
 585:         elif orient == "h":
 586:             lo, hi = top + MIN_REGION_DIM, H - bottom - MIN_REGION_DIM - INTERNAL_STRIPE_THICK
 587:             if lo > hi:
 588:                 continue
 589:             r = random.randint(lo, hi)
 590:             grid[r:r + INTERNAL_STRIPE_THICK, left:W - right] = internal_col
 591:             internal = ("h", r, internal_col)
 592:             regions = [
 593:                 {"r0": top, "r1": r - 1, "c0": left, "c1": W - right - 1},
 594:                 {"r0": r + INTERNAL_STRIPE_THICK, "r1": H - bottom - 1, "c0": left, "c1": W - right - 1},
 595:             ]
 596:         else:
 597:             regions = [inner]
 598: 
 599:         if _assign_region_dirs(regions, edge_col, top, bottom, left, right, H, W, internal):
 600:             return grid, bg, regions
 601:     return None
 602: 
 603: 
 604: # ── Station / coupler shapes ─────────────────────────────────────────
 605: 
 606: def _station_shape(size):
 607:     if size == 1:
 608:         return {(0, 0)}
 609:     if size == 2:
 610:         return {(0, 0), (0, 1)} if random.random() < 0.5 else {(0, 0), (1, 0)}
 611:     return {(0, 0), (0, 1), (1, 0), (1, 1)}
 612: 
 613: 
 614: # ── Marker selection and placement ───────────────────────────────────
 615: 
 616: def _marker_specs(dirs):
 617:     """Choose 2-3 (color, direction) marker specs from region boundary dirs."""
 618:     items = list(dirs.items())
 619:     if len(items) >= 3 and random.random() < THREE_MARKER_PROB:
 620:         return random.sample(items, 3)
 621:     pairs = []
 622:     for i, a in enumerate(items):
 623:         for b in items[i + 1:]:
 624:             if (a[1] - b[1]) % 4 in (1, 3):
 625:                 pairs.append((a, b))
 626:     return list(random.choice(pairs)) if pairs else random.sample(items, 2)
 627: 
 628: 
 629: def _marker_cell(couplers, direction):
 630:     """Pick a marker cell position at a random offset from the coupler bbox in *direction*."""
 631:     r0, c0, r1, c1 = _bbox(couplers)
 632:     d = random.randint(*MARKER_DIST_RANGE)
 633:     jitter = random.choice(MARKER_JITTER)
 634:     if direction == 0:
 635:         return (r0 - d, random.randint(c0, c1) + jitter)
 636:     if direction == 2:
 637:         return (r1 + d, random.randint(c0, c1) + jitter)
 638:     if direction == 3:
 639:         return (random.randint(r0, r1) + jitter, c0 - d)
 640:     return (random.randint(r0, r1) + jitter, c1 + d)
 641: 
 642: 
 643: def _inward_cell(marker, direction):
 644:     """Return the cell one step inward from *marker* (toward coupler center)."""
 645:     dr, dc = DIRS4[(direction + 2) % 4]
 646:     return marker[0] + dr, marker[1] + dc
 647: 
 648: 
 649: # ── Docked-patch construction ────────────────────────────────────────
 650: 
 651: def _connect_couplers_to_body(couplers, body, blocked, bounds):
 652:     """Ensure every coupler is 8-adjacent to the body via BFS paths."""
 653:     for cp in couplers:
 654:         if _adjacent8(cp, body):
 655:             continue
 656:         cr, cc = cp
 657:         choices = [(cr + dr, cc + dc)
 658:                    for dr in (-1, 0, 1) for dc in (-1, 0, 1)
 659:                    if (dr or dc) and (cr + dr, cc + dc) not in blocked]
 660:         random.shuffle(choices)
 661:         for q in choices:
 662:             if _path_to(body, q, blocked, bounds):
 663:                 break
 664:         else:
 665:             return False
 666:     return True
 667: 
 668: 
 669: def _grow_body(body, blocked, target):
 670:     """Grow *body* toward *target* cells while respecting bbox limits."""
 671:     for _ in range(BODY_GROWTH_ITERS):
 672:         all_cells = body | blocked
 673:         h, w = _dims(all_cells)
 674:         if len(body) >= target and h >= PATCH_H_RANGE[0] and w >= PATCH_W_RANGE[0]:
 675:             break
 676:         cands = []
 677:         for r, c in body:
 678:             for dr, dc in DIRS4:
 679:                 q = (r + dr, c + dc)
 680:                 if q in body or q in blocked:
 681:                     continue
 682:                 nh, nw = _dims(all_cells | {q})
 683:                 if nh <= PATCH_H_RANGE[1] and nw <= PATCH_W_RANGE[1]:
 684:                     cands.append(q)
 685:         if not cands or len(body) >= BODY_MAX:
 686:             break
 687:         # Prefer expansion toward undersized dimension
 688:         h, w = _dims(all_cells)
 689:         if h < PATCH_H_RANGE[0]:
