 112: def _chain_red_distributions(n_blue, n_red):
 113:     """Return all red-count allocations across blue-started chains."""
 114:     return [c for c in itertools.product(range(MAX_CHAIN_RED_PER_BLUE + 1), repeat=n_blue) if sum(c) == n_red]
 115: 
 116: 
 117: def _bounded_tuples(values, n, max_sum):
 118:     """Return ordered n-tuples from values whose sum fits the width budget."""
 119:     return [t for t in itertools.product(values, repeat=n) if sum(t) <= max_sum]
 120: 
 121: 
 122: def _sample_groups():
 123:     """Sample row count and bar groups before physical layout."""
 124:     rows = random.randint(MIN_ROWS, MAX_ROWS)
 125:     max_height = min(MAX_BAR_HEIGHT, rows)
 126:     n_blue = random.randint(MIN_BLUE_BARS, MAX_BLUE_BARS)
 127:     max_red = min(MAX_RED_BARS, MAX_TOTAL_BARS - n_blue, MAX_CHAIN_RED_PER_BLUE * n_blue + MAX_UNCHAINED_RED)
 128:     red_total = random.randint(MIN_RED_BARS, max_red)
 129:     min_unchained = max(0, red_total - MAX_CHAIN_RED_PER_BLUE * n_blue)
 130:     max_unchained = min(MAX_UNCHAINED_RED, red_total)
 131:     n_unchained = random.randint(min_unchained, max_unchained)
 132: 
 133:     distributions = _chain_red_distributions(n_blue, red_total - n_unchained)
 134:     if not distributions:
 135:         return None
 136: 
 137:     groups = [
 138:         {"kind": "chain", "colors": [MARKER_COLOR] + [BODY_COLOR] * n_red}
 139:         for n_red in random.choice(distributions)
 140:     ]
 141:     groups.extend({"kind": "unchained", "colors": [BODY_COLOR]} for _ in range(n_unchained))
 142:     random.shuffle(groups)
 143:     if groups[0]["kind"] == "unchained":
 144:         for i, group in enumerate(groups):
 145:             if group["kind"] == "chain":
 146:                 groups[0], groups[i] = groups[i], groups[0]
 147:                 break
 148:     return rows, max_height, groups
 149: 
 150: 
 151: def _sample_layout(max_height, groups):
 152:     """Sample gaps, heights, margins, and positioned bar columns."""
 153:     n_bars = sum(len(group["colors"]) for group in groups)
 154:     right_margin = random.randint(0, MAX_RIGHT_MARGIN)
 155: 
 156:     gap_count = len(groups) - 1
 157:     if gap_count:
 158:         max_gap_sum = MAX_WIDTH - right_margin - MIN_BAR_HEIGHT * n_bars
 159:         gap_options = _bounded_tuples(GAP_VALUES, gap_count, max_gap_sum)
 160:         if not gap_options:
 161:             return None
 162:         gaps = list(random.choice(gap_options))
 163:     else:
 164:         gaps = []
 165: 
 166:     height_options = _bounded_tuples(
 167:         tuple(range(MIN_BAR_HEIGHT, max_height + 1)),
 168:         n_bars,
 169:         MAX_WIDTH - right_margin - sum(gaps),
 170:     )
 171:     if not height_options:
 172:         return None
 173:     heights = list(random.choice(height_options))
 174: 
 175:     idx = 0
 176:     for group in groups:
 177:         count = len(group["colors"])
 178:         group["heights"] = heights[idx : idx + count]
 179:         idx += count
 180: 
 181:     span = sum(heights) + sum(gaps)
 182:     min_left = max(0, MIN_WIDTH - right_margin - span)
 183:     max_left = MAX_WIDTH - right_margin - span
 184:     if min_left > max_left:
 185:         return None
 186:     if min_left <= min(MAX_RANDOM_LEFT_MARGIN, max_left):
 187:         left_margin = random.randint(min_left, min(MAX_RANDOM_LEFT_MARGIN, max_left))
 188:     else:
 189:         left_margin = min_left
 190: 
 191:     width = left_margin + span + right_margin
 192:     if not (MIN_WIDTH <= width <= MAX_WIDTH):
 193:         return None
 194: 
 195:     bars = []
 196:     col = left_margin
 197:     gap_i = 0
 198:     for group_i, group in enumerate(groups):
 199:         chained = group["kind"] == "chain"
 200:         for color, height in zip(group["colors"], group["heights"]):
 201:             bars.append(
 202:                 {
 203:                     "color": color,
 204:                     "height": height,
 205:                     "col": col,
 206:                     "chained": chained,
 207:                 }
 208:             )
 209:             col += height
 210:         if group_i + 1 < len(groups):
 211:             col += gaps[gap_i]
 212:             gap_i += 1
 213: 
 214:     if col + right_margin != width:
 215:         return None
 216:     return bars, width
 217: 
 218: 
 219: def _render_pair(rows, width, bars):
 220:     """Render the sampled input grid and its expected transformed output."""
 221:     baseline = rows - 1
 222:     inp = np.zeros((rows, width), dtype=int)
 223:     out = np.zeros_like(inp)
 224:     for bar in bars:
 225:         color, height, col = bar["color"], bar["height"], bar["col"]
 226:         vertical = slice(baseline - height + 1, baseline + 1)
 227:         inp[vertical, col] = color
 228:         if bar["chained"]:
 229:             out[baseline, col : col + height] = color
 230:         else:
 231:             out[vertical, col] = color
 232:     return inp, out
 233: 
 234: 
 235: def _passes_oracle(inp, expected):
 236:     """Return whether the solver accepts and matches the rendered output."""
 237:     try:
 238:         actual = main(inp)
 239:     except Exception:
 240:         return False
 241:     return np.array_equal(actual, expected)
 242: 
 243: 
 244: def _gen_attempt():
 245:     sampled = _sample_groups()
 246:     if sampled is None:
 247:         return None
 248:     rows, max_height, groups = sampled
 249: 
 250:     layout = _sample_layout(max_height, groups)
 251:     if layout is None:
 252:         return None
 253:     bars, width = layout
 254: 
 255:     inp, expected = _render_pair(rows, width, bars)
 256:     if not _passes_oracle(inp, expected):
 257:         return None
 258:     return inp
 259: 
 260: 
 261: def generate_input():
 262:     for _ in range(MAX_GENERATION_ATTEMPTS):
 263:         grid = _gen_attempt()
 264:         if grid is not None:
 265:             return grid
 266:     raise RuntimeError("failed to generate a valid 84551f4c input")

