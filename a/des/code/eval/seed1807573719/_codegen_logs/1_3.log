 282: def main(grid: np.ndarray) -> np.ndarray:
 283:     """
 284:     Repaint regions from T-shaped control markers, erase the markers, and optionally rotate based on a color-9 L-marker.
 285: 
 286:     Input structure:
 287:     - The grid is a mosaic of monochrome regions.
 288:     - Color 1 forms T-shaped control markers on region boundaries.
 289:     - Some controls use three singleton color-1 pixels around a colored center; that center is a literal replacement color.
 290:     - An optional 5-cell L-shaped color-9 marker triggers 90-degree rotation of the output.
 291: 
 292:     Rule:
 293:     - For a color-1 T marker, the single stem points at the destination region to repaint.
 294:     - The two diagonal cells behind the stem identify the source region; the destination gets that source region's original color.
 295:     - For a colored-center T marker, the same stem identifies the destination, but the center color is the replacement.
 296:     - All marker cells are filled with the final color of the source-side region.
 297:     - A 5-cell L-shaped color-9 marker controls rotation: ┐ (corner top-right) → CCW 90°, ┌ (corner top-left) → CW 90°.
 298: 
 299:     Key insight:
 300:     - The stem chooses what changes, while the two diagonals behind the stem choose where the marker itself belongs.
 301:     """
 302:     g = np.asarray(grid, dtype=int)
 303:     out = _solve_unrotated(g)
 304:     l9 = _find_l9_orientation(g)
 305:     if l9 == 'top_right':
 306:         return np.rot90(out, 1)
 307:     if l9 == 'top_left':
 308:         return np.rot90(out, 3)
 309:     return out
 310: 
 311: # --------------- generator (l9rot) ---------------
 312: 
 313: # ── Tunable constants ──────────────────────────────────────────────────
 314: # Canvas / region sizing
 315: GRID_SIZE_MAX = 30                          # max rows or cols
 316: MIN_REGION_CELLS = 6                        # per-spec minimum
 317: REGION_SIZE_FACTOR = 2.5                    # min_grid_dim = max(9, n_regions * this)
 318: REGION_COUNTS = [4, 5, 6, 7, 8]            # candidate region counts
 319: REGION_WEIGHTS = [3, 3, 3, 1, 1]           # sampling weights for REGION_COUNTS
 320: 
 321: # Marker counts (spec: 4-8 total, 2-6 normal, 0-2 colored)
 322: MARKER_MIN = 4
 323: MARKER_MAX = 8
 324: NORMAL_MAX = 6
 325: COLORED_MAX = 2
 326: 
 327: # Color pool (all ARC colors except 1, which is reserved for T-marker cells)
 328: COLOR_POOL = [c for c in range(10) if c != 1]
 329: 
 330: # L9 rotation marker
 331: L9_PROBABILITY = 0.5                        # chance of placing a rotation marker
 332: L9_OFFSETS = {                              # 5-cell L offsets keyed by corner orientation
 333:     'top_right': [(0, 0), (0, -1), (0, -2), (1, 0), (2, 0)],
 334:     'top_left':  [(0, 0), (0,  1), (0,  2), (1, 0), (2, 0)],
 335: }
 336: 
 337: # Generation retry budget
 338: SEED_ATTEMPTS = 200                         # tries to place n distinct region seeds
 339: GEN_RETRIES = 300                           # outer generate_input retry budget
 340: 
 341: _DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
 342: 
 343: 
 344: # ── Small geometry helpers ─────────────────────────────────────────────
 345: 
 346: def _get_bar(stem):
 347:     """Return the two bar directions perpendicular to *stem*."""
 348:     if stem[0] == 0:
 349:         return [(-1, 0), (1, 0)]
 350:     return [(0, -1), (0, 1)]
 351: 
 352: 
 353: def _t_cells(center, stem):
 354:     """Return the 4 cells of a T marker: center + stem tip + 2 bar cells."""
 355:     r, c = center
 356:     bar = _get_bar(stem)
 357:     return {(r, c), (r + stem[0], c + stem[1]),
 358:             (r + bar[0][0], c + bar[0][1]), (r + bar[1][0], c + bar[1][1])}
 359: 
 360: 
 361: def _t_branch_cells(center, stem):
 362:     """Return the 3 branch cells (stem tip + 2 bar), excluding the center."""
 363:     r, c = center
 364:     bar = _get_bar(stem)
 365:     return {(r + stem[0], c + stem[1]),
 366:             (r + bar[0][0], c + bar[0][1]),
 367:             (r + bar[1][0], c + bar[1][1])}
 368: 
 369: 
 370: def _t_neighborhood(center, stem):
 371:     """Return cells adjacent to any T cell but not part of the T itself."""
 372:     cells = _t_cells(center, stem)
 373:     neighborhood = set()
 374:     for r, c in cells:
 375:         for dr, dc in _DIRS:
 376:             nb = (r + dr, c + dc)
 377:             if nb not in cells:
 378:                 neighborhood.add(nb)
 379:     return neighborhood
 380: 
 381: 
 382: # ── Region partitioning ────────────────────────────────────────────────
 383: 
 384: def _grow_regions(H: int, W: int, n_regions: int) -> np.ndarray | None:
 385:     """Grow n_regions from random seeds via randomized BFS; returns region-id array or None."""
 386:     region = np.full((H, W), -1, dtype=int)
 387:     seeds = set()
 388:     for _ in range(SEED_ATTEMPTS):
 389:         if len(seeds) >= n_regions:
 390:             break
 391:         seeds.add((random.randint(1, H - 2), random.randint(1, W - 2)))
 392:     if len(seeds) < n_regions:
 393:         return None
 394: 
 395:     frontier = []
 396:     for i, (r, c) in enumerate(list(seeds)):
 397:         region[r, c] = i
 398:         for dr, dc in _DIRS:
 399:             nr, nc = r + dr, c + dc
 400:             if 0 <= nr < H and 0 <= nc < W and region[nr, nc] == -1:
 401:                 frontier.append((nr, nc, i))
 402:     random.shuffle(frontier)
 403: 
 404:     while frontier:
 405:         idx = random.randint(0, len(frontier) - 1)
 406:         r, c, rid = frontier[idx]
 407:         frontier[idx] = frontier[-1]
 408:         frontier.pop()
 409:         if region[r, c] != -1:
 410:             continue
 411:         region[r, c] = rid
 412:         for dr, dc in _DIRS:
 413:             nr, nc = r + dr, c + dc
 414:             if 0 <= nr < H and 0 <= nc < W and region[nr, nc] == -1:
 415:                 frontier.append((nr, nc, rid))
 416: 
 417:     # Validate: each region must be 4-connected and have enough cells
 418:     for rid in range(n_regions):
 419:         mask = region == rid
 420:         if mask.sum() < MIN_REGION_CELLS:
 421:             return None
 422:         _, n = label_mask(mask, connectivity=4)
 423:         if n != 1:
 424:             return None
 425:     return region
 426: 
 427: 
 428: # ── Adjacency discovery ───────────────────────────────────────────────
 429: 
 430: def _find_adjacent_pairs(region: np.ndarray) -> list[tuple[int, int]]:
 431:     """Return all directed (src, dst) pairs between adjacent regions."""
 432:     H, W = region.shape
 433:     # Detect boundaries via horizontal and vertical neighbor differences
 434:     undirected = set()
 435:     for r in range(H):
 436:         for c in range(W):
 437:             for dr, dc in _DIRS:
 438:                 nr, nc = r + dr, c + dc
 439:                 if 0 <= nr < H and 0 <= nc < W:
 440:                     a, b = int(region[r, c]), int(region[nr, nc])
 441:                     if a != b:
 442:                         undirected.add((min(a, b), max(a, b)))
 443:     directed = []
 444:     for a, b in undirected:
 445:         directed.append((a, b))
 446:         directed.append((b, a))
 447:     return directed
 448: 
 449: 
 450: # ── Marker count selection ─────────────────────────────────────────────
 451: 
 452: def _choose_marker_counts(n_regions: int) -> tuple[int, int, int] | None:
 453:     """Return (n_markers, n_normal, n_colored) or None if infeasible."""
 454:     max_possible = min(MARKER_MAX, n_regions)
 455:     if max_possible < MARKER_MIN:
 456:         return None
 457:     n_markers = random.randint(MARKER_MIN, max_possible)
 458:     n_colored = random.randint(0, min(COLORED_MAX, n_markers - 2))
 459:     n_normal = n_markers - n_colored
 460:     if n_normal > NORMAL_MAX:
 461:         n_colored = n_markers - NORMAL_MAX
 462:         n_normal = NORMAL_MAX
 463:         if n_colored > COLORED_MAX:
 464:             n_markers = NORMAL_MAX + COLORED_MAX
 465:             n_colored = COLORED_MAX
 466:             n_normal = NORMAL_MAX
 467:     return n_markers, n_normal, n_colored
 468: 
 469: 
 470: # ── Marker placement search ───────────────────────────────────────────
 471: 
 472: def _find_valid_placements(region, src, dst, occupied_cells, occupied_neighbors, H, W):
 473:     """Find all valid (center, stem) for placing a T marker from src toward dst."""
 474:     candidates = []
 475:     for r in range(1, H - 1):
 476:         for c in range(1, W - 1):
 477:             for stem in _DIRS:
 478:                 bar = _get_bar(stem)
 479:                 cells = _t_cells((r, c), stem)
 480:                 if not all(0 <= cr < H and 0 <= cc < W for cr, cc in cells):
 481:                     continue
 482:                 if cells & occupied_cells:
 483:                     continue
 484:                 if _t_neighborhood((r, c), stem) & occupied_cells:
 485:                     continue
 486:                 if cells & occupied_neighbors:
 487:                     continue
 488:                 # Diagonal cells (stem + each bar dir) must lie in source region
 489:                 if not all(
 490:                     0 <= r + stem[0] + bd[0] < H and
 491:                     0 <= c + stem[1] + bd[1] < W and
 492:                     region[r + stem[0] + bd[0], c + stem[1] + bd[1]] == src
 493:                     for bd in bar
 494:                 ):
 495:                     continue
 496:                 # Walk along stem from step=2 until we hit dst or leave bounds
 497:                 step = 2
 498:                 found = False
 499:                 while True:
 500:                     nr, nc = r + stem[0] * step, c + stem[1] * step
 501:                     if not (0 <= nr < H and 0 <= nc < W):
 502:                         break
 503:                     if (nr, nc) in occupied_cells or (nr, nc) in cells:
 504:                         step += 1
 505:                         continue
 506:                     found = int(region[nr, nc]) == dst
 507:                     break
 508:                 if found:
 509:                     candidates.append(((r, c), stem))
 510:     return candidates
 511: 
 512: 
 513: def _register_marker(kind, center, stem, occupied_cells, occupied_neighbors):
 514:     """Update occupied_cells and occupied_neighbors after placing a marker."""
 515:     cells = _t_cells(center, stem)
 516:     if kind == 'normal':
 517:         occupied_cells |= cells
 518:         occupied_neighbors |= (_t_neighborhood(center, stem) - cells)
 519:     else:
 520:         branch = _t_branch_cells(center, stem)
 521:         occupied_cells |= branch
 522:         occupied_cells.add(center)
 523:         # Each branch cell must remain a singleton: buffer all non-marker neighbors
 524:         for br, bc in branch:
 525:             for dr, dc in _DIRS:
 526:                 nb = (br + dr, bc + dc)
 527:                 if nb != center and nb not in branch:
 528:                     occupied_neighbors.add(nb)
 529:         for dr, dc in _DIRS:
 530:             nb = (center[0] + dr, center[1] + dc)
 531:             if nb not in branch:
 532:                 occupied_neighbors.add(nb)
 533: 
 534: 
 535: # ── Grid construction ─────────────────────────────────────────────────
 536: 
 537: def _build_color_map(region: np.ndarray, colors: list[int]) -> np.ndarray:
 538:     """Map region ids to colors via vectorized lookup."""
 539:     lut = np.array(colors, dtype=int)
 540:     return lut[region]
 541: 
 542: 
 543: def _stamp_markers_input(grid, placed_markers):
 544:     """Write T-marker cells onto the input grid."""
 545:     for kind, center, stem, _src, _dst, tc in placed_markers:
 546:         if kind == 'normal':
 547:             for cr, cc in _t_cells(center, stem):
 548:                 grid[cr, cc] = 1
 549:         else:
 550:             grid[center[0], center[1]] = tc
 551:             for cr, cc in _t_branch_cells(center, stem):
 552:                 grid[cr, cc] = 1
 553: 
 554: 
 555: def _stamp_markers_output(grid, placed_markers, out_colors):
 556:     """Fill marker cells in the output grid with the source region's final color."""
 557:     for kind, center, stem, src, _dst, _tc in placed_markers:
 558:         color = out_colors[src]
 559:         for cr, cc in _t_cells(center, stem):
 560:             grid[cr, cc] = color
 561: 
 562: 
 563: # ── L9 rotation marker ────────────────────────────────────────────────
 564: 
 565: def _try_place_l9(region, placed_markers, occupied_neighbors, input_grid, output_grid, out_colors):
 566:     """Attempt to place a 5-cell L9 marker; return orientation string or None."""
 567:     if random.random() >= L9_PROBABILITY:
 568:         return None
 569:     orient = random.choice(list(L9_OFFSETS))
 570:     offsets = L9_OFFSETS[orient]
 571:     H, W = region.shape
 572: 
 573:     all_marker_cells = set()
 574:     for kind, center, stem, *_ in placed_markers:
 575:         all_marker_cells |= _t_cells(center, stem)
 576: 
 577:     candidates = []
 578:     for r in range(H):
 579:         for c in range(W):
 580:             cells = [(r + dr, c + dc) for dr, dc in offsets]
 581:             if not all(0 <= cr < H and 0 <= cc < W for cr, cc in cells):
 582:                 continue
 583:             rid = int(region[r, c])
 584:             if not all(int(region[cr, cc]) == rid for cr, cc in cells):
 585:                 continue
 586:             if any((cr, cc) in all_marker_cells for cr, cc in cells):
 587:                 continue
 588:             if any((cr, cc) in occupied_neighbors for cr, cc in cells):
 589:                 continue
 590:             candidates.append((r, c, rid))
 591: 
 592:     if not candidates:
 593:         return None
 594:     lr, lc, rid = random.choice(candidates)
 595:     for dr, dc in offsets:
 596:         input_grid[lr + dr, lc + dc] = 9
 597:         output_grid[lr + dr, lc + dc] = out_colors[rid]
 598:     return orient
 599: 
 600: 
 601: # ── Main generation attempt ───────────────────────────────────────────
 602: 
 603: def _gen_attempt() -> np.ndarray | None:
 604:     n_regions = random.choices(REGION_COUNTS, weights=REGION_WEIGHTS)[0]
 605:     min_size = max(9, int(n_regions * REGION_SIZE_FACTOR))
 606:     H = random.randint(min_size, GRID_SIZE_MAX)
 607:     W = random.randint(min_size, GRID_SIZE_MAX)
 608: 
 609:     region = _grow_regions(H, W, n_regions)
 610:     if region is None:
 611:         return None
 612: 
 613:     directed_pairs = _find_adjacent_pairs(region)
 614: 
 615:     counts = _choose_marker_counts(n_regions)
 616:     if counts is None:
 617:         return None
 618:     n_markers, n_normal, n_colored = counts
 619: 
 620:     # Select src->dst pairs with unique destinations
 621:     random.shuffle(directed_pairs)
 622:     dest_used = set()
 623:     marker_pairs = []
 624:     for src, dst in directed_pairs:
 625:         if dst not in dest_used:
 626:             marker_pairs.append((src, dst))
 627:             dest_used.add(dst)
 628:             if len(marker_pairs) >= n_markers:
 629:                 break
 630:     if len(marker_pairs) < n_markers:
 631:         n_markers = len(marker_pairs)
 632:         if n_markers < MARKER_MIN:
 633:             return None
 634:         n_colored = min(n_colored, n_markers - 1)
 635:         n_normal = n_markers - n_colored
 636:     random.shuffle(marker_pairs)
 637: 
 638:     # Assign input colors
 639:     pool = list(COLOR_POOL)
 640:     random.shuffle(pool)
 641:     if n_regions > len(pool):
 642:         return None
 643:     input_colors = pool[:n_regions]
 644: 
 645:     # Compute output colors from recoloring rules
 646:     out_colors = list(input_colors)
 647:     normal_pairs = marker_pairs[:n_normal]
 648:     colored_pairs = marker_pairs[n_normal:]
 649: 
 650:     colored_targets = []
 651:     for _src, dst in colored_pairs:
 652:         cands = [c for c in pool if c != input_colors[dst]]
 653:         if not cands:
 654:             return None
 655:         colored_targets.append(random.choice(cands))
 656: 
 657:     for src, dst in normal_pairs:
 658:         out_colors[dst] = input_colors[src]
 659:     for (src, dst), tc in zip(colored_pairs, colored_targets):
 660:         out_colors[dst] = tc
 661: 
 662:     # Build marker definitions and place them
 663:     all_defs = [('normal', s, d, None) for s, d in normal_pairs] + \
 664:                [('colored', s, d, tc) for (s, d), tc in zip(colored_pairs, colored_targets)]
 665:     random.shuffle(all_defs)
 666: 
 667:     occupied_cells: set[tuple[int, int]] = set()
 668:     occupied_neighbors: set[tuple[int, int]] = set()
 669:     placed_markers = []
 670:     for kind, src, dst, tc in all_defs:
 671:         cands = _find_valid_placements(region, src, dst, occupied_cells, occupied_neighbors, H, W)
 672:         if not cands:
 673:             return None
 674:         center, stem = random.choice(cands)
 675:         _register_marker(kind, center, stem, occupied_cells, occupied_neighbors)
 676:         placed_markers.append((kind, center, stem, src, dst, tc))
 677: 
 678:     # Build grids via vectorized lookup
 679:     input_grid = _build_color_map(region, input_colors)
 680:     output_grid = _build_color_map(region, out_colors)
 681: 
 682:     _stamp_markers_input(input_grid, placed_markers)
 683:     _stamp_markers_output(output_grid, placed_markers, out_colors)
 684: 
 685:     # Optional L9 rotation marker
 686:     l9_orient = _try_place_l9(region, placed_markers, occupied_neighbors,
 687:                               input_grid, output_grid, out_colors)
 688:     if l9_orient == 'top_right':
 689:         output_grid = np.rot90(output_grid, 1)
 690:     elif l9_orient == 'top_left':
 691:         output_grid = np.rot90(output_grid, 3)
 692: 
 693:     try:
 694:         result = main(input_grid)
 695:     except Exception:
 696:         return None
 697:     return input_grid if np.array_equal(result, output_grid) else None
 698: 
 699: 
 700: def generate_input() -> np.ndarray:
 701:     for _ in range(GEN_RETRIES):
 702:         result = _gen_attempt()
 703:         if result is not None:
 704:             return result
 705:     raise RuntimeError(f"Failed to generate valid input after {GEN_RETRIES} attempts")

