+
+    pair_count = random.choice(PAIR_COUNTS)
+    size_pool = random.sample(_container_size_pool(), pair_count)
+    locks = _choose_locks(pair_count)
+
+    final_patches: list[np.ndarray] = []
+    containers: list[dict] = []
+    for idx, ((a, b), lock) in enumerate(zip(size_pool, locks)):
+        interior_h, interior_w = (a, b) if random.random() < 0.5 else (b, a)
+        side = random.choice(["top", "bottom", "left", "right"])
+        container = _draw_container(grid, blocked, interior_h, interior_w, lock, side)
+        if container is None:
+            return None
+        container["index"] = idx
+        container["side"] = side
+        container["gap_index"] = random.randint(1, (interior_w if side in ("top", "bottom") else interior_h))
+        # Rebuild the last container using the stored gap index for deterministic expected rendering.
+        r0, c0, r1, c1 = container["outer_bbox"]
+        grid[r0 : r1 + 1, c0 : c1 + 1] = BLACK
+        grid[grid == RED] = grid[grid == RED]
+        container = _draw_container_with_fixed_gap(grid, blocked, container, container["gap_index"])
+        if container is None:
+            return None
+        container["index"] = idx
+        container["side"] = side
+        final_patches.append(_generate_piece_patch(interior_h, interior_w))
+        containers.append(container)
