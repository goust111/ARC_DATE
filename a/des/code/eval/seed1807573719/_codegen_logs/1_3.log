+    used: set[int] = set()
+    assignment: dict[int, int] = {}
+
+    def dfs(k: int) -> bool:
+        if k == len(order):
+            return True
+        pi = order[k]
+        for ci in candidates[pi]:
+            if ci in used:
+                continue
+            used.add(ci)
+            assignment[pi] = ci
+            if dfs(k + 1):
