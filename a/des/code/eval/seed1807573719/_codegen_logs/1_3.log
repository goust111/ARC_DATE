+        marker_cells = [(r1 + k, c0 + gap_index) for k in range(1, lock + 1)]
+    elif side == "left":
+        gap = (r0 + gap_index, c0)
+        marker_cells = [(r0 + gap_index, c0 - k) for k in range(1, lock + 1)]
+    else:
+        gap = (r0 + gap_index, c1)
+        marker_cells = [(r0 + gap_index, c1 + k) for k in range(1, lock + 1)]
