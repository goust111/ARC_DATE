+def _draw_arrow(out: np.ndarray, start_r: int, start_c: int, dr: int, dc: int, color: int) -> None:
+    cells = [(start_r, start_c), (start_r + dr, start_c + dc)]
+    tip_r, tip_c = cells[-1]
