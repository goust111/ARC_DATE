+    rr0 = max(0, int(r0) - pad)
+    cc0 = max(0, int(c0) - pad)
+    rr1 = min(h_all, int(r0) + h + pad)
+    cc1 = min(w_all, int(c0) + w + pad)
+    mask[rr0:rr1, cc0:cc1] = True
