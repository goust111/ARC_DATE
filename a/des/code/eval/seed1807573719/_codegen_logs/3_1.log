+        shape_mask, out_color = pairs.pop()
+        placed = False
+        for _ in range(40):
+            island = _random_variant(shape_mask)
+            patch, gap_rel, direction, _side = _frame_patch(
+                island, bg, frame_color, shape_color, forced_side=forced_side
