+) -> np.ndarray:
+    out = inp.copy()
+    for ray in rays:
+        _paint_ray(inp, out, bg, ray["gap"], ray["dir"], ray["color"])
+    return out
+
+
+def _generate_case() -> tuple[np.ndarray, np.ndarray]:
+    height = random.randint(24, 30)
+    width = random.randint(24, 30)
+
+    colors = list(range(10))
+    random.shuffle(colors)
