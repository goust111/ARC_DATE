+    if corner.startswith("top"):
+        top = inset_r
+    else:
+        top = height - inset_r - total_h
+    if corner.endswith("left"):
+        anchor_c = inset_c
+        align = lambda pw: anchor_c
+    else:
+        anchor_c = width - inset_c - max_w
+        align = lambda pw: anchor_c + max_w - pw
