+            ph, pw = map(int, patch.shape)
+            _paint_patch(grid, patch, r0, c0, bg)
+            non_bg = patch != int(bg)
+            occupied[r0 : r0 + ph, c0 : c0 + pw][non_bg] = True
+            _mark_rect(object_forbidden, r0, c0, ph, pw, pad=1)
+            for rr, cc in ray_cells:
