+        dictionary_mask[r0 : r0 + ph, c0 : c0 + pw][non_bg] = True
+        _mark_rect(object_forbidden, r0, c0, ph, pw, pad=1)
+
+    pairs = list(zip(shapes, output_colors, strict=False))
+    random.shuffle(pairs)
+    rays: list[dict] = []
+
+    if want_blocked:
