+    total_h = sum(int(p.shape[0]) for p in patches) + gap * (len(patches) - 1)
+    max_w = max(int(p.shape[1]) for p in patches)
+    inset_r = random.randint(1, 2)
+    inset_c = random.randint(1, 2)
