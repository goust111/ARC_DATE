+def main(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    objs = _components(g != BG)
+    templates: list[dict] = []
+    fragments: dict[int, dict] = {}
+
+    for coords in objs:
+        template = _classify_template(g, coords)
+        if template is not None:
+            templates.append(template)
