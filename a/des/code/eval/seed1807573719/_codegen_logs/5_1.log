+        mask, _ = _tight_mask(coords)
+        h, w = mask.shape
+        area = int(mask.sum())
+        if h < 2 or w < 2 or h > 5 or w > 5:
+            continue
+        if area == h * w:
+            continue
+        if _has_hole(mask):
+            continue
+        return mask
+    raise RuntimeError("failed to generate piece")
+
