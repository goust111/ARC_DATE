 331: def _get_enclosed_holes(sprite):
 332:     """Return list of point-arrays for bg components not touching sprite boundary."""
 333:     h, w = sprite.shape
 334:     return [pts for pts in components_mask(~sprite, connectivity=4)
 335:             if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]
