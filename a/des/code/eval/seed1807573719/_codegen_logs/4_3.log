+        if not frontier:
+            return mask
+        cell = random.choice(tuple(frontier))
+        frontier.remove(cell)
+        mask[cell] = True
+        for nb in _neighbors4(cell[0], cell[1], height, width):
+            if not mask[nb]:
+                frontier.add(nb)
+    return mask
+
