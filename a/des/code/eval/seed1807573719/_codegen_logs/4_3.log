+    return out
+
+
+def _reserve(occupied: np.ndarray, row: int, col: int, height: int, width: int) -> None:
+    h, w = occupied.shape
+    r0 = max(0, row - 1)
+    c0 = max(0, col - 1)
+    r1 = min(h, row + height + 1)
+    c1 = min(w, col + width + 1)
+    occupied[r0:r1, c0:c1] = True
