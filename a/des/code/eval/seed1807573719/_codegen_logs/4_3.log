+        )
+        patterns.append({"patch": pattern_patch, "label_color": label_colors[idx]})
+
+    objects = []
+    for idx, container in enumerate(containers):
+        objects.append(
+            {
+                "kind": "container",
+                "index": idx,
+                "patch": container["patch"],
+            }
+        )
+    for idx, pattern in enumerate(patterns):
+        objects.append(
