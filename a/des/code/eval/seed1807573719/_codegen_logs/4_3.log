+    if direction in ("up", "down"):
+        interior_h = ph + random.randint(1, 3)
+        interior_w = pw + random.randint(0, 3)
+        shape = (interior_h + 1, interior_w + 2)
+    else:
+        interior_h = ph + random.randint(0, 3)
+        interior_w = pw + random.randint(1, 3)
