+                "kind": "pattern",
+                "index": idx,
+                "patch": pattern["patch"],
+            }
+        )
+    random.shuffle(objects)
+    objects.sort(key=lambda item: item["patch"].shape[0] * item["patch"].shape[1], reverse=True)
