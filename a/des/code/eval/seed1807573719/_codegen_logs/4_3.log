+        return top + ih - ph, left + (iw - pw) // 2
+    if container_direction == "down":
+        return top, left + (iw - pw) // 2
+    if container_direction == "left":
+        return top + (ih - ph) // 2, left + iw - pw
+    return top + (ih - ph) // 2, left
