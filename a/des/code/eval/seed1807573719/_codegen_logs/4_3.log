+    containers = []
+    patterns = []
+    for coords in _components(g != bg):
+        container = _classify_container(g, coords, bg)
+        if container is not None:
+            containers.append(container)
+            continue
+        patch, bbox_ = _component_patch(g, coords, bg)
+        patterns.append(
+            {
+                "bbox": bbox_,
+                "coords": coords,
+                "patch": patch,
