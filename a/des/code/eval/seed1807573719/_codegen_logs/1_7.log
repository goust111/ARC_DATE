+
+def _render_board(region_map: np.ndarray, assignment: list[int], cell_h: int, cell_w: int) -> np.ndarray:
+    rows, cols = region_map.shape
+    height = rows * (cell_h + 1) + 1
+    width = cols * (cell_w + 1) + 1
