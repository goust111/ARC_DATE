+                continue
+            a = int(assignment[rid])
+            b = int(assignment[nid])
+            if a == b:
+                continue
+            pair = tuple(sorted((a, b)))
+            pairs.add(pair)
+            compat[a].add(b)
+            compat[b].add(a)
