+    grid = _compose_input(rng, legend, input_board)
+    if not np.array_equal(main(grid), solved_board):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
