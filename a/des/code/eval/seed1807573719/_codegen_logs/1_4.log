+        cells = _line_cells(node_shapes[a], node_shapes[b], anchors[a], anchors[b])
+        if cells is None or cells.size == 0:
+            return None
+        if np.any(occupancy[cells[:, 0], cells[:, 1]] != BG):
+            return None
+        occupancy[cells[:, 0], cells[:, 1]] = GREY
