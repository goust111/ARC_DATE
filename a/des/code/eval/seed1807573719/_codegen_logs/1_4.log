+    neighbors: dict[int, set[int]] = defaultdict(set)
+    for comp in _components(scene == GREY):
+        rows = np.unique(comp[:, 0])
+        cols = np.unique(comp[:, 1])
+        assert rows.size == 1 or cols.size == 1, "grey connectors must be straight"
+        touched: set[int] = set()
