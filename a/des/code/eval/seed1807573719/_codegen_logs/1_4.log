+    if out.shape != final.shape[:1] + (final.shape[1],):
+        return None
+    if out.shape[0] != final.shape[0] - 2:
+        return None
+    return final
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input after 400 attempts")

