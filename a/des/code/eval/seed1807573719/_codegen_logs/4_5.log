+        for si, shape in enumerate(shapes):
+            distances[ai, si] = _rect_distance(arrow_bbox, shape["bbox"])
+    best_perm = min(
+        itertools.permutations(range(n)),
+        key=lambda perm: sum(int(distances[ai, perm[ai]]) for ai in range(n)),
