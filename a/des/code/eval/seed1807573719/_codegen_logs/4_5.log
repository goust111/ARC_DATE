+            return None
+
+    expected = _build_expected_output(grid, panel_bbox, cases)
+    return grid, expected
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GENERATION_ATTEMPTS):
+        built = _gen_attempt(rng)
+        if built is None:
