+            for picks in itertools.combinations(range(cells), area):
+                mask = np.zeros((h, w), dtype=bool)
+                for idx in picks:
+                    mask[idx // w, idx % w] = True
+                comps = _components(mask, connectivity=4)
+                if len(comps) != 1:
+                    continue
