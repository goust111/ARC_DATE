+                ch, cw = cropped.shape
+                if min(ch, cw) < 2 or max(ch, cw) > 4:
+                    continue
+                if not _has_four_distinct_rotations(cropped):
+                    continue
+                key = _canonical_key(cropped)
+                classes.setdefault(key, cropped.copy())
+    library = [classes[key] for key in sorted(classes)]
+    assert len(library) >= 12
+    return library
