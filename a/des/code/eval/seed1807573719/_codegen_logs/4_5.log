+def _rect_distance(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> int:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    dr = 0 if not (ar1 < br0 or br1 < ar0) else max(br0 - ar1, ar0 - br1)
+    dc = 0 if not (ac1 < bc0 or bc1 < ac0) else max(bc0 - ac1, ac0 - bc1)
