+def _clipped_bbox(
+    top: int, left: int, shape: tuple[int, int], grid_shape: tuple[int, int]
+) -> tuple[int, int, int, int] | None:
+    h, w = shape
+    gh, gw = grid_shape
+    r0 = max(0, top)
+    c0 = max(0, left)
+    r1 = min(gh - 1, top + h - 1)
+    c1 = min(gw - 1, left + w - 1)
+    if r0 > r1 or c0 > c1:
+        return None
+    return (r0, c0, r1, c1)
