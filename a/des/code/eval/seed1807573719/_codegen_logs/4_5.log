+    max_h = max(int(t["mask"].shape[0]) for t in templates)
+    max_w = max(int(t["mask"].shape[1]) for t in templates)
+    cell_h = max_h + _randint(rng, 2, 4)
+    cell_w = max_w + _randint(rng, 2, 4)
