+    for r in range(0, panel_h, cell_h + 1):
+        panel[r, :] = PANEL_COLOR
+    panel[-1, :] = PANEL_COLOR
+    for c in range(0, panel_w, cell_w + 1):
+        panel[:, c] = PANEL_COLOR
+    panel[:, -1] = PANEL_COLOR
