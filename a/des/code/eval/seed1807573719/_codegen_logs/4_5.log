+import itertools
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG_COLOR = 0
+PANEL_COLOR = 5
+ARROW_COLOR = 9
+GENERATION_ATTEMPTS = 300
+GRID_SIDE_RANGE = (24, 33)
+OBJECT_COUNT_CHOICES = (1, 2, 3)
+TEMPLATE_COUNT_CHOICES = (3, 4)
+OBJECT_MARGIN_RANGE = (2, 5)
+PANEL_CORNERS = ("tl", "tr", "bl", "br")
