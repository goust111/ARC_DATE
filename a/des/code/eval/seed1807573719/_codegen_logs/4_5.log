+def _decode_arrow(coords: np.ndarray) -> str:
+    pts = [tuple(map(int, pt)) for pt in coords]
+    for i, j in itertools.combinations(range(3), 2):
+        a = pts[i]
+        b = pts[j]
+        if a[0] == b[0] and abs(a[1] - b[1]) == 1:
+            left, right = sorted([a, b], key=lambda p: p[1])
+            head = pts[3 - i - j]
+            if head[1] == left[1] and abs(head[0] - left[0]) == 1:
+                return "left"
+            if head[1] == right[1] and abs(head[0] - right[0]) == 1:
+                return "right"
+        if a[1] == b[1] and abs(a[0] - b[0]) == 1:
+            top, bottom = sorted([a, b], key=lambda p: p[0])
+            head = pts[3 - i - j]
+            if head[0] == top[0] and abs(head[1] - top[1]) == 1:
+                return "up"
+            if head[0] == bottom[0] and abs(head[1] - bottom[1]) == 1:
