+
+def _separator_spans(lines: list[int], size: int) -> list[tuple[int, int]]:
+    lines = sorted(set(lines))
+    assert lines and lines[0] == 0 and lines[-1] == size - 1
+    spans = []
+    for a, b in zip(lines, lines[1:]):
