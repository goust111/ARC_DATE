+        interior = patch[1:-1, 1:-1]
+        interior_empty = bool(np.all(interior == bg))
+        interior_filled = bool(np.all(interior != bg))
+        if not (interior_empty or interior_filled):
+            continue
+        colors = set(map(int, patch[patch != bg].reshape(-1)))
+        if len(colors) != 2:
+            continue
+        containers.append(
