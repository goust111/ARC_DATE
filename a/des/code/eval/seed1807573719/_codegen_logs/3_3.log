+    for idx in order:
+        h, w = shapes[idx]
+        row_hi = height - h - OUTER_MARGIN
+        col_hi = width - w - OUTER_MARGIN
+        if row_hi < OUTER_MARGIN or col_hi < OUTER_MARGIN:
+            return None
+        placed = False
+        for _ in range(200):
