+def _find_containers(grid: np.ndarray, bg: int) -> list[dict]:
+    containers: list[dict] = []
+    for comp in _components(grid != bg):
+        r0, c0, r1, c1 = _bbox(comp)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 4 or w < 4:
