+    grid[r0 : r0 + h, c0] = border_color
+    grid[r0 : r0 + h, c0 + w - 1] = border_color
+
+    for edge in active_edges:
+        rr, cc = _edge_position(rng, edge, h, w)
+        grid[r0 + rr, c0 + cc] = marker_color
+
