+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+EDGES = ("top", "bottom", "left", "right")
+ACTIVE_EDGE_GROUPS = {
+    ("odd", True): [
+        ("top",),
+        ("left",),
+        ("top", "bottom", "right"),
+        ("left", "bottom", "right"),
+        ("top", "left", "bottom"),
+        ("top", "left", "right"),
+    ],
+    ("odd", False): [
+        ("bottom",),
+        ("right",),
+    ],
+    ("even", True): [
+        ("top", "left"),
+        ("top", "bottom"),
+        ("top", "right"),
+        ("left", "bottom"),
+        ("left", "right"),
+        ("top", "bottom", "left", "right"),
+    ],
+    ("even", False): [
