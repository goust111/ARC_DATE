+ACTIVE_EDGE_GROUPS = {
+    ("odd", True): [
+        ("top",),
+        ("left",),
+        ("top", "bottom", "right"),
+        ("left", "bottom", "right"),
+        ("top", "left", "bottom"),
+        ("top", "left", "right"),
+    ],
+    ("odd", False): [
+        ("bottom",),
+        ("right",),
+    ],
+    ("even", True): [
+        ("top", "left"),
+        ("top", "bottom"),
+        ("top", "right"),
