+    if np.any(patch[-1, 1:-1] == marker):
+        active.append("bottom")
+    if np.any(patch[1:-1, 0] == marker):
+        active.append("left")
+    if np.any(patch[1:-1, -1] == marker):
+        active.append("right")
+    return tuple(active)
+
+
