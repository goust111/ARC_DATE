+            cc1 = min(width, c0 + w + PLACEMENT_PAD)
+            if occupied[rr0:rr1, cc0:cc1].any():
+                continue
+            occupied[rr0:rr1, cc0:cc1] = True
+            positions[idx] = (r0, c0)
+            placed = True
