+        seed_rel = np.argwhere(interior == gap_color)
+        if seed_rel.shape != (1, 2):
+            continue
+        seed = (r0 + 1 + int(seed_rel[0, 0]), c0 + 1 + int(seed_rel[0, 1]))
+
+        if int(np.count_nonzero(g == gap_color)) != 2:
+            continue
+
+        dr, dc = direction
+        if dr != 0 and seed[1] != gap[1]:
+            continue
+        if dc != 0 and seed[0] != gap[0]:
+            continue
