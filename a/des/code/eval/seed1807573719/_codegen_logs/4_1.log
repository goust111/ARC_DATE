+
+def _path_cells(seed: Point, direction: Point, length: int, h: int, w: int) -> List[Point]:
+    dr, dc = direction
+    r, c = seed
+    pts: List[Point] = []
+    for _ in range(length):
+        r += dr
+        c += dc
+        if not (0 <= r < h and 0 <= c < w):
+            break
+        pts.append((r, c))
+    return pts
+
+
