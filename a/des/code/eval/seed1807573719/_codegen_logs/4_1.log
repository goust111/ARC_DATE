+        rr, cc = seed
+        clear = True
+        while True:
+            rr += dr
+            cc += dc
+            if (rr, cc) == gap:
+                break
+            if not (0 <= rr < h and 0 <= cc < w) or int(g[rr, cc]) != bg:
+                clear = False
+                break
+        if not clear:
+            continue
+
+        length = int(np.count_nonzero(interior == bg))
+        if length <= 0:
+            continue
+
+        frames.append(
+            {
+                "frame_color": color,
+                "gap_color": gap_color,
+                "bbox": (r0, c0, r1, c1),
+                "seed": seed,
+                "gap": gap,
+                "direction": direction,
+                "length": length,
+            }
+        )
+        used_gap_colors.add(gap_color)
