+            c0 = rng.randint(c_lo, c_hi)
+            r1 = r0 + outer_h - 1
+            c1 = c0 + outer_w - 1
+            gap = (r0 + gap_offset, c0) if side == "left" else (r0 + gap_offset, c1)
+            seed = (r0 + gap_offset, c0 + seed_offset)
+            direction = (0, -1) if side == "left" else (0, 1)
