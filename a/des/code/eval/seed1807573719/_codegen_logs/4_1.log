+
+
+def _frame_direction(r0: int, c0: int, r1: int, c1: int, gap: Point) -> Point | None:
+    gr, gc = gap
+    if gr == r0 and c0 < gc < c1:
+        return (-1, 0)
+    if gr == r1 and c0 < gc < c1:
+        return (1, 0)
+    if gc == c0 and r0 < gr < r1:
+        return (0, -1)
+    if gc == c1 and r0 < gr < r1:
+        return (0, 1)
+    return None
+
