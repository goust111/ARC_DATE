+            votes[int(arrow["color"])] += 1
+            boundary |= arrow["cells"]
+            boundary.update(segments[int(arrow_id)])
+
+        fill_color = int(votes.most_common(1)[0][0])
+        for r, c in _interior_cells(boundary):
