+    shift_c = -min_c
+    height = max_r - min_r + 1
+    width = max_c - min_c + 1
+
+    arrows: list[dict] = []
+    segments: list[list[tuple[int, int]]] = []
+    shifted_boundary: set[tuple[int, int]] = set()
+    for raw_arrow, raw_segment in zip(raw_arrows, raw_segments):
