+# --------------- generator helpers ---------------
+
+GRID_H_RANGE = (22, 36)
+GRID_W_RANGE = (22, 36)
+LOOP_COUNT_CHOICES = (1, 2, 3)
+SHAPE_TYPES = ("rect", "l")
+RECT_SIDE_RANGE = (6, 12)
+L_ARM_RANGE = (5, 9)
+PLACE_RETRIES = 160
+GEN_RETRIES = 400
