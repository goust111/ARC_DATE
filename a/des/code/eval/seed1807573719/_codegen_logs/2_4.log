+
+def _assign_arrow_colors(n: int, bg: int) -> tuple[list[int], int]:
+    available = [color for color in PALETTE if color != bg]
+    majority_color = random.choice(available)
+    majority_count = random.randint(n // 2 + 1, n - 1)
