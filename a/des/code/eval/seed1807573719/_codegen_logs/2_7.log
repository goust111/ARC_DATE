+        seen[r, c] = True
+        coords = []
+        while stack:
+            cr, cc = stack.pop()
+            coords.append((int(cr), int(cc)))
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                nr = int(cr + dr)
+                nc = int(cc + dc)
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
