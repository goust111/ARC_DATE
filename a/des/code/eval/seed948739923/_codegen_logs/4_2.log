+        for _ in range(PLACE_TRIES):
+            r0 = random.randint(CHAIN_MARGIN, grid_h - CHAIN_MARGIN - ph)
+            c0 = random.randint(CHAIN_MARGIN, grid_w - CHAIN_MARGIN - pw)
