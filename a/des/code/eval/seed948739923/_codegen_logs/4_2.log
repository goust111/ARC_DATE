+def _rects_clear(
+    rect_a: tuple[int, int, int, int], rect_b: tuple[int, int, int, int], gap: int
+) -> bool:
+    ar0, ac0, ar1, ac1 = rect_a
+    br0, bc0, br1, bc1 = rect_b
+    return ar1 + gap < br0 or br1 + gap < ar0 or ac1 + gap < bc0 or bc1 + gap < ac0
