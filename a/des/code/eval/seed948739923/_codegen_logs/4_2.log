+    return frames
+
+
+def _build_tree(frames: list[dict]) -> tuple[list[int | None], list[list[int]], list[int]]:
+    n = len(frames)
+    parents: list[int | None] = [None] * n
+    children: list[list[int]] = [[] for _ in range(n)]
+
+    for i in range(n):
+        bbox_i = frames[i]["bbox"]
+        container = None
+        container_area = None
+        for j in range(n):
+            if i == j:
