+
+    out = inp.copy()
+    for idx, (bbox, color) in enumerate(zip(boxes, frame_colors, strict=True), start=1):
+        r0, c0, r1, c1 = bbox
+        annulus = np.zeros_like(out, dtype=bool)
+        annulus[r0 + 1 : r1, c0 + 1 : c1] = True
+        if idx < len(boxes):
+            cr0, cc0, cr1, cc1 = boxes[idx]
+            annulus[cr0 : cr1 + 1, cc0 : cc1 + 1] = False
