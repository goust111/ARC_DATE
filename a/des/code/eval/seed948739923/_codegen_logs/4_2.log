+def _shift_boxes(
+    boxes: list[tuple[int, int, int, int]], dr: int, dc: int
+) -> list[tuple[int, int, int, int]]:
+    return [(r0 + dr, c0 + dc, r1 + dr, c1 + dc) for r0, c0, r1, c1 in boxes]
