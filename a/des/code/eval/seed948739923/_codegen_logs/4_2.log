+            if set(pts) != boundary:
+                continue
+            frames.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "area": (r1 - r0 + 1) * (c1 - c0 + 1),
+                }
+            )
