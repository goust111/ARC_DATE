+            r0, c0, r1, c1 = _bbox(pts)
+            if r1 - r0 < 2 or c1 - c0 < 2:
+                continue
+            boundary = _rect_boundary(r0, c0, r1, c1)
+            if set(pts) != boundary:
+                continue
+            frames.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "area": (r1 - r0 + 1) * (c1 - c0 + 1),
