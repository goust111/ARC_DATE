+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _rect_boundary(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    pts: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        pts.add((r0, c))
+        pts.add((r1, c))
+    for r in range(r0 + 1, r1):
+        pts.add((r, c0))
+        pts.add((r, c1))
+    return pts
+
+
+def _draw_frame(grid: np.ndarray, bbox: tuple[int, int, int, int], color: int) -> None:
+    r0, c0, r1, c1 = bbox
+    grid[r0, c0 : c1 + 1] = color
+    grid[r1, c0 : c1 + 1] = color
+    grid[r0 : r1 + 1, c0] = color
+    grid[r0 : r1 + 1, c1] = color
+
+
+def _rect_contains(
+    outer: tuple[int, int, int, int], inner: tuple[int, int, int, int]
+) -> bool:
+    or0, oc0, or1, oc1 = outer
+    ir0, ic0, ir1, ic1 = inner
+    return or0 < ir0 and oc0 < ic0 and ir1 < or1 and ic1 < oc1
+
+
+def _find_frames(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    frames: list[dict] = []
+    for color0 in np.unique(g):
+        color = int(color0)
+        if color == BLACK:
+            continue
+        for pts in _components(g == color):
+            r0, c0, r1, c1 = _bbox(pts)
+            if r1 - r0 < 2 or c1 - c0 < 2:
+                continue
+            boundary = _rect_boundary(r0, c0, r1, c1)
+            if set(pts) != boundary:
+                continue
