+            c0 = random.randint(CHAIN_MARGIN, grid_w - CHAIN_MARGIN - pw)
+            rect = (r0, c0, r0 + ph - 1, c0 + pw - 1)
+            if all(_rects_clear(rect, other, CHAIN_GAP) for other in placed_rects):
