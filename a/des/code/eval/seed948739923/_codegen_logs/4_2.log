+        if not children[idx]:
+            propagated[idx] = leaf_seed[idx]
+            return propagated[idx]
+        colors = {resolve_seed(child) for child in children[idx]}
+        assert len(colors) == 1, "even-depth fill is ambiguous without a unique subtree seed color"
