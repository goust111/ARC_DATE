+
+def _rect_boundary(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    pts: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        pts.add((r0, c))
+        pts.add((r1, c))
+    for r in range(r0 + 1, r1):
+        pts.add((r, c0))
+        pts.add((r, c1))
+    return pts
