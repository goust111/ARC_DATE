+def _marker_side(marker_rc: tuple[int, int], shape: tuple[int, int]) -> str:
+    r, c = marker_rc
+    h, w = shape
+    if r == 0:
+        return "top"
+    if c == w - 1:
+        return "right"
+    if r == h - 1:
+        return "bottom"
+    if c == 0:
+        return "left"
