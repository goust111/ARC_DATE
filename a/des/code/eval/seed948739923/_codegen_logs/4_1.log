+        gr0 = sep + 1 + r0
+        gc0 = c0
+        out[gr0 + 1 : gr0 + h - 1, gc0 + 1 : gc0 + w - 1] = fill
+        mr, mc = map(int, marker_locs[0])
+        out[gr0 + mr, gc0 + mc] = border_color
