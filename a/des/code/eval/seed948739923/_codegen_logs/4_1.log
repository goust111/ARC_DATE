+            raise AssertionError("missing marker")
+        out[row, col] = border_color
+    elif side == "right":
+        col = left + box_w - 1
+        row = None
+        for r in range(top + 1, top + box_h - 1):
+            if out[r, col] == MAGENTA:
+                row = r
+                break
+        if row is None:
+            raise AssertionError("missing marker")
+        out[row, col] = border_color
+    elif side == "bottom":
+        row = top + box_h - 1
+        col = None
+        for c in range(left + 1, left + box_w - 1):
