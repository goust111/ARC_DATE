+    ordered = sorted(objects, key=lambda obj: _object_sort_key(obj, dr, dc))
+    placed: list[list[tuple[int, int, int]]] = []
+    occupied: set[tuple[int, int]] = set()
+    moved = False
+
+    for obj in ordered:
+        step = 0
+        while True:
+            next_cells = []
+            ok = True
+            for r, c, color in obj:
