+    placed: list[list[tuple[int, int, int]]] = []
+    occupied: set[tuple[int, int]] = set()
+    moved = False
+
+    for obj in ordered:
+        step = 0
+        while True:
+            next_cells = []
+            ok = True
+            for r, c, color in obj:
+                rr = r + dr * (step + 1)
+                cc = c + dc * (step + 1)
+                if rr < top or rr > bottom or cc < left or cc > right or (rr, cc) in occupied:
