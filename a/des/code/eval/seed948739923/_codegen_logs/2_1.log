+            return None
+        gaps_by_side[side] = pts[0]
+
+    border_color = Counter(int(grid[r, c]) for r, c in comp).most_common(1)[0][0]
+
+    def marker_color_for(side: str):
+        gr, gc = gaps_by_side[side]
+        if side == "top":
