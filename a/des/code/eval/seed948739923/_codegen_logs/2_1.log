+def _object_sort_key(obj, dr: int, dc: int):
+    rows = [r for r, _, _ in obj]
+    cols = [c for _, c, _ in obj]
+    if dr == -1:
+        return min(rows), min(cols)
+    if dr == 1:
+        return -max(rows), min(cols)
+    if dc == -1:
+        return min(cols), min(rows)
+    return -max(cols), min(rows)
