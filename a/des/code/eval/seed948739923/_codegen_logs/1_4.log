+                                            "gap": gap2,
+                                            "target": target2,
+                                        },
+                                    ],
+                                }
+    return None
+
+
+def _random_extra_seed(
+    room: dict[str, int],
+    seed_count: int,
+) -> list[tuple[int, int]] | None:
+    placements = _candidate_placements(room, seed_count)
+    if not placements:
+        return None
+    cells, _bbox_value = random.choice(placements)
+    return cells
