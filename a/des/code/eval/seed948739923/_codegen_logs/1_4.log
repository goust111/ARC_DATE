+) -> dict[tuple[tuple[int, int], str], list[tuple[int, int, tuple[int, int]]]]:
+    gaps: dict[tuple[tuple[int, int], str], list[tuple[int, int, tuple[int, int]]]] = {}
+    for room_idx, room in rooms.items():
+        ri, ci = room_idx
+
+        key = (room_idx, "top")
+        gaps[key] = []
+        if ri > 0:
+            target = (ri - 1, ci)
