+def _priority_is_better(
+    depth: int,
+    total_layers: int,
+    source_order: int,
+    best_depth: np.ndarray,
+    best_total: np.ndarray,
+    best_order: np.ndarray,
+    r: int,
+    c: int,
+) -> bool:
+    current = (int(best_depth[r, c]), int(best_total[r, c]), int(best_order[r, c]))
+    return (depth, total_layers, source_order) > current
