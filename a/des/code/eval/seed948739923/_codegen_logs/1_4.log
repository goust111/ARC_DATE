+                            random.shuffle(gap2_choices)
+                            for gap2 in gap2_choices:
+                                target2 = _neighbor(room1_idx, side2, n_room_rows, n_room_cols)
+                                if target2 is None:
+                                    continue
+                                return {
+                                    "source": room_idx,
+                                    "cells": cells,
+                                    "bbox": bbox,
+                                    "seed_count": seed_count,
