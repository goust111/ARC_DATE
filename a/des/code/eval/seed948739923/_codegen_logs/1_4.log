+                    gaps[key].append((room["top_wall"], c, target))
+
+        key = (room_idx, "bottom")
+        gaps[key] = []
+        if ri + 1 < n_room_rows:
+            target = (ri + 1, ci)
+            for c in range(room["c0"], room["c1"] + 1):
