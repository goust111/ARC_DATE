+def _candidate_placements(room: dict[str, int], seed_count: int) -> list[tuple[list[tuple[int, int]], tuple[int, int, int, int]]]:
+    placements: list[tuple[list[tuple[int, int]], tuple[int, int, int, int]]] = []
