+
+def _distance_to_side(room: dict[str, int], bbox: tuple[int, int, int, int], side: str) -> int:
+    r0, c0, r1, c1 = bbox
+    if side == "top":
+        return r0 - room["top_wall"]
+    if side == "bottom":
+        return room["bottom_wall"] - r1
+    if side == "left":
+        return c0 - room["left_wall"]
+    return room["right_wall"] - c1
