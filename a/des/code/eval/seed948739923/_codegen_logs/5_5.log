+
+    input_colors = {int(region["color"]) for region in _region_data(map_patch, np.zeros_like(map_patch, dtype=bool))}
+    panel, mapping = _build_panel(sig_to_colors, input_colors, rng)
+    scene = _compose_scene(map_patch, panel, rng)
