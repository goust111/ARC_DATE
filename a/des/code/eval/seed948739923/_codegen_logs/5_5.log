+        return None
+    if not (2 <= len(sig_to_colors) <= 3):
+        return None
+    if any(len(sig) == 0 or len(sig) > 3 for sig in sig_to_colors):
+        return None
+    if not any(len(colors) >= 2 for colors in sig_to_colors.values()):
