+import random
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GEN_RETRIES = 300
+
+
+def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _mask_components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _color_components(grid: np.ndarray, blocked: np.ndarray | None = None) -> list[dict]:
+    h, w = grid.shape
+    if blocked is None:
+        blocked = np.zeros((h, w), dtype=bool)
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if seen[r, c] or blocked[r, c] or color in (BG, GREY):
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            cells: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = cr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or blocked[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            comps.append({"color": color, "cells": cells})
+    return comps
+
+
+def _parse_panel_interior(interior: np.ndarray) -> dict[frozenset[int], int] | None:
+    mapping: dict[frozenset[int], int] = {}
+    nonblank_rows = 0
+    for row in interior:
