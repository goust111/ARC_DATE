0128:     for pts in components_mask(passable, connectivity=4):
0129:         if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):
0130:             continue  # outside background
0131: 
0132:         movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]
0133:         if not movers:
0134:             continue
0135: 
0136:         # Determine this region's border color by counting adjacent wall colors.
0137:         border_counts: dict[int, int] = {}
0138:         pset = {(int(r), int(c)) for r, c in pts}
0139:         for r, c in pts:
0140:             for nr, nc in neighbors4(r, c):
0141:                 if not (0 <= nr < h and 0 <= nc < w):
0142:                     continue
0143:                 if (nr, nc) in pset:
0144:                     continue
0145:                 v = int(g[nr, nc])
0146:                 if v == bg or v == mover:
0147:                     continue
0148:                 border_counts[v] = border_counts.get(v, 0) + 1
0149:         if not border_counts:
