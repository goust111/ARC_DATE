+def _random_path(rng: random.Random, rows: int, cols: int, length: int):
+    def grow(path: list[tuple[int, int]], used: set[tuple[int, int]]) -> bool:
+        if len(path) == length:
+            return True
+        r, c = path[-1]
+        nbrs = []
+        for dr, dc in DIRS.values():
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in used:
+                nbrs.append((nr, nc))
