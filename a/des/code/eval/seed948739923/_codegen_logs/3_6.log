+    clocks = []
+    for idx, info in enumerate(sorted(infos)):
+        r0, c0, r1, c1, side = info
+        anchors = _anchor_map((r0, c0, r1, c1))
+        pointer_hits = []
+        for name, (ar, ac) in anchors.items():
+            if 0 <= ar < grid.shape[0] and 0 <= ac < grid.shape[1]:
+                val = int(grid[ar, ac])
+                if val in (RED, ORANGE):
