+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for dr, dc in DIRS.values():
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _frame_info(grid: np.ndarray, color: int, pts: list[tuple[int, int]]):
+    rs = [r for r, _ in pts]
+    cs = [c for _, c in pts]
+    r0, r1 = min(rs), max(rs)
+    c0, c1 = min(cs), max(cs)
+    side_h = r1 - r0 + 1
+    side_w = c1 - c0 + 1
+    if side_h != side_w or side_h < 5 or side_h % 2 == 0:
+        return None
+    local = grid[r0 : r1 + 1, c0 : c1 + 1] == color
+    target = np.zeros((side_h, side_h), dtype=bool)
+    target[0, :] = True
+    target[-1, :] = True
+    target[:, 0] = True
+    target[:, -1] = True
+    if len(pts) != int(target.sum()):
+        return None
+    if not np.array_equal(local, target):
+        return None
+    return (r0, c0, r1, c1, side_h)
