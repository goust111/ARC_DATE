+
+def _build_graph(grid: np.ndarray, clocks: list[dict]) -> dict[int, set[int]]:
+    anchor_to_clock: dict[tuple[int, int], int] = {}
+    for clock in clocks:
+        for pos in clock["anchors"].values():
+            anchor_to_clock[pos] = clock["id"]
