+    "right": (0, 1),
+    "bottom": (1, 0),
+    "left": (0, -1),
+}
+DIR_ORDER = ("top", "right", "bottom", "left")
+DIR_TO_K = {name: k for k, name in enumerate(DIR_ORDER)}
