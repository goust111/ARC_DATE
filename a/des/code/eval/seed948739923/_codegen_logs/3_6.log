+    total: dict[int, int] = {start: own[start]}
+    q = deque([start])
+    while q:
+        cur = q.popleft()
+        for nxt in sorted(graph[cur]):
+            if nxt in total:
+                continue
+            total[nxt] = (total[cur] + own[nxt]) % 4
+            q.append(nxt)
