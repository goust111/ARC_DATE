+import random
+from collections import Counter, defaultdict, deque
+
+import numpy as np
+
+
+GREY = 5
+RED = 2
+ORANGE = 7
+AZURE = 8
+
+DIRS = {
+    "top": (-1, 0),
+    "right": (0, 1),
+    "bottom": (1, 0),
+    "left": (0, -1),
+}
+DIR_ORDER = ("top", "right", "bottom", "left")
+DIR_TO_K = {name: k for k, name in enumerate(DIR_ORDER)}
+OPPOSITE = {"top": "bottom", "right": "left", "bottom": "top", "left": "right"}
+
+GEN_ATTEMPTS = 400
