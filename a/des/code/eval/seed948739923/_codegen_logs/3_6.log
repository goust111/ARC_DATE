0138:         seg = find_seg(segs, c)
0139:         if seg is None: continue
0140:         a, b = seg
0141:         entry = entry_from_above(r, seg)
0142:         if entry is not None:
0143:             # Pack to opposite end from entry
0144:             pack_end = b if (entry - a) <= (b - entry) else a
0145:         else:
0146:             # No entry from above: token at starting position (grid edge), stay put
0147:             pack_end = a if c <= a else b
0148:         buckets[(r, seg, pack_end)] += 1
