+    for comp in _components(grid == AZURE):
+        touched = sorted({anchor_to_clock[pos] for pos in comp if pos in anchor_to_clock})
+        if len(touched) == 2:
+            a, b = touched
+            graph[a].add(b)
+            graph[b].add(a)
+    return graph
