+def _to_actual(
+    origin: tuple[int, int],
+    travel: tuple[int, int],
+    perp: tuple[int, int],
+    local: tuple[int, int],
+) -> tuple[int, int]:
+    u, v = local
+    return (
+        origin[0] + u * travel[0] + v * perp[0],
+        origin[1] + u * travel[1] + v * perp[1],
+    )
