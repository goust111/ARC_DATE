+                    cand = (u, side * dist)
+                    entry = u
+                    off = dist
+                if cand in coords:
+                    continue
+                if any(abs(cand[0] - u0) + abs(cand[1] - v0) == 1 for u0, v0 in coords):
+                    continue
+                total = off + (line_len - 1 - entry)
+                if total in totals:
+                    continue
+                coords.append(cand)
+                totals.add(total)
