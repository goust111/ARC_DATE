+def _parse_legend(g: np.ndarray) -> tuple[dict[int, np.ndarray], int]:
+    r0, c0, r1, c1 = _find_legend_bbox(g)
+    sub = g[r0 : r1 + 1, c0 : c1 + 1]
+    row_bars = [idx for idx in range(sub.shape[0]) if np.all(sub[idx, :] == GREY)]
