+    for top, bottom in zip(row_bars, row_bars[1:], strict=False):
+        if bottom - top < 4:
+            continue
+        body = sub[top + 1 : bottom, 1:-1]
+        if body.shape[0] != 3 or body.shape[1] < 4:
+            continue
