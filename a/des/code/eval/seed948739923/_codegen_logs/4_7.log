+    for dr, dc in CARDINALS:
+        run = 0
+        rr, cc2 = cr + dr, cc + dc
+        while 0 <= rr < h and 0 <= cc2 < w and int(g[rr, cc2]) == pointer_color:
+            run += 1
+            rr += dr
+            cc2 += dc
+        if run >= 2:
