+    dr, dc = direction
+    r0, c0, _, _ = _bbox(coords)
+    for r, c in coords:
+        rr = int(r)
+        cc2 = int(c)
+        dot = (rr - cr) * dr + (cc2 - cc) * dc
+        if dot < 0:
+            out[rr, cc2] = int(sample[(rr - r0) % 3, (cc2 - c0) % 3])
