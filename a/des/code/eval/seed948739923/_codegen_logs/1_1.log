        options.append((2, 2))
    return options


def _frame_patch(color: int, room_count: int, direction: str) -> tuple[np.ndarray, dict[str, int | str]]:
    rows, cols = random.choice(_shape_options(room_count, direction))
    room_h = random.randint(2, 3)
