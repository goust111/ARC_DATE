    assert set(frames) == set(boxes), "frame colors and canvas markers must match"

    frame_info: dict[int, tuple[int, str]] = {}
    for color, (r0, c0, r1, c1) in frames.items():
        frame_info[color] = _analyze_frame(g[r0 : r1 + 1, c0 : c1 + 1], color)

    out = g.copy()
