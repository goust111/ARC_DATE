+
+def _has_rect_border(sub: np.ndarray, color: int) -> bool:
+    return bool(
+        np.all(sub[0, :] == color)
+        and np.all(sub[-1, :] == color)
+        and np.all(sub[:, 0] == color)
+        and np.all(sub[:, -1] == color)
+    )
