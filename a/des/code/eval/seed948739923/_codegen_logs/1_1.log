        sr, sc = _square_origin(inner_h, inner_w, rooms, direction)
        inner[sr : sr + rooms, sc : sc + rooms] = color

    return out


def _shape_options(room_count: int, direction: str) -> list[tuple[int, int]]:
    if direction in ("up", "down"):
        options = [(1, room_count)]
        if room_count == 4:
            options.append((2, 2))
