+    if focus == "multi" and stats["multi_cells"] == 0:
+        return None
+    if focus == "blocked" and stats["blocked_tower_count"] == 0:
+        return None
+    if (wall_row is not None or wall_col is not None) and stats["truncated_tower_count"] == 0 and stats["blocked_tower_count"] == 0:
