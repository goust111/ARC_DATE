        shape_w = int(obj["width"])
        abs_cells: list[tuple[int, int]] | None = None

        for _ in range(PLACE_ATTEMPTS):
            top = random.randint(0, grid_h - shape_h)
            left = random.randint(0, grid_w - shape_w)
