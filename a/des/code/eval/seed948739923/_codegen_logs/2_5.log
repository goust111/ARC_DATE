        winner_extra = chosen_extras[-1]
        winner_idx = random.randrange(group_size)
        winner_colors[group_id] = colors[winner_idx]

        for obj_idx, extra in enumerate(chosen_extras):
            shape = random.choice(variants[extra])
            color = colors[obj_idx]
            objects.append(_shape_record(group_id, color, shape))

        if colors[winner_idx] != winner_colors[group_id]:
            return None

