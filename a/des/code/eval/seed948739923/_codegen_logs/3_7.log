    q=deque([tuple(map(int,pts[0]))]); vis={tuple(map(int,pts[0]))}
    while q:
        r,c=q.popleft()
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0<=nr<mask.shape[0] and 0<=nc<mask.shape[1] and mask[nr,nc] and (nr,nc) not in vis:
                vis.add((nr,nc)); q.append((nr,nc))
    return len(vis)==len(pts)

def holes(mask):
    open_=~mask
    pad=np.pad(open_,1,constant_values=True)
    seen=np.zeros_like(pad,bool)
    q=deque([(0,0)]); seen[0,0]=True
    while q:
        r,c=q.popleft()
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0<=nr<pad.shape[0] and 0<=nc<pad.shape[1] and pad[nr,nc] and not seen[nr,nc]:
                seen[nr,nc]=True; q.append((nr,nc))
    return open_ & ~seen[1:-1,1:-1]

