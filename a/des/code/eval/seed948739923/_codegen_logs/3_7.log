+        boundary = np.zeros((height, width), dtype=bool)
+        observed = np.zeros((height, width), dtype=bool)
+        for i in range(segment_count):
+            r = int(rows[i])
+            c0 = int(cols[i - 1])
+            c1 = int(cols[i])
+            _draw_axis_line(boundary, (r, c0), (r, c1))
+            _draw_axis_line(observed, (r, c0), (r, c1))
