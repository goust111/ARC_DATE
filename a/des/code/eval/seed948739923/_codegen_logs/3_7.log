from __future__ import annotations
import random
from collections import deque
import numpy as np


def endpoints_of_component(coords):
    rs = coords[:,0]; cs = coords[:,1]
    if len(set(rs)) == 1:
        r = int(rs[0]); c0=int(cs.min()); c1=int(cs.max())
        return 'h', ((r,c0),(r,c1))
    if len(set(cs)) == 1:
        c = int(cs[0]); r0=int(rs.min()); r1=int(rs.max())
        return 'v', ((r0,c),(r1,c))
    raise ValueError


def flood_fill_inside(boundary):
    h,w = boundary.shape
    open_ = ~boundary
    pad = np.pad(open_, 1, constant_values=True)
    seen = np.zeros_like(pad, dtype=bool)
    q = deque([(0,0)])
    seen[0,0]=True
    while q:
        r,c=q.popleft()
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0<=nr<pad.shape[0] and 0<=nc<pad.shape[1] and pad[nr,nc] and not seen[nr,nc]:
                seen[nr,nc]=True; q.append((nr,nc))
    holes = open_ & ~seen[1:-1,1:-1]
    return holes


def degree_valid(mask):
    pts=np.argwhere(mask)
    if len(pts)==0: return False
    for r,c in pts:
        deg=0
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0<=nr<mask.shape[0] and 0<=nc<mask.shape[1] and mask[nr,nc]: deg+=1
        if deg"'!=2: return False
    # connected
    start=tuple(map(int,pts[0]))
    q=deque([start]); vis={start}
    while q:
        r,c=q.popleft()
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0<=nr<mask.shape[0] and 0<=nc<mask.shape[1] and mask[nr,nc] and (nr,nc) not in vis:
                vis.add((nr,nc)); q.append((nr,nc))
    return len(vis)==len(pts)


def solve_color(grid, color):
    mask = grid==color
    h,w = mask.shape
    # components
    seen=np.zeros_like(mask,bool)
    comps=[]
    for r,c in np.argwhere(mask):
        r=int(r); c=int(c)
        if seen[r,c]: continue
        q=deque([(r,c)]); seen[r,c]=True; coords=[]
        while q:
            rr,cc=q.popleft(); coords.append((rr,cc))
            for nr,nc in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):
                if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                    seen[nr,nc]=True; q.append((nr,nc))
        coords=np.array(coords,int)
        comps.append(coords)
    segs=[]
    for coords in comps:
        ori, ends=endpoints_of_component(coords)
        segs.append((ori, ends, coords))
    if not segs: return None
    if len({ori for ori,_,_ in segs})!=1: return None
    ori=segs[0][0]
    endpoints=[]
    for idx,(ori2,ends,coords) in enumerate(segs):
        for side,p in enumerate(ends):
            endpoints.append((idx,side,p))
    used=[False]*len(endpoints)
    sols=[]
    def rec(pairs):
        try:
            i=next(i for i,u in enumerate(used) if not u)
        except StopIteration:
            sols.append(list(pairs)); return
        seg_i, side_i, (r,c) = endpoints[i]
        used[i]=True
        for j in range(i+1,len(endpoints)):
            if used[j]: continue
            seg_j, side_j, (r2,c2)=endpoints[j]
            if seg_i==seg_j: continue
            if ori=='"'h':
                if c"'!=c2: continue
            else:
                if r!=r2: continue
            used[j]=True
            pairs.append((i,j))
            rec(pairs)
            pairs.pop(); used[j]=False
        used[i]=False
    rec([])
    valid=[]
    for pairs in sols:
        b=mask.copy()
        ok=True
        for i,j in pairs:
            _,_,(r,c)=endpoints[i]
            _,_,(r2,c2)=endpoints[j]
            rr0,rr1=sorted((r,r2)); cc0,cc1=sorted((c,c2))
            if ori=='"'h':
                # vertical connector
                col=c
                # check original other-color not crossed
                for rr in range(rr0,rr1+1):
                    if grid[rr,col] not in (0,color):
                        ok=False
                b[rr0:rr1+1,col]=True
            else:
                row=r
                for cc in range(cc0,cc1+1):
                    if grid[row,cc] not in (0,color):
                        ok=False
                b[row,cc0:cc1+1]=True
        if not ok: continue
        if not degree_valid(b): continue
        holes=flood_fill_inside(b)
        if holes.sum()==0: continue
        valid.append((b,holes))
    return len(valid)


def build_patch(k=3, orient='h'):
    total=random.randint(k-1,4)
    parts=[1]*(k-1)
    rem=total-(k-1)
    for _ in range(rem):
        idx=random.randrange(k-1); parts[idx]+=1
    random.shuffle(parts)
    b=[total]
    cur=total
    for d in parts[:-1]:
        cur-=d; b.append(cur)
    gaps=[random.randint(2,5) for _ in range(k-1)]
    ys=[0]
    for g in gaps: ys.append(ys[-1]+g)
    segs=[]
    segs.append((ys[0],0,ys[0],b[0]))
    for i in range(1,k-1):
        segs.append((ys[i],b[i],ys[i],b[i-1]))
    segs.append((ys[-1],0,ys[-1],b[-1]))
    conns=[]
    conns.append((ys[0],b[0],ys[1],b[0]))
    for i in range(1,k-1):
        conns.append((ys[i],b[i],ys[i+1],b[i]))
    conns.append((ys[-1],0,ys[0],0))
    h=ys[-1]+1; w=b[0]+1
    full=np.zeros((h,w),dtype=int)
    inp=np.zeros((h,w),dtype=int)
    for r0,c0,r1,c1 in segs+conns:
        if r0==r1:
            full[r0,min(c0,c1):max(c0,c1)+1]=1
        else:
            full[min(r0,r1):max(r0,r1)+1,c0]=1
    for r0,c0,r1,c1 in segs:
        if r0==r1:
            inp[r0,min(c0,c1):max(c0,c1)+1]=1
        else:
            inp[min(r0,r1):max(r0,r1)+1,c0]=1
    holes=flood_fill_inside(full)
    out=full|holes
    if orient=='v':
        inp=inp.T; out=out.T
    return inp,out

for k in [3,4,5]:
    for orient in ['h','v']:
        for _ in range(20):
            inp,out=build_patch(k,orient)
            g=np.where(inp,1,0)
            n=solve_color(g,1)
            if n"'!=1:
                print('"'bad',k,orient,n)
                print(inp.astype(int))
                raise SystemExit
print('ok')
