+    )
+    fallback = ordered[:count]
+    return fallback
+
+
+def _grid_shape_ok(total_rows: int, total_cols: int, cell_h: int, cell_w: int) -> bool:
+    h = total_rows * cell_h + total_rows + 1
+    w = total_cols * cell_w + total_cols + 1
+    return 15 <= h <= 30 and 15 <= w <= 30
+
