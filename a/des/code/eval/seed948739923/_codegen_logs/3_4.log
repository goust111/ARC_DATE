+def _interior_spans(lines: list[int]) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    for a, b in zip(lines, lines[1:]):
+        if b - a > 1:
+            spans.append((a + 1, b - 1))
+    return spans
