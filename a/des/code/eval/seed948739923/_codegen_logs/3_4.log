+            rows = np.array([r for r, _ in pts])
+            cols = np.array([c for _, c in pts])
+            mean_r = _round_half_up(rows)
+            mean_c = _round_half_up(cols)
+            if _would_clamp(mean_r, mean_c, cell_h, cell_w, tpl_h, tpl_w) == want_clamp:
+                return pts
+
+    ordered = sorted(
