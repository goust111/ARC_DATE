+    def backtrack(pos: int) -> bool:
+        if pos == len(order):
+            return True
+        fi = order[pos]
+        for marker_idx in cand_lists[fi]:
+            if marker_idx in used:
+                continue
+            used.add(marker_idx)
+            assign[fi] = marker_idx
+            if backtrack(pos + 1):
+                return True
+            assign[fi] = None
+            used.remove(marker_idx)
+        return False
