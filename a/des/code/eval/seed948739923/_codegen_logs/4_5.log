+import random
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+SIDE_TO_DIR = {
+    "left": (0, 1),
+    "right": (0, -1),
+    "top": (1, 0),
+    "bottom": (-1, 0),
+}
+
+# Generator configuration.
+GRID_H_RANGE = (14, 20)
+GRID_W_RANGE = (14, 20)
+LEGEND_LEN_CHOICES = (3, 4)
+LEGEND_COL_CHOICES = (1, 2)
+MIN_EVENT_DIST = 3
+MIN_SPACE_FOR_PORTAL = 4
+MIN_SPACE_FOR_BOUNDARY = 2
+MAX_PORTAL_PAIRS = 4
+DECOR_WALL_MAX = 3
+GENERATE_RETRIES = 400
