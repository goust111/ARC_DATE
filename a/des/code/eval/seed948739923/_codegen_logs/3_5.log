+from __future__ import annotations
+
+from collections import defaultdict, deque
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+BLUE = 1
+RED = 2
+YELLOW = 4
+BG = 0
+
+PATTERN_COLORS = (3, 5, 6, 7, 8, 9)
+SIDES = ("top", "right", "bottom", "left")
+DIRS = {
+    "top": (-1, 0),
+    "right": (0, 1),
+    "bottom": (1, 0),
+    "left": (0, -1),
+}
