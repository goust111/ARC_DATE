+
+def _color_sequence(length: int, rng: random.Random) -> list[int]:
+    while True:
+        seq = [rng.choice(PATTERN_COLORS) for _ in range(length)]
+        if len(set(seq)) < 2:
+            continue
+        if seq == list(reversed(seq)):
+            continue
+        return seq
