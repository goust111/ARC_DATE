+from __future__ import annotations
+
+from collections import defaultdict, deque
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+BLUE = 1
+RED = 2
+YELLOW = 4
+BG = 0
+
+PATTERN_COLORS = (3, 5, 6, 7, 8, 9)
+SIDES = ("top", "right", "bottom", "left")
+DIRS = {
+    "top": (-1, 0),
+    "right": (0, 1),
+    "bottom": (1, 0),
+    "left": (0, -1),
+}
+OPPOSITE = {
+    "top": "bottom",
+    "right": "left",
+    "bottom": "top",
+    "left": "right",
+}
+
+GEN_RETRIES = 400
+GRID_MIN = 18
+GRID_MAX = 30
+BOX_PAD = 2
+
+
+@dataclass(frozen=True)
+class Fence:
+    bbox: tuple[int, int, int, int]
+    gap_side: str
+    marker: tuple[int, int]
+    patch_origin: tuple[int, int]
+    patch: np.ndarray
+
+
+@dataclass(frozen=True)
+class FenceSpec:
+    side: str
+    same_side: bool
+    outer_h: int
+    outer_w: int
+    pattern: np.ndarray
+    pattern_pos: tuple[int, int]
+    marker_pos: tuple[int, int]
+    gap_start: int
+    gap_len: int
+    bbox: tuple[int, int, int, int]
+
+
+def _mode_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((int(cr), int(cc)))
+                for dr, dc in DIRS.values():
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _perimeter_cells(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _gap_side_from_missing(
+    missing: set[tuple[int, int]], r0: int, c0: int, r1: int, c1: int
+) -> str | None:
+    if not (1 <= len(missing) <= 3):
+        return None
+
+    side: str | None = None
+    coords: list[int] = []
+    for r, c in missing:
+        if r == r0 and c0 < c < c1:
+            here = "top"
+            coord = c
+        elif r == r1 and c0 < c < c1:
+            here = "bottom"
+            coord = c
+        elif c == c0 and r0 < r < r1:
+            here = "left"
+            coord = r
+        elif c == c1 and r0 < r < r1:
+            here = "right"
+            coord = r
+        else:
+            return None
+        if side is None:
+            side = here
+        elif side != here:
+            return None
+        coords.append(coord)
+
+    coords.sort()
+    if coords != list(range(coords[0], coords[0] + len(coords))):
+        return None
+    return side
+
+
+def _extract_fences(grid: np.ndarray, bg: int) -> list[Fence]:
+    g = np.asarray(grid, dtype=int)
+    fences: list[Fence] = []
+    for pts in _components(g == BLUE):
+        rows = [r for r, _ in pts]
+        cols = [c for _, c in pts]
+        r0, r1 = min(rows), max(rows)
+        c0, c1 = min(cols), max(cols)
+        if r1 - r0 < 4 or c1 - c0 < 4:
+            continue
+
+        pts_set = set(pts)
+        perimeter = _perimeter_cells(r0, c0, r1, c1)
+        if not pts_set.issubset(perimeter):
+            continue
+        missing = perimeter - pts_set
+        gap_side = _gap_side_from_missing(missing, r0, c0, r1, c1)
+        if gap_side is None:
+            continue
+
+        interior = g[r0 + 1 : r1, c0 + 1 : c1]
+        marker_pts = np.argwhere(interior == YELLOW)
+        if marker_pts.shape != (1, 2):
+            continue
+        marker_r = r0 + 1 + int(marker_pts[0, 0])
+        marker_c = c0 + 1 + int(marker_pts[0, 1])
+
+        motif_mask = (interior != bg) & (interior != BLUE) & (interior != YELLOW)
+        if not motif_mask.any():
+            continue
+        motif_pts = np.argwhere(motif_mask)
+        pr0, pc0 = motif_pts.min(axis=0)
+        pr1, pc1 = motif_pts.max(axis=0)
+        pr0 = int(pr0)
+        pc0 = int(pc0)
+        pr1 = int(pr1)
+        pc1 = int(pc1)
+        patch = interior[pr0 : pr1 + 1, pc0 : pc1 + 1].copy()
+        patch[patch == YELLOW] = bg
+        patch[patch == BLUE] = bg
+
+        fences.append(
+            Fence(
+                bbox=(int(r0), int(c0), int(r1), int(c1)),
+                gap_side=gap_side,
+                marker=(int(marker_r), int(marker_c)),
+                patch_origin=(int(r0 + 1 + pr0), int(c0 + 1 + pc0)),
+                patch=patch,
+            )
