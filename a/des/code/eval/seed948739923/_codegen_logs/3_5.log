+        rng.shuffle(r_choices)
+        rng.shuffle(c_choices)
+        hb_bbox = None
+        for r0 in r_choices:
+            for c0 in c_choices:
+                cand = (r0, c0, r0 + hb_h - 1, c0 + hb_w - 1)
+                if _bbox_clear(existing, cand, BOX_PAD):
+                    hb_bbox = cand
