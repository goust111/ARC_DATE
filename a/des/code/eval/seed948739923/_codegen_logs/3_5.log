+        return None
+
+    side: str | None = None
+    coords: list[int] = []
+    for r, c in missing:
+        if r == r0 and c0 < c < c1:
+            here = "top"
+            coord = c
+        elif r == r1 and c0 < c < c1:
+            here = "bottom"
+            coord = c
+        elif c == c0 and r0 < r < r1:
+            here = "left"
+            coord = r
+        elif c == c1 and r0 < r < r1:
+            here = "right"
+            coord = r
+        else:
