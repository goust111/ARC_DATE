+
+def _piece_anchor_and_dir(piece, maroons: set[tuple[int, int]]):
+    piece_cells = set(piece["coords"])
+    matches = []
+    for mr, mc in maroons:
+        adjacent = []
+        for r, c in piece["coords"]:
+            if abs(r - mr) + abs(c - mc) == 1:
+                adjacent.append((r, c))
+        if len(adjacent) == 1:
+            anchor = adjacent[0]
+            d = (mr - anchor[0], mc - anchor[1])
+            if d in DIR_LIST:
