+
+
+def _find_pieces(grid: np.ndarray, frame: tuple[int, int, int, int]):
+    r0, c0, r1, c1 = frame
+    outside = np.ones_like(grid, dtype=bool)
+    outside[r0 : r1 + 1, c0 : c1 + 1] = False
