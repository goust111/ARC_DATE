+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+AZURE = 8
+MAROON = 9
+
+PIECE_COLORS = (MAGENTA, ORANGE, AZURE)
+STRUCTURE_COLORS = {BG, BLUE, RED, GREEN, YELLOW, GREY, MAROON}
+TRACK_COLORS = {GREY, BLUE, RED, GREEN, MAROON}
+SIGNAL_COLORS = {BLUE, RED, GREEN}
+
+DIRS = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
+DIR_LIST = list(DIRS.values())
+SIDE_TO_FINAL_DIR = {
+    "left": DIRS["right"],
+    "right": DIRS["left"],
+    "top": DIRS["down"],
+    "bottom": DIRS["up"],
+}
