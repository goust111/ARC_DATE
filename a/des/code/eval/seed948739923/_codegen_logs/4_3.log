   489	def _entry_point(rng: np.random.Generator, slot_bbox: tuple[int, int, int, int], frame, side: str):
   490	    fr0, fc0, fr1, fc1 = frame
   491	    sr0, sc0, sr1, sc1 = slot_bbox
   492	    if side == "left":
   493	        rr = int(rng.integers(sr0, sr1 + 1))
   494	        return rr, fc0 - 1
   495	    if side == "right":
   496	        rr = int(rng.integers(sr0, sr1 + 1))
   497	        return rr, fc1 + 1
   498	    if side == "top":
   499	        cc = int(rng.integers(sc0, sc1 + 1))
   500	        return fr0 - 1, cc
   501	    cc = int(rng.integers(sc0, sc1 + 1))
   502	    return fr1 + 1, cc
   503	
   504	
   505	def _generate_piece_path(
   506	    rng: np.random.Generator,
   507	    grid_shape: tuple[int, int],
   508	    endpoint: tuple[int, int],
   509	    final_dir: tuple[int, int],
   510	    blocked: set[tuple[int, int]],
   511	    spacer: set[tuple[int, int]],
   512	    force_signal: int | None,
   513	):
   514	    h, w = grid_shape
   515	    for _ in range(PATH_RETRIES):
