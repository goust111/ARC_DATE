+        return rr, fc0 - 1
+    if side == "right":
+        rr = int(rng.integers(sr0, sr1 + 1))
+        return rr, fc1 + 1
+    if side == "top":
+        cc = int(rng.integers(sc0, sc1 + 1))
+        return fr0 - 1, cc
+    cc = int(rng.integers(sc0, sc1 + 1))
+    return fr1 + 1, cc
