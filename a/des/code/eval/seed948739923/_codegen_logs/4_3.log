+        if slots[0][0] != slots[1][0]:
+            for i in range(len(slots) - 1):
+                divider = slots[i][2] + 1
+                grid[divider, fc0 + 1 : fc1] = GREY
+        else:
+            for i in range(len(slots) - 1):
+                divider = slots[i][3] + 1
+                grid[fr0 + 1 : fr1, divider] = GREY
