+def _green_candidates(path):
+    candidates = []
+    for i in range(1, len(path) - 1):
+        d0 = _sub(path[i], path[i - 1])
+        d1 = _sub(path[i + 1], path[i])
+        if d0 == d1:
+            candidates.append((i, d0))
+    return candidates
