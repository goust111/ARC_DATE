+        return {
+            "anchor": anchor,
+            "maroon": maroon,
+            "rel_shape": rel_shape,
+            "shape_cells": shape_cells,
+            "path": path,
+            "signals": signal_map,
+            "branches": branch_cells,
+            "start_dir": start_dir,
