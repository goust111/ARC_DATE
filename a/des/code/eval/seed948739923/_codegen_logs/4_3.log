+        r_high = h - frame_h - 2
+    elif side == "right":
+        c_low = 1
+        c_high = min(w // 2 - frame_w, w - frame_w - 8)
+        r_low = 1
+        r_high = h - frame_h - 2
+    elif side == "top":
+        r_low = max(8, h // 2 - 1)
+        r_high = h - frame_h - 2
+        c_low = 1
+        c_high = w - frame_w - 2
+    else:
+        r_low = 1
+        r_high = min(h // 2 - frame_h, h - frame_h - 8)
+        c_low = 1
+        c_high = w - frame_w - 2
+
+    if r_low > r_high or c_low > c_high:
+        return None
+    fr0 = int(rng.integers(r_low, r_high + 1))
+    fc0 = int(rng.integers(c_low, c_high + 1))
+    fr1 = fr0 + frame_h - 1
+    fc1 = fc0 + frame_w - 1
