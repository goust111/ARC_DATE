+def _draw_frame(grid: np.ndarray, frame: tuple[int, int, int, int], slots):
+    fr0, fc0, fr1, fc1 = frame
+    grid[fr0, fc0 : fc1 + 1] = YELLOW
+    grid[fr1, fc0 : fc1 + 1] = YELLOW
+    grid[fr0 : fr1 + 1, fc0] = YELLOW
+    grid[fr0 : fr1 + 1, fc1] = YELLOW
