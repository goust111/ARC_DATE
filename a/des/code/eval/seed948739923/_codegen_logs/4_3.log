+        cols = sorted(cols)[: min(3, len(cols))]
+    elif side == "right":
+        cols = sorted(cols)[-min(3, len(cols)) :]
+    elif side == "top":
+        rows = sorted(rows)[: min(3, len(rows))]
+    else:
