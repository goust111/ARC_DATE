+
+def _path_from_spec(start: tuple[int, int], dirs, lengths):
+    path = [start]
+    turn_points: list[tuple[int, int]] = []
+    step_dirs: list[tuple[int, int]] = []
+    pos = start
+    for i, d in enumerate(dirs):
+        for step in range(lengths[i]):
+            pos = _add(pos, d)
+            path.append(pos)
