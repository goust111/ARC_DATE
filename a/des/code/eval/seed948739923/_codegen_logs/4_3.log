+        for c in range(frame[1], frame[3] + 1)
+    }
+    spacer: set[tuple[int, int]] = set()
+
+    colors = list(rng.permutation(PIECE_COLORS))[:piece_count]
+    featured_signal = [RED, BLUE, GREEN][int(rng.integers(3))]
