+        piece_cells = {(marker[0] + dr, marker[1] + dc) for dr, dc in info["rel_shape"]}
+        if not all(slot_bbox[0] <= r <= slot_bbox[2] and slot_bbox[1] <= c <= slot_bbox[3] for r, c in piece_cells):
