+    region = grid[top : top + mask.shape[0], left : left + mask.shape[1]]
+    region[_seed_fill_mask(mask, orient)] = color
+
+
+def _place_rectangles(zone_h: int, zone_w: int, sizes: list[tuple[int, int]], gap: int = 1) -> list[tuple[int, int]] | None:
