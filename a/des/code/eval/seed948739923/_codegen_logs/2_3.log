+def _random_partition(total: int, parts: int, min_part: int = 1) -> List[int]:
+    slots = [min_part] * parts
+    extra = total - parts * min_part
+    for _ in range(extra):
+        slots[random.randrange(parts)] += 1
+    random.shuffle(slots)
+    return slots
