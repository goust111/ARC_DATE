+def _components(mask: np.ndarray, connectivity: int = 4) -> List[np.ndarray]:
+    h, w = mask.shape
+    visited = np.zeros((h, w), dtype=bool)
+    if connectivity == 4:
+        neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    else:
+        neighbors = [
+            (-1, -1),
+            (-1, 0),
