+        marker_r, marker_c = top_cells[0]
+        body_rows = [r for r, _c in body]
+        body_cols = [c for _r, c in body]
+        r0 = int(top_r + 1)
+        r1 = int(max(body_rows))
+        c0 = int(min(body_cols))
+        c1 = int(max(body_cols))
+        assert int(min(body_rows)) == r0
