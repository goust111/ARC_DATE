+
+def _shortest_path(
+    h: int,
+    w: int,
+    start: tuple[int, int],
+    end: tuple[int, int],
+    blocked: set[tuple[int, int]],
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    blocked = set(blocked)
+    blocked.discard(start)
+    blocked.discard(end)
+
+    q: deque[tuple[int, int]] = deque([start])
+    parent: dict[tuple[int, int], tuple[int, int] | None] = {start: None}
+
+    while q:
+        cur = q.popleft()
+        if cur == end:
+            break
+        nbrs = []
+        for dr, dc in DIR4:
+            nr = int(cur[0] + dr)
+            nc = int(cur[1] + dc)
+            nxt = (nr, nc)
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if nxt in blocked or nxt in parent:
+                continue
+            nbrs.append(nxt)
+        rng.shuffle(nbrs)
+        nbrs.sort(key=lambda p: abs(int(p[0] - end[0])) + abs(int(p[1] - end[1])))
+        for nxt in nbrs:
+            parent[nxt] = cur
+            q.append(nxt)
+
+    if end not in parent:
+        return None
+
+    path = []
+    cur: tuple[int, int] | None = end
+    while cur is not None:
+        path.append(cur)
+        cur = parent[cur]
+    path.reverse()
+    return path
