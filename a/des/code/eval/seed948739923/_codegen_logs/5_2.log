+                continue
+            val = int(grid[rr, cc])
+            if val not in (int(color), GREY, MAROON):
+                continue
+            parent[(rr, cc)] = (int(r), int(c))
+            q.append((rr, cc))
+
+    if target is None:
+        return None
+
+    path = []
+    cur: tuple[int, int] | None = target
+    while cur is not None:
+        path.append(cur)
+        cur = parent[cur]
+    path.reverse()
+    return path
