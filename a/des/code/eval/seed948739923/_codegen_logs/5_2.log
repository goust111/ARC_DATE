+
+def _translate_offsets(offsets: list[tuple[int, int]], anchor: tuple[int, int]) -> set[tuple[int, int]]:
+    ar, ac = anchor
+    return {(int(ar + dr), int(ac + dc)) for dr, dc in offsets}
