+            parent[nxt] = cur
+            q.append(nxt)
+
+    if end not in parent:
+        return None
+
+    path = []
+    cur: tuple[int, int] | None = end
+    while cur is not None:
+        path.append(cur)
+        cur = parent[cur]
+    path.reverse()
+    return path
