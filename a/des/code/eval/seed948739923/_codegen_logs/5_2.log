+
+def _dilate(cells: set[tuple[int, int]], h: int, w: int, include_diagonal: bool) -> set[tuple[int, int]]:
+    out = set(cells)
+    extra_dirs = [(-1, -1), (-1, 1), (1, -1), (1, 1)] if include_diagonal else []
+    for r, c in cells:
+        for dr, dc in list(DIR4) + extra_dirs:
+            rr = int(r + dr)
+            cc = int(c + dc)
+            if 0 <= rr < h and 0 <= cc < w:
+                out.add((rr, cc))
+    return out
+
+
+def _border_cells(h: int, w: int) -> set[tuple[int, int]]:
+    pts = set()
+    for r in range(h):
+        pts.add((r, 0))
+        pts.add((r, w - 1))
+    for c in range(w):
+        pts.add((0, c))
+        pts.add((h - 1, c))
+    return pts
+
+
+def _shortest_path(
+    h: int,
+    w: int,
+    start: tuple[int, int],
+    end: tuple[int, int],
+    blocked: set[tuple[int, int]],
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    blocked = set(blocked)
+    blocked.discard(start)
+    blocked.discard(end)
+
+    q: deque[tuple[int, int]] = deque([start])
+    parent: dict[tuple[int, int], tuple[int, int] | None] = {start: None}
+
+    while q:
+        cur = q.popleft()
+        if cur == end:
+            break
+        nbrs = []
+        for dr, dc in DIR4:
+            nr = int(cur[0] + dr)
+            nc = int(cur[1] + dc)
+            nxt = (nr, nc)
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if nxt in blocked or nxt in parent:
+                continue
+            nbrs.append(nxt)
+        rng.shuffle(nbrs)
+        nbrs.sort(key=lambda p: abs(int(p[0] - end[0])) + abs(int(p[1] - end[1])))
+        for nxt in nbrs:
+            parent[nxt] = cur
+            q.append(nxt)
+
+    if end not in parent:
+        return None
+
+    path = []
+    cur: tuple[int, int] | None = end
+    while cur is not None:
+        path.append(cur)
+        cur = parent[cur]
+    path.reverse()
+    return path
+
+
+def _trace_color_path(grid: np.ndarray, color: int, start: tuple[int, int]) -> list[tuple[int, int]] | None:
+    h, w = grid.shape
+    q: deque[tuple[int, int]] = deque([start])
+    parent: dict[tuple[int, int], tuple[int, int] | None] = {start: None}
+    target: tuple[int, int] | None = None
+
+    while q:
+        r, c = q.popleft()
+        if int(grid[r, c]) == MAROON:
