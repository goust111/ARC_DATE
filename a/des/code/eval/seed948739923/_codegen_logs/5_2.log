+def _shortest_path(
+    h: int,
+    w: int,
+    start: tuple[int, int],
+    end: tuple[int, int],
+    blocked: set[tuple[int, int]],
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    blocked = set(blocked)
+    blocked.discard(start)
+    blocked.discard(end)
+
+    q: deque[tuple[int, int]] = deque([start])
+    parent: dict[tuple[int, int], tuple[int, int] | None] = {start: None}
+
+    while q:
+        cur = q.popleft()
+        if cur == end:
+            break
+        nbrs = []
+        for dr, dc in DIR4:
+            nr = int(cur[0] + dr)
+            nc = int(cur[1] + dc)
+            nxt = (nr, nc)
+            if not (0 <= nr < h and 0 <= nc < w):
