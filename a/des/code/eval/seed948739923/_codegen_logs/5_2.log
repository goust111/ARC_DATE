+            cc = int(c + dc)
+            if not (0 <= rr < h and 0 <= cc < w):
+                continue
+            if (rr, cc) in parent:
+                continue
+            val = int(grid[rr, cc])
+            if val not in (int(color), GREY, MAROON):
+                continue
+            parent[(rr, cc)] = (int(r), int(c))
+            q.append((rr, cc))
