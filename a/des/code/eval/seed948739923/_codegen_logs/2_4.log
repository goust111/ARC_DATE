+
+    if side == "bottom":
+        grid = np.full((h + 3, w + 2), BG, dtype=int)
+        grid[0, :] = GREY
+        grid[-2, :] = GREY
+        grid[:-1, 0] = GREY
+        grid[:-1, -1] = GREY
+        grid[1 : 1 + h, 1 : 1 + w] = interior
