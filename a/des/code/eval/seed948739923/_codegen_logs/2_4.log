+    assert np.all(g[r1 + 1, c0 : c1 + 1] == GREY)
+    assert np.all(g[r0 : r1 + 1, c0 - 1] == GREY)
+    assert np.all(g[r0 : r1 + 1, c1 + 1] == GREY)
+    return side, legend_index, bounds
