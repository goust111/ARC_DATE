+            out[r, c] = min(colors, key=lambda color: rank[color])
+
+    return inp, out
+
+
+def _legend_runs(span: int, count: int) -> list[tuple[int, int]] | None:
+    lengths = [random.randint(1, 2) for _ in range(count)]
+    needed = sum(lengths) + (count - 1)
+    if needed > span:
+        return None
+
+    free = span - needed
+    extras = [0] * (count + 1)
+    for _ in range(free):
