def _distractor_source_components(bg: int, comps: list[dict]) -> list[dict]:
    distractor_sources = [
        comp
        for comp in comps
        if int(comp["color"]) not in {bg, CUTOUT_COLOR, SOURCE_COLOR, MARK_COLOR}
