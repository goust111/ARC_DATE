+def _paint_patch(out: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    h, w = patch.shape
+    assert 0 <= top and 0 <= left and top + h <= out.shape[0] and left + w <= out.shape[1]
+    for r in range(h):
+        for c in range(w):
+            color = int(patch[r, c])
+            if color == AZURE:
+                continue
