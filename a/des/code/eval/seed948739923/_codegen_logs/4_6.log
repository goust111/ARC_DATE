+def _dictionary_cells(grid: np.ndarray) -> list[tuple[int, int]]:
+    top = grid[:2]
+    sep_cols = [c for c in range(grid.shape[1]) if bool(np.all(top[:, c] == GREY))]
+    assert sep_cols, "missing dictionary separators"
