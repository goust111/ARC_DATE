+def _parse_slots(grid: np.ndarray, label_colors: set[int]) -> dict[int, int]:
+    slots: dict[int, int] = {}
+    for c, value in enumerate(grid[-1]):
+        color = int(value)
+        if color == AZURE:
+            continue
