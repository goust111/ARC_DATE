+    for rr, cc in coords:
+        ar = top + int(rr)
+        ac = left + int(cc)
+        r0 = max(0, ar - 1)
+        r1 = min(occupied.shape[0], ar + 2)
+        c0 = max(0, ac - 1)
+        c1 = min(occupied.shape[1], ac + 2)
