+def _extract_objects(grid: np.ndarray) -> list[dict[str, object]]:
+    middle = grid[2:-1]
+    components = _connected_components(middle != AZURE, connectivity=8)
+    objects: list[dict[str, object]] = []
+    for coords in components:
