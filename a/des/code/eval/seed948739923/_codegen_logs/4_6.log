+        first_pixel = tuple(map(int, abs_coords[np.lexsort((abs_coords[:, 1], abs_coords[:, 0]))][0]))
+        objects.append(
+            {
+                "coords": abs_coords,
+                "bbox": (r0, c0, r1, c1),
+                "patch": patch,
+                "mask": mask,
+                "signature": _shape_signature(mask),
+                "first": first_pixel,
+            }
+        )
+    return objects
