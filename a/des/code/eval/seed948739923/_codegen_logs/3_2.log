   105	def main(grid: np.ndarray) -> np.ndarray:
   106	    """Convert each hollow 3x3 symbol to one pixel and slide the pixels clockwise from the marked edge.
   107	
   108	    Input structure
   109	    - The grid has a background, one full-edge marker line, and monochrome hollow 3x3 foreground symbols.
