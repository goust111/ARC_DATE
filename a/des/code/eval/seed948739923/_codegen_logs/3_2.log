   150	def _gen_compact(symbolic, side, bg):
   151	    out = np.full_like(symbolic, bg)
   152	
   153	    if side == "top":
   154	        for r, row in enumerate(symbolic):
   155	            values = [int(v) for v in row if int(v) != bg]
   156	            out[r, symbolic.shape[1] - len(values) :] = values
   157	    elif side == "right":
   158	        for c in range(symbolic.shape[1]):
   159	            values = [int(v) for v in symbolic[:, c] if int(v) != bg]
   160	            out[symbolic.shape[0] - len(values) :, c] = values
   161	    elif side == "bottom":
   162	        for r, row in enumerate(symbolic):
   163	            values = [int(v) for v in row if int(v) != bg]
   164	            out[r, : len(values)] = values
   165	    elif side == "left":
   166	        for c in range(symbolic.shape[1]):
   167	            values = [int(v) for v in symbolic[:, c] if int(v) != bg]
   168	            out[: len(values), c] = values
   169	    else:
   170	        raise AssertionError(side)
   171	
   172	    return out
