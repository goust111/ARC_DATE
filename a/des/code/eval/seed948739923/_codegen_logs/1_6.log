+def _find_canvas_frame(grid: np.ndarray) -> tuple[int, int, int, int] | None:
+    h, w = grid.shape
+    candidates: list[tuple[int, int, tuple[int, int, int, int]]] = []
+    for comp in _components(grid == FRAME):
+        r0, c0, r1, c1 = _bbox(comp)
+        side_h = int(r1 - r0 + 1)
+        side_w = int(c1 - c0 + 1)
