+        r0, c0, r1, c1 = record["bbox"]
+        block = grid[r0 : r1 + 1, c0 : c1 + 1]
+        mask = patch != BG
+        block[mask] = patch[mask]
+        ir, ic = record["indicator"]
+        grid[ir, ic] = INDICATOR
+    return grid
