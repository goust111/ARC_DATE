+def _project_origin(direction: str, stamp_h: int, stamp_w: int, canvas_size: int) -> tuple[int, int] | None:
+    if stamp_h > canvas_size or stamp_w > canvas_size:
+        return None
+    if direction == "top":
+        return 0, (canvas_size - stamp_w) // 2
+    if direction == "bottom":
