+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(int(r), int(c))]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(int(rr), int(cc)):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]] | np.ndarray) -> tuple[int, int, int, int]:
+    if isinstance(coords, np.ndarray):
+        rows = coords[:, 0]
+        cols = coords[:, 1]
+        return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+    rows = [int(r) for r, _c in coords]
+    cols = [int(c) for _r, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_canvas_frame(grid: np.ndarray) -> tuple[int, int, int, int] | None:
+    h, w = grid.shape
+    candidates: list[tuple[int, int, tuple[int, int, int, int]]] = []
+    for comp in _components(grid == FRAME):
+        r0, c0, r1, c1 = _bbox(comp)
+        side_h = int(r1 - r0 + 1)
+        side_w = int(c1 - c0 + 1)
