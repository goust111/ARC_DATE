# Seeds
SEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)
MIN_LINE_LEN = 4                   # discard attempt if line shorter than this
LINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)

# Frame loops
