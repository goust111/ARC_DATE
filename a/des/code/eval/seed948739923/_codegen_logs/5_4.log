+    mark_coords = np.argwhere((inner != BG) & (inner != CONTAINER))
+    assert mark_coords.shape == (1, 2)
+    mr = int(mark_coords[0, 0] + r0 + 1)
+    mc = int(mark_coords[0, 1] + c0 + 1)
