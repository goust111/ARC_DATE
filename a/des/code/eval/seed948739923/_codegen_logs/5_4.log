+        (r, c)
+        for r in range(r0, r1 + 1)
+        for c in range(c0, c1 + 1)
+        if r in (r0, r1) or c in (c0, c1)
+    }
+    missing = sorted(perimeter - cells)
+    assert cells <= perimeter
+    assert len(missing) == 2
