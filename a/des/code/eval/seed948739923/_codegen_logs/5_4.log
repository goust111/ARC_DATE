+    patch[coords[:, 0] - r0, coords[:, 1] - c0] = int(color)
+    return patch
+
+
+def _parse_container(grid: np.ndarray, coords: np.ndarray) -> dict:
+    cells = {tuple(map(int, xy)) for xy in coords}
+    r0, c0, r1, c1 = _bbox(coords)
+
