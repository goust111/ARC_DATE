+def _disjoint_leaves(a: dict[str, object], b: dict[str, object]) -> bool:
+    return a["start"] != b["start"] and a["end"] != b["end"]
+
+
+def _greedy_fill(
+    candidates: list[dict[str, object]],
+    selected: list[dict[str, object]],
+    used_h: set[Node],
+    used_v: set[Node],
+    target: int,
+    require_disjoint: bool,
+    rng: random.Random,
