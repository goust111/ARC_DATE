+    "right": SEED_BASE_RIGHT,
+    "down": np.rot90(SEED_BASE_RIGHT, 3),
+    "left": np.rot90(SEED_BASE_RIGHT, 2),
+    "up": np.rot90(SEED_BASE_RIGHT, 1),
