+        ("110", "111", "001"),
+        ("101", "111", "100"),
+        ("1110", "0010", "0111"),
+        ("0111", "0100", "1110"),
+        ("1100", "0111", "0010"),
+        ("1110", "1000", "1110"),
+        ("1010", "1110", "0011"),
