+    if h - GEN_ROOM_H_RANGE[0] - GEN_EDGE_MARGIN < GEN_EDGE_MARGIN:
+        return None
+    if w - GEN_ROOM_W_RANGE[0] - GEN_EDGE_MARGIN < GEN_EDGE_MARGIN:
+        return None
+    for _ in range(count):
