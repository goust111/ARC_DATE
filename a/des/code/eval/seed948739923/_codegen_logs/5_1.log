+    rel = coords - np.array([r0, c0], dtype=int)
+    mask[rel[:, 0], rel[:, 1]] = True
+    return mask
+
+
+def _touches_border(coords: np.ndarray, shape: tuple[int, int]) -> bool:
+    h, w = shape
