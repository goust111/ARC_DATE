+
+
+def _place_keys(
+    rng: random.Random,
+    grid: np.ndarray,
+    keys: list[tuple[np.ndarray, int]],
+) -> bool:
+    h, w = grid.shape
+    sides = ("top", "bottom", "left", "right")
