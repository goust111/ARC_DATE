+        key_shape = _rotate_shape(shape, rng.randrange(4))
+        key_specs.append((_render_shape(key_shape, color), color))
+
+    if not _place_keys(rng, inp, key_specs):
+        return None
+    if not np.array_equal(main(inp), out):
+        return None
+    return inp
+
