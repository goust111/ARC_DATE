+        GRID_BASE_RANGE[1] + lock_count * LOCK_EXTRA_SPACE + 2,
+    )
+    inp = np.full((height, width), BG, dtype=int)
+    out = inp.copy()
+    key_colors = rng.sample(KEY_COLORS, lock_count)
