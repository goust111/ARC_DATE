+    inner_h = rng.randint(hole_h + 2, hole_h + 5)
+    inner_w = rng.randint(hole_w + 2, hole_w + 5)
+    patch = np.full((inner_h + 2, inner_w + 2), BG, dtype=int)
+    patch[0, :] = LOCK
+    patch[-1, :] = LOCK
