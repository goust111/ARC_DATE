+        return False
+    coords = np.argwhere(patch != BG)
+    for dr, dc in coords:
+        rr = top + int(dr)
+        cc = left + int(dc)
+        r0 = max(0, rr - padding)
+        r1 = min(h, rr + padding + 1)
+        c0 = max(0, cc - padding)
+        c1 = min(w, cc + padding + 1)
+        if np.any(grid[r0:r1, c0:c1] != BG):
