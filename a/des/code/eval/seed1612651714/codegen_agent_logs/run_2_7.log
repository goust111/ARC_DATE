+    assert len(sides) == 1, "notch must open to exactly one side of the lock"
+
+    nr0, nc0, nr1, nc1 = _bbox(missing_comps[0])
+    notch = np.zeros((nr1 - nr0 + 1, nc1 - nc0 + 1), dtype=bool)
+    for r, c in missing_comps[0]:
+        notch[r - nr0, c - nc0] = True
