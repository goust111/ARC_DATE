+from __future__ import annotations
+
+import math
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+KEY = 1
+LOCK = 2
+FIT = 3
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+PAIR_COUNT_OPTIONS = (2, 3, 4)
+GRID_SIDE_MIN = 20
+GRID_SIDE_MAX = 30
+GENERATE_RETRIES = 300
+SHAPE_ATTEMPTS = 200
+PLACEMENT_ATTEMPTS = 400
+MARGIN = 1
+PADDING = 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    pts = np.argwhere(mask)
+    if len(pts) == 0:
+        raise AssertionError("mask must be non-empty")
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].copy()
+
+
+def _coords_to_cropped_mask(coords: list[tuple[int, int]]) -> tuple[np.ndarray, tuple[int, int]]:
+    r0, c0, r1, c1 = _bbox(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
+    return mask, (r0, c0)
+
+
+def _rotations(mask: np.ndarray) -> list[np.ndarray]:
+    seen = set()
+    variants: list[np.ndarray] = []
+    for k in range(4):
+        rot = np.rot90(mask, k).copy()
+        sig = (tuple(rot.shape), rot.tobytes())
+        if sig not in seen:
+            seen.add(sig)
+            variants.append(rot)
+    return variants
+
+
+def _canonical_shape(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    return min((tuple(rot.shape), rot.tobytes()) for rot in _rotations(mask))
+
