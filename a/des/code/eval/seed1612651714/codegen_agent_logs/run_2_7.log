+    for _ in range(SHAPE_ATTEMPTS * 4):
+        mask = _random_shape()
+        sig = _canonical_shape(mask)
+        if sig in seen:
+            continue
+        seen.add(sig)
+        shapes.append(mask)
+        if len(shapes) == count:
