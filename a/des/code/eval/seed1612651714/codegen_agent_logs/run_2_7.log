+def _opening_sides(missing: np.ndarray) -> list[str]:
+    sides: list[str] = []
+    if missing[0, :].any():
+        sides.append("up")
+    if missing[-1, :].any():
+        sides.append("down")
+    if missing[:, 0].any():
+        sides.append("left")
+    if missing[:, -1].any():
+        sides.append("right")
+    return sides
