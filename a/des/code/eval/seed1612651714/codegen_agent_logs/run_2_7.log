+
+def _match_assignment(keys: list[dict], locks: list[dict]) -> dict[int, tuple[int, np.ndarray]]:
+    candidates: dict[int, list[tuple[int, np.ndarray]]] = {}
+    for li, lock in enumerate(locks):
