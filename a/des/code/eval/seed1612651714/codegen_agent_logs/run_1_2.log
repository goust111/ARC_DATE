import random, numpy as np

def comps(mask):
    h,w=mask.shape
    seen=np.zeros((h,w),dtype=bool)
    n=0
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]: continue
            n+=1
            st=[(r,c)]; seen[r,c]=True
            while st:
                cr,cc=st.pop()
                for nr,nc in ((cr-1,cc),(cr+1,cc),(cr,cc-1),(cr,cc+1)):
                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc]=True; st.append((nr,nc))
    return n

def touch(mask):
    h,w=mask.shape
    pts=np.argwhere(mask)
    if len(pts)==0:return False
    rs=pts[:,0]; cs=pts[:,1]
    return (rs==0).any() and (rs==h-1).any() and (cs==0).any() and (cs==w-1).any()

def rand_path(h,w,max_steps=100):
    side='top'
    start=(0, random.randrange(w))
    path=[start]
    seen={start}
    while len(path)<max_steps:
        r,c=path[-1]
        opts=[]
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0<=nr<h and 0<=nc<w and (nr,nc) not in seen:
                opts.append((nr,nc))
        if not opts: break
        random.shuffle(opts)
        opts.sort(key=lambda p: ((p[0] in (0,h-1)) + (p[1] in (0,w-1))), reverse=True)
        nxt = opts[0] if random.random()<0.6 else random.choice(opts)
        path.append(nxt)
        seen.add(nxt)
        if len(path) >= 8 and path[-1][0] == 0 and touch(mask_from(path,h,w)):
            if random.random() < 0.5:
                break
    return mask_from(path,h,w)

def mask_from(path,h,w):
    m=np.zeros((h,w),dtype=bool)
    for r,c in path: m[r,c]=True
    return m

for h,w in [(5,5),(5,6),(6,6),(7,7)]:
    found=0
    for _ in range(20000):
        m=rand_path(h,w,max_steps=h*w-1)
        comp=~m
        if comps(m)==1 and comps(comp)==1 and touch(m) and touch(comp):
            found+=1
            print('found', (h,w), 'area', int(m.sum()))
            print(m.astype(int))
            break
    if not found:
        print('none', (h,w))
