+    opts: list[tuple[int, int, int, int, int, int]] = []
+    seen: set[tuple[int, int, int, int, int, int]] = set()
+    h_lo = max(ha, hb)
+    h_hi = min(total_area, ha + hb)
+
+    for H in range(h_lo, h_hi + 1):
+        if total_area % H != 0:
+            continue
+        W = total_area // H
+        if W < max(wa, wb) or W > wa + wb:
