+        for bt in range(H - hb + 1):
+            for bl in range(W - wb + 1):
+                emb_b = _embed(mask_b, H, W, bt, bl)
+                for at, al, emb_a in a_embeds:
+                    if bool((emb_a & emb_b).any()):
+                        continue
+                    if not bool((emb_a | emb_b).all()):
+                        continue
+                    item = (int(H), int(W), int(at), int(al), int(bt), int(bl))
+                    if item not in seen:
