+    r1 = int(rows.max())
+    c0 = int(cols.min())
+    c1 = int(cols.max())
+    color_vals = np.unique(grid[rows, cols])
+    assert len(color_vals) == 1
+    color = int(color_vals[0])
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[rows - r0, cols - c0] = True
+    return {
+        "color": color,
+        "coords": coords,
+        "bbox": (r0, c0, r1, c1),
+        "mask": mask,
+        "area": int(mask.sum()),
+    }
+
+
+def _mask_key(mask: np.ndarray) -> bytes:
+    return np.ascontiguousarray(mask.astype(np.uint8)).tobytes()
+
+
+def _winner(a: dict, b: dict) -> tuple[dict, dict]:
+    if int(a["area"]) > int(b["area"]):
+        return a, b
+    if int(b["area"]) > int(a["area"]):
+        return b, a
+    ar0, ac0, _ar1, _ac1 = a["bbox"]
+    br0, bc0, _br1, _bc1 = b["bbox"]
