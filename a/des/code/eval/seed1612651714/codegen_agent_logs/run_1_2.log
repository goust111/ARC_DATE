+    return grid
+
+
+def _render_expected(inp: np.ndarray, pair_infos: list[dict]) -> np.ndarray:
+    out = inp.copy()
+    for info in pair_infos:
+        frag_a = info["fragments"][0]
+        frag_b = info["fragments"][1]
+        live_a = {
+            "area": int(frag_a["area"]),
+            "bbox": frag_a["bbox"],
