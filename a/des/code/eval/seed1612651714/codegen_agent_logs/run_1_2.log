+def _embed(mask: np.ndarray, H: int, W: int, top: int, left: int) -> np.ndarray:
+    h, w = mask.shape
+    full = np.zeros((H, W), dtype=bool)
+    full[top : top + h, left : left + w] = mask
+    return full
