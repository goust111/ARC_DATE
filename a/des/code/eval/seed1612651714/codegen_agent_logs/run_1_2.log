+        for h in range(FULL_RECT_SIDE_RANGE[0], FULL_RECT_SIDE_RANGE[1] + 1)
+        for w in range(FULL_RECT_SIDE_RANGE[0], FULL_RECT_SIDE_RANGE[1] + 1)
