+    return True
+
+
+def _sample_position(
+    H: int,
+    W: int,
+    h: int,
+    w: int,
+    rects: list[tuple[int, int, int, int]],
+    *,
+    forbid_row: int | None = None,
+) -> tuple[int, int] | None:
+    candidates = [
+        (r, c)
+        for r in range(H - h + 1)
