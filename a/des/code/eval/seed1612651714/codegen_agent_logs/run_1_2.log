+def _position_candidates(H: int, W: int, h: int, w: int, rects: list[tuple[int, int, int, int]]) -> list[tuple[int, int]]:
+    out = [(r, c) for r in range(H - h + 1) for c in range(W - w + 1) if _rect_clear(rects, r, c, h, w)]
