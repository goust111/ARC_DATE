+from __future__ import annotations
+
+import math
+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+GEN_RETRIES = 400
+PAIR_COUNT_RANGE = (2, 4)
+RECT_SIDE_RANGE = (3, 6)
+MAX_GRID_SIDE = 30
