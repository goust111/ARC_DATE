+    full_dims: list[tuple[int, int]] = []
+    used: set[tuple[int, int]] = set()
+    for equal_area in branch_flags:
+        dim = _choose_full_dims(equal_area, used)
+        if dim is None:
+            return None
+        used.add(dim)
+        full_dims.append(dim)
