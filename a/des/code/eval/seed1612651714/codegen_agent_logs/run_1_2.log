import random
import numpy as np


def components(mask):
    h,w=mask.shape
    seen=np.zeros((h,w),dtype=bool)
    out=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            st=[(r,c)]
            seen[r,c]=True
            pts=[]
            while st:
                cr,cc=st.pop(); pts.append((cr,cc))
                for nr,nc in ((cr-1,cc),(cr+1,cc),(cr,cc-1),(cr,cc+1)):
                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc]=True; st.append((nr,nc))
            out.append(pts)
    return out

def touch_all(mask):
    h,w=mask.shape
    pts=np.argwhere(mask)
    if len(pts)==0: return False
    rs=pts[:,0]; cs=pts[:,1]
    return (rs==0).any() and (rs==h-1).any() and (cs==0).any() and (cs==w-1).any()

def rnd_connected(h,w,target):
    start=(random.randrange(h), random.randrange(w))
    cells={start}
    while len(cells)<target:
        frontier=[]
        for r,c in cells:
            for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
                if 0<=nr<h and 0<=nc<w and (nr,nc) not in cells:
                    frontier.append((nr,nc))
        if not frontier:
            return None
        # bias frontier that hits new borders
        random.shuffle(frontier)
        frontier.sort(key=lambda p: ((p[0] in (0,h-1)) + (p[1] in (0,w-1))), reverse=True)
        cells.add(frontier[0] if random.random()<0.7 else random.choice(frontier))
    m=np.zeros((h,w),dtype=bool)
    for r,c in cells: m[r,c]=True
    return m

for h in range(4,7):
  for w in range(4,7):
    area=h*w
    lo=h+w-1
    hi=area-lo
