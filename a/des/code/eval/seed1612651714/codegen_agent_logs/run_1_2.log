+                        "mask": crop_b,
+                        "offset": (int(off_b[0]), int(off_b[1])),
+                        "color": int(colors[2 * idx + 1]),
+                        "area": int(crop_b.sum()),
+                    },
+                ],
+            }
+        )
+    return infos, full_dims
