+    rem = int(total)
+    for i in range(n):
+        left = n - i - 1
+        cur_lo = max(lo, rem - left * hi)
+        cur_hi = min(hi, rem - left * lo)
+        if cur_lo > cur_hi:
+            return None
+        vals.append(random.randint(cur_lo, cur_hi))
+        rem -= vals[-1]
+    random.shuffle(vals)
