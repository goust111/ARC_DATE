+from __future__ import annotations
+
+import math
+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+GEN_RETRIES = 400
+PAIR_COUNT_RANGE = (2, 4)
+RECT_SIDE_RANGE = (3, 6)
+MAX_GRID_SIDE = 30
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    """Return 4-connected components as integer coordinate arrays."""
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(int(r), int(c))]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.asarray(pts, dtype=int))
+    return comps
+
+
+def _fragment_from_coords(grid: np.ndarray, coords: np.ndarray) -> dict:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    r0 = int(rows.min())
+    r1 = int(rows.max())
+    c0 = int(cols.min())
+    c1 = int(cols.max())
+    color_vals = np.unique(grid[rows, cols])
+    assert len(color_vals) == 1
+    color = int(color_vals[0])
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[rows - r0, cols - c0] = True
+    return {
+        "color": color,
+        "coords": coords,
+        "bbox": (r0, c0, r1, c1),
+        "mask": mask,
+        "area": int(mask.sum()),
+    }
+
+
+def _mask_key(mask: np.ndarray) -> bytes:
+    return np.ascontiguousarray(mask.astype(np.uint8)).tobytes()
+
+
+def _winner(a: dict, b: dict) -> tuple[dict, dict]:
+    if int(a["area"]) > int(b["area"]):
+        return a, b
+    if int(b["area"]) > int(a["area"]):
+        return b, a
+    ar0, ac0, _ar1, _ac1 = a["bbox"]
+    br0, bc0, _br1, _bc1 = b["bbox"]
+    if (int(ar0), int(ac0)) <= (int(br0), int(bc0)):
+        return a, b
+    return b, a
+
+
+def _pair_fragments(fragments: list[dict]) -> list[tuple[dict, dict]]:
+    by_shape: dict[tuple[int, int], list[dict]] = {}
+    for frag in fragments:
+        shape = tuple(int(x) for x in frag["mask"].shape)
+        by_shape.setdefault(shape, []).append(frag)
+
+    pairs: list[tuple[dict, dict]] = []
+    for group in by_shape.values():
+        buckets: dict[bytes, list[int]] = {}
+        for idx, frag in enumerate(group):
+            buckets.setdefault(_mask_key(frag["mask"]), []).append(idx)
+
+        used: set[int] = set()
+        for idx, frag in enumerate(group):
+            if idx in used:
+                continue
+            comp_key = _mask_key(~frag["mask"])
+            partner = None
+            for cand in buckets.get(comp_key, []):
+                if cand != idx and cand not in used:
+                    partner = cand
+                    break
+            if partner is None:
+                raise AssertionError("unmatched fragment")
+            used.add(idx)
+            used.add(partner)
+            pairs.append((frag, group[partner]))
+    return pairs
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Pair fragments by complementary shapes, then complete each anchor rectangle
+    using the larger fragment's color, or the upper fragment's color on ties.
+    """
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+
+    fragments = [_fragment_from_coords(g, comp) for comp in _components(g != BG)]
+    for a, b in _pair_fragments(fragments):
+        keep, move = _winner(a, b)
+        move_rows = move["coords"][:, 0]
+        move_cols = move["coords"][:, 1]
+        out[move_rows, move_cols] = BG
+
+        r0, c0, r1, c1 = keep["bbox"]
+        out[r0 : r1 + 1, c0 : c1 + 1] = int(keep["color"])
+
+    return out
+
+
+def _random_bounded_composition(total: int, n: int, lo: int, hi: int) -> list[int] | None:
+    if total < n * lo or total > n * hi:
+        return None
+    vals: list[int] = []
+    rem = int(total)
+    for i in range(n):
+        left = n - i - 1
+        cur_lo = max(lo, rem - left * hi)
+        cur_hi = min(hi, rem - left * lo)
+        if cur_lo > cur_hi:
+            return None
+        vals.append(random.randint(cur_lo, cur_hi))
+        rem -= vals[-1]
+    random.shuffle(vals)
+    return vals
+
+
+def _vertical_mask(h: int, w: int, target: int, straight: bool) -> np.ndarray | None:
+    if straight:
+        if target % h != 0:
+            return None
+        cut = target // h
+        if not (1 <= cut < w):
+            return None
+        mask = np.zeros((h, w), dtype=bool)
+        mask[:, :cut] = True
+        return mask
+    widths = _random_bounded_composition(target, h, 1, w - 1)
+    if widths is None:
+        return None
+    mask = np.zeros((h, w), dtype=bool)
+    for r, width in enumerate(widths):
+        mask[int(r), : int(width)] = True
+    return mask
+
+
+def _horizontal_mask(h: int, w: int, target: int, straight: bool) -> np.ndarray | None:
+    if straight:
+        if target % w != 0:
+            return None
+        cut = target // w
+        if not (1 <= cut < h):
+            return None
+        mask = np.zeros((h, w), dtype=bool)
+        mask[:cut, :] = True
+        return mask
+    heights = _random_bounded_composition(target, w, 1, h - 1)
+    if heights is None:
+        return None
+    mask = np.zeros((h, w), dtype=bool)
+    for c, height in enumerate(heights):
+        mask[: int(height), int(c)] = True
+    return mask
+
+
+def _make_complementary_masks(h: int, w: int, equal_area: bool) -> tuple[np.ndarray, np.ndarray] | None:
+    area = h * w
+    if equal_area and area % 2 == 1:
+        return None
+
+    for _ in range(80):
+        orientation = random.choice(["vertical", "horizontal"])
+        if orientation == "vertical":
+            lo, hi = h, h * (w - 1)
+        else:
+            lo, hi = w, (h - 1) * w
+        if lo > hi:
+            continue
+
+        if equal_area:
+            target = area // 2
+            if not (lo <= target <= hi):
+                continue
+        else:
+            candidates = [v for v in range(lo, hi + 1) if v * 2 != area]
+            if not candidates:
+                continue
+            target = random.choice(candidates)
+
+        if equal_area:
+            straight_ok = orientation == "vertical" and w % 2 == 0 or orientation == "horizontal" and h % 2 == 0
+        else:
+            straight_ok = True
+        straight = straight_ok and random.choice([True, False])
+
+        if orientation == "vertical":
+            mask = _vertical_mask(h, w, target, straight)
+        else:
+            mask = _horizontal_mask(h, w, target, straight)
+        if mask is None:
+            continue
+        comp = ~mask
+        if not bool(mask.any()) or not bool(comp.any()):
+            continue
+        if len(_components(mask)) != 1 or len(_components(comp)) != 1:
+            continue
+        if random.choice([True, False]):
+            return mask, comp
+        return comp, mask
+    return None
+
+
+def _mask_to_patch(mask: np.ndarray, color: int) -> np.ndarray:
+    patch = np.zeros(mask.shape, dtype=int)
+    patch[mask] = int(color)
+    return patch
+
+
+def _rect_clear(rects: list[tuple[int, int, int, int]], r0: int, c0: int, h: int, w: int) -> bool:
+    r1 = r0 + h - 1
+    c1 = c0 + w - 1
+    for rr0, cc0, rr1, cc1 in rects:
+        if not (r1 + 1 < rr0 or rr1 + 1 < r0 or c1 + 1 < cc0 or cc1 + 1 < c0):
+            return False
+    return True
+
+
+def _sample_position(
+    H: int,
+    W: int,
+    h: int,
+    w: int,
+    rects: list[tuple[int, int, int, int]],
+    *,
+    forbid_row: int | None = None,
+) -> tuple[int, int] | None:
+    candidates = [
+        (r, c)
+        for r in range(H - h + 1)
+        for c in range(W - w + 1)
+        if (forbid_row is None or r != forbid_row) and _rect_clear(rects, r, c, h, w)
+    ]
+    if not candidates:
+        return None
+    return random.choice(candidates)
+
+
+def _render_expected(inp: np.ndarray, pair_infos: list[dict]) -> np.ndarray:
+    out = inp.copy()
+    for info in pair_infos:
+        a = info["fragments"][0]
+        b = info["fragments"][1]
+        keep, move = _winner(a, b)
+        mr0, mc0 = int(move["r0"]), int(move["c0"])
+        move_mask = move["mask"]
+        rr, cc = np.argwhere(move_mask).T
+        out[mr0 + rr, mc0 + cc] = BG
+
+        kr0, kc0 = int(keep["r0"]), int(keep["c0"])
+        kh, kw = keep["mask"].shape
+        out[kr0 : kr0 + kh, kc0 : kc0 + kw] = int(keep["color"])
+    return out
+
+
+def _choose_pair_count() -> int:
+    return random.randint(PAIR_COUNT_RANGE[0], PAIR_COUNT_RANGE[1])
+
+
+def _choose_dims(equal_area: bool, used: set[tuple[int, int]]) -> tuple[int, int] | None:
+    dims = [
+        (h, w)
+        for h in range(RECT_SIDE_RANGE[0], RECT_SIDE_RANGE[1] + 1)
+        for w in range(RECT_SIDE_RANGE[0], RECT_SIDE_RANGE[1] + 1)
+        if (h, w) not in used and (not equal_area or (h * w) % 2 == 0)
+    ]
+    if not dims:
+        return None
+    return random.choice(dims)
+
+
+def _grid_shape(dims: list[tuple[int, int]]) -> tuple[int, int] | None:
+    footprint = sum(2 * (h + 2) * (w + 2) for h, w in dims)
+    side = int(math.ceil(math.sqrt(float(footprint))))
+    max_h = max(h for h, _w in dims)
+    max_w = max(w for _h, w in dims)
+
+    H_min = max(12, max_h + 2, side - 2)
+    W_min = max(12, max_w + 2, side - 2)
+    H_max = min(MAX_GRID_SIDE, H_min + 8)
+    W_max = min(MAX_GRID_SIDE, W_min + 8)
+    if H_min > H_max or W_min > W_max:
+        return None
+    return random.randint(H_min, H_max), random.randint(W_min, W_max)
+
+
+def _build_pair_infos() -> tuple[list[dict], list[tuple[int, int]]] | None:
+    pair_count = _choose_pair_count()
+    branch_flags = [True, False]
+    branch_flags.extend(random.choice([True, False]) for _ in range(pair_count - 2))
+    random.shuffle(branch_flags)
+
+    dims: list[tuple[int, int]] = []
+    used_dims: set[tuple[int, int]] = set()
+    for equal_area in branch_flags:
+        dim = _choose_dims(equal_area, used_dims)
+        if dim is None:
+            return None
+        used_dims.add(dim)
+        dims.append(dim)
+
+    colors = random.sample(PALETTE, 2 * pair_count)
+    infos: list[dict] = []
+    for idx, (equal_area, (h, w)) in enumerate(zip(branch_flags, dims, strict=False)):
+        masks = _make_complementary_masks(h, w, equal_area)
+        if masks is None:
+            return None
+        infos.append(
+            {
+                "equal_area": bool(equal_area),
+                "fragments": [
+                    {
+                        "mask": masks[0],
+                        "color": int(colors[2 * idx]),
+                        "area": int(masks[0].sum()),
+                    },
+                    {
+                        "mask": masks[1],
+                        "color": int(colors[2 * idx + 1]),
+                        "area": int(masks[1].sum()),
+                    },
+                ],
+            }
+        )
+    return infos, dims
+
+
+def _place_pairs(H: int, W: int, pair_infos: list[dict]) -> np.ndarray | None:
+    grid = np.zeros((H, W), dtype=int)
+    rects: list[tuple[int, int, int, int]] = []
+
+    order = list(range(len(pair_infos)))
+    random.shuffle(order)
+    for idx in order:
+        info = pair_infos[idx]
+        frag_a, frag_b = info["fragments"]
+        h, w = frag_a["mask"].shape
+
+        pos_a = _sample_position(H, W, h, w, rects)
+        if pos_a is None:
+            return None
+        rects.append((pos_a[0], pos_a[1], pos_a[0] + h - 1, pos_a[1] + w - 1))
+
+        forbid_row = pos_a[0] if bool(info["equal_area"]) else None
+        pos_b = _sample_position(H, W, h, w, rects, forbid_row=forbid_row)
+        if pos_b is None:
+            return None
+        rects.append((pos_b[0], pos_b[1], pos_b[0] + h - 1, pos_b[1] + w - 1))
+
+        for frag, (r0, c0) in zip((frag_a, frag_b), (pos_a, pos_b), strict=False):
+            patch = _mask_to_patch(frag["mask"], int(frag["color"]))
+            grid[r0 : r0 + h, c0 : c0 + w] = np.maximum(grid[r0 : r0 + h, c0 : c0 + w], patch)
+            frag["r0"] = int(r0)
+            frag["c0"] = int(c0)
+            frag["bbox"] = (int(r0), int(c0), int(r0 + h - 1), int(c0 + w - 1))
+
+    return grid
+
+
+def _gen_attempt() -> np.ndarray | None:
+    built = _build_pair_infos()
+    if built is None:
+        return None
+    pair_infos, dims = built
+    shape = _grid_shape(dims)
+    if shape is None:
+        return None
+    H, W = shape
+    inp = _place_pairs(H, W, pair_infos)
+    if inp is None:
+        return None
+
+    expected = _render_expected(inp, pair_infos)
+    if len(_components(inp != BG)) != 2 * len(pair_infos):
+        return None
+    if not np.array_equal(main(inp), expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

