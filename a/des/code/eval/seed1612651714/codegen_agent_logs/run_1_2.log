/bin/bash -lc "python - <<'PY'
from z3 import *


def solve(h,w,target,timeout_ms=10000):
    n=h*w
    x=[[Bool(f'x_{r}_{c}') for c in range(w)] for r in range(h)]
    rootA=[[Bool(f'ra_{r}_{c}') for c in range(w)] for r in range(h)]
    rootB=[[Bool(f'rb_{r}_{c}') for c in range(w)] for r in range(h)]
    ordA=[[Int(f'oa_{r}_{c}') for c in range(w)] for r in range(h)]
    ordB=[[Int(f'ob_{r}_{c}') for c in range(w)] for r in range(h)]
    s=Solver()
    s.set(timeout=timeout_ms)
    cells=[x[r][c] for r in range(h) for c in range(w)]
    s.add(Sum([If(c,1,0) for c in cells]) == target)
    s.add(Sum([If(rootA[r][c],1,0) for r in range(h) for c in range(w)]) == 1)
    s.add(Sum([If(rootB[r][c],1,0) for r in range(h) for c in range(w)]) == 1)

    def neigh(r,c):
        out=[]
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0<=nr<h and 0<=nc<w:
                out.append((nr,nc))
        return out

    for r in range(h):
        for c in range(w):
            s.add(Implies(rootA[r][c], x[r][c]))
            s.add(Implies(rootB[r][c], Not(x[r][c])))
            s.add(If(x[r][c], And(ordA[r][c] >= 1, ordA[r][c] <= target), ordA[r][c] == 0))
            s.add(If(Not(x[r][c]), And(ordB[r][c] >= 1, ordB[r][c] <= h*w-target), ordB[r][c] == 0))
            s.add(Implies(rootA[r][c], ordA[r][c] == 1))
            s.add(Implies(rootB[r][c], ordB[r][c] == 1))

            smallerA=[]
            smallerB=[]
            for nr,nc in neigh(r,c):
                smallerA.append(And(x[nr][nc], ordA[nr][nc] < ordA[r][c]))
                smallerB.append(And(Not(x[nr][nc]), ordB[nr][nc] < ordB[r][c]))
            s.add(Implies(And(x[r][c], Not(rootA[r][c])), Or(*smallerA)))
            s.add(Implies(And(Not(x[r][c]), Not(rootB[r][c])), Or(*smallerB)))

    # touch all 4 sides for both sets
    s.add(Or(*[x[0][c] for c in range(w)]))
    s.add(Or(*[x[h-1][c] for c in range(w)]))
    s.add(Or(*[x[r][0] for r in range(h)]))
    s.add(Or(*[x[r][w-1] for r in range(h)]))
    s.add(Or(*[Not(x[0][c]) for c in range(w)]))
    s.add(Or(*[Not(x[h-1][c]) for c in range(w)]))
    s.add(Or(*[Not(x[r][0]) for r in range(h)]))
    s.add(Or(*[Not(x[r][w-1]) for r in range(h)]))

    if s.check() "'!= sat:
        return None
    m=s.model()
    arr=[[1 if is_true(m.evaluate(x[r][c])) else 0 for c in range(w)] for r in range(h)]
    return arr

for h,w in [(5,5),(5,6),(6,6),(5,7),(6,7),(7,7),(6,8)]:
    area=h*w
    print('"'DIM',h,w)
    for target in sorted(set([area//2, area//2-1, area//2+1, h+w-1, area-(h+w-1)])):
        if not (1 <= target < area):
            continue
        arr=solve(h,w,target)
        print(' target',target,'ok',arr is not None)
        if arr is not None:
            for row in arr:
                print(''.join(map(str,row)))
            break
