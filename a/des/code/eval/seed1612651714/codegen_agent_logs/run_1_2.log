+    Each option is:
+      (full_h, full_w, a_top, a_left, b_top, b_left)
+    """
+    mask_a = a["mask"]
+    mask_b = b["mask"]
+    ha, wa = mask_a.shape
+    hb, wb = mask_b.shape
+    total_area = int(a["area"]) + int(b["area"])
