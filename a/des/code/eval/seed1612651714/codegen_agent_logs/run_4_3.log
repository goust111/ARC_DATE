+        elif direction == "left" and r0 <= fr <= r1 and c1 < fc:
+            dist = int(fc - c1 - 1)
+        elif direction == "down" and c0 <= fc <= c1 and fr < r0:
+            dist = int(r0 - fr - 1)
+        elif direction == "up" and c0 <= fc <= c1 and r1 < fr:
