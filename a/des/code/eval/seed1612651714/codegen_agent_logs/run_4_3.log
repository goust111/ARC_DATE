+                cells = _arrow_cells("right", row, -gap - 1, bend)
+            elif side == "right":
+                row = random.randrange(h)
+                cells = _arrow_cells("left", row, w + gap, bend)
+            elif side == "top":
+                col = random.randrange(w)
+                cells = _arrow_cells("down", -gap - 1, col, bend)
+            else:
+                col = random.randrange(w)
+                cells = _arrow_cells("up", h + gap, col, bend)
