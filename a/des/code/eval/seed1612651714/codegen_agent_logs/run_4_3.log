+            gap = random.randint(*ARROW_GAP_RANGE)
+            bend = random.choice((-1, 1))
+            if side == "left":
+                row = random.randrange(h)
+                cells = _arrow_cells("right", row, -gap - 1, bend)
+            elif side == "right":
+                row = random.randrange(h)
+                cells = _arrow_cells("left", row, w + gap, bend)
+            elif side == "top":
