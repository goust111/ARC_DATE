+GRID_HEIGHT_RANGE = (20, 30)
+GRID_WIDTH_RANGE = (20, 30)
+OBJECT_COUNT_CHOICES = (2, 3)
+RECT_HEIGHT_RANGE = (2, 4)
+RECT_WIDTH_RANGE = (2, 5)
+ARROW_GAP_RANGE = (1, 3)
+GENERATION_ATTEMPTS = 400
+PLACEMENT_ATTEMPTS = 200
