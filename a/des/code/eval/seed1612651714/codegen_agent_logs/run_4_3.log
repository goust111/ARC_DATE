+
+    random.shuffle(plans)
+    grid = np.full((h, w), int(bg), dtype=int)
+    taken = np.zeros((h, w), dtype=bool)
+    for plan in plans:
+        if not _place_plan(grid, taken, plan):
+            return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
