+    for arrow in arrows:
+        arrows_by_rect[_arrow_target_index(arrow, rects)].append(arrow)
+
+    out = g.copy()
+    for arrow in arrows:
+        for r, c in arrow["coords"]:
+            out[r, c] = int(bg)
