+
+def _extract_scene(grid: np.ndarray) -> tuple[int, list[dict], list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    rects: list[dict] = []
+    arrows: list[dict] = []
