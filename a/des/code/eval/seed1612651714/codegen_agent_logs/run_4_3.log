+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        try:
+            grid = _attempt_input()
+            if grid is None:
+                continue
+            out = main(grid)
+            if out.shape != grid.shape:
+                continue
+            if np.array_equal(out, grid):
+                continue
+            return grid
+        except Exception:
+            continue
+    raise RuntimeError("failed to generate a valid input")

