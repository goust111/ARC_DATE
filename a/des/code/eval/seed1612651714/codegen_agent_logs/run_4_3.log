+
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+SIDES = ("left", "right", "top", "bottom")
+
+# --------------- shared geometry ---------------
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(vals[np.argmax(counts)])
