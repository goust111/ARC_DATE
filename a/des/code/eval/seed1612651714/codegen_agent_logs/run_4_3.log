+    taken = np.zeros((h, w), dtype=bool)
+    for plan in plans:
+        if not _place_plan(grid, taken, plan):
+            return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        try:
