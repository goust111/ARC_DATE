+def _place_plan(grid: np.ndarray, taken: np.ndarray, plan: dict) -> bool:
+    h, w = grid.shape
+    r0, c0, r1, c1 = plan["pack_bbox"]
+    row_lo = int(-r0)
+    row_hi = int(h - 1 - r1)
+    col_lo = int(-c0)
+    col_hi = int(w - 1 - c1)
+    if row_lo > row_hi or col_lo > col_hi:
+        return False
