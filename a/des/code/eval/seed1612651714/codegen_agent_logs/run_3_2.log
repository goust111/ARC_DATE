+    outer_h = inner_h + 2
+    outer_w = inner_w + 2
+    gap = random.choice(GAP_OPTIONS)
+    shift = gap // 2
+    orientation = random.choice(("horizontal", "vertical"))
+
+    if orientation == "horizontal":
