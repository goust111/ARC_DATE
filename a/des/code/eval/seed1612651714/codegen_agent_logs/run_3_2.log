+def _paint_patch(grid: np.ndarray, patch: np.ndarray, top: int, left: int, bg: int) -> None:
+    ph, pw = patch.shape
+    view = grid[top : top + ph, left : left + pw]
+    mask = patch != bg
+    view[mask] = patch[mask]
