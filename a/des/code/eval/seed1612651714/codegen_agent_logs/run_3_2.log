+
+    h_lo = max(10, max_h + 3, base_side - 2)
+    w_lo = max(10, max_w + 3, palette_len + 2, base_side - 2)
+    h_hi = min(GRID_LIMIT, max(h_lo, base_side + 4))
+    w_hi = min(GRID_LIMIT, max(w_lo, base_side + 4))
