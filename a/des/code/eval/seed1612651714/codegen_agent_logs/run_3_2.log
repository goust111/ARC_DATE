+                border.add((r, c))
+
+    holes = {
+        (r, c)
+        for r in range(frame_top + 1, frame_top + outer_h - 1)
+        for c in range(frame_left + 1, frame_left + outer_w - 1)
+    }
+    assert len(holes) == area
