+def _candidate_positions(blocked: np.ndarray, shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = blocked.shape
+    ph, pw = shape
+    positions: list[tuple[int, int]] = []
+    for r in range(h - ph + 1):
+        for c in range(w - pw + 1):
+            r0 = max(0, r - 1)
+            r1 = min(h, r + ph + 1)
