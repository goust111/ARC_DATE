+def _hole_cells(coords: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
