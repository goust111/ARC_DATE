+    for r in range(h - ph + 1):
+        for c in range(w - pw + 1):
+            r0 = max(0, r - 1)
+            r1 = min(h, r + ph + 1)
+            c0 = max(0, c - 1)
+            c1 = min(w, c + pw + 1)
