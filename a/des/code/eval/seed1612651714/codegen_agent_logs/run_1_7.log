+    out = g.copy()
+    for key in keys:
+        for r, c in key["coords"]:
+            out[int(r), int(c)] = int(bg)
+
+    for lock in locks:
+        matched = key_by_shape[lock["shape_key"]]
+        color = int(matched["color"])
+        for r, c in lock["hole"]:
+            out[int(r), int(c)] = color
+
+    return out
