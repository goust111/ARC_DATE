+_BG = 0
+_LOCK = 5
+_KEY_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+_GRID_MIN = 18
+_GRID_MAX = 30
+_MAX_GEN_ATTEMPTS = 400
+_PLACE_ATTEMPTS = 80
