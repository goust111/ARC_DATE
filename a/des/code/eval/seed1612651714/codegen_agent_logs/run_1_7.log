+    add_frontier(*start)
+    while int(mask.sum()) < int(area):
+        assert frontier
+        idx = int(_RNG.integers(len(frontier)))
+        cell = list(frontier)[idx]
+        frontier.remove(cell)
+        rr, cc = cell
+        mask[rr, cc] = True
+        add_frontier(rr, cc)
+    return mask
