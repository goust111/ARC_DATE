+def _build_lock_patch(hole_mask: np.ndarray, side: str) -> tuple[np.ndarray, list[tuple[int, int]]]:
+    hole_mask = np.asarray(hole_mask, dtype=bool)
+    hole_h, hole_w = map(int, hole_mask.shape)
