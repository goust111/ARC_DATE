+
+def _coords_to_mask(coords: list[tuple[int, int]], shape: tuple[int, int]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for r, c in coords:
+        mask[int(r), int(c)] = True
+    return mask
