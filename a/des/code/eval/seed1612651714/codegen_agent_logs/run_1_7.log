+            for rr, cc in lock["hole_coords"]:
+                expected[int(lock_r0 + rr), int(lock_c0 + cc)] = int(pair["color"])
+
+        if np.array_equal(main(inp), expected):
+            return inp, expected
+
+    raise RuntimeError("failed to generate a valid puzzle instance")
+
