+    choices: list[tuple[int, int]] = []
+    for h in range(max(int(_GRID_MIN), max_h), int(_GRID_MAX) + 1):
+        for w in range(max(int(_GRID_MIN), max_w), int(_GRID_MAX) + 1):
+            if h * w >= int(np.ceil(reserved_area * 1.1)):
+                choices.append((int(h), int(w)))
