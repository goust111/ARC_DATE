+        assert len(colors) == 1
+        color = int(next(iter(colors)))
+        r0, c0, r1, c1 = _bbox(comp)
+        local = np.zeros((int(r1 - r0 + 1), int(c1 - c0 + 1)), dtype=bool)
+        for r, c in comp:
