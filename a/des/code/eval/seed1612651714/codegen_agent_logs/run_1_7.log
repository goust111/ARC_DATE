+        hole_global = [(int(r0 + rr), int(c0 + cc)) for rr, cc in hole_local_coords]
+        locks.append({"shape_key": _canonical_rot_key(hole_mask), "hole": hole_global})
+
+    assert locks
+    keys = []
+    for comp in _components((g != int(bg)) & (g != int(lock_color))):
