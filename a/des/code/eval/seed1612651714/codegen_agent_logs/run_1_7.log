+def _has_enclosed_void(mask: np.ndarray) -> bool:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    for comp in _components(~mask):
+        if any(r == 0 or r == h - 1 or c == 0 or c == w - 1 for r, c in comp):
