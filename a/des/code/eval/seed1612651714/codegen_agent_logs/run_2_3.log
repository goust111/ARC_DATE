+    grid[r0 : r0 + h, c0 + w - 1] = FRAME
+    grid[r0, c0 : c0 + w] = FRAME
+    grid[r0 + h - 1, c0 : c0 + w] = FRAME
+
+
+def _render_case(
+    H: int,
+    W: int,
+    regions: list[dict],
+    placements: list[tuple[int, int]],
+    frame_rect: tuple[int, int, int, int],
+) -> tuple[np.ndarray, np.ndarray]:
