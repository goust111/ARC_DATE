+                continue
+            box = grid[r0 : r1 + 1, c0 : c1 + 1]
+            border = _boundary_mask(h, w)
+            if len(comp) != int(border.sum()):
+                continue
+            if not np.all(box[border] == color):
+                continue
+            if not np.all(box[~border] == BG):
+                continue
