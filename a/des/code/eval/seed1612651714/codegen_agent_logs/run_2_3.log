+            orbit = {(r, c), (rr, cc)}
+            for cell in orbit:
+                seen.add(cell)
+            orbits.append(tuple(sorted(orbit)))
+    return orbits
+
+
+def _make_pattern_mask(
+    h: int,
+    w: int,
