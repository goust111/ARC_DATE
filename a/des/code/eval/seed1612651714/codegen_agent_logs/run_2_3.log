+    area = h * w
+    cap = min(max(2, area // 3), max(2, (area - noise_count - 1) // 2))
+    pair_orbits = [orbit for orbit in orbits if len(orbit) == 2]
+    single_orbits = [orbit for orbit in orbits if len(orbit) == 1]
+    if not pair_orbits or cap < 2:
+        return None
+
+    for _ in range(80):
