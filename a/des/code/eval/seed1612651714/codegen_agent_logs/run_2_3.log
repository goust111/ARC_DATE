+def _find_collection_frame(grid: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    best = None
+    for color in np.unique(grid):
+        color = int(color)
+        if color == BG:
+            continue
+        for comp in _components(grid == color):
+            r0, r1, c0, c1 = _bbox(comp)
+            h, w = r1 - r0 + 1, c1 - c0 + 1
