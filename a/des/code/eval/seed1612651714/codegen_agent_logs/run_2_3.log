+            inp[r, c] = noise_color
+        else:
+            pattern_cells = int(pattern_mask.sum())
+            main_cells = h * w - pattern_cells - len(noise_positions)
+            if main_cells > pattern_cells and main_cells > len(noise_positions):
+                return {
+                    "h": h,
+                    "w": w,
+                    "input": inp,
+                    "clean": clean,
+                    "noise_color": noise_color,
+                    "noise_positions": noise_positions,
+                }
+    return None
+
