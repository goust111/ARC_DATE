+    inner_h = fr1 - fr0 - 1
+    inner_w = fc1 - fc0 - 1
+    for r, c, color in collected:
+        if 0 <= r < inner_h and 0 <= c < inner_w:
+            tr, tc = fr0 + 1 + r, fc0 + 1 + c
+            if out[tr, tc] in (BG, color):
