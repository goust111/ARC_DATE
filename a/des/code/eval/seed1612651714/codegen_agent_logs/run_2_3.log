+    """
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+
+    frame_coords, (fr0, fr1, fc0, fc1) = _find_collection_frame(g)
+    frame_mask = np.zeros_like(g, dtype=bool)
+    frame_mask[tuple(frame_coords.T)] = True
+    out[fr0 + 1 : fr1, fc0 + 1 : fc1] = BG
+
