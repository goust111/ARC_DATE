+        for r in range(h):
+            for c in range(w):
+                rr, cc = h - 1 - r, w - 1 - c
+                here = int(block[r, c])
+                there = int(block[rr, cc])
+                if here != there and here != main_color and there == main_color:
+                    out[r0 + r, c0 + c] = main_color
+                    collected.append((r, c, here))
