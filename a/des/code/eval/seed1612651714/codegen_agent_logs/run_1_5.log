+        for r, c in candidates[:400]:
+            rr0 = max(0, r - 1)
+            cc0 = max(0, c - 1)
+            rr1 = min(TEMP_CANVAS, r + gh + 1)
+            cc1 = min(TEMP_CANVAS, c + gw + 1)
+            if reserved[rr0:rr1, cc0:cc1].any():
