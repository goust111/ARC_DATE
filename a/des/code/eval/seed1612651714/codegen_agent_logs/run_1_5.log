+                    (comps[j]["bbox"][2] - comps[j]["bbox"][0] + 1)  # type: ignore[index]
+                    * (comps[j]["bbox"][3] - comps[j]["bbox"][1] + 1),  # type: ignore[index]
+                    comps[j]["bbox"],  # type: ignore[index]
+                ),
+            )
+            parents[i] = parent
+            children[parent].append(i)
