+    grid = _place_groups(rng, groups)
+    if grid is None:
+        return None
+    if set(int(x) for x in np.unique(grid)) & set(PROGRAM_COLORS) != set(PROGRAM_COLORS):
+        return None
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+    if out.shape != grid.shape or not np.any(out != BG):
+        return None
+    return grid
