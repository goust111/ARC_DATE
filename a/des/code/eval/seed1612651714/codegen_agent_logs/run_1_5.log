+        (h, w)
+        for h in range(2, limit + 1)
+        for w in range(2, limit + 1)
+        if h * w >= 6 and max(h, w) >= 3
+    ]
+    if not dims:
+        return None
+    nonsquare = [dim for dim in dims if dim[0] != dim[1]]
+    pool = nonsquare if nonsquare and rng.random() < 0.75 else dims
+    return rng.choice(pool)
