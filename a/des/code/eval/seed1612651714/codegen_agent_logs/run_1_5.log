+        innermost = comps[chain[-1]]
+        r0, c0, r1, c1 = innermost["bbox"]  # type: ignore[assignment]
+        inner = g[int(r0) + 1 : int(r1), int(c0) + 1 : int(c1)]
+        sprite = _crop_non_bg(inner)
+        assert sprite.size > 0
