+    roots = sorted((i for i in border_indices if parents[i] is None), key=lambda i: comps[i]["bbox"])  # type: ignore[index]
+    for root in roots:
+        chain = [root]
+        cur = root
+        while children[cur]:
+            assert len(children[cur]) == 1
+            cur = children[cur][0]
+            chain.append(cur)
