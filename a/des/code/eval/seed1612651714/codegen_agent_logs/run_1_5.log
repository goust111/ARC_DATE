+        inner_h = int(r1 - r0 - 1)
+        inner_w = int(c1 - c0 - 1)
+        th, tw = transformed.shape
+        assert th <= inner_h and tw <= inner_w
+        sr = int(r0) + 1 + (inner_h - th) // 2
+        sc = int(c0) + 1 + (inner_w - tw) // 2
+        mask = transformed != BG
+        out[sr : sr + th, sc : sc + tw][mask] = transformed[mask]
