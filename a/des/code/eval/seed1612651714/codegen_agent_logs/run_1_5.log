+    palette = rng.sample(SPRITE_COLORS, palette_size)
+    for idx, (r, c) in enumerate(cells):
+        if idx < palette_size:
+            color = palette[idx]
+        else:
+            color = rng.choice(palette)
+        patch[r, c] = int(color)
+    return patch
+
+
+def _has_border_like_component(arr: np.ndarray) -> bool:
