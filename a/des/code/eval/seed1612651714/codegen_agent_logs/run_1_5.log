+            r0, c0 = inset, inset
+            r1, c1 = outer_h - 1 - inset, outer_w - 1 - inset
+            patch[r0, c0 : c1 + 1] = int(color)
+            patch[r1, c0 : c1 + 1] = int(color)
+            patch[r0 : r1 + 1, c0] = int(color)
