        fill_color = bands[(i + 1) % len(bands)][2]
        band = out[:, c0 : c1 + 1]
        band[band == bg] = fill_color
    return out


def _gen_attempt() -> np.ndarray | None:
    rows = random.randint(*GRID_ROWS_RANGE)
    cols = random.randint(*GRID_COLS_RANGE)
