+    for block in blocks:
+        r0, c0, r1, c1 = block["bbox"]
+        patch = block["pattern"].copy()
+        ordered = sorted(
+            block["arrows"],
+            key=lambda item: (int(item["distance"]), SIDE_ORDER[str(item["side"])]),
+        )
+        for arrow in ordered:
+            patch = _apply_transform(patch, int(arrow["color"]))
+        out[r0 : r1 + 1, c0 : c1 + 1] = patch
