+    comps = _components8(g != BG)
+    square_candidates: list[dict] = []
+    arrows: list[dict] = []
+    for coords in comps:
+        colors = {int(g[r, c]) for r, c in coords}
+        if len(coords) == 3 and len(colors) == 1:
+            color = next(iter(colors))
