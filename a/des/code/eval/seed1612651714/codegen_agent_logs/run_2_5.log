+def _crop_with_border(inp: np.ndarray, expected: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    pts = np.argwhere(inp != BG)
+    r0 = int(pts[:, 0].min())
+    c0 = int(pts[:, 1].min())
+    r1 = int(pts[:, 0].max())
+    c1 = int(pts[:, 1].max())
