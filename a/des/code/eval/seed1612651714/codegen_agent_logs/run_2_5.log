+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Apply arrow-colored geometric transforms to square pattern blocks, erasing the arrows.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
