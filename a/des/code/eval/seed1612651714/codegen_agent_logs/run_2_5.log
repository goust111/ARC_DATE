+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+ARROW_COLORS = (BLUE, RED, GREEN, YELLOW)
+PATTERN_COLORS = (5, 6, 7, 8, 9)
+BLOCK_SIZES = (4, 5)
+SIDES = ("top", "right", "bottom", "left")
+SIDE_ORDER = {"top": 0, "right": 1, "bottom": 2, "left": 3}
+SIDE_TO_VEC = {
+    "top": (1, 0),
+    "right": (0, -1),
+    "bottom": (-1, 0),
+    "left": (0, 1),
+}
+GEN_ATTEMPTS = 400
