+    r_lines = [pad_t]
+    for gap in row_gaps:
+        r_lines.append(r_lines[-1] + gap + 1)
+    c_lines = [pad_l]
+    for gap in col_gaps:
+        c_lines.append(c_lines[-1] + gap + 1)
