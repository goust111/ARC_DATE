+    bottom = _uniform_color(grid[r1 + 1, c0 : c1 + 1])
+    left = _uniform_color(grid[r0 : r1 + 1, c0 - 1])
+    right = _uniform_color(grid[r0 : r1 + 1, c1 + 1])
+
