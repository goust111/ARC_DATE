+    if len(dominant_colors) < 2:
+        return False
+    if 2 not in distinct_wall_counts:
+        return False
+    if len(PRIORITY_ORDER) >= 3 and 3 not in distinct_wall_counts and len(dominant_colors) >= 3:
+        return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
