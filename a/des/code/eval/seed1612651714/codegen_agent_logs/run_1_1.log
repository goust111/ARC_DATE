+def _room_side_colors(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = bbox
+    h, w = grid.shape
+    assert r0 >= 2 and c0 >= 2 and r1 + 2 < h and c1 + 2 < w, "room too close to edge"
+
