+
+
+def _build_horizontal_assembly(rng: random.Random) -> tuple[np.ndarray, dict]:
+    n = rng.randint(3, 5)
+    gap_left = rng.randint(1, 4)
+    gap_right = rng.randint(1, 4)
+    route_above = rng.random() < 0.5
+    port_a = rng.randrange(n)
+    port_b = rng.randrange(n)
+
