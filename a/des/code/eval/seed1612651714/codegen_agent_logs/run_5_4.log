+def _choose_pairs(
+    rect_maps: list[dict[tuple[int, int], list[tuple[int, int, int, int]]]],
+    rng: random.Random,
+) -> list[tuple[int, int, tuple[int, int, int, int], tuple[int, int, int, int]]]:
+    n = len(rect_maps)
+    if n < 2:
+        return []
+    desired = 2 if n >= 4 and rng.random() < 0.5 else 1
