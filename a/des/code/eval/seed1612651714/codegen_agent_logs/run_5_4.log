+    for c in range(1, w - 1):
+        v = int(grid[0, c])
+        if v != bg:
+            x = c - c0
+            assert 1 <= x <= iw - 1
+            markers[v]["top"].append(x)
+        v = int(grid[h - 1, c])
+        if v != bg:
+            x = c - c0
+            assert 1 <= x <= iw - 1
+            markers[v]["bottom"].append(x)
+
+    for r in range(1, h - 1):
+        v = int(grid[r, 0])
+        if v != bg:
+            y = r - r0
+            assert 1 <= y <= ih - 1
+            markers[v]["left"].append(y)
+        v = int(grid[r, w - 1])
+        if v != bg:
+            y = r - r0
+            assert 1 <= y <= ih - 1
+            markers[v]["right"].append(y)
