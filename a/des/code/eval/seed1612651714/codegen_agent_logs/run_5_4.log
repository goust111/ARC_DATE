+    if "bottom" in exits:
+        grid[-1, c0 + exits["bottom"]] = color
+    if "left" in exits:
+        grid[r0 + exits["left"], 0] = color
+    if "right" in exits:
+        grid[r0 + exits["right"], -1] = color
