+def _regions_from_blocks(
+    ih: int, iw: int, vert: np.ndarray, horiz: np.ndarray
+) -> list[list[tuple[int, int]]]:
+    seen = np.zeros((ih, iw), dtype=bool)
+    regions: list[list[tuple[int, int]]] = []
