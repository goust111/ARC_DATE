+def _region_rectangles(
+    cells: list[tuple[int, int]], ih: int, iw: int
+) -> dict[tuple[int, int], list[tuple[int, int, int, int]]]:
+    mask = np.zeros((ih, iw), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
