+    for sr in range(ih):
+        for sc in range(iw):
+            if seen[sr, sc]:
+                continue
+            seen[sr, sc] = True
+            q = deque([(sr, sc)])
+            cells: list[tuple[int, int]] = []
+            while q:
+                r, c = q.popleft()
+                cells.append((r, c))
+                if r > 0 and not horiz[r - 1, c] and not seen[r - 1, c]:
+                    seen[r - 1, c] = True
+                    q.append((r - 1, c))
+                if r + 1 < ih and not horiz[r, c] and not seen[r + 1, c]:
+                    seen[r + 1, c] = True
+                    q.append((r + 1, c))
+                if c > 0 and not vert[r, c - 1] and not seen[r, c - 1]:
+                    seen[r, c - 1] = True
+                    q.append((r, c - 1))
+                if c + 1 < iw and not vert[r, c] and not seen[r, c + 1]:
+                    seen[r, c + 1] = True
+                    q.append((r, c + 1))
