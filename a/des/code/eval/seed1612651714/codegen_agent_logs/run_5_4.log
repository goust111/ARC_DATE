+def _add_vertical(vert: np.ndarray, x: int, y0: int, y1: int) -> None:
+    for r in range(y0, y1):
+        vert[r, x - 1] = True
+
+
+def _add_horizontal(horiz: np.ndarray, y: int, x0: int, x1: int) -> None:
+    for c in range(x0, x1):
+        horiz[y - 1, c] = True
