+    "horiz",
+    "L_tl",
+    "L_tr",
+    "L_bl",
+    "L_br",
+    "L_tl",
+    "L_tr",
+    "L_bl",
+    "L_br",
+    "T_top",
+    "T_bottom",
+    "T_left",
+    "T_right",
+    "T_top",
+    "T_bottom",
+    "T_left",
+    "T_right",
+    "plus",
