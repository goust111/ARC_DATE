+    cols = [c for _, c in cells]
+    for r0 in range(min(rows), max(rows) + 1):
+        for c0 in range(min(cols), max(cols) + 1):
+            if not mask[r0, c0]:
+                continue
+            for h in range(1, min(4, ih - r0) + 1):
+                for w in range(1, min(4, iw - c0) + 1):
+                    area = h * w
+                    if area < 2 or area > size_cap:
+                        continue
