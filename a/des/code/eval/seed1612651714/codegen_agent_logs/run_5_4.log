+def _collect_markers(
+    grid: np.ndarray, bg: int, r0: int, c0: int, r1: int, c1: int
+) -> dict[int, dict[str, list[int]]]:
+    h, w = grid.shape
+    ih = r1 - r0 + 1
+    iw = c1 - c0 + 1
+    markers: dict[int, dict[str, list[int]]] = defaultdict(
+        lambda: {"top": [], "bottom": [], "left": [], "right": []}
+    )
