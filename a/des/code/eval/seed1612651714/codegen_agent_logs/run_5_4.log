+
+def _component_nodes(spec: dict[str, int | str], ih: int, iw: int) -> set[tuple[int, int]]:
+    nodes: set[tuple[int, int]] = set()
+    for axis, a, b0, b1 in _component_segments(spec, ih, iw):
+        if axis == "v":
+            for y in range(b0, b1 + 1):
