+    rng: random.Random,
+) -> tuple[np.ndarray, list[dict]] | None:
+    reserve_boxes: list[tuple[int, int, int, int]] = []
+    records: list[dict] = []
+
+    for key in assignments:
+        pattern = patterns[key]
+        for _ in range(PLACEMENT_ATTEMPTS):
+            mask = _make_region_mask(int(pattern.shape[0]), rng)
+            if mask is None:
+                return None
