+def dilated_bbox_free(mask: np.ndarray, r0: int, c0: int, hh: int, ww: int, pad: int = 1) -> bool:
+    h, w = mask.shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h, r0 + hh + pad)
+    cc1 = min(w, c0 + ww + pad)
+    return not mask[rr0:rr1, cc0:cc1].any()
