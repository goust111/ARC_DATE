+
+GEN_MAX_ATTEMPTS = 400
+GEN_COLORS = tuple(range(10))
+GEN_CONVEX_KERNEL_DIMS = ((2, 2), (2, 3), (3, 2))
+GEN_CONCAVE_TARGET_DIMS = {
+    "left": ((2, 1), (3, 1), (3, 2)),
+    "right": ((2, 1), (3, 1), (3, 2)),
