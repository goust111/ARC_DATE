+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    object_count = rng.choice((2, 4))
+    h = rng.randint(18 if object_count == 4 else 16, 26)
+    w = rng.randint(22 if object_count == 4 else 18, 28)
