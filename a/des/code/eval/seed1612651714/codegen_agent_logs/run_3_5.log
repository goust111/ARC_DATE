+) -> dict | None:
+    h, w = grid_shape
+    out_h, out_w = rng.choice(GEN_CONCAVE_TARGET_DIMS[direction])
+    if rng.random() < 0.5:
+        in_h, in_w = out_h, out_w
+    else:
+        in_h, in_w = out_w, out_h
+
+    if direction in ("left", "right"):
