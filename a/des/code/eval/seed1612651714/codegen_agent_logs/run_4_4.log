+import itertools
+import random
+from collections import Counter
+
+import numpy as np
+
+
+def _mode_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _most_common_non_bg(grid: np.ndarray, bg: int) -> int:
+    values = [int(v) for v in grid.ravel() if int(v) != int(bg)]
+    if not values:
+        return int(bg)
+    return int(Counter(values).most_common(1)[0][0])
+
+
+def _bbox_from_coords(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _bbox_center(bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    return (r0 + r1 + 1) // 2, (c0 + c1 + 1) // 2
+
+
+def _mask_components(mask: np.ndarray) -> tuple[np.ndarray, list[dict]]:
+    h, w = mask.shape
+    labels = np.full((h, w), -1, dtype=int)
+    comps: list[dict] = []
+    next_id = 0
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or int(labels[r, c]) != -1:
+                continue
+            stack = [(int(r), int(c))]
+            labels[r, c] = int(next_id)
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = int(rr + dr)
+                    nc = int(cc + dc)
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and int(labels[nr, nc]) == -1:
+                        labels[nr, nc] = int(next_id)
+                        stack.append((int(nr), int(nc)))
+            comps.append(
+                {
+                    "id": int(next_id),
+                    "coords": coords,
+                    "bbox": _bbox_from_coords(coords),
+                    "area": len(coords),
+                }
+            )
+            next_id += 1
+    return labels, comps
+
+
+def _monochrome_components(grid: np.ndarray, mask: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            color = int(grid[r, c])
+            stack = [(int(r), int(c))]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = int(rr + dr)
+                    nc = int(cc + dc)
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if bool(seen[nr, nc]) or not bool(mask[nr, nc]) or int(grid[nr, nc]) != int(color):
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((int(nr), int(nc)))
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": _bbox_from_coords(coords),
+                    "area": len(coords),
+                }
