+            horizontal = (
+                int(grid[r, c - 1]) == int(wall)
+                and int(grid[r, c + 1]) == int(wall)
+                and int(grid[r - 1, c]) != int(wall)
+                and int(grid[r + 1, c]) != int(wall)
+            )
+            if not (vertical or horizontal):
+                continue
