+def _sample_branch_sequence() -> list[str]:
+    count = random.randint(1, 3)
+    primary = random.choice(tuple(BRANCHES))
+    branches = [primary]
+    while len(branches) < count:
+        branches.append(random.choice(tuple(BRANCHES)))
+    random.shuffle(branches)
