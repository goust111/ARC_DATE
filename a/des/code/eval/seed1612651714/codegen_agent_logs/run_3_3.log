+        grid[coords[:, 0], coords[:, 1]] = color
+    return grid
+
+
+def _edge_orientations(edges: list[tuple[int, int]], cols: int) -> set[str]:
+    result = set()
+    for a, b in edges:
+        ar, ac = divmod(a, cols)
+        br, bc = divmod(b, cols)
+        result.add("H" if ar != br else "V")
+    return result
+
+
+def _gen_attempt() -> np.ndarray | None:
