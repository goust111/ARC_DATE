+
+def _room_id(r: int, c: int, cols: int) -> int:
+    return r * cols + c
+
+
+def _random_connected_mask(height: int, width: int, area: int) -> np.ndarray | None:
+    if area < 1 or area > height * width:
+        return None
+
+    for _ in range(80):
+        start = (random.randrange(height), random.randrange(width))
+        cells = {start}
+        frontier = [start]
+        while len(cells) < area and frontier:
+            base = random.choice(frontier)
+            neighbors = []
+            for dr, dc in DIR4:
+                nr, nc = base[0] + dr, base[1] + dc
+                if 0 <= nr < height and 0 <= nc < width and (nr, nc) not in cells:
+                    neighbors.append((nr, nc))
+            if not neighbors:
+                frontier.remove(base)
+                continue
+            nxt = random.choice(neighbors)
+            cells.add(nxt)
+            frontier.append(nxt)
+
+        if len(cells) != area:
+            continue
+
+        mask = np.zeros((height, width), dtype=bool)
+        for r, c in cells:
+            mask[r, c] = True
+        return mask
+
+    return None
+
+
+def _grow_tree(
+    rows: int,
+    cols: int,
+    size: int,
+    used: set[int],
+) -> tuple[list[int], list[tuple[int, int]]] | None:
+    available = [idx for idx in range(rows * cols) if idx not in used]
+    if len(available) < size:
+        return None
+
+    start = random.choice(available)
+    nodes = [start]
+    node_set = {start}
+    edges: list[tuple[int, int]] = []
+
+    while len(nodes) < size:
+        frontier: list[tuple[int, int]] = []
+        for idx in nodes:
+            rr, cc = divmod(idx, cols)
+            for dr, dc in DIR4:
+                nr, nc = rr + dr, cc + dc
+                if 0 <= nr < rows and 0 <= nc < cols:
+                    nbr = _room_id(nr, nc, cols)
+                    if nbr in node_set or nbr in used:
+                        continue
+                    frontier.append((idx, nbr))
+        if not frontier:
+            return None
+        parent, child = random.choice(frontier)
+        nodes.append(child)
+        node_set.add(child)
+        edges.append((parent, child))
+
+    return nodes, edges
+
+
+def _pick_sources_for_components(
+    components: list[tuple[list[int], list[tuple[int, int]]]]
+) -> list[int]:
+    sources: list[int] = []
+    for nodes, edges in components:
+        deg = {node: 0 for node in nodes}
+        for a, b in edges:
+            deg[a] += 1
+            deg[b] += 1
+        leaves = [node for node, d in deg.items() if d <= 1]
+        sources.append(random.choice(leaves if leaves else nodes))
+    return sources
+
+
+def _layout_rooms(
+    row_heights: list[int],
+    col_widths: list[int],
+) -> list[Room]:
+    row_starts = []
+    pos = 1
+    for height in row_heights:
+        row_starts.append(pos)
+        pos += height + 1
+
+    col_starts = []
+    pos = 1
+    for width in col_widths:
+        col_starts.append(pos)
+        pos += width + 1
+
+    rooms: list[Room] = []
+    idx = 0
+    for rr, r0 in enumerate(row_starts):
+        for cc, c0 in enumerate(col_starts):
+            rooms.append(
+                Room(
+                    idx=idx,
+                    r0=r0,
+                    c0=c0,
+                    r1=r0 + row_heights[rr] - 1,
+                    c1=c0 + col_widths[cc] - 1,
+                )
+            )
+            idx += 1
+    return rooms
+
+
+def _door_for_edge(
+    edge: tuple[int, int],
+    rooms: list[Room],
+    cols: int,
+    color: int,
+    idx: int,
+) -> Door | None:
+    a, b = edge
+    room_a = rooms[a]
+    room_b = rooms[b]
