+from __future__ import annotations
+
+import random
+from collections import defaultdict, deque
+from dataclasses import dataclass
+
+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+ALL_COLORS = list(range(10))
+BG_COLOR = 0
+GEN_ATTEMPTS = 400
+ROOM_ROWS_RANGE = (2, 4)
+ROOM_COLS_RANGE = (2, 4)
+ROOM_SIZE_RANGE = (4, 7)
