+def _expected_output(grid: np.ndarray, specs: list[dict[str, int | str]]) -> np.ndarray:
+    out = grid.copy()
+    bg = _get_bg(grid)
+    for spec in specs:
+        _apply_single_fold(out, grid, spec, bg)
+    return out
+
