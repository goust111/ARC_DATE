+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _outside_is_bg(grid: np.ndarray, bg: int, r0: int, c0: int, r1: int, c1: int) -> bool:
+    h, w = grid.shape
+    if r0 > 0 and np.any(grid[r0 - 1, c0 : c1 + 1] != bg):
+        return False
+    if r1 + 1 < h and np.any(grid[r1 + 1, c0 : c1 + 1] != bg):
+        return False
+    if c0 > 0 and np.any(grid[r0 : r1 + 1, c0 - 1] != bg):
+        return False
+    if c1 + 1 < w and np.any(grid[r0 : r1 + 1, c1 + 1] != bg):
+        return False
+    return True
+
+
+def _detect_rectangles(grid: np.ndarray) -> list[dict[str, int | str]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    bg = _get_bg(g)
+    candidates: list[dict[str, int | str]] = []
+
+    for r0 in range(h - 2):
+        for r1 in range(r0 + 2, h):
+            for c0 in range(w - 2):
+                for c1 in range(c0 + 2, w):
+                    if not _outside_is_bg(g, bg, r0, c0, r1, c1):
+                        continue
+
+                    fence = int(g[r0, c0])
+                    if fence == bg:
+                        continue
+                    if (
+                        int(g[r0, c1]) != fence
+                        or int(g[r1, c0]) != fence
+                        or int(g[r1, c1]) != fence
+                    ):
+                        continue
+
+                    mismatches: list[tuple[int, int]] = []
+                    for c in range(c0 + 1, c1):
+                        if int(g[r0, c]) != fence:
+                            mismatches.append((r0, c))
+                        if int(g[r1, c]) != fence:
+                            mismatches.append((r1, c))
+                    for r in range(r0 + 1, r1):
+                        if int(g[r, c0]) != fence:
+                            mismatches.append((r, c0))
+                        if int(g[r, c1]) != fence:
+                            mismatches.append((r, c1))
+                    if len(mismatches) != 1:
+                        continue
+
+                    mr, mc = mismatches[0]
+                    marker = int(g[mr, mc])
+                    if marker in {bg, fence}:
+                        continue
+
+                    interior = g[r0 + 1 : r1, c0 + 1 : c1]
+                    if interior.size == 0:
+                        continue
+                    if np.any(interior == fence):
+                        continue
+                    if not np.any(interior != bg):
+                        continue
+
+                    if mr == r0:
+                        side = "top"
+                    elif mr == r1:
+                        side = "bottom"
+                    elif mc == c0:
+                        side = "left"
+                    else:
+                        side = "right"
+
+                    candidates.append(
+                        {
+                            "r0": r0,
+                            "c0": c0,
+                            "r1": r1,
+                            "c1": c1,
+                            "mr": mr,
+                            "mc": mc,
+                            "side": side,
+                            "fence": fence,
+                            "area": (r1 - r0 + 1) * (c1 - c0 + 1),
+                        }
+                    )
+
+    candidates.sort(key=lambda item: int(item["area"]), reverse=True)
+    chosen: list[dict[str, int | str]] = []
+    for cand in candidates:
+        r0 = int(cand["r0"])
+        c0 = int(cand["c0"])
+        r1 = int(cand["r1"])
+        c1 = int(cand["c1"])
+        overlaps = False
+        for other in chosen:
+            or0 = int(other["r0"])
+            oc0 = int(other["c0"])
+            or1 = int(other["r1"])
+            oc1 = int(other["c1"])
+            if not (r1 < or0 or or1 < r0 or c1 < oc0 or oc1 < c0):
