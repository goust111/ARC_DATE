+GRID_MIN = 14
+GRID_MAX = 26
+OBJECT_COUNT_CHOICES = (1, 2, 3)
+SIDE_CHOICES = ("top", "bottom", "left", "right")
+PATTERN_MODES = ("noise", "row_bands", "col_bands", "checker", "blocks")
+MAX_GENERATION_ATTEMPTS = 400
