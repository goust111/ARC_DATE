+    if side in {"top", "bottom"}:
+        for r in range(r0 + 1, r1):
+            color = int(source[r, mc])
+            if color in {bg, fence}:
+                continue
+            dst_r = 2 * r0 - r if side == "top" else 2 * r1 - r
+            if 0 <= dst_r < h:
+                out[dst_r, mc] = color
+    else:
+        for c in range(c0 + 1, c1):
+            color = int(source[mr, c])
