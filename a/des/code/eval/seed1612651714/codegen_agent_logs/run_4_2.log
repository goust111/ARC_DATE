+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _outside_is_bg(grid: np.ndarray, bg: int, r0: int, c0: int, r1: int, c1: int) -> bool:
+    h, w = grid.shape
+    if r0 > 0 and np.any(grid[r0 - 1, c0 : c1 + 1] != bg):
+        return False
+    if r1 + 1 < h and np.any(grid[r1 + 1, c0 : c1 + 1] != bg):
+        return False
+    if c0 > 0 and np.any(grid[r0 : r1 + 1, c0 - 1] != bg):
+        return False
+    if c1 + 1 < w and np.any(grid[r0 : r1 + 1, c1 + 1] != bg):
+        return False
+    return True
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(pts)
+    return comps
+
