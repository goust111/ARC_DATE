+) -> set[tuple[int, int]]:
+    h, w = shape
+    base = {
+        (r, c)
+        for r in range(r0, r1 + 1)
+        for c in range(c0, c1 + 1)
+    }
+    base |= fold_cells
+
+    reserved: set[tuple[int, int]] = set()
+    for r, c in base:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr = r + dr
+                nc = c + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    reserved.add((nr, nc))
