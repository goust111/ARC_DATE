+            outer_w = inner_w + 2
+            if outer_h + 2 > h or outer_w + 2 > w:
+                continue
+
+            r0 = random.randint(1, h - outer_h - 1)
+            c0 = random.randint(1, w - outer_w - 1)
+            r1 = r0 + outer_h - 1
+            c1 = c0 + outer_w - 1
