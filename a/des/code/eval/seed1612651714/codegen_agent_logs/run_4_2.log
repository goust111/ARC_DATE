+        grid[r1, c0 : c1 + 1] = fence
+        grid[r0 : r1 + 1, c0] = fence
+        grid[r0 : r1 + 1, c1] = fence
+
+        if side == "top":
+            mr, mc = r0, c0 + 1 + marker_offset
+        elif side == "bottom":
+            mr, mc = r1, c0 + 1 + marker_offset
+        elif side == "left":
+            mr, mc = r0 + 1 + marker_offset, c0
+        else:
+            mr, mc = r0 + 1 + marker_offset, c1
+        grid[mr, mc] = marker
+
+        solver_specs.append(
