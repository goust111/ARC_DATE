+        if mr == r0:
+            side = "top"
+        elif mr == r1:
+            side = "bottom"
+        elif mc == c0:
+            side = "left"
+        else:
+            side = "right"
+
+        candidates.append(
+            {
+                "r0": r0,
+                "c0": c0,
+                "r1": r1,
+                "c1": c1,
+                "mr": mr,
+                "mc": mc,
+                "side": side,
+                "fence": fence,
+                "area": (r1 - r0 + 1) * (c1 - c0 + 1),
+            }
+        )
+
+    candidates.sort(key=lambda item: int(item["area"]), reverse=True)
+    chosen: list[dict[str, int | str]] = []
+    for cand in candidates:
+        r0 = int(cand["r0"])
+        c0 = int(cand["c0"])
+        r1 = int(cand["r1"])
+        c1 = int(cand["c1"])
+        overlaps = False
+        for other in chosen:
+            or0 = int(other["r0"])
+            oc0 = int(other["c0"])
+            or1 = int(other["r1"])
+            oc1 = int(other["c1"])
+            if not (r1 < or0 or or1 < r0 or c1 < oc0 or oc1 < c0):
+                overlaps = True
