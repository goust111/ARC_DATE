                continue
            block = set(cells)
            entries = set()
            for rr, cc in cells:
                for nr, nc in _neighbors4(rr, cc, h, w):
                    if (nr, nc) in block:
                        continue
                    if int(grid[nr, nc]) in (GREY, MAROON):
                        entries.add((nr, nc))
            if len(entries) != 1:
                continue
            entry = next(iter(entries))
            containers.append({"cells": block, "entry": entry})
            for rr, cc in cells:
                used[rr, cc] = True
                mask[rr, cc] = True
    return containers, mask


def _network_neighbors(mask: np.ndarray) -> dict[tuple[int, int], list[tuple[int, int]]]:
    h, w = mask.shape
    neighbors: dict[tuple[int, int], list[tuple[int, int]]] = {}
    for r in range(h):
        for c in range(w):
            if not mask[r, c]:
                continue
            pos = (r, c)
            neighbors[pos] = [(nr, nc) for nr, nc in _neighbors4(r, c, h, w) if mask[nr, nc]]
    return neighbors


