+                    if int(grid[nr, nc]) in (GREY, MAROON):
+                        entries.add((nr, nc))
+            if len(entries) != 1:
+                continue
+            entry = next(iter(entries))
+            containers.append({"cells": block, "entry": entry})
+            for rr, cc in cells:
+                used[rr, cc] = True
+                mask[rr, cc] = True
