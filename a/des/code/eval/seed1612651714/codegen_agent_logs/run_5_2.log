+
+
+def _paint_rect(grid: np.ndarray, r0: int, c0: int, color: int) -> list[tuple[int, int]]:
+    cells = []
+    for dr in range(2):
+        for dc in range(2):
+            rr = r0 + dr
+            cc = c0 + dc
+            grid[rr, cc] = int(color)
+            cells.append((rr, cc))
+    return cells
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
