+        return None
+
+    if node_count >= 2:
+        upgrades = 0
+        no_upgrades = 0
+        running = top_color
+        for color in side_colors:
+            if PRIORITY[int(color)] > PRIORITY[int(running)]:
+                upgrades += 1
+            else:
+                no_upgrades += 1
+            running = _mix_colors(running, color)
+        if upgrades == 0 or no_upgrades == 0:
+            return None
+
+    rows = [top_stem + 2]
