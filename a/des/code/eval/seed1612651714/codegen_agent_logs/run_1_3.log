+
+def _gen_attempt() -> np.ndarray | None:
+    inner_h = random.randint(*INNER_H_RANGE)
+    inner_w = random.randint(*INNER_W_RANGE)
+    mode = random.choice(("corner_cross", "opposite_cross", "disjoint"))
