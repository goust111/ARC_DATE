+        return None
+    comps = _components(mask)
+    if len(comps) != 1:
+        return None
+    coords = comps[0]
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+
+    crop = mask[r0 : r1 + 1, c0 : c1 + 1]
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+
+    if np.any(crop & ~border):
+        return None
+
+    missing = np.argwhere(border & ~crop)
+    if missing.shape[0] != 1:
+        return None
+    mr, mc = map(int, missing[0])
+    if (mr in (0, h - 1)) and (mc in (0, w - 1)):
+        return None
+    if mr == 0:
+        side = "top"
+    elif mr == h - 1:
+        side = "bottom"
+    elif mc == 0:
+        side = "left"
+    elif mc == w - 1:
+        side = "right"
+    else:
+        return None
+
+    expected = int(border.sum()) - 1
+    if int(crop.sum()) != expected:
+        return None
+
+    return {
+        "color": int(color),
+        "bbox": (r0, c0, r1, c1),
+        "gap_side": side,
+        "gap_cell": (r0 + mr, c0 + mc),
+    }
+
+
+def _strictly_contains(outer_bbox, inner_bbox) -> bool:
+    or0, oc0, or1, oc1 = outer_bbox
