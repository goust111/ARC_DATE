+import numpy as np
+
+
+SIDES = ("top", "right", "bottom", "left")
+VECTORS = {
+    "top": (-1, 0),
+    "right": (0, 1),
+    "bottom": (1, 0),
+    "left": (0, -1),
+}
+
+BG_COLOR = 0
+GRID_MIN = 18
+GRID_MAX = 30
+LAYER_RANGE = (2, 4)
+SPACING_RANGE = (3, 5)
+INNER_SIZE_MIN = 5
+INNER_SIZE_MAX = 8
+MOTIF_BBOX_MAX = 4
+MOTIF_AREA_MIN = 2
+MOTIF_AREA_MAX = 7
+GEN_ATTEMPTS = 400
+SHAPE_ATTEMPTS = 60
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _frame_info(grid: np.ndarray, color: int):
+    mask = grid == color
+    if not np.any(mask):
+        return None
+    comps = _components(mask)
+    if len(comps) != 1:
+        return None
+    coords = comps[0]
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+
+    crop = mask[r0 : r1 + 1, c0 : c1 + 1]
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+
+    if np.any(crop & ~border):
+        return None
+
+    missing = np.argwhere(border & ~crop)
+    if missing.shape[0] != 1:
+        return None
+    mr, mc = map(int, missing[0])
+    if (mr in (0, h - 1)) and (mc in (0, w - 1)):
+        return None
+    if mr == 0:
+        side = "top"
+    elif mr == h - 1:
+        side = "bottom"
+    elif mc == 0:
+        side = "left"
+    elif mc == w - 1:
+        side = "right"
+    else:
+        return None
+
+    expected = int(border.sum()) - 1
+    if int(crop.sum()) != expected:
+        return None
+
+    return {
+        "color": int(color),
+        "bbox": (r0, c0, r1, c1),
+        "gap_side": side,
+        "gap_cell": (r0 + mr, c0 + mc),
