+    if coords.size == 0:
+        return mask
+    r0, c0, r1, c1 = _bbox(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1]
+
+
+def _frame_bboxes_from_outer(outer_bbox, spacings: list[int]) -> list[tuple[int, int, int, int]]:
+    boxes = [outer_bbox]
+    current = outer_bbox
