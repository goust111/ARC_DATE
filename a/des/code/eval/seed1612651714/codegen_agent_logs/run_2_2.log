+
+    min_inner_w = max(8, _min_side_line(max(gap_counts["top"], gap_counts["bottom"])))
+    min_inner_h = max(8, _min_side_line(max(gap_counts["left"], gap_counts["right"])))
+    if min_inner_w > 16 or min_inner_h > 16:
