+def _sample_object_specs(n_objects: int) -> list[dict]:
+    kinds = ["cross", "x", "bar"]
+    branch_pool = kinds + [random.choice(kinds) for _ in range(n_objects - len(kinds))]
+    random.shuffle(branch_pool)
