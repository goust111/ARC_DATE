+    else:
+        assert direction is not None
+        dirs = (direction,)
+
+    for dr, dc in dirs:
+        for step in range(1, length + 1):
+            nr = r + dr * step
+            nc = c + dc * step
+            if 0 <= nr < h and 0 <= nc < w:
