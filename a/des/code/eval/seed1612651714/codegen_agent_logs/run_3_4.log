+def _orbit(kind: str, h: int, w: int, r: int, c: int) -> tuple[tuple[int, int], ...]:
+    cells = {(int(r), int(c))}
+    changed = True
+    while changed:
+        changed = False
+        for rr, cc in tuple(cells):
+            if kind in {"lr", "quad"}:
+                mirrored = (rr, w - 1 - cc)
+                if mirrored not in cells:
+                    cells.add(mirrored)
+                    changed = True
+            if kind in {"ud", "quad"}:
+                mirrored = (h - 1 - rr, cc)
+                if mirrored not in cells:
+                    cells.add(mirrored)
+                    changed = True
+    return tuple(sorted(cells))
+
