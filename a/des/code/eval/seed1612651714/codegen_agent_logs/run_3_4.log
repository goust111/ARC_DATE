+    if not np.array_equal(solved, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _try_generate_case()
+        if grid is not None:
