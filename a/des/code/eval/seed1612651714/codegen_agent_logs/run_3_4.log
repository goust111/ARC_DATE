+    candidate_pairs = [
+        ((0, 0), (1, 0)),
+        ((0, w - 1), (1, w - 1)),
+        ((h - 2, 0), (h - 1, 0)),
+        ((h - 2, w - 1), (h - 1, w - 1)),
