+
+
+def _orbit_touches(cells: set[tuple[int, int]], orbit: tuple[tuple[int, int], ...]) -> bool:
+    for r, c in orbit:
+        for dr, dc in DIRS4:
+            if (r + dr, c + dc) in cells:
