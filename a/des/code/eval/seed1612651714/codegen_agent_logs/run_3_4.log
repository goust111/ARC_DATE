+
+def _dominant_color(values: np.ndarray) -> int:
+    colors, counts = np.unique(values, return_counts=True)
+    order = np.argsort(counts)
+    assert len(order) == 1 or counts[order[-1]] > counts[order[-2]]
+    return int(colors[order[-1]])
