+    while changed:
+        changed = False
+        for rr, cc in tuple(cells):
+            if kind in {"lr", "quad"}:
+                mirrored = (rr, w - 1 - cc)
+                if mirrored not in cells:
+                    cells.add(mirrored)
+                    changed = True
+            if kind in {"ud", "quad"}:
