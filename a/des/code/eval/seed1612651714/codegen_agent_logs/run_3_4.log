+def _complete_mask(mask: np.ndarray, kind: str) -> np.ndarray:
+    out = mask.copy()
+    if kind in {"lr", "quad"}:
+        out |= np.fliplr(out)
+    if kind in {"ud", "quad"}:
+        out |= np.flipud(out)
+    return out
