+    orbits: list[tuple[tuple[int, int], ...]] = []
+    for r in range(h):
+        for c in range(w):
+            orb = _orbit(kind, h, w, r, c)
+            if orb not in seen:
+                seen.add(orb)
+                orbits.append(orb)
+    return orbits
+
+
+def _orbit_touches(cells: set[tuple[int, int]], orbit: tuple[tuple[int, int], ...]) -> bool:
+    for r, c in orbit:
+        for dr, dc in DIRS4:
+            if (r + dr, c + dc) in cells:
+                return True
+    return False
