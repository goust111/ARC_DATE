+from __future__ import annotations
+
+import math
+import random
+
+import numpy as np
+
+
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+SYMMETRY_TYPES = ("lr", "ud", "quad")
+PALETTE = tuple(range(10))
+
+MAX_GENERATION_ATTEMPTS = 400
+MASK_ATTEMPTS = 220
+BROKEN_ATTEMPTS = 260
+PLACEMENT_ATTEMPTS = 220
