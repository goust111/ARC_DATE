+
+def _ordered_seeds(grid: np.ndarray, frame: dict) -> list[tuple[int, int, int]]:
+    pts = frame["seed_points"]
+    direction = frame["direction"]
+
+    if direction == "left":
+        key = lambda rc: (rc[0], rc[1])
+    elif direction == "right":
+        key = lambda rc: (rc[0], -rc[1])
+    elif direction == "up":
+        key = lambda rc: (rc[1], rc[0])
+    else:
+        key = lambda rc: (rc[1], -rc[0])
