+    missing = list(border - pset)
+    if len(missing) != 1:
+        return None
+    gap = missing[0]
+    gr, gc = gap
+    if (gr in (r0, r1)) and (gc in (c0, c1)):
+        return None
+    if int(grid[gr, gc]) != bg:
