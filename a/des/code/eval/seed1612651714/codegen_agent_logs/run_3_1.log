+    patch_h = row_max_rel - row_min_rel + 1 + 2 * pad
+    patch_w = col_max_rel - col_min_rel + 1 + 2 * pad
+    frame_top = pad - row_min_rel
+    frame_left = pad - col_min_rel
+    return patch_h, patch_w, frame_top, frame_left
