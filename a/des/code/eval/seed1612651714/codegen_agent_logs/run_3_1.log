            col_max_rel = frame_w - 1
        else:
            col_min_rel = 0
            col_max_rel = frame_w - 1 + trunk_len
    else:
        col_min_rel = min(0, gap_idx - max_neg)
        col_max_rel = max(frame_w - 1, gap_idx + max_pos)

