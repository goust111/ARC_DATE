+        if direction in ("left", "right"):
+            for step in range(1, neg + 1):
+                rr = tr - step
+                assert 0 <= rr < h
+                out[rr, tc] = color
+            for step in range(1, pos + 1):
+                rr = tr + step
+                assert 0 <= rr < h
+                out[rr, tc] = color
+        else:
+            for step in range(1, neg + 1):
+                cc = tc - step
+                assert 0 <= cc < w
+                out[tr, cc] = color
+            for step in range(1, pos + 1):
