+        r0 = frame_top
+        c0 = frame_left
+        r1 = r0 + frame_h - 1
+        c1 = c0 + frame_w - 1
+
+        patch[r0, c0 : c1 + 1] = structure_color
+        patch[r1, c0 : c1 + 1] = structure_color
+        patch[r0 : r1 + 1, c0] = structure_color
+        patch[r0 : r1 + 1, c1] = structure_color
