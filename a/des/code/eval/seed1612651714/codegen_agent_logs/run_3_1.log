+    if len(seed_positions) == 0:
+        return None
+
+    for sr, sc in seed_positions:
+        if sr == 0 or sr == inner.shape[0] - 1 or sc == 0 or sc == inner.shape[1] - 1:
+            return None
+
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "gap": gap,
+        "direction": direction,
+        "seed_points": [(r0 + 1 + int(sr), c0 + 1 + int(sc)) for sr, sc in seed_positions],
