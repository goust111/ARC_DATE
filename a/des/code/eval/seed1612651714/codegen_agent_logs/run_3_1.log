+    pts = frame["seed_points"]
+    direction = frame["direction"]
+
+    if direction == "left":
+        key = lambda rc: (rc[0], rc[1])
+    elif direction == "right":
+        key = lambda rc: (rc[0], -rc[1])
+    elif direction == "up":
