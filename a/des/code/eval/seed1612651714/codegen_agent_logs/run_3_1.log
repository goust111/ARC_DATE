+        )
+
+        available_colors = [c for c in ALL_COLORS if c not in (bg, structure_color)]
+        rng.shuffle(available_colors)
+        seed_colors = available_colors[: len(counts)]
+        color_counts = dict(zip(seed_colors, counts))
