    return None


def _patch_geometry(
    frame_h: int,
    frame_w: int,
    gap_idx: int,
    trunk_len: int,
    counts: list[int],
    direction: str,
) -> tuple[int, int, int, int]:
    max_neg = max(v // 2 for v in counts)
    max_pos = max((v + 1) // 2 for v in counts)

    if direction in ("left", "right"):
        row_min_rel = min(0, gap_idx - max_neg)
