+    ih, iw = inner_shape
+    dr, dc = offset
+    total = 0
+    touched = set()
+    for r, c in np.argwhere(mask):
+        rr = dr + int(r)
+        cc = dc + int(c)
+        if rr == 0:
+            total += 1
+            touched.add("T")
+        if rr == ih - 1:
+            total += 1
+            touched.add("B")
+        if cc == 0:
+            total += 1
+            touched.add("L")
+        if cc == iw - 1:
+            total += 1
+            touched.add("R")
+    return total, len(touched)
+
+
+def _infer_offset(mask: np.ndarray, inner_shape: tuple[int, int]) -> tuple[int, int]:
