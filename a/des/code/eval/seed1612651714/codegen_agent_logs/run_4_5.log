+    expected = _compose_expected(grid.shape, bg, frame_color, frame_bbox, pieces)
+    solved = main(grid)
+    if not np.array_equal(solved, expected):
+        return None
+    return grid, expected
+
+
+def generate_input() -> np.ndarray:
