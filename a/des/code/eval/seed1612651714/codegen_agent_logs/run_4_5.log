+        dr, dc = frag["offset"]
+        base_r = inner_origin[0] + dr
+        base_c = inner_origin[1] + dc
+        _draw_piece(out, (base_r, base_c), frag["mask"], frag["body_color"])
+    return out
+
+
+def _transform_from_tl(mask: np.ndarray, corner: str) -> np.ndarray:
+    out = mask
+    if corner in ("TR", "BR"):
+        out = np.fliplr(out)
+    if corner in ("BL", "BR"):
