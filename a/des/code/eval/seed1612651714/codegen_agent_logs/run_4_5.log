+                continue
+            if len(coords) != 2 * (hh + ww) - 4:
+                continue
+            sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+            border = np.zeros((hh, ww), dtype=bool)
+            border[0, :] = True
