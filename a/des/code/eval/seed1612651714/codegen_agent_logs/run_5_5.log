+        return None
+    hi = min(ANCHOR_COLOR_MAX, len(available))
+    for _ in range(200):
+        count = random.randint(ANCHOR_COLOR_MIN, hi)
+        residues = random.sample(available, count)
+        if len({r for r, _ in residues}) < 2:
