+    idx = int(np.argmax(counts))
+    outline = int(colors[idx])
+    if len(colors) > 1:
+        sorted_counts = sorted((int(c) for c in counts), reverse=True)
+        assert sorted_counts[0] > sorted_counts[1], "outline color must be unique"
+    return outline
