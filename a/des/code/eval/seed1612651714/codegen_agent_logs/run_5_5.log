+def _tile_grid(tile: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    dy, dx = tile.shape
+    rr = np.arange(h)[:, None] % dy
+    cc = np.arange(w)[None, :] % dx
+    return tile[rr, cc]
