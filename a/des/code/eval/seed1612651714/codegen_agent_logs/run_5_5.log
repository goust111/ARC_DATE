+def _tile_from_residues(
+    dy: int, dx: int, bg: int, colors: list[int], residues: list[tuple[int, int]]
+) -> np.ndarray:
+    tile = np.full((dy, dx), bg, dtype=int)
+    for color, (r, c) in zip(colors, residues):
+        tile[int(r), int(c)] = int(color)
+    return tile
+
