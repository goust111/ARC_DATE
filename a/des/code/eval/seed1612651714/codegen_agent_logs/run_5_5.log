+def _draw_loop(vertices: list[tuple[int, int]], shape: tuple[int, int]) -> np.ndarray:
+    border = np.zeros(shape, dtype=bool)
+    for i, (r0, c0) in enumerate(vertices):
+        r1, c1 = vertices[(i + 1) % len(vertices)]
+        if r0 == r1:
