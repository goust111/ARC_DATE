+def _infer_periods(anchor_coords: dict[int, np.ndarray]) -> tuple[int, int]:
+    dy = 0
+    dx = 0
+    for coords in anchor_coords.values():
+        n = int(coords.shape[0])
+        assert 2 <= n <= 4, "each anchor color must appear 2-4 times"
+        for i in range(n):
