+
+
+def _notched_patch(height: int, width: int, side: str) -> tuple[np.ndarray, np.ndarray]:
+    if side in {"top", "bottom"}:
+        base = _top_notch_border(height, width)
+        border = np.flipud(base) if side == "bottom" else base
+    else:
