+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _flood_from_boundary(blocked: np.ndarray) -> np.ndarray:
+    h, w = blocked.shape
+    seen = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if not blocked[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not blocked[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c, h, w):
+            if blocked[nr, nc] or seen[nr, nc]:
+                continue
+            seen[nr, nc] = True
+            q.append((nr, nc))
+    return seen
+
+
+def _enclosed_region(border: np.ndarray) -> np.ndarray:
+    outside = _flood_from_boundary(border)
+    return (~border) & (~outside)
