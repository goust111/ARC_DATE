+
+    out = np.full((grid_h, grid_w), bg, dtype=int)
+    full = _tile_grid(tile, (grid_h, grid_w))
+    out[inside] = full[inside]
+
+    if _most_common_color(inp) != bg:
+        return None
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+    return inp
+
