+def _mark_buffered(mask: np.ndarray, points: list[tuple[int, int]]) -> None:
+    h, w = mask.shape
+    for r, c in points:
+        r0 = max(0, r - 1)
+        r1 = min(h, r + 2)
+        c0 = max(0, c - 1)
+        c1 = min(w, c + 2)
