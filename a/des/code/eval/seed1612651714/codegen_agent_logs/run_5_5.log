+import numpy as np
+
+
+FRAME_COLOR = 5
+GRID_MIN = 22
+GRID_MAX = 30
+PERIOD_MIN = 3
+PERIOD_MAX = 6
+ANCHOR_COLOR_MIN = 4
+ANCHOR_COLOR_MAX = 6
+MAX_GENERATION_ATTEMPTS = 400
