+    min_w = max(2 * dx + 3, 9)
+    max_h = grid_h - 6
+    max_w = grid_w - 6
+    if min_h > max_h or min_w > max_w:
+        return None
+
+    kind = random.choice(["rect", "notch"])
+    height = random.randint(min_h, max_h)
+    width = random.randint(min_w, max_w)
