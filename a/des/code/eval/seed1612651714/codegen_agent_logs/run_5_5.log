+    notch_left = random.randint(2, width - 5)
+    notch_right = random.randint(notch_left + 2, width - 3)
+    notch_depth = random.randint(2, height - 4)
+    vertices = [
+        (0, 0),
+        (0, notch_left),
+        (notch_depth, notch_left),
+        (notch_depth, notch_right),
+        (0, notch_right),
+        (0, width - 1),
+        (height - 1, width - 1),
+        (height - 1, 0),
+    ]
