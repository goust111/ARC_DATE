+    reserved = np.zeros((h, w), dtype=bool)
+    placed_plans = []
+    for plan in sorted(plans, key=lambda item: len(item["occupied"]), reverse=True):
+        shift = _place_structure(plan, reserved)
+        if shift is None:
+            return None
+        placed_plans.append((plan, shift))
