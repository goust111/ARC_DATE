+            return None
+
+    if np.array_equal(inp, expected):
+        return None
+    if _get_bg(inp) != bg:
+        return None
+    if not _oracle_ok(inp, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(RETRIES):
