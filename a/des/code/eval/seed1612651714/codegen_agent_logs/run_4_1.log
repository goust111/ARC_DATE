+    if direction == "left":
+        rows = np.flatnonzero(mask[:, w - 1])
+        if len(rows) != 1:
+            return False
+        return bool(mask[int(rows[0]), 0])
+    if direction == "down":
+        cols = np.flatnonzero(mask[0, :])
+        if len(cols) != 1:
+            return False
+        return bool(mask[h - 1, int(cols[0])])
+    cols = np.flatnonzero(mask[h - 1, :])
+    if len(cols) != 1:
