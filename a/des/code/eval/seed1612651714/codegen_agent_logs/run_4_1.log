+    inp = np.full((h, w), bg, dtype=int)
+    expected = np.full((h, w), bg, dtype=int)
+    sprite_reserved = reserved.copy()
+    for plan, shift in placed_plans:
+        _paint_cells(inp, plan["input_cells"], shift)
