+    for h in range(1, 4):
+        for w in range(1, 4):
+            for bits in range(1, 1 << (h * w)):
+                mask = np.zeros((h, w), dtype=bool)
+                for idx in range(h * w):
+                    if (bits >> idx) & 1:
+                        mask[idx // w, idx % w] = True
+                if _valid_sprite(mask, direction):
+                    masks.append(mask)
+    return tuple(masks)
