+        for rr in range(top - 1, top + sh + 1):
+            for cc in range(left - 1, left + sw + 1):
+                if 0 <= rr < h and 0 <= cc < w:
+                    reserved[rr, cc] = True
+        return True
+    return False
+
+
+def _oracle_ok(inp: np.ndarray, expected: np.ndarray) -> bool:
+    try:
+        got = main(inp)
+    except Exception:
+        return False
+    return np.array_equal(got, expected)
