+
+WALL = 5
+DOOR_BOTH_COLOR = 2
+SYMMETRY_TYPES = ("horizontal", "vertical", "both", "none")
+
+INTERIOR_SIZE_RANGE = (6, 8)
+LAYOUT_CHOICES = ((2, 3), (3, 2), (3, 3))
+MAX_GENERATION_ATTEMPTS = 300
