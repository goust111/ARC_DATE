+            if r % 2 == 0:
+                row = region[r]
+                row[row == bg] = color
+        return
+    assert kind == "vertical"
+    for c in range(region.shape[1]):
+        if c % 2 == 0:
+            col_mask = region[:, c] == bg
+            region[col_mask, c] = color
