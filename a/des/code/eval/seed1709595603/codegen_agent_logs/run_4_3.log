+    grid[top : bottom + 1, right] = GREY
+    sr, sc = seed_pos
+    grid[top + 1 + sr, left + 1 + sc] = seed_color
+    return top, left, bottom, right
+
+
+def _oracle_output(
+    grid: np.ndarray,
+    textures: list[np.ndarray],
+    dict_box: tuple[int, int, int, int],
