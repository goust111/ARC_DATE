+    for idx, kind in enumerate(kinds):
+        inner_h, inner_w = _choose_inner_dims(kind, rng)
+        outer_h = inner_h + 2
+        outer_w = inner_w + 2
+        if outer_h > top_band_limit or outer_w > width - 2:
+            return None
