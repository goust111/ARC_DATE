+            view_out = out[top : top + oh, left : left + ow]
+            mask_in = obj_in != bg
+            mask_out = obj_out != bg
+            view_in[mask_in] = obj_in[mask_in]
+            view_out[mask_out] = obj_out[mask_out]
+            _mark_occupied(occupied, top, left, oh, ow)
+            placed = True
+            break
