+            return None
+
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        bg = random.choice([c for c in range(10) if c != FRAME_COLOR])
+        n_objects = random.randint(1, 4)
+        exits = [random.choice(EXIT_SIDES) for _ in range(n_objects)]
