+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _step(cell: tuple[int, int], direction: tuple[int, int]) -> tuple[int, int]:
+    return (cell[0] + direction[0], cell[1] + direction[1])
