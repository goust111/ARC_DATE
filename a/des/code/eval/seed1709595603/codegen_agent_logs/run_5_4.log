+
+        if not np.array_equal(actual, expected):
+            continue
+        if np.array_equal(actual, grid):
+            continue
+        if len(path_cells) < max(h, w) // 2:
+            continue
+        return grid
+
+    return None
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
