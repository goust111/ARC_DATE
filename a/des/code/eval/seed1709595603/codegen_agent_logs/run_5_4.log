+def _components4(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _find_source(grid: np.ndarray) -> tuple[tuple[int, int], int, tuple[int, int]]:
+    coords = np.argwhere((grid != BLACK) & (grid != GRAY))
+    assert coords.shape[0] == 1, "expected one colored source pixel"
+    r, c = map(int, coords[0])
+    color = int(grid[r, c])
+    h, w = grid.shape
+    on_edges = [r == 0, r == h - 1, c == 0, c == w - 1]
+    assert sum(on_edges) == 1, "source must lie on exactly one edge"
+    if r == 0:
+        direction = DOWN
+    elif r == h - 1:
+        direction = UP
+    elif c == 0:
+        direction = RIGHT
+    else:
