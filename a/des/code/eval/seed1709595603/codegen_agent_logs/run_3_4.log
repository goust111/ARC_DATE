+    if direction == UP:
+        antenna = {(r0 - 1, c0 + 1), (r0 - 2, c0 + 1)}
+        tip = (r0 - 2, c0 + 1)
+    elif direction == DOWN:
+        antenna = {(r0 + 3, c0 + 1), (r0 + 4, c0 + 1)}
