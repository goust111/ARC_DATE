+    except Exception:
+        return None
+
+    if np.array_equal(out, grid):
+        return None
+
+    if want_tower_stop:
+        touched_tower = False
+        tower_cells = {cell for tower in towers for cell in tower["cells"]}
+        for tower in towers:
