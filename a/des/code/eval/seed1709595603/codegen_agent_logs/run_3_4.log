+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+DIRS = (UP, DOWN, LEFT, RIGHT)
+PERPENDICULAR = {
+    UP: (LEFT, RIGHT),
+    DOWN: (LEFT, RIGHT),
+    LEFT: (UP, DOWN),
+    RIGHT: (UP, DOWN),
+}
+
+GRID_H_RANGE = (14, 22)
+GRID_W_RANGE = (14, 22)
+TOWER_COUNT_CHOICES = (1, 2, 3)
+TOWER_COUNT_WEIGHTS = (2, 3, 2)
+BEND_COUNT_CHOICES = (0, 1, 2)
+BEND_COUNT_WEIGHTS = (2, 3, 2)
+MIN_SEG_LEN = 2
+MAX_SEG_LEN = 7
+TOWER_PLACE_ATTEMPTS = 120
+PATH_SEARCH_ATTEMPTS = 160
+GEN_ATTEMPTS = 400
