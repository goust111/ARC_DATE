+                    break
+                if int(grid[nxt]) != int(_bg_color(grid)):
+                    direction = _turn(direction, _detect_prism({"area": 3, "bbox": (0, 0, 1, 1), "coords": [], "coord_set": set()}) or {})  # unreachable
+                pos = nxt
+            if touched_tower:
+                break
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input grid")

