        if not _in_bounds(shape, nxt):
            return None
        if nxt in blocked_drawn:
            return None
        if nxt in blocked_input:
            if nxt in tower_targets and len(cells) >= MIN_SEG_LEN:
                return cells
            return None
        cells.append(nxt)
        cur = nxt


