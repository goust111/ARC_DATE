+    on_top = r == r0 and c0 < c < c1
+    on_bottom = r == r1 and c0 < c < c1
+    on_left = c == c0 and r0 < r < r1
+    on_right = c == c1 and r0 < r < r1
+    sides = [on_top, on_bottom, on_left, on_right]
+    if sum(sides) != 1:
+        return None
+    if on_top:
+        return "up"
+    if on_bottom:
+        return "down"
+    if on_left:
+        return "left"
+    return "right"
