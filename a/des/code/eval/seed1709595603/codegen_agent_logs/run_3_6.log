+def _add_seed(
+    seeds: list[Seed],
+    used: dict[str, list[tuple[int, int]]],
+    side: str,
+    start: int,
+    end: int,
+    color: int,
+    shared_intervals: list[tuple[int, int]] | None = None,
+    pad: int = 1,
+) -> bool:
