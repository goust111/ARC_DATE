+from __future__ import annotations
+
+from collections import Counter, deque
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+SIDE_ORDER = ("top", "bottom", "left", "right")
+OBSTACLE_COLOR = 9
+MAX_GENERATION_ATTEMPTS = 500
+
+
+@dataclass(frozen=True)
+class Seed:
+    side: str
+    color: int
+    start: int
+    end: int
+    index: int
