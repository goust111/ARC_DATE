+        banned.add(obstacle_color)
+
+    seeds: list[Seed] = []
+    next_index = 0
+
+    top, next_index = _scan_line_for_seeds(grid[0, :].tolist(), "top", 0, banned, next_index)
+    seeds.extend(top)
+    bottom, next_index = _scan_line_for_seeds(grid[h - 1, :].tolist(), "bottom", 0, banned, next_index)
