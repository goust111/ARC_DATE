+    if meta["new_pixels"] < max(h, w) // 2:
+        return None
+    if meta["new_pixels"] > (h * w) // 2:
+        return None
+    if bool(meta["has_overlap"]) != want_overlap:
+        return None
+    if (meta["branch_count"] > 0) != want_branch:
+        return None
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
