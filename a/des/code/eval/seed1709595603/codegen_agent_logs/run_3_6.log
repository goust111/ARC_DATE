+            return None
+        r0 = rng.randint(r0_lo, r0_hi)
+        c0 = rng.randint(c0_lo, c0_hi)
+        rect = (r0, c0, r0 + oh - 1, c0 + ow - 1)
+        if any(_rects_overlap(rect, other, pad=1) for other in rects):
+            continue
