+            if rect is None:
+                return None
+            rects.append(rect)
+    else:
+        path_mask = _direct_path_mask(seeds, h, w)
+        obstacle_goal = rng.randint(1, 2)
+        for _ in range(obstacle_goal):
+            rect = _place_offpath_obstacle(rng, h, w, rects, path_mask)
+            if rect is None:
+                return None
+            rects.append(rect)
+
+    if want_branch and rng.random() < 0.35:
+        path_mask = _direct_path_mask(seeds, h, w)
+        rect = _place_offpath_obstacle(rng, h, w, rects, path_mask)
+        if rect is not None:
