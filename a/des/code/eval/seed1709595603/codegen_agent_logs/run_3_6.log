+    if bool(meta["has_overlap"]) != want_overlap:
+        return None
+    if (meta["branch_count"] > 0) != want_branch:
+        return None
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _generate_attempt(rng)
+        if grid is not None:
