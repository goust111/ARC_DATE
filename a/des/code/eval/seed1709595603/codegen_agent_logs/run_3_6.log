+
+def _build_seed_plan(
+    rng: random.Random, h: int, w: int, bg: int, want_overlap: bool, want_branch: bool
+) -> list[Seed] | None:
+    target_seeds = 2 + rng.randint(0, 2)
+    if want_branch:
+        target_seeds = max(target_seeds, 3)
+
+    palette = [c for c in range(10) if c not in (bg, OBSTACLE_COLOR)]
+    if len(palette) < target_seeds:
+        return None
+    colors = rng.sample(palette, target_seeds)
+
+    seeds: list[Seed] = []
+    used = {side: [] for side in SIDE_ORDER}
+    color_idx = 0
+
+    if want_overlap:
+        axis = rng.choice(["vertical", "horizontal"])
+        if axis == "vertical":
+            max_len = min(3, _max_seed_len("top", h, w))
+            if max_len < 1:
+                return None
+            length = rng.randint(1, max_len)
+            start = rng.randint(1, w - 1 - length)
+            if not _add_seed(seeds, used, "top", start, start + length - 1, colors[color_idx]):
+                return None
+            color_idx += 1
+            if not _add_seed(seeds, used, "bottom", start, start + length - 1, colors[color_idx]):
+                return None
+            color_idx += 1
+        else:
+            max_len = min(3, _max_seed_len("left", h, w))
+            if max_len < 1:
+                return None
+            length = rng.randint(1, max_len)
+            start = rng.randint(1, h - 1 - length)
+            if not _add_seed(seeds, used, "left", start, start + length - 1, colors[color_idx]):
+                return None
+            color_idx += 1
+            if not _add_seed(seeds, used, "right", start, start + length - 1, colors[color_idx]):
+                return None
+            color_idx += 1
+
+    for _ in range(120):
+        if len(seeds) >= target_seeds:
+            break
+        side = rng.choice(list(SIDE_ORDER))
+        interval = _random_seed_interval(rng, side, h, w)
+        if interval is None:
+            continue
+        start, end = interval
+        if _add_seed(seeds, used, side, start, end, colors[color_idx]):
+            color_idx += 1
+    if len(seeds) != target_seeds:
+        return None
+    return [Seed(seed.side, seed.color, seed.start, seed.end, i) for i, seed in enumerate(seeds)]
+
+
+def _generate_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(12, 19)
+    w = rng.randint(12, 19)
+    bg = rng.choice([c for c in range(9) if c != OBSTACLE_COLOR])
+    want_branch = rng.random() < 0.5
+    want_overlap = rng.random() < 0.5
+
+    seeds = _build_seed_plan(rng, h, w, bg, want_overlap, want_branch)
+    if seeds is None:
+        return None
+
+    rects: list[tuple[int, int, int, int]] = []
+    if want_branch:
