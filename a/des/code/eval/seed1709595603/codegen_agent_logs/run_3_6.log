+def _solve_grid(grid: np.ndarray, return_meta: bool = False):
+    g = np.asarray(grid, dtype=int)
+    bg = _most_common_color(g)
+    obstacle_color = _find_obstacle_color(g, bg)
+    seeds = _find_seeds(g, bg, obstacle_color)
