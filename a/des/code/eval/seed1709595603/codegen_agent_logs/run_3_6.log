+    out = g.copy()
+    has_overlap = False
+    for cell, options in claims.items():
+        if len(options) > 1:
+            has_overlap = True
+        _, _, color = min(options, key=lambda item: (item[0], item[1]))
+        if obstacle_color is not None and int(g[cell]) == obstacle_color:
+            continue
+        out[cell] = color
