+
+def _monochrome_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if visited[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in DIR4:
