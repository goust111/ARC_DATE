+def _is_square_ring(comp: dict) -> bool:
+    r0, c0, r1, c1 = map(int, comp["bbox"])
+    side = r1 - r0 + 1
+    if side < 3 or side != c1 - c0 + 1:
+        return False
+    expected = set()
+    for r in range(r0, r1 + 1):
+        expected.add((r, c0))
+        expected.add((r, c1))
+    for c in range(c0, c1 + 1):
+        expected.add((r0, c))
+        expected.add((r1, c))
+    coords = set(comp["coords"])
+    return coords == expected
