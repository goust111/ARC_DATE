+        if len(boundary_colors) != 1:
+            continue
+        outline = next(iter(boundary_colors))
+        fill_colors = colors - {outline}
+        if len(fill_colors) != 1:
+            continue
+        fill = next(iter(fill_colors))
+        if outline in found:
+            bad.add(outline)
+        else:
