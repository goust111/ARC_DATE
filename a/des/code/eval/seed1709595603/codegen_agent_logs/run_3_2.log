+        r0, r1 = min(rows), max(rows)
+        c0, c1 = min(cols), max(cols)
+        if r1 - r0 < 2 or c1 - c0 < 2:
+            continue
+        perimeter = _perimeter_coords(r0, c0, r1, c1)
+        grey_cells = set(pts)
+        if len(grey_cells) != len(perimeter) - 1:
+            continue
