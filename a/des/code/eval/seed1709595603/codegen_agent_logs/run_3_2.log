+    blocked = np.zeros_like(g, dtype=bool)
+    for lock in locks:
+        r0, c0, r1, c1 = lock["bbox"]
+        blocked[r0 : r1 + 1, c0 : c1 + 1] = True
+    keys = _find_keys(g, bg, blocked)
