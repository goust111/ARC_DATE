# Canvas and band bounds.
GRID_ROWS = range(16, 19)
GRID_COLS = (16, 18)
FLOOR_THICKNESS = range(4, 7)
EMPTY_ROWS = range(3, 7)
# Object shape and fit constraints.
OBJECT_WIDTH = 5
OBJECT_HEIGHT = (5, 11)
SOLID_TOP_ROWS = 2
SHEAR_LOCK_ROWS = 3
CHECKER_COLS = (0, 2, 4)
# Colors and retry budget.
TRAIL_COLOR = int(Color.MAROON)
AVAILABLE_COLORS = [c for c in range(10) if c != TRAIL_COLOR]
MAX_GENERATION_ATTEMPTS = 300
SIDES = ("left", "right")

ROW_LAYOUTS = [
    (rows, floor_thick, empty_rows, rows - floor_thick - empty_rows)
    for rows in GRID_ROWS
    for floor_thick in FLOOR_THICKNESS
    for empty_rows in EMPTY_ROWS
    if OBJECT_HEIGHT[0] <= rows - floor_thick - empty_rows <= OBJECT_HEIGHT[1]
]


def _gen_object_mask(height: int) -> np.ndarray:
    mask = np.zeros((height, OBJECT_WIDTH), dtype=bool)
    mask[:SOLID_TOP_ROWS, :] = True
    mask[SOLID_TOP_ROWS:, CHECKER_COLS] = True
    return mask


def _gen_place_original(
    grid: np.ndarray, top: int, side: str, color: int, mask: np.ndarray
) -> None:
    c0 = 0 if side == "left" else grid.shape[1] - mask.shape[1]
    region = grid[top : top + mask.shape[0], c0 : c0 + mask.shape[1]]
    region[mask] = color


def _gen_place_sheared(
    grid: np.ndarray, top: int, side: str, color: int, mask: np.ndarray
) -> np.ndarray:
    width = grid.shape[1]
    bottom_cols = []
    for rel_r in range(mask.shape[0]):
        rel_cols = np.flatnonzero(mask[rel_r])
        inward_shift = max(0, rel_r - SHEAR_LOCK_ROWS + 1)
        c0 = width - mask.shape[1] - inward_shift if side == "right" else inward_shift
        dst_cols = c0 + rel_cols
        grid[top + rel_r, dst_cols] = color
        bottom_cols = dst_cols
    return bottom_cols


def _gen_attempt() -> np.ndarray | None:
    height, floor_thick, empty_rows, obj_h = random.choice(ROW_LAYOUTS)
    width = random.randint(*GRID_COLS)
    if OBJECT_WIDTH + max(0, obj_h - SHEAR_LOCK_ROWS) > width:
        return None

    bg, floor, obj = random.sample(AVAILABLE_COLORS, 3)
    floor_row = height - floor_thick
    obj_mask = _gen_object_mask(obj_h)
    dst_side = random.choice(SIDES)
    src_side = "right" if dst_side == "left" else "left"

    out = np.full((height, width), bg, dtype=int)
    out[floor_row:, :] = floor
    bottom_cols = _gen_place_sheared(out, empty_rows, dst_side, obj, obj_mask)
    if dst_side == "right":
        out[floor_row, : int(bottom_cols.max())] = TRAIL_COLOR
    else:
        out[floor_row, int(bottom_cols.min()) + 1 :] = TRAIL_COLOR

    inp = out.copy()
    inp[inp == obj] = bg
    inp[floor_row, inp[floor_row] == TRAIL_COLOR] = floor
    _gen_place_original(inp, empty_rows, src_side, obj, obj_mask)

    return inp if np.array_equal(main(inp), out) else None


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")
from __future__ import annotations

import numpy as np

from arc_utils import get_bg
import random


def main(grid: np.ndarray) -> np.ndarray:
    """
    Erase the top palette row and redraw it below as a widening wedge centered on its missing cell.

    Input structure
    - The top row is a palette row with exactly one background gap.
    - Below it, the only foreground is one vertical marker bar of a single color.
    - The marker bar is either in the gap column or immediately beside it.

    Rule
    - Clear the grid to background.
    - Starting at the top of the marker bar, each next row copies one more
      column of the top-row palette on both sides of the gap.
    - Fill the gap column with the marker color, and keep the vertical marker bar.

    Key insight
    - The lone background cell in the top row is the center of the expanding
      copy; the lower vertical bar provides the center color and the row where
      the expansion begins.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    height, width = g.shape

    bg = get_bg(g)
    top = g[0, :]
    gap_cols = np.flatnonzero(top == bg)
    assert gap_cols.size == 1, "expected exactly one background gap in the top row"
    gap_col = int(gap_cols[0])

    lower_coords = np.argwhere(g[1:, :] != bg)
    assert lower_coords.size > 0, "expected a lower marker bar"
    lower_coords[:, 0] += 1

    marker_colors = {int(g[r, c]) for r, c in lower_coords}
    marker_cols = {int(c) for _r, c in lower_coords}
    assert len(marker_colors) == 1, "expected one lower marker color"
    assert len(marker_cols) == 1, "expected one lower marker column"
    marker = marker_colors.pop()
    line_col = marker_cols.pop()
    line_start = int(lower_coords[:, 0].min())

    assert np.all(g[1:line_start, :] == bg), "rows before the marker bar must be background"
    assert np.all(g[line_start:, line_col] == marker), "marker bar must be solid"
    assert lower_coords.shape[0] == height - line_start, "marker bar must be the only lower foreground"
    assert line_col == gap_col or abs(line_col - gap_col) == 1
    if line_col != gap_col:
        assert top[line_col] == marker
    assert np.all(top[np.arange(width) != gap_col] != bg), "only the gap may be background in the palette row"

    out = np.full_like(g, bg)
    out[line_start:, line_col] = marker

    for r in range(line_start, height):
        radius = r - line_start
        c0 = max(0, gap_col - radius)
        c1 = min(width - 1, gap_col + radius)
        for c in range(c0, c1 + 1):
            if radius == 0 and c == gap_col and line_col != gap_col:
                continue
            out[r, c] = marker if c == gap_col else int(top[c])
        out[r, line_col] = marker

    return out

# --------------- generator (att2) ---------------
# Canvas, structure, and retries.
_CANVAS_SIZES = (9, 11, 13)
_LINE_START_MIN = 2
_MAX_ATTEMPTS = 300
# Color roles.
_BACKGROUND, _MARKER = 5, 8
_PALETTE_COLORS = (0, 1, 2, 3, 4, 6, 7, 8, 9)


def _gen_expected_output(inp: np.ndarray, line_start: int) -> np.ndarray:
    n = inp.shape[0]
    gap_col = n // 2
    out = np.full_like(inp, _BACKGROUND)
    top = inp[0]

    for r in range(line_start, n):
        radius = r - line_start
        c0 = max(0, gap_col - radius)
        c1 = min(n - 1, gap_col + radius)
        for c in range(c0, c1 + 1):
            out[r, c] = _MARKER if c == gap_col else int(top[c])

    return out


def _make_input_grid(n: int, line_start: int) -> np.ndarray:
    gap_col = n // 2
    inp = np.full((n, n), _BACKGROUND, dtype=int)
    for c in range(n):
        if c != gap_col:
            inp[0, c] = random.choice(_PALETTE_COLORS)
    inp[line_start:, gap_col] = _MARKER
    return inp


def _gen_attempt() -> np.ndarray | None:
    n = random.choice(_CANVAS_SIZES)
    line_start = random.randint(_LINE_START_MIN, n // 2 - 1)
    inp = _make_input_grid(n, line_start)
    expected = _gen_expected_output(inp, line_start)
    if not np.array_equal(main(inp), expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid bae5c565 input")
from __future__ import annotations

import numpy as np

from arc_utils import Color, colors_present, find_components, get_bg


ARM_OFFSETS = (
    (0, -3),
    (0, -2),
    (0, 2),
    (0, 3),
    (-3, 0),
    (-2, 0),
    (2, 0),
    (3, 0),
)
GAP_OFFSETS = ((0, -1), (0, 1), (-1, 0), (1, 0))


def _assert_two_cell_bars(g: np.ndarray, bg: int, fg: int) -> None:
    components = find_components(g, bg=bg, connectivity=4, colors=[fg])
    assert components, "expected foreground bars"
    for component in components:
        coords = np.asarray(component["coords"], dtype=int)
        assert coords.shape == (2, 2), "each foreground object must be a two-pixel bar"
        r0, c0 = map(int, coords[0])
        r1, c1 = map(int, coords[1])
        is_bar = (r0 == r1 and abs(c0 - c1) == 1) or (c0 == c1 and abs(r0 - r1) == 1)
        assert is_bar, "foreground objects must be horizontal or vertical adjacent pairs"


def _is_cross_center(g: np.ndarray, r: int, c: int, bg: int, fg: int) -> bool:
    if int(g[r, c]) != bg:
        return False
    return all(int(g[r + dr, c + dc]) == fg for dr, dc in ARM_OFFSETS) and all(
        int(g[r + dr, c + dc]) == bg for dr, dc in GAP_OFFSETS
    )


def main(grid: np.ndarray) -> np.ndarray:
    """
    Mark the missing center of each plus-shaped arrangement of four two-pixel bars with yellow.

    Input structure:
    - The background is the dominant color.
    - The single foreground color forms isolated 4-connected objects, each a horizontal or vertical two-pixel bar.
    - Some bars form an implied plus sign: two horizontal bars and two vertical bars around an empty center, with a one-pixel gap between the center and each bar.

    Rule:
    - Keep the input unchanged except at implied plus-sign centers.
    - For every background pixel with foreground bars at offsets 2-3 cells left, right, above, and below, recolor that center yellow.
    - The one-pixel gaps immediately next to the center in the four cardinal directions must remain background.

    Key insight:
    - The yellow pixels are not extending a line; they identify the shared missing center where four separated two-pixel bars align as a plus sign.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    height, width = g.shape
    assert height >= 7 and width >= 7, "grid must be large enough for the plus motif"

    bg = get_bg(g)
    foreground = colors_present(g, exclude={bg})
    assert len(foreground) == 1, "expected exactly one foreground color"
    fg = int(foreground[0])
    assert bg != Color.YELLOW and fg != Color.YELLOW, "yellow is reserved for output markers"
    _assert_two_cell_bars(g, bg, fg)

    centers = [
        (r, c)
        for r in range(3, height - 3)
        for c in range(3, width - 3)
        if _is_cross_center(g, r, c, bg, fg)
    ]
    assert centers, "expected at least one missing plus center"

    out = g.copy()
    for r, c in centers:
        out[r, c] = Color.YELLOW
    return out

# --------------- generator (att1) ---------------

# Canvas and color bounds.
GRID_SIZE_MIN = 8
GRID_SIZE_MAX_EXCLUSIVE = 21
BACKGROUND_COLOR = 8
FOREGROUND_COLOR = 1

# Plus motif placement.
PLUS_COUNT_MIN = 1
PLUS_COUNT_MAX_EXCLUSIVE = 5
CENTER_MARGIN = 3
CENTER_TRIES = 100

# Distractor bar placement.
DISTRACTOR_RATIO_MIN = 0.2
DISTRACTOR_RATIO_MAX = 0.6
DISTRACTOR_RETRY_MULTIPLIER = 20
NEW_PLUS_SCAN_RADIUS = 3

# Overall generation retries.
GENERATION_ATTEMPTS = 300
NEIGHBOR_OFFSETS = ((-1, 0), (1, 0), (0, -1), (0, 1))


def _offset_cells(r: int, c: int, offsets: tuple[tuple[int, int], ...]) -> list[tuple[int, int]]:
    return [(r + dr, c + dc) for dr, dc in offsets]


def _all_cells_bg(grid: np.ndarray, cells: list[tuple[int, int]], bg: int) -> bool:
    height, width = grid.shape
    for r, c in cells:
        if r < 0 or r >= height or c < 0 or c >= width:
            return False
        if grid[r, c] != bg:
            return False
    return True


def _cells_are_isolated(grid: np.ndarray, cells: list[tuple[int, int]], bg: int) -> bool:
    """Check that cells have no 4-neighbor foreground outside their own component."""
    height, width = grid.shape
    cell_set = set(cells)
    for r, c in cells:
        for dr, dc in NEIGHBOR_OFFSETS:
            nr, nc = r + dr, c + dc
            if (nr, nc) in cell_set:
                continue
            if 0 <= nr < height and 0 <= nc < width and grid[nr, nc] != bg:
                return False
    return True


def _place_plus_centers(grid: np.ndarray, rng: np.random.Generator, count: int, bg: int, fg: int) -> list[tuple[int, int]]:
    """Place up to count complete plus motifs and return their hidden centers."""
    height, width = grid.shape
    centers = []
    for _ in range(count):
        found = False
        for _try in range(CENTER_TRIES):
            r = int(rng.integers(CENTER_MARGIN, height - CENTER_MARGIN))
            c = int(rng.integers(CENTER_MARGIN, width - CENTER_MARGIN))
            arm_cells = _offset_cells(r, c, ARM_OFFSETS)
            gap_cells = _offset_cells(r, c, GAP_OFFSETS)
            all_cells = arm_cells + gap_cells + [(r, c)]

            if not _all_cells_bg(grid, all_cells, bg):
                continue
            if not _cells_are_isolated(grid, arm_cells, bg):
                continue

            for ar, ac in arm_cells:
                grid[ar, ac] = fg
            centers.append((r, c))
            found = True
            break

        if not found:
            break
    return centers


def _target_distractor_count(rng: np.random.Generator, plus_count: int) -> int:
    arm_bars = plus_count * 4
    ratio = rng.uniform(DISTRACTOR_RATIO_MIN, DISTRACTOR_RATIO_MAX)
    return max(1, int(round(arm_bars * ratio / (1 - ratio))))


def _candidate_centers_near_bar(bar_cells: list[tuple[int, int]], height: int, width: int) -> set[tuple[int, int]]:
    check_cells = set()
    for br, bc in bar_cells:
        for dr in range(-NEW_PLUS_SCAN_RADIUS, NEW_PLUS_SCAN_RADIUS + 1):
            for dc in range(-NEW_PLUS_SCAN_RADIUS, NEW_PLUS_SCAN_RADIUS + 1):
                cr, cc = br + dr, bc + dc
                if CENTER_MARGIN <= cr < height - CENTER_MARGIN and CENTER_MARGIN <= cc < width - CENTER_MARGIN:
                    check_cells.add((cr, cc))
    return check_cells


def _would_create_extra_plus(
    grid: np.ndarray, bar_cells: list[tuple[int, int]], centers: list[tuple[int, int]], bg: int, fg: int
) -> bool:
    height, width = grid.shape
    for cr, cc in _candidate_centers_near_bar(bar_cells, height, width):
        if (cr, cc) in centers:
            continue
        if grid[cr, cc] != bg:
            continue
        arms_ok = all(0 <= cr + dr < height and 0 <= cc + dc < width and grid[cr + dr, cc + dc] == fg
                      for dr, dc in ARM_OFFSETS)
        gaps_ok = all(0 <= cr + dr < height and 0 <= cc + dc < width and grid[cr + dr, cc + dc] == bg
                      for dr, dc in GAP_OFFSETS)
        if arms_ok and gaps_ok:
            return True
    return False


def _place_distractors(
    grid: np.ndarray, rng: np.random.Generator, target_count: int, centers: list[tuple[int, int]], bg: int, fg: int
) -> int:
    height, width = grid.shape
    placed = 0
    for _ in range(target_count * DISTRACTOR_RETRY_MULTIPLIER):
        if placed >= target_count:
            break

        orientation = rng.integers(0, 2)
        r0 = int(rng.integers(0, height))
        c0 = int(rng.integers(0, width))
        if orientation == 0:
            r1, c1 = r0, c0 + 1
        else:
            r1, c1 = r0 + 1, c0

        if r1 >= height or c1 >= width:
            continue
        if grid[r0, c0] != bg or grid[r1, c1] != bg:
            continue

        bar_cells = [(r0, c0), (r1, c1)]
        if not _cells_are_isolated(grid, bar_cells, bg):
            continue

        for r, c in bar_cells:
            grid[r, c] = fg

        if _would_create_extra_plus(grid, bar_cells, centers, bg, fg):
            for r, c in bar_cells:
                grid[r, c] = bg
            continue

        placed += 1
    return placed


def _passes_solver_oracle(grid: np.ndarray, centers: list[tuple[int, int]]) -> bool:
    try:
        out = main(grid.copy())
    except (AssertionError, Exception):
        return False

    expected = grid.copy()
    for r, c in centers:
        expected[r, c] = 4
    return np.array_equal(out, expected)


def _gen_attempt() -> np.ndarray | None:
    rng = np.random.default_rng()

    height = rng.integers(GRID_SIZE_MIN, GRID_SIZE_MAX_EXCLUSIVE)
    width = rng.integers(GRID_SIZE_MIN, GRID_SIZE_MAX_EXCLUSIVE)
    bg = BACKGROUND_COLOR
    fg = FOREGROUND_COLOR

    grid = np.full((height, width), bg, dtype=int)

    plus_count = rng.integers(PLUS_COUNT_MIN, PLUS_COUNT_MAX_EXCLUSIVE)
    if height < 2 * CENTER_MARGIN + 1 or width < 2 * CENTER_MARGIN + 1:
        return None

    centers = _place_plus_centers(grid, rng, plus_count, bg, fg)
    if len(centers) == 0:
        return None

    distractor_count = _target_distractor_count(rng, len(centers))
    placed_distractors = _place_distractors(grid, rng, distractor_count, centers, bg, fg)
    if placed_distractors < 1:
        return None

    if not _passes_solver_oracle(grid, centers):
        return None

    return grid


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_ATTEMPTS):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts")
from __future__ import annotations

import numpy as np

from arc_utils import bbox_h, bbox_w, colors_present, find_components, get_bg, paste, random_free_location
import random


def _is_solid_vertical_bar(component: dict) -> bool:
    return bbox_w(component["bbox"]) == 1 and int(component["area"]) == bbox_h(component["bbox"])


def main(grid: np.ndarray) -> np.ndarray:
    """
    Advance the marker from one half of a vertical bar to the same half of the next longer bar.

    Input structure
    - The grid has one dominant background color and exactly two foreground colors.
    - One foreground color forms many vertical one-cell-wide bars; the other appears as a single vertical marker segment.
    - The marker segment occupies exactly the top or bottom half of its containing vertical bar.
    Rule
    - Recolor the current marker segment back to the bar color.
    - Find the unique all-bar-color vertical bar whose height is two pixels greater than the marked source bar.
    - Recolor the same half of that next longer bar to the marker color.
    Key insight
    - Each bar's total height encodes an ordered size, and the marker advances from a 2k bar to the corresponding 2(k+1) bar while preserving whether it marks the top or bottom half.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    bg = int(get_bg(g))
    colors = colors_present(g, exclude={bg})
    assert len(colors) == 2, f"expected exactly two foreground colors, got {colors}"

    mono_component_counts = {
        int(color): len(
            find_components(
                g,
                bg=bg,
                colors=[int(color)],
                connectivity=4,
                monochromatic=True,
            )
        )
        for color in colors
    }
    marker_colors = [color for color, count in mono_component_counts.items() if count == 1]
    assert len(marker_colors) == 1, f"expected one single-component marker color, got {mono_component_counts}"
    marker_color = int(marker_colors[0])

    bar_colors = [int(color) for color in colors if int(color) != marker_color]
    assert len(bar_colors) == 1
    bar_color = int(bar_colors[0])

    marker_components = find_components(
        g,
        bg=bg,
        colors=[marker_color],
        connectivity=4,
        monochromatic=True,
    )
    assert len(marker_components) == 1
    marker = marker_components[0]
    marker_area = int(marker["area"])
    mr0, mc0, mr1, _mc1 = marker["bbox"]
    assert _is_solid_vertical_bar(marker)

    bars = find_components(g, bg=bg, connectivity=4, monochromatic=False)
    source_bars = [
        bar
        for bar in bars
        if np.any(g[bar["coords"][:, 0], bar["coords"][:, 1]] == marker_color)
    ]
    assert len(source_bars) == 1, f"expected one bar containing the marker, got {len(source_bars)}"
    source = source_bars[0]
    sr0, sc0, sr1, sc1 = source["bbox"]
    source_h = bbox_h(source["bbox"])
    assert _is_solid_vertical_bar(source)
    assert source_h == 2 * marker_area
    assert mc0 == sc0 == sc1

    if mr0 == sr0 and mr1 == sr0 + marker_area - 1:
        marked_end = "top"
    elif mr1 == sr1 and mr0 == sr1 - marker_area + 1:
        marked_end = "bottom"
    else:
        raise AssertionError(f"marker is not exactly one end-half: marker={marker['bbox']} source={source['bbox']}")

    target_h = source_h + 2
    target_bars = []
    for bar in bars:
        values = g[bar["coords"][:, 0], bar["coords"][:, 1]]
        if set(map(int, values)) != {bar_color}:
            continue
        if not _is_solid_vertical_bar(bar):
            continue
        if bbox_h(bar["bbox"]) == target_h:
            target_bars.append(bar)

    assert len(target_bars) == 1, f"expected one next-longer target bar, got {[bar['bbox'] for bar in target_bars]}"
    target = target_bars[0]
    tr0, tc0, tr1, _tc1 = target["bbox"]
    target_half = target_h // 2

    out = g.copy()
    out[g == marker_color] = bar_color
    if marked_end == "top":
        out[tr0 : tr0 + target_half, tc0] = marker_color
    else:
        out[tr1 - target_half + 1 : tr1 + 1, tc0] = marker_color

    return out

# --------------- generator (att2, o5x) ---------------

# Fixed palette observed in all examples.
BG = 7
BAR_COLOR = 8
MARKER_COLOR = 9
# Grid geometry and vertical bar vocabulary.
GRID_SHAPE = (16, 16)
PROGRESSION_HEIGHTS = (2, 4, 6, 8, 10)
SOURCE_HEIGHTS = PROGRESSION_HEIGHTS[:-1]
DISTRACTOR_HEIGHT = 2
HEIGHT_STEP = 2
# Placement constraints and structural sampling.
PLACEMENT_PADDING = 1
PLACEMENT_CONNECTIVITY = 4
DISTRACTOR_COUNT_RANGE = (5, 11)
MARKED_HALVES = ("top", "bottom")
# Rejection-sampling retry budget.
MAX_GENERATION_ATTEMPTS = 300


def _paint_bar_half(grid: np.ndarray, row: int, col: int, height: int, marked_half: str, color: int) -> None:
    """Paint the selected top or bottom half in place."""
    half = height // 2
    if marked_half == "top":
        grid[row : row + half, col] = color
    else:
        grid[row + height - half : row + height, col] = color


def _bar_patch(height: int, *, marked_half: str | None = None) -> np.ndarray:
    patch = np.full((height, 1), BAR_COLOR, dtype=int)
    if marked_half is not None:
        _paint_bar_half(patch, 0, 0, height, marked_half, MARKER_COLOR)
    return patch


def _place_bar(canvas: np.ndarray, patch: np.ndarray) -> tuple[int, int]:
    r, c = random_free_location(
        canvas,
        patch,
        transparent=BG,
        padding=PLACEMENT_PADDING,
        padding_connectivity=PLACEMENT_CONNECTIVITY,
    )
    paste(canvas, patch, r, c)
    return r, c


def _place_progression_bars(canvas: np.ndarray, target_h: int, marked_half: str) -> dict[int, tuple[int, int]]:
    """Place one bar for each progression height and return height to top-left."""
    bar_tops: dict[int, tuple[int, int]] = {}
    for height in random.sample(PROGRESSION_HEIGHTS, len(PROGRESSION_HEIGHTS)):
        marker = marked_half if height == target_h else None
        bar_tops[height] = _place_bar(canvas, _bar_patch(height, marked_half=marker))
    return bar_tops


def _derive_input(out: np.ndarray, bar_tops: dict[int, tuple[int, int]], source_h: int, target_h: int, marked_half: str) -> np.ndarray:
    """Move the output marker back from target to source."""
    inp = out.copy()
    tr, tc = bar_tops[target_h]
    _paint_bar_half(inp, tr, tc, target_h, marked_half, BAR_COLOR)

    sr, sc = bar_tops[source_h]
    _paint_bar_half(inp, sr, sc, source_h, marked_half, MARKER_COLOR)
    return inp


def _gen_attempt() -> np.ndarray | None:
    source_h = random.choice(SOURCE_HEIGHTS)
    target_h = source_h + HEIGHT_STEP
    marked_half = random.choice(MARKED_HALVES)
    out = np.full(GRID_SHAPE, BG, dtype=int)

    try:
        bar_tops = _place_progression_bars(out, target_h, marked_half)
        for _ in range(random.randint(*DISTRACTOR_COUNT_RANGE)):
            _place_bar(out, _bar_patch(DISTRACTOR_HEIGHT))
    except ValueError:
        return None

    inp = _derive_input(out, bar_tops, source_h, target_h, marked_half)
    try:
        if np.array_equal(main(inp), out):
            return inp
    except AssertionError:
        return None
    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 48634b99 input")

