def main(grid: np.ndarray) -> np.ndarray:
    """Recolor the small defect bars on each shared-color object with the opposite panel color.

    Input structure
    - The grid contains two large panel colors and one shared object color.
    - Each shared-color object is a mostly solid rectangle inside exactly one panel.
    Rule
    - Find the near-solid rectangular core of each object.
    - Missing core pixels and one-cell protrusions define two-pixel bars perpendicular to the nearest core edge.
    - Recolor those bars with the other panel color; leave all other pixels unchanged.
    Key insight
    - The colors to add are not tied to numeric ids: each object's surrounding panel identifies the opposite panel color.
    """
    g = np.asarray(grid, dtype=int)
    out = g.copy()

    object_color, components, panel_colors = _object_components(g)
    for coords in components:
        neighbors = _neighbor_colors(g, coords, object_color)
        assert len(neighbors) == 1
        panel_color = next(iter(neighbors))
        target_colors = panel_colors - {panel_color}
        assert len(target_colors) == 1
        target_color = next(iter(target_colors))

        rect = _core_rect(coords)
        for r, c in _defect_bar_cells(coords, rect):
            assert 0 <= r < g.shape[0] and 0 <= c < g.shape[1]
            assert int(g[r, c]) in {object_color, panel_color}
            out[r, c] = target_color

    return out

# --------------- generator (att1) ---------------

# Palette and canvas bounds.
COLOR_IDS = list(range(10))
GRID_SIZE_MIN = 20
GRID_SIZE_MAX = 27

# Panel layout bounds and options.
MIN_PANEL_DIM = 9
MIN_VISIBLE_BORDERS = 2
BORDER_CHOICES = (0, 1)
OFFSET_MIN = 2
OFFSET_MAX = 6
HORIZONTAL_LAYOUT = 0
VERTICAL_LAYOUT = 1
HORIZONTAL_OFFSETS = ("left", "right", "none")
VERTICAL_OFFSETS = ("top", "bottom", "none")

# Object geometry and placement constraints.
OBJECTS_PER_PANEL = (1, 2)
CORE_H_MIN = 3
CORE_H_MAX = 7
CORE_W_MIN = 3
CORE_W_MAX = 9
DEFECT_COUNT_MIN = 1
DEFECT_COUNT_MAX = 3
DEFECT_SIDES = ("top", "bottom", "left", "right")
DEFECT_TYPES = ("missing", "protrusion")
PANEL_MARGIN = 1
OBJECT_GAP = 2
MAX_PLACE_TRIES = 30

# Generation retry budget.
MAX_GENERATE_ATTEMPTS = 300


def _choose_palette() -> tuple[int, int, int, int]:
    colors = COLOR_IDS[:]
    random.shuffle(colors)
    return tuple(colors[:4])


def _choose_borders() -> tuple[int, int, int, int]:
    borders = [random.choice(BORDER_CHOICES) for _ in range(4)]
    while sum(borders) < MIN_VISIBLE_BORDERS:
        borders[random.randint(0, 3)] = 1
    return tuple(borders)


def _build_horizontal_panels(
    grid: np.ndarray,
    panel_a_color: int,
    panel_b_color: int,
) -> list[tuple[int, int, int, int, int]] | None:
    """Create two panels sharing a horizontal border; returns panel records."""
    H, W = grid.shape
    split_r = random.randint(MIN_PANEL_DIM, H - MIN_PANEL_DIM - 1)
    border_top, border_bot, border_left, border_right = _choose_borders()

    pa_height = split_r - border_top
    pb_height = H - border_bot - split_r
    if pa_height < MIN_PANEL_DIM or pb_height < MIN_PANEL_DIM:
        return None

    offset_side = random.choice(HORIZONTAL_OFFSETS)
    if offset_side == "none":
        pa_c0, pa_c1 = border_left, W - 1 - border_right
        pb_c0, pb_c1 = border_left, W - 1 - border_right
    elif offset_side == "left":
        offset_cols = random.randint(OFFSET_MIN, min(OFFSET_MAX, W - 2 * MIN_PANEL_DIM))
        if random.random() < 0.5:
            pa_c0 = border_left
            pa_c1 = W - 1 - border_right
            pb_c0 = border_left + offset_cols
            pb_c1 = W - 1 - border_right
        else:
            pa_c0 = border_left + offset_cols
            pa_c1 = W - 1 - border_right
            pb_c0 = border_left
            pb_c1 = W - 1 - border_right
    else:
        offset_cols = random.randint(OFFSET_MIN, min(OFFSET_MAX, W - 2 * MIN_PANEL_DIM))
        if random.random() < 0.5:
            pa_c0 = border_left
            pa_c1 = W - 1 - border_right - offset_cols
            pb_c0 = border_left
            pb_c1 = W - 1 - border_right
        else:
            pa_c0 = border_left
            pa_c1 = W - 1 - border_right
            pb_c0 = border_left
            pb_c1 = W - 1 - border_right - offset_cols

    if pa_c1 - pa_c0 + 1 < MIN_PANEL_DIM or pb_c1 - pb_c0 + 1 < MIN_PANEL_DIM:
        return None
    if min(pa_c1, pb_c1) < max(pa_c0, pb_c0):
        return None

    pa_r0, pa_r1 = border_top, split_r - 1
    pb_r0, pb_r1 = split_r, H - 1 - border_bot
    grid[pa_r0:pa_r1 + 1, pa_c0:pa_c1 + 1] = panel_a_color
    grid[pb_r0:pb_r1 + 1, pb_c0:pb_c1 + 1] = panel_b_color
    return [
        (panel_a_color, pa_r0, pa_r1, pa_c0, pa_c1),
        (panel_b_color, pb_r0, pb_r1, pb_c0, pb_c1),
    ]


def _build_vertical_panels(
    grid: np.ndarray,
    panel_a_color: int,
    panel_b_color: int,
) -> list[tuple[int, int, int, int, int]] | None:
    """Create two panels sharing a vertical border; returns panel records."""
    H, W = grid.shape
    split_c = random.randint(MIN_PANEL_DIM, W - MIN_PANEL_DIM - 1)
    border_top, border_bot, border_left, border_right = _choose_borders()

    pa_width = split_c - border_left
    pb_width = W - border_right - split_c
    if pa_width < MIN_PANEL_DIM or pb_width < MIN_PANEL_DIM:
        return None

    offset_side = random.choice(VERTICAL_OFFSETS)
    if offset_side == "none":
        pa_r0, pa_r1 = border_top, H - 1 - border_bot
        pb_r0, pb_r1 = border_top, H - 1 - border_bot
    elif offset_side == "top":
        offset_rows = random.randint(OFFSET_MIN, min(OFFSET_MAX, H - 2 * MIN_PANEL_DIM))
        if random.random() < 0.5:
            pa_r0, pa_r1 = border_top, H - 1 - border_bot
            pb_r0, pb_r1 = border_top + offset_rows, H - 1 - border_bot
        else:
            pa_r0, pa_r1 = border_top + offset_rows, H - 1 - border_bot
            pb_r0, pb_r1 = border_top, H - 1 - border_bot
    else:
        offset_rows = random.randint(OFFSET_MIN, min(OFFSET_MAX, H - 2 * MIN_PANEL_DIM))
        if random.random() < 0.5:
            pa_r0, pa_r1 = border_top, H - 1 - border_bot - offset_rows
            pb_r0, pb_r1 = border_top, H - 1 - border_bot
        else:
            pa_r0, pa_r1 = border_top, H - 1 - border_bot
            pb_r0, pb_r1 = border_top, H - 1 - border_bot - offset_rows

    pa_c0, pa_c1 = border_left, split_c - 1
    pb_c0, pb_c1 = split_c, W - 1 - border_right
    if pa_r1 - pa_r0 + 1 < MIN_PANEL_DIM or pb_r1 - pb_r0 + 1 < MIN_PANEL_DIM:
        return None
    if min(pa_r1, pb_r1) < max(pa_r0, pb_r0):
        return None

    grid[pa_r0:pa_r1 + 1, pa_c0:pa_c1 + 1] = panel_a_color
    grid[pb_r0:pb_r1 + 1, pb_c0:pb_c1 + 1] = panel_b_color
    return [
        (panel_a_color, pa_r0, pa_r1, pa_c0, pa_c1),
        (panel_b_color, pb_r0, pb_r1, pb_c0, pb_c1),
    ]


def _make_panel_grid(
    panel_a_color: int,
    panel_b_color: int,
    bg_color: int,
) -> tuple[np.ndarray, list[tuple[int, int, int, int, int]]] | None:
    """Sample the canvas and panel layout."""
    H = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
    W = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
    grid = np.full((H, W), bg_color, dtype=int)

    orientation = random.randint(HORIZONTAL_LAYOUT, VERTICAL_LAYOUT)
    if orientation == HORIZONTAL_LAYOUT:
        panels = _build_horizontal_panels(grid, panel_a_color, panel_b_color)
    else:
        panels = _build_vertical_panels(grid, panel_a_color, panel_b_color)
    if panels is None:
        return None
    return grid, panels


def _object_overlaps(full_bbox: tuple[int, int, int, int], placed_bboxes: list[tuple[int, int, int, int]]) -> bool:
    full_r0, full_r1, full_c0, full_c1 = full_bbox
    for br0, br1, bc0, bc1 in placed_bboxes:
        if (
            full_r0 - OBJECT_GAP <= br1
            and full_r1 + OBJECT_GAP >= br0
            and full_c0 - OBJECT_GAP <= bc1
            and full_c1 + OBJECT_GAP >= bc0
        ):
            return True
    return False


def _place_core(
    panel_bbox: tuple[int, int, int, int],
    core_h: int,
    core_w: int,
    sides: list[str],
    placed_bboxes: list[tuple[int, int, int, int]],
) -> tuple[tuple[int, int, int, int], tuple[int, int, int, int]] | None:
    """Find a non-overlapping core bbox and its full bbox including bars."""
    pr0, pr1, pc0, pc1 = panel_bbox
    extra_top = 1 if "top" in sides else 0
    extra_bot = 1 if "bottom" in sides else 0
    extra_left = 1 if "left" in sides else 0
    extra_right = 1 if "right" in sides else 0

    place_r0 = pr0 + PANEL_MARGIN + extra_top
    place_r1 = pr1 - PANEL_MARGIN - extra_bot - core_h + 1
    place_c0 = pc0 + PANEL_MARGIN + extra_left
    place_c1 = pc1 - PANEL_MARGIN - extra_right - core_w + 1
    if place_r1 < place_r0 or place_c1 < place_c0:
        return None

    for _ in range(MAX_PLACE_TRIES):
        cr0 = random.randint(place_r0, place_r1)
        cc0 = random.randint(place_c0, place_c1)
        cr1 = cr0 + core_h - 1
        cc1 = cc0 + core_w - 1
        full_bbox = (cr0 - extra_top, cr1 + extra_bot, cc0 - extra_left, cc1 + extra_right)
        if not _object_overlaps(full_bbox, placed_bboxes):
            return (cr0, cr1, cc0, cc1), full_bbox
    return None


def _apply_defect(
    input_grid: np.ndarray,
    output_grid: np.ndarray,
    core_bbox: tuple[int, int, int, int],
    side: str,
    defect_type: str,
    panel_color: int,
    obj_color: int,
    other_panel_color: int,
) -> bool:
    """Apply one sampled input defect and its two-cell output bar."""
    cr0, cr1, cc0, cc1 = core_bbox
    if side == "top":
        if defect_type == "missing":
            valid_cols = list(range(cc0 + 1, cc1))
            if not valid_cols:
                return False
            dc = random.choice(valid_cols)
            dr = cr0
            input_grid[dr, dc] = panel_color
            output_grid[dr - 1, dc] = other_panel_color
            output_grid[dr, dc] = other_panel_color
        else:
            dc = random.randint(cc0, cc1)
            dr = cr0 - 1
            input_grid[dr, dc] = obj_color
            output_grid[dr, dc] = other_panel_color
            output_grid[dr + 1, dc] = other_panel_color
    elif side == "bottom":
        if defect_type == "missing":
            valid_cols = list(range(cc0 + 1, cc1))
            if not valid_cols:
                return False
            dc = random.choice(valid_cols)
            dr = cr1
            input_grid[dr, dc] = panel_color
            output_grid[dr, dc] = other_panel_color
            output_grid[dr + 1, dc] = other_panel_color
        else:
            dc = random.randint(cc0, cc1)
            dr = cr1 + 1
            input_grid[dr, dc] = obj_color
            output_grid[dr, dc] = other_panel_color
            output_grid[dr - 1, dc] = other_panel_color
    elif side == "left":
        if defect_type == "missing":
            valid_rows = list(range(cr0 + 1, cr1))
            if not valid_rows:
                return False
            dr = random.choice(valid_rows)
            dc = cc0
            input_grid[dr, dc] = panel_color
            output_grid[dr, dc] = other_panel_color
            output_grid[dr, dc - 1] = other_panel_color
        else:
            dr = random.randint(cr0, cr1)
            dc = cc0 - 1
            input_grid[dr, dc] = obj_color
            output_grid[dr, dc] = other_panel_color
            output_grid[dr, dc + 1] = other_panel_color
    else:
        if defect_type == "missing":
            valid_rows = list(range(cr0 + 1, cr1))
            if not valid_rows:
                return False
            dr = random.choice(valid_rows)
            dc = cc1
            input_grid[dr, dc] = panel_color
            output_grid[dr, dc] = other_panel_color
            output_grid[dr, dc + 1] = other_panel_color
        else:
            dr = random.randint(cr0, cr1)
            dc = cc1 + 1
            input_grid[dr, dc] = obj_color
            output_grid[dr, dc] = other_panel_color
            output_grid[dr, dc - 1] = other_panel_color
    return True


def _place_panel_objects(
    input_grid: np.ndarray,
    output_grid: np.ndarray,
    panel: tuple[int, int, int, int, int],
    n_objs: int,
    obj_color: int,
    other_panel_color: int,
) -> bool:
    """Place all objects for one panel into input and output grids."""
    panel_color, pr0, pr1, pc0, pc1 = panel
    avail_r0 = pr0 + PANEL_MARGIN
    avail_r1 = pr1 - PANEL_MARGIN
    avail_c0 = pc0 + PANEL_MARGIN
    avail_c1 = pc1 - PANEL_MARGIN
    placed_bboxes = []

    for _ in range(n_objs):
        core_h = random.randint(CORE_H_MIN, min(CORE_H_MAX, avail_r1 - avail_r0 - 2))
        core_w = random.randint(CORE_W_MIN, min(CORE_W_MAX, avail_c1 - avail_c0 - 2))
        if core_h < CORE_H_MIN or core_w < CORE_W_MIN:
            return False

        n_defects = random.randint(DEFECT_COUNT_MIN, DEFECT_COUNT_MAX)
        sides = random.sample(DEFECT_SIDES, n_defects)
        defect_types = [random.choice(DEFECT_TYPES) for _ in range(n_defects)]

        placed = _place_core((pr0, pr1, pc0, pc1), core_h, core_w, sides, placed_bboxes)
        if placed is None:
            return False
        core_bbox, full_bbox = placed
        placed_bboxes.append(full_bbox)

        cr0, cr1, cc0, cc1 = core_bbox
        output_grid[cr0:cr1 + 1, cc0:cc1 + 1] = obj_color
        input_grid[cr0:cr1 + 1, cc0:cc1 + 1] = obj_color

        for side, defect_type in zip(sides, defect_types):
            if not _apply_defect(
                input_grid,
                output_grid,
                core_bbox,
                side,
                defect_type,
                panel_color,
                obj_color,
                other_panel_color,
            ):
                return False
    return True


def _gen_attempt() -> np.ndarray | None:
    obj_color, panel_a_color, panel_b_color, bg_color = _choose_palette()
    layout = _make_panel_grid(panel_a_color, panel_b_color, bg_color)
    if layout is None:
        return None
    grid, panels = layout

    n_obj_a = random.choice(OBJECTS_PER_PANEL)
    n_obj_b = random.choice(OBJECTS_PER_PANEL)
    if not 2 <= n_obj_a + n_obj_b <= 4:
        return None

    output_grid = grid.copy()
    input_grid = grid.copy()
    object_counts = (n_obj_a, n_obj_b)
    other_colors = (panel_b_color, panel_a_color)

    for panel, n_objs, other_panel_color in zip(panels, object_counts, other_colors):
        if not _place_panel_objects(
            input_grid,
            output_grid,
            panel,
            n_objs,
            obj_color,
            other_panel_color,
        ):
            return None

    # Verify: run solver on input and check it produces the output
    try:
        result = main(input_grid)
        if np.array_equal(result, output_grid):
            return input_grid
    except (AssertionError, IndexError, ValueError):
        pass

    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATE_ATTEMPTS):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {MAX_GENERATE_ATTEMPTS} attempts")
    return r1, c


def _pink_targets_for_markers(
    markers: list[tuple[int, int, str]],
    square: tuple[int, int, int, int, int],
) -> set[tuple[int, int]]:
    _r0, _c0, _r1, _c1, color = square
    assert color == Color.PINK
    return {_target_for_marker(r, c, side, square) for r, c, side in markers}


def main(grid: np.ndarray) -> np.ndarray:
    """Project maroon markers into adjacent grey or pink 3x3 squares, erasing grey squares afterward.

    Input structure
    The grid has a dominant background, solid 3x3 grey and/or pink squares, and maroon marker pixels or segments directly touching one side of exactly one square.
    Rule
    Grey squares are erased; their adjacent maroon markers stay in place and stamp the nearest edge cell inside the grey square. Pink squares stay pink; their adjacent maroon markers disappear and stamp the corresponding cell on the square's middle row or middle column.
    Key insight
    The side touched by a marker determines the projection: grey uses the near edge, while pink uses the centerline, preserving the marker's coordinate along that side.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    colors = set(map(int, np.unique(g)))
    assert colors <= {bg, Color.GREY, Color.PINK, Color.MAROON}
    assert Color.MAROON in colors

    squares = _squares(g, bg)
    out = g.copy()
    out[g == Color.GREY] = bg

    paint: set[tuple[int, int]] = set()
    remove_sources: list[tuple[int, int]] = []
    pink_markers_by_square: dict[int, list[tuple[int, int, str]]] = {}
    for r, c in np.argwhere(g == Color.MAROON):
        hits = []
        for idx, square in enumerate(squares):
            side = _touch_side(int(r), int(c), square)
            if side is not None:
                hits.append((side, idx, square))
        assert len(hits) == 1

        side, idx, square = hits[0]
        if square[4] == Color.PINK:
            pink_markers_by_square.setdefault(idx, []).append((int(r), int(c), side))
            remove_sources.append((int(r), int(c)))
        else:
            target = _target_for_marker(int(r), int(c), side, square)
            tr, tc = target
            assert g[tr, tc] == square[4]
            paint.add(target)

    for idx, markers in pink_markers_by_square.items():
        square = squares[idx]
        for target in _pink_targets_for_markers(markers, square):
            tr, tc = target
            assert g[tr, tc] == square[4]
            paint.add(target)

    for r, c in remove_sources:
        out[r, c] = bg
    for r, c in paint:
        out[r, c] = Color.MAROON

    return out

# --------------- generator (o5x) ---------------

from arc_utils import paste


# Colors.
_GEN_BG = 8
_GEN_GREY = 5
_GEN_PINK = 6
_GEN_MAROON = 9

# Canvas and square geometry.
_GEN_CANVAS_MIN = 9
_GEN_CANVAS_MAX = 15
_GEN_CANVAS_MAX_DELTA = 2
_GEN_SQUARE_SIZE = 3
_GEN_SQUARE_LAST = _GEN_SQUARE_SIZE - 1
_GEN_SQUARE_GAP = 1

# Square count bounds.
_GEN_TOTAL_SQUARE_MIN = 1
_GEN_TOTAL_SQUARE_MAX = 7
_GEN_GREY_SQUARE_MAX = 3
_GEN_PINK_SQUARE_MAX = 4

# Marker side and count bounds.
_GEN_SIDES = ("left", "right", "above", "below")
_GEN_MARKER_SIDE_MIN = 1
_GEN_MARKER_SIDE_MAX = 3
_GEN_MARKER_PER_SIDE_MAX = 3
_GEN_MARKER_TOTAL_MAX = 5

# Rejection sampling budget.
_GEN_MAX_ATTEMPTS = 300
_GEN_SQUARE_PATCHES = {color: np.full((_GEN_SQUARE_SIZE, _GEN_SQUARE_SIZE), color, dtype=int) for color in (_GEN_GREY, _GEN_PINK)}

_GenSquare = tuple[int, int, int]
_GenMarker = tuple[int, int, str]


def _gen_square_gap_ok(r0: int, c0: int, squares: list[_GenSquare]) -> bool:
    last = _GEN_SQUARE_LAST
    gap = _GEN_SQUARE_GAP
    r1, c1 = r0 + last, c0 + last
    for sr0, sc0, _color in squares:
        sr1, sc1 = sr0 + last, sc0 + last
        if not (
            r1 < sr0 - gap
            or sr1 < r0 - gap
            or c1 < sc0 - gap
            or sc1 < c0 - gap
        ):
            return False
    return True


def _gen_place_square(grid: np.ndarray, r0: int, c0: int, color: int) -> None:
    paste(grid, _GEN_SQUARE_PATCHES[int(color)], r0, c0)


def _gen_side_for_cell(r: int, c: int, square: _GenSquare) -> str | None:
    r0, c0, _color = square
    r1, c1 = r0 + _GEN_SQUARE_LAST, c0 + _GEN_SQUARE_LAST
    if r0 <= r <= r1:
        if c == c0 - 1:
            return "left"
        if c == c1 + 1:
            return "right"
    if c0 <= c <= c1:
        if r == r0 - 1:
            return "above"
        if r == r1 + 1:
            return "below"
    return None


def _gen_inside_square(r: int, c: int, square: _GenSquare) -> bool:
    r0, c0, _color = square
    r1, c1 = r0 + _GEN_SQUARE_LAST, c0 + _GEN_SQUARE_LAST
    return r0 <= r <= r1 and c0 <= c <= c1


def _gen_valid_marker_slot(r: int, c: int, squares: list[_GenSquare]) -> bool:
    if any(_gen_inside_square(r, c, square) for square in squares):
        return False
    hits = sum(
        _gen_side_for_cell(r, c, square) is not None for square in squares
    )
    return hits == 1


def _gen_side_slots(H: int, W: int, square: _GenSquare, squares: list[_GenSquare]) -> dict[str, list[tuple[int, int]]]:
    r0, c0, _color = square
    edge = _GEN_SQUARE_SIZE
    raw = {
        "left": [(r, c0 - 1) for r in range(r0, r0 + edge)] if c0 > 0 else [],
        "right": [(r, c0 + edge) for r in range(r0, r0 + edge)] if c0 + edge < W else [],
        "above": [(r0 - 1, c) for c in range(c0, c0 + edge)] if r0 > 0 else [],
        "below": [(r0 + edge, c) for c in range(c0, c0 + edge)] if r0 + edge < H else [],
    }
    return {
        side: [
            (r, c)
            for r, c in slots
            if _gen_valid_marker_slot(r, c, squares)
        ]
        for side, slots in raw.items()
    }


def _gen_split_marker_total(total: int, caps: list[int]) -> list[int] | None:
    counts: list[int] = []
    remaining = int(total)
    for i, cap in enumerate(caps):
        rest = caps[i + 1 :]
        lo = max(1, remaining - sum(rest))
        hi = min(int(cap), remaining - len(rest))
        if lo > hi:
            return None
        count = random.randint(lo, hi)
        counts.append(count)
        remaining -= count
    return counts if remaining == 0 else None


def _gen_choose_square_markers(H: int, W: int, square: _GenSquare, squares: list[_GenSquare]) -> list[_GenMarker] | None:
    slots_by_side = _gen_side_slots(H, W, square, squares)
    options = [
        (side, slots_by_side[side])
        for side in _GEN_SIDES
        if slots_by_side[side]
    ]
    if not options:
        return None

    possible_side_counts = [
        k
        for k in range(_GEN_MARKER_SIDE_MIN, min(_GEN_MARKER_SIDE_MAX, len(options)) + 1)
        if any(
            sum(min(_GEN_MARKER_PER_SIDE_MAX, len(slots)) for _side, slots in combo) >= k
            for combo in itertools.combinations(options, k)
        )
    ]
    if not possible_side_counts:
        return None

    side_count = random.choice(possible_side_counts)
    combos = [
        combo
        for combo in itertools.combinations(options, side_count)
        if sum(min(_GEN_MARKER_PER_SIDE_MAX, len(slots)) for _side, slots in combo) >= side_count
    ]
    combo = list(random.choice(combos))
    random.shuffle(combo)
    caps = [min(_GEN_MARKER_PER_SIDE_MAX, len(slots)) for _side, slots in combo]
    marker_total = random.randint(side_count, min(_GEN_MARKER_TOTAL_MAX, sum(caps)))
    counts = _gen_split_marker_total(marker_total, caps)
    if counts is None:
        return None

    markers: list[_GenMarker] = []
    for (side, slots), count in zip(combo, counts):
        for r, c in random.sample(slots, count):
            markers.append((r, c, side))
    return markers


def _gen_target_for_marker(r: int, c: int, side: str, square: _GenSquare) -> tuple[int, int]:
    r0, c0, color = square
    r1, c1 = r0 + _GEN_SQUARE_LAST, c0 + _GEN_SQUARE_LAST
    if color == _GEN_PINK:
        if side in {"left", "right"}:
            return r, (c0 + c1) // 2
        return (r0 + r1) // 2, c
    if side == "left":
        return r, c0
    if side == "right":
        return r, c1
    if side == "above":
        return r0, c
    return r1, c


def _gen_pink_targets_for_markers(markers: list[_GenMarker], square: _GenSquare) -> set[tuple[int, int]]:
    _r0, _c0, color = square
    assert color == _GEN_PINK
    return {_gen_target_for_marker(r, c, side, square) for r, c, side in markers}


def _gen_choose_square_colors() -> list[int]:
    total = random.randint(_GEN_TOTAL_SQUARE_MIN, _GEN_TOTAL_SQUARE_MAX)
    grey_min = max(0, total - _GEN_PINK_SQUARE_MAX)
    grey_max = min(_GEN_GREY_SQUARE_MAX, total)
    grey_count = random.randint(grey_min, grey_max)
    colors = [_GEN_GREY] * grey_count + [_GEN_PINK] * (total - grey_count)
    random.shuffle(colors)
    return colors


def _gen_choose_canvas_shape() -> tuple[int, int]:
    H = random.randint(_GEN_CANVAS_MIN, _GEN_CANVAS_MAX)
    W = random.randint(
        max(_GEN_CANVAS_MIN, H - _GEN_CANVAS_MAX_DELTA),
        min(_GEN_CANVAS_MAX, H + _GEN_CANVAS_MAX_DELTA),
    )
    return H, W


def _gen_place_squares(H: int, W: int, colors: list[int]) -> list[_GenSquare] | None:
    squares: list[_GenSquare] = []
    for color in colors:
        candidates = [
            (r0, c0)
            for r0 in range(H - _GEN_SQUARE_SIZE + 1)
            for c0 in range(W - _GEN_SQUARE_SIZE + 1)
            if _gen_square_gap_ok(r0, c0, squares)
        ]
        if not candidates:
            return None
        r0, c0 = random.choice(candidates)
        squares.append((r0, c0, int(color)))
    return squares


def _gen_choose_all_markers(H: int, W: int, squares: list[_GenSquare]) -> list[list[_GenMarker]] | None:
    markers_by_square: list[list[_GenMarker]] = []
    for square in squares:
        markers = _gen_choose_square_markers(H, W, square, squares)
        if markers is None:
            return None
        markers_by_square.append(markers)
    return markers_by_square


def _gen_render_output(H: int, W: int, squares: list[_GenSquare], markers_by_square: list[list[_GenMarker]]) -> np.ndarray:
    out = np.full((H, W), _GEN_BG, dtype=int)
    for r0, c0, color in squares:
        if color == _GEN_PINK:
            _gen_place_square(out, r0, c0, color)

    for square, markers in zip(squares, markers_by_square):
        color = square[2]
        if color == _GEN_PINK:
            for tr, tc in _gen_pink_targets_for_markers(markers, square):
                out[tr, tc] = _GEN_MAROON
        else:
            for r, c, side in markers:
                tr, tc = _gen_target_for_marker(r, c, side, square)
                out[r, c] = _GEN_MAROON
                out[tr, tc] = _GEN_MAROON
    return out


def _gen_build_input(out: np.ndarray, squares: list[_GenSquare], markers_by_square: list[list[_GenMarker]]) -> np.ndarray:
    inp = out.copy()
    for (r0, c0, color), markers in zip(squares, markers_by_square):
        _gen_place_square(inp, r0, c0, color)
        if color == _GEN_PINK:
            for r, c, _side in markers:
                inp[r, c] = _GEN_MAROON
    return inp


def _gen_background_dominates(grid: np.ndarray) -> bool:
    counts = {int(v): int((grid == v).sum()) for v in np.unique(grid)}
    return counts.get(_GEN_BG, 0) > max(
        counts.get(_GEN_GREY, 0),
        counts.get(_GEN_PINK, 0),
        counts.get(_GEN_MAROON, 0),
    )


def _gen_oracle_accepts(inp: np.ndarray, expected: np.ndarray) -> bool:
    try:
        solved = main(inp)
    except Exception:
        return False
    return np.array_equal(solved, expected)


def _gen_attempt() -> np.ndarray | None:
    H, W = _gen_choose_canvas_shape()
    colors = _gen_choose_square_colors()

    squares = _gen_place_squares(H, W, colors)
    if squares is None:
        return None

    markers_by_square = _gen_choose_all_markers(H, W, squares)
    if markers_by_square is None:
        return None

    out = _gen_render_output(H, W, squares, markers_by_square)
    inp = _gen_build_input(out, squares, markers_by_square)
    if not _gen_background_dominates(inp):
        return None
    if not _gen_oracle_accepts(inp, out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(_GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid e39e9282 input")
from __future__ import annotations
import numpy as np
from arc_utils import components_mask, find_components, get_bg

def main(grid: np.ndarray) -> np.ndarray:
    """
    Assemble colored sprites into a central bar's notches, chaining successive pieces along fixed-width strips.

    Input structure:
    - bg = most common color. Largest monochrome component is a solid "bar" with boundary notches (bg holes opening to its bbox edge).
    - Several smaller colored sprites scattered around the bar.

    Rule:
    - Each bar notch is filled by a root piece whose shape exactly covers the hole.
    - The root defines a strip (column-span or row-span) for its chain.
    - Successive pieces fill the bg cells inside the previous piece's bbox, locked to the same strip width.
    - Multiple chains grow independently from different bar notches.

    Key insight: The root piece's extent perpendicular to the chain direction locks the strip width for all subsequent pieces in that chain.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape
    DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]

    bg = get_bg(g)

    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
    comps.sort(key=lambda d: -d["area"])
    assert comps

    bar = comps[0]
    pieces_raw = comps[1:]

    out = np.full((H, W), int(bg), dtype=int)
    bar_r0, bar_c0, bar_r1, bar_c1 = map(int, bar["bbox"])
    bar_h, bar_w = bar_r1 - bar_r0 + 1, bar_c1 - bar_c0 + 1
    bar_color = int(bar["color"])
    bar_occ = set((int(r), int(c)) for r, c in bar["coords"])
    bar_mask = np.zeros((bar_h, bar_w), dtype=bool)
    for r, c in bar_occ:
        bar_mask[r - bar_r0, c - bar_c0] = True
    for r, c in bar_occ:
        out[r, c] = bar_color

    def shape_from_coords(coords: np.ndarray, bbox):
        r0, c0, r1, c1 = map(int, bbox)
        h, w = r1 - r0 + 1, c1 - c0 + 1
        rel = [(int(r - r0), int(c - c0)) for r, c in coords]
        rel_set = set(rel)
        return {"rel": rel, "rel_set": rel_set, "h": h, "w": w}

    pieces = []
    for p in pieces_raw:
        # For this puzzle, pieces are used in their original orientation (no rotation / flip).
        r0, c0 = map(int, p["bbox"][:2])
        pieces.append({"color": int(p["color"]), "shape": shape_from_coords(p["coords"], p["bbox"]), "orig": (r0, c0)})

    def bar_notches(bar_mask, bar_r0, bar_c0):
        empty = ~bar_mask
        h, w = map(int, empty.shape)
        notches = []
        for pts in components_mask(empty, connectivity=4):
            r = pts[:, 0]
            c = pts[:, 1]
            top = int((r == 0).sum())
            bottom = int((r == h - 1).sum())
            left = int((c == 0).sum())
            right = int((c == w - 1).sum())

            # Keep only holes that open to the bar bbox boundary.
            if top + bottom + left + right == 0:
                continue

            hole_gl = set((bar_r0 + int(rr), bar_c0 + int(cc)) for rr, cc in pts)

            # Axis is determined by which bbox side has the widest mouth.
            side, mouth_n = max(
                [(name, cnt) for name, cnt in [("top", top), ("bottom", bottom), ("left", left), ("right", right)] if cnt > 0],
                key=lambda x: x[1],
            )
            axis = "cols" if side in ("top", "bottom") else "rows"
            notches.append({"axis": axis, "hole": hole_gl, "mouth_n": mouth_n})
        return notches

    notches = bar_notches(bar_mask, bar_r0, bar_c0)

    def pixels(v, top, left):
        return set((top + lr, left + lc) for lr, lc in v["rel"])

    def placement_pts(v, top, left, occ, must_cover=None, strip=None):
        if top < 0 or left < 0 or top + v["h"] > H or left + v["w"] > W:
            return None
        if strip is not None:
            axis, A, B = strip
            if axis == "cols":
                if left != A or v["w"] != B - A + 1:
                    return None
            else:
                if top != A or v["h"] != B - A + 1:
                    return None
        pts = pixels(v, top, left)
        if pts & occ:
            return None
        if must_cover is not None and not (must_cover <= pts):
            return None
        return pts

    def aligned_positions(axis, A, cover, v):
        if axis == "cols":
            left = A
            tops = set()
            for rN, cN in cover:
                for lr, lc in v["rel"]:
                    if cN == left + lc:
                        tops.add(rN - lr)
            for top in tops:
                yield top, left
        else:
            top = A
            lefts = set()
            for rN, cN in cover:
                for lr, lc in v["rel"]:
                    if rN == top + lr:
                        lefts.add(cN - lc)
            for left in lefts:
                yield top, left

    def touches(pts, other):
        for r, c in pts:
            for dr, dc in DIR4:
                if (r + dr, c + dc) in other:
                    return True
        return False

    def hole_positions(hole, v):
        pos = set()
        for rH, cH in hole:
            for lr, lc in v["rel"]:
                pos.add((rH - lr, cH - lc))
        return pos

    # Root candidates: fill the bar hole (no strip constraint yet).
    root_cands = []
    for ni, n in enumerate(notches):
        axis = n["axis"]

        for pi, p in enumerate(pieces):
            v = p["shape"]
            for top, left in hole_positions(n["hole"], v):
                pts = placement_pts(v, top, left, bar_occ, must_cover=n["hole"])
                if pts is None:
                    continue
                if axis == "cols":
                    A, B = int(left), int(left + v["w"] - 1)
                else:
                    A, B = int(top), int(top + v["h"] - 1)
                mv = abs(int(top) - int(p["orig"][0])) + abs(int(left) - int(p["orig"][1]))
                root_cands.append(
                    (
                        (int(mv), -int(n["mouth_n"])),
                        {"ni": ni, "pi": pi, "top": int(top), "left": int(left), "axis": axis, "A": A, "B": B, "shape": v},
                    )
                )

    root_cands.sort(key=lambda x: x[0])
    cand_roots = [pair[1] for pair in root_cands[:20]]

    best_out = out.copy()
    best_key = None

    def search(out_grid, occ_set, chains, remaining):
        nonlocal best_out, best_key
        placed_cnt = len(pieces) - len(remaining)
        key = (placed_cnt, -len(remaining), -len(occ_set))
        if best_key is None or key > best_key:
            best_key = key
            best_out = out_grid.copy()
        if not remaining:
            return True

        def gen_extend_moves(chain, remaining_set):
            axis = chain["axis"]
            A, B = int(chain["A"]), int(chain["B"])
            head = chain["head"]
            head_pts = pixels(head["shape"], head["top"], head["left"])
            head_top, head_left = int(head["top"]), int(head["left"])
            head_h, head_w = int(head["shape"]["h"]), int(head["shape"]["w"])

            cavity = {
                (r, c)
                for r in range(head_top, head_top + head_h)
                for c in range(head_left, head_left + head_w)
                if out_grid[r, c] == bg
            }
            if not cavity:
                return []

            moves = []
            for pi in remaining_set:
                v = pieces[pi]["shape"]
                for top, left in aligned_positions(axis, A, cavity, v):
                    pts = placement_pts(v, top, left, occ_set, must_cover=cavity, strip=(axis, A, B))
                    if pts is None:
                        continue
                    if not touches(pts, head_pts):
                        continue
                    moves.append((pi, top, left, pts, v))
            return moves

        # Try extending any chain.
        for ch in chains:
            moves = gen_extend_moves(ch, remaining)
            if not moves:
                continue
            # small branching factor is enough for this puzzle
            for pi, top, left, pts, v in moves[:8]:
                # apply
                for r, c in pts:
                    out_grid[r, c] = int(pieces[pi]["color"])
                old_head = ch["head"]
                ch["head"] = {"top": int(top), "left": int(left), "shape": v}
                occ2 = set(occ_set) | set(pts)
                rem2 = set(remaining)
                rem2.remove(pi)
                if search(out_grid, occ2, chains, rem2):
                    return True
                # undo
                ch["head"] = old_head
                for r, c in pts:
                    out_grid[r, c] = int(bg)
                # restore bar pixels (roots are always non-overlapping)
                for r, c in bar_occ:
                    out_grid[r, c] = bar_color
        return False

    # Try small root subsets (1..3) from top candidates.
    from itertools import combinations

    for k in range(1, min(3, len(cand_roots)) + 1):
        for roots_sel in combinations(range(len(cand_roots)), k):
            used_p = set()
            used_n = set()
            occ0 = set(bar_occ)
            out0 = np.full((H, W), int(bg), dtype=int)
            for r, c in bar_occ:
                out0[r, c] = bar_color

            chains = []
            ok = True
            for idx in roots_sel:
                root = cand_roots[idx]
                if root["pi"] in used_p or root["ni"] in used_n:
                    ok = False
                    break
                pts = pixels(root["shape"], root["top"], root["left"])
                if pts & occ0:
                    ok = False
                    break
                used_p.add(root["pi"])
                used_n.add(root["ni"])
                for r, c in pts:
                    out0[r, c] = int(pieces[root["pi"]]["color"])
                occ0 |= pts
                chains.append({"axis": root["axis"], "A": root["A"], "B": root["B"], "head": {"top": root["top"], "left": root["left"], "shape": root["shape"]}})

            if not ok:
                continue
            remaining = set(range(len(pieces))) - used_p
            search(out0, occ0, chains, remaining)

    return best_out


# ---------------------------------------------------------------------------
# Generator
# ---------------------------------------------------------------------------

def _connected(cells):
    """Check 4-connectivity of a cell set."""
    if len(cells) <= 1:
        return True
    cells_set = set(cells)
    start = next(iter(cells_set))
    visited = {start}
    stack = [start]
    while stack:
        r, c = stack.pop()
        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            nb = (r + dr, c + dc)
            if nb in cells_set and nb not in visited:
                visited.add(nb)
                stack.append(nb)
    return len(visited) == len(cells_set)


def _grow_connected(rng, available, target, seeds, must_span_axis=None, span_range=None, retries=3):
    """Grow a 4-connected shape of exactly *target* cells within *available*, starting from *seeds*.

    *must_span_axis* ("cols"/"rows") + *span_range* (A, B) enforce that the
    resulting shape spans from A to B along that axis.
    """
    _D4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
    for _ in range(retries):
        cells = set(seeds)
        if not cells.issubset(available):
            return None
        for __ in range(target * 20):
            if len(cells) >= target:
                break
            frontier = [nb for r, c in cells for dr, dc in _D4
                        if (nb := (r + dr, c + dc)) in available and nb not in cells]
            if not frontier:
                break
            # Prioritise filling span gaps
            if must_span_axis and span_range:
                A, B = span_range
                if must_span_axis == "cols":
                    cm, cx = min((c for _, c in cells), default=B), max((c for _, c in cells), default=A)
                    if cm > A:
                        p = [nb for nb in frontier if nb[1] < cm]
                        if p:
                            cells.add(rng.choice(p)); continue
                    if cx < B:
                        p = [nb for nb in frontier if nb[1] > cx]
                        if p:
                            cells.add(rng.choice(p)); continue
                else:
                    cm, cx = min((r for r, _ in cells), default=B), max((r for r, _ in cells), default=A)
                    if cm > A:
                        p = [nb for nb in frontier if nb[0] < cm]
                        if p:
                            cells.add(rng.choice(p)); continue
                    if cx < B:
                        p = [nb for nb in frontier if nb[0] > cx]
                        if p:
                            cells.add(rng.choice(p)); continue
            cells.add(rng.choice(frontier))
        if len(cells) < target:
            continue
        # Trim to target while preserving seeds, span, and connectivity
        while len(cells) > target:
            removable = []
            for rc in cells:
                if rc in seeds:
                    continue
                if must_span_axis and span_range:
                    A, B = span_range
                    if must_span_axis == "cols":
                        if rc[1] == A and sum(1 for _, c2 in cells if c2 == A) <= 1:
                            continue
                        if rc[1] == B and sum(1 for _, c2 in cells if c2 == B) <= 1:
                            continue
                    else:
                        if rc[0] == A and sum(1 for r2, _ in cells if r2 == A) <= 1:
                            continue
                        if rc[0] == B and sum(1 for r2, _ in cells if r2 == B) <= 1:
                            continue
                if _connected(cells - {rc}):
                    removable.append(rc)
            if not removable:
                break
            cells.remove(rng.choice(removable))
        if len(cells) != target:
            continue
        if must_span_axis and span_range:
            A, B = span_range
            if must_span_axis == "cols":
                if min(c for _, c in cells) != A or max(c for _, c in cells) != B:
                    continue
            else:
                if min(r for r, _ in cells) != A or max(r for r, _ in cells) != B:
                    continue
        if _connected(cells):
            return cells
    return None


def _gen_attempt():
    """Build one (input, output) pair; returns (input, output) or None."""
    import random as _random
    rng = _random.Random()
    H, W = 30, 30
    bg = 0

    # ---- bar ----------------------------------------------------------
    orientation = rng.choice(["horizontal", "vertical"])
    bar_color = rng.randint(1, 9)
    thickness = rng.randint(5, 7)

    if orientation == "horizontal":
        center = int(rng.uniform(0.35, 0.53) * H)
        bar_r0 = max(0, center - thickness // 2)
        bar_r1 = bar_r0 + thickness - 1
        if bar_r1 >= H:
            bar_r1 = H - 1; bar_r0 = bar_r1 - thickness + 1
        bar_c0, bar_c1 = 0, W - 1
        space_before, space_after = bar_r0, H - 1 - bar_r1
    else:
        center = int(rng.uniform(0.35, 0.53) * W)
        bar_c0 = max(0, center - thickness // 2)
        bar_c1 = bar_c0 + thickness - 1
        if bar_c1 >= W:
            bar_c1 = W - 1; bar_c0 = bar_c1 - thickness + 1
        bar_r0, bar_r1 = 0, H - 1
        space_before, space_after = bar_c0, W - 1 - bar_c1

    bar_h, bar_w = bar_r1 - bar_r0 + 1, bar_c1 - bar_c0 + 1
    bar_cells = set((r, c) for r in range(bar_r0, bar_r1 + 1)
                    for c in range(bar_c0, bar_c1 + 1))

    # ---- plan chains --------------------------------------------------
    num_chains = rng.randint(1, 2)
    chain_lens = [3] if num_chains == 1 else [rng.randint(2, 3) for _ in range(2)]
    if num_chains == 2:
        while not (3 <= sum(chain_lens) <= 6):
            chain_lens = [rng.randint(2, 3) for _ in range(2)]

    avail_colors = [c for c in range(1, 10) if c != bar_color]
    rng.shuffle(avail_colors)
    color_idx = 0

    all_chain_pieces = []
    notch_holes: list[set] = []
    occ_set = set(bar_cells)

    for chain_idx in range(num_chains):
        chain_len = chain_lens[chain_idx]
        strip_width = rng.randint(4, 5)

        # pick side with enough room
        if orientation == "horizontal":
            sides = ["top", "bottom"]; rng.shuffle(sides)
            side = next((s for s in sides
                         if (space_before if s == "top" else space_after) >= chain_len * 2 + 3), None)
            if side is None:
                return None
            sc0 = rng.randint(1, W - strip_width - 1); sc1 = sc0 + strip_width - 1
            sA, sB = sc0, sc1
        else:
            sides = ["left", "right"]; rng.shuffle(sides)
            side = next((s for s in sides
                         if (space_before if s == "left" else space_after) >= chain_len * 2 + 3), None)
            if side is None:
                return None
            sr0 = rng.randint(1, H - strip_width - 1); sr1 = sr0 + strip_width - 1
            sA, sB = sr0, sr1

        # ---- notch (hole carved in bar) ----
        notch_depth = rng.randint(1, 2)
        notch_area = rng.randint(1, min(4, notch_depth * strip_width))

        if orientation == "horizontal":
            nr0 = bar_r0 if side == "top" else bar_r1 - notch_depth + 1
            nr1 = bar_r0 + notch_depth - 1 if side == "top" else bar_r1
            n_avail = {(r, c) for r in range(nr0, nr1 + 1)
                       for c in range(sc0, sc1 + 1) if (r, c) in bar_cells}
        else:
            nc0 = bar_c0 if side == "left" else bar_c1 - notch_depth + 1
            nc1 = bar_c0 + notch_depth - 1 if side == "left" else bar_c1
            n_avail = {(r, c) for r in range(sA, sB + 1)
                       for c in range(nc0, nc1 + 1) if (r, c) in bar_cells}

        # keep away from existing notch holes
        all_holes = set().union(*notch_holes) if notch_holes else set()
        n_avail -= all_holes | {(r + dr, c + dc)
                                for r, c in all_holes for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]}
        if len(n_avail) < notch_area:
            return None

        notch = _grow_connected(rng, n_avail, notch_area, {rng.choice(list(n_avail))})
        if notch is None:
            return None
        bar_cells -= notch
        notch_holes.append(notch)

        # ---- chain pieces ----
        chain_pieces = []
        for piece_idx in range(chain_len):
            if color_idx >= len(avail_colors):
                return None
            piece_color = avail_colors[color_idx]; color_idx += 1
            piece_area = rng.randint(8, 13)
            chain_dim = rng.randint(2, 3)

            if piece_idx == 0:
                # ROOT: fill notch + extend outside bar
                if orientation == "horizontal":
                    if side == "top":
                        pr0, pr1 = max(0, bar_r0 - chain_dim), max(r for r, _ in notch)
                    else:
                        pr0, pr1 = min(r for r, _ in notch), min(H - 1, bar_r1 + chain_dim)
                    pc0, pc1 = sc0, sc1
                else:
                    if side == "left":
                        pc0, pc1 = max(0, bar_c0 - chain_dim), max(c for _, c in notch)
                    else:
                        pc0, pc1 = min(c for _, c in notch), min(W - 1, bar_c1 + chain_dim)
                    pr0, pr1 = sA, sB

                bbox_area = (pr1 - pr0 + 1) * (pc1 - pc0 + 1)
                target = max(max(8, int(bbox_area * 0.54)),
                             min(piece_area, int(bbox_area * 0.80)))
                if target > bbox_area or target < 8:
                    return None

                avail = {(r, c) for r in range(pr0, pr1 + 1) for c in range(pc0, pc1 + 1)
                         if (r, c) in notch or (r, c) not in occ_set}
                root = _grow_connected(rng, avail, target, notch,
                                       must_span_axis="cols" if orientation == "horizontal" else "rows",
                                       span_range=(sA, sB), retries=5)
                if root is None:
                    return None
                if not any(not (bar_r0 <= r <= bar_r1 and bar_c0 <= c <= bar_c1) for r, c in root):
                    return None
                piece_cells = root
            else:
                # CONTINUATION: fill cavity in prev bbox + extend further from bar
                prev_coords = chain_pieces[-1]["coords"]
                prs = [r for r, _ in prev_coords]; pcs = [c for _, c in prev_coords]
                prev_r0, prev_r1 = min(prs), max(prs)
                prev_c0, prev_c1 = min(pcs), max(pcs)

                if orientation == "horizontal":
                    cavity = {(r, c) for r in range(prev_r0, prev_r1 + 1)
                              for c in range(sc0, sc1 + 1)
                              if (r, c) not in occ_set and (r, c) not in prev_coords}
                else:
                    cavity = {(r, c) for r in range(sA, sB + 1)
                              for c in range(prev_c0, prev_c1 + 1)
                              if (r, c) not in occ_set and (r, c) not in prev_coords}
                if not cavity:
                    return None

                if orientation == "horizontal":
                    es = (max(0, prev_r0 - chain_dim), prev_r0 - 1) if side == "top" \
                        else (prev_r1 + 1, min(H - 1, prev_r1 + chain_dim))
                    ext = {(r, c) for r in range(es[0], es[1] + 1)
                           for c in range(sc0, sc1 + 1)
                           if (r, c) not in occ_set} if es[0] <= es[1] else set()
                else:
                    es = (max(0, prev_c0 - chain_dim), prev_c0 - 1) if side == "left" \
                        else (prev_c1 + 1, min(W - 1, prev_c1 + chain_dim))
                    ext = {(r, c) for r in range(sA, sB + 1)
                           for c in range(es[0], es[1] + 1)
                           if (r, c) not in occ_set} if es[0] <= es[1] else set()

                all_avail = cavity | ext
                target = min(13, max(len(cavity), min(piece_area, len(all_avail))))
                if len(cavity) > 13 or target < 8:
                    return None

                # Tail piece must leave zero cavity in its bbox within strip
                is_tail = (piece_idx == chain_len - 1)
                if is_tail:
                    target = min(13, len(all_avail))

                piece_cells = _grow_connected(rng, all_avail, target, cavity,
                                              must_span_axis="cols" if orientation == "horizontal" else "rows",
                                              span_range=(sA, sB), retries=5)
                if piece_cells is None or not cavity.issubset(piece_cells):
                    return None

                if is_tail:
                    prs2 = [r for r, _ in piece_cells]; pcs2 = [c for _, c in piece_cells]
                    t_r0, t_r1 = min(prs2), max(prs2)
                    t_c0, t_c1 = min(pcs2), max(pcs2)
                    if orientation == "horizontal":
                        remaining = {(r, c) for r in range(t_r0, t_r1 + 1) for c in range(sc0, sc1 + 1)
                                     if (r, c) not in occ_set and (r, c) not in piece_cells}
                    else:
                        remaining = {(r, c) for r in range(sA, sB + 1) for c in range(t_c0, t_c1 + 1)
                                     if (r, c) not in occ_set and (r, c) not in piece_cells}
                    if remaining:
                        return None

            if not (8 <= len(piece_cells) <= 13):
                return None
            chain_pieces.append({"color": piece_color, "coords": piece_cells})
            occ_set |= piece_cells

        if len(chain_pieces) < chain_len:
            return None
        all_chain_pieces.extend(chain_pieces)

    if not (3 <= len(all_chain_pieces) <= 6):
        return None

    # ---- decoy notches (4-7) ------------------------------------------
    num_decoys = rng.randint(4, 7)
    decoys = 0
    for _ in range(500):
        if decoys >= num_decoys:
            break
        depth = rng.randint(1, 2)
        area = rng.randint(1, min(6, depth * 5))
        if orientation == "horizontal":
            ds = rng.choice(["top", "bottom"])
            dr0 = bar_r0 if ds == "top" else bar_r1 - depth + 1
            dr1 = bar_r0 + depth - 1 if ds == "top" else bar_r1
            dc0 = rng.randint(bar_c0, bar_c1)
            dc1 = min(bar_c1, dc0 + rng.randint(0, 4))
        else:
            ds = rng.choice(["left", "right"])
            dc0 = bar_c0 if ds == "left" else bar_c1 - depth + 1
            dc1 = bar_c0 + depth - 1 if ds == "left" else bar_c1
            dr0 = rng.randint(bar_r0, bar_r1)
            dr1 = min(bar_r1, dr0 + rng.randint(0, 4))

        d_avail = {(r, c) for r in range(dr0, dr1 + 1) for c in range(dc0, dc1 + 1)
                   if (r, c) in bar_cells}
        all_h = set().union(*notch_holes) if notch_holes else set()
        d_avail -= all_h | {(r + dr, c + dc) for r, c in all_h for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]}
        if len(d_avail) < 1:
            continue
        area = min(area, len(d_avail))
        dn = _grow_connected(rng, d_avail, area, {rng.choice(list(d_avail))})
        if dn is None:
            continue
        if not _connected(bar_cells - dn):
            continue
        bar_cells -= dn
        notch_holes.append(dn)
        decoys += 1
    if decoys < 4:
        return None

    # verify no internal holes in bar bbox
    bar_mask = np.zeros((bar_h, bar_w), dtype=bool)
    for r, c in bar_cells:
        bar_mask[r - bar_r0, c - bar_c0] = True
    for pts in components_mask(~bar_mask, connectivity=4):
        rr, cc = pts[:, 0], pts[:, 1]
        if not ((rr == 0).any() or (rr == bar_h - 1).any()
                or (cc == 0).any() or (cc == bar_w - 1).any()):
            return None

    # ---- assemble output ----------------------------------------------
    output = np.full((H, W), bg, dtype=int)
    for r, c in bar_cells:
        output[r, c] = bar_color
    for p in all_chain_pieces:
        for r, c in p["coords"]:
            output[r, c] = p["color"]

    # ---- scatter pieces for input -------------------------------------
    input_grid = np.full((H, W), bg, dtype=int)
    for r, c in bar_cells:
        input_grid[r, c] = bar_color

    placed_occ = set(bar_cells)
    pieces_order = list(all_chain_pieces)
    rng.shuffle(pieces_order)

    for p in pieces_order:
        coords = p["coords"]; color = p["color"]
        rs = [r for r, _ in coords]; cs = [c for _, c in coords]
        p_r0, p_c0 = min(rs), min(cs)
        rel = [(r - p_r0, c - p_c0) for r, c in coords]
        p_h, p_w = max(rs) - p_r0 + 1, max(cs) - p_c0 + 1

        placed = False
        for _ in range(500):
            gap = rng.randint(2, 7)
            if orientation == "horizontal":
                top = (bar_r0 - gap - p_h) if rng.random() < 0.5 else (bar_r1 + gap + 1)
                left = rng.randint(0, max(0, W - p_w))
            else:
                left = (bar_c0 - gap - p_w) if rng.random() < 0.5 else (bar_c1 + gap + 1)
                top = rng.randint(0, max(0, H - p_h))
            if top < 0 or top + p_h > H or left < 0 or left + p_w > W:
                continue
            pts = {(top + dr, left + dc) for dr, dc in rel}
            if pts & placed_occ:
                continue
            if any((r + dr, c + dc) in placed_occ
                   for r, c in pts for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]):
                continue
            for r, c in pts:
                input_grid[r, c] = color
            placed_occ |= pts
            placed = True
            break
        if not placed:
            return None

    return input_grid, output


def generate_input():
    """Generate a valid input grid for task 16b78196 (max 300 retries)."""
    for _ in range(300):
        result = _gen_attempt()
        if result is None:
            continue
        inp, out = result
        if np.array_equal(main(inp), out):
            return inp
    raise RuntimeError("generate_input: failed after 300 attempts")

    sizes = sorted(len(part["coords"]) for part in parts)
    if sizes[-1] == 1:
        return _straight_singleton_diagonal(coords, n4)

    border_sides = [part["sides"] for part in parts if part["sides"]]
    if border_sides:
        all_border_sides = set().union(*border_sides)
        if len(all_border_sides) == 1 and len(border_sides) == n4:
            return False

    if n4 == 2 and sizes[0] == 1 and sizes[1] >= 5:
        return all(part["sides"] for part in parts)

    return True


def main(grid: np.ndarray) -> np.ndarray:
    """Recolor the grey diagonal-chain regions in an orange field to teal.

    Input structure
    The input contains only grey pixels and orange pixels.  Grey pixels form
    several 8-connected regions embedded in the orange field.

    Rule
    Decompose each grey 8-connected region into 4-connected lobes.  Recolor the
    whole region teal only when it contains a straight diagonal run of at least
    three pixels and those lobes meet only by diagonal corner contacts in a
    non-branching diagonal chain or cycle; a single 4-connected region is
    recolored only when it is a square diagonal staircase.

    Key insight
    The teal regions are not selected by size or position; they are the grey
    regions whose internal connectivity depends on diagonal corner joins, while
    same-edge cracks, rectangles, bars, and branching/noisy regions remain grey.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    assert set(np.unique(g)) == {Color.GREY, Color.ORANGE}

    out = g.copy()
    lab8, n8 = label_mask(g == Color.GREY, connectivity=8)
    assert n8 >= 1

    for k in range(1, n8 + 1):
        mask = lab8 == k
        if _is_target_region(mask):
            out[mask] = Color.TEAL

    return out

# --------------- generator (c) ---------------

# Grid dimensions.
GRID_ROWS_RANGE, GRID_COLS_RANGE = (4, 16), (5, 19)

# Region counts.
TARGET_COUNT_RANGE, DISTRACTOR_COUNT_RANGE = (1, 4), (3, 15)

# Target shape sizes and branch probabilities.
TARGET_STAIRCASE_PROB = 0.5
STAIRCASE_NW_SE_PROB = 0.5
STAIRCASE_MIN_SIZE, STAIRCASE_MAX_SIZE = 4, 6
CHAIN_LOBES_RANGE, LOBE_SIZE_RANGE = (2, 4), (1, 4)
MIN_DIAGONAL_RUN = 3

# Distractor shape choices.
DISTRACTOR_KINDS = ("pixel", "small_blob", "bar", "rect", "L")
DISTRACTOR_WEIGHTS = (3, 4, 2, 2, 1)
BAR_VERTICAL_PROB = 0.5
SMALL_BLOB_SIZE_RANGE, BAR_LENGTH_RANGE = (2, 5), (2, 4)
RECT_SIZE_RANGE, L_SIZE_RANGE = (2, 3), (2, 3)

# Retry and acceptance thresholds.
DISTRACTOR_RETRY_LIMIT, TARGET_RETRY_LIMIT, GEN_ATTEMPT_LIMIT = 50, 80, 300
MIN_GREY_DENSITY, MAX_GREY_DENSITY = 0.15, 0.50

CARDINAL_STEPS = ((-1, 0), (1, 0), (0, -1), (0, 1))
STRUCT8 = ndimage.generate_binary_structure(2, 2)


def _gen_max_straight_diagonal_run(pts: set[tuple[int, int]]) -> int:
    best = 0
    for dr, dc in ((1, 1), (1, -1)):
        for r, c in pts:
            if (r - dr, c - dc) in pts:
                continue
            length = 0
            while (r, c) in pts:
                length += 1
                r += dr
                c += dc
            best = max(best, length)
    return best


def _gen_mask_points(mask: np.ndarray) -> set[tuple[int, int]]:
    return {tuple(map(int, p)) for p in np.argwhere(mask)}


def _make_staircase(n: int) -> set[tuple[int, int]]:
    """Diagonal staircase path in NxN bbox spanning opposite corners."""
    if random.random() < STAIRCASE_NW_SE_PROB:
        path, r, c = [(0, 0)], 0, 0
        while r < n - 1 or c < n - 1:
            if r == n - 1: c += 1
            elif c == n - 1: r += 1
            elif random.random() < 0.5: r += 1
            else: c += 1
            path.append((r, c))
    else:
        path, r, c = [(0, n - 1)], 0, n - 1
        while r < n - 1 or c > 0:
            if r == n - 1: c -= 1
            elif c == 0: r += 1
            elif random.random() < 0.5: r += 1
            else: c -= 1
            path.append((r, c))
    return set(path)


def _grow_blob(size: int, seed: tuple[int, int], forbidden: set) -> set[tuple[int, int]]:
    blob = {seed}
    for _ in range(size - 1):
        frontier = [(r + dr, c + dc)
                     for r, c in blob for dr, dc in CARDINAL_STEPS
                     if (r + dr, c + dc) not in blob and (r + dr, c + dc) not in forbidden]
        if not frontier:
            break
        blob.add(random.choice(frontier))
    return blob


def _grow_blob_constrained(seed: tuple[int, int], size: int, all_pts: set,
                           existing_lobes: list[set]) -> set[tuple[int, int]]:
    blob = {seed}
    for _ in range(size - 1):
        frontier = []
        for r, c in blob:
            for dr, dc in CARDINAL_STEPS:
                nr, nc = r + dr, c + dc
                if (nr, nc) in blob or (nr, nc) in all_pts:
                    continue
                if any((nr + ddr, nc + ddc) in lobe
                       for lobe in existing_lobes for ddr, ddc in CARDINAL_STEPS):
                    continue
                frontier.append((nr, nc))
        if not frontier:
            break
        blob.add(random.choice(frontier))
    return blob


def _candidate_diagonal_contacts(prev_lobe: set[tuple[int, int]], dr: int, dc: int,
                                 all_pts: set[tuple[int, int]]) -> list[tuple[int, int]]:
    return [(r + dr, c + dc) for r, c in prev_lobe
            if (r + dr, c + dc) not in all_pts
            and not any((r + dr + ddr, c + dc + ddc) in prev_lobe
                        for ddr, ddc in CARDINAL_STEPS)]


def _diagonal_dirs_between(a: set[tuple[int, int]], b: set[tuple[int, int]]) -> set[tuple[int, int]]:
    return {(dr, dc) for r, c in a for dr, dc in DIAGONAL_STEPS
            if (r + dr, c + dc) in b}


def _try_append_chain_lobe(lobes: list[set[tuple[int, int]]],
                           all_pts: set[tuple[int, int]]) -> set[tuple[int, int]] | None:
    prev_lobe = lobes[-1]
    diag_dirs = list(DIAGONAL_STEPS)
    random.shuffle(diag_dirs)

    for dr, dc in diag_dirs:
        candidates = _candidate_diagonal_contacts(prev_lobe, dr, dc, all_pts)
        if not candidates:
            continue

        lobe = _grow_blob_constrained(random.choice(candidates),
                                      random.randint(*LOBE_SIZE_RANGE), all_pts, lobes)
        if len(_diagonal_dirs_between(lobe, prev_lobe)) != 1:
            continue
        if any(_diagonal_dirs_between(lobe, other) for other in lobes[:-1]):
            continue
        return lobe
    return None


def _make_chain_region(num_lobes: int) -> list[set[tuple[int, int]]]:
    """Multi-lobe chain connected by single diagonal contacts. Returns [] on failure."""
    lobes: list[set[tuple[int, int]]] = []
    all_pts: set[tuple[int, int]] = set()

    for i in range(num_lobes):
        if i == 0:
            lobe = _grow_blob(random.randint(*LOBE_SIZE_RANGE), (0, 0), set())
            lobes.append(lobe)
            all_pts |= lobe
            continue

        lobe = _try_append_chain_lobe(lobes, all_pts)
        if lobe is None:
            return []
        lobes.append(lobe)
        all_pts |= lobe
    return lobes


def _make_distractor_raw() -> set[tuple[int, int]]:
    """Make a small 4-connected distractor region (non-staircase, non-valid-chain)."""
    kind = random.choices(DISTRACTOR_KINDS, weights=DISTRACTOR_WEIGHTS, k=1)[0]
    if kind == "pixel":
        return {(0, 0)}
    elif kind == "small_blob":
        return _grow_blob(random.randint(*SMALL_BLOB_SIZE_RANGE), (0, 0), set())
    elif kind == "bar":
        length = random.randint(*BAR_LENGTH_RANGE)
        return ({(r, 0) for r in range(length)} if random.random() < BAR_VERTICAL_PROB
                else {(0, c) for c in range(length)})
    elif kind == "rect":
        h, w = random.randint(*RECT_SIZE_RANGE), random.randint(*RECT_SIZE_RANGE)
        return {(r, c) for r in range(h) for c in range(w)}
    else:  # L
        h, w = random.randint(*L_SIZE_RANGE), random.randint(*L_SIZE_RANGE)
        return {(r, 0) for r in range(h)} | {(h - 1, c) for c in range(w)}


def _make_distractor() -> set[tuple[int, int]]:
    """Distractors in eval never contain a straight diagonal run of length 3+."""
    for _ in range(DISTRACTOR_RETRY_LIMIT):
        pts = _make_distractor_raw()
        if _gen_max_straight_diagonal_run(pts) < MIN_DIAGONAL_RUN:
            return pts
    return {(0, 0), (0, 1), (1, 0), (1, 1)}


def _make_target_region(H: int, W: int) -> set[tuple[int, int]] | None:
    for _ in range(TARGET_RETRY_LIMIT):
        if random.random() < TARGET_STAIRCASE_PROB:
            max_n = min(STAIRCASE_MAX_SIZE, H, W)
            if max_n < STAIRCASE_MIN_SIZE:
                continue
            pts = _make_staircase(random.randint(STAIRCASE_MIN_SIZE, max_n))
        else:
            lobes = _make_chain_region(random.randint(*CHAIN_LOBES_RANGE))
            if not lobes:
                continue
            pts = set().union(*lobes)
        if _gen_max_straight_diagonal_run(pts) >= MIN_DIAGONAL_RUN:
            return pts
    return None


def _normalize_points(pts: set[tuple[int, int]]) -> tuple[list[tuple[int, int]], int, int]:
    rs = [r for r, c in pts]
    cs = [c for r, c in pts]
    min_r, max_r, min_c, max_c = min(rs), max(rs), min(cs), max(cs)
    ph, pw = max_r - min_r + 1, max_c - min_c + 1
    return [(r - min_r, c - min_c) for r, c in pts], ph, pw


def _place_region(grid: np.ndarray, pts: set[tuple[int, int]]) -> bool:
    """Place region at random valid offset with 8-separation from existing grey."""
    H, W = grid.shape
    norm_pts, ph, pw = _normalize_points(pts)
    if ph > H or pw > W:
        return False

    occ = ndimage.binary_dilation(grid != Color.ORANGE, structure=STRUCT8, iterations=1)
    valid = []
    for r0 in range(H - ph + 1):
        for c0 in range(W - pw + 1):
            if all(not occ[r0 + dr, c0 + dc] for dr, dc in norm_pts):
                valid.append((r0, c0))
    if not valid:
        return False

    r0, c0 = random.choice(valid)
    for dr, dc in norm_pts:
        grid[r0 + dr, c0 + dc] = Color.GREY
    return True


def _place_target_regions(grid: np.ndarray, H: int, W: int, num_targets: int) -> int:
    targets_placed = 0
    for _ in range(num_targets):
        pts = _make_target_region(H, W)
        if pts is None:
            continue
        if _place_region(grid, pts):
            targets_placed += 1
    return targets_placed


def _density_ok(grid: np.ndarray) -> bool:
    H, W = grid.shape
    density = np.sum(grid == Color.GREY) / (H * W)
    return MIN_GREY_DENSITY <= density <= MAX_GREY_DENSITY


def _oracle_accepts(grid: np.ndarray) -> bool:
    try:
        out = main(grid)
    except Exception:
        return False

    if np.array_equal(out, grid) or Color.GREY not in out:
        return False

    lab8, n8 = ndimage.label(grid == Color.GREY, structure=STRUCT8)
    for k in range(1, n8 + 1):
        mask = lab8 == k
        diag_run = _gen_max_straight_diagonal_run(_gen_mask_points(mask))
        if np.all(out[mask] == Color.TEAL):
            if diag_run < MIN_DIAGONAL_RUN:
                return False
        elif diag_run >= MIN_DIAGONAL_RUN:
            return False

    return True


def _gen_attempt() -> np.ndarray | None:
    H = random.randint(*GRID_ROWS_RANGE)
    W = random.randint(*GRID_COLS_RANGE)
    grid = np.full((H, W), Color.ORANGE, dtype=int)

    num_targets = random.randint(*TARGET_COUNT_RANGE)
    num_distractors = random.randint(*DISTRACTOR_COUNT_RANGE)

    if _place_target_regions(grid, H, W, num_targets) == 0:
        return None
    for _ in range(num_distractors):
        _place_region(grid, _make_distractor())

    if not _density_ok(grid):
        return None
    if not _oracle_accepts(grid):
        return None

    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_ATTEMPT_LIMIT):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate input after {GEN_ATTEMPT_LIMIT} attempts")

codex
实现方式已经定下来：

1. `main()` 直接按题意解析第一行和第一列，把它们当作列源和行源，对内部做投射与交叉混色；不依赖固定尺寸或固定颜色布局。
2. `generate_input()` 用固定可见语义颜色池 `red/blue/green/azure/orange` 随机划分到上边和左边，两边颜色保持不重合，并且每次先强制一个“目标混色分支”出现：
   - `red+blue -> magenta`
   - `red+green -> yellow`
   - `blue+green -> azure`
   - `red+azure -> maroon`
   - 以及一个 `other -> grey`
3. 生成器再随机补充额外颜色、尺寸、色条数量和位置，保证：
   - 至少有一个未被选中的内部行和内部列，因而长期会出现“仅水平线”和“仅垂直线”分支
   - 两边颜色集合不相交
   - 内部输入始终全背景
   - 生成后用求解器自检，失败就重采样

