+def _mark_box(occupied: np.ndarray, box: tuple[int, int, int, int]) -> None:
+    r0, c0, r1, c1 = box
+    occupied[r0 : r1 + 1, c0 : c1 + 1] = True
+
+
+def _draw_container(grid: np.ndarray, spec: dict) -> None:
+    r0 = spec["r0"]
+    c0 = spec["c0"]
+    side = spec["side_len"]
+    border = spec["border_color"]
+    marker = spec["marker_color"]
