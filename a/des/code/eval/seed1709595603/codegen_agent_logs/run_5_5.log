+                "side_len": side_len,
+                "side": directions[i],
+                "marker_start": start,
+                "marker_count": marker_count,
+                "border_color": border_colors[i],
+                "marker_color": marker_color,
+                "pattern": pattern,
+            }
+        )
+        if directions[i] != "top" or marker_count % 2 == 1:
+            non_identity = True
+    if not non_identity:
+        return None
+    return specs
