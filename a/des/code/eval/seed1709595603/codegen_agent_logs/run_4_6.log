+
+def _box_with_pad(
+    r0: int,
+    c0: int,
+    r1: int,
+    c1: int,
+    h: int,
+    w: int,
+    pad: int = 1,
+) -> tuple[int, int, int, int]:
+    return (
+        max(0, r0 - pad),
+        max(0, c0 - pad),
+        min(h - 1, r1 + pad),
+        min(w - 1, c1 + pad),
+    )
