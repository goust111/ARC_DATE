+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r0 in range(h):
+        for c0 in range(w):
+            if not mask[r0, c0] or seen[r0, c0]:
+                continue
+            stack = [(r0, c0)]
+            seen[r0, c0] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                comp.append((r, c))
+                for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _legend_bbox(grid: np.ndarray) -> tuple[int, int, int, int]:
+    candidates: list[tuple[int, int, int, int]] = []
+    for comp in _components(grid == MAROON):
+        r0, c0, r1, c1 = _bbox(comp)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 5 or w < 7:
+            continue
+        if len(comp) != 2 * (h + w) - 4:
+            continue
+        if not np.all(grid[r0, c0 : c1 + 1] == MAROON):
+            continue
+        if not np.all(grid[r1, c0 : c1 + 1] == MAROON):
+            continue
+        if not np.all(grid[r0 : r1 + 1, c0] == MAROON):
+            continue
+        if not np.all(grid[r0 : r1 + 1, c1] == MAROON):
+            continue
+        if np.any(grid[r0 + 1 : r1, c0 + 1 : c1] == MAROON):
+            continue
+        candidates.append((r0, c0, r1, c1))
