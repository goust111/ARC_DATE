+    r0, c0 = top, 0
+    r1, c1 = r0 + frame_h - 1, LEGEND_W - 1
+    grid[r0 : r1 + 1, c0] = MAROON
+    grid[r0 : r1 + 1, c1] = MAROON
+    grid[r0, c0 : c1 + 1] = MAROON
