+def _ray_trace(
+    grid: np.ndarray,
+    legend: np.ndarray,
+    origin: tuple[int, int],
+    dirs: tuple[tuple[int, int], ...],
+) -> tuple[list[tuple[int, int]], list[str]] | None:
+    h, w = grid.shape
+    all_cells: list[tuple[int, int]] = []
+    endings: list[str] = []
+    for dr, dc in dirs:
+        r, c = origin
+        ray_cells: list[tuple[int, int]] = []
+        while True:
