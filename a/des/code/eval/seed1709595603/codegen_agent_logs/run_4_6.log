+
+def _paint_obstacles(grid: np.ndarray, obstacles: list[tuple[int, int, int, int]]) -> None:
+    for r0, c0, r1, c1 in obstacles:
+        grid[r0 : r1 + 1, c0 : c1 + 1] = GREY
