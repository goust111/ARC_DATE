+    pr0, pc0, pr1, pc1 = _box_with_pad(lr0, lc0, lr1, lc1, h, w, pad=1)
+    occupied[pr0 : pr1 + 1, pc0 : pc1 + 1] = True
+
+    obstacles: list[tuple[int, int, int, int]] = []
+    target = random.randint(*OBSTACLE_COUNT_RANGE)
+    min_col = lc1 + 3
+    if min_col >= w - 2:
+        return []
