+def _isolated_background_cell(grid: np.ndarray, r: int, c: int) -> bool:
+    if grid[r, c] != BLACK:
+        return False
+    h, w = grid.shape
+    for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+        if 0 <= nr < h and 0 <= nc < w and grid[nr, nc] != BLACK:
