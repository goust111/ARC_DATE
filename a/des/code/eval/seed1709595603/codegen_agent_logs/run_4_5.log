+def _ring_distances(height: int, width: int) -> np.ndarray:
+    rows = np.arange(height)[:, None]
+    cols = np.arange(width)[None, :]
+    return np.minimum(np.minimum(rows, height - 1 - rows), np.minimum(cols, width - 1 - cols))
