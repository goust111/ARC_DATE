+        left = int(group["left"])
+        height = int(group["height"])
+        width = int(group["width"])
+        dist = _ring_distances(height, width)
+        sub = out[top : top + height, left : left + width]
+        for gap_index, color in enumerate(group["gaps"], start=1):
+            if gap_index % 2 == 1:
