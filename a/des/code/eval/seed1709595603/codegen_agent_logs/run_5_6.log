from __future__ import annotations

import random
from collections import deque

import numpy as np


BG = 0
SIDES = ("top", "right", "bottom", "left")
SIDE_TO_ROT_K = {
    "top": 0,
    "right": 3,
    "bottom": 2,
    "left": 1,
}
