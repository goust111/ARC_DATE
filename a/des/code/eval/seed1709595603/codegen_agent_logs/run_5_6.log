+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    max_depth = rng.randint(1, MAX_DEPTH)
+    min_dim = 9 + 4 * max_depth
+    h = rng.randint(min_dim, 32)
+    w = rng.randint(min_dim, 32)
