+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PALETTE_COLORS = tuple(color for color in range(10) if color not in (BLACK, GREY))
+
+LEAF_MIN_SPAN = 5
+MAX_DEPTH = 4
+TOP_LEVEL_MARGIN = 2
+OUTER_SIZE_EXTRA = 6
+CLEARANCE = 1
+GEN_RETRIES = 400
+PLACEMENT_RETRIES = 120
