+    chain_specs: list[dict[str, object]] = []
+    for depth in chain_depths:
+        sizes = _choose_chain_sizes(depth, h, w, rng)
+        if sizes is None:
+            return None
+        outer_h, outer_w = sizes[0]
+        chain_specs.append(
+            {
+                "depth": depth,
+                "sizes": sizes,
+                "outer_h": outer_h,
+                "outer_w": outer_w,
+                "area": outer_h * outer_w,
+            }
+        )
