+def _strip_info(grid: np.ndarray) -> tuple[list[tuple[int, int]], list[int]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    coords = np.argwhere((g != BLACK) & (g != GREY))
+    assert coords.shape[0] > 0, "expected a non-empty edge palette"
+    assert np.all(
+        (coords[:, 0] == 0)
+        | (coords[:, 0] == h - 1)
+        | (coords[:, 1] == 0)
+        | (coords[:, 1] == w - 1)
