+    for _ in range(120):
+        base = int(np.ceil(np.sqrt(total_area * 2.1)))
+        low_h = max(24, max_h + 2, base - 2)
+        low_w = max(24, max_w + 2, base - 2)
+        high_h = max(low_h, min(40, low_h + 8))
+        high_w = max(low_w, min(40, low_w + 8))
+        if low_h > high_h or low_w > high_w:
