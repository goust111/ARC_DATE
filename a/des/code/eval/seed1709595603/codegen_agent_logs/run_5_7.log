+            notch_coords = [(int(r), int(c)) for r, c in np.argwhere(info["notch_mask"])]
+            notch_shape = _tight_mask_from_coords(notch_coords)
+            frames.append(
+                {
+                    "bbox": (r0, c0, r1, c1),
+                    "border_mask": info["border_mask"],
+                    "shape_key": _canonical_rot(notch_shape),
