+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME_COLOR = 5
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDES = ["top", "bottom", "left", "right"]
+KEY_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
