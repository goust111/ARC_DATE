+        if side in ("top", "bottom"):
+            c0_lo = thickness
+            c0_hi = outer_w - thickness - nw
+            if c0_lo > c0_hi:
+                continue
+            c0 = random.randint(c0_lo, c0_hi)
+            if side == "top":
+                sub = patch[:nh, c0 : c0 + nw]
+            else:
+                sub = patch[outer_h - nh :, c0 : c0 + nw]
+            sub[notch] = BG
+        else:
