+    for frame in frames:
+        color = keys[frame["shape_key"]]
+        r0, c0, r1, c1 = frame["bbox"]
+        sub = out[r0 : r1 + 1, c0 : c1 + 1]
+        sub[frame["border_mask"]] = color
+        sub[~frame["border_mask"]] = BG
