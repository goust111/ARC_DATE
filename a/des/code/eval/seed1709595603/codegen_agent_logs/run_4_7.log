+def _distinct_shadow_subsets(mask: np.ndarray, counts: list[int]) -> list[np.ndarray] | None:
+    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    seen: set[tuple[tuple[int, int], ...]] = set()
