+
+    row_key_cells = [
+        (mid_r, c) for c in range(c0, c1 + 1) if int(inp[mid_r, c]) == MAROON
+    ]
+    col_key_cells = [
+        (r, mid_c) for r in range(r0, r1 + 1) if int(inp[r, mid_c]) == MAROON
+    ]
+    assert bool(row_key_cells) ^ bool(col_key_cells), "expected exactly one key per quadrant"
