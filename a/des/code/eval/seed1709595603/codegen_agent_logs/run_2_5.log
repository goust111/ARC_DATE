+            "r0": mid_r + 1,
+            "r1": h - 1,
+            "c0": 0,
+            "c1": mid_c - 1,
+            "row_step": 1,
+            "col_step": -1,
+        },
+        {
+            "name": "br",
+            "r0": mid_r + 1,
+            "r1": h - 1,
+            "c0": mid_c + 1,
+            "c1": w - 1,
+            "row_step": 1,
+            "col_step": 1,
+        },
