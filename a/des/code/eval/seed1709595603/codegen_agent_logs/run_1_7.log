        patch = g[r0 : r1 + 1, c0 : c1 + 1]
        expected = np.full((3, 3), color, dtype=int)
        expected[1, 1] = bg
        assert np.array_equal(patch, expected), patch
        objects.append((r0, c0, color))

    assert objects
