+def _sample_gap(segment: list[Cell], rng: random.Random, anchor: Cell | None = None) -> set[Cell]:
+    interior_count = len(segment) - 2
+    assert interior_count >= 1, "segment must leave grey cells on both sides"
+    max_len = min(4, interior_count)
