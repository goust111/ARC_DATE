+def _make_vertical_vertices(h: int, slab_left: int, slab_right: int, rng: random.Random) -> list[Cell]:
+    cols = list(range(slab_left, slab_right + 1))
+    variant = rng.choice(["straight", "dogleg", "s"])
+
+    if variant == "straight":
+        c0 = rng.choice(cols)
+        return [(1, c0), (h - 2, c0)]
+
+    if variant == "dogleg":
+        c0, c1 = rng.sample(cols, 2)
