+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+GREY = 5
+MARKER_COLORS = (1, 2, 3, 6, 7, 8, 9)
+GEN_ATTEMPTS = 300
+
+Cell = tuple[int, int]
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
