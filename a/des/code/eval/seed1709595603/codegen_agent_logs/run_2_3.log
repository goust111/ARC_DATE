+    if anchor is None:
+        gap_len = rng.randint(1, max_len)
+        start = rng.randint(1, len(segment) - 1 - gap_len)
+    else:
+        anchor_idx = segment.index(anchor)
+        assert 1 <= anchor_idx <= len(segment) - 2, "anchor must stay inside the segment"
+        gap_len = rng.randint(1, max_len)
+        lo = max(1, anchor_idx - gap_len + 1)
+        hi = min(anchor_idx, len(segment) - 1 - gap_len)
+        start = rng.randint(lo, hi)
