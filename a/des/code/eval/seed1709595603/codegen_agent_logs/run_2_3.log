+        return (0, c)
+    if side == "bottom":
+        assert r == h - 2
+        return (h - 1, c)
+    if side == "left":
+        assert c == 1
+        return (r, 0)
+    assert side == "right"
+    assert c == w - 2
+    return (r, w - 1)
