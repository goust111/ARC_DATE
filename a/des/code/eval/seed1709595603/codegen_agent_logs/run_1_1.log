+        width = random.randint(min_size, max_size)
+        grid = np.full((height, width), bg, dtype=int)
+        expected = grid.copy()
+
+        corner = random.choice(("tl", "tr", "bl", "br"))
+        legend_entries = list(legend_mapping.items())
+        random.shuffle(legend_entries)
