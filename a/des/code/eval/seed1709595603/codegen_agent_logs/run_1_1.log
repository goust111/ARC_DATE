+def _frame_from_component(coords: list[tuple[int, int]], color: int) -> dict | None:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
+    side = r1 - r0 + 1
+    if side < 5 or c1 - c0 + 1 != side:
+        return None
