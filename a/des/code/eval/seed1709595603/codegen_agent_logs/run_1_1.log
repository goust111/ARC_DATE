+    boundary = set()
+    for c in range(c0, c1 + 1):
+        boundary.add((r0, c))
+        boundary.add((r1, c))
+    for r in range(r0 + 1, r1):
+        boundary.add((r, c0))
+        boundary.add((r, c1))
+
+    coord_set = set(coords)
+    if len(coord_set) != len(boundary) - 1:
+        return None
+    if not coord_set.issubset(boundary):
+        return None
+
+    missing = list(boundary - coord_set)
+    if len(missing) != 1:
+        return None
+    gap_r, gap_c = missing[0]
+    if (gap_r in (r0, r1)) and (gap_c in (c0, c1)):
+        return None
+
+    if gap_r == r0:
+        gap_side = "top"
+    elif gap_r == r1:
+        gap_side = "bottom"
+    elif gap_c == c0:
+        gap_side = "left"
+    else:
+        gap_side = "right"
