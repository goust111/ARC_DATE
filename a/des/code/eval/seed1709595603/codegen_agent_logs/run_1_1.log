+    legend_r0 = 0 if "t" in corner else height - 5
+    legend_c0 = 0 if "l" in corner else width - 7
+    _reserve(reserved, legend_r0, legend_c0, legend_r0 + 4, legend_c0 + 6, pad=2)
+
+    for _ in range(frame_count):
