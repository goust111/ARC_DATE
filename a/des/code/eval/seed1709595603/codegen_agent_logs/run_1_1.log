+    raise RuntimeError("failed to create a valid asymmetric pattern")
+
+
+def _make_pattern(interior_side: int, gap_side: str, overlap_count: int) -> np.ndarray:
+    mask = _make_vertical_pattern(interior_side, overlap_count)
