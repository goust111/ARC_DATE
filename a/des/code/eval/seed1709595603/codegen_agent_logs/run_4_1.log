+        count = _count_components(inner == GREY)
+        assert count in stamps, "missing stamp for grey-component count"
+        stamp = stamps[int(count)]
+        out[r0 + 1 : r1, c0 + 1 : c1] = np.where(stamp, int(color), BG)
