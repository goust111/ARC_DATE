+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    if r > 0:
+        out.append((int(r - 1), int(c)))
+    if r + 1 < h:
+        out.append((int(r + 1), int(c)))
+    if c > 0:
+        out.append((int(r), int(c - 1)))
+    if c + 1 < w:
+        out.append((int(r), int(c + 1)))
+    return out
+
+
+def _components(mask: np.ndarray) -> list[dict]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if seen[rr, cc]:
+            continue
+        stack = [(rr, cc)]
+        seen[rr, cc] = True
+        coords: list[tuple[int, int]] = []
+        while stack:
+            cr, cc2 = stack.pop()
+            coords.append((int(cr), int(cc2)))
+            for nr, nc in _neighbors4(int(cr), int(cc2), h, w):
+                if mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((int(nr), int(nc)))
+        arr = np.array(coords, dtype=int)
+        r0, c0 = arr.min(axis=0)
+        r1, c1 = arr.max(axis=0)
+        comps.append(
+            {
+                "coords": arr,
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "area": int(arr.shape[0]),
+            }
+        )
+    return comps
+
+
+def _count_components(mask: np.ndarray) -> int:
+    return int(len(_components(np.asarray(mask, dtype=bool))))
+
+
+def _split_runs(indices: list[int]) -> list[tuple[int, int]]:
+    if not indices:
+        return []
+    runs: list[tuple[int, int]] = []
+    start = prev = int(indices[0])
+    for value in indices[1:]:
+        value = int(value)
+        if value == prev + 1:
+            prev = value
+            continue
+        runs.append((int(start), int(prev)))
+        start = prev = value
+    runs.append((int(start), int(prev)))
+    return runs
