+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    if r > 0:
+        out.append((int(r - 1), int(c)))
+    if r + 1 < h:
+        out.append((int(r + 1), int(c)))
+    if c > 0:
+        out.append((int(r), int(c - 1)))
+    if c + 1 < w:
+        out.append((int(r), int(c + 1)))
+    return out
