+def _find_fences(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    fences: list[dict] = []
+    for color in sorted(set(map(int, np.unique(g))) - {int(bg)}):
+        for comp in _components(g == color):
+            r0, c0, r1, c1 = _bbox(comp)
+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            if h < 3 or w < 3:
+                continue
+
+            expected = set()
+            for rr in range(r0, r1 + 1):
+                expected.add((rr, c0))
+                expected.add((rr, c1))
+            for cc in range(c0, c1 + 1):
+                expected.add((r0, cc))
+                expected.add((r1, cc))
+            if set(comp) != expected:
+                continue
+
+            inner_pts = [
+                (rr, cc)
+                for rr in range(r0 + 1, r1)
+                for cc in range(c0 + 1, c1)
+                if int(g[rr, cc]) != int(bg)
+            ]
+            if len(inner_pts) != 2:
+                continue
+
+            (r_a, c_a), (r_b, c_b) = inner_pts
+            if abs(r_a - r_b) + abs(c_a - c_b) != 1:
+                continue
+
+            v_a = int(g[r_a, c_a])
+            v_b = int(g[r_b, c_b])
+            if {v_a, v_b} != {int(color), v_a if v_a != int(color) else v_b}:
+                continue
+            if v_a == v_b or int(color) not in (v_a, v_b):
+                continue
