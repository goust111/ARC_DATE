    ir0, ic0 = r0 + 1, c0 + 1
    ir1, ic1 = r1 - 1, c1 - 1
    ih = ir1 - ir0 + 1
    iw = ic1 - ic0 + 1
    sh, sw = map(int, stamp_shape)
    assert 1 <= sh <= ih and 1 <= sw <= iw, "stamp must fit inside the fence interior"

