+                marker_pos = (r_b, c_b)
+                marker_color = v_b
+            else:
+                fence_pos = (r_b, c_b)
+                marker_pos = (r_a, c_a)
+                marker_color = v_a
+
+            direction = (fence_pos[0] - marker_pos[0], fence_pos[1] - marker_pos[1])
+            if direction not in DIRS:
