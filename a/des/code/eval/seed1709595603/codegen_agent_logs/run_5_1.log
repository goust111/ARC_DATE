+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+DIR_UP = (-1, 0)
+DIR_RIGHT = (0, 1)
+DIR_DOWN = (1, 0)
+DIR_LEFT = (0, -1)
+DIRS = (DIR_UP, DIR_RIGHT, DIR_DOWN, DIR_LEFT)
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[int(np.argmax(counts))])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((int(cr), int(cc)))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((int(nr), int(nc)))
+            out.append(comp)
+    return out
+
+
+def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    pts = np.argwhere(mask)
+    assert pts.size > 0, "expected a nonempty mask"
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].copy()
+
+
+def _component_to_mask(cells: list[tuple[int, int]]) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(cells)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in cells:
+        mask[r - r0, c - c0] = True
+    return _crop_mask(mask)
+
+
+def _rotated_stamp(mask: np.ndarray, direction: tuple[int, int]) -> np.ndarray:
+    rot_k = {
+        DIR_UP: 0,
+        DIR_RIGHT: 3,
+        DIR_DOWN: 2,
+        DIR_LEFT: 1,
+    }[direction]
+    return _crop_mask(np.rot90(mask, k=rot_k))
