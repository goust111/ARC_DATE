+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+DIR_UP = (-1, 0)
+DIR_RIGHT = (0, 1)
+DIR_DOWN = (1, 0)
+DIR_LEFT = (0, -1)
+DIRS = (DIR_UP, DIR_RIGHT, DIR_DOWN, DIR_LEFT)
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[int(np.argmax(counts))])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((int(cr), int(cc)))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((int(nr), int(nc)))
+            out.append(comp)
+    return out
+
+
+def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    pts = np.argwhere(mask)
+    assert pts.size > 0, "expected a nonempty mask"
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].copy()
+
+
+def _component_to_mask(cells: list[tuple[int, int]]) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(cells)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in cells:
+        mask[r - r0, c - c0] = True
+    return _crop_mask(mask)
+
+
+def _rotated_stamp(mask: np.ndarray, direction: tuple[int, int]) -> np.ndarray:
+    rot_k = {
+        DIR_UP: 0,
+        DIR_RIGHT: 3,
+        DIR_DOWN: 2,
+        DIR_LEFT: 1,
+    }[direction]
+    return _crop_mask(np.rot90(mask, k=rot_k))
+
+
+def _stamp_anchor(
+    bbox: tuple[int, int, int, int], stamp_shape: tuple[int, int], direction: tuple[int, int]
+) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    ir0, ic0 = r0 + 1, c0 + 1
+    ir1, ic1 = r1 - 1, c1 - 1
+    ih = ir1 - ir0 + 1
+    iw = ic1 - ic0 + 1
+    sh, sw = map(int, stamp_shape)
+    assert 1 <= sh <= ih and 1 <= sw <= iw, "stamp must fit inside the fence interior"
+
+    if direction == DIR_RIGHT:
+        return ir0 + (ih - sh) // 2, ic0
+    if direction == DIR_LEFT:
+        return ir0 + (ih - sh) // 2, ic1 - sw + 1
+    if direction == DIR_DOWN:
+        return ir0, ic0 + (iw - sw) // 2
+    if direction == DIR_UP:
+        return ir1 - sh + 1, ic0 + (iw - sw) // 2
+    raise AssertionError(direction)
+
+
+def _find_fences(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    fences: list[dict] = []
+    for color in sorted(set(map(int, np.unique(g))) - {int(bg)}):
+        for comp in _components(g == color):
+            r0, c0, r1, c1 = _bbox(comp)
+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            if h < 3 or w < 3:
+                continue
+
+            expected = set()
+            for rr in range(r0, r1 + 1):
+                expected.add((rr, c0))
+                expected.add((rr, c1))
+            for cc in range(c0, c1 + 1):
+                expected.add((r0, cc))
+                expected.add((r1, cc))
+            if set(comp) != expected:
+                continue
+
+            inner_pts = [
+                (rr, cc)
+                for rr in range(r0 + 1, r1)
+                for cc in range(c0 + 1, c1)
+                if int(g[rr, cc]) != int(bg)
+            ]
+            if len(inner_pts) != 2:
+                continue
+
+            (r_a, c_a), (r_b, c_b) = inner_pts
+            if abs(r_a - r_b) + abs(c_a - c_b) != 1:
+                continue
+
+            v_a = int(g[r_a, c_a])
+            v_b = int(g[r_b, c_b])
+            if {v_a, v_b} != {int(color), v_a if v_a != int(color) else v_b}:
+                continue
+            if v_a == v_b or int(color) not in (v_a, v_b):
+                continue
+
+            if v_a == int(color):
