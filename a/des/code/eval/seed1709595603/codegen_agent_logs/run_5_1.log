+
+BG = 0
+DIR_UP = (-1, 0)
+DIR_RIGHT = (0, 1)
+DIR_DOWN = (1, 0)
+DIR_LEFT = (0, -1)
+DIRS = (DIR_UP, DIR_RIGHT, DIR_DOWN, DIR_LEFT)
