+def _make_center_hole_piece(solid: np.ndarray) -> np.ndarray:
+    piece = solid.copy()
+    h, w = piece.shape
+    if h % 2 == 1 and w % 2 == 1:
+        piece[h // 2, w // 2] = False
+    elif h % 2 == 0 and w % 2 == 0:
+        piece[h // 2 - 1 : h // 2 + 1, w // 2 - 1 : w // 2 + 1] = False
+    elif h % 2 == 0:
