+    while queue:
+        rr, cc = queue.pop()
+        for dr, dc in DIR4:
+            nr = rr + dr
+            nc = cc + dc
+            if 0 <= nr < h and 0 <= nc < w and outside[nr, nc] and not seen[nr, nc]:
