+def _all_dihedral_pairs(mask_a: np.ndarray, mask_b: np.ndarray) -> list[tuple[np.ndarray, np.ndarray]]:
+    a0 = np.asarray(mask_a, dtype=bool)
+    b0 = np.asarray(mask_b, dtype=bool)
