+from __future__ import annotations
+
+import random
+from typing import Optional
+
+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _bbox_of_mask(mask: np.ndarray) -> Optional[tuple[int, int, int, int]]:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    return _bbox_from_coords(coords)
+
+
+def _components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            queue = [(r, c)]
+            coords = []
+            while queue:
+                rr, cc = queue.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _fill_holes(mask: np.ndarray) -> np.ndarray:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    if not mask.any():
+        return mask.copy()
+
+    outside = ~mask
+    seen = np.zeros((h, w), dtype=bool)
+    queue = []
+    for r in range(h):
+        for c in (0, w - 1):
+            if outside[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                queue.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if outside[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                queue.append((r, c))
+
+    while queue:
+        rr, cc = queue.pop()
+        for dr, dc in DIR4:
+            nr = rr + dr
+            nc = cc + dc
+            if 0 <= nr < h and 0 <= nc < w and outside[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                queue.append((nr, nc))
+
+    filled = mask.copy()
+    filled[outside & ~seen] = True
+    return filled
+
+
+def _all_dihedral_masks(mask: np.ndarray) -> list[np.ndarray]:
+    base = np.asarray(mask, dtype=bool)
+    variants: list[np.ndarray] = []
+    seen = set()
+    for flip in (False, True):
+        arr = np.fliplr(base) if flip else base
+        for k in range(4):
+            cur = np.rot90(arr, k)
+            key = (cur.shape, cur.tobytes())
+            if key in seen:
+                continue
+            seen.add(key)
+            variants.append(cur.copy())
+    return variants
+
+
+def _all_dihedral_pairs(mask_a: np.ndarray, mask_b: np.ndarray) -> list[tuple[np.ndarray, np.ndarray]]:
+    a0 = np.asarray(mask_a, dtype=bool)
+    b0 = np.asarray(mask_b, dtype=bool)
+    variants: list[tuple[np.ndarray, np.ndarray]] = []
+    seen = set()
+    for flip in (False, True):
+        a1 = np.fliplr(a0) if flip else a0
+        b1 = np.fliplr(b0) if flip else b0
+        for k in range(4):
+            aa = np.rot90(a1, k)
+            bb = np.rot90(b1, k)
+            key = (aa.shape, aa.tobytes(), bb.shape, bb.tobytes())
+            if key in seen:
+                continue
+            seen.add(key)
+            variants.append((aa.copy(), bb.copy()))
+    return variants
+
+
+def _canonical_mask(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    keys = [(variant.shape, variant.tobytes()) for variant in _all_dihedral_masks(mask)]
+    return min(keys)
+
+
+def _frame_candidates(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    candidates: list[dict] = []
+    for color in np.unique(g):
+        color = int(color)
+        if color == bg:
+            continue
+        coords = np.argwhere(g == color)
+        if coords.size == 0:
+            continue
+        r0, c0, r1, c1 = _bbox_from_coords(coords)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 3 or w < 3:
+            continue
+        sub = g[r0 : r1 + 1, c0 : c1 + 1]
+        if not np.all(sub[0, :] == color):
+            continue
+        if not np.all(sub[-1, :] == color):
+            continue
+        if not np.all(sub[:, 0] == color):
+            continue
+        if not np.all(sub[:, -1] == color):
