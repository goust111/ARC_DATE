+    def dfs(pos: int) -> bool:
+        if pos == len(order):
+            return True
+        piece_idx = order[pos]
+        for opt in options[piece_idx]:
+            slot_idx = int(opt["slot_idx"])
+            if slot_idx in used_slots:
