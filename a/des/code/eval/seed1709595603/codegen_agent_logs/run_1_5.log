+
+def _can_place_slot(existing_bg: np.ndarray, mask: np.ndarray, top: int, left: int) -> bool:
+    h, w = existing_bg.shape
+    mh, mw = mask.shape
+    if top < 0 or left < 0 or top + mh > h or left + mw > w:
+        return False
+    for r in range(mh):
+        for c in range(mw):
+            if not mask[r, c]:
+                continue
+            rr = top + r
+            cc = left + c
+            if existing_bg[rr, cc]:
+                return False
