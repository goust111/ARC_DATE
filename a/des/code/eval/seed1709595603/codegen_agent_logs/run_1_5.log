+        inside = sub[1:-1, 1:-1]
+        if inside.size == 0 or not np.any(inside == bg):
+            continue
+        candidates.append(
+            {
+                "color": color,
+                "bbox": (r0, c0, r1, c1),
+                "bbox_area": int(h * w),
+                "color_area": int(coords.shape[0]),
+            }
+        )
+    candidates.sort(key=lambda d: (-d["bbox_area"], -d["color_area"], d["color"]))
+    return candidates
