+def _all_dihedral_masks(mask: np.ndarray) -> list[np.ndarray]:
+    base = np.asarray(mask, dtype=bool)
+    variants: list[np.ndarray] = []
+    seen = set()
+    for flip in (False, True):
+        arr = np.fliplr(base) if flip else base
+        for k in range(4):
+            cur = np.rot90(arr, k)
+            key = (cur.shape, cur.tobytes())
