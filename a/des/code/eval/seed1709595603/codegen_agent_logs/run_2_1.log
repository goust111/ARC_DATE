+
+def _anchor_top_left(seed: tuple[int, int], quadrant: str, shape: tuple[int, int]) -> tuple[int, int]:
+    sr, sc = seed
+    height, width = shape
+    if quadrant == "tl":
+        return sr, sc
+    if quadrant == "tr":
+        return sr, sc - width + 1
+    if quadrant == "br":
