+    top, left = _anchor_top_left(seed, quadrant, rotated.shape)
+    height, width = rotated.shape
+    r0, c0, r1, c1 = fence_bbox
+    assert top >= r0 + 1 and left >= c0 + 1
+    assert top + height - 1 <= r1 - 1 and left + width - 1 <= c1 - 1
