+def _seed_position(inner_h: int, inner_w: int, quadrant: str) -> tuple[int, int]:
+    if quadrant in {"tl", "tr"}:
+        row_range = range(0, inner_h // 2)
+    else:
+        row_range = range(inner_h // 2, inner_h)
+    if quadrant in {"tl", "bl"}:
+        col_range = range(0, inner_w // 2)
+    else:
