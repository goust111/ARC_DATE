+def _quadrant_from_seed(fence: dict) -> str:
+    r0, c0, r1, c1 = fence["bbox"]
+    sr, sc = fence["seed"]
+    inner_h = r1 - r0 - 1
+    inner_w = c1 - c0 - 1
+    rel_r = sr - (r0 + 1)
+    rel_c = sc - (c0 + 1)
+    top = rel_r < inner_h / 2.0
+    left = rel_c < inner_w / 2.0
+    if top and left:
+        return "tl"
+    if top and not left:
+        return "tr"
+    if not top and not left:
+        return "br"
+    return "bl"
