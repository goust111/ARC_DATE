+        sr, sc = fence["seed"]
+        grid[sr, sc] = fence["seed_color"]
+
+    expected = _expected_output(grid, template, placed)
+    produced = main(grid)
+    if not np.array_equal(produced, expected):
+        return None
+    if np.array_equal(grid, expected):
+        return None
