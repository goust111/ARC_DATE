+
+def _border_mask(
+    shape: tuple[int, int], bbox: tuple[int, int, int, int]
+) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    mask = np.zeros(shape, dtype=bool)
+    mask[r0, c0 : c1 + 1] = True
+    mask[r1, c0 : c1 + 1] = True
+    if r1 - r0 > 1:
+        mask[r0 + 1 : r1, c0] = True
+        mask[r0 + 1 : r1, c1] = True
+    else:
+        mask[r0 : r1 + 1, c0] = True
+        mask[r0 : r1 + 1, c1] = True
+    return mask
+
