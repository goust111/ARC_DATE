+def _expand_bbox(
+    bbox: tuple[int, int, int, int], amount: int, height: int, width: int
+) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = bbox
+    return (
+        max(0, int(r0) - int(amount)),
+        max(0, int(c0) - int(amount)),
