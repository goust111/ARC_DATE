+def _mirror_cell(cell: tuple[int, int], region: np.ndarray, orientation: str) -> tuple[int, int]:
+    mask, box = _region_mask([(int(r), int(c)) for r, c in np.argwhere(region)])
+    assert np.array_equal(mask, region)
+    r0, c0, r1, c1 = box
