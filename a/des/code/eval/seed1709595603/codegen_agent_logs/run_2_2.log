+    r0, c0, r1, c1 = bbox
+    axis_sum = (c0 + c1) if vertical else (r0 + r1)
+    neg = False
+    pos = False
+    for r, c in fragments:
+        coord2 = 2 * c if vertical else 2 * r
+        if coord2 == axis_sum:
