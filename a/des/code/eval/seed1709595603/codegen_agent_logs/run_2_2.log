+            rr0 = max(0, dr)
+            rr1 = min(h, h + dr)
+            cc0 = max(0, dc)
+            cc1 = min(w, w + dc)
+            src_r0 = max(0, -dr)
+            src_r1 = src_r0 + (rr1 - rr0)
+            src_c0 = max(0, -dc)
+            src_c1 = src_c0 + (cc1 - cc0)
