    assert marker_rows.size == 1
    assert np.all((control == Color.PINK) | (control == Color.RED))
    assert np.count_nonzero(control == Color.PINK) == h - 1

    shift = int(marker_rows[0])
    return np.roll(g[:, 1:], shift=shift, axis=0)

