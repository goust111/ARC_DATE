+    bottom = np.zeros((bottom_h, length), dtype=bool)
+    for c in range(length):
+        bit = (start_bit + c) % 2
+        top[: top_h - 1 + bit, c] = True
+        bottom[1 if bit else 0 :, c] = True
+    return top, bottom
