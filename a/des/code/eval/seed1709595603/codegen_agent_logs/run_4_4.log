+                "pieces": pieces,
+                "anchor_piece": anchor_piece,
+                "second_offset": (second_r, second_c),
+                "zone_shape": (zone_h, zone_w),
+                "out_shape": out_shape,
+                "stripe_colors": stripe_colors,
+            }
+        )
