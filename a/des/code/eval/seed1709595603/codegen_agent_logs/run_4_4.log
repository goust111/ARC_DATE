+            limit = max(ends)
+            side = "right"
+            profile = [int(v == limit) for v in ends]
+        elif len(set(ends)) == 1 and max(starts) - min(starts) == 1:
+            limit = min(starts)
+            side = "left"
+            profile = [int(v == limit) for v in starts]
+        else:
