+def _allowed_dirs(r: int, c: int, valves: dict[tuple[int, int], str]) -> set[tuple[int, int]]:
+    orientation = valves.get((r, c))
+    if orientation == VALVE_HORIZONTAL:
+        return {(0, -1), (0, 1)}
+    if orientation == VALVE_VERTICAL:
+        return {(-1, 0), (1, 0)}
+    return set(DIRS)
