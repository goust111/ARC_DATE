+    reach: dict[tuple[int, int], set[int]] = {}
+    for sr, sc, source_color in sources:
+        seen = {(sr, sc)}
+        queue = deque([(sr, sc)])
+        while queue:
+            r, c = queue.popleft()
+            for nr, nc in _graph_neighbors(g, r, c, valves):
+                if (nr, nc) in seen:
+                    continue
+                seen.add((nr, nc))
+                queue.append((nr, nc))
+        for r, c in seen:
