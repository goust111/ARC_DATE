+def _source_cells(g: np.ndarray, valves: dict[tuple[int, int], str]) -> list[tuple[int, int, int]]:
+    sources: list[tuple[int, int, int]] = []
+    for r in range(2, g.shape[0]):
+        for c in range(g.shape[1]):
+            color = int(g[r, c])
+            if color in (BG, GREY, AZURE):
