+
+
+def make_tee4_unique(bg: int) -> dict[str, np.ndarray]:
+    for _ in range(200):
+        center, left, right, vertical = sample_unique_largest_specs(bg, 4)
+        gap_left = random.randint(*GAP_RANGE)
