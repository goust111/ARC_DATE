+                down += 1
+            elif new_index > int(item["orig_index"]):
+                up += 1
+            else:
+                stationary += 1
+    return down, up, stationary
+
+
+def _draw_container(grid: np.ndarray, r0: int, c0: int, r1: int) -> None:
+    grid[r0 : r1 + 1, c0] = GREY
+    grid[r0 : r1 + 1, c0 + 2] = GREY
+    grid[r1, c0 : c0 + 3] = GREY
