+BG = 0
+GREY = 5
+YELLOW = 4
+BALL_COLORS = (1, 2, 3, 6, 7, 8, 9)
+
+GEN_ATTEMPTS = 400
+GEN_GRID_H = (10, 18)
+GEN_GRID_W = (14, 28)
+GEN_CONTAINER_COUNT = (2, 4)
+GEN_TOTAL_BALLS = (4, 7)
+GEN_BALLS_PER_CONTAINER_MAX = 4
+GEN_EXTRA_CAPACITY = (1, 3)
+GEN_BOTTOM_ROW_GAP = 2
+GEN_CONTAINER_MIN_SEP = 5
+GEN_BAR_EDGE_MARGIN = 0
