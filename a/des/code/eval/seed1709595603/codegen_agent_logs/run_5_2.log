+            cur_row, cur_col = row, col
+            distance = 0
+            while _edge_is_open(g, bg, line_rows, line_cols, cur_row, cur_col, direction):
+                cur_row += dr
+                cur_col += dc
+                distance += 1
+                offer(cur_row, cur_col, distance, seed_index, seed)
