+            pos = tuple(spec["pos"])
+            seeds.append({"pos": pos})
+            reserved.add(pos)
+            seed_dirs[pos] = [tuple(spec["direction"])]
+        for spec in conflict:
+            path_cells = _add_segment(open_right, open_down, tuple(spec["pos"]), tuple(spec["direction"]), int(spec["length"]))
+            reserved.update(path_cells)
