0040: def main(grid: np.ndarray) -> np.ndarray:
0041:     """
0042:     Slide each foreground object horizontally to the edge indicated by whether its shape has an open notch.
0043: 
0044:     Input structure:
0045:     - Yellow is the background and there is one blue foreground color.
0046:     - The foreground is split into separated 4-connected objects.
0047:     - Each object keeps its row span and shape in the output.
0048: 
0049:     Rule:
0050:     - If an object's bbox border contains a background gap flanked by object pixels along that same border, slide it to the right edge and recolor it green.
0051:     - Otherwise slide the object to the left edge and recolor it red.
0052:     - Start from a blank background canvas; no moved objects overlap.
0053: 
0054:     Key insight:
0055:     - The target side is encoded by the object's shape, not by its original position: open notches go right, while closed or solid shapes go left.
0056:     """
0057:     g = np.asarray(grid, dtype=int)
0058:     bg = int(get_bg(g))
0059:     fg_colors = colors_present(g, exclude={bg})
0060:     assert len(fg_colors) == 1, "expected exactly one foreground color"
0061:     fg = int(fg_colors[0])
0062: 
0063:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[fg])
0064:     assert components, "expected at least one foreground object"
0065: 
0066:     out = np.full_like(g, bg)
0067:     W = g.shape[1]
0068:     for component in components:
0069:         bbox = tuple(map(int, component["bbox"]))
0070:         r0, _c0, r1, _c1 = bbox
0071:         mask = _component_mask(component["coords"], bbox)
0072:         h, w = mask.shape
0073: 
0074:         has_open_notch = _has_flanked_boundary_gap(mask)
0075:         dst_c = W - w if has_open_notch else 0
0076:         color = GREEN if has_open_notch else RED
0077:         assert 0 <= dst_c and dst_c + w <= W, "moved object must fit within the grid"
0078: 
0079:         dst = out[r0 : r1 + 1, dst_c : dst_c + w]
0080:         assert dst.shape == (h, w), "destination slice must match object bbox"
0081:         assert np.all(dst[mask] == bg), "moved objects must not overlap"
0082:         dst[mask] = color
0083: 
0084:     return out
0085: 
