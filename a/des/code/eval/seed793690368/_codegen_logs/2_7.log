0121: def main(grid: np.ndarray) -> np.ndarray:
0122:     """
0123:     Reflect the solid rectangular source objects across the full separator line and color the gap with the separator color.
0124: 
0125:     Input structure:
0126:     - A dominant background contains one full-width or full-height one-pixel
0127:       separator line in a non-background color.
0128:     - One other foreground color forms solid rectangular objects, all strictly on the same side of that separator.
0129:     - Remaining non-background pixels are scattered distractors.
0130: 
0131:     Rule:
0132:     - Keep the input grid shape and unchanged pixels outside each affected corridor.
0133:     - Mirror each source object across the separator line.
0134:     - For every source object, recolor the rectangular strip between the
0135:       original object and its reflection to the separator color, then paint the
0136:       reflected object in the source color.
0137: 
0138:     Key insight:
0139:     - The full straight line is a mirror axis; the real objects are identified
0140:       structurally as the only solid rectangles confined to one side, while
0141:       scattered pixels are noise that may be overwritten inside the corridor.
0142:     """
0143:     g = np.asarray(grid, dtype=int)
0144:     bg = get_bg(g)
0145:     orient, axis, axis_color = _find_separator(g, bg)
0146:     source_color, components = _find_source(g, bg, orient, axis, axis_color)
0147: 
0148:     out = g.copy()
0149:     for component in components:
0150:         _mirror_and_connect(out, component, orient, axis, axis_color, source_color)
0151:     return out
0152: 
