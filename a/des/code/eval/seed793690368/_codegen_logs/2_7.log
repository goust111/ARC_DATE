0128: def _random_heights(n: int) -> list[int]:
0129:     usable = GRID_H - MIN_ROW_GAP * (n - 1)
0130:     choices = [
0131:         hs
0132:         for hs in itertools.product(range(OBJECT_H_MIN, OBJECT_H_MAX + 1), repeat=n)
0133:         if sum(hs) <= usable
0134:     ]
0135:     return list(random.choice(choices))
