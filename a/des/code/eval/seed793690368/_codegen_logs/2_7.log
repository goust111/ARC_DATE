0092: # Object counts, dimensions, and row separation.
0093: OBJECT_COUNT_MIN, OBJECT_COUNT_MAX, NOTCH_OBJECT_COUNT = 3, 5, 2
0094: OBJECT_H_MIN, OBJECT_H_MAX, OBJECT_W_MIN, OBJECT_W_MAX = 2, 6, 2, 9
0095: MIN_ROW_GAP = 1
