0138: def _row_starts(heights: list[int]) -> list[int]:
0139:     free = GRID_H - sum(heights) - MIN_ROW_GAP * (len(heights) - 1)
0140:     gaps = [0] * (len(heights) + 1)
0141:     for _ in range(free):
0142:         gaps[random.randrange(len(gaps))] += 1
0143: 
0144:     starts = []
0145:     r = gaps[0]
0146:     for i, h in enumerate(heights):
0147:         starts.append(r)
0148:         r += h
0149:         if i + 1 < len(heights):
0150:             r += MIN_ROW_GAP + gaps[i + 1]
0151:     return starts
