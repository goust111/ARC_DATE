0507:     valid_d = [d for d in range(1, max_d + 1)
0508:                if remaining - d <= MAX_EXTRA_PER_LEGEND * len(legends)]
0509:     n_distractors = random.choice(valid_d)
0510:     extra_matches = remaining - n_distractors
0511:     extras = [0] * len(legends)
0512:     for _ in range(extra_matches):
0513:         choices = [i for i, x in enumerate(extras) if x < MAX_EXTRA_PER_LEGEND]
0514:         extras[random.choice(choices)] += 1
0515: 
0516:     plan = []
0517:     for i, (hole_count, color) in enumerate(legends):
0518:         for _ in range(1 + extras[i]):
0519:             plan.append((hole_count, color))
0520:     legend_holes = {h for h, _ in legends}
0521:     distractor_holes = [h for h in range(MAX_HOLE_COUNT) if h not in legend_holes]
0522:     for _ in range(n_distractors):
0523:         plan.append((random.choice(distractor_holes), None))
