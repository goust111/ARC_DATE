0372:     """Grow irregular blob regions around each hole seed. Returns the full forbidden set."""
0373:     margin = HOLE_SEED_MARGIN
0374:     max_hole = (max(2, area // (hole_count + 2)) if hole_count <= 2
0375:                 else max(1, area // (hole_count * 2 + 1)))
0376:     forbidden = set()
