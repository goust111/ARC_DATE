0177: def _choose_legends(arrangement: str, max_span: int) -> list[tuple[int, int]]:
0178:     """Pick 2-4 legends with distinct hole counts that fit within max_span."""
0179:     count = random.randint(*LEGEND_COUNT_RANGE)
0180:     combos = [holes for holes in itertools.combinations(range(MAX_HOLE_COUNT), count)
0181:               if sum(_legend_span(h) for h in holes) + count - 1 <= max_span]
0182:     if not combos:
0183:         return _choose_legends(arrangement, max_span + 2)
0184:     holes = list(random.choice(combos))
0185:     random.shuffle(holes)
0186:     colors = random.sample(LEGEND_COLORS, count)
0187:     return list(zip(holes, colors))
