0107: def _has_flanked_boundary_gap(mask: np.ndarray) -> bool:
0108:     h, w = mask.shape
0109:     for c in range(w):
0110:         if not mask[0, c] and mask[0, :c].any() and mask[0, c + 1 :].any():
0111:             return True
0112:         if h > 1 and not mask[h - 1, c] and mask[h - 1, :c].any() and mask[h - 1, c + 1 :].any():
0113:             return True
0114:     for r in range(h):
0115:         if not mask[r, 0] and mask[:r, 0].any() and mask[r + 1 :, 0].any():
0116:             return True
0117:         if w > 1 and not mask[r, w - 1] and mask[:r, w - 1].any() and mask[r + 1 :, w - 1].any():
0118:             return True
0119:     return False
