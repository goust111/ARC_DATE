0378:         forbidden.add((sr, sc))
0379:         blob = {(sr, sc)}
0380:         target = random.randint(1, max(1, max_hole))
0381:         while len(blob) < target:
0382:             cands = []
0383:             for r, c in blob:
0384:                 for nr, nc in neighbors4(r, c):
