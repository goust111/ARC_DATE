0088:         label_id for label_id in range(1, n_channels + 1) if np.any(channel_labels[0, :] == label_id)
0089:     ]
0090:     assert len(top_components) == 1, "expected exactly one channel component connected to the top edge"
0091: 
0092:     paint = channel_labels == top_components[0]
0093:     assert np.any(paint), "expected cells to paint"
