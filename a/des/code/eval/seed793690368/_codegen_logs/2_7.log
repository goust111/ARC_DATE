0196: def _pack_intervals(length: int, sizes: list[int], *, min_gap: int) -> list[tuple[int, int]] | None:
0197:     extra = int(length) - sum(sizes) - int(min_gap) * (len(sizes) - 1)
0198:     if extra < 0:
0199:         return None
0200:     gaps = _composition(extra, len(sizes) + 1)
0201:     intervals: list[tuple[int, int]] = []
0202:     pos = gaps[0]
0203:     for i, size in enumerate(sizes):
0204:         intervals.append((pos, pos + int(size) - 1))
0205:         pos += int(size)
0206:         if i + 1 < len(sizes):
0207:             pos += int(min_gap) + gaps[i + 1]
0208:     return intervals
