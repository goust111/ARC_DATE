0062:             pr0 = max(0, int(r0) - 1)
0063:             pc0 = max(0, int(c0) - 1)
0064:             pr1 = min(h - 1, int(r1) + 1)
0065:             pc1 = min(w - 1, int(c1) + 1)
0066: 
0067:             patch = np.full((pr1 - pr0 + 1, pc1 - pc0 + 1), bg, dtype=int)
