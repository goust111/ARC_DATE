0099: NOTCH_INTERIOR_CARVE_PROB, EXTRA_CARVE_PROB = 0.45, 0.20
0100: CLOSED_CARVE_PROB_SMALL, CLOSED_CARVE_PROB_LARGE = 0.45, 0.88
