0386:                         continue
0387:                     if (nr, nc) in forbidden:
0388:                         continue
0389:                     if any((nnr, nnc) in forbidden and (nnr, nnc) not in blob
0390:                            for nnr, nnc in neighbors4(nr, nc)):
0391:                         continue
0392:                     cands.append((nr, nc))
0393:             if not cands:
0394:                 break
0395:             p = random.choice(cands)
