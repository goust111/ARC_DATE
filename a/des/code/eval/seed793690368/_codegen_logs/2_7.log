0088: # Canvas and colors.
0089: BG, BLUE, RED, GREEN = Color.YELLOW, Color.BLUE, Color.RED, Color.GREEN
0090: GRID_H, GRID_W_MIN, GRID_W_MAX = 22, 19, 26
