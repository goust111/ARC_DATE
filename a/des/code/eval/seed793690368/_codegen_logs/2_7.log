0034:         if c0 != 0 or c1 != 1 or height != 2 or int(comp["area"]) != 4:
0035:             continue
0036: 
0037:         sub = g[r0 : r1 + 1, c0 : c1 + 1]
0038:         assert np.all(sub != bg), "legend marker must be a full 2x2 foreground block"
0039:         assert np.all(sub[:, 0] == sub[0, 0]), "legend source column must be monochrome"
0040:         assert np.all(sub[:, 1] == sub[0, 1]), "legend halo column must be monochrome"
0041:         source = int(sub[0, 0])
0042:         halo = int(sub[0, 1])
0043:         assert source != halo, "legend source and halo colors must differ"
0044:         assert source not in markers, "each source color must have exactly one legend marker"
0045: 
0046:         markers[source] = halo
0047:         marker_source_cells[source] = {tuple(map(int, coord)) for coord in comp["coords"] if int(g[tuple(coord)]) == source}
0048: 
0049:     assert markers, "expected at least one left-edge legend marker"
0050: 
0051:     for source, halo in markers.items():
0052:         objects = []
0053:         for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[source], return_format="dict"):
0054:             cells = {tuple(map(int, coord)) for coord in comp["coords"]}
0055:             if cells <= marker_source_cells[source]:
0056:                 continue
0057:             objects.append(comp)
0058:         assert objects, "each legend source color must label at least one non-marker object"
