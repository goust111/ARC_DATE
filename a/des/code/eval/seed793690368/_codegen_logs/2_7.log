0158: def _legend_patch(hole_count: int, color: int, arrangement: str) -> np.ndarray:
0159:     """Build a 3xSpan (horizontal) or Spanx3 (vertical) legend patch."""
0160:     span = _legend_span(hole_count)
0161:     if arrangement == "horizontal":
0162:         patch = np.full((3, span), int(color), dtype=int)
0163:         if hole_count:
0164:             patch[1, 1::2] = BG
0165:     else:
0166:         patch = np.full((span, 3), int(color), dtype=int)
0167:         if hole_count:
0168:             patch[1::2, 1] = BG
0169:     return patch
