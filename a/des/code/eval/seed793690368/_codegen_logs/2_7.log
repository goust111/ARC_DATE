0019: def main(grid: np.ndarray) -> np.ndarray:
0020:     """
0021:     Carve color-matched motifs into solid blocks and pack them into a compact grid.
0022: 
0023:     Input structure:
0024:     - bg = most common color.
0025:     - Several solid 5×5 monochrome blocks, each a distinct non-bg color.
0026:     - For each block color, a small same-colored motif sprite elsewhere on the grid.
0027: 
0028:     Rule:
0029:     - Match each motif to its same-colored 5×5 block.
0030:     - Center the motif within the block and recolor those cells to bg (punching holes).
0031:     - Pack all carved blocks into an output grid preserving their original row/column order, separated by 1-cell gaps and a 1-cell outer border.
0032: 
0033:     Key insight: The motif acts as a stencil — it's not stamped onto the block but carved out of it as background holes.
0034:     """
0035:     g = np.array(grid, dtype=int)
0036:     bg = int(get_bg(g))
0037:     H, W = g.shape
0038: 
0039:     # STEP 1) Identify destination blocks: solid 5x5 monochrome squares.
0040:     blocks: list[dict[str, int]] = []
0041:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=True, return_format="dict")
0042:     for comp in comps:
0043:         b = comp["bbox"]
0044:         if bbox_h(b) != 5 or bbox_w(b) != 5:
0045:             continue
0046:         col = int(comp["color"])
0047:         patch = crop_bbox(g, b)
0048:         if bool((patch == int(col)).all()):
0049:             r0, c0, _r1, _c1 = map(int, b)
0050:             blocks.append({"col": int(col), "r0": int(r0), "c0": int(c0)})
0051: 
0052:     assert not (not blocks)
0053: 
0054:     # STEP 2) For each block color, identify its motif:
0055:     # the smallest same-colored component that is NOT one of the 5x5 blocks.
0056:     motifs: dict[int, np.ndarray] = {}
0057:     block_colors = {int(b["col"]) for b in blocks}
0058:     for bcol in block_colors:
0059:         candidates: list[tuple[int, int, int, int, np.ndarray]] = []  # (area, bbox_area, r0, c0, mask)
0060: 
0061:         comps_col = find_components(g, bg=bg, connectivity=8, monochromatic=True, colors=[int(bcol)], return_format="dict")
0062:         for comp in comps_col:
0063:             b = comp["bbox"]
0064:             if bbox_h(b) == 5 and bbox_w(b) == 5:
0065:                 patch = crop_bbox(g, b)
0066:                 if bool((patch == int(bcol)).all()):
0067:                     continue  # skip the big 5x5 blocks
0068: 
0069:             r0, c0, r1, c1 = map(int, b)
0070:             h = int(r1 - r0 + 1)
0071:             w = int(c1 - c0 + 1)
0072: 
0073:             rel_coords = [(int(r) - r0, int(c) - c0) for r, c in comp["coords"]]
0074:             m = mask_from_coords(rel_coords, (h, w))
0075:             candidates.append((int(comp["area"]), int(h * w), int(r0), int(c0), m))
0076: 
0077:         if candidates:
0078:             candidates.sort(key=lambda t: (t[0], t[1], t[2], t[3]))
0079:             motifs[int(bcol)] = candidates[0][4]
0080: 
0081:     # STEP 3) Carve each 5x5 tile:
0082:     # center the motif mask within the 5x5 and repaint those mask cells to bg.
0083:     carved: dict[tuple[int, int], np.ndarray] = {}
0084:     for b in blocks:
0085:         col = int(b["col"])
0086:         tile = np.full((5, 5), int(col), dtype=int)
0087:         mm = motifs.get(int(col))
0088:         if mm is not None:
0089:             mh, mw = map(int, mm.shape)
0090:             off_r = (5 - mh) // 2
0091:             off_c = (5 - mw) // 2
0092:             for rr, cc in np.argwhere(mm):
0093:                 tr = int(off_r + int(rr))
0094:                 tc = int(off_c + int(cc))
0095:                 if 0 <= tr < 5 and 0 <= tc < 5:
0096:                     tile[tr, tc] = int(bg)
0097:         carved[(int(b["r0"]), int(b["c0"]))] = tile
0098: 
0099:     # STEP 4) Pack carved 5x5 tiles into a compact grid.
0100:     rs = sorted({int(b["r0"]) for b in blocks})
0101:     cs = sorted({int(b["c0"]) for b in blocks})
0102:     r_index = {int(r): int(i) for i, r in enumerate(rs)}
0103:     c_index = {int(c): int(j) for j, c in enumerate(cs)}
0104: 
0105:     out_h = int(1 + len(rs) * 5 + (len(rs) - 1) * 1 + 1)
0106:     out_w = int(1 + len(cs) * 5 + (len(cs) - 1) * 1 + 1)
0107:     out = np.full((out_h, out_w), int(bg), dtype=int)
0108: 
0109:     step = 6  # 5 block + 1 gap
0110:     for b in blocks:
0111:         r0 = int(b["r0"])
0112:         c0 = int(b["c0"])
0113:         i = int(r_index[int(r0)])
0114:         j = int(c_index[int(c0)])
0115:         rr = int(1 + i * step)
0116:         cc = int(1 + j * step)
0117:         out[rr : rr + 5, cc : cc + 5] = carved[(int(r0), int(c0))]
0118: 
0119:     return out
