0069: 
0070:     blocked = []
0071:     for r_raw, c_raw in np.argwhere(channel & (g != bg)):
0072:         r = int(r_raw)
0073:         c = int(c_raw)
0074:         adjacent = _adjacent_path_labels(path_labels, r, c)
0075:         assert adjacent, "control pixel in channel must touch a path component"
0076:         if len(adjacent) < n_paths:
0077:             blocked.append((r, c))
0078:         else:
0079:             assert len(adjacent) == n_paths, "channel control pixel cannot touch extra path labels"
0080: 
0081:     passable = channel.copy()
0082:     for r, c in blocked:
0083:         passable[r, c] = False
0084: 
0085:     channel_labels, n_channels = label_mask(passable, connectivity=4)
