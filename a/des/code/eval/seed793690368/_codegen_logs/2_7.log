0068: def main(grid: np.ndarray) -> np.ndarray:
0069:     """
0070:     Recolor grey shapes by matching their hole count to a color legend.
0071: 
0072:     Input structure:
0073:     - bg = most common color; grey (5) sprites scattered across the grid.
0074:     - Colored legend shapes (non-bg, non-grey, at least 2×2, not touching the outer border) near grid edge,
0075:       each with a distinct number of enclosed holes.
0076: 
0077:     Rule:
0078:     - Each colored legend shape defines a mapping: hole count → color.
0079:     - For every grey sprite, count its holes (enclosed bg regions not touching the sprite's bounding-box border).
0080:     - Recolor the grey sprite to the matching legend color; erase grey distractors with unlisted hole counts.
0081: 
0082:     Key insight: Shape identity is encoded by topology (number of holes), not geometry or size.
0083:     """
0084:     g = np.asarray(grid, dtype=int)
0085:     bg = get_bg(g)
0086:     grey = 5
0087: 
0088:     legend = _legend_mapping(g, bg, grey)
0089:     assert legend, "legend mapping must be non-empty: grid must contain colored legend shapes"
0090: 
0091:     out = g.copy()
0092:     for pts in components_mask(g == grey, connectivity=4):
0093:         r0, c0, r1, c1 = bbox_coords(pts)
0094:         sub = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
0095:         for r, c in pts:
0096:             sub[r - r0, c - c0] = True
0097:         hc = _hole_count(sub)
0098:         newc = int(legend[hc]) if hc in legend else bg
0099:         for r, c in pts:
0100:             out[r, c] = newc
0101: 
0102:     return out
