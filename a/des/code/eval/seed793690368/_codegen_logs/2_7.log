0119: def main(grid: np.ndarray) -> np.ndarray:
0120:     """
0121:     Transfer center colors between bordered sprites matched by color, keeping only path-connected ones.
0122: 
0123:     Input structure:
0124:     - bg, grey (5) path network, and several small "bordered sprites" each having a border color and a single center pixel of a different color.
0125:     - Grey path forms a one-stroke trail under 8-connectivity; its start/end cells touch exactly two destination sprites via ports.
0126: 
0127:     Rule:
0128:     - Destination sprites are determined by the grey trail's two endpoints.
0129:     - For each destination, find the source sprite whose border color equals the destination's center color.
0130:     - Replace the destination's center pixel with the source's center color.
0131:     - Delete all non-destination sprites; grey paths and destinations remain.
0132: 
0133:     Key insight: Center color of each destination acts as a lookup key into the border colors of other sprites, enabling indirect color transfer.
0134:     """
0135:     g = np.asarray(grid, dtype=int)
0136:     bg = _bg_boundary(g)
0137:     grey = 5
0138: 
0139:     sprites = _detect_bordered_sprites(g, bg, grey)
0140:     assert sprites, "expected at least one bordered sprite in the grid"
0141: 
0142:     # Trail endpoints determine the 2 destination sprites (no color tiebreaking).
0143:     te1, te2 = _find_trail_endpoints(g, grey, sprites)
0144:     trail_eps = {te1, te2}
0145: 
0146:     eps_pair = [te1, te2]
0147:     opts = {ep: [sp for sp in sprites if ep in _ports_for_sprite(sp, g, trail_eps)]
0148:             for ep in eps_pair}
0149: 
0150:     # Bipartite match: fewer-options-first; tiebreak by sprite farthest from OTHER endpoint
0151:     dest: list[dict] = [None, None]  # type: ignore[list-item]
0152:     order = [0, 1] if len(opts[te1]) <= len(opts[te2]) else [1, 0]
0153:     used: set[int] = set()
0154:     for i in order:
0155:         ep = eps_pair[i]
0156:         other = eps_pair[1 - i]
0157:         cands = [sp for sp in opts[ep] if id(sp) not in used]
0158:         best = max(cands, key=lambda sp: abs(sp["center_pos"][0] - other[0])
0159:                    + abs(sp["center_pos"][1] - other[1]))
0160:         dest[i] = best
0161:         used.add(id(best))
0162:     assert all(d is not None for d in dest), "expected exactly 2 dest sprites from trail endpoints"
0163:     dest_ids = {id(sp) for sp in dest}
0164: 
0165:     # Build border->sprites lookup (using original input attributes).
0166:     by_border: dict[int, list[dict]] = {}
0167:     for sp in sprites:
0168:         by_border.setdefault(int(sp["border"]), []).append(sp)
0169: 
0170:     out = g.copy()
0171: 
0172:     # Delete all non-destination sprites completely.
0173:     for sp in sprites:
0174:         if id(sp) in dest_ids:
0175:             continue
0176:         for r, c in sp["pts"]:
0177:             out[r, c] = bg
0178: 
0179:     # Also delete any remaining non-grey, non-bg pixels not connected to a destination sprite.
0180:     # (Some instances contain extra non-sprite components that are removed in the output.)
0181:     keep = np.zeros(out.shape, dtype=bool)
0182:     q: list[tuple[int, int]] = []
0183:     for d in dest:
0184:         for r, c in d["pts"]:
0185:             if out[r, c] != bg and out[r, c] != grey and not keep[r, c]:
0186:                 keep[r, c] = True
0187:                 q.append((r, c))
0188:     while q:
0189:         r, c = q.pop()
0190:         for nr, nc in neighbors4(r, c):
0191:             if 0 <= nr < out.shape[0] and 0 <= nc < out.shape[1]:
0192:                 if keep[nr, nc]:
0193:                     continue
0194:                 if out[nr, nc] == bg or out[nr, nc] == grey:
0195:                     continue
0196:                 keep[nr, nc] = True
0197:                 q.append((nr, nc))
0198:     drop = (out != bg) & (out != grey) & (~keep)
0199:     out[drop] = bg
0200: 
0201:     # Update destination centers by matching their original center color to a source sprite border.
0202:     for d in dest:
0203:         want_border = int(d["center"])
0204:         srcs = by_border.get(want_border, [])
0205:         if not srcs:
0206:             continue
0207:         assert len(srcs) == 1, "each destination color should match at most one source border"
0208:         src = srcs[0]
0209:         dr, dc = d["center_pos"]
0210:         out[dr, dc] = int(src["center"])
0211: 
0212:     return out
