+    assert len(pts) == 1, f"expected exactly one cell of color {color}"
+    return int(pts[0, 0]), int(pts[0, 1])
+
+
+def _shortest_path(passable: np.ndarray, start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = passable.shape
