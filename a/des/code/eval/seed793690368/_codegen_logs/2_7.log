0154: def _carve_interior_rect(mask: np.ndarray, max_remove: int, probability: float) -> int:
0155:     if max_remove <= 0 or random.random() > probability:
0156:         return 0
0157: 
0158:     h, w = mask.shape
0159:     choices = []
0160:     for r0 in range(1, h - 1):
0161:         for c0 in range(1, w - 1):
0162:             for r1 in range(r0, h - 1):
0163:                 for c1 in range(c0, w - 1):
0164:                     area = (r1 - r0 + 1) * (c1 - c0 + 1)
0165:                     if area <= max_remove and np.all(mask[r0 : r1 + 1, c0 : c1 + 1]):
0166:                         choices.append((r0, c0, r1, c1, area))
0167:     if not choices:
0168:         return 0
0169: 
0170:     r0, c0, r1, c1, area = random.choice(choices)
0171:     mask[r0 : r1 + 1, c0 : c1 + 1] = False
0172:     return int(area)
0173: 
0174: 
0175: def _make_notch_mask(h: int, w: int) -> np.ndarray | None:
0176:     area = h * w
0177:     max_remove = area - math.ceil(area * MIN_FILL_RATIO)
0178:     edges = []
0179:     if w >= OBJECT_W_MIN + 1:
0180:         edges.extend(["top", "bottom"])
0181:     if h >= OBJECT_H_MIN + 1:
0182:         edges.extend(["left", "right"])
0183:     if not edges or max_remove < 1:
0184:         return None
0185: 
0186:     mask = np.ones((h, w), dtype=bool)
0187:     edge = random.choice(edges)
0188:     edge_len = w if edge in {"top", "bottom"} else h
0189:     run = random.randint(1, min(edge_len - 2, max_remove))
0190:     start = random.randint(1, edge_len - run - 1)
0191: 
0192:     if edge in {"top", "bottom"}:
0193:         depth = random.randint(1, min(h - 1, max_remove // run))
0194:         if edge == "top":
0195:             mask[:depth, start : start + run] = False
0196:         else:
0197:             mask[h - depth :, start : start + run] = False
0198:     elif edge == "left":
0199:         depth = random.randint(1, min(w - 1, max_remove // run))
0200:         mask[start : start + run, :depth] = False
0201:     else:
0202:         depth = random.randint(1, min(w - 1, max_remove // run))
0203:         mask[start : start + run, w - depth :] = False
0204: 
0205:     removed = run * depth
0206:     removed += _carve_interior_rect(mask, max_remove - removed, NOTCH_INTERIOR_CARVE_PROB)
0207:     _carve_interior_rect(mask, max_remove - removed, EXTRA_CARVE_PROB)
0208:     if not _has_flanked_boundary_gap(mask):
0209:         return None
0210:     if not is_contiguous(mask.astype(int), background=0, connectivity=4):
0211:         return None
0212:     return mask
0213: 
0214: 
0215: def _make_closed_mask(h: int, w: int) -> np.ndarray | None:
0216:     area = h * w
0217:     mask = np.ones((h, w), dtype=bool)
0218:     max_remove = area - math.ceil(area * MIN_FILL_RATIO)
0219:     probability = CLOSED_CARVE_PROB_LARGE if area >= CLOSED_LARGE_AREA_MIN else CLOSED_CARVE_PROB_SMALL
0220:     removed = _carve_interior_rect(mask, max_remove, probability)
0221:     _carve_interior_rect(mask, max_remove - removed, EXTRA_CARVE_PROB)
0222:     if _has_flanked_boundary_gap(mask):
0223:         return None
0224:     if not is_contiguous(mask.astype(int), background=0, connectivity=4):
0225:         return None
0226:     return mask
