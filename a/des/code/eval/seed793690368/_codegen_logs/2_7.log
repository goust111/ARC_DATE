0062:     path_labels, n_paths = label_mask(g == path_color, connectivity=4)
0063:     assert n_paths == 2, "expected two path components"
0064: 
0065:     channel = g != path_color
0066:     for label_id in range(1, n_paths + 1):
0067:         channel &= binary_dilation(path_labels == label_id, structure=STRUCT8)
