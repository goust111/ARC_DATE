0371: def _is_8_connected(cells):
0372:     """Check 8-connectivity of a set of cells via BFS."""
0373:     if len(cells) <= 1:
0374:         return True
0375:     cell_set = set(cells)
0376:     start = next(iter(cell_set))
0377:     visited = {start}
0378:     queue = deque([start])
0379:     while queue:
0380:         r, c = queue.popleft()
0381:         for dr in (-1, 0, 1):
0382:             for dc in (-1, 0, 1):
0383:                 if dr == 0 and dc == 0:
0384:                     continue
0385:                 nb = (r + dr, c + dc)
0386:                 if nb in cell_set and nb not in visited:
0387:                     visited.add(nb)
0388:                     queue.append(nb)
0389:     return len(visited) == len(cell_set)
