0025:     bg = int(get_bg(g))
0026:     out = g.copy()
0027:     h, w = g.shape
0028: 
0029:     markers: dict[int, int] = {}
0030:     marker_source_cells: dict[int, set[tuple[int, int]]] = {}
0031:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format="dict"):
0032:         r0, c0, r1, c1 = comp["bbox"]
