+    row_spans: list[tuple[int, int]] = info["row_spans"]  # type: ignore[assignment]
+    col_spans: list[tuple[int, int]] = info["col_spans"]  # type: ignore[assignment]
+    cell_h = int(info["cell_h"])
+    cell_w = int(info["cell_w"])
