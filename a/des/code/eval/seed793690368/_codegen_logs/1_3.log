+
+BG = 0
+FRAME = 5
+NON_FRAME_COLORS = tuple(color for color in range(1, 10) if color != FRAME)
+GRID_SHAPES = (
+    (2, 2),
+    (2, 3),
+    (2, 4),
+    (3, 2),
+    (3, 3),
+    (3, 4),
+    (4, 2),
+    (4, 3),
