+def _neighbors4(shape: tuple[int, int], cell: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = cell
+    out: list[tuple[int, int]] = []
+    for dr, dc in DIRS4:
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < shape[0] and 0 <= cc < shape[1]:
