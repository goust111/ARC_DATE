+    grid[frame_r : frame_r + frame_h, frame_c] = GREY
+    grid[frame_r : frame_r + frame_h, frame_c + frame_w - 1] = GREY
+
+    expected = _render_output(masks, colors, stamp_h, stamp_w)
+    if np.array_equal(main(grid), expected):
+        return grid
+    return None
+
