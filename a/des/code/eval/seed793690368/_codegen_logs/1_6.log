+    _draw_segment(canvas, turn1, turn2)
+    _draw_segment(canvas, turn2, end)
+    return canvas
+
+
+def _random_symmetry(grid: np.ndarray) -> np.ndarray:
+    out = np.rot90(grid, random.randrange(4)).copy()
