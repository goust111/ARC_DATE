+    out_a = patch_a.copy()
+    out_b = patch_b.copy()
+    for src, dst in zip(colors_a, colors_b):
+        out_a[patch_a == src] = dst
+    for src, dst in zip(colors_b, colors_a):
+        out_b[patch_b == src] = dst
