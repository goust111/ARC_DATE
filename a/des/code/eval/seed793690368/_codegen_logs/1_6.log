+                        queue.append((nr, nc))
+
+            coord_arr = np.array(coords, dtype=int)
+            r0, c0 = coord_arr.min(axis=0)
+            r1, c1 = coord_arr.max(axis=0)
+            comps.append(
+                {
+                    "coords": coord_arr,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                }
+            )
+
+    return comps
