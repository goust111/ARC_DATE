+
+def _components(mask: np.ndarray) -> list[dict]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+
+            queue: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+
+            while queue:
+                cr, cc = queue.popleft()
+                coords.append((cr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+
+            coord_arr = np.array(coords, dtype=int)
+            r0, c0 = coord_arr.min(axis=0)
+            r1, c1 = coord_arr.max(axis=0)
+            comps.append(
+                {
+                    "coords": coord_arr,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                }
+            )
+
+    return comps
+
+
+def _object_components(grid: np.ndarray, bg: int) -> tuple[list[dict], np.ndarray]:
+    mask = (grid != bg) & (grid != LINE_COLOR)
+    comps = _components(mask)
+    labels = np.full(grid.shape, -1, dtype=int)
+    objects: list[dict] = []
+
+    for idx, comp in enumerate(comps):
+        r0, c0, r1, c1 = comp["bbox"]
+        patch = grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+        side = int(r1 - r0 + 1)
