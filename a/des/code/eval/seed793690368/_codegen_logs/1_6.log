+BG_COLOR = 0
+LINE_COLOR = 5
+OBJECT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+SQUARE_SIZES = (3, 4)
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
