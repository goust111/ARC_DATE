+
+def _write_patch(grid: np.ndarray, bbox: tuple[int, int, int, int], patch: np.ndarray) -> None:
+    r0, c0, r1, c1 = bbox
+    assert patch.shape == (r1 - r0 + 1, c1 - c0 + 1)
