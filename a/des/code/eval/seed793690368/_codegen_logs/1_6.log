+        assert patch.shape[0] == patch.shape[1] and side in SQUARE_SIZES
+        assert int(comp["coords"].shape[0]) == side * side
+        assert np.all(patch != bg) and np.all(patch != LINE_COLOR)
+
+        for r, c in comp["coords"]:
+            labels[int(r), int(c)] = idx
+
+        objects.append(
+            {
+                "coords": comp["coords"],
+                "bbox": comp["bbox"],
+                "patch": patch,
+                "side": side,
