+    max_h = max(int(mask.shape[0]) for mask in slot_masks)
+    max_w = max(int(mask.shape[1]) for mask in slot_masks)
+    cell_h = max(4, max_h + random.randint(0, 1))
+    cell_w = max(4, max_w + random.randint(0, 1))
+    gap = 1
