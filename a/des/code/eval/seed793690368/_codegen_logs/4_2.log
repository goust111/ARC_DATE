+    }
+
+    expected = template.copy()
+    for piece, hole in zip(pieces, holes):
+        hr0, hc0, hr1, hc1 = hole["bbox"]
+        patch = expected[hr0 : hr1 + 1, hc0 : hc1 + 1]
+        patch[hole["mask"]] = int(piece["color"])
+        expected[hr0 : hr1 + 1, hc0 : hc1 + 1] = patch
