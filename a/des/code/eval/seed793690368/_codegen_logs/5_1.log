+def _transform_mask(mask: np.ndarray, rng: random.Random) -> np.ndarray:
+    out = mask.copy()
+    if rng.random() < 0.5:
+        out = np.flipud(out)
+    if rng.random() < 0.5:
+        out = np.fliplr(out)
+    for _ in range(rng.randrange(4)):
+        out = np.rot90(out)
+    return out.copy()
+
+
+def _random_polyomino(area: int, rng: random.Random) -> np.ndarray:
+    cells = {(0, 0)}
+    while len(cells) < area:
+        frontier = set()
+        for r, c in cells:
+            for dr, dc in DIR4:
+                nxt = (r + dr, c + dc)
+                if nxt not in cells:
+                    frontier.add(nxt)
+        cells.add(rng.choice(list(frontier)))
+    return _transform_mask(_normalize(cells), rng)
