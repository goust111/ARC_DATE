+    regions: list[np.ndarray] = []
+    for i, (r0, c0, r1, c1) in enumerate(frames):
+        region = np.zeros((h, w), dtype=bool)
+        region[r0 + 1 : r1, c0 + 1 : c1] = True
+        if i + 1 < len(frames):
+            nr0, nc0, nr1, nc1 = frames[i + 1]
+            region[nr0 : nr1 + 1, nc0 : nc1 + 1] = False
+        regions.append(region)
+    return regions
