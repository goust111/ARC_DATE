+        r0, c0, r1, c1 = cell["bbox_rel"]
+        out[r0 : r1 + 1, c0 : c1 + 1] = tile["color"]
+        mr, mc = cell["marker_rel"]
+        out[mr, mc] = tile["color"]
+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    bg = random.choice(PALETTE)
