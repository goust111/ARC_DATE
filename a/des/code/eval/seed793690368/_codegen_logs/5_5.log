+        cell_h = r1 - r0 + 1
+        cell_w = c1 - c0 + 1
+        if random.randrange(2):
+            k = random.choice([1, 3])
+            tile_h, tile_w = cell_w, cell_h
+        else:
+            k = random.choice([0, 2])
+            tile_h, tile_w = cell_h, cell_w
