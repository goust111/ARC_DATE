+# --------------- generator ---------------
+
+PALETTE = [0, 1, 2, 3, 4, 6, 7]
+GRID_MIN = 22
+GRID_MAX = 30
+CELL_COUNT_RANGE = (2, 5)
+CELL_SPAN_RANGE = (2, 5)
