+        matches = []
+        for marker in tile_markers:
+            side = _tile_side(marker, (r0, c0, r1, c1))
+            if side is not None:
+                matches.append((marker, side))
+        assert len(matches) == 1, "each tile must have exactly one marker"
+        marker, side = matches[0]
+        tile = {
+            "color": int(color),
+            "bbox": (r0, c0, r1, c1),
+            "shape": (h, w),
+            "marker": marker,
+            "side": int(side),
