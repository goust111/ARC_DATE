+        else:
+            divider = random.randint(frame_h + 2 * MIN_FRAME_MARGIN, h - MIN_TILE_BAND - 1)
+        return h, w, divider_axis, frame_on_positive_side, divider
+    raise RuntimeError("failed to size canvas")
+
+
+def _frame_origin(
+    h: int,
+    w: int,
