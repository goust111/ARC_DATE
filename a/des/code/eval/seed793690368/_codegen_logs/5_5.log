+
+
+def _most_common_color(g: np.ndarray) -> int:
+    counts = Counter(map(int, g.reshape(-1)))
+    return int(max(counts.items(), key=lambda item: item[1])[0])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        seen[r, c] = True
+        queue = deque([(r, c)])
+        coords = []
+        while queue:
+            cr, cc = queue.popleft()
+            coords.append((cr, cc))
+            for dr, dc in DIR4:
+                nr = cr + dr
+                nc = cc + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+        comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _midpoint_offset(length: int) -> int:
+    return int((length - 1) // 2)
+
+
+def _inside(box: tuple[int, int, int, int], pt: tuple[int, int]) -> bool:
+    r0, c0, r1, c1 = box
+    r, c = pt
+    return r0 <= r <= r1 and c0 <= c <= c1
