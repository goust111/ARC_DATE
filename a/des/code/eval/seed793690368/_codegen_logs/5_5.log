+        return None
+
+    grid = np.full((h, w), bg, dtype=int)
+    if divider_axis == "h":
+        grid[divider, :] = GREY
+    else:
+        grid[:, divider] = GREY
+
+    frame = np.full((frame_h, frame_w), GREY, dtype=int)
