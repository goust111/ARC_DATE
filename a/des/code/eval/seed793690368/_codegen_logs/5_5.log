+            return h, w, divider_axis, frame_on_positive_side, divider
+        min_h = MIN_TILE_BAND + frame_h + 2 * MIN_FRAME_MARGIN + 1
+        min_w = max(GRID_MIN, frame_w + 2 * MIN_FRAME_MARGIN)
+        if min_h > GRID_MAX or min_w > GRID_MAX:
