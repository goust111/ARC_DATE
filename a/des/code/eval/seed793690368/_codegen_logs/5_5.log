+import numpy as np
+
+
+GREY = 5
+AZURE = 8
+MAROON = 9
+
+ROLE_COLORS = {GREY, AZURE, MAROON}
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDE_TO_DELTA = {
+    0: (-1, 0),  # top
+    1: (0, 1),   # right
+    2: (1, 0),   # bottom
+    3: (0, -1),  # left
