+def _make_order_panel(
+    colors: list[int], order_shape: tuple[int, int], rng: random.Random
+) -> tuple[np.ndarray, np.ndarray]:
+    order_rows, order_cols = order_shape
+    cell = 3
+    panel = np.full(
+        (order_rows * cell + (order_rows - 1), order_cols * cell + (order_cols - 1)),
+        SEP,
+        dtype=int,
