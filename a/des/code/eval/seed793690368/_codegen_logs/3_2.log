+    stamps: dict[int, np.ndarray] = {}
+    for idx, region in enumerate(regions):
+        if idx in (order_index, rotation_index):
+            continue
+        stamp = _extract_stamp(region)
+        assert stamp is not None, "failed to parse stamp region"
+        color, crop = stamp
