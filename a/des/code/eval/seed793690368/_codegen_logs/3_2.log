+def _rotation_from_marker(points: list[tuple[int, int]]) -> int | None:
+    pset = set(points)
+    for r, c in points:
+        dirs: set[str] = set()
+        if (r - 1, c) in pset:
+            dirs.add("U")
+        if (r + 1, c) in pset:
+            dirs.add("D")
+        if (r, c - 1) in pset:
+            dirs.add("L")
+        if (r, c + 1) in pset:
+            dirs.add("R")
+        if len(dirs) != 2:
+            continue
+        if dirs == {"U", "R"}:
+            return 0
+        if dirs == {"D", "R"}:
+            return 3
+        if dirs == {"D", "L"}:
+            return 2
+        if dirs == {"U", "L"}:
+            return 1
+    return None
