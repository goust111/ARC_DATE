+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Read stamp identity, rotation, and order from separate regions and assemble the rotated stamps.
+    """
+    g = np.asarray(grid, dtype=int)
+    order, rotations, stamps = _analyze_grid(g)
