+    crop = region[r0 : r1 + 1, c0 : c1 + 1].copy()
+    colors = crop[(crop != BG) & (crop != SEP)]
+    if colors.size == 0:
+        return None
+    color = Counter(map(int, colors.tolist())).most_common(1)[0][0]
