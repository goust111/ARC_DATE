+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if visited[r, c]:
+            continue
+        cells = _component_from(grid, (r, c), visited, mask)
+        comps.append({"color": int(grid[r, c]), "cells": cells})
