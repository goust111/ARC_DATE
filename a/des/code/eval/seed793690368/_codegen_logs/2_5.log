+                continue
+            r0 = random.randint(top_min, max_r0)
+            c0 = random.randint(left_min, max_c0)
+            global_cells = [(r0 + r, c0 + c) for r, c in local_cells]
+            gr0, gc0, gr1, gc1 = _bbox(global_cells)
