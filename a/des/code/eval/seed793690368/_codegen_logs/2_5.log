+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(height - 1, r1 + pad)
+    cc1 = min(width - 1, c1 + pad)
+    return not bool(blocked[rr0 : rr1 + 1, cc0 : cc1 + 1].any())
