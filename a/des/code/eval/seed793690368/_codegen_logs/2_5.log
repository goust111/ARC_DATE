+    q = deque([start])
+    visited[start] = True
+    color = int(grid[start])
+    cells: list[tuple[int, int]] = []
+    height, width = grid.shape
+
+    while q:
+        r, c = q.popleft()
+        cells.append((r, c))
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < height and 0 <= nc < width and not visited[nr, nc]:
+                if allowed[nr, nc] and int(grid[nr, nc]) == color:
