   587	    height = random.randint(*GRID_HEIGHT_RANGE)
   588	    width = random.randint(max(GRID_WIDTH_RANGE[0], legend_width + 4), GRID_WIDTH_RANGE[1])
   589	    corner = random.choice(LEGEND_CORNERS)
   590	
   591	    grid = np.zeros((height, width), dtype=int)
   592	    legend_cells = _place_legend(grid, corner, pairs)
   593	
   594	    region_count = random.randint(*REGION_COUNT_RANGE)
   595	    plans = _build_region_plans(soil_to_seeds, region_count)
   596	    regions = _place_regions(grid, corner, plans)
   597	    if regions is None:
