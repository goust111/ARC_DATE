+
+    return placed
+
+
+def _render_grid(height: int, width: int, targets: list[dict], arrows: list[dict]) -> np.ndarray:
+    grid = np.full((height, width), BG, dtype=int)
+    for target in targets:
+        for r, c in target["pixels"]:
+            grid[r, c] = GREY
+    for arrow in arrows:
+        for r, c in arrow["cells"]:
