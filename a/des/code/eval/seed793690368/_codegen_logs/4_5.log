+        for r, c in target["pixels"]:
+            grid[r, c] = GREY
+    for arrow in arrows:
+        for r, c in arrow["cells"]:
+            grid[r, c] = int(arrow["color"])
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATOR_RETRY_LIMIT):
