+        patch = out[r0 : r1 + 1, c0 : c1 + 1].copy()
+        for op in ops:
+            patch = _transform_patch(patch, op["color"])
+        region = out[r0 : r1 + 1, c0 : c1 + 1]
+        region[:] = BG
+        region[patch != BG] = patch[patch != BG]
+
+    return out
