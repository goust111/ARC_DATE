+
+
+def _ray_target(
+    shape: tuple[int, int],
+    target_at: dict[tuple[int, int], int],
+    head: tuple[int, int],
+    direction: tuple[int, int],
+) -> tuple[int, int]:
+    h, w = shape
+    r, c = head
+    dr, dc = direction
+    dist = 0
+    while True:
+        r += dr
+        c += dc
+        dist += 1
+        if not (0 <= r < h and 0 <= c < w):
