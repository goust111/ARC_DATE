+def _make_branch(rng: random.Random) -> dict | None:
+    for _ in range(80):
+        depths = [rng.choice((1, 2, 2, 3)), rng.choice((1, 1, 2, 3))]
+        children = []
+        ok = True
+        for depth in depths:
+            child = _make_chain(rng, depth)
+            if child is None:
