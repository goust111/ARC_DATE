+    gaps_col = [rng.randint(2, 4) for _ in range(max(0, len(order) - 1))]
+    total_h = sum(patch["h"] for patch in order) + sum(gaps_col)
+    max_w = max(patch["w"] for patch in order)
+    if total_h + 2 <= MAX_GRID_SIZE and max_w + 2 <= MAX_GRID_SIZE:
