+    gaps_row = [rng.randint(2, 4) for _ in range(max(0, len(order) - 1))]
+    total_w = sum(patch["w"] for patch in order) + sum(gaps_row)
+    max_h = max(patch["h"] for patch in order)
+    if total_w + 2 <= MAX_GRID_SIZE and max_h + 2 <= MAX_GRID_SIZE:
