+def _wrap_subtree(rng: random.Random, child: dict) -> dict | None:
+    for _ in range(40):
+        top = rng.randint(1, 2)
+        bottom = rng.randint(1, 2)
+        left = rng.randint(1, 2)
+        right = rng.randint(1, 2)
+        h = child["h"] + top + bottom + 2
