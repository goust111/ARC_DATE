+def paste_patch(grid: np.ndarray, occupied: np.ndarray, patch: np.ndarray, top: int, left: int):
+    ph, pw = patch.shape
+    mask = patch != BG
+    view = grid[top : top + ph, left : left + pw]
+    view[mask] = patch[mask]
