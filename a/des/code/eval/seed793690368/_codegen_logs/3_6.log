+        cargo_mask = interior_mask & (g != BG) & (~path_mask)
+        cargo_comps = mask_components(cargo_mask)
+        if not cargo_comps:
+            raise AssertionError("each loop must contain a cargo sprite")
+        cargo = max(cargo_comps, key=len)
