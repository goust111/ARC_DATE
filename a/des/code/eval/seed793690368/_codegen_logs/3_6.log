+    out = main(grid)
+    if out.shape != grid.shape:
+        return None
+    if np.any(out == YELLOW):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
