+            for top in range(1, h - ph - 1)
+            for left in range(1, w - pw - 1)
+            if can_place(occupied, patch, top, left)
+        ]
+        if not positions:
+            return None
+        top, left = rng.choice(positions)
+        paste_patch(grid, occupied, patch, top, left)
