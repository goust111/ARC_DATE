+    for side in sides[:bump_count]:
+        if side in ("top", "bottom"):
+            max_span = base_w - 2
+            if max_span < 2:
+                continue
+            span = rng.randint(2, max_span)
+            start = rng.randint(c0 + 1, c0 + base_w - span - 1)
+            depth = rng.randint(2, 4)
+            if side == "top":
+                rr0 = r0 - depth
+                if rr0 < 1:
