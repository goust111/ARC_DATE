+
+def neighbors4(r: int, c: int, h: int, w: int):
+    for dr, dc in DIR4:
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            yield rr, cc
+
+
+def neighbors8(r: int, c: int, h: int, w: int):
+    for dr, dc in DIR8:
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            yield rr, cc
+
+
+def right_of(direction: tuple[int, int]) -> tuple[int, int]:
+    dr, dc = direction
+    return dc, -dr
+
+
+def left_of(direction: tuple[int, int]) -> tuple[int, int]:
+    dr, dc = direction
+    return -dc, dr
+
+
+def mask_components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            dq = deque([(r, c)])
+            while dq:
+                rr, cc = dq.popleft()
+                comp.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        dq.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def color_component(grid: np.ndarray, color: int, start: tuple[int, int]) -> set[tuple[int, int]]:
+    h, w = grid.shape
+    comp = {start}
+    dq = deque([start])
+    while dq:
+        r, c = dq.popleft()
+        for nr, nc in neighbors4(r, c, h, w):
+            if int(grid[nr, nc]) == color and (nr, nc) not in comp:
+                comp.add((nr, nc))
+                dq.append((nr, nc))
+    return comp
+
+
+def flood_from_border(passable: np.ndarray) -> np.ndarray:
+    h, w = passable.shape
+    seen = np.zeros_like(passable, dtype=bool)
+    dq: deque[tuple[int, int]] = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if passable[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                dq.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if passable[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                dq.append((r, c))
+    while dq:
+        r, c = dq.popleft()
+        for nr, nc in neighbors4(r, c, h, w):
+            if passable[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                dq.append((nr, nc))
+    return seen
+
+
+def boundary_from_region(region: np.ndarray) -> np.ndarray:
+    h, w = region.shape
+    boundary = np.zeros_like(region, dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if not region[r, c]:
