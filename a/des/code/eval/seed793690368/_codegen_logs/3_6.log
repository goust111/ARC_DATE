+        if len(cargo_colors) != 1:
+            raise AssertionError("cargo must be monochrome")
+
+        loops.append(
+            {
+                "path_color": path_color,
+                "yellow": (yr, yc),
+                "cycle": cycle,
+                "path_mask": path_mask,
+                "interior_mask": interior_mask,
+                "cargo": cargo,
+                "cargo_color": next(iter(cargo_colors)),
