+            for nr, nc in neighbors4(r, c, h, w):
+                if not region[nr, nc]:
+                    boundary[r, c] = True
+                    break
+            else:
+                if r == 0 or c == 0 or r == h - 1 or c == w - 1:
+                    boundary[r, c] = True
+    return boundary
+
+
+def is_simple_cycle(path_mask: np.ndarray) -> bool:
