+def can_place(occupied: np.ndarray, patch: np.ndarray, top: int, left: int, pad: int = 2) -> bool:
+    h, w = occupied.shape
+    ph, pw = patch.shape
+    if top < 1 or left < 1 or top + ph >= h - 1 or left + pw >= w - 1:
+        return False
+    r0 = max(0, top - pad)
+    r1 = min(h, top + ph + pad)
+    c0 = max(0, left - pad)
+    c1 = min(w, left + pw + pad)
+    return not occupied[r0:r1, c0:c1].any()
