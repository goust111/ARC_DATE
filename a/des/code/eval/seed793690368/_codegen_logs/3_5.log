+    if not np.all(g[r0, c0 : c1 + 1] == GREY):
+        return False
+    if not np.all(g[r1, c0 : c1 + 1] == GREY):
+        return False
+    if not np.all(g[r0 : r1 + 1, c0] == GREY):
+        return False
+    if not np.all(g[r0 : r1 + 1, c1] == GREY):
