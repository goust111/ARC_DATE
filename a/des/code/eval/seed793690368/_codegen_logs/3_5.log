+    _paint_palette(g, bbox, order, mix)
+    return g
+
+
+def _validate_instance(
+    g: np.ndarray,
+    seeds: list[tuple[int, int, int]],
+    bbox: tuple[int, int, int, int],
+    mix: dict[tuple[int, int], int],
+    mode: str,
+) -> bool:
