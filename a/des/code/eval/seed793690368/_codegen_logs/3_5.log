+
+    row_headers = [int(x) for x in inner[1:, 0]]
+    col_headers = [int(x) for x in inner[0, 1:]]
+    if len(set(row_headers)) != len(row_headers):
+        return False
+    if len(set(col_headers)) != len(col_headers):
