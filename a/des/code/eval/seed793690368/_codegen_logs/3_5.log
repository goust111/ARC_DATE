+    return True
+
+
+def _add_wall(
+    g: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    cells: list[tuple[int, int]],
+) -> bool:
+    if not _can_place_wall(g, bbox, cells):
+        return False
+    for r, c in cells:
+        g[r, c] = GREY
+    return True
