+    col_headers = [int(x) for x in inner[0, 1:]]
+    matrix = inner[1:, 1:]
+
+    row_index = {color: i for i, color in enumerate(row_headers)}
+    col_index = {color: i for i, color in enumerate(col_headers)}
+    colors = set(row_headers)
+
+    mix: dict[tuple[int, int], int] = {}
+    for a in colors:
+        for b in colors:
