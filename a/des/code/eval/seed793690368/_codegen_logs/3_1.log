+    used_anchors: dict[str, set[int]] = {"top": set(), "bottom": set(), "left": set(), "right": set()}
+    blocked: set[tuple[int, int]] = set()
+
+    order = list(range(len(shapes)))
+    order.sort(key=lambda i: max(shapes[i].shape), reverse=True)
+    for idx in order:
+        shape = shapes[idx]
+        side = sides[idx]
+        hole_count = holes[idx]
