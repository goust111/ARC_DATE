+                if side == "top"
+                else (grid_h - 1, track)
+                if side == "bottom"
+                else (track, 0)
+                if side == "left"
+                else (track, grid_w - 1)
+            )
+            top, left = _place_on_track(side, track, shape.shape[0], shape.shape[1], hole_count, grid_h, grid_w)
+            cells = _mask_cells(shape, top, left)
+            if cells & blocked:
