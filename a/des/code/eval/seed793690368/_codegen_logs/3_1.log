+        hi = min(grid_w - 2, grid_w - (shape_w - shape_w // 2))
+    else:
+        lo = max(1, shape_h // 2)
+        hi = min(grid_h - 2, grid_h - (shape_h - shape_h // 2))
+    if lo > hi:
+        return []
+    vals = list(range(int(lo), int(hi) + 1))
+    random.shuffle(vals)
