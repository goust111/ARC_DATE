+    for color in [int(c) for c in np.unique(g) if int(c) != bg]:
+        color_cells = np.argwhere(g == color)
+        boundary_cells = [
+            (int(r), int(c))
+            for r, c in color_cells
+            if int(r) in (0, grid_h - 1) or int(c) in (0, grid_w - 1)
