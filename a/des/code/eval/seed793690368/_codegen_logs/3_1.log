+    r1, c1 = pts.max(axis=0)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _count_holes(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    holes = 0
+    for comp in _components(~mask, connectivity=4):
