+        top = 1 + hole_count
+        left = track - shape_w // 2
+    elif side == "bottom":
+        top = grid_h - 1 - hole_count - shape_h
+        left = track - shape_w // 2
+    elif side == "left":
+        top = track - shape_h // 2
+        left = 1 + hole_count
+    else:
+        top = track - shape_h // 2
+        left = grid_w - 1 - hole_count - shape_w
+    assert 0 <= top and 0 <= left
+    assert top + shape_h <= grid_h and left + shape_w <= grid_w
+    return int(top), int(left)
