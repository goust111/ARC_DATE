+def _anchor_side(anchor: tuple[int, int], h: int, w: int) -> str:
+    r, c = anchor
+    sides = []
+    if r == 0:
+        sides.append("top")
+    if r == h - 1:
+        sides.append("bottom")
+    if c == 0:
+        sides.append("left")
+    if c == w - 1:
+        sides.append("right")
+    assert len(sides) == 1, "anchor must lie on exactly one edge"
+    return sides[0]
+
