+        return "up"
+    if r == r1 and c0 < c < c1:
+        return "down"
+    if c == c0 and r0 < r < r1:
+        return "left"
+    if c == c1 and r0 < r < r1:
+        return "right"
+    return None
+
+
+def _room_from_component(
