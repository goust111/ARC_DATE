+    r1 = max(rows)
+    c0 = min(cols)
+    c1 = max(cols)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return None
+
+    boundary = _boundary_cells(r0, c0, r1, c1)
+    comp_set = set(comp)
+    if not comp_set.issubset(boundary):
+        return None
+
+    missing = list(boundary - comp_set)
+    if len(missing) != 1:
