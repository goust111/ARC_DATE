+        side = "bottom"
+    elif mc == 0 and 0 < mr < h - 1 and h % 2 == 1 and mr == h // 2:
+        side = "left"
+    elif mc == w - 1 and 0 < mr < h - 1 and h % 2 == 1 and mr == h // 2:
