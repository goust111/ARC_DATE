+def _random_path(
+    start: tuple[int, int], end: tuple[int, int], rng: random.Random
+) -> list[tuple[int, int]]:
+    r, c = start
+    er, ec = end
+    path = [(r, c)]
+    while (r, c) != (er, ec):
+        choices: list[tuple[int, int]] = []
+        if r < er:
