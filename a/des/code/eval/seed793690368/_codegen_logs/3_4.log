+    max_area = max(min_area, kh * kw - 1)
+
+    for _ in range(200):
+        anchors = [
+            (0, rng.randrange(kw)),
+            (kh - 1, rng.randrange(kw)),
+            (rng.randrange(kh), 0),
+            (rng.randrange(kh), kw - 1),
+        ]
+        rng.shuffle(anchors)
