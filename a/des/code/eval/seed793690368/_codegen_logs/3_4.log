+def _random_path(
+    start: tuple[int, int], end: tuple[int, int], rng: random.Random
+) -> list[tuple[int, int]]:
+    r, c = start
+    er, ec = end
+    path = [(r, c)]
+    while (r, c) != (er, ec):
+        choices: list[tuple[int, int]] = []
+        if r < er:
+            choices.append((r + 1, c))
+        elif r > er:
+            choices.append((r - 1, c))
+        if c < ec:
+            choices.append((r, c + 1))
+        elif c > ec:
+            choices.append((r, c - 1))
