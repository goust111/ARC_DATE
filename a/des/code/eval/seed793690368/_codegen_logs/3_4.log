+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in (
+                    (cr - 1, cc),
+                    (cr + 1, cc),
+                    (cr, cc - 1),
+                    (cr, cc + 1),
+                ):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _build_local_mask(points: list[tuple[int, int]]) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = _bbox(points)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in points:
+        mask[r - r0, c - c0] = True
+    return mask, (r0, c0, r1, c1)
+
+
+def _frame_info(
+    grid: np.ndarray, color: int, points: list[tuple[int, int]]
+) -> dict[str, Any] | None:
+    del color
+    mask, bbox = _build_local_mask(points)
+    r0, c0, r1, c1 = bbox
+    h, w = mask.shape
+    if h < 3 or w < 3:
+        return None
+
+    border = np.zeros_like(mask, dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+
+    if np.any(mask & ~border):
+        return None
+
+    missing = border & ~mask
+    if int(missing.sum()) != 1:
+        return None
+
+    mr, mc = map(int, np.argwhere(missing)[0])
+    abs_r, abs_c = r0 + mr, c0 + mc
+    if int(grid[abs_r, abs_c]) != MAROON:
+        return None
+
+    if mr == 0 and 0 < mc < w - 1 and w % 2 == 1 and mc == w // 2:
+        side = "top"
+    elif mr == h - 1 and 0 < mc < w - 1 and w % 2 == 1 and mc == w // 2:
+        side = "bottom"
+    elif mc == 0 and 0 < mr < h - 1 and h % 2 == 1 and mr == h // 2:
+        side = "left"
+    elif mc == w - 1 and 0 < mr < h - 1 and h % 2 == 1 and mr == h // 2:
+        side = "right"
+    else:
+        return None
+
+    expected_count = 2 * (h + w) - 4 - 1
+    if len(points) != expected_count:
+        return None
+
+    return {
+        "bbox": bbox,
+        "side": side,
+        "marker": (abs_r, abs_c),
+    }
+
