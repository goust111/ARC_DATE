                if (rk, ck) in used:
                    continue
                positions[k] = (rk, ck)
                used.add((rk, ck))
                placed = True
                break
            if not placed:
                ok = False
                break
        if ok:
            return [(int(r), int(c)) for r, c in positions if r is not None and c is not None]
    return None


