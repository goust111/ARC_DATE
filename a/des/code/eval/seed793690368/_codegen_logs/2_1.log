+    grid[frame_top + frame_h - 1, frame_left : frame_left + frame_w] = FRAME
+    grid[frame_top : frame_top + frame_h, frame_left] = FRAME
+    grid[frame_top : frame_top + frame_h, frame_left + frame_w - 1] = FRAME
