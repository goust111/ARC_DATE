+    return None
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    count = rng.randint(2, 5)
+    overlap_mode = rng.random() < 0.5
+    colors = rng.sample(COLOR_POOL, count)
+    legend_order = rng.sample(colors, len(colors))
