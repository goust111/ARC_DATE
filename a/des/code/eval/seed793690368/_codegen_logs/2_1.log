        i_contains_j = ri <= rj and ci <= cj and ri + hi >= rj + hj and ci + wi >= cj + wj
        j_contains_i = rj <= ri and cj <= ci and rj + hj >= ri + hi and cj + wj >= ci + wi
        if i_contains_j or j_contains_i:
            continue

        positions: list[tuple[int, int] | None] = [None] * len(sizes)
        positions[i] = (ri, ci)
        positions[j] = (rj, cj)

        used = {(ri, ci), (rj, cj)}
