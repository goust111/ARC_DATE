+
+    expected = _render_expected(inner_h, inner_w, sizes_by_color, markers_by_color, legend_order)
+    if not np.array_equal(main(grid), expected):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
