+    rows = np.unique(coords[:, 0])
+    cols = np.unique(coords[:, 1])
+    if len(rows) == 1:
+        return "h", int(rows[0])
+    if len(cols) == 1:
+        return "v", int(cols[0])
+    raise AssertionError("mirror must be a straight maroon segment")
+
