+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Reflect each room's pattern across its maroon mirror, then recolor only the
+    reflected copy using the room's boundary color-pair legend.
+    """
+    g = np.asarray(grid, dtype=int)
