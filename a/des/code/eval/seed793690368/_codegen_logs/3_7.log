+    out = g.copy()
+
+    row_bounds, col_bounds = _boundary_indices(g)
+    for i in range(len(row_bounds) - 1):
+        for j in range(len(col_bounds) - 1):
+            r0, r1 = row_bounds[i], row_bounds[i + 1]
