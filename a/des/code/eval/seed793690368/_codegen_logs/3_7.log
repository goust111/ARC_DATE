+
+
+# --------------- generator ---------------
+
+GRID_SIDE_MAX = 30
+ROOM_SIZE_MIN = 7
+ROOM_SIZE_MAX = 10
+PATTERN_MIN_CELLS = 4
+PATTERN_MAX_CELLS = 8
