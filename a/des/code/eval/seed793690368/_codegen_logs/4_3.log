+
+def _axis(dr: int, dc: int) -> int:
+    return 0 if dc != 0 else 1
+
+
+def _split_dirs(dr: int, dc: int) -> list[tuple[int, int]]:
+    if dr != 0:
+        return [(0, -1), (0, 1)]
+    return [(-1, 0), (1, 0)]
