+import numpy as np
+
+
+BG = 0
+MIRROR = 4
+CROSS = 6
+TOWER_PALETTE = [1, 2, 3, 5, 7, 8, 9]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRIES = 300
