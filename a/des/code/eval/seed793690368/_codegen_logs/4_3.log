+            h_color = int(horiz[r, c])
+            v_color = int(vert[r, c])
+            if h_color != -1 and v_color != -1:
+                if h_color == v_color:
+                    out[r, c] = int(h_color)
+                    same_crosses.add((r, c))
+                else:
+                    out[r, c] = CROSS
+                    diff_crosses.add((r, c))
+            elif h_color != -1:
+                out[r, c] = int(h_color)
+            elif v_color != -1:
