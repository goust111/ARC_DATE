        cols = list(range(inner_w))
    elif side == "bottom":
        rows = list(range(inner_h // 2, inner_h))
        cols = list(range(inner_w))
    elif side == "left":
        rows = list(range(inner_h))
        cols = list(range(0, max(1, (inner_w + 1) // 2)))
