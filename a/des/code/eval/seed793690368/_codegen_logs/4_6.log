+        height = slot_rows * patch_h + (slot_rows + 1) * gap_h
+        width = slot_cols * patch_w + (slot_cols + 1) * gap_w
+        candidates.append((max(height, width), abs(height - width), slot_rows, slot_cols))
+    _, _, slot_rows, slot_cols = min(candidates)
