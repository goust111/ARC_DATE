+import math
+from collections import Counter, defaultdict
+
+import numpy as np
+
+
+BG = 0
+DEFAULT_MARKER = 2
+TEMPLATE_COLOR = 5
+BORDER_COLORS = (1, 3, 4, 6, 7, 8, 9)
+LAYOUT_OPTIONS = ((2, 2), (2, 3), (3, 3))
+CELL_SPAN_OPTIONS = (1, 3)
+MAX_GEN_ATTEMPTS = 300
+PATTERN_ATTEMPTS = 200
