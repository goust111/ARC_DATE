    if side == "bottom":
        return _key_cells(side, lock_top + thickness - 1, lock_left, length, pattern)
    if side == "left":
        return _key_cells(side, lock_top, lock_left - 1, length, pattern)
    return _key_cells(side, lock_top, lock_left + thickness - 1, length, pattern)


