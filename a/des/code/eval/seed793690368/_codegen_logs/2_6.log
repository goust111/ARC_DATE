            if pattern[c]:
                cells.append((top + 1, left + c))
    elif side == "bottom":
        for c in range(length):
            if pattern[c]:
                cells.append((top, left + c))
            cells.append((top + 1, left + c))
    elif side == "left":
        for r in range(length):
            cells.append((top + r, left))
            if pattern[r]:
                cells.append((top + r, left + 1))
    else:
        for r in range(length):
            if pattern[r]:
                cells.append((top + r, left))
            cells.append((top + r, left + 1))
    return cells


