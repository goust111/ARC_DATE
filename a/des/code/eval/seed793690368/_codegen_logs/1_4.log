+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = map(int, mask.shape)
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((int(cr), int(cc)))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _find_palette(grid: np.ndarray) -> tuple[list[int], np.ndarray]:
+    h, w = map(int, grid.shape)
+    candidates: list[tuple[int, int, list[int], np.ndarray]] = []
+
+    for comp in _components(grid == ORANGE):
+        rows = [r for r, _c in comp]
+        cols = [c for _r, c in comp]
+        r0, r1 = min(rows), max(rows)
+        c0, c1 = min(cols), max(cols)
+        bh = r1 - r0 + 1
+        bw = c1 - c0 + 1
+        if bw != 3 or bh < 3:
+            continue
+
+        sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+        border = np.zeros_like(sub, dtype=bool)
+        border[0, :] = True
+        border[-1, :] = True
+        border[:, 0] = True
+        border[:, -1] = True
+        if not np.array_equal(sub == ORANGE, border):
+            continue
+
+        colors = [int(v) for v in sub[1:-1, 1].tolist()]
+        if not colors:
+            continue
+
+        corner_distance = min(
+            r0 + c0,
+            r0 + (w - 1 - c1),
+            (h - 1 - r1) + c0,
+            (h - 1 - r1) + (w - 1 - c1),
