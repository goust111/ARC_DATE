+    choices = []
+    if r1 - r0 + 1 >= 2 * MIN_ROOM_H + 1:
+        choices.append("h")
+    if c1 - c0 + 1 >= 2 * MIN_ROOM_W + 1:
+        choices.append("v")
+    return choices
