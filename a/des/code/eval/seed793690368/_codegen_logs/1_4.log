+    for comp in _components(room_mask):
+        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in comp):
+            continue
+
+        windows = set()
+        for r, c in comp:
+            for nr, nc in _neighbors4(r, c):
