+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+ORANGE = 7
+AZURE = 8
+PALETTE_POOL = (1, 2, 3, 4, 6, 9)
+
+GEN_RETRIES = 400
+GRID_MIN = 18
+GRID_MAX = 30
+PALETTE_LEN_RANGE = (2, 5)
+PLAN_H_RANGE = (10, 18)
+PLAN_W_RANGE = (10, 18)
+MIN_ROOM_H = 3
+MIN_ROOM_W = 3
+MAX_TARGET_ROOMS = 7
