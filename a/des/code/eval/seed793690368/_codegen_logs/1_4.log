+def _choose_windows(segments: list[list[tuple[int, int]]], count: int) -> list[tuple[int, int]]:
+    capacities = [_segment_capacity(segment) for segment in segments]
+    assert sum(capacities) >= count
+
+    order = list(range(len(segments)))
