            + [(-1, shaft_len), (0, shaft_len + 1), (1, shaft_len)]
        )
    if direction == "left":
        return (
            [(0, -dc) for dc in range(1, shaft_len + 1)]
            + [(-1, -shaft_len), (0, -shaft_len - 1), (1, -shaft_len)]
        )
    if direction == "down":
        return (
            [(dr, 0) for dr in range(1, shaft_len + 1)]
            + [(shaft_len, -1), (shaft_len + 1, 0), (shaft_len, 1)]
        )
    assert direction == "up"
    return (
