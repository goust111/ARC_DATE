+    border = _border_cells(r0, c0, r1, c1)
+    comp = set(coords)
+    if len(comp) != len(border) - 1 or not comp.issubset(border):
+        return None
+
+    missing = list(border - comp)
+    if len(missing) != 1:
+        return None
+    gap = missing[0]
