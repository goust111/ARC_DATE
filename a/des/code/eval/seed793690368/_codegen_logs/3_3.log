+    return out
+
+
+def _gap_direction(
+    gap: tuple[int, int],
+    r0: int,
+    c0: int,
+    r1: int,
+    c1: int,
+) -> tuple[int, int] | None:
+    gr, gc = gap
+    if gr == r0 and c0 < gc < c1:
+        return SIDE_TO_DIR["top"]
+    if gr == r1 and c0 < gc < c1:
+        return SIDE_TO_DIR["bottom"]
+    if gc == c0 and r0 < gr < r1:
+        return SIDE_TO_DIR["left"]
+    if gc == c1 and r0 < gr < r1:
