+    for fence in fences:
+        r0, c0, r1, c1 = fence["bbox"]
+        gap_r, gap_c = fence["gap"]
+        dr, dc = fence["direction"]
+        ray_color = int(fence["ray_color"])
+        ray_length = int(fence["count"])
