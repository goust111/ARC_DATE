+    r0, c0, r1, c1 = _bbox(outline_comp)
+    pr0 = max(0, r0 - 1)
+    pc0 = max(0, c0 - 1)
+    pr1 = min(grid.shape[0] - 1, r1 + 1)
+    pc1 = min(grid.shape[1] - 1, c1 + 1)
