+
+def _candidate_gap_positions(wall: np.ndarray, sub: np.ndarray, bg: int) -> list[tuple[int, int, str]]:
+    h, w = wall.shape
+    out: list[tuple[int, int, str]] = []
+    for r in range(h):
+        for c in range(w):
+            if sub[r, c] != bg or wall[r, c]:
