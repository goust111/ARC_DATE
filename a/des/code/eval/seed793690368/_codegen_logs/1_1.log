+def _is_connected(mask: np.ndarray) -> bool:
+    if int(np.sum(mask)) == 0:
+        return False
+    return len(_components(mask)) == 1
+
+
+def _interior(mask: np.ndarray) -> np.ndarray:
+    return mask & ~_boundary(mask)
