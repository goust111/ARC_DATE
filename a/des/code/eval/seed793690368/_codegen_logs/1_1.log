+def _rotate_patch_to_dir(patch: np.ndarray, native_dir: str, target_dir: str) -> np.ndarray:
+    delta = (DIR_TO_INDEX[target_dir] - DIR_TO_INDEX[native_dir]) % 4
+    return np.rot90(patch, -delta)
