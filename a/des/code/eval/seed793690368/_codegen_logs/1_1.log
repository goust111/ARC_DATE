+def _boundary(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = np.zeros_like(mask, dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                nr, nc = r + dr, c + dc
+                if not (0 <= nr < h and 0 <= nc < w) or not mask[nr, nc]:
+                    out[r, c] = True
+                    break
+    return out
