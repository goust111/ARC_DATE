+
+    try:
+        actual = _solve(grid)
+    except AssertionError:
+        return None
+
+    if not np.array_equal(actual, expected):
+        return None
+
+    if np.array_equal(actual, grid):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _gen_attempt()
+        if grid is not None:
