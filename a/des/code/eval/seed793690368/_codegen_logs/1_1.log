+            left = c > 0 and mask[r, c - 1]
+            right = c + 1 < w and mask[r, c + 1]
+            if direction == "up":
+                if (r == 0 or not mask[r - 1, c]) and down and left and right:
+                    candidates.append((r, c))
+            elif direction == "down":
