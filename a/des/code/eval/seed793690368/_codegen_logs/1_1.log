+                span_max = max(1, w - 4)
+                span = random.randint(1, span_max)
+                start = random.randint(1, w - span - 2)
+                depth = random.randint(1, min(2, h - 4))
+                rows = slice(0, depth) if side == "up" else slice(h - depth, h)
+                mask[rows, start : start + span] = False
+            else:
