+                if not (0 <= nr < interior_mask.shape[0] and 0 <= nc < interior_mask.shape[1] and interior_mask[nr, nc]):
+                    ok = False
+                    break
+                pts.append((nr, nc))
+            if ok:
+                seed = np.zeros_like(interior_mask, dtype=bool)
+                for nr, nc in pts:
+                    seed[nr, nc] = True
+                return seed
