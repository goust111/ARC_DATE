+    for r in range(h):
+        for c in range(w):
+            if sub[r, c] != bg or wall[r, c]:
+                continue
+            up = r > 0 and wall[r - 1, c]
+            down = r + 1 < h and wall[r + 1, c]
+            left = c > 0 and wall[r, c - 1]
+            right = c + 1 < w and wall[r, c + 1]
+            if left and right and not up and not down:
