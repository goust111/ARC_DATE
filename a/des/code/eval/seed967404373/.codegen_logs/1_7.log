+    if pos in sources:
+        return False
+    if side in HORIZONTAL_SIDES:
+        if not (1 <= index <= H - 2):
+            return False
+        used = row_sides.setdefault(index, set())
+        if side in used:
+            return False
+        used.add(side)
+    else:
+        if not (1 <= index <= W - 2):
+            return False
+        used = col_sides.setdefault(index, set())
+        if side in used:
+            return False
+        used.add(side)
