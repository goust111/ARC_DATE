48: def main(grid: np.ndarray) -> np.ndarray:
49:     """
50:     Cast yellow horizontal and vertical rays from the teal rectangle until blue blockers stop them.
51: 
52:     Input structure:
53:     - A black-background grid containing one solid teal rectangle.
54:     - Blue objects are blockers; other non-background objects may lie in the ray paths.
55:     - Yellow is absent from the input and is the output paint color.
56: 
57:     Rule:
58:     - From every row of the teal rectangle, cast rays left and right to the grid edge.
59:     - From every column of the teal rectangle, cast rays up and down to the grid edge.
60:     - A ray stops before a blue pixel; all crossed non-blue, non-teal pixels become yellow.
61: 
62:     Key insight:
63:     The teal rectangle defines a full cross-shaped projection, while blue objects are walls and red/background cells are simply paintable space.
64:     """
65:     g = np.asarray(grid, dtype=int)
66:     assert g.ndim == 2
67:     assert _PAINT_COLOR not in set(map(int, np.unique(g)))
68:     assert _BLOCK_COLOR in set(map(int, np.unique(g)))
69: 
70:     r0, c0, r1, c1 = _solid_source_bbox(g)
71:     fillable = set(map(int, np.unique(g))) - {_SOURCE_COLOR, _BLOCK_COLOR}
72: 
73:     out = g.copy()
74:     for r in range(r0, r1 + 1):
75:         _paint_ray(g, out, r, c0 - 1, 0, -1, fillable)
76:         _paint_ray(g, out, r, c1 + 1, 0, 1, fillable)
77: 
78:     for c in range(c0, c1 + 1):
79:         _paint_ray(g, out, r0 - 1, c, -1, 0, fillable)
80:         _paint_ray(g, out, r1 + 1, c, 1, 0, fillable)
81: 
82:     return out
83: 
