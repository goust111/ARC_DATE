+    grid = _build_grid(H, W, sources, blocker_mask)
+    return grid if _generator_accepts(grid, target, expected_color) else None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
