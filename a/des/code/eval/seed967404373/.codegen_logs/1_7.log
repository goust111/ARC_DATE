+    for r, c in cells:
+        if r <= 0 or r >= H - 1 or c <= 0 or c >= W - 1:
+            return False
+        if blocker_mask[r, c]:
+            return False
+        if (r, c) in forbidden_cells or r in forbidden_rows or c in forbidden_cols:
+            return False
