60: def _sample_sprite(color: int) -> np.ndarray | None:
61:     """Return one connected sprite that lands inside the configured pixel-count range."""
62:     bw = random.randint(*SPRITE_WIDTH_RANGE)
63:     bh = random.randint(*SPRITE_HEIGHT_RANGE)
64:     max_px = bw * bh
65:     min_px = max(SPRITE_PIXEL_RANGE[0], bw + bh - 1)
66:     max_target_px = min(SPRITE_PIXEL_RANGE[1], max_px)
67:     if min_px > max_target_px:
68:         return None
69:     target_px = random.randint(min_px, max_target_px)
70:     density = target_px / max_px
71:     for _ in range(SPRITE_RETRIES):
72:         try:
73:             sprite = random_sprite(bh, bw, density=density, color_palette=[color],
74:                                    connectivity=SPRITE_CONNECTIVITY, background=BG,
75:                                    symmetry=SPRITE_SYMMETRY)
76:         except Exception:
77:             continue
78:         px = int(np.sum(sprite != BG))
79:         if SPRITE_PIXEL_RANGE[0] <= px <= SPRITE_PIXEL_RANGE[1]:
80:             return sprite
81:     return None
