+    if 1 < r < H - 1:
+        options.append(((r - 1, c), (r, c)))
+    return options
+
+
+def _neighbors4(r: int, c: int) -> Iterable[Tuple[int, int]]:
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _edge_sources(grid: np.ndarray) -> List[Tuple[int, int, str, int]]:
+    g = np.asarray(grid, dtype=int)
