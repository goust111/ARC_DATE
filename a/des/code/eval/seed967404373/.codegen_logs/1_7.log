36: def main(grid: np.ndarray) -> np.ndarray:
37:     """
38:     Drop the singleton marker into the matching red U-shaped container, or make a bottom-row puddle if no closed container is hit.
39: 
40:     Input structure
41:     - The grid has a dominant background, one singleton marker pixel on the top row,
42:       and one other foreground color forming vertical bars and bottom segments.
43:     - A closed container is a U shape: two vertical side bars with a continuous
44:       bottom segment between them and an empty rectangular interior above the bottom.
45: 
46:     Rule
47:     - Remove the top marker from its original cell.
48:     - If exactly one closed U-shaped container has the marker column within its
49:       horizontal footprint, fill that container's empty interior with the marker color.
50:     - If no closed container is under the marker column, fill the whole bottom row
51:       with the marker color.
52: 
53:     Key insight
54:     - The marker does not identify a color by value; it identifies a vertical drop
55:       column, and only a structurally closed U shape can catch and contain the fill.
56:     """
57:     g = np.asarray(grid, dtype=int)
58:     assert g.ndim == 2
59: 
60:     bg = get_bg(g)
61:     foreground_colors = colors_present(g, exclude={bg})
62:     assert len(foreground_colors) == 2, "expected marker and wall colors"
63: 
64:     singleton_colors = [color for color in foreground_colors if int(np.count_nonzero(g == color)) == 1]
65:     assert len(singleton_colors) == 1, "expected exactly one singleton marker color"
66:     marker_color = singleton_colors[0]
67: 
68:     wall_colors = [color for color in foreground_colors if color != marker_color]
69:     assert len(wall_colors) == 1
70:     wall_color = wall_colors[0]
71: 
72:     marker_coords = np.argwhere(g == marker_color)
73:     assert marker_coords.shape == (1, 2)
74:     marker_r, marker_c = map(int, marker_coords[0])
75:     assert marker_r == 0, "marker must sit on the top row"
76: 
77:     containers = [
78:         container
79:         for container in _closed_u_containers(g, wall_color, bg)
80:         if container[0] > marker_r and container[2] <= marker_c <= container[3]
81:     ]
82:     assert len(containers) <= 1, "marker column must select at most one closed container"
83: 
84:     out = g.copy()
85:     out[marker_r, marker_c] = bg
86:     if containers:
87:         top, bottom, left, right = containers[0]
88:         out[top:bottom, left + 1 : right] = marker_color
89:     else:
90:         assert np.all(out[-1, :] == bg), "missed marker should fall to an empty bottom row"
91:         out[-1, :] = marker_color
92:     return out
