+MAGENTA = 6
+ORANGE = 7
+MAROON = 9
+
+SOURCE_COLORS = (RED, BLUE, YELLOW)
+EDGE_SIDES = ("top", "bottom", "left", "right")
+HORIZONTAL_SIDES = ("left", "right")
+VERTICAL_SIDES = ("top", "bottom")
+
+COLOR_TO_BIT = {RED: 1, BLUE: 2, YELLOW: 4}
+BITS_TO_COLOR = {
+    1: RED,
+    2: BLUE,
+    4: YELLOW,
+    3: MAGENTA,
+    5: ORANGE,
+    6: GREEN,
+    7: MAROON,
