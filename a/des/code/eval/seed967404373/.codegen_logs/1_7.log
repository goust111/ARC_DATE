18: def main(grid: np.ndarray) -> np.ndarray:
19:     """
20:     Fold each straight red rod at its black marker, leaving the gray-anchored side fixed.
21: 
22:     Input structure:
23:     - The background is the dominant color.
24:     - Each foreground object is a straight horizontal or vertical 4-connected rod.
25:     - Each rod contains many pixels of one line color, one endpoint marker, and one
26:       interior control marker.
27: 
28:     Rule:
29:     - For every rod, keep the segment from the endpoint marker through the control
30:       marker unchanged.
31:     - Move the line-color tail on the far side of the control marker to a
32:       perpendicular ray starting next to that marker.
33:     - Choose the perpendicular direction with more space to the grid edge.
34: 
35:     Key insight:
36:     - The endpoint marker identifies the fixed side of the rod, while the control
37:       marker is the hinge; the tail folds into the larger open half-plane.
38:     """
39:     g = np.asarray(grid, dtype=int)
