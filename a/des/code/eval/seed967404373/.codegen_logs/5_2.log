+def _corner_views(arr: np.ndarray, size: int = 2) -> list[np.ndarray]:
+    return [
+        arr[:size, :size],
+        arr[:size, -size:],
+        arr[-size:, :size],
+        arr[-size:, -size:],
+    ]
