+    mask = {seed}
+    while len(mask) < target_area:
+        frontier = set()
+        for r, c in mask:
+            for dr, dc in DIRS4:
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < size and 0 <= nc < size and (nr, nc) not in forbidden and (nr, nc) not in mask:
