+
+            stop_reason = "dynamic_block" if int(g[nr, nc]) == BLACK else "static_block"
+            break
+
+        path_infos.append(
+            {
+                "color": int(start["color"]),
+                "painted": int(painted),
+                "teleports": int(teleports),
+                "stop_reason": stop_reason,
+            }
+        )
