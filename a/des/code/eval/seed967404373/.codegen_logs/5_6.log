+import random
+from typing import Any
+
+import numpy as np
+
+
+BLACK = 0
+MAROON = 9
+PATH_COLORS = [1, 2, 3, 4, 5, 6, 7, 8]
+MAX_GENERATION_ATTEMPTS = 400
