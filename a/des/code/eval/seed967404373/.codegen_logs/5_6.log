+    meta = {
+        "sequence": seq,
+        "strip_len": int(strip_len),
+        "starts": starts,
+        "paths": path_infos,
+        "portal_count": int(len(portal_pairs) // 2),
+        "total_teleports": int(sum(info["teleports"] for info in path_infos)),
+        "total_painted": int(sum(info["painted"] for info in path_infos)),
+    }
