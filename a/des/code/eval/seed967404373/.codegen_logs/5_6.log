+                good = []
+                for dr, dc in inward:
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < h and 0 <= nc < w and int(grid[nr, nc]) == int(color):
+                        good.append((dr, dc))
+                if len(good) != 1:
