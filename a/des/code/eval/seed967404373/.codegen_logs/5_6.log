+def _start_spec(side: str, coord: int, color: int, h: int, w: int) -> dict[str, Any]:
+    if side == "top":
+        border = (0, int(coord))
+        inner = (1, int(coord))
+        direction = (1, 0)
+    elif side == "bottom":
+        border = (h - 1, int(coord))
+        inner = (h - 2, int(coord))
+        direction = (-1, 0)
+    elif side == "left":
+        border = (int(coord), 0)
+        inner = (int(coord), 1)
+        direction = (0, 1)
+    else:
+        assert side == "right"
+        border = (int(coord), w - 1)
+        inner = (int(coord), w - 2)
+        direction = (0, -1)
+
+    return {
+        "side": side,
+        "coord": int(coord),
+        "color": int(color),
+        "border": border,
+        "inner": inner,
+        "dir": direction,
+    }
+
+
+def _paint_start(grid: np.ndarray, spec: dict[str, Any]) -> None:
+    color = int(spec["color"])
+    br, bc = spec["border"]
+    ir, ic = spec["inner"]
+    grid[br, bc] = color
+    grid[ir, ic] = color
