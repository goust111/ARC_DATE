+
+    out = g.copy()
+    path_infos: list[dict[str, Any]] = []
+
+    for start in starts:
+        cur_r, cur_c = map(int, start["inner"])
+        dr, dc = map(int, start["dir"])
+        cur_color = int(start["color"])
+        painted = 0
+        teleports = 0
+        stop_reason = "boundary"
+        seen: set[tuple[int, int, int]] = set()
+
+        while True:
