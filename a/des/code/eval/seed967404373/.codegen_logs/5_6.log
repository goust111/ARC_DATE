+
+def _dot_along(a: tuple[int, int], b: tuple[int, int], direction: tuple[int, int]) -> int:
+    dr, dc = direction
+    return int((a[0] - b[0]) * dr + (a[1] - b[1]) * dc)
+
+
+def _entry_candidates(
+    spec: dict[str, Any],
