+    if len(starts) > 2 and random.random() < 0.6:
+        secondary = random.choice(starts[1:])
+        extra_pair = _place_targeted_pair(
+            secondary,
+            grid.shape,
+            used_rows,
+            used_cols,
+            cross=None,
+            before_cross=None,
+            prefer_parallel=bool(random.getrandbits(1)),
+        )
+        if extra_pair is not None:
+            portal_pairs.append(extra_pair)
