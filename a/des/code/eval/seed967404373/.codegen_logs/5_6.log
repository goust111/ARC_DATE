+        early_coord = random.choice(bottom_cols)
+        cross_col = int(early_coord)
+    elif early_side == "left":
+        early_coord = random.choice(side_rows)
+        cross_row = int(early_coord)
+    else:
+        early_coord = random.choice(side_rows)
