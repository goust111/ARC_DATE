+                    continue
+
+                inward: list[tuple[int, int]] = []
+                if r == 0:
+                    inward.append((1, 0))
+                if r == h - 1:
+                    inward.append((-1, 0))
+                if c == 0:
+                    inward.append((0, 1))
+                if c == w - 1:
+                    inward.append((0, -1))
