+    strip_mask[0, :strip_len] = True
+
+    starts: list[dict[str, Any]] = []
+    for color in seq:
+        matches: list[dict[str, Any]] = []
+        for r in range(h):
+            for c in range(w):
+                if not (r in (0, h - 1) or c in (0, w - 1)):
+                    continue
+                if strip_mask[r, c]:
+                    continue
+                if int(grid[r, c]) != int(color):
+                    continue
+
+                inward: list[tuple[int, int]] = []
+                if r == 0:
+                    inward.append((1, 0))
+                if r == h - 1:
+                    inward.append((-1, 0))
+                if c == 0:
+                    inward.append((0, 1))
+                if c == w - 1:
+                    inward.append((0, -1))
+
+                good = []
+                for dr, dc in inward:
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < h and 0 <= nc < w and int(grid[nr, nc]) == int(color):
+                        good.append((dr, dc))
+                if len(good) != 1:
+                    continue
+
+                dr, dc = good[0]
+                matches.append(
+                    {
+                        "color": int(color),
+                        "border": (int(r), int(c)),
+                        "inner": (int(r + dr), int(c + dc)),
+                        "dir": (int(dr), int(dc)),
+                        "order": _perimeter_index(int(r), int(c), h, w),
+                    }
+                )
