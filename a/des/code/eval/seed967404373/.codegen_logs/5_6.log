+                    if (rr - er) * dr <= 0:
+                        continue
+                    nr = rr + dr
+                    if not (1 < nr < h - 1):
+                        continue
+                    candidates.append((int(rr), int(ec)))
+                if candidates:
+                    return random.choice(candidates), mode
+            else:
+                if er in used_rows or ec in used_cols:
+                    continue
+                candidates = []
+                for cc in range(2, w - 2):
+                    if cc == ec or cc in used_cols:
+                        continue
+                    if (cc - ec) * dc <= 0:
+                        continue
+                    nc = cc + dc
+                    if not (1 < nc < w - 1):
+                        continue
+                    candidates.append((int(er), int(cc)))
+                if candidates:
+                    return random.choice(candidates), mode
+        else:
+            if dr != 0:
+                if er in used_rows or ec in used_cols:
+                    continue
+                candidates = []
+                for cc in range(2, w - 2):
+                    if cc == ec or cc in used_cols:
+                        continue
+                    nr = er + dr
+                    if not (1 <= nr < h - 1):
+                        continue
+                    candidates.append((int(er), int(cc)))
+                if candidates:
+                    return random.choice(candidates), mode
+            else:
+                if er in used_rows or ec in used_cols:
