+    for r, c in body_pixels:
+        lanes[int(c)].append(int(r))
+    for c, rows in lanes.items():
+        rows.sort()
+        start = 0 if direction == "up" else height - len(rows)
+        for i, _row in enumerate(rows):
+            out.append((int(start + i), int(c)))
+    return out
