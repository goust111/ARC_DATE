+        extra = list(SIDES)
+        random.shuffle(extra)
+        sides.extend(extra)
+
+    for side in sides[:n_frames]:
+        inner_h, inner_w = _interior_size(side)
+        outer_h = inner_h + 2
+        outer_w = inner_w + 2
+        placed_here = False
+
+        for _ in range(PLACE_ATTEMPTS):
+            r0 = random.randint(1, h - outer_h - 1)
+            c0 = random.randint(1, w - outer_w - 1)
+            r1 = r0 + outer_h - 1
+            c1 = c0 + outer_w - 1
+            bbox = (r0, c0, r1, c1)
