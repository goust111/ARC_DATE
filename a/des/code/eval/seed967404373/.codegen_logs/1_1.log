+    for idx, frame in enumerate(frames):
+        r0, c0, r1, c1 = frame["bbox"]
+        interior = g[r0 + 1 : r1, c0 + 1 : c1]
+        if np.any((interior != bg) & (interior != int(frame["color"]))):
+            assert seed_index is None, "expected exactly one seed frame"
+            seed_index = idx
