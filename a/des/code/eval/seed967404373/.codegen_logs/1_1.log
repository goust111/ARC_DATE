+            return None
+        choice = candidates[int(rng.integers(len(candidates)))]
+        r0, c0 = choice
+        positions[idx] = choice
+        rr0 = max(0, r0 - 1)
+        cc0 = max(0, c0 - 1)
+        rr1 = min(interior_h, r0 + sh + 1)
+        cc1 = min(interior_w, c0 + sw + 1)
+        blocked[rr0:rr1, cc0:cc1] = True
