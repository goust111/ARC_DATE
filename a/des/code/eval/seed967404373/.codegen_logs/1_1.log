+def _render_frame(grid: np.ndarray, frame: dict) -> None:
+    r0 = frame["top"]
+    c0 = frame["left"]
+    outer_h = frame["outer_h"]
+    outer_w = frame["outer_w"]
+    color = frame["color"]
