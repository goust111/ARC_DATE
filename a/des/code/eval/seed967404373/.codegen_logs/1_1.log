+from __future__ import annotations
+
+from collections import deque
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+SEED_FRAME_COLOR = 5
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _background_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _monochrome_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coords = np.array(cells, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": int(len(cells)),
+                }
+            )
+    return comps
+
+
+def _is_rectangular_frame(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+
+    cells = {tuple(map(int, xy)) for xy in comp["coords"]}
+    if len(cells) != 2 * h + 2 * w - 4:
+        return False
+
+    for c in range(c0, c1 + 1):
+        if (r0, c) not in cells or (r1, c) not in cells:
+            return False
+    for r in range(r0, r1 + 1):
+        if (r, c0) not in cells or (r, c1) not in cells:
+            return False
+    return True
+
+
+def _connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if len(coords) == 0:
+        return False
+    start = tuple(map(int, coords[0]))
+    q = deque([start])
+    seen = {start}
+    h, w = mask.shape
+    while q:
+        r, c = q.popleft()
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def _extract_templates(grid: np.ndarray, seed_frame: dict, bg: int) -> dict[int, np.ndarray]:
+    r0, c0, r1, c1 = seed_frame["bbox"]
+    interior = grid[r0 + 1 : r1, c0 + 1 : c1]
