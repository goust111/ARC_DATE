def _grid_shape(
    seed_outer_h: int, seed_outer_w: int, frames: list[dict], rng: np.random.Generator
) -> tuple[int, int]:
    max_frame_w = max(frame["outer_w"] for frame in frames)
    total_frame_w = sum(frame["outer_w"] for frame in frames) + 4 * max(0, len(frames) - 1)
