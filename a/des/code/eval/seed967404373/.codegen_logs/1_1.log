+            continue
+        mask = interior == color
+        assert _connected(mask), "each template color must form a single connected seed shape"
+        coords = np.argwhere(mask)
+        sr0, sc0, sr1, sc1 = _bbox(coords)
+        templates[color] = mask[sr0 : sr1 + 1, sc0 : sc1 + 1].copy()
