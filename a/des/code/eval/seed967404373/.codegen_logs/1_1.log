+
+    non_bg_upper_bound = (2 * seed_outer_h + 2 * seed_outer_w - 4) + sum(int(shape.sum()) for _, shape in color_shapes)
+    non_bg_upper_bound += sum(2 * frame["outer_h"] + 2 * frame["outer_w"] - 4 for frame in frames)
