+    for (color, shape), (r0, c0) in zip(color_shapes, positions, strict=False):
+        sh, sw = shape.shape
+        region = grid[top + 1 + r0 : top + 1 + r0 + sh, left + 1 + c0 : left + 1 + c0 + sw]
