+        frame["outer_h"] - 2 != frame["shape"].shape[0] and frame["outer_w"] - 2 != frame["shape"].shape[1]
+        for frame in frames
+    ) and len(frames) > 1:
+        chosen = frames[int(rng.integers(len(frames)))]
+        chosen["outer_h"] += chosen["shape"].shape[0]
+        chosen["outer_w"] += chosen["shape"].shape[1]
