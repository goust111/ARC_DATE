+
+def _row_partition(items: list[dict], n_rows: int, rng: np.random.Generator) -> list[list[dict]]:
+    rows: list[list[dict]] = [[] for _ in range(n_rows)]
+    order = list(items)
+    rng.shuffle(order)
+    for item in order:
