+    for color, shape in color_shapes:
+        copies = int(rng.integers(1, 3))
+        for _ in range(copies):
+            sy = int(rng.integers(1, 4))
+            sx = int(rng.integers(1, 4))
+            frames.append(
+                {
+                    "color": color,
+                    "shape": shape,
+                    "outer_h": int(shape.shape[0] * sy + 2),
+                    "outer_w": int(shape.shape[1] * sx + 2),
