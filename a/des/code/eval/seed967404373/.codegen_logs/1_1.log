+    if all(frame["outer_h"] == frame["shape"].shape[0] + 2 and frame["outer_w"] == frame["shape"].shape[1] + 2 for frame in frames):
+        chosen = frames[int(rng.integers(len(frames)))]
+        if rng.random() < 0.5:
