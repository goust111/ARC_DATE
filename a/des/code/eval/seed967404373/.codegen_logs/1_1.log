+def _extract_templates(grid: np.ndarray, seed_frame: dict, bg: int) -> dict[int, np.ndarray]:
+    r0, c0, r1, c1 = seed_frame["bbox"]
+    interior = grid[r0 + 1 : r1, c0 + 1 : c1]
+    templates: dict[int, np.ndarray] = {}
+    for color0 in np.unique(interior):
