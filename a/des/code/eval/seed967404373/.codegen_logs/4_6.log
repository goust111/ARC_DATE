+    bbox, patch = _extract_patch(grid, coords)
+    mask = patch != BG
+    side, depth, profile = _detect_signature(mask, is_lock=is_lock)
+    return {
+        "bbox": bbox,
+        "patch": patch,
+        "coords": coords,
+        "side": side,
+        "depth": int(depth),
