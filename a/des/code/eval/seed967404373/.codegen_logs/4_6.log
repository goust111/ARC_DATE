+    patch = np.zeros((body + depth, len(profile)), dtype=int)
+    if side == "top":
+        patch[depth:, :] = int(color)
+        for c, bit in enumerate(profile):
+            if bit:
+                patch[:depth, c] = int(color)
+    else:
+        patch[:body, :] = int(color)
+        for c, bit in enumerate(profile):
+            if bit:
