+        zone_w_max = max(int(pair["zone_shape"][1]) for pair in pairs)
+        total_zone_area = sum(int(pair["zone_shape"][0]) * int(pair["zone_shape"][1]) for pair in pairs)
+        min_h = max(20, zone_h_max + 2)
+        min_w = max(20, zone_w_max + 2)
