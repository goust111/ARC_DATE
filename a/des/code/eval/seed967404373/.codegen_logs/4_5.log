        and mask[-1, :].any()
        and mask[:, 0].any()
        and mask[:, -1].any()
    )


def _random_connected_subset(allowed: np.ndarray, size: int) -> np.ndarray | None:
    coords = [tuple(map(int, cell)) for cell in np.argwhere(allowed)]
