from __future__ import annotations

import random

import numpy as np


BLACK = 0
BLUE = 1
MAROON = 9
PALETTE = (2, 3, 4, 5, 6, 7, 8)

MAX_GRID_SIDE = 30
MAX_GENERATION_ATTEMPTS = 400

LAYOUTS_BY_PAIR_COUNT = {
