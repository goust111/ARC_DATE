+def _rectangular(mask: np.ndarray) -> bool:
+    if not bool(mask.any()):
+        return False
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox(coords)
+    return int(mask.sum()) == (r1 - r0 + 1) * (c1 - c0 + 1)
