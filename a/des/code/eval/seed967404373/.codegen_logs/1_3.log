+
+def _ring_mask(h: int, w: int, t: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    mask[:t, :] = True
+    mask[-t:, :] = True
+    mask[:, :t] = True
+    mask[:, -t:] = True
+    return mask
