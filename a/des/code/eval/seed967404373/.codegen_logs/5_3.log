+    out = g.copy()
+    for coords in _components(g != GREY):
+        if _touches_boundary(coords, g.shape):
+            continue
+        seed, color, row_sign, col_sign = _seed_info(g, coords)
+        for r, c in _contiguous_shell_fill(coords, seed, row_sign, col_sign):
+            out[r, c] = color
+    return out
