+
+
+def _receiver_candidates(h: int, w: int, spec: dict, placed: list[dict]) -> list[tuple[int, int]]:
+    radius = int(spec["hits"]) - 1
+    min_r = radius + (2 if "up" in spec["dirs"] else 0)
