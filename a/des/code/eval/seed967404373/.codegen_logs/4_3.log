+        ir0, ic0, ir1, ic1 = r0 + 1, c0 + 1, r1 - 1, c1 - 1
+        interior = grid[ir0 : ir1 + 1, ic0 : ic1 + 1]
+        assert np.all(np.isin(interior, [ORANGE, RED])), "room interior may only contain background and arrows"
