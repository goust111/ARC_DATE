+ARROW_SHAPE = (2, 2)
+
+GEN_ATTEMPTS = 400
+ROOM_COUNT_CHOICES = (1, 2, 3)
+GRID_MIN = 22
+GRID_MAX = 30
+GAP_RANGE = (1, 4)
+DISTRACTOR_COUNT_CHOICES = (0, 1, 2)
