+        if color == BG:
+            continue
+        if color not in counts:
+            order.append(color)
+            counts[color] = 0
+        counts[color] += 1
+
+    assert len(order) == 2, "each frame must contain exactly two vote colors"
+    first, second = order
+    if counts[first] > counts[second]:
+        return first, second
+    if counts[second] > counts[first]:
+        return second, first
+    return first, second
