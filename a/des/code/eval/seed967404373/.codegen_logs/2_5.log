+def _can_place_triangle(
+    verts: tuple[tuple[int, int], tuple[int, int], tuple[int, int]],
+    mask: np.ndarray,
+    color: int,
+    placed: list[dict],
+    reserved: np.ndarray,
+    overlap_target: dict | None,
+) -> bool:
