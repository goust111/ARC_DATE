+def _legend_candidates(grid: np.ndarray) -> list[tuple[tuple[int, int], tuple[int, int]]]:
+    h, w = grid.shape
+    if h < 2:
+        return []
+
+    pairs = [
+        ((0, 0), (1, 0)),
+        ((0, w - 1), (1, w - 1)),
+        ((h - 2, 0), (h - 1, 0)),
+        ((h - 2, w - 1), (h - 1, w - 1)),
+    ]
+    candidates: list[tuple[tuple[int, int], tuple[int, int]]] = []
+    for top, bottom in pairs:
