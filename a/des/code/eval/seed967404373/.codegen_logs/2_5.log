+        verts = tuple(sorted({p0, p1, p2}))
+        if len(verts) != 3:
+            continue
+        if _triangle_area2(*verts) < 18:
+            continue
+        if min(abs(a[0] - b[0]) + abs(a[1] - b[1]) for a, b in combinations(verts, 2)) < 5:
+            continue
+
+        mask = _triangle_mask(shape, verts)
+        area = int(mask.sum())
+        if area < 12 or area > (h * w) // 4:
