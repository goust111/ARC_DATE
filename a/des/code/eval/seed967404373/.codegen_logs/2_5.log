+    grid = _construct_grid(shape, colors, priority_high_to_low, legend_cells, placed)
+    if not _validate_generated_instance(grid, colors, legend_cells, intended_groups, overlap_required):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
