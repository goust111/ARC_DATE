+def _pair_has_unique_assembly(mask_a: np.ndarray, color_a: int, mask_b: np.ndarray, color_b: int) -> bool:
+    candidates = _pair_candidates(mask_a, color_a, mask_b, color_b)
+    if not candidates:
+        return False
+    unique = {(tuple(cand["patch"].shape), cand["patch"].tobytes()) for cand in candidates}
+    return len(unique) == 1
