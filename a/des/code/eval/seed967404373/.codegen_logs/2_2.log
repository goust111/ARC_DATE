+    low = max(2, total // 3)
+    high = min(total - 2, total - total // 3)
+    if low > high:
+        low, high = 2, total - 2
+    targets = list(range(low, high + 1))
+    random.shuffle(targets)
+
+    for target in targets:
+        for _ in range(PARTITION_ATTEMPTS):
+            cells_a = _grow_connected_subset(h, w, target)
+            if len(cells_a) != target:
