+    @lru_cache(maxsize=None)
+    def solve(mask: int) -> tuple[tuple[int, int], ...] | None:
+        if mask == full_mask:
+            return ()
+        first = 0
+        while (mask >> first) & 1:
+            first += 1
+
+        best_keys = None
+        best_sig = None
+        for second in range(first + 1, n_comp):
+            if (mask >> second) & 1:
+                continue
+            key = (first, second)
+            if key not in pair_info:
