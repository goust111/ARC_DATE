+    max_h = max(patch.shape[0] for patch in input_patches)
+    max_w = max(patch.shape[1] for patch in input_patches)
+    min_side = max(18, max_h + 2, max_w + 2)
+
+    for _ in range(PLACEMENT_ATTEMPTS):
