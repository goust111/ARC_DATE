+    full_mask = (1 << n_comp) - 1
+
+    @lru_cache(maxsize=None)
+    def count(mask: int) -> int:
+        if mask == full_mask:
+            return 1
+        first = 0
+        while (mask >> first) & 1:
+            first += 1
+
