+                    continue
+                for r0 in range(out_h - ah + 1):
+                    for c0 in range(out_w - aw + 1):
+                        fill_a = np.zeros((out_h, out_w), dtype=bool)
+                        fill_a[r0 : r0 + ah, c0 : c0 + aw] = rot_a
+                        fill_b = ~fill_a
