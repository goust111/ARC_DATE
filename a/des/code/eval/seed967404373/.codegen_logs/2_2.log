+def _pack_output(patches: list[np.ndarray]) -> np.ndarray:
+    if not patches:
+        return np.zeros((1, 1), dtype=int)
+    height = max(int(patch.shape[0]) for patch in patches)
+    width = sum(int(patch.shape[1]) for patch in patches) + len(patches) - 1
