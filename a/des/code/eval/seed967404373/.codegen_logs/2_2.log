+def _assemble_expected(pair_records: list[dict]) -> np.ndarray:
+    ordered = sorted(pair_records, key=lambda rec: rec["patch"].size)
+    patches = [rec["patch"] for rec in ordered]
+    return _pack_output(patches)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    pair_count = random.randint(*PAIR_COUNT_RANGE)
+    color_pool = list(range(1, 10))
+    random.shuffle(color_pool)
+    if len(color_pool) < 2 * pair_count:
+        return None
