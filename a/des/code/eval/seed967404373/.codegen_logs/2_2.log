+    frontier.update(
+        (start[0] + dr, start[1] + dc)
+        for dr, dc in NEIGHBORS4
+        if 0 <= start[0] + dr < h and 0 <= start[1] + dc < w
+    )
+
+    while len(cells) < target and frontier:
