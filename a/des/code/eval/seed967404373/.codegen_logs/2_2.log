+            if (mask >> second) & 1:
+                continue
+            key = (first, second)
+            if key not in pair_info:
+                continue
+            rest = solve(mask | (1 << first) | (1 << second))
+            if rest is None:
+                continue
+            candidate = (key,) + rest
+            sig = _matching_signature(candidate, pair_info)
+            if best_sig is None or sig < best_sig:
+                best_sig = sig
+                best_keys = candidate
+        return best_keys
+
