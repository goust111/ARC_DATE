import random, numpy as np
DIR4=[(1,0),(-1,0),(0,1),(0,-1)]

def conn(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:return False
    h,w=mask.shape
    stack=[tuple(pts[0])]; seen={stack[0]}
    while stack:
        r,c=stack.pop()
        for dr,dc in DIR4:
            nr,nc=r+dr,c+dc
            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); stack.append((nr,nc))
    return len(seen)==len(pts)

def full(mask):
    rs,cs=np.where(mask)
    if len(rs)==0:return False
    return rs.min()==0 and rs.max()==mask.shape[0]-1 and cs.min()==0 and cs.max()==mask.shape[1]-1

def maze(n,m):
    H,W=2*n+1,2*m+1
    g=np.ones((H,W),dtype=bool)
    vis=[[False]*m for _ in range(n)]
    stack=[(0,0)]
    vis[0][0]=True
    g[1,1]=False
    while stack:
        r,c=stack[-1]
        nbr=[]
        for dr,dc in DIR4:
            nr,nc=r+dr,c+dc
            if 0<=nr<n and 0<=nc<m and not vis[nr][nc]:
                nbr.append((nr,nc,dr,dc))
        if not nbr:
            stack.pop(); continue
        nr,nc,dr,dc=random.choice(nbr)
        vis[nr][nc]=True
        g[2*r+1+dr,2*c+1+dc]=False
        g[2*nr+1,2*nc+1]=False
        stack.append((nr,nc))
    return g

