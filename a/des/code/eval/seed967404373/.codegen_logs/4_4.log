            if not connected(A2,h,w): continue
            seen.add(B2)
            bits2=side_bits(B2,h,w)
            pr=(4-bin(bits2).count('"'1'), len(B2))
            heapq.heappush(pq,(pr,B2))
    print('dims',h,w,'found',found is not None,'exp',expansions,'queue',len(pq), flush=True)
    if found:
