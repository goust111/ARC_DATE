import random, sys
import numpy as np

DIR4=[(1,0),(-1,0),(0,1),(0,-1)]

def conn(mask):
    h,w=mask.shape
    pts=[(r,c) for r in range(h) for c in range(w) if mask[r,c]]
    if not pts:return False
    seen={pts[0]}
    stack=[pts[0]]
    while stack:
        r,c=stack.pop()
        for dr,dc in DIR4:
            nr,nc=r+dr,c+dc
            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); stack.append((nr,nc))
    return len(seen)==len(pts)

def full_bbox(mask):
    rs,cs=np.where(mask)
    return rs.min()==0 and rs.max()==mask.shape[0]-1 and cs.min()==0 and cs.max()==mask.shape[1]-1

def grow(h,w,steps):
    mask=np.zeros((h,w),dtype=bool)
    anchors=[(0,random.randrange(1,w-1)),(h-1,random.randrange(1,w-1)),(random.randrange(1,h-1),0),(random.randrange(1,h-1),w-1)]
    # connect anchors in random path order
    order=anchors[:]
    random.shuffle(order)
    cur=order[0]
    mask[cur]=True
    for tgt in order[1:]:
        r,c=cur
        tr,tc=tgt
        for _ in range(h*w*4):
            mask[r,c]=True
            if (r,c)==(tr,tc):
                break
            moves=[]
            if tr>r:moves.append((1,0))
            if tr<r:moves.append((-1,0))
            if tc>c:moves.append((0,1))
            if tc<c:moves.append((0,-1))
            if random.random()<0.3:
                random.shuffle(moves)
            dr,dc=moves[0]
            r,c=r+dr,c+dc
        cur=tgt
    for _ in range(steps):
        pts=list(zip(*np.where(mask)))
        r,c=random.choice(pts)
        cand=[]
        for dr,dc in DIR4:
            nr,nc=r+dr,c+dc
            if 0<=nr<h and 0<=nc<w and not mask[nr,nc]:
                cand.append((nr,nc))
        if cand:
            mask[random.choice(cand)]=True
    return mask

for dims in [(4,4),(4,5),(5,5),(5,6),(6,6)]:
    h,w=dims
    ok=False
    for t in range(5000):
        mask=grow(h,w,random.randint(0,h*w//3))
        comp=~mask
        if mask.all() or not comp.any():
            continue
        if not conn(mask) or not conn(comp):
            continue
        if not full_bbox(mask) or not full_bbox(comp):
            continue
        print('dims',dims,'trial',t,flush=True)
        print(mask.astype(int),flush=True)
        print('comp',flush=True)
        print(comp.astype(int),flush=True)
        ok=True
        break
    print('done',dims,ok,flush=True)
