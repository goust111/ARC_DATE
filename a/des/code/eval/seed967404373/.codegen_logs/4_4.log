    A2=A.copy()
    A2[0,random.choice(tops)]=False
    A2[H-1,random.choice(bots)]=False
    A2[random.choice(lefts),0]=False
    A2[random.choice(rights),W-1]=False
    B2=~A2
    if conn(A2) and conn(B2) and full(A2) and full(B2):
      print('found coarse',n,m,'shape',A2.shape)
      print(A2.astype(int))
      raise SystemExit
  print('done',n,m)
