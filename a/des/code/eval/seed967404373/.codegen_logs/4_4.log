import random, math, numpy as np
DIR4=[(1,0),(-1,0),(0,1),(0,-1)]

def comp_count(mask):
    h,w=mask.shape
    seen=np.zeros((h,w),dtype=bool)
    n=0
    for r in range(h):
        for c in range(w):
            if mask[r,c] and not seen[r,c]:
                n+=1
                stack=[(r,c)]; seen[r,c]=True
                while stack:
                    rr,cc=stack.pop()
                    for dr,dc in DIR4:
                        nr,nc=rr+dr,cc+dc
                        if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                            seen[nr,nc]=True; stack.append((nr,nc))
    return n

def score(arr):
    s=0
    for side in [arr[0,:],arr[-1,:],arr[:,0],arr[:,-1]]:
        if not side.any(): s+=20
        if side.all(): s+=20
    s += 10*(comp_count(arr)-1)
    s += 10*(comp_count(~arr)-1)
    cnt=arr.sum()
    total=arr.size
    if cnt<8 or cnt>total-8: s+=20
    return s

