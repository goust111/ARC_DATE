import random, numpy as np
DIR4=[(1,0),(-1,0),(0,1),(0,-1)]

def conn(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:return False
    h,w=mask.shape
    stack=[tuple(pts[0])]; seen={stack[0]}
    while stack:
        r,c=stack.pop()
        for dr,dc in DIR4:
            nr,nc=r+dr,c+dc
            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); stack.append((nr,nc))
    return len(seen)==len(pts)

def full(mask):
    rs,cs=np.where(mask)
    if len(rs)==0:return False
    return rs.min()==0 and rs.max()==mask.shape[0]-1 and cs.min()==0 and cs.max()==mask.shape[1]-1

def maze(n,m):
    H,W=2*n+1,2*m+1
    g=np.ones((H,W),dtype=bool) # walls=True
    vis=[[False]*m for _ in range(n)]
    stack=[(0,0)]
    vis[0][0]=True
    g[1,1]=False
    while stack:
        r,c=stack[-1]
        nbr=[]
        for dr,dc in DIR4:
            nr,nc=r+dr,c+dc
            if 0<=nr<n and 0<=nc<m and not vis[nr][nc]:
                nbr.append((nr,nc,dr,dc))
        if not nbr:
            stack.pop(); continue
        nr,nc,dr,dc=random.choice(nbr)
        vis[nr][nc]=True
        g[2*r+1+dr,2*c+1+dc]=False
        g[2*nr+1,2*nc+1]=False
        stack.append((nr,nc))
    return g

for n,m in [(2,2),(3,3),(3,4),(4,4),(4,5)]:
  for t in range(200):
    A=maze(n,m)  # walls
    H,W=A.shape
    # open one boundary corridor on each side at odd positions where adjacent inside cell is corridor
    B=~A
    tops=[c for c in range(1,W-1,2) if B[1,c]]
    bots=[c for c in range(1,W-1,2) if B[H-2,c]]
    lefts=[r for r in range(1,H-1,2) if B[r,1]]
    rights=[r for r in range(1,H-1,2) if B[r,W-2]]
    if not tops or not bots or not lefts or not rights:
