import random, numpy as np
DIR4=[(1,0),(-1,0),(0,1),(0,-1)]

def neighbors(h,w,r,c):
    for dr,dc in DIR4:
        nr,nc=r+dr,c+dc
        if 0<=nr<h and 0<=nc<w:
            yield nr,nc

def rem_connected(rem,h,w):
    if not rem: return False
    start=next(iter(rem))
    stack=[start]; seen={start}
    while stack:
        r,c=stack.pop()
        for nb in neighbors(h,w,r,c):
            if nb in rem and nb not in seen:
                seen.add(nb); stack.append(nb)
    return len(seen)==len(rem)

def sides(cells,h,w):
    res=set()
    for r,c in cells:
        if r==0: res.add('T')
        if r==h-1: res.add('B')
        if c==0: res.add('L')
        if c==w-1: res.add('R')
    return res

for h,w in [(7,7),(8,8),(9,9),(10,10),(12,12)]:
  found=False
  for attempt in range(2000):
    A={(random.randrange(1,h-1), random.randrange(1,w-1))}
    rem={(r,c) for r in range(h) for c in range(w)}-A
    ok=True
    for step in range(h*w//2):
      if sides(A,h,w)=={'T','B','L','R'} and sides(rem,h,w)=={'T','B','L','R'}:
        arr=np.zeros((h,w),dtype=int)
        for r,c in A: arr[r,c]=1
        print('found',h,w,'attempt',attempt,'step',step)
        print(arr)
        raise SystemExit
      frontier=[]
      missing=list({'T','B','L','R'}-sides(A,h,w))
      for r,c in A:
        for nr,nc in neighbors(h,w,r,c):
          if (nr,nc) not in rem: continue
          score=0
          if nr==0 and 'T' in missing: score+=5
          if nr==h-1 and 'B' in missing: score+=5
          if nc==0 and 'L' in missing: score+=5
          if nc==w-1 and 'R' in missing: score+=5
          # prefer boundary-hugging thin growth
          if nr in (0,h-1) or nc in (0,w-1): score+=1
          frontier.append((score,random.random(),(nr,nc)))
      frontier.sort(reverse=True)
      moved=False
      for _,__,cell in frontier[:80]:
        new_rem=rem-{cell}
        if not new_rem: continue
        if sides(new_rem,h,w)"'!={'"'T','B','L','R'}:
            continue
        if rem_connected(new_rem,h,w):
          A.add(cell); rem=new_rem; moved=True; break
      if not moved:
        ok=False; break
    if found: break
  print('done',h,w,found)
print('none')
