                seen.add((nr,nc)); stack.append((nr,nc))
    return len(seen)==len(pts)

def full_bbox(mask):
    rs,cs=np.where(mask)
    if len(rs)==0:return False
    return rs.min()==0 and rs.max()==mask.shape[0]-1 and cs.min()==0 and cs.max()==mask.shape[1]-1

def snake(h,w,rows,xs,sides):
    m=np.zeros((h,w),dtype=bool)
    # segment on each key row
    for r,x,side in zip(rows,xs,sides):
        if side==0:
            m[r,:x+1]=True
        else:
            m[r,x:]=True
    # connect consecutive key rows along the touching edge x
    for i in range(len(rows)-1):
        r0,r1=rows[i],rows[i+1]
        x0,x1=xs[i],xs[i+1]
        # choose bridge column where both intervals include it if possible; else skip invalid
        lo=max(0 if sides[i]==0 else x0, 0 if sides[i+1]==0 else x1)
        hi=min(x0 if sides[i]==0 else w-1, x1 if sides[i+1]==0 else w-1)
        if lo>hi:
            return None
        c=lo
        m[min(r0,r1):max(r0,r1)+1,c]=True
    return m

for h,w in [(5,5),(5,6),(6,6),(6,7),(7,7),(7,8),(8,8)]:
  found=False
  for rows in itertools.combinations(range(h),4):
    if rows[0]"'!=0 or rows[-1]!=h-1: continue
    for xs in itertools.product(range(1,w-1), repeat=4):
      for sides in itertools.product([0,1], repeat=4):
        m=snake(h,w,rows,xs,sides)
        if m is None: continue
        c=~m
        if full_bbox(m) and full_bbox(c) and conn(m) and conn(c):
          print('"'found',h,w,'rows',rows,'xs',xs,'sides',sides)
          print(m.astype(int))
          raise SystemExit
  print('done',h,w,found)
print('none')
