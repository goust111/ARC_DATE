    Aanchors={(0,random.choice(mids_top)),(h-1,random.choice(mids_top)),(random.choice(mids_side),0),(random.choice(mids_side),w-1)}
    Banchors={(0,random.choice(mids_top)),(h-1,random.choice(mids_top)),(random.choice(mids_side),0),(random.choice(mids_side),w-1)}
    if Aanchors & Banchors: continue
    A={next(iter(Aanchors))}
    # connect remaining A anchors one by one
    ok=True
    for goal in list(Aanchors-{next(iter(Aanchors))}):
        path=rand_path(h,w,A,goal,Banchors)
        if path is None:
            ok=False; break
        accepted=False
        # try path prefixes modifications? just whole path
        cand=A|set(path)
        if remainder_ok(h,w,cand,Banchors):
            A=cand; accepted=True
        else:
            # try many alternative bfs paths
            for _ in range(80):
                path=rand_path(h,w,A,goal,Banchors)
                if path is None: break
                cand=A|set(path)
                if remainder_ok(h,w,cand,Banchors):
                    A=cand; accepted=True; break
        if not accepted:
            ok=False; break
    if not ok: continue
    # grow some extra cells
    for _ in range(random.randint(0,h*w//4)):
        frontier=[]
        for r,c in list(A):
            for nb in neighbors(h,w,r,c):
                if nb not in A and nb not in Banchors:
                    frontier.append(nb)
        random.shuffle(frontier)
        added=False
        for nb in frontier[:50]:
            cand=A|{nb}
            if remainder_ok(h,w,cand,Banchors):
                A=cand; added=True; break
        if not added:
            break
    # bbox full for both by anchors
    if len(A)==h*w: continue
    if connected_subset(A,h,w) and remainder_ok(h,w,A,Banchors):
        arr=np.zeros((h,w),dtype=int)
        for r,c in A: arr[r,c]=1
        print('"'found',h,w,'attempt',attempt)
        print(arr)
        found=True
        raise SystemExit
  print('done',h,w,found)
