DIR4=[(1,0),(-1,0),(0,1),(0,-1)]

def conn(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:return False
    h,w=mask.shape
    stack=[tuple(pts[0])]; seen={stack[0]}
    while stack:
        r,c=stack.pop()
        for dr,dc in DIR4:
            nr,nc=r+dr,c+dc
