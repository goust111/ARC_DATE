import random, sys
sys.setrecursionlimit(10000)
DIR4=[(1,0),(-1,0),(0,1),(0,-1)]

def neighbors(h,w,r,c):
    for dr,dc in DIR4:
        nr,nc=r+dr,c+dc
        if 0<=nr<h and 0<=nc<w:
            yield nr,nc

def connected(cells,h,w):
    start=next(iter(cells))
    stack=[start]; seen={start}
    while stack:
        r,c=stack.pop()
        for nb in neighbors(h,w,r,c):
            if nb in cells and nb not in seen:
                seen.add(nb); stack.append(nb)
    return len(seen)==len(cells)

def side_bits(cells,h,w):
    bits=0
    for r,c in cells:
        if r==0: bits|=1
        if r==h-1: bits|=2
        if c==0: bits|=4
        if c==w-1: bits|=8
    return bits

def search(h,w,max_nodes=40,restarts=200):
    allcells={(r,c) for r in range(h) for c in range(w)}
    for _ in range(restarts):
        start=(random.randrange(1,h-1), random.randrange(1,w-1))
        B={start}
        A=allcells-B
        seen_states=set()
        def dfs(B,A):
            bits=side_bits(B,h,w)
            key=(frozenset(B),bits)
            if key in seen_states:
                return None
            seen_states.add(key)
            if bits==15 and side_bits(A,h,w)==15:
                return set(B)
            if len(B)>=max_nodes:
                return None
            missing=[s for s,bit in [('T',1),('B',2),('L',4),('R',8)] if not (bits&bit)]
            frontier=set()
            for cell in B:
                frontier.update(nb for nb in neighbors(h,w,*cell) if nb in A)
            cand=[]
            for cell in frontier:
                newA=A-{cell}
                if side_bits(newA,h,w)"'!=15:
                    continue
                if not connected(newA,h,w):
                    continue
                r,c=cell
                score=random.random()
                if r==0 and '"'T' in missing: score+=20
                if r==h-1 and 'B' in missing: score+=20
                if c==0 and 'L' in missing: score+=20
                if c==w-1 and 'R' in missing: score+=20
                # encourage branching away from center
                for s in missing:
                    if s=='T': score += (h-r)/h
                    elif s=='B': score += (r+1)/h
                    elif s=='L': score += (w-c)/w
                    else: score += (c+1)/w
                cand.append((score,cell))
            cand.sort(reverse=True)
            for _,cell in cand[:20]:
                res=dfs(B|{cell}, A-{cell})
                if res is not None:
                    return res
            return None
        res=dfs(B,A)
        if res is not None:
            return res
    return None

for size in [8,9,10,11,12]:
    res=search(size,size,max_nodes=size*2,restarts=100)
    print('size',size,'res',res is not None, flush=True)
    if res:
        arr=[[1 if (r,c) not in res else 0 for c in range(size)] for r in range(size)]
        for row in arr: print(''.join(map(str,row)), flush=True)
        break
