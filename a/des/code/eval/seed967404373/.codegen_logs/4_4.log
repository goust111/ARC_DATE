import numpy as np
DIR4=[(1,0),(-1,0),(0,1),(0,-1)]

def conn(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:return False
    h,w=mask.shape
    stack=[tuple(pts[0])]; seen={stack[0]}
    while stack:
        r,c=stack.pop()
        for dr,dc in DIR4:
            nr,nc=r+dr,c+dc
            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); stack.append((nr,nc))
    return len(seen)==len(pts)

def full(mask):
    rs,cs=np.where(mask)
    if len(rs)==0:return False
    return rs.min()==0 and rs.max()==mask.shape[0]-1 and cs.min()==0 and cs.max()==mask.shape[1]-1

def draw(h,w,a,u,b,d,e):
    pts=[(0,a),(u,a),(u,w-2),(b,w-2),(b,d),(h-2,d),(h-2,1),(e,1),(e,0)]
    m=np.zeros((h,w),dtype=bool)
    for (r1,c1),(r2,c2) in zip(pts,pts[1:]):
        if r1==r2:
            lo,hi=sorted((c1,c2)); m[r1,lo:hi+1]=True
        elif c1==c2:
            lo,hi=sorted((r1,r2)); m[lo:hi+1,c1]=True
        else:
            return None
    return m

for h,w in [(7,7),(7,8),(8,8),(9,9),(10,10)]:
