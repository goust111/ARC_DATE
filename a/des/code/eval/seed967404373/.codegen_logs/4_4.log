def comp_count(mask):
    h,w=mask.shape
    seen=set(); n=0
    for r in range(h):
        for c in range(w):
            if mask[r,c] and (r,c) not in seen:
                n+=1
                stack=[(r,c)]; seen.add((r,c))
                while stack:
                    rr,cc=stack.pop()
                    for dr,dc in DIR4:
                        nr,nc=rr+dr,cc+dc
                        if 0<=nr<h and 0<=nc<w and mask[nr,nc] and (nr,nc) not in seen:
                            seen.add((nr,nc)); stack.append((nr,nc))
    return n

def score(arr):
    h,w=arr.shape
    s=0
    for side in [arr[0,:],arr[-1,:],arr[:,0],arr[:,-1]]:
        s += 0 if side.any() else 5
        s += 0 if (~side).any() else 5
    s += 3*(comp_count(arr)-1)
    s += 3*(comp_count(~arr)-1)
    s += abs(arr.sum()-arr.size/2)/arr.size
    return s

for h,w in [(5,5),(5,6),(6,6),(6,7),(7,7),(7,8),(8,8)]:
