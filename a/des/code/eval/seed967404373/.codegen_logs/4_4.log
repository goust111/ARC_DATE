DIR4=[(1,0),(-1,0),(0,1),(0,-1)]

def neighbors(h,w,r,c):
    for dr,dc in DIR4:
        nr,nc=r+dr,c+dc
        if 0<=nr<h and 0<=nc<w:
            yield nr,nc

def connected(cells,h,w):
    cells=set(cells)
    if not cells: return False
    start=next(iter(cells))
    stack=[start]; seen={start}
    while stack:
        r,c=stack.pop()
        for nb in neighbors(h,w,r,c):
            if nb in cells and nb not in seen:
                seen.add(nb); stack.append(nb)
    return len(seen)==len(cells)

def side_bits(cells,h,w):
    bits=0
    for r,c in cells:
        if r==0: bits|=1
        if r==h-1: bits|=2
        if c==0: bits|=4
        if c==w-1: bits|=8
    return bits

for h,w in [(7,7),(8,8),(9,9)]:
    allcells=frozenset((r,c) for r in range(h) for c in range(w))
    starts=[(h//2,w//2),(h//2-1,w//2),(h//2,w//2-1)]
    pq=[]; seen=set()
    for s in starts:
        B=frozenset([s])
        bits=side_bits(B,h,w)
        pr=(4-bin(bits).count('1'),1)
        heapq.heappush(pq,(pr,B))
        seen.add(B)
