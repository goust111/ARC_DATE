import random, collections, numpy as np
DIR4=[(1,0),(-1,0),(0,1),(0,-1)]

def neighbors(h,w,r,c):
    for dr,dc in DIR4:
        nr,nc=r+dr,c+dc
        if 0<=nr<h and 0<=nc<w:
            yield nr,nc

def connected_subset(cells,h,w):
    cells=set(cells)
    if not cells: return False
    start=next(iter(cells))
    q=[start]; seen={start}
    while q:
        r,c=q.pop()
        for nr,nc in neighbors(h,w,r,c):
            if (nr,nc) in cells and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return len(seen)==len(cells)

def remainder_ok(h,w,A,Banchors):
    rem={(r,c) for r in range(h) for c in range(w) if (r,c) not in A}
    if not Banchors.issubset(rem): return False
    # connectivity of remainder
    q=[next(iter(Banchors))]; seen={q[0]}
    while q:
        r,c=q.pop()
        for nr,nc in neighbors(h,w,r,c):
            if (nr,nc) in rem and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return seen==rem

def rand_path(h,w,start_set,goal,blocked,tries=200):
    # BFS shortest path with randomized neighbor order from any start cell to goal
    starts=list(start_set)
    for _ in range(tries):
        q=collections.deque(starts)
        prev={s:None for s in starts}
        while q:
            cur=q.popleft()
            if cur==goal:
                path=[]; x=cur
                while prev[x] is not None:
                    path.append(x); x=prev[x]
                return path[::-1]
            nbrs=list(neighbors(h,w,*cur)); random.shuffle(nbrs)
            for nb in nbrs:
                if nb in prev: continue
                if nb in blocked and nb"'!=goal: continue
                prev[nb]=cur; q.append(nb)
    return None

for h,w in [(7,7),(8,8),(9,9),(10,10)]:
  found=False
