def try_solve(h,w,aroot,broot):
    X=[[Bool(f'x_{r}_{c}') for c in range(w)] for r in range(h)]
    s=Solver(); s.set(timeout=3000)
    for cells in [ [X[0][c] for c in range(w)], [X[h-1][c] for c in range(w)], [X[r][0] for r in range(h)], [X[r][w-1] for r in range(h)] ]:
