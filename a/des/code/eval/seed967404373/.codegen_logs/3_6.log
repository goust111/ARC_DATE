+def _extract_frames(grid: np.ndarray) -> list[dict]:
+    frames: list[dict] = []
+    for comp in _components(grid != BG):
+        r0 = int(comp[:, 0].min())
+        c0 = int(comp[:, 1].min())
+        r1 = int(comp[:, 0].max())
+        c1 = int(comp[:, 1].max())
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        assert h >= 3 and w >= 3
+
+        mask = np.zeros((h, w), dtype=bool)
