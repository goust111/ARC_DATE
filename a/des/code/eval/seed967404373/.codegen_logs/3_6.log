+    chain: list[dict] = []
+    seen: set[int] = set()
+    cur = by_color[int(roots[0])]
+    while True:
+        color = int(cur["base_color"])
+        assert color not in seen, "pointer chain must not cycle"
+        seen.add(color)
+        chain.append(cur)
+        nxt = cur["next_color"]
