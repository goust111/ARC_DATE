+        chosen = random.choice(choices)
+        reserved.update(chosen["cells"])
+        assigned.append(
+            {
+                "color": int(obj["color"]),
+                "merged": merged,
+                "endpoints": tuple(chosen["endpoints"]),
+            }
+        )
+    return assigned
+
