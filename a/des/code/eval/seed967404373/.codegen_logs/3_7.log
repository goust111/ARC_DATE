+
+def _build_legend(legend_colors: list[int], table: dict[tuple[int, int], int]) -> np.ndarray:
+    n = len(legend_colors)
+    size = n + 3
+    patch = np.full((size, size), GREY, dtype=int)
+    inner = np.full((n + 1, n + 1), BG, dtype=int)
