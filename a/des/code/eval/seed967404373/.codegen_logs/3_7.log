+def _build_table(
+    legend_colors: list[int],
+    fuse_pairs: Iterable[tuple[int, int]],
+) -> dict[tuple[int, int], int]:
+    colors = legend_colors[:]
+    forced = {tuple(sorted(pair)) for pair in fuse_pairs}
