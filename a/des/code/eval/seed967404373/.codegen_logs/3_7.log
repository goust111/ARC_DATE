+def _render_pixels(
+    shape: tuple[int, int],
+    legend: np.ndarray,
+    pixels: dict[tuple[int, int], int],
+) -> np.ndarray:
+    out = np.full(shape, BG, dtype=int)
+    out[: legend.shape[0], : legend.shape[1]] = legend
+    for (r, c), color in pixels.items():
+        assert not _in_legend((r, c), legend.shape[0])
+        out[r, c] = color
+    return out
