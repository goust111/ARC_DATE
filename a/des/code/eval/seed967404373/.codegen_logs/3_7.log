+import numpy as np
+
+
+BG = 0
+GREY = 5
+GRID_SIZES = (15, 17, 19, 21, 23)
+PAIR_COLOR_POOL = tuple(c for c in range(10) if c not in {BG, GREY})
+MAX_SEGMENT_REACH = 3
+MAX_GENERATION_ATTEMPTS = 400
