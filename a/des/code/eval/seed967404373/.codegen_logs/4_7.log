+    return heights
+
+
+def _sample_gaps(heights: list[int], gap_kinds: list[str]) -> list[int]:
+    gaps: list[int] = []
+    for height, kind in zip(heights[:-1], gap_kinds):
+        if kind == "blocked":
+            gaps.append(random.randint(1, height - 2))
