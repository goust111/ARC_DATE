+import random
+
+import numpy as np
+
+
+AZURE = 8
+YELLOW = 4
+GREY = 5
+OBJECT_COLORS = (0, 1, 2, 3, 6, 7, 9)
+MAX_GENERATION_ATTEMPTS = 400
+MAX_GRID_SIDE = 30
