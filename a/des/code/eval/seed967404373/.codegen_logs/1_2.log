+def _neighbors4(r: int, c: int, h: int, w: int) -> list[Coord]:
+    out: list[Coord] = []
+    for dr, dc in DIRS:
+        nr = r + dr
+        nc = c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            out.append((nr, nc))
+    return out
