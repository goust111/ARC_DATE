+def _classify_scene(g: np.ndarray) -> tuple[set[Coord], set[Coord], dict[Coord, int], dict[Coord, int]]:
+    h, w = g.shape
+    pipes: set[Coord] = set()
+    relays: set[Coord] = set()
+    colored: dict[Coord, int] = {}
