+            return None
+
+    return [(int(r), int(c)) for r, c in positions if r is not None]
+
+
+def _build_expected(
+    inp: np.ndarray,
+    board_top: int,
+    board_left: int,
+    specs: list[dict],
+    piece_positions: list[tuple[int, int]],
+) -> np.ndarray:
+    out = inp.copy()
+    for spec, (top, left) in zip(specs, piece_positions, strict=False):
