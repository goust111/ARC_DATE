+        slots.append(
+            {
+                "bbox_abs": (int(br0 + r0), int(bc0 + c0), int(br0 + r1), int(bc0 + c1)),
+                "shape": shape,
+                "seams": seams,
+                "seams_by_cell": seams_by_cell,
