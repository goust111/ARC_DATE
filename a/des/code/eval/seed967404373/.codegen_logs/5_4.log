+    positions: list[tuple[int, int] | None] = [None] * len(piece_patches)
+    order = list(range(len(piece_patches)))
+    order.sort(key=lambda idx: int(np.count_nonzero(piece_patches[idx])), reverse=True)
+
+    for idx in order:
+        patch = piece_patches[idx]
+        ph, pw = patch.shape
