+
+def _can_place_patch(blocked: np.ndarray, patch: np.ndarray, top: int, left: int) -> bool:
+    h, w = blocked.shape
+    ph, pw = patch.shape
+    if top < 1 or left < 1 or top + ph >= h or left + pw >= w:
+        return False
