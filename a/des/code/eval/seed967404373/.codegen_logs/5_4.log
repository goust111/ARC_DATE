+    pieces = []
+    for cells in fg_components:
+        if set(cells) == board_set:
+            continue
+        pieces.append(_parse_piece(grid, cells))
+    pieces.sort(key=lambda piece: piece["bbox"])
+
+    board = {
+        "bbox": board_bbox,
+        "patch": board_patch,
+        "color": int(board_color),
+        "cells": board_cells,
+    }
+    return board, slots, pieces
