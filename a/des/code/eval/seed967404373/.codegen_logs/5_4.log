+
+
+def _mark_blocked(blocked: np.ndarray, patch: np.ndarray, top: int, left: int, pad: int) -> None:
+    h, w = blocked.shape
+    for rr, cc in np.argwhere(patch != BG):
+        r = int(top + rr)
+        c = int(left + cc)
+        r0 = max(0, r - pad)
+        r1 = min(h, r + pad + 1)
+        c0 = max(0, c - pad)
+        c1 = min(w, c + pad + 1)
+        blocked[r0:r1, c0:c1] = True
