+        exposed: list[int] = []
+        for d, (dr, dc) in enumerate(DIRS):
+            nr = int(r + dr)
+            nc = int(c + dc)
+            if nr < 0 or nc < 0 or nr >= h or nc >= w or not bool(mask[nr, nc]):
+                exposed.append(int(d))
+        if len(exposed) == 1:
+            out.append((int(r), int(c), int(exposed[0])))
+    return out
