+def _single_touch_seam_candidates(mask: np.ndarray) -> list[tuple[int, int, int]]:
+    h, w = mask.shape
+    out: list[tuple[int, int, int]] = []
+    for r, c, d in _flat_edge_candidates(mask):
+        dr, dc = DIRS[int(d)]
+        ar = int(r + dr)
+        ac = int(c + dc)
+        touches = 0
+        for dr2, dc2 in DIRS:
+            nr = ar + dr2
+            nc = ac + dc2
+            if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]):
+                touches += 1
