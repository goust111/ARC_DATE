+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BG = 0
+BOARD_COLOR = 5
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+PIECE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GEN_RETRIES = 400
+SHAPE_RETRIES = 200
+BOARD_RETRIES = 80
+PIECE_RETRIES = 120
