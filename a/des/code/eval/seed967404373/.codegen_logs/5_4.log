+        shape = _random_shape()
+        if shape is None:
+            return None
+        sig = _canonical_signature(shape)
+        if sig in seen:
+            continue
+        seen.add(sig)
+        slot_k = random.randrange(4)
+        specs.append({"base_mask": shape, "slot_mask": np.rot90(shape, int(slot_k))})
+
+    random.shuffle(specs)
+    return specs
