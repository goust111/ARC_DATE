+    ks: list[int] = []
+    for k in range(4):
+        sig = _mask_signature(np.rot90(mask, k))
+        if sig not in seen:
+            seen.add(sig)
+            ks.append(k)
+    return ks
+
+
+def _flat_edge_candidates(mask: np.ndarray) -> list[tuple[int, int, int]]:
