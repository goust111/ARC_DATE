+def _can_place_mask(used: np.ndarray, mask: np.ndarray, top: int, left: int, pad: int) -> bool:
+    h, w = used.shape
+    for rr, cc in np.argwhere(mask):
+        r = int(top + rr)
+        c = int(left + cc)
+        r0 = max(0, r - pad)
+        r1 = min(h, r + pad + 1)
+        c0 = max(0, c - pad)
+        c1 = min(w, c + pad + 1)
+        if bool(np.any(used[r0:r1, c0:c1])):
+            return False
+    return True
