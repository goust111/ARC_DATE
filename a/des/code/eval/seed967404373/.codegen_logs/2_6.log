+    def backtrack(pos: int) -> bool:
+        if pos == len(order):
+            return True
+        lock_idx = order[pos]
+        for key_idx, turns in candidates[lock_idx]:
+            if key_idx in used_keys:
+                continue
+            used_keys.add(key_idx)
+            assignment[lock_idx] = (lock_idx, key_idx, turns)
+            if backtrack(pos + 1):
