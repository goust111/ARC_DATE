+
+def rotate_normalized(norm: tuple[tuple[int, int], ...], turns: int) -> tuple[tuple[int, int], ...]:
+    pts = list(norm)
+    h, w = shape_dims(pts)
+    for _ in range(turns % 4):
+        pts = [(c, h - 1 - r) for r, c in pts]
+        h, w = w, h
