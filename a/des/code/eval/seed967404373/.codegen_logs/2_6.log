+def _make_shape_spec(rng: random.Random, used_shapes: set[tuple[tuple[int, int], ...]]) -> dict | None:
+    for _ in range(300):
+        inner_h = rng.randint(4, 7)
+        inner_w = rng.randint(4, 7)
+        obstacle_side = rng.choice(SIDES)
+        if obstacle_side in ("top", "bottom"):
