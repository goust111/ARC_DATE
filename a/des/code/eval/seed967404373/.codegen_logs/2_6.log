+        keys.append({"color": color, "bbox_tl": (r0, c0), "norm": rel, "cells": set(pts)})
+    assert keys, "no keys found"
+    return keys
+
+
+def _match_keys(locks: list[dict], keys: list[dict]) -> list[tuple[int, int, int]]:
+    candidates: list[list[tuple[int, int]]] = []
