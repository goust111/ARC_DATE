+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+KEY_COLORS = (1, 2, 3, 4, 6, 9)
+OBSTACLE = 5
+LOCK = 7
+TRAIL = 8
+GEN_RETRIES = 400
+SIDES = ("top", "bottom", "left", "right")
+SLIDE_DIRS = {
+    "top": (1, 0),
+    "bottom": (-1, 0),
+    "left": (0, 1),
+    "right": (0, -1),
