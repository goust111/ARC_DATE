+def _collect_sources(grid):
+    h, w = grid.shape
+    sources = []
+    seen = set()
+    for r in range(h):
+        for c in (0, w - 1):
+            if (r, c) in seen:
+                continue
+            color = int(grid[r, c])
+            if color in (BLACK, GREY):
+                continue
+            seen.add((r, c))
+            if r in (0, h - 1):
+                raise AssertionError("corner sources are ambiguous")
+            direction = RIGHT if c == 0 else LEFT
+            sources.append({"pos": (r, c), "color": color, "dir": direction})
+    for c in range(w):
+        for r in (0, h - 1):
+            if (r, c) in seen:
+                continue
+            color = int(grid[r, c])
+            if color in (BLACK, GREY):
+                continue
+            seen.add((r, c))
+            if c in (0, w - 1):
+                raise AssertionError("corner sources are ambiguous")
+            direction = DOWN if r == 0 else UP
+            sources.append({"pos": (r, c), "color": color, "dir": direction})
+    return sources, seen
+
+
+def _mirror_orientations(grid):
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    orientations = {}
+    for r in range(h):
+        for c in range(w):
+            if visited[r, c] or int(grid[r, c]) != GREY:
+                continue
+            stack = [(r, c)]
+            visited[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in (UP, DOWN, LEFT, RIGHT):
+                    nr, nc = rr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if visited[nr, nc] or int(grid[nr, nc]) != GREY:
+                        continue
+                    visited[nr, nc] = True
+                    stack.append((nr, nc))
+            if not 2 <= len(coords) <= 4:
+                raise AssertionError("mirror length must be between 2 and 4")
+            rows = {rr for rr, _ in coords}
+            cols = {cc for _, cc in coords}
+            if len(rows) == 1:
+                orientation = "h"
+            elif len(cols) == 1:
+                orientation = "v"
+            else:
+                raise AssertionError("mirror must be horizontal or vertical")
+            for cell in coords:
+                orientations[cell] = orientation
+    return orientations
+
+
+def _reflect(direction, orientation):
+    if orientation == "v":
+        if direction == RIGHT:
+            return UP
+        if direction == LEFT:
+            return DOWN
+        return None
+    if orientation == "h":
+        if direction == DOWN:
+            return LEFT
+        if direction == UP:
+            return RIGHT
+        return None
+    return None
