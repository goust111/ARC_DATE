    # helper to get junction id for bar face/overlap and endpoint marker
    def face_marker(cells, deltas):
        found=[]
        for (r,c),(dr,dc) in zip(cells,deltas):
            rr,cc=r+dr,c+dc
            if 0<=rr<g.shape[0] and 0<=cc<g.shape[1] and g[rr,cc] not in (BLACK,GREY):
                found.append((rr,cc,int(g[rr,cc])))
        uniq=[]
        seen=set()
        for item in found:
            if (item[0],item[1]) not in seen:
                uniq.append(item); seen.add((item[0],item[1]))
        return uniq
    endpoint_nodes={}
    edges=[]
    for b in bars:
        nids=[]
        if b['orient']=='H':
            # junctions
            touched=set()
