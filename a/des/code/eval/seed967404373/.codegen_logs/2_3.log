+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+SOURCE_COLORS = (1, 2, 3, 7, 8, 9)
+MAX_GRID_SIZE = 30
+GENERATION_RETRIES = 400
