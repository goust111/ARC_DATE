                for c in range(b['c0'],b['c1']+1):
                    nid=jnode.get((r,c))
                    if nid is not None: touched.add(nid)
            for nid in touched:
                cols=[c for r,c in jcomps[nid] if b['r0']<=r<=b['r1'] and b['c0']<=c<=b['c1']]
                nids.append((sum(cols)/len(cols),nid))
            # left face
            left_cells=[(r,b['c0']) for r in range(b['r0'],b['r1']+1)]
            if not any((r,b['c0']) in jnode for r,_ in left_cells):
                marks=face_marker(left_cells,[ (0,-1) for _ in left_cells])
                nid=len(node_kind)
                node_kind.append('endpoint'); node_marker.append(marks[0][2] if marks else None); node_cell.append(marks[0][:2] if marks else None)
                nids.append((b['c0']-0.5,nid))
            right_cells=[(r,b['c1']) for r in range(b['r0'],b['r1']+1)]
            if not any((r,b['c1']) in jnode for r,_ in right_cells):
                marks=face_marker(right_cells,[ (0,1) for _ in right_cells])
                nid=len(node_kind)
                node_kind.append('endpoint'); node_marker.append(marks[0][2] if marks else None); node_cell.append(marks[0][:2] if marks else None)
                nids.append((b['c1']+0.5,nid))
        else:
            touched=set()
            for r in range(b['r0'],b['r1']+1):
                for c in range(b['c0'],b['c1']+1):
                    nid=jnode.get((r,c))
                    if nid is not None: touched.add(nid)
            for nid in touched:
                rows=[r for r,c in jcomps[nid] if b['r0']<=r<=b['r1'] and b['c0']<=c<=b['c1']]
                nids.append((sum(rows)/len(rows),nid))
            top_cells=[(b['r0'],c) for c in range(b['c0'],b['c1']+1)]
            if not any((b['r0'],c) in jnode for _,c in top_cells):
                marks=face_marker(top_cells,[ (-1,0) for _ in top_cells])
                nid=len(node_kind)
                node_kind.append('endpoint'); node_marker.append(marks[0][2] if marks else None); node_cell.append(marks[0][:2] if marks else None)
                nids.append((b['r0']-0.5,nid))
            bot_cells=[(b['r1'],c) for c in range(b['c0'],b['c1']+1)]
            if not any((b['r1'],c) in jnode for _,c in bot_cells):
                marks=face_marker(bot_cells,[ (1,0) for _ in bot_cells])
                nid=len(node_kind)
                node_kind.append('endpoint'); node_marker.append(marks[0][2] if marks else None); node_cell.append(marks[0][:2] if marks else None)
                nids.append((b['r1']+0.5,nid))
        nids=sorted(nids)
        print('bar',b,'events',nids)
        for i in range(len(nids)-1):
            a=nids[i][1]; b2=nids[i+1][1]
            eid=len(edges); edges.append((a,b2,b['width']))
            graph[a].append(eid); graph[b2].append(eid)
    arrivals=defaultdict(set)
    for nid,(kind,mark) in enumerate(zip(node_kind,node_marker)):
        if kind=='endpoint' and mark not in (None,YELLOW):
            stack=[(nid,None)]
            seen=set()
            while stack:
                cur,prev=stack.pop()
                state=(cur,prev)
                if state in seen: continue
                seen.add(state)
                if node_kind[cur]=='endpoint' and node_marker[cur]==YELLOW:
                    arrivals[cur].add(mark)
                outs=[]
                for eid in graph[cur]:
                    if eid==prev: continue
                    outs.append(eid)
                if not outs: continue
                maxw=max(edges[eid][2] for eid in outs)
                for eid in outs:
                    if edges[eid][2]"'!=maxw: continue
                    a,b2,_=edges[eid]
                    nxt=b2 if a==cur else a
                    stack.append((nxt,eid))
    out=g.copy()
    for nid,colors in arrivals.items():
        r,c=node_cell[nid]
        out[r,c]=MAGENTA if len(colors)>1 else next(iter(colors))
    return out

