import numpy as np
from collections import defaultdict

BLACK=0; YELLOW=4; GREY=5; MAGENTA=6


def runs1d(a):
    out=[]; start=None
    for i,v in enumerate(a):
        if v and start is None: start=i
        elif not v and start is not None:
            out.append((start,i-1)); start=None
    if start is not None: out.append((start,len(a)-1))
    return out


def comps(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,bool)
    out=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            stack=[(r,c)]
            seen[r,c]=True
            cells=[]
            while stack:
                rr,cc=stack.pop(); cells.append((rr,cc))
                for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                    r2,c2=rr+dr,cc+dc
                    if 0<=r2<h and 0<=c2<w and mask[r2,c2] and not seen[r2,c2]:
                        seen[r2,c2]=True; stack.append((r2,c2))
            out.append(cells)
    return out


def detect_bars(mask):
    h,w=mask.shape
    bars=[]
    active={}
    for r in range(h):
        segs=runs1d(mask[r])
        segset=set(segs)
        for key,r0 in list(active.items()):
            if key not in segset:
                c0,c1=key; r1=r-1
                thick=r1-r0+1; length=c1-c0+1
                if 1<=thick<=3 and length>thick:
                    bars.append({'orient':'H','r0':r0,'r1':r1,'c0':c0,'c1':c1,'width':thick})
                del active[key]
        for key in segs:
            active.setdefault(key,r)
    for key,r0 in active.items():
        c0,c1=key; r1=h-1
        thick=r1-r0+1; length=c1-c0+1
        if 1<=thick<=3 and length>thick:
            bars.append({'orient':'H','r0':r0,'r1':r1,'c0':c0,'c1':c1,'width':thick})
    active={}
    for c in range(w):
        segs=runs1d(mask[:,c])
        segset=set(segs)
        for key,c0 in list(active.items()):
            if key not in segset:
                r0,r1=key; c1=c-1
                thick=c1-c0+1; length=r1-r0+1
                if 1<=thick<=3 and length>thick:
                    bars.append({'orient':'V','r0':r0,'r1':r1,'c0':c0,'c1':c1,'width':thick})
                del active[key]
        for key in segs:
            active.setdefault(key,c)
    for key,c0 in active.items():
        r0,r1=key; c1=w-1
        thick=c1-c0+1; length=r1-r0+1
        if 1<=thick<=3 and length>thick:
            bars.append({'orient':'V','r0':r0,'r1':r1,'c0':c0,'c1':c1,'width':thick})
    hcov=np.zeros_like(mask,bool)
    vcov=np.zeros_like(mask,bool)
    for i,b in enumerate(bars):
        b['id']=i
        if b['orient']=='H': hcov[b['r0']:b['r1']+1,b['c0']:b['c1']+1]=True
        else: vcov[b['r0']:b['r1']+1,b['c0']:b['c1']+1]=True
    return bars,hcov,vcov


def parse(g):
    mask=g==GREY
    bars,hcov,vcov=detect_bars(mask)
    assert np.all(mask == (hcov|vcov))
    jm=mask & hcov & vcov
