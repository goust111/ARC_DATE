+    junction_mask = pipe & h_cover & v_cover
+    junction_comps = _components4(junction_mask)
+
+    node_kind: list[str] = []
+    node_marker_color: list[int | None] = []
+    node_marker_cell: list[tuple[int, int] | None] = []
