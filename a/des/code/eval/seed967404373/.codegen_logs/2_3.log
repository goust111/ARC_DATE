+    for comp in junction_comps:
+        nid = len(node_kind)
+        rows = [r for r, _ in comp]
+        cols = [c for _, c in comp]
+        node_kind.append("junction")
+        node_marker_color.append(None)
+        node_marker_cell.append(None)
