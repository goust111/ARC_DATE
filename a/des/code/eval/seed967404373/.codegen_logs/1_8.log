+COLOR_POOL = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+FRAME_COUNT_CHOICES = [3, 4, 5]
+FRAME_HEIGHT_OPTIONS = {
+    3: [2, 4],
+    4: [5],
+    5: [2, 3],
+}
+GEN_ATTEMPTS = 400
+PATH_ATTEMPTS = 200
