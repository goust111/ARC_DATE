+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+    return count
+
+
+def _normalize_cells(cells: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    r0 = min(r for r, _ in cells)
+    c0 = min(c for _, c in cells)
+    return sorted((r - r0, c - c0) for r, c in cells)
