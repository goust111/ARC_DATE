+        assert coords.size > 0, "each pipe color must appear at least once"
+
+        rows = np.unique(coords[:, 0])
+        cols = np.unique(coords[:, 1])
+        if len(rows) == 1:
+            orientation = "h"
+        elif len(cols) == 1:
+            orientation = "v"
+        else:
+            raise AssertionError("each color must form a straight pipe")
