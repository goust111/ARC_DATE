+def _candidate_path(orientation: str, r: int, c: int, side: int) -> list[tuple[int, int]]:
+    if orientation == "h":
+        far_r = r + 2 * side
+        near_r = r + side
+        return [
+            (near_r, c - 1),
+            (far_r, c - 1),
+            (far_r, c),
+            (far_r, c + 1),
+            (near_r, c + 1),
+        ]
+    far_c = c + 2 * side
+    near_c = c + side
+    return [
+        (r - 1, near_c),
+        (r - 1, far_c),
+        (r, far_c),
+        (r + 1, far_c),
+        (r + 1, near_c),
+    ]
