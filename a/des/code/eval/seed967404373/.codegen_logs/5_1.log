+        lock = locks[li]
+        color = int(key["color"])
+        pattern = key["pattern"]
+        r0 = int(lock["r0"])
+        fill_c0 = int(lock["fill_c0"])
+        fill_c1 = int(lock["fill_c1"])
+        for i, bit in enumerate(pattern):
+            if bit and 0 < i < len(pattern) - 1:
+                out[r0 + i, fill_c0:fill_c1] = color
