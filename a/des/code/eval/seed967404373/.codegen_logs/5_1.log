+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+GEN_RETRIES = 400
+LOCK_COUNT_RANGE = (1, 4)
+LOCK_HEIGHT_RANGE = (5, 8)
+LOCK_WIDTH_RANGE = (5, 8)
