+    for i in range(n):
+        items.append(("lock", i, heights[i], widths[i]))
+        items.append(("key", i, 1, heights[i]))
+    rng.shuffle(items)
+
+    placements: dict[tuple[str, int], tuple[int, int]] = {}
+    for kind, idx, h, w in items:
+        placed = False
+        for _ in range(PLACEMENT_RETRIES):
