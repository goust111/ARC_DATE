+        if not ok:
+            continue
+
+        try:
+            specs = _frame_specs(grid)
+            if len(specs) != n_frames:
+                continue
+            out = main(grid)
+        except Exception:
+            continue
+
+        if np.array_equal(out, grid):
+            continue
+        return grid
+
+    raise RuntimeError("failed to generate a valid puzzle instance")

