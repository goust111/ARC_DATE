+
+BG = 0
+GREY = 5
+FRAME_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIR_NAMES = ("up", "down", "left", "right")
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r0 in range(h):
+        for c0 in range(w):
+            if not mask[r0, c0] or seen[r0, c0]:
+                continue
+            stack = [(r0, c0)]
+            seen[r0, c0] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                comp.append((r, c))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr = r + dr
+                    nc = c + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(points: Iterable[tuple[int, int]]) -> tuple[int, int, int, int]:
+    pts = list(points)
+    rs = [r for r, _ in pts]
+    cs = [c for _, c in pts]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    rows, cols = np.where(mask)
+    return mask[rows.min() : rows.max() + 1, cols.min() : cols.max() + 1]
+
+
+def _rotate_cw(mask: np.ndarray, turns: int) -> np.ndarray:
+    return np.rot90(mask, -(turns % 4))
+
+
+def _projection_origin(
+    frame_bbox: tuple[int, int, int, int],
+    grey_bbox: tuple[int, int, int, int],
+    proj_shape: tuple[int, int],
+    gap_side: str,
+) -> tuple[int, int]:
+    r0, c0, r1, c1 = frame_bbox
+    gr0, gc0, _gr1, _gc1 = grey_bbox
+    ph, pw = proj_shape
+    if gap_side == "up":
+        return r0 - ph, gc0
+    if gap_side == "down":
+        return r1 + 1, gc0
+    if gap_side == "left":
+        return gr0, c0 - pw
+    if gap_side == "right":
+        return gr0, c1 + 1
+    raise ValueError(gap_side)
