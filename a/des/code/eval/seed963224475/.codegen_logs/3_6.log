+    if np.any(grid[:strip_start, w - 1] != BG):
+        return None
+    grid[strip_start:, w - 1] = np.array(order_colors, dtype=int)
+    return grid
+
+
+def _latent_output(
+    grid: np.ndarray,
+    frames_by_color: dict[int, dict[str, int | tuple[int, int, int, int]]],
