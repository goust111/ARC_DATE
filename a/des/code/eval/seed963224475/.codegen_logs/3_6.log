+def _slice_has_occlusion(
+    grid: np.ndarray, frame: dict[str, int | tuple[int, int, int, int]]
+) -> bool:
+    _kind, piece = _extract_piece(grid, frame["bbox"], str(frame["side"]))  # type: ignore[index]
+    own = int(frame["color"])
+    return bool(np.any((piece != BG) & (piece != own)))
+
