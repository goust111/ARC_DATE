+def _infer_side(bbox: tuple[int, int, int, int], marker: tuple[int, int]) -> str:
+    r0, c0, r1, c1 = bbox
+    mr, mc = marker
+    if mr == r0 - 1 and c0 <= mc <= c1:
+        return "top"
+    if mr == r1 + 1 and c0 <= mc <= c1:
+        return "bottom"
+    if mc == c0 - 1 and r0 <= mr <= r1:
