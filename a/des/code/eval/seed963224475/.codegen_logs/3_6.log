+    work = g.copy()
+    work[strip_start:, -1] = BG
+
+    frame_colors = set(order_colors)
+    marker_map = _marker_assignments(work, frame_colors)
+
+    size = None
+    kinds: list[str] = []
+    pieces: list[np.ndarray] = []
+    for color in order_colors:
+        bbox = _visible_bbox(work, int(color))
