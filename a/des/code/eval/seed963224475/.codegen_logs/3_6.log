+
+def _latent_output(
+    grid: np.ndarray,
+    frames_by_color: dict[int, dict[str, int | tuple[int, int, int, int]]],
+    order_colors: list[int],
+) -> np.ndarray:
+    kinds: list[str] = []
+    pieces: list[np.ndarray] = []
+    for color in order_colors:
