+    side = frame["side"]  # type: ignore[index]
+    center = int(frame["center"])  # type: ignore[index]
+    if side == "top":
+        return r0 - 1, c0 + center
+    if side == "bottom":
+        return r1 + 1, c0 + center
+    if side == "left":
+        return r0 + center, c0 - 1
+    return r0 + center, c1 + 1
