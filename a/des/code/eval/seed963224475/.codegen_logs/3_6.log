+            if _infer_side(bbox, marker_map[color]) != frame["side"]:
+                return False
+            r0, c0, r1, c1 = bbox
+            edge = r1 - r0 + 1
+            if edge != c1 - c0 + 1:
+                return False
+            if size is None:
+                size = edge
+            elif edge != size:
+                return False
+
+        solved = main(grid)
+    except Exception:
+        return False
+    return np.array_equal(solved, expected)
+
+
