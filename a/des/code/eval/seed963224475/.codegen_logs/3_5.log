+    lanes = _mouth_lanes(direction, bbox)
+    active = [True] * len(lanes)
+    out: list[tuple[int, int]] = []
+    depth = 0
+    while any(active):
+        for idx, (sr, sc) in enumerate(lanes):
+            if not active[idx]:
+                continue
+            rr = sr + dr * depth
+            cc = sc + dc * depth
+            if not _in_bounds(shape, rr, cc):
+                active[idx] = False
+                continue
