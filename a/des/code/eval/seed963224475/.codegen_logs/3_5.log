+    wall: set[tuple[int, int]] = set()
+    interior: list[tuple[int, int]] = []
+
+    if direction == "up":
+        for r in range(height):
+            wall.add((r, 0))
+            wall.add((r, width - 1))
+        for c in range(width):
+            wall.add((height - 1, c))
+        interior = [(r, c) for r in range(height - 1) for c in range(1, width - 1)]
+    elif direction == "down":
+        for r in range(height):
+            wall.add((r, 0))
+            wall.add((r, width - 1))
+        for c in range(width):
+            wall.add((0, c))
+        interior = [(r, c) for r in range(1, height) for c in range(1, width - 1)]
+    elif direction == "left":
+        for c in range(width):
+            wall.add((0, c))
+            wall.add((height - 1, c))
+        for r in range(height):
+            wall.add((r, width - 1))
+        interior = [(r, c) for r in range(1, height - 1) for c in range(width - 1)]
+    else:
+        for c in range(width):
+            wall.add((0, c))
+            wall.add((height - 1, c))
+        for r in range(height):
