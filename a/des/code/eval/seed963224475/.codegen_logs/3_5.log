+def _dominant_color(grid: np.ndarray) -> int:
+    counts = np.bincount(grid.ravel(), minlength=10)
+    return int(np.argmax(counts))
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
