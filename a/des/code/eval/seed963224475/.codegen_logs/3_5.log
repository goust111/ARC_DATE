+    (1, -1),
+    (1, 0),
+    (1, 1),
+]
+
+ARROW_PATTERNS = {
+    "up": {(0, 1), (1, 0), (1, 2)},
+    "down": {(0, 0), (0, 2), (1, 1)},
+    "left": {(0, 1), (1, 0), (2, 1)},
+    "right": {(0, 0), (1, 1), (2, 0)},
+}
+
+GRID_H_RANGE = (16, 22)
+GRID_W_RANGE = (16, 22)
+OBJECT_COUNT_CHOICES = (2, 3, 4)
+OUTER_SIZE_RANGE = (4, 7)
+MAX_GENERATE_ATTEMPTS = 300
