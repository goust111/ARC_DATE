+    height, width = mask.shape
+    for r in range(height):
+        for c in range(width):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((int(cr), int(cc)))
+                for dr, dc in steps:
+                    nr, nc = cr + dr, cc + dc
+                    if (
+                        0 <= nr < height
+                        and 0 <= nc < width
+                        and bool(mask[nr, nc])
+                        and not bool(seen[nr, nc])
