+def _expanded(
+    cells: list[tuple[int, int]] | set[tuple[int, int]],
+    shape: tuple[int, int],
+    radius: int = 1,
+) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for dr in range(-radius, radius + 1):
+            for dc in range(-radius, radius + 1):
+                nr, nc = r + dr, c + dc
+                if _in_bounds(shape, nr, nc):
+                    out.add((int(nr), int(nc)))
+    return out
