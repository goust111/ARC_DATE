+    needed_colors = container_count * 2
+    if needed_colors > len(PALETTE):
+        return None
+    color_pool = random.sample(PALETTE, needed_colors)
+    wall_colors = color_pool[:container_count]
+    liquid_colors = color_pool[container_count:]
