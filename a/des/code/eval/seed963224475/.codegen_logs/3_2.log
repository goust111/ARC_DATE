+def _normalize(cells: set[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    min_r = min(r for r, _ in cells)
+    min_c = min(c for _, c in cells)
+    normalized = sorted((int(r - min_r), int(c - min_c)) for r, c in cells)
+    return tuple(normalized)
