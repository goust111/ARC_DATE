+
+
+def _growth_cells(
+    seed_cells: set[tuple[int, int]],
+    direction: str,
+    steps: int,
+    h: int,
+    w: int,
+) -> tuple[set[tuple[int, int]], bool]:
+    dr, dc = _DIRECTION_VECTORS[direction]
+    grown: set[tuple[int, int]] = set()
+    clipped = False
+    for r, c in seed_cells:
+        for step in range(1, int(steps) + 1):
+            rr = int(r + dr * step)
+            cc = int(c + dc * step)
+            if not (0 <= rr < h and 0 <= cc < w):
+                clipped = True
+                break
