+import numpy as np
+
+
+BG = 0
+WALL = 5
+OBJECT = 9
+PORTAL_COLORS = (1, 2, 3, 4, 6, 7, 8)
+
+TOP = 0
+RIGHT = 1
+BOTTOM = 2
+LEFT = 3
+
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
