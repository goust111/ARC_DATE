+def _rotate_vec(dr2: int, dc2: int, turns: int) -> tuple[int, int]:
+    turns %= 4
+    for _ in range(turns):
+        dr2, dc2 = dc2, -dr2
+    return dr2, dc2
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _room_contains(room: dict, r: int, c: int) -> bool:
+    return room["r0"] <= r <= room["r1"] and room["c0"] <= c <= room["c1"]
+
+
+def _wall_indices(g: np.ndarray) -> tuple[list[int], list[int]]:
