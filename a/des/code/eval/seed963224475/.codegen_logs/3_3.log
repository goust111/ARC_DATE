+        and not np.any(g[r, :] == OBJECT)
+        and np.all(g[r, :] != BG)
+    ]
+    wall_cols = [
+        c
+        for c in range(w)
+        if np.any(g[:, c] == WALL)
+        and not np.any(g[:, c] == OBJECT)
+        and np.all(g[:, c] != BG)
