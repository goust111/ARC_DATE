    ring = np.full((RING_SIZE, RING_SIZE), bg, dtype=int)
    palette = [color for color in COLOR_IDS if color != bg]
    unique_count = random.randint(RING_UNIQUE_MIN, RING_UNIQUE_MAX)
    chosen = random.sample(palette, unique_count)
