+    assert len(wall_rows) >= 2 and len(wall_cols) >= 2
+    assert wall_rows[0] == 0 and wall_rows[-1] == h - 1
+    assert wall_cols[0] == 0 and wall_cols[-1] == w - 1
+    return wall_rows, wall_cols
+
+
+def _build_rooms_from_grid(g: np.ndarray) -> list[dict]:
