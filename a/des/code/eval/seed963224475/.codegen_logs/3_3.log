+    if obj is None:
+        return None
+    src_coords, dst_coords = obj
+
+    inp = np.array(base, copy=True)
+    out = np.array(base, copy=True)
+    for r, c in src_coords:
+        inp[int(r), int(c)] = OBJECT
+    for r, c in dst_coords:
+        out[int(r), int(c)] = OBJECT
