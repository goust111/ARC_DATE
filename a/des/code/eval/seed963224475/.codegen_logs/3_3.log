+def _feasible_main_pairs(rooms: list[dict], turns: int) -> list[tuple[int, int, int, int]]:
+    choices = []
+    for src_room in rooms:
+        for src_side in src_room["available_sides"]:
+            dst_side = (int(src_side) + turns) % 4
+            for dst_room in rooms:
