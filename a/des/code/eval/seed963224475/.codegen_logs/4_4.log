+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MAROON = 9
+PIECE_COLORS = (1, 2, 3, 4, 6, 7, 8)
+
+WALL_FLAT = 0
+WALL_SLOT = 1
+WALL_TOOTH = 2
+
+SIDE_ORDER = ("top", "right", "bottom", "left")
+SIDE_TO_ROT = {"top": 0, "left": 1, "bottom": 2, "right": 3}
+SIDE_INDEX = {side: idx for idx, side in enumerate(SIDE_ORDER)}
+
+GEN_RETRIES = 400
