+        return False
+    r0, c0 = random.choice(positions)
+    patch_mask = patch != BLACK
+    sub = grid[r0 : r0 + ph, c0 : c0 + pw]
+    sub[patch_mask] = patch[patch_mask]
+    reserve[r0 : r0 + ph, c0 : c0 + pw] = True
+    return True
