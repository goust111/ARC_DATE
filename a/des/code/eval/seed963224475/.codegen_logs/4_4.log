+def _place_patch(
+    grid: np.ndarray,
+    reserve: np.ndarray,
+    patch: np.ndarray,
+    col_start: int,
+) -> bool:
+    h, w = grid.shape
+    ph, pw = patch.shape
+    positions: list[tuple[int, int]] = []
+    for r0 in range(0, h - ph + 1):
+        for c0 in range(col_start, w - pw + 1):
+            r_lo = max(0, r0 - 1)
+            r_hi = min(h, r0 + ph + 1)
+            c_lo = max(0, c0 - 1)
+            c_hi = min(w, c0 + pw + 1)
+            if bool(reserve[r_lo:r_hi, c_lo:c_hi].any()):
+                continue
+            positions.append((r0, c0))
