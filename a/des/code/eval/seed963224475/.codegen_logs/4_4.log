+        side_len = fw - 2 if side in ("top", "bottom") else fh - 2
+        cross_len = fh - 2 if side in ("top", "bottom") else fw - 2
+        span_lo = max(3, side_len // 2) if want_overlap else 3
+        span = random.randint(span_lo, side_len)
+        if want_overlap:
