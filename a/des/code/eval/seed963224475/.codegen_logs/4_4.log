+
+def _rect_for_candidate(cand: dict) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in cand["cells"]]
+    cols = [c for _r, c in cand["cells"]]
+    return min(rows), min(cols), max(rows), max(cols)
