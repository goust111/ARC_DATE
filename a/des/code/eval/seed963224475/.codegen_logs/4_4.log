+def _placement_origin(frame_shape: tuple[int, int], mask_shape: tuple[int, int], side: str, offset: int) -> tuple[int, int]:
+    fh, fw = frame_shape
+    h, w = mask_shape
+    if side == "top":
+        return 0, int(offset)
+    if side == "bottom":
+        return int(fh - h), int(offset)
+    if side == "left":
+        return int(offset), 0
+    if side == "right":
+        return int(offset), int(fw - w)
