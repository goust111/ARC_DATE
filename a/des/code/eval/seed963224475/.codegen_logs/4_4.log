+
+def _apply_wall_signature(frame: np.ndarray, side: str, offset: int, wall_sig: tuple[int, ...]) -> None:
+    h, w = frame.shape
+    if side == "top":
+        for i, kind in enumerate(wall_sig):
+            c = offset + i
+            if kind == WALL_SLOT:
+                frame[0, c] = BLACK
+            elif kind == WALL_TOOTH:
+                frame[1, c] = GREY
+        return
+    if side == "bottom":
+        for i, kind in enumerate(wall_sig):
+            c = offset + i
+            if kind == WALL_SLOT:
+                frame[h - 1, c] = BLACK
+            elif kind == WALL_TOOTH:
+                frame[h - 2, c] = GREY
+        return
+    if side == "left":
+        for i, kind in enumerate(wall_sig):
+            r = offset + i
+            if kind == WALL_SLOT:
+                frame[r, 0] = BLACK
+            elif kind == WALL_TOOTH:
+                frame[r, 1] = GREY
+        return
+    if side == "right":
+        for i, kind in enumerate(wall_sig):
+            r = offset + i
+            if kind == WALL_SLOT:
+                frame[r, w - 1] = BLACK
+            elif kind == WALL_TOOTH:
+                frame[r, w - 2] = GREY
+        return
+    raise ValueError(side)
