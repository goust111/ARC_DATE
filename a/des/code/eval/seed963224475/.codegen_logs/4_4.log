+def _placement_clear(frame: np.ndarray, mask: np.ndarray, r0: int, c0: int) -> bool:
+    fh, fw = frame.shape
+    h, w = mask.shape
+    if r0 < 0 or c0 < 0 or r0 + h > fh or c0 + w > fw:
+        return False
+    rows, cols = np.where(mask)
+    for dr, dc in zip(rows, cols):
+        if int(frame[int(r0 + dr), int(c0 + dc)]) == GREY:
