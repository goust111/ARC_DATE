+def _overlap_count(chosen: list[dict], frame_shape: tuple[int, int]) -> int:
+    counts = np.zeros(frame_shape, dtype=int)
+    for cand in chosen:
+        for r, c in cand["cells"]:
+            counts[r, c] += 1
+    return int((counts > 1).sum())
