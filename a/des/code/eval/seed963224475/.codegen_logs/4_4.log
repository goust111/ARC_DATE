+def _gen_attempt() -> Optional[np.ndarray]:
+    n_pieces = random.randint(2, 4)
+    want_overlap = bool(random.getrandbits(1))
+
+    fh = random.randint(9, 14)
+    fw = random.randint(9, 14)
+    frame = np.full((fh, fw), BLACK, dtype=int)
