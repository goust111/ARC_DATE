+    for c in grey_cols:
+        left_ok = c == 0 or not bool(np.all(grid[:, c - 1] == GREY))
+        right_ok = c == grid.shape[1] - 1 or not bool(np.all(grid[:, c + 1] == GREY))
+        if left_ok and right_ok:
