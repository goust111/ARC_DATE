+            else:
+                sig.append(WALL_FLAT)
+        return tuple(sig)
+    if side == "left":
+        assert 1 <= offset and offset + span - 1 <= h - 2
+        for r in range(offset, offset + span):
+            if int(frame[r, 1]) == GREY:
+                sig.append(WALL_TOOTH)
+            elif int(frame[r, 0]) == BLACK:
+                sig.append(WALL_SLOT)
+            else:
+                sig.append(WALL_FLAT)
