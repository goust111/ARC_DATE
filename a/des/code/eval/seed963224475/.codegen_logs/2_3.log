+def _paint_blocks(shape: tuple[int, int], bg: int, positions: dict[int, tuple[int, int]]) -> np.ndarray:
+    out = np.full(shape, bg, dtype=int)
+    for color, (r, c) in positions.items():
+        out[r : r + 2, c : c + 2] = int(color)
