+
+def _base_pair_candidates(
+    h: int,
+    w: int,
+    axis: str,
+    sign: int,
+    step1: int,
+    safe: int,
+) -> list[dict[str, object]]:
+    gap = step1 + safe + 2
+    out: list[dict[str, object]] = []
+    if axis == "h":
+        if w < gap + 4:
+            return out
+        for r in range(1, h - 2):
+            for c0 in range(1, w - gap - 2):
+                if sign > 0:
+                    apos = (r, c0)
+                    bpos = (r, c0 + gap)
+                    adir, bdir = "right", "left"
+                else:
+                    apos = (r, c0 + gap)
+                    bpos = (r, c0)
+                    adir, bdir = "left", "right"
+                out.append({"A": apos, "B": bpos, "adir": adir, "bdir": bdir})
