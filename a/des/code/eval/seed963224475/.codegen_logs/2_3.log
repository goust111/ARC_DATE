+def _all_l_placements(h: int, w: int, direction: str, steps: int) -> list[tuple[tuple[int, int, int], tuple[tuple[int, int], ...]]]:
+    placements: list[tuple[tuple[int, int, int], tuple[tuple[int, int], ...]]] = []
