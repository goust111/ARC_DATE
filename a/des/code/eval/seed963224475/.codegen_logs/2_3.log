+    direction: str,
+    steps: int,
+    h: int,
+    w: int,
+) -> tuple[dict[int, tuple[int, int]], int, str]:
+    dr, dc = DIRS[direction]
+    r, c = positions[color]
+    moved = 0
+    reason = "full"
+
+    while moved < steps:
+        nr, nc = r + dr, c + dc
+        if nr < 0 or nc < 0 or nr + 1 >= h or nc + 1 >= w:
+            reason = "boundary"
+            break
