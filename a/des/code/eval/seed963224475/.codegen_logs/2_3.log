+        if h < gap + 4:
+            return out
+        for c in range(1, w - 2):
+            for r0 in range(1, h - gap - 2):
+                if sign > 0:
+                    apos = (r0, c)
+                    bpos = (r0 + gap, c)
+                    adir, bdir = "down", "up"
+                else:
+                    apos = (r0 + gap, c)
+                    bpos = (r0, c)
