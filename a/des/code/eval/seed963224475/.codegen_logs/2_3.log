+        if rows != list(range(rows[0], rows[-1] + 1)):
+            continue
+        axis = {(r, c) for r in rows}
+        extra = pts - axis
+        if len(extra) != 1:
+            continue
+        er, ec = next(iter(extra))
+        if er not in (rows[0], rows[-1]) or abs(ec - c) != 1:
