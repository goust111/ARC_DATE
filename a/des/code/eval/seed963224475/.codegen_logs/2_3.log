+
+def _rects_overlap(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    return abs(a[0] - b[0]) < 2 and abs(a[1] - b[1]) < 2
+
+
+def _simulate_instruction(
+    positions: dict[int, tuple[int, int]],
