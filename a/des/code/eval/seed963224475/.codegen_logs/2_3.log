+    if direction == "down":
+        return [
+            [(0, c) for c in range(steps)] + [(1, 0)],
+            [(0, c) for c in range(steps)] + [(1, steps - 1)],
+        ]
+    if direction == "left":
+        return [
+            [(r, 1) for r in range(steps)] + [(0, 0)],
+            [(r, 1) for r in range(steps)] + [(steps - 1, 0)],
