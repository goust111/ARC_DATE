  FUNC 5: def main(grid: np.ndarray) -> np.ndarray:
   5: def main(grid: np.ndarray) -> np.ndarray:
   6:     """Shear the rectangular input down-left onto a black canvas.
   7: 
   8:     Input structure
   9:     A rectangular grid of colored pixels with no internal empty region to infer.
  10: 
  11:     Rule
  12:     Create a black output with the same height and width W + H - 1, then copy
  13:     each input row r unchanged starting at column H - 1 - r.
  14: 
  15:     Key insight
  16:     The colors and row contents are preserved; only the row offsets change so
  17:     the left edge forms a descending diagonal.
  18:     """
  19:     g = np.asarray(grid, dtype=int)
  20:     assert g.ndim == 2
  21:     h, w = g.shape
  22:     assert h > 0 and w > 0
  23: 
  24:     out = np.zeros((h, w + h - 1), dtype=int)
  25:     for r in range(h):
  26:         start = h - 1 - r
  27:         out[r, start : start + w] = g[r]
  28:     return out
  29: 
  30: # --------------- generator (att2, o5x) ---------------
  31: 
  32: # Canvas and palette bounds.
  33: MIN_HEIGHT, MAX_HEIGHT = 2, 10
  34: MIN_WIDTH, MAX_WIDTH = 1, 9
  35: MIN_COLOR_COUNT, MAX_COLOR_COUNT = 4, 5
  36: MAX_CELLS, MAX_OUTPUT_WIDTH = 36, 30
  37: PALETTE_VALUES = range(1, 10)
  38: 
  39: # Fill pattern controls.
  40: FILL_MODES = ("noise", "row_runs", "column_bands", "diagonal_bands")
  41: MAX_ROW_RUN_CUTS = 3
  42: COLUMN_NOISE_PROB = 0.5
  43: MIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND = 1, 3
  44: DIAGONAL_FLIP_PROB = 0.5
  45: 
  46: # Generation safety.
  47: GENERATION_RETRIES = 300
  48: 
  49: 
  50: def _ensure_palette_coverage(arr, palette):
  51:     positions = random.sample(range(arr.size), len(palette))
  52:     rows, cols = np.divmod(positions, arr.shape[1])
  53:     arr[rows, cols] = palette
  54: 
  55: 
  56: def _fill_grid(h, w, palette):
  57:     k = len(palette)
  58:     mode = random.choice(FILL_MODES)
  59:     arr = np.zeros((h, w), dtype=int)
  60: 
  61:     if mode == "noise":
  62:         arr[:] = np.random.choice(palette, size=(h, w))
  63:     elif mode == "row_runs":
  64:         for r in range(h):
  65:             cuts = sorted(random.sample(range(1, w), random.randint(0, min(w - 1, MAX_ROW_RUN_CUTS)))) if w > 1 else []
  66:             starts = [0] + cuts
  67:             ends = cuts + [w]
  68:             last = None
  69:             for c0, c1 in zip(starts, ends):
  70:                 choices = [c for c in palette if c != last] or list(palette)
  71:                 last = random.choice(choices)
  72:                 arr[r, c0:c1] = last
  73:     elif mode == "column_bands":
  74:         for c in range(w):
  75:             arr[:, c] = random.choice(palette)
  76:         if random.random() < COLUMN_NOISE_PROB:
  77:             for r in range(h):
  78:                 arr[r, random.randrange(w)] = random.choice(palette)
  79:     else:
  80:         band = random.randint(MIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND)
  81:         phase = random.randrange(k)
  82:         rows, cols = np.indices((h, w))
  83:         arr[:] = np.asarray(palette)[((rows + cols) // band + phase) % k]
  84:         if random.random() < DIAGONAL_FLIP_PROB:
  85:             arr = np.fliplr(arr)
  86: 
  87:     _ensure_palette_coverage(arr, palette)
  88:     return arr
  89: 
  90: 
  91: def _gen_attempt():
  92:     k = random.randint(MIN_COLOR_COUNT, MAX_COLOR_COUNT)
  93:     h = random.randint(MIN_HEIGHT, MAX_HEIGHT)
  94:     widths = [
  95:         w
  96:         for w in range(MIN_WIDTH, MAX_WIDTH + 1)
  97:         if h * w >= k and h * w <= MAX_CELLS and w + h - 1 <= MAX_OUTPUT_WIDTH
  98:     ]
  99:     if not widths:
 100:         return None
 101:     w = random.choice(widths)
 102:     palette = random.sample(PALETTE_VALUES, k)
 103:     return _fill_grid(h, w, palette)
 104: 
 105: 
 106: def generate_input():
 107:     for _ in range(GENERATION_RETRIES):
 108:         grid = _gen_attempt()
 109:         if grid is not None:
 110:             return grid
 111:     raise RuntimeError("failed to generate valid input")
