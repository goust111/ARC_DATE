+
+def _hole_offset(
+    frame_h: int,
+    frame_w: int,
+    thickness: int,
+    side: str,
+    patch: np.ndarray,
+) -> tuple[int, int] | None:
+    ph, pw = patch.shape
+    if side in ("top", "bottom"):
+        lo = thickness
+        hi = frame_w - thickness - pw
+        if hi < lo:
+            return None
+        c0 = random.randint(lo, hi)
+        r0 = 0 if side == "top" else frame_h - ph
+        return r0, c0
+    lo = thickness
+    hi = frame_h - thickness - ph
+    if hi < lo:
+        return None
+    r0 = random.randint(lo, hi)
+    c0 = 0 if side == "left" else frame_w - pw
+    return r0, c0
