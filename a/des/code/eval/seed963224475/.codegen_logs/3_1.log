+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _normalize(coords: list[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    r0, c0, _, _ = _bbox(coords)
+    return tuple(sorted((r - r0, c - c0) for r, c in coords))
+
+
+def _mask_from_coords(shape: tuple[int, int], coords: list[tuple[int, int]]) -> np.ndarray:
+    out = np.zeros(shape, dtype=bool)
+    for r, c in coords:
+        out[r, c] = True
+    return out
+
+
+def _band_mask(h: int, w: int, thickness: int) -> np.ndarray:
+    band = np.zeros((h, w), dtype=bool)
+    band[:thickness, :] = True
+    band[h - thickness :, :] = True
+    band[:, :thickness] = True
+    band[:, w - thickness :] = True
+    return band
+
+
+def _background_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[int(np.argmax(counts))])
+
+
+def _all_monochrome_components(grid: np.ndarray, bg: int) -> list[dict]:
+    comps: list[dict] = []
+    comp_id = 0
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != bg):
+        for coords in _components(grid == color):
+            bbox = _bbox(coords)
+            comps.append(
+                {
+                    "id": comp_id,
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": bbox,
+                }
+            )
+            comp_id += 1
+    return comps
+
