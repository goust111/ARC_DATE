+            thickness = random.choice(THICKNESS_CHOICES)
+            side = random.choice(SIDES)
+            base = random.choice(BASE_HOLE_PATCHES)
+            hole_patch = _rotated_patch(base, side)
+            shape = _shape_from_patch(hole_patch)
+            if shape in used_shapes:
