+LOCK_COUNT_RANGE = (2, 4)
+THICKNESS_CHOICES = [2, 3]
+FRAME_SIDE_MIN = 8
+FRAME_SIDE_MAX = 14
+FRAME_PADDING = 2
+PLACEMENT_TRIES = 200
+GEN_RETRIES = 400
