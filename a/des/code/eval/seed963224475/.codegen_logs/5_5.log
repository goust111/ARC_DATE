+        hole = sub == BG
+        assert hole.any(), "each rectangle must contain one hidden background pattern"
+        assert not hole[0, :].any()
+        assert not hole[-1, :].any()
+        assert not hole[:, 0].any()
+        assert not hole[:, -1].any()
