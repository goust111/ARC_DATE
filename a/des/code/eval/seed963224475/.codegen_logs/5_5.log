+def _gen_attempt() -> np.ndarray | None:
+    n = random.randint(*OBJECT_COUNT_RANGE)
+    colors = random.sample(COLOR_POOL, n)
+    used_areas: set[int] = set()
+    rects: list[dict] = []
+
+    for color in colors:
+        placed = False
+        for _ in range(80):
+            pattern = _random_pattern()
+            ph, pw = map(int, pattern.shape)
+            top = random.randint(*RECT_MARGIN_RANGE)
+            bottom = random.randint(*RECT_MARGIN_RANGE)
+            left = random.randint(*RECT_MARGIN_RANGE)
+            right = random.randint(*RECT_MARGIN_RANGE)
+            rh = ph + top + bottom
+            rw = pw + left + right
+            area = int(rh * rw)
+            if area in used_areas:
+                continue
+            used_areas.add(area)
+            rects.append(
+                {
+                    "color": int(color),
+                    "pattern": pattern,
+                    "top": int(top),
+                    "left": int(left),
+                    "height": int(rh),
+                    "width": int(rw),
+                }
+            )
+            placed = True
+            break
+        if not placed:
+            return None
+
+    grid = _place_rectangles(rects)
+    if grid is None:
+        return None
+
+    try:
+        layers = _extract_layers(grid)
+        out = main(grid)
+    except AssertionError:
+        return None
+
+    if len(layers) != n or out.size == 0:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

