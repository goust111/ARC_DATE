+
+def _ell_pattern(h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    corner = random.choice(["tl", "tr", "bl", "br"])
+    if corner == "tl":
+        mask[:, 0] = True
+        mask[-1, :] = True
+    elif corner == "tr":
+        mask[:, -1] = True
+        mask[-1, :] = True
+    elif corner == "bl":
+        mask[:, 0] = True
+        mask[0, :] = True
+    else:
+        mask[:, -1] = True
+        mask[0, :] = True
