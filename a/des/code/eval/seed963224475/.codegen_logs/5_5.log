+        if not placed:
+            return None
+
+    grid = _place_rectangles(rects)
+    if grid is None:
+        return None
+
+    try:
+        layers = _extract_layers(grid)
+        out = main(grid)
+    except AssertionError:
+        return None
+
+    if len(layers) != n or out.size == 0:
+        return None
+    return grid
