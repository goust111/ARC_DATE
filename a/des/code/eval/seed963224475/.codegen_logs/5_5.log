+    max_h = max(int(rect["height"]) for rect in rects)
+    max_w = max(int(rect["width"]) for rect in rects)
+    layout = random.choice(["balanced", "wide", "tall"])
+    base = int(np.ceil(np.sqrt(total_area * random.uniform(1.8, 2.3))))
+
+    if layout == "wide":
