+        mask[:, w // 2] = True
+    elif orientation == "down":
+        mask[-1, :] = True
+        mask[:, w // 2] = True
+    elif orientation == "left":
+        mask[:, 0] = True
+        mask[h // 2, :] = True
+    else:
+        mask[:, -1] = True
+        mask[h // 2, :] = True
+    return mask
