+
+def _organic_pattern(h: int, w: int) -> np.ndarray:
+    center = (h // 2, w // 2)
+    cells = {center}
+    targets = [
+        (0, random.randint(0, w - 1)),
+        (h - 1, random.randint(0, w - 1)),
+        (random.randint(0, h - 1), 0),
+        (random.randint(0, h - 1), w - 1),
+    ]
+    for target in targets:
