+            bottom = random.randint(*RECT_MARGIN_RANGE)
+            left = random.randint(*RECT_MARGIN_RANGE)
+            right = random.randint(*RECT_MARGIN_RANGE)
+            rh = ph + top + bottom
+            rw = pw + left + right
+            area = int(rh * rw)
+            if area in used_areas:
+                continue
+            used_areas.add(area)
+            rects.append(
