+# --------------- generator ---------------
+
+ROOM_COUNT_RANGE = (3, 5)
+ROOM_OUTER_SIZE_RANGE = (5, 7)
+MAX_GRID_SIDE = 30
+MAX_GENERATION_ATTEMPTS = 300
+ROOM_PLACEMENT_RETRIES = 100
+PATCH_RETRIES = 120
+OBJECT_RETRIES = 80
+SHAPE_RETRIES = 80
