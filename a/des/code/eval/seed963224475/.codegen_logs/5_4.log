+def _shared_door(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> tuple[tuple[int, int], tuple[int, int]] | None:
+    a0, a1, a2, a3 = a
+    b0, b1, b2, b3 = b
+    if a3 == b2 or b3 == a2:
