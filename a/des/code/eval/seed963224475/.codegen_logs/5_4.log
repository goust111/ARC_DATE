+def _sample_path(length: int) -> list[tuple[int, int]] | None:
+    path = [(0, 0)]
+    used = {(0, 0)}
+
+    def dfs() -> bool:
+        if len(path) == length:
+            return True
+        r, c = path[-1]
+        choices = [(r + dr, c + dc) for dr, dc in DIRS4]
+        random.shuffle(choices)
+        for cand in choices:
+            if cand in used:
+                continue
+            neighbors = sum((cand[0] + dr, cand[1] + dc) in used for dr, dc in DIRS4)
+            if neighbors != 1:
+                continue
+            used.add(cand)
+            path.append(cand)
+            if dfs():
+                return True
+            path.pop()
+            used.remove(cand)
+        return False
+
+    if dfs():
+        return path
+    return None
+
+
+def _axes_used(path: list[tuple[int, int]]) -> set[str]:
+    axes = set()
+    for (r0, c0), (r1, c1) in zip(path, path[1:]):
+        axes.add("row" if r0 != r1 else "col")
+    return axes
