+        lo = max(a0, b0) + 1
+        hi = min(a1, b1) - 2
+        if lo > hi:
+            return None
+        start = random.randint(lo, hi)
+        return ((start, wall_col), (start + 1, wall_col))
+    if a1 == b0 or b1 == a0:
+        wall_row = a1 if a1 == b0 else a0
