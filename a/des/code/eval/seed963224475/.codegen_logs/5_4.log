+    min_c = min(room["bbox"][2] for room in rooms)
+    max_r = max(room["bbox"][1] for room in rooms)
+    max_c = max(room["bbox"][3] for room in rooms)
+    shift_r = 1 - min_r
+    shift_c = 1 - min_c
+
+    shifted = []
+    for room in rooms:
+        r0, r1, c0, c1 = room["bbox"]
+        shifted.append(
