+def _door_start(line: np.ndarray) -> int | None:
+    assert np.all(np.isin(line, [GREY, YELLOW]))
+    door_idx = np.flatnonzero(line == YELLOW)
+    if len(door_idx) == 0:
+        return None
+    assert len(door_idx) == 2 and int(door_idx[1]) == int(door_idx[0]) + 1
+    return int(door_idx[0])
