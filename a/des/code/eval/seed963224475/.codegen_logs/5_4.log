+def _chain_order(rooms: list[dict], graph: dict[int, list[tuple[int, str, str]]]) -> tuple[list[int], list[str | None]]:
+    endpoints = [idx for idx, neighbors in graph.items() if len(neighbors) == 1]
+    assert len(endpoints) == 2
