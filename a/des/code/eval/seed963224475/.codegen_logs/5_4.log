def _room_graph(rooms: list[dict]) -> dict[int, list[tuple[int, str, str]]]:
    door_map: dict[tuple[tuple[int, int], tuple[int, int]], list[tuple[int, str]]] = defaultdict(list)
    for idx, room in enumerate(rooms):
