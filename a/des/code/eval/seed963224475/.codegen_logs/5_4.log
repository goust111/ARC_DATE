+def _extract_rooms(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    walkable = (g != GREY) & (g != YELLOW)
+    rooms: list[dict] = []
+    for cells, touches_border in _components(walkable):
+        if touches_border:
+            continue
