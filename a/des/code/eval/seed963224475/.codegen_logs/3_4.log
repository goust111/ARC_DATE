+            is_seam = any(
+                0 <= nr < H and 0 <= nc < W and int(labels[nr, nc]) != lab
+                for nr, nc in _neighbors4(r, c)
+            )
+            seam[r, c] = bool(is_seam)
+            if is_seam and ((r + c) & 1) == green_parity:
+                assembled[r, c] = GREEN
