+        return None
+
+    labels = np.zeros((H, W), dtype=int)
+    for c, cuts in enumerate(cols):
+        prev = -1
+        for band, y in enumerate(cuts):
+            labels[prev + 1 : y + 1, c] = int(band)
+            prev = int(y)
+        labels[prev + 1 :, c] = int(cut_count)
