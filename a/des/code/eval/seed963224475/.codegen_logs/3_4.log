+                for pi in sorted(grouped, key=lambda p: (len(grouped[p]), p)):
+                    for cid in grouped[pi]:
+                        chosen.append(cid)
+                        search(
+                            used_mask | int(candidates[cid]["mask"]),
+                            used_pieces_mask | (1 << pi),
+                        )
+                        chosen.pop()
+                        if len(solutions) >= solution_limit:
+                            return
+
+            search(0, 0)
+            if len(solutions) >= solution_limit:
+                return solutions[:solution_limit]
