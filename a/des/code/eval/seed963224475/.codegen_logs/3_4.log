+            chosen: list[int] = []
+
+            def search(used_mask: int, used_pieces_mask: int) -> None:
+                if len(solutions) >= solution_limit:
+                    return
+                if used_mask == full_mask:
+                    if used_pieces_mask == all_piece_mask:
