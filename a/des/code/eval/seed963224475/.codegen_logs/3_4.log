+
+def _apply_symmetry(arr: np.ndarray, kind: str) -> np.ndarray:
+    if kind == "both":
+        return np.rot90(arr, 2).copy()
+    if kind == "h":
+        return np.flipud(arr).copy()
+    if kind == "v":
+        return np.fliplr(arr).copy()
+    raise ValueError(kind)
+
