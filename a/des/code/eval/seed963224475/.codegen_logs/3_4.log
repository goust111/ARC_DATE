+def _valid_boundaries(cuts: list[int], total: int, min_width: int) -> bool:
+    prev = -1
+    k = len(cuts)
+    for j, x in enumerate(cuts):
+        lo = (prev + min_width) if j else (min_width - 1)
+        hi = total - 1 - (k - j) * min_width
+        if not (lo <= x <= hi):
+            return False
+        prev = x
+    return True
