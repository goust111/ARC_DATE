import random
from collections import deque

def conn(labels, k):
    H=len(labels); W=len(labels[0])
    pts=[(r,c) for r in range(H) for c in range(W) if labels[r][c]==k]
    if not pts: return False,0
    seen={pts[0]}; dq=deque([pts[0]])
    while dq:
        r,c=dq.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and labels[nr][nc]==k and (nr,nc) not in seen:
                seen.add((nr,nc)); dq.append((nr,nc))
    return len(seen)==len(pts), len(pts)


def valid(cuts,W,m):
    prev=-1
    for j,x in enumerate(cuts):
        lo=(prev+m) if j else (m-1)
        hi=W-1-(len(cuts)-j)*m
        if not (lo<=x<=hi):
            return False
        prev=x
    return True


def gen_vert(H,W,k,m=1):
    for _ in range(1000):
        # initial cuts from widths
        extra=W-m*(k+1)
        parts=[0]*(k+1)
        for _ in range(extra):
            parts[random.randrange(k+1)] +=1
        widths=[m+x for x in parts]
        cuts=[]; s=0
        for w in widths[:-1]:
            s+=w; cuts.append(s-1)
        top=[cuts]
        rows=H//2+1
        ok=True
        for _r in range(1,rows):
            prev=top[-1]
            cand=None
            for _ in range(40):
                arr=[prev[j]+random.choice([-1,0,1]) for j in range(k)]
                if valid(arr,W,m):
                    cand=arr; break
            if cand is None:
                ok=False; break
            top.append(cand)
        if not ok: continue
        full=top+top[-2::-1]
        labels=[[0]*W for _ in range(H)]
        for r,row in enumerate(full):
            a=0
            prev=-1
            for j,x in enumerate(row):
                for c in range(prev+1,x+1):
                    labels[r][c]=j
                prev=x
            for c in range(prev+1,W):
                labels[r][c]=k
        if any(not conn(labels,i)[0] for i in range(k+1)): continue
        if len({tuple(x) for x in full})==1 and widths==widths[::-1]:
            continue
        return labels
    return None


def gen_horiz(H,W,k,m=1):
    for _ in range(1000):
        extra=H-m*(k+1)
        parts=[0]*(k+1)
        for _ in range(extra):
            parts[random.randrange(k+1)] +=1
        heights=[m+x for x in parts]
        cuts=[]; s=0
        for h in heights[:-1]:
            s+=h; cuts.append(s-1)
        left=[cuts]
        cols=W//2+1
        ok=True
        for _c in range(1,cols):
            prev=left[-1]
            cand=None
            for _ in range(40):
                arr=[prev[j]+random.choice([-1,0,1]) for j in range(k)]
                if valid(arr,H,m):
                    cand=arr; break
            if cand is None:
                ok=False; break
            left.append(cand)
        if not ok: continue
        full=left+left[-2::-1]
        labels=[[0]*W for _ in range(H)]
        for c,colcuts in enumerate(full):
            prev=-1
            for j,y in enumerate(colcuts):
                for r in range(prev+1,y+1):
                    labels[r][c]=j
                prev=y
            for r in range(prev+1,H):
                labels[r][c]=k
        if any(not conn(labels,i)[0] for i in range(k+1)): continue
        return labels
    return None


def gen_cross(H,W,m_side=1,m_mid=3):
    for _ in range(1000):
        max_x=(W-2-m_mid)//2
        max_y=(H-2-m_mid)//2
        if max_x < m_side-1 or max_y < m_side-1:
            return None
        rows=H//2+1
        x0=random.randint(m_side-1, max_x)
        xtop=[x0]
        ok=True
        for _r in range(1,rows):
            prev=xtop[-1]
            cand=None
            for _ in range(40):
                v=prev+random.choice([-1,0,1])
                if m_side-1 <= v <= max_x:
                    cand=v; break
            if cand is None:
                ok=False; break
            xtop.append(cand)
        if not ok: continue
        xL=xtop+xtop[-2::-1]
        cols=W//2+1
        y0=random.randint(m_side-1, max_y)
        yleft=[y0]
        ok=True
        for _c in range(1,cols):
            prev=yleft[-1]
            cand=None
            for _ in range(40):
                v=prev+random.choice([-1,0,1])
                if m_side-1 <= v <= max_y:
                    cand=v; break
            if cand is None:
                ok=False; break
            yleft.append(cand)
        if not ok: continue
        yT=yleft+yleft[-2::-1]
        labels=[[0]*W for _ in range(H)]
        for r in range(H):
            xl=xL[r]
            xr=W-2-xl
            for c in range(W):
                yt=yT[c]
                yb=H-2-yt
                if c <= xl:
                    lab=0
                elif c > xr:
                    lab=1
                elif r <= yt:
                    lab=2
                elif r > yb:
                    lab=3
                else:
                    lab=4
                labels[r][c]=lab
        if any(not conn(labels,i)[0] for i in range(5)): continue
        return labels
    return None


def seam(labels):
    H=len(labels);W=len(labels[0])
    s=[[0]*W for _ in range(H)]
    for r in range(H):
        for c in range(W):
            a=labels[r][c]
            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                nr,nc=r+dr,c+dc
                if 0<=nr<H and 0<=nc<W and labels[nr][nc]"'!=a:
                    s[r][c]=1; break
    return s

def sym(mask,kind):
    H=len(mask);W=len(mask[0])
