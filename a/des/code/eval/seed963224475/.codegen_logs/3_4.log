+    max_w = max(int(piece["shape"][1]) for piece in pieces)
+    piece_count = len(pieces)
+    all_piece_mask = (1 << piece_count) - 1
+
+    dims = [
+        (H, W)
+        for H, W in _factor_pairs(total_area)
+        if H >= max_h and W >= max_w
