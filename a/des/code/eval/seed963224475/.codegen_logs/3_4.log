+        return None
+    slack = [0] * (cut_count + 1)
+    for _ in range(extra):
+        slack[RNG.randrange(cut_count + 1)] += 1
+    widths = [min_width + x for x in slack]
+    cuts: list[int] = []
+    acc = 0
+    for width in widths[:-1]:
+        acc += width
+        cuts.append(acc - 1)
