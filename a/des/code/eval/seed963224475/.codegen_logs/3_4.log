+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 8
+GREEN = 3
+PALETTE = (0, 1, 2, 4, 5, 6, 7, 9)
+RNG = random.Random()
+GEN_RETRIES = 300
