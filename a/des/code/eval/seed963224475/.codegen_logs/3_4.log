+def _piece_bbox_area(mask: np.ndarray) -> int:
+    coords = np.argwhere(mask)
+    rs = coords[:, 0]
+    cs = coords[:, 1]
+    return int((rs.max() - rs.min() + 1) * (cs.max() - cs.min() + 1))
