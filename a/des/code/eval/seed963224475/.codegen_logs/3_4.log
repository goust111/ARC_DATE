+            color_b = bmap.get(nb)
+            if color_b is not None and ((int(color_a) == GREEN) == (int(color_b) == GREEN)):
+                return False
+        if c > 0:
+            nb = idx - 1
+            color_b = bmap.get(nb)
+            if color_b is not None and ((int(color_a) == GREEN) == (int(color_b) == GREEN)):
+                return False
+        if c + 1 < W:
+            nb = idx + 1
+            color_b = bmap.get(nb)
+            if color_b is not None and ((int(color_a) == GREEN) == (int(color_b) == GREEN)):
+                return False
