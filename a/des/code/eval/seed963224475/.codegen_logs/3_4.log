+def _generate_both_branch() -> np.ndarray | None:
+    H = RNG.choice((7, 9))
+    W = RNG.choice((7, 9))
+    min_mid = 3
+    max_x = (W - 2 - min_mid) // 2
+    max_y = (H - 2 - min_mid) // 2
+    if max_x < 0 or max_y < 0:
+        return None
+
+    x_top = [RNG.randint(0, max_x)]
+    for _ in range(1, H // 2 + 1):
+        prev = x_top[-1]
+        nxt = None
+        for _ in range(40):
+            cand = int(prev + RNG.choice((-1, 0, 1)))
+            if 0 <= cand <= max_x:
+                nxt = cand
+                break
+        if nxt is None:
+            return None
+        x_top.append(nxt)
+    x_left = x_top + x_top[-2::-1]
+
+    y_left = [RNG.randint(0, max_y)]
+    for _ in range(1, W // 2 + 1):
+        prev = y_left[-1]
+        nxt = None
+        for _ in range(40):
+            cand = int(prev + RNG.choice((-1, 0, 1)))
+            if 0 <= cand <= max_y:
+                nxt = cand
+                break
+        if nxt is None:
+            return None
+        y_left.append(nxt)
+    y_top = y_left + y_left[-2::-1]
+
+    labels = np.zeros((H, W), dtype=int)
+    for r in range(H):
+        xl = int(x_left[r])
