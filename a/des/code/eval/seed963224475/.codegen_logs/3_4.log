+    widths = [min_width + x for x in slack]
+    cuts: list[int] = []
+    acc = 0
+    for width in widths[:-1]:
+        acc += width
+        cuts.append(acc - 1)
+
+    top = [cuts]
+    for _ in range(1, H // 2 + 1):
+        prev = top[-1]
+        nxt = None
+        for _ in range(50):
