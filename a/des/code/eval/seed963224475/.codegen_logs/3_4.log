+                cell = _first_set_bit(full_mask ^ used_mask)
+                grouped: dict[int, list[int]] = {}
+                for cid in cover_by_cell[cell]:
+                    cand = candidates[cid]
+                    pi = int(cand["piece"])
+                    if (used_pieces_mask >> pi) & 1:
