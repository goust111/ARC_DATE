+def _symmetry_kind(green_mask: np.ndarray) -> str:
+    sym_h = bool(np.array_equal(green_mask, np.flipud(green_mask)))
+    sym_v = bool(np.array_equal(green_mask, np.fliplr(green_mask)))
+    if sym_h and sym_v:
+        return "both"
+    if sym_h:
+        return "h"
+    if sym_v:
+        return "v"
