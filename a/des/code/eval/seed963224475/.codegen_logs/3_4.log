+        colors = {int(g[r, c]) for r, c in comp}
+        non_green = sorted(col for col in colors if col != GREEN)
+        assert len(non_green) == 1, "each fragment must have one main color"
+        main_color = int(non_green[0])
+        r0, c0, r1, c1 = _bbox(comp)
