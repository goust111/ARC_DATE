+                    cover_by_cell[idx].append(cid)
+            if len(candidates) == start:
+                break
+        else:
+            compat: list[set[int]] = [set() for _ in candidates]
+            for i in range(len(candidates)):
+                compat[i].add(i)
+            for i in range(len(candidates)):
