+            sub = grid[r0 : r0 + ph, c0 : c0 + pw]
+            sub[mask] = patch[mask]
+            occupied[r0 : r0 + ph, c0 : c0 + pw] |= mask
+            blocked = _dilate8(occupied)
+            placed = True
