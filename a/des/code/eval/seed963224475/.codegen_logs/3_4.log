+    top = [cuts]
+    for _ in range(1, H // 2 + 1):
+        prev = top[-1]
+        nxt = None
+        for _ in range(50):
+            cand = [int(prev[j] + RNG.choice((-1, 0, 1))) for j in range(cut_count)]
+            if _valid_boundaries(cand, W, min_width):
+                nxt = cand
+                break
+        if nxt is None:
