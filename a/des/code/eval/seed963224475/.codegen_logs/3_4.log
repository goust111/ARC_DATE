+            return None
+        y_left.append(nxt)
+    y_top = y_left + y_left[-2::-1]
+
+    labels = np.zeros((H, W), dtype=int)
+    for r in range(H):
+        xl = int(x_left[r])
+        xr = int(W - 2 - xl)
