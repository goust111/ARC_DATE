+def _placements_compatible(a: dict, b: dict, H: int, W: int) -> bool:
+    if int(a["mask"]) & int(b["mask"]):
+        return False
+    bmap = b["cell_map"]
+    for idx, color_a in a["cell_items"]:
+        r = idx // W
+        c = idx % W
+        if r > 0:
+            nb = idx - W
+            color_b = bmap.get(nb)
+            if color_b is not None and ((int(color_a) == GREEN) == (int(color_b) == GREEN)):
+                return False
+        if r + 1 < H:
