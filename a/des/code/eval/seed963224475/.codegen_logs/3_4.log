+    solutions: list[dict] = []
+    for H, W in dims:
+        full_mask = (1 << (H * W)) - 1
+        candidates: list[dict] = []
+        piece_to_candidates: list[list[int]] = [[] for _ in pieces]
+        cover_by_cell: list[list[int]] = [[] for _ in range(H * W)]
