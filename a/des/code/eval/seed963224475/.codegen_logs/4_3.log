+        if not markers:
+            continue
+        marker = random.choice(markers)
+        shadow = _shadow_cells(region, direction, depth)
+        footprint = set(region)
+        footprint.add(marker)
+        footprint |= shadow
+        return {
+            "region": region,
+            "direction": direction,
+            "marker": marker,
+            "shadow": shadow,
+            "footprint": footprint,
+            "color": color,
+            "area": len(region),
+            "kind": kind,
+        }
+    return None
+
+
+def _demo_positions(corner: str, h: int, w: int) -> dict[tuple[int, int], int]:
