+
+BG = 8
+GREY = 5
+BLACK = 0
+REGION_COLORS = (1, 2, 3, 4, 6, 7, 9)
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
