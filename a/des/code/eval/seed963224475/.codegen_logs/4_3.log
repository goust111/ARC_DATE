    max_row = GEN_GRID_SIZE - GEN_MARGIN - obj_h
    max_col = GEN_GRID_SIZE - GEN_MARGIN - obj_w - shift
    return None if max_col < 0 else (random.randint(GEN_MARGIN, max_row), random.randint(GEN_MARGIN, max_col))


