+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            rows = [rr for rr, _ in pts]
+            cols = [cc for _, cc in pts]
+            comps.append(
+                {
+                    "color": color,
+                    "cells": pts,
+                    "set": set(pts),
+                    "area": len(pts),
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
