+        for c in range(w):
+            color = int(grid[r, c])
+            if seen[r, c] or color in excluded:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            pts = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
