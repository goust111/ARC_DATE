+def _translate(cells: set[tuple[int, int]], off_r: int, off_c: int) -> set[tuple[int, int]]:
+    return {(r + off_r, c + off_c) for r, c in cells}
+
+
+def _expanded(cells: set[tuple[int, int]], h: int, w: int, pad: int = 1) -> set[tuple[int, int]]:
+    out = set()
+    for r, c in cells:
