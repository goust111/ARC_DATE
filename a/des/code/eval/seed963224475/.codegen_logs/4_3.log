+
+
+def _overlap(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    return not (a[1] < b[0] or b[1] < a[0])
+
+
+def _column_strip(box_h: int, box_w: int) -> set[tuple[int, int]] | None:
