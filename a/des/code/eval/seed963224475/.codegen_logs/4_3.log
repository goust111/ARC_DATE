+            "marker": next(iter(_translate({spec["marker"]}, off_r, off_c))),
+            "direction": spec["direction"],
+            "color": spec["color"],
+            "area": spec["area"],
+            "kind": spec["kind"],
+            "reserve": reserve,
+        }
