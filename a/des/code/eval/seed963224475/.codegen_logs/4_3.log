    upper = np.full((half_h, max_w), GEN_BG, dtype=int)
    for r, (left, width) in enumerate(zip(lefts, widths)):
        right = left + width
        upper[r, left:right] = fill_color
        upper[r, left] = border_color
        upper[r, right - 1] = border_color
    return upper


