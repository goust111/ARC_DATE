+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    for dr, dc in DIR4:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            yield nr, nc
+
+
+def _sign(x: int) -> int:
+    return 0 if x == 0 else (1 if x > 0 else -1)
+
+
+def _color_components(grid: np.ndarray, excluded: set[int]) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if seen[r, c] or color in excluded:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            pts = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            rows = [rr for rr, _ in pts]
+            cols = [cc for _, cc in pts]
+            comps.append(
+                {
+                    "color": color,
+                    "cells": pts,
+                    "set": set(pts),
+                    "area": len(pts),
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                }
+            )
+    return comps
+
+
+def _orientation_and_depth(cells: set[tuple[int, int]]) -> tuple[str, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    height = max(rows) - min(rows) + 1
+    width = max(cols) - min(cols) + 1
