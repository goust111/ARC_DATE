+            return False
+    return True
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(16, 24)
+    w = rng.randint(16, 24)
+    grid = np.full((h, w), BLACK, dtype=int)
+    occupied = np.zeros((h, w), dtype=bool)
+    forbidden = np.zeros((h, w), dtype=bool)
