+            hit_r = rng.randint(r_lo, r_hi)
+            hit_c = rng.randint(c_lo, c_hi)
+            tower_pos = (hit_r, hit_c - tower_gap) if tower_side == "left" else (hit_r, hit_c + tower_gap)
+            mirror_rows = list(range(hit_r - mirror_len + 1, hit_r + 1))
