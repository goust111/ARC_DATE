+    if incoming_seen != {"h", "v"}:
+        return False
+    if not hit_screens or len(hit_screens) == len(towers):
+        return False
+    if len(set(hit_screens)) != len(hit_screens):
+        return False
+    if len(set(hit_screens)) >= len(screens):
+        return False
+
+    try:
+        out = main(grid)
+    except AssertionError:
+        return False
