+
+        if direction == "down":
+            tower_side = rng.choice(("left", "right"))
+            c_lo = tower_gap if tower_side == "left" else 0
+            c_hi = (w - 1) if tower_side == "left" else (w - 1 - tower_gap)
+            r_lo = 0
+            r_hi = h - mirror_len
+            if will_hit:
+                r_hi = min(r_hi, h - mirror_len - screen_gap - screen_size)
+            if c_lo > c_hi or r_lo > r_hi:
