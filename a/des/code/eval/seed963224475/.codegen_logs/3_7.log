+            r_hi = (h - 1) if tower_side == "up" else (h - 1 - tower_gap)
+            c_lo = 0
+            c_hi = w - mirror_len
+            if will_hit:
+                c_hi = min(c_hi, w - mirror_len - screen_gap - screen_size)
