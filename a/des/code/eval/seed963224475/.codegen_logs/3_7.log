+        elif mirror["orientation"] == "h" and c0 <= c <= c1 and r != r0:
+            hit = (r0, c)
+            if _clear_segment(g, (r, c), hit):
+                candidates.append(
+                    {"distance": abs(r - r0), "incoming": "v", "hit": hit, "mirror": mirror}
