+        down_len = r1 - hr
+        assert up_len != down_len, "ambiguous vertical reflection"
+        return (-1, 0) if up_len > down_len else (1, 0)
+    left_len = hc - c0
+    right_len = c1 - hc
+    assert left_len != right_len, "ambiguous horizontal reflection"
+    return (0, -1) if left_len > right_len else (0, 1)
