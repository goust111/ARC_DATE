+def _is_single_cycle(grid: np.ndarray, color: int) -> bool:
+    mask = grid == int(color)
+    comps = _components(mask)
+    if len(comps) != 1:
+        return False
+    h, w = grid.shape
+    return all(
+        sum(1 for nr, nc in _neighbors4(h, w, r, c) if int(grid[nr, nc]) == int(color)) == 2
+        for r, c in comps[0]
+    )
