+    expected = _fill_ranked_regions(closed)
+    got = main(broken)
+    if not np.array_equal(got, expected):
+        return None
+
+    return broken
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        case = _generate_case()
+        if case is not None:
+            return case
+    raise RuntimeError("generate_input failed after repeated retries")

