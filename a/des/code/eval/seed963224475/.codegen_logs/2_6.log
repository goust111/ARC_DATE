+    w = random.randint(4, min(max_w, 11))
+    vertices = [(0, 0), (0, w - 1), (h - 1, w - 1), (h - 1, 0)]
+    boundary = _trace_boundary(vertices)
+    return {
+        "height": h,
+        "width": w,
+        "boundary": boundary,
+        "turns": set(vertices),
+        "area": (h - 2) * (w - 2),
