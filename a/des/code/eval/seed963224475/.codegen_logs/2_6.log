+    areas = [
+        len(comp)
+        for comp in _components(~mask)
+        if not any(r == 0 or c == 0 or r == height - 1 or c == width - 1 for r, c in comp)
+    ]
+    assert len(areas) == 1
+    return int(areas[0])
