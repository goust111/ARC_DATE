+def _notched_shape(max_h: int, max_w: int) -> dict[str, object] | None:
+    if max_h < 8 or max_w < 8:
+        return None
+
+    valid_sides: list[str] = []
+    if max_h >= 8 and max_w >= 10:
+        valid_sides.extend(["top", "bottom"])
