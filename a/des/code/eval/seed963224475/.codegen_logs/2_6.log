+def _break_turns(grid: np.ndarray, placements: list[dict[str, object]]) -> np.ndarray:
+    broken = np.array(grid, dtype=int, copy=True)
+    for placed in placements:
+        r0 = int(placed["r0"])
+        c0 = int(placed["c0"])
+        for tr, tc in placed["turns"]:
+            broken[r0 + tr, c0 + tc] = BG
+    return broken
+
