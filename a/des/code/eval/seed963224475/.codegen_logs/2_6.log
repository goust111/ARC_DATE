+        depth = random.randint(3, h - 4)
+        if side == "top":
+            vertices = [
+                (0, 0),
+                (0, left),
+                (depth, left),
+                (depth, left + span),
+                (0, left + span),
+                (0, w - 1),
+                (h - 1, w - 1),
+                (h - 1, 0),
+            ]
+        else:
+            vertices = [
+                (0, 0),
+                (0, w - 1),
+                (h - 1, w - 1),
+                (h - 1, left + span),
+                (h - 1 - depth, left + span),
+                (h - 1 - depth, left),
+                (h - 1, left),
+                (h - 1, 0),
+            ]
+    else:
+        h = random.randint(10, min(max_h, 14))
+        w = random.randint(8, min(max_w, 13))
+        if h < 10 or w < 8:
+            return None
+        top = random.randint(3, h - 7)
+        span = random.randint(3, h - top - 4)
+        depth = random.randint(3, w - 4)
+        if side == "left":
+            vertices = [
+                (0, 0),
+                (0, w - 1),
+                (h - 1, w - 1),
+                (h - 1, 0),
+                (top + span, 0),
+                (top + span, depth),
+                (top, depth),
+                (top, 0),
+            ]
+        else:
+            vertices = [
+                (0, 0),
+                (0, w - 1),
+                (top, w - 1),
+                (top, w - 1 - depth),
+                (top + span, w - 1 - depth),
+                (top + span, w - 1),
+                (h - 1, w - 1),
+                (h - 1, 0),
+            ]
+
+    boundary = _trace_boundary(vertices)
+    return {
+        "height": h,
+        "width": w,
+        "boundary": boundary,
+        "turns": set(vertices),
+        "area": _local_area(h, w, boundary),
+    }
+
+
+def _sample_shape(max_h: int, max_w: int) -> dict[str, object] | None:
