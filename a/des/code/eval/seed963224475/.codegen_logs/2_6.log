+SLOT_RETRIES = 80
+SHAPE_RETRIES = 80
+
+
+def _in_bounds(h: int, w: int, r: int, c: int) -> bool:
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(h: int, w: int, r: int, c: int):
+    for dr, dc in DIRS4:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            yield nr, nc
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(h, w, cr, cc):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _repair_loops(grid: np.ndarray) -> np.ndarray:
+    g = np.array(grid, dtype=int, copy=True)
+    h, w = g.shape
+    colors = [int(v) for v in np.unique(g) if int(v) != BG]
+
+    changed = True
+    while changed:
+        changed = False
+        for color in colors:
+            targets: dict[tuple[int, int], list[tuple[int, int]]] = defaultdict(list)
+            for r, c in np.argwhere(g == int(color)):
+                r = int(r)
+                c = int(c)
+                same = [(nr, nc) for nr, nc in _neighbors4(h, w, r, c) if int(g[nr, nc]) == int(color)]
+                if len(same) != 1:
+                    continue
+                nr, nc = same[0]
+                tr, tc = 2 * r - nr, 2 * c - nc
+                if _in_bounds(h, w, tr, tc) and int(g[tr, tc]) == BG:
+                    targets[(tr, tc)].append((r, c))
+            for (tr, tc), endpoints in targets.items():
+                if len(endpoints) == 2:
+                    g[tr, tc] = int(color)
+                    changed = True
