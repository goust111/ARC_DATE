+def _quadrant_bounds(h: int, w: int, mid_r: int, mid_c: int) -> list[Bounds]:
+    return [
+        (0, mid_r, 0, mid_c),
+        (0, mid_r, mid_c + 1, w),
+        (mid_r + 1, h, 0, mid_c),
+        (mid_r + 1, h, mid_c + 1, w),
+    ]
