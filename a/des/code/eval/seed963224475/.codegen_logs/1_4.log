+    min_c = left + 1
+    max_c = qw - right - 2
+    assert min_r <= max_r and min_c <= max_c
+    return random.randint(min_r, max_r), random.randint(min_c, max_c)
+
+
+def _paint_cross(grid: np.ndarray, bounds: Bounds, seed: tuple[int, int], color: int, arms: Arms, full: bool) -> None:
+    r0, r1, c0, c1 = bounds
