+def _pattern_info(grid: np.ndarray, bg: int, frame: dict) -> tuple[list[tuple[int, int]], int]:
+    r0, c0, r1, c1 = frame["bbox"]
+    cells = [
+        (r, c)
+        for r in range(r0 + 1, r1)
+        for c in range(c0 + 1, c1)
+        if int(grid[r, c]) != bg
