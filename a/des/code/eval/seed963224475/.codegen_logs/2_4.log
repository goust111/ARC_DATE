+import random
+from dataclasses import dataclass
+
+import numpy as np
+
+
+BG = 0
+SIDES = ("top", "bottom", "left", "right")
+DIRS = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+GEN_RETRIES = 500
+
+
+@dataclass(frozen=True)
+class FrameSpec:
+    bbox: tuple[int, int, int, int]
+    side: str
+    door: tuple[int, int]
+    border_colors: tuple[int, int]
+    same_flanks: bool
+    pattern_color: int
+    pattern_cells: tuple[tuple[int, int], ...]
