+
+def _draw_border(grid: np.ndarray, spec: FrameSpec, rng: random.Random) -> None:
+    r0, c0, r1, c1 = spec.bbox
+    colors = spec.border_colors
+
+    corner_cells = ((r0, c0), (r0, c1), (r1, c0), (r1, c1))
