+            continue
+        colors = sorted({int(grid[r, c]) for r, c in comp})
+        if len(colors) != 2:
+            continue
+        if door[0] == r0:
+            side = "top"
+        elif door[0] == r1:
+            side = "bottom"
+        elif door[1] == c0:
+            side = "left"
+        else:
+            side = "right"
+        frames.append(
+            {
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "door": (int(door[0]), int(door[1])),
+                "side": side,
+                "border_cells": pset,
+            }
+        )
+    frames.sort(key=lambda item: item["bbox"])
+    return frames
