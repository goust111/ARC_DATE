+
+
+def _bbox_clear(existing: list[FrameSpec], bbox: tuple[int, int, int, int], pad: int = 1) -> bool:
+    r0, c0, r1, c1 = bbox
+    for spec in existing:
+        sr0, sc0, sr1, sc1 = spec.bbox
+        if not (r1 + pad < sr0 or sr1 + pad < r0 or c1 + pad < sc0 or sc1 + pad < c0):
+            return False
+    return True
+
+
+def _valid_boundary_sides(bbox: tuple[int, int, int, int], h: int, w: int, min_space: int = 2) -> list[str]:
+    r0, c0, r1, c1 = bbox
+    sides = []
+    if r0 >= min_space:
+        sides.append("top")
+    if h - 1 - r1 >= min_space:
+        sides.append("bottom")
+    if c0 >= min_space:
+        sides.append("left")
+    if w - 1 - c1 >= min_space:
+        sides.append("right")
+    return sides
+
+
+def _door_for_side(
+    rng: random.Random,
+    bbox: tuple[int, int, int, int],
+    side: str,
+    fixed_lane: int | None = None,
+) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    if side == "top":
+        col = fixed_lane if fixed_lane is not None else rng.randint(c0 + 2, c1 - 2)
+        return (r0, col)
+    if side == "bottom":
+        col = fixed_lane if fixed_lane is not None else rng.randint(c0 + 2, c1 - 2)
+        return (r1, col)
+    if side == "left":
+        row = fixed_lane if fixed_lane is not None else rng.randint(r0 + 2, r1 - 2)
+        return (row, c0)
+    row = fixed_lane if fixed_lane is not None else rng.randint(r0 + 2, r1 - 2)
+    return (row, c1)
+
+
+def _make_free_spec(
+    rng: random.Random,
+    h: int,
+    w: int,
