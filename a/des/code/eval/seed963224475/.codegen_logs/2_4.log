+    dr, dc = DIRS[frame["side"]]
+    cells: list[tuple[int, int]] = []
+    r += dr
+    c += dc
+    while 0 <= r < h and 0 <= c < w and int(grid[r, c]) == bg:
+        cells.append((int(r), int(c)))
+        r += dr
+        c += dc
+    if not (0 <= r < h and 0 <= c < w):
+        return "boundary", cells, None
+    if (int(r), int(c)) in border_union:
