+
+BG = 0
+SIDES = ("top", "bottom", "left", "right")
+DIRS = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+GEN_RETRIES = 500
