+    if side == "bottom":
+        col = fixed_lane if fixed_lane is not None else rng.randint(c0 + 2, c1 - 2)
+        return (r1, col)
+    if side == "left":
+        row = fixed_lane if fixed_lane is not None else rng.randint(r0 + 2, r1 - 2)
