+
+def _valid_boundary_sides(bbox: tuple[int, int, int, int], h: int, w: int, min_space: int = 2) -> list[str]:
+    r0, c0, r1, c1 = bbox
+    sides = []
+    if r0 >= min_space:
+        sides.append("top")
+    if h - 1 - r1 >= min_space:
+        sides.append("bottom")
+    if c0 >= min_space:
+        sides.append("left")
+    if w - 1 - c1 >= min_space:
+        sides.append("right")
+    return sides
