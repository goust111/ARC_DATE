+        source = FrameSpec(
+            bbox=src_bbox,
+            side=src_side,
+            door=src_door,
+            border_colors=(source_colors[0], source_colors[1]),
+            same_flanks=source_same,
+            pattern_color=source_colors[2],
+            pattern_cells=_sample_pattern_cells(rng, src_bbox, src_side, src_door),
+        )
+        blocker = FrameSpec(
