+def _sample_pattern_cells(
+    rng: random.Random,
+    bbox: tuple[int, int, int, int],
+    side: str,
+    door: tuple[int, int],
+) -> tuple[tuple[int, int], ...]:
+    r0, c0, r1, c1 = bbox
+    interior = [(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1)]
