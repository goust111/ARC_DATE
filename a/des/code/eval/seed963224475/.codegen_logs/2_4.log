+@dataclass(frozen=True)
+class FrameSpec:
+    bbox: tuple[int, int, int, int]
+    side: str
+    door: tuple[int, int]
+    border_colors: tuple[int, int]
+    same_flanks: bool
+    pattern_color: int
+    pattern_cells: tuple[tuple[int, int], ...]
