+
+def _components4(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _perimeter_set(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    pts = set()
+    for c in range(c0, c1 + 1):
+        pts.add((r0, c))
+        pts.add((r1, c))
+    for r in range(r0, r1 + 1):
+        pts.add((r, c0))
+        pts.add((r, c1))
+    return pts
+
+
+def _extract_frames(grid: np.ndarray, bg: int) -> list[dict]:
+    frames: list[dict] = []
+    for comp in _components4(grid != bg):
+        coords = np.asarray(comp, dtype=int)
+        r0, c0 = coords.min(axis=0)
+        r1, c1 = coords.max(axis=0)
+        if r1 - r0 < 4 or c1 - c0 < 4:
+            continue
+        pset = set(comp)
+        perim = _perimeter_set(int(r0), int(c0), int(r1), int(c1))
+        if not pset <= perim:
+            continue
+        missing = sorted(perim - pset)
+        if len(missing) != 1:
+            continue
+        door = missing[0]
+        if door in ((r0, c0), (r0, c1), (r1, c0), (r1, c1)):
+            continue
+        colors = sorted({int(grid[r, c]) for r, c in comp})
+        if len(colors) != 2:
+            continue
+        if door[0] == r0:
+            side = "top"
+        elif door[0] == r1:
+            side = "bottom"
+        elif door[1] == c0:
+            side = "left"
+        else:
+            side = "right"
+        frames.append(
+            {
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "door": (int(door[0]), int(door[1])),
+                "side": side,
+                "border_cells": pset,
+            }
+        )
+    frames.sort(key=lambda item: item["bbox"])
+    return frames
+
