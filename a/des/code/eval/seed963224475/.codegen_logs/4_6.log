+def _room_patch(inner_h: int, inner_w: int, portals: list[dict], colors: tuple[int, int], pattern: np.ndarray | None) -> np.ndarray:
+    patch = np.full((inner_h + 2, inner_w + 2), BLACK, dtype=int)
