+        pairs.append(pair)
+
+    out = build_output_grid((h, w), pairs)
+    inp = build_input_grid((h, w), pairs)
+    if inp is None:
+        return None
+
+    try:
+        actual = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(actual, out):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
