+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
+VEC_TO_DIR = {value: key for key, value in DIR_TO_VEC.items()}
+
+
+GEN_BG = 0
+GEN_GREY = 5
+GEN_MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_GRID_MIN = 15
+GEN_GRID_MAX = 23
+GEN_PAIR_COUNT = (1, 3)
+GEN_ANCHOR_GAP = (3, 7)
