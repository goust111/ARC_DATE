+        elif len(candidates) == 1:
+            nxt = candidates[0]
+        else:
+            same_color = [cell for cell in candidates if int(g[cell]) == base_color]
+            if len(same_color) == 1:
+                nxt = same_color[0]
+            else:
+                unseen = [cell for cell in candidates if cell not in route]
+                assert len(unseen) == 1, "ambiguous path continuation"
