+        "D": (r_top - 2, c_d),
+    }
+    receiver_centers = {
+        "A": (r_a, c_a_end + 2),
+        "B": (r_b, c_b_end + 2),
+        "C": (r_c, c_c_end + 2),
+        "D": (r_d, c_left - 2),
