+                ((r + 2, c), (r + 1, c)),
+                ((r, c - 2), (r, c - 1)),
+                ((r, c + 2), (r, c + 1)),
+            ]
+            contacts = []
+            for endpoint, border_touch in side_contacts:
+                er, ec = endpoint
+                if not _in_bounds(g.shape, er, ec):
+                    continue
+                val = int(g[er, ec])
