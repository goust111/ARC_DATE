+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return None
+    border_points = {(int(r), int(c)) for r, c in coords}
+    expected = 2 * ((r1 - r0 + 1) + (c1 - c0 + 1)) - 4
+    if len(border_points) != expected:
