+    frames: list[dict[str, object]] = []
+    frame_mask = np.zeros((h, w), dtype=bool)
+    for color in sorted(set(map(int, g.ravel())) - {bg}):
+        for coords in _components(g == int(color)):
+            box = _frame_bbox(coords)
+            if box is None:
