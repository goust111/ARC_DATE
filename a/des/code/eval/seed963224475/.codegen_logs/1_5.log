+def _expand_bbox(bbox: tuple[int, int, int, int], amount: int) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = bbox
+    return int(r0 - amount), int(c0 - amount), int(r1 + amount), int(c1 + amount)
