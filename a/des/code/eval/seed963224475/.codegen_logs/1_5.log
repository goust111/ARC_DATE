+def _paint_layer(out: np.ndarray, coords: np.ndarray, color: int, dr: int, dc: int, bg: int) -> None:
+    h, w = out.shape
+    for r, c in coords:
+        rr = int(r) + dr
+        cc = int(c) + dc
+        if 0 <= rr < h and 0 <= cc < w and int(out[rr, cc]) == bg:
+            out[rr, cc] = int(color)
