+def _contract_bbox(bbox: tuple[int, int, int, int], amount: int) -> tuple[int, int, int, int] | None:
+    r0, c0, r1, c1 = bbox
+    nr0, nc0, nr1, nc1 = r0 + amount, c0 + amount, r1 - amount, c1 - amount
+    if nr0 > nr1 or nc0 > nc1:
+        return None
+    return int(nr0), int(nc0), int(nr1), int(nc1)
