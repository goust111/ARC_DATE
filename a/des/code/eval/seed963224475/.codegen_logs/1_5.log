+
+
+def _sample_group(bg: int, n_groups: int, depth: int) -> dict[str, object]:
+    pattern = _random_pattern(use_large=(n_groups == 1), tight=(n_groups == 2 and depth == 4))
+    extra_limit = 2 if n_groups == 1 else 0
