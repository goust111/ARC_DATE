        x1 = random.randint(left, w - right - w1)
        ordered_origins = [(y0, x0), (y1, x1)]

    origins = [(-1, -1)] * len(groups)
    for idx, origin in zip(order, ordered_origins, strict=False):
        origins[idx] = origin
