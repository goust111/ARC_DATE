+        box = tuple(frame["bbox"])
+        chain_colors: list[int] = []
+        while box in frame_by_bbox:
+            cur = frame_by_bbox[box]
+            chain_colors.append(int(cur["color"]))
+            used_boxes.add(box)
+            box = _expand_bbox(box, 2)
