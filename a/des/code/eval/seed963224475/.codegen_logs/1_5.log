+            return None
+        extra_y = h - top - bottom - (h0 + gap + h1)
+        y0 = top + random.randint(0, extra_y)
+        y1 = y0 + h0 + gap
+        x0 = random.randint(left, w - right - w0)
+        x1 = random.randint(left, w - right - w1)
+        ordered_origins = [(y0, x0), (y1, x1)]
