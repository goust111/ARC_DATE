+    counts = {int(color): 0 for color in seed_pos}
+    for r in range(h):
+        for c in range(w):
+            if passable[r, c] and degrees[r, c] == 1:
+                color = int(state[r, c])
+                if color in counts:
+                    counts[color] += 1
