+        legend_gap_left = rng.choice((1, 2))
+        legend_gap_vertical = rng.choice((1, 2))
+        right_margin = rng.choice((1, 2))
+        grid = _build_candidate_grid(
+            maze_mask,
+            seeds,
+            colors,
+            legend_gap_left,
+            legend_gap_vertical,
+            right_margin,
+            rng,
+        )
+        if grid is None:
+            continue
+
