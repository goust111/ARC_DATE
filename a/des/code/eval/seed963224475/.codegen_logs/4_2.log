+def _legend_rows(height: int, count: int, gap: int, rng: random.Random) -> list[int] | None:
+    total = count * 3 + (count - 1) * gap
+    if total > height:
+        return None
+    top = rng.randint(0, height - total)
+    return [top + i * (3 + gap) for i in range(count)]
