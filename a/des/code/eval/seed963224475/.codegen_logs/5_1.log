+        "top": grid[r0, c0 : c1 + 1] == FRAME,
+        "bottom": grid[r1, c0 : c1 + 1] == FRAME,
+        "left": grid[r0 : r1 + 1, c0] == FRAME,
+        "right": grid[r0 : r1 + 1, c1] == FRAME,
