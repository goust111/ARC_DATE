+    has_overlap = False
+    has_tie = False
+    for entries in by_line.values():
+        if len(entries) < 2:
+            continue
+        has_overlap = True
+        fronts = [front for front, _count, _idx in entries]
+        if len(fronts) != len(set(fronts)):
