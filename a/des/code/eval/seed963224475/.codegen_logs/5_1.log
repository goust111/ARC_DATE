+    if direction in ("up", "down"):
+        min_iw = max(14, sum(line_counts) + 2) if not overlap_case else 14
+        min_ih = 14
+    else:
+        min_iw = 14
+        min_ih = max(14, sum(line_counts) + 2) if not overlap_case else 14
+    if min_ih > 18 or min_iw > 18:
