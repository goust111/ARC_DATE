+
+def _components_same_color(grid: np.ndarray, forbidden: set[int]) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    objects: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color in forbidden or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
