+
+    specs = [{"shape": shape, "color": color} for shape, color in zip(shapes, colors)]
+    specs.sort(key=lambda spec: (-int(spec["shape"]["area"]), -int(spec["shape"]["h"]) - int(spec["shape"]["w"])))
