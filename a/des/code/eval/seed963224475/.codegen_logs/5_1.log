+
+def _spatially_clear(abs_cells: tuple[tuple[int, int], ...], occupied: set[tuple[int, int]]) -> bool:
+    for r, c in abs_cells:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if (int(r + dr), int(c + dc)) in occupied:
+                    return False
