+    assert coords.size > 0, "expected a grey frame"
+    r0, c0 = map(int, coords.min(axis=0))
+    r1, c1 = map(int, coords.max(axis=0))
+    assert r1 - r0 + 1 >= 4 and c1 - c0 + 1 >= 4, "frame too small"
