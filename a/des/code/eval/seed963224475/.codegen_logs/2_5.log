+        uc1 = max(sc0 + sw - 1, lc0 + lw - 1)
+        pr0 = max(0, ur0 - 1)
+        pc0 = max(0, uc0 - 1)
+        pr1 = min(h - 1, ur1 + 1)
+        pc1 = min(w - 1, uc1 + 1)
