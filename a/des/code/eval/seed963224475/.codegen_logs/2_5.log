+        while len(cells) < target:
+            pick = random.choice(tuple(frontier))
+            frontier.remove(pick)
+            cells.add(pick)
+            pr, pc = pick
+            for dr, dc in DIRS4:
+                nr, nc = pr + dr, pc + dc
+                if 0 <= nr < seed_h and 0 <= nc < seed_w and (nr, nc) not in cells:
