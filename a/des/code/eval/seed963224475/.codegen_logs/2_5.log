+    grid = np.zeros(shape, dtype=int)
+    reserved = np.zeros(shape, dtype=bool)
+    order = sorted(specs, key=lambda spec: int(spec["union_h"]) * int(spec["union_w"]), reverse=True)
+
+    for spec in order:
+        if not _place_pair(grid, reserved, spec):
+            return None
