+BG = 0
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+DIRS8 = DIRS4 + ((-1, -1), (-1, 1), (1, -1), (1, 1))
+
+# Generator controls.
+GEN_RETRIES = 300
+PLACEMENT_ATTEMPTS = 200
+GRID_MAX = 30
