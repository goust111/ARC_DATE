+        seed_w = random.randint(2, max_dim)
+        area = seed_h * seed_w
+        target = random.randint(max(2, (area + 2) // 3), area)
+
+        cells = {(random.randrange(seed_h), random.randrange(seed_w))}
+        frontier = set()
+        for r, c in cells:
+            for dr, dc in DIRS4:
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < seed_h and 0 <= nc < seed_w:
+                    frontier.add((nr, nc))
