+    offset_c = random.randint(0, room_cols - 3)
+    symmetry = random.choice(SYMMETRIES)
+    roles = _role_template(offset_r, offset_c, symmetry)
+    empty_rooms = {roles["d1"], roles["d2"], roles["d3"], roles["d4"]}
+
