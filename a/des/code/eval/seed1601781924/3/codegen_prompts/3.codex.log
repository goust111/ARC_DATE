+        "src_a1": (0, 0),
+        "d2": (0, 1),
+        "src_b": (0, 2),
+        "d3": (1, 0),
+        "d4": (1, 1),
+        "src_c1": (1, 2),
+        "src_a2": (2, 0),
+        "src_c2": (2, 1),
+        "d1": (2, 2),
+    }
