+    coords = comps[0]
+    sr0, sc0, sr1, sc1 = _bbox(coords)
+    patch = np.zeros((sr1 - sr0 + 1, sc1 - sc0 + 1), dtype=bool)
+    patch[coords[:, 0] - sr0, coords[:, 1] - sc0] = True
+    return (sr0, sc0, sr1, sc1), patch
