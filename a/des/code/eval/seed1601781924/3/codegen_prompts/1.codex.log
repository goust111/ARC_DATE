+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+SIDES = ("top", "right", "bottom", "left")
+ORIENT_TO_TURNS = {"up": 0, "right": 1, "down": 2, "left": 3}
+ALLOWED_ORIENTATIONS = {
+    "top": ("up", "down"),
+    "right": ("left", "right"),
+    "bottom": ("up", "down"),
+    "left": ("left", "right"),
+}
