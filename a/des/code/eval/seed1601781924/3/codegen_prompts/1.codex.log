+def _hcat_with_gap(parts: list[np.ndarray]) -> np.ndarray:
+    assert parts
+    out_h = max(int(part.shape[0]) for part in parts)
+    out_w = sum(int(part.shape[1]) for part in parts) + len(parts) - 1
