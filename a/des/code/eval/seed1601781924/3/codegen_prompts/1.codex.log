+BASE_UP = np.array(
+    [
+        [0, 1, 0],
+        [1, 1, 1],
+        [1, 0, 0],
+    ],
+    dtype=bool,
+)
+BASE_FAMILIES = (BASE_UP, np.fliplr(BASE_UP))
+
+FRAME_SIZE_RANGE = (11, 16)
+EXTRA_MARKER_CHOICES = (0, 1)
+MARGIN_RANGE = (1, 5)
+MAX_GENERATION_ATTEMPTS = 500
+
+
+def _rotate_cw(arr: np.ndarray, turns: int) -> np.ndarray:
+    return np.rot90(arr, -int(turns))
+
