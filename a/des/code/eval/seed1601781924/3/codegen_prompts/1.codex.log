+    shape = np.asarray(mask, dtype=bool)
+    for family in BASE_FAMILIES:
+        for name, turns in ORIENT_TO_TURNS.items():
+            cand = _rotate_cw(family, turns)
+            if cand.shape == shape.shape and np.array_equal(cand, shape):
+                return name
