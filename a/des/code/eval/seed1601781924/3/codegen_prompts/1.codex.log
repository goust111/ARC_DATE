+                continue
+            spec["top"] = int(top)
+            spec["left"] = int(left)
+            spec["marker_r"] = int(marker_r if marker_r >= 0 else size - 1)
+            spec["marker_c"] = int(marker_c if marker_c >= 0 else size - 1)
+            occupied[top : top + 3, left : left + 3] = True
+            used_axes[side].append(marker_axis)
+            placed = True
