 257:     inp[H - 1, fc0:fc0 + frame_w] = top_edge
 258: 
 259:     # Frame left/right edges (mirrored)
 260:     for r in range(1, H - 1):
 261:         val = frame_base
 262:         for mc, (rmarks, _) in mover_targets.items():
 263:             if r in rmarks:
 264:                 val = mc
 265:                 break
