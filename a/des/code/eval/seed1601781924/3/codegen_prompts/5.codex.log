   9: def main(grid: np.ndarray) -> np.ndarray:
  10:     """Expand the top-left seed mask into a recursive colored pattern and tile it across the full grid.
  11: 
  12:     Input structure
  13:     - The background is the dominant color.
  14:     - All foreground lies in a top-left rectangle whose last row and last column are a solid secondary color.
  15:     - Removing that secondary-color row and column leaves a seed region containing background plus one primary color.
  16: 
  17:     Rule
  18:     - Use the primary-color pixels in the seed as a binary mask.
  19:     - Replace each primary seed cell with a copy of the seed mask in the primary color, and each background seed cell
  20:       with a copy of the seed mask in the secondary color.
  21:     - Repeat and crop that expanded tile to the original grid shape.
  22: 
  23:     Key insight
  24:     The solid L-shaped secondary-color border is a legend, not output content; it supplies the color used when the
  25:     seed's background cells are expanded.
  26:     """
  27:     g = np.asarray(grid, dtype=int)
  28:     bg = int(get_bg(g))
  29: 
  30:     fg_bbox = bbox(g != bg)
  31:     assert fg_bbox is not None, "expected a top-left foreground legend"
  32:     r0, c0, r1, c1 = fg_bbox
  33:     assert r0 == 0 and c0 == 0, "foreground legend must be anchored at the top-left corner"
  34: 
  35:     legend_box = g[: r1 + 1, : c1 + 1]
  36:     seed_h = legend_box.shape[0] - 1
  37:     seed_w = legend_box.shape[1] - 1
  38:     assert seed_h >= 1 and seed_w >= 1, "legend must contain a non-empty seed plus border"
  39: 
  40:     secondary_border = np.concatenate((legend_box[:seed_h, seed_w], legend_box[seed_h, :]))
  41:     secondary_colors = np.unique(secondary_border)
  42:     assert secondary_colors.size == 1, "expected one solid secondary-color border"
  43:     secondary = int(secondary_colors[0])
  44:     assert secondary != bg, "secondary border must be foreground"
  45: 
  46:     seed = legend_box[:seed_h, :seed_w]
  47:     primary_colors = np.unique(seed[seed != bg])
  48:     assert primary_colors.size == 1, "seed must contain exactly one primary foreground color"
  49:     primary = int(primary_colors[0])
  50:     assert primary != secondary, "primary and secondary colors must be distinct"
  51:     assert np.all((seed == bg) | (seed == primary)), "seed may contain only background and primary colors"
  52:     assert np.any(seed == bg), "seed must include background cells that expand to the secondary color"
  53: 
  54:     seed_mask = seed == primary
  55:     H, W = g.shape
  56:     rows = np.arange(H)[:, None]
  57:     cols = np.arange(W)[None, :]
  58: 
  59:     inner_mask = seed_mask[rows % seed_h, cols % seed_w]
  60:     meta_mask = seed_mask[(rows // seed_h) % seed_h, (cols // seed_w) % seed_w]
  61: 
  62:     out = np.full(g.shape, bg, dtype=int)
  63:     out[inner_mask & meta_mask] = primary
  64:     out[inner_mask & ~meta_mask] = secondary
  65:     return out
  66: 
  67: # --------------- generator (att2, o5x) ---------------
  68: 
  69: # Color palette.
  70: BACKGROUND_COLOR, PALETTE_COLORS = 7, tuple(range(10))
  71: # Seed geometry.
  72: SEED_SIZES = (2, 3)
  73: SEED_DENSITY_MIN, SEED_DENSITY_MAX = 0.33, 0.67
  74: # Canvas layout.
  75: TILE_MULTIPLIERS, GRID_MIN, GRID_MAX = range(3, 6), 7, 16
  76: REMAINDERS_BY_SQUARENESS = {False: (0,), True: (0, 1)}
  77: # Retry budget.
  78: MAX_GENERATION_ATTEMPTS = 300
  79: 
  80: def _expected_output(seed_mask: np.ndarray, shape: tuple[int, int], bg: int, primary: int, secondary: int) -> np.ndarray:
  81:     """Render the two-level fractal that main() should produce."""
  82:     seed_h, seed_w = seed_mask.shape
  83:     H, W = shape
  84:     rows = np.arange(H)[:, None]
  85:     cols = np.arange(W)[None, :]
  86: 
  87:     inner = seed_mask[rows % seed_h, cols % seed_w]
  88:     meta = seed_mask[(rows // seed_h) % seed_h, (cols // seed_w) % seed_w]
  89: 
  90:     out = np.full((H, W), bg, dtype=int)
  91:     out[inner & meta] = primary
  92:     out[inner & ~meta] = secondary
  93:     return out
  94: 
  95: def _layout_options(seed_h: int, seed_w: int) -> list[tuple[int, int]]:
  96:     """Return valid canvas shapes for a sampled seed size."""
  97:     options = []
  98:     for k in TILE_MULTIPLIERS:
  99:         for rem in REMAINDERS_BY_SQUARENESS[seed_h == seed_w]:
 100:             H = seed_h * k + rem
 101:             W = seed_w * k + rem
 102:             if GRID_MIN <= H <= GRID_MAX and GRID_MIN <= W <= GRID_MAX and H >= seed_h * seed_h and W >= seed_w * seed_w:
 103:                 options.append((H, W))
 104:     return options
 105: 
 106: def _random_seed_mask(seed_h: int, seed_w: int) -> np.ndarray:
 107:     """Sample a nonempty, nonfull primary mask within density bounds."""
 108:     area = seed_h * seed_w
 109:     lo = max(1, int(np.ceil(area * SEED_DENSITY_MIN)))
 110:     hi = min(area - 1, int(np.floor(area * SEED_DENSITY_MAX)))
 111:     n_primary = random.randint(lo, hi)
 112:     chosen = random.sample(range(area), n_primary)
 113:     mask = np.zeros((seed_h, seed_w), dtype=bool)
 114:     mask.reshape(-1)[chosen] = True
 115:     return mask
 116: 
 117: def _render_input(seed_mask: np.ndarray, shape: tuple[int, int], bg: int, primary: int, secondary: int) -> np.ndarray:
 118:     """Render the top-left seed legend on a background canvas."""
 119:     seed_h, seed_w = seed_mask.shape
 120:     inp = np.full(shape, bg, dtype=int)
 121:     inp[:seed_h, :seed_w][seed_mask] = primary
 122:     inp[seed_h, : seed_w + 1] = secondary
 123:     inp[:seed_h, seed_w] = secondary
 124:     return inp
 125: 
 126: def _gen_attempt() -> np.ndarray | None:
 127:     """Build one oracle-checked input grid, or None if validation fails."""
 128:     bg = BACKGROUND_COLOR
 129:     primary, secondary = random.sample([c for c in PALETTE_COLORS if c != bg], 2)
 130: 
 131:     seed_h = random.choice(SEED_SIZES)
 132:     seed_w = random.choice(SEED_SIZES)
 133:     H, W = random.choice(_layout_options(seed_h, seed_w))
 134: 
 135:     seed_mask = _random_seed_mask(seed_h, seed_w)
 136:     inp = _render_input(seed_mask, (H, W), bg, primary, secondary)
 137:     expected = _expected_output(seed_mask, (H, W), bg, primary, secondary)
 138:     try:
 139:         actual = main(inp)
 140:     except Exception:
 141:         return None
 142:     if not np.array_equal(actual, expected):
 143:         return None
 144:     return inp
 145: 
 146: def generate_input() -> np.ndarray:
 147:     for _ in range(MAX_GENERATION_ATTEMPTS):
 148:         grid = _gen_attempt()
 149:         if grid is not None:
 150:             return grid
