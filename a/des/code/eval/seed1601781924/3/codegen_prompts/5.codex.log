+def _overlap_score(mask: np.ndarray, orientation: str, axis2: int) -> int:
+    coords = np.argwhere(mask)
+    h, w = mask.shape
+    score = 0
+    if orientation == "h":
+        for r, c in coords:
+            rr = int(axis2 - r)
+            if 0 <= rr < h and mask[rr, c]:
