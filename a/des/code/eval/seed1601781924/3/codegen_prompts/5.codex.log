 184:     bg = 0
 185: 
 186:     # Dimensions — frame spans full grid height
 187:     interior_h = random.randint(8, 13)
 188:     interior_w = random.randint(8, 13)
 189:     H = interior_h + 2
 190:     if not 10 <= H <= 15:
 191:         return None
 192:     sprite_area_w = random.randint(3, 5)
 193:     frame_w = interior_w + 2
 194:     W = sprite_area_w + 1 + frame_w
 195:     if not 14 <= W <= 20:
 196:         return None
 197: 
 198:     # Key positions
 199:     div_col = sprite_area_w
 200:     fc0, fc1 = sprite_area_w + 1, W - 1
 201:     ir0, ic0 = 1, fc0 + 1
 202:     ir1, ic1 = H - 2, fc1 - 1
 203: 
 204:     # Assign distinct colors
 205:     all_colors = list(range(1, 10))
 206:     random.shuffle(all_colors)
 207:     n_movers = random.randint(2, 3)
 208:     n_distractors = random.choice([0, 0, 1])
 209:     idx = 0
 210:     divider_color = all_colors[idx]; idx += 1
 211:     frame_base = all_colors[idx]; idx += 1
 212:     mover_colors = all_colors[idx:idx + n_movers]; idx += n_movers
 213:     distractor_colors = all_colors[idx:idx + n_distractors]; idx += n_distractors
 214: 
 215:     # Generate mover sprites
 216:     sprites: list[np.ndarray] = []
 217:     for mc in mover_colors:
 218:         s = _make_sprite(mc, 5, sprite_area_w)
 219:         if s is None:
 220:             return None
 221:         sprites.append(s)
 222: 
 223:     # Pick marker positions per mover (no two movers share a row or col marker)
 224:     mover_targets: dict[int, tuple[list[int], list[int]]] = {}
 225:     occupied_rows: set[int] = set()
 226:     occupied_cols: set[int] = set()
 227:     for mc, sp in zip(mover_colors, sprites):
 228:         sh, sw = sp.shape
 229:         min_row = ir0 + sh // 2
 230:         max_row = ir1 - (sh - 1 - sh // 2)
 231:         min_col = ic0 + sw // 2
 232:         max_col = ic1 - (sw - 1 - sw // 2)
 233:         if min_row > max_row or min_col > max_col:
 234:             return None
 235:         avail_rows = [r for r in range(min_row, max_row + 1) if r not in occupied_rows]
 236:         row_marks = _pick_spaced(avail_rows, random.randint(1, 2), sh)
 237:         if not row_marks:
 238:             return None
 239:         avail_cols = [c for c in range(min_col, max_col + 1) if c not in occupied_cols]
 240:         col_marks = _pick_spaced(avail_cols, random.randint(1, 2), sw)
 241:         if not col_marks:
 242:             return None
 243:         mover_targets[mc] = (sorted(row_marks), sorted(col_marks))
 244:         occupied_rows.update(row_marks)
 245:         occupied_cols.update(col_marks)
 246: 
 247:     # Build input grid: bg fill, then divider, frame, sprites
 248:     inp = np.full((H, W), bg, dtype=int)
 249:     inp[:, div_col] = divider_color
 250: 
 251:     # Frame top/bottom edges (mirrored)
