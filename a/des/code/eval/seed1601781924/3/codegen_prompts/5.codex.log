  18: def main(grid: np.ndarray) -> np.ndarray:
  19:     """
  20:     Extract the compact table of solid cells hidden inside a separator lattice.
  21: 
  22:     Input structure
  23:     - The grid has full-width and full-height bars of one separator color, dividing it into rectangular cells.
  24:     - Most cells contain a repeating multicolor pattern, while a contiguous rectangle of cells is solid monochrome.
  25: 
  26:     Rule
  27:     - Split the input into lattice cells using the full separator rows and columns.
  28:     - Keep the cells whose full interior is one color, crop to their occupied rectangle, and output those colors.
  29: 
  30:     Key insight
  31:     - The periodic pattern is noise; only completely solid lattice cells encode the reduced output grid.
  32:     """
  33:     g = np.asarray(grid, dtype=int)
  34:     h, w = g.shape
  35: 
  36:     row_colors = {int(g[r, 0]) for r in range(h) if np.all(g[r, :] == g[r, 0])}
  37:     col_colors = {int(g[0, c]) for c in range(w) if np.all(g[:, c] == g[0, c])}
  38:     sep_colors = row_colors & col_colors
  39:     assert len(sep_colors) == 1, "there must be exactly one row/column separator color"
  40:     sep = next(iter(sep_colors))
  41:     assert row_colors == {sep}, "all full rows must be separator rows"
  42:     assert col_colors == {sep}, "all full columns must be separator columns"
  43: 
  44:     sep_rows = [r for r in range(h) if np.all(g[r, :] == sep)]
  45:     sep_cols = [c for c in range(w) if np.all(g[:, c] == sep)]
  46:     assert sep_rows and sep_cols, "separator lattice must have rows and columns"
  47: 
  48:     row_bands = _bands(h, sep_rows)
  49:     col_bands = _bands(w, sep_cols)
  50: 
  51:     solid_cells = {}
  52:     for ri, (r0, r1) in enumerate(row_bands):
  53:         for ci, (c0, c1) in enumerate(col_bands):
  54:             cell = g[r0 : r1 + 1, c0 : c1 + 1]
  55:             if np.all(cell == cell[0, 0]):
  56:                 solid_cells[(ri, ci)] = int(cell[0, 0])
  57:     assert solid_cells, "must contain at least one solid lattice cell"
  58: 
  59:     solid_rows = [ri for ri, _ in solid_cells]
  60:     solid_cols = [ci for _, ci in solid_cells]
  61:     r0, r1 = min(solid_rows), max(solid_rows)
  62:     c0, c1 = min(solid_cols), max(solid_cols)
  63: 
  64:     out = np.empty((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
  65:     for ri in range(r0, r1 + 1):
  66:         for ci in range(c0, c1 + 1):
  67:             assert (ri, ci) in solid_cells, "solid lattice cells must form a rectangle"
  68:             out[ri - r0, ci - c0] = solid_cells[(ri, ci)]
  69:     return out
  70: 
  71: # --------------- generator (att2, o5x) ---------------
  72: 
  73: # Lattice dimensions: valid (L, cell_size) pairs produce 27-30 square grids.
  74: VALID_LC = [(4, 6), (5, 5), (6, 4)]
  75: COLOR_COUNT = 10
  76: SEPARATOR_WIDTH = 1
  77: # Solid rectangle: output block size in lattice coordinates.
  78: SOLID_SIZE_RANGE = (2, 3)
  79: # Pattern cells: diagonal variants are multicolor and solver-visible as non-solid.
  80: PATTERN_TILE_MIN_COLORS = 5
  81: PATTERN_CELL_MIN_COLORS = 2
  82: DIAGONAL_ID_BITS = 4
  83: # Retry budget: regenerate on rare validation failures.
  84: MAX_GENERATION_ATTEMPTS = 300
  85: 
  86: 
  87: def _pattern_tiles(csize: int, lattice: int, sep: int) -> dict[int, np.ndarray]:
  88:     """Build one structured tile per lattice diagonal, or {} if validation fails."""
  89:     colors = [c for c in range(COLOR_COUNT) if c != sep]
  90:     random.shuffle(colors)
  91:     palette = colors[: random.randint(PATTERN_TILE_MIN_COLORS, len(colors))]
  92:     palette_arr = np.asarray(palette, dtype=int)
  93:     k = len(palette)
  94: 
  95:     rr, cc = np.indices((csize, csize))
  96:     base = (rr + cc + random.randrange(k)) % k
  97:     if random.choice([False, True]):
  98:         base = base.T
  99:     if random.choice([False, True]):
 100:         base = np.fliplr(base)
 101:     if random.choice([False, True]):
 102:         base = np.flipud(base)
 103:     tiles = {}
 104:     for diag in range(2 * lattice - 1):
 105:         tile_idx = (base + random.randrange(k)) % k
 106:         tile = palette_arr[tile_idx]
 107:         # Encode the diagonal id in four cells so variants are guaranteed distinct.
 108:         for bit in range(DIAGONAL_ID_BITS):
 109:             tile.flat[bit] = palette[(diag >> bit) & 1]
 110:         if len(np.unique(tile)) < PATTERN_TILE_MIN_COLORS:
 111:             return {}
 112:         tiles[diag] = tile
 113:     return tiles
 114: 
 115: 
 116: def _sample_solid_block(lattice, colors):
 117:     """Return ((row, col, height, width), output colors) for the solid block."""
 118:     solid_h = random.randint(*SOLID_SIZE_RANGE)
 119:     solid_w = random.randint(*SOLID_SIZE_RANGE)
 120:     solid_r0 = random.randint(0, lattice - solid_h)
 121:     solid_c0 = random.randint(0, lattice - solid_w)
 122:     flat = np.random.choice(colors, size=solid_h * solid_w).astype(int)
 123:     if len(set(map(int, flat))) == 1:
 124:         change_at = random.randrange(len(flat))
 125:         flat[change_at] = random.choice([c for c in colors if c != int(flat[change_at])])
 126:     return (solid_r0, solid_c0, solid_h, solid_w), flat.reshape((solid_h, solid_w))
 127: 
 128: 
 129: def _render_grid(lattice, csize, sep, block, out, tiles):
 130:     """Assemble the separator lattice from solid cells and pattern tiles."""
 131:     n = lattice * csize + (lattice - 1)
 132:     grid = np.full((n, n), sep, dtype=int)
 133:     solid_r0, solid_c0, solid_h, solid_w = block
 134:     stride = csize + SEPARATOR_WIDTH
 135:     for ri in range(lattice):
 136:         for ci in range(lattice):
 137:             r0, c0 = ri * stride, ci * stride
 138:             if solid_r0 <= ri < solid_r0 + solid_h and solid_c0 <= ci < solid_c0 + solid_w:
 139:                 cell = np.full((csize, csize), int(out[ri - solid_r0, ci - solid_c0]), dtype=int)
 140:             else:
 141:                 cell = tiles[(ri - ci) % (2 * lattice - 1)]
 142:             paste(grid, cell, r0, c0)
 143:     return grid
 144: 
 145: 
 146: def _valid_generated_grid(grid, lattice, csize, sep, block):
 147:     """Check separator lines and non-solid cells before the solver oracle."""
 148:     stride = csize + SEPARATOR_WIDTH
 149:     sep_lines = [csize + i * stride for i in range(lattice - 1)]
 150:     if not all(np.all(grid[r, :] == sep) and np.all(grid[:, r] == sep) for r in sep_lines):
 151:         return False
 152:     solid_r0, solid_c0, solid_h, solid_w = block
 153:     for ri in range(lattice):
 154:         for ci in range(lattice):
 155:             if solid_r0 <= ri < solid_r0 + solid_h and solid_c0 <= ci < solid_c0 + solid_w:
 156:                 continue
 157:             r0, c0 = ri * stride, ci * stride
 158:             if len(np.unique(grid[r0 : r0 + csize, c0 : c0 + csize])) < PATTERN_CELL_MIN_COLORS:
 159:                 return False
 160:     return True
 161: 
 162: 
 163: def _gen_attempt() -> np.ndarray | None:
 164:     lattice, csize = random.choice(VALID_LC)
 165:     sep = random.randrange(COLOR_COUNT)
 166:     colors = [c for c in range(COLOR_COUNT) if c != sep]
 167:     block, out = _sample_solid_block(lattice, colors)
 168:     tiles = _pattern_tiles(csize, lattice, sep)
 169:     if not tiles:
 170:         return None
 171:     grid = _render_grid(lattice, csize, sep, block, out, tiles)
 172:     if not _valid_generated_grid(grid, lattice, csize, sep, block):
 173:         return None
 174:     try:
 175:         if not np.array_equal(main(grid), out):
 176:             return None
 177:     except AssertionError:
 178:         return None
 179:     return grid
 180: 
 181: 
 182: def generate_input() -> np.ndarray:
 183:     for _ in range(MAX_GENERATION_ATTEMPTS):
 184:         grid = _gen_attempt()
 185:         if grid is not None:
 186:             return grid
 187:     raise RuntimeError("failed to generate valid 458e3a53 input")

