 166: 
 167: # ---- CFG: Tunable generation parameters ----
 168: _FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle
 169: _ROOM_COUNT_RANGE = (1, 6)            # rooms per frame
 170: _TIE_PROBABILITY = 0.35              # chance of one tied room-count pair
 171: _GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)
 172:     5: (25, 30, 25, 30, 16, 18),
 173:     4: (22, 30, 22, 30, 18, 22),
 174:     3: (20, 30, 20, 30, 22, 25),
 175: }
 176: _CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame
 177: _NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise
 178: _WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise
 179: _EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force
 180: _OVERLAP_RETRY = 100                 # attempts to place overlapping frame
 181: _GEN_RETRIES = 300                   # outer retry limit
