 267:         inp[r, fc1] = val
 268: 
 269:     # Stack sprites in left strip: movers top-to-bottom, then distractors
 270:     cur_row = 0
 271:     all_items: list[tuple[int, np.ndarray, bool]] = [
 272:         (mc, sp, False) for mc, sp in zip(mover_colors, sprites)
 273:     ]
 274:     for dc_color in distractor_colors:
 275:         ds = _make_sprite(dc_color, min(5, H - cur_row), sprite_area_w)
 276:         if ds is None:
 277:             return None
 278:         all_items.append((dc_color, ds, True))
 279: 
 280:     for mc, sp, _ in all_items:
 281:         sh, sw = sp.shape
 282:         if sw > sprite_area_w or cur_row + sh > H:
