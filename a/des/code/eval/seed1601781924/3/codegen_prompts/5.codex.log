+    inp = np.full((grid_h, grid_w), BACKGROUND, dtype=int)
+    for shape, (r0, c0) in zip(shapes, positions):
+        mask = shape["full_mask"]
+        inp[r0 : r0 + mask.shape[0], c0 : c0 + mask.shape[1]][mask] = shape["color"]
