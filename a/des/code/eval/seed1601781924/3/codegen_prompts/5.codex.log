 320: def _gen_attempt() -> np.ndarray | None:
 321:     """Single attempt: build output-first, derive input, validate with oracle."""
 322:     H = int(_RNG.integers(*GRID_H_RANGE))
 323:     W = int(_RNG.integers(*GRID_W_RANGE))
 324:     bg = int(_RNG.integers(0, NUM_COLORS))
 325: 
 326:     top, bottom = _build_groups(bg)
 327:     _RNG.shuffle(top)
 328:     _RNG.shuffle(bottom)
 329: 
 330:     if H - max(c["h"] for c in top) - max(c["h"] for c in bottom) < MIN_VERTICAL_GAP:
 331:         return None
 332: 
 333:     top_cols = _assign_columns([c["w"] for c in top], W)
 334:     bottom_cols = _assign_columns([c["w"] for c in bottom], W)
 335:     if top_cols is None or bottom_cols is None:
 336:         return None
 337: 
 338:     for comp, c0 in zip(top, top_cols):
 339:         comp["c0"], comp["out_r0"] = c0, 0
 340:     for comp, c0 in zip(bottom, bottom_cols):
 341:         comp["c0"], comp["out_r0"] = c0, H - comp["h"]
 342: 
 343:     comps = top + bottom
 344:     expected = _build_output(comps, H, W, bg)
 345:     inp = _derive_input(comps, H, W, bg)
 346:     if inp is None:
 347:         return None
 348:     if int(get_bg(inp)) != bg:
 349:         return None
 350: 
 351:     found = find_components(inp, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
 352:     if len(found) != len(comps):
 353:         return None
 354:     if Counter(len(c["coords"]) for c in found) != Counter(c["area"] for c in comps):
 355:         return None
 356:     if not np.array_equal(main(inp), expected):
 357:         return None
 358:     return inp
 359: 
