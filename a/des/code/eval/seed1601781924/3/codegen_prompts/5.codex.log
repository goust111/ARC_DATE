 339: def _make_blob(axis_len: int, line_len: int, axis: int, max_back: int) -> tuple[int, dict[int, np.ndarray]] | None:
 340:     patterns = _base_patterns(axis_len, line_len, max_back)
 341:     if not patterns:
 342:         return None
 343:     by_growth: dict[int, list[list[list[tuple[int, int]]]]] = {}
 344:     for growth, intervals0 in patterns:
 345:         by_growth.setdefault(growth, []).append(intervals0)
 346:     growth = random.choice(sorted(by_growth))
 347:     intervals0 = random.choice(by_growth[growth])
 348:     direction = random.choice(BLOB_DIRECTIONS)
 349:     masks = {
 350:         back: _draw_local(intervals0, growth, max_back, back, direction, axis)
 351:         for back in range(max_back + 1)
 352:     }
 353:     largest = masks[0]
 354:     if largest.shape[0] > (line_len if axis == 1 else axis_len):
 355:         return None
 356:     if largest.shape[1] > (axis_len if axis == 1 else line_len):
 357:         return None
 358:     if len(components_mask(masks[max_back], connectivity=4)) > BLOB_MAX_COMPONENTS:
 359:         return None
 360:     return growth, masks
