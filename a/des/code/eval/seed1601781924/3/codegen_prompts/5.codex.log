+    grid[r1, c0 : c1 + 1] = color
+    grid[r0 : r1 + 1, c0] = color
+    grid[r0 : r1 + 1, c1] = color
+
+
+def _render_expected(shape_infos: list[dict], boxes: list[tuple[int, int, int, int]], grid_shape: tuple[int, int], slot_color: int) -> np.ndarray:
