+    max_shape_h = max(shape["full_mask"].shape[0] for shape in shapes)
+    slot_top = max_shape_h + random.randint(5, 9)
+    grid_h = slot_top + slot_h + random.randint(1, 3)
+    min_grid_w = count * slot_w + (count + 1)
