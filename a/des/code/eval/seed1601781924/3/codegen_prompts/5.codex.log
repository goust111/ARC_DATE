 318: def _draw_local(
 319:     intervals0: list[list[tuple[int, int]]],
 320:     growth: int,
 321:     max_back: int,
 322:     back: int,
 323:     direction: int,
 324:     axis: int,
 325: ) -> np.ndarray:
 326:     grown = max_back - back
 327:     width = max(end for row in intervals0 for _start, end in row) + max_back * growth + 1
 328:     local = np.zeros((len(intervals0), width), dtype=bool)
 329:     for r, row in enumerate(intervals0):
 330:         for start, end in row:
 331:             local[r, start : end + grown * growth + 1] = True
 332:     if direction < 0:
 333:         local = np.fliplr(local)
 334:     if axis == 0:
 335:         local = local.T
 336:     return local
 337: 
