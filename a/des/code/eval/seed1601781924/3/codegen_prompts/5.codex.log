+    return None
+
+
+def _sample_orientations(count: int) -> list[str]:
+    if count == 2:
+        orientations = ["h", "v"]
+    elif count == 3:
+        orientations = ["h", "h", "v"] if random.random() < 0.5 else ["h", "v", "v"]
+    else:
+        orientations = ["h", "h", "v", "v"]
+    random.shuffle(orientations)
+    return orientations
