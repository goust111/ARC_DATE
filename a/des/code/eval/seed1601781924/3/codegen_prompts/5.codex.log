 389: def _gen_attempt() -> np.ndarray | None:
 390:     """Single attempt to generate a valid puzzle grid."""
 391:     frame_count = random.randint(*_FRAME_COUNT_RANGE)
 392: 
 393:     # --- Room count assignment ---
 394:     available = list(range(_ROOM_COUNT_RANGE[0], _ROOM_COUNT_RANGE[1] + 1))
 395:     allow_tie = random.random() < _TIE_PROBABILITY and frame_count >= 3
 396:     if allow_tie:
 397:         distinct_needed = frame_count - 1
 398:         chosen = random.sample(available, min(distinct_needed, len(available)))
 399:         if len(chosen) < distinct_needed:
 400:             return None
 401:         room_counts = chosen + [random.choice(chosen)]
 402:     else:
 403:         if frame_count > len(available):
 404:             return None
 405:         room_counts = random.sample(available, frame_count)
 406:     random.shuffle(room_counts)
 407: 
 408:     # --- Color assignment ---
 409:     chosen_colors = random.sample(list(range(1, 10)), frame_count + 1)
 410:     frame_colors = chosen_colors[:frame_count]
 411:     noise_color = chosen_colors[frame_count]
 412: 
 413:     # --- Grid/frame size selection ---
 414:     cfg = _GRID_SIZE_BY_FRAMES.get(frame_count, _GRID_SIZE_BY_FRAMES[3])
 415:     h_min, h_max, w_min, w_max, f_max_h, f_max_w = cfg
 416:     grid_h = random.randint(h_min, h_max)
 417:     grid_w = random.randint(w_min, w_max)
 418: 
 419:     # --- Build frames ---
 420:     frames = []
 421:     for color, target_rooms in zip(frame_colors, room_counts):
 422:         frame_data = _build_frame(target_rooms, max_h=f_max_h, max_w=f_max_w)
 423:         if frame_data is None:
 424:             return None
 425:         fh, fw = frame_data.shape
 426:         if fh > grid_h - 2 or fw > grid_w - 2:
 427:             return None
 428:         frames.append((color, target_rooms, frame_data))
 429: 
 430:     # --- Place frames (largest first, random position) ---
 431:     positions = [None] * frame_count
 432:     for idx in sorted(range(frame_count), key=lambda i: -frames[i][2].size):
 433:         fh, fw = frames[idx][2].shape
 434:         positions[idx] = (random.randint(0, grid_h - fh), random.randint(0, grid_w - fw))
 435: 
 436:     # --- Force overlaps for tied pairs ---
 437:     tied_pairs = [(i, j) for i in range(frame_count) for j in range(i + 1, frame_count)
 438:                   if room_counts[i] == room_counts[j]]
 439:     for i, j in tied_pairs:
 440:         _force_overlap(positions, i, j, frames, grid_h, grid_w)
 441: 
 442:     # --- Force some non-tied overlaps ---
 443:     non_tied = [(i, j) for i in range(frame_count) for j in range(i + 1, frame_count)
 444:                 if room_counts[i] != room_counts[j]]
 445:     n_extra = random.randint(*_EXTRA_OVERLAP_RANGE)
 446:     if n_extra > 0 and non_tied:
 447:         random.shuffle(non_tied)
 448:         for i, j in non_tied[:min(n_extra, len(non_tied))]:
 449:             _force_overlap(positions, i, j, frames, grid_h, grid_w)
 450: 
 451:     # --- Render and add noise ---
 452:     render_order = list(range(frame_count))
 453:     random.shuffle(render_order)
 454: 
 455:     grid, frame_mask = _render_frames(frames, positions, render_order, grid_h, grid_w)
 456:     _scatter_noise(grid, frame_mask, noise_color, grid_h, grid_w)
 457: 
 458:     # --- Validate via solver oracle ---
 459:     try:
 460:         output = main(grid)
 461:     except Exception:
 462:         return None
 463: 
 464:     # Build expected output: rows sorted by (room_count, render_order position)
 465:     frame_info = sorted(
 466:         [(room_counts[i], render_order.index(i), frame_colors[i]) for i in range(frame_count)])
 467:     max_rooms = max(rc for rc, _, _ in frame_info)
 468:     expected = np.full((frame_count, max_rooms), noise_color, dtype=int)
 469:     for r, (rc, _, color) in enumerate(frame_info):
 470:         expected[r, :rc] = color
 471: 
 472:     return grid if np.array_equal(output, expected) else None
 473: 
