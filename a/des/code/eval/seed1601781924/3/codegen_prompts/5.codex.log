 451: def _assemble_valid_input(
 452:     panels: list[np.ndarray],
 453:     template: np.ndarray,
 454:     output: np.ndarray,
 455:     horizontal: bool,
 456: ) -> np.ndarray | None:
 457:     """Return tiled input only when the solver oracle matches planned output."""
 458:     if horizontal:
 459:         inp = np.concatenate([*panels, template], axis=1)
 460:     else:
 461:         inp = np.concatenate([*panels, template], axis=0)
 462: 
 463:     try:
 464:         predicted = main(inp)
 465:     except Exception:
 466:         return None
 467:     if not np.array_equal(predicted, output):
 468:         return None
 469:     return inp
