+        row_ends = {comp["bbox"][2] for comp in comps}
+        if len(heights) != 1 or len(widths) != 1 or len(row_starts) != 1 or len(row_ends) != 1:
+            continue
+        row_start = next(iter(row_starts))
+        if row_start < h // 2:
