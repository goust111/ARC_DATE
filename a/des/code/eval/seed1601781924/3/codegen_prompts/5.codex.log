 373: def _place_masks(
 374:     occupied: np.ndarray,
 375:     local_masks: dict[int, np.ndarray],
 376: ) -> dict[int, np.ndarray] | None:
 377:     largest = local_masks[0]
 378:     patch = np.where(largest, 1, MASK_TRANSPARENT)
 379:     try:
 380:         r0, c0 = random_free_location(
 381:             occupied, patch, transparent=MASK_TRANSPARENT, border=PLACEMENT_BORDER
 382:         )
 383:     except ValueError:
 384:         return None
 385:     paste(occupied, patch, r0, c0, transparent=MASK_TRANSPARENT)
 386: 
 387:     out: dict[int, np.ndarray] = {}
 388:     for back, local in local_masks.items():
 389:         full = np.zeros_like(occupied, dtype=bool)
 390:         full[r0 : r0 + local.shape[0], c0 : c0 + local.shape[1]] = local
 391:         out[back] = full
 392:     return out
