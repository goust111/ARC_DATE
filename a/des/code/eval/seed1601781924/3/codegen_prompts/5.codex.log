  29: def main(grid: np.ndarray) -> np.ndarray:
  30:     """Rotate each vertical bar's color one slot right and its height one slot left.
  31: 
  32:     Input structure
  33:     - A dominant background surrounds several monochrome one-cell-wide vertical bars.
  34:     - Every bar is bottom-aligned and occupies a distinct column.
  35:     - The ordered bar slots are read from left to right.
  36: 
  37:     Rule
  38:     - Keep the grid shape and the bar columns unchanged.
  39:     - At slot i, use the color from the previous slot cyclically.
  40:     - At slot i, use the height from the next slot cyclically.
  41: 
  42:     Key insight
  43:     - Color and height are independent cyclic attributes of the ordered bar slots:
  44:       colors rotate right while heights rotate left.
  45:     """
  46:     g = np.asarray(grid, dtype=int)
  47:     height = g.shape[0]
  48:     bg = get_bg(g)
  49:     bars = _extract_bars(g, bg)
  50: 
  51:     out = np.full_like(g, bg)
  52:     count = len(bars)
  53:     for i, bar in enumerate(bars):
  54:         color = bars[(i - 1) % count]["color"]
  55:         bar_height = bars[(i + 1) % count]["height"]
  56:         assert 1 <= bar_height <= height
  57:         out[height - bar_height : height, bar["col"]] = color
  58: 
  59:     return out
  60: 
  61: # --------------- generator (o5x) ---------------
  62: 
  63: _RNG = np.random.default_rng()
  64: 
  65: # Canvas/bar bounds.
  66: BAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE = 3, 6
  67: BACKGROUND_COLOR, MIN_BAR_HEIGHT = 7, 1
  68: BAR_COL_OFFSET, BAR_COL_STRIDE = 1, 2
  69: # Color and transform sampling.
  70: COLOR_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]
  71: OUTPUT_COLOR_SHIFT, OUTPUT_HEIGHT_SHIFT = 1, -1
  72: # Retry limit.
  73: MAX_GENERATION_ATTEMPTS = 300
  74: 
  75: 
  76: def _render_bars(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:
  77:     side = BAR_COL_STRIDE * n + BAR_COL_OFFSET
  78:     grid = np.full((side, side), BACKGROUND_COLOR, dtype=int)
  79:     for i, (color, bar_height) in enumerate(zip(colors, heights)):
  80:         col = BAR_COL_STRIDE * i + BAR_COL_OFFSET
  81:         grid[side - int(bar_height) : side, col] = int(color)
  82:     return grid
  83: 
  84: 
  85: def _expected_output(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:
  86:     out_colors = np.roll(colors, OUTPUT_COLOR_SHIFT)
  87:     out_heights = np.roll(heights, OUTPUT_HEIGHT_SHIFT)
  88:     return _render_bars(n, out_colors, out_heights)
  89: 
  90: 
  91: def _gen_attempt() -> np.ndarray | None:
  92:     n = int(_RNG.integers(BAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE))
  93:     side = BAR_COL_STRIDE * n + BAR_COL_OFFSET
  94:     colors = _RNG.choice(COLOR_POOL, size=n, replace=False)
  95:     heights = _RNG.integers(MIN_BAR_HEIGHT, side, size=n)
  96:     if len(set(map(int, heights))) == 1:
  97:         idx = int(_RNG.integers(n))
  98:         choices = [h for h in range(MIN_BAR_HEIGHT, side) if h != int(heights[idx])]
  99:         heights[idx] = int(_RNG.choice(choices))
 100: 
 101:     grid = _render_bars(n, colors, heights)
 102:     if np.array_equal(main(grid), _expected_output(n, colors, heights)):
 103:         return grid
 104:     return None
 105: 
 106: 
 107: def generate_input() -> np.ndarray:
 108:     for _ in range(MAX_GENERATION_ATTEMPTS):
 109:         grid = _gen_attempt()
 110:         if grid is not None:
 111:             return grid
 112:     raise RuntimeError("failed to generate valid input")

