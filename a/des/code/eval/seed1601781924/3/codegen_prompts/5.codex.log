 363: def _schedules(n_prior: int, n_colors: int) -> list[dict]:
 364:     if n_prior == SHORT_PRIOR_COUNT:
 365:         return [SCHEDULE_ALWAYS_2 for _ in range(n_colors)]
 366: 
 367:     schedules = [SCHEDULE_ALWAYS_4, random.choice(SCHEDULE_SECOND_CHOICES)]
 368:     if n_colors == MAX_DYNAMIC_COLORS:
 369:         schedules.append(random.choice(SCHEDULE_THIRD_CHOICES))
 370:     return schedules
