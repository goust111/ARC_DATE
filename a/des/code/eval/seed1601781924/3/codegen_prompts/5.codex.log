 283: def _build_groups(bg: int) -> tuple[list[dict], list[dict]]:
 284:     """Create duplicate-shape (top) and unique-shape (bottom) component groups."""
 285:     dup_layout = DUP_LAYOUTS[int(_RNG.integers(0, len(DUP_LAYOUTS)))]
 286:     n_singletons = 2 if sum(dup_layout) == 4 else int(_RNG.integers(2, 4))
 287: 
 288:     colors = [c for c in range(NUM_COLORS) if c != bg]
 289:     _RNG.shuffle(colors)
 290: 
 291:     used_shape_keys: set[tuple[bytes, tuple[int, int]]] = set()
 292:     top, ci = [], 0
 293:     for count in dup_layout:
 294:         for _ in range(200):
 295:             area = int(_RNG.integers(*AREA_RANGE))
 296:             template = _make_component(area, colors[ci], bg)
 297:             if template["shape_key"] not in used_shape_keys:
 298:                 used_shape_keys.add(template["shape_key"])
 299:                 break
 300:         else:
 301:             raise RuntimeError("failed to create a new duplicate template shape")
 302:         top.append(template)
 303:         ci += 1
 304:         for _ in range(count - 1):
 305:             top.append(_clone_component(template, colors[ci], bg))
 306:             ci += 1
 307: 
 308:     bottom = []
 309:     while len(bottom) < n_singletons:
 310:         area = int(_RNG.integers(*AREA_RANGE))
 311:         comp = _make_component(area, colors[ci], bg)
 312:         if comp["shape_key"] in used_shape_keys:
 313:             continue
 314:         used_shape_keys.add(comp["shape_key"])
 315:         bottom.append(comp)
 316:         ci += 1
 317:     return top, bottom
 318: 
