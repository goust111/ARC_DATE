+        ordered = sorted(comps, key=lambda comp: (comp["bbox"][1], comp["bbox"][0]))
+        if any(ordered[i]["bbox"][1] <= ordered[i - 1]["bbox"][3] for i in range(1, len(ordered))):
+            continue
+        candidates.append((len(comps), row_start, int(color), ordered))
