 243: def _build_output(comps: list[dict], H: int, W: int, bg: int) -> np.ndarray:
 244:     """Paint all components at their output positions."""
 245:     out = np.full((H, W), bg, dtype=int)
 246:     for comp in comps:
 247:         paste(out, comp["pat"], comp["out_r0"], comp["c0"], transparent=bg)
 248:     return out
 249: 
