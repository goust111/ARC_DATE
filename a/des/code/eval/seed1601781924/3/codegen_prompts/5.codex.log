 200: def _build_frame(target_rooms: int, max_h: int = 22, max_w: int = 25) -> np.ndarray | None:
 201:     """Build a boolean wall array with exactly target_rooms enclosed regions."""
 202:     if target_rooms == 1:
 203:         gap_h = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_h - 2))
 204:         gap_w = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_w - 2))
 205:         h, w = gap_h + 2, gap_w + 2
 206:         walls = np.zeros((h, w), dtype=bool)
 207:         walls[0, :] = True
 208:         walls[h - 1, :] = True
 209:         walls[:, 0] = True
 210:         walls[:, w - 1] = True
 211:         return walls
 212: 
 213:     # For target_rooms >= 2: grid of cells, then selectively merge
 214:     possible_configs = []
 215:     for nv in range(2, 6):
 216:         for nh in range(2, 5):
 217:             cells = (nv - 1) * (nh - 1)
 218:             if target_rooms <= cells <= target_rooms + 4:
 219:                 possible_configs.append((nv, nh, cells))
 220:     if not possible_configs:
 221:         for nv in range(2, 7):
 222:             for nh in range(2, 6):
 223:                 cells = (nv - 1) * (nh - 1)
 224:                 if cells >= target_rooms:
 225:                     possible_configs.append((nv, nh, cells))
 226:     if not possible_configs:
 227:         return None
 228: 
 229:     n_vcols, n_hrows, total_cells = random.choice(possible_configs)
 230:     n_row_gaps = n_hrows - 1
 231:     n_col_gaps = n_vcols - 1
 232:     min_gap, max_gap = _CELL_GAP_RANGE
 233: 
 234:     if min_gap * n_row_gaps > max_h - 1 or min_gap * n_col_gaps > max_w - 1:
 235:         return None
 236: 
 237:     row_gaps = _random_gaps(n_row_gaps, min_gap, max_gap, max_h - 1)
 238:     col_gaps = _random_gaps(n_col_gaps, min_gap, max_gap, max_w - 1)
 239:     if row_gaps is None or col_gaps is None:
 240:         return None
 241: 
 242:     # Compute line positions from cumulative gaps
 243:     vcol_positions = [0]
 244:     for gap in col_gaps:
 245:         vcol_positions.append(vcol_positions[-1] + gap)
 246:     hrow_positions = [0]
 247:     for gap in row_gaps:
 248:         hrow_positions.append(hrow_positions[-1] + gap)
 249: 
 250:     frame_h = hrow_positions[-1] + 1
 251:     frame_w = vcol_positions[-1] + 1
 252:     walls = np.zeros((frame_h, frame_w), dtype=bool)
 253:     for r in hrow_positions:
 254:         walls[r, :] = True
 255:     for c in vcol_positions:
 256:         walls[:, c] = True
 257: 
 258:     cells_to_merge = total_cells - target_rooms
 259:     if cells_to_merge == 0:
 260:         return walls
 261: 
 262:     # Union-find to merge adjacent cells by removing internal wall segments
 263:     parent = list(range(total_cells))
 264: 
 265:     def find(x):
 266:         while parent[x] != x:
 267:             parent[x] = parent[parent[x]]
 268:             x = parent[x]
 269:         return x
 270: 
 271:     def union(x, y):
 272:         px, py = find(x), find(y)
 273:         if px == py:
 274:             return False
 275:         parent[px] = py
 276:         return True
 277: 
 278:     def cell_id(cr, cc):
 279:         return cr * (n_vcols - 1) + cc
 280: 
 281:     # Enumerate internal wall segments (between adjacent cells)
 282:     internal_segments = []
 283:     for hi in range(1, n_hrows - 1):
 284:         r = hrow_positions[hi]
 285:         for ci in range(n_vcols - 1):
 286:             c0, c1 = vcol_positions[ci], vcol_positions[ci + 1]
 287:             internal_segments.append(('h', r, c0, c1, cell_id(hi - 1, ci), cell_id(hi, ci)))
 288:     for ci in range(1, n_vcols - 1):
 289:         c = vcol_positions[ci]
 290:         for hi in range(n_hrows - 1):
 291:             r0, r1 = hrow_positions[hi], hrow_positions[hi + 1]
 292:             internal_segments.append(('v', c, r0, r1, cell_id(hi, ci - 1), cell_id(hi, ci)))
 293: 
 294:     random.shuffle(internal_segments)
 295:     merged = 0
 296:     for seg in internal_segments:
 297:         if merged >= cells_to_merge:
 298:             break
 299:         if seg[0] == 'h':
 300:             _, r, c0, c1, ca, cb = seg
 301:             if find(ca) != find(cb):
 302:                 union(ca, cb)
 303:                 walls[r, c0 + 1:c1] = False
 304:                 merged += 1
 305:         else:
 306:             _, c, r0, r1, ca, cb = seg
 307:             if find(ca) != find(cb):
 308:                 union(ca, cb)
 309:                 walls[r0 + 1:r1, c] = False
 310:                 merged += 1
 311: 
 312:     if merged < cells_to_merge:
 313:         return None
 314:     if _count_enclosed_regions(walls) != target_rooms:
 315:         return None
 316:     return walls
