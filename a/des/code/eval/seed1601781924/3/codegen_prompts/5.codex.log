 395: def _place_dynamic_masks(
 396:     occupied: np.ndarray,
 397:     n_dynamic: int,
 398:     schedules: list[dict],
 399:     motion_axis: int,
 400:     n_prior: int,
 401:     axis_len: int,
 402:     line_len: int,
 403: ) -> dict[int, dict[int, np.ndarray]] | None:
 404:     """Return full-panel masks by color index, or None if any blob fails."""
 405:     order = list(range(n_dynamic))
 406:     random.shuffle(order)
 407:     placed: dict[int, dict[int, np.ndarray]] = {}
 408:     for idx in order:
 409:         sched = schedules[idx]
 410:         if sched["scheduled"]:
 411:             max_back = max((n_prior - t) // sched["period"] for t in sched["times"])
 412:         else:
 413:             last = sched["times"][-1]
 414:             max_back = max((last - t) // sched["period"] for t in sched["times"])
 415: 
 416:         blob = _make_blob(axis_len, line_len, motion_axis, max_back)
 417:         if blob is None:
 418:             return None
 419:         _growth, local_masks = blob
 420:         full_masks = _place_masks(occupied, local_masks)
 421:         if full_masks is None:
 422:             return None
 423:         placed[idx] = full_masks
 424:     return placed
