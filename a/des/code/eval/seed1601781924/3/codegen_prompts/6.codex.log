+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MAGENTA = 6
+AZURE = 8
+
+PALETTE_COLOR_POOL = (1, 2, 3, 4, 7, 9)
+MAX_GENERATION_ATTEMPTS = 400
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _is_full_rect_frame(points: list[tuple[int, int]]) -> bool:
+    r0, c0, r1, c1 = _bbox(points)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return False
+    point_set = set(points)
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            on_border = r in (r0, r1) or c in (c0, c1)
+            if on_border != ((r, c) in point_set):
+                return False
+    return True
+
+
+def _extract_palette(grid: np.ndarray) -> tuple[list[int], tuple[int, int, int, int]]:
+    candidates: list[tuple[tuple[int, int], list[int], tuple[int, int, int, int]]] = []
+    for comp in _components(grid == GREY):
+        if not _is_full_rect_frame(comp):
+            continue
+        r0, c0, r1, c1 = _bbox(comp)
+        interior = grid[r0 + 1 : r1, c0 + 1 : c1]
+        if interior.size == 0:
+            continue
