+    marker_set = set(markers)
+    graph = {marker: set() for marker in markers}
+    for r, c in markers:
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            while 0 <= nr < h and 0 <= nc < w:
+                if (nr, nc) in marker_set:
