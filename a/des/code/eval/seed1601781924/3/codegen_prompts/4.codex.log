+        c0 = min(c for _, c in tower_cells)
+        for dr in range(2):
+            for dc in range(2):
+                cell = (r0 + dr, c0 + dc)
+                grid[cell] = GREEN if (dr, dc) == green_corner else color
+
+    for ray in rays:
+        for mirror in ray["mirrors"]:
+            for r, c in mirror:
