+    blocked_paths: Counter,
+    allowed_overlap: set[tuple[int, int]],
+) -> dict[str, object] | None:
+    backward_dir = (-arrival_dir[0], -arrival_dir[1])
+    cur = p
+    cur_dir = backward_dir
+    back_cells: list[tuple[int, int]] = []
+    local_paths: set[tuple[int, int]] = set()
