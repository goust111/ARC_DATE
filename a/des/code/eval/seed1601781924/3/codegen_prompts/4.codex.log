+
+
+def _choose_intersection_point(
+    h: int,
+    w: int,
+    scenario: str,
+    primary_dir: tuple[int, int],
+) -> tuple[tuple[int, int], set[tuple[int, int]]] | None:
+    if scenario == "pair":
