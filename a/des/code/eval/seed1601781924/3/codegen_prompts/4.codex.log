+        r += dr
+        c += dc
+        if not _in_bounds(r, c, h, w):
+            return steps
+        steps += 1
+
+
+def _extend_to_boundary(start: tuple[int, int], direction: tuple[int, int], h: int, w: int) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
