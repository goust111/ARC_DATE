+    return {
+        "green": green_rc,
+        "initial_dir": initial_dir,
+        "path": prefix_cells,
+        "path_set": set(prefix_cells),
+        "objects": set(local_objects) | set(tower_cells),
+        "mirrors": mirrors,
+        "tower_cells": tower_cells,
