+    w: int,
+    blocked_objects: set[tuple[int, int]],
+    blocked_paths: Counter,
+    allowed_overlap: set[tuple[int, int]],
+    total_reflections: int,
+) -> dict[str, object] | None:
+    for _ in range(RAY_ATTEMPTS):
