+
+def _tower_cells_from_green(green_rc: tuple[int, int], direction: tuple[int, int]) -> list[tuple[int, int]]:
+    gr, gc = green_rc
+    rr, cc = DIR_TO_CORNER[direction]
+    r0 = gr - rr
+    c0 = gc - cc
