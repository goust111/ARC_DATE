+
+def _iter_segment(start: tuple[int, int], direction: tuple[int, int], length: int) -> list[tuple[int, int]]:
+    r, c = start
+    dr, dc = direction
+    return [(r + dr * step, c + dc * step) for step in range(1, length + 1)]
