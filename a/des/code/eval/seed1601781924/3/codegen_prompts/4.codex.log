+    if not finals:
+        return None
+
+    seg, tower_cells, green_rc, initial_dir = random.choice(finals)
+    back_cells.extend(seg)
+    forward_cells = list(reversed(back_cells))
+    prefix_cells = forward_cells[1:] + [p]
