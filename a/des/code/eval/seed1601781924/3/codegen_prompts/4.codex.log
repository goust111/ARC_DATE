+    rr, cc = DIR_TO_CORNER[direction]
+    r0 = green_rc[0] - rr
+    c0 = green_rc[1] - cc
+    for dr in range(2):
+        for dc in range(2):
+            grid[r0 + dr, c0 + dc] = GREEN if (dr, dc) == (rr, cc) else color
