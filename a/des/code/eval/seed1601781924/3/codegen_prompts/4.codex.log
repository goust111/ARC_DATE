+    final_seg = _extend_to_boundary(cur, cur_dir, h, w)
+    if not _valid_path_cells(final_seg, blocked_objects | local_objects, blocked_paths, local_paths, allowed_overlap):
+        return None
+    path.extend(final_seg)
