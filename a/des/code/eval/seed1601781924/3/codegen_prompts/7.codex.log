+STAMP_COLORS = [1, 2, 3, 6, 7]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIRECTION_VECTORS = {
+    "up": (-1, 0),
+    "down": (1, 0),
