+def _normalize(coords: list[tuple[int, int]]) -> tuple[list[tuple[int, int]], int, int]:
+    r0, c0, r1, c1 = _bbox(coords)
+    shifted = sorted((r - r0, c - c0) for r, c in coords)
+    return shifted, int(r1 - r0 + 1), int(c1 - c0 + 1)
