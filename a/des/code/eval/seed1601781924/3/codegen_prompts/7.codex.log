+import itertools
+import random
+
+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+GREY = 5
+AZURE = 8
+MAROON = 9
+
+STAMP_COLORS = [1, 2, 3, 6, 7]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIRECTION_VECTORS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
