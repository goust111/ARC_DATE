+    expected_centers = _transform_points(
+        expected_centers,
+        (height, width),
+        flip_lr=flip_lr,
+        flip_ud=flip_ud,
+        transpose=transpose,
+    )
+
+    if len(_find_containers(grid)) != len(expected_centers):
+        return None
+    out = main(grid)
+    for r, c, color in expected_centers:
+        if int(out[r, c]) != int(color):
+            return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
