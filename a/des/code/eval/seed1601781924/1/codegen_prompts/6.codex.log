+    flip_lr = rng.random() < 0.5
+    flip_ud = rng.random() < 0.5
+    transpose = rng.random() < 0.5
+    if flip_lr:
+        grid = np.fliplr(grid)
+    if flip_ud:
+        grid = np.flipud(grid)
+    if transpose:
