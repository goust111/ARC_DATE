+    assert idx in (0, 1)
+    out_dir = REFLECT[kind][direction]
+    exit_idx = idx if kind == "\\" else 1 - idx
+    if out_dir == "U":
+        return (pr - 1, pc + exit_idx), out_dir
+    if out_dir == "D":
+        return (pr + 2, pc + exit_idx), out_dir
+    if out_dir == "L":
