+
+
+def _find_towers(
+    g: np.ndarray,
+    bg: int,
+    ignored: set[tuple[int, int]],
+) -> list[dict[str, int | str]]:
+    h, w = g.shape
+    mask = np.zeros((h, w), dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if int(g[r, c]) != bg and (r, c) not in ignored:
