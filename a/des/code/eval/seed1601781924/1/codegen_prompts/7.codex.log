+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+MAROON = 9
+PALETTE = (1, 2, 3, 4, 6, 7, 8)
+
+DIR_VECTORS = {
+    "R": (0, 1),
+    "L": (0, -1),
+    "U": (-1, 0),
+    "D": (1, 0),
+}
+
+REFLECT = {
+    "\\": {"R": "D", "D": "R", "L": "U", "U": "L"},
+    "/": {"R": "U", "U": "R", "L": "D", "D": "L"},
+}
+
+STRAIGHT_TEMPLATES = [("R",), ("U",)]
+TURN_TEMPLATES = [("R", "U"), ("R", "D"), ("U", "L"), ("U", "R")]
+DOUBLE_TEMPLATES = [
+    ("R", "U", "R"),
+    ("R", "D", "R"),
+    ("U", "L", "U"),
+    ("U", "R", "U"),
+]
+
+GRID_H_RANGE = (10, 17)
+GRID_W_RANGE = (12, 20)
+TABLE_ROWS_RANGE = (1, 4)
+TOWER_COUNT_CHOICES = (1, 2, 3)
+GEN_RETRIES = 400
+PLACE_RETRIES = 120
+SEG_LEN_RANGE = (1, 4)
+MIN_TOTAL_LINE_LEN = 3
