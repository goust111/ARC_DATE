+def _prism_exit(
+    prism: dict[str, int | str], direction: str, hit: tuple[int, int]
+) -> tuple[tuple[int, int], str]:
+    pr = int(prism["top"])
+    pc = int(prism["left"])
+    kind = str(prism["kind"])
+    hr, hc = hit
+    if direction == "R":
