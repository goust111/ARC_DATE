+        idx = hr - pr
+    elif direction == "L":
+        assert hc == pc + 1
+        idx = hr - pr
+    elif direction == "U":
+        assert hr == pr + 1
+        idx = hc - pc
+    else:
+        assert direction == "D"
+        assert hr == pr
+        idx = hc - pc
