+
+
+def _render_routes(shape: tuple[int, int], routes: list[dict[str, object]]) -> np.ndarray:
+    h, w = shape
+    grid = np.full((h, w), BG, dtype=int)
+    for route in routes:
+        for r, c in route["channel"]:
+            grid[r, c] = CHANNEL
+        for r, c in route["markers"]:
+            grid[r, c] = MARKER
