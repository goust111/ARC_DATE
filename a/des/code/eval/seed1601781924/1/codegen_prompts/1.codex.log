+                    "seed": (r0 + seed[0], c0 + seed[1]),
+                    "interior_cells": interior_cells,
+                }
+            )
+            break
+        else:
+            return None
+
+    expected = inp.copy()
+    for room in rooms:
+        _apply_periodic_fill(
+            expected,
+            room["interior_cells"],
+            room["seed"],
+            room["color"],
+            templates[int(room["color"])],
