+        mask = np.zeros((h, w), dtype=bool)
+        mask[:, :thickness] = True
+        mask[-thickness:, :] = True
+        return np.rot90(mask, rng.randrange(4))
+
+    if kind == "T":
+        h = rng.randint(4, 7)
+        w = rng.randint(3, 7)
