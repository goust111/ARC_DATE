    try:
        out = main(canvas)
    except Exception:
        return None
    if not np.array_equal(out, output):
        return None
    return canvas


def generate_input() -> np.ndarray:
    for _ in range(MAX_ATTEMPTS):
        g = _gen_attempt()
        if g is not None:
