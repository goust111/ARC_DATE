+def _has_enclosed_background(mask: np.ndarray) -> bool:
+    if np.all(mask):
+        return False
+    h, w = mask.shape
+    for comp in _components(~mask):
+        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in comp):
