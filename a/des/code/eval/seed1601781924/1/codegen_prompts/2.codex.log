+
+    starts = [profile[0] for profile in profiles]
+    ends = [profile[1] for profile in profiles]
+    width = pieces[0]["mask"].shape[1]
+    n = len(pieces)
+    solutions = []
+
+    for perm in itertools.permutations(range(n)):
