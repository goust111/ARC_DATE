   330	def _vertical_chain_masks(rng: random.Random) -> list[np.ndarray] | None:
   331	    for _ in range(BOUNDARY_RETRIES):
   332	        count = rng.randint(*PIECE_COUNT_RANGE)
   333	        common_span = rng.randint(*COMMON_SPAN_RANGE)
   334	        total_span = rng.randint(max(MIN_THICKNESS * count + 2, 11), TOTAL_SPAN_MAX)
   335	        widths = _random_composition(rng, total_span, count, MIN_THICKNESS)
   336	        amplitude = max(1, min(2, min(widths) - 2))
   337	        bases = np.cumsum(widths)[:-1]
   338	
   339	        boundaries = []
   340	        varied = False
   341	        for base in bases:
   342	            path = base + _random_walk(rng, common_span, amplitude)
   343	            boundaries.append(path)
   344	            varied |= len(set(map(int, path.tolist()))) > 1
   345	        if not varied or not _valid_boundaries(boundaries, total_span):
   346	            continue
   347	
   348	        pieces = []
   349	        left = np.zeros(common_span, dtype=int)
   350	        for boundary in boundaries + [np.full(common_span, total_span, dtype=int)]:
   351	            start_abs = left
   352	            end_abs = boundary - 1
   353	            min_start = int(start_abs.min())
   354	            max_end = int(end_abs.max())
   355	            mask = np.zeros((common_span, max_end - min_start + 1), dtype=bool)
   356	            for r in range(common_span):
   357	                mask[r, int(start_abs[r] - min_start) : int(end_abs[r] - min_start) + 1] = True
   358	            pieces.append(mask)
   359	            left = boundary
