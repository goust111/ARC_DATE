    59	def _component_mask(comp: dict) -> np.ndarray:
    60	    r0, c0, r1, c1 = comp["bbox"]
    61	    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
    62	    for r, c in comp["coords"]:
    63	        mask[r - r0, c - c0] = True
    64	    return mask
