   295	def _random_composition(rng: random.Random, total: int, parts: int, minimum: int) -> list[int]:
   296	    values = [minimum] * parts
   297	    for _ in range(total - minimum * parts):
   298	        values[rng.randrange(parts)] += 1
   299	    rng.shuffle(values)
   300	    return values
