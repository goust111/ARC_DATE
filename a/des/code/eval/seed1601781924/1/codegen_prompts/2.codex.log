    67	def _extract_input_parts(grid: np.ndarray) -> tuple[list[dict], list[int]]:
    68	    bg = _bg_color(grid)
    69	    h, w = grid.shape
    70	    strip_candidates = []
    71	    pieces: list[dict] = []
    72	    for comp in _components(grid, bg):
    73	        r0, c0, r1, c1 = comp["bbox"]
    74	        height = r1 - r0 + 1
    75	        width = c1 - c0 + 1
    76	        if len(comp["colors"]) > 1:
    77	            touches_corner = (r0 in (0, h - 1)) and (c0 == 0 or c1 == w - 1)
    78	            if height == 1 and len(comp["coords"]) == width and touches_corner:
    79	                strip_candidates.append(comp)
    80	            continue
    81	        color = next(iter(comp["colors"]))
    82	        pieces.append({"color": int(color), "mask": _component_mask(comp)})
