   317	def _valid_boundaries(boundaries: list[np.ndarray], total_span: int) -> bool:
   318	    common = len(boundaries[0]) if boundaries else 0
   319	    for i in range(common):
   320	        prev = 0
   321	        for boundary in boundaries:
   322	            if int(boundary[i]) - prev < MIN_THICKNESS:
   323	                return False
   324	            prev = int(boundary[i])
   325	        if total_span - prev < MIN_THICKNESS:
   326	            return False
   327	    return True
