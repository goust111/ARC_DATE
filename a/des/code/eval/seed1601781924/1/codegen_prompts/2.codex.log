   303	def _random_walk(rng: random.Random, length: int, amplitude: int) -> np.ndarray:
   304	    if amplitude <= 0:
   305	        return np.zeros(length, dtype=int)
   306	    current = rng.randint(-amplitude, amplitude)
   307	    values = []
   308	    for _ in range(length):
   309	        current = max(-amplitude, min(amplitude, current + rng.choice((-1, 0, 1))))
   310	        values.append(current)
   311	    if len(set(values)) == 1:
   312	        idx = rng.randrange(length)
   313	        values[idx] = max(-amplitude, min(amplitude, values[idx] + (1 if values[idx] < amplitude else -1)))
   314	    return np.asarray(values, dtype=int)
