    26	def _components(grid: np.ndarray, bg: int) -> list[dict]:
    27	    h, w = grid.shape
    28	    seen = np.zeros((h, w), dtype=bool)
    29	    comps: list[dict] = []
    30	    for r in range(h):
    31	        for c in range(w):
    32	            if seen[r, c] or int(grid[r, c]) == bg:
    33	                continue
    34	            stack = [(r, c)]
    35	            seen[r, c] = True
    36	            coords: list[tuple[int, int]] = []
    37	            colors: set[int] = set()
    38	            while stack:
    39	                cr, cc = stack.pop()
    40	                coords.append((cr, cc))
    41	                colors.add(int(grid[cr, cc]))
    42	                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
    43	                    nr, nc = cr + dr, cc + dc
    44	                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) != bg:
    45	                        seen[nr, nc] = True
    46	                        stack.append((nr, nc))
    47	            rows = [r0 for r0, _ in coords]
    48	            cols = [c0 for _, c0 in coords]
    49	            comps.append(
    50	                {
    51	                    "coords": coords,
    52	                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
    53	                    "colors": colors,
    54	                }
    55	            )
    56	    return comps
