    84	    assert len(strip_candidates) == 1, "expected exactly one corner color strip"
    85	    strip = strip_candidates[0]
    86	    sr, sc0, _, sc1 = strip["bbox"]
    87	    strip_order = [int(grid[sr, c]) for c in range(sc0, sc1 + 1)]
    88	
    89	    piece_colors = [piece["color"] for piece in pieces]
    90	    assert len(pieces) >= 3, "expected at least three puzzle pieces"
    91	    assert len(piece_colors) == len(set(piece_colors)), "piece colors must be unique"
    92	    assert len(strip_order) == len(set(strip_order)), "strip colors must be unique"
    93	    assert set(piece_colors) == set(strip_order), "strip must mention every piece color exactly once"
