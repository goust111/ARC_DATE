+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    if np.any(mask & ~border):
+        return None
+
+    sides = {
+        "top": np.flatnonzero(~mask[0, :]),
+        "right": np.flatnonzero(~mask[:, -1]),
+        "bottom": np.flatnonzero(~mask[-1, :]),
+        "left": np.flatnonzero(~mask[:, 0]),
+    }
