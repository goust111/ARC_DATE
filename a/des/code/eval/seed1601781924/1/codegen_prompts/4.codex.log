+    seed_r0, seed_c0 = _place_seed(seed_patch, bboxes[0], seed_side)
+    if seed_r0 < 0 or seed_c0 < 0 or seed_r0 + seed_h > grid_h or seed_c0 + seed_w > grid_w:
+        return None
+    _stamp_non_bg(grid, seed_patch, seed_r0, seed_c0, bg)
