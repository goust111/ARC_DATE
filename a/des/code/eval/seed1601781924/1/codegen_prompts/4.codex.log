+
+
+def _extract_scene(g: np.ndarray) -> tuple[int, list[dict], dict]:
+    bg = _get_bg(g)
+    comps = _components(g, bg)
+    assert comps
+
+    frames: list[dict] = []
+    others: list[dict] = []
+    for comp in comps:
+        mask = comp["patch"] != bg
+        gap_side = _frame_gap_side(mask)
+        if gap_side is None:
+            others.append(comp)
+        else:
+            frame = dict(comp)
+            frame["gap_side"] = gap_side
+            frames.append(frame)
