+
+def _frame_bboxes(
+    outer_top: int,
+    outer_left: int,
+    outer_h: int,
+    outer_w: int,
+    insets: list[int],
+) -> list[tuple[int, int, int, int]]:
+    bboxes = []
+    offset = 0
+    for idx in range(len(insets) + 1):
+        r0 = outer_top + offset
+        c0 = outer_left + offset
+        r1 = outer_top + outer_h - 1 - offset
+        c1 = outer_left + outer_w - 1 - offset
+        bboxes.append((r0, c0, r1, c1))
+        if idx < len(insets):
