+    return None
+
+
+def _gap_segment(length: int) -> tuple[int, int]:
+    gap_len = random.choice([g for g in FRAME_GAP_CHOICES if g <= length - 2])
+    start = random.randint(1, length - gap_len - 1)
+    return start, gap_len
