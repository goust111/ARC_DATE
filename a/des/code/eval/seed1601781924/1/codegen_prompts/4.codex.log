+    vertical = (ar1 + 1 == br0 or br1 + 1 == ar0) and not (ac1 < bc0 or bc1 < ac0)
+    horizontal = (ac1 + 1 == bc0 or bc1 + 1 == ac0) and not (ar1 < br0 or br1 < ar0)
