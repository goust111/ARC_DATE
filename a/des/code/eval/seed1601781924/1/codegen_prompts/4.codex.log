+
+    expected = _expected_output(grid, bboxes[-1], seed_patch, gap_sides, bg)
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
