+def _detect_clocks(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    h, w = grid.shape
+    clocks: list[dict[str, object]] = []
+    for r0 in range(h - 2):
+        for c0 in range(w - 2):
+            patch = grid[r0 : r0 + 3, c0 : c0 + 3]
+            center = int(patch[1, 1])
+            if center in (bg, GREY, MAROON):
+                continue
+            direction = None
+            for name, pointer in POINTER_BY_DIRECTION.items():
+                ok = True
+                for rr in range(3):
+                    for cc in range(3):
+                        value = int(patch[rr, cc])
+                        if (rr, cc) == (1, 1):
+                            if value != center:
+                                ok = False
+                                break
+                        elif (rr, cc) == pointer:
+                            if value != MAROON:
+                                ok = False
+                                break
+                        elif value != GREY:
+                            ok = False
+                            break
+                    if not ok:
+                        break
+                if ok:
+                    direction = name
+                    break
+            if direction is None:
+                continue
+            clocks.append(
+                {
+                    "color": center,
+                    "direction": direction,
+                    "center": (r0 + 1, c0 + 1),
+                }
+            )
+    return clocks
+
