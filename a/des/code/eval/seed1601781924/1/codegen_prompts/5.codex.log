+
+
+def _path_cells(
+    start: tuple[int, int], end: tuple[int, int]
+) -> set[tuple[int, int]]:
+    if start[0] == end[0]:
+        r = start[0]
+        c0, c1 = sorted((start[1], end[1]))
+        return {(r, c) for c in range(c0, c1 + 1)}
