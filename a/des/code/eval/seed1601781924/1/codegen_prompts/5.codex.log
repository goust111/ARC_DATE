+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+AZURE = 8
+MAROON = 9
+COLOR_POOL = (1, 2, 3, 4, 6, 7)
+DIRECTIONS = ("up", "down", "left", "right")
+POINTER_BY_DIRECTION = {
+    "up": (0, 1),
+    "down": (2, 1),
+    "left": (1, 0),
+    "right": (1, 2),
+}
