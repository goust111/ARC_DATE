+def _analyze_channel(g: np.ndarray, comp: list[tuple[int, int]]) -> list[tuple[int, int]] | None:
+    if len(comp) < 2:
+        return None
+    pset = set(comp)
+    deg = _degrees(pset)
+    if any(v > 2 for v in deg.values()):
