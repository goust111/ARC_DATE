+    cur = start
+    while True:
+        nxts = [nbr for nbr in _neighbors4(*cur) if nbr in pset and nbr != prev]
+        if not nxts:
+            break
+        if len(nxts) != 1:
+            return None
+        nxt = nxts[0]
+        if nxt in seen:
+            return None
+        path.append(nxt)
+        seen.add(nxt)
+        prev, cur = cur, nxt
+    if len(seen) != len(pset):
+        return None
+    return path
+
