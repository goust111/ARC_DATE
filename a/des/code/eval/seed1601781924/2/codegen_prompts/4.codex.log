+def _degrees(pset: set[tuple[int, int]]) -> dict[tuple[int, int], int]:
+    deg: dict[tuple[int, int], int] = {}
+    for cell in pset:
+        deg[cell] = sum((nbr in pset) for nbr in _neighbors4(*cell))
+    return deg
