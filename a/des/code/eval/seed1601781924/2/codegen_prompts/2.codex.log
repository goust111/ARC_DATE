+        placed = False
+        for r0, c0 in candidates:
+            rr0 = max(0, r0 - 1)
+            rr1 = min(grid_h, r0 + ph + 1)
+            cc0 = max(0, c0 - 1)
+            cc1 = min(grid_w, c0 + pw + 1)
