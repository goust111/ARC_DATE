+                    "width": spec["width"],
+                    "area": spec["area"],
+                    "color_even": spec["color_even"],
+                    "color_odd": spec["color_odd"],
+                    "shape_key": spec["shape_key"],
+                }
+                for spec in specs
+            ]
+        )
+        try:
+            solved = main(grid)
+        except AssertionError:
+            continue
+        if np.array_equal(solved, expected):
+            return grid
+    return None
