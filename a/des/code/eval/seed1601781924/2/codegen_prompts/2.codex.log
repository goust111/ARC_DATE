+            choices = [owner for owner in (0, 1) if sizes[owner] < targets[owner] and frontiers[owner]]
+            if not choices:
+                ok = False
+                break
+            if len(choices) == 2:
+                remaining = [targets[owner] - sizes[owner] for owner in (0, 1)]
+                owner = random.choices(choices, weights=[remaining[choice] for choice in choices])[0]
+            else:
+                owner = choices[0]
+            nr, nc = random.choice(frontiers[owner])
+            owners[nr, nc] = owner
+            sizes[owner] += 1
+
