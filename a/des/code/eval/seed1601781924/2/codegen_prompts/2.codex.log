+
+    solutions: list[list[tuple[int, int]]] = []
+
+    def search(remaining: list[int], acc: list[tuple[int, int]]) -> None:
+        if len(solutions) > 1:
+            return
+        if not remaining:
+            solutions.append(list(acc))
+            return
+        first = remaining[0]
