+    return int(mask.sum()) == int(mask.shape[0] * mask.shape[1])
+
+
+def _extract_components(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == BLACK or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
