+def _transform_mask(mask: np.ndarray, flip_lr: bool, rot_k: int) -> np.ndarray:
+    out = np.fliplr(mask) if flip_lr else mask
+    out = np.rot90(out, int(rot_k))
+    return _crop_mask(out)
