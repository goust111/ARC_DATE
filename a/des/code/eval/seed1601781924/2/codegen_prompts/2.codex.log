+        cursor += int(item["height"])
+        if idx + 1 < len(ordered):
+            cursor += 1
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Pair complementary colored fragments into full rectangles, then repaint each rectangle as a checkerboard.
+
+    The solver reconstructs every unique rectangle pair under rotations/flips.
+    To avoid hidden color-id semantics, the even checkerboard cells use the
+    color of the fragment that owns the reconstructed rectangle's top-left cell.
+    The generator always chooses that fragment to be the lower-numbered color,
+    so the visible behavior matches the prompt while staying ARC-like.
+    """
+    components = _extract_components(np.asarray(grid, dtype=int))
+    pairs = _unique_pairing(components)
+    return _render_output(pairs)
+
+
+def _random_partition(rect_h: int, rect_w: int) -> tuple[np.ndarray, np.ndarray] | None:
+    total = rect_h * rect_w
+    all_cells = [(r, c) for r in range(rect_h) for c in range(rect_w)]
+    min_piece = 3
+    lo = max(min_piece, total // 3)
+    hi = min(total - min_piece, (2 * total) // 3)
+    if lo > hi:
+        return None
+
+    for _ in range(160):
+        target_a = random.randint(lo, hi)
+        seed_a, seed_b = random.sample(all_cells, 2)
+        owners = -np.ones((rect_h, rect_w), dtype=int)
+        owners[seed_a] = 0
+        owners[seed_b] = 1
+        sizes = [1, 1]
+        targets = [target_a, total - target_a]
+        ok = True
+
+        while int((owners < 0).sum()) > 0:
+            frontiers: list[list[tuple[int, int]]] = [[], []]
+            for owner in (0, 1):
+                seen_frontier: set[tuple[int, int]] = set()
+                for rr, cc in np.argwhere(owners == owner):
+                    r = int(rr)
+                    c = int(cc)
+                    for dr, dc in DIR4:
+                        nr, nc = r + dr, c + dc
+                        if 0 <= nr < rect_h and 0 <= nc < rect_w and int(owners[nr, nc]) == -1:
+                            seen_frontier.add((nr, nc))
+                frontiers[owner] = list(seen_frontier)
