+            cols = [cc for _rr, cc in coords]
+            r0, c0 = min(rows), min(cols)
+            r1, c1 = max(rows), max(cols)
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in coords:
+                mask[rr - r0, cc - c0] = True
+            components.append(
+                {
+                    "color": color,
+                    "mask": mask,
+                    "area": int(mask.sum()),
+                    "shape_key": _canonical_shape_key(mask),
