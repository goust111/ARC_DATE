+    min_piece = 3
+    lo = max(min_piece, total // 3)
+    hi = min(total - min_piece, (2 * total) // 3)
+    if lo > hi:
+        return None
+
+    for _ in range(160):
+        target_a = random.randint(lo, hi)
+        seed_a, seed_b = random.sample(all_cells, 2)
+        owners = -np.ones((rect_h, rect_w), dtype=int)
+        owners[seed_a] = 0
+        owners[seed_b] = 1
+        sizes = [1, 1]
+        targets = [target_a, total - target_a]
+        ok = True
+
+        while int((owners < 0).sum()) > 0:
+            frontiers: list[list[tuple[int, int]]] = [[], []]
+            for owner in (0, 1):
+                seen_frontier: set[tuple[int, int]] = set()
+                for rr, cc in np.argwhere(owners == owner):
+                    r = int(rr)
+                    c = int(cc)
+                    for dr, dc in DIR4:
