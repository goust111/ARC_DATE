+    specs: list[dict] = []
+
+    for pair_idx, area in enumerate(chosen_areas):
+        rect_h, rect_w = random.choice(dims_by_area[area])
+        partition = _random_partition(rect_h, rect_w)
+        if partition is None:
+            return None
+        mask_a, mask_b = partition
