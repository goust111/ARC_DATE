+    search(list(range(n)), [])
+    assert len(solutions) == 1, "fragment pairing must be unique"
+
+    pairs: list[dict] = []
+    for i, j in solutions[0]:
+        fit = compat[(i, j)]
+        comp_a = components[i]
+        comp_b = components[j]
+        anchor_color = int(comp_a["color"]) if fit["anchor_first"] else int(comp_b["color"])
+        other_color = int(comp_b["color"]) if fit["anchor_first"] else int(comp_a["color"])
+        pairs.append(
+            {
+                "height": int(fit["height"]),
+                "width": int(fit["width"]),
+                "area": int(fit["height"] * fit["width"]),
+                "anchor_color": anchor_color,
+                "other_color": other_color,
+                "shape_key": tuple(sorted((comp_a["shape_key"], comp_b["shape_key"]))),
