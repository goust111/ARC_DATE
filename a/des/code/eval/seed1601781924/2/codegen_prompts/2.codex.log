+    order = list(range(len(pieces)))
+    random.shuffle(order)
+
+    for idx in order:
+        piece = pieces[idx]
+        mask = piece["mask"]
+        ph, pw = mask.shape
+        candidates = [(r, c) for r in range(grid_h - ph + 1) for c in range(grid_w - pw + 1)]
