+        return None
+    rect_h, rect_w = next(iter(results))
+    return {"height": rect_h, "width": rect_w}
+
+
+def _unique_pairing(components: list[dict]) -> list[dict]:
+    n = len(components)
+    assert n >= 4 and n % 2 == 0, "expected an even number of fragments and at least two pairs"
