+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+OPS = tuple((flip_lr, rot_k) for flip_lr in (False, True) for rot_k in range(4))
