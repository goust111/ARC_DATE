+    return components
+
+
+def _ordered_rectangle_dims(area: int) -> list[tuple[int, int]]:
+    dims: list[tuple[int, int]] = []
+    for h in range(1, area + 1):
+        if area % h != 0:
+            continue
+        w = area // h
+        dims.append((int(h), int(w)))
+    dims.sort(key=lambda item: (item[0] * item[1], item[0], item[1]))
+    return dims
