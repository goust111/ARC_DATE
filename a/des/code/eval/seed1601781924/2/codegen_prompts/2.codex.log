+
+def _random_partition(rect_h: int, rect_w: int) -> tuple[np.ndarray, np.ndarray] | None:
+    for _ in range(160):
+        transpose = bool(random.getrandbits(1))
+        base_h, base_w = (rect_w, rect_h) if transpose else (rect_h, rect_w)
+        if base_w < 3:
