+def _random_partition(rect_h: int, rect_w: int) -> tuple[np.ndarray, np.ndarray] | None:
+    total = rect_h * rect_w
+    all_cells = [(r, c) for r in range(rect_h) for c in range(rect_w)]
+    min_piece = 3
+    lo = max(min_piece, total // 3)
+    hi = min(total - min_piece, (2 * total) // 3)
+    if lo > hi:
