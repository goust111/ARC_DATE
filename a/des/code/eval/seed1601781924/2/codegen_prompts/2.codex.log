+    variants: list[tuple[tuple[tuple[int, int], ...], tuple[int, int]]] = []
+    for flip_lr, rot_k in OPS:
+        variant = _transform_mask(mask, flip_lr, rot_k)
+        coords = tuple(map(tuple, np.argwhere(variant)))
+        norm = _normalize_coords(coords)
+        if norm in seen:
