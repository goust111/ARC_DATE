+                break
+            if len(choices) == 2:
+                remaining = [targets[owner] - sizes[owner] for owner in (0, 1)]
+                owner = random.choices(choices, weights=[remaining[choice] for choice in choices])[0]
+            else:
+                owner = choices[0]
+            nr, nc = random.choice(frontiers[owner])
+            owners[nr, nc] = owner
+            sizes[owner] += 1
+
+        if not ok:
+            continue
+
+        mask_a = owners == 0
+        mask_b = owners == 1
+        if not (_is_connected(mask_a) and _is_connected(mask_b)):
+            continue
+        crop_a = _crop_mask(mask_a)
+        crop_b = _crop_mask(mask_b)
+        if min(crop_a.shape) < 2 or min(crop_b.shape) < 2:
+            continue
+        if _is_solid_rect(crop_a) and _is_solid_rect(crop_b):
+            continue
+        return mask_a, mask_b
+    return None
+
+
+def _piece_from_full_mask(mask: np.ndarray, color: int) -> dict:
+    flip_lr, rot_k = random.choice(OPS)
+    transformed = _transform_mask(mask, flip_lr, rot_k)
+    return {
+        "mask": transformed,
+        "color": int(color),
+        "shape_key": _canonical_shape_key(transformed),
+    }
+
+
+def _place_pieces(pieces: list[dict], grid_h: int, grid_w: int) -> np.ndarray | None:
+    grid = np.zeros((grid_h, grid_w), dtype=int)
