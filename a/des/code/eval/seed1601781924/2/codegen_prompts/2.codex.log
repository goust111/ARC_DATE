+            [
+                {
+                    "height": spec["height"],
+                    "width": spec["width"],
+                    "area": spec["area"],
+                    "anchor_color": spec["anchor_color"],
+                    "other_color": spec["other_color"],
+                    "shape_key": spec["shape_key"],
+                }
+                for spec in specs
+            ]
+        )
+        try:
+            solved = main(grid)
+        except AssertionError:
+            continue
+        if np.array_equal(solved, expected):
+            return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _generate_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

