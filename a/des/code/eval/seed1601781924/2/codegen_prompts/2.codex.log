+        comp_a = components[i]
+        comp_b = components[j]
+        anchor_color = int(comp_a["color"]) if fit["anchor_first"] else int(comp_b["color"])
+        other_color = int(comp_b["color"]) if fit["anchor_first"] else int(comp_a["color"])
