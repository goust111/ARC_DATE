+def _place_pieces(pieces: list[dict], grid_h: int, grid_w: int) -> np.ndarray | None:
+    grid = np.zeros((grid_h, grid_w), dtype=int)
+    occupied = np.zeros((grid_h, grid_w), dtype=bool)
+    order = list(range(len(pieces)))
+    random.shuffle(order)
