+        for i in range(n_rows)
+        for j in range(n_cols)
+        if row_heights[i] >= ph and col_widths[j] >= pw
+    ]
+    if len(fit_rooms) < 2:
+        return None
+    if force_small and not any(
+        row_heights[i] < ph or col_widths[j] < pw
