+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _line_segments(line: np.ndarray) -> list[int]:
+    values = [int(x) for x in line.tolist()]
+    segments = [values[0]]
+    for value in values[1:]:
+        if value != segments[-1]:
+            segments.append(value)
+    return segments
