+                continue
+            q = deque([(r, c)])
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
+            touches_boundary = False
+            r0 = r1 = r
+            c0 = c1 = c
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                touches_boundary |= rr in (0, h - 1) or cc in (0, w - 1)
