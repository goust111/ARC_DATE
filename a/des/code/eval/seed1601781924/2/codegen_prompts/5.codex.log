+    occupied = np.zeros((h, w), dtype=bool)
+    rr0 = max(0, frame_r - 1)
+    rr1 = min(h, frame_r + frame_h + 1)
+    cc0 = max(0, frame_c - 1)
+    cc1 = min(w, frame_c + frame_w + 1)
+    occupied[rr0:rr1, cc0:cc1] = True
