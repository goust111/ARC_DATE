+    for spec in specs:
+        _rewrite_tree(
+            expected,
+            int(spec["root_r"]),
+            int(spec["root_c"]),
+            int(spec["attach"]),
+            int(spec["color"]),
+            spec["levels"],
+            template_levels,
+        )
+
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
