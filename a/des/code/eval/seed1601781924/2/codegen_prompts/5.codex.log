+    expected = grid.copy()
+    expected[frame_r : frame_r + frame_h, frame_c : frame_c + frame_w] = BG
+    for spec in specs:
+        _rewrite_tree(
+            expected,
+            int(spec["root_r"]),
+            int(spec["root_c"]),
+            int(spec["attach"]),
+            int(spec["color"]),
+            spec["levels"],
+            template_levels,
