+    grid_slice[patch_mask] = patch[patch_mask]
+
+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+
+    if out.size == 0:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(_MAX_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
