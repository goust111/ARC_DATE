+def _bbox_contains(outer: tuple[int, int, int, int], inner: tuple[int, int, int, int]) -> bool:
+    return bool(
+        outer[0] <= inner[0]
+        and outer[1] <= inner[1]
+        and outer[2] >= inner[2]
+        and outer[3] >= inner[3]
+    )
+
+
+def _bbox_strictly_contains(outer: tuple[int, int, int, int], inner: tuple[int, int, int, int]) -> bool:
+    return bool(
