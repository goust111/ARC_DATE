+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == int(bg) or seen[r, c]:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords_list = []
+            while stack:
+                rr, cc = stack.pop()
+                coords_list.append((rr, cc))
+                for dr, dc in _NEIGHBORS4:
+                    nr, nc = rr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
