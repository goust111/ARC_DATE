+from __future__ import annotations
+
+from collections import defaultdict, deque
+import math
+import random
+
+import numpy as np
+
+
+BG = 0
+TEMPLATE_COLOR = 5
+FRAGMENT_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+QUADRANT_ROTATIONS = {
+    "ul": 0,
+    "ur": 1,
+    "lr": 2,
+    "ll": 3,
+}
+
+GEN_ATTEMPTS = 400
+SHAPE_ATTEMPTS = 300
