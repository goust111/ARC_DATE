+    right_band = max(
+        int(corner_canvases["ur"].shape[1]),
+        int(corner_canvases["lr"].shape[1]),
+    ) + random.randint(2, 4)
+
+    th, tw = template.shape
+    grid_h = top_band + th + bottom_band
+    grid_w = left_band + tw + right_band
