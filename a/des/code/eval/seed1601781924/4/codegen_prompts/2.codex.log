+            cursor += 1
+            color = colors[hole_idx]
+            hole_mask = hole_infos[hole_idx]["hole_mask"]
+            turns = (4 - QUADRANT_ROTATIONS[quadrant]) % 4
+            fragment_mask = _rotate_cw(hole_mask, turns)
+            pieces_by_quadrant[quadrant].append(
