        if mask is None:
            continue
        sig = _canonical_signature(mask)
        if sig in used:
            continue
        used.add(sig)
        shapes.append(mask)
    return shapes if len(shapes) == count else None


def _build_template(shapes: list[np.ndarray]) -> tuple[np.ndarray, list[dict[str, object]]] | None:
    count = len(shapes)
