+        template = np.full((template_h, template_w), TEMPLATE_COLOR, dtype=int)
+        indices = random.sample(range(slot_rows * slot_cols), count)
+        hole_infos = []
+        for shape, idx in zip(shapes, indices):
+            sr = idx // slot_cols
+            sc = idx % slot_cols
+            h, w = shape.shape
+            top = 1 + sr * slot_h + random.randint(1, slot_h - h - 1)
