+    bottom_band = max(
+        int(corner_canvases["ll"].shape[0]),
+        int(corner_canvases["lr"].shape[0]),
+    ) + random.randint(2, 4)
+    left_band = max(
+        int(corner_canvases["ul"].shape[1]),
+        int(corner_canvases["ll"].shape[1]),
