    free_interior = [
        (r, c)
        for r in range(INTERIOR_ROW_BOUNDS[0], INTERIOR_ROW_BOUNDS[1] + 1)
        for c in range(INTERIOR_COL_BOUNDS[0], INTERIOR_COL_BOUNDS[1] + 1)
