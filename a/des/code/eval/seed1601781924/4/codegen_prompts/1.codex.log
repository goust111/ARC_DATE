from __future__ import annotations

from collections import deque

import numpy as np


BG = 0
DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
OPPOSITE = {"up": "down", "down": "up", "left": "right", "right": "left"}


def _find_components(grid: np.ndarray, bg: int = BG) -> list[dict]:
    g = np.asarray(grid, dtype=int)
    h, w = map(int, g.shape)
    seen = np.zeros((h, w), dtype=bool)
    comps: list[dict] = []

    for r in range(h):
        for c in range(w):
            color = int(g[r, c])
            if color == bg or seen[r, c]:
                continue
            seen[r, c] = True
            q: deque[tuple[int, int]] = deque([(int(r), int(c))])
            coords: list[tuple[int, int]] = []
            while q:
                rr, cc = q.popleft()
                coords.append((int(rr), int(cc)))
                for dr, dc in DIRS4:
                    nr, nc = rr + dr, cc + dc
                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
                        seen[nr, nc] = True
                        q.append((int(nr), int(nc)))
            arr = np.array(coords, dtype=int)
            r0 = int(arr[:, 0].min())
            c0 = int(arr[:, 1].min())
            r1 = int(arr[:, 0].max())
            c1 = int(arr[:, 1].max())
            comps.append(
                {
                    "color": color,
                    "coords": arr,
                    "bbox": (r0, c0, r1, c1),
                    "area": int(arr.shape[0]),
                }
            )
    return comps


def _bbox_size(bbox: tuple[int, int, int, int]) -> tuple[int, int]:
    r0, c0, r1, c1 = bbox
    return int(r1 - r0 + 1), int(c1 - c0 + 1)


def _is_rect_ring(comp: dict) -> bool:
    r0, c0, r1, c1 = map(int, comp["bbox"])
    h, w = _bbox_size(comp["bbox"])
    if h < 3 or w < 3:
        return False
    if int(comp["area"]) != 2 * (h + w) - 4:
        return False

    mask = np.zeros((h, w), dtype=bool)
    coords = comp["coords"]
    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
    expected = np.zeros((h, w), dtype=bool)
    expected[0, :] = True
    expected[-1, :] = True
    expected[:, 0] = True
    expected[:, -1] = True
    return bool(np.array_equal(mask, expected))


def _is_solid_rect(comp: dict) -> bool:
    h, w = _bbox_size(comp["bbox"])
    if h < 1 or w < 1:
        return False
    return int(comp["area"]) == h * w


def _strictly_inside_frame(seed_bbox: tuple[int, int, int, int], frame_bbox: tuple[int, int, int, int]) -> bool:
    sr0, sc0, sr1, sc1 = map(int, seed_bbox)
    fr0, fc0, fr1, fc1 = map(int, frame_bbox)
    return (
        fr0 + 1 < sr0
        and sr1 < fr1 - 1
        and fc0 + 1 < sc0
        and sc1 < fc1 - 1
    )


def _bias_direction(frame_bbox: tuple[int, int, int, int], seed_bbox: tuple[int, int, int, int]) -> str:
    fr0, fc0, fr1, fc1 = map(int, frame_bbox)
    sr0, sc0, sr1, sc1 = map(int, seed_bbox)
    frame_cy = (fr0 + fr1) / 2.0
    frame_cx = (fc0 + fc1) / 2.0
    seed_cy = (sr0 + sr1) / 2.0
    seed_cx = (sc0 + sc1) / 2.0
    dy = seed_cy - frame_cy
    dx = seed_cx - frame_cx
    if abs(dy) > abs(dx):
        return "down" if dy > 0 else "up"
    return "right" if dx > 0 else "left"


def _external_ring_bbox(
    frame_bbox: tuple[int, int, int, int],
    ring_h: int,
    ring_w: int,
    side: str,
) -> tuple[int, int, int, int]:
    fr0, fc0, fr1, fc1 = map(int, frame_bbox)
    fh, fw = _bbox_size(frame_bbox)

    if side == "up":
        r0 = fr0 - ring_h - 1
        c0 = fc0 + (fw - ring_w) // 2
    elif side == "down":
        r0 = fr1 + 2
        c0 = fc0 + (fw - ring_w) // 2
    elif side == "left":
        r0 = fr0 + (fh - ring_h) // 2
        c0 = fc0 - ring_w - 1
    elif side == "right":
        r0 = fr0 + (fh - ring_h) // 2
        c0 = fc1 + 2
    else:
        raise ValueError(f"unknown side: {side}")

    return int(r0), int(c0), int(r0 + ring_h - 1), int(c0 + ring_w - 1)


def _draw_ring(grid: np.ndarray, bbox: tuple[int, int, int, int], color: int) -> None:
    r0, c0, r1, c1 = map(int, bbox)
    grid[r0, c0 : c1 + 1] = int(color)
    grid[r1, c0 : c1 + 1] = int(color)
    grid[r0 : r1 + 1, c0] = int(color)
    grid[r0 : r1 + 1, c1] = int(color)


def main(grid: np.ndarray) -> np.ndarray:
    """
