+def _non_touching_positions(candidates: list[tuple[int, int]], count: int) -> list[tuple[int, int]] | None:
+    for _ in range(80):
+        pool = candidates[:]
+        random.shuffle(pool)
+        chosen: list[tuple[int, int]] = []
+        for r, c in pool:
+            if all(max(abs(r - rr), abs(c - cc)) > 1 for rr, cc in chosen):
+                chosen.append((r, c))
+                if len(chosen) == count:
+                    return chosen
