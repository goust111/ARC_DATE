+def _sample_band_sizes(count: int) -> list[int] | None:
+    limit = MAX_GRID_SIZE - (count + 1)
+    for _ in range(100):
+        sizes = [random.randint(MIN_CELL_SIZE, MAX_CELL_SIZE) for _ in range(count)]
+        if sum(sizes) <= limit:
+            return sizes
+    return None
