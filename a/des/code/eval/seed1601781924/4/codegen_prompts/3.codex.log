+    margin = 1 if height >= 5 and width >= 5 else 0
+    cells = [(r, c) for r in range(margin, height - margin) for c in range(margin, width - margin)]
+    if len(cells) < 3:
+        return None
+
+    max_size = min(6, len(cells) - 1)
+    if max_size < 3:
+        return None
+
