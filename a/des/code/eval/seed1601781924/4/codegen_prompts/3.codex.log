+def _cell_spans(sizes: list[int]) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    pos = 1
+    for size in sizes:
+        spans.append((pos, pos + size - 1))
+        pos += size + 1
+    return spans
