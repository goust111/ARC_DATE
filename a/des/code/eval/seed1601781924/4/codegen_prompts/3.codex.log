+    try:
+        if np.array_equal(main(inp), out):
+            return inp
+    except AssertionError:
+        return None
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid palette-signal ARC input")

