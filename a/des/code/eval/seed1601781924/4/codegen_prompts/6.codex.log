+import random
+
+import numpy as np
+
+
+BG = 8
+COLOR_POOL = (0, 1, 2, 3, 4, 5, 6, 7, 9)
+MAX_GENERATION_ATTEMPTS = 300
+
+
+def _contiguous_runs(indices: np.ndarray) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    if indices.size == 0:
+        return runs
+    start = int(indices[0])
+    prev = start
+    for value in map(int, indices[1:]):
+        if value != prev + 1:
+            runs.append((start, prev))
+            start = value
+        prev = value
+    runs.append((start, prev))
+    return runs
+
+
