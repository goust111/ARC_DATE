    for sr0 in range(2, fence_h - seed_h - 1):
        for sc0 in range(2, fence_w - seed_w - 1):
            seed_cy = sr0 + (seed_h - 1) / 2.0
            seed_cx = sc0 + (seed_w - 1) / 2.0
