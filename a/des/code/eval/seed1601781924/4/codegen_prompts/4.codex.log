+    return {
+        "out": out,
+        "n_seeds": len(meta["seeds"]),
+        "n_arrows": len(meta["arrows"]),
+        "n_activated": sum(size > 0 for size in activated_sizes),
+        "n_conflicts": sum(size > 1 for size in activated_sizes),
+        "painted": int(np.sum((grid == BG) & (out != BG))),
