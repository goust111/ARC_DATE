ROW_GAP_RANGE = (1, 5)       # upper bound exclusive
COL_GAP_RANGE = (1, 5)       # upper bound exclusive
ROW_WIDTH_MIN = 18
ROW_WIDTH_MAX = 44
SEED_BIAS_DIRS = ("up", "down", "left", "right")


def _seed_position_candidates(
    fence_h: int,
    fence_w: int,
    seed_h: int,
    seed_w: int,
