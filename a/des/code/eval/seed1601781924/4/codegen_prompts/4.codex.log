+            arrow_id = arrow_at.get((int(r), int(c)))
+            if arrow_id is not None:
+                if seed_id not in activated_by[arrow_id]:
+                    activated_by[arrow_id].add(int(seed_id))
+                    arrow = arrows[arrow_id]
+                    queue.append(
+                        (
+                            int(seed_id),
+                            int(color),
+                            arrow["start"],
+                            tuple(arrow["dir"]),
+                        )
+                    )
+                break
+
+            if bool(solid[r, c]):
