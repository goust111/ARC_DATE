+def _build_single_chain(state: dict) -> dict | None:
+    chain_arrows = random.choice([2, 3, 4])
+    current = _try_place_random_arrow(state, margin=2)
+    if current is None:
+        return None
+
+    for _ in range(chain_arrows - 1):
