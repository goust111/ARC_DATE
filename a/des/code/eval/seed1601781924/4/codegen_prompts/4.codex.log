            elif bias == "left" and dx < 0 and abs(dx) > abs(dy):
                candidates.append((int(sr0), int(sc0)))
            elif bias == "right" and dx > 0 and abs(dx) > abs(dy):
                candidates.append((int(sr0), int(sc0)))
    return candidates


