+                    (
+                        t
+                        for t in (
+                            _diag_param(start, spec["dir"], other)
+                            for other in target_arrow["cells"]
+                        )
+                        if t is not None
+                    ),
+                    default=None,
+                )
+                if first_hit != steps:
+                    continue
