+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 8
+CONFLICT = 2
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+OBJECT_COLORS = [0, 1, 3, 4, 5, 6, 7, 9]
+
+# Interpret each 3-pixel arrow as a 2x2 L triomino whose ray exits through
+# the missing corner, along that corner's diagonal direction.
+ARROW_SPECS = (
+    {
+        "cells_rel": ((0, 1), (1, 0), (1, 1)),
+        "start_rel": (1, 1),
+        "dir": (-1, -1),
+    },
+    {
+        "cells_rel": ((0, 0), (1, 0), (1, 1)),
+        "start_rel": (1, 0),
+        "dir": (-1, 1),
+    },
+    {
+        "cells_rel": ((0, 0), (0, 1), (1, 1)),
+        "start_rel": (0, 1),
+        "dir": (1, -1),
+    },
+    {
+        "cells_rel": ((0, 0), (0, 1), (1, 0)),
+        "start_rel": (0, 0),
+        "dir": (1, 1),
+    },
+)
+
+GENERATE_RETRIES = 600
+GRID_H_RANGE = (12, 18)
+GRID_W_RANGE = (12, 18)
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in DIRS4:
+        yield r + dr, c + dc
+
+
+def _components_non_bg(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == BG or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(int(r), int(c))])
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(rr, cc):
+                    if (
+                        _in_bounds(g.shape, nr, nc)
+                        and not seen[nr, nc]
+                        and int(g[nr, nc]) == color
+                    ):
+                        seen[nr, nc] = True
+                        q.append((int(nr), int(nc)))
+
+            arr = np.array(coords, dtype=int)
+            r0 = int(arr[:, 0].min())
+            c0 = int(arr[:, 1].min())
+            r1 = int(arr[:, 0].max())
+            c1 = int(arr[:, 1].max())
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (r0, c0, r1, c1),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def _arrow_from_component(comp: dict) -> dict | None:
+    coords = comp["coords"]
+    if int(comp["area"]) != 3:
+        return None
+    r0, c0, r1, c1 = map(int, comp["bbox"])
+    if r1 - r0 != 1 or c1 - c0 != 1:
+        return None
+
+    rel = {(int(r - r0), int(c - c0)) for r, c in coords}
+    for spec in ARROW_SPECS:
+        if rel != set(spec["cells_rel"]):
+            continue
+        cells = tuple(
+            (int(r0 + rr), int(c0 + cc)) for rr, cc in spec["cells_rel"]
+        )
+        start = (int(r0 + spec["start_rel"][0]), int(c0 + spec["start_rel"][1]))
+        return {
+            "color": int(comp["color"]),
+            "cells": cells,
+            "start": start,
+            "dir": tuple(spec["dir"]),
+            "bbox": (r0, c0, r1, c1),
+        }
+    return None
+
+
+def _parse_objects(grid: np.ndarray) -> tuple[list[dict], list[dict]]:
+    seeds: list[dict] = []
+    arrows: list[dict] = []
+
+    for comp in _components_non_bg(grid):
+        if int(comp["area"]) == 1:
+            r, c = map(int, comp["coords"][0])
+            seeds.append({"cell": (r, c), "color": int(comp["color"])})
+            continue
+
+        arrow = _arrow_from_component(comp)
+        if arrow is None:
+            raise AssertionError("unexpected non-background object")
+        arrows.append(arrow)
+
+    seeds.sort(key=lambda seed: seed["cell"])
+    arrows.sort(key=lambda arrow: arrow["bbox"])
+    return seeds, arrows
+
+
+def _cardinal_param(
+    start: tuple[int, int], delta: tuple[int, int], cell: tuple[int, int]
+) -> int | None:
+    dr, dc = map(int, delta)
+    sr, sc = map(int, start)
+    cr, cc = map(int, cell)
+    if dr != 0:
+        if cc != sc:
+            return None
+        diff = cr - sr
+        if diff * dr <= 0:
+            return None
+        return int(diff * dr)
+    if cr != sr:
+        return None
+    diff = cc - sc
+    if diff * dc <= 0:
+        return None
+    return int(diff * dc)
+
+
+def _diag_param(
+    start: tuple[int, int], delta: tuple[int, int], cell: tuple[int, int]
+) -> int | None:
+    dr, dc = map(int, delta)
+    sr, sc = map(int, start)
+    cr, cc = map(int, cell)
+    row_steps = (cr - sr) * dr
+    col_steps = (cc - sc) * dc
+    if row_steps <= 0 or col_steps <= 0 or row_steps != col_steps:
+        return None
+    return int(row_steps)
+
+
+def _simulate(grid: np.ndarray) -> tuple[np.ndarray, dict]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    seeds, arrows = _parse_objects(g)
