+    h, w = out.shape
+    for r, c in repairs:
+        for dr, dc in DIRS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and int(out[nr, nc]) == BG:
+                out[nr, nc] = RED
