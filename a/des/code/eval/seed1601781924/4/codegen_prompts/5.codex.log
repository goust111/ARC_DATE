+
+
+def _free_neighbors(r: int, c: int, blocked: np.ndarray, chosen: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    h, w = blocked.shape
+    neighbors: list[tuple[int, int]] = []
+    for dr, dc in DIRS4:
