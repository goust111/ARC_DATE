+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+YELLOW = 4
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+PALETTE = (1, 3, 5, 6, 7, 8, 9)
