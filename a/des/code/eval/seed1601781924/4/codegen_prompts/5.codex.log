+    for r, c in cells:
+        blocked[r, c] = True
+        for dr, dc in DIRS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w:
+                blocked[nr, nc] = True
+
+
+def _candidate_defect_positions(half: np.ndarray) -> list[tuple[int, int]]:
