+        counts_top = _color_counts(top)
+        counts_bottom = _color_counts(bottom_aligned)
+        for r_raw, c_raw in np.argwhere(top != bottom_aligned):
+            r = int(r_raw)
+            c = int(c_raw)
+            side = _choose_defect_side(top, bottom_aligned, counts_top, counts_bottom, r, c)
+            if side == 0:
