+
+def _neighborhood_count(half: np.ndarray, r: int, c: int, color: int) -> int:
+    total = 0
+    h, w = half.shape
+    for nr in range(max(0, r - 1), min(h, r + 2)):
+        for nc in range(max(0, c - 1), min(w, c + 2)):
+            if nr == r and nc == c:
+                continue
+            if int(half[nr, nc]) == color:
+                total += 1
+    return total
