+            continue
+        return half
+    return None
+
+
+def _defect_groups(defect_count: int, base_color_count: int) -> list[int]:
+    if defect_count == 1:
+        return [1]
+    if defect_count == 2:
+        if base_color_count == 2 and random.random() < 0.5:
+            return [1, 1]
+        return [2]
