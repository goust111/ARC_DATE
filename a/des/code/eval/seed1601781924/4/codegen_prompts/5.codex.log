+
+
+def _reserve_with_margin(blocked: np.ndarray, cells: set[tuple[int, int]]) -> None:
+    h, w = blocked.shape
+    for r, c in cells:
+        blocked[r, c] = True
+        for dr, dc in DIRS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w:
