+
+def _color_counts(half: np.ndarray) -> Counter[int]:
+    counts: Counter[int] = Counter()
+    for value in half.ravel():
+        color = int(value)
+        if color not in (BG, YELLOW):
+            counts[color] += 1
+    return counts
