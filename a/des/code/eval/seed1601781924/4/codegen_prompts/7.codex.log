 315: _SPRITE_W_MAX = 6
 316: _SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw
 317: _SPRITE_CELL_MAX = 16
 318: _FILLED_SPRITE_MAX = 3
 319: 
 320: # Sprite mutation probabilities
 321: _P_HORIZ_WALL = 0.3           # add horizontal internal wall
 322: _P_VERT_WALL = 0.3            # add vertical internal wall
 323: _P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes
 324: _P_DIAMOND = 0.2              # use diamond shape for 3x3
 325: 
