+
+    max_patch_h = max(spec["input"].shape[0] for spec in specs)
+    max_patch_w = max(spec["input"].shape[1] for spec in specs)
+    total_area = sum(int(spec["input"].shape[0] * spec["input"].shape[1]) for spec in specs)
+
+    candidates = [
