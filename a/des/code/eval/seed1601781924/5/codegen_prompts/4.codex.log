+    raise RuntimeError(f"failed to build a {kind} mask")
+
+
+def _build_object(kind: str, color: int) -> dict:
+    mask = _generate_mask(kind)
+    pairs = _spot_pairs(mask, kind)
+    src, dst = random.choice(pairs)
+    if random.random() < 0.5:
+        src, dst = dst, src
