+    for ri, h in enumerate(heights):
+        col_start = 0
+        for ci, w in enumerate(widths):
+            rooms.append((row_start, col_start, row_start + h - 1, col_start + w - 1, ri, ci))
+            col_start += w + 1
+        row_start += h + 1
+
+    return grid, rooms, n_rows, n_cols
