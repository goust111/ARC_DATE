+    r0, c0, r1, c1 = comp["bbox"]
+    return cells.shape[0] == 4 and (r1 - r0 + 1) == 2 and (c1 - c0 + 1) == 2
+
+
+def _missing_region_for_l_shape(comp: dict) -> np.ndarray | None:
