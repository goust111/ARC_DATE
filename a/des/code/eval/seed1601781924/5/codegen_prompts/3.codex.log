+
+    anchored = (
+        (mr0 == 0 and mc0 == 0)
+        or (mr0 == 0 and mc1 == w - 1)
+        or (mr1 == h - 1 and mc0 == 0)
+        or (mr1 == h - 1 and mc1 == w - 1)
