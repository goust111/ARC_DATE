+    local[cells[:, 0] - r0, cells[:, 1] - c0] = True
+    missing = np.argwhere(~local)
+    if missing.size == 0:
+        return None
+
+    mr0 = int(missing[:, 0].min())
+    mc0 = int(missing[:, 1].min())
+    mr1 = int(missing[:, 0].max())
+    mc1 = int(missing[:, 1].max())
+    if missing.shape[0] != (mr1 - mr0 + 1) * (mc1 - mc0 + 1):
+        return None
