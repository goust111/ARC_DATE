    return k, counts[:]


def slots_for_region(h, w, need):
    choices = []
    for roff in (0,1):
        rows = list(range(roff, h, 2))
        for coff in (0,1):
            cols = list(range(coff, w, 2))
            slots = [(r,c) for r in rows for c in cols]
            if len(slots) >= need:
