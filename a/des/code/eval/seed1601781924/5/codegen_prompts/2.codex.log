    return out


def line_positions(lengths):
    pos = 0
    lines = [0]
    for length in lengths:
        pos += length + 1
        lines.append(pos)
    return lines


def templates_for(pattern):
    if pattern == 'unique':
        return {2: [[3,1],[4,1],[4,2]], 3: [[3,2,1],[4,2,1],[4,3,1]], 4: [[3,2,2,1],[4,2,1,1],[4,2,2,1]]}
    if pattern == 'max_tie':
        return {3: [[2,2,1],[3,3,1],[3,3,2]], 4: [[2,2,2,1],[3,3,2,1]]}
    if pattern == 'min_tie':
        return {3: [[3,1,1],[4,1,1],[4,2,2]], 4: [[3,2,1,1],[4,2,1,1],[4,3,1,1]]}
    return {4: [[2,2,1,1],[3,3,1,1],[3,3,2,2]]}


def choose_counts(pattern, capacity):
    opts = templates_for(pattern)
    valid = []
    for k, templates in opts.items():
        for counts in templates:
            if sum(counts) <= capacity:
                valid.append((k, counts))
    assert valid
