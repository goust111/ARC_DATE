+                if (rr, cc) == (int(r), int(c)):
+                    continue
+                if int(region[rr, cc]) != _BG:
+                    return False
+    return True
+
+
+def _validate_generated(grid: np.ndarray) -> bool:
+    bg = _most_common_color(grid)
+    if bg != _BG:
+        return False
+
+    separator, row_lines, col_lines = _separator_info(grid, bg)
