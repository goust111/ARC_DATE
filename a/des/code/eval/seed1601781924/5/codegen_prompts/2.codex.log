        out = main(g)
        # sanity: every region no bg remains in output interior
        for r0, r1 in row_spans:
            for c0, c1 in col_spans:
                if np.any(out[r0:r1+1, c0:c1+1] == BG):
                    ok = False
                    break
            if not ok:
                break
        if ok:
            return g
    raise RuntimeError('failed')

sigs = set()
for i in range(100):
    inp = generate_input()
    out = main(inp)
    sigs.add((inp.shape, inp.tobytes()))
print('variants', len(sigs))
print('sample shape', inp.shape, 'colors', np.unique(inp))
