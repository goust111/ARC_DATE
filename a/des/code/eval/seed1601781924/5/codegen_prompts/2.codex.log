PATTERNS = ('unique','max_tie','min_tie','both_tie')


def detect_bg(g):
    vals, cnts = np.unique(g, return_counts=True)
    return int(vals[cnts.argmax()])


def detect_sep(g, bg):
    best = None
    for color in map(int, np.unique(g)):
        if color == bg:
            continue
        rows = np.all(g == color, axis=1)
        cols = np.all(g == color, axis=0)
        score = (int(rows.sum() + cols.sum()), int(rows.sum()), int(cols.sum()), int((g == color).sum()))
        if score[0] == 0:
            continue
        if best is None or score > best[0]:
