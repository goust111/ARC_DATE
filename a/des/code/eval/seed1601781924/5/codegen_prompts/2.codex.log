+            boxes.append(
+                (
+                    int(row_lines[i] + 1),
+                    int(row_lines[i + 1] - 1),
+                    int(col_lines[j] + 1),
+                    int(col_lines[j + 1] - 1),
+                )
+            )
+    return boxes
+
+
+def _is_sparse_region(region: np.ndarray) -> bool:
+    h, w = region.shape
+    colored = np.argwhere(region != _BG)
+    for r, c in colored:
+        for rr in range(max(0, int(r) - 1), min(h, int(r) + 2)):
