def build_counts_pattern_list(region_count):
    pool = list(PATTERNS)
    random.shuffle(pool)
    patterns = []
    while len(patterns) < region_count:
        patterns.extend(pool)
        random.shuffle(pool)
    random.shuffle(patterns)
    return patterns[:region_count]


def generate_input():
    for _ in range(500):
        nrows, ncols = random.choice(LAYOUTS)
        heights = [random.randint(5,8) for _ in range(nrows)]
        widths = [random.randint(5,8) for _ in range(ncols)]
        H = sum(heights) + nrows + 1
