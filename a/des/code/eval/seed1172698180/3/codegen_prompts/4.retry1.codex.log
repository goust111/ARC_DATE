+        if any(delta not in (-1, 0, 1) for delta in pattern) or all(delta == 0 for delta in pattern):
+            return None
+        core_top = 0
+    else:
+        assert side == "top"
+        if len(set(bottoms)) != 1 or bottoms[0] != h - 1:
+            return None
+        core_top = _mode(tops)
+        pattern = tuple(core_top - top for top in tops)
+        if any(delta not in (-1, 0, 1) for delta in pattern) or all(delta == 0 for delta in pattern):
+            return None
+    try:
