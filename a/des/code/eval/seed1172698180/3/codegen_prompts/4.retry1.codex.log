+    tops: list[int] = []
+    bottoms: list[int] = []
+    heights: list[int] = []
+    for c in range(w):
+        rows = np.flatnonzero(mask[:, c])
+        if rows.size == 0 or int(rows[-1]) - int(rows[0]) + 1 != int(rows.size):
