+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+MAGENTA = 6
+ORANGE = 7
+AZURE = 8
+MAROON = 9
+
+OUTPUT_COLOR_BY_MARKERS = {
+    1: RED,
+    2: GREEN,
+    3: YELLOW,
+    4: BLUE,
+    5: MAGENTA,
+    6: AZURE,
+}
+
+PIECE_COLORS = [BLUE, RED, GREEN, YELLOW, GRAY, MAGENTA, AZURE, MAROON]
+SIDES = ("left", "right", "top", "bottom")
+OPPOSITE = {"left": "right", "right": "left", "top": "bottom", "bottom": "top"}
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _mode(values: list[int]) -> int:
+    return Counter(values).most_common(1)[0][0]
+
+
+def _component_coords(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _piece_cells(base_h: int, base_w: int, side: str, pattern: tuple[int, ...]) -> set[tuple[int, int]]:
+    cells = {(r, c) for r in range(base_h) for c in range(base_w)}
+    if side == "right":
+        for r, delta in enumerate(pattern):
+            if delta == -1:
+                cells.remove((r, base_w - 1))
+            elif delta == 1:
+                cells.add((r, base_w))
+    elif side == "left":
+        for r, delta in enumerate(pattern):
+            if delta == -1:
+                cells.remove((r, 0))
+            elif delta == 1:
+                cells.add((r, -1))
+    elif side == "bottom":
+        for c, delta in enumerate(pattern):
+            if delta == -1:
+                cells.remove((base_h - 1, c))
+            elif delta == 1:
+                cells.add((base_h, c))
+    else:
+        assert side == "top"
+        for c, delta in enumerate(pattern):
+            if delta == -1:
+                cells.remove((0, c))
+            elif delta == 1:
+                cells.add((-1, c))
+    return cells
+
+
+def _mask_from_piece(base_h: int, base_w: int, side: str, pattern: tuple[int, ...], core_top: int, core_left: int, out_h: int, out_w: int) -> np.ndarray:
+    mask = np.zeros((out_h, out_w), dtype=bool)
+    for r, c in _piece_cells(base_h, base_w, side, pattern):
+        rr = core_top + r
+        cc = core_left + c
