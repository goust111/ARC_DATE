+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+MAGENTA = 6
+ORANGE = 7
+AZURE = 8
+MAROON = 9
+
+OUTPUT_COLOR_BY_MARKERS = {
+    1: RED,
+    2: GREEN,
+    3: YELLOW,
+    4: BLUE,
+    5: MAGENTA,
+    6: AZURE,
+}
+
+PIECE_COLORS = [BLUE, RED, GREEN, YELLOW, GRAY, MAGENTA, AZURE, MAROON]
