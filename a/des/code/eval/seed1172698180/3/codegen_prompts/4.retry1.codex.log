+            elif delta == 1:
+                cells.add((base_h, c))
+    else:
+        assert side == "top"
+        for c, delta in enumerate(pattern):
+            if delta == -1:
+                cells.remove((0, c))
+            elif delta == 1:
+                cells.add((-1, c))
