+        rel_r0, rel_c0, rel_r1, rel_c1 = mover["bbox_rel"]
+        row_lo = -rel_r0
+        row_hi = h - 1 - rel_r1
+        col_lo = -rel_c0
+        col_hi = w - 1 - rel_c1
+        if row_lo > row_hi or col_lo > col_hi:
+            return False
