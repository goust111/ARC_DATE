+                        stack.append((nr, nc))
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _is_hollow_frame(grid: np.ndarray, comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    color = int(comp["color"])
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    if int(comp["area"]) != 2 * h + 2 * w - 4:
+        return False
+    for r, c in comp["coords"]:
+        if r not in (r0, r1) and c not in (c0, c1):
+            return False
+    if not np.all(grid[r0, c0 : c1 + 1] == color):
+        return False
+    if not np.all(grid[r1, c0 : c1 + 1] == color):
+        return False
+    if not np.all(grid[r0 : r1 + 1, c0] == color):
+        return False
+    if not np.all(grid[r0 : r1 + 1, c1] == color):
+        return False
+    return True
