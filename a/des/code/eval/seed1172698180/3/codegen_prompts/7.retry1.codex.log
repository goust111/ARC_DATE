ODD_COUNT_RANGE, EVEN_COUNT_RANGE, TOTAL_SQUARE_RANGE = (2, 8), (1, 4), (5, 11)
ODD_SIDE_CHOICES, EVEN_SIDE_CHOICES = (1, 3, 5, 7), (2, 4, 6)

