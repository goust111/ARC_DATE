+    boxes = [(0, 0, leaf_h, leaf_w)]
+    cur_h, cur_w = leaf_h, leaf_w
+    gap_hi = 2 if depth <= 2 else 1
+
+    for _ in range(depth - 1):
+        mt = random.randint(1, gap_hi)
+        mb = random.randint(1, gap_hi)
+        ml = random.randint(1, gap_hi)
