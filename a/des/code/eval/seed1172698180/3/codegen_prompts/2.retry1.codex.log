+def _bfs_dist(grey_mask: np.ndarray, starts: tuple[tuple[int, int], ...]) -> np.ndarray:
+    h, w = grey_mask.shape
+    inf = h * w + 1
+    dist = np.full((h, w), inf, dtype=int)
+    q: deque[tuple[int, int]] = deque()
+    for r, c in starts:
+        if bool(grey_mask[r, c]) and int(dist[r, c]) > 0:
+            dist[r, c] = 0
+            q.append((int(r), int(c)))
