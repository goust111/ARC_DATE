+        r, c = q.popleft()
+        nd = int(dist[r, c] + 1)
+        for nr, nc in _neighbors4(r, c, h, w):
+            if bool(grey_mask[nr, nc]) and int(dist[nr, nc]) > nd:
+                dist[nr, nc] = nd
+                q.append((nr, nc))
+    return dist
