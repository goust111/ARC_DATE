+    nodes_owner: dict[tuple[int, int], str] = case["nodes_owner"]
+    grey_edges: list[tuple[tuple[int, int], tuple[int, int]]] = case["grey_edges"]
+    valve_edges: list[tuple[tuple[int, int], tuple[int, int]]] = case["valve_edges"]
