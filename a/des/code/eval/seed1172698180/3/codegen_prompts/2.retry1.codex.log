+        br, bc = node_pixels[b]
+        mr = int((ar + br) // 2)
+        mc = int((ac + bc) // 2)
+        assert int(grid[mr, mc]) == BLACK
+        grid[mr, mc] = GREY
+        component_cells[owner_a].add((mr, mc))
