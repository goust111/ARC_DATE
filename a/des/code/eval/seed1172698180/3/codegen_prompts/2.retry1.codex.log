+
+
+def _render_case(case: dict[str, object]) -> tuple[np.ndarray, dict[str, set[tuple[int, int]]], set[tuple[int, int]]]:
+    lattice_h, lattice_w = case["lattice_shape"]
+    h = int(2 * lattice_h + 5)
+    w = int(2 * lattice_w + 5)
+    grid = np.full((h, w), BLACK, dtype=int)
