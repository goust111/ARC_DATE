+GREEN = 3
+GREY = 5
+MAGENTA = 6
+SOURCE_PALETTE = (1, 2, 4, 7, 8, 9)
+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+DIR_BY_NAME = {
