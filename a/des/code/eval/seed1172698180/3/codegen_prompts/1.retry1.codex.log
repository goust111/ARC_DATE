+    for k in range(4):
+        rot = np.rot90(base, k)
+        variants.append(rot)
+        variants.append(np.fliplr(rot))
+    return variants
+
+
+def _canonical_mask_key(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    variants = _dihedral_variants(mask)
+    return min((tuple(map(int, v.shape)), v.tobytes()) for v in variants)
+
