+def _random_template_masks(count: int) -> list[np.ndarray]:
+    choices = random.sample(range(len(TEMPLATE_MASK_LIBRARY)), count)
+    return [TEMPLATE_MASK_LIBRARY[idx].copy() for idx in choices]
+
