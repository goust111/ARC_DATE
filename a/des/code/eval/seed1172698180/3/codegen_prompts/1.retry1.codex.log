+def _free_positions(occupied: np.ndarray, h: int, w: int, pad: int = OBJECT_PADDING) -> list[tuple[int, int]]:
+    H, W = occupied.shape
+    positions: list[tuple[int, int]] = []
+    for r in range(1, H - h):
+        for c in range(1, W - w):
+            rr0 = max(0, r - pad)
+            cc0 = max(0, c - pad)
+            rr1 = min(H, r + h + pad)
+            cc1 = min(W, c + w + pad)
+            if not occupied[rr0:rr1, cc0:cc1].any():
