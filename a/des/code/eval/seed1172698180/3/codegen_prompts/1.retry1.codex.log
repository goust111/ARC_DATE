+    H, W = occupied.shape
+    rr0 = max(0, r - pad)
+    cc0 = max(0, c - pad)
+    rr1 = min(H, r + h + pad)
+    cc1 = min(W, c + w + pad)
+    occupied[rr0:rr1, cc0:cc1] = True
