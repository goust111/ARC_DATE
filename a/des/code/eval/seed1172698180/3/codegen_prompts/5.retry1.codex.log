+        if hidden_a and visible_b and not hidden_b:
+            hidden_label = next(iter(hidden_a))
+            hidden_side = "negative"
+        elif hidden_b and visible_a and not hidden_a:
+            hidden_label = next(iter(hidden_b))
+            hidden_side = "positive"
