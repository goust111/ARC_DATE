+def _partition(total: int, parts: int, min_size: int) -> list[int]:
+    sizes = [min_size] * parts
+    extra = total - min_size * parts
+    for _ in range(extra):
+        sizes[random.randrange(parts)] += 1
+    random.shuffle(sizes)
+    return sizes
