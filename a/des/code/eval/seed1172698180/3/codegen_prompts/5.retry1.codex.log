+def _transform_shape(mask: np.ndarray) -> np.ndarray:
+    out = np.array(mask, copy=True)
+    out = np.rot90(out, random.randrange(4))
+    if random.random() < 0.5:
+        out = np.fliplr(out)
+    return out
+
