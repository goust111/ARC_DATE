+def _interior_ranges(start: int, sizes: list[int]) -> tuple[list[tuple[int, int]], list[int]]:
+    rooms: list[tuple[int, int]] = []
+    walls: list[int] = []
+    pos = start + 1
+    for i, size in enumerate(sizes):
+        rooms.append((pos, pos + size - 1))
+        pos += size
+        if i + 1 < len(sizes):
+            walls.append(pos)
+            pos += 1
+    return rooms, walls
