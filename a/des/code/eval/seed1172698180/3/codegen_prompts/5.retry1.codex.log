+            if not mask[r, c]:
+                continue
+            for rr in range(max(0, r - 1), min(h, r + 2)):
+                for cc in range(max(0, c - 1), min(w, c + 2)):
+                    out[rr, cc] = True
+    return out
+
+
+def _place_key(grid: np.ndarray, shape: np.ndarray, color: int, forbidden: np.ndarray) -> bool:
+    h, w = grid.shape
+    ph, pw = shape.shape
