+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            out.append((rr, cc))
+    return out
+
+
+def _most_common_color(g: np.ndarray) -> int:
+    values, counts = np.unique(g, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _component_infos(mask: np.ndarray) -> list[dict]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            r0 = int(arr[:, 0].min())
+            c0 = int(arr[:, 1].min())
+            r1 = int(arr[:, 0].max())
+            c1 = int(arr[:, 1].max())
+            patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            patch[arr[:, 0] - r0, arr[:, 1] - c0] = True
+            comps.append(
+                {
+                    "coords": arr,
+                    "bbox": (r0, c0, r1, c1),
+                    "area": int(arr.shape[0]),
+                    "mask": patch,
+                }
+            )
+    return comps
+
+
+def _flood_from_boundary(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    queue: deque[tuple[int, int]] = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if mask[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                queue.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if mask[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                queue.append((r, c))
+
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(r, c, h, w):
+            if mask[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                queue.append((nr, nc))
+    return seen
+
+
+def _label_components(mask: np.ndarray) -> tuple[np.ndarray, dict[int, tuple[int, int, int, int]]]:
+    h, w = mask.shape
+    labels = np.zeros((h, w), dtype=int)
+    bboxes: dict[int, tuple[int, int, int, int]] = {}
+    next_label = 1
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] != 0:
+                continue
+            queue = deque([(r, c)])
+            labels[r, c] = next_label
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if mask[nr, nc] and labels[nr, nc] == 0:
+                        labels[nr, nc] = next_label
+                        queue.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            bboxes[next_label] = (
+                int(arr[:, 0].min()),
+                int(arr[:, 1].min()),
+                int(arr[:, 0].max()),
+                int(arr[:, 1].max()),
+            )
+            next_label += 1
+    return labels, bboxes
