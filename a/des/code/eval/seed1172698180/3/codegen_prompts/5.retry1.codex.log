+            return None
+        if not _place_key(grid, shape, color, forbidden):
+            return None
+
+    if np.array_equal(main(grid), grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _make_attempt()
+        if grid is not None:
+            return grid
