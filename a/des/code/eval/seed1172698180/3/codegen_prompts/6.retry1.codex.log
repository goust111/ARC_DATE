+        top_rows = [outlet_row - h for h in inner_heights]
+
+        left_walls: list[int] = []
+        x = 0
+        for i, inner_width in enumerate(inner_widths):
+            left_walls.append(x)
+            x += inner_width + 2
+            if i < n_containers - 1:
