+def _color_component(grid: np.ndarray, start: tuple[int, int]) -> set[tuple[int, int]]:
+    color = int(grid[start])
+    h, w = grid.shape
+    stack = [start]
+    seen = {start}
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and int(grid[nr, nc]) == color and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return seen
