+        grid[pool_top : pool_bottom + 1, pool_right] = GREY
+        grid[pool_bottom, pool_left : pool_right + 1] = GREY
+        grid[pool_top, pool_left : pool_right + 1] = GREY
+        for entry_col in entry_cols:
+            grid[pool_top, entry_col] = BG
