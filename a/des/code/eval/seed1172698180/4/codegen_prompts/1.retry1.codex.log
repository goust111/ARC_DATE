+BG = 0
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # up, right, down, left
+SIDE_TO_OPPOSITE_DIR = {"top": 2, "right": 3, "bottom": 0, "left": 1}
+CW_GAP_SIDES = {"top", "right"}
+
+# Generator palette / bounds.
+WALL = 5
+SEED_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+SIDES = ["top", "right", "bottom", "left"]
+GRID_SIDE_RANGE = (18, 31)
+INNER_SIDE_RANGE = (5, 10)
+REGION_PAD = 1
+MAX_REGIONS = 4
+MAX_ATTEMPTS = 400
+
+
+@dataclass(frozen=True)
+class Region:
+    bbox: tuple[int, int, int, int]  # r0, c0, r1, c1 inclusive border bbox
+    gap: tuple[int, int]
+    gap_side: str
+    seed: tuple[int, int]
+    color: int
+
+
+def _components4(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for dr, dc in DIRS:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _perimeter_cells(bbox: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    cells = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _gap_side_from_cell(gap: tuple[int, int], bbox: tuple[int, int, int, int]) -> str:
+    r0, c0, r1, c1 = bbox
+    gr, gc = gap
+    if gr == r0 and c0 < gc < c1:
+        return "top"
+    if gc == c1 and r0 < gr < r1:
+        return "right"
+    if gr == r1 and c0 < gc < c1:
+        return "bottom"
+    if gc == c0 and r0 < gr < r1:
+        return "left"
+    raise AssertionError("gap must lie on exactly one non-corner border cell")
