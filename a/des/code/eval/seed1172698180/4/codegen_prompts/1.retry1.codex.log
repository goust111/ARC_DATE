+                "inner_w": inner_w,
+                "bbox_h": bbox_h,
+                "bbox_w": bbox_w,
+                "gap_side": gap_side,
+                "seed_side": seed_side,
+            }
+        )
+
+    specs.sort(key=lambda spec: spec["bbox_h"] * spec["bbox_w"], reverse=True)
+
+    grid = np.full((h, w), BG, dtype=int)
