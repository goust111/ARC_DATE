+    r0, c0, r1, c1 = bbox
+    sr, sc = seed
+    return {
+        "top": sr - (r0 + 1),
+        "right": (c1 - 1) - sc,
+        "bottom": (r1 - 1) - sr,
+        "left": sc - (c0 + 1),
+    }
+
