  98:     ) -> list[tuple[np.ndarray, np.ndarray]]:
  99:         base = []
 100:         for kk in range(4):
 101:             p = np.rot90(patch, int(kk))
 102:             m = np.rot90(mask, int(kk))
 103:             base.append((p, m))
 104:             base.append((np.fliplr(p), np.fliplr(m)))
