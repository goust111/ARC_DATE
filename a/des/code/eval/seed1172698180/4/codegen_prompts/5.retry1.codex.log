+    canvas[node_r, node_c] = marker
+
+    if present["N"]:
+        canvas[node_r - len_n : node_r, node_c] = GREY
+    if present["S"]:
+        canvas[node_r + 1 : node_r + len_s + 1, node_c] = GREY
+    if present["E"]:
+        canvas[node_r, node_c + 1 : node_c + len_e + 1] = GREY
