+    for _ in range(g.size * 4 + 10):
+        if not active:
+            break
+
+        intents = []
+        for signal in active:
+            pos = signal["pos"]
+            container = container_by_leaf.get(pos)
+            if container is not None:
+                for r, c in container["interior"]:
