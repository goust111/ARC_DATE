+    return poles
+
+
+def _find_components(g: np.ndarray, forbidden: set[Cell]) -> list[dict[str, object]]:
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict[str, object]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or (r, c) in forbidden:
+                continue
+            color = int(g[r, c])
+            if color in {BG, YELLOW}:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[Cell] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
