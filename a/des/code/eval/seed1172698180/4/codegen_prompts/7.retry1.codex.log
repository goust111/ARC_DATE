+        for _ in range(int(rng.integers(0, 4))):
+            shape = _rotate(shape)
+        if rng.random() < 0.5:
+            shape = _flip_h(shape)
+        if rng.random() < 0.5:
+            shape = _flip_v(shape)
+        return _normalize(shape)
