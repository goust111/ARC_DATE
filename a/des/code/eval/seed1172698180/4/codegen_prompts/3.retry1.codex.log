+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _build_sample(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate a valid sample after {GEN_RETRIES} attempts")

