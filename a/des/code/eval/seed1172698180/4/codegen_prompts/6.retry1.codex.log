+    mc = int(rng.choice(col_margin_choices))
+    ph = int(h - 2 - 2 * mr)
+    pw = int(w - 2 - 2 * mc)
+
+    side_h, side_w = _side_dims(ph, pw, axis)
+    if side_h < 3 or side_w < 3:
