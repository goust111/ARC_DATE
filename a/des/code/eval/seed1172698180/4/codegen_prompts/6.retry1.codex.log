            if np.array_equal(pattern, pattern[:, ::-1]):
                continue

        if len(np.unique(pattern)) < 3:
            continue
        return pattern

    return None


def _side_dims(ph: int, pw: int, axis: str) -> tuple[int, int]:
    if axis == "vertical":
