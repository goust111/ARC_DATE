+
+    out = _paint_border(clean, min(target_area, max_thickness))
+    if not np.array_equal(main(inp), out):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GENERATION_RETRIES):
