+    max_thickness = (min(h, w) + 1) // 2
+    decomps = _area_decompositions(side_h, side_w)
+    sums = sorted(decomps)
+    if capped:
+        candidates = [s for s in sums if max_thickness < s <= max_thickness + 8]
