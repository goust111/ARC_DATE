+
+        steps = list(range(1, max_step + 1))
+        random.shuffle(steps)
+        for step in steps:
+            final_cols = list(range(total_cols - width + 1))
+            random.shuffle(final_cols)
+            candidates: list[dict[str, object]] = []
+            for final_col0 in final_cols:
+                spec = _build_spec(
+                    side,
