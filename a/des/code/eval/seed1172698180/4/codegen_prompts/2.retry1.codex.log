+    for other in placed:
+        if _boxes_intersect(candidate["orig_bbox"], other["orig_bbox"], gap=1):
+            return False
+        if _boxes_intersect(candidate["orig_bbox"], other["final_bbox"]):
+            return False
+        if _boxes_intersect(candidate["final_bbox"], other["orig_bbox"]):
+            return False
