+}
+
+ARROW_PATTERNS = {
+    "up": frozenset({(1, 0), (1, 1), (1, 2), (0, 1)}),
+    "down": frozenset({(0, 0), (0, 1), (0, 2), (1, 1)}),
+    "left": frozenset({(0, 1), (1, 1), (2, 1), (1, 0)}),
+    "right": frozenset({(0, 0), (1, 0), (2, 0), (1, 1)}),
+}
