+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        candidate = _gen_attempt(rng)
+        if candidate is not None:
+            return candidate
+    raise RuntimeError("failed to generate a valid puzzle instance")

