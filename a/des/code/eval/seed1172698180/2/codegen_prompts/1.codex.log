+
+def _frame_arrow_cells(grid: np.ndarray, frame: dict, bg: int) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = frame["bbox"]
+    cells: list[tuple[int, int]] = []
+    for r in range(r0 + 1, r1):
+        for c in range(c0 + 1, c1):
+            if int(grid[r, c]) != bg:
+                cells.append((r, c))
