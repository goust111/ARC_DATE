+    diff_mask = out != grid
+    if int(diff_mask.sum()) != 4 * sum(1 for spec, _color in placed_specs if spec["matched"]):
+        return None
+    if not all(int(out[r, c]) in frame_colors for r, c in np.argwhere(diff_mask)):
+        return None
+    return grid
