+            while queue:
+                cr, cc = queue.popleft()
+                comp.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == value:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
