+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors8(r: int, c: int) -> list[Coord]:
+    return [
+        (r + dr, c + dc)
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+        if dr or dc
+    ]
+
+
+def _connected_components(mask: np.ndarray) -> list[list[Coord]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[Coord]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[Coord] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((int(cr), int(cc)))
+                for nr, nc in _neighbors8(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _portal_pairs(grid: np.ndarray, bg: int) -> dict[int, tuple[Coord, Coord]]:
+    h, w = grid.shape
+    out: dict[int, tuple[Coord, Coord]] = {}
+    for color in sorted(set(map(int, np.unique(grid))) - {int(bg)}):
+        coords = [tuple(map(int, rc)) for rc in np.argwhere(grid == color)]
+        if len(coords) != 2:
+            continue
+        (r0, c0), (r1, c1) = coords
+        if r0 != r1 and c0 != c1:
+            continue
+        isolated = True
+        for r, c in coords:
+            for nr, nc in _neighbors8(r, c):
+                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in coords and int(grid[nr, nc]) != bg:
+                    isolated = False
+                    break
+            if not isolated:
+                break
+        if isolated:
+            out[color] = tuple(sorted(coords))
+    assert out, "expected at least one portal pair"
+    return out
+
+
+def _object_components(grid: np.ndarray, bg: int, portals: dict[int, tuple[Coord, Coord]]) -> list[dict]:
+    portal_cells = {pt for pair in portals.values() for pt in pair}
+    mask = (grid != int(bg)).copy()
+    for r, c in portal_cells:
+        mask[r, c] = False
+    comps = _connected_components(mask)
+    objects = []
+    for comp in comps:
+        coords = sorted(comp)
+        objects.append(
+            {
+                "coords": coords,
+                "coord_set": set(coords),
+                "size": len(coords),
+            }
+        )
+    return objects
+
+
+def _teleport_copy(
+    coords: list[Coord],
+    source_anchor: Coord,
+    target_anchor: Coord,
+    orientation: str,
+) -> list[Coord]:
+    sr, sc = source_anchor
+    tr, tc = target_anchor
+    out: list[Coord] = []
+    if orientation == "horizontal":
+        for r, c in coords:
+            out.append((tr - (r - sr), tc + (c - sc)))
+    else:
+        assert orientation == "vertical"
+        for r, c in coords:
+            out.append((tr + (r - sr), tc - (c - sc)))
+    return out
