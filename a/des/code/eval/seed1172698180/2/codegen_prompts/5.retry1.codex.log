def _path_cells(start: Coord, stop: Coord, first_axis: str) -> list[Coord]:
    r0, c0 = start
    r1, c1 = stop
    pts: list[Coord] = []

    if first_axis == "h":
        c_step = 1 if c1 >= c0 else -1
        for c in range(c0, c1 + c_step, c_step):
            pts.append((r0, c))
        r_step = 1 if r1 >= r0 else -1
