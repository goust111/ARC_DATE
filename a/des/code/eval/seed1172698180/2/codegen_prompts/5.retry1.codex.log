+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+
+
+BG = 0
+OBJECT_COLORS = (1, 2, 3, 4, 5, 6)
+PORTAL_COLORS = (7, 8, 9)
+ORIENTATIONS = ("horizontal", "vertical")
+
+GRID_MIN = 14
+GRID_MAX = 18
+OBJECT_SIZE_RANGE = (3, 8)
+MAX_GENERATION_ATTEMPTS = 400
+SHAPE_ATTEMPTS = 80
+PLACEMENT_ATTEMPTS = 120
+PORTAL_OPTION_LIMIT = 48
