+    out = g.copy()
+    for portal_color, endpoints in portals.items():
+        (r0, c0), (r1, c1) = endpoints
+        if r0 == r1:
+            orientation = "horizontal"
+            line_row = r0
+            lo, hi = sorted((c0, c1))
+            for obj in objects:
+                on_line = [(r, c) for r, c in obj["coords"] if r == line_row and lo <= c <= hi]
+                if not on_line:
