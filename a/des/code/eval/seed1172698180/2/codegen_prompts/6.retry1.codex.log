+from __future__ import annotations
+
+import numpy as np
+
+
+_RNG = np.random.default_rng()
+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_GREY = 5
+_BG = 0
+_STAMP_COLORS = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)
+_MAX_RETRIES = 400
