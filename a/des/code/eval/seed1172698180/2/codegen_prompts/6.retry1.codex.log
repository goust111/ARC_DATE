+    center = (k // 2, k // 2)
+    edge_targets = [
+        (0, int(_RNG.integers(0, k))),
+        (k - 1, int(_RNG.integers(0, k))),
+        (int(_RNG.integers(0, k)), 0),
+        (int(_RNG.integers(0, k)), k - 1),
+    ]
+    mask = np.zeros((k, k), dtype=bool)
