+            r += 1 if tr > r else -1
+        while c != tc:
+            mask[r, c] = True
+            c += 1 if tc > c else -1
+    else:
+        while c != tc:
+            mask[r, c] = True
+            c += 1 if tc > c else -1
+        while r != tr:
+            mask[r, c] = True
+            r += 1 if tr > r else -1
