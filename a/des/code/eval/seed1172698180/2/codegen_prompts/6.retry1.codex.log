+    assert stamp_up.shape == stamp_right.shape == stamp_left.shape == stamp_down.shape
+    assert stamp_up.shape[0] == stamp_up.shape[1]
+    assert np.array_equal(np.rot90(stamp_up, 3), stamp_right)
