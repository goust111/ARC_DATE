+def _new_cells_valid(
+    new_cells: list[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+    h: int,
+    w: int,
+) -> bool:
+    seen = set(new_cells)
+    for i, cell in enumerate(new_cells):
+        r, c = cell
