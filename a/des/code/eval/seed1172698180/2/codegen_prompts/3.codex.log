+def _bbox_from_cells(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in cells]
+    cols = [c for _r, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
