+    order = random.sample(range(len(specs)), len(specs))
+    if side == "bottom":
+        if span > w:
+            return False
+        start = random.randint(0, w - span)
+        r0 = h - 3
+        for i, idx in enumerate(order):
+            c0 = start + i * (3 + gap)
+            block = specs[idx]["legend"]
+            grid[r0 : r0 + 3, c0 : c0 + 3] = block
+    else:
+        if span > h:
+            return False
+        start = random.randint(0, h - span)
+        c0 = w - 3
+        for i, idx in enumerate(order):
+            r0 = start + i * (3 + gap)
+            block = specs[idx]["legend"]
+            grid[r0 : r0 + 3, c0 : c0 + 3] = block
