+        seq = _legend_sequence(spec["legend"])
+        for i, (r, c) in enumerate(path[idx:] + path[:idx]):
+            out[r, c] = seq[i % len(seq)]
+        sr, sc = spec["seed"]
+        out[sr, sc] = bg
+    return out
