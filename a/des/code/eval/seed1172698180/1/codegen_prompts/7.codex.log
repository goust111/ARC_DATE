+    seen = {root}
+    q = deque([root])
+    while q:
+        node = q.popleft()
+        order.append(node)
+        nbrs = list(graph[node] - seen)
+        RNG.shuffle(nbrs)
+        for nbr in nbrs:
+            seen.add(nbr)
+            q.append(nbr)
