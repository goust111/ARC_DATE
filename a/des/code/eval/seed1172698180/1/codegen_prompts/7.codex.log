+            if not candidates:
+                break
+            idx, opts = candidates[int(RNG.integers(len(candidates)))]
+            r0, c0, h, w = rects.pop(idx)
+            orient = opts[int(RNG.integers(len(opts)))]
+            if orient == "h":
