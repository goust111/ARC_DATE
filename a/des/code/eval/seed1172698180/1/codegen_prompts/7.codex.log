+        (r, c)
+        for r, c in union
+        if any((r + dr, c + dc) not in union for dr, dc in DIRS)
+    ]
+
+    candidate_map: dict[tuple[int, int], tuple[int, int]] = {}
+    for ur, uc in union_boundary:
+        for dr, dc in DIRS:
+            ar, ac = ur + dr, uc + dc
+            for pr, pc in boundary:
+                origin = (ar - pr, ac - pc)
+                if origin in candidate_map:
+                    continue
