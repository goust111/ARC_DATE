+
+def _state_key(origins: list[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    min_r = min(r for r, _ in origins)
+    min_c = min(c for _, c in origins)
+    return tuple((r - min_r, c - min_c) for r, c in origins)
