+            r1b, c1b = r0b + hb, c0b + wb
+
+            if c1a == c0b:
+                start = max(r0a, r0b)
+                end = min(r1a, r1b)
+                if end - start >= 3:
+                    out.append({"kind": 0, "left": i, "right": j, "split": c0b, "start": start, "end": end})
+            if c1b == c0a:
+                start = max(r0a, r0b)
+                end = min(r1a, r1b)
+                if end - start >= 3:
+                    out.append({"kind": 0, "left": j, "right": i, "split": c0a, "start": start, "end": end})
+            if r1a == r0b:
+                start = max(c0a, c0b)
+                end = min(c1a, c1b)
+                if end - start >= 3:
+                    out.append({"kind": 1, "top": i, "bottom": j, "split": r0b, "start": start, "end": end})
+            if r1b == r0a:
+                start = max(c0a, c0b)
+                end = min(c1a, c1b)
