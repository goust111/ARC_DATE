+    marker_counts = {pid: rank + 1 for rank, pid in enumerate(order)}
+    patches: list[np.ndarray] = []
+    for pid, cells in enumerate(piece_cells):
+        local_cells, _r0, _c0, ph, pw = _normalize_cells(cells)
