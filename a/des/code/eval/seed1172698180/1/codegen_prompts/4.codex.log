    inner_h = max(r for r, _ in inner_local) + 1
    inner_w = max(c for _, c in inner_local) + 1

    max_ir = frame_h - 1 - inner_h
    max_ic = frame_w - 1 - inner_w
    if max_ir < 1 or max_ic < 1:
        return None

    ir = random.randint(1, max_ir)
    ic = random.randint(1, max_ic)
