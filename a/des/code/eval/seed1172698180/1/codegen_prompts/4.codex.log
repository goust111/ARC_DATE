from __future__ import annotations

import random

import numpy as np


BG = 0
LOCK_COLOR = 5
KEY_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]

