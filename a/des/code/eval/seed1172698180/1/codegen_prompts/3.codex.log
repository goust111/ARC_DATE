+
+
+def _is_monotone(seq: tuple[int, ...]) -> bool:
+    nondecreasing = all(a <= b for a, b in zip(seq, seq[1:], strict=False))
+    nonincreasing = all(a >= b for a, b in zip(seq, seq[1:], strict=False))
+    return nondecreasing or nonincreasing
