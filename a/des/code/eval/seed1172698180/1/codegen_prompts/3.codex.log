+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+LOCK_COLOR = 5
+KEY_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+PROFILE_LEN_RANGE = (4, 7)
+PROFILE_DEPTH_RANGE = (0, 4)
+LOCK_BODY_RANGE = (2, 4)
+PAIR_COUNT_RANGE = (2, 4)
+GRID_SIDE_RANGE = (20, 30)
+PLACEMENT_PADDING = 1
+MAX_GENERATION_ATTEMPTS = 400
+
+_RNG = random.Random()
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[int(np.argmax(counts))])
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict[str, object]] = []
+
+    for r0 in range(h):
+        for c0 in range(w):
+            color = int(g[r0, c0])
+            if color == bg or seen[r0, c0]:
+                continue
+
+            stack = [(r0, c0)]
+            seen[r0, c0] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                coords.append((r, c))
+                for dr, dc in DIR4:
+                    nr = r + dr
+                    nc = c + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(g[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+
+            rows = [r for r, _ in coords]
+            cols = [c for _, c in coords]
+            r1 = max(rows)
+            c1 = max(cols)
+            r0b = min(rows)
+            c0b = min(cols)
+            mask = np.zeros((r1 - r0b + 1, c1 - c0b + 1), dtype=bool)
+            for r, c in coords:
+                mask[r - r0b, c - c0b] = True
+            comps.append(
+                {
+                    "color": color,
+                    "bbox": (r0b, c0b, r1, c1),
+                    "mask": mask,
+                }
+            )
+    return comps
+
+
+def _top_lock_profile(mask: np.ndarray) -> tuple[int, ...] | None:
+    m = np.asarray(mask, dtype=bool)
+    h, w = m.shape
+    if h < 2 or w < 3:
+        return None
+
+    depths: list[int] = []
+    for c in range(w):
+        col = m[:, c]
+        filled = np.flatnonzero(col)
+        if len(filled) == 0:
+            return None
+        first = int(filled[0])
+        if np.any(~col[first:]):
+            return None
+        depths.append(first)
+
+    if not any(depth > 0 for depth in depths):
+        return None
+    if not any(depth == 0 for depth in depths):
+        return None
+    return tuple(depths)
+
+
+def _top_key_profile(mask: np.ndarray) -> tuple[int, ...] | None:
+    m = np.asarray(mask, dtype=bool)
+    h, w = m.shape
+    if h < 2 or w < 3:
+        return None
+
+    depths: list[int] = []
+    for c in range(w):
+        col = m[:, c]
+        if not bool(col[0]):
+            return None
+        filled = np.flatnonzero(col)
+        last = int(filled[-1])
+        if np.any(~col[: last + 1]):
+            return None
+        if np.any(col[last + 1 :]):
+            return None
+        depths.append(last)
+
+    if not any(depth > 0 for depth in depths):
+        return None
+    return tuple(depths)
+
+
+def _canonical_profile(
+    mask: np.ndarray,
+    extractor,
+) -> tuple[int, ...] | None:
+    hits: list[tuple[int, ...]] = []
+    for turns in range(4):
+        profile = extractor(np.rot90(mask, turns))
+        if profile is not None:
+            hits.append(profile)
+    if len(hits) != 1:
+        return None
+    return hits[0]
+
+
+def _parse_scene(grid: np.ndarray) -> tuple[int, list[dict[str, object]], list[dict[str, object]]]:
+    g = np.asarray(grid, dtype=int)
+    bg = _most_common_color(g)
+    locks: list[dict[str, object]] = []
+    keys: list[dict[str, object]] = []
