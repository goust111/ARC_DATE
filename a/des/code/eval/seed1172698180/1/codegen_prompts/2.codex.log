    rng.shuffle(pairs)
    for a,b in pairs[:rng.randint(0,min(3,len(pairs)) )]:
        if rng.random() < 0.35:
            adj[a].add(b); adj[b].add(a)
    H,W=2*rows+1,2*cols+1
    g=np.full((H,W),WALL,dtype=int)
    for (r,c),ns in adj.items():
        ar,ac=2*r+1,2*c+1
        g[ar,ac]=BLACK
        for nr,nc in ns:
