+def _distance_map(mask: np.ndarray, start: tuple[int, int]) -> np.ndarray:
+    dist = np.full(mask.shape, -1, dtype=int)
+    q = deque([start])
+    dist[start] = 0
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIR4:
+            nr = r + dr
+            nc = c + dc
+            if _in_bounds(mask.shape, nr, nc) and bool(mask[nr, nc]) and int(dist[nr, nc]) < 0:
+                dist[nr, nc] = int(dist[r, c]) + 1
+                q.append((nr, nc))
+    return dist
