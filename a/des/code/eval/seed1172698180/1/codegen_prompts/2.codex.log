            break
        src,nb=rng.choices(frontier, weights=weights, k=1)[0]
        adj.setdefault(nb,set()).add(src)
        adj[src].add(nb)
        dr,dc=nb[0]-src[0], nb[1]-src[1]
        cur=nb
        for _ in range(rng.randint(0,2)):
            nxt=(cur[0]+dr, cur[1]+dc)
            if not (0<=nxt[0]<rows and 0<=nxt[1]<cols) or nxt in adj or len(adj)>=target:
                break
            adj.setdefault(nxt,set()).add(cur)
            adj[cur].add(nxt)
            cur=nxt
    if max(len(v) for v in adj.values()) < 3:
        return None
    cands=[]
    for a,ns in adj.items():
        for b in ns:
            pass
    pairs=[]
    for a in list(adj):
