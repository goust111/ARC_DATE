+        for (r, c), colors in attempts.items():
+            if len(colors) == 1:
+                color = next(iter(colors))
+                free[r, c] = 2
+                out[r, c] = int(color)
+                next_frontiers.setdefault(int(color), set()).add((int(r), int(c)))
+                new_counts[int(color)] = int(new_counts.get(int(color), 0)) + 1
+            else:
+                free[r, c] = 3
+                collision_count += 1
+
+        frontiers = next_frontiers
+        steps += 1
