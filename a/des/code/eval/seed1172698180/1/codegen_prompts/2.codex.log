            g[(ar+br)//2, (ac+bc)//2]=BLACK
    if not has_inter(g==BLACK):
        return None
    return g

def sample(base,rng,want_collision):
    mask=base==BLACK
    cells=[tuple(map(int,p)) for p in np.argwhere(mask)]
    even=[c for c in cells if (c[0]+c[1])%2==0]
    odd=[c for c in cells if (c[0]+c[1])%2==1]
    if want_collision:
        groups=[even] if len(even)>=2 else []
        if len(odd)>=2:
            groups.append(odd)
        if not groups:
            return None
    else:
        if not even or not odd:
            return None
    dcache={c: distmap(mask,c) for c in cells}
    degs={c:deg(mask,c) for c in cells}
    def w(cell):
        d=degs[cell]
        return 4 if d==1 else 3 if d==2 else 1
    min_sep=5
    if want_collision:
        for _ in range(200):
            group=list(rng.choice(groups))
            choices=[n for n in (2,3,4) if len(group)>=n]
            if not choices:
                continue
            n=rng.choices(choices, weights=[4 if k==2 else 2 if k==3 else 1 for k in choices], k=1)[0]
            chosen=[rng.choices(group, weights=[w(c) for c in group], k=1)[0]]
            while len(chosen)<n:
                options=[c for c in group if c not in chosen and all(int(dcache[x][c])>=min_sep for x in chosen)]
                if not options:
                    break
                weights=[sum(int(dcache[x][c]) for x in chosen)+w(c) for c in options]
                chosen.append(rng.choices(options, weights=weights, k=1)[0])
            if len(chosen)!=n:
                continue
            cols=rng.sample(SEED_COLORS,n)
            g=base.copy()
            for col,cell in zip(cols,chosen):
                g[cell]=col
            _,stats=sim(g)
            if stats['"'collision']<=0 or stats['new_total']<8 or min(stats['new_counts'].values())<=0:
                continue
            return g,stats
    else:
        for _ in range(200):
            a=rng.choices(even, weights=[w(c) for c in even], k=1)[0]
            options=[c for c in odd if int(dcache[a][c])>=min_sep]
            if not options:
                continue
            b=rng.choices(options, weights=[int(dcache[a][c])+w(c) for c in options], k=1)[0]
            cols=rng.sample(SEED_COLORS,2)
            g=base.copy(); g[a]=cols[0]; g[b]=cols[1]
            _,stats=sim(g)
            if stats['collision']"'!=0 or stats['"'new_total']<8 or min(stats['new_counts'].values())<=0:
                continue
            return g,stats
    return None

rng=random.Random(0)
for mode in [False, True]:
    got=0
    for i in range(100):
        base=None
        for _ in range(50):
            base=build(rng)
            if base is not None:
                break
        if base is None:
            continue
        res=sample(base,rng,mode)
        if res:
            got+=1
    print('mode',mode,'got',got)
