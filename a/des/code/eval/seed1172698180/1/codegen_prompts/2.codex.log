from collections import deque
import random
import numpy as np

BLACK=0
WALL=5
SEED_COLORS=[1,2,3,4,6,7,8,9]
DIR4=[(1,0),(-1,0),(0,1),(0,-1)]

def sim(grid):
    g=np.array(grid,dtype=int)
    h,w=g.shape
    out=g.copy()
    state=np.zeros((h,w),dtype=np.int8)
    state[g==WALL]=1
    frontiers={}
    new_counts={}
    for r,c in np.argwhere((g"'!=BLACK)&(g!=WALL)):
        col=int(g[r,c])
        frontiers.setdefault(col,set()).add((int(r),int(c)))
        new_counts.setdefault(col,0)
        state[r,c]=2
    collision=0
    steps=0
    while frontiers:
        attempts={}
        for col,cells in frontiers.items():
            for r,c in cells:
                for dr,dc in DIR4:
                    nr,nc=r+dr,c+dc
                    if 0<=nr<h and 0<=nc<w and state[nr,nc]==0:
                        attempts.setdefault((nr,nc),set()).add(col)
        if not attempts:
            break
        nxt={}
        for cell,cols in attempts.items():
            r,c=cell
            if len(cols)==1:
                col=next(iter(cols))
                state[r,c]=2
                out[r,c]=col
                nxt.setdefault(col,set()).add(cell)
                new_counts[col]=new_counts.get(col,0)+1
            else:
                state[r,c]=3
                collision+=1
        steps+=1
        frontiers=nxt
    return out, {"collision":collision, "new_total":sum(new_counts.values()), "new_counts":new_counts, "steps":steps}

def deg(mask, cell):
    r,c=cell
    h,w=mask.shape
    return sum(0<=r+dr<h and 0<=c+dc<w and mask[r+dr,c+dc] for dr,dc in DIR4)

def distmap(mask, start):
    h,w=mask.shape
    dist=np.full((h,w),-1,dtype=int)
    q=deque([start])
    dist[start]=0
    while q:
        r,c=q.popleft()
        for dr,dc in DIR4:
            nr,nc=r+dr,c+dc
            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and dist[nr,nc]<0:
                dist[nr,nc]=dist[r,c]+1
                q.append((nr,nc))
    return dist

def has_inter(mask):
    return any(deg(mask,(int(r),int(c)))>=3 for r,c in np.argwhere(mask))

def build(rng):
    rows=rng.randint(4,7)
    cols=rng.randint(4,8)
    if rows >= 3 and cols >= 3:
        hub=(rng.randint(1,rows-2), rng.randint(1,cols-2))
    else:
        hub=(rng.randrange(rows), rng.randrange(cols))
    adj={hub:set()}
    dirs=DIR4[:]
    rng.shuffle(dirs)
    spokes=[]
    for dr,dc in dirs:
        nr,nc=hub[0]+dr, hub[1]+dc
        if 0<=nr<rows and 0<=nc<cols:
            spokes.append((nr,nc))
    if len(spokes)<3:
        return None
    for nb in spokes[:rng.choice([3,3,4])]:
        adj.setdefault(nb,set()).add(hub)
