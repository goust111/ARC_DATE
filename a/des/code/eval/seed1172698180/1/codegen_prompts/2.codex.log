+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _traversable_degree(mask: np.ndarray, cell: tuple[int, int]) -> int:
+    r, c = cell
+    return sum(
+        1
+        for dr, dc in DIR4
