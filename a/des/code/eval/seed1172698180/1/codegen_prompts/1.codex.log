+    gap_idx = np.flatnonzero(~side_lines[gap_side])
+    assert gap_idx.size >= 1, "opening must contain at least one missing cell"
+    assert int(gap_idx[-1] - gap_idx[0] + 1) == int(gap_idx.size), "opening must be contiguous"
+    return gap_side
