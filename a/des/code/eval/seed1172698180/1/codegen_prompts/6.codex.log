+    arrow_cells.update(candidate["arrow_cells"])  # type: ignore[arg-type]
+    portal_cells.update(candidate["portal_cells"])  # type: ignore[arg-type]
+    wall_cells.update(candidate["wall_cells"])  # type: ignore[arg-type]
