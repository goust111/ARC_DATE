+def _state_ok_for_portals(
+    portal_cells: set[tuple[int, int]],
+    wall_cells: set[tuple[int, int]],
+    h: int,
+    w: int,
+) -> bool:
+    for cell in portal_cells:
+        count = 0
+        for nr, nc in _neighbors(cell):
+            if _in_bounds(h, w, nr, nc) and (nr, nc) in wall_cells:
