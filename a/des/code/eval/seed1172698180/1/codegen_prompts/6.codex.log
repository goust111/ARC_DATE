+def _make_segment_candidate(
+    h: int,
+    w: int,
+    blocked: set[tuple[int, int]],
+    arrow_cells: set[tuple[int, int]],
+    portal_cells: set[tuple[int, int]],
+    wall_cells: set[tuple[int, int]],
+    start: tuple[int, int],
