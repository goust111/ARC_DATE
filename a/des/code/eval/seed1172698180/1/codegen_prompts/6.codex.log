+    return {
+        "blocked": candidate_all,
+        "arrow_cells": new_arrow_cells,
+        "portal_cells": new_portal_cells,
+        "wall_cells": new_walls,
+        "head": head,
+        "direction": direction,
+        "start_portal": start_portal,
