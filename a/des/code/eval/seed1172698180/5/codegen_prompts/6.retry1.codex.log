+                "down": int(r1 - r),
+                "left": int(c - c0),
+                "right": int(c1 - c),
+            }
+            best = min(distances.values())
+            winners = [d for d, dist in distances.items() if int(dist) == int(best)]
+            if len(winners) != 1:
