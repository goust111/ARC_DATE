+def _sample_fence_spec(
+    rng: np.random.Generator,
+    bg: int,
+    bbox: tuple[int, int, int, int],
+) -> dict | None:
+    r0, c0, r1, c1 = bbox
+    interior_h = r1 - r0 - 1
+    interior_w = c1 - c0 - 1
+    interior_area = interior_h * interior_w
+    max_flowers = max(3, interior_area // 2)
+    max_minor = min(4, max_flowers - 2)
+    if max_minor < 1:
+        return None
+
