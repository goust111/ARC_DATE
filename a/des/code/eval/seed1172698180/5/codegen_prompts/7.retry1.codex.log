+BG_POOL = [0, 4, 6, 7, 8, 9]
+GRID_H_RANGE = (14, 23)
+GRID_W_RANGE = (14, 23)
+PATH_COUNT_CHOICES = [1, 2, 3]
+PATH_COUNT_WEIGHTS = [0.3, 0.45, 0.25]
+SEG_LEN_RANGE = (2, 5)
+BRANCH_LEN_RANGE = (1, 4)
