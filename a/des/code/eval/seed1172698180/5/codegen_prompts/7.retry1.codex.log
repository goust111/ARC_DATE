+            for extra_dir in extra_dirs:
+                branch = _grow_branch(
+                    start=node["cell"],
+                    direction=extra_dir,
+                    shape=shape,
+                    occupied=global_occupied | local_network | branches,
+                    reserved=global_reserved | start_guards | end_guards,
+                )
+                if branch is None:
+                    continue
+                branches.update(branch)
