+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    shape = (
+        random.randint(GRID_H_RANGE[0], GRID_H_RANGE[1]),
+        random.randint(GRID_W_RANGE[0], GRID_W_RANGE[1]),
+    )
