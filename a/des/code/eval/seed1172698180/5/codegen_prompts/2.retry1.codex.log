+        seeds_by_color: dict[int, list[tuple[int, int]]] = {color: [] for color in active_colors}
+        used: set[tuple[int, int]] = set()
+
+        colors_order = sorted(active_colors, key=lambda color: (-counts[color], color))
+        ok = True
