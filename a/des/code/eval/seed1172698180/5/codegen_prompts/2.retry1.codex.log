+        rr = int(r)
+        cc = int(c)
+        if owner[rr, cc] >= 0 and not tied[rr, cc]:
+            out[rr, cc] = owner[rr, cc]
+
+    meta = {
+        "bg": bg,
+        "grey": grey,
+        "seed_counts": seed_counts,
+        "tie_cells": tie_cells,
+        "winner_cells": winner_cells,
+    }
+    return (out, meta) if with_meta else out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
