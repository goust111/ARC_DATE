+    if side == "top":
+        base_r = ir0 - kh
+        base_c = mc - kw // 2
+    elif side == "bottom":
+        base_r = ir1 + 1
+        base_c = mc - kw // 2
+    elif side == "left":
+        base_r = mr - kh // 2
+        base_c = ic0 - kw
+    else:
