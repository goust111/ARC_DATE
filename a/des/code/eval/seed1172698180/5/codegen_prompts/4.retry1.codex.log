+        base_c = mc - kw // 2
+    elif side == "bottom":
+        base_r = ir1 + 1
+        base_c = mc - kw // 2
+    elif side == "left":
+        base_r = mr - kh // 2
+        base_c = ic0 - kw
+    else:
+        base_r = mr - kh // 2
+        base_c = ic1 + 1
+
+    for rr, cc in np.argwhere(key):
+        tr = int(base_r + rr)
+        tc = int(base_c + cc)
