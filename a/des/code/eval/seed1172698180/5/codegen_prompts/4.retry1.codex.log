+            specs.append(
+                {
+                    "region_color": region_colors[idx],
+                    "marker_color": marker_colors[idx],
+                    "side": side,
+                    "edge_side": key_edge_sides[idx],
+                    "thickness": thickness,
+                    "cavity_h": cavity_h,
+                    "cavity_w": cavity_w,
+                    "outer_h": cavity_h + 2 * thickness,
+                    "outer_w": cavity_w + 2 * thickness,
+                    "marker_rel": marker_rel,
+                    "key_mask": key_mask,
