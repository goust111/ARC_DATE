+    for reg in regions:
+        key_points, key_mask = _find_key_component(g, reg["marker_color"], reg["marker_pos"])
+        reg["key_points"] = key_points
+        reg["key_mask"] = key_mask
+        reg["side"] = _nearest_side(reg["marker_pos"], reg["inner_bbox"])
