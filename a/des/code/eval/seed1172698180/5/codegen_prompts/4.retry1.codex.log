+def _connected_mask(mask: np.ndarray) -> bool:
+    pts = list(map(tuple, np.argwhere(mask)))
+    if not pts:
+        return False
+    need = set((int(r), int(c)) for r, c in pts)
+    start = next(iter(need))
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if (nr, nc) in need and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
