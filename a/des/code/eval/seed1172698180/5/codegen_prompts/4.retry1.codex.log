+KEY_SHAPES = _build_key_shapes()
+
+
+def _nearest_side(marker: tuple[int, int], inner_bbox: tuple[int, int, int, int]) -> str:
+    mr, mc = marker
+    ir0, ic0, ir1, ic1 = inner_bbox
+    dists = {
+        "top": mr - ir0,
+        "bottom": ir1 - mr,
+        "left": mc - ic0,
+        "right": ic1 - mc,
+    }
+    return min(SIDES, key=lambda side: (dists[side], SIDES.index(side)))
