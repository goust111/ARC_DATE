+            max_t = min(3, bh // 2, bw // 2)
+            for t in range(1, max_t + 1):
+                if bh - 2 * t < 1 or bw - 2 * t < 1:
+                    continue
+                frame = np.zeros((bh, bw), dtype=bool)
