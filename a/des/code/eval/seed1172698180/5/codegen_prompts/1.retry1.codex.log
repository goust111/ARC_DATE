+    piece_colors = palette[1 + n_frames :]
+
+    size_caps = {
+        1: (9, 10),
+        2: (8, 9),
+        3: (7, 8),
+        4: (6, 7),
+    }
+    max_h, max_w = size_caps[n_frames]
+    max_h = min(max_h, h_grid - 2 * EDGE_BAND)
+    max_w = min(max_w, w_grid - 2 * EDGE_BAND)
+    if max_h < 4 or max_w < 4:
