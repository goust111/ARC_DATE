+    h, w = patch.shape
+    grid[r0 : r0 + h, c0 : c0 + w] = patch
+
+
+def _random_frame_position(
+    rng: np.random.Generator,
+    blocked: np.ndarray,
+    h: int,
+    w: int,
+) -> tuple[int, int] | None:
