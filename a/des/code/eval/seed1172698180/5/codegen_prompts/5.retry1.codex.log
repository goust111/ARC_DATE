+    grid_w = random.randint(min_grid_w, min(24, min_grid_w + 6))
+
+    corner = random.choice(("tl", "tr", "bl", "br"))
+    frame_bbox = _frame_bbox_at_corner(grid_h, grid_w, frame_h, frame_w, corner)
