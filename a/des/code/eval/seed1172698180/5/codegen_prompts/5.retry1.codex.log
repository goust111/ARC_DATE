+def _visible_layer_masks(masks: list[np.ndarray], inner_h: int, inner_w: int) -> bool:
+    cover = np.zeros((inner_h, inner_w), dtype=bool)
+    for mask in reversed(masks):
+        h, w = mask.shape
+        visible = np.zeros((inner_h, inner_w), dtype=bool)
+        visible[:h, :w] = mask
