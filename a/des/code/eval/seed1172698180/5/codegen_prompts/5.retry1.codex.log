+    return _render_layers(shape, bg, frame, layers)
+
+
+def _generate_attempt() -> np.ndarray | None:
+    n_fragments = random.randint(2, 4)
+    min_inner_h = max(5, n_fragments + 2)
+    min_inner_w = max(5, n_fragments + 2)
