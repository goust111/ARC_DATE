+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _generate_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"generate_input failed after {GEN_RETRIES} attempts")

