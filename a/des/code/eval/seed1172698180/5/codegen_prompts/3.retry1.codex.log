+from collections import Counter, defaultdict
+
+import numpy as np
+
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR_NAMES = ("up", "down", "left", "right")
+RNG = np.random.default_rng()
+
+GRID_H_RANGE = (20, 31)
+GRID_W_RANGE = (20, 31)
+PAIR_COUNTS = (1, 2, 3)
+MARGIN = 1
+GAP_MIN = 2
+GAP_MAX = 4
+MAX_RETRIES = 400
