+
+
+def _direction_clear(
+    large_r0: int,
+    large_c0: int,
+    large_mask: np.ndarray,
+    small_r0: int,
+    small_c0: int,
+    small_mask: np.ndarray,
+    direction: str,
+) -> bool:
+    lh, lw = large_mask.shape
+    sh, sw = small_mask.shape
+    dr = (small_r0 + (sh - 1) / 2.0) - (large_r0 + (lh - 1) / 2.0)
+    dc = (small_c0 + (sw - 1) / 2.0) - (large_c0 + (lw - 1) / 2.0)
