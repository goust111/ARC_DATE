+        out = [(r0, c0) for c0 in cols]
+    else:
+        center_r = large_r0 + (lh - sh) / 2.0
+        r_start = max(MARGIN, int(np.floor(center_r)) - 2)
+        r_end = min(H - MARGIN - sh, int(np.ceil(center_r)) + 2)
+        if direction == "left":
+            c0 = large_c0 - gap - sw
+        else:
