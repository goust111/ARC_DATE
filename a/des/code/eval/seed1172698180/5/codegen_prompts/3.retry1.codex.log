+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": mask,
+                    "primitive": primitive,
+                    "primitive_scale": int(primitive_scale),
+                    "canonical": canonical,
+                    "key": _mask_key(canonical),
