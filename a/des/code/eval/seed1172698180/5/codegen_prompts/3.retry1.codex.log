+            if direction == "up":
+                score = (r0, abs(c0 - center_c), abs(r0 - center_r), c0)
+            elif direction == "down":
+                score = (-r0, abs(c0 - center_c), abs(r0 - center_r), c0)
+            elif direction == "left":
+                score = (c0, abs(r0 - center_r), abs(c0 - center_c), r0)
+            else:
+                score = (-c0, abs(r0 - center_r), abs(c0 - center_c), r0)
