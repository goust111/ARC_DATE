+def _mark(mask: np.ndarray, r0: int, c0: int, occupied: np.ndarray) -> None:
+    for rr, cc in np.argwhere(mask):
+        occupied[r0 + int(rr), c0 + int(cc)] = True
+
+
+def _paint(mask: np.ndarray, r0: int, c0: int, color: int, grid: np.ndarray) -> None:
