+        if not (MARGIN <= c0 <= W - MARGIN - sw):
+            return []
+        rows = list(range(r_start, r_end + 1))
+        RNG.shuffle(rows)
+        rows.sort(key=lambda r0: (abs(r0 - center_r), r0))
+        out = [(r0, c0) for r0 in rows]
+
+    return out
