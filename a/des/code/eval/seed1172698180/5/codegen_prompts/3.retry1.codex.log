+        if min_r > max_r or min_c > max_c:
+            return None
+
+        placed = False
+        for _ in range(250):
+            large_r0 = int(RNG.integers(min_r, max_r + 1))
+            large_c0 = int(RNG.integers(min_c, max_c + 1))
