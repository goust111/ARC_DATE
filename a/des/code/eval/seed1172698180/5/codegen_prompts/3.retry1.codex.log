+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    visited = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if visited[r, c] or int(g[r, c]) == int(bg):
+                continue
+            color = int(g[r, c])
+            stack = [(r, c)]
+            visited[r, c] = True
