import random
import numpy as np


def neighbors4(r,c,h,w):
    for dr,dc in ((-1,0),(1,0),(0,-1),(0,1)):
        rr,cc=r+dr,c+dc
        if 0<=rr<h and 0<=cc<w:
            yield rr,cc

def connected(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:
        return False
    h,w=mask.shape
    seen={tuple(map(int,pts[0]))}
    stack=[tuple(map(int,pts[0]))]
    while stack:
        r,c=stack.pop()
        for rr,cc in neighbors4(r,c,h,w):
            if mask[rr,cc] and (rr,cc) not in seen:
                seen.add((rr,cc)); stack.append((rr,cc))
    return len(seen)==len(pts)

