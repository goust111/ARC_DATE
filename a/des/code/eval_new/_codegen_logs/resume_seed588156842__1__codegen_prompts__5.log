        'horizontal': np.array_equal(arr, np.flipud(arr)),
        'rot90': arr.shape[0]==arr.shape[1] and np.array_equal(arr, np.rot90(arr)),
    }

def random_path(start,end):
    r,c=start
    out=[start]
    while (r,c)"'!=end:
        choices=[]
        if r<end[0]: choices.append((r+1,c))
        elif r>end[0]: choices.append((r-1,c))
        if c<end[1]: choices.append((r,c+1))
        elif c>end[1]: choices.append((r,c-1))
        r,c=random.choice(choices)
        out.append((r,c))
    return out

def full_area_vertical(rep,h,w):
    half=w//2
    return sum(1 if c==half else 2 for _,c in rep)

def symmetrize_vertical(rep,h,w):
    full=np.zeros((h,w),dtype=bool)
    for r,c in rep:
        full[r,c]=True
        full[r,w-1-c]=True
    return full

def gen_vertical(h,w,frac=(0.3,0.55), attempts=1000):
    half=w//2
    for _ in range(attempts):
        seed=(random.randrange(h), half)
        anchors=[seed,(0,random.randrange(half+1)),(h-1,random.randrange(half+1)),(random.randrange(h),0)]
        rep=set()
        for a in anchors:
            for p in random_path(seed,a):
                rep.add(p)
        min_area=full_area_vertical(rep,h,w)
