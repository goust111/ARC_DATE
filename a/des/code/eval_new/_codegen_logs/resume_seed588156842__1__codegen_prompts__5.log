+
+def _damage_target(mask: np.ndarray, symmetry: str) -> tuple[np.ndarray, set[tuple[int, int]]] | None:
+    h, w = mask.shape
+    orbits = _mask_orbits(mask, symmetry)
+    candidates = [
+        orbit
+        for orbit in orbits
