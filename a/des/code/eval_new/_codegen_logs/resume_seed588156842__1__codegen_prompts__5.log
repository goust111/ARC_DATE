        full = _symmetrize_vertical(rep, h, w)
        if not _valid_unique_mask(full, "vertical"):
            continue
        if not _is_connected(full):
            continue
        if not (np.any(full[0]) and np.any(full[-1]) and np.any(full[:, 0]) and np.any(full[:, -1])):
            continue
        return full
    return None


