+    for _ in range(DAMAGE_ATTEMPTS):
+        count = random.randint(1, min(len(candidates), max(2, len(candidates) // 2)))
+        chosen = random.sample(candidates, count)
+        removed: set[tuple[int, int]] = set()
+        for orbit in chosen:
