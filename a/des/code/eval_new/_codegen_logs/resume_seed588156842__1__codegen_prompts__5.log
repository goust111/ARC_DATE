+                removed.add(random.choice(orbit))
+            else:
+                remove_count = random.randint(1, len(orbit) - 1)
+                removed.update(random.sample(list(orbit), remove_count))
+
+        damaged = mask.copy()
+        for r, c in removed:
+            damaged[r, c] = False
+        if _is_connected(damaged):
+            return damaged, removed
+    return None
