+                    if (rr, cc) not in rep:
+                        frontier.append((rr, cc))
+            if not frontier:
+                break
+            rep.add(random.choice(frontier))
+
+        full = _symmetrize_horizontal(rep, h, w)
+        if not _valid_unique_mask(full, "horizontal"):
