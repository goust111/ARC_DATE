+def _valid_unique_mask(mask: np.ndarray, symmetry: str) -> bool:
+    flags = _symmetry_flags(mask)
+    if symmetry == "vertical":
+        return flags == {"vertical": True, "horizontal": False, "rot90": False}
+    if symmetry == "horizontal":
