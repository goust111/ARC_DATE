        full=symmetrize_vertical(rep,h,w)
        flags=sym_flags(full)
        if flags != {'"'vertical': True, 'horizontal': False, 'rot90': False}:
            continue
        if not connected(full):
            continue
        if not (np.any(full[0]) and np.any(full[-1]) and np.any(full[:,0]) and np.any(full[:,-1])):
            continue
        return full
    return None

def full_area_horizontal(rep,h,w):
