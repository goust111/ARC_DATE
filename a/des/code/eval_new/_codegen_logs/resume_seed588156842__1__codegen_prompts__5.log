+import numpy as np
+
+
+SYMMETRIES = ("vertical", "horizontal", "rot90")
+BRANCH_COUNTER = 0
+GEN_ATTEMPTS = 500
+MASK_ATTEMPTS = 1200
+DAMAGE_ATTEMPTS = 300
+COLOR_ATTEMPTS = 200
+PLACEMENT_ATTEMPTS = 200
