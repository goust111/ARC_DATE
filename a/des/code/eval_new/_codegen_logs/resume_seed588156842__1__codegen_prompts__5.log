    }

def orbit(sym,r,c,h,w):
    if sym=='vertical':
        return tuple(sorted({(r,c),(r,w-1-c)}))
    if sym=='horizontal':
        return tuple(sorted({(r,c),(h-1-r,c)}))
    cells=[]
    rr,cc=r,c
    for _ in range(4):
        cells.append((rr,cc)); rr,cc=cc,w-1-rr
    return tuple(sorted(set(cells)))

def remove(mask,sym,tries=1000):
    h,w=mask.shape
    coords=[tuple(map(int,rc)) for rc in np.argwhere(mask)]
    all_orbits=[]
    seen=set()
    for r,c in coords:
        if (r,c) in seen: continue
        o=orbit(sym,r,c,h,w)
        if all(mask[rr,cc] for rr,cc in o):
            all_orbits.append(o)
            seen.update(o)
    cands=[o for o in all_orbits if len(o)>1 and all(0<rr<h-1 and 0<cc<w-1 for rr,cc in o)]
    if not cands:
        return None
    for _ in range(tries):
        k=random.randint(1, min(len(cands), max(2, len(cands)//2)))
        chosen=random.sample(cands,k)
        removed=set()
