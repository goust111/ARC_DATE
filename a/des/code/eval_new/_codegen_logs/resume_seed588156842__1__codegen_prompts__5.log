+    for r, c in coords:
+        if (r, c) in seen:
+            continue
+        orbit = _orbit(symmetry, r, c, h, w)
+        assert all(mask[rr, cc] for rr, cc in orbit)
+        seen.update(orbit)
+        orbits.append(orbit)
+    return orbits
