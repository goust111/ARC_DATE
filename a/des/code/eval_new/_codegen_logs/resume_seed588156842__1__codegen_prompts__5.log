+def _generate_mask(symmetry: str, small: bool) -> np.ndarray | None:
+    if symmetry == "vertical":
+        h = random.randint(3, 5) if small else random.randint(8, 15)
+        w = 5 if small else random.choice((9, 11, 13, 15))
