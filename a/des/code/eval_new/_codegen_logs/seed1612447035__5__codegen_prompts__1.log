 175: def _expected_output(grid, bg, marker, intervals, top, bottom):
 176:     """Return the solver output implied by the generated wall intervals."""
 177:     height, width = grid.shape
 178:     out = grid.copy()
 179:     for r in range(height):
 180:         if r in intervals:
 181:             start, stop = intervals[r]
 182:         elif top < r < bottom:
 183:             start, stop = 0, width - 1
 184:         elif r < top:
 185:             start, stop = intervals[top]
 186:         else:
 187:             start, stop = intervals[bottom]
 188:         span = out[r, start : stop + 1]
 189:         span[span == bg] = marker
 190:     return out
