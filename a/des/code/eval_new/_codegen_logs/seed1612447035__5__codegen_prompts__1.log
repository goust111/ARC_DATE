+        indicator = int(grid[r, 0])
+        fill = int(grid[r + 1, 0])
+        assert indicator not in (BG, GREY)
+        assert fill not in (BG, GREY)
+        assert indicator != fill
+        assert indicator not in mapping
+        mapping[indicator] = fill
+        legend_cells.add((r, 0))
+        legend_cells.add((r + 1, 0))
