 165: def _wall_interval(wall_cols: list[int], marker_col: int, width: int) -> tuple[int, int]:
 166:     left = [c for c in wall_cols if c < marker_col]
 167:     right = [c for c in wall_cols if c > marker_col]
 168:     if left and right:
 169:         return max(left) + 1, min(right) - 1
 170:     if left:
 171:         return max(left) + 1, width - 1
 172:     return 0, min(right) - 1
 173: 
