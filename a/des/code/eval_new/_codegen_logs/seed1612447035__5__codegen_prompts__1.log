 178:     """Pick 2-4 legends with distinct hole counts that fit within max_span."""
 179:     count = random.randint(*LEGEND_COUNT_RANGE)
 180:     combos = [holes for holes in itertools.combinations(range(MAX_HOLE_COUNT), count)
