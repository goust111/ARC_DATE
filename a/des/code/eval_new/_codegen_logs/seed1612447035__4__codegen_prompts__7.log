+        inward = DOWN
+        axis = "v"
+    elif entry_edge == "bottom":
+        start = (h - 1, int(fixed))
+        inward = UP
+        axis = "v"
+    elif entry_edge == "left":
+        start = (int(fixed), 0)
+        inward = RIGHT
+        axis = "h"
+    elif entry_edge == "right":
+        start = (int(fixed), w - 1)
+        inward = LEFT
+        axis = "h"
