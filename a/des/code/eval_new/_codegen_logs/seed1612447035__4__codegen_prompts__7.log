+            else:
+                assert len(cols) == 1, "mirror must be horizontal or vertical"
+                ordered = sorted(coords, key=lambda rc: rc[0])
+                assert ordered[-1][0] - ordered[0][0] + 1 == len(ordered), "vertical mirror must be contiguous"
+                orientation = "v"
