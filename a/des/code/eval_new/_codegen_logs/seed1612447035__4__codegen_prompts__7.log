+        | (out == GREEN)
+        | ((out == GREY) & (grid != GREY))
+    )
+    if int(mixed_mask.sum()) < 1:
+        return False
+
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    built = _build_core_rays()
+    if built is None:
+        return None
+    grid, target, expected_color = built
+    if not _generated_sample_ok(grid, target, expected_color):
