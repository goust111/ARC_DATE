+        return None
+    if axis == "h" and not (1 <= fixed <= h - 2):
+        return None
+
+    if mirror_pos is None:
+        path: list[tuple[int, int]] = []
+        r, c = start
+        while 0 <= r < h and 0 <= c < w:
+            path.append((int(r), int(c)))
+            r += inward[0]
+            c += inward[1]
+        return {
+            "color": int(color),
+            "entrance": tuple(start),
+            "entry_edge": entry_edge,
