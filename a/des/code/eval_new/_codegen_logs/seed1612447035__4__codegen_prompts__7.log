+            # mirror segment so the ray exits from the mirror's far side.
+            while True:
+                sr, sc = r + dr, c + dc
+                next_mirror = mirror_lookup.get((int(sr), int(sc)))
+                if next_mirror is not mirror:
+                    break
+                r, c = int(sr), int(sc)
+            continue
+
+        path.append(hit)
+        r, c = hit
+
+    return path, int(hits)
