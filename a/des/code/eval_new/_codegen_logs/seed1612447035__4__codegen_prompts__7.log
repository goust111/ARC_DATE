+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+# ARC palette.
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+
+SOURCE_COLORS = (RED, BLUE, YELLOW)
+PAIR_MODES = (
+    (RED, BLUE, MAGENTA),
+    (RED, YELLOW, ORANGE),
+    (BLUE, YELLOW, GREEN),
+)
+
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+
+GENERATE_RETRIES = 400
+GRID_H_RANGE = (12, 20)
+GRID_W_RANGE = (12, 20)
+TARGET_MARGIN = 3
+TARGET_RAY_DISTANCE_MAX = 4
+FREE_RAY_RETRIES = 140
+EXTRA_RAY_PROB = 0.45
+EXTRA_STRAIGHT_PROB = 0.35
