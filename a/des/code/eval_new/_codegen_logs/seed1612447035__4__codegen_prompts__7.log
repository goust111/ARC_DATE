+            return None
+        delta = int(fixed_distance if fixed_distance is not None else random.randint(1, max_delta))
+        mirror_row = tr + delta
+    else:
+        max_delta = min(TARGET_RAY_DISTANCE_MAX, tr - 1)
+        if max_delta < 1:
