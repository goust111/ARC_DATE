+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+# ARC palette.
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+
+SOURCE_COLORS = (RED, BLUE, YELLOW)
+PAIR_MODES = (
+    (RED, BLUE, MAGENTA),
+    (RED, YELLOW, ORANGE),
+    (BLUE, YELLOW, GREEN),
+)
+
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+
+GENERATE_RETRIES = 400
+GRID_H_RANGE = (12, 20)
+GRID_W_RANGE = (12, 20)
+TARGET_MARGIN = 3
+TARGET_RAY_DISTANCE_MAX = 4
+FREE_RAY_RETRIES = 140
+EXTRA_RAY_PROB = 0.45
+EXTRA_STRAIGHT_PROB = 0.35
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[int(np.argmax(counts))])
+
+
+def _mix_color(colors: set[int]) -> int:
+    key = frozenset(int(c) for c in colors)
+    table = {
+        frozenset({RED}): RED,
+        frozenset({BLUE}): BLUE,
+        frozenset({YELLOW}): YELLOW,
+        frozenset({RED, BLUE}): MAGENTA,
+        frozenset({RED, YELLOW}): ORANGE,
+        frozenset({BLUE, YELLOW}): GREEN,
+        frozenset({RED, BLUE, YELLOW}): GREY,
+    }
+    assert key in table, f"unsupported color mix: {sorted(key)}"
+    return int(table[key])
+
+
+def _border_entries(grid: np.ndarray) -> list[dict[str, object]]:
+    h, w = map(int, grid.shape)
+    entries: list[dict[str, object]] = []
+    for r in range(h):
+        for c in range(w):
+            if r not in (0, h - 1) and c not in (0, w - 1):
+                continue
+            color = int(grid[r, c])
+            if color not in SOURCE_COLORS:
+                continue
+            edges: list[str] = []
+            if r == 0:
+                edges.append("top")
+            if r == h - 1:
+                edges.append("bottom")
+            if c == 0:
+                edges.append("left")
+            if c == w - 1:
+                edges.append("right")
+            assert len(edges) == 1, "entrances must avoid corners"
+            edge = edges[0]
+            direction = {
+                "top": DOWN,
+                "bottom": UP,
+                "left": RIGHT,
+                "right": LEFT,
+            }[edge]
+            entries.append(
+                {
+                    "pos": (int(r), int(c)),
+                    "edge": edge,
+                    "direction": direction,
+                    "color": color,
+                }
+            )
+    assert entries, "expected at least one border entrance"
+    return entries
+
+
+def _mirror_components(grid: np.ndarray) -> list[dict[str, object]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = map(int, g.shape)
+    seen = np.zeros((h, w), dtype=bool)
