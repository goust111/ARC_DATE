+            rays.append(free_ray)
+            break
+        else:
+            return None
+
+    if random.random() < EXTRA_RAY_PROB:
+        extra = _sample_free_ray(h, w, random.choice(SOURCE_COLORS), rays)
+        if extra is not None:
