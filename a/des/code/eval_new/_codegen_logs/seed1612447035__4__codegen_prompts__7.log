+    if int(out[target]) != int(expected_color):
+        return False
+    if {int(entry["color"]) for entry in meta["entries"]} != set(SOURCE_COLORS):
+        return False
+    if len(meta["entries"]) < 3:
+        return False
+    if len(meta["mirrors"]) < 2:
+        return False
+    if {mirror["orientation"] for mirror in meta["mirrors"]} != {"h", "v"}:
