+    return None
+
+
+def _render_input(h: int, w: int, rays: list[dict[str, object]]) -> np.ndarray:
+    grid = np.full((h, w), BG, dtype=int)
+    for ray in rays:
+        er, ec = ray["entrance"]
+        grid[er, ec] = int(ray["color"])
+    for ray in rays:
+        for r, c in ray["mirror_cells"]:
+            grid[r, c] = GREY
