+        if not (0 < hit[0] < h - 1):
+            return None
+        path1 = (
+            [(r, int(fixed)) for r in range(0, int(mirror_pos))]
+            if entry_edge == "top"
+            else [(r, int(fixed)) for r in range(h - 1, int(mirror_pos), -1)]
+        )
+        if turn_dir == "left":
+            mirror_cells = [(hit[0], hit[1] - k) for k in range(mirror_len)]
+            out_dir = LEFT
+        elif turn_dir == "right":
+            mirror_cells = [(hit[0], hit[1] + k) for k in range(mirror_len)]
+            out_dir = RIGHT
+        else:
+            return None
+    else:
+        hit = (int(fixed), int(mirror_pos))
+        if not (0 < hit[1] < w - 1):
