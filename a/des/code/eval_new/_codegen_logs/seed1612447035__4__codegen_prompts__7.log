+    mirror_set = set(mirror_cells)
+    path2: list[tuple[int, int]] = []
+    rr, cc = hit[0] + out_dir[0], hit[1] + out_dir[1]
+    while (int(rr), int(cc)) in mirror_set:
+        rr += out_dir[0]
+        cc += out_dir[1]
