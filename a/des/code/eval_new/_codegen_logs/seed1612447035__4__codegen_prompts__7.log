+            out_dir = LEFT
+        elif turn_dir == "right":
+            mirror_cells = [(hit[0], hit[1] + k) for k in range(mirror_len)]
+            out_dir = RIGHT
+        else:
+            return None
+    else:
+        hit = (int(fixed), int(mirror_pos))
+        if not (0 < hit[1] < w - 1):
