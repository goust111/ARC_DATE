+            else [(int(fixed), c) for c in range(w - 1, int(mirror_pos), -1)]
+        )
+        if turn_dir == "up":
+            mirror_cells = [(hit[0] - k, hit[1]) for k in range(mirror_len)]
+            out_dir = UP
+        elif turn_dir == "down":
