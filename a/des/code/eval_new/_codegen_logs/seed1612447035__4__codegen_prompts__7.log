+def _border_entries(grid: np.ndarray) -> list[dict[str, object]]:
+    h, w = map(int, grid.shape)
+    entries: list[dict[str, object]] = []
+    for r in range(h):
+        for c in range(w):
+            if r not in (0, h - 1) and c not in (0, w - 1):
+                continue
+            color = int(grid[r, c])
+            if color not in SOURCE_COLORS:
+                continue
+            edges: list[str] = []
+            if r == 0:
+                edges.append("top")
+            if r == h - 1:
+                edges.append("bottom")
+            if c == 0:
+                edges.append("left")
+            if c == w - 1:
+                edges.append("right")
+            assert len(edges) == 1, "entrances must avoid corners"
+            edge = edges[0]
+            direction = {
+                "top": DOWN,
+                "bottom": UP,
+                "left": RIGHT,
+                "right": LEFT,
+            }[edge]
+            entries.append(
