+def _sample_layout(rng: random.Random) -> tuple[list[int], list[int]]:
+    n_rows, n_cols = rng.choice([(2, 2), (2, 3), (3, 2), (3, 3)])
+    row_heights = [rng.randint(5, 6) for _ in range(n_rows)]
+    col_widths = [rng.randint(5, 6) for _ in range(n_cols)]
