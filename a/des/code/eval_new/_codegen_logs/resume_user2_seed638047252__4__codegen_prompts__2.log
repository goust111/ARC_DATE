+    return {
+        "patch": np.asarray(patch, dtype=int),
+        "core_top": int(core_top),
+        "core_left": int(core_left),
+        "core_h": int(core_h),
+        "core_w": int(core_w),
+        "sig": {
+            "left": side_sig("left"),
+            "right": side_sig("right"),
+            "top": side_sig("top"),
+            "bottom": side_sig("bottom"),
+        },
+    }
+
+
+def _is_flat(sig: tuple[int, ...]) -> bool:
+    return all(int(v) == 0 for v in sig)
