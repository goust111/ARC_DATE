+
+def _make_piece_patch(
+    core_h: int,
+    core_w: int,
+    left_sig: tuple[int, ...],
+    right_sig: tuple[int, ...],
+    top_sig: tuple[int, ...],
+    bottom_sig: tuple[int, ...],
+    body_color: int,
+    accent_color: int,
