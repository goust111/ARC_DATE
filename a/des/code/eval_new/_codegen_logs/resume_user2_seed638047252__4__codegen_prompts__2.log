+    _area, out_shape, color = max(candidates, key=lambda x: x[0])
+    return out_shape, color
+
+
+def _analyze_piece_patch(patch: np.ndarray, bg: int) -> dict:
+    mask = np.asarray(patch != int(bg), dtype=bool)
+    rows = [int(r) for r in range(mask.shape[0]) if bool(mask[r, :].any())]
+    cols = [int(c) for c in range(mask.shape[1]) if bool(mask[:, c].any())]
+    assert rows and cols
+
+    lefts = [int(np.flatnonzero(mask[r])[0]) for r in rows]
+    rights = [int(np.flatnonzero(mask[r])[-1]) for r in rows]
+    tops = [int(np.flatnonzero(mask[:, c])[0]) for c in cols]
+    bottoms = [int(np.flatnonzero(mask[:, c])[-1]) for c in cols]
+
+    core_left = _mode_int(lefts)
+    core_right = _mode_int(rights)
+    core_top = _mode_int(tops)
+    core_bottom = _mode_int(bottoms)
+    core_h = int(core_bottom - core_top + 1)
+    core_w = int(core_right - core_left + 1)
+    assert core_h >= 3 and core_w >= 3
+
+    def side_sig(side: str) -> tuple[int, ...]:
+        vals: list[int] = []
+        if side in ("left", "right"):
+            for rr in range(core_h):
+                r = core_top + rr
+                if side == "left":
+                    outside = core_left - 1
+                    boundary = core_left
+                else:
+                    outside = core_right + 1
+                    boundary = core_right
+                if 0 <= outside < mask.shape[1] and bool(mask[r, outside]):
+                    vals.append(1)
+                elif not bool(mask[r, boundary]):
+                    vals.append(-1)
+                else:
+                    vals.append(0)
+        else:
+            for cc in range(core_w):
+                c = core_left + cc
+                if side == "top":
+                    outside = core_top - 1
+                    boundary = core_top
+                else:
+                    outside = core_bottom + 1
+                    boundary = core_bottom
+                if 0 <= outside < mask.shape[0] and bool(mask[outside, c]):
+                    vals.append(1)
+                elif not bool(mask[boundary, c]):
+                    vals.append(-1)
+                else:
+                    vals.append(0)
+        return tuple(vals)
