+    for rr, v in enumerate(left_sig):
+        if int(v) == -1:
+            arr[1 + rr, 1] = int(bg)
+        elif int(v) == 1:
+            arr[1 + rr, 0] = int(accent_color)
+    for rr, v in enumerate(right_sig):
