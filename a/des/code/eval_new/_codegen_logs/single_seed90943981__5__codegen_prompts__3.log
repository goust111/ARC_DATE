+def _components(mask: np.ndarray, connectivity: int = 8) -> list[list[tuple[int, int]]]:
+    H, W = mask.shape
+    seen = np.zeros((H, W), dtype=bool)
+    if connectivity == 4:
+        dirs = [(-1, 0), (0, -1), (0, 1), (1, 0)]
+    else:
+        dirs = _DIRS8
