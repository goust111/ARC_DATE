+def _symmetry_kind(seed: np.ndarray) -> str:
+    has_h = np.array_equal(seed, seed[::-1, :])
+    has_v = np.array_equal(seed, seed[:, ::-1])
+    if has_h and has_v:
+        return "both"
+    if has_h:
+        return "h"
+    if has_v:
+        return "v"
+    return "diag"
