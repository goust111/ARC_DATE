+def _make_diag_mask(seed: np.ndarray, max_h: int, max_w: int) -> np.ndarray | None:
+    h, w = seed.shape
+    max_steps = min(3, max_h // h, max_w // w)
+    if max_steps < 2:
+        return None
+    steps = int(RNG.integers(2, max_steps + 1))
+    mask = np.zeros((steps * h, steps * w), dtype=bool)
+    for k in range(steps):
