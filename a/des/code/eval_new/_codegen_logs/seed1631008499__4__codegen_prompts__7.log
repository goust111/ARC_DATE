+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+SIDES = ("top", "bottom", "left", "right")
+PALETTE = tuple(range(1, 10))
+GEN_RETRIES = 400
+
+
+def _dominant_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _full_border(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    border: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        border.append((r0, c))
+        if r1 != r0:
+            border.append((r1, c))
+    for r in range(r0 + 1, r1):
+        border.append((r, c0))
+        if c1 != c0:
+            border.append((r, c1))
+    return border
+
+
+def _ordered_gap(missing: list[tuple[int, int]]) -> tuple[str, list[tuple[int, int]]] | None:
+    if not missing:
+        return None
+    rows = {r for r, _ in missing}
+    cols = {c for _, c in missing}
+    if len(rows) == 1:
+        row = next(iter(rows))
+        ordered = sorted(missing, key=lambda p: p[1])
+        if all(ordered[i + 1][1] == ordered[i][1] + 1 for i in range(len(ordered) - 1)):
+            if row == min(rows):
+                pass
+        return None
+    if len(cols) == 1:
+        col = next(iter(cols))
+        ordered = sorted(missing, key=lambda p: p[0])
+        if all(ordered[i + 1][0] == ordered[i][0] + 1 for i in range(len(ordered) - 1)):
+            if col == min(cols):
+                pass
+        return None
+    return None
+
+
+def _classify_gap(missing: list[tuple[int, int]], r0: int, c0: int, r1: int, c1: int):
+    if not (1 <= len(missing) <= 3):
+        return None
+    if all(r == r0 for r, _ in missing):
+        ordered = sorted(missing, key=lambda p: p[1])
+        if all(ordered[i + 1][1] == ordered[i][1] + 1 for i in range(len(ordered) - 1)):
+            return "top", ordered
+    if all(r == r1 for r, _ in missing):
+        ordered = sorted(missing, key=lambda p: p[1])
+        if all(ordered[i + 1][1] == ordered[i][1] + 1 for i in range(len(ordered) - 1)):
