+
+    fences = _extract_fences(grid)
+    if len(fences) != n_fences:
+        return None
+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return None
+    if max(grid.shape) > 30 or max(out.shape) > 30:
+        return None
+    return grid
