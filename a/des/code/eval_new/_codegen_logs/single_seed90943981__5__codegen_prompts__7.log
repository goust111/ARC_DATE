+        "mask": m.copy(),
+        "hole_mask": hole,
+        "hole_bbox": _bbox_true(hole),
+        "side": side,
+    }
+
+
+def _coords_from_mask(mask: np.ndarray) -> set[tuple[int, int]]:
+    return {tuple(map(int, p)) for p in np.argwhere(mask)}
+
+
+def _inside_bbox(cell: tuple[int, int], bbox: tuple[int, int, int, int]) -> bool:
+    r, c = cell
