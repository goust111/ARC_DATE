+    return int(r0) <= int(r) <= int(r1) and int(c0) <= int(c) <= int(c1)
+
+
+def _handle_outside_lock(
+    handle_cells: set[tuple[int, int]],
+    bbox: tuple[int, int, int, int],
+    side: str,
