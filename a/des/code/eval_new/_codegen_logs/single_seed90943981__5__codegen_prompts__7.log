+    colors = random.sample(COLOR_POOL, 2 * pair_count)
+    for i, pair in enumerate(pairs):
+        pair["lock_color"] = int(colors[2 * i])
+        pair["key_color"] = int(colors[2 * i + 1])
+
+    reserved: list[tuple[int, int, int, int]] = []
