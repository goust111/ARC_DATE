+            r0, c0, r1, c1 = _bbox_from_points(pts)
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            mask[pts[:, 0] - r0, pts[:, 1] - c0] = True
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": pts,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
