+        teeth_cells = {(dest_r0 + int(r), dest_c0 + int(c)) for r, c in np.argwhere(rot_key["teeth_mask"])}
+        handle_cells = {(dest_r0 + int(r), dest_c0 + int(c)) for r, c in np.argwhere(rot_key["handle_mask"])}
+        if teeth_cells != hole_global:
