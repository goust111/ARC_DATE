+
+def _build_key_mask_east(tooth: np.ndarray) -> np.ndarray:
+    tooth = np.asarray(tooth, dtype=bool)
+    rows = np.flatnonzero(tooth[:, 0])
+    assert rows.size == 2 and int(rows[1]) == int(rows[0] + 1)
+    anchor = int(rows[0])
+    h, w = tooth.shape
+    key = np.zeros((h, w + 2), dtype=bool)
+    key[anchor : anchor + 2, 0:2] = True
+    key[:, 2:] = tooth
+    return key
