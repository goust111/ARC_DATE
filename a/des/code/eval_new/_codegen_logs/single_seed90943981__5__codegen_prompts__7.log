+                            continue
+                        frontier.add((int(nr), int(nc)))
+            if not frontier:
+                break
+            cells.add(random.choice(list(frontier)))
+            if len(cells) >= max(4, w + 1) and any(c == w - 1 for _, c in cells) and random.random() < 0.35:
