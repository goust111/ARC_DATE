+        cells = {(contact_row, 0)}
+        target_area = random.randint(max(4, w + 1), min(h * w - 1, h * w))
+        while len(cells) < target_area or not any(c == w - 1 for _, c in cells):
+            frontier: set[tuple[int, int]] = set()
+            for r, c in list(cells):
