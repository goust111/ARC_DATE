+def _make_pair(existing_shapes: set[tuple[tuple[int, int], bytes]]) -> dict | None:
+    for _ in range(300):
+        result = _random_tooth_mask()
+        if result is None:
+            continue
+        tooth, handle_top = result
+        canon = _canonical_rot_token(tooth)
+        if canon in existing_shapes:
+            continue
