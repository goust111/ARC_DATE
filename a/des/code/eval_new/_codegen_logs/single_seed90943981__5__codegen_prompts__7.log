+
+def _extract_key(mask: np.ndarray) -> dict | None:
+    m = np.asarray(mask, dtype=bool)
+    if not bool(m.any()) or not _is_connected(m):
+        return None
+    h, w = m.shape
+    candidates = []
+    for r in range(h - 1):
+        for c in range(w - 1):
+            if not bool(m[r : r + 2, c : c + 2].all()):
