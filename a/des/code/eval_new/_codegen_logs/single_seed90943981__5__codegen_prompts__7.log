+
+
+def _component_infos(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if bool(seen[r, c]) or int(g[r, c]) == int(bg):
+                continue
+            color = int(g[r, c])
+            q = deque([(int(r), int(c))])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
