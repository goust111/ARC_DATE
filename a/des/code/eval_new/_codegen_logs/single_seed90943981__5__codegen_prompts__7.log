+            if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]):
+                nxt = (int(nr), int(nc))
+                if nxt not in seen:
+                    seen.add(nxt)
+                    q.append(nxt)
+    return len(seen) == int(mask.sum())
+
+
+def _count_full_2x2(mask: np.ndarray) -> int:
