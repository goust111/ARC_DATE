+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+import numpy as np
+
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDES = ("top", "right", "bottom", "left")
+BG_COLOR = 8
+GEN_RETRIES = 400
+COLOR_POOL = [0, 1, 2, 3, 4, 5, 6, 7, 9]
+ROT_FOR_SIDE = {"left": 0, "bottom": 1, "right": 2, "top": 3}
