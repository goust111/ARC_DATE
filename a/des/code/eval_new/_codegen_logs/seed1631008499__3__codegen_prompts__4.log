+    r0, c0, r1, c1 = frame["bbox"]
+    assert painted.shape == frame["inner_shape"], "frame must fit the rotated stamp"
+
+    out = g.copy()
+    last_color = int(g[path[-1]])
+    inner = out[r0 + 1 : r1, c0 + 1 : c1]
+    inner[painted] = last_color
+    return out
