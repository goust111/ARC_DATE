+    rail_mask = (grid != BG_COLOR) & (grid != STAMP_COLOR) & (grid != FRAME_COLOR)
+    comps = _components(rail_mask)
+    assert len(comps) == 1, "expected one rail path"
+    cells = set(comps[0])
+    h, w = grid.shape
+    neighbor_map: dict[tuple[int, int], list[tuple[int, int]]] = {}
+    for cell in cells:
