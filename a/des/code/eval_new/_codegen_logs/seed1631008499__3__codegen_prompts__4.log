+        for index in range(segment_count):
+            if index > 0:
+                segments.append([])
+            dr, dc = DIRS[direction]
+            steps = lengths[index] - 1 if index == 0 else lengths[index]
+            for _step in range(steps):
+                nxt = (cur[0] + dr, cur[1] + dc)
