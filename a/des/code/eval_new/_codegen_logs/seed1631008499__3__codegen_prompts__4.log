+    if dir_index == 1:
+        return [(r, w - 1) for r in range(h) if mask[r, w - 1]]
+    if dir_index == 2:
+        return [(h - 1, c) for c in range(w) if mask[h - 1, c]]
+    return [(r, 0) for r in range(h) if mask[r, 0]]
