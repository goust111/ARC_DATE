+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < h:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < w:
+        out.append((r, c + 1))
+    return out
+
+
+def _neighbors4_unbounded(cell: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = cell
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
