+def _segment_points(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    dr = b[0] - a[0]
+    dc = b[1] - a[1]
+    steps = max(abs(dr), abs(dc))
+    if steps == 0:
+        return [a]
