+        r1, c1 = cycle[(i + 1) % n]
+        dr = int(np.sign(r1 - r0))
+        dc = int(np.sign(c1 - c0))
+        assert (dr, dc) != (0, 0)
+        assert dr == 0 or dc == 0 or abs(r1 - r0) == abs(c1 - c0)
+        dirs.append((dr, dc))
+    runs = 1
+    for i in range(1, len(dirs)):
+        if dirs[i] != dirs[i - 1]:
+            runs += 1
+    if dirs[0] == dirs[-1]:
+        runs -= 1
+    return runs
