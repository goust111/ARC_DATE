+        adj[(r, c)] = sorted(nbrs)
+    start = min(coords)
+    ordered = [start]
+    prev = None
+    cur = start
+    while True:
+        a, b = adj[cur]
+        nxt = a if a != prev else b
+        prev, cur = cur, nxt
+        if cur == start:
+            break
+        ordered.append(cur)
+        assert len(ordered) <= len(coords), "cycle traversal overflow"
