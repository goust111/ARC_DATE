+
+def _runs(indices: list[int]) -> list[tuple[int, int]]:
+    if not indices:
+        return []
+    spans = []
+    start = prev = indices[0]
+    for x in indices[1:]:
+        if x == prev + 1:
+            prev = x
+            continue
+        spans.append((start, prev))
+        start = prev = x
+    spans.append((start, prev))
+    return spans
