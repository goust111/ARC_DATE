+def _count_sides(coords: list[tuple[int, int]]) -> int:
+    points = sorted({(c, r) for r, c in coords})
+    assert len(points) >= 3
+
+    def cross(o: tuple[int, int], a: tuple[int, int], b: tuple[int, int]) -> int:
+        return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])
