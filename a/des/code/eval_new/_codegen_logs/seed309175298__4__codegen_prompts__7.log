+        return "h", int(patch[0, 0]), int(patch[1, 0])
+    if all(len(set(map(int, patch[:, c]))) == 1 for c in range(patch.shape[1])):
+        return "v", int(patch[0, 0]), int(patch[0, 1])
+    return "d", int(patch[0, 0]), int(patch[0, 1])
+
