+def _trace_cycle(coords: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    pts = set(coords)
+    adj: dict[tuple[int, int], list[tuple[int, int]]] = {}
+    for r, c in coords:
+        nbrs = []
+        for nr, nc in neighbors8(r, c):
+            if (nr, nc) not in pts:
+                continue
+            dr = nr - r
+            dc = nc - c
+            if abs(dr) + abs(dc) == 1:
+                nbrs.append((nr, nc))
+                continue
+            if abs(dr) == 1 and abs(dc) == 1:
+                if (r, c + dc) not in pts and (r + dr, c) not in pts:
+                    nbrs.append((nr, nc))
