+        out = main(grid)
+        got_map, _legend_box = _read_legend(grid)
+    except Exception:
+        return None
+    if got_map != expected_map:
+        return None
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
