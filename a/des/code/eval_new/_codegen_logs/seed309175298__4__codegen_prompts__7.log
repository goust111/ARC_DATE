+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+MAROON = 9
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8]
+GEN_RETRIES = 400
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _components(mask: np.ndarray, *, conn8: bool) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    neigh = neighbors8 if conn8 else neighbors4
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in neigh(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _rect_border_ok(mask: np.ndarray, bbox: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = bbox
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 5 or w < 5:
+        return False
+    expect = 2 * (h + w) - 4
+    if int(mask[r0 : r1 + 1, c0 : c1 + 1].sum()) != expect:
+        return False
+    if not np.all(mask[r0, c0 : c1 + 1]):
+        return False
+    if not np.all(mask[r1, c0 : c1 + 1]):
+        return False
+    if not np.all(mask[r0 : r1 + 1, c0]):
+        return False
+    if not np.all(mask[r0 : r1 + 1, c1]):
+        return False
+    return True
+
+
+def _find_legend_bbox(grid: np.ndarray) -> tuple[int, int, int, int]:
+    grey_mask = grid == GREY
