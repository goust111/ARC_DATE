+                continue
+            dr = nr - r
+            dc = nc - c
+            if abs(dr) + abs(dc) == 1:
+                nbrs.append((nr, nc))
+                continue
+            if abs(dr) == 1 and abs(dc) == 1:
+                if (r, c + dc) not in pts and (r + dr, c) not in pts:
+                    nbrs.append((nr, nc))
