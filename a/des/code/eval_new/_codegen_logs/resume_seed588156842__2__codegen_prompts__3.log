+        rows = (r - 2, r - 1)
+    elif direction == LEFT:
+        cols = (c, c + 1) if mode == "start" else (c - 1, c)
+        rows = (r + 1, r + 2)
+    elif direction == UP:
+        rows = (r, r + 1) if mode == "start" else (r - 1, r)
+        cols = (c - 2, c - 1)
+    elif direction == DOWN:
+        rows = (r - 1, r) if mode == "start" else (r, r + 1)
+        cols = (c + 1, c + 2)
+    else:
