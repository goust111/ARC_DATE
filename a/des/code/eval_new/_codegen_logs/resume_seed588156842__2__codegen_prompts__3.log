+    footprint = set(cell_colors)
+    assert len(footprint) == len(cell_colors), "segment object must not self-overlap"
+    return cell_colors, footprint
+
+
+def _halo(cells: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:
