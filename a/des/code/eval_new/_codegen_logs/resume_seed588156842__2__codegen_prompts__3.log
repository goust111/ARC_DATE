+    if tr == r0 - 1 and c0 <= tc <= c1:
+        side = "top"
+    elif tr == r1 + 1 and c0 <= tc <= c1:
+        side = "bottom"
+    elif tc == c0 - 1 and r0 <= tr <= r1:
+        side = "left"
+    elif tc == c1 + 1 and r0 <= tr <= r1:
