+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+WIRE = 5
+SIGNAL_COLORS = (1, 2, 3, 7)
+PORTAL_COLORS = (4, 6, 8, 9)
+
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+DIRS = (UP, DOWN, LEFT, RIGHT)
