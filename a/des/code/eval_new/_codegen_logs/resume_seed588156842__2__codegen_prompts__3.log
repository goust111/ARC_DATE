+    "top": RIGHT,
+    "bottom": LEFT,
+    "left": UP,
+    "right": DOWN,
+}
+PORTAL_SIDE_FROM_DIR = {
+    RIGHT: "top",
+    LEFT: "bottom",
+    UP: "left",
+    DOWN: "right",
+}
