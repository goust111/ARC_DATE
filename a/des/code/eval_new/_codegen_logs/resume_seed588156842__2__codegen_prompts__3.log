+        pos = source_pos
+        dr, dc = direction
+        ignore_portal: int | None = None
+        seen: set[tuple[int, int, int, int, int]] = set()
+        while True:
+            state = (pos[0], pos[1], dr, dc, -1 if ignore_portal is None else ignore_portal)
+            assert state not in seen, "signal propagation entered a loop"
+            seen.add(state)
