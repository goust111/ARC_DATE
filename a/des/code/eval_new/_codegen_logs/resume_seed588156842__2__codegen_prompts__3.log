+MIN_SIDE = 14
+MAX_SIDE = 30
+MAX_GENERATION_ATTEMPTS = 300
+MAX_PLACEMENT_ATTEMPTS = 300
+MIN_SEG_LEN = 3
+MAX_SEG_LEN = 7
+MAX_SIGNALS = 3
+MAX_PORTAL_HOPS = 3
