+
+def _all_compositions(total: int, parts: int, max_part: int) -> list[tuple[int, ...]]:
+    if parts == 0:
+        return [()] if total == 0 else []
+    out: list[tuple[int, ...]] = []
+    for first in range(min(max_part, total) + 1):
