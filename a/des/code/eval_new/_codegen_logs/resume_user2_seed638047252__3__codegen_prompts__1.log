+def _frame_patch(
+    outer_h: int,
+    outer_w: int,
+    bg: int,
+    frame_color: int,
+    used_shapes: set[tuple[tuple[int, int], ...]],
+) -> tuple[dict[str, object], dict[str, object]] | None:
+    interior_h = outer_h - 2
+    interior_w = outer_w - 2
