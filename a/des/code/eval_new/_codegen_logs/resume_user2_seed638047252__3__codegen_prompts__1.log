+    coords: list[tuple[int, int]] | tuple[tuple[int, int], ...]
+) -> tuple[tuple[tuple[int, int], ...], int, int]:
+    r0, c0, r1, c1 = _bbox(coords)
+    norm = tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))
