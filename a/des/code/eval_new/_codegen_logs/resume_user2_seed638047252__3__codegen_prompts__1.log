+            continue
+        patch = obj["patch"]  # type: ignore[index]
+        mask = patch != bg
+        out[top : top + patch.shape[0], left : left + patch.shape[1]][mask] = bg
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+    return inp, out
+
