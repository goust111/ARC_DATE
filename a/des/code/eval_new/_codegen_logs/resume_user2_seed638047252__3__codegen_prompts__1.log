+        sprite_idx = candidates[0]
+        used.add(sprite_idx)
+
+        for rr, cc in hole:
+            out[r0 + 1 + rr, c0 + 1 + cc] = frame_color
+        for rr, cc in sprites[sprite_idx]["coords"]:  # type: ignore[index]
+            out[rr, cc] = bg
+
+    return out
