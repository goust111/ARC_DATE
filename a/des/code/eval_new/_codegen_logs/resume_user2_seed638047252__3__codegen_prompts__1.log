+    frame_obj = {
+        "kind": "frame",
+        "patch": patch,
+        "frame_color": int(frame_color),
+        "hole_mask": hole_mask,
+    }
+    sprite_patch = np.full((hole_h, hole_w), bg, dtype=int)
