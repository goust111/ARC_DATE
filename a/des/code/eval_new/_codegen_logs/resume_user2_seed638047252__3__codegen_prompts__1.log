+        frame_obj, sprite_obj = built
+        sprite_patch = sprite_obj["patch"]  # type: ignore[index]
+        sprite_patch[sprite_patch == -1] = sprite_colors[i]
+        frames.append(frame_obj)
+        sprites.append(sprite_obj)
