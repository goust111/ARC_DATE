+    used: set[int] = set()
+    out = g.copy()
+    for frame in frames:
+        r0, c0, r1, c1 = frame["bbox"]  # type: ignore[misc]
+        frame_color = int(frame["color"])  # type: ignore[arg-type]
+        interior = g[r0 + 1 : r1, c0 + 1 : c1]
+        holes = _components(interior == bg)
