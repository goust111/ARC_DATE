+        shift_c = -max(cols)
+        return [(r, c + shift_c) for r, c in cells]
+    if name == "left":
+        shift_c = -min(cols)
+        return [(r, c + shift_c) for r, c in cells]
+    if name == "down":
+        shift_r = -max(rows)
+        return [(r + shift_r, c) for r, c in cells]
+    if name == "up":
+        shift_r = -min(rows)
+        return [(r + shift_r, c) for r, c in cells]
