+            if pair["corridor"] & forbidden:
+                continue
+            pairs.append(pair)
+            forbidden |= pair["corridor"]
+            forbidden |= _halo(exact, h, w)
+            placed = True
+            break
+        if not placed:
+            return None
+
+    inp, expected = _render_input(h, w, bg, pairs)
+    if _most_common_color(inp) != bg:
+        return None
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+    if np.array_equal(actual, expected):
+        return inp
+    return None
+
