    out = patch.copy()
    if side == "left":
        out[:, 3:] = np.rot90(out[:, 3:], 2)
    elif side == "right":
        out[:, :3] = np.rot90(out[:, :3], 2)
    elif side == "top":
        out[3:, :] = np.rot90(out[3:, :], 2)
