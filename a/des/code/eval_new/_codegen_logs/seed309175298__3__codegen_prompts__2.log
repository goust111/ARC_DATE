+def _extract_fragments(values: list[int]) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    i = 0
+    n = len(values)
+    while i < n:
+        color = values[i]
+        j = i + 1
+        while j < n and values[j] == color:
