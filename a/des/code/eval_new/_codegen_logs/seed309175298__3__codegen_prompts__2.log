+    grey_boxes: list[tuple[int, int, int, int]] = []
+    offset = 0
+    while True:
+        rr0, cc0 = r0 + offset, c0 + offset
+        rr1, cc1 = r1 - offset, c1 - offset
+        if rr1 - rr0 < 2 or cc1 - cc0 < 2:
+            break
+        box = (rr0, cc0, rr1, cc1)
+        if all(int(g[r, c]) == GREY for r, c in _rect_perimeter_coords(*box)):
+            grey_boxes.append(box)
+            offset += 2
+        else:
+            break
