+    paths: list[list[tuple[int, int]]] = []
+    for rr0, cc0, rr1, cc1 in grey_boxes[:-1]:
+        paths.append(_rect_perimeter_coords(rr0 + 1, cc0 + 1, rr1 - 1, cc1 - 1))
+    return paths
