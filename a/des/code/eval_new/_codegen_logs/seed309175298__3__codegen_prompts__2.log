+    mask = np.zeros_like(g, dtype=bool)
+    lr0, lc0, lr1, lc1 = legend_bbox
+    mask[lr0 : lr1 + 1, lc0 : lc1 + 1] = True
+    grey_pts = np.argwhere((g == GREY) & ~mask)
+    if grey_pts.size == 0:
+        return []
+
+    r0, c0 = map(int, grey_pts.min(axis=0))
+    r1, c1 = map(int, grey_pts.max(axis=0))
