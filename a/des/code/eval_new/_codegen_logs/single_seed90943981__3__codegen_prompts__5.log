+YELLOW = 4
+LEVEL_COLOR = 8
+DEMO_BEFORE = np.array([[1, 2], [3, 6]], dtype=int)
+TRANSFORMS = ("hflip", "vflip", "rot90cw")
+FRAME_COLOR_POOL = (1, 2, 3, 5, 6, 7, 9)
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
