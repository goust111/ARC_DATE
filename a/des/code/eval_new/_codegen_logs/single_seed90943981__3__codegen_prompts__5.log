+    inner_h = int(rng.integers(4, side_cap + 1))
+    inner_w = int(rng.integers(4, side_cap + 1))
+    outer_h = inner_h + 2 + 4 * (depth - 1)
+    outer_w = inner_w + 2 + 4 * (depth - 1)
