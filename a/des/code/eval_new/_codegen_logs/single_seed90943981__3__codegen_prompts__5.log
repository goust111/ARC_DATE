+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _split_consecutive(indices) -> list[list[int]]:
+    values = [int(x) for x in indices]
+    if not values:
+        return []
+    groups = [[values[0]]]
+    for value in values[1:]:
+        if value == groups[-1][-1] + 1:
+            groups[-1].append(value)
+        else:
+            groups.append([value])
+    return groups
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if visited[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and int(grid[nr, nc]) == color:
+                        visited[nr, nc] = True
+                        stack.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            r0, c0 = np.min(arr, axis=0)
+            r1, c1 = np.max(arr, axis=0)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def _is_rect_frame(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    patch = np.zeros((h, w), dtype=bool)
+    rr = comp["coords"][:, 0] - r0
+    cc = comp["coords"][:, 1] - c0
+    patch[rr, cc] = True
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return np.array_equal(patch, border)
+
+
+def _bbox_area(bbox: tuple[int, int, int, int]) -> int:
