+    for frame in innermost_frames:
+        r0, c0, r1, c1 = frame["bbox"]
+        interior = grid[r0 + 1 : r1, c0 + 1 : c1]
+        mask[r0 + 1 : r1, c0 + 1 : c1] = interior == YELLOW
