+    return (r0, c0, r1, c1)
+
+
+def _overlap_size(a, b):
+    inter = _intersect(a, b)
+    if inter is None:
+        return (0, 0)
+    return (inter[2] - inter[0] + 1, inter[3] - inter[1] + 1)
