+
+
+def _render_output(h: int, w: int, rects, legend_rows):
+    depth = np.zeros((h, w), dtype=int)
+    for r0, c0, r1, c1, _color in rects:
+        depth[r0 : r1 + 1, c0 : c1 + 1] += 1
