+            r0 = random.randint(0, h - height)
+            c0 = random.randint(0, work_w - width)
+            rect = (r0, c0, r0 + height - 1, c0 + width - 1, color)
+            if any(_rect_with_margin_intersects(rect, other, margin=1) for other in rects):
