+        assert len(pts) > 0
+        r0, c0 = pts.min(axis=0)
+        r1, c1 = pts.max(axis=0)
+        rects.append((int(r0), int(c0), int(r1), int(c1), color))
+
+    depth = np.zeros_like(g, dtype=int)
+    for r0, c0, r1, c1, _color in rects:
+        depth[r0 : r1 + 1, c0 : c1 + 1] += 1
