+
+def _find_legend(grid: np.ndarray) -> tuple[int, np.ndarray]:
+    h, w = grid.shape
+    candidates = []
+    for c in range(w - 1, -1, -1):
+        rows = np.flatnonzero(grid[:, c] != BLACK)
+        if len(rows) != 3:
