+
+
+def _sample_grown_mask(max_dim: int) -> np.ndarray:
+    h = random.randint(2, max_dim)
+    w = random.randint(2, max_dim)
+    target = random.randint(max(4, h + w - 1), min(h * w, h * w - 1 if h * w > 4 else h * w))
