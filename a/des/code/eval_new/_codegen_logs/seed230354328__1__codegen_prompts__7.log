+    if np.count_nonzero(grid == YELLOW) != 1:
+        return False
+    if np.count_nonzero(grid == MAROON) < 2:
+        return False
+    changed = np.argwhere(grid != out)
+    if changed.shape != (1, 2):
+        return False
+    r, c = map(int, changed[0])
+    if int(grid[r, c]) != MAROON or int(out[r, c]) != GREEN:
+        return False
+    return True

