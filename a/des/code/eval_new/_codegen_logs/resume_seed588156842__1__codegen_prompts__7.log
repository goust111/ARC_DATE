+    sum_r, sum_c = center
+    full_pattern = set(visible)
+    for cell in tuple(visible):
+        full_pattern.add(_reflect(cell, sum_r, sum_c))
+
+    out = np.full(g.shape, bg, dtype=int)
+    for r, c in full_pattern:
+        out[r, c] = pattern_color
