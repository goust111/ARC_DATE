+    except Exception:
+        return None
+    if info["ties"] != 1:
+        return None
+    if not np.array_equal(actual, out):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid input")

