+        _, axis_idx = max(row_candidates)
+        axis_color = _mode(grid[axis_idx, :])
+        return "row", axis_idx, axis_color
+    if col_candidates and not row_candidates:
+        _, axis_idx = max(col_candidates)
+        axis_color = _mode(grid[:, axis_idx])
+        return "col", axis_idx, axis_color
