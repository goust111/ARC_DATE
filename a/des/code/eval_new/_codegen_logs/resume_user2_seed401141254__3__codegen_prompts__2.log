+    seeds = _choose_seed_positions(h, w, axis_kind, axis_idx, templates, seed_colors, rng)
+    if seeds is None:
+        return None
+
+    expected = _render_expected((h, w), bg, axis_kind, axis_idx, seeds, templates)
