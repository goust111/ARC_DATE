+def _paint_shape(
+    out: np.ndarray,
+    color: int,
+    seed: tuple[int, int],
+    rel_coords: list[tuple[int, int]],
+    axis_kind: str,
+    axis_idx: int,
+) -> None:
+    h, w = out.shape
+    sr, sc = seed
+    for dr, dc in rel_coords:
+        rr, cc = sr + dr, sc + dc
+        if not (0 <= rr < h and 0 <= cc < w):
+            continue
+        if axis_kind == "row" and rr == axis_idx and (rr, cc) != seed:
+            continue
+        if axis_kind == "col" and cc == axis_idx and (rr, cc) != seed:
+            continue
+        out[rr, cc] = color
