+def _target_hit(grid: np.ndarray, rect: dict, tip: tuple[int, int], step: tuple[int, int]) -> bool:
+    h, w = grid.shape
+    r0, c0, r1, c1 = rect["bbox"]
+    rr, cc = int(tip[0] + step[0]), int(tip[1] + step[1])
