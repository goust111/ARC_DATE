+BG = 0
+PALETTE = tuple(range(1, 10))
+
+GRID_MIN = 18
+GRID_MAX = 30
+OBJECT_COUNT_RANGE = (2, 5)
+ROT90_SIZES = (5, 7, 9)
+ROT180_SIZES = (5, 7, 9)
+MAX_PLACEMENT_TRIES = 250
