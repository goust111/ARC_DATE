+    place_min_c = 4 if side == "left" else 0
+    place_max_c = width - 1 if side == "left" else width - 5
+
+    for item in objects:
+        obj = item["grid"]
+        oh, ow = obj.shape
+        if place_max_c - place_min_c + 1 < ow:
+            return None
+        placed = False
+        for _ in range(MAX_PLACEMENT_TRIES):
+            r0 = rng.randint(0, height - oh)
