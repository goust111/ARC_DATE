+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors8(r: int, c: int, h: int, w: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < h and 0 <= cc < w:
+                yield rr, cc
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors8(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    comp = _components(mask)
+    return len(comp) == 1 and comp[0].shape[0] == coords.shape[0]
+
+
+def _orbit_closure(mask: np.ndarray, symmetry: str) -> np.ndarray:
+    if symmetry == "rot180":
+        return mask | mask[::-1, ::-1]
+    assert symmetry == "rot90"
+    assert mask.shape[0] == mask.shape[1]
+    result = np.zeros_like(mask, dtype=bool)
+    cur = mask.copy()
+    for _ in range(4):
+        result |= cur
+        cur = np.rot90(cur)
+    return result
