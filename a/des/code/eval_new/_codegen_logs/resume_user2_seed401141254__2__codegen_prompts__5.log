+                for c1 in range(c0 + 4, min(w, c0 + 10)):
+                    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+                    border = np.zeros_like(patch, dtype=bool)
+                    border[0, :] = True
+                    border[-1, :] = True
+                    border[:, 0] = True
+                    border[:, -1] = True
+                    if not np.all(patch[border] == GREY):
+                        continue
+                    inner = patch[1:-1, 1:-1]
+                    if inner.size == 0:
+                        continue
+                    if not np.all((inner == BG) | (inner == GREY)):
