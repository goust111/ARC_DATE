+            return None
+        ref_r = random.randint(0, grid_h - ref_h)
+        ref_c = grid_w - ref_w
+    else:
+        main_h = random.randint(12, 18)
+        main_w = random.randint(max(12, ref_w + 2), 22)
+        grid_h = main_h + GAP + ref_h
+        grid_w = main_w
+        if grid_h > 30:
+            return None
+        ref_r = grid_h - ref_h
+        ref_c = random.randint(0, grid_w - ref_w)
