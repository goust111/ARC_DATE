+            continue
+        if any(not any(active[(idx, direction)] for direction in DIR_ORDER) for idx in range(len(towers))):
+            continue
+        if not _pair_coverage_ok(pair_desc, active):
+            continue
+        visible = _visible_crossings(pair_desc, active)
+        if visible == all_cells:
