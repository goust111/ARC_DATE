+
+        full_active = {(idx, direction): True for idx in range(tower_count) for direction in DIR_ORDER}
+        inp = _render((h, w), towers, mix_map, active_dirs=active_dirs)
+        out = _render((h, w), towers, mix_map, active_dirs=full_active)
