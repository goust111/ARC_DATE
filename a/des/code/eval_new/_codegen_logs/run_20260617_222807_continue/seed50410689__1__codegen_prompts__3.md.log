+        if not any(
+            int(out[r, c]) != int(inp[r, c]) and int(out[r, c]) in output_mix
+            for r in range(h)
+            for c in range(w)
+        ):
+            continue
+        return inp, out
+    return None
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        result = _generate_case(rng)
+        if result is None:
+            continue
+        inp, _out = result
