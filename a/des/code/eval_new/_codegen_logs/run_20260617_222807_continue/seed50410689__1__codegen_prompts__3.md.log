+        pair_keys = [frozenset((int(towers[i]["color"]), int(towers[j]["color"]))) for i in range(tower_count) for j in range(i + 1, tower_count)]
+        mix_map = {pair: int(color) for pair, color in zip(pair_keys, mix_colors)}
