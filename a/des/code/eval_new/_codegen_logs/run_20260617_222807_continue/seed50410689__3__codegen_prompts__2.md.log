+    legend_positions = _legend_positions(h, w, legend_len, corner)
+    for (r, c), color in zip(legend_positions, legend):
+        grid[r, c] = int(color)
+
+    expected = _expected_output(grid, ring_meta, legend_positions)
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
