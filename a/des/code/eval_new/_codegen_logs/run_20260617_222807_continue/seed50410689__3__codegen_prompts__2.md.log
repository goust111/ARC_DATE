SRC_H_RANGE = (9, 19)             # source rect height (outer, inclusive)
SRC_W_RANGE = (8, 18)             # source rect width (outer, inclusive)
DST_H_RANGE = (9, 19)             # dest rect height (outer, inclusive)
DST_W_RANGE = (8, 20)             # dest rect width (outer, inclusive)
DST_W_SIDE_MAX = 20               # dest width cap for side-by-side layout

# === CFG: Sprite & placement ===
SPRITE_TYPE_CHOICES = (1, 2)      # number of distinct sprite types
MARKER_COUNT_RANGE = (2, 3)       # markers in dest rect
SOURCE_SPRITE_RANGE = (2, 4)      # total sprites in source rect
MARKER_PLACE_RETRIES = 25         # retries per marker for non-overlapping placement
SOURCE_SPRITE_PADDING = 1         # min gap between source sprites and edges

# === CFG: Generation retries ===
MAX_GEN_ATTEMPTS = 300            # outer retry limit

SPRITE_SHAPES = [
    (("AB.", "BBB"), (0, 0)),
    (("ABB", "BBB"), (0, 0)),
    ((".A.", "BBB", ".B."), (0, 1)),
    (("AB.", "BBB", ".BB"), (0, 0)),
    (("ABB", "BBB", "..B"), (0, 0)),
    ((".AB", "BBB", "BB."), (0, 1)),
    (("B.B", "BBB", ".A."), (2, 1)),
    ((".B.", "BAB", ".B."), (1, 1)),
    (("BBB", "BAB"), (1, 1)),
    (("AB.", "BBB", ".B."), (0, 0)),
    (("BAB", "BBB"), (0, 1)),
]


def _render_sprite(shape_rows: tuple[str, ...], body: int, anchor: int, bg: int) -> np.ndarray:
    """Render a sprite template into a colored patch. 'A'=anchor, 'B'=body, '.'=bg."""
    char_map = {'B': body, 'A': anchor}
    rows = [[char_map.get(ch, bg) for ch in row] for row in shape_rows]
    return np.array(rows, dtype=int)


def _make_wallpaper(direction: str, palette: list[int]) -> np.ndarray:
    """Create a 30x30 striped wallpaper (vertical or horizontal)."""
    period = len(palette)
    stripe = np.array(palette * ((GRID_SIZE + period - 1) // period), dtype=int)[:GRID_SIZE]
    if direction == "vertical":
        return np.tile(stripe, (GRID_SIZE, 1))
    return np.tile(stripe.reshape(-1, 1), (1, GRID_SIZE))


def _build_frame(h: int, w: int, border: int, bg: int) -> np.ndarray:
    """Create an h x w rectangle with a 1-pixel border and interior filled with bg."""
    rect = np.full((h, w), bg, dtype=int)
    rect[0, :] = rect[-1, :] = border
    rect[:, 0] = rect[:, -1] = border

