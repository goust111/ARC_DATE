+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PALETTE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_RETRIES = 300
