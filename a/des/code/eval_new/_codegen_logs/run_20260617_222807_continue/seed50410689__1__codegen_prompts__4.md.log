+    def touches_corner(coords: list[tuple[int, int]]) -> bool:
+        rows = [r for r, _ in coords]
+        cols = [c for _, c in coords]
+        r0, r1 = min(rows), max(rows)
+        c0, c1 = min(cols), max(cols)
+        return (
+            (r0 == 0 and c0 == 0)
+            or (r0 == 0 and c1 == w - 1)
+            or (r1 == h - 1 and c0 == 0)
+            or (r1 == h - 1 and c1 == w - 1)
+        )
