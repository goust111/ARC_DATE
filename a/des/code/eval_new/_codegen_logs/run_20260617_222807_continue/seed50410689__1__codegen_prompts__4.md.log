+_RNG = np.random.default_rng()
+GRID_SIZE_RANGE = (14, 27)
+ARM_LEN_RANGE = (1, 5)
+STAMP_COUNT_RANGE = (2, 6)
+GENERATION_ATTEMPTS = 400
+PLACEMENT_MARGIN = 1
+ANCHOR_TRIALS = 200
+DIST_TRIALS = 10
+CORNERS = ("tl", "tr", "bl", "br")
+BASE_PROTOTYPE_DIRS = frozenset({(1, 0), (0, 1)})
