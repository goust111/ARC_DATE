+def _rotation_for_dirs(
+    src_dirs: frozenset[tuple[int, int]],
+    dst_dirs: frozenset[tuple[int, int]],
+) -> int:
+    for k in range(4):
+        if frozenset(_rotate_vec(vec, k) for vec in src_dirs) == dst_dirs:
