+
+def _corner_shift(
+    offsets: tuple[tuple[int, int], ...],
+    corner: str,
+    height: int,
+    width: int,
+) -> tuple[int, int]:
+    min_dr, max_dr, min_dc, max_dc = _bounds(offsets)
+    if corner == "tl":
+        return -min_dr, -min_dc
+    if corner == "tr":
+        return -min_dr, width - 1 - max_dc
+    if corner == "bl":
+        return height - 1 - max_dr, -min_dc
+    if corner == "br":
+        return height - 1 - max_dr, width - 1 - max_dc
