+def _place_fragments(
+    grid: np.ndarray,
+    start_col: int,
+    fragment_masks: list[np.ndarray],
+    colors: list[int],
+) -> list[dict] | None:
+    h, w = grid.shape
+    reserved: list[tuple[int, int, int, int]] = []
+    placements: list[dict] = []
