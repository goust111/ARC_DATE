+) -> tuple[np.ndarray, list[dict]] | None:
+    template = np.full((template_h, template_w), GEN_TEMPLATE_COLOR, dtype=int)
+    reserved: list[tuple[int, int, int, int]] = []
+    holes: list[dict] = []
