+            for cell_r, cell_c, dr, dc in candidates:
+                ar = int(r0 + cell_r + dr)
+                ac = int(c0 + cell_c + dc)
+                if 0 <= ar < template_h and 0 <= ac < template_w:
+                    valid_anchors.append((ar, ac))
+            if not valid_anchors:
