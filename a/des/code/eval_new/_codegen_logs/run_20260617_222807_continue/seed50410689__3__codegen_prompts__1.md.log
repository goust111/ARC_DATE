    g=np.zeros((H,W),dtype=int)
    r0,c0=5,5; r1,c1=14,14
    g[r0,c0:c1+1]=5;g[r1,c0:c1+1]=5;g[r0:r1+1,c0]=5;g[r0:r1+1,c1]=5
    gaps={'top':(8,9),'bottom':(10,12),'left':(7,8),'right':(9,10)}
    for c in range(*gaps['top'],1):
        pass
    for s,(a,b) in gaps.items():
        if s=='top': g[r0,a:b+1]=0
        elif s=='bottom': g[r1,a:b+1]=0
        elif s=='left': g[a:b+1,c0]=0
        else: g[a:b+1,c1]=0
    colors={'top':2,'bottom':3,'left':4,'right':6}
    # place canonical pieces randomly simple
    pieces={'top':CAN,'bottom':CAN4,'left':CAN,'right':CAN4}
    placements={'top':(1,8),'bottom':(16,10),'left':(7,1),'right':(9,16)}
    rots={'top':1,'bottom':2,'left':3,'right':0}
    for s in pieces:
        coords=rotations(pieces[s])[rots[s]%len(rotations(pieces[s]))]
        rr,cc=placements[s]
        for r,c in coords:
            g[rr+r,cc+c]=colors[s]
    return g

x=gen()
