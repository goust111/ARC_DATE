/bin/bash -lc "python - <<'PY'
import numpy as np, random
from collections import Counter, deque

BG=0
FRAME=5


def runs(idxs):
    idxs=sorted(idxs)
    out=[]
    if not idxs: return out
    s=p=idxs[0]
    for x in idxs[1:]:
        if x==p+1:
            p=x
        else:
            out.append((s,p))
            s=p=x
    out.append((s,p))
    return out


def most_common_color(g):
    vals, cnt = np.unique(g, return_counts=True)
    return int(vals[np.argmax(cnt)])


def find_components(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    comps=[]
    for r in range(h):
        for c in range(w):
            if mask[r,c] and not seen[r,c]:
                q=[(r,c)]
                seen[r,c]=True
                pts=[]
                while q:
                    x,y=q.pop()
                    pts.append((x,y))
                    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                        nx,ny=x+dx,y+dy
                        if 0<=nx<h and 0<=ny<w and mask[nx,ny] and not seen[nx,ny]:
                            seen[nx,ny]=True
                            q.append((nx,ny))
                comps.append(pts)
    return comps


def normalize(coords):
    rs=[r for r,c in coords]; cs=[c for r,c in coords]
    r0=min(rs); c0=min(cs)
    return tuple(sorted((r-r0,c-c0) for r,c in coords))


def rotations(coords):
    cur=np.array(normalize(coords),dtype=int)
    seen=[]; keys=set()
    for _ in range(4):
        key=tuple(map(tuple,cur))
        if key not in keys:
            keys.add(key); seen.append(cur.copy())
        # rot90 around bbox
        h=cur[:,0].max()+1; w=cur[:,1].max()+1
        rot=np.array([(w-1-c,r) for r,c in cur],dtype=int)
        rot=np.array(normalize(rot),dtype=int)
        cur=rot
    return seen


def boundary_leg(rot, side):
    if side=='top':
        edge=rot[:,0].max(); vals=sorted(rot[rot[:,0]==edge][:,1].tolist())
    elif side=='bottom':
        edge=rot[:,0].min(); vals=sorted(rot[rot[:,0]==edge][:,1].tolist())
    elif side=='left':
        edge=rot[:,1].max(); vals=sorted(rot[rot[:,1]==edge][:,0].tolist())
    else:
        edge=rot[:,1].min(); vals=sorted(rot[rot[:,1]==edge][:,0].tolist())
    return vals


def piece_fits_side(coords, side, gap_len):
    for rot in rotations(coords):
        vals=boundary_leg(rot, side)
        if len(vals)==gap_len and vals==list(range(vals[0], vals[0]+gap_len)):
            return True
    return False


def extract_scene(g):
    bg=most_common_color(g)
    vals, cnt = np.unique(g[g"'!=bg], return_counts=True)
    frame=int(vals[np.argmax(cnt)])
    mask=(g==frame)
    rs,cs=np.where(mask)
    r0,r1=int(rs.min()),int(rs.max())
    c0,c1=int(cs.min()),int(cs.max())
    gaps={}
    top=[c for c in range(c0,c1+1) if g[r0,c]==bg]
    bottom=[c for c in range(c0,c1+1) if g[r1,c]==bg]
    left=[r for r in range(r0,r1+1) if g[r,c0]==bg]
    right=[r for r in range(r0,r1+1) if g[r,c1]==bg]
    gaps['"'top']=runs(top)[0]
    gaps['bottom']=runs(bottom)[0]
    gaps['left']=runs(left)[0]
    gaps['right']=runs(right)[0]
    other=(g"'!=bg)&(g!=frame)
    frags=[]
    for pts in find_components(other):
        colors={int(g[r,c]) for r,c in pts}
        assert len(colors)==1
        color=colors.pop()
        rs=[r for r,c in pts]; cs=[c for r,c in pts]
        minr,maxr=min(rs),max(rs); minc,maxc=min(cs),max(cs)
        if maxr<r0: side='"'top'
        elif minr>r1: side='bottom'
        elif maxc<c0: side='left'
        elif minc>c1: side='right'
        else: side='unknown'
        frags.append({'color':color,'coords':pts,'side':side,'bbox':(minr,minc,maxr,maxc)})
    return {'bg':bg,'frame':frame,'bbox':(r0,c0,r1,c1),'gaps':gaps,'frags':frags}


def main(g):
    g=np.array(g,dtype=int)
    scene=extract_scene(g)
    bg=scene['bg']; frame=scene['frame']; r0,c0,r1,c1=scene['bbox']
    out=np.full_like(g,bg)
    out[r0, c0:c1+1]=frame
    out[r1, c0:c1+1]=frame
    out[r0:r1+1, c0]=frame
    out[r0:r1+1, c1]=frame
    repaired=[]
    for frag in scene['frags']:
        side=frag['side']
        if side=='unknown':
            continue
        gap=scene['gaps'][side]
        a,b=gap
        if side in ('top','bottom'):
            fa,fb=frag['bbox'][1],frag['bbox'][3]
        else:
