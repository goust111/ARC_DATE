        for c in range(5):
            v1, v2 = int(t1[r, c]), int(t2[r, c])
            if (r, c) in inside:
                if v1 != b:
                    out3[r, c] = v1
            elif (r, c) in wall:
                if v1 != b:
                    out3[r, c] = v1
                elif wall_4conn and v2 != b:
                    out3[r, c] = v2
            else:
                if v2 != b:
                    out3[r, c] = v2

