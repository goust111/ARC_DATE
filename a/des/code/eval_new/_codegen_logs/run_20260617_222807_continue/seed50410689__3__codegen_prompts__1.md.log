            continue
        gap_len=b-a+1
        rel=normalize(frag['coords'])
        if not piece_fits_side(rel, side, gap_len):
            continue
        if side=='top':
            out[r0, a:b+1]=frag['color']; repaired.append((r0,a,side,frag['color'],gap))
        elif side=='bottom':
            out[r1, a:b+1]=frag['color']; repaired.append((r1,a,side,frag['color'],gap))
        elif side=='left':
            out[a:b+1, c0]=frag['color']; repaired.append((a,c0,side,frag['color'],gap))
        else:
            out[a:b+1, c1]=frag['color']; repaired.append((a,c1,side,frag['color'],gap))
    repaired.sort(key=lambda x:(x[0],x[1]))
    for _,_,side,color,gap in repaired:
        if side=='top':
            cols=range(gap[0],gap[1]+1)
            for r in range(r0+1,r1):
                stripe=[(r,c) for c in cols]
                hit=any(out[x,y] not in (bg,frame) for x,y in stripe)
                for x,y in stripe: out[x,y]=color
                if hit: break
        elif side=='bottom':
            cols=range(gap[0],gap[1]+1)
            for r in range(r1-1,r0,-1):
                stripe=[(r,c) for c in cols]
                hit=any(out[x,y] not in (bg,frame) for x,y in stripe)
                for x,y in stripe: out[x,y]=color
                if hit: break
        elif side=='left':
            rows=range(gap[0],gap[1]+1)
            for c in range(c0+1,c1):
                stripe=[(r,c) for r in rows]
                hit=any(out[x,y] not in (bg,frame) for x,y in stripe)
                for x,y in stripe: out[x,y]=color
                if hit: break
        else:
            rows=range(gap[0],gap[1]+1)
            for c in range(c1-1,c0,-1):
                stripe=[(r,c) for r in rows]
                hit=any(out[x,y] not in (bg,frame) for x,y in stripe)
                for x,y in stripe: out[x,y]=color
                if hit: break
    return out

CAN=[(0,0),(1,0),(1,1)]
CAN4=[(0,0),(1,0),(2,0),(2,1)]

def rot_mask(coords,k):
    arr=np.array(normalize(coords),dtype=int)
    for _ in range(k%4):
        h=arr[:,0].max()+1; w=arr[:,1].max()+1
        arr=np.array([(c,h-1-r) for r,c in arr],dtype=int)  # maybe wrong
        arr=np.array(normalize(arr),dtype=int)
    return [tuple(x) for x in arr.tolist()]


