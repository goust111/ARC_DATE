+    return specs
+
+
+def _fill_from_specs(grid: np.ndarray, specs: list[dict[str, int]], patterns: dict[int, list[int]]) -> np.ndarray:
+    out = grid.copy()
+    for spec in specs:
+        r0 = spec["r0"]
+        c0 = spec["c0"]
+        r1 = spec["r1"]
+        c1 = spec["c1"]
