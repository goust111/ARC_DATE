+            if not bool(mask[r0, c0]) or bool(seen[r0, c0]):
+                continue
+            stack = [(int(r0), int(c0))]
+            seen[r0, c0] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                comp.append((int(r), int(c)))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = r + dr, c + dc
