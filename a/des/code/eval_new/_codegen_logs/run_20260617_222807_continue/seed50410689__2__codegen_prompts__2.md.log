+def _smallest_period(seq: list[int]) -> list[int]:
+    n = len(seq)
+    for p in range(1, n + 1):
+        if all(seq[i] == seq[i % p] for i in range(n)):
+            return [int(x) for x in seq[:p]]
+    raise AssertionError("period must exist")
