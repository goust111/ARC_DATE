+def _legend_mapping(grid: np.ndarray, bg: int) -> tuple[dict[int, list[int]], int]:
+    h, _ = grid.shape
+    rows: list[int] = []
+    for r in range(h - 1, -1, -1):
+        if _is_legend_row(grid[r], bg):
+            rows.append(int(r))
+        elif rows:
+            break
+    assert rows, "bottom legend rows must be present"
+    rows.reverse()
