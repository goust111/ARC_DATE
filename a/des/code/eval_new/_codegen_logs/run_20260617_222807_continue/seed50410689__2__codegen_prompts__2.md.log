+def _is_legend_row(row: np.ndarray, bg: int) -> bool:
+    if row.size < 3 or int(row[0]) == bg:
+        return False
+    strip = [int(x) for x in row[1:]]
+    if any(v == bg for v in strip):
+        return False
+    if len(set(strip)) != 2:
+        return False
+    period = _smallest_period(strip)
+    return len(period) == 2 and period[0] != period[1]
