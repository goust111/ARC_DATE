+def _sample_interior_mask() -> np.ndarray | None:
+    for _ in range(REGION_SHAPE_ATTEMPTS):
+        box_h = random.randint(2, 5)
+        box_w = random.randint(2, 5)
+        max_area = min(9, box_h * box_w - 1)
+        if max_area < 3:
+            continue
+        area = random.randint(3, max_area)
