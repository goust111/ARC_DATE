+import random
+
+import numpy as np
+
+
+BG_COLOR = 0
+MARKER_COLOR = 5
+FRAME_COLOR = 9
+SEED_COLORS = [1, 2, 3, 4, 6, 7, 8]
+DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+LAYOUTS = {
+    2: [(1, 2), (2, 1)],
+    3: [(1, 3), (3, 1), (2, 2)],
+    4: [(2, 2)],
+    5: [(2, 3), (3, 2)],
+}
+SLOT_MIN = 6
+SLOT_MAX = 8
+GAP = 1
+GENERATION_RETRIES = 300
+
+
+def _components4(mask: np.ndarray) -> list[set[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[set[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: set[tuple[int, int]] = set()
+            while stack:
+                rr, cc = stack.pop()
+                comp.add((rr, cc))
+                for dr, dc in DIRECTIONS:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
