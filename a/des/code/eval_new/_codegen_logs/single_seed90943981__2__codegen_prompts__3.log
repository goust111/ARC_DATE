+PRISM_NORMS = {
+    frozenset({(0, 0), (0, 1), (1, 0)}),
+    frozenset({(0, 0), (0, 1), (1, 1)}),
+    frozenset({(0, 0), (1, 0), (1, 1)}),
+    frozenset({(0, 1), (1, 0), (1, 1)}),
