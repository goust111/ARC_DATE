+    lengths = []
+    run_steps = 1
+    for prev_dir, cur_dir in zip(directions, directions[1:]):
+        if cur_dir == prev_dir:
+            run_steps += 1
+        else:
+            lengths.append(run_steps + 1)
+            run_steps = 1
