+        if deg not in (1, 2):
+            return None
+        degrees[(r, c)] = deg
+    endpoints = sorted(pt for pt, deg in degrees.items() if deg == 1)
+    if len(endpoints) != 2:
+        return None
+
+    seen = set()
+    stack = [endpoints[0]]
+    while stack:
+        cur = stack.pop()
+        if cur in seen:
+            continue
+        seen.add(cur)
+        r, c = cur
+        for dr, dc in _DIRS4:
+            nxt = (r + dr, c + dc)
+            if nxt in pts and nxt not in seen:
+                stack.append(nxt)
+    if len(seen) != len(pts):
+        return None
+    return endpoints, degrees
+
+
+def _trace_path(coords: list[tuple[int, int]], start: tuple[int, int]) -> list[tuple[int, int]]:
+    pts = set(coords)
+    order = [start]
+    prev = None
+    cur = start
+    while True:
