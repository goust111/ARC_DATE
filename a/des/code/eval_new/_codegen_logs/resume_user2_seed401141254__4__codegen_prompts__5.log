+        path.append(nxt)
+        added.append(nxt)
+        current = nxt
+    return added
+
+
+def _build_path_from_lengths(lengths: list[int], rng: random.Random) -> list[tuple[int, int]] | None:
+    dirs0 = _DIRS4[:]
