+            if not _can_add_cells(occupied, current, cells):
+                ok = False
+                break
+            occupied.update(cells)
+            node_pos = cells[-1]
+            chosen_dir = _turn(direction, action)
+            is_stop = stop_case and idx == n_nodes - 1
+            node = {
+                "pos": node_pos,
+                "action": action,
+                "incoming": direction,
+                "back": _opposite(direction),
+                "chosen": chosen_dir,
+                "out": None if is_stop else chosen_dir,
+                "stop": is_stop,
+            }
+            nodes.append(node)
+            current = node_pos
+            if is_stop:
