+            for extra_dir in extra_dirs:
+                lengths = _feasible_lengths(
+                    occupied,
+                    pos,
+                    extra_dir,
+                    keep_source_edge_clear=(extra_dir == WEST),
+                )
+                if not lengths:
+                    ok = False
+                    break
+                branch_len = _choice(lengths)
+                occupied.update(_ray_cells(pos, extra_dir, branch_len))
+            if not ok:
+                break
