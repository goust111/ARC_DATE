+    seen: set[tuple[tuple[int, int], ...]] = set()
+    for _ in range(4):
+        if cur not in seen:
+            seen.add(cur)
+            out.append(cur)
+        cur = _rotate90(cur)
+    return out
+
+
+def _canonical(shape: Iterable[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
