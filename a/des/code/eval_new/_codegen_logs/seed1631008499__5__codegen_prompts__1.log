+def _place_template(
+    rng: random.Random,
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    shape: tuple[tuple[int, int], ...],
+    color: int,
+) -> bool:
+    H, W = grid.shape
+    for _ in range(300):
+        oriented = _choice_rot(rng, shape)
+        th0, tw0, th1, tw1 = _bbox(oriented)
+        th = th1 - th0 + 1
+        tw = tw1 - tw0 + 1
+        edge = rng.choice(("top", "bottom", "left", "right"))
+        if edge == "top":
+            r0 = 0
+            c0 = rng.randint(0, W - tw)
+        elif edge == "bottom":
+            r0 = H - th
+            c0 = rng.randint(0, W - tw)
+        elif edge == "left":
+            r0 = rng.randint(0, H - th)
+            c0 = 0
+        else:
+            r0 = rng.randint(0, H - th)
+            c0 = W - tw
+
+        cells = [(r0 + r, c0 + c) for r, c in oriented]
+        zone = _expand_box(r0, c0, r0 + th - 1, c0 + tw - 1, H, W, pad=1)
+        if any(blocked[r, c] for r, c in zone):
+            continue
+        for r, c in cells:
+            grid[r, c] = color
+        _mark_blocked(blocked, zone)
+        return True
+    return False
