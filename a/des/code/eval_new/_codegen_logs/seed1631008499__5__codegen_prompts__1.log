+        if lr == pr0:
+            dr, dc = DIR_VECTORS["up"]
+        elif lr == pr1:
+            dr, dc = DIR_VECTORS["down"]
+        elif lc == pc0:
+            dr, dc = DIR_VECTORS["left"]
+        else:
+            dr, dc = DIR_VECTORS["right"]
