+    out: list[tuple[tuple[int, int], ...]] = []
+    seen: set[tuple[tuple[int, int], ...]] = set()
+    for _ in range(4):
+        if cur not in seen:
+            seen.add(cur)
+            out.append(cur)
+        cur = _rotate90(cur)
