+        pts.append((r, c1))
+    return pts
+
+
+def _slide_until_blocked(
+    out: np.ndarray,
+    payload: list[tuple[int, int]],
+    dr: int,
+    dc: int,
+) -> list[tuple[int, int]]:
+    h, w = out.shape
+    cur = list(payload)
+    while True:
+        nxt = [(r + dr, c + dc) for r, c in cur]
+        if any(not (0 <= nr < h and 0 <= nc < w) or int(out[nr, nc]) != BG for nr, nc in nxt):
+            return cur
+        cur = nxt
