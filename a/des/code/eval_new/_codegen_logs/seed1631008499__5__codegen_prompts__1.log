+        elif direction == "right":
+            payload_rel = [(lane, idx) for idx in payload_idx]
+        elif direction == "up":
+            payload_rel = [(idx, lane) for idx in payload_idx]
+        else:
+            payload_rel = [(idx, lane) for idx in payload_idx]
