+
+def _expand_box(r0: int, c0: int, r1: int, c1: int, h: int, w: int, pad: int = 1) -> list[tuple[int, int]]:
+    er0 = max(0, r0 - pad)
+    ec0 = max(0, c0 - pad)
+    er1 = min(h - 1, r1 + pad)
+    ec1 = min(w - 1, c1 + pad)
+    return [(r, c) for r in range(er0, er1 + 1) for c in range(ec0, ec1 + 1)]
