+        return [(r - delta, c) for r, c in payload]
+    if direction == "down":
+        delta = H - 1 - max(r for r, _ in payload)
+        return [(r + delta, c) for r, c in payload]
+    if direction == "left":
+        delta = min(c for _, c in payload)
+        return [(r, c - delta) for r, c in payload]
+    delta = W - 1 - max(c for _, c in payload)
+    return [(r, c + delta) for r, c in payload]
