+        _mark_blocked(blocked, room_zone)
+        _mark_blocked(blocked, corridor)
+        return {
+            "direction": direction,
+            "lock_color": lock_color,
+            "key_shape": _canonical(shape),
+            "payload_abs": payload_abs,
+            "door": door,
