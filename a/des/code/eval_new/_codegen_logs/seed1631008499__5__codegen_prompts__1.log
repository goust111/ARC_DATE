+        grid[r0 : r1 + 1, c0] = WALL
+        grid[r0 : r1 + 1, c1] = WALL
+        grid[r0, c0 : c1 + 1] = WALL
+        grid[r1, c0 : c1 + 1] = WALL
+        grid[door] = lock_color
+        for r, c in key_abs:
+            grid[r, c] = KEY
+        for r, c in payload_abs:
+            grid[r, c] = PAYLOAD
