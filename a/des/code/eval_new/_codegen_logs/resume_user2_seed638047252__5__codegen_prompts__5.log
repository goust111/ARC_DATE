+        return [(r, ac) for r in range(ar, br + step, step)]
+    raise ValueError("segment endpoints must share a row or a column")
+
+
+def _l_path_cells(
+    src_center: tuple[int, int], dst_center: tuple[int, int], direction: str
+) -> list[tuple[int, int]]:
+    sr, sc = src_center
+    dr, dc = dst_center
+    if direction == "up":
+        assert dr < sr
+        bend = (dr, sc)
+    elif direction == "down":
+        assert dr > sr
+        bend = (dr, sc)
+    elif direction == "left":
+        assert dc < sc
+        bend = (sr, dc)
+    else:
+        assert direction == "right"
+        assert dc > sc
