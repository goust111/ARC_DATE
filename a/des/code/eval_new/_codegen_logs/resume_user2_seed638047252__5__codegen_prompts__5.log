+def _touches(node_cells: set[tuple[int, int]], comp_cells: set[tuple[int, int]]) -> bool:
+    for r, c in comp_cells:
+        if (r - 1, c) in node_cells or (r + 1, c) in node_cells:
+            return True
+        if (r, c - 1) in node_cells or (r, c + 1) in node_cells:
+            return True
+    return False
