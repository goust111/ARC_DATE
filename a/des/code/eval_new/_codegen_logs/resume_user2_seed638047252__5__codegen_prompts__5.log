+    (0, 1): "right",
+    (1, 1): "down",
+    (1, 0): "left",
+}
+MISSING_FROM_DIR = {v: k for k, v in DIR_FROM_MISSING.items()}
+DIR_DELTA = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+DIR_TO_SIDE = {"up": "top", "down": "bottom", "left": "left", "right": "right"}
+SIDES = ("top", "right", "bottom", "left")
