+        tc = random.choice(tc_choices)
+    elif direction == "down":
+        tr = random.randint(sr + 4, h - 4)
+        tc_choices = [c for c in range(3, w - 3) if c != sc]
+        tc = random.choice(tc_choices)
+    elif direction == "left":
+        tc = random.randint(3, sc - 4)
