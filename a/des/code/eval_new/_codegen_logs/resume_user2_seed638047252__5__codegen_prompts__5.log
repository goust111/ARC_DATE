+            if direction == "down" and _center(cur_box)[0] >= h - 7:
+                continue
+            if direction == "left" and _center(cur_box)[1] <= 6:
+                continue
+            if direction == "right" and _center(cur_box)[1] >= w - 7:
+                continue
