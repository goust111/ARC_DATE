+    dr, dc = dst_center
+    if direction == "up":
+        assert dr < sr
+        bend = (dr, sc)
+    elif direction == "down":
+        assert dr > sr
+        bend = (dr, sc)
+    elif direction == "left":
+        assert dc < sc
+        bend = (sr, dc)
+    else:
+        assert direction == "right"
+        assert dc > sc
+        bend = (sr, dc)
+    first = _segment_cells(src_center, bend)
+    second = _segment_cells(bend, dst_center)
+    return first + second[1:]
