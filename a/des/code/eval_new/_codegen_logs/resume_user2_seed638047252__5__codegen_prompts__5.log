+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in DIR_DELTA.values():
+                    nr, nc = rr + dr, cc + dc
