+                continue
+            candidates.add((nr, nc))
+
+    if not candidates:
+        return None
+    singleton = []
+    for r, c in candidates:
+        color = int(grid[r, c])
+        if all(int(grid[nr, nc]) != color for nr, nc in _neighbors4(r, c, h, w)):
