+    footprint = {(r, c) for r in range(outline_h) for c in range(outline_w)}
+    min_side = max(
+        outline_h + 4,
+        outline_w + 4,
+        int(np.ceil(np.sqrt(obj_count * len(footprint) * 3.0))),
