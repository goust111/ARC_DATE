+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    rows = [r for r in range(sub.shape[0]) if bool(np.all(sub[r, :] == color))]
+    cols = [c for c in range(sub.shape[1]) if bool(np.all(sub[:, c] == color))]
+    if len(rows) < 2 or len(cols) < 2:
