+    board = next(spec for spec in specs if int(spec["nrows"]) == int(spec["ncols"]) and int(spec["nrows"]) >= 2)
+    legend = next(spec for spec in specs if int(spec["nrows"]) == 2 and int(spec["ncols"]) == 3)
