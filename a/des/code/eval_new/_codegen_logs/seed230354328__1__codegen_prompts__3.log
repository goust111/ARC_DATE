+
+def _border_bg(grid: np.ndarray) -> int:
+    corners = np.array([grid[0, 0], grid[0, -1], grid[-1, 0], grid[-1, -1]], dtype=int)
+    vals, cnts = np.unique(corners, return_counts=True)
+    return int(vals[cnts.argmax()])
