+
+def _find_template_size(grid: np.ndarray) -> int:
+    h, w = grid.shape
+    assert h > 0 and w > 0 and int(grid[0, 0]) != BG
+
+    size_row = 0
+    while size_row < w and int(grid[0, size_row]) != BG:
+        size_row += 1
+
+    size_col = 0
