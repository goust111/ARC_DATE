+def _band_starts(start: int, gaps: list[int]) -> list[int]:
+    positions = [int(start)]
+    for gap in gaps:
+        positions.append(int(positions[-1] + 2 + gap))
+    return positions
+
+
+def _build_case(
+    template: np.ndarray,
+    area_r0: int,
+    area_c0: int,
+    h_rows: list[int],
+    v_cols: list[int],
+    h_colors: list[int],
+    v_colors: list[int],
+    grid_shape: tuple[int, int],
