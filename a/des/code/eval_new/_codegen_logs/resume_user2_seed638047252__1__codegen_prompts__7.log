+BG = 0
+FRAME = 5
+RED = 2
+BLUE = 1
+GREEN = 3
+DEPTH_COLORS = {1: RED, 2: BLUE, 3: GREEN}
+SEED_COLORS = (4, 6, 7, 8, 9)
+MAX_SIZE = 30
+GEN_RETRIES = 500
+PLACEMENT_RETRIES = 300
