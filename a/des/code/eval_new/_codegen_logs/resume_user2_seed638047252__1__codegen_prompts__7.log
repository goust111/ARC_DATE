+from __future__ import annotations
+
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+RED = 2
+BLUE = 1
+GREEN = 3
+DEPTH_COLORS = {1: RED, 2: BLUE, 3: GREEN}
+SEED_COLORS = (4, 6, 7, 8, 9)
+MAX_SIZE = 30
+GEN_RETRIES = 500
+PLACEMENT_RETRIES = 300
+
+SEED_SHAPES = (
+    np.array([[1]], dtype=bool),
+    np.array([[1, 1]], dtype=bool),
+    np.array([[1], [1]], dtype=bool),
+    np.array([[1, 1, 1]], dtype=bool),
+    np.array([[1], [1], [1]], dtype=bool),
+    np.array([[1, 1], [1, 0]], dtype=bool),
+    np.array([[1, 1], [0, 1]], dtype=bool),
+    np.array([[1, 0], [1, 1]], dtype=bool),
+    np.array([[0, 1], [1, 1]], dtype=bool),
+)
+
+
+@dataclass
+class FrameInfo:
+    bbox: tuple[int, int, int, int]
+    coords: np.ndarray
+    parent: int | None = None
+    depth: int = 0
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.asarray(cells, dtype=int))
+    return out
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _mask_from_coords(coords: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask
+
+
+def _rect_frame_bbox(coords: np.ndarray) -> tuple[int, int, int, int] | None:
+    box = _bbox(coords)
+    r0, c0, r1, c1 = box
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+    local = _mask_from_coords(coords, box)
+    expected = np.zeros_like(local, dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    if not np.array_equal(local, expected):
+        return None
+    return box
+
+
+def _contains(outer: tuple[int, int, int, int], inner: tuple[int, int, int, int]) -> bool:
+    or0, oc0, or1, oc1 = outer
+    ir0, ic0, ir1, ic1 = inner
+    return or0 < ir0 and oc0 < ic0 and or1 > ir1 and oc1 > ic1
+
+
+def _inside_frame_interior(box: tuple[int, int, int, int], coords: np.ndarray) -> bool:
+    r0, c0, r1, c1 = box
+    return bool(
+        np.all(coords[:, 0] > r0)
+        and np.all(coords[:, 0] < r1)
+        and np.all(coords[:, 1] > c0)
+        and np.all(coords[:, 1] < c1)
+    )
+
+
+def _draw_frame(grid: np.ndarray, bbox: tuple[int, int, int, int], color: int) -> None:
+    r0, c0, r1, c1 = bbox
+    grid[r0 : r1 + 1, c0] = color
+    grid[r0 : r1 + 1, c1] = color
+    grid[r0, c0 : c1 + 1] = color
+    grid[r1, c0 : c1 + 1] = color
+
