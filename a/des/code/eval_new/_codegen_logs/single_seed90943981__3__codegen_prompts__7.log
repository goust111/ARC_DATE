+def _transform_point(r: int, c: int, rot: int, mirror: bool) -> tuple[int, int]:
+    rr, cc = int(r), int(c)
+    if mirror:
+        cc = -cc
+    for _ in range(rot):
+        rr, cc = cc, -rr
+    return (int(rr), int(cc))
