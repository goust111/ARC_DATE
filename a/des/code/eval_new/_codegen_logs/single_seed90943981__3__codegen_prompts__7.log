+    if direction[0] == 0:
+        additions = {(int(center[0] - 1), int(center[1])), (int(center[0] + 1), int(center[1]))}
+    else:
+        additions = {(int(center[0]), int(center[1] - 1)), (int(center[0]), int(center[1] + 1))}
