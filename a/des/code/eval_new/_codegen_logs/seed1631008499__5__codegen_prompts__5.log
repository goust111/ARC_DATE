+def _adjacent_frame_center(pos: tuple[int, int], border_to_center: dict[tuple[int, int], tuple[int, int]]) -> tuple[int, int] | None:
+    r, c = pos
+    centers = {
+        border_to_center[(nr, nc)]
+        for nr, nc in _neighbors4(r, c)
+        if (nr, nc) in border_to_center
+    }
+    if len(centers) == 1:
