+    rectangles: list[tuple[int, int, int, int]] = []
+
+    for _ in range(pair_count):
+        candidates = [
+            (i, j)
+            for i in range(len(regions))
+            for j in range(i + 1, len(regions))
+            if i not in used and j not in used
+        ]
