+            vals, cnts = np.unique(patch, return_counts=True)
+            dominant = int(cnts.max())
+            off_total += int(patch.size - dominant)
+
+    line_coverage = len(sep_rows) * w + len(sep_cols) * h
+    return off_total, -line_coverage, color
+
