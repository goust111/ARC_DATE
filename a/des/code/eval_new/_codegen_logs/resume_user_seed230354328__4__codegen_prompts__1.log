+    best: tuple[tuple[int, int, int], np.ndarray, list[dict], list[dict], dict[int, int]] | None = None
+    hh, ww = g.shape
+    for mask_bits in range(1, 1 << len(candidates)):
+        block_pixels = np.zeros((hh, ww), dtype=bool)
+        holes: list[dict] = []
+        area_sum = 0
+        block_count = 0
