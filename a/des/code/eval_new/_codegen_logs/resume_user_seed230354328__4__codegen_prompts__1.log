+def _paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int) -> None:
+    h, w = patch.shape
+    sub = dst[int(r0) : int(r0) + h, int(c0) : int(c0) + w]
+    mask = patch != int(bg)
+    sub[mask] = patch[mask]
