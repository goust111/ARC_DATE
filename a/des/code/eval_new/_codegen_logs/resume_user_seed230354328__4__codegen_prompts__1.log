+    def dfs(pos: int) -> bool:
+        if pos == len(order):
+            return True
+        si = int(order[pos])
+        for hi in candidates[int(si)]:
+            if int(hi) in used:
+                continue
+            assignment[int(si)] = int(hi)
+            used.add(int(hi))
+            if dfs(int(pos + 1)):
+                return True
+            used.remove(int(hi))
+            del assignment[int(si)]
