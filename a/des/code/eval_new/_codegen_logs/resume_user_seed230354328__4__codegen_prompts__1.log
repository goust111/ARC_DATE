+
+def _components(mask: np.ndarray, connectivity: int) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    nbrs = _NBRS4 if int(connectivity) == 4 else _NBRS8
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
