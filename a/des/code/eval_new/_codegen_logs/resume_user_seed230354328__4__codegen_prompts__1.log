+def _gen_attempt() -> np.ndarray | None:
+    total_holes = int(_RNG.integers(4, 6))
+    n_blocks = int(_RNG.integers(2, min(4, total_holes + 1)))
+
+    palette = list(map(int, _RNG.permutation(10)))
+    bg = int(palette[0])
+    block_colors = palette[1 : 1 + n_blocks]
