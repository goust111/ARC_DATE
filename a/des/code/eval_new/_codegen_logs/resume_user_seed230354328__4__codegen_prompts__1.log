+    candidates: dict[int, list[int]] = {}
+    for si, sprite in enumerate(sprites):
+        fg_mask = sprite["rotated"] != int(bg)
+        exact: list[int] = []
+        loose: list[int] = []
+        for hi, hole in enumerate(holes):
+            if sprite["rotated"].shape != hole["mask"].shape:
+                continue
