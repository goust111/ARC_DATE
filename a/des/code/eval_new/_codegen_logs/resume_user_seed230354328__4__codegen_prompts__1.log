+    _RNG.shuffle(branch_values)
+
+    square_pool = [3, 4, 5]
+    rect_pool = [
+        (2, 3),
+        (3, 2),
+        (2, 4),
+        (4, 2),
+        (2, 5),
+        (5, 2),
+        (3, 4),
+        (4, 3),
