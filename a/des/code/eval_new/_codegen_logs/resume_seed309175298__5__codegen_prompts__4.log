+
+def _rotate_offsets(
+    offsets: Iterable[tuple[int, int]], src_dir: tuple[int, int], dst_dir: tuple[int, int]
+) -> list[tuple[int, int]]:
+    turns = (DIR_INDEX[dst_dir] - DIR_INDEX[src_dir]) % 4
+    out: list[tuple[int, int]] = []
