# === CFG: tunables ===
FRAME_COL = 5                       # frame border color (always gray)
SPRITE_N_RANGE = (3, 6)             # NxN sprite/placeholder size, exclusive upper
GRID_ROWS_RANGE = (2, 4)            # placeholder grid row count, exclusive upper
