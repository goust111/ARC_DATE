+) -> list[tuple[int, int]]:
+    turns = (DIR_INDEX[dst_dir] - DIR_INDEX[src_dir]) % 4
+    out: list[tuple[int, int]] = []
+    for off in offsets:
+        cur = off
+        for _ in range(turns):
+            cur = _rotate_cw(cur)
+        out.append(cur)
+    return out
