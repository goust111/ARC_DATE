from collections import deque
import numpy as np

def parse(rows):
    return np.array([[c=='1' for c in row] for row in rows], dtype=bool)

def neighbors4(r,c,h,w):
    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
        rr,cc=r+dr,c+dc
        if 0<=rr<h and 0<=cc<w:
            yield rr,cc

def connected(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:return False
    h,w=mask.shape
    start=tuple(map(int,pts[0]))
    q=deque([start]); seen={start}
    while q:
        r,c=q.popleft()
        for rr,cc in neighbors4(r,c,h,w):
            if mask[rr,cc] and (rr,cc) not in seen:
                seen.add((rr,cc)); q.append((rr,cc))
    return len(seen)==len(pts)

def touches(mask):
    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

def test(name, rows):
    m=parse(rows)
    c=~m
    print(name, m.shape, connected(m), connected(c), touches(m), touches(c), int(m.sum()))
    print('\\n'.join(rows)); print()

