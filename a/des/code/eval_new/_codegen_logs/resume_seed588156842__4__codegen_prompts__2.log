+        return None
+    if int(occupied[1].sum()) != 1:
+        return None
+    pair = tuple(sorted((int(local[0, 0]), int(local[0, 1]))))
+    target = int(local[1, 0] if occupied[1, 0] else local[1, 1])
+    return pair, target
