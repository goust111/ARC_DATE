+    rr1 = min(grid.shape[0], top + frame_h + 1)
+    cc0 = max(0, left - 1)
+    cc1 = min(grid.shape[1], left + frame_w + 1)
+    occupied[rr0:rr1, cc0:cc1] = True
+
+    pts = np.argwhere(mask)
+    for r, c in pts:
+        grid[top + int(r), left + int(c)] = int(color)
+
