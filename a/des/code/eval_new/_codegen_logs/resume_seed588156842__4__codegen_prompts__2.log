import random
from collections import deque
import numpy as np

def neighbors4(r,c,h,w):
    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
        rr,cc=r+dr,c+dc
        if 0<=rr<h and 0<=cc<w:
            yield rr,cc

def connected(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:
        return False
    h,w=mask.shape
    start=tuple(map(int,pts[0]))
    q=deque([start])
    seen={start}
    while q:
        r,c=q.popleft()
        for rr,cc in neighbors4(r,c,h,w):
            if mask[rr,cc] and (rr,cc) not in seen:
                seen.add((rr,cc)); q.append((rr,cc))
    return len(seen)==len(pts)

def touches(mask):
    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

def gen(h,w,rng):
    area=h*w
    for _ in range(300):
        target=rng.randint(area//3, (2*area)//3)
        used={(rng.randrange(h), rng.randrange(w))}
        covered=set()
        def side_tags(cell):
            r,c=cell
            t=set()
            if r==0:t.add('top')
            if r==h-1:t.add('bottom')
            if c==0:t.add('left')
            if c==w-1:t.add('right')
            return t
        covered |= side_tags(next(iter(used)))
        ok=True
        for step in range(target-1):
            frontier=[]
            for r,c in used:
                for rr,cc in neighbors4(r,c,h,w):
                    if (rr,cc) not in used and (rr,cc) not in frontier:
                        frontier.append((rr,cc))
            rng.shuffle(frontier)
            frontier.sort(key=lambda cell:(-len(side_tags(cell)-covered), rng.random()))
            add=None
            for cell in frontier:
                new=used|{cell}
                mask=np.zeros((h,w),dtype=bool)
                for r,c in new: mask[r,c]=True
                comp=~mask
                if connected(comp) and touches(comp):
                    add=cell;break
            if add is None:
                ok=False;break
            used.add(add); covered |= side_tags(add)
        if not ok:
            continue
        mask=np.zeros((h,w),dtype=bool)
        for r,c in used: mask[r,c]=True
        comp=~mask
        if connected(mask) and connected(comp) and touches(mask) and touches(comp):
            return mask
    return None

rng=random.Random(0)
for dims in [(5,5),(5,6),(6,5),(6,6)]:
    h,w=dims
    ok=0
    for _ in range(20):
        if gen(h,w,rng) is not None:
            ok+=1
    print(dims, ok)
