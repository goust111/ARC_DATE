/bin/bash -lc "python - <<'PY'
import random
from collections import deque
import numpy as np

def neighbors4(r,c,h,w):
    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
        rr,cc=r+dr,c+dc
        if 0<=rr<h and 0<=cc<w:
            yield rr,cc

def connected(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:
        return False
    h,w=mask.shape
    start=tuple(map(int,pts[0]))
    q=deque([start])
    seen={start}
    while q:
        r,c=q.popleft()
        for rr,cc in neighbors4(r,c,h,w):
            if mask[rr,cc] and (rr,cc) not in seen:
                seen.add((rr,cc)); q.append((rr,cc))
    return len(seen)==len(pts)

def touches(mask):
    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

def bfs_path(start, goal, h, w, blocked, rng):
    q=deque([start])
    prev={start:None}
    while q:
        cur=q.popleft()
        if cur==goal:
            break
        nbrs=list(neighbors4(*cur,h,w))
        rng.shuffle(nbrs)
        nbrs.sort(key=lambda p: abs(p[0]-goal[0])+abs(p[1]-goal[1]))
        for nxt in nbrs:
            if nxt"'!=goal and nxt in blocked:
                continue
            if nxt not in prev:
                prev[nxt]=cur
                q.append(nxt)
    if goal not in prev:
        return None
    path=[]
    cur=goal
    while cur is not None:
        path.append(cur)
        cur=prev[cur]
    return path[::-1]

def gen(h,w,rng):
    for _ in range(500):
        top=(0,rng.randint(1,w-2))
        right=(rng.randint(1,h-2),w-1)
        bottom=(h-1,rng.randint(1,w-2))
        left=(rng.randint(1,h-2),0)
        if rng.random()<0.5:
            order=[top,right,bottom,left]
        else:
            order=[top,left,bottom,right]
        used={order[0]}
        ok=True
        for a,b in zip(order, order[1:]):
            path=bfs_path(a,b,h,w,used-{a},rng)
            if path is None:
                ok=False; break
            used.update(path)
        if not ok:
            continue
        # optional grow a few leaves
        for _ in range(rng.randint(0,3)):
            frontier=[]
            for r,c in list(used):
                for rr,cc in neighbors4(r,c,h,w):
                    if (rr,cc) not in used:
                        frontier.append((rr,cc))
            rng.shuffle(frontier)
            added=False
            for cell in frontier:
                new=used|{cell}
                mask=np.zeros((h,w),dtype=bool)
                for r,c in new: mask[r,c]=True
                comp=~mask
                if connected(comp) and touches(comp):
                    used=new; added=True; break
            if not added:
                break
        mask=np.zeros((h,w),dtype=bool)
        for r,c in used: mask[r,c]=True
        comp=~mask
        if connected(mask) and connected(comp) and touches(mask) and touches(comp):
            return mask
    return None

rng=random.Random(0)
for h in range(4,7):
    for w in range(4,7):
        ok=0
        for _ in range(50):
            if gen(h,w,rng) is not None:
                ok+=1
        print((h,w), ok)
