+    positions: list[tuple[int, int]] = []
+    for r in range(h - frame_h + 1):
+        for c in range(w - frame_w + 1):
+            rr0 = max(0, r - 1)
+            rr1 = min(h, r + frame_h + 1)
+            cc0 = max(0, c - 1)
+            cc1 = min(w, c + frame_w + 1)
