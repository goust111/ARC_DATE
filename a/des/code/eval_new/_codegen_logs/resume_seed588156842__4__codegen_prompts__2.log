+def _place_legend(
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    mappings: list[tuple[int, int, int]],
+    rng: random.Random,
+) -> None:
+    entries = mappings[:]
+    rng.shuffle(entries)
+    legend_h = 3 * len(entries) - 1
+    legend_w = 2
+    top = grid.shape[0] - legend_h
+    left = grid.shape[1] - legend_w
+
+    occupied[max(0, top - 1) :, max(0, left - 1) :] = True
+    for idx, (c1, c2, target) in enumerate(entries):
