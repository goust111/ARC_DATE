+def _base_tiles() -> list[np.ndarray]:
+    return [
+        np.array([[1, 0]], dtype=int),
+        np.array([[1], [0]], dtype=int),
+        np.array([[1, 0], [0, 1]], dtype=int),
+        np.array([[0, 1], [1, 0]], dtype=int),
+        np.array([[1, 1, 0], [1, 0, 0]], dtype=int),
+        np.array([[1, 0, 0], [0, 0, 1]], dtype=int),
+        np.array([[1, 0, 1], [0, 1, 0]], dtype=int),
