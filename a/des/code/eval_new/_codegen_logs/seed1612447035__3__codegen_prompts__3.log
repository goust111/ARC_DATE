+def _bands_from_lines(lines: np.ndarray, limit: int) -> list[tuple[int, int]]:
+    bounds = [-1] + sorted(set(map(int, lines))) + [int(limit)]
+    bands: list[tuple[int, int]] = []
+    for a, b in zip(bounds, bounds[1:]):
+        if a + 1 <= b - 1:
+            bands.append((int(a + 1), int(b - 1)))
+    return bands
