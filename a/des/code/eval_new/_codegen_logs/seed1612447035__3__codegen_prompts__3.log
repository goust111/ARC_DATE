+    cells = random.sample(range(h * w), int(count))
+    for idx in cells:
+        r = idx // w
+        c = idx % w
+        room[r, c] = int(marker_color)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    bg_choices = [color for color in ALL_COLORS if color not in (GREY, RED)]
