+def _tile_to_shape(tile: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    h, w = map(int, shape)
+    tile_h, tile_w = map(int, tile.shape)
+    reps_h = (h + tile_h - 1) // tile_h
+    reps_w = (w + tile_w - 1) // tile_w
+    return np.tile(tile, (reps_h, reps_w))[:h, :w]
