+    graph = [set() for _ in blocks]
+    for idx, block in enumerate(blocks):
+        r0, c0 = map(int, block["top_left"])
+        for dr, dc in ((-2, 0), (2, 0), (0, -2), (0, 2)):
+            neighbor = pos_to_idx.get((int(r0 + dr), int(c0 + dc)))
+            if neighbor is not None:
