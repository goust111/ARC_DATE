+    min_w = max(max_final_w + 2, side_hint)
+    if min_h > GRID_SIDE_MAX or min_w > GRID_SIDE_MAX:
+        return None
+
+    height = random.randint(min_h, GRID_SIDE_MAX)
+    width = random.randint(min_w, GRID_SIDE_MAX)
