+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BG_COLOR = 0
+FENCE_COLOR = 5
+SEED_COLORS = tuple(color for color in range(10) if color not in (BG_COLOR, FENCE_COLOR))
+
+GRID_SIDE_MAX = 30
+MAX_GENERATION_ATTEMPTS = 300
+PLACEMENT_RETRIES = 250
