+                        "r0": r0,
+                        "c0": c0,
+                        "r1": r0 + size - 1,
+                        "c1": c0 + size - 1,
+                        "size": size,
+                        "frame_color": frame_color,
+                        "marker_color": marker_color,
+                        "marker": marker,
+                        "side": side,
+                    }
+                )
