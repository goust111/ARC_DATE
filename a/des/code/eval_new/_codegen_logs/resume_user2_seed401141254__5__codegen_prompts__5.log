+def _border_coords(r0: int, c0: int, size: int) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    for c in range(c0, c0 + size):
+        coords.append((r0, c))
+        coords.append((r0 + size - 1, c))
+    for r in range(r0 + 1, r0 + size - 1):
+        coords.append((r, c0))
+        coords.append((r, c0 + size - 1))
