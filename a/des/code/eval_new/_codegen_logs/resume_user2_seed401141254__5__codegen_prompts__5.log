+def _canvas_target(canvas: dict) -> tuple[int, int]:
+    r0 = int(canvas["r0"])
+    c0 = int(canvas["c0"])
+    size = int(canvas["size"])
+    mr, mc = canvas["marker"]
+    side = str(canvas["side"])
+    if side == "top":
+        return r0 + 1, mc
+    if side == "right":
+        return mr, c0 + size - 2
+    if side == "bottom":
+        return r0 + size - 2, mc
