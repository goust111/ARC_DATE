+    grid[r0, c0 : c0 + size] = GEN_FRAME
+    grid[r0 + size - 1, c0 : c0 + size] = GEN_FRAME
+    grid[r0 : r0 + size, c0] = GEN_FRAME
+    grid[r0 : r0 + size, c0 + size - 1] = GEN_FRAME
