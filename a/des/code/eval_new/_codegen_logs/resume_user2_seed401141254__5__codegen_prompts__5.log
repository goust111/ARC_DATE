+ROTATION_K = {"top": 0, "right": 3, "bottom": 2, "left": 1}
+NEIGHBORS_4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+NEIGHBORS_8 = (
+    (1, 0),
+    (-1, 0),
+    (0, 1),
+    (0, -1),
+    (1, 1),
