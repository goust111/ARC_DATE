+        return r0 + 1, mc
+    if side == "right":
+        return mr, c0 + size - 2
+    if side == "bottom":
+        return r0 + size - 2, mc
+    return mr, c0 + 1
+
+
+def _find_canvases(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    candidates: list[dict] = []
+    for size in range(5, min(7, h, w) + 1):
+        for r0 in range(0, h - size + 1):
+            for c0 in range(0, w - size + 1):
