+def _cross_points(tower: dict[str, int]) -> set[tuple[int, int]]:
+    row = tower["row"]
+    col = tower["col"]
+    points = {(row, col)}
+    for step in range(1, tower["up"] + 1):
+        points.add((row - step, col))
+    for step in range(1, tower["down"] + 1):
+        points.add((row + step, col))
+    for step in range(1, tower["left"] + 1):
