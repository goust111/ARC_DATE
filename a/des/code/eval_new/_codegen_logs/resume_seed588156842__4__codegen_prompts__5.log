+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+TOWER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+MAX_GENERATION_ATTEMPTS = 400
+GRID_SIDE_MIN = 16
+GRID_SIDE_MAX = 26
+EXTRA_TOWER_PROB = 0.45
