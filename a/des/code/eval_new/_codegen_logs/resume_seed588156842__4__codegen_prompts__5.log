+        up = _arm_length(grid, color, center_r, center_c, -1, 0)
+        down = _arm_length(grid, color, center_r, center_c, 1, 0)
+        left = _arm_length(grid, color, center_r, center_c, 0, -1)
+        right = _arm_length(grid, color, center_r, center_c, 0, 1)
