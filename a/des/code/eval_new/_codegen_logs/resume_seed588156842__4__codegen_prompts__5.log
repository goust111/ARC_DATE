+def _arm_length(grid: np.ndarray, color: int, row: int, col: int, dr: int, dc: int) -> int:
+    height, width = grid.shape
+    length = 0
+    rr, cc = row + dr, col + dc
+    while 0 <= rr < height and 0 <= cc < width and int(grid[rr, cc]) == color:
+        length += 1
