+def _directional_strength(tower: dict[str, int], row: int, col: int) -> int:
+    vertical = None
+    if row < tower["row"]:
+        vertical = tower["up"]
+    elif row > tower["row"]:
+        vertical = tower["down"]
+
+    horizontal = None
+    if col < tower["col"]:
+        horizontal = tower["left"]
+    elif col > tower["col"]:
