+    for r, c in zip(*np.where(edge_mask)):
+        rr, cc = int(r), int(c)
+        if visited[rr, cc]:
+            continue
+        coords = _collect_mask_component(edge_mask, rr, cc, visited)
+        rows = [p[0] for p in coords]
+        cols = [p[1] for p in coords]
+        r0, r1 = min(rows), max(rows)
+        c0, c1 = min(cols), max(cols)
+        horizontal = r0 == r1
+        vertical = c0 == c1
