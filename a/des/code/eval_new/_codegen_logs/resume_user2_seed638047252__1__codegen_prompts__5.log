  "path": "connect the markers through the center of each door in wall order, using orthogonal corridor segments just before crossing each wall",
  "trajectory": "paint the continuous route with the marker color, including each door center",
  "transform": "preserve walls and non-center door pixels"
}
</annotation>
</reference_puzzle>

