from itertools import product

def patterns(m,n):
    vars=[]
    # horiz shared: between (r,c) and (r,c+1); bit 1 means left cell gets right-notch
    for r in range(m):
        for c in range(n-1):
            vars.append(('h',r,c))
    # vert shared: between (r,c) and (r+1,c); bit 1 means top cell gets down-notch
    for r in range(m-1):
        for c in range(n):
            vars.append(('v',r,c))
    out=[]
    for bits in product([0,1], repeat=len(vars)):
        sides=[[set() for c in range(n)] for r in range(m)]
        for bit,(t,r,c) in zip(bits,vars):
            if t=='h':
                if bit:
                    sides[r][c].add('R')
                else:
                    sides[r][c+1].add('L')
            else:
                if bit:
                    sides[r][c].add('D')
                else:
                    sides[r+1][c].add('U')
        out.append(tuple(tuple(''.join(ch for ch in 'URDL' if ch in sides[r][c]) for c in range(n)) for r in range(m)))
    return out

def canon(s):
    # bitmask on URDL order 0,1,2,3 perhaps
    order='URDL'
    mask=0
    for i,ch in enumerate(order):
        if ch in s: mask|=1<<i
    rots=[]
    for k in range(4):
        # rotate sides cw k times: U->R->D->L
        mp=['U','R','D','L']
        s2=set()
        for ch in s:
            idx=mp.index(ch)
            s2.add(mp[(idx+k)%4])
        rots.append(''.join(ch for ch in order if ch in s2))
    return min(rots)

for m,n in [(2,2),(2,3),(3,2),(3,3)]:
    best=0
    bestp=None
    for pat in patterns(m,n):
        cls=[canon(s) for row in pat for s in row]
        uniq=len(set(cls))
        if uniq>best:
            best=uniq; bestp=pat
    print((m,n), 'max uniq classes', best, 'cells', m*n, 'example', bestp)
