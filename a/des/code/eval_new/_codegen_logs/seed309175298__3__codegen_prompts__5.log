                    else: sides[r][c+1][3]=off
                else:
                    if bit: sides[r][c][2]=off
                    else: sides[r+1][c][0]=off
            cls=[canon(tuple(sides[r][c])) for r in range(m) for c in range(n)]
            best=max(best,len(set(cls)))
    return best
