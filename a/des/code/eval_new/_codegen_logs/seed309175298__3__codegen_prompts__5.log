+    cr0, cc0, cr1, cc1 = crop_box
+    cropped_out = full_out[cr0 : cr1 + 1, cc0 : cc1 + 1].copy()
+    solved = main(cropped_in)
+    if not np.array_equal(solved, cropped_out):
+        return None
+    return cropped_in
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
