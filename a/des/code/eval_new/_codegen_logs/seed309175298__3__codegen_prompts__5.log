+
+BG = 0
+FRAME = 5
+TAB_LEN = 2
+SEP = 2
+OUTER = 1
+CANVAS = 30
+GEN_RETRIES = 400
+LAYOUT_RETRIES = 400
+PLACEMENT_RETRIES = 250
