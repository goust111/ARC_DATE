from itertools import product

def canon(sides):
    # sides: tuple of 4 entries U,R,D,L where each entry in {0,1,2}; 0 none, 1 posA, 2 posB
    # under rotation, side states rotate with positions; A/B remain attached to the side orientation
    rots=[]
    x=sides
    for _ in range(4):
        rots.append(x)
        x=(x[3],x[0],x[1],x[2])
    return min(rots)

def maxuniq(m,n):
    vars=[]
    for r in range(m):
        for c in range(n-1): vars.append(('h',r,c))
    for r in range(m-1):
        for c in range(n): vars.append(('v',r,c))
    best=0
    for bits in product([0,1], repeat=len(vars)):
        for offs in product([1,2], repeat=len(vars)):
