+    min_area = 10 + 6 * hole_count
+
+    for _ in range(SHAPE_RETRIES):
+        h = random.randint(min_side, max_side)
+        w = random.randint(min_side, max_side)
+        mask = np.ones((h, w), dtype=bool)
+        if not _carve_holes(mask, hole_count):
