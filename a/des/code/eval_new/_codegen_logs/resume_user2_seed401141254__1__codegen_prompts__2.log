+        area = int(coords.shape[0])
+        assert area == (r1 - r0 + 1) * (c1 - c0 + 1), "legend swatch must be solid"
+        assert r1 - r0 + 1 >= 2 and c1 - c0 + 1 >= 2, "legend swatch must be at least 2x2"
+        entries.append((c0, r0, color))
