+    blocked[0, :] = True
+    blocked[-1, :] = True
+    blocked[:, 0] = True
+    blocked[:, -1] = True
+    for r0, c0, r1, c1 in frame_boxes:
+        blocked[r0 : r1 + 1, c0 : c1 + 1] = True
