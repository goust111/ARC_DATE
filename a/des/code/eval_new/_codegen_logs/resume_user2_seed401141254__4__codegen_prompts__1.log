+    inner_to_marker: dict[int, int] = {}
+
+    for idx, (rmin, rmax, cmin, cmax) in enumerate(quadrants):
+        size = rng.randint(7, 9)
+        top_lo = rmin
+        top_hi = rmax - size - 1
+        left_lo = cmin
+        left_hi = cmax - size - 1
+        if top_lo > top_hi or left_lo > left_hi:
+            return None
