+    obstacle_cells = [tuple(map(int, cell)) for cell in np.argwhere(grid == OBSTACLE)]
+    for r, c in obstacle_cells:
+        for nr, nc in _neighbors8(r, c):
+            if _in_bounds(grid.shape, nr, nc) and int(grid[nr, nc]) != BG:
+                return False
+    return True
+
