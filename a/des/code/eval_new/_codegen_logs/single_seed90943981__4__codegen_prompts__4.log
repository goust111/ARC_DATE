+        assert comp_set == boundary - set(missing), "grey component must be a rectangular border with one gap"
+        gap = missing[0]
+
+        if gap[0] == r0 and c0 < gap[1] < c1:
+            side = "up"
+        elif gap[0] == r1 and c0 < gap[1] < c1:
+            side = "down"
+        elif gap[1] == c0 and r0 < gap[0] < r1:
+            side = "left"
