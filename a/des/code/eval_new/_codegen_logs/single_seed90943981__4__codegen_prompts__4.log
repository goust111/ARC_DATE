+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+OBSTACLE = 9
+SEED_COLORS = [1, 2, 3, 4, 6, 7, 8]
+SIDES = ("up", "down", "left", "right")
+SIDE_TO_STEP = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+SLOT_DIRS = {
+    "tl": ("up", "left"),
+    "tr": ("up", "right"),
+    "bl": ("down", "left"),
+    "br": ("down", "right"),
+}
+GRID_MIN = 20
+GRID_MAX = 30
+SLOT_MIN = 9
+MAX_ATTEMPTS = 300
