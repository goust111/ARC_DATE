 217: def _two_turn_vhv_path(start, mid_r, end):
 218:     _, sc = start
 219:     _, ec = end
 220:     corner1 = (mid_r, sc)
 221:     corner2 = (mid_r, ec)
 222:     return (
 223:         _axis_path(start, corner1)
 224:         + _axis_path(corner1, corner2)[1:]
 225:         + _axis_path(corner2, end)[1:]
 226:     )
