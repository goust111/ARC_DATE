 392:             marker = (r + mdr, c + mdc)
 393:             for dr, dc in pattern:
 394:                 rr, cc = _rot(dr, dc, kind)
 395:                 rr, cc = r + rr, c + cc
 396:                 if (rr, cc) != marker:
 397:                     inp[rr, cc] = base[rr, cc]
