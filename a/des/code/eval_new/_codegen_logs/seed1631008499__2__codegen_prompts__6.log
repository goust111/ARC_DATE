 229: def _two_turn_hvh_path(start, mid_c, end):
 230:     sr, _ = start
 231:     er, _ = end
 232:     corner1 = (sr, mid_c)
 233:     corner2 = (er, mid_c)
 234:     return (
 235:         _axis_path(start, corner1)
 236:         + _axis_path(corner1, corner2)[1:]
 237:         + _axis_path(corner2, end)[1:]
