  93: def main(grid: np.ndarray) -> np.ndarray:
  94:     """
  95:     Complete a four-corner framed rectangle from one decorated anchor rectangle and its diagonal mate.
  96: 
  97:     Input structure:
  98:     - The background is the dominant color.
  99:     - Two same-color solid rectangular anchors of the same size sit on opposite
 100:       diagonal corners, with the first anchor above-left of the second.
 101:     - The upper-left anchor has two one-cell-thick vertical control bars to its
 102:       right and two one-cell-thick horizontal control bars below it.
 103: 
 104:     Rule:
 105:     - Copy the anchor rectangle into the two missing corners of the implied
 106:       larger rectangle.
 107:     - Repeat the right-side control bars horizontally between the left and right
 108:       anchors, using their spacing as the period, and draw the outer top and
 109:       bottom borders in the first right-control color.
 110:     - Repeat the below-side control bars vertically between the top and bottom
 111:       anchors, using the same period, and draw the outer left and right borders
 112:       in the first below-control color.
 113: 
 114:     Key insight: The small control bars are the first two ticks of two periodic
 115:     frame patterns; the diagonal anchor supplies the opposite corner and the
 116:     missing two anchor copies.
 117:     """
 118:     g = np.asarray(grid, dtype=int)
 119:     bg = get_bg(g)
 120:     source, dest, right_controls, below_controls = _find_structure(g, bg)
 121: 
 122:     sr0, sc0, sr1, sc1 = source["bbox"]
 123:     dr0, dc0, dr1, dc1 = dest["bbox"]
 124:     anchor_color = int(source["color"])
 125:     assert int(dest["color"]) == anchor_color, "anchor colors must match"
 126:     assert bbox_h(source["bbox"]) == bbox_h(dest["bbox"]), "anchor heights must match"
 127:     assert bbox_w(source["bbox"]) == bbox_w(dest["bbox"]), "anchor widths must match"
 128:     assert sr0 > 0 and sc0 > 0, "upper-left anchor must have space for outer frame"
 129:     assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], "lower-right anchor must have space for outer frame"
 130: 
 131:     right_offsets = [int(comp["bbox"][1] - sc1) for comp in right_controls]
 132:     below_offsets = [int(comp["bbox"][0] - sr1) for comp in below_controls]
 133:     assert right_offsets == below_offsets and right_offsets[0] == 1, "control offsets must match from the anchor edge"
 134:     step = int(right_offsets[1] - right_offsets[0])
 135:     assert step > 0, "control bars must be separated"
 136:     period = 2 * step
 137:     assert (dc0 - 1 - sc1 - right_offsets[0]) % period == 0, "right frame must close next to the destination anchor"
 138:     assert (dr0 - 1 - sr1 - below_offsets[0]) % period == 0, "below frame must close next to the destination anchor"
 139: 
 140:     right_colors = [int(comp["color"]) for comp in right_controls]
 141:     below_colors = [int(comp["color"]) for comp in below_controls]
 142:     out = g.copy()
 143: 
 144:     _paint_rect(out, bg, sr0, dc0, sr1, dc1, anchor_color)
 145:     _paint_rect(out, bg, dr0, sc0, dr1, sc1, anchor_color)
 146: 
 147:     first_c = int(sc1 + right_offsets[0])
 148:     last_c = int(dc0 - 1)
 149:     for c in range(first_c, last_c + 1):
 150:         offset = int(c - sc1)
 151:         if (offset - right_offsets[0]) % period == 0:
 152:             color = right_colors[0]
 153:         elif (offset - right_offsets[1]) % period == 0:
 154:             color = right_colors[1]
 155:         else:
 156:             continue
 157:         _paint_rect(out, bg, sr0, c, sr1, c, color)
 158:         _paint_rect(out, bg, dr0, c, dr1, c, color)
 159: 
 160:     _paint_rect(out, bg, sr0 - 1, first_c, sr0 - 1, last_c, right_colors[0])
 161:     _paint_rect(out, bg, dr1 + 1, first_c, dr1 + 1, last_c, right_colors[0])
 162: 
 163:     first_r = int(sr1 + below_offsets[0])
 164:     last_r = int(dr0 - 1)
 165:     left_c = int(sc0 - 1)
 166:     right_c = int(dc1 + 1)
 167:     for r in range(first_r, last_r + 1):
 168:         _paint(out, bg, r, left_c, below_colors[0])
 169:         _paint(out, bg, r, right_c, below_colors[0])
 170: 
 171:         offset = int(r - sr1)
 172:         if (offset - below_offsets[0]) % period == 0:
 173:             _paint_rect(out, bg, r, left_c, r, sc1, below_colors[0])
 174:             _paint_rect(out, bg, r, dc0, r, right_c, below_colors[0])
 175:         elif (offset - below_offsets[1]) % period == 0:
 176:             _paint_rect(out, bg, r, sc0, r, sc1, below_colors[1])
 177:             _paint_rect(out, bg, r, dc0, r, dc1, below_colors[1])
 178: 
 179:     return out
 180: 
 181: # --------------- generator (att2, o5x) ---------------
 182: 
 183: # Color sampling.
 184: COLOR_COUNT, NON_BG_COLOR_COUNT = 10, 4
 185: 
 186: # Anchor/repetition geometry.
 187: ANCHOR_SIZE_RANGE = (1, 5)
 188: REPEAT_COUNT_RANGE = (2, 5)
 189: CONTROL_OFFSETS = (1, 3)
 190: FRAME_PERIOD, DEST_ANCHOR_GAP, STRUCTURE_FIXED_PAD = 4, 2, 3
 191: 
 192: # Canvas/margins.
 193: CANVAS_MIN_SIZE, CANVAS_MAX_SIZE = 16, 30
 194: MARGIN_CHOICES = range(4)
 195: MIN_TOTAL_MARGIN, SOURCE_OUTER_MARGIN = 1, 1
 196: 
 197: # Retry.
 198: MAX_GENERATION_ATTEMPTS = 300
 199: 
 200: 
 201: def _gen_paint_rect(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int, color: int) -> None:
 202:     grid[r0 : r1 + 1, c0 : c1 + 1] = int(color)
 203: 
 204: 
 205: def _choose_margins(struct_len: int) -> tuple[int, int]:
 206:     pairs = [
 207:         (before, after)
 208:         for before in MARGIN_CHOICES
 209:         for after in MARGIN_CHOICES
 210:         if MIN_TOTAL_MARGIN <= before + after
 211:         and CANVAS_MIN_SIZE <= struct_len + before + after <= CANVAS_MAX_SIZE
 212:     ]
 213:     return pairs[int(np.random.randint(len(pairs)))]
 214: 
 215: 
 216: def _build_output(
 217:     rows: int,
 218:     cols: int,
 219:     bg: int,
 220:     anchor_color: int,
 221:     right1: int,
 222:     right2: int,
 223:     below1: int,
 224:     sr0: int,
 225:     sc0: int,
 226:     s: int,
 227:     nh: int,
 228:     nv: int,
 229: ) -> tuple[np.ndarray, tuple[int, int, int, int, int, int, int, int]]:
 230:     out = np.full((rows, cols), int(bg), dtype=int)
 231:     sr1, sc1 = sr0 + s - 1, sc0 + s - 1
 232:     dr0 = sr1 + FRAME_PERIOD * nv + DEST_ANCHOR_GAP
 233:     dc0 = sc1 + FRAME_PERIOD * nh + DEST_ANCHOR_GAP
 234:     dr1, dc1 = dr0 + s - 1, dc0 + s - 1
 235: 
 236:     for r0, c0 in ((sr0, sc0), (sr0, dc0), (dr0, sc0), (dr0, dc0)):
 237:         _gen_paint_rect(out, r0, c0, r0 + s - 1, c0 + s - 1, anchor_color)
 238: 
 239:     first_c, last_c = sc1 + CONTROL_OFFSETS[0], dc0 - 1
 240:     for c in range(first_c, last_c + 1):
 241:         offset = c - sc1
 242:         if (offset - CONTROL_OFFSETS[0]) % FRAME_PERIOD == 0:
 243:             color = right1
 244:         elif (offset - CONTROL_OFFSETS[1]) % FRAME_PERIOD == 0:
 245:             color = right2
 246:         else:
 247:             continue
 248:         _gen_paint_rect(out, sr0, c, sr1, c, color)
 249:         _gen_paint_rect(out, dr0, c, dr1, c, color)
 250:     _gen_paint_rect(out, sr0 - 1, first_c, sr0 - 1, last_c, right1)
 251:     _gen_paint_rect(out, dr1 + 1, first_c, dr1 + 1, last_c, right1)
 252: 
 253:     first_r, last_r = sr1 + CONTROL_OFFSETS[0], dr0 - 1
 254:     left_c, right_c = sc0 - 1, dc1 + 1
 255:     for r in range(first_r, last_r + 1):
 256:         out[r, left_c] = below1
 257:         out[r, right_c] = below1
 258:         offset = r - sr1
 259:         if (offset - CONTROL_OFFSETS[0]) % FRAME_PERIOD == 0:
 260:             _gen_paint_rect(out, r, left_c, r, sc1, below1)
 261:             _gen_paint_rect(out, r, dc0, r, right_c, below1)
 262:         elif (offset - CONTROL_OFFSETS[1]) % FRAME_PERIOD == 0:
 263:             _gen_paint_rect(out, r, sc0, r, sc1, right2)
 264:             _gen_paint_rect(out, r, dc0, r, dc1, right2)
 265: 
 266:     return out, (sr0, sc0, sr1, sc1, dr0, dc0, dr1, dc1)
 267: 
 268: 
 269: def _derive_input(
 270:     out: np.ndarray,
 271:     bg: int,
 272:     sr0: int,
 273:     sc0: int,
 274:     sr1: int,
 275:     sc1: int,
 276:     dr0: int,
 277:     dc0: int,
 278:     dr1: int,
 279:     dc1: int,
 280: ) -> np.ndarray:
 281:     keep = np.zeros(out.shape, dtype=bool)
 282:     keep[sr0 : sr1 + 1, sc0 : sc1 + 1] = True
 283:     keep[dr0 : dr1 + 1, dc0 : dc1 + 1] = True
 284:     keep[sr0 : sr1 + 1, sc1 + CONTROL_OFFSETS[0]] = True
 285:     keep[sr0 : sr1 + 1, sc1 + CONTROL_OFFSETS[1]] = True
 286:     keep[sr1 + CONTROL_OFFSETS[0], sc0 : sc1 + 1] = True
 287:     keep[sr1 + CONTROL_OFFSETS[1], sc0 : sc1 + 1] = True
 288: 
 289:     inp = np.full_like(out, int(bg))
 290:     inp[keep] = out[keep]
 291:     return inp
 292: 
 293: 
 294: def _gen_attempt() -> np.ndarray | None:
 295:     bg = int(np.random.randint(COLOR_COUNT))
 296:     palette = [color for color in range(COLOR_COUNT) if color != bg]
 297:     anchor_color, right1, right2, below1 = map(
 298:         int, np.random.choice(palette, NON_BG_COLOR_COUNT, replace=False)
 299:     )
 300: 
 301:     s = int(np.random.randint(ANCHOR_SIZE_RANGE[0], ANCHOR_SIZE_RANGE[1]))
 302:     nh = int(np.random.randint(REPEAT_COUNT_RANGE[0], REPEAT_COUNT_RANGE[1]))
 303:     nv = int(np.random.randint(REPEAT_COUNT_RANGE[0], REPEAT_COUNT_RANGE[1]))
 304:     struct_h = 2 * s + FRAME_PERIOD * nv + STRUCTURE_FIXED_PAD
 305:     struct_w = 2 * s + FRAME_PERIOD * nh + STRUCTURE_FIXED_PAD
 306: 
 307:     top, bottom = _choose_margins(struct_h)
 308:     left, right = _choose_margins(struct_w)
 309:     rows, cols = struct_h + top + bottom, struct_w + left + right
 310:     sr0, sc0 = top + SOURCE_OUTER_MARGIN, left + SOURCE_OUTER_MARGIN
 311: 
 312:     out, box = _build_output(
 313:         rows,
 314:         cols,
 315:         bg,
 316:         anchor_color,
 317:         right1,
 318:         right2,
 319:         below1,
 320:         sr0,
 321:         sc0,
 322:         s,
 323:         nh,
 324:         nv,
 325:     )
 326:     inp = _derive_input(out, bg, *box)
 327: 
 328:     try:
 329:         if np.array_equal(main(inp), out):
 330:             return inp
 331:     except Exception:
 332:         return None
 333:     return None
 334: 
 335: 

 336: def generate_input() -> np.ndarray:
 337:     for _ in range(MAX_GENERATION_ATTEMPTS):
 338:         grid = _gen_attempt()
 339:         if grid is not None:
 340:             return grid
