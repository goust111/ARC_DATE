 245: def _find_path(start, end, occupied):
 246:     """Find an L-shaped path (0-2 turns) from start to end avoiding occupied cells."""
 247:     sr, sc = start
 248:     er, ec = end
 249: 
 250:     if sr == er or sc == ec:
 251:         path = _axis_path(start, end)
 252:         if _path_is_free(path, occupied):
 253:             return path
 254: 
 255:     corners = [(sr, ec), (er, sc)]
 256:     random.shuffle(corners)
 257:     for corner in corners:
 258:         path = _one_turn_path(start, corner, end)
 259:         if _path_is_free(path, occupied):
 260:             return path
 261: 
 262:     for _ in range(MAX_TWO_TURN_TRIES):
 263:         if sr != er and sc != ec:
 264:             mid_r = random.randint(min(sr, er), max(sr, er))
 265:             path = _two_turn_vhv_path(start, mid_r, end)
 266:             if _path_is_free(path, occupied):
 267:                 return path
 268: 
 269:             mid_c = random.randint(min(sc, ec), max(sc, ec))
 270:             path = _two_turn_hvh_path(start, mid_c, end)
 271:             if _path_is_free(path, occupied):
 272:                 return path
 273: 
 274:     return None
