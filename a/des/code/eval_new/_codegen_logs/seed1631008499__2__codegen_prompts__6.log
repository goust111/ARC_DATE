 291: def _ordered_path(coords: np.ndarray) -> list[tuple[int, int]] | None:
 292:     cells = {tuple(map(int, rc)) for rc in coords}
 293:     nbrs: dict[tuple[int, int], list[tuple[int, int]]] = {}
 294:     for r, c in cells:
 295:         here = [(rr, cc) for rr, cc in neighbors4(r, c) if (rr, cc) in cells]
 296:         if len(here) > 2:
 297:             return None
 298:         nbrs[(r, c)] = here
 299: 
 300:     endpoints = [cell for cell, here in nbrs.items() if len(here) == 1]
 301:     if len(cells) == 1 or len(endpoints) != 2:
 302:         return None
 303: 
 304:     path = [endpoints[0]]
 305:     prev: tuple[int, int] | None = None
 306:     cur = endpoints[0]
 307:     while cur != endpoints[1]:
 308:         nxts = [cell for cell in nbrs[cur] if cell != prev]
 309:         if not nxts:
 310:             return None
 311:         prev, cur = cur, nxts[0]
 312:         path.append(cur)
 313:         if len(path) > len(cells):
 314:             return None
 315:     return path if len(path) == len(cells) else None
