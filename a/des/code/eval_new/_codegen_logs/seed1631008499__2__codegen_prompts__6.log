 357: def _place_frame_bboxes(n_frames, frame_size, grid_h, grid_w):
 358:     """Place non-overlapping frame boxes in clockwise angular order."""
 359:     center_r = grid_h / 2
 360:     center_c = grid_w / 2
 361: 
 362:     base_angles = [2 * math.pi * i / n_frames for i in range(n_frames)]
 363:     angle_perturb = [random.uniform(*ANGLE_PERTURB_RANGE) for _ in range(n_frames)]
 364:     angles = [base_angles[i] + angle_perturb[i] for i in range(n_frames)]
 365:     angles.sort()
 366: 
 367:     min_radius = frame_size + MIN_RADIUS_PAD
 368:     max_radius = min(grid_h, grid_w) / 2 - frame_size / 2 - MAX_RADIUS_PAD
 369:     if max_radius < min_radius:
 370:         return None
 371: 
 372:     frame_bboxes = []
 373:     for angle in angles:
 374:         radius = random.uniform(min_radius, max_radius)
 375:         fr = center_r + radius * math.sin(angle) - frame_size / 2
 376:         fc = center_c + radius * math.cos(angle) - frame_size / 2
 377:         fr = int(round(fr))
 378:         fc = int(round(fc))
 379:         fr = max(0, min(grid_h - frame_size, fr))
 380:         fc = max(0, min(grid_w - frame_size, fc))
 381:         frame_bboxes.append((fr, fc, fr + frame_size - 1, fc + frame_size - 1))
 382: 
 383:     for i in range(n_frames):
 384:         for j in range(i + 1, n_frames):
 385:             if _frame_bboxes_overlap(frame_bboxes[i], frame_bboxes[j]):
 386:                 return None
 387: 
 388:     for r0, c0, r1, c1 in frame_bboxes:
 389:         if r0 < 0 or c0 < 0 or r1 >= grid_h or c1 >= grid_w:
 390:             return None
 391:     return frame_bboxes
