 190:     grid = np.full((H, W), BACKGROUND_COLOR, dtype=int)
 191:     for i, (start_r, end_c) in enumerate(zip(start_rows, end_cols)):
 192:         min_first_col = end_cols[i + 1] + ENDPOINT_SPACING if i + 1 < n_walls else MIN_FIRST_STAIR_COL
 193:         cells = _stair_path_lb(H, W, start_r, end_c, min_first_col)
 194:         if cells is None or not _paint_wall_path(grid, cells):
 195:             return None
