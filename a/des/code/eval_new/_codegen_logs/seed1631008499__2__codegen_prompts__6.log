  22:     assert g.ndim == 2
  23:     h, w = g.shape
  24:     assert h % 2 == 1 and w % 2 == 1
  25: 
  26:     cr, cc = h // 2, w // 2
  27:     bg = int(get_bg(g))
  28: 
  29:     marker_color = int(g[cr, cc])
  30:     assert marker_color != bg
  31:     marker_mask = g == marker_color
  32:     expected_markers = np.zeros(g.shape, dtype=bool)
  33:     expected_markers[cr, 0] = True
  34:     expected_markers[cr, cc] = True
  35:     expected_markers[cr, w - 1] = True
  36:     assert np.array_equal(marker_mask, expected_markers)
  37: 
  38:     center_col = g[:, cc]
  39:     divider_colors = {int(color) for color in np.unique(center_col) if int(color) != marker_color}
  40:     assert len(divider_colors) == 1
  41:     divider_color = next(iter(divider_colors))
  42:     assert divider_color != bg
  43:     expected_divider = np.zeros(g.shape, dtype=bool)
  44:     expected_divider[:, cc] = True
  45:     expected_divider[cr, cc] = False
  46:     assert np.array_equal(g == divider_color, expected_divider)
