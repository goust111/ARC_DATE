 184: def _build_lower_left_grid(H: int, W: int, n_walls: int) -> np.ndarray | None:
 185:     endpoints = _choose_endpoints(H, W, n_walls)
 186:     if endpoints is None:
 187:         return None
 188:     start_rows, end_cols = endpoints
