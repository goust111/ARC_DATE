 124: def _split_positive(total: int, parts: int) -> list[int]:
 125:     if parts == 1:
 126:         return [int(total)]
 127:     cuts = sorted(random.sample(range(1, int(total)), int(parts) - 1))
 128:     return [b - a for a, b in zip([0] + cuts, cuts + [int(total)])]
