 151: def _sample_layout(max_height, groups):
 152:     """Sample gaps, heights, margins, and positioned bar columns."""
 153:     n_bars = sum(len(group["colors"]) for group in groups)
 154:     right_margin = random.randint(0, MAX_RIGHT_MARGIN)
 155: 
 156:     gap_count = len(groups) - 1
 157:     if gap_count:
 158:         max_gap_sum = MAX_WIDTH - right_margin - MIN_BAR_HEIGHT * n_bars
 159:         gap_options = _bounded_tuples(GAP_VALUES, gap_count, max_gap_sum)
 160:         if not gap_options:
 161:             return None
 162:         gaps = list(random.choice(gap_options))
 163:     else:
 164:         gaps = []
 165: 
 166:     height_options = _bounded_tuples(
 167:         tuple(range(MIN_BAR_HEIGHT, max_height + 1)),
 168:         n_bars,
 169:         MAX_WIDTH - right_margin - sum(gaps),
 170:     )
 171:     if not height_options:
 172:         return None
 173:     heights = list(random.choice(height_options))
 174: 
 175:     idx = 0
 176:     for group in groups:
 177:         count = len(group["colors"])
 178:         group["heights"] = heights[idx : idx + count]
 179:         idx += count
 180: 
 181:     span = sum(heights) + sum(gaps)
 182:     min_left = max(0, MIN_WIDTH - right_margin - span)
 183:     max_left = MAX_WIDTH - right_margin - span
 184:     if min_left > max_left:
 185:         return None
 186:     if min_left <= min(MAX_RANDOM_LEFT_MARGIN, max_left):
 187:         left_margin = random.randint(min_left, min(MAX_RANDOM_LEFT_MARGIN, max_left))
 188:     else:
 189:         left_margin = min_left
 190: 
 191:     width = left_margin + span + right_margin
 192:     if not (MIN_WIDTH <= width <= MAX_WIDTH):
 193:         return None
 194: 
 195:     bars = []
 196:     col = left_margin
 197:     gap_i = 0
 198:     for group_i, group in enumerate(groups):
 199:         chained = group["kind"] == "chain"
 200:         for color, height in zip(group["colors"], group["heights"]):
 201:             bars.append(
 202:                 {
 203:                     "color": color,
 204:                     "height": height,
 205:                     "col": col,
 206:                     "chained": chained,
 207:                 }
 208:             )
 209:             col += height
 210:         if group_i + 1 < len(groups):
 211:             col += gaps[gap_i]
 212:             gap_i += 1
 213: 
 214:     if col + right_margin != width:
 215:         return None
 216:     return bars, width
 217: 
