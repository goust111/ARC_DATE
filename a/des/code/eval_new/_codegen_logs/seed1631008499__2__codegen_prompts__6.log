 103: MIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3
 104: MIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9
 105: MIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2
 106: 
 107: # Layout padding and retry budget.
