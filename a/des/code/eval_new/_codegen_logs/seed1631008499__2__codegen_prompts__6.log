 219: def _render_pair(rows, width, bars):
 220:     """Render the sampled input grid and its expected transformed output."""
 221:     baseline = rows - 1
 222:     inp = np.zeros((rows, width), dtype=int)
 223:     out = np.zeros_like(inp)
 224:     for bar in bars:
 225:         color, height, col = bar["color"], bar["height"], bar["col"]
 226:         vertical = slice(baseline - height + 1, baseline + 1)
 227:         inp[vertical, col] = color
 228:         if bar["chained"]:
 229:             out[baseline, col : col + height] = color
 230:         else:
 231:             out[vertical, col] = color
 232:     return inp, out
 233: 
 234: 
 235: def _passes_oracle(inp, expected):
 236:     """Return whether the solver accepts and matches the rendered output."""
 237:     try:
 238:         actual = main(inp)
 239:     except Exception:
 240:         return False
 241:     return np.array_equal(actual, expected)
