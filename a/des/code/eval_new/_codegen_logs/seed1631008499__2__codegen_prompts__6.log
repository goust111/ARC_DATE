 181: def _random_corner_path(h: int, w: int) -> np.ndarray:
 182:     starts = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]
 183:     sr, sc = random.choice(starts)
 184:     er, ec = h - 1 - sr, w - 1 - sc
 185:     moves = [(1 if er > sr else -1, 0)] * (h - 1)
 186:     moves += [(0, 1 if ec > sc else -1)] * (w - 1)
 187:     random.shuffle(moves)
 188: 
 189:     mask = np.zeros((h, w), dtype=bool)
 190:     r, c = sr, sc
 191:     mask[r, c] = True
 192:     for dr, dc in moves:
 193:         r += dr
 194:         c += dc
 195:         mask[r, c] = True
 196:     return mask
 197: 
