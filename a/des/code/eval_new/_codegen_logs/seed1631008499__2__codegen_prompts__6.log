 131: def _spaced_combos(values: list[int], n: int) -> list[tuple[int, ...]]:
 132:     return [
 133:         combo
 134:         for combo in itertools.combinations(values, n)
 135:         if all(combo[i + 1] - combo[i] >= ENDPOINT_SPACING for i in range(len(combo) - 1))
 136:     ]
