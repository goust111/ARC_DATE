 325: def _validate_wall_paths(wall_lab: np.ndarray, n_walls: int, H: int, W: int) -> bool:
 326:     for wall_id in range(1, n_walls + 1):
 327:         coords = np.argwhere(wall_lab == wall_id)
 328:         if not _contains(WALL_LENGTH_RANGE, len(coords)):
 329:             return False
 330:         path = _ordered_path(coords)
 331:         if path is None:
 332:             return False
 333:         endpoints = [path[0], path[-1]]
 334:         if not all(r in (0, H - 1) or c in (0, W - 1) for r, c in endpoints):
 335:             return False
 336:         turns = _turn_count(path)
 337:         if not _contains(WALL_TURN_RANGE, turns):
 338:             return False
 339:     return True
