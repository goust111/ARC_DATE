 270: def _transform(grid: np.ndarray) -> np.ndarray:
 271:     op = random.randrange(TRANSFORM_OPS)
 272:     if op == 0:
 273:         out = grid
 274:     elif op == 1:
 275:         out = np.rot90(grid, 1)
 276:     elif op == 2:
 277:         out = np.rot90(grid, 2)
 278:     elif op == 3:
 279:         out = np.rot90(grid, 3)
 280:     elif op == 4:
 281:         out = np.fliplr(grid)
 282:     elif op == 5:
 283:         out = np.flipud(grid)
 284:     elif op == 6:
 285:         out = grid.T
 286:     else:
 287:         out = np.fliplr(grid).T
 288:     return np.ascontiguousarray(out)
