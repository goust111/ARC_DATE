 240: def _split_total(total: int, parts: int) -> list[int]:
 241:     """Partition `total` non-negative units into `parts` bins uniformly at random."""
 242:     if parts == 1:
 243:         return [total]
 244:     cuts = sorted(random.sample(range(total + parts - 1), parts - 1))
 245:     out, prev = [], -1
 246:     for cut in cuts + [total + parts - 1]:
 247:         out.append(cut - prev - 1)
 248:         prev = cut
 249:     return out
