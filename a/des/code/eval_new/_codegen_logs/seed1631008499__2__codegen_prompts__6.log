 112: def _chain_red_distributions(n_blue, n_red):
 113:     """Return all red-count allocations across blue-started chains."""
 114:     return [c for c in itertools.product(range(MAX_CHAIN_RED_PER_BLUE + 1), repeat=n_blue) if sum(c) == n_red]
