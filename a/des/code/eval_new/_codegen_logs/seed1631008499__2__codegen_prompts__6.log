 249: 
 250:     layout = _sample_layout(max_height, groups)
 251:     if layout is None:
 252:         return None
 253:     bars, width = layout
 254: 
 255:     inp, expected = _render_pair(rows, width, bars)
 256:     if not _passes_oracle(inp, expected):
 257:         return None
 258:     return inp
