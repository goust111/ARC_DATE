 199: def _choose_lr_corridors(H: int, n_walls: int) -> tuple[tuple[int, int], ...] | None:
 200:     intervals = []
 201:     for lo in range(1, H - 2):
 202:         for hi in range(lo + 1, min(H - 2, lo + LR_CORRIDOR_MAX_SPAN) + 1):
 203:             intervals.append((lo, hi))
 204:     valid: list[tuple[tuple[int, int], ...]] = []
 205:     for combo in itertools.combinations(intervals, n_walls):
 206:         if all(combo[i][1] + LR_CORRIDOR_GAP <= combo[i + 1][0] for i in range(n_walls - 1)):
 207:             valid.append(combo)
