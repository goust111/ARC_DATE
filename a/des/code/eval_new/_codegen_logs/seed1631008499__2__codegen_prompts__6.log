 342: def _build_region_graph(wall_lab, bg_lab, n_walls: int, n_regions: int, H: int, W: int):
 343:     """Connect background-region labels separated by each wall component."""
 344:     graph: dict[int, set[int]] = defaultdict(set)
 345:     edges: set[tuple[int, int]] = set()
 346:     for wall_id in range(1, n_walls + 1):
 347:         adjacent: set[int] = set()
 348:         for r, c in np.argwhere(wall_lab == wall_id):
 349:             for rr, cc in neighbors4(int(r), int(c)):
 350:                 if 0 <= rr < H and 0 <= cc < W:
 351:                     region_id = int(bg_lab[rr, cc])
 352:                     if region_id > 0:
 353:                         adjacent.add(region_id)
 354:         if len(adjacent) != 2:
 355:             return None
 356:         a, b = sorted(adjacent)
 357:         graph[a].add(b)
 358:         graph[b].add(a)
 359:         edges.add((a, b))
 360: 
 361:     if len(edges) != n_walls:
 362:         return None
 363:     if set(graph) != set(range(1, n_regions + 1)):
 364:         return None
 365:     if any(len(graph[k]) > 2 for k in graph):
 366:         return None
 367:     return graph
