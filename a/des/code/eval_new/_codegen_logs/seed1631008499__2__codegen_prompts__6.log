 122: def _sample_groups():
 123:     """Sample row count and bar groups before physical layout."""
 124:     rows = random.randint(MIN_ROWS, MAX_ROWS)
 125:     max_height = min(MAX_BAR_HEIGHT, rows)
 126:     n_blue = random.randint(MIN_BLUE_BARS, MAX_BLUE_BARS)
 127:     max_red = min(MAX_RED_BARS, MAX_TOTAL_BARS - n_blue, MAX_CHAIN_RED_PER_BLUE * n_blue + MAX_UNCHAINED_RED)
 128:     red_total = random.randint(MIN_RED_BARS, max_red)
 129:     min_unchained = max(0, red_total - MAX_CHAIN_RED_PER_BLUE * n_blue)
 130:     max_unchained = min(MAX_UNCHAINED_RED, red_total)
 131:     n_unchained = random.randint(min_unchained, max_unchained)
 132: 
 133:     distributions = _chain_red_distributions(n_blue, red_total - n_unchained)
 134:     if not distributions:
 135:         return None
 136: 
 137:     groups = [
 138:         {"kind": "chain", "colors": [MARKER_COLOR] + [BODY_COLOR] * n_red}
 139:         for n_red in random.choice(distributions)
 140:     ]
 141:     groups.extend({"kind": "unchained", "colors": [BODY_COLOR]} for _ in range(n_unchained))
 142:     random.shuffle(groups)
 143:     if groups[0]["kind"] == "unchained":
 144:         for i, group in enumerate(groups):
 145:             if group["kind"] == "chain":
 146:                 groups[0], groups[i] = groups[i], groups[0]
 147:                 break
 148:     return rows, max_height, groups
