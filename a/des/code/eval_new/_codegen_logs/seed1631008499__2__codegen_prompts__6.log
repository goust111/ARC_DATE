 204: def _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:
 205:     """5x5 cardinal legend. Canonical direction: (0, +1) right."""
 206:     g = np.full((5, 5), fill, dtype=int)
 207:     g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2
 208:     g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2
 209:     rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}
 210:     return np.rot90(g, rot[(dr, dc)])
 211: 
 212: 
 213: def _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:
 214:     """6x7 diagonal legend. Canonical direction: (+1, +1) down-right."""
 215:     g = np.full((6, 7), fill, dtype=int)
 216:     g[1, 3] = 1
 217:     g[2, 1] = 1; g[2, 4] = 1
 218:     g[3, 2] = 1; g[3, 5] = 2
 219:     g[4, 3] = 2
 220:     if (dr, dc) == (1, 1): return g
 221:     if (dr, dc) == (-1, 1): return np.flipud(g)
 222:     if (dr, dc) == (1, -1): return np.fliplr(g)
 223:     if (dr, dc) == (-1, -1): return np.rot90(g, 2)
 224:     raise ValueError((dr, dc))
 225: 
 226: 
 227: def _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:
 228:     """Top-left coordinate for a patch placed at the given grid corner."""
 229:     if corner == 'TL': return 0, 0
 230:     if corner == 'TR': return 0, w - pw
 231:     if corner == 'BL': return h - ph, 0
 232:     if corner == 'BR': return h - ph, w - pw
 233:     raise ValueError(corner)
 234: 
