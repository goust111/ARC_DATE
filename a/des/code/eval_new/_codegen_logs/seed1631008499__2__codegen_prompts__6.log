 318: def _turn_count(path: list[tuple[int, int]]) -> int:
 319:     dirs = []
 320:     for (r0, c0), (r1, c1) in zip(path, path[1:]):
 321:         dirs.append((int(np.sign(r1 - r0)), int(np.sign(c1 - c0))))
 322:     return sum(a != b for a, b in zip(dirs, dirs[1:]))
