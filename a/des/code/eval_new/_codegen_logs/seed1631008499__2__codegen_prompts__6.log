 202: def _axis_path(start, end):
 203:     """Return an inclusive straight segment between row- or column-aligned cells."""
 204:     sr, sc = start
 205:     er, ec = end
 206:     if sr == er:
 207:         step = 1 if ec > sc else -1
 208:         return [(sr, c) for c in range(sc, ec + step, step)]
 209:     step = 1 if er > sr else -1
 210:     return [(r, sc) for r in range(sr, er + step, step)]
 211: 
