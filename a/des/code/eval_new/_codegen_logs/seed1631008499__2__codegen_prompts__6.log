 370: def _region_parity(graph: dict[int, set[int]], start_region: int, n_regions: int) -> dict[int, int] | None:
 371:     parity = {start_region: 0}
 372:     queue = deque([start_region])
 373:     while queue:
 374:         region = queue.popleft()
 375:         for neighbor in graph[region]:
 376:             want = 1 - parity[region]
 377:             if neighbor in parity:
 378:                 if parity[neighbor] != want:
 379:                     return None
 380:             else:
 381:                 parity[neighbor] = want
 382:                 queue.append(neighbor)
 383:     if set(parity) != set(range(1, n_regions + 1)):
 384:         return None
 385:     return parity
