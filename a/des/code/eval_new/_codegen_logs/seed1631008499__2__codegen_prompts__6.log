 152: def _stair_path_lb(H: int, W: int, start_r: int, end_c: int, min_first_col: int) -> list[tuple[int, int]] | None:
 153:     down = H - 1 - int(start_r)
 154:     right = int(end_c)
 155:     max_parts = min(MAX_STAIR_PARTS, down, right)
 156:     feasible = [k for k in range(1, max_parts + 1) if right >= int(min_first_col) + k - 1]
 157:     if not feasible:
 158:         return None
 159:     weights = [k * k for k in feasible]
 160:     k = random.choices(feasible, weights=weights, k=1)[0]
 161: 
 162:     if k == 1:
 163:         horiz = [right]
 164:     else:
 165:         first = random.randint(int(min_first_col), right - (k - 1))
 166:         horiz = [first] + _split_positive(right - first, k - 1)
 167:     vert = _split_positive(down, k)
 168: 
 169:     r, c = int(start_r), 0
 170:     cells = [(r, c)]
 171:     for h_run, v_run in zip(horiz, vert):
 172:         for _ in range(h_run):
 173:             c += 1
 174:             cells.append((r, c))
 175:         for _ in range(v_run):
 176:             r += 1
 177:             cells.append((r, c))
 178: 
 179:     if (r, c) != (H - 1, int(end_c)):
 180:         return None
 181:     return cells
