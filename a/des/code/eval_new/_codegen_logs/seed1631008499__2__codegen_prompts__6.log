 211: def _lr_path(W: int, lo: int, hi: int) -> list[tuple[int, int]] | None:
 212:     short_turn, long_turn = LR_TURN_OPTIONS
 213:     turn_goal = random.choice(LR_TURN_OPTIONS)
 214:     if turn_goal == long_turn and W - 1 < long_turn:
 215:         turn_goal = short_turn
 216: 
 217:     if turn_goal == short_turn:
 218:         h1 = random.randint(1, W - 2)
 219:         horiz = [h1, W - 1 - h1]
 220:         r0, r1 = random.sample(range(lo, hi + 1), 2)
 221:         rows = [r0, r1]
 222:     else:
 223:         if hi - lo >= 2:
 224:             if random.random() < 0.5:
 225:                 rows = [lo, random.randint(lo + 1, hi - 1), hi]
 226:             else:
 227:                 rows = [hi, random.randint(lo + 1, hi - 1), lo]
 228:             middle_min = 1
 229:         else:
 230:             rows = [lo, hi, lo] if random.random() < 0.5 else [hi, lo, hi]
 231:             middle_min = 2
 232:         if W - 1 < middle_min + 2:
 233:             return None
 234:         h2 = random.randint(middle_min, W - 3)
 235:         h1 = random.randint(1, W - 1 - h2 - 1)
 236:         horiz = [h1, h2, W - 1 - h1 - h2]
 237: 
 238:     r, c = int(rows[0]), 0
 239:     cells = [(r, c)]
 240:     for i, h_run in enumerate(horiz):
 241:         for _ in range(h_run):
 242:             c += 1
 243:             cells.append((r, c))
 244:         if i < len(rows) - 1:
 245:             target = int(rows[i + 1])
 246:             step = 1 if target > r else -1
 247:             while r != target:
 248:                 r += step
 249:                 cells.append((r, c))
 250: 
 251:     if c != W - 1:
 252:         return None
 253:     if not _contains(WALL_LENGTH_RANGE, len(cells)):
 254:         return None
 255:     return cells
