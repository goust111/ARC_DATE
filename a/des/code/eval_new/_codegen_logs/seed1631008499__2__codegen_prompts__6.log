 394: def _gen_clockwise_order(frame_bboxes):
 395:     """Return frame indexes sorted by angle around their shared centroid."""
 396:     n_frames = len(frame_bboxes)
 397:     centers = [((r0 + r1) / 2, (c0 + c1) / 2) for r0, c0, r1, c1 in frame_bboxes]
 398:     mean_r = sum(c[0] for c in centers) / n_frames
 399:     mean_c = sum(c[1] for c in centers) / n_frames
 400:     cw_angles = [math.atan2(c[0] - mean_r, c[1] - mean_c) for c in centers]
 401: 
 402:     sorted_angles = sorted(enumerate(cw_angles), key=lambda x: x[1])
 403:     angle_vals = [a for _, a in sorted_angles]
 404:     for i in range(len(angle_vals) - 1):
 405:         if abs(angle_vals[i + 1] - angle_vals[i]) < ANGLE_EPS:
 406:             return None, None
 407:     return [idx for idx, _ in sorted_angles], centers
