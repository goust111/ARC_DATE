+GRID_MAX = 30
+ROOM_HEIGHT_RANGE = (6, 10)
+ROOM_WIDTH_RANGE = (6, 10)
+MAX_SEEDS_PER_ROOM = 5
+GENERATE_ATTEMPTS = 400
+ROOM_PLACEMENT_ATTEMPTS = 200
+SEED_LAYOUT_ATTEMPTS = 80
+
