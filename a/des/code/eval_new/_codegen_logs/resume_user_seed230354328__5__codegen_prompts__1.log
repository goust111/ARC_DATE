+
+
+BACKGROUND = 0
+SIDES = ("top", "bottom", "left", "right")
+SIDE_STEPS = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+# Generator configuration.
+GRID_MIN = 18
+GRID_MAX = 30
