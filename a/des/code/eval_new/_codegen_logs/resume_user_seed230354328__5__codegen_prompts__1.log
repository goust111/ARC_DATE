+def _draw_room(
+    grid: np.ndarray,
+    r0: int,
+    c0: int,
+    height: int,
+    width: int,
+    wall_color: int,
+    gaps: dict[str, int],
+    seed_cells: list[tuple[int, int]],
+    seed_color: int,
+) -> None:
+    r1 = r0 + height - 1
+    c1 = c0 + width - 1
+    grid[r0, c0 : c1 + 1] = wall_color
+    grid[r1, c0 : c1 + 1] = wall_color
+    grid[r0 : r1 + 1, c0] = wall_color
+    grid[r0 : r1 + 1, c1] = wall_color
