+
+def _expected_from_specs(grid: np.ndarray, specs: list[dict]) -> np.ndarray:
+    out = grid.copy()
+    for spec in specs:
+        for r, c in spec["branch"]:
+            out[r, c] = spec["seed_color"]
+    return out
+
