+import numpy as np
+
+
+BACKGROUND = 0
+SIDES = ("top", "bottom", "left", "right")
+SIDE_STEPS = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+# Generator configuration.
+GRID_MIN = 18
+GRID_MAX = 30
+ROOM_HEIGHT_RANGE = (6, 10)
+ROOM_WIDTH_RANGE = (6, 10)
+MAX_SEEDS_PER_ROOM = 5
+GENERATE_ATTEMPTS = 400
+ROOM_PLACEMENT_ATTEMPTS = 200
