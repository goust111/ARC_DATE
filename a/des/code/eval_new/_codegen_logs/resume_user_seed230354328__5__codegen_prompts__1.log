+
+
+def _dominant_side(seed_coords: np.ndarray, room: dict) -> str:
+    r0, c0, r1, c1 = room["bbox"]
+    rows = seed_coords[:, 0].astype(float)
+    cols = seed_coords[:, 1].astype(float)
+    scores = {
