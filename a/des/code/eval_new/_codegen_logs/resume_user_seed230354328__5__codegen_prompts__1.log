+            safety = _dilate_cells(footprint, grid_h, grid_w, radius=1)
+            if footprint & reserved or safety & reserved:
+                continue
+
+            reserved.update(safety)
+            specs.append(
+                {
+                    "r0": int(r0),
+                    "c0": int(c0),
+                    "height": int(height),
+                    "width": int(width),
+                    "wall_color": int(wall_color),
+                    "gaps": gaps,
+                    "seed_cells": seed_cells,
+                    "seed_color": int(seed_color),
+                    "side": side,
+                    "branch": branch,
+                }
+            )
