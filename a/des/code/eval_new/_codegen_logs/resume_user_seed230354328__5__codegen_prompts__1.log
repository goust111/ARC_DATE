+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    """Return 4-connected components of a boolean mask."""
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((int(cr), int(cc)))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+
+    return comps
+
+
+def _room_from_component(
+    grid: np.ndarray, wall_color: int, coords: list[tuple[int, int]]
+) -> dict | None:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    if height < 4 or width < 4:
+        return None
+
+    if not np.all(grid[r0 + 1 : r1, c0 + 1 : c1] != wall_color):
+        return None
+
+    corners = ((r0, c0), (r0, c1), (r1, c0), (r1, c1))
+    if any(int(grid[r, c]) != wall_color for r, c in corners):
+        return None
+
+    top_gaps = [c for c in range(c0 + 1, c1) if int(grid[r0, c]) != wall_color]
+    bottom_gaps = [c for c in range(c0 + 1, c1) if int(grid[r1, c]) != wall_color]
+    left_gaps = [r for r in range(r0 + 1, r1) if int(grid[r, c0]) != wall_color]
+    right_gaps = [r for r in range(r0 + 1, r1) if int(grid[r, c1]) != wall_color]
+    if not (len(top_gaps) == len(bottom_gaps) == len(left_gaps) == len(right_gaps) == 1):
+        return None
+
+    if int(grid[r0, top_gaps[0]]) != BACKGROUND:
+        return None
+    if int(grid[r1, bottom_gaps[0]]) != BACKGROUND:
+        return None
+    if int(grid[left_gaps[0], c0]) != BACKGROUND:
+        return None
+    if int(grid[right_gaps[0], c1]) != BACKGROUND:
+        return None
+
+    expected_cells: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        expected_cells.add((r0, c))
+        expected_cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        expected_cells.add((r, c0))
+        expected_cells.add((r, c1))
+    expected_cells.remove((r0, top_gaps[0]))
+    expected_cells.remove((r1, bottom_gaps[0]))
+    expected_cells.remove((left_gaps[0], c0))
+    expected_cells.remove((right_gaps[0], c1))
+
+    if set(coords) != expected_cells:
+        return None
+
+    return {
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "wall_color": int(wall_color),
+        "gaps": {
+            "top": (int(r0), int(top_gaps[0])),
+            "bottom": (int(r1), int(bottom_gaps[0])),
+            "left": (int(left_gaps[0]), int(c0)),
+            "right": (int(right_gaps[0]), int(c1)),
+        },
+    }
+
+
+def _extract_rooms(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    rooms: list[dict] = []
+    for color in map(int, np.unique(g)):
+        if color == BACKGROUND:
