+            continue
+
+        count = random.randint(2, min(MAX_SEEDS_PER_ROOM, len(pool)))
+        chosen = random.sample(pool, count)
+
+        if side in ("top", "bottom"):
+            if len({c for _r, c in chosen}) < min(2, count):
+                continue
+        else:
+            if len({r for r, _c in chosen}) < min(2, count):
+                continue
