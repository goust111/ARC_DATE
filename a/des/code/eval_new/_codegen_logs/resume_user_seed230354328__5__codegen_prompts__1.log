+    cols = seed_coords[:, 1].astype(float)
+    scores = {
+        "top": float(np.mean(rows - (r0 + 1))),
+        "bottom": float(np.mean((r1 - 1) - rows)),
+        "left": float(np.mean(cols - (c0 + 1))),
+        "right": float(np.mean((c1 - 1) - cols)),
