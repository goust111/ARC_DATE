+        "bottom": random.randint(1, width - 2),
+        "left": random.randint(1, height - 2),
+        "right": random.randint(1, height - 2),
+    }
+
+
+def _branch_path(
+    r0: int,
+    c0: int,
+    height: int,
+    width: int,
+    gaps: dict[str, int],
+    side: str,
+    length: int,
+) -> list[tuple[int, int]]:
