+def _room_from_bbox(
+    grid: np.ndarray, wall_color: int, r0: int, c0: int, r1: int, c1: int
+) -> dict | None:
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    if height < 4 or width < 4:
+        return None
+
+    interior = grid[r0 + 1 : r1, c0 + 1 : c1]
+    if not np.all(interior != wall_color):
+        return None
+
+    corners = ((r0, c0), (r0, c1), (r1, c0), (r1, c1))
