+def _oracle_output(
+    inp: np.ndarray,
+    bg: int,
+    palette_mask: np.ndarray,
+    palette_colors: list[int],
+    records: list[dict],
+) -> np.ndarray:
+    out = inp.copy()
+    out[palette_mask] = bg
+    for rec in records:
