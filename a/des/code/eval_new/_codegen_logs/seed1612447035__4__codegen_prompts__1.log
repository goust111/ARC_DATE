+    for frame in frames:
+        r0, c0, r1, c1 = frame["bbox"]
+        color = int(palette[int(frame["depth"]) - 1])
+        out[r0 : r1 + 1, c0] = color
+        out[r0 : r1 + 1, c1] = color
+        out[r0, c0 : c1 + 1] = color
+        out[r1, c0 : c1 + 1] = color
+
+    for frame in frames:
+        if frame["children"]:
+            continue
+        r0, c0, r1, c1 = frame["bbox"]
+        color = int(palette[int(frame["depth"]) - 1])
