+
+    h = random.randint(max(12, min_h), 30)
+    w = random.randint(max(12, min_w), 30)
+    top = random.randint(1, h - used_h - 1)
+    if palette_on_left:
+        left = random.randint(2, w - used_w - 1)
+    else:
+        left = random.randint(1, w - used_w - 2)
