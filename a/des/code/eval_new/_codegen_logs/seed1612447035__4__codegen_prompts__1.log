+def _draw_node(
+    grid: np.ndarray,
+    node: _GenNode,
+    r0: int,
+    c0: int,
+    depth: int,
+    records: list[dict],
+) -> None:
+    r1 = r0 + node.h - 1
+    c1 = c0 + node.w - 1
+    grid[r0 : r1 + 1, c0] = node.border_color
+    grid[r0 : r1 + 1, c1] = node.border_color
+    grid[r0, c0 : c1 + 1] = node.border_color
+    grid[r1, c0 : c1 + 1] = node.border_color
