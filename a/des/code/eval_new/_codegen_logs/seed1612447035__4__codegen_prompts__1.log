+def _pack_roots(roots: list[_GenNode], palette_on_left: bool) -> tuple[int, int, list[tuple[int, int]]] | None:
+    count = len(roots)
+    order = roots[:]
+    random.shuffle(order)
+    roots[:] = order
+    orient = random.choice(["h", "v"])
+    gaps = [random.randint(2, 4) for _ in range(max(0, count - 1))]
