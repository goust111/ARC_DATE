+from __future__ import annotations
+
+from dataclasses import dataclass, field
+import random
+
+import numpy as np
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, cnts = np.unique(grid, return_counts=True)
+    return int(vals[cnts.argmax()])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((int(rr), int(cc)))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _is_rect_frame(coords: list[tuple[int, int]]) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    expected = 2 * (h + w) - 4
+    if len(coords) != expected:
+        return False
+    pts = set(coords)
+    for r in range(r0, r1 + 1):
+        if (r, c0) not in pts or (r, c1) not in pts:
+            return False
+    for c in range(c0, c1 + 1):
+        if (r0, c) not in pts or (r1, c) not in pts:
+            return False
+    for r, c in pts:
+        if r not in {r0, r1} and c not in {c0, c1}:
+            return False
+    return True
+
+
+def _find_frames(grid: np.ndarray, bg: int) -> list[dict]:
+    frames: list[dict] = []
+    for color in np.unique(grid):
+        color = int(color)
+        if color == bg:
+            continue
+        for comp in _components(grid == color):
+            if not _is_rect_frame(comp):
+                continue
+            r0, c0, r1, c1 = _bbox(comp)
+            frames.append(
+                {
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int((r1 - r0 + 1) * (c1 - c0 + 1)),
+                    "children": [],
+                    "parent": None,
+                    "depth": 1,
+                }
+            )
+    return frames
+
+
+def _contains(outer: tuple[int, int, int, int], inner: tuple[int, int, int, int]) -> bool:
+    or0, oc0, or1, oc1 = outer
+    ir0, ic0, ir1, ic1 = inner
+    return or0 < ir0 and oc0 < ic0 and ir1 < or1 and ic1 < oc1
+
+
+def _annotate_depths(frames: list[dict]) -> None:
+    for frame in frames:
+        containers = [other for other in frames if other is not frame and _contains(other["bbox"], frame["bbox"])]
+        if containers:
+            parent = min(containers, key=lambda item: item["area"])
+            frame["parent"] = parent
+            parent["children"].append(frame)
+
+    def depth_of(frame: dict) -> int:
+        if frame["parent"] is None:
+            return 1
+        if frame["depth"] != 1:
+            return int(frame["depth"])
+        frame["depth"] = depth_of(frame["parent"]) + 1
+        return int(frame["depth"])
+
+    for frame in frames:
+        frame["depth"] = 1
+    for frame in frames:
+        depth_of(frame)
+
+
+def _find_palette(grid: np.ndarray, bg: int, min_len: int) -> tuple[np.ndarray, list[int]]:
+    h, w = grid.shape
+    candidates: list[tuple[int, int, int, int, list[int]]] = []
+    for comp in _components(grid != bg):
+        r0, c0, r1, c1 = _bbox(comp)
+        if c0 != c1:
+            continue
+        if len(comp) != r1 - r0 + 1:
+            continue
+        if c0 not in {0, w - 1}:
+            continue
+        if r0 != 0 and r1 != h - 1:
