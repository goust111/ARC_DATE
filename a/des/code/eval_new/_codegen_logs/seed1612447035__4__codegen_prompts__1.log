  "type": "symmetry/pattern",
  "src": "two same-color solid rectangular anchors, with two right control bars and two below control bars beside the upper-left anchor",
  "dst": "the missing two anchor corners and periodic frame segments between all four anchors",
  "transform": "copy the anchor rectangle into the missing corners; repeat the right-control colors across the top and bottom anchor rows and outer borders, and repeat the below-control colors down the left and right side bars using the same spacing"
}
</annotation>
