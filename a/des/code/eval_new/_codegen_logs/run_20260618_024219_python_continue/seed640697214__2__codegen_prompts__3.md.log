]


def add(a, b): return (a[0] + b[0], a[1] + b[1])
def sub(a, b): return (a[0] - b[0], a[1] - b[1])
def mul(a, k): return (a[0] * k, a[1] * k)

def neighbors4(rc):
    r,c = rc
    for dr,dc in DIRS.values():
        yield (r+dr,c+dc)

def turn_block(endpoint, din, dout):
    entry_side = OPP[din]
    for corner in CORNERS:
        if entry_side in corner and dout in corner:
            off_in = corner[entry_side]
            block = sub(endpoint, off_in)
            off_out = corner[dout]
            q = add(block, off_out)
            return block, q
    raise ValueError((endpoint, din, dout))


def in_channel_bounds(rc, H, W):
    r,c=rc
    return 1 <= r <= H-2 and 1 <= c <= W-2


def block_cells(block):
