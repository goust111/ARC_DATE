+
+def _count_paths(
+    graph: dict[tuple[int, int], set[tuple[int, int]]],
+    start: tuple[int, int],
+    end: tuple[int, int],
+    limit: int = 2,
+) -> tuple[int, list[tuple[int, int]] | None]:
+    count = 0
+    found_path = None
+    stack: list[tuple[tuple[int, int], list[tuple[int, int]]]] = [(start, [start])]
+    while stack:
+        node, path = stack.pop()
+        if node == end:
+            count += 1
+            found_path = path
+            if count >= limit:
+                return count, None
+            continue
+        for neighbor in graph[node]:
+            if neighbor in path:
+                continue
+            stack.append((neighbor, path + [neighbor]))
