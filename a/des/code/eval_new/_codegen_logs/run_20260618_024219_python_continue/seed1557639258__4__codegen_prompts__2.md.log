+def _background_color(grid: np.ndarray) -> int:
+    g = np.asarray(grid, dtype=int)
+    corners = [int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]
+    corner_counts = Counter(corners)
+    color, count = corner_counts.most_common(1)[0]
+    if count >= 3:
