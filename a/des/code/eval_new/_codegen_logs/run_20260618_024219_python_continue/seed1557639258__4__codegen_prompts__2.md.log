+    cols = [int(c) for _r, c in cells]
+    return int(min(rows)), int(min(cols)), int(max(rows)), int(max(cols))
+
+
+def _normalize_shape(cells: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
