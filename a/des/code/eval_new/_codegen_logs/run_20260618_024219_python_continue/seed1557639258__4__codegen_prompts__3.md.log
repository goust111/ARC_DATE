+        rel_points = obj["points"]  # type: ignore[index]
+        transformed = _transform_points(rel_points, ops_by_color[color])
+        for dr, dc in transformed:
+            rr = int(anchor_r) + int(dr)
+            cc = int(anchor_c) + int(dc)
