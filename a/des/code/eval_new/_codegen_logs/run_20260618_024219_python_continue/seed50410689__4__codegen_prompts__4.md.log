+def _split_units(rng: np.random.Generator, total: int, parts: int) -> list[int]:
+    if parts == 1:
+        return [total]
+    cuts = sorted(rng.choice(np.arange(total + parts - 1), size=parts - 1, replace=False).tolist())
+    out: list[int] = []
+    prev = -1
+    for cut in cuts + [total + parts - 1]:
+        out.append(cut - prev - 1)
+        prev = cut
+    return out
+
