+    base = [1, 2, 2, 2, 1]
+    min_width = 4 * 3 + sum(base)
+    assert width >= min_width
+    extra = width - min_width
+    bonus = _split_units(rng, extra, len(base))
+    left = base[0] + bonus[0]
+    gaps = [base[i + 1] + bonus[i + 1] for i in range(3)]
