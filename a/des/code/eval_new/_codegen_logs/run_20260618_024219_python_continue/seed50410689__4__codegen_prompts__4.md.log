+        if len(comp) != border_cells:
+            continue
+        inner_side = side_h - 2
+        if inner_side % 3:
+            continue
+        corners = _container_corner_positions(r0, c0, r1, c1)
+        anchor = [name for name, (rr, cc) in corners.items() if int(g[rr, cc]) == MAROON]
+        if len(anchor) != 1:
+            continue
+        frames.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "inner_side": inner_side,
+                "anchor": anchor[0],
+            }
+        )
