+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not mask[r, c]:
+                continue
+            seen[r, c] = True
+            stack = [(r, c)]
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(comp)
+    return out
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _inside(r: int, c: int, shape: tuple[int, int]) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _template_anchor_positions(r0: int, c0: int, r1: int, c1: int) -> dict[str, tuple[int, int]]:
+    return {
+        "TL": (r0 - 1, c0),
+        "TR": (r0 - 1, c1),
+        "BL": (r1 + 1, c0),
+        "BR": (r1 + 1, c1),
+    }
+
+
+def _container_corner_positions(r0: int, c0: int, r1: int, c1: int) -> dict[str, tuple[int, int]]:
+    return {
+        "TL": (r0 + 1, c0 + 1),
+        "TR": (r0 + 1, c1 - 1),
+        "BL": (r1 - 1, c0 + 1),
+        "BR": (r1 - 1, c1 - 1),
+    }
