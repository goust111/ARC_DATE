+
+    run_set = set(run)
+    for r, c in run:
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if not (0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1]):
