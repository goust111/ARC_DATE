+
+def _is_hollow_rectangle(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    if h < 4 or w < 4:
+        return False
+
+    expected = np.zeros_like(mask, dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    return np.array_equal(mask, expected)
+
