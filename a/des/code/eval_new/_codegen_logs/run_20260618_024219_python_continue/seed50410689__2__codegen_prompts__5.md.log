+def _reserve_cells(occupied: np.ndarray, cells: Iterable[tuple[int, int]]) -> None:
+    for r, c in cells:
+        r0 = max(0, r - 1)
+        r1 = min(occupied.shape[0], r + 2)
+        c0 = max(0, c - 1)
+        c1 = min(occupied.shape[1], c + 2)
+        occupied[r0:r1, c0:c1] = True
