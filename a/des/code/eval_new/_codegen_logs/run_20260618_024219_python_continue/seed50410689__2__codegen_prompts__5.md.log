+
+def _corner_legend_candidate(
+    grid: np.ndarray,
+    bg: int,
+    start_row: int,
+    step: int,
+    col: int,
+    min_len: int = 4,
+) -> list[tuple[int, int]] | None:
+    h, _w = grid.shape
