+    cargo_row = frame_r1 - 1
+    cargo_colors = [
+        int(grid[cargo_row, c])
+        for c in range(frame_c0 + 1, frame_c1)
+        if int(grid[cargo_row, c]) != bg
+    ]
+    if not cargo_colors:
