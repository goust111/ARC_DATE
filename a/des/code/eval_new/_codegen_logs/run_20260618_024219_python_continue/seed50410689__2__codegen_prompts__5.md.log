+
+def _reserve_bbox(occupied: np.ndarray, r: int, c: int, h: int, w: int) -> None:
+    r0 = max(0, r - 1)
+    r1 = min(occupied.shape[0], r + h + 1)
+    c0 = max(0, c - 1)
+    c1 = min(occupied.shape[1], c + w + 1)
+    occupied[r0:r1, c0:c1] = True
