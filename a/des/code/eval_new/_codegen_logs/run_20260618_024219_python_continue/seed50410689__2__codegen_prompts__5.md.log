+        ordered = sorted(cargo_colors, key=lambda color: priority[color], reverse=reverse)
+
+        out[cargo_row, frame_c0 + 1 : frame_c1] = bg
+        out[cargo_row, frame_c0 + 1 : frame_c0 + 1 + len(ordered)] = ordered
