+        if not ok:
+            return None
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    if np.array_equal(out, grid):
+        return None
+    if not np.any(grid == GREY):
+        return None
+    if not np.any(out == ORANGE):
+        return None
+    if len(_find_emitters(grid)) < 2:
+        return None
+    return grid
+
