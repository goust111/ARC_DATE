+from __future__ import annotations
+
+import heapq
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+ORANGE = 7
+MAROON = 9
+EMITTER_COLORS = [1, 2, 3, 4, 6, 8]
