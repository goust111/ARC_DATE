+            left = random.choice([prism_col - 1, prism_col])
+            box[bottom - 1 : bottom + 1, left : left + 2] = MAROON
+        else:
+            box[random.randint(0, row - 1), prism_col] = GREY
+
+        down_kind = random.choice(["absorber", "prism"])
