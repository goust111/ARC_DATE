+            marked_arms[0]: first_color,
+            marked_arms[1]: second_color,
+        }
+        if len(marked_arms) == 3:
+            color_by_arm[marked_arms[2]] = random.choice((first_color, second_color))
+        for arm, color in color_by_arm.items():
