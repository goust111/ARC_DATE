+                assert len(cur_neighbors) == 2, "non-node pipe cells must have degree 2"
+                nxt = cur_neighbors[0] if cur_neighbors[1] == prev else cur_neighbors[1]
+                link = tuple(sorted((cur, nxt)))
+                visited.add(link)
+                path.append(nxt)
+                prev, cur = cur, nxt
