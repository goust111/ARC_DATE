+def _read_legend(grid: np.ndarray, bg: int, pipe_color: int) -> list[int]:
+    h, w = grid.shape
+    border = []
+    for r in range(h):
+        for c in range(w):
+            if r not in (0, h - 1) and c not in (0, w - 1):
