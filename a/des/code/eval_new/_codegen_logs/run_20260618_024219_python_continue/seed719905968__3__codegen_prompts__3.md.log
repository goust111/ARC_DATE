+
+
+def _can_place_patch(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int) -> bool:
+    h, w = patch.shape
+    gh, gw = grid.shape
+    if r0 < 0 or c0 < 0 or r0 + h > gh or c0 + w > gw:
+        return False
+    rr0 = max(0, r0 - 1)
