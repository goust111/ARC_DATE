+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDES = ["top", "bottom", "left", "right"]
+GEN_RETRIES = 400
+EMPTY = -1
+
+
+def _most_common(values) -> int:
+    return int(Counter(int(v) for v in values).most_common(1)[0][0])
+
+
+def _bbox(cells):
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components(mask: np.ndarray):
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            parts.append(cells)
+    return parts
+
+
+def _shape_color(grid: np.ndarray, bg: int) -> int:
+    vals = [int(v) for v in grid.flatten() if int(v) != bg]
+    assert vals, "expected foreground pixels"
+    return _most_common(vals)
+
+
+def _rotate_point(point, shape, k: int):
+    r, c = point
+    h, w = shape
+    if k == 0:
+        return (r, c), (h, w)
+    if k == 1:
+        return (w - 1 - c, r), (w, h)
+    if k == 2:
+        return (h - 1 - r, w - 1 - c), (h, w)
+    return (c, h - 1 - r), (w, h)
+
+
+def _rotate_points(points, shape, k: int):
+    rotated = []
+    new_shape = shape
+    for point in points:
+        rp, new_shape = _rotate_point(point, shape, k)
+        rotated.append(rp)
+    return rotated, new_shape
+
