+    if k == 1:
+        return (w - 1 - c, r), (w, h)
+    if k == 2:
+        return (h - 1 - r, w - 1 - c), (h, w)
+    return (c, h - 1 - r), (w, h)
+
+
+def _rotate_points(points, shape, k: int):
+    rotated = []
+    new_shape = shape
+    for point in points:
