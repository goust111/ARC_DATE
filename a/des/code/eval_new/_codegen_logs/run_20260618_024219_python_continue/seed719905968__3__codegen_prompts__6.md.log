+    grid[:map_h, :] = map_grid
+
+    chamber_top = map_h
+    chamber_bottom = total_h - 2
+    grid[chamber_top : chamber_bottom + 1, 1 : width - 2] = bg
+    grid[:, width - 1] = wall
+    grid[chamber_top:, width - 2] = wall
+    grid[total_h - 1, :] = wall
+
+    for idx, length in enumerate(legend_lengths):
+        r = chamber_top + 1 + 2 * idx
