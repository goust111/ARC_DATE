+from __future__ import annotations
+
+from collections import defaultdict, deque
+import random
+
+import numpy as np
+
+
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+ARC_COLORS = tuple(range(10))
+GEN_RETRIES = 600
+MIN_SIDE_CHOICES = (2, 3)
+REGION_COUNT_RANGE = (5, 9)
+MAIN_INNER_H_RANGE = (10, 15)
+GRID_W_RANGE = (18, 26)
+LEGEND_LENGTH_COUNT_RANGE = (3, 4)
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _label_components(mask: np.ndarray) -> tuple[np.ndarray, list[list[tuple[int, int]]]]:
+    h, w = mask.shape
+    labels = np.zeros((h, w), dtype=int)
+    components: list[list[tuple[int, int]]] = []
+    label = 0
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] != 0:
+                continue
+            label += 1
+            labels[r, c] = label
+            queue = deque([(r, c)])
+            coords = [(r, c)]
+            while queue:
+                cr, cc = queue.popleft()
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and labels[nr, nc] == 0:
+                        labels[nr, nc] = label
+                        queue.append((nr, nc))
+                        coords.append((nr, nc))
+            components.append(coords)
+
+    return labels, components
+
+
+def _count_wall_run(grid: np.ndarray, wall: int, r: int, c: int, dc: int) -> int:
+    h, w = grid.shape
+    length = 0
+    cc = c + dc
+    while 0 <= cc < w and int(grid[r, cc]) == wall:
+        length += 1
+        cc += dc
+    return length
+
+
