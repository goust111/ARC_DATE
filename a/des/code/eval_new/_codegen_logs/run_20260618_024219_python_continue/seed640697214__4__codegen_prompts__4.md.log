+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _is_edge_frame(mask: np.ndarray, coords: np.ndarray) -> bool:
+    h, w = mask.shape
+    r0, c0, r1, c1 = _bbox(coords)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return False
+    if not (r0 == 0 or c0 == 0 or r1 == h - 1 or c1 == w - 1):
+        return False
+    sub = mask[r0 : r1 + 1, c0 : c1 + 1]
+    expected = 2 * ((r1 - r0 + 1) + (c1 - c0 + 1)) - 4
+    if int(sub.sum()) != expected:
+        return False
+    if not (np.all(sub[0, :]) and np.all(sub[-1, :]) and np.all(sub[:, 0]) and np.all(sub[:, -1])):
+        return False
+    return not bool(np.any(sub[1:-1, 1:-1]))
