+    np.array([[7, 7, 7], [0, 7, 0]], dtype=int),
+    np.array([[8, 0, 8], [8, 8, 8]], dtype=int),
+    np.array([[6, 0, 6], [0, 6, 0], [6, 0, 6]], dtype=int),
