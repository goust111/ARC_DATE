+def _reserve_box(occupied: np.ndarray, bbox: tuple[int, int, int, int], pad: int = 1) -> None:
+    er0, ec0, er1, ec1 = _expanded_bbox(bbox, occupied.shape, pad=pad)
+    occupied[er0 : er1 + 1, ec0 : ec1 + 1] = True
