+    if side == "bottom":
+        base = [(0, c) for c in range(width)]
+        return {
+            "start": _normalize(base + [(1, 0)]),
+            "end": _normalize(base + [(1, width - 1)]),
+        }
+    if side == "left":
+        base = [(r, 1) for r in range(width)]
+        return {
+            "start": _normalize(base + [(0, 0)]),
+            "end": _normalize(base + [(width - 1, 0)]),
