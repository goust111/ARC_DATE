+    w = max(c for _, c in coords) + 1
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in coords:
+        mask[r, c] = True
+    return mask
+
+
+def _rotate_norm(coords: tuple[tuple[int, int], ...], k: int) -> tuple[tuple[int, int], ...]:
+    mask = _coords_to_mask(coords)
