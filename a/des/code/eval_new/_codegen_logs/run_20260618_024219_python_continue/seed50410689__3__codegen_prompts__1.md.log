+    elif side == "bottom":
+        row = int(gap["row"])
+        grid[row, start : end + 1] = 0
+    elif side == "left":
+        col = int(gap["col"])
+        grid[start : end + 1, col] = 0
+    else:
+        col = int(gap["col"])
+        grid[start : end + 1, col] = 0
