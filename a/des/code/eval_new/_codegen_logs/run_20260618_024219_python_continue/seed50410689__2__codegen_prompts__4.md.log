+def _room_bounds(size: int, separators: list[int]) -> list[tuple[int, int]]:
+    bounds: list[tuple[int, int]] = []
+    start = 0
+    for sep in separators:
+        bounds.append((start, sep - 1))
+        start = sep + 1
