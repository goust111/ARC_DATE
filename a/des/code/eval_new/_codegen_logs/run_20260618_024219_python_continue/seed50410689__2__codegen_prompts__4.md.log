+def _stamp_bbox(corner: str, room_h: int, room_w: int, stamp_size: int, row_gap: int, col_gap: int) -> tuple[int, int]:
+    if corner[0] == "t":
+        r0 = row_gap
+    else:
+        r0 = room_h - row_gap - stamp_size
+    if corner[1] == "l":
+        c0 = col_gap
+    else:
+        c0 = room_w - col_gap - stamp_size
+    return int(r0), int(c0)
