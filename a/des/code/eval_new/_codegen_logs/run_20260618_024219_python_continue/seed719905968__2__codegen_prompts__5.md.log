+        out[r0 : r1 + 1, c0 : c1 + 1] = int(frame["fill_color"])
+        out[r0, c0 : c1 + 1] = paint_color
+        out[r1, c0 : c1 + 1] = paint_color
+        out[r0 : r1 + 1, c0] = paint_color
+        out[r0 : r1 + 1, c1] = paint_color
