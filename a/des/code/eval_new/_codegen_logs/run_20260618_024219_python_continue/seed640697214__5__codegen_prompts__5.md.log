+                    dirs.add("up" if third[0] < elbow[0] else "down")
+        elif a[1] == b[1]:
+            for elbow in (a, b):
+                if third[0] == elbow[0] and abs(third[1] - elbow[1]) == 1:
+                    dirs.add("left" if third[1] < elbow[1] else "right")
