+_PATTERN_LIBRARY = _build_pattern_library()
+
+
+def _neighbor(cell, direction):
+    dr, dc = _DIRS[direction]
+    return cell[0] + dr, cell[1] + dc
+
+
+def _pointer_candidate_dirs(coords):
