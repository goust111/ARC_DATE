+    grey, row_lines, col_lines, _, _ = _find_partition_layout(g)
+    info = _analyze_cells(g, grey, row_lines, col_lines)
+    (roles, pointer_dirs), _ = _resolve_roles(info, len(row_lines) - 1, len(col_lines) - 1)
