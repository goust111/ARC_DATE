+_ORTHOGONAL = {
+    "up": ("left", "right"),
+    "down": ("left", "right"),
+    "left": ("up", "down"),
+    "right": ("up", "down"),
+}
+_PAIR_TO_POINTER = {
+    frozenset(("up", "left")): ((0, 1), (1, 0), (1, 1)),
+    frozenset(("up", "right")): ((0, 0), (1, 0), (1, 1)),
+    frozenset(("down", "left")): ((0, 0), (0, 1), (1, 1)),
