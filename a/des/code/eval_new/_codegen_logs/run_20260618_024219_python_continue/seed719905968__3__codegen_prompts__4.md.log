+    canvas_w = sw * (1 + right_steps) + rng.randint(0, 2)
+
+    stamp_frame_h = sh + 2
+    stamp_frame_w = sw + 2
+    canvas_frame_h = canvas_h + 2
+    canvas_frame_w = canvas_w + 2
