+def _is_rectangle_border(coords: list[tuple[int, int]]) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    pts = set(coords)
+    if len(pts) != 2 * (h + w) - 4:
+        return False
+    for r in range(r0, r1 + 1):
+        if (r, c0) not in pts or (r, c1) not in pts:
+            return False
+    for c in range(c0, c1 + 1):
+        if (r0, c) not in pts or (r1, c) not in pts:
+            return False
+    return True
