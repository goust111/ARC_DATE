        )
    boxes = _normalize_boxes(boxes)
    br0, bc0, br1, bc1 = boxes[-1]
    bottom_h = br1 - br0 + 1
    bottom_w = bc1 - bc0 + 1
    if max(bottom_h, bottom_w) > 12:
