    return list(reversed(boxes))  # bottom-to-top


def _draw_rect(grid: np.ndarray, bbox: Tuple[int, int, int, int], color: int) -> None:
    r0, c0, r1, c1 = bbox
    grid[r0 : r1 + 1, c0 : c1 + 1] = color


def _shift_box(
    bbox: Tuple[int, int, int, int], dr: int, dc: int
) -> Tuple[int, int, int, int]:
    r0, c0, r1, c1 = bbox
