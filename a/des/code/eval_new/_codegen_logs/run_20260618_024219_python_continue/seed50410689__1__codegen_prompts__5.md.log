+        width = random.randint(*BOX_SIZE_RANGE)
+        top = ROW_TOPS[row]
+        left = COL_LEFTS[col]
+        node_data[(row, col)] = _draw_container(
+            grid,
+            top,
+            left,
+            height,
+            width,
+            source_color_map.get((row, col)),
