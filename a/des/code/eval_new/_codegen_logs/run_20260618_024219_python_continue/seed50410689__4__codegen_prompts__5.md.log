    gaps = [base[i + 1] + bonus[i + 1] for i in range(3)]
    xs = [left]
    for gap in gaps:
        xs.append(xs[-1] + 3 + gap)
    return xs


def _draw_legends(
    grid: np.ndarray,
    templates: dict[str, np.ndarray],
    legend_top: int,
    xs: list[int],
    rng: np.random.Generator,
) -> None:
