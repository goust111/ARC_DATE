+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(points: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(points[:, 0].min()),
+        int(points[:, 1].min()),
+        int(points[:, 0].max()),
+        int(points[:, 1].max()),
+    )
+
+
+def _touches_boundary(points: np.ndarray, h: int, w: int) -> bool:
+    return bool(
+        np.any(points[:, 0] == 0)
+        or np.any(points[:, 1] == 0)
+        or np.any(points[:, 0] == h - 1)
+        or np.any(points[:, 1] == w - 1)
+    )
+
+
+def _is_rectangular_ring(points: np.ndarray) -> bool:
+    r0, c0, r1, c1 = _bbox(points)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    ring = np.zeros((h, w), dtype=bool)
+    ring[0, :] = True
+    ring[-1, :] = True
+    ring[:, 0] = True
+    ring[:, -1] = True
+    sub = np.zeros((h, w), dtype=bool)
+    sub[points[:, 0] - r0, points[:, 1] - c0] = True
+    return bool(np.array_equal(sub, ring))
