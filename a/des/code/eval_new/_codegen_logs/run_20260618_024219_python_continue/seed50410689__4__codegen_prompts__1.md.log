+def _corner_position(corner: str, grid_h: int, grid_w: int, box_h: int, box_w: int) -> tuple[int, int]:
+    if corner == "tl":
+        return 1, 1
+    if corner == "tr":
+        return 1, grid_w - box_w - 1
+    if corner == "bl":
+        return grid_h - box_h - 1, 1
+    return grid_h - box_h - 1, grid_w - box_w - 1
+
