from collections import deque
import random

import numpy as np


_BG = 0
_FENCE = 5
_ENTRY_INNER_W = 4
_PATTERN_H = 2
_PATTERN_W = 3
_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
_GEN_ATTEMPTS = 400

_PATTERN_LIBRARY = (
