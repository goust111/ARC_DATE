+def _render_dictionary(colors: list[int], patterns: list[np.ndarray]) -> np.ndarray:
+    n = len(colors)
+    h = 2 * n + 2
+    w = _ENTRY_INNER_W + 2
+    box = np.full((h, w), _BG, dtype=int)
+    box[0, :] = _FENCE
+    box[-1, :] = _FENCE
+    box[:, 0] = _FENCE
+    box[:, -1] = _FENCE
+    for i, (color, pattern) in enumerate(zip(colors, patterns)):
+        r = 1 + 2 * i
+        box[r, 1] = color
+        sub = box[r : r + 2, 2:5]
+        sub[pattern] = color
+    return box
+
