+
+        extends_left = c > 0 and int(grid[r0, c - 1]) == GREY and int(grid[r1, c - 1]) == GREY
+        extends_right = c + 1 < w and int(grid[r0, c + 1]) == GREY and int(grid[r1, c + 1]) == GREY
