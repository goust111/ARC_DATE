+def _find_rooms(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    rooms: list[dict] = []
+    used_anchors: set[tuple[int, int]] = set()
+    used_colors: set[int] = set()
+
+    for r in range(h):
+        for c in range(w):
+            value = int(grid[r, c])
+            if value in (BLACK, GREY):
+                continue
+            grey_neighbors = [
+                (nr, nc)
+                for nr, nc in _neighbors4(r, c, h, w)
+                if int(grid[nr, nc]) == GREY
