+def _iter_border(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+    for r in range(r0 + 1, r1):
