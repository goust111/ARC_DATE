+    for _ in range(200):
+        target = random.randint(max(2, area // 3), max(2, area - 1))
+        cells = {(0, random.randrange(w))}
+        frontier = set(cells)
+        while len(cells) < target and frontier:
+            fr, fc = random.choice(tuple(frontier))
