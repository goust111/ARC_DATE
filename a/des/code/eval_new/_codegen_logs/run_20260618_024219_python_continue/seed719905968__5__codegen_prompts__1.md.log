+def _rotate_patch(patch: np.ndarray, side: str) -> np.ndarray:
+    if side == "top":
+        return patch
+    if side == "right":
+        return np.rot90(patch, -1)
+    if side == "bottom":
+        return np.rot90(patch, 2)
+    if side == "left":
+        return np.rot90(patch, 1)
+    raise ValueError(f"unknown side: {side}")
