+        footprints.append((ftop, fleft, ftop + int(spec["foot_h"]), fleft + int(spec["foot_w"])))
+
+    r0, r1, c0, c1 = _sample_crop_bounds(rng, inp.shape, footprints)
+    inp = inp[r0:r1, c0:c1]
+    expected = expected[r0:r1, c0:c1]
