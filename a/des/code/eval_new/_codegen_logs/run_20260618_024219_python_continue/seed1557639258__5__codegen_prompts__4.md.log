+
+def _footprint_dims(size: int, side: str) -> tuple[int, int]:
+    if side in ("top", "bottom"):
+        return 2 * size + 2, size + 2
+    return size + 2, 2 * size + 2
+
+
+def _frame_offset(size: int, side: str) -> tuple[int, int]:
+    if side == "bottom":
+        return size, 0
+    if side == "right":
