0048: GRID_SHAPE = (10, 10)
0049: BACKGROUND_COLOR = Color.ORANGE
0050: N_COLORS = len(PALETTE_ORDER)
0051: 
0052: # Histogram count sampling.
0053: NONZERO_COLOR_RANGE = (3, 6)
0054: MAX_COUNT_RANGE = (2, 7)
0055: TOTAL_OBJECT_RANGE = (4, 12)
0056: 
0057: # Blob shape sampling.
0058: N_BLOB_SHAPES = 6
0059: LINE_LENGTH_RANGE = (2, 5)
0060: SMALL_DIM_RANGE = (2, 4)
0061: GROWN_BLOB_MIN_SIZE = 3
0062: PLUS_SHAPE_SIZE = 3
0063: 
0064: # Placement and retry limits.
0065: SAME_COLOR_MIN_CHEBYSHEV = 2
0066: BLOB_PLACE_TRIES = 100
0067: GENERATION_TRIES = 300
0068: 
0069: 
0070: def _gen_attempt() -> np.ndarray | None:
0071:     """Generate one candidate grid, returning None when placement or validation fails."""
0072:     rng = np.random.default_rng()
0073:     counts = _sample_counts(rng)
0074:     if counts is None:
0075:         return None
0076: 
0077:     grid = np.full(GRID_SHAPE, BACKGROUND_COLOR, dtype=int)
0078:     if not _place_all_blobs(grid, counts, rng):
0079:         return None
0080:     if not _counts_match_grid(grid, counts):
0081:         return None
0082:     if not _solver_matches_expected(grid, counts):
0083:         return None
0084:     return grid
0085: 
0086: 
0087: def _sample_counts(rng) -> list[int] | None:
0088:     """Sample per-color component counts matching the output histogram contract."""
0089:     n_nonzero = int(rng.integers(*NONZERO_COLOR_RANGE))
0090:     max_count = int(rng.integers(*MAX_COUNT_RANGE))
0091: 
0092:     counts = [0] * N_COLORS
0093:     nonzero_indices = list(rng.choice(N_COLORS, size=n_nonzero, replace=False))
0094:     max_idx = rng.choice(nonzero_indices)
0095:     counts[max_idx] = max_count
0096: 
0097:     remaining_budget = TOTAL_OBJECT_RANGE[1] - max_count
0098:     for idx in [i for i in nonzero_indices if i != max_idx]:
0099:         upper = min(max_count, remaining_budget)
0100:         if upper < 1:
0101:             counts[idx] = 1
0102:             remaining_budget -= 1
0103:         else:
0104:             counts[idx] = int(rng.integers(1, upper + 1))
0105:             remaining_budget -= counts[idx]
0106: 
0107:     total = sum(counts)
0108:     if total < TOTAL_OBJECT_RANGE[0] or total > TOTAL_OBJECT_RANGE[1]:
0109:         return None
0110:     return counts
0111: 
0112: 
0113: def _place_all_blobs(grid: np.ndarray, counts: list[int], rng) -> bool:
0114:     """Place each color's requested number of same-color-separated blobs."""
0115:     for color_idx, count in enumerate(counts):
0116:         if count == 0:
0117:             continue
0118:         if not _place_color_blobs(grid, PALETTE_ORDER[color_idx], count, rng):
0119:             return False
0120:     return True
0121: 
