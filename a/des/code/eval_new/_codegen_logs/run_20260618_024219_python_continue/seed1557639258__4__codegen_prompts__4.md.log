0009: def main(grid: np.ndarray) -> np.ndarray:
0010:     """Convert scattered foreground objects into bottom-aligned count bars in a fixed five-color order.
0011: 
0012:     Input structure
0013:     The grid has a dominant background color and foreground objects in the task
0014:     palette: grey, red, teal, maroon, and pink. Objects are monochromatic
0015:     8-connected components; some palette colors may be absent.
0016: 
0017:     Rule
0018:     For each palette color in order grey, red, teal, maroon, pink, count its
0019:     8-connected objects. Create a background grid with five columns and height
0020:     equal to the largest count, then fill each column upward from the bottom
0021:     with its palette color for that count.
0022: 
0023:     Key insight
0024:     The output does not preserve object shapes or positions; it is a histogram
0025:     of per-color 8-connected object counts, using the learned palette order.
0026:     """
0027:     g = np.asarray(grid, dtype=int)
0028:     assert g.ndim == 2
0029: 
0030:     bg = get_bg(g)
0031:     palette_set = set(PALETTE_ORDER)
0032:     assert bg not in palette_set, "background must not be a histogram color"
0033:     assert set(map(int, g.ravel())) <= palette_set | {bg}
0034: 
0035:     object_counts = [len(components_mask(g == color, connectivity=8)) for color in PALETTE_ORDER]
0036:     max_count = max(object_counts)
0037:     assert max_count > 0, "expected at least one foreground object"
0038: 
0039:     out = np.full((max_count, len(PALETTE_ORDER)), bg, dtype=int)
0040:     for c, (color, count) in enumerate(zip(PALETTE_ORDER, object_counts)):
0041:         if count:
0042:             out[-count:, c] = color
0043:     return out
0044: 
0045: # --------------- generator (att1) ---------------
0046: 
