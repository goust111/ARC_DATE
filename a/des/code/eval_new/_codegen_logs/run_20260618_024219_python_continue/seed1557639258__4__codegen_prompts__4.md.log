+                    rows_here = [
+                        int(other["row"])
+                        for other in paths
+                        if other["orientation"] == "h"
+                        and int(other["start"]) <= col <= int(other["end"])
+                        and int(path["start"]) <= int(other["row"]) <= int(path["end"])
+                        and priority[int(other["color"])] < priority[path_color]
