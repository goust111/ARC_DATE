0013: def main(grid: np.ndarray) -> np.ndarray:
0014:     """
0015:     Advance the marker from one half of a vertical bar to the same half of the next longer bar.
0016: 
0017:     Input structure
0018:     - The grid has one dominant background color and exactly two foreground colors.
0019:     - One foreground color forms many vertical one-cell-wide bars; the other appears as a single vertical marker segment.
0020:     - The marker segment occupies exactly the top or bottom half of its containing vertical bar.
0021:     Rule
0022:     - Recolor the current marker segment back to the bar color.
0023:     - Find the unique all-bar-color vertical bar whose height is two pixels greater than the marked source bar.
0024:     - Recolor the same half of that next longer bar to the marker color.
0025:     Key insight
0026:     - Each bar's total height encodes an ordered size, and the marker advances from a 2k bar to the corresponding 2(k+1) bar while preserving whether it marks the top or bottom half.
0027:     """
0028:     g = np.asarray(grid, dtype=int)
0029:     assert g.ndim == 2
0030: 
