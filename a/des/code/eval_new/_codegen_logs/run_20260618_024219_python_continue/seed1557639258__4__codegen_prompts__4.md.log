+    priority = {color: idx for idx, (_row, color) in enumerate(legend)}
+    paths = _recover_paths(g, bg, legend_c, legend)
+
+    recolored_main, winners = _recolored_paths((g.shape[0], legend_c), paths, priority, bg)
+
+    out = np.full_like(g, bg)
