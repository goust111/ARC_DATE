0080: def main(grid: np.ndarray) -> np.ndarray:
0081:     """
0082:     Recolor vertical bars by legend-driven rank selection.
0083: 
0084:     Input structure:
0085:     - bg = background. Top-left: monochrome blocks touching row 0; each has color K and height k.
0086:     - Main grid: vertical bars capped top and bottom by a single color, with solid-color interiors.
0087: 
0088:     Rule:
0089:     - For each legend entry (K, k), find vertical bars capped by K.
0090:     - Rank bars by interior length (longest = rank 1).
0091:     - Recolor the rank-k bar's interior to K.
0092: 
0093:     Key insight: Legend height is a rank index into length-sorted bars, not a literal size.
0094:     """
0095:     g = np.asarray(grid, dtype=int)
0096:     bg = get_bg(g)
0097:     out = g.copy()
0098: 
0099:     legend = _legend_entries(g, bg)
0100:     assert legend, 'legend must be non-empty'
0101: 
0102:     for _x, cap, k in legend:
0103:         segs = _vertical_sandwiches(g, cap)
0104:         assert segs, f'legend cap {cap} must have matching vertical bars'
0105:         segs.sort(key=lambda s: (-(s[1] - s[0] - 1), s[0], s[2]))
0106:         assert 1 <= k <= len(segs), f'legend rank {k} out of range for {len(segs)} bars'
0107:         top_r, bot_r, col, _fill = segs[k - 1]
0108:         out[top_r + 1 : bot_r, col] = cap
0109: 
0110:     return out
0111: 
0112: # --------------- generator (O2) ---------------
0113: 
0114: # --- Configuration ---
0115: GRID_H = 10                  # fixed grid height
0116: WIDTH_MIN = 10               # minimum grid width
0117: WIDTH_MAX = 20               # maximum grid width (inclusive)
0118: MAX_GROUPS = 4               # max number of cap-color groups
0119: MAX_TOTAL_BARS = 10          # max bars across all groups
0120: BARS_PER_GROUP = (2, 3)      # allowed bars-per-group counts
0121: MAX_FILL_LEN = 7             # max interior fill length of a bar
0122: COLOR_RANGE = (1, 10)        # non-bg color ids (exclusive upper)
0123: COL_SPACING = 2              # minimum column stride between bars
0124: MAX_RETRIES = 300            # retry budget for generate_input
0125: 
0126: _BOTTOM_ROW = GRID_H - 1    # row index where all bars end
0127: _MAX_CAP_ROW = GRID_H - 2   # highest row a bar's top cap can occupy
0128: 
0129: _FEASIBLE_COUNTS = {
0130:     ng: [c for c in itertools.product(BARS_PER_GROUP, repeat=ng) if sum(c) <= MAX_TOTAL_BARS]
0131:     for ng in range(1, MAX_GROUPS + 1)
0132: }
0133: 
0134: 
0135: def _build_bar(cap: int, fill: int, fill_len: int) -> np.ndarray:
0136:     """Return a (fill_len+2, 1) column sprite: cap / fill*N / cap."""
0137:     bar = np.full((fill_len + 2, 1), fill, dtype=int)
0138:     bar[0, 0] = cap
0139:     bar[-1, 0] = cap
0140:     return bar
0141: 
0142: 
0143: def _assign_columns(rng, n_groups: int, counts: list[int], width: int) -> list[list[int]]:
0144:     """Distribute bar columns across groups with random inter-group spacing.
0145: 
0146:     Returns one list of column indices per group; the first column in each
0147:     group doubles as that group's legend column.
0148:     """
0149:     total_bars = sum(counts)
0150:     min_width = max(WIDTH_MIN, COL_SPACING * total_bars - 1)
0151:     gap_slots = total_bars - n_groups + 1
0152:     extra_width = width - min_width
0153:     extra_parts = rng.multinomial(extra_width, np.full(gap_slots, 1.0 / gap_slots))
0154: 
0155:     # Extra spacing goes only to inter-group gaps (after first n_groups columns)
0156:     inter_gap_bonus = np.zeros(total_bars - 1, dtype=int)
0157:     if total_bars > n_groups:
0158:         inter_gap_bonus[n_groups - 1 :] = extra_parts[:-1]
0159: 
0160:     occupied = [0]
0161:     for idx in range(total_bars - 1):
0162:         occupied.append(occupied[-1] + COL_SPACING + int(inter_gap_bonus[idx]))
0163: 
0164:     legend_cols = occupied[:n_groups]
0165:     extra_cols = occupied[n_groups:]
0166: 
0167:     # Assign non-legend columns to groups randomly
0168:     group_columns = [[legend_cols[i]] for i in range(n_groups)]
0169:     owners = [i for i, count in enumerate(counts) for _ in range(count - 1)]
0170:     rng.shuffle(owners)
0171:     for col, owner in zip(extra_cols, owners):
0172:         group_columns[owner].append(col)
0173: 
0174:     return group_columns
0175: 
0176: 
0177: def _choose_fill_lengths(rng, count: int, rank: int) -> list[int]:
0178:     """Pick `count` distinct fill lengths for one group.
0179: 
0180:     The first length (legend column bar) is constrained so the bar fits
0181:     below the legend block with a bg gap row.
0182:     """
0183:     max_legend_len = MAX_FILL_LEN - rank  # legend occupies `rank` top rows
0184:     shared_len = int(rng.integers(1, max_legend_len + 1))
0185:     pool = [l for l in range(1, MAX_FILL_LEN + 1) if l != shared_len]
0186:     rng.shuffle(pool)
0187:     return [shared_len] + pool[: count - 1]
0188: 
0189: 
0190: def _expected_output(
0191:     inp: np.ndarray, caps: list[int],
0192:     group_columns: list[list[int]], group_lengths: list[list[int]],
0193:     ranks: list[int],
0194: ) -> np.ndarray:
0195:     """Compute the expected output by recoloring the rank-k bar's fill to cap."""
0196:     out = inp.copy()
0197:     for cap, cols, lengths, rank in zip(caps, group_columns, group_lengths, ranks):
0198:         ranked = sorted(zip(cols, lengths), key=lambda item: -item[1])
0199:         target_col, target_len = ranked[rank - 1]

