0036:         int(color): len(
0037:             find_components(
0038:                 g,
0039:                 bg=bg,
0040:                 colors=[int(color)],
0041:                 connectivity=4,
0042:                 monochromatic=True,
0043:             )
0044:         )
0045:         for color in colors
