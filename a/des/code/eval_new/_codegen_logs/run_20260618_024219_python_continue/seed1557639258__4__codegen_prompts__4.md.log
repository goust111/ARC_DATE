+def _render_input(spec: dict[str, object]) -> np.ndarray:
+    height = int(spec["height"])
+    width = int(spec["width"])
+    main_w = int(spec["main_w"])
+    legend = list(spec["legend"])
+    priority = dict(spec["priority"])
+    paths = list(spec["paths"])
+
