0070: def main(grid: np.ndarray) -> np.ndarray:
0071:     """
0072:     Fill rectangles between diagonal marker pairs using a color legend.
0073: 
0074:     Input structure:
0075:     - bg grid with a vertical legend at the bottom-left: each row is a (marker_color, fill_color) pair.
0076:     - Scattered L-shaped corner markers of each marker color define opposite corners of axis-aligned rectangles.
0077:     - Some markers are solid 2×2 blocks instead of corner pairs.
0078: 
0079:     Rule:
0080:     - Read legend bottom-to-top; for each entry find all pixels of that marker color.
0081:     - Determine which two bbox corners carry L-shaped anchors — the *other* diagonal defines the fill region.
0082:     - Fill the diamond (all shortest-path cells between those two corners) with the legend's fill color.
0083:     - Solid 2×2 marker blocks are simply recolored to the fill color.
0084:     - Later legend entries are protected from earlier fills.
0085: 
0086:     Key insight: The L-shaped anchors sit on the marker diagonal; the fill goes on the opposite diagonal of the bounding box.
0087:     """
0088:     g = np.asarray(grid, dtype=int)
0089:     h, w = g.shape
0090: 
0091:     bg = get_bg(g)
0092:     legend_c, entries = _find_legend(g, bg)
0093:     assert entries, "legend must contain at least one (marker, fill) entry"
0094: 
0095:     legend_mask = np.zeros_like(g, dtype=bool)
0096:     for r, _, _ in entries:
0097:         if 0 <= r < h and 0 <= legend_c < w:
0098:             legend_mask[r, legend_c] = True
0099:         if 0 <= r < h and 0 <= legend_c + 1 < w:
0100:             legend_mask[r, legend_c + 1] = True
0101: 
0102:     out = g.copy()
0103: 
0104:     marker_order = [m for _, m, _ in entries]
0105:     marker_set = set(marker_order)
0106: 
0107:     # Process legend entries bottom -> top; earlier entries must not destroy later marker pixels.
0108:     for i, (_, marker, fill) in enumerate(entries):
0109:         eff_fill = int(fill)
0110:         marker_pts = set(map(tuple, np.argwhere((g == marker) & (~legend_mask))))
0111:         if len(marker_pts) < 2:
0112:             continue
0113: 
0114:         rs = [r for r, _ in marker_pts]
0115:         cs = [c for _, c in marker_pts]
0116:         rmin, rmax = min(rs), max(rs)
0117:         cmin, cmax = min(cs), max(cs)
0118: 
0119:         # Protect legend cells and all marker pixels for entries that appear later (higher) in the legend.
0120:         future_markers = set(marker_order[i + 1 :])
0121:         protect = legend_mask.copy()
0122:         for fm in future_markers:
0123:             protect |= (g == fm) & (~legend_mask)
0124: 
0125:         # Also protect current marker pixels in the common case (so markers remain visible),
0126:         # except when they form a solid 2x2 block (treated as a filled marker that gets recolored).
0127:         if rmax - rmin == 1 and cmax - cmin == 1 and len(marker_pts) == 4:
0128:             # Solid 2x2 marker: recolor these pixels directly.
0129:             block = np.zeros_like(g, dtype=bool)
0130:             for r, c in marker_pts:
0131:                 block[r, c] = True
0132:             out[block & (~protect)] = eff_fill
0133:             continue
0134:         else:
0135:             protect |= (g == marker) & (~legend_mask)
0136: 
0137:         if rmin == rmax or cmin == cmax:
0138:             continue
0139: 
0140:         tl = (rmin, cmin)
0141:         tr = (rmin, cmax)
0142:         bl = (rmax, cmin)
0143:         br = (rmax, cmax)
0144: 
0145:         tl_anchor = _l_anchor_present(marker_pts, tl[0], tl[1], (0, 1), (1, 0))
0146:         tr_anchor = _l_anchor_present(marker_pts, tr[0], tr[1], (0, -1), (1, 0))
0147:         bl_anchor = _l_anchor_present(marker_pts, bl[0], bl[1], (0, 1), (-1, 0))
0148:         br_anchor = _l_anchor_present(marker_pts, br[0], br[1], (0, -1), (-1, 0))
0149: 
0150:         score_tlbr = int(tl_anchor) + int(br_anchor)
0151:         score_trbl = int(tr_anchor) + int(bl_anchor)
0152:         assert score_tlbr != 0 or score_trbl != 0, "at least one diagonal must have an L-anchor"
0153:         assert score_tlbr != score_trbl, "diagonal scores must not tie (tie-break path is unreachable)"
0154:         if score_tlbr > score_trbl:
0155:             a, b = tr, bl
0156:         else:
0157:             a, b = tl, br
0158: 
0159:         diamond = _diamond_mask(h, w, rmin, rmax, cmin, cmax, a, b)
0160:         out[diamond & (~protect)] = eff_fill
0161: 
0162:     return out
0163: 
