+    r1, c1 = coords.max(axis=0)
+    probe = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    local = coords - np.array([r0, c0], dtype=int)
+    if probe[local[:, 0], local[:, 1]].any():
+        return False
+    probe[local[:, 0], local[:, 1]] = True
+    return bool(probe.all())
