{
  "type": "move_to_match",
  "src": "left-edge 4-connected object s of the split foreground color",
  "dst": "same-colored anchor object d away from the left edge",
  "match_cond": "s.color == d.color and a translation of s plus d forms a filled axis-aligned rectangle",
  "transform": "erase s from its original cells and translate it to the unique completing offset; preserve d and all other cells"
}
</annotation>
</reference_puzzle>

