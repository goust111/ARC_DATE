+def _solve_frame(box_h: int, box_w: int, anchor: tuple[int, int], pieces: list[dict]) -> list[dict]:
+    needed_mask = 0
+    for r in range(box_h):
+        for c in range(box_w):
+            if (r, c) != anchor:
+                needed_mask |= 1 << int(r * box_w + c)
