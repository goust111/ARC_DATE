+            left = random.randint(0, canvas_w - piece_w)
+            if _can_place(blocked, top, left, piece_h, piece_w):
+                spot = (top, left)
+                _mark_blocked(blocked, top, left, piece_h, piece_w, PIECE_PADDING)
