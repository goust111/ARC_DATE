+    pieces_by_color = {color: [] for color in frame_colors}
+    for color in frame_colors:
+        mask = (grid == color) & outside
+        for coords in _components(mask):
+            shape, box_h, box_w = _normalize(coords)
+            pieces_by_color[color].append(
+                {
+                    "shape": shape,
+                    "bbox": (int(box_h), int(box_w)),
+                    "area": int(len(coords)),
+                    "coords_global": tuple(sorted(coords)),
+                }
+            )
+    return pieces_by_color
+
+
+def _candidate_placements(
+    piece: dict,
+    box_h: int,
+    box_w: int,
+    anchor: tuple[int, int],
+) -> list[dict]:
+    shape = piece["shape"]
+    piece_h, piece_w = piece["bbox"]
+    placements = []
+    for top in range(box_h - piece_h + 1):
+        for left in range(box_w - piece_w + 1):
+            cells = []
+            bitmask = 0
+            ok = True
+            for pr, pc in shape:
+                rr = int(top + pr)
+                cc = int(left + pc)
+                if (rr, cc) == anchor:
+                    ok = False
+                    break
+                idx = int(rr * box_w + cc)
+                bitmask |= 1 << idx
+                cells.append((rr, cc))
+            if ok:
+                placements.append(
+                    {
+                        "top": int(top),
+                        "left": int(left),
+                        "mask": bitmask,
+                        "cells": tuple(cells),
+                    }
+                )
+    return placements
