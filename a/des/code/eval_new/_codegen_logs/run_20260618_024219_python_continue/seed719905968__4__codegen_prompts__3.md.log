+import random
+
+import numpy as np
+
+
+BLACK = 0
+AZURE = 8
+COLOR_POOL = (1, 2, 3, 4, 5, 6, 7, 9)
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+FRAME_COUNT_RANGE = (2, 3)
+INNER_H_RANGE = (3, 5)
+INNER_W_RANGE = (3, 6)
+MAX_PIECES_PER_FRAME = 4
+CASE_RETRIES = 400
+FRAME_SPEC_RETRIES = 120
+PARTITION_RETRIES = 120
+OBJECT_PLACEMENT_RETRIES = 150
+MIN_CANVAS_SIDE = 18
+MAX_CANVAS_SIDE = 30
+FRAME_PADDING = 2
+PIECE_PADDING = 1
