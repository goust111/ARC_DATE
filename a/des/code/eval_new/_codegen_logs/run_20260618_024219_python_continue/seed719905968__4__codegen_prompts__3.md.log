def generate_input() -> np.ndarray:
    for _ in range(CASE_RETRIES):
        built = _build_case()
        if built is None:
            continue
        inp, expected = built
        try:
            got = main(inp)
        except AssertionError:
            continue
        if np.array_equal(got, expected):
