+        out[ir0 : ir1 + 1, ic0 : ic1 + 1] = BLACK
+        out[ir0 + anchor[0], ic0 + anchor[1]] = color
+        for piece, placement in zip(pieces, placements):
+            for pr, pc in piece["shape"]:
+                rr = int(ir0 + placement["top"] + pr)
+                cc = int(ic0 + placement["left"] + pc)
+                out[rr, cc] = color
