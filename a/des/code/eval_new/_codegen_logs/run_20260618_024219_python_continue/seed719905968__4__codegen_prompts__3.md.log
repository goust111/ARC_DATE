+    c0 = max(0, left - pad)
+    r1 = min(grid_h, top + height + pad)
+    c1 = min(grid_w, left + width + pad)
+    blocked[r0:r1, c0:c1] = True
+
+
+def _draw_frame(grid: np.ndarray, top: int, left: int, frame: dict, assembled: bool) -> None:
+    inner_h, inner_w = frame["inner_shape"]
+    outer_h = inner_h + 2
+    outer_w = inner_w + 2
