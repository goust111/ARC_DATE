+        return leaves
+    return None
+
+
+def _valid_target_sides(
+    leaf: tuple[int, int, int, int],
+    inner_h: int,
+    inner_w: int,
+) -> list[str]:
+    r0, c0, h, w = leaf
+    sides = []
+    if r0 == 0 and w >= 3:
