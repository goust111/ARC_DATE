+    expected = _build_expected((H, W), (fr0, fc0, fr1, fc1), slots)
+    actual = main(grid)
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
