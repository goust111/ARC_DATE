+        return None
+
+    outer_h = inner_h + 2
+    outer_w = inner_w + 2
+    min_h = max(outer_h + 6, 22)
+    min_w = max(outer_w + 6, 22)
+    if min_h > 30 or min_w > 30:
+        return None
+
+    H = rng.randint(min_h, 30)
+    W = rng.randint(min_w, 30)
