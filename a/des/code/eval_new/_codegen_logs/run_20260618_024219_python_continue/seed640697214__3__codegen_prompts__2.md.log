+            fill = rot_arr.copy()
+            fill[fill == YELLOW] = frag["body"]
+            out_sub = out[sr0 : sr1 + 1, sc0 : sc1 + 1]
+            out_sub[slot_mask] = fill[rot_mask]
+            placed = True
+            break
+        assert placed
