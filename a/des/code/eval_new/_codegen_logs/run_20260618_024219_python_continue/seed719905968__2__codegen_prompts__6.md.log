+def _paint_shifted_component(
+    out: np.ndarray, coords: np.ndarray, dr: int, dc: int, color: int
+) -> None:
+    rows = coords[:, 0] + int(dr)
+    cols = coords[:, 1] + int(dc)
+    out[rows, cols] = int(color)
