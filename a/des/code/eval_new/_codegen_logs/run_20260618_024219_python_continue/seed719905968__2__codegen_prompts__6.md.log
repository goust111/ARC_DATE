+        info = _parse_inner_blocks(g, frame_bbox, inner_comps)
+        blocks = info["blocks"]
+        block_color = int(info["block_color"])
+        count = int(info["count"])
+        orientation = str(info["orientation"])
+
+        sprite_candidates: list[tuple[dict, str]] = []
+        for comp in components:
