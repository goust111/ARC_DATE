+            target = block_bboxes[0] if start_from_left else block_bboxes[-1]
+            sign = 1 if start_from_left else -1
+            sprite_r0 = -sh if side == "top" else fence_h
+            sprite_c0 = _aligned_start(int(target[1] + target[3]), sw)
