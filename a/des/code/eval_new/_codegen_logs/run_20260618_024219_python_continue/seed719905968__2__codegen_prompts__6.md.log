+    rr0 = max(0, r - SPRITE_PADDING)
+    cc0 = max(0, c - SPRITE_PADDING)
+    rr1 = min(CANVAS_SIZE, r + ph + SPRITE_PADDING)
+    cc1 = min(CANVAS_SIZE, c + pw + SPRITE_PADDING)
