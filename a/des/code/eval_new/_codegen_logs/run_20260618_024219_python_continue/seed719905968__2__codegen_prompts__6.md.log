+            fr0, fc0, fr1, fc1 = frame["bbox"]
+            inner_bbox = (fr0 + 1, fc0 + 1, fr1 - 1, fc1 - 1)
+            if _inside_bbox(comp["bbox"], inner_bbox):
+                owner = idx
+                break
