+            texture = shape_to_texture[shape].copy()
+            texture[texture == KEY] = seed_color
+            room_outputs.append((bbox, texture))
+            _reserve(occupied, bbox, pad=1)
+            placed = True
+            break
+        if not placed:
+            return None
+
+    out = _expected_output(grid, room_outputs)
+    return grid, out
