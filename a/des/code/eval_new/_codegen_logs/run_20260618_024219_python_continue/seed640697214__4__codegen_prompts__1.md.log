+    for k in range(4):
+        rotated = _rot_cw(fragment_mask, k)
+        if _mask_key(rotated) == hole_key:
+            pairs.append((int(k), False))
+        flipped = np.fliplr(rotated)
+        if _mask_key(flipped) == hole_key:
+            pairs.append((int(k), True))
