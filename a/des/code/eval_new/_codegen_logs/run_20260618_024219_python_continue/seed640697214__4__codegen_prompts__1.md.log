+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+FRAME_COLOR = 5
+PALETTE_LEN = 4
+
+GRID_MIN = 22
+GRID_MAX = 30
+FRAME_MIN = 11
+FRAME_MAX = 18
+FRAME_MARGIN = 2
+FRAME_PAD = 1
+HOLE_COUNT = 4
+GEN_ATTEMPTS = 400
