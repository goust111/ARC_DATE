+    rng.shuffle(usable_colors)
+    palette_colors = usable_colors[:PALETTE_LEN]
+    fragment_colors = usable_colors[PALETTE_LEN : 2 * PALETTE_LEN]
+
+    edge = rng.choice(["top", "bottom", "left", "right"])
