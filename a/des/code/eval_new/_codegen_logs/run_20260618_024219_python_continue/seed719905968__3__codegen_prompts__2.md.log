  21: def main(grid: np.ndarray) -> np.ndarray:
  22:     """
  23:     Paint an inner border around the region reachable from a corner marker pixel.
  24: 
  25:     Input structure:
  26:     - bg = most common color; wall color (blue) forms barriers dividing the grid.
  27:     - A unique single pixel (magenta) sits on one corner — the start marker.
  28:     - Some wall-colored pixels are structural (border-touching, enclosing regions); others are decorations.
  29: 
  30:     Rule:
  31:     - Flood-fill from the marker corner to find all reachable bg cells, blocked by structural walls.
  32:     - Erase wall-colored decorations hidden behind structural walls (not reachable from marker side).
  33:     - Paint orange (color 7) on every reachable bg cell adjacent to a wall or grid edge — forming a 1-cell inner border.
  34: 
  35:     Key insight: Only border-connected wall components act as real barriers; interior wall fragments are decorations to be removed.
  36:     """
  37:     g = np.asarray(grid, dtype=int)
  38:     h, w = g.shape
  39:     bg = get_bg(g)
  40: 
  41:     out = g.copy()
  42: 
  43:     # Marker pixel is a unique (count==1) non-bg pixel on a corner.
  44:     counts = Counter(int(v) for v in g.ravel())
  45:     corners = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]
