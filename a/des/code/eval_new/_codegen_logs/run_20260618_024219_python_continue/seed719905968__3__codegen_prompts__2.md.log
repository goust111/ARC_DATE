+
+def _build_mapping(source_colors, rng: random.Random):
+    order = list(source_colors)
+    rng.shuffle(order)
+    return {order[i]: order[(i + 1) % len(order)] for i in range(len(order))}
+
+
+def _paint_cells(grid: np.ndarray, cells, color: int):
+    for r, c in cells:
+        grid[r, c] = color
