+def _gen_attempt(rng: random.Random):
+    h = rng.randint(SCENE_MIN, SCENE_MAX)
+    w = rng.randint(SCENE_MIN, SCENE_MAX)
+    grid = np.full((h, w), BG, dtype=int)
