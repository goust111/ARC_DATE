+    out = g.copy()
+    filled_frames = set()
+    h, w = g.shape
+
+    for source in sources:
+        cur = source["color"]
+        dr, dc = DIR_VECTORS[source["direction"]]
+        r, c = source["tip"]
+        last_filter = None
+        while True:
+            r += dr
+            c += dc
