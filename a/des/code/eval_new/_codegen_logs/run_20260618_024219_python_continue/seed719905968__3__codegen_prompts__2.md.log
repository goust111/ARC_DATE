+    lane_rows = sorted(rng.sample(lanes, n_sources))
+    colors = list(mapping.keys())
+    rng.shuffle(colors)
+    occupied = np.zeros((scene_h, w), dtype=bool)
+    filter_counts = []
+
+    for lane, color in zip(lane_rows, colors):
+        direction = rng.choice(["left", "right"])
+        variant = rng.randint(0, 1)
