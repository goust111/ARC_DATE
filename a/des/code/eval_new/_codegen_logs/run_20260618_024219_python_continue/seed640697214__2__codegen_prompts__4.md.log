+        grid[fr0, fc0 : fc1 + 1] = FENCE
+        grid[fr1, fc0 : fc1 + 1] = FENCE
+        grid[fr0 : fr1 + 1, fc0] = FENCE
+        grid[fr0 : fr1 + 1, fc1] = FENCE
