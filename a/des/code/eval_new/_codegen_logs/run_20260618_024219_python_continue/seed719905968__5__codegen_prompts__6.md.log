+        assert int(out[r, col]) in (AZURE, int(color))
+        out[r, col] = int(color)
+    for r in range(bottom, top - 1, -1):
+        if int(out[r, col]) == GREY:
+            break
+        assert int(out[r, col]) in (AZURE, int(color))
+        out[r, col] = int(color)
+
