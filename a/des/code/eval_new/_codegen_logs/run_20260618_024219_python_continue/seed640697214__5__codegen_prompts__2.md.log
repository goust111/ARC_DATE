+def _trace_signal(
+    grid: np.ndarray,
+    path_mask: np.ndarray,
+    source: tuple[int, int],
+    ranks: dict[int, int],
+) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    trail = [source]
+    seen = {source}
+    prev: tuple[int, int] | None = None
+    cur = source
+
+    while True:
+        if cur != source and int(grid[cur]) == MAROON:
+            break
+
+        nbrs = [(nr, nc) for nr, nc in _neighbors4(cur[0], cur[1], h, w) if path_mask[nr, nc]]
+        options = nbrs if prev is None else [p for p in nbrs if p != prev]
+        if not options:
+            break
+        if len(options) == 1:
+            nxt = options[0]
+        else:
+            nxt = min(
+                options,
+                key=lambda p: (ranks.get(int(grid[p]), len(ranks)), p[0], p[1]),
+            )
+        if nxt in seen:
+            break
+        trail.append(nxt)
+        seen.add(nxt)
+        prev, cur = cur, nxt
+
+    return trail
+
