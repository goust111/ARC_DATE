+    if len(trail_union) <= source_count:
+        return None
+
+    expected = grid.copy()
+    for r, c in trail_union:
+        expected[r, c] = ORANGE
+    if not np.array_equal(main(grid), expected):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
