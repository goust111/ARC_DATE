+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+AZURE = 8
+MAROON = 9
+
+PATH_COLORS = (BLUE, RED, GREEN, YELLOW, MAGENTA, AZURE)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_H_RANGE = (18, 28)
+GRID_W_RANGE = (18, 28)
+SOURCE_COUNT_CHOICES = (1, 2)
+PRIORITY_LEN_CHOICES = (2, 3)
