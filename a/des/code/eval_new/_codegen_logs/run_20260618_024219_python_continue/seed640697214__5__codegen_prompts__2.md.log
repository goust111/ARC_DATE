+
+def _endpoint_candidates(
+    shape: tuple[int, int],
+    occupied: set[tuple[int, int]],
+    blocked: np.ndarray,
+) -> list[tuple[int, int]]:
+    h, w = shape
+    out = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if blocked[r, c] or (r, c) in occupied:
