+                                    break
+                            if branch_cells is None:
+                                side_ok = False
+                                break
+                            side_occ.update(branch_cells)
+                            for cell in branch_cells[:-1]:
+                                side_paints[cell] = branch_color[side_dir]
+                            side_paints[branch_cells[-1]] = MAROON
+
+                        if not side_ok:
+                            continue
+
+                        temp_occ = side_occ
+                        paints.update(side_paints)
+                        current_pos = junction
