+    grid[r0 : r0 + ph, c0 : c0 + 3] = patch
+    rr0 = max(0, r0 - 1)
+    cc0 = max(0, c0 - 1)
+    rr1 = min(h, r0 + ph + 1)
+    cc1 = min(w, c0 + 3 + 1)
