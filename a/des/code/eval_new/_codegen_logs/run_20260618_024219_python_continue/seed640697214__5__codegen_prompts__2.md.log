+    source_count = rng.choice(SOURCE_COUNT_CHOICES)
+    occupied: set[tuple[int, int]] = set()
+    trail_union: set[tuple[int, int]] = set()
+
+    for _ in range(source_count):
+        built = _build_component(grid.shape, occupied, blocked, priority, rng)
