+        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in comp):
+            continue
+
+        rs = [r for r, _ in comp]
+        cs = [c for _, c in comp]
+        ir0, ir1 = min(rs), max(rs)
+        ic0, ic1 = min(cs), max(cs)
+        ih = ir1 - ir0 + 1
+        iw = ic1 - ic0 + 1
+        if len(comp) != ih * iw:
+            continue
+        if ir0 == 0 or ic0 == 0 or ir1 == h - 1 or ic1 == w - 1:
