+        windows.append(
+            {
+                "outer_bbox": (ir0 - 1, ic0 - 1, ir1 + 1, ic1 + 1),
+                "inner_bbox": (ir0, ic0, ir1, ic1),
+                "inner_shape": (ih, iw),
