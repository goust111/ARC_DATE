+            vertical = (
+                0 < rr < h - 1
+                and bool(path_mask[rr - 1, cc])
+                and bool(path_mask[rr + 1, cc])
+                and int(degrees[rr - 1, cc]) == 1
+                and int(degrees[rr + 1, cc]) == 1
