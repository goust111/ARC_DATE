+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nxt = (int(r + dr), int(c + dc))
+            if nxt in cell_set:
+                cur_neighbors.append(nxt)
+        neighbors[(r, c)] = cur_neighbors
