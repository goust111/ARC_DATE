) -> tuple[list[Coord], str]:
    pairs: list[tuple[int, int, int, int, int]] = []
    for a_raw in comp_a:
        ar, ac = map(int, a_raw)
        for b_raw in comp_b:
            br, bc = map(int, b_raw)
            pairs.append((abs(ar - br) + abs(ac - bc), ar, ac, br, bc))

