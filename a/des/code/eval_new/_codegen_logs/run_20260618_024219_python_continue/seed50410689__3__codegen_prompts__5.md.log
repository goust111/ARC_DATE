import itertools, random
import numpy as np

BLACK=0
GREY=5
MARKER_COLORS=[1,2,3,4,6,7,8,9]
DIRS={'R':(0,1),'L':(0,-1),'D':(1,0),'U':(-1,0)}
PATTERNS=['H','V','HV','VH','HVH','VHV','HVHV','VHVH']


def neighbors4(r,c,h,w):
    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
        nr,nc=r+dr,c+dc
        if 0<=nr<h and 0<=nc<w:
            yield nr,nc


def components(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    comps=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            st=[(r,c)]
            seen[r,c]=True
            cur=[]
            while st:
                x=st.pop(); cur.append(x)
                for y in neighbors4(*x,h,w):
                    if mask[y] and not seen[y]:
                        seen[y]=True; st.append(y)
            comps.append(cur)
    return comps


def connect_fragments(grid):
    g=grid.copy()
    h,w=g.shape
    while True:
        mask=g"'!=BLACK
        deg=np.zeros_like(g,dtype=int)
        for r,c in np.argwhere(mask):
            r=int(r);c=int(c)
            deg[r,c]=sum(1 for nr,nc in neighbors4(r,c,h,w) if mask[nr,nc])
        fills=[]
        for r,c in np.argwhere(g==BLACK):
            r=int(r);c=int(c)
            horiz=(0<c<w-1 and mask[r,c-1] and mask[r,c+1] and deg[r,c-1]==1 and deg[r,c+1]==1)
            vert=(0<r<h-1 and mask[r-1,c] and mask[r+1,c] and deg[r-1,c]==1 and deg[r+1,c]==1)
            if horiz or vert:
                fills.append((r,c))
        if not fills:
            return g
        for r,c in fills:
            g[r,c]=GREY


def order_path(cells):
    cellset=set(cells)
    neigh={p:[q for q in neighbors4(*p,100,100) if q in cellset] for p in cellset}
    endpoints=[p for p,n in neigh.items() if len(n)==1]
    if len(cellset)==1:
        return [next(iter(cellset))]
    assert len(endpoints)==2, ('"'bad endpoints', endpoints, cellset)
    start=min(endpoints)
    out=[start]
    prev=None
    cur=start
    while True:
        nxts=[q for q in neigh[cur] if q"'!=prev]
        if not nxts:
            break
        assert len(nxts)==1, ('"'branch', cur, nxts, neigh)
        prev,cur=cur,nxts[0]
        out.append(cur)
    assert len(out)==len(cellset)
    return out


def main(grid):
    g=np.asarray(grid,dtype=int)
    linked=connect_fragments(g)
    out=np.where(linked"'!=BLACK,GREY,BLACK)
    for comp in components(linked!=BLACK):
        path=order_path(comp)
        markers=[i for i,p in enumerate(path) if linked[p]!=GREY]
        assert len(markers)==2, markers
        i,j=markers
        ca=int(linked[path[i]])
        cb=int(linked[path[j]])
        for k in range(i):
            out[path[k]]=ca
        for k in range(j+1,len(path)):
            out[path[k]]=cb
    return out


def make_path(pattern, lens, hdir, vdir):
    pts=[(0,0)]
    r=c=0
    for axis,steps in zip(pattern,lens):
        dr,dc=(0,hdir) if axis=='"'H' else (vdir,0)
        for _ in range(steps):
            r+=dr; c+=dc; pts.append((r,c))
    return pts


def shift_path(path, top, left):
    rs=[r for r,c in path]; cs=[c for r,c in path]
    rmin,cmin=min(rs),min(cs)
    return [(r-rmin+top,c-cmin+left) for r,c in path]


def path_bbox(path):
    rs=[r for r,c in path]; cs=[c for r,c in path]
    return min(rs), min(cs), max(rs), max(cs)


def straight_indices(path):
    cand=[]
    for i in range(1,len(path)-1):
        d1=(path[i][0]-path[i-1][0], path[i][1]-path[i-1][1])
        d2=(path[i+1][0]-path[i][0], path[i+1][1]-path[i][1])
        if d1==d2:
            cand.append(i)
    return cand


def valid_cut_sets(path):
    cand=straight_indices(path)
    valid=[]
    L=len(path)
    for frag_count in (2,3,4):
        if len(cand) < frag_count-1:
            continue
        cur=[]
        for cuts in itertools.combinations(cand, frag_count-1):
            prev=-1
            lens=[]
            ok=True
            for cut in cuts:
                flen=cut-prev-1
                lens.append(flen)
                if not (3<=flen<=8):
                    ok=False; break
                prev=cut
            if not ok:
                continue
            flen=L-prev-1
            lens.append(flen)
            if all(3<=x<=8 for x in lens):
                cur.append((cuts,lens))
        if cur:
            valid.append((frag_count,cur))
    return valid


def choose_markers(path_len, gaps):
    avail=[i for i in range(path_len) if i not in gaps]
    types=['internal','left_end','right_end']
    random.shuffle(types)
    for kind in types:
        if kind=='internal':
            opts=[(i,j) for i in avail for j in avail if 1<=i<j<=path_len-2 and j-i>=2]
        elif kind=='left_end':
            opts=[(0,j) for j in avail if j>=2]
        else:
            opts=[(i,path_len-1) for i in avail if i<=path_len-3]
        if opts:
            return random.choice(opts)
    # fallback
    opts=[(i,j) for i in avail for j in avail if i<j]
    return random.choice(opts)


def touches_other(candidate, existing):
    cand=set(candidate)
    for p in cand:
        if p in existing:
            return True
    for r,c in cand:
        for rr,cc in existing:
            if abs(r-rr)+abs(c-cc) <= 2:
                return True
    return False


def gen_path(H,W,existing):
    patterns=PATTERNS[:]
    random.shuffle(patterns)
    for pattern in patterns:
        for _ in range(60):
            hdir=random.choice([-1,1])
            vdir=random.choice([-1,1])
            lens=[random.randint(2,6) for _ in pattern]
            if sum(lens) < 7 or sum(lens) > 22:
                continue
            local=make_path(pattern,lens,hdir,vdir)
            valid=valid_cut_sets(local)
            if not valid:
                continue
            r0,c0,r1,c1=path_bbox(local)
            bh,bw=r1-r0+1,c1-c0+1
            if bh>H-2 or bw>W-2:
                continue
            top_choices=max(1,H-bh-1)
            left_choices=max(1,W-bw-1)
            for _ in range(30):
                top=random.randint(1,H-bh-1)
                left=random.randint(1,W-bw-1)
                path=shift_path(local,top,left)
                if touches_other(path, existing):
                    continue
                # path self-order check not needed; monotone polyline
                frag_count, options = random.choice(valid)
                cuts,lens_frag = random.choice(options)
                gaps=set(cuts)
                m1,m2=sorted(choose_markers(len(path),gaps))
                colors=[random.choice(MARKER_COLORS), random.choice(MARKER_COLORS)]
                return {
                    'path': path,
                    'gaps': gaps,
                    'markers': (m1,m2),
                    'colors': colors,
                    'frag_lens': lens_frag,
                    'pattern': pattern,
                }
    return None


def render(H,W,specs):
    inp=np.zeros((H,W),dtype=int)
    out=np.zeros((H,W),dtype=int)
    for spec in specs:
        path=spec['path']; gaps=spec['gaps']; (m1,m2)=spec['markers']; c1,c2=spec['colors']
        for i,p in enumerate(path):
            if i not in gaps:
                inp[p]=GREY
            out[p]=GREY
        inp[path[m1]]=c1
        inp[path[m2]]=c2
        for i,p in enumerate(path):
            if i<m1:
                out[p]=c1
            elif i>m2:
                out[p]=c2
    return inp,out


def gen_attempt():
    H=random.randint(16,30)
    W=random.randint(16,30)
    path_count=random.randint(1,3)
    specs=[]
    occupied=set()
    for _ in range(path_count):
        spec=gen_path(H,W,occupied)
        if spec is None:
            return None
        specs.append(spec)
        occupied.update(spec['path'])
    inp,out=render(H,W,specs)
    if not np.array_equal(main(inp), out):
        return None
    return inp,out,specs

for t in range(200):
    got=gen_attempt()
    if got:
        inp,out,specs=got
        print('ok',t,inp.shape,[s['frag_lens'] for s in specs],[s['markers'] for s in specs],[s['pattern'] for s in specs])
        break
else:
    print('failed')

# stress
count=0
for _ in range(200):
    if gen_attempt() is not None:
        count+=1
print('success',count)
