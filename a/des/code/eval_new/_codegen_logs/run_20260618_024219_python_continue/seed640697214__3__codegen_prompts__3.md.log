+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+ACTIVE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GENERATE_ATTEMPTS = 400
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr in (-1, 0, 1):
+                    for dc in (-1, 0, 1):
+                        if dr == 0 and dc == 0:
+                            continue
+                        nr = cr + dr
+                        nc = cc + dc
+                        if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                            seen[nr, nc] = True
+                            stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _classify_scene(grid: np.ndarray):
+    towers: list[dict[str, object]] = []
+    receivers: list[dict[str, object]] = []
+    objects: list[dict[str, object]] = []
+
+    for coords in _components(grid != BG):
+        r0, c0 = map(int, coords.min(axis=0))
+        r1, c1 = map(int, coords.max(axis=0))
+        assert coords.shape[0] == 9, "every object must occupy exactly 9 cells"
+        assert (r1 - r0, c1 - c0) == (2, 2), "every object must be a 3x3 block"
+        window = np.asarray(grid[r0 : r1 + 1, c0 : c1 + 1], dtype=int)
+        assert np.all(window != BG), "objects must be fully non-black"
+
+        center = (r0 + 1, c0 + 1)
+        flat = window.reshape(-1)
+        ring = np.array(
+            [
+                window[0, 0],
+                window[0, 1],
+                window[0, 2],
+                window[1, 0],
+                window[1, 2],
+                window[2, 0],
+                window[2, 1],
+                window[2, 2],
+            ],
+            dtype=int,
+        )
+
+        if np.all(flat == flat[0]):
+            tower = {
+                "kind": "tower",
+                "bbox": (r0, c0, r1, c1),
+                "center": center,
+                "color": int(flat[0]),
+            }
+            towers.append(tower)
+            objects.append(tower)
+            continue
+
+        assert np.all(ring == ring[0]), "receiver ring must be monochrome"
+        assert int(window[1, 1]) != int(ring[0]), "receiver center must differ from the ring"
+        receiver = {
+            "kind": "receiver",
+            "bbox": (r0, c0, r1, c1),
+            "center": center,
+            "ring": int(ring[0]),
+            "filter": int(window[1, 1]),
+        }
+        receivers.append(receiver)
+        objects.append(receiver)
+
+    assert towers, "expected at least one signal tower"
+    return towers, receivers, objects
+
+
+def _objects_on_ray(
+    start: tuple[int, int],
+    step: tuple[int, int],
+    objects: list[dict[str, object]],
+    source_center: tuple[int, int],
+) -> list[tuple[tuple[int, int], tuple[int, int], dict[str, object]]]:
+    start_r, start_c = start
+    dr, dc = step
+    hits: list[tuple[tuple[int, int], tuple[int, int], dict[str, object]]] = []
+
+    for obj in objects:
+        if tuple(obj["center"]) == source_center:
+            continue
+        r0, c0, r1, c1 = obj["bbox"]
+        if dr == 0:
+            if not (r0 <= start_r <= r1):
+                continue
+            if dc > 0:
+                if c0 <= start_c:
+                    continue
+                near = (start_r, c0)
+                far = (start_r, c1)
+            else:
+                if c1 >= start_c:
+                    continue
+                near = (start_r, c1)
+                far = (start_r, c0)
+        else:
+            if not (c0 <= start_c <= c1):
+                continue
+            if dr > 0:
+                if r0 <= start_r:
+                    continue
+                near = (r0, start_c)
+                far = (r1, start_c)
+            else:
+                if r1 >= start_r:
+                    continue
+                near = (r1, start_c)
+                far = (r0, start_c)
+        hits.append((near, far, obj))
+
+    if dr != 0:
+        hits.sort(key=lambda item: item[0][0], reverse=dr < 0)
+    else:
+        hits.sort(key=lambda item: item[0][1], reverse=dc < 0)
+    return hits
+
+
+def _paint_between(
+    out: np.ndarray,
+    object_mask: np.ndarray,
+    current: tuple[int, int],
+    stop: tuple[int, int],
+    step: tuple[int, int],
+    color: int,
+) -> None:
+    h, w = out.shape
+    dr, dc = step
+    rr = current[0] + dr
+    cc = current[1] + dc
+    while (rr, cc) != stop:
+        if 0 <= rr < h and 0 <= cc < w and not object_mask[rr, cc]:
+            out[rr, cc] = color
+        rr += dr
+        cc += dc
+
+
+def _paint_to_edge(
