+        return None
+
+    chosen_pairs: set[tuple[int, int]] = set()
+    if branch == "simple":
+        target = 1 if tower_count == 2 else random.randint(1, min(3, max_receivers))
+        while len(chosen_pairs) < target:
+            chosen_pairs.add(random.choice(free_pairs))
+    elif branch == "row_multi":
