+    counts = _receiver_counts(towers, receivers)
+    if not any(count == 0 for count in counts):
+        return None
+    if not any(count > 0 for count in counts):
+        return None
+    if branch == "row_multi" and not any(count > 1 for count in counts):
+        return None
