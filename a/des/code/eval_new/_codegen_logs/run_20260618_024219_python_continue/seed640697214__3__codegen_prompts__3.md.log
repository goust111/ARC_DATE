+    if not chosen_pairs or len(chosen_pairs) >= len(free_pairs):
+        return None
+
+    receiver_pairs = sorted(chosen_pairs)
+    filters = _filter_colors(len(receiver_pairs), tower_colors)
+    receivers = [
