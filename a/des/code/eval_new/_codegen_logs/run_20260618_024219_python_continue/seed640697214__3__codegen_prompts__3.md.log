+def _paint_between(
+    out: np.ndarray,
+    object_mask: np.ndarray,
+    current: tuple[int, int],
+    stop: tuple[int, int],
+    step: tuple[int, int],
+    color: int,
+) -> None:
+    h, w = out.shape
+    dr, dc = step
+    rr = current[0] + dr
+    cc = current[1] + dc
+    while (rr, cc) != stop:
+        if 0 <= rr < h and 0 <= cc < w and not object_mask[rr, cc]:
+            out[rr, cc] = color
+        rr += dr
+        cc += dc
+
+
+def _paint_to_edge(
+    out: np.ndarray,
+    object_mask: np.ndarray,
+    current: tuple[int, int],
+    step: tuple[int, int],
+    color: int,
