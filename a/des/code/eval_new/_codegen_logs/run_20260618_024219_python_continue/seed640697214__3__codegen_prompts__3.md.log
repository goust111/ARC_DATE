+def _filter_colors(count: int, tower_colors: list[int]) -> list[int]:
+    palette = [color for color in ACTIVE_COLORS if color not in tower_colors]
+    if not palette:
+        palette = ACTIVE_COLORS[:]
+    random.shuffle(palette)
