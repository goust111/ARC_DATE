+def _objects_on_ray(
+    start: tuple[int, int],
+    step: tuple[int, int],
+    objects: list[dict[str, object]],
+    source_center: tuple[int, int],
+) -> list[tuple[tuple[int, int], tuple[int, int], dict[str, object]]]:
+    start_r, start_c = start
+    dr, dc = step
+    hits: list[tuple[tuple[int, int], tuple[int, int], dict[str, object]]] = []
+
+    for obj in objects:
+        if tuple(obj["center"]) == source_center:
+            continue
+        r0, c0, r1, c1 = obj["bbox"]
+        if dr == 0:
+            if not (r0 <= start_r <= r1):
+                continue
+            if dc > 0:
+                if c0 <= start_c:
+                    continue
+                near = (start_r, c0)
+                far = (start_r, c1)
+            else:
+                if c1 >= start_c:
+                    continue
+                near = (start_r, c1)
+                far = (start_r, c0)
+        else:
+            if not (c0 <= start_c <= c1):
+                continue
+            if dr > 0:
+                if r0 <= start_r:
+                    continue
+                near = (r0, start_c)
+                far = (r1, start_c)
+            else:
+                if r1 >= start_r:
+                    continue
+                near = (r1, start_c)
+                far = (r0, start_c)
+        hits.append((near, far, obj))
+
+    if dr != 0:
+        hits.sort(key=lambda item: item[0][0], reverse=dr < 0)
+    else:
+        hits.sort(key=lambda item: item[0][1], reverse=dc < 0)
+    return hits
