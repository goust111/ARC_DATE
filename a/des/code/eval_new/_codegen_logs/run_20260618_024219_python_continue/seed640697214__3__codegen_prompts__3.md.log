+        grid[r - 1 : r + 2, c - 1 : c + 2] = int(tower["color"])
+    for receiver in receivers:
+        r, c = receiver["center"]
+        grid[r - 1 : r + 2, c - 1 : c + 2] = GREY
+        grid[r, c] = int(receiver["filter"])
+    return grid
