) -> list[dict]:
    seeds: list[dict] = []
    for color in np.unique(grid):
        color = int(color)
        if color in {bg, frame_color}:
            continue
        coords = np.argwhere(grid == color)
        assert coords.size > 0, "seed colors must be present"
        r0, c0 = map(int, coords.min(axis=0))
        r1, c1 = map(int, coords.max(axis=0))
        h, w = r1 - r0 + 1, c1 - c0 + 1
