def _branch_geometry(
    seed: dict,
    frame_bbox: tuple[int, int, int, int],
) -> tuple[list[tuple[int, int]], tuple[int, int], tuple[int, int]]:
    r0, c0, r1, c1 = seed["bbox"]
    fr0, fc0, fr1, fc1 = frame_bbox
    side = seed["side"]

    if side == "top":
        initial = [(fr0 + 1, c) for c in range(c0, c1 + 1)]
        grow = (1, 0)
