+    elif side == "bottom":
+        bbox = (fr1 + 1, fc0 + 1 + start, fr1 + 1, fc0 + start + length)
+    elif side == "left":
+        bbox = (fr0 + 1 + start, fc0 - 1, fr0 + start + length, fc0 - 1)
+    else:
+        bbox = (fr0 + 1 + start, fc1 + 1, fr0 + start + length, fc1 + 1)
+    return {"color": color, "side": side, "bbox": bbox, "length": length}
+
