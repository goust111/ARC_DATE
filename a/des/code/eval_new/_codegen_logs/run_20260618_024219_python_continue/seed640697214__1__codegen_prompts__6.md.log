+
+def _add_edge(adj: dict[tuple[int, int], set[tuple[int, int]]], a: tuple[int, int], b: tuple[int, int]) -> None:
+    adj.setdefault(a, set()).add(b)
+    adj.setdefault(b, set()).add(a)
