FRAME_COUNT_CHOICES = (1, 2, 3, 4)
FRAME_COUNT_WEIGHTS = (2, 3, 2, 1)
INTERIOR_H_RANGE = (2, 5)
INTERIOR_W_RANGE = (2, 5)
