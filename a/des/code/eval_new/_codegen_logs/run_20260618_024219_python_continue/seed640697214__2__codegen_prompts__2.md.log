+    return out
+
+
+def _max_length(shape: tuple[int, int], direction: tuple[int, int]) -> int:
+    h, w = shape
+    dr, dc = direction
+    return (h - 2) if dr else (w - 2)
+
+
+def _sample_arrow(
+    shape: tuple[int, int],
