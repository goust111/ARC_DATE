+
+def _count_layers(grid: np.ndarray, seed_bbox: tuple[int, int, int, int], marker_row: int) -> int:
+    r0, c0, r1, c1 = seed_bbox
+    max_offset = min(r0, c0, marker_row - 1 - r1, grid.shape[1] - 1 - c1)
+    assert max_offset >= 1
