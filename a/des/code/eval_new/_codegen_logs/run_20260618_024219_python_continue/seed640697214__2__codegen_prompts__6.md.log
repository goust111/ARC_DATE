+def _border_is(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int, color: int) -> bool:
+    if r0 < 0 or c0 < 0 or r1 >= grid.shape[0] or c1 >= grid.shape[1]:
+        return False
+    top = grid[r0, c0 : c1 + 1]
+    bottom = grid[r1, c0 : c1 + 1]
+    left = grid[r0 : r1 + 1, c0]
+    right = grid[r0 : r1 + 1, c1]
+    return bool(
