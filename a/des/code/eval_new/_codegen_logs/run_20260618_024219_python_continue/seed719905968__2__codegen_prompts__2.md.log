+def _scan_cols_candidate(grid, top, left, bg):
+    h, w = grid.shape
+    if h < 2:
+        return None
+    rows = (0, 1) if top else (h - 2, h - 1)
+    col_iter = range(0, w) if left else range(w - 1, -1, -1)
+    cols = []
+    for c in col_iter:
