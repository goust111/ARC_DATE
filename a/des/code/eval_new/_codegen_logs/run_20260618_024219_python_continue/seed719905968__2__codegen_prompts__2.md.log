+def _manhattan_path(a, b, rng):
+    r, c = a
+    tr, tc = b
+    cells = [(r, c)]
+    if rng.random() < 0.5:
+        while c != tc:
+            c += 1 if tc > c else -1
+            cells.append((r, c))
+        while r != tr:
+            r += 1 if tr > r else -1
+            cells.append((r, c))
+    else:
+        while r != tr:
+            r += 1 if tr > r else -1
+            cells.append((r, c))
+        while c != tc:
+            c += 1 if tc > c else -1
+            cells.append((r, c))
+    return cells
