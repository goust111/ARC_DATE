+def _manhattan_path(a, b, rng):
+    r, c = a
+    tr, tc = b
+    cells = [(r, c)]
+    if rng.random() < 0.5:
+        while c != tc:
+            c += 1 if tc > c else -1
+            cells.append((r, c))
+        while r != tr:
+            r += 1 if tr > r else -1
+            cells.append((r, c))
+    else:
+        while r != tr:
+            r += 1 if tr > r else -1
+            cells.append((r, c))
+        while c != tc:
+            c += 1 if tc > c else -1
+            cells.append((r, c))
+    return cells
+
+
+def _random_connected_mask(rng, h, w):
+    anchors = {
+        (0, rng.randrange(w)),
+        (h - 1, rng.randrange(w)),
+        (rng.randrange(h), 0),
+        (rng.randrange(h), w - 1),
+    }
+    order = list(anchors)
+    rng.shuffle(order)
+    cells = {order[0]}
+    current = order[0]
+    for nxt in order[1:]:
+        path = _manhattan_path(current, nxt, rng)
+        cells.update(path)
+        current = nxt
+
+    frontier = set()
+
+    def add_frontier(cell):
