+
+def _shift_for_alignment(fixed_comp, moving_comp, axis):
+    fr0, fc0, fr1, fc1 = fixed_comp["bbox"]
+    mr0, mc0, mr1, mc1 = moving_comp["bbox"]
+    fh, fw = _bbox_shape((fr0, fc0, fr1, fc1))
