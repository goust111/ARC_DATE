+
+def _bbox_from_coords(coords):
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _bbox_shape(bbox):
+    r0, c0, r1, c1 = bbox
+    return r1 - r0 + 1, c1 - c0 + 1
+
+
+def _bbox_area(bbox):
+    h, w = _bbox_shape(bbox)
+    return h * w
