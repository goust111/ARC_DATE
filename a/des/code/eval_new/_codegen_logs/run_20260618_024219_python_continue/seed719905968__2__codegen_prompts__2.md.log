+    moving_coords = moving_comp["coords"]
+    out[moving_coords[:, 0], moving_coords[:, 1]] = BG
+    fixed_cells = {tuple(map(int, cell)) for cell in fixed_comp["coords"]}
+    for r, c in moving_coords:
