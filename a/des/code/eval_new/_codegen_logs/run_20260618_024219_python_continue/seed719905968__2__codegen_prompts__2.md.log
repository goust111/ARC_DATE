+def _rect_free(blocked, r0, c0, h, w, pad=1):
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(blocked.shape[0], r0 + h + pad)
+    cc1 = min(blocked.shape[1], c0 + w + pad)
+    return not blocked[rr0:rr1, cc0:cc1].any()
+
+
+def _mark_rect(blocked, r0, c0, h, w, pad=1):
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(blocked.shape[0], r0 + h + pad)
+    cc1 = min(blocked.shape[1], c0 + w + pad)
+    blocked[rr0:rr1, cc0:cc1] = True
+
+
+def _manhattan_path(a, b, rng):
+    r, c = a
+    tr, tc = b
+    cells = [(r, c)]
+    if rng.random() < 0.5:
+        while c != tc:
+            c += 1 if tc > c else -1
+            cells.append((r, c))
+        while r != tr:
+            r += 1 if tr > r else -1
+            cells.append((r, c))
+    else:
+        while r != tr:
+            r += 1 if tr > r else -1
+            cells.append((r, c))
+        while c != tc:
+            c += 1 if tc > c else -1
+            cells.append((r, c))
+    return cells
+
+
+def _random_connected_mask(rng, h, w):
+    anchors = {
+        (0, rng.randrange(w)),
+        (h - 1, rng.randrange(w)),
+        (rng.randrange(h), 0),
+        (rng.randrange(h), w - 1),
+    }
+    order = list(anchors)
+    rng.shuffle(order)
+    cells = {order[0]}
+    current = order[0]
+    for nxt in order[1:]:
+        path = _manhattan_path(current, nxt, rng)
+        cells.update(path)
+        current = nxt
+
+    frontier = set()
+
+    def add_frontier(cell):
+        r, c = cell
+        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
+                frontier.add((nr, nc))
+
+    for cell in list(cells):
+        add_frontier(cell)
+
+    max_target = max(len(cells), min(h * w, len(cells) + max(2, (h * w) // 3)))
+    target = rng.randint(len(cells), max_target)
+    while frontier and len(cells) < target:
+        cell = rng.choice(tuple(frontier))
+        frontier.discard(cell)
+        if cell in cells:
+            continue
+        cells.add(cell)
+        add_frontier(cell)
+
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
+    return mask
+
+
+def _paint_mask(grid, bbox, mask, color):
+    r0, c0, _, _ = bbox
+    rows, cols = np.where(mask)
+    grid[r0 + rows, c0 + cols] = color
+
+
+def _overlap_count(mask_big, mask_small, axis):
