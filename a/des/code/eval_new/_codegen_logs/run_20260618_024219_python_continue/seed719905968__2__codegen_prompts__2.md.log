+        (0, rng.randrange(w)),
+        (h - 1, rng.randrange(w)),
+        (rng.randrange(h), 0),
+        (rng.randrange(h), w - 1),
+    }
+    order = list(anchors)
+    rng.shuffle(order)
+    cells = {order[0]}
+    current = order[0]
+    for nxt in order[1:]:
+        path = _manhattan_path(current, nxt, rng)
+        cells.update(path)
+        current = nxt
+
+    frontier = set()
+
+    def add_frontier(cell):
