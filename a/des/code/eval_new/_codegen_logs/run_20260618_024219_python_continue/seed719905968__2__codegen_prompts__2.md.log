+        r0, c0 = min(rows), min(cols)
+        _mark_rect(blocked, r0, c0, n, 2)
+    else:
+        cols = list(range(n)) if left else list(range(w - n, w))
+        rows = (0, 1) if top else (h - 2, h - 1)
+        upper, lower = min(rows), max(rows)
