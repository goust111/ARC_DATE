+def _extract_palette(grid, bg=BG):
+    g = np.asarray(grid, dtype=int)
+    corners = [
+        (True, True),
+        (True, False),
+        (False, True),
+        (False, False),
+    ]
+    candidates = []
+    for top, left in corners:
+        corner_r = 0 if top else g.shape[0] - 1
+        corner_c = 0 if left else g.shape[1] - 1
+        if int(g[corner_r, corner_c]) == bg:
+            continue
