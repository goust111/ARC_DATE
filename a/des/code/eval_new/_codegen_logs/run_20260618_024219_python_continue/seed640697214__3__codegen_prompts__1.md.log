+def _nearest_cardinal(seed: tuple[int, int], gap: tuple[int, int]) -> tuple[int, int] | None:
+    dr = int(gap[0] - seed[0])
+    dc = int(gap[1] - seed[1])
+    if abs(dr) > abs(dc):
+        return (1 if dr > 0 else -1, 0)
+    if abs(dc) > abs(dr):
+        return (0, 1 if dc > 0 else -1)
+    return None
