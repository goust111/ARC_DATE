+            else:
+                left = (r, c - 1) in interior
+                right = (r, c + 1) in interior
+                if left ^ right:
+                    outward = (0, 1) if left else (0, -1)
+                    options.append(((r, c), outward))
+    dedup: dict[tuple[int, int], tuple[int, int]] = {}
+    for cell, outward in options:
