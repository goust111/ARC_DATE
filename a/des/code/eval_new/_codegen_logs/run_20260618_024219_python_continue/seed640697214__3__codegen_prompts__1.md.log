+
+
+def _shape_gap_options(
+    boundary: set[tuple[int, int]],
+    interior: set[tuple[int, int]],
+    segments: list[list[tuple[int, int]]],
+) -> list[tuple[tuple[int, int], tuple[int, int]]]:
+    options: list[tuple[tuple[int, int], tuple[int, int]]] = []
+    for seg in segments:
+        if len(seg) < 3:
