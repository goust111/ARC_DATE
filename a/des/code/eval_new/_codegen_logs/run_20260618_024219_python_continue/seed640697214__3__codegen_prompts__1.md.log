+        for (gr, gc), (dr, dc) in owned_gaps:
+            r, c = gr, gc
+            steps = 0
+            while steps < area and 0 <= r < h and 0 <= c < w:
+                if int(g[r, c]) != BLACK:
+                    break
+                if int(out[r, c]) != BLACK:
+                    break
+                out[r, c] = seed_color
+                steps += 1
+                r += dr
+                c += dc
+
