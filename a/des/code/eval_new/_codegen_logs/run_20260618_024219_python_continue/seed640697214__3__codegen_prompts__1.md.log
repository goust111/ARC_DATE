+                continue
+            lr = int(grid[r, c - 1]) == GREY and int(grid[r, c + 1]) == GREY
+            ud = int(grid[r - 1, c]) == GREY and int(grid[r + 1, c]) == GREY
+            if lr ^ ud:
+                gaps[(r, c)] = "lr" if lr else "ud"
+    return gaps
