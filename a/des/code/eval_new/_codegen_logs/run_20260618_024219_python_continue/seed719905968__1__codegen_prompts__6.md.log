+        container_patch, missing = _build_container_patch(colors[idx], rect_h, rect_w, side, shape, offset)
+        layout.append(
+            {
+                "color": int(colors[idx]),
+                "shape": shape,
+                "side": side,
+                "rect_h": rect_h,
+                "rect_w": rect_w,
