+import numpy as np
+
+
+BG = 0
+KEY_COLOR = 5
+CONTAINER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+SIDES = ("top", "right", "bottom", "left")
+
+MIN_OBJECTS = 2
+MAX_OBJECTS = 4
+GRID_MIN = 20
+GRID_MAX = 30
+RECT_MIN = 6
+RECT_MAX = 10
+SHAPE_MIN_AREA = 4
+SHAPE_MAX_AREA = 8
+PLACEMENT_RETRIES = 300
+GEN_RETRIES = 400
