+    for spec in sorted(layout, key=lambda item: item["rect_h"] * item["rect_w"], reverse=True):
+        placed = False
+        for _ in range(PLACEMENT_RETRIES):
+            max_top = h - spec["rect_h"] - 1
+            max_left = w - spec["rect_w"] - 1
