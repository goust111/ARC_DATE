+        min_h = max(RECT_MIN, sh + 2)
+        min_w = max(RECT_MIN, sw + 1)
+        rect_h = int(RNG.integers(min_h, RECT_MAX + 1))
+        rect_w = int(RNG.integers(min_w, RECT_MAX + 1))
