+
+def _reserve(used: np.ndarray, top: int, left: int, h: int, w: int, pad: int = 1) -> None:
+    hh, ww = used.shape
+    r0 = max(0, top - pad)
+    c0 = max(0, left - pad)
+    r1 = min(hh, top + h + pad)
+    c1 = min(ww, left + w + pad)
+    used[r0:r1, c0:c1] = True
