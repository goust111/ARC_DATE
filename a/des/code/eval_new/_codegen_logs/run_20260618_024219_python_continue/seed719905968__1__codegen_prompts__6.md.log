+def _rotation_variants(mask: np.ndarray) -> list[np.ndarray]:
+    variants = []
+    for rot in range(4):
+        turned = _trim_mask(np.rot90(mask, rot))
+        if not any(v.shape == turned.shape and np.array_equal(v, turned) for v in variants):
+            variants.append(turned)
