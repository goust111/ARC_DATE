+        return False
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    stack = []
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if bg_mask[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if bg_mask[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+
+    while stack:
+        rr, cc = stack.pop()
+        for nr, nc in _neighbors4(rr, cc, h, w):
+            if bg_mask[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                stack.append((nr, nc))
+
+    return bool(np.any(bg_mask & ~seen))
+
+
+def _build_container_patch(
+    color: int,
+    rect_h: int,
+    rect_w: int,
+    side: str,
+    notch_mask: np.ndarray,
+    offset: int,
+) -> tuple[np.ndarray, np.ndarray]:
+    patch = np.full((rect_h, rect_w), color, dtype=int)
+    sh, sw = notch_mask.shape
+    missing = np.zeros((rect_h, rect_w), dtype=bool)
+
+    if side == "top":
+        r0, c0 = 0, offset
+    elif side == "bottom":
+        r0, c0 = rect_h - sh, offset
+    elif side == "left":
+        r0, c0 = offset, 0
+    elif side == "right":
+        r0, c0 = offset, rect_w - sw
+    else:
+        raise ValueError(f"unknown side: {side}")
+
+    missing[r0 : r0 + sh, c0 : c0 + sw] = notch_mask
+    patch[missing] = BG
+    return patch, missing
+
+
+def _extract_container(grid: np.ndarray, coords: np.ndarray, color: int) -> dict:
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    assert np.all((patch == color) | (patch == BG))
+
+    filled = patch == color
+    missing = ~filled
+    assert missing.any()
+    assert _count_components(missing) == 1
+
+    touches = [
+        bool(missing[0, :].any()),
+        bool(missing[:, -1].any()),
+        bool(missing[-1, :].any()),
+        bool(missing[:, 0].any()),
+    ]
+    assert sum(touches) == 1
+
+    notch = _trim_mask(missing)
+    return {
+        "color": int(color),
+        "bbox": (r0, c0, r1, c1),
+        "missing": missing,
+        "notch": notch,
+    }
+
