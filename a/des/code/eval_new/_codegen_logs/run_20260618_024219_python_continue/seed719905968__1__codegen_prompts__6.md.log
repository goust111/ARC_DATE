+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _find_color_components(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    mask = grid == color
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _trim_mask(mask: np.ndarray) -> np.ndarray:
+    rows = np.where(mask.any(axis=1))[0]
+    cols = np.where(mask.any(axis=0))[0]
+    assert rows.size and cols.size
+    return mask[rows[0] : rows[-1] + 1, cols[0] : cols[-1] + 1]
+
+
+def _mask_signature(mask: np.ndarray) -> tuple:
+    variants = []
+    for rot in range(4):
+        turned = _trim_mask(np.rot90(mask, rot))
+        variants.append((turned.shape, tuple(turned.astype(int).ravel().tolist())))
+    return min(variants)
+
+
+def _rotation_variants(mask: np.ndarray) -> list[np.ndarray]:
+    variants = []
+    for rot in range(4):
+        turned = _trim_mask(np.rot90(mask, rot))
+        if not any(v.shape == turned.shape and np.array_equal(v, turned) for v in variants):
+            variants.append(turned)
+    return variants
+
+
+def _count_components(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    count = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            count += 1
+            stack = [(r, c)]
+            seen[r, c] = True
+            while stack:
+                rr, cc = stack.pop()
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+    return count
+
+
+def _has_hole(mask: np.ndarray) -> bool:
+    bg_mask = ~mask
+    if not bg_mask.any():
+        return False
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
