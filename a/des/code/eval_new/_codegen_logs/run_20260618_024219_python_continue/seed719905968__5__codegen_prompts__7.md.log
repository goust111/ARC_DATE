+
+BLACK = 0
+GREY = 5
+MAROON = 9
+PALETTE_COLORS = [1, 2, 3, 4, 6, 7, 8]
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _extract_palette_color(region: np.ndarray) -> int:
+    colors = {
+        int(color)
+        for color in np.unique(region)
+        if int(color) not in (BLACK, GREY, MAROON)
+    }
+    assert len(colors) == 1
+    return colors.pop()
+
