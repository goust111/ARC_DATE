+BLACK = 0
+GREY = 5
+MAROON = 9
+PATH_COLORS = [1, 2, 3, 4, 6, 7, 8]
+NON_PATH = {BLACK, GREY, MAROON}
+MAX_GEN_ATTEMPTS = 400
