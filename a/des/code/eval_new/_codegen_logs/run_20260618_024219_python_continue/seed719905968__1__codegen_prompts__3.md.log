+            assert len(cols) == 1, "vertical paths must stay on one column"
+            assert source_starts[color][1] in cols
+
+    return {
+        "grid": g,
+        "nodes": nodes,
+        "node_centers": node_centers,
+        "sources": sources,
+        "path_dirs": path_dirs,
+        "source_boxes": source_boxes,
+    }
