+        assert bbox[2] - bbox[0] == 1 and bbox[3] - bbox[1] == 1, "every source must be 2x2"
+
+        side_cells = _source_side_candidates(g, bbox)
+        assert len(side_cells) == 1, "each source must attach to exactly one path side"
