+def _neighbor_nodes(node: tuple[int, int], n_rows: int, n_cols: int) -> list[tuple[int, int]]:
+    r, c = node
+    out: list[tuple[int, int]] = []
+    for dr, dc in DIR_ORDER:
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < n_rows and 0 <= cc < n_cols:
+            out.append((rr, cc))
