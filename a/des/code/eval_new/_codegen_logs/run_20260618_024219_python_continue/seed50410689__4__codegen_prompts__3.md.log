+def _balanced_actions(actions: list[str]) -> bool:
+    counts = [actions.count(label) for label in ("L", "R", "S")]
+    return min(counts) >= 1 and max(counts) - min(counts) <= 1
+
+
+def _search_path(
+    n_rows: int,
+    n_cols: int,
+    side: str,
+    lane: int,
+    target_len: int,
