+    start_node, start_dir = _start_state(n_rows, n_cols, side, lane)
+    path = [start_node]
+    visited = {start_node}
+    solution: tuple[list[tuple[int, int]], list[str], tuple[int, int]] | None = None
+
+    def dfs() -> bool:
