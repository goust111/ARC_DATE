+def _components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _parse_reference_segment(segment: np.ndarray) -> list[int] | None:
+    seg = [int(v) for v in segment]
+    if len(seg) < 3:
+        return None
+    for starts_with_grey in (True, False):
+        colors: list[int] = []
+        ok = True
+        for idx, value in enumerate(seg):
+            want_grey = (idx % 2 == 0) if starts_with_grey else (idx % 2 == 1)
+            if want_grey:
+                if value != GREY:
+                    ok = False
+                    break
+            else:
+                if value in (BG, GREY):
+                    ok = False
+                    break
+                colors.append(value)
+        if ok and len(colors) >= 2 and len(colors) == len(set(colors)):
+            return colors
+    return None
