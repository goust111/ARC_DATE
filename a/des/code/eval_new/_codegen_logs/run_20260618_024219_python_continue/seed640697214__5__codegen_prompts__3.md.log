+        row = grid[r]
+        non_bg = np.flatnonzero(row != bg)
+        if non_bg.size < 3:
+            continue
+        left, right = int(non_bg[0]), int(non_bg[-1])
+        segment = row[left : right + 1]
+        if np.any(segment == bg):
