+    shifted_list = sorted(shifted)
+    markers = rng.sample(shifted_list, marker_count)
+    for r, c in markers:
+        patch[r, c] = AZURE
+
+    interior = np.array(sorted(shifted), dtype=int)
+    return patch, interior
