+    return False
+
+
+def _random_shape(rng: random.Random) -> np.ndarray:
+    for _ in range(120):
+        h = rng.randint(2, 5)
+        w = rng.randint(2, 5)
+        max_cells = min(8, h * w - 1)
+        if max_cells < 3:
+            continue
+        target = rng.randint(3, max_cells)
+        start = (rng.randrange(h), rng.randrange(w))
+        cells = {start}
