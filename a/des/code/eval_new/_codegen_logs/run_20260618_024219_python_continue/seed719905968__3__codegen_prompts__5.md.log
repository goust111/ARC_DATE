+def _forced_pairs(group_indices: list[int], objects: list[dict[str, object]]) -> list[tuple[int, int]]:
+    local = [objects[idx] for idx in group_indices]
+    n = len(local)
+    edge_by_nodes: dict[frozenset[int], tuple[int, int]] = {}
+
