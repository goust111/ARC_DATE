+            edge = edge_by_nodes.get(frozenset((first, second)))
+            if edge is None:
+                continue
+            used[first] = True
+            used[second] = True
+            current.append(edge)
+            dfs()
+            current.pop()
+            used[first] = False
+            used[second] = False
