def _mask_signature(mask: np.ndarray) -> tuple[tuple[int, int], tuple[int, ...]]:
    return tuple(map(int, mask.shape)), tuple(int(v) for v in mask.ravel())


def _scale_mask(mask: np.ndarray, factor: int) -> np.ndarray:
