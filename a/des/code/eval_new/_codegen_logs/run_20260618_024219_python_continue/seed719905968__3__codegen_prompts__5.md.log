+import math
+import random
+from collections import deque
+
+import numpy as np
+
+
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_RETRIES = 400
+PAIR_COUNT_OPTIONS = (2, 3, 4)
+SCALE_OPTIONS = (2, 3)
