            used[first] = True
            used[second] = True
            current.append(edge)
            dfs()
            current.pop()
            used[first] = False
            used[second] = False

    dfs()
    if best_size <= 0 or not best_matchings:
        return []

    common = set(best_matchings[0])
    for matching in best_matchings[1:]:
