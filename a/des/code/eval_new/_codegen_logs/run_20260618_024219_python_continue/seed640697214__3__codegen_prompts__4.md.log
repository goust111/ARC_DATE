+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+AZURE = 8
+MAROON = 9
+PALETTE_ORDER = (GREEN, YELLOW, ORANGE, MAROON)
