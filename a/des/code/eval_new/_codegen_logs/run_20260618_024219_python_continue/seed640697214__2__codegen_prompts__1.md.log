+    cols = [c for c in range(c0, c1 + 1) if np.all(grid[r0 : r1 + 1, c] == YELLOW)]
+    runs: list[tuple[int, int]] = []
+    for c in cols:
+        if not runs or c != runs[-1][1] + 1:
+            runs.append((c, c))
+        else:
+            runs[-1] = (runs[-1][0], c)
+    return runs
