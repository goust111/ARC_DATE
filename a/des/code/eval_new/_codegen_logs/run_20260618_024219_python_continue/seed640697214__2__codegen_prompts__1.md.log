+    assert np.all(grid[r0, c0 : c1 + 1] == YELLOW)
+    assert np.all(grid[r1, c0 : c1 + 1] == YELLOW)
+    runs = _full_height_yellow_runs(grid, (r0, c0, r1, c1))
+    assert len(runs) >= 2, "canvas must contain at least one cell"
