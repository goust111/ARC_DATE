+    out_width = max(int(group["shape"][1]) for group in groups)
+    if out_height > _ARC_LIMIT or out_width > _ARC_LIMIT:
+        return None
+
+    return groups
+
+
+def _gen_attempt() -> np.ndarray | None:
+    groups = _sample_groups()
