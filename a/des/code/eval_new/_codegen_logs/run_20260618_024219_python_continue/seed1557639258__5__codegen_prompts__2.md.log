+                    ok = False
+                    break
+                coords = [(idx // width, idx % width) for idx in component]
+                piece = _piece_from_coords(coords)
+                if int(piece["area"]) == int(piece["height"] * piece["width"]):
+                    ok = False
+                    break
+                pieces.append(piece)
