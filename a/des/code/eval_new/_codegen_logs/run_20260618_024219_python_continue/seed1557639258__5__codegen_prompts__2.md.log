+            left = int(_RNG.integers(0, _ARC_LIMIT - piece["width"] + 1))
+            if not _can_place_piece(occupied, piece, top, left):
+                continue
+            for dr, dc in piece["cells"]:
+                rr = top + dr
+                cc = left + dc
+                canvas[rr, cc] = color
+                occupied[rr, cc] = True
+            placed = True
+            break
