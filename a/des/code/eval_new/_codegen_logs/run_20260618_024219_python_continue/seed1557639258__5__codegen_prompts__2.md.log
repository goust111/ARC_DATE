+        left_pad = int(_RNG.integers(0, int(c0) + 1))
+        bottom_pad = int(_RNG.integers(0, int(canvas.shape[0] - r1)))
+        right_pad = int(_RNG.integers(0, int(canvas.shape[1] - c1)))
