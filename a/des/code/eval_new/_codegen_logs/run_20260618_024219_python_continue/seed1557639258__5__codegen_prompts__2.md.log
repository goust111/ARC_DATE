+        selected = None
+        for height, width in choices:
+            pieces = _partition_rectangle(height, width, piece_count)
+            if pieces is None:
+                continue
+            selected = {
+                "color": int(color),
+                "shape": (int(height), int(width)),
+                "pieces": pieces,
+                "area": int(height * width),
+            }
