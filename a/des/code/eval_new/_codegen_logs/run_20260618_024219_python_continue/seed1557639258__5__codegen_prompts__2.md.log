+        for _ in range(_PARTITION_CUT_ATTEMPTS):
+            cut_ids = {
+                int(idx)
+                for idx in _RNG.choice(len(edges), size=piece_count - 1, replace=False)
+            }
+            components = _tree_components(total, edges, cut_ids)
+            if len(components) != piece_count:
