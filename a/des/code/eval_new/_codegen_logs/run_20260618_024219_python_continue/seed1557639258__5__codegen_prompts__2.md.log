+
+def _crop_canvas(canvas: np.ndarray, max_group_area: int) -> np.ndarray | None:
+    coords = np.argwhere(canvas != _BG)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+
+    for _ in range(120):
