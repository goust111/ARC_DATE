+    for dr, dc in piece["cells"]:
+        rr = top + dr
+        cc = left + dc
+        r0 = max(0, rr - 1)
+        r1 = min(h, rr + 2)
+        c0 = max(0, cc - 1)
+        c1 = min(w, cc + 2)
+        if occupied[r0:r1, c0:c1].any():
+            return False
+    return True
