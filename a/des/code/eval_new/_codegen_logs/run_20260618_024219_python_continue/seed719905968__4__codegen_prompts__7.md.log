+    vecs = [(wr - shaft[0], wc - shaft[1]) for wr, wc in wings]
+    if not all(abs(dr) == 1 and abs(dc) == 1 for dr, dc in vecs):
+        return None
+    sr = vecs[0][0] + vecs[1][0]
+    sc = vecs[0][1] + vecs[1][1]
+    if (sr == 0) == (sc == 0):
+        return None
+    if abs(sr) + abs(sc) != 2:
