+        if row_candidates and col_candidates:
+            return mask
+    return None
+
+
+def _sample_pair_spec(h: int, w: int, color_a: int, color_b: int, rng: np.random.Generator) -> PairSpec | None:
+    mask = _sample_mask(h, w, rng)
+    if mask is None:
