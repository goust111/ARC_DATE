+        w=w,
+        mask_a=mask,
+        marker_a=marker_a,
+        marker_b=marker_b,
+        color_a=color_a,
+        color_b=color_b,
+    )
+
+
+def _box_clear(reserved: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int) -> bool:
+    h_total, w_total = reserved.shape
+    if r0 < 0 or c0 < 0 or r0 + h > h_total or c0 + w > w_total:
