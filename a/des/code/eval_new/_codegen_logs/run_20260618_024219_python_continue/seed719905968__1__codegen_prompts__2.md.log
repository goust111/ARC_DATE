+        assert 0 <= r0 <= g.shape[0] - h and 0 <= c0 <= g.shape[1] - w
+        region = out[r0 : r0 + h, c0 : c0 + w]
+        assert not np.any(region != BG), "output rectangles must not overlap"
+        region[:, :] = color
