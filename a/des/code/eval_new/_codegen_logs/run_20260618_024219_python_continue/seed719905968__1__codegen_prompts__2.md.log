+    solutions: list[list[tuple[int, int]]] = []
+
+    def backtrack(used: int, acc: list[tuple[int, int]]) -> None:
+        if len(solutions) > 1:
+            return
+        if used == (1 << n) - 1:
+            solutions.append(acc.copy())
+            return
+        i = 0
+        while used & (1 << i):
+            i += 1
+        for j in range(i + 1, n):
+            if used & (1 << j):
+                continue
+            if not can_pair[i][j]:
