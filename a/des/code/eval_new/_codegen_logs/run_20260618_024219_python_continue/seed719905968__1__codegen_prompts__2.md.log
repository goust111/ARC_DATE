+        assert len(base_colors) == 1, "each block must be monochrome aside from the maroon marker"
+        color = next(iter(base_colors))
+        rel_cells = frozenset((r - r0, c - c0) for r, c in cells)
+        mr, mc = marker_cells[0]
+        out.append(
