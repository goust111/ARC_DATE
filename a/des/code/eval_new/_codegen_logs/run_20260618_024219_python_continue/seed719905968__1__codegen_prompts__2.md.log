+    out = np.zeros_like(g)
+    placements: list[tuple[int, int, int, int, int]] = []
+    for i, j in pairs:
+        a = comps[i]
+        b = comps[j]
+        h, w = a.shape
+        winner = a if a.marker_rel <= b.marker_rel else b
+        r0 = (a.bbox[0] + b.bbox[0]) // 2
+        c0 = (a.bbox[1] + b.bbox[1]) // 2
+        placements.append((r0, c0, h, w, winner.color))
