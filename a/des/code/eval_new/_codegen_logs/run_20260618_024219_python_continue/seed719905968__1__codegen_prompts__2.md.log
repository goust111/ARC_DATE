+DIM_CANDIDATES = (
+    (3, 3),
+    (3, 4),
+    (4, 3),
+    (3, 5),
+    (5, 3),
+    (4, 4),
+    (4, 5),
+    (5, 4),
+    (5, 5),
+)
+
+PAIR_COUNT_MIN = 2
+PAIR_COUNT_MAX = 4
+GRID_MAX = 30
+SHAPE_RETRIES = 500
+PLACEMENT_RETRIES = 500
+GEN_RETRIES = 300
+PAD = 1
