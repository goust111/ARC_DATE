+    positions = [
+        (r, c)
+        for r in range(row_lo, row_hi + 1)
+        for c in range(col_lo, col_hi + 1)
+        if not reserved[
+            max(0, r - PLACEMENT_PADDING) : min(grid.shape[0], r + h + PLACEMENT_PADDING),
+            max(0, c - PLACEMENT_PADDING) : min(grid.shape[1], c + w + PLACEMENT_PADDING),
+        ].any()
