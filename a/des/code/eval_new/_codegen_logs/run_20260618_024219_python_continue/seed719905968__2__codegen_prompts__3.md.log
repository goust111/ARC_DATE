+        lock_patch, inner_origin, inner_shape = _lock_patch(key_mask.shape, side, color, rng)
+        items.append(
+            {
+                "color": color,
+                "side": side,
+                "key_mask": key_mask,
+                "key_patch": key_patch,
+                "lock_patch": lock_patch,
+                "inner_origin": inner_origin,
+                "inner_shape": inner_shape,
