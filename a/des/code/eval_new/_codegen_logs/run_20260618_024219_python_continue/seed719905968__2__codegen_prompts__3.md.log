+    return patch, inner_origin, (inner_h, inner_w)
+
+
+def _place_patch(
+    grid: np.ndarray,
+    reserved: np.ndarray,
+    patch: np.ndarray,
+    row_lo: int,
+    row_hi: int,
+    col_lo: int,
+    col_hi: int,
+    rng: random.Random,
