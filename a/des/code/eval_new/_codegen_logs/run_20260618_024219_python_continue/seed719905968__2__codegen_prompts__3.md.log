+        marker_r = frame_h
+        marker_c = rng.randint(1, frame_w - 2)
+        inner_origin = (1, 1)
+    elif side == "left":
+        patch = np.zeros((frame_h, frame_w + 1), dtype=int)
+        frame_r0 = 0
+        marker_r = rng.randint(1, frame_h - 2)
+        marker_c = 0
+        inner_origin = (1, 2)
+    else:
+        patch = np.zeros((frame_h, frame_w + 1), dtype=int)
+        frame_r0 = 0
+        marker_r = rng.randint(1, frame_h - 2)
+        marker_c = frame_w
+        inner_origin = (1, 1)
