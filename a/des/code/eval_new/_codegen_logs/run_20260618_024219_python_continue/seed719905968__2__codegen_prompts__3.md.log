+GREY = 5
+SIDES = ("top", "bottom", "left", "right")
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+GENERATION_RETRIES = 400
+SHAPE_RETRIES = 200
+PLACEMENT_PADDING = 1
+OUTER_MARGIN = 1
