+
+
+def _choose_lock_shapes(
+    h: int,
+    w: int,
+    path_cells: tuple[tuple[int, int], ...],
+    lock_positions: tuple[tuple[int, int], tuple[int, int]],
+    prior_input: set[tuple[int, int]],
