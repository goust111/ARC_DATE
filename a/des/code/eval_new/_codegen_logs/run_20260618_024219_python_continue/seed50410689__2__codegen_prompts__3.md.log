+
+
+def _buffer_conflict(cells: tuple[tuple[int, int], ...] | list[tuple[int, int]], occupied: set[tuple[int, int]]) -> bool:
+    cand = {(int(r), int(c)) for r, c in cells}
+    for r, c in cand:
