+def _draw_room(grid: np.ndarray, top: int, left: int, spec: dict[str, object], wall: int) -> None:
+    inner_h = int(spec["inner_h"])
+    inner_w = int(spec["inner_w"])
+    bottom = top + inner_h + 1
+    right = left + inner_w + 1
+
