+            np.all(closed[r0 - 1, c0 - 1 : c1 + 2] == wall)
+            and np.all(closed[r1 + 1, c0 - 1 : c1 + 2] == wall)
+            and np.all(closed[r0 - 1 : r1 + 2, c0 - 1] == wall)
+            and np.all(closed[r0 - 1 : r1 + 2, c1 + 1] == wall)
+        )
+        if frame_ok:
+            rooms.append((r0, c0, r1, c1))
