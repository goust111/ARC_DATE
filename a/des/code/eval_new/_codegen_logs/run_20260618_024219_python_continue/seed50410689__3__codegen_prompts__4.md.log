+    for pos in spec["door_positions"]:
+        idx = int(pos)
+        if orientation == "top":
+            grid[top, left + 1 + idx] = BLACK
+        elif orientation == "bottom":
+            grid[bottom, left + 1 + idx] = BLACK
+        elif orientation == "left":
+            grid[top + 1 + idx, left] = BLACK
+        else:
+            grid[top + 1 + idx, right] = BLACK
+
