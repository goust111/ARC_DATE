+    placed: list[tuple[int, int, dict[str, object]]] = []
+    for spec in specs:
+        outer_h = int(spec["inner_h"]) + 2
+        outer_w = int(spec["inner_w"]) + 2
+        if outer_h + 2 >= h or outer_w + 2 >= w:
