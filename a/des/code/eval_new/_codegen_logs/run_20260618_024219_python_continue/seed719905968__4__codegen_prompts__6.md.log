        height = int(heights[depth])
        width = int(widths[depth])
        bbox = (r0, c0, r0 + height - 1, c0 + width - 1)
        frame_specs.append({"bbox": bbox, "color": int(color)})
        if depth + 1 < len(frame_colors):
            r0 += int(gap_rows[depth]) + 1
            c0 += int(gap_cols[depth]) + 1


