+        seen_sources.add(source)
+        marker_cells.add((int(r), int(c)))
+        cells = _trace_path(mask, source, step)
+        orient = "h" if step[0] == 0 else "v"
+        paths.append(
+            {
+                "source": source,
+                "marker": (int(r), int(c)),
+                "step": step,
+                "cells": cells,
+                "color": int(g[source]),
+                "orient": orient,
+            }
+        )
