+    order = sorted(range(len(pieces)), key=lambda idx: int(priority[int(pieces[idx]["color"])]))
+    for idx in order:
+        inner[np.asarray(layout[idx]["mask"], dtype=bool)] = int(pieces[idx]["color"])
+    return out
