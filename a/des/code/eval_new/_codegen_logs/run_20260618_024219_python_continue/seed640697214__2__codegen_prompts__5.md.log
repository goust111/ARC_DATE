+def _board_from_grey(grid: np.ndarray) -> dict[str, object]:
+    grey_pts = np.argwhere(grid == GREY)
+    assert grey_pts.size > 0, "expected a grey puzzle board"
+    ir0, ic0 = grey_pts.min(axis=0)
+    ir1, ic1 = grey_pts.max(axis=0)
