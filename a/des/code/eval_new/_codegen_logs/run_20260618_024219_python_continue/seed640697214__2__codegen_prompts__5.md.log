+        "bbox": (r0, c0, r1, c1),
+        "inner_bbox": (ir0, ic0, ir1, ic1),
+        "side_colors": side_colors,
+        "priority": {color: rank for rank, color in enumerate(side_colors)},
+        "hole_union": hole_union,
+    }
