+    order = sorted(range(n), key=lambda idx: (len(candidates[idx]), -int(piece_masks[idx].sum())))
+    remaining_cover = [np.zeros_like(hole_union, dtype=bool) for _ in range(n + 1)]
+    for pos in range(n - 1, -1, -1):
