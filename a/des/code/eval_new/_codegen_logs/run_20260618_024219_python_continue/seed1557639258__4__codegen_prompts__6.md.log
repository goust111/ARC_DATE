+
+
+def _split_area(total: int) -> list[tuple[int, int]]:
+    remaining = int(total)
+    pieces: list[tuple[int, int]] = []
+    while remaining > 0:
+        candidates = [area for area in ALLOWED_AREAS if int(area) <= remaining]
