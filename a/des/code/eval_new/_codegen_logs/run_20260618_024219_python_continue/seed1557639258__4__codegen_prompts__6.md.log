            if any(r not in (r0, r1) and c not in (c0, c1) for r, c in comp):
                continue

            boundary = _boundary_cells(int(r0), int(c0), int(r1), int(c1))
            if len(comp) != len(boundary) - 1:
                continue

            marker_cells: list[tuple[int, int, int]] = []
            valid = True
            for br, bc in boundary:
                value = int(g[br, bc])
                if value == int(color):
