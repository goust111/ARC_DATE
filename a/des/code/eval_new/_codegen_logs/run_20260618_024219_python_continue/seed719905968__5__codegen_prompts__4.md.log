+BLACK = 0
+GREY = 5
+SEED_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GRID_MIN = 12
+GRID_MAX = 24
+TRACK_CONFIGS = [(2, 2), (2, 3), (3, 2), (3, 3)]
+MIN_TRACK_GAP = 3
+GEN_RETRIES = 300
+SEED_ASSIGN_RETRIES = 800
