+def _build_layout(rng: random.Random) -> dict | None:
+    h_count, v_count = rng.choice(TRACK_CONFIGS)
+
+    min_h = max(GRID_MIN, 6 + (h_count - 1) * MIN_TRACK_GAP)
+    min_w = max(GRID_MIN, 6 + (v_count - 1) * MIN_TRACK_GAP)
