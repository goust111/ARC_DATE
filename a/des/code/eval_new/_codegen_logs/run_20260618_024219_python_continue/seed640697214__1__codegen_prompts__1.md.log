+def _render_expected(inp: np.ndarray, frames: list[dict[str, object]]) -> np.ndarray:
+    out = inp.copy()
+    for frame in frames:
+        gap = tuple(frame["gap"])
+        side = str(frame["side"])
+        seed_color = int(frame["seed_color"])
+        seed_count = len(frame["seed_positions"])
