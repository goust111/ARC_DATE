+    frames: list[dict[str, object]] = []
+    for color in sorted(int(v) for v in np.unique(g) if int(v) != bg):
+        for comp in _components(g == color):
+            frame = _detect_frame(g, comp, color, bg)
+            if frame is not None:
+                frames.append(frame)
