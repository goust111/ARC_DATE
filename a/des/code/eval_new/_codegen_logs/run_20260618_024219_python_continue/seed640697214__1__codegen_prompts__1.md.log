+import numpy as np
+
+
+SIDE_TO_VECTOR = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+SIDES = tuple(SIDE_TO_VECTOR)
+
+BG = 0
+GRID_MIN = 14
