+def _ray_cells(
+    gap: tuple[int, int],
+    side: str,
+    length: int,
+    shape: tuple[int, int],
+) -> list[tuple[int, int]]:
+    h, w = shape
+    dr, dc = SIDE_TO_VECTOR[side]
+    r, c = gap
+    cells: list[tuple[int, int]] = []
+    for _ in range(length):
