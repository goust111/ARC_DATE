+
+    for stamp in ordered:
+        top = int(row_map[int(stamp["color"])])
+        left = int(col_map[int(stamp["color"])])
+        pattern = np.asarray(stamp["pattern"], dtype=int)
+        sh, sw = pattern.shape
+        for dr in range(sh):
+            for dc in range(sw):
+                val = int(pattern[dr, dc])
+                if val == BG:
+                    continue
+                rr = top + dr
+                cc = left + dc
+                if 0 <= rr < canvas_h and 0 <= cc < canvas_w:
+                    out[rr, cc] = val
+    return out
+
