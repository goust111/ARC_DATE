+        return mask
+    return None
+
+
+def _make_stamp_pattern(
+    rng: random.Random,
+    base_color: int,
+    accent_pool: tuple[int, ...],
+    area: int,
+) -> np.ndarray | None:
+    mask = _random_shape_mask(rng, area)
+    if mask is None:
+        return None
+
+    pattern = np.full(mask.shape, BG, dtype=int)
+    pattern[mask] = int(base_color)
+
