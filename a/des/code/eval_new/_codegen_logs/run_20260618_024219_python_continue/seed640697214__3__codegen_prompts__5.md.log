+        coords = list(cells)
+        r0, c0, r1, c1 = _bbox(coords)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 3 or w < 3:
+            continue
+
+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in coords:
+            mask[r - r0, c - c0] = True
+        if area == h * w:
+            continue
+        return mask
+    return None
+
