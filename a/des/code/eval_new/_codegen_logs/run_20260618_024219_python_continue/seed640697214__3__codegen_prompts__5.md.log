+    out = [-1] * len(limits)
+
+    def search(pos: int) -> bool:
+        if pos == len(order):
+            return True
+        idx = order[pos]
+        choices = [v for v in range(limits[idx] + 1) if v not in used]
+        rng.shuffle(choices)
+        for value in choices:
+            used.add(value)
+            out[idx] = value
+            if search(pos + 1):
+                return True
+            used.remove(value)
+            out[idx] = -1
+        return False
