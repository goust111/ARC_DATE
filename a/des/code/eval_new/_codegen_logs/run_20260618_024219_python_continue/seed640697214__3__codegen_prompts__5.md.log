+    expected = _compose_output(
+        canvas_h=canvas_h,
+        canvas_w=canvas_w,
+        canvas_color=CANVAS_FILL,
+        row_map={int(stamp["color"]): int(stamp["out_r"]) for stamp in stamps},
+        col_map={int(stamp["color"]): int(stamp["out_c"]) for stamp in stamps},
+        stamps=stamps,
