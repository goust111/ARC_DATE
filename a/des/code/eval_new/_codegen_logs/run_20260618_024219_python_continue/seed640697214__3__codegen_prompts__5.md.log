+
+def _random_shape_mask(rng: random.Random, area: int) -> np.ndarray | None:
+    for _ in range(200):
+        cells = {(rng.randrange(5), rng.randrange(5))}
+        while len(cells) < area:
+            frontier: set[tuple[int, int]] = set()
+            for r, c in cells:
+                for dr, dc in DIR4:
+                    nr = r + dr
+                    nc = c + dc
+                    if 0 <= nr < 5 and 0 <= nc < 5 and (nr, nc) not in cells:
