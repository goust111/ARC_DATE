+            tuple(stamp.get("bbox", (-1, -1, -1, -1))),
+        ),
+    )
+
+    for stamp in ordered:
+        top = int(row_map[int(stamp["color"])])
+        left = int(col_map[int(stamp["color"])])
+        pattern = np.asarray(stamp["pattern"], dtype=int)
+        sh, sw = pattern.shape
+        for dr in range(sh):
+            for dc in range(sw):
+                val = int(pattern[dr, dc])
