+    c1 = int(canvas["c1"])
+    canvas_color = int(canvas["color"])
+
+    row_map: dict[int, int] = {}
+    col_map: dict[int, int] = {}
+
+    for c in range(c0, c1 + 1):
+        val = int(g[r0 - 1, c])
+        if val not in (BG, canvas_color):
+            col_map[val] = c - c0
