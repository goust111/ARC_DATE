+                    if 0 <= nr < 5 and 0 <= nc < 5 and (nr, nc) not in cells:
+                        frontier.add((nr, nc))
+            if not frontier:
+                break
+            cells.add(rng.choice(tuple(frontier)))
+        if len(cells) != area:
+            continue
