+import numpy as np
+
+
+BG = 8
+FRAME = 5
+ARROW = 9
+BLOCK_COLORS = [1, 2, 3, 4, 6, 7, 9]
+SIDES = ["top", "bottom", "left", "right"]
+GEN_ATTEMPTS = 400
