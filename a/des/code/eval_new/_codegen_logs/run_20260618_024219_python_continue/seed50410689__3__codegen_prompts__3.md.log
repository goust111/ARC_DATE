+                "r0": r0,
+                "r1": r1,
+                "c0": c0,
+                "c1": c1,
+                "h": r1 - r0 + 1,
+                "w": c1 - c0 + 1,
+            }
+        )
+    frames.sort(key=lambda f: (f["r0"], f["c0"]))
+    return frames
