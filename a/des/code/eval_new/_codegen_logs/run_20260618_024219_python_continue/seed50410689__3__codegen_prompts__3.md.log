+    elif dr == 1 and dc == 0:
+        coords = [(r, line) for r in range(h)]
+    else:
+        coords = [(r, line) for r in range(h - 1, -1, -1)]
+
+    palette: list[int] = []
+    in_run = False
+    last_color = None
+    for r, c in coords:
+        if arrow_mask[r, c]:
+            in_run = False
+            last_color = None
+            continue
+        color = int(grid[r, c])
+        if color in (BG, FRAME):
+            in_run = False
+            last_color = None
+            continue
+        if (not in_run) or color != last_color:
+            palette.append(color)
+            in_run = True
+            last_color = color
