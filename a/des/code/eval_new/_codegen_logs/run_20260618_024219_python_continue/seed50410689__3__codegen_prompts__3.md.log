+    for frame, arrow in _pair_frames_arrows(frames, arrows):
+        palette = _scan_palette(g, arrow, arrow_mask)
+        inner_h = frame["h"] - 2
+        inner_w = frame["w"] - 2
+        if arrow["axis"] == "row":
