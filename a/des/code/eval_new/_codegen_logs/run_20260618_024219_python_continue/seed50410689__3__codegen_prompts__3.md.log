+    if slack < 0:
+        return None
+    extras = [0] * (len(lengths) + 1)
+    for _ in range(slack):
+        extras[rng.randrange(len(extras))] += 1
+    starts = []
+    pos = margin + extras[0]
+    for i, length in enumerate(lengths):
+        starts.append(pos)
+        pos += length
+        if i < len(lengths) - 1:
+            pos += gap + extras[i + 1]
