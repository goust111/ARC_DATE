+            continue
+        if side == "left":
+            dr, dc = 0, 1
+            axis = "row"
+        elif side == "right":
+            dr, dc = 0, -1
+            axis = "row"
+        elif side == "top":
+            dr, dc = 1, 0
+            axis = "col"
+        else:
+            dr, dc = -1, 0
+            axis = "col"
+        for r, c in pts:
