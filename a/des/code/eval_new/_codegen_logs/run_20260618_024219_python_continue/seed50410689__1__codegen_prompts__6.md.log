+                    ac1 = min(width, c1 + aw)
+                mask[ar0 : ar0 + ah, ac0:ac1] = True
+
+        for _ in range(rng.randint(0, 2)):
+            rows, cols = np.nonzero(mask)
+            if rows.size == 0:
