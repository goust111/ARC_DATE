+def _visible_pattern_color(grid: np.ndarray) -> int:
+    colors = [int(v) for v in np.unique(grid) if int(v) not in (BG, OCCLUDER)]
+    assert len(colors) == 1, "expected exactly one visible bottom-layer color"
