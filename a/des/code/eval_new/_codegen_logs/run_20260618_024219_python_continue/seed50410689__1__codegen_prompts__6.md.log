+
+def _window_rect_ok(mask: np.ndarray, r0: int, c0: int, hh: int, ww: int) -> bool:
+    height, width = map(int, mask.shape)
+    if r0 <= 0 or c0 <= 0 or r0 + hh >= height or c0 + ww >= width:
+        return False
+    return bool(mask[r0 - 1 : r0 + hh + 1, c0 - 1 : c0 + ww + 1].all())
