+    mask = _make_occluder_mask(height, width, need_cells, rng)
+    if mask is None:
+        return None
+    mask = _carve_windows(mask, pr, pc, rng)
+    if mask is None:
+        return None
+
+    grid = output.copy()
+    grid[mask] = OCCLUDER
+
+    if not np.any(grid == color):
+        return None
+    if np.array_equal(grid, output):
+        return None
+    if np.array_equal(main(grid), output):
+        return grid
+    return None
+
