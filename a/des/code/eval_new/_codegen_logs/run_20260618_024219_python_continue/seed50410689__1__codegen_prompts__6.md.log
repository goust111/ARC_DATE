+        return False
+    return bool(mask[r0 - 1 : r0 + hh + 1, c0 - 1 : c0 + ww + 1].all())
+
+
+def _carve_windows(mask: np.ndarray, pr: int, pc: int, rng: random.Random) -> np.ndarray | None:
+    working = mask.copy()
+    halo = _halo_cells(mask)
+    coords = list(zip(*np.nonzero(halo)))
+    rng.shuffle(coords)
