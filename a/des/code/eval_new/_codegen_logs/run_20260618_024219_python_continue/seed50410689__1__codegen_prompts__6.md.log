+    by_residue: dict[tuple[int, int], list[tuple[int, int]]] = {
+        (rr, cc): [] for rr in range(pr) for cc in range(pc)
+    }
+    for r, c in coords:
+        by_residue[(int(r % pr), int(c % pc))].append((int(r), int(c)))
