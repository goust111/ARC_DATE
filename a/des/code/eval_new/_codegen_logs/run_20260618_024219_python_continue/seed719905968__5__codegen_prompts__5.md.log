+    min_c = min(c0 for _block, _r0, c0 in placements)
+    max_r = max(r0 + block.shape[0] - 1 for block, r0, _c0 in placements)
+    max_c = max(c0 + block.shape[1] - 1 for block, _r0, c0 in placements)
