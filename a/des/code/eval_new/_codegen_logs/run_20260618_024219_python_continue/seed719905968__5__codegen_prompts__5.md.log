+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    if np.array_equal(out, grid):
+        return None
+    if out.shape != grid.shape or max(out.shape) > 30:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GENERATION_ATTEMPTS):
