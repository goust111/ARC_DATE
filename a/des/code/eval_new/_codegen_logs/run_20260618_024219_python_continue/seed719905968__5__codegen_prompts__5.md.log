+    crop_left = int(rng.integers(0, min(3, min_c + 1)))
+    crop_bottom = int(rng.integers(0, min(3, CANVAS_SIZE - max_r)))
+    crop_right = int(rng.integers(0, min(3, CANVAS_SIZE - max_c)))
