+    return block
+
+
+def _find_block_positions(occupied: np.ndarray, block_shape: tuple[int, int], padding: int) -> list[tuple[int, int]]:
+    height, width = map(int, occupied.shape)
+    block_height, block_width = map(int, block_shape)
