+    c1 = c0 + inner_w + 1
+    grid[r0, c0 : c1 + 1] = FRAME_COLOR
+    grid[r1, c0 : c1 + 1] = FRAME_COLOR
+    grid[r0 : r1 + 1, c0] = FRAME_COLOR
+    grid[r0 : r1 + 1, c1] = FRAME_COLOR
+
+    if direction == "up":
+        gap = (r0, _RNG.randint(c0 + 1, c1 - 1))
+    elif direction == "down":
+        gap = (r1, _RNG.randint(c0 + 1, c1 - 1))
+    elif direction == "left":
+        gap = (_RNG.randint(r0 + 1, r1 - 1), c0)
+    else:
+        gap = (_RNG.randint(r0 + 1, r1 - 1), c1)
+    grid[gap] = BG
