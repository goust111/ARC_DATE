+import numpy as np
+
+
+BG = 0
+FRAME_COLOR = 5
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRECTIONS = ("up", "down", "left", "right")
+
+GRID_MIN = 15
+GRID_MAX = 30
+INNER_MIN = 3
+INNER_MAX = 7
+GEN_ATTEMPTS = 400
+PLACEMENT_TRIES = 150
+TRUNCATION_PROB = 0.3
+TIE_GRID_PROB = 0.6
+
+_RNG = random.Random()
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flat)).most_common(1)[0][0])
