+
+    if direction == "up":
+        visible = rng.randint(1, inner_h - 1)
+        row = visible
+        col = rng.randint(0, w - outer_w)
+        return row, col
+    if direction == "down":
+        visible = rng.randint(1, inner_h - 1)
+        row = h - outer_h - visible
+        col = rng.randint(0, w - outer_w)
+        return row, col
+    if direction == "left":
+        visible = rng.randint(1, inner_w - 1)
+        row = rng.randint(0, h - outer_h)
+        col = visible
+        return row, col
+    visible = rng.randint(1, inner_w - 1)
+    row = rng.randint(0, h - outer_h)
+    col = w - outer_w - visible
+    return row, col
+
+
+def _random_seeds(
+    rng: random.Random,
