+        for row in range(inner_h):
+            for col in range(inner_w // 2):
+                mirror = inner_w - 1 - col
+                if mirror != col:
+                    options.append(((row, col), (row, mirror)))
+        for col in range(inner_w):
+            for row in range(inner_h // 2):
