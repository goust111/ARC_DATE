+        if mindist >= 1:
+            colors = rng.sample(SEED_COLORS, count)
+            return [(r, c, colors[i]) for i, (r, c) in enumerate(picks)]
+    colors = rng.sample(SEED_COLORS, count)
+    picks = rng.sample(cells, count)
+    return [(r, c, colors[i]) for i, (r, c) in enumerate(picks)]
+
+
+def _paint_frame(
+    grid: np.ndarray,
+    r0: int,
+    c0: int,
+    inner_h: int,
+    inner_w: int,
+    direction: str,
+    seeds: list[tuple[int, int, int]],
+) -> None:
