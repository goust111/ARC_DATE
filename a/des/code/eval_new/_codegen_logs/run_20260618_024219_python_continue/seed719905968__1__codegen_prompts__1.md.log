+    outer_w = inner_w + 2
+    if direction == "up":
+        return r0 - inner_h, c0 + 1, r0 - 1, c0 + inner_w
+    if direction == "down":
+        return r0 + outer_h, c0 + 1, r0 + outer_h + inner_h - 1, c0 + inner_w
+    if direction == "left":
+        return r0 + 1, c0 - inner_w, r0 + inner_h, c0 - 1
+    return r0 + 1, c0 + outer_w, r0 + inner_h, c0 + outer_w + inner_w - 1
