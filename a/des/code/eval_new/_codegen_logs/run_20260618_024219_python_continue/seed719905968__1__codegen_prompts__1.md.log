+    count = rng.randint(2, 4)
+    cells = [(r, c) for r in range(inner_h) for c in range(inner_w)]
+    for _ in range(60):
+        picks = rng.sample(cells, count)
+        mindist = min(
+            max(abs(r0 - r1), abs(c0 - c1))
+            for i, (r0, c0) in enumerate(picks)
+            for r1, c1 in picks[i + 1 :]
