+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+FRAME_COLOR = 5
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRECTIONS = ("up", "down", "left", "right")
+
+GRID_MIN = 15
+GRID_MAX = 30
+INNER_MIN = 3
+INNER_MAX = 7
+GEN_ATTEMPTS = 400
+PLACEMENT_TRIES = 150
+TRUNCATION_PROB = 0.3
+TIE_GRID_PROB = 0.6
+
+_RNG = random.Random()
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flat)).most_common(1)[0][0])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _border_points(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    pts = set()
+    for c in range(c0, c1 + 1):
+        pts.add((r0, c))
+        pts.add((r1, c))
+    for r in range(r0, r1 + 1):
+        pts.add((r, c0))
+        pts.add((r, c1))
+    return pts
+
+
+def _frame_info(
+    grid: np.ndarray,
+    coords: list[tuple[int, int]],
+    color: int,
+    bg: int,
+) -> dict | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    if r1 - r0 < 4 or c1 - c0 < 4:
+        return None
+
+    border = _border_points(r0, c0, r1, c1)
+    comp = set(coords)
+    if not comp.issubset(border):
+        return None
+    missing = list(border - comp)
+    if len(missing) != 1:
+        return None
+
+    mr, mc = missing[0]
+    if mr in (r0, r1) and mc in (c0, c1):
+        return None
+    if mr == r0:
+        direction = "up"
+    elif mr == r1:
+        direction = "down"
+    elif mc == c0:
+        direction = "left"
+    elif mc == c1:
+        direction = "right"
+    else:
+        return None
+
+    inner = grid[r0 + 1 : r1, c0 + 1 : c1]
+    seed_positions = np.argwhere(inner != bg)
+    if not (2 <= len(seed_positions) <= 4):
+        return None
+
+    seed_colors = [int(inner[r, c]) for r, c in seed_positions]
+    if len(set(seed_colors)) != len(seed_colors):
+        return None
+    if any(int(inner[r, c]) == color for r, c in seed_positions):
+        return None
+
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "direction": direction,
+        "frame_color": color,
+    }
+
+
+def _find_frames(grid: np.ndarray, bg: int) -> list[dict]:
+    frames: list[dict] = []
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != bg):
+        for comp in _components(grid == color):
+            info = _frame_info(grid, comp, color, bg)
+            if info is not None:
+                frames.append(info)
+    frames.sort(key=lambda item: item["bbox"])
+    return frames
+
+
+def _filled_pattern(inner: np.ndarray, bg: int) -> np.ndarray:
+    pattern = inner.copy()
+    seeds = [(int(r), int(c), int(inner[r, c])) for r, c in np.argwhere(inner != bg)]
+    for r, c in np.argwhere(inner == bg):
+        r = int(r)
+        c = int(c)
+        best_dist = None
+        best_color = bg
+        tie = False
+        for sr, sc, color in seeds:
+            dist = max(abs(r - sr), abs(c - sc))
+            if best_dist is None or dist < best_dist:
+                best_dist = dist
+                best_color = color
+                tie = False
+            elif dist == best_dist:
+                tie = True
+        if not tie:
+            pattern[r, c] = best_color
+    return pattern
+
+
+def _paste_full(out: np.ndarray, block: np.ndarray, top: int, left: int) -> None:
+    h, w = out.shape
+    bh, bw = block.shape
+    for r in range(bh):
