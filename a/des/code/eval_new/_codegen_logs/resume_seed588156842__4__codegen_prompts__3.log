+        "conflicts": 0,
+        "terminal_hits": 0,
+        "blocked_by_occupied": 0,
+        "dead_end_stops": 0,
+        "preferred_used": 0,
+        "straight_used": 0,
+        "remaining_used": 0,
+        "painted": 0,
+    }
