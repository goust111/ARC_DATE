+def _neighbor_cells(shape: tuple[int, int], r: int, c: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    for dr, dc in DIRS:
+        rr = int(r + dr)
+        cc = int(c + dc)
