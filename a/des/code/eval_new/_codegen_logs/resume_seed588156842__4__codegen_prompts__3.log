+    edges: set[frozenset[tuple[int, int]]] = set()
+
+    while stack:
+        cell = stack[-1]
+        unseen = [nb for nb in _lattice_neighbors(cell, rows, cols) if nb not in seen]
+        if not unseen:
+            stack.pop()
+            continue
+        nxt = random.choice(unseen)
+        seen.add(nxt)
+        edges.add(frozenset((cell, nxt)))
+        stack.append(nxt)
