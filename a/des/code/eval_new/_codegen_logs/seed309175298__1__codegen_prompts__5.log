+
+    expected = sorted((int(spec["count"]), str(spec["shape"])) for spec in placed_specs)
+    observed = sorted((int(region["count"]), str(region["shape"])) for region in regions)
+    if expected != observed:
+        return None
+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return None
+    return grid
