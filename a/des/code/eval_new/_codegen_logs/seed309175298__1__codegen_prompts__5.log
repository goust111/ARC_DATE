+        horizontal = [(elbow_r, elbow_c + i) for i in range(arm_h)]
+    else:
+        elbow_r, elbow_c = top + arm_v - 1, left + arm_h - 1
+        vertical = [(elbow_r - i, elbow_c) for i in range(arm_v)]
+        horizontal = [(elbow_r, elbow_c - i) for i in range(arm_h)]
+
+    return sorted(set(vertical + horizontal))
