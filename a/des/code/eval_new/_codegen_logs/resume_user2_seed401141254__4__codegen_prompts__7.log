+    for step in range(1, gap + 1):
+        c = left_c - step
+        if c < 0:
+            break
+        _schedule_paint(paint, seed_mask, row, c, right_color)
+    for step in range(1, gap + 1):
+        c = right_c + step
+        if c >= width:
