+        turn_count = random.choice(RIGHT_END_TURNS)
+    else:
+        turn_count = random.choice(VERTICAL_END_TURNS)
+
+    if w < max(8, turn_count + 6) or h < 8:
+        return None
+
+    path = _build_path(h, w, strip_side, end_style, turn_count)
+    if path is None:
+        return None
+
+    if len(set(path)) != len(path):
+        return None
