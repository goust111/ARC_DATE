+    end_row = 0 if strip_side == "bottom" else h - 1
+    m = (turn_count + 1) // 2
+    cols = _sample_increasing(m, 2, w - 2, MIN_COL_GAP)
+    if cols is None:
+        return None
+    rows = _sample_rows(m, h)
+    path = [(rows[0], 0)]
+    for i, col in enumerate(cols):
+        _append_segment(path, (rows[i], col))
+        if i + 1 < len(rows):
+            _append_segment(path, (rows[i + 1], col))
+        else:
