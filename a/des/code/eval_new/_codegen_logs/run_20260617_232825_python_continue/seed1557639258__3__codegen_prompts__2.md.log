+def _crop_patch(patch: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(patch != BLACK)
+    r0, c0, r1, c1 = _bbox(coords)
+    return patch[r0 : r1 + 1, c0 : c1 + 1]
