+    sr0 = fr0 + 1 + top_gap
+    sc0 = fc0 + 1 + left_gap
+    sr1 = sr0 + sh - 1
+    sc1 = sc0 + sw - 1
+    _paste(inp, stamp, sr0, sc0)
+
+    dot_colors = [int(v) for v in rng.choice(DOT_COLORS, size=n_dots, replace=False)]
+    for direction, color in zip(directions, dot_colors):
