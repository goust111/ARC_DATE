+        rng.shuffle(flat)
+
+    if len(np.unique(stamp)) < 2:
+        stamp[0, 0] = colors[0]
+        stamp[-1, -1] = colors[1]
+    return stamp
+
+
+def _build_frame_case(rng: np.random.Generator) -> dict[str, np.ndarray] | None:
+    n_dots = int(rng.integers(1, 5))
