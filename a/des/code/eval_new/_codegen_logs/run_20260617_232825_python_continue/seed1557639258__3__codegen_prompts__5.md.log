+            cc = int(rng.integers(sc0, sc1 + 1))
+        elif direction == "down":
+            rr = int(rng.integers(sr1 + 2, fr1))
+            cc = int(rng.integers(sc0, sc1 + 1))
+        elif direction == "left":
+            rr = int(rng.integers(sr0, sr1 + 1))
+            cc = int(rng.integers(fc0 + 1, sc0 - 1))
+        else:
