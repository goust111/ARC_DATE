+def _segments(size: int, bands: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    pieces: list[tuple[int, int]] = []
+    start = 0
+    for b0, b1 in bands:
+        if start <= b0 - 1:
+            pieces.append((start, b0 - 1))
+        start = b1 + 1
+    if start <= size - 1:
+        pieces.append((start, size - 1))
+    return pieces
