+        layer = np.full((panel_h, panel_w), bg, dtype=int)
+        for rr, cc in shape:
+            color = accent_color if (rr, cc) in accent_cells else layer_color
+            panel[ar + rr, ac + cc] = color
+            layer[rr, cc] = color
+        placement_data.append((order_index[anchor_colors[idx]], layer))
