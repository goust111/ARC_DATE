+def _checkerboard(h: int, w: int, phase: int) -> np.ndarray:
+    rows = np.arange(h)[:, None]
+    cols = np.arange(w)[None, :]
+    return np.where((rows + cols + phase) % 2 == 0, AZURE, WHITE).astype(int)
+
