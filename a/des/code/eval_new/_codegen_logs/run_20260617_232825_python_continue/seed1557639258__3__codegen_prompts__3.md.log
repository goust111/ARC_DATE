+import random
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+AZURE = 8
+WHITE = 0
+MAROON = 9
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+OBJECT_PALETTE = [1, 2, 3, 4, 5, 6, 7]
