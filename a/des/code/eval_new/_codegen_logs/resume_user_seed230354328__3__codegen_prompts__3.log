+def _node_color_plan(count: int) -> list[int]:
+    colors = [RED, BLUE]
+    while len(colors) < count:
+        colors.append(random.choice((RED, BLUE)))
+    random.shuffle(colors)
+    return colors[:count]
+
+
+def _gen_attempt() -> np.ndarray | None:
