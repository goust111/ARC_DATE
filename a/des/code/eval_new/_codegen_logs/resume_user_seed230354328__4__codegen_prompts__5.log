+            return True
+    return False
+
+
+def _make_core_scene(bg: int, palette: list[int]) -> np.ndarray | None:
+    h = random.randint(7, 12)
+    w = random.randint(7, 12)
+    grid = np.full((h, w), int(bg), dtype=int)
+    blocked = np.zeros((h, w), dtype=bool)
