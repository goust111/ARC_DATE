+
+
+def _full_rows(grid: np.ndarray) -> list[tuple[int, int]]:
+    g = np.asarray(grid, dtype=int)
+    rows: list[tuple[int, int]] = []
+    for r in range(g.shape[0]):
+        value = int(g[r, 0])
+        if bool(np.all(g[r, :] == value)):
+            rows.append((int(r), int(value)))
+    return rows
