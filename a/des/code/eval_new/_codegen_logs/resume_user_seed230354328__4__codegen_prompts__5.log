+        top_dist = int(r)
+        bottom_dist = int(h - 1 - r)
+        if top_dist <= bottom_dist:
+            side = "top"
+            distance = top_dist
+        else:
+            side = "bottom"
+            distance = bottom_dist
+        lines.append(
