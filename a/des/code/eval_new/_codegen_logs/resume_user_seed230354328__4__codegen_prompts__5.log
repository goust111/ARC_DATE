+        return keep
+
+    if side == "left":
+        outer = g[:, :index]
+        keep = g[:, index + 1 :].copy()
+        assert keep.size > 0
+        assert outer.shape[1] <= keep.shape[1]
+        if outer.size:
+            folded = np.fliplr(outer)
+            keep[:, : outer.shape[1]] = _overlay_with_priority(
+                keep[:, : outer.shape[1]], folded, bg
+            )
+        return keep
+
+    outer = g[:, index + 1 :]
+    keep = g[:, :index].copy()
+    assert keep.size > 0
+    assert outer.shape[1] <= keep.shape[1]
+    if outer.size:
