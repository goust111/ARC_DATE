+                "orientation": "H",
+                "index": int(r),
+                "side": side,
+                "distance": int(distance),
+            }
+        )
+
+    for c, value in _full_cols(g):
+        if int(value) != int(fold_color):
+            continue
+        left_dist = int(c)
+        right_dist = int(w - 1 - c)
+        if left_dist <= right_dist:
+            side = "left"
+            distance = left_dist
+        else:
+            side = "right"
+            distance = right_dist
+        lines.append(
