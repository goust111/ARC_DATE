+
+def _corner_position(corner: str, grid_shape: tuple[int, int], block_shape: tuple[int, int]) -> tuple[int, int]:
+    gh, gw = grid_shape
+    bh, bw = block_shape
+    if corner == "tl":
+        return 0, 0
+    if corner == "tr":
