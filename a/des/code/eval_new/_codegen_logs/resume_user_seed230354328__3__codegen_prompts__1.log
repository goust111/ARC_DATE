+        "inner_w": inner_w,
+        "seed_color": seed_color,
+        "gap_dir": gap_dir,
+    }
+
+
+def _expected_output(grid: np.ndarray, fences: list[dict[str, int | str]], mapping: dict[int, np.ndarray]) -> np.ndarray:
