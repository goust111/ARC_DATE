+
+def _tile_pattern(pattern: np.ndarray, shape: tuple[int, int], color: int) -> np.ndarray:
+    ph, pw = pattern.shape
+    oh, ow = shape
+    rr = np.arange(oh)[:, None] % ph
+    cc = np.arange(ow)[None, :] % pw
+    mask = pattern[rr, cc]
+    return np.where(mask, color, BG).astype(int)
