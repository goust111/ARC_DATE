+        elif gap_r == r1 and c0 < gap_c < c1:
+            gap_dir = "down"
+        elif gap_c == c0 and r0 < gap_r < r1:
+            gap_dir = "left"
+        elif gap_c == c1 and r0 < gap_r < r1:
