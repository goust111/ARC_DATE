+def _rounded_gap_sizes(total_gap: int, gap_count: int) -> list[int]:
+    boundaries = [int(math.floor(i * total_gap / gap_count + 0.5)) for i in range(gap_count + 1)]
+    return [boundaries[i + 1] - boundaries[i] for i in range(gap_count)]
+
