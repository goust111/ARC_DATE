+    br, bc = map(int, b_pos[0])
+    ur, uc = map(int, untouched_pos[0])
+    if int(out[mr, mc]) != mix_color:
+        return None
+    if int(out[ar, ac]) != source_a:
+        return None
+    if int(out[br, bc]) != source_b:
+        return None
+    if int(out[ur, uc]) != MAROON:
+        return None
