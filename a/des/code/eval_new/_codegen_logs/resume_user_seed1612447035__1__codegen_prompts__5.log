+            state = (r, c, dr, dc)
+            assert state not in seen, "beam path must not loop"
+            seen.add(state)
+
+            nr, nc = r + dr, c + dc
+            if not _in_bounds(body.shape, nr, nc):
+                break
+            if (nr, nc) in sources:
+                break
+            if (nr, nc) in mirrors:
+                dr, dc = REFLECT[mirrors[(nr, nc)]][(dr, dc)]
+                continue
