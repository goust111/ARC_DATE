+            elif cell == MAROON:
+                target_hits.setdefault((nr, nc), set()).add(color)
+            else:
+                raise AssertionError("main area may only contain sources, mirrors, targets, and background")
+            r, c = nr, nc
+
+    return bg_hits, target_hits
