+
+    for pair in latent_pairs:
+        patch = pair["sprite_patch"]
+        sh, sw = patch.shape
+        placed = False
+        for _ in range(120):
+            top = rng.randint(0, h - sh)
+            left = rng.randint(0, w - sw)
+            bbox = (top, left, top + sh - 1, left + sw - 1)
+            if not _can_place(bbox, reserved, 1, h, w):
+                continue
+            sprite_specs.append(
