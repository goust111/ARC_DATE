+        if horizontal and rng.random() < 0.5:
+            max_r = max(r for r, _ in norm_cells)
+            norm_cells = {(max_r - r, c) for r, c in norm_cells}
+            norm_arrow = {(max_r - r, c) for r, c in norm_arrow}
+        if rng.random() < 0.5:
+            max_r = max(r for r, _ in norm_cells)
+            max_c = max(c for _, c in norm_cells)
