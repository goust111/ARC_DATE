+from __future__ import annotations
+
+import numpy as np
+
+BG = 0
+GREY = 5
+AZURE = 8
+MAROON = 9
+BODY_COLORS = (1, 2, 3, 4, 6, 7)
+DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_RETRIES = 400
