+
+def _shift(coords: set[tuple[int, int]], dr: int, dc: int) -> set[tuple[int, int]]:
+    return {(r + dr, c + dc) for r, c in coords}
+
+
+def _expanded(coords: set[tuple[int, int]], pad: int = 1) -> set[tuple[int, int]]:
