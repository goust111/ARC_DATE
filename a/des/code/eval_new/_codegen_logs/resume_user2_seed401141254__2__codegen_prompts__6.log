+
+    for item in stats:
+        contributed = int(item["final_inbounds"]) + int(item["embedded"])
+        if contributed < 2:
+            return None
+
+    if max(inp.shape) > 30 or max(out.shape) > 30:
+        return None
+
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GEN_RETRIES):
