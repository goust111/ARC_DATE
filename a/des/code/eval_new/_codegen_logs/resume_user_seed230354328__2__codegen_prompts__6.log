+    pieces: list[np.ndarray] = []
+    for idx, win in enumerate(windows):
+        if idx:
+            pieces.append(np.full((win.shape[0], 1), GREY, dtype=int))
+        pieces.append(win)
+    return np.hstack(pieces)
