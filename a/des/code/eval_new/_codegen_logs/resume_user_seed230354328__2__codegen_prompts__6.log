+
+def _base_shapes(size: int) -> list[np.ndarray]:
+    mid = size // 2
+    shapes: list[np.ndarray] = []
+
+    mask = np.zeros((size, size), dtype=bool)
+    mask[:, 0] = True
+    mask[-1, :] = True
+    shapes.append(mask)
+
+    mask = np.zeros((size, size), dtype=bool)
+    mask[0, :] = True
+    mask[:, mid] = True
+    shapes.append(mask)
+
+    mask = np.zeros((size, size), dtype=bool)
+    mask[mid, :] = True
+    mask[:, mid] = True
+    shapes.append(mask)
+
+    mask = np.zeros((size, size), dtype=bool)
+    mask[:, 0] = True
+    mask[:, -1] = True
+    mask[-1, :] = True
+    shapes.append(mask)
+
+    mask = np.zeros((size, size), dtype=bool)
+    mask[:, 0] = True
+    mask[0, :] = True
+    mask[mid, :] = True
+    mask[-1, :] = True
+    shapes.append(mask)
