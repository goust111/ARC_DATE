+def _point_in_convex(p: tuple[int, int], hull: list[tuple[int, int]]) -> bool:
+    x, y = p
+    n = len(hull)
+    for i in range(n):
+        x0, y0 = hull[i]
+        x1, y1 = hull[(i + 1) % n]
+        if (x1 - x0) * (y - y0) - (y1 - y0) * (x - x0) < 0:
+            return False
+    return True
