+        assert len(pts) in (3, 4), f"expected 3 or 4 vertices for color {color}, got {len(pts)}"
+        groups.append((len(pts), min(pts), color, pts))
+
+    for _, _, color, pts in sorted(groups):
+        for r, c in _filled_region(pts):
+            out[r, c] = color
+
+    return out
