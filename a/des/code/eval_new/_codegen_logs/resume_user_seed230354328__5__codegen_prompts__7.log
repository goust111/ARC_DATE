+                (br + rng.randint(1, box_h - 2), bc + box_w - 1),
+                (br + box_h - 1, bc + rng.randint(1, box_w - 2)),
+                (br + rng.randint(1, box_h - 2), bc),
+            ]
+        fill = _filled_region(vertices)
+        if len(_convex_hull([(c, r) for r, c in vertices])) != 4:
+            continue
+        if len(fill) >= 8:
+            return vertices, fill
