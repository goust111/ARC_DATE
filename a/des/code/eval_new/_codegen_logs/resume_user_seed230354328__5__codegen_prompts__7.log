+def _polygon_area2(poly: list[tuple[int, int]]) -> int:
+    area2 = 0
+    for i in range(len(poly)):
+        x0, y0 = poly[i]
+        x1, y1 = poly[(i + 1) % len(poly)]
+        area2 += x0 * y1 - x1 * y0
+    return abs(area2)
