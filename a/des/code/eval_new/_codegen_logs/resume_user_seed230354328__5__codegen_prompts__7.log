+    group_count = rng.randint(2, 4)
+    sizes = [3, 4] + [rng.choice([3, 4]) for _ in range(group_count - 2)]
+    rng.shuffle(sizes)
+    need_collinear = rng.random() < 0.5
+    need_overlap = rng.random() < 0.5
