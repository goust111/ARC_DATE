+            return [(winner, winner_count)]
+
+        loser_counts = [random.randint(1, min(3, area - 2)) for _ in losers]
+        winner_lo = max(loser_counts) + 1
+        winner_hi = min(area - 1 - sum(loser_counts), winner_lo + 4)
+        if winner_lo > winner_hi:
+            continue
