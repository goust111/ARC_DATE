+        heights = [int(sprite["patch"].shape[0]) for sprite in row]  # type: ignore[index]
+        gaps = [random.randint(1, 3) for _ in range(max(0, len(row) - 1))]
+        row_widths.append(sum(widths) + sum(gaps))
