+    for r in range(h):
+        for c in (0, w - 1):
+            if bool(mask[r, c]) and not bool(seen[r, c]):
+                seen[r, c] = True
+                queue.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if bool(mask[r, c]) and not bool(seen[r, c]):
+                seen[r, c] = True
+                queue.append((r, c))
