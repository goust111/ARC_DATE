+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                comp.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _flood_from_boundary(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    queue: deque[tuple[int, int]] = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if bool(mask[r, c]) and not bool(seen[r, c]):
+                seen[r, c] = True
+                queue.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if bool(mask[r, c]) and not bool(seen[r, c]):
+                seen[r, c] = True
+                queue.append((r, c))
+
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(r, c, h, w):
+            if bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                seen[nr, nc] = True
+                queue.append((nr, nc))
