+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt(_RNG)
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input failed to produce a valid sample")

