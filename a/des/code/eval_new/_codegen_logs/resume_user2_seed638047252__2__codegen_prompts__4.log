            cc1 = min(w, c1 + 2)
            if padding_mask[rr0:rr1, cc0:cc1].any():
                continue
            padding_mask[rr0:rr1, cc0:cc1] = True
            placements[idx] = (r0, c0)
            placed = True
            break
        if not placed:
            return None


