+    for length, color in items:
+        placed = False
+        for _ in range(200):
+            side = rng.choice(["top", "bottom", "left", "right"])
+            line_len = w if side in ("top", "bottom") else h
+            lo = 1
+            hi = line_len - length - 1
+            if hi < lo:
