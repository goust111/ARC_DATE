    return specs


def _place_frames(
    grid: np.ndarray, specs: list[dict[str, int | str]], rng: random.Random
) -> list[tuple[int, int]] | None:
    h, w = grid.shape
    padding_mask = np.zeros((h, w), dtype=bool)
    placements: list[tuple[int, int] | None] = [None] * len(specs)

    order = sorted(
        range(len(specs)),
