+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+ArrowKey = tuple[tuple[int, int], ...]
+FrameJob = tuple[np.ndarray, ArrowKey]
+
+
+ARROW_PATTERNS: dict[str, ArrowKey] = {
+    "up": ((0, 1), (1, 0), (1, 1)),
+    "right": ((0, 0), (1, 0), (1, 1)),
+    "down": ((0, 0), (0, 1), (1, 0)),
+    "left": ((0, 0), (0, 1), (1, 1)),
+}
+ALL_DIRECTIONS = tuple(ARROW_PATTERNS)
+LEGEND_ROW_STEP = 3
+LEGEND_HEIGHT = 11
+LEGEND_WIDTH = 3
+FRAME_SIZES = (6, 8, 10)
+GEN_RETRIES = 500
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r0 in range(h):
+        for c0 in range(w):
+            if not mask[r0, c0] or seen[r0, c0]:
+                continue
+            stack = [(r0, c0)]
+            seen[r0, c0] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                cells.append((r, c))
+                for rr, cc in _neighbors4(r, c):
+                    if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
+                        seen[rr, cc] = True
+                        stack.append((rr, cc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _normalized_arrow(coords: np.ndarray) -> ArrowKey | None:
+    if int(coords.shape[0]) != 3:
+        return None
+    r0, c0, r1, c1 = _bbox(coords)
+    if (r1 - r0 + 1, c1 - c0 + 1) != (2, 2):
+        return None
+    normalized = tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))
+    return normalized if normalized in ARROW_PATTERNS.values() else None
+
