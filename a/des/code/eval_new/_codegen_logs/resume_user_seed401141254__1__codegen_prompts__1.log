+    w = c1 - c0 + 1
+    if h != w or h < 4:
+        return False
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return np.array_equal(grid[r0 : r1 + 1, c0 : c1 + 1] == color, border)
