+    "up": ((0, 1), (1, 0), (1, 1)),
+    "right": ((0, 0), (1, 0), (1, 1)),
+    "down": ((0, 0), (0, 1), (1, 0)),
+    "left": ((0, 0), (0, 1), (1, 1)),
+}
+ALL_DIRECTIONS = tuple(ARROW_PATTERNS)
+LEGEND_ROW_STEP = 3
+LEGEND_HEIGHT = 11
+LEGEND_WIDTH = 3
+FRAME_SIZES = (6, 8, 10)
+GEN_RETRIES = 500
