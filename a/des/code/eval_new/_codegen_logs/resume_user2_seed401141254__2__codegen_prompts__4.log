+    h, w = patch_shape
+    rr0 = max(0, int(r0 - 1))
+    cc0 = max(0, int(c0 - 1))
+    rr1 = min(forbidden.shape[0], int(r0 + h + 1))
+    cc1 = min(forbidden.shape[1], int(c0 + w + 1))
