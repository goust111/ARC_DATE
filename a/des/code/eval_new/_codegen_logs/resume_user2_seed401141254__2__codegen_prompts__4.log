+        corners.add((int(pos[0]), int(pos[1])))
+        cells = [(int(pos[0] + direction[0] * k), int(pos[1] + direction[1] * k)) for k in range(int(length))]
+        placements.append((cells, int(body_color)))
+        pos = cells[-1]
+    assert pos == (0, 0)
+    return _render_output(shape, placements, corners)
