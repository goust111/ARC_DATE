+    h, w = patch_shape
+    if r0 < 0 or c0 < 0 or r0 + h > forbidden.shape[0] or c0 + w > forbidden.shape[1]:
+        return False
+    return not bool(forbidden[r0 : r0 + h, c0 : c0 + w].any())
