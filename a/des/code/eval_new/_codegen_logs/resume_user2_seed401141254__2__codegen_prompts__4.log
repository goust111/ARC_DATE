+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+CORNER = 9
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8]
+RNG = np.random.default_rng()
+
+RIGHT = (0, 1)
+LEFT = (0, -1)
+DOWN = (1, 0)
+UP = (-1, 0)
+BASE_DIRECTIONS = [RIGHT, DOWN, LEFT, DOWN, LEFT, UP]
