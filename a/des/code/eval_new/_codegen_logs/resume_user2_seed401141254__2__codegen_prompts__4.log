+        a, b = by_color[exit_color]
+        current_id = int(b if a == current_id else a)
+        entry_color = int(exit_color)
+        entry_pos = (int(exit_pos[0]), int(exit_pos[1]))
+
+    assert len(used) == len(segments)
+    return placements, set(corners)
