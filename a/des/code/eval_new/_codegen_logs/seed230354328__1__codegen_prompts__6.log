+def _corner_coord(corner: int, shape: tuple[int, int]) -> tuple[int, int]:
+    h, w = shape
+    if corner == 0:
+        return 0, 0
+    if corner == 1:
+        return 0, w - 1
+    if corner == 2:
+        return h - 1, w - 1
+    if corner == 3:
+        return h - 1, 0
+    raise ValueError(f"invalid corner index: {corner}")
+
+
+def _ring_corner_coord(corner: int, shape: tuple[int, int]) -> tuple[int, int]:
+    h, w = shape
+    if corner == 0:
+        return 0, 0
+    if corner == 1:
+        return 0, w + 1
+    if corner == 2:
+        return h + 1, w + 1
+    if corner == 3:
+        return h + 1, 0
+    raise ValueError(f"invalid corner index: {corner}")
