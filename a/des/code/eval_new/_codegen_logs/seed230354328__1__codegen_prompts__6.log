+        corner = rng.randrange(4)
+        target = shape.copy()
+        rr, cc = _corner_coord(corner, target.shape)
+        target[rr, cc] = False
+        spin = rng.randrange(4)
+        fragment = np.rot90(target, spin).copy()
+        specs.append(
+            {
+                "color": int(color),
+                "shape": shape,
+                "corner": int(corner),
+                "target": target,
+                "mask": fragment,
+            }
+        )
+
+    try:
