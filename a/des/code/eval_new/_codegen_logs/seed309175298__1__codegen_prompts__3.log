+) -> tuple[int, int, int, int] | None:
+    h, w = shape
+    for _ in range(250):
+        rh = random.randint(1, min(4, h))
+        rw = random.randint(1, min(4, w))
+        if rh * rw == 1:
+            continue
+        r0 = random.randint(0, h - rh)
+        c0 = random.randint(0, w - rw)
+        rect = (r0, c0, rh, rw)
+        cells = _rect_cells(rect)
+        if cells & blocked_zone:
