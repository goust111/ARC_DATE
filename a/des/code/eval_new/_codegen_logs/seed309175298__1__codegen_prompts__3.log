+
+    if mode == "free":
+        assert len(visible) == len(rel_coords)
+    elif mode == "edge":
+        assert len(visible) < len(rel_coords)
+    else:
+        assert len(visible) == len(rel_coords)
+        assert any((rr, cc) != center and int(quad_in[rr, cc]) == OBSTACLE_COLOR for rr, cc in visible)
