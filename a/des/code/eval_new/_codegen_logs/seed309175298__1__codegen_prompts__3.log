+def _pattern_cells(
+    rel_coords: tuple[tuple[int, int], ...],
+    center: tuple[int, int],
+    shape: tuple[int, int],
+) -> set[tuple[int, int]]:
+    h, w = shape
+    sr, sc = center
+    cells = set()
+    for dr, dc in rel_coords:
+        rr = sr + dr
+        cc = sc + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            cells.add((rr, cc))
+    return cells
+
+
+def _candidate_centers(
+    rel_coords: tuple[tuple[int, int], ...],
+    shape: tuple[int, int],
+    require_full_fit: bool,
