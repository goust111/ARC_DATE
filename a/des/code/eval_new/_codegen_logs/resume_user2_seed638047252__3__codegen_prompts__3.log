+
+def _ray_cells(seed: tuple[int, int], direction: str, length: int) -> set[tuple[int, int]]:
+    r, c = seed
+    dr, dc = DIR_TO_VEC[direction]
+    return {(r + dr * step, c + dc * step) for step in range(1, length + 1)}
