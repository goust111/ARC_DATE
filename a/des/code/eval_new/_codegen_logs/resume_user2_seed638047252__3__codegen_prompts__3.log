+    if direction == "left":
+        return {(r - 1, c - offset), (r, c - offset), (r + 1, c - offset)}
+    if direction == "down":
+        return {(r + offset, c - 1), (r + offset, c), (r + offset, c + 1)}
+    if direction == "up":
