+    for r, c in palette_cells:
+        out[r, c] = 0
+
+    for spec in sorted(specs, key=lambda item: tuple(item["seed"])):
+        seed_r, seed_c = spec["seed"]
+        direction = str(spec["direction"])
+        color = int(spec["color"])
