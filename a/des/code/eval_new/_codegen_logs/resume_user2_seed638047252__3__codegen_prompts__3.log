+    directions: dict[tuple[int, int], str] = {}
+    for r, c, color in seeds:
+        assert color in mapping, "every seed color must appear in the palette"
+        lengths = {name: _ray_length(g, bg, r, c, dr, dc) for name, (dr, dc) in DIR_PRIORITY}
