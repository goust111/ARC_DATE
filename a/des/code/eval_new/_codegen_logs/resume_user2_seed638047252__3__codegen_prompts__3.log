+def _render_growth(out: np.ndarray, grown_mask: np.ndarray, template: np.ndarray, top: int, left: int, bg: int) -> None:
+    patch = out[top : top + 3, left : left + 3]
+    fill = template != bg
+    patch[fill] = template[fill]
+    grown_mask[top : top + 3, left : left + 3] = True
