+        r += 3
+        found = True
+
+        while r < h and np.all(strip[r] == bg):
+            r += 1
+
+    return (mapping, mask) if found else None
+
+
+def _find_palette(grid: np.ndarray, bg: int) -> tuple[dict[int, np.ndarray], np.ndarray, str]:
+    g = np.asarray(grid, dtype=int)
