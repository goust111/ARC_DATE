+
+def _main_bounds(side: str, h: int, w: int) -> tuple[int, int, int, int]:
+    if side == "top":
+        return 5, h - 2, 1, w - 2
+    if side == "bottom":
+        return 1, h - 6, 1, w - 2
+    if side == "left":
+        return 1, h - 2, 6, w - 2
+    if side == "right":
+        return 1, h - 2, 1, w - 7
+    raise ValueError(side)
+
+
+def _distribute_directions(count: int) -> list[str]:
+    base = [name for name, _vec in DIR_PRIORITY]
+    out: list[str] = []
+    while len(out) < count:
+        random.shuffle(base)
+        out.extend(base)
+    random.shuffle(out)
+    return out[:count]
+
+
+def _distribute_colors(colors: list[int], count: int) -> list[int]:
+    out = colors[:]
+    while len(out) < count:
+        out.append(random.choice(colors))
+    random.shuffle(out)
+    return out[:count]
+
+
+def _tie_group(direction: str) -> set[str]:
+    if direction == "up" or random.random() < 0.6:
+        return {direction}
+    if direction == "right":
+        options = [
+            {"right", "down"},
+            {"right", "left"},
+            {"right", "up"},
+            {"right", "down", "left"},
+            {"right", "down", "up"},
+            {"right", "left", "up"},
+            {"right", "down", "left", "up"},
