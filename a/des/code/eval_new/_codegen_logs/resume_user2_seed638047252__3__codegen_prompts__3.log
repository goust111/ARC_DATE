+import numpy as np
+
+
+WALL_COLOR = 5
+USABLE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIR_PRIORITY = (
+    ("right", (0, 1)),
+    ("down", (1, 0)),
+    ("left", (0, -1)),
+    ("up", (-1, 0)),
+)
+DIR_TO_VEC = dict(DIR_PRIORITY)
