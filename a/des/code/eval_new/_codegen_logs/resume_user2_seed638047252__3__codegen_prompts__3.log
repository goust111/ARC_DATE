+def _build_palette(
+    grid: np.ndarray,
+    side: str,
+    colors: list[int],
+    masks: dict[int, np.ndarray],
+) -> set[tuple[int, int]]:
+    h, w = grid.shape
+    palette_cells: set[tuple[int, int]] = set()
+
+    if side in ("top", "bottom"):
