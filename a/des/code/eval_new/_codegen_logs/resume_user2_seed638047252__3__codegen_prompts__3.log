+    if top < 0 or left < 0 or top + 3 > h or left + 3 > w:
+        return False
+    patch = grid[top : top + 3, left : left + 3]
+    return bool(np.all(patch == bg) and not grown_mask[top : top + 3, left : left + 3].any())
