+    for r, c, color in seeds:
+        direction = directions[(r, c)]
+        template = mapping[color]
+        copy_index = 0
+        while True:
+            top, left = _copy_top_left(r, c, direction, copy_index)
+            if not _footprint_clear(g, bg, grown_mask, top, left):
