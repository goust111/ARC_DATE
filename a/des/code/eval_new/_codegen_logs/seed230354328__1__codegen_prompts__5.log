+        GRID_MIN,
+        total_band_height + 2,
+        max((spec["segment_len"] if spec["orientation"] == "vertical" else spec["channel_len"] + 2) for spec in specs) + 2,
+    )
+    min_w = max(
+        GRID_MIN,
+        max((spec["channel_len"] + 2 if spec["orientation"] == "vertical" else spec["segment_len"]) for spec in specs) + 2,
+    )
