+        assert len(comps) == 2, "each gate color must form exactly two segments"
+        parts = [_line_info(comp) for comp in comps]
+        assert parts[0] is not None and parts[1] is not None, "gate segments must be straight lines"
+        a = parts[0]
+        b = parts[1]
