+            left, right = sorted((a, b), key=lambda part: part["c0"])
+            channel_len = int(right["c0"] - left["c0"] - 1)
+            assert channel_len > 0
+            channel = g[left["r0"] : left["r1"] + 1, left["c0"] + 1 : right["c0"]]
