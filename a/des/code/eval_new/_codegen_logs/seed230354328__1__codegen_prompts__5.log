+        range(pair_count),
+        key=lambda idx: -(
+            (specs[idx]["segment_len"] * (specs[idx]["channel_len"] + 2))
+            if specs[idx]["orientation"] == "vertical"
+            else ((specs[idx]["channel_len"] + 2) * specs[idx]["segment_len"])
+        ),
