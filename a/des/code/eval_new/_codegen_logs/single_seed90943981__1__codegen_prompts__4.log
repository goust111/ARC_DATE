+def _random_pattern(rng: np.random.Generator) -> np.ndarray:
+    pattern = PATTERN_TEMPLATES[int(rng.integers(len(PATTERN_TEMPLATES)))].copy()
+    if bool(rng.integers(2)):
+        pattern = pattern[::-1, :]
+    if bool(rng.integers(2)):
+        pattern = pattern[:, ::-1]
+    pattern = np.rot90(pattern, int(rng.integers(4)))
+    return pattern
+
