+
+def _growth_cells(spec: dict, top: int, left: int, length: int) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    pattern = spec["pattern"]
+    ph, pw = pattern.shape
+    seed_r = int(spec["seed_r"])
+    seed_c = int(spec["seed_c"])
