+                        if not (a_bbox[2] + 1 < b_bbox[0] or b_bbox[2] + 1 < a_bbox[0]):
+                            continue
+
+                    b_out = _border_cells(spec_b, rb, cb) | _seed_cells(spec_b, rb, cb) | _growth_cells(spec_b, rb, cb, len_b)
+                    if a_out & b_out:
