+    max_r = zone_h - int(spec["outer_h"]) - (growth_length if spec["direction"] == "down" else 0)
+    min_c = growth_length if spec["direction"] == "left" else 0
+    max_c = zone_w - int(spec["outer_w"]) - (growth_length if spec["direction"] == "right" else 0)
