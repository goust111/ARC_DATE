+    elif direction == "down":
+        row0 = top + outer_h
+        col0 = left + 1 + seed_c
+        for step in range(length):
+            src_r = ph - 1 - (step % ph)
+            rr = row0 + step
+            for cc in range(pw):
+                if int(pattern[src_r, cc]) != 0:
