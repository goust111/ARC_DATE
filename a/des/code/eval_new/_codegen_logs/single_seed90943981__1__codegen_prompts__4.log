+def _paint_growth(out: np.ndarray, obj: dict, length: int, bg: int) -> None:
+    r0, c0, r1, c1 = obj["bbox"]
+    sr0, sc0, _sr1, _sc1 = obj["seed_box"]
+    pattern = obj["pattern"]
+    ph, pw = pattern.shape
+    direction = obj["direction"]
+
+    if direction == "up":
+        base_row = r0 - 1
+        base_col = c0 + 1 + sc0
+        for step in range(length):
+            rr = base_row - step
+            src_r = step % ph
+            for cc in range(pw):
+                value = int(pattern[src_r, cc])
+                if value != bg:
+                    out[rr, base_col + cc] = value
+    elif direction == "down":
+        base_row = r1 + 1
+        base_col = c0 + 1 + sc0
+        for step in range(length):
+            rr = base_row + step
+            src_r = ph - 1 - (step % ph)
+            for cc in range(pw):
+                value = int(pattern[src_r, cc])
+                if value != bg:
+                    out[rr, base_col + cc] = value
