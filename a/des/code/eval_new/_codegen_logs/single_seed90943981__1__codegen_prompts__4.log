+            if sr1 == interior.shape[0] - 1:
+                touches.append("down")
+            if sc0 == 0:
+                touches.append("left")
+            if sc1 == interior.shape[1] - 1:
+                touches.append("right")
+            if len(touches) != 1:
+                continue
+
+            pattern = interior[sr0 : sr1 + 1, sc0 : sc1 + 1].copy()
+            objects.append(
+                {
+                    "bbox": (r0, c0, r1, c1),
+                    "frame_color": color,
+                    "interior_h": int(interior.shape[0]),
+                    "interior_w": int(interior.shape[1]),
+                    "seed_box": (sr0, sc0, sr1, sc1),
+                    "pattern": pattern,
+                    "direction": touches[0],
+                }
+            )
