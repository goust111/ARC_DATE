+
+def _extract_objects(grid: np.ndarray, bg: int | None = None) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    if bg is None:
+        bg = _most_common_value(g)
+
+    objects: list[dict] = []
+    for color in np.unique(g):
+        color = int(color)
+        if color == bg:
