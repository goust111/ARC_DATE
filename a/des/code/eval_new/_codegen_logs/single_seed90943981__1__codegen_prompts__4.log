+    pattern = obj["pattern"]
+    ph, pw = pattern.shape
+    direction = obj["direction"]
+
+    if direction == "up":
+        base_row = r0 - 1
+        base_col = c0 + 1 + sc0
+        for step in range(length):
+            rr = base_row - step
+            src_r = step % ph
+            for cc in range(pw):
+                value = int(pattern[src_r, cc])
+                if value != bg:
