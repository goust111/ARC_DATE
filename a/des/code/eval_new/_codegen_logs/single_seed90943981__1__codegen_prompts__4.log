+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            if h < 3 or w < 3:
+                continue
+            expected = _frame_mask(h, w)
+            actual = g[r0 : r1 + 1, c0 : c1 + 1] == color
+            if len(comp) != int(expected.sum()) or not bool(np.array_equal(actual, expected)):
