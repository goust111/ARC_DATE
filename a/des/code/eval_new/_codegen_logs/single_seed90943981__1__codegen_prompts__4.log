+    elif direction == "left":
+        row0 = top + 1 + seed_r
+        col0 = left - 1
+        for step in range(length):
+            src_c = step % pw
+            cc = col0 - step
+            for rr in range(ph):
+                if int(pattern[rr, src_c]) != 0:
