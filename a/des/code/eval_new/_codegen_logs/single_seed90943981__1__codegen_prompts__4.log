+            "outer_w": iw + 2,
+            "seed_r": sr,
+            "seed_c": sc,
+        }
+    return None
+
+
+def _border_cells(spec: dict, top: int, left: int) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    h = int(spec["outer_h"])
+    w = int(spec["outer_w"])
