+    partners = _partner_indices(objects)
+    out = g.copy()
+    for i, obj in enumerate(objects):
+        partner = objects[partners[i]]
+        length = min(int(partner["interior_h"]), int(partner["interior_w"]))
+        _paint_growth(out, obj, length, bg)
