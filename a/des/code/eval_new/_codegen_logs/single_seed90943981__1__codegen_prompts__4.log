+        base_row = r0 + 1 + sr0
+        base_col = c0 - 1
+        for step in range(length):
+            cc = base_col - step
+            src_c = step % pw
+            for rr in range(ph):
+                value = int(pattern[rr, src_c])
+                if value != bg:
+                    out[base_row + rr, cc] = value
+    else:
