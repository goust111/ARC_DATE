+def _grow_core(rng: random.Random) -> set[tuple[int, int]]:
+    h = rng.randint(2, 4)
+    w = rng.randint(2, 4)
+    target = rng.randint(max(3, (h * w) // 2), h * w)
+    seed = (rng.randrange(h), rng.randrange(w))
