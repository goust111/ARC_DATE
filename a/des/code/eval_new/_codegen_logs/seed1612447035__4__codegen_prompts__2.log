+        if _neighbor_count(leaf, cells) != 1:
+            continue
+        lr, lc = leaf
+        root = next((lr + dr, lc + dc) for dr, dc in DIRS if (lr + dr, lc + dc) in cells)
+        nbrs = [(root[0] + dr, root[1] + dc) for dr, dc in DIRS if (root[0] + dr, root[1] + dc) in cells]
+        if len(nbrs) != 2:
