+import random
+
+import numpy as np
+
+
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+BG = 0
+GREY = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+GEN_RETRIES = 400
