+
+
+def _dir_to_idx(vec: tuple[int, int]) -> int:
+    return DIRS.index(vec)
+
+
+def _detect_piece_direction(coords: tuple[tuple[int, int], ...]) -> int:
+    cells = set(coords)
+    candidates: list[int] = []
+    for leaf in list(cells):
+        if _neighbor_count(leaf, cells) != 1:
