+
+def _arrow_candidates(
+    hole_cells: set[tuple[int, int]], target_dir: int, th: int, tw: int
+) -> list[tuple[tuple[int, int], tuple[int, int]]]:
+    dr, dc = DIRS[target_dir]
+    out = []
+    for hr, hc in hole_cells:
