+
+def _make_shape(rng: random.Random) -> tuple[tuple[tuple[int, int], ...], int]:
+    for _ in range(300):
+        core = _grow_core(rng)
+        if len({r for r, _ in core}) < 2 or len({c for _, c in core}) < 2:
+            continue
+        for d in rng.sample(range(4), 4):
+            dr, dc = DIRS[d]
+            turns = rng.sample([-1, 1], 2)
+            for side in turns:
+                perp = DIRS[(d + side) % 4]
+                bodies = list(core)
+                rng.shuffle(bodies)
+                for br, bc in bodies:
