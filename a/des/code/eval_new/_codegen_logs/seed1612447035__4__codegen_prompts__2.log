+        for r0, c0 in positions:
+            hole_cells = _translate(shape, r0, c0)
+            if hole_cells & reserve:
+                continue
+            candidates = _arrow_candidates(hole_cells, spec["target_dir"], th, tw)
+            rng.shuffle(candidates)
