+def _place_scattered_pieces(
+    rng: random.Random,
+    grid: np.ndarray,
+    template_bbox: tuple[int, int, int, int],
+    placements: list[dict],
+) -> bool:
+    h, w = grid.shape
+    tr0, tc0, tr1, tc1 = template_bbox
