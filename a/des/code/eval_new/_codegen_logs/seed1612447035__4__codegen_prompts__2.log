+        w,
+    )
+    for item in placements:
+        shape = item["piece_shape"]
+        ph = max(r for r, _ in shape) + 1
+        pw = max(c for _, c in shape) + 1
+        positions = [(r, c) for r in range(h - ph + 1) for c in range(w - pw + 1)]
+        rng.shuffle(positions)
+        done = False
+        for r0, c0 in positions:
