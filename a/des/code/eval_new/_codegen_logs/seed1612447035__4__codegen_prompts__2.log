+    grey_coords = np.argwhere(g == grey)
+    assert grey_coords.size, "template must contain grey pixels"
+    tr0, tc0, tr1, tc1 = _bbox_coords(grey_coords)
+    template = g[tr0 : tr1 + 1, tc0 : tc1 + 1]
+    th, tw = template.shape
