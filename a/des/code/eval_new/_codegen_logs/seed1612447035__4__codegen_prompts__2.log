+    pts = [tuple(map(int, p)) for p in comp]
+    roots: list[tuple[int, int]] = []
+    for r, c in pts:
+        hits = []
+        for d, (dr, dc) in enumerate(DIRS):
+            hid = hole_by_cell.get((r + dr, c + dc))
+            if hid is not None:
