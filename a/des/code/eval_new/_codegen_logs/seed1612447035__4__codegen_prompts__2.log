+def _find_template_color(grid: np.ndarray, bg: int) -> int:
+    vals, cnts = np.unique(grid[grid != bg], return_counts=True)
+    assert vals.size, "grid must contain a non-background template color"
+    return int(vals[np.argmax(cnts)])
