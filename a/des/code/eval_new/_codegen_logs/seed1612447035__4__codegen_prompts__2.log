+GREY = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+GEN_RETRIES = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, cnts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(cnts)])
