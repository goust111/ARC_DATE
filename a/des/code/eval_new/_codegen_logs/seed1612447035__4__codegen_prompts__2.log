+        body = nbrs[0] if nbrs[1] == leaf else nbrs[1]
+        v_leaf = (leaf[0] - root[0], leaf[1] - root[1])
+        v_body = (body[0] - root[0], body[1] - root[1])
+        if v_leaf[0] == -v_body[0] and v_leaf[1] == -v_body[1]:
