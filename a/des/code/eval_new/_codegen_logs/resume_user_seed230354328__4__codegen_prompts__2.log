+            elif side == "bottom":
+                gap = (r1, rng.randint(c0 + 1, c1 - 1))
+            elif side == "left":
+                gap = (rng.randint(r0 + 1, r1 - 1), c0)
+            else:
+                gap = (rng.randint(r0 + 1, r1 - 1), c1)
+
+            grid[gap] = bg
