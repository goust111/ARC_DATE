/bin/bash -lc "python - <<'PY'
import random
from collections import Counter, deque
import numpy as np

OPPOSITE = {\"top\":\"bottom\",\"bottom\":\"top\",\"left\":\"right\",\"right\":\"left\"}
SIDES = tuple(OPPOSITE)
MAX_GENERATION_RETRIES = 400


def _background_color(grid: np.ndarray) -> int:
    values, counts = np.unique(grid, return_counts=True)
    return int(values[np.argmax(counts)])


def _components(mask: np.ndarray):
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    comps = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            pts = []
            while q:
                rr, cc = q.popleft()
                pts.append((rr, cc))
                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            comps.append(pts)
    return comps


def _edge_color_map(grid: np.ndarray, bg: int):
    h, w = grid.shape
    edge_arrays = {
        \"top\": grid[0, 1 : w - 1],
        \"bottom\": grid[h - 1, 1 : w - 1],
        \"left\": grid[1 : h - 1, 0],
        \"right\": grid[1 : h - 1, w - 1],
    }
    mapping = {}
    for side, arr in edge_arrays.items():
        counts = Counter(int(v) for v in arr.ravel() if int(v) "'!= bg)
        assert counts, (side, arr)
        mapping[side] = counts.most_common(1)[0][0]
    assert len(set(mapping.values())) == 4
    return mapping


def _wall_color(grid: np.ndarray, bg: int) -> int:
    inner = grid[1:-1, 1:-1].ravel()
    counts = Counter(int(v) for v in inner if int(v) != bg)
    assert counts
    return counts.most_common(1)[0][0]


def _find_rooms(grid: np.ndarray, bg: int, wall: int):
    rooms = []
    for pts in _components(grid == wall):
        rows = [r for r, _ in pts]
        cols = [c for _, c in pts]
        r0, r1 = min(rows), max(rows)
        c0, c1 = min(cols), max(cols)
        if r1 - r0 < 3 or c1 - c0 < 3:
            continue
        comp = set(pts)
        border = set()
        for c in range(c0, c1 + 1):
            border.add((r0, c))
            border.add((r1, c))
        for r in range(r0 + 1, r1):
            border.add((r, c0))
            border.add((r, c1))
        if not comp <= border:
            continue
        missing = border - comp
        extra = comp - border
        if extra or len(missing) != 1:
            continue
        gr, gc = next(iter(missing))
        if gr == r0 and c0 < gc < c1:
            side = "top"
        elif gr == r1 and c0 < gc < c1:
            side = "bottom"
        elif gc == c0 and r0 < gr < r1:
            side = "left"
        elif gc == c1 and r0 < gr < r1:
            side = "right"
        else:
            continue
        interior = grid[r0 + 1 : r1, c0 + 1 : c1]
        if interior.size == 0 or np.any(interior == wall):
            continue
        rooms.append((r0, c0, r1, c1, side))
    rooms.sort()
    assert rooms
    return rooms


def main(grid: np.ndarray) -> np.ndarray:
    g = np.asarray(grid, dtype=int)
    bg = _background_color(g)
    edges = _edge_color_map(g, bg)
    wall = _wall_color(g, bg)
    rooms = _find_rooms(g, bg, wall)
    out = g.copy()
    for r0, c0, r1, c1, side in rooms:
        fill = edges[OPPOSITE[side]]
        patch = out[r0 + 1 : r1, c0 + 1 : c1]
        patch[patch == bg] = fill
    return out


def _pick_layout(rng: random.Random):
    for _ in range(200):
        room_rows, room_cols = rng.choice([(2, 2), (2, 3), (3, 2), (3, 3)])
        interior_heights = [rng.randint(2, 5) for _ in range(room_rows)]
        interior_widths = [rng.randint(2, 5) for _ in range(room_cols)]
        top_margin = rng.randint(1, 2)
        bottom_margin = rng.randint(1, 2)
        left_margin = rng.randint(1, 2)
        right_margin = rng.randint(1, 2)
        row_gaps = [rng.randint(1, 2) for _ in range(room_rows - 1)]
        col_gaps = [rng.randint(1, 2) for _ in range(room_cols - 1)]
        h = 2 + top_margin + bottom_margin + sum(v + 2 for v in interior_heights) + sum(row_gaps)
        w = 2 + left_margin + right_margin + sum(v + 2 for v in interior_widths) + sum(col_gaps)
        if h <= 30 and w <= 30:
            return {
                "room_rows": room_rows,
                "room_cols": room_cols,
                "interior_heights": interior_heights,
                "interior_widths": interior_widths,
                "top_margin": top_margin,
                "bottom_margin": bottom_margin,
                "left_margin": left_margin,
                "right_margin": right_margin,
                "row_gaps": row_gaps,
                "col_gaps": col_gaps,
                "height": h,
                "width": w,
            }
    raise RuntimeError


def _room_starts(lengths, margin, gaps):
    starts = []
    pos = 1 + margin
