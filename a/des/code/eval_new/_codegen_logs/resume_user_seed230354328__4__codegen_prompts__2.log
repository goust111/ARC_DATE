+    edge_colors: dict[str, int],
+) -> np.ndarray:
+    out = grid.copy()
+    for r0, c0, r1, c1, side in room_specs:
+        fill_color = edge_colors[OPPOSITE_SIDE[side]]
+        out[r0 + 1 : r1, c0 + 1 : c1] = fill_color
+    return out
