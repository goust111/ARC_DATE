+LAYOUT_CHOICES = ((2, 2), (2, 3), (3, 2), (3, 3))
+INTERIOR_SIZE_RANGE = (2, 5)
+MARGIN_RANGE = (1, 2)
+GAP_RANGE = (1, 2)
+MAX_GENERATION_RETRIES = 400
