+
+def _place_vertical_wall(
+    grid: np.ndarray, cross_c: int, cross_r: int, side: str, prism_rows: list[int]
+) -> bool:
+    h, _ = grid.shape
+    if side == "top":
+        lo = max([cross_r + 1] + prism_rows) + 2
+        candidates = list(range(lo, h - 1))
