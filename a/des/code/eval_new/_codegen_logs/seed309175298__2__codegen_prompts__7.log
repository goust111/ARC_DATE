+                    for side_dr, side_dc in _turns(dr, dc):
+                        queue.append((((nr, nc),), side_dr, side_dc, color))
+            current = nxt
+
+    out = g.copy()
+    for r in range(h):
+        for c in range(w):
+            if tower_mask[r, c] or wall_mask[r, c]:
+                continue
+            mask = int(ray_bits[r, c])
+            if mask:
