+                grid[h_prism] = GREEN
+                prisms.append(h_prism)
+        else:
+            col = _pick_horizontal_prism_col(w, cross_c)
+            if col is None:
+                return None
+            h_prism = (random.choice([cross_r, cross_r + 1]), col)
+            grid[h_prism] = GREEN
+            prisms.append(h_prism)
