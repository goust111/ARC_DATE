+
+    if return_meta:
+        return out, {
+            "towers": towers,
+            "tower_mask": tower_mask,
+            "ray_bits": ray_bits,
+            "reached_prisms": reached_prisms,
+            "prism_count": int(prism_mask.sum()),
+        }
+    return out
