+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+MAGENTA = 6
+ORANGE = 7
+AZURE = 8
+BROWN = 9
+
+PRIMARY_COLORS = (BLUE, RED, YELLOW)
+INPUT_COLORS = {BLACK, BLUE, RED, GREEN, YELLOW, GRAY}
+PRIMARY_BITS = {BLUE: 1, RED: 2, YELLOW: 4}
+BIT_TO_COLOR = {
+    1: BLUE,
+    2: RED,
+    3: MAGENTA,
+    4: YELLOW,
+    5: AZURE,
+    6: ORANGE,
+    7: BROWN,
