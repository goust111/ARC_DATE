+    for row in candidates:
+        cells = [(row, cross_c), (row, cross_c + 1)]
+        if _paint_cells(grid, cells, GRAY):
+            return True
+    return False
+
+
+def _place_horizontal_wall(
+    grid: np.ndarray, cross_r: int, cross_c: int, side: str, prism_cols: list[int]
+) -> bool:
