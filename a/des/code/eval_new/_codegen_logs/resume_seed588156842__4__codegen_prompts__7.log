0113:     out[:, n_rows] = base_color
0114: 
0115:     marker_candidates: list[tuple[int, int, int]] = []
0116:     for i, ((bar_r, color), (next_bar_r, _)) in enumerate(zip(source_bars, bars[1:])):
0117:         solid_rows, center_c = _motif_stats(g, bar_r, next_bar_r, color)
0118:         assert solid_rows <= n_rows, "motif count must fit in the output slots"
0119:         out[i, :solid_rows] = color
