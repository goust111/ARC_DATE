+    dr, dc = DIRS[last.direction]
+    rr, cc = last.head
+    forbidden: set[Coord] = set()
+    while True:
+        rr += dr
+        cc += dc
+        if not _in_bounds((rr, cc), h, w):
+            break
+        forbidden.add((rr, cc))
+    return forbidden
+
