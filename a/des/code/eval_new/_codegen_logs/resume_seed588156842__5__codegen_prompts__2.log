+    colors = list(PALETTE)
+    rng.shuffle(colors)
+    for color, seed in zip(colors, seeds):
+        grid[int(seed["r"]), int(seed["c"])] = color
+
+    if not _validate_grid(grid):
+        return None
+    return grid
