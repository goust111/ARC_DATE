+    radius = dist - 1
+    cells: list[tuple[int, int]] = []
+    truncated = False
+    for rr in range(max(0, r - radius), min(h, r + radius + 1)):
+        for cc in range(max(0, c - radius), min(w, c + radius + 1)):
+            if int(grid[rr, cc]) == wall:
+                truncated = True
+            else:
+                cells.append((rr, cc))
+    return dist, cells, truncated
+
