+    non_bg = g[g != bg]
+    assert non_bg.size > 0, "expected at least one wall or seed"
+    wall = _wall_color(g, bg)
+
+    out = g.copy()
+    seed_positions = [tuple(map(int, pos)) for pos in np.argwhere((g != bg) & (g != wall))]
+    for r, c in sorted(seed_positions):
