+def _validate_grid(grid: np.ndarray) -> bool:
+    g = np.asarray(grid, dtype=int)
+    if g.ndim != 2 or max(g.shape) > 30:
+        return False
+
+    bg = _dominant_color(g)
+    non_bg = g[g != bg]
+    if non_bg.size == 0:
+        return False
+    wall = _wall_color(g, bg)
