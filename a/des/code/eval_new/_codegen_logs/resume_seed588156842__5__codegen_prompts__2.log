+def _ray_length(grid: np.ndarray, wall: int, r: int, c: int, dr: int, dc: int) -> int:
+    h, w = grid.shape
+    length = 1
+    rr, cc = r + dr, c + dc
+    while 0 <= rr < h and 0 <= cc < w and int(grid[rr, cc]) != wall:
+        length += 1
+        rr += dr
+        cc += dc
+    return length
