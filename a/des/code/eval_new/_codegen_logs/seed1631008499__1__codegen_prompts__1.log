+def _point_in_frame_interior(frame_bbox: tuple[int, int, int, int], point: tuple[int, int]) -> bool:
+    r0, c0, r1, c1 = frame_bbox
+    r, c = point
+    return r0 < r < r1 and c0 < c < c1
