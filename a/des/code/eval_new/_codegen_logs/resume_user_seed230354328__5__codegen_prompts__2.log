+_QUADS = ("TL", "TR", "BL", "BR")
+_QUAD_TO_MISSING = {
+    "TL": (1, 1),
+    "TR": (1, 0),
+    "BL": (0, 1),
+    "BR": (0, 0),
+}
+_QUAD_TO_CORNER = {
+    "TL": (0, 0),
+    "TR": (0, -1),
+    "BL": (-1, 0),
+    "BR": (-1, -1),
+}
+
