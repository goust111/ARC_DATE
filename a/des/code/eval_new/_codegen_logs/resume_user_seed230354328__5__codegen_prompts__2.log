+
+def _random_cut(length: int, start: int, low: int, high: int, rng: random.Random) -> list[int]:
+    values = [start]
+    for _ in range(length - 1):
+        step = rng.choice([-1, 0, 1])
+        values.append(max(low, min(high, values[-1] + step)))
+    return values
