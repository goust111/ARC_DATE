+        (c, n - 1 - r),
+        (n - 1 - r, n - 1 - c),
+        (n - 1 - c, r),
+        (r, n - 1 - c),
+        (n - 1 - r, c),
+        (c, r),
+        (n - 1 - c, n - 1 - r),
