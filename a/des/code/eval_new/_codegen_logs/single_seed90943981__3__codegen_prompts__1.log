+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+TYPES = ("H", "V", "R")
+ICON_MASKS = {
+    "H": np.array(
+        [
+            [0, 0, 0],
+            [1, 0, 1],
+            [0, 0, 0],
+        ],
+        dtype=bool,
+    ),
+    "V": np.array(
+        [
