+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _most_common_color(arr: np.ndarray) -> int:
+    vals, cnts = np.unique(arr, return_counts=True)
+    return int(vals[int(np.argmax(cnts))])
