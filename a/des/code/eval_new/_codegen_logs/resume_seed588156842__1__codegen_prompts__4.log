+    bottom = int(h_colors[r + 1, c])
+    left = int(v_colors[r, c])
+    right = int(v_colors[r, c + 1])
+    return top, bottom, left, right
+
+
+def _draw_board(
+    grid: np.ndarray,
+    top_margin: int,
+    left_margin: int,
+    row_sizes: list[int],
+    col_sizes: list[int],
+    h_colors: np.ndarray,
+    v_colors: np.ndarray,
