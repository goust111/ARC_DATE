+    frame_dims = [(random.randint(5, 8), random.randint(5, 8)) for _ in range(n_frames)]
+    specs: list[tuple] = []
+    used_specs: set[tuple] = set()
+    for idx, (fh, fw) in enumerate(frame_dims):
