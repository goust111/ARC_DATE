+    for vert, horiz in {(a, b), (b, a)}:
+        if frame_h >= vert and frame_w >= horiz:
+            for corner in ("tl", "tr", "bl", "br"):
+                corner_options.append((corner, vert, horiz))
+    corner, vert, horiz = random.choice(corner_options)
+    if corner == "tl":
+        mask[0, :horiz] = True
