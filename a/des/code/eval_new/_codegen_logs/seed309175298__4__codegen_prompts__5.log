+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GRAY = 5
+MAROON = 9
+BASE_COLORS = (1, 2, 3, 4, 6, 7, 8)
+
+GRID_H_RANGE = (16, 30)
+MAX_LEVELS = 5
+LEFT_PANEL_MIN = 10
+LEFT_PANEL_MAX = 18
+RIGHT_PANEL_EXTRA_RANGE = (2, 8)
+RECT_DIM_RANGE = (3, 7)
+PLACEMENT_RETRIES = 200
+GEN_RETRIES = 400
