+_NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+_COLORS = tuple(range(10))
+_MAX_GENERATION_ATTEMPTS = 400
+_PAIR_COUNT_OPTIONS = (2, 3)
