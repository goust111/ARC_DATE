+
+def _mask(lines: tuple[str, ...]) -> np.ndarray:
+    return np.array([[ch == "#" for ch in row] for row in lines], dtype=bool)
+
+
+_SHAPE_BANK: dict[int, tuple[np.ndarray, ...]] = {
+    2: (_mask(("##",)),),
+    3: (_mask(("###",)), _mask(("#.", "##"))),
+    4: (_mask(("##", "##")), _mask(("###", ".#.")), _mask(("#.", "#.", "##"))),
+    5: (_mask((".#.", "###", ".#.")), _mask(("#..", "#..", "###")), _mask(("#.#", "###"))),
+    6: (_mask(("###", "###")), _mask(("###", "##.")), _mask(("##.", ".##", ".#."))),
+    7: (_mask(("###", "###", "#..")), _mask(("###", "##.", "##."))),
+    8: (_mask(("###", "###", "##.")), _mask(("###", "###", ".##"))),
