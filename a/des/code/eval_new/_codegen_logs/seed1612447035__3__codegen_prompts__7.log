+def _canonical_rotation_key(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    best: tuple[tuple[int, int], bytes] | None = None
+    cur = np.asarray(mask, dtype=bool)
+    for k in range(4):
+        rot = np.rot90(cur, k)
+        key = (tuple(map(int, rot.shape)), rot.tobytes())
