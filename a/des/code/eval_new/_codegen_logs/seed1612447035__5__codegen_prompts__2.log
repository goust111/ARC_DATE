+    assert g.ndim == 2
+    assert max(g.shape) <= 30
+    segments = _extract_segments(g)
+    order = _chain_order(segments)
+    band: list[int] = []
+    for idx in order:
+        seg = segments[idx]
+        band.extend([int(seg["color"])] * int(seg["length"]))
+    out = np.asarray([band], dtype=int)
+    assert out.ndim == 2 and out.shape[0] == 1 and out.shape[1] <= 30
+    return out
