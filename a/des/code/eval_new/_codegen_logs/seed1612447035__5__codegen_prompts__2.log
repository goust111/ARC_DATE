+def _apply_symmetry(coords: list[tuple[int, int]], variant: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    for r, c in coords:
+        if variant == 0:
+            nr, nc = r, c
+        elif variant == 1:
+            nr, nc = r, -c
+        elif variant == 2:
+            nr, nc = -r, c
+        elif variant == 3:
+            nr, nc = -r, -c
+        elif variant == 4:
+            nr, nc = c, r
+        elif variant == 5:
+            nr, nc = c, -r
+        elif variant == 6:
+            nr, nc = -c, r
+        else:
+            nr, nc = -c, -r
+        out.append((int(nr), int(nc)))
+    return out
+
