+import numpy as np
+
+
+BG = 0
+GREY = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_ATTEMPTS = 500
+GRID_MIN = 15
+GRID_MAX = 27
+
+DIRS = {
