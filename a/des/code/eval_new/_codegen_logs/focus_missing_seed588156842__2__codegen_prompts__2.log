+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+DIR_TO_COLOR = {
+    "up": RED,
+    "down": BLUE,
+    "left": GREEN,
+    "right": YELLOW,
+}
+
+FRAGMENT_COLORS = [6, 7, 8, 9]
+
+MAX_GENERATION_ATTEMPTS = 400
+PIECE_COUNT_CHOICES = (4, 5, 6)
+PIECE_AREA_MIN = 3
+PIECE_AREA_MAX = 6
+PARTITION_BBOX_MAX = 8
+SIDE_BAND_MIN = 6
+SIDE_BAND_MAX = 9
