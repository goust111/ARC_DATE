+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+DIR_TO_COLOR = {
+    "up": RED,
+    "down": BLUE,
+    "left": GREEN,
+    "right": YELLOW,
