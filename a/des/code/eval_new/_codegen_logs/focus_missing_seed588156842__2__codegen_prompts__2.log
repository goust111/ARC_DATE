+            left = int(rng.integers(col_min, col_max + 1))
+        elif direction == "left":
+            max_left = c0 - TEMPLATE_GAP - pw
+            if max_left < 0:
+                return None
+            left = int(rng.integers(0, max_left + 1))
+            piece_center_c = left + local_center_c
