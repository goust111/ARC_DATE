+
+
+def _trace_path(
+    h: int,
+    w: int,
+    seed: tuple[int, int],
+    direction: tuple[int, int],
+    exit_pos: tuple[int, int],
+) -> tuple[list[tuple[int, int]], int]:
+    rr, cc = seed
+    dr, dc = direction
+    path: list[tuple[int, int]] = []
+    paintable = 0
+    while True:
+        rr += dr
+        cc += dc
+        if not (0 <= rr < h and 0 <= cc < w):
+            break
+        path.append((rr, cc))
+        if (rr, cc) != exit_pos:
+            paintable += 1
+    return path, paintable
