+
+def _mark_box(mask: np.ndarray, r0: int, c0: int, r1: int, c1: int) -> None:
+    rr0 = max(0, r0)
+    cc0 = max(0, c0)
+    rr1 = min(mask.shape[0] - 1, r1)
+    cc1 = min(mask.shape[1] - 1, c1)
