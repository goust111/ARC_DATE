+                    plans.append(
+                        {
+                            "bbox": (r0, c0, r1, c1),
+                            "seed": (seed_r, seed_c),
+                            "seed_color": seed_color,
+                            "exit": exit_pos,
+                            "dir": direction,
+                        }
