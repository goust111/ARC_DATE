+                continue
+
+            outer_h = random.randint(4, 8)
+            outer_w = random.randint(4, 8)
+            if outer_h >= h - 2 or outer_w >= w:
+                continue
+
+            inner_h = outer_h - 2
+            inner_w = outer_w - 2
