+    assert fences, "expected at least one rectangular fence"
+    return fences
+
+
+def _paint_ray(
+    out: np.ndarray,
+    seed: tuple[int, int],
+    direction: tuple[int, int],
+    exit_pos: tuple[int, int],
+    color: int,
+    steps: int,
+) -> None:
+    h, w = out.shape
+    rr, cc = seed
+    dr, dc = direction
