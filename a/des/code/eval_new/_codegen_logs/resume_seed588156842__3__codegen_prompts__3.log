+                    if any(bool(frame_blocked[rr, cc]) or bool(path_blocked[rr, cc]) for rr, cc in path if (rr, cc) not in _rect_border_coords(r0, c0, r1, c1)):
+                        continue
+
+                    grid[r0, c0 : c1 + 1] = MAROON
+                    grid[r1, c0 : c1 + 1] = MAROON
+                    grid[r0 : r1 + 1, c0] = MAROON
+                    grid[r0 : r1 + 1, c1] = MAROON
+                    grid[exit_pos] = ORANGE
+                    grid[seed_r, seed_c] = seed_color
+
+                    _mark_box(frame_blocked, r0 - 1, c0 - 1, r1 + 1, c1 + 1)
+                    _mark_box(path_blocked, r0 - 1, c0 - 1, r1 + 1, c1 + 1)
+                    for rr, cc in path:
+                        path_blocked[rr, cc] = True
+
+                    plans.append(
+                        {
+                            "bbox": (r0, c0, r1, c1),
+                            "seed": (seed_r, seed_c),
+                            "seed_color": seed_color,
+                            "exit": exit_pos,
+                            "dir": direction,
+                        }
+                    )
+                    placed = True
+                    break
+                if placed:
+                    break
+            if placed:
+                break
+        if not placed:
+            return None
+
+    expected = _build_expected(grid, plans, legend_index)
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate a valid input after {GEN_RETRIES} attempts")

