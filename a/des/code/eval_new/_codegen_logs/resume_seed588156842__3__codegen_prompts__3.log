+            assert (exit_c - seed_c) * dc > 0, "horizontal exit must lie ahead of the seed"
+
+        fences.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "seed": (seed_r, seed_c),
+                "seed_color": seed_color,
+                "exit": (exit_r, exit_c),
+                "dir": direction,
+            }
+        )
+
+    assert fences, "expected at least one rectangular fence"
+    return fences
+
+
+def _paint_ray(
+    out: np.ndarray,
+    seed: tuple[int, int],
+    direction: tuple[int, int],
+    exit_pos: tuple[int, int],
+    color: int,
+    steps: int,
+) -> None:
+    h, w = out.shape
+    rr, cc = seed
+    dr, dc = direction
+    painted = 0
+    while painted < steps:
+        rr += dr
+        cc += dc
+        if not (0 <= rr < h and 0 <= cc < w):
