+
+BLACK = 0
+GREY = 5
+ORANGE = 7
+MAROON = 9
+
+LEGEND_POOL = (1, 2, 3, 4, 6, 8)
+DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
