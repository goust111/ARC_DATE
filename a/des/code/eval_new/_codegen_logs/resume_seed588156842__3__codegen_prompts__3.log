+    rr, cc = seed
+    dr, dc = direction
+    path: list[tuple[int, int]] = []
+    paintable = 0
+    while True:
+        rr += dr
+        cc += dc
+        if not (0 <= rr < h and 0 <= cc < w):
+            break
