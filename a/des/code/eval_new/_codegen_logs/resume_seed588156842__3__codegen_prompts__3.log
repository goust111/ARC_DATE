+    directions = directions[:num_fences]
+    random.shuffle(directions)
+
+    clip_flags = [True] * (num_fences // 2) + [False] * (num_fences - num_fences // 2)
+    random.shuffle(clip_flags)
+
+    frame_blocked = np.zeros((h, w), dtype=bool)
