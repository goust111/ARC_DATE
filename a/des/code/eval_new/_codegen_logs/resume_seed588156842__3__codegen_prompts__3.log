+        values = list(range(0, hi + 1))
+    random.shuffle(values)
+    return values
+
+
+def _build_expected(inp: np.ndarray, plans: list[dict[str, object]], legend_index: dict[int, int]) -> np.ndarray:
+    out = inp.copy()
