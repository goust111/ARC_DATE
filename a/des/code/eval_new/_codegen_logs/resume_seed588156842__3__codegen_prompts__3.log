+        assert len(exits) == 1, "each fence must have exactly one orange exit"
+        exit_r, exit_c = exits[0]
+
+        side_dirs = []
+        if exit_r == r0:
+            side_dirs.append((-1, 0))
+        if exit_r == r1:
+            side_dirs.append((1, 0))
+        if exit_c == c0:
+            side_dirs.append((0, -1))
+        if exit_c == c1:
+            side_dirs.append((0, 1))
