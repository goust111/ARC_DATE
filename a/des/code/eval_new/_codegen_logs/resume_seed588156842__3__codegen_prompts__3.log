+        _paint_ray(
+            out,
+            seed=tuple(plan["seed"]),
+            direction=tuple(plan["dir"]),
+            exit_pos=tuple(plan["exit"]),
+            color=color,
+            steps=int(legend_index[color]),
+        )
+    return out
+
