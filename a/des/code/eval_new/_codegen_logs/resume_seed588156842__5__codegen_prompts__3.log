+    seen: dict[tuple[str, tuple[int, int], tuple[int, int]], int] = {}
+    for ar, ac in pts_a:
+        for br, bc in pts_b:
+            if ar == br:
+                left_c, right_c = sorted((ac, bc))
+                if right_c - left_c <= 1:
+                    continue
