+
+
+def _paint_cells(grid: np.ndarray, cells: set[tuple[int, int]], color: int) -> None:
+    for r, c in cells:
+        grid[r, c] = color
+
+
+def _find_separator_row(grid: np.ndarray, bg: int) -> int:
+    candidates = []
