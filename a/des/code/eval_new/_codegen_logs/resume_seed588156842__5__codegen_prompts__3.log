+                    end = (bottom_r, ac)
+                    seen[("v", start, end)] = bottom_r - top_r - 1
+
+    candidates = [(gap, orient, start, end) for (orient, start, end), gap in seen.items()]
+    candidates.sort(key=lambda item: (item[0], 0 if item[1] == "h" else 1, item[2], item[3]))
+    return candidates
+
+
+def _best_bridge(
+    region: np.ndarray,
+    color_a: int,
+    color_b: int,
+    bg: int,
