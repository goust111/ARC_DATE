+    expected_h = tuple(sorted((arm1, arm2), key=lambda p: p[1]))
+    expected_v = tuple(sorted((arm3, arm4), key=lambda p: p[0]))
+    if (h_candidates[0][2], h_candidates[0][3]) != expected_h:
+        return None
+    if (v_candidates[0][2], v_candidates[0][3]) != expected_v:
+        return None
