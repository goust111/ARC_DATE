+def _draw_bridge(
+    out: np.ndarray,
+    start: tuple[int, int],
+    end: tuple[int, int],
+    color: int,
+) -> None:
+    if start[0] == end[0]:
+        r = start[0]
+        for c in range(start[1] + 1, end[1]):
+            out[r, c] = color
+        return
+    c = start[1]
+    for r in range(start[0] + 1, end[0]):
+        out[r, c] = color
