+    full = np.full((top_h + 3, top_w), BG, dtype=int)
+    full[:top_h, :] = top
+    full[top_h, :] = GREY
+
+    route_specs = [
+        (island_colors[0], bridge_colors[0], island_colors[1]),
+        (island_colors[2], bridge_colors[1], island_colors[3]),
