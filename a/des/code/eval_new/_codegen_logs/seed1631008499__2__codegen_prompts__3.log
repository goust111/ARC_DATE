+    for color in map(int, np.unique(grid)):
+        wall_rows = [int(r) for r in np.where(np.all(grid == color, axis=1))[0]]
+        wall_cols = [int(c) for c in np.where(np.all(grid == color, axis=0))[0]]
+        if len(wall_rows) < 2 or len(wall_cols) < 2:
+            continue
