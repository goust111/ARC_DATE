+                colors = {int(g[r, c]) for r, c in coords}
+                assert len(colors) == 1
+                seed_color = next(iter(colors))
+                assert seed_color not in (bg, fence_color)
+                seed = {
+                    "coords": _sorted_coords(coords),
+                    "bbox": _bbox(coords),
+                    "color": int(seed_color),
+                    "size": len(coords),
+                }
+            else:
+                seed = None
+            regions[(i, j)] = {"bbox": bbox, "seed": seed}
+
+    return {
+        "grid": g,
+        "bg": int(bg),
+        "fence_color": int(fence_color),
+        "h_fences": h_fences,
+        "v_fences": v_fences,
+        "row_spans": row_spans,
+        "col_spans": col_spans,
+        "h_windows": h_windows,
+        "v_windows": v_windows,
+        "regions": regions,
+    }
