+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+FENCE = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+MAX_GENERATION_ATTEMPTS = 400
+
+SHAPES_BY_SIZE = {
+    2: (
+        ((0, 0), (0, 1)),
+        ((0, 0), (1, 0)),
+    ),
+    3: (
+        ((0, 0), (0, 1), (0, 2)),
+        ((0, 0), (1, 0), (2, 0)),
+        ((0, 0), (0, 1), (1, 0)),
