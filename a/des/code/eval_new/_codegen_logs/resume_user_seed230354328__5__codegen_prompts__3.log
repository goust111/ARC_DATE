+    candidates: list[tuple[int, frozenset[tuple[int, int]]]] = []
+    for pos in range(lo, hi + 1):
+        projected = _project_coords(coords, side, fence_index, pos)
+        if all(_in_bbox(pt, target_bbox) for pt in projected):
