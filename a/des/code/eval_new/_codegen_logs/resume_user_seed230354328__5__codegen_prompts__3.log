+def _build_spans(sizes: list[int]) -> tuple[list[tuple[int, int]], list[int]]:
+    spans: list[tuple[int, int]] = []
+    fences: list[int] = []
+    start = 0
+    for index, size in enumerate(sizes):
+        spans.append((start, start + size - 1))
+        start += size
+        if index != len(sizes) - 1:
+            fences.append(start)
+            start += 1
+    return spans, fences
