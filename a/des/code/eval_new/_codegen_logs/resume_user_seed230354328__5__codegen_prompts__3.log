+    seed_infos: list[dict] = []
+    for side, region, color, size in zip(chosen_sides, seed_regions, seed_colors, sizes, strict=False):
+        shape = rng.choice(SHAPES_BY_SIZE[size])
+        coords = _place_shape(rng, shape, region_bboxes[region])
