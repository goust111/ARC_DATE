+        if i > 0:
+            fence_r = h_fences[i - 1]
+            for _, wc in h_windows[fence_r]:
+                if c0 <= wc <= c1:
+                    target = regions[(i - 1, j)]["bbox"]
+                    tasks.append(
+                        {
+                            "seed": seed,
+                            "side": "top",
+                            "fence_index": fence_r,
+                            "window_pos": wc,
+                            "window_color": int(structure["grid"][fence_r, wc]),
+                            "target_bbox": target,
