+def _candidate_windows(
+    coords: list[tuple[int, int]],
+    side: str,
+    fence_index: int,
+    target_bbox: tuple[int, int, int, int],
+    segment_span: tuple[int, int],
+) -> list[tuple[int, frozenset[tuple[int, int]]]]:
