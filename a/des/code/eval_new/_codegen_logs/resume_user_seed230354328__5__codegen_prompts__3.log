+        if line_key[0] == "h":
+            fence_index = line_key[1]
+            segment_span = col_spans[segment_index]
+            proj_side = "bottom" if side == "top" else "top"
+            candidates = _candidate_windows(coords, proj_side, fence_index, target_bbox, segment_span)
