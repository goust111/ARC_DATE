+def _runs(bits: np.ndarray) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    start = None
+    for i, value in enumerate(np.asarray(bits, dtype=bool).tolist()):
+        if value and start is None:
+            start = i
+        elif not value and start is not None:
+            runs.append((start, i - 1))
+            start = None
+    if start is not None:
+        runs.append((start, len(bits) - 1))
+    return runs
+
+
+def _signature_from_runs(runs: list[tuple[int, int]]) -> tuple[int, ...]:
+    assert runs
+    pieces: list[int] = []
+    prev_end = None
+    for start, end in runs:
+        if prev_end is not None:
+            pieces.append(start - prev_end - 1)
+        pieces.append(end - start + 1)
+        prev_end = end
+    return tuple(pieces)
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_components(grid: np.ndarray, bg: int = BG) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg or seen[r, c]:
+                continue
+
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+
+            r0, c0, r1, c1 = _bbox(coords)
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in coords:
+                mask[rr - r0, cc - c0] = True
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": mask,
+                    "area": len(coords),
+                }
+            )
+    return comps
+
