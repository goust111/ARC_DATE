+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+
+LOCK_SIDES = ["top", "bottom", "left", "right"]
+LOCK_TOOTH_SIDE = {"top": "down", "bottom": "up", "left": "right", "right": "left"}
+
+GEN_RETRIES = 400
+SPEC_RETRIES = 120
+PLACEMENT_RETRIES = 80
