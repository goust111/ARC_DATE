+
+def _pattern_starts(widths: list[int], gaps: list[int]) -> list[int]:
+    starts: list[int] = []
+    pos = 0
+    for i, width in enumerate(widths):
+        starts.append(pos)
+        pos += width
+        if i < len(gaps):
+            pos += gaps[i]
