+            handle_col, tooth_col, tooth_side = 0, 1, "right"
+        elif np.all(mask[:, 1]) and np.any(mask[:, 0]):
+            handle_col, tooth_col, tooth_side = 1, 0, "left"
+        if tooth_col is None:
+            return None
+        tooth_vec = mask[:, tooth_col]
