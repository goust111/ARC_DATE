+    damaged = [side for side, vec in side_vectors.items() if not np.all(vec)]
+    if len(damaged) != 1:
+        return None
+
+    side = damaged[0]
+    for other_side, vec in side_vectors.items():
+        if other_side != side and not np.all(vec):
+            return None
+
+    missing_runs = _runs(~side_vectors[side])
+    if not missing_runs:
