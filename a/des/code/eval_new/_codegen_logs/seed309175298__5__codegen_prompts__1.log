    return random.randint(min_h, MAX_H), random.randint(min_w, MAX_W)


def _interior_bands(total: int, n: int) -> list[tuple[int, int]] | None:
    raw = _partition_bands(total - 2, n, MIN_BAND_SIZE, MAX_BAND_SIZE, BAND_GAP)
    if raw is None:
