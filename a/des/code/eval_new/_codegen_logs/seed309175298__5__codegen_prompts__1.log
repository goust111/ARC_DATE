+        handle_cells = [(r0 + handle_row, c0 + pos) for pos in range(w)]
+        return {
+            "kind": "key",
+            "color": int(comp["color"]),
+            "bbox": (r0, c0, r1, c1),
+            "axis": "horizontal",
+            "tooth_side": tooth_side,
+            "runs": tooth_runs,
+            "signature": _signature_from_runs(tooth_runs),
+            "tooth_cells": tooth_cells,
+            "handle_cells": handle_cells,
+        }
+
+    if w == 2 and h >= 3:
+        tooth_col = None
+        handle_col = None
+        tooth_side = None
