+    for lock in locks:
+        need = (lock["axis"], LOCK_TOOTH_SIDE[lock["side"]], lock["signature"])
+        assert need in key_map
+        key = key_map[need]
+        key_id = id(key)
+        assert key_id not in used_keys
+        used_keys.add(key_id)
