+def _classify_objects(grid: np.ndarray) -> tuple[list[dict], list[dict]]:
+    locks: list[dict] = []
+    keys: list[dict] = []
+    for comp in _find_components(grid):
+        lock = _parse_lock(comp)
+        if lock is not None:
+            locks.append(lock)
+            continue
+        key = _parse_key(comp)
+        if key is not None:
