+
+def _draw_lock(
+    patch: np.ndarray,
+    top: int,
+    left: int,
+    height: int,
+    width: int,
+    side: str,
+    starts: list[int],
+    widths: list[int],
+    color: int,
+    complete: bool,
+) -> None:
+    patch[top, left : left + width] = color
+    patch[top + height - 1, left : left + width] = color
+    patch[top : top + height, left] = color
+    patch[top : top + height, left + width - 1] = color
