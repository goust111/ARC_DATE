+
+
+def _make_pair_spec(lock_color: int, key_color: int, used_signatures: set[tuple[int, ...]]) -> dict | None:
+    side = random.choice(LOCK_SIDES)
+    axis = "horizontal" if side in ("top", "bottom") else "vertical"
+    tooth_side = LOCK_TOOTH_SIDE[side]
