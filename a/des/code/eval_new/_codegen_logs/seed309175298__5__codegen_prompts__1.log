+            assert len(gap_row) == 1 and len(tooth_row) == 1 and gap_row == tooth_row
+            delta = min(c for _r, c in gap_cells) - min(c for _r, c in tooth_cells)
+            shifted = {(r, c + delta) for r, c in tooth_cells}
+        else:
