+            tooth_col = {c for _r, c in tooth_cells}
+            assert len(gap_col) == 1 and len(tooth_col) == 1 and gap_col == tooth_col
+            delta = min(r for r, _c in gap_cells) - min(r for r, _c in tooth_cells)
