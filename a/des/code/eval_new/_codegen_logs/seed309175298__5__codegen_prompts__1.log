+            "axis": axis,
+            "tooth_side": tooth_side,
+            "signature": signature,
+            "widths": widths,
+            "lock_starts": lock_starts,
+            "key_starts": key_starts,
+            "lock_height": height,
+            "lock_width": width,
+            "key_length": key_length,
