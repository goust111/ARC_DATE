+def _build_group(spec: dict) -> tuple[np.ndarray, np.ndarray]:
+    axis = spec["axis"]
+    side = spec["side"]
+    tooth_side = spec["tooth_side"]
+    height = int(spec["lock_height"])
+    width = int(spec["lock_width"])
+    key_length = int(spec["key_length"])
+    sep = int(spec["sep"])
+    start_dir = spec["start_dir"]
