+    if h == 2 and w >= 3:
+        tooth_row = None
+        handle_row = None
+        tooth_side = None
+        if np.all(mask[0]) and np.any(mask[1]):
+            handle_row, tooth_row, tooth_side = 0, 1, "down"
+        elif np.all(mask[1]) and np.any(mask[0]):
