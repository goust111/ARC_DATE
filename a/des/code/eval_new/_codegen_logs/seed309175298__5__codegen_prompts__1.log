+
+    gap_cells: list[tuple[int, int]] = []
+    if side == "top":
+        for start, end in missing_runs:
+            for pos in range(start, end + 1):
+                gap_cells.append((r0, c0 + 1 + pos))
+    elif side == "bottom":
