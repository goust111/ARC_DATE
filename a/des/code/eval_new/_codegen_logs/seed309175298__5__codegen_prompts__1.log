+            return None
+        tooth_cells = [(r0 + pos, c0 + tooth_col) for pos, present in enumerate(tooth_vec.tolist()) if present]
+        handle_cells = [(r0 + pos, c0 + handle_col) for pos in range(h)]
+        return {
+            "kind": "key",
+            "color": int(comp["color"]),
+            "bbox": (r0, c0, r1, c1),
+            "axis": "vertical",
+            "tooth_side": tooth_side,
+            "runs": tooth_runs,
