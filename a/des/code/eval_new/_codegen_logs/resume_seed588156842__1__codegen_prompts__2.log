+    if pair == frozenset((PRIMARY_BITS[BLUE], PRIMARY_BITS[YELLOW])):
+        return "blue_yellow"
+    if pair == frozenset((PRIMARY_BITS[RED], PRIMARY_BITS[GREEN])):
+        return "red_green"
