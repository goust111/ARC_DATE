+        bottom_buffer = int(rng.integers(1, min(4, bottom_limit) + 1))
+        specs.append(
+            PathSpec(
+                axis="v",
+                line=int(col),
+                start=min_row - top_buffer,
+                end=max_row + bottom_buffer,
+                direction=vdir,
+                color=int(color),
+            )
+        )
