+
+
+def _sample_isolated_path(
+    shape: tuple[int, int],
+    hdir: int,
+    vdir: int,
+    rng: np.random.Generator,
+) -> list[PathSpec] | None:
+    height, width = shape
+    axis = "h" if rng.random() < 0.5 else "v"
+    if axis == "h":
