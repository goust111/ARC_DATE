+def _in_bounds(shape: tuple[int, int], row: int, col: int) -> bool:
+    return 0 <= row < shape[0] and 0 <= col < shape[1]
+
+
+def _is_valid_generated_case(grid: np.ndarray, branch: str) -> bool:
