+    used_by_dims: dict[tuple[int, int], set[ShapeSig]] = defaultdict(set)
+    shapes: list[tuple[ShapeSig, ShapeSig]] = []
+    for h, w in dims:
+        sampled = _sample_complementary_shapes(h, w, used_by_dims[(h, w)], rng)
+        if sampled is None:
+            return None
