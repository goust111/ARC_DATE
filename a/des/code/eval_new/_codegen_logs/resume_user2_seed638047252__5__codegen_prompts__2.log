+def _shape_spans(sig: ShapeSig, h: int, w: int) -> bool:
+    rows = {r for r, _ in sig}
+    cols = {c for _, c in sig}
+    return 0 in rows and (h - 1) in rows and 0 in cols and (w - 1) in cols
