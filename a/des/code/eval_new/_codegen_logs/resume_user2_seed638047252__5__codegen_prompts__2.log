+# --------------- generator ---------------
+
+GEN_ATTEMPTS = 300
+MASK_ATTEMPTS = 600
+GRID_HEIGHT_RANGE = (20, 30)
+GRID_WIDTH_RANGE = (20, 30)
+PAIR_COUNT_CHOICES = (2, 3, 4)
+RECT_SIDE_CHOICES = (3, 4, 5, 6)
+AREA_RATIO_RANGE = (0.3, 0.7)
