+
+
+def _place_pair(
+    occupied: np.ndarray,
+    h: int,
+    w: int,
+    same_row: bool,
+    rng: random.Random,
+) -> tuple[tuple[int, int], tuple[int, int]] | None:
+    grid_h, grid_w = occupied.shape
+    anchors = [(r, c) for r in range(grid_h - h + 1) for c in range(grid_w - w + 1)]
+    rng.shuffle(anchors)
