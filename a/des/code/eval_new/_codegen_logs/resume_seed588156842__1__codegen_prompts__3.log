+    return {
+        "color": color,
+        "top": r0,
+        "left": c0,
+        "height": height,
+        "width": width,
+        "area": height * width,
+    }
+
+
+def _extract_scene(grid: np.ndarray) -> tuple[int, tuple[int, int, int], list[dict]]:
