+def _odd_values(lo: int, hi: int) -> list[int]:
+    lo = int(lo)
+    hi = int(hi)
+    if lo > hi:
+        return []
+    if lo % 2 == 0:
+        lo += 1
+    return list(range(lo, hi + 1, 2))
