+    if int(coords.shape[0]) != expected_area:
+        return None
+
+    window = grid[r0 : r1 + 1, c0 : c1 + 1]
+    border = np.zeros((height, width), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    if not np.all(window[border] == color):
+        return None
+    if not np.all(window[~border] == bg):
+        return None
