+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
