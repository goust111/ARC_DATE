+        if _rotation_variant_count(mask) < 2:
+            continue
+        return mask
+    return None
+
+
+def _sample_unique_shapes(count: int) -> list[np.ndarray] | None:
+    for _ in range(MAX_SET_ATTEMPTS):
+        shapes: list[np.ndarray] = []
+        keys: set[tuple[str, ...]] = set()
