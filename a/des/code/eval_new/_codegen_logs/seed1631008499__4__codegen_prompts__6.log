+
+def _render_mask(grid: np.ndarray, mask: np.ndarray, r0: int, c0: int, color: int) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    for dr, dc in np.argwhere(mask):
+        rr = int(r0 + dr)
+        cc = int(c0 + dc)
+        grid[rr, cc] = int(color)
+        cells.append((rr, cc))
+    return cells
