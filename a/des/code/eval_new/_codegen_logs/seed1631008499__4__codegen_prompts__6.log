+    ph, pw = mask.shape
+    row_mid = h // 2
+    col_mid = w // 2
+
+    if quadrant[0] == "t":
+        row_range = range(0, row_mid - ph + 1)
+    else:
+        row_range = range(row_mid, h - ph + 1)
+
+    if quadrant[1] == "l":
+        col_range = range(0, col_mid - pw + 1)
+    else:
+        col_range = range(col_mid, w - pw + 1)
