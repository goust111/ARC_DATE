+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+BG_COLOR = 0
+GRID_MIN = 20
+GRID_MAX = 30
+HOLE_COUNT_RANGE = (2, 4)
+TEMPLATE_MIN_SIDE = 8
+TEMPLATE_MAX_SIDE = 16
+SHAPE_AREA_RANGE = (3, 6)
+SHAPE_MAX_SIDE = 4
+MAX_SHAPE_ATTEMPTS = 120
+MAX_SET_ATTEMPTS = 240
+MAX_GENERATION_ATTEMPTS = 400
+PADDING = 1
+QUADRANTS = ("tl", "tr", "bl", "br")
