+GRID_MAX = 30
+HOLE_COUNT_RANGE = (2, 4)
+TEMPLATE_MIN_SIDE = 8
+TEMPLATE_MAX_SIDE = 16
+SHAPE_AREA_RANGE = (3, 6)
