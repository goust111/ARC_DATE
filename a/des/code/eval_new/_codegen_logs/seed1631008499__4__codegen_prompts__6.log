+    holes_by_key: dict[tuple[str, ...], list[tuple[int, int]]] = {}
+    for hole in holes:
+        key = _canonical_rotation_key(_cells_to_mask(hole))
+        assert key not in holes_by_key, "holes must be unique up to rotation"
+        holes_by_key[key] = hole
