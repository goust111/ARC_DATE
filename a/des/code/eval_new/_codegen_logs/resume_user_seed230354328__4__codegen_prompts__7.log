+
+def _path_cells(
+    start: tuple[int, int],
+    target: tuple[int, int],
+    row_first: bool,
+) -> list[tuple[int, int]]:
+    r, c = start
+    tr, tc = target
+    pts = [(r, c)]
+    if row_first:
+        step = 1 if tr > r else -1
+        while r != tr:
+            r += step
+            pts.append((r, c))
+        if tc != c:
+            step = 1 if tc > c else -1
+            while c != tc:
+                c += step
+                pts.append((r, c))
+    else:
+        if tc != c:
+            step = 1 if tc > c else -1
+            while c != tc:
+                c += step
+                pts.append((r, c))
+        if tr != r:
+            step = 1 if tr > r else -1
+            while r != tr:
+                r += step
+                pts.append((r, c))
+    return pts
+
