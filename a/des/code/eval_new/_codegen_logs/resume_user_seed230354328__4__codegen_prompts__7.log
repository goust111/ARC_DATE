+def _make_stamp(
+    h: int,
+    w: int,
+    anchor_color: int,
+    fill_color: int,
+    bg: int,
+    rng: random.Random,
+) -> np.ndarray:
+    patch = np.full((h, w), bg, dtype=int)
+    center = (h // 2, w // 2)
+
+    targets = [
+        (0, rng.randrange(w)),
+        (h - 1, rng.randrange(w)),
+        (rng.randrange(h), 0),
+        (rng.randrange(h), w - 1),
+    ]
+    fill_cells: set[tuple[int, int]] = set()
+    all_cells: set[tuple[int, int]] = {center}
+    for target in targets:
+        for cell in _path_cells(center, target, row_first=bool(rng.randrange(2))):
+            all_cells.add(cell)
+            if cell != center:
+                fill_cells.add(cell)
+
+    extra = rng.randint(0, max(2, (h * w) // 3))
+    while extra > 0:
+        frontier = set()
+        for r, c in all_cells:
+            for nr, nc in _neighbors4(r, c, h, w):
+                if (nr, nc) not in all_cells:
+                    frontier.add((nr, nc))
+        if not frontier:
+            break
+        cell = rng.choice(tuple(frontier))
+        all_cells.add(cell)
+        fill_cells.add(cell)
+        extra -= 1
