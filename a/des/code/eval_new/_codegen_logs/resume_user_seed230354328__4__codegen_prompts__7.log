+    bg_sub = ~sub
+    seen = np.zeros_like(bg_sub, dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    sh, sw = sub.shape
+
+    for r in range(sh):
+        for c in (0, sw - 1):
+            if bg_sub[r, c] and not seen[r, c]:
+                seen[r, c] = True
