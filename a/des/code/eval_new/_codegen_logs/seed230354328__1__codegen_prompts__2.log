+
+def _trace_target(
+    tip: tuple[int, int],
+    direction: tuple[int, int],
+    mirrors: dict[tuple[int, int], str],
+    interior_lookup: dict[tuple[int, int], int],
+    shape: tuple[int, int],
+) -> int:
+    h, w = shape
+    r, c = tip
+    dr, dc = direction
+    seen: set[tuple[int, int, int, int]] = set()
+    while True:
