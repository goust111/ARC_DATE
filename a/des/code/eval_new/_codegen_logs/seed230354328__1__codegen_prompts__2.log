+        tips: list[tuple[int, int, str]] = []
+        for r, c in pts:
+            if any((r + dr, c + dc) in pts for dr, dc in ORTHO_DIRS):
+                continue
+            for name, backs in ARROW_BACK.items():
+                if all((r + dr, c + dc) in pts for dr, dc in backs):
