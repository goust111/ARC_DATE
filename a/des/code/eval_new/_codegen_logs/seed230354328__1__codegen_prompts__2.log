+        DIRS["right"]: DIRS["up"],
+        DIRS["up"]: DIRS["left"],
+        DIRS["down"]: DIRS["right"],
+    },
+    "/": {
+        DIRS["left"]: DIRS["up"],
+        DIRS["right"]: DIRS["down"],
+        DIRS["up"]: DIRS["right"],
+        DIRS["down"]: DIRS["left"],
