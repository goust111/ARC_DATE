+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+BG = 0
+MIRROR = 4
+FRAME = 5
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+ORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+ARROW_BACK = {
+    "up": ((1, -1), (1, 1)),
+    "down": ((-1, -1), (-1, 1)),
+    "left": ((-1, 1), (1, 1)),
+    "right": ((-1, -1), (1, -1)),
+}
+REFLECT = {
+    "\\": {
+        DIRS["left"]: DIRS["down"],
+        DIRS["right"]: DIRS["up"],
+        DIRS["up"]: DIRS["left"],
+        DIRS["down"]: DIRS["right"],
+    },
+    "/": {
+        DIRS["left"]: DIRS["up"],
+        DIRS["right"]: DIRS["down"],
+        DIRS["up"]: DIRS["right"],
+        DIRS["down"]: DIRS["left"],
+    },
+}
+
+SOURCE_COLORS = [1, 2, 3, 6, 7, 8, 9]
+MIRROR_TYPES = ("\\", "/")
+GEN_RETRIES = 400
+ENTITY_RETRIES = 600
+
+
+def _components(mask: np.ndarray, connectivity: int) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    steps = ORTHO_DIRS if connectivity == 4 else ORTHO_DIRS + DIAG_DIRS
+    comps: list[list[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        seen[r, c] = True
+        q = deque([(r, c)])
+        comp: list[tuple[int, int]] = []
+        while q:
+            rr, cc = q.popleft()
+            comp.append((rr, cc))
+            for dr, dc in steps:
+                nr, nc = rr + dr, cc + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        comps.append(comp)
+    return comps
+
+
+def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _frame_border(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    cells: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        cells.append((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        cells.append((r, c1))
+    return cells
+
+
+def _frame_interior(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    return [(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1)]
+
+
+def _all_in_bounds(cells: set[tuple[int, int]], h: int, w: int) -> bool:
+    return all(0 <= r < h and 0 <= c < w for r, c in cells)
+
+
+def _halo(cells: set[tuple[int, int]], h: int, w: int, radius: int = 1) -> set[tuple[int, int]]:
+    expanded: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for dr in range(-radius, radius + 1):
+            for dc in range(-radius, radius + 1):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    expanded.add((nr, nc))
+    return expanded
+
+
+def _line_cells(
+    start: tuple[int, int], end: tuple[int, int], direction: tuple[int, int]
+) -> list[tuple[int, int]]:
+    cells = [start]
+    r, c = start
+    dr, dc = direction
+    while (r, c) != end:
