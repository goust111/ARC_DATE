+        elif in_dir == DIRS["down"]:
+            tip = (mr - gap_in, mc)
+        else:
+            tip = (mr + gap_in, mc)
+
+        block_arrow = _block_and_arrow_from_tip(tip, direction_name, rng)
+        assert block_arrow is not None
+        block_cells, arrow_cells = block_arrow
+
+        pre_path = set(_line_cells(tip, mirror_cell, in_dir))
+        post_path = set(_line_cells(mirror_cell, enter, out_dir))
+        structural = frame_border | frame_interior | block_cells | arrow_cells | pre_path | post_path
+        if not _all_in_bounds(structural, h, w):
+            continue
+
+        for mirror_cells in _mirror_segment_candidates(mirror_cell, mirror_type, h, w, rng):
+            visible = frame_border | block_cells | arrow_cells | set(mirror_cells)
+            protected = visible | frame_interior | pre_path | post_path
+            reserve_cells = _halo(visible | frame_interior, h, w, 1) | _halo(pre_path | post_path, h, w, 1)
