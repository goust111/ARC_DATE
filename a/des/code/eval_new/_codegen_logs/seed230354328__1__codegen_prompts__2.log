+
+def _mirror_segment_candidates(
+    mirror_cell: tuple[int, int], orient: str, h: int, w: int, rng: random.Random
+) -> list[list[tuple[int, int]]]:
+    mr, mc = mirror_cell
+    step = (1, 1) if orient == "\\" else (1, -1)
+    candidates: list[list[tuple[int, int]]] = []
+    lengths = [2, 3, 4, 5]
