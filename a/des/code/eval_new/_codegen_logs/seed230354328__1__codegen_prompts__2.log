+import random
+from collections import deque
+
+import numpy as np
+
+BG = 0
+MIRROR = 4
+FRAME = 5
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+ORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+ARROW_BACK = {
+    "up": ((1, -1), (1, 1)),
+    "down": ((-1, -1), (-1, 1)),
+    "left": ((-1, 1), (1, 1)),
+    "right": ((-1, -1), (1, -1)),
+}
+REFLECT = {
+    "\\": {
+        DIRS["left"]: DIRS["down"],
+        DIRS["right"]: DIRS["up"],
+        DIRS["up"]: DIRS["left"],
+        DIRS["down"]: DIRS["right"],
+    },
+    "/": {
+        DIRS["left"]: DIRS["up"],
+        DIRS["right"]: DIRS["down"],
+        DIRS["up"]: DIRS["right"],
+        DIRS["down"]: DIRS["left"],
+    },
+}
+
+SOURCE_COLORS = [1, 2, 3, 6, 7, 8, 9]
+MIRROR_TYPES = ("\\", "/")
+GEN_RETRIES = 400
+ENTITY_RETRIES = 600
