+def _sample_combos(n_entities: int, rng: random.Random) -> list[tuple[str, str]]:
+    directions = rng.sample(list(DIRS.keys()), n_entities)
+    mirror_types = list(MIRROR_TYPES[: min(2, n_entities)])
+    while len(mirror_types) < n_entities:
