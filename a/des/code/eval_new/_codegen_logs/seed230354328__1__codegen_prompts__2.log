+                "color": color,
+                "tip": tip,
+                "direction": in_dir,
+                "frame_border": frame_border,
+                "frame_interior": frame_interior,
+                "mirror_cells": set(mirror_cells),
+                "source_cells": block_cells | arrow_cells,
+                "expected_enter": enter,
+                "reserve_cells": reserve_cells,
+            }
+    return None
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    n_entities = rng.randint(2, 4)
+    min_side = 18 + 2 * (n_entities - 2)
+    h = rng.randint(min_side, 30)
+    w = rng.randint(min_side, 30)
+    reserved = np.zeros((h, w), dtype=bool)
+    entities: list[dict[str, object]] = []
+
+    combos = _sample_combos(n_entities, rng)
+    colors = rng.sample(SOURCE_COLORS, n_entities)
+    for (direction_name, mirror_type), color in zip(combos, colors):
+        entity = _place_entity(h, w, reserved, direction_name, mirror_type, color, rng)
+        if entity is None:
+            return None
+        for r, c in entity["reserve_cells"]:  # type: ignore[index]
+            reserved[r, c] = True
+        entities.append(entity)
+
+    grid = np.full((h, w), BG, dtype=int)
+    for entity in entities:
