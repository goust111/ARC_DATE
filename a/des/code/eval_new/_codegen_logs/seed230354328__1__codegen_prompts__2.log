+DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+ARROW_BACK = {
+    "up": ((1, -1), (1, 1)),
+    "down": ((-1, -1), (-1, 1)),
+    "left": ((-1, 1), (1, 1)),
