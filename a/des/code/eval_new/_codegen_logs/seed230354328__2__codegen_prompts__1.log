+
+    expected = _expected_output(grid, frame_specs, positions, color_to_fill, legend_order)
+    if np.array_equal(expected, grid):
+        return None
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
