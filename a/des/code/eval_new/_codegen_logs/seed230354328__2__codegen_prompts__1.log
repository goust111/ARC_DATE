TIP_GAP_MIN, TIP_GAP_MAX = 1, 2

# Object area and growth bounds.
WINNER_AREA_MIN, WINNER_AREA_MAX = 8, 22
LOSER_AREA_MIN = 3
OBJECT_AREA_MIN, OBJECT_AREA_MAX = 3, 22
MAX_GROWTH_LAYERS, MAX_HALF_WIDTH_STEP = 10, 2

# Cap, spacing, and retry limits.
CAP_OFFSETS = (-1, 0, 1)
