+BG = 0
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+PALETTE = tuple(range(1, 10))
+SLOT = 15
+BRANCH_MAX = 3
+OUTER_SIDES = (7, 9)
+GEN_ATTEMPTS = 300
