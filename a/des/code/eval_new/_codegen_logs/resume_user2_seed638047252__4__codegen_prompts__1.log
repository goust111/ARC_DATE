+from __future__ import annotations
+
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+PALETTE = tuple(range(1, 10))
+SLOT = 15
+BRANCH_MAX = 3
+OUTER_SIDES = (7, 9)
+GEN_ATTEMPTS = 300
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _rect_border(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    border: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        border.add((r0, c))
+        border.add((r1, c))
+    for r in range(r0 + 1, r1):
+        border.add((r, c0))
+        border.add((r, c1))
+    return border
+
+
+def _find_frames(grid: np.ndarray) -> list[dict[str, int | tuple[int, int, int, int]]]:
+    frames: list[dict[str, int | tuple[int, int, int, int]]] = []
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != BG):
+        for comp in _components(grid == color):
+            r0, c0, r1, c1 = _bbox(comp)
+            if r1 - r0 < 2 or c1 - c0 < 2:
+                continue
+            if set(comp) == _rect_border(r0, c0, r1, c1):
+                frames.append({"color": color, "bbox": (r0, c0, r1, c1)})
+    frames.sort(key=lambda frame: (frame["bbox"][0], frame["bbox"][1], frame["color"]))  # type: ignore[index]
+    return frames
+
+
+def _centroid_direction(
+    points: list[tuple[int, int]], center_r: float, center_c: float
+) -> str | None:
+    if not points:
+        return None
+    mean_r = float(np.mean([r for r, _ in points]))
+    mean_c = float(np.mean([c for _, c in points]))
+    dr = mean_r - center_r
+    dc = mean_c - center_c
+    if abs(dr) > abs(dc):
+        return "down" if dr > 0 else "up"
+    if abs(dc) > abs(dr):
+        return "right" if dc > 0 else "left"
+    if abs(dr) > 1e-9:
+        return "down" if dr > 0 else "up"
+    if abs(dc) > 1e-9:
+        return "right" if dc > 0 else "left"
+    return None
+
+
+def _paint_branch(
+    grid: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    direction: str,
+    length: int,
+    color: int,
+) -> None:
+    r0, c0, r1, c1 = bbox
+    mid_r = (r0 + r1) // 2
+    mid_c = (c0 + c1) // 2
+    dr, dc = DIRS[direction]
+    if direction == "up":
+        start_r, start_c = r0 - 1, mid_c
+    elif direction == "down":
+        start_r, start_c = r1 + 1, mid_c
+    elif direction == "left":
+        start_r, start_c = mid_r, c0 - 1
+    else:
+        start_r, start_c = mid_r, c1 + 1
+
+    h, w = grid.shape
+    for step in range(length):
+        rr = start_r + dr * step
+        cc = start_c + dc * step
+        if 0 <= rr < h and 0 <= cc < w:
+            grid[rr, cc] = color
