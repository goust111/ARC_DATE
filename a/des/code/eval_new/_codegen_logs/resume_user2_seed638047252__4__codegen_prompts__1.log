 128:         if max_len <= 0:
 129:             continue
 130:         if len(colors) > max_len:
 131:             colors = colors[-max_len:]
 132: 
 133:         start_row = desired_bottom - len(colors) + 1
 134:         start_row = max(start_row, interior_top)
 135: 
 136:         # Paint (overwrite) within the interior only.
 137:         for i, colv in enumerate(colors):
 138:             rr = start_row + i
 139:             if interior_top <= rr <= interior_bottom:
 140:                 out[rr, col] = colv
 141: 
 142:     return out

