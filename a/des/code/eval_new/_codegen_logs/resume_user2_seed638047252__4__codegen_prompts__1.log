  35: def main(grid: np.ndarray) -> np.ndarray:
  36:     """
  37:     Fill the one blank in each corner region so all four regions have the same color multiset.
  38: 
  39:     Input structure:
  40:     - The dominant background color forms one solid separator row and one solid
  41:       separator column.
  42:     - The separator cross splits the grid into four equal rectangular corner regions.
  43:     - Each corner region contains exactly one background-colored blank pixel.
  44: 
  45:     Rule:
  46:     - Count the non-background colors in each corner region.
  47:     - The completed region multiset is defined by the maximum observed count of
  48:       each color across the four regions.
  49:     - Replace each region's blank pixel with the single color needed to match that
  50:       completed multiset.
  51: 
  52:     Key insight:
  53:     - The separator color inside a corner region is a missing value marker; comparing
  54:       the four regions reveals the shared multiset without using numeric color order.
  55:     """
  56:     g = np.asarray(grid, dtype=int)
  57:     assert g.ndim == 2, "expected a 2D grid"
  58:     height, width = map(int, g.shape)
  59: 
  60:     bg = get_bg(g)
  61:     color_counts = Counter(map(int, g.reshape(-1)))
  62:     assert all(
  63:         color == bg or count < color_counts[bg] for color, count in color_counts.items()
  64:     ), "background color must be uniquely dominant"
  65: 
  66:     cross_row, cross_col = _solid_separator_cross(g, bg)
  67:     regions = _quadrants(cross_row, cross_col, height, width)
  68:     region_shape = g[regions[0]].shape
  69:     region_area = int(np.prod(region_shape))
  70: 
  71:     counts_by_region: list[Counter[int]] = []
  72:     blank_positions: list[tuple[int, int]] = []
  73:     for row_slice, col_slice in regions:
  74:         region = g[row_slice, col_slice]
  75:         assert region.shape == region_shape, "all corner regions must have the same shape"
  76:         blanks = np.argwhere(region == bg)
  77:         assert len(blanks) == 1, "each corner region must have exactly one blank"
  78: 
  79:         counts_by_region.append(Counter(map(int, region[region != bg].reshape(-1))))
  80:         local_r, local_c = map(int, blanks[0])
  81:         blank_positions.append((row_slice.start + local_r, col_slice.start + local_c))
  82: 
  83:     target_counts: Counter[int] = Counter()
  84:     for counts in counts_by_region:
  85:         for color, count in counts.items():
  86:             target_counts[color] = max(target_counts[color], count)
  87:     assert sum(target_counts.values()) == region_area, "completed region multiset must be unique"
  88: 
  89:     out = g.copy()
  90:     for counts, (row, col) in zip(counts_by_region, blank_positions):
  91:         missing = target_counts - counts
  92:         assert len(missing) == 1, "each blank must have exactly one matching fill color"
  93:         fill_color, fill_count = next(iter(missing.items()))
  94:         assert fill_count == 1, "each corner region must need one pixel of the fill color"
  95:         out[row, col] = fill_color
  96: 
  97:     return out

