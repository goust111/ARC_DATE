  14: def main(grid: np.ndarray) -> np.ndarray:
  15:     """
  16:     Fit a grey bar into a grey frame by aligning projections with colored columns, then stack colors above.
  17: 
  18:     Input structure:
  19:     - bg, a grey structural color forming two components: a large rectangular frame (slot) and a smaller bar with upward projections.
  20:     - Colored pixels inside the slot mark target columns.
  21: 
  22:     Rule:
  23:     - Move the bar upward into the slot so its bottom edge sits one cell above the slot's interior bottom.
  24:     - Shift it horizontally so the bar's upward projections align column-wise with the colored pixels in the slot.
  25:     - Stack the colored pixels immediately above the bar projections in each column.
  26: 
  27:     Key insight: The bar's projections act as keys that must align with the colored-column "locks" in the slot.
  28:     """
  29:     g = np.asarray(grid, dtype=int)
  30:     h, w = g.shape
  31: 
  32:     # Background: most frequent. "Grey" structural color: most frequent non-bg.
  33:     bg = _bg_color(g)
  34:     other = g[g != bg]
  35:     if other.size == 0:
  36:         return g.copy()
  37:     grey = _most_common(other)
  38: 
  39:     def comps_of_color(color: int):
  40:         comps = [(len(pts), _bbox(pts), pts) for pts in _cc4(g == color)]
  41:         comps.sort(key=lambda t: (-t[0], t[1]))
  42:         return comps
  43: 
  44:     grey_comps = comps_of_color(grey)
  45:     if len(grey_comps) < 2:
  46:         return g.copy()
  47: 
  48:     # Slot is the largest grey component (the right-side frame); bar is the next largest.
  49:     (_, slot_bbox, _), (_, bar_bbox, bar_pts) = grey_comps[0], grey_comps[1]
  50:     sr0, sc0, sr1, sc1 = slot_bbox
  51: 
  52:     # Base output: keep only the slot bbox content, clear all colored pixels inside it.
  53:     out = np.full_like(g, bg)
  54:     out[sr0 : sr1 + 1, sc0 : sc1 + 1] = g[sr0 : sr1 + 1, sc0 : sc1 + 1]
  55:     slot_region = out[sr0 : sr1 + 1, sc0 : sc1 + 1]
  56:     slot_region[(slot_region != bg) & (slot_region != grey)] = bg
  57: 
  58:     # Compute bar translation: bottom of bar sits 1 cell above slot interior bottom.
  59:     bar_base_row = max(r for r, _ in bar_pts)
  60:     slot_interior_bottom = sr1 - 1
  61:     target_base_row = slot_interior_bottom - 1
  62:     dy = target_base_row - bar_base_row
  63: 
  64:     # Determine bar projection columns (columns with any bar pixel above the base row).
  65:     col_min_row = {}
  66:     for r, c in bar_pts:
  67:         col_min_row[c] = min(col_min_row.get(c, r), r)
  68:     src_proj_cols = sorted([c for c, rmin in col_min_row.items() if rmin < bar_base_row])
  69: 
  70:     # Determine destination columns from colored pixels in the original slot.
  71:     dst_cols_set = set()
