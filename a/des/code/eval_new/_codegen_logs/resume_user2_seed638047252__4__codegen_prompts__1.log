  94: def main(grid: np.ndarray) -> np.ndarray:
  95:     """Translate the colored objects into the most balanced complete rectangular frame.
  96: 
  97:     Input structure
  98:     A grid with one dominant background color and several monochromatic
  99:     4-connected foreground objects that are straight bars or corner-like line
 100:     sprites.
 101: 
 102:     Rule
 103:     Preserve every foreground object exactly, allowing translation only, and
 104:     place the objects so they cover every pixel of a one-cell-thick rectangular
 105:     frame exactly once; the frame interior is the background color.
 106: 
 107:     Key insight
 108:     The output shape is not copied from the input: the foreground pixel count
 109:     determines possible frame sizes, and the intended output is the valid frame
 110:     assembly with the least difference between height and width.
 111:     """
 112:     g = np.asarray(grid, dtype=int)
 113:     bg = get_bg(g)
 114:     components = find_components(
 115:         g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"
 116:     )
 117:     assert components, "at least one foreground object is required"
 118: 
 119:     objects: list[dict] = []
 120:     for comp in components:
 121:         r0, c0, r1, c1 = comp["bbox"]
 122:         rel = tuple(
 123:             sorted((int(r - r0), int(c - c0)) for r, c in comp["coords"])
 124:         )
 125:         objects.append(
 126:             {
 127:                 "color": int(comp["color"]),
 128:                 "bbox": (int(r0), int(c0), int(r1), int(c1)),
 129:                 "rel": rel,
 130:                 "h": int(r1 - r0 + 1),
 131:                 "w": int(c1 - c0 + 1),
 132:                 "area": int(comp["area"]),
 133:             }
 134:         )
 135: 
 136:     objects.sort(key=lambda obj: (obj["bbox"][0], obj["bbox"][1], -obj["area"]))
 137:     total_area = sum(obj["area"] for obj in objects)
 138:     best = _candidate_outputs(bg, objects, total_area)
 139:     return best[0]

