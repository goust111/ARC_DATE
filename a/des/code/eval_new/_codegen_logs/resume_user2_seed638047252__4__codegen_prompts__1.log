 104:     # Move colored pixels: for each affected column, stack them immediately above the top of the bar in that column.
 105:     # Use colors from the original grid (inside slot bbox), ordered top->bottom.
 106:     placed_by_col = {}
 107:     for rr, cc in placed:
 108:         placed_by_col.setdefault(cc, []).append(rr)
 109: 
 110:     interior_top = sr0 + 1
 111:     interior_bottom = sr1 - 1
 112: 
 113:     for col in dst_cols:
 114:         if col not in placed_by_col:
 115:             continue
 116:         bar_top = min(placed_by_col[col])
 117:         desired_bottom = bar_top - 1
 118:         if desired_bottom < interior_top:
 119:             continue
 120: 
 121:         # Extract original colored pixels in this column (ignore bg/grey).
 122:         rows = [r for r in range(sr0, sr1 + 1) if g[r, col] != bg and g[r, col] != grey]
 123:         if not rows:
