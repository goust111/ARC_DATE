  14: def main(grid: np.ndarray) -> np.ndarray:
  15:     """
  16:     Expand the colored runs from the left reference panel into the blank right panel.
  17: 
  18:     Input structure:
  19:     - A uniform rectangular frame surrounds the grid.
  20:     - One full-height divider of the frame color splits a left reference panel
  21:       from a blank right panel.
  22:     - Both panels have one background margin column on each side of their active
  23:       columns; the left active columns contain two-column endpoint slots, possibly
  24:       connected by same-color horizontal runs.
  25: 
  26:     Rule:
  27:     - Keep the original grid and paint only in the right panel's active columns.
  28:     - A source run exactly matching the left endpoint slot is copied to the left
  29:       two columns of the right active span.
  30:     - A source run exactly matching the right endpoint slot is copied to the right
  31:       two columns of the right active span.
  32:     - A source run connecting the endpoint slots is stretched across the entire
  33:       right active span.
  34: 
  35:     Key insight:
  36:     The left panel is a compressed legend for the right panel: endpoint markers
  37:     stay two pixels wide, while connectors between endpoints expand to fill the
  38:     distance between them.
  39:     """
  40:     g = np.asarray(grid, dtype=int)
  41:     assert g.ndim == 2, "expected a 2D grid"
  42:     H, W = g.shape
  43:     assert H >= 3 and W >= 7, "grid too small for framed two-panel structure"
  44: 
  45:     frame = int(g[0, 0])
  46:     assert np.all(g[0, :] == frame) and np.all(g[-1, :] == frame), "bad horizontal frame"
  47:     assert np.all(g[:, 0] == frame) and np.all(g[:, -1] == frame), "bad vertical frame"
  48: 
  49:     divider = _single_divider_column(g, frame)
  50:     assert divider >= 5 and W - divider >= 6, "panels must contain margins and active slots"
  51: 
  52:     left_panel = g[1 : H - 1, 1:divider]
  53:     left_bg = get_bg(left_panel)
  54:     assert np.all(left_panel[:, 0] == left_bg), "left panel must have a left margin"
  55:     assert np.all(left_panel[:, -1] == left_bg), "left panel must have a right margin"
  56: 
  57:     mini_start = 2
  58:     mini_end = divider - 2
