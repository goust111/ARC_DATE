+
+    inp, expected = _crop_to_content(inp, expected, rng)
+    if inp.ndim != 2 or max(inp.shape) > 30 or max(expected.shape) > 30:
+        return None
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, expected):
+        return None
+    return inp
+
