+        r0, c0, r1, c1 = spec["bbox"]  # type: ignore[index]
+        for r, c in _rect_border(r0, c0, r1, c1):
+            inp[r, c] = color
+            expected[r, c] = color
+
+        groups: dict[int, dict[str, object]] = spec["groups"]  # type: ignore[assignment]
+        for marker_color, group in groups.items():
