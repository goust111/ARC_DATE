  82:         deltas = [d - s for s, d in zip(src_proj_cols, dst_cols)]
  83:         if len(set(deltas)) == 1:
  84:             dx = deltas[0]
  85:     if dx is None:
  86:         # Brute pick dx that maximizes overlap of shifted projection cols with dst cols.
  87:         best = (-1, 0)
  88:         dst_set = set(dst_cols)
  89:         for cand_dx in range(-w, w + 1):
  90:             score = sum((c + cand_dx) in dst_set for c in src_proj_cols)
  91:             if score > best[0]:
