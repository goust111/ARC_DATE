  73:         r = int(r)
  74:         c = int(c)
  75:         if sr0 <= r <= sr1 and sc0 <= c <= sc1:
  76:             dst_cols_set.add(c)
  77:     dst_cols = sorted(dst_cols_set)
  78: 
  79:     # Compute a robust horizontal shift aligning projection columns to colored columns.
  80:     dx = None
