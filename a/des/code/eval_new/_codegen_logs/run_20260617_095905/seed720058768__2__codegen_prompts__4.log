{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '160,240p;551,600p' /home/lixinyu/snap/new/ARC_code/train/9b5080bb.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor the small defect bars on each shared-color object with the opposite panel color.\n\n    Input structure\n    - The grid contains two large panel colors and one shared object color.\n    - Each shared-color object is a mostly solid rectangle inside exactly one panel.\n    Rule\n    - Find the near-solid rectangular core of each object.\n    - Missing core pixels and one-cell protrusions define two-pixel bars perpendicular to the nearest core edge.\n    - Recolor those bars with the other panel color; leave all other pixels unchanged.\n    Key insight\n    - The colors to add are not tied to numeric ids: each object's surrounding panel identifies the opposite panel color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = g.copy()\n\n    object_color, components, panel_colors = _object_components(g)\n    for coords in components:\n        neighbors = _neighbor_colors(g, coords, object_color)\n        assert len(neighbors) == 1\n        panel_color = next(iter(neighbors))\n        target_colors = panel_colors - {panel_color}\n        assert len(target_colors) == 1\n        target_color = next(iter(target_colors))\n\n        rect = _core_rect(coords)\n        for r, c in _defect_bar_cells(coords, rect):\n            assert 0 <= r < g.shape[0] and 0 <= c < g.shape[1]\n            assert int(g[r, c]) in {object_color, panel_color}\n            out[r, c] = target_color\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Palette and canvas bounds.\nCOLOR_IDS = list(range(10))\nGRID_SIZE_MIN = 20\nGRID_SIZE_MAX = 27\n\n# Panel layout bounds and options.\nMIN_PANEL_DIM = 9\nMIN_VISIBLE_BORDERS = 2\nBORDER_CHOICES = (0, 1)\nOFFSET_MIN = 2\nOFFSET_MAX = 6\nHORIZONTAL_LAYOUT = 0\nVERTICAL_LAYOUT = 1\nHORIZONTAL_OFFSETS = (\"left\", \"right\", \"none\")\nVERTICAL_OFFSETS = (\"top\", \"bottom\", \"none\")\n\n# Object geometry and placement constraints.\nOBJECTS_PER_PANEL = (1, 2)\nCORE_H_MIN = 3\nCORE_H_MAX = 7\nCORE_W_MIN = 3\nCORE_W_MAX = 9\nDEFECT_COUNT_MIN = 1\nDEFECT_COUNT_MAX = 3\nDEFECT_SIDES = (\"top\", \"bottom\", \"left\", \"right\")\nDEFECT_TYPES = (\"missing\", \"protrusion\")\nPANEL_MARGIN = 1\nOBJECT_GAP = 2\nMAX_PLACE_TRIES = 30\n\n# Generation retry budget.\nMAX_GENERATE_ATTEMPTS = 300\n\n\ndef _choose_palette() -> tuple[int, int, int, int]:\n    colors = COLOR_IDS[:]\n    random.shuffle(colors)\n    return tuple(colors[:4])\n\n\ndef _choose_borders() -> tuple[int, int, int, int]:\n    borders = [random.choice(BORDER_CHOICES) for _ in range(4)]\n    while sum(borders) < MIN_VISIBLE_BORDERS:\n        borders[random.randint(0, 3)] = 1\n    return tuple(borders)\n\n        return None\n    grid, panels = layout\n\n    n_obj_a = random.choice(OBJECTS_PER_PANEL)\n    n_obj_b = random.choice(OBJECTS_PER_PANEL)\n    if not 2 <= n_obj_a + n_obj_b <= 4:\n        return None\n\n    output_grid = grid.copy()\n    input_grid = grid.copy()\n    object_counts = (n_obj_a, n_obj_b)\n    other_colors = (panel_b_color, panel_a_color)\n\n    for panel, n_objs, other_panel_color in zip(panels, object_counts, other_colors):\n        if not _place_panel_objects(\n            input_grid,\n            output_grid,\n            panel,\n            n_objs,\n            obj_color,\n            other_panel_color,\n        ):\n            return None\n\n    # Verify: run solver on input and check it produces the output\n    try:\n        result = main(input_grid)\n        if np.array_equal(result, output_grid):\n            return input_grid\n    except (AssertionError, IndexError, ValueError):\n        pass\n\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATE_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATE_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '9,140p' /home/lixinyu/snap/new/ARC_code/train/878187ab.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replace the scattered foreground markers with a bottom-left count rectangle whose two corner diagonals encode the marker counts.\n\n    Input structure\n    - A background grid with exactly two foreground colors used as scattered marker pixels.\n    - The two foreground colors have distinct pixel counts.\n\n    Rule\n    - Ignore marker positions and use only the two foreground counts.\n    - Make a 16-by-16 background canvas, fill a bottom-left red rectangle whose height is the smaller count and width is the larger count.\n    - Paint yellow pixels along the two rising 45-degree diagonals from the rectangle's bottom-left and bottom-right corners.\n\n    Key insight\n    - The marker colors and positions vary between examples; their counts alone determine the output rectangle dimensions.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    marker_colors = colors_present(g, exclude={bg})\n    assert len(marker_colors) == 2, \"expected exactly two foreground marker colors\"\n\n    marker_counts = [int(np.count_nonzero(g == color)) for color in marker_colors]\n    assert marker_counts[0] != marker_counts[1], \"marker counts must determine distinct height and width\"\n    height, width = sorted(marker_counts)\n\n    assert max(map(int, g.shape)) <= 16, \"input must fit the task's 16-by-16 output canvas\"\n    side = 16\n    assert height <= width <= side, \"count rectangle must fit in the output canvas\"\n    assert bg not in (Color.RED, Color.YELLOW), \"output drawing colors must differ from the background\"\n\n    out = np.full((side, side), bg, dtype=int)\n    r0 = side - height\n    out[r0:, :width] = Color.RED\n\n    for rr in range(height):\n        d = height - 1 - rr\n        assert 0 <= d < width\n        assert 0 <= width - 1 - d < width\n        out[r0 + rr, d] = Color.YELLOW\n        out[r0 + rr, width - 1 - d] = Color.YELLOW\n\n    return out\n\n# --------------- generator (att2) ---------------\n# Output canvas and rectangle bounds.\nBACKGROUND_COLOR = Color.ORANGE\nOUTPUT_SIDE = 16\nRECTANGLE_COLOR = Color.RED\nDIAGONAL_COLOR = Color.YELLOW\nRECT_HEIGHT_RANGE = (3, 14)\nRECT_WIDTH_MIN = 5\n# Input canvas bounds.\nINPUT_SIDE_RANGE = (10, 16)\n# Marker scatter and color assignment.\nSCATTER_NEIGHBORHOOD = 1\nSMALL_COLOR_FIRST_P = 0.5\n# Generation retry budget.\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _expected_output(bg: int, h: int, w: int) -> np.ndarray:\n    out = np.full((OUTPUT_SIDE, OUTPUT_SIDE), bg, dtype=int)\n    r0 = OUTPUT_SIDE - h\n    out[r0:, :w] = RECTANGLE_COLOR\n    rows = r0 + np.arange(h)\n    offsets = h - 1 - np.arange(h)\n    out[rows, offsets] = DIAGONAL_COLOR\n    out[rows, w - 1 - offsets] = DIAGONAL_COLOR\n    return out\n\ndef _scattered_cells(H: int, W: int, count: int) -> list[int]:\n    \"\"\"Prefer non-touching cells, then fall back to any unused cells.\"\"\"\n    cells = [(r, c) for r in range(H) for c in range(W)]\n    random.shuffle(cells)\n    chosen: list[tuple[int, int]] = []\n    sep = SCATTER_NEIGHBORHOOD\n    for r, c in cells:\n        if all(abs(r - rr) > sep or abs(c - cc) > sep for rr, cc in chosen):\n            chosen.append((r, c))\n            if len(chosen) == count:\n                break\n\n    if len(chosen) < count:\n        used = {r * W + c for r, c in chosen}\n        remaining = [idx for idx in range(H * W) if idx not in used]\n        random.shuffle(remaining)\n        chosen.extend((idx // W, idx % W) for idx in remaining[: count - len(chosen)])\n\n    random.shuffle(chosen)\n    return [r * W + c for r, c in chosen]\n\ndef _gen_attempt() -> np.ndarray | None:\n    bg = BACKGROUND_COLOR\n    h = random.randint(*RECT_HEIGHT_RANGE)\n    w = random.randint(max(h + 1, RECT_WIDTH_MIN), OUTPUT_SIDE)