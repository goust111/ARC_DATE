rator lines and the source sprite tile unchanged.\n  54:     - Replace each marked target tile with an exact copy of the source tile.\n  55:     - Unmarked background-only tiles remain unchanged.\n  56: \n  57:     Key insight\n  58:     - The internal separator-colored pixels are placement markers; the single colored tile is the template to stamp into those marked cells.\n  59:     \"\"\"\n  60:     g = np.asarray(grid, dtype=int)\n  61:     assert g.ndim == 2 and g.size > 0, \"expected a nonempty 2D grid\"\n  62: \n  63:     separator, sep_rows, sep_cols = _separator_lines(g)\n  64:     row_spans = _spans(g.shape[0], sep_rows)\n  65:     col_spans = _spans(g.shape[1], sep_cols)\n  66: \n  67:     tile_heights = {r1 - r0 + 1 for r0, r1 in row_spans}\n  68:     tile_widths = {c1 - c0 + 1 for c0, c1 in col_spans}\n  69:     assert len(tile_heights) == 1 and len(tile_widths) == 1, \"expected equal-sized tile rows and columns\"\n  70:     tile_h = tile_heights.pop()\n  71:     tile_w = tile_widths.pop()\n  72: \n  73:     bg = _unique_mode(g[g != separator])\n  74:     assert bg != separator, \"background and separator colors must differ\"\n  75:     sprite_colors = [int(color) for color in np.unique(g) if int(color) not in {bg, separator}]\n  76:     assert len(sprite_colors) == 1, \"expected one sprite color\"\n  77:     sprite_color = sprite_colors[0]\n  78: \n  79:     source_tiles = []\n  80:     marked_origins = []\n  81:     for r0, r1 in row_spans:\n  82:         for c0, c1 in col_spans:\n  83:             tile = g[r0 : r1 + 1, c0 : c1 + 1]\n  84:             assert tile.shape == (tile_h, tile_w)\n  85:             has_sprite = np.any(tile == sprite_color)\n  86:             has_marker = np.any(tile == separator)\n  87:             if has_sprite:\n  88:                 assert not has_marker, \"source tile should contain only sprite and background\"\n  89:                 assert set(map(int, np.unique(tile))).issubset({bg, sprite_color})\n  90:                 source_tiles.append(tile.copy())\n  91:             elif has_marker:\n  92:                 assert set(map(int, np.unique(tile))).issubset({bg, separator})\n  93:                 marked_origins.append((r0, c0))\n  94:             else:\n  95:                 assert np.all(tile == bg), \"unmarked non-source tiles should be plain background\"\n  96: \n  97:     assert len(source_tiles) == 1, \"expected exactly one source sprite tile\"\n  98:     source_tile = source_tiles[0]\n  99: \n 100:     out = g.copy()\n 101:     for r0, c0 in marked_origins:\n 102:         out[r0 : r0 + tile_h, c0 : c0 + tile_w] = source_tile\n 103:     return out\n 104: \n 105: # --------------- generator (o5x) ---------------\n 106: \n 107: # Palette: separator, background, and sprite are distinct.\n 108: COLOR_POOL = range(10)\n 109: PALETTE_SIZE = 3\n 110: # Tile grid dimensions and odd square tile sizes.\n 111: TILE_ROWS_RANGE = (3, 4)\n 112: TILE_COLS_RANGE = (3, 4)\n 113: TILE_SIZE_CHOICES = [3, 5]\n 114: SEPARATOR_WIDTH = 1\n 115: # Sprite density and 4-connected component count by tile size.\n 116: SPRITE_PIXEL_RANGES = {3: (3, 4), 5: (8, 11)}\n 117: SPRITE_COMPONENT_CAPS = {3: 3, 5: 5}\n 118: NEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n 119: ORIENTATION_COUNT = 4\n 120: FLIP_PROBABILITY = 0.5\n 121: # Marker tiles and retry budget.\n 122: MARKER_COUNT_RANGE = (3, 5)\n--- def generate_input @ 247 ---\n 247: def generate_input() -> np.ndarray:\n 248:     for _ in range(MAX_GENERATION_ATTEMPTS):\n 249:         grid = _gen_attempt()\n 250:         if grid is not None:\n 251:             return grid\n 252:     raise RuntimeError(\"failed to generate a valid e734a0e8 input\")\nFILE /home/lixinyu/snap/new/ARC_code/train/99caaf76.py\n--- def main @ 55 ---\n  55: def main(grid: np.ndarray) -> np.ndarray:\n  56:     \"\"\"\n  57:     Move each marked cross object away from its marker to the grid edge while rotating the colored cross 180 degrees.\n  58: \n  59:     Input structure:\n