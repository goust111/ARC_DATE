{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"sed -n '8,380p' /home/lixinyu/snap/new/ARC_code/eval/a395ee82.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Stamp translated copies of a monochrome template guided by a singleton pixel layout.\n\n    Input structure:\n    - bg = background. A large monochrome shape (template, color T).\n    - Singleton pixels elsewhere: exactly one is color T (layout origin); the rest share color O (overlap color).\n    - Singletons sit on a uniform-spacing lattice.\n\n    Rule:\n    - Convert each singleton's offset from the origin into coarse lattice units.\n    - Place a template copy at each offset, scaled by template height/width.\n    - The origin's copy is painted O instead of T.\n    - Any pixel covered by two or more copies is also recolored to O.\n\n    Key insight: The single T-colored singleton identifies both the origin position and the \"self\" copy, which is uniquely recolored.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = g.shape\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n    assert not (not comps)\n\n    template = max(comps, key=lambda d: int(d[\"area\"]))\n    templ_coords = template[\"coords\"]\n    templ_col = int(g[int(templ_coords[0, 0]), int(templ_coords[0, 1])])\n    r0, c0, r1, c1 = map(int, template[\"bbox\"])\n    h = int(bbox_h((r0, c0, r1, c1)))\n    w = int(bbox_w((r0, c0, r1, c1)))\n\n    templ_rel = [(int(r) - int(r0), int(c) - int(c0)) for r, c in templ_coords]\n\n    # Singleton layout points (excluding the template component).\n    singletons: list[tuple[int, int, int]] = []\n    for comp in comps:\n        if comp is template:\n            continue\n        if int(comp[\"area\"]) != 1:\n            continue\n        rr, cc = map(int, comp[\"coords\"][0])\n        singletons.append((int(rr), int(cc), int(g[int(rr), int(cc)])))\n\n    origin = [(r, c) for (r, c, col) in singletons if int(col) == int(templ_col)]\n    assert not (len(origin) != 1)\n    orr, orc = origin[0]\n\n    other_cols = [int(col) for (_r, _c, col) in singletons if int(col) != int(templ_col)]\n    assert not (not other_cols)\n    overlap_col = int(Counter(other_cols).most_common(1)[0][0])\n\n    deltas = [(int(r - orr), int(c - orc), int(col)) for (r, c, col) in singletons]\n    gcd_vals = [abs(int(x)) for dr, dc, _ in deltas for x in (dr, dc) if int(x) != 0]\n    assert gcd_vals\n    gunit = int(math.gcd(*gcd_vals))\n    gunit = max(1, int(gunit))\n    deltas = [(int(dr // gunit), int(dc // gunit), int(col)) for dr, dc, col in deltas]\n\n    total = np.zeros((H, W), dtype=int)\n    center = np.zeros((H, W), dtype=int)  # coverage count from the origin singleton\n\n    for dr, dc, col in deltas:\n        off_r = int(dr * h)\n        off_c = int(dc * w)\n        is_origin = int(col) == int(templ_col)\n        for rr, cc in templ_rel:\n            R = int(r0 + off_r + rr)\n            C = int(c0 + off_c + cc)\n            if 0 <= R < H and 0 <= C < W:\n                total[R, C] += 1\n                if is_origin:\n                    center[R, C] += 1\n\n    out = np.full((H, W), int(bg), dtype=int)\n    out[total > 0] = int(templ_col)\n    out[(total == 1) & (center > 0)] = int(overlap_col)\n    out[total >= 2] = int(overlap_col)\n    return out\n\n# --------------- generator (a1) ---------------\n\n# ── Tunable configuration ──────────────────────────────────────────\nGRID_SIZE = 22\nTEMPLATE_H_CHOICES = [3, 4]       # template bbox height options\nTEMPLATE_W = 3                    # template bbox width (fixed)\nTEMPLATE_AREA_RANGE = (6, 10)     # absolute cell-count bounds\nTEMPLATE_FILL_RANGE = (0.65, 0.85)  # fill-ratio bounds within bbox\nSINGLETON_COUNT_RANGE = (5, 6)    # number of lattice singletons\nLATTICE_EXTENT_RANGE = (3, 4)     # rows/cols of lattice polyomino\nGUNIT = 2                         # singleton spacing in pixels\n\n# Retry budgets\nSPANNING_RETRIES = 40             # attempts per spanning polyomino\nTEMPLATE_RETRIES = 60             # attempts to build a valid template\nSINGLETON_RETRIES = 50            # attempts to place singleton cluster\nGENERATE_RETRIES = 300            # outer retry loop\n\n\ndef _random_polyomino(n: int, rows: int, cols: int) -> list[tuple[int, int]] | None:\n    \"\"\"Grow a random 4-connected polyomino of *n* cells in a rows x cols grid.\"\"\"\n    start = (random.randint(0, rows - 1), random.randint(0, cols - 1))\n    cells = {start}\n    frontier = []\n    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nr, nc = start[0] + dr, start[1] + dc\n        if 0 <= nr < rows and 0 <= nc < cols:\n            frontier.append((nr, nc))\n    while len(cells) < n and frontier:\n        cell = random.choice(frontier)\n        frontier.remove(cell)\n        if cell in cells:\n            continue\n        cells.add(cell)\n        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nr, nc = cell[0] + dr, cell[1] + dc\n            if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in cells:\n                frontier.append((nr, nc))\n    return list(cells) if len(cells) == n else None\n\n\ndef _spanning_polyomino(n: int, rows: int, cols: int) -> list[tuple[int, int]] | None:\n    \"\"\"Polyomino of *n* cells that spans exactly rows x cols (touches all 4 edges).\"\"\"\n    for _ in range(SPANNING_RETRIES):\n        cells = _random_polyomino(n, rows, cols)\n        if cells is None:\n            continue\n        rs = [r for r, c in cells]\n        cs = [c for r, c in cells]\n        if min(rs) == 0 and max(rs) == rows - 1 and min(cs) == 0 and max(cs) == cols - 1:\n            return cells\n    return None\n\n\ndef _gen_template(h: int, w: int) -> list[tuple[int, int]] | None:\n    \"\"\"4-connected template shape in h x w, spanning bbox, within area/fill bounds.\"\"\"\n    total = h * w\n    lo = max(TEMPLATE_AREA_RANGE[0], int(np.ceil(total * TEMPLATE_FILL_RANGE[0])))\n    hi = min(TEMPLATE_AREA_RANGE[1], int(np.floor(total * TEMPLATE_FILL_RANGE[1])))\n    if lo > hi:\n        return None\n    for _ in range(TEMPLATE_RETRIES):\n        area = random.randint(lo, hi)\n        cells = _spanning_polyomino(area, h, w)\n        if cells is not None:\n            return cells\n    return None\n\n\ndef _gen_lattice(n: int) -> tuple[list[tuple[int, int]], tuple[int, int]] | None:\n    \"\"\"Lattice polyomino of *n* cells with strictly interior origin.\"\"\"\n    ext_r = random.randint(*LATTICE_EXTENT_RANGE)\n    ext_c = random.randint(*LATTICE_EXTENT_RANGE)\n    cells = _spanning_polyomino(n, ext_r, ext_c)\n    if cells is None:\n        return None\n    interior = [(r, c) for r, c in cells if 0 < r < ext_r - 1 and 0 < c < ext_c - 1]\n    if not interior:\n        return None\n    return cells, random.choice(interior)\n\n\ndef _delta_bounds(deltas: list[tuple[int, int]]):\n    \"\"\"Return (min_dr, max_dr, min_dc, max_dc) for a list of (dr, dc) offsets.\"\"\"\n    min_dr = min(dr for dr, dc in deltas)\n    max_dr = max(dr for dr, dc in deltas)\n    min_dc = min(dc for dr, dc in deltas)\n    max_dc = max(dc for dr, dc in deltas)\n    return min_dr, max_dr, min_dc, max_dc\n\n\ndef _place_singletons(\n    deltas, min_dr, max_dr, min_dc, max_dc,\n    templ_cells, r0, c0, h, w, bg, T, O, occupied,\n) -> np.ndarray | None:\n    \"\"\"Try to find a valid singleton cluster position and build the input grid.\"\"\"\n    orr_lo, orr_hi = -min_dr * GUNIT, GRID_SIZE - 1 - max_dr * GUNIT\n    orc_lo, orc_hi = -min_dc * GUNIT, GRID_SIZE - 1 - max_dc * GUNIT\n    if orr_lo > orr_hi or orc_lo > orc_hi:\n        return None\n\n    # Template bbox edges\n    tr0, tr1 = r0, r0 + h - 1\n    tc0, tc1 = c0, c0 + w - 1\n\n    for _ in range(SINGLETON_RETRIES):\n        orr = random.randint(orr_lo, orr_hi)\n        orc = random.randint(orc_lo, orc_hi)\n\n        # Singleton cluster bbox -- must be disjoint from template with >=1 bg cell gap\n        sr0 = orr + min_dr * GUNIT\n        sr1 = orr + max_dr * GUNIT\n        sc0 = orc + min_dc * GUNIT\n        sc1 = orc + max_dc * GUNIT\n        if not (sr1 + 1 < tr0 or tr1 + 1 < sr0 or sc1 + 1 < tc0 or tc1 + 1 < sc0):\n            continue\n\n        # Singletons must not land on stamp pixels\n        if any((orr + dr * GUNIT, orc + dc * GUNIT) in occupied for dr, dc in deltas):\n            continue\n\n        # Build input grid\n        grid = np.full((GRID_SIZE, GRID_SIZE), bg, dtype=int)\n        for tr, tc in templ_cells:\n            grid[r0 + tr, c0 + tc] = T\n        for dr, dc in deltas:\n            grid[orr + dr * GUNIT, orc + dc * GUNIT] = T if (dr == 0 and dc == 0) else O\n\n        try:\n            main(grid)\n        except Exception:\n            return None\n        return grid\n\n    return None\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt: pick colors, build template + lattice, place stamps + singletons.\"\"\"\n    bg, T, O = random.sample(range(10), 3)\n\n    h = random.choice(TEMPLATE_H_CHOICES)\n    w = TEMPLATE_W\n    templ_cells = _gen_template(h, w)\n    if templ_cells is None:\n        return None\n\n    n_sing = random.randint(*SINGLETON_COUNT_RANGE)\n    lat = _gen_lattice(n_sing)\n    if lat is None:\n        return None\n    lattice_cells, origin = lat\n    deltas = [(r - origin[0], c - origin[1]) for r, c in lattice_cells]\n    min_dr, max_dr, min_dc, max_dc = _delta_bounds(deltas)\n\n    # Compute valid placement window for the template origin\n    r0_lo, r0_hi = -min_dr * h, GRID_SIZE - max_dr * h - h\n    c0_lo, c0_hi = -min_dc * w, GRID_SIZE - max_dc * w - w\n    if r0_lo > r0_hi or c0_lo > c0_hi:\n        return None\n\n    r0 = random.randint(r0_lo, r0_hi)\n    c0 = random.randint(c0_lo, c0_hi)\n\n    # Verify no pixel overlap between stamps\n    occupied = set()\n    for dr, dc in deltas:\n        for tr, tc in templ_cells:\n            pt = (r0 + dr * h + tr, c0 + dc * w + tc)\n            if pt in occupied:\n                return None\n            occupied.add(pt)\n\n    return _place_singletons(\n        deltas, min_dr, max_dr, min_dc, max_dc,\n        templ_cells, r0, c0, h, w, bg, T, O, occupied,\n    )\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATE_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate input after %d attempts\" % GENERATE_RETRIES)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '85,450p' /home/lixinyu/snap/new/ARC_code/train/963c33f8.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Drop the columns of the top marker downward, stopping blue-ended columns on grey obstacles and letting maroon-ended columns pass to the bottom.\n\n    Input structure\n    - The background is the dominant color.\n    - The most numerous non-background color forms stationary grey obstacle pixels.\n    - The other two colors form a single 3x3 top-edge marker whose top two rows\n      are maroon and whose bottom row contains maroon or blue control pixels.\n\n    Rule\n    - Erase the top marker.\n    - Treat each marker column as a vertical drop retaining its three colors.\n    - A column whose bottom control pixel is blue stops immediately above the\n      first grey pixel below that column, or bottom-aligns if none exists.\n    - Contiguous maroon-ended columns pass through obstacles and bottom-align;\n      if such a run has a clear down-right slide from a grey ledge, shift the\n      run one column right before bottom-aligning.\n    - When a maroon-ended drop lands through a grey bar on the bottom edge, clear\n      the rest of the marker-width gap in that bottom bar.\n\n    Key insight\n    - The bottom row of the top marker is a control strip: blue cells mean\n      \"stick to the first obstacle,\" while maroon cells mean \"fall through.\"\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H = g.shape[0]\n    bg = int(get_bg(g))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 3, \"expected obstacle color plus two marker colors\"\n    obstacle = _unique_largest_count_color(g, non_bg)\n    marker_colors = [color for color in non_bg if color != obstacle]\n    assert len(marker_colors) == 2, \"expected exactly two marker colors\"\n\n    r0, c0, r1, c1 = _marker_bbox(g, marker_colors)\n    marker = g[r0 : r1 + 1, c0 : c1 + 1]\n    marker_h, marker_w = marker.shape\n    assert (marker_h, marker_w) == (3, 3), \"expected a 3x3 marker\"\n    assert np.all(np.isin(marker, marker_colors)), \"marker bbox must contain only marker colors\"\n\n    pass_color = int(marker[0, 0])\n    assert np.all(marker[:2, :] == pass_color), \"top two marker rows must be the pass-through color\"\n    stop_colors = [color for color in marker_colors if color != pass_color]\n    assert len(stop_colors) == 1, \"expected one stop color\"\n    stop_color = stop_colors[0]\n\n    out = g.copy()\n    out[r0 : r1 + 1, c0 : c1 + 1] = bg\n    base = out.copy()\n\n    pass_columns: list[int] = []\n    for j in range(marker_w):\n        c = c0 + j\n        stack = marker[:, j]\n        bottom_control = int(stack[-1])\n\n        if bottom_control == stop_color:\n            obstacles_below = np.flatnonzero(base[r1 + 1 :, c] == obstacle)\n            if len(obstacles_below):\n                floor_r = int(r1 + 1 + obstacles_below[0])\n                top_r = floor_r - marker_h\n            else:\n                top_r = H - marker_h\n            assert top_r >= 0, \"stopped column must fit above its obstacle\"\n            out[top_r : top_r + marker_h, c] = stack\n        else:\n            assert bottom_control == pass_color, \"bottom control must be one of the marker colors\"\n            pass_columns.append(j)\n\n    for start_j, end_j in _runs(pass_columns):\n        source_cols = list(range(c0 + start_j, c0 + end_j + 1))\n        shift = 1 if _can_slide_right(base, obstacle, bg, source_cols, r1, marker_h) else 0\n        top_r = H - marker_h\n\n        for j in range(start_j, end_j + 1):\n            c = c0 + j + shift\n            _clear_bottom_edge_gap(base, out, obstacle, bg, c, marker_w)\n            out[top_r : top_r + marker_h, c] = marker[:, j]\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGEN_BG, GEN_OBSTACLE, GEN_PASS, GEN_STOP = 7, 5, 9, 1\nGRID_SIZE_RANGE = (14, 16)\nMARKER_SIZE = 3\nSTOP_COUNT_RANGE = (1, 3)\nOBSTACLE_COMPONENT_RANGE = (7, 9)\nOBSTACLE_PIXEL_RANGE = (20, 31)\nCOMPONENT_SIZE_RANGE = (1, 11)\nMIN_STOP_OBSTACLE_ROW = 6\nDROP_ZONE_HEIGHT = 3\nCOMPONENT_PLACEMENT_ATTEMPTS, GENERATION_ATTEMPTS = 100, 300\n\n\ndef _init_scene(H: int, W: int) -> tuple[np.ndarray, int, list[int], set[tuple[int, int]]]:\n    grid = np.full((H, W), GEN_BG, dtype=int)\n    c0 = random.randint(0, W - MARKER_SIZE)\n    num_stops = random.randint(*STOP_COUNT_RANGE)\n    positions = list(range(MARKER_SIZE))\n    random.shuffle(positions)\n    stop_positions = sorted(positions[:num_stops])\n    marker = np.full((MARKER_SIZE, MARKER_SIZE), GEN_PASS, dtype=int)\n    for j in stop_positions:\n        marker[MARKER_SIZE - 1, j] = GEN_STOP\n    grid[0:MARKER_SIZE, c0:c0 + MARKER_SIZE] = marker\n    obstacle_pixels: set[tuple[int, int]] = set()\n    for j in stop_positions:\n        col = c0 + j\n        first_obs_row = random.randint(MIN_STOP_OBSTACLE_ROW, H - 1)\n        grid[first_obs_row, col] = GEN_OBSTACLE\n        obstacle_pixels.add((first_obs_row, col))\n    return grid, c0, stop_positions, obstacle_pixels\n\n\ndef _forbidden_cells(H: int, c0: int, stop_positions: list[int], obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]]:\n    forbidden = {(r, c) for r in range(MARKER_SIZE) for c in range(c0, c0 + MARKER_SIZE)}\n    for j in stop_positions:\n        col = c0 + j\n        for r in range(MARKER_SIZE, H):\n            if (r, col) not in obstacle_pixels:\n                continue\n            for dr in range(1, DROP_ZONE_HEIGHT + 1):\n                if r - dr >= 0:\n                    forbidden.add((r - dr, col))\n            break\n    return forbidden\n\n\ndef _sample_component_sizes(total_pixels: int, component_count: int) -> list[int] | None:\n    component_sizes = []\n    left = total_pixels\n    min_size, max_size = COMPONENT_SIZE_RANGE\n    for i in range(component_count):\n        remaining = component_count - i - 1\n        if remaining == 0:\n            size = left\n        else:\n            lo = max(min_size, left - max_size * remaining)\n            hi = min(max_size, left - min_size * remaining)\n            if lo > hi:\n                return None\n            size = random.randint(lo, hi)\n        left -= size\n        if size < min_size or size > max_size:\n            return None\n        component_sizes.append(size)\n    random.shuffle(component_sizes)\n    return component_sizes\n\n\ndef _grow_component(grid: np.ndarray, comp_size: int, forbidden: set[tuple[int, int]],\n                    obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]] | None:\n    H, W = grid.shape\n    sr, sc = random.randint(0, H - 1), random.randint(0, W - 1)\n    if (sr, sc) in forbidden or (sr, sc) in obstacle_pixels or grid[sr, sc] != GEN_BG:\n        return None\n\n    comp = {(sr, sc)}\n    frontier = [(sr, sc)]\n    while len(comp) < comp_size and frontier:\n        random.shuffle(frontier)\n        expanded = False\n        for fr, fc in frontier:\n            nbrs = [(fr - 1, fc), (fr + 1, fc), (fr, fc - 1), (fr, fc + 1)]\n            random.shuffle(nbrs)\n            for nr, nc in nbrs:\n                if (0 <= nr < H and 0 <= nc < W\n                        and (nr, nc) not in forbidden\n                        and (nr, nc) not in obstacle_pixels\n                        and (nr, nc) not in comp\n                        and grid[nr, nc] == GEN_BG):\n                    comp.add((nr, nc))\n                    frontier.append((nr, nc))\n                    expanded = True\n                    break\n            if expanded:\n                break\n        if not expanded:\n            break\n    return comp if len(comp) == comp_size else None\n\n\ndef _place_obstacle_components(grid: np.ndarray, component_sizes: list[int], forbidden: set[tuple[int, int]],\n                               obstacle_pixels: set[tuple[int, int]]) -> bool:\n    for comp_size in component_sizes:\n        placed = False\n        for _ in range(COMPONENT_PLACEMENT_ATTEMPTS):\n            comp = _grow_component(grid, comp_size, forbidden, obstacle_pixels)\n            if comp is None:\n                continue\n            if any((pr + dr, pc + dc) in obstacle_pixels\n                   for pr, pc in comp for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]):\n                continue\n            for pr, pc in comp:\n                grid[pr, pc] = GEN_OBSTACLE\n                obstacle_pixels.add((pr, pc))\n            placed = True\n            break\n        if not placed:\n            return False\n    return True\n\n\ndef _scatter_obstacles(grid: np.ndarray, c0: int, stop_positions: list[int],\n                       obstacle_pixels: set[tuple[int, int]]) -> bool:\n    H, _W = grid.shape\n    num_target_components = random.randint(*OBSTACLE_COMPONENT_RANGE)\n    total_target_pixels = random.randint(*OBSTACLE_PIXEL_RANGE)\n    remaining_pixels = max(0, total_target_pixels - len(obstacle_pixels))\n    remaining_components = max(1, num_target_components - len(stop_positions))\n    if remaining_pixels <= 0 or remaining_components <= 0:\n        return True\n\n    component_sizes = _sample_component_sizes(remaining_pixels, remaining_components)\n    if component_sizes is None:\n        return False\n    forbidden = _forbidden_cells(H, c0, stop_positions, obstacle_pixels)\n    return _place_obstacle_components(grid, component_sizes, forbidden, obstacle_pixels)\n\n\ndef _has_clear_stop_drop_zones(grid: np.ndarray, c0: int, stop_positions: list[int]) -> bool:\n    H, _W = grid.shape\n    for j in stop_positions:\n        col = c0 + j\n        first_obs = next((r for r in range(MARKER_SIZE, H) if grid[r, col] == GEN_OBSTACLE), None)\n        if first_obs is None:\n            return False\n        for dr in range(1, DROP_ZONE_HEIGHT + 1):\n            if first_obs - dr < 0 or grid[first_obs - dr, col] != GEN_BG:\n                return False\n    return True\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = random.randint(*GRID_SIZE_RANGE)\n    W = random.randint(*GRID_SIZE_RANGE)\n    grid, c0, stop_positions, obstacle_pixels = _init_scene(H, W)\n\n    if not _scatter_obstacles(grid, c0, stop_positions, obstacle_pixels):\n        return None\n    if not _has_clear_stop_drop_zones(grid, c0, stop_positions):\n        return None\n    obs_comps = [c for c in find_components(grid, bg=GEN_BG, connectivity=4, monochromatic=True)\n                 if c['color'] == GEN_OBSTACLE]\n    if not (OBSTACLE_COMPONENT_RANGE[0] <= len(obs_comps) <= OBSTACLE_COMPONENT_RANGE[1]):\n        return None\n\n    # Run solver to verify no assertion failures\n    try:\n        main(grid)\n    except Exception:\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
