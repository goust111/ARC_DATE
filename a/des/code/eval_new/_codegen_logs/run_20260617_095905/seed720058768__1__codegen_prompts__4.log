{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '160,640p' /home/lixinyu/snap/new/ARC_code/train/9b5080bb.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor the small defect bars on each shared-color object with the opposite panel color.\n\n    Input structure\n    - The grid contains two large panel colors and one shared object color.\n    - Each shared-color object is a mostly solid rectangle inside exactly one panel.\n    Rule\n    - Find the near-solid rectangular core of each object.\n    - Missing core pixels and one-cell protrusions define two-pixel bars perpendicular to the nearest core edge.\n    - Recolor those bars with the other panel color; leave all other pixels unchanged.\n    Key insight\n    - The colors to add are not tied to numeric ids: each object's surrounding panel identifies the opposite panel color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    out = g.copy()\n\n    object_color, components, panel_colors = _object_components(g)\n    for coords in components:\n        neighbors = _neighbor_colors(g, coords, object_color)\n        assert len(neighbors) == 1\n        panel_color = next(iter(neighbors))\n        target_colors = panel_colors - {panel_color}\n        assert len(target_colors) == 1\n        target_color = next(iter(target_colors))\n\n        rect = _core_rect(coords)\n        for r, c in _defect_bar_cells(coords, rect):\n            assert 0 <= r < g.shape[0] and 0 <= c < g.shape[1]\n            assert int(g[r, c]) in {object_color, panel_color}\n            out[r, c] = target_color\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Palette and canvas bounds.\nCOLOR_IDS = list(range(10))\nGRID_SIZE_MIN = 20\nGRID_SIZE_MAX = 27\n\n# Panel layout bounds and options.\nMIN_PANEL_DIM = 9\nMIN_VISIBLE_BORDERS = 2\nBORDER_CHOICES = (0, 1)\nOFFSET_MIN = 2\nOFFSET_MAX = 6\nHORIZONTAL_LAYOUT = 0\nVERTICAL_LAYOUT = 1\nHORIZONTAL_OFFSETS = (\"left\", \"right\", \"none\")\nVERTICAL_OFFSETS = (\"top\", \"bottom\", \"none\")\n\n# Object geometry and placement constraints.\nOBJECTS_PER_PANEL = (1, 2)\nCORE_H_MIN = 3\nCORE_H_MAX = 7\nCORE_W_MIN = 3\nCORE_W_MAX = 9\nDEFECT_COUNT_MIN = 1\nDEFECT_COUNT_MAX = 3\nDEFECT_SIDES = (\"top\", \"bottom\", \"left\", \"right\")\nDEFECT_TYPES = (\"missing\", \"protrusion\")\nPANEL_MARGIN = 1\nOBJECT_GAP = 2\nMAX_PLACE_TRIES = 30\n\n# Generation retry budget.\nMAX_GENERATE_ATTEMPTS = 300\n\n\ndef _choose_palette() -> tuple[int, int, int, int]:\n    colors = COLOR_IDS[:]\n    random.shuffle(colors)\n    return tuple(colors[:4])\n\n\ndef _choose_borders() -> tuple[int, int, int, int]:\n    borders = [random.choice(BORDER_CHOICES) for _ in range(4)]\n    while sum(borders) < MIN_VISIBLE_BORDERS:\n        borders[random.randint(0, 3)] = 1\n    return tuple(borders)\n\n\ndef _build_horizontal_panels(\n    grid: np.ndarray,\n    panel_a_color: int,\n    panel_b_color: int,\n) -> list[tuple[int, int, int, int, int]] | None:\n    \"\"\"Create two panels sharing a horizontal border; returns panel records.\"\"\"\n    H, W = grid.shape\n    split_r = random.randint(MIN_PANEL_DIM, H - MIN_PANEL_DIM - 1)\n    border_top, border_bot, border_left, border_right = _choose_borders()\n\n    pa_height = split_r - border_top\n    pb_height = H - border_bot - split_r\n    if pa_height < MIN_PANEL_DIM or pb_height < MIN_PANEL_DIM:\n        return None\n\n    offset_side = random.choice(HORIZONTAL_OFFSETS)\n    if offset_side == \"none\":\n        pa_c0, pa_c1 = border_left, W - 1 - border_right\n        pb_c0, pb_c1 = border_left, W - 1 - border_right\n    elif offset_side == \"left\":\n        offset_cols = random.randint(OFFSET_MIN, min(OFFSET_MAX, W - 2 * MIN_PANEL_DIM))\n        if random.random() < 0.5:\n            pa_c0 = border_left\n            pa_c1 = W - 1 - border_right\n            pb_c0 = border_left + offset_cols\n            pb_c1 = W - 1 - border_right\n        else:\n            pa_c0 = border_left + offset_cols\n            pa_c1 = W - 1 - border_right\n            pb_c0 = border_left\n            pb_c1 = W - 1 - border_right\n    else:\n        offset_cols = random.randint(OFFSET_MIN, min(OFFSET_MAX, W - 2 * MIN_PANEL_DIM))\n        if random.random() < 0.5:\n            pa_c0 = border_left\n            pa_c1 = W - 1 - border_right - offset_cols\n            pb_c0 = border_left\n            pb_c1 = W - 1 - border_right\n        else:\n            pa_c0 = border_left\n            pa_c1 = W - 1 - border_right\n            pb_c0 = border_left\n            pb_c1 = W - 1 - border_right - offset_cols\n\n    if pa_c1 - pa_c0 + 1 < MIN_PANEL_DIM or pb_c1 - pb_c0 + 1 < MIN_PANEL_DIM:\n        return None\n    if min(pa_c1, pb_c1) < max(pa_c0, pb_c0):\n        return None\n\n    pa_r0, pa_r1 = border_top, split_r - 1\n    pb_r0, pb_r1 = split_r, H - 1 - border_bot\n    grid[pa_r0:pa_r1 + 1, pa_c0:pa_c1 + 1] = panel_a_color\n    grid[pb_r0:pb_r1 + 1, pb_c0:pb_c1 + 1] = panel_b_color\n    return [\n        (panel_a_color, pa_r0, pa_r1, pa_c0, pa_c1),\n        (panel_b_color, pb_r0, pb_r1, pb_c0, pb_c1),\n    ]\n\n\ndef _build_vertical_panels(\n    grid: np.ndarray,\n    panel_a_color: int,\n    panel_b_color: int,\n) -> list[tuple[int, int, int, int, int]] | None:\n    \"\"\"Create two panels sharing a vertical border; returns panel records.\"\"\"\n    H, W = grid.shape\n    split_c = random.randint(MIN_PANEL_DIM, W - MIN_PANEL_DIM - 1)\n    border_top, border_bot, border_left, border_right = _choose_borders()\n\n    pa_width = split_c - border_left\n    pb_width = W - border_right - split_c\n    if pa_width < MIN_PANEL_DIM or pb_width < MIN_PANEL_DIM:\n        return None\n\n    offset_side = random.choice(VERTICAL_OFFSETS)\n    if offset_side == \"none\":\n        pa_r0, pa_r1 = border_top, H - 1 - border_bot\n        pb_r0, pb_r1 = border_top, H - 1 - border_bot\n    elif offset_side == \"top\":\n        offset_rows = random.randint(OFFSET_MIN, min(OFFSET_MAX, H - 2 * MIN_PANEL_DIM))\n        if random.random() < 0.5:\n            pa_r0, pa_r1 = border_top, H - 1 - border_bot\n            pb_r0, pb_r1 = border_top + offset_rows, H - 1 - border_bot\n        else:\n            pa_r0, pa_r1 = border_top + offset_rows, H - 1 - border_bot\n            pb_r0, pb_r1 = border_top, H - 1 - border_bot\n    else:\n        offset_rows = random.randint(OFFSET_MIN, min(OFFSET_MAX, H - 2 * MIN_PANEL_DIM))\n        if random.random() < 0.5:\n            pa_r0, pa_r1 = border_top, H - 1 - border_bot - offset_rows\n            pb_r0, pb_r1 = border_top, H - 1 - border_bot\n        else:\n            pa_r0, pa_r1 = border_top, H - 1 - border_bot\n            pb_r0, pb_r1 = border_top, H - 1 - border_bot - offset_rows\n\n    pa_c0, pa_c1 = border_left, split_c - 1\n    pb_c0, pb_c1 = split_c, W - 1 - border_right\n    if pa_r1 - pa_r0 + 1 < MIN_PANEL_DIM or pb_r1 - pb_r0 + 1 < MIN_PANEL_DIM:\n        return None\n    if min(pa_r1, pb_r1) < max(pa_r0, pb_r0):\n        return None\n\n    grid[pa_r0:pa_r1 + 1, pa_c0:pa_c1 + 1] = panel_a_color\n    grid[pb_r0:pb_r1 + 1, pb_c0:pb_c1 + 1] = panel_b_color\n    return [\n        (panel_a_color, pa_r0, pa_r1, pa_c0, pa_c1),\n        (panel_b_color, pb_r0, pb_r1, pb_c0, pb_c1),\n    ]\n\n\ndef _make_panel_grid(\n    panel_a_color: int,\n    panel_b_color: int,\n    bg_color: int,\n) -> tuple[np.ndarray, list[tuple[int, int, int, int, int]]] | None:\n    \"\"\"Sample the canvas and panel layout.\"\"\"\n    H = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    W = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    grid = np.full((H, W), bg_color, dtype=int)\n\n    orientation = random.randint(HORIZONTAL_LAYOUT, VERTICAL_LAYOUT)\n    if orientation == HORIZONTAL_LAYOUT:\n        panels = _build_horizontal_panels(grid, panel_a_color, panel_b_color)\n    else:\n        panels = _build_vertical_panels(grid, panel_a_color, panel_b_color)\n    if panels is None:\n        return None\n    return grid, panels\n\n\ndef _object_overlaps(full_bbox: tuple[int, int, int, int], placed_bboxes: list[tuple[int, int, int, int]]) -> bool:\n    full_r0, full_r1, full_c0, full_c1 = full_bbox\n    for br0, br1, bc0, bc1 in placed_bboxes:\n        if (\n            full_r0 - OBJECT_GAP <= br1\n            and full_r1 + OBJECT_GAP >= br0\n            and full_c0 - OBJECT_GAP <= bc1\n            and full_c1 + OBJECT_GAP >= bc0\n        ):\n            return True\n    return False\n\n\ndef _place_core(\n    panel_bbox: tuple[int, int, int, int],\n    core_h: int,\n    core_w: int,\n    sides: list[str],\n    placed_bboxes: list[tuple[int, int, int, int]],\n) -> tuple[tuple[int, int, int, int], tuple[int, int, int, int]] | None:\n    \"\"\"Find a non-overlapping core bbox and its full bbox including bars.\"\"\"\n    pr0, pr1, pc0, pc1 = panel_bbox\n    extra_top = 1 if \"top\" in sides else 0\n    extra_bot = 1 if \"bottom\" in sides else 0\n    extra_left = 1 if \"left\" in sides else 0\n    extra_right = 1 if \"right\" in sides else 0\n\n    place_r0 = pr0 + PANEL_MARGIN + extra_top\n    place_r1 = pr1 - PANEL_MARGIN - extra_bot - core_h + 1\n    place_c0 = pc0 + PANEL_MARGIN + extra_left\n    place_c1 = pc1 - PANEL_MARGIN - extra_right - core_w + 1\n    if place_r1 < place_r0 or place_c1 < place_c0:\n        return None\n\n    for _ in range(MAX_PLACE_TRIES):\n        cr0 = random.randint(place_r0, place_r1)\n        cc0 = random.randint(place_c0, place_c1)\n        cr1 = cr0 + core_h - 1\n        cc1 = cc0 + core_w - 1\n        full_bbox = (cr0 - extra_top, cr1 + extra_bot, cc0 - extra_left, cc1 + extra_right)\n        if not _object_overlaps(full_bbox, placed_bboxes):\n            return (cr0, cr1, cc0, cc1), full_bbox\n    return None\n\n\ndef _apply_defect(\n    input_grid: np.ndarray,\n    output_grid: np.ndarray,\n    core_bbox: tuple[int, int, int, int],\n    side: str,\n    defect_type: str,\n    panel_color: int,\n    obj_color: int,\n    other_panel_color: int,\n) -> bool:\n    \"\"\"Apply one sampled input defect and its two-cell output bar.\"\"\"\n    cr0, cr1, cc0, cc1 = core_bbox\n    if side == \"top\":\n        if defect_type == \"missing\":\n            valid_cols = list(range(cc0 + 1, cc1))\n            if not valid_cols:\n                return False\n            dc = random.choice(valid_cols)\n            dr = cr0\n            input_grid[dr, dc] = panel_color\n            output_grid[dr - 1, dc] = other_panel_color\n            output_grid[dr, dc] = other_panel_color\n        else:\n            dc = random.randint(cc0, cc1)\n            dr = cr0 - 1\n            input_grid[dr, dc] = obj_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr + 1, dc] = other_panel_color\n    elif side == \"bottom\":\n        if defect_type == \"missing\":\n            valid_cols = list(range(cc0 + 1, cc1))\n            if not valid_cols:\n                return False\n            dc = random.choice(valid_cols)\n            dr = cr1\n            input_grid[dr, dc] = panel_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr + 1, dc] = other_panel_color\n        else:\n            dc = random.randint(cc0, cc1)\n            dr = cr1 + 1\n            input_grid[dr, dc] = obj_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr - 1, dc] = other_panel_color\n    elif side == \"left\":\n        if defect_type == \"missing\":\n            valid_rows = list(range(cr0 + 1, cr1))\n            if not valid_rows:\n                return False\n            dr = random.choice(valid_rows)\n            dc = cc0\n            input_grid[dr, dc] = panel_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr, dc - 1] = other_panel_color\n        else:\n            dr = random.randint(cr0, cr1)\n            dc = cc0 - 1\n            input_grid[dr, dc] = obj_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr, dc + 1] = other_panel_color\n    else:\n        if defect_type == \"missing\":\n            valid_rows = list(range(cr0 + 1, cr1))\n            if not valid_rows:\n                return False\n            dr = random.choice(valid_rows)\n            dc = cc1\n            input_grid[dr, dc] = panel_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr, dc + 1] = other_panel_color\n        else:\n            dr = random.randint(cr0, cr1)\n            dc = cc1 + 1\n            input_grid[dr, dc] = obj_color\n            output_grid[dr, dc] = other_panel_color\n            output_grid[dr, dc - 1] = other_panel_color\n    return True\n\n\ndef _place_panel_objects(\n    input_grid: np.ndarray,\n    output_grid: np.ndarray,\n    panel: tuple[int, int, int, int, int],\n    n_objs: int,\n    obj_color: int,\n    other_panel_color: int,\n) -> bool:\n    \"\"\"Place all objects for one panel into input and output grids.\"\"\"\n    panel_color, pr0, pr1, pc0, pc1 = panel\n    avail_r0 = pr0 + PANEL_MARGIN\n    avail_r1 = pr1 - PANEL_MARGIN\n    avail_c0 = pc0 + PANEL_MARGIN\n    avail_c1 = pc1 - PANEL_MARGIN\n    placed_bboxes = []\n\n    for _ in range(n_objs):\n        core_h = random.randint(CORE_H_MIN, min(CORE_H_MAX, avail_r1 - avail_r0 - 2))\n        core_w = random.randint(CORE_W_MIN, min(CORE_W_MAX, avail_c1 - avail_c0 - 2))\n        if core_h < CORE_H_MIN or core_w < CORE_W_MIN:\n            return False\n\n        n_defects = random.randint(DEFECT_COUNT_MIN, DEFECT_COUNT_MAX)\n        sides = random.sample(DEFECT_SIDES, n_defects)\n        defect_types = [random.choice(DEFECT_TYPES) for _ in range(n_defects)]\n\n        placed = _place_core((pr0, pr1, pc0, pc1), core_h, core_w, sides, placed_bboxes)\n        if placed is None:\n            return False\n        core_bbox, full_bbox = placed\n        placed_bboxes.append(full_bbox)\n\n        cr0, cr1, cc0, cc1 = core_bbox\n        output_grid[cr0:cr1 + 1, cc0:cc1 + 1] = obj_color\n        input_grid[cr0:cr1 + 1, cc0:cc1 + 1] = obj_color\n\n        for side, defect_type in zip(sides, defect_types):\n            if not _apply_defect(\n                input_grid,\n                output_grid,\n                core_bbox,\n                side,\n                defect_type,\n                panel_color,\n                obj_color,\n                other_panel_color,\n            ):\n                return False\n    return True\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    obj_color, panel_a_color, panel_b_color, bg_color = _choose_palette()\n    layout = _make_panel_grid(panel_a_color, panel_b_color, bg_color)\n    if layout is None:\n        return None\n    grid, panels = layout\n\n    n_obj_a = random.choice(OBJECTS_PER_PANEL)\n    n_obj_b = random.choice(OBJECTS_PER_PANEL)\n    if not 2 <= n_obj_a + n_obj_b <= 4:\n        return None\n\n    output_grid = grid.copy()\n    input_grid = grid.copy()\n    object_counts = (n_obj_a, n_obj_b)\n    other_colors = (panel_b_color, panel_a_color)\n\n    for panel, n_objs, other_panel_color in zip(panels, object_counts, other_colors):\n        if not _place_panel_objects(\n            input_grid,\n            output_grid,\n            panel,\n            n_objs,\n            obj_color,\n            other_panel_color,\n        ):\n            return None\n\n    # Verify: run solver on input and check it produces the output\n    try:\n        result = main(input_grid)\n        if np.array_equal(result, output_grid):\n            return input_grid\n    except (AssertionError, IndexError, ValueError):\n        pass\n\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATE_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {MAX_GENERATE_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '119,520p' /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '119,520p' /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert each colored partitioned frame into a horizontal bar whose length is its number of enclosed regions.\n\n    Input structure:\n    - Black background with several axis-aligned colored line drawings.\n    - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.\n    - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.\n\n    Rule:\n    - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.\n    - Count the 4-connected background regions fully enclosed by those reconstructed walls.\n    - The color with no enclosed region is the noise/pad color.\n    - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.\n\n    Key insight:\n    - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg == 0\n\n    counts: list[tuple[int, int, np.ndarray]] = []\n    for color in colors_present(g, exclude={bg}):\n        rooms = _room_count_for_color(g, int(color))\n        walls = _walls_for_color(g, int(color))\n        counts.append((int(color), int(rooms), walls))\n\n    drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]\n    pad_colors = [color for color, rooms, _walls in counts if rooms == 0]\n    assert drawings\n    assert len(pad_colors) == 1\n\n    pad = int(pad_colors[0])\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    for rooms in sorted({rooms for _color, rooms, _walls in drawings}):\n        group = [item for item in drawings if item[1] == rooms]\n        ordered.extend(_cover_order(g, group))\n\n    width = max(rooms for _color, rooms, _walls in ordered)\n\n    out = np.full((len(ordered), width), pad, dtype=int)\n    for r, (color, rooms, _walls) in enumerate(ordered):\n        out[r, :rooms] = int(color)\n    return out\n\n# --------------- generator (claude-opus-4-6) ---------------\n\n# ---- CFG: Tunable generation parameters ----\n_FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle\n_ROOM_COUNT_RANGE = (1, 6)            # rooms per frame\n_TIE_PROBABILITY = 0.35              # chance of one tied room-count pair\n_GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)\n    5: (25, 30, 25, 30, 16, 18),\n    4: (22, 30, 22, 30, 18, 22),\n    3: (20, 30, 20, 30, 22, 25),\n}\n_CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame\n_NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise\n_WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise\n_EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force\n_OVERLAP_RETRY = 100                 # attempts to place overlapping frame\n_GEN_RETRIES = 300                   # outer retry limit\n\n\ndef _random_gaps(n: int, min_gap: int, max_gap: int, max_total: int) -> list[int] | None:\n    \"\"\"Generate n gaps each in [min_gap, max_gap] with sum <= max_total.\"\"\"\n    if n * min_gap > max_total:\n        return None\n    gaps = [min_gap] * n\n    remaining = max_total - sum(gaps)\n    for i in range(n):\n        extra = min(max_gap - gaps[i], remaining)\n        if extra > 0:\n            add = random.randint(0, extra)\n            gaps[i] += add\n            remaining -= add\n    random.shuffle(gaps)\n    return gaps\n\n\ndef _build_frame(target_rooms: int, max_h: int = 22, max_w: int = 25) -> np.ndarray | None:\n    \"\"\"Build a boolean wall array with exactly target_rooms enclosed regions.\"\"\"\n    if target_rooms == 1:\n        gap_h = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_h - 2))\n        gap_w = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_w - 2))\n        h, w = gap_h + 2, gap_w + 2\n        walls = np.zeros((h, w), dtype=bool)\n        walls[0, :] = True\n        walls[h - 1, :] = True\n        walls[:, 0] = True\n        walls[:, w - 1] = True\n        return walls\n\n    # For target_rooms >= 2: grid of cells, then selectively merge\n    possible_configs = []\n    for nv in range(2, 6):\n        for nh in range(2, 5):\n            cells = (nv - 1) * (nh - 1)\n            if target_rooms <= cells <= target_rooms + 4:\n                possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        for nv in range(2, 7):\n            for nh in range(2, 6):\n                cells = (nv - 1) * (nh - 1)\n                if cells >= target_rooms:\n                    possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        return None\n\n    n_vcols, n_hrows, total_cells = random.choice(possible_configs)\n    n_row_gaps = n_hrows - 1\n    n_col_gaps = n_vcols - 1\n    min_gap, max_gap = _CELL_GAP_RANGE\n\n    if min_gap * n_row_gaps > max_h - 1 or min_gap * n_col_gaps > max_w - 1:\n        return None\n\n    row_gaps = _random_gaps(n_row_gaps, min_gap, max_gap, max_h - 1)\n    col_gaps = _random_gaps(n_col_gaps, min_gap, max_gap, max_w - 1)\n    if row_gaps is None or col_gaps is None:\n        return None\n\n    # Compute line positions from cumulative gaps\n    vcol_positions = [0]\n    for gap in col_gaps:\n        vcol_positions.append(vcol_positions[-1] + gap)\n    hrow_positions = [0]\n    for gap in row_gaps:\n        hrow_positions.append(hrow_positions[-1] + gap)\n\n    frame_h = hrow_positions[-1] + 1\n    frame_w = vcol_positions[-1] + 1\n    walls = np.zeros((frame_h, frame_w), dtype=bool)\n    for r in hrow_positions:\n        walls[r, :] = True\n    for c in vcol_positions:\n        walls[:, c] = True\n\n    cells_to_merge = total_cells - target_rooms\n    if cells_to_merge == 0:\n        return walls\n\n    # Union-find to merge adjacent cells by removing internal wall segments\n    parent = list(range(total_cells))\n\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(x, y):\n        px, py = find(x), find(y)\n        if px == py:\n            return False\n        parent[px] = py\n        return True\n\n    def cell_id(cr, cc):\n        return cr * (n_vcols - 1) + cc\n\n    # Enumerate internal wall segments (between adjacent cells)\n    internal_segments = []\n    for hi in range(1, n_hrows - 1):\n        r = hrow_positions[hi]\n        for ci in range(n_vcols - 1):\n            c0, c1 = vcol_positions[ci], vcol_positions[ci + 1]\n            internal_segments.append(('h', r, c0, c1, cell_id(hi - 1, ci), cell_id(hi, ci)))\n    for ci in range(1, n_vcols - 1):\n        c = vcol_positions[ci]\n        for hi in range(n_hrows - 1):\n            r0, r1 = hrow_positions[hi], hrow_positions[hi + 1]\n            internal_segments.append(('v', c, r0, r1, cell_id(hi, ci - 1), cell_id(hi, ci)))\n\n    random.shuffle(internal_segments)\n    merged = 0\n    for seg in internal_segments:\n        if merged >= cells_to_merge:\n            break\n        if seg[0] == 'h':\n            _, r, c0, c1, ca, cb = seg\n            if find(ca) != find(cb):\n                union(ca, cb)\n                walls[r, c0 + 1:c1] = False\n                merged += 1\n        else:\n            _, c, r0, r1, ca, cb = seg\n            if find(ca) != find(cb):\n                union(ca, cb)\n                walls[r0 + 1:r1, c] = False\n                merged += 1\n\n    if merged < cells_to_merge:\n        return None\n    if _count_enclosed_regions(walls) != target_rooms:\n        return None\n    return walls\n\n\ndef _force_overlap(positions, i, j, frames, grid_h, grid_w):\n    \"\"\"Try to reposition frame j so it overlaps frame i. Modifies positions in place.\"\"\"\n    fi_h, fi_w = frames[i][2].shape\n    fj_h, fj_w = frames[j][2].shape\n    ri, ci = positions[i]\n    r0_min = max(0, ri - fj_h + 2)\n    r0_max = min(grid_h - fj_h, ri + fi_h - 2)\n    c0_min = max(0, ci - fj_w + 2)\n    c0_max = min(grid_w - fj_w, ci + fi_w - 2)\n    if r0_min > r0_max or c0_min > c0_max:\n        return\n    for _ in range(_OVERLAP_RETRY):\n        rj = random.randint(r0_min, r0_max)\n        cj = random.randint(c0_min, c0_max)\n        # Verify bbox overlap\n        if (max(ri, rj) <= min(ri + fi_h - 1, rj + fj_h - 1) and\n                max(ci, cj) <= min(ci + fi_w - 1, cj + fj_w - 1)):\n            positions[j] = (rj, cj)\n            return\n\n\ndef _render_frames(frames, positions, render_order, grid_h, grid_w):\n    \"\"\"Render frame walls onto grid; return grid and set of visible frame pixel coords.\"\"\"\n    grid = np.zeros((grid_h, grid_w), dtype=int)\n    # Paint walls in render order (later overwrites earlier at overlaps)\n    for idx in render_order:\n        r0, c0 = positions[idx]\n        wall_arr = frames[idx][2]\n        color = frames[idx][0]\n        # Vectorized: find wall pixel offsets and stamp color\n        rs, cs = np.where(wall_arr)\n        grid[rs + r0, cs + c0] = color\n\n    # Compute visible frame pixels (where grid still shows that frame's color)\n    frame_mask = np.zeros((grid_h, grid_w), dtype=bool)\n    for idx in render_order:\n        r0, c0 = positions[idx]\n        wall_arr = frames[idx][2]\n        color = frames[idx][0]\n        rs, cs = np.where(wall_arr)\n        abs_rs, abs_cs = rs + r0, cs + c0\n        visible = grid[abs_rs, abs_cs] == color\n        frame_mask[abs_rs[visible], abs_cs[visible]] = True\n\n    return grid, frame_mask\n\n\ndef _scatter_noise(grid, frame_mask, noise_color, grid_h, grid_w):\n    \"\"\"Place noise pixels on non-wall cells and damage some wall cells.\"\"\"\n    total_cells = grid_h * grid_w\n    noise_fraction = random.uniform(*_NOISE_FRACTION_RANGE)\n    noise_count = int(total_cells * noise_fraction)\n\n    # Non-wall positions\n    nonwall_rs, nonwall_cs = np.where(~frame_mask)\n    perm = np.random.permutation(len(nonwall_rs))\n    n_nonwall = min(noise_count, len(perm))\n    sel = perm[:n_nonwall]\n    grid[nonwall_rs[sel], nonwall_cs[sel]] = noise_color\n    placed = n_nonwall\n\n    # Wall damage (up to _WALL_DAMAGE_FRACTION of wall pixels)\n    wall_rs, wall_cs = np.where(frame_mask)\n    n_wall = len(wall_rs)\n    max_damage = min(noise_count - placed, int(_WALL_DAMAGE_FRACTION * n_wall))\n    if max_damage > 0:\n        damage_perm = np.random.permutation(n_wall)[:max_damage]\n        grid[wall_rs[damage_perm], wall_cs[damage_perm]] = noise_color\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid puzzle grid.\"\"\"\n    frame_count = random.randint(*_FRAME_COUNT_RANGE)\n\n    # --- Room count assignment ---\n    available = list(range(_ROOM_COUNT_RANGE[0], _ROOM_COUNT_RANGE[1] + 1))\n    allow_tie = random.random() < _TIE_PROBABILITY and frame_count >= 3\n    if allow_tie:\n        distinct_needed = frame_count - 1\n        chosen = random.sample(available, min(distinct_needed, len(available)))\n        if len(chosen) < distinct_needed:\n            return None\n        room_counts = chosen + [random.choice(chosen)]\n    else:\n        if frame_count > len(available):\n            return None\n        room_counts = random.sample(available, frame_count)\n    random.shuffle(room_counts)\n\n    # --- Color assignment ---\n    chosen_colors = random.sample(list(range(1, 10)), frame_count + 1)\n    frame_colors = chosen_colors[:frame_count]\n    noise_color = chosen_colors[frame_count]\n\n    # --- Grid/frame size selection ---\n    cfg = _GRID_SIZE_BY_FRAMES.get(frame_count, _GRID_SIZE_BY_FRAMES[3])\n    h_min, h_max, w_min, w_max, f_max_h, f_max_w = cfg\n    grid_h = random.randint(h_min, h_max)\n    grid_w = random.randint(w_min, w_max)\n\n    # --- Build frames ---\n    frames = []\n    for color, target_rooms in zip(frame_colors, room_counts):\n        frame_data = _build_frame(target_rooms, max_h=f_max_h, max_w=f_max_w)\n        if frame_data is None:\n            return None\n        fh, fw = frame_data.shape\n        if fh > grid_h - 2 or fw > grid_w - 2:\n            return None\n        frames.append((color, target_rooms, frame_data))\n\n    # --- Place frames (largest first, random position) ---\n    positions = [None] * frame_count\n    for idx in sorted(range(frame_count), key=lambda i: -frames[i][2].size):\n        fh, fw = frames[idx][2].shape\n        positions[idx] = (random.randint(0, grid_h - fh), random.randint(0, grid_w - fw))\n\n    # --- Force overlaps for tied pairs ---\n    tied_pairs = [(i, j) for i in range(frame_count) for j in range(i + 1, frame_count)\n                  if room_counts[i] == room_counts[j]]\n    for i, j in tied_pairs:\n        _force_overlap(positions, i, j, frames, grid_h, grid_w)\n\n    # --- Force some non-tied overlaps ---\n    non_tied = [(i, j) for i in range(frame_count) for j in range(i + 1, frame_count)\n                if room_counts[i] != room_counts[j]]\n    n_extra = random.randint(*_EXTRA_OVERLAP_RANGE)\n    if n_extra > 0 and non_tied:\n        random.shuffle(non_tied)\n        for i, j in non_tied[:min(n_extra, len(non_tied))]:\n            _force_overlap(positions, i, j, frames, grid_h, grid_w)\n\n    # --- Render and add noise ---\n    render_order = list(range(frame_count))\n    random.shuffle(render_order)\n\n    grid, frame_mask = _render_frames(frames, positions, render_order, grid_h, grid_w)\n    _scatter_noise(grid, frame_mask, noise_color, grid_h, grid_w)\n\n    # --- Validate via solver oracle ---\n    try:\n        output = main(grid)\n    except Exception:\n        return None\n\n    # Build expected output: rows sorted by (room_count, render_order position)\n    frame_info = sorted(\n        [(room_counts[i], render_order.index(i), frame_colors[i]) for i in range(frame_count)])\n    max_rooms = max(rc for rc, _, _ in frame_info)\n    expected = np.full((frame_count, max_rooms), noise_color, dtype=int)\n    for r, (rc, _, color) in enumerate(frame_info):\n        expected[r, :rc] = color\n\n    return grid if np.array_equal(output, expected) else None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {_GEN_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
