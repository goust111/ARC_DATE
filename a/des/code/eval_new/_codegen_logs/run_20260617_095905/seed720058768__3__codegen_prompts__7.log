{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nrng = np.random.default_rng(0)\n\nCORNERS = ['TL','TR','BL','BR']\n\ndef wrap(boxes, corner):\n    top = rng.integers(1 if corner[0]=='T' else 0, 4)\n    bottom = rng.integers(1 if corner[0]=='B' else 0, 4)\n    left = rng.integers(1 if corner[1]=='L' else 0, 4)\n    right = rng.integers(1 if corner[1]=='R' else 0, 4)\n    if corner[0]=='T' and top==0: top=1\n    if corner[0]=='B' and bottom==0: bottom=1\n    if corner[1]=='L' and left==0: left=1\n    if corner[1]=='R' and right==0: right=1\n    shifted=[]\n    for r0,c0,r1,c1 in boxes:\n        shifted.append((r0+top,c0+left,r1+top,c1+left))\n    h = shifted[-1][2]+1 + bottom\n    w = shifted[-1][3]+1 + right\n    shifted.append((0,0,h-1,w-1))\n    return shifted\n\nfor _ in range(10):\n    k = rng.integers(2,6)\n    h = int(rng.integers(2,7))\n    w = int(rng.integers(2,7))\n    boxes=[(0,0,h-1,w-1)]\n    for _ in range(k-1):\n        boxes = wrap(boxes, rng.choice(CORNERS))\n    # boxes front->back\n    H,W = boxes[-1][2]+1, boxes[-1][3]+1\n    grid = np.zeros((H,W), int)\n    colors=list(range(1,k+1))\n    for color,box in zip(colors[::-1], boxes[::-1]):\n        r0,c0,r1,c1=box\n        grid[r0:r1+1,c0:c1+1]=color\n    ok=True\n    for color,box in zip(colors,boxes):\n        vis = grid==color\n        coords=np.argwhere(vis)\n        r0,c0,r1,c1=box\n        if coords.size==0:\n            ok=False; print('no vis'); break\n        b=(coords[:,0].min(),coords[:,1].min(),coords[:,0].max(),coords[:,1].max())\n        if b\"'!=box:\n            ok=False; print('\"'bbox mismatch', box,b); break\n        # full visible edges count\n        edge_count=0\n        if np.all(grid[r0,c0:c1+1]==color): edge_count+=1\n        if np.all(grid[r1,c0:c1+1]==color): edge_count+=1\n        if np.all(grid[r0:r1+1,c0]==color): edge_count+=1\n        if np.all(grid[r0:r1+1,c1]==color): edge_count+=1\n        if edge_count<2:\n            ok=False; print('edge fail',box,edge_count); break\n    print(k,H,W,ok)\n    if not ok:\n        print(grid)\n        break\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
