{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nrng = np.random.default_rng(1)\nCORNERS=['TL','TR','BL','BR']\n\ndef wrap(boxes, corner):\n    top = int(rng.integers(1 if corner[0]=='T' else 0, 4))\n    bottom = int(rng.integers(1 if corner[0]=='B' else 0, 4))\n    left = int(rng.integers(1 if corner[1]=='L' else 0, 4))\n    right = int(rng.integers(1 if corner[1]=='R' else 0, 4))\n    if corner[0]=='T': top=max(top,1)\n    if corner[0]=='B': bottom=max(bottom,1)\n    if corner[1]=='L': left=max(left,1)\n    if corner[1]=='R': right=max(right,1)\n    shifted=[(r0+top,c0+left,r1+top,c1+left) for r0,c0,r1,c1 in boxes]\n    h=max(r1 for _,_,r1,_ in shifted)+1+bottom\n    w=max(c1 for _,_,_,c1 in shifted)+1+right\n    shifted.append((0,0,h-1,w-1))\n    return shifted\n\nfor t in range(100):\n    k=int(rng.integers(2,6))\n    boxes=[(0,0,int(rng.integers(2,7))-1,int(rng.integers(2,7))-1)]\n    for _ in range(k-1):\n        boxes=wrap(boxes,rng.choice(CORNERS))\n    H,W=boxes[-1][2]+1, boxes[-1][3]+1\n    colors=list(range(1,k+1)) # front->back colors\n    grid=np.zeros((H,W),int)\n    for color,box in zip(colors[::-1], boxes[::-1]):\n        r0,c0,r1,c1=box\n        grid[r0:r1+1,c0:c1+1]=color\n    rects={c:box for c,box in zip(colors,boxes)}\n    idx={c:i for i,c in enumerate(colors)}\n    ok=True\n    for i,a in enumerate(colors):\n        for b in colors[i+1:]:\n            ar0,ac0,ar1,ac1=rects[a]\n            br0,bc0,br1,bc1=rects[b]\n            r0=max(ar0,br0); c0=max(ac0,bc0); r1=min(ar1,br1); c1=min(ac1,bc1)\n            if r0>r1 or c0>c1: continue\n            window=grid[r0:r1+1,c0:c1+1]\n            a_seen=np.any(window==a)\n            b_seen=np.any(window==b)\n            if a_seen and b_seen:\n                ok=False; print('both', t, a,b); break\n            if not a_seen and not b_seen:\n                ok=False; print('neither', t,a,b); break\n            if a_seen