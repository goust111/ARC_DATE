{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/faa9f03d.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import components_mask, get_bg\nimport random\n\n\nDIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _pts(mask: np.ndarray) -> set[tuple[int, int]]:\n    return {tuple(map(int, rc)) for rc in np.argwhere(mask)}\n\n\ndef _axis_support(mask: set[tuple[int, int]], r: int, c: int, axis: int) -> bool:\n    if axis == 0:\n        return (r, c - 1) in mask or (r, c + 1) in mask\n    return (r - 1, c) in mask or (r + 1, c) in mask\n\n\ndef _perp_support(mask: set[tuple[int, int]], r: int, c: int, axis: int) -> bool:\n    if axis == 0:\n        return (r - 1, c) in mask or (r + 1, c) in mask\n    return (r, c - 1) in mask or (r, c + 1) in mask\n\n\ndef _component_count(shape: tuple[int, int], pts: set[tuple[int, int]]) -> int:\n    mask = np.zeros(shape, dtype=bool)\n    for r, c in pts:\n        mask[r, c] = True\n    return len(components_mask(mask, connectivity=4))\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Repair a one-cell-thick colored line network by replacing singleton markers, filling short orthogonal gaps, and redirecting yellow-marked arms to the edge.\n\n    Input structure:\n    - A rectangular grid with a dominant background.\n    - Line colors form one-cell-thick horizontal/vertical stroke fragments.\n    - Marker colors are exactly those whose 4-connected components are all singleton pixels.\n    - Red singleton markers are missing line cells; yellow singleton markers are directional controls next to a line endpoint.\n\n    Rule:\n    - Assign every marker to the nearest visible line color in row/column line-of-sight, preferring an endpoint supported along that same axis.\n    - For each line color, fill the gap between consecutive facing endpoints in a row or column.\n    - A yellow control erases the old straight arm on the far side of its endpoint and paints the same color from that endpoint through the control pixel to the grid edge.\n    - At crossings, yellow-control rays win; otherwise an original-vs-filled crossing uses the more fragmented pre-repair line color, while pure filled crossings use the lower color id.\n\n    Key insight: The singleton markers identify which sparse stroke fragments belong together; after they are colored, the intended lines are the axis-aligned gaps between facing endpoints, with yellow controls flipping one arm to the marked side.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = g.shape\n\n    colors = set(map(int, g.ravel())) - {bg}\n    assert colors, \"expected foreground line and marker colors\"\n\n    marker_colors: set[int] = set()\n    for color in colors:\n        comps = components_mask(g == color, connectivity=4)\n        assert comps, \"foreground color must have at least one component\"\n        if max(len(comp) for comp in comps) == 1:\n            marker_colors.add(int(color))\n\n    line_colors = colors - marker_colors\n    assert line_colors, \"expected at least one non-marker line color\"\n    assert marker_colors, \"expected singleton marker colors\"\n\n    original = {color: _pts(g == color) for color in line_colors}\n    assignment: dict[tuple[int, int], int] = {}\n    assign_dir: dict[tuple[int, int], tuple[int, int]] = {}\n\n    marker_mask = np.isin(g, list(marker_colors))\n    for r0, c0 in _pts(marker_mask):\n        candidates: list[tuple[int, int, int, int, int]] = []\n        for dr, dc in DIRS4:\n            r, c = r0 + dr, c0 + dc\n            dist = 1\n            while 0 <= r < H and 0 <= c < W:\n                value = int(g[r, c])\n                if value in line_colors:\n                    axis = 0 if dr == 0 else 1\n                    supported = _axis_support(original[value], r, c, axis)\n                    candidates.append((dist, 0 if supported else 1, value, dr, dc))\n                    break\n                if value == bg or value in marker_colors:\n                    r += dr\n                    c += dc\n                    dist += 1\n                    continue\n                break\n\n        assert candidates, f\"marker at {(r0, c0)} cannot see a line color\"\n        candidates.sort()\n        _dist, _unsupported, color, dr, dc = candidates[0]\n        assignment[(r0, c0)] = int(color)\n        assign_dir[(r0, c0)] = (int(dr), int(dc))\n\n    masks = {color: set(pts) for color, pts in original.items()}\n    marker_pts = {color: set() for color in line_colors}\n    for pt, color in assignment.items():\n        masks[color].add(pt)\n        marker_pts[color].add(pt)\n\n    comp_count = {color: _component_count(g.shape, masks[color]) for color in line_colors}\n\n    def has_axis_support(color: int, r: int, c: int, axis: int) -> bool:\n        return (r, c) in marker_pts[color] or _axis_support(masks[color], r, c, axis)\n\n    def should_fill(color: int, a: tuple[int, int], b: tuple[int, int], axis: int) -> bool:\n        r1, c1 = a\n        r2, c2 = b\n        gap = c2 - c1 - 1 if axis == 0 else r2 - r1 - 1\n        if gap <= 0:\n            return False\n\n        a_axis = has_axis_support(color, r1, c1, axis)\n        b_axis = has_axis_support(color, r2, c2, axis)\n        if gap == 1:\n            if a_axis or b_axis:\n                return True\n            a_perp = _perp_support(masks[color], r1, c1, axis)\n            b_perp = _perp_support(masks[color], r2, c2, axis)\n            return not (a_perp and b_perp)\n\n        if (r1, c1) in marker_pts[color] and (r2, c2) in marker_pts[color]:\n            return False\n        return a_axis and b_axis\n\n    for color in sorted(line_colors):\n        additions: set[tuple[int, int]] = set()\n        for r in range(H):\n            cols = sorted(c for rr, c in masks[color] if rr == r)\n            for c1, c2 in zip(cols, cols[1:]):\n                if should_fill(color, (r, c1), (r, c2), axis=0):\n                    additions.update((r, c) for c in range(c1 + 1, c2))\n\n        for c in range(W):\n            rows = sorted(r for r, cc in masks[color] if cc == c)\n            for r1, r2 in zip(rows, rows[1:]):\n                if should_fill(color, (r1, c), (r2, c), axis=1):\n                    additions.update((r, c) for r in range(r1 + 1, r2))\n\n        masks[color].update(additions)\n\n    control_ray = {color: set() for color in line_colors}\n    if 4 in marker_colors:\n        for control in _pts(g == 4):\n            color = assignment[control]\n            dr, dc = assign_dir[control]\n\n            r, c = control[0] + dr, control[1] + dc\n            pivot: tuple[int, int] | None = None\n            while 0 <= r < H and 0 <= c < W:\n                if (r, c) in masks[color]:\n                    pivot = (r, c)\n                    break\n                r += dr\n                c += dc\n            assert pivot is not None, f\"yellow control at {control} has no assigned endpoint\"\n\n            old_start = (pivot[0] + dr, pivot[1] + dc)\n            if old_start in masks[color]:\n                stack = [old_start]\n                old_arm: set[tuple[int, int]] = set()\n                while stack:\n                    q = stack.pop()\n                    if q == pivot or q in old_arm or q not in masks[color]:\n                        continue\n                    old_arm.add(q)\n                    qr, qc = q\n                    for ndr, ndc in DIRS4:\n                        stack.append((qr + ndr, qc + ndc))\n\n                assert old_arm, f\"yellow control at {control} found no old arm to erase\"\n                for q in old_arm:\n                    masks[color].discard(q)\n                    marker_pts[color].discard(q)\n                    control_ray[color].discard(q)\n\n            pr, pc = -dr, -dc\n            r, c = pivot\n            while 0 <= r < H and 0 <= c < W:\n                masks[color].add((r, c))\n                control_ray[color].add((r, c))\n                r += pr\n                c += pc\n\n    claims: dict[tuple[int, int], list[int]] = {}\n    for color, pts in masks.items():\n        for pt in pts:\n            claims.setdefault(pt, []).append(int(color))\n\n    out = np.full_like(g, bg)\n\n    def marker_brackets(color: int, pt: tuple[int, int]) -> bool:\n        r, c = pt\n        same_row = [mc for mr, mc in marker_pts[color] if mr == r]\n        if any(mc < c for mc in same_row) and any(mc > c for mc in same_row):\n            return True\n        same_col = [mr for mr, mc in marker_pts[color] if mc == c]\n        return any(mr < r for mr in same_col) and any(mr > r for mr in same_col)\n\n    for pt, colors_here in claims.items():\n        forced = {color for color in colors_here if pt in control_ray[color]}\n        if forced:\n            assert len(forced) == 1, f\"ambiguous yellow-control rays at {pt}: {forced}\"\n            out[pt] = next(iter(forced))\n            continue\n\n        if len(colors_here) == 1:\n            out[pt] = colors_here[0]\n            continue\n\n        original_crossing = [color for color in colors_here if int(g[pt]) == color]\n        if original_crossing:\n            out[pt] = min(colors_here, key=lambda color: (-comp_count[color], color))\n        else:\n            bracketed = [color for color in colors_here if marker_brackets(color, pt)]\n            if bracketed:\n                out[pt] = min(bracketed, key=lambda color: (-comp_count[color], color))\n            else:\n                out[pt] = min(colors_here)\n\n    # Assert: every visible endpoint is on the boundary (or at a crossing)\n    for color in line_colors:\n        for comp in components_mask(out == color, connectivity=4):\n            pts_set = set(map(tuple, comp))\n            for r, c in pts_set:\n                nbrs = [(nr, nc) for nr, nc in [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]\n                        if (nr, nc) in pts_set]\n                if len(nbrs) != 1:\n                    continue\n                on_boundary = (r == 0 or r == H - 1 or c == 0 or c == W - 1)\n                if on_boundary:\n                    # Perpendicularity check\n                    nr, nc = nbrs[0]\n                    dr, dc = nr - r, nc - c\n                    if not ((r in (0, H-1)) and (c in (0, W-1))):\n                        perp = ((r == 0 and dr == 1) or (r == H-1 and dr == -1)\n                                or (c == 0 and dc == 1) or (c == W-1 and dc == -1))\n                        assert perp, f\"boundary endpoint ({r},{c}) color {color} not perpendicular\"\n                    continue\n                adj_other = any(\n                    0 <= r+dr < H and 0 <= c+dc < W\n                    and int(out[r+dr, c+dc]) not in (bg, color)\n                    for dr, dc in DIRS4)\n                assert adj_other, f\"dangling endpoint ({r},{c}) color {color}: not on boundary or crossing\"\n\n    # Assert: every line color crosses at least one other color\n    color_cells = {c: set() for c in line_colors}\n    for r in range(H):\n        for c in range(W):\n            v = int(out[r, c])\n            if v in line_colors:\n                color_cells[v].add((r, c))\n    crossing_colors = set()\n    for r in range(H):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/3bd292e8.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import defaultdict, deque\n\nimport numpy as np\n\nfrom arc_utils import Color, get_bg, label_mask, neighbors4\nimport itertools\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor wall-separated background regions alternately, starting with grey in the lower-left region.\n\n    Input structure\n    - The grid has one dominant background color and one foreground wall color.\n    - The wall pixels form one or more 4-connected one-cell-thick segments.\n    - Each wall segment separates exactly two 4-connected background regions.\n    Rule\n    - Keep all wall pixels unchanged.\n    - Label the 4-connected background regions and connect two labels when they\n      touch opposite sides of the same wall segment.\n    - Color the region containing the lower-left corner grey, then flip between\n      grey and green across every wall adjacency.\n    Key insight\n    - The red walls define a bipartite map of regions; the lower-left background\n      region fixes which side of the alternating coloring is grey.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    H, W = g.shape\n\n    colors = set(map(int, g.flat))\n    assert len(colors) == 2, \"expected exactly one background color and one wall color\"\n    bg = get_bg(g)\n    wall_colors = colors - {int(bg)}\n    assert len(wall_colors) == 1\n    wall = int(next(iter(wall_colors)))\n\n    bg_lab, n_regions = label_mask(g == int(bg), connectivity=4)\n    assert n_regions >= 2, \"walls must split the background into multiple regions\"\n    start_region = int(bg_lab[H - 1, 0])\n    assert start_region > 0, \"lower-left corner must belong to a background region\"\n\n    wall_lab, n_walls = label_mask(g == wall, connectivity=4)\n    assert n_walls >= 1\n\n    graph: dict[int, set[int]] = defaultdict(set)\n    for wall_id in range(1, n_walls + 1):\n        adjacent_regions: set[int] = set()\n        for r, c in np.argwhere(wall_lab == wall_id):\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W:\n                    region_id = int(bg_lab[rr, cc])\n                    if region_id > 0:\n                        adjacent_regions.add(region_id)\n\n        assert len(adjacent_regions) == 2, \"each wall segment must separate exactly two regions\"\n        a, b = tuple(adjacent_regions)\n        graph[a].add(b)\n        graph[b].add(a)\n\n    parity = {start_region: 0}\n    queue = deque([start_region])\n    while queue:\n        region = queue.popleft()\n        for neighbor in graph[region]:\n            neighbor_parity = 1 - parity[region]\n            if neighbor in parity:\n                assert parity[neighbor] == neighbor_parity, \"region graph must be bipartite\"\n            else:\n                parity[neighbor] = neighbor_parity\n                queue.append(neighbor)\n\n    assert set(parity) == set(range(1, n_regions + 1)), \"all background regions must be wall-connected\"\n\n    out = g.copy()\n    for region_id, region_parity in parity.items():\n        out[bg_lab == region_id] = Color.GREY if region_parity == 0 else Color.GREEN\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Grid, colors, and retry policy.\nGRID_SIZES = (7, 8, 9)\nGRID_SIZES_FOR_THREE_WALLS = (8, 9)\nWALL_COUNT_RANGE = (1, 3)\nMAX_GENERATION_ATTEMPTS = 300\nBACKGROUND_COLOR = Color.ORANGE\nWALL_COLOR = Color.RED\n\n# Wall geometry constraints.\nWALL_LENGTH_RANGE = (4, 13)\nWALL_TURN_RANGE = (1, 5)\nENDPOINT_SPACING = 2\nMAX_STAIR_PARTS = 3\nMIN_FIRST_STAIR_COL = 1\n\n# Left-right corridor layout.\nLR_LAYOUT_MAX_WALLS = 2\nLR_LAYOUT_PROBABILITY = 0.55\nLR_TURN_OPTIONS = (2, 4)\nLR_CORRIDOR_MAX_SPAN = 3\nLR_CORRIDOR_GAP = 2\n\n# Canonical grids are randomly mapped through one of eight dihedral transforms.\nTRANSFORM_OPS = 8\n\n\ndef _contains(bounds: tuple[int, int], value: int) -> bool:\n    lo, hi = bounds\n    return lo <= int(value) <= hi\n\n\ndef _paint_wall_path(grid: np.ndarray, cells: list[tuple[int, int]]) -> bool:\n    for r, c in cells:\n        if grid[r, c] != BACKGROUND_COLOR:\n            return False\n        grid[r, c] = WALL_COLOR\n    return True\n\n\ndef _split_positive(total: int, parts: int) -> list[int]:\n    if parts == 1:\n        return [int(total)]\n    cuts = sorted(random.sample(range(1, int(total)), int(parts) - 1))\n    return [b - a for a, b in zip([0] + cuts, cuts + [int(total)])]\n\n\ndef _spaced_combos(values: list[int], n: int) -> list[tuple[int, ...]]:\n    return [\n        combo\n        for combo in itertools.combinations(values, n)\n        if all(combo[i + 1] - combo[i] >= ENDPOINT_SPACING for i in range(len(combo) - 1))\n    ]\n\n\ndef _choose_endpoints(H: int, W: int, n_walls: int) -> tuple[tuple[int, ...], tuple[int, ...]] | None:\n    rows = _spaced_combos(list(range(1, H - 1)), n_walls)\n    cols = _spaced_combos(list(range(1, W - 1)), n_walls)\n    valid: list[tuple[tuple[int, ...], tuple[int, ...]]] = []\n    for start_rows in rows:\n        for cols_asc in cols:\n            end_cols = tuple(reversed(cols_asc))\n            lengths = [c + (H - 1 - r) + 1 for r, c in zip(start_rows, end_cols)]\n            if all(_contains(WALL_LENGTH_RANGE, length) for length in lengths):\n                valid.append((start_rows, end_cols))\n    return random.choice(valid) if valid else None\n\n\ndef _stair_path_lb(H: int, W: int, start_r: int, end_c: int, min_first_col: int) -> list[tuple[int, int]] | None:\n    down = H - 1 - int(start_r)\n    right = int(end_c)\n    max_parts = min(MAX_STAIR_PARTS, down, right)\n    feasible = [k for k in range(1, max_parts + 1) if right >= int(min_first_col) + k - 1]\n    if not feasible:\n        return None\n    weights = [k * k for k in feasible]\n    k = random.choices(feasible, weights=weights, k=1)[0]\n\n    if k == 1:\n        horiz = [right]\n    else:\n        first = random.randint(int(min_first_col), right - (k - 1))\n        horiz = [first] + _split_positive(right - first, k - 1)\n    vert = _split_positive(down, k)\n\n    r, c = int(start_r), 0\n    cells = [(r, c)]\n    for h_run, v_run in zip(horiz, vert):\n        for _ in range(h_run):\n            c += 1\n            cells.append((r, c))\n        for _ in range(v_run):\n            r += 1\n            cells.append((r, c))\n\n    if (r, c) != (H - 1, int(end_c)):\n        return None\n    return cells\n\n\ndef _build_lower_left_grid(H: int, W: int, n_walls: int) -> np.ndarray | None:\n    endpoints = _choose_endpoints(H, W, n_walls)\n    if endpoints is None:\n        return None\n    start_rows, end_cols = endpoints\n\n    grid = np.full((H, W), BACKGROUND_COLOR, dtype=int)\n    for i, (start_r, end_c) in enumerate(zip(start_rows, end_cols)):\n        min_first_col = end_cols[i + 1] + ENDPOINT_SPACING if i + 1 < n_walls else MIN_FIRST_STAIR_COL\n        cells = _stair_path_lb(H, W, start_r, end_c, min_first_col)\n        if cells is None or not _paint_wall_path(grid, cells):\n            return None\n    return grid\n\n\ndef _choose_lr_corridors(H: int, n_walls: int) -> tuple[tuple[int, int], ...] | None:\n    intervals = []\n    for lo in range(1, H - 2):\n        for hi in range(lo + 1, min(H - 2, lo + LR_CORRIDOR_MAX_SPAN) + 1):\n            intervals.append((lo, hi))\n    valid: list[tuple[tuple[int, int], ...]] = []\n    for combo in itertools.combinations(intervals, n_walls):\n        if all(combo[i][1] + LR_CORRIDOR_GAP <= combo[i + 1][0] for i in range(n_walls - 1)):\n            valid.append(combo)\n    return random.choice(valid) if valid else None\n\n\ndef _lr_path(W: int, lo: int, hi: int) -> list[tuple[int, int]] | None:\n    short_turn, long_turn = LR_TURN_OPTIONS\n    turn_goal = random.choice(LR_TURN_OPTIONS)\n    if turn_goal == long_turn and W - 1 < long_turn:\n        turn_goal = short_turn\n\n    if turn_goal == short_turn:\n        h1 = random.randint(1, W - 2)\n        horiz = [h1, W - 1 - h1]\n        r0, r1 = random.sample(range(lo, hi + 1), 2)\n        rows = [r0, r1]\n    else:\n        if hi - lo >= 2:\n            if random.random() < 0.5:\n                rows = [lo, random.randint(lo + 1, hi - 1), hi]\n            else:\n                rows = [hi, random.randint(lo + 1, hi - 1), lo]\n            middle_min = 1\n        else:\n            rows = [lo, hi, lo] if random.random() < 0.5 else [hi, lo, hi]\n            middle_min = 2\n        if W - 1 < middle_min + 2:\n            return None\n        h2 = random.randint(middle_min, W - 3)\n        h1 = random.randint(1, W - 1 - h2 - 1)\n        horiz = [h1, h2, W - 1 - h1 - h2]\n\n    r, c = int(rows[0]), 0\n    cells = [(r, c)]\n    for i, h_run in enumerate(horiz):\n        for _ in range(h_run):\n            c += 1\n            cells.append((r, c))\n        if i < len(rows) - 1:\n            target = int(rows[i + 1])\n            step = 1 if target > r else -1\n            while r != target:\n                r += step\n                cells.append((r, c))\n\n    if c != W - 1:\n        return None\n    if not _contains(WALL_LENGTH_RANGE, len(cells)):\n        return None\n    return cells\n\n\ndef _build_lr_grid(H: int, W: int, n_walls: int) -> np.ndarray | None:\n    corridors = _choose_lr_corridors(H, n_walls)\n    if corridors is None:\n","exit_code":0,"status":"completed"}}
