+    solutions = _solve_assignments(g, max_solutions=2)
+    assert len(solutions) == 1, "expected a unique non-overlapping path assignment"
+
+    out = g.copy()
+    for color, (_cells, grey_cells) in solutions[0].items():
+        for r, c in grey_cells:
+            out[r, c] = color
+    return out
