+BG = 0
+GREY = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+
+MAX_PATHS_PER_COLOR = 128
+
+COARSE_ROWS_RANGE = (5, 9)
+COARSE_COLS_RANGE = (5, 9)
+PAIR_COUNT_SMALL = (2, 3)
+PAIR_COUNT_LARGE = (2, 3, 4)
+ROUTE_EDGE_MIN = 3
+ROUTE_EDGE_MAX = 6
+GENERATION_RETRIES = 500
+GRAPH_BUILD_RETRIES = 120
