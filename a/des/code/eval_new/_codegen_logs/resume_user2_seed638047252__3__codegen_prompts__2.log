+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        for _ in range(GRAPH_BUILD_RETRIES):
+            candidate = _build_candidate()
+            if candidate is None:
+                continue
+            inp, expected = candidate
+            if _is_unique_expected(inp, expected):
+                return inp
