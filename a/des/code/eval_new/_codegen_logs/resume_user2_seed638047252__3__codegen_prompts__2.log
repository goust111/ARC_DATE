+            return None
+
+    inp, expected = _render_instance(rows, cols, graph, routes)
+    return inp, expected
+
+
+def _is_unique_expected(inp: np.ndarray, expected: np.ndarray) -> bool:
+    try:
+        solutions = _solve_assignments(inp, max_solutions=2)
+    except AssertionError:
