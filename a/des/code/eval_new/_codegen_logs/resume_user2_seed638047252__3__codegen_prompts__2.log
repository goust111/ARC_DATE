+    cols: int,
+    start: CoarseNode,
+    goal: CoarseNode,
+    blocked_nodes: set[CoarseNode],
+) -> list[CoarseNode] | None:
+    queue = deque([start])
+    prev: dict[CoarseNode, CoarseNode | None] = {start: None}
+    while queue:
+        node = queue.popleft()
+        if node == goal:
+            break
+        neighbors = _coarse_neighbors(node, rows, cols)
+        random.shuffle(neighbors)
+        for nb in neighbors:
+            if nb in prev:
+                continue
+            if nb != goal and nb in blocked_nodes:
+                continue
