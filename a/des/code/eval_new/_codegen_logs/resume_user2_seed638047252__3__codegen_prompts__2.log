+        queue = [start]
+        component = {start}
+        while queue:
+            node = queue.pop()
+            for nb in graph[node]:
+                if nb in remaining:
+                    remaining.remove(nb)
+                    component.add(nb)
+                    queue.append(nb)
+        components.append(component)
