+            top=int(top),
+            left=int(left),
+            h=frame_h,
+            w=frame_w,
+            color=int(spec["frame_color"]),
+            bg=bg,
+            gap_side=direction,
+            gap_offset=int(spec["gap_offset"]),
+        )
+        _paint_frame(
+            expected,
+            top=int(top),
+            left=int(left),
+            h=frame_h,
+            w=frame_w,
