+
+def _scan_key_line(line: np.ndarray, color: int, bg: int) -> list[tuple[int, int, int]]:
+    line = np.asarray(line, dtype=int)
+    n = int(line.shape[0])
+    all_color = {int(i) for i in np.flatnonzero(line == color)}
+    candidates: list[tuple[int, int, int]] = []
