+                                inp[r, c] = int(color)
+                            reserved[r, c] = True
+                        for r, c in adj:
+                            reserved[r, c] = True
+                        return True
+            else:
+                cols = [0, w - 1]
+                rng.shuffle(cols)
+                starts = list(range(1, h - length)) if h - length >= 2 else list(range(0, h - length + 1))
+                rng.shuffle(starts)
+                for col in cols:
+                    for start in starts:
+                        cells = [(int(start + i), int(col)) for i in range(length)]
+                        if any(int(inp[r, c]) != bg or reserved[r, c] for r, c in cells):
+                            continue
