+    return int(np.argmax(values))
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[dict]:
+    mask = np.asarray(grid == color, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[dict] = []
+
+    for r0 in range(h):
+        for c0 in range(w):
+            if not mask[r0, c0] or seen[r0, c0]:
+                continue
+            stack = [(r0, c0)]
+            seen[r0, c0] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                coords.append((int(r), int(c)))
+                for dr, dc in DIR4:
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            arr = np.array(coords, dtype=int)
+            r1, c1 = arr.min(axis=0)
+            r2, c2 = arr.max(axis=0)
+            comps.append(
+                {
+                    "coords": arr,
+                    "bbox": (int(r1), int(c1), int(r2), int(c2)),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def _mask_is_connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return False
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    start = tuple(int(v) for v in pts[0])
+    stack = [start]
+    seen[start] = True
+    count = 0
+    while stack:
+        r, c = stack.pop()
+        count += 1
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                stack.append((int(nr), int(nc)))
+    return count == int(mask.sum())
