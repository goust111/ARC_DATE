+    if (gap_r, gap_c) in corners:
+        return None
+
+    if gap_r == r0:
+        gap_side = "U"
+    elif gap_r == r1:
+        gap_side = "D"
+    elif gap_c == c0:
+        gap_side = "L"
+    else:
+        gap_side = "R"
