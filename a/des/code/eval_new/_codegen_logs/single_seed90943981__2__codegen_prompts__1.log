+
+def _key_direction(orientation: str, gap_idx: int, length: int) -> str:
+    mid = int(length // 2)
+    if gap_idx == mid:
+        return "U" if orientation == "H" else "L"
+    if orientation == "H":
+        return "L" if gap_idx < mid else "R"
+    return "U" if gap_idx < mid else "D"
+
