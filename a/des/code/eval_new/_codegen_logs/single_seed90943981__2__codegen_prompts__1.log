+def _frame_from_component(grid: np.ndarray, bg: int, color: int, comp: dict) -> dict | None:
+    r0, c0, r1, c1 = map(int, comp["bbox"])
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 4 or w < 4:
+        return None
+
+    border = set()
+    for c in range(c0, c1 + 1):
+        border.add((r0, c))
+        border.add((r1, c))
+    for r in range(r0 + 1, r1):
+        border.add((r, c0))
+        border.add((r, c1))
+
+    coords = {(int(r), int(c)) for r, c in comp["coords"]}
+    if len(coords) != len(border) - 1:
+        return None
+    if coords - border:
+        return None
+
+    missing = list(border - coords)
+    if len(missing) != 1:
+        return None
+    gap_r, gap_c = map(int, missing[0])
+    corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
+    if (gap_r, gap_c) in corners:
+        return None
+
+    if gap_r == r0:
+        gap_side = "U"
+    elif gap_r == r1:
+        gap_side = "D"
+    elif gap_c == c0:
