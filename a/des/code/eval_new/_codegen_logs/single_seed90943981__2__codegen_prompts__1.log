+
+def _paint_mask(grid: np.ndarray, mask: np.ndarray, top: int, left: int, color: int) -> None:
+    h, w = mask.shape
+    sub = grid[top : top + h, left : left + w]
+    sub[mask] = int(color)
+
+
+def _paint_frame(
+    grid: np.ndarray,
+    *,
+    top: int,
+    left: int,
+    h: int,
+    w: int,
+    color: int,
+    bg: int,
+    gap_side: str,
+    gap_offset: int,
