+        border.add((r, c0))
+        border.add((r, c1))
+
+    coords = {(int(r), int(c)) for r, c in comp["coords"]}
+    if len(coords) != len(border) - 1:
+        return None
+    if coords - border:
+        return None
+
+    missing = list(border - coords)
+    if len(missing) != 1:
+        return None
+    gap_r, gap_c = map(int, missing[0])
+    corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
+    if (gap_r, gap_c) in corners:
