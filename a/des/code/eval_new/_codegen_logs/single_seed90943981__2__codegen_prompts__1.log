+                        adj = []
+                        if start > 0:
+                            adj.append((int(start - 1), int(col)))
+                        if start + length < h:
+                            adj.append((int(start + length), int(col)))
+                        if any(int(inp[r, c]) != bg or reserved[r, c] for r, c in adj):
+                            continue
+                        for i, (r, c) in enumerate(cells):
+                            if i != gap_idx:
+                                inp[r, c] = int(color)
+                            reserved[r, c] = True
+                        for r, c in adj:
+                            reserved[r, c] = True
+                        return True
