+        "pattern_color": int(pattern_color),
+        "direction": direction,
+        "frame_h": int(h),
+        "frame_w": int(w),
+        "pattern_mask": mask,
+        "pattern_h": ph,
+        "pattern_w": pw,
+        "pattern_r": int(pat_r),
