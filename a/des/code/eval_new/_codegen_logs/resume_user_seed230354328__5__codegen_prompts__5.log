+
+def _sample_scales(num_objects: int) -> list[int]:
+    if num_objects == 2:
+        return [1, int(_RNG.choice([2, 3]))]
+    choices = ([1, 1, 2], [1, 2, 2])
+    return list(choices[int(_RNG.integers(len(choices)))])
