+    for shape, slot in zip(shape_order, slots):
+        occupancy = np.asarray(shape["mask"], dtype=bool)
+        scale_h = int(shape["h"]) // base_h
+        scale_w = int(shape["w"]) // base_w
+        assert scale_h == scale_w and scale_h >= 1
+        unit = _downscale_binary(occupancy, scale_h)
+        if unit_template is None:
+            unit_template = unit
+        else:
+            assert np.array_equal(unit_template, unit)
