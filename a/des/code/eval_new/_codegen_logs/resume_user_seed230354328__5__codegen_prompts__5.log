+    slot_inner = _TEMPLATE_SIDE * max_scale
+    slot_outer = slot_inner + 2 * _FRAME_THICKNESS
+    slots_width = num_objects * slot_outer + (num_objects - 1) * _SLOT_GAP
+    if slots_width > 30:
