+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = int(np.bincount(g.ravel()).argmax())
+
+    parts = [_component_info(g, coords) for coords in _components(g != bg)]
+    slots = _find_slot_group(parts)
+    slot_color = next(iter(Counter(slots[0]["colors"]).keys()))
