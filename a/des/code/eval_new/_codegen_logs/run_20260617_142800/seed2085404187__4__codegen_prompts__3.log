88e364bc.py:349:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:380:    \"\"\"Grow irregular closed regions, one per assigned wall color.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:383:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:440:    \"\"\"Attempt up to BLOB_GROW_RETRIES random seeds to grow a valid blob.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:468:    \"\"\"Check that every enclosed bg component matches exactly one region interior.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:485:    \"\"\"Choose yellow output positions and reverse-slide to derive input positions.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:489:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:533:    \"\"\"Walk backwards from out_pos to find a valid input position 1..MAX_SLIDE_STEPS away.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:556:    \"\"\"Run the solver on input_grid and verify correctness.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:604:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/11dc524f.py:24:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/11dc524f.py:25:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/11dc524f.py:40:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/11dc524f.py:114:    \"\"\"True if mask has at least one filled cell on each edge of its bounding box.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/11dc524f.py:120:    \"\"\"Enumerate all valid 4-cell sprite masks for a given mirror axis.\n/home/lixinyu/snap/new/ARC_code/train/11dc524f.py:124:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/11dc524f.py:147:    \"\"\"Stamp a boolean mask onto grid at (r0, c0) using the given color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/11dc524f.py:155:    \"\"\"Pick a random origin for the touching sprite+mirror pair.\n/home/lixinyu/snap/new/ARC_code/train/11dc524f.py:159:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/11dc524f.py:177:    \"\"\"Compute output and input placement params for a given side.\n/home/lixinyu/snap/new/ARC_code/train/11dc524f.py:181:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/11dc524f.py:214:    \"\"\"Try to build one valid (input, output) pair; return input or None.\"\"\"\n/home/lixinyu/snap/new/ARC_code/train/11dc524f.py:260:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/465b7d93.py:96:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/465b7d93.py:97:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/465b7d93.py:117:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/465b7d93.py:260:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/9f669b64.py:25:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/train/9f669b64.py:26:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/9f669b64.py:48:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/train/9f669b64.py:251:def generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
