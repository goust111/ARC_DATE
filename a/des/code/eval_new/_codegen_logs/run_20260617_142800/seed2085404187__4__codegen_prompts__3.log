{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' /home/lixinyu/snap/new/ARC_code/train/fe45cba4.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import defaultdict\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\ndef _cells(coords: np.ndarray) -> frozenset[tuple[int, int]]:\n    return frozenset((int(r), int(c)) for r, c in coords)\n\n\ndef _solid_completion_offsets(\n    g: np.ndarray,\n    source: frozenset[tuple[int, int]],\n    target: frozenset[tuple[int, int]],\n    bg: int,\n) -> list[tuple[int, int]]:\n    height, width = g.shape\n    offsets: list[tuple[int, int]] = []\n\n    for dr in range(1 - height, height):\n        for dc in range(1 - width, width):\n            moved = frozenset((r + dr, c + dc) for r, c in source)\n            if any(r < 0 or r >= height or c < 0 or c >= width for r, c in moved):\n                continue\n            if moved & target:\n                continue\n            if any(int(g[r, c]) != int(bg) for r, c in moved):\n                continue\n\n            union = moved | target\n            rows = [r for r, _c in union]\n            cols = [c for _r, c in union]\n            rect_area = (max(rows) - min(rows) + 1) * (max(cols) - min(cols) + 1)\n            if len(union) == rect_area:\n                offsets.append((dr, dc))\n\n    return offsets\n\n\ndef _completion_candidate(\n    g: np.ndarray,\n    bg: int,\n) -> tuple[int, frozenset[tuple[int, int]], int, int]:\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    by_color: dict[int, list[dict]] = defaultdict(list)\n    for component in components:\n        by_color[int(component[\"color\"])].append(component)\n\n    candidates: list[tuple[int, frozenset[tuple[int, int]], int, int]] = []\n    for color, parts in by_color.items():\n        if len(parts) != 2:\n            continue\n\n        left_edge = [part for part in parts if int(part[\"bbox\"][1]) == 0]\n        anchors = [part for part in parts if int(part[\"bbox\"][1]) != 0]\n        if len(left_edge) != 1 or len(anchors) != 1:\n            continue\n\n        source = _cells(left_edge[0][\"coords\"])\n        target = _cells(anchors[0][\"coords\"])\n        for dr, dc in _solid_completion_offsets(g, source, target, bg):\n            candidates.append((int(color), source, dr, dc))\n\n    assert len(candidates) == 1, \"expected one left-edge object that completes a same-color rectangle\"\n    return candidates[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the left-edge fragment into its same-colored anchor fragment to complete a solid rectangle.\n\n    Input structure\n    - The grid has a dominant background color.\n    - Exactly one foreground color is split into two 4-connected objects: one\n      touches the left edge, and the other is an anchor away from the left edge.\n    - The translated left-edge object and the anchor can form one filled rectangle.\n    Rule\n    - Find the unique split color whose left-edge object can be translated onto\n      background cells beside the other same-colored object so their union is a\n      solid axis-aligned rectangle.\n    - Clear the left-edge object's original cells to the background.\n    - Paint that object at the unique completing offset, preserving all other cells.\n    Key insight\n    - The active color is identified by object structure and rectangle completion,\n      not by a fixed color id; the same-colored anchor object stays in place.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    color, source, dr, dc = _completion_candidate(g, bg)\n\n    out = g.copy()\n    for r, c in source:\n        out[r, c] = int(bg)\n    for r, c in source:\n        rr, cc = r + dr, c + dc\n        assert int(out[rr, cc]) == int(bg), \"translated source must land on background cells\"\n        out[rr, cc] = int(color)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and object size bounds.\nGRID_SIZE_RANGE = (8, 16)\nOBJECT_HEIGHT_RANGE = (3, 5)\nRECT_WIDTH_RANGE = (4, 7)\nLEFT_PATCH_CANVAS_PAD = 3\n\n# Layout and shape constraints.\nROW_GAP_MIN = 1\nMIN_ROW_WIDTH = 1\nSOURCE_RIGHT_PAD = 2\nDST_WIDTH_RESERVED_COLS = 1\n\n# Sampling controls.\nPALETTE_COLORS = tuple(range(10))\nNONSPLIT_ABOVE_CHOICES = (True, False)\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_symmetric_widths(height: int, width: int, *, min_width: int = MIN_ROW_WIDTH,\n                          varied: bool = False, include_max: bool = False) -> list[int]:\n    \"\"\"Sample row widths and mirror them vertically.\"\"\"\n    half = (height + 1) // 2\n    vals = [random.randint(min_width, width) for _ in range(half)]\n    if include_max:\n        vals[random.randrange(half)] = width\n    if varied and width > min_width and len(set(vals + vals[: height // 2][::-1])) == 1:\n        j = random.randrange(half)\n        vals[j] = min(width, vals[j] + 1) if vals[j] < width else vals[j] - 1\n    return vals + vals[: height // 2][::-1]\n\n\ndef _right_anchored_mask(widths: list[int], patch_width: int) -> np.ndarray:\n    \"\"\"Return a mask whose true cells fill each row from the right edge.\"\"\"\n    row_widths = np.asarray(widths, dtype=int)[:, None]\n    cols = np.arange(patch_width)[None, :]\n    return cols >= patch_width - row_widths\n\n\ndef _gen_right_shape_with_max_width(height: int, patch_width: int, max_row_width: int,\n                                    color: int, bg: int) -> np.ndarray:\n    patch = np.full((height, patch_width), bg, dtype=int)\n    widths = _gen_symmetric_widths(height, max_row_width, varied=True, include_max=True)\n    patch[_right_anchored_mask(widths, patch_width)] = color\n    return patch\n\n\ndef _gen_pick_layout(n: int) -> tuple[int, int, int, int, int] | None:\n    h_min, h_max = OBJECT_HEIGHT_RANGE\n    pairs = [\n        (rh, nh)\n        for rh in range(h_min, h_max + 1)\n        for nh in range(h_min, h_max + 1)\n        if rh + nh + ROW_GAP_MIN <= n\n    ]\n    if not pairs:\n        return None\n    rect_h, nonsplit_h = random.choice(pairs)\n    min_w, max_w = RECT_WIDTH_RANGE[0], min(RECT_WIDTH_RANGE[1], n - LEFT_PATCH_CANVAS_PAD)\n    if max_w < min_w:\n        return None\n    rect_w = random.randint(min_w, max_w)\n\n    place_nonsplit_above = random.choice(NONSPLIT_ABOVE_CHOICES)\n    if place_nonsplit_above:\n        max_rect_top = n - rect_h\n        min_rect_top = nonsplit_h + ROW_GAP_MIN\n        if min_rect_top > max_rect_top:\n            return None\n        rect_top = random.randint(min_rect_top, max_rect_top)\n        nonsplit_top = random.randint(0, rect_top - nonsplit_h - ROW_GAP_MIN)\n    else:\n        max_rect_top = n - rect_h - nonsplit_h - ROW_GAP_MIN\n        if max_rect_top < 0:\n            return None\n        rect_top = random.randint(0, max_rect_top)\n        nonsplit_top = random.randint(rect_top + rect_h + ROW_GAP_MIN, n - nonsplit_h)\n    return rect_h, rect_w, rect_top, nonsplit_h, nonsplit_top\n\n\ndef _gen_split_patches(rect_h: int, rect_w: int, min_dst_width: int,\n                       split_color: int, bg: int) -> tuple[np.ndarray, np.ndarray, list[int]]:\n    dst_widths = _gen_symmetric_widths(rect_h, rect_w - 1, min_width=min_dst_width, varied=True)\n    dst = np.full((rect_h, rect_w), bg, dtype=int)\n    src = np.full((rect_h, rect_w), bg, dtype=int)\n    dst_mask = _right_anchored_mask(dst_widths, rect_w)\n    dst[dst_mask] = split_color\n    src[~dst_mask] = split_color\n    return dst, src, dst_widths\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = random.randint(*GRID_SIZE_RANGE)\n    layout = _gen_pick_layout(n)\n    if layout is None:\n        return None\n    rect_h, rect_w, rect_top, nonsplit_h, nonsplit_top = layout\n\n    colors = list(PALETTE_COLORS)\n    bg = random.choice(colors)\n    colors.remove(bg)\n    split_color, nonsplit_color = random.sample(colors, 2)\n    min_dst_width = max(MIN_ROW_WIDTH, 2 * rect_w - n + SOURCE_RIGHT_PAD)\n    if min_dst_width > rect_w - DST_WIDTH_RESERVED_COLS:\n        return None\n\n    dst, src, dst_widths = _gen_split_patches(rect_h, rect_w, min_dst_width, split_color, bg)\n    nonsplit = _gen_right_shape_with_max_width(\n        nonsplit_h,\n        rect_w,\n        max(dst_widths),\n        nonsplit_color,\n        bg,\n    )\n    split_area = rect_h * rect_w\n    nonsplit_area = int(np.count_nonzero(nonsplit == nonsplit_color))\n    bg_area = n * n - split_area - nonsplit_area\n    if bg_area <= max(split_area, nonsplit_area):\n        return None\n\n    rect_left = n - rect_w\n    out = np.full((n, n), bg, dtype=int)\n    out[rect_top : rect_top + rect_h, rect_left:n] = split_color\n    out[nonsplit_top : nonsplit_top + nonsplit_h, rect_left:n] = nonsplit\n\n    inp = out.copy()\n    inp[rect_top : rect_top + rect_h, rect_left:n] = bg\n    inp[rect_top : rect_top + rect_h, rect_left:n] = dst\n    # Opaque paste of src preserves the original small-canvas overlap behavior.\n    inp[rect_top : rect_top + rect_h, 0:rect_w] = src\n\n    try:\n        produced = main(inp)\n    except AssertionError:\n        return None\n    if not np.array_equal(produced, out):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid fe45cba4 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/8dab14c2.py\"","aggregated_output":"from collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import colors_present, get_bg, in_bounds\nimport random\n\n\nDIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _runs(line: np.ndarray) -> list[tuple[int, int]]:\n    runs: list[tuple[int, int]] = []\n    start: int | None = None\n    for i, v in enumerate(line):\n        if bool(v) and start is None:\n            start = i\n        if start is not None and (not bool(v) or i == len(line) - 1):\n            end = i - 1 if not bool(v) else i\n            runs.append((start, end))\n            start = None\n    return runs\n\n\ndef _body_thickness(mask: np.ndarray) -> int:\n    lengths: list[int] = []\n    for r in range(mask.shape[0]):\n        lengths.extend(e - s + 1 for s, e in _runs(mask[r]) if e - s + 1 >= 2)\n    for c in range(mask.shape[1]):\n        lengths.extend(e - s + 1 for s, e in _runs(mask[:, c]) if e - s + 1 >= 2)\n\n    assert lengths, \"foreground object must contain runs wider than one pixel\"\n    counts = Counter(lengths)\n    max_count = max(counts.values())\n    return min(length for length, count in counts.items() if count == max_count)\n\n\ndef _fg_neighbors4(mask: np.ndarray, r: int, c: int) -> list[tuple[int, int]]:\n    return [\n        (dr, dc)\n        for dr, dc in DIRS4\n        if in_bounds(mask.shape, r + dr, c + dc) and bool(mask[r + dr, c + dc])\n    ]\n\n\ndef _n8(mask: np.ndarray, r: int, c: int) -> int:\n    count = 0\n    for dr in (-1, 0, 1):\n        for dc in (-1, 0, 1):\n            if dr == 0 and dc == 0:\n                continue\n            if in_bounds(mask.shape, r + dr, c + dc) and bool(mask[r + dr, c + dc]):\n                count += 1\n    return count\n\n\ndef _ray_len(mask: np.ndarray, r: int, c: int, dr: int, dc: int) -> int:\n    length = 0\n    rr, cc = r, c\n    while in_bounds(mask.shape, rr, cc) and bool(mask[rr, cc]):\n        length += 1\n        rr += dr\n        cc += dc\n    return length\n\n\ndef _opposite_edge(mask: np.ndarray, r: int, c: int, dr: int, dc: int) -> tuple[int, int]:\n    if dr:\n        rows = np.flatnonzero(mask[:, c])\n        assert rows.size, \"tab column must contain foreground\"\n        return int(rows.max() if dr > 0 else rows.min()), c\n\n    cols = np.flatnonzero(mask[r])\n    assert cols.size, \"tab row must contain foreground\"\n    return r, int(cols.max() if dc > 0 else cols.min())\n\n\ndef _outside_opposite_edge(\n    mask: np.ndarray, r: int, c: int, dr: int, dc: int\n) -> tuple[int, int] | None:\n    if dr:\n        rows = np.flatnonzero(mask[:, c])\n        assert rows.size, \"notch column must contain foreground\"\n        rr = int(rows.max() + 1 if dr > 0 else rows.min() - 1)\n        return (rr, c) if in_bounds(mask.shape, rr, c) else None\n\n    cols = np.flatnonzero(mask[r])\n    assert cols.size, \"notch row must contain foreground\"\n    cc = int(cols.max() + 1 if dc > 0 else cols.min() - 1)\n    return (r, cc) if in_bounds(mask.shape, r, cc) else None\n\n\ndef _tab_sources(mask: np.ndarray) -> list[tuple[tuple[int, int], tuple[int, int], tuple[int, int]]]:\n    thickness = _body_thickness(mask)\n    long_ray_threshold = 2 * thickness - 1\n    tabs: list[tuple[tuple[int, int], tuple[int, int], tuple[int, int]]] = []\n\n    for r in range(mask.shape[0]):\n        for c in range(mask.shape[1]):\n            if not bool(mask[r, c]):\n                continue\n\n            neighbors = _fg_neighbors4(mask, r, c)\n            if len(neighbors) != 1:\n                continue\n\n            dr, dc = neighbors[0]\n            length = _ray_len(mask, r, c, dr, dc)\n            has_side_support = _n8(mask, r, c) >= 3\n            crosses_long_body = length > long_ray_threshold\n            if length >= 3 and (has_side_support or crosses_long_body):\n                target = _opposite_edge(mask, r, c, dr, dc)\n                assert target != (r, c), \"tab must project to the opposite side\"\n                tabs.append(((r, c), (dr, dc), target))\n\n    return tabs\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Complete each boundary tab or notch by adding the complementary feature on the opposite side of the foreground object.\n\n    Input structure\n    - The grid has exactly two colors: a dominant background and one foreground object.\n    - The foreground object is a thick rectilinear shape with one-pixel tabs and notches on its boundary.\n\n    Rule\n    - A foreground tab is a one-neighbor boundary pixel; project through its full row or column span and remove the opposite edge pixel to make a matching notch.\n    - A background notch is a one-pixel cut with three foreground 4-neighbors; project across the full row or column span and add a tab just outside the opposite edge.\n    - Notches immediately beside a tab source are not independent sources, because that gap belongs to the tab's local boundary shape.\n\n    Key insight\n    - The changed pixels are not color-specific noise; they are paired jigsaw-like boundary features on opposite sides of the same thick row or column cross-section.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = colors_present(g)\n    assert len(colors) == 2, \"task expects exactly one foreground color and one background\"\n    fg_colors = [color for color in colors if color != bg]\n    assert len(fg_colors) == 1, \"task expects a single foreground color\"\n    fg = fg_colors[0]\n\n    mask = g == fg\n    out = g.copy()\n\n    tabs = _tab_sources(mask)\n    tab_cells = {cell for cell, _direction, _target in tabs}\n    changes = 0\n\n    for _cell, _direction, target in tabs:\n        if out[target] != bg:\n            out[target] = bg\n            changes += 1\n\n    for r in range(g.shape[0]):\n        for c in range(g.shape[1]):\n            if bool(mask[r, c]):\n                continue\n\n            fg_dirs: list[tuple[int, int]] = []\n            bg_dirs: list[tuple[int, int]] = []\n            for dr, dc in DIRS4:\n                rr, cc = r + dr, c + dc\n                if in_bounds(mask.shape, rr, cc) and bool(mask[rr, cc]):\n                    fg_dirs.append((dr, dc))\n                else:\n                    bg_dirs.append((dr, dc))\n\n            if len(fg_dirs) != 3 or len(bg_dirs) != 1:\n                continue\n\n            outside_dr, outside_dc = bg_dirs[0]\n            dr, dc = -outside_dr, -outside_dc\n            side_a = (r - dc, c + dr)\n            side_b = (r + dc, c - dr)\n            if side_a in tab_cells or side_b in tab_cells:\n                continue\n\n            target = _outside_opposite_edge(mask, r, c, dr, dc)\n            if target is not None and not bool(mask[target]):\n                if out[target] != fg:\n                    out[target] = fg\n                    changes += 1\n\n    assert changes > 0, \"at least one complementary boundary feature must be produced\"\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_BG = 8\n_GEN_FG = 1\n_GEN_DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n# Canvas and placement bounds.\n_GEN_ROWS_RANGE = (13, 16)\n_GEN_COLS_RANGE = (15, 17)\n_GEN_MARGIN = 1\n\n# Clean L-shape arm bounds.\n_GEN_H_THICK_RANGE = (3, 5)\n_GEN_V_WIDTH_RANGE = (3, 6)\n_GEN_V_EXTRA_RANGE = (4, 10)\n_GEN_H_WIDTH_RANGE = (11, 14)\n_GEN_MAX_BODY_HEIGHT = 14\n_GEN_MIN_MODE_GAP = 2\n_GEN_MISSING_CORNERS = (\"TL\", \"TR\", \"BL\", \"BR\")\n\n# Boundary source feature counts.\n_GEN_PAIR_COUNT_RANGE = (1, 3)\n_GEN_MAX_TABS = 4\n\n# Retry limits.\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:\n    return 0 <= r < shape[0] and 0 <= c < shape[1]\n\n\ndef _gen_has_tangent_support(mask: np.ndarray, r: int, c: int, dr: int, dc: int) -> bool:\n    if dr:\n        sides = ((r, c - 1), (r, c + 1))\n    else:\n        sides = ((r - 1, c), (r + 1, c))\n    return all(_gen_in_bounds(mask.shape, rr, cc) and bool(mask[rr, cc]) for rr, cc in sides)\n\n\ndef _gen_line_edges(mask: np.ndarray, r: int, c: int, dr: int, dc: int) -> tuple[tuple[int, int], tuple[int, int]] | None:\n    if dr:\n        rows = np.flatnonzero(mask[:, c])\n        if rows.size == 0:\n            return None\n        near_r = int(rows.min() if dr > 0 else rows.max())\n        far_r = int(rows.max() if dr > 0 else rows.min())\n        return (near_r, c), (far_r, c)\n\n    cols = np.flatnonzero(mask[r])\n    if cols.size == 0:\n        return None\n    near_c = int(cols.min() if dc > 0 else cols.max())\n    far_c = int(cols.max() if dc > 0 else cols.min())\n    return (r, near_c), (r, far_c)\n\n\ndef _gen_feature_slots(mask: np.ndarray) -> list[dict]:\n    slots: list[dict] = []\n    for r in range(mask.shape[0]):\n        for c in range(mask.shape[1]):\n            if not bool(mask[r, c]):\n                continue\n            for dr, dc in _GEN_DIRS4:\n                outside_r, outside_c = r - dr, c - dc\n                if not _gen_in_bounds(mask.shape, outside_r, outside_c):\n                    continue\n                if bool(mask[outside_r, outside_c]):\n                    continue\n\n                edges = _gen_line_edges(mask, r, c, dr, dc)\n                if edges is None or edges[0] != (r, c):\n                    continue\n                near, far = edges\n","exit_code":0,"status":"completed"}}
