{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/e3721c99.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, is_contiguous, neighbors4, paste\nimport itertools\nimport random\n\n\ndef _hole_count(mask: np.ndarray) -> int:\n    \"\"\"\n    Count holes in a binary mask using 4-connectivity.\n    A hole is a background component that does not touch the mask's bounding box border.\n    \"\"\"\n    h, w = mask.shape\n    bg = ~mask\n    vis = np.zeros((h, w), dtype=bool)\n    holes = 0\n    for r0 in range(h):\n        for c0 in range(w):\n            if not bg[r0, c0] or vis[r0, c0]:\n                continue\n            st = [(r0, c0)]\n            vis[r0, c0] = True\n            touches = False\n            while st:\n                r, c = st.pop()\n                if r == 0 or c == 0 or r == h - 1 or c == w - 1:\n                    touches = True\n                for rr, cc in neighbors4(r, c):\n                    if 0 <= rr < h and 0 <= cc < w and bg[rr, cc] and not vis[rr, cc]:\n                        vis[rr, cc] = True\n                        st.append((rr, cc))\n            if not touches:\n                holes += 1\n    return holes\n\n\ndef _legend_mapping(g: np.ndarray, bg: int, grey: int) -> dict[int, int]:\n    \"\"\"\n    Pick one 'legend' component per non-(bg,grey) color:\n      - component is at least 2x2,\n      - component does not touch the outer grid border (filters dividers).\n    Map hole_count -> legend_color.\n    \"\"\"\n    h, w = g.shape\n    mapping: dict[int, int] = {}\n    colors = [c for c in sorted(set(map(int, np.unique(g)))) if c not in (bg, grey)]\n    for c in colors:\n        comps = components_mask(g == c, connectivity=4)\n        candidates = []\n        for pts in comps:\n            r0, c0, r1, c1 = bbox_coords(pts)\n            if r0 == 0 or c0 == 0 or r1 == h - 1 or c1 == w - 1:\n                continue\n            if (r1 - r0 + 1) < 2 or (c1 - c0 + 1) < 2:\n                continue\n            candidates.append((r0, c0, r1, c1))\n        if not candidates:\n            continue\n        assert len(candidates) == 1, f\"color {c} must have exactly one legend component\"\n        r0, c0, r1, c1 = candidates[0]\n        sub = (g[r0 : r1 + 1, c0 : c1 + 1] == c)\n        hc = _hole_count(sub)\n        assert hc not in mapping, f\"legend hole count {hc} must map to exactly one color\"\n        mapping[hc] = c\n    return mapping\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor grey shapes by matching their hole count to a color legend.\n\n    Input structure:\n    - bg = most common color; grey (5) sprites scattered across the grid.\n    - Colored legend shapes (non-bg, non-grey, at least 2×2, not touching the outer border) near grid edge,\n      each with a distinct number of enclosed holes.\n\n    Rule:\n    - Each colored legend shape defines a mapping: hole count → color.\n    - For every grey sprite, count its holes (enclosed bg regions not touching the sprite's bounding-box border).\n    - Recolor the grey sprite to the matching legend color; erase grey distractors with unlisted hole counts.\n\n    Key insight: Shape identity is encoded by topology (number of holes), not geometry or size.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    grey = 5\n\n    legend = _legend_mapping(g, bg, grey)\n    assert legend, \"legend mapping must be non-empty: grid must contain colored legend shapes\"\n\n    out = g.copy()\n    for pts in components_mask(g == grey, connectivity=4):\n        r0, c0, r1, c1 = bbox_coords(pts)\n        sub = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)\n        for r, c in pts:\n            sub[r - r0, c - c0] = True\n        hc = _hole_count(sub)\n        newc = int(legend[hc]) if hc in legend else bg\n        for r, c in pts:\n            out[r, c] = newc\n\n    return out\n\n# --------------- generator (holes-first organic blob) ---------------\n\nfrom arc_utils import label_mask\nfrom scipy.ndimage import binary_dilation, generate_binary_structure\n\n# -- palette & grid --\nBG = 0\nDIV = 1\nGREY = 5\nGRID_SIZE = 30\nLEGEND_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]\n\n# -- legend panel --\nLEGEND_COUNT_RANGE = (2, 4)         # number of legend entries\nMAX_HOLE_COUNT = 6                  # hole values drawn from range(MAX_HOLE_COUNT)\nPANEL_SIZE_RANGE = (5, 8)           # panel thickness (cross-axis)\nFULL_LAYOUT_MAX_SPAN = 28          # max legend line span for full-row/col layouts\nL_LAYOUT_MAX_SPAN = 24            # max legend line span for L-shaped layouts\nL_LAYOUT_EXTRA_PADDING = 3        # max random padding along the L arm\n\n# -- sprites --\nTOTAL_SPRITES_RANGE = (8, 11)       # total sprites (matches + distractors)\nMAX_DISTRACTORS = 7                 # max distractor sprites\nMAX_EXTRA_PER_LEGEND = 2            # max extra match sprites per legend entry\nSPRITE_RETRIES = 30                 # retries per sprite generation attempt\nSPRITE_AREA_0 = (5, 25)              # (min, max) area for 0-hole sprites\nSPRITE_AREA_LOW_MIN = 8              # min area for 1-2 hole sprites (max = 25+10*h)\n# 3+ hole sprites: min = 10+2*h, max = 20+4*h\nCANVAS_SCALE = 1.2                  # sqrt(area) multiplier for canvas size\nCANVAS_MIN = 5                      # minimum canvas dimension\nCANVAS_PAD = 2                      # padding added to scaled sqrt for canvas\nHOLE_SEED_RADIUS_FACTOR = 0.45      # radius = factor * sqrt(area)\nHOLE_SEED_MIN_RADIUS = 2\nHOLE_SEED_MIN_SEP = 2               # minimum Chebyshev distance between hole seeds\nHOLE_SEED_MARGIN = 2                # margin from canvas edge for hole seeds\nSEAL_ITERS = 5                      # max iterations for sealing forbidden cells\nSPRITE_MAX_H = 12                   # max sprite bbox height\nSPRITE_MAX_W = 18                   # max sprite bbox width\nSPRITE_MAX_ASPECT = 2.5             # max aspect ratio (max_dim / min_dim)\n\n# -- generation --\nGEN_RETRIES = 300                   # outer retries for generate_input()\n\n# 8-connectivity structuring element for dilation\n_STRUCT8 = generate_binary_structure(2, 2)\n\n\n# ---------- legend helpers ----------\n\ndef _legend_span(hole_count: int) -> int:\n    \"\"\"Width (or height) of a single legend patch along the arrangement axis.\"\"\"\n    return 3 if hole_count == 0 else 2 * hole_count + 1\n\n\ndef _legend_patch(hole_count: int, color: int, arrangement: str) -> np.ndarray:\n    \"\"\"Build a 3xSpan (horizontal) or Spanx3 (vertical) legend patch.\"\"\"\n    span = _legend_span(hole_count)\n    if arrangement == \"horizontal\":\n        patch = np.full((3, span), int(color), dtype=int)\n        if hole_count:\n            patch[1, 1::2] = BG\n    else:\n        patch = np.full((span, 3), int(color), dtype=int)\n        if hole_count:\n            patch[1::2, 1] = BG\n    return patch\n\n\ndef _line_span(legends: list[tuple[int, int]]) -> int:\n    \"\"\"Total span of legend patches plus 1-cell gaps between them.\"\"\"\n    return sum(_legend_span(h) for h, _ in legends) + len(legends) - 1\n\n\ndef _choose_legends(arrangement: str, max_span: int) -> list[tuple[int, int]]:\n    \"\"\"Pick 2-4 legends with distinct hole counts that fit within max_span.\"\"\"\n    count = random.randint(*LEGEND_COUNT_RANGE)\n    combos = [holes for holes in itertools.combinations(range(MAX_HOLE_COUNT), count)\n              if sum(_legend_span(h) for h in holes) + count - 1 <= max_span]\n    if not combos:\n        return _choose_legends(arrangement, max_span + 2)\n    holes = list(random.choice(combos))\n    random.shuffle(holes)\n    colors = random.sample(LEGEND_COLORS, count)\n    return list(zip(holes, colors))\n\n\ndef _place_legend_line(\n    grid: np.ndarray, legends: list[tuple[int, int]], arrangement: str, r: int, c: int\n) -> None:\n    \"\"\"Paste legend patches sequentially along the arrangement axis.\"\"\"\n    rr, cc = int(r), int(c)\n    for hole_count, color in legends:\n        patch = _legend_patch(hole_count, color, arrangement)\n        paste(grid, patch, rr, cc)\n        if arrangement == \"horizontal\":\n            cc += patch.shape[1] + 1\n        else:\n            rr += patch.shape[0] + 1\n\n\n# ---------- layout helpers ----------\n\ndef _layout_full_horizontal(grid: np.ndarray, blocked: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Place a full-row horizontal divider with legend panel above or below.\"\"\"\n    legends = _choose_legends(\"horizontal\", FULL_LAYOUT_MAX_SPAN)\n    total = _line_span(legends)\n    panel_h = random.randint(*PANEL_SIZE_RANGE)\n    top = random.choice([True, False])\n    c0 = random.randint(1, GRID_SIZE - 1 - total)\n    if top:\n        div_r = panel_h\n        grid[div_r, :] = DIV\n        blocked[: div_r + 1, :] = 9\n        r0 = random.randint(1, panel_h - 4)\n    else:\n        div_r = GRID_SIZE - 1 - panel_h\n        grid[div_r, :] = DIV\n        blocked[div_r:, :] = 9\n        r0 = random.randint(div_r + 2, GRID_SIZE - 4)\n    _place_legend_line(grid, legends, \"horizontal\", r0, c0)\n    return legends\n\n\ndef _layout_full_vertical(grid: np.ndarray, blocked: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Place a full-column vertical divider with legend panel left or right.\"\"\"\n    legends = _choose_legends(\"vertical\", FULL_LAYOUT_MAX_SPAN)\n    total = _line_span(legends)\n    panel_w = random.randint(*PANEL_SIZE_RANGE)\n    left = random.choice([True, False])\n    r0 = random.randint(1, GRID_SIZE - 1 - total)\n    if left:\n        div_c = panel_w\n        grid[:, div_c] = DIV\n        blocked[:, : div_c + 1] = 9\n        c0 = random.randint(1, panel_w - 4)\n    else:\n        div_c = GRID_SIZE - 1 - panel_w\n        grid[:, div_c] = DIV\n        blocked[:, div_c:] = 9\n        c0 = random.randint(div_c + 2, GRID_SIZE - 4)\n    _place_legend_line(grid, legends, \"vertical\", r0, c0)\n    return legends\n\n\ndef _l_corner_geometry(corner: str, panel_h: int, panel_w: int,\n                       arrangement: str, total: int) -> tuple:\n    \"\"\"Compute divider pivot and legend placement bounds for an L-corner.\n\n    Returns (dr, dc, r_min, r_max, c_min, c_max) where (dr, dc) is the corner\n    pivot of the L-divider and the remaining values bound the legend origin.\n    \"\"\"\n    N = GRID_SIZE\n    cross_dim = 3 if arrangement == \"horizontal\" else total\n    along_dim = total if arrangement == \"horizontal\" else 3\n\n    if corner == \"tl\":\n        dr, dc = panel_h, panel_w\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, neighbors4\n\n\ndef _legend_directions(g: np.ndarray, bg: int) -> dict[int, tuple[int, int]]:\n    \"\"\"\n    Detect legend blocks on the border.\n\n    A legend is a border-touching non-background component whose most common color is the legend\n    background `C` (and also the region border color it controls). The legend contains at least\n    two additional colors: a \"center\" color (more frequent) and an \"indicator\" color (less frequent).\n\n    The movement direction for regions with border color `C` is:\n      sign(centroid(indicator) - centroid(center))\n    \"\"\"\n    h, w = g.shape\n    non_bg = g != bg\n    best: dict[int, tuple[int, tuple[int, int]]] = {}\n    for pts in components_mask(non_bg, connectivity=4):\n        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue\n        # Legends are filled rectangles on the border.\n        r0, c0, r1, c1 = bbox_coords(pts)\n        area = (r1 - r0 + 1) * (c1 - c0 + 1)\n        if area != len(pts):\n            continue\n\n        counts: dict[int, int] = {}\n        for r, c in pts:\n            v = int(g[r, c])\n            counts[v] = counts.get(v, 0) + 1\n        if len(counts) != 3:\n            continue\n\n        bg_col = max(counts, key=counts.get)\n        others = [(cnt, col) for col, cnt in counts.items() if col != bg_col]\n        if len(others) < 2:\n            continue\n        others.sort()  # ascending by count\n        if others[0][0] == others[1][0]:\n            # Tie: choose center as the color closer to the rectangle center.\n            rc = np.array([(r0 + r1) / 2.0, (c0 + c1) / 2.0])\n            cols = [others[0][1], others[1][1]]\n            cents = []\n            for col in cols:\n                pts_col = np.array([(r, c) for r, c in pts if int(g[r, c]) == col], dtype=float)\n                cents.append((np.sum((pts_col.mean(axis=0) - rc) ** 2), col))\n            cents.sort()\n            center_col = cents[0][1]\n            indicator_col = cents[1][1]\n        else:\n            indicator_col = others[0][1]\n            center_col = others[-1][1]\n\n        center = [(r, c) for r, c in pts if int(g[r, c]) == center_col]\n        indic = [(r, c) for r, c in pts if int(g[r, c]) == indicator_col]\n        if not center or not indic:\n            continue\n\n        cc = np.mean(np.array(center, dtype=float), axis=0)\n        ci = np.mean(np.array(indic, dtype=float), axis=0)\n        vr, vc = (ci - cc).tolist()\n        dr = 0 if abs(vr) < 1e-6 else (1 if vr > 0 else -1)\n        dc = 0 if abs(vc) < 1e-6 else (1 if vc > 0 else -1)\n        if dr == 0 and dc == 0:\n            continue\n\n        prev = best.get(bg_col)\n        if prev is None or len(pts) > prev[0]:\n            best[bg_col] = (len(pts), (dr, dc))\n\n    return {k: v for k, (_, v) in best.items()}\n\n\ndef _slide_points(region_set: set[tuple[int, int]], points: list[tuple[int, int]], dr: int, dc: int) -> list[tuple[int, int]]:\n    if not points:\n        return []\n    # Process from the far end (closest to destination boundary) inward.\n    points_sorted = sorted(points, key=lambda p: (dr * p[0] + dc * p[1], p[0], p[1]), reverse=True)\n    occupied = set()\n    out_pts = []\n    for r0, c0 in points_sorted:\n        r, c = r0, c0\n        while True:\n            nr, nc = r + dr, c + dc\n            if (nr, nc) not in region_set:\n                break\n            # For diagonal steps, disallow \"corner cutting\": both orthogonal intermediates must be inside the region.\n            if dr != 0 and dc != 0:\n                if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n                    break\n            if (nr, nc) in occupied:\n                break\n            r, c = nr, nc\n        occupied.add((r, c))\n        out_pts.append((r, c))\n    return out_pts\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n    if (dr, dc) == (-1, 1): return np.flipud(g)\n    if (dr, dc) == (1, -1): return np.fliplr(g)\n    if (dr, dc) == (-1, -1): return np.rot90(g, 2)\n    raise ValueError((dr, dc))\n\n\ndef _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:\n    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n    if corner == 'TL': return 0, 0\n    if corner == 'TR': return 0, w - pw\n    if corner == 'BL': return h - ph, 0\n    if corner == 'BR': return h - ph, w - pw\n    raise ValueError(corner)\n\n\n# ── Blob growing / topology ──────────────────────────────────────\n\ndef _grow_blob(canvas_mask: np.ndarray, seed: tuple[int, int], target_size: int,\n               rng: random.Random) -> set[tuple[int, int]] | None:\n    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n    h, w = canvas_mask.shape\n    sr, sc = seed\n    if not canvas_mask[sr, sc]:\n        return None\n    blob = {(sr, sc)}\n    frontier = []\n    def push_neighbors(r, c):\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and canvas_mask[nr, nc] and (nr, nc) not in blob:\n                frontier.append((nr, nc))\n    push_neighbors(sr, sc)\n    while len(blob) < target_size and frontier:\n        idx = rng.randrange(len(frontier))\n        r, c = frontier.pop(idx)\n        if (r, c) in blob or not canvas_mask[r, c]:\n            continue\n        blob.add((r, c))\n        push_neighbors(r, c)\n    if len(blob) < target_size:\n        return None\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/5623160b.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/5623160b.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg\nimport random\n\n\nMARKER_COLOR = 9\nDIRECTIONS = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _outward_direction(g: np.ndarray, coords: np.ndarray) -> tuple[int, int]:\n    H, W = g.shape\n    directions: set[tuple[int, int]] = set()\n    for r, c in coords:\n        rr = int(r)\n        cc = int(c)\n        for dr, dc in DIRECTIONS:\n            nr = rr + dr\n            nc = cc + dc\n            if 0 <= nr < H and 0 <= nc < W and int(g[nr, nc]) == MARKER_COLOR:\n                directions.add((-dr, -dc))\n\n    assert len(directions) == 1, \"each moving object must touch maroon markers on exactly one side\"\n    return directions.pop()\n\n\ndef _steps_to_edge(shape: tuple[int, int], coords: np.ndarray, direction: tuple[int, int]) -> int:\n    H, W = shape\n    dr, dc = direction\n    assert (dr == 0) != (dc == 0), \"movement direction must be cardinal\"\n    if dr < 0:\n        return int(coords[:, 0].min())\n    if dr > 0:\n        return int(H - 1 - coords[:, 0].max())\n    if dc < 0:\n        return int(coords[:, 1].min())\n    assert dc > 0\n    return int(W - 1 - coords[:, 1].max())\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Push every colored object touching maroon markers straight outward until it reaches the grid edge.\n\n    Input structure:\n    - The background is the dominant color.\n    - Maroon pixels are fixed markers.\n    - Every other foreground 4-connected object touches the marker pixels on exactly one cardinal side.\n\n    Rule:\n    - Clear each non-background, non-maroon object from its original position.\n    - Translate it in the direction away from its maroon contact until the object reaches the grid boundary.\n    - Keep the maroon marker pixels unchanged.\n\n    Key insight:\n    - The maroon contact side is a launcher: it determines a unique outward ray for the whole object, and the edge of the grid determines the translation distance.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg != MARKER_COLOR\n    assert bool(np.any(g == MARKER_COLOR))\n\n    marker_components = find_components(\n        g,\n        bg=bg,\n        connectivity=4,\n        monochromatic=True,\n        colors=[MARKER_COLOR],\n        return_format=\"dict\",\n    )\n    assert 1 <= len(marker_components) <= 3, \"maroon markers must form 1-3 moderate components\"\n    assert sum(int(comp[\"area\"]) for comp in marker_components) <= 17, \"maroon marker area must be moderate\"\n    assert all(int(comp[\"area\"]) <= 9 for comp in marker_components), \"each maroon component must be moderate\"\n\n    out = g.copy()\n    placements: list[tuple[int, np.ndarray]] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        color = int(comp[\"color\"])\n        if color == MARKER_COLOR:\n            continue\n\n        coords = comp[\"coords\"].astype(int, copy=False)\n        direction = _outward_direction(g, coords)\n        steps = _steps_to_edge(g.shape, coords, direction)\n        assert steps <= 8, \"push distance must stay within the observed moderate range\"\n        offset = np.array(direction, dtype=int) * steps\n        shifted = coords + offset\n        assert bool(\n            np.all(\n                (0 <= shifted[:, 0])\n                & (shifted[:, 0] < g.shape[0])\n                & (0 <= shifted[:, 1])\n                & (shifted[:, 1] < g.shape[1])\n            )\n        )\n        own = {tuple(coord) for coord in coords.tolist()}\n        for step in range(1, steps + 1):\n            swept = coords + np.array(direction, dtype=int) * step\n            for rr, cc in swept:\n                loc = (int(rr), int(cc))\n                assert loc in own or int(g[loc]) == bg, \"object movement path must be unobstructed\"\n\n        out[coords[:, 0], coords[:, 1]] = bg\n        placements.append((color, shifted))\n\n    assert placements\n    for color, coords in placements:\n        assert bool(np.all(out[coords[:, 0], coords[:, 1]] == bg)), \"moved objects must not collide\"\n        out[coords[:, 0], coords[:, 1]] = color\n\n    return out\n\n# --------------- generator (attempt 1 refined) ---------------\n\n# Generated grid colors.\nBG = 7\nMAROON = 9\nALL_COLORS = [0, 1, 2, 3, 4, 5, 6, 8]\nDIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n# Canvas and maroon marker bounds.\nGRID_SIZE_MIN = 9\nGRID_SIZE_MAX = 16\nMAROON_COMPONENT_MIN = 1\nMAROON_COMPONENT_MAX = 3\nMAROON_TOTAL_AREA_MAX = 17\nMAROON_COMPONENT_AREA_MAX = 9\nINTERIOR_PADDING = 1\nMAROON_PLACEMENT_TRIES = 80\n\n# Moving object bounds and push constraints.\nOBJECT_COUNT_MIN = 3\nOBJECT_COUNT_MAX = 7\nOBJECT_SIZE_MIN = 1\nOBJECT_SIZE_MAX = 5\nPUSH_DISTANCE_MAX = 8\nZERO_STEP_PROBABILITY = 0.25\nZERO_STEP_ALLOWANCE = 1\n\n# Retry limits for object placement and whole-grid generation.\nOBJECT_SHAPE_TRIES = 20\nCONTACT_CANDIDATE_LIMIT = 5\nGENERATE_RETRIES = 300\n\n\ndef _grow_polyomino(size, rng):\n    \"\"\"Grow a 4-connected polyomino of given size, normalized to (0, 0).\"\"\"\n    cells = {(0, 0)}\n    frontier = [(0, 0)]\n    while len(cells) < size:\n        r, c = rng.choice(frontier)\n        nbrs = [(r-1, c), (r+1, c), (r, c-1), (r, c+1)]\n        rng.shuffle(nbrs)\n        grown = False\n        for nr, nc in nbrs:\n            if (nr, nc) not in cells:\n                cells.add((nr, nc))\n                frontier.append((nr, nc))\n                grown = True\n                break\n        if not grown:\n            frontier.remove((r, c))\n            if not frontier:\n                break\n\n    min_r = min(r for r, c in cells)\n    min_c = min(c for r, c in cells)\n    return [(r - min_r, c - min_c) for r, c in cells]\n\n\ndef _gen_steps_to_edge(N, coords, direction):\n    arr = np.array(coords, dtype=int)\n    dr, dc = direction\n    if dr == -1:\n        return int(arr[:, 0].min())\n    if dr == 1:\n        return int(N - 1 - arr[:, 0].max())\n    if dc == -1:\n        return int(arr[:, 1].min())\n    return int(N - 1 - arr[:, 1].max())\n\n\ndef _swept_cells(N, coords, direction):\n    dr, dc = direction\n    steps = _gen_steps_to_edge(N, coords, direction)\n    own = set(coords)\n    swept = set()\n    for step in range(1, steps + 1):\n        for r, c in coords:\n            loc = (r + dr * step, c + dc * step)\n            if loc not in own:\n                swept.add(loc)\n    return swept\n\n\ndef _paths_are_clear(inp, objects):\n    N = inp.shape[0]\n    for _, inp_coords, _, direction in objects:\n        for r, c in _swept_cells(N, inp_coords, direction):\n            if inp[r, c] != BG:\n                return False\n    return True\n\n\ndef _paint_cells(grid, coords, color):\n    for r, c in coords:\n        grid[r, c] = color\n\n\ndef _place_maroon_components(rng, grid, num_maroon):\n    \"\"\"Place separated maroon components; returns (components, occupied) or None.\"\"\"\n    N = grid.shape[0]\n    maroon_components = []\n    all_maroon = set()\n    total_maroon = 0\n\n    for idx in range(num_maroon):\n        remaining_components = num_maroon - idx - 1\n        max_size = min(\n            MAROON_COMPONENT_AREA_MAX,\n            MAROON_TOTAL_AREA_MAX - total_maroon - remaining_components,\n        )\n        if max_size < 1:\n            return None\n\n        size = rng.randint(1, max_size)\n        cells = _grow_polyomino(size, rng)\n        h = max(r for r, c in cells) + 1\n        w = max(c for r, c in cells) + 1\n        if h > N - 2 or w > N - 2:\n            return None\n\n        placed = _try_place_maroon_component(rng, grid, cells, all_maroon)\n        if placed is None:\n            return None\n\n        _paint_cells(grid, placed, MAROON)\n        maroon_components.append(placed)\n        all_maroon.update(placed)\n        total_maroon += size\n\n    return maroon_components, all_maroon\n\n\ndef _try_place_maroon_component(rng, grid, cells, all_maroon):\n    N = grid.shape[0]\n    h = max(r for r, c in cells) + 1\n    w = max(c for r, c in cells) + 1\n    for _ in range(MAROON_PLACEMENT_TRIES):\n        r0 = rng.randint(INTERIOR_PADDING, N - INTERIOR_PADDING - h)\n        c0 = rng.randint(INTERIOR_PADDING, N - INTERIOR_PADDING - w)\n        abs_cells = [(r + r0, c + c0) for r, c in cells]\n        if not all(grid[r, c] == BG for r, c in abs_cells):\n            continue\n        if any((r + dr, c + dc) in all_maroon for r, c in abs_cells for dr, dc in DIRS):\n            continue\n        return abs_cells\n    return None\n","exit_code":0,"status":"completed"}}
