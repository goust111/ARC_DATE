{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/fc7cae8d.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import crop_bbox, find_components, get_bg, paste, random_free_location\nimport random\nfrom arc_utils import paste, random_free_location\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Align a central rectangle to two colored frame-edge controls via rotation/reflection.\n\n    Input structure:\n    - bg grid with two solid-colored border edges (distinct non-bg colors).\n    - A central filled rectangle with 1px colored guide edges on two sides, colors matching the frame controls.\n\n    Rule:\n    - Rotate/mirror the object so its guide edges face the same sides as the matching frame controls.\n    - Crop off the 1px guide edges from aligned sides.\n\n    Key insight: Guide-edge colors encode target frame sides; the correct dihedral transform matches both simultaneously.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    def detect_controls_frame(arr: np.ndarray) -> list[tuple[str, int]]:\n        H, W = arr.shape\n        sides = {\n            \"top\": arr[0, 1:-1],\n            \"bottom\": arr[-1, 1:-1],\n            \"left\": arr[1:-1, 0],\n            \"right\": arr[1:-1, -1],\n        }\n        cand: list[tuple[str, int, int, int]] = []\n        for side, v in sides.items():\n            v = list(map(int, v))\n            v_nb = [x for x in v if x != int(bg)]\n            if not v_nb:\n                continue\n            col, count = Counter(v_nb).most_common(1)[0]\n            # allow up to 1 mismatch (overlap near corners with the other control color)\n            if int(count) >= len(v) - 1:\n                cand.append((side, int(col), int(count), int(len(v))))\n        cand.sort(key=lambda t: (t[2] / t[3], t[2]), reverse=True)\n        return [(s, c) for s, c, _cnt, _L in cand[:2]]\n\n    def extract_center_object(arr: np.ndarray) -> np.ndarray:\n        H, W = arr.shape\n        comps = find_components(arr, bg=int(bg), connectivity=4, monochromatic=False, return_format=\"dict\")\n        best = None  # (area, bbox)\n        for comp in comps:\n            r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n            if bool(r0 == 0 or c0 == 0 or r1 == H - 1 or c1 == W - 1):\n                continue\n            area = int(comp[\"area\"])\n            if best is None or area > best[0]:\n                best = (area, (r0, c0, r1, c1))\n        if best is None:\n            return arr.copy()\n        _area, b = best\n        return crop_bbox(arr, b)\n\n    def guide_edges(arr: np.ndarray) -> dict[str, int]:\n        fill = int(Counter(map(int, arr.flatten())).most_common(1)[0][0])\n        edges = {\n            \"top\": arr[0, :],\n            \"bottom\": arr[-1, :],\n            \"left\": arr[:, 0],\n            \"right\": arr[:, -1],\n        }\n        out: dict[str, int] = {}\n        for side, v in edges.items():\n            v = list(map(int, v))\n            v_nf = [x for x in v if x != int(fill)]\n            if not v_nf:\n                continue\n            col, count = Counter(v_nf).most_common(1)[0]\n            if int(count) >= len(v) - 1:\n                out[side] = int(col)\n        return out\n\n    ctrls = detect_controls_frame(g)\n    desired = {side: col for side, col in ctrls}\n    obj = extract_center_object(g)\n\n    # Try all dihedral transforms: rotations + optional horizontal flip.\n    for k in range(4):\n        base = np.rot90(obj, int(k))\n        for flip in [False, True]:\n            t = np.fliplr(base) if flip else base\n            gedges = guide_edges(t)\n            if all(side in gedges and int(gedges[side]) == int(col) for side, col in desired.items()):\n                top = 1 if \"top\" in desired else 0\n                bottom = int(t.shape[0]) - (1 if \"bottom\" in desired else 0)\n                left = 1 if \"left\" in desired else 0\n                right = int(t.shape[1]) - (1 if \"right\" in desired else 0)\n                return t[int(top) : int(bottom), int(left) : int(right)]\n\n    # Fallback: should not happen on this puzzle.\n    return obj\n\n# --------------- generator (Codex#2) ---------------\n\ndef _transform(arr: np.ndarray, k: int, flip: bool) -> np.ndarray:\n    out = np.rot90(arr, int(k))\n    return np.fliplr(out) if flip else out\n\n\ndef _inverse_transform(arr: np.ndarray, k: int, flip: bool) -> np.ndarray:\n    out = np.fliplr(arr) if flip else arr\n    return np.rot90(out, -int(k))\n\n\ndef _build_core(h: int, w: int, fill: int, pattern_colors: list[int]) -> np.ndarray:\n    core = np.full((h, w), int(fill), dtype=int)\n    area = h * w\n    max_nonfill = max(len(pattern_colors), int(area * 0.35))\n    target_nonfill = random.randint(max(len(pattern_colors), area // 10), max_nonfill)\n    painted = 0\n\n    for color in pattern_colors:\n        r = random.randrange(h)\n        c = random.randrange(w)\n        core[r, c] = int(color)\n        painted += 1\n\n    while painted < target_nonfill:\n        color = random.choice(pattern_colors)\n        shape_kind = random.choice([\"dot\", \"line\", \"rect\"])\n        if shape_kind == \"dot\":\n            cells = [(random.randrange(h), random.randrange(w))]\n        elif shape_kind == \"line\":\n            line_len = random.randint(2, min(5, max(h, w)))\n            if random.random() < 0.5:\n                rr = random.randrange(h)\n                c0 = random.randrange(max(1, w - line_len + 1))\n                cells = [(rr, c0 + dc) for dc in range(line_len)]\n            else:\n                r0 = random.randrange(max(1, h - line_len + 1))\n                cc = random.randrange(w)\n                cells = [(r0 + dr, cc) for dr in range(line_len)]\n        else:\n            mh = random.randint(1, min(3, h))\n            mw = random.randint(1, min(3, w))\n            r0 = random.randrange(h - mh + 1)\n            c0 = random.randrange(w - mw + 1)\n            cells = [(r0 + dr, c0 + dc) for dr in range(mh) for dc in range(mw)]\n\n        remaining = target_nonfill - painted\n        if remaining <= 0:\n            break\n        fill_cells = [(r, c) for r, c in cells if core[r, c] == fill]\n        if len(fill_cells) > remaining:\n            fill_cells = random.sample(fill_cells, remaining)\n        for r, c in fill_cells:\n            core[r, c] = int(color)\n        painted += len(fill_cells)\n        for r, c in cells:\n            if core[r, c] != fill:\n                continue\n            if painted >= target_nonfill:\n                break\n            core[r, c] = int(color)\n            painted += 1\n\n    return core\n\n\ndef _attach_guides(core: np.ndarray, guide_sides: tuple[str, str], guide_colors: dict[str, int]) -> np.ndarray:\n    h, w = core.shape\n    has_top = \"top\" in guide_sides\n    has_bottom = \"bottom\" in guide_sides\n    has_left = \"left\" in guide_sides\n    has_right = \"right\" in guide_sides\n    out = np.zeros((h + has_top + has_bottom, w + has_left + has_right), dtype=int)\n    r0 = 1 if has_top else 0\n    c0 = 1 if has_left else 0\n    paste(out, core, r0, c0)\n\n    if has_top:\n        out[0, c0 : c0 + w] = int(guide_colors[\"top\"])\n    if has_bottom:\n        out[-1, c0 : c0 + w] = int(guide_colors[\"bottom\"])\n    if has_left:\n        out[r0 : r0 + h, 0] = int(guide_colors[\"left\"])\n    if has_right:\n        out[r0 : r0 + h, -1] = int(guide_colors[\"right\"])\n\n    if has_top and has_left:\n        out[0, 0] = 0\n    if has_top and has_right:\n        out[0, -1] = 0\n    if has_bottom and has_left:\n        out[-1, 0] = 0\n    if has_bottom and has_right:\n        out[-1, -1] = 0\n    return out\n\n\ndef _paint_frame(grid: np.ndarray, horiz_side: str, vert_side: str, ctrl_h: int, ctrl_v: int) -> None:\n    n = grid.shape[0]\n    if horiz_side == \"top\":\n        grid[0, :] = int(ctrl_h)\n    else:\n        grid[-1, :] = int(ctrl_h)\n    if vert_side == \"left\":\n        grid[:, 0] = int(ctrl_v)\n    else:\n        grid[:, -1] = int(ctrl_v)\n\n    for side in (\"top\", \"bottom\", \"left\", \"right\"):\n        if side in (horiz_side, vert_side):\n            continue\n        if side in (\"top\", \"bottom\"):\n            r = 0 if side == \"top\" else n - 1\n            coords = [(r, c) for c in range(1, n - 1)]\n        else:\n            c = 0 if side == \"left\" else n - 1\n            coords = [(r, c) for r in range(1, n - 1)]\n        min_count = int(np.ceil(0.35 * len(coords)))\n        max_count = int(np.floor(0.60 * len(coords)))\n        noise_count = random.randint(min_count, max_count)\n        for r, c in random.sample(coords, noise_count):\n            grid[r, c] = 5\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = random.randint(22, 29)\n    horiz_side, vert_side = random.choice(\n        [(\"top\", \"left\"), (\"top\", \"right\"), (\"bottom\", \"left\"), (\"bottom\", \"right\")]\n    )\n\n    all_colors = list(range(1, 10))\n    ctrl_h, ctrl_v = random.sample([c for c in all_colors if c != 5], 2)\n    remaining = [c for c in all_colors if c not in {5, ctrl_h, ctrl_v}]\n    fill = random.choice(remaining)\n    remaining = [c for c in remaining if c != fill]\n    n_pattern_colors = random.randint(2, min(4, len(remaining)))\n    pattern_colors = random.sample(remaining, n_pattern_colors)\n\n    max_core_h = min(20, n - 3)\n    max_core_w = min(20, n - 3)\n    if max_core_h < 5 or max_core_w < 5:\n        return None\n    core_h = random.randint(5, max_core_h)\n    core_w = random.randint(5, max_core_w)\n    core = _build_core(core_h, core_w, fill, pattern_colors)\n\n    guide_colors = {horiz_side: ctrl_h, vert_side: ctrl_v}\n    aligned_object = _attach_guides(core, (horiz_side, vert_side), guide_colors)\n\n    k = random.randrange(4)\n    flip = bool(random.randrange(2))\n    input_object = _inverse_transform(aligned_object, k, flip)\n\n    grid = np.zeros((n, n), dtype=int)\n    _paint_frame(grid, horiz_side, vert_side, ctrl_h, ctrl_v)\n\n    try:\n        r0, c0 = random_free_location(grid, input_object, transparent=0, border=1)\n    except ValueError:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/9f669b64.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_h, bbox_w, crop_bbox, find_components, get_bg, paste\nimport random\n\n\ndef _center(obj: dict, axis: int) -> float:\n    r0, c0, r1, c1 = obj[\"bbox\"]\n    return ((r0 + r1) / 2, (c0 + c1) / 2)[axis]\n\n\ndef _span(obj: dict, axis: int) -> int:\n    return bbox_h(obj[\"bbox\"]) if axis == 0 else bbox_w(obj[\"bbox\"])\n\n\ndef _is_solid_rectangle(g: np.ndarray, obj: dict) -> bool:\n    r0, c0, r1, c1 = obj[\"bbox\"]\n    color = int(obj[\"color\"])\n    return (\n        int(obj[\"area\"]) == (r1 - r0 + 1) * (c1 - c0 + 1)\n        and np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color)\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Push the central solid rectangle to the grid edge, splitting the perpendicular target rectangle around its path.\n\n    Input structure\n    - The background is the dominant color.\n    - There are exactly three monochrome foreground objects arranged on one\n      horizontal or vertical axis.\n    - The middle object on that axis is a solid rectangular moving object.\n    - One end object is a solid rectangle or bar whose long side is perpendicular\n      to the movement axis; this is the target to split.\n\n    Rule\n    - Move the middle rectangle along the axis toward the target until it is\n      flush with the grid edge in that direction.\n    - Clear the original middle rectangle and the original target.\n    - Split the target through the moving rectangle's two-cell-wide path and\n      shift the two halves one cell outward perpendicular to the movement.\n    - Keep the other end object unchanged.\n\n    Key insight\n    - The non-target end object acts as a pusher; the central rectangle travels\n      away from it through the perpendicular target, opening a matching gap.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n\n    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert len(objects) == 3, \"expected exactly three foreground objects\"\n\n    row_centers = [_center(obj, 0) for obj in objects]\n    col_centers = [_center(obj, 1) for obj in objects]\n    row_spread = max(row_centers) - min(row_centers)\n    col_spread = max(col_centers) - min(col_centers)\n    assert min(row_spread, col_spread) <= 0.5, \"objects must share a row or column axis\"\n    axis = 0 if col_spread <= 0.5 else 1\n    perp = 1 - axis\n\n    ordered = sorted(objects, key=lambda obj: _center(obj, axis))\n    axis_centers = [_center(obj, axis) for obj in ordered]\n    assert axis_centers[0] < axis_centers[1] < axis_centers[2], \"expected a unique middle object\"\n\n    source = ordered[1]\n    end_objects = [ordered[0], ordered[2]]\n    assert _is_solid_rectangle(g, source), \"moving object must be a solid rectangle\"\n\n    target_candidates = [\n        obj\n        for obj in end_objects\n        if _is_solid_rectangle(g, obj) and _span(obj, perp) > _span(obj, axis)\n    ]\n    assert len(target_candidates) == 1, \"expected one perpendicular solid target\"\n    target = target_candidates[0]\n\n    direction = -1 if _center(target, axis) < _center(source, axis) else 1\n\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    tr0, tc0, tr1, tc1 = target[\"bbox\"]\n    source_lo = [sr0, sc0]\n    source_hi = [sr1, sc1]\n    target_lo = [tr0, tc0]\n    target_hi = [tr1, tc1]\n\n    source_perp_len = source_hi[perp] - source_lo[perp] + 1\n    assert source_perp_len == 2, \"moving object path must be two cells wide\"\n    assert target_lo[perp] <= source_lo[perp] <= source_hi[perp] <= target_hi[perp]\n    assert (\n        source_lo[perp] - target_lo[perp] == target_hi[perp] - source_hi[perp]\n    ), \"moving object must be centered across the target\"\n\n    out = g.copy()\n    for r, c in source[\"coords\"]:\n        out[int(r), int(c)] = bg\n    for r, c in target[\"coords\"]:\n        out[int(r), int(c)] = bg\n\n    shift = source_perp_len // 2\n    for r, c in target[\"coords\"]:\n        new_rc = [int(r), int(c)]\n        if new_rc[perp] <= source_lo[perp]:\n            new_rc[perp] -= shift\n        else:\n            assert new_rc[perp] >= source_hi[perp]\n            new_rc[perp] += shift\n        assert 0 <= new_rc[0] < H and 0 <= new_rc[1] < W, \"shifted target must stay in bounds\"\n        out[new_rc[0], new_rc[1]] = int(target[\"color\"])\n\n    source_patch = crop_bbox(g, source[\"bbox\"])\n    if axis == 0:\n        new_r = 0 if direction < 0 else H - source_patch.shape[0]\n        new_c = source_lo[1]\n    else:\n        new_r = source_lo[0]\n        new_c = 0 if direction < 0 else W - source_patch.shape[1]\n    dest = out[new_r : new_r + source_patch.shape[0], new_c : new_c + source_patch.shape[1]]\n    assert np.all(dest == bg), \"moving object destination must be clear\"\n    paste(out, source_patch, new_r, new_c)\n    return out\n\n# --------------- generator (att2) ---------------\n\nGEN_GRID_SIZE = 10\nGEN_BG = 7\nGEN_FG_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nGEN_SOURCE_PERP = 2\nGEN_SOURCE_ALONG_CHOICES = [2, 3]\nGEN_TARGET_ALONG_MIN, GEN_TARGET_ALONG_MAX = 1, 4\nGEN_TARGET_OVERHANG_CHOICES = (1, 2)\nGEN_SOURCE_TARGET_GAP_RANGE = range(5)\nGEN_OTHER_WIDTH_CHOICES = (2, 4, 6)\nGEN_OTHER_MIN_STAIR_WIDTH = 4\nGEN_OTHER_MIN_STAIR_HEIGHT = 2\nGEN_ORIENTATION_COUNT, GEN_RETRY_LIMIT = 4, 300\n\n\ndef _gen_transform(grid: np.ndarray, orientation: int) -> np.ndarray:\n    if orientation == 0:\n        return grid.copy()\n    if orientation == 1:\n        return np.flipud(grid).copy()\n    if orientation == 2:\n        return np.rot90(grid, 1).copy()\n    return np.rot90(grid, -1).copy()\n\n\ndef _gen_even_centered_start(center_left: int, width: int) -> int:\n    return center_left - (width // 2 - 1)\n\n\ndef _gen_stair_patch(h: int, w: int, color: int, bg: int) -> np.ndarray:\n    patch = np.full((h, w), bg, dtype=int)\n    max_extra = w // 2 - 1\n    thresholds = sorted(random.randint(1, h - 1) for _ in range(max_extra))\n    for r in range(h):\n        extra = sum(r >= threshold for threshold in thresholds)\n        c0 = w // 2 - 1 - extra\n        c1 = w // 2 + extra\n        patch[r, c0 : c1 + 1] = color\n    return patch\n\n\ndef _gen_place_other(grid: np.ndarray, r0: int, center_left: int, color: int, bg: int) -> None:\n    h = grid.shape[0] - r0\n    in_bounds_widths = [\n        w\n        for w in GEN_OTHER_WIDTH_CHOICES\n        if 0 <= _gen_even_centered_start(center_left, w)\n        and _gen_even_centered_start(center_left, w) + w <= grid.shape[1]\n    ]\n    solid_widths = [w for w in in_bounds_widths if w <= h]\n    stair_widths = [w for w in in_bounds_widths if w >= GEN_OTHER_MIN_STAIR_WIDTH and h >= GEN_OTHER_MIN_STAIR_HEIGHT]\n\n    kinds = []\n    if solid_widths:\n        kinds.append(\"solid\")\n    if stair_widths:\n        kinds.append(\"stair\")\n    kind = random.choice(kinds)\n\n    if kind == \"solid\":\n        w = random.choice(solid_widths)\n        patch = np.full((h, w), color, dtype=int)\n    else:\n        w = random.choice(stair_widths)\n        patch = _gen_stair_patch(h, w, color, bg)\n    paste(grid, patch, r0, _gen_even_centered_start(center_left, w), transparent=bg)\n\n\ndef _gen_choose_layout() -> tuple[int, int, int, int, int, int] | None:\n    s_h = random.choice(GEN_SOURCE_ALONG_CHOICES)\n    t_h = random.randint(GEN_TARGET_ALONG_MIN, GEN_TARGET_ALONG_MAX)\n    overhangs = [k for k in GEN_TARGET_OVERHANG_CHOICES if 2 * k + GEN_SOURCE_PERP > t_h]\n    k = random.choice(overhangs)\n    gap_options = [g for g in GEN_SOURCE_TARGET_GAP_RANGE if t_h + g + s_h <= GEN_GRID_SIZE - GEN_SOURCE_PERP]\n    if not gap_options:\n        return None\n    gap = random.choice(gap_options)\n    t0_max = GEN_GRID_SIZE - GEN_SOURCE_PERP - t_h - gap - s_h\n    t0 = random.randint(0, t0_max)\n    center_left = random.randint(k + 1, GEN_GRID_SIZE - k - 3)\n    return s_h, t_h, k, gap, t0, center_left\n\n\ndef _gen_canonical_pair(s_h: int, t_h: int, k: int, gap: int, t0: int, center_left: int, colors: list[int]) -> tuple[np.ndarray, np.ndarray]:\n    source_color, target_color, other_color = colors\n    source_patch = np.full((s_h, GEN_SOURCE_PERP), source_color, dtype=int)\n    target_patch = np.full((t_h, 2 * k + GEN_SOURCE_PERP), target_color, dtype=int)\n    split_half = np.full((t_h, k + 1), target_color, dtype=int)\n\n    out = np.full((GEN_GRID_SIZE, GEN_GRID_SIZE), GEN_BG, dtype=int)\n    paste(out, source_patch, 0, center_left)\n    paste(out, split_half, t0, center_left - k - 1)\n    paste(out, split_half, t0, center_left + GEN_SOURCE_PERP)\n\n    source_in_r = t0 + t_h + gap\n    other_r = source_in_r + s_h\n    _gen_place_other(out, other_r, center_left, other_color, GEN_BG)\n\n    inp = out.copy()\n    inp[0:s_h, center_left : center_left + GEN_SOURCE_PERP] = GEN_BG\n    inp[t0 : t0 + t_h, center_left - k - 1 : center_left] = GEN_BG\n    inp[t0 : t0 + t_h, center_left + GEN_SOURCE_PERP : center_left + k + 3] = GEN_BG\n    paste(inp, target_patch, t0, center_left - k)\n    paste(inp, source_patch, source_in_r, center_left)\n    return inp, out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    colors = random.sample(GEN_FG_COLORS, 3)\n    layout = _gen_choose_layout()\n    if layout is None:\n        return None\n    inp, out = _gen_canonical_pair(*layout, colors)\n\n    orientation = random.randrange(GEN_ORIENTATION_COUNT)\n    inp = _gen_transform(inp, orientation)\n    out = _gen_transform(out, orientation)\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except AssertionError:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 9f669b64 input\")\n","exit_code":0,"status":"completed"}}
