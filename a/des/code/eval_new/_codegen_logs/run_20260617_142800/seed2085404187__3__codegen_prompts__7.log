{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/f560132c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, neighbors4, paste, random_free_location\nimport math\nimport random\n\n\ndef _factor_pairs(n: int) -> list[tuple[int, int]]:\n    out = []\n    for h in range(1, int(n**0.5) + 1):\n        if n % h == 0:\n            w = n // h\n            out.append((h, w))\n            if h != w:\n                out.append((w, h))\n    return out\n\n\ndef _normalize_coords(coords: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], int, int]:\n    rs = [r for r, _ in coords]\n    cs = [c for _, c in coords]\n    r0 = min(rs)\n    c0 = min(cs)\n    norm = tuple(sorted((r - r0, c - c0) for r, c in coords))\n    h = max(r for r, _ in norm) + 1\n    w = max(c for _, c in norm) + 1\n    return norm, int(h), int(w)\n\n\ndef _rot90(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], int, int]:\n    norm, h, w = _normalize_coords(coords)\n    rot = [(c, h - 1 - r) for r, c in norm]\n    return _normalize_coords(rot)\n\n\ndef _flip_h(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], int, int]:\n    norm, h, w = _normalize_coords(coords)\n    flp = [(r, w - 1 - c) for r, c in norm]\n    return _normalize_coords(flp)\n\n\ndef _dihedral_orientations(\n    coords: tuple[tuple[int, int], ...],\n) -> list[tuple[tuple[tuple[int, int], ...], int, int, int, bool]]:\n    \"\"\"\n    Unique orientations under rotations + mirror (D4).\n    Returned as (coords, h, w, rot_k, flipped), where the transform is:\n      - if flipped: horizontal flip (mirror left-right)\n      - then rot_k times 90° clockwise rotation\n    coords are normalized to start at (0,0).\n    \"\"\"\n    seen: set[tuple[tuple[int, int], ...]] = set()\n    out: list[tuple[tuple[tuple[int, int], ...], int, int, int, bool]] = []\n    cur = coords\n    for rot_k in range(4):\n        c, h, w = _normalize_coords(cur)\n        if c not in seen:\n            seen.add(c)\n            out.append((c, h, w, int(rot_k), False))\n        cur = _rot90(cur)[0]\n    cur = _flip_h(coords)[0]\n    for rot_k in range(4):\n        c, h, w = _normalize_coords(cur)\n        if c not in seen:\n            seen.add(c)\n            out.append((c, h, w, int(rot_k), True))\n        cur = _rot90(cur)[0]\n    return out\n\n\ndef _extract_legend_map(g: np.ndarray, pts: np.ndarray, k: int) -> np.ndarray:\n    \"\"\"\n    Inside the legend component's bounding box, find a k×k color map block (may include 0).\n    We pick the k×k window with the maximum number of distinct colors; ties go to top-left.\n    \"\"\"\n    r0, c0, r1, c1 = bbox_coords(pts)\n    sub = g[r0 : r1 + 1, c0 : c1 + 1]\n    hh, ww = sub.shape\n    assert k > 0 and hh >= k and ww >= k, 'legend component must fit k×k map'\n    best = None  # (distinct, -rr, -cc)\n    best_rc = None\n    for rr in range(hh - k + 1):\n        for cc in range(ww - k + 1):\n            window = sub[rr : rr + k, cc : cc + k]\n            distinct = int(len(set(map(int, window.ravel()))))\n            key = (distinct, -rr, -cc)\n            if best is None or key > best:\n                best = key\n                best_rc = (rr, cc)\n    assert best_rc is not None, 'legend component must contain a valid k×k color map window'\n    rr, cc = best_rc\n    return np.asarray(sub[rr : rr + k, cc : cc + k], dtype=int).copy()\n\n\ndef _fill_holes_in_component(g: np.ndarray, pts: np.ndarray, bg: int) -> tuple[tuple[tuple[int, int], ...], int]:\n    \"\"\"\n    Treat background 'holes' fully enclosed inside the component bbox as part of the piece.\n    Returns (filled_pts, hole_count), where filled_pts is a sorted tuple of absolute coords.\n    \"\"\"\n    r0, c0, r1, c1 = bbox_coords(pts)\n    hh = r1 - r0 + 1\n    ww = c1 - c0 + 1\n    occ = np.zeros((hh, ww), dtype=bool)\n    for r, c in pts:\n        occ[r - r0, c - c0] = True\n\n    bgmask = ~occ\n    vis = np.zeros_like(bgmask, dtype=bool)\n    st: list[tuple[int, int]] = []\n\n    for rr in range(hh):\n        for cc in range(ww):\n            if rr in (0, hh - 1) or cc in (0, ww - 1):\n                if bgmask[rr, cc] and not vis[rr, cc]:\n                    vis[rr, cc] = True\n                    st.append((rr, cc))\n                    while st:\n                        r, c = st.pop()\n                        for r2, c2 in neighbors4(r, c):\n                            if 0 <= r2 < hh and 0 <= c2 < ww and bgmask[r2, c2] and not vis[r2, c2]:\n                                vis[r2, c2] = True\n                                st.append((r2, c2))\n\n    holes = bgmask & ~vis\n    hole_coords = [(r0 + rr, c0 + cc) for rr, cc in zip(*np.where(holes))]\n    filled = tuple(sorted(set(map(tuple, pts)).union(hole_coords)))\n    return filled, int(holes.sum())\n\n\ndef _assemble_exact_cover(\n    pieces: list[dict],\n    legend_idx: int,\n    legend_map: np.ndarray,\n    k: int,\n) -> np.ndarray:\n    \"\"\"\n    Tile all pieces into a full rectangle (no holes), allowing rotations + reflections.\n    Recolor each piece by quantizing its centroid into a k×k grid, using legend_map.\n    \"\"\"\n    total = sum(int(p[\"area\"]) for p in pieces)\n    max_h = max(max(h for _, h, _, _, _ in p[\"oris\"]) for p in pieces)\n    max_w = max(max(w for _, _, w, _, _ in p[\"oris\"]) for p in pieces)\n\n    dims = _factor_pairs(total)\n    dims = [(H, W) for (H, W) in dims if H >= max_h and W >= max_w]\n    assert len(dims) == 1, 'piece areas and bounds must imply a unique output rectangle'\n\n    for H, W in dims:\n        nbits = H * W\n        all_mask = (1 << nbits) - 1\n\n        # Precompute placements for non-legend pieces (legend is fixed at (0,0), but orientation varies).\n        other_pis = [i for i in range(len(pieces)) if i != legend_idx]\n        placements_other: list[list[tuple[int, int, int, tuple[tuple[int, int], ...]]]] = []\n        for pi in other_pis:\n            opts: list[tuple[int, int, int, tuple[tuple[int, int], ...]]] = []\n            for coords, ph, pw, _, _ in pieces[pi][\"oris\"]:\n                for r0 in range(0, H - ph + 1):\n                    for c0 in range(0, W - pw + 1):\n                        m = 0\n                        for dr, dc in coords:\n                            idx = (int(r0) + int(dr)) * int(W) + (int(c0) + int(dc))\n                            m |= 1 << idx\n                        opts.append((m, int(r0), int(c0), coords))\n            placements_other.append(opts)\n\n        def solve_with_fixed_legend(\n            legend_coords: tuple[tuple[int, int], ...],\n        ) -> dict[int, tuple[int, int, int, tuple[tuple[int, int], ...]]] | None:\n            legend_mask = 0\n            for dr, dc in legend_coords:\n                idx = int(dr) * int(W) + int(dc)\n                legend_mask |= 1 << idx\n\n            filtered: list[list[tuple[int, int, int, tuple[tuple[int, int], ...]]]] = []\n            for opts in placements_other:\n                filtered.append([pl for pl in opts if (pl[0] & legend_mask) == 0])\n\n            remaining = set(range(len(other_pis)))\n            chosen: dict[int, tuple[int, int, int, tuple[tuple[int, int], ...]]] = {\n                legend_idx: (legend_mask, 0, 0, legend_coords)\n            }\n\n            def search(used: int) -> bool:\n                if not remaining:\n                    return used == all_mask\n                empty = (~used) & all_mask\n                if empty == 0:\n                    return False\n                cell = (empty & -empty).bit_length() - 1\n                # Branch over *any* remaining piece that can cover this cell.\n                # (Picking only one \"best\" piece can miss valid tilings.)\n                candidates = []\n                for k in sorted(remaining):\n                    opts_k = []\n                    for pl in filtered[k]:\n                        m = pl[0]\n                        if (m >> cell) & 1 and (m & used) == 0:\n                            opts_k.append(pl)\n                    if opts_k:\n                        candidates.append((len(opts_k), k, opts_k))\n                if not candidates:\n                    return False\n\n                candidates.sort(key=lambda x: (x[0], x[1]))\n                for _, k, opts_k in candidates:\n                    remaining.remove(k)\n                    pi = other_pis[k]\n                    for pl in opts_k:\n                        chosen[pi] = pl\n                        if search(used | pl[0]):\n                            return True\n                    chosen.pop(pi, None)\n                    remaining.add(k)\n                return False\n\n            if not search(legend_mask):\n                return None\n            return chosen\n\n        # Try each possible legend orientation at (0,0).\n        chosen = None\n        for coords, ph, pw, _, _ in pieces[legend_idx][\"oris\"]:\n            assert ph <= H and pw <= W, 'legend orientation must fit the unique output rectangle'\n            sol = solve_with_fixed_legend(coords)\n            if sol is None:\n                continue\n            chosen = sol\n            break\n        assert chosen is not None, 'exact-cover assembly failed: no valid legend orientation'\n\n        # Determine legend-map cell for each piece by centroid.\n        piece_cell: dict[int, tuple[int, int]] = {}\n        for pi, pl in chosen.items():\n            _, r0, c0, coords = pl\n            # centroid: average over occupied cells\n            rs = [r0 + dr for dr, _ in coords]\n            cs = [c0 + dc for _, dc in coords]\n            cr = float(sum(rs)) / float(len(rs))\n            cc = float(sum(cs)) / float(len(cs))\n            rr = int(cr * float(k) / float(H))\n            cc2 = int(cc * float(k) / float(W))\n            rr = max(0, min(int(k) - 1, rr))\n            cc2 = max(0, min(int(k) - 1, cc2))\n            piece_cell[pi] = (rr, cc2)\n\n        # Build final output.\n        out = np.zeros((H, W), dtype=int)\n        for pi, pl in chosen.items():\n            _, r0, c0, coords = pl\n            rr, cc2 = piece_cell[pi]\n            col = int(legend_map[rr, cc2])\n            for dr, dc in coords:\n                out[r0 + dr, c0 + dc] = col\n        return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble scattered jigsaw pieces into a rectangle, recoloring each by a legend sprite's color map.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/8dab14c2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/8dab14c2.py\"","aggregated_output":"from collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import colors_present, get_bg, in_bounds\nimport random\n\n\nDIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _runs(line: np.ndarray) -> list[tuple[int, int]]:\n    runs: list[tuple[int, int]] = []\n    start: int | None = None\n    for i, v in enumerate(line):\n        if bool(v) and start is None:\n            start = i\n        if start is not None and (not bool(v) or i == len(line) - 1):\n            end = i - 1 if not bool(v) else i\n            runs.append((start, end))\n            start = None\n    return runs\n\n\ndef _body_thickness(mask: np.ndarray) -> int:\n    lengths: list[int] = []\n    for r in range(mask.shape[0]):\n        lengths.extend(e - s + 1 for s, e in _runs(mask[r]) if e - s + 1 >= 2)\n    for c in range(mask.shape[1]):\n        lengths.extend(e - s + 1 for s, e in _runs(mask[:, c]) if e - s + 1 >= 2)\n\n    assert lengths, \"foreground object must contain runs wider than one pixel\"\n    counts = Counter(lengths)\n    max_count = max(counts.values())\n    return min(length for length, count in counts.items() if count == max_count)\n\n\ndef _fg_neighbors4(mask: np.ndarray, r: int, c: int) -> list[tuple[int, int]]:\n    return [\n        (dr, dc)\n        for dr, dc in DIRS4\n        if in_bounds(mask.shape, r + dr, c + dc) and bool(mask[r + dr, c + dc])\n    ]\n\n\ndef _n8(mask: np.ndarray, r: int, c: int) -> int:\n    count = 0\n    for dr in (-1, 0, 1):\n        for dc in (-1, 0, 1):\n            if dr == 0 and dc == 0:\n                continue\n            if in_bounds(mask.shape, r + dr, c + dc) and bool(mask[r + dr, c + dc]):\n                count += 1\n    return count\n\n\ndef _ray_len(mask: np.ndarray, r: int, c: int, dr: int, dc: int) -> int:\n    length = 0\n    rr, cc = r, c\n    while in_bounds(mask.shape, rr, cc) and bool(mask[rr, cc]):\n        length += 1\n        rr += dr\n        cc += dc\n    return length\n\n\ndef _opposite_edge(mask: np.ndarray, r: int, c: int, dr: int, dc: int) -> tuple[int, int]:\n    if dr:\n        rows = np.flatnonzero(mask[:, c])\n        assert rows.size, \"tab column must contain foreground\"\n        return int(rows.max() if dr > 0 else rows.min()), c\n\n    cols = np.flatnonzero(mask[r])\n    assert cols.size, \"tab row must contain foreground\"\n    return r, int(cols.max() if dc > 0 else cols.min())\n\n\ndef _outside_opposite_edge(\n    mask: np.ndarray, r: int, c: int, dr: int, dc: int\n) -> tuple[int, int] | None:\n    if dr:\n        rows = np.flatnonzero(mask[:, c])\n        assert rows.size, \"notch column must contain foreground\"\n        rr = int(rows.max() + 1 if dr > 0 else rows.min() - 1)\n        return (rr, c) if in_bounds(mask.shape, rr, c) else None\n\n    cols = np.flatnonzero(mask[r])\n    assert cols.size, \"notch row must contain foreground\"\n    cc = int(cols.max() + 1 if dc > 0 else cols.min() - 1)\n    return (r, cc) if in_bounds(mask.shape, r, cc) else None\n\n\ndef _tab_sources(mask: np.ndarray) -> list[tuple[tuple[int, int], tuple[int, int], tuple[int, int]]]:\n    thickness = _body_thickness(mask)\n    long_ray_threshold = 2 * thickness - 1\n    tabs: list[tuple[tuple[int, int], tuple[int, int], tuple[int, int]]] = []\n\n    for r in range(mask.shape[0]):\n        for c in range(mask.shape[1]):\n            if not bool(mask[r, c]):\n                continue\n\n            neighbors = _fg_neighbors4(mask, r, c)\n            if len(neighbors) != 1:\n                continue\n\n            dr, dc = neighbors[0]\n            length = _ray_len(mask, r, c, dr, dc)\n            has_side_support = _n8(mask, r, c) >= 3\n            crosses_long_body = length > long_ray_threshold\n            if length >= 3 and (has_side_support or crosses_long_body):\n                target = _opposite_edge(mask, r, c, dr, dc)\n                assert target != (r, c), \"tab must project to the opposite side\"\n                tabs.append(((r, c), (dr, dc), target))\n\n    return tabs\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Complete each boundary tab or notch by adding the complementary feature on the opposite side of the foreground object.\n\n    Input structure\n    - The grid has exactly two colors: a dominant background and one foreground object.\n    - The foreground object is a thick rectilinear shape with one-pixel tabs and notches on its boundary.\n\n    Rule\n    - A foreground tab is a one-neighbor boundary pixel; project through its full row or column span and remove the opposite edge pixel to make a matching notch.\n    - A background notch is a one-pixel cut with three foreground 4-neighbors; project across the full row or column span and add a tab just outside the opposite edge.\n    - Notches immediately beside a tab source are not independent sources, because that gap belongs to the tab's local boundary shape.\n\n    Key insight\n    - The changed pixels are not color-specific noise; they are paired jigsaw-like boundary features on opposite sides of the same thick row or column cross-section.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = colors_present(g)\n    assert len(colors) == 2, \"task expects exactly one foreground color and one background\"\n    fg_colors = [color for color in colors if color != bg]\n    assert len(fg_colors) == 1, \"task expects a single foreground color\"\n    fg = fg_colors[0]\n\n    mask = g == fg\n    out = g.copy()\n\n    tabs = _tab_sources(mask)\n    tab_cells = {cell for cell, _direction, _target in tabs}\n    changes = 0\n\n    for _cell, _direction, target in tabs:\n        if out[target] != bg:\n            out[target] = bg\n            changes += 1\n\n    for r in range(g.shape[0]):\n        for c in range(g.shape[1]):\n            if bool(mask[r, c]):\n                continue\n\n            fg_dirs: list[tuple[int, int]] = []\n            bg_dirs: list[tuple[int, int]] = []\n            for dr, dc in DIRS4:\n                rr, cc = r + dr, c + dc\n                if in_bounds(mask.shape, rr, cc) and bool(mask[rr, cc]):\n                    fg_dirs.append((dr, dc))\n                else:\n                    bg_dirs.append((dr, dc))\n\n            if len(fg_dirs) != 3 or len(bg_dirs) != 1:\n                continue\n\n            outside_dr, outside_dc = bg_dirs[0]\n            dr, dc = -outside_dr, -outside_dc\n            side_a = (r - dc, c + dr)\n            side_b = (r + dc, c - dr)\n            if side_a in tab_cells or side_b in tab_cells:\n                continue\n\n            target = _outside_opposite_edge(mask, r, c, dr, dc)\n            if target is not None and not bool(mask[target]):\n                if out[target] != fg:\n                    out[target] = fg\n                    changes += 1\n\n    assert changes > 0, \"at least one complementary boundary feature must be produced\"\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_BG = 8\n_GEN_FG = 1\n_GEN_DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n# Canvas and placement bounds.\n_GEN_ROWS_RANGE = (13, 16)\n_GEN_COLS_RANGE = (15, 17)\n_GEN_MARGIN = 1\n\n# Clean L-shape arm bounds.\n_GEN_H_THICK_RANGE = (3, 5)\n_GEN_V_WIDTH_RANGE = (3, 6)\n_GEN_V_EXTRA_RANGE = (4, 10)\n_GEN_H_WIDTH_RANGE = (11, 14)\n_GEN_MAX_BODY_HEIGHT = 14\n_GEN_MIN_MODE_GAP = 2\n_GEN_MISSING_CORNERS = (\"TL\", \"TR\", \"BL\", \"BR\")\n\n# Boundary source feature counts.\n_GEN_PAIR_COUNT_RANGE = (1, 3)\n_GEN_MAX_TABS = 4\n\n# Retry limits.\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:\n    return 0 <= r < shape[0] and 0 <= c < shape[1]\n\n\ndef _gen_has_tangent_support(mask: np.ndarray, r: int, c: int, dr: int, dc: int) -> bool:\n    if dr:\n        sides = ((r, c - 1), (r, c + 1))\n    else:\n        sides = ((r - 1, c), (r + 1, c))\n    return all(_gen_in_bounds(mask.shape, rr, cc) and bool(mask[rr, cc]) for rr, cc in sides)\n\n\ndef _gen_line_edges(mask: np.ndarray, r: int, c: int, dr: int, dc: int) -> tuple[tuple[int, int], tuple[int, int]] | None:\n    if dr:\n        rows = np.flatnonzero(mask[:, c])\n        if rows.size == 0:\n            return None\n        near_r = int(rows.min() if dr > 0 else rows.max())\n        far_r = int(rows.max() if dr > 0 else rows.min())\n        return (near_r, c), (far_r, c)\n\n    cols = np.flatnonzero(mask[r])\n    if cols.size == 0:\n        return None\n    near_c = int(cols.min() if dc > 0 else cols.max())\n    far_c = int(cols.max() if dc > 0 else cols.min())\n    return (r, near_c), (r, far_c)\n\n\ndef _gen_feature_slots(mask: np.ndarray) -> list[dict]:\n    slots: list[dict] = []\n    for r in range(mask.shape[0]):\n        for c in range(mask.shape[1]):\n            if not bool(mask[r, c]):\n                continue\n            for dr, dc in _GEN_DIRS4:\n                outside_r, outside_c = r - dr, c - dc\n                if not _gen_in_bounds(mask.shape, outside_r, outside_c):\n                    continue\n                if bool(mask[outside_r, outside_c]):\n                    continue\n\n                edges = _gen_line_edges(mask, r, c, dr, dc)\n                if edges is None or edges[0] != (r, c):\n                    continue\n                near, far = edges\n","exit_code":0,"status":"completed"}}
