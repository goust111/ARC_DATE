{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/c920a713.py\"","aggregated_output":"from __future__ import annotations\n\nfrom itertools import combinations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, get_bg\n\n\ndef _frame_mask(shape: tuple[int, int], bbox: tuple[int, int, int, int]) -> np.ndarray:\n    r0, c0, r1, c1 = bbox\n    mask = np.zeros(shape, dtype=bool)\n    mask[r0 : r1 + 1, c0] = True\n    mask[r0 : r1 + 1, c1] = True\n    mask[r0, c0 : c1 + 1] = True\n    mask[r1, c0 : c1 + 1] = True\n    return mask\n\n\ndef _color_frames(g: np.ndarray, bg: int) -> tuple[list[int], dict[int, np.ndarray]]:\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) >= 2, \"expected multiple foreground frame colors\"\n\n    frames: dict[int, np.ndarray] = {}\n    for color in colors:\n        coords = np.argwhere(g == color)\n        assert coords.size > 0, \"foreground colors must have visible pixels\"\n        r0, c0, r1, c1 = bbox_coords(coords)\n        assert r1 > r0 and c1 > c0, \"each color must define a rectangular frame\"\n        frame = _frame_mask(g.shape, (r0, c0, r1, c1))\n        assert np.all(frame[g == color]), \"visible pixels must lie on the inferred frame perimeter\"\n        frames[int(color)] = frame\n    return colors, frames\n\n\ndef _crossing_edges(g: np.ndarray, colors: list[int], frames: dict[int, np.ndarray]) -> set[tuple[int, int]]:\n    edges: set[tuple[int, int]] = set()\n    for a, b in combinations(colors, 2):\n        crossing = frames[a] & frames[b]\n        for r_raw, c_raw in np.argwhere(crossing):\n            r = int(r_raw)\n            c = int(c_raw)\n            visible = int(g[r, c])\n            if visible == a:\n                edges.add((b, a))\n            elif visible == b:\n                edges.add((a, b))\n            else:\n                assert visible in colors, \"frame crossings must be covered by a foreground frame\"\n    assert edges, \"expected visible crossings between frames\"\n    return edges\n\n\ndef _unique_path(colors: list[int], edges: set[tuple[int, int]]) -> list[int]:\n    outgoing = {color: [other for other in colors if (color, other) in edges] for color in colors}\n    paths: list[tuple[int, ...]] = []\n\n    def search(path: tuple[int, ...], remaining: set[int]) -> None:\n        if not remaining:\n            paths.append(path)\n            return\n        for nxt in outgoing[path[-1]]:\n            if nxt in remaining:\n                search((*path, nxt), remaining - {nxt})\n\n    color_set = set(colors)\n    for start in colors:\n        search((start,), color_set - {start})\n\n    assert len(paths) == 1, \"crossings must determine a unique frame order\"\n    return list(paths[0])\n\n\ndef _render_nested(colors: list[int]) -> np.ndarray:\n    size = 2 * len(colors) - 1\n    out = np.empty((size, size), dtype=int)\n    for layer, color in enumerate(colors):\n        end = size - layer - 1\n        out[layer : end + 1, layer] = color\n        out[layer : end + 1, end] = color\n        out[layer, layer : end + 1] = color\n        out[end, layer : end + 1] = color\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Untangle overlapping colored rectangular frames into concentric square frames ordered by their visible crossings.\n\n    Input structure\n    - The background contains several one-cell-thick axis-aligned rectangular frames, one color per frame.\n    - Frames overlap, and the visible color at an overlap records a directed crossing from the hidden frame to the visible frame.\n    - Each foreground color still has visible pixels on the perimeter of its full rectangular bounding box.\n\n    Rule\n    - Infer each color's full rectangular frame from the bounding box of its visible pixels.\n    - Add a directed edge A -> B when B is visible at a crossing of A and B's frame perimeters.\n    - Find the unique path that visits every frame color once, then render those colors as one-pixel-thick concentric square frames from outside to inside.\n\n    Key insight\n    - The output is not a crop of the input; the crossing graph gives a single frame order, and that order is redrawn as nested rings.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2 and g.size > 0, \"expected a non-empty 2D grid\"\n\n    bg = get_bg(g)\n    colors, frames = _color_frames(g, bg)\n    edges = _crossing_edges(g, colors, frames)\n    order = _unique_path(colors, edges)\n    return _render_nested(order)\n\n# --------------- generator (att1) ---------------\n\n# Color and frame count bounds.\nMIN_FRAME_COUNT = 5\nMAX_FRAME_COUNT_EXCLUSIVE = 8\nAVAILABLE_COLORS = list(range(1, 10))\n\n# Square canvas and rectangular frame size bounds.\nMIN_GRID_SIZE = 12\nMAX_GRID_SIZE_EXCLUSIVE = 26\nGRID_SIZE_PER_FRAME = 2\nGRID_SIZE_PADDING = 2\nMIN_FRAME_DIM = 3\nMAX_FRAME_DIM = 13\n\n# Rejection thresholds and retry budgets.\nMIN_OVERLAP_DENSITY = 0.57\nLAYOUT_ATTEMPTS = 50\nPLACEMENT_ATTEMPTS = 150\nGENERATION_ATTEMPTS = 300\n\n\ndef _choose_ordering(rng):\n    \"\"\"Return colors ordered from back/outermost to front/innermost.\"\"\"\n    n = rng.integers(MIN_FRAME_COUNT, MAX_FRAME_COUNT_EXCLUSIVE)\n    colors = list(AVAILABLE_COLORS)\n    rng.shuffle(colors)\n    return list(colors[:n])\n\n\ndef _choose_grid_size(rng, n):\n    min_size = max(MIN_GRID_SIZE, n * GRID_SIZE_PER_FRAME + GRID_SIZE_PADDING)\n    return int(rng.integers(min_size, MAX_GRID_SIZE_EXCLUSIVE))\n\n\ndef _random_bbox(rng, size, min_dim, max_dim):\n    h = rng.integers(min_dim, max_dim + 1)\n    w = rng.integers(min_dim, max_dim + 1)\n    r0 = rng.integers(0, size - h + 1)\n    c0 = rng.integers(0, size - w + 1)\n    return (int(r0), int(c0), int(r0 + h - 1), int(c0 + w - 1))\n\n\ndef _place_bboxes(rng, ordering, size):\n    \"\"\"Place frames so every consecutive pair has intersecting perimeters.\"\"\"\n    min_dim = MIN_FRAME_DIM\n    max_dim = min(MAX_FRAME_DIM, size - 1)\n\n    for _ in range(LAYOUT_ATTEMPTS):\n        bboxes = {}\n        ok = True\n        for i, color in enumerate(ordering):\n            if i == 0:\n                bboxes[color] = _random_bbox(rng, size, min_dim, max_dim)\n                continue\n\n            placed = False\n            for _ in range(PLACEMENT_ATTEMPTS):\n                candidate = _random_bbox(rng, size, min_dim, max_dim)\n                if _perimeters_overlap(candidate, bboxes[ordering[i - 1]]):\n                    bboxes[color] = candidate\n                    placed = True\n                    break\n            if not placed:\n                ok = False\n                break\n        if ok:\n            return bboxes\n    return None\n\n\ndef _frame_masks_from_bboxes(bboxes, shape):\n    masks = {}\n    for color, (r0, c0, r1, c1) in bboxes.items():\n        mask = np.zeros(shape, dtype=bool)\n        mask[r0:r1 + 1, c0] = True\n        mask[r0:r1 + 1, c1] = True\n        mask[r0, c0:c1 + 1] = True\n        mask[r1, c0:c1 + 1] = True\n        masks[color] = mask\n    return masks\n\n\ndef _front_edges(ordering, frame_masks):\n    \"\"\"Return overlap count and edges implied by back-to-front paint order.\"\"\"\n    edges = set()\n    overlapping_pairs = 0\n    for a, b in combinations(ordering, 2):\n        crossing = frame_masks[a] & frame_masks[b]\n        if crossing.any():\n            overlapping_pairs += 1\n            idx_a = ordering.index(a)\n            idx_b = ordering.index(b)\n            if idx_a < idx_b:\n                edges.add((a, b))\n            else:\n                edges.add((b, a))\n    return overlapping_pairs, edges\n\n\ndef _has_required_overlaps(ordering, overlapping_pairs, edges):\n    n = len(ordering)\n    total_pairs = n * (n - 1) // 2\n    if total_pairs > 0 and overlapping_pairs / total_pairs < MIN_OVERLAP_DENSITY:\n        return False\n    return all((ordering[i], ordering[i + 1]) in edges for i in range(n - 1))\n\n\ndef _has_unique_order_path(ordering, edges):\n    outgoing = {c: [o for o in ordering if (c, o) in edges] for c in ordering}\n    paths = []\n\n    def search(path, remaining):\n        if len(paths) > 1:\n            return\n        if not remaining:\n            paths.append(tuple(path))\n            return\n        for nxt in outgoing[path[-1]]:\n            if nxt in remaining:\n                search(path + [nxt], remaining - {nxt})\n\n    color_set = set(ordering)\n    for start in ordering:\n        search([start], color_set - {start})\n        if len(paths) > 1:\n            break\n    return len(paths) == 1 and list(paths[0]) == ordering\n\n\ndef _paint_frames(ordering, frame_masks, shape):\n    grid = np.zeros(shape, dtype=int)\n    for color in ordering:\n        grid[frame_masks[color]] = color\n    return grid\n\n\ndef _visible_pixels_span_bboxes(grid, ordering, bboxes):\n    for color in ordering:\n        visible = np.argwhere(grid == color)\n        if visible.size == 0:\n            return False\n        vr0, vc0 = visible.min(axis=0)\n        vr1, vc1 = visible.max(axis=0)\n        if (vr0, vc0, vr1, vc1) != bboxes[color]:\n            return False\n    return True\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/a251c730.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import bbox_coords, components_mask, paste, random_free_location\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Stamp source sprites into a destination frame via color-matched singleton markers.\n\n    Input structure:\n    - Two bordered rectangles: source (multi-cell sprites) and destination (singleton markers).\n    - Each sprite has an anchor pixel — its least-frequent color. Markers share these colors.\n\n    Rule:\n    - Match each destination marker to the source sprite with the same anchor color.\n    - Translate the sprite so its anchor overlaps the marker position.\n    - Output is the destination rectangle, interior cleared before stamping.\n\n    Key insight: The rarest color per sprite doubles as a template key and positioning anchor.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # --- find all uniform-border rectangles (brute force, small grid) ---\n    def interior_bg(rect: tuple[int, int, int, int]) -> int:\n        r0, c0, r1, c1 = map(int, rect)\n        inner = g[int(r0) + 1 : int(r1), int(c0) + 1 : int(c1)]\n        return int(Counter(map(int, inner.flatten())).most_common(1)[0][0])\n\n    def rect_components(rect: tuple[int, int, int, int]) -> tuple[int, list[dict]]:\n        r0, c0, r1, c1 = map(int, rect)\n        inner = g[int(r0) + 1 : int(r1), int(c0) + 1 : int(c1)]\n        ibg = int(Counter(map(int, inner.flatten())).most_common(1)[0][0])\n        comps = []\n\n        for coords in components_mask(inner != int(ibg), connectivity=4):\n            if coords.size == 0:\n                continue\n            rr0, cc0, rr1, cc1 = bbox_coords(coords)\n            mask = np.zeros((int(rr1 - rr0 + 1), int(cc1 - cc0 + 1)), dtype=bool)\n            mask[coords[:, 0] - int(rr0), coords[:, 1] - int(cc0)] = True\n            patch = inner[int(rr0) : int(rr1) + 1, int(cc0) : int(cc1) + 1].copy()\n            patch[~mask] = 0\n\n            vals = [int(inner[int(r), int(c)]) for r, c in coords]\n            cols = Counter(vals)\n            comps.append(\n                {\n                    \"size\": int(coords.shape[0]),\n                    \"colors\": dict(cols),\n                    \"bbox\": (int(rr0), int(cc0), int(rr1), int(cc1)),\n                    \"mask\": mask,\n                    \"patch\": patch,\n                }\n            )\n\n        comps.sort(key=lambda d: -int(d[\"size\"]))\n        return int(ibg), comps\n\n    rects: list[tuple[int, tuple[int, int, int, int], int, int]] = []\n    min_h = 6\n    min_w = 6\n    for r0 in range(int(H)):\n        for c0 in range(int(W)):\n            bc = int(g[int(r0), int(c0)])\n            for r1 in range(int(r0 + min_h - 1), int(H)):\n                for c1 in range(int(c0 + min_w - 1), int(W)):\n                    # corners\n                    if int(g[int(r0), int(c1)]) != int(bc) or int(g[int(r1), int(c0)]) != int(bc) or int(\n                        g[int(r1), int(c1)]\n                    ) != int(bc):\n                        continue\n                    # border uniformity\n                    if not bool((g[int(r0), int(c0) : int(c1) + 1] == int(bc)).all()):\n                        continue\n                    if not bool((g[int(r1), int(c0) : int(c1) + 1] == int(bc)).all()):\n                        continue\n                    if not bool((g[int(r0) : int(r1) + 1, int(c0)] == int(bc)).all()):\n                        continue\n                    if not bool((g[int(r0) : int(r1) + 1, int(c1)] == int(bc)).all()):\n                        continue\n                    # interior bg must differ from border\n                    ibg = interior_bg((int(r0), int(c0), int(r1), int(c1)))\n                    if int(ibg) == int(bc):\n                        continue\n                    area = int((int(r1) - int(r0) + 1) * (int(c1) - int(c0) + 1))\n                    rects.append((int(area), (int(r0), int(c0), int(r1), int(c1)), int(bc), int(ibg)))\n\n    assert not (not rects)\n\n    rects.sort(reverse=True, key=lambda x: int(x[0]))\n    rects = rects[:6]\n\n    src = None\n    dst = None\n    for _area, rect, bc, _ibg in rects:\n        ibg2, comps = rect_components(rect)\n        max_sz = max([int(c[\"size\"]) for c in comps], default=0)\n        if max_sz > 1 and src is None:\n            src = (rect, bc, ibg2, comps)\n        if max_sz == 1 and len(comps) > 0 and dst is None:\n            dst = (rect, bc, ibg2, comps)\n\n    assert src is not None and dst is not None, 'must find both source (multi-cell) and destination (singleton) rectangles'\n\n    (sr, sc, sr1, sc1), _src_bc, src_bg, src_comps = src\n    (dr, dc, dr1, dc1), dst_bc, dst_bg, _dst_comps = dst\n\n    # --- build templates keyed by anchor color ---\n    templates: dict[int, tuple[np.ndarray, np.ndarray, tuple[int, int]]] = {}\n    for comp in src_comps:\n        cols = {k: int(v) for k, v in comp[\"colors\"].items() if int(k) != 0}\n        if not cols:\n            continue\n        anchor_col = int(min(cols.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n        patch = comp[\"patch\"]\n        mask = comp[\"mask\"]\n        anchors = np.argwhere((patch == int(anchor_col)) & mask)\n        if anchors.size == 0:\n            continue\n        ar, ac = map(int, anchors[0])\n        if int(anchor_col) not in templates or int(mask.sum()) > int(templates[int(anchor_col)][1].sum()):\n            templates[int(anchor_col)] = (patch.copy(), mask.copy(), (int(ar), int(ac)))\n\n    # --- create destination canvas and stamp ---\n    out_h = int(dr1 - dr + 1)\n    out_w = int(dc1 - dc + 1)\n    out = np.full((out_h, out_w), int(dst_bg), dtype=int)\n    out[0, :] = int(dst_bc)\n    out[-1, :] = int(dst_bc)\n    out[:, 0] = int(dst_bc)\n    out[:, -1] = int(dst_bc)\n\n    # Destination markers are singleton pixels (color != dst_bg) in the interior.\n    inner = g[int(dr) + 1 : int(dr1), int(dc) + 1 : int(dc1)]\n    for rr, cc in np.argwhere(inner != int(dst_bg)):\n        mr = int(dr + 1 + int(rr))\n        mc = int(dc + 1 + int(cc))\n        mcol = int(g[mr, mc])\n        if int(mcol) not in templates:\n            continue\n        patch, mask, (ar, ac) = templates[int(mcol)]\n        top = int((mr - dr) - int(ar))\n        left = int((mc - dc) - int(ac))\n        paste(out, patch, int(top), int(left), mask=mask, overwrite=True, clip=True)\n\n    return out\n\n# --------------- generator (O2) ---------------\n\n# === CFG: Canvas & layout ===\nGRID_SIZE = 30                     # fixed 30x30 canvas\nWALLPAPER_COLORS = (4, 5)         # number of wallpaper stripe colors (chosen per n_types)\nTOTAL_COLORS_TARGET = (7, 8, 9)   # total distinct color count targets\nGAP_RANGE = (1, 4)                # gap between rectangles during dimension selection\n\n# === CFG: Rectangle size bounds ===\nSRC_H_RANGE = (9, 19)             # source rect height (outer, inclusive)\nSRC_W_RANGE = (8, 18)             # source rect width (outer, inclusive)\nDST_H_RANGE = (9, 19)             # dest rect height (outer, inclusive)\nDST_W_RANGE = (8, 20)             # dest rect width (outer, inclusive)\nDST_W_SIDE_MAX = 20               # dest width cap for side-by-side layout\n\n# === CFG: Sprite & placement ===\nSPRITE_TYPE_CHOICES = (1, 2)      # number of distinct sprite types\nMARKER_COUNT_RANGE = (2, 3)       # markers in dest rect\nSOURCE_SPRITE_RANGE = (2, 4)      # total sprites in source rect\nMARKER_PLACE_RETRIES = 25         # retries per marker for non-overlapping placement\nSOURCE_SPRITE_PADDING = 1         # min gap between source sprites and edges\n\n# === CFG: Generation retries ===\nMAX_GEN_ATTEMPTS = 300            # outer retry limit\n\nSPRITE_SHAPES = [\n    ((\"AB.\", \"BBB\"), (0, 0)),\n    ((\"ABB\", \"BBB\"), (0, 0)),\n    ((\".A.\", \"BBB\", \".B.\"), (0, 1)),\n    ((\"AB.\", \"BBB\", \".BB\"), (0, 0)),\n    ((\"ABB\", \"BBB\", \"..B\"), (0, 0)),\n    ((\".AB\", \"BBB\", \"BB.\"), (0, 1)),\n    ((\"B.B\", \"BBB\", \".A.\"), (2, 1)),\n    ((\".B.\", \"BAB\", \".B.\"), (1, 1)),\n    ((\"BBB\", \"BAB\"), (1, 1)),\n    ((\"AB.\", \"BBB\", \".B.\"), (0, 0)),\n    ((\"BAB\", \"BBB\"), (0, 1)),\n]\n\n\ndef _render_sprite(shape_rows: tuple[str, ...], body: int, anchor: int, bg: int) -> np.ndarray:\n    \"\"\"Render a sprite template into a colored patch. 'A'=anchor, 'B'=body, '.'=bg.\"\"\"\n    char_map = {'B': body, 'A': anchor}\n    rows = [[char_map.get(ch, bg) for ch in row] for row in shape_rows]\n    return np.array(rows, dtype=int)\n\n\ndef _make_wallpaper(direction: str, palette: list[int]) -> np.ndarray:\n    \"\"\"Create a 30x30 striped wallpaper (vertical or horizontal).\"\"\"\n    period = len(palette)\n    stripe = np.array(palette * ((GRID_SIZE + period - 1) // period), dtype=int)[:GRID_SIZE]\n    if direction == \"vertical\":\n        return np.tile(stripe, (GRID_SIZE, 1))\n    return np.tile(stripe.reshape(-1, 1), (1, GRID_SIZE))\n\n\ndef _build_frame(h: int, w: int, border: int, bg: int) -> np.ndarray:\n    \"\"\"Create an h x w rectangle with a 1-pixel border and interior filled with bg.\"\"\"\n    rect = np.full((h, w), bg, dtype=int)\n    rect[0, :] = rect[-1, :] = border\n    rect[:, 0] = rect[:, -1] = border\n    return rect\n\n\ndef _choose_counts(n_total: int, n_types: int) -> list[int]:\n    \"\"\"Distribute n_total items across n_types bins, each bin >= 1.\"\"\"\n    counts = [1] * n_types\n    for _ in range(n_total - n_types):\n        counts[random.randrange(n_types)] += 1\n    return counts\n\n\ndef _choose_dimensions(layout: str) -> tuple[int, int, int, int]:\n    \"\"\"Pick (src_h, src_w, dst_h, dst_w) that fit the 30x30 canvas for the given layout.\"\"\"\n    gap = random.randint(*GAP_RANGE)\n    if layout == \"side_by_side\":\n        src_w = random.randint(*SRC_W_RANGE)\n        dst_w_max = min(DST_W_SIDE_MAX, GRID_SIZE - gap - src_w)\n        if dst_w_max < DST_W_RANGE[0]:\n            raise ValueError(\"no side-by-side width fit\")\n        dst_w = random.randint(DST_W_RANGE[0], dst_w_max)\n        src_h = random.randint(*SRC_H_RANGE)\n        dst_h = random.randint(*DST_H_RANGE)\n    else:\n        src_h = random.randint(*SRC_H_RANGE)\n        dst_h_max = min(DST_H_RANGE[1], GRID_SIZE - gap - src_h)\n        if dst_h_max < DST_H_RANGE[0]:\n            raise ValueError(\"no stacked height fit\")\n        dst_h = random.randint(DST_H_RANGE[0], dst_h_max)\n        src_w = random.randint(*SRC_W_RANGE)\n        dst_w = random.randint(*DST_W_RANGE)\n    return src_h, src_w, dst_h, dst_w\n\n\ndef _place_rectangles(\n    layout: str, src_h: int, src_w: int, dst_h: int, dst_w: int\n) -> tuple[tuple[int, int], tuple[int, int]]:\n    \"\"\"Compute non-overlapping (row, col) origins for src and dst rectangles.\"\"\"\n    if layout == \"side_by_side\":\n        gap = random.randint(1, GRID_SIZE - src_w - dst_w)\n        slack = GRID_SIZE - src_w - dst_w - gap\n        left_margin = random.randint(0, slack)\n        src_r = random.randint(0, GRID_SIZE - src_h)\n        dst_r = random.randint(0, GRID_SIZE - dst_h)\n        if random.random() < 0.5:\n            src_c, dst_c = left_margin, left_margin + src_w + gap\n        else:\n            dst_c, src_c = left_margin, left_margin + dst_w + gap\n    else:\n        gap = random.randint(1, GRID_SIZE - src_h - dst_h)\n        slack = GRID_SIZE - src_h - dst_h - gap\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/58c02a16.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox, get_bg\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Expand the top-left seed mask into a recursive colored pattern and tile it across the full grid.\n\n    Input structure\n    - The background is the dominant color.\n    - All foreground lies in a top-left rectangle whose last row and last column are a solid secondary color.\n    - Removing that secondary-color row and column leaves a seed region containing background plus one primary color.\n\n    Rule\n    - Use the primary-color pixels in the seed as a binary mask.\n    - Replace each primary seed cell with a copy of the seed mask in the primary color, and each background seed cell\n      with a copy of the seed mask in the secondary color.\n    - Repeat and crop that expanded tile to the original grid shape.\n\n    Key insight\n    The solid L-shaped secondary-color border is a legend, not output content; it supplies the color used when the\n    seed's background cells are expanded.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    fg_bbox = bbox(g != bg)\n    assert fg_bbox is not None, \"expected a top-left foreground legend\"\n    r0, c0, r1, c1 = fg_bbox\n    assert r0 == 0 and c0 == 0, \"foreground legend must be anchored at the top-left corner\"\n\n    legend_box = g[: r1 + 1, : c1 + 1]\n    seed_h = legend_box.shape[0] - 1\n    seed_w = legend_box.shape[1] - 1\n    assert seed_h >= 1 and seed_w >= 1, \"legend must contain a non-empty seed plus border\"\n\n    secondary_border = np.concatenate((legend_box[:seed_h, seed_w], legend_box[seed_h, :]))\n    secondary_colors = np.unique(secondary_border)\n    assert secondary_colors.size == 1, \"expected one solid secondary-color border\"\n    secondary = int(secondary_colors[0])\n    assert secondary != bg, \"secondary border must be foreground\"\n\n    seed = legend_box[:seed_h, :seed_w]\n    primary_colors = np.unique(seed[seed != bg])\n    assert primary_colors.size == 1, \"seed must contain exactly one primary foreground color\"\n    primary = int(primary_colors[0])\n    assert primary != secondary, \"primary and secondary colors must be distinct\"\n    assert np.all((seed == bg) | (seed == primary)), \"seed may contain only background and primary colors\"\n    assert np.any(seed == bg), \"seed must include background cells that expand to the secondary color\"\n\n    seed_mask = seed == primary\n    H, W = g.shape\n    rows = np.arange(H)[:, None]\n    cols = np.arange(W)[None, :]\n\n    inner_mask = seed_mask[rows % seed_h, cols % seed_w]\n    meta_mask = seed_mask[(rows // seed_h) % seed_h, (cols // seed_w) % seed_w]\n\n    out = np.full(g.shape, bg, dtype=int)\n    out[inner_mask & meta_mask] = primary\n    out[inner_mask & ~meta_mask] = secondary\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Color palette.\nBACKGROUND_COLOR, PALETTE_COLORS = 7, tuple(range(10))\n# Seed geometry.\nSEED_SIZES = (2, 3)\nSEED_DENSITY_MIN, SEED_DENSITY_MAX = 0.33, 0.67\n# Canvas layout.\nTILE_MULTIPLIERS, GRID_MIN, GRID_MAX = range(3, 6), 7, 16\nREMAINDERS_BY_SQUARENESS = {False: (0,), True: (0, 1)}\n# Retry budget.\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _expected_output(seed_mask: np.ndarray, shape: tuple[int, int], bg: int, primary: int, secondary: int) -> np.ndarray:\n    \"\"\"Render the two-level fractal that main() should produce.\"\"\"\n    seed_h, seed_w = seed_mask.shape\n    H, W = shape\n    rows = np.arange(H)[:, None]\n    cols = np.arange(W)[None, :]\n\n    inner = seed_mask[rows % seed_h, cols % seed_w]\n    meta = seed_mask[(rows // seed_h) % seed_h, (cols // seed_w) % seed_w]\n\n    out = np.full((H, W), bg, dtype=int)\n    out[inner & meta] = primary\n    out[inner & ~meta] = secondary\n    return out\n\ndef _layout_options(seed_h: int, seed_w: int) -> list[tuple[int, int]]:\n    \"\"\"Return valid canvas shapes for a sampled seed size.\"\"\"\n    options = []\n    for k in TILE_MULTIPLIERS:\n        for rem in REMAINDERS_BY_SQUARENESS[seed_h == seed_w]:\n            H = seed_h * k + rem\n            W = seed_w * k + rem\n            if GRID_MIN <= H <= GRID_MAX and GRID_MIN <= W <= GRID_MAX and H >= seed_h * seed_h and W >= seed_w * seed_w:\n                options.append((H, W))\n    return options\n\ndef _random_seed_mask(seed_h: int, seed_w: int) -> np.ndarray:\n    \"\"\"Sample a nonempty, nonfull primary mask within density bounds.\"\"\"\n    area = seed_h * seed_w\n    lo = max(1, int(np.ceil(area * SEED_DENSITY_MIN)))\n    hi = min(area - 1, int(np.floor(area * SEED_DENSITY_MAX)))\n    n_primary = random.randint(lo, hi)\n    chosen = random.sample(range(area), n_primary)\n    mask = np.zeros((seed_h, seed_w), dtype=bool)\n    mask.reshape(-1)[chosen] = True\n    return mask\n\ndef _render_input(seed_mask: np.ndarray, shape: tuple[int, int], bg: int, primary: int, secondary: int) -> np.ndarray:\n    \"\"\"Render the top-left seed legend on a background canvas.\"\"\"\n    seed_h, seed_w = seed_mask.shape\n    inp = np.full(shape, bg, dtype=int)\n    inp[:seed_h, :seed_w][seed_mask] = primary\n    inp[seed_h, : seed_w + 1] = secondary\n    inp[:seed_h, seed_w] = secondary\n    return inp\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Build one oracle-checked input grid, or None if validation fails.\"\"\"\n    bg = BACKGROUND_COLOR\n    primary, secondary = random.sample([c for c in PALETTE_COLORS if c != bg], 2)\n\n    seed_h = random.choice(SEED_SIZES)\n    seed_w = random.choice(SEED_SIZES)\n    H, W = random.choice(_layout_options(seed_h, seed_w))\n\n    seed_mask = _random_seed_mask(seed_h, seed_w)\n    inp = _render_input(seed_mask, (H, W), bg, primary, secondary)\n    expected = _expected_output(seed_mask, (H, W), bg, primary, secondary)\n    try:\n        actual = main(inp)\n    except Exception:\n        return None\n    if not np.array_equal(actual, expected):\n        return None\n    return inp\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 58c02a16 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, label_mask, paste\nimport random\n\n\nclass _Node:\n    def __init__(self, coords: np.ndarray, bbox: tuple[int, int, int, int], center: np.ndarray):\n        self.coords = coords\n        self.bbox = bbox\n        self.center = center\n        self.is_frame = False\n        self.parent: _Node | None = None\n        self.children: list[_Node] = []\n        self.mask: np.ndarray | None = None\n        self.anchor: tuple[int, int] | None = None\n        self.axis_map: dict[str, list[tuple[float, int]]] = {\"row\": [], \"col\": []}\n\n\ndef _component_holes(shape: tuple[int, int], coords: np.ndarray) -> list[np.ndarray]:\n    mask = np.zeros(shape, dtype=bool)\n    mask[tuple(coords.T)] = True\n    lab, n = label_mask(~mask, connectivity=4)\n    boundary = set(lab[0, :]) | set(lab[-1, :]) | set(lab[:, 0]) | set(lab[:, -1])\n    return [(lab == k) for k in range(1, n + 1) if k not in boundary]\n\n\ndef _intervals_overlap(a: tuple[int, int], b: tuple[int, int]) -> bool:\n    return max(a[0], b[0]) <= min(a[1], b[1])\n\n\ndef _build_layout(node: _Node) -> None:\n    if node.mask is not None:\n        return\n\n    if not node.is_frame:\n        node.mask = np.ones((1, 1), dtype=bool)\n        node.anchor = (0, 0)\n        node.axis_map = {\n            \"row\": [(float(node.center[0]), 0)],\n            \"col\": [(float(node.center[1]), 0)],\n        }\n        return\n\n    assert node.children\n    child_mask, _placements, axis_map = _layout_group(node.children)\n    h, w = child_mask.shape\n    out = np.zeros((h + 4, w + 4), dtype=bool)\n    out[0, :] = True\n    out[-1, :] = True\n    out[:, 0] = True\n    out[:, -1] = True\n    out[2 : 2 + h, 2 : 2 + w] |= child_mask\n\n    node.mask = out\n    node.anchor = (out.shape[0] // 2, out.shape[1] // 2)\n    node.axis_map = {\n        \"row\": [(orig, pos + 2) for orig, pos in axis_map[\"row\"]],\n        \"col\": [(orig, pos + 2) for orig, pos in axis_map[\"col\"]],\n    }\n\n\ndef _axis_coordinates(nodes: list[_Node], axis: int) -> dict[_Node, int]:\n    items = []\n    for node in nodes:\n        assert node.mask is not None and node.anchor is not None\n        r0, c0, r1, c1 = node.bbox\n        interval = (r0, r1) if axis == 0 else (c0, c1)\n        mid = (interval[0] + interval[1]) / 2\n        items.append((node, interval, mid, node.anchor[axis], node.mask.shape[axis]))\n\n    bands: list[dict] = []\n    for item in sorted(items, key=lambda x: x[2]):\n        interval = item[1]\n        for band in bands:\n            if any(_intervals_overlap(interval, other[1]) for other in band[\"items\"]):\n                band[\"items\"].append(item)\n                band[\"interval\"] = (\n                    min(band[\"interval\"][0], interval[0]),\n                    max(band[\"interval\"][1], interval[1]),\n                )\n                break\n        else:\n            bands.append({\"items\": [item], \"interval\": interval})\n\n    coord_by_node: dict[_Node, int] = {}\n    coord = 0\n    for i, band in enumerate(bands):\n        if i:\n            prev = bands[i - 1]\n            prev_down = max(item[4] - 1 - item[3] for item in prev[\"items\"])\n            curr_up = max(item[3] for item in band[\"items\"])\n            coord += prev_down + 2 + curr_up\n        for item in band[\"items\"]:\n            coord_by_node[item[0]] = int(coord)\n\n    return coord_by_node\n\n\ndef _layout_group(nodes: list[_Node]) -> tuple[np.ndarray, dict[_Node, tuple[int, int]], dict[str, list[tuple[float, int]]]]:\n    assert nodes\n    for node in nodes:\n        _build_layout(node)\n\n    row_coord = _axis_coordinates(nodes, axis=0)\n    col_coord = _axis_coordinates(nodes, axis=1)\n\n    min_r = min(row_coord[n] - n.anchor[0] for n in nodes if n.anchor is not None)\n    min_c = min(col_coord[n] - n.anchor[1] for n in nodes if n.anchor is not None)\n    max_r = max(\n        row_coord[n] - n.anchor[0] - min_r + n.mask.shape[0]\n        for n in nodes\n        if n.anchor is not None and n.mask is not None\n    )\n    max_c = max(\n        col_coord[n] - n.anchor[1] - min_c + n.mask.shape[1]\n        for n in nodes\n        if n.anchor is not None and n.mask is not None\n    )\n\n    out = np.zeros((max_r, max_c), dtype=bool)\n    placements: dict[_Node, tuple[int, int]] = {}\n    axis_map = {\"row\": [], \"col\": []}\n    for node in nodes:\n        assert node.mask is not None and node.anchor is not None\n        r = row_coord[node] - node.anchor[0] - min_r\n        c = col_coord[node] - node.anchor[1] - min_c\n        placements[node] = (int(r), int(c))\n        out[r : r + node.mask.shape[0], c : c + node.mask.shape[1]] |= node.mask\n        axis_map[\"row\"].append((float(node.center[0]), int(r + node.anchor[0])))\n        axis_map[\"col\"].append((float(node.center[1]), int(c + node.anchor[1])))\n\n    return out, placements, axis_map\n\n\ndef _outside_side(dot: _Node, frame: _Node) -> str:\n    r0, c0, r1, c1 = dot.bbox\n    fr0, fc0, fr1, fc1 = frame.bbox\n    if c0 > fc1:\n        return \"right\"\n    if c1 < fc0:\n        return \"left\"\n    if r0 > fr1:\n        return \"bottom\"\n    if r1 < fr0:\n        return \"top\"\n\n    dr = float(dot.center[0] - (fr0 + fr1) / 2)\n    dc = float(dot.center[1] - (fc0 + fc1) / 2)\n    if abs(dc) >= abs(dr):\n        return \"right\" if dc > 0 else \"left\"\n    return \"bottom\" if dr > 0 else \"top\"\n\n\ndef _map_frame_axis(frame: _Node, axis: int, value: float) -> int:\n    assert frame.anchor is not None\n    key = \"row\" if axis == 0 else \"col\"\n    candidates = frame.axis_map[key]\n    if not candidates:\n        return int(frame.anchor[axis])\n    return int(min(candidates, key=lambda item: abs(item[0] - value))[1])\n\n\ndef _layout_root(nodes: list[_Node]) -> np.ndarray:\n    assert nodes\n    for node in nodes:\n        _build_layout(node)\n\n    frames = [node for node in nodes if node.is_frame]\n    dots = [node for node in nodes if not node.is_frame]\n    if len(frames) == 1 and dots:\n        frame = frames[0]\n        assert frame.mask is not None\n        placements: dict[_Node, tuple[int, int]] = {frame: (0, 0)}\n        extents = [(0, 0, frame.mask.shape[0], frame.mask.shape[1])]\n\n        for dot in dots:\n            side = _outside_side(dot, frame)\n            if side in {\"right\", \"left\"}:\n                r = _map_frame_axis(frame, 0, float(dot.center[0]))\n                c = frame.mask.shape[1] + 1 if side == \"right\" else -2\n            else:\n                r = frame.mask.shape[0] + 1 if side == \"bottom\" else -2\n                c = _map_frame_axis(frame, 1, float(dot.center[1]))\n            placements[dot] = (int(r), int(c))\n            extents.append((r - 1, c - 1, r + 2, c + 2))\n\n        min_r = min(e[0] for e in extents)\n        min_c = min(e[1] for e in extents)\n        max_r = max(e[2] for e in extents)\n        max_c = max(e[3] for e in extents)\n        out = np.zeros((max_r - min_r, max_c - min_c), dtype=bool)\n        for node, (r, c) in placements.items():\n            rr = r - min_r\n            cc = c - min_c\n            if node is frame:\n                out[rr : rr + frame.mask.shape[0], cc : cc + frame.mask.shape[1]] |= frame.mask\n            else:\n                out[rr, cc] = True\n        return out\n\n    mask, _placements, _axis_map = _layout_group(nodes)\n    return mask\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert a rough nested line drawing into a clean canonical frame-and-dot diagram.\n\n    Input structure:\n    - The grid has one background color and one foreground color.\n    - Foreground 4-connected objects are rough closed frames or small filled blobs.\n    - Frames may contain other frames/blobs; blobs outside a frame remain outside it.\n\n    Rule:\n    - Detect the containment tree of foreground objects using holes of each frame object.\n    - Replace every blob with one foreground pixel.\n    - Replace every frame with a rectangular border padded two cells around its direct children.\n    - Place siblings by their original row/column overlap and order, with one empty cell between canonical objects.\n\n    Key insight: The exact wobbly geometry is irrelevant; only enclosure plus relative sibling positions define the output.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    fg_colors = sorted(set(map(int, g.flatten())) - {bg})\n    assert len(fg_colors) == 1\n    fg = int(fg_colors[0])\n\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[fg], return_format=\"dict\")\n    assert comps\n\n    nodes: list[_Node] = []\n    holes: list[list[np.ndarray]] = []\n    for comp in comps:\n        coords = np.asarray(comp[\"coords\"], dtype=int)\n        node = _Node(\n            coords=coords,\n            bbox=tuple(map(int, comp[\"bbox\"])),\n            center=coords.mean(axis=0),\n        )\n        node_holes = _component_holes(g.shape, coords)\n        node.is_frame = bool(node_holes)\n        nodes.append(node)\n        holes.append(node_holes)\n\n    assert any(node.is_frame for node in nodes)\n    for node_i, node in enumerate(nodes):\n        containers = []\n        for frame_i, frame in enumerate(nodes):\n            if node_i == frame_i or not frame.is_frame:\n                continue\n            if any(np.all(hole[tuple(node.coords.T)]) for hole in holes[frame_i]):\n                containers.append(frame)\n        if containers:\n            node.parent = min(containers, key=lambda item: int(item.coords.shape[0]))\n            node.parent.children.append(node)\n\n    roots = [node for node in nodes if node.parent is None]\n","exit_code":0,"status":"completed"}}
