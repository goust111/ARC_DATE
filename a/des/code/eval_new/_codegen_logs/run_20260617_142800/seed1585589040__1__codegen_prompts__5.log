{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"awk 'BEGIN{show=0} /\"'^def main'\"\\\\(/{show=1} show{print} /\"'^def generate_input'\"\\\\(/{if(gen++) exit}' /home/lixinyu/snap/new/ARC_code/train/52364a65.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Erase the two leftmost columns of every foreground object, leaving the rest of each object in place.\n\n    Input structure:\n    - A grid has one dominant background color and several monochromatic 4-connected foreground objects.\n    - Each foreground object spans at least two columns in its bounding box.\n\n    Rule:\n    - Find each same-color 4-connected foreground object.\n    - Within each object's own bounding box, set foreground pixels in the two leftmost columns to the background color.\n    - Leave all other pixels unchanged.\n\n    Key insight:\n    - The deletion is measured from each object's local left edge, not from the grid edge or from a shared global column.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert components, \"expected at least one foreground object\"\n\n    out = g.copy()\n    for component in components:\n        coords = component[\"coords\"]\n        _r0, c0, _r1, c1 = map(int, component[\"bbox\"])\n        assert c1 - c0 + 1 >= 2, \"each object must span at least two columns\"\n\n        erase = coords[coords[:, 1] < c0 + 2]\n        out[erase[:, 0], erase[:, 1]] = bg\n\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n# Canvas constraints.\nBG = 8\nGRID_SIZE_RANGE = (8, 11)\nMIN_BACKGROUND_FRACTION = 0.50\n# Object sampling constraints.\nOBJECT_COUNT = 4\nFOREGROUND_COLORS = [0, 1, 2, 3, 4, 5, 6, 7, 9]\nSPRITE_WIDTH_RANGE = (2, 6)\nSPRITE_HEIGHT_RANGE = (2, 5)\nSPRITE_PIXEL_RANGE = (4, 14)\nSPRITE_RETRIES = 30\nSPRITE_CONNECTIVITY = 4\nSPRITE_SYMMETRY = \"not_symmetric\"\n# Placement and global retry policy.\nPLACEMENT_PADDING = 1\nPLACEMENT_CONNECTIVITY = 8\nGENERATION_RETRIES = 300\n\ndef _sample_sprite(color: int) -> np.ndarray | None:\n    \"\"\"Return one connected sprite that lands inside the configured pixel-count range.\"\"\"\n    bw = random.randint(*SPRITE_WIDTH_RANGE)\n    bh = random.randint(*SPRITE_HEIGHT_RANGE)\n    max_px = bw * bh\n    min_px = max(SPRITE_PIXEL_RANGE[0], bw + bh - 1)\n    max_target_px = min(SPRITE_PIXEL_RANGE[1], max_px)\n    if min_px > max_target_px:\n        return None\n    target_px = random.randint(min_px, max_target_px)\n    density = target_px / max_px\n    for _ in range(SPRITE_RETRIES):\n        try:\n            sprite = random_sprite(bh, bw, density=density, color_palette=[color],\n                                   connectivity=SPRITE_CONNECTIVITY, background=BG,\n                                   symmetry=SPRITE_SYMMETRY)\n        except Exception:\n            continue\n        px = int(np.sum(sprite != BG))\n        if SPRITE_PIXEL_RANGE[0] <= px <= SPRITE_PIXEL_RANGE[1]:\n            return sprite\n    return None\n\ndef _place_sprite(grid: np.ndarray, sprite: np.ndarray) -> bool:\n    \"\"\"Paste sprite with the required Chebyshev gap; return False if no slot exists.\"\"\"\n    try:\n        r, c = random_free_location(grid, sprite, transparent=BG,\n                                    padding=PLACEMENT_PADDING,\n                                    padding_connectivity=PLACEMENT_CONNECTIVITY)\n    except ValueError:\n        return False\n    paste(grid, sprite, r, c, transparent=BG)\n    return True\n\ndef _solver_accepts(grid: np.ndarray) -> bool:\n    \"\"\"Return whether the solver accepts the sampled task instance.\"\"\"\n    try:\n        out = main(grid)\n    except Exception:\n        return False\n    return out is not None\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = random.randint(*GRID_SIZE_RANGE)\n    W = random.randint(*GRID_SIZE_RANGE)\n    grid = np.full((H, W), BG, dtype=int)\n    for color in random.sample(FOREGROUND_COLORS, OBJECT_COUNT):\n        sprite = _sample_sprite(color)\n        if sprite is None or not _place_sprite(grid, sprite):\n            return None\n    if np.sum(grid == BG) / grid.size < MIN_BACKGROUND_FRACTION:\n        return None\n    return grid if _solver_accepts(grid) else None\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate input after {GENERATION_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"awk 'BEGIN{show=0} /\"'^def main'\"\\\\(/{show=1} show{print} /\"'^def generate_input'\"\\\\(/{if(gen++) exit}' /home/lixinyu/snap/new/ARC_code/train/9f669b64.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"awk 'BEGIN{show=0} /\"'^def main'\"\\\\(/{show=1} show{print} /\"'^def generate_input'\"\\\\(/{if(gen++) exit}' /home/lixinyu/snap/new/ARC_code/train/9f669b64.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Push the central solid rectangle to the grid edge, splitting the perpendicular target rectangle around its path.\n\n    Input structure\n    - The background is the dominant color.\n    - There are exactly three monochrome foreground objects arranged on one\n      horizontal or vertical axis.\n    - The middle object on that axis is a solid rectangular moving object.\n    - One end object is a solid rectangle or bar whose long side is perpendicular\n      to the movement axis; this is the target to split.\n\n    Rule\n    - Move the middle rectangle along the axis toward the target until it is\n      flush with the grid edge in that direction.\n    - Clear the original middle rectangle and the original target.\n    - Split the target through the moving rectangle's two-cell-wide path and\n      shift the two halves one cell outward perpendicular to the movement.\n    - Keep the other end object unchanged.\n\n    Key insight\n    - The non-target end object acts as a pusher; the central rectangle travels\n      away from it through the perpendicular target, opening a matching gap.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    H, W = g.shape\n\n    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert len(objects) == 3, \"expected exactly three foreground objects\"\n\n    row_centers = [_center(obj, 0) for obj in objects]\n    col_centers = [_center(obj, 1) for obj in objects]\n    row_spread = max(row_centers) - min(row_centers)\n    col_spread = max(col_centers) - min(col_centers)\n    assert min(row_spread, col_spread) <= 0.5, \"objects must share a row or column axis\"\n    axis = 0 if col_spread <= 0.5 else 1\n    perp = 1 - axis\n\n    ordered = sorted(objects, key=lambda obj: _center(obj, axis))\n    axis_centers = [_center(obj, axis) for obj in ordered]\n    assert axis_centers[0] < axis_centers[1] < axis_centers[2], \"expected a unique middle object\"\n\n    source = ordered[1]\n    end_objects = [ordered[0], ordered[2]]\n    assert _is_solid_rectangle(g, source), \"moving object must be a solid rectangle\"\n\n    target_candidates = [\n        obj\n        for obj in end_objects\n        if _is_solid_rectangle(g, obj) and _span(obj, perp) > _span(obj, axis)\n    ]\n    assert len(target_candidates) == 1, \"expected one perpendicular solid target\"\n    target = target_candidates[0]\n\n    direction = -1 if _center(target, axis) < _center(source, axis) else 1\n\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    tr0, tc0, tr1, tc1 = target[\"bbox\"]\n    source_lo = [sr0, sc0]\n    source_hi = [sr1, sc1]\n    target_lo = [tr0, tc0]\n    target_hi = [tr1, tc1]\n\n    source_perp_len = source_hi[perp] - source_lo[perp] + 1\n    assert source_perp_len == 2, \"moving object path must be two cells wide\"\n    assert target_lo[perp] <= source_lo[perp] <= source_hi[perp] <= target_hi[perp]\n    assert (\n        source_lo[perp] - target_lo[perp] == target_hi[perp] - source_hi[perp]\n    ), \"moving object must be centered across the target\"\n\n    out = g.copy()\n    for r, c in source[\"coords\"]:\n        out[int(r), int(c)] = bg\n    for r, c in target[\"coords\"]:\n        out[int(r), int(c)] = bg\n\n    shift = source_perp_len // 2\n    for r, c in target[\"coords\"]:\n        new_rc = [int(r), int(c)]\n        if new_rc[perp] <= source_lo[perp]:\n            new_rc[perp] -= shift\n        else:\n            assert new_rc[perp] >= source_hi[perp]\n            new_rc[perp] += shift\n        assert 0 <= new_rc[0] < H and 0 <= new_rc[1] < W, \"shifted target must stay in bounds\"\n        out[new_rc[0], new_rc[1]] = int(target[\"color\"])\n\n    source_patch = crop_bbox(g, source[\"bbox\"])\n    if axis == 0:\n        new_r = 0 if direction < 0 else H - source_patch.shape[0]\n        new_c = source_lo[1]\n    else:\n        new_r = source_lo[0]\n        new_c = 0 if direction < 0 else W - source_patch.shape[1]\n    dest = out[new_r : new_r + source_patch.shape[0], new_c : new_c + source_patch.shape[1]]\n    assert np.all(dest == bg), \"moving object destination must be clear\"\n    paste(out, source_patch, new_r, new_c)\n    return out\n\n# --------------- generator (att2) ---------------\n\nGEN_GRID_SIZE = 10\nGEN_BG = 7\nGEN_FG_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]\nGEN_SOURCE_PERP = 2\nGEN_SOURCE_ALONG_CHOICES = [2, 3]\nGEN_TARGET_ALONG_MIN, GEN_TARGET_ALONG_MAX = 1, 4\nGEN_TARGET_OVERHANG_CHOICES = (1, 2)\nGEN_SOURCE_TARGET_GAP_RANGE = range(5)\nGEN_OTHER_WIDTH_CHOICES = (2, 4, 6)\nGEN_OTHER_MIN_STAIR_WIDTH = 4\nGEN_OTHER_MIN_STAIR_HEIGHT = 2\nGEN_ORIENTATION_COUNT, GEN_RETRY_LIMIT = 4, 300\n\n\ndef _gen_transform(grid: np.ndarray, orientation: int) -> np.ndarray:\n    if orientation == 0:\n        return grid.copy()\n    if orientation == 1:\n        return np.flipud(grid).copy()\n    if orientation == 2:\n        return np.rot90(grid, 1).copy()\n    return np.rot90(grid, -1).copy()\n\n\ndef _gen_even_centered_start(center_left: int, width: int) -> int:\n    return center_left - (width // 2 - 1)\n\n\ndef _gen_stair_patch(h: int, w: int, color: int, bg: int) -> np.ndarray:\n    patch = np.full((h, w), bg, dtype=int)\n    max_extra = w // 2 - 1\n    thresholds = sorted(random.randint(1, h - 1) for _ in range(max_extra))\n    for r in range(h):\n        extra = sum(r >= threshold for threshold in thresholds)\n        c0 = w // 2 - 1 - extra\n        c1 = w // 2 + extra\n        patch[r, c0 : c1 + 1] = color\n    return patch\n\n\ndef _gen_place_other(grid: np.ndarray, r0: int, center_left: int, color: int, bg: int) -> None:\n    h = grid.shape[0] - r0\n    in_bounds_widths = [\n        w\n        for w in GEN_OTHER_WIDTH_CHOICES\n        if 0 <= _gen_even_centered_start(center_left, w)\n        and _gen_even_centered_start(center_left, w) + w <= grid.shape[1]\n    ]\n    solid_widths = [w for w in in_bounds_widths if w <= h]\n    stair_widths = [w for w in in_bounds_widths if w >= GEN_OTHER_MIN_STAIR_WIDTH and h >= GEN_OTHER_MIN_STAIR_HEIGHT]\n\n    kinds = []\n    if solid_widths:\n        kinds.append(\"solid\")\n    if stair_widths:\n        kinds.append(\"stair\")\n    kind = random.choice(kinds)\n\n    if kind == \"solid\":\n        w = random.choice(solid_widths)\n        patch = np.full((h, w), color, dtype=int)\n    else:\n        w = random.choice(stair_widths)\n        patch = _gen_stair_patch(h, w, color, bg)\n    paste(grid, patch, r0, _gen_even_centered_start(center_left, w), transparent=bg)\n\n\ndef _gen_choose_layout() -> tuple[int, int, int, int, int, int] | None:\n    s_h = random.choice(GEN_SOURCE_ALONG_CHOICES)\n    t_h = random.randint(GEN_TARGET_ALONG_MIN, GEN_TARGET_ALONG_MAX)\n    overhangs = [k for k in GEN_TARGET_OVERHANG_CHOICES if 2 * k + GEN_SOURCE_PERP > t_h]\n    k = random.choice(overhangs)\n    gap_options = [g for g in GEN_SOURCE_TARGET_GAP_RANGE if t_h + g + s_h <= GEN_GRID_SIZE - GEN_SOURCE_PERP]\n    if not gap_options:\n        return None\n    gap = random.choice(gap_options)\n    t0_max = GEN_GRID_SIZE - GEN_SOURCE_PERP - t_h - gap - s_h\n    t0 = random.randint(0, t0_max)\n    center_left = random.randint(k + 1, GEN_GRID_SIZE - k - 3)\n    return s_h, t_h, k, gap, t0, center_left\n\n\ndef _gen_canonical_pair(s_h: int, t_h: int, k: int, gap: int, t0: int, center_left: int, colors: list[int]) -> tuple[np.ndarray, np.ndarray]:\n    source_color, target_color, other_color = colors\n    source_patch = np.full((s_h, GEN_SOURCE_PERP), source_color, dtype=int)\n    target_patch = np.full((t_h, 2 * k + GEN_SOURCE_PERP), target_color, dtype=int)\n    split_half = np.full((t_h, k + 1), target_color, dtype=int)\n\n    out = np.full((GEN_GRID_SIZE, GEN_GRID_SIZE), GEN_BG, dtype=int)\n    paste(out, source_patch, 0, center_left)\n    paste(out, split_half, t0, center_left - k - 1)\n    paste(out, split_half, t0, center_left + GEN_SOURCE_PERP)\n\n    source_in_r = t0 + t_h + gap\n    other_r = source_in_r + s_h\n    _gen_place_other(out, other_r, center_left, other_color, GEN_BG)\n\n    inp = out.copy()\n    inp[0:s_h, center_left : center_left + GEN_SOURCE_PERP] = GEN_BG\n    inp[t0 : t0 + t_h, center_left - k - 1 : center_left] = GEN_BG\n    inp[t0 : t0 + t_h, center_left + GEN_SOURCE_PERP : center_left + k + 3] = GEN_BG\n    paste(inp, target_patch, t0, center_left - k)\n    paste(inp, source_patch, source_in_r, center_left)\n    return inp, out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    colors = random.sample(GEN_FG_COLORS, 3)\n    layout = _gen_choose_layout()\n    if layout is None:\n        return None\n    inp, out = _gen_canonical_pair(*layout, colors)\n\n    orientation = random.randrange(GEN_ORIENTATION_COUNT)\n    inp = _gen_transform(inp, orientation)\n    out = _gen_transform(out, orientation)\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except AssertionError:\n        return None\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 9f669b64 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"awk 'BEGIN{show=0} /\"'^def main'\"\\\\(/{show=1} show{print} /\"'^def generate_input'\"\\\\(/{if(gen++) exit}' /home/lixinyu/snap/new/ARC_code/eval/cbebaa4b.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"awk 'BEGIN{show=0} /\"'^def main'\"\\\\(/{show=1} show{print} /\"'^def generate_input'\"\\\\(/{if(gen++) exit}' /home/lixinyu/snap/new/ARC_code/eval/cbebaa4b.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble scattered jigsaw sprites around a central yellow anchor by pairing red connector pixels.\n\n    Input structure:\n    - bg = black (0). Several colored sprites scattered on the grid.\n    - One anchor sprite contains a 3×3 yellow (4) block.\n    - Each sprite has red (2) connector pixels along its edges.\n\n    Rule:\n    - The anchor stays in place; remaining sprites attach one at a time.\n    - Each sprite is translated so that one of its red pixels overlaps an unpaired red pixel on the growing assembly.\n    - Every red connector must pair with exactly one other, forming a complete joined structure.\n\n    Key insight: Red pixels act as jigsaw pegs — each must match exactly one counterpart, and the assembly order is determined by which unpaired connectors remain.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = 0\n\n    pieces = _extract_pieces(g, bg)\n    assert pieces, \"input must have at least one colored piece\"\n\n    # Anchor is the unique piece containing the 3x3 yellow (color 4) block.\n    anchors = [p for p in pieces if np.any(p[\"arr\"] == 4)]\n    assert len(anchors) == 1, \"input must have exactly one yellow (4) anchor piece\"\n    anchor = anchors[0]\n    rest = [p for p in pieces if p is not anchor]\n\n    canvas = np.full((h, w), bg, dtype=int)\n    ar0, ac0, _, _ = anchor[\"bbox\"]\n    placed = _try_place(canvas, anchor[\"arr\"], ar0, ac0, bg)\n    assert placed is not None, \"anchor piece must fit on canvas at its original position\"\n\n    total_ports = int(sum(len(p[\"reds\"]) for p in pieces))\n    assert total_ports % 2 == 0, \"total red connector ports must be even for complete pairing\"\n    target_unique_red = total_ports // 2\n\n    # Track how many original red pixels map to each assembled red coordinate.\n    red_counts: dict[tuple[int, int], int] = {}\n    for rr, cc in anchor[\"reds\"]:\n        red_counts[(ar0 + rr, ac0 + cc)] = red_counts.get((ar0 + rr, ac0 + cc), 0) + 1\n\n    # Backtracking assembly by pairing up red connector pixels.\n    solutions: list[np.ndarray] = []\n\n    def dfs(cur: np.ndarray, remaining: list[dict], rc: dict[tuple[int, int], int]) -> None:\n        if len(solutions) >= 2:\n            return\n\n        if not remaining:\n            if len(rc) == target_unique_red and all(v == 2 for v in rc.values()):\n                solutions.append(cur)\n            return\n\n        if len(rc) > target_unique_red:\n            return\n\n        # Unpaired reds are exactly those with count==1; always pair one of them next.\n        unpaired = [k for k, v in rc.items() if v == 1]\n        if not unpaired:\n            return\n\n        rc1 = {k for k, v in rc.items() if v == 1}\n\n        # Pick the most constrained unpaired red coordinate: fewest ways to cover it.\n        best_moves = None\n        for t in unpaired:\n            moves = []\n            tr, tc = t\n            for idx, p in enumerate(remaining):\n                ph, pw = p[\"shape\"]\n                for pr, pc in p[\"reds\"]:\n                    top = tr - pr\n                    left = tc - pc\n                    if top < 0 or left < 0 or top + ph > h or left + pw > w:\n                        continue\n                    # quick red-count feasibility\n                    bad = False\n                    overlap = 0\n                    for rr, cc in p[\"reds\"]:\n                        gr, gc = top + rr, left + cc\n                        prev = rc.get((gr, gc), 0)\n                        if prev >= 2:\n                            bad = True\n                            break\n                        if (gr, gc) in rc1:\n                            overlap += 1\n                    if bad:\n                        continue\n                    # must overlap at least the target (guaranteed), but keep for scoring\n                    moves.append((idx, top, left, overlap))\n            if not moves:\n                return\n            if best_moves is None or len(moves) < len(best_moves):\n                best_moves = moves\n                if len(best_moves) == 1:\n                    break\n\n        assert best_moves is not None, \"there must be at least one feasible connector move\"\n\n        # Deduplicate moves by (piece, top, left) keeping max overlap score.\n        dedup: dict[tuple[int, int, int], int] = {}\n        for idx, top, left, ov in best_moves:\n            k = (idx, top, left)\n            dedup[k] = max(dedup.get(k, 0), ov)\n        moves2 = [(idx, top, left, ov) for (idx, top, left), ov in dedup.items()]\n        moves2.sort(key=lambda x: (-x[3], -remaining[x[0]][\"area\"], x[1], x[2], x[0]))\n\n        for idx, top, left, _ov in moves2:\n            p = remaining[idx]\n            next_remaining = remaining[:idx] + remaining[idx + 1 :]\n\n            next_rc = dict(rc)\n            for rr, cc in p[\"reds\"]:\n                gr, gc = top + rr, left + cc\n                next_rc[(gr, gc)] = next_rc.get((gr, gc), 0) + 1\n\n            nxt = _try_place(cur, p[\"arr\"], top, left, bg)\n            if nxt is None:\n                continue\n            dfs(nxt, next_remaining, next_rc)\n            if len(solutions) >= 2:\n                return\n\n    dfs(placed, rest, red_counts)\n    assert len(solutions) == 1, \"jigsaw assembly must have exactly one valid solution\"\n    return solutions[0]\n\n# --------------- generator (o5x) ---------------\n\n# ── Tunable configuration ──────────────────────────────────────────────\n# Canvas\nGRID_H_RANGE = (22, 26)               # output grid height bounds\nGRID_W_RANGE = (22, 26)               # output grid width bounds\nMAX_ASSEMBLY_DIM = 24                  # assembled jigsaw must fit inside this\n\n# Pieces\nPIECE_COUNT_RANGE = (4, 6)            # non-anchor sprite count\nPIECE_H_RANGE = (4, 7)               # piece bbox height bounds\nPIECE_W_RANGE = (4, 8)               # piece bbox width bounds\nPIECE_DIM_CANDIDATES = 12            # random (h,w) trials per piece placement\nPIECE_COLORS = [1, 3, 5, 6, 7, 8, 9] # available non-red, non-yellow colors\nPIECE_CAP = 2                         # max connections per piece node\nBAR_SKIP_PROB = 0.35                  # probability of dropping one decorative bar\n\n# Anchor\nANCHOR_BLOCK_CHOICES = [(3, 3), (4, 5)]  # yellow block (h, w) options\nANCHOR_CAP_CHOICES = [1, 2]              # max connections for anchor node\n\n# Scatter\nSCATTER_PADDING = 2                   # Chebyshev gap between scattered sprites\n\n# Generation\nGEN_RETRY_LIMIT = 300                 # max attempts before raising RuntimeError\n\n# ── Side geometry lookups ──────────────────────────────────────────────\nSIDES = (\"top\", \"right\", \"bottom\", \"left\")\nOPPOSITE = {\"top\": \"bottom\", \"bottom\": \"top\", \"left\": \"right\", \"right\": \"left\"}\nINWARD = {\"top\": (1, 0), \"bottom\": (-1, 0), \"left\": (0, 1), \"right\": (0, -1)}\n\n\ndef _new_node(kind, h, w, color, top=0, left=0, cap=PIECE_CAP):\n    return {\n        \"kind\": kind, \"shape\": (int(h), int(w)), \"color\": int(color),\n        \"top\": int(top), \"left\": int(left), \"cap\": int(cap),\n        \"sides\": set(), \"ports\": {},\n    }\n\n\ndef _ensure_port(node, side):\n    \"\"\"Lazily assign a random port offset for *side* if not already set.\"\"\"\n    if side in node[\"ports\"]:\n        return\n    h, w = node[\"shape\"]\n    span = h if side in (\"left\", \"right\") else w\n    node[\"ports\"][side] = random.randint(1, span - 3)\n\n\ndef _port_cells(node, side):\n    \"\"\"Return the two local (r, c) cells that form the red connector on *side*.\"\"\"\n    h, w = node[\"shape\"]\n    k = node[\"ports\"][side]\n    if side == \"top\":\n        return [(0, k), (0, k + 1)]\n    if side == \"bottom\":\n        return [(h - 1, k), (h - 1, k + 1)]\n    if side == \"left\":\n        return [(k, 0), (k + 1, 0)]\n    return [(k, w - 1), (k + 1, w - 1)]\n\n\ndef _global_port(node, side):\n    tr, tc = node[\"top\"], node[\"left\"]\n    return [(tr + r, tc + c) for r, c in _port_cells(node, side)]\n\n\ndef _bbox_of(node):\n    h, w = node[\"shape\"]\n    return (node[\"top\"], node[\"left\"], node[\"top\"] + h - 1, node[\"left\"] + w - 1)\n\n\ndef _rects_overlap(a, b):\n    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])\n\n\ndef _union_bbox(nodes):\n    boxes = [_bbox_of(n) for n in nodes]\n    return (\n        min(b[0] for b in boxes), min(b[1] for b in boxes),\n        max(b[2] for b in boxes), max(b[3] for b in boxes),\n    )\n\n\ndef _draw_path(arr, start, end, color, order):\n    \"\"\"Draw an L-shaped path from *start* to *end*, preserving red (2) pixels.\"\"\"\n    r, c = start\n    er, ec = end\n    # order 0: row-first then col; order 1: col-first then row\n    axes = [(r, er, c, True), (c, ec, er, False)] if order == 0 else \\\n           [(c, ec, r, False), (r, er, ec, True)]\n    for a_start, a_end, fixed, is_row in axes:\n        step = 1 if a_end >= a_start else -1\n        for v in range(a_start, a_end + step, step):\n            rr, cc = (v, fixed) if is_row else (fixed, v)\n            if arr[rr, cc] != 2:\n                arr[rr, cc] = color\n\n\ndef _paint_bar(arr, side, color, used):\n    \"\"\"Paint a decorative bar along *side*, skipping corners claimed by *used* sides.\"\"\"\n    h, w = arr.shape\n    is_horizontal = side in (\"top\", \"bottom\")\n    fixed = 0 if side in (\"top\", \"left\") else (h - 1 if side == \"bottom\" else w - 1)\n    span = w if is_horizontal else h\n    # corner neighbors: (index, conflicting side) pairs\n    lo_conflict = \"left\" if is_horizontal else \"top\"\n    hi_conflict = \"right\" if is_horizontal else \"bottom\"\n    for i in range(span):\n        if (i == 0 and lo_conflict in used) or (i == span - 1 and hi_conflict in used):\n            continue\n        if is_horizontal:\n            arr[fixed, i] = color\n        else:\n            arr[i, fixed] = color\n\n\ndef _bar_endpoint(shape, side, hub):\n    h, w = shape\n    hr, hc = hub\n    if side in (\"top\", \"bottom\"):\n        row = 0 if side == \"top\" else h - 1\n        return (row, min(max(hc, 1), w - 2))\n    col = 0 if side == \"left\" else w - 1\n    return (min(max(hr, 1), h - 2), col)\n\n\ndef _make_piece(node):\n    \"\"\"Render a piece sprite array with red connectors and decorative bars.\"\"\"\n    h, w = node[\"shape\"]\n    color = node[\"color\"]\n    used = set(node[\"sides\"])\n    arr = np.zeros((h, w), dtype=int)\n    hub = (random.randint(1, h - 2), random.randint(1, w - 2))\n\n    bar_sides = [s for s in SIDES if s not in used]\n    if len(bar_sides) > 1 and random.random() < BAR_SKIP_PROB:\n        bar_sides.remove(random.choice(bar_sides))\n    for side in bar_sides:\n        _paint_bar(arr, side, color, used)\n\n    terminals = []\n    for side in used:\n        dr, dc = INWARD[side]\n        for r, c in _port_cells(node, side):\n            arr[r, c] = 2\n            rr, cc = r + dr, c + dc\n            arr[rr, cc] = color\n            terminals.append((rr, cc))\n\n    arr[hub] = color\n    order = random.randint(0, 1)\n    for t in terminals:\n        _draw_path(arr, t, hub, color, order)\n    for side in bar_sides:\n        _draw_path(arr, hub, _bar_endpoint((h, w), side, hub), color, 1 - order)\n\n    if len(components_mask(arr != 0, connectivity=4)) != 1:\n        return None\n    if int(np.sum(arr == 2)) != 2 * len(used):\n        return None\n    return arr\n\n\ndef _make_anchor(node):\n    bh, bw = node[\"block\"]\n    h, w = node[\"shape\"]\n    arr = np.zeros((h, w), dtype=int)\n    arr[1 : 1 + bh, 1 : 1 + bw] = 4\n    for side in node[\"sides\"]:\n        for r, c in _port_cells(node, side):\n            arr[r, c] = 2\n    return arr\n\n\ndef _candidate_fits(nodes, parent_i, child):\n    \"\"\"Check child overlaps only its parent and total assembly stays within bounds.\"\"\"\n    cb = _bbox_of(child)\n    if not _rects_overlap(cb, _bbox_of(nodes[parent_i])):\n        return False\n    for i, other in enumerate(nodes):\n        if i == parent_i:\n            continue\n        if _rects_overlap(cb, _bbox_of(other)):\n            return False\n    r0, c0, r1, c1 = _union_bbox(nodes + [child])\n    return (r1 - r0 + 1) <= MAX_ASSEMBLY_DIM and (c1 - c0 + 1) <= MAX_ASSEMBLY_DIM\n\n\ndef _grow_tree():\n    \"\"\"Build a tree of connected nodes (1 anchor + N pieces) in local coordinates.\"\"\"\n    bh, bw = random.choice(ANCHOR_BLOCK_CHOICES)\n    anchor = _new_node(\"anchor\", bh + 2, bw + 2, 4, cap=random.choice(ANCHOR_CAP_CHOICES))\n    anchor[\"block\"] = (bh, bw)\n    nodes = [anchor]\n    n_pieces = random.randint(*PIECE_COUNT_RANGE)\n    colors = random.sample(PIECE_COLORS, n_pieces)\n\n    for i in range(n_pieces):\n        placed = False\n        dims = [(random.randint(*PIECE_H_RANGE), random.randint(*PIECE_W_RANGE))\n                for _ in range(PIECE_DIM_CANDIDATES)]\n        random.shuffle(dims)\n        for ph, pw in dims:\n            parents = [j for j, n in enumerate(nodes) if len(n[\"sides\"]) < n[\"cap\"]]\n            random.shuffle(parents)\n            for parent_i in parents:\n                parent = nodes[parent_i]\n                sides = [s for s in SIDES if s not in parent[\"sides\"]]\n                random.shuffle(sides)\n                for side in sides:\n                    child = _new_node(\"piece\", ph, pw, colors[i])\n                    incoming = OPPOSITE[side]\n                    _ensure_port(parent, side)\n                    _ensure_port(child, incoming)\n                    pr, pc = _global_port(parent, side)[0]\n                    cr, cc = _port_cells(child, incoming)[0]\n                    child[\"top\"] = pr - cr\n                    child[\"left\"] = pc - cc\n                    child[\"sides\"].add(incoming)\n                    if not _candidate_fits(nodes, parent_i, child):\n                        continue\n                    parent[\"sides\"].add(side)\n                    nodes.append(child)\n                    placed = True\n                    break\n                if placed:\n                    break\n            if placed:\n                break\n        if not placed:\n            return None\n    return nodes\n\n\ndef _place_node_on_canvas(out, node, sr, sc):\n    \"\"\"Stamp a single node's sprite onto *out*, tracking red overlaps.\n\n    Returns red_counts dict on success, or None on conflict.\n    \"\"\"\n    arr = node[\"arr\"]\n    top, left = node[\"top\"] + sr, node[\"left\"] + sc\n    node[\"pos\"] = (top, left)\n    red_counts = {}\n    mask = arr != 0\n    rows, cols = np.nonzero(mask)\n    g_rows, g_cols = rows + top, cols + left\n    vals = arr[rows, cols]\n    cur_vals = out[g_rows, g_cols]\n    # Conflict: non-bg destination that isn't a red-on-red overlap\n    conflicts = (cur_vals != 0) & ~((cur_vals == 2) & (vals == 2))\n    if np.any(conflicts):\n        return None\n    # Track red overlap counts\n    red_mask = vals == 2\n    for gr, gc in zip(g_rows[red_mask], g_cols[red_mask]):\n        key = (int(gr), int(gc))\n        red_counts[key] = red_counts.get(key, 0) + 1\n    # Paint non-overlapping pixels\n    paint_mask = cur_vals == 0\n    out[g_rows[paint_mask], g_cols[paint_mask]] = vals[paint_mask]\n    return red_counts\n\n\ndef _assemble(nodes, h, w):\n    \"\"\"Render all nodes, shift into grid, and validate the assembled output.\"\"\"\n    for node in nodes:\n        node[\"arr\"] = _make_anchor(node) if node[\"kind\"] == \"anchor\" else _make_piece(node)\n        if node[\"arr\"] is None:\n            return None\n\n    r0, c0, r1, c1 = _union_bbox(nodes)\n    if (r1 - r0 + 1) > h or (c1 - c0 + 1) > w:\n        return None\n    sr = random.randint(-r0, h - 1 - r1)\n    sc = random.randint(-c0, w - 1 - c1)\n\n    out = np.zeros((h, w), dtype=int)\n    all_red_counts = {}\n    for node in nodes:\n        rc = _place_node_on_canvas(out, node, sr, sc)\n        if rc is None:\n            return None\n        for k, v in rc.items():\n            all_red_counts[k] = all_red_counts.get(k, 0) + v\n\n    total_ports = sum(int(np.sum(n[\"arr\"] == 2)) for n in nodes)\n    if len(all_red_counts) * 2 != total_ports:\n        return None\n    if any(v != 2 for v in all_red_counts.values()):\n        return None\n    if len(components_mask(out != 0, connectivity=4)) != 1:\n        return None\n    return out\n\n\ndef _scatter(nodes, h, w):\n    \"\"\"Place anchor at its assembled position, then scatter remaining pieces.\"\"\"\n    inp = np.zeros((h, w), dtype=int)\n    anchor = nodes[0]\n    paste(inp, anchor[\"arr\"], *anchor[\"pos\"], transparent=0)\n    rest = nodes[1:]\n    random.shuffle(rest)\n    for node in rest:\n        try:\n            r, c = random_free_location(\n                inp, node[\"arr\"], transparent=0,\n                padding=SCATTER_PADDING, padding_connectivity=8)\n        except ValueError:\n            return None\n        paste(inp, node[\"arr\"], r, c, transparent=0)\n    return inp\n\n\ndef _gen_attempt():\n    h = random.randint(*GRID_H_RANGE)\n    w = random.randint(*GRID_W_RANGE)\n    nodes = _grow_tree()\n    if nodes is None:\n        return None\n    out = _assemble(nodes, h, w)\n    if out is None:\n        return None\n    inp = _scatter(nodes, h, w)\n    if inp is None:\n        return None\n    try:\n        solved = main(inp)\n    except Exception:\n        return None\n    if np.array_equal(solved, out):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise 