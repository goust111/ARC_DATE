{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"awk 'BEGIN{show=0} /\"'^def main'\"\\\\(/{show=1} show{print} /\"'^def generate_input'\"\\\\(/{if(gen++) exit}' /home/lixinyu/snap/new/ARC_code/train/e4888269.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Recolor every target pixel by following the ordered two-column substitution legend.\n\n    Input structure\n    - A dominant background surrounds one multicolor vertical legend: a connected,\n      fully filled two-column block with one color pair per row.\n    - Other non-background pixels or objects are the targets; divider or frame\n      pixels are ordinary target-side structure that remain unchanged unless their\n      color is rewritten by the legend.\n\n    Rule\n    - Read the legend rows from top to bottom as substitutions from the left\n      column color to the right column color.\n    - For each non-background pixel outside the legend, scan those rows in order;\n      whenever the current color equals the row's left color, replace it with the\n      row's right color and keep scanning lower rows.\n    - Leave the legend itself and background pixels unchanged.\n\n    Key insight\n    - The same color may be rewritten multiple times, but only by substitutions\n      that appear later in the vertical legend, so the row order is part of the\n      symbol instruction.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    r0, c0, r1, c1 = _legend_bbox(g, bg)\n    separator_lines = _full_separator_lines(g, bg, (r0, c0, r1, c1))\n    assert len(separator_lines) <= 1, \"expected at most one full separator line\"\n    assert all(_line_separates_targets(g, bg, (r0, c0, r1, c1), line) for line in separator_lines)\n    pairs = [(int(g[r, c0]), int(g[r, c1])) for r in range(r0, r1 + 1)]\n\n    legend_mask = np.zeros(g.shape, dtype=bool)\n    legend_mask[r0 : r1 + 1, c0 : c1 + 1] = True\n\n    out = g.copy()\n    targets = np.argwhere((g != bg) & (~legend_mask))\n    for r, c in targets:\n        color = int(g[r, c])\n        for src, dst in pairs:\n            if color == src:\n                color = dst\n        out[r, c] = color\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# Canvas and palette bounds.\nGRID_HEIGHT_BOUNDS = (10, 30)\nGRID_WIDTH_BOUNDS = (13, 30)\nCOLOR_VALUES = tuple(range(10))\nPALETTE_SIZE_BOUNDS = (5, 8)\n\n# Legend construction and chain constraints.\nLEGEND_WIDTH = 2\nLEGEND_ROW_CHOICES = (3, 4, 5, 6, 7)\nLEGEND_ROW_WEIGHTS = (1, 2, 2, 3, 4)\nMIN_LEGEND_COLORS = 3\nPAIR_BUILD_RETRIES = 100\nCHAIN_THREE_MIN_ROWS = 4\nCHAIN_THREE_PROB = 0.75\nMIN_CHAIN_STEPS = 2\n\n# Blob shape sampling.\nSINGLE_PIXEL_PROB = 0.45\nBLOB_HEIGHT_BOUNDS = (1, 3)\nBLOB_WIDTH_BOUNDS = (1, 4)\nBLOB_DENSITY = 0.7\n\n# Layout and placement controls.\nLEGEND_BORDER = 1\nLEGEND_PADDING = 1\nDIVIDER_PROB = 0.85\nDIVIDER_TARGET_MIN_SPAN = 3\nTARGET_COUNT_BOUNDS = (5, 14)\nTARGET_MULTI_STEP_PROB = 0.65\nTARGET_ONE_STEP_PROB = 0.85\nMIN_PLACED_TARGETS = 3\n\n# Retry limits.\nGEN_ATTEMPTS = 300\n\n\ndef _gen_apply_chain(color: int, pairs: list[tuple[int, int]]) -> int:\n    current = color\n    for src, dst in pairs:\n        if current == src:\n            current = dst\n    return current\n\n\ndef _gen_chain_steps(color: int, pairs: list[tuple[int, int]]) -> int:\n    current = color\n    steps = 0\n    for src, dst in pairs:\n        if current == src:\n            current = dst\n            steps += 1\n    return steps\n\n\ndef _gen_build_pairs(available: list[int], n_rows: int) -> list[tuple[int, int]] | None:\n    \"\"\"Build an ordered legend with at least one intentional 2-3 step chain.\"\"\"\n    for _ in range(PAIR_BUILD_RETRIES):\n        chain_len = 3 if n_rows >= CHAIN_THREE_MIN_ROWS and random.random() < CHAIN_THREE_PROB else 2\n        chain = random.sample(available, chain_len + 1)\n        pairs = [(chain[i], chain[i + 1]) for i in range(chain_len)]\n\n        while len(pairs) < n_rows:\n            src = random.choice(available)\n            dst = random.choice([c for c in available if c != src])\n            pairs.append((src, dst))\n\n        legend_colors = {c for pair in pairs for c in pair}\n        src_colors = {src for src, _dst in pairs}\n        if len(legend_colors) < MIN_LEGEND_COLORS:\n            continue\n        if any(_gen_apply_chain(src, pairs) == src for src in src_colors):\n            continue\n        if not any(_gen_chain_steps(src, pairs) >= MIN_CHAIN_STEPS for src in src_colors):\n            continue\n        return pairs\n    return None\n\n\ndef _gen_blob(color: int, bg: int) -> np.ndarray:\n    if random.random() < SINGLE_PIXEL_PROB:\n        return np.array([[color]], dtype=int)\n    bh = random.randint(*BLOB_HEIGHT_BOUNDS)\n    bw = random.randint(*BLOB_WIDTH_BOUNDS)\n    try:\n        blob = random_sprite(bh, bw, color_palette=[color], background=bg, density=BLOB_DENSITY)\n    except Exception:\n        blob = np.array([[color]], dtype=int)\n    if np.count_nonzero(blob != bg) == 0:\n        blob[0, 0] = color\n    return blob\n\n\ndef _gen_place_in_region(grid: np.ndarray, blob: np.ndarray, bg: int, row_range: tuple[int, int], col_range: tuple[int, int]) -> bool:\n    r_min, r_max = row_range\n    c_min, c_max = col_range\n    ph, pw = blob.shape\n    rows = list(range(r_min, r_max - ph + 2))\n    cols = list(range(c_min, c_max - pw + 2))\n    random.shuffle(rows)\n    random.shuffle(cols)\n    local = np.argwhere(blob != bg)\n\n    for r0 in rows:\n        for c0 in cols:\n            if np.all(grid[r0 + local[:, 0], c0 + local[:, 1]] == bg):\n                paste(grid, blob, r0, c0, transparent=bg)\n                return True\n    return False\n\n\ndef _gen_place_divider(grid, available, src_colors, legend_row, legend_col, legend_rows):\n    \"\"\"Optionally draw a full row/column divider and return the target region.\"\"\"\n    height, width = grid.shape\n    has_divider = random.random() < DIVIDER_PROB\n    divider_color = None\n    target_region = (0, height - 1, 0, width - 1)\n    if has_divider:\n        non_src_colors = [c for c in available if c not in src_colors]\n        if non_src_colors:\n            divider_color = random.choice(non_src_colors)\n            options = []\n            for dc in range(1, width - 1):\n                if legend_col + LEGEND_WIDTH - 1 < dc and width - dc - 1 >= DIVIDER_TARGET_MIN_SPAN:\n                    options.append((\"col\", dc, (0, height - 1, dc + 1, width - 1)))\n                if dc < legend_col and dc >= DIVIDER_TARGET_MIN_SPAN:\n                    options.append((\"col\", dc, (0, height - 1, 0, dc - 1)))\n            for dr in range(1, height - 1):\n                if legend_row + legend_rows - 1 < dr and height - dr - 1 >= DIVIDER_TARGET_MIN_SPAN:\n                    options.append((\"row\", dr, (dr + 1, height - 1, 0, width - 1)))\n                if dr < legend_row and dr >= DIVIDER_TARGET_MIN_SPAN:\n                    options.append((\"row\", dr, (0, dr - 1, 0, width - 1)))\n            if options:\n                typ, idx, target_region = random.choice(options)\n                if typ == \"row\":\n                    grid[idx, :] = divider_color\n                else:\n                    grid[:, idx] = divider_color\n            else:\n                has_divider = False\n                divider_color = None\n    return has_divider, divider_color, target_region\n\n\ndef _gen_target_colors(available, src_colors, divider_color, pairs):\n    \"\"\"Choose target colors with required changed and unchanged examples.\"\"\"\n    non_src_non_div = [c for c in available\n                       if c not in src_colors and c != divider_color]\n    if not non_src_non_div:\n        return None\n    multi_step_src = [c for c in src_colors if _gen_chain_steps(c, pairs) >= MIN_CHAIN_STEPS]\n    one_step_src = [c for c in src_colors if _gen_chain_steps(c, pairs) == 1]\n    if not multi_step_src:\n        return None\n    n_targets = random.randint(*TARGET_COUNT_BOUNDS)\n    target_colors = [random.choice(multi_step_src), random.choice(multi_step_src)]\n    target_colors.append(random.choice(non_src_non_div))\n    for _ in range(n_targets - MIN_PLACED_TARGETS):\n        roll = random.random()\n        if roll < TARGET_MULTI_STEP_PROB:\n            target_colors.append(random.choice(multi_step_src))\n        elif roll < TARGET_ONE_STEP_PROB and one_step_src:\n            target_colors.append(random.choice(one_step_src))\n        else:\n            target_colors.append(random.choice(non_src_non_div))\n    random.shuffle(target_colors)\n    return target_colors\n\n\ndef _gen_place_targets(grid, target_colors, bg, target_region, has_divider):\n    r_min, r_max, c_min, c_max = target_region\n    placed_targets = 0\n    for target_color in target_colors:\n        blob = _gen_blob(target_color, bg)\n        if has_divider:\n            if _gen_place_in_region(grid, blob, bg, (r_min, r_max), (c_min, c_max)):\n                placed_targets += 1\n        else:\n            try:\n                tr, tc_pos = random_free_location(grid, blob, transparent=bg, padding=LEGEND_PADDING, padding_connectivity=8)\n            except ValueError:\n                continue\n            paste(grid, blob, tr, tc_pos, transparent=bg)\n            placed_targets += 1\n    return placed_targets\n\n\ndef _gen_is_valid(grid: np.ndarray, bg: int, legend_row: int, legend_col: int, legend_rows: int) -> bool:\n    \"\"\"Check legend uniqueness, minimum targets, and solver acceptance.\"\"\"\n    try:\n        _legend_bbox(grid, bg)\n    except Exception:\n        return False\n\n    legend_mask = np.zeros(grid.shape, dtype=bool)\n    legend_mask[legend_row:legend_row + legend_rows, legend_col:legend_col + LEGEND_WIDTH] = True\n    if np.count_nonzero((grid != bg) & (~legend_mask)) < MIN_PLACED_TARGETS:\n        return False\n\n    inp = grid.copy()\n    try:\n        out = main(inp)\n    except Exception:\n        return False\n    return np.array_equal(main(grid), out)\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid input for e4888269.\"\"\"\n    height = random.randint(*GRID_HEIGHT_BOUNDS)\n    width = random.randint(*GRID_WIDTH_BOUNDS)\n    bg = random.randint(COLOR_VALUES[0], COLOR_VALUES[-1])\n    grid = np.full((height, width), bg, dtype=int)\n    available = [c for c in COLOR_VALUES if c != bg]\n\n    legend_rows = random.choices(LEGEND_ROW_CHOICES, weights=LEGEND_ROW_WEIGHTS)[0]\n    n_palette = min(random.randint(*PALETTE_SIZE_BOUNDS), len(available))\n    palette = random.sample(available, n_palette)\n    pairs = _gen_build_pairs(palette, legend_rows)\n    if pairs is None:\n        return None\n    src_colors = set(s for s, _dst in pairs)\n    legend_block = np.array([[s, d] for s, d in pairs], dtype=int)\n\n    try:\n        legend_row, legend_col = random_free_location(grid, legend_block, transparent=bg, border=LEGEND_BORDER, padding=LEGEND_PADDING)\n    except ValueError:\n        return None\n    paste(grid, legend_block, legend_row, legend_col)\n\n    has_divider, divider_color, target_region = _gen_place_divider(grid, available, src_colors, legend_row, legend_col, legend_rows)\n\n    target_colors = _gen_target_colors(available, src_colors, divider_color, pairs)\n    if target_colors is None:\n        return None\n    placed_targets = _gen_place_targets(grid, target_colors, bg, target_region, has_divider)\n    if placed_targets < MIN_PLACED_TARGETS:\n        return None\n\n    if not _gen_is_valid(grid, bg, legend_row, legend_col, legend_rows):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GEN_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"awk 'BEGIN{show=0} /\"'^def main'\"\\\\(/{show=1} show{print} /\"'^def generate_input'\"\\\\(/{if(gen++) exit}' /home/lixinyu/snap/new/ARC_code/train/b25e450b.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"awk 'BEGIN{show=0} /\"'^def main'\"\\\\(/{show=1} show{print} /\"'^def generate_input'\"\\\\(/{if(gen++) exit}' /home/lixinyu/snap/new/ARC_code/train/b25e450b.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide each black border rectangle to the opposite border, recoloring its swept stripe orange and leaving the rectangle black at the far edge.\n\n    Input structure\n    - The grid contains black rectangular 4-connected masks, each touching exactly one outer border.\n    - Grey cells form incidental pattern content; orange is the trail color used when a black mask slides.\n\n    Rule\n    - Treat all black rectangles as moving simultaneously.\n    - A rectangle touching the top or bottom edge moves vertically to the opposite edge in the same columns.\n    - A rectangle touching the left or right edge moves horizontally to the opposite edge in the same rows.\n    - Recolor the complete swept row or column stripe to orange, then stamp every destination rectangle in black.\n\n    Key insight\n    - Edge contact gives the slide direction; the output is the set of opposite-edge black rectangles plus their orange trails.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h > 0 and w > 0\n\n    moving = Color.BLACK\n    trail = Color.ORANGE\n    assert np.any(g == moving), \"expected at least one black rectangle\"\n    assert np.any(g == trail), \"expected orange trail color to be present\"\n\n    out = g.copy()\n    targets: list[BBox] = []\n    for coords in components_mask(g == moving, connectivity=4):\n        r0, c0, r1, c1 = bbox_coords(coords)\n        rect_h = r1 - r0 + 1\n        rect_w = c1 - c0 + 1\n        assert int(coords.shape[0]) == rect_h * rect_w, \"black mask must be a solid rectangle\"\n\n        side = _edge_side((r0, c0, r1, c1), g.shape)\n        if side == \"top\":\n            out[:, c0 : c1 + 1] = trail\n            targets.append((h - rect_h, c0, h - 1, c1))\n        elif side == \"bottom\":\n            out[:, c0 : c1 + 1] = trail\n            targets.append((0, c0, rect_h - 1, c1))\n        elif side == \"left\":\n            out[r0 : r1 + 1, :] = trail\n            targets.append((r0, w - rect_w, r1, w - 1))\n        else:\n            assert side == \"right\"\n            out[r0 : r1 + 1, :] = trail\n            targets.append((r0, 0, r1, rect_w - 1))\n\n    for r0, c0, r1, c1 in targets:\n        out[r0 : r1 + 1, c0 : c1 + 1] = moving\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and palette.\nMIN_H, MAX_H = 6, 18\nMIN_W, MAX_W = 8, 14\nBG_GREY, BG_ORANGE = 5, 7\nGREY_FRAC_MIN, GREY_FRAC_MAX = 0.2, 0.6\n\n# Rectangle and band constraints.\nMIN_RECTS, MAX_RECTS = 1, 8\nMIN_BAND_SIZE, MAX_BAND_SIZE = 1, 6\nBAND_GAP = 1\nMIN_RECT_AREA, MAX_RECT_AREA = 2, 18\nMAX_RECT_SIDE = 6\nSOURCE_EDGE_OFFSET = 1\n\n# Retry limits.\nTARGET_COUNT_ATTEMPTS = 300\nANY_COUNT_ATTEMPTS = 100\n\n\ndef _partition_bands(\n    total: int, n: int, min_size: int, max_size: int, min_gap: int = 0\n) -> list[tuple[int, int]] | None:\n    \"\"\"Place n non-overlapping inclusive bands inside [0, total - 1].\"\"\"\n    if n == 0:\n        return []\n\n    needed = n * min_size + (n - 1) * min_gap\n    if needed > total:\n        return None\n\n    effective_max = min(max_size, total - (n - 1) * (min_size + min_gap))\n    if effective_max < min_size:\n        return None\n\n    widths = [random.randint(min_size, effective_max) for _ in range(n)]\n    total_used = sum(widths) + (n - 1) * min_gap\n    if total_used > total:\n        excess = total_used - total\n        indices = list(range(n))\n        random.shuffle(indices)\n        for i in indices:\n            shrink = min(widths[i] - min_size, excess)\n            widths[i] -= shrink\n            excess -= shrink\n            if excess == 0:\n                break\n        if excess > 0:\n            return None\n\n    remaining = total - sum(widths) - (n - 1) * min_gap\n    extra_gaps = [0] * (n + 1)\n    for _ in range(remaining):\n        extra_gaps[random.randint(0, n)] += 1\n\n    bands = []\n    pos = 0\n    for i in range(n):\n        pos += extra_gaps[i]\n        if i > 0:\n            pos += min_gap\n        bands.append((pos, pos + widths[i] - 1))\n        pos += widths[i]\n    return bands\n\n\ndef _choose_orientation_counts(n_rects: int) -> tuple[int, int] | None:\n    max_vert = min(n_rects, (MAX_W - SOURCE_EDGE_OFFSET) // 2)\n    max_horiz = min(n_rects, (MAX_H - SOURCE_EDGE_OFFSET) // 2)\n    feasible = [(v, n_rects - v) for v in range(n_rects + 1)\n                if v <= max_vert and (n_rects - v) <= max_horiz]\n    if not feasible:\n        return None\n    return random.choice(feasible)\n\n\ndef _choose_canvas(n_vert: int, n_horiz: int) -> tuple[int, int] | None:\n    min_h = max(MIN_H, 2 * n_horiz + 1) if n_horiz > 0 else MIN_H\n    min_w = max(MIN_W, 2 * n_vert + 1) if n_vert > 0 else MIN_W\n    if min_h > MAX_H or min_w > MAX_W:\n        return None\n    return random.randint(min_h, MAX_H), random.randint(min_w, MAX_W)\n\n\ndef _interior_bands(total: int, n: int) -> list[tuple[int, int]] | None:\n    raw = _partition_bands(total - 2, n, MIN_BAND_SIZE, MAX_BAND_SIZE, BAND_GAP)\n    if raw is None:\n        return None\n    return [(a + SOURCE_EDGE_OFFSET, b + SOURCE_EDGE_OFFSET) for a, b in raw]\n\n\ndef _rect_span_for_band(band_size: int, travel: int) -> int | None:\n    max_len = min(MAX_RECT_SIDE, travel // 2 - 1, MAX_RECT_AREA // band_size)\n    min_len = max(MIN_BAND_SIZE, -(-MIN_RECT_AREA // band_size))\n    if min_len > max_len:\n        return None\n    return random.randint(min_len, max_len)\n\n\ndef _build_rects(H: int, W: int, n_vert: int, n_horiz: int) -> list[tuple[int, int, int, int, str]] | None:\n    \"\"\"Return destination rectangles plus their original source edge.\"\"\"\n    vert_edges = [random.choice([\"top\", \"bottom\"]) for _ in range(n_vert)]\n    horiz_edges = [random.choice([\"left\", \"right\"]) for _ in range(n_horiz)]\n\n    col_bands = _interior_bands(W, n_vert)\n    if col_bands is None:\n        return None\n    row_bands = _interior_bands(H, n_horiz)\n    if row_bands is None:\n        return None\n\n    rects = []\n    for i, (c0, c1) in enumerate(col_bands):\n        rect_w = c1 - c0 + 1\n        rect_h = _rect_span_for_band(rect_w, H)\n        if rect_h is None:\n            return None\n        se = vert_edges[i]\n        if se == \"top\":\n            dr0, dr1 = H - rect_h, H - 1\n        else:\n            dr0, dr1 = 0, rect_h - 1\n        rects.append((dr0, c0, dr1, c1, se))\n\n    for i, (r0, r1) in enumerate(row_bands):\n        rect_h = r1 - r0 + 1\n        rect_w = _rect_span_for_band(rect_h, W)\n        if rect_w is None:\n            return None\n        se = horiz_edges[i]\n        if se == \"left\":\n            dc0, dc1 = W - rect_w, W - 1\n        else:\n            dc0, dc1 = 0, rect_w - 1\n        rects.append((r0, dc0, r1, dc1, se))\n\n    return rects\n\n\ndef _random_background(shape: tuple[int, int], grey_frac: float) -> np.ndarray:\n    return np.where(np.random.random(shape) < grey_frac, BG_GREY, BG_ORANGE).astype(int)\n\n\ndef _render_output(H: int, W: int, rects: list[tuple[int, int, int, int, str]], grey_frac: float) -> np.ndarray:\n    output = _random_background((H, W), grey_frac)\n\n    for (dr0, dc0, dr1, dc1, se) in rects:\n        if se in (\"top\", \"bottom\"):\n            output[:, dc0:dc1 + 1] = BG_ORANGE\n        else:\n            output[dr0:dr1 + 1, :] = BG_ORANGE\n\n    for (dr0, dc0, dr1, dc1, _) in rects:\n        output[dr0:dr1 + 1, dc0:dc1 + 1] = 0\n    return output\n\n\ndef _invert_output_to_input(\n    output: np.ndarray, rects: list[tuple[int, int, int, int, str]], grey_frac: float\n) -> np.ndarray:\n    H, W = output.shape\n    inp = output.copy()\n\n    for (dr0, dc0, dr1, dc1, se) in rects:\n        if se in (\"top\", \"bottom\"):\n            inp[:, dc0:dc1 + 1] = _random_background((H, dc1 - dc0 + 1), grey_frac)\n        else:\n            inp[dr0:dr1 + 1, :] = _random_background((dr1 - dr0 + 1, W), grey_frac)\n\n    for (dr0, dc0, dr1, dc1, se) in rects:\n        rh, rw = dr1 - dr0 + 1, dc1 - dc0 + 1\n        if se == \"top\":\n            inp[0:rh, dc0:dc1 + 1] = 0\n        elif se == \"bottom\":\n            inp[H - rh:H, dc0:dc1 + 1] = 0\n        elif se == \"left\":\n            inp[dr0:dr1 + 1, 0:rw] = 0\n        else:\n            inp[dr0:dr1 + 1, W - rw:W] = 0\n\n    return inp\n\n\ndef _is_valid_pair(inp: np.ndarray, output: np.ndarray) -> bool:\n    try:\n        return bool(np.array_equal(main(inp), output))\n    except Exception:\n        return False\n\n\ndef _gen_attempt_with_count(n_rects: int) -> np.ndarray | None:\n    \"\"\"Generate a valid input with exactly n_rects black rectangles.\"\"\"\n    counts = _choose_orientation_counts(n_rects)\n    if counts is None:\n        return None\n    n_vert, n_horiz = counts\n\n    canvas = _choose_canvas(n_vert, n_horiz)\n    if canvas is None:\n        return None\n    H, W = canvas\n\n    rects = _build_rects(H, W, n_vert, n_horiz)\n    if rects is None:\n        return None\n\n    grey_frac = random.uniform(GREY_FRAC_MIN, GREY_FRAC_MAX)\n    output = _render_output(H, W, rects, grey_frac)\n    inp = _invert_output_to_input(output, rects, grey_frac)\n    return inp if _is_valid_pair(inp, output) else None\n\n\ndef generate_input() -> np.ndarray:\n    target_count = random.randint(MIN_RECTS, MAX_RECTS)\n    for _ in range(TARGET_COUNT_ATTEMPTS):\n        result = _gen_attempt_with_count(target_count)\n        if result is not None:\n            return result\n    for _ in range(ANY_COUNT_ATTEMPTS):\n        result = _gen_attempt_with_count(random.randint(MIN_RECTS, MAX_RECTS))\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {TARGET_COUNT_ATTEMPTS + ANY_COUNT_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
