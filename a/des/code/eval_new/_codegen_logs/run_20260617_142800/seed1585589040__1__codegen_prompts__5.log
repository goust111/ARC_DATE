{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"awk 'BEGIN{show=0} /\"'^def main'\"\\\\(/{show=1} show{print} /\"'^def generate_input'\"\\\\(/{if(gen++) exit}' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\n\ndef _get_enclosed_holes(sprite):\n    \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n    h, w = sprite.shape\n    return [pts for pts in components_mask(~sprite, connectivity=4)\n            if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n\n\ndef _make_diamond():\n    \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n    s = np.zeros((3, 3), dtype=bool)\n    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n    return s\n\n\ndef _make_hollow_sprite(h, w, rng):\n    \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n    sprite = np.ones((h, w), dtype=bool)\n    if h >= 3 and w >= 3:\n        sprite[1:-1, 1:-1] = False\n    # Optionally add internal horizontal wall\n    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n        br = rng.randint(2, h - 2)\n        n = rng.randint(1, w - 2)\n        s = rng.randint(1, w - 1 - n + 1)\n        sprite[br, s:s + n] = True\n    # Optionally add internal vertical wall\n    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:\n        bc = rng.randint(2, w - 2)\n        n = rng.randint(1, h - 2)\n        s = rng.randint(1, h - 1 - n + 1)\n        sprite[s:s + n, bc] = True\n    # Optionally remove border cells for irregularity\n    if rng.random() < _P_BORDER_REMOVAL:\n        bcells = [(r, c) for r in range(h) for c in range(w)\n                  if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]\n        rng.shuffle(bcells)\n        for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:\n            test = sprite.copy()\n            test[cr, cc] = False\n            if _get_enclosed_holes(test):\n                sprite = test\n    if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:\n        return None\n    return sprite\n\n\ndef _choose_colors(rng, N, num_filled):\n    \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n    all_c = list(range(1, 10))\n    rng.shuffle(all_c)\n    border_keys = all_c[:N]\n    rng.shuffle(all_c)\n    fill_values = all_c[:N]\n    dist_cands = [c for c in range(1, 10) if c not in border_keys]\n    distractor_color = rng.choice(dist_cands)\n    mapping = dict(zip(border_keys, fill_values))\n    filled_keys = rng.sample(border_keys, num_filled)\n    return border_keys, fill_values, distractor_color, mapping, filled_keys\n\n\ndef _build_palette(side, border_keys, fill_values):\n    \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n    N = len(border_keys)\n    if side in ('top', 'bottom'):\n        pal = np.zeros((2, N), dtype=int)\n        outer, inner = (0, 1) if side == 'top' else (1, 0)\n        pal[outer] = border_keys\n        pal[inner] = fill_values\n    else:\n        pal = np.zeros((N, 2), dtype=int)\n        outer, inner = (0, 1) if side == 'left' else (1, 0)\n        pal[:, outer] = border_keys\n        pal[:, inner] = fill_values\n    return pal\n\n\ndef _place_palette(grid, occ, pal, side, rng):\n    \"\"\"Place palette on the chosen edge and mark its occupancy (with 1-cell padding).\"\"\"\n    H, W = grid.shape\n    pal_h, pal_w = pal.shape\n    if side == 'top':\n        pr0, pc0 = 0, rng.randint(0, W - pal_w)\n    elif side == 'bottom':\n        pr0, pc0 = H - pal_h, rng.randint(0, W - pal_w)\n    elif side == 'left':\n        pr0, pc0 = rng.randint(0, H - pal_h), 0\n    else:\n        pr0, pc0 = rng.randint(0, H - pal_h), W - pal_w\n    grid[pr0:pr0 + pal_h, pc0:pc0 + pal_w] = pal\n    occ[max(0, pr0 - 1):min(H, pr0 + pal_h + 1),\n        max(0, pc0 - 1):min(W, pc0 + pal_w + 1)] = True\n\n\ndef _find_valid_positions(H, W, occ, mask, holes):\n    \"\"\"Find all (r0, c0) where mask fits without overlap and holes don't touch grid boundary.\"\"\"\n    sh, sw = mask.shape\n    positions = []\n    for r0 in range(H - sh + 1):\n        for c0 in range(W - sw + 1):\n            if occ[max(0, r0 - 1):min(H, r0 + sh + 1),\n                   max(0, c0 - 1):min(W, c0 + sw + 1)].any():\n                continue\n            if any(r0 + hr == 0 or c0 + hc == 0 or r0 + hr == H - 1 or c0 + hc == W - 1\n                   for hpts in holes for hr, hc in hpts):\n                continue\n            positions.append((r0, c0))\n    return positions\n\n\ndef _paint_sprite(grid, r0, c0, mask, color, fill, holes):\n    \"\"\"Render a sprite onto the grid: border cells in color, hole cells in fill (if given).\"\"\"\n    grid[r0:r0 + mask.shape[0], c0:c0 + mask.shape[1]][mask] = color\n    if fill is not None:\n        for hpts in holes:\n            for hr, hc in hpts:\n                grid[r0 + hr, c0 + hc] = fill\n\n\ndef _gen_attempt():\n    rng = random.Random()\n    bg = 0\n\n    # Grid size and palette side\n    H = rng.randint(_GRID_H_MIN, _GRID_H_MAX)\n    W = rng.randint(_GRID_W_MIN, _GRID_W_MAX)\n    side = rng.choice(['top', 'bottom', 'left', 'right'])\n    if H <= _SMALL_H_THRESHOLD and side in ('top', 'bottom') and rng.random() < _SMALL_H_PALETTE_FLIP:\n        side = rng.choice(['left', 'right'])\n\n    max_N = H if side in ('left', 'right') else W\n    N = rng.randint(_PALETTE_N_MIN, min(_PALETTE_N_MAX, max_N))\n\n    # Sprite dimension bounds\n    max_sh = min(_SPRITE_H_MAX, H)\n    max_sw = min(_SPRITE_W_MAX, W)\n    if H <= _TINY_H_THRESHOLD:\n        max_sh = 3\n\n    # Sprite counts\n    num_filled = rng.randint(1, min(_FILLED_SPRITE_MAX, N))\n    total_sprites = num_filled + 1\n\n    # Generate sprite shapes\n    shapes = []\n    for _ in range(total_sprites):\n        sh = rng.randint(3, max_sh)\n        sw = rng.randint(3, max_sw)\n        if sh + sw > _SPRITE_DIM_SUM_CAP:\n            sw = max(3, _SPRITE_DIM_SUM_CAP - sh)\n        if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:\n            mask = _make_diamond()\n        else:\n            mask = _make_hollow_sprite(sh, sw, rng)\n        if mask is None:\n            return None\n        shapes.append(mask)\n\n    # Colors and palette\n    border_keys, fill_values, distractor_color, mapping, filled_keys = \\\n        _choose_colors(rng, N, num_filled)\n    pal = _build_palette(side, border_keys, fill_values)\n\n    grid = np.full((H, W), bg, dtype=int)\n    occ = np.zeros((H, W), dtype=bool)\n    _place_palette(grid, occ, pal, side, rng)\n\n    # Assign colors to sprites: filled sprites use palette keys, last one is distractor\n    infos = []\n    for i, mask in enumerate(shapes):\n        if i < num_filled:\n            c, f = filled_keys[i], mapping[filled_keys[i]]\n        else:\n            c, f = distractor_color, None\n        infos.append((mask, c, f))\n\n    # Place sprites\n    placed = []\n    for mask, color, fill in infos:\n        holes = _get_enclosed_holes(mask)\n        positions = _find_valid_positions(H, W, occ, mask, holes)\n        if not positions:\n            return None\n        r0, c0 = rng.choice(positions)\n        _paint_sprite(grid, r0, c0, mask, color, fill, holes)\n        placed.append((r0, c0, mask, fill))\n        sh, sw = mask.shape\n        occ[max(0, r0 - 1):min(H, r0 + sh + 1),\n            max(0, c0 - 1):min(W, c0 + sw + 1)] = True\n\n    # Derive input from output by clearing filled holes\n    output = grid.copy()\n    inp = grid.copy()\n    for r0, c0, mask, fill in placed:\n        if fill is not None:\n            for hpts in _get_enclosed_holes(mask):\n                for hr, hc in hpts:\n                    inp[r0 + hr, c0 + hc] = bg\n\n    # Validate bg is dominant on border\n    border = np.concatenate([inp[0], inp[-1], inp[1:-1, 0], inp[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    if int(vals[cnts.argmax()]) != bg:\n        return None\n\n    # Oracle check\n    try:\n        if np.array_equal(main(inp), output):\n            return inp\n    except Exception:\n        pass\n    return None\n\n\ndef generate_input():\n    for _ in range(_MAX_RETRIES):\n        r = _gen_attempt()\n        if r is not None:\n            return r\n    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"awk 'BEGIN{show=0} /\"'^def main'\"\\\\(/{show=1} show{print} /\"'^def generate_input'\"\\\\(/{if(gen++) exit}' /home/lixinyu/snap/new/ARC_code/train/afe3afe9.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"awk 'BEGIN{show=0} /\"'^def main'\"\\\\(/{show=1} show{print} /\"'^def generate_input'\"\\\\(/{if(gen++) exit}' /home/lixinyu/snap/new/ARC_code/train/afe3afe9.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Convert each hollow 3x3 symbol to one pixel and slide the pixels clockwise from the marked edge.\n\n    Input structure\n    - The grid has a background, one full-edge marker line, and monochrome hollow 3x3 foreground symbols.\n    - The symbols lie on a coarse row/column lattice; fully empty lattice rows or columns are absent from the output.\n\n    Rule\n    - Replace each hollow 3x3 symbol with one pixel of its color in the corresponding coarse-grid cell.\n    - The marker edge gives the compaction direction by clockwise border travel: top -> right, right -> down, bottom -> left, left -> up.\n    - Preserve the order of non-background pixels while sliding them as far as possible in that direction.\n\n    Key insight\n    - The large picture is a scaled symbolic grid, and the blue edge marker acts as a gravity direction rather than as output content.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    symbolic, side, bg = _symbolic_grid(g)\n    return _compact(symbolic, side, bg)\n\n# --------------- generator (att2) ---------------\n\n# Canvas and colors.\nGEN_BG = 0\nGEN_GRID_SHAPE = (30, 30)\nGEN_MARKER_COLOR = 1\nGEN_DOMINANT_COLOR = 8\nGEN_ACCENT_COLORS = [2, 3, 4, 5, 6, 7, 9]\n\n# Symbolic lattice layout.\nGEN_SIDES = [\"top\", \"right\", \"bottom\", \"left\"]\nGEN_SYMBOLIC_HW = (7, 6)\nGEN_SYMBOLIC_VW = (6, 7)\nGEN_DOMINANT_COUNT_RANGE = (13, 17)\nGEN_ACCENT_COUNT_RANGE = (6, 8)\nGEN_SPLIT_INDEX = 3\n\n# Physical lattice coordinates.\nGEN_GAP_SIX_POSITIONS = [1, 5, 9, 17, 21, 25]\nGEN_SEVEN_FROM_MARKER = [2, 6, 10, 14, 18, 22, 26]\nGEN_SEVEN_FROM_OTHER = [1, 5, 9, 13, 17, 21, 25]\nGEN_SYMBOL_PATCH_SIZE = 3\n\n# Generation retries.\nGEN_MAX_ATTEMPTS = 300\n\ndef _gen_compact(symbolic, side, bg):\n    out = np.full_like(symbolic, bg)\n\n    if side == \"top\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, symbolic.shape[1] - len(values) :] = values\n    elif side == \"right\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[symbolic.shape[0] - len(values) :, c] = values\n    elif side == \"bottom\":\n        for r, row in enumerate(symbolic):\n            values = [int(v) for v in row if int(v) != bg]\n            out[r, : len(values)] = values\n    elif side == \"left\":\n        for c in range(symbolic.shape[1]):\n            values = [int(v) for v in symbolic[:, c] if int(v) != bg]\n            out[: len(values), c] = values\n    else:\n        raise AssertionError(side)\n\n    return out\n\n\ndef _gen_covering_cells(rows, cols, count):\n    rows = list(rows)\n    cols = list(cols)\n    cells = set()\n\n    shuffled_rows = rows[:]\n    random.shuffle(shuffled_rows)\n    for r in shuffled_rows:\n        cells.add((r, random.choice(cols)))\n\n    for c in cols:\n        if all(cc != c for _rr, cc in cells):\n            cells.add((random.choice(rows), c))\n\n    remaining = [(r, c) for r in rows for c in cols if (r, c) not in cells]\n    random.shuffle(remaining)\n    cells.update(remaining[: count - len(cells)])\n    return cells\n\n\ndef _gen_fill(symbolic, rows, cols, count, color):\n    for r, c in _gen_covering_cells(rows, cols, count):\n        symbolic[r, c] = color\n\n\ndef _gen_symbolic(side, bg):\n    color_a, color_b = random.sample(GEN_ACCENT_COLORS, 2)\n\n    if side in (\"top\", \"bottom\"):\n        symbolic = np.full(GEN_SYMBOLIC_HW, bg, dtype=int)\n        dominant_cols = range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_HW[1]) if side == \"top\" else range(0, GEN_SPLIT_INDEX)\n        accent_cols = range(0, GEN_SPLIT_INDEX) if side == \"top\" else range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_HW[1])\n        _gen_fill(symbolic, range(GEN_SYMBOLIC_HW[0]), dominant_cols, random.randint(*GEN_DOMINANT_COUNT_RANGE), GEN_DOMINANT_COLOR)\n        _gen_fill(symbolic, range(0, GEN_SPLIT_INDEX), accent_cols, random.randint(*GEN_ACCENT_COUNT_RANGE), color_a)\n        _gen_fill(symbolic, range(GEN_SPLIT_INDEX + 1, GEN_SYMBOLIC_HW[0]), accent_cols, random.randint(*GEN_ACCENT_COUNT_RANGE), color_b)\n    else:\n        symbolic = np.full(GEN_SYMBOLIC_VW, bg, dtype=int)\n        dominant_rows = range(0, GEN_SPLIT_INDEX) if side == \"left\" else range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_VW[0])\n        accent_rows = range(GEN_SPLIT_INDEX, GEN_SYMBOLIC_VW[0]) if side == \"left\" else range(0, GEN_SPLIT_INDEX)\n        _gen_fill(symbolic, dominant_rows, range(GEN_SYMBOLIC_VW[1]), random.randint(*GEN_DOMINANT_COUNT_RANGE), GEN_DOMINANT_COLOR)\n        _gen_fill(symbolic, accent_rows, range(0, GEN_SPLIT_INDEX), random.randint(*GEN_ACCENT_COUNT_RANGE), color_a)\n        _gen_fill(symbolic, accent_rows, range(GEN_SPLIT_INDEX + 1, GEN_SYMBOLIC_VW[1]), random.randint(*GEN_ACCENT_COUNT_RANGE), color_b)\n\n    return symbolic\n\n\ndef _gen_lattice_positions(side):\n    if side == \"top\":\n        return GEN_SEVEN_FROM_MARKER, GEN_GAP_SIX_POSITIONS\n    if side == \"bottom\":\n        return GEN_SEVEN_FROM_OTHER, GEN_GAP_SIX_POSITIONS\n    if side == \"left\":\n        return GEN_GAP_SIX_POSITIONS, GEN_SEVEN_FROM_MARKER\n    return GEN_GAP_SIX_POSITIONS, GEN_SEVEN_FROM_OTHER\n\n\ndef _gen_place_marker(grid, side):\n    if side == \"top\":\n        grid[0, :] = GEN_MARKER_COLOR\n    elif side == \"right\":\n        grid[:, -1] = GEN_MARKER_COLOR\n    elif side == \"bottom\":\n        grid[-1, :] = GEN_MARKER_COLOR\n    else:\n        grid[:, 0] = GEN_MARKER_COLOR\n\n\ndef _gen_hollow_patch(color, bg):\n    patch = np.full((GEN_SYMBOL_PATCH_SIZE, GEN_SYMBOL_PATCH_SIZE), color, dtype=int)\n    patch[GEN_SYMBOL_PATCH_SIZE // 2, GEN_SYMBOL_PATCH_SIZE // 2] = bg\n    return patch\n\n\ndef _gen_expand(symbolic, side, bg):\n    grid = np.full(GEN_GRID_SHAPE, bg, dtype=int)\n    _gen_place_marker(grid, side)\n\n    row_positions, col_positions = _gen_lattice_positions(side)\n    for r in range(symbolic.shape[0]):\n        for c in range(symbolic.shape[1]):\n            color = int(symbolic[r, c])\n            if color == bg:\n                continue\n            paste(grid, _gen_hollow_patch(color, bg), row_positions[r], col_positions[c])\n    return grid\n\n\ndef _gen_attempt():\n    side = random.choice(GEN_SIDES)\n    symbolic = _gen_symbolic(side, GEN_BG)\n    expected = _gen_compact(symbolic, side, GEN_BG)\n    if np.array_equal(symbolic, expected):\n        return None\n\n    inp = _gen_expand(symbolic, side, GEN_BG)\n    if not np.array_equal(main(inp), expected):\n        return None\n    return inp\n\n\ndef generate_input():\n    for _ in range(GEN_MAX_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"failed to generate afe3afe9 input\")\n","exit_code":0,"status":"completed"}}
