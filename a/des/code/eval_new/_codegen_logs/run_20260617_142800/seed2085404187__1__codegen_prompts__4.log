return out\n\n# --------------- generator (o5x) ---------------\n\n# --- Configuration ---\nGRID_SIZE_MIN, GRID_SIZE_MAX = 4, 10\nRUN_LENGTH_MIN, RUN_LENGTH_MAX = 3, 7    # main run pixel count\nPOS_MARGIN = 1                            # perpendicular position inset from grid edges\nCOLOR_MIN, COLOR_MAX = 1, 9              # non-background color range (inclusive)\nMAX_RETRIES = 300                         # generate_input() retry budget\n\n_DIAG_DIRS = ((-1, -1), (-1, 1), (1, -1), (1, 1))\n_ORTH_DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n# Edge definitions: (name, pair_generator) -- each yields adjacent cell pairs along one edge.\n_EDGE_DEFS = {\n    \"top\":    lambda n: (((0, c), (0, c + 1)) for c in range(n - 1)),\n    \"bottom\": lambda n: (((n - 1, c), (n - 1, c + 1)) for c in range(n - 1)),\n    \"left\":   lambda n: (((r, 0), (r + 1, 0)) for r in range(n - 1)),\n    \"right\":  lambda n: (((r, n - 1), (r + 1, n - 1)) for r in range(n - 1)),\n}\n\n\n\ndef generate_input():\n    for _ in range(MAX_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 1190bc91 input\")\n\nFILE /home/lixinyu/snap/new/ARC_code/eval/35ab12c3.py\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete outlined shapes and carry attached shadow pixels along their edges.\n\n    Input structure:\n    - bg = background. Each active color marks vertices of an 8-direction aligned outline.\n    - A start vertex can have adjacent non-bg, different-colored shadow pixels.\n    - Other colored pixels may be distractors unless they lie on valid drawable edges.\n\n    Rule:\n    - For each color, order its pixels by polar angle around their centroid to form a cycle.\n    - Draw only horizontal, vertical, or 45-degree edges whose interiors are clear.\n    - From the chosen start vertex, copy adjacent shadow offsets along each drawable edge\n      when the parallel path is in bounds and clear