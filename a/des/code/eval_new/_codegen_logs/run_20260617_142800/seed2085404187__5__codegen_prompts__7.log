{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import components_mask, neighbors4\nimport random\n\n\ndef _bg_boundary(g: np.ndarray) -> int:\n    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    return int(vals[cnts.argmax()])\n\n\ndef _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:\n    \"\"\"\n    Find the 2xN or Nx2 palette block on a grid edge.\n\n    Returns (side, start, end) where:\n      - side in {\"top\",\"bottom\",\"left\",\"right\"}\n      - for top/bottom: start/end are column indices [start,end)\n      - for left/right: start/end are row indices [start,end)\n    \"\"\"\n    h, w = g.shape\n    best = None  # (score_tuple, side, start, end)\n\n    def isolated(side: str, start: int, end: int) -> bool:\n        \"\"\"\n        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells\n        outside the palette region; this prevents accidentally absorbing parts of large sprites\n        that touch the grid edge.\n        \"\"\"\n        h2, w2 = g.shape\n        pal = np.zeros((h2, w2), dtype=bool)\n        if side == \"top\":\n            pal[0:2, start:end] = True\n        elif side == \"bottom\":\n            pal[h2 - 2 : h2, start:end] = True\n        elif side == \"left\":\n            pal[start:end, 0:2] = True\n        else:\n            pal[start:end, w2 - 2 : w2] = True\n\n        for r, c in zip(*np.where(pal), strict=False):\n            r = int(r)\n            c = int(c)\n            v = int(g[r, c])\n            if v == bg:\n                continue\n            for rr, cc in neighbors4(r, c):\n                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:\n                    if int(g[rr, cc]) == v:\n                        return False\n        return True\n\n    def consider_top():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[0, :]\n        b = g[1, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                # Border keys should be unique (excluding bg) to form a well-defined mapping.\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"top\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"top\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_bottom():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[h - 1, :]\n        b = g[h - 2, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"bottom\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"bottom\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_left():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, 0]\n        b = g[:, 1]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"left\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"left\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_right():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, w - 1]\n        b = g[:, w - 2]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"right\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"right\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    consider_top()\n    consider_bottom()\n    consider_left()\n    consider_right()\n\n    assert best is not None, \"_best_palette must find a valid palette region\"\n    _, side, start, end = best\n    return side, int(start), int(end)\n\n\ndef _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:\n    \"\"\"\n    Returns (mapping border->fill, palette_mask).\n    \"\"\"\n    h, w = g.shape\n    info = _best_palette(g, bg)\n    side, start, end = info\n    pal_mask = np.zeros((h, w), dtype=bool)\n    mapping: dict[int, int] = {}\n\n    if side == \"top\":\n        pal_mask[0:2, start:end] = True\n        border_line = g[0, start:end]\n        fill_line = g[1, start:end]\n    elif side == \"bottom\":\n        pal_mask[h - 2 : h, start:end] = True\n        border_line = g[h - 1, start:end]\n        fill_line = g[h - 2, start:end]\n    elif side == \"left\":\n        pal_mask[start:end, 0:2] = True\n        border_line = g[start:end, 0]\n        fill_line = g[start:end, 1]\n    else:  # right\n        pal_mask[start:end, w - 2 : w] = True\n        border_line = g[start:end, w - 1]\n        fill_line = g[start:end, w - 2]\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/5ecac7f7.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/5ecac7f7.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste\nimport random\n\n\ndef _ordered_objects(panel: np.ndarray, bg: int) -> list[dict]:\n    objects = find_components(panel, bg=bg, connectivity=4, monochromatic=True)\n    assert len(objects) == 3, \"each panel must contain exactly three monochrome objects\"\n\n    objects = sorted(objects, key=lambda obj: obj[\"bbox\"][1])\n    previous_right = -1\n    for obj in objects:\n        _r0, c0, _r1, c1 = obj[\"bbox\"]\n        assert c0 > previous_right, \"panel objects must be strictly ordered left to right\"\n        previous_right = c1\n    return objects\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Combine the left, middle, and right ordered objects from three separated panels.\n\n    Input structure\n    - The grid is three HxH panels separated by one-cell vertical separator bars.\n    - The background is the dominant color, and each panel contains exactly three same-color 4-connected foreground objects.\n\n    Rule\n    - Build a new HxH background canvas.\n    - From the left panel copy its leftmost object, from the middle panel copy its middle object, and from the right panel copy its rightmost object.\n\n    Key insight\n    - The separator bars create three aligned layers, and the panel's own left-to-right object order selects which object survives in the merged output.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    H, W = g.shape\n    assert W == 3 * H + 2, \"expected three square panels separated by two columns\"\n\n    bg = get_bg(g)\n    sep_a = int(g[0, H])\n    sep_b = int(g[0, 2 * H + 1])\n    assert sep_a == sep_b and sep_a != bg, \"separator bars must use the same non-bg color\"\n    assert bool(np.all(g[:, H] == sep_a)), \"first separator column must be solid\"\n    assert bool(np.all(g[:, 2 * H + 1] == sep_a)), \"second separator column must be solid\"\n\n    panels = [\n        g[:, :H],\n        g[:, H + 1 : 2 * H + 1],\n        g[:, 2 * H + 2 :],\n    ]\n    assert all(panel.shape == (H, H) for panel in panels), \"panels must be HxH\"\n\n    out = np.full((H, H), bg, dtype=int)\n    for panel_index, panel in enumerate(panels):\n        obj = _ordered_objects(panel, bg)[panel_index]\n        color = int(obj[\"color\"])\n        for r, c in obj[\"coords\"]:\n            rr, cc = int(r), int(c)\n            assert out[rr, cc] == bg, \"selected objects must not overlap\"\n            out[rr, cc] = color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette values observed in the task.\n_BG = 7\n_SEP = 6\n_COLORS = [0, 1, 2, 3, 4, 5, 8, 9]\n\n# Panel geometry and object ordering.\n_GRID_SIZES = [5, 6]\n_N_PANELS = 3\n_OBJECTS_PER_PANEL = 3\n_DISTRACTOR_KEYS = [(0, 1), (0, 2), (1, 0), (1, 2), (2, 0), (2, 1)]\n\n# Object-size, density, and color-reuse controls.\n_MAX_OBJECT_AREA = 8\n_AREA_BUDGET_BY_SIZE = {5: 56, 6: 72}\n_MAX_COLOR_REUSES = 2\n\n# Random-growth shape controls.\n_FRONTIER_COMPACT_BIAS = 0.35\n_FRONTIER_COMPACT_TOP_K = 3\n_NEIGHBOR_DELTAS = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n# Retry limit for rejecting failed growth or oracle mismatches.\n_MAX_ATTEMPTS = 300\n\n\ndef _segments(H: int) -> list[tuple[int, int]]:\n    a, b = sorted(random.sample(range(1, H), 2))\n    return [(0, a - 1), (a, b - 1), (b, H - 1)]\n\n\ndef _object_patch(H: int, cols: tuple[int, int], color: int, area: int) -> np.ndarray | None:\n    c0, c1 = cols\n    W = c1 - c0 + 1\n    target = int(area)\n    if target < 1 or target > H * W:\n        return None\n\n    start = (random.randrange(H), random.randrange(W))\n    cells = {start}\n    frontier: set[tuple[int, int]] = set()\n\n    def add_frontier(r: int, c: int) -> None:\n        for dr, dc in _NEIGHBOR_DELTAS:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in cells:\n                frontier.add((rr, cc))\n\n    add_frontier(*start)\n    while len(cells) < target:\n        if not frontier:\n            return None\n        if random.random() < _FRONTIER_COMPACT_BIAS:\n            options = sorted(\n                frontier,\n                key=lambda rc: sum(\n                    (rc[0] + dr, rc[1] + dc) in cells for dr, dc in _NEIGHBOR_DELTAS\n                ),\n                reverse=True,\n            )\n            top_k = max(1, min(_FRONTIER_COMPACT_TOP_K, len(options)))\n            cell = random.choice(options[:top_k])\n        else:\n            cell = random.choice(tuple(frontier))\n        frontier.remove(cell)\n        cells.add(cell)\n        add_frontier(*cell)\n\n    patch = np.full((H, H), _BG, dtype=int)\n    for r, c in cells:\n        patch[r, c0 + c] = int(color)\n    return patch\n\n\ndef _choose_area(H: int, cols: tuple[int, int], budget: int, remaining_slots: int) -> int | None:\n    width = cols[1] - cols[0] + 1\n    high = min(_MAX_OBJECT_AREA, H * width, budget - (remaining_slots - 1))\n    if high < 1:\n        return None\n    return random.randint(1, high)\n\n\ndef _assign_colors(selected: list[int]) -> dict[tuple[int, int], int] | None:\n    colors = {(i, i): int(selected[i]) for i in range(_OBJECTS_PER_PANEL)}\n    used_by_panel = [set() for _ in range(_N_PANELS)]\n    counts = {c: 0 for c in _COLORS}\n    for i, color in enumerate(selected):\n        used_by_panel[i].add(int(color))\n        counts[int(color)] += 1\n\n    distractors = list(_DISTRACTOR_KEYS)\n    random.shuffle(distractors)\n    for panel_i, obj_i in distractors:\n        options = [\n            color\n            for color in _COLORS\n            if counts[color] < _MAX_COLOR_REUSES and color not in used_by_panel[panel_i]\n        ]\n        if not options:\n            return None\n        color = random.choice(options)\n        colors[(panel_i, obj_i)] = color\n        used_by_panel[panel_i].add(color)\n        counts[color] += 1\n    return colors\n\n\ndef _sample_patch(H: int, segs: list[tuple[int, int]], obj_i: int, color: int, budget: int, remaining: int):\n    area = _choose_area(H, segs[obj_i], budget, remaining)\n    if area is None:\n        return None\n    patch = _object_patch(H, segs[obj_i], color, area)\n    if patch is None:\n        return None\n    return patch, budget - area, remaining - 1\n\n\ndef _sample_objects(H: int, segs: list[tuple[int, int]], selected_colors: list[int], colors):\n    \"\"\"Return all panel objects plus the expected merged output.\"\"\"\n    budget = _AREA_BUDGET_BY_SIZE[H]\n    remaining = _N_PANELS * _OBJECTS_PER_PANEL\n    objects: dict[tuple[int, int], np.ndarray] = {}\n    out = np.full((H, H), _BG, dtype=int)\n\n    for i in range(_OBJECTS_PER_PANEL):\n        sampled = _sample_patch(H, segs, i, selected_colors[i], budget, remaining)\n        if sampled is None:\n            return None\n        patch, budget, remaining = sampled\n        objects[(i, i)] = patch\n        paste(out, patch, 0, 0, transparent=_BG)\n\n    for panel_i, obj_i in _DISTRACTOR_KEYS:\n        sampled = _sample_patch(H, segs, obj_i, colors[(panel_i, obj_i)], budget, remaining)\n        if sampled is None:\n            return None\n        patch, budget, remaining = sampled\n        objects[(panel_i, obj_i)] = patch\n    return objects, out\n\n\ndef _render_input(H: int, objects: dict[tuple[int, int], np.ndarray]) -> np.ndarray:\n    \"\"\"Render all objects into three panels separated by solid bars.\"\"\"\n    inp = np.full((H, _N_PANELS * H + (_N_PANELS - 1)), _BG, dtype=int)\n    for sep_i in range(1, _N_PANELS):\n        inp[:, sep_i * H + (sep_i - 1)] = _SEP\n    for panel_i in range(_N_PANELS):\n        panel = np.full((H, H), _BG, dtype=int)\n        for obj_i in range(_OBJECTS_PER_PANEL):\n            paste(panel, objects[(panel_i, obj_i)], 0, 0, transparent=_BG)\n        paste(inp, panel, 0, panel_i * (H + 1))\n    return inp\n\n","exit_code":0,"status":"completed"}}
