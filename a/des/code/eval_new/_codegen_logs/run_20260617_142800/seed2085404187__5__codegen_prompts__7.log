{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/11dc524f.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste\nimport itertools\nimport random\n\n\ndef _intervals_overlap(a0: int, a1: int, b0: int, b1: int) -> bool:\n    return max(int(a0), int(b0)) <= min(int(a1), int(b1))\n\n\ndef _is_solid_2x2(comp: dict, g: np.ndarray) -> bool:\n    r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n    return (\n        int(comp[\"area\"]) == 4\n        and int(r1 - r0 + 1) == 2\n        and int(c1 - c0 + 1) == 2\n        and bool((g[r0 : r1 + 1, c0 : c1 + 1] == int(comp[\"color\"])).all())\n    )\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide the non-square sprite to the square anchor and replace the anchor with the sprite's mirror image.\n\n    Input structure:\n    - The background is the most common color.\n    - There is one 8-connected non-background sprite that is not a solid 2x2 square.\n    - There is one solid 2x2 square anchor in another non-background color.\n\n    Rule:\n    - Move the sprite straight toward the anchor along their unique cardinal separation until it touches the anchor's near edge.\n    - Reflect the moved sprite across that near edge and draw the reflected copy in the anchor color.\n    - Clear the original locations; the output keeps only the moved sprite and reflected anchor-color copy.\n\n    Key insight:\n    - The 2x2 square marks the mirror line: its side facing the sprite becomes the contact edge for a two-color reflected pair.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    H, W = map(int, g.shape)\n\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)\n    assert len(comps) == 2\n\n    anchors = [comp for comp in comps if _is_solid_2x2(comp, g)]\n    assert len(anchors) == 1\n    anchor = anchors[0]\n\n    sprites = [comp for comp in comps if comp is not anchor]\n    assert len(sprites) == 1\n    sprite = sprites[0]\n    assert int(sprite[\"color\"]) != int(anchor[\"color\"])\n\n    sr0, sc0, sr1, sc1 = map(int, sprite[\"bbox\"])\n    ar0, ac0, ar1, ac1 = map(int, anchor[\"bbox\"])\n\n    candidates: list[tuple[str, int, int]] = []\n    if sc1 < ac0 and _intervals_overlap(sr0, sr1, ar0, ar1):\n        candidates.append((\"left\", 0, ac0 - sc1 - 1))\n    if sc0 > ac1 and _intervals_overlap(sr0, sr1, ar0, ar1):\n        candidates.append((\"right\", 0, ac1 + 1 - sc0))\n    if sr1 < ar0 and _intervals_overlap(sc0, sc1, ac0, ac1):\n        candidates.append((\"above\", ar0 - sr1 - 1, 0))\n    if sr0 > ar1 and _intervals_overlap(sc0, sc1, ac0, ac1):\n        candidates.append((\"below\", ar1 + 1 - sr0, 0))\n    assert len(candidates) == 1\n\n    side, dr, dc = candidates[0]\n    moved: list[tuple[int, int]] = []\n    mirrored: list[tuple[int, int]] = []\n    for r, c in sprite[\"coords\"]:\n        rr = int(r) + int(dr)\n        cc = int(c) + int(dc)\n        moved.append((rr, cc))\n        if side == \"left\":\n            mirrored.append((rr, 2 * ac0 - 1 - cc))\n        elif side == \"right\":\n            mirrored.append((rr, 2 * ac1 + 1 - cc))\n        elif side == \"above\":\n            mirrored.append((2 * ar0 - 1 - rr, cc))\n        else:\n            mirrored.append((2 * ar1 + 1 - rr, cc))\n\n    assert all(0 <= r < H and 0 <= c < W for r, c in moved)\n    assert all(0 <= r < H and 0 <= c < W for r, c in mirrored)\n    assert not (set(moved) & set(mirrored))\n\n    out = np.full_like(g, bg)\n    for r, c in moved:\n        out[r, c] = int(sprite[\"color\"])\n    for r, c in mirrored:\n        out[r, c] = int(anchor[\"color\"])\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom arc_utils import is_contiguous\n\n# ── Config ──────────────────────────────────────────────────────────────\nGRID_MIN, GRID_MAX = 10, 20        # canvas size range (rows and cols)\nSPRITE_AREA = 4                     # number of filled cells per sprite\nSPRITE_BBOX_SHAPES = [(2, 3), (3, 2), (3, 3)]  # allowed sprite bbox dims\nGAP_MIN, GAP_MAX = 2, 4            # empty-cell gap between sprite and anchor\nANCHOR_SIZE = 2                     # anchor is always a 2x2 solid square\nNUM_COLORS = 10                     # ARC color palette size\nSIDES = [\"left\", \"right\", \"above\", \"below\"]\nRETRY_LIMIT = 300                   # max attempts before raising\n\n\ndef _has_full_bbox(mask: np.ndarray) -> bool:\n    \"\"\"True if mask has at least one filled cell on each edge of its bounding box.\"\"\"\n    return (mask[0].any() and mask[-1].any() and\n            mask[:, 0].any() and mask[:, -1].any())\n\n\ndef _sprite_masks(axis: str) -> list[np.ndarray]:\n    \"\"\"Enumerate all valid 4-cell sprite masks for a given mirror axis.\n\n    A valid mask is 8-connected, spans its full bbox, and is NOT symmetric\n    along the given axis (lr or ud).\n    \"\"\"\n    flip = np.fliplr if axis == \"lr\" else np.flipud\n    out = []\n    for h, w in SPRITE_BBOX_SHAPES:\n        for cells in itertools.combinations(range(h * w), SPRITE_AREA):\n            mask = np.zeros((h, w), dtype=bool)\n            for cell in cells:\n                mask[cell // w, cell % w] = True\n            if not _has_full_bbox(mask):\n                continue\n            if not is_contiguous(mask, connectivity=8):\n                continue\n            if np.array_equal(mask, flip(mask)):\n                continue\n            out.append(mask)\n    return out\n\n\n_MASKS = {\"lr\": _sprite_masks(\"lr\"), \"ud\": _sprite_masks(\"ud\")}\n\n\ndef _paint_mask(grid: np.ndarray, mask: np.ndarray, r0: int, c0: int,\n                color: int, bg: int) -> None:\n    \"\"\"Stamp a boolean mask onto grid at (r0, c0) using the given color.\"\"\"\n    patch = np.full(mask.shape, bg, dtype=int)\n    patch[mask] = color\n    paste(grid, patch, r0, c0, transparent=bg)\n\n\ndef _rand_pair_origin(H: int, W: int, h: int, w: int, side: str,\n                      gap: int) -> tuple[int, int] | None:\n    \"\"\"Pick a random origin for the touching sprite+mirror pair.\n\n    Returns (row, col) of the output pair's top-left corner, or None if the\n    pair cannot fit on the grid with enough room for the input-side gap.\n    \"\"\"\n    if side in {\"left\", \"right\"}:\n        r_lo, r_hi = 0, H - h\n        total_w = 2 * w + (gap if side == \"right\" else 0)\n        c_lo = gap if side == \"left\" else 0\n        c_hi = W - total_w if side == \"right\" else W - 2 * w\n    else:\n        c_lo, c_hi = 0, W - w\n        total_h = 2 * h + (gap if side == \"below\" else 0)\n        r_lo = gap if side == \"above\" else 0\n        r_hi = H - total_h if side == \"below\" else H - 2 * h\n    if r_lo > r_hi or c_lo > c_hi:\n        return None\n    return random.randint(r_lo, r_hi), random.randint(c_lo, c_hi)\n\n\ndef _layout_for_side(side: str, pr: int, pc: int, h: int, w: int,\n                     gap: int, sprite: np.ndarray):\n    \"\"\"Compute output and input placement params for a given side.\n\n    Returns (sprite_r, sprite_c, mirror_r, mirror_c, flipped_sprite,\n             anchor_r, anchor_c, input_r, input_c).\n    \"\"\"\n    flip = np.fliplr if side in {\"left\", \"right\"} else np.flipud\n    flipped = flip(sprite)\n\n    if side == \"left\":\n        sr, sc = pr, pc                     # sprite at pair origin\n        mr, mc = sr, sc + w                  # mirror right of sprite\n        anchor_r = random.randint(sr, sr + h - ANCHOR_SIZE)\n        anchor_c = sc + w\n        input_r, input_c = sr, sc - gap\n    elif side == \"right\":\n        sr, sc = pr, pc + w                  # sprite right half\n        mr, mc = pr, pc                      # mirror left half\n        anchor_r = random.randint(sr, sr + h - ANCHOR_SIZE)\n        anchor_c = sc - ANCHOR_SIZE\n        input_r, input_c = sr, sc + gap\n    elif side == \"above\":\n        sr, sc = pr, pc                      # sprite at top\n        mr, mc = sr + h, sc                  # mirror below\n        anchor_r = sr + h\n        anchor_c = random.randint(sc, sc + w - ANCHOR_SIZE)\n        input_r, input_c = sr - gap, sc\n    else:  # below\n        sr, sc = pr + h, pc                  # sprite at bottom\n        mr, mc = pr, pc                      # mirror above\n        anchor_r = sr - ANCHOR_SIZE\n        anchor_c = random.randint(sc, sc + w - ANCHOR_SIZE)\n        input_r, input_c = sr + gap, sc\n\n    return sr, sc, mr, mc, flipped, anchor_r, anchor_c, input_r, input_c\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Try to build one valid (input, output) pair; return input or None.\"\"\"\n    H = random.randint(GRID_MIN, GRID_MAX)\n    W = random.randint(GRID_MIN, GRID_MAX)\n    bg = random.randrange(NUM_COLORS)\n    sprite_color, anchor_color = random.sample(\n        [c for c in range(NUM_COLORS) if c != bg], 2)\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/42f83767.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/42f83767.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox, find_components, get_bg, paste\nimport math\nimport random\n\n\ndef _runs(values):\n    runs = []\n    start = None\n    for i, value in enumerate(values):\n        if value and start is None:\n            start = i\n        elif not value and start is not None:\n            runs.append((start, i - 1))\n            start = None\n    if start is not None:\n        runs.append((start, len(values) - 1))\n    return runs\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Expand the lower color grid by replacing each pixel with its matching top stencil.\n\n    Input structure\n    The input has a top legend and a lower dense color grid, separated by blank rows.\n    The legend contains left-to-right 2x2 color swatches and, to their right,\n    the same number of square neutral-color stencil masks.\n\n    Rule\n    Pair the swatches and stencil masks by left-to-right order. For every pixel in\n    the lower color grid, paste the paired stencil mask as one output block,\n    recoloring the mask pixels with that pixel's color and leaving mask holes as bg.\n\n    Key insight\n    The lower grid is not copied directly; it is an index grid whose colors select\n    the stencil shape from the legend, so each input pixel becomes one square block.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    row_runs = _runs(np.any(g != bg, axis=1))\n    assert len(row_runs) == 2\n    (top_r0, top_r1), (pattern_r0, pattern_r1) = row_runs\n    assert top_r0 == 0\n\n    stencil_size = top_r1 - top_r0 + 1\n    top = g[top_r0 : top_r1 + 1, :]\n    lower = g[pattern_r0 : pattern_r1 + 1, :]\n\n    pattern_box = bbox(lower != bg)\n    assert pattern_box is not None\n    pr0, pc0, pr1, pc1 = pattern_box\n    assert pr0 == 0 and pr1 == lower.shape[0] - 1\n    pattern = lower[:, pc0 : pc1 + 1]\n    assert np.all(pattern != bg)\n    pattern_colors = set(map(int, np.unique(pattern)))\n\n    top_colors = set(map(int, np.unique(top))) - {bg}\n    neutral_colors = top_colors - pattern_colors\n    assert len(neutral_colors) == 1\n    neutral = next(iter(neutral_colors))\n\n    swatches = []\n    for comp in find_components(top, bg=bg, colors=pattern_colors):\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        assert comp[\"area\"] == 4\n        assert r1 - r0 + 1 == 2\n        assert c1 - c0 + 1 == 2\n        swatches.append((c0, int(comp[\"color\"])))\n    assert len(swatches) == len(pattern_colors)\n    assert len({c0 for c0, _color in swatches}) == len(swatches)\n\n    swatch_colors = [color for _c0, color in sorted(swatches)]\n    assert set(swatch_colors) == pattern_colors\n\n    stencil_col_runs = _runs(np.any(top == neutral, axis=0))\n    assert len(stencil_col_runs) == len(swatch_colors)\n\n    stencils = {}\n    for color, (c0, c1) in zip(swatch_colors, stencil_col_runs):\n        assert c1 - c0 + 1 == stencil_size\n        mask = top[:, c0 : c1 + 1] == neutral\n        assert mask.shape == (stencil_size, stencil_size)\n        assert np.any(mask)\n        stencils[color] = mask\n\n    h, w = pattern.shape\n    out = np.full((h * stencil_size, w * stencil_size), bg, dtype=int)\n    for r in range(h):\n        for c in range(w):\n            color = int(pattern[r, c])\n            assert color in stencils\n            block = out[\n                r * stencil_size : (r + 1) * stencil_size,\n                c * stencil_size : (c + 1) * stencil_size,\n            ]\n            block[stencils[color]] = color\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and legend geometry.\nBACKGROUND, NEUTRAL_COLOR, INPUT_ROWS = 0, 5, 15\nSWATCH_SIZE, SWATCH_STRIDE, STENCIL_GAP = 2, 3, 1\n\n# Structural size and palette bounds.\nCOLOR_COUNT_RANGE = (2, 4)\nSTENCIL_SIZE_RANGE, PATTERN_SIDE_RANGE = range(3, 7), range(4, 8)\nMAX_OUTPUT_SIDE, AVAILABLE_COLORS = 30, [1, 2, 3, 4, 6, 7, 8, 9]\nVALID_SIZE_PAIRS = [(s, p) for s in STENCIL_SIZE_RANGE for p in PATTERN_SIDE_RANGE if s * p <= MAX_OUTPUT_SIDE]\n\n# Stencil, pattern, and retry sampling.\nSTENCIL_FILL_RANGE = (0.60, 0.89)\nUNIQUE_STENCIL_RETRIES, GENERATION_RETRIES = 80, 300\nGAP_ROWS_RANGE = (1, 3)\nPATTERN_MODES = [\"iid\", \"rows\", \"cols\", \"checker\", \"tile\"]\nTILE_SIDE_RANGE = (2, 3)\n\n\ndef _grow_stencil(size):\n    min_fill = max(2 * size - 1, math.ceil(STENCIL_FILL_RANGE[0] * size * size))\n    max_fill = math.floor(STENCIL_FILL_RANGE[1] * size * size)\n    target = random.randint(min_fill, max_fill)\n\n    mask = np.zeros((size, size), dtype=bool)\n    mask[0, :] = True\n    mask[:, random.randrange(size)] = True\n\n    while int(mask.sum()) < target:\n        frontier = []\n        for r in range(size):\n            for c in range(size):\n                if mask[r, c]:\n                    continue\n                if (\n                    (r > 0 and mask[r - 1, c])\n                    or (r + 1 < size and mask[r + 1, c])\n                    or (c > 0 and mask[r, c - 1])\n                    or (c + 1 < size and mask[r, c + 1])\n                ):\n                    frontier.append((r, c))\n        r, c = random.choice(frontier)\n        mask[r, c] = True\n    return mask\n\n\ndef _make_stencils(count, size):\n    stencils = []\n    seen = set()\n    for _ in range(count):\n        for _retry in range(UNIQUE_STENCIL_RETRIES):\n            mask = _grow_stencil(size)\n            key = tuple(mask.ravel())\n            if key not in seen:\n                seen.add(key)\n                stencils.append(mask)\n                break\n        else:\n            return None\n    return stencils\n\n\ndef _make_pattern(colors, side):\n    mode = random.choice(PATTERN_MODES)\n    colors = list(colors)\n    if mode == \"rows\":\n        row_colors = [random.choice(colors) for _ in range(side)]\n        pattern = np.array([[row_colors[r]] * side for r in range(side)], dtype=int)\n    elif mode == \"cols\":\n        col_colors = [random.choice(colors) for _ in range(side)]\n        pattern = np.array([col_colors for _ in range(side)], dtype=int)\n    elif mode == \"checker\":\n        order = random.sample(colors, len(colors))\n        offset = random.randrange(len(order))\n        pattern = np.array(\n            [[order[(r + c + offset) % len(order)] for c in range(side)] for r in range(side)],\n            dtype=int,\n        )\n    elif mode == \"tile\":\n        tile_h = random.randint(TILE_SIDE_RANGE[0], min(TILE_SIDE_RANGE[1], side))\n        tile_w = random.randint(TILE_SIDE_RANGE[0], min(TILE_SIDE_RANGE[1], side))\n        tile = np.array(\n            [[random.choice(colors) for _c in range(tile_w)] for _r in range(tile_h)],\n            dtype=int,\n        )\n        pattern = np.tile(tile, (math.ceil(side / tile_h), math.ceil(side / tile_w)))[:side, :side]\n    else:\n        flat = [random.choice(colors) for _ in range(side * side)]\n        pattern = np.array(flat, dtype=int).reshape(side, side)\n\n    missing = [color for color in colors if color not in set(map(int, pattern.ravel()))]\n    if missing:\n        cells = random.sample(range(side * side), len(missing))\n        for idx, color in zip(cells, missing):\n            pattern[idx // side, idx % side] = color\n    return pattern\n\n\ndef _make_legend_grid(colors, stencils, size):\n    count = len(colors)\n    width = count * (size + SWATCH_STRIDE + STENCIL_GAP) - STENCIL_GAP\n    grid = np.zeros((INPUT_ROWS, width), dtype=int)\n    for i, color in enumerate(colors):\n        swatch = np.full((SWATCH_SIZE, SWATCH_SIZE), color, dtype=int)\n        paste(grid, swatch, 0, i * SWATCH_STRIDE)\n\n    stencil_start = count * SWATCH_STRIDE\n    for i, mask in enumerate(stencils):\n        patch = np.where(mask, NEUTRAL_COLOR, BACKGROUND)\n        paste(grid, patch, 0, stencil_start + i * (size + STENCIL_GAP))\n    return grid\n\n\ndef _expand(pattern, colors, stencils):\n    side = pattern.shape[0]\n    size = stencils[0].shape[0]\n    out = np.zeros((side * size, side * size), dtype=int)\n    stencil_by_color = dict(zip(colors, stencils))\n","exit_code":0,"status":"completed"}}
