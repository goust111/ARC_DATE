{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/963c33f8.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, components_mask, find_components, get_bg\nimport random\n\n\ndef _unique_largest_count_color(g: np.ndarray, colors: list[int]) -> int:\n    counts = [(int(np.sum(g == color)), int(color)) for color in colors]\n    max_count = max(count for count, _color in counts)\n    winners = [color for count, color in counts if count == max_count]\n    assert len(winners) == 1, \"expected one most numerous non-background obstacle color\"\n    return winners[0]\n\n\ndef _marker_bbox(g: np.ndarray, marker_colors: list[int]) -> tuple[int, int, int, int]:\n    mask = np.isin(g, marker_colors)\n    candidates: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(mask, connectivity=8):\n        r0, c0, r1, c1 = bbox_coords(coords)\n        if r0 == 0:\n            candidates.append((r0, c0, r1, c1))\n\n    assert len(candidates) == 1, \"expected one top-edge marker component\"\n    return candidates[0]\n\n\ndef _runs(values: list[int]) -> list[tuple[int, int]]:\n    if not values:\n        return []\n\n    runs: list[tuple[int, int]] = []\n    start = prev = values[0]\n    for value in values[1:]:\n        if value == prev + 1:\n            prev = value\n            continue\n        runs.append((start, prev))\n        start = prev = value\n    runs.append((start, prev))\n    return runs\n\n\ndef _can_slide_right(base: np.ndarray, obstacle: int, bg: int, cols: list[int], marker_bottom_r: int, height: int) -> bool:\n    H, W = base.shape\n    assert cols\n    if cols[-1] + 1 >= W:\n        return False\n\n    for floor_r in range(marker_bottom_r + 1, H):\n        target_rows = np.arange(floor_r - height + 1, floor_r + 1)\n        if int(target_rows[0]) < 0:\n            continue\n\n        shifted_cols = [c + 1 for c in cols]\n        target_is_clear = all(np.all(base[target_rows, c] == bg) for c in shifted_cols)\n        if not target_is_clear:\n            continue\n\n        for c in cols:\n            if int(base[floor_r, c]) != obstacle:\n                continue\n            has_horizontal_neighbor = (\n                (c > 0 and int(base[floor_r, c - 1]) == obstacle)\n                or (c + 1 < W and int(base[floor_r, c + 1]) == obstacle)\n            )\n            if has_horizontal_neighbor:\n                return True\n\n    return False\n\n\ndef _clear_bottom_edge_gap(base: np.ndarray, out: np.ndarray, obstacle: int, bg: int, c: int, width: int) -> None:\n    H, W = base.shape\n    if int(base[H - 1, c]) != obstacle:\n        return\n\n    c1 = c\n    while c1 < W and int(base[H - 1, c1]) == obstacle:\n        c1 += 1\n\n    if c1 - c >= width:\n        out[H - 1, c + 1 : c + width] = bg\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Drop the columns of the top marker downward, stopping blue-ended columns on grey obstacles and letting maroon-ended columns pass to the bottom.\n\n    Input structure\n    - The background is the dominant color.\n    - The most numerous non-background color forms stationary grey obstacle pixels.\n    - The other two colors form a single 3x3 top-edge marker whose top two rows\n      are maroon and whose bottom row contains maroon or blue control pixels.\n\n    Rule\n    - Erase the top marker.\n    - Treat each marker column as a vertical drop retaining its three colors.\n    - A column whose bottom control pixel is blue stops immediately above the\n      first grey pixel below that column, or bottom-aligns if none exists.\n    - Contiguous maroon-ended columns pass through obstacles and bottom-align;\n      if such a run has a clear down-right slide from a grey ledge, shift the\n      run one column right before bottom-aligning.\n    - When a maroon-ended drop lands through a grey bar on the bottom edge, clear\n      the rest of the marker-width gap in that bottom bar.\n\n    Key insight\n    - The bottom row of the top marker is a control strip: blue cells mean\n      \"stick to the first obstacle,\" while maroon cells mean \"fall through.\"\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H = g.shape[0]\n    bg = int(get_bg(g))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 3, \"expected obstacle color plus two marker colors\"\n    obstacle = _unique_largest_count_color(g, non_bg)\n    marker_colors = [color for color in non_bg if color != obstacle]\n    assert len(marker_colors) == 2, \"expected exactly two marker colors\"\n\n    r0, c0, r1, c1 = _marker_bbox(g, marker_colors)\n    marker = g[r0 : r1 + 1, c0 : c1 + 1]\n    marker_h, marker_w = marker.shape\n    assert (marker_h, marker_w) == (3, 3), \"expected a 3x3 marker\"\n    assert np.all(np.isin(marker, marker_colors)), \"marker bbox must contain only marker colors\"\n\n    pass_color = int(marker[0, 0])\n    assert np.all(marker[:2, :] == pass_color), \"top two marker rows must be the pass-through color\"\n    stop_colors = [color for color in marker_colors if color != pass_color]\n    assert len(stop_colors) == 1, \"expected one stop color\"\n    stop_color = stop_colors[0]\n\n    out = g.copy()\n    out[r0 : r1 + 1, c0 : c1 + 1] = bg\n    base = out.copy()\n\n    pass_columns: list[int] = []\n    for j in range(marker_w):\n        c = c0 + j\n        stack = marker[:, j]\n        bottom_control = int(stack[-1])\n\n        if bottom_control == stop_color:\n            obstacles_below = np.flatnonzero(base[r1 + 1 :, c] == obstacle)\n            if len(obstacles_below):\n                floor_r = int(r1 + 1 + obstacles_below[0])\n                top_r = floor_r - marker_h\n            else:\n                top_r = H - marker_h\n            assert top_r >= 0, \"stopped column must fit above its obstacle\"\n            out[top_r : top_r + marker_h, c] = stack\n        else:\n            assert bottom_control == pass_color, \"bottom control must be one of the marker colors\"\n            pass_columns.append(j)\n\n    for start_j, end_j in _runs(pass_columns):\n        source_cols = list(range(c0 + start_j, c0 + end_j + 1))\n        shift = 1 if _can_slide_right(base, obstacle, bg, source_cols, r1, marker_h) else 0\n        top_r = H - marker_h\n\n        for j in range(start_j, end_j + 1):\n            c = c0 + j + shift\n            _clear_bottom_edge_gap(base, out, obstacle, bg, c, marker_w)\n            out[top_r : top_r + marker_h, c] = marker[:, j]\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGEN_BG, GEN_OBSTACLE, GEN_PASS, GEN_STOP = 7, 5, 9, 1\nGRID_SIZE_RANGE = (14, 16)\nMARKER_SIZE = 3\nSTOP_COUNT_RANGE = (1, 3)\nOBSTACLE_COMPONENT_RANGE = (7, 9)\nOBSTACLE_PIXEL_RANGE = (20, 31)\nCOMPONENT_SIZE_RANGE = (1, 11)\nMIN_STOP_OBSTACLE_ROW = 6\nDROP_ZONE_HEIGHT = 3\nCOMPONENT_PLACEMENT_ATTEMPTS, GENERATION_ATTEMPTS = 100, 300\n\n\ndef _init_scene(H: int, W: int) -> tuple[np.ndarray, int, list[int], set[tuple[int, int]]]:\n    grid = np.full((H, W), GEN_BG, dtype=int)\n    c0 = random.randint(0, W - MARKER_SIZE)\n    num_stops = random.randint(*STOP_COUNT_RANGE)\n    positions = list(range(MARKER_SIZE))\n    random.shuffle(positions)\n    stop_positions = sorted(positions[:num_stops])\n    marker = np.full((MARKER_SIZE, MARKER_SIZE), GEN_PASS, dtype=int)\n    for j in stop_positions:\n        marker[MARKER_SIZE - 1, j] = GEN_STOP\n    grid[0:MARKER_SIZE, c0:c0 + MARKER_SIZE] = marker\n    obstacle_pixels: set[tuple[int, int]] = set()\n    for j in stop_positions:\n        col = c0 + j\n        first_obs_row = random.randint(MIN_STOP_OBSTACLE_ROW, H - 1)\n        grid[first_obs_row, col] = GEN_OBSTACLE\n        obstacle_pixels.add((first_obs_row, col))\n    return grid, c0, stop_positions, obstacle_pixels\n\n\ndef _forbidden_cells(H: int, c0: int, stop_positions: list[int], obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]]:\n    forbidden = {(r, c) for r in range(MARKER_SIZE) for c in range(c0, c0 + MARKER_SIZE)}\n    for j in stop_positions:\n        col = c0 + j\n        for r in range(MARKER_SIZE, H):\n            if (r, col) not in obstacle_pixels:\n                continue\n            for dr in range(1, DROP_ZONE_HEIGHT + 1):\n                if r - dr >= 0:\n                    forbidden.add((r - dr, col))\n            break\n    return forbidden\n\n\ndef _sample_component_sizes(total_pixels: int, component_count: int) -> list[int] | None:\n    component_sizes = []\n    left = total_pixels\n    min_size, max_size = COMPONENT_SIZE_RANGE\n    for i in range(component_count):\n        remaining = component_count - i - 1\n        if remaining == 0:\n            size = left\n        else:\n            lo = max(min_size, left - max_size * remaining)\n            hi = min(max_size, left - min_size * remaining)\n            if lo > hi:\n                return None\n            size = random.randint(lo, hi)\n        left -= size\n        if size < min_size or size > max_size:\n            return None\n        component_sizes.append(size)\n    random.shuffle(component_sizes)\n    return component_sizes\n\n\ndef _grow_component(grid: np.ndarray, comp_size: int, forbidden: set[tuple[int, int]],\n                    obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]] | None:\n    H, W = grid.shape\n    sr, sc = random.randint(0, H - 1), random.randint(0, W - 1)\n    if (sr, sc) in forbidden or (sr, sc) in obstacle_pixels or grid[sr, sc] != GEN_BG:\n        return None\n\n    comp = {(sr, sc)}\n    frontier = [(sr, sc)]\n    while len(comp) < comp_size and frontier:\n        random.shuffle(frontier)\n        expanded = False\n        for fr, fc in frontier:\n            nbrs = [(fr - 1, fc), (fr + 1, fc), (fr, fc - 1), (fr, fc + 1)]\n            random.shuffle(nbrs)\n            for nr, nc in nbrs:\n                if (0 <= nr < H and 0 <= nc < W\n                        and (nr, nc) not in forbidden\n                        and (nr, nc) not in obstacle_pixels\n                        and (nr, nc) not in comp\n                        and grid[nr, nc] == GEN_BG):\n                    comp.add((nr, nc))\n                    frontier.append((nr, nc))\n                    expanded = True\n                    break\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/9aaea919.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, paste\nfrom itertools import combinations\n\n\ndef _find_marker_bars(g: np.ndarray, marker_color: int) -> list[list[tuple[int, int]]]:\n    \"\"\"\n    Marker bars are thin 4-connected components of the given marker color.\n    \"\"\"\n    cands = []\n    for pts_arr in components_mask(g == marker_color, connectivity=4):\n        r0, c0, r1, c1 = bbox_coords(pts_arr)\n        hh = r1 - r0 + 1\n        ww = c1 - c0 + 1\n        if hh == 1 or ww == 1:\n            pts = [(int(r), int(c)) for r, c in pts_arr]\n            cands.append((0 if len(pts) == 5 else 1, -r1, hh * ww, len(pts), pts))\n    cands.sort()\n    return [t[4] for t in cands]\n\n\ndef _single_color_components_in_cols(g: np.ndarray, cols: range, bg: int) -> list[list[tuple[int, int]]]:\n    h, w = g.shape\n    colmask = np.zeros((h, w), dtype=bool)\n    colmask[:, cols] = True\n    m = (g != bg) & colmask\n    comps = [[(int(r), int(c)) for r, c in pts] for pts in components_mask(m, connectivity=4)]\n    out = []\n    for pts in comps:\n        cols_in = {int(g[r, c]) for r, c in pts}\n        if len(cols_in) == 1:\n            out.append(pts)\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Transfer sprites from red-marked lanes to green-marked lanes, recoloring and stacking.\n\n    Input structure:\n    - bg = most common color. Red (2) and green (3) thin bars define vertical lanes.\n    - Each lane contains repeated identical monochrome sprites in an evenly spaced vertical grid.\n\n    Rule:\n    - Each red lane's sprites turn grey (5); their count transfers to the nearest green lane.\n    - New sprites fill empty lattice slots bottom-up, using the source shape recolored to the destination lane's sprite color.\n    - All marker bars are removed.\n\n    Key insight: Sprite count is conserved across lanes — red sprites become grey, and equally many new sprites stack into the green lane's regular grid.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    red_markers = _find_marker_bars(g, 2)\n    green_markers = _find_marker_bars(g, 3)\n    assert red_markers and green_markers, \"expected both red and green marker bars to be present\"\n\n    # Build destination lane state per green marker.\n    green_state = {}\n    for gm in green_markers:\n        _, dst_c0, _, dst_c1 = bbox_coords(np.array(gm))\n        dst_cols = range(dst_c0, dst_c1 + 1)\n        dst_set = set(gm)\n        dst_comps = _single_color_components_in_cols(g, dst_cols, bg)\n        dst_comps = [[p for p in pts if p not in dst_set] for pts in dst_comps]\n        dst_comps = [pts for pts in dst_comps if pts]\n        if not dst_comps:\n            continue\n\n        dst_sz = max(len(p) for p in dst_comps if len(p) != len(gm))\n        dst_sprites = [p for p in dst_comps if len(p) == dst_sz]\n        if not dst_sprites:\n            continue\n\n        dst_sprites_sorted = []\n        for pts in dst_sprites:\n            rmin = min(r for r, _ in pts)\n            cmin = min(c for _, c in pts)\n            dst_sprites_sorted.append((rmin, cmin, pts))\n        dst_sprites_sorted.sort()\n        dst_color = int(g[dst_sprites_sorted[0][2][0][0], dst_sprites_sorted[0][2][0][1]])\n\n        tops = sorted({rmin for rmin, _cmin, _pts in dst_sprites_sorted})\n        if len(tops) >= 2:\n            diffs = [b - a for a, b in zip(tops, tops[1:]) if b - a > 0]\n            period = int(np.gcd.reduce(diffs)) if diffs else 4\n        else:\n            r0, c0, r1, c1 = bbox_coords(np.array(dst_sprites_sorted[0][2]))\n            period = (r1 - r0 + 1) + 1\n\n        gc = (dst_c0 + dst_c1) / 2.0\n        green_state[id(gm)] = {\n            \"marker\": gm,\n            \"center\": gc,\n            \"dst_color\": dst_color,\n            \"period\": period,\n            \"occupied\": set(tops),\n            \"bottom0\": max(tops),\n        }\n\n    assert green_state, \"expected at least one green lane with valid sprites\"\n\n    out = g.copy()\n\n    for rm in red_markers:\n        _, src_c0, _, src_c1 = bbox_coords(np.array(rm))\n        src_cols = range(src_c0, src_c1 + 1)\n        src_set = set(rm)\n        src_comps = _single_color_components_in_cols(g, src_cols, bg)\n        src_comps = [[p for p in pts if p not in src_set] for pts in src_comps]\n        src_comps = [pts for pts in src_comps if pts]\n        if not src_comps:\n            continue\n\n        src_sz = max(len(p) for p in src_comps if len(p) != len(rm))\n        src_sprites = [p for p in src_comps if len(p) == src_sz]\n        if not src_sprites:\n            continue\n\n        # Grey out all source sprites.\n        for pts in src_sprites:\n            for r, c in pts:\n                out[r, c] = 5\n\n        # Nearest green lane by x-center.\n        rc = (src_c0 + src_c1) / 2.0\n        best = min(green_state.values(), key=lambda st: abs(st[\"center\"] - rc))\n\n        # Source template (top-most sprite), shifted horizontally to the destination lane center.\n        src_sprites_sorted = []\n        for pts in src_sprites:\n            rmin = min(r for r, _ in pts)\n            cmin = min(c for _, c in pts)\n            src_sprites_sorted.append((rmin, cmin, pts))\n        src_sprites_sorted.sort()\n        src_ref_r0, _src_ref_c0, src_ref_pts = src_sprites_sorted[0]\n\n        dc_shift = int(round(best[\"center\"] - rc))\n        src_offsets = [(r - src_ref_r0, c + dc_shift) for r, c in src_ref_pts]\n        sprite_h = max(dr for dr, _c in src_offsets) + 1\n\n        # Place as many sprites as removed, filling empty slots from the bottom upward.\n        n_new = len(src_sprites)\n        placed = 0\n        k = 0\n        while placed < n_new:\n            new_top = best[\"bottom0\"] - k * best[\"period\"]\n            k += 1\n            if new_top < 0 or new_top + sprite_h > h:\n                if new_top < 0:\n                    break\n                continue\n            if new_top in best[\"occupied\"]:\n                continue\n            ok = True\n            for dr, c in src_offsets:\n                rr = new_top + dr\n                if not (0 <= rr < h and 0 <= c < w):\n                    ok = False\n                    break\n                if int(out[rr, c]) != bg:\n                    ok = False\n                    break\n            if not ok:\n                continue\n            for dr, c in src_offsets:\n                out[new_top + dr, c] = best[\"dst_color\"]\n            best[\"occupied\"].add(new_top)\n            placed += 1\n\n    # Remove all marker bars.\n    for rm in red_markers:\n        for r, c in rm:\n            out[r, c] = bg\n    for gm in green_markers:\n        for r, c in gm:\n            out[r, c] = bg\n\n    return out\n\n# --------------- generator (O3) ---------------\n\n# --- CFG: canvas & layout ---\n_H, _W = 30, 30\n_NUM_LANES = 4\n_LANE_STARTS = [3, 9, 15, 21]       # col-0 of each lane's 5-wide sprite slot\n_MARKER_ROW = 29                     # row for red/green 1x5 marker bars\n_SPRITE_H, _SPRITE_W = 3, 5         # bounding box of the plus/diamond sprite\n\n# --- CFG: vertical stacking ---\n_BOTTOM_TOP = 25                     # top-row of the bottommost sprite\n_PERIOD = 4                          # vertical period (3 sprite rows + 1 gap)\n\n# --- CFG: color palette ---\n_BG_CHOICES = [0, 1, 4, 6, 7, 8, 9] # valid background colors (excludes 2, 3, 5)\n_GREY = 5                            # color used for greyed-out source sprites\n\n# --- CFG: counts & limits ---\n_MIN_SPRITES = 1                     # min sprites per lane in input\n_MAX_SPRITES = 3                     # max sprites per lane in input\n_MAX_LANE_TOTAL = 7                  # max sprites in green lane after transfer\n_GEN_RETRIES = 300                   # retry budget for generate_input()\n\n\ndef _sprite_patch(color: int, bg: int) -> np.ndarray:\n    \"\"\"Return a 3x5 plus/diamond sprite patch with bg-transparent corners.\"\"\"\n    patch = np.full((_SPRITE_H, _SPRITE_W), bg, dtype=int)\n    patch[0, 1:4] = color\n    patch[1, :] = color\n    patch[2, 1:4] = color\n    return patch\n\n\ndef _lane_tops(count: int) -> list[int]:\n    \"\"\"Return top-row positions for `count` sprites, ordered top-to-bottom.\"\"\"\n    return [_BOTTOM_TOP - _PERIOD * k for k in range(count - 1, -1, -1)]\n\n\ndef _paint_lane(grid: np.ndarray, lane_idx: int, color: int, count: int, bg: int) -> None:\n    \"\"\"Stamp `count` sprites of `color` into the given lane.\"\"\"\n    patch = _sprite_patch(color, bg)\n    c0 = _LANE_STARTS[lane_idx]\n    for r0 in _lane_tops(count):\n        paste(grid, patch, r0, c0, transparent=bg)\n\n\ndef _feasible_roles(counts: list[int]) -> dict[int, list[tuple[tuple[int, ...], int]]]:\n    \"\"\"Return feasible (reds, green) assignments grouped by number of red lanes.\"\"\"\n    grouped: dict[int, list[tuple[tuple[int, ...], int]]] = {1: [], 2: []}\n    for green in range(_NUM_LANES):\n        others = [i for i in range(_NUM_LANES) if i != green]\n        for red_count in (1, 2):\n            for reds in combinations(others, red_count):\n                if counts[green] + sum(counts[i] for i in reds) <= _MAX_LANE_TOTAL:\n                    grouped[red_count].append((reds, green))\n    return grouped\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n\n    # Choose palette\n    bg = int(rng.choice(_BG_CHOICES))\n    sprite_palette = [c for c in range(10) if c not in (bg, _GREY)]\n    lane_colors = rng.choice(sprite_palette, size=_NUM_LANES, replace=False).tolist()\n    input_counts = rng.integers(_MIN_SPRITES, _MAX_SPRITES + 1, size=_NUM_LANES).tolist()\n\n    # Choose role assignment (red source lanes, green destination lane)\n    feasible = _feasible_roles(input_counts)\n    feasible_red_counts = [rc for rc in (1, 2) if feasible[rc]]\n    if not feasible_red_counts:\n        return None\n\n    red_count = int(rng.choice(feasible_red_counts))\n    reds, green = feasible[red_count][int(rng.integers(len(feasible[red_count])))]\n    red_set = set(reds)\n    gain = sum(input_counts[i] for i in reds)\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/88bcf3b4.py\"","aggregated_output":"import numpy as np\nfrom collections import deque\n\nfrom arc_utils import components_mask, get_bg, neighbors4, neighbors8\nimport random\nfrom arc_utils import neighbors4\n\n\ndef _components(g: np.ndarray, col: int, conn8: bool) -> list[list[tuple[int, int]]]:\n    return [[(int(r), int(c)) for r, c in comp] for comp in components_mask(g == col, connectivity=8 if conn8 else 4)]\n\n\ndef _is_straight_line(comp: list[tuple[int, int]]) -> bool:\n    rs = [r for r, _ in comp]\n    cs = [c for _, c in comp]\n    if len(set(rs)) == 1:\n        row = rs[0]\n        cols = sorted(set(cs))\n        return cols == list(range(min(cols), max(cols) + 1))\n    if len(set(cs)) == 1:\n        col = cs[0]\n        rows = sorted(set(rs))\n        return rows == list(range(min(rows), max(rows) + 1))\n    return False\n\n\ndef _bar_endpoints(comp: list[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int]]:\n    rs = [r for r, _ in comp]\n    cs = [c for _, c in comp]\n    if len(set(cs)) == 1:\n        c = cs[0]\n        return (min(rs), c), (max(rs), c)\n    r = rs[0]\n    return (r, min(cs)), (r, max(cs))\n\n\ndef _touches_border(p: tuple[int, int], h: int, w: int) -> bool:\n    r, c = p\n    return r == 0 or c == 0 or r == h - 1 or c == w - 1\n\n\ndef _bfs_path(start: tuple[int, int], goal: tuple[int, int], walkable: np.ndarray) -> list[tuple[int, int]] | None:\n    h, w = walkable.shape\n    if start == goal:\n        return [start]\n    q = deque([start])\n    prev = {start: None}\n    while q:\n        r, c = q.popleft()\n        for nr, nc in neighbors8(r, c):\n            if not (0 <= nr < h and 0 <= nc < w):\n                continue\n            nxt = (nr, nc)\n            if nxt in prev:\n                continue\n            if not bool(walkable[nr, nc]) and nxt != goal:\n                continue\n            prev[nxt] = (r, c)\n            if nxt == goal:\n                q.clear()\n                break\n            q.append(nxt)\n    if goal not in prev:\n        return None\n    path = []\n    cur = goal\n    while cur is not None:\n        path.append(cur)\n        cur = prev[cur]\n    path.reverse()\n    return path\n\n\ndef _bfs_path_with_diag_filter(\n    start: tuple[int, int], goal: tuple[int, int], walkable: np.ndarray\n) -> list[tuple[int, int]] | None:\n    # Like _bfs_path but disallows diagonal steps when either orthogonal intermediate cell is also walkable.\n    h, w = walkable.shape\n    if start == goal:\n        return [start]\n    q = deque([start])\n    prev = {start: None}\n\n    def can_step(r: int, c: int, nr: int, nc: int) -> bool:\n        dr = nr - r\n        dc = nc - c\n        if dr == 0 or dc == 0:\n            return True\n        # diagonal: skip if either intermediate orth cell is in the walkable set\n        mid1 = (r, c + dc)\n        mid2 = (r + dr, c)\n        if 0 <= mid1[0] < h and 0 <= mid1[1] < w and bool(walkable[mid1]):\n            return False\n        if 0 <= mid2[0] < h and 0 <= mid2[1] < w and bool(walkable[mid2]):\n            return False\n        return True\n\n    while q:\n        r, c = q.popleft()\n        for nr, nc in neighbors8(r, c):\n            if not (0 <= nr < h and 0 <= nc < w):\n                continue\n            nxt = (nr, nc)\n            if nxt in prev:\n                continue\n            if not bool(walkable[nr, nc]) and nxt != goal:\n                continue\n            if not can_step(r, c, nr, nc):\n                continue\n            prev[nxt] = (r, c)\n            if nxt == goal:\n                q.clear()\n                break\n            q.append(nxt)\n    assert goal in prev, \"BFS-with-diag-filter must reach goal\"\n    path = []\n    cur = goal\n    while cur is not None:\n        path.append(cur)\n        cur = prev[cur]\n    path.reverse()\n    return path\n\n\ndef _greedy_manhattan_path(start: tuple[int, int], goal: tuple[int, int], walkable: np.ndarray) -> list[tuple[int, int]] | None:\n    h, w = walkable.shape\n\n    def md(p):\n        return abs(p[0] - goal[0]) + abs(p[1] - goal[1])\n\n    cur = start\n    path = [cur]\n    seen = {cur}\n    while cur != goal:\n        cur_md = md(cur)\n        best = None  # (md, is_diag, nr, nc)\n        for nr, nc in neighbors8(cur[0], cur[1]):\n            if not (0 <= nr < h and 0 <= nc < w):\n                continue\n            nxt = (nr, nc)\n            if nxt in seen:\n                continue\n            if not bool(walkable[nr, nc]) and nxt != goal:\n                continue\n            nmd = md(nxt)\n            if nmd >= cur_md:\n                continue\n            is_diag = 1 if (nr != cur[0] and nc != cur[1]) else 0\n            key = (nmd, is_diag, nr, nc)\n            if best is None or key < best:\n                best = key\n        if best is None:\n            return None\n        _, _, nr, nc = best\n        cur = (nr, nc)\n        path.append(cur)\n        seen.add(cur)\n    return path\n\n\ndef _segment_main_path(seg_pts: list[tuple[int, int]], start: tuple[int, int]) -> list[tuple[int, int]]:\n    # Extract the \"main stroke\" of the segment as a simple path.\n    #\n    # Use 4-neigh edges always. Allow diagonal edges only when they represent a true diagonal stroke,\n    # i.e. the diagonal pixels touch only at the corner (no orthogonal intermediate segment pixel),\n    # which prevents diagonal shortcuts across bends.\n    sset = set(seg_pts)\n\n    def neighbors(p: tuple[int, int]):\n        r, c = p\n        for q in neighbors4(r, c):\n            if q in sset:\n                yield q\n        for dr, dc in [(-1, -1), (-1, 1), (1, -1), (1, 1)]:\n            q = (r + dr, c + dc)\n            if q not in sset:\n                continue\n            # If either orthogonal intermediate cell is occupied, treat this as a bend shortcut and skip.\n            mid1 = (r, c + dc)\n            mid2 = (r + dr, c)\n            if mid1 in sset or mid2 in sset:\n                continue\n            yield q\n\n    q = deque([start])\n    prev: dict[tuple[int, int], tuple[int, int] | None] = {start: None}\n    dist: dict[tuple[int, int], int] = {start: 0}\n    while q:\n        cur = q.popleft()\n        for nxt in neighbors(cur):\n            if nxt in prev:\n                continue\n            prev[nxt] = cur\n            dist[nxt] = dist[cur] + 1\n            q.append(nxt)\n\n    far = max(dist.keys(), key=lambda p: (dist[p], p[0], p[1]))\n    path = []\n    cur = far\n    while cur is not None:\n        path.append(cur)\n        cur = prev[cur]\n    path.reverse()\n    return path\n\n\ndef _segment_degrees(seg_pts: list[tuple[int, int]]) -> dict[tuple[int, int], int]:\n    sset = set(seg_pts)\n    deg = {p: 0 for p in sset}\n    for r, c in sset:\n        # 4-neigh\n        for q in neighbors4(r, c):\n            if q in sset:\n                deg[(r, c)] += 1\n        # diagonals only if no orth intermediate is present\n        for dr, dc in [(-1, -1), (-1, 1), (1, -1), (1, 1)]:\n            q = (r + dr, c + dc)\n            if q not in sset:\n                continue\n            mid1 = (r, c + dc)\n            mid2 = (r + dr, c)\n            if mid1 in sset or mid2 in sset:\n                continue\n            deg[(r, c)] += 1\n    return deg\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Swing an irregular line segment around a nearby obstacle sprite, preserving its pixel count.\n\n    Input structure:\n    - bg, bar color (straight lines perpendicular to the grid edge, one end on the border), segment color (irregular stroke attached to bar's inner endpoint), obstacle color (sprite near the bar terminal).\n\n    Rule:\n    - Each bar is perpendicular to the edge it touches; its inner (terminal) endpoint has an attached irregular segment.\n    - The segment detaches and re-routes: it travels from the terminal toward the nearest obstacle, hugs the obstacle's boundary, then exits at a 45° diagonal.\n    - Total painted pixels equal the original segment length.\n\n    Key insight: The segment behaves like a rope swung around the obstacle — attach at the nearest point, trace the skin, exit diagonally, conserving length.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    colors = sorted(set(int(v) for v in np.unique(g)) - {bg})\n\n    out = g.copy()\n\n    def bar_candidates():\n        # Yield (bar_color, bar_component, terminal_endpoint).\n        for col in colors:\n            for comp in _components(g, col, conn8=False):\n                if len(comp) < 2 or not _is_straight_line(comp):\n                    continue\n                e0, e1 = _bar_endpoints(comp)\n                touch0 = _touches_border(e0, h, w)\n                touch1 = _touches_border(e1, h, w)\n                if touch0 == touch1:\n                    continue  # require exactly one endpoint on border\n","exit_code":0,"status":"completed"}}
