{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nfrom collections import deque\n\ndef conn(mask, val=True):\n    h=len(mask); w=len(mask[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]==val]\n    if not pts: return False\n    q=deque([pts[0]]); seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            rr,cc=r+dr,c+dc\n            if 0<=rr<h and 0<=cc<w and mask[rr][cc]==val and (rr,cc) not in seen:\n                seen.add((rr,cc)); q.append((rr,cc))\n    return len(seen)==len(pts)\n\ndef bbox_full(mask,val=True):\n    pts=[(r,c) for r,row in enumerate(mask) for c,x in enumerate(row) if x==val]\n    if not pts: return False\n    rs=[r for r,c in pts]; cs=[c for r,c in pts]\n    h=len(mask); w=len(mask[0])\n    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1\n\nfor h,w in [(3,4),(4,4),(4,5),(5,5),(5,6),(6,6)]:\n    ok=0\n    for _ in range(20000):\n        total=h*w\n        steps=random.randint(max(h+w-2,4), min(total-4,total//2+4))\n        r=random.randrange(h); c=random.randrange(w)\n        cells={(r,c)}\n        cur=(r,c)\n        for _ in range(steps-1):\n            nbr=[(cur[0]+dr,cur[1]+dc) for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)) if 0<=cur[0]+dr<h and 0<=cur[1]+dc<w]\n            # prefer new cell, else allow revisits and jump endpoint? no\n            nbr2=[p for p in nbr if p not in cells]\n            if nbr2:\n                cur=random.choice(nbr2)\n                cells.add(cur)\n            else:\n                cur=random.choice(list(cells))\n        mask=[[False]*w for _ in range(h)]\n        for r,c in cells: mask[r][c]=True\n        if conn(mask,True) and conn(mask,False) and bbox_full(mask,True) and bbox_full(mask,False):\n            ok+=1\n    print((h,w), ok)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
