{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/291dc1e1.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Reorder and stack rectangles by proximity to two colored edge lines.\n\n    Input structure:\n    - bg = most common color.\n    - Two edge lines (h + v) meet at a corner marked by a unique color.\n    - \"Blue\" line is color 1 if present, else the longer line; other is \"red.\"\n    - Solid rectangles in the interior.\n\n    Rule:\n    - Sort rectangles by (distance to blue edge, distance to red edge).\n    - If the blue edge is vertical, rotate each rectangle 90° CCW.\n    - Stack top-to-bottom, centered horizontally.\n\n    Key insight: Edge-line colors encode a coordinate system; proximity to each axis determines stacking order and rotation.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # --- locate the marked corner ---\n    corners = [(0, 0), (0, int(W - 1)), (int(H - 1), 0), (int(H - 1), int(W - 1))]\n    corner = None\n    for r, c in corners:\n        if int(g[r, c]) == int(bg):\n            continue\n        nbr = []\n        if r == 0:\n            nbr.append(int(g[r + 1, c]))\n        if r == H - 1:\n            nbr.append(int(g[r - 1, c]))\n        if c == 0:\n            nbr.append(int(g[r, c + 1]))\n        if c == W - 1:\n            nbr.append(int(g[r, c - 1]))\n        if nbr and all(int(n) != int(g[r, c]) for n in nbr):\n            corner = (int(r), int(c))\n            break\n    assert corner is not None\n\n    cr, cc = map(int, corner)\n    marker = int(g[cr, cc])\n\n    # --- line colors adjacent to the corner ---\n    hstep = 1 if cc == 0 else -1\n    vstep = 1 if cr == 0 else -1\n    hcol = int(g[cr, cc + hstep])\n    vcol = int(g[cr + vstep, cc])\n\n    # Choose \"blue\" line color.\n    if hcol == 1 or vcol == 1:\n        blue_col = 1\n        red_col = int(vcol if hcol == 1 else hcol)\n    else:\n        # Fallback: longer line is blue.\n        hlen = 0\n        c = int(cc + hstep)\n        while 0 <= c < W and int(g[cr, c]) == int(hcol):\n            hlen += 1\n            c += int(hstep)\n        vlen = 0\n        r = int(cr + vstep)\n        while 0 <= r < H and int(g[r, cc]) == int(vcol):\n            vlen += 1\n            r += int(vstep)\n        if vlen >= hlen:\n            blue_col = int(vcol)\n            red_col = int(hcol)\n        else:\n            blue_col = int(hcol)\n            red_col = int(vcol)\n\n    blue_orient = \"h\" if int(hcol) == int(blue_col) else \"v\"\n    red_orient = \"h\" if int(hcol) == int(red_col) else \"v\"\n\n    # --- mask out the two edge lines (entire corner row + col) ---\n    line_mask = np.zeros((H, W), dtype=bool)\n    line_mask[cr, :] = True\n    line_mask[:, cc] = True\n\n    # --- extract solid rectangles (no bg inside bbox) ---\n    mask = (g != int(bg)) & (~line_mask) & (g != int(marker))\n    rects = []\n    for coords in components_mask(mask, connectivity=4):\n        if coords.size == 0:\n            continue\n        b = bbox_coords(coords)\n        sub = crop_bbox(g, b)\n        if bool((sub == int(bg)).any()):\n            continue\n        rects.append({\"box\": tuple(map(int, b)), \"arr\": sub.copy()})\n\n    assert not (not rects)\n\n    def dist_to_edge(rect: dict, orient: str, edge_idx: int) -> int:\n        r0, c0, r1, c1 = map(int, rect[\"box\"])\n        if orient == \"v\":\n            col = int(edge_idx)\n            if int(c0) > col:\n                return int(c0 - col - 1)\n            if int(c1) < col:\n                return int(col - c1 - 1)\n            return 0\n        row = int(edge_idx)\n        if int(r0) > row:\n            return int(r0 - row - 1)\n        if int(r1) < row:\n            return int(row - r1 - 1)\n        return 0\n\n    blue_edge_idx = int(cc if blue_orient == \"v\" else cr)\n    red_edge_idx = int(cc if red_orient == \"v\" else cr)\n\n    def along_from_corner(rect: dict, orient: str) -> int:\n        r0, c0, r1, c1 = map(int, rect[\"box\"])\n        if orient == \"v\":\n            return int(r0 if cr == 0 else -r1)\n        return int(c0 if cc == 0 else -c1)\n\n    for rct in rects:\n        rct[\"db\"] = int(dist_to_edge(rct, blue_orient, blue_edge_idx))\n        rct[\"dr\"] = int(dist_to_edge(rct, red_orient, red_edge_idx))\n\n    rects.sort(\n        key=lambda r: (\n            int(r[\"db\"]),\n            int(r[\"dr\"]),\n            along_from_corner(r, blue_orient),\n            along_from_corner(r, red_orient),\n        )\n    )\n\n    # Rotate all rectangles if blue edge is vertical.\n    seq = []\n    for rct in rects:\n        a = rct[\"arr\"]\n        if blue_orient == \"v\":\n            a = np.rot90(a, k=1)  # CCW\n        seq.append(a)\n\n    outW = int(max(int(a.shape[1]) for a in seq))\n    outH = int(sum(int(a.shape[0]) for a in seq))\n    out = np.full((outH, outW), int(bg), dtype=int)\n\n    out_r = 0\n    for a in seq:\n        h, w = map(int, a.shape)\n        out_c = int((outW - w) // 2)\n        paste(out, a, int(out_r), int(out_c))\n        out_r += int(h)\n\n    return out\n\n# --------------- generator (attempt 3, Codex) ---------------\n\nBG = 8\nBLUE = 1\nRED = 2\nMARKER = 0\nDOMINANT_COLORS = np.array([3, 4, 5, 6, 7, 9], dtype=int)\nMINORITY_COLORS = np.array([1, 2, 3, 4, 5, 6, 7, 9], dtype=int)\n\n\ndef _transform(grid: np.ndarray, blue_orient: str, corner: str) -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/train/3ad05f52.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Paint the maze corridor and framed rooms lying on shortest paths between the two colored endpoint components.\n\n    Input structure\n    - The grid has a dominant background, one wall color forming thin orthogonal frames, and one endpoint/fill color.\n    - The endpoint/fill color forms exactly two 4-connected solid rectangular components; their larger side lengths define the framed room sizes.\n\n    Rule\n    - Treat wall pixels as blocked and every other pixel as passable.\n    - Find every passable pixel that lies on a shortest 4-connected path between the two endpoint components.\n    - Also fill any framed square room of an endpoint-derived size that intersects that shortest-path mask.\n\n    Key insight\n    - Shortest paths identify the route through open connector corridors, while the wall-bordered square rooms need to be expanded from the route centerline to their full interior.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    counts = Counter(map(int, g.flat))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 2\n    assert counts[bg] > max(counts[color] for color in non_bg)\n    non_bg_counts = {color: int(np.count_nonzero(g == color)) for color in non_bg}\n    wall_count = max(non_bg_counts.values())\n    wall_candidates = [color for color, count in non_bg_counts.items() if count == wall_count]\n    assert len(wall_candidates) == 1\n    wall = wall_candidates[0]\n    paint_candidates = [color for color in non_bg if color != wall]\n    assert len(paint_candidates) == 1\n    paint = paint_candidates[0]\n    assert non_bg_counts[wall] > non_bg_counts[paint]\n\n    endpoints = find_components(g, bg=bg, colors=[paint], connectivity=4)\n    assert len(endpoints) == 2\n    endpoint_coords = [component[\"coords\"] for component in endpoints]\n\n    room_sizes: set[int] = set()\n    for coords in endpoint_coords:\n        r0, c0, r1, c1 = bbox_coords(coords)\n        bh = r1 - r0 + 1\n        bw = c1 - c0 + 1\n        assert coords.shape[0] == bh * bw\n        room_sizes.add(max(bh, bw))\n\n    passable = g != wall\n    dist0 = _distances_from(endpoint_coords[0], passable)\n    dist1 = _distances_from(endpoint_coords[1], passable)\n    endpoint_distances = [int(dist0[r, c]) for r, c in endpoint_coords[1]]\n    reachable_distances = [d for d in endpoint_distances if d >= 0]\n    assert len(reachable_distances) == len(endpoint_distances)\n    shortest = min(reachable_distances)\n\n    route = (dist0 >= 0) & (dist1 >= 0) & (dist0 + dist1 == shortest)\n    assert np.any(route)\n\n    fill = route.copy()\n    rooms = _framed_square_rooms(g, wall, room_sizes)\n    assert rooms\n    for r, c, n in rooms:\n        if np.any(route[r : r + n, c : c + n]):\n            fill[r : r + n, c : c + n] = True\n\n    room_mask = np.zeros_like(fill, dtype=bool)\n    for r, c, n in rooms:\n        room_mask[r : r + n, c : c + n] = True\n    open_fill = fill & (g == bg) & ~room_mask\n    for r0, c0, r1, c1, area in _component_bboxes(open_fill):\n        if r1 > r0 and c1 > c0 and area >= 20:\n            assert _middle_fill_bounded_by_side_rooms(\n                (r0, c0, r1, c1),\n                rooms,\n            ), \"middle fill must stay within the facing room-frame spans\"\n\n    H, W = g.shape\n    for r, c, n in rooms:\n        has_doorway = False\n        if r > 0:\n            has_doorway = has_doorway or np.any(g[r - 1, c : c + n] != wall)\n        if r + n < H:\n            has_doorway = has_doorway or np.any(g[r + n, c : c + n] != wall)\n        if c > 0:\n            has_doorway = has_doorway or np.any(g[r : r + n, c - 1] != wall)\n        if c + n < W:\n            has_doorway = has_doorway or np.any(g[r : r + n, c + n] != wall)\n        if has_doorway:\n            assert np.any(fill[r : r + n, c : c + n]), \"rooms with doorways must be on the shortest path\"\n\n    out = g.copy()\n    out[fill & (g == bg)] = paint\n    return out\n\n# --------------- generator (attempt 2 refined middle-fill) ---------------\n\nBG = 0\nWALL = 8\nPAINT_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]\n\n# Canvas bounds used by the observed evaluation examples.\nROW_MIN = 22\nROW_MAX = 29\nCOL_MIN = 24\nCOL_MAX = 28\n\n# Room-grid geometry and room-count filters.\nROOM_SIZE_RANGE = range(3, 6)\nROOM_GRID_RANGE = range(1, 8)\nBLOCK_ROOM_MIN = 3\nBLOCK_ROOM_MAX = 14\nTOTAL_ROOM_MIN = 7\nTOTAL_ROOM_MAX = 22\nGAP_RANGE = range(3, 8)\nORIENTATIONS = (\"vertical\", \"horizontal\")\n\n# Coarse layout and final route validation thresholds.\nLAYOUT_DISTANCE_MIN = 36\nLAYOUT_DISTANCE_FLOORS = [36, 42, 48, 54, 60]\nSHORTEST_DISTANCE_MIN = 36\nSHORTEST_DISTANCE_MAX = 72\nTURN_MIN = 8\nTURN_MAX = 21\nON_ROUTE_ROOM_MIN = 6\nON_ROUTE_ROOM_MAX = 14\nOFF_ROUTE_ROOM_MIN = 1\nOFF_ROUTE_ROOM_MAX = 8\n\n# Connector sampling: offset connectors create the observed middle fill region.\nOFFSET_CONNECTOR_PROB = 0.60\nCONNECTOR_CHOICE_TRIES = 300\nCONNECTOR_DELTA_MAX = 12\nCONNECTOR_DELTA_MIN_CAP = 5\n\n# Endpoint room selection favors far rooms, with a minority near-exit branch.\nNEAR_EXIT_ENDPOINT_PROB = 0.30\nNEAR_EXIT_STEPS = [-1, 0, 1]\n\n# Full-example rejection retries.\nGENERATE_ATTEMPTS = 300\n\n_NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n_LAYOUTS = None\n_LAST_META = None\n\n\ndef _block_shape(rows, cols, size):\n","exit_code":0,"status":"completed"}}
