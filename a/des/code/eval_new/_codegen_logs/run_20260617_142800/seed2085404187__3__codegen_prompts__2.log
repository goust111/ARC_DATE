{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nfrom collections import deque\n\ndef conn(mask):\n    h=len(mask); w=len(mask[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]]\n    if not pts: return False\n    q=deque([pts[0]]); seen={pts[0]}\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            rr,cc=r+dr,c+dc\n            if 0<=rr<h and 0<=cc<w and mask[rr][cc] and (rr,cc) not in seen:\n                seen.add((rr,cc)); q.append((rr,cc))\n    return len(seen)==len(pts)\n\ndef bbox_full(mask, val=True):\n    h=len(mask); w=len(mask[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if mask[r][c]==val]\n    if not pts: return False\n    rs=[r for r,c in pts]; cs=[c for r,c in pts]\n    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1\n\ndef gen(h,w,attempts=10000):\n    cells=[(r,c) for r in range(h) for c in range(w)]\n    edges={\n      'top':[(0,c) for c in range(w)],\n      'bottom':[(h-1,c) for c in range(w)],\n      'left':[(r,0) for r in range(h)],\n      'right':[(r,w-1) for r in range(h)],\n    }\n    ok=0\n    for _ in range(attempts):\n        # random connected mask by growth from random cell\n        total=h*w\n        target=random.randint(max(4,total//4), min(total-4, (3*total)//4))\n        mask=[[False]*w for _ in range(h)]\n        # seed from one edge cell on each side, then connect by walks\n        side_cells={k:random.choice(v) for k,v in edges.items()}\n        order=['top','right','bottom','left']\n        cur=side_cells[order[0]]\n        mask[cur[0]][cur[1]]=True\n        for k in order[1:]:\n            tr,tc=side_cells[k]\n            r,c=cur\n            while (r,c)\"'!=(tr,tc):\n                opts=[]\n                if r<tr: opts.append((r+1,c))\n                elif r>tr: opts.append((r-1,c))\n                if c<tc: opts.append((r,c+1))\n                elif c>tc: opts.append((r,c-1))\n                r,c=random.choice(opts)\n                mask[r][c]=True\n            cur=(tr,tc)\n        frontier=[(r,c) for r in range(h) for c in range(w) if mask[r][c]]\n        while sum(sum(row) for row in mask)<target:\n            r,c=random.choice(frontier)\n            ns=[(r+dr,c+dc) for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)) if 0<=r+dr<h and 0<=c+dc<w and not mask[r+dr][c+dc]]\n            if not ns: \n                frontier=[(rr,cc) for rr in range(h) for cc in range(w) if mask[rr][cc]]\n                if not any((0<=rr+dr<h and 0<=cc+dc<w and not mask[rr+dr][cc+dc]) for rr,cc in frontier for dr,dc in ((1,0),(-1,0),(0,1),(0,-1))):\n                    break\n                continue\n            rr,cc=random.choice(ns)\n            mask[rr][cc]=True\n            frontier.append((rr,cc))\n        comp=[[not x for x in row] for row in mask]\n        if conn(mask) and conn(comp) and bbox_full(mask) and bbox_full(comp, True):\n            ok+=1\n    return ok\n\nfor h,w in [(3,4),(4,4),(4,5),(5,5),(5,6),(6,6)]:\n    print((h,w), gen(h,w,2000))\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
