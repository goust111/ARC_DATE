{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/train/d749d46f.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Pack each solid foreground rectangle twice: wide across the top and tall from the bottom.\n\n    Input structure\n    The grid has one background color and one foreground color; the foreground forms\n    separate solid rectangles, ordered from left to right.\n\n    Rule\n    Build a 10-row background canvas whose width is the packed width of the wide\n    versions of the rectangles. For each source rectangle, paint a top-aligned\n    rectangle of shape min(h,w) by max(h,w), with one background column between\n    consecutive rectangles. Then, starting again from the left edge, paint a\n    bottom-aligned rectangle of shape max(h,w) by min(h,w) for each source rectangle,\n    again separated by one background column.\n\n    Key insight\n    The input rectangles are not copied in their original orientations; each object\n    contributes one horizontal-facing and one vertical-facing normalized rectangle,\n    preserving left-to-right object order.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    fg_colors = colors_present(g, exclude={bg})\n    assert len(fg_colors) == 1\n    fg = fg_colors[0]\n\n    components = find_components(g, bg=bg, connectivity=4, colors=[fg])\n    assert components\n    components = sorted(components, key=lambda obj: (obj[\"bbox\"][1], obj[\"bbox\"][0]))\n\n    dims: list[tuple[int, int]] = []\n    for obj in components:\n        r0, c0, r1, c1 = obj[\"bbox\"]\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        assert obj[\"area\"] == h * w\n        dims.append((h, w))\n\n    out_h = 10\n    out_w = sum(max(h, w) for h, w in dims) + len(dims) - 1\n    _assert_output_footprints_disjoint(dims)\n    out = np.full((out_h, out_w), bg, dtype=int)\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[:short, c : c + long] = fg\n        c += long + 1\n\n    c = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        assert long <= out_h\n        out[out_h - long : out_h, c : c + short] = fg\n        c += short + 1\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Color palette.\nCOLOR_VALUES = tuple(range(10))\n\n# Rectangle counts and dimensions.\nRECT_COUNT_MIN = 4\nRECT_COUNT_MAX = 6\nSHORT_SIDE_MIN = 1\nSHORT_SIDE_MAX = 3\nSIDE_SUM_MAX = 10\nLONG_SIDE_MAX = SIDE_SUM_MAX - SHORT_SIDE_MIN\n\n# Canvas and packing constraints.\nARC_GRID_MAX = 30\nOUTPUT_HEIGHT = 10\nGAP_WIDTH = 1\n\n# Retry policy.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_d749d46f_output_footprints_disjoint(dims):\n    occupied = set()\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {(r, c) for r in range(short) for c in range(col, col + long)}\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += long + GAP_WIDTH\n\n    col = 0\n    for h, w in dims:\n        short, long = min(h, w), max(h, w)\n        cells = {\n            (r, c)\n            for r in range(OUTPUT_HEIGHT - long, OUTPUT_HEIGHT)\n            for c in range(col, col + short)\n        }\n        if occupied & cells:\n            return False\n        occupied |= cells\n        col += short + GAP_WIDTH\n\n    return True\n\n\ndef _sample_dimensions(n_rects):\n    \"\"\"Sample source rectangle dimensions under the output-width budget.\"\"\"\n    dims = []\n    remaining_budget = ARC_GRID_MAX - GAP_WIDTH * (n_rects - 1)\n\n    for i in range(n_rects):\n        rects_left = n_rects - i\n        min_needed = rects_left - 1\n        max_for_this = min(remaining_budget - min_needed, LONG_SIDE_MAX)\n        if max_for_this < SHORT_SIDE_MIN:\n            return None\n\n        short = random.randint(SHORT_SIDE_MIN, SHORT_SIDE_MAX)\n        max_long = min(SIDE_SUM_MAX - short, max_for_this)\n        if max_long < short:\n            short = SHORT_SIDE_MIN\n            max_long = min(LONG_SIDE_MAX, max_for_this)\n            if max_long < SHORT_SIDE_MIN:\n                return None\n\n        long = random.randint(short, max_long)\n        remaining_budget -= long\n\n        if random.random() < 0.5:\n            h, w = long, short\n        else:\n            h, w = short, long\n        dims.append((h, w))\n\n    return dims\n\n\ndef _input_shape(dims):\n    return max(h for h, _ in dims), sum(w for _, w in dims) + GAP_WIDTH * (len(dims) - 1)\n\n\ndef _background_is_dominant(dims, inp_h, inp_w):\n    fg_pixels = sum(h * w for h, w in dims)\n    total_pixels = inp_h * inp_w\n    bg_pixels = total_pixels - fg_pixels\n    return bg_pixels > fg_pixels\n\n\ndef _build_input_grid(dims, bg, fg, inp_h, inp_w):\n    grid = np.full((inp_h, inp_w), bg, dtype=int)\n    col = 0\n    for h, w in dims:\n        grid[:h, col:col + w] = fg\n        col += w + GAP_WIDTH\n    return grid\n\n\ndef _passes_solver_oracle(grid):\n    try:\n        out = main(grid)\n    except Exception:\n        return False\n    return out.shape[0] == OUTPUT_HEIGHT\n\n\ndef _gen_attempt():\n    \"\"\"Generate one valid input grid, or None when sampled dimensions fail constraints.\"\"\"\n    bg, fg = random.sample(COLOR_VALUES, 2)\n    n_rects = random.randint(RECT_COUNT_MIN, RECT_COUNT_MAX)\n    dims = _sample_dimensions(n_rects)\n    if dims is None:\n        return None\n\n    inp_h, inp_w = _input_shape(dims)\n    if inp_w > ARC_GRID_MAX:\n        return None\n    if not _gen_d749d46f_output_footprints_disjoint(dims):\n        return None\n    if inp_h > ARC_GRID_MAX or inp_h < 1:\n        return None\n    if not _background_is_dominant(dims, inp_h, inp_w):\n        return None\n\n    grid = _build_input_grid(dims, bg, fg, inp_h, inp_w)\n    if not _passes_solver_oracle(grid):\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/train/3cd86f4f.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Shear the rectangular input down-left onto a black canvas.\n\n    Input structure\n    A rectangular grid of colored pixels with no internal empty region to infer.\n\n    Rule\n    Create a black output with the same height and width W + H - 1, then copy\n    each input row r unchanged starting at column H - 1 - r.\n\n    Key insight\n    The colors and row contents are preserved; only the row offsets change so\n    the left edge forms a descending diagonal.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h > 0 and w > 0\n\n    out = np.zeros((h, w + h - 1), dtype=int)\n    for r in range(h):\n        start = h - 1 - r\n        out[r, start : start + w] = g[r]\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and palette bounds.\nMIN_HEIGHT, MAX_HEIGHT = 2, 10\nMIN_WIDTH, MAX_WIDTH = 1, 9\nMIN_COLOR_COUNT, MAX_COLOR_COUNT = 4, 5\nMAX_CELLS, MAX_OUTPUT_WIDTH = 36, 30\nPALETTE_VALUES = range(1, 10)\n\n# Fill pattern controls.\nFILL_MODES = (\"noise\", \"row_runs\", \"column_bands\", \"diagonal_bands\")\nMAX_ROW_RUN_CUTS = 3\nCOLUMN_NOISE_PROB = 0.5\nMIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND = 1, 3\nDIAGONAL_FLIP_PROB = 0.5\n\n# Generation safety.\nGENERATION_RETRIES = 300\n\n\ndef _ensure_palette_coverage(arr, palette):\n    positions = random.sample(range(arr.size), len(palette))\n    rows, cols = np.divmod(positions, arr.shape[1])\n    arr[rows, cols] = palette\n\n\ndef _fill_grid(h, w, palette):\n    k = len(palette)\n    mode = random.choice(FILL_MODES)\n    arr = np.zeros((h, w), dtype=int)\n\n    if mode == \"noise\":\n        arr[:] = np.random.choice(palette, size=(h, w))\n    elif mode == \"row_runs\":\n        for r in range(h):\n            cuts = sorted(random.sample(range(1, w), random.randint(0, min(w - 1, MAX_ROW_RUN_CUTS)))) if w > 1 else []\n            starts = [0] + cuts\n            ends = cuts + [w]\n            last = None\n            for c0, c1 in zip(starts, ends):\n                choices = [c for c in palette if c != last] or list(palette)\n                last = random.choice(choices)\n                arr[r, c0:c1] = last\n    elif mode == \"column_bands\":\n        for c in range(w):\n            arr[:, c] = random.choice(palette)\n        if random.random() < COLUMN_NOISE_PROB:\n            for r in range(h):\n                arr[r, random.randrange(w)] = random.choice(palette)\n    else:\n        band = random.randint(MIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND)\n        phase = random.randrange(k)\n        rows, cols = np.indices((h, w))\n        arr[:] = np.asarray(palette)[((rows + cols) // band + phase) % k]\n        if random.random() < DIAGONAL_FLIP_PROB:\n            arr = np.fliplr(arr)\n\n    _ensure_palette_coverage(arr, palette)\n    return arr\n\n\ndef _gen_attempt():\n    k = random.randint(MIN_COLOR_COUNT, MAX_COLOR_COUNT)\n    h = random.randint(MIN_HEIGHT, MAX_HEIGHT)\n    widths = [\n        w\n        for w in range(MIN_WIDTH, MAX_WIDTH + 1)\n        if h * w >= k and h * w <= MAX_CELLS and w + h - 1 <= MAX_OUTPUT_WIDTH\n    ]\n    if not widths:\n        return None\n    w = random.choice(widths)\n    palette = random.sample(PALETTE_VALUES, k)\n    return _fill_grid(h, w, palette)\n\n\ndef generate_input():\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/train/37ce87bb.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/train/37ce87bb.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Compute a grey result bar by adding teal bar heights and subtracting red bar heights.\n\n    Input structure\n    - The grid has a dominant background and several bottom-aligned one-cell-wide vertical bars.\n    - Teal bars are positive operands; red bars are negative operands.\n    - The penultimate column is an empty result slot.\n\n    Rule\n    - Keep every input bar unchanged.\n    - Compute result height = total teal bar height - total red bar height.\n    - Paint that many bottom cells of the penultimate column grey.\n\n    Key insight\n    - The bars encode arithmetic by height, with color providing the sign.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height, width = g.shape\n    bg = get_bg(g)\n    bars = _operand_bars(g, bg)\n\n    result_height = 0\n    for bar in bars:\n        if bar[\"color\"] == Color.TEAL:\n            result_height += bar[\"height\"]\n        else:\n            assert bar[\"color\"] == Color.RED\n            result_height -= bar[\"height\"]\n\n    assert 0 < result_height <= height\n    assert width >= 2\n    result_col = width - 2\n    assert bool(np.all(g[:, result_col] == bg))\n\n    out = g.copy()\n    out[height - result_height : height, result_col] = Color.GREY\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas, object, and result-size bounds.\nBAR_COUNT_RANGE = (2, 6)\nGRID_HEIGHT_RANGE = (6, 12)\nTOP_MARGIN_ROWS, RESULT_HEIGHT_MIN = 1, 1\n# Column layout.\nBAR_COL_START, BAR_COL_STRIDE, WIDTH_EXTRA_COLS, RESULT_COL_FROM_RIGHT = 1, 2, 3, 2\n# Color palette and retry budget.\nBG_COLOR, RESULT_COLOR, POSITIVE_COLOR, NEGATIVE_COLOR = Color.ORANGE, Color.GREY, Color.TEAL, Color.RED\nGEN_RETRY_LIMIT = 300\n\n\ndef _bounded_composition(total: int, parts: int, *, upper: int) -> list[int] | None:\n    \"\"\"Sample positive bounded parts summing to total, or None if impossible.\"\"\"\n    if parts == 0:\n        return [] if total == 0 else None\n    if not (parts <= total <= parts * upper):\n        return None\n    values = []\n    remaining = total\n    for i in range(parts):\n        slots = parts - i - 1\n        lo = max(1, remaining - slots * upper)\n        hi = min(upper, remaining - slots)\n        value = random.randint(lo, hi)\n        values.append(value)\n        remaining -= value\n    random.shuffle(values)\n    return values\n\n\ndef _sample_bar_specs(n: int, max_bar_height: int) -> tuple[list[tuple[int, int]], int] | None:\n    \"\"\"Sample shuffled operand specs and the matching grey result height.\"\"\"\n    result_height = random.randint(RESULT_HEIGHT_MIN, max_bar_height)\n    feasible_teal_counts = []\n    for teal_count in range(1, n + 1):\n        red_count = n - teal_count\n        red_sum_lo = max(red_count, teal_count - result_height)\n        red_sum_hi = min(red_count * max_bar_height, teal_count * max_bar_height - result_height)\n        if red_sum_lo <= red_sum_hi:\n            feasible_teal_counts.append((teal_count, red_sum_lo, red_sum_hi))\n    if not feasible_teal_counts:\n        return None\n\n    teal_count, red_sum_lo, red_sum_hi = random.choice(feasible_teal_counts)\n    red_count = n - teal_count\n    red_sum = random.randint(red_sum_lo, red_sum_hi)\n    teal_sum = red_sum + result_height\n    teal_heights = _bounded_composition(teal_sum, teal_count, upper=max_bar_height)\n    red_heights = _bounded_composition(red_sum, red_count, upper=max_bar_height)\n    if teal_heights is None or red_heights is None:\n        return None\n\n    bar_specs = [(POSITIVE_COLOR, h) for h in teal_heights] + [(NEGATIVE_COLOR, h) for h in red_heights]\n    random.shuffle(bar_specs)\n    return bar_specs, result_height\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    n = random.randint(*BAR_COUNT_RANGE)\n    height = random.randint(*GRID_HEIGHT_RANGE)\n    max_bar_height = height - TOP_MARGIN_ROWS\n    width = BAR_COL_STRIDE * n + WIDTH_EXTRA_COLS\n    if (sampled := _sample_bar_specs(n, max_bar_height)) is None:\n        return None\n    bar_specs, result_height = sampled\n    out = np.full((height, width), BG_COLOR, dtype=int)\n    for i, (color, bar_height) in enumerate(bar_specs):\n        col = BAR_COL_START + BAR_COL_STRIDE * i\n        out[height - bar_height : height, col] = color\n    out[height - result_height : height, width - RESULT_COL_FROM_RIGHT] = RESULT_COLOR\n\n    inp = out.copy()\n    inp[:, width - RESULT_COL_FROM_RIGHT] = BG_COLOR\n    if not np.array_equal(main(inp), out):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
