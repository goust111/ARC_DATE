{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/train/963c33f8.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Drop the columns of the top marker downward, stopping blue-ended columns on grey obstacles and letting maroon-ended columns pass to the bottom.\n\n    Input structure\n    - The background is the dominant color.\n    - The most numerous non-background color forms stationary grey obstacle pixels.\n    - The other two colors form a single 3x3 top-edge marker whose top two rows\n      are maroon and whose bottom row contains maroon or blue control pixels.\n\n    Rule\n    - Erase the top marker.\n    - Treat each marker column as a vertical drop retaining its three colors.\n    - A column whose bottom control pixel is blue stops immediately above the\n      first grey pixel below that column, or bottom-aligns if none exists.\n    - Contiguous maroon-ended columns pass through obstacles and bottom-align;\n      if such a run has a clear down-right slide from a grey ledge, shift the\n      run one column right before bottom-aligning.\n    - When a maroon-ended drop lands through a grey bar on the bottom edge, clear\n      the rest of the marker-width gap in that bottom bar.\n\n    Key insight\n    - The bottom row of the top marker is a control strip: blue cells mean\n      \"stick to the first obstacle,\" while maroon cells mean \"fall through.\"\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H = g.shape[0]\n    bg = int(get_bg(g))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 3, \"expected obstacle color plus two marker colors\"\n    obstacle = _unique_largest_count_color(g, non_bg)\n    marker_colors = [color for color in non_bg if color != obstacle]\n    assert len(marker_colors) == 2, \"expected exactly two marker colors\"\n\n    r0, c0, r1, c1 = _marker_bbox(g, marker_colors)\n    marker = g[r0 : r1 + 1, c0 : c1 + 1]\n    marker_h, marker_w = marker.shape\n    assert (marker_h, marker_w) == (3, 3), \"expected a 3x3 marker\"\n    assert np.all(np.isin(marker, marker_colors)), \"marker bbox must contain only marker colors\"\n\n    pass_color = int(marker[0, 0])\n    assert np.all(marker[:2, :] == pass_color), \"top two marker rows must be the pass-through color\"\n    stop_colors = [color for color in marker_colors if color != pass_color]\n    assert len(stop_colors) == 1, \"expected one stop color\"\n    stop_color = stop_colors[0]\n\n    out = g.copy()\n    out[r0 : r1 + 1, c0 : c1 + 1] = bg\n    base = out.copy()\n\n    pass_columns: list[int] = []\n    for j in range(marker_w):\n        c = c0 + j\n        stack = marker[:, j]\n        bottom_control = int(stack[-1])\n\n        if bottom_control == stop_color:\n            obstacles_below = np.flatnonzero(base[r1 + 1 :, c] == obstacle)\n            if len(obstacles_below):\n                floor_r = int(r1 + 1 + obstacles_below[0])\n                top_r = floor_r - marker_h\n            else:\n                top_r = H - marker_h\n            assert top_r >= 0, \"stopped column must fit above its obstacle\"\n            out[top_r : top_r + marker_h, c] = stack\n        else:\n            assert bottom_control == pass_color, \"bottom control must be one of the marker colors\"\n            pass_columns.append(j)\n\n    for start_j, end_j in _runs(pass_columns):\n        source_cols = list(range(c0 + start_j, c0 + end_j + 1))\n        shift = 1 if _can_slide_right(base, obstacle, bg, source_cols, r1, marker_h) else 0\n        top_r = H - marker_h\n\n        for j in range(start_j, end_j + 1):\n            c = c0 + j + shift\n            _clear_bottom_edge_gap(base, out, obstacle, bg, c, marker_w)\n            out[top_r : top_r + marker_h, c] = marker[:, j]\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGEN_BG, GEN_OBSTACLE, GEN_PASS, GEN_STOP = 7, 5, 9, 1\nGRID_SIZE_RANGE = (14, 16)\nMARKER_SIZE = 3\nSTOP_COUNT_RANGE = (1, 3)\nOBSTACLE_COMPONENT_RANGE = (7, 9)\nOBSTACLE_PIXEL_RANGE = (20, 31)\nCOMPONENT_SIZE_RANGE = (1, 11)\nMIN_STOP_OBSTACLE_ROW = 6\nDROP_ZONE_HEIGHT = 3\nCOMPONENT_PLACEMENT_ATTEMPTS, GENERATION_ATTEMPTS = 100, 300\n\n\ndef _init_scene(H: int, W: int) -> tuple[np.ndarray, int, list[int], set[tuple[int, int]]]:\n    grid = np.full((H, W), GEN_BG, dtype=int)\n    c0 = random.randint(0, W - MARKER_SIZE)\n    num_stops = random.randint(*STOP_COUNT_RANGE)\n    positions = list(range(MARKER_SIZE))\n    random.shuffle(positions)\n    stop_positions = sorted(positions[:num_stops])\n    marker = np.full((MARKER_SIZE, MARKER_SIZE), GEN_PASS, dtype=int)\n    for j in stop_positions:\n        marker[MARKER_SIZE - 1, j] = GEN_STOP\n    grid[0:MARKER_SIZE, c0:c0 + MARKER_SIZE] = marker\n    obstacle_pixels: set[tuple[int, int]] = set()\n    for j in stop_positions:\n        col = c0 + j\n        first_obs_row = random.randint(MIN_STOP_OBSTACLE_ROW, H - 1)\n        grid[first_obs_row, col] = GEN_OBSTACLE\n        obstacle_pixels.add((first_obs_row, col))\n    return grid, c0, stop_positions, obstacle_pixels\n\n\ndef _forbidden_cells(H: int, c0: int, stop_positions: list[int], obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]]:\n    forbidden = {(r, c) for r in range(MARKER_SIZE) for c in range(c0, c0 + MARKER_SIZE)}\n    for j in stop_positions:\n        col = c0 + j\n        for r in range(MARKER_SIZE, H):\n            if (r, col) not in obstacle_pixels:\n                continue\n            for dr in range(1, DROP_ZONE_HEIGHT + 1):\n                if r - dr >= 0:\n                    forbidden.add((r - dr, col))\n            break\n    return forbidden\n\n\ndef _sample_component_sizes(total_pixels: int, component_count: int) -> list[int] | None:\n    component_sizes = []\n    left = total_pixels\n    min_size, max_size = COMPONENT_SIZE_RANGE\n    for i in range(component_count):\n        remaining = component_count - i - 1\n        if remaining == 0:\n            size = left\n        else:\n            lo = max(min_size, left - max_size * remaining)\n            hi = min(max_size, left - min_size * remaining)\n            if lo > hi:\n                return None\n            size = random.randint(lo, hi)\n        left -= size\n        if size < min_size or size > max_size:\n            return None\n        component_sizes.append(size)\n    random.shuffle(component_sizes)\n    return component_sizes\n\n\ndef _grow_component(grid: np.ndarray, comp_size: int, forbidden: set[tuple[int, int]],\n                    obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]] | None:\n    H, W = grid.shape\n    sr, sc = random.randint(0, H - 1), random.randint(0, W - 1)\n    if (sr, sc) in forbidden or (sr, sc) in obstacle_pixels or grid[sr, sc] != GEN_BG:\n        return None\n\n    comp = {(sr, sc)}\n    frontier = [(sr, sc)]\n    while len(comp) < comp_size and frontier:\n        random.shuffle(frontier)\n        expanded = False\n        for fr, fc in frontier:\n            nbrs = [(fr - 1, fc), (fr + 1, fc), (fr, fc - 1), (fr, fc + 1)]\n            random.shuffle(nbrs)\n            for nr, nc in nbrs:\n                if (0 <= nr < H and 0 <= nc < W\n                        and (nr, nc) not in forbidden\n                        and (nr, nc) not in obstacle_pixels\n                        and (nr, nc) not in comp\n                        and grid[nr, nc] == GEN_BG):\n                    comp.add((nr, nc))\n                    frontier.append((nr, nc))\n                    expanded = True\n                    break\n            if expanded:\n                break\n        if not expanded:\n            break\n    return comp if len(comp) == comp_size else None\n\n\ndef _place_obstacle_components(grid: np.ndarray, component_sizes: list[int], forbidden: set[tuple[int, int]],\n                               obstacle_pixels: set[tuple[int, int]]) -> bool:\n    for comp_size in component_sizes:\n        placed = False\n        for _ in range(COMPONENT_PLACEMENT_ATTEMPTS):\n            comp = _grow_component(grid, comp_size, forbidden, obstacle_pixels)\n            if comp is None:\n                continue\n            if any((pr + dr, pc + dc) in obstacle_pixels\n                   for pr, pc in comp for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]):\n                continue\n            for pr, pc in comp:\n                grid[pr, pc] = GEN_OBSTACLE\n                obstacle_pixels.add((pr, pc))\n            placed = True\n            break\n        if not placed:\n            return False\n    return True\n\n\ndef _scatter_obstacles(grid: np.ndarray, c0: int, stop_positions: list[int],\n                       obstacle_pixels: set[tuple[int, int]]) -> bool:\n    H, _W = grid.shape\n    num_target_components = random.randint(*OBSTACLE_COMPONENT_RANGE)\n    total_target_pixels = random.randint(*OBSTACLE_PIXEL_RANGE)\n    remaining_pixels = max(0, total_target_pixels - len(obstacle_pixels))\n    remaining_components = max(1, num_target_components - len(stop_positions))\n    if remaining_pixels <= 0 or remaining_components <= 0:\n        return True\n\n    component_sizes = _sample_component_sizes(remaining_pixels, remaining_components)\n    if component_sizes is None:\n        return False\n    forbidden = _forbidden_cells(H, c0, stop_positions, obstacle_pixels)\n    return _place_obstacle_components(grid, component_sizes, forbidden, obstacle_pixels)\n\n\ndef _has_clear_stop_drop_zones(grid: np.ndarray, c0: int, stop_positions: list[int]) -> bool:\n    H, _W = grid.shape\n    for j in stop_positions:\n        col = c0 + j\n        first_obs = next((r for r in range(MARKER_SIZE, H) if grid[r, col] == GEN_OBSTACLE), None)\n        if first_obs is None:\n            return False\n        for dr in range(1, DROP_ZONE_HEIGHT + 1):\n            if first_obs - dr < 0 or grid[first_obs - dr, col] != GEN_BG:\n                return False\n    return True\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = random.randint(*GRID_SIZE_RANGE)\n    W = random.randint(*GRID_SIZE_RANGE)\n    grid, c0, stop_positions, obstacle_pixels = _init_scene(H, W)\n\n    if not _scatter_obstacles(grid, c0, stop_positions, obstacle_pixels):\n        return None\n    if not _has_clear_stop_drop_zones(grid, c0, stop_positions):\n        return None\n    obs_comps = [c for c in find_components(grid, bg=GEN_BG, connectivity=4, monochromatic=True)\n                 if c['color'] == GEN_OBSTACLE]\n    if not (OBSTACLE_COMPONENT_RANGE[0] <= len(obs_comps) <= OBSTACLE_COMPONENT_RANGE[1]):\n        return None\n\n    # Run solver to verify no assertion failures\n    try:\n        main(grid)\n    except Exception:\n        return None\n\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/train/9841fdad.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def generate_input(/p'\"' /home/lixinyu/snap/new/ARC_code/train/9841fdad.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Expand the colored runs from the left reference panel into the blank right panel.\n\n    Input structure:\n    - A uniform rectangular frame surrounds the grid.\n    - One full-height divider of the frame color splits a left reference panel\n      from a blank right panel.\n    - Both panels have one background margin column on each side of their active\n      columns; the left active columns contain two-column endpoint slots, possibly\n      connected by same-color horizontal runs.\n\n    Rule:\n    - Keep the original grid and paint only in the right panel's active columns.\n    - A source run exactly matching the left endpoint slot is copied to the left\n      two columns of the right active span.\n    - A source run exactly matching the right endpoint slot is copied to the right\n      two columns of the right active span.\n    - A source run connecting the endpoint slots is stretched across the entire\n      right active span.\n\n    Key insight:\n    The left panel is a compressed legend for the right panel: endpoint markers\n    stay two pixels wide, while connectors between endpoints expand to fill the\n    distance between them.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    H, W = g.shape\n    assert H >= 3 and W >= 7, \"grid too small for framed two-panel structure\"\n\n    frame = int(g[0, 0])\n    assert np.all(g[0, :] == frame) and np.all(g[-1, :] == frame), \"bad horizontal frame\"\n    assert np.all(g[:, 0] == frame) and np.all(g[:, -1] == frame), \"bad vertical frame\"\n\n    divider = _single_divider_column(g, frame)\n    assert divider >= 5 and W - divider >= 6, \"panels must contain margins and active slots\"\n\n    left_panel = g[1 : H - 1, 1:divider]\n    left_bg = get_bg(left_panel)\n    assert np.all(left_panel[:, 0] == left_bg), \"left panel must have a left margin\"\n    assert np.all(left_panel[:, -1] == left_bg), \"left panel must have a right margin\"\n\n    mini_start = 2\n    mini_end = divider - 2\n    assert mini_end - mini_start + 1 >= 4, \"left active region must contain two endpoint slots\"\n    left_slot = (mini_start, mini_start + 1)\n    right_slot = (mini_end - 1, mini_end)\n\n    target_start = divider + 2\n    target_end = W - 3\n    assert target_end - target_start + 1 >= 4, \"right active region must contain endpoint slots\"\n    right_bg = int(g[1, divider + 1])\n    right_panel = g[1 : H - 1, divider + 1 : W - 1]\n    assert np.all(right_panel == right_bg), \"right panel must be blank before expansion\"\n\n    out = g.copy()\n    painted_any = False\n    for r in range(1, H - 1):\n        c = mini_start\n        while c <= mini_end:\n            color = int(g[r, c])\n            if color == left_bg:\n                c += 1\n                continue\n\n            c0 = c\n            while c <= mini_end and int(g[r, c]) == color:\n                c += 1\n            c1 = c - 1\n\n            in_left_slot = (c0, c1) == left_slot\n            in_right_slot = (c0, c1) == right_slot\n            if in_left_slot:\n                d0, d1 = target_start, target_start + 1\n            elif in_right_slot:\n                d0, d1 = target_end - 1, target_end\n            else:\n                assert c0 == left_slot[0] and c1 >= right_slot[0], \"run must connect endpoint slots\"\n                d0, d1 = target_start, target_end\n\n            assert np.all(out[r, d0 : d1 + 1] == right_bg), \"expanded runs must not collide\"\n            out[r, d0 : d1 + 1] = color\n            painted_any = True\n\n    assert painted_any, \"expected at least one colored source run\"\n    return out\n\n# --------------- generator (att2) ---------------\n# Color and retry controls.\nLEFT_BG = 1\nCOLOR_IDS = tuple(range(10))\nFRAME_COLORS = (0, 2, 3, 4, 5, 6, 7, 8, 9)\nMAX_RUN_COLORS = 4\nGENERATION_RETRIES = 300\n\n# Canvas, group, and row layout bounds.\nLEFT_ACTIVE_WIDTHS = range(4, 7)\nRIGHT_ACTIVE_WIDTHS = range(11, 14)\nTOTAL_HEIGHTS = (11, 15)\nRIGHT_TO_LEFT_MIN_RATIO = 2\nFIXED_WIDTH_CELLS = 7\nNON_GROUP_ROWS = 4\nGROUP_COUNTS = (3, 5)\nGROUP_HEIGHT_BOUNDS = (1, 2)\nGAP_BOUNDS = (1, 2)\nFIRST_ACTIVE_ROW = 2\n\n# Run pattern geometry.\nRUN_WIDTH = 2\nLEFT_ACTIVE_START = 2\nRIGHT_TARGET_OFFSET = 2\nBASE_PATTERNS = (\"LEFT\", \"RIGHT\", \"FULL\")\nDOUBLE_PATTERN = \"LEFT_RIGHT\"\n\ndef _gen_sequences_with_sum(length: int, lo: int, hi: int, total: int) -> list[tuple[int, ...]]:\n    if length == 0:\n        return [()] if total == 0 else []\n    if total < length * lo or total > length * hi:\n        return []\n    out = []\n    for value in range(lo, hi + 1):\n        for rest in _gen_sequences_with_sum(length - 1, lo, hi, total - value):\n            out.append((value,) + rest)\n    return out\n\n\ndef _gen_pattern_options(length: int, run_color_count: int, left_active_width: int) -> list[tuple[str, ...]]:\n    base = list(BASE_PATTERNS)\n    if run_color_count >= 2 and left_active_width >= RUN_WIDTH * 2 + 1:\n        base.append(DOUBLE_PATTERN)\n\n    options: list[tuple[str, ...]] = [()]\n    for _ in range(length):\n        options = [prefix + (pattern,) for prefix in options for pattern in base]\n\n    return [\n        patterns\n        for patterns in options\n        if sum(2 if pattern == DOUBLE_PATTERN else 1 for pattern in patterns) >= run_color_count\n        and any(pattern in (\"LEFT\", \"FULL\", DOUBLE_PATTERN) for pattern in patterns)\n        and any(pattern in (\"RIGHT\", \"FULL\", DOUBLE_PATTERN) for pattern in patterns)\n    ]\n\n\ndef _gen_take_color(rng: np.random.Generator, palette: np.ndarray, needed: list[int], exclude: int | None = None) -> int:\n    for i, color in enumerate(needed):\n        if color != exclude:\n            return needed.pop(i)\n    choices = [int(color) for color in palette if int(color) != exclude]\n    return int(rng.choice(choices))\n\n\ndef _gen_row_layout(rng: np.random.Generator, group_count: int, total_h: int):\n    row_total = total_h - NON_GROUP_ROWS\n    height_lo, height_hi = GROUP_HEIGHT_BOUNDS\n    gap_lo, gap_hi = GAP_BOUNDS\n    gap_count = group_count - 1\n    height_options = []\n    for height_sum in range(group_count * height_lo, group_count * height_hi + 1):\n        gap_total = row_total - height_sum\n        if gap_total < gap_count * gap_lo or gap_total > gap_count * gap_hi:\n            continue\n        height_seqs = _gen_sequences_with_sum(group_count, height_lo, height_hi, height_sum)\n        gap_seqs = _gen_sequences_with_sum(gap_count, gap_lo, gap_hi, gap_total)\n        height_options.extend((heights, gaps) for heights in height_seqs for gaps in gap_seqs)\n    if not height_options:\n        return None\n    return height_options[int(rng.integers(len(height_options)))]\n\n\ndef _gen_patterns_and_colors(rng, group_count: int, left_w: int, left_bg: int, right_bg: int):\n    max_segments = group_count * (2 if left_w >= RUN_WIDTH * 2 + 1 else 1)\n    run_color_count = int(rng.integers(1, min(MAX_RUN_COLORS, max_segments) + 1))\n    pattern_options = _gen_pattern_options(group_count, run_color_count, left_w)\n    if not pattern_options:\n        return None\n    patterns = pattern_options[int(rng.integers(len(pattern_options)))]\n\n    run_choices = [c for c in COLOR_IDS if c not in (left_bg, right_bg)]\n    run_colors = rng.choice(run_choices, size=run_color_count, replace=False)\n    needed_colors = [int(color) for color in run_colors]\n    rng.shuffle(needed_colors)\n\n    group_colors: list[tuple[int, ...]] = []\n    for pattern in patterns:\n        if pattern == DOUBLE_PATTERN:\n            left_color = _gen_take_color(rng, run_colors, needed_colors)\n            right_color = _gen_take_color(rng, run_colors, needed_colors, exclude=left_color)\n            group_colors.append((left_color, right_color))\n        else:\n            group_colors.append((_gen_take_color(rng, run_colors, needed_colors),))\n    return patterns, group_colors\n\n\ndef _render_grid(total_h: int, total_w: int, divider: int, left_w: int, colors, row_layout, pattern_data):\n    frame_color, left_bg, right_bg = colors\n    group_heights, group_gaps = row_layout\n    patterns, group_colors = pattern_data\n    out = np.full((total_h, total_w), right_bg, dtype=int)\n    out[:, 0] = frame_color\n    out[:, -1] = frame_color\n    out[0, :] = frame_color\n    out[-1, :] = frame_color\n    out[:, divider] = frame_color\n    out[1 : total_h - 1, 1:divider] = left_bg\n    out[1 : total_h - 1, divider + 1 : total_w - 1] = right_bg\n    left_start = LEFT_ACTIVE_START\n    left_end = left_start + left_w - 1\n    left_slot = slice(left_start, left_start + RUN_WIDTH)\n    right_slot = slice(left_end - RUN_WIDTH + 1, left_end + 1)\n    target_start = divider + RIGHT_TARGET_OFFSET\n    target_end = total_w - 3\n\n    row = FIRST_ACTIVE_ROW\n    for idx, (pattern, colors) in enumerate(zip(patterns, group_colors)):\n        for r in range(row, row + group_heights[idx]):\n            if pattern == \"LEFT\":\n                out[r, left_slot] = colors[0]\n                out[r, target_start : target_start + RUN_WIDTH] = colors[0]\n            elif pattern == \"RIGHT\":\n                out[r, right_slot] = colors[0]\n                out[r, target_end - RUN_WIDTH + 1 : target_end + 1] = colors[0]\n            elif pattern == \"FULL\":\n                out[r, left_start : left_end + 1] = colors[0]\n                out[r, target_start : target_end + 1] = colors[0]\n            else:\n                out[r, left_slot] = colors[0]\n                out[r, right_slot] = colors[1]\n                out[r, target_start : target_start + RUN_WIDTH] = colors[0]\n                out[r, target_end - RUN_WIDTH + 1 : target_end + 1] = colors[1]\n        row += group_heights[idx]\n        if idx < len(group_gaps):\n            row += group_gaps[idx]\n    return out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n\n    frame_color = int(rng.choice(FRAME_COLORS))\n    right_bg = int(rng.choice([c for c in COLOR_IDS if c not in (LEFT_BG, frame_color)]))\n    colors = (frame_color, LEFT_BG, right_bg)\n    width_pairs = [\n        (wl, wr)\n        for wl in LEFT_ACTIVE_WIDTHS\n        for wr in RIGHT_ACTIVE_WIDTHS\n        if wr >= RIGHT_TO_LEFT_MIN_RATIO * wl\n    ]\n    left_w, right_w = width_pairs[int(rng.integers(len(width_pairs)))]\n    total_w = left_w + right_w + FIXED_WIDTH_CELLS\n    divider = left_w + 3\n    group_count = int(rng.integers(*GROUP_COUNTS))\n    total_h = int(rng.integers(*TOTAL_HEIGHTS))\n\n    row_layout = _gen_row_layout(rng, group_count, total_h)\n    pattern_data = _gen_patterns_and_colors(rng, group_count, left_w, LEFT_BG, right_bg)\n    if row_layout is None or pattern_data is None:\n        return None\n\n    out = _render_grid(total_h, total_w, divider, left_w, colors, row_layout, pattern_data)\n    inp = out.copy()\n    inp[1 : total_h - 1, divider + 1 : total_w - 1] = right_bg\n    try:\n        if not np.array_equal(main(inp), out):\n            return None\n    except Exception:\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
