{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/db7260a4.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import colors_present, find_components, get_bg, paste\n\n\ndef _closed_u_containers(g: np.ndarray, wall_color: int, bg: int) -> list[tuple[int, int, int, int]]:\n    h, w = g.shape\n    containers = []\n\n    for bottom in range(1, h):\n        for left in range(w - 2):\n            if int(g[bottom, left]) != wall_color:\n                continue\n            for right in range(left + 2, w):\n                if int(g[bottom, right]) != wall_color:\n                    continue\n                if not np.all(g[bottom, left : right + 1] == wall_color):\n                    continue\n\n                top = bottom\n                while top > 0 and int(g[top - 1, left]) == wall_color and int(g[top - 1, right]) == wall_color:\n                    top -= 1\n                if top == bottom:\n                    continue\n\n                interior = g[top:bottom, left + 1 : right]\n                if interior.size == 0 or not np.all(interior == bg):\n                    continue\n                containers.append((top, bottom, left, right))\n\n    return containers\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the singleton marker into the matching red U-shaped container, or make a bottom-row puddle if no closed container is hit.\n\n    Input structure\n    - The grid has a dominant background, one singleton marker pixel on the top row,\n      and one other foreground color forming vertical bars and bottom segments.\n    - A closed container is a U shape: two vertical side bars with a continuous\n      bottom segment between them and an empty rectangular interior above the bottom.\n\n    Rule\n    - Remove the top marker from its original cell.\n    - If exactly one closed U-shaped container has the marker column within its\n      horizontal footprint, fill that container's empty interior with the marker color.\n    - If no closed container is under the marker column, fill the whole bottom row\n      with the marker color.\n\n    Key insight\n    - The marker does not identify a color by value; it identifies a vertical drop\n      column, and only a structurally closed U shape can catch and contain the fill.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    foreground_colors = colors_present(g, exclude={bg})\n    assert len(foreground_colors) == 2, \"expected marker and wall colors\"\n\n    singleton_colors = [color for color in foreground_colors if int(np.count_nonzero(g == color)) == 1]\n    assert len(singleton_colors) == 1, \"expected exactly one singleton marker color\"\n    marker_color = singleton_colors[0]\n\n    wall_colors = [color for color in foreground_colors if color != marker_color]\n    assert len(wall_colors) == 1\n    wall_color = wall_colors[0]\n\n    marker_coords = np.argwhere(g == marker_color)\n    assert marker_coords.shape == (1, 2)\n    marker_r, marker_c = map(int, marker_coords[0])\n    assert marker_r == 0, \"marker must sit on the top row\"\n\n    containers = [\n        container\n        for container in _closed_u_containers(g, wall_color, bg)\n        if container[0] > marker_r and container[2] <= marker_c <= container[3]\n    ]\n    assert len(containers) <= 1, \"marker column must select at most one closed container\"\n\n    out = g.copy()\n    out[marker_r, marker_c] = bg\n    if containers:\n        top, bottom, left, right = containers[0]\n        out[top:bottom, left + 1 : right] = marker_color\n    else:\n        assert np.all(out[-1, :] == bg), \"missed marker should fall to an empty bottom row\"\n        out[-1, :] = marker_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Fixed ARC colors and canvas.\n_GEN_BG = 0\n_GEN_MARKER = 1\n_GEN_WALL = 2\n_GEN_H = 10\n_GEN_W = 10\n\n# Vertical layout bounds; row 9 stays empty in generated inputs.\n_GEN_MARKER_ROW = 0\n_GEN_MIN_WALL_ROW = 2\n_GEN_LAST_WALL_ROW = 8\n\n# Closed container interior size ranges, with exclusive upper bounds.\n_GEN_INTERIOR_H_RANGE = (2, 4)\n_GEN_INTERIOR_W_RANGE = (1, 6)\n\n# Broken distractor patch size ranges, with exclusive upper bounds.\n_GEN_DISTRACTOR_H_RANGE = (2, 4)\n_GEN_DISTRACTOR_W_RANGE = (4, 7)\n\n# Scenario mix and distractor count ranges, with exclusive upper bounds.\n_GEN_FILL_CONTAINER_PROB = 0.67\n_GEN_MISSED_HAS_U_PROB = 0.55\n_GEN_DISTRACTORS_WITH_U_RANGE = (0, 2)\n_GEN_DISTRACTORS_WITHOUT_U_RANGE = (1, 4)\n\n# Rejection-sampling retry budget.\n_GEN_MAX_ATTEMPTS = 300\n\n\ndef _gen_u_patch(interior_h: int, interior_w: int) -> np.ndarray:\n    patch = np.full((interior_h + 1, interior_w + 2), _GEN_BG, dtype=int)\n    patch[:, 0] = _GEN_WALL\n    patch[:, -1] = _GEN_WALL\n    patch[-1, :] = _GEN_WALL\n    return patch\n\n\ndef _gen_sample_u() -> tuple[int, int, int, int, int, int]:\n    interior_h = int(np.random.randint(*_GEN_INTERIOR_H_RANGE))\n    interior_w = int(np.random.randint(*_GEN_INTERIOR_W_RANGE))\n    top = int(np.random.randint(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - interior_h + 1))\n    bottom = top + interior_h\n    left = int(np.random.randint(0, _GEN_W - interior_w - 1))\n    right = left + interior_w + 1\n    return top, bottom, left, right, interior_h, interior_w\n\n\ndef _gen_broken_u_patch(height: int, width: int, *, gap: int | None = None, missing_side: str | None = None) -> np.ndarray:\n    patch = np.full((height, width), _GEN_BG, dtype=int)\n    if missing_side != \"left\":\n        patch[:, 0] = _GEN_WALL\n    if missing_side != \"right\":\n        patch[:, -1] = _GEN_WALL\n    patch[-1, :] = _GEN_WALL\n    if gap is not None:\n        patch[-1, gap] = _GEN_BG\n    return patch\n\n\ndef _gen_distractor_patches() -> list[np.ndarray]:\n    patches: list[np.ndarray] = []\n\n    for h in range(*_GEN_DISTRACTOR_H_RANGE):\n        for w in range(*_GEN_DISTRACTOR_W_RANGE):\n            gap = int(np.random.randint(1, w - 1))\n            patches.append(_gen_broken_u_patch(h, w, gap=gap))\n            patches.append(_gen_broken_u_patch(h, w, missing_side=\"left\"))\n            patches.append(_gen_broken_u_patch(h, w, missing_side=\"right\"))\n\n    return patches\n\n\ndef _gen_valid_positions(grid: np.ndarray, patch: np.ndarray) -> list[tuple[int, int]]:\n    ph, pw = patch.shape\n    local = np.argwhere(patch == _GEN_WALL)\n    local_set = {(int(r), int(c)) for r, c in local}\n    touch_local = {\n        (r + dr, c + dc)\n        for r, c in local_set\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1))\n        if (r + dr, c + dc) not in local_set\n    }\n    positions: list[tuple[int, int]] = []\n\n    for r0 in range(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - ph + 2):\n        for c0 in range(0, _GEN_W - pw + 1):\n            if np.any(grid[r0 + local[:, 0], c0 + local[:, 1]] != _GEN_BG):\n                continue\n            touches = any(\n                0 <= r0 + r < _GEN_H\n                and 0 <= c0 + c < _GEN_W\n                and grid[r0 + r, c0 + c] == _GEN_WALL\n                for r, c in touch_local\n            )\n            if not touches:\n                positions.append((r0, c0))\n\n    return positions\n\n\ndef _gen_place_distractors(grid: np.ndarray, count: int) -> bool:\n    patches = _gen_distractor_patches()\n    for _ in range(count):\n        placed = False\n        for idx in np.random.permutation(len(patches)):\n            patch = patches[int(idx)]\n            positions = _gen_valid_positions(grid, patch)\n            if not positions:\n                continue\n            r0, c0 = positions[int(np.random.randint(0, len(positions)))]\n            paste(grid, patch, r0, c0, transparent=_GEN_BG)\n            placed = True\n            break\n        if not placed:\n            return False\n    return True\n\n\n_GenUBox = tuple[int, int, int, int]\n\n\ndef _gen_design_expected() -> tuple[np.ndarray, bool, _GenUBox | None, int, int]:\n    \"\"\"Build the expected output and return metadata needed to derive the input.\"\"\"\n    expected = np.full((_GEN_H, _GEN_W), _GEN_BG, dtype=int)\n    fill_container = bool(np.random.random() < _GEN_FILL_CONTAINER_PROB)\n    has_u = fill_container or bool(np.random.random() < _GEN_MISSED_HAS_U_PROB)\n    u_box = None\n\n    if has_u:\n        top, bottom, left, right, interior_h, interior_w = _gen_sample_u()\n        paste(expected, _gen_u_patch(interior_h, interior_w), top, left, transparent=_GEN_BG)\n        u_box = (top, bottom, left, right)\n        if fill_container:\n            marker_c = int(np.random.randint(left + 1, right))\n            expected[top:bottom, left + 1 : right] = _GEN_MARKER\n        else:\n            outside = [c for c in range(_GEN_W) if not (left <= c <= right)]\n            marker_c = int(outside[int(np.random.randint(0, len(outside)))])\n            expected[-1, :] = _GEN_MARKER\n        distractor_count = int(np.random.randint(*_GEN_DISTRACTORS_WITH_U_RANGE))\n    else:\n        marker_c = int(np.random.randint(0, _GEN_W))\n        expected[-1, :] = _GEN_MARKER\n        distractor_count = int(np.random.randint(*_GEN_DISTRACTORS_WITHOUT_U_RANGE))\n\n    return expected, fill_container, u_box, marker_c, distractor_count\n\n\ndef _gen_input_from_expected(expected: np.ndarray, fill_container: bool, u_box: _GenUBox | None, marker_c: int) -> np.ndarray:\n    inp = expected.copy()\n    if fill_container:\n        assert u_box is not None\n        top, bottom, left, right = u_box\n        inp[top:bottom, left + 1 : right] = _GEN_BG\n    else:\n        inp[-1, :] = _GEN_BG\n    inp[_GEN_MARKER_ROW, marker_c] = _GEN_MARKER\n    return inp\n\n\ndef _gen_valid_pair(inp: np.ndarray, expected: np.ndarray, fill_container: bool, u_box: _GenUBox | None, marker_c: int) -> bool:\n    \"\"\"Check structural invariants and the solver oracle.\"\"\"\n    if np.count_nonzero(inp == _GEN_MARKER) != 1 or inp[_GEN_MARKER_ROW, marker_c] != _GEN_MARKER:\n        return False\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/16de56c4.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import defaultdict\nimport numpy as np\nfrom arc_utils import get_bg\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill periodic progressions that shoot from a unique grid edge.\n\n    Input structure:\n    - bg = most common color.  Sparse non-bg dots of several colors.\n    - All repeating colors originate from the same grid edge (top, bottom,\n      left, or right — the one with the most non-bg dots).\n    - Each repeating color has exactly 2 dots per shooting-direction line;\n      their gap defines the step.\n    - Every non-bg dot lies on a shooting-direction line that contains a\n      repeating color.\n\n    Rule:\n    - Determine the unique shooting edge; left/right → rows, top/bottom → columns.\n    - For each shooting-direction line, the repeating color has exactly 2 dots;\n      step = gap between them, offset = first position mod step.\n    - A different-colored dot aligned to the same beat (pos % step == offset) is\n      a companion: it absorbs the ray and becomes the fill color, limiting the\n      fill range to the span between repeating and companion dots.\n    - An unaligned dot is a bystander and left untouched.\n    - Without a companion the repeating color fills the entire line.\n\n    Key insight: the shooting edge is identified by counting boundary dots;\n    the gap between the two marker dots is the period; a companion sharing the\n    modular class acts as a wall that stops the ray and dictates the paint color.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    out = g.copy()\n    bg = int(get_bg(g))\n    H, W = g.shape\n\n    # --- Step 1: determine the unique shooting edge ---\n    edge_counts = {\n        'top':    sum(1 for c in range(W) if g[0, c] != bg),\n        'bottom': sum(1 for c in range(W) if g[H - 1, c] != bg),\n        'left':   sum(1 for r in range(H) if g[r, 0] != bg),\n        'right':  sum(1 for r in range(H) if g[r, W - 1] != bg),\n    }\n    max_count = max(edge_counts.values())\n    assert max_count > 0, \"No non-bg dots on any edge\"\n    winners = [e for e, c in edge_counts.items() if c == max_count]\n    assert len(winners) == 1, f\"Ambiguous shooting edge: {winners} (counts={edge_counts})\"\n    edge = winners[0]\n\n    by_row = edge in ('left', 'right')\n    num_lines = H if by_row else W\n    line_len = W if by_row else H\n\n    def cell(line: int, pos: int) -> tuple[int, int]:\n        return (line, pos) if by_row else (pos, line)\n\n    # --- Step 2: process each shooting-direction line ---\n    for li in range(num_lines):\n        colors: dict[int, list[int]] = defaultdict(list)\n        for p in range(line_len):\n            v = int(g[cell(li, p)])\n            if v != bg:\n                colors[v].append(p)\n\n        if not colors:\n            continue\n\n        repeating = {c: ps for c, ps in colors.items() if len(ps) >= 2}\n        assert repeating, (\n            f\"Line {li} ({'row' if by_row else 'col'}) has non-bg dots \"\n            f\"{dict(colors)} but no repeating color\"\n        )\n\n        for marker, mpos in repeating.items():\n            assert len(mpos) == 2, (\n                f\"Line {li} ({'row' if by_row else 'col'}) marker {marker} \"\n                f\"has {len(mpos)} dots (expected 2): {mpos}\"\n            )\n            a, b = sorted(mpos)\n            step = b - a\n            offset = a % step\n\n            companion = None\n            for oc, ops in colors.items():\n                if oc == marker:\n                    continue\n                if any(p % step == offset for p in ops):\n                    companion = oc\n                    break\n\n            if companion is not None:\n                paint = companion\n                all_ps = mpos + colors[companion]\n                lo, hi = min(all_ps), max(all_ps)\n            else:\n                paint = marker\n                lo, hi = 0, line_len - 1\n\n            for p in range(lo, hi + 1):\n                if p % step != offset:\n                    continue\n                rc = cell(li, p)\n                cur = int(out[rc])\n                if cur == bg or cur == marker:\n                    out[rc] = paint\n\n    return out\n\n# --------------- generator (claude-opus-attempt1) ---------------\n\n# --- Configuration ---\n_ROWS_RANGE = (7, 12)\n_COLS_RANGE = (9, 21)\n_ACTIVE_LINES_RANGE = (4, 9)       # number of non-empty shooting lines\n_STEP_RANGE = (1, 5)               # marker dot spacing\n_COLORS = list(range(1, 10))       # non-bg palette\n_EDGES = ('top', 'bottom', 'left', 'right')\n\n# Line type probabilities: marker-only / companion / bystander\n_P_MARKER_ONLY = 0.40\n_P_COMPANION = 0.35                # cumulative threshold = 0.75\n\n_MAX_RETRIES = 300\n\n\ndef _choose_dims(edge: str, n_active: int):\n    \"\"\"Pick (H, W, num_lines, line_len) compatible with edge and active count.\n\n    Returns None if the active count cannot fit the dimension range.\n    \"\"\"\n    min_num_lines = 2 * n_active - 1  # minimum to fit n_active lines with gap >= 1\n    by_row = edge in ('left', 'right')\n    if by_row:\n        lo = max(_ROWS_RANGE[0], min_num_lines)\n        if lo > _ROWS_RANGE[1]:\n            return None\n        H = random.randint(lo, _ROWS_RANGE[1])\n        W = random.randint(*_COLS_RANGE)\n        return H, W, H, W\n    else:\n        lo = max(_COLS_RANGE[0], min_num_lines)\n        if lo > _COLS_RANGE[1]:\n            return None\n        W = random.randint(lo, _COLS_RANGE[1])\n        H = random.randint(*_ROWS_RANGE)\n        return H, W, W, H\n\n\ndef _spaced_indices(n: int, total: int) -> list[int]:\n    \"\"\"Choose *n* indices from [0, total) with gaps >= 1 between consecutive ones.\"\"\"\n    available = total - (n - 1)\n    if available < n:\n        return []\n    picks = sorted(random.sample(range(available), n))\n    return [picks[i] + i for i in range(n)]\n\n\ndef _build_line_dots(edge: str, line_len: int, marker_color: int, step: int):\n    \"\"\"Build the dot positions for one active line.\n\n    Returns (dot_list, edge_pos) where each dot is (pos, color).\n    \"\"\"\n    if edge in ('left', 'top'):\n        edge_pos, inner_pos = 0, step\n    else:\n        edge_pos, inner_pos = line_len - 1, line_len - 1 - step\n    offset = edge_pos % step\n\n    dots = [(edge_pos, marker_color), (inner_pos, marker_color)]\n\n    roll = random.random()\n    if roll < _P_MARKER_ONLY:\n        pass  # marker only\n    elif roll < _P_MARKER_ONLY + _P_COMPANION:\n        # Companion: aligned to beat, beyond inner marker\n        other_colors = [c for c in _COLORS if c != marker_color]\n        if edge in ('left', 'top'):\n            beats = list(range(inner_pos + step, line_len, step))\n        else:\n            beats = list(range(inner_pos - step, -1, -step))\n        if other_colors and beats:\n            dots.append((random.choice(beats), random.choice(other_colors)))\n    else:\n        # Bystander: NOT aligned to beat\n        other_colors = [c for c in _COLORS if c != marker_color]\n        non_beat = [p for p in range(line_len)\n                    if p % step != offset and p not in (edge_pos, inner_pos)]\n        if other_colors and non_beat:\n            dots.append((random.choice(non_beat), random.choice(other_colors)))\n\n    return dots, edge_pos\n\n\ndef _count_other_edge_dots(dots_rc: list[tuple[int, int]], edge: str,\n                           H: int, W: int) -> dict[str, int]:\n    \"\"\"Count how many placed dots land on each non-shooting edge.\"\"\"\n    boundary = {\n        'top': lambda r, c: r == 0,\n        'bottom': lambda r, c: r == H - 1,\n        'left': lambda r, c: c == 0,\n        'right': lambda r, c: c == W - 1,\n    }\n    counts = {}\n    for oe in _EDGES:\n        if oe == edge:\n            continue\n        check = boundary[oe]\n        counts[oe] = sum(1 for r, c in dots_rc if check(r, c))\n    return counts\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid input.\"\"\"\n    n_active = random.randint(*_ACTIVE_LINES_RANGE)\n    edge = random.choice(_EDGES)\n    by_row = edge in ('left', 'right')\n\n    dims = _choose_dims(edge, n_active)\n    if dims is None:\n        return None\n    H, W, num_lines, line_len = dims\n\n    active_lines = _spaced_indices(n_active, num_lines)\n    if not active_lines:\n        return None\n\n    def cell(line: int, pos: int) -> tuple[int, int]:\n        return (line, pos) if by_row else (pos, line)\n\n    inp = np.zeros((H, W), dtype=int)\n    shooting_edge_dots = 0\n    all_rc = []  # (r, c) of every placed dot\n\n    for li in active_lines:\n        marker_color = random.choice(_COLORS)\n        step = random.randint(*_STEP_RANGE)\n        step = min(step, line_len - 1)\n\n        dots, edge_pos = _build_line_dots(edge, line_len, marker_color, step)\n\n        for pos, color in dots:\n            r, c = cell(li, pos)\n            inp[r, c] = color\n            all_rc.append((r, c))\n\n        shooting_edge_dots += 1  # marker always has one dot on the shooting edge\n\n    # Verify shooting edge is unambiguous\n    other_counts = _count_other_edge_dots(all_rc, edge, H, W)\n    if any(cnt >= shooting_edge_dots for cnt in other_counts.values()):\n        return None\n\n    # Validate with solver\n    try:\n        out = main(inp)\n    except Exception:\n        return None\n","exit_code":0,"status":"completed"}}
