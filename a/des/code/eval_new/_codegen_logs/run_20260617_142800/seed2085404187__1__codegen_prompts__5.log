{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main'\"\\\\|\"'^def generate_input'\"\\\\|\"'^    '\"\\\\\\\"\\\\\\\"\\\\\\\"/,+180p' /home/lixinyu/snap/new/ARC_code/eval/fc7cae8d.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Align a central rectangle to two colored frame-edge controls via rotation/reflection.\n\n    Input structure:\n    - bg grid with two solid-colored border edges (distinct non-bg colors).\n    - A central filled rectangle with 1px colored guide edges on two sides, colors matching the frame controls.\n\n    Rule:\n    - Rotate/mirror the object so its guide edges face the same sides as the matching frame controls.\n    - Crop off the 1px guide edges from aligned sides.\n\n    Key insight: Guide-edge colors encode target frame sides; the correct dihedral transform matches both simultaneously.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    def detect_controls_frame(arr: np.ndarray) -> list[tuple[str, int]]:\n        H, W = arr.shape\n        sides = {\n            \"top\": arr[0, 1:-1],\n            \"bottom\": arr[-1, 1:-1],\n            \"left\": arr[1:-1, 0],\n            \"right\": arr[1:-1, -1],\n        }\n        cand: list[tuple[str, int, int, int]] = []\n        for side, v in sides.items():\n            v = list(map(int, v))\n            v_nb = [x for x in v if x != int(bg)]\n            if not v_nb:\n                continue\n            col, count = Counter(v_nb).most_common(1)[0]\n            # allow up to 1 mismatch (overlap near corners with the other control color)\n            if int(count) >= len(v) - 1:\n                cand.append((side, int(col), int(count), int(len(v))))\n        cand.sort(key=lambda t: (t[2] / t[3], t[2]), reverse=True)\n        return [(s, c) for s, c, _cnt, _L in cand[:2]]\n\n    def extract_center_object(arr: np.ndarray) -> np.ndarray:\n        H, W = arr.shape\n        comps = find_components(arr, bg=int(bg), connectivity=4, monochromatic=False, return_format=\"dict\")\n        best = None  # (area, bbox)\n        for comp in comps:\n            r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n            if bool(r0 == 0 or c0 == 0 or r1 == H - 1 or c1 == W - 1):\n                continue\n            area = int(comp[\"area\"])\n            if best is None or area > best[0]:\n                best = (area, (r0, c0, r1, c1))\n        if best is None:\n            return arr.copy()\n        _area, b = best\n        return crop_bbox(arr, b)\n\n    def guide_edges(arr: np.ndarray) -> dict[str, int]:\n        fill = int(Counter(map(int, arr.flatten())).most_common(1)[0][0])\n        edges = {\n            \"top\": arr[0, :],\n            \"bottom\": arr[-1, :],\n            \"left\": arr[:, 0],\n            \"right\": arr[:, -1],\n        }\n        out: dict[str, int] = {}\n        for side, v in edges.items():\n            v = list(map(int, v))\n            v_nf = [x for x in v if x != int(fill)]\n            if not v_nf:\n                continue\n            col, count = Counter(v_nf).most_common(1)[0]\n            if int(count) >= len(v) - 1:\n                out[side] = int(col)\n        return out\n\n    ctrls = detect_controls_frame(g)\n    desired = {side: col for side, col in ctrls}\n    obj = extract_center_object(g)\n\n    # Try all dihedral transforms: rotations + optional horizontal flip.\n    for k in range(4):\n        base = np.rot90(obj, int(k))\n        for flip in [False, True]:\n            t = np.fliplr(base) if flip else base\n            gedges = guide_edges(t)\n            if all(side in gedges and int(gedges[side]) == int(col) for side, col in desired.items()):\n                top = 1 if \"top\" in desired else 0\n                bottom = int(t.shape[0]) - (1 if \"bottom\" in desired else 0)\n                left = 1 if \"left\" in desired else 0\n                right = int(t.shape[1]) - (1 if \"right\" in desired else 0)\n                return t[int(top) : int(bottom), int(left) : int(right)]\n\n    # Fallback: should not happen on this puzzle.\n    return obj\n\n# --------------- generator (Codex#2) ---------------\n\ndef _transform(arr: np.ndarray, k: int, flip: bool) -> np.ndarray:\n    out = np.rot90(arr, int(k))\n    return np.fliplr(out) if flip else out\n\n\ndef _inverse_transform(arr: np.ndarray, k: int, flip: bool) -> np.ndarray:\n    out = np.fliplr(arr) if flip else arr\n    return np.rot90(out, -int(k))\n\n\ndef _build_core(h: int, w: int, fill: int, pattern_colors: list[int]) -> np.ndarray:\n    core = np.full((h, w), int(fill), dtype=int)\n    area = h * w\n    max_nonfill = max(len(pattern_colors), int(area * 0.35))\n    target_nonfill = random.randint(max(len(pattern_colors), area // 10), max_nonfill)\n    painted = 0\n\n    for color in pattern_colors:\n        r = random.randrange(h)\n        c = random.randrange(w)\n        core[r, c] = int(color)\n        painted += 1\n\n    while painted < target_nonfill:\n        color = random.choice(pattern_colors)\n        shape_kind = random.choice([\"dot\", \"line\", \"rect\"])\n        if shape_kind == \"dot\":\n            cells = [(random.randrange(h), random.randrange(w))]\n        elif shape_kind == \"line\":\n            line_len = random.randint(2, min(5, max(h, w)))\n            if random.random() < 0.5:\n                rr = random.randrange(h)\n                c0 = random.randrange(max(1, w - line_len + 1))\n                cells = [(rr, c0 + dc) for dc in range(line_len)]\n            else:\n                r0 = random.randrange(max(1, h - line_len + 1))\n                cc = random.randrange(w)\n                cells = [(r0 + dr, cc) for dr in range(line_len)]\n        else:\n            mh = random.randint(1, min(3, h))\n            mw = random.randint(1, min(3, w))\n            r0 = random.randrange(h - mh + 1)\n            c0 = random.randrange(w - mw + 1)\n            cells = [(r0 + dr, c0 + dc) for dr in range(mh) for dc in range(mw)]\n\n        remaining = target_nonfill - painted\n        if remaining <= 0:\n            break\n        fill_cells = [(r, c) for r, c in cells if core[r, c] == fill]\n        if len(fill_cells) > remaining:\n            fill_cells = random.sample(fill_cells, remaining)\n        for r, c in fill_cells:\n            core[r, c] = int(color)\n        painted += len(fill_cells)\n        for r, c in cells:\n            if core[r, c] != fill:\n                continue\n            if painted >= target_nonfill:\n                break\n            core[r, c] = int(color)\n            painted += 1\n\n    return core\n\n\ndef _attach_guides(core: np.ndarray, guide_sides: tuple[str, str], guide_colors: dict[str, int]) -> np.ndarray:\n    h, w = core.shape\n    has_top = \"top\" in guide_sides\n    has_bottom = \"bottom\" in guide_sides\n    has_left = \"left\" in guide_sides\n    has_right = \"right\" in guide_sides\n    out = np.zeros((h + has_top + has_bottom, w + has_left + has_right), dtype=int)\n    r0 = 1 if has_top else 0\n    c0 = 1 if has_left else 0\n    paste(out, core, r0, c0)\n\n    if has_top:\n        out[0, c0 : c0 + w] = int(guide_colors[\"top\"])\n    if has_bottom:\n        out[-1, c0 : c0 + w] = int(guide_colors[\"bottom\"])\n    if has_left:\n        out[r0 : r0 + h, 0] = int(guide_colors[\"left\"])\n    if has_right:\n        out[r0 : r0 + h, -1] = int(guide_colors[\"right\"])\n\n    if has_top and has_left:\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate input for fc7cae8d\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main'\"\\\\|\"'^def generate_input'\"\\\\|\"'^    '\"\\\\\\\"\\\\\\\"\\\\\\\"/,+180p' /home/lixinyu/snap/new/ARC_code/train/f8cc533f.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main'\"\\\\|\"'^def generate_input'\"\\\\|\"'^    '\"\\\\\\\"\\\\\\\"\\\\\\\"/,+180p' /home/lixinyu/snap/new/ARC_code/train/f8cc533f.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete every colored sprite by applying the union of all aligned partial sprite masks.\n\n    Input structure:\n    - The dominant color is the background.\n    - Each non-background color appears as a separated partial copy of one common sprite mask.\n    - The copies share a top-left-aligned sprite window; some copies may be missing lower or right edge pixels.\n\n    Rule:\n    - Crop each same-color mask to its bounding box.\n    - Pad the crops to the maximum observed height and width, aligned at the top-left, and OR them into one complete template.\n    - Fill that template at every sprite location using the sprite's own color.\n\n    Key insight:\n    - No single input sprite is complete, but their missing cells are complementary, so the aligned union reveals the full mask.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) >= 2, \"expected multiple partial sprite copies\"\n\n    sprites: list[tuple[int, int, int, np.ndarray]] = []\n    for color in colors:\n        mask = g == color\n        box = bbox(mask)\n        assert box is not None, \"each foreground color must be present\"\n        r0, c0, r1, c1 = box\n        local = mask[r0 : r1 + 1, c0 : c1 + 1]\n        assert np.any(local), \"expected a nonempty sprite mask\"\n        sprites.append((int(color), int(r0), int(c0), local))\n\n    template_h = max(local.shape[0] for _, _, _, local in sprites)\n    template_w = max(local.shape[1] for _, _, _, local in sprites)\n    assert template_h > 0 and template_w > 0\n\n    template = np.zeros((template_h, template_w), dtype=bool)\n    for _, _, _, local in sprites:\n        local_h, local_w = map(int, local.shape)\n        template[:local_h, :local_w] |= local\n    assert np.any(template), \"expected a nonempty recovered sprite template\"\n\n    out = g.copy()\n    for color, r0, c0, _ in sprites:\n        r1 = r0 + template_h\n        c1 = c0 + template_w\n        assert r1 <= height and c1 <= width, \"sprite window must fit in the grid\"\n        region = out[r0:r1, c0:c1]\n        assert np.all((region == bg) | (region == color)), \"sprite windows must not overlap other colors\"\n        region[template] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas and palette bounds.\nGRID_HEIGHT_RANGE = (11, 22)\nGRID_WIDTH_RANGE = (18, 22)\nPALETTE_SIZE = 10\n\n# Template geometry and growth.\nTEMPLATE_SIDE_RANGE = (5, 7)\nTEMPLATE_FILL_FRACTION_RANGE = (0.48, 0.84)\nTEMPLATE_STOP_PROBABILITY = 0.35\nPATH_VERTICAL_FIRST_PROBABILITY = 0.5\nORTHOGONAL_STEPS = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n# Sprite layout constraints.\nSPRITE_COUNT_RANGE = (2, 4)\nWINDOW_GAP = 1\n\n# Per-sprite damage limits.\nDAMAGE_FRACTION_RANGE = (0.07, 0.33)\nDAMAGE_MISSING_PIXEL_RANGE = (1, 6)\n\n# Rejection sampling limit.\nGENERATION_RETRY_LIMIT = 300\n\n\ndef _gen_path(mask: np.ndarray, a: tuple[int, int], b: tuple[int, int]) -> None:\n    r, c = a\n    tr, tc = b\n    if random.random() < PATH_VERTICAL_FIRST_PROBABILITY:\n        while r != tr:\n            mask[r, c] = True\n            r += 1 if tr > r else -1\n        while c != tc:\n            mask[r, c] = True\n            c += 1 if tc > c else -1\n    else:\n        while c != tc:\n            mask[r, c] = True\n            c += 1 if tc > c else -1\n        while r != tr:\n            mask[r, c] = True\n            r += 1 if tr > r else -1\n    mask[tr, tc] = True\n\n\ndef _gen_orbit(side: int, r: int, c: int) -> set[tuple[int, int]]:\n    last = side - 1\n    return {\n        (r, c),\n        (c, r),\n        (last - r, c),\n        (r, last - c),\n        (last - r, last - c),\n        (last - c, last - r),\n        (c, last - r),\n        (last - c, r),\n    }\n\n\ndef _gen_add_orbit(mask: np.ndarray, r: int, c: int) -> None:\n    for rr, cc in _gen_orbit(mask.shape[0], r, c):\n        mask[rr, cc] = True\n\n\ndef _gen_template(side: int) -> np.ndarray | None:\n    min_fill, max_fill = TEMPLATE_FILL_FRACTION_RANGE\n    min_area = int(np.ceil(min_fill * side * side))\n    max_area = int(np.floor(max_fill * side * side))\n    target = random.randint(min_area, max_area)\n\n    mask = np.zeros((side, side), dtype=bool)\n    center = side // 2\n    top_c = random.randrange(side)\n    _gen_path(mask, (center, center), (0, top_c))\n    for r, c in list(map(tuple, np.argwhere(mask))):\n        _gen_add_orbit(mask, int(r), int(c))\n\n    if int(mask.sum()) > max_area:\n        return None\n    target = max(target, int(mask.sum()))\n\n    while int(mask.sum()) < target:\n        orbit_choices = []\n        for r, c in np.argwhere(mask):\n            for dr, dc in ORTHOGONAL_STEPS:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < side and 0 <= nc < side and not mask[nr, nc]:\n                    orbit = _gen_orbit(side, int(nr), int(nc))\n                    added = sum(1 for p in orbit if not mask[p])\n                    if added and int(mask.sum()) + added <= max_area:\n                        orbit_choices.append((int(nr), int(nc), added))\n        if not orbit_choices:\n            return None\n        if int(mask.sum()) >= min_area and random.random() < TEMPLATE_STOP_PROBABILITY:\n            break\n        r, c, _ = random.choice(orbit_choices)\n        _gen_add_orbit(mask, r, c)\n\n    if not (min_area <= int(mask.sum()) <= max_area):\n        return None\n    return mask\n\n\ndef _gen_windows(height: int, width: int, side: int, count: int) -> list[tuple[int, int]] | None:\n    windows: list[tuple[int, int]] = []\n    candidates = [(r, c) for r in range(height - side + 1) for c in range(width - side + 1)]\n    for _ in range(count):\n        valid = []\n        for r, c in candidates:\n            ok = True\n            for pr, pc in windows:\n                separated_rows = (\n                    r + side <= pr - WINDOW_GAP or pr + side <= r - WINDOW_GAP\n                )\n                separated_cols = (\n                    c + side <= pc - WINDOW_GAP or pc + side <= c - WINDOW_GAP\n                )\n                if not (separated_rows or separated_cols):\n                    ok = False\n                    break\n            if ok:\n                valid.append((r, c))\n        if not valid:\n            return None\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRY_LIMIT):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid f8cc533f input\")\n","exit_code":0,"status":"completed"}}
