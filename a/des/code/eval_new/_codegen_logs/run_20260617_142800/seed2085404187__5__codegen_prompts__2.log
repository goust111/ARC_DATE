{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nfrom collections import Counter\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/eval_new/seed2085404187/5/2.py')\nmod = SourceFileLoader('new_arc_task_branchcheck', str(p)).load_module()\n\nBG = mod.BG_COLOR\nFENCE = mod.FENCE_COLOR\n\ndef comps(mask):\n    h, w = mask.shape\n    seen = np.zeros_like(mask, dtype=bool)\n    out = []\n    for r in range(h):\n        for c in range(w):\n            if not mask[r, c] or seen[r, c]:\n                continue\n            st = [(r, c)]\n            seen[r, c] = True\n            cur = []\n            while st:\n                rr, cc = st.pop()\n                cur.append((rr, cc))\n                for dr, dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                    nr, nc = rr + dr, cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\n                        seen[nr, nc] = True\n                        st.append((nr, nc))\n            out.append(cur)\n    return out\n\ncounter = Counter()\nfor _ in range(100):\n    g = mod.generate_input()\n    for comp in comps(g == FENCE):\n        rs = [r for r, _ in comp]\n        cs = [c for _, c in comp]\n        r0, r1 = min(rs), max(rs)\n        c0, c1 = min(cs), max(cs)\n        interior = g[r0+1:r1, c0+1:c1]\n        seeds = int(((interior \"'!= BG) & (interior != FENCE)).sum())\n        fit = 0\n        for depth in range(1, seeds + 1):\n            if r0 + depth >= r1 - depth or c0 + depth >= c1 - depth:\n                break\n            fit += 1\n        if fit == seeds:\n            counter['\"'full'] += 1\n        elif fit == 0:\n            counter['none'] += 1\n        else:\n            counter['partial'] += 1\nprint(counter)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
