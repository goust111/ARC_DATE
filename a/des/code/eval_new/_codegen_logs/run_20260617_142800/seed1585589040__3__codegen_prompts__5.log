7:     assert len(moving_colors) == 1\n  38:     moving_color = int(moving_colors[0])\n  39:     moving_objects = by_color[moving_color]\n  40: \n  41:     out = g.copy()\n  42:     for comp in moving_objects:\n  43:         coords = comp[\"coords\"]\n  44:         out[coords[:, 0], coords[:, 1]] = bg\n  45: \n  46:     for comp in moving_objects:\n  47:         coords = comp[\"coords\"]\n  48:         r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n  49:         height = int(r1 - r0 + 1)\n  50:         width = int(c1 - c0 + 1)\n  51:         assert int(comp[\"area\"]) == height * width\n  52: \n  53:         touches_top = r0 == 0\n  54:         touches_bottom = r1 == H - 1\n  55:         touches_left = c0 == 0\n  56:         touches_right = c1 == W - 1\n  57:         assert touches_top != touches_bottom\n  58:         assert touches_left != touches_right\n  59: \n  60:         dr = height if touches_top else -height\n  61:         dc = width if touches_left else -width\n  62:         shifted = coords + np.array([dr, dc], dtype=int)\n  63:         assert bool(\n  64:             np.all(\n  65:                 (0 <= shifted[:, 0])\n  66:                 & (shifted[:, 0] < H)\n  67:                 & (0 <= shifted[:, 1])\n  68:                 & (shifted[:, 1] < W)\n  69:             )\n  70:         )\n  71: \n  72:         target = out[shifted[:, 0], shifted[:, 1]]\n  73:         assert bool(np.all((target == bg) | (target == moving_color)))\n  74:         out[shifted[:, 0], shifted[:, 1]] = moving_color\n  75: \n  76:     return out\n  77: \n  78: # --------------- generator (o5x) ---------------\n  79: \n  80: # Corner and movement model.\n  81: CORNERS = (\"TL\", \"TR\", \"BL\", \"BR\")\n  82: DIAGONAL_PAIRS = ({\"TL\", \"BR\"}, {\"TR\", \"BL\"})\n  83: INWARD_STEP_FACTOR = 2\n  84: COMPACT_CANVAS_FACTOR = 3\n  85: \n  86: # Canvas, object count, and retry bounds.\n  87: GRID_ROW_BOUNDS = (7, 22)\n  88: GRID_COL_BOUNDS = (7, 30)\n  89: SQUARE_SIZE_BOUNDS = (1, 4)\n  90: MOVING_COUNT_BOUNDS = (2, 4)\n  91: GENERATION_RETRIES = 300\n  92: \n  93: # Color palette.\n  94: COLOR_VALUES = tuple(range(10))\n  95: \n  96: def _corner_pos(corner: str, H: int, W: int, s: int) -> tuple[int, int]:\n  97:     row = 0 if corner[0] == \"T\" else H - s\n  98:     col = 0 if corner[1] == \"L\" else W - s\n  99:     return row, col\n 100: \n 101: \n 102: def _shifted_pos(corner: str, H: int, W: int, s: int) -> tuple[int, int]:\n 103:     row = s if corner[0] == \"T\" else H - INWARD_STEP_FACTOR * s\n 104:     col = s if corner[1] == \"L\" else W - INWARD_STEP_FACTOR * s\n 105:     return row, col\n 106: \n 107: \n 108: def _valid_sizes(s: int, moving_count: int) -> list[tuple[int, int]]:\n 109:     sizes = []\n 110:     min_h = max(GRID_ROW_BOUNDS[0], INWARD_STEP_FACTOR * s + 1)\n 111:     min_w = max(GRID_COL_BOUNDS[0], INWARD_STEP_FACTOR * s + 1)\n 112:     for H in range(min_h, GRID_ROW_BOUNDS[1] + 1):\n 113:         for W in range(min_w, GRID_COL_BOUNDS[1] + 1):\n 114:             bg_area = H * W - len(CORNERS) * s * s\n 115:             if bg_area <= moving_count * s * s:\n 116:                 continue\n 117:             compact = H < COMPACT_CANVAS_FACTOR * s and W < COMPACT_CANVAS_FACTOR * s\n 118:             if moving_count == MOVING_COUNT_BOUNDS[1] - 1 and compact:\n 119:                 continue\n 120:             sizes.append((H, W))\n 121:     return sizes\n 122: \n 123: \n 124: def _pick_moving_corners(H: int, W: int, s: int, moving_count: int) -> set[str]:\n 125:     if moving_count == len(CORNERS):\n 126:         return set(CORNERS)\n 127:     compact = H < COMPACT_CANVAS_FACTOR * s and W < COMPACT_CANVAS_FACTOR * s\n 128:     if moving_count == MOVING_COUNT_BOUNDS[0] and compact:\n 129:         return set(random.choice(DIAGONAL_PAIRS))\n 130:     return set(random.sample(CORNERS, moving_count))\n\n 202: def generate_input() -> np.ndarray:\n 203:     for _ in range(GENERATION_RETRIES):\n 204:         grid = _gen_attempt()\n 205: 