lse\n  68:             if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):\n  69:                 ok = False\n  70:             if not ok:\n  71:                 continue\n  72: \n  73:             t = int(tt)\n  74:             inner_col = int(next(iter(u)))\n  75:             break\n  76: \n  77:         if t is None or inner_col is None:\n  78:             continue\n  79: \n  80:         frames.append(\n  81:             {\n  82:                 \"bbox\": (int(r0), int(c0), int(r1), int(c1)),\n  83:                 \"t\": int(t),\n  84:                 \"inner\": int(inner_col),\n  85:                 \"inner_bbox\": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),\n  86:             }\n  87:         )\n  88: \n  89:     assert not (not frames)\n  90: \n  91:     by: dict[int, list[dict]] = defaultdict(list)\n  92:     for f in frames:\n  93:         by[int(f[\"inner\"])].append(f)\n  94: \n  95:     max_frame_r = max(int(f[\"bbox\"][2]) for f in frames)\n  96: \n  97:     # control row = bottom-most row below the squares with >=2 non-bg pixels\n  98:     ctrl_r = None\n  99:     for r in range(int(H - 1), int(max_frame_r), -1):\n 100:         if int((g[int(r)] != int(bg)).sum()) >= 2:\n 101:             ctrl_r = int(r)\n 102:             break\n 103:     assert not (ctrl_r is None)\n 104: \n 105:     ctrl = [int(g[int(ctrl_r), int(c)]) for c in range(int(W)) if int(g[int(ctrl_r), int(c)]) != int(bg)]\n 106:     assert not (len(ctrl) < 2)\n 107: \n 108:     def center(f: dict) -> tuple[int, int]:\n 109:         r0, c0, r1, c1 = map(int, f[\"bbox\"])\n 110:         return int((r0 + r1) // 2), int((c0 + c1) // 2)\n 111: \n 112:     def aligned(f1: dict, f2: dict) -> tuple[bool, bool]:\n 113:         a = f1[\"inner_bbox\"]\n 114:         b = f2[\"inner_bbox\"]\n 115:         same_row = bool(int(a[0]) == int(b[0]) and int(a[2]) == int(b[2]))\n 116:         same_col = bool(int(a[1]) == int(b[1]) and int(a[3]) == int(b[3])