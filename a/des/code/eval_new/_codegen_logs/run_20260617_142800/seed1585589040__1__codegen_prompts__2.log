mod._RNG.permutation(4)\n    slots = []\n    for chamber_idx, rot_idx in enumerate(rotation_order):\n        mask = slot_masks[int(rot_idx)]\n        base_r, base_c = chamber_bases[chamber_idx]\n        slack_r = chamber_h - mask.shape[0]\n        slack_c = chamber_w - mask.shape[1]\n        top = base_r + int(mod._RNG.integers(0, slack_r + 1))\n        left = base_c + int(mod._RNG.integers(0, slack_c + 1))\n        slots.append({'top': top, 'left': left, 'mask': mask, 'rot_idx': int(rot_idx)})\n        mod._paint_mask(grid, template_top + top, template_left + left, mask, mod._BG)\n    expected[:] = grid\n    quadrant_specs = [('ul', 0), ('ur', 3), ('ll', 1), ('lr', 2)]\n    slot_for_quadrant = mod._RNG.permutation(4)\n    colors = mod._RNG.choice(mod._PIECE_COLORS, size=4, replace=False)\n    ok = True\n    mapping=[]\n    for idx, (quadrant, turns) in enumerate(quadrant_specs):\n        slot = slots[int(slot_for_quadrant[idx])]\n        piece_mask = mod._rotate(slot['mask'], -turns)\n        pos = mod._sample_piece_position(grid.shape, template_bbox, quadrant, piece_mask.shape)\n        if pos is None:\n            ok = False\n            print('pos none', quadrant)\n            break\n        piece_top, piece_left = pos\n        color = int(colors[idx])\n        mod._paint_mask(grid, piece_top, piece_left, piece_mask, color)\n        mod._paint_mask(expected, template_top + slot['top'], template_left + slot['left'], slot['mask'], color)\n        mapping.append((quadrant, turns, slot['rot_idx'], piece_mask.shape, pos, color))\n    if not ok:\n        continue\n    try:\n        out = mod.main(grid)\n    except Exception as e:\n        print('solver exception', type(e).__name__, e)\n        print('grid shape', grid.shape)\n        print('mapping', mapping)\n        break\n    if not np.array_equal(out, expected):\n        print('mismatch on attempt', attempt)\n        print('grid shape', grid.shape)\n        print('mapping', mapping)\n        print('template bbox',