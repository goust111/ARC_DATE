{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport numpy as np\nimport math\n\np = Path('/home/lixinyu/snap/a/des/code/eval_new/seed1585589040/1/2.py')\nmod = SourceFileLoader('new_arc_task_dbg', str(p)).load_module()\n\nfor attempt in range(20):\n    base = mod._random_base_mask()\n    slot_masks = [mod._rotate(base, k) for k in range(4)]\n    max_h = max(mask.shape[0] for mask in slot_masks)\n    max_w = max(mask.shape[1] for mask in slot_masks)\n    chamber_h = max_h + 1\n    chamber_w = max_w + 1\n    border = 2\n    row_gap = int(mod._RNG.integers(2, 4))\n    col_gap = int(mod._RNG.integers(2, 4))\n    template_h = 2 * chamber_h + row_gap + 2 * border\n    template_w = 2 * chamber_w + col_gap + 2 * border\n    top_strip = max_h + 2 + int(mod._RNG.integers(0, 2))\n    bottom_strip = max_h + 2 + int(mod._RNG.integers(0, 2))\n    left_strip = max_w + 4 + int(mod._RNG.integers(0, 4))\n    right_strip = max_w + 2 + int(mod._RNG.integers(0, 2))\n    outer = 1\n    grid_h = top_strip + template_h + bottom_strip + 2 * outer\n    grid_w = left_strip + template_w + right_strip + 2 * outer\n    print('attempt', attempt, 'base', base.shape, 'grid', (grid_h, grid_w), 'template', (template_h, template_w), 'strips', (top_strip,bottom_strip,left_strip,right_strip))\n    if grid_h > 30 or grid_w > 30:\n        print('too big')\n        continue\n    template_top = outer + top_strip\n    template_left = outer + left_strip\n    template_bbox = (template_top, template_left, template_top+template_h-1, template_left+template_w-1)\n    chamber_bases = [\n        (border, border),\n        (border, border + chamber_w + col_gap),\n        (border + chamber_h + row_gap, border),\n        (border + chamber_h + row_gap, border + chamber_w + col_gap),\n    ]\n    rotation_order = mod._RNG.permutation(4)\n    slots = []\n    for chamber_idx, rot_idx in enumerate(rotation_order):\n        mask = slot_masks[int(rot_idx)]\n        base_r, base_c = chamber_bases[chamber_idx]\n        slack_r = chamber_h - mask.shape[0]\n        slack_c = chamber_w - mask.shape[1]\n        top = base_r + int(mod._RNG.integers(0, slack_r + 1))\n        left = base_c + int(mod._RNG.integers(0, slack_c + 1))\n        slots.append({'top': top, 'left': left, 'mask': mask})\n    quadrant_specs = [('ul', 0), ('ur', 3), ('ll', 1), ('lr', 2)]\n    slot_for_quadrant = mod._RNG.permutation(4)\n    ok = True\n    for idx, (quadrant, turns) in enumerate(quadrant_specs):\n        slot = slots[int(slot_for_quadrant[idx])]\n        piece_mask = mod._rotate(slot['mask'], -turns)\n        pos = mod._sample_piece_position((grid_h, grid_w), template_bbox, quadrant, piece_mask.shape)\n        print(' ', quadrant, 'piece', piece_mask.shape, 'pos', pos)\n        if pos is None:\n            ok = False\n    if ok:\n        print('sample positions ok')\n        break\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
