{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/67e490f4.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill holes inside a large template frame using shape-matched outside sprites.\n\n    Input structure:\n    - bg = most common color. One large monochrome frame object (template).\n    - Inside the frame: holes of various shapes (non-frame-color regions).\n    - Outside the frame: small monochrome sprites scattered on bg.\n\n    Rule:\n    - Crop to the frame's bounding box; fill entirely with frame color.\n    - For each hole, find an outside sprite whose shape matches (rotation/flip allowed).\n    - Fill the hole with the matched sprite's color. If multiple sprites match, use the most frequent color.\n\n    Key insight: Sprites act as shape-coded color keys — their shape identifies which hole they fill, their color determines the fill color.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    bg = int(get_bg(g))\n\n    # STEP 1) Find the template frame: largest connected component of any non-bg color (8-connected).\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True, return_format=\"dict\")\n    assert comps\n    frame_area = max(int(comp[\"area\"]) for comp in comps)\n    frame_candidates = [comp for comp in comps if int(comp[\"area\"]) == frame_area]\n    assert len(frame_candidates) == 1\n    frame = frame_candidates[0]\n    frame_col = int(frame[\"color\"])\n    fb = frame[\"bbox\"]\n    r0, c0, r1, c1 = map(int, fb)\n\n    sub = crop_bbox(g, fb)\n    th, tw = sub.shape\n\n    # STEP 2) Extract hole components inside the bbox (anything not equal to frame color), 4-connected.\n    hole_mask = (sub != int(frame_col))\n    holes: list[tuple[tuple[tuple[int, int], bytes], tuple[int, int], np.ndarray]] = []  # (key, (r0,c0), mask)\n    for coords in components_mask(hole_mask, connectivity=4):\n        hr0, hc0, hr1, hc1 = bbox_coords(coords)\n        hh = int(hr1 - hr0 + 1)\n        ww = int(hc1 - hc0 + 1)\n        rel = coords - np.array([hr0, hc0])\n        m = np.zeros((hh, ww), dtype=bool)\n        m[rel[:, 0], rel[:, 1]] = True\n        key = (m.shape, m.tobytes())\n        holes.append((key, (int(hr0), int(hc0)), m))\n\n    # STEP 3) Extract sprites outside the bbox.\n    outside = g.copy()\n    outside[r0 : r1 + 1, c0 : c1 + 1] = int(bg)\n    spr_comps = find_components(outside, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    # key -> color -> count\n    sprites_by_key: dict[tuple[tuple[int, int], bytes], dict[int, int]] = {}\n\n    def _all_mask_keys(mask: np.ndarray):\n        \"\"\"Generate keys for all rotations (and optional vertical flip) of a boolean mask.\"\"\"\n        m0 = mask.astype(bool)\n        for flip in (False, True):\n            m1 = np.flipud(m0) if flip else m0\n            for k in range(4):\n                m2 = np.rot90(m1, k)\n                yield (m2.shape, m2.tobytes())\n\n    for comp in spr_comps:\n        coords = comp[\"coords\"]\n        bb = comp[\"bbox\"]\n        sr0, sc0, sr1, sc1 = map(int, bb)\n        hh = int(sr1 - sr0 + 1)\n        ww = int(sc1 - sc0 + 1)\n\n        vals = [int(v) for v in g[coords[:, 0], coords[:, 1]]]\n        scol = int(Counter(vals).most_common(1)[0][0])\n\n        rel = coords - np.array([sr0, sc0])\n        m = np.zeros((hh, ww), dtype=bool)\n        m[rel[:, 0], rel[:, 1]] = True\n\n        for key in _all_mask_keys(m):\n            bucket = sprites_by_key.setdefault(key, {})\n            bucket[scol] = int(bucket.get(scol, 0)) + 1\n\n    # STEP 4) Render output: start from solid frame color, then fill each hole by shape match.\n    out = np.full((th, tw), int(frame_col), dtype=int)\n    for key, (hr0, hc0), hmask in holes:\n        cmap = sprites_by_key.get(key)\n        assert cmap is not None\n        # choose the most frequent sprite color for this shape; break ties by preferring smaller color id\n        scol = max(cmap.items(), key=lambda kv: (kv[1], -kv[0]))[0]\n        patch = np.full(hmask.shape, int(scol), dtype=int)\n        paste(out, patch, int(hr0), int(hc0), mask=hmask)\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# ── Configuration ──────────────────────────────────────────────────────\nNUM_COLORS = 10\nGRID_SIZE = 30\n\n# Frame bbox dimensions\nFRAME_H_RANGE = (7, 13)\nFRAME_W_RANGE = (7, 20)\n\n# Hole layout\nSHAPE_COUNT_RANGE = (3, 6)          # distinct canonical hole shapes\nMIN_SHAPES = 3                       # minimum to accept a layout\nSHAPE_MAX_AREA = 8                   # max cells per hole shape\nFRAME_DENSITY_RANGE = (0.55, 0.92)   # fraction of frame_col in frame bbox\nMIN_TOTAL_HOLES = 5                  # minimum hole instances\nPLACEMENT_RETRIES = 80               # retries per symmetric placement attempt\nMULT_EVEN_WEIGHTS = ([1, 2], [4, 1])       # (values, weights) for even-dim frames\nMULT_ODD_WEIGHTS = ([1, 2, 3], [3, 2, 1])  # (values, weights) for odd-dim frames\n\n# Sprite scattering\nWINNING_SPRITE_RANGE = (2, 5)        # winning-color sprites per hole shape\nOTHER_COLOR_MAX = 2                  # max distinct losing colors per shape\nSPRITE_PADDING = 1                   # Chebyshev separation (bg cells)\n\n# Generation retry budget\nMAX_GEN_ATTEMPTS = 300\n\n\ndef _all_rot_flip(mask: np.ndarray):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '/\"'^def main(/,/''^def /p'\"' /home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py\"","aggregated_output":"def main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill the region enclosed by a wall sprite and radiate color outward through its opening.\n\n    Input structure:\n    - bg = most common color. Wall = most frequent non-bg color, forming a partial enclosure (e.g. U-shape).\n    - A fill-color pixel sits inside the enclosed area. Other non-bg pixels may act as obstacles.\n    Rule:\n    - Flood-fill the enclosed area with the fill color, radiating outward through the wall's open end.\n    - Obstacles cast \"shadows\" along the radiate direction, blocking fill behind them.\n\n    Key insight: The wall endpoints define the opening direction; fill radiates outward through it, and obstacles block propagation along that same axis.\n    \"\"\"\n    g = np.array(grid, copy=True)\n    h, w = g.shape\n\n    vals = np.unique(g)\n    bg = get_bg(g)\n\n    non_bg = [int(v) for v in vals if int(v) != bg]\n    assert non_bg, \"expected at least one non-background color\"\n\n    # Wall: most frequent non-background color.\n    wall = max(non_bg, key=lambda c: int((g == c).sum()))\n\n    wall_mask = g == wall\n\n    # Wall connected components (8-neigh).\n    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]\n    assert comps, \"expected at least one wall connected component\"\n\n    def sgn(x: int) -> int:\n        return (x > 0) - (x < 0)\n\n    other_colors = [c for c in non_bg if c != wall]\n    assert other_colors, \"expected at least one non-wall color (fill color)\"\n\n    # Pick fill color as the non-wall color closest (Manhattan distance) to the wall pixels.\n    wall_points = [p for comp in comps for p in comp]\n\n    def min_dist_to_wall(color: int) -> tuple[int, int]:\n        pts = list(zip(*np.where(g == color)))\n        pts = [(int(r), int(c)) for r, c in pts]\n        best_d = 10**9\n        for r, c in pts:\n            for wr, wc in wall_points:\n                d = abs(r - wr) + abs(c - wc)\n                if d < best_d:\n                    best_d = d\n                    if best_d == 0:\n                        return 0, len(pts)\n        return best_d, len(pts)\n\n    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))\n\n    fill_pos = list(zip(*np.where(g == fill)))\n    fill_pos = [(int(r), int(c)) for r, c in fill_pos]\n    if not fill_pos:\n        return g\n\n    # Choose the closest wall component to the fill seed (ties: larger component).\n    def comp_min_dist(comp: set[tuple[int, int]]) -> int:\n        best_d = 10**9\n        for r, c in fill_pos:\n            for wr, wc in comp:\n                d = abs(r - wr) + abs(c - wc)\n                if d < best_d:\n                    best_d = d\n                    if best_d == 0:\n                        return 0\n        return best_d\n\n    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))\n\n    comp_mask = np.zeros_like(wall_mask, dtype=bool)\n    for r, c in wall_comp:\n        comp_mask[r, c] = True\n\n    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:\n        out = []\n        for rr, cc in neighbors8(r, c):\n            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:\n                out.append((rr, cc))\n        return out\n\n    endpoints: list[tuple[int, int]] = []\n    for r, c in wall_comp:\n        if len(comp_neighbors(r, c)) == 1:\n            endpoints.append((r, c))\n\n    assert endpoints, \"expected wall component to have endpoints (degree-1 pixels)\"\n\n    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:\n        n1 = comp_neighbors(*ep)[0]\n        d1 = (sgn(n1[0] - ep[0]), sgn(n1[1] - ep[1]))  # inward\n        d_use = d1\n        is_12 = False\n        n2s = [p for p in comp_neighbors(*n1) if p != ep]\n        if n2s:\n            n2 = n2s[0]\n            d2 = (sgn(n2[0] - n1[0]), sgn(n2[1] - n1[1]))\n            if (d1[0] == 0) ^ (d1[1] == 0):\n                if d2[0] != 0 and d2[1] != 0:\n                    d_use = d2\n                    is_12 = True\n        return (-d_use[0], -d_use[1]), is_12\n\n    out_info = [outward_dir(ep) for ep in endpoints]\n    out_dirs = [d for d, _ in out_info]\n    tip_12 = [f for _, f in out_info]\n\n    dr_sum = sum(d[0] for d in out_dirs)\n    dc_sum = sum(d[1] for d in out_dirs)\n    rad = (sgn(dr_sum), sgn(dc_sum))\n\n    barrier = comp_mask.copy()\n\n    def add_ray(start: tuple[int, int], d: tuple[int, int], skip: int = 0) -> None:\n        rr, cc = start\n        for _ in range(skip):\n            rr += d[0]\n            cc += d[1]\n        while True:\n            rr += d[0]\n            cc += d[1]\n            if not (0 <= rr < h and 0 <= cc < w):\n                break\n            barrier[rr, cc] = True\n\n    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:\n        rr, cc = start\n        step = 0\n        while True:\n            step += 1\n            if step % 2 == 1:\n                rr += d[0]; cc += d[1]\n            else:\n                if rad[0] != 0:\n                    rr += d[0]\n                else:\n                    cc += d[1]\n            if not (0 <= rr < h and 0 <= cc < w):\n                break\n            barrier[rr, cc] = True\n\n    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):\n        if is_12:\n            add_ray_12(ep, d)\n        else:\n            add_ray(ep, d, skip=0)\n\n    passable = (~barrier) & ((g == bg) | (g == fill))\n    q = fill_pos[:]\n    seen = np.zeros_like(passable, dtype=bool)\n    for r, c in q:\n        if passable[r, c]:\n            seen[r, c] = True\n    while q:\n        r, c = q.pop()\n        for rr, cc in neighbors4(r, c):\n            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:\n                seen[rr, cc] = True\n                q.append((rr, cc))\n\n    filled_mask = (seen & (g == bg))\n\n    out = g.copy()\n    out[filled_mask] = fill\n\n    # Shadow behind obstacles (non-bg, non-fill, non-wall) along radiate direction.\n    obstacles = (g != bg) & (g != fill) & (g != wall)\n\n    def shadow_process(coords: list[tuple[int, int]]) -> None:\n        started = False\n        blocked = False\n        for r, c in coords:\n            if filled_mask[r, c]:\n                started = True\n            if started and obstacles[r, c]:\n                blocked = True\n                continue\n            if blocked and filled_mask[r, c]:\n                out[r, c] = bg\n                filled_mask[r, c] = False\n\n    if rad != (0, 0):\n        dr, dc = rad\n        if dr != 0 and dc == 0:\n            for c in range(w):\n                rows = range(h) if dr > 0 else range(h - 1, -1, -1)\n                shadow_process([(r, c) for r in rows])\n        elif dc != 0 and dr == 0:\n            for r in range(h):\n                cols = range(w) if dc > 0 else range(w - 1, -1, -1)\n                shadow_process([(r, c) for c in cols])\n        else:\n            # Diagonal scanlines\n            if dr == dc:\n                # r - c = const\n                for k in range(-(w - 1), h):\n                    coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]\n                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))\n                    shadow_process(coords)\n            else:\n                # r + c = const\n                for k in range(h + w - 1):\n                    coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]\n                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))\n                    shadow_process(coords)\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\nfrom scipy.ndimage import distance_transform_cdt\n\n# -- Configuration constants --------------------------------------------------\n# Canvas size bounds\nGRID_H_VERT = (11, 18)       # height range when radiate_dir is vertical\nGRID_H_HORIZ = (8, 18)       # height range when radiate_dir is horizontal\nGRID_W = (15, 19)             # width range (all directions)\n\n# Wall geometry\nWALL_PIXELS_MIN = 17          # minimum wall pixel count\nWALL_PIXELS_MAX = 25          # maximum wall pixel count\nDEPTH_VERT = (5, 10)          # arm depth range for vertical radiate\nDEPTH_HORIZ = (6, 8)          # arm depth range for horizontal radiate\nGAP_VERT = (6, 7)             # endpoint gap for vertical radiate\nGAP_HORIZ = (5, 7)            # endpoint gap for horizontal radiate\nTIP_12_PROB = 0.5             # probability of 1:2 arm-angle mode (when eligible)\n\n# Placement margins\nOPEN_END_MARGIN = 3           # min cells from open end to radiate grid edge\n\n# Fill seed\nSEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]  # weighted choices for blob size\nSEED_DEPTH_LOOKBACK = 3       # seed must be within this many rows of closed end\n\n# Obstacles\nMAX_OBSTACLES = 5             # maximum obstacle pixel count\nOBSTACLE_IN_FILL_PROB = 0.65  # probability of forcing at least one obstacle in fill zone\nOBSTACLE_MIN_SEP = 2          # Chebyshev distance between obstacles (> this value)\n\n# Validation\nMIN_NEW_FILL = 20             # minimum newly-filled pixels for a valid output\nPALETTE_SIZE = (3, 5)         # number of distinct colors (bg + wall + fill + obstacle(s))\nGEN_RETRIES = 300             # max attempts in generate_input\n\n\ndef _degree1_pixels(points):\n","exit_code":0,"status":"completed"}}
