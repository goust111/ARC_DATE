{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport numpy as np\np = Path('/home/lixinyu/snap/a/des/code/eval_new/seed1425705205/5/3.py')\nmod = SourceFileLoader('arc_new3_stats', str(p)).load_module()\n\nboth = straight_only = turn_only = neither = 0\nfor _ in range(50):\n    g = mod.generate_input()\n    bg = mod._most_common_color(g)\n    source = mod._find_source(g)\n    starts = []\n    for sr, sc in sorted(source):\n        for dr, dc in mod.DIRS4:\n            nb = (sr + dr, sc + dc)\n            if mod._in_bounds(g.shape, nb) and nb not in source and int(g[nb]) \"'!= bg:\n                starts.append((nb, (dr, dc)))\n    (pos, direction), = {(cell, d) for cell, d in starts}\n    current_color = int(g[pos])\n    saw_straight = False\n    saw_turn = False\n    for _step in range(g.shape[0] * g.shape[1] * 4):\n        cell_color = int(g[pos])\n        node = mod._is_node(g, pos, bg, source)\n        if node:\n            if cell_color == current_color:\n                saw_straight = True\n            else:\n                saw_turn = True\n                cands = []\n                for nd in (mod._left(direction), mod._right(direction)):\n                    nxt = (pos[0] + nd[0], pos[1] + nd[1])\n                    if mod._in_bounds(g.shape, nxt) and nxt not in source and int(g[nxt]) != bg:\n                        cands.append(nd)\n                direction = cands[0]\n                current_color = cell_color\n        nxt = (pos[0] + direction[0], pos[1] + direction[1])\n        if not mod._in_bounds(g.shape, nxt) or nxt in source or int(g[nxt]) == bg:\n            break\n        pos = nxt\n    if saw_straight and saw_turn:\n        both += 1\n    elif saw_straight:\n        straight_only += 1\n    elif saw_turn:\n        turn_only += 1\n    else:\n        neither += 1\nprint({'\"'both': both, 'straight_only': straight_only, 'turn_only': turn_only, 'neither': neither})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
