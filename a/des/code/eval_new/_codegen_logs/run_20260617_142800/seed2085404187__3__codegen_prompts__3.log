{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\npaths = [\n'/home/lixinyu/snap/new/ARC_code/eval/dbff022c.py',\n'/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py',\n'/home/lixinyu/snap/new/ARC_code/train/34cfa167.py',\n'/home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py',\n'/home/lixinyu/snap/new/ARC_code/train/9473c6fb.py',\n'/home/lixinyu/snap/new/ARC_code/train/17b866bd.py',\n'/home/lixinyu/snap/new/ARC_code/train/5792cb4d.py',\n'/home/lixinyu/snap/new/ARC_code/train/e048c9ed.py',\n]\nfor p in paths:\n    print('FILE', p)\n    text = Path(p).read_text()\n    for name in ('def main', 'def generate_input'):\n        idx = text.find(name)\n        print('\\\\n' + name)\n        print(text[idx: idx+2200])\n    print('\\\\n' + '='*80 + '\\\\n')\nPY\"","aggregated_output":"FILE /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\n\ndef main\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\n\ndef _get_enclosed\n\ndef generate_input\ndef generate_input():\n    for _ in range(_MAX_RETRIES):\n        r = _gen_attempt()\n        if r is not None:\n            return r\n    raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n\n\n================================================================================\n\nFILE /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\n\ndef main\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide a solid square through a winding channel to reach a same-sized target square.\n\n    Input structure:\n    - bg (most common color). A river color forms a winding corridor.\n    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n\n    Rule:\n    - The mover square travels along the river toward the destination.\n    - It can only pass through positions where the full NxN area is river.\n    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n    - The mover's original position is filled with the river color.\n\n    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # Corner-majority background (more stable than global mode here).\n    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n\n    # Detect solid square components (excluding bg).\n    squares: list[dict] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        b = comp[\"bbox\"]\n        if bbox_h(b) != bbox_w(b):\n            continue\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n        if not bool((patch == int(col)).all()):\n            continue\n        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n\n    assert not (len(squares) < 2)\n\n    # Choose the size that appears at least twice (most common size).\n    by_n: dict[int, list[dict]] = defaultdict(list)\n    for s in squares:\n        by_n[int(s[\"n\"])].append(s)\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    cand = by_n[int(nside)]\n    assert not (len(cand) < 2)\n\n    cand.sort(key=lambda s: int(s[\"col\"]))\n    mover = cand[0]\n    dest = cand[1]\n\n    n = int(mover[\"n\"])\n    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n\n    # River = most common remaining color (excluding bg and the two square colors).\n    counts = Counter(map(int, g.flatt\n\ndef generate_input\ndef generate_input():\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid input after 300 attempts\")\n\n\n\n\n================================================================================\n\nFILE /home/lixinyu/snap/new/ARC_code/train/34cfa167.py\n\ndef main\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete a four-corner framed rectangle from one decorated anchor rectangle and its diagonal mate.\n\n    Input structure:\n    - The background is the dominant color.\n    - Two same-color solid rectangular anchors of the same size sit on opposite\n      diagonal corners, with the first anchor above-left of the second.\n    - The upper-left anchor has two one-cell-thick vertical control bars to its\n      right and two one-cell-thick horizontal control bars below it.\n\n    Rule:\n    - Copy the anchor rectangle into the two missing corners of the implied\n      larger rectangle.\n    - Repeat the right-side control bars horizontally between the left and right\n      anchors, using their spacing as the period, and draw the outer top and\n      bottom borders in the first right-control color.\n    - Repeat the below-side control bars vertically between the top and bottom\n      anchors, using the same period, and draw the outer left and right borders\n      in the first below-control color.\n\n    Key insight: The small control bars are the first two ticks of two periodic\n    frame patterns; the diagonal anchor supplies the opposite corner and the\n    missing two anchor copies.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    source, dest, right_controls, below_controls = _find_structure(g, bg)\n\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    dr0, dc0, dr1, dc1 = dest[\"bbox\"]\n    anchor_color = int(source[\"color\"])\n    assert int(dest[\"color\"]) == anchor_color, \"anchor colors must match\"\n    assert bbox_h(source[\"bbox\"]) == bbox_h(dest[\"bbox\"]), \"anchor heights must match\"\n    assert bbox_w(source[\"bbox\"]) == bbox_w(dest[\"bbox\"]), \"anchor widths must match\"\n    assert sr0 > 0 and sc0 > 0, \"upper-left anchor must have space for outer frame\"\n    assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], \"lower-right anchor must have space for outer frame\"\n\n    right_offsets = [int(comp[\"bbox\"][1] - sc1) for comp in right_controls]\n    below_offsets = [int(comp[\"bbox\"][0] - sr1) for comp in below_controls]\n    assert right_offsets == below_offsets and right_offsets[0] == 1, \"control offsets must match from the anchor edge\n\ndef generate_input\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n\n\n================================================================================\n\nFILE /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py\n\ndef main\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighb\n\ndef generate_input\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exhausted attempts\")\n\n\n================================================================================\n\nFILE /home/lixinyu/snap/new/ARC_code/train/9473c6fb.py\n\ndef main\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor the sparse foreground pixels in scan order along their longer spread, cycling red, teal, and grey.\n\n    Input structure:\n    - The dominant color is the background.\n    - Every foreground object is a single isolated 4-connected pixel.\n    - The foreground pixel set has a rectangular bbox whose row or column extent defines the scan direction.\n\n    Rule:\n    - Keep the background unchanged.\n    - If the foreground bbox is at least as tall as it is wide, order foreground pixels row-major; otherwise order them column-major.\n    - Recolor the ordered pixels by repeating red, teal, grey from the first pixel onward.\n\n    Key insight:\n    - The original foreground colors are only markers; the output color depends on each marker's ordinal position in the dominant scan direction.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg not in _CYCLE, \"background must be distinct from the output color cycle\"\n\n    fg = g != bg\n    coords = coords_where(fg)\n    assert len(coords) > 0, \"expected at least one foreground marker\"\n\n    coords_list = [(int(r), int(c)) for r, c in coords]\n    for r, c in coords_list:\n        assert all(\n            not in_bounds(g.shape, nr, nc) or int(g[nr, nc]) == bg\n            for nr, nc in neighbors4(r, c)\n        ), \"foreground markers must be isolated 4-connected pixels\"\n\n    r0, c0, r1, c1 = bbox_coords(coords)\n    row_extent = int(r1 - r0 + 1)\n    col_extent = int(c1 - c0 + 1)\n    if row_extent >= col_extent:\n        ordered = sorted(coords_list)\n    else:\n        ordered = sorted(coords_list, key=lambda rc: (rc[1], rc[0]))\n\n    out = g.copy()\n    for i, (r, c) in enumerate(ordered):\n        out[r, c] = _CYCLE[i % len(_CYCLE)]\n\n    return out\n\n# --------------- generator (att2) ---------------\n\nimport random\n\n# Canvas and marker density bounds.\nHEIGHT_RANGE = range(6, 10)\nWIDTH_RANGE = range(8, 13)\nMARKER_COUNT_RANGE = (6, 10)\nDENSITY_RANGE = (0.09, 0.15)\n# Bbox span and palette constraints.\nMIN_CROSS_SPAN = 3\nPALETTE_SIZE_RANGE = (3, 4)\nBACKGROUND_COLORS = [0, 1, 3, 4, 6, 7, 9]\nPREFERRED_BACKGROUND = 7\nPREFERRED_BACKGROUND_RATE = 0.6\nOUTPUT_CYCLE = (2, \n\ndef generate_input\ndef generate_input():\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 9473c6fb input\")\n\n\n================================================================================\n\nFILE /home/lixinyu/snap/new/ARC_code/train/17b866bd.py\n\ndef main\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move each marker from a lattice corner gap into the adjacent enclosed 12-pixel cavity.\n\n    Input structure:\n    - The grid is a repeated teal lattice around black 12-pixel cavities.\n    - A marker is a non-black pixel placed at the northwest corner gap of one\n      complete 5x5 lattice tile; the marker may itself be teal.\n\n    Rule:\n    - For every marked northwest corner gap, clear that marker to black.\n    - Fill the 12 black pixels in the tile immediately down-right of the marker\n      with the marker color.\n    - Leave the rest of the lattice unchanged.\n\n    Key insight:\n    - The apparent isolated markers are control pixels for the adjacent cavity;\n      teal markers are recognized as extra teal pixels occupying a gap that the\n      periodic lattice template says should be black.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    empty = Color.BACKGROUND\n    lattice = _lattice_color(g, empty)\n    h, w = g.shape\n\n    anchors: list[tuple[int, int, int]] = []\n    for r in range(h - 4):\n        for c in range(w - 4):\n            if _matches_anchor_template(g, r, c, empty, lattice) and int(g[r, c]) != empty:\n                anchors.append((r, c, int(g[r, c])))\n\n    assert anchors, \"expected at least one marked lattice anchor\"\n\n    out = g.copy()\n    for r, c, color in anchors:\n        out[r, c] = empty\n        for dr, dc in _INTERIOR_OFFSETS:\n            assert int(g[r + dr, c + dc]) == empty, \"anchor cavity must be empty before filling\"\n            out[r + dr, c + dc] = color\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- CFG: tunable generation parameters ---\n_LATTICE = 8                       # lattice / frame color\n_EMPTY = 0                        # background / cavity color\n_TILE_RANGE = (3, 4)              # rows/cols of tiles (N, M each sampled from this)\n_MAX_MARKERS = 9                  # upper bound on marker count per grid\n_MAX_DISTINCT_NON_LATTICE = 3     # max distinct non-lattice marker colors\n_LATTICE_MARKER_PROB = 0.35       # probability of including lattice-color markers\n_NON_LATTICE_COLORS = (1, 2, 3, 4, 5, 6, 7, 9)\n_GEN_RETRIES = 300                # max attempts \n\ndef generate_input\ndef generate_input() -> np.ndarray:\n    for _ in range(_GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise AssertionError(\"failed to generate a valid 17b866bd input\")\n\n\n================================================================================\n\nFILE /home/lixinyu/snap/new/ARC_code/train/5792cb4d.py\n\ndef main\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Reverse the sequence of colors along the single 4-connected foreground path while keeping the path shape fixed.\n\n    Input structure:\n    - The background is the dominant color.\n    - All non-background pixels form one multicolor 4-connected one-pixel-wide path.\n    - The path has exactly two endpoints and no branches.\n\n    Rule:\n    - Walk the path from one endpoint to the other.\n    - Replace the colors on those same path cells by the original path colors in reverse order.\n    - Leave every background pixel unchanged.\n\n    Key insight:\n    - Nothing moves geometrically; only the color string written on the path is reversed between the endpoints.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n    assert len(components) == 1, \"expected exactly one foreground path\"\n\n    path = _ordered_path(components[0][\"coords\"])\n    values = [int(g[r, c]) for r, c in path]\n\n    out = g.copy()\n    for (r, c), value in zip(path, reversed(values)):\n        out[r, c] = value\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Grid and path geometry.\nGRID_SHAPE = (10, 10)\nBG_COLOR = 8\nINTERIOR_MIN = 1\nINTERIOR_MAX = 8\nPATH_LEN_MIN, PATH_LEN_MAX = 8, 28\nTURN_COUNT_MIN, TURN_COUNT_MAX = 2, 8\nSEGMENT_STEPS_MIN, SEGMENT_STEPS_MAX = 1, 7\n\n# Direction and color sampling.\nDIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]\nPATH_COLORS = [1, 2, 4, 5, 6, 7, 9]\nPALETTE_SIZE_MIN, PALETTE_SIZE_MAX = 6, 7\n\n# Generation retry budget.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _turn_dirs(direction: tuple[int, int] | None) -> list[tuple[int, int]]:\n    if direction is None:\n        dirs = list(DIRS)\n    else:\n        dr, dc = direction\n        dirs = [(-dc, dr), (dc, -dr)]\n    random.shuffle(dirs)\n    return dirs\n\n\ndef _sample_run_lengths(n_segments: int, total_steps: int) -> list[int]:\n    runs = []\n    remaining = total_steps\n    for i in range(n_segments):\n        slots = n_segments - i - 1\n        lo = max(SEGMENT_STEPS_MIN, remaining - SEGMENT_STEPS_MAX * slots)\n        hi = min(SEGMENT_STEPS_MAX, remaining - SEGMENT_STEPS_MIN * slots\n\ndef generate_input\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 5792cb4d input\")\n\n\n================================================================================\n\nFILE /home/lixinyu/snap/new/ARC_code/train/e048c9ed.py\n\ndef main\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Add a quantity-color label in the top marker column for each horizontal bar.\n\n    Input structure\n    - The grid has a black background and one non-background marker pixel in the top row.\n    - Below the marker row, every non-empty source row contains one solid monochrome horizontal bar to the left of the marker column.\n    - Source rows are staggered every other row.\n\n    Rule\n    - Copy the input grid.\n    - For each source bar, read its quantity as the bar length.\n    - Paint the quantity color in the marker column on the same row as the bar:\n      2->1, 3->4, 4->9, 5->6.\n\n    Key insight\n    - The grey marker supplies the result column, while each bar supplies a small quantity with a fixed color code.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    assert bg == 0, \"expected black background for square-digit labels\"\n\n    marker_cols = np.flatnonzero(g[0] != bg)\n    assert len(marker_cols) == 1, \"expected exactly one top-row marker\"\n    marker_c = int(marker_cols[0])\n    assert g[0, marker_c] == Color.GREY, \"top-row marker must be grey\"\n\n    source_rows = [r for r in range(1, g.shape[0]) if np.any(g[r] != bg)]\n    assert source_rows, \"expected at least one source bar\"\n    first_source_row = source_rows[0]\n\n    out = g.copy()\n    for bar_order, r in enumerate(source_rows):\n        assert (r - first_source_row) % 2 == 0, \"source bars must follow the staggered row spacing\"\n        cols = np.flatnonzero(g[r] != bg)\n        c0, c1 = int(cols[0]), int(cols[-1])\n        expected_cols = np.arange(c0, c1 + 1)\n        assert np.array_equal(cols, expected_cols), \"source row must contain one contiguous bar\"\n        assert np.unique(g[r, c0 : c1 + 1]).size == 1, \"source bar must be monochrome\"\n        assert c1 < marker_c, \"source bar must lie to the left of the marker column\"\n        assert g[r, marker_c] == bg, \"marker-column output cell must be empty\"\n\n        bar_length = c1 - c0 + 1\n        assert 2 <= bar_length <= 5, \"bar length quantity must be 2-5\"\n        assert bar_length in _QUANTITY_TO_COLOR, \"quantity must be one of 2, 3, 4, or 5\"\n        out[r, marker_c] = _QUANTITY_TO_COLOR[bar_length]\n\n   \n\ndef generate_input\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n\n\n================================================================================\n\n","exit_code":0,"status":"completed"}}
