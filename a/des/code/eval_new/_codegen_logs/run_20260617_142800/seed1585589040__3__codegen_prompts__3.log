{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/train/52364a65.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import find_components, get_bg, paste, random_free_location, random_sprite\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Erase the two leftmost columns of every foreground object, leaving the rest of each object in place.\n\n    Input structure:\n    - A grid has one dominant background color and several monochromatic 4-connected foreground objects.\n    - Each foreground object spans at least two columns in its bounding box.\n\n    Rule:\n    - Find each same-color 4-connected foreground object.\n    - Within each object's own bounding box, set foreground pixels in the two leftmost columns to the background color.\n    - Leave all other pixels unchanged.\n\n    Key insight:\n    - The deletion is measured from each object's local left edge, not from the grid edge or from a shared global column.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    assert components, \"expected at least one foreground object\"\n\n    out = g.copy()\n    for component in components:\n        coords = component[\"coords\"]\n        _r0, c0, _r1, c1 = map(int, component[\"bbox\"])\n        assert c1 - c0 + 1 >= 2, \"each object must span at least two columns\"\n\n        erase = coords[coords[:, 1] < c0 + 2]\n        out[erase[:, 0], erase[:, 1]] = bg\n\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n# Canvas constraints.\nBG = 8\nGRID_SIZE_RANGE = (8, 11)\nMIN_BACKGROUND_FRACTION = 0.50\n# Object sampling constraints.\nOBJECT_COUNT = 4\nFOREGROUND_COLORS = [0, 1, 2, 3, 4, 5, 6, 7, 9]\nSPRITE_WIDTH_RANGE = (2, 6)\nSPRITE_HEIGHT_RANGE = (2, 5)\nSPRITE_PIXEL_RANGE = (4, 14)\nSPRITE_RETRIES = 30\nSPRITE_CONNECTIVITY = 4\nSPRITE_SYMMETRY = \"not_symmetric\"\n# Placement and global retry policy.\nPLACEMENT_PADDING = 1\nPLACEMENT_CONNECTIVITY = 8\nGENERATION_RETRIES = 300\n\ndef _sample_sprite(color: int) -> np.ndarray | None:\n    \"\"\"Return one connected sprite that lands inside the configured pixel-count range.\"\"\"\n    bw = random.randint(*SPRITE_WIDTH_RANGE)\n    bh = random.randint(*SPRITE_HEIGHT_RANGE)\n    max_px = bw * bh\n    min_px = max(SPRITE_PIXEL_RANGE[0], bw + bh - 1)\n    max_target_px = min(SPRITE_PIXEL_RANGE[1], max_px)\n    if min_px > max_target_px:\n        return None\n    target_px = random.randint(min_px, max_target_px)\n    density = target_px / max_px\n    for _ in range(SPRITE_RETRIES):\n        try:\n            sprite = random_sprite(bh, bw, density=density, color_palette=[color],\n                                   connectivity=SPRITE_CONNECTIVITY, background=BG,\n                                   symmetry=SPRITE_SYMMETRY)\n        except Exception:\n            continue\n        px = int(np.sum(sprite != BG))\n        if SPRITE_PIXEL_RANGE[0] <= px <= SPRITE_PIXEL_RANGE[1]:\n            return sprite\n    return None\n\ndef _place_sprite(grid: np.ndarray, sprite: np.ndarray) -> bool:\n    \"\"\"Paste sprite with the required Chebyshev gap; return False if no slot exists.\"\"\"\n    try:\n        r, c = random_free_location(grid, sprite, transparent=BG,\n                                    padding=PLACEMENT_PADDING,\n                                    padding_connectivity=PLACEMENT_CONNECTIVITY)\n    except ValueError:\n        return False\n    paste(grid, sprite, r, c, transparent=BG)\n    return True\n\ndef _solver_accepts(grid: np.ndarray) -> bool:\n    \"\"\"Return whether the solver accepts the sampled task instance.\"\"\"\n    try:\n        out = main(grid)\n    except Exception:\n        return False\n    return out is not None\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = random.randint(*GRID_SIZE_RANGE)\n    W = random.randint(*GRID_SIZE_RANGE)\n    grid = np.full((H, W), BG, dtype=int)\n    for color in random.sample(FOREGROUND_COLORS, OBJECT_COUNT):\n        sprite = _sample_sprite(color)\n        if sprite is None or not _place_sprite(grid, sprite):\n            return None\n    if np.sum(grid == BG) / grid.size < MIN_BACKGROUND_FRACTION:\n        return None\n    return grid if _solver_accepts(grid) else None\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_RETRIES):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate input after {GENERATION_RETRIES} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/b25e450b.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, bbox_coords, components_mask\nimport random\n\nBBox = tuple[int, int, int, int]\n\n\ndef _edge_side(bbox: BBox, shape: tuple[int, int]) -> str:\n    r0, c0, r1, c1 = bbox\n    h, w = shape\n    sides = []\n    if r0 == 0:\n        sides.append(\"top\")\n    if r1 == h - 1:\n        sides.append(\"bottom\")\n    if c0 == 0:\n        sides.append(\"left\")\n    if c1 == w - 1:\n        sides.append(\"right\")\n    assert len(sides) == 1, \"each black rectangle must touch exactly one grid edge\"\n    return sides[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide each black border rectangle to the opposite border, recoloring its swept stripe orange and leaving the rectangle black at the far edge.\n\n    Input structure\n    - The grid contains black rectangular 4-connected masks, each touching exactly one outer border.\n    - Grey cells form incidental pattern content; orange is the trail color used when a black mask slides.\n\n    Rule\n    - Treat all black rectangles as moving simultaneously.\n    - A rectangle touching the top or bottom edge moves vertically to the opposite edge in the same columns.\n    - A rectangle touching the left or right edge moves horizontally to the opposite edge in the same rows.\n    - Recolor the complete swept row or column stripe to orange, then stamp every destination rectangle in black.\n\n    Key insight\n    - Edge contact gives the slide direction; the output is the set of opposite-edge black rectangles plus their orange trails.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    h, w = g.shape\n    assert h > 0 and w > 0\n\n    moving = Color.BLACK\n    trail = Color.ORANGE\n    assert np.any(g == moving), \"expected at least one black rectangle\"\n    assert np.any(g == trail), \"expected orange trail color to be present\"\n\n    out = g.copy()\n    targets: list[BBox] = []\n    for coords in components_mask(g == moving, connectivity=4):\n        r0, c0, r1, c1 = bbox_coords(coords)\n        rect_h = r1 - r0 + 1\n        rect_w = c1 - c0 + 1\n        assert int(coords.shape[0]) == rect_h * rect_w, \"black mask must be a solid rectangle\"\n\n        side = _edge_side((r0, c0, r1, c1), g.shape)\n        if side == \"top\":\n            out[:, c0 : c1 + 1] = trail\n            targets.append((h - rect_h, c0, h - 1, c1))\n        elif side == \"bottom\":\n            out[:, c0 : c1 + 1] = trail\n            targets.append((0, c0, rect_h - 1, c1))\n        elif side == \"left\":\n            out[r0 : r1 + 1, :] = trail\n            targets.append((r0, w - rect_w, r1, w - 1))\n        else:\n            assert side == \"right\"\n            out[r0 : r1 + 1, :] = trail\n            targets.append((r0, 0, r1, rect_w - 1))\n\n    for r0, c0, r1, c1 in targets:\n        out[r0 : r1 + 1, c0 : c1 + 1] = moving\n\n    return out\n\n# --------------- generator (att1) ---------------\n\n# Canvas and palette.\nMIN_H, MAX_H = 6, 18\nMIN_W, MAX_W = 8, 14\nBG_GREY, BG_ORANGE = 5, 7\nGREY_FRAC_MIN, GREY_FRAC_MAX = 0.2, 0.6\n\n# Rectangle and band constraints.\nMIN_RECTS, MAX_RECTS = 1, 8\nMIN_BAND_SIZE, MAX_BAND_SIZE = 1, 6\nBAND_GAP = 1\nMIN_RECT_AREA, MAX_RECT_AREA = 2, 18\nMAX_RECT_SIDE = 6\nSOURCE_EDGE_OFFSET = 1\n\n# Retry limits.\nTARGET_COUNT_ATTEMPTS = 300\nANY_COUNT_ATTEMPTS = 100\n\n\ndef _partition_bands(\n    total: int, n: int, min_size: int, max_size: int, min_gap: int = 0\n) -> list[tuple[int, int]] | None:\n    \"\"\"Place n non-overlapping inclusive bands inside [0, total - 1].\"\"\"\n    if n == 0:\n        return []\n\n    needed = n * min_size + (n - 1) * min_gap\n    if needed > total:\n        return None\n\n    effective_max = min(max_size, total - (n - 1) * (min_size + min_gap))\n    if effective_max < min_size:\n        return None\n\n    widths = [random.randint(min_size, effective_max) for _ in range(n)]\n    total_used = sum(widths) + (n - 1) * min_gap\n    if total_used > total:\n        excess = total_used - total\n        indices = list(range(n))\n        random.shuffle(indices)\n        for i in indices:\n            shrink = min(widths[i] - min_size, excess)\n            widths[i] -= shrink\n            excess -= shrink\n            if excess == 0:\n                break\n        if excess > 0:\n            return None\n\n    remaining = total - sum(widths) - (n - 1) * min_gap\n    extra_gaps = [0] * (n + 1)\n    for _ in range(remaining):\n        extra_gaps[random.randint(0, n)] += 1\n\n    bands = []\n    pos = 0\n    for i in range(n):\n        pos += extra_gaps[i]\n        if i > 0:\n            pos += min_gap\n        bands.append((pos, pos + widths[i] - 1))\n        pos += widths[i]\n    return bands\n\n\ndef _choose_orientation_counts(n_rects: int) -> tuple[int, int] | None:\n    max_vert = min(n_rects, (MAX_W - SOURCE_EDGE_OFFSET) // 2)\n    max_horiz = min(n_rects, (MAX_H - SOURCE_EDGE_OFFSET) // 2)\n    feasible = [(v, n_rects - v) for v in range(n_rects + 1)\n                if v <= max_vert and (n_rects - v) <= max_horiz]\n    if not feasible:\n        return None\n    return random.choice(feasible)\n\n\ndef _choose_canvas(n_vert: int, n_horiz: int) -> tuple[int, int] | None:\n    min_h = max(MIN_H, 2 * n_horiz + 1) if n_horiz > 0 else MIN_H\n    min_w = max(MIN_W, 2 * n_vert + 1) if n_vert > 0 else MIN_W\n    if min_h > MAX_H or min_w > MAX_W:\n        return None\n    return random.randint(min_h, MAX_H), random.randint(min_w, MAX_W)\n\n\ndef _interior_bands(total: int, n: int) -> list[tuple[int, int]] | None:\n    raw = _partition_bands(total - 2, n, MIN_BAND_SIZE, MAX_BAND_SIZE, BAND_GAP)\n    if raw is None:\n        return None\n    return [(a + SOURCE_EDGE_OFFSET, b + SOURCE_EDGE_OFFSET) for a, b in raw]\n\n\ndef _rect_span_for_band(band_size: int, travel: int) -> int | None:\n    max_len = min(MAX_RECT_SIDE, travel // 2 - 1, MAX_RECT_AREA // band_size)\n    min_len = max(MIN_BAND_SIZE, -(-MIN_RECT_AREA // band_size))\n    if min_len > max_len:\n        return None\n    return random.randint(min_len, max_len)\n\n\ndef _build_rects(H: int, W: int, n_vert: int, n_horiz: int) -> list[tuple[int, int, int, int, str]] | None:\n    \"\"\"Return destination rectangles plus their original source edge.\"\"\"\n    vert_edges = [random.choice([\"top\", \"bottom\"]) for _ in range(n_vert)]\n    horiz_edges = [random.choice([\"left\", \"right\"]) for _ in range(n_horiz)]\n\n    col_bands = _interior_bands(W, n_vert)\n    if col_bands is None:\n        return None\n    row_bands = _interior_bands(H, n_horiz)\n    if row_bands is None:\n        return None\n\n    rects = []\n    for i, (c0, c1) in enumerate(col_bands):\n        rect_w = c1 - c0 + 1\n        rect_h = _rect_span_for_band(rect_w, H)\n        if rect_h is None:\n            return None\n        se = vert_edges[i]\n        if se == \"top\":\n            dr0, dr1 = H - rect_h, H - 1\n        else:\n            dr0, dr1 = 0, rect_h - 1\n        rects.append((dr0, c0, dr1, c1, se))\n\n    for i, (r0, r1) in enumerate(row_bands):\n        rect_h = r1 - r0 + 1\n        rect_w = _rect_span_for_band(rect_h, W)\n        if rect_w is None:\n            return None\n        se = horiz_edges[i]\n        if se == \"left\":\n            dc0, dc1 = W - rect_w, W - 1\n        else:\n            dc0, dc1 = 0, rect_w - 1\n        rects.append((r0, dc0, r1, dc1, se))\n\n    return rects\n\n\ndef _random_background(shape: tuple[int, int], grey_frac: float) -> np.ndarray:\n    return np.where(np.random.random(shape) < grey_frac, BG_GREY, BG_ORANGE).astype(int)\n\n\ndef _render_output(H: int, W: int, rects: list[tuple[int, int, int, int, str]], grey_frac: float) -> np.ndarray:\n    output = _random_background((H, W), grey_frac)\n\n    for (dr0, dc0, dr1, dc1, se) in rects:\n        if se in (\"top\", \"bottom\"):\n            output[:, dc0:dc1 + 1] = BG_ORANGE\n        else:\n            output[dr0:dr1 + 1, :] = BG_ORANGE\n\n    for (dr0, dc0, dr1, dc1, _) in rects:\n        output[dr0:dr1 + 1, dc0:dc1 + 1] = 0\n    return output\n\n\ndef _invert_output_to_input(\n    output: np.ndarray, rects: list[tuple[int, int, int, int, str]], grey_frac: float\n) -> np.ndarray:\n    H, W = output.shape\n    inp = output.copy()\n\n    for (dr0, dc0, dr1, dc1, se) in rects:\n        if se in (\"top\", \"bottom\"):\n            inp[:, dc0:dc1 + 1] = _random_background((H, dc1 - dc0 + 1), grey_frac)\n        else:\n            inp[dr0:dr1 + 1, :] = _random_background((dr1 - dr0 + 1, W), grey_frac)\n\n    for (dr0, dc0, dr1, dc1, se) in rects:\n        rh, rw = dr1 - dr0 + 1, dc1 - dc0 + 1\n        if se == \"top\":\n            inp[0:rh, dc0:dc1 + 1] = 0\n        elif se == \"bottom\":\n            inp[H - rh:H, dc0:dc1 + 1] = 0\n        elif se == \"left\":\n            inp[dr0:dr1 + 1, 0:rw] = 0\n        else:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/825aa9e9.py\"","aggregated_output":"import math\nimport random\n\nimport numpy as np\n\nfrom arc_utils import colors_present, find_components, paste\n\n\ndef _blocked_mask(g: np.ndarray, obstacle: int) -> np.ndarray:\n    obstacle_mask = g == int(obstacle)\n    cushion = np.zeros_like(obstacle_mask, dtype=bool)\n    cushion[:-1, :] = obstacle_mask[1:, :]\n    bottom_edge = np.zeros_like(obstacle_mask, dtype=bool)\n    bottom_edge[-1, :] = True\n    return obstacle_mask | cushion | bottom_edge\n\n\ndef _assert_output_separated(out: np.ndarray, obstacle: int, moving: int) -> None:\n    obstacle_mask = out == int(obstacle)\n    near_obstacle = np.zeros_like(obstacle_mask, dtype=bool)\n    for dr in (-1, 0, 1):\n        for dc in (-1, 0, 1):\n            if dr == 0 and dc == 0:\n                continue\n\n            src_r0 = max(0, -dr)\n            src_r1 = out.shape[0] - max(0, dr)\n            src_c0 = max(0, -dc)\n            src_c1 = out.shape[1] - max(0, dc)\n            dst_r0 = max(0, dr)\n            dst_r1 = out.shape[0] - max(0, -dr)\n            dst_c0 = max(0, dc)\n            dst_c1 = out.shape[1] - max(0, -dc)\n            near_obstacle[dst_r0:dst_r1, dst_c0:dst_c1] |= obstacle_mask[\n                src_r0:src_r1, src_c0:src_c1\n            ]\n\n    assert not np.any((out == int(moving)) & near_obstacle), (\n        \"settled moving objects must not be 8-connected to obstacles\"\n    )\n\n\ndef _obstacle_column_heights(g: np.ndarray, obstacle: int) -> list[int]:\n    heights = []\n    obstacle_mask = g == int(obstacle)\n    H, W = map(int, g.shape)\n    for c in range(W):\n        rows = np.flatnonzero(obstacle_mask[:, c])\n        heights.append(0 if len(rows) == 0 else H - int(rows[0]))\n    return heights\n\n\ndef _assert_obstacle_profile(g: np.ndarray, obstacle: int) -> None:\n    heights = _obstacle_column_heights(g, obstacle)\n    occupied = [h for h in heights if h > 0]\n    assert occupied, \"obstacle must occupy at least one bottom-supported column\"\n\n    H, W = map(int, g.shape)\n    obstacle_mask = g == int(obstacle)\n    total = int(obstacle_mask.sum())\n    bottom3 = int(obstacle_mask[max(0, H - 3) :, :].sum())\n\n    assert len(occupied) * 3 >= W, \"obstacle must cover a substantial part of the bottom\"\n    assert sum(occupied) * 4 <= len(occupied) * 13, (\n        \"obstacle columns must be low on average\"\n    )\n    assert bottom3 * 5 >= total * 3, \"obstacle pixels must be mostly near the bottom\"\n\n\ndef _infer_roles(g: np.ndarray) -> tuple[int, int, int]:\n    colors = colors_present(g)\n    assert len(colors) == 3, \"expected background, obstacle, and moving colors\"\n\n    candidates = []\n    for bg in colors:\n        for obstacle in colors:\n            if obstacle == bg or not np.any(g[-1, :] == obstacle):\n                continue\n            for moving in colors:\n                if moving in (bg, obstacle) or np.any(g[-1, :] == moving):\n                    continue\n                blocked = _blocked_mask(g, obstacle)\n                if np.any(blocked & (g == moving)):\n                    continue\n                candidates.append((int(bg), int(obstacle), int(moving)))\n\n    assert len(candidates) == 1, \"roles must be uniquely determined\"\n    return candidates[0]\n\n\ndef _movable_components(out: np.ndarray, bg: int, moving: int, blocked: np.ndarray) -> list[tuple[np.ndarray, np.ndarray]]:\n    moving_mask = out == int(moving)\n    moves = []\n    for comp in find_components(out, bg=bg, connectivity=4, monochromatic=True, colors=[moving]):\n        coords = comp[\"coords\"]\n        shifted = coords + np.array([1, 0])\n        if int(shifted[:, 0].max()) >= int(out.shape[0]):\n            continue\n        if np.any(blocked[shifted[:, 0], shifted[:, 1]]):\n            continue\n\n        other_moving = moving_mask.copy()\n        other_moving[coords[:, 0], coords[:, 1]] = False\n        if np.any(other_moving[shifted[:, 0], shifted[:, 1]]):\n            continue\n        moves.append((coords, shifted))\n    return moves\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Drop the moving-color objects downward until they rest above a one-row cushion before the obstacle or bottom edge.\n\n    Input structure:\n    - The grid has exactly three colors: empty background, a stationary obstacle/floor color, and a moving object color.\n    - The obstacle color is the unique non-background role that touches the bottom edge.\n    - Moving pixels start outside the obstacle cells, outside the row directly above each obstacle pixel, and outside the bottom row.\n\n    Rule:\n    - Keep the background and obstacle pixels fixed.\n    - Treat obstacle pixels, cells directly above obstacle pixels, and the bottom row as blocked.\n    - Repeatedly move every 4-connected moving-color object one row down when its translated shape does not hit blocked cells or another moving object.\n\n    Key insight: The visible floor has an invisible one-row cushion above it, so the objects fall under gravity but stop with one empty row before the floor or the grid bottom.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg, obstacle, moving = _infer_roles(g)\n    _assert_obstacle_profile(g, obstacle)\n    blocked = _blocked_mask(g, obstacle)\n    assert not np.any(blocked & (g == moving)), \"moving pixels must start in free cells\"\n\n    out = g.copy()\n    while True:\n        moves = _movable_components(out, bg, moving, blocked)\n        if not moves:\n            break\n        for coords, _ in moves:\n            out[coords[:, 0], coords[:, 1]] = bg\n        for _, shifted in moves:\n            out[shifted[:, 0], shifted[:, 1]] = moving\n\n    _assert_output_separated(out, obstacle, moving)\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas bounds.\nGRID_H_RANGE = (4, 10)\nGRID_W_RANGE = (7, 20)\n\n# Obstacle profile constraints.\nOBSTACLE_COVERAGE_RANGE = (0.08, 0.52)\nPOCKET_COUNT_RANGE = (1, 5)\nDISTINCT_HEIGHT_COUNT_RANGE = (2, 4)\nOBSTACLE_COMPONENT_RANGE = (1, 3)\nBOTTOM_BAND_ROWS = 3\nBOTTOM_COLS_MIN_MULTIPLIER = 3\nCOLUMN_AVG_MAX_NUM = 13\nCOLUMN_AVG_MAX_DEN = 4\nBOTTOM3_MIN_NUM = 3\nBOTTOM3_MIN_DEN = 5\n\n# Bottom-heavy profile sampling.\nPROFILE_RETRIES = 120\nBOTTOM_HEAVY_WEIGHT = 5\nLOW_COLUMN_EXTRA_PROB = 0.35\nLOW_COLUMN_HEIGHT2_PROB = 0.25\nTALL_RUN_COUNT_MAX = 3\nTALL_RUN_WIDTH2_MIN_W = 10\nTALL_RUN_WIDTH2_PROB = 0.25\nMEDIUM_RUN_PROB = 0.45\nMEDIUM_RUN_WIDTH_MAX = 4\nSHORT_OBSTACLE_MAX_H = 4\nMEDIUM_RUN_HEIGHT_MIN = 2\n\n# Sparse post profile sampling.\nWIDTH_PLACEMENT_RETRIES = 80\nSPARSE_POST_MIN_BOTTOM_FRAC = 3\nSPARSE_POST_MAX_BOTTOM_FRAC = 0.45\nSPARSE_POST_RUN_COUNT_MAX = 3\nSPARSE_POST_HEIGHT1_PROB = 0.8\n\n# Moving object sampling and validation.\nPALETTE_SIZE = 10\nOBJECT_COUNT_RANGE = (1, 3)\nOBJECT_AREA_RANGE = (1, 21)\nOBJECT_BBOX_MAX_H = 6\nOBJECT_BBOX_MAX_W = 7\nMIN_LIFT_ROWS = 1\nMAX_LIFT_ROWS = 4\n\n# Whole-input retry budget.\nGENERATE_RETRIES = 300\n\n\ndef _spread_extra(widths, extra):\n    widths = list(widths)\n    for _ in range(int(extra)):\n        widths[random.randrange(len(widths))] += 1\n    return widths\n\n\ndef _blocked_from_heights(heights, H):\n    first = []\n    for h in heights:\n        first.append(H - 1 if h == H else max(0, h - 1))\n    return np.array(first, dtype=int)\n\n\ndef _pocket_count(heights):\n    min_h = min(heights)\n    count = 0\n    in_run = False\n    for h in heights:\n        if h > min_h:\n            if not in_run:\n                count += 1\n                in_run = True\n        else:\n            in_run = False\n    return count\n\n\ndef _placement_runs(heights, H):\n    \"\"\"Return constant-depth pocket runs as (left, right, first_blocked_row).\"\"\"\n    first_blocked = _blocked_from_heights(heights, H)\n    min_h = min(heights)\n    runs = []\n    start = None\n    depth = None\n    for c, h in enumerate(heights + [min_h]):\n        d = int(first_blocked[c]) if c < len(heights) else None\n        ok = c < len(heights) and h > min_h and d >= 2\n        if ok and start is None:\n            start = c\n            depth = d\n        elif ok and d == depth:\n            pass\n        else:\n            if start is not None:\n                runs.append((start, c - 1, int(depth)))\n                start = None\n            if ok:\n                start = c\n                depth = d\n    return runs\n\n\ndef _profile_is_valid(heights, H, W):\n    if heights is None or len(heights) != W:\n        return False\n    min_distinct, max_distinct = DISTINCT_HEIGHT_COUNT_RANGE\n    if not (min_distinct <= len(set(heights)) <= max_distinct):\n        return False\n    min_pockets, max_pockets = POCKET_COUNT_RANGE\n    if not (min_pockets <= _pocket_count(heights) <= max_pockets):\n        return False\n\n    area = sum(H - h for h in heights if h < H)\n    coverage = area / (H * W)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/df9fd884.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_w, colors_present, crop_bbox, find_components, get_bg, is_contiguous, paste\nimport itertools\nimport random\n\n\ndef _cells(component):\n    return set(map(tuple, component[\"coords\"]))\n\n\ndef _is_top_bracket(component) -> bool:\n    r0, c0, r1, c1 = component[\"bbox\"]\n    width = c1 - c0 + 1\n    if r0 != 0 or r1 - r0 + 1 != 2 or width < 3:\n        return False\n    expected = {(r0, c) for c in range(c0, c1 + 1)}\n    expected |= {(r1, c0), (r1, c1)}\n    return _cells(component) == expected\n\n\ndef _is_bottom_bracket(component, height: int) -> bool:\n    r0, c0, r1, c1 = component[\"bbox\"]\n    width = c1 - c0 + 1\n    if r1 != height - 1 or r1 - r0 + 1 != 2 or width < 3:\n        return False\n    expected = {(r1, c) for c in range(c0, c1 + 1)}\n    expected |= {(r0, c0), (r0, c1)}\n    return _cells(component) == expected\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Move the colored object from the lower bracket lane to the upper bracket lane and drop it to the bottom edge.\n\n    Input structure\n    - The background is the dominant color.\n    - One frame color forms exactly two 4-connected bracket objects: a top-edge bracket open downward and a bottom-edge bracket open upward.\n    - One other 4-connected foreground object sits in the lower bracket's interior column span.\n\n    Rule\n    - Remove the movable object from its original cells.\n    - Keep its shape and color unchanged.\n    - Paste it with its bbox columns aligned to the top bracket's interior columns and with its bbox bottom aligned to the grid bottom.\n\n    Key insight\n    - The lower bracket identifies the object's source lane; the upper bracket provides the target lane, and the final vertical placement is bottom-aligned.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    height, width = g.shape\n    bg = get_bg(g)\n\n    components_by_color = {}\n    bracket_candidates = []\n    for color in colors_present(g, exclude={bg}):\n        components = find_components(\n            g,\n            bg=bg,\n            colors=[color],\n            connectivity=4,\n            monochromatic=True,\n        )\n        components_by_color[color] = components\n        top = [component for component in components if _is_top_bracket(component)]\n        bottom = [\n            component for component in components\n            if _is_bottom_bracket(component, height)\n        ]\n        if len(components) == 2 and len(top) == 1 and len(bottom) == 1:\n            bracket_candidates.append((color, top[0], bottom[0]))\n\n    assert len(bracket_candidates) == 1\n    frame_color, top_bracket, bottom_bracket = bracket_candidates[0]\n\n    movers = [\n        component\n        for color, components in components_by_color.items()\n        if color != frame_color\n        for component in components\n    ]\n    assert len(movers) == 1\n    mover = movers[0]\n\n    _, mc0, _, mc1 = mover[\"bbox\"]\n    _br0, bc0, _br1, bc1 = bottom_bracket[\"bbox\"]\n    _tr0, tc0, _tr1, tc1 = top_bracket[\"bbox\"]\n    assert (mc0, mc1) == (bc0 + 1, bc1 - 1)\n    assert bbox_w(mover[\"bbox\"]) == tc1 - tc0 - 1\n\n    patch = crop_bbox(g, mover[\"bbox\"])\n    dest_r = height - patch.shape[0]\n    dest_c = tc0 + 1\n    assert dest_r >= 0\n    assert dest_c >= 0 and dest_c + patch.shape[1] <= width\n\n    out = g.copy()\n    mover_coords = mover[\"coords\"]\n    out[mover_coords[:, 0], mover_coords[:, 1]] = bg\n\n    colored_patch = patch != bg\n    target = out[dest_r:dest_r + patch.shape[0], dest_c:dest_c + patch.shape[1]]\n    assert np.all(target[colored_patch] == bg)\n\n    paste(out, patch, dest_r, dest_c, transparent=bg)\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Fixed task colors.\nBG_COLOR, BRACKET_COLOR = 7, 4\nMOVER_COLORS = [0, 1, 2, 3, 5, 6, 8, 9]\n# Canvas, bracket, and mover-size bounds.\nGRID_SIZE_RANGE = (8, 9)\nBRACKET_WIDTH_RANGE = (3, 4)\nMOVER_HEIGHT_RANGE = (1, 3)\nMOVER_MAX_CELLS = 4\nMOVER_MIN_DENSITY_NUM = 2\nMOVER_MIN_DENSITY_DEN = 3\n# Layout choices and retry budget.\nTOP_LEFT_OPTIONS = [True, False]\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _gen_half_starts(grid_width, bracket_width, left_side):\n    if left_side:\n        return list(range(0, grid_width // 2 - bracket_width + 1))\n    return list(range((grid_width + 1) // 2, grid_width - bracket_width + 1))\n\ndef _gen_bracket_columns(grid_width, bracket_width):\n    \"\"\"Choose non-overlapping top/bottom bracket starts on opposite halves.\"\"\"\n    top_left = random.choice(TOP_LEFT_OPTIONS)\n    top_starts = _gen_half_starts(grid_width, bracket_width, top_left)\n    bottom_starts = _gen_half_starts(grid_width, bracket_width, not top_left)\n    if not top_starts or not bottom_starts:\n        return None\n    return random.choice(top_starts), random.choice(bottom_starts)\n\ndef _gen_add_bracket(grid, c0, width, top_edge):\n    edge_row, arm_row = (0, 1) if top_edge else (-1, -2)\n    grid[edge_row, c0:c0 + width] = BRACKET_COLOR\n    grid[arm_row, c0] = BRACKET_COLOR\n    grid[arm_row, c0 + width - 1] = BRACKET_COLOR\n\ndef _gen_sprite_masks(height, width):\n    area = height * width\n    min_cells = (MOVER_MIN_DENSITY_NUM * area + MOVER_MIN_DENSITY_DEN - 1) // MOVER_MIN_DENSITY_DEN\n    max_cells = min(MOVER_MAX_CELLS, area)\n    masks = []\n    for cell_count in range(min_cells, max_cells + 1):\n        for cells in itertools.combinations(range(area), cell_count):\n            mask = np.zeros((height, width), dtype=bool)\n            mask[np.unravel_index(cells, (height, width))] = True\n            if not mask.any(axis=0).all() or not mask.any(axis=1).all():\n                continue\n            if is_contiguous(mask.astype(int), background=0, connectivity=4):\n                masks.append(mask)\n    return masks\n\ndef _gen_mover_sprite(height, width, color, bg):\n    masks = _gen_sprite_masks(height, width)\n    if not masks:\n        return None\n    mask = random.choice(masks)\n    sprite = np.full((height, width), bg, dtype=int)\n    sprite[mask] = color\n    return sprite\n\ndef _gen_paste_if_clear(grid, sprite, row, col, sprite_mask):\n    \"\"\"Paste sprite only when every colored sprite cell lands on background.\"\"\"\n    target = grid[row:row + sprite.shape[0], col:col + sprite.shape[1]]\n    if not np.all(target[sprite_mask] == BG_COLOR):\n        return False\n    paste(grid, sprite, row, col, transparent=BG_COLOR)\n    return True\n\ndef _gen_attempt():\n    height = random.randint(*GRID_SIZE_RANGE)\n    grid_width = random.randint(*GRID_SIZE_RANGE)\n    bracket_width = random.randint(*BRACKET_WIDTH_RANGE)\n    interior_width = bracket_width - 2\n\n    bracket_columns = _gen_bracket_columns(grid_width, bracket_width)\n    if bracket_columns is None:\n        return None\n    top_c0, bottom_c0 = bracket_columns\n\n    mover_height = random.randint(*MOVER_HEIGHT_RANGE)\n    mover_color = random.choice(MOVER_COLORS)\n    sprite = _gen_mover_sprite(mover_height, interior_width, mover_color, BG_COLOR)\n    if sprite is None:\n        return None\n\n    out = np.full((height, grid_width), BG_COLOR, dtype=int)\n    _gen_add_bracket(out, top_c0, bracket_width, top_edge=True)\n    _gen_add_bracket(out, bottom_c0, bracket_width, top_edge=False)\n\n    dest_r = height - mover_height\n    dest_c = top_c0 + 1\n    sprite_mask = sprite != BG_COLOR\n    if not _gen_paste_if_clear(out, sprite, dest_r, dest_c, sprite_mask):\n        return None\n\n    inp = out.copy()\n    target = inp[dest_r:dest_r + mover_height, dest_c:dest_c + interior_width]\n    target[sprite_mask] = BG_COLOR\n\n    source_c = bottom_c0 + 1\n    max_source_r = height - 2 - mover_height\n    if max_source_r < 1:\n        return None\n    source_r = random.randint(1, max_source_r)\n    if not _gen_paste_if_clear(inp, sprite, source_r, source_c, sprite_mask):\n        return None\n\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\ndef generate_input():\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate df9fd884 input\")\n","exit_code":0,"status":"completed"}}
