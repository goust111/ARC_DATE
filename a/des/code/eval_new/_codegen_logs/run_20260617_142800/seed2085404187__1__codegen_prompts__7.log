{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' /home/lixinyu/snap/new/ARC_code/train/6350f1f4.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, colors_present, components_mask\nimport math\nimport random\n\n\nERASED = Color.GREY\nSEPARATOR = Color.BLACK\n\n\ndef _is_separator_line(line: np.ndarray) -> bool:\n    return set(map(int, line)).issubset({SEPARATOR, ERASED})\n\n\ndef _regular_intervals(separators: list[int], length: int) -> list[tuple[int, int]]:\n    assert separators, \"expected at least one separator line\"\n    bounds = [-1, *separators, int(length)]\n    intervals = [(bounds[i] + 1, bounds[i + 1]) for i in range(len(bounds) - 1)]\n    sizes = [end - start for start, end in intervals]\n    assert min(sizes) > 0, \"separators must leave non-empty blocks\"\n    assert len(set(sizes)) == 1, \"all encoded blocks must have the same size\"\n    return intervals\n\n\ndef _find_sprite(\n    g: np.ndarray,\n    row_intervals: list[tuple[int, int]],\n    col_intervals: list[tuple[int, int]],\n    payload_colors: list[int],\n) -> np.ndarray:\n    payload = set(payload_colors)\n    sprites = []\n\n    for r0, r1 in row_intervals:\n        for c0, c1 in col_intervals:\n            block = g[r0:r1, c0:c1]\n            block_colors = set(colors_present(block, exclude={ERASED}))\n            assert SEPARATOR not in block_colors, \"block interiors cannot contain separator color\"\n            if ERASED not in set(map(int, block.flat)) and block_colors == payload:\n                sprites.append(block.copy())\n\n    assert sprites, \"expected at least one fully visible sprite block\"\n    sprite = sprites[0]\n    for candidate in sprites:\n        assert np.array_equal(candidate, sprite), \"fully visible sprite blocks must match\"\n    return sprite\n\n\ndef _foreground_and_blank(sprite: np.ndarray, payload_colors: list[int]) -> tuple[int, int]:\n    counts = {color: int(np.count_nonzero(sprite == color)) for color in payload_colors}\n    assert counts[payload_colors[0]] != counts[payload_colors[1]], \"sprite colors must have a majority/minority split\"\n    foreground = max(payload_colors, key=lambda color: counts[color])\n    blank_colors = [color for color in payload_colors if color != foreground]\n    assert len(blank_colors) == 1\n    return int(foreground), int(blank_colors[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Decode a block-grid image by swapping each sprite-coded cell with a solid cell and each blank cell with the sprite.\n\n    Input structure\n    The grid is partitioned by black separator rows and columns into equal-size\n    square blocks. Each block is either a copy of one two-color sprite or a\n    uniform blank block of the sprite's minority color; grey pixels are erased\n    cells that act as wildcards.\n\n    Rule\n    Infer the repeated sprite from fully visible mixed-color blocks. Replace a\n    block matching that sprite, ignoring grey erasures, with a solid block of\n    the sprite's majority color. Replace a uniform blank block with the sprite.\n    Separator rows and columns, including grey erasures on them, become black.\n\n    Key insight\n    The small sprite is a block-level code for one macro-cell state, and the\n    uniform minority-color block is the other state; the output renders the\n    opposite code in each macro-cell while cleaning erased pixels.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H, W = g.shape\n\n    row_separators = [r for r in range(H) if _is_separator_line(g[r, :])]\n    col_separators = [c for c in range(W) if _is_separator_line(g[:, c])]\n    row_intervals = _regular_intervals(row_separators, H)\n    col_intervals = _regular_intervals(col_separators, W)\n    block_heights = {r1 - r0 for r0, r1 in row_intervals}\n    block_widths = {c1 - c0 for c0, c1 in col_intervals}\n    assert block_heights == block_widths, \"encoded blocks must be square\"\n\n    payload_colors = colors_present(g, exclude={SEPARATOR, ERASED})\n    assert len(payload_colors) == 2, \"expected exactly two non-separator payload colors\"\n    sprite = _find_sprite(g, row_intervals, col_intervals, payload_colors)\n    foreground, blank = _foreground_and_blank(sprite, payload_colors)\n\n    out = np.zeros_like(g)\n    for r0, r1 in row_intervals:\n        for c0, c1 in col_intervals:\n            block = g[r0:r1, c0:c1]\n            known = block != ERASED\n            assert known.any(), \"each block must expose at least one non-grey cell\"\n            matches_sprite = bool(np.all(block[known] == sprite[known]))\n            matches_blank = bool(np.all(block[known] == blank))\n            assert matches_sprite != matches_blank, \"each block must unambiguously match the sprite or blank state\"\n            out[r0:r1, c0:c1] = foreground if matches_sprite else sprite\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Canvas and palette bounds.\nGRID_COUNT_RANGE, BLOCK_SIZE_RANGE = (2, 4), (2, 4)\nPAYLOAD_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]\nPAYLOAD_COLOR_COUNT = 2\nGEN_SEPARATOR_COLOR, GEN_ERASED_COLOR = int(SEPARATOR), int(ERASED)\n\n# Sprite composition constraints.\nSPRITE_FG_MIN_RATIO, SPRITE_FG_MAX_RATIO = (2, 3), (3, 4)\nSPRITE_ATTEMPTS, TINY_BLOCK_SIZE = 80, 2\n\n# Macro-cell state constraints.\nMIN_BLANK_BLOCKS, MAX_BLANK_BLOCK_DENOMINATOR = 1, 2\n\n# Grey overlay constraints.\nGREY_MIN_FRACTION, GREY_MAX_FRACTION = 0.05, 0.25\nGREY_TWO_COMPONENT_PROBABILITY, GREY_TWO_COMPONENT_ATTEMPTS = 0.5, 30\nGREY_CONNECTIVITY, GENERATION_ATTEMPTS = 4, 300\n\nNEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _separator_indices(n: int, block_size: int) -> set[int]:\n    return {(i + 1) * block_size + i for i in range(n - 1)}\n\n\ndef _block_origin(br: int, bc: int, block_size: int) -> tuple[int, int]:\n    return br * (block_size + 1), bc * (block_size + 1)\n\n\ndef _has_symmetry(mask: np.ndarray) -> bool:\n    return (\n        np.array_equal(mask, np.fliplr(mask))\n        or np.array_equal(mask, np.flipud(mask))\n        or np.array_equal(mask, np.rot90(mask, 2))\n    )\n\n\ndef _make_sprite(block_size: int, foreground: int, blank: int) -> np.ndarray | None:\n    area = block_size * block_size\n    min_num, min_den = SPRITE_FG_MIN_RATIO\n    max_num, max_den = SPRITE_FG_MAX_RATIO\n    fg_min = math.ceil(area * min_num / min_den)\n    fg_max = math.floor(area * max_num / max_den)\n    if fg_min > fg_max:\n        fg_min = fg_max = round(area * min_num / min_den)\n    fg_count = random.randint(fg_min, fg_max)\n    blank_count = area - fg_count\n\n    for _ in range(SPRITE_ATTEMPTS):\n        mask = np.ones((block_size, block_size), dtype=bool)\n        if block_size == TINY_BLOCK_SIZE:\n            blanks = [random.randrange(area)]\n        else:\n            cols = list(range(block_size))\n            random.shuffle(cols)\n            blanks = [r * block_size + cols[r] for r in range(block_size)]\n            extra = blank_count - block_size\n            if extra > 0:\n                pool = [i for i in range(area) if i not in blanks]\n                blanks.extend(random.sample(pool, extra))\n\n        for idx in blanks:\n            mask[idx // block_size, idx % block_size] = False\n\n        if block_size > TINY_BLOCK_SIZE:\n            row_mixed = all(0 < np.count_nonzero(mask[r]) < block_size for r in range(block_size))\n            col_mixed = all(0 < np.count_nonzero(mask[:, c]) < block_size for c in range(block_size))\n            if not row_mixed or not col_mixed:\n                continue\n        if _has_symmetry(mask):\n            continue\n\n        sprite = np.where(mask, foreground, blank).astype(int)\n        return sprite\n    return None\n\n\ndef _neighbors4(r: int, c: int, height: int, width: int):\n    for dr, dc in NEIGHBOR_OFFSETS_4:\n        nr, nc = r + dr, c + dc\n        if 0 <= nr < height and 0 <= nc < width:\n            yield nr, nc\n\n\ndef _grow_blob(allowed: np.ndarray, size: int) -> set[tuple[int, int]] | None:\n    comps = [\n        [tuple(map(int, rc)) for rc in coords]\n        for coords in components_mask(allowed, connectivity=GREY_CONNECTIVITY)\n        if len(coords) >= size\n    ]\n    if not comps:\n        return None\n\n    comp = random.choice(comps)\n    comp_set = set(comp)\n    seed = random.choice(comp)\n    blob = {seed}\n    frontier = {nb for nb in _neighbors4(*seed, *allowed.shape) if nb in comp_set}\n\n    while len(blob) < size:\n        if not frontier:\n            return None\n        cell = random.choice(tuple(frontier))\n        frontier.remove(cell)\n        blob.add(cell)\n        for nb in _neighbors4(*cell, *allowed.shape):\n            if nb in comp_set and nb not in blob:\n                frontier.add(nb)\n\n    return blob\n\n\ndef _make_grey_mask(allowed: np.ndarray, target: int) -> np.ndarray | None:\n    if target <= 0:\n        return np.zeros_like(allowed, dtype=bool)\n\n    want_two = target >= 2 and random.random() < GREY_TWO_COMPONENT_PROBABILITY\n    if want_two:\n        for _ in range(GREY_TWO_COMPONENT_ATTEMPTS):\n            first_size = random.randint(1, target - 1)\n            first = _grow_blob(allowed, first_size)\n            if first is None:\n                continue\n\n            blocked = set(first)\n            for r, c in tuple(first):\n                blocked.update(_neighbors4(r, c, *allowed.shape))\n\n            allowed_second = allowed.copy()\n            for r, c in blocked:\n                allowed_second[r, c] = False\n\n            second = _grow_blob(allowed_second, target - first_size)\n            if second is None:\n                continue\n\n            mask = np.zeros_like(allowed, dtype=bool)\n            for r, c in first | second:\n                mask[r, c] = True\n            return mask\n\n    one = _grow_blob(allowed, target)\n    if one is None:\n        return None\n\n    mask = np.zeros_like(allowed, dtype=bool)\n    for r, c in one:\n        mask[r, c] = True\n    return mask\n\n\ndef _sample_block_states(n: int) -> tuple[np.ndarray, int]:\n    block_count = n * n\n    max_blanks = max(MIN_BLANK_BLOCKS, block_count // MAX_BLANK_BLOCK_DENOMINATOR)\n    blank_blocks = random.randint(MIN_BLANK_BLOCKS, max_blanks)\n    state = np.ones((n, n), dtype=bool)\n    for idx in random.sample(range(block_count), blank_blocks):\n        state[idx // n, idx % n] = False\n    return state, blank_blocks\n\n\ndef _render_clean_grids(n, block_size, side, state, sprite, foreground, blank) -> tuple[np.ndarray, np.ndarray]:\n    out = np.full((side, side), GEN_SEPARATOR_COLOR, dtype=int)\n    inp = np.full((side, side), GEN_SEPARATOR_COLOR, dtype=int)\n    for br in range(n):\n        for bc in range(n):\n            r0, c0 = _block_origin(br, bc, block_size)\n            if state[br, bc]:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' /home/lixinyu/snap/new/ARC_code/eval/a32d8b75.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, neighbors4, random_sprite\nfrom scipy.ndimage import label as _scipy_label\nimport random\n\n\ndef _find_border6_square_start(legend: np.ndarray) -> tuple[int, int] | None:\n    h, w = legend.shape\n    if h < 5 or w < 5:\n        return None\n    for r0 in range(h - 4):\n        for c0 in range(w - 4):\n            sub = legend[r0 : r0 + 5, c0 : c0 + 5]\n            if np.all(sub[0, :] == 6) and np.all(sub[4, :] == 6) and np.all(sub[:, 0] == 6) and np.all(sub[:, 4] == 6):\n                return int(r0), int(c0)\n    return None\n\n\ndef _find_marker_panel_square(g: np.ndarray, sep_c1: int) -> tuple[int, int] | None:\n    \"\"\"\n    Find the 5x5 border-6 position-marker square that belongs to the 8x5 marker panel.\n\n    In some instances the marker panel can appear inside the main canvas as well as in the\n    left legend region. Prefer a candidate that lies in the main canvas (col > sep_c1) if any.\n    \"\"\"\n    h, w = g.shape\n    candidates: list[tuple[int, int]] = []\n    for r0 in range(h - 7):\n        for c0 in range(w - 4):\n            sub = g[r0 : r0 + 5, c0 : c0 + 5]\n            if not (np.all(sub[0, :] == 6) and np.all(sub[4, :] == 6) and np.all(sub[:, 0] == 6) and np.all(sub[:, 4] == 6)):\n                continue\n            # Must contain a position marker inside (non-{0,6}) and a rotation mark below.\n            inner = sub[1:4, 1:4]\n            if not np.any((inner != 0) & (inner != 6)):\n                continue\n            rot = g[r0 + 5 : r0 + 8, c0 + 1 : c0 + 4]\n            if rot.shape != (3, 3) or not np.any((rot != 0) & (rot != 6)):\n                continue\n            candidates.append((r0, c0))\n    if not candidates:\n        return None\n    main_cands = [rc for rc in candidates if rc[1] > sep_c1]\n    return min(main_cands) if main_cands else min(candidates)\n\n\ndef _separator_runs(g: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Return contiguous runs of full-height columns that are all color 6.\"\"\"\n    h, w = g.shape\n    cols6 = [c for c in range(w) if np.all(g[:, c] == 6)]\n    if not cols6:\n        return []\n    cols6.sort()\n    runs: list[tuple[int, int]] = []\n    s = e = cols6[0]\n    for c in cols6[1:]:\n        if c == e + 1:\n            e = c\n        else:\n            runs.append((s, e))\n            s = e = c\n    runs.append((s, e))\n    return runs\n\n\ndef _split_canvas(g: np.ndarray) -> tuple[tuple[int, int], tuple[int, int] | None]:\n    \"\"\"\n    Identify a left separator run (between left legend and canvas), and optionally a\n    right separator run (between canvas and a right-side legend panel).\n    \"\"\"\n    h, w = g.shape\n    runs = _separator_runs(g)\n    assert runs, \"must have at least one color-6 separator run\"\n    left = runs[0]\n    # Prefer a right separator run very near the right edge (a right legend panel).\n    right: tuple[int, int] | None = None\n    for s, e in reversed(runs[1:]):\n        if s >= w - 10 and s > left[1] + 1:\n            right = (s, e)\n            break\n    return left, right\n\n\ndef _find_marker_square_with_preferences(\n    g: np.ndarray, left_sep: tuple[int, int], right_sep: tuple[int, int] | None\n) -> tuple[int, int] | None:\n    \"\"\"\n    Find the marker panel's 5x5 border-6 square.\n\n    Preference order:\n      1) left legend region (at/before left separator)\n      2) right legend region (at/after right separator), if present\n      3) anywhere (including inside the output canvas)\n    \"\"\"\n    h, w = g.shape\n    candidates: list[tuple[int, int]] = []\n    for r0 in range(h - 7):\n        for c0 in range(w - 4):\n            sub = g[r0 : r0 + 5, c0 : c0 + 5]\n            if not (np.all(sub[0, :] == 6) and np.all(sub[4, :] == 6) and np.all(sub[:, 0] == 6) and np.all(sub[:, 4] == 6)):\n                continue\n            inner = sub[1:4, 1:4]\n            if not np.any((inner != 0) & (inner != 6)):\n                continue\n            rot = g[r0 + 5 : r0 + 8, c0 + 1 : c0 + 4]\n            if rot.shape != (3, 3) or not np.any((rot != 0) & (rot != 6)):\n                continue\n            candidates.append((r0, c0))\n    if not candidates:\n        return None\n    left_end = left_sep[1]\n    left_cands = [rc for rc in candidates if rc[1] + 2 <= left_end]\n    if left_cands:\n        return min(left_cands)\n    if right_sep is not None:\n        right_start = right_sep[0]\n        right_cands = [rc for rc in candidates if rc[1] + 2 >= right_start]\n        if right_cands:\n            return min(right_cands)\n    return min(candidates)\n\n\ndef _all_marker_panel_squares(g: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"List all 5x5 border-6 squares that look like the top of an 8x5 marker panel.\"\"\"\n    h, w = g.shape\n    out: list[tuple[int, int]] = []\n    for r0 in range(h - 7):\n        for c0 in range(w - 4):\n            sub = g[r0 : r0 + 5, c0 : c0 + 5]\n            if not (np.all(sub[0, :] == 6) and np.all(sub[4, :] == 6) and np.all(sub[:, 0] == 6) and np.all(sub[:, 4] == 6)):\n                continue\n            inner = sub[1:4, 1:4]\n            if not np.any((inner != 0) & (inner != 6)):\n                continue\n            rot = g[r0 + 5 : r0 + 8, c0 + 1 : c0 + 4]\n            if rot.shape != (3, 3) or not np.any((rot != 0) & (rot != 6)):\n                continue\n            out.append((int(r0), int(c0)))\n    out.sort()\n    return out\n\n\ndef _extract_unit_sprite(legend: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]] | None:\n    # Unit sprite is the top-most 4-connected component of pixels not in {0,6}.\n    mask = (legend != 0) & (legend != 6)\n    pts_all = np.argwhere(mask)\n    if pts_all.size == 0:\n        return None\n    rmin = int(pts_all[:, 0].min())\n    # choose left-most on that row to seed\n    cseed = int(np.argwhere(mask[rmin, :])[0, 0])\n    # BFS from seed to get component\n    h, w = legend.shape\n    vis = np.zeros((h, w), dtype=bool)\n    st = [(rmin, cseed)]\n    vis[rmin, cseed] = True\n    pts: list[tuple[int, int]] = []\n    while st:\n        r, c = st.pop()\n        pts.append((r, c))\n        for rr, cc in neighbors4(r, c):\n            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not vis[rr, cc]:\n                vis[rr, cc] = True\n                st.append((rr, cc))\n    r0, c0, r1, c1 = bbox_coords(np.asarray(pts))\n    spr = legend[r0 : r1 + 1, c0 : c1 + 1].copy()\n    # Unit sprite uses two colors; the rendered sprite is the color-swapped version.\n    cols = sorted({int(x) for x in np.unique(spr) if int(x) not in (0, 6)})\n    if len(cols) == 2:\n        a, b = cols\n        spr2 = spr.copy()\n        spr2[spr == a] = -1\n        spr2[spr == b] = a\n        spr2[spr2 == -1] = b\n        spr = spr2\n    return spr, (r0, c0, r1, c1)\n\n\ndef _extract_frame_bbox(legend: np.ndarray, unit_bb: tuple[int, int, int, int], border6_r0: int) -> tuple[int, int, int, int] | None:\n    # Frame pixels live between the unit sprite and the border6 square.\n    r_start = unit_bb[2] + 1\n    r_end = border6_r0 - 1\n    if r_start > r_end:\n        return None\n    sub = legend[r_start : r_end + 1, :]\n    mask = (sub != 0) & (sub != 6)\n    pts = np.argwhere(mask)\n    if pts.size == 0:\n        return None\n    pts[:, 0] += r_start\n    r0 = int(pts[:, 0].min())\n    r1 = int(pts[:, 0].max())\n    c0 = int(pts[:, 1].min())\n    c1 = int(pts[:, 1].max())\n    return (r0, c0, r1, c1)\n\n\ndef _position_indices_from_border_square(legend: np.ndarray, border6_r0: int, border6_c0: int) -> tuple[int, int] | None:\n    sq = legend[border6_r0 : border6_r0 + 5, border6_c0 : border6_c0 + 5]\n    inner = sq[1:4, 1:4]\n    pts = np.argwhere((inner != 0) & (inner != 6))\n    if pts.size == 0:\n        return None\n    # If multiple, take the first (should be unique)\n    r, c = int(pts[0, 0]), int(pts[0, 1])\n    return r, c  # 0..2\n\n\ndef _rotation_from_clockhand(legend: np.ndarray, border6_r0: int, border6_c0: int) -> int:\n    \"\"\"\n    Rotation marker is in the bottom 3x3 at rows (border6_r0+5 .. border6_r0+7) and cols (1..3),\n    drawn with non-{0,6} pixels (typically 7). Use the furthest pixel from the center (1,1)\n    to determine direction:\n      up -> 0, right -> 1, down -> 2, left -> 3.\n    \"\"\"\n    h, w = legend.shape\n    r0 = border6_r0 + 5\n    c0 = border6_c0 + 1\n    assert r0 + 2 < h and c0 + 2 < w, \"rotation marker patch out of bounds\"\n    sub = legend[r0 : r0 + 3, c0 : c0 + 3]\n    pts = np.argwhere((sub != 0) & (sub != 6))\n    assert pts.size > 0, \"no rotation marker pixel found\"\n    center = np.array([1, 1], dtype=int)\n    # pick furthest (Manhattan) from center\n    dists = np.abs(pts - center).sum(axis=1)\n    p = pts[int(dists.argmax())]\n    dr, dc = int(p[0] - center[0]), int(p[1] - center[1])\n    if abs(dr) >= abs(dc):\n        if dr < 0:\n            return 0\n        if dr > 0:\n            return 2\n    else:\n        if dc > 0:\n            return 1\n        if dc < 0:\n            return 3\n    raise AssertionError(\"rotation marker pixel at center, direction ambiguous\")\n\n\ndef _anchor_to_top_left(anchor_idx: int, size: int, place_size: int) -> int:\n    \"\"\"\n    anchor_idx in {0,1,2} selects position on a length:\n      0 -> start, 1 -> middle, 2 -> end\n    Returns the top-left coordinate so that the corresponding point of the placed object\n    aligns with that point on the canvas.\n    \"\"\"\n    if anchor_idx <= 0:\n        canvas_anchor = 0\n        obj_anchor = 0\n    elif anchor_idx >= 2:\n        canvas_anchor = max(0, size - 1)\n        obj_anchor = max(0, place_size - 1)\n    else:\n        canvas_anchor = (size - 1) // 2 if size > 1 else 0\n        obj_anchor = (place_size - 1) // 2 if place_size > 1 else 0\n    return canvas_anchor - obj_anchor\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble and place enlarged sprites on a canvas using legend-panel instructions.\n\n    Input structure:\n    - Color-6 separators divide the grid into a left legend column and a main canvas.\n    - Each legend panel has (top to bottom): a unit sprite, a frame template, a 5x5 bordered square with a position-marker pixel, and a 3x3 rotation clock-hand.\n\n    Rule:\n    - Tile the unit sprite into each active cell of the frame to build an enlarged composite.\n    - Rotate the composite per the clock-hand direction (up=0, right=90, down=180, left=270 degrees).\n    - Place it on the canvas anchored at the position encoded by the marker pixel's row/col in the bordered square's 3x3 inner grid.\n\n    Key insight: The marker pixel's position in a 3x3 grid jointly encodes vertical and horizontal anchor alignment (start/middle/end).\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    assert w >= 2, \"grid width must be >= 2\"\n\n    # Output canvas is the region between the left separator run and (optionally) a\n    # right-side separator run near the far edge (right legend panel).\n    left_sep, right_sep = _split_canvas(g)\n    left_sep_c1 = left_sep[1]\n    canvas_c0 = left_sep_c1 + 1\n    canvas_c1 = right_sep[0] if right_sep is not None else w\n    main = g[:, canvas_c0:canvas_c1].copy()\n\n    # Paint one constructed sprite per marker panel that lies outside the output canvas.\n    marker_squares = _all_marker_panel_squares(g)\n    assert marker_squares, \"no marker panel found\"\n\n    # Anchor alignment (ignore internal full-height/full-width 6 separators inside main).\n    eff_h, eff_w = main.shape\n    full6_cols = [c for c in range(eff_w) if np.all(main[:, c] == 6)]\n    if full6_cols:\n        eff_w = min(full6_cols)\n    full6_rows = [r for r in range(eff_h) if np.all(main[r, :] == 6)]\n    if full6_rows:\n        eff_h = min(full6_rows)\n\n    out = main.copy()\n    composite_written = np.zeros(out.shape, dtype=bool)\n\n    for marker_r0, marker_c0 in marker_squares:\n        # Ignore marker panels inside the output canvas; only legends should drive drawing.\n        if canvas_c0 <= marker_c0 < canvas_c1:\n            continue\n\n        if marker_c0 + 5 > w:\n            continue\n        panel = g[:, marker_c0 : marker_c0 + 5]\n\n        unit = _extract_unit_sprite(panel)\n        if unit is None:\n            continue\n        unit_sprite, unit_bb = unit\n\n        frame_bb = _extract_frame_bbox(panel, unit_bb, marker_r0)\n        if frame_bb is None:\n            continue\n","exit_code":0,"status":"completed"}}
