{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nimport numpy as np\nfrom collections import Counter\n\np = Path('/home/lixinyu/snap/a/des/code/eval_new/seed2085404187/2/6.py')\nmod = SourceFileLoader('new_arc_task_stats', str(p)).load_module()\nrot_counts = Counter()\nfor _ in range(80):\n    g = mod.generate_input()\n    frames = {}\n    frame_cells = np.zeros_like(g, dtype=bool)\n    anchors_used = np.zeros_like(g, dtype=bool)\n    for color in sorted(int(v) for v in np.unique(g) if int(v) not in {mod.BG, mod.MAGENTA}):\n        for coords in mod._components(g == color):\n            r0, c0, r1, c1 = mod._bbox(coords)\n            local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)\n            local[coords[:, 0] - r0, coords[:, 1] - c0] = True\n            if not mod._is_rect_frame(local):\n                continue\n            inner = g[r0 + 1 : r1, c0 + 1 : c1]\n            anchor_rel = np.argwhere(inner == mod.MAGENTA)\n            if anchor_rel.shape[0] \"'!= 1:\n                continue\n            anchor = (int(anchor_rel[0, 0] + r0 + 1), int(anchor_rel[0, 1] + c0 + 1))\n            frames[color] = {'\"'interior': (r0 + 1, c0 + 1, r1 - 1, c1 - 1), 'anchor': anchor}\n            frame_cells[coords[:, 0], coords[:, 1]] = True\n            anchors_used[anchor] = True\n    temp = g.copy()\n    temp[frame_cells] = mod.BG\n    temp[anchors_used] = mod.BG\n    stamps = {}\n    for coords in mod._components(temp \"'!= mod.BG):\n        vals = sorted(int(v) for v in np.unique(temp[coords[:, 0], coords[:, 1]]))\n        color = next(v for v in vals if v != mod.MAGENTA)\n        handle_coords = coords[temp[coords[:, 0], coords[:, 1]] == mod.MAGENTA]\n        hr, hc = int(handle_coords[0, 0]), int(handle_coords[0, 1])\n        stamps[color] = [(int(r - hr), int(c - hc)) for r, c in coords]\n    for color, offsets in stamps.items():\n        ir0, ic0, ir1, ic1 = frames[color]['\"'interior']\n        ar, ac = frames[color]['anchor']\n        fits = []\n        for turns in range(4):\n            ok = True\n            for dr, dc in mod._rotate_offsets(offsets, turns):\n                rr = ar + dr\n                cc = ac + dc\n                if not (ir0 <= rr <= ir1 and ic0 <= cc <= ic1):\n                    ok = False\n                    break\n            if ok:\n                fits.append(turns)\n        rot_counts[fits[0]] += 1\nprint(dict(rot_counts))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
