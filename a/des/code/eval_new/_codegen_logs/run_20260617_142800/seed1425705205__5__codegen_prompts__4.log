3:     if rng.random() < _P_BORDER_REMOVAL:\n0364:         bcells = [(r, c) for r in range(h) for c in range(w)\n0365:                   if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]\n0366:         rng.shuffle(bcells)\n0367:         for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:\n0368:             test = sprite.copy()\n0369:             test[cr, cc] = False\n0370:             if _get_enclosed_holes(test):\n0371:                 sprite = test\n0372:     if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:\n0373:         return None\n0374:     return sprite\n0375: \n0376: \n0377: def _choose_colors(rng, N, num_filled):\n0378:     \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n0379:     all_c = list(range(1, 10))\n0380:     rng.shuffle(all_c)\n0381:     border_keys = all_c[:N]\n0382:     rng.shuffle(all_c)\n0383:     fill_values = all_c[:N]\n0384:     dist_cands = [c for c in range(1, 10) if c not in border_keys]\n0385:     distractor_color = rng.choice(dist_cands)\n0386:     mapping = dict(zip(border_keys, fill_values))\n0387:     filled_keys = rng.sample(border_keys, num_filled)\n0388:     return border_keys, fill_values, distractor_color, mapping, filled_keys\n0389: \n0390: \n0391: def _build_palette(side, border_keys, fill_values):\n0392:     \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n0393:     N = len(border_keys)\n0394:     if side in ('top', 'bottom'):\n0395:         pal = np.zeros((2, N), dtype=int)\n0396:         outer, inner = (0, 1) if side == 'top' else (1, 0)\n0397:         pal[outer] = border_keys\n0398:         pal[inner] = fill_values\n0399:     else:\n0400:         pal = np.zeros((N, 2), dtype=int)\n0401:         outer, inner = (0, 1) if side == 'left' else (1, 0)\n0402:         pal[:, outer] = border_keys\n0403:         pal[:, inner] = fill_values\n0404:     return pal\n0405: \n0406: \n0407: def _place_palette(grid, occ, pal, side