ns bounded by colored walls.\n0107:     - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n0108: \n0109:     Rule:\n0110:     - For each enclosed region, identify its border color C and look up the legend with fill color C.\n0111:     - The direction from the legend's center dot to its indicator dot gives the slide direction.\n0112:     - All yellow pixels in that region slide in that direction, stacking against the far wall.\n0113: \n0114:     Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n0115:     \"\"\"\n0116:     g = np.asarray(grid, dtype=int)\n0117:     h, w = g.shape\n0118:     bg = get_bg(g)\n0119: \n0120:     mover = 4  # yellow in ARC\n0121:     dirs = _legend_directions(g, bg)\n0122:     assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n0123: \n0124:     passable = (g == bg) | (g == mover)\n0125:     out = g.copy()\n0126: \n0127:     # Find enclosed passable regions (not connected to the outer border).\n0128:     for pts in components_mask(passable, connectivity=4):\n0129:         if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n0130:             continue  # outside background\n0131: \n0132:         movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n0133:         if not movers:\n0134:             continue\n0135: \n0136:         # Determine this region's border color by counting adjacent wall colors.\n0137:         border_counts: dict[int, int] = {}\n0138:         pset = {(int(r), int(c)) for r, c in pts}\n0139:         for r, c in pts:\n0140:             for nr, nc in neighbors4(r, c):\n0141:                 if not (0 <= nr < h and 0 <= nc < w):\n0142:                     continue\n0143:                 if (nr, nc) in pset:\n0144:                     continue\n0145:                 v = int(g[nr, nc])\n0146:                 if v == bg or v == mover:\n0147:                     continue\n0148:                 border_counts[v] = border_counts.get(v, 0) + 1\n0149:         if not border_counts:\n0150:             continue\n0151:         border_col = max(border_counts, key=border_counts.get)\n0152:         if border_col not in dirs:\n0153:             continue\n0154:         dr, dc = dirs[border_col]\n0155: \n0156:         # Clear old movers.\n0157:         for r, c in movers:\n0158:             out[r, c] = bg\n0159: \n0160:         # Slide and repaint.\n0161:         new_pts = _slide_points(pset, movers, dr, dc)\n0162:         for r, c in new_pts:\n0163:             out[r, c] = mover\n0164: \n0165:     return out\n0166: \n0167: # --------------- generator (claude-att1) ---------------\n0168: \n0169: \"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\n0170: import random\n0171: import numpy as np\n0172: \n0173: from arc_utils import label_mask, neighbors4, paste\n0174: \n0175: # ── Configuration ─────────────────────────────────────────────────\n0176: GRID_H, GRID_W = 20, 20\n0177: \n0178: # Legend\n0179: CARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n0180: DIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\n0181: CORNERS = ['TL', 'TR', 'BL', 'BR']\n0182: WALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\n0183: CARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\n0184: LEGEND_BUFFER = 1                          # cells of padding around legend patches\n0185: \n0186: # Regions\n0187: REGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\n0188: MAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\n0189: REGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n0190:     1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n0191: }\n0192: BLOB_GR