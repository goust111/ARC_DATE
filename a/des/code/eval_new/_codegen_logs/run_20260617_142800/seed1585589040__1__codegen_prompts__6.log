{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import components_mask, neighbors4\nimport random\n\n\ndef _bg_boundary(g: np.ndarray) -> int:\n    \"\"\"Most common color along the 1-cell outer border.\"\"\"\n    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])\n    vals, cnts = np.unique(border, return_counts=True)\n    return int(vals[cnts.argmax()])\n\n\ndef _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:\n    \"\"\"\n    Find the 2xN or Nx2 palette block on a grid edge.\n\n    Returns (side, start, end) where:\n      - side in {\"top\",\"bottom\",\"left\",\"right\"}\n      - for top/bottom: start/end are column indices [start,end)\n      - for left/right: start/end are row indices [start,end)\n    \"\"\"\n    h, w = g.shape\n    best = None  # (score_tuple, side, start, end)\n\n    def isolated(side: str, start: int, end: int) -> bool:\n        \"\"\"\n        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells\n        outside the palette region; this prevents accidentally absorbing parts of large sprites\n        that touch the grid edge.\n        \"\"\"\n        h2, w2 = g.shape\n        pal = np.zeros((h2, w2), dtype=bool)\n        if side == \"top\":\n            pal[0:2, start:end] = True\n        elif side == \"bottom\":\n            pal[h2 - 2 : h2, start:end] = True\n        elif side == \"left\":\n            pal[start:end, 0:2] = True\n        else:\n            pal[start:end, w2 - 2 : w2] = True\n\n        for r, c in zip(*np.where(pal), strict=False):\n            r = int(r)\n            c = int(c)\n            v = int(g[r, c])\n            if v == bg:\n                continue\n            for rr, cc in neighbors4(r, c):\n                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:\n                    if int(g[rr, cc]) == v:\n                        return False\n        return True\n\n    def consider_top():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[0, :]\n        b = g[1, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                # Border keys should be unique (excluding bg) to form a well-defined mapping.\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"top\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"top\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_bottom():\n        nonlocal best\n        if h < 2:\n            return\n        a = g[h - 1, :]\n        b = g[h - 2, :]\n        for c0 in range(w):\n            for c1 in range(c0 + 2, w + 1):\n                seg_a = a[c0:c1]\n                seg_b = b[c0:c1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"bottom\", c0, c1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)\n                cand = (score, \"bottom\", c0, c1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_left():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, 0]\n        b = g[:, 1]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"left\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"left\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    def consider_right():\n        nonlocal best\n        if w < 2:\n            return\n        a = g[:, w - 1]\n        b = g[:, w - 2]\n        for r0 in range(h):\n            for r1 in range(r0 + 2, h + 1):\n                seg_a = a[r0:r1]\n                seg_b = b[r0:r1]\n                da = set(map(int, np.unique(seg_a)))\n                db = set(map(int, np.unique(seg_b)))\n                da.discard(bg)\n                db.discard(bg)\n                if len(da) < 2 or len(db) < 2:\n                    continue\n                d = da | db\n                if len(d) < 3:\n                    continue\n                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]\n                if len(border_keys) == 0:\n                    continue\n                if len(border_keys) != len(set(border_keys)):\n                    continue\n                if not isolated(\"right\", r0, r1):\n                    continue\n                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))\n                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)\n                cand = (score, \"right\", r0, r1)\n                if best is None or cand[0] > best[0]:\n                    best = cand\n\n    consider_top()\n    consider_bottom()\n    consider_left()\n    consider_right()\n\n    assert best is not None, \"_best_palette must find a valid palette region\"\n    _, side, start, end = best\n    return side, int(start), int(end)\n\n\ndef _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:\n    \"\"\"\n    Returns (mapping border->fill, palette_mask).\n    \"\"\"\n    h, w = g.shape\n    info = _best_palette(g, bg)\n    side, start, end = info\n    pal_mask = np.zeros((h, w), dtype=bool)\n    mapping: dict[int, int] = {}\n\n    if side == \"top\":\n        pal_mask[0:2, start:end] = True\n        border_line = g[0, start:end]\n        fill_line = g[1, start:end]\n    elif side == \"bottom\":\n        pal_mask[h - 2 : h, start:end] = True\n        border_line = g[h - 1, start:end]\n        fill_line = g[h - 2, start:end]\n    elif side == \"left\":\n        pal_mask[start:end, 0:2] = True\n        border_line = g[start:end, 0]\n        fill_line = g[start:end, 1]\n    else:  # right\n        pal_mask[start:end, w - 2 : w] = True\n        border_line = g[start:end, w - 1]\n        fill_line = g[start:end, w - 2]\n\n    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):\n        b = int(b)\n        f = int(f)\n        if b == bg:\n            continue\n        mapping[b] = f\n\n    return mapping, pal_mask\n\n\ndef _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:\n    \"\"\"\n    Find background regions (excluding the palette area) that do NOT touch the grid boundary,\n    and fill each region based on the most common adjacent border color (mapped via palette).\n    \"\"\"\n    h, w = out.shape\n    bg_mask = (out == bg) & (~pal_mask)\n    comps = components_mask(bg_mask, connectivity=4)\n    for pts in comps:\n        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n        if touches_boundary:\n            continue\n\n        adj_counts: dict[int, int] = {}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < h and 0 <= cc < w:\n                    if pal_mask[rr, cc]:\n                        continue\n                    v = int(out[rr, cc])\n                    if v == bg:\n                        continue\n                    adj_counts[v] = adj_counts.get(v, 0) + 1\n        if not adj_counts:\n            continue\n\n        # Prefer an adjacent color that exists in the mapping; pick the most frequent border.\n        border = None\n        best = -1\n        for col, cnt in adj_counts.items():\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/d6e50e54.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import Color, bbox_h, bbox_w, find_components, get_bg, in_bounds\nimport random\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Move each maroon marker toward the blue rectangle and recolor the rectangle red.\n\n    Input structure\n    A background canvas contains one solid blue rectangular object and several isolated\n    maroon marker pixels. Each marker is horizontally or vertically aligned with the\n    rectangle and lies outside it.\n\n    Rule\n    Start with a background canvas, repaint the blue rectangle red, and move each\n    maroon marker straight toward the rectangle along its row or column. Exactly one\n    marker is strictly closer to the rectangle than all others and enters the\n    rectangle boundary; every other marker lands in the adjacent exterior cell just\n    outside its aligned side.\n\n    Key insight\n    The single entering marker is the unique global nearest marker to the rectangle,\n    not the nearest marker on each of the four sides.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)\n    rectangles = []\n    markers = []\n    for comp in components:\n        h = bbox_h(comp[\"bbox\"])\n        w = bbox_w(comp[\"bbox\"])\n        if comp[\"area\"] == h * w and comp[\"area\"] > 1:\n            rectangles.append(comp)\n        elif comp[\"area\"] == 1:\n            markers.append(comp)\n\n    assert len(rectangles) == 1\n    assert markers\n    rect = rectangles[0]\n    rect_color = int(rect[\"color\"])\n    marker_colors = {int(comp[\"color\"]) for comp in markers}\n    assert marker_colors == {Color.MAROON}\n    marker_color = Color.MAROON\n    assert rect_color == Color.BLUE\n    assert set(map(int, g.flat)) == {bg, rect_color, marker_color}\n\n    r0, c0, r1, c1 = map(int, rect[\"bbox\"])\n    h = bbox_h(rect[\"bbox\"])\n    w = bbox_w(rect[\"bbox\"])\n\n    out = np.full_like(g, bg)\n    out[r0 : r1 + 1, c0 : c1 + 1] = Color.RED\n\n    destinations = []\n    marker_entries: list[tuple[int, tuple[int, int], bool]] = []\n    for comp in markers:\n        r, c = map(int, comp[\"coords\"][0])\n        candidates = []\n        if c0 <= c <= c1 and r < r0:\n            d = r0 - r\n            enters = d < h\n            candidates.append((r0 if enters else r0 - 1, c))\n            marker_entries.append((d, (r, c), enters))\n        if c0 <= c <= c1 and r > r1:\n            d = r - r1\n            enters = d < h\n            candidates.append((r1 if enters else r1 + 1, c))\n            marker_entries.append((d, (r, c), enters))\n        if r0 <= r <= r1 and c < c0:\n            d = c0 - c\n            enters = d < w\n            candidates.append((r, c0 if enters else c0 - 1))\n            marker_entries.append((d, (r, c), enters))\n        if r0 <= r <= r1 and c > c1:\n            d = c - c1\n            enters = d < w\n            candidates.append((r, c1 if enters else c1 + 1))\n            marker_entries.append((d, (r, c), enters))\n\n        assert len(candidates) == 1\n        dr, dc = candidates[0]\n        assert in_bounds(g.shape, dr, dc)\n        assert (dr, dc) not in destinations\n        destinations.append((dr, dc))\n\n    min_dist = min(dist for dist, _pos, _enters in marker_entries)\n    nearest = [pos for dist, pos, _enters in marker_entries if dist == min_dist]\n    entering = [pos for _dist, pos, enters in marker_entries if enters]\n    assert len(nearest) == 1, \"the nearest marker to the rectangle must be unique\"\n    assert len(entering) == 1, \"exactly one marker may enter the rectangle\"\n    assert entering[0] == nearest[0], \"the entering marker must be the global nearest\"\n\n    for r, c in destinations:\n        out[r, c] = marker_color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\nGRID_SIZE_MIN, GRID_SIZE_MAX = 8, 16\nRECT_SIDE_MIN, RECT_SIDE_MAX = 3, 5\nGRID_TO_RECT_RATIO_MIN, GRID_TO_RECT_RATIO_MAX = 2, 4\nMARKER_COUNT_MAX = 7\nSIDE_COUNT_MIN, SIDE_COUNT_MAX = 2, 4\nMIN_POSITION_SIDES_WITH_MARGIN, MIN_POSITION_MARGIN = 2, 2\nCLOSE_DIST_MIN, DIST_MAX = 2, 7\nKIND_CLOSE, KIND_FAR = \"close\", \"far\"\nBG_COLOR, RECT_INPUT_COLOR, RECT_OUTPUT_COLOR, MARKER_COLOR = 7, 1, 2, 9\nGEN_RETRIES = 300\nSIDE_TOP, SIDE_BOTTOM, SIDE_LEFT, SIDE_RIGHT = \"top\", \"bottom\", \"left\", \"right\"\nHORIZONTAL_SIDES = (SIDE_TOP, SIDE_BOTTOM)\n\ndef _gen_d6e50e54_margins(n, r0, c0, side):\n    r1 = r0 + side - 1\n    c1 = c0 + side - 1\n    return {\n        SIDE_TOP: r0,\n        SIDE_BOTTOM: n - r1 - 1,\n        SIDE_LEFT: c0,\n        SIDE_RIGHT: n - c1 - 1,\n    }\n\ndef _gen_d6e50e54_count_allocations(total, caps):\n    if not caps:\n        return [()] if total == 0 else []\n\n    out = []\n    rest_min = len(caps) - 1\n    rest_max = sum(caps[1:])\n    for first in range(1, caps[0] + 1):\n        remaining = total - first\n        if rest_min <= remaining <= rest_max:\n            for tail in _gen_d6e50e54_count_allocations(remaining, caps[1:]):\n                out.append((first,) + tail)\n    return out\n\ndef _gen_d6e50e54_gap_lane_sets(values, count):\n    out = []\n\n    def rec(start, chosen):\n        if len(chosen) == count:\n            out.append(tuple(chosen))\n            return\n        for i in range(start, len(values)):\n            if chosen and values[i] == chosen[-1] + 1:\n                continue\n            rec(i + 1, chosen + [values[i]])\n\n    rec(0, [])\n    return out\n\ndef _gen_d6e50e54_lanes(values, count, single_distance):\n    if single_distance:\n        choices = _gen_d6e50e54_gap_lane_sets(list(values), count)\n        if not choices:\n            return None\n        return list(random.choice(choices))\n    return random.sample(list(values), count)\n\ndef _gen_d6e50e54_valid_options(margin, side_len):\n    options = []\n    close_max = min(side_len - 1, margin, DIST_MAX)\n    for dist in range(CLOSE_DIST_MIN, close_max + 1):\n        options.append((KIND_CLOSE, dist))\n    if margin >= side_len:\n        for dist in range(side_len, min(margin, DIST_MAX) + 1):\n            options.append((KIND_FAR, dist))\n    return options\n\n\ndef _gen_d6e50e54_side_cap(margin, side_len):\n    if len({dist for _kind, dist in _gen_d6e50e54_valid_options(margin, side_len)}) <= 1:\n        return (side_len + 1) // 2\n    return side_len\n\n\ndef _gen_d6e50e54_coords(side_name, lane, kind, dist, r0, c0, r1, c1):\n    if side_name == SIDE_TOP:\n        dest = (r0 if kind == KIND_CLOSE else r0 - 1, lane)\n        src = (r0 - dist, lane)\n    elif side_name == SIDE_BOTTOM:\n        dest = (r1 if kind == KIND_CLOSE else r1 + 1, lane)\n        src = (r1 + dist, lane)\n    elif side_name == SIDE_LEFT:\n        dest = (lane, c0 if kind == KIND_CLOSE else c0 - 1)\n        src = (lane, c0 - dist)\n    else:\n        dest = (lane, c1 if kind == KIND_CLOSE else c1 + 1)\n        src = (lane, c1 + dist)\n    return dest, src\n\n\ndef _gen_d6e50e54_assign(slots, margins, side_len, r0, c0, r1, c1):\n    random.shuffle(slots)\n\n    def rec(i, close_index, used_dest, used_src, assigned):\n        if i == len(slots):\n            return assigned\n\n        side_name, lane = slots[i]\n        margin = margins[side_name]\n        required_kind = KIND_CLOSE if i == close_index else KIND_FAR\n        options = [\n            option\n            for option in _gen_d6e50e54_valid_options(margin, side_len)\n            if option[0] == required_kind\n        ]\n        random.shuffle(options)\n\n        for kind, dist in options:\n            dest, src = _gen_d6e50e54_coords(\n                side_name, lane, kind, dist, r0, c0, r1, c1\n            )\n            if dest in used_dest or src in used_src:\n                continue\n            if any(abs(src[0] - old[0]) + abs(src[1] - old[1]) == 1 for old in used_src):\n                continue\n            result = rec(\n                i + 1,\n                close_index,\n                used_dest | {dest},\n                used_src | {src},\n                assigned + [(dest, src)],\n            )\n            if result is not None:\n                return result\n        return None\n\n    close_indices = list(range(len(slots)))\n    random.shuffle(close_indices)\n    for close_index in close_indices:\n        result = rec(0, close_index, set(), set(), [])\n        if result is not None:\n            return result\n    return None\n\n\ndef _gen_d6e50e54_choose_rect():\n    n = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    side_choices = [\n        s\n        for s in range(RECT_SIDE_MIN, RECT_SIDE_MAX + 1)\n        if GRID_TO_RECT_RATIO_MIN <= n / s <= GRID_TO_RECT_RATIO_MAX\n    ]\n    side_len = random.choice(side_choices)\n    positions = []\n    for r0 in range(n - side_len + 1):\n        for c0 in range(n - side_len + 1):\n            margins = _gen_d6e50e54_margins(n, r0, c0, side_len)\n            enough_sides = (\n                sum(m >= MIN_POSITION_MARGIN for m in margins.values())\n                >= MIN_POSITION_SIDES_WITH_MARGIN\n            )\n            if enough_sides and max(margins.values()) >= side_len:\n                positions.append((r0, c0, margins))\n    if not positions:\n        return None\n","exit_code":0,"status":"completed"}}
