r - 1, c\\\\n    31\\\\t    yield r + 1, c\\\\n    32\\\\t    yield r, c - 1\\\\n    33\\\\t    yield r, c + 1\\\\n    34\\\\t\\\\n    35\\\\t\\\\n    36\\\\tdef get_bg(grid: np.ndarray) -> int:\\\\n    37\\\\t    vals, counts = np.unique(grid, return_counts=True)\\\\n    38\\\\t    return int(vals[np.argmax(counts)])\\\\n    39\\\\t\\\\n    40\\\\t\\\\n    41\\\\tdef components_mask(mask: np.ndarray) -> list[list[tuple[int, int]]]:\\\\n    42\\\\t    h, w = mask.shape\\\\n    43\\\\t    seen = np.zeros((h, w), dtype=bool)\\\\n    44\\\\t    comps: list[list[tuple[int, int]]] = []\\\\n    45\\\\t    for r in range(h):\\\\n    46\\\\t        for c in range(w):\\\\n    47\\\\t            if not mask[r, c] or seen[r, c]:\\\\n    48\\\\t                continue\\\\n    49\\\\t            stack = [(r, c)]\\\\n    50\\\\t            seen[r, c] = True\\\\n    51\\\\t            comp: list[tuple[int, int]] = []\\\\n    52\\\\t            while stack:\\\\n    53\\\\t                cr, cc = stack.pop()\\\\n    54\\\\t                comp.append((int(cr), int(cc)))\\\\n    55\\\\t                for nr, nc in neighbors4(cr, cc):\\\\n    56\\\\t                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\\\\n    57\\\\t                        seen[nr, nc] = True\\\\n    58\\\\t                        stack.append((nr, nc))\\\\n    59\\\\t            comps.append(comp)\\\\n    60\\\\t    return comps\\\\n    61\\\\t\\\\n    62\\\\t\\\\n    63\\\\tdef normalize_coords(coords: list[tuple[int, int]]) -> tuple[tuple[int, int], ...]:\\\\n    64\\\\t    r0 = min(r for r, _ in coords)\\\\n    65\\\\t    c0 = min(c for _, c in coords)\\\\n    66\\\\t    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))\\\\n    67\\\\t\\\\n    68\\\\t\\\\n    69\\\\tdef touches_border(coords: list[tuple[int, int]], shape: tuple[int, int]) -> bool:\\\\n    70\\\\t    h, w = shape\\\\n    71\\\\t    return any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in coords)\\\\n    72\\\\t\\\\n    73\\\\t\\\\n    74\\\\tdef find_separator_col(grid: np.ndarray, bg: int) -> int:\\\\n    75\\\\t    cands = []\\\\n    76\\\\t    for c in range(grid.shape[1]):\\\\n    77\\\\t        col_vals = np.unique(grid[:, c])\\\\n    78\\\\t        if len(col_vals) == 1 and int(col_vals[0]) != bg:\\\\n    79\\\\t            cands.append(int(c))\\\\n    80\\\\t    assert len(cands) == 1, \\\\\\\"expected exactly one full-height separator column\\\\\\\"\\\\n    81\\\\t    return cands[0]\\\\n    82\\\\t\\\\n    83\\\\t\\\\n    84\\\\tdef boundary_positions(\\\\n    85\\\\t    hole_coords: list[tuple[int, int]], shape: tuple[int, int]\\\\n    86\\\\t) -> list[tuple[int, int]]:\\\\n    87\\\\t    h, w = shape\\\\n    88\\\\t    hole_set = set(hole_coords)\\\\n    89\\\\t    seen = set()\\\\n    90\\\\t    out: list[tuple[int, int]] = []\\\\n    91\\\\t    for r, c in hole_coords:\\\\n    92\\\\t        for nr, nc in neighbors4(r, c):\\\\n    93\\\\t            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in hole_set and (nr, nc) not in seen:\\\\n    94\\\\t                seen.add((nr, nc))\\\\n    95\\\\t                out.append((int(nr), int(nc)))\\\\n    96\\\\t    return out\\\\n    97\\\\t\\\\n    98\\\\t\\\\n    99\\\\tdef ranked_boundary_colors(\\\\n   100\\\\t    grid: np.ndarray, hole_coords: list[tuple[int, int]], bg: int\\\\n   101\\\\t) -> list[int]:\\\\n   102\\\\t    boundary = [p for p in boundary_positions(hole_coords, grid.shape) if int(grid[p]) != bg]\\\\n   103\\\\t    counts = Counter(int(grid[r, c]) for r, c in boundary)\\\\n   104\\\\t    assert len(counts) >= 2, \\\\\\\"each hole must touch at least two colors\\\\\\\"\\\\n   105\\\\t    boundary_sorted = sorted(boundary)\\\\n   106\\\\t    first_pos: dict[int, int] = {}\\\\n   107\\\\t    for idx, (r, c) in enumerate(boundary_sorted):\\\\n   108\\\\t        first_pos.setdefault(int(grid[r, c]), idx)\\\\n   109\\\\t    ordered = sorted(counts.items(), key=lambda item: (-item[1], first_pos[item[0]]))\\\\n   110\\\\t    return [int(color) for color, _count in ordered]\\\\n   111\\\\t\\\\n   112\\\\t\\\\n   113\\\\tdef transform_shape(\\\\n   114\\\\t    coords: list[tuple[int, int]], rot: int, flip: bool\\\\n   115\\\\t) -> list[tuple[int, int]]:\\\\n   116\\\\t    pts = np.array(coords, dtype=int)\\\\n   117\\\\t    if flip:\\\\n   118\\\\t        pts[:, 1] *= -1\\\\n   119\\\\t    for _ in range(rot % 4):\\\\n   120\\\\t        pts = np.stack([pts[:, 1], -pts[:, 0]], axis=1)\\\\n   121\\\\t    pts[:, 0] -= np.min(pts[:, 0])\\\\n   122\\\\t    pts[:, 1] -= np.min(pts[:, 1])\\\\n   123\\\\t    return [(int(r), int(c)) for r, c in pts.tolist()]\\\\n   124\\\\t\\\\n   125\\\\t\\\\n   126\\\\tdef chebyshev_dilate(coords: set[tuple[int, int]], radius: int) -> set[tuple[int, int]]:\\\\n   127\\\\t    out = set()\\\\n   128\\\\t    for r, c in coords:\\\\n   129\\\\t        for dr in range(-radius, radius + 1):\\\\n   130\\\\t            for dc in range(-radius, radius + 1):\\\\n   131\\\\t                out.add((int(r + dr), int(c + dc)))\\\\n   132\\\\t    return out\\\\n   133\\\\t\\\\n   134\\\\t\\\\n   135\\\\tdef inside_rect(cell: tuple[int, int], rect: tuple[int, int, int, int]) -> bool:\\\\n   136\\\\t    r, c = cell\\\\n   137\\\\t    r0, c0, r1, c1 = rect\\\\n   138\\\\t    return r0 <= r < r1 and c0 <= c < c1\\\\n   139\\\\t\\\\n   140\\\\t\\\\n   141\\\\tdef distinct_quotas(total: int) -> list[int]:\\\\n   142\\\\t    assert total >= 6\\\\n   143\\\\t    for _ in range(200):\\\\n   144\\\\t        cuts = sorted(RNG.choice(np.arange(1, total), size=2, replace=False).tolist())\\\\n   145\\\\t        parts = [cuts[0], cuts[1] - cuts[0], total - cuts[1]]\\\\n   146\\\\t        if min(parts) > 0 and len(set(parts)) == 3:\\\\n   147\\\\t            return sorted([int(x) for x in parts], reverse=True)\\\\n   148\\\\t    raise RuntimeError(\\\\\\\"failed to split boundary into three distinct quotas\\\\\\\")\\\\n   149\\\\t\\\\n   150\\\\t\\\\n   151\\\\tdef order_boundary_cycle(\\\\n   152\\\\t    hole_coords: list[tuple[int, int]], boundary: list[tuple[int, int]]\\\\n   153\\\\t) -> list[tuple[int, int]]:\\\\n   154\\\\t    center_r = float(sum(r for r, _ in hole_coords)) / len(hole_coords)\\\\n   155\\\\t    center_c = float(sum(c for _, c in hole_coords)) / len(hole_coords)\\\\n   156\\\\t    ordered = sorted(\\\\n   157\\\\t        boundary,\\\\n   158\\\\t        key=lambda p: (math.atan2(p[0] - center_r, p[1] - center_c), p[0], p[1]),\\\\n   159\\\\t    )\\\\n   160\\\\t    shift = int(RNG.integers(0, len(ordered)))\\\\n   161\\\\t    return ordered[shift:] + ordered[:shift]\\\\n   162\\\\t\\\\n   163\\\\t\\\\n   164\\\\tdef render_shape_patch(coords: list[tuple[int, int]], color: int) -> np.ndarray:\\\\n   165\\\\t    key = normalize_coords(coords)\\\\n   166\\\\t    h = max(r for r, _ in key) + 1\\\\n   167\\\\t    w = max(c for _, c in key) + 1\\\\n   168\\\\t    patch = np.full((h, w), BG, dtype=int)\\\\n   169\\\\t    for r, c in key:\\\\n   170\\\\t        patch[r, c] = int(color)\\\\n   171\\\\t    return patch\\\\n   172\\\\t\\\\n   173\\\\t\\\\n   174\\\\tdef main(grid: np.ndarray) -> np.ndarray:\\\\n   175\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n   176\\\\t    Reassemble torn holes in a multicolor template by matching fragment shapes, then fill each hole via boundary-color ranking.\\\\n   177\\\\t\\\\n   178\\\\t    Input structure:\\\\n   179\\\\t    - bg = most common color.\\\\n   180\\\\t    - One full-height grey separator column splits the grid into a larger left template area and a smaller right fragment area.\\\\n   181\\\\t    - The left area contains one large connected multicolor figure with several enclosed bg holes.\\\\n   182\\\\t    - The right area contains isolated monochrome fragments whose exact shapes match the holes by translation only.\\\\n   183\\\\t\\\\n   184\\\\t    Rule:\\\\n   185\\\\t    - Find each enclosed hole in the left area and each fragment in the right area.\\\\n   186\\\\t    - Match fragment to hole by exact normalized shape, without rotation or reflection.\\\\n   187\\\\t    - For the matched hole, collect the distinct non-bg colors on its 4-neighbor boundary and rank them by how many boundary cells of each color touch the hole.\\\\n   188\\\\t    - The fragment's dedicated pointer color selects the 1st, 2nd, or 3rd ranked boundary color; fill the whole hole with that selected color.\\\\n   189\\\\t    - Return only the repaired left area, excluding the separator and the fragment area.\\\\n   190\\\\t\\\\n   191\\\\t    Key insight:\\\\n   192\\\\t    - Shape identifies where a fragment belongs, but fragment color does not paint directly; it indexes a rank inside the hole's visible boundary-color distribution.\\\\n   193\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n   194\\\\t    g = np.asarray(grid, dtype=int)\\\\n   195\\\\t    bg = get_bg(g)\\\\n   196\\\\t    sep_c = find_separator_col(g, bg)\\\\n   197\\\\t\\\\n   198\\\\t    left = g[:, :sep_c].copy()\\\\n   199\\\\t    right = g[:, sep_c + 1 :]\\\\n   200\\\\t\\\\n   201\\\\t    holes = [\\\\n   202\\\\t        comp\\\\n   203\\\\t        for comp in components_mask(left == bg)\\\\n   204\\\\t        if not touches_border(comp, left.shape)\\\\n   205\\\\t    ]\\\\n   206\\\\t    fragments = []\\\\n   207\\\\t    for comp in components_mask(right != bg):\\\\n   208\\\\t        colors = {int(right[r, c]) for r, c in comp}\\\\n   209\\\\t        assert len(colors) == 1, \\\\\\\"each fragment must be monochrome\\\\\\\"\\\\n   210\\\\t        pointer_color = colors.pop()\\\\n   211\\\\t        assert pointer_color in POINTER_TO_RANK, \\\\\\\"unexpected pointer color\\\\\\\"\\\\n   212\\\\t        fragments.append((normalize_coords(comp), int(pointer_color)))\\\\n   213\\\\t\\\\n   214\\\\t    assert holes and len(holes) == len(fragments), \\\\\\\"holes and fragments must pair up\\\\\\\"\\\\n   215\\\\t    hole_by_shape: dict[tuple[tuple[int, int], ...]