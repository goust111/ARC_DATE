{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"sed -n '600,720p' /home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py\"","aggregated_output":"    mask = _layout_root(roots)\n    out = np.full(mask.shape, bg, dtype=int)\n    out[mask] = fg\n    return out\n\n\ndef _make_tree():\n    \"\"\"Build a random containment tree (1-2 frames, 1-4 blobs, optional outside blob).\"\"\"\n    root = _Obj(\"frame\")\n    outside = None\n    sides = (\"left\", \"right\", \"top\", \"bottom\")\n    if random.random() < DEPTH1_PROB:\n        n_inside = random.randint(*DEPTH1_INSIDE_RANGE)\n        root.children = [_Obj(\"blob\") for _ in range(n_inside)]\n        if n_inside < MAX_TOTAL_CHILDREN and random.random() < OUTSIDE_BLOB_PROB:\n            outside = _Obj(\"blob\", outside_side=random.choice(sides))\n    else:\n        inner = _Obj(\"frame\")\n        inner.children = [_Obj(\"blob\") for _ in range(random.randint(*DEPTH2_INNER_BLOBS))]\n        outer_blobs = [_Obj(\"blob\") for _ in range(random.randint(*DEPTH2_OUTER_BLOBS))]\n        root.children = [inner] + outer_blobs\n        if len(inner.children) + len(outer_blobs) < MAX_TOTAL_CHILDREN and random.random() < OUTSIDE_BLOB_PROB:\n            outside = _Obj(\"blob\", outside_side=random.choice(sides))\n    return root, outside\n\n\ndef _draw(objects, bg, fg):\n    \"\"\"Render all objects onto a padded grid. Returns None if size constraints fail.\"\"\"\n    min_r = min(obj.pos[0] for obj in objects)\n    min_c = min(obj.pos[1] for obj in objects)\n    max_r = max(obj.pos[0] + obj.mask.shape[0] for obj in objects)\n    max_c = max(obj.pos[1] + obj.mask.shape[1] for obj in objects)\n    draw_h = max_r - min_r\n    draw_w = max_c - min_c\n    if draw_h > GRID_MAX or draw_w > GRID_MAX:\n        return None\n\n    extra_h_min = max(0, GRID_MIN - draw_h)\n    extra_w_min = max(0, GRID_MIN - draw_w)\n    extra_h_max = min(MAX_EXTRA_PAD, GRID_MAX - draw_h)\n    extra_w_max = min(MAX_EXTRA_PAD, GRID_MAX - draw_w)\n    if extra_h_min > extra_h_max or extra_w_min > extra_w_max:\n        return None\n    extra_h = random.randint(extra_h_min, extra_h_max)\n    extra_w = random.randint(extra_w_min, extra_w_max)\n    top_pad = random.randint(max(0, extra_h - MAX_PAD_PER_SIDE), min(MAX_PAD_PER_SIDE, extra_h))\n    left_pad = random.randint(max(0, extra_w - MAX_PAD_PER_SIDE), min(MAX_PAD_PER_SIDE, extra_w))\n    shift_r = top_pad - min_r\n    shift_c = left_pad - min_c\n\n    grid = np.full((draw_h + extra_h, draw_w + extra_w), bg, dtype=int)\n    for obj in objects:\n        assert obj.mask is not None\n        r = obj.pos[0] + shift_r\n        c = obj.pos[1] + shift_c\n        obj.pos = (r, c)\n        patch = np.full(obj.mask.shape, bg, dtype=int)\n        patch[obj.mask] = fg\n        paste(grid, patch, r, c, transparent=bg)\n    if np.count_nonzero(grid == bg) <= np.count_nonzero(grid == fg):\n        return None\n    return grid\n\n\ndef _gen_attempt():\n    \"\"\"Single generation attempt: build tree, render input, verify against solver.\"\"\"\n    bg, fg = random.sample(range(10), 2)\n    root, outside = _make_tree()\n    if not _prepare(root):\n        return None\n    if outside is not None:\n        if not _prepare(outside):\n            return None\n        _place_outside(root, outside)\n\n    objects = _walk(root)\n    if outside is not None:\n        outside.pos = outside.rel\n        objects.append(outside)\n\n    grid = _draw(objects, bg, fg)\n    if grid is None:\n        return None\n    expected = _expected_output(root, outside, bg, fg)\n    try:\n        got = main(grid)\n    except Exception:\n        return None\n    if not np.array_equal(got, expected):\n        return None\n    return grid\n\n\ndef generate_input():\n    for _ in range(GEN_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 2d0172a1 input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"sed -n '240,340p' /home/lixinyu/snap/new/ARC_code/eval/7b3084d4.py\"","aggregated_output":"        for placement in best_options:\n            _apply(board, placement)\n            if backtrack(next_rem):\n                return True\n            _apply(board, placement, -1)\n        return False\n\n    if backtrack(remaining):\n        return board\n    return None\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Assemble colored rectangular sprites into a single tiled rectangle, anchored by a marker pixel.\n\n    Input structure:\n    - bg = most common color. Several solid-colored rectangular sprites scattered on the grid.\n    - One sprite has a unique single-pixel marker (different color) at one corner — this is the anchor.\n\n    Rule:\n    - Identify the anchor sprite (contains the marker pixel) and the remaining pieces.\n    - Rotate the anchor so the marker pixel lands at position (0,0) of the output.\n    - Pack all remaining pieces (allowing 90° rotations) to tile a complete rectangle with no gaps.\n\n    Key insight: The lone marker pixel picks the anchor and fixes the output orientation — it must sit at the top-left corner.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    pieces, bg = _extract_pieces(g)\n    assert pieces, \"grid has no non-background colors — input must contain colored pieces to assemble\"\n\n    area = sum(len(p[\"cells\"]) for p in pieces)\n    for H, W in _dims(area):\n        solved = _solve_packing(pieces, H, W)\n        if solved is None:\n            continue\n        return solved.astype(int)\n\n    assert False, \"packing failed for all candidate dimensions — input pieces must tile a valid rectangle\"\n\n# --------------- generator (Claude attempt 1) ---------------\n\n# ── Configuration ────────────────────────────────────────────\nN_MIN, N_MAX = 2, 7              # half-side of output grid\nANCHOR_COLOR = 7                 # color of the anchor (TL) piece\nMARKER_COLOR = 5                 # singleton marker pixel color\nCOLOR_POOL = [1, 2, 3, 4, 6, 8, 9]  # non-anchor piece color candidates\nCANVAS_H, CANVAS_W = 20, 20     # input grid dimensions\nPLACEMENT_PADDING = 1            # min gap between piece bboxes\nMAX_ATTEMPTS = 300               # retries in generate_input\nTAB_NAMES = ['H_left', 'H_right', 'V_top', 'V_bot']\n\n# Quadrant identifiers\nTL, TR, BL, BR = 0, 1, 2, 3\n\n\ndef _build_ownership(N: int, p: int, tab_specs: dict) -> np.ndarray | None:\n    \"\"\"Build 2Nx2N quadrant-ownership grid with tab intrusions.\n\n    tab_specs maps tab name -> (depth, direction) or None.\n    Returns (2N,2N) array with values TL/TR/BL/BR, or None if any\n    quadrant region is empty or not 8-connected.\n    \"\"\"\n    S = 2 * N\n    own = np.zeros((S, S), dtype=int)\n    own[:N, :N] = TL\n    own[:N, N:] = TR\n    own[N:, :N] = BL\n    own[N:, N:] = BR\n\n    # H-tabs: single-column strips crossing the horizontal boundary (row N)\n    for kind, col, up_owner, down_owner in [\n        ('H_left',  p,         BL, TL),\n        ('H_right', S - 1 - p, BR, TR),\n    ]:\n        spec = tab_specs.get(kind)\n        if spec is None:\n            continue\n        depth, direction = spec\n        if direction == 'up':\n            own[N - depth:N, col] = up_owner\n        else:\n            own[N:N + depth, col] = down_owner\n\n    # V-tabs: single-row strips crossing the vertical boundary (col N)\n    for kind, row, left_owner, right_owner in [\n        ('V_top', p,         TR, TL),\n        ('V_bot', S - 1 - p, BR, BL),\n    ]:\n        spec = tab_specs.get(kind)\n        if spec is None:\n            continue\n        depth, direction = spec\n        if direction == 'left':\n            own[row, N - depth:N] = left_owner\n        else:\n            own[row, N:N + depth] = right_owner\n\n    # Verify all four quadrant regions are non-empty and 8-connected\n    for q in (TL, TR, BL, BR):\n        mask = (own == q).astype(int)\n","exit_code":0,"status":"completed"}}
