{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '430,560p' /home/lixinyu/snap/new/ARC_code/train/57edb29d.py\"","aggregated_output":"    non_overlap_bands = _pack_non_overlap_bands(non_overlap_rects, avail_w)\n\n    layout_shape = _choose_layout_shape(\n        target_h, target_w, plain_w, overlap_rects, overlap_band_h, non_overlap_bands\n    )\n    if layout_shape is None:\n        return None\n    actual_h, actual_w = layout_shape\n\n    overlap_items = _make_overlap_items(plain_h, plain_w, plain_base, overlap_rects, overlap_band_h)\n    if overlap_items is None:\n        return None\n    all_bands = [overlap_items] + _make_non_overlap_items(non_overlap_bands)\n\n    grid = _render_bands(actual_h, actual_w, all_bands)\n    if grid is None:\n        return None\n    return _accept_if_solver_matches(grid, output)\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(f\"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,230p' /home/lixinyu/snap/new/ARC_code/train/412b6263.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import Color, find_components, paste\n\n\ndef _infer_background_and_objects(g: np.ndarray) -> tuple[int, list[dict]]:\n    colors, counts = np.unique(g, return_counts=True)\n    min_count = int(counts.min())\n    marker_colors = [int(c) for c, n in zip(colors, counts) if int(n) == min_count]\n    assert len(marker_colors) == 1\n    marker = marker_colors[0]\n    assert int(np.sum(g == marker)) == 2\n\n    candidates: list[tuple[int, list[dict]]] = []\n    for bg in map(int, colors):\n        if bg == marker:\n            continue\n        objects = find_components(g, bg=bg, connectivity=4, monochromatic=False)\n        if len(objects) != 2:\n            continue\n        ok = True\n        for obj in objects:\n            coords = obj[\"coords\"]\n            vals = g[coords[:, 0], coords[:, 1]]\n            if int(np.sum(vals == marker)) != 1:\n                ok = False\n            if len(set(map(int, vals)) - {marker}) != 1:\n                ok = False\n        if ok:\n            candidates.append((bg, objects))\n\n    assert len(candidates) == 1\n    return candidates[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Infer the background, rotate the whole input 90 degrees counterclockwise, and stack two framed copies vertically.\n\n    Input structure:\n    - Blue is absent from the input.\n    - One rare marker color appears in exactly two pixels.\n    - The background is the unique non-marker color whose removal leaves exactly two 4-connected foreground objects, each with one marker pixel and one body color.\n    - The whole grid, including background and foreground objects, is the sprite to transform.\n\n    Rule:\n    - Rotate the entire input grid 90 degrees counterclockwise.\n    - Create a blue one-pixel frame around two vertical copies of the rotated grid.\n    - Use the input background color for the two endpoints of every horizontal frame/separator row.\n\n    Key insight: The output is not a crop of the foreground objects; it is two copies of the complete rotated input, separated and enclosed by a newly added blue border.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg, objects = _infer_background_and_objects(g)\n    assert bg != Color.BLUE\n    assert Color.BLUE not in set(map(int, g.ravel()))\n\n    copies = len(objects)\n\n    tile = np.rot90(g, 1)\n    tile_h, tile_w = map(int, tile.shape)\n\n    out_h = copies * tile_h + copies + 1\n    out_w = tile_w + 2\n    out = np.full((out_h, out_w), Color.BLUE, dtype=int)\n\n    for i in range(copies):\n        row = i * (tile_h + 1)\n        out[row, 0] = bg\n        out[row, -1] = bg\n        paste(out, tile, row + 1, 1)\n\n    out[-1, 0] = bg\n    out[-1, -1] = bg\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n# CFG: ranges use numpy's high-exclusive convention where applicable.\nCANVAS_SHAPE_RANGES = ((5, 10), (5, 11))\nOBJECT_SHAPE_RANGES = ((2, 5), (2, 5))\nMIN_SEPARATION_GAP = 1\nMAX_OUTPUT_SIZE = 30\nINPUT_COLORS = [0, 2, 3, 4, 5, 6, 7, 8, 9]\nPALETTE_SIZE = 3\nFRAME_COLOR = Color.BLUE\nOUTPUT_TILE_COPIES = 2\nFRAME_THICKNESS = 1\nMAX_GENERATION_ATTEMPTS = 300\n\ndef _edge_cells(h: int, w: int) -> list[tuple[int, int]]:\n    return [\n        (r, c)\n        for r in range(h)\n        for c in range(w)\n        if r in (0, h - 1) or c in (0, w - 1)\n    ]\n\ndef _expected_output(inp: np.ndarray, bg: int) -> np.ndarray:\n    tile = np.rot90(inp, 1)\n    tile_h, tile_w = tile.shape\n    out_h = OUTPUT_TILE_COPIES * tile_h + (OUTPUT_TILE_COPIES + 1) * FRAME_THICKNESS\n    out_w = tile_w + 2 * FRAME_THICKNESS\n    out = np.full((out_h, out_w), FRAME_COLOR, dtype=int)\n    out[0, 0] = out[0, -1] = bg\n    out[tile_h + FRAME_THICKNESS, 0] = out[tile_h + FRAME_THICKNESS, -1] = bg\n    out[-1, 0] = out[-1, -1] = bg\n    out[FRAME_THICKNESS : FRAME_THICKNESS + tile_h, FRAME_THICKNESS : FRAME_THICKNESS + tile_w] = tile\n    second_top = tile_h + 2 * FRAME_THICKNESS\n    out[second_top : second_top + tile_h, FRAME_THICKNESS : FRAME_THICKNESS + tile_w] = tile\n    return out\n\ndef _sample_object_dims(canvas_h: int, canvas_w: int) -> tuple[int, int] | None:\n    feasible_dims = [\n        (oh, ow)\n        for oh in range(*OBJECT_SHAPE_RANGES[0])\n        for ow in range(*OBJECT_SHAPE_RANGES[1])\n        if oh <= canvas_h and ow <= canvas_w and (\n            canvas_h - 2 * oh >= MIN_SEPARATION_GAP\n            or canvas_w - 2 * ow >= MIN_SEPARATION_GAP\n        )\n    ]\n    if not feasible_dims:\n        return None\n    return feasible_dims[int(np.random.randint(len(feasible_dims)))]\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    H = int(np.random.randint(*CANVAS_SHAPE_RANGES[0]))\n    W = int(np.random.randint(*CANVAS_SHAPE_RANGES[1]))\n\n    dims = _sample_object_dims(H, W)\n    if dims is None:\n        return None\n    oh, ow = dims\n\n    bg, body, marker = map(int, np.random.choice(INPUT_COLORS, size=PALETTE_SIZE, replace=False))\n    inp = np.full((H, W), bg, dtype=int)\n    inp[:oh, :ow] = body\n    inp[H - oh : H, W - ow : W] = body\n    mr, mc = _edge_cells(oh, ow)[int(np.random.randint(2 * oh + 2 * ow - 4))]\n    inp[mr, mc] = marker\n    inp[H - oh + mr, W - ow + mc] = marker\n\n    expected = _expected_output(inp, bg)\n    if expected.shape[0] > MAX_OUTPUT_SIZE or expected.shape[1] > MAX_OUTPUT_SIZE:\n        return None\n\n    try:\n        actual = main(inp)\n    except AssertionError:\n        return None\n    if not np.array_equal(actual, expected):\n        return None\n    return inp\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_GENERATION_ATTEMPTS):\n        inp = _gen_attempt()\n        if inp is not None:\n            return inp\n    raise RuntimeError(\"failed to generate valid input\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '260,360p' /home/lixinyu/snap/new/ARC_code/eval/dbff022c.py\"","aggregated_output":"        for col, cnt in adj_counts.items():\n            if col not in mapping:\n                continue\n            if cnt > best:\n                best = cnt\n                border = col\n        if border is None:\n            continue\n\n        fill = int(mapping[border])\n        for r, c in pts:\n            out[r, c] = fill\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill hollow sprites' interiors using a color-palette legend on the grid edge.\n\n    Input structure:\n    - bg = most common color. Several hollow sprites with distinct border colors.\n    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.\n\n    Rule:\n    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.\n    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.\n    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.\n\n    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = _bg_boundary(g)\n\n    mapping, pal_mask = _palette_mapping(g, bg)\n    assert mapping, \"main: palette mapping must be non-empty\"\n\n    out = g.copy()\n    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)\n\n    return out\n\n# --------------- generator (c) ---------------\n\n# -- Configuration constants --------------------------------------------------\n# Grid dimensions\n_GRID_H_MIN, _GRID_H_MAX = 4, 13\n_GRID_W_MIN, _GRID_W_MAX = 10, 15\n_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n\n# Palette\n_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n\n# Sprite geometry\n_SPRITE_H_MAX = 7\n_SPRITE_W_MAX = 6\n_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n_SPRITE_CELL_MAX = 16\n_FILLED_SPRITE_MAX = 3\n\n# Sprite mutation probabilities\n_P_HORIZ_WALL = 0.3           # add horizontal internal wall\n_P_VERT_WALL = 0.3            # add vertical internal wall\n_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n_P_DIAMOND = 0.2              # use diamond shape for 3x3\n\n# Generation\n_MAX_RETRIES = 300\n# -- End configuration --------------------------------------------------------\n\n\ndef _get_enclosed_holes(sprite):\n    \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n    h, w = sprite.shape\n    return [pts for pts in components_mask(~sprite, connectivity=4)\n            if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n\n\ndef _make_diamond():\n    \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n    s = np.zeros((3, 3), dtype=bool)\n    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n    return s\n\n\ndef _make_hollow_sprite(h, w, rng):\n    \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n    sprite = np.ones((h, w), dtype=bool)\n    if h >= 3 and w >= 3:\n        sprite[1:-1, 1:-1] = False\n    # Optionally add internal horizontal wall\n    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n        br = rng.randint(2, h - 2)\n        n = rng.randint(1, w - 2)\n        s = rng.randint(1, w - 1 - n + 1)\n        sprite[br, s:s + n] = True\n    # Optionally add internal vertical wall\n    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:\n        bc = rng.randint(2, w - 2)\n        n = rng.randint(1, h - 2)\n        s = rng.randint(1, h - 1 - n + 1)\n","exit_code":0,"status":"completed"}}
