\n 102:         traced = _nonbg_component8_from(g, (sr, sc), bg)\n 103: \n 104:         for cav, boundary, bcols in cavities:\n 105:             if len(bcols) != 1:\n 106:                 continue\n 107:             boundary_in_traced = boundary & traced\n 108:             if not boundary_in_traced:\n 109:                 continue\n 110: \n 111:             # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n 112:             # This prevents filling regions that are only connected through other structures, not the line itself.\n 113:             ok = False\n 114:             for r, c in boundary_in_traced:\n 115:                 for nr, nc in neighbors8(r, c):\n 116:                     if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n 117:                         ok = True\n 118:                         break\n 119:                 if ok:\n 120:                     break\n 121:             if not ok:\n 122:                 continue\n 123: \n 124:             for r, c in cav:\n 125:                 if int(out[r, c]) == bg:\n 126:                     out[r, c] = seed_col\n 127: \n 128:     return out\n 129: \n 130: # --------------- generator (attempt_1_distractor_network) ---------------\n 131: \n 132: # ========================== CFG ==========================\n 133: # Canvas / grid\n 134: GRID_H_RANGE = (8, 30)             # grid height bounds\n 135: GRID_W_RANGE = (8, 30)             # grid width bounds\n 136: BG_COLORS = [0, 5]                 # background color choices\n 137: \n 138: # Seeds\n 139: SEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\n 140: MIN_LINE_LEN = 4                   # discard attempt if line shorter than this\n 141: LINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n 142: \n 143: # Frame loops\n 144: FRAME_COLORS_MAX = 4               # max distinct frame colors\n 145: TOTAL_LOOPS_MAX = 9                # max total loop