vertical) legend patch.\"\"\"\n 160:     span = _legend_span(hole_count)\n 161:     if arrangement == \"horizontal\":\n 162:         patch = np.full((3, span), int(color), dtype=int)\n 163:         if hole_count:\n 164:             patch[1, 1::2] = BG\n 165:     else:\n 166:         patch = np.full((span, 3), int(color), dtype=int)\n 167:         if hole_count:\n 168:             patch[1::2, 1] = BG\n 169:     return patch\n 170: \n 171: \n 172: def _line_span(legends: list[tuple[int, int]]) -> int:\n 173:     \"\"\"Total span of legend patches plus 1-cell gaps between them.\"\"\"\n 174:     return sum(_legend_span(h) for h, _ in legends) + len(legends) - 1\n 175: \n 176: \n 177: def _choose_legends(arrangement: str, max_span: int) -> list[tuple[int, int]]:\n 178:     \"\"\"Pick 2-4 legends with distinct hole counts that fit within max_span.\"\"\"\n 179:     count = random.randint(*LEGEND_COUNT_RANGE)\n 180:     combos = [holes for holes in itertools.combinations(range(MAX_HOLE_COUNT), count)\n 181:               if sum(_legend_span(h) for h in holes) + count - 1 <= max_span]\n 182:     if not combos:\n 183:         return _choose_legends(arrangement, max_span + 2)\n 184:     holes = list(random.choice(combos))\n 185:     random.shuffle(holes)\n 186:     colors = random.sample(LEGEND_COLORS, count)\n 187:     return list(zip(holes, colors))\n 188: \n\n 595:     if not np.array_equal(main(grid), expected):\n 596:         return None\n 597:     return grid\n 598: \n 599: \n 600: def generate_input() -> np.ndarray:\n 601:     for _ in range(GEN_RETRIES):\n 602:         try:\n 603:             grid = _gen_attempt()\n 604:         except Exception:\n 605:             grid = None\n 606:         if grid is not None:\n 607:             return grid\n 608:     raise RuntimeError(\"failed to generate e3721c99 input\")\n\n","exit_code":0,"status":"completed"}}
