   # min, max regions per wall color\n 188: MAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\n 189: REGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n 190:     1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n 191: }\n 192: BLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n 193: \n 194: # Yellows\n 195: YELLOWS_PER_REGION = [1, 2]                # choices per region\n 196: MAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n 197: \n 198: # Outer loop\n 199: GEN_RETRIES = 300                          # max attempts in generate_input()\n 200: \n 201: \n 202: # ── Legend patches ────────────────────────────────────────────────\n 203: \n 204: def _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n 205:     \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n 206:     g = np.full((5, 5), fill, dtype=int)\n 207:     g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n 208:     g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n 209:     rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n 210:     return np.rot90(g, rot[(dr, dc)])\n 211: \n 212: \n 213: def _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n 214:     \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n 215:     g = np.full((6, 7), fill, dtype=int)\n 216:     g[1, 3] = 1\n 217:     g[2, 1] = 1; g[2, 4] = 1\n 218:     g[3, 2] = 1; g[3, 5] = 2\n 219:     g[4, 3] = 2\n 220:     if (dr, dc) == (1, 1): return g\n 221:     if (dr, dc) == (-1, 1): return np.flipud(g)\n\n 599:     if not _oracle_check(input_grid, regions):\n 600:         return None\n 601:     return input_grid\n 602: \n 603: \n 604: def generate_input() -> np.ndarray:\n 605:     rng = random.Random()\n 606:     for _ in range(GEN_RETRIES):\n 607:         try:\n 608:             g = _gen_attempt(rng)\n 609:         except Exception:\n 610:             continue\n 611:         if g is not None:\n 612:             return g\n 613:     raise RuntimeError(\"generate_input: exceeded retries\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/4df5b0ae.py =====\n  21:     for r, c in component[\"coords\"]:\n  22:         sprite[r - r0, c - c0] = int(component[\"color\"])\n  23:     return sprite\n  24: \n  25: \n  26: def main(grid: np.ndarray) -> np.ndarray:\n  27:     \"\"\"Pack the colored sprites along the bottom edge from smallest to largest.\n  28: \n  29:     Input structure\n  30:     The grid has a dominant background color and several monochrome 4-connected\n  31:     foreground sprites; a full-grid one-cell frame may surround the scene.\n  32: \n  33:     Rule\n  34:     Remove any full-grid rectangular frame, sort the remaining sprites by pixel\n  35:     area from smallest to largest, and paste their bounding-box sprites left to\n  36:     right with each sprite bottom-aligned.\n  37: \n  38:     Key insight\n  39:     The original locations do not determine the final slots; each sprite's area\n  40:     gives the packing order, while its shape and color are preserved.\n  41:     \"\"\"\n  42:     g = np.asarray(grid, dtype=int)\n  43:     H, W = g.shape\n  44:     bg = get_bg(g)\n  45: \n  46:     sprites: list[tuple[int, np.ndarray]] = []\n  47:     for component in find_components(g, bg=bg, connectivity=4, monochromatic=True):\n  48:         if _is_full_grid_frame(component, g.shape):\n  49:             continue\n  50:         sprites.append((int(component[\"area\"]), _component_sprite(component, bg)))\n  51: \n  52:     assert sprites\n  53:     areas = [area for area, _sprite in sprites]\n  54:     assert len(areas) == len(set(areas))\n  55: \n  56:     out = np.full_like(g, bg)\n  57:     c = 0\n  58:     for _area, sprite in sorted(sprites, key=lambda item: item[0]):\n  59:         h, w = sprite.shape\n  60:         assert h <= H and c + w <= W\n  61:         paste(out, sprite, H - h, c, transparent=bg)\n  62:         c += w\n  63:     return out\