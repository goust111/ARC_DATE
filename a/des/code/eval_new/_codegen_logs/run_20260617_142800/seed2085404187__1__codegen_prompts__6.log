tructural color forming two components: a large rectangular frame (slot) and a smaller bar with upward projections.\n  20:     - Colored pixels inside the slot mark target columns.\n  21: \n  22:     Rule:\n  23:     - Move the bar upward into the slot so its bottom edge sits one cell above the slot's interior bottom.\n  24:     - Shift it horizontally so the bar's upward projections align column-wise with the colored pixels in the slot.\n  25:     - Stack the colored pixels immediately above the bar projections in each column.\n  26: \n  27:     Key insight: The bar's projections act as keys that must align with the colored-column \"locks\" in the slot.\n  28:     \"\"\"\n  29:     g = np.asarray(grid, dtype=int)\n  30:     h, w = g.shape\n  31: \n  32:     # Background: most frequent. \"Grey\" structural color: most frequent non-bg.\n  33:     bg = _bg_color(g)\n  34:     other = g[g != bg]\n  35:     if other.size == 0:\n  36:         return g.copy()\n  37:     grey = _most_common(other)\n  38: \n  39:     def comps_of_color(color: int):\n  40:         comps = [(len(pts), _bbox(pts), pts) for pts in _cc4(g == color)]\n  41:         comps.sort(key=lambda t: (-t[0], t[1]))\n  42:         return comps\n  43: \n  44:     grey_comps = comps_of_color(grey)\n  45:     if len(grey_comps) < 2:\n  46:         return g.copy()\n  47: \n  48:     # Slot is the largest grey component (the right-side frame); bar is the next largest.\n  49:     (_, slot_bbox, _), (_, bar_bbox, bar_pts) = grey_comps[0], grey_comps[1]\n  50:     sr0, sc0, sr1, sc1 = slot_bbox\n  51: \n  52:     # Base output: keep only the slot bbox content, clear all colored pixels inside it.\n  53:     out = np.full_like(g, bg)\n  54:     out[sr0 : sr1 + 1, sc0 : sc1 + 1] = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n  55:     slot_region = out[sr0 : sr1 + 1, sc0 : sc1 + 1]\n  56:     slot_region[(slot_region != bg) & (slot_region != grey)] = bg\n  57: \n  58:     # Compute bar translation: bottom of bar sits 1 cell above slot interior bottom.\n  59:     bar_base_row = max(r for r, _ in bar_pts)\n  60:     slot_interior_bottom = sr1 - 1\n  61:     target_base_row = slot_interior_bottom - 1\n  62:     dy = target_base_row - bar_base_row\n  63: \n  64:     # Determine bar projection columns (columns with any bar pixel above the base row).\n  65:     col_min_row = {}\n  66:     for r, c in bar_pts:\n  67:         col_min_row[c] = min(col_min_row.get(c, r), r)\n  68:     src_proj_cols = sorted([c for c, rmin in col_min_row.items() if rmin < bar_base_row])\n  69: \n  70:     # Determine destination columns from colored pixels in the original slot.\n  71:     dst_cols_set = set()\n  72:     for r, c in np.argwhere((g != bg) & (g != grey)):\n  73:         r = int(r)\n  74:         c = int(c)\n  75:         if sr0 <= r <= sr1 and sc0 <= c <= sc1:\n  76:             dst_cols_set.add(c)\n  77:     dst_cols = sorted(dst_cols_set)\n  78: \n  79:     # Compute a robust horizontal shift aligning projection columns to colored columns.\n  80:     dx = None\n  81:     if src_proj_cols and len(src_proj_cols) == len(dst_cols):\n  82:         deltas = [d - s for s, d in zip(src_proj_cols, dst_cols)]\n  83:         if len(set(deltas)) == 1:\n  84:             dx = deltas[0]\n  85:     if dx is None:\n  86:         # Brute pick dx that maximizes overlap of shifted projection cols with dst cols.\n  87:         best = (-1, 0)\n  88:         dst_set = set(dst_cols)\n  89:         for cand_dx in range(-w, w + 1):\n  90:             score = sum((c + cand_dx) in dst_set for c in src_proj_cols)\n  91:             if score > best[0]:\n  92:                 best = (score, cand_dx)\n  93:         dx = best[1]\n  94: \n  95:     # Paste bar into the slot (overwrite with grey).\n  96:     placed = []\n  97:     for r, c in bar_pts:\n  98:         rr = r + dy\n  99:         cc = c + dx\n 100:         if sr0 <= rr <= sr1 and sc0 <= cc <= sc1:\n 101:             out[rr, cc] = grey\n 102:             placed.append((rr, c