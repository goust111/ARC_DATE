+            for cc in range(max(0, c - 1), min(w, c + 2)):
+                blocked[rr, cc] = True
+
+
+def _try_place_shape(grid: np.ndarray, blocked: np.ndarray, shape, sh: int, sw: int, color: int) -> bool:
+    h, w = grid.shape
+    if h - sh <= 1 or w - sw <= 1:
