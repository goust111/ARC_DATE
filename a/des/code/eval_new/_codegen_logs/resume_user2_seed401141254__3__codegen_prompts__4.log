+        for r, c in coords:
+            grid[r, c] = color
+        _mark_blocked(blocked, coords)
+        return True
+    return False
+
+
+def _place_legend(grid: np.ndarray, blocked: np.ndarray, legend: list[int]):
+    h, w = grid.shape
+    edge = str(_RNG.choice(["top", "bottom", "left", "right"]))
