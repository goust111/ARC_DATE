+    else:
+        col = 0 if edge == "left" else w - 1
+        start = int(_RNG.integers(0, h - len(legend) + 1))
+        for offset, color in enumerate(legend):
+            coord = (start + offset, col)
+            coords.append(coord)
+            grid[coord] = color
