+    for _ in range(4):
+        if cur_coords not in seen:
+            seen.add(cur_coords)
+            rotations.append((cur_coords, cur_h, cur_w))
+        cur_coords, cur_h, cur_w = _rotate_once(cur_coords, cur_h, cur_w)
+    return rotations
+
+
+def _edge_components(mask: np.ndarray):
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
