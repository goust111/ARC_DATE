+    neighbors = [[] for _ in range(count)]
+    for i in range(count):
+        for j in range(i + 1, count):
+            info = _pair_info(components[i], components[j])
+            if info is None:
+                continue
+            pair_map[(i, j)] = info
+            neighbors[i].append(j)
+            neighbors[j].append(i)
