+                    "coords": coords,
+                    "bbox": (min(rs), min(cs), max(rs), max(cs)),
+                    "shape": norm,
+                    "shape_h": sh,
+                    "shape_w": sw,
+                    "area": len(coords),
+                    "rotations": _unique_rotations(norm, sh, sw),
+                }
