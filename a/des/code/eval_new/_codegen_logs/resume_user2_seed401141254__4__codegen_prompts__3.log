def _snake_hole(area: int) -> np.ndarray:
    q, rem = divmod(int(area), _SNAKE_HOLE_WIDTH)
    coords = []
    if rem == 0:
        for r in range(max(0, q - 1)):
            coords.extend((r, c) for c in range(_SNAKE_HOLE_WIDTH))
