+    _paint_patch(grid, arrow, shift_r + ar, shift_c + ac)
+    _paint_patch(grid, bar, shift_r + br, shift_c + bc)
+    return grid
+
+
+def _gen_attempt() -> np.ndarray | None:
+    subject = _make_subject_patch()
