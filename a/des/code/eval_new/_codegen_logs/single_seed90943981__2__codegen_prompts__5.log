+    for comp in _components(g == bg):
+        if 2 <= len(comp) <= 5 and not _touches_border(comp, g.shape):
+            neighbor_colors = {
+                int(g[nr, nc])
+                for r, c in comp
+                for nr, nc in _neighbors4(r, c)
