+            (row_lo, row_hi), (col_lo, col_hi) = ranges
+            for _ in range(100):
+                top = rng.randint(row_lo, row_hi)
+                left = rng.randint(col_lo, col_hi)
+                cells = _translate_shape(shape, top, left)
