+    source_indices = set(rng.sample(range(hole_count), source_count))
+    source_fill = {hole_idx: palette[hole_count + offset] for offset, hole_idx in enumerate(sorted(source_indices))}
+
+    grid = np.full((grid_h, grid_w), bg, dtype=int)
+
