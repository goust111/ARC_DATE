+            ph, pw = patch.shape
+            grid[top_h + 1 + r0 : top_h + 1 + r0 + ph, c0 : c0 + pw] = patch
+
+        expected = grid.copy()
+        for patch, spec, (r0, c0) in zip(frame_patches, frame_specs, frame_positions, strict=False):
+            ph, pw = patch.shape
+            rr0 = top_h + 1 + r0 + 1
+            rr1 = top_h + 1 + r0 + ph - 1
+            cc0 = c0 + 1
+            cc1 = c0 + pw - 1
+            expected[rr0:rr1, cc0:cc1] = spec["fill_color"]
+
+        try:
