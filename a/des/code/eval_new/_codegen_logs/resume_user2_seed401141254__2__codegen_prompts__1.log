+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(int(r), int(c))]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
