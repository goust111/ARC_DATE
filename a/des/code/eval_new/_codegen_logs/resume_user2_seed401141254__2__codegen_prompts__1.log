+    top_reserved = sum((int(p.shape[0]) + 2 * KEY_PAD) * (int(p.shape[1]) + 2 * KEY_PAD) for p in key_patches)
+    bottom_reserved = sum((int(p.shape[0]) + 2 * FRAME_PAD) * (int(p.shape[1]) + 2 * FRAME_PAD) for p in frame_patches)
