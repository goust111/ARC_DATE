+def _gap_sort_key(gap: dict) -> tuple[int, int]:
+    side_order = {"top": 0, "bottom": 1, "left": 2, "right": 3}
+    if gap["side"] in ("top", "bottom"):
+        pos = int(gap["coords"][0][1])
