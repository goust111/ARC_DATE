+    return sorted(gaps, key=_gap_sort_key)
+
+
+def _find_marker_for_gap(
+    grid: np.ndarray,
+    bg: int,
+    frame_color: int,
+    bbox: tuple[int, int, int, int],
+    gap: dict,
