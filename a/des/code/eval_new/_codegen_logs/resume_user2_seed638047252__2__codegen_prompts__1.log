+
+
+def _mark_blocked(blocked: np.ndarray, cells: list[tuple[int, int]]) -> None:
+    h, w = blocked.shape
+    for r, c in cells:
+        for rr in range(max(0, int(r) - 1), min(h, int(r) + 2)):
+            for cc in range(max(0, int(c) - 1), min(w, int(c) + 2)):
