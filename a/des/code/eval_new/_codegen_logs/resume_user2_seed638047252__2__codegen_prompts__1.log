+
+def _run_segments(line_mask: np.ndarray) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    start: int | None = None
+    for i, present in enumerate(bool(v) for v in line_mask):
+        if present and start is None:
