+def _shape_key(coords: np.ndarray) -> tuple[int, int, tuple[tuple[int, int], ...]]:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    rel = tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))
+    h = int(coords[:, 0].max() - r0 + 1)
+    w = int(coords[:, 1].max() - c0 + 1)
