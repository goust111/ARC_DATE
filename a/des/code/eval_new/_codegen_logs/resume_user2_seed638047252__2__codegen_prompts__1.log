+                            int(np.sum(bottom == int(frame_color))),
+                            int(np.sum(left == int(frame_color))),
+                            int(np.sum(right == int(frame_color))),
+                        ]
+                        if min(side_hits) <= 0:
+                            continue
+
+                        interior = grid[r0 + 1 : r1, c0 + 1 : c1]
+                        if int(np.sum(interior == int(frame_color))) != 0:
