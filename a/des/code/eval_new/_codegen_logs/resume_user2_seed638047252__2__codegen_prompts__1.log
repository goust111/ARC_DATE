+            for r, c in comp["coords"]
+        )
+        if touches_frame:
+            continue
+        pieces_by_key[_shape_key(comp["coords"])].append(comp)
+
+    for bucket in pieces_by_key.values():
+        bucket.sort(key=lambda comp: tuple(map(int, comp["bbox"])))
