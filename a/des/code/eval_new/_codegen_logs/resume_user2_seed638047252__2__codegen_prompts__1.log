+def _place_side_segments(edge_len: int, lengths: list[int]) -> list[tuple[int, int]]:
+    if not lengths:
+        return []
+    for _ in range(200):
+        used = np.zeros(edge_len, dtype=bool)
+        placed: list[tuple[int, int]] = []
+        order = list(int(x) for x in lengths)
+        RNG.shuffle(order)
+        ok = True
+        for length in order:
