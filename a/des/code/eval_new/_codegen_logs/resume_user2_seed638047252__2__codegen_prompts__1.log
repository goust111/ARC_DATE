+        candidate_groups = [
+            [(int(r0 + 1), int(c)) for c in span],
+            [(int(r0), int(c)) for c in span],
+        ]
+    elif side == "left":
+        span = [int(r) for r, _c in coords]
+        candidate_groups = [
+            [(int(r), int(c1 - 1)) for r in span],
+            [(int(r), int(c1)) for r in span],
