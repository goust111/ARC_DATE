+        if piece_cells is None:
+            return None
+        matches.append(
+            {
+                "gap_cells": [(int(r), int(c)) for r, c in gap["coords"]],
+                "piece_cells": piece_cells,
+                "marker_pos": tuple(map(int, gap["marker_pos"])),
+                "marker_color": int(gap["marker_color"]),
+            }
+        )
