+def _topological_order(pairs: list[tuple[int, int]]) -> list[int]:
+    colors: list[int] = []
+    seen: set[int] = set()
+    for upper, lower in pairs:
+        if upper not in seen:
+            seen.add(upper)
+            colors.append(upper)
+        if lower not in seen:
+            seen.add(lower)
+            colors.append(lower)
