+        if parsed is not None and (w == 1 or bool(np.all(g[:, 1] == bg))):
+            pairs, used = parsed
+            mask = np.zeros_like(g, dtype=bool)
+            mask[used, 0] = True
+            colors = {color for pair in pairs for color in pair}
+            candidates.append(((len(pairs), len(colors)), pairs, mask))
