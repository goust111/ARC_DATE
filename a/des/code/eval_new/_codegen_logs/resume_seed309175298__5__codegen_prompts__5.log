+    available = [color for color in colors if indeg[color] == 0]
+    order: list[int] = []
+    while available:
+        color = available.pop(0)
+        order.append(color)
+        for nxt in colors:
+            if nxt not in outgoing[color]:
+                continue
+            indeg[nxt] -= 1
+            if indeg[nxt] == 0:
+                available.append(nxt)
