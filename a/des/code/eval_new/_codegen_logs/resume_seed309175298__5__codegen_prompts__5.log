+        elif len(cols) == 1:
+            col = int(cols[0])
+            active = np.where((g[:, col] != bg) & (~legend_mask[:, col]))[0]
+            assert active.size > 0
+            vertical[color] = (col, int(active.min()), int(active.max()))
+        else:
+            raise AssertionError("each stripe color must occupy exactly one row or one column")
