+def _find_legend(g: np.ndarray, bg: int) -> tuple[list[tuple[int, int]], np.ndarray]:
+    h, w = g.shape
+    candidates: list[tuple[tuple[int, int], list[tuple[int, int]], np.ndarray]] = []
