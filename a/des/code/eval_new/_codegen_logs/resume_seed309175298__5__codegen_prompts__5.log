+    used = np.zeros(line.shape[0], dtype=bool)
+    for start, end in _runs(line != bg):
+        length = end - start + 1
+        if length < 2 or length % 2 != 0:
+            return None
+        for r in range(start, end + 1, 2):
+            top = int(line[r])
+            bottom = int(line[r + 1])
+            if top == bg or bottom == bg or top == bottom:
+                return None
+            pairs.append((top, bottom))
+            used[r : r + 2] = True
+    if len(pairs) < 2:
+        return None
+    return pairs, used
