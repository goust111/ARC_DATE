+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+
+# Generator bounds.
+GEN_ATTEMPTS = 400
+COLOR_COUNT_RANGE = (3, 5)
+EXTRA_RELATION_PROB = 0.6
+MAX_EXTRA_RELATIONS = 3
