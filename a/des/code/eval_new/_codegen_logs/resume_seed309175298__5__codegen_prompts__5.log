+    outgoing: dict[int, set[int]] = defaultdict(set)
+    indeg = {color: 0 for color in colors}
+    for upper, lower in pairs:
+        if lower not in outgoing[upper]:
+            outgoing[upper].add(lower)
+            indeg[lower] += 1
