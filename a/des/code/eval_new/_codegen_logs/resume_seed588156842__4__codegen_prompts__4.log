+    if r == bottom and left < c < right:
+        return "bottom"
+    if c == left and top < r < bottom:
+        return "left"
+    if c == right and top < r < bottom:
+        return "right"
+    raise ValueError("gap must lie on a non-corner border cell")
+
+
