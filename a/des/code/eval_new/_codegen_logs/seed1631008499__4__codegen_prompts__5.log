+        stack = [(r, c)]
+        seen[r, c] = True
+        coords = []
+        while stack:
+            cr, cc = stack.pop()
+            coords.append((cr, cc))
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                nr = cr + dr
+                nc = cc + dc
