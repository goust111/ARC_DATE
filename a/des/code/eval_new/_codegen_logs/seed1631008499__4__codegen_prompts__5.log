+    if legend_col >= total_w - right_margin:
+        return None
+    legend_row0 = random.randint(0, total_h - frame_count)
+    for i, color in enumerate(legend_colors):
+        grid[legend_row0 + i, legend_col] = int(color)
+
+    grey_occ = np.zeros_like(grid, dtype=bool)
+    objects: list[dict] = []
+
