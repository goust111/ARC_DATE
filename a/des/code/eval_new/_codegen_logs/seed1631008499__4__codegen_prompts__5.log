+    shape_cells = np.argwhere(shape_mask)
+    sh, sw = shape_mask.shape
+    rows = list(range(grid.shape[0] - sh + 1))
+    cols = list(range(grid.shape[1] - sw + 1))
+    random.shuffle(rows)
+    random.shuffle(cols)
