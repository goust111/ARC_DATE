+    for bbox, color in zip(frames, frame_colors):
+        r0, c0, r1, c1 = bbox
+        pixel_count = 2 * ((r1 - r0 + 1) + (c1 - c0 + 1)) - 4
+        sizes.append((pixel_count, int(color)))
