+    np.array([[0, 1, 0], [1, 1, 1]], dtype=bool),
+)
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        stack = [(r, c)]
+        seen[r, c] = True
+        coords = []
+        while stack:
+            cr, cc = stack.pop()
+            coords.append((cr, cc))
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                nr = cr + dr
+                nc = cc + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+        comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _frame_info(grid: np.ndarray, coords: np.ndarray) -> dict | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 3 or w < 3:
+        return None
+    if int(coords.shape[0]) != 2 * (h + w) - 4:
+        return None
+
+    rel = coords - np.array([r0, c0], dtype=int)
+    on_border = (
+        (rel[:, 0] == 0)
+        | (rel[:, 0] == h - 1)
+        | (rel[:, 1] == 0)
+        | (rel[:, 1] == w - 1)
+    )
+    if not bool(np.all(on_border)):
+        return None
+
+    color = int(grid[int(coords[0, 0]), int(coords[0, 1])])
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    if not bool(np.all(sub[0, :] == color)):
+        return None
+    if not bool(np.all(sub[-1, :] == color)):
+        return None
+    if not bool(np.all(sub[:, 0] == color)):
+        return None
+    if not bool(np.all(sub[:, -1] == color)):
+        return None
+
+    return {
+        "color": color,
+        "bbox": (r0, c0, r1, c1),
+        "pixels": int(coords.shape[0]),
+        "bbox_area": h * w,
+        "coords": coords,
+    }
