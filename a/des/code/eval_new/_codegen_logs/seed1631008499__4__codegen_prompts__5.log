from __future__ import annotations

import random
from collections import Counter

import numpy as np


BG = 0
GREY = 5
COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
FRAME_COUNT_OPTIONS = (2, 4)
GEN_ATTEMPTS = 300

SHAPES = (
