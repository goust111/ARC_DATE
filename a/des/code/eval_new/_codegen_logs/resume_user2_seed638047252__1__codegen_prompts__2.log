+            candidates = []
+            for r0 in range(1, H - ph):
+                for c0 in range(right_start, W - pw):
+                    coords = piece_coords + np.array([r0, c0])
+                    if np.any(blocked[coords[:, 0], coords[:, 1]]):
+                        continue
+                    candidates.append((r0, c0, coords))
+            if not candidates:
+                failed = True
+                break
