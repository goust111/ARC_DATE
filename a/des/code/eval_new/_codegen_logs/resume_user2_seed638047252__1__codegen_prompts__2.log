+    order = sorted(range(len(pieces)), key=lambda i: (len(candidates[i]), -int(pieces[i]["area"])))
+    assignment = [-1] * len(pieces)
+    used: set[int] = set()
+
+    def search(idx: int) -> bool:
+        if idx == len(order):
+            return True
+        pi = order[idx]
+        for hi in candidates[pi]:
+            if hi in used:
+                continue
+            used.add(hi)
+            assignment[pi] = hi
+            if search(idx + 1):
+                return True
+            used.remove(hi)
+            assignment[pi] = -1
+        return False
