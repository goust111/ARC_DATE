+def _foreground_components(grid: np.ndarray, bg: int) -> list[dict]:
+    comps: list[dict] = []
+    for color in sorted(set(map(int, np.unique(grid))) - {bg}):
+        for coords in _components(grid == color):
+            r0, c0, r1, c1 = _bbox(coords)
