+        w = random.randint(2, 4)
+        max_area = min(6, h * w - 1)
+        if max_area < 3:
+            continue
+        area = random.randint(3, max_area)
+        start = (random.randrange(h), random.randrange(w))
+        cells = {start}
+        while len(cells) < area:
+            frontier = []
+            for r, c in cells:
+                for nr, nc in _neighbors4(r, c, h, w):
+                    if (nr, nc) not in cells:
+                        frontier.append((nr, nc))
+            if not frontier:
+                break
+            cells.add(random.choice(frontier))
+        if len(cells) != area:
+            continue
+
+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in cells:
+            mask[r, c] = True
+        mask = _trim_mask(mask)
+
+        if min(mask.shape) < 2:
+            continue
+        if mask.all():
+            continue
+        if len({_mask_key(np.rot90(mask, k)) for k in range(4)}) < 4:
+            continue
+        return mask
+
+    raise RuntimeError("failed to generate an asymmetric connected shape")
+
+
+def _mark_blocked(blocked: np.ndarray, coords: np.ndarray) -> None:
+    h, w = map(int, blocked.shape)
+    for r, c in coords:
+        r = int(r)
+        c = int(c)
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr = r + dr
+                nc = c + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    blocked[nr, nc] = True
+
+
+def _generate_holes() -> list[dict]:
+    count = random.randint(2, 4)
+    shapes: list[np.ndarray] = []
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    for _ in range(SHAPE_RETRIES * 2):
+        if len(shapes) == count:
+            break
+        mask = _random_shape()
+        key = _canonical_rotation_key(mask)
+        if key in seen:
