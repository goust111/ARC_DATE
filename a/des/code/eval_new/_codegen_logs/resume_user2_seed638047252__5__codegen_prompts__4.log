+MAX_RETRIES = 300
+GROUP_ATTEMPTS = 250
+GROUP_COUNT_OPTIONS = (1, 2, 3)
+GRID_MIN = 12
+GRID_MAX = 30
+SHAPE_BOX_MIN = 1
+SHAPE_BOX_MAX = 4
+SHAPE_AREA_MAX = 6
+WALL_PAD_MAX = 4
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
