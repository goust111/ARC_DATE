+import numpy as np
+from collections import deque
+
+
+WALL_COLOR = 9
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+# --------------- generator config ---------------
+
+RNG = np.random.default_rng()
+MAX_RETRIES = 300
+GROUP_ATTEMPTS = 250
+GROUP_COUNT_OPTIONS = (1, 2, 3)
