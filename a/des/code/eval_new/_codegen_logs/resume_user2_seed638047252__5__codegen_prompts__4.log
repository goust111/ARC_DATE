+    add_frontier(start)
+    while len(cells) < area:
+        if not frontier:
+            return None
+        choices = tuple(frontier)
+        pick = choices[int(RNG.integers(len(choices)))]
+        frontier.remove(pick)
+        cells.add(pick)
+        add_frontier(pick)
