+    for c in range(start, stop + 1):
+        color = int(grid[wall_row, c])
+        if color in (BG, MAGENTA, ORANGE):
+            continue
+        if (
+            int(grid[wall_row, c - 1]) == color
+            and int(grid[wall_row, c + 1]) == color
+            and grid[wall_row - 1, c] == BG
+            and grid[wall_row + 1, c] == BG
