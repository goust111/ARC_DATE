+    return grid, rooms
+
+
+def _vertical_positions(grid: np.ndarray, left: Rect, right: Rect) -> list[tuple[int, int]]:
+    lr0, lr1, _lc0, lc1 = left
+    rr0, rr1, rc0, _rc1 = right
+    if lc1 + 2 != rc0:
+        return []
+    wall_col = lc1 + 1
+    start = max(lr0, rr0) + 1
+    stop = min(lr1, rr1) - 1
