+def _colors_in_scan_order(grid: np.ndarray) -> list[int]:
+    order: list[int] = []
+    seen: set[int] = set()
+    for value in grid.ravel():
+        color = int(value)
+        if color == BG or color in seen:
+            continue
+        seen.add(color)
+        order.append(color)
+    return order
