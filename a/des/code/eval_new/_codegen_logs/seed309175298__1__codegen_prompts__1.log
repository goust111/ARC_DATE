+    h, w = mask.shape
+    center_r = (h - 1) / 2.0
+    center_c = (w - 1) / 2.0
+    out = np.zeros_like(mask, dtype=bool)
+    for r, c in np.argwhere(mask):
+        dr = float(r) - center_r
+        dc = float(c) - center_c
