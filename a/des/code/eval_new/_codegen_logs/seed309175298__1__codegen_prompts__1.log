+    out = g[2:].copy()
+    colors = [int(c) for c in np.unique(out) if int(c) != bg and int(c) in legend]
+    frames: list[tuple[int, tuple[int, int, int, int]]] = []
+    for color in colors:
+        for comp in _components_mask(out == int(color)):
+            if _is_rectangular_frame(comp):
