+    center_r = (h - 1) / 2.0
+    center_c = (w - 1) / 2.0
+    out = np.zeros_like(mask, dtype=bool)
+    for r, c in np.argwhere(mask):
+        dr = float(r) - center_r
+        dc = float(c) - center_c
+        if clockwise:
+            nr = center_r + dc
+            nc = center_c - dr
+        else:
+            nr = center_r - dc
+            nc = center_c + dr
+        rr = int(round(nr))
+        cc = int(round(nc))
+        if abs(nr - rr) > 1e-6 or abs(nc - cc) > 1e-6:
+            continue
