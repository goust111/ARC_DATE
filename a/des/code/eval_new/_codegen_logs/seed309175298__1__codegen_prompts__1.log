+def _parse_legend(row: np.ndarray, bg: int) -> dict[int, bool]:
+    mapping: dict[int, bool] = {}
+    c = 0
+    width = int(row.shape[0])
+    while c <= width - 3:
+        left = int(row[c])
+        mid = int(row[c + 1])
+        right = int(row[c + 2])
