+from __future__ import annotations
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+AZURE = 8
+MAROON = 9
+
+INPUT_COLORS = np.array([BLUE, RED, GREEN, MAGENTA, ORANGE, AZURE, MAROON], dtype=int)
+
+GEN_RETRIES = 300
+FRAME_PATTERN_RETRIES = 200
+LAYOUT_RETRIES = 80
+OUTPUT_GAP = 1
+INPUT_GAP_RANGE = (2, 5)
+INPUT_PAD_RANGE = (0, 3)
