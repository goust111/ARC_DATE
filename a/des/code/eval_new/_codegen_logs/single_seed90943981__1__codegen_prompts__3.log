+def _neighbors4(pos: tuple[int, int], shape: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = pos
+    h, w = shape
+    out = []
+    for dr, dc in DIRS4:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            out.append((nr, nc))
+    return out
