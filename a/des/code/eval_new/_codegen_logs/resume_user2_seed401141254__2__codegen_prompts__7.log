+    stack = [(source, start_neighbors[0], source_color, 0)]
+    seen: set[Tuple[Coord, Coord, int]] = set()
+    lights: List[Tuple[int, int, int]] = []
+    while stack:
+        prev, cur, color, node_count = stack.pop()
+        state = (prev, cur, color)
+        if state in seen:
