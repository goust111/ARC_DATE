+        points["B2"] = (dir2 * branch2, n2_col)
+        points["R"] = (0, end_col)
+        edges.extend([("N1", "N2"), ("N2", "B2"), ("N2", "R")])
+    else:
+        points["R"] = (0, first_run + second_run + end_run)
