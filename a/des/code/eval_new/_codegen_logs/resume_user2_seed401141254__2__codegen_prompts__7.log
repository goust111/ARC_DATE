+def _gen_attempt() -> np.ndarray | None:
+    specs = _choose_component_specs()
+    components = [_build_component(kind, color) for kind, color in specs]
+    grid = _assemble_signal_area(components)
+    if grid is None:
+        return None
+    if not _valid_generated_sample(grid):
+        return None
+    return grid
+
