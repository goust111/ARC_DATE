+def _choose_component_specs() -> List[Tuple[str, int]]:
+    pair_colors = [random.choice(group) for group in PAIR_GROUPS]
+    random.shuffle(pair_colors)
+    specs = list(zip(BASE_COMPONENT_KINDS, pair_colors))
+    if random.random() < 0.5:
