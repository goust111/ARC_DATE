+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+CYAN = 8
+MAROON = 9
+
+PAIR_COLOR = {
+    RED: GREEN,
+    GREEN: RED,
+    BLUE: YELLOW,
+    YELLOW: BLUE,
+    ORANGE: MAGENTA,
+    MAGENTA: ORANGE,
+}
+
+PAIR_GROUPS = ((RED, GREEN), (BLUE, YELLOW), (ORANGE, MAGENTA))
+EXTRA_SOURCE_COLORS = (CYAN, MAROON)
+
+ROTATIONS = (0, 1, 2, 3)
+BASE_COMPONENT_KINDS = ("straight", "t_chain", "cross_t")
+EXTRA_COMPONENT_KINDS = ("straight", "t_chain")
