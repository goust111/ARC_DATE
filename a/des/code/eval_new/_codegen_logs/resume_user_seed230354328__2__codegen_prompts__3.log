+def _wall_indices(grid: np.ndarray) -> tuple[list[int], list[int]]:
+    h, w = grid.shape
+    wall_rows = [r for r in range(h) if int(np.count_nonzero(grid[r])) > w // 2]
+    wall_cols = [c for c in range(w) if int(np.count_nonzero(grid[:, c])) > h // 2]
