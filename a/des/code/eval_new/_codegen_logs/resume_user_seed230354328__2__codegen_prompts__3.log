+    h, w = g.shape
+    wall_rows, wall_cols = _wall_indices(g)
+    row_spans = _room_spans(wall_rows, h)
+    col_spans = _room_spans(wall_cols, w)
+
+    out = g.copy()
+    keys_to_erase: set[tuple[int, int]] = set()
+    walls_to_open: set[tuple] = set()
