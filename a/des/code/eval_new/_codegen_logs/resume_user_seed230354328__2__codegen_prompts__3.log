+def _room_spans(bounds: list[int], limit: int) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    extended = [-1, *bounds, limit]
+    for i in range(len(extended) - 1):
+        start = extended[i] + 1
+        end = extended[i + 1] - 1
+        if start <= end:
+            spans.append((start, end))
+    return spans
