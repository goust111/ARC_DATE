+def _random_interval(rng: random.Random, length: int) -> tuple[int, int, int]:
+    start = rng.randint(1, length - 4)
+    end = rng.randint(start + 1, length - 2)
+    ext = rng.randint(1, 3)
+    return start, end, ext
+
