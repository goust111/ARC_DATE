+    if left is None:
+        vertices.append((0, 0))
+    else:
+        a, b, ext = left
+        vertices.extend([(b, 0), (b, -ext), (a, -ext), (a, 0), (0, 0)])
+
+    shifted = [(r, c + left_ext) for r, c in vertices]
