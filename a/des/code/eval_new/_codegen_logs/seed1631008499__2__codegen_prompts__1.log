+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MAROON = 9
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SEED_COLORS = [1, 2, 3, 4, 6, 7, 8]
+PATTERNS = [
+    ((0, 1), (1, 0), (1, 1), (1, 2)),
+    ((0, 2), (1, 0), (1, 1), (2, 1)),
+    ((0, 1), (1, 1), (1, 2), (2, 0), (2, 1)),
+    ((0, 1), (1, 0), (1, 1), (1, 2), (2, 1)),
+    ((0, 1), (1, 1), (1, 2), (2, 2)),
+    ((0, 2), (1, 0), (1, 1), (2, 0), (2, 1)),
+]
+
+GRID_MIN = 22
+GRID_MAX = 30
+TEMPLATE_BAND = 6
+GEN_ATTEMPTS = 400
+PLACE_ATTEMPTS = 80
