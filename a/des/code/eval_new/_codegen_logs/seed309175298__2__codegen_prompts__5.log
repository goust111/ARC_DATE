+        if extra_h not in chosen_rows:
+            chosen_rows[-1] = extra_h
+        chosen_rows = sorted(set(chosen_rows))
+        while len(chosen_rows) < count:
+            for row in range(extra_h + 1):
+                if row not in chosen_rows:
