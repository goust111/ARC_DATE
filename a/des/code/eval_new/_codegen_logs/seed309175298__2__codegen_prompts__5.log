+import random
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+AZURE = 8
+PALETTE = (1, 2, 3, 4, 6, 7, 9)
+INNER_SIZES = ((5, 5), (5, 6), (6, 5), (6, 6))
+BRANCHES = ("row", "col", "both")
