+def _coverage_map(offsets: list[tuple[int, int]], inner_h: int, inner_w: int, master_h: int, master_w: int) -> dict:
+    coverage: dict[tuple[int, int], list[int]] = {}
+    for r in range(master_h):
+        for c in range(master_w):
+            covers = [
