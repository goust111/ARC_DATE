rea < max(h, w):\n                continue\n            dims.append((h, w))\n    return dims\n\n\ndef _line_mask(h: int, w: int) -> np.ndarray:\n    \"\"\"Create a seed mask along a diagonal line spanning the bbox, randomly flipped.\"\"\"\n    mask = np.zeros((h, w), dtype=bool)\n    if h == 1:\n        mask[0, :] = True\n","exit_code":0,"status":"completed"}}
