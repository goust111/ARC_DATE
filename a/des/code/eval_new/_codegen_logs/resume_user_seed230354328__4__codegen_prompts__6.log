+def _place_objects(
+    rng: random.Random, grid: np.ndarray, objects: list[tuple[np.ndarray, np.ndarray]]
+) -> bool:
+    h, w = grid.shape
+    occupied = np.zeros((h, w), dtype=bool)
+    pad = 2
+
