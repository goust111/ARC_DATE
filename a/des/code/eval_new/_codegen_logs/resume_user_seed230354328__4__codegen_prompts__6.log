+def _place_objects(
+    rng: random.Random, grid: np.ndarray, objects: list[np.ndarray]
+) -> bool:
+    h, w = grid.shape
+    occupied = np.zeros((h, w), dtype=bool)
+    pad = 2
+
+    order = list(range(len(objects)))
+    rng.shuffle(order)
+    placements: list[tuple[int, int, np.ndarray]] = []
+
+    for idx in order:
+        obj = objects[idx]
+        oh, ow = obj.shape
+        if oh + 2 * pad > h or ow + 2 * pad > w:
+            return False
+
+        placed = False
+        for _ in range(120):
+            r0 = rng.randint(pad, h - oh - pad)
+            c0 = rng.randint(pad, w - ow - pad)
+            rr0 = max(0, r0 - pad)
+            rr1 = min(h, r0 + oh + pad)
+            cc0 = max(0, c0 - pad)
+            cc1 = min(w, c0 + ow + pad)
