+def _boundary_distance(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    dist = np.full((h, w), -1, dtype=int)
+    q = deque()
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            if any(not mask[nr, nc] for nr, nc in _neighbors4(r, c, h, w)):
+                dist[r, c] = 0
+                q.append((r, c))
