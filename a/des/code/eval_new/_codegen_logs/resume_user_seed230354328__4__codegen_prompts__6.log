+        counts = [rng.randint(1, 3) for _ in range(n_objects)]
+        if n_objects + sum(counts) <= 9:
+            return counts
+    if n_objects == 3:
+        return [2, 2, 2]
+    if n_objects == 2:
+        return [3, 3]
+    return [3]
