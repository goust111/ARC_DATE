+    grid = np.full((h, w), bg, dtype=int)
+    if not _place_objects(rng, grid, objects):
+        return None
+
+    vals, counts = np.unique(grid, return_counts=True)
+    if int(vals[np.argmax(counts)]) != bg:
+        return None
+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return None
+
+    return grid
+
