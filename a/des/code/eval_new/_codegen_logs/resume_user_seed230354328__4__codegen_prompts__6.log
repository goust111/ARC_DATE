+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _boundary_distance(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    dist = np.full((h, w), -1, dtype=int)
+    q = deque()
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            if r == 0 or c == 0 or r == h - 1 or c == w - 1 or any(
+                not mask[nr, nc] for nr, nc in _neighbors4(r, c, h, w)
+            ):
+                dist[r, c] = 0
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c, h, w):
+            if mask[nr, nc] and dist[nr, nc] == -1:
+                dist[nr, nc] = dist[r, c] + 1
+                q.append((nr, nc))
+
+    return dist
+
+
+def _single_pixel_seeds(grid: np.ndarray, bg: int) -> np.ndarray:
