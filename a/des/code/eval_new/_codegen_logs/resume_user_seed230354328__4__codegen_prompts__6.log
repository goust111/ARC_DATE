# ── CFG: tunable generation parameters ──────────────────────────────────────
GRID_SIZE_MIN, GRID_SIZE_MAX = 7, 27       # square grid side length
BAR_LEN_MIN, BAR_LEN_MAX = 3, 7           # bar length (px)
BAR_CLEARANCE = 4                           # n must exceed bar_len by this much
