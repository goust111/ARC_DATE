+def _draw_frame(grid: np.ndarray, frame_bbox: tuple[int, int, int, int]) -> None:
+    r0, c0, r1, c1 = frame_bbox
+    mid_r = (r0 + r1) // 2
+    mid_c = (c0 + c1) // 2
+    grid[r0, c0 : c1 + 1] = FRAME_COLOR
+    grid[r1, c0 : c1 + 1] = FRAME_COLOR
+    grid[r0 : r1 + 1, c0] = FRAME_COLOR
+    grid[r0 : r1 + 1, c1] = FRAME_COLOR
+    grid[mid_r, c0 : c1 + 1] = FRAME_COLOR
+    grid[r0 : r1 + 1, mid_c] = FRAME_COLOR
+
+
+def _random_shape(rng: random.Random) -> np.ndarray:
+    base = rng.choice(SHAPE_LIBRARY)
+    rotated = np.rot90(base, rng.randrange(4))
+    color = 1
+    return np.where(rotated == 1, color, 0).astype(int)
+
+
+def _colorize_shape(shape: np.ndarray, color: int) -> np.ndarray:
