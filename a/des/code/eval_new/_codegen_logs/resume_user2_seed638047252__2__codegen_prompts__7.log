+def _marker_positions(frame_bbox: tuple[int, int, int, int]) -> dict[str, tuple[int, int]]:
+    r0, c0, r1, c1 = frame_bbox
+    side = r1 - r0 + 1
+    q = (side - 3) // 2
+    top_r = r0 + 1 + q // 2
+    bot_r = r0 + q + 2 + q // 2
+    left_c = c0 + 1 + q // 2
+    right_c = c0 + q + 2 + q // 2
+    return {
+        "tl": (top_r, left_c),
+        "tr": (top_r, right_c),
+        "bl": (bot_r, left_c),
+        "br": (bot_r, right_c),
+    }
+
+
+def _compass_top_left(side: str, h: int, w: int) -> tuple[int, int]:
+    if side == "top":
+        return 0, w // 2 - 1
+    if side == "bottom":
+        return h - 3, w // 2 - 1
+    if side == "left":
+        return h // 2 - 1, 0
+    return h // 2 - 1, w - 3
