+
+def _paste_non_bg(dst: np.ndarray, patch: np.ndarray, top: int, left: int, bg: int) -> None:
+    h, w = patch.shape
+    for r in range(h):
+        for c in range(w):
+            val = int(patch[r, c])
+            if val == bg:
