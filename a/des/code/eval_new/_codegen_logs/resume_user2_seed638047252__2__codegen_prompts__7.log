+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _crop_color_component(grid: np.ndarray, coords: np.ndarray, bg: int) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(coords)
+    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+    for r, c in coords:
+        patch[int(r) - r0, int(c) - c0] = int(grid[int(r), int(c)])
+    return patch
+
+
+def _paste_non_bg(dst: np.ndarray, patch: np.ndarray, top: int, left: int, bg: int) -> None:
+    h, w = patch.shape
+    for r in range(h):
+        for c in range(w):
+            val = int(patch[r, c])
+            if val == bg:
+                continue
+            rr, cc = top + r, left + c
+            if 0 <= rr < dst.shape[0] and 0 <= cc < dst.shape[1]:
+                dst[rr, cc] = val
+
+
+def _quadrant_bounds(
+    frame_bbox: tuple[int, int, int, int]
+) -> dict[str, tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = frame_bbox
+    mid_r = (r0 + r1) // 2
+    mid_c = (c0 + c1) // 2
+    return {
+        "tl": (r0 + 1, mid_r, c0 + 1, mid_c),
+        "tr": (r0 + 1, mid_r, mid_c + 1, c1),
+        "bl": (mid_r + 1, r1, c0 + 1, mid_c),
+        "br": (mid_r + 1, r1, mid_c + 1, c1),
+    }
