+    colored: list[dict[str, object]] = []
+    relay_colors = rng.sample(RELAY_COLORS, relay_count)
+    relay_idx = 0
+
+    for spec in active_specs:
+        spec2 = dict(spec)
+        if spec["role"] == "emitter":
+            spec2["color"] = RED
+        elif spec["role"] == "terminal":
+            spec2["color"] = GREY
