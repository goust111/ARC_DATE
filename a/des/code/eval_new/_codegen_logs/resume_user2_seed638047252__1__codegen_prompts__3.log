+def _try_place_arrow(
+    head: tuple[int, int],
+    direction: str,
+    shape: tuple[int, int],
+    occupied_buffer: set[tuple[int, int]],
+    reserved_path: set[tuple[int, int]],
+) -> Optional[set[tuple[int, int]]]:
