+    if local.shape == LEFT_PATTERN.shape and np.array_equal(local, LEFT_PATTERN):
+        return _tower_shape(r0, c0 + 2, LEFT)
+    if local.shape == RIGHT_PATTERN.shape and np.array_equal(local, RIGHT_PATTERN):
