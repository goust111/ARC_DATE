+            value = int(g[r, c])
+            if value not in (BLACK, GRAY):
+                ray_color = int(value)
+            rec_id = receiver_lookup.get((r, c))
+            if rec_id is not None and ray_color is not None:
+                for rr, cc in receivers[rec_id]["cells"]:
+                    out[rr, cc] = int(ray_color)
+            r += dr
+            c += dc
+
+    return out
