+        step = _choice(DIRS)
+        if step == UP:
+            if h < 11 or w < 5:
+                return None
+            lo_r, hi_r = 8, h - 3
+            lo_c, hi_c = 1, w - 4
+        elif step == DOWN:
+            if h < 11 or w < 5:
+                return None
+            lo_r, hi_r = 0, h - 11
+            lo_c, hi_c = 1, w - 4
+        elif step == LEFT:
+            if h < 5 or w < 11:
+                return None
+            lo_r, hi_r = 1, h - 4
+            lo_c, hi_c = 8, w - 3
+        else:
+            if h < 5 or w < 11:
+                return None
+            lo_r, hi_r = 1, h - 4
+            lo_c, hi_c = 0, w - 11
+        if lo_r > hi_r or lo_c > hi_c:
+            continue
