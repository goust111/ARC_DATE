+def _cell_to_rays(paths: list[list[tuple[int, int]]]) -> dict[tuple[int, int], set[int]]:
+    mapping: dict[tuple[int, int], set[int]] = {}
+    for idx, path in enumerate(paths):
+        for cell in path:
