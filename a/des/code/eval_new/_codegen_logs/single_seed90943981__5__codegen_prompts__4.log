+
+def _gray_placeable(
+    cells: tuple[tuple[int, int], ...],
+    shape: tuple[int, int],
+    occupied_any: set[tuple[int, int]],
+    occupied_gray: set[tuple[int, int]],
+) -> bool:
+    h, w = shape
+    cell_set = set(cells)
+    for r, c in cells:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        if (r, c) in occupied_any:
