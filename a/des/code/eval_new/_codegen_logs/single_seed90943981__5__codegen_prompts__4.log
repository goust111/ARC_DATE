+        if receiver_opts:
+            feasible.append("receiver_no_relay")
+        if any(any(idx < opt["start_index"] for idx, _cell in relay_cells) for opt in receiver_opts):
+            feasible.append("paint_receiver")
+        branch_sets.append(feasible)
+    return branch_sets
