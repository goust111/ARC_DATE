from collections import Counter
import numpy as np

PRIORITY = [1,2,3,4,5,6,7,8,9]
priority_index = {c:i for i,c in enumerate(PRIORITY)}
RNG = np.random.default_rng(0)


def most_common(arr):
    vals, counts = np.unique(arr, return_counts=True)
    return int(vals[np.argmax(counts)])


def comps(mask):
    h,w = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    out=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            stack=[(r,c)]
            seen[r,c]=True
            pts=[]
            while stack:
                x,y = stack.pop()
                pts.append((x,y))
                for nx,ny in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):
                    if 0<=nx<h and 0<=ny<w and mask[nx,ny] and not seen[nx,ny]:
                        seen[nx,ny]=True
                        stack.append((nx,ny))
            out.append(np.array(pts, dtype=int))
    return out


def bbox(coords):
    return tuple(map(int,[coords[:,0].min(), coords[:,1].min(), coords[:,0].max(), coords[:,1].max()]))


def choose_fill(colors):
    ctr=Counter(map(int,colors))
    mf=min(ctr.values())
    cand=[c for c,n in ctr.items() if n==mf]
    return min(cand, key=lambda c: priority_index[c])


def main(g):
    g=np.asarray(g, dtype=int)
    vals, counts = np.unique(g, return_counts=True)
    bg=int(vals[np.argmax(counts)])
    h,w=g.shape
    hrows=[r for r in range(h) if np.all(g[r,:]"'!=bg)]
    vcols=[c for c in range(w) if np.all(g[:,c]!=bg)]
    non_v=np.array([c for c in range(w) if c not in set(vcols)], dtype=int)
    non_h=np.array([r for r in range(h) if r not in set(hrows)], dtype=int)
    hr_col={}
    for r in hrows:
        samples = g[r, non_v] if non_v.size else g[r,:]
        hr_col[r]=most_common(samples)
    vc_col={}
    for c in vcols:
        samples = g[non_h, c] if non_h.size else g[:, c]
        vc_col[c]=most_common(samples)
    out=g.copy()
    for cc in comps(g==bg):
        if any(r in (0,h-1) or c in (0,w-1) for r,c in cc):
            continue
        r0,c0,r1,c1=bbox(cc)
        if not np.all(g[r0:r1+1, c0:c1+1] == bg):
            continue
        fill=choose_fill([hr_col[r0-1], hr_col[r1+1], vc_col[c0-1], vc_col[c1+1]])
        out[r0:r1+1, c0:c1+1]=fill
    return out


def sample_axis(n):
    min_dim=max(14, 2*n-1)
    dim=int(RNG.integers(min_dim, 31))
    extras=dim-(2*n-1)
    buckets=np.zeros(n+1, dtype=int)
    for _ in range(extras):
        buckets[int(RNG.integers(0,n+1))]+=1
    pos=[int(buckets[0])]
    for extra in buckets[1:-1]:
        pos.append(pos[-1] + 2 + int(extra))
    return dim,pos


def sample_counts(n_colors, total):
    add=[0]*n_colors
    extras=total-2*n_colors
    while extras>0:
        i=int(RNG.integers(0,n_colors))
        if add[i]<2:
            add[i]+=1
            extras-=1
    return [2+a for a in add]


def expected(grid, hr, hc, vr, vc):
    out=grid.copy()
    for i in range(len(hr)-1):
        for j in range(len(vr)-1):
            r0,r1=hr[i]+1, hr[i+1]
            c0,c1=vr[j]+1, vr[j+1]
            fill=choose_fill([hc[i], hc[i+1], vc[j], vc[j+1]])
            out[r0:r1, c0:c1]=fill
    return out

for t in range(100):
    ok=False
    for _ in range(1000):
        n_colors=int(RNG.choice([3,4]))
        hn=int(RNG.integers(n_colors, 6))
        vn=int(RNG.integers(n_colors, 6))
        total=hn+vn
        if not (2*n_colors <= total <= 4*n_colors):
            continue
        colors=list(RNG.choice(PRIORITY, size=n_colors, replace=False))
        counts=sample_counts(n_colors, total)
        slots=[]
        for color,count in zip(colors,counts):
            slots.extend([int(color)]*int(count))
        RNG.shuffle(slots)
        hcols=slots[:hn]
        vcols=slots[hn:]
        if len(set(hcols))<2 or len(set(vcols))<2:
            continue
        saw_u=saw_t=False
        fills=set()
        for i in range(hn-1):
            for j in range(vn-1):
                cs=[hcols[i],hcols[i+1],vcols[j],vcols[j+1]]
                ctr=Counter(cs)
                mins=[c for c,n in ctr.items() if n==min(ctr.values())]
