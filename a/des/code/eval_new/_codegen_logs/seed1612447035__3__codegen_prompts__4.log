            if not np.array_equal(main(grid),exp):
                print('"'mismatch', t)
                print(grid)
                print(main(grid))
                print(exp)
                raise SystemExit
            ok=True
            break
    if not ok:
        raise RuntimeError('no sample')
print('ok')
