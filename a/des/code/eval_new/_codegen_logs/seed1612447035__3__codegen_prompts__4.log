+
+    chosen_colors = [int(c) for c in RNG.choice(COLOR_PRIORITY, size=color_count, replace=False)]
+    counts = _sample_color_counts(color_count, total_lines)
+
+    for _ in range(ASSIGNMENT_RETRIES):
