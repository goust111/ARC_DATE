+    lim = min(5, min(inner_h, inner_w) - 1)
+    colors = [c for c in range(10) if c not in (bg, MARKER_COLOR, frame_color)]
+    for _ in range(BOX_SPEC_RETRIES):
+        ph = rng.randint(2, lim)
