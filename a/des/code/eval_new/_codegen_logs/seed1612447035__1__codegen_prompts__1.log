+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GAP_TO_TURNS = {"top": 0, "right": 1, "bottom": 2, "left": 3}
+MARKER_COLOR = 5
+GEN_RETRIES = 400
+BOX_SPEC_RETRIES = 120
+PLACEMENT_RETRIES = 200
