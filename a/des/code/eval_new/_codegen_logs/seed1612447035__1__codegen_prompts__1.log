+    cols = [c for _, c in pts]
+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
+    outer_h = r1 - r0 + 1
+    outer_w = c1 - c0 + 1
+    if outer_h < 4 or outer_w < 4:
+        return None
+
+    border = set()
+    for c in range(c0, c1 + 1):
+        border.add((r0, c))
+        border.add((r1, c))
+    for r in range(r0, r1 + 1):
+        border.add((r, c0))
+        border.add((r, c1))
+
+    comp = set(pts)
+    if not comp.issubset(border):
+        return None
+
+    missing = [cell for cell in border if cell not in comp]
+    if len(missing) != 1:
+        return None
+    gap_r, gap_c = missing[0]
+    if gap_r in (r0, r1) and gap_c in (c0, c1):
+        return None
+    if gap_r == r0:
+        gap_side = "top"
+    elif gap_r == r1:
+        gap_side = "bottom"
+    elif gap_c == c0:
+        gap_side = "left"
+    elif gap_c == c1:
+        gap_side = "right"
+    else:
+        return None
+
+    marker_positions = [
+        (r0 - 1, c0 - 1),
+        (r0 - 1, c1 + 1),
+        (r1 + 1, c0 - 1),
+        (r1 + 1, c1 + 1),
+    ]
+    h, w = grid.shape
+    if any(not (0 <= r < h and 0 <= c < w) for r, c in marker_positions):
+        return None
+    marker_colors = [int(grid[r, c]) for r, c in marker_positions]
+    if any(col == bg for col in marker_colors):
+        return None
+    if len(set(marker_colors)) != 1:
