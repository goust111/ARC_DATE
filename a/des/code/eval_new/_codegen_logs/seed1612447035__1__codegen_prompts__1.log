+def _bbox_from_mask(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return None
+    r0 = int(pts[:, 0].min())
+    c0 = int(pts[:, 1].min())
+    r1 = int(pts[:, 0].max())
+    c1 = int(pts[:, 1].max())
+    return r0, c0, r1, c1
+
+
+def _crop_non_bg(arr: np.ndarray, bg: int) -> np.ndarray:
+    box = _bbox_from_mask(arr != bg)
+    if box is None:
+        return np.zeros((0, 0), dtype=int)
+    r0, c0, r1, c1 = box
+    return arr[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _center_interior(patch: np.ndarray, shape: tuple[int, int], bg: int) -> np.ndarray:
+    h, w = shape
+    canvas = np.full((h, w), bg, dtype=int)
+    if patch.size == 0:
+        return canvas
+    ph, pw = patch.shape
+    top = (h - ph) // 2
+    left = (w - pw) // 2
+    mask = patch != bg
+    canvas[top : top + ph, left : left + pw][mask] = patch[mask]
+    return canvas
+
+
+def _same_color_components(grid: np.ndarray, bg: int) -> list[tuple[int, list[tuple[int, int]]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[tuple[int, list[tuple[int, int]]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c]:
+                continue
+            color = int(grid[r, c])
+            if color == bg:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            pts = [(r, c)]
+            while q:
+                cr, cc = q.popleft()
+                for dr, dc in DIR4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
