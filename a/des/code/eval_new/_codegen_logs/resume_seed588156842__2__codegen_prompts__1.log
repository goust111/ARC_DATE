+                    gap = _find_gap(grid, bg, wall, top, left, bottom, right)
+                    if boundary_bg_count == 1 and gap is None:
+                        continue
+                    if boundary_bg_count == 0 and gap is not None:
+                        continue
+
+                    candidates.append(
+                        {
+                            "top": int(top),
+                            "left": int(left),
+                            "bottom": int(bottom),
+                            "right": int(right),
+                            "seed": (int(seed_r), int(seed_c)),
+                            "seed_color": int(grid[seed_r, seed_c]),
+                            "gap": gap,
