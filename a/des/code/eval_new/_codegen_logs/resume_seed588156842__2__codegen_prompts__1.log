+_BG = 0
+_WALL = 5
+_SEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+_LAYOUTS = ((1, 4), (4, 1), (2, 2), (2, 3), (3, 2), (2, 4), (4, 2))
+_DIM_CHOICES = (3, 4, 5)
