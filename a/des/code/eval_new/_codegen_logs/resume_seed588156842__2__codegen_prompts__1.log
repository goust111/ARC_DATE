+    assert candidates, f"no valid rectangle found for seed {(seed_r, seed_c)}"
+    keys = {(c["top"], c["left"], c["bottom"], c["right"]) for c in candidates}
+    assert len(keys) == 1, f"seed {(seed_r, seed_c)} matched multiple regions"
+    return candidates[0]
