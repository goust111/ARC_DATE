+def _rect_sum(ps: np.ndarray, top: int, left: int, bottom: int, right: int) -> int:
+    if top > bottom or left > right:
+        return 0
+    return int(
+        ps[bottom + 1, right + 1]
+        - ps[top, right + 1]
+        - ps[bottom + 1, left]
+        + ps[top, left]
+    )
