+# A small commutative but non-associative mixing algebra over five visible colors.
+_MIX_INDEX = np.array(
+    [
+        [0, 3, 4, 2, 1],
+        [3, 1, 0, 4, 2],
+        [4, 0, 2, 1, 3],
+        [2, 4, 1, 3, 0],
+        [1, 2, 3, 0, 4],
+    ],
