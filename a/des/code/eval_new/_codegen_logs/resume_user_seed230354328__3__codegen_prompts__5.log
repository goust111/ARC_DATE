+    return palette, color_indices, mix_map
+
+
+def _paint_rooms(
+    grid: np.ndarray,
+    n_rows: int,
+    n_cols: int,
+    row_lines: list[int],
+    col_lines: list[int],
+    palette: list[int],
+    color_indices: list[int],
+) -> None:
+    for i in range(n_rows):
+        for j in range(n_cols):
+            rid = _room_id(n_cols, i, j)
+            color = int(palette[color_indices[rid]])
+            rr0 = row_lines[i] + 1
+            rr1 = row_lines[i + 1] - 1
+            cc0 = col_lines[j] + 1
+            cc1 = col_lines[j + 1] - 1
