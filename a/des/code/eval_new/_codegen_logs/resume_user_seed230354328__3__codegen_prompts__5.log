+
+# --------------- generator ---------------
+
+def _room_id(n_cols: int, i: int, j: int) -> int:
+    return i * n_cols + j
+
+
+def _room_neighbors(n_rows: int, n_cols: int) -> dict[int, list[int]]:
+    neighbors: dict[int, list[int]] = {}
+    for i in range(n_rows):
+        for j in range(n_cols):
