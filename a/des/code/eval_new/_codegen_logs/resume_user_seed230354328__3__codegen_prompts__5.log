+            y = int(grid[r + 1, c + 1])
+            if a in (bg, divider) or b in (bg, divider):
+                continue
+            result: int | None = None
+            if x not in (bg, divider) and y == bg:
+                result = x
+            elif y not in (bg, divider) and x == bg:
+                result = y
+            if result is None:
+                continue
