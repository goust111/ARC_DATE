+        sub = mask[r0 : r1 + 1, c0 : c1 + 1]
+        row_hits = int(np.sum(sub.sum(axis=1) >= max(2, (sub.shape[1] + 1) // 2)))
+        col_hits = int(np.sum(sub.sum(axis=0) >= max(2, (sub.shape[0] + 1) // 2)))
