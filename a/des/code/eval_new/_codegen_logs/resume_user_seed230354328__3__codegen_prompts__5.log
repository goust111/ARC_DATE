+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    bg = _most_common_color(g)
+    divider = _find_divider_color(g, bg)
+    rooms, partition_bbox, _, _ = _extract_rooms(g, bg, divider)
+    mix_map = _parse_legend(g, bg, divider, partition_bbox)
