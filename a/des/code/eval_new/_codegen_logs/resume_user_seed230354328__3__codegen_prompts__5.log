+    out = g.copy()
+    for room in rooms:
+        new_color = int(room["color"])
+        for neighbor_color in _ordered_neighbor_colors(room):
+            new_color = _mix_colors(new_color, neighbor_color, mix_map)
+        rr0, cc0, rr1, cc1 = room["bbox"]
+        out[rr0 : rr1 + 1, cc0 : cc1 + 1] = new_color
