+
+def _legend_patch(entries: list[tuple[int, int, int, bool]], rows: int, cols: int) -> np.ndarray:
+    patch = np.full((rows * 3 - 1, cols * 3 - 1), BG, dtype=int)
+    for idx, (a, b, result, put_right) in enumerate(entries):
+        rr = (idx // cols) * 3
+        cc = (idx % cols) * 3
