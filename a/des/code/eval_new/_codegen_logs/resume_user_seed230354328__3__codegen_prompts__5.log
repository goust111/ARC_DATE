+    for size in col_sizes:
+        cur += size + 1
+        col_lines.append(cur)
+
+    grid[row_lines, part_c0 : col_lines[-1] + 1] = DIVIDER_COLOR
+    grid[part_r0 : row_lines[-1] + 1, col_lines] = DIVIDER_COLOR
