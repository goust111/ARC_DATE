+    equal_edges = [edge for edge in edges if counts[edge[0]] == counts[edge[1]]]
+    diff_edges = [edge for edge in edges if counts[edge[0]] != counts[edge[1]]]
+    forced_open = rng.choice(equal_edges)
+    forced_closed = rng.choice(diff_edges)
