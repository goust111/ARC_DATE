+def _partition_intervals(sizes: list[int], offset: int) -> tuple[list[int], list[tuple[int, int]]]:
+    lines = [offset]
+    intervals = []
+    cursor = offset
+    for size in sizes:
+        start = cursor + 1
+        end = start + size - 1
+        intervals.append((start, end))
+        cursor = end + 1
+        lines.append(cursor)
