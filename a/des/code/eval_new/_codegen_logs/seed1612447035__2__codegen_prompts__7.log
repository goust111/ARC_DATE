+    for start in range(len(rooms)):
+        if seen[start]:
+            continue
+        queue = deque([start])
+        seen[start] = True
+        members = []
+        open_doors = set()
+        while queue:
+            rid = queue.popleft()
+            members.append(rid)
+            for other, door_pos in graph[rid]:
+                open_doors.add(door_pos)
+                if not seen[other]:
