+            b = int(room_id[r + 1, c])
+        if a < 0 or b < 0 or a == b:
+            continue
+        open_door = room_item_counts[a] == room_item_counts[b]
+        door_edges.append((r, c, a, b, open_door))
+        if open_door:
+            graph[a].append((b, (r, c)))
+            graph[b].append((a, (r, c)))
