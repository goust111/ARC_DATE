+    bg = 0
+    pad = 2
+
+    part_h = sum(row_sizes) + n_rows + 1
+    part_w = sum(col_sizes) + n_cols + 1
+    grid = np.full((part_h + 2 * pad, part_w + 2 * pad), bg, dtype=int)
