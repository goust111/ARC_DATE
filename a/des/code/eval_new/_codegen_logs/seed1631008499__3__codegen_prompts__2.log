import random
from collections import deque

def connected(mask):
    h=len(mask); w=len(mask[0])
    cells=[(r,c) for r in range(h) for c in range(w) if mask[r][c]]
    if not cells:
        return False
    q=deque([cells[0]])
    seen={cells[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
            rr,cc=r+dr,c+dc
            if 0<=rr<h and 0<=cc<w and mask[rr][cc] and (rr,cc) not in seen:
                seen.add((rr,cc)); q.append((rr,cc))
    return len(seen)==len(cells)

def bbox_full(mask):
    h=len(mask); w=len(mask[0])
    cells=[(r,c) for r in range(h) for c in range(w) if mask[r][c]]
    if not cells:
        return False
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    return min(rs)==0 and max(rs)==h-1 and min(cs)==0 and max(cs)==w-1

def grow(h,w,tries=10000):
    area=h*w
    for _ in range(tries):
        target=random.randint(max(4, area//3-2), min(area-4, area*2//3+2))
        if area%2==0 and target==area//2:
            continue
        start=(random.randrange(h), random.randrange(w))
        A={start}; B={(r,c) for r in range(h) for c in range(w) if (r,c)"'!=start}
        while len(A)<target:
            frontier=[]
            for r,c in A:
                for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
                    rr,cc=r+dr,c+dc
                    if 0<=rr<h and 0<=cc<w and (rr,cc) in B:
                        frontier.append((rr,cc))
            random.shuffle(frontier)
            progress=False
            # prioritize touching unhit borders
            hit_top=any(r==0 for r,c in A); hit_bot=any(r==h-1 for r,c in A); hit_left=any(c==0 for r,c in A); hit_right=any(c==w-1 for r,c in A)
            def score(cell):
                r,c=cell
                s=0
                s+= (not hit_top and r==0)
                s+= (not hit_bot and r==h-1)
                s+= (not hit_left and c==0)
                s+= (not hit_right and c==w-1)
                return s
            frontier=sorted(set(frontier), key=lambda x:(score(x), random.random()), reverse=True)
            for cell in frontier:
                B2=B-{cell}
                # B connected
                if not B2:
                    continue
                # bfs B2
                st=next(iter(B2))
                q=deque([st]); seen={st}
                while q:
                    r,c=q.popleft()
                    for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
                        rr,cc=r+dr,c+dc
                        if (rr,cc) in B2 and (rr,cc) not in seen:
                            seen.add((rr,cc)); q.append((rr,cc))
                if len(seen)!=len(B2):
                    continue
                A.add(cell); B=B2; progress=True; break
            if not progress:
                break
        if len(A)!=target:
            continue
        mask=[[False]*w for _ in range(h)]
        for r,c in A: mask[r][c]=True
        comp=[[not mask[r][c] for c in range(w)] for r in range(h)]
        if connected(mask) and connected(comp) and bbox_full(mask) and bbox_full(comp):
            return target, mask
    return None

for h,w in [(4,4),(4,5),(5,5),(4,6),(5,6),(6,6)]:
    counts=0
    for _ in range(100):
        if grow(h,w,tries=300):
            counts+=1
    print((h,w), counts)
