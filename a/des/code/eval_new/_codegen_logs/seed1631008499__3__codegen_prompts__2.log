+    row_starts: list[int] = []
+    pos = gaps_h[0]
+    for idx in range(rows):
+        row_starts.append(int(pos))
+        pos += int(box_h) + gaps_h[idx + 1]
+
+    col_starts: list[int] = []
+    pos = gaps_w[0]
+    for idx in range(cols):
+        col_starts.append(int(pos))
+        pos += int(box_w) + gaps_w[idx + 1]
