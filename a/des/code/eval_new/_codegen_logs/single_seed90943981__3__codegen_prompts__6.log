+        if counts[idx] > best_value:
+            best_idx = idx
+            best_value = counts[idx]
+    return SIDES[best_idx]
+
+
+def _is_tied(counts: tuple[int, int, int, int]) -> bool:
+    max_count = max(counts)
+    return sum(v == max_count for v in counts) > 1
