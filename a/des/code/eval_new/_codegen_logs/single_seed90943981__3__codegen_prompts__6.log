+def _pick_nonadjacent(
+    candidates: list[tuple[int, int]], count: int, rng: random.Random
+) -> list[tuple[int, int]] | None:
+    if count == 0:
+        return []
+    valid: list[tuple[tuple[int, int], ...]] = []
+    for combo in itertools.combinations(candidates, count):
+        ok = True
