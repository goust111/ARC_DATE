+        stripe_rows = set(sorted({r for r, _ in interior})[::2])
+        for r, c in interior:
+            if r in stripe_rows:
+                out[r, c] = fill_color
+    else:
+        stripe_cols = set(sorted({c for _, c in interior})[::2])
+        for r, c in interior:
+            if c in stripe_cols:
