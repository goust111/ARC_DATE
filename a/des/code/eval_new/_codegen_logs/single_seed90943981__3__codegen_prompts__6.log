+    for r in range(inner_h):
+        if inner_h == 1:
+            left = tl
+            right = tr
+        else:
+            left = int(round(tl + (bl - tl) * r / (inner_h - 1)))
+            right = int(round(tr + (br - tr) * r / (inner_h - 1)))
