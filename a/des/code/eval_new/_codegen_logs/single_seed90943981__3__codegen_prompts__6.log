+from __future__ import annotations
+
+import itertools
+import random
+from collections import deque
+
+import numpy as np
+
+
+SIDES = ("top", "right", "bottom", "left")
+GEN_BG = 0
+GEN_WALL = 3
+PALETTE_CHOICES = (1, 2, 4, 5, 6, 7, 8, 9)
+GRID_H_RANGE = (19, 29)
+GRID_W_RANGE = (19, 29)
+ROOM_COUNT_RANGE = (2, 4)
+ROOM_SIDE_RANGE = (4, 7)
+GEN_RETRIES = 400
+ROOM_SHAPE_RETRIES = 120
+PLACEMENT_RETRIES = 120
+ROOM_CLEARANCE = 1
+PALETTE_GAP_ROWS = 1
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, cnts = np.unique(grid, return_counts=True)
+    order = np.argsort(-cnts)
+    assert len(order) == 1 or cnts[order[0]] > cnts[order[1]], "expected a unique background color"
+    return int(vals[order[0]])
+
+
+def _neighbors(r: int, c: int, connectivity: int) -> list[tuple[int, int]]:
+    if connectivity == 4:
+        return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+    return [
+        (r - 1, c - 1),
+        (r - 1, c),
+        (r - 1, c + 1),
+        (r, c - 1),
+        (r, c + 1),
+        (r + 1, c - 1),
+        (r + 1, c),
+        (r + 1, c + 1),
+    ]
+
+
+def _components(mask: np.ndarray, connectivity: int) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors(cr, cc, connectivity):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_palette_row(grid: np.ndarray, bg: int) -> tuple[int, list[int]]:
+    h, _w = grid.shape
+    for r in range(h - 1, -1, -1):
+        cols = np.flatnonzero(grid[r] != bg)
+        if len(cols) != 4:
+            continue
+        colors = [int(grid[r, c]) for c in cols]
+        if len(set(colors)) != 4:
+            continue
+        return int(r), colors
+    raise AssertionError("expected a bottom palette row with four distinct colors")
+
+
+def _recover_room(
+    grid: np.ndarray, wall_component: list[tuple[int, int]], bg: int
+) -> tuple[list[tuple[int, int]], dict[str, int], tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = _bbox(wall_component)
+    local_h = r1 - r0 + 1
+    local_w = c1 - c0 + 1
+    wall = np.zeros((local_h, local_w), dtype=bool)
+    for r, c in wall_component:
+        wall[r - r0, c - c0] = True
+
+    gap_candidates: list[tuple[int, int]] = []
+    for r in range(local_h):
+        for c in range(local_w):
+            if wall[r, c] or int(grid[r0 + r, c0 + c]) != bg:
+                continue
+            horizontal_bridge = 0 < c < local_w - 1 and wall[r, c - 1] and wall[r, c + 1]
+            vertical_bridge = 0 < r < local_h - 1 and wall[r - 1, c] and wall[r + 1, c]
+            if horizontal_bridge ^ vertical_bridge:
+                gap_candidates.append((r, c))
+
+    assert 1 <= len(gap_candidates) <= 4, "each room must expose one to four detectable gaps"
+
+    sealed = wall.copy()
+    for r, c in gap_candidates:
+        sealed[r, c] = True
+
+    outside = np.zeros_like(sealed, dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    for r in range(local_h):
+        for c in range(local_w):
+            if r not in (0, local_h - 1) and c not in (0, local_w - 1):
+                continue
+            if sealed[r, c] or outside[r, c]:
+                continue
+            outside[r, c] = True
+            q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors(r, c, 4):
+            if 0 <= nr < local_h and 0 <= nc < local_w and not sealed[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+
+    interior_local = [
+        (r, c)
+        for r in range(local_h)
+        for c in range(local_w)
+        if not sealed[r, c] and not outside[r, c]
+    ]
+    assert interior_local, "sealed wall must enclose a nonempty interior"
+    interior_set = set(interior_local)
+
+    side_counts = {side: 0 for side in SIDES}
+    for r, c in gap_candidates:
+        touching_sides: list[str] = []
+        if (r + 1, c) in interior_set:
+            touching_sides.append("top")
+        if (r, c - 1) in interior_set:
+            touching_sides.append("right")
+        if (r - 1, c) in interior_set:
+            touching_sides.append("bottom")
+        if (r, c + 1) in interior_set:
+            touching_sides.append("left")
+        assert len(touching_sides) == 1, "each gap must belong to exactly one room side"
+        side_counts[touching_sides[0]] += 1
+
+    interior_global = [(r0 + r, c0 + c) for r, c in interior_local]
+    return interior_global, side_counts, (r0, c0, r1, c1)
+
+
+def _extract_structure(
+    grid: np.ndarray,
+) -> tuple[int, int, list[int], int, list[tuple[list[tuple[int, int]], dict[str, int], tuple[int, int, int, int]]]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    bg = _most_common_color(g)
+    palette_row, palette = _find_palette_row(g, bg)
+
+    trimmed = g.copy()
+    trimmed[palette_row, :] = bg
+    vals, cnts = np.unique(trimmed, return_counts=True)
+    non_bg = [(int(v), int(c)) for v, c in zip(vals, cnts, strict=False) if int(v) != bg]
+    assert non_bg, "expected wall color above the palette row"
+    non_bg.sort(key=lambda item: (-item[1], item[0]))
+    wall_color = non_bg[0][0]
+
+    wall_mask = trimmed == wall_color
+    wall_components = _components(wall_mask, connectivity=8)
+    rooms = [_recover_room(g, comp, bg) for comp in wall_components]
+    assert rooms, "expected at least one room"
+    return bg, palette_row, palette, wall_color, rooms
