+        if geometry is None:
+            continue
+        gaps = _sample_gap_pattern(
+            geometry["gap_candidates"], total_gaps, major_side, want_tie, rng
+        )
+        if gaps is None:
+            continue
+
+        room_h, room_w = geometry["shape"]
+        room_grid = np.full((room_h, room_w), GEN_BG, dtype=int)
+        wall = set(geometry["wall"]) - gaps
+        for r, c in wall:
