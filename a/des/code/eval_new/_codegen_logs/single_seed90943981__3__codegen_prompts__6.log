+from __future__ import annotations
+
+import itertools
+import random
+from collections import deque
+
+import numpy as np
+
+
+SIDES = ("top", "right", "bottom", "left")
+GEN_BG = 0
+GEN_WALL = 3
+PALETTE_CHOICES = (1, 2, 4, 5, 6, 7, 8, 9)
+GRID_H_RANGE = (19, 29)
+GRID_W_RANGE = (19, 29)
+ROOM_COUNT_RANGE = (2, 4)
+ROOM_SIDE_RANGE = (4, 7)
+GEN_RETRIES = 400
+ROOM_SHAPE_RETRIES = 120
+PLACEMENT_RETRIES = 120
+ROOM_CLEARANCE = 2
+PALETTE_GAP_ROWS = 1
