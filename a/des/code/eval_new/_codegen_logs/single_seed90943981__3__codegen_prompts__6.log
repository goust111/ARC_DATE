+
+def _row_spans(
+    inner_h: int, inner_w: int, tl: int, tr: int, bl: int, br: int
+) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    for r in range(inner_h):
+        if inner_h == 1:
+            left = tl
+            right = tr
+        else:
+            left = int(round(tl + (bl - tl) * r / (inner_h - 1)))
+            right = int(round(tr + (br - tr) * r / (inner_h - 1)))
+        width = inner_w - left - right
+        if width < 3:
+            return []
+        spans.append((left, inner_w - right))
+    return spans
+
+
+def _build_room_geometry(
+    inner_h: int, inner_w: int, tl: int, tr: int, bl: int, br: int
+) -> dict[str, object] | None:
+    spans = _row_spans(inner_h, inner_w, tl, tr, bl, br)
+    if not spans:
+        return None
+
+    room_h = inner_h + 2
+    room_w = inner_w + 2
+    interior: set[tuple[int, int]] = set()
+    for r, (start, stop) in enumerate(spans):
+        for c in range(start, stop):
+            interior.add((r + 1, c + 1))
+
+    wall: set[tuple[int, int]] = set()
+    for r in range(room_h):
+        for c in range(room_w):
+            if (r, c) in interior:
+                continue
+            if any((nr, nc) in interior for nr, nc in _neighbors(r, c, 4)):
+                wall.add((r, c))
+
+    gap_candidates: dict[str, list[tuple[int, int]]] = {side: [] for side in SIDES}
+    for r, c in sorted(wall):
+        touching_sides: list[str] = []
+        if (r + 1, c) in interior:
+            touching_sides.append("top")
+        if (r, c - 1) in interior:
+            touching_sides.append("right")
+        if (r - 1, c) in interior:
+            touching_sides.append("bottom")
+        if (r, c + 1) in interior:
+            touching_sides.append("left")
+        if len(touching_sides) != 1:
+            continue
+        side = touching_sides[0]
+        if side in ("top", "bottom"):
+            if (r, c - 1) in wall and (r, c + 1) in wall:
+                gap_candidates[side].append((r, c))
+        else:
