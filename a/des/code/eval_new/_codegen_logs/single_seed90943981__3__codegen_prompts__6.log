+    patterns = COUNT_PATTERNS[(total_gaps, major_side)]
+    feasible: list[tuple[int, int, int, int]] = []
+    tied: list[tuple[int, int, int, int]] = []
+    untied: list[tuple[int, int, int, int]] = []
+    for pattern in patterns:
