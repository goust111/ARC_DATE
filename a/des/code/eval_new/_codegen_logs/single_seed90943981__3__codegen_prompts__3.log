+    seen = np.zeros_like(wall, dtype=bool)
+    queue: deque[tuple[int, int]] = deque([(0, 0)])
+    seen[0, 0] = True
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in DIR4:
+            rr = r + dr
+            cc = c + dc
+            if not (0 <= rr < h + 2 and 0 <= cc < w + 2):
+                continue
+            if seen[rr, cc] or wall[rr, cc]:
+                continue
+            seen[rr, cc] = True
+            queue.append((rr, cc))
