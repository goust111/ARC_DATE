+def _segment_cells(
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    length: int,
+) -> list[tuple[int, int]]:
+    return [
+        (start[0] + direction[0] * step, start[1] + direction[1] * step)
+        for step in range(length)
+    ]
+
