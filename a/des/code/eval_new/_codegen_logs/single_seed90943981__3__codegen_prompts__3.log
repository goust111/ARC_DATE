+def _bbox_ok(cells: set[tuple[int, int]], limit: int) -> bool:
+    rows = [r for r, _c in cells]
+    cols = [c for _r, c in cells]
+    return max(rows) - min(rows) + 1 <= limit and max(cols) - min(cols) + 1 <= limit
