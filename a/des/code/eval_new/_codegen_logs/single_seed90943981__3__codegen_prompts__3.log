+def _find_full_height_divider(grid: np.ndarray, bg: int) -> tuple[int, int]:
+    h, w = grid.shape
+    matches: list[tuple[int, int]] = []
+    for c in range(1, w - 1):
+        column = grid[:, c]
+        if int(column[0]) == bg:
+            continue
+        if np.all(column == column[0]):
+            matches.append((c, int(column[0])))
