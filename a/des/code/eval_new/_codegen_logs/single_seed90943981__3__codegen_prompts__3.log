+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+BG = 0
+DIVIDER = 8
+PALETTE = (1, 2, 3, 4, 6, 7, 9)
+GEN_ATTEMPTS = 400
+BOUND_LIMIT = 12
+GRID_MAX = 30
