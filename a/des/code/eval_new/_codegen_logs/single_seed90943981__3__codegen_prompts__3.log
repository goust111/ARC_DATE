+def _color_first_seen(left: np.ndarray, color: int) -> tuple[int, int]:
+    coords = np.argwhere(left == color)
+    assert coords.size
+    top = coords[np.lexsort((coords[:, 1], coords[:, 0]))][0]
+    return int(top[0]), int(top[1])
