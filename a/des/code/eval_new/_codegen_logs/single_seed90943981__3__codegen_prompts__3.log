def _turn_count(cells: set[tuple[int, int]]) -> int:
    turns = 0
    deg = _degrees(cells)
    for cell, value in deg.items():
        if value != 2:
            continue
        neighbors = [nei for nei in _neighbors4(cell) if nei in cells]
        if len(neighbors) != 2:
            continue
        dr1 = neighbors[0][0] - cell[0]
        dc1 = neighbors[0][1] - cell[1]
        dr2 = neighbors[1][0] - cell[0]
        dc2 = neighbors[1][1] - cell[1]
        if dr1 != -dr2 or dc1 != -dc2:
            turns += 1
    return turns


def _build_ordered_path(
    fragments: list[dict[str, int]],
    want_closed: bool,
    *,
    bbox_limit: int = BOUND_LIMIT,
) -> set[tuple[int, int]] | None:
    n = len(fragments)
    choices: list[tuple[int, tuple[int, int], tuple[int, int]]] = []
    for idx, fragment in enumerate(fragments):
        for seg_dir in _segment_dirs(fragment["axis"]):
            choices.append((idx, seg_dir, (0, 0)))
    random.shuffle(choices)

    def rec(
        step_idx: int,
        used_mask: int,
        cells: set[tuple[int, int]],
        start: tuple[int, int],
        end: tuple[int, int],
    ) -> set[tuple[int, int]] | None:
        if not _bbox_ok(cells, bbox_limit):
            return None
        if step_idx == n:
            if want_closed:
                delta = (start[0] - end[0], start[1] - end[1])
                if abs(delta[0]) + abs(delta[1]) != 2 or (delta[0] != 0 and delta[1] != 0):
                    return None
                mid = ((start[0] + end[0]) // 2, (start[1] + end[1]) // 2)
                if mid in cells:
                    return None
                closed = set(cells)
                closed.add(mid)
                if not _cycle_ok(closed):
                    return None
                fill = _fill_boundary(closed)
                if fill.shape[0] < 2 or fill.shape[1] < 2:
                    return None
                if _turn_count(closed) < 4:
                    return None
                return closed

            if not _path_ok(cells, start, end):
                return None
            delta = (start[0] - end[0], start[1] - end[1])
            if abs(delta[0]) + abs(delta[1]) == 2 and (delta[0] == 0 or delta[1] == 0):
                mid = ((start[0] + end[0]) // 2, (start[1] + end[1]) // 2)
                if mid not in cells:
                    return None
            if _turn_count(cells) == 0:
                return None
            return set(cells)

        options: list[tuple[int, tuple[int, int], tuple[int, int]]] = []
        for idx, fragment in enumerate(fragments):
            if used_mask & (1 << idx):
                continue
            for seg_dir in _segment_dirs(fragment["axis"]):
                for conn_dir in DIR4:
                    options.append((idx, seg_dir, conn_dir))
        random.shuffle(options)

        for idx, seg_dir, conn_dir in options:
            fragment = fragments[idx]
            gap = (end[0] + conn_dir[0], end[1] + conn_dir[1])
            seg_start = (end[0] + 2 * conn_dir[0], end[1] + 2 * conn_dir[1])
            seg_cells = _segment_cells(seg_start, seg_dir, fragment["length"])
            new_segment = set(seg_cells)
            if gap in cells or gap in new_segment or new_segment & cells:
                continue
            next_cells = set(cells)
            next_cells.add(gap)
            next_cells |= new_segment
            new_end = seg_cells[-1]
            if new_end == start or not _path_ok(next_cells, start, new_end):
                continue
            result = rec(step_idx + 1, used_mask | (1 << idx), next_cells, start, new_end)
            if result is not None:
                return result
        return None

    for first_idx, seg_dir, _dummy in choices:
        seg_cells = _segment_cells((0, 0), seg_dir, fragments[first_idx]["length"])
        cell_set = set(seg_cells)
        start = seg_cells[0]
        end = seg_cells[-1]
        if not _path_ok(cell_set, start, end):
            continue
        result = rec(1, 1 << first_idx, cell_set, start, end)
        if result is not None:
            return result
    return None


def _sample_fragments(want_closed: bool) -> tuple[list[dict[str, int]], set[tuple[int, int]]] | None:
    count_choices = (4, 5) if want_closed else (3, 4, 5)
    for _ in range(120):
        count = random.choice(count_choices)
        fragments = [
            {
                "axis": random.choice(("H", "V")),
                "length": random.randint(2, 5),
            }
            for _ in range(count)
        ]
        boundary = _build_ordered_path(fragments, want_closed)
        if boundary is None:
            continue
        solutions = _enumerate_assemblies(fragments)
        if len(solutions) != 1:
            continue
        if bool(solutions[0]["closed"]) != want_closed:
            continue
        solved = set(solutions[0]["boundary"])
        if _normalize_cells(boundary) != _normalize_cells(solved):
            continue
        return fragments, boundary
    return None


def _place_fragment(
    grid: np.ndarray,
    occupied: np.ndarray,
    color: int,
    axis: str,
    length: int,
    left_w: int,
) -> tuple[int, int] | None:
    h, _w = grid.shape
    row_positions = list(range(h))
    col_positions = list(range(left_w))
    random.shuffle(row_positions)
    random.shuffle(col_positions)

    for r in row_positions:
        for c in col_positions:
            if axis == "H":
                if c + length > left_w:
                    continue
                cells = [(r, c + delta) for delta in range(length)]
            else:
                if r + length > h:
                    continue
                cells = [(r + delta, c) for delta in range(length)]

            ok = True
            for rr, cc in cells:
                for nr in range(rr - 1, rr + 2):
                    for nc in range(cc - 1, cc + 2):
                        if 0 <= nr < h and 0 <= nc < left_w and occupied[nr, nc]:
                            ok = False
                            break
                    if not ok:
                        break
                if not ok:
                    break
            if not ok:
                continue

            for rr, cc in cells:
                occupied[rr, cc] = True
                grid[rr, cc] = color
            return r, c
    return None


def _stacked_output(
    shape_data: list[tuple[tuple[int, int], int, np.ndarray]],
    height: int,
    width: int,
) -> np.ndarray | None:
    out = np.full((height, width), BG, dtype=int)
    row = 0
    for _order_key, color, mask in sorted(shape_data, key=lambda item: item[0]):
        h, w = mask.shape
        if row + h > height or w > width:
            return None
        out[row : row + h, :w][mask] = color
        row += h + 1

