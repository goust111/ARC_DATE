+        return None
+
+    grid = np.full((height, total_w), BG, dtype=int)
+    grid[:, left_w] = DIVIDER
+    occupied = np.zeros((height, left_w), dtype=bool)
+
+    placement_order = list(range(len(groups)))
+    random.shuffle(placement_order)
