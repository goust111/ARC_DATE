+                if mid not in cells:
+                    closed_cells = set(cells)
+                    closed_cells.add(mid)
+                    if _cycle_ok(closed_cells):
+                        key = (True, _normalize_cells(closed_cells))
+                        solutions.setdefault(
+                            key,
+                            {
+                                "closed": True,
+                                "boundary": closed_cells,
