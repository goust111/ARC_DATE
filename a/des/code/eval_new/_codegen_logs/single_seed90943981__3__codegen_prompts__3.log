+                    seg_start = (end[0] + 2 * conn_dir[0], end[1] + 2 * conn_dir[1])
+                    new_cells = _segment_cells(seg_start, seg_dir, fragment["length"])
+                    all_new = set(new_cells)
+                    if gap in cells or gap in all_new:
