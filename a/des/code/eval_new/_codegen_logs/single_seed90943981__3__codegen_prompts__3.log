+        for seg_dir in _segment_dirs(fragment["axis"]):
+            seg_cells = _segment_cells((0, 0), seg_dir, fragment["length"])
+            cell_set = set(seg_cells)
+            start = seg_cells[0]
+            end = seg_cells[-1]
