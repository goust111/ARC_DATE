  31: def main(grid: np.ndarray) -> np.ndarray:
  32:     """
  33:     Pack each solid foreground rectangle twice: wide across the top and tall from the bottom.
  34: 
  35:     Input structure
  36:     The grid has one background color and one foreground color; the foreground forms
  37:     separate solid rectangles, ordered from left to right.
  38: 
  39:     Rule
  40:     Build a 10-row background canvas whose width is the packed width of the wide
  41:     versions of the rectangles. For each source rectangle, paint a top-aligned
  42:     rectangle of shape min(h,w) by max(h,w), with one background column between
  43:     consecutive rectangles. Then, starting again from the left edge, paint a
  44:     bottom-aligned rectangle of shape max(h,w) by min(h,w) for each source rectangle,
  45:     again separated by one background column.
  46: 
  47:     Key insight
  48:     The input rectangles are not copied in their original orientations; each object
  49:     contributes one horizontal-facing and one vertical-facing normalized rectangle,
  50:     preserving left-to-right object order.
  51:     """
  52:     g = np.asarray(grid, dtype=int)
  53:     bg = get_bg(g)
  54:     fg_colors = colors_present(g, exclude={bg})
  55:     assert len(fg_colors) == 1
  56:     fg = fg_colors[0]
  57: 
  58:     components = find_components(g, bg=bg, connectivity=4, colors=[fg])
  59:     assert components
  60:     components = sorted(components, key=lambda obj: (obj["bbox"][1], obj["bbox"][0]))
  61: 
  62:     dims: list[tuple[int, int]] = []
  63:     for obj in components:
  64:         r0, c0, r1, c1 = obj["bbox"]
  65:         h = r1 - r0 + 1
  66:         w = c1 - c0 + 1
  67:         assert obj["area"] == h * w
  68:         dims.append((h, w))
  69: 
  70:     out_h = 10
  71:     out_w = sum(max(h, w) for h, w in dims) + len(dims) - 1
  72:     _assert_output_footprints_disjoint(dims)
  73:     out = np.full((out_h, out_w), bg, dtype=int)
  74: 
  75:     c = 0
  76:     for h, w in dims:
  77:         short, long = min(h, w), max(h, w)
  78:         assert long <= out_h
  79:         out[:short, c : c + long] = fg
  80:         c += long + 1
  81: 
  82:     c = 0
  83:     for h, w in dims:
  84:         short, long = min(h, w), max(h, w)
  85:         assert long <= out_h
  86:         out[out_h - long : out_h, c : c + short] = fg
  87:         c += short + 1
  88: 
  89:     return out
