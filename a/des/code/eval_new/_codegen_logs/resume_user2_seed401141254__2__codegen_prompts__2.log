+def _ray_cells(
+    row: int, col: int, direction: tuple[int, int], steps: int, height: int, width: int
+) -> list[tuple[int, int]]:
+    dr, dc = direction
+    cells: list[tuple[int, int]] = []
+    r, c = row, col
+    for _ in range(int(steps)):
+        r += dr
+        c += dc
+        if not (0 <= r < height and 0 <= c < width):
+            break
+        cells.append((int(r), int(c)))
+    return cells
+
