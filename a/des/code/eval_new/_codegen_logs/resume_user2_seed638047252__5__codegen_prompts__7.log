+def _candidate_blockers(mask: np.ndarray, preserve_marker: bool) -> list[tuple[int, int, int, int]]:
+    h, w = mask.shape
+    total_on = int(mask.sum())
+    max_area = max(2, int(math.ceil(mask.size * 0.6)))
