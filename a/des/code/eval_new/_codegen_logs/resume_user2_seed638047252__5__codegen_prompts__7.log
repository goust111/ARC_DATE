+def _make_mask_and_blocker(h: int, w: int, preserve_marker: bool, rng: random.Random) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    strategies = ["bars", "growth"] if preserve_marker else ["full", "bars", "growth"]
