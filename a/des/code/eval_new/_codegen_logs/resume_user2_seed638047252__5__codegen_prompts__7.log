+    start = (rng.randrange(h), rng.randrange(w))
+    mask[start] = True
+    frontier: set[tuple[int, int]] = set()
+    for nr, nc in _neighbors4(*start):
+        if 0 <= nr < h and 0 <= nc < w:
+            frontier.add((nr, nc))
