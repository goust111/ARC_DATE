+
+
+def _build_pair(
+    h: int,
+    w: int,
+    pattern_color: int,
+    blocker_color: int,
+    preserve_marker: bool,
+    rng: random.Random,
+) -> dict[str, np.ndarray]:
+    mask, rect = _make_mask_and_blocker(h, w, preserve_marker, rng)
