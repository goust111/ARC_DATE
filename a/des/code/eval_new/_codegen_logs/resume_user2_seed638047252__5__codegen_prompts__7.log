+    regions: list[dict[str, object]] = []
+    for bbox in boxes:
+        r0, c0, r1, c1 = bbox
+        inner = grid[r0 + 1 : r1, c0 + 1 : c1].copy()
+        regions.append({"bbox": bbox, "inner": inner})
+    return int(frame_color), regions
