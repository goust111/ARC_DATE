+    template = np.full((h + 2, w + 2), BG, dtype=int)
+    template[0, :] = FRAME
+    template[-1, :] = FRAME
+    template[:, 0] = FRAME
+    template[:, -1] = FRAME
+    template[1:-1, 1:-1][mask] = pattern_color
+
+    instance = template.copy()
+    r0, c0, r1, c1 = rect
+    instance[r0 + 1 : r1 + 2, c0 + 1 : c1 + 2] = blocker_color
+
