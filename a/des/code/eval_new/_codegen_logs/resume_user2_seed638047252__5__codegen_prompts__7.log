+from __future__ import annotations
+
+from collections import deque
+import math
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GEN_ATTEMPTS = 400
+MASK_ATTEMPTS = 200
+PLACEMENT_ATTEMPTS = 200
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components_mask(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _mask_from_rect(shape: tuple[int, int], rect: tuple[int, int, int, int]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    r0, c0, r1, c1 = rect
+    mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    return mask
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    return int(mask.sum()) > 0 and len(_components_mask(mask)) == 1
+
+
+def _is_filled_rectangle(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if len(pts) == 0:
+        return False
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return len(pts) == int((r1 - r0 + 1) * (c1 - c0 + 1))
+
+
+def _is_rect_border_mask(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    if h < 3 or w < 3:
+        return False
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return bool(mask.sum() == int(border.sum()) and np.all(mask[border]) and not np.any(mask[~border]))
+
+
+def _is_frame_component(grid: np.ndarray, color: int, coords: list[tuple[int, int]]) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    expected = 2 * (h + w) - 4
+    if len(coords) != expected:
+        return False
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return bool(np.all(patch[border] == color) and not np.any(patch[~border] == color))
