+def _random_growth_mask(h: int, w: int, rng: random.Random) -> np.ndarray:
+    lo = max(4, (h * w) // 3)
+    hi = max(lo, min(h * w - 1, (2 * h * w) // 3 + 1))
+    target = rng.randint(lo, hi)
