+
+        if not candidates:
+            return False
+
+        r0, c0 = rng.choice(candidates)
+        spec["bbox"] = (int(r0), int(c0), int(r0 + side - 1), int(c0 + side - 1))
+        occupied[r0 : r0 + side, c0 : c0 + side] = True
+
+    return True
+
