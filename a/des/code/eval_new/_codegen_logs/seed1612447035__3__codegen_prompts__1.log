+            visited[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(int(rr), int(cc)):
+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and int(g[nr, nc]) == color:
