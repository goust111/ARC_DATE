+def _grow_branch(out: np.ndarray, frame: dict) -> None:
+    r0, c0, r1, c1 = map(int, frame["bbox"])
+    sr, sc = map(int, frame["seed"])
+    seed_color = int(frame["seed_color"])
+    frame_color = int(frame["frame_color"])
+
+    center_r = (r0 + r1) / 2.0
+    center_c = (c0 + c1) / 2.0
+
+    if sr < center_r:
+        row_step = 1
+        dr = int(sr - r0)
+    elif sr > center_r:
+        row_step = -1
+        dr = int(r1 - sr)
