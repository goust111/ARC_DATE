{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/8f215267.py; echo '---'; sed -n '204,300p' /home/lixinyu/snap/new/ARC_code/eval/8f215267.py; echo '====';\nsed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py; echo '---'; sed -n '508,620p' /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py; echo '====';\nsed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/3ad05f52.py; echo '---'; sed -n '719,860p' /home/lixinyu/snap/new/ARC_code/train/3ad05f52.py; echo '====';\nsed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/278e5215.py; echo '---'; sed -n '275,360p' /home/lixinyu/snap/new/ARC_code/train/278e5215.py; echo '====';\nsed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py; echo '---'; sed -n '247,340p' /home/lixinyu/snap/new/ARC_code/eval/4c3d4a41.py; echo '====';\nsed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/e3721c99.py; echo '---'; sed -n '600,700p' /home/lixinyu/snap/new/ARC_code/eval/e3721c99.py; echo '====';\nsed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/271d71e2.py; echo '---'; sed -n '539,640p' /home/lixinyu/snap/new/ARC_code/eval/271d71e2.py; echo '====';\nsed -n '1,300p' /home/lixinyu/snap/new/ARC_code/train/465b7d93.py; echo '---'; sed -n '260,360p' /home/lixinyu/snap/new/ARC_code/train/465b7d93.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg\nfrom arc_utils import paste, random_free_location\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Count same-color patterns per frame and represent the tally as dots inside.\n\n    Input structure:\n    - bg = most common color.\n    - Hollow rectangular frames in various colors.\n    - Small monochrome pattern sprites scattered outside frames.\n\n    Rule:\n    - Remove all small patterns from the grid.\n    - For each frame of color C, count how many patterns share color C.\n    - Draw that many dots along the frame's center row, spaced by 2, starting from the right.\n\n    Key insight: Frames act as tally displays — scattered same-color patterns are \"absorbed\" and their count is shown as interior dots.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    out = g.copy()\n    bg = int(get_bg(g))\n\n    regions = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n\n    frames: list[dict] = []\n    patterns: list[dict] = []\n    for comp in regions:\n        b = comp[\"bbox\"]\n        h = bbox_h(b)\n        w = bbox_w(b)\n        area = int(comp[\"area\"])\n        is_frame = (h >= 5) and (w >= 5) and (area < (h * w * 0.7))\n        if is_frame:\n            frames.append(comp)\n        else:\n            patterns.append(comp)\n\n    # Remove patterns from output.\n    for p in patterns:\n        for r, c in p[\"coords\"]:\n            out[int(r), int(c)] = bg\n\n    # For each frame, count matching patterns and draw dots.\n    for f in frames:\n        col = int(f[\"color\"])\n        num_patterns = sum(1 for p in patterns if int(p[\"color\"]) == col)\n        if num_patterns <= 0:\n            continue\n\n        r0, c0, r1, c1 = map(int, f[\"bbox\"])\n        r_mid = (r0 + r1) // 2\n        for i in range(int(num_patterns)):\n            cc = int(c1 - 2 - 2 * i)\n            if cc > int(c0):\n                out[int(r_mid), int(cc)] = col\n\n    return out\n\n# --------------- generator (codex-att2) ---------------\n\n# --- layout geometry ---\nFRAME_H = 5                    # frame height (rows)\nFRAME_W = 11                   # frame width (cols)\nFRAME_R0 = 1                   # top-left row of first frame\nFRAME_C0 = 1                   # top-left col of all frames\nFRAME_GAP = 2                  # bg rows between consecutive frames\nGRID_W = 23                    # fixed grid width\nRIGHT_C0 = 13                  # first column of the right (sprite) region\nRIGHT_W = 9                    # width of the right region\n\n# --- structural counts ---\nN_FRAMES_RANGE = (3, 5)        # [lo, hi) for number of frames\nN_DISTRACTORS_RANGE = (1, 3)   # [lo, hi) for distractor sprite count\nTOTAL_PATTERNS_RANGE = (5, 11) # [lo, hi) for total sprite count\nMAX_DOTS_PER_FRAME = 4         # max dot tally inside one frame\nBOTTOM_PAD_RANGE = (0, 7)      # [lo, hi) extra bg rows when n_frames==3\n\n# --- sprite shape ---\nSPRITE_AREA_RANGE = (2, 9)     # [lo, hi) connected-cell count per sprite\nSPRITE_MAX_H = 4               # max bbox height for sprite\nSPRITE_MAX_W = 3               # max bbox width for sprite\nSPRITE_PADDING = 1             # gap between placed sprites\n\n# --- retry budget ---\nMAX_ATTEMPTS = 300\n\n\ndef _frame_patch(color: int, bg: int, n_dots: int) -> np.ndarray:\n    \"\"\"Build a FRAME_H x FRAME_W hollow rectangle with n_dots on the center row.\"\"\"\n    patch = np.full((FRAME_H, FRAME_W), bg, dtype=int)\n    patch[0, :] = color\n    patch[-1, :] = color\n    patch[:, 0] = color\n    patch[:, -1] = color\n    mid_r = FRAME_H // 2\n    dot_cols = [FRAME_W - 3 - 2 * i for i in range(n_dots)]\n    patch[mid_r, dot_cols] = color\n    return patch\n\n\ndef _sample_counts(rng: np.random.Generator, n_frames: int, total_match: int) -> list[int]:\n    \"\"\"Distribute total_match sprites across n_frames, each capped at MAX_DOTS_PER_FRAME.\"\"\"\n    counts = [0] * n_frames\n    order = rng.permutation(n_frames)\n    remaining = total_match\n    for pos, idx in enumerate(order):\n        frames_left = n_frames - pos - 1\n        lo = max(0, remaining - MAX_DOTS_PER_FRAME * frames_left)\n        hi = min(MAX_DOTS_PER_FRAME, remaining)\n        val = int(rng.integers(lo, hi + 1))\n        counts[int(idx)] = val\n        remaining -= val\n    return counts\n\n\ndef _grow_sprite(rng: np.random.Generator, h: int, w: int, area: int) -> list[tuple[int, int]]:\n    \"\"\"Grow a connected polyomino of the given area inside an h x w bounding box.\"\"\"\n    seed = (int(rng.integers(0, h)), int(rng.integers(0, w)))\n    cells = {seed}\n    while len(cells) < area:\n        frontier = []\n        for r, c in cells:\n            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n                nb = (r + dr, c + dc)\n                if 0 <= nb[0] < h and 0 <= nb[1] < w and nb not in cells:\n                    frontier.append(nb)\n        cells.add(frontier[int(rng.integers(0, len(frontier)))])\n    return list(cells)\n\n\ndef _make_sprite(rng: np.random.Generator, color: int, bg: int) -> np.ndarray:\n    \"\"\"Generate a small random connected sprite, tight-cropped to its bounding box.\"\"\"\n    area = int(rng.integers(*SPRITE_AREA_RANGE))\n    dims = [(h, w) for h in range(1, SPRITE_MAX_H + 1)\n            for w in range(1, SPRITE_MAX_W + 1) if h * w >= area]\n    h, w = dims[int(rng.integers(0, len(dims)))]\n    cells = _grow_sprite(rng, h, w, area)\n    rs, cs = zip(*cells)\n    r_min, c_min = min(rs), min(cs)\n    patch = np.full((max(rs) - r_min + 1, max(cs) - c_min + 1), bg, dtype=int)\n    for r, c in cells:\n        patch[r - r_min, c - c_min] = color\n    return patch\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n\n    # --- choose structure ---\n    n_frames = int(rng.integers(*N_FRAMES_RANGE))\n    n_distractors = int(rng.integers(*N_DISTRACTORS_RANGE))\n    total_patterns = int(rng.integers(*TOTAL_PATTERNS_RANGE))\n    total_match = total_patterns - n_distractors\n\n    palette = rng.choice(np.arange(10), size=1 + n_frames + n_distractors, replace=False)\n    bg = int(palette[0])\n    frame_colors = [int(x) for x in palette[1 : 1 + n_frames]]\n    distractor_colors = [int(x) for x in palette[1 + n_frames :]]\n\n    counts = _sample_counts(rng, n_frames, total_match)\n    bottom_pad = int(rng.integers(*BOTTOM_PAD_RANGE)) if n_frames == 3 else 0\n    height = FRAME_R0 + n_frames * FRAME_H + (n_frames - 1) * FRAME_GAP + bottom_pad\n\n    # --- build output (frames with dots) ---\n    out = np.full((height, GRID_W), bg, dtype=int)\n    frame_rows: list[int] = []\n    for i, (color, count) in enumerate(zip(frame_colors, counts)):\n        r0 = FRAME_R0 + i * (FRAME_H + FRAME_GAP)\n        frame_rows.append(r0)\n        paste(out, _frame_patch(color, bg, count), r0, FRAME_C0)\n\n    # --- derive input (dots removed, sprites placed right) ---\n    inp = out.copy()\n    for r0, count in zip(frame_rows, counts):\n        mid_r = r0 + FRAME_H // 2\n        dot_cols = [FRAME_C0 + FRAME_W - 3 - 2 * i for i in range(count)]\n        inp[mid_r, dot_cols] = bg\n\n    right_canvas = np.full((height, RIGHT_W), bg, dtype=int)\n    pattern_colors = [c for c, n in zip(frame_colors, counts) for _ in range(n)]\n    pattern_colors.extend(distractor_colors)\n    rng.shuffle(pattern_colors)\n\n    try:\n        for color in pattern_colors:\n            sprite = _make_sprite(rng, color, bg)\n            r0, c0 = random_free_location(\n                right_canvas, sprite, transparent=bg,\n                padding=SPRITE_PADDING, padding_connectivity=8,\n            )\n            paste(right_canvas, sprite, r0, c0, transparent=bg)\n    except ValueError:\n        return None\n\n    paste(inp, right_canvas, 0, RIGHT_C0, transparent=bg)\n    if np.array_equal(main(inp), out):\n        return inp\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"failed to generate a valid input after {MAX_ATTEMPTS} attempts\")\n---\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"failed to generate a valid input after {MAX_ATTEMPTS} attempts\")\n====\nimport numpy as np\nfrom collections import Counter, deque\n\nfrom arc_utils import components_mask, get_bg, neighbors4, neighbors8\nimport random\ndef _components_mask(mask: np.ndarray, conn8: bool) -> list[list[tuple[int, int]]]:\n    return [[(int(r), int(c)) for r, c in comp] for comp in components_mask(mask, connectivity=8 if conn8 else 4)]\n\n\ndef _touches_border(pts: list[tuple[int, int]], h: int, w: int) -> bool:\n    return any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\n\n\ndef _seed_pixels(g: np.ndarray, bg: int) -> list[tuple[int, int]]:\n    h, w = g.shape\n    vals, cnts = np.unique(g, return_counts=True)\n    seeds: list[tuple[int, int]] = []\n    for v, cnt in zip(vals, cnts):\n        v = int(v)\n        if v == bg or int(cnt) != 1:\n            continue\n        r, c = map(int, np.argwhere(g == v)[0])\n        if r == 0 or c == 0 or r == h - 1 or c == w - 1:\n            seeds.append((r, c))\n    return seeds\n\n\ndef _nonbg_component8_from(g: np.ndarray, start: tuple[int, int], bg: int) -> set[tuple[int, int]]:\n    h, w = g.shape\n    st = [start]\n    vis = {start}\n    while st:\n        r, c = st.pop()\n        for nr, nc in neighbors8(r, c):\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in vis and int(g[nr, nc]) != bg:\n                vis.add((nr, nc))\n                st.append((nr, nc))\n    return vis\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill enclosed regions along a line seeded by unique border pixels.\n\n    Input structure:\n    - bg = most common color.\n    - Colored lines/drawings on the grid.\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n\n    Rule:\n    - Each border seed pixel connects (8-connected) to a line drawing.\n    - Find closed bg cavities whose boundary touches that line.\n    - Flood-fill each such cavity with the seed pixel's color.\n\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    out = g.copy()\n\n    # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n    bg_comps = _components_mask(g == bg, conn8=False)\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\n    for pts in bg_comps:\n        region = set(pts)\n        touches = _touches_border(pts, h, w)\n        boundary = set()\n        for r, c in region:\n            for nr, nc in neighbors4(r, c):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n                    boundary.add((nr, nc))\n        regions.append((region, boundary, touches, len(region)))\n\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n    outside_idxs = set()\n    for i, (reg, _, _, _) in enumerate(regions):\n        if any(p in reg for p in corners if int(g[p]) == bg):\n            outside_idxs.add(i)\n\n    cavities = []\n    for i, (reg, bnd, _, _) in enumerate(regions):\n        if i in outside_idxs or not bnd:\n            continue\n        bcols = {int(g[p]) for p in bnd}\n        cavities.append((reg, bnd, bcols))\n\n    for sr, sc in _seed_pixels(g, bg):\n        seed_col = int(g[sr, sc])\n\n        neigh_cols = []\n        for nr, nc in neighbors4(sr, sc):\n            if 0 <= nr < h and 0 <= nc < w:\n                v = int(g[nr, nc])\n                if v != bg:\n                    neigh_cols.append(v)\n        assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\n\n        # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\n\n        for cav, boundary, bcols in cavities:\n            if len(bcols) != 1:\n                continue\n            boundary_in_traced = boundary & traced\n            if not boundary_in_traced:\n                continue\n\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n            # This prevents filling regions that are only connected through other structures, not the line itself.\n            ok = False\n            for r, c in boundary_in_traced:\n                for nr, nc in neighbors8(r, c):\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n                        ok = True\n                        break\n                if ok:\n                    break\n            if not ok:\n                continue\n\n            for r, c in cav:\n                if int(out[r, c]) == bg:\n                    out[r, c] = seed_col\n\n    return out\n\n# --------------- generator (attempt_1_distractor_network) ---------------\n\n# ========================== CFG ==========================\n# Canvas / grid\nGRID_H_RANGE = (8, 30)             # grid height bounds\nGRID_W_RANGE = (8, 30)             # grid width bounds\nBG_COLORS = [0, 5]                 # background color choices\n\n# Seeds\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n\n# Frame loops\nFRAME_COLORS_MAX = 4               # max distinct frame colors\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n\n# Line growth\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n\n# Distractor network\nDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\nDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\nDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\nDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\nDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\n\n# Generation\nGEN_RETRIES = 300                  # outer retry budget in generate_input()\n# =========================================================\n\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\nORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\ndef _in_bounds(h, w, r, c):\n    return 0 <= r < h and 0 <= c < w\n\n\n# ---------------------------------------------------------------------------\n# Frame geometry\n# ---------------------------------------------------------------------------\n\ndef _frame_ring_coords(r0, c0, ch, cw):\n    \"\"\"Return (ring_coords, cavity_coords) for a rounded-rect frame.\n\n    Frame bbox is [r0, r0+ch+1] x [c0, c0+cw+1] (inclusive).\n    Ring = bbox boundary minus 4 corners.\n    \"\"\"\n    H, W = ch + 2, cw + 2\n    ring = []\n    for dr in range(H):\n        for dc in range(W):\n            on_bdr = (dr == 0 or dr == H - 1 or dc == 0 or dc == W - 1)\n            corner = (dr in (0, H - 1)) and (dc in (0, W - 1))\n            if on_bdr and not corner:\n                ring.append((r0 + dr, c0 + dc))\n    cavity = [(r0 + 1 + dr, c0 + 1 + dc) for dr in range(ch) for dc in range(cw)]\n    return ring, cavity\n\n\ndef _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\n    \"\"\"Check that ring+cavity can be placed on canvas without conflicts.\n\n    Returns True if: ring and cavity cells are empty, no cavity cell is\n    8-adjacent to line_col, ring is not 8-adjacent to foreign colors, and\n    at least one ring cell is 8-adjacent to a line_col pixel.\n    \"\"\"\n    # Ring and cavity cells must all be empty\n    for rr, cc in ring:\n        if canvas[rr, cc] != -1:\n            return False\n    for rr, cc in cavity:\n        if canvas[rr, cc] != -1:\n            return False\n\n    # No cavity cell may be 8-adjacent to any line_col pixel\n    for cr, cc in cavity:\n        for nr, nc in neighbors8(cr, cc):\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n                return False\n\n    # Ring must not be 8-adjacent to any non-bg, non-line_col pixel\n    ring_set = set(ring)\n    for rr, cc in ring:\n        for nr, nc in neighbors8(rr, cc):\n            if not _in_bounds(h, w, nr, nc) or (nr, nc) in ring_set:\n                continue\n            v = canvas[nr, nc]\n            if v != -1 and v != line_col:\n                return False\n\n    # At least one ring cell must be 8-adjacent to a line_col pixel\n    for rr, cc in ring:\n        for nr, nc in neighbors8(rr, cc):\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n                return True\n    return False\n\n\n# ---------------------------------------------------------------------------\n# Line growth\n# ---------------------------------------------------------------------------\n\ndef _grow_line(grid, start, line_col, target_len, rng):\n    \"\"\"Grow a meandering 8-connected 1px-wide path of line_col from start.\"\"\"\n    h, w = grid.shape\n    path = [start]\n    dr_bias = 1 if start[0] < h // 2 else -1\n    dc_bias = 1 if start[1] < w // 2 else -1\n    cur = start\n    path_set = {start}\n    while len(path) < target_len:\n        # Build weighted direction list: diagonals preferred, bias-aligned boosted\n        dirs = []\n        for ddr, ddc in DIAG_DIRS:\n            aligned = (ddr == dr_bias or ddc == dc_bias)\n            w_d = DIAG_WEIGHT_ALIGNED if aligned else DIAG_WEIGHT_OTHER\n            dirs.extend([(ddr, ddc)] * w_d)\n        for ddr, ddc in ORTHO_DIRS:\n            aligned = (ddr == dr_bias and ddc == 0) or (ddc == dc_bias and ddr == 0)\n---\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n    for _ in range(GEN_RETRIES):\n        g = _gen_attempt(rng)\n        if g is not None:\n            return g\n    raise RuntimeError(\"generate_input: exhausted attempts\")\n====\nfrom collections import Counter, deque\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, draw_line, find_components, get_bg, paste\nimport random\n\n\ndef _distances_from(sources: np.ndarray, passable: np.ndarray) -> np.ndarray:\n    h, w = passable.shape\n    dist = np.full((h, w), -1, dtype=int)\n    q: deque[tuple[int, int]] = deque()\n    for r, c in sources:\n        rr = int(r)\n        cc = int(c)\n        assert passable[rr, cc]\n        dist[rr, cc] = 0\n        q.append((rr, cc))\n\n    while q:\n        r, c = q.popleft()\n        nd = int(dist[r, c]) + 1\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n            nr = r + dr\n            nc = c + dc\n            if 0 <= nr < h and 0 <= nc < w and passable[nr, nc] and dist[nr, nc] < 0:\n                dist[nr, nc] = nd\n                q.append((nr, nc))\n    return dist\n\n\ndef _framed_square_rooms(g: np.ndarray, wall: int, sizes: set[int]) -> list[tuple[int, int, int]]:\n    h, w = g.shape\n    rooms: list[tuple[int, int, int]] = []\n    for n in sorted(sizes):\n        assert n > 1\n        for r in range(h - n + 1):\n            for c in range(w - n + 1):\n                if np.any(g[r : r + n, c : c + n] == wall):\n                    continue\n\n                side_wall_counts: list[int] = []\n                if r > 0:\n                    side_wall_counts.append(int(np.count_nonzero(g[r - 1, c : c + n] == wall)))\n                if r + n < h:\n                    side_wall_counts.append(int(np.count_nonzero(g[r + n, c : c + n] == wall)))\n                if c > 0:\n                    side_wall_counts.append(int(np.count_nonzero(g[r : r + n, c - 1] == wall)))\n                if c + n < w:\n                    side_wall_counts.append(int(np.count_nonzero(g[r : r + n, c + n] == wall)))\n\n                if len(side_wall_counts) >= 3 and all(count >= n - 1 for count in side_wall_counts):\n                    rooms.append((r, c, n))\n    return rooms\n\n\ndef _component_bboxes(mask: np.ndarray) -> list[tuple[int, int, int, int, int]]:\n    h, w = mask.shape\n    seen = np.zeros_like(mask, dtype=bool)\n    components: list[tuple[int, int, int, int, int]] = []\n    for r in range(h):\n        for c in range(w):\n            if not mask[r, c] or seen[r, c]:\n                continue\n            q: deque[tuple[int, int]] = deque([(r, c)])\n            seen[r, c] = True\n            r0 = r1 = r\n            c0 = c1 = c\n            area = 0\n            while q:\n                rr, cc = q.popleft()\n                area += 1\n                r0 = min(r0, rr)\n                c0 = min(c0, cc)\n                r1 = max(r1, rr)\n                c1 = max(c1, cc)\n                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n                    nr = rr + dr\n                    nc = cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\n                        seen[nr, nc] = True\n                        q.append((nr, nc))\n            components.append((r0, c0, r1, c1, area))\n    return components\n\n\ndef _overlap_len(a0: int, a1: int, b0: int, b1: int) -> int:\n    return max(0, min(a1, b1) - max(a0, b0) + 1)\n\n\ndef _middle_fill_bounded_by_side_rooms(\n    bbox: tuple[int, int, int, int],\n    rooms: list[tuple[int, int, int]],\n) -> bool:\n    r0, c0, r1, c1 = bbox\n    left: list[tuple[int, int]] = []\n    right: list[tuple[int, int]] = []\n    above: list[tuple[int, int]] = []\n    below: list[tuple[int, int]] = []\n\n    for r, c, n in rooms:\n        rr1 = r + n - 1\n        cc1 = c + n - 1\n        row_overlap = _overlap_len(r0, r1, r, rr1)\n        col_overlap = _overlap_len(c0, c1, c, cc1)\n        if row_overlap > 0 and 1 <= c0 - cc1 <= 2:\n            left.append((r, rr1))\n        if row_overlap > 0 and 1 <= c - c1 <= 2:\n            right.append((r, rr1))\n        if col_overlap > 0 and 1 <= r0 - rr1 <= 2:\n            above.append((c, cc1))\n        if col_overlap > 0 and 1 <= r - r1 <= 2:\n            below.append((c, cc1))\n\n    def spans_contain(intervals_a: list[tuple[int, int]], intervals_b: list[tuple[int, int]], lo: int, hi: int) -> bool:\n        if not intervals_a or not intervals_b:\n            return False\n        a0 = min(start for start, _end in intervals_a)\n        a1 = max(end for _start, end in intervals_a)\n        b0 = min(start for start, _end in intervals_b)\n        b1 = max(end for _start, end in intervals_b)\n        return lo >= a0 and hi <= a1 and lo >= b0 and hi <= b1\n\n    return spans_contain(left, right, r0, r1) or spans_contain(above, below, c0, c1)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Paint the maze corridor and framed rooms lying on shortest paths between the two colored endpoint components.\n\n    Input structure\n    - The grid has a dominant background, one wall color forming thin orthogonal frames, and one endpoint/fill color.\n    - The endpoint/fill color forms exactly two 4-connected solid rectangular components; their larger side lengths define the framed room sizes.\n\n    Rule\n    - Treat wall pixels as blocked and every other pixel as passable.\n    - Find every passable pixel that lies on a shortest 4-connected path between the two endpoint components.\n    - Also fill any framed square room of an endpoint-derived size that intersects that shortest-path mask.\n\n    Key insight\n    - Shortest paths identify the route through open connector corridors, while the wall-bordered square rooms need to be expanded from the route centerline to their full interior.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    counts = Counter(map(int, g.flat))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 2\n    assert counts[bg] > max(counts[color] for color in non_bg)\n    non_bg_counts = {color: int(np.count_nonzero(g == color)) for color in non_bg}\n    wall_count = max(non_bg_counts.values())\n    wall_candidates = [color for color, count in non_bg_counts.items() if count == wall_count]\n    assert len(wall_candidates) == 1\n    wall = wall_candidates[0]\n    paint_candidates = [color for color in non_bg if color != wall]\n    assert len(paint_candidates) == 1\n    paint = paint_candidates[0]\n    assert non_bg_counts[wall] > non_bg_counts[paint]\n\n    endpoints = find_components(g, bg=bg, colors=[paint], connectivity=4)\n    assert len(endpoints) == 2\n    endpoint_coords = [component[\"coords\"] for component in endpoints]\n\n    room_sizes: set[int] = set()\n    for coords in endpoint_coords:\n        r0, c0, r1, c1 = bbox_coords(coords)\n        bh = r1 - r0 + 1\n        bw = c1 - c0 + 1\n        assert coords.shape[0] == bh * bw\n        room_sizes.add(max(bh, bw))\n\n    passable = g != wall\n    dist0 = _distances_from(endpoint_coords[0], passable)\n    dist1 = _distances_from(endpoint_coords[1], passable)\n    endpoint_distances = [int(dist0[r, c]) for r, c in endpoint_coords[1]]\n    reachable_distances = [d for d in endpoint_distances if d >= 0]\n    assert len(reachable_distances) == len(endpoint_distances)\n    shortest = min(reachable_distances)\n\n    route = (dist0 >= 0) & (dist1 >= 0) & (dist0 + dist1 == shortest)\n    assert np.any(route)\n\n    fill = route.copy()\n    rooms = _framed_square_rooms(g, wall, room_sizes)\n    assert rooms\n    for r, c, n in rooms:\n        if np.any(route[r : r + n, c : c + n]):\n            fill[r : r + n, c : c + n] = True\n\n    room_mask = np.zeros_like(fill, dtype=bool)\n    for r, c, n in rooms:\n        room_mask[r : r + n, c : c + n] = True\n    open_fill = fill & (g == bg) & ~room_mask\n    for r0, c0, r1, c1, area in _component_bboxes(open_fill):\n        if r1 > r0 and c1 > c0 and area >= 20:\n            assert _middle_fill_bounded_by_side_rooms(\n                (r0, c0, r1, c1),\n                rooms,\n            ), \"middle fill must stay within the facing room-frame spans\"\n\n    H, W = g.shape\n    for r, c, n in rooms:\n        has_doorway = False\n        if r > 0:\n            has_doorway = has_doorway or np.any(g[r - 1, c : c + n] != wall)\n        if r + n < H:\n            has_doorway = has_doorway or np.any(g[r + n, c : c + n] != wall)\n        if c > 0:\n            has_doorway = has_doorway or np.any(g[r : r + n, c - 1] != wall)\n        if c + n < W:\n            has_doorway = has_doorway or np.any(g[r : r + n, c + n] != wall)\n        if has_doorway:\n            assert np.any(fill[r : r + n, c : c + n]), \"rooms with doorways must be on the shortest path\"\n\n    out = g.copy()\n    out[fill & (g == bg)] = paint\n    return out\n\n# --------------- generator (attempt 2 refined middle-fill) ---------------\n\nBG = 0\nWALL = 8\nPAINT_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]\n\n# Canvas bounds used by the observed evaluation examples.\nROW_MIN = 22\nROW_MAX = 29\nCOL_MIN = 24\nCOL_MAX = 28\n\n# Room-grid geometry and room-count filters.\nROOM_SIZE_RANGE = range(3, 6)\nROOM_GRID_RANGE = range(1, 8)\nBLOCK_ROOM_MIN = 3\nBLOCK_ROOM_MAX = 14\nTOTAL_ROOM_MIN = 7\nTOTAL_ROOM_MAX = 22\nGAP_RANGE = range(3, 8)\nORIENTATIONS = (\"vertical\", \"horizontal\")\n\n# Coarse layout and final route validation thresholds.\nLAYOUT_DISTANCE_MIN = 36\nLAYOUT_DISTANCE_FLOORS = [36, 42, 48, 54, 60]\nSHORTEST_DISTANCE_MIN = 36\nSHORTEST_DISTANCE_MAX = 72\nTURN_MIN = 8\nTURN_MAX = 21\nON_ROUTE_ROOM_MIN = 6\nON_ROUTE_ROOM_MAX = 14\nOFF_ROUTE_ROOM_MIN = 1\nOFF_ROUTE_ROOM_MAX = 8\n\n# Connector sampling: offset connectors create the observed middle fill region.\nOFFSET_CONNECTOR_PROB = 0.60\nCONNECTOR_CHOICE_TRIES = 300\nCONNECTOR_DELTA_MAX = 12\nCONNECTOR_DELTA_MIN_CAP = 5\n\n---\ndef generate_input():\n    for _ in range(GENERATE_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 3ad05f52 input\")\n====\nfrom __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import bbox, components_mask, crop_bbox, get_bg, paste\nimport random\nfrom itertools import product\n\n\ndef _unique_largest_non_bg_color(g: np.ndarray, bg: int) -> int:\n    counts = Counter(map(int, g.flatten()))\n    non_bg_counts = [(color, count) for color, count in counts.items() if color != int(bg)]\n    assert non_bg_counts\n\n    largest_count = max(count for _color, count in non_bg_counts)\n    candidates = [color for color, count in non_bg_counts if count == largest_count]\n    assert len(candidates) == 1\n    return int(candidates[0])\n\n\ndef _mask_bbox(g: np.ndarray, mask_color: int) -> tuple[int, int, int, int]:\n    mask = g == int(mask_color)\n    comps = components_mask(mask, connectivity=4)\n    assert len(comps) == 1\n\n    b = bbox(mask)\n    assert b is not None\n    return b\n\n\ndef _palette(g: np.ndarray, bg: int, mask_color: int, width: int) -> tuple[np.ndarray, int]:\n    palette_mask = (g != int(bg)) & (g != int(mask_color))\n    b = bbox(palette_mask)\n    assert b is not None\n\n    palette = crop_bbox(g, b)\n    assert palette.shape == (3, int(width))\n    assert bool(np.all(palette != int(bg)))\n    assert bool(np.all(palette != int(mask_color)))\n    assert bool(np.array_equal(palette[0], palette[1]))\n    assert len(set(map(int, palette[2]))) == 1\n\n    column_colors = palette[0].copy()\n    hole_color = int(palette[2, 0])\n    return column_colors, hole_color\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor the large mask crop column-by-column using the separate three-row palette strip.\n\n    Input structure:\n    - The background is the most common color.\n    - One large monochrome foreground object is the mask; its bbox is the output region and may contain background holes.\n    - The remaining foreground is a 3-row palette rectangle with the same width as the mask bbox: two identical color rows and one uniform row.\n\n    Rule:\n    - Crop to the mask object's bbox.\n    - For each output column, color mask pixels with the corresponding color from the repeated palette rows.\n    - Replace background holes inside the crop with the palette's uniform third-row color.\n\n    Key insight:\n    The grey object is only a stencil; its columns select colors from the legend, while its holes expose the legend's fill color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    mask_color = _unique_largest_non_bg_color(g, bg)\n\n    b = _mask_bbox(g, mask_color)\n    mask_crop = crop_bbox(g == int(mask_color), b)\n    height, width = map(int, mask_crop.shape)\n\n    column_colors, hole_color = _palette(g, bg, mask_color, width)\n    out = np.tile(column_colors, (height, 1))\n    out[~mask_crop] = hole_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, colors, and object bounds.\nBACKGROUND_COLOR, MASK_COLOR = 0, 5\nCOLOR_MIN, COLOR_MAX = 1, 9\nGRID_SIDE_MIN, GRID_SIDE_MAX = 10, 18\nMASK_SIDE_MIN, MASK_SIDE_MAX = 5, 10\nPALETTE_HEIGHT = 3\nGAP_MIN, GAP_MAX = 1, 3\n\n# Palette run construction.\nRUN_COUNT_OPTIONS = (4, 5)\nRUN_LENGTH_MIN, RUN_LENGTH_MAX = 1, 3\nCOLUMN_COLOR_DISTINCT_MIN, COLUMN_COLOR_DISTINCT_MAX = 3, 5\nUNUSED_COLOR_BIAS = 0.7\n\n# Mask density and retry budget.\nMASK_DENSITY_MIN, MASK_DENSITY_MAX = 0.60, 0.71\nGENERATION_ATTEMPTS = 300\n\n\ndef _valid_run_lengths(width: int, n_runs: int) -> list[tuple[int, ...]]:\n    length_range = range(RUN_LENGTH_MIN, RUN_LENGTH_MAX + 1)\n    return [\n        tuple(int(x) for x in lengths)\n        for lengths in product(length_range, repeat=int(n_runs))\n        if sum(lengths) == int(width)\n    ]\n\n\ndef _run_colors(colors: list[int], n_runs: int) -> list[int]:\n    seq: list[int] = []\n    unused = set(colors)\n    for i in range(int(n_runs)):\n        slots_left = int(n_runs) - i\n        choices = [c for c in colors if not seq or c != seq[-1]]\n        if len(unused) >= slots_left:\n            choices = [c for c in choices if c in unused]\n        elif unused and random.random() < UNUSED_COLOR_BIAS:\n            preferred = [c for c in choices if c in unused]\n            if preferred:\n                choices = preferred\n        color = random.choice(choices)\n        seq.append(int(color))\n        unused.discard(int(color))\n    return seq\n\n\ndef _palette_row(width: int, colors: list[int]) -> np.ndarray:\n    valid_counts = [\n        n_runs for n_runs in RUN_COUNT_OPTIONS if _valid_run_lengths(int(width), n_runs)\n    ]\n    n_runs = random.choice(valid_counts)\n    valid_lengths = _valid_run_lengths(int(width), n_runs)\n    lengths = random.choice(valid_lengths)\n    n_distinct = random.randint(\n        COLUMN_COLOR_DISTINCT_MIN, min(COLUMN_COLOR_DISTINCT_MAX, n_runs)\n    )\n    chosen = random.sample(colors, n_distinct)\n    seq = _run_colors(chosen, n_runs)\n    return np.repeat(seq, lengths).astype(int)\n\n\ndef _neighbors4(r: int, c: int, h: int, w: int):\n    if r > 0:\n        yield r - 1, c\n    if r + 1 < h:\n        yield r + 1, c\n    if c > 0:\n        yield r, c - 1\n    if c + 1 < w:\n        yield r, c + 1\n\n\ndef _connected_mask(height: int, width: int, target_area: int) -> np.ndarray | None:\n    \"\"\"Grow a connected mask with full row/column span to the target area.\"\"\"\n    mask = np.zeros((int(height), int(width)), dtype=bool)\n    steps = [\"D\"] * (int(height) - 1) + [\"R\"] * (int(width) - 1)\n    random.shuffle(steps)\n\n    r = c = 0\n    mask[r, c] = True\n    for step in steps:\n        if step == \"D\":\n            r += 1\n        else:\n            c += 1\n        mask[r, c] = True\n\n    if int(mask.sum()) > int(target_area):\n        return None\n\n    frontier: set[tuple[int, int]] = set()\n\n    def add_frontier(rr: int, cc: int) -> None:\n        for nr, nc in _neighbors4(rr, cc, int(height), int(width)):\n            if not mask[nr, nc]:\n                frontier.add((int(nr), int(nc)))\n\n    for rr, cc in np.argwhere(mask):\n        add_frontier(int(rr), int(cc))\n\n    while int(mask.sum()) < int(target_area):\n        if not frontier:\n            return None\n        cell = random.choice(tuple(frontier))\n        frontier.remove(cell)\n        rr, cc = cell\n        mask[rr, cc] = True\n        add_frontier(rr, cc)\n\n    return mask\n\n\ndef _grid_choices(mask_h: int, mask_w: int, gap: int) -> list[tuple[int, int]]:\n    \"\"\"Grid sizes where the mask remains the unique largest non-bg object.\"\"\"\n    max_mask = int(np.floor(MASK_DENSITY_MAX * int(mask_h) * int(mask_w)))\n    min_h = max(GRID_SIDE_MIN, int(mask_h) + PALETTE_HEIGHT + int(gap))\n    min_w = max(GRID_SIDE_MIN, int(mask_w))\n    choices: list[tuple[int, int]] = []\n    for h in range(min_h, GRID_SIDE_MAX + 1):\n        for w in range(min_w, GRID_SIDE_MAX + 1):\n            if h * w - max_mask - PALETTE_HEIGHT * int(mask_w) > max_mask:\n                choices.append((h, w))\n    return choices\n\n\ndef _sample_dimensions() -> tuple[int, int, int, int, int] | None:\n    \"\"\"Sample mask size, layout gap, and compatible grid size.\"\"\"\n    mask_h = random.randint(MASK_SIDE_MIN, MASK_SIDE_MAX)\n    mask_w = random.randint(MASK_SIDE_MIN, MASK_SIDE_MAX)\n    gap = random.randint(GAP_MIN, GAP_MAX)\n    grid_choices = _grid_choices(mask_h, mask_w, gap)\n    if not grid_choices:\n        return None\n    grid_h, grid_w = random.choice(grid_choices)\n    return mask_h, mask_w, gap, grid_h, grid_w\n\n\ndef _sample_palette(mask_w: int) -> tuple[np.ndarray, int]:\n    \"\"\"Choose hole color and the same-width column palette row.\"\"\"\n    available = [c for c in range(COLOR_MIN, COLOR_MAX + 1) if c != MASK_COLOR]\n    hole_color = random.choice(available)\n    column_pool = [c for c in available if c != hole_color]\n    column_colors = _palette_row(mask_w, column_pool)\n    return column_colors, int(hole_color)\n\n\ndef _compose_grid(grid_h, grid_w, gap, mask, column_colors, hole_color) -> np.ndarray:\n    \"\"\"Paste mask and palette into disjoint row bands of a blank grid.\"\"\"\n    mask_h, mask_w = map(int, mask.shape)\n    hole_row = np.full(int(mask_w), int(hole_color), dtype=int)\n    palette = np.vstack([column_colors, column_colors, hole_row])\n    mask_sprite = np.where(mask, MASK_COLOR, BACKGROUND_COLOR)\n    grid = np.zeros((int(grid_h), int(grid_w)), dtype=int)\n    block_h = int(mask_h) + PALETTE_HEIGHT + int(gap)\n    top = random.randint(0, int(grid_h) - block_h)\n    palette_above = random.choice([True, False])\n    if palette_above:\n        palette_r = top\n        mask_r = top + PALETTE_HEIGHT + int(gap)\n    else:\n        mask_r = top\n        palette_r = top + int(mask_h) + int(gap)\n    mask_c = random.randint(0, int(grid_w) - int(mask_w))\n    palette_c = random.randint(0, int(grid_w) - int(mask_w))\n    paste(grid, mask_sprite, mask_r, mask_c, transparent=BACKGROUND_COLOR)\n    paste(grid, palette, palette_r, palette_c, transparent=None)\n    return grid\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    dims = _sample_dimensions()\n    if dims is None:\n        return None\n    mask_h, mask_w, gap, grid_h, grid_w = dims\n\n    column_colors, hole_color = _sample_palette(mask_w)\n    area = int(mask_h) * int(mask_w)\n    min_area = int(np.ceil(MASK_DENSITY_MIN * area))\n    max_area = int(np.floor(MASK_DENSITY_MAX * area))\n---\ndef generate_input() -> np.ndarray:\n    for _ in range(GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid input\")\n====\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg as _bg_color\nfrom arc_utils import colors_present, get_bg, paste\n\ndef _bbox(pts):\n    return bbox_coords(pts if isinstance(pts, np.ndarray) else np.asarray(list(pts), dtype=int))\ndef _cc4(mask):\n    return components_mask(mask, connectivity=4)\ndef _most_common(arr):\n    vals, counts = np.unique(np.asarray(arr), return_counts=True)\n    return int(vals[counts.argmax()])\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fit a grey bar into a grey frame by aligning projections with colored columns, then stack colors above.\n\n    Input structure:\n    - bg, a grey structural color forming two components: a large rectangular frame (slot) and a smaller bar with upward projections.\n    - Colored pixels inside the slot mark target columns.\n\n    Rule:\n    - Move the bar upward into the slot so its bottom edge sits one cell above the slot's interior bottom.\n    - Shift it horizontally so the bar's upward projections align column-wise with the colored pixels in the slot.\n    - Stack the colored pixels immediately above the bar projections in each column.\n\n    Key insight: The bar's projections act as keys that must align with the colored-column \"locks\" in the slot.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    # Background: most frequent. \"Grey\" structural color: most frequent non-bg.\n    bg = _bg_color(g)\n    other = g[g != bg]\n    if other.size == 0:\n        return g.copy()\n    grey = _most_common(other)\n\n    def comps_of_color(color: int):\n        comps = [(len(pts), _bbox(pts), pts) for pts in _cc4(g == color)]\n        comps.sort(key=lambda t: (-t[0], t[1]))\n        return comps\n\n    grey_comps = comps_of_color(grey)\n    if len(grey_comps) < 2:\n        return g.copy()\n\n    # Slot is the largest grey component (the right-side frame); bar is the next largest.\n    (_, slot_bbox, _), (_, bar_bbox, bar_pts) = grey_comps[0], grey_comps[1]\n    sr0, sc0, sr1, sc1 = slot_bbox\n\n    # Base output: keep only the slot bbox content, clear all colored pixels inside it.\n    out = np.full_like(g, bg)\n    out[sr0 : sr1 + 1, sc0 : sc1 + 1] = g[sr0 : sr1 + 1, sc0 : sc1 + 1]\n    slot_region = out[sr0 : sr1 + 1, sc0 : sc1 + 1]\n    slot_region[(slot_region != bg) & (slot_region != grey)] = bg\n\n    # Compute bar translation: bottom of bar sits 1 cell above slot interior bottom.\n    bar_base_row = max(r for r, _ in bar_pts)\n    slot_interior_bottom = sr1 - 1\n    target_base_row = slot_interior_bottom - 1\n    dy = target_base_row - bar_base_row\n\n    # Determine bar projection columns (columns with any bar pixel above the base row).\n    col_min_row = {}\n    for r, c in bar_pts:\n        col_min_row[c] = min(col_min_row.get(c, r), r)\n    src_proj_cols = sorted([c for c, rmin in col_min_row.items() if rmin < bar_base_row])\n\n    # Determine destination columns from colored pixels in the original slot.\n    dst_cols_set = set()\n    for r, c in np.argwhere((g != bg) & (g != grey)):\n        r = int(r)\n        c = int(c)\n        if sr0 <= r <= sr1 and sc0 <= c <= sc1:\n            dst_cols_set.add(c)\n    dst_cols = sorted(dst_cols_set)\n\n    # Compute a robust horizontal shift aligning projection columns to colored columns.\n    dx = None\n    if src_proj_cols and len(src_proj_cols) == len(dst_cols):\n        deltas = [d - s for s, d in zip(src_proj_cols, dst_cols)]\n        if len(set(deltas)) == 1:\n            dx = deltas[0]\n    if dx is None:\n        # Brute pick dx that maximizes overlap of shifted projection cols with dst cols.\n        best = (-1, 0)\n        dst_set = set(dst_cols)\n        for cand_dx in range(-w, w + 1):\n            score = sum((c + cand_dx) in dst_set for c in src_proj_cols)\n            if score > best[0]:\n                best = (score, cand_dx)\n        dx = best[1]\n\n    # Paste bar into the slot (overwrite with grey).\n    placed = []\n    for r, c in bar_pts:\n        rr = r + dy\n        cc = c + dx\n        if sr0 <= rr <= sr1 and sc0 <= cc <= sc1:\n            out[rr, cc] = grey\n            placed.append((rr, cc))\n\n    # Move colored pixels: for each affected column, stack them immediately above the top of the bar in that column.\n    # Use colors from the original grid (inside slot bbox), ordered top->bottom.\n    placed_by_col = {}\n    for rr, cc in placed:\n        placed_by_col.setdefault(cc, []).append(rr)\n\n    interior_top = sr0 + 1\n    interior_bottom = sr1 - 1\n\n    for col in dst_cols:\n        if col not in placed_by_col:\n            continue\n        bar_top = min(placed_by_col[col])\n        desired_bottom = bar_top - 1\n        if desired_bottom < interior_top:\n            continue\n\n        # Extract original colored pixels in this column (ignore bg/grey).\n        rows = [r for r in range(sr0, sr1 + 1) if g[r, col] != bg and g[r, col] != grey]\n        if not rows:\n            continue\n        colors = [int(g[r, col]) for r in rows]  # top->bottom order by construction\n\n        max_len = desired_bottom - interior_top + 1\n        if max_len <= 0:\n            continue\n        if len(colors) > max_len:\n            colors = colors[-max_len:]\n\n        start_row = desired_bottom - len(colors) + 1\n        start_row = max(start_row, interior_top)\n\n        # Paint (overwrite) within the interior only.\n        for i, colv in enumerate(colors):\n            rr = start_row + i\n            if interior_top <= rr <= interior_bottom:\n                out[rr, col] = colv\n\n    return out\n\n# --------------- generator (attempt 3 (Codex)) ---------------\n\n# --- Palette ---\nBG = 0\nGREY = 5\nPALETTE = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)  # colors != bg and != grey\n\n# --- Canvas geometry (fixed per spec) ---\nH, W = 8, 20\n\n# --- Frame (right-hand slot) ---\nFRAME_R0, FRAME_C0 = 0, 9            # top-left of frame patch\nFRAME_H, FRAME_W = 8, 11             # frame patch dimensions\nLEFT_WALL_OPEN_ROWS = (4, 5)         # rows where the left wall of the frame is open\n\n# --- Slot columns inside the frame ---\nSLOT_COLS = [11, 13, 15, 17]         # absolute col indices\nSLOT_LENS = [3, 4, 4, 3]             # per-col length counted from row 1\nSLOT_TOP_ROW = 1                     # topmost interior row of slot columns\n\n# --- Bar geometry ---\nBAR_INPUT_C0 = 1                     # left column of bar in the input (pre-translation)\nBAR_OUTPUT_C0 = 11                   # left column of bar in the expected output (post-translation)\nBAR_R0 = 2                           # top row where bar patch is pasted\nBAR_H, BAR_W = 4, 7                  # bar patch dimensions (4 rows tall, base at local row 3)\nBAR_LOCAL_PROJ_COLS = [0, 2, 4, 6]   # bar projection columns within the patch\nBAR_BASE_ABS_ROW = BAR_R0 + BAR_H - 1  # row 5, absolute row of bar base after paste\n\n# --- Sampling parameters ---\nHEIGHT0_RANGE = (2, 5)               # rng.integers(low, high) -> {2,3,4} for first proj\nHEIGHT_REST_RANGE = (1, 5)           # rng.integers(low, high) -> {1,2,3,4} for other projs\nMAX_ATTEMPTS = 300\n\n\ndef _frame_patch() -> np.ndarray:\n    \"\"\"Grey frame with top/bottom/right walls closed and a 2-cell gap in the left wall.\"\"\"\n    patch = np.zeros((FRAME_H, FRAME_W), dtype=int)\n    patch[[0, -1], :] = GREY                       # top and bottom rows\n    patch[:, -1] = GREY                            # right wall\n    patch[:, 0] = GREY                             # left wall (solid...)\n    patch[list(LEFT_WALL_OPEN_ROWS), 0] = BG       # ...with the opening carved out\n    return patch\n\n\ndef _bar_patch(heights: list[int]) -> np.ndarray:\n    \"\"\"Horizontal bar base with 4 upward grey projections at local cols {0,2,4,6}.\"\"\"\n    patch = np.zeros((BAR_H, BAR_W), dtype=int)\n    patch[-1, :] = GREY                            # full base row\n    for local_c, height in zip(BAR_LOCAL_PROJ_COLS, heights):\n        patch[BAR_H - height : BAR_H, local_c] = GREY\n    return patch\n\n\ndef _paint_slot_column(grid: np.ndarray, col: int, length: int, color: int,\n                       count: int, height: int | None) -> None:\n    \"\"\"Paint one slot column.\n\n    Input mode (height=None): top (length-count) cells grey caps, bottom `count` cells the color.\n    Output mode (height given): grey cap then up to (5-height) visible colored cells flush to top.\n    \"\"\"\n    cap = length - count\n    grid[SLOT_TOP_ROW : SLOT_TOP_ROW + cap, col] = GREY\n    if height is None:\n        grid[SLOT_TOP_ROW + cap : SLOT_TOP_ROW + length, col] = color\n        return\n    visible = min(count, BAR_BASE_ABS_ROW - height)  # = min(count, 5 - height)\n    if visible > 0:\n        row_end = BAR_BASE_ABS_ROW - height          # inclusive last colored row\n        grid[row_end - visible + 1 : row_end + 1, col] = color\n\n\ndef _build_grid(heights: list[int], colors: list[int], colored_counts: list[int],\n                bar_c0: int, output_mode: bool) -> np.ndarray:\n    grid = np.zeros((H, W), dtype=int)\n    paste(grid, _frame_patch(), FRAME_R0, FRAME_C0)\n    paste(grid, _bar_patch(heights), BAR_R0, bar_c0)\n    for col, length, color, count, height in zip(SLOT_COLS, SLOT_LENS, colors, colored_counts, heights):\n---\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n    for _ in range(MAX_ATTEMPTS):\n        grid = _gen_attempt(rng)\n        if grid is not None:\n            return grid\n    raise RuntimeError(f\"generate_input failed after {MAX_ATTEMPTS} attempts\")\n====\nimport numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, is_contiguous, neighbors4, paste\nimport itertools\nimport random\n\n\ndef _hole_count(mask: np.ndarray) -> int:\n    \"\"\"\n    Count holes in a binary mask using 4-connectivity.\n    A hole is a background component that does not touch the mask's bounding box border.\n    \"\"\"\n    h, w = mask.shape\n    bg = ~mask\n    vis = np.zeros((h, w), dtype=bool)\n    holes = 0\n    for r0 in range(h):\n        for c0 in range(w):\n            if not bg[r0, c0] or vis[r0, c0]:\n                continue\n            st = [(r0, c0)]\n            vis[r0, c0] = True\n            touches = False\n            while st:\n                r, c = st.pop()\n                if r == 0 or c == 0 or r == h - 1 or c == w - 1:\n                    touches = True\n                for rr, cc in neighbors4(r, c):\n                    if 0 <= rr < h and 0 <= cc < w and bg[rr, cc] and not vis[rr, cc]:\n                        vis[rr, cc] = True\n                        st.append((rr, cc))\n            if not touches:\n                holes += 1\n    return holes\n\n\ndef _legend_mapping(g: np.ndarray, bg: int, grey: int) -> dict[int, int]:\n    \"\"\"\n    Pick one 'legend' component per non-(bg,grey) color:\n      - component is at least 2x2,\n      - component does not touch the outer grid border (filters dividers).\n    Map hole_count -> legend_color.\n    \"\"\"\n    h, w = g.shape\n    mapping: dict[int, int] = {}\n    colors = [c for c in sorted(set(map(int, np.unique(g)))) if c not in (bg, grey)]\n    for c in colors:\n        comps = components_mask(g == c, connectivity=4)\n        candidates = []\n        for pts in comps:\n            r0, c0, r1, c1 = bbox_coords(pts)\n            if r0 == 0 or c0 == 0 or r1 == h - 1 or c1 == w - 1:\n                continue\n            if (r1 - r0 + 1) < 2 or (c1 - c0 + 1) < 2:\n                continue\n            candidates.append((r0, c0, r1, c1))\n        if not candidates:\n            continue\n        assert len(candidates) == 1, f\"color {c} must have exactly one legend component\"\n        r0, c0, r1, c1 = candidates[0]\n        sub = (g[r0 : r1 + 1, c0 : c1 + 1] == c)\n        hc = _hole_count(sub)\n        assert hc not in mapping, f\"legend hole count {hc} must map to exactly one color\"\n        mapping[hc] = c\n    return mapping\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor grey shapes by matching their hole count to a color legend.\n\n    Input structure:\n    - bg = most common color; grey (5) sprites scattered across the grid.\n    - Colored legend shapes (non-bg, non-grey, at least 2×2, not touching the outer border) near grid edge,\n      each with a distinct number of enclosed holes.\n\n    Rule:\n    - Each colored legend shape defines a mapping: hole count → color.\n    - For every grey sprite, count its holes (enclosed bg regions not touching the sprite's bounding-box border).\n    - Recolor the grey sprite to the matching legend color; erase grey distractors with unlisted hole counts.\n\n    Key insight: Shape identity is encoded by topology (number of holes), not geometry or size.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    grey = 5\n\n    legend = _legend_mapping(g, bg, grey)\n    assert legend, \"legend mapping must be non-empty: grid must contain colored legend shapes\"\n\n    out = g.copy()\n    for pts in components_mask(g == grey, connectivity=4):\n        r0, c0, r1, c1 = bbox_coords(pts)\n        sub = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)\n        for r, c in pts:\n            sub[r - r0, c - c0] = True\n        hc = _hole_count(sub)\n        newc = int(legend[hc]) if hc in legend else bg\n        for r, c in pts:\n            out[r, c] = newc\n\n    return out\n\n# --------------- generator (holes-first organic blob) ---------------\n\nfrom arc_utils import label_mask\nfrom scipy.ndimage import binary_dilation, generate_binary_structure\n\n# -- palette & grid --\nBG = 0\nDIV = 1\nGREY = 5\nGRID_SIZE = 30\nLEGEND_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]\n\n# -- legend panel --\nLEGEND_COUNT_RANGE = (2, 4)         # number of legend entries\nMAX_HOLE_COUNT = 6                  # hole values drawn from range(MAX_HOLE_COUNT)\nPANEL_SIZE_RANGE = (5, 8)           # panel thickness (cross-axis)\nFULL_LAYOUT_MAX_SPAN = 28          # max legend line span for full-row/col layouts\nL_LAYOUT_MAX_SPAN = 24            # max legend line span for L-shaped layouts\nL_LAYOUT_EXTRA_PADDING = 3        # max random padding along the L arm\n\n# -- sprites --\nTOTAL_SPRITES_RANGE = (8, 11)       # total sprites (matches + distractors)\nMAX_DISTRACTORS = 7                 # max distractor sprites\nMAX_EXTRA_PER_LEGEND = 2            # max extra match sprites per legend entry\nSPRITE_RETRIES = 30                 # retries per sprite generation attempt\nSPRITE_AREA_0 = (5, 25)              # (min, max) area for 0-hole sprites\nSPRITE_AREA_LOW_MIN = 8              # min area for 1-2 hole sprites (max = 25+10*h)\n# 3+ hole sprites: min = 10+2*h, max = 20+4*h\nCANVAS_SCALE = 1.2                  # sqrt(area) multiplier for canvas size\nCANVAS_MIN = 5                      # minimum canvas dimension\nCANVAS_PAD = 2                      # padding added to scaled sqrt for canvas\nHOLE_SEED_RADIUS_FACTOR = 0.45      # radius = factor * sqrt(area)\nHOLE_SEED_MIN_RADIUS = 2\nHOLE_SEED_MIN_SEP = 2               # minimum Chebyshev distance between hole seeds\nHOLE_SEED_MARGIN = 2                # margin from canvas edge for hole seeds\nSEAL_ITERS = 5                      # max iterations for sealing forbidden cells\nSPRITE_MAX_H = 12                   # max sprite bbox height\nSPRITE_MAX_W = 18                   # max sprite bbox width\nSPRITE_MAX_ASPECT = 2.5             # max aspect ratio (max_dim / min_dim)\n\n# -- generation --\nGEN_RETRIES = 300                   # outer retries for generate_input()\n\n# 8-connectivity structuring element for dilation\n_STRUCT8 = generate_binary_structure(2, 2)\n\n\n# ---------- legend helpers ----------\n\ndef _legend_span(hole_count: int) -> int:\n    \"\"\"Width (or height) of a single legend patch along the arrangement axis.\"\"\"\n    return 3 if hole_count == 0 else 2 * hole_count + 1\n\n\ndef _legend_patch(hole_count: int, color: int, arrangement: str) -> np.ndarray:\n    \"\"\"Build a 3xSpan (horizontal) or Spanx3 (vertical) legend patch.\"\"\"\n    span = _legend_span(hole_count)\n    if arrangement == \"horizontal\":\n        patch = np.full((3, span), int(color), dtype=int)\n        if hole_count:\n            patch[1, 1::2] = BG\n    else:\n        patch = np.full((span, 3), int(color), dtype=int)\n        if hole_count:\n            patch[1::2, 1] = BG\n    return patch\n\n\ndef _line_span(legends: list[tuple[int, int]]) -> int:\n    \"\"\"Total span of legend patches plus 1-cell gaps between them.\"\"\"\n    return sum(_legend_span(h) for h, _ in legends) + len(legends) - 1\n\n\ndef _choose_legends(arrangement: str, max_span: int) -> list[tuple[int, int]]:\n    \"\"\"Pick 2-4 legends with distinct hole counts that fit within max_span.\"\"\"\n    count = random.randint(*LEGEND_COUNT_RANGE)\n    combos = [holes for holes in itertools.combinations(range(MAX_HOLE_COUNT), count)\n              if sum(_legend_span(h) for h in holes) + count - 1 <= max_span]\n    if not combos:\n        return _choose_legends(arrangement, max_span + 2)\n    holes = list(random.choice(combos))\n    random.shuffle(holes)\n    colors = random.sample(LEGEND_COLORS, count)\n    return list(zip(holes, colors))\n\n\ndef _place_legend_line(\n    grid: np.ndarray, legends: list[tuple[int, int]], arrangement: str, r: int, c: int\n) -> None:\n    \"\"\"Paste legend patches sequentially along the arrangement axis.\"\"\"\n    rr, cc = int(r), int(c)\n    for hole_count, color in legends:\n        patch = _legend_patch(hole_count, color, arrangement)\n        paste(grid, patch, rr, cc)\n        if arrangement == \"horizontal\":\n            cc += patch.shape[1] + 1\n        else:\n            rr += patch.shape[0] + 1\n\n\n# ---------- layout helpers ----------\n\ndef _layout_full_horizontal(grid: np.ndarray, blocked: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Place a full-row horizontal divider with legend panel above or below.\"\"\"\n    legends = _choose_legends(\"horizontal\", FULL_LAYOUT_MAX_SPAN)\n    total = _line_span(legends)\n    panel_h = random.randint(*PANEL_SIZE_RANGE)\n    top = random.choice([True, False])\n    c0 = random.randint(1, GRID_SIZE - 1 - total)\n    if top:\n        div_r = panel_h\n        grid[div_r, :] = DIV\n        blocked[: div_r + 1, :] = 9\n        r0 = random.randint(1, panel_h - 4)\n    else:\n        div_r = GRID_SIZE - 1 - panel_h\n        grid[div_r, :] = DIV\n---\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_RETRIES):\n        try:\n            grid = _gen_attempt()\n        except Exception:\n            grid = None\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate e3721c99 input\")\n====\nfrom __future__ import annotations\nfrom collections import Counter, defaultdict\nimport numpy as np\nfrom scipy.ndimage import label\nfrom arc_utils import STRUCT4, bbox_coords, colors_present, components_mask, paste\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move bordered containers toward same-colored destination markers, charging gray cells to orange.\n\n    Input structure:\n    - bg = 6 (magenta). Black-bordered (0) rectangles with gray (5) / orange (7) interiors.\n    - A head sprite (9) sits adjacent to one container edge; a matching destination sprite lies along the movement axis.\n\n    Rule:\n    - Each container translates toward its destination along the head-to-dest axis.\n    - Steps = min(head-to-dest distance, number of gray interior cells).\n    - Gray cells become orange from the head-facing side inward, one per step.\n\n    Key insight: Gray cell count caps movement — a container stops short if it runs out of gray cells to charge.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    BORDER = 0\n    GREY = 5\n    FILL = 7\n    DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    # True background is dominant non-border color (border can dominate in some cases).\n    cnt = Counter(map(int, g.flatten()))\n    bg = int(max((c for c in cnt.keys() if int(c) != int(BORDER)), key=lambda c: int(cnt[int(c)])))\n\n    def rect_border_coords(r0: int, c0: int, r1: int, c1: int):\n        for c in range(c0, c1 + 1):\n            yield (r0, c)\n            yield (r1, c)\n        for r in range(r0 + 1, r1):\n            yield (r, c0)\n            yield (r, c1)\n\n    # --- detect containers as rectangles enclosing GREY/FILL with BORDER frame ---\n    containers = []\n    for pts in components_mask((g == GREY) | (g == FILL), connectivity=4):\n        if pts.size == 0:\n            continue\n        ir0, ic0, ir1, ic1 = bbox_coords(pts)\n        r0, c0, r1, c1 = int(ir0 - 1), int(ic0 - 1), int(ir1 + 1), int(ic1 + 1)\n        if r0 < 0 or c0 < 0 or r1 >= H or c1 >= W:\n            continue\n        if any(int(g[r, c]) != BORDER for r, c in rect_border_coords(r0, c0, r1, c1)):\n            continue\n        inner = g[r0 + 1 : r1, c0 + 1 : c1]\n        if inner.size == 0 or not bool(np.isin(inner, [GREY, FILL]).all()):\n            continue\n        containers.append({\"box\": (r0, c0, r1, c1)})\n\n    assert not (not containers)\n\n    # head + destination are in some non-bg, non-border color (not GREY/FILL)\n    out = g.copy()\n\n    all_head_colors = [c for c in colors_present(g, exclude={bg, BORDER, GREY, FILL})]\n\n    # Precompute components for each head color.\n    comp_by_color: dict[int, list[dict]] = defaultdict(list)\n    for col in all_head_colors:\n        labc, nc = label(g == int(col), structure=STRUCT4)\n        for k in range(1, int(nc) + 1):\n            coords = np.argwhere(labc == int(k))\n            if coords.size == 0:\n                continue\n            r0, c0, r1, c1 = bbox_coords(coords)\n            pts = {(int(r), int(c)) for r, c in coords}\n            shape = {(int(r - r0), int(c - c0)) for r, c in pts}\n            comp_by_color[int(col)].append({\"pts\": pts, \"shape\": shape, \"tl\": (int(r0), int(c0))})\n\n    def pick_head_for_container(box_):\n        r0, c0, r1, c1 = box_\n        head_seeds = []\n        for r, c in rect_border_coords(r0, c0, r1, c1):\n            for dr, dc in DIR4:\n                rr, cc = r + dr, c + dc\n                if 0 <= rr < H and 0 <= cc < W:\n                    val = int(g[rr, cc])\n                    if val not in (int(bg), int(BORDER), int(GREY), int(FILL)):\n                        head_seeds.append((rr, cc, val))\n        if not head_seeds:\n            return None\n\n        hc = int(Counter(val for _r, _c, val in head_seeds).most_common(1)[0][0])\n        seed_pts = {(r, c) for r, c, val in head_seeds if int(val) == int(hc)}\n        cands = comp_by_color.get(hc, [])\n        comp0 = None\n        for comp in cands:\n            if comp[\"pts\"] & seed_pts:\n                comp0 = comp\n                break\n        if comp0 is None:\n            return None\n\n        # Split head vs destination even if same-color pixels touch:\n        # head pixels are those with minimal manhattan distance to this container border.\n        border_pts = list(rect_border_coords(r0, c0, r1, c1))\n        best_d = None\n        dist = {}\n        for pr, pc in comp0[\"pts\"]:\n            d = min(abs(int(pr - br)) + abs(int(pc - bc)) for br, bc in border_pts)\n            dist[(int(pr), int(pc))] = int(d)\n            if best_d is None or d < best_d:\n                best_d = int(d)\n        if best_d is None:\n            return None\n        head_pts = {p for p, d in dist.items() if int(d) == int(best_d)}\n\n        # direction from head bbox relative to container box\n        coords = np.array(list(head_pts), dtype=int)\n        hr0, hc0, hr1, hc1 = bbox_coords(coords)\n        if hc1 < c0:\n            direction = (0, -1)\n        elif hc0 > c1:\n            direction = (0, 1)\n        elif hr1 < r0:\n            direction = (-1, 0)\n        elif hr0 > r1:\n            direction = (1, 0)\n        else:\n            direction = (0, 0)\n\n        # normalized head shape + top-left\n        r00, c00 = int(hr0), int(hc0)\n        head_shape = {(int(r - r00), int(c - c00)) for r, c in head_pts}\n        return {\n            \"color\": hc,\n            \"head_pts\": head_pts,\n            \"head_shape\": head_shape,\n            \"head_tl\": (r00, c00),\n            \"comp_pts\": set(comp0[\"pts\"]),\n            \"dir\": direction,\n        }\n\n    for cont in containers:\n        box_ = cont[\"box\"]\n        r0, c0, r1, c1 = box_\n\n        head_info = pick_head_for_container(box_)\n        if head_info is None:\n            continue\n        hc = int(head_info[\"color\"])\n        head_pts = set(head_info[\"head_pts\"])\n        head_shape = head_info[\"head_shape\"]\n        head_tl = head_info[\"head_tl\"]\n        comp_pts = set(head_info[\"comp_pts\"])\n        direction = head_info[\"dir\"]\n        if direction == (0, 0):\n            continue\n\n        # destination candidates\n        dests = []\n        for d in comp_by_color.get(hc, []):\n            if d[\"shape\"] != head_shape:\n                continue\n            if d[\"pts\"] == comp_pts:\n                continue\n            dests.append(d)\n\n        # add split-from-same-component destinations (when dest touches head by color)\n        rem = comp_pts - head_pts\n        if rem:\n            mask_rem = np.zeros((H, W), dtype=bool)\n            for rr, cc in rem:\n                mask_rem[int(rr), int(cc)] = True\n            labr, nr = label(mask_rem, structure=STRUCT4)\n            for k in range(1, int(nr) + 1):\n                pts = {(int(r), int(c)) for r, c in np.argwhere(labr == int(k))}\n                if not pts:\n                    continue\n                # reject if adjacent to BORDER\n                adj = False\n                for r, c in pts:\n                    for dr, dc in DIR4:\n                        rr, cc = int(r + dr), int(c + dc)\n                        if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(BORDER):\n                            adj = True\n                            break\n                    if adj:\n                        break\n                if adj:\n                    continue\n                rs = [r for r, _c in pts]\n                cs = [c for _r, c in pts]\n                r00, c00 = int(min(rs)), int(min(cs))\n                shp = {(int(r - r00), int(c - c00)) for r, c in pts}\n                if shp != head_shape:\n                    continue\n                dests.append({\"pts\": pts, \"shape\": shp, \"tl\": (r00, c00)})\n\n        if not dests:\n            continue\n\n        best = None\n        best_dest = None\n        for d in dests:\n            tr0 = int(d[\"tl\"][0] - head_tl[0])\n            tc0 = int(d[\"tl\"][1] - head_tl[1])\n            if direction[0] != 0 and tc0 != 0:\n                continue\n            if direction[1] != 0 and tr0 != 0:\n                continue\n            if direction[0] == 1 and tr0 <= 0:\n                continue\n            if direction[0] == -1 and tr0 >= 0:\n                continue\n            if direction[1] == 1 and tc0 <= 0:\n                continue\n            if direction[1] == -1 and tc0 >= 0:\n                continue\n            dist = abs(tr0) + abs(tc0)\n            if best is None or dist < best:\n                best = dist\n                best_dest = d\n        if best_dest is None:\n            continue\n\n        # translation to overlap head onto destination, capped by number of GREY cells\n        tr0 = int(best_dest[\"tl\"][0] - head_tl[0])\n        tc0 = int(best_dest[\"tl\"][1] - head_tl[1])\n        steps = abs(tr0) + abs(tc0)\n\n        inner = g[r0 + 1 : r1, c0 + 1 : c1]\n        grey_coords = [\n            (int(r0 + 1 + rr), int(c0 + 1 + cc))\n            for rr in range(inner.shape[0])\n            for cc in range(inner.shape[1])\n            if int(inner[rr, cc]) == GREY\n        ]\n        steps = min(int(steps), int(len(grey_coords)))\n\n        dr, dc = direction\n        tr = int(dr * steps)\n        tc = int(dc * steps)\n\n        # choose which greys to fill in order from head side inward\n        if direction == (0, 1):\n            order = sorted(grey_coords, key=lambda p: (-p[1], p[0]))\n        elif direction == (0, -1):\n            order = sorted(grey_coords, key=lambda p: (p[1], -p[0]))\n        elif direction == (1, 0):\n            order = sorted(grey_coords, key=lambda p: (-p[0], -p[1]))\n        else:  # (-1,0)\n            order = sorted(grey_coords, key=lambda p: (p[0], p[1]))\n        to_fill = set(order[:steps])\n\n        # erase original container rect and original head pixels (destination stays)\n        out[r0 : r1 + 1, c0 : c1 + 1] = int(bg)\n        for r, c in head_pts:\n            if int(out[int(r), int(c)]) == int(hc):\n                out[int(r), int(c)] = int(bg)\n\n---\ndef generate_input() -> np.ndarray:\n    for _ in range(300):\n        result = _gen_attempt()\n        if result is not None:\n            return result\n    raise RuntimeError(\"Failed to generate valid after 300 attempts\")\n====\nfrom __future__ import annotations\n\nfrom collections import deque\n\nimport numpy as np\n\nfrom arc_utils import bbox, colors_present, draw_line, find_components, get_bg, is_contiguous, paste, random_free_location\nimport random\n\n\ndef _rect_frame_bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:\n    b = bbox(mask)\n    if b is None:\n        return None\n    r0, c0, r1, c1 = b\n    h = int(r1 - r0 + 1)\n    w = int(c1 - c0 + 1)\n    if h < 3 or w < 3:\n        return None\n\n    expected = np.zeros_like(mask, dtype=bool)\n    expected[r0 : r1 + 1, c0] = True\n    expected[r0 : r1 + 1, c1] = True\n    expected[r0, c0 : c1 + 1] = True\n    expected[r1, c0 : c1 + 1] = True\n    if not np.array_equal(mask, expected):\n        return None\n    return int(r0), int(c0), int(r1), int(c1)\n\n\ndef _scaled_index(i: int, src_len: int, dst_len: int) -> int:\n    assert src_len >= 1 and dst_len >= 1, \"axis lengths must be positive\"\n    if src_len == 1:\n        assert dst_len == 1, \"a one-pixel motif axis maps to a one-pixel interior axis\"\n        return 0\n    assert dst_len >= 2, \"multi-pixel motif axis needs a multi-pixel interior axis\"\n    return int(round(int(i) * (dst_len - 1) / (src_len - 1)))\n\n\ndef _fill_enclosed(stroke: np.ndarray) -> np.ndarray:\n    h, w = stroke.shape\n    open_space = ~stroke.astype(bool)\n    padded = np.pad(open_space, 1, constant_values=True)\n    seen = np.zeros_like(padded, dtype=bool)\n    q: deque[tuple[int, int]] = deque()\n    ph, pw = padded.shape\n\n    for r in range(ph):\n        for c in (0, pw - 1):\n            if padded[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                q.append((int(r), int(c)))\n    for c in range(pw):\n        for r in (0, ph - 1):\n            if padded[r, c] and not seen[r, c]:\n                seen[r, c] = True\n                q.append((int(r), int(c)))\n\n    while q:\n        r, c = q.popleft()\n        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):\n            if 0 <= nr < ph and 0 <= nc < pw and padded[nr, nc] and not seen[nr, nc]:\n                seen[nr, nc] = True\n                q.append((int(nr), int(nc)))\n\n    holes = open_space & ~seen[1 : h + 1, 1 : w + 1]\n    return stroke.astype(bool) | holes\n\n\ndef _stretch_sprite(sprite: np.ndarray, target_shape: tuple[int, int]) -> np.ndarray:\n    src_h, src_w = sprite.shape\n    dst_h, dst_w = target_shape\n    assert sprite.any(), \"expected a nonempty sprite\"\n\n    stroke = np.zeros((dst_h, dst_w), dtype=int)\n    coords = np.argwhere(sprite)\n    mapped: dict[tuple[int, int], tuple[int, int]] = {}\n    for sr, sc in coords:\n        tr = _scaled_index(int(sr), src_h, dst_h)\n        tc = _scaled_index(int(sc), src_w, dst_w)\n        mapped[(int(sr), int(sc))] = (tr, tc)\n        stroke[tr, tc] = 1\n\n    for sr, sc in coords:\n        sr = int(sr)\n        sc = int(sc)\n        for nr, nc in ((sr + 1, sc), (sr, sc + 1)):\n            if (nr, nc) in mapped:\n                r0, c0 = mapped[(sr, sc)]\n                r1, c1 = mapped[(nr, nc)]\n                draw_line(stroke, r0, c0, end_r=r1, end_c=c1, color=1)\n\n    return _fill_enclosed(stroke.astype(bool))\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Move the small colored sprite into the hollow frame by stretching its shape to the frame interior.\n\n    Input structure:\n    - The background is the dominant color.\n    - There are exactly two foreground colors: one forms a complete rectangular\n      one-pixel-thick frame, and the other forms one 4-connected sprite outside it.\n    - The frame interior is initially background.\n\n    Rule:\n    - Clear the original sprite from its outside location.\n    - Map the sprite bbox to the frame interior bbox, sending bbox extremes to\n      interior extremes.\n    - Draw straight horizontal or vertical segments between mapped positions of\n      adjacent sprite pixels, then fill any enclosed background region inside\n      those drawn segments.\n\n    Key insight:\n    The outside sprite is a miniature line/fill diagram for the frame interior,\n    not a bitmap to scale by block replication.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    colors = colors_present(g, exclude={bg})\n    assert len(colors) == 2, \"expected one frame color and one sprite color\"\n\n    frame_candidates: list[tuple[int, tuple[int, int, int, int]]] = []\n    for color in colors:\n        frame_bbox = _rect_frame_bbox(g == int(color))\n        if frame_bbox is not None:\n            frame_candidates.append((int(color), frame_bbox))\n    assert len(frame_candidates) == 1, \"expected a unique rectangular frame\"\n\n    frame_color, (fr0, fc0, fr1, fc1) = frame_candidates[0]\n    sprite_color = next(color for color in colors if color != frame_color)\n    sprite_components = find_components(g, bg=bg, colors=[sprite_color], connectivity=4)\n    assert len(sprite_components) == 1, \"expected a single 4-connected sprite\"\n    frame_region = np.zeros_like(g, dtype=bool)\n    frame_region[fr0 : fr1 + 1, fc0 : fc1 + 1] = True\n    assert not np.any((g == sprite_color) & frame_region), \"sprite must start outside the frame\"\n\n    sr0, sc0, sr1, sc1 = sprite_components[0][\"bbox\"]\n    sprite = g[sr0 : sr1 + 1, sc0 : sc1 + 1] == sprite_color\n\n    ir0, ic0 = fr0 + 1, fc0 + 1\n    ir1, ic1 = fr1 - 1, fc1 - 1\n    assert ir0 <= ir1 and ic0 <= ic1, \"frame must have an interior\"\n    interior = g[ir0 : ir1 + 1, ic0 : ic1 + 1]\n    assert np.all(interior == bg), \"frame interior must start empty\"\n\n    stretched = _stretch_sprite(sprite, (ir1 - ir0 + 1, ic1 - ic0 + 1))\n    out = g.copy()\n    out[g == sprite_color] = bg\n    out[ir0 : ir1 + 1, ic0 : ic1 + 1][stretched] = sprite_color\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Canvas and observed fixed colors.\n_GRID_SHAPE = (10, 10)\n_COLOR_COUNT = 10\n_BG = 7\n_FRAME_COLOR = 6\n\n# Frame size bounds and retry budget.\n_FRAME_SIZE_MIN = 3\n_FRAME_SIZE_MAX = 8\n_SINGLE_PIXEL_FRAME_SIZE = 3\n_MAX_GENERATION_ATTEMPTS = 300\n\n# Sprite color pool and source masks.\n_SPRITE_COLORS = tuple(c for c in range(_COLOR_COUNT) if c not in {_BG, _FRAME_COLOR})\n_SPRITE_SINGLE = np.ones((1, 1), dtype=bool)\n_SPRITE_PATTERNS_2X2 = [\n    np.array([[1, 1], [1, 0]], dtype=bool),\n    np.array([[1, 1], [0, 1]], dtype=bool),\n    np.array([[1, 0], [1, 1]], dtype=bool),\n    np.array([[0, 1], [1, 1]], dtype=bool),\n    np.array([[1, 1], [1, 1]], dtype=bool),\n]\n\ndef _outside_locations(\n    frame_bbox: tuple[int, int, int, int], patch_shape: tuple[int, int]\n) -> list[tuple[int, int]]:\n    fr0, fc0, fr1, fc1 = frame_bbox\n    ph, pw = patch_shape\n    locations: list[tuple[int, int]] = []\n    for r in range(_GRID_SHAPE[0] - ph + 1):\n        for c in range(_GRID_SHAPE[1] - pw + 1):\n            pr0, pc0, pr1, pc1 = r, c, r + ph - 1, c + pw - 1\n            separated = pr1 < fr0 or pr0 > fr1 or pc1 < fc0 or pc0 > fc1\n            if separated:\n                locations.append((r, c))\n    return locations\n\ndef _frame_positions(size: int, patch_shape: tuple[int, int]) -> list[tuple[int, int]]:\n    positions: list[tuple[int, int]] = []\n    for r in range(_GRID_SHAPE[0] - size + 1):\n        for c in range(_GRID_SHAPE[1] - size + 1):\n            frame_bbox = (r, c, r + size - 1, c + size - 1)\n            if _outside_locations(frame_bbox, patch_shape):\n                positions.append((r, c))\n    return positions\n\ndef _draw_frame(grid: np.ndarray, r0: int, c0: int, size: int, color: int) -> None:\n    r1, c1 = r0 + size - 1, c0 + size - 1\n    grid[r0 : r1 + 1, c0] = color\n    grid[r0 : r1 + 1, c1] = color\n    grid[r0, c0 : c1 + 1] = color\n    grid[r1, c0 : c1 + 1] = color\n\ndef _sample_sprite(size: int) -> np.ndarray:\n    return _SPRITE_SINGLE.copy() if size == _SINGLE_PIXEL_FRAME_SIZE else random.choice(_SPRITE_PATTERNS_2X2).copy()\n\ndef _sample_case() -> tuple[int, int, np.ndarray]:\n    sprite_color = random.choice(_SPRITE_COLORS)\n    size = random.randint(_FRAME_SIZE_MIN, _FRAME_SIZE_MAX)\n    return sprite_color, size, _sample_sprite(size)\n\ndef _build_candidate_grids(\n    frame_bbox: tuple[int, int, int, int], sprite: np.ndarray, sprite_color: int\n) -> tuple[np.ndarray, np.ndarray] | None:\n    fr0, fc0, fr1, fc1 = frame_bbox\n    stretched = _stretch_sprite(sprite, (fr1 - fr0 - 1, fc1 - fc0 - 1))\n    if not np.any(stretched):\n        return None\n\n    out = np.full(_GRID_SHAPE, _BG, dtype=int)\n    _draw_frame(out, fr0, fc0, fr1 - fr0 + 1, _FRAME_COLOR)\n    out[fr0 + 1 : fr1, fc0 + 1 : fc1][stretched] = sprite_color\n\n    inp = out.copy()\n    inp[fr0 + 1 : fr1, fc0 + 1 : fc1] = _BG\n\n    locations = _outside_locations(frame_bbox, sprite.shape)\n    if not locations:\n        return None\n    sr, sc = random.choice(locations)\n    patch = np.where(sprite, sprite_color, _BG)\n    paste(inp, patch, sr, sc, transparent=_BG)\n    return inp, out\n\ndef _gen_attempt() -> np.ndarray | None:\n    sprite_color, size, sprite = _sample_case()\n\n    frame_positions = _frame_positions(size, sprite.shape)\n    if not frame_positions:\n        return None\n    fr0, fc0 = random.choice(frame_positions)\n    frame_bbox = (fr0, fc0, fr0 + size - 1, fc0 + size - 1)\n\n    candidate = _build_candidate_grids(frame_bbox, sprite, sprite_color)\n    if candidate is None:\n        return None\n    inp, out = candidate\n\n    try:\n        if np.array_equal(main(inp), out):\n            return inp\n    except Exception:\n        return None\n    return None\n\ndef generate_input() -> np.ndarray:\n    for _ in range(_MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 465b7d93 input\")\n---\ndef generate_input() -> np.ndarray:\n    for _ in range(_MAX_GENERATION_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 465b7d93 input\")\n","exit_code":0,"status":"completed"}}
