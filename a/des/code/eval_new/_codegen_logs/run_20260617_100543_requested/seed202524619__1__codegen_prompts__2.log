25:     _, n = label_mask(mask, connectivity=4)\n 326:     if n != 1:\n 327:         return False\n 328:     # Vectorized degree check: each True pixel must have exactly 2 True 4-neighbors\n 329:     deg = np.zeros_like(mask, dtype=int)\n 330:     deg[1:, :] += mask[:-1, :]\n 331:     deg[:-1, :] += mask[1:, :]\n 332:     deg[:, 1:] += mask[:, :-1]\n 333:     deg[:, :-1] += mask[:, 1:]\n 334:     if not np.all(deg[mask] == 2):\n 335:         return False\n 336:     inv_lab, inv_n = label_mask(~mask, connectivity=4)\n 337:     boundary = set(inv_lab[0, :]) | set(inv_lab[-1, :]) | set(inv_lab[:, 0]) | set(inv_lab[:, -1])\n\n\n### /home/lixinyu/snap/new/ARC_code/train/9841fdad.py\n-- def main at line 14\n  14: def main(grid: np.ndarray) -> np.ndarray:\n  15:     \"\"\"\n  16:     Expand the colored runs from the left reference panel into the blank right panel.\n  17: \n  18:     Input structure:\n  19:     - A uniform rectangular frame surrounds the grid.\n  20:     - One full-height divider of the frame color splits a left reference panel\n  21:       from a blank right panel.\n  22:     - Both panels have one background margin column on each side of their active\n  23:       columns; the left active columns contain two-column endpoint slots, possibly\n  24:       connected by same-color horizontal runs.\n  25: \n  26:     Rule:\n  27:     - Keep the original grid and paint only in the right panel's active columns.\n  28:     - A source run exactly matching the left endpoint slot is copied to the left\n  29:       two columns of the right active span.\n  30:     - A source run exactly matching the right endpoint slot is copied to the right\n  31:       two columns of the right active span.\n  32:     - A source run connecting the endpoint slots is stretched across the entire\n  33:       right active span.\n  34: \n  35:     Key insight:\n  36:     The left panel is a compressed legend for the right panel: endpoint markers\n  37:     stay two pixels wide, while connectors between endpoints expand to fill the\n  38:     distance between them.\n  39:     \"\"\"\n  40:     g = np.asarray(grid, dtype=int)\n  41:     assert g.ndim == 2, \"expected a 2D grid\"\n  42:     H, W = g.shape\n  43:     assert H >= 3 and W >= 7, \"grid too small for framed two-panel structure\"\n  44: \n  45:     frame = int(g[0, 0])\n  46:     assert np.all(g[0, :] == frame) and np.all(g[-1, :] == frame), \"bad horizontal frame\"\n  47:     assert np.all(g[:, 0] == frame) and np.all(g[:, -1] == frame), \"bad vertical frame\"\n  48: \n  49:     divider = _single_divider_column(g, frame)\n  50:     assert divider >= 5 and W - divider >= 6, \"panels must contain margins and active slots\"\n  51: \n  52:     left_panel = g[1 : H - 1, 1:divider]\n  53:     left_bg = get_bg(left_panel)\n  54:     assert np.all(left_panel[:, 0] == left_bg), \"left panel must have a left margin\"\n  55:     assert np.all(left_panel[:, -1] == left_bg), \"left panel must have a right margin\"\n  56: \n  57:     mini_start = 2\n  58:     mini_end = divider - 2\n  59:     assert mini_end - mini_start + 1 >= 4, \"left active region must contain two endpoint slots\"\n  60:     left_slot = (mini_start, mini_start + 1)\n  61:     right_slot = (mini_end - 1, mini_end)\n  62: \n  63:     target_start = divider + 2\n  64:     target_end = W - 3\n  65:     assert target_end - target_start + 1 >= 4, \"right active region must contain endpoint slots\"\n  66:     right_bg = int(g[1, divider + 1])\n  67:     right_panel = g[1 : H - 1, divider + 1 : W - 1]\n  68:     assert np.all(right_panel == right_bg), \"right panel must be blank before expansion\"\n  69: \n  70:     out = g.copy()\n  71:     painted_any = False\n  72:     for r in range(1, H - 1):\n  73:         c = mini_start\n  74:         while c <= mini_end:\n  75:             color = int(g[r, c])\n  76:             if color == left_bg:\n  77:                 c += 1\n  78:                 continue\n  79: \n  80:             c0 = c\n  81:             while c <= mini_end and int(g[r, c]) == color:\n  82:                 c += 1\n  83:             c1 = c - 1\n  84: \n  85:             in_left_slot = (c0, c1) == left_slot\n  86:             in_right_slot = (c0, c1) == right_slot\n  87:             if in_left_slot:\n  88:                 d0, d1 = target_start, target_start + 1\n  89:             elif in_right_slot:\n  90:                 d0, d1 = target_end - 1, target_end\n  91:             else:\n  92:                 assert c0 == left_slot[0] and c1 >= right_slot[0], \"run must connect endpoint slots\"\n  93:                 d0, d1 = target_start, target_end\n  94: \n  95:             assert np.all(out[r, d0 : d1 + 1] == right_bg), \"expanded runs must not collide\"\n  96:             out[r, d0 : d1 + 1] = color\n  97:             painted_any = True\n  98: \n  99:     assert painted_any, \"expected at least one colored source run\"\n 100:     return out\n 101: \n 102: # --------------- generator (att2) ---------------\n 103: # Color and retry controls.\n 104: LEFT_BG = 1\n 105: COLOR_IDS = tuple(range(10))\n 106: FRAME_COLORS = (0, 2, 3, 4, 5, 6, 7, 8, 9)\n 107: MAX_RUN_COLORS = 4\n 108: GENERATION_RETRIES = 300\n 109: \n 110: # Canvas, group, and row layout bounds.\n 111: LEFT_ACTIVE_WIDTHS = range(4, 7)\n 112: RIGHT_ACTIVE_WIDTHS = range(11, 14)\n 113: TOTAL_HEIGHTS = (11, 15)\n 114: RIGHT_TO_LEFT_MIN_RATIO = 2\n 115: FIXED_WIDTH_CELLS = 7\n 116: NON_GROUP_ROWS = 4\n 117: GROUP_COUNTS = (3, 5)\n 118: GROUP_HEIGHT_BOUNDS = (1, 2)\n 119: GAP_BOUNDS = (1, 2)\n 120: FIRST_ACTIVE_ROW = 2\n 121: \n 122: # Run pattern geometry.\n 123: RUN_WIDTH = 2\n 124: LEFT_ACTIVE_START = 2\n 125: RIGHT_TARGET_OFFSET = 2\n 126: BASE_PATTERNS = (\"LEFT\", \"RIGHT\", \"FULL\")\n 127: DOUBLE_PATTERN = \"LEFT_RIGHT\"\n 128: \n 129: def _gen_sequences_with_sum(length: int, lo: int, hi: int, total: int) -> list[tuple[int, ...]]:\n 130:     if length == 0:\n 131:         return [()] if total == 0 else []\n 132:     if total < length * lo or total > length * hi:\n 133:         return []\n 134:     out = []\n 135:     for value in range(lo, hi + 1):\n 136:         for rest in _gen_sequences_with_sum(length - 1, lo, hi, total - value):\n 137:             out.append((value,) + rest)\n 138:     return out\n 139: \n 140: \n 141: def _gen_pattern_options(length: int, run_color_count: int, left_active_width: int) -> list[tuple[str, ...]]:\n 142:     base = list(BASE_PATTERNS)\n 143:     if run_color_count >= 2 and left_active_width >= RUN_WIDTH * 2 + 1:\n\n\n### /home/lixinyu/snap/new/ARC_code/train/465b7d93.py\n-- def main at line 96\n  96: def main(grid: np.ndarray) -> np.ndarray:\n  97:     \"\"\"\n  98:     Move the small colored sprite into the hollow frame by stretching its shape to the frame interior.\n  99: \n 100:     Input structure:\n 101:     - The background is the dominant color.\n 102:     - There are exactly two foreground colors: one forms a complete rectangular\n 103:       one-pixel-thick frame, and the other forms one 4-connected sprite outside it.\n 104:     - The frame interior is initially background.\n 105: \n 106:     Rule:\n 107:     - Clear the original sprite from its outside location.\n 108:     - Map the sprite bbox to the frame interior bbox, sending bbox extremes to\n 109:       interior extremes.\n 110:     - Draw straight horizontal or vertical segments between mapped positions of\n 111:       adjacent sprite pixels, then fill any enclosed background region inside\n 112:       those drawn segments.\n 113: \n 114:     Key insight:\n 115:     The outside sprite is a miniature line/fill diagram for the frame interior,\n 116:     not a bitmap to scale by block replication.\n 117:     \"\"\"\n 118:     g = np.asarray(grid, dtype=int)\n 119:     bg = get_bg(g)\n 120:     colors = colors_present(g, exclude={bg})\n 121:     assert len(colors) == 2, \"expected one frame color and one sprite color\"\n 122: \n 123:     frame_candidates: list[tuple[int, tuple[int, int, int, int]]] = []\n 124:     for color in colors:\n 125:         frame_bbox = _rect_frame_bbox(g == int(color))\n 126:         if frame_bbox is not None:\n 127:             frame_candidates.append((int(color), frame_bbox))\n 128:     assert len(frame_candidates) == 1, \"expected a unique rectangular frame\"\n 129: \n 130:     frame_color, (fr0, fc0, fr1, fc1) = frame_candidates[0]\n 131:     sprite_color = next(color for color in colors if color != frame_color)\n 132:     sprite_components = find_components(g, bg=bg, colors=[sprite_color], connectivity=4)\n 133:     assert len(sprite_components) == 1, \"expected a single 4-connected sprite\"\n 134:     frame_region = np.zeros_like(g, dtype=bool)\n 135:     frame_region[fr0 : fr1 + 1, fc0 : fc1 + 1] = True\n 136:     assert not np.any((g == sprite_color) & frame_region), \"sprite must start outside the frame\"\n 137: \n 138:     sr0, sc0, sr1, sc1 = sprite_components[0][\"bbox\"]\n 139:     sprite = g[sr0 : sr1 + 1, sc0 : sc1 + 1] == sprite_color\n 140: \n 141:     ir0, ic0 = fr0 + 1, fc0 + 1\n 142:     ir1, ic1 = fr1 - 1, fc1 - 1\n 143:     assert ir0 <= ir1 and ic0 <= ic1, \"frame must have an interior\"\n 144:     interior = g[ir0 : ir1 + 1, ic0 : ic1 + 1]\n 145:     assert np.all(interior == bg), \"frame interior must start empty\"\n 146: \n 147:     stretched = _stretch_sprite(sprite, (ir1 - ir0 + 1, ic1 - ic0 + 1))\n 148:     out = g.copy()\n 149:     out[g == sprite_color] = bg\n 150:     out[ir0 : ir1 + 1, ic0 : ic1 + 1][stretched] = sprite_color\n 151:     return out\n 152: \n 153: # --------------- generator (att2, o5x) ---------------\n 154: \n 155: # Canvas and observed fixed colors.\n 156: _GRID_SHAPE = (10, 10)\n 157: _COLOR_COUNT = 10\n 158: _BG = 7\n 159: _FRAME_COLOR = 6\n 160: \n 161: # Frame size bounds and retry budget.\n 162: _FRAME_SIZE_MIN = 3\n 163: _FRAME_SIZE_MAX = 8\n 164: _SINGLE_PIXEL_FRAME_SIZE = 3\n 165: _MAX_GENERATION_ATTEMPTS = 300\n 166: \n 167: # Sprite color pool and source masks.\n 168: _SPRITE_COLORS = tuple(c for c in range(_COLOR_COUNT) if c not in {_BG, _FRAME_COLOR})\n 169: _SPRITE_SINGLE = np.ones((1, 1), dtype=bool)\n 170: _SPRITE_PATTERNS_2X2 = [\n 171:     np.array([[1, 1], [1, 0]], dtype=bool),\n 172:     np.array([[1, 1], [0, 1]], dtype=bool),\n 173:     np.array([[1, 0], [1, 1]], dtype=bool),\n 174:     np.array([[0, 1], [1, 1]], dtype=bool),\n 175:     np.array([[1, 1], [1, 1]], dtype=bool),\n 176: ]\n 177: \n 178: def _outside_locations(\n 179:     frame_bbox: tuple[int, int, int, int], patch_shape: tuple[int, int]\n 180: ) -> list[tuple[int, int]]:\n 181:     fr0, fc0, fr1, fc1 = frame_bbox\n 182:     ph, pw = patch_shape\n 183:     locations: list[tuple[int, int]] = []\n 184:     for r in range(_GRID_SHAPE[0] - ph + 1):\n 185:         for c in range(_GRID_SHAPE[1] - pw + 1):\n 186:             pr0, pc0, pr1, pc1 = r, c, r + ph - 1, c + pw - 1\n 187:             separated = pr1 < fr0 or pr0 > fr1 or pc1 < fc0 or pc0 > fc1\n 188:             if separated:\n 189:                 locations.append((r, c))\n 190:     return locations\n 191: \n 192: def _frame_positions(size: int, patch_shape: tuple[int, int]) -> list[tuple[int, int]]:\n 193:     positions: list[tuple[int, int]] = []\n 194:     for r in range(_GRID_SHAPE[0] - size + 1):\n 195:         for c in range(_GRID_SHAPE[1] - size + 1):\n 196:             frame_bbox = (r, c, r + size - 1, c + size - 1)\n 197:             if _outside_locations(frame_bbox, patch_shape):\n 198:                 positions.append((r, c))\n 199:     return positions\n 200: \n 201: def _draw_frame(grid: np.ndarray, r0: int, c0: int, size: int, color: int) -> None:\n 202:     r1, c1 = r0 + size - 1, c0 + size - 1\n 203:     grid[r0 : r1 + 1, c0] = color\n 204:     grid[r0 : r1 + 1, c1] = color\n 205:     grid[r0, c0 : c1 + 1] = color\n 206:     grid[r1, c0 : c1 + 1] = color\n 207: \n 208: def _sample_sprite(size: int) -> np.ndarray:\n 209:     return _SPRITE_SINGLE.copy() if size == _SINGLE_PIXEL_FRAME_SIZE else random.choice(_SPRITE_PATTERNS_2X2).copy()\n 210: \n 211: def _sample_case() -> tuple[int, int, np.ndarray]:\n 212:     sprite_color = random.choice(_SPRITE_COLORS)\n 213:     size = random.randint(_FRAME_SIZE_MIN, _FRAME_SIZE_MAX)\n 214:     return sprite_color, size, _sample_sprite(size)\n 215: \n 216: def _build_candidate_grids(\n 217:     frame_bbox: tuple[int, int, int, int], sprite: np.ndarray, sprite_color: int\n 218: ) -> tuple[np.ndarray, np.ndarray] | None:\n 219:     fr0, fc0, fr1, fc1 = frame_bbox\n 220:     stretched = _stretch_sprite(sprite, (fr1 - fr0 - 1, fc1 - fc0 - 1))\n 221:     if not np.any(stretched):\n 222:         return None\n 223: \n 224:     out = np.full(_GRID_SHAPE, _BG, dtype=int)\n 225:     _draw_frame(out, fr0, fc0, fr1 - fr0 + 1, _FRAME_COLOR)\n\n\n### /home/lixinyu/snap/new/ARC_code/eval/b0039139.py\n-- def main at line 28\n  28: def main(grid: np.ndarray) -> np.ndarray:\n  29:     \"\"\"\n  30:     Recolor a cropped template and repeat it according to a component-count stencil.\n  31: \n  32:     Input structure:\n  33:     - Solid blue (1) separator rows or columns split the grid into four sections.\n  34:     - Section 1 is a black-background shape template; section 2 is a component-count stencil.\n  35:     - Sections 3 and 4 are solid color swatches for output foreground and background.\n  36: \n  37:     Rule:\n  38:     - Crop section 1 to the bbox of its non-black pixels and recolor it with the two swatches.\n  39:     - Count 4-connected non-black components in section 2.\n  40:     - Repeat the recolored crop that many times, inserting one background-colored row/column between copies.\n  41: \n  42:     Key insight: The second section encodes only the repeat count; the output orientation\n  43:     is inherited from whether the input separators are columns or rows.\n  44:     \"\"\"\n  45:     g = np.asarray(grid, dtype=int)\n  46:     orientation, sections = _split_sections(g)\n  47:     template, repetition_pattern, foreground_block, background_block = sections[:4]\n  48: \n  49:     template_mask = template != 0\n  50:     template_bbox = bbox(template_mask)\n  51:     if template_bbox is None:\n  52:         return np.empty((0, 0), dtype=int)\n  53: \n  54:     foreground = _solid_color(foreground_block)\n  55:     background = _solid_color(background_block)\n  56:     tile_mask = crop_bbox(template_mask, template_bbox)\n  57:     tile = np.where(tile_mask, foreground, background).astype(int)\n  58: \n  59:     n_repeats = len(components_mask(repetition_pattern != 0, connectivity=4))\n  60:     if n_repeats <= 1:\n  61:         return tile\n  62: \n  63:     if orientation == \"horizontal\":\n  64:         sep = np.full((tile.shape[0], 1), background, dtype=int)\n  65:         pieces = [tile] + [x for _ in range(n_repeats - 1) for x in (sep, tile)]\n  66:         return np.hstack(pieces)\n  67: \n  68:     sep = np.full((1, tile.shape[1]), background, dtype=int)\n  69:     pieces = [tile] + [x for _ in range(n_repeats - 1) for x in (sep, tile)]\n  70:     return np.vstack(pieces)\n  71: \n  72: # --------------- generator (c) ---------------\n  73: \n  74: # --- CFG: tunable generation parameters ---\n  75: REPEAT_COUNT_RANGE = (2, 6)          # blob count N (= tile repetitions)\n  76: CROP_SIZE_RANGE = (2, 5)             # crop height/width bounds\n  77: DENSITY_RANGE = (0.55, 0.85)         # fill ratio of shape bounding box\n  78: COLOR_POOL = list(range(2, 10))      # fg/bg color choices (2-9 inclusive)\n  79: TEMPLATE_COLOR = 4                   # shape drawn in yellow inside template\n  80: STENCIL_COLOR = 3                    # blob color in stencil section\n  81: SEPARATOR_COLOR = 1                  # blue separator rows/cols\n  82: SWATCH_DIM_RANGE = (3, 8)           # varying-axis size for color swatches\n  83: STENCIL_VARYING_EXTRA = 4            # max extra cells beyond minimum stencil size\n  84: BLOB_PLACE_RETRIES = 200             # per-blob placement attempts in stencil\n  85: GEN_RETRIES = 300                    # outer generate_input retry limit\n  86: \n  87: \n  88: def _tile_repeat(tile: np.ndarray, n: int, bg_color: int, horizontal: bool) -> np.ndarray:\n  89:     \"\"\"Repeat `tile` n times along the given axis with 1-pixel bg_color separator.\"\"\"\n  90:     if horizontal:\n  91:         sep = np.full((tile.shape[0], 1), bg_color, dtype=int)\n  92:         pieces = [tile] + [x for _ in range(n - 1) for x in (sep, tile)]\n  93:         return np.hstack(pieces)\n  94:     sep = np.full((1, tile.shape[1]), bg_color, dtype=int)\n  95:     pieces = [tile] + [x for _ in range(n - 1) for x in (sep, tile)]\n  96:     return np.vstack(pieces)\n  97: \n  98: \n  99: def _make_swatch(shared_dim: int, color: int, horizontal: bool) -> np.ndarray:\n 100:     \"\"\"Create a solid color swatch. shared_dim is the fixed axis; varying axis is random.\"\"\"\n 101:     varying = random.randint(*SWATCH_DIM_RANGE)\n 102:     if horizontal:\n 103:         return np.full((shared_dim, varying), color, dtype=int)\n 104:     return np.full((varying, shared_dim), color, dtype=int)\n 105: \n 106: \n 107: def _join_sections(sections: list[np.ndarray], shared_dim: int, horizontal: bool) -> np.ndarray:\n 108:     \"\"\"Join sections with single-pixel separator lines of SEPARATOR_COLOR.\"\"\"\n 109:     if horizontal:\n 110:         sep = np.full((shared_dim, 1), SEPARATOR_COLOR, dtype=int)\n 111:         parts = [sections[0]]\n 112:         for s in sections[1:]:\n 113:             parts.extend([sep, s])\n 114:         return np.hstack(parts)\n 115:     sep = np.full((1, shared_dim), SEPARATOR_COLOR, dtype=int)\n 116:     parts = [sections[0]]\n 117:     for s in sections[1:]:\n 118:         parts.extend([sep, s])\n 119:     return np.vstack(parts)\n 120: \n 121: \n 122: def _build_stencil(n_blobs: int, shared_dim: int, horizontal: bool) -> np.ndarray | None:\n 123:     \"\"\"Place n_blobs 2-cell blobs (1x2 or 2x1) of STENCIL_COLOR on a black grid.\n 124:     Blobs are separated by >=1 cell of black in all directions.\"\"\"\n 125:     min_varying = max(4, n_blobs * 2 + 2)\n 126:     varying_dim = random.randint(min_varying, min_varying + STENCIL_VARYING_EXTRA)\n 127: \n 128:     h, w = (shared_dim, varying_dim) if horizontal else (varying_dim, shared_dim)\n 129:     grid = np.zeros((h, w), dtype=int)\n 130: \n 131:     placed = 0\n 132:     for _ in range(BLOB_PLACE_RETRIES):\n 133:         if placed >= n_blobs:\n 134:             break\n 135:         br, bc = (1, 2) if random.choice([True, False]) else (2, 1)\n 136: \n 137:         if h - 1 - br < 1 or w - 1 - bc < 1:\n 138:             continue\n 139:         r = random.randint(1, h - 1 - br)\n 140:         c = random.randint(1, w - 1 - bc)\n 141: \n 142:         # Check blob cells + 1-cell neighborhood are all black\n 143:         r0, c0 = max(0, r - 1), max(0, c - 1)\n 144:         r1, c1 = min(h, r + br + 1), min(w, c + bc + 1)\n 145:         if np.any(grid[r0:r1, c0:c1] != 0):\n 146:             continue\n 147: \n 148:         grid[r:r + br, c:c + bc] = STENCIL_COLOR\n 149:         placed += 1\n 150: \n 151:     return grid if placed == n_blobs else None\n 152: \n 153: \n 154: def _gen_attempt() -> np.ndarray | None:\n 155:     horizontal = random.choice([True, False])\n 156:     N = random.randint(*REPEAT_COUNT_RANGE)\n 157: \n\n\n### /home/lixinyu/snap/new/ARC_code/eval/e8686506.py\n-- def main at line 171\n 171: def main(grid: np.ndarray) -> np.ndarray:\n 172:     \"\"\"\n 173:     Assemble scattered colored fragments into a left-right symmetric rectangle, jigsaw-style.\n 174: \n 175:     Input structure:\n 176:     - bg = most common color; remaining colors form small sprite fragments.\n 177:     - Optional roles: 4 singleton pixels of one color mark corners; horizontal bars mark top/bottom edges; paired vertical lines mark left/right edges.\n 178: \n 179:     Rule:\n 180:     - Collect all non-bg connected components as jigsaw pieces.\n 181:     - Determine output rectangle dimensions from total piece area.\n 182:     - Pack pieces into the rectangle so it is exactly mirror-symmetric (left-right) and same-color pieces never 4-touch.\n 183: \n 184:     Key insight: Left-right symmetry plus the no-same-color-touching constraint make the assembly unique; corner/edge markers anchor it when present.\n 185:     \"\"\"\n 186:     g = np.asarray(grid, dtype=int)\n 187:     bg = get_bg(g)\n 188: \n 189:     # Extract pieces (connected components per color)\n 190:     comps_by_color: dict[int, list[list[tuple[int, int]]]] = {}\n 191:     pieces = []\n 192:     color_piece_count: dict[int, int] = {}\n 193: \n 194:     for col in sorted(set(map(int, np.unique(g)))):\n 195:         if col == bg:\n 196:             continue\n 197:         comps = components_mask(g == col, connectivity=4)\n 198:         comps_by_color[col] = comps\n 199:         color_piece_count[col] = len(comps)\n 200:         for pts in comps:\n 201:             _, _, coords = _piece_sig(pts)\n 202:             pieces.append((col, coords))\n 203: \n 204:     # Group identical pieces into types\n 205:     from collections import Counter\n 206: \n 207:     ctr = Counter(pieces)\n 208:     types = []\n 209:     for (col, coords), cnt in sorted(ctr.items(), key=lambda kv: (-len(kv[0][1]), kv[0][0], kv[0][1])):\n 210:         arr = np.array(coords, dtype=int)\n 211:         h = int(arr[:, 0].max() + 1)\n 212:         w = int(arr[:, 1].max() + 1)\n 213:         types.append({\"col\": int(col), \"coords\": coords, \"h\": h, \"w\": w, \"cnt\": int(cnt)})\n 214: \n 215:     total_area = sum(int(t[\"cnt\"]) * len(t[\"coords\"]) for t in types)\n 216:     assert total_area > 0, \"total_area must be positive: grid must contain non-background pieces\"\n 217: \n 218:     # Disallow 4-neigh touching between different pieces of same color (preserve component counts)\n 219:     # Eval inputs use the unique closest-to-square portrait factor pair as the output shape.\n 220:     dims = [(h, w) for (h, w) in _factors(total_area) if h >= w]\n 221:     assert dims, \"at least one portrait factor pair must exist for the total piece area\"\n 222:     best_gap = min(abs(h - w) for h, w in dims)\n 223:     best_dims = [(h, w) for h, w in dims if abs(h - w) == best_gap]\n 224:     assert len(best_dims) == 1, \"closest-to-square portrait output shape must be unique\"\n 225:     H, W = best_dims[0]\n 226: \n 227:     # Frame constraint: under 8-connectivity, 1-2 pieces must exist whose union bbox\n 228:     # equals the output rectangle (H x W). Their relative positions are fixed in output.\n 229:     comps8_all = []\n 230:     for col in sorted(set(map(int, np.unique(g))) - {bg}):\n 231:         for pts in components_mask(g == col, connectivity=8):\n 232:             comps8_all.append((int(col), pts))\n 233:     def _is_lr_symmetric(parts, h, w):\n 234:         \"\"\"Check if the union of frame parts forms an LR-symmetric bitmap.\"\"\"\n 235:         all_pts = np.concatenate([p for _, p in parts])\n 236:         r0, c0 = int(all_pts[:, 0].min()), int(all_pts[:, 1].min())\n 237:         bmp = np.zeros((h, w), dtype=bool)\n 238:         for _, pts in parts:\n 239:             for r, c in pts:\n 240:                 bmp[int(r) - r0, int(c) - c0] = True\n 241:         return np.array_equal(bmp, bmp[:, ::-1])\n 242: \n 243:     frame_parts: list[tuple[int, np.ndarray]] = []\n 244:     for i, (c1, p1) in enumerate(comps8_all):\n 245:         r0, c0, r1, c1b = bbox_coords(p1)\n 246:         if r1 - r0 + 1 == H and c1b - c0 + 1 == W:\n 247:             if _is_lr_symmetric([(c1, p1)], H, W):\n 248:                 frame_parts = [(c1, p1)]\n 249:                 break\n 250:         for j in range(i + 1, len(comps8_all)):\n 251:             c2, p2 = comps8_all[j]\n 252:             union = np.concatenate([p1, p2])\n 253:             ur0, uc0, ur1, uc1 = bbox_coords(union)\n 254:             if ur1 - ur0 + 1 == H and uc1 - uc0 + 1 == W:\n 255:                 if _is_lr_symmetric([(c1, p1), (c2, p2)], H, W):\n 256:                     frame_parts = [(c1, p1), (c2, p2)]\n 257:                     break\n 258:         if frame_parts:\n 259:             break\n 260:     assert frame_parts, \"input must contain 1-2 LR-symmetric pieces (8-conn) whose union bbox equals output dims\"\n 261: \n 262:     req = _build_requirements(H, W, comps_by_color)\n 263: \n 264:     # Lock frame cells into req: their output positions are determined by input-relative positions.\n 265:     all_frame_pts = np.concatenate([p for _, p in frame_parts])\n 266:     fr0, fc0 = int(all_frame_pts[:, 0].min()), int(all_frame_pts[:, 1].min())\n 267:     for col, pts in frame_parts:\n 268:         for r, c in pts:\n 269:             or_, oc = int(r) - fr0, int(c) - fc0\n 270:             if 0 <= or_ < H and 0 <= oc < W:\n 271:                 req[or_, oc] = col\n 272: \n 273:     disallow_touch = {col for col, n in color_piece_count.items() if n > 1}\n 274:     sol = _assemble(types, H, W, req, disallow_touch)\n 275:     return sol.astype(int)\n 276: \n 277: # --------------- generator (o5x) ---------------\n 278: \n 279: # === CFG: Output dimensions ===\n 280: _AREA_MIN = 25               # minimum total piece area\n 281: _AREA_MAX = 50               # maximum total piece area (exclusive upper in range)\n 282: _WIDTH_REQUIRED = 5           # all valid outputs have width 5\n 283: _HEIGHT_MAX = 10              # maximum output height\n 284: \n 285: # === CFG: Color and palette ===\n 286: _N_COLORS_MIN = 4             # min distinct colors in abstract output\n 287: _N_COLORS_MAX = 6             # max distinct colors in abstract output\n 288: _TWO_FRAME_MIN_H = 6          # min height to allow 2-color frame\n 289: _TWO_FRAME_MIN_COLORS = 5     # min palette size to allow 2-color frame\n 290: _TWO_FRAME_PROB = 0.35         # probability of splitting frame into 2 colors\n 291: _CENTER_CAP_PROB = 0.5         # probability of capping center col at top/bottom\n 292: \n 293: # === CFG: Piece constraints ===\n 294: _MAX_PIECE_AREA = 6           # maximum area of any single 4-conn piece\n 295: _MAX_CHUNK_SIZE = 6           # max cells per hole chunk when splitting large holes\n 296: _PIECE_COUNT_MIN = 9          # min total 4-conn components in output\n 297: _PIECE_COUNT_MAX = 17         # max total 4-conn components in output\n 298: \n 299: # === CFG: Canvas / scatter ===\n 300: _CANVAS_MIN = 13              # min canvas dimension (rows and cols)\n\n","exit_code":0,"status":"completed"}}
