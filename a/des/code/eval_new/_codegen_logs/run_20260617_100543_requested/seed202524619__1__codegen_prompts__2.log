ground).\n  60:         rel_coords = [(int(r) - r0, int(c) - c0) for r, c in comp[\"coords\"]]\n  61:         m = mask_from_coords(rel_coords, patch.shape)\n  62:         pat = np.full_like(patch, bg)\n  63:         pat[m] = patch[m]\n  64: \n  65:         extracted.append(\n  66:             {\n  67:                 \"c0\": int(c0),\n  68:                 \"pat\": pat,\n  69:                 \"shape_key\": canonical_shape_key(m),\n  70:             }\n  71:         )\n  72: \n  73:     freq = Counter(d[\"shape_key\"] for d in extracted)\n  74:     out = np.full((H, W), int(bg), dtype=int)\n  75: \n  76:     for d in extracted:\n  77:         pat = d[\"pat\"]\n  78:         h, w = map(int, pat.shape)\n  79:         dest_r0 = 0 if int(freq[d[\"shape_key\"]]) >= 2 else int(H - h)\n  80:         dest_c0 = int(d[\"c0\"])\n  81:         paste(out, pat, dest_r0, dest_c0, transparent=int(bg))\n  82: \n  83:     return out\n  84: \n  85: # --------------- generator (att2) ---------------\n  86: \n  87: _RNG = np.random.default_rng()\n  88: \n  89: # ── CFG: canvas ──────────────────────────────────────────────────────\n  90: GRID_H_RANGE = (19, 31)          # H uniform in [19, 30]\n  91: GRID_W_RANGE = (19, 31)          # W uniform in [19, 30]\n  92: NUM_COLORS = 10                   # palette 0-9\n  93: \n  94: # ── CFG: component shapes ───────────────────────────────────────────\n  95: BBOX_MAX = 5                      # max h or w of a component bbox\n  96: AREA_RANGE = (3, 13)              # component area in [3, 12]\n  97: MIN_FILL_RATIO_X10 = 4            # area * 10 >= 4 * h * w\n  98: IRREGULAR_PROB = 0.85             # prefer non-rectangular bboxes\n  99: \n 100: # ── CFG: layout ─────────────────────────────────────────────────────\n 101: DUP_LAYOUTS = [(2,), (3,), (2, 2)]  # possible duplicate-group structures\n 102: MIN_COL_GAP = 1                   # minimum column gap between components\n 103: MIN_VERTICAL_GAP = 5              # min gap between top-group bott