ay, bg: int, mask_color: int, width: int) -> tuple[np.ndarray, int]:\n  34:     palette_mask = (g != int(bg)) & (g != int(mask_color))\n  35:     b = bbox(palette_mask)\n  36:     assert b is not None\n  37: \n  38:     palette = crop_bbox(g, b)\n  39:     assert palette.shape == (3, int(width))\n  40:     assert bool(np.all(palette != int(bg)))\n  41:     assert bool(np.all(palette != int(mask_color)))\n  42:     assert bool(np.array_equal(palette[0], palette[1]))\n  43:     assert len(set(map(int, palette[2]))) == 1\n  44: \n  45:     column_colors = palette[0].copy()\n  46:     hole_color = int(palette[2, 0])\n  47:     return column_colors, hole_color\n  48: \n  49: \n  50: def main(grid: np.ndarray) -> np.ndarray:\n  51:     \"\"\"\n  52:     Recolor the large mask crop column-by-column using the separate three-row palette strip.\n  53: \n  54:     Input structure:\n  55:     - The background is the most common color.\n  56:     - One large monochrome foreground object is the mask; its bbox is the output region and may contain background holes.\n  57:     - The remaining foreground is a 3-row palette rectangle with the same width as the mask bbox: two identical color rows and one uniform row.\n  58: \n  59:     Rule:\n  60:     - Crop to the mask object's bbox.\n  61:     - For each output column, color mask pixels with the corresponding color from the repeated palette rows.\n  62:     - Replace background holes inside the crop with the palette's uniform third-row color.\n  63: \n  64:     Key insight:\n  65:     The grey object is only a stencil; its columns select colors from the legend, while its holes expose the legend's fill color.\n  66:     \"\"\"\n  67:     g = np.asarray(grid, dtype=int)\n  68:     bg = get_bg(g)\n  69:     mask_color = _unique_largest_non_bg_color(g, bg)\n  70: \n  71:     b = _mask_bbox(g, mask_color)\n  72:     mask_crop = crop_bbox(g == int(mask_color), b)\n  73:     height, width = map(int, mask_crop.shape)\n  74: \n  75:     column_colors, hole_color = _palette(g, bg, mask_color, width)\n  76:     out = np.tile(column_colors, (height, 1))\n  77:     out[~mask_crop] = hole_color\n  78:     return out\n  79: \n  80: # --------------- generator (o5x) ---------------\n  81: \n  82: # Canvas, colors, and object bounds.\n  83: BACKGROUND_COLOR, MASK_COLOR = 0, 5\n  84: COLOR_MIN, COLOR_MAX = 1, 9\n  85: GRID_SIDE_MIN, GRID_SIDE_MAX = 10, 18\n  86: MASK_SIDE_MIN, MASK_SIDE_MAX = 5, 10\n  87: PALETTE_HEIGHT = 3\n  88: GAP_MIN, GAP_MAX = 1, 3\n  89: \n  90: # Palette run construction.\n\n### /home/lixinyu/snap/new/ARC_code/eval/62593bfd.py\n   1: from __future__ import annotations\n   2: from collections import Counter\n   3: import numpy as np\n   4: from arc_utils import crop_bbox, find_components, get_bg, paste\n   5: \n   6: \n   7: def mask_from_coords(coords, shape: tuple[int, int]) -> np.ndarray:\n   8:     \"\"\"Local helper: build a boolean mask from bbox-relative component coordinates.\"\"\"\n   9:     m = np.zeros(shape, dtype=bool)\n  10:     H, W = shape\n  11:     for r, c in coords:\n  12:         rr = int(r)\n  13:         cc = int(c)\n  14:         assert 0 <= rr < H and 0 <= cc < W\n  15:         m[rr, cc] = True\n  16:     return m\n  17: \n  18: \n  19: def canonical_shape_key(mask: np.ndarray) -> tuple[bytes, tuple[int, int]]:\n  20:     \"\"\"Canonicalize a boolean mask up to rotation and horizontal reflection.\"\"\"\n  21:     canon = np.asarray(mask, dtype=bool)\n  22:     best = (canon.tobytes(), tuple(map(int, canon.shape)))\n  23:     for _ in range(4):\n  24:         canon = np.rot90(canon)\n  25:         for v in (canon, np.fliplr(canon)):\n  26:             key = (v.tobytes(), tuple(map(int, v.shape)))\n  27:             if key < best:\n  28:                 best = key\n  29:     return best\n  30: \n  31: def main(grid: np.ndarray) -> np.ndarray:\n  32:     \"\"\"\n  33:     Sort objects to top or bottom edge by whether their shape (up to rotation/flip) is shared.\n  34: \n  35:     Input structure:\n  36:     - bg = most common color.\n  37:     - Several multicolor connected components (8-connected) scattered across the grid.\n  38: \n  39:     Rule:\n  40:     - Compute each object's canonical shape (binary mask, invariant to rotation and flip).\n  41:     - Objects whose shape appears in two or more components → translate to TOP edge (row 0).\n  42:     - Objects whose shape is unique → translate to BOTTOM edge (row H−h).\n  43:     - Horizontal position (left column) is preserved; only vertical translation changes.\n  44: \n  45:     Key insight: The sorting criterion is shape frequency (rotation-invariant), not area — duplicated shapes go up, unique shapes go down.\n  46:     \"\"\"\n  47:     g = np.array(grid, dtype=int)\n  48:     H, W = g.shape\n  49:     bg = int(get_bg(g))\n  50: \n  51:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n  52:     assert not (not comps)\n  53: \n  54:     extracted = []\n  55:     for comp in comps:\n  56:         r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n  57:         patch = crop_bbox(g, (r0, c0, r1, c1))\n  58: \n  59:         # Isolate this component exactly (bbox rectangle may include background).\n  60:         rel_coords = [(int(r) - r0, int(c) - c0) for r, c in comp[\"coords\"]]\n  61:         m = mask_from_coords(rel_coords, patch.shape)\n  62:         pat = np.full_like(patch, bg)\n  63:         pat[m] = patch[m]\n  64: \n  65:         extracted.append(\n  66:             {\n  67:                 \"c0\": int(c0),\n  68:                 \"pat\": pat,\n  69:                 \"shape_key\": canonical_shape_key(m),\n  70:             }\n  71:         )\n  72: \n  73:     freq = Counter(d[\"shape_key\"] for d in extracted)\n  74:     out = np.full((H, W), int(bg), dtype=int)\n  75: \n  76:     for d in extracted:\n  77:         pat = d[\"pat\"]\n  78:         h, w = map(int, pat.shape)\n  79:         dest_r0 = 0 if int(freq[d[\"shape_key\"]]) >= 2 else int(H - h)\n  80:         dest_c0 = int(d[\"c0\"])\n  81:         paste(out, pat, dest_r0, dest_c0, transparent=int(bg))\n  82: \n  83:     return out\n  84: \n  85: # --------------- generator (att2) ---------------\n  86: \n  87: _RNG = np.random.default_rng()\n  88: \n  89: # ── CFG: canvas ──────────────────────────────────────────────────────\n  90: GRID_H_RANGE = (19, 31)          # H uniform in [19, 30]\n\n### /home/lixinyu/snap/new/ARC_code/train/753ea09b.py\n   1: from __future__ import annotations\n   2: \n   3: from collections import Counter\n   4: \n   5: import numpy as np\n   6: \n   7: from arc_utils import colors_present, get_bg, label_mask, neighbors4, paste\n   8: import itertools\n   9: import random\n  10: \n  11: \n  12: def _unique_largest_color(g: np.ndarray, colors: list[int]) -> int:\n  13:     counts = Counter(int(v) for v in g.ravel())\n  14:     ranked = sorted(colors, key=lambda color: counts[int(color)], reverse=True)\n  15:     assert len(ranked) >= 2, \"expected at least two candidate colors\"\n  16:     assert counts[ranked[0]] > counts[ranked[1]], \"foreground majority must be unique\"\n  17:     return int(ranked[0])\n  18: \n  19: \n  20: def _long_component_ids(lab: np.ndarray, n: int) -> set[int]:\n  21:     h = int(lab.shape[0])\n  22:     min_row_span = max(1, h // 3)\n  23:     ids: set[int] = set()\n  24:     for comp_id in range(1, n + 1):\n  25:         coords = np.argwhere(lab == comp_id)\n  26:         assert coords.size > 0, \"component labels must be nonempty\"\n  27:         r0 = int(coords[:, 0].min())\n  28:         r1 = int(coords[:, 0].max())\n  29:         if r1 - r0 + 1 >= min_row_span:\n  30:             ids.add(int(comp_id))\n  31:     assert len(ids) >= 2, \"expected at least two long contour components\"\n  32:     return ids\n  33: \n  34: \n  35: def _two_exterior_bg_ids(bg_lab: np.ndarray, n_bg: int) -> set[int]:\n  36:     assert n_bg >= 3, \"expected interior and exterior background regions\"\n  37:     sizes = {comp_id: int((bg_lab == comp_id).sum()) for comp_id in range(1, n_bg + 1)}\n  38:     size_values = sorted(sizes.values(), reverse=True)\n  39:     assert size_values[1] > size_values[2], \"two exterior regions must be separated by size\"\n  40:     cutoff = size_values[1]\n  41:     exterior = {comp_id for comp_id, size in sizes.items() if size >= cutoff}\n  42:     assert len(exterior) == 2, \"expected exactly two exterior background regions\"\n  43:     return exterior\n  44: \n  45: \n  46: def _touches_long_contour(\n  47:     coords: np.ndarray,\n  48:     fill_lab: np.ndarray,\n  49:     long_ids: set[int],\n  50: ) -> bool:\n  51:     for r, c in coords:\n  52:         for rr, cc in neighbors4(int(r), int(c)):\n  53:             if 0 <= rr < fill_lab.shape[0] and 0 <= cc < fill_lab.shape[1]:\n  54:                 if int(fill_lab[rr, cc]) in long_ids:\n  55:                     return True\n  56:     return False\n  57: \n  58: \n  59: def main(grid: np.ndarray) -> np.ndarray:\n  60:     \"\"\"\n  61:     Fill the small background compartments bounded by the long contour color.\n  62: \n  63:     Input structure:\n  64:     - The grid has one dominant background color and two foreground colors.\n  65:     - The more frequent foreground color forms long 8-connected contour fragments.\n  66:     - The other foreground color is a fixed distractor/obstacle color that partitions\n  67:       the background but is never recolored.\n  68: \n  69:     Rule:\n  70:     - Split the background into 4-connected regions using all foreground pixels as\n  71:       barriers.\n  72:     - Keep the two largest background regions as the outside of the contour drawing.\n  73:     - Recolor every other background region that touches a long contour component\n  74:       to the contour color; leave all foreground pixels unchanged.\n  75: \n  76:     Key insight:\n  77:     The apparent area fill is exactly a component-level fill of bounded background\n  78:     compartments, not a row-wise interpolation between individual contour pixels.\n  79:     \"\"\"\n  80:     g = np.asarray(grid, dtype=int)\n  81:     bg = get_bg(g)\n  82:     foreground = colors_present(g, exclude={bg})\n  83:     assert len(foreground) == 2, \"expected exactly two foreground colors\"\n  84: \n  85:     fill_color = _unique_largest_color(g, foreground)\n  86:     fill_lab, _n_fill = label_mask(g == fill_color, connectivity=8)\n  87:     long_ids = _long_component_ids(fill_lab, _n_fill)\n  88: \n  89:     bg_lab, n_bg = label_mask(g == bg, connectivity=4)\n  90:     exterior_ids = _two_exterior_bg_ids(bg_lab, n_bg)\n\n### /home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py\n   1: from __future__ import annotations\n   2: \n   3: import numpy as np\n   4: \n   5: from arc_utils import find_components, get_bg, label_mask, paste\n   6: import random\n   7: \n   8: \n   9: class _Node:\n  10:     def __init__(self, coords: np.ndarray, bbox: tuple[int, int, int, int], center: np.ndarray):\n  11:         self.coords = coords\n  12:         self.bbox = bbox\n  13:         self.center = center\n  14:         self.is_frame = False\n  15:         self.parent: _Node | None = None\n  16:         self.children: list[_Node] = []\n  17:         self.mask: np.ndarray | None = None\n  18:         self.anchor: tuple[int, int] | None = None\n  19:         self.axis_map: dict[str, list[tuple[float, int]]] = {\"row\": [], \"col\": []}\n  20: \n  21: \n  22: def _component_holes(shape: tuple[int, int], coords: np.ndarray) -> list[np.ndarray]:\n  23:     mask = np.zeros(shape, dtype=bool)\n  24:     mask[tuple(coords.T)] = True\n  25:     lab, n = label_mask(~mask, connectivity=4)\n  26:     boundary = set(lab[0, :]) | set(lab[-1, :]) | set(lab[:, 0]) | set(lab[:, -1])\n  27:     return [(lab == k) for k in range(1, n + 1) if k not in boundary]\n  28: \n  29: \n  30: def _intervals_overlap(a: tuple[int, int], b: tuple[int, int]) -> bool:\n  31:     return max(a[0], b[0]) <= min(a[1], b[1])\n  32: \n  33: \n  34: def _build_layout(node: _Node) -> None:\n  35:     if node.mask is not None:\n  36:         return\n  37: \n  38:     if not node.is_frame:\n  39:         node.mask = np.ones((1, 1), dtype=bool)\n  40:         node.anchor = (0, 0)\n  41:         node.axis_map = {\n  42:             \"row\": [(float(node.center[0]), 0)],\n  43:             \"col\": [(float(node.center[1]), 0)],\n  44:         }\n  45:         return\n  46: \n  47:     assert node.children\n  48:     child_mask, _placements, axis_map = _layout_group(node.children)\n  49:     h, w = child_mask.shape\n  50:     out = np.zeros((h + 4, w + 4), dtype=bool)\n  51:     out[0, :] = True\n  52:     out[-1, :] = True\n  53:     out[:, 0] = True\n  54:     out[:, -1] = True\n  55:     out[2 : 2 + h, 2 : 2 + w] |= child_mask\n  56: \n  57:     node.mask = out\n  58:     node.anchor = (out.shape[0] // 2, out.shape[1] // 2)\n  59:     node.axis_map = {\n  60:         \"row\": [(orig, pos + 2) for orig, pos in axis_map[\"row\"]],\n  61:         \"col\": [(orig, pos + 2) for orig, pos in axis_map[\"col\"]],\n  62:     }\n  63: \n  64: \n  65: def _axis_coordinates(nodes: list[_Node], axis: int) -> dict[_Node, int]:\n  66:     items = []\n  67:     for node in nodes:\n  68:         assert node.mask is not None and node.anchor is not None\n  69:         r0, c0, r1, c1 = node.bbox\n  70:         interval = (r0, r1) if axis == 0 else (c0, c1)\n  71:         mid = (interval[0] + interval[1]) / 2\n  72:         items.append((node, interval, mid, node.anchor[axis], node.mask.shape[axis]))\n  73: \n  74:     bands: list[dict] = []\n  75:     for item in sorted(items, key=lambda x: x[2]):\n  76:         interval = item[1]\n  77:         for band in bands:\n  78:             if any(_intervals_overlap(interval, other[1]) for other in band[\"items\"]):\n  79:                 band[\"items\"].append(item)\n  80:                 band[\"interval\"] = (\n  81:                     min(band[\"interval\"][0], interval[0]),\n  82:                     max(band[\"interval\"][1], interval[1]),\n  83:                 )\n  84:                 break\n  85:         else:\n  86:             bands.append({\"items\": [item], \"interval\": interval})\n  87: \n  88:     coord_by_node: dict[_Node, int] = {}\n  89:     coord = 0\n  90:     for i, band in enumerate(bands):\n\n### /home/lixinyu/snap/new/ARC_code/train/9841fdad.py\n   1: from __future__ import annotations\n   2: \n   3: import numpy as np\n   4: \n   5: from arc_utils import get_bg\n   6: \n   7: \n   8: def _single_divider_column(g: np.ndarray, frame: int) -> int:\n   9:     dividers = [c for c in range(1, g.shape[1] - 1) if np.all(g[:, c] == frame)]\n  10:     assert len(dividers) == 1, \"expected exactly one full-height interior divider\"\n  11:     return int(dividers[0])\n  12: \n  13: \n  14: def main(grid: np.ndarray) -> np.ndarray:\n  15:     \"\"\"\n  16:     Expand the colored runs from the left reference panel into the blank right panel.\n  17: \n  18:     Input structure:\n  19:     - A uniform rectangular frame surrounds the grid.\n  20:     - One full-height divider of the frame color splits a left reference panel\n  21:       from a blank right panel.\n  22:     - Both panels have one background margin column on each side of their active\n  23:       columns; the left active columns contain two-column endpoint slots, possibly\n  24:       connected by same-color horizontal runs.\n  25: \n  26:     Rule:\n  27:     - Keep the original grid and paint only in the right panel's active columns.\n  28:     - A source run exactly matching the left endpoint slot is copied to the left\n  29:       two columns of the right active span.\n  30:     - A source run exactly matching the right endpoint slot is copied to the right\n  31:       two columns of the right active span.\n  32:     - A source run connecting the endpoint slots is stretched across the entire\n  33:       right active span.\n  34: \n  35:     Key insight:\n  36:     The left panel is a compressed legend for the right panel: endpoint markers\n  37:     stay two pixels wide, while connectors between endpoints expand to fill the\n  38:     distance between them.\n  39:     \"\"\"\n  40:     g = np.asarray(grid, dtype=int)\n  41:     assert g.ndim == 2, \"expected a 2D grid\"\n  42:     H, W = g.shape\n  43:     assert H >= 3 and W >= 7, \"grid too small for framed two-panel structure\"\n  44: \n  45:     frame = int(g[0, 0])\n  46:     assert np.all(g[0, :] == frame) and np.all(g[-1, :] == frame), \"bad horizontal frame\"\n  47:     assert np.all(g[:, 0] == frame) and np.all(g[:, -1] == frame), \"bad vertical frame\"\n  48: \n  49:     divider = _single_divider_column(g, frame)\n  50:     assert divider >= 5 and W - divider >= 6, \"panels must contain margins and active slots\"\n  51: \n  52:     left_panel = g[1 : H - 1, 1:divider]\n  53:     left_bg = get_bg(left_panel)\n  54:     assert np.all(left_panel[:, 0] == left_bg), \"left panel must have a left margin\"\n  55:     assert np.all(left_panel[:, -1] == left_bg), \"left panel must have a right margin\"\n  56: \n  57:     mini_start = 2\n  58:     mini_end = divider - 2\n  59:     assert mini_end - mini_start + 1 >= 4, \"left active region must contain two endpoint slots\"\n  60:     left_slot = (mini_start, mini_start + 1)\n  61:     right_slot = (mini_end - 1, mini_end)\n  62: \n  63:     target_start = divider + 2\n  64:     target_end = W - 3\n  65:     assert target_end - target_start + 1 >= 4, \"right active region must contain endpoint slots\"\n  66:     right_bg = int(g[1, divider + 1])\n  67:     right_panel = g[1 : H - 1, divider + 1 : W - 1]\n  68:     assert np.all(right_panel == right_bg), \"right panel must be blank before expansion\"\n  69: \n  70:     out = g.copy()\n  71:     painted_any = False\n  72:     for r in range(1, H - 1):\n  73:         c = mini_start\n  74:         while c <= mini_end:\n  75:             color = int(g[r, c])\n  76:             if color == left_bg:\n  77:                 c += 1\n  78:                 continue\n  79: \n  80:             c0 = c\n  81:             while c <= mini_end and int(g[r, c]) == color:\n  82:                 c += 1\n  83:             c1 = c - 1\n  84: \n  85:             in_left_slot = (c0, c1) == left_slot\n  86:             in_right_slot = (c0, c1) == right_slot\n  87:             if in_left_slot:\n  88:                 d0, d1 = target_start, target_start + 1\n  89:             elif in_right_slot:\n  90:                 d0, d1 = target_end - 1, target_end\n\n### /home/lixinyu/snap/new/ARC_code/train/465b7d93.py\n   1: from __future__ import annotations\n   2: \n   3: from collections import deque\n   4: \n   5: import numpy as np\n   6: \n   7: from arc_utils import bbox, colors_present, draw_line, find_components, get_bg, is_contiguous, paste, random_free_location\n   8: import random\n   9: \n  10: \n  11: def _rect_frame_bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:\n  12:     b = bbox(mask)\n  13:     if b is None:\n  14:         return None\n  15:     r0, c0, r1, c1 = b\n  16:     h = int(r1 - r0 + 1)\n  17:     w = int(c1 - c0 + 1)\n  18:     if h < 3 or w < 3:\n  19:         return None\n  20: \n  21:     expected = np.zeros_like(mask, dtype=bool)\n  22:     expected[r0 : r1 + 1, c0] = True\n  23:     expected[r0 : r1 + 1, c1] = True\n  24:     expected[r0, c0 : c1 + 1] = True\n  25:     expected[r1, c0 : c1 + 1] = True\n  26:     if not np.array_equal(mask, expected):\n  27:         return None\n  28:     return int(r0), int(c0), int(r1), int(c1)\n  29: \n  30: \n  31: def _scaled_index(i: int, src_len: int, dst_len: int) -> int:\n  32:     assert src_len >= 1 and dst_len >= 1, \"axis lengths must be positive\"\n  33:     if src_len == 1:\n  34:         assert dst_len == 1, \"a one-pixel motif axis maps to a one-pixel interior axis\"\n  35:         return 0\n  36:     assert dst_len >= 2, \"multi-pixel motif axis needs a multi-pixel interior axis\"\n  37:     return int(round(int(i) * (dst_len - 1) / (src_len - 1)))\n  38: \n  39: \n  40: def _fill_enclosed(stroke: np.ndarray) -> np.ndarray:\n  41:     h, w = stroke.shape\n  42:     open_space = ~stroke.astype(bool)\n  43:     padded = np.pad(open_space, 1, constant_values=True)\n  44:     seen = np.zeros_like(padded, dtype=bool)\n  45:     q: deque[tuple[int, int]] = deque()\n  46:     ph, pw = padded.shape\n  47: \n  48:     for r in range(ph):\n  49:         for c in (0, pw - 1):\n  50:             if padded[r, c] and not seen[r, c]:\n  51:                 seen[r, c] = True\n  52:                 q.append((int(r), int(c)))\n  53:     for c in range(pw):\n  54:         for r in (0, ph - 1):\n  55:             if padded[r, c] and not seen[r, c]:\n  56:                 seen[r, c] = True\n  57:                 q.append((int(r), int(c)))\n  58: \n  59:     while q:\n  60:         r, c = q.popleft()\n  61:         for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):\n  62:             if 0 <= nr < ph and 0 <= nc < pw and padded[nr, nc] and not seen[nr, nc]:\n  63:                 seen[nr, nc] = True\n  64:                 q.append((int(nr), int(nc)))\n  65: \n  66:     holes = open_space & ~seen[1 : h + 1, 1 : w + 1]\n  67:     return stroke.astype(bool) | holes\n  68: \n  69: \n  70: def _stretch_sprite(sprite: np.ndarray, target_shape: tuple[int, int]) -> np.ndarray:\n  71:     src_h, src_w = sprite.shape\n  72:     dst_h, dst_w = target_shape\n  73:     assert sprite.any(), \"expected a nonempty sprite\"\n  74: \n  75:     stroke = np.zeros((dst_h, dst_w), dtype=int)\n  76:     coords = np.argwhere(sprite)\n  77:     mapped: dict[tuple[int, int], tuple[int, int]] = {}\n  78:     for sr, sc in coords:\n  79:         tr = _scaled_index(int(sr), src_h, dst_h)\n  80:         tc = _scaled_index(int(sc), src_w, dst_w)\n  81:         mapped[(int(sr), int(sc))] = (tr, tc)\n  82:         stroke[tr, tc] = 1\n  83: \n  84:     for sr, sc in coords:\n  85:         sr = int(sr)\n  86:         sc = int(sc)\n  87:         for nr, nc in ((sr + 1, sc), (sr, sc + 1)):\n  88:             if (nr, nc) in mapped:\n  89:                 r0, c0 = mapped[(sr, sc)]\n  90:                 r1, c1 = mapped[(nr, nc)]\n\n### /home/lixinyu/snap/new/ARC_code/eval/b0039139.py\n   1: from __future__ import annotations\n   2: \n   3: import numpy as np\n   4: \n   5: from arc_utils import bbox, components_mask, crop_bbox, random_sprite\n   6: import random\n   7: \n   8: \n   9: def _split_sections(grid: np.ndarray) -> tuple[str, list[np.ndarray]]:\n  10:     h, w = grid.shape\n  11:     sep = 1\n  12: \n  13:     sep_rows = [r for r in range(h) if bool(np.all(grid[r, :] == sep))]\n  14:     if sep_rows:\n  15:         cuts = [-1] + sep_rows + [h]\n  16:         return \"vertical\", [grid[a + 1 : b, :] for a, b in zip(cuts, cuts[1:]) if b > a + 1]\n  17: \n  18:     sep_cols = [c for c in range(w) if bool(np.all(grid[:, c] == sep))]\n  19:     cuts = [-1] + sep_cols + [w]\n  20:     return \"horizontal\", [grid[:, a + 1 : b] for a, b in zip(cuts, cuts[1:]) if b > a + 1]\n  21: \n  22: \n  23: def _solid_color(block: np.ndarray) -> int:\n  24:     vals, counts = np.unique(block, return_counts=True)\n  25:     return int(vals[int(np.argmax(counts))])\n  26: \n  27: \n  28: def main(grid: np.ndarray) -> np.ndarray:\n  29:     \"\"\"\n  30:     Recolor a cropped template and repeat it according to a component-count stencil.\n  31: \n  32:     Input structure:\n  33:     - Solid blue (1) separator rows or columns split the grid into four sections.\n  34:     - Section 1 is a black-background shape template; section 2 is a component-count stencil.\n  35:     - Sections 3 and 4 are solid color swatches for output foreground and background.\n  36: \n  37:     Rule:\n  38:     - Crop section 1 to the bbox of its non-black pixels and recolor it with the two swatches.\n  39:     - Count 4-connected non-black components in section 2.\n  40:     - Repeat the recolored crop that many times, inserting one background-colored row/column between copies.\n  41: \n  42:     Key insight: The second section encodes only the repeat count; the output orientation\n  43:     is inherited from whether the input separators are columns or rows.\n  44:     \"\"\"\n  45:     g = np.asarray(grid, dtype=int)\n  46:     orientation, sections = _split_sections(g)\n  47:     template, repetition_pattern, foreground_block, background_block = sections[:4]\n  48: \n  49:     template_mask = template != 0\n  50:     template_bbox = bbox(template_mask)\n  51:     if template_bbox is None:\n  52:         return np.empty((0, 0), dtype=int)\n  53: \n  54:     foreground = _solid_color(foreground_block)\n  55:     background = _solid_color(background_block)\n  56:     tile_mask = crop_bbox(template_mask, template_bbox)\n  57:     tile = np.where(tile_mask, foreground, background).astype(int)\n  58: \n  59:     n_repeats = len(components_mask(repetition_pattern != 0, connectivity=4))\n  60:     if n_repeats <= 1:\n  61:         return tile\n  62: \n  63:     if orientation == \"horizontal\":\n  64:         sep = np.full((tile.shape[0], 1), background, dtype=int)\n  65:         pieces = [tile] + [x for _ in range(n_repeats - 1) for x in (sep, tile)]\n  66:         return np.hstack(pieces)\n  67: \n  68:     sep = np.full((1, tile.shape[1]), background, dtype=int)\n  69:     pieces = [tile] + [x for _ in range(n_repeats - 1) for x in (sep, tile)]\n  70:     return np.vstack(pieces)\n  71: \n  72: # --------------- generator (c) ---------------\n  73: \n  74: # --- CFG: tunable generation parameters ---\n  75: REPEAT_COUNT_RANGE = (2, 6)          # blob count N (= tile repetitions)\n  76: CROP_SIZE_RANGE = (2, 5)             # crop height/width bounds\n  77: DENSITY_RANGE = (0.55, 0.85)         # fill ratio of shape bounding box\n  78: COLOR_POOL = list(range(2, 10))      # fg/bg color choices (2-9 inclusive)\n  79: TEMPLATE_COLOR = 4                   # shape drawn in yellow inside template\n  80: STENCIL_COLOR = 3                    # blob color in stencil section\n  81: SEPARATOR_COLOR = 1                  # blue separator rows/cols\n  82: SWATCH_DIM_RANGE = (3, 8)           # varying-axis size for color swatches\n  83: STENCIL_VARYING_EXTRA = 4            # max extra cells beyond minimum stencil size\n  84: BLOB_PLACE_RETRIES = 200             # per-blob placement attempts in stencil\n  85: GEN_RETRIES = 300                    # outer generate_input retry limit\n  86: \n  87: \n  88: def _tile_repeat(tile: np.ndarray, n: int, bg_color: int, horizontal: bool) -> np.ndarray:\n  89:     \"\"\"Repeat `tile` n times along the given axis with 1-pixel bg_color separator.\"\"\"\n  90:     if horizontal:\n\n### /home/lixinyu/snap/new/ARC_code/eval/e8686506.py\n   1: import numpy as np\n   2: \n   3: from arc_utils import bbox_coords, components_mask, get_bg, paste, random_free_location\n   4: import random\n   5: \n   6: \n   7: def _piece_sig(pts: np.ndarray) -> tuple[int, int, tuple[tuple[int, int], ...]]:\n   8:     r0, c0, r1, c1 = bbox_coords(pts)\n   9:     coords = tuple(sorted((int(r) - r0, int(c) - c0) for r, c in pts))\n  10:     return (r1 - r0 + 1), (c1 - c0 + 1), coords\n  11: \n  12: \n  13: def _factors(n: int) -> list[tuple[int, int]]:\n  14:     out = []\n  15:     for w in range(1, n + 1):\n  16:         if n % w == 0:\n  17:             h = n // w\n  18:             out.append((h, w))\n  19:     return out\n  20: \n  21: \n  22: def _build_requirements(\n  23:     H: int,\n  24:     W: int,\n  25:     comps_by_color: dict[int, list[list[tuple[int, int]]]],\n  26: ) -> np.ndarray:\n  27:     \"\"\"\n  28:     Build per-cell required color constraints (req[r,c] == -1 means unconstrained).\n  29: \n  30:     Heuristics supported by training examples:\n  31:       - If there is a color with exactly 4 singleton components, those are the four corners.\n  32:       - If there are full horizontal bars of length W-2 in the input, use them as the top/bottom edges\n  33:         between the corners (ordered by their vertical position in the input).\n  34:       - If there is a color with exactly two full vertical line components (width=1) in the input,\n  35:         place them on the left/right edges centered vertically.\n  36:     \"\"\"\n  37:     req = np.full((H, W), -1, dtype=int)\n  38: \n  39:     # 4 singleton components -> corners\n  40:     corner_colors = [\n  41:         col\n  42:         for col, comps in comps_by_color.items()\n  43:         if len(comps) == 4 and all(len(p) == 1 for p in comps)\n  44:     ]\n  45:     assert len(corner_colors) <= 1, \"corner singleton color must be unique when present\"\n  46:     corner_color = corner_colors[0] if corner_colors else None\n  47:     if corner_color is not None:\n  48:         req[0, 0] = corner_color\n  49:         req[0, W - 1] = corner_color\n  50:         req[H - 1, 0] = corner_color\n  51:         req[H - 1, W - 1] = corner_color\n  52: \n  53:     # Horizontal bar(s) of length W-2 (filled, height 1)\n  54:     bar_colors: list[tuple[int, int]] = []  # (min_input_row, color)\n  55:     if W >= 3 and corner_color is not None:\n  56:         for col, comps in comps_by_color.items():\n  57:             for pts in comps:\n  58:                 r0, c0, r1, c1 = bbox_coords(pts)\n  59:                 hh, ww = r1 - r0 + 1, c1 - c0 + 1\n  60:                 if hh == 1 and ww == (W - 2) and len(pts) == ww:\n  61:                     bar_colors.append((r0, col))\n  62:                     break\n  63:         if bar_colors:\n  64:             assert len(bar_colors) <= 2, \"horizontal edge bar colors must be top/bottom only\"\n  65:             bar_colors.sort()\n  66:             top_col = bar_colors[0][1]\n  67:             bot_col = bar_colors[-1][1]\n  68:             req[0, 1 : W - 1] = top_col\n  69:             req[H - 1, 1 : W - 1] = bot_col\n  70: \n  71:     # Two full vertical line components -> left/right edges, centered vertically\n  72:     vertical_line_candidates = []\n  73:     for col, comps in comps_by_color.items():\n  74:         if len(comps) != 2:\n  75:             continue\n  76:         sigs = [_piece_sig(pts) for pts in comps]\n  77:         (h0, w0, coords0), (h1, w1, coords1) = sigs[0], sigs[1]\n  78:         if w0 == 1 and w1 == 1 and h0 == h1 and coords0 == coords1 and h0 > 1:\n  79:             vertical_line_candidates.append((col, h0))\n  80:     assert len(vertical_line_candidates) <= 1, \"paired vertical edge-line color must be unique when present\"\n  81:     if vertical_line_candidates:\n  82:         col, L = vertical_line_candidates[0]\n  83:         top = (H - L) // 2\n  84:         assert 0 <= top and top + L <= H, \"paired vertical edge lines must fit in the output height\"\n  85:         req[top : top + L, 0] = col\n  86:         req[top : top + L, W - 1] = col\n  87: \n  88:     return req\n  89: \n  90: \n","exit_code":0,"status":"completed"}}
