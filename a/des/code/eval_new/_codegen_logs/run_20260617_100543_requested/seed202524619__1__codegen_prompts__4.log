ique_color_with_count(counts, marker_candidates, marker_count)\n  50: \n  51:     out = np.full_like(g, bg)\n  52:     contour: set[tuple[int, int]] = set()\n  53:     for r, c in np.argwhere(g == frame_color):\n  54:         for nr, nc in neighbors4(int(r), int(c)):\n  55:             if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and g[nr, nc] == bg:\n  56:                 contour.add((int(nr), int(nc)))\n  57:     assert contour, \"expected outline to touch background contour cells\"\n  58: \n  59:     for r, c in contour:\n  60:         out[r, c] = marker_color\n  61:     return out\n  62: \n  63: # --------------- generator (att2) ---------------\n  64: \n  65: GRID_MIN, GRID_MAX = 5, 16\n  66: N_COLORS = 10\n  67: \n  68: SHAPE_MIN_HEIGHT, SHAPE_MAX_HEIGHT = 5, 7\n  69: SHAPE_MIN_WIDTH, SHAPE_MAX_WIDTH = 3, 5\n  70: START_WIDTH_MIN, START_WIDTH_MAX = 1, 2\n  71: MAX_LOCAL_WIDTH = 5\n  72: \n  73: MARKER_MIN_CELLS, MARKER_MAX_CELLS = 1, 3\n  74: \n  75: GEN_ATTEMPTS = 300\n  76: \n  77: EDGE_TOUCH_TOP_BOTTOM = \"TB\"\n  78: CORNER_EDGE_PAIRS = [\"TL\", \"TR\", \"BL\", \"BR\"]\n  79: ZERO_DELTA_SHIFTS = [-1, 0, 0, 0, 1]\n  80: \n  81: \n  82: def _gen_grow_parts(total, n):\n  83:     n_twos = total - n\n  84:     parts = [2] * n_twos + [1] * (n - n_twos)\n  85:     random.shuffle(parts)\n  86:     return parts\n  87: \n  88: def _gen_drop_parts(total, n):\n  89:     if n == 0:\n  90:         return []\n  91:     n_twos = random.randint(max(0, total - n), min(total // 2, n))\n  92:     n_ones = total - 2 * n_twos\n  93:     parts = [2] * n_twos + [1] * n_ones + [0] * (n - n_twos - n_ones)\n  94:     random.shuffle(parts)\n  95:     return parts\n  96: \n  97: def _gen_widths(height, max_width):\n  98:     start = random.randint(START_WIDTH_MIN, START_WIDTH_MAX)\n  99:     diff = max_width - start\n 100:     grow_steps = random.randint((diff + 1) // 2, min(diff, height - 1))\n 101:     widths = [start]\n 102:     for inc in _gen_grow_parts(diff, grow_steps):\n 103:         widths.append(widths[-1] + inc)\n 104: \n 105:     remaining = height - len(widths)\n 106:     min_end = max(1, max_width - 2 * remaining)\n 107:     end_width = random.randint(min_end, max_width)\n 108:     for dec in _gen_drop_parts(max_width - end_width, remaining):\n 109:         widths.append(widths[-1] - dec)\n 110:     return widths\n 111: \n 112: def _gen_intervals(widths):\n 113:     left, right = 0, widths[0] - 1\n 114:     intervals = [(left, right)]\n 115:     for prev_width, width in zip(widths, widths[1:]):\n 116:         delta = width - prev_width\n 117:         if delta == 2:\n 118:             left -= 1\n 119:             right += 1\n 120:         elif delta == 1:\n 121:             if random.choice([False, True]):\n 122:                 left -= 1\n 123:             else:\n 124:                 right += 1\n 125:         elif delta == 0:\n 126:             shift = random.choice(ZERO_DELTA_SHIFTS) if width >= 2 else 0\n 127:             left += shift\n 128:             right += shift\n 129:         elif delta == -1:\n 130:             if random.choice([False, True]):\n 131:                 left += 1\n 132:             else:\n 133:                 right -= 1\n 134:         elif delta == -2:\n 135:             left += 1\n 136:             right -= 1\n 137:         intervals.append((left, right))\n 138: \n 139:     min_left = min(l for l, _ in intervals)\n 140:     intervals = [(l - min_left, r - min_left) for l, r in intervals]\n 141:     if max(r for _, r in intervals) + 1 > MAX_LOCAL_WIDTH:\n 142:         return None\n 143:     return intervals\n 144: \n 145: def _gen_local_mask(intervals):\n 146:     height = len(intervals)\n 147:     width = max(r for _, r in intervals) + 1\n 148:     mask = np.zeros((height, width), dtype=bool)\n 149:     for r, (c0, c1) in enumerate(intervals):\n 150:         mask[r, c0 : c1 + 1] = True\n 151:     return mask\n 152: \n 153: def _gen_place_shape(grid_shape, local_mask, edge_pair):\n 154:     rows, cols = grid_shape\n 155:     height, width = local_mask.shape\n 156:     if edge_pair == EDGE_TOUCH_TOP_BOTTOM:\n 157:         if height != rows or width > cols - 2:\n 158:             return None\n 159:         return 0, random.randint(1, cols - width - 1)\n 160:     if height >= rows or width >= cols:\n 161:         return None\n 162:     if edge_pair == \"TL\":\n 163:         return 0, 0\n 164:     if edge_pair == \"TR\":\n 165:         return 0, cols - width\n 166:     if edge_pair == \"BL\":\n 167:         return rows - height, 0\n 168:     return rows - height, cols - width\n 169: \n 170: def _gen_full_mask(rows, cols, local_mask, r0, c0):\n 171:     mask = np.zeros((rows, cols), dtype=bool)\n 172:     height, width = local_mask.shape\n 173:     mask[r0 : r0 + height, c0 : c0 + width] = local_mask\n 174:     return mask\n 175: \n 176: def _gen_layers(mask):\n 177:     remaining = mask.copy()\n 178:     layers = []\n 179:     rows, cols = mask.shape\n 180:     while np.any(remaining):\n 181:         layer = np.zeros_like(mask)\n 182:         for r, c in np.argwhere(remaining):\n 183:             for nr, nc in neighbors4(int(r), int(c)):\n 184:                 if nr < 0 or nr >= rows or nc < 0 or nc >= cols or not remaining[nr, nc]:\n 185:                     layer[r, c] = True\n 186:                     break\n 187:         layers.append(layer)\n 188:         remaining[layer] = False\n 189:     return layers\n 190: \n 191: def _gen_contour(outline, shape):\n 192:     rows, cols = shape.shape\n 193:     contour = np.zeros_like(shape)\n 194:     for r, c in np.argwhere(outline):\n 195:         for nr, nc in neighbors4(int(r), int(c)):\n 196:             if 0 <= nr < rows and 0 <= nc < cols and not shape[nr, nc]:\n 197:                 contour[nr, nc] = True\n 198:     return contour\n 199: \n 200: def _choose_canvas_and_shape_profile():\n 201:     rows = random.randint(GRID_MIN, GRID_MAX)\n 202:     cols = random.randint(GRID_MIN, GRID_MAX)\n 203:     bg = random.randrange(N_COLORS)\n 204: \n 205:     edge_options = []\n 206:     if rows <= SHAPE_MAX_HEIGHT:\n 207:         edge_options.append(EDGE_TOUCH_TOP_BOTTOM)\n 208:     if rows >= SHAPE_MIN_HEIGHT + 1:\n 209:         edge_options.extend(CORNER_EDGE_PAIRS)\n 210:     if not edge_options:\n 211:         return None\n 212: \n 213:     edge_pair = random.choice(edge_options)\n 214:     height = rows if edge_pair == EDGE_TOUCH_TOP_BOTTOM else random.randint(\n 215:         SHAPE_MIN_HEIGHT, min(SHAPE_MAX_HEIGHT, rows - 1)\n 216:     )\n 217:     max_width_limit = cols - 2 if edge_pair == EDGE_TOUCH_TOP_BOTTOM else cols - 1\n 218:     if max_width_limit < SHAPE_MIN_WIDTH:\n 219:         return None\n 220:     max_width = random.randint(SHAPE_MIN_WIDTH, min(SHAPE_MAX_WIDTH, max_width_limit))\n 221: \n 222:     intervals = _gen_intervals(_gen_widths(height, max_width))\n 223:     if intervals is None:\n 224:         return None\n 225:     return rows, cols, bg, edge_pair, intervals\n 226: \n 227: def _build_shape(rows, cols, edge_pair, intervals):\n 228:     local_mask = _gen_local_mask(intervals)\n 229:     placement = _gen_place_shape((rows, cols), local_mask, edge_pair)\n 230:     if placement is None:\n 231:         return None\n 232: \n 233:     shape = _gen_full_mask(rows, cols, local_mask, *placement)\n 234:     shape_area = int(np.sum(shape))\n 235:     if rows * cols - shape_area <= shape_area:\n 236:         return None\n--- def generate_input ---\n 300: def generate_input():\n 301:     for _ in range(GEN_ATTEMPTS):\n 302:         grid = _gen_attempt()\n 303:         if grid is not None:\n 304:             return grid\n 305:     raise RuntimeError(\"failed to generate a valid aa62e3f4 input\")\n\n==================== /home/lixinyu/snap/new/ARC_code/eval/8b7bacbf.py ====================\n--- def main ---\n  41: def main(grid: np.ndarray) -> np.ndarray:\n  42:     \"\"\"\n  43:     Fill enclosed regions along a line seeded by unique border pixels.\n  44: \n  45:     Input structure:\n  46:     - bg = most common color.\n  47:     - Colored lines/drawings on the grid.\n  48:     - Unique single-pixel colors on the grid border mark seed endpoints of each line.\n  49: \n  50:     Rule:\n  51:     - Each border seed pixel connects (8-connected) to a line drawing.\n  52:     - Find closed bg cavities whose boundary touches that line.\n  53:     - Flood-fill each such cavity with the seed pixel's color.\n  54: \n  55:     Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\n  56:     \"\"\"\n  57:     g = np.asarray(grid, dtype=int)\n  58:     h, w = g.shape\n  59:     bg = get_bg(g)\n  60: \n  61:     out = g.copy()\n  62: \n  63:     # Precompute background regions (4-connected). Exclude those containing background corners as \"outside\".\n  64:     bg_comps = _components_mask(g == bg, conn8=False)\n  65:     regions = []  # list of (set_pts, boundary_set, touches_border, size)\n  66:     for pts in bg_comps:\n  67:         region = set(pts)\n  68:         touches = _touches_border(pts, h, w)\n  69:         boundary = set()\n  70:         for r, c in region:\n  71:             for nr, nc in neighbors4(r, c):\n  72:                 if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\n  73:                     boundary.add((nr, nc))\n  74:         regions.append((region, boundary, touches, len(region)))\n  75: \n  76:     corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\n  77:     outside_idxs = set()\n  78:     for i, (reg, _, _, _) in enumerate(regions):\n  79:         if any(p in reg for p in corners if int(g[p]) == bg):\n  80:             outside_idxs.add(i)\n  81: \n  82:     cavities = []\n  83:     for i, (reg, bnd, _, _) in enumerate(regions):\n  84:         if i in outside_idxs or not bnd:\n  85:             continue\n  86:         bcols = {int(g[p]) for p in bnd}\n  87:         cavities.append((reg, bnd, bcols))\n  88: \n  89:     for sr, sc in _seed_pixels(g, bg):\n  90:         seed_col = int(g[sr, sc])\n  91: \n  92:         neigh_cols = []\n  93:         for nr, nc in neighbors4(sr, sc):\n  94:             if 0 <= nr < h and 0 <= nc < w:\n  95:                 v = int(g[nr, nc])\n  96:                 if v != bg:\n  97:                     neigh_cols.append(v)\n  98:         assert neigh_cols, \"seed pixel must have at least one non-bg neighbor\"\n  99:         line_col = Counter(neigh_cols).most_common(1)[0][0]\n 100: \n 101:         # Trace the connected \"drawing\" reachable from the seed (8-connected, non-background).\n 102:         traced = _nonbg_component8_from(g, (sr, sc), bg)\n 103: \n 104:         for cav, boundary, bcols in cavities:\n 105:             if len(bcols) != 1:\n 106:                 continue\n 107:             boundary_in_traced = boundary & traced\n 108:             if not boundary_in_traced:\n 109:                 continue\n 110: \n 111:             # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\n 112:             # This prevents filling regions that are only connected through other structures, not the line itself.\n 113:             ok = False\n 114:             for r, c in boundary_in_traced:\n 115:                 for nr, nc in neighbors8(r, c):\n 116:                     if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\n 117:                         ok = True\n 118:                         break\n 119:                 if ok:\n 120:                     break\n 121:             if not ok:\n 122:                 continue\n 123: \n 124:             for r, c in cav:\n 125:                 if int(out[r, c]) == bg:\n 126:                     out[r, c] = seed_col\n 127: \n 128:     return out\n 129: \n 130: # --------------- generator (attempt_1_distractor_network) ---------------\n 131: \n 132: # ========================== CFG ==========================\n 133: # Canvas / grid\n 134: GRID_H_RANGE = (8, 30)             # grid height bounds\n 135: GRID_W_RANGE = (8, 30)             # grid width bounds\n 136: BG_COLORS = [0, 5]                 # background color choices\n 137: \n 138: # Seeds\n 139: SEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\n 140: MIN_LINE_LEN = 4                   # discard attempt if line shorter than this\n 141: LINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\n 142: \n 143: # Frame loops\n 144: FRAME_COLORS_MAX = 4               # max distinct frame colors\n 145: TOTAL_LOOPS_MAX = 9                # max total loops per grid\n 146: CAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\n 147: DISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\n 148: FRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\n 149: FRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\n 150: DISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\n 151: \n 152: # Line growth\n 153: DIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\n 154: DIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\n 155: ORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\n 156: ORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\n 157: BORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\n 158: BIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\n 159: \n 160: # Distractor network\n 161: DISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\n 162: DISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\n 163: DISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\n 164: DISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\n 165: DISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\n 166: \n 167: # Generation\n 168: GEN_RETRIES = 300                  # outer retry budget in generate_input()\n 169: # =========================================================\n 170: \n 171: DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\n 172: ORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n 173: \n 174: \n 175: def _in_bounds(h, w, r, c):\n 176:     return 0 <= r < h and 0 <= c < w\n 177: \n 178: \n 179: # ---------------------------------------------------------------------------\n 180: # Frame geometry\n 181: # ---------------------------------------------------------------------------\n 182: \n 183: def _frame_ring_coords(r0, c0, ch, cw):\n 184:     \"\"\"Return (ring_coords, cavity_coords) for a rounded-rect frame.\n 185: \n 186:     Frame bbox is [r0, r0+ch+1] x [c0, c0+cw+1] (inclusive).\n 187:     Ring = bbox boundary minus 4 corners.\n 188:     \"\"\"\n 189:     H, W = ch + 2, cw + 2\n 190:     ring = []\n 191:     for dr in range(H):\n 192:         for dc in range(W):\n 193:             on_bdr = (dr == 0 or dr == H - 1 or dc == 0 or dc == W - 1)\n 194:             corner = (dr in (0, H - 1)) and (dc in (0, W - 1))\n 195:             if on_bdr and not corner:\n 196:                 ring.append((r0 + dr, c0 + dc))\n 197:     cavity = [(r0 + 1 + dr, c0 + 1 + dc) for dr in range(ch) for dc in range(cw)]\n 198:     return ring, cavity\n 199: \n 200: \n 201: def _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\n 202:     \"\"\"Check that ring+cavity can be placed on canvas without conflicts.\n 203: \n 204:     Returns True if: ring and cavity cells are empty, no cavity cell is\n 205:     8-adjacent to line_col, ring is not 8-adjacent to foreign colors, and\n 206:     at least one ring cell is 8-adjacent to a line_col pixel.\n 207:     \"\"\"\n 208:     # Ring and cavity cells must all be empty\n 209:     for rr, cc in ring:\n 210:         if canvas[rr, cc] != -1:\n 211:             return False\n 212:     for rr, cc in cavity:\n 213:         if canvas[rr, cc] != -1:\n 214:             return False\n 215: \n 216:     # No cavity cell may be 8-adjacent to any line_col pixel\n 217:     for cr, cc in cavity:\n 218:         for nr, nc in neighbors8(cr, cc):\n 219:             if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n 220:                 return False\n 221: \n 222:     # Ring must not be 8-adjacent to any non-bg, non-line_col pixel\n 223:     ring_set = set(ring)\n 224:     for rr, cc in ring:\n 225:         for nr, nc in neighbors8(rr, cc):\n 226:             if not _in_bounds(h, w, nr, nc) or (nr, nc) in ring_set:\n 227:                 continue\n 228:             v = canvas[nr, nc]\n 229:             if v != -1 and v != line_col:\n 230:                 return False\n 231: \n 232:     # At least one ring cell must be 8-adjacent to a line_col pixel\n 233:     for rr, cc in ring:\n 234:         for nr, nc in neighbors8(rr, cc):\n 235:             if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\n 236:                 return True\n 237:     return False\n 238: \n 239: \n 240: # ---------------------------------------------------------------------------\n 241: # Line growth\n 242: # ---------------------------------------------------------------------------\n 243: \n 244: def _grow_line(grid, start, line_col, target_len, rng):\n 245:     \"\"\"Grow a meandering 8-connected 1px-wide path of line_col from start.\"\"\"\n 246:     h, w = grid.shape\n 247:     path = [start]\n 248:     dr_bias = 1 if start[0] < h // 2 else -1\n 249:     dc_bias = 1 if start[1] < w // 2 else -1\n 250:     cur = start\n 251:     path_set = {start}\n 252:     while len(path) < target_len:\n 253:         # Build weighted direction list: diagonals preferred, bias-aligned boosted\n 254:         dirs = []\n 255:         for ddr, ddc in DIAG_DIRS:\n 256:             aligned = (ddr == dr_bias or ddc == dc_bias)\n 257:             w_d = DIAG_WEIGHT_ALIGNED if aligned else DIAG_WEIGHT_OTHER\n 258:             dirs.extend([(ddr, ddc)] * w_d)\n 259:         for ddr, ddc in ORTHO_DIRS:\n 260:             aligned = (ddr == dr_bias and ddc == 0) or (ddc == dc_bias and ddr == 0)\n--- def generate_input ---\n 508: def generate_input() -> np.ndarray:\n 509:     rng = random.Random()\n 510:     for _ in range(GEN_RETRIES):\n 511:         g = _gen_attempt(rng)\n 512:         if g is not None:\n 513:             return g\n 514:     raise RuntimeError(\"generate_input: exhausted attempts\")\n\n==================== /home/lixinyu/snap/new/ARC_code/eval/a395ee82.py ====================\n--- def main ---\n   8: def main(grid: np.ndarray) -> np.ndarray:\n   9:     \"\"\"\n  10:     Stamp translated copies of a monochrome template guided by a singleton pixel layout.\n  11: \n  12:     Input structure:\n  13:     - bg = background. A large monochrome shape (template, color T).\n  14:     - Singleton pixels elsewhere: exactly one is color T (layout origin); the rest share color O (overlap color).\n  15:     - Singletons sit on a uniform-spacing lattice.\n  16: \n  17:     Rule:\n  18:     - Convert each singleton's offset from the origin into coarse lattice units.\n  19:     - Place a template copy at each offset, scaled by template height/width.\n  20:     - The origin's copy is painted O instead of T.\n  21:     - Any pixel covered by two or more copies is also recolored to O.\n  22: \n  23:     Key insight: The single T-colored singleton identifies both the origin position and the \"self\" copy, which is uniquely recolored.\n  24:     \"\"\"\n  25:     g = np.array(grid, dtype=int)\n  26:     bg = int(get_bg(g))\n  27:     H, W = g.shape\n  28: \n  29:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format=\"dict\")\n  30:     assert not (not comps)\n  31: \n  32:     template = max(comps, key=lambda d: int(d[\"area\"]))\n  33:     templ_coords = template[\"coords\"]\n  34:     templ_col = int(g[int(templ_coords[0, 0]), int(templ_coords[0, 1])])\n  35:     r0, c0, r1, c1 = map(int, template[\"bbox\"])\n  36:     h = int(bbox_h((r0, c0, r1, c1)))\n  37:     w = int(bbox_w((r0, c0, r1, c1)))\n  38: \n  39:     templ_rel = [(int(r) - int(r0), int(c) - int(c0)) for r, c in templ_coords]\n  40: \n  41:     # Singleton layout points (excluding the template component).\n  42:     singletons: list[tuple[int, int, int]] = []\n  43:     for comp in comps:\n  44:         if comp is template:\n  45:             continue\n  46:         if int(comp[\"area\"]) != 1:\n  47:             continue\n  48:         rr, cc = map(int, comp[\"coords\"][0])\n  49:         singletons.append((int(rr), int(cc), int(g[int(rr), int(cc)])))\n  50: \n  51:     origin = [(r, c) for (r, c, col) in singletons if int(col) == int(templ_col)]\n  52:     assert not (len(origin) != 1)\n  53:     orr, orc = origin[0]\n  54: \n  55:     other_cols = [int(col) for (_r, _c, col) in singletons if int(col) != int(templ_col)]\n  56:     assert not (not other_cols)\n  57:     overlap_col = int(Counter(other_cols).most_common(1)[0][0])\n  58: \n  59:     deltas = [(int(r - orr), int(c - orc), int(col)) for (r, c, col) in singletons]\n  60:     gcd_vals = [abs(int(x)) for dr, dc, _ in deltas for x in (dr, dc) if int(x) != 0]\n  61:     assert gcd_vals\n  62:     gunit = int(math.gcd(*gcd_vals))\n  63:     gunit = max(1, int(gunit))\n  64:     deltas = [(int(dr // gunit), int(dc // gunit), int(col)) for dr, dc, col in deltas]\n  65: \n  66:     total = np.zeros((H, W), dtype=int)\n  67:     center = np.zeros((H, W), dtype=int)  # coverage count from the origin singleton\n  68: \n  69:     for dr, dc, col in deltas:\n  70:         off_r = int(dr * h)\n  71:         off_c = int(dc * w)\n  72:         is_origin = int(col) == int(templ_col)\n  73:         for rr, cc in templ_rel:\n  74:             R = int(r0 + off_r + rr)\n  75:             C = int(c0 + off_c + cc)\n  76:             if 0 <= R < H and 0 <= C < W:\n  77:                 total[R, C] += 1\n  78:                 if is_origin:\n  79:                     center[R, C] += 1\n  80: \n  81:     out = np.full((H, W), int(bg), dtype=int)\n  82:     out[total > 0] = int(templ_col)\n  83:     out[(total == 1) & (center > 0)] = int(overlap_col)\n  84:     out[total >= 2] = int(overlap_col)\n  85:     return out\n  86: \n  87: # --------------- generator (a1) ---------------\n  88: \n  89: # ── Tunable configuration ──────────────────────────────────────────\n  90: GRID_SIZE = 22\n  91: TEMPLATE_H_CHOICES = [3, 4]       # template bbox height options\n  92: TEMPLATE_W = 3                    # template bbox width (fixed)\n  93: TEMPLATE_AREA_RANGE = (6, 10)     # absolute cell-count bounds\n  94: TEMPLATE_FILL_RANGE = (0.65, 0.85)  # fill-ratio bounds within bbox\n  95: SINGLETON_COUNT_RANGE = (5, 6)    # number of lattice singletons\n  96: LATTICE_EXTENT_RANGE = (3, 4)     # rows/cols of lattice polyomino\n  97: GUNIT = 2                         # singleton spacing in pixels\n  98: \n  99: # Retry budgets\n 100: SPANNING_RETRIES = 40             # attempts per spanning polyomino\n 101: TEMPLATE_RETRIES = 60             # attempts to build a valid template\n 102: SINGLETON_RETRIES = 50            # attempts to place singleton cluster\n 103: GENERATE_RETRIES = 300            # outer retry loop\n 104: \n 105: \n 106: def _random_polyomino(n: int, rows: int, cols: int) -> list[tuple[int, int]] | None:\n 107:     \"\"\"Grow a random 4-connected polyomino of *n* cells in a rows x cols grid.\"\"\"\n 108:     start = (random.randint(0, rows - 1), random.randint(0, cols - 1))\n 109:     cells = {start}\n 110:     frontier = []\n 111:     for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n 112:         nr, nc = start[0] + dr, start[1] + dc\n 113:         if 0 <= nr < rows and 0 <= nc < cols:\n 114:             frontier.append((nr, nc))\n 115:     while len(cells) < n and frontier:\n 116:         cell = random.choice(frontier)\n 117:         frontier.remove(cell)\n 118:         if cell in cells:\n 119:             continue\n 120:         cells.add(cell)\n 121:         for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n 122:             nr, nc = cell[0] + dr, cell[1] + dc\n 123:             if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in cells:\n 124:                 frontier.append((nr, nc))\n 125:     return list(cells) if len(cells) == n else None\n 126: \n 127: \n 128: def _spanning_polyomino(n: int, rows: int, cols: int) -> list[tuple[int, int]] | None:\n 129:     \"\"\"Polyomino of *n* cells that spans exactly rows x cols (touches all 4 edges).\"\"\"\n 130:     for _ in range(SPANNING_RETRIES):\n 131:         cells = _random_polyomino(n, rows, cols)\n 132:         if cells is None:\n 133:             continue\n 134:         rs = [r for r, c in cells]\n 135:         cs = [c for r, c in cells]\n 136:         if min(rs) == 0 and max(rs) == rows - 1 and min(cs) == 0 and max(cs) == cols - 1:\n 137:             return cells\n 138:     return None\n 139: \n 140: \n 141: def _gen_template(h: int, w: int) -> list[tuple[int, int]] | None:\n 142:     \"\"\"4-connected template shape in h x w, spanning bbox, within area/fill bounds.\"\"\"\n 143:     total = h * w\n 144:     lo = max(TEMPLATE_AREA_RANGE[0], int(np.ceil(total * TEMPLATE_FILL_RANGE[0])))\n 145:     hi = min(TEMPLATE_AREA_RANGE[1], int(np.floor(total * TEMPLATE_FILL_RANGE[1])))\n 146:     if lo > hi:\n 147:         return None\n 148:     for _ in range(TEMPLATE_RETRIES):\n 149:         area = random.randint(lo, hi)\n 150:         cells = _spanning_polyomino(area, h, w)\n 151:         if cells is not None:\n 152:             return cells\n 153:     return None\n 154: \n 155: \n 156: def _gen_lattice(n: int) -> tuple[list[tuple[int, int]], tuple[int, int]] | None:\n 157:     \"\"\"Lattice polyomino of *n* cells with strictly interior origin.\"\"\"\n 158:     ext_r = random.randint(*LATTICE_EXTENT_RANGE)\n 159:     ext_c = random.randint(*LATTICE_EXTENT_RANGE)\n 160:     cells = _spanning_polyomino(n, ext_r, ext_c)\n 161:     if cells is None:\n 162:         return None\n 163:     interior = [(r, c) for r, c in cells if 0 < r < ext_r - 1 and 0 < c < ext_c - 1]\n 164:     if not interior:\n 165:         return None\n 166:     return cells, random.choice(interior)\n 167: \n 168: \n 169: def _delta_bounds(deltas: list[tuple[int, int]]):\n 170:     \"\"\"Return (min_dr, max_dr, min_dc, max_dc) for a list of (dr, dc) offsets.\"\"\"\n 171:     min_dr = min(dr for dr, dc in deltas)\n 172:     max_dr = max(dr for dr, dc in deltas)\n 173:     min_dc = min(dc for dr, dc in deltas)\n 174:     max_dc = max(dc for dr, dc in deltas)\n 175:     return min_dr, max_dr, min_dc, max_dc\n 176: \n 177: \n 178: def _place_singletons(\n 179:     deltas, min_dr, max_dr, min_dc, max_dc,\n 180:     templ_cells, r0, c0, h, w, bg, T, O, occupied,\n 181: ) -> np.ndarray | None:\n 182:     \"\"\"Try to find a valid singleton cluster position and build the input grid.\"\"\"\n 183:     orr_lo, orr_hi = -min_dr * GUNIT, GRID_SIZE - 1 - max_dr * GUNIT\n 184:     orc_lo, orc_hi = -min_dc * GUNIT, GRID_SIZE - 1 - max_dc * GUNIT\n 185:     if orr_lo > orr_hi or orc_lo > orc_hi:\n 186:         return None\n 187: \n 188:     # Template bbox edges\n 189:     tr0, tr1 = r0, r0 + h - 1\n 190:     tc0, tc1 = c0, c0 + w - 1\n 191: \n 192:     for _ in range(SINGLETON_RETRIES):\n 193:         orr = random.randint(orr_lo, orr_hi)\n 194:         orc = random.randint(orc_lo, orc_hi)\n 195: \n 196:         # Singleton cluster bbox -- must be disjoint from template with >=1 bg cell gap\n 197:         sr0 = orr + min_dr * GUNIT\n 198:         sr1 = orr + max_dr * GUNIT\n 199:         sc0 = orc + min_dc * GUNIT\n 200:         sc1 = orc + max_dc * GUNIT\n 201:         if not (sr1 + 1 < tr0 or tr1 + 1 < sr0 or sc1 + 1 < tc0 or tc1 + 1 < sc0):\n 202:             continue\n 203: \n 204:         # Singletons must not land on stamp pixels\n 205:         if any((orr + dr * GUNIT, orc + dc * GUNIT) in occupied for dr, dc in deltas):\n 206:             continue\n 207: \n 208:         # Build input grid\n 209:         grid = np.full((GRID_SIZE, GRID_SIZE), bg, dtype=int)\n 210:         for tr, tc in templ_cells:\n 211:             grid[r0 + tr, c0 + tc] = T\n 212:         for dr, dc in deltas:\n 213:             grid[orr + dr * GUNIT, orc + dc * GUNIT] = T if (dr == 0 and dc == 0) else O\n 214: \n 215:         try:\n 216:             main(grid)\n 217:         except Exception:\n 218:             return None\n 219:         return grid\n 220: \n 221:     return None\n 222: \n 223: \n 224: def _gen_attempt() -> np.ndarray | None:\n 225:     \"\"\"Single attempt: pick colors, build template + lattice, place stamps + singletons.\"\"\"\n 226:     bg, T, O = random.sample(range(10), 3)\n 227: \n--- def generate_input ---\n 266: def generate_input() -> np.ndarray:\n 267:     for _ in range(GENERATE_RETRIES):\n 268:         result = _gen_attempt()\n 269:         if result is not None:\n 270:             return result\n 271:     raise RuntimeError(\"Failed to generate input after %d attempts\" % GENERATE_RETRIES)\n\n==================== /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py ====================\n--- def main ---\n   8: def main(grid: np.ndarray) -> np.ndarray:\n   9:     \"\"\"\n  10:     Slide a solid square through a winding channel to reach a same-sized target square.\n  11: \n  12:     Input structure:\n  13:     - bg (most common color). A river color forms a winding corridor.\n  14:     - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n  15: \n  16:     Rule:\n  17:     - The mover square travels along the river toward the destination.\n  18:     - It can only pass through positions where the full NxN area is river.\n  19:     - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n  20:     - The mover's original position is filled with the river color.\n  21: \n  22:     Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n  23:     \"\"\"\n  24:     g = np.array(grid, dtype=int)\n  25:     H, W = g.shape\n  26: \n  27:     # Corner-majority background (more stable than global mode here).\n  28:     bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n  29: \n  30:     # Detect solid square components (excluding bg).\n  31:     squares: list[dict] = []\n  32:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n  33:         col = int(comp[\"color\"])\n  34:         b = comp[\"bbox\"]\n  35:         if bbox_h(b) != bbox_w(b):\n  36:             continue\n  37:         patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n  38:         if not bool((patch == int(col)).all()):\n  39:             continue\n  40:         squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n  41: \n  42:     assert not (len(squares) < 2)\n  43: \n  44:     # Choose the size that appears at least twice (most common size).\n  45:     by_n: dict[int, list[dict]] = defaultdict(list)\n  46:     for s in squares:\n  47:         by_n[int(s[\"n\"])].append(s)\n  48:     nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n  49:     cand = by_n[int(nside)]\n  50:     assert not (len(cand) < 2)\n  51: \n  52:     cand.sort(key=lambda s: int(s[\"col\"]))\n  53:     mover = cand[0]\n  54:     dest = cand[1]\n  55: \n  56:     n = int(mover[\"n\"])\n  57:     sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n  58:     dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n  59: \n  60:     # River = most common remaining color (excluding bg and the two square colors).\n  61:     counts = Counter(map(int, g.flatten()))\n  62:     river = None\n  63:     for col, _ct in counts.most_common():\n  64:         if int(col) == int(bg):\n  65:             continue\n  66:         if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n  67:             continue\n  68:         river = int(col)\n  69:         break\n  70:     assert not (river is None)\n  71: \n  72:     trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n  73: \n  74:     # Feasible top-left placements: NxN window fully inside trav.\n  75:     h2 = int(H - n + 1)\n  76:     w2 = int(W - n + 1)\n  77:     assert not (h2 <= 0 or w2 <= 0)\n  78:     assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n  79: \n  80:     feasible = np.zeros((h2, w2), dtype=bool)\n  81:     for r in range(h2):\n  82:         for c in range(w2):\n  83:             if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n  84:                 feasible[int(r), int(c)] = True\n  85:     assert not (not bool(feasible[int(sr), int(sc)]))\n  86: \n  87:     # BFS on placement grid.\n  88:     dist = -np.ones((h2, w2), dtype=int)\n  89:     q = deque([(int(sr), int(sc))])\n  90:     dist[int(sr), int(sc)] = 0\n  91:     DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n  92:     while q:\n  93:         r, c = q.popleft()\n  94:         for dr2, dc2 in DIR4:\n  95:             rr = int(r + dr2)\n  96:             cc = int(c + dc2)\n  97:             if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n  98:                 dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n  99:                 q.append((int(rr), int(cc)))\n 100: \n 101:     # Pick target.\n 102:     if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n 103:         tr, tc = int(dr), int(dc)\n 104:     else:\n 105:         best = -1\n 106:         tr, tc = int(sr), int(sc)\n 107:         for r in range(h2):\n 108:             for c in range(w2):\n 109:                 if int(dist[int(r), int(c)]) > best:\n 110:                     best = int(dist[int(r), int(c)])\n 111:                     tr, tc = int(r), int(c)\n 112: \n 113:     out = g.copy()\n 114:     out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n 115:     out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n 116:     return out\n 117: \n 118: \n 119: # --- Generator ---\n 120: \n 121: _BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2\n 122: \n 123: \n 124: def _bfs_placement(feasible, sr, sc):\n 125:     h2, w2 = feasible.shape\n 126:     dist = -np.ones((h2, w2), dtype=int)\n 127:     dist[sr, sc] = 0\n 128:     q = deque([(sr, sc)])\n 129:     while q:\n 130:         r, c = q.popleft()\n 131:         for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n 132:             rr, cc = r + dr, c + dc\n 133:             if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:\n 134:                 dist[rr, cc] = dist[r, c] + 1\n 135:                 q.append((rr, cc))\n 136:     return dist\n 137: \n 138: \n 139: def _hamiltonian_walk(rows, cols, start, end):\n 140:     total = rows * cols\n 141:     best_path = None\n 142:     best_len = 0\n 143:     for _attempt in range(80):\n 144:         visited = {start}\n 145:         path = [start]\n 146:         cur = start\n 147:         while True:\n 148:             if cur == end and len(path) >= total * 0.7:\n 149:                 if len(path) > best_len:\n 150:                     best_path = list(path)\n 151:                     best_len = len(path)\n 152:                 break\n 153:             neighbors = []\n 154:             for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n 155:                 nr, nc = cur[0] + dr, cur[1] + dc\n 156:                 if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:\n 157:                     neighbors.append((nr, nc))\n 158:             if not neighbors:\n 159:                 break\n 160:             valid = []\n 161:             for nb in neighbors:\n 162:                 if nb == end:\n 163:                     valid.append(nb)\n 164:                     continue\n 165:                 test_visited = visited | {nb}\n 166:                 seen = {end}\n 167:                 q = deque([end])\n 168:                 while q:\n 169:                     cr, cc = q.popleft()\n 170:                     for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n 171:                         nr2, nc2 = cr + dr2, cc + dc2\n 172:                         if (0 <= nr2 < rows and 0 <= nc2 < cols and\n 173:                                 (nr2, nc2) not in test_visited and (nr2, nc2) not in seen):\n 174:                             seen.add((nr2, nc2))\n 175:                             q.append((nr2, nc2))\n 176:                 for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n 177:                     ar, ac = nb[0] + dr2, nb[1] + dc2\n 178:                     if (0 <= ar < rows and 0 <= ac < cols and\n 179:                             (ar, ac) not in test_visited and (ar, ac) in seen):\n 180:                         valid.append(nb)\n 181:                         break\n 182:             if not valid:\n 183:                 break\n 184:             random.shuffle(valid)\n 185:             nxt = valid[0]\n 186:             visited.add(nxt)\n 187:             path.append(nxt)\n 188:             cur = nxt\n 189:         if best_path and best_len >= total * 0.85:\n 190:             break\n 191:     return best_path\n 192: \n 193: \n 194: def _render_channel(grid, path, n, offsets_r, offsets_c):\n 195:     pixel_pos = []\n 196:     for cr, cc in path:\n 197:         pr, pc = offsets_r[cr], offsets_c[cc]\n 198:         pixel_pos.append((pr, pc))\n 199:         grid[pr:pr + n, pc:pc + n] = _RIVER\n 200:     for i in range(len(path) - 1):\n 201:         pr1, pc1 = pixel_pos[i]\n 202:         pr2, pc2 = pixel_pos[i + 1]\n 203:         if pr1 == pr2:\n 204:             c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n 205:             grid[pr1:pr1 + n, c_lo:c_hi] = _RIVER\n 206:         else:\n 207:             r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\n 208:             grid[r_lo:r_hi, pc1:pc1 + n] = _RIVER\n 209:     return pixel_pos\n 210: \n 211: \n 212: def _add_chokepoint(grid, pixel_pos_i, pixel_pos_j, n, direction):\n 213:     H, W = grid.shape\n 214:     pr1, pc1 = pixel_pos_i\n 215:     pr2, pc2 = pixel_pos_j\n 216:     narrow_w = random.randint(1, n - 1)\n 217:     remove = n - narrow_w\n 218:     side = random.randint(0, 1)\n 219: \n 220:     if direction == 'h':\n 221:         c_lo = min(pc1, pc2) + n\n 222:         c_hi = max(pc1, pc2)\n 223:         if c_hi <= c_lo:\n 224:             c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n 225:         hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))\n 226:         if hold_len < 1:\n 227:             hold_len = 1\n--- def generate_input ---\n 471: def generate_input():\n 472:     for _ in range(300):\n 473:         result = _gen_attempt()\n 474:         if result is not None:\n 475:             return result\n 476:     raise RuntimeError(\"Failed to generate valid input after 300 attempts\")\n 477: \n 478: \n\n==================== /home/lixinyu/snap/new/ARC_code/eval/581f7754.py ====================\n--- def main ---\n   7: def main(grid: np.ndarray) -> np.ndarray:\n   8:     \"\"\"\n   9:     Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n  10: \n  11:     Input structure:\n  12:     - bg = most common color.\n  13:     - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n  14:     - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n  15: \n  16:     Rule:\n  17:     - Match each sprite to the border anchor sharing its marker color.\n  18:     - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n  19:     - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n  20: \n  21:     Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n  22:     \"\"\"\n  23:     g = np.array(grid, dtype=int)\n  24:     H, W = g.shape\n  25:     bg = int(get_bg(g))\n  26: \n  27:     def is_border(r: int, c: int) -> bool:\n  28:         return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n  29: \n  30:     # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n  31:     anchors_by_color: dict[int, tuple[int, int]] = {}\n  32:     for r in range(H):\n  33:         for c in range(W):\n  34:             if not is_border(r, c):\n  35:                 continue\n  36:             v = int(g[r, c])\n  37:             if v == int(bg):\n  38:                 continue\n  39:             ok = True\n  40:             for rr, cc in neighbors4(int(r), int(c)):\n  41:                 if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n  42:                     ok = False\n  43:                     break\n  44:             if ok and v not in anchors_by_color:\n  45:                 anchors_by_color[int(v)] = (int(r), int(c))\n  46: \n  47:     assert not (not anchors_by_color)\n  48: \n  49:     anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n  50: \n  51:     # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n  52:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n  53: \n  54:     def component_marker_color(coords: np.ndarray) -> int | None:\n  55:         # For multi-color sprites, the marker color is the least frequent color inside the component.\n  56:         vals = [int(g[int(r), int(c)]) for r, c in coords]\n  57:         cnt = Counter(vals)\n  58:         if len(cnt) <= 1:\n  59:             return None\n  60:         return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n  61: \n  62:     def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n  63:         # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n  64:         pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n  65:         if not pts:\n  66:             return None\n  67:         if len(pts) == 1:\n  68:             return pts[0]\n  69:         S = {(int(r), int(c)) for r, c in coords}\n  70:         for r, c in pts:\n  71:             for rr, cc in neighbors4(int(r), int(c)):\n  72:                 if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n  73:                     return (int(r), int(c))\n  74:         return pts[0]\n  75: \n  76:     moves: list[tuple[np.ndarray, int, int]] = []\n  77: \n  78:     for comp in comps:\n  79:         coords = comp[\"coords\"]\n  80:         if coords.size == 0:\n  81:             continue\n  82: \n  83:         # --- STEP 3) Decide marker color for this component. ---\n  84:         marker_col = component_marker_color(coords)\n  85:         if marker_col is None:\n  86:             # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n  87:             if int(coords.shape[0]) != 1:\n  88:                 continue\n  89:             r, c = map(int, coords[0])\n  90:             v = int(g[r, c])\n  91:             if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n  92:                 continue\n  93:             marker_col = int(v)\n  94: \n  95:         if int(marker_col) not in anchors_by_color:\n  96:             continue\n  97: \n  98:         mp = marker_pixel(coords, int(marker_col))\n  99:         if mp is None:\n 100:             continue\n 101: \n 102:         ar, ac = anchors_by_color[int(marker_col)]\n 103: \n 104:         # --- STEP 4) Compute translation (dr,dc). ---\n 105:         on_top_bottom = int(ar) in (0, int(H - 1))\n 106:         on_left_right = int(ac) in (0, int(W - 1))\n 107:         horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n 108: \n 109:         dr = 0\n 110:         dc = 0\n 111:         if horizontal:\n 112:             dc = int(ac - mp[1])\n 113:         else:\n 114:             dr = int(ar - mp[0])\n 115: \n 116:         moves.append((coords, int(dr), int(dc)))\n 117: \n 118:     out = g.copy()\n 119: \n 120:     # --- STEP 5) Apply all moves. ---\n 121:     # Clear moved components first (prevents collisions with their original locations).\n 122:     for coords, _dr, _dc in moves:\n 123:         out[coords[:, 0], coords[:, 1]] = int(bg)\n 124: \n 125:     # Paste moved components:\n 126:     # - clip out-of-bounds pixels\n 127:     # - do not overwrite existing non-bg pixels\n 128:     for coords, dr, dc in moves:\n 129:         for r, c in coords:\n 130:             rr = int(r) + int(dr)\n 131:             cc = int(c) + int(dc)\n 132:             if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n 133:                 out[rr, cc] = int(g[int(r), int(c)])\n 134: \n 135:     return out\n 136: \n 137: # --------------- generator (o5x) ---------------\n 138: \n 139: # CFG: palette and canvas bounds.\n 140: _COLORS = tuple(range(10))\n 141: _BG_COLOR_RANGE = (1, 8)\n 142: _GRID_HEIGHT_RANGE = (10, 22)\n 143: _GRID_WIDTH_RANGE = (8, 22)\n 144: \n 145: # CFG: placement isolation and anchor location.\n 146: _NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n 147: _INNER_BORDER_GAP = 1\n 148: _ANCHOR_EDGE_MARGIN = 2\n 149: _ISOLATION_RADIUS = 1\n 150: \n 151: # CFG: anchor, sprite, and retry counts.\n 152: _ANCHOR_COUNT_RANGE = (1, 3)\n 153: _SPRITE_COUNT_RANGE = (3, 5)\n 154: _BODY_AREA_RANGE = (4, 13)\n 155: _GEN_RETRY_LIMIT = 300\n 156: \n 157: # CFG: body geometry and shape mix.\n 158: _BODY_HEIGHT_RANGE = (2, 5)\n 159: _BODY_WIDTH_RANGE = (3, 7)\n 160: _FRAME_HEIGHT_RANGE = (3, 5)\n 161: _FRAME_WIDTH_RANGE = (3, 7)\n 162: _FRAME_MIN_AREA = 8\n 163: _FRAME_MAX_GAP = 3\n 164: _FRAME_BODY_THRESHOLD = 0.28\n 165: _WIDE_BODY_THRESHOLD = 0.55\n 166: _SYMMETRIC_BODY_THRESHOLD = 0.82\n 167: _SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n 168: _SYMMETRIC_TRANSPOSE_PROB = 0.45\n 169: _MARKER_INTERIOR_PROB = 0.65\n 170: _FLIP_PROB = 0.5\n 171: \n 172: # CFG: optional singleton distractors.\n 173: _DISTRACTOR_PROB = 0.15\n 174: _DISTRACTOR_COUNT_RANGE = (1, 4)\n 175: \n 176: _GROW_BODY_SEEDS = [\n 177:     {(0, 0), (0, 1), (0, 2), (1, 0)},\n 178:     {(0, 0), (0, 1), (0, 2), (1, 2)},\n 179:     {(0, 0), (1, 0), (1, 1), (1, 2)},\n 180:     {(0, 2), (1, 0), (1, 1), (1, 2)},\n 181:     {(0, 1), (1, 0), (1, 1), (1, 2)},\n 182: ]\n 183: \n 184: \n 185: def _norm(cells):\n 186:     r0 = min(r for r, _c in cells)\n 187:     c0 = min(c for _r, c in cells)\n 188:     return {(r - r0, c - c0) for r, c in cells}\n 189: \n 190: \n 191: def _bbox(cells):\n 192:     return (\n 193:         min(r for r, _c in cells),\n 194:         min(c for _r, c in cells),\n 195:         max(r for r, _c in cells),\n 196:         max(c for _r, c in cells),\n 197:     )\n 198: \n 199: \n 200: def _flip(cells):\n 201:     cells = set(cells)\n 202:     if random.random() < _FLIP_PROB:\n 203:         mc = max(c for _r, c in cells)\n 204:         cells = {(r, mc - c) for r, c in cells}\n 205:     if random.random() < _FLIP_PROB:\n 206:         mr = max(r for r, _c in cells)\n 207:         cells = {(mr - r, c) for r, c in cells}\n 208:     return _norm(cells)\n 209: \n 210: \n 211: def _inclusive_range(bounds):\n 212:     return range(int(bounds[0]), int(bounds[1]) + 1)\n 213: \n 214: \n 215: def _frontier_cells(cells, height, width):\n 216:     \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n 217:     frontier = []\n 218:     for r, c in cells:\n 219:         for dr, dc in _NEIGHBORS4:\n 220:             rr, cc = r + dr, c + dc\n 221:             if 0 <= rr < height and 0 <= cc < width and (rr, cc) not in cells:\n 222:                 frontier.append((rr, cc))\n 223:     return frontier\n 224: \n 225: \n 226: def _grow_body(area)