 _SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n 307: _SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n 308: _TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n 309: \n 310: # Palette\n 311: _PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n 312: \n 313: # Sprite geometry\n 314: _SPRITE_H_MAX = 7\n 315: _SPRITE_W_MAX = 6\n 316: _SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n 317: _SPRITE_CELL_MAX = 16\n 318: _FILLED_SPRITE_MAX = 3\n 319: \n 320: # Sprite mutation probabilities\n 321: _P_HORIZ_WALL = 0.3           # add horizontal internal wall\n 322: _P_VERT_WALL = 0.3            # add vertical internal wall\n 323: _P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n 324: _P_DIAMOND = 0.2              # use diamond shape for 3x3\n 325: \n 326: # Generation\n 327: _MAX_RETRIES = 300\n 328: # -- End configuration --------------------------------------------------------\n 329: \n 330: \n 331: def _get_enclosed_holes(sprite):\n 332:     \"\"\"Return list of point-arrays for bg components not touching sprite boundary.\"\"\"\n 333:     h, w = sprite.shape\n 334:     return [pts for pts in components_mask(~sprite, connectivity=4)\n 335:             if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n 336: \n 337: \n 338: def _make_diamond():\n 339:     \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n 340:     s = np.zeros((3, 3), dtype=bool)\n 341:     s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n 342:     return s\n 343: \n 344: \n 345: def _make_hollow_sprite(h, w, rng):\n 346:     \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n 347:     sprite = np.ones((h, w), dtype=bool)\n 348:     if h >= 3 and w >= 3:\n 349:         sprite[1:-1, 1:-1] = False\n 350:     # Optionally add internal horizontal wall\n 351:     if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n 352:         br = rng.randint(2, h - 2)\n 353:         n = rng.randint(1, w - 2)\n 354:         s = rng.randint(1, w - 1 - n + 1)\n 355:         sprite[br, s:s + n] = True\n 356:     # Optionally add internal vertical wall\n 357:     if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:\n 358:         bc = rng.randint(2, w - 2)\n 359:         n = rng.randint(1, h - 2)\n 360:         s = rng.randint(1, h - 1 - n + 1)\n 361:         sprite[s:s + n, bc] = True\n 362:     # Optionally remove border cells for irregularity\n 363:     if rng.random() < _P_BORDER_REMOVAL:\n 364:         bcells = [(r, c) for r in range(h) for c in range(w)\n 365:                   if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]\n 366:         rng.shuffle(bcells)\n 367:         for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:\n 368:             test = sprite.copy()\n 369:             test[cr, cc] = False\n 370:             if _get_enclosed_holes(test):\n 371:                 sprite = test\n 372:     if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:\n 373:         return None\n 374:     return sprite\n 375: \n 376: \n 377: def _choose_colors(rng, N, num_filled):\n 378:     \"\"\"Pick palette border/fill colors, distractor color, and filled-sprite keys.\"\"\"\n 379:     all_c = list(range(1, 10))\n 380:     rng.shuffle(all_c)\n 381:     border_keys = all_c[:N]\n 382:     rng.shuffle(all_c)\n 383:     fill_values = all_c[:N]\n 384:     dist_cands = [c for c in range(1, 10) if c not in border_keys]\n 385:     distractor_color = rng.choice(dist_cands)\n 386:     mapping = dict(zip(border_keys, fill_values))\n 387:     filled_keys = rng.sample(border_keys, num_filled)\n 388:     return border_keys, fill_values, distractor_color, mapping, filled_keys\n 389: \n 390: \n 391: def _build_palette(side, border_keys, fill_values):\n 392:     \"\"\"Construct the 2xN or Nx2 palette array for the given edge side.\"\"\"\n 393:     N = len(border_keys)\n 394:     if side in ('top', 'bottom'):\n 395:         pal = np.zeros((2, N), dtype=int)\n 396:         outer, inner = (0, 1) if side == 'top' else (1, 0)\n 397:         pal[outer] = border_keys\n 398:         pal[inner] = fill_values\n 399:     else:\n 400:         pal = np.zeros((N, 2), dtype=int)\n 401:         outer, inner = (0, 1) if side == 'left' else (1, 0)\n 402:         pal[:, outer] = border_keys\n 403:         pal[:, inner] = fill_values\n 404:     return pal\n 405: \n 406: \n 407: def _place_palette(grid, occ, pal, side, rng):\n 408:     \"\"\"Place palette on the chosen edge and mark its occupancy (with 1-cell padding).\"\"\"\n 409:     H, W = grid.shape\n 410:     pal_h, pal_w = pal.shape\n 411:     if side == 'top':\n 412:         pr0, pc0 = 0, rng.randint(0, W - pal_w)\n 413:     elif side == 'bottom':\n 414:         pr0, pc0 = H - pal_h, rng.randint(0, W - pal_w)\n 415:     elif side == 'left':\n 416:         pr0, pc0 = rng.randint(0, H - pal_h), 0\n 417:     else:\n 418:         pr0, pc0 = rng.randint(0, H - pal_h), W - pal_w\n 419:     grid[pr0:pr0 + pal_h, pc0:pc0 + pal_w] = pal\n 420:     occ[max(0, pr0 - 1):min(H, pr0 + pal_h + 1),\n 421:         max(0, pc0 - 1):min(W, pc0 + pal_w + 1)] = True\n 422: \n 423: \n 424: def _find_valid_positions(H, W, occ, mask, holes):\n 425:     \"\"\"Find all (r0, c0) where mask fits without overlap and holes don't touch grid boundary.\"\"\"\n 426:     sh, sw = mask.shape\n 427:     positions = []\n 428:     for r0 in range(H - sh + 1):\n 429:         for c0 in range(W - sw + 1):\n 430:             if occ[max(0, r0 - 1):min(H, r0 + sh + 1),\n 431:                    max(0, c0 - 1):min(W, c0 + sw + 1)].any():\n 432:                 continue\n 433:             if any(r0 + hr == 0 or c0 + hc == 0 or r0 + hr == H - 1 or c0 + hc == W - 1\n 434:                    for hpts in holes for hr, hc in hpts):\n 435:                 continue\n 436:             positions.append((r0, c0))\n 437:     return positions\n 438: \n 439: \n 440: def _paint_sprite(grid, r0, c0, mask, color, fill, holes):\n 441:     \"\"\"Render a sprite onto the grid: border cells in color, hole cells in fill (if given).\"\"\"\n 442:     grid[r0:r0 + mask.shape[0], c0:c0 + mask.shape[1]][mask] = color\n 443:     if fill is not None:\n 444:         for hpts in holes:\n 445:             for hr, hc in hpts:\n 446:                 grid[r0 + hr, c0 + hc] = fill\n 447: \n 448: \n 449: def _gen_attempt():\n 450:     rng = random.Random()\n 451:     bg = 0\n 452: \n 453:     # Grid size and palette side\n 454:     H = rng.randint(_GRID_H_MIN, _GRID_H_MAX)\n 455:     W = rng.randint(_GRID_W_MIN, _GRID_W_MAX)\n 456:     side = rng.choice(['top', 'bottom', 'left', 'right'])\n 457:     if H <= _SMALL_H_THRESHOLD and side in ('top', 'bottom') and rng.random() < _SMALL_H_PALETTE_FLIP:\n 458:         side = rng.choice(['left', 'right'])\n 459: \n 460:     max_N = H if side in ('left', 'right') else W\n 461:     N = rng.randint(_PALETTE_N_MIN, min(_PALETTE_N_MAX, max_N))\n 462: \n 463:     # Sprite dimension bounds\n 464:     max_sh = min(_SPRITE_H_MAX, H)\n 465:     max_sw = min(_SPRITE_W_MAX, W)\n 466:     if H <= _TINY_H_THRESHOLD:\n 467:         max_sh = 3\n 468: \n 469:     # Sprite counts\n 470:     num_filled = rng.randint(1, min(_FILLED_SPRITE_MAX, N))\n 471:     total_sprites = num_filled + 1\n 472: \n 473:     # Generate sprite shapes\n 474:     shapes = []\n 475:     for _ in range(total_sprites):\n 476:         sh = rng.randint(3, max_sh)\n 477:         sw = rng.randint(3, max_sw)\n 478:         if sh + sw > _SPRITE_DIM_SUM_CAP:\n 479:             sw = max(3, _SPRITE_DIM_SUM_CAP - sh)\n 480:         if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:\n 481:             mask = _make_diamond()\n 482:         else:\n 483:             mask = _make_hollow_sprite(sh, sw, rng)\n 484:         if mask is None:\n 485:             return None\n 486:         shapes.append(mask)\n 487: \n 488:     # Colors and palette\n 489:     border_keys, fill_values, distractor_color, mapping, filled_keys = \\\n 490:         _choose_colors(rng, N, num_filled)\n 491:     pal = _build_palette(side, border_keys, fill_values)\n 492: \n 493:     grid = np.full((H, W), bg, dtype=int)\n--- def generate_input ---\n 544: def generate_input():\n 545:     for _ in range(_MAX_RETRIES):\n 546:         r = _gen_attempt()\n 547:         if r is not None:\n 548:             return r\n 549:     raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n\n==================== /home/lixinyu/snap/new/ARC_code/train/df9fd884.py ====================\n--- def main ---\n  32: def main(grid: np.ndarray) -> np.ndarray:\n  33:     \"\"\"Move the colored object from the lower bracket lane to the upper bracket lane and drop it to the bottom edge.\n  34: \n  35:     Input structure\n  36:     - The background is the dominant color.\n  37:     - One frame color forms exactly two 4-connected bracket objects: a top-edge bracket open downward and a bottom-edge bracket open upward.\n  38:     - One other 4-connected foreground object sits in the lower bracket's interior column span.\n  39: \n  40:     Rule\n  41:     - Remove the movable object from its original cells.\n  42:     - Keep its shape and color unchanged.\n  43:     - Paste it with its bbox columns aligned to the top bracket's interior columns and with its bbox bottom aligned to the grid bottom.\n  44: \n  45:     Key insight\n  46:     - The lower bracket identifies the object's source lane; the upper bracket provides the target lane, and the final vertical placement is bottom-aligned.\n  47:     \"\"\"\n  48:     g = np.asarray(grid, dtype=int)\n  49:     height, width = g.shape\n  50:     bg = get_bg(g)\n  51: \n  52:     components_by_color = {}\n  53:     bracket_candidates = []\n  54:     for color in colors_present(g, exclude={bg}):\n  55:         components = find_components(\n  56:             g,\n  57:             bg=bg,\n  58:             colors=[color],\n  59:             connectivity=4,\n  60:             monochromatic=True,\n  61:         )\n  62:         components_by_color[color] = components\n  63:         top = [component for component in components if _is_top_bracket(component)]\n  64:         bottom = [\n  65:             component for component in components\n  66:             if _is_bottom_bracket(component, height)\n  67:         ]\n  68:         if len(components) == 2 and len(top) == 1 and len(bottom) == 1:\n  69:             bracket_candidates.append((color, top[0], bottom[0]))\n  70: \n  71:     assert len(bracket_candidates) == 1\n  72:     frame_color, top_bracket, bottom_bracket = bracket_candidates[0]\n  73: \n  74:     movers = [\n  75:         component\n  76:         for color, components in components_by_color.items()\n  77:         if color != frame_color\n  78:         for component in components\n  79:     ]\n  80:     assert len(movers) == 1\n  81:     mover = movers[0]\n  82: \n  83:     _, mc0, _, mc1 = mover[\"bbox\"]\n  84:     _br0, bc0, _br1, bc1 = bottom_bracket[\"bbox\"]\n  85:     _tr0, tc0, _tr1, tc1 = top_bracket[\"bbox\"]\n  86:     assert (mc0, mc1) == (bc0 + 1, bc1 - 1)\n  87:     assert bbox_w(mover[\"bbox\"]) == tc1 - tc0 - 1\n  88: \n  89:     patch = crop_bbox(g, mover[\"bbox\"])\n  90:     dest_r = height - patch.shape[0]\n  91:     dest_c = tc0 + 1\n  92:     assert dest_r >= 0\n  93:     assert dest_c >= 0 and dest_c + patch.shape[1] <= width\n  94: \n  95:     out = g.copy()\n  96:     mover_coords = mover[\"coords\"]\n  97:     out[mover_coords[:, 0], mover_coords[:, 1]] = bg\n  98: \n  99:     colored_patch = patch != bg\n 100:     target = out[dest_r:dest_r + patch.shape[0], dest_c:dest_c + patch.shape[1]]\n 101:     assert np.all(target[colored_patch] == bg)\n 102: \n 103:     paste(out, patch, dest_r, dest_c, transparent=bg)\n 104:     return out\n 105: \n 106: # --------------- generator (o5x) ---------------\n 107: \n 108: # Fixed task colors.\n 109: BG_COLOR, BRACKET_COLOR = 7, 4\n 110: MOVER_COLORS = [0, 1, 2, 3, 5, 6, 8, 9]\n 111: # Canvas, bracket, and mover-size bounds.\n 112: GRID_SIZE_RANGE = (8, 9)\n 113: BRACKET_WIDTH_RANGE = (3, 4)\n 114: MOVER_HEIGHT_RANGE = (1, 3)\n 115: MOVER_MAX_CELLS = 4\n 116: MOVER_MIN_DENSITY_NUM = 2\n 117: MOVER_MIN_DENSITY_DEN = 3\n 118: # Layout choices and retry budget.\n 119: TOP_LEFT_OPTIONS = [True, False]\n 120: MAX_GENERATION_ATTEMPTS = 300\n 121: \n 122: def _gen_half_starts(grid_width, bracket_width, left_side):\n 123:     if left_side:\n 124:         return list(range(0, grid_width // 2 - bracket_width + 1))\n 125:     return list(range((grid_width + 1) // 2, grid_width - bracket_width + 1))\n 126: \n 127: def _gen_bracket_columns(grid_width, bracket_width):\n 128:     \"\"\"Choose non-overlapping top/bottom bracket starts on opposite halves.\"\"\"\n 129:     top_left = random.choice(TOP_LEFT_OPTIONS)\n 130:     top_starts = _gen_half_starts(grid_width, bracket_width, top_left)\n 131:     bottom_starts = _gen_half_starts(grid_width, bracket_width, not top_left)\n 132:     if not top_starts or not bottom_starts:\n 133:         return None\n 134:     return random.choice(top_starts), random.choice(bottom_starts)\n 135: \n 136: def _gen_add_bracket(grid, c0, width, top_edge):\n 137:     edge_row, arm_row = (0, 1) if top_edge else (-1, -2)\n 138:     grid[edge_row, c0:c0 + width] = BRACKET_COLOR\n 139:     grid[arm_row, c0] = BRACKET_COLOR\n 140:     grid[arm_row, c0 + width - 1] = BRACKET_COLOR\n 141: \n 142: def _gen_sprite_masks(height, width):\n 143:     area = height * width\n 144:     min_cells = (MOVER_MIN_DENSITY_NUM * area + MOVER_MIN_DENSITY_DEN - 1) // MOVER_MIN_DENSITY_DEN\n 145:     max_cells = min(MOVER_MAX_CELLS, area)\n 146:     masks = []\n 147:     for cell_count in range(min_cells, max_cells + 1):\n 148:         for cells in itertools.combinations(range(area), cell_count):\n 149:             mask = np.zeros((height, width), dtype=bool)\n 150:             mask[np.unravel_index(cells, (height, width))] = True\n 151:             if not mask.any(axis=0).all() or not mask.any(axis=1).all():\n 152:                 continue\n 153:             if is_contiguous(mask.astype(int), background=0, connectivity=4):\n 154:                 masks.append(mask)\n 155:     return masks\n 156: \n 157: def _gen_mover_sprite(height, width, color, bg):\n 158:     masks = _gen_sprite_masks(height, width)\n 159:     if not masks:\n 160:         return None\n 161:     mask = random.choice(masks)\n 162:     sprite = np.full((height, width), bg, dtype=int)\n 163:     sprite[mask] = color\n 164:     return sprite\n 165: \n 166: def _gen_paste_if_clear(grid, sprite, row, col, sprite_mask):\n 167:     \"\"\"Paste sprite only when every colored sprite cell lands on background.\"\"\"\n 168:     target = grid[row:row + sprite.shape[0], col:col + sprite.shape[1]]\n 169:     if not np.all(target[sprite_mask] == BG_COLOR):\n 170:         return False\n 171:     paste(grid, sprite, row, col, transparent=BG_COLOR)\n 172:     return True\n 173: \n 174: def _gen_attempt():\n 175:     height = random.randint(*GRID_SIZE_RANGE)\n 176:     grid_width = random.randint(*GRID_SIZE_RANGE)\n 177:     bracket_width = random.randint(*BRACKET_WIDTH_RANGE)\n 178:     interior_width = bracket_width - 2\n 179: \n 180:     bracket_columns = _gen_bracket_columns(grid_width, bracket_width)\n 181:     if bracket_columns is None:\n 182:         return None\n 183:     top_c0, bottom_c0 = bracket_columns\n 184: \n 185:     mover_height = random.randint(*MOVER_HEIGHT_RANGE)\n 186:     mover_color = random.choice(MOVER_COLORS)\n 187:     sprite = _gen_mover_sprite(mover_height, interior_width, mover_color, BG_COLOR)\n 188:     if sprite is None:\n 189:         return None\n 190: \n 191:     out = np.full((height, grid_width), BG_COLOR, dtype=int)\n 192:     _gen_add_bracket(out, top_c0, bracket_width, top_edge=True)\n 193:     _gen_add_bracket(out, bottom_c0, bracket_width, top_edge=False)\n 194: \n 195:     dest_r = height - mover_height\n 196:     dest_c = top_c0 + 1\n 197:     sprite_mask = sprite != BG_COLOR\n 198:     if not _gen_paste_if_clear(out, sprite, dest_r, dest_c, sprite_mask):\n 199:         return None\n 200: \n 201:     inp = out.copy()\n 202:     target = inp[dest_r:dest_r + mover_height, dest_c:dest_c + interior_width]\n 203:     target[sprite_mask] = BG_COLOR\n 204: \n 205:     source_c = bottom_c0 + 1\n 206:     max_source_r = height - 2 - mover_height\n 207:     if max_source_r < 1:\n 208:         return None\n 209:     source_r = random.randint(1, max_source_r)\n 210:     if not _gen_paste_if_clear(inp, sprite, source_r, source_c, sprite_mask):\n 211:         return None\n 212: \n 213:     if np.array_equal(main(inp), out):\n 214:         return inp\n 215:     return None\n 216: \n 217: def generate_input():\n 218:     for _ in range(MAX_GENERATION_ATTEMPTS):\n 219:         grid = _gen_attempt()\n 220:         if grid is not None:\n 221:             return grid\n 222:     raise RuntimeError(\"failed to generate df9fd884 input\")\n--- def generate_input ---\n 217: def generate_input():\n 218:     for _ in range(MAX_GENERATION_ATTEMPTS):\n 219:         grid = _gen_attempt()\n 220:         if grid is not None:\n 221:             return grid\n 222:     raise RuntimeError(\"failed to generate df9fd884 input\")\n\n==================== /home/lixinyu/snap/new/ARC_code/eval/b9e38dc0.py ====================\n--- def main ---\n   6: def main(grid: np.ndarray) -> np.ndarray:\n   7:     \"\"\"\n   8:     Fill the region enclosed by a wall sprite and radiate color outward through its opening.\n   9: \n  10:     Input structure:\n  11:     - bg = most common color. Wall = most frequent non-bg color, forming a partial enclosure (e.g. U-shape).\n  12:     - A fill-color pixel sits inside the enclosed area. Other non-bg pixels may act as obstacles.\n  13:     Rule:\n  14:     - Flood-fill the enclosed area with the fill color, radiating outward through the wall's open end.\n  15:     - Obstacles cast \"shadows\" along the radiate direction, blocking fill behind them.\n  16: \n  17:     Key insight: The wall endpoints define the opening direction; fill radiates outward through it, and obstacles block propagation along that same axis.\n  18:     \"\"\"\n  19:     g = np.array(grid, copy=True)\n  20:     h, w = g.shape\n  21: \n  22:     vals = np.unique(g)\n  23:     bg = get_bg(g)\n  24: \n  25:     non_bg = [int(v) for v in vals if int(v) != bg]\n  26:     assert non_bg, \"expected at least one non-background color\"\n  27: \n  28:     # Wall: most frequent non-background color.\n  29:     wall = max(non_bg, key=lambda c: int((g == c).sum()))\n  30: \n  31:     wall_mask = g == wall\n  32: \n  33:     # Wall connected components (8-neigh).\n  34:     comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]\n  35:     assert comps, \"expected at least one wall connected component\"\n  36: \n  37:     def sgn(x: int) -> int:\n  38:         return (x > 0) - (x < 0)\n  39: \n  40:     other_colors = [c for c in non_bg if c != wall]\n  41:     assert other_colors, \"expected at least one non-wall color (fill color)\"\n  42: \n  43:     # Pick fill color as the non-wall color closest (Manhattan distance) to the wall pixels.\n  44:     wall_points = [p for comp in comps for p in comp]\n  45: \n  46:     def min_dist_to_wall(color: int) -> tuple[int, int]:\n  47:         pts = list(zip(*np.where(g == color)))\n  48:         pts = [(int(r), int(c)) for r, c in pts]\n  49:         best_d = 10**9\n  50:         for r, c in pts:\n  51:             for wr, wc in wall_points:\n  52:                 d = abs(r - wr) + abs(c - wc)\n  53:                 if d < best_d:\n  54:                     best_d = d\n  55:                     if best_d == 0:\n  56:                         return 0, len(pts)\n  57:         return best_d, len(pts)\n  58: \n  59:     fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))\n  60: \n  61:     fill_pos = list(zip(*np.where(g == fill)))\n  62:     fill_pos = [(int(r), int(c)) for r, c in fill_pos]\n  63:     if not fill_pos:\n  64:         return g\n  65: \n  66:     # Choose the closest wall component to the fill seed (ties: larger component).\n  67:     def comp_min_dist(comp: set[tuple[int, int]]) -> int:\n  68:         best_d = 10**9\n  69:         for r, c in fill_pos:\n  70:             for wr, wc in comp:\n  71:                 d = abs(r - wr) + abs(c - wc)\n  72:                 if d < best_d:\n  73:                     best_d = d\n  74:                     if best_d == 0:\n  75:                         return 0\n  76:         return best_d\n  77: \n  78:     wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))\n  79: \n  80:     comp_mask = np.zeros_like(wall_mask, dtype=bool)\n  81:     for r, c in wall_comp:\n  82:         comp_mask[r, c] = True\n  83: \n  84:     def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:\n  85:         out = []\n  86:         for rr, cc in neighbors8(r, c):\n  87:             if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:\n  88:                 out.append((rr, cc))\n  89:         return out\n  90: \n  91:     endpoints: list[tuple[int, int]] = []\n  92:     for r, c in wall_comp:\n  93:         if len(comp_neighbors(r, c)) == 1:\n  94:             endpoints.append((r, c))\n  95: \n  96:     assert endpoints, \"expected wall component to have endpoints (degree-1 pixels)\"\n  97: \n  98:     def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:\n  99:         n1 = comp_neighbors(*ep)[0]\n 100:         d1 = (sgn(n1[0] - ep[0]), sgn(n1[1] - ep[1]))  # inward\n 101:         d_use = d1\n 102:         is_12 = False\n 103:         n2s = [p for p in comp_neighbors(*n1) if p != ep]\n 104:         if n2s:\n 105:             n2 = n2s[0]\n 106:             d2 = (sgn(n2[0] - n1[0]), sgn(n2[1] - n1[1]))\n 107:             if (d1[0] == 0) ^ (d1[1] == 0):\n 108:                 if d2[0] != 0 and d2[1] != 0:\n 109:                     d_use = d2\n 110:                     is_12 = True\n 111:         return (-d_use[0], -d_use[1]), is_12\n 112: \n 113:     out_info = [outward_dir(ep) for ep in endpoints]\n 114:     out_dirs = [d for d, _ in out_info]\n 115:     tip_12 = [f for _, f in out_info]\n 116: \n 117:     dr_sum = sum(d[0] for d in out_dirs)\n 118:     dc_sum = sum(d[1] for d in out_dirs)\n 119:     rad = (sgn(dr_sum), sgn(dc_sum))\n 120: \n 121:     barrier = comp_mask.copy()\n 122: \n 123:     def add_ray(start: tuple[int, int], d: tuple[int, int], skip: int = 0) -> None:\n 124:         rr, cc = start\n 125:         for _ in range(skip):\n 126:             rr += d[0]\n 127:             cc += d[1]\n 128:         while True:\n 129:             rr += d[0]\n 130:             cc += d[1]\n 131:             if not (0 <= rr < h and 0 <= cc < w):\n 132:                 break\n 133:             barrier[rr, cc] = True\n 134: \n 135:     def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:\n 136:         rr, cc = start\n 137:         step = 0\n 138:         while True:\n 139:             step += 1\n 140:             if step % 2 == 1:\n 141:                 rr += d[0]; cc += d[1]\n 142:             else:\n 143:                 if rad[0] != 0:\n 144:                     rr += d[0]\n 145:                 else:\n 146:                     cc += d[1]\n 147:             if not (0 <= rr < h and 0 <= cc < w):\n 148:                 break\n 149:             barrier[rr, cc] = True\n 150: \n 151:     for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):\n 152:         if is_12:\n 153:             add_ray_12(ep, d)\n 154:         else:\n 155:             add_ray(ep, d, skip=0)\n 156: \n 157:     passable = (~barrier) & ((g == bg) | (g == fill))\n 158:     q = fill_pos[:]\n 159:     seen = np.zeros_like(passable, dtype=bool)\n 160:     for r, c in q:\n 161:         if passable[r, c]:\n 162:             seen[r, c] = True\n 163:     while q:\n 164:         r, c = q.pop()\n 165:         for rr, cc in neighbors4(r, c):\n 166:             if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:\n 167:                 seen[rr, cc] = True\n 168:                 q.append((rr, cc))\n 169: \n 170:     filled_mask = (seen & (g == bg))\n 171: \n 172:     out = g.copy()\n 173:     out[filled_mask] = fill\n 174: \n 175:     # Shadow behind obstacles (non-bg, non-fill, non-wall) along radiate direction.\n 176:     obstacles = (g != bg) & (g != fill) & (g != wall)\n 177: \n 178:     def shadow_process(coords: list[tuple[int, int]]) -> None:\n 179:         started = False\n 180:         blocked = False\n 181:         for r, c in coords:\n 182:             if filled_mask[r, c]:\n 183:                 started = True\n 184:             if started and obstacles[r, c]:\n 185:                 blocked = True\n 186:                 continue\n 187:             if blocked and filled_mask[r, c]:\n 188:                 out[r, c] = bg\n 189:                 filled_mask[r, c] = False\n 190: \n 191:     if rad != (0, 0):\n 192:         dr, dc = rad\n 193:         if dr != 0 and dc == 0:\n 194:             for c in range(w):\n 195:                 rows = range(h) if dr > 0 else range(h - 1, -1, -1)\n 196:                 shadow_process([(r, c) for r in rows])\n 197:         elif dc != 0 and dr == 0:\n 198:             for r in range(h):\n 199:                 cols = range(w) if dc > 0 else range(w - 1, -1, -1)\n 200:                 shadow_process([(r, c) for c in cols])\n 201:         else:\n 202:             # Diagonal scanlines\n 203:             if dr == dc:\n 204:                 # r - c = const\n 205:                 for k in range(-(w - 1), h):\n 206:                     coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]\n 207:                     coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))\n 208:                     shadow_process(coords)\n 209:             else:\n 210:                 # r + c = const\n 211:                 for k in range(h + w - 1):\n 212:                     coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]\n 213:                     coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))\n 214:                     shadow_process(coords)\n 215: \n 216:     return out\n 217: \n 218: # --------------- generator (o5x) ---------------\n 219: \n 220: from scipy.ndimage import distance_transform_cdt\n 221: \n 222: # -- Configuration constants --------------------------------------------------\n 223: # Canvas size bounds\n 224: GRID_H_VERT = (11, 18)       # height range when radiate_dir is vertical\n 225: GRID_H_HORIZ = (8, 18)       # height range when radiate_dir is horizontal\n--- def generate_input ---\n 532: def generate_input() -> np.ndarray:\n 533:     for _ in range(GEN_RETRIES):\n 534:         grid = _gen_attempt()\n 535:         if grid is not None:\n 536:             return grid\n 537:     raise RuntimeError(\"failed to generate valid b9e38dc0 input\")\n","exit_code":0,"status":"completed"}}
