{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/963c33f8.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, components_mask, find_components, get_bg\nimport random\n\n\ndef _unique_largest_count_color(g: np.ndarray, colors: list[int]) -> int:\n    counts = [(int(np.sum(g == color)), int(color)) for color in colors]\n    max_count = max(count for count, _color in counts)\n    winners = [color for count, color in counts if count == max_count]\n    assert len(winners) == 1, \"expected one most numerous non-background obstacle color\"\n    return winners[0]\n\n\ndef _marker_bbox(g: np.ndarray, marker_colors: list[int]) -> tuple[int, int, int, int]:\n    mask = np.isin(g, marker_colors)\n    candidates: list[tuple[int, int, int, int]] = []\n    for coords in components_mask(mask, connectivity=8):\n        r0, c0, r1, c1 = bbox_coords(coords)\n        if r0 == 0:\n            candidates.append((r0, c0, r1, c1))\n\n    assert len(candidates) == 1, \"expected one top-edge marker component\"\n    return candidates[0]\n\n\ndef _runs(values: list[int]) -> list[tuple[int, int]]:\n    if not values:\n        return []\n\n    runs: list[tuple[int, int]] = []\n    start = prev = values[0]\n    for value in values[1:]:\n        if value == prev + 1:\n            prev = value\n            continue\n        runs.append((start, prev))\n        start = prev = value\n    runs.append((start, prev))\n    return runs\n\n\ndef _can_slide_right(base: np.ndarray, obstacle: int, bg: int, cols: list[int], marker_bottom_r: int, height: int) -> bool:\n    H, W = base.shape\n    assert cols\n    if cols[-1] + 1 >= W:\n        return False\n\n    for floor_r in range(marker_bottom_r + 1, H):\n        target_rows = np.arange(floor_r - height + 1, floor_r + 1)\n        if int(target_rows[0]) < 0:\n            continue\n\n        shifted_cols = [c + 1 for c in cols]\n        target_is_clear = all(np.all(base[target_rows, c] == bg) for c in shifted_cols)\n        if not target_is_clear:\n            continue\n\n        for c in cols:\n            if int(base[floor_r, c]) != obstacle:\n                continue\n            has_horizontal_neighbor = (\n                (c > 0 and int(base[floor_r, c - 1]) == obstacle)\n                or (c + 1 < W and int(base[floor_r, c + 1]) == obstacle)\n            )\n            if has_horizontal_neighbor:\n                return True\n\n    return False\n\n\ndef _clear_bottom_edge_gap(base: np.ndarray, out: np.ndarray, obstacle: int, bg: int, c: int, width: int) -> None:\n    H, W = base.shape\n    if int(base[H - 1, c]) != obstacle:\n        return\n\n    c1 = c\n    while c1 < W and int(base[H - 1, c1]) == obstacle:\n        c1 += 1\n\n    if c1 - c >= width:\n        out[H - 1, c + 1 : c + width] = bg\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Drop the columns of the top marker downward, stopping blue-ended columns on grey obstacles and letting maroon-ended columns pass to the bottom.\n\n    Input structure\n    - The background is the dominant color.\n    - The most numerous non-background color forms stationary grey obstacle pixels.\n    - The other two colors form a single 3x3 top-edge marker whose top two rows\n      are maroon and whose bottom row contains maroon or blue control pixels.\n\n    Rule\n    - Erase the top marker.\n    - Treat each marker column as a vertical drop retaining its three colors.\n    - A column whose bottom control pixel is blue stops immediately above the\n      first grey pixel below that column, or bottom-aligns if none exists.\n    - Contiguous maroon-ended columns pass through obstacles and bottom-align;\n      if such a run has a clear down-right slide from a grey ledge, shift the\n      run one column right before bottom-aligning.\n    - When a maroon-ended drop lands through a grey bar on the bottom edge, clear\n      the rest of the marker-width gap in that bottom bar.\n\n    Key insight\n    - The bottom row of the top marker is a control strip: blue cells mean\n      \"stick to the first obstacle,\" while maroon cells mean \"fall through.\"\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    H = g.shape[0]\n    bg = int(get_bg(g))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 3, \"expected obstacle color plus two marker colors\"\n    obstacle = _unique_largest_count_color(g, non_bg)\n    marker_colors = [color for color in non_bg if color != obstacle]\n    assert len(marker_colors) == 2, \"expected exactly two marker colors\"\n\n    r0, c0, r1, c1 = _marker_bbox(g, marker_colors)\n    marker = g[r0 : r1 + 1, c0 : c1 + 1]\n    marker_h, marker_w = marker.shape\n    assert (marker_h, marker_w) == (3, 3), \"expected a 3x3 marker\"\n    assert np.all(np.isin(marker, marker_colors)), \"marker bbox must contain only marker colors\"\n\n    pass_color = int(marker[0, 0])\n    assert np.all(marker[:2, :] == pass_color), \"top two marker rows must be the pass-through color\"\n    stop_colors = [color for color in marker_colors if color != pass_color]\n    assert len(stop_colors) == 1, \"expected one stop color\"\n    stop_color = stop_colors[0]\n\n    out = g.copy()\n    out[r0 : r1 + 1, c0 : c1 + 1] = bg\n    base = out.copy()\n\n    pass_columns: list[int] = []\n    for j in range(marker_w):\n        c = c0 + j\n        stack = marker[:, j]\n        bottom_control = int(stack[-1])\n\n        if bottom_control == stop_color:\n            obstacles_below = np.flatnonzero(base[r1 + 1 :, c] == obstacle)\n            if len(obstacles_below):\n                floor_r = int(r1 + 1 + obstacles_below[0])\n                top_r = floor_r - marker_h\n            else:\n                top_r = H - marker_h\n            assert top_r >= 0, \"stopped column must fit above its obstacle\"\n            out[top_r : top_r + marker_h, c] = stack\n        else:\n            assert bottom_control == pass_color, \"bottom control must be one of the marker colors\"\n            pass_columns.append(j)\n\n    for start_j, end_j in _runs(pass_columns):\n        source_cols = list(range(c0 + start_j, c0 + end_j + 1))\n        shift = 1 if _can_slide_right(base, obstacle, bg, source_cols, r1, marker_h) else 0\n        top_r = H - marker_h\n\n        for j in range(start_j, end_j + 1):\n            c = c0 + j + shift\n            _clear_bottom_edge_gap(base, out, obstacle, bg, c, marker_w)\n            out[top_r : top_r + marker_h, c] = marker[:, j]\n\n    return out\n\n# --------------- generator (att1) ---------------\n\nGEN_BG, GEN_OBSTACLE, GEN_PASS, GEN_STOP = 7, 5, 9, 1\nGRID_SIZE_RANGE = (14, 16)\nMARKER_SIZE = 3\nSTOP_COUNT_RANGE = (1, 3)\nOBSTACLE_COMPONENT_RANGE = (7, 9)\nOBSTACLE_PIXEL_RANGE = (20, 31)\nCOMPONENT_SIZE_RANGE = (1, 11)\nMIN_STOP_OBSTACLE_ROW = 6\nDROP_ZONE_HEIGHT = 3\nCOMPONENT_PLACEMENT_ATTEMPTS, GENERATION_ATTEMPTS = 100, 300\n\n\ndef _init_scene(H: int, W: int) -> tuple[np.ndarray, int, list[int], set[tuple[int, int]]]:\n    grid = np.full((H, W), GEN_BG, dtype=int)\n    c0 = random.randint(0, W - MARKER_SIZE)\n    num_stops = random.randint(*STOP_COUNT_RANGE)\n    positions = list(range(MARKER_SIZE))\n    random.shuffle(positions)\n    stop_positions = sorted(positions[:num_stops])\n    marker = np.full((MARKER_SIZE, MARKER_SIZE), GEN_PASS, dtype=int)\n    for j in stop_positions:\n        marker[MARKER_SIZE - 1, j] = GEN_STOP\n    grid[0:MARKER_SIZE, c0:c0 + MARKER_SIZE] = marker\n    obstacle_pixels: set[tuple[int, int]] = set()\n    for j in stop_positions:\n        col = c0 + j\n        first_obs_row = random.randint(MIN_STOP_OBSTACLE_ROW, H - 1)\n        grid[first_obs_row, col] = GEN_OBSTACLE\n        obstacle_pixels.add((first_obs_row, col))\n    return grid, c0, stop_positions, obstacle_pixels\n\n\ndef _forbidden_cells(H: int, c0: int, stop_positions: list[int], obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]]:\n    forbidden = {(r, c) for r in range(MARKER_SIZE) for c in range(c0, c0 + MARKER_SIZE)}\n    for j in stop_positions:\n        col = c0 + j\n        for r in range(MARKER_SIZE, H):\n            if (r, col) not in obstacle_pixels:\n                continue\n            for dr in range(1, DROP_ZONE_HEIGHT + 1):\n                if r - dr >= 0:\n                    forbidden.add((r - dr, col))\n            break\n    return forbidden\n\n\ndef _sample_component_sizes(total_pixels: int, component_count: int) -> list[int] | None:\n    component_sizes = []\n    left = total_pixels\n    min_size, max_size = COMPONENT_SIZE_RANGE\n    for i in range(component_count):\n        remaining = component_count - i - 1\n        if remaining == 0:\n            size = left\n        else:\n            lo = max(min_size, left - max_size * remaining)\n            hi = min(max_size, left - min_size * remaining)\n            if lo > hi:\n                return None\n            size = random.randint(lo, hi)\n        left -= size\n        if size < min_size or size > max_size:\n            return None\n        component_sizes.append(size)\n    random.shuffle(component_sizes)\n    return component_sizes\n\n\ndef _grow_component(grid: np.ndarray, comp_size: int, forbidden: set[tuple[int, int]],\n                    obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]] | None:\n    H, W = grid.shape\n    sr, sc = random.randint(0, H - 1), random.randint(0, W - 1)\n    if (sr, sc) in forbidden or (sr, sc) in obstacle_pixels or grid[sr, sc] != GEN_BG:\n        return None\n\n    comp = {(sr, sc)}\n    frontier = [(sr, sc)]\n    while len(comp) < comp_size and frontier:\n        random.shuffle(frontier)\n        expanded = False\n        for fr, fc in frontier:\n            nbrs = [(fr - 1, fc), (fr + 1, fc), (fr, fc - 1), (fr, fc + 1)]\n            random.shuffle(nbrs)\n            for nr, nc in nbrs:\n                if (0 <= nr < H and 0 <= nc < W\n                        and (nr, nc) not in forbidden\n                        and (nr, nc) not in obstacle_pixels\n                        and (nr, nc) not in comp\n                        and grid[nr, nc] == GEN_BG):\n                    comp.add((nr, nc))\n                    frontier.append((nr, nc))\n                    expanded = True\n                    break\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/c4d067a0.py\"","aggregated_output":"import numpy as np\nfrom functools import reduce\nfrom math import gcd\n\nfrom arc_utils import bbox_coords, components_mask, get_bg\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete a grid of colored blocks to match a minimap legend in the top-left corner.\n\n    Input structure:\n    - bg = most common color.\n    - Top-left corner: a small sprite of single colored pixels forming a minimap pattern on a regular lattice.\n    - Main area: uniformly colored square blocks (NxN) arranged on a regular grid; some positions are empty (bg).\n\n    Rule:\n    - The legend pixels define a color pattern; each pixel's lattice position maps to a block position in the main grid via a fixed scale factor and offset.\n    - Existing colored blocks confirm the scale/offset alignment.\n    - For every legend pixel whose corresponding grid position is empty, place a new block of that color.\n\n    Key insight: The top-left pixel pattern is a scaled-down minimap of the block layout; the mapping is inferred from blocks already present.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    out = g.copy()\n    bg = get_bg(g)\n\n    comps = components_mask(g != bg, connectivity=4)\n    singles: list[tuple[int, int, int]] = []\n    blocks: list[tuple[int, int, int, int]] = []  # (r0,c0,size,color)\n    for pts in comps:\n        if len(pts) == 1:\n            r, c = pts[0]\n            singles.append((int(r), int(c), int(g[r, c])))\n            continue\n        r0, c0, r1, c1 = bbox_coords(pts)\n        hh, ww = r1 - r0 + 1, c1 - c0 + 1\n        if hh != ww or hh < 2:\n            continue\n        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n        col = int(sub[0, 0])\n        if col == bg:\n            continue\n        if np.all(sub == col) and sub.size == len(pts):\n            blocks.append((int(r0), int(c0), int(hh), col))\n\n    assert singles and blocks, \"grid must contain legend pixels and main blocks\"\n\n    # Legend pixels: singleton colored pixels in a small top-left window.\n    win_r = min(h, 12)\n    win_c = min(w, 12)\n    legend = [(r, c, v) for (r, c, v) in singles if r < win_r and c < win_c]\n    assert legend, \"top-left legend must contain singleton pixels\"\n\n    # Infer legend lattice step (usually 2).\n    rs = sorted({r for r, _, _ in legend})\n    cs = sorted({c for _, c, _ in legend})\n    drs = [rs[i + 1] - rs[i] for i in range(len(rs) - 1)]\n    dcs = [cs[i + 1] - cs[i] for i in range(len(cs) - 1)]\n    stepL = reduce(gcd, drs + dcs)\n    assert stepL > 0, \"legend lattice step must be positive\"\n    rmin = min(r for r, _, _ in legend)\n    cmin = min(c for _, c, _ in legend)\n\n    legend_pts: list[tuple[int, int, int]] = []\n    for r, c, v in legend:\n        rr = (r - rmin) // stepL\n        cc = (c - cmin) // stepL\n        legend_pts.append((int(rr), int(cc), int(v)))\n\n    # Determine typical block size and step between blocks.\n    sizes = [s for _, _, s, _ in blocks]\n    _vals, _cnts = np.unique(np.array(sizes, dtype=int), return_counts=True)\n    block_size = int(_vals[_cnts.argmax()])\n    blocks = [b for b in blocks if b[2] == block_size]\n    assert blocks, \"must contain at least one block of the dominant block size\"\n\n    by_color: dict[int, list[tuple[int, int]]] = {}\n    for r0, c0, s, col in blocks:\n        by_color.setdefault(int(col), []).append((int(r0), int(c0)))\n    for col in by_color:\n        by_color[col].sort()\n\n    # Compute step from block top-left positions (gcd of diffs).\n    tops = sorted({r0 for r0, _, _, _ in blocks})\n    lefts = sorted({c0 for _, c0, _, _ in blocks})\n    step_candidates = []\n    step_candidates += [tops[i + 1] - tops[i] for i in range(len(tops) - 1)]\n    step_candidates += [lefts[i + 1] - lefts[i] for i in range(len(lefts) - 1)]\n    step = reduce(gcd, step_candidates)\n    assert step > 0, \"block step must be positive\"\n\n    # Infer base offset: choose base that best maps legend pixels with existing block colors.\n    bases: dict[tuple[int, int], int] = {}\n    for rr, cc, col in legend_pts:\n        if col not in by_color:\n            continue\n        for br0, bc0 in by_color[col]:\n            base_r = br0 - rr * step\n            base_c = bc0 - cc * step\n            bases[(base_r, base_c)] = bases.get((base_r, base_c), 0) + 1\n    assert bases, \"existing blocks must determine the legend-to-grid offset\"\n    max_votes = max(bases.values())\n    best_bases = [base for base, votes in bases.items() if votes == max_votes]\n    assert len(best_bases) == 1, \"legend-to-grid offset must be unique\"\n    base = best_bases[0]\n    base_r, base_c = base\n\n    # Paint blocks for all legend pixels (usually adding missing ones).\n    for rr, cc, col in legend_pts:\n        tr0 = base_r + rr * step\n        tc0 = base_c + cc * step\n        assert 0 <= tr0 <= h - block_size and 0 <= tc0 <= w - block_size, \\\n            \"legend block projection must fit in canvas\"\n        out[tr0 : tr0 + block_size, tc0 : tc0 + block_size] = col\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# === CFG: canvas ===\nGRID_SIZE_MIN, GRID_SIZE_MAX = 23, 27  # square grid bounds\nNUM_COLORS = 10                         # total ARC color palette size\n\n# === CFG: legend lattice ===\nLEGEND_ORIGIN = (1, 1)                  # top-left pixel of the legend\nLEGEND_STEP = 2                         # pixel spacing between legend dots\nLEGEND_ROWS = (3, 4)                    # staircase row count options\nLEGEND_COLS = (2, 3)                    # staircase column count options\nLEGEND_EMPTIES = (0, 1, 2)             # how many lattice positions may be empty\nLEGEND_FILLED_MIN, LEGEND_FILLED_MAX = 6, 10\nPALETTE_SIZE_MIN, PALETTE_SIZE_MAX = 2, 4  # distinct non-bg colors in legend\nMAX_COUNT_PER_COLOR = 6                 # max legend pixels of one color\n\n# === CFG: block area ===\nBLOCK_SIZE_RANGE = range(2, 5)         # NxN block side length\nGAP_RANGE = range(1, 4)               # gap between adjacent blocks\nSTEP_MIN, STEP_MAX = 3, 5             # block_size + gap bounds\nBASE_C_MIN = 8                         # minimum block-area column (separates from legend)\nBASE_R_MIN = 1                         # minimum block-area row\n\n# === CFG: generation ===\nMAX_RETRIES = 300\n\n\ndef _enumerate_staircase_shapes():\n    \"\"\"Enumerate all valid (widths) tuples for the staircase legend shape.\"\"\"\n    shapes = []\n    for rows in LEGEND_ROWS:\n        for cols in LEGEND_COLS:\n            total = rows * cols\n            for empties in LEGEND_EMPTIES:\n                count = total - empties\n                if not (LEGEND_FILLED_MIN <= count <= LEGEND_FILLED_MAX):\n                    continue\n                def rec(prefix, remaining, r):\n                    if r == rows:\n                        if remaining == 0 and max(prefix) == cols:\n                            shapes.append(tuple(prefix))\n                        return\n                    left = rows - r - 1\n                    lo = max(1, remaining - left * cols)\n                    hi = min(cols, remaining - left)\n                    for width in range(lo, hi + 1):\n                        rec(prefix + [width], remaining - width, r + 1)\n                rec([], count, 0)\n    return shapes\n\n\n# Valid (block_size, gap) pairs satisfying STEP_MIN <= block_size+gap <= STEP_MAX\n_BLOCK_GAP_PAIRS = [\n    (n, g) for n in BLOCK_SIZE_RANGE for g in GAP_RANGE\n    if STEP_MIN <= n + g <= STEP_MAX\n]\n# All valid staircase width tuples, precomputed once\n_STAIRCASE_SHAPES = _enumerate_staircase_shapes()\n\n\ndef _pick_staircase():\n    \"\"\"Pick a random staircase shape; return (filled_pts, adjacent_pairs).\"\"\"\n    widths = random.choice(_STAIRCASE_SHAPES)\n    pts = [(r, c) for r, w in enumerate(widths) for c in range(w)]\n    pairs = [(r, c) for r, w in enumerate(widths) for c in range(w - 1)]\n    return pts, pairs\n\n\ndef _random_color_counts(total, k):\n    \"\"\"Distribute `total` among `k` bins, each in [1, MAX_COUNT_PER_COLOR].\"\"\"\n    counts = [1] * k\n    remaining = total - k\n    while remaining:\n        open_idxs = [i for i, v in enumerate(counts) if v < MAX_COUNT_PER_COLOR]\n        i = random.choice(open_idxs)\n        add = random.randint(1, min(remaining, MAX_COUNT_PER_COLOR - counts[i]))\n        counts[i] += add\n        remaining -= add\n    random.shuffle(counts)\n    return counts\n\n\ndef _assign_legend_colors(pts, anchor_pair, palette):\n    \"\"\"Assign colors to legend pts via backtracking, ensuring unique anchor-pair identification.\"\"\"\n    pos_set = set(pts)\n    first = anchor_pair\n    second = (anchor_pair[0], anchor_pair[1] + 1)\n    a, b = random.sample(palette, 2)\n    counts = dict(zip(palette, _random_color_counts(len(pts), len(palette))))\n    colors = {first: a, second: b}\n    counts[a] -= 1\n    counts[b] -= 1\n    if counts[a] < 0 or counts[b] < 0:\n        return None\n\n    anchor_colors = (a, b)\n    cells = [p for p in pts if p not in colors]\n\n    def allowed(pos, col):\n        r, c = pos\n        left = (r, c - 1)\n        if left in pos_set and left in colors:\n            if (colors[left], col) == anchor_colors and (left, pos) != (first, second):\n                return False\n        right = (r, c + 1)\n        if right in pos_set and right in colors:\n            if (col, colors[right]) == anchor_colors and (pos, right) != (first, second):\n                return False\n        return True\n\n    def search():\n        if not cells:\n            return all(v == 0 for v in counts.values())\n        best_i, best_opts = None, None\n        for i, pos in enumerate(cells):\n            opts = [col for col in palette if counts[col] > 0 and allowed(pos, col)]\n            if best_opts is None or len(opts) < len(best_opts):\n                best_i, best_opts = i, opts\n        if not best_opts:\n            return False\n        pos = cells.pop(best_i)\n        random.shuffle(best_opts)\n        for col in best_opts:\n            colors[pos] = col\n            counts[col] -= 1\n            if search():\n                return True\n            counts[col] += 1\n            del colors[pos]\n        cells.insert(best_i, pos)\n        return False\n\n    if not search():\n        return None\n    return colors\n\n\ndef _gen_attempt():\n    size = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n    block_size, gap = random.choice(_BLOCK_GAP_PAIRS)\n    step = block_size + gap\n    pts, pairs = _pick_staircase()\n","exit_code":0,"status":"completed"}}
