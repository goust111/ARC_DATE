to assign tools to frames (one-to-one\n 234:     # when counts match), falling back to distance only if no such match exists.\n 235:     comp_color_counts: list[dict[int, int]] = []\n 236:     for comp in mov_comps:\n 237:         vals = [int(x) for x in comp[\"patch\"][comp[\"mask\"]].flatten() if int(x) != 0]\n 238:         comp_color_counts.append(dict(Counter(vals)))\n 239: \n 240:     def compatible(ci: int, gi: int) -> bool:\n 241:         cav_sz = int(anchor_groups[gi][\"cavity_size\"])\n 242:         return any(int(v) == cav_sz for v in comp_color_counts[ci].values())\n 243: \n 244:     if len(mov_comps) == len(anchor_groups) and len(anchor_groups) > 1:\n 245:         import itertools\n 246: \n 247:         best_perm = None\n 248:         best_score = None\n 249:         for perm in itertools.permutations(range(len(anchor_groups))):\n 250:             ok = True\n 251:             hits = 0\n 252:             dist_sum = 0\n 253:             for ci, gi in enumerate(perm):\n 254:                 if not compatible(ci, gi):\n 255:                     ok = False\n 256:                     break\n 257:                 hits += 1\n 258:                 dist_sum += bbox_gap(mov_comps[ci][\"bbox\"], anchor_groups[gi][\"bbox\"])\n 259:             if not ok:\n 260:                 continue\n 261:             score = (int(hits), -int(dist_sum))\n 262:             if best_score is None or score > best_score:\n 263:                 best_score = score\n 264:                 best_perm = perm\n 265:         assert best_perm is not None, 'must find a compatible tool-to-frame permutation'\n 266:         group_for_comp = [int(x) for x in best_perm]\n 267:     else:\n 268:         group_for_comp = []\n 269:         for ci, comp in enumerate(mov_comps):\n 270:             best_g = None\n 271:             best_d = None\n 272:             for gi, grp in enumerate(anchor_groups):\n 273:                 if not compatible(ci, gi):\n 274:                     continue\n 275:              