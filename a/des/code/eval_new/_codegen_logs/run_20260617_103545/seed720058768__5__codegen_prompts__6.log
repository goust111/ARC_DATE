n-background colors in each corner region.\n  47:     - The completed region multiset is defined by the maximum observed count of\n  48:       each color across the four regions.\n  49:     - Replace each region's blank pixel with the single color needed to match that\n  50:       completed multiset.\n  51: \n  52:     Key insight:\n  53:     - The separator color inside a corner region is a missing value marker; comparing\n  54:       the four regions reveals the shared multiset without using numeric color order.\n  55:     \"\"\"\n  56:     g = np.asarray(grid, dtype=int)\n  57:     assert g.ndim == 2, \"expected a 2D grid\"\n  58:     height, width = map(int, g.shape)\n  59: \n  60:     bg = get_bg(g)\n  61:     color_counts = Counter(map(int, g.reshape(-1)))\n  62:     assert all(\n  63:         color == bg or count < color_counts[bg] for color, count in color_counts.items()\n  64:     ), \"background color must be uniquely dominant\"\n  65: \n  66:     cross_row, cross_col = _solid_separator_cross(g, bg)\n  67:     regions = _quadrants(cross_row, cross_col, height, width)\n  68:     region_shape = g[regions[0]].shape\n  69:     region_area = int(np.prod(region_shape))\n  70: \n  71:     counts_by_region: list[Counter[int]] = []\n  72:     blank_positions: list[tuple[int, int]] = []\n  73:     for row_slice, col_slice in regions:\n  74:         region = g[row_slice, col_slice]\n  75:         assert region.shape == region_shape, \"all corner regions must have the same shape\"\n  76:         blanks = np.argwhere(region == bg)\n  77:         assert len(blanks) == 1, \"each corner region must have exactly one blank\"\n  78: \n  79:         counts_by_region.append(Counter(map(int, region[region != bg].reshape(-1))))\n  80:         local_r, local_c = map(int, blanks[0])\n  81:         blank_positions.append((row_slice.start + local_r, col_slice.start + local_c))\n  82: \n  83:     target_counts: Counter[int] = Counter()\n  84:     for counts in counts_by_region:\n  85:         for color, count in counts.items():\n  86:             target_counts[color] = max(target_counts[color], count)\n  87:     assert sum(target_counts.values()) == region_area, \"completed region multiset must be unique\"\n  88: \n  89:     out = g.copy()\n  90:     for counts, (row, col) in zip(counts_by_region, blank_positions):\n  91:         missing = target_counts - counts\n  92:         assert len(missing) == 1, \"each blank must have exactly one matching fill color\"\n  93:         fill_color, fill_count = next(iter(missing.items()))\n  94:         assert fill_count == 1, \"each corner region must need one pixel of the fill color\"\n  95:         out[row, col] = fill_color\n  96: \n  97:     return out\n--- generate_input 213-218 ---\n 213: def generate_input() -> np.ndarray:\n 214:     for _ in range(MAX_GENERATION_ATTEMPTS):\n 215:         grid = _gen_attempt()\n 216:         if grid is not None:\n 217:             return grid\n 218:     raise RuntimeError(\"failed to generate a valid e3fe1151 input\")\n\n","exit_code":0,"status":"completed"}}
