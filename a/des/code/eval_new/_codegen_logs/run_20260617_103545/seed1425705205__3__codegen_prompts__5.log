/snap/new/ARC_code/eval/21897d95.py:453:    \"\"\"Return (n_markers, n_normal, n_colored) or None if infeasible.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:473:    \"\"\"Find all valid (center, stem) for placing a T marker from src toward dst.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:514:    \"\"\"Update occupied_cells and occupied_neighbors after placing a marker.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:538:    \"\"\"Map region ids to colors via vectorized lookup.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:544:    \"\"\"Write T-marker cells onto the input grid.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:556:    \"\"\"Fill marker cells in the output grid with the source region's final color.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:566:    \"\"\"Attempt to place a 5-cell L9 marker; return orientation string or None.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/21897d95.py:700:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:208:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:209:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:224:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:324:    \"\"\"Check that mask is a single 4-connected simple closed curve with exactly one hole.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:342:    \"\"\"Interleave n_a copies of step_a with n_b copies of step_b, biased toward alternation.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:366:    \"\"\"Extend path with a straight line from its last point to end.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:378:    \"\"\"Extend path by applying a sequence of (dr, dc) deltas.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:387:    \"\"\"Fraction of direction changes along a cyclic path.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:397:    \"\"\"Generate a wobbly simple closed curve mask of size (h, w).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:445:    \"\"\"Generate a small filled blob mask (size 4-11, bbox 2x2 to 4x4).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:472:    \"\"\"Arrange children in a random layout (vertical, horizontal, or diagonal).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:514:    \"\"\"Recursively build masks and place children within frames.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:544:    \"\"\"Flatten tree into list, computing absolute positions.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:555:    \"\"\"Position an outside blob adjacent to the root frame.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:572:    \"\"\"Convert a generator _Obj (with absolute pos) to a solver _Node.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:588:    \"\"\"Compute expected solver output for the generated tree.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:607:    \"\"\"Build a random containment tree (1-2 frames, 1-4 blobs, optional outside blob).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:627:    \"\"\"Render all objects onto a padded grid. Returns None if size constraints fail.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:665:    \"\"\"Single generation attempt: build tree, render input, verify against solver.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/2d0172a1.py:693:def generate_input():\n/home/lixinyu/snap/new/ARC_code/eval/faa9f03d.py:35:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/faa9f03d.py:36:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/faa9f03d.py:52:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/faa9f03d.py:422:    \"\"\"Build waypoint list for a random polyline with axis ax (0=vert-primary, 1=horiz-primary).\n/home/lixinyu/snap/new/ARC_code/eval/faa9f03d.py:456:    \"\"\"Build L-shaped arm waypoints for _path_crossing_all / _path_through.\n/home/lixinyu/snap/new/ARC_code/eval/faa9f03d.py:891:def generate_input() -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:7:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:16:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:101:def main(grid: np.ndarray) -> np.ndarray:\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:102:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:115:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:169:\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:205:    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:214:    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:228:    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:240:    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:265:    \"\"\"Cells 4-adjacent to blob but not in blob.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:275:    \"\"\"Return blob with interior holes absorbed.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:279:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:330:    \"\"\"Simulate solver's slide: keep moving (dr, dc) until hitting a wall or blocker.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:346:    \"\"\"Place 1-2 legend patches at grid corners.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:349:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:380:    \"\"\"Grow irregular closed regions, one per assigned wall color.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:383:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:440:    \"\"\"Attempt up to BLOB_GROW_RETRIES random seeds to grow a valid blob.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:468:    \"\"\"Check that every enclosed bg component matches exactly one region interior.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:485:    \"\"\"Choose yellow output positions and reverse-slide to derive input positions.\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:489:    \"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:533:    \"\"\"Walk backwards from out_pos to find a valid input position 1..MAX_SLIDE_STEPS away.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:556:    \"\"\"Run the solver on input_grid and verify correctness.\"\"\"\n/home/lixinyu/snap/new/ARC_code/eval/88e364bc.py:604:def generate_input() -> np.ndarray:\n","exit_code":0,"status":"completed"}}
