{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py\"","aggregated_output":"from __future__ import annotations\n\nimport math\n\nimport numpy as np\n\nfrom arc_utils import bbox, colors_present, crop_bbox, get_bg, label_mask\nimport random\n\n\ndef _count_enclosed_regions(walls: np.ndarray) -> int:\n    labels, n_labels = label_mask(~walls, connectivity=4)\n    h, w = walls.shape\n    count = 0\n    for k in range(1, n_labels + 1):\n        coords = np.argwhere(labels == k)\n        assert coords.size > 0\n        touches_edge = (\n            np.any(coords[:, 0] == 0)\n            or np.any(coords[:, 0] == h - 1)\n            or np.any(coords[:, 1] == 0)\n            or np.any(coords[:, 1] == w - 1)\n        )\n        if not touches_edge:\n            count += 1\n    return int(count)\n\n\ndef _reconstruct_walls(mask: np.ndarray) -> np.ndarray:\n    h, _w = mask.shape\n    col_counts = mask.sum(axis=0)\n    v_threshold = max(3, math.ceil(0.45 * h))\n    vcols = [int(c) for c, n in enumerate(col_counts) if int(n) >= v_threshold]\n    if len(vcols) < 2:\n        return mask.copy()\n\n    row_counts = mask.sum(axis=1)\n    h_threshold = max(3, len(vcols) + 1)\n    hrows = [int(r) for r, n in enumerate(row_counts) if int(n) >= h_threshold]\n    assert len(hrows) >= 2\n\n    walls = np.zeros_like(mask, dtype=bool)\n\n    for r in hrows:\n        for c0, c1 in zip(vcols, vcols[1:]):\n            segment = mask[r, c0 : c1 + 1]\n            length = int(c1 - c0 + 1)\n            hits = int(segment.sum())\n            dense = hits >= max(2, math.ceil(0.45 * length))\n            interior_evidence = length > 2 and hits >= 2 and bool(segment[1:-1].any())\n            if dense or interior_evidence:\n                walls[r, c0 : c1 + 1] = True\n\n    for c in vcols:\n        for r0, r1 in zip(hrows, hrows[1:]):\n            segment = mask[r0 : r1 + 1, c]\n            length = int(r1 - r0 + 1)\n            hits = int(segment.sum())\n            if hits >= max(2, math.ceil(0.45 * length)):\n                walls[r0 : r1 + 1, c] = True\n\n    return walls\n\n\ndef _room_count_for_color(g: np.ndarray, color: int) -> int:\n    b = bbox(g == int(color))\n    assert b is not None\n    mask = crop_bbox(g == int(color), b).astype(bool)\n    walls = _reconstruct_walls(mask)\n    return _count_enclosed_regions(walls)\n\n\ndef _walls_for_color(g: np.ndarray, color: int) -> np.ndarray:\n    b = bbox(g == int(color))\n    assert b is not None\n    r0, c0, r1, c1 = b\n    mask = crop_bbox(g == int(color), b).astype(bool)\n    walls = _reconstruct_walls(mask)\n    out = np.zeros_like(g, dtype=bool)\n    out[r0 : r1 + 1, c0 : c1 + 1] = walls\n    return out\n\n\ndef _cover_order(g: np.ndarray, group: list[tuple[int, int, np.ndarray]]) -> list[tuple[int, int, np.ndarray]]:\n    if len(group) == 1:\n        return group\n\n    by_color = {int(item[0]): item for item in group}\n    above: dict[int, set[int]] = {color: set() for color, _rooms, _walls in group}\n    indegree: dict[int, int] = {color: 0 for color, _rooms, _walls in group}\n\n    for i, (ca, _ra, wa) in enumerate(group):\n        for cb, _rb, wb in group[i + 1 :]:\n            overlap = wa & wb\n            if not bool(overlap.any()):\n                continue\n            visible = set(int(v) for v in np.unique(g[overlap]))\n            top_colors = visible & {int(ca), int(cb)}\n            assert len(top_colors) == 1\n            top = top_colors.pop()\n            under = int(cb) if top == int(ca) else int(ca)\n            if top not in above[under]:\n                above[under].add(top)\n                indegree[top] += 1\n\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    remaining = set(by_color)\n    while remaining:\n        ready = [color for color in remaining if indegree[color] == 0]\n        assert len(ready) == 1\n        color = ready[0]\n        remaining.remove(color)\n        ordered.append(by_color[color])\n        for nxt in above[color]:\n            indegree[nxt] -= 1\n    return ordered\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert each colored partitioned frame into a horizontal bar whose length is its number of enclosed regions.\n\n    Input structure:\n    - Black background with several axis-aligned colored line drawings.\n    - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.\n    - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.\n\n    Rule:\n    - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.\n    - Count the 4-connected background regions fully enclosed by those reconstructed walls.\n    - The color with no enclosed region is the noise/pad color.\n    - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.\n\n    Key insight:\n    - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg == 0\n\n    counts: list[tuple[int, int, np.ndarray]] = []\n    for color in colors_present(g, exclude={bg}):\n        rooms = _room_count_for_color(g, int(color))\n        walls = _walls_for_color(g, int(color))\n        counts.append((int(color), int(rooms), walls))\n\n    drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]\n    pad_colors = [color for color, rooms, _walls in counts if rooms == 0]\n    assert drawings\n    assert len(pad_colors) == 1\n\n    pad = int(pad_colors[0])\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    for rooms in sorted({rooms for _color, rooms, _walls in drawings}):\n        group = [item for item in drawings if item[1] == rooms]\n        ordered.extend(_cover_order(g, group))\n\n    width = max(rooms for _color, rooms, _walls in ordered)\n\n    out = np.full((len(ordered), width), pad, dtype=int)\n    for r, (color, rooms, _walls) in enumerate(ordered):\n        out[r, :rooms] = int(color)\n    return out\n\n# --------------- generator (claude-opus-4-6) ---------------\n\n# ---- CFG: Tunable generation parameters ----\n_FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle\n_ROOM_COUNT_RANGE = (1, 6)            # rooms per frame\n_TIE_PROBABILITY = 0.35              # chance of one tied room-count pair\n_GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)\n    5: (25, 30, 25, 30, 16, 18),\n    4: (22, 30, 22, 30, 18, 22),\n    3: (20, 30, 20, 30, 22, 25),\n}\n_CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame\n_NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise\n_WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise\n_EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force\n_OVERLAP_RETRY = 100                 # attempts to place overlapping frame\n_GEN_RETRIES = 300                   # outer retry limit\n\n\ndef _random_gaps(n: int, min_gap: int, max_gap: int, max_total: int) -> list[int] | None:\n    \"\"\"Generate n gaps each in [min_gap, max_gap] with sum <= max_total.\"\"\"\n    if n * min_gap > max_total:\n        return None\n    gaps = [min_gap] * n\n    remaining = max_total - sum(gaps)\n    for i in range(n):\n        extra = min(max_gap - gaps[i], remaining)\n        if extra > 0:\n            add = random.randint(0, extra)\n            gaps[i] += add\n            remaining -= add\n    random.shuffle(gaps)\n    return gaps\n\n\ndef _build_frame(target_rooms: int, max_h: int = 22, max_w: int = 25) -> np.ndarray | None:\n    \"\"\"Build a boolean wall array with exactly target_rooms enclosed regions.\"\"\"\n    if target_rooms == 1:\n        gap_h = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_h - 2))\n        gap_w = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_w - 2))\n        h, w = gap_h + 2, gap_w + 2\n        walls = np.zeros((h, w), dtype=bool)\n        walls[0, :] = True\n        walls[h - 1, :] = True\n        walls[:, 0] = True\n        walls[:, w - 1] = True\n        return walls\n\n    # For target_rooms >= 2: grid of cells, then selectively merge\n    possible_configs = []\n    for nv in range(2, 6):\n        for nh in range(2, 5):\n            cells = (nv - 1) * (nh - 1)\n            if target_rooms <= cells <= target_rooms + 4:\n                possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        for nv in range(2, 7):\n            for nh in range(2, 6):\n                cells = (nv - 1) * (nh - 1)\n                if cells >= target_rooms:\n                    possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        return None\n\n    n_vcols, n_hrows, total_cells = random.choice(possible_configs)\n    n_row_gaps = n_hrows - 1\n    n_col_gaps = n_vcols - 1\n    min_gap, max_gap = _CELL_GAP_RANGE\n\n    if min_gap * n_row_gaps > max_h - 1 or min_gap * n_col_gaps > max_w - 1:\n        return None\n\n    row_gaps = _random_gaps(n_row_gaps, min_gap, max_gap, max_h - 1)\n    col_gaps = _random_gaps(n_col_gaps, min_gap, max_gap, max_w - 1)\n    if row_gaps is None or col_gaps is None:\n        return None\n\n    # Compute line positions from cumulative gaps\n    vcol_positions = [0]\n    for gap in col_gaps:\n        vcol_positions.append(vcol_positions[-1] + gap)\n    hrow_positions = [0]\n    for gap in row_gaps:\n        hrow_positions.append(hrow_positions[-1] + gap)\n\n    frame_h = hrow_positions[-1] + 1\n    frame_w = vcol_positions[-1] + 1\n    walls = np.zeros((frame_h, frame_w), dtype=bool)\n    for r in hrow_positions:\n        walls[r, :] = True\n    for c in vcol_positions:\n        walls[:, c] = True\n\n    cells_to_merge = total_cells - target_rooms\n    if cells_to_merge == 0:\n        return walls\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/8a6d367c.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, find_components, get_bg, paste\n\n\ndef _find_frame(g: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int]]:\n    candidates: list[tuple[int, int, tuple[int, int, int, int]]] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True):\n        color = int(comp[\"color\"])\n        r0, c0, r1, c1 = map(int, comp[\"bbox\"])\n        h = r1 - r0 + 1\n        w = c1 - c0 + 1\n        if h < 3 or w < 3:\n            continue\n\n        border = np.zeros((h, w), dtype=bool)\n        border[0, :] = True\n        border[-1, :] = True\n        border[:, 0] = True\n        border[:, -1] = True\n\n        sub = g[r0 : r1 + 1, c0 : c1 + 1]\n        if int(comp[\"area\"]) == int(border.sum()) and np.array_equal(sub == color, border):\n            candidates.append((int(comp[\"area\"]), color, (r0, c0, r1, c1)))\n\n    assert candidates, \"expected one rectangular frame\"\n    max_area = max(area for area, _color, _bbox in candidates)\n    largest = [candidate for candidate in candidates if candidate[0] == max_area]\n    assert len(largest) == 1, \"rectangular frame must be structurally unique\"\n    _area, color, frame_bbox = largest[0]\n    return color, frame_bbox\n\n\ndef _templates_above_frame(g: np.ndarray, bg: int, frame_r0: int) -> list[np.ndarray]:\n    top = g[:frame_r0]\n    templates: list[np.ndarray] = []\n    for color in np.unique(top):\n        color = int(color)\n        if color == bg:\n            continue\n        coords = np.argwhere(top == color)\n        r0, c0, r1, c1 = bbox_coords(coords)\n        templates.append(top[r0 : r1 + 1, c0 : c1 + 1] == color)\n\n    assert templates, \"expected upper template masks\"\n    return templates\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete the framed area by expanding the unique upper template that contains the existing seed pixels.\n\n    Input structure:\n    - A teal background contains small colored template masks above a larger rectangular frame.\n    - The frame encloses one fill color arranged as a partial block-scaled copy of one template.\n    - The frame interior dimensions are an integer square scale of the matching template bbox.\n\n    Rule:\n    - Crop to the rectangular frame.\n    - Identify the unique upper template whose block-scaled mask covers every existing fill pixel inside the frame.\n    - Reset the frame interior to background and paint the whole scaled mask with the fill color.\n\n    Key insight:\n    The lower colored pixels are seed cells that reveal which upper template should be completed inside the frame.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    frame_color, (r0, c0, r1, c1) = _find_frame(g, bg)\n\n    out = g[r0 : r1 + 1, c0 : c1 + 1].copy()\n    interior = out[1:-1, 1:-1]\n    fill_colors = set(map(int, np.unique(interior))) - {bg, frame_color}\n    assert len(fill_colors) == 1, \"frame interior must contain exactly one fill color\"\n    fill_color = fill_colors.pop()\n\n    seed = interior == fill_color\n    assert np.any(seed), \"frame must contain seed pixels\"\n    ih, iw = seed.shape\n\n    matches: list[np.ndarray] = []\n    for template in _templates_above_frame(g, bg, r0):\n        th, tw = template.shape\n        if ih % th != 0 or iw % tw != 0:\n            continue\n        scale_h = ih // th\n        scale_w = iw // tw\n        if scale_h != scale_w:\n            continue\n\n        scaled = np.kron(template, np.ones((scale_h, scale_w), dtype=bool))\n        if np.all(~seed | scaled):\n            matches.append(scaled)\n\n    assert len(matches) == 1, \"seed pixels must select exactly one scaled template\"\n    completed = matches[0]\n    assert completed.shape == interior.shape\n\n    interior[:, :] = bg\n    interior[completed] = fill_color\n    return out\n\n# --------------- generator (att2) ---------------\n\nGEN_BG = 8\nGEN_GRID_SHAPE = (27, 21)\nGEN_TEMPLATE_SHAPES = [(3, 3), (3, 4), (4, 3)]\nGEN_TEMPLATE_COUNT_RANGE = (2, 6)\nGEN_TEMPLATE_ROW = 1\nGEN_TEMPLATE_LEFT_MIN = 1\nGEN_TEMPLATE_GAP = 1\nGEN_MAX_TEMPLATE_SPAN = 19\nGEN_DENSITY_MIN_NUM = 1\nGEN_DENSITY_MIN_DEN = 2\nGEN_DENSITY_MAX_NUM = 5\nGEN_DENSITY_MAX_DEN = 6\nGEN_SCALE_RANGE = (2, 5)\nGEN_SEED_COUNTS = (2, 3)\nGEN_SEED_FRACTION_RANGE = (0.20, 0.60)\nGEN_FRAME_ROW_GAP = 2\nGEN_FRAME_LEFT_MIN = 1\nGEN_ATTEMPTS = 300\nGEN_PALETTE = [0, 1, 2, 3, 4, 5, 6, 7, 9]\n\ndef _gen_has_full_bbox(mask: np.ndarray) -> bool:\n    return bool(mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any())\n\n\ndef _gen_valid_masks(th: int, tw: int) -> list[np.ndarray]:\n    n = int(th * tw)\n    lo = (GEN_DENSITY_MIN_NUM * n + GEN_DENSITY_MIN_DEN - 1) // GEN_DENSITY_MIN_DEN\n    hi = (GEN_DENSITY_MAX_NUM * n) // GEN_DENSITY_MAX_DEN\n    masks: list[np.ndarray] = []\n    for bits in range(1 << n):\n        count = int(bits.bit_count())\n        if count < lo or count > hi:\n            continue\n        flat = np.array([(bits >> k) & 1 for k in range(n)], dtype=bool)\n        mask = flat.reshape(th, tw)\n        if _gen_has_full_bbox(mask):\n            masks.append(mask)\n    return masks\n\n\ndef _gen_colored_patch(mask: np.ndarray, color: int, bg: int) -> np.ndarray:\n    patch = np.full(mask.shape, bg, dtype=int)\n    patch[mask] = int(color)\n    return patch\n\n\ndef _gen_draw_frame(shape: tuple[int, int], bg: int, frame_color: int) -> np.ndarray:\n    patch = np.full(shape, bg, dtype=int)\n    patch[0, :] = frame_color\n    patch[-1, :] = frame_color\n    patch[:, 0] = frame_color\n    patch[:, -1] = frame_color\n    return patch\n\n\ndef _gen_frame_patch(\n    target_mask: np.ndarray,\n    seed_cells: np.ndarray,\n    scale: int,\n    bg: int,\n    frame_color: int,\n    fill_color: int,\n) -> tuple[np.ndarray, np.ndarray]:\n    th, tw = map(int, target_mask.shape)\n    scaled = np.kron(target_mask, np.ones((scale, scale), dtype=bool))\n    out = _gen_draw_frame((th * scale + 2, tw * scale + 2), bg, frame_color)\n    out[1:-1, 1:-1][scaled] = fill_color\n\n    frame = _gen_draw_frame(out.shape, bg, frame_color)\n    for r, c in seed_cells:\n        rr = int(r) * scale\n        cc = int(c) * scale\n        frame[1 + rr : 1 + rr + scale, 1 + cc : 1 + cc + scale] = fill_color\n    return frame, out\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    rng = np.random.default_rng()\n    bg = GEN_BG\n    count = int(rng.integers(*GEN_TEMPLATE_COUNT_RANGE))\n    shape_choices = [\n        shape for shape in GEN_TEMPLATE_SHAPES if count * shape[1] + count - 1 <= GEN_MAX_TEMPLATE_SPAN\n    ]\n    th, tw = shape_choices[int(rng.integers(0, len(shape_choices)))]\n    scale = int(rng.integers(*GEN_SCALE_RANGE))\n\n    valid_masks = _gen_valid_masks(th, tw)\n    if len(valid_masks) < count:\n        return None\n\n    target = valid_masks[int(rng.integers(0, len(valid_masks)))]\n    true_cells = np.argwhere(target)\n    target_area = int(len(true_cells))\n    min_seed_frac, max_seed_frac = GEN_SEED_FRACTION_RANGE\n    seed_counts = [k for k in GEN_SEED_COUNTS if min_seed_frac <= k / target_area <= max_seed_frac]\n    if not seed_counts:\n        return None\n    seed_count = int(seed_counts[int(rng.integers(0, len(seed_counts)))])\n    seed_idx = rng.choice(target_area, size=seed_count, replace=False)\n    seed_cells = true_cells[seed_idx]\n\n    covers_seed = np.array([bool(mask[seed_cells[:, 0], seed_cells[:, 1]].all()) for mask in valid_masks])\n    distractor_pool = [mask for mask, covers in zip(valid_masks, covers_seed) if not covers]\n    if len(distractor_pool) < count - 1:\n        return None\n    distractor_idx = rng.choice(len(distractor_pool), size=count - 1, replace=False)\n    distractors = [distractor_pool[int(i)] for i in distractor_idx]\n\n    masks = distractors + [target]\n    rng.shuffle(masks)\n\n    colors = list(GEN_PALETTE)\n    rng.shuffle(colors)\n    frame_color = int(colors[0])\n    fill_color = int(colors[1])\n    template_colors = [int(c) for c in colors[2 : 2 + count]]\n\n    frame, expected = _gen_frame_patch(target, seed_cells, scale, bg, frame_color, fill_color)\n    grid_h, grid_w = GEN_GRID_SHAPE\n    grid = np.full(GEN_GRID_SHAPE, bg, dtype=int)\n\n    total_template_w = count * tw + count - 1\n    template_c0 = int(rng.integers(GEN_TEMPLATE_LEFT_MIN, grid_w - total_template_w))\n    c = template_c0\n    for mask, color in zip(masks, template_colors):\n        paste(grid, _gen_colored_patch(mask, color, bg), GEN_TEMPLATE_ROW, c, transparent=bg)\n        c += tw + GEN_TEMPLATE_GAP\n\n    fh, fw = map(int, frame.shape)\n    min_r0 = th + GEN_FRAME_ROW_GAP\n    max_r0 = grid_h - fh\n    if min_r0 > max_r0:\n        return None\n    frame_r0 = int(rng.integers(min_r0, max_r0 + 1))\n    frame_c0 = int(rng.integers(GEN_FRAME_LEFT_MIN, grid_w - fw))\n    paste(grid, frame, frame_r0, frame_c0)\n\n    try:\n        if not np.array_equal(main(grid), expected):\n            return None\n    except Exception:\n        return None\n    return grid\n\n\ndef generate_input() -> np.ndarray:\n    for _ in range(GEN_ATTEMPTS):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate valid 8a6d367c input\")\n","exit_code":0,"status":"completed"}}
