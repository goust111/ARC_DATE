_nonbg_component8_from(g, (sr, sc), bg)\\n\\n        for cav, boundary, bcols in cavities:\\n            if len(bcols) != 1:\\n                continue\\n            boundary_in_traced = boundary & traced\\n            if not boundary_in_traced:\\n                continue\\n\\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\\n            # This prevents filling regions that are only connected through other structures, not the line itself.\\n            ok = False\\n            for r, c in boundary_in_traced:\\n                for nr, nc in neighbors8(r, c):\\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\\n                        ok = True\\n                        break\\n                if ok:\\n                    break\\n            if not ok:\\n                continue\\n\\n            for r, c in cav:\\n                if int(out[r, c]) == bg:\\n                    out[r, c] = seed_col\\n\\n    return out\\n\\n# --------------- generator (attempt_1_distractor_network) ---------------\\n\\n# ========================== CFG ==========================\\n# Canvas / grid\\nGRID_H_RANGE = (8, 30)             # grid height bounds\\nGRID_W_RANGE = (8, 30)             # grid width bounds\\nBG_COLORS = [0, 5]                 # background color choices\\n\\n# Seeds\\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\\n\\n# Frame loops\\nFRAME_COLORS_MAX = 4               # max distinct frame colors\\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\\n\\n# Line growth\\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\\n\\n# Distractor network\\nDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\\nDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\\nDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\\nDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\\nDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\\n\\n# Generation\\nGEN_RETRIES = 300                  # outer retry budget in generate_input()\\n# =========================================================\\n\\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\\nORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\\n\\n\\ndef _in_bounds(h, w, r, c):\\n    return 0 <= r < h and 0 <= c < w\\n\\n\\n# ---------------------------------------------------------------------------\\n# Frame geometry\\n# ---------------------------------------------------------------------------\\n\\ndef _frame_ring_coords(r0, c0, ch, cw):\\n    \\\"\\\"\\\"Return (ring_coords, cavity_coords) for a rounded-rect frame.\\n\\n    Frame bbox is [r0, r0+ch+1] x [c0, c0+cw+1] (inclusive).\\n    Ring = bbox boundary minus 4 corners.\\n    \\\"\\\"\\\"\\n    H, W = ch + 2, cw + 2\\n    ring = []\\n    for dr in range(H):\\n        for dc in range(W):\\n            on_bdr = (dr == 0 or dr == H - 1 or dc == 0 or dc == W - 1)\\n            corner = (dr in (0, H - 1)) and (dc in (0, W - 1))\\n            if on_bdr and not corner:\\n                ring.append((r0 + dr, c0 + dc))\\n    cavity = [(r0 + 1 + dr, c0 + 1 + dc) for dr in range(ch) for dc in range(cw)]\\n    return ring, cavity\\n\\n\\ndef _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\\n    \\\"\\\"\\\"Check that ring+cavity can be placed on canvas without conflicts.\\n\\n    Returns True if: ring and cavity cells are empty, no cavity cell is\\n    8-adjacent to line_col, ring is not 8-adjacent to foreign colors, and\\n    at least one ring cell is 8-adjacent to a line_col pixel.\\n    \\\"\\\"\\\"\\n    # Ring and cavity cells must all be empty\\n    for rr, cc in ring:\\n        if canvas[rr, cc] != -1:\\n            return False\\n    for rr, cc in cavity:\\n        if canvas[rr, cc] != -1:\\n            return False\\n\\n    # No cavity cell may be 8-adjacent to any line_col pixel\\n    for cr, cc in cavity:\\n        for nr, nc in neighbors8(cr, cc):\\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\\n                return False\\n\\n    # Ring must not be 8-adjacent to any non-bg, non-line_col pixel\\n    ring_set = set(ring)\\n    for rr, cc in ring:\\n        for nr, nc in neighbors8(rr, cc):\\n            if not _in_bounds(h, w, nr, nc) or (nr, nc) in ring_set:\\n                continue\\n            v = canvas[nr, nc]\\n            if v != -1 and v != line_col:\\n                return False\\n\\n    # At least one ring cell must be 8-adjacent to a line_col pixel\\n    for rr, cc in ring:\\n        for nr, nc in neighbors8(rr, cc):\\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\\n                return True\\n    return False\\n\\n\\n# ---------------------------------------------------------------------------\\n# Line growth\\n# ---------------------------------------------------------------------------\\n\\ndef _grow_line(grid, start, line_col, target_len, rng):\\n    \\\"\\\"\\\"Grow a meandering 8-connected 1px-wide path of line_col from start.\\\"\\\"\\\"\\n    h, w = grid.shape\\n    path = [start]\\n    dr_bias = 1 if start[0] < h // 2 else -1\\n    dc_bias = 1 if start[1] < w // 2 else -1\\n    cur = start\\n    path_set = {start}\\n    while len(path) < target_len:\\n        # Build weighted direction list: diagonals preferred, bias-aligned boosted\\n        dirs = []\\n        for ddr, ddc in DIAG_DIRS:\\n            aligned = (ddr == dr_bias or ddc == dc_bias)\\n            w_d = DIAG_WEIGHT_ALIGNED if aligned else DIAG_WEIGHT_OTHER\\n            dirs.extend([(ddr, ddc)] * w_d)\\n        for ddr, ddc in ORTHO_DIRS:\\n            aligned = (ddr == dr_bias and ddc == 0) or (ddc == dc_bias and ddr == 0)\\n            w_d = ORTHO_WEIGHT_ALIGNED if aligned else ORTHO_WEIGHT_OTHER\\n            dirs.extend([(ddr, ddc)] * w_d)\\n        rng.shuffle(dirs)\\n        placed = False\\n        for ddr, ddc in dirs:\\n            nr, nc = cur[0] + ddr, cur[1] + ddc\\n            if not _in_bounds(h, w, nr, nc) or grid[nr, nc] != -1:\\n                continue\\n            # Keep path thin: reject if 8-adjacent to existing path (except cur)\\n            if any((nnr, nnc) != cur and (nnr, nnc) in path_set\\n                   for nnr, nnc in neighbors8(nr, nc)):\\n                continue\\n            # Strongly avoid grid border\\n            if (nr == 0 or nc == 0 or nr == h - 1 or nc == w - 1) and rng.random() < BORDER_AVOIDANCE_PROB:\\n                continue\\n            cur = (nr, nc)\\n            path.append(cur)\\n            path_set.add(cur)\\n            grid[nr, nc] = line_col\\n            placed = True\\n            break\\n        if not placed:\\n            if rng.random() < BIAS_FLIP_PROB:\\n                dr_bias *= -1\\n            if rng.random() < BIAS_FLIP_PROB:\\n                dc_bias *= -1\\n            break\\n    return path\\n\\n\\n# ---------------------------------------------------------------------------\\n# Frame attachment\\n# ---------------------------------------------------------------------------\\n\\ndef _halo_offsets(fh, fw):\\n    \\\"\\\"\\\"Compute offsets around a frame bbox that lie outside it (the halo).\\\"\\\"\\\"\\n    return [(dr, dc) for dr in range(-1, fh + 1) for dc in range(-1, fw + 1)\\n            if not (0 <= dr < fh and 0 <= dc < fw)]\\n\\n\\ndef _try_attach_frame(canvas, line_path, line_col, frame_col, rng, max_tries=FRAME_ATTACH_TRIES):\\n    \\\"\\\"\\\"Try to place a frame loop 8-adjacent to some line pixel.\\n\\n    canvas is modified in place; returns (ring, cavity) or None on failure.\\n    \\\"\\\"\\\"\\n    h, w = canvas.shape\\n    pad = FRAME_PLACEMENT_PAD\\n    for _ in range(max_tries):\\n        ch = rng.choice(CAVITY_SIZE_WEIGHTS)\\n        cw = rng.choice(CAVITY_SIZE_WEIGHTS)\\n        lp = rng.choice(line_path)\\n        fh, fw = ch + 2, cw + 2\\n        offsets = _halo_offsets(fh, fw)\\n        rng.shuffle(offsets)\\n        for dr, dc in offsets:\\n            r0 = lp[0] - dr\\n            c0 = lp[1] - dc\\n            if r0 < pad or c0 < pad or r0 + fh > h - pad or c0 + fw > w - pad:\\n                continue\\n            ring, cavity = _frame_ring_coords(r0, c0, ch, cw)\\n            if not _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\\n                continue\\n            for rr, cc in ring:\\n                canvas[rr, cc] = frame_col\\n            return ring, cavity\\n    return None\\n\\n\\ndef _try_attach_distractor_frame(canvas, frame_col, rng, max_tries=DISTRACTOR_FRAME_TRIES):\\n    \\\"\\\"\\\"Place a loop in empty space, not touching any non-bg pixel.\\\"\\\"\\\"\\n    h, w = canvas.shape\\n    for _ in range(max_tries):\\n        ch = rng.choice(DISTRACTOR_CAVITY_WEIGHTS)\\n        cw = rng.choice(DISTRACTOR_CAVITY_WEIGHTS)\\n        fh, fw = ch + 2, cw + 2\\n        r0 = rng.randint(1, h - fh - 1)\\n        c0 = rng.randint(1, w - fw - 1)\\n        # Check the full bbox + 1-cell margin is empty\\n        ok = True\\n        for rr in range(r0 - 1, r0 + fh + 1):\\n            for cc in range(c0 - 1, c0 + fw + 1):\\n                if _in_bounds(h, w, rr, cc) and canvas[rr, cc] != -1:\\n                    ok = False\\n                    break\\n            if not ok:\\n                break\\n        if not ok:\\n            continue\\n        ring, _ = _frame_ring_coords(r0, c0, ch, cw)\\n        for rr, cc in ring:\\n            canvas[rr, cc] = frame_col\\n        return True\\n    return None\\n\\n\\ndef _try_place_distractor_network(canvas, line_col, frame_colors_pool, rng):\\n    \\\"\\\"\\\"Place a disconnected line+frame distractor (no seed).\\\"\\\"\\\"\\n    h, w = canvas.shape\\n    for _ in range(DISTRACTOR_NETWORK_TRIES):\\n        r = rng.randint(2, h - 3)\\n        c = rng.randint(2, w - 3)\\n        if any(canvas[r + dr, c + dc] != -1 for dr in range(-1, 2) for dc in range(-1, 2)):\\n            continue\\n        canvas[r, c] = line_col\\n        target_len = rng.randint(*DISTRACTOR_LINE_LEN)\\n        path = _grow_line(canvas, (r, c), line_col, target_len, rng)\\n        if len(path) < 3:\\n            for pr, pc in path:\\n                canvas[pr, pc] = -1\\n            continue\\n        attached = 0\\n        for _ in range(rng.randint(*DISTRACTOR_NETWORK_FRAMES)):\\n            fc = rng.choice(frame_colors_pool)\\n            if _try_attach_frame(canvas, path, line_col, fc, rng) is not None:\\n                attached += 1\\n        if attached > 0:\\n            return True\\n        for pr, pc in path:\\n            canvas[pr, pc] = -1\\n    return False\\n\\n\\n# ---------------------------------------------------------------------------\\n# Main generator\\n# ---------------------------------------------------------------------------\\n\\ndef _corner_config(corner_kind, h, w, rng):\\n    \\\"\\\"\\\"Return (seed_rc, first_line_rc) for corner_kind in {TL,TR,BL,BR}.\\\"\\\"\\\"\\n    if corner_kind == 'TL':\\n        seed = (0, 0)\\n        first = rng.choice([(0, 1), (1, 0)])\\n    elif corner_kind == 'TR':\\n        seed = (0, w - 1)\\n        first = rng.choice([(0, w - 2), (1, w - 1)])\\n    elif corner_kind == 'BL':\\n        seed = (h - 1, 0)\\n        first = rng.choice([(h - 1, 1), (h - 2, 0)])\\n    elif corner_kind == 'BR':\\n        seed = (h - 1, w - 1)\\n        first = rng.choice([(h - 1, w - 2), (h - 2, w - 1)])\\n    else:\\n        raise ValueError(corner_kind)\\n    return seed, first\\n\\n\\ndef _distribute_loop_budget(num_seeds, num_attached_target, rng):\\n    \\\"\\\"\\\"Distribute attached-loop budget across seeds, guaranteeing >= 1 each.\\\"\\\"\\\"\\n    seed_order = list(range(num_seeds))\\n    rng.shuffle(seed_order)\\n    per_seed = [0] * num_seeds\\n    remaining = num_attached_target\\n    # Guarantee at least 1 per seed\\n    while remaining > 0 and any(per_seed[i] == 0 for i in range(num_seeds)):\\n        for i in seed_order:\\n            if per_seed[i] == 0 and remaining > 0:\\n                per_seed[i] += 1\\n                remaining -= 1\\n    # Distribute remainder randomly\\n    while remaining > 0:\\n        per_seed[rng.choice(seed_order)] += 1\\n        remaining -= 1\\n    return per_seed\\n\\n\\ndef _gen_attempt(rng: random.Random) -> np.ndarray | None:\\n    h = rng.randint(*GRID_H_RANGE)\\n    w = rng.randint(*GRID_W_RANGE)\\n    bg = rng.choice(BG_COLORS)\\n    palette = [c for c in range(10) if c != bg]\\n    rng.shuffle(palette)\\n\\n    num_seeds = rng.choice(SEED_COUNT_WEIGHTS)\\n    if num_seeds * 2 > len(palette):\\n        return None\\n\\n    canvas = -np.ones((h, w), dtype=int)\\n\\n    seed_colors = [palette.pop() for _ in range(num_seeds)]\\n    line_colors = [palette.pop() for _ in range(num_seeds)]\\n\\n    all_corners = ['TL', 'TR', 'BL', 'BR']\\n    rng.shuffle(all_corners)\\n    corners_used = all_corners[:num_seeds]\\n\\n    num_frame_cols = rng.randint(1, min(FRAME_COLORS_MAX, len(palette)))\\n    frame_colors_pool = [palette.pop() for _ in range(num_frame_cols)]\\n\\n    # Grow seed lines\\n    lines_info = []\\n    for i in range(num_seeds):\\n        seed_rc, first_rc = _corner_config(corners_used[i], h, w, rng)\\n        if canvas[seed_rc] != -1 or canvas[first_rc] != -1:\\n            return None\\n        canvas[seed_rc] = seed_colors[i]\\n        canvas[first_rc] = line_colors[i]\\n        target_len = rng.randint(LINE_LEN_RANGE[0], min(LINE_LEN_RANGE[1], h + w))\\n        path = _grow_line(canvas, first_rc, line_colors[i], target_len, rng)\\n        if len(path) < MIN_LINE_LEN:\\n            return None\\n        lines_info.append((seed_colors[i], seed_rc, line_colors[i], path))\\n\\n    # Decide loop counts and distribute across seeds\\n    total_loops_target = rng.randint(num_seeds, TOTAL_LOOPS_MAX)\\n    num_distractors_target = rng.randint(0, max(0, total_loops_target - num_seeds))\\n    num_attached_target = total_loops_target - num_distractors_target\\n    per_seed = _distribute_loop_budget(num_seeds, num_attached_target, rng)\\n\\n    # Attach frames to each seed's line\\n    for i, (_, _, line_col, path) in enumerate(lines_info):\\n        attached = 0\\n        for _ in range(per_seed[i]):\\n            fc = rng.choice(frame_colors_pool)\\n            if _try_attach_frame(canvas, path, line_col, fc, rng) is not None:\\n                attached += 1\\n        if attached == 0:\\n            return None\\n\\n    # Place distractors\\n    if rng.random() < DISTRACTOR_NETWORK_PROB:\\n        _try_place_distractor_network(canvas, rng.choice(line_colors), frame_colors_pool, rng)\\n    else:\\n        for _ in range(rng.randint(0, DISTRACTOR_SOLO_MAX)):\\n            _try_attach_distractor_frame(canvas, rng.choice(frame_colors_pool), rng)\\n\\n    # Finalize grid\\n    grid = np.where(canvas == -1, bg, canvas).astype(int)\\n\\n    # Validate bg is most common color\\n    vals, cnts = np.unique(grid, return_counts=True)\\n    if int(vals[np.argmax(cnts)]) != bg:\\n        return None\\n\\n    # Validate each seed color appears exactly once\\n    for seed_col, _, _, _ in lines_info:\\n        if int((grid == seed_col).sum()) != 1:\\n            return None\\n\\n    # Oracle check: solver must change at least one cell\\n    try:\\n        out = main(grid)\\n    except Exception:\\n        return None\\n    if np.array_equal(out, grid):\\n        return None\\n    return grid\\n\\n\\ndef generate_input() -> np.ndarray:\\n    rng = random.Random()\\n    for _ in range(GEN_RETRIES):\\n        g = _gen_attempt(rng)\\n        if g is not None:\\n            return g\\n    raise RuntimeError(\\\"generate_input: exhausted attempts\\\")\\nFILE:/home/lixinyu/snap/new/ARC_code/eval/a25697e4.py\\ndef main(grid: np.ndarray) -> np.ndarray:\\n    \\\"\\\"\\\"\\n    Dock movable tools into border-anchored frames by filling cavities.\\n\\n    Input structure:\\n    - bg = most common color.\\n    - Border-touching components cluster into anchor frames with interior bg cavities.\\n    - Non-border 2-color components are movable tools.\\n\\n    Rule:\\n    - Match each tool to a frame whose cavity size equals one of its color-region counts.\\n    - Rotate/flip the tool so one color fills the cavity exactly; the other stays outside.\\n    - If the docking orientation uses a reflection, swap the tool's two colors.\\n\\n    Key insight: Cavity size determines tool–frame pairing; reflection triggers color swap.\\n    \\\"\\\"\\\"\\n    inp = grid\\n    g = inp.copy()\\n    bg = get_bg(g)\\n    H, W = g.shape\\n\\n    def bbox_gap(a, b) -> int:\\n        (ar0, ac0, ar1, ac1) = a\\n        (br0, bc0, br1, bc1) = b\\n        def gap1(x0, x1, y0, y1):\\n            if y1 < x0:\\n                return int(x0 - y1)\\n            if x1 < y0:\\n                return int(y0 - x1)\\n            return 0\\n        return gap1(ar0, ar1, br0, br1) + gap1(ac0, ac1, bc0, bc1)\\n\\n    fg = g != int(bg)\\n    lab, n = label(fg, structure=STRUCT4)\\n    fixed_mask = np.zeros((H, W), dtype=bool)\\n    fixed_components = []\\n    for cid in range(1, n + 1):\\n        pts = np.argwhere(lab == cid)\\n        pts_list = [(int(r), int(c)) for r, c in pts]\\n        touches = any(r == 0 or r == H - 1 or c == 0 or c == W - 1 for r, c in pts_list)\\n        if not touches:\\n            continue\\n        fixed_components.append({\\\"pts\\\": pts_list, \\\"bbox\\\": (int(pts[:,0].min()), int(pts[:,1].min()), int(pts[:,0].max()), int(pts[:,1].max()))})\\n        for r, c in pts_list:\\n            fixed_mask[r, c] = True\\n\\n    assert not (not fixed_components)\\n\\n    # Cluster fixed components into anchor frames.\\n    parent = list(range(len(fixed_components)))\\n\\n    def find(x):\\n        while parent[x] != x:\\n            parent[x] = parent[parent[x]]\\n            x = parent[x]\\n        return x\\n\\n    def union(a, b):\\n        ra, rb = find(a), find(b)\\n        if ra != rb:\\n            parent[rb] = ra\\n\\n    for i in range(len(fixed_components)):\\n        for j in range(i + 1, len(fixed_components)):\\n            if bbox_gap(fixed_components[i][\\\"bbox\\\"], fixed_components[j][\\\"bbox\\\"]) <= 2:\\n                union(i, j)\\n\\n    groups: dict[int, list[int]] = {}\\n    for i in range(len(fixed_components)):\\n        groups.setdefault(find(i), []).append(i)\\n\\n    anchor_groups = []\\n    for idxs in groups.values():\\n        pts = [p for i in idxs for p in fixed_components[i][\\\"pts\\\"]]\\n        rs = [r for r, _c in pts]\\n        cs = [c for _r, c in pts]\\n        bbox = (min(rs), min(cs), max(rs), max(cs))\\n        mask = np.zeros((H, W), dtype=bool)\\n        for r, c in pts:\\n            mask[r, c] = True\\n        sock = np.zeros((H, W), dtype=bool)\\n        for r in range(bbox[0], bbox[2] + 1):\\n            for c in range(bbox[1], bbox[3] + 1):\\n                if int(g[r, c]) != int(bg):\\n                    continue\\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\\n                    rr, cc = r + dr, c + dc\\n                    if 0 <= rr < H and 0 <= cc < W and mask[rr, cc]:\\n                        sock[r, c] = True\\n                        break\\n\\n        # Cavity = largest bg component inside bbox that is adjacent to the anchor pixels.\\n        cavity = np.zeros((H, W), dtype=bool)\\n        sub_bg = (g[bbox[0] : bbox[2] + 1, bbox[1] : bbox[3] + 1] == int(bg))\\n        sub_lab, sub_n = label(sub_bg, structure=STRUCT4)\\n        best_c = None  # (area, cid)\\n        for cid in range(1, sub_n + 1):\\n            ptsc = np.argwhere(sub_lab == cid)\\n            area = int(len(ptsc))\\n            # check adjacency to anchor within bbox\\n            adj = False\\n            for rr, cc in ptsc:\\n                r = int(bbox[0] + rr)\\n                c = int(bbox[1] + cc)\\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\\n                    r2, c2 = r + dr, c + dc\\n                    if bbox[0] <= r2 <= bbox[2] and bbox[1] <= c2 <= bbox[3] and mask[r2, c2]:\\n                        adj = True\\n                        break\\n                if adj:\\n                    break\\n            if not adj:\\n                continue\\n            cand = (area, -cid)\\n            if best_c is None or cand > best_c:\\n                best_c = cand\\n                best_id = cid\\n        if best_c is not None:\\n            ptsc = np.argwhere(sub_lab == best_id)\\n            for rr, cc in ptsc:\\n                cavity[int(bbox[0] + rr), int(bbox[1] + cc)] = True\\n        cav_bbox = None\\n        if cavity.any():\\n            ptsc2 = np.argwhere(cavity)\\n            r0c, c0c = ptsc2.min(axis=0)\\n            r1c, c1c = ptsc2.max(axis=0)\\n            cav_bbox = (int(r0c), int(c0c), int(r1c), int(c1c))\\n\\n        # swap rule for this anchor group: look for a color that appears in >=2 fixed sub-components\\n        # (within the group) with different sizes and larger-above-smaller.\\n        swap_needed = False\\n        for col in sorted({int(x) for x in np.unique(g[mask])} - {int(bg)}):\\n            sub = (g == int(col)) & mask\\n            labc, nc = label(sub, structure=STRUCT4)\\n            if nc < 2:\\n                continue\\n            comps = []\\n            for cid in range(1, nc + 1):\\n                ptsc = np.argwhere(labc == cid)\\n                comps.append((int(len(ptsc)), float(ptsc[:, 0].mean()), float(ptsc[:, 1].mean())))\\n            comps.sort(reverse=True)\\n            (s0, r0, _c0), (s1, r1, _c1) = comps[0], comps[1]\\n            # Swap only when the larger component is vertically above the smaller one.\\n            if s0 != s1 and r0 < r1:\\n                swap_needed = True\\n                break\\n\\n        # Dominant open direction: which side has the most bg neighbors.\\n        dir_list = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # U,D,L,R\\n        dir_counts = [0, 0, 0, 0]\\n        for r, c in pts:\\n            for di, (dr, dc) in enumerate(dir_list):\\n                rr, cc = r + dr, c + dc\\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(bg):\\n                    dir_counts[di] += 1\\n        open_dir = dir_list[int(np.argmax(dir_counts))]\\n        _labg, _ng = label(mask, structure=STRUCT4)\\n        single_piece = int(_ng) == 1\\n        cavity_size = int(cavity.sum())\\n\\n        anchor_groups.append(\\n            {\\n                \\\"mask\\\": mask,\\n                \\\"bbox\\\": bbox,\\n                \\\"socket_mask\\\": sock,\\n                \\\"cavity_mask\\\": cavity,\\n                \\\"cavity_bbox\\\": cav_bbox,\\n                \\\"open_dir\\\": open_dir,\\n                \\\"swap_needed\\\": swap_needed,\\n                \\\"single_piece\\\": single_piece,\\n                \\\"cavity_size\\\": cavity_size,\\n                \\\"size\\\": int(mask.sum()),\\n            }\\n        )\\n    anchor_groups.sort(key=lambda d: -d[\\\"size\\\"])\\n\\n    # Movable multi-color components are the remaining foreground pixels.\\n    mov_mask = fg & (~fixed_mask)\\n    mov_lab, mov_n = label(mov_mask, structure=STRUCT4)\\n    mov_comps = []\\n    for cid in range(1, mov_n + 1):\\n        pts = np.argwhere(mov_lab == cid)\\n        r0, c0 = pts.min(axis=0)\\n        r1, c1 = pts.max(axis=0)\\n        m = mov_lab[r0 : r1 + 1, c0 : c1 + 1] == cid\\n        patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()\\n        patch[~m] = 0\\n        mov_comps.append({\\\"bbox\\\": (int(r0), int(c0), int(r1), int(c1)), \\\"mask\\\": m, \\\"patch\\\": patch, \\\"size\\\": int(len(pts))})\\n    mov_comps.sort(key=lambda d: -d[\\\"size\\\"])\\n\\n    def choose_group(bbox) -> int:\\n        best_i = 0\\n        best_d = None\\n        for i, grp in enumerate(anchor_groups):\\n            d = bbox_gap(bbox, grp[\\\"bbox\\\"])\\n            if best_d is None or d < best_d:\\n                best_d = d\\n                best_i = i\\n        return int(best_i)\\n\\n    def gen_variants(patch: np.ndarray, mask: np.ndarray):\\n        \\\"\\\"\\\"All unique dihedral variants, with a reflection flag.\\\"\\\"\\\"\\n        base: list[tuple[np.ndarray, np.ndarray, bool]] = []\\n        for k in range(4):\\n            p = np.rot90(patch, k)\\n            m = np.rot90(mask, k)\\n            base.append((p, m, False))\\n            base.append((np.fliplr(p), np.fliplr(m), True))\\n        uniq: list[tuple[np.ndarray, np.ndarray, bool]] = []\\n        seen = set()\\n        for p, m, is_flip in base:\\n            key = (m.tobytes(), p[m].tobytes())\\n            if key in seen:\\n                continue\\n            seen.add(key)\\n            uniq.append((p, m, is_flip))\\n        return uniq\\n\\n    out = np.full_like(g, int(bg))\\n    out[fixed_mask] = g[fixed_mask]\\n    placed_global = fixed_mask.copy()\\n    placed_groups = [grp[\\\"mask\\\"].copy() for grp in anchor_groups]\\n\\n    group_for_comp: list[int]\\n    # Match condition (key): a tool can dock into a frame only if one of its two color-regions has\\n    # pixel-count equal to the frame's cavity size. Use this to assign tools to frames (one-to-one\\n    # when counts match), falling back to distance only if no such match exists.\\n    comp_color_counts: list[dict[int, int]] = []\\n    for comp in mov_comps:\\n        vals = [int(x) for x in comp[\\\"patch\\\"][comp[\\\"mask\\\"]].flatten() if int(x) != 0]\\n        comp_color_counts.append(dict(Counter(vals)))\\n\\n    def compatible(ci: int, gi: int) -> bool:\\n        cav_sz = int(anchor_groups[gi][\\\"cavity_size\\\"])\\n        return any(int(v) == cav_sz for v in comp_color_counts[ci].values())\\n\\n    if len(mov_comps) == len(anchor_groups) and len(anchor_groups) > 1:\\n        import itertools\\n\\n        best_perm = None\\n        best_score = None\\n        for perm in itertools.permutations(range(len(anchor_groups))):\\n            ok = True\\n            hits = 0\\n            dist_sum = 0\\n            for ci, gi in enumerate(perm):\\n                if not compatible(ci, gi):\\n                    ok = False\\n                    break\\n                hits += 1\\n                dist_sum += bbox_gap(mov_comps[ci][\\\"bbox\\\"], anchor_groups[gi][\\\"bbox\\\"])\\n            if not ok:\\n                continue\\n            score = (int(hits), -int(dist_sum))\\n            if best_score is None or score > best_score:\\n                best_score = score\\n                best_perm = perm\\n        assert best_perm is not None, 'must find a compatible tool-to-frame permutation'\\n        group_for_comp = [int(x) for x in best_perm]\\n    else:\\n        group_for_comp = []\\n        for ci, comp in enumerate(mov_comps):\\n            best_g = None\\n            best_d = None\\n            for gi, grp in enumerate(anchor_groups):\\n                if not compatible(ci, gi):\\n                    continue\\n                d = bbox_gap(comp[\\\"bbox\\\"], grp[\\\"bbox\\\"])\\n                if best_d is None or d < best_d:\\n                    best_d = d\\n                    best_g = gi\\n            group_for_comp.append(int(best_g) if best_g is not None else int(choose_group(comp[\\\"bbox\\\"])))\\n\\n    for comp, gi in zip(mov_comps, group_for_comp):\\n        grp = anchor_groups[gi]\\n        placed_grp = placed_groups[gi]\\n        sock = grp[\\\"socket_mask\\\"]\\n        cav = grp[\\\"cavity_mask\\\"]\\n        cav_bbox = grp[\\\"cavity_bbox\\\"]\\n        odr, odc = grp[\\\"open_dir\\\"]\\n        # Swap rule (more principled): swap the two tool colors iff the *docking transform* uses a\\n        # reflection (flip). We'll detect this from the winning variant. (Ignore equal-area 2-color\\n        # tools: swapping is ambiguous and not needed.)\\n        comp_vals = [int(x) for x in comp[\\\"patch\\\"][comp[\\\"mask\\\"]].flatten() if int(x) != 0]\\n        comp_counts = Counter(comp_vals)\\n\\n        best_state = None\\n        # Score prioritizes *filling the cavity* with exactly one tool color region.\\n        # (plug_full, plug_hits, -nonplug_in_cavity, -plug_outside, cavity_hits, adj, outside, socket_hits, -dist, -r0, -c0)\\n        best_score = None\\n        cav_sz = int(grp[\\\"cavity_size\\\"])\\n        for p, m, is_flip in gen_variants(comp[\\\"patch\\\"], comp[\\\"mask\\\"]):\\n            h, w = m.shape\\n            coords = np.argwhere(m)\\n            cols_here = sorted({int(x) for x in p[m].flatten() if int(x) != 0})\\n            plug_colors = [int(col) for col in cols_here if int(((p == int(col)) & m).sum()) == cav_sz]\\n            assert plug_colors\\n            for r0 in range(0, H - h + 1):\\n                for c0 in range(0, W - w + 1):\\n                    ok = True\\n                    for rr, cc in coords:\\n                        r = int(r0 + rr)\\n                        c = int(c0 + cc)\\n                        if placed_global[r, c]:\\n                            ok = False\\n                            break\\n                    if not ok:\\n                        continue\\n                    adj = 0\\n                    for rr, cc in coords:\\n                        r = int(r0 + rr)\\n                        c = int(c0 + cc)\\n                        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\\n                            r2, c2 = r + dr, c + dc\\n                            if 0 <= r2 < H and 0 <= c2 < W and placed_grp[r2, c2]:\\n                                adj += 1\\n                    if adj == 0:\\n                        continue\\n                    socket_hits = 0\\n                    cavity_hits = 0\\n                    outside = 0\\n                    # Best plug-match for this placement among candidate plug colors.\\n                    plug_best = None  # (plug_full, plug_hits, -nonplug_in_cavity, -plug_outside)\\n                    for rr, cc in coords:\\n                        r = int(r0 + rr)\\n                        c = int(c0 + cc)\\n                        if sock[r, c]:\\n                            socket_hits += 1\\n                        if cav[r, c]:\\n                            cavity_hits += 1\\n                        # Count pixels placed outside the anchor bbox in the dominant open direction.\\n                        br0, bc0, br1, bc1 = grp[\\\"bbox\\\"]\\n                        if odc == -1 and c < bc0:\\n                            outside += 1\\n                        elif odc == 1 and c > bc1:\\n                            outside += 1\\n                        elif odr == -1 and r < br0:\\n                            outside += 1\\n                        elif odr == 1 and r > br1:\\n                            outside += 1\\n\\n                    for plug_col in plug_colors:\\n                        if plug_col is None:\\n                            plug_score = (0, 0, 0, 0)\\n                        else:\\n                            plug_hits = 0\\n                            plug_outside = 0\\n                            nonplug_in_cav = 0\\n                            for rr, cc in coords:\\n                                r = int(r0 + rr)\\n                                c = int(c0 + cc)\\n                                in_cav = bool(cav[r, c])\\n                                col = int(p[rr, cc])\\n                                if col == int(plug_col):\\n                                    if in_cav:\\n                                        plug_hits += 1\\n                                    else:\\n                                        plug_outside += 1\\n                                else:\\n                                    if in_cav:\\n                                        nonplug_in_cav += 1\\n                            plug_full = int(plug_hits == cav_sz and plug_outside == 0 and nonplug_in_cav == 0)\\n                            plug_score = (int(plug_full), int(plug_hits), -int(nonplug_in_cav), -int(plug_outside))\\n                        if plug_best is None or plug_score > plug_best:\\n                            plug_best = plug_score\\n                    dist = bbox_gap(grp[\\\"bbox\\\"], (int(r0), int(c0), int(r0 + h - 1), int(c0 + w - 1)))\\n                    score = tuple(plug_best) + (\\n                        int(cavity_hits),\\n                        int(adj),\\n                        int(outside),\\n                        int(socket_hits),\\n                        -int(dist),\\n                        -int(r0),\\n                        -int(c0),\\n                    )\\n                    if best_score is None or score > best_score:\\n                        best_score = score\\n                        best_state = (p, m, int(r0), int(c0), bool(is_flip))\\n\\n        assert best_state is not None, 'must find a valid placement for every movable tool'\\n        p, m, r0, c0, is_flip = best_state\\n        if is_flip and len(comp_counts) == 2 and len(set(comp_counts.values())) == 2:\\n            a, b = sorted(comp_counts.keys())\\n            q = p.copy()\\n            q[(p == a) & m] = b\\n            q[(p == b) & m] = a\\n            p = q\\n        for rr, cc in np.argwhere(m):\\n            r = int(r0 + rr)\\n            c = int(c0 + cc)\\n            out[r, c] = int(p[rr, cc])\\n            placed_global[r, c] = True\\n            placed_grp[r, c] = True\\n\\n    return out\\n\\n# --------------- generator (O4) ---------------\\n\\nfrom arc_utils import bbox as _bbox\\n\\n# ── CFG: canvas ──\\nGRID_H_RANGE = (18, 30)          # output grid height\\nGRID_W_RANGE = (25, 30)          # output grid width\\nNUM_PAIRS_CHOICES = [1, 2]       # how many frame-tool pairs\\n\\n# ── CFG: frame geometry ──\\nFRAME_W_RANGE = (4, 8)           # frame width (exclusive upper)\\nNOTCH_N_RANGE = (1, 4)           # notch cell count (exclusive upper)\\nTOP_H_RANGE = (1, 4)             # top bar height (exclusive upper)\\nBOT_H_RANGE = (2, 4)             # bottom bar height (exclusive upper)\\nPLUG_AREA_BOUNDS = (5, 8)        # valid plug area = fw + notch_n\\n\\n# ── CFG: tool sizing ──\\nHANDLE_AREA_RANGE = (4, 10)      # handle pixel count (exclusive upper)\\nTOOL_TOTAL_BOUNDS = (10, 15)     # plug + handle total pixels\\nHANDLE_SPRITE_DIM = (2, 5)      # handle sprite bbox side (exclusive upper)\\n\\n# ── CFG: placement ──\\nUNION_BBOX_GAP_MIN = 2           # min gap between pair union bboxes\\nFRAME_BBOX_GAP_MIN = 3           # min gap between frame bboxes\\nTOOL_BORDER = 1                  # border margin for free tool placement\\nTOOL_PADDING = 3                 # padding around existing content\\nTOOL_PADDING_CONN = 4            # connectivity for padding check\\n\\n# ── CFG: retry limits ──\\nPAIR_SPEC_RETRIES = 300          # retries for picking compatible pair specs\\nHANDLE_SPRITE_RETRIES = 30       # retries for generating a valid handle sprite\\nGEN_ATTEMPT_RETRIES = 300        # outer retries in generate_input()\\n\\n\\ndef _bbox_gap(a, b) -> int:\\n    \\\"\\\"\\\"Manhattan gap between two axis-aligned bboxes (r0,c0,r1,c1).\\\"\\\"\\\"\\n    (ar0, ac0, ar1, ac1) = a\\n    (br0, bc0, br1, bc1) = b\\n\\n    def _gap1(x0, x1, y0, y1):\\n        if y1 < x0:\\n            return x0 - y1\\n        if x1 < y0:\\n            return y0 - x1\\n        return 0\\n\\n    return _gap1(ar0, ar1, br0, br1) + _gap1(ac0, ac1, bc0, bc1)\\n\\n\\ndef _transform(arr: np.ndarray, k: int, flip: bool) -> np.ndarray:\\n    \\\"\\\"\\\"Apply rot90(k) then optional horizontal flip.\\\"\\\"\\\"\\n    out = np.rot90(arr, k)\\n    if flip:\\n        out = np.fliplr(out)\\n    return out\\n\\n\\ndef _orient_left_to_side(arr: np.ndarray, side: str) -> np.ndarray:\\n    \\\"\\\"\\\"Rotate/flip an array built for the left border to target the given side.\\\"\\\"\\\"\\n    if side == \\\"left\\\":\\n        return arr.copy()\\n    if side == \\\"right\\\":\\n        return np.fliplr(arr)\\n    if side == \\\"top\\\":\\n        return np.rot90(arr, 3)\\n    if side == \\\"bottom\\\":\\n        return np.rot90(arr, 1)\\n    raise ValueError(side)\\n\\n\\ndef _swap_colors(patch: np.ndarray, a: int, b: int) -> np.ndarray:\\n    \\\"\\\"\\\"Swap two colors in a patch, returning a new array.\\\"\\\"\\\"\\n    out = patch.copy()\\n    ma, mb = out == a, out == b\\n    out[ma] = b\\n    out[mb] = a\\n    return out\\n\\n\\ndef _notch_offsets(notch_n: int, fw: int, bot_h: int) -> list[tuple[int, int]]:\\n    \\\"\\\"\\\"Return (row, col) offsets within the bottom bar to carve out a staircase notch.\\\"\\\"\\\"\\n    if notch_n == 1:\\n        return [(0, fw - 1)]\\n    if notch_n == 2:\\n        return [(0, fw - 2), (0, fw - 1)]\\n    if notch_n == 3:\\n        if bot_h >= 2:\\n            return [(0, fw - 2), (0, fw - 1), (1, fw - 1)]\\n        return [(0, fw - 3), (0, fw - 2), (0, fw - 1)]\\n    raise ValueError(notch_n)\\n\\n\\ndef _make_handle_sprite(handle_area: int, bg: int, handle_color: int) -> np.ndarray | None:\\n    \\\"\\\"\\\"Generate a random 4-connected handle sprite with exactly handle_area pixels.\\\"\\\"\\\"\\n    lo, hi = HANDLE_SPRITE_DIM\\n    dims = [(h, w) for h in range(lo, hi) for w in range(lo, hi)\\n            if handle_area <= h * w <= handle_area * 2]\\n    if not dims:\\n        return None\\n    for _ in range(HANDLE_SPRITE_RETRIES):\\n        h, w = random.choice(dims)\\n        sprite = random_sprite(\\n            h, w, density=handle_area / (h * w),\\n            color_palette=[handle_color], connectivity=4, background=bg,\\n        )\\n        if int(np.sum(sprite != bg)) == handle_area:\\n            return sprite\\n    return None\\n\\n\\ndef _build_left_pair(\\n    *, bg: int, frame_color: int, plug_color: int, handle_color: int,\\n    fw: int, top_h: int, bot_h: int, notch_n: int, handle_area: int,\\n) -> tuple[np.ndarray, np.ndarray] | None:\\n    \\\"\\\"\\\"Build a frame + docked tool pair oriented for the left border.\\n\\n    Returns (frame_array, tool_array) on the same canvas, or None on failure.\\n    \\\"\\\"\\\"\\n    fh = top_h + 1 + bot_h\\n    frame = np.full((fh, fw), bg, dtype=int)\\n    frame[:top_h, :] = frame_color\\n    frame[top_h + 1:, :] = frame_color\\n    for dr, dc in _notch_offsets(notch_n, fw, bot_h):\\n        frame[top_h + 1 + dr, dc] = bg\\n\\n    cavity = frame == bg\\n    attach_rows = {r for r in range(fh) if cavity[r, fw - 1]}\\n\\n    handle_sprite = _make_handle_sprite(handle_area, bg, handle_color)\\n    if handle_sprite is None:\\n        return None\\n\\n    hs_h, hs_w = handle_sprite.shape\\n    sprite_left_rows = {r for r in range(hs_h) if handle_sprite[r, 0] != bg}\\n\\n    valid_offsets = [\\n        voff for voff in range(fh)\\n        if any((voff + sr) in attach_rows for sr in sprite_left_rows)\\n    ]\\n    if not valid_offsets:\\n        return None\\n\\n    voff = random.choice(valid_offsets)\\n    total_h = max(fh, voff + hs_h)\\n    total_w = fw + hs_w\\n\\n    frame_full = np.full((total_h, total_w), bg, dtype=int)\\n    frame_full[:fh, :fw] = frame\\n\\n    tool = np.full((total_h, total_w), bg, dtype=int)\\n    tool[:fh, :fw][cavity] = plug_color\\n    handle_mask = handle_sprite != bg\\n    tool[voff:voff + hs_h, fw:fw + hs_w][handle_mask] = handle_color\\n\\n    return frame_full, tool\\n\\n\\ndef _build_param_options() -> list[tuple[int, int, int, int]]:\\n    \\\"\\\"\\\"Enumerate all valid (fw, top_h, bot_h, notch_n) combinations.\\\"\\\"\\\"\\n    fw_lo, fw_hi = FRAME_W_RANGE\\n    nn_lo, nn_hi = NOTCH_N_RANGE\\n    th_lo, th_hi = TOP_H_RANGE\\n    bh_lo, bh_hi = BOT_H_RANGE\\n    pa_lo, pa_hi = PLUG_AREA_BOUNDS\\n    return [\\n        (fw, top_h, bot_h, notch_n)\\n        for fw in range(fw_lo, fw_hi)\\n        for notch_n in range(nn_lo, nn_hi)\\n        if pa_lo <= fw + notch_n <= pa_hi\\n        for top_h in range(th_lo, th_hi)\\n        for bot_h in range(bh_lo, bh_hi)\\n    ]\\n\\n\\nPARAM_OPTIONS = _build_param_options()\\n\\n\\ndef _pick_pair_specs(num_pairs: int) -> list[dict]:\\n    \\\"\\\"\\\"Pick frame geometry specs for each pair, ensuring distinct plug areas.\\\"\\\"\\\"\\n    ha_lo, ha_hi = HANDLE_AREA_RANGE\\n    tt_lo, tt_hi = TOOL_TOTAL_BOUNDS\\n    specs: list[dict] = []\\n    for _ in range(PAIR_SPEC_RETRIES):\\n        specs.clear()\\n        used_plug_areas: set[int] = set()\\n        for _ in range(num_pairs):\\n            candidates = [x for x in PARAM_OPTIONS if x[0] + x[3] not in used_plug_areas]\\n            if not candidates:\\n                specs = []\\n                break\\n            fw, top_h, bot_h, notch_n = random.choice(candidates)\\n            plug_area = fw + notch_n\\n            specs.append({\\\"fw\\\": fw, \\\"top_h\\\": top_h, \\\"bot_h\\\": bot_h,\\n                          \\\"notch_n\\\": notch_n, \\\"plug_area\\\": plug_area})\\n            used_plug_areas.add(plug_area)\\n        if len(specs) != num_pairs:\\n            continue\\n        all_plug_areas = {s[\\\"plug_area\\\"] for s in specs}\\n        ok = True\\n        for spec in specs:\\n            pa = spec[\\\"plug_area\\\"]\\n            handle_choices = [\\n                h for h in range(ha_lo, ha_hi)\\n                if tt_lo <= pa + h <= tt_hi and h != pa and h not in all_plug_areas\\n            ]\\n            if not handle_choices:\\n                ok = False\\n                break\\n            spec[\\\"handle_area\\\"] = random.choice(handle_choices)\\n        if ok:\\n            return [dict(s) for s in specs]\\n    return []\\n\\n\\ndef _candidate_origins(side: str, ph: int, pw: int, H: int, W: int) -> list[tuple[int, int]]:\\n    \\\"\\\"\\\"Return shuffled candidate (r0, c0) origins for placing a patch on the given border side.\\\"\\\"\\\"\\n    if side == \\\"left\\\":\\n        origins = [(r0, 0) for r0 in range(H - ph + 1)]\\n    elif side == \\\"right\\\":\\n        origins = [(r0, W - pw) for r0 in range(H - ph + 1)]\\n    elif side == \\\"top\\\":\\n        origins = [(0, c0) for c0 in range(W - pw + 1)]\\n    elif side == \\\"bottom\\\":\\n        origins = [(H - ph, c0) for c0 in range(W - pw + 1)]\\n    else:\\n        raise ValueError(side)\\n    random.shuffle(origins)\\n    return origins\\n\\n\\ndef _variant_choices(patch: np.ndarray) -> list[tuple[np.ndarray, bool]]:\\n    \\\"\\\"\\\"Return shuffled list of unique D4 variants of patch, each with its flip flag.\\\"\\\"\\\"\\n    seen = set()\\n    out: list[tuple[np.ndarray, bool]] = []\\n    mask = patch != 0\\n    for k in range(4):\\n        for flip in (False, True):\\n            q = _transform(patch, k, flip)\\n            m = _transform(mask.astype(np.uint8), k, flip).astype(bool)\\n            key = (m.tobytes(), q[m].tobytes())\\n            if key in seen:\\n                continue\\n            seen.add(key)\\n            out.append((q, flip))\\n    random.shuffle(out)\\n    return out\\n\\n\\ndef _place_docked_pair(\\n    i: int, spec: dict, colors: list[int], side: str, bg: int,\\n    H: int, W: int, output: np.ndarray, input_grid: np.ndarray,\\n    union_bboxes: list, frame_bboxes: list,\\n) -> dict | None:\\n    \\\"\\\"\\\"Build one frame-tool pair, dock it onto the output, and record frame on input_grid.\\n\\n    Returns tool info dict for later undocking, or None on failure.\\n    \\\"\\\"\\\"\\n    frame_color = colors[3 * i]\\n    plug_color = colors[3 * i + 1]\\n    handle_color = colors[3 * i + 2]\\n\\n    result = _build_left_pair(\\n        bg=bg, frame_color=frame_color, plug_color=plug_color,\\n        handle_color=handle_color, fw=spec[\\\"fw\\\"], top_h=spec[\\\"top_h\\\"],\\n        bot_h=spec[\\\"bot_h\\\"], notch_n=spec[\\\"notch_n\\\"],\\n        handle_area=spec[\\\"handle_area\\\"],\\n    )\\n    if result is None:\\n        return None\\n    frame_left, tool_left = result\\n\\n    # Combine frame + tool into a single docked scene\\n    scene_left = np.where(tool_left != bg, tool_left, frame_left)\\n\\n    frame_scene = _orient_left_to_side(frame_left, side)\\n    tool = _orient_left_to_side(tool_left, side)\\n    scene = _orient_left_to_side(scene_left, side)\\n    ph, pw = scene.shape\\n    fr0, fc0, fr1, fc1 = _bbox(frame_scene != bg)\\n\\n    origin = None\\n    for r0, c0 in _candidate_origins(side, ph, pw, H, W):\\n        union_bbox = (r0, c0, r0 + ph - 1, c0 + pw - 1)\\n        frame_bbox = (r0 + fr0, c0 + fc0, r0 + fr1, c0 + fc1)\\n        if side in (\\\"left\\\", \\\"right\\\") and (frame_bbox[0] == 0 or frame_bbox[2] == H - 1):\\n            continue\\n        if side in (\\\"top\\\", \\\"bottom\\\") and (frame_bbox[1] == 0 or frame_bbox[3] == W - 1):\\n            continue\\n        if any(_bbox_gap(union_bbox, prev) <= UNION_BBOX_GAP_MIN - 1 for prev in union_bboxes):\\n            continue\\n        if any(_bbox_gap(frame_bbox, prev) <= FRAME_BBOX_GAP_MIN - 1 for prev in frame_bboxes):\\n            continue\\n        if np.any((output[r0:r0 + ph, c0:c0 + pw] != bg) & (scene != bg)):\\n            continue\\n        origin = (r0, c0)\\n        break\\n    if origin is None:\\n        return None\\n\\n    r0, c0 = origin\\n    paste(output, scene, r0, c0, transparent=bg)\\n    paste(input_grid, frame_scene, r0, c0, transparent=bg)\\n\\n    union_bboxes.append((r0, c0, r0 + ph - 1, c0 + pw - 1))\\n    frame_bboxes.append((r0 + fr0, c0 + fc0, r0 + fr1, c0 + fc1))\\n    return {\\n        \\\"tool\\\": tool, \\\"plug_color\\\": plug_color, \\\"handle_color\\\": handle_color,\\n        \\\"plug_area\\\": spec[\\\"plug_area\\\"], \\\"handle_area\\\": spec[\\\"handle_area\\\"],\\n    }\\n\\n\\ndef _undock_tool(info: dict, bg: int, input_grid: np.ndarray,\\n                 placement_canvas: np.ndarray) -> bool:\\n    \\\"\\\"\\\"Pick a random D4 variant of the tool and place it at a free location on the grid.\\n\\n    Returns True on success, False if no placement found.\\n    \\\"\\\"\\\"\\n    for patch, is_flip in _variant_choices(info[\\\"tool\\\"]):\\n        if is_flip and info[\\\"plug_area\\\"] != info[\\\"handle_area\\\"]:\\n            patch = _swap_colors(patch, info[\\\"plug_color\\\"], info[\\\"handle_color\\\"])\\n        try:\\n            r0, c0 = random_free_location(\\n                placement_canvas, patch, transparent=bg,\\n                border=TOOL_BORDER, padding=TOOL_PADDING,\\n                padding_connectivity=TOOL_PADDING_CONN,\\n            )\\n        except ValueError:\\n            continue\\n        paste(input_grid, patch, r0, c0, transparent=bg)\\n        paste(placement_canvas, patch, r0, c0, transparent=bg)\\n        return True\\n    return False\\n\\n\\ndef _gen_attempt() -> np.ndarray | None:\\n    \\\"\\\"\\\"Single attempt to generate a valid input grid.\\\"\\\"\\\"\\n    H = random.randint(*GRID_H_RANGE)\\n    W = random.randint(*GRID_W_RANGE)\\n    bg = random.choice(list(range(10)))\\n    num_pairs = random.choice(NUM_PAIRS_CHOICES)\\n\\n    pair_specs = _pick_pair_specs(num_pairs)\\n    if len(pair_specs) != num_pairs:\\n        return None\\n\\n    colors = [c for c in range(1, 10) if c != bg]\\n    random.shuffle(colors)\\n    need = 1 + (3 * num_pairs)\\n    if len(colors) < need:\\n        return None\\n\\n    sides = random.sample([\\\"left\\\", \\\"right\\\", \\\"top\\\", \\\"bottom\\\"], k=num_pairs)\\n    output = np.full((H, W), bg, dtype=int)\\n    input_grid = np.full((H, W), bg, dtype=int)\\n    union_bboxes: list[tuple[int, int, int, int]] = []\\n    frame_bboxes: list[tuple[int, int, int, int]] = []\\n    placed_tools: list[dict] = []\\n\\n    for i, spec in enumerate(pair_specs):\\n        info = _place_docked_pair(\\n            i, spec, colors, sides[i], bg, H, W,\\n            output, input_grid, union_bboxes, frame_bboxes,\\n        )\\n        if info is None:\\n            return None\\n        placed_tools.append(info)\\n\\n    placement_canvas = output.copy()\\n    for info in placed_tools:\\n        if not _undock_tool(info, bg, input_grid, placement_canvas):\\n            return None\\n\\n    if np.array_equal(main(input_grid), output):\\n        return input_grid\\n    return None\\n\\n\\ndef generate_input() -> np.ndarray:\\n    for _ in range(GEN_ATTEMPT_RETRIES):\\n        grid = _gen_attempt()\\n        if grid is not None:\\n            return grid\\n    raise RuntimeError(\\\"failed to generate valid input after %d attempts\\\" % GEN_ATTEMPT_RETRIES)\\nFILE:/home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\\ndef main(grid: np.ndarray) -> np.ndarray:\\n    \\\"\\\"\\\"\\n    Slide a solid square through a winding channel to reach a same-sized target square.\\n\\n    Input structure:\\n    - bg (most common color). A river color forms a winding corridor.\\n    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\\n\\n    Rule:\\n    - The mover square travels along the river toward the destination.\\n    - It can only pass through positions where the full NxN area is river.\\n    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\\n    - The mover's original position is filled with the river color.\\n\\n    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\\n    \\\"\\\"\\\"\\n    g = np.array(grid, dtype=int)\\n    H, W = g.shape\\n\\n    # Corner-majority background (more stable than global mode here).\\n    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\\n\\n    # Detect solid square components (excluding bg).\\n    squares: list[dict] = []\\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\\\"dict\\\"):\\n        col = int(comp[\\\"color\\\"])\\n        b = comp[\\\"bbox\\\"]\\n        if bbox_h(b) != bbox_w(b):\\n            continue\\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\\n        if not bool((patch == int(col)).all()):\\n            continue\\n        squares.append({\\\"col\\\": int(col), \\\"r0\\\": int(b[0]), \\\"c0\\\": int(b[1]), \\\"n\\\": int(bbox_h(b))})\\n\\n    assert not (len(squares) < 2)\\n\\n    # Choose the size that appears at least twice (most common size).\\n    by_n: dict[int, list[dict]] = defaultdict(list)\\n    for s in squares:\\n        by_n[int(s[\\\"n\\\"])].append(s)\\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\\n    cand = by_n[int(nside)]\\n    assert not (len(cand) < 2)\\n\\n    cand.sort(key=lambda s: int(s[\\\"col\\\"]))\\n    mover = cand[0]\\n    dest = cand[1]\\n\\n    n = int(mover[\\\"n\\\"])\\n    sr, sc = int(mover[\\\"r0\\\"]), int(mover[\\\"c0\\\"])\\n    dr, dc = int(dest[\\\"r0\\\"]), int(dest[\\\"c0\\\"])\\n\\n    # River = most common remaining color (excluding bg and the two square colors).\\n    counts = Counter(map(int, g.flatten()))\\n    river = None\\n    for col, _ct in counts.most_common():\\n        if int(col) == int(bg):\\n            continue\\n        if int(col) in (int(mover[\\\"col\\\"]), int(dest[\\\"col\\\"])):\\n            continue\\n        river = int(col)\\n        break\\n    assert not (river is None)\\n\\n    trav = (g == int(river)) | (g == int(mover[\\\"col\\\"])) | (g == int(dest[\\\"col\\\"]))\\n\\n    # Feasible top-left placements: NxN window fully inside trav.\\n    h2 = int(H - n + 1)\\n    w2 = int(W - n + 1)\\n    assert not (h2 <= 0 or w2 <= 0)\\n    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\\n\\n    feasible = np.zeros((h2, w2), dtype=bool)\\n    for r in range(h2):\\n        for c in range(w2):\\n            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\\n                feasible[int(r), int(c)] = True\\n    assert not (not bool(feasible[int(sr), int(sc)]))\\n\\n    # BFS on placement grid.\\n    dist = -np.ones((h2, w2), dtype=int)\\n    q = deque([(int(sr), int(sc))])\\n    dist[int(sr), int(sc)] = 0\\n    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\\n    while q:\\n        r, c = q.popleft()\\n        for dr2, dc2 in DIR4:\\n            rr = int(r + dr2)\\n            cc = int(c + dc2)\\n            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\\n                dist[rr, cc] = int(dist[int(r), int(c)] + 1)\\n                q.append((int(rr), int(cc)))\\n\\n    # Pick target.\\n    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\\n        tr, tc = int(dr), int(dc)\\n    else:\\n        best = -1\\n        tr, tc = int(sr), int(sc)\\n        for r in range(h2):\\n            for c in range(w2):\\n                if int(dist[int(r), int(c)]) > best:\\n                    best = int(dist[int(r), int(c)])\\n                    tr, tc = int(r), int(c)\\n\\n    out = g.copy()\\n    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\\n    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\\\"col\\\"])\\n    return out\\n\\n\\n# --- Generator ---\\n\\n_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2\\n\\n\\ndef _bfs_placement(feasible, sr, sc):\\n    h2, w2 = feasible.shape\\n    dist = -np.ones((h2, w2), dtype=int)\\n    dist[sr, sc] = 0\\n    q = deque([(sr, sc)])\\n    while q:\\n        r, c = q.popleft()\\n        for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\\n            rr, cc = r + dr, c + dc\\n            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:\\n                dist[rr, cc] = dist[r, c] + 1\\n                q.append((rr, cc))\\n    return dist\\n\\n\\ndef _hamiltonian_walk(rows, cols, start, end):\\n    total = rows * cols\\n    best_path = None\\n    best_len = 0\\n    for _attempt in range(80):\\n        visited = {start}\\n        path = [start]\\n        cur = start\\n        while True:\\n            if cur == end and len(path) >= total * 0.7:\\n                if len(path) > best_len:\\n                    best_path = list(path)\\n                    best_len = len(path)\\n                break\\n            neighbors = []\\n            for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\\n                nr, nc = cur[0] + dr, cur[1] + dc\\n                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:\\n                    neighbors.append((nr, nc))\\n            if not neighbors:\\n                break\\n            valid = []\\n            for nb in neighbors:\\n                if nb == end:\\n                    valid.append(nb)\\n                    continue\\n                test_visited = visited | {nb}\\n                seen = {end}\\n                q = deque([end])\\n                while q:\\n                    cr, cc = q.popleft()\\n                    for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\\n                        nr2, nc2 = cr + dr2, cc + dc2\\n                        if (0 <= nr2 < rows and 0 <= nc2 < cols and\\n                                (nr2, nc2) not in test_visited and (nr2, nc2) not in seen):\\n                            seen.add((nr2, nc2))\\n                            q.append((nr2, nc2))\\n                for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\\n                    ar, ac = nb[0] + dr2, nb[1] + dc2\\n                    if (0 <= ar < rows and 0 <= ac < cols and\\n                            (ar, ac) not in test_visited and (ar, ac) in seen):\\n                        valid.append(nb)\\n                        break\\n            if not valid:\\n                break\\n            random.shuffle(valid)\\n            nxt = valid[0]\\n            visited.add(nxt)\\n            path.append(nxt)\\n            cur = nxt\\n        if best_path and best_len >= total * 0.85:\\n            break\\n    return best_path\\n\\n\\ndef _render_channel(grid, path, n, offsets_r, offsets_c):\\n    pixel_pos = []\\n    for cr, cc in path:\\n        pr, pc = offsets_r[cr], offsets_c[cc]\\n        pixel_pos.append((pr, pc))\\n        grid[pr:pr + n, pc:pc + n] = _RIVER\\n    for i in range(len(path) - 1):\\n        pr1, pc1 = pixel_pos[i]\\n        pr2, pc2 = pixel_pos[i + 1]\\n        if pr1 == pr2:\\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\\n            grid[pr1:pr1 + n, c_lo:c_hi] = _RIVER\\n        else:\\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\\n            grid[r_lo:r_hi, pc1:pc1 + n] = _RIVER\\n    return pixel_pos\\n\\n\\ndef _add_chokepoint(grid, pixel_pos_i, pixel_pos_j, n, direction):\\n    H, W = grid.shape\\n    pr1, pc1 = pixel_pos_i\\n    pr2, pc2 = pixel_pos_j\\n    narrow_w = random.randint(1, n - 1)\\n    remove = n - narrow_w\\n    side = random.randint(0, 1)\\n\\n    if direction == 'h':\\n        c_lo = min(pc1, pc2) + n\\n        c_hi = max(pc1, pc2)\\n        if c_hi <= c_lo:\\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\\n        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))\\n        if hold_len < 1:\\n            hold_len = 1\\n        total_len = 2 * remove + hold_len\\n        c_mid = (c_lo + c_hi) // 2\\n        c_start = max(c_lo, c_mid - total_len // 2)\\n        for step in range(total_len):\\n            c = c_start + step\\n            if c < 0 or c >= W:\\n                continue\\n            if step < remove:\\n                depth = step + 1\\n            elif step >= total_len - remove:\\n                depth = total_len - step\\n            else:\\n                depth = remove\\n            for k in range(depth):\\n                rr = pr1 + k if side == 0 else pr1 + n - 1 - k\\n                if 0 <= rr < H and 0 <= c < W:\\n                    grid[rr, c] = _BG\\n    else:\\n        r_lo = min(pr1, pr2) + n\\n        r_hi = max(pr1, pr2)\\n        if r_hi <= r_lo:\\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\\n        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))\\n        if hold_len < 1:\\n            hold_len = 1\\n        total_len = 2 * remove + hold_len\\n        r_mid = (r_lo + r_hi) // 2\\n        r_start = max(r_lo, r_mid - total_len // 2)\\n        for step in range(total_len):\\n            r = r_start + step\\n            if r < 0 or r >= H:\\n                continue\\n            if step < remove:\\n                depth = step + 1\\n            elif step >= total_len - remove:\\n                depth = total_len - step\\n            else:\\n                depth = remove\\n            for k in range(depth):\\n                cc = pc1 + k if side == 0 else pc1 + n - 1 - k\\n                if 0 <= r < H and 0 <= cc < W:\\n                    grid[r, cc] = _BG\\n\\n\\ndef _river_connected(grid):\\n    mask = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)\\n    if not mask.any():\\n        return False\\n    labeled, num = scipy_label(mask.astype(int))\\n    return num == 1\\n\\n\\ndef _compute_offsets(G, n, num_coarse):\\n    if num_coarse == 1:\\n        return [1]\\n    first = 1\\n    last = G - n - 1\\n    if last < first:\\n        return None\\n    step = (last - first) / (num_coarse - 1)\\n    return [int(round(first + i * step)) for i in range(num_coarse)]\\n\\n\\ndef _gen_attempt():\\n    reached = random.random() < 0.5\\n    n = random.choice([1, 2, 3, 4]) if reached else random.choice([2, 3, 4])\\n\\n    min_size = max(10, 5 * n)\\n    if min_size > 20:\\n        return None\\n    G = random.randint(min_size, 20)\\n    H = W = G\\n\\n    min_spacing = n + 1\\n    max_coarse = max(3, (G - 2) // min_spacing)\\n    coarse_dim = random.randint(3, min(6, max_coarse))\\n    coarse_rows = coarse_cols = coarse_dim\\n\\n    offsets_r = _compute_offsets(G, n, coarse_rows)\\n    offsets_c = _compute_offsets(G, n, coarse_cols)\\n    if offsets_r is None or offsets_c is None:\\n        return None\\n    for i in range(len(offsets_r) - 1):\\n        if offsets_r[i + 1] - offsets_r[i] < n:\\n            return None\\n    for i in range(len(offsets_c) - 1):\\n        if offsets_c[i + 1] - offsets_c[i] < n:\\n            return None\\n\\n    edge_cells = set()\\n    for c in range(coarse_cols):\\n        edge_cells.add((0, c))\\n        edge_cells.add((coarse_rows - 1, c))\\n    for r in range(1, coarse_rows - 1):\\n        edge_cells.add((r, 0))\\n        edge_cells.add((r, coarse_cols - 1))\\n    edge_cells = list(edge_cells)\\n    random.shuffle(edge_cells)\\n    start_coarse = edge_cells[0]\\n    far = sorted(edge_cells, key=lambda e: -(abs(e[0] - start_coarse[0]) + abs(e[1] - start_coarse[1])))\\n    end_coarse = far[0] if far[0] != start_coarse else far[1]\\n\\n    walk = _hamiltonian_walk(coarse_rows, coarse_cols, start_coarse, end_coarse)\\n    if walk is None or len(walk) < 4:\\n        return None\\n    if len(set(cr for cr, _ in walk)) < coarse_rows or len(set(cc for _, cc in walk)) < coarse_cols:\\n        return None\\n\\n    grid = np.full((H, W), _BG, dtype=int)\\n    pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)\\n\\n    mask = (grid != _BG)\\n    if np.any(mask, axis=1).sum() / H < 0.70 or np.any(mask, axis=0).sum() / W < 0.70:\\n        return None\\n\\n    mover_r, mover_c = pixel_pos[0]\\n    dest_r, dest_c = pixel_pos[-1]\\n\\n    # Extend dest to touch grid edge\\n    def _extend_to_edge(pr, pc):\\n        candidates = []\\n        for direction in ['top', 'bottom', 'left', 'right']:\\n            if direction == 'top':\\n                dist = pr\\n                if dist == 0:\\n                    candidates.append((0, pc, 0))\\n                    continue\\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr) for c in range(pc, pc + n) if c < W):\\n                    candidates.append((0, pc, dist))\\n            elif direction == 'bottom':\\n                dist = H - (pr + n)\\n                if dist == 0:\\n                    candidates.append((pr, pc, 0))\\n                    continue\\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr + n, H) for c in range(pc, pc + n) if c < W):\\n                    candidates.append((H - n, pc, dist))\\n            elif direction == 'left':\\n                dist = pc\\n                if dist == 0:\\n                    candidates.append((pr, 0, 0))\\n                    continue\\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc) if r < H):\\n                    candidates.append((pr, 0, dist))\\n            elif direction == 'right':\\n                dist = W - (pc + n)\\n                if dist == 0:\\n                    candidates.append((pr, pc, 0))\\n                    continue\\n                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc + n, W) if r < H):\\n                    candidates.append((pr, W - n, dist))\\n        if not candidates:\\n            return None\\n        candidates.sort(key=lambda x: x[2])\\n        return candidates[0][:2]\\n\\n    result = _extend_to_edge(dest_r, dest_c)\\n    if result is None:\\n        return None\\n    new_dest_r, new_dest_c = result\\n    if new_dest_r != dest_r:\\n        r_lo, r_hi = min(new_dest_r, dest_r), max(new_dest_r, dest_r) + n\\n        grid[r_lo:r_hi, dest_c:dest_c + n] = _RIVER\\n    if new_dest_c != dest_c:\\n        c_lo, c_hi = min(new_dest_c, dest_c), max(new_dest_c, dest_c) + n\\n        grid[dest_r:dest_r + n, c_lo:c_hi] = _RIVER\\n    dest_r, dest_c = new_dest_r, new_dest_c\\n    if not (dest_r == 0 or dest_r + n == H or dest_c == 0 or dest_c + n == W):\\n        return None\\n\\n    # Mover: near edge but not touching\\n    touching = (mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W)\\n    if touching:\\n        if mover_r == 0:\\n            grid[0, mover_c:mover_c + n] = _RIVER; mover_r = 1\\n        elif mover_r + n == H:\\n            grid[H - 1, mover_c:mover_c + n] = _RIVER; mover_r = H - n - 1\\n        elif mover_c == 0:\\n            grid[mover_r:mover_r + n, 0] = _RIVER; mover_c = 1\\n        elif mover_c + n == W:\\n            grid[mover_r:mover_r + n, W - 1] = _RIVER; mover_c = W - n - 1\\n    if mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W:\\n        return None\\n    if min(mover_r, H - (mover_r + n), mover_c, W - (mover_c + n)) > 2:\\n        return None\\n\\n    grid[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER\\n    grid[dest_r:dest_r + n, dest_c:dest_c + n] = _RIVER\\n\\n    # Chokepoints for stuck case\\n    if not reached and n >= 2:\\n        num_choke = random.randint(1, min(3, len(walk) - 2))\\n        min_seg = max(1, len(walk) // 4)\\n        available = list(range(min_seg, len(walk) - 1))\\n        random.shuffle(available)\\n        for seg_idx in available[:num_choke]:\\n            pr1, pc1 = pixel_pos[seg_idx]\\n            pr2, pc2 = pixel_pos[min(seg_idx + 1, len(pixel_pos) - 1)]\\n            direction = 'h' if pr1 == pr2 else 'v'\\n            _add_chokepoint(grid, (pr1, pc1), (pr2, pc2), n, direction)\\n        if not _river_connected(grid):\\n            return None\\n\\n    grid[mover_r:mover_r + n, mover_c:mover_c + n] = _MOVER\\n    grid[dest_r:dest_r + n, dest_c:dest_c + n] = _DEST\\n\\n    trav = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)\\n    h2, w2 = H - n + 1, W - n + 1\\n    feasible = np.zeros((h2, w2), dtype=bool)\\n    for r in range(h2):\\n        for c in range(w2):\\n            if trav[r:r + n, c:c + n].all():\\n                feasible[r, c] = True\\n    if not feasible[mover_r, mover_c]:\\n        return None\\n\\n    dist = _bfs_placement(feasible, mover_r, mover_c)\\n    dest_ok = (0 <= dest_r < h2 and 0 <= dest_c < w2 and\\n               feasible[dest_r, dest_c] and dist[dest_r, dest_c] >= 0)\\n    if reached and not dest_ok:\\n        return None\\n    if not reached and dest_ok:\\n        return None\\n\\n    if dest_ok:\\n        tr, tc = dest_r, dest_c\\n    else:\\n        best_d = -1\\n        tr, tc = mover_r, mover_c\\n        for r in range(h2):\\n            for c in range(w2):\\n                if dist[r, c] > best_d:\\n                    best_d = dist[r, c]\\n                    tr, tc = r, c\\n\\n    output = grid.copy()\\n    output[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER\\n    output[tr:tr + n, tc:tc + n] = _MOVER\\n\\n    if not np.array_equal(main(grid), output):\\n        return None\\n    return grid\\n\\n\\ndef generate_input():\\n    for _ in range(300):\\n        result = _gen_attempt()\\n        if result is not None:\\n            return result\\n    raise RuntimeError(\\\"Failed to generate valid input after 300 attempts\\\")\\n\\n\\nFILE:/home/lixinyu/snap/new/ARC_code/train/cf5fd0ad.py\\ndef main(grid: np.ndarray) -> np.ndarray:\\n    \\\"\\\"\\\"Build a four-quadrant rotational tiling of the input square.\\n\\n    Input structure\\n    - The input is a square grid treated as one complete sprite.\\n\\n    Rule\\n    - Each output quadrant is a 2x2 repetition of a rotated copy of the whole input.\\n    - The quadrant rotations are upper-left 180 degrees, upper-right 90 degrees\\n      clockwise, lower-left 90 degrees counterclockwise, and lower-right unchanged.\\n\\n    Key insight\\n    - The output is a 4x4 grid of original-size blocks, not a per-pixel scale-up.\\n    \\\"\\\"\\\"\\n    g = np.asarray(grid, dtype=int)\\n    assert g.ndim == 2\\n    h, w = g.shape\\n    assert h == w and h > 0\\n\\n    upper_left = _repeat_2x2(np.rot90(g, 2))\\n    upper_right = _repeat_2x2(np.rot90(g, -1))\\n    lower_left = _repeat_2x2(np.rot90(g, 1))\\n    lower_right = _repeat_2x2(g)\\n\\n    return np.block([[upper_left, upper_right], [lower_left, lower_right]])\\n\\n# --------------- generator (att2) ---------------\\n\\n# Grid and palette bounds.\\n_GEN_CF5FD0AD_BG_COLOR = 8\\n_GEN_CF5FD0AD_GRID_SIZES = (3, 4, 5)\\n_GEN_CF5FD0AD_NON_BG_COLORS = (1, 2, 3, 4, 5, 6, 7, 9)\\n\\n# Sparse cell sampling and retry budget.\\n_GEN_CF5FD0AD_CELL_COUNT_RANGE = (1, 4)\\n_GEN_CF5FD0AD_MAX_DISTINCT_COLORS = 3\\n_GEN_CF5FD0AD_RETRY_LIMIT = 300\\n\\ndef _gen_cf5fd0ad_expected_output(grid: np.ndarray) -> np.ndarray:\\n    upper_left = np.tile(np.rot90(grid, 2), (2, 2))\\n    upper_right = np.tile(np.rot90(grid, -1), (2, 2))\\n    lower_left = np.tile(np.rot90(grid, 1), (2, 2))\\n    lower_right = np.tile(grid, (2, 2))\\n    return np.block([[upper_left, upper_right], [lower_left, lower_right]])\\n\\n\\ndef _gen_cf5fd0ad_sparse_grid() -> np.ndarray:\\n    n = random.choice(_GEN_CF5FD0AD_GRID_SIZES)\\n    grid = np.full((n, n), _GEN_CF5FD0AD_BG_COLOR, dtype=int)\\n    cell_count = random.randint(*_GEN_CF5FD0AD_CELL_COUNT_RANGE)\\n    distinct_count = random.randint(1, min(_GEN_CF5FD0AD_MAX_DISTINCT_COLORS, cell_count))\\n    colors = random.sample(_GEN_CF5FD0AD_NON_BG_COLORS, distinct_count)\\n    positions = random.sample(range(n * n), cell_count)\\n    assigned_colors = colors[:]\\n    assigned_colors.extend(random.choice(colors) for _ in range(cell_count - distinct_count))\\n    random.shuffle(assigned_colors)\\n\\n    for pos, color in zip(positions, assigned_colors):\\n        grid[pos // n, pos % n] = color\\n    return grid\\n\\n\\ndef _gen_attempt() -> np.ndarray | None:\\n    grid = _gen_cf5fd0ad_sparse_grid()\\n    expected = _gen_cf5fd0ad_expected_output(grid)\\n    if not np.array_equal(main(grid), expected):\\n        return None\\n    return grid\\n\\n\\ndef generate_input() -> np.ndarray:\\n    for _ in range(_GEN_CF5FD0AD_RETRY_LIMIT):\\n        grid = _gen_attempt()\\n        if grid is not None:\\n            return grid\\n    raise RuntimeError('failed to generate cf5fd0ad input')\\nFILE:/home/lixinyu/snap/new/ARC_code/eval/71e489b6.py\\ndef main(grid: np.ndarray) -> np.ndarray:\\n    \\\"\\\"\\\"\\n    Highlight black defects in blue foreground by surrounding them with orange.\\n\\n    Input structure:\\n    - Blue (1) foreground on black (0) bg; small black holes or protrusions within blue regions; occasional thin blue spurs into black areas.\\n\\n    Rule:\\n    - Thin blue pixels mostly surrounded by black are absorbed into the background.\\n    - Small black components (≤3 cells) and leaf pixels of larger black components are \\\"defects.\\\"\\n    - Each defect gets an orange (7) 8-neighbor halo; the defect pixels themselves stay black.\\n\\n    Key insight: Only structural anomalies—tiny isolated patches and dangling endpoints—are marked, not bulk black regions.\\n    \\\"\\\"\\\"\\n    g = np.array(grid, dtype=int)\\n    H, W = g.shape\\n\\n    hole_col = 0\\n    border_col = 7\\n\\n    # STEP 0) Fill blue (1) pixels to black (0) when mostly surrounded by black.\\n    base = g.copy()\\n    for r in range(H):\\n        for c in range(W):\\n            if int(base[r, c]) != 1:\\n                continue\\n            nb = 0\\n            oob = 0\\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\\n                rr = int(r + dr)\\n                cc = int(c + dc)\\n                if not (0 <= rr < H and 0 <= cc < W):\\n                    oob += 1\\n                    continue\\n                if int(base[rr, cc]) == int(hole_col):\\n                    nb += 1\\n            # only count outside-as-black for corners (two out-of-bounds sides)\\n            if oob >= 2:\\n                nb += int(oob)\\n            if nb >= 3:\\n                base[int(r), int(c)] = int(hole_col)\\n\\n    # STEP 1/2) Collect target black pixels (they must remain black).\\n    preserve: set[tuple[int, int]] = set()\\n    comps = components_mask(base == int(hole_col), connectivity=4)\\n    for coords in comps:\\n        pts_list = [(int(r), int(c)) for r, c in coords]\\n        if len(pts_list) <= 3:\\n            preserve.update(pts_list)\\n            continue\\n        for r, c in pts_list:\\n            nb = 0\\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\\n                rr = int(r + dr)\\n                cc = int(c + dc)\\n                if 0 <= rr < H and 0 <= cc < W and int(base[rr, cc]) == int(hole_col):\\n                    nb += 1\\n            if nb <= 1:\\n                preserve.add((int(r), int(c)))\\n\\n    # STEP 3) Paint orange in the Chebyshev-1 neighborhood of each target set/pixel.\\n    out = base.copy()\\n    for coords in comps:\\n        pts_list = [(int(r), int(c)) for r, c in coords]\\n        targets = pts_list if len(pts_list) <= 3 else [p for p in pts_list if p in preserve]\\n        for r, c in targets:\\n            for dr in (-1, 0, 1):\\n                for dc in (-1, 0, 1):\\n                    rr = int(r + dr)\\n                    cc = int(c + dc)\\n                    if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in preserve:\\n                        out[rr, cc] = int(border_col)\\n\\n    # Ensure target black pixels remain black.\\n    for r, c in preserve:\\n        out[int(r), int(c)] = int(hole_col)\\n\\n    return out\\n\\n# --------------- generator (att1) ---------------\\n\\n# ── CFG: tunable generation parameters ──────────────────────────────\\nGRID_H_RANGE = (16, 19)           # canvas height bounds\\nGRID_W_RANGE = (16, 19)           # canvas width bounds\\nMIN_BLUE_REGION = 30              # minimum blue region size (cells)\\nMIN_BLACK_REGION = 20             # minimum black region size (cells)\\nPARTITION_STYLES = ['h_stripes', 'rect_inset', 'l_shape']\\nSTRIPE_CUTS_RANGE = (1, 3)       # number of horizontal cuts for h_stripes\\nCUT_MARGIN = 3                   # min distance from grid edge for cuts\\nINSET_MARGIN = 2                 # padding from edge for rect_inset\\nINNER_INSET_MIN_GAP = 6          # min dimension for nested inset\\nINNER_INSET_PROB = 0.5           # probability of nested inset\\nDEFECT_COUNT_RANGE = (2, 9)      # number of defect holes to place\\nDEFECT_SIZE_WEIGHTS = [6, 2, 1]  # weights for defect sizes [1, 2, 3]\\nDEFECT_CLEARANCE = 2             # min Chebyshev distance between defects\\nDEFECT_PLACE_TRIES = 50          # retries per defect placement\\nLEAF_COUNT_RANGE = (0, 4)        # number of leaf protrusions\\nSPUR_COUNT_RANGE = (2, 6)        # number of blue spurs in black regions\\nMIN_DEFECTS = 2                  # reject grid if fewer defects placed\\nMIN_SPURS = 2                    # reject grid if fewer spurs placed\\nMAX_GEN_ATTEMPTS = 300           # outer retry limit\\n\\n\\ndef _nearby(r: int, c: int, dist: int, ref: set) -> bool:\\n    \\\"\\\"\\\"Return True if any pixel in `ref` is within Chebyshev distance `dist`.\\\"\\\"\\\"\\n    for dr in range(-dist, dist + 1):\\n        for dc in range(-dist, dist + 1):\\n            if (r + dr, c + dc) in ref:\\n                return True\\n    return False\\n\\n\\ndef _exclusion_zone(pixels, dist: int) -> set:\\n    \\\"\\\"\\\"Return the set of all coords within Chebyshev `dist` of any pixel.\\\"\\\"\\\"\\n    zone = set()\\n    for r, c in pixels:\\n        for dr in range(-dist, dist + 1):\\n            for dc in range(-dist, dist + 1):\\n                zone.add((r + dr, c + dc))\\n    return zone\\n\\n\\ndef _build_partition(H: int, W: int) -> np.ndarray:\\n    \\\"\\\"\\\"Create an H x W grid partitioned into blue (1) and black (0) regions.\\\"\\\"\\\"\\n    grid = np.zeros((H, W), dtype=int)\\n    style = random.choice(PARTITION_STYLES)\\n\\n    if style == 'h_stripes':\\n        n_cuts = random.randint(*STRIPE_CUTS_RANGE)\\n        cuts = sorted(random.sample(\\n            range(CUT_MARGIN, H - CUT_MARGIN), min(n_cuts, H - 2 * CUT_MARGIN)))\\n        boundaries = [0] + cuts + [H]\\n        first_color = random.randint(0, 1)\\n        for i in range(len(boundaries) - 1):\\n            grid[boundaries[i]:boundaries[i + 1], :] = (first_color + i) % 2\\n\\n    elif style == 'rect_inset':\\n        bg = random.randint(0, 1)\\n        grid[:, :] = bg\\n        r0 = random.randint(INSET_MARGIN, H // 3)\\n        r1 = random.randint(2 * H // 3, H - CUT_MARGIN)\\n        c0 = random.randint(INSET_MARGIN, W // 3)\\n        c1 = random.randint(2 * W // 3, W - CUT_MARGIN)\\n        grid[r0:r1 + 1, c0:c1 + 1] = 1 - bg\\n        if (r1 - r0 > INNER_INSET_MIN_GAP and c1 - c0 > INNER_INSET_MIN_GAP\\n                and random.random() < INNER_INSET_PROB):\\n            ir0 = random.randint(r0 + 2, r0 + (r1 - r0) // 3)\\n            ir1 = random.randint(r0 + 2 * (r1 - r0) // 3, r1 - 2)\\n            ic0 = random.randint(c0 + 2, c0 + (c1 - c0) // 3)\\n            ic1 = random.randint(c0 + 2 * (c1 - c0) // 3, c1 - 2)\\n            grid[ir0:ir1 + 1, ic0:ic1 + 1] = bg\\n\\n    elif style == 'l_shape':\\n        bg = random.randint(0, 1)\\n        grid[:, :] = bg\\n        vc = random.randint(W // 3, 2 * W // 3)\\n        if random.random() < 0.5:\\n            grid[:, :vc] = 1 - bg\\n            hc = random.randint(H // 3, 2 * H // 3)\\n            grid[:hc, vc:] = 1 - bg\\n        else:\\n            grid[:, vc:] = 1 - bg\\n            hc = random.randint(H // 3, 2 * H // 3)\\n            grid[hc:, :vc] = 1 - bg\\n\\n    return grid\\n\\n\\ndef _find_interior_blue(grid: np.ndarray) -> list[tuple[int, int]]:\\n    \\\"\\\"\\\"Return blue pixels whose 4-neighbors are all blue or out-of-bounds.\\\"\\\"\\\"\\n    H, W = grid.shape\\n    blue = grid == 1\\n    # A blue pixel is interior if no in-bounds 4-neighbor is non-blue.\\n    eroded = blue.copy()\\n    eroded[:-1, :] &= blue[1:, :]   # neighbor below\\n    eroded[1:, :]  &= blue[:-1, :]  # neighbor above\\n    eroded[:, :-1] &= blue[:, 1:]   # neighbor right\\n    eroded[:, 1:]  &= blue[:, :-1]  # neighbor left\\n    rs, cs = np.where(eroded)\\n    coords = list(zip(rs.tolist(), cs.tolist()))\\n    random.shuffle(coords)\\n    return coords\\n\\n\\ndef _place_defects(grid: np.ndarray, interior_blue: list) -> tuple[set, int]:\\n    \\\"\\\"\\\"Place 2-9 small black defects in blue-region interiors.\\n\\n    Returns (defect_pixels, defects_placed). Modifies `interior_blue` in place.\\n    \\\"\\\"\\\"\\n    H, W = grid.shape\\n    n_defects = random.randint(*DEFECT_COUNT_RANGE)\\n    defect_pixels: set[tuple[int, int]] = set()\\n    interior_set = set(interior_blue)\\n    defects_placed = 0\\n\\n    for _ in range(n_defects):\\n        if not interior_blue:\\n            break\\n        defect_size = random.choices([1, 2, 3], weights=DEFECT_SIZE_WEIGHTS)[0]\\n\\n        placed = False\\n        for _try in range(DEFECT_PLACE_TRIES):\\n            if not interior_blue:\\n                break\\n            seed_r, seed_c = interior_blue[random.randint(0, len(interior_blue) - 1)]\\n\\n            if _nearby(seed_r, seed_c, DEFECT_CLEARANCE, defect_pixels):\\n                continue\\n\\n            # Grow defect from seed\\n            defect = [(seed_r, seed_c)]\\n            if defect_size > 1:\\n                dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]\\n                random.shuffle(dirs)\\n                for dr, dc in dirs:\\n                    nr, nc = seed_r + dr, seed_c + dc\\n                    if (nr, nc) not in interior_set or (nr, nc) in defect_pixels:\\n                        continue\\n                    # Check neighbor is surrounded by blue (except the seed)\\n                    ok = True\\n                    for dr2, dc2 in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\\n                        rr, cc = nr + dr2, nc + dc2\\n                        if (rr, cc) == (seed_r, seed_c):\\n                            continue\\n                        if 0 <= rr < H and 0 <= cc < W:\\n                            if grid[rr, cc] != 1 or (rr, cc) in defect_pixels:\\n                                ok = False\\n                                break\\n                    if ok and not _nearby(nr, nc, DEFECT_CLEARANCE, defect_pixels):\\n                        defect.append((nr, nc))\\n                        if len(defect) >= defect_size:\\n                            break\\n\\n            # Validate: every non-defect 4-neighbor of every defect pixel must be blue\\n            defect_set = set(defect)\\n            valid = True\\n            for r, c in defect:\\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\\n                    rr, cc = r + dr, c + dc\\n                    if (rr, cc) in defect_set:\\n                        continue\\n                    if 0 <= rr < H and 0 <= cc < W:\\n                        if grid[rr, cc] != 1 or (rr, cc) in defect_pixels:\\n                            valid = False\\n                            break\\n                if not valid:\\n                    break\\n\\n            if valid:\\n                defect_pixels.update(defect)\\n                defects_placed += 1\\n                placed = True\\n                remove = _exclusion_zone(defect, DEFECT_CLEARANCE)\\n                interior_blue[:] = [p for p in interior_blue if p not in remove]\\n                interior_set -= remove\\n                break\\n\\n    return defect_pixels, defects_placed\\n\\n\\ndef _place_leaves(grid: np.ndarray, defect_pixels: set) -> set:\\n    \\\"\\\"\\\"Place 0-4 leaf protrusions from large black regions into blue regions.\\\"\\\"\\\"\\n    H, W = grid.shape\\n    n_leaves = random.randint(*LEAF_COUNT_RANGE)\\n    leaf_pixels: set[tuple[int, int]] = set()\\n\\n    black_comps = components_mask(grid == 0, connectivity=4)\\n    large_black = [c for c in black_comps if len(c) > 3]\\n\\n    for _ in range(n_leaves):\\n        if not large_black:\\n            break\\n        comp_set = set((int(r), int(c)) for r, c in random.choice(large_black))\\n\\n        # Find blue pixels adjacent to this component that would be valid leaves\\n        candidates = []\\n        for r, c in comp_set:\\n            for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\\n                rr, cc = r + dr, c + dc\\n                if not (0 <= rr < H and 0 <= cc < W) or grid[rr, cc] != 1:\\n                    continue\\n                if (rr, cc) in defect_pixels or (rr, cc) in leaf_pixels:\\n                    continue\\n                # Count black 4-neighbors of the candidate pixel\\n                black_n = sum(\\n                    1 for dr2, dc2 in [(-1, 0), (1, 0), (0, -1), (0, 1)]\\n                    if 0 <= rr + dr2 < H and 0 <= cc + dc2 < W\\n                    and (grid[rr + dr2, cc + dc2] == 0 or (rr + dr2, cc + dc2) in leaf_pixels))\\n                if black_n == 1:\\n                    candidates.append((rr, cc))\\n\\n        if candidates:\\n            lr, lc = random.choice(candidates)\\n            if not _nearby(lr, lc, DEFECT_CLEARANCE, defect_pixels):\\n                leaf_pixels.add((lr, lc))\\n                grid[lr, lc] = 0\\n\\n    return leaf_pixels\\n\\n\\ndef _build_halo(grid: np.ndarray, preserve: set) -> np.ndarray:\\n    \\\"\\\"\\\"Paint orange (7) Chebyshev-1 halo around preserve pixels; keep them black.\\\"\\\"\\\"\\n    H, W = grid.shape\\n    output = grid.copy()\\n    for r, c in preserve:\\n        for dr in range(-1, 2):\\n            for dc in range(-1, 2):\\n                rr, cc = r + dr, c + dc\\n                if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in preserve:\\n                    output[rr, cc] = 7\\n    for r, c in preserve:\\n        output[r, c] = 0\\n    return output\\n\\n\\ndef _find_spur_candidates(grid: np.ndarray, exclude: set) -> list[tuple[int, int]]:\\n    \\\"\\\"\\\"Find black pixels eligible to become blue spurs (solver's STEP 0 absorbs them).\\n\\n    A pixel qualifies if it has >= 3 effective black 4-neighbors, matching the\\n    solver's absorption logic (OOB counts as black only at corners with >= 2 OOB sides).\\n    \\\"\\\"\\\"\\n    H, W = grid.shape\\n    black = grid == 0\\n\\n    # Count in-bounds black 4-neighbors via shifts\\n    nb = np.zeros((H, W), dtype=int)\\n    nb[:-1, :] += black[1:, :]\\n    nb[1:, :]  += black[:-1, :]\\n    nb[:, :-1] += black[:, 1:]\\n    nb[:, 1:]  += black[:, :-1]\\n\\n    # Count out-of-bounds sides\\n    oob = np.zeros((H, W), dtype=int)\\n    oob[0, :] += 1; oob[-1, :] += 1; oob[:, 0] += 1; oob[:, -1] += 1\\n\\n    # Effective count: add oob only when >= 2 (corner pixels)\\n    effective = nb.copy()\\n    effective[oob >= 2] += oob[oob >= 2]\\n\\n    # Eligible: black, effective >= 3, not in exclude set\\n    rs, cs = np.where(black & (effective >= 3))\\n    candidates = [(int(r), int(c)) for r, c in zip(rs, cs)\\n                  if (r, c) not in exclude]\\n    random.shuffle(candidates)\\n    return candidates\\n\\n\\ndef _gen_attempt() -> np.ndarray | None:\\n    \\\"\\\"\\\"Single attempt to generate a valid input grid for task 71e489b6.\\\"\\\"\\\"\\n    H = random.randint(*GRID_H_RANGE)\\n    W = random.randint(*GRID_W_RANGE)\\n\\n    # Step 1: Build region partition\\n    grid = _build_partition(H, W)\\n\\n    # Validate region sizes\\n    for comp in components_mask(grid == 1, connectivity=4):\\n        if len(comp) < MIN_BLUE_REGION:\\n            return None\\n    for comp in components_mask(grid == 0, connectivity=4):\\n        if len(comp) < MIN_BLACK_REGION:\\n            return None\\n\\n    # Step 2: Place defects\\n    interior_blue = _find_interior_blue(grid)