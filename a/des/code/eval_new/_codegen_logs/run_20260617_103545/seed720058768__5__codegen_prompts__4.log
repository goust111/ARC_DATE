comp[\\\"area\\\"])\\n        is_frame = (h >= 5) and (w >= 5) and (area < (h * w * 0.7))\\n        if is_frame:\\n            frames.append(comp)\\n        else:\\n            patterns.append(comp)\\n\\n    # Remove patterns from output.\\n    for p in patterns:\\n        for r, c in p[\\\"coords\\\"]:\\n            out[int(r), int(c)] = bg\\n\\n    # For each frame, count matching patterns and draw dots.\\n    for f in frames:\\n        col = int(f[\\\"color\\\"])\\n        num_patterns = sum(1 for p in patterns if int(p[\\\"color\\\"]) == col)\\n        if num_patterns <= 0:\\n            continue\\n\\n        r0, c0, r1, c1 = map(int, f[\\\"bbox\\\"])\\n        r_mid = (r0 + r1) // 2\\n        for i in range(int(num_patterns)):\\n            cc = int(c1 - 2 - 2 * i)\\n            if cc > int(c0):\\n                out[int(r_mid), int(cc)] = col\\n\\n    return out\\n\\n# --------------- generator (codex-att2) ---------------\\n\\n# --- layout geometry ---\\nFRAME_H = 5                    # frame height (rows)\\nFRAME_W = 11                   # frame width (cols)\\nFRAME_R0 = 1                   # top-left row of first frame\\nFRAME_C0 = 1                   # top-left col of all frames\\nFRAME_GAP = 2                  # bg rows between consecutive frames\\nGRID_W = 23                    # fixed grid width\\nRIGHT_C0 = 13                  # first column of the right (sprite) region\\nRIGHT_W = 9                    # width of the right region\\n\\n# --- structural counts ---\\nN_FRAMES_RANGE = (3, 5)        # [lo, hi) for number of frames\\nN_DISTRACTORS_RANGE = (1, 3)   # [lo, hi) for distractor sprite count\\nTOTAL_PATTERNS_RANGE = (5, 11) # [lo, hi) for total sprite count\\nMAX_DOTS_PER_FRAME = 4         # max dot tally inside one frame\\nBOTTOM_PAD_RANGE = (0, 7)      # [lo, hi) extra bg rows when n_frames==3\\n\\n# --- sprite shape ---\\nSPRITE_AREA_RANGE = (2, 9)     # [lo, hi) connected-cell count per sprite\\nSPRITE_MAX_H = 4               # max bbox height for sprite\\nSPRITE_MAX_W = 3               # max bbox width for sprite\\nSPRITE_PADDING = 1             # gap between placed sprites\\n\\n# --- retry budget ---\\nMAX_ATTEMPTS = 300\\n\\n\\ndef _frame_patch(color: int, bg: int, n_dots: int) -> np.ndarray:\\n    \\\"\\\"\\\"Build a FRAME_H x FRAME_W hollow rectangle with n_dots on the center row.\\\"\\\"\\\"\\n    patch = np.full((FRAME_H, FRAME_W), bg, dtype=int)\\n    patch[0, :] = color\\n    patch[-1, :] = color\\n    patch[:, 0] = color\\n    patch[:, -1] = color\\n    mid_r = FRAME_H // 2\\n    dot_cols = [FRAME_W - 3 - 2 * i for i in range(n_dots)]\\n    patch[mid_r, dot_cols] = color\\n    return patch\\n\\n\\ndef _sample_counts(rng: np.random.Generator, n_frames: int, total_match: int) -> list[int]:\\n    \\\"\\\"\\\"Distribute total_match sprites across n_frames, each capped at MAX_DOTS_PER_FRAME.\\\"\\\"\\\"\\n    counts = [0] * n_frames\\n    order = rng.permutation(n_frames)\\n    remaining = total_match\\n    for pos, idx in enumerate(order):\\n        frames_left = n_frames - pos - 1\\n        lo = max(0, remaining - MAX_DOTS_PER_FRAME * frames_left)\\n        hi = min(MAX_DOTS_PER_FRAME, remaining)\\n        val = int(rng.integers(lo, hi + 1))\\n        counts[int(idx)] = val\\n        remaining -= val\\n    return counts\\n\\n\\ndef _grow_sprite(rng: np.random.Generator, h: int, w: int, area: int) -> list[tuple[int, int]]:\\n    \\\"\\\"\\\"Grow a connected polyomino of the given area inside an h x w bounding box.\\\"\\\"\\\"\\n    seed = (int(rng.integers(0, h)), int(rng.integers(0, w)))\\n    cells = {seed}\\n    while len(cells) < area:\\n        frontier = []\\n        for r, c in cells:\\n            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\\n                nb = (r + dr, c + dc)\\n                if 0 <= nb[0] < h and 0 <= nb[1] < w and nb not in cells:\\n                    frontier.append(nb)\\n        cells.add(frontier[int(rng.integers(0, len(frontier)))])\\n    return list(cells)\\n\\n\\ndef _make_sprite(rng: np.random.Generator, color: int, bg: int) -> np.ndarray:\\n    \\\"\\\"\\\"Generate a small random connected sprite, tight-cropped to its bounding box.\\\"\\\"\\\"\\n    area = int(rng.integers(*SPRITE_AREA_RANGE))\\n    dims = [(h, w) for h in range(1, SPRITE_MAX_H + 1)\\n            for w in range(1, SPRITE_MAX_W + 1) if h * w >= area]\\n    h, w = dims[int(rng.integers(0, len(dims)))]\\n    cells = _grow_sprite(rng, h, w, area)\\n    rs, cs = zip(*cells)\\n    r_min, c_min = min(rs), min(cs)\\n    patch = np.full((max(rs) - r_min + 1, max(cs) - c_min + 1), bg, dtype=int)\\n    for r, c in cells:\\n        patch[r - r_min, c - c_min] = color\\n    return patch\\n\\n\\ndef _gen_attempt() -> np.ndarray | None:\\n    rng = np.random.default_rng()\\n\\n    # --- choose structure ---\\n    n_frames = int(rng.integers(*N_FRAMES_RANGE))\\n    n_distractors = int(rng.integers(*N_DISTRACTORS_RANGE))\\n    total_patterns = int(rng.integers(*TOTAL_PATTERNS_RANGE))\\n    total_match = total_patterns - n_distractors\\n\\n    palette = rng.choice(np.arange(10), size=1 + n_frames + n_distractors, replace=False)\\n    bg = int(palette[0])\\n    frame_colors = [int(x) for x in palette[1 : 1 + n_frames]]\\n    distractor_colors = [int(x) for x in palette[1 + n_frames :]]\\n\\n    counts = _sample_counts(rng, n_frames, total_match)\\n    bottom_pad = int(rng.integers(*BOTTOM_PAD_RANGE)) if n_frames == 3 else 0\\n    height = FRAME_R0 + n_frames * FRAME_H + (n_frames - 1) * FRAME_GAP + bottom_pad\\n\\n    # --- build output (frames with dots) ---\\n    out = np.full((height, GRID_W), bg, dtype=int)\\n    frame_rows: list[int] = []\\n    for i, (color, count) in enumerate(zip(frame_colors, counts)):\\n        r0 = FRAME_R0 + i * (FRAME_H + FRAME_GAP)\\n        frame_rows.append(r0)\\n        paste(out, _frame_patch(color, bg, count), r0, FRAME_C0)\\n\\n    # --- derive input (dots removed, sprites placed right) ---\\n    inp = out.copy()\\n    for r0, count in zip(frame_rows, counts):\\n        mid_r = r0 + FRAME_H // 2\\n        dot_cols = [FRAME_C0 + FRAME_W - 3 - 2 * i for i in range(count)]\\n        inp[mid_r, dot_cols] = bg\\n\\n    right_canvas = np.full((height, RIGHT_W), bg, dtype=int)\\n    pattern_colors = [c for c, n in zip(frame_colors, counts) for _ in range(n)]\\n    pattern_colors.extend(distractor_colors)\\n    rng.shuffle(pattern_colors)\\n\\n    try:\\n        for color in pattern_colors:\\n            sprite = _make_sprite(rng, color, bg)\\n            r0, c0 = random_free_location(\\n                right_canvas, sprite, transparent=bg,\\n                padding=SPRITE_PADDING, padding_connectivity=8,\\n            )\\n            paste(right_canvas, sprite, r0, c0, transparent=bg)\\n    except ValueError:\\n        return None\\n\\n    paste(inp, right_canvas, 0, RIGHT_C0, transparent=bg)\\n    if np.array_equal(main(inp), out):\\n        return inp\\n    return None\\n\\n\\ndef generate_input() -> np.ndarray:\\n    for _ in range(MAX_ATTEMPTS):\\n        grid = _gen_attempt()\\n        if grid is not None:\\n            return grid\\n    raise RuntimeError(f\\\"failed to generate a valid input after {MAX_ATTEMPTS} attempts\\\")\\n---\\ndef generate_input() -> np.ndarray:\\n    for _ in range(MAX_ATTEMPTS):\\n        grid = _gen_attempt()\\n        if grid is not None:\\n            return grid\\n    raise RuntimeError(f\\\"failed to generate a valid input after {MAX_ATTEMPTS} attempts\\\")\\n====\\nimport numpy as np\\nfrom collections import Counter, deque\\n\\nfrom arc_utils import components_mask, get_bg, neighbors4, neighbors8\\nimport random\\ndef _components_mask(mask: np.ndarray, conn8: bool) -> list[list[tuple[int, int]]]:\\n    return [[(int(r), int(c)) for r, c in comp] for comp in components_mask(mask, connectivity=8 if conn8 else 4)]\\n\\n\\ndef _touches_border(pts: list[tuple[int, int]], h: int, w: int) -> bool:\\n    return any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)\\n\\n\\ndef _seed_pixels(g: np.ndarray, bg: int) -> list[tuple[int, int]]:\\n    h, w = g.shape\\n    vals, cnts = np.unique(g, return_counts=True)\\n    seeds: list[tuple[int, int]] = []\\n    for v, cnt in zip(vals, cnts):\\n        v = int(v)\\n        if v == bg or int(cnt) != 1:\\n            continue\\n        r, c = map(int, np.argwhere(g == v)[0])\\n        if r == 0 or c == 0 or r == h - 1 or c == w - 1:\\n            seeds.append((r, c))\\n    return seeds\\n\\n\\ndef _nonbg_component8_from(g: np.ndarray, start: tuple[int, int], bg: int) -> set[tuple[int, int]]:\\n    h, w = g.shape\\n    st = [start]\\n    vis = {start}\\n    while st:\\n        r, c = st.pop()\\n        for nr, nc in neighbors8(r, c):\\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in vis and int(g[nr, nc]) != bg:\\n                vis.add((nr, nc))\\n                st.append((nr, nc))\\n    return vis\\n\\n\\ndef main(grid: np.ndarray) -> np.ndarray:\\n    \\\"\\\"\\\"\\n    Fill enclosed regions along a line seeded by unique border pixels.\\n\\n    Input structure:\\n    - bg = most common color.\\n    - Colored lines/drawings on the grid.\\n    - Unique single-pixel colors on the grid border mark seed endpoints of each line.\\n\\n    Rule:\\n    - Each border seed pixel connects (8-connected) to a line drawing.\\n    - Find closed bg cavities whose boundary touches that line.\\n    - Flood-fill each such cavity with the seed pixel's color.\\n\\n    Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.\\n    \\\"\\\"\\\"\\n    g = np.asarray(grid, dtype=int)\\n    h, w = g.shape\\n    bg = get_bg(g)\\n\\n    out = g.copy()\\n\\n    # Precompute background regions (4-connected). Exclude those containing background corners as \\\"outside\\\".\\n    bg_comps = _components_mask(g == bg, conn8=False)\\n    regions = []  # list of (set_pts, boundary_set, touches_border, size)\\n    for pts in bg_comps:\\n        region = set(pts)\\n        touches = _touches_border(pts, h, w)\\n        boundary = set()\\n        for r, c in region:\\n            for nr, nc in neighbors4(r, c):\\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:\\n                    boundary.add((nr, nc))\\n        regions.append((region, boundary, touches, len(region)))\\n\\n    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}\\n    outside_idxs = set()\\n    for i, (reg, _, _, _) in enumerate(regions):\\n        if any(p in reg for p in corners if int(g[p]) == bg):\\n            outside_idxs.add(i)\\n\\n    cavities = []\\n    for i, (reg, bnd, _, _) in enumerate(regions):\\n        if i in outside_idxs or not bnd:\\n            continue\\n        bcols = {int(g[p]) for p in bnd}\\n        cavities.append((reg, bnd, bcols))\\n\\n    for sr, sc in _seed_pixels(g, bg):\\n        seed_col = int(g[sr, sc])\\n\\n        neigh_cols = []\\n        for nr, nc in neighbors4(sr, sc):\\n            if 0 <= nr < h and 0 <= nc < w:\\n                v = int(g[nr, nc])\\n                if v != bg:\\n                    neigh_cols.append(v)\\n        assert neigh_cols, \\\"seed pixel must have at least one non-bg neighbor\\\"\\n        line_col = Counter(neigh_cols).most_common(1)[0][0]\\n\\n        # Trace the connected \\\"drawing\\\" reachable from the seed (8-connected, non-background).\\n        traced = _nonbg_component8_from(g, (sr, sc), bg)\\n\\n        for cav, boundary, bcols in cavities:\\n            if len(bcols) != 1:\\n                continue\\n            boundary_in_traced = boundary & traced\\n            if not boundary_in_traced:\\n                continue\\n\\n            # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.\\n            # This prevents filling regions that are only connected through other structures, not the line itself.\\n            ok = False\\n            for r, c in boundary_in_traced:\\n                for nr, nc in neighbors8(r, c):\\n                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:\\n                        ok = True\\n                        break\\n                if ok:\\n                    break\\n            if not ok:\\n                continue\\n\\n            for r, c in cav:\\n                if int(out[r, c]) == bg:\\n                    out[r, c] = seed_col\\n\\n    return out\\n\\n# --------------- generator (attempt_1_distractor_network) ---------------\\n\\n# ========================== CFG ==========================\\n# Canvas / grid\\nGRID_H_RANGE = (8, 30)             # grid height bounds\\nGRID_W_RANGE = (8, 30)             # grid width bounds\\nBG_COLORS = [0, 5]                 # background color choices\\n\\n# Seeds\\nSEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)\\nMIN_LINE_LEN = 4                   # discard attempt if line shorter than this\\nLINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)\\n\\n# Frame loops\\nFRAME_COLORS_MAX = 4               # max distinct frame colors\\nTOTAL_LOOPS_MAX = 9                # max total loops per grid\\nCAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)\\nDISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)\\nFRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge\\nFRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt\\nDISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement\\n\\n# Line growth\\nDIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps\\nDIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps\\nORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps\\nORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps\\nBORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells\\nBIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck\\n\\n# Distractor network\\nDISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames\\nDISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network\\nDISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range\\nDISTRACTOR_SOLO_MAX = 2            # max solo distractor frames\\nDISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network\\n\\n# Generation\\nGEN_RETRIES = 300                  # outer retry budget in generate_input()\\n# =========================================================\\n\\nDIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\\nORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\\n\\n\\ndef _in_bounds(h, w, r, c):\\n    return 0 <= r < h and 0 <= c < w\\n\\n\\n# ---------------------------------------------------------------------------\\n# Frame geometry\\n# ---------------------------------------------------------------------------\\n\\ndef _frame_ring_coords(r0, c0, ch, cw):\\n    \\\"\\\"\\\"Return (ring_coords, cavity_coords) for a rounded-rect frame.\\n\\n    Frame bbox is [r0, r0+ch+1] x [c0, c0+cw+1] (inclusive).\\n    Ring = bbox boundary minus 4 corners.\\n    \\\"\\\"\\\"\\n    H, W = ch + 2, cw + 2\\n    ring = []\\n    for dr in range(H):\\n        for dc in range(W):\\n            on_bdr = (dr == 0 or dr == H - 1 or dc == 0 or dc == W - 1)\\n            corner = (dr in (0, H - 1)) and (dc in (0, W - 1))\\n            if on_bdr and not corner:\\n                ring.append((r0 + dr, c0 + dc))\\n    cavity = [(r0 + 1 + dr, c0 + 1 + dc) for dr in range(ch) for dc in range(cw)]\\n    return ring, cavity\\n\\n\\ndef _validate_frame_placement(canvas, ring, cavity, line_col, h, w):\\n    \\\"\\\"\\\"Check that ring+cavity can be placed on canvas without conflicts.\\n\\n    Returns True if: ring and cavity cells are empty, no cavity cell is\\n    8-adjacent to line_col, ring is not 8-adjacent to foreign colors, and\\n    at least one ring cell is 8-adjacent to a line_col pixel.\\n    \\\"\\\"\\\"\\n    # Ring and cavity cells must all be empty\\n    for rr, cc in ring:\\n        if canvas[rr, cc] != -1:\\n            return False\\n    for rr, cc in cavity:\\n        if canvas[rr, cc] != -1:\\n            return False\\n\\n    # No cavity cell may be 8-adjacent to any line_col pixel\\n    for cr, cc in cavity:\\n        for nr, nc in neighbors8(cr, cc):\\n            if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:\\n                return False\\n\\n    # Ring must not be 8-adjacent to any non-bg, non-line_col pixel\\n    ring_set = set(ring)\\n    for rr, cc in ring:\\n        for nr, nc in neighbors8(rr, cc):\\n            if not _in_bounds(h, w, nr, nc) or (nr, nc) ireventing cross-edge overlap.\\n+#    - Rotated placements stay inside their original NxN placeholder bboxes because all sprites are square.\\n+#\\n+# e) Visual observability:\\n+#    - Humans can see two distinct regularities:\\n+#      1. identical source colors yield the same base shape but different in-frame orientations by quadrant;\\n+#      2. edge fragments must be paired across opposite sides, and the displayed legend silhouette often differs from\\n+#         the source sprite's raw orientation.\\n+#    - Neither rule depends on numeric color ids or hidden ordering.\\n+#\\n+# f) Visual cleanliness:\\n+#    - The central frame remains visually separate from the edge legends.\\n+#    - The split legends use thin boundary-aligned structures, leaving the remaining outside area for free sprites.\\n+#    - Each region carries one role only: frame/interior, edge legend, or free sprites.\\n+#\\n+# g) Color inferability and generator guarantees:\\n+#    - Target colors are still given explicitly by opposite-edge bars, so recoloring is structured rather than arbitrary.\\n+#    - The generator guarantees:\\n+#      * every legend silhouette is a non-identity d