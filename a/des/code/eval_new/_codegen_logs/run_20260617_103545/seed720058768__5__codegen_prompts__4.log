ries are protected from earlier fills.\\n  85: \\n  86:     Key insight: The L-shaped anchors sit on the marker diagonal; the fill goes on the opposite diagonal of the bounding box.\\n  87:     \\\"\\\"\\\"\\n  88:     g = np.asarray(grid, dtype=int)\\n  89:     h, w = g.shape\\n  90: \\n  91:     bg = get_bg(g)\\n  92:     legend_c, entries = _find_legend(g, bg)\\n  93:     assert entries, \\\"legend must contain at least one (marker, fill) entry\\\"\\n  94: \\n  95:     legend_mask = np.zeros_like(g, dtype=bool)\\n  96:     for r, _, _ in entries:\\n  97:         if 0 <= r < h and 0 <= legend_c < w:\\n  98:             legend_mask[r, legend_c] = True\\n  99:         if 0 <= r < h and 0 <= legend_c + 1 < w:\\n 100:             legend_mask[r, legend_c + 1] = True\\n 101: \\n 102:     out = g.copy()\\n 103: \\n 104:     marker_order = [m for _, m, _ in entries]\\n 105:     marker_set = set(marker_order)\\n 106: \\n 107:     # Process legend entries bottom -> top; earlier entries must not destroy later marker pixels.\\n 108:     for i, (_, marker, fill) in enumerate(entries):\\n 109:         eff_fill = int(fill)\\n 110:         marker_pts = set(map(tuple, np.argwhere((g == marker) & (~legend_mask))))\\n 111:         if len(marker_pts) < 2:\\n 112:             continue\\n 113: \\n 114:         rs = [r for r, _ in marker_pts]\\n 115:         cs = [c for _, c in marker_pts]\\n 116:         rmin, rmax = min(rs), max(rs)\\n 117:         cmin, cmax = min(cs), max(cs)\\n 118: \\n 119:         # Protect legend cells and all marker pixels for entries that appear later (higher) in the legend.\\n 120:         future_markers = set(marker_order[i + 1 :])\\n 121:         protect = legend_mask.copy()\\n 122:         for fm in future_markers:\\n 123:             protect |= (g == fm) & (~legend_mask)\\n 124: \\n 125:         # Also protect current marker pixels in the common case (so markers remain visible),\\n 126:         # except when they form a solid 2x2 block (treated as a fille