{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"sed -n '90,220p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\"","aggregated_output":"            if dr != 0 and dc != 0:\n                if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n                    break\n            if (nr, nc) in occupied:\n                break\n            r, c = nr, nc\n        occupied.add((r, c))\n        out_pts.append((r, c))\n    return out_pts\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"sed -n '40,180p' /home/lixinyu/snap/new/ARC_code/train/bc93ec48.py\"","aggregated_output":"    if corner == \"BR\":\n        return height - obj_h, width - obj_w\n    if corner == \"BL\":\n        return height - obj_h, 0\n    raise AssertionError(f\"unknown corner: {corner}\")\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Copy each foreground object anchored in a true grid corner clockwise into the next corner.\n\n    Input structure\n    - The dominant color is the background.\n    - Foreground objects are monochromatic 4-connected components.\n    - Relevant objects are exactly those whose bounding box touches two adjacent borders at one grid corner.\n\n    Rule\n    - Start from the input unchanged.\n    - For each corner object, copy its pixel mask and color to the next corner clockwise: top-left to top-right, top-right to bottom-right, bottom-right to bottom-left, and bottom-left to top-left.\n    - Preserve each object's orientation by aligning its bounding box to the destination corner; stamps may overwrite existing pixels at the destination, but source pixels are not cleared.\n\n    Key insight\n    - Interior and side-only objects are distractors; only components actually anchored to a corner participate in the clockwise perimeter copy.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    height, width = map(int, g.shape)\n    bg = get_bg(g)\n\n    by_corner: dict[Corner, dict] = {}\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True):\n        corner = _bbox_corner(comp[\"bbox\"], height, width)\n        if corner is None:\n            continue\n        assert corner not in by_corner, \"expected at most one source object per corner\"\n        by_corner[corner] = comp\n\n    assert by_corner, \"expected at least one corner-anchored object\"\n\n    out = g.copy()\n    planned: dict[tuple[int, int], int] = {}\n    for src_corner, comp in by_corner.items():\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        obj_h = int(r1 - r0 + 1)\n        obj_w = int(c1 - c0 + 1)\n        dst_corner = _NEXT_CORNER[src_corner]\n        dst_r0, dst_c0 = _corner_anchor(dst_corner, height, width, obj_h, obj_w)\n        color = int(comp[\"color\"])\n\n        for r_raw, c_raw in comp[\"coords\"]:\n            r = int(dst_r0 + int(r_raw) - r0)\n            c = int(dst_c0 + int(c_raw) - c0)\n            assert 0 <= r < height and 0 <= c < width, \"corner stamp must remain in bounds\"\n            assert (r, c) not in planned, \"expected non-overlapping corner stamps\"\n            planned[(r, c)] = color\n\n    for (r, c), color in planned.items():\n        out[r, c] = color\n\n    return out\n\n# --------------- generator (att2) ---------------\n\n_GEN_BG = 7\n_GEN_MIN_SIZE, _GEN_MAX_SIZE = 8, 16\n_GEN_CORNERS = (\"TL\", \"TR\", \"BR\", \"BL\")\n_GEN_NEXT = {\"TL\": \"TR\", \"TR\": \"BR\", \"BR\": \"BL\", \"BL\": \"TL\"}\n_GEN_COLORS = (1, 2, 3, 4, 5, 6, 8, 9)\n\n_GEN_CORNER_COUNT_MIN, _GEN_CORNER_COUNT_MAX = 3, 4\n_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX = 1, 4\n_GEN_CORNER_MIN_PIXELS, _GEN_CORNER_MAX_PIXELS = 2, 12\n_GEN_CORNER_MIN_DENSITY = 0.62\n_GEN_SMALL_FULL_AREA_MAX, _GEN_SMALL_FULL_PROB = 12, 0.45\n_GEN_CORNER_DIMS = tuple(\n    (h, w)\n    for h in range(_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX + 1)\n    for w in range(_GEN_CORNER_DIM_MIN, _GEN_CORNER_DIM_MAX + 1)\n    if not (h == 1 and w == 1)\n)\n\n_GEN_BLOB_PIXELS_MIN, _GEN_BLOB_PIXELS_MAX = 1, 5\n_GEN_BLOB_H_MIN, _GEN_BLOB_H_MAX = 1, 5\n_GEN_BLOB_W_MIN, _GEN_BLOB_W_MAX = 1, 4\n_GEN_DISTRACTOR_BASE_COUNT = 4\n_GEN_DISTRACTOR_SIZE_SPAN = 8\n_GEN_DISTRACTOR_EXTRA_MAX, _GEN_DISTRACTOR_MIN_GAP = 10, 6\n\n_GEN_RETRY_LIMIT = 300\n_GEN_NEIGHBORS_4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\n\ndef _gen_anchor(corner: str, n: int, h: int, w: int) -> tuple[int, int]:\n    if corner == \"TL\":\n        return 0, 0\n    if corner == \"TR\":\n        return 0, n - w\n    if corner == \"BR\":\n        return n - h, n - w\n    if corner == \"BL\":\n        return n - h, 0\n    raise AssertionError(corner)\n\n\ndef _gen_source_local_corner(corner: str, h: int, w: int) -> tuple[int, int]:\n    r = 0 if corner in (\"TL\", \"TR\") else h - 1\n    c = 0 if corner in (\"TL\", \"BL\") else w - 1\n    return r, c\n\n\ndef _gen_step_range(a: int, b: int) -> range:\n    step = 1 if b >= a else -1\n    return range(a, b + step, step)\n\n\ndef _gen_frontier(mask: np.ndarray) -> set[tuple[int, int]]:\n    h, w = mask.shape\n    frontier: set[tuple[int, int]] = set()\n    for r, c in np.argwhere(mask):\n        for dr, dc in _GEN_NEIGHBORS_4:\n            nr, nc = int(r) + dr, int(c) + dc\n            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:\n                frontier.add((nr, nc))\n    return frontier\n\n\ndef _gen_grow_mask(mask: np.ndarray, target: int) -> bool:\n    while int(mask.sum()) < target:\n        frontier = _gen_frontier(mask)\n        if not frontier:\n            return False\n        r, c = random.choice(tuple(frontier))\n        mask[r, c] = True\n    return True\n\n\ndef _gen_connected_corner_mask(corner: str, h: int, w: int) -> np.ndarray | None:\n    sr, sc = _gen_source_local_corner(corner, h, w)\n    er, ec = h - 1 - sr, w - 1 - sc\n    mask = np.zeros((h, w), dtype=bool)\n\n","exit_code":0,"status":"completed"}}
