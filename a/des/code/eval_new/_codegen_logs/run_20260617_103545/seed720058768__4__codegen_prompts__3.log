EA = 8\n 163: _FRAME_MAX_GAP = 3\n 164: _FRAME_BODY_THRESHOLD = 0.28\n 165: _WIDE_BODY_THRESHOLD = 0.55\n 166: _SYMMETRIC_BODY_THRESHOLD = 0.82\n 167: _SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n 168: _SYMMETRIC_TRANSPOSE_PROB = 0.45\n 169: _MARKER_INTERIOR_PROB = 0.65\n 170: _FLIP_PROB = 0.5\n 171: \n 172: # CFG: optional singleton distractors.\n 173: _DISTRACTOR_PROB = 0.15\n 174: _DISTRACTOR_COUNT_RANGE = (1, 4)\n 175: \n 176: _GROW_BODY_SEEDS = [\n 177:     {(0, 0), (0, 1), (0, 2), (1, 0)},\n 178:     {(0, 0), (0, 1), (0, 2), (1, 2)},\n 179:     {(0, 0), (1, 0), (1, 1), (1, 2)},\n 180:     {(0, 2), (1, 0), (1, 1), (1, 2)},\n 181:     {(0, 1), (1, 0), (1, 1), (1, 2)},\n 182: ]\n 183: \n 184: \n-- generate_input at line 582 --\n 582: def generate_input() -> np.ndarray:\n 583:     for _ in range(_GEN_RETRY_LIMIT):\n 584:         grid = _gen_attempt()\n 585:         if grid is not None:\n 586:             return grid\n 587:     raise RuntimeError(\"failed to generate a valid 581f7754 input\")\n\n","exit_code":0,"status":"completed"}}
