: _SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette\n 307: _SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right\n 308: _TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3\n 309: \n 310: # Palette\n 311: _PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5\n 312: \n 313: # Sprite geometry\n 314: _SPRITE_H_MAX = 7\n 315: _SPRITE_W_MAX = 6\n 316: _SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw\n 317: _SPRITE_CELL_MAX = 16\n 318: _FILLED_SPRITE_MAX = 3\n 319: \n 320: # Sprite mutation probabilities\n 321: _P_HORIZ_WALL = 0.3           # add horizontal internal wall\n 322: _P_VERT_WALL = 0.3            # add vertical internal wall\n 323: _P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes\n 324: _P_DIAMOND = 0.2              # use diamond shape for 3x3\n 325: \n 326: # Generation\n 327: _MAX_RETRIES = 300\n 328: # -- End configuration --------------------------------------------------------\n 329: \n 330: \n-- generate_input at line 544 --\n 544: def generate_input():\n 545:     for _ in range(_MAX_RETRIES):\n 546:         r = _gen_attempt()\n 547:         if r is not None:\n 548:             return r\n 549:     raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/train/db7260a4.py =====\n-- main at line 36 --\n  36: def main(grid: np.ndarray) -> np.ndarray:\n  37:     \"\"\"\n  38:     Drop the singleton marker into the matching red U-shaped container, or make a bottom-row puddle if no closed container is hit.\n  39: \n  40:     Input structure\n  41:     - The grid has a dominant background, one singleton marker pixel on the top row,\n  42:       and one other foreground color forming vertical bars and bottom segments.\n  43:     - A closed container is a U shape: two vertical side bars with a continuous\n  44:       bottom segment between them and an empty rectangular interior above the bottom.\n  45: \n  46:     Rule\n  47:     - Remove the top marker from its original cell.\n  48:     - If exactly one closed U-shaped container has the marker column within its\n  49:       horizontal footprint, fill that container's empty interior with the marker color.\n  50:     - If no closed container is under the marker column, fill the whole bottom row\n  51:       with the marker color.\n  52: \n  53:     Key insight\n  54:     - The marker does not identify a color by value; it identifies a vertical drop\n  55:       column, and only a structurally closed U shape can catch and contain the fill.\n  56:     \"\"\"\n  57:     g = np.asarray(grid, dtype=int)\n  58:     assert g.ndim == 2\n  59: \n  60:     bg = get_bg(g)\n  61:     foreground_colors = colors_present(g, exclude={bg})\n  62:     assert len(foreground_colors) == 2, \"expected marker and wall colors\"\n  63: \n  64:     singleton_colors = [color for color in foreground_colors if int(np.count_nonzero(g == color)) == 1]\n  65:     assert len(singleton_colors) == 1, \"expected exactly one singleton marker color\"\n  66:     marker_color = singleton_colors[0]\n  67: \n  68:     wall_colors = [color for color in foreground_colors if color != marker_color]\n  69:     assert len(wall_colors) == 1\n  70:     wall_color = wall_colors[0]\n  71: \n  72:     marker_coords = np.argwhere(g == marker_color)\n  73:     assert marker_coords.shape == (1, 2)\n  74:     marker_r, marker_c = map(int, marker_coords[0])\n  75:     assert marker_r == 0, \"marker must sit on the top row\"\n  76: \n  77:     containers = [\n  78:         container\n  79:         for container in _closed_u_containers(g, wall_color, bg)\n  80:         if container[0] > marker_r and container[2] <= marker_c <= container[3]\n  81:     ]\n  82:     assert len(containers) <= 1, \"marker column must select at most one closed container\"\n  83: \n  84:     out = g.copy()\n  85:     out[marker_r, marker_c] = bg\n  86:     if containers:\n  87:         top, bottom, left, right 