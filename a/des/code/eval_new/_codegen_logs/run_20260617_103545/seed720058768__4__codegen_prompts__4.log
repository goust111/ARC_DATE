nonical_shape_key(m),\n            }\n        )\n\n    freq = Counter(d[\"shape_key\"] for d in extracted)\n    out = np.full((H, W), int(bg), dtype=int)\n\n    for d in extracted:\n        pat = d[\"pat\"]\n        h, w = map(int, pat.shape)\n        dest_r0 = 0 if int(freq[d[\"shape_key\"]]) >= 2 else int(H - h)\n        dest_c0 = int(d[\"c0\"])\n        paste(out, pat, dest_r0, dest_c0, transparent=int(bg))\n\n    return out\n\n--- generate_input lines 361-366 ---\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate a valid 62593bfd sample\")\n\n=== /home/lixinyu/snap/new/ARC_code/eval/e87109e9.py ===\n--- main lines 67-148 ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Emit four teal beams from a square, turning at colored obstacles per a legend.\n\n    Input structure:\n    - Top band: grey (5) legend with colored vertical bars in cells; bar position (left or right) encodes turn direction.\n    - Below: main grid with bg, a solid teal (8) square, and colored obstacle blocks.\n\n    Rule:\n    - Remove the legend from the output.\n    - From the teal square, shoot a beam in each cardinal direction (as a sliding copy of the square).\n    - Each beam paints teal over bg cells as it moves.\n    - On hitting an obstacle of color C, consult the legend: bar on left → turn counterclockwise, bar on right → turn clockwise. Continue in the new direction.\n    - Beams stop at grid edges.\n\n    Key insight: The legend's bar position (left vs right within its cell) is the encoding for turn direction at each obstacle color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n\n    # Legend height: crop everything above and including the last row containing legend bg (usually 5).\n    # In this dataset, the legend uses a dedicated color (5) that doesn't appear below.\n    legend_bg = 5\n    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]\n    assert rows_with_legend.size, \"legend rows must be present\"\n    legend_h = int(rows_with_legend.max() + 1)\n    assert np.array_equal(rows_with_legend, np.arange(legend_h)), \"legend color must be confined to the top band\"\n\n    legend_turn = _parse_legend(g, legend_h)\n\n    base = g[legend_h:, :].copy()\n    assert base.size, \"main grid must remain after legend crop\"\n\n    _vals, _cnts = np.unique(base, return_counts=True); bg = int(_vals[_cnts.argmax()])\n    teal = 8\n    src = _find_teal_square(base, teal=teal)\n    sr, sc, sz = src\n\n    out = base.copy()\n\n    def in_bounds(r: int, c: int) -> bool:\n        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]\n\n    def paint_block(r: int, c: int) -> None:\n        blk = out[r : r + sz, c : c + sz]\n        blk[blk == bg] = teal\n        out[r : r + sz, c : c + sz] = blk\n\n    def obstacle_color_at_next(nr: int, nc: int) -> int | None:\n        blk = out[nr : nr + sz, nc : nc + sz]\n        cols = set(map(int, np.unique(blk)))\n        cols.discard(bg)\n        cols.discard(teal)\n        if not cols:\n            return None\n        assert len(cols) == 1, \"beam footprint must not hit mixed obstacle colors\"\n        return int(next(iter(cols)))\n\n    # Four beams, each is a moving copy of the teal square.\n    for d0 in range(4):\n        r, c, d = sr, sc, d0\n        seen: set[tuple[int, int, int]] = set()\n        while True:\n            state = (r, c, d)\n            assert state not in seen, \"beam path must not cycle\"\n            seen.add(state)\n\n            dr, dc = _DIRS[d]\n            nr, nc = r + dr, c + dc\n            if not in_bounds(nr, nc):\n                break\n\n            oc = obstacle_color_at_next(nr, nc)\n            if oc is None:\n                r, c = nr, nc\n                paint_block(r, c)\n                continue\n\n            assert oc in legend_turn, \"obstacle color must be encoded by legend\"\n            turn = legend_turn[oc]\n            d = _rot_ccw(d) if turn == \"L\" else _rot_cw(d)\n\n    return out\n\n--- generate_input lines 535-540 ---\ndef generate_input() -> np.ndarray:\n    for _ in range(MAX_RETRIES):\n        grid = _gen_attempt()\n        if grid is not None:\n            return grid\n    raise RuntimeError(\"failed to generate e87109e9 input\")\n\n=== /home/lixinyu/snap/new/ARC_code/train/538b439f.py ===\n--- main lines 121-151 ---\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Reflect the solid rectangular source objects across the full separator line and color the gap with the separator color.\n\n    Input structure:\n    - A dominant background contains one full-width or full-height one-pixel\n      separator line in a non-background color.\n    - One other foreground color forms solid rectangular objects, all strictly on the same side of that separator.\n    - Remaining non-background pixels are scattered distractors.\n\n    Rule:\n    - Keep the input grid shape and unchanged pixels outside each affected corridor.\n    - Mirror each source object across the separator line.\n    - For every source object, recolor the rectangular strip between the\n      original object and its reflection to the separator color, then paint the\n      reflected object in the source color.\n\n    Key insight:\n    - The full straight line is a mirror axis; the real objects are identified\n      structurally as the only solid rectangles confined to one side, while\n      scattered pixels are noise that may be overwritten inside the corridor.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    orient, axis, axis_color = _find_separator(g, bg)\n    source_color, components = _find_source(g, bg, orient, axis, axis_color)\n\n    out = g.copy()\n    for component in components:\n        _mirror_and_connect(out, component, orient, axis, axis_color, source_color)\n    return out\n\n--- generate_input lines 473-