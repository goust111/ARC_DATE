{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/a251c730.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import bbox_coords, components_mask, paste, random_free_location\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Stamp source sprites into a destination frame via color-matched singleton markers.\n\n    Input structure:\n    - Two bordered rectangles: source (multi-cell sprites) and destination (singleton markers).\n    - Each sprite has an anchor pixel — its least-frequent color. Markers share these colors.\n\n    Rule:\n    - Match each destination marker to the source sprite with the same anchor color.\n    - Translate the sprite so its anchor overlaps the marker position.\n    - Output is the destination rectangle, interior cleared before stamping.\n\n    Key insight: The rarest color per sprite doubles as a template key and positioning anchor.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # --- find all uniform-border rectangles (brute force, small grid) ---\n    def interior_bg(rect: tuple[int, int, int, int]) -> int:\n        r0, c0, r1, c1 = map(int, rect)\n        inner = g[int(r0) + 1 : int(r1), int(c0) + 1 : int(c1)]\n        return int(Counter(map(int, inner.flatten())).most_common(1)[0][0])\n\n    def rect_components(rect: tuple[int, int, int, int]) -> tuple[int, list[dict]]:\n        r0, c0, r1, c1 = map(int, rect)\n        inner = g[int(r0) + 1 : int(r1), int(c0) + 1 : int(c1)]\n        ibg = int(Counter(map(int, inner.flatten())).most_common(1)[0][0])\n        comps = []\n\n        for coords in components_mask(inner != int(ibg), connectivity=4):\n            if coords.size == 0:\n                continue\n            rr0, cc0, rr1, cc1 = bbox_coords(coords)\n            mask = np.zeros((int(rr1 - rr0 + 1), int(cc1 - cc0 + 1)), dtype=bool)\n            mask[coords[:, 0] - int(rr0), coords[:, 1] - int(cc0)] = True\n            patch = inner[int(rr0) : int(rr1) + 1, int(cc0) : int(cc1) + 1].copy()\n            patch[~mask] = 0\n\n            vals = [int(inner[int(r), int(c)]) for r, c in coords]\n            cols = Counter(vals)\n            comps.append(\n                {\n                    \"size\": int(coords.shape[0]),\n                    \"colors\": dict(cols),\n                    \"bbox\": (int(rr0), int(cc0), int(rr1), int(cc1)),\n                    \"mask\": mask,\n                    \"patch\": patch,\n                }\n            )\n\n        comps.sort(key=lambda d: -int(d[\"size\"]))\n        return int(ibg), comps\n\n    rects: list[tuple[int, tuple[int, int, int, int], int, int]] = []\n    min_h = 6\n    min_w = 6\n    for r0 in range(int(H)):\n        for c0 in range(int(W)):\n            bc = int(g[int(r0), int(c0)])\n            for r1 in range(int(r0 + min_h - 1), int(H)):\n                for c1 in range(int(c0 + min_w - 1), int(W)):\n                    # corners\n                    if int(g[int(r0), int(c1)]) != int(bc) or int(g[int(r1), int(c0)]) != int(bc) or int(\n                        g[int(r1), int(c1)]\n                    ) != int(bc):\n                        continue\n                    # border uniformity\n                    if not bool((g[int(r0), int(c0) : int(c1) + 1] == int(bc)).all()):\n                        continue\n                    if not bool((g[int(r1), int(c0) : int(c1) + 1] == int(bc)).all()):\n                        continue\n                    if not bool((g[int(r0) : int(r1) + 1, int(c0)] == int(bc)).all()):\n                        continue\n                    if not bool((g[int(r0) : int(r1) + 1, int(c1)] == int(bc)).all()):\n                        continue\n                    # interior bg must differ from border\n                    ibg = interior_bg((int(r0), int(c0), int(r1), int(c1)))\n                    if int(ibg) == int(bc):\n                        continue\n                    area = int((int(r1) - int(r0) + 1) * (int(c1) - int(c0) + 1))\n                    rects.append((int(area), (int(r0), int(c0), int(r1), int(c1)), int(bc), int(ibg)))\n\n    assert not (not rects)\n\n    rects.sort(reverse=True, key=lambda x: int(x[0]))\n    rects = rects[:6]\n\n    src = None\n    dst = None\n    for _area, rect, bc, _ibg in rects:\n        ibg2, comps = rect_components(rect)\n        max_sz = max([int(c[\"size\"]) for c in comps], default=0)\n        if max_sz > 1 and src is None:\n            src = (rect, bc, ibg2, comps)\n        if max_sz == 1 and len(comps) > 0 and dst is None:\n            dst = (rect, bc, ibg2, comps)\n\n    assert src is not None and dst is not None, 'must find both source (multi-cell) and destination (singleton) rectangles'\n\n    (sr, sc, sr1, sc1), _src_bc, src_bg, src_comps = src\n    (dr, dc, dr1, dc1), dst_bc, dst_bg, _dst_comps = dst\n\n    # --- build templates keyed by anchor color ---\n    templates: dict[int, tuple[np.ndarray, np.ndarray, tuple[int, int]]] = {}\n    for comp in src_comps:\n        cols = {k: int(v) for k, v in comp[\"colors\"].items() if int(k) != 0}\n        if not cols:\n            continue\n        anchor_col = int(min(cols.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n        patch = comp[\"patch\"]\n        mask = comp[\"mask\"]\n        anchors = np.argwhere((patch == int(anchor_col)) & mask)\n        if anchors.size == 0:\n            continue\n        ar, ac = map(int, anchors[0])\n        if int(anchor_col) not in templates or int(mask.sum()) > int(templates[int(anchor_col)][1].sum()):\n            templates[int(anchor_col)] = (patch.copy(), mask.copy(), (int(ar), int(ac)))\n\n    # --- create destination canvas and stamp ---\n    out_h = int(dr1 - dr + 1)\n    out_w = int(dc1 - dc + 1)\n    out = np.full((out_h, out_w), int(dst_bg), dtype=int)\n    out[0, :] = int(dst_bc)\n    out[-1, :] = int(dst_bc)\n    out[:, 0] = int(dst_bc)\n    out[:, -1] = int(dst_bc)\n\n    # Destination markers are singleton pixels (color != dst_bg) in the interior.\n    inner = g[int(dr) + 1 : int(dr1), int(dc) + 1 : int(dc1)]\n    for rr, cc in np.argwhere(inner != int(dst_bg)):\n        mr = int(dr + 1 + int(rr))\n        mc = int(dc + 1 + int(cc))\n        mcol = int(g[mr, mc])\n        if int(mcol) not in templates:\n            continue\n        patch, mask, (ar, ac) = templates[int(mcol)]\n        top = int((mr - dr) - int(ar))\n        left = int((mc - dc) - int(ac))\n        paste(out, patch, int(top), int(left), mask=mask, overwrite=True, clip=True)\n\n    return out\n\n# --------------- generator (O2) ---------------\n\n# === CFG: Canvas & layout ===\nGRID_SIZE = 30                     # fixed 30x30 canvas\nWALLPAPER_COLORS = (4, 5)         # number of wallpaper stripe colors (chosen per n_types)\nTOTAL_COLORS_TARGET = (7, 8, 9)   # total distinct color count targets\nGAP_RANGE = (1, 4)                # gap between rectangles during dimension selection\n\n# === CFG: Rectangle size bounds ===\nSRC_H_RANGE = (9, 19)             # source rect height (outer, inclusive)\nSRC_W_RANGE = (8, 18)             # source rect width (outer, inclusive)\nDST_H_RANGE = (9, 19)             # dest rect height (outer, inclusive)\nDST_W_RANGE = (8, 20)             # dest rect width (outer, inclusive)\nDST_W_SIDE_MAX = 20               # dest width cap for side-by-side layout\n\n# === CFG: Sprite & placement ===\nSPRITE_TYPE_CHOICES = (1, 2)      # number of distinct sprite types\nMARKER_COUNT_RANGE = (2, 3)       # markers in dest rect\nSOURCE_SPRITE_RANGE = (2, 4)      # total sprites in source rect\nMARKER_PLACE_RETRIES = 25         # retries per marker for non-overlapping placement\nSOURCE_SPRITE_PADDING = 1         # min gap between source sprites and edges\n\n# === CFG: Generation retries ===\nMAX_GEN_ATTEMPTS = 300            # outer retry limit\n\nSPRITE_SHAPES = [\n    ((\"AB.\", \"BBB\"), (0, 0)),\n    ((\"ABB\", \"BBB\"), (0, 0)),\n    ((\".A.\", \"BBB\", \".B.\"), (0, 1)),\n    ((\"AB.\", \"BBB\", \".BB\"), (0, 0)),\n    ((\"ABB\", \"BBB\", \"..B\"), (0, 0)),\n    ((\".AB\", \"BBB\", \"BB.\"), (0, 1)),\n    ((\"B.B\", \"BBB\", \".A.\"), (2, 1)),\n    ((\".B.\", \"BAB\", \".B.\"), (1, 1)),\n    ((\"BBB\", \"BAB\"), (1, 1)),\n    ((\"AB.\", \"BBB\", \".B.\"), (0, 0)),\n    ((\"BAB\", \"BBB\"), (0, 1)),\n]\n\n\ndef _render_sprite(shape_rows: tuple[str, ...], body: int, anchor: int, bg: int) -> np.ndarray:\n    \"\"\"Render a sprite template into a colored patch. 'A'=anchor, 'B'=body, '.'=bg.\"\"\"\n    char_map = {'B': body, 'A': anchor}\n    rows = [[char_map.get(ch, bg) for ch in row] for row in shape_rows]\n    return np.array(rows, dtype=int)\n\n\ndef _make_wallpaper(direction: str, palette: list[int]) -> np.ndarray:\n    \"\"\"Create a 30x30 striped wallpaper (vertical or horizontal).\"\"\"\n    period = len(palette)\n    stripe = np.array(palette * ((GRID_SIZE + period - 1) // period), dtype=int)[:GRID_SIZE]\n    if direction == \"vertical\":\n        return np.tile(stripe, (GRID_SIZE, 1))\n    return np.tile(stripe.reshape(-1, 1), (1, GRID_SIZE))\n\n\ndef _build_frame(h: int, w: int, border: int, bg: int) -> np.ndarray:\n    \"\"\"Create an h x w rectangle with a 1-pixel border and interior filled with bg.\"\"\"\n    rect = np.full((h, w), bg, dtype=int)\n    rect[0, :] = rect[-1, :] = border\n    rect[:, 0] = rect[:, -1] = border\n    return rect\n\n\ndef _choose_counts(n_total: int, n_types: int) -> list[int]:\n    \"\"\"Distribute n_total items across n_types bins, each bin >= 1.\"\"\"\n    counts = [1] * n_types\n    for _ in range(n_total - n_types):\n        counts[random.randrange(n_types)] += 1\n    return counts\n\n\ndef _choose_dimensions(layout: str) -> tuple[int, int, int, int]:\n    \"\"\"Pick (src_h, src_w, dst_h, dst_w) that fit the 30x30 canvas for the given layout.\"\"\"\n    gap = random.randint(*GAP_RANGE)\n    if layout == \"side_by_side\":\n        src_w = random.randint(*SRC_W_RANGE)\n        dst_w_max = min(DST_W_SIDE_MAX, GRID_SIZE - gap - src_w)\n        if dst_w_max < DST_W_RANGE[0]:\n            raise ValueError(\"no side-by-side width fit\")\n        dst_w = random.randint(DST_W_RANGE[0], dst_w_max)\n        src_h = random.randint(*SRC_H_RANGE)\n        dst_h = random.randint(*DST_H_RANGE)\n    else:\n        src_h = random.randint(*SRC_H_RANGE)\n        dst_h_max = min(DST_H_RANGE[1], GRID_SIZE - gap - src_h)\n        if dst_h_max < DST_H_RANGE[0]:\n            raise ValueError(\"no stacked height fit\")\n        dst_h = random.randint(DST_H_RANGE[0], dst_h_max)\n        src_w = random.randint(*SRC_W_RANGE)\n        dst_w = random.randint(*DST_W_RANGE)\n    return src_h, src_w, dst_h, dst_w\n\n\ndef _place_rectangles(\n    layout: str, src_h: int, src_w: int, dst_h: int, dst_w: int\n) -> tuple[tuple[int, int], tuple[int, int]]:\n    \"\"\"Compute non-overlapping (row, col) origins for src and dst rectangles.\"\"\"\n    if layout == \"side_by_side\":\n        gap = random.randint(1, GRID_SIZE - src_w - dst_w)\n        slack = GRID_SIZE - src_w - dst_w - gap\n        left_margin = random.randint(0, slack)\n        src_r = random.randint(0, GRID_SIZE - src_h)\n        dst_r = random.randint(0, GRID_SIZE - dst_h)\n        if random.random() < 0.5:\n            src_c, dst_c = left_margin, left_margin + src_w + gap\n        else:\n            dst_c, src_c = left_margin, left_margin + dst_w + gap\n    else:\n        gap = random.randint(1, GRID_SIZE - src_h - dst_h)\n        slack = GRID_SIZE - src_h - dst_h - gap\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/278e5215.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import bbox, components_mask, crop_bbox, get_bg, paste\nimport random\nfrom itertools import product\n\n\ndef _unique_largest_non_bg_color(g: np.ndarray, bg: int) -> int:\n    counts = Counter(map(int, g.flatten()))\n    non_bg_counts = [(color, count) for color, count in counts.items() if color != int(bg)]\n    assert non_bg_counts\n\n    largest_count = max(count for _color, count in non_bg_counts)\n    candidates = [color for color, count in non_bg_counts if count == largest_count]\n    assert len(candidates) == 1\n    return int(candidates[0])\n\n\ndef _mask_bbox(g: np.ndarray, mask_color: int) -> tuple[int, int, int, int]:\n    mask = g == int(mask_color)\n    comps = components_mask(mask, connectivity=4)\n    assert len(comps) == 1\n\n    b = bbox(mask)\n    assert b is not None\n    return b\n\n\ndef _palette(g: np.ndarray, bg: int, mask_color: int, width: int) -> tuple[np.ndarray, int]:\n    palette_mask = (g != int(bg)) & (g != int(mask_color))\n    b = bbox(palette_mask)\n    assert b is not None\n\n    palette = crop_bbox(g, b)\n    assert palette.shape == (3, int(width))\n    assert bool(np.all(palette != int(bg)))\n    assert bool(np.all(palette != int(mask_color)))\n    assert bool(np.array_equal(palette[0], palette[1]))\n    assert len(set(map(int, palette[2]))) == 1\n\n    column_colors = palette[0].copy()\n    hole_color = int(palette[2, 0])\n    return column_colors, hole_color\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Recolor the large mask crop column-by-column using the separate three-row palette strip.\n\n    Input structure:\n    - The background is the most common color.\n    - One large monochrome foreground object is the mask; its bbox is the output region and may contain background holes.\n    - The remaining foreground is a 3-row palette rectangle with the same width as the mask bbox: two identical color rows and one uniform row.\n\n    Rule:\n    - Crop to the mask object's bbox.\n    - For each output column, color mask pixels with the corresponding color from the repeated palette rows.\n    - Replace background holes inside the crop with the palette's uniform third-row color.\n\n    Key insight:\n    The grey object is only a stencil; its columns select colors from the legend, while its holes expose the legend's fill color.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    mask_color = _unique_largest_non_bg_color(g, bg)\n\n    b = _mask_bbox(g, mask_color)\n    mask_crop = crop_bbox(g == int(mask_color), b)\n    height, width = map(int, mask_crop.shape)\n\n    column_colors, hole_color = _palette(g, bg, mask_color, width)\n    out = np.tile(column_colors, (height, 1))\n    out[~mask_crop] = hole_color\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# Canvas, colors, and object bounds.\nBACKGROUND_COLOR, MASK_COLOR = 0, 5\nCOLOR_MIN, COLOR_MAX = 1, 9\nGRID_SIDE_MIN, GRID_SIDE_MAX = 10, 18\nMASK_SIDE_MIN, MASK_SIDE_MAX = 5, 10\nPALETTE_HEIGHT = 3\nGAP_MIN, GAP_MAX = 1, 3\n\n# Palette run construction.\nRUN_COUNT_OPTIONS = (4, 5)\nRUN_LENGTH_MIN, RUN_LENGTH_MAX = 1, 3\nCOLUMN_COLOR_DISTINCT_MIN, COLUMN_COLOR_DISTINCT_MAX = 3, 5\nUNUSED_COLOR_BIAS = 0.7\n\n# Mask density and retry budget.\nMASK_DENSITY_MIN, MASK_DENSITY_MAX = 0.60, 0.71\nGENERATION_ATTEMPTS = 300\n\n\ndef _valid_run_lengths(width: int, n_runs: int) -> list[tuple[int, ...]]:\n    length_range = range(RUN_LENGTH_MIN, RUN_LENGTH_MAX + 1)\n    return [\n        tuple(int(x) for x in lengths)\n        for lengths in product(length_range, repeat=int(n_runs))\n        if sum(lengths) == int(width)\n    ]\n\n\ndef _run_colors(colors: list[int], n_runs: int) -> list[int]:\n    seq: list[int] = []\n    unused = set(colors)\n    for i in range(int(n_runs)):\n        slots_left = int(n_runs) - i\n        choices = [c for c in colors if not seq or c != seq[-1]]\n        if len(unused) >= slots_left:\n            choices = [c for c in choices if c in unused]\n        elif unused and random.random() < UNUSED_COLOR_BIAS:\n            preferred = [c for c in choices if c in unused]\n            if preferred:\n                choices = preferred\n        color = random.choice(choices)\n        seq.append(int(color))\n        unused.discard(int(color))\n    return seq\n\n\ndef _palette_row(width: int, colors: list[int]) -> np.ndarray:\n    valid_counts = [\n        n_runs for n_runs in RUN_COUNT_OPTIONS if _valid_run_lengths(int(width), n_runs)\n    ]\n    n_runs = random.choice(valid_counts)\n    valid_lengths = _valid_run_lengths(int(width), n_runs)\n    lengths = random.choice(valid_lengths)\n    n_distinct = random.randint(\n        COLUMN_COLOR_DISTINCT_MIN, min(COLUMN_COLOR_DISTINCT_MAX, n_runs)\n    )\n    chosen = random.sample(colors, n_distinct)\n    seq = _run_colors(chosen, n_runs)\n    return np.repeat(seq, lengths).astype(int)\n\n\ndef _neighbors4(r: int, c: int, h: int, w: int):\n    if r > 0:\n        yield r - 1, c\n    if r + 1 < h:\n        yield r + 1, c\n    if c > 0:\n        yield r, c - 1\n    if c + 1 < w:\n        yield r, c + 1\n\n\ndef _connected_mask(height: int, width: int, target_area: int) -> np.ndarray | None:\n    \"\"\"Grow a connected mask with full row/column span to the target area.\"\"\"\n    mask = np.zeros((int(height), int(width)), dtype=bool)\n    steps = [\"D\"] * (int(height) - 1) + [\"R\"] * (int(width) - 1)\n    random.shuffle(steps)\n\n    r = c = 0\n    mask[r, c] = True\n    for step in steps:\n        if step == \"D\":\n            r += 1\n        else:\n            c += 1\n        mask[r, c] = True\n\n    if int(mask.sum()) > int(target_area):\n        return None\n\n    frontier: set[tuple[int, int]] = set()\n\n    def add_frontier(rr: int, cc: int) -> None:\n        for nr, nc in _neighbors4(rr, cc, int(height), int(width)):\n            if not mask[nr, nc]:\n                frontier.add((int(nr), int(nc)))\n\n    for rr, cc in np.argwhere(mask):\n        add_frontier(int(rr), int(cc))\n\n    while int(mask.sum()) < int(target_area):\n        if not frontier:\n            return None\n        cell = random.choice(tuple(frontier))\n        frontier.remove(cell)\n        rr, cc = cell\n        mask[rr, cc] = True\n        add_frontier(rr, cc)\n\n    return mask\n\n\ndef _grid_choices(mask_h: int, mask_w: int, gap: int) -> list[tuple[int, int]]:\n    \"\"\"Grid sizes where the mask remains the unique largest non-bg object.\"\"\"\n    max_mask = int(np.floor(MASK_DENSITY_MAX * int(mask_h) * int(mask_w)))\n    min_h = max(GRID_SIDE_MIN, int(mask_h) + PALETTE_HEIGHT + int(gap))\n    min_w = max(GRID_SIDE_MIN, int(mask_w))\n    choices: list[tuple[int, int]] = []\n    for h in range(min_h, GRID_SIDE_MAX + 1):\n        for w in range(min_w, GRID_SIDE_MAX + 1):\n            if h * w - max_mask - PALETTE_HEIGHT * int(mask_w) > max_mask:\n                choices.append((h, w))\n    return choices\n\n\ndef _sample_dimensions() -> tuple[int, int, int, int, int] | None:\n    \"\"\"Sample mask size, layout gap, and compatible grid size.\"\"\"\n    mask_h = random.randint(MASK_SIDE_MIN, MASK_SIDE_MAX)\n    mask_w = random.randint(MASK_SIDE_MIN, MASK_SIDE_MAX)\n    gap = random.randint(GAP_MIN, GAP_MAX)\n    grid_choices = _grid_choices(mask_h, mask_w, gap)\n    if not grid_choices:\n        return None\n    grid_h, grid_w = random.choice(grid_choices)\n    return mask_h, mask_w, gap, grid_h, grid_w\n\n\ndef _sample_palette(mask_w: int) -> tuple[np.ndarray, int]:\n    \"\"\"Choose hole color and the same-width column palette row.\"\"\"\n    available = [c for c in range(COLOR_MIN, COLOR_MAX + 1) if c != MASK_COLOR]\n    hole_color = random.choice(available)\n    column_pool = [c for c in available if c != hole_color]\n    column_colors = _palette_row(mask_w, column_pool)\n    return column_colors, int(hole_color)\n\n\ndef _compose_grid(grid_h, grid_w, gap, mask, column_colors, hole_color) -> np.ndarray:\n    \"\"\"Paste mask and palette into disjoint row bands of a blank grid.\"\"\"\n    mask_h, mask_w = map(int, mask.shape)\n    hole_row = np.full(int(mask_w), int(hole_color), dtype=int)\n    palette = np.vstack([column_colors, column_colors, hole_row])\n    mask_sprite = np.where(mask, MASK_COLOR, BACKGROUND_COLOR)\n    grid = np.zeros((int(grid_h), int(grid_w)), dtype=int)\n    block_h = int(mask_h) + PALETTE_HEIGHT + int(gap)\n    top = random.randint(0, int(grid_h) - block_h)\n    palette_above = random.choice([True, False])\n    if palette_above:\n        palette_r = top\n        mask_r = top + PALETTE_HEIGHT + int(gap)\n    else:\n        mask_r = top\n        palette_r = top + int(mask_h) + int(gap)\n    mask_c = random.randint(0, int(grid_w) - int(mask_w))\n    palette_c = random.randint(0, int(grid_w) - int(mask_w))\n    paste(grid, mask_sprite, mask_r, mask_c, transparent=BACKGROUND_COLOR)\n    paste(grid, palette, palette_r, palette_c, transparent=None)\n    return grid\n\n\ndef _gen_attempt() -> np.ndarray | None:\n    dims = _sample_dimensions()\n    if dims is None:\n        return None\n    mask_h, mask_w, gap, grid_h, grid_w = dims\n\n    column_colors, hole_color = _sample_palette(mask_w)\n    area = int(mask_h) * int(mask_w)\n    min_area = int(np.ceil(MASK_DENSITY_MIN * area))\n    max_area = int(np.floor(MASK_DENSITY_MAX * area))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/9385bd28.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import get_bg\nimport random\nfrom collections import Counter\n\n\ndef _find_legend(g: np.ndarray, bg: int) -> tuple[int, list[tuple[int, int, int]]]:\n    \"\"\"\n    Legend is a vertical stack of pairs at bottom-left.\n    Each legend row: (marker_color at col c, fill_color at col c+1).\n    Returns (legend_col, entries) where entries are ordered bottom->top as (row, marker, fill).\n    \"\"\"\n    h, w = g.shape\n    start_r = None\n    start_c = None\n    for r in range(h - 1, -1, -1):\n        nz = np.flatnonzero(g[r, :] != bg)\n        if nz.size:\n            start_r = r\n            start_c = int(nz[0])\n            break\n    assert start_r is not None and start_c is not None and start_c < w - 1, \\\n        \"legend must exist at bottom-left with at least 2 columns\"\n\n    entries: list[tuple[int, int, int]] = []\n    c = start_c\n    for r in range(start_r, -1, -1):\n        nz = np.flatnonzero(g[r, :] != bg)\n        if nz.size == 0 or int(nz[0]) != c or int(g[r, c]) == bg:\n            break\n        marker = int(g[r, c])\n        fill = int(g[r, c + 1]) if c + 1 < w else bg\n        entries.append((r, marker, fill))\n    return c, entries\n\n\ndef _l_anchor_present(pts: set[tuple[int, int]], r: int, c: int, arm1: tuple[int, int], arm2: tuple[int, int]) -> bool:\n    \"\"\"\n    Marker corners are L-shapes:\n      TL: (r,c), (r,c+1), (r+1,c)\n      TR: (r,c), (r,c-1), (r+1,c)\n      BL: (r,c), (r,c+1), (r-1,c)\n      BR: (r,c), (r,c-1), (r-1,c)\n\n    This is more robust than checking only corner membership, especially when the bbox is 2-wide/2-tall\n    where L arms can overlap other bbox corners.\n    \"\"\"\n    (dr1, dc1) = arm1\n    (dr2, dc2) = arm2\n    return (r, c) in pts and (r + dr1, c + dc1) in pts and (r + dr2, c + dc2) in pts\n\n\ndef _diamond_mask(h: int, w: int, r0: int, r1: int, c0: int, c1: int, a: tuple[int, int], b: tuple[int, int]) -> np.ndarray:\n    \"\"\"\n    Mask for all cells inside [r0..r1]x[c0..c1] that lie on some shortest 4-neigh path between corners a and b:\n      dist(a,p) + dist(p,b) == dist(a,b)\n    \"\"\"\n    ar, ac = a\n    br, bc = b\n    dab = abs(ar - br) + abs(ac - bc)\n    m = np.zeros((h, w), dtype=bool)\n    for r in range(r0, r1 + 1):\n        for c in range(c0, c1 + 1):\n            if abs(r - ar) + abs(c - ac) + abs(r - br) + abs(c - bc) == dab:\n                m[r, c] = True\n    return m\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill rectangles between diagonal marker pairs using a color legend.\n\n    Input structure:\n    - bg grid with a vertical legend at the bottom-left: each row is a (marker_color, fill_color) pair.\n    - Scattered L-shaped corner markers of each marker color define opposite corners of axis-aligned rectangles.\n    - Some markers are solid 2×2 blocks instead of corner pairs.\n\n    Rule:\n    - Read legend bottom-to-top; for each entry find all pixels of that marker color.\n    - Determine which two bbox corners carry L-shaped anchors — the *other* diagonal defines the fill region.\n    - Fill the diamond (all shortest-path cells between those two corners) with the legend's fill color.\n    - Solid 2×2 marker blocks are simply recolored to the fill color.\n    - Later legend entries are protected from earlier fills.\n\n    Key insight: The L-shaped anchors sit on the marker diagonal; the fill goes on the opposite diagonal of the bounding box.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n\n    bg = get_bg(g)\n    legend_c, entries = _find_legend(g, bg)\n    assert entries, \"legend must contain at least one (marker, fill) entry\"\n\n    legend_mask = np.zeros_like(g, dtype=bool)\n    for r, _, _ in entries:\n        if 0 <= r < h and 0 <= legend_c < w:\n            legend_mask[r, legend_c] = True\n        if 0 <= r < h and 0 <= legend_c + 1 < w:\n            legend_mask[r, legend_c + 1] = True\n\n    out = g.copy()\n\n    marker_order = [m for _, m, _ in entries]\n    marker_set = set(marker_order)\n\n    # Process legend entries bottom -> top; earlier entries must not destroy later marker pixels.\n    for i, (_, marker, fill) in enumerate(entries):\n        eff_fill = int(fill)\n        marker_pts = set(map(tuple, np.argwhere((g == marker) & (~legend_mask))))\n        if len(marker_pts) < 2:\n            continue\n\n        rs = [r for r, _ in marker_pts]\n        cs = [c for _, c in marker_pts]\n        rmin, rmax = min(rs), max(rs)\n        cmin, cmax = min(cs), max(cs)\n\n        # Protect legend cells and all marker pixels for entries that appear later (higher) in the legend.\n        future_markers = set(marker_order[i + 1 :])\n        protect = legend_mask.copy()\n        for fm in future_markers:\n            protect |= (g == fm) & (~legend_mask)\n\n        # Also protect current marker pixels in the common case (so markers remain visible),\n        # except when they form a solid 2x2 block (treated as a filled marker that gets recolored).\n        if rmax - rmin == 1 and cmax - cmin == 1 and len(marker_pts) == 4:\n            # Solid 2x2 marker: recolor these pixels directly.\n            block = np.zeros_like(g, dtype=bool)\n            for r, c in marker_pts:\n                block[r, c] = True\n            out[block & (~protect)] = eff_fill\n            continue\n        else:\n            protect |= (g == marker) & (~legend_mask)\n\n        if rmin == rmax or cmin == cmax:\n            continue\n\n        tl = (rmin, cmin)\n        tr = (rmin, cmax)\n        bl = (rmax, cmin)\n        br = (rmax, cmax)\n\n        tl_anchor = _l_anchor_present(marker_pts, tl[0], tl[1], (0, 1), (1, 0))\n        tr_anchor = _l_anchor_present(marker_pts, tr[0], tr[1], (0, -1), (1, 0))\n        bl_anchor = _l_anchor_present(marker_pts, bl[0], bl[1], (0, 1), (-1, 0))\n        br_anchor = _l_anchor_present(marker_pts, br[0], br[1], (0, -1), (-1, 0))\n\n        score_tlbr = int(tl_anchor) + int(br_anchor)\n        score_trbl = int(tr_anchor) + int(bl_anchor)\n        assert score_tlbr != 0 or score_trbl != 0, \"at least one diagonal must have an L-anchor\"\n        assert score_tlbr != score_trbl, \"diagonal scores must not tie (tie-break path is unreachable)\"\n        if score_tlbr > score_trbl:\n            a, b = tr, bl\n        else:\n            a, b = tl, br\n\n        diamond = _diamond_mask(h, w, rmin, rmax, cmin, cmax, a, b)\n        out[diamond & (~protect)] = eff_fill\n\n    return out\n\n# --------------- generator (C1) ---------------\n\n# ── CFG: canvas & grid ──────────────────────────────────────────────\nGRID_H_RANGE = (10, 19)          # grid height bounds\nGRID_W_RANGE = (10, 19)          # grid width bounds\n\n# ── CFG: legend ─────────────────────────────────────────────────────\nLEGEND_COL_RANGE = (0, 2)        # legend left column (marker at c, fill at c+1)\nLEGEND_ENTRY_RANGE = (2, 5)      # number of legend entries\n\n# ── CFG: marker types ──────────────────────────────────────────────\nNOOP_PROB = 0.3                  # prob of one noop entry (marker with no pixels)\nBLOCK_PROB = 0.25                # prob of one 2x2 block entry\n\n# ── CFG: L-pair bbox shape ──────────────────────────────────────────\nBBOX_H_MAX = 19                  # max bbox height\nBBOX_W_MAX = 12                  # max bbox width\nBBOX_SHAPE_WEIGHTS = [0.75, 0.15, 0.10]  # [both>=3, h=2/w>=4, h>=4/w=2]\nTLBR_PROB = 0.8                  # prob of TL-BR diagonal (vs TR-BL)\n\n# ── CFG: distractor ────────────────────────────────────────────────\nDISTRACTOR_PROB = 0.25           # prob of adding a non-legend L-pair\n\n# ── CFG: retry budgets ─────────────────────────────────────────────\nBLOCK_RETRIES = 100              # placement attempts for a 2x2 block\nLPAIR_RETRIES = 150              # placement attempts for an L-pair\nDISTRACTOR_RETRIES = 60          # placement attempts for distractor\nGEN_RETRIES = 300                # outer generate_input retry budget\n\n_L_OFFSETS = {\n    \"TL\": [(0, 0), (0, 1), (1, 0)],\n    \"TR\": [(0, 0), (0, -1), (1, 0)],\n    \"BL\": [(0, 0), (0, 1), (-1, 0)],\n    \"BR\": [(0, 0), (0, -1), (-1, 0)],\n}\n\n\ndef _l_pair_cells(rmin: int, cmin: int, rmax: int, cmax: int, diag: str) -> list[tuple[int, int]]:\n    \"\"\"Return the 6 cells for an L-pair at opposite bbox corners. diag in {'TLBR','TRBL'}.\"\"\"\n    if diag == \"TLBR\":\n        anchors = [(\"TL\", rmin, cmin), (\"BR\", rmax, cmax)]\n    else:\n        anchors = [(\"TR\", rmin, cmax), (\"BL\", rmax, cmin)]\n    cells: list[tuple[int, int]] = []\n    for name, r, c in anchors:\n        for dr, dc in _L_OFFSETS[name]:\n            cells.append((r + dr, c + dc))\n    return cells\n\n\ndef _l_pair_valid_bbox(h: int, w: int) -> bool:\n    \"\"\"True if (h, w) avoids an L-anchor score tie.\n\n    Fails for (2,2), (2,3), (3,2). Safe: h>=3 and w>=3, or h==2 and w>=4, or h>=4 and w==2.\n    \"\"\"\n    if h < 2 or w < 2:\n        return False\n    if h == 2 and w <= 3:\n        return False\n    if w == 2 and h <= 3:\n        return False\n    return True\n\n\ndef _pick_bbox_size(H: int, W: int) -> tuple[int, int] | None:\n    \"\"\"Pick a random valid L-pair bbox size that fits in (H, W).\"\"\"\n    shape_choice = random.choices(\n        [\"both_ge3\", \"h2_w_ge4\", \"h_ge4_w2\"],\n        weights=BBOX_SHAPE_WEIGHTS,\n    )[0]\n    if shape_choice == \"both_ge3\":\n        bh = random.randint(3, min(BBOX_H_MAX, H))\n        bw = random.randint(3, min(BBOX_W_MAX, W))\n    elif shape_choice == \"h2_w_ge4\":\n        bh = 2\n        w_hi = min(BBOX_W_MAX, W)\n        if w_hi < 4:\n            return None\n        bw = random.randint(4, w_hi)\n    else:\n        h_hi = min(BBOX_H_MAX, H)\n        if h_hi < 4:\n            return None\n        bh = random.randint(4, h_hi)\n        bw = 2\n    if bh > H or bw > W or not _l_pair_valid_bbox(bh, bw):\n        return None\n    return bh, bw\n\n\ndef _try_place_l_pair(H: int, W: int, color: int, retries: int,\n                      can_place, do_place) -> bool:\n    \"\"\"Try to place an L-pair of `color` on the grid within `retries` attempts.\n\n    Returns True on success, False if all attempts failed.\n    \"\"\"\n    for _ in range(retries):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/89565ca0.py\"","aggregated_output":"from __future__ import annotations\n\nimport math\n\nimport numpy as np\n\nfrom arc_utils import bbox, colors_present, crop_bbox, get_bg, label_mask\nimport random\n\n\ndef _count_enclosed_regions(walls: np.ndarray) -> int:\n    labels, n_labels = label_mask(~walls, connectivity=4)\n    h, w = walls.shape\n    count = 0\n    for k in range(1, n_labels + 1):\n        coords = np.argwhere(labels == k)\n        assert coords.size > 0\n        touches_edge = (\n            np.any(coords[:, 0] == 0)\n            or np.any(coords[:, 0] == h - 1)\n            or np.any(coords[:, 1] == 0)\n            or np.any(coords[:, 1] == w - 1)\n        )\n        if not touches_edge:\n            count += 1\n    return int(count)\n\n\ndef _reconstruct_walls(mask: np.ndarray) -> np.ndarray:\n    h, _w = mask.shape\n    col_counts = mask.sum(axis=0)\n    v_threshold = max(3, math.ceil(0.45 * h))\n    vcols = [int(c) for c, n in enumerate(col_counts) if int(n) >= v_threshold]\n    if len(vcols) < 2:\n        return mask.copy()\n\n    row_counts = mask.sum(axis=1)\n    h_threshold = max(3, len(vcols) + 1)\n    hrows = [int(r) for r, n in enumerate(row_counts) if int(n) >= h_threshold]\n    assert len(hrows) >= 2\n\n    walls = np.zeros_like(mask, dtype=bool)\n\n    for r in hrows:\n        for c0, c1 in zip(vcols, vcols[1:]):\n            segment = mask[r, c0 : c1 + 1]\n            length = int(c1 - c0 + 1)\n            hits = int(segment.sum())\n            dense = hits >= max(2, math.ceil(0.45 * length))\n            interior_evidence = length > 2 and hits >= 2 and bool(segment[1:-1].any())\n            if dense or interior_evidence:\n                walls[r, c0 : c1 + 1] = True\n\n    for c in vcols:\n        for r0, r1 in zip(hrows, hrows[1:]):\n            segment = mask[r0 : r1 + 1, c]\n            length = int(r1 - r0 + 1)\n            hits = int(segment.sum())\n            if hits >= max(2, math.ceil(0.45 * length)):\n                walls[r0 : r1 + 1, c] = True\n\n    return walls\n\n\ndef _room_count_for_color(g: np.ndarray, color: int) -> int:\n    b = bbox(g == int(color))\n    assert b is not None\n    mask = crop_bbox(g == int(color), b).astype(bool)\n    walls = _reconstruct_walls(mask)\n    return _count_enclosed_regions(walls)\n\n\ndef _walls_for_color(g: np.ndarray, color: int) -> np.ndarray:\n    b = bbox(g == int(color))\n    assert b is not None\n    r0, c0, r1, c1 = b\n    mask = crop_bbox(g == int(color), b).astype(bool)\n    walls = _reconstruct_walls(mask)\n    out = np.zeros_like(g, dtype=bool)\n    out[r0 : r1 + 1, c0 : c1 + 1] = walls\n    return out\n\n\ndef _cover_order(g: np.ndarray, group: list[tuple[int, int, np.ndarray]]) -> list[tuple[int, int, np.ndarray]]:\n    if len(group) == 1:\n        return group\n\n    by_color = {int(item[0]): item for item in group}\n    above: dict[int, set[int]] = {color: set() for color, _rooms, _walls in group}\n    indegree: dict[int, int] = {color: 0 for color, _rooms, _walls in group}\n\n    for i, (ca, _ra, wa) in enumerate(group):\n        for cb, _rb, wb in group[i + 1 :]:\n            overlap = wa & wb\n            if not bool(overlap.any()):\n                continue\n            visible = set(int(v) for v in np.unique(g[overlap]))\n            top_colors = visible & {int(ca), int(cb)}\n            assert len(top_colors) == 1\n            top = top_colors.pop()\n            under = int(cb) if top == int(ca) else int(ca)\n            if top not in above[under]:\n                above[under].add(top)\n                indegree[top] += 1\n\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    remaining = set(by_color)\n    while remaining:\n        ready = [color for color in remaining if indegree[color] == 0]\n        assert len(ready) == 1\n        color = ready[0]\n        remaining.remove(color)\n        ordered.append(by_color[color])\n        for nxt in above[color]:\n            indegree[nxt] -= 1\n    return ordered\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Convert each colored partitioned frame into a horizontal bar whose length is its number of enclosed regions.\n\n    Input structure:\n    - Black background with several axis-aligned colored line drawings.\n    - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.\n    - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.\n\n    Rule:\n    - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.\n    - Count the 4-connected background regions fully enclosed by those reconstructed walls.\n    - The color with no enclosed region is the noise/pad color.\n    - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.\n\n    Key insight:\n    - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = int(get_bg(g))\n    assert bg == 0\n\n    counts: list[tuple[int, int, np.ndarray]] = []\n    for color in colors_present(g, exclude={bg}):\n        rooms = _room_count_for_color(g, int(color))\n        walls = _walls_for_color(g, int(color))\n        counts.append((int(color), int(rooms), walls))\n\n    drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]\n    pad_colors = [color for color, rooms, _walls in counts if rooms == 0]\n    assert drawings\n    assert len(pad_colors) == 1\n\n    pad = int(pad_colors[0])\n    ordered: list[tuple[int, int, np.ndarray]] = []\n    for rooms in sorted({rooms for _color, rooms, _walls in drawings}):\n        group = [item for item in drawings if item[1] == rooms]\n        ordered.extend(_cover_order(g, group))\n\n    width = max(rooms for _color, rooms, _walls in ordered)\n\n    out = np.full((len(ordered), width), pad, dtype=int)\n    for r, (color, rooms, _walls) in enumerate(ordered):\n        out[r, :rooms] = int(color)\n    return out\n\n# --------------- generator (claude-opus-4-6) ---------------\n\n# ---- CFG: Tunable generation parameters ----\n_FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle\n_ROOM_COUNT_RANGE = (1, 6)            # rooms per frame\n_TIE_PROBABILITY = 0.35              # chance of one tied room-count pair\n_GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)\n    5: (25, 30, 25, 30, 16, 18),\n    4: (22, 30, 22, 30, 18, 22),\n    3: (20, 30, 20, 30, 22, 25),\n}\n_CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame\n_NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise\n_WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise\n_EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force\n_OVERLAP_RETRY = 100                 # attempts to place overlapping frame\n_GEN_RETRIES = 300                   # outer retry limit\n\n\ndef _random_gaps(n: int, min_gap: int, max_gap: int, max_total: int) -> list[int] | None:\n    \"\"\"Generate n gaps each in [min_gap, max_gap] with sum <= max_total.\"\"\"\n    if n * min_gap > max_total:\n        return None\n    gaps = [min_gap] * n\n    remaining = max_total - sum(gaps)\n    for i in range(n):\n        extra = min(max_gap - gaps[i], remaining)\n        if extra > 0:\n            add = random.randint(0, extra)\n            gaps[i] += add\n            remaining -= add\n    random.shuffle(gaps)\n    return gaps\n\n\ndef _build_frame(target_rooms: int, max_h: int = 22, max_w: int = 25) -> np.ndarray | None:\n    \"\"\"Build a boolean wall array with exactly target_rooms enclosed regions.\"\"\"\n    if target_rooms == 1:\n        gap_h = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_h - 2))\n        gap_w = random.randint(_CELL_GAP_RANGE[0], max(_CELL_GAP_RANGE[0], max_w - 2))\n        h, w = gap_h + 2, gap_w + 2\n        walls = np.zeros((h, w), dtype=bool)\n        walls[0, :] = True\n        walls[h - 1, :] = True\n        walls[:, 0] = True\n        walls[:, w - 1] = True\n        return walls\n\n    # For target_rooms >= 2: grid of cells, then selectively merge\n    possible_configs = []\n    for nv in range(2, 6):\n        for nh in range(2, 5):\n            cells = (nv - 1) * (nh - 1)\n            if target_rooms <= cells <= target_rooms + 4:\n                possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        for nv in range(2, 7):\n            for nh in range(2, 6):\n                cells = (nv - 1) * (nh - 1)\n                if cells >= target_rooms:\n                    possible_configs.append((nv, nh, cells))\n    if not possible_configs:\n        return None\n\n    n_vcols, n_hrows, total_cells = random.choice(possible_configs)\n    n_row_gaps = n_hrows - 1\n    n_col_gaps = n_vcols - 1\n    min_gap, max_gap = _CELL_GAP_RANGE\n\n    if min_gap * n_row_gaps > max_h - 1 or min_gap * n_col_gaps > max_w - 1:\n        return None\n\n    row_gaps = _random_gaps(n_row_gaps, min_gap, max_gap, max_h - 1)\n    col_gaps = _random_gaps(n_col_gaps, min_gap, max_gap, max_w - 1)\n    if row_gaps is None or col_gaps is None:\n        return None\n\n    # Compute line positions from cumulative gaps\n    vcol_positions = [0]\n    for gap in col_gaps:\n        vcol_positions.append(vcol_positions[-1] + gap)\n    hrow_positions = [0]\n    for gap in row_gaps:\n        hrow_positions.append(hrow_positions[-1] + gap)\n\n    frame_h = hrow_positions[-1] + 1\n    frame_w = vcol_positions[-1] + 1\n    walls = np.zeros((frame_h, frame_w), dtype=bool)\n    for r in hrow_positions:\n        walls[r, :] = True\n    for c in vcol_positions:\n        walls[:, c] = True\n\n    cells_to_merge = total_cells - target_rooms\n    if cells_to_merge == 0:\n        return walls\n","exit_code":0,"status":"completed"}}
