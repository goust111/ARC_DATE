{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/581f7754.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter\nimport numpy as np\nfrom arc_utils import find_components, get_bg, neighbors4, paste\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide multi-color sprites to align their marker pixels with matching isolated border anchors.\n\n    Input structure:\n    - bg = most common color.\n    - Multi-color sprites in the interior; each has a minority-color \"marker\" pixel.\n    - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.\n\n    Rule:\n    - Match each sprite to the border anchor sharing its marker color.\n    - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.\n    - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.\n\n    Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def is_border(r: int, c: int) -> bool:\n        return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))\n\n    # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---\n    anchors_by_color: dict[int, tuple[int, int]] = {}\n    for r in range(H):\n        for c in range(W):\n            if not is_border(r, c):\n                continue\n            v = int(g[r, c])\n            if v == int(bg):\n                continue\n            ok = True\n            for rr, cc in neighbors4(int(r), int(c)):\n                if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):\n                    ok = False\n                    break\n            if ok and v not in anchors_by_color:\n                anchors_by_color[int(v)] = (int(r), int(c))\n\n    assert not (not anchors_by_color)\n\n    anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}\n\n    # --- STEP 2) Extract all foreground connected components as candidate sprites. ---\n    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format=\"dict\")\n\n    def component_marker_color(coords: np.ndarray) -> int | None:\n        # For multi-color sprites, the marker color is the least frequent color inside the component.\n        vals = [int(g[int(r), int(c)]) for r, c in coords]\n        cnt = Counter(vals)\n        if len(cnt) <= 1:\n            return None\n        return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])\n\n    def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:\n        # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).\n        pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]\n        if not pts:\n            return None\n        if len(pts) == 1:\n            return pts[0]\n        S = {(int(r), int(c)) for r, c in coords}\n        for r, c in pts:\n            for rr, cc in neighbors4(int(r), int(c)):\n                if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):\n                    return (int(r), int(c))\n        return pts[0]\n\n    moves: list[tuple[np.ndarray, int, int]] = []\n\n    for comp in comps:\n        coords = comp[\"coords\"]\n        if coords.size == 0:\n            continue\n\n        # --- STEP 3) Decide marker color for this component. ---\n        marker_col = component_marker_color(coords)\n        if marker_col is None:\n            # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.\n            if int(coords.shape[0]) != 1:\n                continue\n            r, c = map(int, coords[0])\n            v = int(g[r, c])\n            if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:\n                continue\n            marker_col = int(v)\n\n        if int(marker_col) not in anchors_by_color:\n            continue\n\n        mp = marker_pixel(coords, int(marker_col))\n        if mp is None:\n            continue\n\n        ar, ac = anchors_by_color[int(marker_col)]\n\n        # --- STEP 4) Compute translation (dr,dc). ---\n        on_top_bottom = int(ar) in (0, int(H - 1))\n        on_left_right = int(ac) in (0, int(W - 1))\n        horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner\n\n        dr = 0\n        dc = 0\n        if horizontal:\n            dc = int(ac - mp[1])\n        else:\n            dr = int(ar - mp[0])\n\n        moves.append((coords, int(dr), int(dc)))\n\n    out = g.copy()\n\n    # --- STEP 5) Apply all moves. ---\n    # Clear moved components first (prevents collisions with their original locations).\n    for coords, _dr, _dc in moves:\n        out[coords[:, 0], coords[:, 1]] = int(bg)\n\n    # Paste moved components:\n    # - clip out-of-bounds pixels\n    # - do not overwrite existing non-bg pixels\n    for coords, dr, dc in moves:\n        for r, c in coords:\n            rr = int(r) + int(dr)\n            cc = int(c) + int(dc)\n            if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):\n                out[rr, cc] = int(g[int(r), int(c)])\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# CFG: palette and canvas bounds.\n_COLORS = tuple(range(10))\n_BG_COLOR_RANGE = (1, 8)\n_GRID_HEIGHT_RANGE = (10, 22)\n_GRID_WIDTH_RANGE = (8, 22)\n\n# CFG: placement isolation and anchor location.\n_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))\n_INNER_BORDER_GAP = 1\n_ANCHOR_EDGE_MARGIN = 2\n_ISOLATION_RADIUS = 1\n\n# CFG: anchor, sprite, and retry counts.\n_ANCHOR_COUNT_RANGE = (1, 3)\n_SPRITE_COUNT_RANGE = (3, 5)\n_BODY_AREA_RANGE = (4, 13)\n_GEN_RETRY_LIMIT = 300\n\n# CFG: body geometry and shape mix.\n_BODY_HEIGHT_RANGE = (2, 5)\n_BODY_WIDTH_RANGE = (3, 7)\n_FRAME_HEIGHT_RANGE = (3, 5)\n_FRAME_WIDTH_RANGE = (3, 7)\n_FRAME_MIN_AREA = 8\n_FRAME_MAX_GAP = 3\n_FRAME_BODY_THRESHOLD = 0.28\n_WIDE_BODY_THRESHOLD = 0.55\n_SYMMETRIC_BODY_THRESHOLD = 0.82\n_SYMMETRIC_TRANSPOSE_MIN_HEIGHT = 3\n_SYMMETRIC_TRANSPOSE_PROB = 0.45\n_MARKER_INTERIOR_PROB = 0.65\n_FLIP_PROB = 0.5\n\n# CFG: optional singleton distractors.\n_DISTRACTOR_PROB = 0.15\n_DISTRACTOR_COUNT_RANGE = (1, 4)\n\n_GROW_BODY_SEEDS = [\n    {(0, 0), (0, 1), (0, 2), (1, 0)},\n    {(0, 0), (0, 1), (0, 2), (1, 2)},\n    {(0, 0), (1, 0), (1, 1), (1, 2)},\n    {(0, 2), (1, 0), (1, 1), (1, 2)},\n    {(0, 1), (1, 0), (1, 1), (1, 2)},\n]\n\n\ndef _norm(cells):\n    r0 = min(r for r, _c in cells)\n    c0 = min(c for _r, c in cells)\n    return {(r - r0, c - c0) for r, c in cells}\n\n\ndef _bbox(cells):\n    return (\n        min(r for r, _c in cells),\n        min(c for _r, c in cells),\n        max(r for r, _c in cells),\n        max(c for _r, c in cells),\n    )\n\n\ndef _flip(cells):\n    cells = set(cells)\n    if random.random() < _FLIP_PROB:\n        mc = max(c for _r, c in cells)\n        cells = {(r, mc - c) for r, c in cells}\n    if random.random() < _FLIP_PROB:\n        mr = max(r for r, _c in cells)\n        cells = {(mr - r, c) for r, c in cells}\n    return _norm(cells)\n\n\ndef _inclusive_range(bounds):\n    return range(int(bounds[0]), int(bounds[1]) + 1)\n\n\ndef _frontier_cells(cells, height, width):\n    \"\"\"Return empty 4-neighbor cells inside the shape canvas.\"\"\"\n    frontier = []\n    for r, c in cells:\n        for dr, dc in _NEIGHBORS4:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < height and 0 <= cc < width and (rr, cc) not in cells:\n                frontier.append((rr, cc))\n    return frontier\n\n\ndef _grow_body(area):\n    choices = [\n        (h, w)\n        for h in _inclusive_range(_BODY_HEIGHT_RANGE)\n        for w in _inclusive_range(_BODY_WIDTH_RANGE)\n        if h * w >= area\n    ]\n    h, w = random.choice(choices)\n    cells = set(random.choice(_GROW_BODY_SEEDS))\n    while len(cells) < area:\n        frontier = _frontier_cells(cells, h, w)\n        if not frontier:\n            return _grow_body(area)\n        cells.add(random.choice(frontier))\n    return _flip(cells)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/3ad05f52.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/3ad05f52.py\"","aggregated_output":"from collections import Counter, deque\n\nimport numpy as np\n\nfrom arc_utils import bbox_coords, colors_present, draw_line, find_components, get_bg, paste\nimport random\n\n\ndef _distances_from(sources: np.ndarray, passable: np.ndarray) -> np.ndarray:\n    h, w = passable.shape\n    dist = np.full((h, w), -1, dtype=int)\n    q: deque[tuple[int, int]] = deque()\n    for r, c in sources:\n        rr = int(r)\n        cc = int(c)\n        assert passable[rr, cc]\n        dist[rr, cc] = 0\n        q.append((rr, cc))\n\n    while q:\n        r, c = q.popleft()\n        nd = int(dist[r, c]) + 1\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n            nr = r + dr\n            nc = c + dc\n            if 0 <= nr < h and 0 <= nc < w and passable[nr, nc] and dist[nr, nc] < 0:\n                dist[nr, nc] = nd\n                q.append((nr, nc))\n    return dist\n\n\ndef _framed_square_rooms(g: np.ndarray, wall: int, sizes: set[int]) -> list[tuple[int, int, int]]:\n    h, w = g.shape\n    rooms: list[tuple[int, int, int]] = []\n    for n in sorted(sizes):\n        assert n > 1\n        for r in range(h - n + 1):\n            for c in range(w - n + 1):\n                if np.any(g[r : r + n, c : c + n] == wall):\n                    continue\n\n                side_wall_counts: list[int] = []\n                if r > 0:\n                    side_wall_counts.append(int(np.count_nonzero(g[r - 1, c : c + n] == wall)))\n                if r + n < h:\n                    side_wall_counts.append(int(np.count_nonzero(g[r + n, c : c + n] == wall)))\n                if c > 0:\n                    side_wall_counts.append(int(np.count_nonzero(g[r : r + n, c - 1] == wall)))\n                if c + n < w:\n                    side_wall_counts.append(int(np.count_nonzero(g[r : r + n, c + n] == wall)))\n\n                if len(side_wall_counts) >= 3 and all(count >= n - 1 for count in side_wall_counts):\n                    rooms.append((r, c, n))\n    return rooms\n\n\ndef _component_bboxes(mask: np.ndarray) -> list[tuple[int, int, int, int, int]]:\n    h, w = mask.shape\n    seen = np.zeros_like(mask, dtype=bool)\n    components: list[tuple[int, int, int, int, int]] = []\n    for r in range(h):\n        for c in range(w):\n            if not mask[r, c] or seen[r, c]:\n                continue\n            q: deque[tuple[int, int]] = deque([(r, c)])\n            seen[r, c] = True\n            r0 = r1 = r\n            c0 = c1 = c\n            area = 0\n            while q:\n                rr, cc = q.popleft()\n                area += 1\n                r0 = min(r0, rr)\n                c0 = min(c0, cc)\n                r1 = max(r1, rr)\n                c1 = max(c1, cc)\n                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n                    nr = rr + dr\n                    nc = cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\n                        seen[nr, nc] = True\n                        q.append((nr, nc))\n            components.append((r0, c0, r1, c1, area))\n    return components\n\n\ndef _overlap_len(a0: int, a1: int, b0: int, b1: int) -> int:\n    return max(0, min(a1, b1) - max(a0, b0) + 1)\n\n\ndef _middle_fill_bounded_by_side_rooms(\n    bbox: tuple[int, int, int, int],\n    rooms: list[tuple[int, int, int]],\n) -> bool:\n    r0, c0, r1, c1 = bbox\n    left: list[tuple[int, int]] = []\n    right: list[tuple[int, int]] = []\n    above: list[tuple[int, int]] = []\n    below: list[tuple[int, int]] = []\n\n    for r, c, n in rooms:\n        rr1 = r + n - 1\n        cc1 = c + n - 1\n        row_overlap = _overlap_len(r0, r1, r, rr1)\n        col_overlap = _overlap_len(c0, c1, c, cc1)\n        if row_overlap > 0 and 1 <= c0 - cc1 <= 2:\n            left.append((r, rr1))\n        if row_overlap > 0 and 1 <= c - c1 <= 2:\n            right.append((r, rr1))\n        if col_overlap > 0 and 1 <= r0 - rr1 <= 2:\n            above.append((c, cc1))\n        if col_overlap > 0 and 1 <= r - r1 <= 2:\n            below.append((c, cc1))\n\n    def spans_contain(intervals_a: list[tuple[int, int]], intervals_b: list[tuple[int, int]], lo: int, hi: int) -> bool:\n        if not intervals_a or not intervals_b:\n            return False\n        a0 = min(start for start, _end in intervals_a)\n        a1 = max(end for _start, end in intervals_a)\n        b0 = min(start for start, _end in intervals_b)\n        b1 = max(end for _start, end in intervals_b)\n        return lo >= a0 and hi <= a1 and lo >= b0 and hi <= b1\n\n    return spans_contain(left, right, r0, r1) or spans_contain(above, below, c0, c1)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Paint the maze corridor and framed rooms lying on shortest paths between the two colored endpoint components.\n\n    Input structure\n    - The grid has a dominant background, one wall color forming thin orthogonal frames, and one endpoint/fill color.\n    - The endpoint/fill color forms exactly two 4-connected solid rectangular components; their larger side lengths define the framed room sizes.\n\n    Rule\n    - Treat wall pixels as blocked and every other pixel as passable.\n    - Find every passable pixel that lies on a shortest 4-connected path between the two endpoint components.\n    - Also fill any framed square room of an endpoint-derived size that intersects that shortest-path mask.\n\n    Key insight\n    - Shortest paths identify the route through open connector corridors, while the wall-bordered square rooms need to be expanded from the route centerline to their full interior.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n\n    bg = get_bg(g)\n    counts = Counter(map(int, g.flat))\n\n    non_bg = colors_present(g, exclude={bg})\n    assert len(non_bg) == 2\n    assert counts[bg] > max(counts[color] for color in non_bg)\n    non_bg_counts = {color: int(np.count_nonzero(g == color)) for color in non_bg}\n    wall_count = max(non_bg_counts.values())\n    wall_candidates = [color for color, count in non_bg_counts.items() if count == wall_count]\n    assert len(wall_candidates) == 1\n    wall = wall_candidates[0]\n    paint_candidates = [color for color in non_bg if color != wall]\n    assert len(paint_candidates) == 1\n    paint = paint_candidates[0]\n    assert non_bg_counts[wall] > non_bg_counts[paint]\n\n    endpoints = find_components(g, bg=bg, colors=[paint], connectivity=4)\n    assert len(endpoints) == 2\n    endpoint_coords = [component[\"coords\"] for component in endpoints]\n\n    room_sizes: set[int] = set()\n    for coords in endpoint_coords:\n        r0, c0, r1, c1 = bbox_coords(coords)\n        bh = r1 - r0 + 1\n        bw = c1 - c0 + 1\n        assert coords.shape[0] == bh * bw\n        room_sizes.add(max(bh, bw))\n\n    passable = g != wall\n    dist0 = _distances_from(endpoint_coords[0], passable)\n    dist1 = _distances_from(endpoint_coords[1], passable)\n    endpoint_distances = [int(dist0[r, c]) for r, c in endpoint_coords[1]]\n    reachable_distances = [d for d in endpoint_distances if d >= 0]\n    assert len(reachable_distances) == len(endpoint_distances)\n    shortest = min(reachable_distances)\n\n    route = (dist0 >= 0) & (dist1 >= 0) & (dist0 + dist1 == shortest)\n    assert np.any(route)\n\n    fill = route.copy()\n    rooms = _framed_square_rooms(g, wall, room_sizes)\n    assert rooms\n    for r, c, n in rooms:\n        if np.any(route[r : r + n, c : c + n]):\n            fill[r : r + n, c : c + n] = True\n\n    room_mask = np.zeros_like(fill, dtype=bool)\n    for r, c, n in rooms:\n        room_mask[r : r + n, c : c + n] = True\n    open_fill = fill & (g == bg) & ~room_mask\n    for r0, c0, r1, c1, area in _component_bboxes(open_fill):\n        if r1 > r0 and c1 > c0 and area >= 20:\n            assert _middle_fill_bounded_by_side_rooms(\n                (r0, c0, r1, c1),\n                rooms,\n            ), \"middle fill must stay within the facing room-frame spans\"\n\n    H, W = g.shape\n    for r, c, n in rooms:\n        has_doorway = False\n        if r > 0:\n            has_doorway = has_doorway or np.any(g[r - 1, c : c + n] != wall)\n        if r + n < H:\n            has_doorway = has_doorway or np.any(g[r + n, c : c + n] != wall)\n        if c > 0:\n            has_doorway = has_doorway or np.any(g[r : r + n, c - 1] != wall)\n        if c + n < W:\n            has_doorway = has_doorway or np.any(g[r : r + n, c + n] != wall)\n        if has_doorway:\n            assert np.any(fill[r : r + n, c : c + n]), \"rooms with doorways must be on the shortest path\"\n\n    out = g.copy()\n    out[fill & (g == bg)] = paint\n    return out\n\n# --------------- generator (attempt 2 refined middle-fill) ---------------\n\nBG = 0\nWALL = 8\nPAINT_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]\n\n# Canvas bounds used by the observed evaluation examples.\nROW_MIN = 22\nROW_MAX = 29\nCOL_MIN = 24\nCOL_MAX = 28\n\n# Room-grid geometry and room-count filters.\nROOM_SIZE_RANGE = range(3, 6)\nROOM_GRID_RANGE = range(1, 8)\nBLOCK_ROOM_MIN = 3\nBLOCK_ROOM_MAX = 14\nTOTAL_ROOM_MIN = 7\nTOTAL_ROOM_MAX = 22\nGAP_RANGE = range(3, 8)\n","exit_code":0,"status":"completed"}}
