{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/57edb29d.py\"","aggregated_output":"from collections import Counter\n\nimport numpy as np\n\nfrom arc_utils import crop_bbox, find_components\nimport random\n\n\ndef _unique_most_common(values: np.ndarray) -> int:\n    counts = Counter(map(int, values.reshape(-1)))\n    max_count = max(counts.values())\n    winners = [color for color, count in counts.items() if count == max_count]\n    assert len(winners) == 1, \"expected a unique dominant color\"\n    return int(winners[0])\n\n\ndef _boundary_bg(g: np.ndarray) -> int:\n    boundary = np.concatenate((g[0, :], g[-1, :], g[:, 0], g[:, -1]))\n    return _unique_most_common(boundary)\n\n\ndef _runs(cols: np.ndarray) -> list[tuple[int, int]]:\n    assert cols.size > 0, \"expected a nonempty marker row\"\n    spans = []\n    start = end = int(cols[0])\n    for col in map(int, cols[1:]):\n        if col == end + 1:\n            end = col\n        else:\n            spans.append((start, end))\n            start = end = col\n    spans.append((start, end))\n    return spans\n\n\ndef _map_row(row: int, src_h: int, dst_h: int) -> int:\n    top = int(row)\n    bottom = int(src_h - 1 - row)\n    assert top != bottom, \"marker row must be closer to one horizontal edge\"\n    mapped = top if top < bottom else int(dst_h - 1 - bottom)\n    assert 0 <= mapped < dst_h, \"mapped marker row must fit in target rectangle\"\n    return int(mapped)\n\n\ndef _map_col_run(c0: int, c1: int, src_w: int, dst_w: int) -> tuple[int, int]:\n    mid2 = int(src_w - 1)\n    if c0 == c1:\n        left = int(c0)\n        right = int(src_w - 1 - c0)\n        assert left != right, \"single marker pixel must be closer to one vertical edge\"\n        mapped = left if left < right else int(dst_w - 1 - right)\n        assert 0 <= mapped < dst_w, \"mapped marker column must fit in target rectangle\"\n        return int(mapped), int(mapped)\n\n    if 2 * int(c1) <= mid2:\n        start, end = int(c0), int(c1)\n    elif 2 * int(c0) >= mid2:\n        start = int(dst_w - 1 - (src_w - 1 - c0))\n        end = int(dst_w - 1 - (src_w - 1 - c1))\n    else:\n        start = int(c0)\n        end = int(dst_w - 1 - (src_w - 1 - c1))\n\n    assert 0 <= start <= end < dst_w, \"mapped marker run must fit in target rectangle\"\n    return int(start), int(end)\n\n\ndef _adapt_marker_mask(src: np.ndarray, marker_color: int, dst_shape: tuple[int, int]) -> np.ndarray:\n    src_h, src_w = map(int, src.shape)\n    dst_h, dst_w = map(int, dst_shape)\n    src_mask = src == int(marker_color)\n    assert bool(src_mask.any()), \"source rectangle must contain marker pixels\"\n\n    out = np.zeros((dst_h, dst_w), dtype=bool)\n    for row in map(int, np.flatnonzero(src_mask.any(axis=1))):\n        dst_row = _map_row(row, src_h, dst_h)\n        for c0, c1 in _runs(np.flatnonzero(src_mask[row, :])):\n            dst_c0, dst_c1 = _map_col_run(c0, c1, src_w, dst_w)\n            out[dst_row, dst_c0 : dst_c1 + 1] = True\n    return out\n\n\ndef _row_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:\n    return max(int(a[0]), int(b[0])) <= min(int(a[2]), int(b[2]))\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extract the single plain rectangle and redraw it with the aligned rectangles' border-relative marker pattern.\n\n    Input structure:\n    - The boundary color is the background/separator.\n    - Foreground objects are dense rectangular regions; exactly one rectangle has only its base color.\n    - Other rectangles contain their base color plus marker pixels.\n\n    Rule:\n    - Crop the only plain rectangle; this crop is the output canvas.\n    - Use marked rectangles whose row span overlaps the plain rectangle's row span.\n    - Transfer their marker pixels by preserving each marker run's distance from the nearest rectangle edges.\n\n    Key insight:\n    - The marked rectangles are examples of an edge-relative pattern, so the missing plain rectangle receives the same pattern resized to its own dimensions.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2, \"expected a 2D grid\"\n    bg = _boundary_bg(g)\n\n    objects = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False):\n        bbox = tuple(map(int, comp[\"bbox\"]))\n        sub = crop_bbox(g, bbox)\n        assert np.all(sub != bg), \"foreground rectangles must be dense\"\n\n        base_color = _unique_most_common(sub)\n        marker_colors = set(map(int, sub.reshape(-1))) - {int(base_color)}\n        objects.append(\n            {\n                \"bbox\": bbox,\n                \"sub\": sub,\n                \"base_color\": int(base_color),\n                \"marker_colors\": marker_colors,\n            }\n        )\n\n    plain = [obj for obj in objects if not obj[\"marker_colors\"]]\n    assert len(plain) == 1, \"expected exactly one plain rectangle\"\n    target = plain[0]\n    tr0, tc0, tr1, tc1 = target[\"bbox\"]\n    target_shape = (int(tr1 - tr0 + 1), int(tc1 - tc0 + 1))\n\n    sources = [\n        obj\n        for obj in objects\n        if obj[\"marker_colors\"] and _row_overlap(obj[\"bbox\"], target[\"bbox\"])\n    ]\n    assert sources, \"expected at least one marked rectangle aligned with the plain rectangle\"\n\n    marker_colors = set()\n    for source in sources:\n        marker_colors.update(source[\"marker_colors\"])\n    assert len(marker_colors) == 1, \"aligned marked rectangles must share one marker color\"\n    marker_color = int(next(iter(marker_colors)))\n\n    masks = []\n    for source in sources:\n        assert source[\"marker_colors\"] == {marker_color}, \"source must contain only the shared marker color\"\n        masks.append(_adapt_marker_mask(source[\"sub\"], marker_color, target_shape))\n\n    pattern = masks[0]\n    for mask in masks[1:]:\n        assert np.array_equal(mask, pattern), \"aligned marked rectangles must encode the same pattern\"\n\n    out = np.full(target_shape, int(target[\"base_color\"]), dtype=int)\n    out[pattern] = marker_color\n    return out\n\n# --------------- generator (att1, Claude) ---------------\n\n# Canvas and separator colors.\nBG = 4\nNON_BG = [c for c in range(10) if c != BG]\nGRID_H_RANGE = (20, 28)\nGRID_W_RANGE = (20, 28)\nBORDER_GAP = 1\nBAND_GAP = 1\n# Rectangle counts and dimensions.\nRECT_COUNT_RANGE = (3, 6)\nOVERLAP_MARKED_COUNT = 2\nRECT_H_RANGE = (5, 20)\nRECT_W_RANGE = (5, 12)\nPLAIN_EXTRA_ROW_ROOM = 2\n# Marker pattern sampling.\nMARKER_PAIR_COUNT_RANGE = (1, 3)\nMARKER_EDGE_PAIRS = [(1, 1), (1, 2), (2, 1), (2, 2)]\n# Retry budget.\nGENERATION_ATTEMPTS = 300\n\n\ndef _stamp_pattern(rect: np.ndarray, marker: int, pairs: list[tuple[int, int]]):\n    h, w = rect.shape\n    for nr, nc in pairs:\n        for r in (nr, h - 1 - nr):\n            for c in (nc, w - 1 - nc):\n                rect[r, c] = marker\n\n\ndef _pick_dim(near_vals: list[int], lo: int, hi: int) -> int:\n    min_dim = max(lo, max(2 * nv + 2 for nv in near_vals))\n    cands = [d for d in range(min_dim, hi + 1) if all(d >= 2 * nv + 2 and d != 2 * nv + 1 for nv in near_vals)]\n    return random.choice(cands) if cands else -1\n\n\ndef _choose_marker_pattern():\n    n_pairs = random.randint(*MARKER_PAIR_COUNT_RANGE)\n    pairs = sorted(random.sample(MARKER_EDGE_PAIRS, min(n_pairs, len(MARKER_EDGE_PAIRS))))\n    near_rows = [p[0] for p in pairs]\n    near_cols = [p[1] for p in pairs]\n    return pairs, near_rows, near_cols\n\n\ndef _choose_palette(n_rects: int):\n    needed = n_rects + 1  # base colors + marker\n    if needed > len(NON_BG):\n        return None\n    chosen = random.sample(NON_BG, needed)\n    plain_base, marker_color = chosen[0], chosen[-1]\n    marked_bases = chosen[1:-1]\n    return plain_base, marker_color, marked_bases\n\n\ndef _make_marked_rect(h: int, w: int, base: int, marker: int, pairs: list[tuple[int, int]]) -> np.ndarray:\n    rect = np.full((h, w), base, dtype=int)\n    _stamp_pattern(rect, marker, pairs)\n    return rect\n\n\ndef _choose_plain_shape(near_rows: list[int], near_cols: list[int], avail_h: int, avail_w: int):\n    hp = _pick_dim(near_rows, RECT_H_RANGE[0], min(RECT_H_RANGE[1], avail_h - PLAIN_EXTRA_ROW_ROOM))\n    wp = _pick_dim(near_cols, RECT_W_RANGE[0], min(RECT_W_RANGE[1], avail_w))\n    if hp < 0 or wp < 0:\n        return None\n    return hp, wp\n\n\ndef _has_overlap_width_budget(avail_w: int, plain_w: int) -> bool:\n    remaining_w = avail_w - plain_w - OVERLAP_MARKED_COUNT * BAND_GAP\n    max_overlap_w = remaining_w // OVERLAP_MARKED_COUNT\n    if max_overlap_w >= RECT_W_RANGE[0]:\n        return True\n    return remaining_w >= RECT_W_RANGE[0]\n\n\ndef _build_overlap_rects(avail_h, avail_w, plain_w, near_rows, near_cols, marked_bases, marker_color, pairs):\n    if not _has_overlap_width_budget(avail_w, plain_w):\n        return None\n\n    min_w, max_w = RECT_W_RANGE\n    min_h, max_h = RECT_H_RANGE\n    overlap_rects = []\n    remaining_w = avail_w - plain_w - OVERLAP_MARKED_COUNT * BAND_GAP\n    for i in range(OVERLAP_MARKED_COUNT):\n        if i == 0:\n            max_w_i = min(remaining_w - min_w, max_w)\n        else:\n            max_w_i = min(remaining_w, max_w)\n        wm = _pick_dim(near_cols, min_w, max(min_w, max_w_i))\n        if wm < 0:\n            return None\n        remaining_w -= wm\n        if remaining_w < 0:\n            return None\n        hm = _pick_dim(near_rows, min_h, min(max_h, avail_h))\n        if hm < 0:\n            return None\n        overlap_rects.append(_make_marked_rect(hm, wm, marked_bases[i], marker_color, pairs))\n    return overlap_rects\n\n\ndef _build_non_overlap_rects(n_marked, overlap_band_h, avail_h, avail_w, near_rows, near_cols, marked_bases, marker_color, pairs):\n    min_h, max_h = RECT_H_RANGE\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/291dc1e1.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/291dc1e1.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import bbox_coords, components_mask, crop_bbox, get_bg, paste, random_free_location\nfrom arc_utils import paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Reorder and stack rectangles by proximity to two colored edge lines.\n\n    Input structure:\n    - bg = most common color.\n    - Two edge lines (h + v) meet at a corner marked by a unique color.\n    - \"Blue\" line is color 1 if present, else the longer line; other is \"red.\"\n    - Solid rectangles in the interior.\n\n    Rule:\n    - Sort rectangles by (distance to blue edge, distance to red edge).\n    - If the blue edge is vertical, rotate each rectangle 90° CCW.\n    - Stack top-to-bottom, centered horizontally.\n\n    Key insight: Edge-line colors encode a coordinate system; proximity to each axis determines stacking order and rotation.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # --- locate the marked corner ---\n    corners = [(0, 0), (0, int(W - 1)), (int(H - 1), 0), (int(H - 1), int(W - 1))]\n    corner = None\n    for r, c in corners:\n        if int(g[r, c]) == int(bg):\n            continue\n        nbr = []\n        if r == 0:\n            nbr.append(int(g[r + 1, c]))\n        if r == H - 1:\n            nbr.append(int(g[r - 1, c]))\n        if c == 0:\n            nbr.append(int(g[r, c + 1]))\n        if c == W - 1:\n            nbr.append(int(g[r, c - 1]))\n        if nbr and all(int(n) != int(g[r, c]) for n in nbr):\n            corner = (int(r), int(c))\n            break\n    assert corner is not None\n\n    cr, cc = map(int, corner)\n    marker = int(g[cr, cc])\n\n    # --- line colors adjacent to the corner ---\n    hstep = 1 if cc == 0 else -1\n    vstep = 1 if cr == 0 else -1\n    hcol = int(g[cr, cc + hstep])\n    vcol = int(g[cr + vstep, cc])\n\n    # Choose \"blue\" line color.\n    if hcol == 1 or vcol == 1:\n        blue_col = 1\n        red_col = int(vcol if hcol == 1 else hcol)\n    else:\n        # Fallback: longer line is blue.\n        hlen = 0\n        c = int(cc + hstep)\n        while 0 <= c < W and int(g[cr, c]) == int(hcol):\n            hlen += 1\n            c += int(hstep)\n        vlen = 0\n        r = int(cr + vstep)\n        while 0 <= r < H and int(g[r, cc]) == int(vcol):\n            vlen += 1\n            r += int(vstep)\n        if vlen >= hlen:\n            blue_col = int(vcol)\n            red_col = int(hcol)\n        else:\n            blue_col = int(hcol)\n            red_col = int(vcol)\n\n    blue_orient = \"h\" if int(hcol) == int(blue_col) else \"v\"\n    red_orient = \"h\" if int(hcol) == int(red_col) else \"v\"\n\n    # --- mask out the two edge lines (entire corner row + col) ---\n    line_mask = np.zeros((H, W), dtype=bool)\n    line_mask[cr, :] = True\n    line_mask[:, cc] = True\n\n    # --- extract solid rectangles (no bg inside bbox) ---\n    mask = (g != int(bg)) & (~line_mask) & (g != int(marker))\n    rects = []\n    for coords in components_mask(mask, connectivity=4):\n        if coords.size == 0:\n            continue\n        b = bbox_coords(coords)\n        sub = crop_bbox(g, b)\n        if bool((sub == int(bg)).any()):\n            continue\n        rects.append({\"box\": tuple(map(int, b)), \"arr\": sub.copy()})\n\n    assert not (not rects)\n\n    def dist_to_edge(rect: dict, orient: str, edge_idx: int) -> int:\n        r0, c0, r1, c1 = map(int, rect[\"box\"])\n        if orient == \"v\":\n            col = int(edge_idx)\n            if int(c0) > col:\n                return int(c0 - col - 1)\n            if int(c1) < col:\n                return int(col - c1 - 1)\n            return 0\n        row = int(edge_idx)\n        if int(r0) > row:\n            return int(r0 - row - 1)\n        if int(r1) < row:\n            return int(row - r1 - 1)\n        return 0\n\n    blue_edge_idx = int(cc if blue_orient == \"v\" else cr)\n    red_edge_idx = int(cc if red_orient == \"v\" else cr)\n\n    def along_from_corner(rect: dict, orient: str) -> int:\n        r0, c0, r1, c1 = map(int, rect[\"box\"])\n        if orient == \"v\":\n            return int(r0 if cr == 0 else -r1)\n        return int(c0 if cc == 0 else -c1)\n\n    for rct in rects:\n        rct[\"db\"] = int(dist_to_edge(rct, blue_orient, blue_edge_idx))\n        rct[\"dr\"] = int(dist_to_edge(rct, red_orient, red_edge_idx))\n\n    rects.sort(\n        key=lambda r: (\n            int(r[\"db\"]),\n            int(r[\"dr\"]),\n            along_from_corner(r, blue_orient),\n            along_from_corner(r, red_orient),\n        )\n    )\n\n    # Rotate all rectangles if blue edge is vertical.\n    seq = []\n    for rct in rects:\n        a = rct[\"arr\"]\n        if blue_orient == \"v\":\n            a = np.rot90(a, k=1)  # CCW\n        seq.append(a)\n\n    outW = int(max(int(a.shape[1]) for a in seq))\n    outH = int(sum(int(a.shape[0]) for a in seq))\n    out = np.full((outH, outW), int(bg), dtype=int)\n\n    out_r = 0\n    for a in seq:\n        h, w = map(int, a.shape)\n        out_c = int((outW - w) // 2)\n        paste(out, a, int(out_r), int(out_c))\n        out_r += int(h)\n\n    return out\n\n# --------------- generator (attempt 3, Codex) ---------------\n\nBG = 8\nBLUE = 1\nRED = 2\nMARKER = 0\nDOMINANT_COLORS = np.array([3, 4, 5, 6, 7, 9], dtype=int)\nMINORITY_COLORS = np.array([1, 2, 3, 4, 5, 6, 7, 9], dtype=int)\n\n\ndef _transform(grid: np.ndarray, blue_orient: str, corner: str) -> np.ndarray:\n    if blue_orient == \"h\":\n        if corner == \"tl\":\n            return grid\n        if corner == \"tr\":\n            return np.fliplr(grid)\n        if corner == \"bl\":\n            return np.flipud(grid)\n        return np.rot90(grid, 2)\n\n    base = np.rot90(grid, 1)\n    if corner == \"bl\":\n        return base\n    if corner == \"tl\":\n        return np.flipud(base)\n    if corner == \"tr\":\n        return np.rot90(grid, 3)\n    return np.flipud(np.rot90(grid, 3))\n\n\ndef _distribute_band_widths(count: int, used_target: int) -> list[int]:\n    extra_units = (used_target - (4 * count - 2)) // 2\n    order = np.random.permutation(count)\n    units = np.zeros(count, dtype=int)\n    remaining = int(extra_units)\n    for i, idx in enumerate(order):\n        slots_left = count - i - 1\n        lo = max(0, remaining - 3 * slots_left)\n        hi = min(3, remaining)\n        take = int(np.random.randint(lo, hi + 1))\n        units[int(idx)] = take\n        remaining -= take\n    return [2 + 2 * int(u) for u in units]\n\n\ndef _sprinkle_minorities(patch: np.ndarray, dominant: int) -> np.ndarray:\n    area = int(patch.size)\n    if area < 8 or np.random.rand() < 0.6:\n        return patch\n\n    max_minor = min(3, area // 4)\n    if max_minor < 2:\n        return patch\n\n    n_minor = int(np.random.randint(2, max_minor + 1))\n    n_colors = int(np.random.randint(1, min(2, n_minor) + 1))\n    minority_choices = [int(c) for c in MINORITY_COLORS if int(c) != dominant]\n    colors = np.random.choice(minority_choices, size=n_colors, replace=False)\n    cells = np.random.choice(area, size=n_minor, replace=False)\n    flat = patch.reshape(-1)\n    for idx, cell in enumerate(cells):\n        flat[int(cell)] = int(colors[idx % n_colors])\n    return patch\n\n\ndef _build_canonical() -> np.ndarray:\n    long_dim = int(np.random.randint(9, 29))\n    options = []\n    for trailing in (1, 2):\n        max_used = long_dim - 2 - trailing\n        if max_used < 6 or max_used % 2:\n            continue\n        max_count = min(5, (max_used + 2) // 4)\n        pairs = []\n        for a in range(2, max_count + 1):\n            for b in range(2, max_count + 1):\n                if a + b > 9:\n                    continue\n                eligible = []\n                if max_used <= 10 * a - 2:\n                    eligible.append(0)\n                if max_used <= 10 * b - 2:\n                    eligible.append(1)\n                if eligible:\n                    pairs.append((a, b, eligible))\n        if pairs:\n            options.append((max_used, pairs))\n\n    max_used, pairs = options[int(np.random.randint(len(options)))]\n    n0, n1, eligible = pairs[int(np.random.randint(len(pairs)))]\n    max_band = int(np.random.choice(eligible))\n    max0 = min(max_used, 10 * n0 - 2)\n    max1 = min(max_used, 10 * n1 - 2)\n    used0 = int(max_used if max_band == 0 else np.random.choice(np.arange(4 * n0 - 2, max0 + 1, 2)))\n    used1 = int(max_used if max_band == 1 else np.random.choice(np.arange(4 * n1 - 2, max1 + 1, 2)))\n    band0 = _distribute_band_widths(n0, used0)\n    band1 = _distribute_band_widths(n1, used1)\n\n    grid = np.full((8, long_dim), BG, dtype=int)\n    grid[0, :] = BLUE\n    grid[:, 0] = RED\n","exit_code":0,"status":"completed"}}
