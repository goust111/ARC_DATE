5:             if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]\n 336: \n 337: \n 338: def _make_diamond():\n 339:     \"\"\"Return a 3x3 diamond-shaped boolean mask.\"\"\"\n 340:     s = np.zeros((3, 3), dtype=bool)\n 341:     s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True\n 342:     return s\n 343: \n 344: \n 345: def _make_hollow_sprite(h, w, rng):\n 346:     \"\"\"Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX.\"\"\"\n 347:     sprite = np.ones((h, w), dtype=bool)\n 348:     if h >= 3 and w >= 3:\n 349:         sprite[1:-1, 1:-1] = False\n 350:     # Optionally add internal horizontal wall\n 351:     if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:\n 352:         br = rng.randint(2, h - 2)\n 353:         n = rng.randint(1, w - 2)\n 354:         s = rng.randint(1, w - 1 - n + 1)\n---\n 542: \n 543: \n 544: def generate_input():\n 545:     for _ in range(_MAX_RETRIES):\n 546:         r = _gen_attempt()\n 547:         if r is not None:\n 548:             return r\n 549:     raise RuntimeError(f\"Failed to generate input after {_MAX_RETRIES} attempts\")\n---\nFILE: /home/lixinyu/snap/new/ARC_code/train/412b6263.py\n  36: \n  37: \n  38: def main(grid: np.ndarray) -> np.ndarray:\n  39:     \"\"\"\n  40:     Infer the background, rotate the whole input 90 degrees counterclockwise, and stack two framed copies vertically.\n  41: \n  42:     Input structure:\n  43:     - Blue is absent from the input.\n  44:     - One rare marker color appears in exactly two pixels.\n  45:     - The background is the unique non-marker color whose removal leaves exactly two 4-connected foreground objects, each with one marker pixel and one body color.\n  46:     - The whole grid, including background and foreground objects, is the sprite to transform.\n  47: \n  48:     Rule:\n  49:     - Rotate the entire input grid 90 degrees counterclockwise.\n  50:     - Create a blue one-pixel frame around two vertical copies