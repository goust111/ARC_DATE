ight are independent cyclic attributes of the ordered bar slots:\n  44:       colors rotate right while heights rotate left.\n  45:     \"\"\"\n  46:     g = np.asarray(grid, dtype=int)\n  47:     height = g.shape[0]\n  48:     bg = get_bg(g)\n  49:     bars = _extract_bars(g, bg)\n  50: \n  51:     out = np.full_like(g, bg)\n  52:     count = len(bars)\n  53:     for i, bar in enumerate(bars):\n  54:         color = bars[(i - 1) % count][\"color\"]\n  55:         bar_height = bars[(i + 1) % count][\"height\"]\n  56:         assert 1 <= bar_height <= height\n  57:         out[height - bar_height : height, bar[\"col\"]] = color\n  58: \n  59:     return out\n  60: \n  61: # --------------- generator (o5x) ---------------\n  62: \n  63: _RNG = np.random.default_rng()\n  64: \n  65: # Canvas/bar bounds.\n  66: BAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE = 3, 6\n  67: BACKGROUND_COLOR, MIN_BAR_HEIGHT = 7, 1\n  68: BAR_COL_OFFSET, BAR_COL_STRIDE = 1, 2\n  69: # Color and transform sampling.\n  70: COLOR_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]\n  71: OUTPUT_COLOR_SHIFT, OUTPUT_HEIGHT_SHIFT = 1, -1\n  72: # Retry limit.\n  73: MAX_GENERATION_ATTEMPTS = 300\n  74: \n  75: \n  76: def _render_bars(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:\n  77:     side = BAR_COL_STRIDE * n + BAR_COL_OFFSET\n  78:     grid = np.full((side, side), BACKGROUND_COLOR, dtype=int)\n  79:     for i, (color, bar_height) in enumerate(zip(colors, heights)):\n  80:         col = BAR_COL_STRIDE * i + BAR_COL_OFFSET\n  81:         grid[side - int(bar_height) : side, col] = int(color)\n  82:     return grid\n  83: \n  84: \n  85: def _expected_output(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:\n  86:     out_colors = np.roll(colors, OUTPUT_COLOR_SHIFT)\n  87:     out_heights = np.roll(heights, OUTPUT_HEIGHT_SHIFT)\n  88:     return _render_bars(n, out_colors, out_heights)\n  89: \n  90: \n  91: def _gen_attempt() -> np.ndarray | None:\n  92:     n = int(_RNG.integers(BAR_C