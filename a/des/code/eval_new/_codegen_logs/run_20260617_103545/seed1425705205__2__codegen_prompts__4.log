{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/332f06d7.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, defaultdict, deque\nimport random\nimport numpy as np\nfrom scipy.ndimage import label as scipy_label\nfrom arc_utils import bbox_h, bbox_w, find_components, in_bounds, neighbors4, paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide a solid square through a winding channel to reach a same-sized target square.\n\n    Input structure:\n    - bg (most common color). A river color forms a winding corridor.\n    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.\n\n    Rule:\n    - The mover square travels along the river toward the destination.\n    - It can only pass through positions where the full NxN area is river.\n    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.\n    - The mover's original position is filled with the river color.\n\n    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n\n    # Corner-majority background (more stable than global mode here).\n    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])\n\n    # Detect solid square components (excluding bg).\n    squares: list[dict] = []\n    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\"):\n        col = int(comp[\"color\"])\n        b = comp[\"bbox\"]\n        if bbox_h(b) != bbox_w(b):\n            continue\n        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]\n        if not bool((patch == int(col)).all()):\n            continue\n        squares.append({\"col\": int(col), \"r0\": int(b[0]), \"c0\": int(b[1]), \"n\": int(bbox_h(b))})\n\n    assert not (len(squares) < 2)\n\n    # Choose the size that appears at least twice (most common size).\n    by_n: dict[int, list[dict]] = defaultdict(list)\n    for s in squares:\n        by_n[int(s[\"n\"])].append(s)\n    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]\n    cand = by_n[int(nside)]\n    assert not (len(cand) < 2)\n\n    cand.sort(key=lambda s: int(s[\"col\"]))\n    mover = cand[0]\n    dest = cand[1]\n\n    n = int(mover[\"n\"])\n    sr, sc = int(mover[\"r0\"]), int(mover[\"c0\"])\n    dr, dc = int(dest[\"r0\"]), int(dest[\"c0\"])\n\n    # River = most common remaining color (excluding bg and the two square colors).\n    counts = Counter(map(int, g.flatten()))\n    river = None\n    for col, _ct in counts.most_common():\n        if int(col) == int(bg):\n            continue\n        if int(col) in (int(mover[\"col\"]), int(dest[\"col\"])):\n            continue\n        river = int(col)\n        break\n    assert not (river is None)\n\n    trav = (g == int(river)) | (g == int(mover[\"col\"])) | (g == int(dest[\"col\"]))\n\n    # Feasible top-left placements: NxN window fully inside trav.\n    h2 = int(H - n + 1)\n    w2 = int(W - n + 1)\n    assert not (h2 <= 0 or w2 <= 0)\n    assert not (not (0 <= sr < h2 and 0 <= sc < w2))\n\n    feasible = np.zeros((h2, w2), dtype=bool)\n    for r in range(h2):\n        for c in range(w2):\n            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):\n                feasible[int(r), int(c)] = True\n    assert not (not bool(feasible[int(sr), int(sc)]))\n\n    # BFS on placement grid.\n    dist = -np.ones((h2, w2), dtype=int)\n    q = deque([(int(sr), int(sc))])\n    dist[int(sr), int(sc)] = 0\n    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    while q:\n        r, c = q.popleft()\n        for dr2, dc2 in DIR4:\n            rr = int(r + dr2)\n            cc = int(c + dc2)\n            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:\n                dist[rr, cc] = int(dist[int(r), int(c)] + 1)\n                q.append((int(rr), int(cc)))\n\n    # Pick target.\n    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:\n        tr, tc = int(dr), int(dc)\n    else:\n        best = -1\n        tr, tc = int(sr), int(sc)\n        for r in range(h2):\n            for c in range(w2):\n                if int(dist[int(r), int(c)]) > best:\n                    best = int(dist[int(r), int(c)])\n                    tr, tc = int(r), int(c)\n\n    out = g.copy()\n    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)\n    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover[\"col\"])\n    return out\n\n\n# --- Generator ---\n\n_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2\n\n\ndef _bfs_placement(feasible, sr, sc):\n    h2, w2 = feasible.shape\n    dist = -np.ones((h2, w2), dtype=int)\n    dist[sr, sc] = 0\n    q = deque([(sr, sc)])\n    while q:\n        r, c = q.popleft()\n        for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:\n                dist[rr, cc] = dist[r, c] + 1\n                q.append((rr, cc))\n    return dist\n\n\ndef _hamiltonian_walk(rows, cols, start, end):\n    total = rows * cols\n    best_path = None\n    best_len = 0\n    for _attempt in range(80):\n        visited = {start}\n        path = [start]\n        cur = start\n        while True:\n            if cur == end and len(path) >= total * 0.7:\n                if len(path) > best_len:\n                    best_path = list(path)\n                    best_len = len(path)\n                break\n            neighbors = []\n            for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                nr, nc = cur[0] + dr, cur[1] + dc\n                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:\n                    neighbors.append((nr, nc))\n            if not neighbors:\n                break\n            valid = []\n            for nb in neighbors:\n                if nb == end:\n                    valid.append(nb)\n                    continue\n                test_visited = visited | {nb}\n                seen = {end}\n                q = deque([end])\n                while q:\n                    cr, cc = q.popleft()\n                    for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                        nr2, nc2 = cr + dr2, cc + dc2\n                        if (0 <= nr2 < rows and 0 <= nc2 < cols and\n                                (nr2, nc2) not in test_visited and (nr2, nc2) not in seen):\n                            seen.add((nr2, nc2))\n                            q.append((nr2, nc2))\n                for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n                    ar, ac = nb[0] + dr2, nb[1] + dc2\n                    if (0 <= ar < rows and 0 <= ac < cols and\n                            (ar, ac) not in test_visited and (ar, ac) in seen):\n                        valid.append(nb)\n                        break\n            if not valid:\n                break\n            random.shuffle(valid)\n            nxt = valid[0]\n            visited.add(nxt)\n            path.append(nxt)\n            cur = nxt\n        if best_path and best_len >= total * 0.85:\n            break\n    return best_path\n\n\ndef _render_channel(grid, path, n, offsets_r, offsets_c):\n    pixel_pos = []\n    for cr, cc in path:\n        pr, pc = offsets_r[cr], offsets_c[cc]\n        pixel_pos.append((pr, pc))\n        grid[pr:pr + n, pc:pc + n] = _RIVER\n    for i in range(len(path) - 1):\n        pr1, pc1 = pixel_pos[i]\n        pr2, pc2 = pixel_pos[i + 1]\n        if pr1 == pr2:\n            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n\n            grid[pr1:pr1 + n, c_lo:c_hi] = _RIVER\n        else:\n            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n\n            grid[r_lo:r_hi, pc1:pc1 + n] = _RIVER\n    return pixel_pos\n\n\ndef _add_chokepoint(grid, pixel_pos_i, pixel_pos_j, n, direction):\n    H, W = grid.shape\n    pr1, pc1 = pixel_pos_i\n    pr2, pc2 = pixel_pos_j\n    narrow_w = random.randint(1, n - 1)\n    remove = n - narrow_w\n    side = random.randint(0, 1)\n\n    if direction == 'h':\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, neighbors4\n\n\ndef _legend_directions(g: np.ndarray, bg: int) -> dict[int, tuple[int, int]]:\n    \"\"\"\n    Detect legend blocks on the border.\n\n    A legend is a border-touching non-background component whose most common color is the legend\n    background `C` (and also the region border color it controls). The legend contains at least\n    two additional colors: a \"center\" color (more frequent) and an \"indicator\" color (less frequent).\n\n    The movement direction for regions with border color `C` is:\n      sign(centroid(indicator) - centroid(center))\n    \"\"\"\n    h, w = g.shape\n    non_bg = g != bg\n    best: dict[int, tuple[int, tuple[int, int]]] = {}\n    for pts in components_mask(non_bg, connectivity=4):\n        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue\n        # Legends are filled rectangles on the border.\n        r0, c0, r1, c1 = bbox_coords(pts)\n        area = (r1 - r0 + 1) * (c1 - c0 + 1)\n        if area != len(pts):\n            continue\n\n        counts: dict[int, int] = {}\n        for r, c in pts:\n            v = int(g[r, c])\n            counts[v] = counts.get(v, 0) + 1\n        if len(counts) != 3:\n            continue\n\n        bg_col = max(counts, key=counts.get)\n        others = [(cnt, col) for col, cnt in counts.items() if col != bg_col]\n        if len(others) < 2:\n            continue\n        others.sort()  # ascending by count\n        if others[0][0] == others[1][0]:\n            # Tie: choose center as the color closer to the rectangle center.\n            rc = np.array([(r0 + r1) / 2.0, (c0 + c1) / 2.0])\n            cols = [others[0][1], others[1][1]]\n            cents = []\n            for col in cols:\n                pts_col = np.array([(r, c) for r, c in pts if int(g[r, c]) == col], dtype=float)\n                cents.append((np.sum((pts_col.mean(axis=0) - rc) ** 2), col))\n            cents.sort()\n            center_col = cents[0][1]\n            indicator_col = cents[1][1]\n        else:\n            indicator_col = others[0][1]\n            center_col = others[-1][1]\n\n        center = [(r, c) for r, c in pts if int(g[r, c]) == center_col]\n        indic = [(r, c) for r, c in pts if int(g[r, c]) == indicator_col]\n        if not center or not indic:\n            continue\n\n        cc = np.mean(np.array(center, dtype=float), axis=0)\n        ci = np.mean(np.array(indic, dtype=float), axis=0)\n        vr, vc = (ci - cc).tolist()\n        dr = 0 if abs(vr) < 1e-6 else (1 if vr > 0 else -1)\n        dc = 0 if abs(vc) < 1e-6 else (1 if vc > 0 else -1)\n        if dr == 0 and dc == 0:\n            continue\n\n        prev = best.get(bg_col)\n        if prev is None or len(pts) > prev[0]:\n            best[bg_col] = (len(pts), (dr, dc))\n\n    return {k: v for k, (_, v) in best.items()}\n\n\ndef _slide_points(region_set: set[tuple[int, int]], points: list[tuple[int, int]], dr: int, dc: int) -> list[tuple[int, int]]:\n    if not points:\n        return []\n    # Process from the far end (closest to destination boundary) inward.\n    points_sorted = sorted(points, key=lambda p: (dr * p[0] + dc * p[1], p[0], p[1]), reverse=True)\n    occupied = set()\n    out_pts = []\n    for r0, c0 in points_sorted:\n        r, c = r0, c0\n        while True:\n            nr, nc = r + dr, c + dc\n            if (nr, nc) not in region_set:\n                break\n            # For diagonal steps, disallow \"corner cutting\": both orthogonal intermediates must be inside the region.\n            if dr != 0 and dc != 0:\n                if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n                    break\n            if (nr, nc) in occupied:\n                break\n            r, c = nr, nc\n        occupied.add((r, c))\n        out_pts.append((r, c))\n    return out_pts\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/eval/b10624e5.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, paste\nimport random\n\n\ndef _find_dividers(g: np.ndarray, bg: int) -> tuple[int, int]:\n    \"\"\"\n    Return the unique full-row/full-col quadrant divider: (mid_row, mid_col).\n    \"\"\"\n    h, w = g.shape\n    full_rows = [(r, int(g[r, 0])) for r in range(h) if np.all(g[r, :] == g[r, 0]) and int(g[r, 0]) != bg]\n    full_cols = [(c, int(g[0, c])) for c in range(w) if np.all(g[:, c] == g[0, c]) and int(g[0, c]) != bg]\n    matches = []\n    for r, vr in full_rows:\n        for c, vc in full_cols:\n            if vr == vc:\n                matches.append((int(r), int(c)))\n    assert len(matches) == 1, \"grid must have exactly one matching full-row/full-col divider\"\n    return matches[0]\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Replicate a motif across quadrants with scaling and reflection keyed to red anchor blocks.\n\n    Input structure:\n    - Grid divided into four quadrants by a full-row and full-column divider of a single non-bg color.\n    - Each quadrant contains a red (2) square anchor block of varying size.\n    - The top-left quadrant also has a colored motif attached to its red anchor.\n\n    Rule:\n    - Use the top-left quadrant's motif as the source pattern.\n    - For each other quadrant, scale the motif by the ratio of that quadrant's red block size to the source red block size.\n    - Reflect horizontally for right-side quadrants, vertically for bottom quadrants (both for bottom-right).\n    - Align the scaled/reflected motif so its red region overlaps the target anchor, then stamp non-bg pixels.\n\n    Key insight: Red block size encodes the scale factor; quadrant position encodes the reflection axes.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    out = g.copy()\n\n    bg = get_bg(g)\n    mid_r, mid_c = _find_dividers(g, bg)\n\n    # Find red anchor blocks (color 2) in each quadrant.\n    red = components_mask(g == 2, connectivity=4)\n    assert red, \"grid must contain red (color 2) anchor blocks\"\n\n    # Quadrant key: (top/bottom, left/right)\n    anchors: dict[tuple[int, int], tuple[int, int, int]] = {}\n    # value: (r0,c0,size)\n    for pts in red:\n        r0, c0, r1, c1 = bbox_coords(pts)\n        rr = (r0 + r1) // 2\n        cc = (c0 + c1) // 2\n        qb = 0 if rr < mid_r else 1\n        qr = 0 if cc < mid_c else 1\n        size = max(r1 - r0 + 1, c1 - c0 + 1)\n        key = (qb, qr)\n        assert key not in anchors, \"each quadrant must contain exactly one red anchor block\"\n        anchors[key] = (int(r0), int(c0), int(size))\n\n    assert (0, 0) in anchors, \"top-left quadrant must contain a red anchor block\"\n    sr0, sc0, sL = anchors[(0, 0)]\n    assert sL > 0, \"top-left red anchor must have positive size\"\n\n    # Build a source patch around the TL motif: take the non-bg connected component (4-neigh)\n    # in the TL quadrant that contains the TL red anchor.\n    tl = g[0:mid_r, 0:mid_c]\n    comps = components_mask(tl != bg, connectivity=4)\n    patch_bb = None\n    for pts in comps:\n        # component contains any red pixel?\n        if any(tl[r, c] == 2 for r, c in pts):\n            r0, c0, r1, c1 = bbox_coords(pts)\n            patch_bb = (int(r0), int(c0), int(r1), int(c1))\n            break\n    assert patch_bb is not None, \"top-left quadrant must contain a non-bg component with a red pixel\"\n\n    pr0, pc0, pr1, pc1 = patch_bb\n    patch = tl[pr0 : pr1 + 1, pc0 : pc1 + 1].copy()\n\n    def resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:\n        src_h, src_w = img.shape\n        if new_h <= 0 or new_w <= 0:\n            return img.copy()\n        rr = (np.floor(np.arange(new_h) * src_h / new_h)).astype(int)\n        cc = (np.floor(np.arange(new_w) * src_w / new_w)).astype(int)\n        rr = np.clip(rr, 0, src_h - 1)\n        cc = np.clip(cc, 0, src_w - 1)\n        return img[rr[:, None], cc[None, :]]\n\n    # For each quadrant anchor, paste a scaled/reflected version of the patch.\n    for (qb, qr), (tr0, tc0, tL) in anchors.items():\n        if (qb, qr) == (0, 0):\n            continue\n        patch_t = patch\n        if qr == 1:\n            patch_t = np.fliplr(patch_t)\n        if qb == 1:\n            patch_t = np.flipud(patch_t)\n\n        ratio = float(tL) / float(sL)\n        new_h = int(round(patch_t.shape[0] * ratio))\n        new_w = int(round(patch_t.shape[1] * ratio))\n        new_h = max(1, new_h)\n        new_w = max(1, new_w)\n        patch_s = resize_nn(patch_t, new_h, new_w)\n        roundtrip = resize_nn(patch_s, patch_t.shape[0], patch_t.shape[1])\n        assert np.array_equal(roundtrip, patch_t), \"scaling must preserve all motif information\"\n\n        # Align scaled red bbox in patch_s to the target red bbox.\n        rr_red, cc_red = np.where(patch_s == 2)\n        assert rr_red.size > 0, \"scaled source patch must contain red anchor pixels\"\n        ar0, ac0 = int(rr_red.min()), int(cc_red.min())\n        place_r0 = tr0 - ar0\n        place_c0 = tc0 - ac0\n\n        rr_p, cc_p = np.where(patch_s != bg)\n        for rr0, cc0 in zip(rr_p.tolist(), cc_p.tolist(), strict=False):\n            val = int(patch_s[rr0, cc0])\n            rr_t = place_r0 + rr0\n            cc_t = place_c0 + cc0\n            if not (0 <= rr_t < h and 0 <= cc_t < w):\n                continue\n            if rr_t == mid_r or cc_t == mid_c:\n                continue\n            if out[rr_t, cc_t] == 2:\n                continue\n            out[rr_t, cc_t] = val\n\n    return out\n\n# --------------- generator (o5x) ---------------\n\n# --- Grid constants ---\nBG = 4                  # background color\nDIV = 1                 # divider color\nRED = 2                 # anchor color\nGRID_SIZE = 27          # full grid dimension\nMID = 13                # divider row/col index\nQUADS = {               # (row_lo, row_hi, col_lo, col_hi) inclusive per quadrant\n    (0, 0): (0, 12, 0, 12),\n    (0, 1): (0, 12, 14, 26),\n    (1, 0): (14, 26, 0, 12),\n    (1, 1): (14, 26, 14, 26),\n}\n\n# --- Source motif parameters ---\nSOURCE_ANCHOR_SIZE = 2                  # TL anchor is always 2x2\nBLOCK_DIMS = [(2, 2), (2, 3), (3, 2), (3, 3)]  # logical block sizes for block method\nBLOCK_PROB = 0.5                        # prob of block method when not forced\nFILL_RATIO_MIN = 0.5                    # minimum motif fill ratio\nFILL_RATIO_MAX = 0.8                    # maximum motif fill ratio\nFREEFORM_H_RANGE = (3, 6)              # freeform motif height range\nFREEFORM_W_RANGE = (3, 6)              # freeform motif width range\nMOTIF_COLORS_MIN = 3                    # min distinct non-bg colors (including red)\nMOTIF_COLORS_MAX = 5                    # max distinct non-bg colors\nCOLOR_POOL = [0, 1, 3, 5, 6, 7, 8, 9]  # non-red, non-bg candidate colors\n\n# --- Target anchor parameters ---\nTARGET_SIZE_RANGE = (1, 4)              # anchor size range for non-TL quadrants\n\n# --- Generation retry limit ---\nMAX_RETRIES = 300\n\n\ndef _resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:\n    \"\"\"Nearest-neighbor resize supporting fractional scale ratios.\"\"\"\n    src_h, src_w = img.shape\n    rr = np.clip(np.floor(np.arange(new_h) * src_h / new_h).astype(int), 0, src_h - 1)\n    cc = np.clip(np.floor(np.arange(new_w) * src_w / new_w).astype(int), 0, src_w - 1)\n    return img[rr[:, None], cc[None, :]]\n\n\ndef _scaled_patch(patch: np.ndarray, qb: int, qr: int, target_size: int) -> np.ndarray:\n    \"\"\"Reflect and scale the source patch for a given quadrant and target anchor size.\"\"\"\n    p = patch\n    if qr:\n        p = np.fliplr(p)\n    if qb:\n        p = np.flipud(p)\n    ratio = target_size / SOURCE_ANCHOR_SIZE\n    h = max(1, int(round(p.shape[0] * ratio)))\n    w = max(1, int(round(p.shape[1] * ratio)))\n    return _resize_nn(p, h, w)\n\n\ndef _grow_4conn(h: int, w: int, seeds: set[tuple[int, int]], n_fill: int) -> set[tuple[int, int]]:\n    \"\"\"Grow a 4-connected region from seeds until it has n_fill cells.\"\"\"\n    filled = set(seeds)\n    frontier = set()\n    for r, c in seeds:\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:\n                frontier.add((nr, nc))\n    while len(filled) < n_fill and frontier:\n        cell = random.choice(list(frontier))\n        filled.add(cell)\n        frontier.discard(cell)\n        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n            nr, nc = cell[0] + dr, cell[1] + dc\n            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:\n                frontier.add((nr, nc))\n    return filled\n\n\ndef _assign_colors(filled: set[tuple[int, int]], red_cells: set[tuple[int, int]],\n                   h: int, w: int) -> np.ndarray | None:\n    \"\"\"Assign random colors to filled cells; returns None if coverage is incomplete.\"\"\"\n    rows = {r for r, _ in filled}\n    cols = {c for _, c in filled}\n    if rows != set(range(h)) or cols != set(range(w)):\n        return None\n    non_red = [p for p in filled if p not in red_cells]\n    random.shuffle(non_red)\n    max_colors = min(MOTIF_COLORS_MAX, len(non_red) + 1)\n    if max_colors < MOTIF_COLORS_MIN:\n        return None\n    n_colors = random.randint(MOTIF_COLORS_MIN, max_colors)\n    pool = COLOR_POOL[:]\n    random.shuffle(pool)\n    extras = pool[: n_colors - 1]\n    grid = np.full((h, w), BG, dtype=int)\n    for r, c in red_cells:\n        grid[r, c] = RED\n    for i, (r, c) in enumerate(non_red):\n        grid[r, c] = extras[i] if i < len(extras) else random.choice(extras)\n    return grid\n\n\ndef _source_patch(needs_block: bool) -> tuple[np.ndarray, int, int] | None:\n    \"\"\"Build the TL motif patch. Block method upscales a logical grid by SOURCE_ANCHOR_SIZE;\n    freeform method grows directly at pixel resolution with a 2x2 red anchor.\"\"\"\n    S = SOURCE_ANCHOR_SIZE\n    use_block = needs_block or random.random() < BLOCK_PROB\n    if use_block:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/34cfa167.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import bbox_h, bbox_w, find_components, get_bg\nimport random\n\n\ndef _is_solid_rect(g: np.ndarray, comp: dict) -> bool:\n    r0, c0, r1, c1 = comp[\"bbox\"]\n    area = int((r1 - r0 + 1) * (c1 - c0 + 1))\n    return int(comp[\"area\"]) == area and bool(np.all(g[r0 : r1 + 1, c0 : c1 + 1] == int(comp[\"color\"])))\n\n\ndef _find_structure(g: np.ndarray, bg: int) -> tuple[dict, dict, list[dict], list[dict]]:\n    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n    rects = [comp for comp in comps if _is_solid_rect(g, comp)]\n\n    candidates: list[tuple[dict, dict, list[dict], list[dict]]] = []\n    for color in {int(comp[\"color\"]) for comp in rects}:\n        same_color = [comp for comp in rects if int(comp[\"color\"]) == color]\n        for i, a in enumerate(same_color):\n            for b in same_color[i + 1 :]:\n                if bbox_h(a[\"bbox\"]) != bbox_h(b[\"bbox\"]) or bbox_w(a[\"bbox\"]) != bbox_w(b[\"bbox\"]):\n                    continue\n\n                ar0, ac0, _ar1, _ac1 = a[\"bbox\"]\n                br0, bc0, _br1, _bc1 = b[\"bbox\"]\n                if ar0 < br0 and ac0 < bc0:\n                    source, dest = a, b\n                elif br0 < ar0 and bc0 < ac0:\n                    source, dest = b, a\n                else:\n                    continue\n\n                sr0, sc0, sr1, sc1 = source[\"bbox\"]\n                dr0, dc0, _dr1, _dc1 = dest[\"bbox\"]\n                right = [\n                    comp\n                    for comp in rects\n                    if int(comp[\"color\"]) != color\n                    and comp[\"bbox\"][0] == sr0\n                    and comp[\"bbox\"][2] == sr1\n                    and comp[\"bbox\"][1] == comp[\"bbox\"][3]\n                    and sc1 < comp[\"bbox\"][1] < dc0\n                ]\n                below = [\n                    comp\n                    for comp in rects\n                    if int(comp[\"color\"]) != color\n                    and comp[\"bbox\"][1] == sc0\n                    and comp[\"bbox\"][3] == sc1\n                    and comp[\"bbox\"][0] == comp[\"bbox\"][2]\n                    and sr1 < comp[\"bbox\"][0] < dr0\n                ]\n\n                right_with_offsets = sorted(\n                    ((int(comp[\"bbox\"][1] - sc1), comp) for comp in right),\n                    key=lambda item: item[0],\n                )\n                below_with_offsets = sorted(\n                    ((int(comp[\"bbox\"][0] - sr1), comp) for comp in below),\n                    key=lambda item: item[0],\n                )\n                if len(right_with_offsets) == 2 and len(below_with_offsets) == 2:\n                    right_offsets = [offset for offset, _comp in right_with_offsets]\n                    below_offsets = [offset for offset, _comp in below_with_offsets]\n                    if right_offsets == below_offsets and right_offsets[0] == 1:\n                        candidates.append(\n                            (\n                                source,\n                                dest,\n                                [comp for _offset, comp in right_with_offsets],\n                                [comp for _offset, comp in below_with_offsets],\n                            )\n                        )\n\n    assert len(candidates) == 1, \"expected one anchor pair with matching right and below controls\"\n    return candidates[0]\n\n\ndef _paint(out: np.ndarray, bg: int, r: int, c: int, color: int) -> None:\n    assert int(out[r, c]) in {int(bg), int(color)}, \"paint target must be empty or already matching\"\n    out[r, c] = int(color)\n\n\ndef _paint_rect(out: np.ndarray, bg: int, r0: int, c0: int, r1: int, c1: int, color: int) -> None:\n    for r in range(int(r0), int(r1) + 1):\n        for c in range(int(c0), int(c1) + 1):\n            _paint(out, bg, r, c, color)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Complete a four-corner framed rectangle from one decorated anchor rectangle and its diagonal mate.\n\n    Input structure:\n    - The background is the dominant color.\n    - Two same-color solid rectangular anchors of the same size sit on opposite\n      diagonal corners, with the first anchor above-left of the second.\n    - The upper-left anchor has two one-cell-thick vertical control bars to its\n      right and two one-cell-thick horizontal control bars below it.\n\n    Rule:\n    - Copy the anchor rectangle into the two missing corners of the implied\n      larger rectangle.\n    - Repeat the right-side control bars horizontally between the left and right\n      anchors, using their spacing as the period, and draw the outer top and\n      bottom borders in the first right-control color.\n    - Repeat the below-side control bars vertically between the top and bottom\n      anchors, using the same period, and draw the outer left and right borders\n      in the first below-control color.\n\n    Key insight: The small control bars are the first two ticks of two periodic\n    frame patterns; the diagonal anchor supplies the opposite corner and the\n    missing two anchor copies.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n    source, dest, right_controls, below_controls = _find_structure(g, bg)\n\n    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    dr0, dc0, dr1, dc1 = dest[\"bbox\"]\n    anchor_color = int(source[\"color\"])\n    assert int(dest[\"color\"]) == anchor_color, \"anchor colors must match\"\n    assert bbox_h(source[\"bbox\"]) == bbox_h(dest[\"bbox\"]), \"anchor heights must match\"\n    assert bbox_w(source[\"bbox\"]) == bbox_w(dest[\"bbox\"]), \"anchor widths must match\"\n    assert sr0 > 0 and sc0 > 0, \"upper-left anchor must have space for outer frame\"\n    assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], \"lower-right anchor must have space for outer frame\"\n\n    right_offsets = [int(comp[\"bbox\"][1] - sc1) for comp in right_controls]\n    below_offsets = [int(comp[\"bbox\"][0] - sr1) for comp in below_controls]\n    assert right_offsets == below_offsets and right_offsets[0] == 1, \"control offsets must match from the anchor edge\"\n    step = int(right_offsets[1] - right_offsets[0])\n    assert step > 0, \"control bars must be separated\"\n    period = 2 * step\n    assert (dc0 - 1 - sc1 - right_offsets[0]) % period == 0, \"right frame must close next to the destination anchor\"\n    assert (dr0 - 1 - sr1 - below_offsets[0]) % period == 0, \"below frame must close next to the destination anchor\"\n\n    right_colors = [int(comp[\"color\"]) for comp in right_controls]\n    below_colors = [int(comp[\"color\"]) for comp in below_controls]\n    out = g.copy()\n\n    _paint_rect(out, bg, sr0, dc0, sr1, dc1, anchor_color)\n    _paint_rect(out, bg, dr0, sc0, dr1, sc1, anchor_color)\n\n    first_c = int(sc1 + right_offsets[0])\n    last_c = int(dc0 - 1)\n    for c in range(first_c, last_c + 1):\n        offset = int(c - sc1)\n        if (offset - right_offsets[0]) % period == 0:\n            color = right_colors[0]\n        elif (offset - right_offsets[1]) % period == 0:\n            color = right_colors[1]\n        else:\n            continue\n        _paint_rect(out, bg, sr0, c, sr1, c, color)\n        _paint_rect(out, bg, dr0, c, dr1, c, color)\n\n    _paint_rect(out, bg, sr0 - 1, first_c, sr0 - 1, last_c, right_colors[0])\n    _paint_rect(out, bg, dr1 + 1, first_c, dr1 + 1, last_c, right_colors[0])\n\n    first_r = int(sr1 + below_offsets[0])\n    last_r = int(dr0 - 1)\n    left_c = int(sc0 - 1)\n    right_c = int(dc1 + 1)\n    for r in range(first_r, last_r + 1):\n        _paint(out, bg, r, left_c, below_colors[0])\n        _paint(out, bg, r, right_c, below_colors[0])\n\n        offset = int(r - sr1)\n        if (offset - below_offsets[0]) % period == 0:\n            _paint_rect(out, bg, r, left_c, r, sc1, below_colors[0])\n            _paint_rect(out, bg, r, dc0, r, right_c, below_colors[0])\n        elif (offset - below_offsets[1]) % period == 0:\n            _paint_rect(out, bg, r, sc0, r, sc1, below_colors[1])\n            _paint_rect(out, bg, r, dc0, r, dc1, below_colors[1])\n\n    return out\n\n# --------------- generator (att2, o5x) ---------------\n\n# Color sampling.\nCOLOR_COUNT, NON_BG_COLOR_COUNT = 10, 4\n\n# Anchor/repetition geometry.\nANCHOR_SIZE_RANGE = (1, 5)\nREPEAT_COUNT_RANGE = (2, 5)\nCONTROL_OFFSETS = (1, 3)\nFRAME_PERIOD, DEST_ANCHOR_GAP, STRUCTURE_FIXED_PAD = 4, 2, 3\n\n# Canvas/margins.\nCANVAS_MIN_SIZE, CANVAS_MAX_SIZE = 16, 30\nMARGIN_CHOICES = range(4)\nMIN_TOTAL_MARGIN, SOURCE_OUTER_MARGIN = 1, 1\n\n# Retry.\nMAX_GENERATION_ATTEMPTS = 300\n\n\ndef _gen_paint_rect(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int, color: int) -> None:\n    grid[r0 : r1 + 1, c0 : c1 + 1] = int(color)\n\n\ndef _choose_margins(struct_len: int) -> tuple[int, int]:\n    pairs = [\n        (before, after)\n        for before in MARGIN_CHOICES\n        for after in MARGIN_CHOICES\n        if MIN_TOTAL_MARGIN <= before + after\n        and CANVAS_MIN_SIZE <= struct_len + before + after <= CANVAS_MAX_SIZE\n    ]\n    return pairs[int(np.random.randint(len(pairs)))]\n\n\ndef _build_output(\n    rows: int,\n    cols: int,\n    bg: int,\n    anchor_color: int,\n    right1: int,\n    right2: int,\n    below1: int,\n    sr0: int,\n    sc0: int,\n    s: int,\n    nh: int,\n    nv: int,\n) -> tuple[np.ndarray, tuple[int, int, int, int, int, int, int, int]]:\n    out = np.full((rows, cols), int(bg), dtype=int)\n    sr1, sc1 = sr0 + s - 1, sc0 + s - 1\n    dr0 = sr1 + FRAME_PERIOD * nv + DEST_ANCHOR_GAP\n    dc0 = sc1 + FRAME_PERIOD * nh + DEST_ANCHOR_GAP\n    dr1, dc1 = dr0 + s - 1, dc0 + s - 1\n\n    for r0, c0 in ((sr0, sc0), (sr0, dc0), (dr0, sc0), (dr0, dc0)):\n        _gen_paint_rect(out, r0, c0, r0 + s - 1, c0 + s - 1, anchor_color)\n\n    first_c, last_c = sc1 + CONTROL_OFFSETS[0], dc0 - 1\n    for c in range(first_c, last_c + 1):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' /home/lixinyu/snap/new/ARC_code/train/80214e03.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import get_bg, paste\nimport itertools\nimport random\n\n\ndef _visible_colors(line: np.ndarray, bg: int) -> frozenset[int]:\n    return frozenset(int(v) for v in line if int(v) != int(bg))\n\n\ndef _axis_bands(g: np.ndarray, axis: int, bg: int) -> list[tuple[int, int]]:\n    signatures: list[tuple[int, frozenset[int]]] = []\n    for idx in range(g.shape[axis]):\n        line = g[idx, :] if axis == 0 else g[:, idx]\n        colors = _visible_colors(line, bg)\n        if colors:\n            signatures.append((int(idx), colors))\n\n    assert signatures, \"expected foreground rows or columns\"\n\n    bands: list[tuple[int, int]] = []\n    start = prev = signatures[0][0]\n    current = signatures[0][1]\n    for idx, colors in signatures[1:]:\n        assert idx == prev + 1, \"foreground rows and columns must be contiguous\"\n        if colors != current:\n            bands.append((start, prev))\n            start = int(idx)\n            current = colors\n        prev = int(idx)\n    bands.append((start, prev))\n    return bands\n\n\ndef _cell_color(g: np.ndarray, rows: tuple[int, int], cols: tuple[int, int], bg: int) -> int:\n    r0, r1 = rows\n    c0, c1 = cols\n    region = g[r0 : r1 + 1, c0 : c1 + 1]\n    colors = np.unique(region[region != int(bg)])\n    assert colors.size == 1, \"each lattice cell must have one foreground color\"\n    return int(colors[0])\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Extract the color of each noisy block in a row/column lattice and mirror the coarse grid horizontally.\n\n    Input structure:\n    - A background surrounds a rectangular lattice of monochrome foreground blocks.\n    - Consecutive rows in a lattice band share the same set of visible foreground colors.\n    - Consecutive columns in a lattice band share the same set of visible foreground colors.\n    - Each row-band/column-band intersection has one foreground color, with possible background holes.\n\n    Rule:\n    - Group non-empty rows and columns into consecutive bands by their foreground color sets.\n    - Replace each lattice cell by the single foreground color inside that row/column-band intersection.\n    - Return the resulting coarse color grid with the column order reversed.\n\n    Key insight:\n    - Whole-row and whole-column color sets reveal the hidden lattice even when neighboring cells share a color or contain holes.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg = get_bg(g)\n\n    row_bands = _axis_bands(g, axis=0, bg=bg)\n    col_bands = _axis_bands(g, axis=1, bg=bg)\n    assert len(row_bands) >= 2 and len(col_bands) >= 2, \"expected a multi-cell block lattice\"\n\n    out = np.empty((len(row_bands), len(col_bands)), dtype=int)\n    for r_idx, row_band in enumerate(row_bands):\n        for c_idx, col_band in enumerate(reversed(col_bands)):\n            out[r_idx, c_idx] = _cell_color(g, row_band, col_band, bg)\n    return out\n\n# --------------- generator (att2) ---------------\n\n# Coarse output colors and dimensions.\nROW_BAND_BOUNDS = (2, 4)\nCOL_BAND_BOUNDS = (2, 3)\nCOLOR_VALUES = range(1, 10)\nMIN_DISTINCT_COLORS = 4\nMAX_DISTINCT_COLORS = 8\nADJACENCY_REPAIR_ATTEMPTS = 30\n\n# Expanded lattice dimensions.\nLATTICE_HEIGHT_BOUNDS = (8, 16)\nLATTICE_WIDTH_BOUNDS = (8, 14)\nBAND_HEIGHT_BOUNDS = (3, 8)\nBAND_WIDTH_BOUNDS = (3, 6)\n\n# Canvas, holes, and retry limits.\nCANVAS_HEIGHT_BOUNDS = (18, 22)\nCANVAS_WIDTH_BOUNDS = (11, 19)\nMIN_BG_PADDING = 1\nBG_COLOR = 0\nHOLE_MIN_DENOMINATOR = 20\nHOLE_MAX_DENOMINATOR = 5\nCOLOR_COUNT_BINS = 10\nGENERATION_ATTEMPTS = 300\n\n\ndef _line_color_set(a: np.ndarray, axis: int, idx: int) -> frozenset[int]:\n    line = a[idx, :] if axis == 0 else a[:, idx]\n    return frozenset(map(int, line))\n\n\ndef _adjacent_sets_ok(a: np.ndarray) -> bool:\n    row_sets = [_line_color_set(a, axis=0, idx=r) for r in range(a.shape[0])]\n    col_sets = [_line_color_set(a, axis=1, idx=c) for c in range(a.shape[1])]\n    return all(row_sets[i] != row_sets[i - 1] for i in range(1, len(row_sets))) and all(\n        col_sets[i] != col_sets[i - 1] for i in range(1, len(col_sets))\n    )\n\n\ndef _nudge_line(a: np.ndarray, axis: int, idx: int, avoid: frozenset[int], palette: list[int]) -> None:\n    if axis == 0:\n        coords = [(idx, c) for c in range(a.shape[1])]\n    else:\n        coords = [(r, idx) for r in range(a.shape[0])]\n\n    counts = {color: int(np.count_nonzero(a == color)) for color in palette}\n    eligible = [(r, c) for r, c in coords if counts[int(a[r, c])] > 1]\n    if not eligible:\n        eligible = coords\n\n    outside = [color for color in palette if color not in avoid]\n    r, c = random.choice(eligible)\n    if outside:\n        a[r, c] = random.choice(outside)\n        return\n\n    line_colors = [int(a[rr, cc]) for rr, cc in coords if int(a[rr, cc]) != int(a[r, c])]\n    if line_colors:\n        a[r, c] = random.choice(line_colors)\n\n\ndef _make_output(rows: int, cols: int) -> np.ndarray | None:\n    n_cells = rows * cols\n    n_colors = random.randint(MIN_DISTINCT_COLORS, min(MAX_DISTINCT_COLORS, n_cells))\n    palette = random.sample(COLOR_VALUES, n_colors)\n\n    counts = {color: 1 for color in palette}\n    for _ in range(n_cells - n_colors):\n        fewest = min(counts.values())\n        choices = [color for color, count in counts.items() if count == fewest]\n        counts[random.choice(choices)] += 1\n\n    vals: list[int] = []\n    for color, count in counts.items():\n        vals.extend([color] * count)\n    random.shuffle(vals)\n    out = np.array(vals, dtype=int).reshape(rows, cols)\n\n    for _ in range(ADJACENCY_REPAIR_ATTEMPTS):\n        if _adjacent_sets_ok(out) and len(set(map(int, out.flat))) == n_colors:\n            return out\n        for r in range(1, rows):\n            if _line_color_set(out, axis=0, idx=r) == _line_color_set(out, axis=0, idx=r - 1):\n                _nudge_line(out, axis=0, idx=r, avoid=_line_color_set(out, axis=0, idx=r - 1), palette=palette)\n        for c in range(1, cols):\n            if _line_color_set(out, axis=1, idx=c) == _line_color_set(out, axis=1, idx=c - 1):\n                _nudge_line(out, axis=1, idx=c, avoid=_line_color_set(out, axis=1, idx=c - 1), palette=palette)\n    return None\n\n\ndef _pick_sizes(n: int, total_lo: int, total_hi: int, part_lo: int, part_hi: int) -> list[int]:\n    lo = max(total_lo, n * part_lo)\n    hi = min(total_hi, n * part_hi)\n    total = random.randint(lo, hi)\n    choices = [p for p in itertools.product(range(part_lo, part_hi + 1), repeat=n) if sum(p) == total]\n    return list(random.choice(choices))\n\n\ndef _hole_mask(height: int, width: int) -> np.ndarray | None:\n    area = height * width\n    n_holes = random.randint((area + HOLE_MIN_DENOMINATOR - 1) // HOLE_MIN_DENOMINATOR, area // HOLE_MAX_DENOMINATOR)\n    mask = np.zeros((height, width), dtype=bool)\n    row_left = [width] * height\n    col_left = [height] * width\n    coords = [(r, c) for r in range(height) for c in range(width)]\n    random.shuffle(coords)\n\n    placed = 0\n    for r, c in coords:\n        if placed == n_holes:\n            return mask\n        if row_left[r] > 1 and col_left[c] > 1:\n            mask[r, c] = True\n            row_left[r] -= 1\n            col_left[c] -= 1\n            placed += 1\n    return mask if placed == n_holes else None\n\n\ndef _zero_is_dominant(grid: np.ndarray) -> bool:\n    counts = np.bincount(grid.ravel(), minlength=COLOR_COUNT_BINS)\n    return int(counts[BG_COLOR]) > int(counts[1:].max()) and get_bg(grid) == BG_COLOR\n\n\ndef _expand_output(out: np.ndarray) -> np.ndarray | None:\n    rows, cols = out.shape\n    heights = _pick_sizes(rows, *LATTICE_HEIGHT_BOUNDS, *BAND_HEIGHT_BOUNDS)\n    widths = _pick_sizes(cols, *LATTICE_WIDTH_BOUNDS, *BAND_WIDTH_BOUNDS)\n    lattice_h = sum(heights)\n    lattice_w = sum(widths)\n\n    min_grid_h = max(CANVAS_HEIGHT_BOUNDS[0], lattice_h + 2 * MIN_BG_PADDING)\n    min_grid_w = max(CANVAS_WIDTH_BOUNDS[0], lattice_w + 2 * MIN_BG_PADDING)\n    if min_grid_h > CANVAS_HEIGHT_BOUNDS[1] or min_grid_w > CANVAS_WIDTH_BOUNDS[1]:\n        return None\n\n    grid_h = random.randint(min_grid_h, CANVAS_HEIGHT_BOUNDS[1])\n    grid_w = random.randint(min_grid_w, CANVAS_WIDTH_BOUNDS[1])\n    top = random.randint(MIN_BG_PADDING, grid_h - lattice_h - MIN_BG_PADDING)\n    left = random.randint(MIN_BG_PADDING, grid_w - lattice_w - MIN_BG_PADDING)\n\n    lattice = np.full((lattice_h, lattice_w), BG_COLOR, dtype=int)\n    input_colors = out[:, ::-1]\n    r0 = 0\n    for r, height in enumerate(heights):\n        c0 = 0\n        for c, width in enumerate(widths):\n            cell = np.full((height, width), int(input_colors[r, c]), dtype=int)\n            holes = _hole_mask(height, width)\n            if holes is None:\n                return None\n            cell[holes] = BG_COLOR\n            paste(lattice, cell, r0, c0)\n            c0 += width\n        r0 += height\n\n    grid = np.full((grid_h, grid_w), BG_COLOR, dtype=int)\n    paste(grid, lattice, top, left)\n    return grid\n\n\ndef _gen_attempt() -> np.ndarray | None:\n","exit_code":0,"status":"completed"}}
