t)\n  24:     H, W = g.shape\n  25:     bg = int(get_bg(g))\n  26: \n  27:     # --- locate the marked corner ---\n  28:     corners = [(0, 0), (0, int(W - 1)), (int(H - 1), 0), (int(H - 1), int(W - 1))]\n  29:     corner = None\n  30:     for r, c in corners:\n  31:         if int(g[r, c]) == int(bg):\n  32:             continue\n  33:         nbr = []\n  34:         if r == 0:\n  35:             nbr.append(int(g[r + 1, c]))\n  36:         if r == H - 1:\n  37:             nbr.append(int(g[r - 1, c]))\n  38:         if c == 0:\n  39:             nbr.append(int(g[r, c + 1]))\n  40:         if c == W - 1:\n  41:             nbr.append(int(g[r, c - 1]))\n  42:         if nbr and all(int(n) != int(g[r, c]) for n in nbr):\n  43:             corner = (int(r), int(c))\n  44:             break\n  45:     assert corner is not None\n  46: \n  47:     cr, cc = map(int, corner)\n  48:     marker = int(g[cr, cc])\n  49: \n  50:     # --- line colors adjacent to the corner ---\n  51:     hstep = 1 if cc == 0 else -1\n  52:     vstep = 1 if cr == 0 else -1\n  53:     hcol = int(g[cr, cc + hstep])\n  54:     vcol = int(g[cr + vstep, cc])\n  55: \n  56:     # Choose \"blue\" line color.\n  57:     if hcol == 1 or vcol == 1:\n  58:         blue_col = 1\n  59:         red_col = int(vcol if hcol == 1 else hcol)\n  60:     else:\n  61:         # Fallback: longer line is blue.\n  62:         hlen = 0\n  63:         c = int(cc + hstep)\n  64:         while 0 <= c < W and int(g[cr, c]) == int(hcol):\n  65:             hlen += 1\n  66:             c += int(hstep)\n  67:         vlen = 0\n  68:         r = int(cr + vstep)\n  69:         while 0 <= r < H and int(g[r, cc]) == int(vcol):\n  70:             vlen += 1\n  71:             r += int(vstep)\n  72:         if vlen >= hlen:\n  73:             blue_col = int(vcol)\n  74:             red_col = int(hcol)\n  75:         else:\n  76:             blue_col = int(hcol)\n  77:             red_col = int(vcol)\n  78: \n  79:     blue_orient = \"h