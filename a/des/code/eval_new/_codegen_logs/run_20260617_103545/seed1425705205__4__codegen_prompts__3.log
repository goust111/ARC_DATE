{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nfrom collections import Counter\nimport numpy as np\n\np = Path('/home/lixinyu/snap/a/des/code/eval_new/seed1425705205/4/3.py')\nmod = SourceFileLoader('new_arc_task_stats', str(p)).load_module()\nbranch = Counter()\nfor _ in range(50):\n    g = mod.generate_input()\n    bg = mod._get_bg(g)\n    ref_box, arm_len = mod._find_reference(g, bg)\n    blocked = np.zeros_like(g, dtype=bool)\n    r0,c0,r1,c1 = ref_box\n    blocked[r0:r1+1, c0:c1+1] = True\n    seeds = []\n    for r in range(g.shape[0]):\n        for c in range(g.shape[1]):\n            if blocked[r,c] or int(g[r,c]) == bg:\n                continue\n            seeds.append({'pos': (r,c), 'color': int(g[r,c])})\n    records = mod._simulate_growth(g.shape, seeds, arm_len, blocked)\n    counts = [sum(int(length) == arm_len for length in rec['dir_lengths']) for rec in records]\n    branch['kept_instances'] += sum(c % 2 == 0 for c in counts)\n    branch['removed_instances'] += sum(c % 2 == 1 for c in counts)\n    branch['boundary_blocks'] += sum(reason == 'boundary' for rec in records for reason in rec['dir_reasons'] if reason)\n    branch['interaction_blocks'] += sum(reason in {'occupied','conflict'} for rec in records for reason in rec['dir_reasons'] if reason)\nprint(branch)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
