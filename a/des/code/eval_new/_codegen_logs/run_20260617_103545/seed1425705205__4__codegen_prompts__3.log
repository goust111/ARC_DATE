ol 0); red squares → right edge (col W−5).\n0016:     - Each square keeps its original row.\n0017:     - Process azure left-to-right, red right-to-left (nearest-to-edge first).\n0018:     - If a square's rows overlap an already-placed edge square, place it one square-width inward instead.\n0019: \n0020:     Key insight: Near-edge-first ordering plus row-overlap determines which square sits at the edge vs. the second column.\n0021:     \"\"\"\n0022:     g = np.array(grid, dtype=int)\n0023:     H, W = g.shape\n0024:     bg = int(get_bg(g))\n0025: \n0026:     out = np.full_like(g, bg)\n0027: \n0028:     SQUARE_SIZE = 5\n0029:     def overlaps(a0: int, a1: int, b0: int, b1: int) -> bool:\n0030:         return not (int(a1) < int(b0) or int(b1) < int(a0))\n0031: \n0032:     # Detect bordered squares by scanning 5x5 windows. This is robust even if frame-color pixels\n0033:     # are connected between squares in the input.\n0034:     squares = []\n0035:     for r0 in range(H - SQUARE_SIZE + 1):\n0036:         for c0 in range(W - SQUARE_SIZE + 1):\n0037:             patch = crop_bbox(g, (int(r0), int(c0), int(r0 + SQUARE_SIZE - 1), int(c0 + SQUARE_SIZE - 1)))\n0038: \n0039:             border = np.concatenate([patch[0, :], patch[-1, :], patch[1:-1, 0], patch[1:-1, -1]])\n0040:             if int(border.min()) != int(border.max()):\n0041:                 continue\n0042:             frame_col = int(border[0])\n0043:             if frame_col not in {2, 8}:\n0044:                 continue\n0045: \n0046:             inner = patch[1:-1, 1:-1]\n0047:             if not bool((inner != int(frame_col)).any()):\n0048:                 continue\n0049: \n0050:             squares.append({\"frame\": int(frame_col), \"r0\": int(r0), \"c0\": int(c0), \"patch\": patch})\n0051: \n0052:     # Azure squares: sort by original column ascending (leftmost first).\n0053:     azure_squares = sorted([s for s in squares if int(s[\"frame\"]) == 8], key=lambda s: int(s[\"c0\"]))\n0054:     placed_at_default: list[tuple[int, int]] = []\n0055:     for s in azure_squares:\n0056:         r0 = int(s[\"r0\"])\n0057:         r1 = int(r0 + SQUARE_SIZE - 1)\n0058:         has_overlap = any(overlaps(r0, r1, pr0, pr1) for pr0, pr1 in placed_at_default)\n0059:         dest_c = int(SQUARE_SIZE) if has_overlap else 0\n0060:         paste(out, s[\"patch\"], r0, dest_c, transparent=bg)\n0061:         if dest_c == 0:\n0062:             placed_at_default.append((r0, r1))\n0063: \n0064:     # Red squares: sort by original column descending (rightmost first).\n0065:     red_squares = sorted([s for s in squares if int(s[\"frame\"]) == 2], key=lambda s: -int(s[\"c0\"]))\n0066:     placed_at_default = []\n0067:     for s in red_squares:\n0068:         r0 = int(s[\"r0\"])\n0069:         r1 = int(r0 + SQUARE_SIZE - 1)\n0070:         has_overlap = any(overlaps(r0, r1, pr0, pr1) for pr0, pr1 in placed_at_default)\n0071:         dest_c = int(W - 2 * SQUARE_SIZE) if has_overlap else int(W - SQUARE_SIZE)\n0072:         paste(out, s[\"patch\"], r0, dest_c, transparent=bg)\n0073:         if dest_c == int(W - SQUARE_SIZE):\n0074:             placed_at_default.append((r0, r1))\n0075: \n0076:     return out\n0077: \n0078: # --------------- generator (c) ---------------\n0079: \n0080: # --- Configuration ---\n0081: GRID_H, GRID_W = 22, 22          # canvas dimensions\n0082: SQ = 5                            # square side length (frame + 3x3 interior)\n0083: AZURE, RED = 8, 2                 # frame colors\n0084: N_AZURE_RANGE = (3, 4)            # azure square count range\n0085: N_RED_RANGE = (3, 5)              # red square count range\n0086: MAX_INWARD = 2                    # max inward squares per side\n\n0300:     return None\n0301: \n0302: \n0303: def generate_input() -> np.ndarray:\n0304:     for _ in range(GEN_RETRIES):\n0305:         result = _gen_attempt()\n0306:         if result is not None:\n0307:             return result\n0308:     raise RuntimeError(f\"Failed to generate valid input after {GEN_RETRIES} attempts\")\n\n===== /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py =====\n0098:     return out_pts\n0099: \n0100: \n0101: def main(grid: np.ndarray) -> np.ndarray:\n0102:     \"\"\"\n0103:     Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n0104: \n0105:     Input structure:\n0106:     - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n0107:     - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n0108: \n0109:     Rule:\n0110:     - For each enclosed region, identify its border color C and look up the legend with fill color C.\n0111:     - The direction from the legend's center dot to its indicator dot gives the slide direction.\n0112:     - All yellow pixels in that region slide in that direction, stacking against the far wall.\n0113: \n0114:     Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n0115:     \"\"\"\n0116:     g = np.asarray(grid, dtype=int)\n0117:     h, w = g.shape\n0118:     bg = get_bg(g)\n0119: \n0120:     mover = 4  # yellow in ARC\n0121:     dirs = _legend_directions(g, bg)\n0122:     assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n0123: \n0124:     passable = (g == bg) | (g == mover)\n0125:     out = g.copy()\n0126: \n0127:     # Find enclosed passable regions (not connected to the outer border).\n0128:     for pts in components_mask(passable, connectivity=4):\n0129:         if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n0130:             continue  # outside background\n0131: \n0132:         movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n0133:         if not movers:\n0134:             continue\n0135: \n0136:         # Determine this regi