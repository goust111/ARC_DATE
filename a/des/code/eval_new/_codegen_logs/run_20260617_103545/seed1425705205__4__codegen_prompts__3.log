ox is None)\n0054:     ir0, ic0, ir1, ic1 = map(int, inner_bbox)\n0055:     fr0, fc0, fr1, fc1 = int(ir0 - 1), int(ic0 - 1), int(ir1 + 1), int(ic1 + 1)\n0056: \n0057:     # --- divider columns (fixed) on the left side ---\n0058:     divider_mask = np.zeros((H, W), dtype=bool)\n0059:     for c in range(0, max(0, int(fc0))):\n0060:         colv = g[:, int(c)]\n0061:         non = colv[colv != int(bg)]\n0062:         if int(len(non)) >= int(H - 1) and len(set(map(int, non))) == 1:\n0063:             divider_mask[:, int(c)] = True\n0064: \n0065:     left_cols = (np.arange(W)[None, :] < int(fc0))\n0066: \n0067:     # --- sprites: per-color 8-connected components in left area (excluding divider) ---\n0068:     sprites = []\n0069:     for col in sorted(set(map(int, g.flatten())) - {int(bg)}):\n0070:         mask = (g == int(col)) & left_cols & (~divider_mask)\n0071:         if not bool(mask.any()):\n0072:             continue\n0073:         slab, sn = label_mask(mask, connectivity=8)\n0074:         for sid in range(1, int(sn) + 1):\n0075:             pts = np.argwhere(slab == int(sid))\n0076:             r0, c0 = pts.min(axis=0)\n0077:             r1, c1 = pts.max(axis=0)\n0078:             r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))\n0079:             m = slab[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(sid)\n0080:             sprites.append({\"color\": int(col), \"r0\": int(r0), \"c0\": int(c0), \"r1\": int(r1), \"c1\": int(c1), \"mask\": m})\n0081: \n0082:     move_colors = {int(s[\"color\"]) for s in sprites}\n0083: \n0084:     # --- marker-derived targets (restricted to colors that actually appear as sprites) ---\n0085:     row_marks: dict[int, list[int]] = defaultdict(list)\n0086:     col_marks: dict[int, list[int]] = defaultdict(list)\n0087:     for r in range(int(ir0), int(ir1) + 1):\n0088:         cl = int(g[int(r), int(fc0)])\n0089:         cr = int(g[int(r), int(fc1)])\n0090:         if cl == cr and cl != int(bg) and cl in move_colors:\n0091:           