+            if bool(occupied_without_mover[nr, nc]):
+                return None
+            shifted.append((nr, nc))
+        shifted_t = tuple(shifted)
+        if _adjacent(shifted_t, anchor_set):
+            return (int(dr * step), int(dc * step))
