+        sr = int(start_r)
+        sc = int(start_c)
+        if seen[sr, sc]:
+            continue
+        stack = [(sr, sc)]
+        seen[sr, sc] = True
+        coords: list[tuple[int, int]] = []
+        while stack:
+            r, c = stack.pop()
+            coords.append((int(r), int(c)))
+            for dr, dc in _NEIGHBORS4:
+                nr = int(r + dr)
+                nc = int(c + dc)
+                if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and g[nr, nc] != int(bg):
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+
+        arr = np.array(coords, dtype=int)
+        r0, c0 = map(int, arr.min(axis=0))
+        r1, c1 = map(int, arr.max(axis=0))
+        mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        patch = np.full(mask.shape, int(bg), dtype=int)
+        for r, c in coords:
+            rr = int(r - r0)
+            cc = int(c - c0)
+            mask[rr, cc] = True
+            patch[rr, cc] = int(g[r, c])
+
+        rows_used = len({int(r) for r, _ in coords})
+        cols_used = len({int(c) for _, c in coords})
+        records.append(
