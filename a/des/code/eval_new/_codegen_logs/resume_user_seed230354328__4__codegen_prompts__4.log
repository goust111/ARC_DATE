+            mask[row, col] = True
+
+    while int(mask.sum()) < int(target_area):
+        frontier = set()
+        for r, c in np.argwhere(mask):
+            for dr, dc in _NEIGHBORS4:
+                nr = int(r + dr)
+                nc = int(c + dc)
+                if 0 <= nr < height and 0 <= nc < width and not mask[nr, nc]:
+                    frontier.add((nr, nc))
