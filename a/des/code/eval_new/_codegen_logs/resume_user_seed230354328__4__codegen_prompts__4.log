+                    blocked_axis,
+                    bg,
+                    (chosen[0], chosen[1]),
+                    (chosen[2], chosen[3]),
+                    used_keys,
+                )
+            )
+        i += 2
+    return modules
+
+
+def _place_modules(bg: int, modules: list[np.ndarray]) -> np.ndarray | None:
