+                "coords": tuple(sorted((int(r), int(c)) for r, c in coords)),
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "mask": mask,
+                "patch": patch,
+                "shape_key": _canonical_shape_key(mask),
+                "center": ((int(r0) + int(r1)) / 2.0, (int(c0) + int(c1)) / 2.0),
+                "row_span": int(rows_used),
