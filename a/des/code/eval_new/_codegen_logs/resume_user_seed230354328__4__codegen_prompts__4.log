+        key_b = (float(second["center"][0]), float(second["center"][1]))
+    else:
+        key_a = (float(first["center"][1]), float(first["center"][0]))
+        key_b = (float(second["center"][1]), float(second["center"][0]))
+    return (first, second) if key_a <= key_b else (second, first)
