+        sr = int(start_r)
+        sc = int(start_c)
+        if seen[sr, sc]:
+            continue
+        stack = [(sr, sc)]
+        seen[sr, sc] = True
+        coords: list[tuple[int, int]] = []
+        while stack:
+            r, c = stack.pop()
+            coords.append((int(r), int(c)))
+            for dr, dc in _NEIGHBORS4:
+                nr = int(r + dr)
+                nc = int(c + dc)
+                if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and g[nr, nc] != int(bg):
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
