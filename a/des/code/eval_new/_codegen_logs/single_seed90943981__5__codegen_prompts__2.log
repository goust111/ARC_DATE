+    assert len(marked) == 1, "each region must have exactly one maroon corner marker"
+    return marked[0]
+
+
+def _solve(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "grid must be 2D"
