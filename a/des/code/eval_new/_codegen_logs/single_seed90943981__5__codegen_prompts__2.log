+def _gravity_corner(grid: np.ndarray, r0: int, r1: int, c0: int, c1: int) -> tuple[bool, bool]:
+    corners = [
+        (r0, c0, True, True),
+        (r0, c1, True, False),
+        (r1, c0, False, True),
+        (r1, c1, False, False),
+    ]
