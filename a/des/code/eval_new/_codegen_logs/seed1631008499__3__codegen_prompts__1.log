+        for offset, color in enumerate(physical_colors):
+            coord = (r0, c0 + offset)
+            coords.append(coord)
+            grid[coord] = color
+    else:
+        for offset, color in enumerate(physical_colors):
+            coord = (r0 + offset, c0)
+            coords.append(coord)
