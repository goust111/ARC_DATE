+
+def _mark_blocked(blocked: np.ndarray, bbox: tuple[int, int, int, int]) -> None:
+    rs, cs = _expanded_slices(bbox, blocked.shape, pad=1)
+    blocked[rs, cs] = True
+
+
+def _place_bbox(
