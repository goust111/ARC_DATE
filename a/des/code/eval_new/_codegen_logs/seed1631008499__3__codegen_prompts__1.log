+        key = _parse_key(g, comp)
+        if key is not None:
+            keys.append(key)
+            continue
+        lock = _parse_lock(g, comp)
+        if lock is not None:
+            locks[lock["match_color"]] = lock
+
+    assert locks and keys, "expected at least one lock and one key"
+    assert len(locks) == len(keys), "expected one key per lock"
