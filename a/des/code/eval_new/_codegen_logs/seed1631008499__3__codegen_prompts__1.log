+        gc = rng.randint(c0 + 1, c1 - 1)
+        gap = (r0, gc)
+    elif gap_side == "bottom":
+        gc = rng.randint(c0 + 1, c1 - 1)
+        gap = (r1, gc)
+    elif gap_side == "left":
+        gr = rng.randint(r0 + 1, r1 - 1)
