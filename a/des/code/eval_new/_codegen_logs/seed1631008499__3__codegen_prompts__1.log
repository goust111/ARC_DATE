+        lock["sequence_len"] = spec["key_len"]
+        lock["orientation"] = spec["orientation"]
+        lock["match_at_low_end"] = spec["match_at_low_end"]
+        _mark_blocked(blocked, bbox)
+        locks.append(lock)
+
+    rng.shuffle(locks)
+    for lock in locks:
