+    return None
+
+
+def _draw_lock(
+    grid: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    match_color: int,
+    gap_side: str,
+    favor_first_neighbor: bool,
+    rng: random.Random,
+) -> dict:
