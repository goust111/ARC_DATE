+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+COLOR_POOL = tuple(range(10))
+SPECIAL_POOL = tuple(c for c in COLOR_POOL if c not in {BG, FRAME})
+
+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (18, 30)
+PAIR_COUNT_RANGE = (2, 4)
+KEY_LEN_RANGE = (2, 4)
+LOCK_INNER_H_RANGE = (2, 6)
+LOCK_INNER_W_RANGE = (2, 7)
+PLACEMENT_TRIES = 200
+GEN_RETRIES = 400
