    r0, c0, r1, c1 = bbox
    perim: set[tuple[int, int]] = set()
    for c in range(c0, c1 + 1):
        perim.add((r0, c))
        perim.add((r1, c))
    for r in range(r0, r1 + 1):
        perim.add((r, c0))
        perim.add((r, c1))
    return perim


def _gap_neighbors(bbox: tuple[int, int, int, int], gap: tuple[int, int]) -> list[tuple[int, int]]:
    r0, c0, r1, c1 = bbox
