+    gray = np.argwhere(view == GRAY)
+    assert len(gray) > 0
+    gr0, gc0, gr1, gc1 = _bbox(gray)
+    assert len(gray) == (gr1 - gr0 + 1) * (gc1 - gc0 + 1)
+    assert np.all(view[gr0 : gr1 + 1, gc0 : gc1 + 1] == GRAY)
