+
+def _region_contents(
+    g: np.ndarray,
+    region: dict,
+) -> tuple[tuple[int, int, int, int], int, str]:
+    r0, r1, c0, c1 = region["r0"], region["r1"], region["c0"], region["c1"]
+    view = g[r0 : r1 + 1, c0 : c1 + 1]
