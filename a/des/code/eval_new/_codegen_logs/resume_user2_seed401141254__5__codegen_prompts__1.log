+    return out, int(np.sum(cover > 1))
+
+
+def _paint_region(
+    grid: np.ndarray,
+    region: dict,
+    gray_local: tuple[int, int, int, int],
+    pointer_local: Iterable[tuple[int, int]],
+    color: int,
+) -> tuple[int, int, int, int]:
+    r0, c0 = region["r0"], region["c0"]
