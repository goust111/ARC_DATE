+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+# 2x2 L-shapes, encoded by the missing corner:
+# missing TL -> right, missing TR -> down, missing BR -> left, missing BL -> up
+DIR_TO_POINTER = {
+    "right": ((0, 1), (1, 0), (1, 1)),
+    "down": ((0, 0), (1, 0), (1, 1)),
+    "left": ((0, 0), (0, 1), (1, 0)),
+    "up": ((0, 0), (0, 1), (1, 1)),
+}
+MISSING_TO_DIR = {
+    (0, 0): "right",
+    (0, 1): "down",
+    (1, 1): "left",
+    (1, 0): "up",
+}
+
+GEN_RETRIES = 400
