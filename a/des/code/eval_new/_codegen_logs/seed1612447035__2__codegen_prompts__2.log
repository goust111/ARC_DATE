+    lr0, lc0 = legend_top_left
+    for offset, (left, right) in enumerate(legend_rows):
+        inp[lr0 + offset, lc0] = left
+        inp[lr0 + offset, lc0 + 1] = right
+
+    out = inp.copy()
+    for r, c in line_rot:
+        out[r, c] = terminal_color
+
+    try:
