+                    prefix_len = idx + 1
+                    steps = prefix_len + length - 1
+                    tail = _tail_cells(branch_cells[-1], direction, steps)
+                    if not all(_in_bounds((size, size), cell) for cell in tail):
+                        continue
+                    if any(cell in occupied for cell in tail):
