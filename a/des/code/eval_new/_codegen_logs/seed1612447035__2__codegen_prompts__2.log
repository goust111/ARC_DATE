+) -> list[tuple[int, int]] | None:
+    start = main_cells[idx]
+    cells = [start]
+    for step in range(1, length):
+        cell = (start[0] + direction[0] * step, start[1] + direction[1] * step)
+        if not _in_bounds((size, size), cell):
