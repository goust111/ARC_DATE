+def _tail_cells(
+    terminal: tuple[int, int], direction: tuple[int, int], steps: int
+) -> list[tuple[int, int]]:
+    return [
+        (terminal[0] + direction[0] * delta, terminal[1] + direction[1] * delta)
+        for delta in range(1, steps)
