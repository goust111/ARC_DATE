+
+    non_bg = grid != _most_common_color(grid)
+    candidates = []
+    for comp in _components(non_bg):
+        if source in comp:
+            continue
+        r0, c0, r1, c1 = _bbox(comp)
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
