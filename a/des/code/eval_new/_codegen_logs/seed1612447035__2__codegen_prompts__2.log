+            mapping[left] = right
+    else:
+        for c in range(c0, c1 + 1):
+            left = int(grid[r0, c])
+            right = int(grid[r0 + 1, c])
+            assert left != right, "legend columns must encode two different colors"
+            assert left not in mapping, "legend left colors must be unique"
+            mapping[left] = right
+
