+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+SOURCE = 2
+PATH_COLORS = (1, 3, 4, 5, 6, 7, 8, 9)
+SIZE_RANGE = (18, 24)
+MAIN_RETRIES = 80
+CASE_RETRIES = 500
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _in_bounds(shape: tuple[int, int], cell: tuple[int, int]) -> bool:
+    r, c = cell
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _rotate(cell: tuple[int, int], size: int, k: int) -> tuple[int, int]:
+    r, c = cell
+    if k == 0:
+        return r, c
+    if k == 1:
+        return c, size - 1 - r
+    if k == 2:
+        return size - 1 - r, size - 1 - c
+    return size - 1 - c, r
+
+
+def _transform_cells(cells: list[tuple[int, int]], size: int, k: int) -> list[tuple[int, int]]:
+    return [_rotate(cell, size, k) for cell in cells]
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _extract_source_and_legend(
+    grid: np.ndarray,
+) -> tuple[tuple[int, int], set[tuple[int, int]], dict[int, int]]:
+    h, w = grid.shape
+    red_border = [
+        (r, c)
+        for r in range(h)
+        for c in range(w)
+        if grid[r, c] == SOURCE and (r == 0 or c == 0 or r == h - 1 or c == w - 1)
