+        return None
+    if np.array_equal(got, out):
+        return inp, out
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(CASE_RETRIES):
+        built = _sample_case()
+        if built is not None:
+            return built[0]
+    raise RuntimeError(f"failed to generate a valid input after {CASE_RETRIES} attempts")

