+        branches.append({"attach": idx, "cells": branch_cells})
+        selected_attach = idx
+        selected_branch_index = 0
+        reserved_tail = set(tail)
+        active_route = main_cells[: idx + 1] + branch_cells[1:]
+    else:
+        final_dir = (
+            main_cells[-1][0] - main_cells[-2][0],
+            main_cells[-1][1] - main_cells[-2][1],
