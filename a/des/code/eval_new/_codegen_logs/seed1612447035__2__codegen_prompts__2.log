+            continue
+        if ww == 2 or hh == 2:
+            candidates.append((comp, r0, c0, r1, c1))
+
+    assert len(candidates) == 1, "expected exactly one disconnected legend rectangle"
+    comp, r0, c0, r1, c1 = candidates[0]
+    legend_cells = set(comp)
+    mapping: dict[int, int] = {}
+
+    if c1 - c0 + 1 == 2:
