+    for r, c in line_rot:
+        out[r, c] = terminal_color
+
+    try:
+        got = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(got, out):
+        return inp, out
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(CASE_RETRIES):
+        built = _sample_case()
