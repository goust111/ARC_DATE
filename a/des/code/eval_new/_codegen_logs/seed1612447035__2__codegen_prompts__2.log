+        cells = [(row, c) for c in range(1, 1 + first_len)]
+        turn = cells[-1]
+        cells.extend((turn[0] + sign * d, turn[1]) for d in range(1, second_len))
+
+        if shape == "zigzag":
+            third_len = random.randint(3, 5)
+            turn2 = cells[-1]
+            cells.extend((turn2[0], turn2[1] + d) for d in range(1, third_len))
