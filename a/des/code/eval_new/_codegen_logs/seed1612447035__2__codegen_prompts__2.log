+    out = g.copy()
+    for step in range(len(visited)):
+        rr = terminal[0] + dr * step
+        cc = terminal[1] + dc * step
+        assert 0 <= rr < h and 0 <= cc < w, "terminal bar must fit inside the canvas"
+        if step > 0:
