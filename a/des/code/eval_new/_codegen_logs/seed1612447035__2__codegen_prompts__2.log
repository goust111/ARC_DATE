+
+def _branch_directions(main_cells: list[tuple[int, int]], idx: int) -> list[tuple[int, int]]:
+    prev = main_cells[idx - 1]
+    cur = main_cells[idx]
+    nxt = main_cells[idx + 1]
+    dr1 = cur[0] - prev[0]
+    dc1 = cur[1] - prev[1]
+    dr2 = nxt[0] - cur[0]
+    dc2 = nxt[1] - cur[1]
