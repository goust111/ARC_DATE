+    prev = source
+    cur = start_neighbors[0]
+    current_color = int(g[cur])
+    visited: list[tuple[int, int]] = []
+
+    while True:
+        visited.append(cur)
+        nbrs = [
+            cell
+            for cell in _neighbors4(*cur)
+            if _in_bounds((h, w), cell) and path_mask[cell] and cell != prev
