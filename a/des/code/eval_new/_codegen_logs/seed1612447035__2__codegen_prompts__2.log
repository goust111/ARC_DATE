+    legend_top_left = None
+    for r0, c0 in positions:
+        if r0 < 0 or c0 < 0 or r0 + legend_h > size or c0 + 2 > size:
+            continue
+        block = {(r, c) for r in range(r0, r0 + legend_h) for c in range(c0, c0 + 2)}
+        moat = {
