+def _sample_main(size: int) -> list[tuple[int, int]] | None:
+    for _ in range(MAIN_RETRIES):
+        shape = random.choices(
+            ["straight", "turn", "zigzag"], weights=[0.3, 0.3, 0.4], k=1
