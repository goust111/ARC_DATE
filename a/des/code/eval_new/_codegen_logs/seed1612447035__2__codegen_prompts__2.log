+    reserved.update(line_rot[1:])
+
+    legend_h = len(legend_rows)
+    corner_positions = [
+        (1, 1),
+        (1, size - 3),
+        (size - legend_h - 1, 1),
+        (size - legend_h - 1, size - 3),
+    ]
+    positions = []
+    for pos in corner_positions:
