+    inner_c0 = left_pad + 2
+    inner_r1 = inner_r0 + inner_h - 1
+    inner_c1 = inner_c0 + inner_w - 1
+
+    grid[inner_r0 : inner_r1 + 1, inner_c0 : inner_c1 + 1] = GREY
