+def _mix_colors(colors: list[int], mix_map: dict[frozenset[int], int]) -> int:
+    uniq = list(dict.fromkeys(int(c) for c in colors))
+    assert uniq, "need at least one arriving color"
+    cur = uniq[0]
+    for nxt in uniq[1:]:
