+import numpy as np
+
+
+PIPE = 5
+TABLE_WIDTH = 6
+GEN_ATTEMPTS = 400
+MODE_CHOICES = ("h_segment", "h_cross_turn", "v_cross_turn")
+COLOR_POOL = [c for c in range(10) if c != PIPE]
