+    candidates: list[tuple[int, int, int, int]] = []
+    if h >= 2:
+        for rows, from_left in (
+            ((0, 1), True),
+            ((0, 1), False),
+            ((h - 2, h - 1), True),
+            ((h - 2, h - 1), False),
