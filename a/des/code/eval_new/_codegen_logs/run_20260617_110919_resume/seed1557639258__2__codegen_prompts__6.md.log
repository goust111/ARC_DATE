+    for j in range(0, int(table.shape[1]), 2):
+        a = int(table[0, j])
+        b = int(table[0, j + 1])
+        m0 = int(table[1, j])
+        m1 = int(table[1, j + 1])
+        assert m0 == m1, "each table entry must repeat the mixed color"
+        assert a != b, "table entries must encode two different input colors"
+        mix_map[frozenset((a, b))] = int(m0)
