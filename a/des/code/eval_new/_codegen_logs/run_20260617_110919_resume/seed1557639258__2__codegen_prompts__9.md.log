+            start = int(r0 + (height - seg) // 2)
+            cells.extend((int(rr), cc) for rr in range(start, start + seg))
+        else:
+            cc = int(c0 + width + d)
+            start = int(r0 + (height - seg) // 2)
+            cells.extend((int(rr), cc) for rr in range(start, start + seg))
