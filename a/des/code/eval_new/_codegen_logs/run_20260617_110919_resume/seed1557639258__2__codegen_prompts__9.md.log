+                return
+        elif direction == "left":
+            if not (ac1 == c0 - 1 and ar0 >= r0 and ar1 <= r1 and all(cc < c0 for _, cc in comp["cells"])):
+                return
+        else:
+            if not (ac0 == c1 + 1 and ar0 >= r0 and ar1 <= r1 and all(cc > c1 for _, cc in comp["cells"])):
+                return
