+
+
+def _find_rectangles(grid: np.ndarray, bg: int) -> list[dict]:
+    mask = (grid != int(bg)) & (grid != ARROW_COLOR)
+    comps, _ = _components_with_labels(mask)
+    rects: list[dict] = []
+    for comp in comps:
