+        if r_lo > r_hi or c_lo > c_hi:
+            continue
+        tr = random.randint(r_lo, r_hi)
+        tc = random.randint(c_lo, c_hi)
+        if axis == "horizontal":
+            src1 = (tr, tc - dist1)
+            src2 = (tr, tc + dist2)
