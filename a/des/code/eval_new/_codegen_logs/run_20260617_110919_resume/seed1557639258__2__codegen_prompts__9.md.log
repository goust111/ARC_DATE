+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+ARROW_COLOR = 9
+MASTER_SIZE = 30
+INNER_MIN = 1
+INNER_MAX = MASTER_SIZE - 2
+GENERATE_RETRIES = 400
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
