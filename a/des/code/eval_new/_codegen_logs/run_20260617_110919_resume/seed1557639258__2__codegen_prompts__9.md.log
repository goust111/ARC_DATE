+        r0, c0, r1, c1 = rect["bbox"]
+        rh = int(r1 - r0 + 1)
+        rw = int(c1 - c0 + 1)
+        ar0, ac0, ar1, ac1 = arrow_comps[aid]["bbox"]
+        arrow_height = int(ar1 - ar0 + 1 if direction in ("up", "down") else ac1 - ac0 + 1)
+        dist = _movement_distance(rh, rw, direction, arrow_height)
+        dr, dc = DIRS[direction]
+        tr = int(r0 + dr * dist)
+        tc = int(c0 + dc * dist)
+        moves.append(
