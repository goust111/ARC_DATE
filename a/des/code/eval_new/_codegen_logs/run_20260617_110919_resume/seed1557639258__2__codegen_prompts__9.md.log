+        if pair is None:
+            return None
+        move1, move2 = pair
+        moves.extend([move1, move2])
+        blocked |= _dilate_cells(move1["footprint"] | move2["footprint"] | move1["target_cells"])
+        extra_moves = random.choice([0, 1])
+    else:
