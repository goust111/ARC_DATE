+def _template_color(middle: np.ndarray, bg: int) -> int:
+    colors = [int(v) for v in np.unique(middle) if int(v) != int(bg)]
+    assert len(colors) == 1, f"expected a single template color, got {colors}"
+    return int(colors[0])
+
