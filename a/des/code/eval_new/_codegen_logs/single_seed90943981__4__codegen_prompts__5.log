+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_BG = 0
+GEN_GREY = 5
+GEN_TEMPLATE = 9
+GEN_COLOR_POOL = [1, 2, 3, 4, 6, 7, 8]
+GEN_DIRS = ["up", "right", "down", "left"]
+GEN_STEPS = {"up": 1, "right": 2, "down": 3, "left": 4}
