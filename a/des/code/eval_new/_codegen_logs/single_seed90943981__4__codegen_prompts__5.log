+def _random_shape() -> tuple[tuple[tuple[int, int], ...], int, int] | None:
+    for _ in range(80):
+        h = random.randint(2, 4)
+        w = random.randint(2, 4)
+        max_area = min(6, h * w - 1)
+        if max_area < 3:
+            continue
+        area = random.randint(3, max_area)
+        cells = {(random.randrange(h), random.randrange(w))}
