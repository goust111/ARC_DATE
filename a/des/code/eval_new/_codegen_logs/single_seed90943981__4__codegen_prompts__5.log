+        frag = frag_group[0]
+        direction = _direction(hole["centroid"], frag["centroid"])
+        fill = _apply_mapping(int(frag["color"]), mapping, GEN_STEPS[direction])
+        for r, c in hole["coords"]:
+            out[int(r), int(c)] = int(fill)
+    return out
+
