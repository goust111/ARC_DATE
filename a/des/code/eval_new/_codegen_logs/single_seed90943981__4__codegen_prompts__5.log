+    placed.sort(key=lambda item: (item["hole_origin"], item["frag_origin"]))
+    return placed
+
+
+def _palette_cycle() -> tuple[list[int], dict[int, int]]:
+    cycle = random.sample(GEN_COLOR_POOL, 4)
