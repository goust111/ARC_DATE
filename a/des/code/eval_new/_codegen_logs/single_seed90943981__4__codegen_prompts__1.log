    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg = BLACK
    h, _w = g.shape
    legend = [int(g[r, 0]) for r in range(h) if int(g[r, 0]) != bg]
