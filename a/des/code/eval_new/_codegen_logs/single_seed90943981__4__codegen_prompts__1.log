+def _contains_with_gap(outer: BBox, inner: BBox) -> bool:
+    return (
+        outer[0] + 2 <= inner[0]
+        and outer[1] + 2 <= inner[1]
+        and inner[2] <= outer[2] - 2
+        and inner[3] <= outer[3] - 2
+    )
+
+
+def _separated_with_gap(a: BBox, b: BBox) -> bool:
+    return (
+        a[2] + 1 < b[0]
+        or b[2] + 1 < a[0]
+        or a[3] + 1 < b[1]
+        or b[3] + 1 < a[1]
+    )
