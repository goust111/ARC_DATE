+
+        center_r = (r0 + r1) / 2.0
+        center_c = (c0 + c1) / 2.0
+        target_r = (grid.shape[0] - 1) / 2.0
+        target_c = (grid.shape[1] - 1) / 2.0
+        center_distance = abs(center_r - target_r) + abs(center_c - target_c)
+        candidates.append((center_distance, -border_area, (r0, c0, r1, c1), forward, backward))
