    return {
        "bbox": (r0, c0, r1, c1),
        "frame_color": color,
        "marker_color": marker_colors[0],
        "gap_side": gap_side,
    }


def _find_boxes(grid: np.ndarray) -> list[dict]:
    bg = _get_bg(grid)
    boxes = []
    for color, pts in _same_color_components(grid, bg):
        cand = _is_valid_frame(grid, bg, color, pts)
        if cand is not None:
            boxes.append(cand)
    boxes.sort(key=lambda box: box["bbox"])
    return boxes


