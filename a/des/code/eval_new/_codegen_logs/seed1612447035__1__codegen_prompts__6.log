from __future__ import annotations

import random
from collections import Counter, deque

import numpy as np


DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
GAP_TO_TURNS = {"top": 0, "right": 1, "bottom": 2, "left": 3}
MARKER_COLOR = 5
GEN_RETRIES = 400
BOX_SPEC_RETRIES = 120
PLACEMENT_RETRIES = 200


def _get_bg(grid: np.ndarray) -> int:
    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])


def _rotate_cw(arr: np.ndarray, turns: int) -> np.ndarray:
    turns %= 4
    if turns == 0:
        return arr.copy()
    return np.rot90(arr, -turns)


def _bbox_from_mask(mask: np.ndarray) -> tuple[int, int, int, int] | None:
    pts = np.argwhere(mask)
    if pts.size == 0:
        return None
    r0 = int(pts[:, 0].min())
    c0 = int(pts[:, 1].min())
    r1 = int(pts[:, 0].max())
    c1 = int(pts[:, 1].max())
    return r0, c0, r1, c1


def _crop_non_bg(arr: np.ndarray, bg: int) -> np.ndarray:
    box = _bbox_from_mask(arr != bg)
    if box is None:
        return np.zeros((0, 0), dtype=int)
    r0, c0, r1, c1 = box
    return arr[r0 : r1 + 1, c0 : c1 + 1].copy()


def _center_interior(patch: np.ndarray, shape: tuple[int, int], bg: int) -> np.ndarray:
    h, w = shape
    canvas = np.full((h, w), bg, dtype=int)
    if patch.size == 0:
        return canvas
    ph, pw = patch.shape
    top = (h - ph) // 2
    left = (w - pw) // 2
    mask = patch != bg
    canvas[top : top + ph, left : left + pw][mask] = patch[mask]
    return canvas


def _same_color_components(grid: np.ndarray, bg: int) -> list[tuple[int, list[tuple[int, int]]]]:
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    comps: list[tuple[int, list[tuple[int, int]]]] = []
    for r in range(h):
        for c in range(w):
            if seen[r, c]:
                continue
            color = int(grid[r, c])
            if color == bg:
                continue
            seen[r, c] = True
            q = deque([(r, c)])
            pts = [(r, c)]
            while q:
                cr, cc = q.popleft()
                for dr, dc in DIR4:
                    nr = cr + dr
                    nc = cc + dc
                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
                        seen[nr, nc] = True
                        q.append((nr, nc))
                        pts.append((nr, nc))
            comps.append((color, pts))
    return comps


def _is_valid_frame(
    grid: np.ndarray, bg: int, color: int, pts: list[tuple[int, int]]
) -> dict | None:
    rows = [r for r, _ in pts]
    cols = [c for _, c in pts]
    r0, r1 = min(rows), max(rows)
    c0, c1 = min(cols), max(cols)
    outer_h = r1 - r0 + 1
    outer_w = c1 - c0 + 1
    if outer_h < 4 or outer_w < 4:
        return None

    border = set()
    for c in range(c0, c1 + 1):
        border.add((r0, c))
        border.add((r1, c))
    for r in range(r0, r1 + 1):
        border.add((r, c0))
        border.add((r, c1))

    comp = set(pts)
    if not comp.issubset(border):
        return None

    missing = [cell for cell in border if cell not in comp]
    if len(missing) != 1:
        return None
    gap_r, gap_c = missing[0]
    if gap_r in (r0, r1) and gap_c in (c0, c1):
        return None
    if gap_r == r0:
        gap_side = "top"
    elif gap_r == r1:
        gap_side = "bottom"
    elif gap_c == c0:
        gap_side = "left"
    elif gap_c == c1:
        gap_side = "right"
    else:
        return None

    marker_positions = [
        (r0 - 1, c0 - 1),
        (r0 - 1, c1 + 1),
        (r1 + 1, c0 - 1),
        (r1 + 1, c1 + 1),
    ]
    h, w = grid.shape
    if any(not (0 <= r < h and 0 <= c < w) for r, c in marker_positions):
        return None
    marker_colors = [int(grid[r, c]) for r, c in marker_positions]
    if any(col == bg for col in marker_colors):
