+    mask = np.zeros((inner, inner), dtype=bool)
+    mask[1:3, 1:3] = np.array([[1, 1], [1, 0]], dtype=bool)
+    return mask
+
+
+def _pattern_with_overlap(inner: int, rng: random.Random, existing: np.ndarray):
