+        "up": sub[0, 1:-1],
+        "down": sub[-1, 1:-1],
+        "left": sub[1:-1, 0],
+        "right": sub[1:-1, -1],
+    }
+    colors = {}
+    for name, arr in sides.items():
+        vals = np.unique(arr)
+        if len(vals) != 1:
+            return None
+        colors[name] = int(vals[0])
+    return colors
