+
+def _find_neighbor(canvases, idx: int):
+    src = canvases[idx]
+    sr0, sc0, sr1, sc1 = src["bbox"]
+    srow = sr0 + sr1
+    scol = sc0 + sc1
+    direction = src["direction"]
