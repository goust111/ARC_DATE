+            for name, color in cand["side_colors"].items()
+            if color != grey
+        ]
+        if len(exit_sides) != 1:
+            continue
+        direction = exit_sides[0]
+        r0, c0, r1, c1 = cand["bbox"]
+        interior = grid[r0 + 1 : r1, c0 + 1 : c1].copy()
+        canvases.append(
