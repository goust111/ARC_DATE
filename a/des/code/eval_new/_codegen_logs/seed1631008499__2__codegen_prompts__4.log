+            gap = sr0 - or1
+        elif direction == "down" and ocol == scol and or0 > sr1:
+            gap = or0 - sr1
+        elif direction == "left" and orow == srow and oc1 < sc0:
+            gap = sc0 - oc1
+        elif direction == "right" and orow == srow and oc0 > sc1:
