+def _valid_dirs(r: int, c: int, rows: int, cols: int):
+    dirs = []
+    if r > 0:
+        dirs.append("up")
+    if c < cols - 1:
+        dirs.append("right")
+    if r < rows - 1:
+        dirs.append("down")
+    if c > 0:
+        dirs.append("left")
+    return dirs
