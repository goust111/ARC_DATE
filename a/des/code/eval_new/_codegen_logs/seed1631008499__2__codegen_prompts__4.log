+def _render_instance(
+    rows: int,
+    cols: int,
+    inner: int,
+    gap: int,
+    margins,
+    directions,
+    colors,
+    patterns,
+):
+    top, left, bottom, right = margins
+    frame = inner + 2
+    h = top + rows * frame + (rows - 1) * gap + bottom
+    w = left + cols * frame + (cols - 1) * gap + right
+    grid = np.full((h, w), BG, dtype=int)
