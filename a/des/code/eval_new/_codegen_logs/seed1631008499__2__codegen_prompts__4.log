+        ring = np.zeros_like(sub, dtype=bool)
+        ring[0, :] = True
+        ring[-1, :] = True
+        ring[:, 0] = True
+        ring[:, -1] = True
+        if np.any(sub[ring] == BG):
+            continue
+        if not np.any(sub[1:-1, 1:-1] == BG):
+            continue
