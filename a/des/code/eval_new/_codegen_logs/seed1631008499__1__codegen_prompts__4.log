+        frontier: list[tuple[int, int]] = []
+        for room in chosen_rooms:
+            rr, cc = rooms[room]["grid_pos"]
+            for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
