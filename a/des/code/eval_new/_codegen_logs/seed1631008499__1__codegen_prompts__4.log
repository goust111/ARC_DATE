+    if mode == "contest":
+        component_colors = {int(rooms[rid]["key_color"]) for rid in range(len(rooms))}
+        if len(component_colors) < 2:
+            return None
+        if not parsed_open_positions:
+            return None
+        if not _cross_room_spread(out, layout["room_index"], rooms, grid):
