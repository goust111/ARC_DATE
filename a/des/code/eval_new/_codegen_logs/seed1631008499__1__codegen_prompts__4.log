+    dist_maps = [_distance_map(passable, (r, c)) for r, c, _ in sources]
+
+    for r, c in np.argwhere(grid == BLACK):
+        best = None
+        colors: set[int] = set()
+        for dist, (_, _, color) in zip(dist_maps, sources, strict=False):
+            d = int(dist[r, c])
+            if d < 0:
+                continue
+            if best is None or d < best:
+                best = d
