+
+    rooms = _assign_keys(layout, mode)
+    locks, expected_open_edges = _choose_locks(layout, rooms, mode)
+    if not locks:
+        return None
+
+    grid = _render_scene(layout, rooms, locks)
+    out, details = _solve_details(grid)
