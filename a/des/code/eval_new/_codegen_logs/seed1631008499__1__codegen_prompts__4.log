+
+
+def generate_input() -> np.ndarray:
+    global _GEN_COUNTER
+
+    for _ in range(MAX_GEN_ATTEMPTS):
+        mode = _GEN_MODES[(_GEN_MODE_OFFSET + _GEN_COUNTER) % len(_GEN_MODES)]
+        _GEN_COUNTER += 1
+        grid = _gen_attempt(mode)
+        if grid is not None:
