+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+MAX_GEN_ATTEMPTS = 400
+_GEN_MODES = ("closed", "mixed", "contest")
+_GEN_MODE_OFFSET = random.randrange(len(_GEN_MODES))
+_GEN_COUNTER = 0
