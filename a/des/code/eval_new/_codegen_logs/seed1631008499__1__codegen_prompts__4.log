+                    "cells": cells,
+                    "key_pos": (kr, kc),
+                    "key_color": int(grid[kr, kc]),
+                }
+            )
+
+    assert rooms, "expected at least one room"
+    return room_id, rooms
+
+
+def _open_mask(
+    grid: np.ndarray,
+    room_id: np.ndarray,
+    rooms: list[dict[str, object]],
+    orientations: dict[tuple[int, int], str],
+) -> np.ndarray:
