+    grouped: dict[tuple[str, tuple[int, int]], list[dict]] = {}
+    for cand in candidates:
+        key = (cand["direction"], cand["tip"])
+        grouped.setdefault(key, []).append(cand)
+    group = rng.choice(list(grouped.values()))
+    return rng.choice(group)
