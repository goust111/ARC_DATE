+        return None
+    if not _bboxes_overlap(_expanded_bbox(objects[0]), _expanded_bbox(objects[1])):
+        return None
+    if tie and objects[0]["area"] == objects[1]["area"]:
+        return None
+
+    if not _place_extra_objects(objects, occupied, extra_counts, h, w, rng):
+        return None
+    return objects
