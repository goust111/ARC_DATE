+        h2, w2 = _sample_size(rng)
+        if tie and h1 * w1 == h2 * w2:
+            return None
+        gap_max = pair_counts[0] + pair_counts[1] - 1
+        if gap_max < 2:
+            return None
+        gap = rng.randint(2, min(3, gap_max))
+        total_h = h1 + gap + h2
