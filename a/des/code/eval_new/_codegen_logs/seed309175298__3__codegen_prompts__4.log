+    return True
+
+
+def _mark_cells(grid: np.ndarray, occupied: np.ndarray, cells: list[tuple[int, int]], color: int) -> None:
+    for r, c in cells:
+        grid[r, c] = color
+        occupied[r, c] = True
+
+
+def _arrow_cells(direction: str, tip: tuple[int, int], body_len: int) -> list[tuple[int, int]]:
