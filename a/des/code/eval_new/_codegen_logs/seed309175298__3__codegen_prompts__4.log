+    if not _try_place_bbox(objects, occupied, bbox1, pair_counts[0]):
+        return None
+    if not _try_place_bbox(objects, occupied, bbox2, pair_counts[1]):
+        return None
+    if not _bboxes_overlap(_expanded_bbox(objects[0]), _expanded_bbox(objects[1])):
