+        gap_max = pair_counts[0] + pair_counts[1] - 1
+        if gap_max < 2:
+            return None
+        gap = rng.randint(2, min(3, gap_max))
+        total_w = w1 + gap + w2
+        if w - total_w - 12 < 0:
+            return None
+        r0 = rng.randint(7, h - max(h1, h2) - 7)
+        c0 = rng.randint(6, w - total_w - 6)
+        bbox1 = (r0, c0, r0 + h1 - 1, c0 + w1 - 1)
+        c2 = c0 + w1 + gap
+        bbox2 = (r0, c2, r0 + h2 - 1, c2 + w2 - 1)
+    else:
