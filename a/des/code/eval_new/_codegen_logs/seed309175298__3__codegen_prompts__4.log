+    expected = _paint_objects(objects, shape, BG)
+    actual = main(grid)
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(24, 30)
+    w = rng.randint(24, 30)
+    scenario = rng.choice(["independent", "overlap_diff", "overlap_tie"])
