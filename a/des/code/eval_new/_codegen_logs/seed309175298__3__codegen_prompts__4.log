+            return None
+        r0 = rng.randint(6, h - total_h - 6)
+        c0 = rng.randint(7, w - max(w1, w2) - 7)
+        bbox1 = (r0, c0, r0 + h1 - 1, c0 + w1 - 1)
+        r2 = r0 + h1 + gap
+        bbox2 = (r2, c0, r2 + h2 - 1, c0 + w2 - 1)
