+
+
+def _arrow_gap_cell(direction: str, tip: tuple[int, int]) -> tuple[int, int]:
+    dr, dc = DIR_VECTORS[direction]
+    return tip[0] + dr, tip[1] + dc
+
+
+def _arrow_candidates(obj: dict, occupied: np.ndarray) -> list[dict]:
+    h, w = occupied.shape
