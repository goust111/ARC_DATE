+        max_len = min(MAX_ARROW_BODY, r0 - 3)
+        gap = _arrow_gap_cell("D", tip)
+        if 0 <= gap[0] < h and 0 <= gap[1] < w and not occupied[gap]:
+            for body_len in range(2, max_len + 1):
