+) -> bool:
+    anchors = [(5, 5), (5, w - 10), (h - 10, 5), (h - 10, w - 10)]
+    rng.shuffle(anchors)
+    for count in counts:
+        placed = False
+        for base_r, base_c in anchors:
+            for _ in range(20):
