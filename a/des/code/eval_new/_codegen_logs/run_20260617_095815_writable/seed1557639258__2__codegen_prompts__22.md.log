                    claims,
                    (mr, side_c),
                    (mr, mc + dc),
                    (0, dc),
                    (mr, mc),
                    color,
                    bg,
                )
            else:
                dr = -1 if mr < r0 else 1
                side_r = r0 - 1 if dr < 0 else r1 + 1
                for cc in (mc - 1, mc, mc + 1):
                    _claim(g, claims, (side_r, cc), color, bg)
                for cc in (mc - 1, mc + 1):
                    _claim(g, claims, (mr, cc), color, bg)
                _claim_range(
                    g,
                    claims,
                    (side_r, mc),
                    (mr + dr, mc),
                    (dr, 0),
                    (mr, mc),
                    color,
                    bg,
                )

            clears.add((mr, mc))

    assert not (set(claims) & clears)

    out = g.copy()
    for (r, c), color in claims.items():
        out[r, c] = color
    for r, c in clears:
        out[r, c] = bg
    return out

