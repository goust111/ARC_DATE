+        inp = solution.copy()
+        for rid in selected:
+            coords = regions[rid]["coords"]
+            inp[coords[:, 0], coords[:, 1]] = int(wrong_colors[rid])
+            region_set = {tuple(map(int, coord)) for coord in coords}
