+    inner_r0 = outer_r0 + (depth - 1) * step
+    inner_c0 = outer_c0 + (depth - 1) * step
+    seed_top = inner_r0 + 1 + (center_h - size) // 2
+    seed_left = inner_c0 + 1 + (center_w - size) // 2
