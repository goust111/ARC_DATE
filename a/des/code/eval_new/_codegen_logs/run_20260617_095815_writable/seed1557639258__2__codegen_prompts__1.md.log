+    bottom_margin = min_bottom + add_bottom
+    left_margin = min_left + add_left
+    right_margin = min_right + add_right
+
+    h = outer_h + top_margin + bottom_margin
+    w = outer_w + left_margin + right_margin
+    grid = np.full((h, w), bg, dtype=int)
+
