+    h, w = mask.shape
+    available = np.argwhere(mask & ~occupied)
+    if len(available) == 0:
+        return []
+
+    start = tuple(map(int, available[int(rng.integers(len(available)))]))
+    path = [start]
+    used = {start}
+    prev_dir = None
+
+    while len(path) < target_len:
+        r, c = path[-1]
+        neighbors = []
+        for dr, dc in DIR8:
+            nr, nc = r + dr, c + dc
