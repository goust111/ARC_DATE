+    num_false_segments = int(rng.integers(FALSE_SEGMENT_COUNT_RANGE[0], FALSE_SEGMENT_COUNT_RANGE[1] + 1))
+    for _ in range(num_false_segments):
+        starts = np.argwhere(candidate_false & ~occupied)
+        if len(starts) == 0:
