+    grid[gray_mask] = GRAY
+    for r, c, color in anchors:
+        grid[r, c] = color
+
+    if _most_common_color(grid) != bg:
+        return None
+    if not np.any((grid == bg) & tie):
+        return None
+    if not np.any((grid == GRAY) & tie):
+        return None
+    if not np.any((grid == GRAY) & ~tie):
+        return None
+    if np.array_equal(main(grid), grid):
+        return None
