+        c = int(rng.integers(0, w))
+        if any(abs(r - pr) + abs(c - pc) < ANCHOR_MIN_SEPARATION for pr, pc in positions):
+            continue
+        positions.append((r, c))
+
+    if len(positions) != count:
+        return None
+    return positions
