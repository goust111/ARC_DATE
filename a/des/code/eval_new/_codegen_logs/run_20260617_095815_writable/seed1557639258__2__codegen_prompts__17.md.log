+        label = int(winners[start])
+        same_region = candidate_false & (winners == label)
+        target_len = int(rng.integers(SEGMENT_LENGTH_RANGE[0], SEGMENT_LENGTH_RANGE[1] + 1))
+        path = _random_walk(same_region, occupied, target_len, rng)
