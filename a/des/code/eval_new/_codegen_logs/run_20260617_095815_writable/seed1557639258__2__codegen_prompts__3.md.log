+
+    if _most_common_color(grid) != bg:
+        return None
+
+    expected = _expected_output(height, width, bg, track_color, global_path, corners, clue_pairs)
+    try:
+        if np.array_equal(main(grid), expected):
+            return grid
+    except Exception:
+        return None
+    return None
+
