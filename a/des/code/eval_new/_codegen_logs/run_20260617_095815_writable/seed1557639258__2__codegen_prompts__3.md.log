+def _rotate_coords(
+    coords: list[tuple[int, int]], height: int, width: int, k: int
+) -> tuple[list[tuple[int, int]], int, int]:
+    out = coords
+    h, w = height, width
+    for _ in range(k % 4):
+        out = [(c, h - 1 - r) for r, c in out]
+        h, w = w, h
+    return out, h, w
