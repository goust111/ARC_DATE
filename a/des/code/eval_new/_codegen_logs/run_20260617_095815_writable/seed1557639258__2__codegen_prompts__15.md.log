+
+
+def _new_pixels_by_color(inp: np.ndarray, out: np.ndarray, bg: int, colors: list[int]) -> dict[int, int]:
+    result = {}
+    for color in colors:
+        result[color] = int(np.sum((inp == bg) & (out == color)))
+    return result
+
