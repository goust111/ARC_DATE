+    blocked = np.zeros((main_h, main_w), dtype=bool)
+
+    counts = {color: random.randint(1, 3) for color in crystal_colors}
+
+    if force_conflict:
+        conflict_pair = _find_conflict_pair(crystal_colors, rules)
+        if conflict_pair is None:
