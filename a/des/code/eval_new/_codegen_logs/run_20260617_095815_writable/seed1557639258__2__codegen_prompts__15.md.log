+        out[LEGEND_THICKNESS:, :] = main_grid
+        slab = out[:LEGEND_THICKNESS, :]
+        axis_len = w
+        vertical = False
+    elif side == "bottom":
+        out = np.full((h + LEGEND_THICKNESS, w), pad_color, dtype=int)
+        out[:h, :] = main_grid
+        slab = out[h:, :]
+        axis_len = w
+        vertical = False
+    elif side == "left":
+        out = np.full((h, w + LEGEND_THICKNESS), pad_color, dtype=int)
+        out[:, LEGEND_THICKNESS:] = main_grid
+        slab = out[:, :LEGEND_THICKNESS]
+        axis_len = h
+        vertical = True
+    else:
+        out = np.full((h, w + LEGEND_THICKNESS), pad_color, dtype=int)
+        out[:, :w] = main_grid
+        slab = out[:, w:]
+        axis_len = h
+        vertical = True
