+    if corner == "tl":
+        return rows + cols < int(width)
+    if corner == "tr":
+        return cols >= rows
+    if corner == "bl":
+        return (int(height) - 1 - rows) + cols < int(width)
+    if corner == "br":
+        return cols >= (int(height) - 1 - rows)
+    raise ValueError(f"unknown corner {corner}")
