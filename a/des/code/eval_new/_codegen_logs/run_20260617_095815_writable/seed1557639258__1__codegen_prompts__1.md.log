+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+_CORNERS = ("tl", "tr", "bl", "br")
+_RNG = np.random.default_rng()
+
+_GRID_SIDE_MIN = 16
+_GRID_SIDE_MAX = 30
+_INNER_SIDE_MIN = 4
+_INNER_SIDE_MAX = 8
+_MAX_ASPECT_DELTA = 3
+_PLACEMENT_RETRIES = 200
+_MAX_GEN_ATTEMPTS = 300
