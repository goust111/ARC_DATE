+def _find_unique_cell(grid: np.ndarray, color: int) -> tuple[int, int]:
+    coords = np.argwhere(grid == int(color))
+    assert len(coords) == 1, f"expected exactly one cell of color {color}"
+    return tuple(map(int, coords[0]))
