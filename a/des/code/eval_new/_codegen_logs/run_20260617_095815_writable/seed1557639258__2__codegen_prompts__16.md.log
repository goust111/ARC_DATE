+
+START_COLOR = 3
+END_COLOR = 2
+DIRS_RIGHT_FIRST = ((0, 1), (1, 0), (0, -1), (-1, 0))
+EDGE_NAMES = ("top", "bottom", "left", "right")
+ALL_COLORS = tuple(range(10))
+GENERATION_ATTEMPTS = 300
