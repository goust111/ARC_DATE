+def _shortest_path(
+    passable: np.ndarray, start: tuple[int, int], end: tuple[int, int]
+) -> list[tuple[int, int]]:
+    h, w = passable.shape
+    dist = -np.ones((h, w), dtype=int)
+    parent = np.full((h, w, 2), -1, dtype=int)
+    q = deque([start])
+    dist[start] = 0
+
+    while q:
+        r, c = q.popleft()
+        if (r, c) == end:
