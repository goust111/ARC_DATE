+def _neighbors4(r: int, c: int, shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    out: list[tuple[int, int]] = []
+    for dr, dc in DIRS_RIGHT_FIRST:
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            out.append((rr, cc))
+    return out
