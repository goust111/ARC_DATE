+def _crop_gradient_edge(grid: np.ndarray, edge: str) -> np.ndarray:
+    if edge == "top":
+        return np.array(grid[1:, :], dtype=int)
+    if edge == "bottom":
+        return np.array(grid[:-1, :], dtype=int)
+    if edge == "left":
+        return np.array(grid[:, 1:], dtype=int)
+    if edge == "right":
+        return np.array(grid[:, :-1], dtype=int)
