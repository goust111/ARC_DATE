+    points = _pick_tie_endpoints(shape, strip_len, want_short=rng.random() < 0.5, rng=rng)
+    if points is None:
+        return None
+    start, end = points
+    maze[start] = START_COLOR
+    maze[end] = END_COLOR
+    return maze, start, end
