+    inp = _attach_strip(maze, strip, edge)
+    try:
+        out = main(inp)
+    except AssertionError:
+        return None
+
+    if out.shape != maze.shape:
+        return None
+    if np.array_equal(out, maze):
+        return None
+    return inp
