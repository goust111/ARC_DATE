+    out = maze.copy()
+    k = len(strip)
+    plen = len(path)
+    for i, (r, c) in enumerate(path):
+        out[r, c] = int(strip[(i * k) // plen])
+    out[start] = START_COLOR
+    out[end] = END_COLOR
+    return out
