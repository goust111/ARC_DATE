    """Paint a single bar on `row` starting from the given wall side."""
    w = grid.shape[1]
    colors = np.full(length, RED, dtype=int)
    colors[:2 * blue_count - 1:2] = BLUE  # alternating B at even positions
    if side == 0:
        grid[row, :length] = colors
