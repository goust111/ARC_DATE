+                "cells": cells,
+                "bbox": (int(r0), int(c0), int(r0 + SOURCE_SIZE - 1), int(c0 + SOURCE_SIZE - 1)),
+                "center": (float(r0 + 1), float(c0 + 1)),
+            }
+        )
