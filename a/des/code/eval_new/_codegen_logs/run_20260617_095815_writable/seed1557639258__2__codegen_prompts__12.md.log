+def _can_place_cells(grid: np.ndarray, bg: int, cells: list[tuple[int, int]]) -> bool:
+    h, w = grid.shape
+    cell_set = set(cells)
+    for r, c in cells:
+        if not (0 <= r < h and 0 <= c < w):
