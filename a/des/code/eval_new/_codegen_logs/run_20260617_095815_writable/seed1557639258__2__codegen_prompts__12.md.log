+    for source in sources:
+        for r, c in source["cells"]:
+            out[r, c] = source["color"]
+            occupied[r, c] = True
+
+    moves = []
+    for obj in objects:
+        source, dist = _assign_source(obj, sources)
+        moves.append(
+            (
+                int(dist),
+                int(source["bbox"][0]),
+                int(source["bbox"][1]),
+                min(obj["cells"]),
+                obj,
+                _move_step(obj, source),
+            )
+        )
