+def _cells_for_group(
+    source: dict,
+    side: str,
+    length: int,
+    offset: int,
+    distance: int,
+) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = source["bbox"]
+    if side == "up":
+        row = r0 - distance
+        return [(row, c0 + offset + dc) for dc in range(length)]
+    if side == "down":
+        row = r1 + distance
+        return [(row, c0 + offset + dc) for dc in range(length)]
+    if side == "left":
+        col = c0 - distance
+        return [(r0 + offset + dr, col) for dr in range(length)]
+    col = c1 + distance
+    return [(r0 + offset + dr, col) for dr in range(length)]
+
