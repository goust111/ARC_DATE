+    for _dist, _sr, _sc, _anchor, obj, (dr, dc) in moves:
+        current = list(obj["cells"])
+        while True:
+            shifted = [(r + dr, c + dc) for r, c in current]
+            blocked = False
+            for nr, nc in shifted:
