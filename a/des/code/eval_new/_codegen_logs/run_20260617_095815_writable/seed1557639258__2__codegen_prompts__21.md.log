+
+def _subset_table(colors: list[int]) -> list[int]:
+    k = len(colors)
+    table = [0] * 10
+    for mask in range(1 << k):
+        total = sum(colors[i] for i in range(k) if (mask >> i) & 1) % 10
+        table[total] |= 1 << mask
