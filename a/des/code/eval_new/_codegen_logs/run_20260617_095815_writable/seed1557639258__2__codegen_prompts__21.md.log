+def _branch_ok(category: str, colors: list[int], scene: np.ndarray) -> bool:
+    full_sum = sum(colors)
+    overlap_value = int(scene[np.nonzero(scene | 1)][0]) if scene.size else 0
+
+    if category == "plain":
+        return full_sum <= 9 and full_sum % 10 != 0
+    if category == "wrap":
+        return full_sum > 9 and full_sum % 10 != 0 and overlap_value != 0
+    return full_sum % 10 == 0
+
+
+def _valid_instance(category: str, rectangles: list[tuple[int, int, int, int]], colors: list[int], scene: np.ndarray) -> bool:
+    masks = _coverage(rectangles, scene.shape)
+    counts = masks.sum(axis=0)
