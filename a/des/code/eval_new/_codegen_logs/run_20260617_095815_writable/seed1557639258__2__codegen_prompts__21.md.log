+            assigned[layer] = rect
+            search(depth + 1, next_bits)
+            assigned[layer] = None
+
+    search(0, cell_bits)
+    assert len(solutions) == 1, "layer rectangles must be uniquely determined"
+
+    result: list[tuple[int, int, int, int]] = [(-1, -1, -1, -1)] * n_layers
+    for layer, rect in enumerate(assigned):
+        if rect is not None:
+            result[layer] = rect
+    if result[0] == (-1, -1, -1, -1):
+        result = solutions[0]
+    return result
