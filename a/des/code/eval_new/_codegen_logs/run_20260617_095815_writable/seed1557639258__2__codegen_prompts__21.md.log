+WRAP_PALETTES: tuple[tuple[int, ...], ...] = (
+    (3, 8),
+    (4, 8),
+    (1, 4, 8),
+    (2, 4, 7),
+)
+ZERO_PALETTES: tuple[tuple[int, ...], ...] = (
