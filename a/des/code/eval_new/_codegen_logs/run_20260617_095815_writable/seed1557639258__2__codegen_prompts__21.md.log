+    labels = [int(v) for v in g[0, :] if int(v) != 0]
+    assert 2 <= len(labels) <= 3, "expected two or three labeled layers"
+    assert len(labels) == len(set(labels)), "layer labels must be distinct"
+
+    scene = g[2:, :]
+    assert scene.size > 0, "scene must be nonempty"
+    return labels, scene
