import random
from collections import Counter, deque
import numpy as np


def get_bg(grid):
    values, counts = np.unique(grid, return_counts=True)
    return int(values[np.argmax(counts)])


def colors_present(grid, exclude=None):
    exclude = {int(x) for x in (exclude or set())}
    return [int(x) for x in np.unique(grid) if int(x) not in exclude]


def neighbors4(r, c, h, w):
    if r > 0:
        yield r - 1, c
    if r + 1 < h:
        yield r + 1, c
    if c > 0:
        yield r, c - 1
    if c + 1 < w:
        yield r, c + 1


def find_components(mask):
    h, w = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    out = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            coords = []
            while q:
                rr, cc = q.popleft()
                coords.append((rr, cc))
                for nr, nc in neighbors4(rr, cc, h, w):
                    if mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            out.append(np.array(coords, dtype=int))
    return out


def bbox(coords):
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    return int(r0), int(c0), int(r1), int(c1)


def main(grid):
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    colors = colors_present(g, exclude={bg})
    assert len(colors) == 1
    color = colors[0]
    comps = find_components(g == color)
    assert len(comps) >= 3
    boxes = []
    masks = []
    shapes = set()
    for comp in comps:
        r0, c0, r1, c1 = bbox(comp)
        local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
        local[comp[:, 0] - r0, comp[:, 1] - c0] = True
        boxes.append((r0, c0, r1, c1))
        masks.append(local)
        shapes.add(local.shape)
    assert len(shapes) == 1
    full = np.zeros_like(masks[0])
    for m in masks:
        full |= m
    out = g.copy()
    for r0, c0, r1, c1 in boxes:
        out[r0:r1+1, c0:c1+1] = bg
        out[r0:r1+1, c0:c1+1][full] = color
    return out


def is_connected(mask):
    cells = np.argwhere(mask)
    if len(cells) == 0:
        return False
    seen = set()
    start = tuple(map(int, cells[0]))
    q = deque([start])
    seen.add(start)
    h, w = mask.shape
    while q:
        r, c = q.popleft()
        for nr, nc in neighbors4(r, c, h, w):
            if mask[nr, nc] and (nr, nc) not in seen:
                seen.add((nr, nc))
                q.append((nr, nc))
    return len(seen) == int(mask.sum())


def touches_all_sides(mask):
    return bool(mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any())


def can_remove(mask, r, c):
    if not mask[r, c] or mask.sum() <= 1:
        return False
    mask[r, c] = False
    ok = touches_all_sides(mask) and is_connected(mask)
    mask[r, c] = True
    return ok


def add_path(mask, start, end):
    r, c = start
    er, ec = end
    mask[r, c] = True
    while (r, c) "'!= (er, ec):
        moves = []
        if r != er:
            moves.append((r + (1 if er > r else -1), c))
        if c != ec:
            moves.append((r, c + (1 if ec > c else -1)))
        r, c = random.choice(moves)
        mask[r, c] = True


def make_base(ph, pw):
    for _ in range(200):
        mask = np.zeros((ph, pw), dtype=bool)
        if ph > 2:
            hr = random.randint(1, ph - 2)
        else:
            hr = random.randint(0, ph - 1)
        if pw > 2:
            hc = random.randint(1, pw - 2)
        else:
            hc = random.randint(0, pw - 1)
        hub = (hr, hc)
        anchors = [
            (0, random.randrange(pw)),
            (ph - 1, random.randrange(pw)),
            (random.randrange(ph), 0),
            (random.randrange(ph), pw - 1),
        ]
        for anchor in anchors:
            add_path(mask, anchor, hub)
        min_target = max(int(mask.sum()) + 2, (ph * pw) // 3)
        max_target = max(min_target, min(ph * pw - 1, (ph * pw * 3) // 4))
        target = random.randint(min_target, max_target)
        while int(mask.sum()) < target:
            frontier = []
            for r, c in np.argwhere(mask):
                for nr, nc in neighbors4(int(r), int(c), ph, pw):
                    if not mask[nr, nc]:
                        frontier.append((nr, nc))
            if not frontier:
                break
            frontier = list(dict.fromkeys(frontier))
            rr, cc = random.choice(frontier)
            mask[rr, cc] = True
        if not touches_all_sides(mask):
            continue
        if not is_connected(mask):
            continue
        removable = [tuple(map(int, cell)) for cell in np.argwhere(mask) if can_remove(mask, int(cell[0]), int(cell[1]))]
        if len(removable) < 4:
            continue
        return mask
    return None


def build_copies(base, n):
    coords = [tuple(map(int, cell)) for cell in np.argwhere(base)]
    max_missing = min(6, max(2, len(coords) // 4))
    for _ in range(300):
        masks = [base.copy() for _ in range(n)]
        support = np.zeros_like(base, dtype=int)
        support[base] = n
        targets = [random.randint(1, max_missing) for _ in range(n)]
        removed = [0] * n
        for _round in range(max_missing * 4 + 8):
            progress = False
            order = list(range(n))
            random.shuffle(order)
            for i in order:
                if removed[i] >= targets[i]:
                    continue
                cand = []
                for r, c in coords:
                    if masks[i][r, c] and support[r, c] > 1 and can_remove(masks[i], r, c):
                        cand.append((r, c))
                if not cand:
                    continue
                if random.random() < 0.7:
                    min_support = min(support[r, c] for r, c in cand)
                    tight = [(r, c) for r, c in cand if support[r, c] == min_support]
                    pick = random.choice(tight)
                else:
                    pick = random.choice(cand)
                r, c = pick
                masks[i][r, c] = False
                support[r, c] -= 1
                removed[i] += 1
                progress = True
            if all(removed[i] >= targets[i] for i in range(n)):
                break
            if not progress:
                break
        if any(v == 0 for v in removed):
            continue
        if any(removed[i] < targets[i] for i in range(n)):
            continue
        union = np.zeros_like(base)
        for m in masks:
            union |= m
        if not np.array_equal(union, base):
            continue
        if len({m.tobytes() for m in masks}) < 2:
            continue
        return masks
    return None


def split_extra(total, parts):
    cuts = sorted(random.sample(range(total + parts - 1), parts - 1)) if parts > 1 else []
    values = []
    prev = -1
    for cut in cuts + [total + parts - 1]:
        values.append(cut - prev - 1)
        prev = cut
    return values


def layout(ph, pw, n):
    for _ in range(100):
        cols = random.randint(1, min(3, n))
        rows = (n + cols - 1) // cols
        gap = random.randint(1, 3)
        min_h = rows * ph + (rows - 1) * gap
        min_w = cols * pw + (cols - 1) * gap
        if min_h > 30 or min_w > 30:
            continue
        extra_h = random.randint(0, 30 - min_h)
        extra_w = random.randint(0, 30 - min_w)
        row_pad = split_extra(extra_h, rows + 1)
        col_pad = split_extra(extra_w, cols + 1)
        row_starts = []
        cur = row_pad[0]
        for r in range(rows):
            row_starts.append(cur)
            cur += ph
            if r < rows - 1:
                cur += gap + row_pad[r + 1]
        col_starts = []
        cur = col_pad[0]
        for c in range(cols):
            col_starts.append(cur)
            cur += pw
            if c < cols - 1:
                cur += gap + col_pad[c + 1]
        slots = [(r, c) for r in range(rows) for c in range(cols)]
        chosen = random.sample(slots, n)
        random.shuffle(chosen)
        boxes = []
        for r, c in chosen:
            r0 = row_starts[r]
            c0 = col_starts[c]
            boxes.append((r0, c0, r0 + ph - 1, c0 + pw - 1))
        H = min_h + extra_h
        W = min_w + extra_w
        return H, W, boxes
    return None


def gen_one():
    for _ in range(500):
        n = random.randint(3, 5)
        ph = random.randint(4, 8)
        pw = random.randint(4, 8)
        base = make_base(ph, pw)
        if base is None:
            continue
        masks = build_copies(base, n)
        if masks is None:
            continue
        layout_result = layout(ph, pw, n)
        if layout_result is None:
            continue
        H, W, boxes = layout_result
        bg, color = random.sample(range(10), 2)
        grid = np.full((H, W), bg, dtype=int)
        expected = np.full((H, W), bg, dtype=int)
        for (r0, c0, r1, c1), mask in zip(boxes, masks):
            block = grid[r0:r1+1, c0:c1+1]
            block[mask] = color
        for r0, c0, r1, c1 in boxes:
            block = expected[r0:r1+1, c0:c1+1]
            block[base] = color
        try:
            got = main(grid)
        except Exception:
            continue
        if not np.array_equal(got, expected):
            print('"'mismatch')
            print(grid)
            print(base.astype(int))
            return False
        return True
    return False

ok = 0
for i in range(100):
    if not gen_one():
        print('failed at', i)
        break
    ok += 1
print('ok', ok)
