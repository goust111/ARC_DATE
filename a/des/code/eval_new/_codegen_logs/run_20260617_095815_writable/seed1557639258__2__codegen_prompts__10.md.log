+def _is_strictly_convex(points: list[tuple[int, int]]) -> bool:
+    n = len(points)
+    if n < 3 or len(set(points)) != n:
+        return False
+    sign = 0
+    for i in range(n):
+        cross = _polygon_cross(points[i], points[(i + 1) % n], points[(i + 2) % n])
+        if cross == 0:
