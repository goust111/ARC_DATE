+    pts = np.array([(r, c) for r, c, _ in markers], dtype=float)
+    center = pts.mean(axis=0)
+    ordered = sorted(
+        markers,
+        key=lambda item: math.atan2(float(item[0]) - float(center[0]), float(item[1]) - float(center[1])),
