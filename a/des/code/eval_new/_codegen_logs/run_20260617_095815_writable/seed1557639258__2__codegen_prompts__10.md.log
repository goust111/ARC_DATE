+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not bool(mask[r, c]):
+                continue
+            stack = [(int(r), int(c))]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
