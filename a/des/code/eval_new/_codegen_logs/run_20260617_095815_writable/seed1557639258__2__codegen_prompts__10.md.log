+def _paint_patch(grid: np.ndarray, occupied: np.ndarray, patch: np.ndarray, top: int, left: int, bg: int) -> None:
+    ph, pw = patch.shape
+    mask = patch != bg
+    grid[top : top + ph, left : left + pw][mask] = patch[mask]
+    occupied[top : top + ph, left : left + pw] |= mask
+
