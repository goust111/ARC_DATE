+    while int(mask.sum()) < area:
+        choices = [(r, c) for r, c in frontier if not mask[r, c]]
+        if not choices:
+            return None
+        r, c = random.choice(choices)
+        mask[r, c] = True
+        frontier.discard((r, c))
+        for nr, nc in _neighbors4(r, c):
