+
+        notch_mask = _tight_mask(np.argwhere(hole_mask))
+        key_mask = _tight_mask(key_coords)
+        matched = any(np.array_equal(np.rot90(key_mask, k), notch_mask) for k in range(4))
+        if not matched:
