+def _build_graph(gears: list[dict]) -> list[list[int]]:
+    graph = [[] for _ in gears]
+    for i in range(len(gears)):
+        r0a, c0a, r1a, c1a = gears[i]["bbox"]
+        for j in range(i + 1, len(gears)):
