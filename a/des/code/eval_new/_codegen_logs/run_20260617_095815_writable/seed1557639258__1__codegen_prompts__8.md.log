+def _build_river(h: int, band: tuple[int, int], color: int) -> dict | None:
+    band_lo, band_hi = band
+    start_r = random.randint(1, min(3, h - 9))
+    max_turns = min(3, (h - 2 - start_r) // 2 - 1)
+    if max_turns < 1:
+        return None
+    turns = random.randint(1, max_turns)
