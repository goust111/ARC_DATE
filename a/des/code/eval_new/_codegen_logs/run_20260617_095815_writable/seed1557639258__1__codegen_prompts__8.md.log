+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+BRIDGE = 5
+RIVER_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
