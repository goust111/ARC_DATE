+def _bridge_orientation(cells: list[tuple[int, int]]) -> str:
+    rows = {r for r, _ in cells}
+    cols = {c for _, c in cells}
+    if len(rows) == 1:
+        return "h"
+    if len(cols) == 1:
+        return "v"
+    raise ValueError("bridge component is not a straight line")
