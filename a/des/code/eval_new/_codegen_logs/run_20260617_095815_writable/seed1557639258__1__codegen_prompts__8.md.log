+    for _ in range(width - min_width):
+        gaps[random.randrange(len(gaps))] += 1
+
+    bands: list[tuple[int, int]] = []
+    col = gaps[0]
+    for idx in range(n_rivers):
+        bands.append((col, col + band_width - 1))
+        col += band_width
+        if idx < n_rivers - 1:
