                    touches = True
                    break
            if touches:
                break
        if not touches:
            return None
        fillable[bg_lab == comp_id] = True
    return fillable, n_bg, exterior, len(long_ids)


def _validate(inp: np.ndarray, out: np.ndarray, paths: list[list[int]], bg: int, contour: int, obstacle: int, n_bg: int, long_count: int) -> bool:
