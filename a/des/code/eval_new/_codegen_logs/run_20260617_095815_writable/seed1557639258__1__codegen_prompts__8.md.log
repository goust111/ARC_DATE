+        directions = [(-1, 0), (1, 0)]
+    else:
+        directions = [(0, -1), (0, 1)]
+
+    colors: list[int] = []
+    h, w = grid.shape
+    for dr, dc in directions:
+        rr, cc = r + dr, c + dc
+        while 0 <= rr < h and 0 <= cc < w:
+            value = int(grid[rr, cc])
+            if value == BRIDGE:
