        elif 'top' in E and 'bottom' not in E: dh = 'T'
        elif 'bottom' in E and 'top' not in E: dh = 'B'
        else: dh = 'T'
        if c_split is not None: dv = vs
        elif 'left' in E and 'right' not in E: dv = 'L'
        elif 'right' in E and 'left' not in E: dv = 'R'
        else: dv = 'L'
