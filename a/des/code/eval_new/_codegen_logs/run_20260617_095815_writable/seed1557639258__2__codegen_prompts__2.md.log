+                    if len(solutions) >= max_solutions:
+                        used[piece_idx] = False
+                        return
+            used[piece_idx] = False
+
+    dfs(0)
+    return solutions
+
+
+def _render_solution(
+    grid_shape: tuple[int, int],
+    bg: int,
+    frame_color: int,
+    frame_bbox: tuple[int, int, int, int],
+    pieces: list[dict],
+    solution: list[tuple[int, int, int]],
