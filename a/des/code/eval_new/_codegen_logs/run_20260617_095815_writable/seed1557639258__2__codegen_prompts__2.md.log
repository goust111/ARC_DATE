+
+def _sample_dims(count: int, rng: random.Random) -> list[int]:
+    dims = [rng.choice(DIM_CHOICES) for _ in range(count)]
+    while sum(dims) > 12:
+        idx = rng.randrange(count)
+        if dims[idx] > 3:
+            dims[idx] -= 1
+    return dims
