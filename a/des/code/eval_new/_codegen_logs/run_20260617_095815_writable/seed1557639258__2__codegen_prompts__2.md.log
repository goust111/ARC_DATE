+    frame_h = inner_h + 2
+    frame_w = inner_w + 2
+    frame_pos = _frame_positions((canvas_h, canvas_w), (frame_h, frame_w))
+    if not frame_pos:
+        return None
+    fr0, fc0 = rng.choice(frame_pos)
+    frame_bbox = (fr0, fc0, fr0 + frame_h - 1, fc0 + frame_w - 1)
