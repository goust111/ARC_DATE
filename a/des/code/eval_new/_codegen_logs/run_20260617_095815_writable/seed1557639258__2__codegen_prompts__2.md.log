+def _sample_dims(count: int, rng: random.Random) -> list[int]:
+    if count == 2:
+        dims = rng.sample(DIM_CHOICES, 2)
+        rng.shuffle(dims)
+        return dims
+    dims = DIM_CHOICES[:]
+    rng.shuffle(dims)
+    return dims
