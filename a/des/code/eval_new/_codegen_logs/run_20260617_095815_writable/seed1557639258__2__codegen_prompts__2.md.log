+            border[0, :] = True
+            border[-1, :] = True
+            border[:, 0] = True
+            border[:, -1] = True
+            if not np.all(sub[border] == color):
+                continue
+            if np.any(sub[1:-1, 1:-1] == color):
+                continue
+            area = (bh - 2) * (bw - 2)
+            center_penalty = abs((r0 + r1) / 2 - (h - 1) / 2) + abs((c0 + c1) / 2 - (w - 1) / 2)
+            cand = (area, -center_penalty, color, (r0, c0, r1, c1))
+            if best is None or cand > best:
