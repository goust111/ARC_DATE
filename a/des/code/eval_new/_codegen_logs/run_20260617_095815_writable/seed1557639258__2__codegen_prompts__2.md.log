+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+# Generator configuration.
+LAYOUTS = [(2, 2), (2, 3), (3, 2)]
+DIM_CHOICES = [3, 4, 5]
