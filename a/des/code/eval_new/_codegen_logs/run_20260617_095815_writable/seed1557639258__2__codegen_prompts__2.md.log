+def _frame_positions(canvas: tuple[int, int], frame_shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = canvas
+    fh, fw = frame_shape
+    center_r = (h - fh) // 2
+    center_c = (w - fw) // 2
+    positions: list[tuple[int, int]] = []
+    for dr in [-2, -1, 0, 1, 2]:
