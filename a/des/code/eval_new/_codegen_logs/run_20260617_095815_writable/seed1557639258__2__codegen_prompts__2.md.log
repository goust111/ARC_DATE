+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+# Generator configuration.
+LAYOUTS = [(2, 2), (2, 3), (3, 2)]
+DIM_CHOICES = [3, 4, 5]
+CANVAS_H_RANGE = (20, 30)
+CANVAS_W_RANGE = (20, 30)
+OUTER_MARGIN = 1
+PLACE_TRIES = 300
+GEN_RETRIES = 300
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.pop()
+                comp.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(comp)
+    return out
+
+
+def _bbox_from_coords(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    pts = np.argwhere(mask)
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    comps = _components(mask)
+    return len(comps) == 1
+
+
+def _rotations(mask: np.ndarray) -> list[dict]:
+    rots: list[dict] = []
+    seen: set[bytes] = set()
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        rot = _crop_mask(rot)
+        key = rot.tobytes()
+        if key in seen:
+            continue
+        seen.add(key)
+        coords = [(int(r), int(c)) for r, c in np.argwhere(rot)]
+        rots.append(
+            {
+                "mask": rot,
+                "coords": coords,
+                "shape": rot.shape,
+                "area": len(coords),
+            }
+        )
+    return rots
+
+
+def _find_frame(grid: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int]]:
+    h, w = grid.shape
+    best: tuple[int, float, int, tuple[int, int, int, int]] | None = None
+    for color in [int(v) for v in np.unique(grid) if int(v) != bg]:
+        for comp in _components(grid == color):
+            if len(comp) < 8:
+                continue
+            r0, c0, r1, c1 = _bbox_from_coords(comp)
+            bh = r1 - r0 + 1
+            bw = c1 - c0 + 1
+            if bh < 3 or bw < 3:
+                continue
+            if len(comp) != 2 * (bh + bw) - 4:
+                continue
+            sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+            border = np.zeros((bh, bw), dtype=bool)
+            border[0, :] = True
+            border[-1, :] = True
+            border[:, 0] = True
+            border[:, -1] = True
+            if not np.all(sub[border] == color):
+                continue
+            if np.any(sub[1:-1, 1:-1] == color):
