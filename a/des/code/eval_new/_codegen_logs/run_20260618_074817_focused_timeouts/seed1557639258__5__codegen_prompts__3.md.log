+    for arrow in arrows:
+        ar0, ar1, ac0, ac1 = arrow["bbox"]
+        direction = arrow["direction"]
+        candidates = []
+        for obj in objects:
+            r0, r1, c0, c1 = obj["bbox"]
+            if direction == "right" and c0 == ac1 + 1 and _row_overlap(r0, r1, ar0, ar1):
