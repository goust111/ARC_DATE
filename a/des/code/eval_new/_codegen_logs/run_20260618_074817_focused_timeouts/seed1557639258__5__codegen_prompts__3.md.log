+
+def _arrow_patch(direction: str) -> np.ndarray:
+    coords = ARROW_PATTERNS[direction]
+    h = 1 + max(r for r, _ in coords)
+    w = 1 + max(c for _, c in coords)
+    patch = np.full((h, w), BG, dtype=int)
+    for r, c in coords:
