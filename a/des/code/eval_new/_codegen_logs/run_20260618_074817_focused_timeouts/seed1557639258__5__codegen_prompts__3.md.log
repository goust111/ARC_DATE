+def _add_extra_obstacles(
+    h: int,
+    w: int,
+    reserved: np.ndarray,
+    rng: np.random.Generator,
+) -> list[tuple[int, int, int, int]]:
+    rects: list[tuple[int, int, int, int]] = []
+    count = int(rng.integers(*GEN_EXTRA_OBS_RANGE))
+    for _ in range(count):
