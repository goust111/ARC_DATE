+            rw = int(rng.integers(1, min(5, w) + 1))
+            r0 = int(rng.integers(0, h - rh + 1))
+            c0 = int(rng.integers(0, w - rw + 1))
+            rect = (r0, r0 + rh - 1, c0, c0 + rw - 1)
+            if not _rect_free(reserved, rect, pad=1):
