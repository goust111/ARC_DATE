+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[int(np.argmax(counts))])
+
+
+def _components(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[dict[str, object]] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            rows = [rr for rr, _ in cells]
+            cols = [cc for _, cc in cells]
+            out.append(
+                {
+                    "color": color,
+                    "cells": cells,
+                    "cell_set": set(cells),
+                    "area": len(cells),
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                }
+            )
+    return out
+
+
+def _is_marker(comp: dict[str, object]) -> bool:
+    if int(comp["area"]) != 2:
+        return False
+    r0, c0, r1, c1 = comp["bbox"]
+    return (r1 - r0 + 1, c1 - c0 + 1) in {(1, 2), (2, 1)}
+
+
+def _marker_orientation(comp: dict[str, object]) -> str:
+    r0, c0, r1, c1 = comp["bbox"]
+    return "h" if (r1 - r0 + 1, c1 - c0 + 1) == (1, 2) else "v"
+
+
+def _touches(cells_a: set[tuple[int, int]], cells_b: set[tuple[int, int]]) -> bool:
+    for r, c in cells_a:
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            if (r + dr, c + dc) in cells_b:
+                return True
+    return False
+
+
+def _pair_info(
+    grid: np.ndarray,
+    comp_a: dict[str, object],
+    comp_b: dict[str, object],
