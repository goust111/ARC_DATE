+    mid_c = (ac0 + ac1 + bc0 + bc1) // 4
+    top = mid_r - rect.shape[0] // 2
+    left = mid_c - rect.shape[1] // 2
+    return rect, top, left, int(rect.shape[0] * rect.shape[1])
