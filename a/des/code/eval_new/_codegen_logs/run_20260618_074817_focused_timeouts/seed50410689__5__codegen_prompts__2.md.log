+# --------------- shared helpers ---------------
+
+
+def _mask_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    h, w = mask.shape
+    start = tuple(int(x) for x in coords[0])
+    seen = {start}
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIRS4:
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and (rr, cc) not in seen:
+                seen.add((rr, cc))
+                q.append((rr, cc))
