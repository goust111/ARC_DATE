+    for dr, dc in offsets:
+        anchor_top = center_r + dr - rect_h // 2
+        anchor_left = center_c + dc - rect_w // 2
+        filler_top = center_r - dr - fill_h // 2
+        filler_left = center_c - dc - fill_w // 2
