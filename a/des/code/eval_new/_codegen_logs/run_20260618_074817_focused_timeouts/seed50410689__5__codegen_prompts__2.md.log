+import random
+from collections import deque
+
+import numpy as np
+
+
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+# --------------- shared helpers ---------------
+
+
+def _mask_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    h, w = mask.shape
+    start = tuple(int(x) for x in coords[0])
+    seen = {start}
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIRS4:
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and (rr, cc) not in seen:
+                seen.add((rr, cc))
+                q.append((rr, cc))
+    return len(seen) == int(mask.sum())
+
+
+def _crop_mask(mask: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    rows, cols = np.where(mask)
+    r0, r1 = int(rows.min()), int(rows.max())
+    c0, c1 = int(cols.min()), int(cols.max())
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy(), (r0, c0, r1, c1)
+
+
+def _touches_all_sides(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any())
+
+
+def _find_components(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == 0 or seen[r, c]:
+                continue
+
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+
+            rows = [rr for rr, _ in coords]
+            cols = [cc for _, cc in coords]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in coords:
+                mask[rr - r0, cc - c0] = True
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": mask,
+                }
+            )
