+def _grow_connected_subset(h: int, w: int, target: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    start = (random.randrange(h), random.randrange(w))
+    mask[start] = True
+    frontier = set()
+
+    def add_frontier(r: int, c: int) -> None:
+        for dr, dc in DIRS4:
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < h and 0 <= cc < w and not mask[rr, cc]:
+                frontier.add((rr, cc))
+
+    add_frontier(*start)
+    while int(mask.sum()) < target and frontier:
+        rr, cc = random.choice(tuple(frontier))
+        frontier.remove((rr, cc))
+        mask[rr, cc] = True
+        add_frontier(rr, cc)
+    return mask
+
+
+def _sample_anchor_and_hole(rect_h: int, rect_w: int) -> tuple[np.ndarray, np.ndarray] | None:
+    total = rect_h * rect_w
