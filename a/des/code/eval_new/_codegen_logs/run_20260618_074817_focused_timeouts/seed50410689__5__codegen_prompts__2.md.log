+def _gen_attempt() -> np.ndarray | None:
+    grid_h = random.randint(GRID_SIDE_MIN, GRID_SIDE_MAX)
+    grid_w = random.randint(GRID_SIDE_MIN, GRID_SIDE_MAX)
