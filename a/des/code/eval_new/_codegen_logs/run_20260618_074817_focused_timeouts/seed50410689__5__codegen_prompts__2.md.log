+        top, left = spec["output_box"]
+        rh, rw = rect.shape
+        for r in range(rh):
+            for c in range(rw):
+                rr, cc = top + r, left + c
+                if 0 <= rr < h and 0 <= cc < w and out[rr, cc] == 0:
+                    out[rr, cc] = int(rect[r, c])
+    return out
