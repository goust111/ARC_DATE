+
+def _boxes_overlap(box_a: tuple[int, int], shape_a: tuple[int, int], box_b: tuple[int, int], shape_b: tuple[int, int]) -> bool:
+    ar, ac = box_a
+    br, bc = box_b
+    ah, aw = shape_a
+    bh, bw = shape_b
+    return not (ar + ah <= br or br + bh <= ar or ac + aw <= bc or bc + bw <= ac)
