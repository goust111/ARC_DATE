+
+# --------------- generator ---------------
+
+GRID_SIDE_MIN = 18
+GRID_SIDE_MAX = 30
+PAIR_COUNT_CHOICES = (2, 3, 4)
+RECT_OPTIONS = ((3, 5), (5, 3), (5, 5))
+HOLE_ATTEMPTS = 200
+GEN_ATTEMPTS = 500
+OUTPUT_OVERLAP_PROB = 0.45
+MIN_INPUT_OFFSET = 3
+MAX_INPUT_OFFSET = 10
