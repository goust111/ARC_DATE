+
+def _too_close(cells_a: list[tuple[int, int]], cells_b: list[tuple[int, int]]) -> bool:
+    for ar, ac in cells_a:
+        for br, bc in cells_b:
+            if max(abs(ar - br), abs(ac - bc)) <= 1:
+                return True
+    return False
