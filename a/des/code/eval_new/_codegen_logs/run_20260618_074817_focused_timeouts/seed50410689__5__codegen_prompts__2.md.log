+    center_c = target_box[1] + rect_w // 2
+
+    offsets = [
+        (dr, dc)
+        for dr in range(-MAX_INPUT_OFFSET, MAX_INPUT_OFFSET + 1)
+        for dc in range(-MAX_INPUT_OFFSET, MAX_INPUT_OFFSET + 1)
+        if max(abs(dr), abs(dc)) >= MIN_INPUT_OFFSET
