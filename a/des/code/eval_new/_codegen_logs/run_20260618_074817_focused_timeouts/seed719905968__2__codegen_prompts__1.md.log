+        r0 = forced["r0"]
+        c0 = forced["c0"]
+
+    inner_h = h - 2
+    inner_w = w - 2
+    if seed_size > inner_h or seed_size > inner_w:
+        return None
+    seed_r = random.randint(r0 + 1, r0 + h - 1 - seed_size)
+    seed_c = random.randint(c0 + 1, c0 + w - 1 - seed_size)
+    return {
