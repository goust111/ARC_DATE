+        gap_start = random.randint(1, ((sh - 2) if side in ("left", "right") else (sw - 2)) - gap_width + 1)
+        dist = random.randint(1, 3)
+
+        if side == "right":
+            max_c0 = cols - sw - bw - dist
+            if max_c0 < 1 or rows - sh - 1 < 1 or rows - bh - 1 < 1:
+                continue
+            sr0 = random.randint(1, rows - sh - 1)
