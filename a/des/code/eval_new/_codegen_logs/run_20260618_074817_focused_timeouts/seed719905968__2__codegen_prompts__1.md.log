+            gap_r0 = sr0 + gap_start
+            gap_r1 = gap_r0 + gap_width - 1
+            br0_low = max(1, gap_r1 - bh + 1)
+            br0_high = min(rows - bh - 1, gap_r0)
+            if br0_low > br0_high:
+                continue
+            br0 = random.randint(br0_low, br0_high)
