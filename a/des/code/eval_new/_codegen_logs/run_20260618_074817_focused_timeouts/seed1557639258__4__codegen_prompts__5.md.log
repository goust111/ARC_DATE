+        if not frontier:
+            return None
+        pick = frontier[int(rng.integers(len(frontier)))]
+        cells.add(pick)
+    return sorted(cells)
+
+
+def _build_pair(
+    rng: np.random.Generator,
+    portal_color: int,
+    object_colors: tuple[int, int],
+) -> list[dict] | None:
+    h = int(rng.integers(4, 7))
+    w = int(rng.integers(4, 7))
