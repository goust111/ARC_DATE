+import numpy as np
+from collections import Counter, deque
+
+
+BG = 0
+WALL = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PAIR_RETRIES = 120
+ROOM_SHAPE_RETRIES = 80
+GRID_RETRIES = 400
+CANVAS_SIZE = 30
+
+
+def _mode(values: np.ndarray) -> int:
+    vals, counts = np.unique(values, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _perimeter_cells(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    cells = [(r0, c) for c in range(c0, c1 + 1)]
+    cells += [(r1, c) for c in range(c0, c1 + 1)]
+    cells += [(r, c0) for r in range(r0 + 1, r1)]
+    cells += [(r, c1) for r in range(r0 + 1, r1)]
+    return cells
+
+
+def _make_room(h: int, w: int, side: str, anchor: int) -> dict:
+    bbox = (0, 0, h + 1, w + 1)
+    if side == "top":
+        portal = (0, anchor)
+    elif side == "bottom":
+        portal = (h + 1, anchor)
+    elif side == "left":
+        portal = (anchor, 0)
+    else:
+        portal = (anchor, w + 1)
+    return {
+        "bbox": bbox,
+        "side": side,
+        "portal_pos": portal,
+        "inner_h": h,
+        "inner_w": w,
+    }
+
+
+def _to_local(room: dict, cell: tuple[int, int]) -> tuple[int, int]:
+    r, c = cell
+    r0, c0, r1, c1 = room["bbox"]
+    pr, pc = room["portal_pos"]
+    side = room["side"]
+    if side == "top":
+        return r - r0, c - pc
+    if side == "bottom":
+        return r1 - r, c - pc
+    if side == "left":
+        return c - c0, r - pr
+    return c1 - c, r - pr
+
+
+def _from_local(room: dict, depth: int, along: int) -> tuple[int, int]:
+    r0, c0, r1, c1 = room["bbox"]
+    pr, pc = room["portal_pos"]
+    side = room["side"]
+    if side == "top":
+        return r0 + depth, pc + along
+    if side == "bottom":
+        return r1 - depth, pc + along
+    if side == "left":
+        return pr + along, c0 + depth
+    return pr + along, c1 - depth
+
+
+def _in_interior(room: dict, cell: tuple[int, int]) -> bool:
+    r, c = cell
+    r0, c0, r1, c1 = room["bbox"]
+    return r0 < r < r1 and c0 < c < c1
+
+
+def _project_cells(src_room: dict, dst_room: dict, cells: list[tuple[int, int]]) -> list[tuple[int, int]] | None:
+    projected: list[tuple[int, int]] = []
+    seen: set[tuple[int, int]] = set()
+    for cell in cells:
