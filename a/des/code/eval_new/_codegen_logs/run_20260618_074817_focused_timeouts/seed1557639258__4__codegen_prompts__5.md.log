+
+
+def _draw_rooms(rooms: list[dict]) -> np.ndarray:
+    grid = np.full((CANVAS_SIZE, CANVAS_SIZE), BG, dtype=int)
+    for room in rooms:
+        r0, c0, r1, c1 = room["bbox"]
+        grid[r0, c0 : c1 + 1] = WALL
+        grid[r1, c0 : c1 + 1] = WALL
+        grid[r0 : r1 + 1, c0] = WALL
+        grid[r0 : r1 + 1, c1] = WALL
