+def _shape_variants(mask: np.ndarray) -> set[bytes]:
+    return {
+        mask.tobytes(),
+        np.fliplr(mask).tobytes(),
+        np.flipud(mask).tobytes(),
+        np.rot90(mask, 2).tobytes(),
