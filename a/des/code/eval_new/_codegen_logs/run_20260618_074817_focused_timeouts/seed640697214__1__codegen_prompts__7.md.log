+    if transform == "id":
+        return [("TR", INWARD["TR"]), ("BL", INWARD["BL"])]
+    if transform == "rot180":
+        return [("TR", OUTWARD["TR"]), ("BL", OUTWARD["BL"])]
+    if transform == "hflip":
+        hsign = rng.choice((-1, 1))
