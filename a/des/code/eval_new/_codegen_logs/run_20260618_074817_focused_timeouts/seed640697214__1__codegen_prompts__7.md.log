+
+def _l_cells(role: str, orient: tuple[int, int], h: int, w: int) -> list[tuple[int, int]]:
+    er, ec = _corner_position(role, h, w)
+    vr, hc = orient
+    return [(er, ec), (er + vr, ec), (er, ec + hc)]
