+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    global _GEN_COUNTER
+
+    count = rng.randint(2, 4)
+    height = rng.randint(max(18, count * 6), 30)
+    width = rng.randint(max(18, count * 6), 30)
