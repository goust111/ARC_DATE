+    top_corner = "TL" if "TL" in pair else "TR"
+    bottom_corner = "BL" if "BL" in pair else "BR"
+    top = by_role[top_corner]["orient"]
+    bottom = by_role[bottom_corner]["orient"]
+    if top[0] == 1 and bottom[0] == -1 and top[1] == bottom[1]:
+        return "hflip"
