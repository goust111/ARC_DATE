+        elbows = [info["elbow"] for info in l_infos]
+        roles = _diag_roles(elbows)
+        if roles is None:
+            continue
+
+        sr0 = min(r for r, _ in elbows)
+        sc0 = min(c for _, c in elbows)
+        sr1 = max(r for r, _ in elbows)
+        sc1 = max(c for _, c in elbows)
