+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+COLORS = tuple(range(1, 10))
+INWARD = {
+    "TL": (1, 1),
+    "TR": (1, -1),
+    "BL": (-1, 1),
+    "BR": (-1, -1),
+}
+OUTWARD = {corner: (-vr, -hc) for corner, (vr, hc) in INWARD.items()}
+CORNER_OFFSETS = {
+    "TL": (0, 0),
+    "TR": (0, -1),
+    "BL": (-1, 0),
+    "BR": (-1, -1),
+}
+_GEN_COUNTER = 0
