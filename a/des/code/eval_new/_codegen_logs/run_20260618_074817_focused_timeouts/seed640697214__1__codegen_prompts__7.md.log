+def _classify_l(coords: np.ndarray) -> dict | None:
+    if coords.shape != (3, 2):
+        return None
+    pts = [tuple(map(int, pt)) for pt in coords]
+    ptset = set(pts)
+    elbow = None
+    for r, c in pts:
+        deg = sum((nr, nc) in ptset for nr, nc in _neighbors4(r, c))
+        if deg == 2:
