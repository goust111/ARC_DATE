+    return None
+
+
+def _pattern_patch(h: int, w: int, color: int, rng: random.Random) -> np.ndarray | None:
+    inner_h = h - 2
+    inner_w = w - 2
+    mask = _random_mask(inner_h, inner_w, rng)
+    if mask is None:
+        return None
+    patch = np.zeros((h, w), dtype=int)
+    patch[1 : h - 1, 1 : w - 1][mask] = color
