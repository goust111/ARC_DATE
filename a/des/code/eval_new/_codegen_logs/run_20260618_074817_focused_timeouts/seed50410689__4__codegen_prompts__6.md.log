+
+def _add(a: tuple[int, int], b: tuple[int, int]) -> tuple[int, int]:
+    return a[0] + b[0], a[1] + b[1]
+
+
+def _in_bounds(cell: tuple[int, int], shape: tuple[int, int]) -> bool:
+    r, c = cell
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
