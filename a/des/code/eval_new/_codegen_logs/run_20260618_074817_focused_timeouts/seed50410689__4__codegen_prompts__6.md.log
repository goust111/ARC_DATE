    else:
        out[floor_row, int(bottom_cols.min()) + 1 :] = TRAIL_COLOR

    inp = out.copy()
    inp[inp == obj] = bg
    inp[floor_row, inp[floor_row] == TRAIL_COLOR] = floor
    _gen_place_original(inp, empty_rows, src_side, obj, obj_mask)

    return inp if np.array_equal(main(inp), out) else None


