+
+def _line_to_boundary(
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    shape: tuple[int, int],
+    *,
+    include_start: bool,
+) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    cur = start
+    if include_start:
+        out.append(cur)
+    while True:
+        cur = _add(cur, direction)
+        if not _in_bounds(cur, shape):
