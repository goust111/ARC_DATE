+
+
+def _paint_path(
+    out: np.ndarray,
+    owners: dict[tuple[int, int], int],
+    mixed: set[tuple[int, int]],
+    cell: tuple[int, int],
+    color: int,
+) -> None:
+    prev = owners.get(cell)
+    if prev is None:
+        owners[cell] = color
+        out[cell] = color
+    elif prev == color:
+        if cell in mixed:
+            out[cell] = YELLOW
+        else:
+            out[cell] = color
+    else:
+        mixed.add(cell)
+        out[cell] = YELLOW
