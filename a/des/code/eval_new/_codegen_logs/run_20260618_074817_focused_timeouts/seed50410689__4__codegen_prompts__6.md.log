+import numpy as np
+
+
+BG = 0
+YELLOW = 4
+GREY = 5
+SOURCE_COLORS = [1, 2, 3, 6, 7, 8, 9]
+
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+TURN_OPTIONS = {
+    UP: (LEFT, RIGHT),
+    DOWN: (LEFT, RIGHT),
