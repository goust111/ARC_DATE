+
+def _path_cells_ok(
+    cells: list[tuple[int, int]],
+    shape: tuple[int, int],
+    mirror_cells: set[tuple[int, int]],
+    forbidden: set[tuple[int, int]],
+    used_path: set[tuple[int, int]],
+    allowed_overlap: set[tuple[int, int]],
+) -> bool:
