    src_side = "right" if dst_side == "left" else "left"

    out = np.full((height, width), bg, dtype=int)
    out[floor_row:, :] = floor
    bottom_cols = _gen_place_sheared(out, empty_rows, dst_side, obj, obj_mask)
    if dst_side == "right":
