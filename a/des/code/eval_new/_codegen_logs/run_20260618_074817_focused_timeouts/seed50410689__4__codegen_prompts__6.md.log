+    shape: tuple[int, int],
+    mirror_cells: set[tuple[int, int]],
+    forbidden: set[tuple[int, int]],
+    used_path: set[tuple[int, int]],
+) -> tuple[list[tuple[int, int]], list[tuple[tuple[int, int], tuple[int, int]]]] | None:
