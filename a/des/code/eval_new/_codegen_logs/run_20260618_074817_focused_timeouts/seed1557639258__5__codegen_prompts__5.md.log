+
+def _all_dim_candidates(dim_cap: int) -> dict[int, list[tuple[int, int]]]:
+    out: dict[int, list[tuple[int, int]]] = {}
+    for h in range(1, dim_cap + 1):
+        for w in range(h, dim_cap + 1):
+            area = h * w
+            out.setdefault(area, []).append((h, w))
+    return out
