+def _can_place_rect(occ: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int = 1) -> bool:
+    h0, w0 = occ.shape
+    r1 = r0 + h - 1
+    c1 = c0 + w - 1
+    if r0 < 0 or c0 < 0 or r1 >= h0 or c1 >= w0:
+        return False
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h0 - 1, r1 + pad)
+    cc1 = min(w0 - 1, c1 + pad)
+    return not bool(np.any(occ[rr0 : rr1 + 1, cc0 : cc1 + 1]))
