+def _generate_attempt() -> np.ndarray | None:
+    group_count = random.choice([1, 2, 3])
+    dim_cap = 7 if group_count == 1 else 6 if group_count == 2 else 5
+    block_choices = [2, 3, 4] if group_count < 3 else [2, 3]
