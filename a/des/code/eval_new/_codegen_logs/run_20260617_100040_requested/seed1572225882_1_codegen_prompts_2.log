{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom collections import deque\n\ndef to_mask(rows):\n    h=len(rows); w=len(rows[0]); m=0\n    for r,row in enumerate(rows):\n        for c,ch in enumerate(row):\n            if ch=='1': m |= 1<<(r*w+c)\n    return m,h,w\n\ndef conn(mask,h,w):\n    if mask==0: return False\n    start=(mask & -mask).bit_length()-1\n    seen=1<<start; q=[start]\n    while q:\n        i=q.pop(); r,c=divmod(i,w)\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w:\n                j=nr*w+nc; b=1<<j\n                if mask & b and not seen & b:\n                    seen|=b; q.append(j)\n    return seen==mask\n\ndef full(mask,h,w):\n    top=any((mask>>c)&1 for c in range(w))\n    bot=any((mask>>((h-1)*w+c))&1 for c in range(w))\n    left=any((mask>>(r*w))&1 for r in range(h))\n    right=any((mask>>(r*w+w-1))&1 for r in range(h))\n    return top and bot and left and right\n\ndef printm(mask,h,w):\n    for r in range(h):\n        print(''.join('1' if (mask>>(r*w+c))&1 else '0' for c in range(w)))\n    print()\nrows=['111111','111110','100110','100000','111110']\nmask,h,w=to_mask(rows)\nfullmask=(1<<(h*w))-1\nprint('start')\nprintm(mask,h,w)\nseen={mask}\nq=deque([(mask,0)])\nlimit=4\nwhile q:\n    m,d=q.popleft()\n    comp=fullmask\"'^m\n    if conn(m,h,w) and conn(comp,h,w) and full(m,h,w) and full(comp,h,w):\n        print('\"'FOUND at dist',d)\n        printm(m,h,w)\n        break\n    if d==limit: continue\n    # allow toggle one cell or swap? try toggles first\n    for i in range(h*w):\n        nm=m\"'^(1<<i)\n        if nm not in seen:\n            seen.add(nm); q.append((nm,d+1))\nelse:\n    print('\"'none within',limit,'states',len(seen))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
