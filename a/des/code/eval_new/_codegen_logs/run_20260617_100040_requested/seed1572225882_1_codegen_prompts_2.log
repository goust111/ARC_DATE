{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nfrom collections import deque\n\ndef comp(mask):\n    h=len(mask); w=len(mask[0])\n    vis=[[False]*w for _ in range(h)]\n    comps=[]\n    for r in range(h):\n        for c in range(w):\n            if mask[r][c] and not vis[r][c]:\n                q=deque([(r,c)]); vis[r][c]=True; pts=[]\n                while q:\n                    x,y=q.popleft(); pts.append((x,y))\n                    for dx,dy in [(1,0),(-1,0),(0,1),(0,-1)]:\n                        nx,ny=x+dx,y+dy\n                        if 0<=nx<h and 0<=ny<w and mask[nx][ny] and not vis[nx][ny]:\n                            vis[nx][ny]=True; q.append((nx,ny))\n                comps.append(pts)\n    return comps\n\ndef ok(cells,h,w):\n    s=set(cells)\n    if len(comp([[ (r,c) in s for c in range(w)] for r in range(h)]))\"'!=1:\n        return False\n    t={(r,c) for r in range(h) for c in range(w)}-s\n    if len(comp([[ (r,c) in t for c in range(w)] for r in range(h)]))!=1:\n        return False\n    for u in [s,t]:\n        rs=[r for r,c in u]; cs=[c for r,c in u]\n        if min(rs)!=0 or max(rs)!=h-1 or min(cs)!=0 or max(cs)!=w-1:\n            return False\n    return True\n\ndef grow(h,w,target,tries=2000):\n    allc=[(r,c) for r in range(h) for c in range(w)]\n    for _ in range(tries):\n        hub=(random.randrange(1,h-1), random.randrange(1,w-1)) if h>2 and w>2 else (random.randrange(h), random.randrange(w))\n        borders=[(0, random.randrange(w)), (h-1, random.randrange(w)), (random.randrange(h),0), (random.randrange(h),w-1)]\n        s={hub}\n        for br,bc in borders:\n            r,c=hub\n            # random hv or vh\n            if random.random()<0.5:\n                step=1 if br>=r else -1\n                for rr in range(r, br+step, step): s.add((rr,c))\n                step=1 if bc>=c else -1\n                for cc in range(c, bc+step, step): s.add((br,cc))\n            else:\n                step=1 if bc>=c else -1\n                for cc in range(c, bc+step, step): s.add((r,cc))\n                step=1 if br>=r else -1\n                for rr in range(r, br+step, step): s.add((rr,bc))\n        if len(s)>target:\n            continue\n        while len(s)<target:\n            frontier=[]\n            for r,c in s:\n                for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:\n                    nr,nc=r+dr,c+dc\n                    if 0<=nr<h and 0<=nc<w and (nr,nc) not in s:\n                        frontier.append((nr,nc))\n            if not frontier:\n                break\n            s.add(random.choice(frontier))\n        if len(s)==target and ok(s,h,w):\n            return True\n    return False\n\nfor h,w in [(4,5),(4,6),(5,5),(5,6),(6,6),(5,7),(6,7)]:\n    n=h*w\n    for target in [n//2, n//2-2, n//2+2]:\n        if 4<=target<=n-4:\n            cnt=0\n            for _ in range(100):\n                if grow(h,w,target,200): cnt+=1\n            print((h,w,target,cnt))\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
