{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom collections import deque\n\ndef conn(mask,h,w):\n    pts=[i for i in range(h*w) if (mask>>i)&1]\n    if not pts: return False\n    seen={pts[0]}; q=deque([pts[0]])\n    while q:\n        i=q.popleft(); r,c=divmod(i,w)\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            j=nr*w+nc\n            if 0<=nr<h and 0<=nc<w and ((mask>>j)&1) and j not in seen:\n                seen.add(j); q.append(j)\n    return len(seen)==len(pts)\n\ndef fullbbox(mask,h,w):\n    rows=[]; cols=[]\n    for i in range(h*w):\n        if (mask>>i)&1:\n            r,c=divmod(i,w); rows.append(r); cols.append(c)\n    return min(rows)==0 and max(rows)==h-1 and min(cols)==0 and max(cols)==w-1\n\nfor h,w in [(4,4),(4,5),(4,6)]:\n    n=h*w\n    found=0\n    for mask in range(1,1<<n):\n        if not conn(mask,h,w):\n            continue\n        comp=((1<<n)-1)\"'^mask\n        if not conn(comp,h,w):\n            continue\n        if not fullbbox(mask,h,w) or not fullbbox(comp,h,w):\n            continue\n        print('\"'found',h,w,bin(mask))\n        found=1\n        break\n    print('done',h,w,found)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
