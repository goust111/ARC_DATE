{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom z3 import *\n\ndef solve(h,w,area=None):\n    n=h*w\n    idx=lambda r,c:r*w+c\n    x=[Bool(f'x_{i}') for i in range(n)]\n    s=Solver()\n    if area is not None:\n        s.add(Sum([If(v,1,0) for v in x])==area)\n    # both colors on each border\n    top=[idx(0,c) for c in range(w)]\n    bot=[idx(h-1,c) for c in range(w)]\n    left=[idx(r,0) for r in range(h)]\n    right=[idx(r,w-1) for r in range(h)]\n    for border in [top,bot,left,right]:\n        s.add(Or([x[i] for i in border]))\n        s.add(Or([Not(x[i]) for i in border]))\n\n    def add_conn(val, root_i):\n        # flow on directed edges\n        dirs=[]\n        for r in range(h):\n            for c in range(w):\n                i=idx(r,c)\n                for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                    nr,nc=r+dr,c+dc\n                    if 0<=nr<h and 0<=nc<w:\n                        j=idx(nr,nc)\n                        f=Int(f'f_{val}_{i}_{j}')\n                        dirs.append((i,j,f))\n                        s.add(f>=0, f<=n)\n                        s.add(Implies(f>0, And((x[i] if val else Not(x[i])), (x[j] if val else Not(x[j])))))\n        cells=[(x[i] if val else Not(x[i])) for i in range(n)]\n        # root active\n        s.add(cells[root_i])\n        total=Sum([If(c,1,0) for c in cells])\n        for i in range(n):\n            infl=Sum([f for a,b,f in dirs if b==i])\n            out=Sum([f for a,b,f in dirs if a==i])\n            if i==root_i:\n                s.add(out - infl == total - 1)\n            else:\n                s.add(If(cells[i], infl - out == 1, infl == 0))\n    # try fixed roots one cell each maybe corners?\n    add_conn(True, idx(0,0))\n    add_conn(False, idx(0,w-1))\n    if s.check()\"'!=sat:\n        return None\n    m=s.model()\n    g=[[1 if is_true(m[x[idx(r,c)]]) else 0 for c in range(w)] for r in range(h)]\n    return g\n\nfor h,w in [(5,6),(6,6),(5,7),(6,7),(7,7)]:\n    for area in [None, (h*w)//2, (h*w)//2-1, (h*w)//2+1, (h*w)//2-3, (h*w)//2+3]:\n        try:\n            g=solve(h,w,area)\n        except Exception as e:\n            print('\"'err',h,w,area,e)\n            continue\n        print('try',h,w,area,'->',g is not None)\n        if g is not None:\n            for row in g: print(''.join(map(str,row)))\n            raise SystemExit\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
