{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom z3 import *\nimport itertools, time\n\ndef solve(h,w,rootA,rootB,area=None, timeout_ms=5000):\n    n=h*w\n    idx=lambda r,c:r*w+c\n    x=[Bool(f'x_{i}') for i in range(n)]\n    la=[Int(f'la_{i}') for i in range(n)]\n    lb=[Int(f'lb_{i}') for i in range(n)]\n    s=Solver()\n    s.set(timeout=timeout_ms)\n    for arr in [la,lb]:\n        for v in arr:\n            s.add(v>=0, v<n)\n    if area is not None:\n        s.add(Sum([If(v,1,0) for v in x])==area)\n    borders=[[idx(0,c) for c in range(w)], [idx(h-1,c) for c in range(w)], [idx(r,0) for r in range(h)], [idx(r,w-1) for r in range(h)]]\n    for border in borders:\n        s.add(Or([x[i] for i in border]))\n        s.add(Or([Not(x[i]) for i in border]))\n    ra=idx(*rootA); rb=idx(*rootB)\n    s.add(x[ra], la[ra]==0)\n    s.add(Not(x[rb]), lb[rb]==0)\n    nbrs=[]\n    for i in range(n):\n        r,c=divmod(i,w)\n        lst=[]\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w:\n                lst.append(idx(nr,nc))\n        nbrs.append(lst)\n    for i in range(n):\n        if i\"'!=ra:\n            s.add(Implies(x[i], And(la[i]>0, Or([And(x[j], la[j] < la[i]) for j in nbrs[i]]))))\n        if i!=rb:\n            s.add(Implies(Not(x[i]), And(lb[i]>0, Or([And(Not(x[j]), lb[j] < lb[i]) for j in nbrs[i]]))))\n    chk=s.check()\n    if chk!=sat:\n        return chk,None\n    m=s.model()\n    g=[[1 if is_true(m[x[idx(r,c)]]) else 0 for c in range(w)] for r in range(h)]\n    return sat,g\n\nfor h,w in [(5,6),(6,6),(5,7),(6,7),(7,7),(6,8),(7,8),(8,8)]:\n    bordercells=[]\n    for c in range(w): bordercells.append((0,c)); bordercells.append((h-1,c))\n    for r in range(1,h-1): bordercells.append((r,0)); bordercells.append((r,w-1))\n    seen=[]\n    print('\"'trying',h,w)\n    for rootA, rootB in itertools.product(bordercells,bordercells):\n        if rootA==rootB: continue\n        for area in [None, h*w//2, h*w//2-1, h*w//2+1, h*w//2-2, h*w//2+2]:\n            st=time.time(); chk,g=solve(h,w,rootA,rootB,area,2000)\n            if g is not None:\n                print('FOUND',h,w,'roots',rootA,rootB,'area',area,'time',round(time.time()-st,2))\n                for row in g: print(''.join(map(str,row)))\n                raise SystemExit\n    print('none',h,w)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"python -u - <<'PY'\nfrom z3 import *\nimport itertools, time\n\ndef solve(h,w,rootA,rootB,area=None, timeout_ms=5000):\n    n=h*w\n    idx=lambda r,c:r*w+c\n    x=[Bool(f'x_{i}') for i in range(n)]\n    la=[Int(f'la_{i}') for i in range(n)]\n    lb=[Int(f'lb_{i}') for i in range(n)]\n    s=Solver(); s.set(timeout=timeout_ms)\n    for arr in [la,lb]:\n        for v in arr:\n            s.add(v>=0, v<n)\n    if area is not None:\n        s.add(Sum([If(v,1,0) for v in x])==area)\n    borders=[[idx(0,c) for c in range(w)], [idx(h-1,c) for c in range(w)], [idx(r,0) for r in range(h)], [idx(r,w-1) for r in range(h)]]\n    for border in borders:\n        s.add(Or([x[i] for i in border]))\n        s.add(Or([Not(x[i]) for i in border]))\n    ra=idx(*rootA); rb=idx(*rootB)\n    s.add(x[ra], la[ra]==0)\n    s.add(Not(x[rb]), lb[rb]==0)\n    nbrs=[]\n    for i in range(n):\n        r,c=divmod(i,w)\n        lst=[]\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w:\n                lst.append(idx(nr,nc))\n        nbrs.append(lst)\n    for i in range(n):\n        if i\"'!=ra:\n            s.add(Implies(x[i], And(la[i]>0, Or([And(x[j], la[j] < la[i]) for j in nbrs[i]]))))\n        if i!=rb:\n            s.add(Implies(Not(x[i]), And(lb[i]>0, Or([And(Not(x[j]), lb[j] < lb[i]) for j in nbrs[i]]))))\n    chk=s.check()\n    if chk!=sat:\n        return chk,None\n    m=s.model()\n    g=[[1 if is_true(m[x[idx(r,c)]]) else 0 for c in range(w)] for r in range(h)]\n    return sat,g\n\nh,w=6,8\nroots=[(0,0),(0,w-1),(h-1,0),(h-1,w-1)]\nfor rootA, rootB in itertools.permutations(roots,2):\n    for area in [h*w//2, h*w//2-2, h*w//2+2, None]:\n        st=time.time(); chk,g=solve(h,w,rootA,rootB,area,5000)\n        print('\"'try',rootA,rootB,area,chk,round(time.time()-st,2), flush=True)\n        if g is not None:\n            for row in g: print(''.join(map(str,row)), flush=True)\n            raise SystemExit\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
