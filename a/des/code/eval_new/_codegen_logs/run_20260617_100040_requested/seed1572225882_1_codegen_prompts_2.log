{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, time\nfrom collections import deque\n\ndef conn(mask,h,w):\n    if mask==0: return False\n    # find first bit\n    start=(mask & -mask).bit_length()-1\n    seen=1<<start\n    q=[start]\n    while q:\n        i=q.pop(); r,c=divmod(i,w)\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w:\n                j=nr*w+nc\n                b=1<<j\n                if mask & b and not seen & b:\n                    seen |= b; q.append(j)\n    return seen==mask\n\ndef bbox_full(mask,h,w):\n    top=any((mask>>c)&1 for c in range(w))\n    bot=any((mask>>( (h-1)*w + c))&1 for c in range(w))\n    left=any((mask>>(r*w))&1 for r in range(h))\n    right=any((mask>>(r*w+w-1))&1 for r in range(h))\n    return top and bot and left and right\n\ndef score(mask,h,w,fullmask):\n    comp=fullmask\"'^mask\n    s=0\n    if conn(mask,h,w): s+=10\n    if conn(comp,h,w): s+=10\n    s += sum((mask>>c)&1 for c in range(w))>0\n    s += sum((comp>>c)&1 for c in range(w))>0\n    s += sum((mask>>((h-1)*w+c))&1 for c in range(w))>0\n    s += sum((comp>>((h-1)*w+c))&1 for c in range(w))>0\n    s += sum((mask>>(r*w))&1 for r in range(h))>0\n    s += sum((comp>>(r*w))&1 for r in range(h))>0\n    s += sum((mask>>(r*w+w-1))&1 for r in range(h))>0\n    s += sum((comp>>(r*w+w-1))&1 for r in range(h))>0\n    return int(s)\n\ndef printmask(mask,h,w):\n    for r in range(h):\n        print('\"''.join('1' if (mask>>(r*w+c))&1 else '0' for c in range(w)))\n\nfor h,w in [(5,6),(6,6),(5,7),(6,7),(7,7),(6,8),(7,8)]:\n    n=h*w; fullmask=(1<<n)-1\n    best=-1; bestmask=None\n    start=time.time()\n    for restart in range(500):\n        area=random.randint(n//3, 2*n//3)\n        bits=random.sample(range(n), area)\n        mask=0\n        for i in bits: mask |= 1<<i\n        cur=score(mask,h,w,fullmask)\n        T=2.0\n        for step in range(40000):\n            # swap one in one out\n            ones=[i for i in range(n) if (mask>>i)&1]\n            zeros=[i for i in range(n) if not (mask>>i)&1]\n            i=random.choice(ones); j=random.choice(zeros)\n            new=mask \"'^ (1<<i) ''^ (1<<j)\n            sc=score(new,h,w,fullmask)\n            if sc>=cur or random.random()<0.02*T:\n                mask,cur=new,sc\n            T*=0.99998\n            if cur>best:\n                best, bestmask = cur, mask\n                print('\"'best',h,w,best,'area',mask.bit_count(), 't', round(time.time()-start,1), flush=True)\n                printmask(mask,h,w); print(flush=True)\n            if cur==28 and bbox_full(mask,h,w) and bbox_full(fullmask\"'^mask,h,w):\n                print('\"'FOUND',h,w,'area',mask.bit_count(), flush=True)\n                printmask(mask,h,w)\n                raise SystemExit\n    print('done',h,w,best)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
