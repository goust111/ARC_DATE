{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport itertools, random\nfrom collections import deque\n\n# 2x2 motifs where both pattern and complement are 4-connected and nonempty\nmotifs=[]\nfor bits in range(1,15):\n    cells={(r,c) for r in range(2) for c in range(2) if (bits>>(r*2+c))&1}\n    comp={(r,c) for r in range(2) for c in range(2)}-cells\n    def conn(S):\n        if not S: return False\n        q=deque([next(iter(S))]); seen={q[0]}\n        while q:\n            r,c=q.popleft()\n            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                p=(r+dr,c+dc)\n                if p in S and p not in seen:\n                    seen.add(p); q.append(p)\n        return len(seen)==len(S)\n    if conn(cells) and conn(comp): motifs.append(bits)\nprint('motifs',len(motifs),motifs)\n\ndef build(blocks):\n    bh=len(blocks); bw=len(blocks[0])\n    h,w=2*bh,2*bw\n    g=[[0]*w for _ in range(h)]\n    for br in range(bh):\n        for bc in range(bw):\n            bits=blocks[br][bc]\n            for r in range(2):\n                for c in range(2):\n                    g[2*br+r][2*bc+c]=1 if (bits>>(r*2+c))&1 else 0\n    return g\n\ndef check(g):\n    h=len(g); w=len(g[0])\n    for val in [1,0]:\n        pts={(r,c) for r in range(h) for c in range(w) if g[r][c]==val}\n        q=deque([next(iter(pts))]); seen={q[0]}\n        while q:\n            r,c=q.popleft()\n            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                p=(r+dr,c+dc)\n                if p in pts and p not in seen:\n                    seen.add(p); q.append(p)\n        if len(seen)\"'!=len(pts): return False\n        rs={r for r,c in pts}; cs={c for r,c in pts}\n        if not (0 in rs and h-1 in rs and 0 in cs and w-1 in cs): return False\n    return True\n\nfor bh,bw in [(3,3),(3,4),(4,4)]:\n    for t in range(50000):\n        blocks=[[random.choice(motifs) for _ in range(bw)] for _ in range(bh)]\n        g=build(blocks)\n        if check(g):\n            print('\"'FOUND',bh,bw)\n            for row in g: print(''.join(map(str,row)))\n            raise SystemExit\n    print('none',bh,bw)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
