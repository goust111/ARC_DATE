+            if value == BLACK:
+                continue
+
+            if value == RED:
+                source_count += 1
+                if r not in {0, grid.shape[0] - 1} and c not in {0, grid.shape[1] - 1}:
+                    return False
+                if len(neighbors) != 1 or int(grid[neighbors[0]]) != GREY:
+                    return False
+                continue
+
+            if value == MAROON:
+                terminal_count += 1
+                if len(neighbors) != 1 or int(grid[neighbors[0]]) != GREY:
+                    return False
+                continue
+
+            if value in NODE_COLORS:
+                if any(int(grid[nr, nc]) != GREY for nr, nc in neighbors):
