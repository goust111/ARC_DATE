+
+def _find_legend(g: np.ndarray, bg: int) -> tuple[np.ndarray, list[int]]:
+    h, w = g.shape
+    candidates: list[tuple[np.ndarray, list[int]]] = []
+
+    for coords in _components(g != bg):
+        area = int(len(coords))
+        if not 2 <= area <= 4:
+            continue
+
+        r0, c0, r1, c1 = _bbox(coords)
