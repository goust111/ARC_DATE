+    for bbox, gap_count in zip(all_bboxes, gap_counts):
+        if gap_count == 0:
+            continue
+        cells = sorted(_border_cells(bbox))
+        pick = rng.choice(len(cells), size=gap_count, replace=False)
+        for idx in np.atleast_1d(pick):
