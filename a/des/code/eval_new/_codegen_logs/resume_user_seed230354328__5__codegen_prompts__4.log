+def _dilate4(mask: np.ndarray) -> np.ndarray:
+    base = mask.astype(bool)
+    out = base.copy()
+    out[1:, :] |= base[:-1, :]
+    out[:-1, :] |= base[1:, :]
+    out[:, 1:] |= base[:, :-1]
+    out[:, :-1] |= base[:, 1:]
+    return out
