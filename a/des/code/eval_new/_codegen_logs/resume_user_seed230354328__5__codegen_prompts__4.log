+def _paint_border(out: np.ndarray, bbox: tuple[int, int, int, int], color: int) -> None:
+    r0, c0, r1, c1 = bbox
+    out[r0, c0 : c1 + 1] = color
+    out[r1, c0 : c1 + 1] = color
+    out[r0 : r1 + 1, c0] = color
+    out[r0 : r1 + 1, c1] = color
