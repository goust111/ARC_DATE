+            (r0 == 0 and c0 == 0)
+            or (r0 == 0 and c1 == w - 1)
+            or (r1 == h - 1 and c0 == 0)
+            or (r1 == h - 1 and c1 == w - 1)
+        )
+        if not touches_corner:
+            continue
+
+        if r0 == r1:
+            order = np.argsort(coords[:, 1], kind="stable")
+        else:
+            order = np.argsort(coords[:, 0], kind="stable")
