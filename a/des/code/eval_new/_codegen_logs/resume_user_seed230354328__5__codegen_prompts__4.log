+        for depth, bbox in enumerate(bboxes):
+            _paint_border(out, bbox, legend_colors[depth])
+
+    return out
+
+
+# --------------- generator ---------------
+
+_BG = 0
+_WORK_SIZE = 30
+_PALETTE = tuple(range(1, 10))
+_GEN_ATTEMPTS = 300
+_GROUP_PADDING = 2
+_LEGEND_PADDING = 1
+_EXTRA_MARGIN_MAX = 3
