+    r0, c0, r1, c1 = bbox
+    cells = {(r0, c) for c in range(c0, c1 + 1)}
+    cells |= {(r1, c) for c in range(c0, c1 + 1)}
+    cells |= {(r, c0) for r in range(r0 + 1, r1)}
+    cells |= {(r, c1) for r in range(r0 + 1, r1)}
+    return cells
