+    for idx, (a, b) in enumerate(shuffled):
+        rr = 2 * (idx // block_cols)
+        cc = 3 * (idx % block_cols)
+        if random.random() < 0.5:
+            patch[rr, cc] = int(a)
+            patch[rr, cc + 1] = int(b)
+        else:
