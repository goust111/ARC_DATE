+        gc = coords[color][1] * s - piece["left_tab"]
+        for pr, pc in np.argwhere(piece["mask"]):
+            rr = int(gr + pr)
+            cc = int(gc + pc)
+            assert 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1]
+            assert not filled[rr, cc], "assembled pieces must not overlap"
+            filled[rr, cc] = True
+            out[rr, cc] = int(paint)
