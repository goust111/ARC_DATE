+
+
+def _decode_piece(mask: np.ndarray) -> dict:
+    candidates: list[tuple[int, int, int, int, int]] = []
+    h, w = mask.shape
+    for top, bottom, left, right in itertools.product((0, 1), repeat=4):
+        if not _valid_piece_frame(mask, top, bottom, left, right):
