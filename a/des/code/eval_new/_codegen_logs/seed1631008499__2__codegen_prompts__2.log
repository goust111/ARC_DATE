+def _pattern_pool(length: int) -> list[tuple[int, ...]]:
+    reps = []
+    for raw in itertools.product((-1, 0, 1), repeat=length):
+        if not any(raw):
+            continue
+        neg = _neg(raw)
+        if raw <= neg:
+            reps.append(tuple(int(x) for x in raw))
