+
+def _extract_pieces_and_edges(grid: np.ndarray) -> tuple[dict[int, dict], list[tuple[int, int]]]:
+    objects = _component_objects(grid)
+    legend_edges: list[tuple[int, int]] = []
+    pieces: dict[int, dict] = {}
