+    min_c = min(c for _r, c in coords.values())
+    norm = {color: (r - min_r, c - min_c) for color, (r, c) in coords.items()}
+    rows = max(r for r, _c in norm.values()) + 1
+    cols = max(c for _r, c in norm.values()) + 1
