+        if _match_signatures(pa["right"], pb["left"]):
+            matches.append((0, 1))
+        if _match_signatures(pa["left"], pb["right"]):
+            matches.append((0, -1))
+        if _match_signatures(pa["bottom"], pb["top"]):
+            matches.append((1, 0))
+        if _match_signatures(pa["top"], pb["bottom"]):
+            matches.append((-1, 0))
