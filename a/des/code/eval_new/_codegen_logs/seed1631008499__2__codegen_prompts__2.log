+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+PALETTE = tuple(range(1, 10))
+SIDES = ("top", "right", "bottom", "left")
+OPPOSITE = {"top": "bottom", "bottom": "top", "left": "right", "right": "left"}
+SIDE_DELTAS = {
+    "top": (-1, 0),
+    "right": (0, 1),
+    "bottom": (1, 0),
+    "left": (0, -1),
+}
+DEGREE_COLORS = {1: BLUE, 2: RED, 3: GREEN, 4: YELLOW}
+GEN_RETRIES = 500
