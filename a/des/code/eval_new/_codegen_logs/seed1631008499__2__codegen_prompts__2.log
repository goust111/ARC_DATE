+    return {
+        "mask": mask.copy(),
+        "core_size": int(s),
+        "top_tab": int(top),
+        "bottom_tab": int(bottom),
+        "left_tab": int(left),
+        "right_tab": int(right),
+        "top": side_sig("top"),
+        "right": side_sig("right"),
+        "bottom": side_sig("bottom"),
+        "left": side_sig("left"),
+    }
