+        "bottom_tab": int(bottom),
+        "left_tab": int(left),
+        "right_tab": int(right),
+        "top": side_sig("top"),
+        "right": side_sig("right"),
+        "bottom": side_sig("bottom"),
+        "left": side_sig("left"),
