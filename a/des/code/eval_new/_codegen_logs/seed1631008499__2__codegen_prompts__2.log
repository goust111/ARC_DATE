+                    vals.append(0)
+            elif name == "left":
+                if left and bool(mask[top + pos, 0]):
+                    vals.append(1)
+                elif not bool(core[pos, 0]):
+                    vals.append(-1)
+                else:
+                    vals.append(0)
+            else:
+                if right and bool(mask[top + pos, -1]):
+                    vals.append(1)
+                elif not bool(core[pos, -1]):
+                    vals.append(-1)
