+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+PALETTE = tuple(range(1, 10))
+SIDES = ("top", "right", "bottom", "left")
+OPPOSITE = {"top": "bottom", "bottom": "top", "left": "right", "right": "left"}
+SIDE_DELTAS = {
+    "top": (-1, 0),
+    "right": (0, 1),
+    "bottom": (1, 0),
+    "left": (0, -1),
+}
+DEGREE_COLORS = {1: BLUE, 2: RED, 3: GREEN, 4: YELLOW}
+GEN_RETRIES = 500
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r0 in range(h):
+        for c0 in range(w):
+            if not mask[r0, c0] or seen[r0, c0]:
+                continue
+            stack = [(r0, c0)]
+            seen[r0, c0] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                comp.append((int(r), int(c)))
+                for nr, nc in _neighbors4(r, c, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            out.append(comp)
+    return out
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    comps = _components(mask)
+    return len(comps) == 1 and int(np.sum(mask)) == len(comps[0])
+
+
+def _component_objects(grid: np.ndarray) -> list[dict]:
+    objects = []
+    for coords in _components(grid != BLACK):
+        r0, c0, r1, c1 = _bbox(coords)
+        sub = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        colors = set()
+        for r, c in coords:
+            sub[r - r0, c - c0] = True
+            colors.add(int(grid[r, c]))
+        objects.append(
+            {
+                "coords": coords,
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "mask": sub,
+                "area": int(len(coords)),
+                "colors": colors,
+            }
+        )
+    return objects
+
+
+def _neg(sig: tuple[int, ...]) -> tuple[int, ...]:
+    return tuple(-x for x in sig)
+
+
+def _match_signatures(a: tuple[int, ...], b: tuple[int, ...]) -> bool:
+    return len(a) == len(b) and any(x != 0 or y != 0 for x, y in zip(a, b)) and all(
+        x == -y for x, y in zip(a, b)
+    )
+
+
+def _valid_piece_frame(mask: np.ndarray, top: int, bottom: int, left: int, right: int) -> bool:
+    h, w = mask.shape
+    s = h - top - bottom
+    if s < 3 or s != w - left - right:
+        return False
