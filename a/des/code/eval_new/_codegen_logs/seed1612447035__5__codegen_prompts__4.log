+    grid[r0 : r1 + 1, c1] = GREY
+    grid[r0, c0 : c1 + 1] = GREY
+    grid[r1, c0 : c1 + 1] = GREY
+    grid[sr, sc] = seed_color
+
+
+def _render_expected(inp: np.ndarray, rooms: list[tuple[int, int, int, int, int, int, int]]) -> np.ndarray:
+    out = inp.copy()
+    for room in rooms:
+        _paint_room(out, room)
+    return out
