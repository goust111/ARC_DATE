+            return int(node.x)
+        child_xs = [place_x(child) for child in node.children]
+        if len(child_xs) == 3:
+            node.x = int(child_xs[1])
+        else:
+            mode = rng.choice(("left-right", "left-up", "up-right"))
+            if mode == "left-right":
+                node.x = int((child_xs[0] + child_xs[1]) // 2)
+            elif mode == "left-up":
+                node.x = int(child_xs[1])
+            else:
+                node.x = int(child_xs[0])
