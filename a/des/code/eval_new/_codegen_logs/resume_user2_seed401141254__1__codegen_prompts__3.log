+from __future__ import annotations
+
+from collections import Counter, defaultdict
+from dataclasses import dataclass, field
+import random
+
+import numpy as np
+
+
+LINE_COLOR = 5
+LEAF_TERMINAL_ROW = 2
+LEAF_X_STEP = 4
+LEAF_COUNT_RANGE = (3, 7)
+NODE_GAP_RANGE = (2, 4)
+TRUNK_RANGE = (2, 4)
+MAX_TREE_DEPTH = 4
+GEN_RETRIES = 500
+COLOR_POOL = [0, 1, 2, 3, 4, 6, 7, 8, 9]
