+@dataclass(eq=False)
+class GenNode:
+    children: list["GenNode"] = field(default_factory=list)
+    leaf_color: int | None = None
+    leaf_index: int = -1
+    x: int = 0
+    row: int = 0
+    attach_offset: int = 0
