+                if 0 <= rr < h and 0 <= cc < w and network_mask[rr, cc]:
+                    touches.add((int(rr), int(cc)))
+        assert len(touches) == 1, "each 2x2 leaf must attach to exactly one terminal tree pixel"
+        term = next(iter(touches))
