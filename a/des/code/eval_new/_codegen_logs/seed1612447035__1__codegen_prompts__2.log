+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+_GEN_RETRIES = 400
+_BG = 0
+_WALL = 5
+_ARROW_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+_MIN_ROOM_INNER = 5
+_MAX_ROOM_INNER = 8
+_MIN_SIGNAL_LEN = 2
+_MAX_SIGNAL_LEN = 6
