+def _solve_grid(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    bg = _most_common_color(g)
+    counts = Counter(int(v) for v in g.ravel() if int(v) != bg)
+    wall = counts.most_common(1)[0][0]
+    rooms = _find_rooms(g, bg)
