+                        "side": "bottom",
+                        "direction": "up",
+                        "axis": "cols",
+                        "rows": None,
+                        "cols": (c - 1, c, c + 1),
+                        "arrow_cells": (outer, wing_a, wing_b),
+                        "signal_start": (br1 + 2, c),
+                        "signal_step": (1, 0),
+                        "capacity": cap,
