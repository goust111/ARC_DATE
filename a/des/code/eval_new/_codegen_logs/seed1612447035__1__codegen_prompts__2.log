+                    {
+                        "side": "top",
+                        "direction": "down",
+                        "axis": "cols",
+                        "rows": None,
+                        "cols": (c - 1, c, c + 1),
+                        "arrow_cells": (outer, wing_a, wing_b),
+                        "signal_start": (br0 - 2, c),
+                        "signal_step": (-1, 0),
+                        "capacity": cap,
+                    }
+                )
+
+        wing_a = (br1, c - 1)
+        wing_b = (br1, c + 1)
+        outer = (br1 + 1, c)
+        if int(grid[outer]) == _BG and int(grid[wing_a]) == _WALL and int(grid[wing_b]) == _WALL:
