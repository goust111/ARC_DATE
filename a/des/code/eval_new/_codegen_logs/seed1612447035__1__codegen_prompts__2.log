+        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in comp):
+            continue
+        rows = [r for r, _ in comp]
+        cols = [c for _, c in comp]
+        ir0, ir1 = min(rows), max(rows)
+        ic0, ic1 = min(cols), max(cols)
