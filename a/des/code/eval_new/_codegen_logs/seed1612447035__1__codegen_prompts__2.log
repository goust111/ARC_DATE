+def _signal_capacity(grid: np.ndarray, start: tuple[int, int], step: tuple[int, int]) -> int:
+    h, w = grid.shape
+    r, c = start
+    dr, dc = step
+    cap = 0
+    while 0 <= r < h and 0 <= c < w and int(grid[r, c]) == _BG:
+        cap += 1
+        r += dr
+        c += dc
+    return cap
+
