+    sizes = [
+        (
+            random.randint(_MIN_ROOM_INNER, _MAX_ROOM_INNER),
+            random.randint(_MIN_ROOM_INNER, _MAX_ROOM_INNER),
+        )
+        for _ in range(num_rooms)
