, grid != bg)\n\n\ndef _bbox_mask(shape: Tuple[int, int], r0: int, r1: int, c0: int, c1: int) -> np.ndarray:\n    mask = np.zeros(shape, dtype=bool)\n    mask[r0:r1, c0:c1] = True\n    return mask\n\n\ndef _apply_texture(grid: np.ndarray, cells: List[Tuple[int, int]], pattern: str, fg: int, bg: int, anchor: Tuple[int, int]) -> None:\n    ar, ac = anchor\n    for r, c in cells:\n        lr = r - ar\n        lc = c - ac\n        if pattern == \"h\":\n            on = (lr % 2 == 0)\n        elif pattern == \"v\":\n            on = (lc % 2 == 0)\n        else:\n            on = ((lr + lc) % 2 == 0)\n        grid[r, c] = fg if on else bg\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Fill each compact shape by assigning stripe texture from its area rank.\n\n    Input structure:\n    Grid uses a dominant background color (bg). A small corner legend shows three example textures (horizontal, vertical, checkerboard), separated by a gray border. The rest contains several distinct solid connected shapes, each a uniform color.\n\n    Rule:\n    Find bg as the most frequent color, detect and preserve the legend area, and extract connected non-bg shape components from the remaining cells. Sort shapes by area ascending (ties broken by top-left position: smaller row then smaller col). The 1st, 2nd, 3rd, ... ranked shapes are filled with repeating textures: horizontal stripes, vertical stripes, checkerboard, then repeat cyclically. For each shape, alternate the original color and bg over the shape based on the shape bounding-box top-left offset so that the box corner cell stays original color.\n\n    Key insight:\n    Ranking by area determines which texture type each object gets; the legend only provides the texture examples, while the mapping of ranks to patterns is fixed and cyclic.\n    \"\"\"\n    out = np.array(grid, copy=True)\n    bg = _most_common_color(grid)\n\n    legend_mask = _detect_legend_mask(grid, bg)\n\n    h, w = grid.shape\n    include = np.ones((h, w), dtype=bool)\n    include[legend_mask] = False\n\n    comps = _flood_components(grid, include, bg)\n    for comp in comps:\n        comp[\"bbox\"] = comp[\"bbox\"]\n\n    comps.sort(\n        key=lambda x: (\n            x[\"area\"],\n            x[\"bbox\"][0],\n            x[\"bbox\"][1],\n        )\n    )\n\n    patterns = (\"h\", \"v\", \"c\")\n\n    for i, comp in enumerate(comps):\n        rmin, cmin, _, _ = comp[\"bbox\"]\n        pattern = patterns[i % 3]\n        _apply_texture(out, comp[\"cells\"], pattern, int(comp[\"color\"]), int(bg), (rmin, cmin))\n\n    return out\n\n\ndef _draw_legend(area: np.ndarray, legend_colors: Tuple[int, int, int], border_color: int = 5) -> None:\n    h, w = area.shape\n    area[:] = 0\n    samples = 3\n    cell = 2\n    frame = cell + 2\n    gap = 1\n    start_row = 1\n    start_col = 1\n\n    for i in range(samples):\n        top = start_row\n        left = start_col + i * (frame + gap)\n        right = left + frame - 1\n        bottom = top + frame - 1\n        if right >= w - 1 or bottom >= h - 1:\n            break\n\n        # frame border\n        area[top:bottom + 1, [left, right]] = border_color\n        area[[top, bottom], left:right + 1] = border_color\n\n        # inner 2x2 payload\n        fill_colors = legend_colors\n        inner_top = top + 1\n        inner_left = left + 1\n        if i == 0:\n            # horizontal stripes\n            for rr in range(cell):\n                val = fill_colors[i] if (rr % 2 == 0) else area[top, left]  # bg placeholder\n                for cc in range(cell):\n                    area[inner_top + rr, inner_left + cc] = val if (cc == 0 or cc == 1) else val\n        elif i == 1:\n            # vertical stripes\n            for cc in range(cell):\n                val = fill_colors[i] if (cc % 2 == 0) else area[top, left]\n                for rr in range(cell):\n                    area[inner_top + rr, inner_left + cc] = val\n        else:\n            # checkerboard\n            for rr in range(cell):\n                for cc in range(cell):\n                    area[inner_top + rr, inner_left + cc] = fill_colors[i] if ((rr + cc) % 2 == 0) else area[top, left]\n\n\ndef _random_connected_shape(\n    h: int,\n    w: int,\n    area: int,\n    occupancy: np.ndarray,\n    row_low: int,\n    row_high: int,\n    col_low: int,\n    col_high: int,\n    rng: random.Random,\n) -> List[Tuple[int, int]]:\n    attempts = 0\n    max_attempts = 250\n    dirs = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\n    while attempts < max_attempts:\n        attempts += 1\n        r0 = rng.randrange(row_low, row_high)\n        c0 = rng.randrange(col_low, col_high)\n        if occupancy[r0, c0]:\n            continue\n\n        cells = [(r0, c0)]\n        cell_set = {(r0, c0)}\n        frontier = {(r0, c0)}\n\n        for _ in range(area - 1):\n            candidates = []\n            for fr, fc in list(frontier):\n                for dr, dc in dirs:\n                    nr, nc = fr + dr, fc + dc\n                    if nr < row_low or nr >= row_high or nc < col_low or nc >= col_high:\n                        continue\n                    if occupancy[nr, nc] or (nr, nc) in cell_set:\n                        continue\n                    candidates.append((nr, nc))\n\n            if not candidates:\n                break\n\n            nr, nc = rng.choice(candidates)\n            cells.append((nr, nc))\n            cell_set.add((nr, nc))\n            frontier.add((nr, nc))\n            for dr, dc in dirs:\n                ar, ac = nr + dr, nc + dc\n                if ar < row_low or ar >= row_high or ac < col_low or ac >= col_high:\n                    continue\n                if occupancy[ar, ac] or (ar, ac) in cell_set:\n                    continue\n            # keep frontier naturally growing.\n\n        if len(cells) == area:\n            return cells\n\n    return []\n\n\ndef _fill_shape(grid: np.ndarray, cells: List[Tuple[int, int]], color: int) -> None:\n    for r, c in cells:\n        grid[r, c] = color\n\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n\n    # Reasonable ARC-size canvas with enough room for top-left legend + interior objects.\n    h = rng.randint(16, 30)\n    w = rng.randint(20, 30)\n\n    bg = 0\n    gray = 5\n    grid = np.full((h, w), bg, dtype=np.int32)\n\n    # Legend occupies fixed, compact corner area.\n    legend_colors = (9, 8, 7)\n    area_h = 7\n    area_w = 16\n    legend = np.full((area_h, area_w), bg, dtype=np.int32)\n    # Draw 3 samples: horizontal / vertical / checkerboard.\n    _draw_legend(legend, legend_colors, border_color=gray)\n    grid[:area_h, :area_w] = legend\n\n    # Ensure legend stays visible and not too dense.\n    occupancy = grid != bg\n\n    # Keep shapes away from legend and outer border for readability.\n    row_low = area_h + 1\n    row_high = h - 1\n    col_low = 1\n    col_high = w - 1\n\n    n_shapes = rng.randint(3, 7)\n    shape_sizes = [rng.randint(7, 32) for _ in range(n_shapes)]\n\n    # Inject tie cases occasionally to exercise sorting tie-break rule.\n    if n_shapes >= 2 and rng.random() < 0.45:\n        i, j = rng.sample(range(n_shapes), 2)\n        shape_sizes[j] = shape_sizes[i]\n\n    palette = [1, 2, 3, 4, 6, 10, 11, 12]\n    rng.shuffle(palette)\n    colors = palette[:n_shapes]\n\n    for size, color in zip(shape_sizes, colors):\n        cells = _random_connected_shape(\n            h,\n            w,\n            size,\n            occupancy,\n            row_low,\n            row_high,\n            col_low,\n            col_high,\n            rng,\n        )\n\n        # Fallback: progressively shrink if a shape is hard to place.\n        tries = 0\n        effective_size = size\n        while not cells and tries < 4:\n            tries += 1\n            effective_size = max(4, effective_size - 4)\n            cells = _random_connected_shape(\n                h,\n                w,\n                effective_size,\n                occupancy,\n                row_low,\n                row_high,\n                col_low,\n                col_high,\n                rng,\n            )\n\n        if not cells:\n            continue\n\n        _fill_shape(grid, cells, color)\n        for r, c in cells:\n            occupancy[r, c] = True\n\n    return grid.astype(np.int32)\n\n\nif __name__ == \"__main__\":\n    for _ in range(3):\n        g = generate_input()\n        print(main(g))\nPY'","aggregated_output":"","exit_code":0,"status":"completed"}}
