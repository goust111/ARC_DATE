 # max h or w of a component bbox\n96:AREA_RANGE = (3, 13)              # component area in [3, 12]\n97:MIN_FILL_RATIO_X10 = 4            # area * 10 >= 4 * h * w\n98:IRREGULAR_PROB = 0.85             # prefer non-rectangular bboxes\n99:\n100:# ── CFG: layout ─────────────────────────────────────────────────────\n101:DUP_LAYOUTS = [(2,), (3,), (2, 2)]  # possible duplicate-group structures\n102:MIN_COL_GAP = 1                   # minimum column gap between components\n103:MIN_VERTICAL_GAP = 5              # min gap between top-group bottom and bottom-group top\n104:\n105:# ── CFG: generation ─────────────────────────────────────────────────\n106:MAX_RETRIES = 300                 # outer generate_input retry budget\n107:\n108:_NEIGHBORS8 = [(-1, -1), (-1, 0), (-1, 1), (0, -1),\n109:               (0, 1), (1, -1), (1, 0), (1, 1)]\n110:\n111:\n112:def _feasible_dims(area: int) -> list[tuple[int, int]]:\n113:    \"\"\"Return all (h, w) bboxes where area fits with fill_ratio >= MIN_FILL_RATIO_X10/10.\"\"\"\n114:    dims = []\n115:    for h in range(1, BBOX_MAX + 1):\n116:        for w in range(1, BBOX_MAX + 1):\n117:            if area > h * w:\n118:                continue\n119:            if area * 10 < MIN_FILL_RATIO_X10 * h * w:\n120:                continue\n121:            if h == 1 and area != w:\n122:                continue\n123:            if w == 1 and area != h:\n124:                continue\n125:            if h > 1 and w > 1 and area < max(h, w):\n126:                continue\n127:            dims.append((h, w))\n128:    return dims\n129:\n130:\n131:def _line_mask(h: int, w: int) -> np.ndarray:\n132:    \"\"\"Create a seed mask along a diagonal line spanning the bbox, randomly flipped.\"\"\"\n133:    mask = np.zeros((h, w), dtype=bool)\n134:    if h == 1:\n135:        mask[0, :] = True\n136:        return mask\n137:    if w == 1:\n138:        mask[:, 0] = True\n139:        return mask\n140:    steps = max(h, w)\n141:    for i in range(steps):\n142:        r = int(round(i * (h - 1) / (steps - 1)))\n143:        c = int(round(i * (w - 1) / (steps - 1)))\n144:        mask[r, c] = True\n145:    if bool(_RNG.integers(0, 2)):\n146:        mask = np.flipud(mask)\n147:    if bool(_RNG.integers(0, 2)):\n148:        mask = np.fliplr(mask)\n149:    return mask\n150:\n151:\n152:def _make_mask(h: int, w: int, area: int) -> np.ndarray:\n153:    \"\"\"Grow an 8-connected mask from a line seed to the target area.\"\"\"\n154:    mask = _line_mask(h, w)\n155:    while int(mask.sum()) < area:\n156:        frontier = set()\n157:        for r, c in np.argwhere(mask):\n158:            for dr, dc in _NEIGHBORS8:\n159:                nr, nc = int(r) + dr, int(c) + dc\n160:                if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:\n161:                    frontier.add((nr, nc))\n162:        pick = list(frontier)\n163:        nr, nc = pick[int(_RNG.integers(0, len(pick)))]\n164:        mask[nr, nc] = True\n165:    return mask\n166:\n167:\n168:def _mask_to_pat(mask: np.ndarray, color: int, bg: int) -> np.ndarray:\n169:    \"\"\"Paint a boolean mask into a colored patch on a bg-filled array.\"\"\"\n170:    pat = np.full(mask.shape, bg, dtype=int)\n171:    pat[mask] = color\n172:    return pat\n173:\n174:\n175:def _make_component(area: int, color: int, bg: int) -> dict:\n176:    \"\"\"Generate a random 8-connected component with the given area and color.\"\"\"\n177:    dims = _feasible_dims(area)\n178:    irregular_dims = [d for d in dims if d[0] * d[1] > area]\n179:    if irregular_dims and _RNG.random() < IRREGULAR_PROB:\n180:        dims = irregular_dims\n181:    h, w = dims[int(_RNG.integers(0, len(dims)))]\n182:    mask = _make_mask(h, w, area)\n183:    return {\"area\": area, \"color\": color, \"h\": h, \"w\": w,\n184:            \"mask\": mask, \"pat\": _mask_to_pat(mask, color, bg),\n185:            \"shape_key\": canonical_shape_key(mask)}\n186:\n187:\n188:def _random_transform(mask: np.ndarray) -> np.ndarray:\n189:    \"\"\"Apply a random rotation (0-3) and optional horizontal flip to a mask.\"\"\"\n190:    mask = np.rot90(mask, int(_RNG.integers(0, 4)))\n191:    if bool(_RNG.integers(0, 2)):\n192:        mask = np.fliplr(mask)\n193:    return mask\n194:\n195:\n196:def _clone_component(template: dict, color: int, bg: int) -> dict:\n197:    \"\"\"Create a duplicate of template's shape with a new color and random transform.\"\"\"\n198:    mask = _random_transform(template[\"mask\"].copy())\n199:    h, w = mask.shape\n200:    return {\"area\": template[\"area\"], \"color\": color, \"h\": h, \"w\": w,\n201:            \"mask\": mask, \"pat\": _mask_to_pat(mask, color, bg),\n202:            \"shape_key\": canonical_shape_key(mask)}\n203:\n204:\n205:def _assign_columns(widths: list[int], W: int) -> list[int] | None:\n206:    \"\"\"Distribute components horizontally with random spacing (min gap = MIN_COL_GAP).\"\"\"\n207:    n = len(widths)\n208:    total = sum(widths) + MIN_COL_GAP * (n - 1)\n209:    if total > W:\n210:        return None\n211:    slack = W - total\n212:    extras = _RNG.multinomial(slack, np.ones(n + 1) / (n + 1))\n213:    cols = []\n214:    c = int(extras[0])\n215:    for i, w in enumerate(widths):\n216:        cols.append(c)\n217:        c += w\n218:        if i < n - 1:\n219:            c += MIN_COL_GAP + int(extras[i + 1])\n220:    return cols\n","exit_code":0,"status":"completed"}}
