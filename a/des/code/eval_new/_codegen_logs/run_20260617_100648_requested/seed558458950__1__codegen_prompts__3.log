{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"cat > /home/lixinyu/snap/a/des/code/eval_new/seed558458950/1/3.py <<'PY'\nimport numpy as np\nfrom collections import Counter, deque\nfrom itertools import combinations\n\n\ndef _most_common_color(grid: np.ndarray) -> int:\n    colors, counts = np.unique(grid, return_counts=True)\n    return int(colors[np.argmax(counts)])\n\n\ndef _neighbors(r: int, c: int, h: int, w: int):\n    if r > 0:\n        yield r - 1, c\n    if c + 1 < w:\n        yield r, c + 1\n    if r + 1 < h:\n        yield r + 1, c\n    if c > 0:\n        yield r, c - 1\n\n\ndef _extract_legend_colors(grid: np.ndarray, bg: int):\n    h, w = grid.shape\n\n    def scan_vertical(col: int):\n        runs = []\n        r = 0\n        while r < h:\n            if grid[r, col] == bg:\n                r += 1\n                continue\n\n            start = r\n            colors = []\n            while r < h:\n                if grid[r, col] == bg:\n                    break\n\n                left_ok = col == 0 or grid[r, col - 1] == bg\n                right_ok = col == w - 1 or grid[r, col + 1] == bg\n                if not (left_ok and right_ok):\n                    break\n\n                color = int(grid[r, col])\n                if color in colors:\n                    break\n\n                colors.append(color)\n                r += 1\n\n            if colors:\n                runs.append((len(colors), colors, start, r - 1))\n\n            if r == start:\n                r += 1\n\n        return runs\n\n    def scan_horizontal(row: int):\n        runs = []\n        c = 0\n        while c < w:\n            if grid[row, c] == bg:\n                c += 1\n                continue\n\n            start = c\n            colors = []\n            while c < w:\n                if grid[row, c] == bg:\n                    break\n\n                up_ok = row == 0 or grid[row - 1, c] == bg\n                down_ok = row == h - 1 or grid[row + 1, c] == bg\n                if not (up_ok and down_ok):\n                    break\n\n                color = int(grid[row, c])\n                if color in colors:\n                    break\n\n                colors.append(color)\n                c += 1\n\n            if colors:\n                runs.append((len(colors), colors, start, c - 1))\n\n            if c == start:\n                c += 1\n\n        return runs\n\n    candidates = []\n    if w > 0:\n        for c in (0, w - 1):\n            candidates.extend(scan_vertical(c))\n    if h > 0:\n        for r in (0, h - 1):\n            candidates.extend(scan_horizontal(r))\n\n    if not candidates:\n        return []\n\n    candidates.sort(key=lambda t: (-(t[0]), t[2]))\n    return candidates[0][1]\n\n\ndef _detect_marker_color(grid: np.ndarray, bg: int, legend_colors):\n    h, w = grid.shape\n    legend_set = set(int(c) for c in legend_colors)\n    colors, counts = np.unique(grid, return_counts=True)\n    candidates = []\n\n    for color, cnt in zip(colors, counts):\n        if int(color) == bg or int(color) in legend_set:\n            continue\n        if cnt > 8 or cnt == 1:\n            continue\n\n        cells = np.argwhere(grid == color)\n        ok = True\n        for r, c in cells:\n            if not (0 <= r < h and 0 <= c < w):\n                ok = False\n                break\n            deg = 0\n            for nr, nc in _neighbors(int(r), int(c), h, w):\n                if grid[nr, nc] \"'!= bg:\n                    deg += 1\n            if deg != 1:\n                ok = False\n                break\n\n        if ok:\n            candidates.append((cnt, int(color)))\n\n    if candidates:\n        candidates.sort(key=lambda t: (-t[0], t[1]))\n        return candidates[0][1]\n\n    # fallback: choose smallest non-bg color count not in legend\n    fallback = [\n        (int(c), int(v)) for c, v in zip(colors, counts) if int(c) != bg and int(c) not in legend_set\n    ]\n    if not fallback:\n        return None\n    fallback.sort(key=lambda t: (t[1], t[0]))\n    return fallback[0][0]\n\n\ndef _detect_grey_color(grid: np.ndarray, bg: int, marker: int, legend_colors):\n    h, w = grid.shape\n    if marker is None:\n        return None\n\n    excluded = set(int(c) for c in legend_colors) | {bg, marker}\n    colors = [int(c) for c in np.unique(grid)]\n    best = None\n\n    for color in colors:\n        if color in excluded:\n            continue\n\n        cells = np.argwhere(grid == color)\n        if cells.size == 0:\n            continue\n\n        ext = 0\n        self_like = 0\n        for r, c in cells:\n            for nr, nc in _neighbors(int(r), int(c), h, w):\n                ncolor = int(grid[nr, nc])\n                if ncolor == color:\n                    self_like += 1\n                    break\n\n            for nr, nc in _neighbors(int(r), int(c), h, w):\n                ncolor = int(grid[nr, nc])\n                if ncolor != bg and ncolor != color and ncolor not in excluded:\n                    ext += 1\n                    break\n\n        total = len(cells)\n        ext_ratio = ext / total\n        self_ratio = self_like / total\n        score = ext_ratio - 0.8 * self_ratio\n        if best is None or score > best[0]:\n            best = (score, color)\n\n    if best is None:\n        return None\n    if best[0] <= 0.05:\n        return None\n    return best[1]\n\n\ndef _path_index_map(path: list[tuple[int, int]]):\n    return {coord: idx for idx, coord in enumerate(path)}\n\n\ndef _propose_next(\n    grid: np.ndarray,\n    h: int,\n    w: int,\n    state: dict,\n    marker: int,\n    grey: int | None,\n    priority_for_tie,\n):\n    cur = state[\"pos\"]\n    prev = state[\"prev\"]\n    path_color = state[\"path_color\"]\n    cr, cc = cur\n    cur_color = int(grid[cr, cc])\n\n    if cur_color == marker:\n        cands = []\n        for nr, nc in _neighbors(cr, cc, h, w):\n            ncolor = int(grid[nr, nc])\n            if ncolor == bg_local:\n                continue\n            if ncolor == marker or (grey is not None and ncolor == grey):\n                continue\n            if ncolor == path_color:\n                cands.append((nr, nc))\n        if not cands:\n            return None\n        return (cands[0], path_color)\n\n    if grey is not None and cur_color == grey:\n        options = []\n        for nr, nc in _neighbors(cr, cc, h, w):\n            ncolor = int(grid[nr, nc])\n            if (nr, nc) == prev:\n                continue\n            if ncolor == bg_local or ncolor == marker or ncolor == grey:\n                continue\n            if ncolor == path_color:\n                continue\n            options.append(((nr, nc), ncolor))\n\n        if not options:\n            return None\n\n        # if multiple colors share the same intersection, keep deterministic choice\n        # by highest path priority from the legend.\n        options.sort(key=lambda x: (priority_for_tie.get(x[1], 9999), x[0][0], x[0][1]))\n        return options[0]\n\n    # regular movement along the current color segment\n    cands = []\n    for nr, nc in _neighbors(cr, cc, h, w):\n        if int(grid[nr, nc]) == path_color and (nr, nc) != prev:\n            cands.append((nr, nc))\n\n    if not cands:\n        return None\n    return (cands[0], path_color)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Propagate red signals from each red source along its color path and resolve intersections deterministically.\n\n    Input structure:\n    - Background is the most common color.\n    - Single-cell thick colored paths are drawn in various colors, with one red endpoint marker per path and grey intersection pixels where two paths cross.\n    - One border edge column/row stores a color-priority legend from top to bottom.\n\n    Rule:\n    - Start one signal per red marker and repeatedly move one step per tick along its current path.\n    - When a signal enters a grey intersection, it switches to the other path connected there and continues.\n    - If multiple signals attempt the same intersection at the same tick, only the signal whose current path color has higher legend priority passes; losers stop.\n    - Every passed signal pixel is recolored red, while unvisited path pixels keep their original color and unvisited intersections stay grey.\n\n    Key insight:\n    - The challenge is an event-level simulation: topological path tracing and synchronized tie-breaking at shared intersections decide reachability and final recoloring.\n    \"\"\"\n    g = np.array(grid, dtype=np.int64)\n    h, w = g.shape\n    out = np.array(g, dtype=np.int64)\n\n    bg = _most_common_color(g)\n\n    global bg_local\n    bg_local = bg\n\n    legend_colors = _extract_legend_colors(g, bg)\n    legend_order = {c: idx for idx, c in enumerate(legend_colors)}\n\n    marker_color = _detect_marker_color(g, bg, legend_colors)\n    if marker_color is None:\n        return out\n\n    grey_color = _detect_grey_color(g, bg, marker_color, legend_colors)\n\n    marker_cells = list(zip(*np.where(g == marker_color)))\n    states = []\n    for mr, mc in marker_cells:\n        next_color = None\n        for nr, nc in _neighbors(int(mr), int(mc), h, w):\n            ncolor = int(g[nr, nc])\n            if ncolor in (bg, marker_color):\n                continue\n            if grey_color is not None and ncolor == grey_color:\n                continue\n            next_color = ncolor\n            break\n        if next_color is not None:\n            states.append({\"pos\": (int(mr), int(mc)), \"prev\": None, \"path_color\": next_color})\n\n    if not states:\n        return out\n\n    alive = set(range(len(states)))\n    used_intersections = set()\n\n    max_steps = h * w * 2 + 10\n    for _ in range(max_steps):\n        if not alive:\n            break\n\n        proposals = {}\n        for sid in list(alive):\n            state = states[sid]\n            nxt = _propose_next(g, h, w, state, marker_color, grey_color, legend_order)\n            if nxt is None:\n                alive.discard(sid)\n                continue\n            proposals.setdefault(nxt[0], []).append((sid, state[\"path_color\"], nxt[1]))\n\n        if not proposals:\n            break\n\n        for target, lst in proposals.items():\n            tr, tc = target\n            if tr < 0 or tr >= h or tc < 0 or tc >= w:\n                continue\n\n            cur_is_grey = grey_color is not None and g[target] == grey_color\n\n            if cur_is_grey:\n                if target in used_intersections:\n                    for sid, _, _ in lst:\n                        alive.discard(sid)\n                    continue\n\n                if len(lst) == 1:\n                    winner_sid = lst[0][0]\n                else:\n                    lst.sort(key=lambda item: (legend_order.get(item[1], 9999), item[0]))\n                    winner_sid = lst[0][0]\n                    for sid, _, _ in lst[1:]:\n                        alive.discard(sid)\n\n                if winner_sid not in alive:\n                    continue\n\n                state = states[winner_sid]\n                state[\"prev\"] = state[\"pos\"]\n                state[\"pos\"] = target\n                state[\"path_color\"] = lst[[item[0] for item in lst].index(winner_sid)][2]\n                out[target] = marker_color\n                used_intersections.add(target)\n                continue\n\n            # Non-grey target: keep one winner if conflict should ever happen\n            sid, _, nxt_color = lst[0]\n            if len(lst) > 1:\n                lst.sort(key=lambda item: (legend_order.get(item[1], 9999), item[0]))\n                sid = lst[0][0]\n                for loser, _, _ in lst[1:]:\n                    alive.discard(loser)\n\n            if sid not in alive:\n                continue\n\n            state = states[sid]\n            state[\"prev\"] = state[\"pos\"]\n            state[\"pos\"] = target\n            state[\"path_color\"] = nxt_color\n            out[target] = marker_color\n\n    return out\n\n\ndef _random_free_cell(occupied, h, w, rng):\n    cells = [(r, c) for r in range(1, h - 1) for c in range(2, w - 1) if (r, c) not in occupied]\n    if not cells:\n        return None\n    return cells[int(rng.integers(0, len(cells)))]\n\n\ndef _shortest_path(start, goal, blocked, allow, h, w, rng):\n    if start == goal:\n        return [start]\n\n    q = deque([start])\n    prev = {start: None}\n    while q:\n        r, c = q.popleft()\n        for nr, nc in _neighbors(r, c, h, w):\n            nxt = (nr, nc)\n            if nxt in prev:\n                continue\n            if nxt != goal and nxt in blocked and nxt not in allow:\n                continue\n            prev[nxt] = (r, c)\n            if nxt == goal:\n                q.clear()\n                break\n            q.append(nxt)\n\n    if goal not in prev:\n        return None\n\n    path = [goal]\n    cur = goal\n    while prev[cur] is not None:\n        cur = prev[cur]\n        path.append(cur)\n    path.reverse()\n    return path\n\n\ndef _build_route(start, end, waypoints, occupied, h, w, rng):\n    points = [start] + waypoints + [end]\n    route = [start]\n    used = set(route)\n    allow = set(waypoints)\n\n    for a, b in zip(points, points[1:]):\n        seg = _shortest_path(a, b, occupied | used, allow | {b}, h, w, rng)\n        if seg is None:\n            return None\n        for p in seg[1:]:\n            route.append(p)\n            used.add(p)\n\n    if len(set(route)) != len(route):\n        return None\n    return route\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n\n    BG = 0\n    MARKER_COLOR = 2\n    GREY_COLOR = 7\n\n    all_colors = [1, 3, 4, 5, 6, 8, 9]\n\n    for _ in range(200):\n        h = int(rng.integers(18, 30))\n        w = int(rng.integers(18, 30))\n\n        n_paths = int(rng.integers(2, 5))\n        if w < 8 or h < n_paths + 4:\n            continue\n\n        colors = rng.choice(all_colors, size=n_paths, replace=False)\n        path_colors = [int(v) for v in colors]\n        rng.shuffle(path_colors)\n\n        # Legend at left edge, top-to-bottom high-to-low priority.\n        legend = list(path_colors)\n\n        grid = np.full((h, w), BG, dtype=np.int64)\n        for i, color in enumerate(legend):\n            grid[1 + i, 0] = color\n\n        occupied = {(r, 0) for r in range(1, 1 + len(legend))}\n        paths = []\n\n        success = True\n        for pi, color in enumerate(path_colors):\n            built = False\n\n            # force many branches and some direct-through connections by chance\n            intersection_mode = (\n                pi > 0 and rng.random() < (0.85 if pi == 1 else 0.45)\n            )\n\n            for _attempt in range(300):\n                waypoints = []\n                if intersection_mode and paths:\n                    prior = paths[int(rng.integers(0, len(paths)))]\n                    if len(prior[\"coords\"]) > 4:\n                        wp = prior[\"coords\"][int(rng.integers(1, len(prior[\"coords\"]) - 1))]\n                        waypoints = [wp]\n\n                start = _random_free_cell(occupied, h, w, rng)\n                end = _random_free_cell(occupied, h, w, rng)\n                if start is None or end is None or start == end:\n                    continue\n\n                if waypoints:\n                    # reject obvious short / ambiguous routes\n                    if (abs(start[0] - waypoints[0][0]) + abs(start[1] - waypoints[0][1]) < 2)\n                    or (abs(end[0] - waypoints[0][0]) + abs(end[1] - waypoints[0][1]) < 2):\n                        continue\n\n                route = _build_route(start, end, waypoints, occupied, h, w, rng)\n                if route is None:\n                    continue\n\n                # route must not start/end on an intersection cell\n                if waypoints and (start in waypoints or end in waypoints):\n                    continue\n                if len(route) < 8:\n                    continue\n\n                paths.append({\"color\": color, \"coords\": route})\n                occupied.update(route)\n                built = True\n                break\n\n            if not built:\n                # retry with no intersection restriction\n                for _attempt2 in range(200):\n                    start = _random_free_cell(occupied, h, w, rng)\n                    end = _random_free_cell(occupied, h, w, rng)\n                    if start is None or end is None or start == end:\n                        continue\n\n                    route = _build_route(start, end, [], occupied, h, w, rng)\n                    if route is not None and len(route) >= 8:\n                        paths.append({\"color\": color, \"coords\": route})\n                        occupied.update(route)\n                        built = True\n                        break\n\n            if not built:\n                success = False\n                break\n\n        if not success:\n            continue\n\n        # Mark intersections.\n        inter_map = {}\n        for pi, info in enumerate(paths):\n            for pos in info[\"coords\"]:\n                inter_map.setdefault(pos, []).append(pi)\n\n        # optional source direction tuning (left/right end) to create tie variety\n        source_side = [int(rng.integers(0, 2)) for _ in paths]\n\n        shared_positions = [p for p, idxs in inter_map.items() if len(idxs) >= 2]\n\n        if shared_positions and rng.random() < 0.7:\n            rng.shuffle(shared_positions)\n            index_maps = [_path_index_map(info[\"coords\"]) for info in paths]\n            fixed = False\n\n            for pos in shared_positions:\n                ids = inter_map[pos]\n                if fixed:\n                    break\n                for a, b in combinations(ids, 2):\n                    pa = paths[a][\"coords\"]\n                    pb = paths[b][\"coords\"]\n                    ia = index_maps[a][pos]\n                    ib = index_maps[b][pos]\n                    da = [ia, len(pa) - 1 - ia]\n                    db = [ib, len(pb) - 1 - ib]\n\n                    for sa in (0, 1):\n                        for sb in (0, 1):\n                            if da[sa] == db[sb]:\n                                source_side[a] = sa\n                                source_side[b] = sb\n                                fixed = True\n                                break\n                        if fixed:\n                            break\n                    if fixed:\n                        break\n\n            # avoid pathological all-same choices if only forced options were absent\n            if not fixed and rng.random() < 0.4:\n                for i in range(len(paths)):\n                    source_side[i] = int(rng.integers(0, 2))\n\n        # draw path body\n        for info in paths:\n            color = info[\"color\"]\n            for r, c in info[\"coords\"]:\n                grid[r, c] = color\n\n        # intersections become grey\n        for pos, idxs in inter_map.items():\n            if len(idxs) >= 2:\n                grid[pos] = GREY_COLOR\n\n        # red source markers at endpoints\n        for i, info in enumerate(paths):\n            coords = info[\"coords\"]\n            source = coords[0] if source_side[i] == 0 else coords[-1]\n            if (source in inter_map and len(inter_map[source]) >= 2):\n                source = coords[-1] if source_side[i] == 0 else coords[0]\n            grid[source] = MARKER_COLOR\n\n        # ensure no accidental overlap and every source appears once\n        if Counter(grid.flatten())[MARKER_COLOR] != len(paths):\n            continue\n\n        return grid\n\n    # fallback: tiny valid instance\n    out = np.array(\n        [\n            [0, 3, 0, 0, 0, 0, 0, 0],\n            [3, 2, 7, 3, 3, 0, 0, 0],\n            [0, 4, 0, 0, 4, 4, 0, 0],\n            [0, 4, 7, 0, 4, 0, 0, 0],\n            [0, 0, 0, 0, 4, 2, 7, 3],\n            [0, 0, 0, 3, 0, 0, 7, 6],\n            [0, 0, 0, 0, 0, 0, 0, 0],\n        ],\n        dtype=np.int64,\n    )\n    return out\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"cat > /home/lixinyu/snap/a/des/code/eval_new/seed558458950/1/3.py <<'PY'\nimport numpy as np\nfrom collections import Counter, deque\nfrom itertools import combinations\n\n\ndef _most_common_color(grid: np.ndarray) -> int:\n    colors, counts = np.unique(grid, return_counts=True)\n    return int(colors[np.argmax(counts)])\n\n\ndef _neighbors(r: int, c: int, h: int, w: int):\n    if r > 0:\n        yield r - 1, c\n    if c + 1 < w:\n        yield r, c + 1\n    if r + 1 < h:\n        yield r + 1, c\n    if c > 0:\n        yield r, c - 1\n\n\ndef _extract_legend_colors(grid: np.ndarray, bg: int):\n    h, w = grid.shape\n\n    def scan_vertical(col: int):\n        runs = []\n        r = 0\n        while r < h:\n            if grid[r, col] == bg:\n                r += 1\n                continue\n\n            start = r\n            colors = []\n            while r < h:\n                if grid[r, col] == bg:\n                    break\n\n                left_ok = col == 0 or grid[r, col - 1] == bg\n                right_ok = col == w - 1 or grid[r, col + 1] == bg\n                if not (left_ok and right_ok):\n                    break\n\n                color = int(grid[r, col])\n                if color in colors:\n                    break\n\n                colors.append(color)\n                r += 1\n\n            if colors:\n                runs.append((len(colors), colors, start, r - 1))\n\n            if r == start:\n                r += 1\n\n        return runs\n\n    def scan_horizontal(row: int):\n        runs = []\n        c = 0\n        while c < w:\n            if grid[row, c] == bg:\n                c += 1\n                continue\n\n            start = c\n            colors = []\n            while c < w:\n                if grid[row, c] == bg:\n                    break\n\n                up_ok = row == 0 or grid[row - 1, c] == bg\n                down_ok = row == h - 1 or grid[row + 1, c] == bg\n                if not (up_ok and down_ok):\n                    break\n\n                color = int(grid[row, c])\n                if color in colors:\n                    break\n\n                colors.append(color)\n                c += 1\n\n            if colors:\n                runs.append((len(colors), colors, start, c - 1))\n\n            if c == start:\n                c += 1\n\n        return runs\n\n    candidates = []\n    if w > 0:\n        for c in (0, w - 1):\n            candidates.extend(scan_vertical(c))\n    if h > 0:\n        for r in (0, h - 1):\n            candidates.extend(scan_horizontal(r))\n\n    if not candidates:\n        return []\n\n    candidates.sort(key=lambda t: (-(t[0]), t[2]))\n    return candidates[0][1]\n\n\ndef _detect_marker_color(grid: np.ndarray, bg: int, legend_colors):\n    h, w = grid.shape\n    legend_set = set(int(c) for c in legend_colors)\n    colors, counts = np.unique(grid, return_counts=True)\n    candidates = []\n\n    for color, cnt in zip(colors, counts):\n        if int(color) == bg or int(color) in legend_set:\n            continue\n        if cnt > 8 or cnt == 1:\n            continue\n\n        cells = np.argwhere(grid == color)\n        ok = True\n        for r, c in cells:\n            if not (0 <= r < h and 0 <= c < w):\n                ok = False\n                break\n            deg = 0\n            for nr, nc in _neighbors(int(r), int(c), h, w):\n                if grid[nr, nc] \"'!= bg:\n                    deg += 1\n            if deg != 1:\n                ok = False\n                break\n\n        if ok:\n            candidates.append((cnt, int(color)))\n\n    if candidates:\n        candidates.sort(key=lambda t: (-t[0], t[1]))\n        return candidates[0][1]\n\n    # fallback: choose smallest non-bg color count not in legend\n    fallback = [\n        (int(c), int(v)) for c, v in zip(colors, counts) if int(c) != bg and int(c) not in legend_set\n    ]\n    if not fallback:\n        return None\n    fallback.sort(key=lambda t: (t[1], t[0]))\n    return fallback[0][0]\n\n\ndef _detect_grey_color(grid: np.ndarray, bg: int, marker: int, legend_colors):\n    h, w = grid.shape\n    if marker is None:\n        return None\n\n    excluded = set(int(c) for c in legend_colors) | {bg, marker}\n    colors = [int(c) for c in np.unique(grid)]\n    best = None\n\n    for color in colors:\n        if color in excluded:\n            continue\n\n        cells = np.argwhere(grid == color)\n        if cells.size == 0:\n            continue\n\n        ext = 0\n        self_like = 0\n        for r, c in cells:\n            for nr, nc in _neighbors(int(r), int(c), h, w):\n                ncolor = int(grid[nr, nc])\n                if ncolor == color:\n                    self_like += 1\n                    break\n\n            for nr, nc in _neighbors(int(r), int(c), h, w):\n                ncolor = int(grid[nr, nc])\n                if ncolor != bg and ncolor != color and ncolor not in excluded:\n                    ext += 1\n                    break\n\n        total = len(cells)\n        ext_ratio = ext / total\n        self_ratio = self_like / total\n        score = ext_ratio - 0.8 * self_ratio\n        if best is None or score > best[0]:\n            best = (score, color)\n\n    if best is None:\n        return None\n    if best[0] <= 0.05:\n        return None\n    return best[1]\n\n\ndef _path_index_map(path: list[tuple[int, int]]):\n    return {coord: idx for idx, coord in enumerate(path)}\n\n\ndef _propose_next(\n    grid: np.ndarray,\n    h: int,\n    w: int,\n    state: dict,\n    marker: int,\n    grey: int | None,\n    priority_for_tie,\n):\n    cur = state[\"pos\"]\n    prev = state[\"prev\"]\n    path_color = state[\"path_color\"]\n    cr, cc = cur\n    cur_color = int(grid[cr, cc])\n\n    if cur_color == marker:\n        cands = []\n        for nr, nc in _neighbors(cr, cc, h, w):\n            ncolor = int(grid[nr, nc])\n            if ncolor == bg_local:\n                continue\n            if ncolor == marker or (grey is not None and ncolor == grey):\n                continue\n            if ncolor == path_color:\n                cands.append((nr, nc))\n        if not cands:\n            return None\n        return (cands[0], path_color)\n\n    if grey is not None and cur_color == grey:\n        options = []\n        for nr, nc in _neighbors(cr, cc, h, w):\n            ncolor = int(grid[nr, nc])\n            if (nr, nc) == prev:\n                continue\n            if ncolor == bg_local or ncolor == marker or ncolor == grey:\n                continue\n            if ncolor == path_color:\n                continue\n            options.append(((nr, nc), ncolor))\n\n        if not options:\n            return None\n\n        # if multiple colors share the same intersection, keep deterministic choice\n        # by highest path priority from the legend.\n        options.sort(key=lambda x: (priority_for_tie.get(x[1], 9999), x[0][0], x[0][1]))\n        return options[0]\n\n    # regular movement along the current color segment\n    cands = []\n    for nr, nc in _neighbors(cr, cc, h, w):\n        if int(grid[nr, nc]) == path_color and (nr, nc) != prev:\n            cands.append((nr, nc))\n\n    if not cands:\n        return None\n    return (cands[0], path_color)\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Propagate red signals from each red source along its color path and resolve intersections deterministically.\n\n    Input structure:\n    - Background is the most common color.\n    - Single-cell thick colored paths are drawn in various colors, with one red endpoint marker per path and grey intersection pixels where two paths cross.\n    - One border edge column/row stores a color-priority legend from top to bottom.\n\n    Rule:\n    - Start one signal per red marker and repeatedly move one step per tick along its current path.\n    - When a signal enters a grey intersection, it switches to the other path connected there and continues.\n    - If multiple signals attempt the same intersection at the same tick, only the signal whose current path color has higher legend priority passes; losers stop.\n    - Every passed signal pixel is recolored red, while unvisited path pixels keep their original color and unvisited intersections stay grey.\n\n    Key insight:\n    - The challenge is an event-level simulation: topological path tracing and synchronized tie-breaking at shared intersections decide reachability and final recoloring.\n    \"\"\"\n    g = np.array(grid, dtype=np.int64)\n    h, w = g.shape\n    out = np.array(g, dtype=np.int64)\n\n    bg = _most_common_color(g)\n\n    global bg_local\n    bg_local = bg\n\n    legend_colors = _extract_legend_colors(g, bg)\n    legend_order = {c: idx for idx, c in enumerate(legend_colors)}\n\n    marker_color = _detect_marker_color(g, bg, legend_colors)\n    if marker_color is None:\n        return out\n\n    grey_color = _detect_grey_color(g, bg, marker_color, legend_colors)\n\n    marker_cells = list(zip(*np.where(g == marker_color)))\n    states = []\n    for mr, mc in marker_cells:\n        next_color = None\n        for nr, nc in _neighbors(int(mr), int(mc), h, w):\n            ncolor = int(g[nr, nc])\n            if ncolor in (bg, marker_color):\n                continue\n            if grey_color is not None and ncolor == grey_color:\n                continue\n            next_color = ncolor\n            break\n        if next_color is not None:\n            states.append({\"pos\": (int(mr), int(mc)), \"prev\": None, \"path_color\": next_color})\n\n    if not states:\n        return out\n\n    alive = set(range(len(states)))\n    used_intersections = set()\n\n    max_steps = h * w * 2 + 10\n    for _ in range(max_steps):\n        if not alive:\n            break\n\n        proposals = {}\n        for sid in list(alive):\n            state = states[sid]\n            nxt = _propose_next(g, h, w, state, marker_color, grey_color, legend_order)\n            if nxt is None:\n                alive.discard(sid)\n                continue\n            proposals.setdefault(nxt[0], []).append((sid, state[\"path_color\"], nxt[1]))\n\n        if not proposals:\n            break\n\n        for target, lst in proposals.items():\n            tr, tc = target\n            if tr < 0 or tr >= h or tc < 0 or tc >= w:\n                continue\n\n            cur_is_grey = grey_color is not None and g[target] == grey_color\n\n            if cur_is_grey:\n                if target in used_intersections:\n                    for sid, _, _ in lst:\n                        alive.discard(sid)\n                    continue\n\n                if len(lst) == 1:\n                    winner_sid = lst[0][0]\n                else:\n                    lst.sort(key=lambda item: (legend_order.get(item[1], 9999), item[0]))\n                    winner_sid = lst[0][0]\n                    for sid, _, _ in lst[1:]:\n                        alive.discard(sid)\n\n                if winner_sid not in alive:\n                    continue\n\n                state = states[winner_sid]\n                state[\"prev\"] = state[\"pos\"]\n                state[\"pos\"] = target\n                state[\"path_color\"] = lst[[item[0] for item in lst].index(winner_sid)][2]\n                out[target] = marker_color\n                used_intersections.add(target)\n                continue\n\n            # Non-grey target: keep one winner if conflict should ever happen\n            sid, _, nxt_color = lst[0]\n            if len(lst) > 1:\n                lst.sort(key=lambda item: (legend_order.get(item[1], 9999), item[0]))\n                sid = lst[0][0]\n                for loser, _, _ in lst[1:]:\n                    alive.discard(loser)\n\n            if sid not in alive:\n                continue\n\n            state = states[sid]\n            state[\"prev\"] = state[\"pos\"]\n            state[\"pos\"] = target\n            state[\"path_color\"] = nxt_color\n            out[target] = marker_color\n\n    return out\n\n\ndef _random_free_cell(occupied, h, w, rng):\n    cells = [(r, c) for r in range(1, h - 1) for c in range(2, w - 1) if (r, c) not in occupied]\n    if not cells:\n        return None\n    return cells[int(rng.integers(0, len(cells)))]\n\n\ndef _shortest_path(start, goal, blocked, allow, h, w, rng):\n    if start == goal:\n        return [start]\n\n    q = deque([start])\n    prev = {start: None}\n    while q:\n        r, c = q.popleft()\n        for nr, nc in _neighbors(r, c, h, w):\n            nxt = (nr, nc)\n            if nxt in prev:\n                continue\n            if nxt != goal and nxt in blocked and nxt not in allow:\n                continue\n            prev[nxt] = (r, c)\n            if nxt == goal:\n                q.clear()\n                break\n            q.append(nxt)\n\n    if goal not in prev:\n        return None\n\n    path = [goal]\n    cur = goal\n    while prev[cur] is not None:\n        cur = prev[cur]\n        path.append(cur)\n    path.reverse()\n    return path\n\n\ndef _build_route(start, end, waypoints, occupied, h, w, rng):\n    points = [start] + waypoints + [end]\n    route = [start]\n    used = set(route)\n    allow = set(waypoints)\n\n    for a, b in zip(points, points[1:]):\n        seg = _shortest_path(a, b, occupied | used, allow | {b}, h, w, rng)\n        if seg is None:\n            return None\n        for p in seg[1:]:\n            route.append(p)\n            used.add(p)\n\n    if len(set(route)) != len(route):\n        return None\n    return route\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n\n    BG = 0\n    MARKER_COLOR = 2\n    GREY_COLOR = 7\n\n    all_colors = [1, 3, 4, 5, 6, 8, 9]\n\n    for _ in range(200):\n        h = int(rng.integers(18, 30))\n        w = int(rng.integers(18, 30))\n\n        n_paths = int(rng.integers(2, 5))\n        if w < 8 or h < n_paths + 4:\n            continue\n\n        colors = rng.choice(all_colors, size=n_paths, replace=False)\n        path_colors = [int(v) for v in colors]\n        rng.shuffle(path_colors)\n\n        # Legend at left edge, top-to-bottom high-to-low priority.\n        legend = list(path_colors)\n\n        grid = np.full((h, w), BG, dtype=np.int64)\n        for i, color in enumerate(legend):\n            grid[1 + i, 0] = color\n\n        occupied = {(r, 0) for r in range(1, 1 + len(legend))}\n        paths = []\n\n        success = True\n        for pi, color in enumerate(path_colors):\n            built = False\n\n            # force many branches and some direct-through connections by chance\n            intersection_mode = (\n                pi > 0 and rng.random() < (0.85 if pi == 1 else 0.45)\n            )\n\n            for _attempt in range(300):\n                waypoints = []\n                if intersection_mode and paths:\n                    prior = paths[int(rng.integers(0, len(paths)))]\n                    if len(prior[\"coords\"]) > 4:\n                        wp = prior[\"coords\"][int(rng.integers(1, len(prior[\"coords\"]) - 1))]\n                        waypoints = [wp]\n\n                start = _random_free_cell(occupied, h, w, rng)\n                end = _random_free_cell(occupied, h, w, rng)\n                if start is None or end is None or start == end:\n                    continue\n\n                if waypoints:\n                    # reject obvious short / ambiguous routes\n                    if (abs(start[0] - waypoints[0][0]) + abs(start[1] - waypoints[0][1]) < 2)\n                    or (abs(end[0] - waypoints[0][0]) + abs(end[1] - waypoints[0][1]) < 2):\n                        continue\n\n                route = _build_route(start, end, waypoints, occupied, h, w, rng)\n                if route is None:\n                    continue\n\n                # route must not start/end on an intersection cell\n                if waypoints and (start in waypoints or end in waypoints):\n                    continue\n                if len(route) < 8:\n                    continue\n\n                paths.append({\"color\": color, \"coords\": route})\n                occupied.update(route)\n                built = True\n                break\n\n            if not built:\n                # retry with no intersection restriction\n                for _attempt2 in range(200):\n                    start = _random_free_cell(occupied, h, w, rng)\n                    end = _random_free_cell(occupied, h, w, rng)\n                    if start is None or end is None or start == end:\n                        continue\n\n                    route = _build_route(start, end, [], occupied, h, w, rng)\n                    if route is not None and len(route) >= 8:\n                        paths.append({\"color\": color, \"coords\": route})\n                        occupied.update(route)\n                        built = True\n                        break\n\n            if not built:\n                success = False\n                break\n\n        if not success:\n            continue\n\n        # Mark intersections.\n        inter_map = {}\n        for pi, info in enumerate(paths):\n            for pos in info[\"coords\"]:\n                inter_map.setdefault(pos, []).append(pi)\n\n        # optional source direction tuning (left/right end) to create tie variety\n        source_side = [int(rng.integers(0, 2)) for _ in paths]\n\n        shared_positions = [p for p, idxs in inter_map.items() if len(idxs) >= 2]\n\n        if shared_positions and rng.random() < 0.7:\n            rng.shuffle(shared_positions)\n            index_maps = [_path_index_map(info[\"coords\"]) for info in paths]\n            fixed = False\n\n            for pos in shared_positions:\n                ids = inter_map[pos]\n                if fixed:\n                    break\n                for a, b in combinations(ids, 2):\n                    pa = paths[a][\"coords\"]\n                    pb = paths[b][\"coords\"]\n                    ia = index_maps[a][pos]\n                    ib = index_maps[b][pos]\n                    da = [ia, len(pa) - 1 - ia]\n                    db = [ib, len(pb) - 1 - ib]\n\n                    for sa in (0, 1):\n                        for sb in (0, 1):\n                            if da[sa] == db[sb]:\n                                source_side[a] = sa\n                                source_side[b] = sb\n                                fixed = True\n                                break\n                        if fixed:\n                            break\n                    if fixed:\n                        break\n\n            # avoid pathological all-same choices if only forced options were absent\n            if not fixed and rng.random() < 0.4:\n                for i in range(len(paths)):\n                    source_side[i] = int(rng.integers(0, 2))\n\n        # draw path body\n        for info in paths:\n            color = info[\"color\"]\n            for r, c in info[\"coords\"]:\n                grid[r, c] = color\n\n        # intersections become grey\n        for pos, idxs in inter_map.items():\n            if len(idxs) >= 2:\n                grid[pos] = GREY_COLOR\n\n        # red source markers at endpoints\n        for i, info in enumerate(paths):\n            coords = info[\"coords\"]\n            source = coords[0] if source_side[i] == 0 else coords[-1]\n            if (source in inter_map and len(inter_map[source]) >= 2):\n                source = coords[-1] if source_side[i] == 0 else coords[0]\n            grid[source] = MARKER_COLOR\n\n        # ensure no accidental overlap and every source appears once\n        if Counter(grid.flatten())[MARKER_COLOR] != len(paths):\n            continue\n\n        return grid\n\n    # fallback: tiny valid instance\n    out = np.array(\n        [\n            [0, 3, 0, 0, 0, 0, 0, 0],\n            [3, 2, 7, 3, 3, 0, 0, 0],\n            [0, 4, 0, 0, 4, 4, 0, 0],\n            [0, 4, 7, 0, 4, 0, 0, 0],\n            [0, 0, 0, 0, 4, 2, 7, 3],\n            [0, 0, 0, 3, 0, 0, 7, 6],\n            [0, 0, 0, 0, 0, 0, 0, 0],\n        ],\n        dtype=np.int64,\n    )\n    return out\nPY'","aggregated_output":"","exit_code":0,"status":"completed"}}
