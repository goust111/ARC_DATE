f r == start:\n    55\t                r += 1\n    56\t\n    57\t        return runs\n    58\t\n    59\t    def scan_horizontal(row: int):\n    60\t        runs = []\n    61\t        c = 0\n    62\t        while c < w:\n    63\t            if grid[row, c] == bg:\n    64\t                c += 1\n    65\t                continue\n    66\t\n    67\t            start = c\n    68\t            colors = []\n    69\t            while c < w:\n    70\t                if grid[row, c] == bg:\n    71\t                    break\n    72\t\n    73\t                up_ok = row == 0 or grid[row - 1, c] == bg\n    74\t                down_ok = row == h - 1 or grid[row + 1, c] == bg\n    75\t                if not (up_ok and down_ok):\n    76\t                    break\n    77\t\n    78\t                color = int(grid[row, c])\n    79\t                if color in colors:\n    80\t                    break\n    81\t\n    82\t                colors.append(color)\n    83\t                c += 1\n    84\t\n    85\t            if colors:\n    86\t                runs.append((len(colors), colors, start, c - 1))\n    87\t\n    88\t            if c == start:\n    89\t                c += 1\n    90\t\n    91\t        return runs\n    92\t\n    93\t    candidates = []\n    94\t    if w > 0:\n    95\t        for c in (0, w - 1):\n    96\t            candidates.extend(scan_vertical(c))\n    97\t    if h > 0:\n    98\t        for r in (0, h - 1):\n    99\t            candidates.extend(scan_horizontal(r))\n   100\t\n   101\t    if not candidates:\n   102\t        return []\n   103\t\n   104\t    candidates.sort(key=lambda t: (-(t[0]), t[2]))\n   105\t    return candidates[0][1]\n   106\t\n   107\t\n   108\tdef _detect_marker_color(grid: np.ndarray, bg: int, legend_colors):\n   109\t    h, w = grid.shape\n   110\t    legend_set = set(int(c) for c in legend_colors)\n   111\t    colors, counts = np.unique(grid, return_counts=True)\n   112\t    candidates = []\n   113\t\n   114\t    for color, cnt in zip(colors, counts):\n   115\t        if int(color) == bg or int(color) in legend_set:\n   116\t            continue\n   117\t        if cnt > 8 or cnt == 1:\n   118\t            continue\n   119\t\n   120\t        cells = np.argwhere(grid == color)\n   121\t        ok = True\n   122\t        for r, c in cells:\n   123\t            if not (0 <= r < h and 0 <= c < w):\n   124\t                ok = False\n   125\t                break\n   126\t            deg = 0\n   127\t            for nr, nc in _neighbors(int(r), int(c), h, w):\n   128\t                if grid[nr, nc] != bg:\n   129\t                    deg += 1\n   130\t            if deg != 1:\n   131\t                ok = False\n   132\t                break\n   133\t\n   134\t        if ok:\n   135\t            candidates.append((cnt, int(color)))\n   136\t\n   137\t    if candidates:\n   138\t        candidates.sort(key=lambda t: (-t[0], t[1]))\n   139\t        return candidates[0][1]\n   140\t\n   141\t    # fallback: choose smallest non-bg color count not in legend\n   142\t    fallback = [\n   143\t        (int(c), int(v)) for c, v in zip(colors, counts) if int(c) != bg and int(c) not in legend_set\n   144\t    ]\n   145\t    if not fallback:\n   146\t        return None\n   147\t    fallback.sort(key=lambda t: (t[1], t[0]))\n   148\t    return fallback[0][0]\n   149\t\n   150\t\n   151\tdef _detect_grey_color(grid: np.ndarray, bg: int, marker: int, legend_colors):\n   152\t    h, w = grid.shape\n   153\t    if marker is None:\n   154\t        return None\n   155\t\n   156\t    excluded = set(int(c) for c in legend_colors) | {bg, marker}\n   157\t    colors = [int(c) for c in np.unique(grid)]\n   158\t    best = None\n   159\t\n   160\t    for color in colors:\n   161\t        if color in excluded:\n   162\t            continue\n   163\t\n   164\t        cells = np.argwhere(grid == color)\n   165\t        if cells.size == 0:\n   166\t            continue\n   167\t\n   168\t        ext = 0\n   169\t        self_like = 0\n   170\t        for r, c in cells:\n   171\t            for nr, nc in _neighbors(int(r), int(c), h, w):\n   172\t                ncolor = int(grid[nr, nc])\n   173\t                if ncolor == color:\n   174\t                    self_like += 1\n   175\t                    break\n   176\t\n   177\t            for nr, nc in _neighbors(int(r), int(c), h, w):\n   178\t                ncolor = int(grid[nr, nc])\n   179\t                if ncolor != bg and ncolor != color and ncolor not in excluded:\n   180\t                    ext += 1\n   181\t                    break\n   182\t\n   183\t        total = len(cells)\n   184\t        ext_ratio = ext / total\n   185\t        self_ratio = self_like / total\n   186\t        score = ext_ratio - 0.8 * self_ratio\n   187\t        if best is None or score > best[0]:\n   188\t            best = (score, color)\n   189\t\n   190\t    if best is None:\n   191\t        return None\n   192\t    if best[0] <= 0.05:\n   193\t        return None\n   194\t    return best[1]\n   195\t\n   196\t\n   197\tdef _path_index_map(path: list[tuple[int, int]]):\n   198\t    return {coord: idx for idx, coord in enumerate(path)}\n   199\t\n   200\t\n   201\tdef _propose_next(\n   202\t    grid: np.ndarray,\n   203\t    h: int,\n   204\t    w: int,\n   205\t    state: dict,\n   206\t    marker: int,\n   207\t    grey: int | None,\n   208\t    priority_for_tie,\n   209\t):\n   210\t    cur = state[\"pos\"]\n   211\t    prev = state[\"prev\"]\n   212\t    path_color = state[\"path_color\"]\n   213\t    cr, cc = cur\n   214\t    cur_color = int(grid[cr, cc])\n   215\t\n   216\t    if cur_color == marker:\n   217\t        cands = []\n   218\t        for nr, nc in _neighbors(cr, cc, h, w):\n   219\t            ncolor = int(grid[nr, nc])\n   220\t            if ncolor == bg_local:\n   221\t                continue\n   222\t            if ncolor == marker or (grey is not None and ncolor == grey):\n   223\t                continue\n   224\t            if ncolor == path_color:\n   225\t                cands.append((nr, nc))\n   226\t        if not cands:\n   227\t            return None\n   228\t        return (cands[0], path_color)\n   229\t\n   230\t    if grey is not None and cur_color == grey:\n   231\t        options = []\n   232\t        for nr, nc in _neighbors(cr, cc, h, w):\n   233\t            ncolor = int(grid[nr, nc])\n   234\t            if (nr, nc) == prev:\n   235\t                continue\n   236\t            if ncolor == bg_local or ncolor == marker or ncolor == grey:\n   237\t                continue\n   238\t            if ncolor == path_color:\n   239\t                continue\n   240\t            options.append(((nr, nc), ncolor))\n   241\t\n   242\t        if not options:\n   243\t            return None\n   244\t\n   245\t        # if multiple colors share the same intersection, keep deterministic choice\n   246\t        # by highest path priority from the legend.\n   247\t        options.sort(key=lambda x: (priority_for_tie.get(x[1], 9999), x[0][0], x[0][1]))\n   248\t        return options[0]\n   249\t\n   250\t    # regular movement along the current color segment\n   251\t    cands = []\n   252\t    for nr, nc in _neighbors(cr, cc, h, w):\n   253\t        if int(grid[nr, nc]) == path_color and (nr, nc) != prev:\n   254\t            cands.append((nr, nc))\n   255\t\n   256\t    if not cands:\n   257\t        return None\n   258\t    return (cands[0], path_color)\n   259\t\n   260\t\n","exit_code":0,"status":"completed"}}
