{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"mkdir -p /home/lixinyu/snap/a/des/code/eval_new/seed1572225882/3 && cat > /home/lixinyu/snap/a/des/code/eval_new/seed1572225882/3/2.py <<'PY'\nimport numpy as np\nfrom collections import Counter, deque\nfrom typing import Dict, List, Optional, Sequence, Set, Tuple\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \\\"\\\"\\\"Pair complementary fragments into full rectangles and sort them by original gap.\n\n    Input structure:\n    - The background color is black (0).\n    - Non-black pixels form several monochrome 4-connected components, all with distinct colors.\n    - For each valid pair of components, translating them without rotation or flip makes a complete filled axis-aligned rectangle.\n\n    Rule:\n    - Extract all non-black components and find every pair that can be translated so their masks tile one solid rectangle.\n    - Keep each component's original color when placing it into that rectangle.\n    - For each found pair, compute the horizontal distance between component bbox centers from the input and sort pairs by that distance ascending.\n    - Output the translated rectangles from left to right with one background column between consecutive rectangles.\n\n    Key insight:\n    - Pairing is recovered from geometric complementarity (shape + rectangle completion), while the output order is independently encoded by the original bbox-center distance signal.\n    \\\"\\\"\\\"\n\n    comps = _extract_components(grid)\n    if len(comps) < 2:\n        return np.array(grid, copy=True)\n\n    pair_candidates = _find_all_pair_candidates(comps)\n    if not pair_candidates:\n        return np.array(grid, copy=True)\n\n    paired = _select_pairs(pair_candidates, len(comps))\n    if not paired:\n        return np.array(grid, copy=True)\n\n    heights = [p[\\\"h\\\"] for p in paired]\n    widths = [p[\\\"w\\\"] for p in paired]\n\n    # Keep a consistent size; inputs generated for this task should already satisfy this.\n    common_h = Counter(heights).most_common(1)[0][0]\n    common_w = Counter(widths).most_common(1)[0][0]\n    paired = [p for p in paired if p[\\\"h\\\"] == common_h and p[\\\"w\\\"] == common_w]\n    if not paired:\n        return np.array(grid, copy=True)\n\n    paired.sort(key=lambda p: (p[\\\"distance2\\\"], p[\\\"i\\\"], p[\\\"j\\\"]))\n    h = common_h\n    w = common_w\n\n    out_width = len(paired) * w + max(0, len(paired) - 1)\n    out = np.zeros((h, out_width), dtype=grid.dtype)\n\n    col0 = 0\n    for p in paired:\n        for r, c in p[\\\"coords_a\\\"]:\n            out[r, col0 + c] = comps[p[\\\"i\\\"]][\\\"color\\\"]\n        for r, c in p[\\\"coords_b\\\"]:\n            out[r, col0 + c] = comps[p[\\\"j\\\"]][\\\"color\\\"]\n        col0 += w + 1\n\n    return out\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n\n    def build_once() -> Optional[np.ndarray]:\n        num_pairs = int(rng.integers(2, 5))\n        # Keep rectangle width bounded so final output always fits <= 30.\n        max_rect_w = (30 - (num_pairs - 1)) // num_pairs\n        if max_rect_w < 3:\n            return None\n\n        rect_h = int(rng.integers(3, 8 + 1))\n        rect_w = int(rng.integers(3, min(10, max_rect_w) + 1))\n\n        # Input canvas also must be <= 30 in each dimension.\n        H = int(rng.integers(max(rect_h + 6, 15), 31))\n        W = int(rng.integers(max(rect_w + 6, 18), 31))\n\n        grid = np.zeros((H, W), dtype=np.int64)\n        used = np.zeros((H, W), dtype=bool)\n\n        colors = list(range(1, 17))\n        rng.shuffle(colors)\n        used_distances: Set[int] = set()\n\n        palette_i = 0\n\n        for _ in range(num_pairs):\n            if palette_i + 1 >= len(colors):\n                return None\n\n            shape_a, shape_b = _make_shape_pair(rect_h, rect_w, rng)\n            if shape_a is None or shape_b is None:\n                return None\n\n            def put_shape(shape: Set[Tuple[int, int]], top: int, left: int) -> List[Tuple[int, int]]:\n                return [(r + top, c + left) for r, c in shape]\n\n            h_a, w_a = _bbox_shape_size(shape_a)\n            h_b, w_b = _bbox_shape_size(shape_b)\n            top_a_max = H - h_a\n            left_a_max = W - w_a\n            top_b_max = H - h_b\n            left_b_max = W - w_b\n            if top_a_max < 0 or left_a_max < 0 or top_b_max < 0 or left_b_max < 0:\n                return None\n\n            placed = False\n            attempts = 1200\n            color_a = colors[palette_i]\n            color_b = colors[palette_i + 1]\n            palette_i += 2\n\n            for _ in range(attempts):\n                top_a = int(rng.integers(top_a_max + 1))\n                left_a = int(rng.integers(left_a_max + 1))\n                top_b = int(rng.integers(top_b_max + 1))\n                left_b = int(rng.integers(left_b_max + 1))\n\n                if not _can_place(shape_a, used, top_a, left_a):\n                    continue\n                if not _can_place(shape_b, used, top_b, left_b):\n                    continue\n\n                min_ca, max_ca = _bbox_col2(shape_a, left_a)\n                min_cb, max_cb = _bbox_col2(shape_b, left_b)\n                dist2 = abs((min_ca + max_ca) - (min_cb + max_cb))\n                if dist2 in used_distances:\n                    continue\n\n                pa = put_shape(shape_a, top_a, left_a)\n                pb = put_shape(shape_b, top_b, left_b)\n\n                for r, c in pa:\n                    used[r, c] = True\n                    grid[r, c] = color_a\n                for r, c in pb:\n                    used[r, c] = True\n                    grid[r, c] = color_b\n\n                used_distances.add(dist2)\n                placed = True\n                break\n\n            if not placed:\n                return None\n\n        if palette_i \"'!= len(used_distances):\n            # Ensure at least one more useful condition besides placement success.\n            pass\n\n        return grid\n\n    # Retry until a valid sample is found.\n    for _ in range(200):\n        grid = build_once()\n        if grid is None:\n            continue\n        if max(grid.shape) > 30:\n            continue\n        comps = _extract_components(grid)\n        if len(comps) % 2 != 0:\n            continue\n        pair_candidates = _find_all_pair_candidates(comps)\n        if not pair_candidates:\n            continue\n        picked = _select_pairs(pair_candidates, len(comps))\n        if len(picked) * 2 != len(comps):\n            continue\n        # Keep distance signatures distinct in generated data.\n        dists = [p[\"distance2\"] for p in picked]\n        if len(dists) != len(set(dists)):\n            continue\n        out = main(grid)\n        if out.shape[0] <= 30 and out.shape[1] <= 30:\n            return grid\n\n    # Fallback deterministic sample.\n    return _fallback_input()\n\n\ndef _fallback_input() -> np.ndarray:\n    H, W = 20, 22\n    grid = np.zeros((H, W), dtype=np.int64)\n    rng = np.random.default_rng(0)\n    rect_h = 4\n    rect_w = 6\n\n    def to_coords(mask: Set[Tuple[int, int]], top: int, left: int, color: int):\n        for r, c in mask:\n            grid[r + top, c + left] = color\n\n    def split_pair():\n        a = set()\n        b = set()\n        k = rect_w // 2\n        for r in range(rect_h):\n            for c in range(rect_w):\n                if c < k:\n                    a.add((r, c))\n                else:\n                    b.add((r, c))\n        return a, b\n\n    a1, b1 = split_pair()\n    a2, b2 = _make_border_pair(rect_h, rect_w)\n    for r, c in a1:\n        grid[r + 2, c + 1] = 1\n        grid[r + 7, c + 14] = 3\n    for r, c in b1:\n        grid[r + 2, c + 12] = 2\n        grid[r + 7, c + 1] = 4\n    for r, c in a2:\n        grid[r + 12, c + 3] = 5\n    for r, c in b2:\n        grid[r + 12, c + 12] = 6\n    return grid\n\n\ndef _extract_components(grid: np.ndarray) -> List[Dict]:\n    H, W = grid.shape\n    seen = np.zeros((H, W), dtype=bool)\n    comps: List[Dict] = []\n    for r0 in range(H):\n        for c0 in range(W):\n            color = int(grid[r0, c0])\n            if color == 0 or seen[r0, c0]:\n                continue\n\n            q = deque([(r0, c0)])\n            seen[r0, c0] = True\n            pixels: List[Tuple[int, int]] = []\n            min_r = max_r = r0\n            min_c = max_c = c0\n\n            while q:\n                r, c = q.popleft()\n                pixels.append((r, c))\n                if r < min_r:\n                    min_r = r\n                if r > max_r:\n                    max_r = r\n                if c < min_c:\n                    min_c = c\n                if c > max_c:\n                    max_c = c\n\n                if r > 0 and not seen[r - 1, c] and int(grid[r - 1, c]) == color:\n                    seen[r - 1, c] = True\n                    q.append((r - 1, c))\n                if r + 1 < H and not seen[r + 1, c] and int(grid[r + 1, c]) == color:\n                    seen[r + 1, c] = True\n                    q.append((r + 1, c))\n                if c > 0 and not seen[r, c - 1] and int(grid[r, c - 1]) == color:\n                    seen[r, c - 1] = True\n                    q.append((r, c - 1))\n                if c + 1 < W and not seen[r, c + 1] and int(grid[r, c + 1]) == color:\n                    seen[r, c + 1] = True\n                    q.append((r, c + 1))\n\n            comp_set = set(pixels)\n            comps.append(\n                {\n                    \"color\": color,\n                    \"pixels\": pixels,\n                    \"set\": comp_set,\n                    \"r0\": min_r,\n                    \"r1\": max_r,\n                    \"c0\": min_c,\n                    \"c1\": max_c,\n                    \"h\": max_r - min_r + 1,\n                    \"w\": max_c - min_c + 1,\n                    \"center2c\": min_c + max_c,\n                }\n            )\n\n    return comps\n\n\ndef _find_all_pair_candidates(comps: List[Dict]) -> List[Dict]:\n    n = len(comps)\n    candidates: List[Dict] = []\n    for i in range(n):\n        for j in range(i + 1, n):\n            rel = _find_tile_relation(comps[i], comps[j])\n            if rel is None:\n                continue\n            rel = dict(rel)\n            rel[\"i\"] = i\n            rel[\"j\"] = j\n            rel[\"distance2\"] = abs(comps[i][\"center2c\"] - comps[j][\"center2c\"])\n            candidates.append(rel)\n    return candidates\n\n\ndef _find_tile_relation(comp_a: Dict, comp_b: Dict) -> Optional[Dict]:\n    a_set = comp_a[\"set\"]\n    b_set = comp_b[\"set\"]\n\n    if comp_a[\"h\"] == comp_a[\"w\"] == 1 and comp_b[\"h\"] == comp_b[\"w\"] == 1:\n        return None\n\n    min_ra, min_ca, max_ra, max_ca = comp_a[\"r0\"], comp_a[\"c0\"], comp_a[\"r1\"], comp_a[\"c1\"]\n    min_rb, min_cb, max_rb, max_cb = comp_b[\"r0\"], comp_b[\"c0\"], comp_b[\"r1\"], comp_b[\"c1\"]\n\n    len_a = len(a_set)\n    len_b = len(b_set)\n\n    best: Optional[Dict] = None\n    for dr in range(-comp_b[\"h\"], comp_a[\"h\"] + 1):\n        shifted_b_min_r = min_rb + dr\n        shifted_b_max_r = max_rb + dr\n        min_r = min(min_ra, shifted_b_min_r)\n        max_r = max(max_ra, shifted_b_max_r)\n\n        for dc in range(-comp_b[\"w\"], comp_a[\"w\"] + 1):\n            shifted_b_min_c = min_cb + dc\n            shifted_b_max_c = max_cb + dc\n            min_c = min(min_ca, shifted_b_min_c)\n            max_c = max(max_ca, shifted_b_max_c)\n\n            h = max_r - min_r + 1\n            w = max_c - min_c + 1\n\n            if h * w != len_a + len_b:\n                continue\n\n            # Ensure no overlap and exact rectangle fill.\n            valid = True\n            for r_b, c_b in comp_b[\"pixels\"]:\n                rr = r_b + dr\n                cc = c_b + dc\n                if (rr, cc) in a_set:\n                    valid = False\n                    break\n            if not valid:\n                continue\n\n            # Additional quick test (implicit in area check): union of two disjoint sets\n            # must cover the whole bbox.\n            candidate = {\n                \"h\": h,\n                \"w\": w,\n                \"coords_a\": [(r - min_r, c - min_c) for (r, c) in comp_a[\"pixels\"]],\n                \"coords_b\": [(r + dr - min_r, c + dc - min_c) for (r, c) in comp_b[\"pixels\"]],\n            }\n\n            if best is None:\n                best = candidate\n            else:\n                key = (candidate[\"h\"], candidate[\"w\"], min_r, min_c, dr, dc)\n                best_key = (best[\"h\"], best[\"w\"], min_r, min_c, dr, dc)\n                if key < best_key:\n                    best = candidate\n\n    return best\n\n\ndef _select_pairs(candidates: List[Dict], n: int) -> List[Dict]:\n    by_i = [[] for _ in range(n)]\n    for c in candidates:\n        by_i[c[\"i\"]].append(c)\n\n    for bucket in by_i:\n        bucket.sort(key=lambda d: (d[\"h\"], d[\"w\"], d[\"distance2\"], d[\"i\"], d[\"j\"]))\n\n    best: List[Dict] = []\n    used = [False] * n\n\n    def signature(pairs: Sequence[Dict]) -> Tuple:\n        return tuple((p[\"distance2\"], p[\"i\"], p[\"j\"]) for p in sorted(pairs, key=lambda x: (x[\"distance2\"], x[\"i\"], x[\"j\"])) )\n\n    def backtrack(current: List[Dict]) -> None:\n        nonlocal best\n\n        remaining = sum(1 for u in used if not u)\n        upper_bound = len(current) + remaining // 2\n        if upper_bound <= len(best):\n            return\n\n        try:\n            i = next(idx for idx, u in enumerate(used) if not u)\n        except StopIteration:\n            if len(current) > len(best) or (len(current) == len(best) and signature(current) < signature(best)):\n                best = list(current)\n            return\n\n        used[i] = True\n\n        # Option to leave this component unmatched.\n        backtrack(current)\n\n        for c in by_i[i]:\n            j = c[\"j\"]\n            if used[j]:\n                continue\n            used[j] = True\n            current.append(c)\n            backtrack(current)\n            current.pop()\n            used[j] = False\n\n        used[i] = False\n\n    backtrack([])\n    return best\n\n\ndef _make_shape_pair(rect_h: int, rect_w: int, rng: np.random.Generator) -> Optional[Tuple[Set[Tuple[int, int]], Set[Tuple[int, int]]]]:\n    methods = [\n        _make_random_connected_pair,\n        _make_split_pair,\n        _make_border_pair,\n    ]\n\n    for _ in range(40):\n        method = int(rng.integers(0, len(methods)))\n        a, b = methods[method](rect_h, rect_w, rng)\n        if a is None or b is None:\n            continue\n        if not a or not b:\n            continue\n        a = set(a)\n        b = set(b)\n        # Keep a and b connected and complementary by construction.\n        if _shape_is_connected(a, rect_h, rect_w) and _shape_is_connected(b, rect_h, rect_w):\n            a, b = _random_flip_pair(a, b, rect_h, rect_w, rng)\n            return a, b\n\n    return None\n\n\ndef _make_split_pair(rect_h: int, rect_w: int, rng: np.random.Generator):\n    if rect_w >= 2 and (rect_h < 2 or rng.random() < 0.5):\n        cut = int(rng.integers(1, rect_w))\n        a = set()\n        b = set()\n        for r in range(rect_h):\n            for c in range(rect_w):\n                (a if c < cut else b).add((r, c))\n    elif rect_h >= 2:\n        cut = int(rng.integers(1, rect_h))\n        a = set()\n        b = set()\n        for r in range(rect_h):\n            for c in range(rect_w):\n                (a if r < cut else b).add((r, c))\n    else:\n        return None, None\n\n    return a, b\n\n\ndef _make_border_pair(rect_h: int, rect_w: int, rng: np.random.Generator = None):\n    del rng\n    if rect_h < 3 or rect_w < 3:\n        return None, None\n    a = set()\n    b = set()\n    for r in range(rect_h):\n        for c in range(rect_w):\n            if r == 0 or c == 0 or r == rect_h - 1 or c == rect_w - 1:\n                a.add((r, c))\n            else:\n                b.add((r, c))\n    return a, b\n\n\ndef _make_random_connected_pair(rect_h: int, rect_w: int, rng: np.random.Generator):\n    total = rect_h * rect_w\n    if total < 2:\n        return None, None\n\n    min_area = max(1, total // 4)\n    max_area = max(1, (3 * total) // 4)\n\n    all_cells = [(r, c) for r in range(rect_h) for c in range(rect_w)]\n\n    for _ in range(80):\n        target_area = int(rng.integers(min_area, max_area + 1))\n        start = all_cells[int(rng.integers(len(all_cells)))]\n        shape_a = {start}\n        frontier = {start}\n\n        for _ in range(1, target_area):\n            candidates = set()\n            for r0, c0 in list(frontier):\n                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    r = r0 + dr\n                    c = c0 + dc\n                    if 0 <= r < rect_h and 0 <= c < rect_w and (r, c) not in shape_a:\n                        candidates.add((r, c))\n            if not candidates:\n                shape_a = None\n                break\n            next_cell = tuple(candidates.pop() if len(candidates) == 1 else candidates.pop())\n            shape_a.add(next_cell)\n            frontier.add(next_cell)\n\n        if shape_a is None:\n            continue\n\n        shape_b = {(r, c) for r in range(rect_h) for c in range(rect_w) if (r, c) not in shape_a}\n        if not shape_a or not shape_b:\n            continue\n        if _shape_is_connected(shape_b, rect_h, rect_w):\n            return shape_a, shape_b\n\n    return None, None\n\n\ndef _random_flip_pair(a: Set[Tuple[int, int]], b: Set[Tuple[int, int]], h: int, w: int, rng: np.random.Generator) -> Tuple[Set[Tuple[int, int]], Set[Tuple[int, int]]]:\n    if rng.random() < 0.5:\n        a = {(r, w - 1 - c) for r, c in a}\n        b = {(r, w - 1 - c) for r, c in b}\n    if rng.random() < 0.5:\n        a = {(h - 1 - r, c) for r, c in a}\n        b = {(h - 1 - r, c) for r, c in b}\n    return a, b\n\n\ndef _shape_is_connected(shape: Set[Tuple[int, int]], h: int, w: int) -> bool:\n    if not shape:\n        return False\n    q = deque([next(iter(shape))])\n    seen = {q[0]}\n    area = 1\n    while q:\n        r, c = q.popleft()\n        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n            rr = r + dr\n            cc = c + dc\n            if 0 <= rr < h and 0 <= cc < w and (rr, cc) in shape and (rr, cc) not in seen:\n                seen.add((rr, cc))\n                q.append((rr, cc))\n                area += 1\n    return area == len(shape)\n\n\ndef _can_place(shape: Set[Tuple[int, int]], used: np.ndarray, top: int, left: int) -> bool:\n    H, W = used.shape\n    for r, c in shape:\n        rr = r + top\n        cc = c + left\n        if rr < 0 or rr >= H or cc < 0 or cc >= W:\n            return False\n        if used[rr, cc]:\n            return False\n    # Add 1-cell spacing to avoid accidental merge by 4-connectivity.\n    for r, c in shape:\n        rr = r + top\n        cc = c + left\n        if rr > 0 and used[rr - 1, cc]:\n            return False\n        if rr + 1 < H and used[rr + 1, cc]:\n            return False\n        if cc > 0 and used[rr, cc - 1]:\n            return False\n        if cc + 1 < W and used[rr, cc + 1]:\n            return False\n    return True\n\n\ndef _bbox_shape_size(shape: Set[Tuple[int, int]]) -> Tuple[int, int]:\n    rs = [r for r, _ in shape]\n    cs = [c for _, c in shape]\n    return max(rs) - min(rs) + 1, max(cs) - min(cs) + 1\n\n\ndef _bbox_col2(shape: Set[Tuple[int, int]], left: int) -> Tuple[int, int]:\n    cols = [left + c for _, c in shape]\n    return min(cols), max(cols)\n\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"mkdir -p /home/lixinyu/snap/a/des/code/eval_new/seed1572225882/3 && cat > /home/lixinyu/snap/a/des/code/eval_new/seed1572225882/3/2.py <<'PY'\nimport numpy as np\nfrom collections import Counter, deque\nfrom typing import Dict, List, Optional, Sequence, Set, Tuple\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \\\"\\\"\\\"Pair complementary fragments into full rectangles and sort them by original gap.\n\n    Input structure:\n    - The background color is black (0).\n    - Non-black pixels form several monochrome 4-connected components, all with distinct colors.\n    - For each valid pair of components, translating them without rotation or flip makes a complete filled axis-aligned rectangle.\n\n    Rule:\n    - Extract all non-black components and find every pair that can be translated so their masks tile one solid rectangle.\n    - Keep each component's original color when placing it into that rectangle.\n    - For each found pair, compute the horizontal distance between component bbox centers from the input and sort pairs by that distance ascending.\n    - Output the translated rectangles from left to right with one background column between consecutive rectangles.\n\n    Key insight:\n    - Pairing is recovered from geometric complementarity (shape + rectangle completion), while the output order is independently encoded by the original bbox-center distance signal.\n    \\\"\\\"\\\"\n\n    comps = _extract_components(grid)\n    if len(comps) < 2:\n        return np.array(grid, copy=True)\n\n    pair_candidates = _find_all_pair_candidates(comps)\n    if not pair_candidates:\n        return np.array(grid, copy=True)\n\n    paired = _select_pairs(pair_candidates, len(comps))\n    if not paired:\n        return np.array(grid, copy=True)\n\n    heights = [p[\\\"h\\\"] for p in paired]\n    widths = [p[\\\"w\\\"] for p in paired]\n\n    # Keep a consistent size; inputs generated for this task should already satisfy this.\n    common_h = Counter(heights).most_common(1)[0][0]\n    common_w = Counter(widths).most_common(1)[0][0]\n    paired = [p for p in paired if p[\\\"h\\\"] == common_h and p[\\\"w\\\"] == common_w]\n    if not paired:\n        return np.array(grid, copy=True)\n\n    paired.sort(key=lambda p: (p[\\\"distance2\\\"], p[\\\"i\\\"], p[\\\"j\\\"]))\n    h = common_h\n    w = common_w\n\n    out_width = len(paired) * w + max(0, len(paired) - 1)\n    out = np.zeros((h, out_width), dtype=grid.dtype)\n\n    col0 = 0\n    for p in paired:\n        for r, c in p[\\\"coords_a\\\"]:\n            out[r, col0 + c] = comps[p[\\\"i\\\"]][\\\"color\\\"]\n        for r, c in p[\\\"coords_b\\\"]:\n            out[r, col0 + c] = comps[p[\\\"j\\\"]][\\\"color\\\"]\n        col0 += w + 1\n\n    return out\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n\n    def build_once() -> Optional[np.ndarray]:\n        num_pairs = int(rng.integers(2, 5))\n        # Keep rectangle width bounded so final output always fits <= 30.\n        max_rect_w = (30 - (num_pairs - 1)) // num_pairs\n        if max_rect_w < 3:\n            return None\n\n        rect_h = int(rng.integers(3, 8 + 1))\n        rect_w = int(rng.integers(3, min(10, max_rect_w) + 1))\n\n        # Input canvas also must be <= 30 in each dimension.\n        H = int(rng.integers(max(rect_h + 6, 15), 31))\n        W = int(rng.integers(max(rect_w + 6, 18), 31))\n\n        grid = np.zeros((H, W), dtype=np.int64)\n        used = np.zeros((H, W), dtype=bool)\n\n        colors = list(range(1, 17))\n        rng.shuffle(colors)\n        used_distances: Set[int] = set()\n\n        palette_i = 0\n\n        for _ in range(num_pairs):\n            if palette_i + 1 >= len(colors):\n                return None\n\n            shape_a, shape_b = _make_shape_pair(rect_h, rect_w, rng)\n            if shape_a is None or shape_b is None:\n                return None\n\n            def put_shape(shape: Set[Tuple[int, int]], top: int, left: int) -> List[Tuple[int, int]]:\n                return [(r + top, c + left) for r, c in shape]\n\n            h_a, w_a = _bbox_shape_size(shape_a)\n            h_b, w_b = _bbox_shape_size(shape_b)\n            top_a_max = H - h_a\n            left_a_max = W - w_a\n            top_b_max = H - h_b\n            left_b_max = W - w_b\n            if top_a_max < 0 or left_a_max < 0 or top_b_max < 0 or left_b_max < 0:\n                return None\n\n            placed = False\n            attempts = 1200\n            color_a = colors[palette_i]\n            color_b = colors[palette_i + 1]\n            palette_i += 2\n\n            for _ in range(attempts):\n                top_a = int(rng.integers(top_a_max + 1))\n                left_a = int(rng.integers(left_a_max + 1))\n                top_b = int(rng.integers(top_b_max + 1))\n                left_b = int(rng.integers(left_b_max + 1))\n\n                if not _can_place(shape_a, used, top_a, left_a):\n                    continue\n                if not _can_place(shape_b, used, top_b, left_b):\n                    continue\n\n                min_ca, max_ca = _bbox_col2(shape_a, left_a)\n                min_cb, max_cb = _bbox_col2(shape_b, left_b)\n                dist2 = abs((min_ca + max_ca) - (min_cb + max_cb))\n                if dist2 in used_distances:\n                    continue\n\n                pa = put_shape(shape_a, top_a, left_a)\n                pb = put_shape(shape_b, top_b, left_b)\n\n                for r, c in pa:\n                    used[r, c] = True\n                    grid[r, c] = color_a\n                for r, c in pb:\n                    used[r, c] = True\n                    grid[r, c] = color_b\n\n                used_distances.add(dist2)\n                placed = True\n                break\n\n            if not placed:\n                return None\n\n        if palette_i \"'!= len(used_distances):\n            # Ensure at least one more useful condition besides placement success.\n            pass\n\n        return grid\n\n    # Retry until a valid sample is found.\n    for _ in range(200):\n        grid = build_once()\n        if grid is None:\n            continue\n        if max(grid.shape) > 30:\n            continue\n        comps = _extract_components(grid)\n        if len(comps) % 2 != 0:\n            continue\n        pair_candidates = _find_all_pair_candidates(comps)\n        if not pair_candidates:\n            continue\n        picked = _select_pairs(pair_candidates, len(comps))\n        if len(picked) * 2 != len(comps):\n            continue\n        # Keep distance signatures distinct in generated data.\n        dists = [p[\"distance2\"] for p in picked]\n        if len(dists) != len(set(dists)):\n            continue\n        out = main(grid)\n        if out.shape[0] <= 30 and out.shape[1] <= 30:\n            return grid\n\n    # Fallback deterministic sample.\n    return _fallback_input()\n\n\ndef _fallback_input() -> np.ndarray:\n    H, W = 20, 22\n    grid = np.zeros((H, W), dtype=np.int64)\n    rng = np.random.default_rng(0)\n    rect_h = 4\n    rect_w = 6\n\n    def to_coords(mask: Set[Tuple[int, int]], top: int, left: int, color: int):\n        for r, c in mask:\n            grid[r + top, c + left] = color\n\n    def split_pair():\n        a = set()\n        b = set()\n        k = rect_w // 2\n        for r in range(rect_h):\n            for c in range(rect_w):\n                if c < k:\n                    a.add((r, c))\n                else:\n                    b.add((r, c))\n        return a, b\n\n    a1, b1 = split_pair()\n    a2, b2 = _make_border_pair(rect_h, rect_w)\n    for r, c in a1:\n        grid[r + 2, c + 1] = 1\n        grid[r + 7, c + 14] = 3\n    for r, c in b1:\n        grid[r + 2, c + 12] = 2\n        grid[r + 7, c + 1] = 4\n    for r, c in a2:\n        grid[r + 12, c + 3] = 5\n    for r, c in b2:\n        grid[r + 12, c + 12] = 6\n    return grid\n\n\ndef _extract_components(grid: np.ndarray) -> List[Dict]:\n    H, W = grid.shape\n    seen = np.zeros((H, W), dtype=bool)\n    comps: List[Dict] = []\n    for r0 in range(H):\n        for c0 in range(W):\n            color = int(grid[r0, c0])\n            if color == 0 or seen[r0, c0]:\n                continue\n\n            q = deque([(r0, c0)])\n            seen[r0, c0] = True\n            pixels: List[Tuple[int, int]] = []\n            min_r = max_r = r0\n            min_c = max_c = c0\n\n            while q:\n                r, c = q.popleft()\n                pixels.append((r, c))\n                if r < min_r:\n                    min_r = r\n                if r > max_r:\n                    max_r = r\n                if c < min_c:\n                    min_c = c\n                if c > max_c:\n                    max_c = c\n\n                if r > 0 and not seen[r - 1, c] and int(grid[r - 1, c]) == color:\n                    seen[r - 1, c] = True\n                    q.append((r - 1, c))\n                if r + 1 < H and not seen[r + 1, c] and int(grid[r + 1, c]) == color:\n                    seen[r + 1, c] = True\n                    q.append((r + 1, c))\n                if c > 0 and not seen[r, c - 1] and int(grid[r, c - 1]) == color:\n                    seen[r, c - 1] = True\n                    q.append((r, c - 1))\n                if c + 1 < W and not seen[r, c + 1] and int(grid[r, c + 1]) == color:\n                    seen[r, c + 1] = True\n                    q.append((r, c + 1))\n\n            comp_set = set(pixels)\n            comps.append(\n                {\n                    \"color\": color,\n                    \"pixels\": pixels,\n                    \"set\": comp_set,\n                    \"r0\": min_r,\n                    \"r1\": max_r,\n                    \"c0\": min_c,\n                    \"c1\": max_c,\n                    \"h\": max_r - min_r + 1,\n                    \"w\": max_c - min_c + 1,\n                    \"center2c\": min_c + max_c,\n                }\n            )\n\n    return comps\n\n\ndef _find_all_pair_candidates(comps: List[Dict]) -> List[Dict]:\n    n = len(comps)\n    candidates: List[Dict] = []\n    for i in range(n):\n        for j in range(i + 1, n):\n            rel = _find_tile_relation(comps[i], comps[j])\n            if rel is None:\n                continue\n            rel = dict(rel)\n            rel[\"i\"] = i\n            rel[\"j\"] = j\n            rel[\"distance2\"] = abs(comps[i][\"center2c\"] - comps[j][\"center2c\"])\n            candidates.append(rel)\n    return candidates\n\n\ndef _find_tile_relation(comp_a: Dict, comp_b: Dict) -> Optional[Dict]:\n    a_set = comp_a[\"set\"]\n    b_set = comp_b[\"set\"]\n\n    if comp_a[\"h\"] == comp_a[\"w\"] == 1 and comp_b[\"h\"] == comp_b[\"w\"] == 1:\n        return None\n\n    min_ra, min_ca, max_ra, max_ca = comp_a[\"r0\"], comp_a[\"c0\"], comp_a[\"r1\"], comp_a[\"c1\"]\n    min_rb, min_cb, max_rb, max_cb = comp_b[\"r0\"], comp_b[\"c0\"], comp_b[\"r1\"], comp_b[\"c1\"]\n\n    len_a = len(a_set)\n    len_b = len(b_set)\n\n    best: Optional[Dict] = None\n    for dr in range(-comp_b[\"h\"], comp_a[\"h\"] + 1):\n        shifted_b_min_r = min_rb + dr\n        shifted_b_max_r = max_rb + dr\n        min_r = min(min_ra, shifted_b_min_r)\n        max_r = max(max_ra, shifted_b_max_r)\n\n        for dc in range(-comp_b[\"w\"], comp_a[\"w\"] + 1):\n            shifted_b_min_c = min_cb + dc\n            shifted_b_max_c = max_cb + dc\n            min_c = min(min_ca, shifted_b_min_c)\n            max_c = max(max_ca, shifted_b_max_c)\n\n            h = max_r - min_r + 1\n            w = max_c - min_c + 1\n\n            if h * w != len_a + len_b:\n                continue\n\n            # Ensure no overlap and exact rectangle fill.\n            valid = True\n            for r_b, c_b in comp_b[\"pixels\"]:\n                rr = r_b + dr\n                cc = c_b + dc\n                if (rr, cc) in a_set:\n                    valid = False\n                    break\n            if not valid:\n                continue\n\n            # Additional quick test (implicit in area check): union of two disjoint sets\n            # must cover the whole bbox.\n            candidate = {\n                \"h\": h,\n                \"w\": w,\n                \"coords_a\": [(r - min_r, c - min_c) for (r, c) in comp_a[\"pixels\"]],\n                \"coords_b\": [(r + dr - min_r, c + dc - min_c) for (r, c) in comp_b[\"pixels\"]],\n            }\n\n            if best is None:\n                best = candidate\n            else:\n                key = (candidate[\"h\"], candidate[\"w\"], min_r, min_c, dr, dc)\n                best_key = (best[\"h\"], best[\"w\"], min_r, min_c, dr, dc)\n                if key < best_key:\n                    best = candidate\n\n    return best\n\n\ndef _select_pairs(candidates: List[Dict], n: int) -> List[Dict]:\n    by_i = [[] for _ in range(n)]\n    for c in candidates:\n        by_i[c[\"i\"]].append(c)\n\n    for bucket in by_i:\n        bucket.sort(key=lambda d: (d[\"h\"], d[\"w\"], d[\"distance2\"], d[\"i\"], d[\"j\"]))\n\n    best: List[Dict] = []\n    used = [False] * n\n\n    def signature(pairs: Sequence[Dict]) -> Tuple:\n        return tuple((p[\"distance2\"], p[\"i\"], p[\"j\"]) for p in sorted(pairs, key=lambda x: (x[\"distance2\"], x[\"i\"], x[\"j\"])) )\n\n    def backtrack(current: List[Dict]) -> None:\n        nonlocal best\n\n        remaining = sum(1 for u in used if not u)\n        upper_bound = len(current) + remaining // 2\n        if upper_bound <= len(best):\n            return\n\n        try:\n            i = next(idx for idx, u in enumerate(used) if not u)\n        except StopIteration:\n            if len(current) > len(best) or (len(current) == len(best) and signature(current) < signature(best)):\n                best = list(current)\n            return\n\n        used[i] = True\n\n        # Option to leave this component unmatched.\n        backtrack(current)\n\n        for c in by_i[i]:\n            j = c[\"j\"]\n            if used[j]:\n                continue\n            used[j] = True\n            current.append(c)\n            backtrack(current)\n            current.pop()\n            used[j] = False\n\n        used[i] = False\n\n    backtrack([])\n    return best\n\n\ndef _make_shape_pair(rect_h: int, rect_w: int, rng: np.random.Generator) -> Optional[Tuple[Set[Tuple[int, int]], Set[Tuple[int, int]]]]:\n    methods = [\n        _make_random_connected_pair,\n        _make_split_pair,\n        _make_border_pair,\n    ]\n\n    for _ in range(40):\n        method = int(rng.integers(0, len(methods)))\n        a, b = methods[method](rect_h, rect_w, rng)\n        if a is None or b is None:\n            continue\n        if not a or not b:\n            continue\n        a = set(a)\n        b = set(b)\n        # Keep a and b connected and complementary by construction.\n        if _shape_is_connected(a, rect_h, rect_w) and _shape_is_connected(b, rect_h, rect_w):\n            a, b = _random_flip_pair(a, b, rect_h, rect_w, rng)\n            return a, b\n\n    return None\n\n\ndef _make_split_pair(rect_h: int, rect_w: int, rng: np.random.Generator):\n    if rect_w >= 2 and (rect_h < 2 or rng.random() < 0.5):\n        cut = int(rng.integers(1, rect_w))\n        a = set()\n        b = set()\n        for r in range(rect_h):\n            for c in range(rect_w):\n                (a if c < cut else b).add((r, c))\n    elif rect_h >= 2:\n        cut = int(rng.integers(1, rect_h))\n        a = set()\n        b = set()\n        for r in range(rect_h):\n            for c in range(rect_w):\n                (a if r < cut else b).add((r, c))\n    else:\n        return None, None\n\n    return a, b\n\n\ndef _make_border_pair(rect_h: int, rect_w: int, rng: np.random.Generator = None):\n    del rng\n    if rect_h < 3 or rect_w < 3:\n        return None, None\n    a = set()\n    b = set()\n    for r in range(rect_h):\n        for c in range(rect_w):\n            if r == 0 or c == 0 or r == rect_h - 1 or c == rect_w - 1:\n                a.add((r, c))\n            else:\n                b.add((r, c))\n    return a, b\n\n\ndef _make_random_connected_pair(rect_h: int, rect_w: int, rng: np.random.Generator):\n    total = rect_h * rect_w\n    if total < 2:\n        return None, None\n\n    min_area = max(1, total // 4)\n    max_area = max(1, (3 * total) // 4)\n\n    all_cells = [(r, c) for r in range(rect_h) for c in range(rect_w)]\n\n    for _ in range(80):\n        target_area = int(rng.integers(min_area, max_area + 1))\n        start = all_cells[int(rng.integers(len(all_cells)))]\n        shape_a = {start}\n        frontier = {start}\n\n        for _ in range(1, target_area):\n            candidates = set()\n            for r0, c0 in list(frontier):\n                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    r = r0 + dr\n                    c = c0 + dc\n                    if 0 <= r < rect_h and 0 <= c < rect_w and (r, c) not in shape_a:\n                        candidates.add((r, c))\n            if not candidates:\n                shape_a = None\n                break\n            next_cell = tuple(candidates.pop() if len(candidates) == 1 else candidates.pop())\n            shape_a.add(next_cell)\n            frontier.add(next_cell)\n\n        if shape_a is None:\n            continue\n\n        shape_b = {(r, c) for r in range(rect_h) for c in range(rect_w) if (r, c) not in shape_a}\n        if not shape_a or not shape_b:\n            continue\n        if _shape_is_connected(shape_b, rect_h, rect_w):\n            return shape_a, shape_b\n\n    return None, None\n\n\ndef _random_flip_pair(a: Set[Tuple[int, int]], b: Set[Tuple[int, int]], h: int, w: int, rng: np.random.Generator) -> Tuple[Set[Tuple[int, int]], Set[Tuple[int, int]]]:\n    if rng.random() < 0.5:\n        a = {(r, w - 1 - c) for r, c in a}\n        b = {(r, w - 1 - c) for r, c in b}\n    if rng.random() < 0.5:\n        a = {(h - 1 - r, c) for r, c in a}\n        b = {(h - 1 - r, c) for r, c in b}\n    return a, b\n\n\ndef _shape_is_connected(shape: Set[Tuple[int, int]], h: int, w: int) -> bool:\n    if not shape:\n        return False\n    q = deque([next(iter(shape))])\n    seen = {q[0]}\n    area = 1\n    while q:\n        r, c = q.popleft()\n        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n            rr = r + dr\n            cc = c + dc\n            if 0 <= rr < h and 0 <= cc < w and (rr, cc) in shape and (rr, cc) not in seen:\n                seen.add((rr, cc))\n                q.append((rr, cc))\n                area += 1\n    return area == len(shape)\n\n\ndef _can_place(shape: Set[Tuple[int, int]], used: np.ndarray, top: int, left: int) -> bool:\n    H, W = used.shape\n    for r, c in shape:\n        rr = r + top\n        cc = c + left\n        if rr < 0 or rr >= H or cc < 0 or cc >= W:\n            return False\n        if used[rr, cc]:\n            return False\n    # Add 1-cell spacing to avoid accidental merge by 4-connectivity.\n    for r, c in shape:\n        rr = r + top\n        cc = c + left\n        if rr > 0 and used[rr - 1, cc]:\n            return False\n        if rr + 1 < H and used[rr + 1, cc]:\n            return False\n        if cc > 0 and used[rr, cc - 1]:\n            return False\n        if cc + 1 < W and used[rr, cc + 1]:\n            return False\n    return True\n\n\ndef _bbox_shape_size(shape: Set[Tuple[int, int]]) -> Tuple[int, int]:\n    rs = [r for r, _ in shape]\n    cs = [c for _, c in shape]\n    return max(rs) - min(rs) + 1, max(cs) - min(cs) + 1\n\n\ndef _bbox_col2(shape: Set[Tuple[int, int]], left: int) -> Tuple[int, int]:\n    cols = [left + c for _, c in shape]\n    return min(cols), max(cols)\n\nPY'","aggregated_output":"","exit_code":0,"status":"completed"}}
