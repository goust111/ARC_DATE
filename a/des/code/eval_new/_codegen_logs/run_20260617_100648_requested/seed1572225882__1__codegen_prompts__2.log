{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"mkdir -p /home/lixinyu/snap/a/des/code/eval_new/seed1572225882/1\ncat > /home/lixinyu/snap/a/des/code/eval_new/seed1572225882/1/2.py <<'PY'\n\\\"\\\"\\\"Merge complementary colored fragments into full rectangles and recolor by area-aware legend.\n\nInput structure:\n- The background is black.\n- The grid contains several monochrome, 4-connected fragments, each in a unique color, and all fragments come in complementary pairs.\n- Each paired fragments share the same bounding box size and their occupied masks inside that box are exact complements.\n- A 1x2 legend is placed in the top-right corner inside a thin gray frame; its left color means the larger fragment area, its right color means the smaller fragment area.\n\nRule:\n- Detect the top-right framed legend and read its two inner colors (left and right).\n- Find all non-background connected components that are not part of the legend.\n- Pair fragments whose shapes are complementary in equal-size bounding boxes.\n- For each pair, choose the fragment with smaller bbox top row (then smaller col) as anchor, and translate the other fragment to this same bbox position.\n- Recolor the larger fragment with the legend-left color and the smaller fragment with the legend-right color; if areas are equal, keep their original colors.\n- Clear moved fragment sources to black and keep the legend unchanged in output.\n\nKey insight:\n- The central task is first to solve geometric pairing by shape complementarity, then apply area-driven recoloring from the legend, which is independent of original fragment colors.\n\\\"\\\"\\\"\n\nfrom __future__ import annotations\n\nfrom collections import deque\nfrom typing import Dict, List, Optional, Sequence, Tuple\n\nimport numpy as np\n\n\n_DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _collect_components(grid: np.ndarray, bg: int, forbidden: Optional[np.ndarray] = None) -> List[Dict[str, np.ndarray]]:\n    h, w = grid.shape\n    visited = np.zeros_like(grid, dtype=bool)\n    if forbidden is not None:\n        visited |= forbidden\n\n    comps: List[Dict[str, np.ndarray]] = []\n    for r in range(h):\n        for c in range(w):\n            if visited[r, c]:\n                continue\n            color = int(grid[r, c])\n            if color == bg:\n                continue\n            q = deque([(r, c)])\n            visited[r, c] = True\n            coords: List[Tuple[int, int]] = []\n            rmin, cmin = r, c\n            rmax, cmax = r, c\n            while q:\n                rr, cc = q.popleft()\n                coords.append((rr, cc))\n                if rr < rmin:\n                    rmin = rr\n                if rr > rmax:\n                    rmax = rr\n                if cc < cmin:\n                    cmin = cc\n                if cc > cmax:\n                    cmax = cc\n                for dr, dc in _DIRS:\n                    nr, nc = rr + dr, cc + dc\n                    if nr < 0 or nr >= h or nc < 0 or nc >= w:\n                        continue\n                    if visited[nr, nc] or int(grid[nr, nc]) \"'!= color:\n                        continue\n                    visited[nr, nc] = True\n                    q.append((nr, nc))\n            comps.append(\n                {\n                    \"color\": color,\n                    \"coords\": np.array(coords, dtype=np.int16),\n                    \"bbox\": (rmin, cmin, rmax, cmax),\n                    \"area\": len(coords),\n                }\n            )\n    return comps\n\n\ndef _is_connected(mask: np.ndarray) -> bool:\n    if not np.any(mask):\n        return False\n    h, w = mask.shape\n    rr, cc = np.argwhere(mask)[0]\n    q = [(int(rr), int(cc))]\n    seen = np.zeros_like(mask, dtype=bool)\n    seen[rr, cc] = True\n    count = 1\n    for r, c in q:\n        for dr, dc in _DIRS:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\n                seen[nr, nc] = True\n                q.append((nr, nc))\n                count += 1\n    return count == int(mask.sum())\n\n\ndef _coords_to_mask(coords: np.ndarray, r0: int, c0: int, h: int, w: int) -> np.ndarray:\n    mask = np.zeros((h, w), dtype=bool)\n    if coords.size:\n        rr = coords[:, 0] - r0\n        cc = coords[:, 1] - c0\n        mask[rr, cc] = True\n    return mask\n\n\ndef _are_complementary(c1: Dict[str, np.ndarray], c2: Dict[str, np.ndarray]) -> bool:\n    if c1[\"area\"] + c2[\"area\"] <= 0:\n        return False\n    r1, col1, r2, c2b = c1[\"bbox\"]\n    r1b, col1b, r2b, c2bb = c2[\"bbox\"]\n    h1, w1 = r2 - r1 + 1, c2b - col1 + 1\n    h2, w2 = r2b - r1b + 1, c2bb - col1b + 1\n    if h1 != h2 or w1 != w2:\n        return False\n    if c1[\"area\"] + c2[\"area\"] != h1 * w1:\n        return False\n    m1 = _coords_to_mask(c1[\"coords\"], r1, col1, h1, w1)\n    m2 = _coords_to_mask(c2[\"coords\"], r1b, col1b, h1, w1)\n    # Different colors means masks do not overlap at source, but union coverage check still protects against accidental mistakes.\n    if np.logical_and(m1, m2).any():\n        return False\n    return bool(np.logical_or(m1, m2).all())\n\n\ndef _find_legend(grid: np.ndarray, bg: int) -> Optional[Tuple[int, int, int, int, int, int]]:\n    h, w = grid.shape\n\n    def _candidate_by_bbox(r0: int, c0: int, r1: int, c1: int, frame_color: int) -> Optional[Tuple[int, int]]:\n        if r0 < 0 or c0 < 0 or r1 >= h or c1 >= w:\n            return None\n        if r1 - r0 < 2 or c1 - c0 < 3:\n            return None\n        for rr in range(r0, r1 + 1):\n            for cc in range(c0, c1 + 1):\n                on_border = rr in (r0, r1) or cc in (c0, c1)\n                if on_border and grid[rr, cc] != frame_color:\n                    return None\n                if not on_border and grid[rr, cc] == frame_color:\n                    return None\n        vals = []\n        for rr in range(r0 + 1, r1):\n            for cc in range(c0 + 1, c1):\n                v = int(grid[rr, cc])\n                if v != bg and v != frame_color:\n                    vals.append(((rr, cc), v))\n        if len(vals) != 2:\n            return None\n        if vals[0][1] == vals[1][1]:\n            return None\n        (rA, cA), colA = vals[0]\n        (rB, cB), colB = vals[1]\n        if rA == rB:\n            if cA < cB:\n                return colA, colB\n            return colB, colA\n        if cA == cB:\n            if rA <= rB:\n                return colA, colB\n            return colB, colA\n        return (colA, colB) if (cA, rA) < (cB, rB) else (colB, colA)\n\n    comp_cands = _collect_components(grid, bg)\n    best: Optional[Tuple[int, Tuple[int, int, int, int, int, int]]] = None\n\n    for comp in comp_cands:\n        if comp[\"area\"] > 30:\n            continue\n        color = comp[\"color\"]\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        hbb, wbb = r1 - r0 + 1, c1 - c0 + 1\n        if hbb < 3 or wbb < 4:\n            continue\n        if hbb > 6 or wbb > 8:\n            continue\n        if r0 > 4:\n            continue\n        if c1 < w - 4:\n            continue\n        # Require a full top-right look where the component is just a 1-cell frame.\n        for rr in range(r0, r1 + 1):\n            for cc in range(c0, c1 + 1):\n                is_border = rr in (r0, r1) or cc in (c0, c1)\n                if is_border and grid[rr, cc] != color:\n                    break\n                if not is_border and grid[rr, cc] == color:\n                    break\n            else:\n                continue\n            break\n        else:\n            cols, ctop, cbot, cleft = hbb, hbb, wbb, wbb\n            res = _candidate_by_bbox(r0, c0, r1, c1, color)\n            if res is None:\n                continue\n            left_col, right_col = res\n            score = (c0, -r0)  # near upper-right\n            if best is None or score > best[0]:\n                best = (score, (r0, c0, r1, c1, left_col, right_col))\n\n    if best is not None:\n        return best[1]\n\n    # Fallback: direct frame scan near the top-right for strict 3x4 legend geometry.\n    for r0 in range(0, min(4, h - 2)):\n        for c0 in range(max(0, w - 8), max(0, w - 3)):\n            c1 = c0 + 3\n            if c1 >= w:\n                continue\n            r1 = r0 + 2\n            if r1 >= h:\n                continue\n            frame_color = int(grid[r0, c0])\n            if frame_color == bg:\n                continue\n            ok = True\n            for rr in range(r0, r1 + 1):\n                for cc in range(c0, c1 + 1):\n                    on_border = rr in (r0, r1) or cc in (c0, c1)\n                    if on_border:\n                        if grid[rr, cc] != frame_color:\n                            ok = False\n                            break\n                    else:\n                        if grid[rr, cc] == frame_color:\n                            ok = False\n                            break\n                if not ok:\n                    break\n            if not ok:\n                continue\n            vals = []\n            for rr in range(r0 + 1, r1):\n                for cc in range(c0 + 1, c1):\n                    v = int(grid[rr, cc])\n                    if v != bg and v != frame_color:\n                        vals.append(((rr, cc), v))\n            if len(vals) != 2 or vals[0][1] == vals[1][1]:\n                continue\n            (rA, cA), colA = vals[0]\n            (rB, cB), colB = vals[1]\n            if rA == rB:\n                if cA < cB:\n                    return (r0, c0, r1, c1, colA, colB)\n                return (r0, c0, r1, c1, colB, colA)\n            if cA == cB:\n                if rA <= rB:\n                    return (r0, c0, r1, c1, colA, colB)\n                return (r0, c0, r1, c1, colB, colA)\n            return (r0, c0, r1, c1, colA, colB)\n    return None\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    grid = np.array(grid)\n    if grid.ndim != 2:\n        return grid\n\n    bg = 0\n    info = _find_legend(grid, bg)\n    if info is None:\n        return grid.copy()\n    lr, lc, rr, rc, legend_left, legend_right = info\n\n    legend_bbox = np.zeros_like(grid, dtype=bool)\n    legend_bbox[lr : rr + 1, lc : rc + 1] = True\n\n    components = _collect_components(grid, bg, forbidden=legend_bbox)\n    n = len(components)\n    used = [False] * n\n    pairs: List[Tuple[int, int]] = []\n\n    for i in range(n):\n        if used[i]:\n            continue\n        ci = components[i]\n        for j in range(i + 1, n):\n            if used[j]:\n                continue\n            cj = components[j]\n            if _are_complementary(ci, cj):\n                used[i] = True\n                used[j] = True\n                pairs.append((i, j))\n                break\n\n    out = np.array(grid, dtype=int, copy=True)\n    for i, j in pairs:\n        a = components[i]\n        b = components[j]\n\n        # clear originals\n        for rr, cc in a[\"coords\"]:\n            out[int(rr), int(cc)] = bg\n        for rr, cc in b[\"coords\"]:\n            out[int(rr), int(cc)] = bg\n\n        ra0, ca0, ra1, ca1 = a[\"bbox\"]\n        rb0, cb0, rb1, cb1 = b[\"bbox\"]\n\n        # anchor = upper bbox top row; tie by left col.\n        if (ra0 < rb0) or (ra0 == rb0 and ca0 <= cb0):\n            anchor = a\n            other = b\n        else:\n            anchor = b\n            other = a\n\n        ar0, ac0, _, _ = anchor[\"bbox\"]\n        or0, oc0, _, _ = other[\"bbox\"]\n        dr = ar0 - or0\n        dc = ac0 - oc0\n\n        if a[\"area\"] > b[\"area\"]:\n            color_a = legend_left\n            color_b = legend_right\n        elif a[\"area\"] < b[\"area\"]:\n            color_a = legend_right\n            color_b = legend_left\n        else:\n            color_a = a[\"color\"]\n            color_b = b[\"color\"]\n\n        # place anchor (possibly no shift)\n        for rr, cc in anchor[\"coords\"]:\n            out[int(rr), int(cc)] = color_a if anchor is a else color_b\n\n        for rr, cc in other[\"coords\"]:\n            nr = int(rr) + dr\n            nc = int(cc) + dc\n            out[nr, nc] = color_b if other is b else color_a\n\n    return out\n\n\ndef _is_connected_mask(mask: np.ndarray) -> bool:\n    return _is_connected(mask)\n\n\ndef _random_connected_mask(h: int, w: int, area: int, rng: np.random.Generator) -> Optional[np.ndarray]:\n    if area <= 0 or area > h * w:\n        return None\n    start = (int(rng.integers(0, h)), int(rng.integers(0, w)))\n    cells = {start}\n    while len(cells) < area:\n        frontier: List[Tuple[int, int]] = []\n        for cr, cc in cells:\n            for dr, dc in _DIRS:\n                nr, nc = cr + dr, cc + dc\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:\n                    frontier.append((nr, nc))\n        if not frontier:\n            return None\n        rr, cc = frontier[int(rng.integers(0, len(frontier)))]\n        cells.add((rr, cc))\n    mask = np.zeros((h, w), dtype=bool)\n    rs, cs = zip(*cells)\n    mask[np.array(rs, dtype=int), np.array(cs, dtype=int)] = True\n    return mask\n\n\ndef _can_place(mask: np.ndarray, top_r: int, top_c: int, occupied: np.ndarray) -> bool:\n    h, w = mask.shape\n    H, W = occupied.shape\n    if top_r < 0 or top_c < 0 or top_r + h > H or top_c + w > W:\n        return False\n    rs, cs = np.argwhere(mask).T\n    rr = rs + top_r\n    cc = cs + top_c\n    if rr.size == 0:\n        return False\n    return not np.any(occupied[rr, cc])\n\n\ndef _place_mask(grid: np.ndarray, mask: np.ndarray, top_r: int, top_c: int, color: int, occupied: np.ndarray) -> None:\n    rs, cs = np.argwhere(mask).T\n    rr = rs + top_r\n    cc = cs + top_c\n    grid[rr, cc] = color\n    occupied[rr, cc] = True\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n\n    palette = [1, 2, 3, 4, 5, 6, 7, 8]\n    frame_color = 9\n    bg = 0\n\n    for _ in range(200):\n        h = int(rng.integers(16, 29))\n        w = int(rng.integers(16, 30))\n        if w <= 9:\n            continue\n\n        grid = np.full((h, w), bg, dtype=int)\n        occupied = np.zeros((h, w), dtype=bool)\n\n        # Top-right legend: fixed 3x4 outer frame with 1x2 inside colors.\n        legend_top = 0\n        legend_left = w - 4\n        if legend_left < 0:\n            continue\n        legend_bottom = 2\n        legend_right = w - 1\n\n        legend_cols = palette.copy()\n        rng.shuffle(legend_cols)\n        legend_left_color = legend_cols[0]\n        legend_right_color = legend_cols[1]\n\n        # Draw frame.\n        for rr in range(legend_top, legend_bottom + 1):\n            for cc in range(legend_left, legend_right + 1):\n                on_border = rr in (legend_top, legend_bottom) or cc in (legend_left, legend_right)\n                if on_border:\n                    grid[rr, cc] = frame_color\n                else:\n                    grid[rr, cc] = bg\n        # Inner 1x2 legend colors (randomized order/positions, always row-wise left-to-right).\n        grid[1, legend_left + 1] = legend_left_color\n        grid[1, legend_left + 2] = legend_right_color\n        occupied[legend_top : legend_bottom + 1, legend_left : legend_right + 1] = True\n\n        pair_count = int(rng.integers(2, 4))\n        available = palette.copy()\n        available.remove(legend_left_color)\n        available.remove(legend_right_color)\n        if len(available) < 2 * pair_count:\n            continue\n        rng.shuffle(available)\n\n        success = True\n        pair_colors = available[: 2 * pair_count]\n\n        for p in range(pair_count):\n            color_a = pair_colors[2 * p]\n            color_b = pair_colors[2 * p + 1]\n\n            shape_created = False\n            for _shape_try in range(200):\n                bh = int(rng.integers(2, min(8, h - 2)))\n                bw = int(rng.integers(2, min(8, w - 9)))\n                if bh * bw < 4:\n                    continue\n\n                area_total = bh * bw\n                equal_area = bool(rng.random() < 0.5)\n                if equal_area:\n                    if area_total % 2 != 0:\n                        continue\n                    area_a = area_total // 2\n                else:\n                    area_a = int(rng.integers(1, area_total))\n                    if area_a == area_total // 2:\n                        area_a = area_a + 1 if area_a + 1 < area_total else area_a - 1\n                    area_a = max(1, min(area_total - 1, area_a))\n\n                area_b = area_total - area_a\n                if area_a <= 0 or area_b <= 0:\n                    continue\n\n                for _mask_try in range(100):\n                    mask_a = _random_connected_mask(bh, bw, area_a, rng)\n                    if mask_a is None:\n                        continue\n                    if not _is_connected_mask(mask_a):\n                        continue\n                    mask_b = np.logical_not(mask_a)\n                    if not _is_connected_mask(mask_b):\n                        continue\n\n                    pos1 = None\n                    for _ in range(400):\n                        ra = int(rng.integers(0, h - bh + 1))\n                        ca = int(rng.integers(0, w - bw + 1))\n                        if _can_place(mask_a, ra, ca, occupied):\n                            pos1 = (ra, ca)\n                            break\n                    if pos1 is None:\n                        continue\n\n                    pos2 = None\n                    for _ in range(400):\n                        rb = int(rng.integers(0, h - bh + 1))\n                        cb = int(rng.integers(0, w - bw + 1))\n                        if _can_place(mask_b, rb, cb, occupied):\n                            pos2 = (rb, cb)\n                            break\n                    if pos2 is None:\n                        continue\n\n                    # placement success\n                    _place_mask(grid, mask_a, *pos1, color_a, occupied)\n                    _place_mask(grid, mask_b, *pos2, color_b, occupied)\n                    shape_created = True\n                    break\n\n                if shape_created:\n                    break\n\n            if not shape_created:\n                success = False\n                break\n\n        if not success:\n            continue\n\n        return grid\n\n    # Fallback always terminates with a deterministic template if random generation fails unexpectedly.\n    template = np.zeros((20, 20), dtype=int)\n    frame_color = 9\n    tl, tt = 16, 4\n    template[:3, 16:20] = frame_color\n    template[0, 16] = frame_color\n    template[0, 19] = frame_color\n    template[2, 16] = frame_color\n    template[2, 19] = frame_color\n    template[1, 17] = 1\n    template[1, 18] = 2\n    template[1, 16] = frame_color\n    template[1, 19] = frame_color\n    return template\n\n\nif __name__ == \"__main__\":\n    sample = generate_input()\n    print(\"input:\")\n    print(sample)\n    print(\"output:\")\n    print(main(sample))\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"mkdir -p /home/lixinyu/snap/a/des/code/eval_new/seed1572225882/1\ncat > /home/lixinyu/snap/a/des/code/eval_new/seed1572225882/1/2.py <<'PY'\n\\\"\\\"\\\"Merge complementary colored fragments into full rectangles and recolor by area-aware legend.\n\nInput structure:\n- The background is black.\n- The grid contains several monochrome, 4-connected fragments, each in a unique color, and all fragments come in complementary pairs.\n- Each paired fragments share the same bounding box size and their occupied masks inside that box are exact complements.\n- A 1x2 legend is placed in the top-right corner inside a thin gray frame; its left color means the larger fragment area, its right color means the smaller fragment area.\n\nRule:\n- Detect the top-right framed legend and read its two inner colors (left and right).\n- Find all non-background connected components that are not part of the legend.\n- Pair fragments whose shapes are complementary in equal-size bounding boxes.\n- For each pair, choose the fragment with smaller bbox top row (then smaller col) as anchor, and translate the other fragment to this same bbox position.\n- Recolor the larger fragment with the legend-left color and the smaller fragment with the legend-right color; if areas are equal, keep their original colors.\n- Clear moved fragment sources to black and keep the legend unchanged in output.\n\nKey insight:\n- The central task is first to solve geometric pairing by shape complementarity, then apply area-driven recoloring from the legend, which is independent of original fragment colors.\n\\\"\\\"\\\"\n\nfrom __future__ import annotations\n\nfrom collections import deque\nfrom typing import Dict, List, Optional, Sequence, Tuple\n\nimport numpy as np\n\n\n_DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))\n\n\ndef _collect_components(grid: np.ndarray, bg: int, forbidden: Optional[np.ndarray] = None) -> List[Dict[str, np.ndarray]]:\n    h, w = grid.shape\n    visited = np.zeros_like(grid, dtype=bool)\n    if forbidden is not None:\n        visited |= forbidden\n\n    comps: List[Dict[str, np.ndarray]] = []\n    for r in range(h):\n        for c in range(w):\n            if visited[r, c]:\n                continue\n            color = int(grid[r, c])\n            if color == bg:\n                continue\n            q = deque([(r, c)])\n            visited[r, c] = True\n            coords: List[Tuple[int, int]] = []\n            rmin, cmin = r, c\n            rmax, cmax = r, c\n            while q:\n                rr, cc = q.popleft()\n                coords.append((rr, cc))\n                if rr < rmin:\n                    rmin = rr\n                if rr > rmax:\n                    rmax = rr\n                if cc < cmin:\n                    cmin = cc\n                if cc > cmax:\n                    cmax = cc\n                for dr, dc in _DIRS:\n                    nr, nc = rr + dr, cc + dc\n                    if nr < 0 or nr >= h or nc < 0 or nc >= w:\n                        continue\n                    if visited[nr, nc] or int(grid[nr, nc]) \"'!= color:\n                        continue\n                    visited[nr, nc] = True\n                    q.append((nr, nc))\n            comps.append(\n                {\n                    \"color\": color,\n                    \"coords\": np.array(coords, dtype=np.int16),\n                    \"bbox\": (rmin, cmin, rmax, cmax),\n                    \"area\": len(coords),\n                }\n            )\n    return comps\n\n\ndef _is_connected(mask: np.ndarray) -> bool:\n    if not np.any(mask):\n        return False\n    h, w = mask.shape\n    rr, cc = np.argwhere(mask)[0]\n    q = [(int(rr), int(cc))]\n    seen = np.zeros_like(mask, dtype=bool)\n    seen[rr, cc] = True\n    count = 1\n    for r, c in q:\n        for dr, dc in _DIRS:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\n                seen[nr, nc] = True\n                q.append((nr, nc))\n                count += 1\n    return count == int(mask.sum())\n\n\ndef _coords_to_mask(coords: np.ndarray, r0: int, c0: int, h: int, w: int) -> np.ndarray:\n    mask = np.zeros((h, w), dtype=bool)\n    if coords.size:\n        rr = coords[:, 0] - r0\n        cc = coords[:, 1] - c0\n        mask[rr, cc] = True\n    return mask\n\n\ndef _are_complementary(c1: Dict[str, np.ndarray], c2: Dict[str, np.ndarray]) -> bool:\n    if c1[\"area\"] + c2[\"area\"] <= 0:\n        return False\n    r1, col1, r2, c2b = c1[\"bbox\"]\n    r1b, col1b, r2b, c2bb = c2[\"bbox\"]\n    h1, w1 = r2 - r1 + 1, c2b - col1 + 1\n    h2, w2 = r2b - r1b + 1, c2bb - col1b + 1\n    if h1 != h2 or w1 != w2:\n        return False\n    if c1[\"area\"] + c2[\"area\"] != h1 * w1:\n        return False\n    m1 = _coords_to_mask(c1[\"coords\"], r1, col1, h1, w1)\n    m2 = _coords_to_mask(c2[\"coords\"], r1b, col1b, h1, w1)\n    # Different colors means masks do not overlap at source, but union coverage check still protects against accidental mistakes.\n    if np.logical_and(m1, m2).any():\n        return False\n    return bool(np.logical_or(m1, m2).all())\n\n\ndef _find_legend(grid: np.ndarray, bg: int) -> Optional[Tuple[int, int, int, int, int, int]]:\n    h, w = grid.shape\n\n    def _candidate_by_bbox(r0: int, c0: int, r1: int, c1: int, frame_color: int) -> Optional[Tuple[int, int]]:\n        if r0 < 0 or c0 < 0 or r1 >= h or c1 >= w:\n            return None\n        if r1 - r0 < 2 or c1 - c0 < 3:\n            return None\n        for rr in range(r0, r1 + 1):\n            for cc in range(c0, c1 + 1):\n                on_border = rr in (r0, r1) or cc in (c0, c1)\n                if on_border and grid[rr, cc] != frame_color:\n                    return None\n                if not on_border and grid[rr, cc] == frame_color:\n                    return None\n        vals = []\n        for rr in range(r0 + 1, r1):\n            for cc in range(c0 + 1, c1):\n                v = int(grid[rr, cc])\n                if v != bg and v != frame_color:\n                    vals.append(((rr, cc), v))\n        if len(vals) != 2:\n            return None\n        if vals[0][1] == vals[1][1]:\n            return None\n        (rA, cA), colA = vals[0]\n        (rB, cB), colB = vals[1]\n        if rA == rB:\n            if cA < cB:\n                return colA, colB\n            return colB, colA\n        if cA == cB:\n            if rA <= rB:\n                return colA, colB\n            return colB, colA\n        return (colA, colB) if (cA, rA) < (cB, rB) else (colB, colA)\n\n    comp_cands = _collect_components(grid, bg)\n    best: Optional[Tuple[int, Tuple[int, int, int, int, int, int]]] = None\n\n    for comp in comp_cands:\n        if comp[\"area\"] > 30:\n            continue\n        color = comp[\"color\"]\n        r0, c0, r1, c1 = comp[\"bbox\"]\n        hbb, wbb = r1 - r0 + 1, c1 - c0 + 1\n        if hbb < 3 or wbb < 4:\n            continue\n        if hbb > 6 or wbb > 8:\n            continue\n        if r0 > 4:\n            continue\n        if c1 < w - 4:\n            continue\n        # Require a full top-right look where the component is just a 1-cell frame.\n        for rr in range(r0, r1 + 1):\n            for cc in range(c0, c1 + 1):\n                is_border = rr in (r0, r1) or cc in (c0, c1)\n                if is_border and grid[rr, cc] != color:\n                    break\n                if not is_border and grid[rr, cc] == color:\n                    break\n            else:\n                continue\n            break\n        else:\n            cols, ctop, cbot, cleft = hbb, hbb, wbb, wbb\n            res = _candidate_by_bbox(r0, c0, r1, c1, color)\n            if res is None:\n                continue\n            left_col, right_col = res\n            score = (c0, -r0)  # near upper-right\n            if best is None or score > best[0]:\n                best = (score, (r0, c0, r1, c1, left_col, right_col))\n\n    if best is not None:\n        return best[1]\n\n    # Fallback: direct frame scan near the top-right for strict 3x4 legend geometry.\n    for r0 in range(0, min(4, h - 2)):\n        for c0 in range(max(0, w - 8), max(0, w - 3)):\n            c1 = c0 + 3\n            if c1 >= w:\n                continue\n            r1 = r0 + 2\n            if r1 >= h:\n                continue\n            frame_color = int(grid[r0, c0])\n            if frame_color == bg:\n                continue\n            ok = True\n            for rr in range(r0, r1 + 1):\n                for cc in range(c0, c1 + 1):\n                    on_border = rr in (r0, r1) or cc in (c0, c1)\n                    if on_border:\n                        if grid[rr, cc] != frame_color:\n                            ok = False\n                            break\n                    else:\n                        if grid[rr, cc] == frame_color:\n                            ok = False\n                            break\n                if not ok:\n                    break\n            if not ok:\n                continue\n            vals = []\n            for rr in range(r0 + 1, r1):\n                for cc in range(c0 + 1, c1):\n                    v = int(grid[rr, cc])\n                    if v != bg and v != frame_color:\n                        vals.append(((rr, cc), v))\n            if len(vals) != 2 or vals[0][1] == vals[1][1]:\n                continue\n            (rA, cA), colA = vals[0]\n            (rB, cB), colB = vals[1]\n            if rA == rB:\n                if cA < cB:\n                    return (r0, c0, r1, c1, colA, colB)\n                return (r0, c0, r1, c1, colB, colA)\n            if cA == cB:\n                if rA <= rB:\n                    return (r0, c0, r1, c1, colA, colB)\n                return (r0, c0, r1, c1, colB, colA)\n            return (r0, c0, r1, c1, colA, colB)\n    return None\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    grid = np.array(grid)\n    if grid.ndim != 2:\n        return grid\n\n    bg = 0\n    info = _find_legend(grid, bg)\n    if info is None:\n        return grid.copy()\n    lr, lc, rr, rc, legend_left, legend_right = info\n\n    legend_bbox = np.zeros_like(grid, dtype=bool)\n    legend_bbox[lr : rr + 1, lc : rc + 1] = True\n\n    components = _collect_components(grid, bg, forbidden=legend_bbox)\n    n = len(components)\n    used = [False] * n\n    pairs: List[Tuple[int, int]] = []\n\n    for i in range(n):\n        if used[i]:\n            continue\n        ci = components[i]\n        for j in range(i + 1, n):\n            if used[j]:\n                continue\n            cj = components[j]\n            if _are_complementary(ci, cj):\n                used[i] = True\n                used[j] = True\n                pairs.append((i, j))\n                break\n\n    out = np.array(grid, dtype=int, copy=True)\n    for i, j in pairs:\n        a = components[i]\n        b = components[j]\n\n        # clear originals\n        for rr, cc in a[\"coords\"]:\n            out[int(rr), int(cc)] = bg\n        for rr, cc in b[\"coords\"]:\n            out[int(rr), int(cc)] = bg\n\n        ra0, ca0, ra1, ca1 = a[\"bbox\"]\n        rb0, cb0, rb1, cb1 = b[\"bbox\"]\n\n        # anchor = upper bbox top row; tie by left col.\n        if (ra0 < rb0) or (ra0 == rb0 and ca0 <= cb0):\n            anchor = a\n            other = b\n        else:\n            anchor = b\n            other = a\n\n        ar0, ac0, _, _ = anchor[\"bbox\"]\n        or0, oc0, _, _ = other[\"bbox\"]\n        dr = ar0 - or0\n        dc = ac0 - oc0\n\n        if a[\"area\"] > b[\"area\"]:\n            color_a = legend_left\n            color_b = legend_right\n        elif a[\"area\"] < b[\"area\"]:\n            color_a = legend_right\n            color_b = legend_left\n        else:\n            color_a = a[\"color\"]\n            color_b = b[\"color\"]\n\n        # place anchor (possibly no shift)\n        for rr, cc in anchor[\"coords\"]:\n            out[int(rr), int(cc)] = color_a if anchor is a else color_b\n\n        for rr, cc in other[\"coords\"]:\n            nr = int(rr) + dr\n            nc = int(cc) + dc\n            out[nr, nc] = color_b if other is b else color_a\n\n    return out\n\n\ndef _is_connected_mask(mask: np.ndarray) -> bool:\n    return _is_connected(mask)\n\n\ndef _random_connected_mask(h: int, w: int, area: int, rng: np.random.Generator) -> Optional[np.ndarray]:\n    if area <= 0 or area > h * w:\n        return None\n    start = (int(rng.integers(0, h)), int(rng.integers(0, w)))\n    cells = {start}\n    while len(cells) < area:\n        frontier: List[Tuple[int, int]] = []\n        for cr, cc in cells:\n            for dr, dc in _DIRS:\n                nr, nc = cr + dr, cc + dc\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:\n                    frontier.append((nr, nc))\n        if not frontier:\n            return None\n        rr, cc = frontier[int(rng.integers(0, len(frontier)))]\n        cells.add((rr, cc))\n    mask = np.zeros((h, w), dtype=bool)\n    rs, cs = zip(*cells)\n    mask[np.array(rs, dtype=int), np.array(cs, dtype=int)] = True\n    return mask\n\n\ndef _can_place(mask: np.ndarray, top_r: int, top_c: int, occupied: np.ndarray) -> bool:\n    h, w = mask.shape\n    H, W = occupied.shape\n    if top_r < 0 or top_c < 0 or top_r + h > H or top_c + w > W:\n        return False\n    rs, cs = np.argwhere(mask).T\n    rr = rs + top_r\n    cc = cs + top_c\n    if rr.size == 0:\n        return False\n    return not np.any(occupied[rr, cc])\n\n\ndef _place_mask(grid: np.ndarray, mask: np.ndarray, top_r: int, top_c: int, color: int, occupied: np.ndarray) -> None:\n    rs, cs = np.argwhere(mask).T\n    rr = rs + top_r\n    cc = cs + top_c\n    grid[rr, cc] = color\n    occupied[rr, cc] = True\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n\n    palette = [1, 2, 3, 4, 5, 6, 7, 8]\n    frame_color = 9\n    bg = 0\n\n    for _ in range(200):\n        h = int(rng.integers(16, 29))\n        w = int(rng.integers(16, 30))\n        if w <= 9:\n            continue\n\n        grid = np.full((h, w), bg, dtype=int)\n        occupied = np.zeros((h, w), dtype=bool)\n\n        # Top-right legend: fixed 3x4 outer frame with 1x2 inside colors.\n        legend_top = 0\n        legend_left = w - 4\n        if legend_left < 0:\n            continue\n        legend_bottom = 2\n        legend_right = w - 1\n\n        legend_cols = palette.copy()\n        rng.shuffle(legend_cols)\n        legend_left_color = legend_cols[0]\n        legend_right_color = legend_cols[1]\n\n        # Draw frame.\n        for rr in range(legend_top, legend_bottom + 1):\n            for cc in range(legend_left, legend_right + 1):\n                on_border = rr in (legend_top, legend_bottom) or cc in (legend_left, legend_right)\n                if on_border:\n                    grid[rr, cc] = frame_color\n                else:\n                    grid[rr, cc] = bg\n        # Inner 1x2 legend colors (randomized order/positions, always row-wise left-to-right).\n        grid[1, legend_left + 1] = legend_left_color\n        grid[1, legend_left + 2] = legend_right_color\n        occupied[legend_top : legend_bottom + 1, legend_left : legend_right + 1] = True\n\n        pair_count = int(rng.integers(2, 4))\n        available = palette.copy()\n        available.remove(legend_left_color)\n        available.remove(legend_right_color)\n        if len(available) < 2 * pair_count:\n            continue\n        rng.shuffle(available)\n\n        success = True\n        pair_colors = available[: 2 * pair_count]\n\n        for p in range(pair_count):\n            color_a = pair_colors[2 * p]\n            color_b = pair_colors[2 * p + 1]\n\n            shape_created = False\n            for _shape_try in range(200):\n                bh = int(rng.integers(2, min(8, h - 2)))\n                bw = int(rng.integers(2, min(8, w - 9)))\n                if bh * bw < 4:\n                    continue\n\n                area_total = bh * bw\n                equal_area = bool(rng.random() < 0.5)\n                if equal_area:\n                    if area_total % 2 != 0:\n                        continue\n                    area_a = area_total // 2\n                else:\n                    area_a = int(rng.integers(1, area_total))\n                    if area_a == area_total // 2:\n                        area_a = area_a + 1 if area_a + 1 < area_total else area_a - 1\n                    area_a = max(1, min(area_total - 1, area_a))\n\n                area_b = area_total - area_a\n                if area_a <= 0 or area_b <= 0:\n                    continue\n\n                for _mask_try in range(100):\n                    mask_a = _random_connected_mask(bh, bw, area_a, rng)\n                    if mask_a is None:\n                        continue\n                    if not _is_connected_mask(mask_a):\n                        continue\n                    mask_b = np.logical_not(mask_a)\n                    if not _is_connected_mask(mask_b):\n                        continue\n\n                    pos1 = None\n                    for _ in range(400):\n                        ra = int(rng.integers(0, h - bh + 1))\n                        ca = int(rng.integers(0, w - bw + 1))\n                        if _can_place(mask_a, ra, ca, occupied):\n                            pos1 = (ra, ca)\n                            break\n                    if pos1 is None:\n                        continue\n\n                    pos2 = None\n                    for _ in range(400):\n                        rb = int(rng.integers(0, h - bh + 1))\n                        cb = int(rng.integers(0, w - bw + 1))\n                        if _can_place(mask_b, rb, cb, occupied):\n                            pos2 = (rb, cb)\n                            break\n                    if pos2 is None:\n                        continue\n\n                    # placement success\n                    _place_mask(grid, mask_a, *pos1, color_a, occupied)\n                    _place_mask(grid, mask_b, *pos2, color_b, occupied)\n                    shape_created = True\n                    break\n\n                if shape_created:\n                    break\n\n            if not shape_created:\n                success = False\n                break\n\n        if not success:\n            continue\n\n        return grid\n\n    # Fallback always terminates with a deterministic template if random generation fails unexpectedly.\n    template = np.zeros((20, 20), dtype=int)\n    frame_color = 9\n    tl, tt = 16, 4\n    template[:3, 16:20] = frame_color\n    template[0, 16] = frame_color\n    template[0, 19] = frame_color\n    template[2, 16] = frame_color\n    template[2, 19] = frame_color\n    template[1, 17] = 1\n    template[1, 18] = 2\n    template[1, 16] = frame_color\n    template[1, 19] = frame_color\n    return template\n\n\nif __name__ == \"__main__\":\n    sample = generate_input()\n    print(\"input:\")\n    print(sample)\n    print(\"output:\")\n    print(main(sample))\nPY'","aggregated_output":"","exit_code":0,"status":"completed"}}
