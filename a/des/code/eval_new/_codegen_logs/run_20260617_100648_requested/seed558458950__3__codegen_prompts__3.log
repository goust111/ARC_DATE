nd arrow color.\n    non_bg_colors = np.setdiff1d(np.unique(out), np.array([bg_color], dtype=out.dtype))\n    if non_bg_colors.size == 0:\n        return out\n\n    counts = {int(c): int((out == c).sum()) for c in non_bg_colors}\n    fg_color = max(counts, key=counts.get)\n    arrow_color = fg_color\n    if non_bg_colors.size >= 2:\n        non_fg = [int(c) for c in non_bg_colors if int(c) != fg_color]\n        if non_fg:\n            border_scores = {c: _count_border_pixels(out, c) for c in non_fg}\n            if any(v > 0 for v in border_scores.values()):\n                arrow_color = max(non_fg, key=border_scores.get)\n            else:\n                arrow_color = max(non_fg, key=counts.get)\n\n    axis_orient, axis_a2 = _find_symmetry_axis(out, fg_color, bg_color)\n\n    # Determine ray direction from marker side.\n    dr, dc = _direction_from_markers(out, bg_color, arrow_color)\n\n    # Remove marker color.\n    if arrow_color in np.unique(out):\n        out[out == arrow_color] = bg_color\n\n    # Find asymmetric defect pixels relative to inferred axis.\n    diffs = _find_defects(out, fg_color, axis_orient, axis_a2)\n\n    # Cast rays.\n    for r, c in diffs:\n        rr, cc = r + dr, c + dc\n        while 0 <= rr < H and 0 <= cc < W:\n            if out[rr, cc] == fg_color:\n                break\n            out[rr, cc] = RAY_COLOR\n            rr += dr\n            cc += dc\n\n    return out\n\n\ndef generate_input() -> np.ndarray:\n    \"\"\"Generate a random ARC-style grid with hidden symmetry, one-side defects, and edge arrows.\"\"\"\n\n    H = random.randint(12, 28)\n    W = random.randint(12, 28)\n    grid = np.full((H, W), BG_COLOR, dtype=np.int64)\n\n    palette = [1, 2, 4, 5, 6, 7, 8, 9]\n    fg_color = random.choice(palette)\n    ray_candidates = [c for c in palette if c != fg_color]\n    arrow_color = random.choice(ray_candidates)\n    RAY_COLOR_local = RAY_COLOR\n    if fg_color == RAY_COLOR_local:\n        fg_color = ray_candidates[0]\n    if arrow_color == RAY_COLOR_local:\n        arrow_color = ray_candidates[-1]\n\n    orient = random.choice([\"v\", \"h\"])\n    direction_side = random.choice([\"left\", \"right\", \"up\", \"down\"])\n\n    if orient == \"v\":\n        axis_anchor = random.randint(3, W - 4)\n        axis_a2 = 2 * axis_anchor\n        if random.random() < 0.5:\n            axis_a2 = axis_a2 + 1  # boundary axis\n        axis_orient = \"v\"\n    else:\n        axis_anchor = random.randint(3, H - 4)\n        axis_a2 = 2 * axis_anchor\n        if random.random() < 0.5:\n            axis_a2 = axis_a2 + 1\n        axis_orient = \"h\"\n\n    # Build a large symmetric foreground object.\n    _draw_symmetric_pattern(\n        grid,\n        fg_color,\n        axis_orient,\n        axis_a2,\n        random.choice([\"positive\", \"negative\"]),\n    )\n\n    # Introduce true one-side defects on matched symmetric pairs.\n    _inject_defects(grid, fg_color, axis_orient, axis_a2)\n\n    # Place equally spaced red arrows on one border edge.\n    if direction_side == \"left\":\n        _place_left_arrows(grid, arrow_color)\n    elif direction_side == \"right\":\n        _place_right_arrows(grid, arrow_color)\n    elif direction_side == \"up\":\n        _place_up_arrows(grid, arrow_color)\n    else:\n        _place_down_arrows(grid, arrow_color)\n\n    return np.array(grid, dtype=np.int64)\n\n\ndef _mode_color(grid: np.ndarray) -> int:\n    colors, counts = np.unique(grid, return_counts=True)\n    return int(colors[np.argmax(counts)])\n\n\ndef _count_border_pixels(grid: np.ndarray, color: int) -> int:\n    h, w = grid.shape\n    return int(\n        np.sum(grid[0, :] == color)\n        + np.sum(grid[h - 1, :] == color)\n        + np.sum(grid[:, 0] == color)\n        + np.sum(grid[:, w - 1] == color)\n    )\n\n\ndef _direction_from_markers(grid: np.ndarray, bg_color: int, arrow_color: int) -> Tuple[int, int]:\n    h, w = grid.shape\n    if not np.any(grid == arrow_color):\n        return (0, 1)\n\n    side_counts = {\n        \"right\": int(np.sum(grid[:, w - 1] == arrow_color)),\n        \"left\": int(np.sum(grid[:, 0] == arrow_color)),\n        \"top\": int(np.sum(grid[0, :] == arrow_color)),\n        \"bottom\": int(np.sum(grid[h - 1, :] == arrow_color)),\n    }\n    priority = [\"right\", \"left\", \"top\", \"bottom\"]\n    chosen_side = max(priority, key=lambda s: (side_counts[s], -priority.index(s)))\n    if side_counts[chosen_side] == 0:\n        nonzero = [s for s in side_counts if side_counts[s] > 0]\n        if nonzero:\n            chosen_side = max(nonzero, key=side_counts.get)\n\n    if chosen_side == \"right\":\n        return (0, -1)\n    if chosen_side == \"left\":\n        return (0, 1)\n    if chosen_side == \"top\":\n        return (1, 0)\n    return (-1, 0)\n\n\ndef _find_symmetry_axis(\n    grid: np.ndarray,\n    fg_color: int,\n    _bg_color: int,\n) -> Tuple[str, int]:\n    h, w = grid.shape\n    pts = np.argwhere(grid == fg_color)\n    if len(pts) == 0:\n        return \"v\", w - 1\n\n    def score_axis(orientation: str, a2: int) -> Tuple[int, int, int, int]:\n        bad = 0\n        good = 0\n        valid = 0\n        for r, c in pts:\n            if orientation == \"v\":\n                mr, mc = r, a2 - c\n            else:\n                mr, mc = a2 - r, c\n            if 0 <= mr < h and 0 <= mc < w:\n                valid += 1\n                if grid[mr, mc] == fg_color:\n                    good += 1\n                else:\n                    bad += 1\n        if valid == 0:\n            return (10**9, -10**9, 10**9, 10**9)\n        # Prefer fewer defects, more matches, more mirrored coverage, and near center.\n        mid = (w - 1) if orientation == \"v\" else (h - 1)\n        return (bad, -good, -valid, abs(a2 - mid))\n\n    best = (10**9, -10**9, 10**9, 10**9)\n    best_axis = (\"v\", w - 1)\n    for orient, span in ((\"v\", w), (\"h\", h)):\n        lo, hi = 1, 2 * span - 3\n        for a2 in range(lo, hi + 1):\n            sc = score_axis(orient, a2)\n            if sc < best:\n                best = sc\n                best_axis = (orient, a2)\n\n    return best_axis\n\n\ndef _find_defects(grid: np.ndarray, fg_color: int, orientation: str, a2: int) -> List[Tuple[int, int]]:\n    h, w = grid.shape\n    defects: List[Tuple[int, int]] = []\n    for r, c in np.argwhere(grid == fg_color):\n        if orientation == \"v\":\n            mr, mc = r, a2 - c\n        else:\n            mr, mc = a2 - r, c\n        if not (0 <= mr < h and 0 <= mc < w):\n            continue\n        if (mr == r and mc == c) or grid[mr, mc] == fg_color:\n            continue\n        defects.append((int(r), int(c)))\n    return defects\n\n\ndef _mirror_pos(orientation: str, a2: int, r: int, c: int) -> Tuple[int, int]:\n    if orientation == \"v\":\n        return r, a2 - c\n    return a2 - r, c\n\n\ndef _draw_symmetric_pattern(\n    grid: np.ndarray,\n    fg_color: int,\n    orientation: str,\n    a2: int,\n    side_choice: str,\n) -> None:\n    h, w = grid.shape\n    n_shapes = random.randint(3, 7)\n    for _ in range(n_shapes):\n        rr = random.randint(2, h - 3)\n        cc = random.randint(1, max(2, w - 3))\n        sh = random.randint(1, 4)\n        sw = random.randint(1, 4)\n\n        if orientation == \"v\":\n            if a2 % 2 == 0:\n                axis_col = a2 // 2\n                if side_choice == \"negative\":\n                    lo = 2\n                    hi = max(lo, axis_col - 2)\n                else:\n                    lo = min(axis_col + 2, w - 3)\n                    hi = w - 3\n            else:\n                axis_split = a2 // 2\n                if side_choice == \"negative\":\n                    lo = 2\n                    hi = max(lo, axis_split)\n                else:\n                    lo = min(axis_split + 1, w - 3)\n                    hi = w - 3\n        else:\n            if a2 % 2 == 0:\n                axis_row = a2 // 2\n                if side_choice == \"negative\":\n                    lo = 2\n                    hi = max(lo, axis_row - 2)\n                else:\n                    lo = min(axis_row + 2, h - 3)\n                    hi = h - 3\n            else:\n                axis_split = a2 // 2\n                if side_choice == \"negative\":\n                    lo = 2\n                    hi = max(lo, axis_split)\n                else:\n                    lo = min(axis_split + 1, h - 3)\n                    hi = h - 3\n\n        if side_choice == \"negative\":\n            cc = random.randint(lo, hi)\n            rr = random.randint(2, h - 3)\n            r0 = random.randint(max(2, rr - sh + 1), min(h - 3, rr + sh))\n            c0 = random.randint(max(2, cc - sw + 1), min((w - 3 if orientation == \"v\" else w - 2), cc + sw))\n            r1 = r0 + random.randint(1, 4)\n            c1 = c0 + random.randint(1, 4)\n            for r in range(r0, min(h - 1, r1)):\n                for c in range(c0, min(w - 1, c1)):\n                    if random.random() < 0.75:\n                        grid[r, c] = fg_color\n                        mr, mc = _mirror_pos(orientation, a2, r, c)\n                        if 0 <= mr < h and 0 <= mc < w:\n                            grid[mr, mc] = fg_color\n        else:\n            cc = random.randint(lo, hi)\n            rr = random.randint(2, h - 3)\n            r0 = random.randint(max(2, rr - sh + 1), min(h - 3, rr + sh))\n            c0 = random.randint(max(2, cc - sw + 1), min((w - 3 if orientation == \"v\" else w - 2), cc + sw))\n            r1 = r0 + random.randint(1, 4)\n            c1 = c0 + random.randint(1, 4)\n            for r in range(r0, min(h - 1, r1)):\n                for c in range(c0, min(w - 1, c1)):\n                    if random.random() < 0.75:\n                        grid[r, c] = fg_color\n                        mr, mc = _mirror_pos(orientation, a2, r, c)\n                        if 0 <= mr < h and 0 <= mc < w:\n                            grid[mr, mc] = fg_color\n\n    # Ensure object is not too tiny.\n    if np.sum(grid == fg_color) < 24:\n        for r in range(2, min(6, h - 2)):\n            for c in range(2, min(6, w - 2)):\n                if random.random() < 0.25:\n                    grid[r, c] = fg_color\n                    mr, mc = _mirror_pos(orientation, a2, r, c)\n                    if 0 <= mr < h and 0 <= mc < w:\n                        grid[mr, mc] = fg_color\n\n\ndef _inject_defects(grid: np.ndarray, fg_color: int, orientation: str, a2: int) -> None:\n    h, w = grid.shape\n    fg_cells = set(map(tuple, np.argwhere(grid == fg_color)))\n    pairs = []\n    for r, c in fg_cells:\n        mr, mc = _mirror_pos(orientation, a2, r, c)\n        if not (0 <= mr < h and 0 <= mc < w):\n            continue\n        if (mr, mc) not in fg_cells:\n            continue\n        if orientation == \"v\" and c < mc:\n            pairs.append((r, c, mr, mc))\n        if orientation == \"h\" and r < mr:\n            pairs.append((r, c, mr, mc))\n\n    if not pairs:\n        return\n\n    random.shuffle(pairs)\n    remove_count = random.randint(1, min(len(pairs), max(1, len(pairs) // 2)))\n    for r1, c1, r2, c2 in pairs[:remove_count]:\n        if random.random() < 0.5:\n            grid[r1, c1] = BG_COLOR\n        else:\n            grid[r2, c2] = BG_COLOR\n\n    # Extra one-side defects add stronger asymmetry signal.\n    if random.random() < 0.4:\n        for r1, c1, r2, c2 in pairs[:2]:\n            if random.random() < 0.5:\n                grid[r1, c1] = BG_COLOR\n            else:\n                grid[r2, c2] = BG_COLOR\n\n\ndef _equal_spaced_indices(count: int, lo: int, hi: int) -> List[int]:\n    lo = max(lo, 0)\n    hi = min(hi, 10_000)\n    if count <= 1:\n        return [random.randint(lo, hi)] if lo <= hi else []\n    if count > (hi - lo + 1):\n        count = max(1, hi - lo + 1)\n    max_step = (hi - lo) // (count - 1)\n    max_step = max(1, max_step)\n    step = random.randint(1, max_step)\n    start_max = hi - step * (count - 1)\n    if start_max < lo:\n        start_max = lo\n    start = random.randint(lo, start_max)\n    return [start + i * step for i in range(count)]\n\n\ndef _place_left_arrows(grid: np.ndarray, arrow_color: int) -> None:\n    h, w = grid.shape\n    if w < 4 or h < 5:\n        return\n    count = random.randint(1, max(1, (h - 6) // 3))\n    rows = _equal_spaced_indices(count, 2, h - 3)\n    for r in rows:\n        if not (1 <= r <= h - 2):\n            continue\n        grid[r, 1] = arrow_color\n        if r - 1 >= 0:\n            grid[r - 1, 0] = arrow_color\n        if r + 1 < h:\n            grid[r + 1, 0] = arrow_color\n\n\ndef _place_right_arrows(grid: np.ndarray, arrow_color: int) -> None:\n    h, w = grid.shape\n    if w < 4 or h < 5:\n        return\n    count = random.randint(1, max(1, (h - 6) // 3))\n    rows = _equal_spaced_indices(count, 2, h - 3)\n    for r in rows:\n        if not (1 <= r <= h - 2):\n            continue\n        grid[r, w - 2] = arrow_color\n        if r - 1 >= 0:\n            grid[r - 1, w - 1] = arrow_color\n        if r + 1 < h:\n            grid[r + 1, w - 1] = arrow_color\n\n\ndef _place_up_arrows(grid: np.ndarray, arrow_color: int) -> None:\n    h, w = grid.shape\n    if w < 5 or h < 4:\n        return\n    count = random.randint(1, max(1, (w - 6) // 3))\n    cols = _equal_spaced_indices(count, 2, w - 3)\n    for c in cols:\n        if not (1 <= c <= w - 2):\n            continue\n        grid[1, c] = arrow_color\n        if c - 1 >= 0:\n            grid[0, c - 1] = arrow_color\n        if c + 1 < w:\n            grid[0, c + 1] = arrow_color\n\n\ndef _place_down_arrows(grid: np.ndarray, arrow_color: int) -> None:\n    h, w = grid.shape\n    if w < 5 or h < 4:\n        return\n    count = random.randint(1, max(1, (w - 6) // 3))\n    cols = _equal_spaced_indices(count, 2, w - 3)\n    for c in cols:\n        if not (1 <= c <= w - 2):\n            continue\n        grid[h - 2, c] = arrow_color\n        if c - 1 >= 0:\n            grid[h - 1, c - 1] = arrow_color\n        if c + 1 < w:\n            grid[h - 1, c + 1] = arrow_color\n\n\n__all__ = [\"main\", \"generate_input\"]\nPY'","aggregated_output":"","exit_code":0,"status":"completed"}}
