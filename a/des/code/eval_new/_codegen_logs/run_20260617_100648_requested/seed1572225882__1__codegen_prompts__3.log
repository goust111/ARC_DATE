{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"mkdir -p /home/lixinyu/snap/a/des/code/eval_new/seed1572225882/1 && cat > /home/lixinyu/snap/a/des/code/eval_new/seed1572225882/1/3.py <<'PY'\n\\\"\\\"\\\"\n按种子与封闭区域边界的距离决定生长方向，并沿该方向逐层展开种子颜色。\n\nInput structure:\n- 背景色为黑色（bg），灰色边界线将网格划分为多个不相连的封闭区域。\n- 每个区域内部是 bg，内部可能分布 1 到 3 个单像素种子。\n- 种子颜色来自固定可见色表（red、blue、green、yellow、orange、magenta、azure、maroon）。\n- 区域外侧可能还有大范围 bg 区域。\n\nRule:\n- 识别灰色边界并找出所有不与边界接触的封闭区域。\n- 每个种子所属区域中分别计算到上、下、左、右边界的最近距离，距离最小者决定生长方向；若平局按 上 > 右 > 下 > 左。\n- 对于每个种子，取其所在行（向上/下生长）或所在列（向左/右生长）在其所属区域中的连续跨度作为每层线段长度。\n- 从第 1 步起，同步逐层沿生长方向推进：每一步用该种子颜色填充对应一整条线段。\n- 如果某一层遇到已有其他种子颜色、边界外或越界，则该种子停止后续扩展。\n- 同一步中多个种子争夺同一像素时，离该像素更近者优先；若距离相同则按颜色顺序（red,blue,green,yellow,orange,magenta,azure,maroon）裁决。\n\nKey insight:\n- 种子并非固定方向生长，而是由其在封闭区域内到四条方向边界的相对位置编码方向；多种子时按层同步扩展即可让“最近、同层平局、颜色次序”自然决定领地边界。\n\\\"\\\"\\\"\n\nfrom collections import deque\nfrom typing import Dict, List, Tuple\n\nimport numpy as np\n\nBG_COLOR = 0\nBOUNDARY_COLOR = 1\nPALETTE = [2, 3, 4, 5, 6, 7, 8, 9]\nCOLOR_RANK = {c: i for i, c in enumerate(PALETTE)}\nDIRS = {\n    \\\"up\\\": (-1, 0),\n    \\\"right\\\": (0, 1),\n    \\\"down\\\": (1, 0),\n    \\\"left\\\": (0, -1),\n}\nDIR_ORDER = [\\\"up\\\", \\\"right\\\", \\\"down\\\", \\\"left\\\"]\nDIR_INDEX = {name: idx for idx, name in enumerate(DIR_ORDER)}\nDIR_NAMES = DIR_ORDER\n\n\ndef _color_rank(color: int) -> int:\n    return COLOR_RANK.get(int(color), len(PALETTE) + int(color))\n\n\ndef _inside(h: int, w: int, r: int, c: int) -> bool:\n    return 0 <= r < h and 0 <= c < w\n\n\ndef _collect_components(grid: np.ndarray, blocked: np.ndarray) -> Tuple[np.ndarray, List[Dict[str, object]]]:\n    h, w = grid.shape\n    comp_id = np.full((h, w), -1, dtype=np.int32)\n    comps: List[Dict[str, object]] = []\n    cid = 0\n\n    for r in range(h):\n        for c in range(w):\n            if blocked[r, c] or comp_id[r, c] \"'!= -1:\n                continue\n            q = deque([(r, c)])\n            comp_id[r, c] = cid\n            cells = [(r, c)]\n            touches = r in (0, h - 1) or c in (0, w - 1)\n\n            while q:\n                cr, cc = q.popleft()\n                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nr, nc = cr + dr, cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and not blocked[nr, nc] and comp_id[nr, nc] == -1:\n                        comp_id[nr, nc] = cid\n                        touches = touches or nr in (0, h - 1) or nc in (0, w - 1)\n                        q.append((nr, nc))\n                        cells.append((nr, nc))\n\n            comps.append({\"id\": cid, \"cells\": cells, \"touches_border\": touches})\n            cid += 1\n\n    return comp_id, comps\n\n\ndef _direction_from_seed(r: int, c: int, comp_id: np.ndarray, cid: int, h: int, w: int) -> str:\n    dists = []\n\n    # 上\n    d = 0\n    rr = r - 1\n    while _inside(h, w, rr, c) and comp_id[rr, c] == cid:\n        d += 1\n        rr -= 1\n    dists.append(d)\n\n    # 右\n    d = 0\n    cc = c + 1\n    while _inside(h, w, r, cc) and comp_id[r, cc] == cid:\n        d += 1\n        cc += 1\n    dists.append(d)\n\n    # 下\n    d = 0\n    rr = r + 1\n    while _inside(h, w, rr, c) and comp_id[rr, c] == cid:\n        d += 1\n        rr += 1\n    dists.append(d)\n\n    # 左\n    d = 0\n    cc = c - 1\n    while _inside(h, w, r, cc) and comp_id[r, cc] == cid:\n        d += 1\n        cc -= 1\n    dists.append(d)\n\n    best_idx = min(range(4), key=lambda i: (dists[i], [0, 1, 2, 3][i]))\n    return DIR_NAMES[best_idx]\n\n\ndef _row_span(r: int, c: int, comp_id: np.ndarray, cid: int, cmin: int, cmax: int) -> Tuple[int, int]:\n    cc1 = c\n    while cc1 - 1 >= cmin and comp_id[r, cc1 - 1] == cid:\n        cc1 -= 1\n    cc2 = c\n    while cc2 + 1 <= cmax and comp_id[r, cc2 + 1] == cid:\n        cc2 += 1\n    return cc1, cc2\n\n\ndef _col_span(r: int, c: int, comp_id: np.ndarray, cid: int, rmin: int, rmax: int) -> Tuple[int, int]:\n    rr1 = r\n    while rr1 - 1 >= rmin and comp_id[rr1 - 1, c] == cid:\n        rr1 -= 1\n    rr2 = r\n    while rr2 + 1 <= rmax and comp_id[rr2 + 1, c] == cid:\n        rr2 += 1\n    return rr1, rr2\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    grid = np.array(grid)\n    if grid.ndim != 2:\n        return grid.copy()\n\n    h, w = grid.shape\n    output = grid.copy()\n\n    # Identify background and boundary color.\n    vals, counts = np.unique(grid, return_counts=True)\n    bg = int(vals[np.argmax(counts)])\n\n    non_bg_mask = grid != bg\n    if not np.any(non_bg_mask):\n        return output\n\n    non_bg_colors, non_bg_counts = np.unique(grid[non_bg_mask], return_counts=True)\n    boundary_color = int(non_bg_colors[np.argmax(non_bg_counts)])\n\n    comp_id, comps = _collect_components(grid, grid == boundary_color)\n\n    inside_regions = set()\n    for comp in comps:\n        if not comp[\"touches_border\"]:\n            for r0, c0 in comp[\"cells\"]:\n                inside_regions.add(comp[\"id\"])\n            break\n\n    seed_cells = []\n    for r in range(h):\n        for c in range(w):\n            col = int(grid[r, c])\n            if col != bg and col != boundary_color:\n                rid = comp_id[r, c]\n                if rid in inside_regions:\n                    seed_cells.append((r, c, col, rid))\n\n    if not seed_cells:\n        return output\n\n    # Map region id -> seeds\n    by_region: Dict[int, List[Tuple[int, int, int]]] = {}\n    for r, c, col, rid in seed_cells:\n        by_region.setdefault(rid, []).append((r, c, col))\n\n    # Precompute bounds per component for span extension.\n    comp_bounds: Dict[int, Tuple[int, int, int, int]] = {}\n    for comp in comps:\n        if comp[\"touches_border\"]:\n            continue\n        rid = comp[\"id\"]\n        rs = [p[0] for p in comp[\"cells\"]]\n        cs = [p[1] for p in comp[\"cells\"]]\n        comp_bounds[rid] = (min(rs), max(rs), min(cs), max(cs))\n\n    seed_info = []\n    for rid, seeds in by_region.items():\n        rmin, rmax, cmin, cmax = comp_bounds[rid]\n        for r, c, col in seeds:\n            direction = _direction_from_seed(r, c, comp_id, rid, h, w)\n            if direction in (\"up\", \"down\"):\n                c1, c2 = _row_span(r, c, comp_id, rid, cmin, cmax)\n                if c1 <= c2:\n                    seed_info.append({\"r\": r, \"c\": c, \"color\": col, \"rid\": rid, \"dir\": direction, \"span\": (c1, c2)})\n            else:\n                r1, r2 = _col_span(r, c, comp_id, rid, rmin, rmax)\n                if r1 <= r2:\n                    seed_info.append({\"r\": r, \"c\": c, \"color\": col, \"rid\": rid, \"dir\": direction, \"span\": (r1, r2)})\n\n    if not seed_info:\n        return output\n\n    active = set(range(len(seed_info)))\n\n    for step in range(1, max(h, w) + 1):\n        if not active:\n            break\n\n        proposals: Dict[int, List[Tuple[int, int]]] = {}\n        blocked_this_round = set()\n\n        for idx in list(active):\n            info = seed_info[idx]\n            rid = info[\"rid\"]\n            col = info[\"color\"]\n            direction = info[\"dir\"]\n            r0 = info[\"r\"]\n            c0 = info[\"c\"]\n\n            cells: List[Tuple[int, int]] = []\n            valid = True\n\n            if direction == \"up\":\n                dr, dc = DIRS[\"up\"]\n                rr = r0 + dr * step\n                c_start, c_end = info[\"span\"]\n                for cc in range(c_start, c_end + 1):\n                    if not (0 <= rr < h and 0 <= cc < w):\n                        valid = False\n                        break\n                    if comp_id[rr, cc] != rid:\n                        valid = False\n                        break\n                    cells.append((rr, cc))\n            elif direction == \"down\":\n                dr, dc = DIRS[\"down\"]\n                rr = r0 + dr * step\n                c_start, c_end = info[\"span\"]\n                for cc in range(c_start, c_end + 1):\n                    if not (0 <= rr < h and 0 <= cc < w):\n                        valid = False\n                        break\n                    if comp_id[rr, cc] != rid:\n                        valid = False\n                        break\n                    cells.append((rr, cc))\n            elif direction == \"left\":\n                dr, dc = DIRS[\"left\"]\n                cc = c0 + dc * step\n                r_start, r_end = info[\"span\"]\n                for rr in range(r_start, r_end + 1):\n                    if not (0 <= rr < h and 0 <= cc < w):\n                        valid = False\n                        break\n                    if comp_id[rr, cc] != rid:\n                        valid = False\n                        break\n                    cells.append((rr, cc))\n            else:\n                dr, dc = DIRS[\"right\"]\n                cc = c0 + dc * step\n                r_start, r_end = info[\"span\"]\n                for rr in range(r_start, r_end + 1):\n                    if not (0 <= rr < h and 0 <= cc < w):\n                        valid = False\n                        break\n                    if comp_id[rr, cc] != rid:\n                        valid = False\n                        break\n                    cells.append((rr, cc))\n\n            if not valid:\n                active.discard(idx)\n                continue\n\n            # 已占用（边界或其他已生长种子）阻挡该种子继续生长。\n            for rr, cc in cells:\n                if output[rr, cc] != bg:\n                    valid = False\n                    break\n\n            if not valid:\n                active.discard(idx)\n                continue\n\n            proposals[idx] = cells\n            for cell in cells:\n                blocked_this_round.add(cell)\n\n        if not proposals:\n            break\n\n        cell_to_seed: Dict[Tuple[int, int], List[Tuple[int, int]]] = {}\n        for idx, cells in proposals.items():\n            for cell in cells:\n                cell_to_seed.setdefault(cell, []).append(idx)\n\n        winner_cells: Dict[int, List[Tuple[int, int]]] = {idx: [] for idx in proposals}\n        losers = set()\n\n        for cell, idxs in cell_to_seed.items():\n            if len(idxs) == 1:\n                winner_cells[idxs[0]].append(cell)\n            else:\n                # 同一步内距离相同，按色序裁决。\n                rr = sorted(idxs, key=lambda k: (_color_rank(seed_info[k][\"color\"])))\n                winner = rr[0]\n                winner_cells[winner].append(cell)\n                for loser in idxs:\n                    if loser != winner:\n                        losers.add(loser)\n\n        # 应用胜出像素。\n        for idx in list(proposals):\n            if idx in losers:\n                active.discard(idx)\n                continue\n            col = seed_info[idx][\"color\"]\n            for rr, cc in winner_cells[idx]:\n                output[rr, cc] = col\n\n    return output\n\n\ndef _find_regions(grid: np.ndarray, boundary_color: int) -> Tuple[np.ndarray, List[Dict[str, object]]]:\n    return _collect_components(grid, grid == boundary_color)\n\n\ndef _draw_region_box(grid: np.ndarray, reserved: np.ndarray, rng: np.random.Generator, h: int, w: int) -> bool:\n    max_inner_h = min(10, h - 6)\n    max_inner_w = min(10, w - 6)\n    if max_inner_h < 4 or max_inner_w < 4:\n        return False\n\n    inner_h = int(rng.integers(4, max_inner_h + 1))\n    inner_w = int(rng.integers(4, max_inner_w + 1))\n    outer_h = inner_h + 2\n    outer_w = inner_w + 2\n    if h - outer_h - 1 <= 1 or w - outer_w - 1 <= 1:\n        return False\n\n    r0 = int(rng.integers(1, h - outer_h - 1))\n    c0 = int(rng.integers(1, w - outer_w - 1))\n    r1 = r0 + outer_h - 1\n    c1 = c0 + outer_w - 1\n\n    if reserved[r0 - 1 : r1 + 2, c0 - 1 : c1 + 2].any():\n        return False\n\n    grid[r0, c0 : c1 + 1] = BOUNDARY_COLOR\n    grid[r1, c0 : c1 + 1] = BOUNDARY_COLOR\n    grid[r0:r1 + 1, c0] = BOUNDARY_COLOR\n    grid[r0:r1 + 1, c1] = BOUNDARY_COLOR\n\n    # 简单的不规则边界：随机向内延伸一两个“短齿”使外形更有变化。\n    for _ in range(int(rng.integers(0, 3))):\n        side = int(rng.integers(0, 4))\n        depth = int(rng.integers(1, 3))\n        if side in (0, 2):\n            # top / bottom\n            y = r0 + (1 if side == 0 else -1)\n            if side == 2:\n                y = r1 - 1\n            x0 = int(rng.integers(c0 + 1, c1 - 1))\n            span = int(rng.integers(1, min(4, max(2, outer_w // 3)) + 1))\n            for x in range(x0, min(x0 + span, c1)):\n                for d in range(1, depth + 1):\n                    rr = (r0 + d) if side == 0 else (r1 - d)\n                    if 0 <= rr < h:\n                        grid[rr, x] = BOUNDARY_COLOR\n        else:\n            # left / right\n            x = c0 + (1 if side == 3 else -1)\n            if side == 1:\n                x = c1 - 1\n            y0 = int(rng.integers(r0 + 1, r1 - 1))\n            span = int(rng.integers(1, min(4, max(2, outer_h // 3)) + 1))\n            for y in range(y0, min(y0 + span, r1)):\n                for d in range(1, depth + 1):\n                    cc = (c0 + d) if side == 3 else (c1 - d)\n                    if 0 <= cc < w:\n                        grid[y, cc] = BOUNDARY_COLOR\n\n    reserved[r0 - 1 : r1 + 2, c0 - 1 : c1 + 2] = True\n    return True\n\n\ndef _determine_target_direction(rng: np.random.Generator) -> str:\n    return DIR_NAMES[int(rng.integers(0, 4))]\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n\n    for _ in range(1000):\n        h = int(rng.integers(16, 30))\n        w = int(rng.integers(16, 30))\n        grid = np.full((h, w), BG_COLOR, dtype=np.int64)\n        reserved = np.zeros((h, w), dtype=bool)\n\n        target_regions = int(rng.integers(2, 6))\n        count = 0\n        for _ in range(200):\n            if count >= target_regions:\n                break\n            if _draw_region_box(grid, reserved, rng, h, w):\n                count += 1\n\n        if count != target_regions:\n            continue\n\n        _, comps = _find_regions(grid, BOUNDARY_COLOR)\n        inner = [c for c in comps if not c[\"touches_border\"]]\n        if len(inner) != target_regions:\n            continue\n\n        inner = sorted(inner, key=lambda x: len(x[\"cells\"]))\n\n        # 需要给每个封闭区域至少一个种子，且每个区域种子数在 1~3。\n        ok = True\n        comp_id, comps = _collect_components(grid, grid == BOUNDARY_COLOR)\n        comp_ids = {comp[\"id\"] for comp in comps if not comp[\"touches_border\"]}\n\n        if len(comp_ids) != target_regions:\n            continue\n\n        for comp in comps:\n            if comp[\"touches_border\"]:\n                continue\n            if len(comp[\"cells\"]) < 9:\n                ok = False\n                break\n\n        if not ok:\n            continue\n\n        for rid in comp_ids:\n            cells = next(comp[\"cells\"] for comp in comps if comp[\"id\"] == rid)\n            cells_list = cells\n            if not cells_list:\n                ok = False\n                break\n\n            num_seeds = int(rng.choice([1, 2, 3]))\n            used_colors = set()\n            target_dirs = [_determine_target_direction(rng) for _ in range(num_seeds)]\n\n            for target_dir in target_dirs:\n                placed = False\n                for _ in range(80):\n                    r, c = cells_list[int(rng.integers(0, len(cells_list)))]\n                    if grid[r, c] != BG_COLOR:\n                        continue\n                    rr, cc = int(r), int(c)\n                    d = _direction_from_seed(rr, cc, comp_id, rid, h, w)\n                    if d != target_dir:\n                        continue\n                    available = [c_ for c_ in PALETTE if c_ not in used_colors]\n                    if not available:\n                        available = list(PALETTE)\n                    color = int(rng.choice(available))\n                    used_colors.add(color)\n                    grid[r, c] = color\n                    placed = True\n                    break\n                if not placed:\n                    # 降级到任意可用位置，确保样例仍可生成。\n                    attempts = [p for p in cells_list if grid[p[0], p[1]] == BG_COLOR]\n                    if not attempts:\n                        ok = False\n                        break\n                    rr, cc = attempts[0]\n                    available = [c_ for c_ in PALETTE if c_ not in used_colors]\n                    if not available:\n                        available = list(PALETTE)\n                    color = int(rng.choice(available))\n                    used_colors.add(color)\n                    grid[rr, cc] = color\n            if not ok:\n                break\n\n        if not ok:\n            continue\n\n        # 快速检查：每个区域都有1~3个种子且颜色不重复。\n        for comp in comps:\n            if comp[\"touches_border\"]:\n                continue\n            rid = comp[\"id\"]\n            colors = []\n            for r, c in comp[\"cells\"]:\n                v = int(grid[r, c])\n                if v not in (BG_COLOR, BOUNDARY_COLOR):\n                    colors.append(v)\n            if not (1 <= len(colors) <= 3):\n                ok = False\n                break\n            if len(colors) != len(set(colors)):\n                ok = False\n                break\n\n        if not ok:\n            continue\n\n        return grid\n\n    # 兜底：返回一个最小可运行样例。\n    h = 18\n    w = 18\n    grid = np.full((h, w), BG_COLOR, dtype=np.int64)\n    grid[2, 2 : w - 2] = BOUNDARY_COLOR\n    grid[h - 3, 2 : w - 2] = BOUNDARY_COLOR\n    grid[2 : h - 2, 2] = BOUNDARY_COLOR\n    grid[2 : h - 2, w - 3] = BOUNDARY_COLOR\n    grid[8, 8] = PALETTE[0]\n    grid[9, 13] = PALETTE[1]\n    return grid\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"mkdir -p /home/lixinyu/snap/a/des/code/eval_new/seed1572225882/1 && cat > /home/lixinyu/snap/a/des/code/eval_new/seed1572225882/1/3.py <<'PY'\n\\\"\\\"\\\"\n按种子与封闭区域边界的距离决定生长方向，并沿该方向逐层展开种子颜色。\n\nInput structure:\n- 背景色为黑色（bg），灰色边界线将网格划分为多个不相连的封闭区域。\n- 每个区域内部是 bg，内部可能分布 1 到 3 个单像素种子。\n- 种子颜色来自固定可见色表（red、blue、green、yellow、orange、magenta、azure、maroon）。\n- 区域外侧可能还有大范围 bg 区域。\n\nRule:\n- 识别灰色边界并找出所有不与边界接触的封闭区域。\n- 每个种子所属区域中分别计算到上、下、左、右边界的最近距离，距离最小者决定生长方向；若平局按 上 > 右 > 下 > 左。\n- 对于每个种子，取其所在行（向上/下生长）或所在列（向左/右生长）在其所属区域中的连续跨度作为每层线段长度。\n- 从第 1 步起，同步逐层沿生长方向推进：每一步用该种子颜色填充对应一整条线段。\n- 如果某一层遇到已有其他种子颜色、边界外或越界，则该种子停止后续扩展。\n- 同一步中多个种子争夺同一像素时，离该像素更近者优先；若距离相同则按颜色顺序（red,blue,green,yellow,orange,magenta,azure,maroon）裁决。\n\nKey insight:\n- 种子并非固定方向生长，而是由其在封闭区域内到四条方向边界的相对位置编码方向；多种子时按层同步扩展即可让“最近、同层平局、颜色次序”自然决定领地边界。\n\\\"\\\"\\\"\n\nfrom collections import deque\nfrom typing import Dict, List, Tuple\n\nimport numpy as np\n\nBG_COLOR = 0\nBOUNDARY_COLOR = 1\nPALETTE = [2, 3, 4, 5, 6, 7, 8, 9]\nCOLOR_RANK = {c: i for i, c in enumerate(PALETTE)}\nDIRS = {\n    \\\"up\\\": (-1, 0),\n    \\\"right\\\": (0, 1),\n    \\\"down\\\": (1, 0),\n    \\\"left\\\": (0, -1),\n}\nDIR_ORDER = [\\\"up\\\", \\\"right\\\", \\\"down\\\", \\\"left\\\"]\nDIR_INDEX = {name: idx for idx, name in enumerate(DIR_ORDER)}\nDIR_NAMES = DIR_ORDER\n\n\ndef _color_rank(color: int) -> int:\n    return COLOR_RANK.get(int(color), len(PALETTE) + int(color))\n\n\ndef _inside(h: int, w: int, r: int, c: int) -> bool:\n    return 0 <= r < h and 0 <= c < w\n\n\ndef _collect_components(grid: np.ndarray, blocked: np.ndarray) -> Tuple[np.ndarray, List[Dict[str, object]]]:\n    h, w = grid.shape\n    comp_id = np.full((h, w), -1, dtype=np.int32)\n    comps: List[Dict[str, object]] = []\n    cid = 0\n\n    for r in range(h):\n        for c in range(w):\n            if blocked[r, c] or comp_id[r, c] \"'!= -1:\n                continue\n            q = deque([(r, c)])\n            comp_id[r, c] = cid\n            cells = [(r, c)]\n            touches = r in (0, h - 1) or c in (0, w - 1)\n\n            while q:\n                cr, cc = q.popleft()\n                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nr, nc = cr + dr, cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and not blocked[nr, nc] and comp_id[nr, nc] == -1:\n                        comp_id[nr, nc] = cid\n                        touches = touches or nr in (0, h - 1) or nc in (0, w - 1)\n                        q.append((nr, nc))\n                        cells.append((nr, nc))\n\n            comps.append({\"id\": cid, \"cells\": cells, \"touches_border\": touches})\n            cid += 1\n\n    return comp_id, comps\n\n\ndef _direction_from_seed(r: int, c: int, comp_id: np.ndarray, cid: int, h: int, w: int) -> str:\n    dists = []\n\n    # 上\n    d = 0\n    rr = r - 1\n    while _inside(h, w, rr, c) and comp_id[rr, c] == cid:\n        d += 1\n        rr -= 1\n    dists.append(d)\n\n    # 右\n    d = 0\n    cc = c + 1\n    while _inside(h, w, r, cc) and comp_id[r, cc] == cid:\n        d += 1\n        cc += 1\n    dists.append(d)\n\n    # 下\n    d = 0\n    rr = r + 1\n    while _inside(h, w, rr, c) and comp_id[rr, c] == cid:\n        d += 1\n        rr += 1\n    dists.append(d)\n\n    # 左\n    d = 0\n    cc = c - 1\n    while _inside(h, w, r, cc) and comp_id[r, cc] == cid:\n        d += 1\n        cc -= 1\n    dists.append(d)\n\n    best_idx = min(range(4), key=lambda i: (dists[i], [0, 1, 2, 3][i]))\n    return DIR_NAMES[best_idx]\n\n\ndef _row_span(r: int, c: int, comp_id: np.ndarray, cid: int, cmin: int, cmax: int) -> Tuple[int, int]:\n    cc1 = c\n    while cc1 - 1 >= cmin and comp_id[r, cc1 - 1] == cid:\n        cc1 -= 1\n    cc2 = c\n    while cc2 + 1 <= cmax and comp_id[r, cc2 + 1] == cid:\n        cc2 += 1\n    return cc1, cc2\n\n\ndef _col_span(r: int, c: int, comp_id: np.ndarray, cid: int, rmin: int, rmax: int) -> Tuple[int, int]:\n    rr1 = r\n    while rr1 - 1 >= rmin and comp_id[rr1 - 1, c] == cid:\n        rr1 -= 1\n    rr2 = r\n    while rr2 + 1 <= rmax and comp_id[rr2 + 1, c] == cid:\n        rr2 += 1\n    return rr1, rr2\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    grid = np.array(grid)\n    if grid.ndim != 2:\n        return grid.copy()\n\n    h, w = grid.shape\n    output = grid.copy()\n\n    # Identify background and boundary color.\n    vals, counts = np.unique(grid, return_counts=True)\n    bg = int(vals[np.argmax(counts)])\n\n    non_bg_mask = grid != bg\n    if not np.any(non_bg_mask):\n        return output\n\n    non_bg_colors, non_bg_counts = np.unique(grid[non_bg_mask], return_counts=True)\n    boundary_color = int(non_bg_colors[np.argmax(non_bg_counts)])\n\n    comp_id, comps = _collect_components(grid, grid == boundary_color)\n\n    inside_regions = set()\n    for comp in comps:\n        if not comp[\"touches_border\"]:\n            for r0, c0 in comp[\"cells\"]:\n                inside_regions.add(comp[\"id\"])\n            break\n\n    seed_cells = []\n    for r in range(h):\n        for c in range(w):\n            col = int(grid[r, c])\n            if col != bg and col != boundary_color:\n                rid = comp_id[r, c]\n                if rid in inside_regions:\n                    seed_cells.append((r, c, col, rid))\n\n    if not seed_cells:\n        return output\n\n    # Map region id -> seeds\n    by_region: Dict[int, List[Tuple[int, int, int]]] = {}\n    for r, c, col, rid in seed_cells:\n        by_region.setdefault(rid, []).append((r, c, col))\n\n    # Precompute bounds per component for span extension.\n    comp_bounds: Dict[int, Tuple[int, int, int, int]] = {}\n    for comp in comps:\n        if comp[\"touches_border\"]:\n            continue\n        rid = comp[\"id\"]\n        rs = [p[0] for p in comp[\"cells\"]]\n        cs = [p[1] for p in comp[\"cells\"]]\n        comp_bounds[rid] = (min(rs), max(rs), min(cs), max(cs))\n\n    seed_info = []\n    for rid, seeds in by_region.items():\n        rmin, rmax, cmin, cmax = comp_bounds[rid]\n        for r, c, col in seeds:\n            direction = _direction_from_seed(r, c, comp_id, rid, h, w)\n            if direction in (\"up\", \"down\"):\n                c1, c2 = _row_span(r, c, comp_id, rid, cmin, cmax)\n                if c1 <= c2:\n                    seed_info.append({\"r\": r, \"c\": c, \"color\": col, \"rid\": rid, \"dir\": direction, \"span\": (c1, c2)})\n            else:\n                r1, r2 = _col_span(r, c, comp_id, rid, rmin, rmax)\n                if r1 <= r2:\n                    seed_info.append({\"r\": r, \"c\": c, \"color\": col, \"rid\": rid, \"dir\": direction, \"span\": (r1, r2)})\n\n    if not seed_info:\n        return output\n\n    active = set(range(len(seed_info)))\n\n    for step in range(1, max(h, w) + 1):\n        if not active:\n            break\n\n        proposals: Dict[int, List[Tuple[int, int]]] = {}\n        blocked_this_round = set()\n\n        for idx in list(active):\n            info = seed_info[idx]\n            rid = info[\"rid\"]\n            col = info[\"color\"]\n            direction = info[\"dir\"]\n            r0 = info[\"r\"]\n            c0 = info[\"c\"]\n\n            cells: List[Tuple[int, int]] = []\n            valid = True\n\n            if direction == \"up\":\n                dr, dc = DIRS[\"up\"]\n                rr = r0 + dr * step\n                c_start, c_end = info[\"span\"]\n                for cc in range(c_start, c_end + 1):\n                    if not (0 <= rr < h and 0 <= cc < w):\n                        valid = False\n                        break\n                    if comp_id[rr, cc] != rid:\n                        valid = False\n                        break\n                    cells.append((rr, cc))\n            elif direction == \"down\":\n                dr, dc = DIRS[\"down\"]\n                rr = r0 + dr * step\n                c_start, c_end = info[\"span\"]\n                for cc in range(c_start, c_end + 1):\n                    if not (0 <= rr < h and 0 <= cc < w):\n                        valid = False\n                        break\n                    if comp_id[rr, cc] != rid:\n                        valid = False\n                        break\n                    cells.append((rr, cc))\n            elif direction == \"left\":\n                dr, dc = DIRS[\"left\"]\n                cc = c0 + dc * step\n                r_start, r_end = info[\"span\"]\n                for rr in range(r_start, r_end + 1):\n                    if not (0 <= rr < h and 0 <= cc < w):\n                        valid = False\n                        break\n                    if comp_id[rr, cc] != rid:\n                        valid = False\n                        break\n                    cells.append((rr, cc))\n            else:\n                dr, dc = DIRS[\"right\"]\n                cc = c0 + dc * step\n                r_start, r_end = info[\"span\"]\n                for rr in range(r_start, r_end + 1):\n                    if not (0 <= rr < h and 0 <= cc < w):\n                        valid = False\n                        break\n                    if comp_id[rr, cc] != rid:\n                        valid = False\n                        break\n                    cells.append((rr, cc))\n\n            if not valid:\n                active.discard(idx)\n                continue\n\n            # 已占用（边界或其他已生长种子）阻挡该种子继续生长。\n            for rr, cc in cells:\n                if output[rr, cc] != bg:\n                    valid = False\n                    break\n\n            if not valid:\n                active.discard(idx)\n                continue\n\n            proposals[idx] = cells\n            for cell in cells:\n                blocked_this_round.add(cell)\n\n        if not proposals:\n            break\n\n        cell_to_seed: Dict[Tuple[int, int], List[Tuple[int, int]]] = {}\n        for idx, cells in proposals.items():\n            for cell in cells:\n                cell_to_seed.setdefault(cell, []).append(idx)\n\n        winner_cells: Dict[int, List[Tuple[int, int]]] = {idx: [] for idx in proposals}\n        losers = set()\n\n        for cell, idxs in cell_to_seed.items():\n            if len(idxs) == 1:\n                winner_cells[idxs[0]].append(cell)\n            else:\n                # 同一步内距离相同，按色序裁决。\n                rr = sorted(idxs, key=lambda k: (_color_rank(seed_info[k][\"color\"])))\n                winner = rr[0]\n                winner_cells[winner].append(cell)\n                for loser in idxs:\n                    if loser != winner:\n                        losers.add(loser)\n\n        # 应用胜出像素。\n        for idx in list(proposals):\n            if idx in losers:\n                active.discard(idx)\n                continue\n            col = seed_info[idx][\"color\"]\n            for rr, cc in winner_cells[idx]:\n                output[rr, cc] = col\n\n    return output\n\n\ndef _find_regions(grid: np.ndarray, boundary_color: int) -> Tuple[np.ndarray, List[Dict[str, object]]]:\n    return _collect_components(grid, grid == boundary_color)\n\n\ndef _draw_region_box(grid: np.ndarray, reserved: np.ndarray, rng: np.random.Generator, h: int, w: int) -> bool:\n    max_inner_h = min(10, h - 6)\n    max_inner_w = min(10, w - 6)\n    if max_inner_h < 4 or max_inner_w < 4:\n        return False\n\n    inner_h = int(rng.integers(4, max_inner_h + 1))\n    inner_w = int(rng.integers(4, max_inner_w + 1))\n    outer_h = inner_h + 2\n    outer_w = inner_w + 2\n    if h - outer_h - 1 <= 1 or w - outer_w - 1 <= 1:\n        return False\n\n    r0 = int(rng.integers(1, h - outer_h - 1))\n    c0 = int(rng.integers(1, w - outer_w - 1))\n    r1 = r0 + outer_h - 1\n    c1 = c0 + outer_w - 1\n\n    if reserved[r0 - 1 : r1 + 2, c0 - 1 : c1 + 2].any():\n        return False\n\n    grid[r0, c0 : c1 + 1] = BOUNDARY_COLOR\n    grid[r1, c0 : c1 + 1] = BOUNDARY_COLOR\n    grid[r0:r1 + 1, c0] = BOUNDARY_COLOR\n    grid[r0:r1 + 1, c1] = BOUNDARY_COLOR\n\n    # 简单的不规则边界：随机向内延伸一两个“短齿”使外形更有变化。\n    for _ in range(int(rng.integers(0, 3))):\n        side = int(rng.integers(0, 4))\n        depth = int(rng.integers(1, 3))\n        if side in (0, 2):\n            # top / bottom\n            y = r0 + (1 if side == 0 else -1)\n            if side == 2:\n                y = r1 - 1\n            x0 = int(rng.integers(c0 + 1, c1 - 1))\n            span = int(rng.integers(1, min(4, max(2, outer_w // 3)) + 1))\n            for x in range(x0, min(x0 + span, c1)):\n                for d in range(1, depth + 1):\n                    rr = (r0 + d) if side == 0 else (r1 - d)\n                    if 0 <= rr < h:\n                        grid[rr, x] = BOUNDARY_COLOR\n        else:\n            # left / right\n            x = c0 + (1 if side == 3 else -1)\n            if side == 1:\n                x = c1 - 1\n            y0 = int(rng.integers(r0 + 1, r1 - 1))\n            span = int(rng.integers(1, min(4, max(2, outer_h // 3)) + 1))\n            for y in range(y0, min(y0 + span, r1)):\n                for d in range(1, depth + 1):\n                    cc = (c0 + d) if side == 3 else (c1 - d)\n                    if 0 <= cc < w:\n                        grid[y, cc] = BOUNDARY_COLOR\n\n    reserved[r0 - 1 : r1 + 2, c0 - 1 : c1 + 2] = True\n    return True\n\n\ndef _determine_target_direction(rng: np.random.Generator) -> str:\n    return DIR_NAMES[int(rng.integers(0, 4))]\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n\n    for _ in range(1000):\n        h = int(rng.integers(16, 30))\n        w = int(rng.integers(16, 30))\n        grid = np.full((h, w), BG_COLOR, dtype=np.int64)\n        reserved = np.zeros((h, w), dtype=bool)\n\n        target_regions = int(rng.integers(2, 6))\n        count = 0\n        for _ in range(200):\n            if count >= target_regions:\n                break\n            if _draw_region_box(grid, reserved, rng, h, w):\n                count += 1\n\n        if count != target_regions:\n            continue\n\n        _, comps = _find_regions(grid, BOUNDARY_COLOR)\n        inner = [c for c in comps if not c[\"touches_border\"]]\n        if len(inner) != target_regions:\n            continue\n\n        inner = sorted(inner, key=lambda x: len(x[\"cells\"]))\n\n        # 需要给每个封闭区域至少一个种子，且每个区域种子数在 1~3。\n        ok = True\n        comp_id, comps = _collect_components(grid, grid == BOUNDARY_COLOR)\n        comp_ids = {comp[\"id\"] for comp in comps if not comp[\"touches_border\"]}\n\n        if len(comp_ids) != target_regions:\n            continue\n\n        for comp in comps:\n            if comp[\"touches_border\"]:\n                continue\n            if len(comp[\"cells\"]) < 9:\n                ok = False\n                break\n\n        if not ok:\n            continue\n\n        for rid in comp_ids:\n            cells = next(comp[\"cells\"] for comp in comps if comp[\"id\"] == rid)\n            cells_list = cells\n            if not cells_list:\n                ok = False\n                break\n\n            num_seeds = int(rng.choice([1, 2, 3]))\n            used_colors = set()\n            target_dirs = [_determine_target_direction(rng) for _ in range(num_seeds)]\n\n            for target_dir in target_dirs:\n                placed = False\n                for _ in range(80):\n                    r, c = cells_list[int(rng.integers(0, len(cells_list)))]\n                    if grid[r, c] != BG_COLOR:\n                        continue\n                    rr, cc = int(r), int(c)\n                    d = _direction_from_seed(rr, cc, comp_id, rid, h, w)\n                    if d != target_dir:\n                        continue\n                    available = [c_ for c_ in PALETTE if c_ not in used_colors]\n                    if not available:\n                        available = list(PALETTE)\n                    color = int(rng.choice(available))\n                    used_colors.add(color)\n                    grid[r, c] = color\n                    placed = True\n                    break\n                if not placed:\n                    # 降级到任意可用位置，确保样例仍可生成。\n                    attempts = [p for p in cells_list if grid[p[0], p[1]] == BG_COLOR]\n                    if not attempts:\n                        ok = False\n                        break\n                    rr, cc = attempts[0]\n                    available = [c_ for c_ in PALETTE if c_ not in used_colors]\n                    if not available:\n                        available = list(PALETTE)\n                    color = int(rng.choice(available))\n                    used_colors.add(color)\n                    grid[rr, cc] = color\n            if not ok:\n                break\n\n        if not ok:\n            continue\n\n        # 快速检查：每个区域都有1~3个种子且颜色不重复。\n        for comp in comps:\n            if comp[\"touches_border\"]:\n                continue\n            rid = comp[\"id\"]\n            colors = []\n            for r, c in comp[\"cells\"]:\n                v = int(grid[r, c])\n                if v not in (BG_COLOR, BOUNDARY_COLOR):\n                    colors.append(v)\n            if not (1 <= len(colors) <= 3):\n                ok = False\n                break\n            if len(colors) != len(set(colors)):\n                ok = False\n                break\n\n        if not ok:\n            continue\n\n        return grid\n\n    # 兜底：返回一个最小可运行样例。\n    h = 18\n    w = 18\n    grid = np.full((h, w), BG_COLOR, dtype=np.int64)\n    grid[2, 2 : w - 2] = BOUNDARY_COLOR\n    grid[h - 3, 2 : w - 2] = BOUNDARY_COLOR\n    grid[2 : h - 2, 2] = BOUNDARY_COLOR\n    grid[2 : h - 2, w - 3] = BOUNDARY_COLOR\n    grid[8, 8] = PALETTE[0]\n    grid[9, 13] = PALETTE[1]\n    return grid\nPY'","aggregated_output":"","exit_code":0,"status":"completed"}}
