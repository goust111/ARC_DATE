{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/train/d93c6891.py | sed -n '1,280p'\"","aggregated_output":"     1\tfrom __future__ import annotations\n     2\t\n     3\timport numpy as np\n     4\t\n     5\tfrom arc_utils import Color, bbox_coords, bbox_h, bbox_w, find_components, neighbors4\n     6\timport random\n     7\t\n     8\t\n     9\tdef _orientation(\n    10\t    coords: np.ndarray,\n    11\t    contacts: list[tuple[int, int, int, int]],\n    12\t) -> str:\n    13\t    r0, c0, r1, c1 = bbox_coords(coords)\n    14\t    h = int(r1 - r0 + 1)\n    15\t    w = int(c1 - c0 + 1)\n    16\t    assert h == 1 or w == 1, \"expected each gray source to be a one-cell-thick bar\"\n    17\t\n    18\t    if h == 1 and w > 1:\n    19\t        return \"horizontal\"\n    20\t    if w == 1 and h > 1:\n    21\t        return \"vertical\"\n    22\t\n    23\t    implied: set[str] = set()\n    24\t    for tr, tc, sr, sc in contacts:\n    25\t        if tr == sr:\n    26\t            implied.add(\"horizontal\")\n    27\t        elif tc == sc:\n    28\t            implied.add(\"vertical\")\n    29\t        else:\n    30\t            raise AssertionError(\"gray source must touch orange by a 4-neighbor side\")\n    31\t    assert len(implied) == 1, \"singleton gray source has ambiguous orientation\"\n    32\t    return implied.pop()\n    33\t\n    34\t\n    35\tdef _fill_rows(\n    36\t    out: np.ndarray,\n    37\t    r0: int,\n    38\t    c0: int,\n    39\t    r1: int,\n    40\t    c1: int,\n    41\t    count: int,\n    42\t    contact_rows: set[int],\n    43\t) -> None:\n    44\t    width = int(c1 - c0 + 1)\n    45\t    height = int(r1 - r0 + 1)\n    46\t    assert count % width == 0, \"gray count must make complete orange rows\"\n    47\t    stripe_count = int(count // width)\n    48\t    assert 0 < stripe_count <= height, \"row fill must fit inside the orange rectangle\"\n    49\t\n    50\t    assert contact_rows in ({r0}, {r1}), \"horizontal bars must touch exactly one extreme row\"\n    51\t    if contact_rows == {r0}:\n    52\t        rows = list(range(r0, r0 + stripe_count))\n    53\t    else:\n    54\t        rows = list(range(r1 - stripe_count + 1, r1 + 1))\n    55\t\n    56\t    out[rows, c0 : c1 + 1] = Color.GRAY\n    57\t\n    58\t\n    59\tdef _fill_cols(\n    60\t    out: np.ndarray,\n    61\t    r0: int,\n    62\t    c0: int,\n    63\t    r1: int,\n    64\t    c1: int,\n    65\t    count: int,\n    66\t    contact_cols: set[int],\n    67\t) -> None:\n    68\t    width = int(c1 - c0 + 1)\n    69\t    height = int(r1 - r0 + 1)\n    70\t    assert count % height == 0, \"gray count must make complete orange columns\"\n    71\t    stripe_count = int(count // height)\n    72\t    assert 0 < stripe_count <= width, \"column fill must fit inside the orange rectangle\"\n    73\t\n    74\t    assert contact_cols in ({c0}, {c1}), \"vertical bars must touch exactly one extreme column\"\n    75\t    if contact_cols == {c0}:\n    76\t        cols = list(range(c0, c0 + stripe_count))\n    77\t    else:\n    78\t        cols = list(range(c1 - stripe_count + 1, c1 + 1))\n    79\t\n    80\t    out[r0 : r1 + 1, cols] = Color.GRAY\n    81\t\n    82\t\n    83\tdef main(grid: np.ndarray) -> np.ndarray:\n    84\t    \"\"\"\n    85\t    Move each gray bar into its adjacent orange rectangle as full stripes from the contacted edge.\n    86\t\n    87\t    Input structure\n    88\t    - The scene uses black outside space, yellow fill, gray one-cell-thick bars, and solid orange rectangles.\n    89\t    - Each gray bar 4-touches exactly one orange rectangle; some orange rectangles have no touching gray bar.\n    90\t    - Gray bars touching the same orange rectangle all have the same orientation.\n    91\t\n    92\t    Rule\n    93\t    - Recolor every original gray cell to yellow.\n    94\t    - For each orange rectangle touched by gray bars, count the gray cells assigned to that rectangle.\n    95\t    - Horizontal gray bars repaint that many cells as complete orange rows starting from the contacted top or bottom row.\n    96\t    - Vertical gray bars repaint that many cells as complete orange columns starting from the contacted left or right column.\n    97\t    - Orange rectangles with no touching gray bar remain unchanged.\n    98\t\n    99\t    Key insight\n   100\t    - The gray pixels are not copied by shape; their count is transferred into the neighboring orange rectangle as edge-aligned row or column stripes.\n   101\t    \"\"\"\n   102\t    g = np.asarray(grid, dtype=int)\n   103\t    assert g.ndim == 2, \"expected a 2D grid\"\n   104\t    assert set(map(int, np.unique(g))) <= {Color.BLACK, Color.YELLOW, Color.GRAY, Color.ORANGE}\n   105\t\n   106\t    orange = find_components(g, bg=Color.YELLOW, colors=[Color.ORANGE], connectivity=4)\n   107\t    gray = find_components(g, bg=Color.YELLOW, colors=[Color.GRAY], connectivity=4)\n   108\t    assert orange and gray, \"expected orange rectangles and gray source bars\"\n   109\t\n   110\t    orange_index: dict[tuple[int, int], int] = {}\n   111\t    orange_bboxes: list[tuple[int, int, int, int]] = []\n   112\t    for i, obj in enumerate(orange):\n   113\t        r0, c0, r1, c1 = obj[\"bbox\"]\n   114\t        assert obj[\"area\"] == bbox_h(obj[\"bbox\"]) * bbox_w(obj[\"bbox\"])\n   115\t        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == Color.ORANGE)\n   116\t        orange_bboxes.append((int(r0), int(c0), int(r1), int(c1)))\n   117\t        for r, c in obj[\"coords\"]:\n   118\t            orange_index[(int(r), int(c))] = i\n   119\t\n   120\t    source_by_target: dict[int, list[tuple[dict, list[tuple[int, int, int, int]]]]] = {}\n   121\t    for src in gray:\n   122\t        touched: dict[int, list[tuple[int, int, int, int]]] = {}\n   123\t        for sr_raw, sc_raw in src[\"coords\"]:\n   124\t            sr = int(sr_raw)\n   125\t            sc = int(sc_raw)\n   126\t            for tr, tc in neighbors4(sr, sc):\n   127\t                target_i = orange_index.get((int(tr), int(tc)))\n   128\t                if target_i is not None:\n   129\t                    touched.setdefault(target_i, []).append((int(tr), int(tc), sr, sc))\n   130\t\n   131\t        assert len(touched) == 1, \"each gray bar must touch exactly one orange rectangle\"\n   132\t        target_i = next(iter(touched))\n   133\t        source_by_target.setdefault(target_i, []).append((src, touched[target_i]))\n   134\t\n   135\t    out = g.copy()\n   136\t    out[g == Color.GRAY] = Color.YELLOW\n   137\t\n   138\t    for target_i, sources in source_by_target.items():\n   139\t        r0, c0, r1, c1 = orange_bboxes[target_i]\n   140\t        orientations = {_orientation(src[\"coords\"], contacts) for src, contacts in sources}\n   141\t        assert len(orientations) == 1, \"all gray bars for one orange rectangle must share orientation\"\n   142\t        count = sum(int(src[\"area\"]) for src, _contacts in sources)\n   143\t        contacts = [contact for _src, src_contacts in sources for contact in src_contacts]\n   144\t\n   145\t        if orientations == {\"horizontal\"}:\n   146\t            contact_rows = {tr for tr, _tc, _sr, _sc in contacts}\n   147\t            assert contact_rows <= {r0, r1}\n   148\t            _fill_rows(out, r0, c0, r1, c1, count, contact_rows)\n   149\t        else:\n   150\t            assert orientations == {\"vertical\"}\n   151\t            contact_cols = {tc for _tr, tc, _sr, _sc in contacts}\n   152\t            assert contact_cols <= {c0, c1}\n   153\t            _fill_cols(out, r0, c0, r1, c1, count, contact_cols)\n   154\t\n   155\t    return out\n   156\t\n   157\t# --------------- generator (att1) ---------------\n   158\t\n   159\tGRID_H_RANGE, GRID_W_RANGE = (10, 18), (14, 18)\n   160\tCONTENT_H_RANGE, CONTENT_W_RANGE = (6, 13), (12, 15)\n   161\tBORDER_RANGE = (0, 4)\n   162\t\n   163\tEDGES, HORIZONTAL_EDGES = (\"top\", \"bottom\", \"left\", \"right\"), (\"top\", \"bottom\")\n   164\tORANGE_COUNT_CHOICES, ORANGE_COUNT_WEIGHTS = [1, 2, 3, 4], [1, 2, 3, 4]\n   165\tORANGE_H_RANGE, ORANGE_W_RANGE = (1, 5), (2, 6)\n   166\tORANGE_AREA_RANGE = (4, 12)\n   167\tORANGE_PLACE_RETRIES = 80\n   168\t\n   169\tMAX_UNTOUCHED_ORANGES = 1\n   170\tBARS_PER_ORANGE_RANGE, TOTAL_BARS_RANGE = (1, 2), (2, 6)\n   171\tBAR_LENGTH_RANGE = (1, 7)\n   172\tBAR_COUNT_RETRIES = 50\n   173\t\n   174\tGENERATE_RETRIES = 300\n   175\t\n   176\t\n   177\tdef _place_orange(edge, cr0, cc0, cr1, cc1, occupied):\n   178\t    \"\"\"Try to place an orange rect flush against the given edge. Returns (or0,oc0,or1,oc1) or None.\"\"\"\n   179\t    for _ in range(ORANGE_PLACE_RETRIES):\n   180\t        oh = random.randint(*ORANGE_H_RANGE)\n   181\t        ow = random.randint(*ORANGE_W_RANGE)\n   182\t        if not (ORANGE_AREA_RANGE[0] <= oh * ow <= ORANGE_AREA_RANGE[1]):\n   183\t            continue\n   184\t        if edge in HORIZONTAL_EDGES:\n   185\t            or0 = cr0 if edge == 'top' else cr1 - oh + 1\n   186\t            or1 = or0 + oh - 1\n   187\t            lo, hi = cc0 + 1, cc1 - ow  # avoid touching perpendicular edges\n   188\t        else:\n   189\t            oc0 = cc0 if edge == 'left' else cc1 - ow + 1\n   190\t            oc1 = oc0 + ow - 1\n   191\t            lo, hi = cr0 + 1, cr1 - oh  # avoid touching perpendicular edges\n   192\t        if hi < lo:\n   193\t            continue\n   194\t        v = random.randint(lo, hi)\n   195\t        if edge in HORIZONTAL_EDGES:\n   196\t            oc0, oc1 = v, v + ow - 1\n   197\t        else:\n   198\t            or0, or1 = v, v + oh - 1\n   199\t        if or0 < cr0 or or1 > cr1 or oc0 < cc0 or oc1 > cc1:\n   200\t            continue\n   201\t        if occupied[or0:or1+1, oc0:oc1+1].any():\n   202\t            continue\n   203\t        return (or0, oc0, or1, oc1)\n   204\t    return None\n   205\t\n   206\t\n   207\tdef _make_canvas() -> tuple[np.ndarray, tuple[int, int, int, int]] | None:\n   208\t    content_h = random.randint(*CONTENT_H_RANGE)\n   209\t    content_w = random.randint(*CONTENT_W_RANGE)\n   210\t    border_top = random.randint(*BORDER_RANGE)\n   211\t    border_bottom = random.randint(*BORDER_RANGE)\n   212\t    border_left = random.randint(*BORDER_RANGE)\n   213\t    border_right = random.randint(*BORDER_RANGE)\n   214\t    grid_h = content_h + border_top + border_bottom\n   215\t    grid_w = content_w + border_left + border_right\n   216\t    if not (GRID_H_RANGE[0] <= grid_h <= GRID_H_RANGE[1] and GRID_W_RANGE[0] <= grid_w <= GRID_W_RANGE[1]):\n   217\t        return None\n   218\t\n   219\t    grid = np.full((grid_h, grid_w), Color.BLACK, dtype=int)\n   220\t    cr0, cc0 = border_top, border_left\n   221\t    cr1, cc1 = cr0 + content_h - 1, cc0 + content_w - 1\n   222\t    grid[cr0:cr1+1, cc0:cc1+1] = Color.YELLOW\n   223\t    return grid, (cr0, cc0, cr1, cc1)\n   224\t\n   225\t\n   226\tdef _place_oranges(content_box, occupied) -> list[tuple[str, int, int, int, int]] | None:\n   227\t    cr0, cc0, cr1, cc1 = content_box\n   228\t    num_orange = random.choices(ORANGE_COUNT_CHOICES, weights=ORANGE_COUNT_WEIGHTS)[0]\n   229\t    edges = random.sample(EDGES, num_orange)\n   230\t    orange_rects = []\n   231\t    for edge in edges:\n   232\t        result = _place_orange(edge, cr0, cc0, cr1, cc1, occupied)\n   233\t        if result is None:\n   234\t            return None\n   235\t        or0, oc0, or1, oc1 = result\n   236\t        occupied[or0:or1+1, oc0:oc1+1] = True\n   237\t        orange_rects.append((edge, or0, oc0, or1, oc1))\n   238\t    return orange_rects\n   239\t\n   240\t\n   241\tdef _choose_touched_oranges(num_orange):\n   242\t    max_untouched = min(MAX_UNTOUCHED_ORANGES, num_orange - 1)\n   243\t    num_untouched = random.randint(0, max_untouched) if num_orange > 1 else 0\n   244\t    indices = list(range(num_orange))\n   245\t    random.shuffle(indices)\n   246\t    untouched_set = set(indices[:num_untouched])\n   247\t    return [i for i in range(num_orange) if i not in untouched_set]\n   248\t\n   249\t\n   250\tdef _choose_bars_per_orange(touched_list):\n   251\t    for _ in range(BAR_COUNT_RETRIES):\n   252\t        bpo = [random.randint(*BARS_PER_ORANGE_RANGE) for _ in touched_list]\n   253\t        if TOTAL_BARS_RANGE[0] <= sum(bpo) <= TOTAL_BARS_RANGE[1]:\n   254\t            return bpo\n   255\t    return None\n   256\t\n   257\t\n   258\tdef _split_bar_lengths(total_gray, n_bars):\n   259\t    min_len, max_len = BAR_LENGTH_RANGE\n   260\t    if n_bars == 2 and total_gray >= 2:\n   261\t        lo_b1 = max(min_len, total_gray - max_len)\n   262\t        hi_b1 = min(total_gray - min_len, max_len)\n   263\t        if lo_b1 > hi_b1:\n   264\t            return None\n   265\t        b1 = random.randint(lo_b1, hi_b1)\n   266\t        return [b1, total_gray - b1]\n   267\t    if total_gray > max_len:\n   268\t        return None\n   269\t    return [total_gray]\n   270\t\n   271\t\n   272\tdef _place_bars(axis, fixed, span0, span1, lo_bound, hi_bound, bar_lengths, occupied):\n   273\t    placed_bars = []\n   274\t    for bl in bar_lengths:\n   275\t        sides = []\n   276\t        if span0 - lo_bound >= bl:\n   277\t            sides.append(0)\n   278\t        if hi_bound - span1 >= bl:\n   279\t            sides.append(1)\n   280\t        random.shuffle(sides)\n","exit_code":0,"status":"completed"}}
