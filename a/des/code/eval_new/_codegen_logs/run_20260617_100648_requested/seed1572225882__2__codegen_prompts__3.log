{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/train/fc10701f.py | sed -n '1,260p'\"","aggregated_output":"     1\tfrom __future__ import annotations\n     2\t\n     3\timport numpy as np\n     4\t\n     5\tfrom arc_utils import Color, bbox, get_bg\n     6\timport random\n     7\t\n     8\t\n     9\tdef _solid_rect_bbox(g: np.ndarray, color: int) -> tuple[int, int, int, int]:\n    10\t    box = bbox(g == color)\n    11\t    assert box is not None, \"expected color to appear\"\n    12\t    r0, c0, r1, c1 = box\n    13\t    area = (r1 - r0 + 1) * (c1 - c0 + 1)\n    14\t    assert int(np.count_nonzero(g == color)) == area, \"colored object must be a solid rectangle\"\n    15\t    assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color), \"colored object bbox must be solid\"\n    16\t    return box\n    17\t\n    18\t\n    19\tdef main(grid: np.ndarray) -> np.ndarray:\n    20\t    \"\"\"\n    21\t    Move the orange rectangle onto the maroon rectangle and mark gated corridor crossings in red.\n    22\t\n    23\t    Input structure\n    24\t    - The dominant background contains black obstacle segments.\n    25\t    - There is one solid orange rectangle and one solid maroon rectangle of the same size.\n    26\t    - The two rectangles share either their row span or their column span, so the move is straight and axis-aligned.\n    27\t\n    28\t    Rule\n    29\t    - Erase the original orange rectangle to the background.\n    30\t    - Replace the maroon rectangle with the orange rectangle.\n    31\t    - Between the two rectangles, paint red across the moving rectangle's width or height only at corridor cells flanked by black obstacle segments perpendicular to the movement.\n    32\t\n    33\t    Key insight\n    34\t    - The black segments define gates in the straight corridor; only those gated openings, not every swept background cell, become red.\n    35\t    \"\"\"\n    36\t    g = np.asarray(grid, dtype=int)\n    37\t    bg = get_bg(g)\n    38\t\n    39\t    source = _solid_rect_bbox(g, Color.ORANGE)\n    40\t    target = _solid_rect_bbox(g, Color.MAROON)\n    41\t    sr0, sc0, sr1, sc1 = source\n    42\t    tr0, tc0, tr1, tc1 = target\n    43\t\n    44\t    assert (sr1 - sr0, sc1 - sc0) == (tr1 - tr0, tc1 - tc0), \"rectangles must have the same size\"\n    45\t    same_cols = (sc0, sc1) == (tc0, tc1)\n    46\t    same_rows = (sr0, sr1) == (tr0, tr1)\n    47\t    assert same_cols != same_rows, \"rectangles must align on exactly one axis\"\n    48\t\n    49\t    out = g.copy()\n    50\t    out[g == Color.ORANGE] = bg\n    51\t    out[tr0 : tr1 + 1, tc0 : tc1 + 1] = Color.ORANGE\n    52\t\n    53\t    H, W = g.shape\n    54\t    if same_cols:\n    55\t        c0, c1 = sc0, sc1\n    56\t        rows = range(tr1 + 1, sr0) if sr0 > tr0 else range(sr1 + 1, tr0)\n    57\t        for r in rows:\n    58\t            gated = (\n    59\t                c0 > 0\n    60\t                and c1 + 1 < W\n    61\t                and g[r, c0 - 1] == Color.BLACK\n    62\t                and g[r, c1 + 1] == Color.BLACK\n    63\t            )\n    64\t            if gated:\n    65\t                assert np.all(g[r, c0 : c1 + 1] == bg), \"gated opening must be background before painting\"\n    66\t                out[r, c0 : c1 + 1] = Color.RED\n    67\t    else:\n    68\t        r0, r1 = sr0, sr1\n    69\t        cols = range(tc1 + 1, sc0) if sc0 > tc0 else range(sc1 + 1, tc0)\n    70\t        for c in cols:\n    71\t            gated = (\n    72\t                r0 > 0\n    73\t                and r1 + 1 < H\n    74\t                and g[r0 - 1, c] == Color.BLACK\n    75\t                and g[r1 + 1, c] == Color.BLACK\n    76\t            )\n    77\t            if gated:\n    78\t                assert np.all(g[r0 : r1 + 1, c] == bg), \"gated opening must be background before painting\"\n    79\t                out[r0 : r1 + 1, c] = Color.RED\n    80\t\n    81\t    return out\n    82\t\n    83\t# --------------- generator (o5x) ---------------\n    84\t\n    85\t# Canvas and object geometry.\n    86\tGRID_SIZE_MIN, GRID_SIZE_MAX = 8, 26\n    87\tRECT_SIDE_MIN, RECT_SIDE_MAX = 1, 4\n    88\tRECT_CANVAS_MARGIN = 4\n    89\tGAP_MIN, GAP_MAX = 5, 7\n    90\tCROSS_AXIS_PADDING = 2\n    91\t\n    92\t# Gate count, spacing, and wall thickness.\n    93\tBETWEEN_GATE_COUNTS = (2, 3)\n    94\tGATE_TOTAL_MIN, GATE_TOTAL_MAX = 2, 8\n    95\tGATE_SPACING_MIN, GATE_SPACING_MAX = 2, 4\n    96\tGATE_SEGMENT_LEN = 2\n    97\t\n    98\t# Palette and retry controls.\n    99\tBACKGROUND_COLOR = Color.PINK\n   100\tGATE_COLOR = Color.BLACK\n   101\tRED_COLOR = Color.RED\n   102\tSOURCE_COLOR = Color.ORANGE\n   103\tTARGET_COLOR = Color.MAROON\n   104\tBINARY_CHOICES = [False, True]\n   105\tGENERATION_ATTEMPTS = 300\n   106\t\n   107\t\n   108\tdef _gen_extensions(anchor: int, limit: int, count: int, sign: int) -> list[list[int]]:\n   109\t    if count == 0:\n   110\t        return [[]]\n   111\t    out: list[list[int]] = []\n   112\t    for step in range(GATE_SPACING_MIN, GATE_SPACING_MAX + 1):\n   113\t        pos = anchor + sign * step\n   114\t        if not (0 <= pos <= limit):\n   115\t            continue\n   116\t        for tail in _gen_extensions(pos, limit, count - 1, sign):\n   117\t            out.append(([pos] + tail) if sign > 0 else (tail + [pos]))\n   118\t    return out\n   119\t\n   120\t\n   121\tdef _gen_between_positions(gap_cells: list[int], count: int) -> list[tuple[int, ...]]:\n   122\t    \"\"\"Enumerate in-gap gate positions with valid spacing, preserving nested-loop order.\"\"\"\n   123\t    out: list[tuple[int, ...]] = []\n   124\t    if count == 2:\n   125\t        for a in gap_cells:\n   126\t            for b in gap_cells:\n   127\t                if GATE_SPACING_MIN <= b - a <= GATE_SPACING_MAX:\n   128\t                    out.append((a, b))\n   129\t    else:\n   130\t        for a in gap_cells:\n   131\t            for b in gap_cells:\n   132\t                for c in gap_cells:\n   133\t                    if (\n   134\t                        GATE_SPACING_MIN <= b - a <= GATE_SPACING_MAX\n   135\t                        and GATE_SPACING_MIN <= c - b <= GATE_SPACING_MAX\n   136\t                    ):\n   137\t                        out.append((a, b, c))\n   138\t    return out\n   139\t\n   140\t\n   141\tdef _gen_gate_positions(size: int, gap_cells: list[int]) -> tuple[list[int], list[int]] | None:\n   142\t    choices: list[tuple[list[int], list[int]]] = []\n   143\t    for between_count in BETWEEN_GATE_COUNTS:\n   144\t        for between in _gen_between_positions(gap_cells, between_count):\n   145\t            remaining = GATE_TOTAL_MAX - between_count\n   146\t            max_left = min(remaining, (between[0] + 1) // GATE_SPACING_MIN)\n   147\t            max_right = min(remaining, (size - between[-1]) // GATE_SPACING_MIN)\n   148\t            for left_count in range(max_left + 1):\n   149\t                for right_count in range(max_right + 1):\n   150\t                    total = between_count + left_count + right_count\n   151\t                    if not (GATE_TOTAL_MIN <= total <= GATE_TOTAL_MAX):\n   152\t                        continue\n   153\t                    for left in _gen_extensions(between[0], size - 1, left_count, -1):\n   154\t                        for right in _gen_extensions(between[-1], size - 1, right_count, 1):\n   155\t                            choices.append((left + list(between) + right, list(between)))\n   156\t    if not choices:\n   157\t        return None\n   158\t    return random.choice(choices)\n   159\t\n   160\t\n   161\tdef _sample_axis_layout(size: int, rect_side: int, gap: int) -> tuple[int, int, int, int, list[int]]:\n   162\t    \"\"\"Sample aligned source/target spans and return the corridor cells between them.\"\"\"\n   163\t    source_first = random.choice(BINARY_CHOICES)\n   164\t    span0 = random.randint(0, size - (2 * rect_side + gap))\n   165\t    first0, second0 = span0, span0 + rect_side + gap\n   166\t    src_axis0, dst_axis0 = (first0, second0) if source_first else (second0, first0)\n   167\t    gap_cells = list(range(span0 + rect_side, span0 + rect_side + gap))\n   168\t    return src_axis0, src_axis0 + rect_side - 1, dst_axis0, dst_axis0 + rect_side - 1, gap_cells\n   169\t\n   170\t\n   171\tdef _paint_rect(grid: np.ndarray, horizontal: bool, axis0: int, axis1: int, cross0: int, cross1: int, color: int) -> None:\n   172\t    if horizontal:\n   173\t        grid[cross0 : cross1 + 1, axis0 : axis1 + 1] = color\n   174\t    else:\n   175\t        grid[axis0 : axis1 + 1, cross0 : cross1 + 1] = color\n   176\t\n   177\t\n   178\tdef _gen_attempt() -> np.ndarray | None:\n   179\t    size = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)\n   180\t    rect_side = random.randint(RECT_SIDE_MIN, min(RECT_SIDE_MAX, size - RECT_CANVAS_MARGIN))\n   181\t    gap = random.randint(GAP_MIN, GAP_MAX)\n   182\t    if 2 * rect_side + gap > size:\n   183\t        return None\n   184\t\n   185\t    horizontal = random.choice(BINARY_CHOICES)\n   186\t    src_axis0, src_axis1, dst_axis0, dst_axis1, gap_cells = _sample_axis_layout(size, rect_side, gap)\n   187\t    gate_choice = _gen_gate_positions(size, gap_cells)\n   188\t    if gate_choice is None:\n   189\t        return None\n   190\t    gate_positions, red_positions = gate_choice\n   191\t\n   192\t    cross0 = random.randint(CROSS_AXIS_PADDING, size - rect_side - CROSS_AXIS_PADDING)\n   193\t    cross1 = cross0 + rect_side - 1\n   194\t    output = np.full((size, size), BACKGROUND_COLOR, dtype=int)\n   195\t\n   196\t    for pos in gate_positions:\n   197\t        if horizontal:\n   198\t            output[cross0 - GATE_SEGMENT_LEN : cross0, pos] = GATE_COLOR\n   199\t            output[cross1 + 1 : cross1 + 1 + GATE_SEGMENT_LEN, pos] = GATE_COLOR\n   200\t        else:\n   201\t            output[pos, cross0 - GATE_SEGMENT_LEN : cross0] = GATE_COLOR\n   202\t            output[pos, cross1 + 1 : cross1 + 1 + GATE_SEGMENT_LEN] = GATE_COLOR\n   203\t    _paint_rect(output, horizontal, dst_axis0, dst_axis1, cross0, cross1, SOURCE_COLOR)\n   204\t    for pos in red_positions:\n   205\t        if horizontal:\n   206\t            output[cross0 : cross1 + 1, pos] = RED_COLOR\n   207\t        else:\n   208\t            output[pos, cross0 : cross1 + 1] = RED_COLOR\n   209\t\n   210\t    inp = output.copy()\n   211\t    inp[inp == RED_COLOR] = BACKGROUND_COLOR\n   212\t    _paint_rect(inp, horizontal, dst_axis0, dst_axis1, cross0, cross1, TARGET_COLOR)\n   213\t    _paint_rect(inp, horizontal, src_axis0, src_axis1, cross0, cross1, SOURCE_COLOR)\n   214\t\n   215\t    if np.array_equal(main(inp), output):\n   216\t        return inp\n   217\t    return None\n   218\t\n   219\t\n   220\tdef generate_input() -> np.ndarray:\n   221\t    for _ in range(GENERATION_ATTEMPTS):\n   222\t        grid = _gen_attempt()\n   223\t        if grid is not None:\n   224\t            return grid\n   225\t    raise RuntimeError(\"failed to generate valid fc10701f input\")\n","exit_code":0,"status":"completed"}}
