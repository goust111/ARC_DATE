{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/train/996ec1f3.py | sed -n '1,260p'\"","aggregated_output":"     1\tfrom collections import Counter\n     2\t\n     3\timport numpy as np\n     4\timport random\n     5\t\n     6\t\n     7\tdef _unique_mode(values: np.ndarray) -> int:\n     8\t    counts = Counter(map(int, values.reshape(-1)))\n     9\t    ranked = counts.most_common()\n    10\t    assert ranked, \"expected a nonempty region\"\n    11\t    assert len(ranked) == 1 or ranked[0][1] > ranked[1][1], \"expected a unique dominant color\"\n    12\t    return int(ranked[0][0])\n    13\t\n    14\t\n    15\tdef main(grid: np.ndarray) -> np.ndarray:\n    16\t    \"\"\"\n    17\t    Compress the noisy four-region board split by a solid cross into a 3x3 color map.\n    18\t\n    19\t    Input structure:\n    20\t    - A single full row and a single full column have the same solid separator color.\n    21\t    - The separator cross divides the input into four nonempty rectangular regions.\n    22\t    - Each region has a unique dominant color, with other colors acting as noise.\n    23\t\n    24\t    Rule:\n    25\t    - Find the unique solid same-color row/column pair.\n    26\t    - Fill the middle row and middle column of the 3x3 output with the separator color.\n    27\t    - Put the unique dominant color of each quadrant into the corresponding corner.\n    28\t\n    29\t    Key insight:\n    30\t    - The input grid is a noisy enlarged version of the desired 3x3 layout; the cross marks the coarse cell boundaries.\n    31\t    \"\"\"\n    32\t    g = np.asarray(grid, dtype=int)\n    33\t    assert g.ndim == 2, \"expected a 2D grid\"\n    34\t    height, width = map(int, g.shape)\n    35\t\n    36\t    solid_rows = [\n    37\t        (row, int(g[row, 0]))\n    38\t        for row in range(height)\n    39\t        if np.all(g[row, :] == int(g[row, 0]))\n    40\t    ]\n    41\t    solid_cols = [\n    42\t        (col, int(g[0, col]))\n    43\t        for col in range(width)\n    44\t        if np.all(g[:, col] == int(g[0, col]))\n    45\t    ]\n    46\t    crosses = [\n    47\t        (row, col, row_color)\n    48\t        for row, row_color in solid_rows\n    49\t        for col, col_color in solid_cols\n    50\t        if row_color == col_color\n    51\t    ]\n    52\t    assert len(crosses) == 1, \"expected exactly one solid same-color separator cross\"\n    53\t\n    54\t    cross_row, cross_col, separator = crosses[0]\n    55\t    assert 0 < cross_row < height - 1, \"separator row must split nonempty top and bottom regions\"\n    56\t    assert 0 < cross_col < width - 1, \"separator column must split nonempty left and right regions\"\n    57\t\n    58\t    out = np.full((3, 3), int(separator), dtype=int)\n    59\t    regions = [\n    60\t        ((slice(0, cross_row), slice(0, cross_col)), (0, 0)),\n    61\t        ((slice(0, cross_row), slice(cross_col + 1, width)), (0, 2)),\n    62\t        ((slice(cross_row + 1, height), slice(0, cross_col)), (2, 0)),\n    63\t        ((slice(cross_row + 1, height), slice(cross_col + 1, width)), (2, 2)),\n    64\t    ]\n    65\t    for src, dst in regions:\n    66\t        out[dst] = _unique_mode(g[src])\n    67\t\n    68\t    return out\n    69\t\n    70\t# --------------- generator (att2) ---------------\n    71\t\n    72\tGRID_SIZE = 19\n    73\tCOLOR_COUNT = 10\n    74\t\n    75\t# Cross placement keeps every quadrant at least 6 cells wide/tall.\n    76\tCROSS_ROW_MIN = 6\n    77\tCROSS_ROW_MAX = 11\n    78\tCROSS_COL_MIN = 6\n    79\tCROSS_COL_MAX = 10\n    80\t\n    81\t# Quadrant borders are mostly non-dominant while preserving the mode.\n    82\tMAX_MODE_RATIO = 0.73\n    83\tMAX_DOMINANT_BORDER_RATIO = 0.30\n    84\tNOISE_DISTINCT_MIN = 6\n    85\tNOISE_DISTINCT_MAX = 8\n    86\t\n    87\tGEN_MAX_ATTEMPTS = 300\n    88\t\n    89\t\n    90\tdef _gen_border_coords(r0: int, r1: int, c0: int, c1: int) -> list[tuple[int, int]]:\n    91\t    coords = []\n    92\t    for c in range(c0, c1):\n    93\t        coords.append((r0, c))\n    94\t        coords.append((r1 - 1, c))\n    95\t    for r in range(r0 + 1, r1 - 1):\n    96\t        coords.append((r, c0))\n    97\t        coords.append((r, c1 - 1))\n    98\t    return coords\n    99\t\n   100\t\n   101\tdef _gen_fill_quadrant(\n   102\t    grid: np.ndarray,\n   103\t    r0: int,\n   104\t    r1: int,\n   105\t    c0: int,\n   106\t    c1: int,\n   107\t    dominant: int,\n   108\t) -> None:\n   109\t    grid[r0:r1, c0:c1] = dominant\n   110\t    border = _gen_border_coords(r0, r1, c0, c1)\n   111\t    interior_area = max(0, r1 - r0 - 2) * max(0, c1 - c0 - 2)\n   112\t    total_area = (r1 - r0) * (c1 - c0)\n   113\t    min_dominant_on_border = max(0, total_area // 2 + 1 - interior_area)\n   114\t    max_by_mode = int(np.floor(MAX_MODE_RATIO * total_area)) - interior_area\n   115\t    max_by_noise = int(np.floor(MAX_DOMINANT_BORDER_RATIO * len(border)))\n   116\t    max_dominant_on_border = max(min_dominant_on_border, min(max_by_mode, max_by_noise))\n   117\t    dominant_on_border = random.randint(min_dominant_on_border, max_dominant_on_border)\n   118\t\n   119\t    random.shuffle(border)\n   120\t    dominant_cells = set(border[:dominant_on_border])\n   121\t    noise_cells = border[dominant_on_border:]\n   122\t    noise_palette = [color for color in range(COLOR_COUNT) if color != dominant]\n   123\t    distinct_noise = random.randint(\n   124\t        NOISE_DISTINCT_MIN,\n   125\t        min(NOISE_DISTINCT_MAX, len(noise_palette), len(noise_cells)),\n   126\t    )\n   127\t    used_noise = random.sample(noise_palette, distinct_noise)\n   128\t    noise_values = used_noise[:]\n   129\t    noise_values.extend(random.choice(used_noise) for _ in range(len(noise_cells) - len(noise_values)))\n   130\t    random.shuffle(noise_values)\n   131\t\n   132\t    for r, c in dominant_cells:\n   133\t        grid[r, c] = dominant\n   134\t    for (r, c), color in zip(noise_cells, noise_values):\n   135\t        grid[r, c] = color\n   136\t\n   137\t\n   138\tdef _gen_non_separator_noise(separator: int, dominant: int) -> int:\n   139\t    return random.choice([color for color in range(COLOR_COUNT) if color not in (separator, dominant)])\n   140\t\n   141\t\n   142\tdef _gen_prevent_extra_solid_crosses(\n   143\t    grid: np.ndarray,\n   144\t    cross_r: int,\n   145\t    cross_c: int,\n   146\t    separator: int,\n   147\t    dominants: list[int],\n   148\t) -> None:\n   149\t    for r in range(grid.shape[0]):\n   150\t        if r != cross_r and np.all(grid[r, :] == separator):\n   151\t            dominant = dominants[0] if r < cross_r else dominants[2]\n   152\t            grid[r, 0] = _gen_non_separator_noise(separator, dominant)\n   153\t    for c in range(grid.shape[1]):\n   154\t        if c != cross_c and np.all(grid[:, c] == separator):\n   155\t            dominant = dominants[0] if c < cross_c else dominants[1]\n   156\t            grid[0, c] = _gen_non_separator_noise(separator, dominant)\n   157\t\n   158\t\n   159\tdef _gen_attempt() -> np.ndarray | None:\n   160\t    colors = random.sample(range(COLOR_COUNT), 5)\n   161\t    separator = colors[0]\n   162\t    dominants = colors[1:]\n   163\t    expected = np.array(\n   164\t        [\n   165\t            [dominants[0], separator, dominants[1]],\n   166\t            [separator, separator, separator],\n   167\t            [dominants[2], separator, dominants[3]],\n   168\t        ],\n   169\t        dtype=int,\n   170\t    )\n   171\t\n   172\t    height = width = GRID_SIZE\n   173\t    cross_r = random.randint(CROSS_ROW_MIN, CROSS_ROW_MAX)\n   174\t    cross_c = random.randint(CROSS_COL_MIN, CROSS_COL_MAX)\n   175\t    grid = np.full((height, width), separator, dtype=int)\n   176\t\n   177\t    quadrants = [\n   178\t        (0, cross_r, 0, cross_c, dominants[0]),\n   179\t        (0, cross_r, cross_c + 1, width, dominants[1]),\n   180\t        (cross_r + 1, height, 0, cross_c, dominants[2]),\n   181\t        (cross_r + 1, height, cross_c + 1, width, dominants[3]),\n   182\t    ]\n   183\t    for r0, r1, c0, c1, dominant in quadrants:\n   184\t        _gen_fill_quadrant(grid, r0, r1, c0, c1, dominant)\n   185\t\n   186\t    grid[cross_r, :] = separator\n   187\t    grid[:, cross_c] = separator\n   188\t    _gen_prevent_extra_solid_crosses(grid, cross_r, cross_c, separator, dominants)\n   189\t\n   190\t    try:\n   191\t        if np.array_equal(main(grid), expected):\n   192\t            return grid\n   193\t    except AssertionError:\n   194\t        return None\n   195\t    return None\n   196\t\n   197\t\n   198\tdef generate_input() -> np.ndarray:\n   199\t    for _ in range(GEN_MAX_ATTEMPTS):\n   200\t        grid = _gen_attempt()\n   201\t        if grid is not None:\n   202\t            return grid\n   203\t    raise RuntimeError(f\"generate_input: failed after {GEN_MAX_ATTEMPTS} attempts\")\n","exit_code":0,"status":"completed"}}
