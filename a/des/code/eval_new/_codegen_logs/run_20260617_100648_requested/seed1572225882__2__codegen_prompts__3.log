{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/train/538b439f.py | sed -n '1,260p'\"","aggregated_output":"     1\tfrom __future__ import annotations\n     2\t\n     3\timport numpy as np\n     4\t\n     5\tfrom arc_utils import colors_present, find_components, get_bg, paste\n     6\timport random\n     7\t\n     8\t\n     9\tdef _find_separator(g: np.ndarray, bg: int) -> tuple[str, int, int]:\n    10\t    axes: list[tuple[str, int, int]] = []\n    11\t\n    12\t    for r in range(g.shape[0]):\n    13\t        vals = np.unique(g[r, :])\n    14\t        if vals.size == 1 and int(vals[0]) != int(bg):\n    15\t            axes.append((\"horizontal\", int(r), int(vals[0])))\n    16\t\n    17\t    for c in range(g.shape[1]):\n    18\t        vals = np.unique(g[:, c])\n    19\t        if vals.size == 1 and int(vals[0]) != int(bg):\n    20\t            axes.append((\"vertical\", int(c), int(vals[0])))\n    21\t\n    22\t    assert len(axes) == 1, \"expected exactly one full separator row or column\"\n    23\t    return axes[0]\n    24\t\n    25\t\n    26\tdef _component_side(component: dict, orient: str, axis: int) -> int:\n    27\t    r0, c0, r1, c1 = component[\"bbox\"]\n    28\t    if orient == \"vertical\":\n    29\t        if c1 < axis:\n    30\t            return -1\n    31\t        if c0 > axis:\n    32\t            return 1\n    33\t    elif orient == \"horizontal\":\n    34\t        if r1 < axis:\n    35\t            return -1\n    36\t        if r0 > axis:\n    37\t            return 1\n    38\t    else:\n    39\t        raise AssertionError(\"unknown separator orientation\")\n    40\t    return 0\n    41\t\n    42\t\n    43\tdef _is_solid_rect(component: dict) -> bool:\n    44\t    r0, c0, r1, c1 = component[\"bbox\"]\n    45\t    rect_area = (int(r1) - int(r0) + 1) * (int(c1) - int(c0) + 1)\n    46\t    return int(component[\"area\"]) == rect_area\n    47\t\n    48\t\n    49\tdef _find_source(g: np.ndarray, bg: int, orient: str, axis: int, axis_color: int) -> tuple[int, list[dict]]:\n    50\t    candidates: list[tuple[int, list[dict]]] = []\n    51\t\n    52\t    for color in colors_present(g, exclude={bg, axis_color}):\n    53\t        components = find_components(\n    54\t            g,\n    55\t            bg=bg,\n    56\t            connectivity=4,\n    57\t            monochromatic=True,\n    58\t            colors=[color],\n    59\t        )\n    60\t        assert components, \"present colors must have at least one component\"\n    61\t        sides = {_component_side(component, orient, axis) for component in components}\n    62\t        if (\n    63\t            len(sides) == 1\n    64\t            and 0 not in sides\n    65\t            and all(_is_solid_rect(component) and int(component[\"area\"]) > 1 for component in components)\n    66\t        ):\n    67\t            candidates.append((int(color), components))\n    68\t\n    69\t    assert len(candidates) == 1, \"expected one source color made of solid rectangles on one side\"\n    70\t    return candidates[0]\n    71\t\n    72\t\n    73\tdef _mirror_and_connect(\n    74\t    out: np.ndarray,\n    75\t    component: dict,\n    76\t    orient: str,\n    77\t    axis: int,\n    78\t    axis_color: int,\n    79\t    source_color: int,\n    80\t) -> None:\n    81\t    coords = component[\"coords\"]\n    82\t    r0, c0, r1, c1 = map(int, component[\"bbox\"])\n    83\t    mirrored = coords.copy()\n    84\t\n    85\t    if orient == \"vertical\":\n    86\t        mirrored[:, 1] = 2 * int(axis) - mirrored[:, 1]\n    87\t        assert np.all((0 <= mirrored[:, 1]) & (mirrored[:, 1] < out.shape[1])), \"reflection leaves grid\"\n    88\t        mr0, mc0 = map(int, mirrored.min(axis=0))\n    89\t        mr1, mc1 = map(int, mirrored.max(axis=0))\n    90\t        assert mr0 == r0 and mr1 == r1, \"vertical reflection must preserve rows\"\n    91\t\n    92\t        if c1 < mc0:\n    93\t            fill_start, fill_end = c1 + 1, mc0 - 1\n    94\t        elif mc1 < c0:\n    95\t            fill_start, fill_end = mc1 + 1, c0 - 1\n    96\t        else:\n    97\t            raise AssertionError(\"reflected object overlaps its source\")\n    98\t        assert fill_start <= int(axis) <= fill_end, \"separator must lie between source and reflection\"\n    99\t        out[r0 : r1 + 1, fill_start : fill_end + 1] = int(axis_color)\n   100\t    elif orient == \"horizontal\":\n   101\t        mirrored[:, 0] = 2 * int(axis) - mirrored[:, 0]\n   102\t        assert np.all((0 <= mirrored[:, 0]) & (mirrored[:, 0] < out.shape[0])), \"reflection leaves grid\"\n   103\t        mr0, mc0 = map(int, mirrored.min(axis=0))\n   104\t        mr1, mc1 = map(int, mirrored.max(axis=0))\n   105\t        assert mc0 == c0 and mc1 == c1, \"horizontal reflection must preserve columns\"\n   106\t\n   107\t        if r1 < mr0:\n   108\t            fill_start, fill_end = r1 + 1, mr0 - 1\n   109\t        elif mr1 < r0:\n   110\t            fill_start, fill_end = mr1 + 1, r0 - 1\n   111\t        else:\n   112\t            raise AssertionError(\"reflected object overlaps its source\")\n   113\t        assert fill_start <= int(axis) <= fill_end, \"separator must lie between source and reflection\"\n   114\t        out[fill_start : fill_end + 1, c0 : c1 + 1] = int(axis_color)\n   115\t    else:\n   116\t        raise AssertionError(\"unknown separator orientation\")\n   117\t\n   118\t    out[mirrored[:, 0], mirrored[:, 1]] = int(source_color)\n   119\t\n   120\t\n   121\tdef main(grid: np.ndarray) -> np.ndarray:\n   122\t    \"\"\"\n   123\t    Reflect the solid rectangular source objects across the full separator line and color the gap with the separator color.\n   124\t\n   125\t    Input structure:\n   126\t    - A dominant background contains one full-width or full-height one-pixel\n   127\t      separator line in a non-background color.\n   128\t    - One other foreground color forms solid rectangular objects, all strictly on the same side of that separator.\n   129\t    - Remaining non-background pixels are scattered distractors.\n   130\t\n   131\t    Rule:\n   132\t    - Keep the input grid shape and unchanged pixels outside each affected corridor.\n   133\t    - Mirror each source object across the separator line.\n   134\t    - For every source object, recolor the rectangular strip between the\n   135\t      original object and its reflection to the separator color, then paint the\n   136\t      reflected object in the source color.\n   137\t\n   138\t    Key insight:\n   139\t    - The full straight line is a mirror axis; the real objects are identified\n   140\t      structurally as the only solid rectangles confined to one side, while\n   141\t      scattered pixels are noise that may be overwritten inside the corridor.\n   142\t    \"\"\"\n   143\t    g = np.asarray(grid, dtype=int)\n   144\t    bg = get_bg(g)\n   145\t    orient, axis, axis_color = _find_separator(g, bg)\n   146\t    source_color, components = _find_source(g, bg, orient, axis, axis_color)\n   147\t\n   148\t    out = g.copy()\n   149\t    for component in components:\n   150\t        _mirror_and_connect(out, component, orient, axis, axis_color, source_color)\n   151\t    return out\n   152\t\n   153\t# --------------- generator (att2, o5x) ---------------\n   154\t\n   155\t# Canvas and palette.\n   156\tGRID_SIZE_RANGE = (18, 23)\n   157\tCOLOR_COUNT = 10\n   158\tPALETTE_SIZE = 4\n   159\tORIENTATIONS = (\"vertical\", \"horizontal\")\n   160\tAXIS_RATIO_RANGE = (0.35, 0.50)\n   161\tSIDES = (-1, 1)\n   162\t\n   163\t# Source rectangles and reflected corridors.\n   164\tSOURCE_RECT_COUNT_RANGE = (2, 3)\n   165\tRECT_HEIGHT_RANGE = (2, 5)\n   166\tRECT_WIDTH_RANGE = (2, 4)\n   167\tSOURCE_GAP_TO_AXIS_RANGE = (2, 5)\n   168\tMIN_RECT_INTERVAL_GAP = 1\n   169\t\n   170\t# Distractor scatter.\n   171\tDISTRACTOR_DENSITY_RANGE = (0.03, 0.10)\n   172\tMAX_DISTRACTOR_CLUSTERS = 4\n   173\tDISTRACTOR_CLUSTER_TARGET_DIVISOR = 12\n   174\tFORCE_CLUSTER_PROB = 0.70\n   175\tDISTRACTOR_CLUSTER_SHAPES = (\n   176\t    ((0, 0), (0, 1)),\n   177\t    ((0, 0), (1, 0)),\n   178\t    ((0, 0), (0, 1), (0, 2)),\n   179\t    ((0, 0), (1, 0), (2, 0)),\n   180\t    ((0, 0), (1, 0), (0, 1)),\n   181\t    ((0, 0), (1, 0), (1, 1)),\n   182\t    ((0, 0), (0, 1), (1, 1)),\n   183\t    ((1, 0), (0, 1), (1, 1)),\n   184\t)\n   185\t\n   186\t# Retry budget.\n   187\tGENERATION_ATTEMPTS = 300\n   188\t\n   189\t\n   190\tdef _composition(total: int, parts: int) -> list[int]:\n   191\t    if total <= 0:\n   192\t        return [0] * parts\n   193\t    return list(np.random.multinomial(int(total), [1.0 / parts] * parts))\n   194\t\n   195\t\n   196\tdef _pack_intervals(length: int, sizes: list[int], *, min_gap: int) -> list[tuple[int, int]] | None:\n   197\t    extra = int(length) - sum(sizes) - int(min_gap) * (len(sizes) - 1)\n   198\t    if extra < 0:\n   199\t        return None\n   200\t    gaps = _composition(extra, len(sizes) + 1)\n   201\t    intervals: list[tuple[int, int]] = []\n   202\t    pos = gaps[0]\n   203\t    for i, size in enumerate(sizes):\n   204\t        intervals.append((pos, pos + int(size) - 1))\n   205\t        pos += int(size)\n   206\t        if i + 1 < len(sizes):\n   207\t            pos += int(min_gap) + gaps[i + 1]\n   208\t    return intervals\n   209\t\n   210\t\n   211\tdef _axis_candidates(length: int) -> list[int]:\n   212\t    min_ratio, max_ratio = AXIS_RATIO_RANGE\n   213\t    return [\n   214\t        i\n   215\t        for i in range(1, int(length) - 1)\n   216\t        if min_ratio <= min(i, int(length) - 1 - i) / float(length) <= max_ratio\n   217\t    ]\n   218\t\n   219\t\n   220\tdef _size_gap_pairs(size_range: tuple[int, int], min_space: int) -> list[tuple[int, int]]:\n   221\t    return [\n   222\t        (size, gap)\n   223\t        for size in range(size_range[0], size_range[1] + 1)\n   224\t        for gap in range(SOURCE_GAP_TO_AXIS_RANGE[0], SOURCE_GAP_TO_AXIS_RANGE[1] + 1)\n   225\t        if size + gap <= min_space\n   226\t    ]\n   227\t\n   228\t\n   229\tdef _side_span(axis: int, length: int, size: int, gap: int, side: int) -> tuple[int, int] | None:\n   230\t    if side < 0:\n   231\t        end = int(axis) - int(gap) - 1\n   232\t        start = end - int(size) + 1\n   233\t    else:\n   234\t        start = int(axis) + int(gap) + 1\n   235\t        end = start + int(size) - 1\n   236\t    if 0 <= start <= end < int(length):\n   237\t        return start, end\n   238\t    return None\n   239\t\n   240\t\n   241\tdef _mirror_span(axis: int, start: int, end: int) -> tuple[int, int]:\n   242\t    a = int(axis)\n   243\t    return tuple(sorted((2 * a - int(start), 2 * a - int(end))))\n   244\t\n   245\t\n   246\tdef _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:\n   247\t    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))\n   248\t\n   249\t\n   250\tdef _paint_reflected_pair(\n   251\t    out: np.ndarray,\n   252\t    affected: np.ndarray,\n   253\t    source_mask: np.ndarray,\n   254\t    *,\n   255\t    src: int,\n   256\t    sep: int,\n   257\t    rect: tuple[int, int, int, int],\n   258\t    mirror: tuple[int, int, int, int],\n   259\t    corridor: tuple[int, int, int, int],\n   260\t) -> None:\n","exit_code":0,"status":"completed"}}
