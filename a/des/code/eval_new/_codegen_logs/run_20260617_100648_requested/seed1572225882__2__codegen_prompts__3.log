{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/train/e3fe1151.py | sed -n '1,260p'\"","aggregated_output":"     1\tfrom collections import Counter\n     2\t\n     3\timport numpy as np\n     4\t\n     5\tfrom arc_utils import get_bg\n     6\timport random\n     7\t\n     8\t\n     9\tdef _solid_separator_cross(g: np.ndarray, bg: int) -> tuple[int, int]:\n    10\t    height, width = g.shape\n    11\t    solid_rows = [r for r in range(height) if np.all(g[r, :] == bg)]\n    12\t    solid_cols = [c for c in range(width) if np.all(g[:, c] == bg)]\n    13\t    assert len(solid_rows) == 1, \"expected exactly one solid background separator row\"\n    14\t    assert len(solid_cols) == 1, \"expected exactly one solid background separator column\"\n    15\t    return solid_rows[0], solid_cols[0]\n    16\t\n    17\t\n    18\tdef _quadrants(cross_row: int, cross_col: int, height: int, width: int) -> list[tuple[slice, slice]]:\n    19\t    top_h = cross_row\n    20\t    bottom_h = height - cross_row - 1\n    21\t    left_w = cross_col\n    22\t    right_w = width - cross_col - 1\n    23\t    assert top_h > 0 and left_w > 0, \"separator must leave nonempty corner regions\"\n    24\t    assert top_h == bottom_h, \"separator row must split equal-height regions\"\n    25\t    assert left_w == right_w, \"separator column must split equal-width regions\"\n    26\t\n    27\t    return [\n    28\t        (slice(0, cross_row), slice(0, cross_col)),\n    29\t        (slice(0, cross_row), slice(cross_col + 1, width)),\n    30\t        (slice(cross_row + 1, height), slice(0, cross_col)),\n    31\t        (slice(cross_row + 1, height), slice(cross_col + 1, width)),\n    32\t    ]\n    33\t\n    34\t\n    35\tdef main(grid: np.ndarray) -> np.ndarray:\n    36\t    \"\"\"\n    37\t    Fill the one blank in each corner region so all four regions have the same color multiset.\n    38\t\n    39\t    Input structure:\n    40\t    - The dominant background color forms one solid separator row and one solid\n    41\t      separator column.\n    42\t    - The separator cross splits the grid into four equal rectangular corner regions.\n    43\t    - Each corner region contains exactly one background-colored blank pixel.\n    44\t\n    45\t    Rule:\n    46\t    - Count the non-background colors in each corner region.\n    47\t    - The completed region multiset is defined by the maximum observed count of\n    48\t      each color across the four regions.\n    49\t    - Replace each region's blank pixel with the single color needed to match that\n    50\t      completed multiset.\n    51\t\n    52\t    Key insight:\n    53\t    - The separator color inside a corner region is a missing value marker; comparing\n    54\t      the four regions reveals the shared multiset without using numeric color order.\n    55\t    \"\"\"\n    56\t    g = np.asarray(grid, dtype=int)\n    57\t    assert g.ndim == 2, \"expected a 2D grid\"\n    58\t    height, width = map(int, g.shape)\n    59\t\n    60\t    bg = get_bg(g)\n    61\t    color_counts = Counter(map(int, g.reshape(-1)))\n    62\t    assert all(\n    63\t        color == bg or count < color_counts[bg] for color, count in color_counts.items()\n    64\t    ), \"background color must be uniquely dominant\"\n    65\t\n    66\t    cross_row, cross_col = _solid_separator_cross(g, bg)\n    67\t    regions = _quadrants(cross_row, cross_col, height, width)\n    68\t    region_shape = g[regions[0]].shape\n    69\t    region_area = int(np.prod(region_shape))\n    70\t\n    71\t    counts_by_region: list[Counter[int]] = []\n    72\t    blank_positions: list[tuple[int, int]] = []\n    73\t    for row_slice, col_slice in regions:\n    74\t        region = g[row_slice, col_slice]\n    75\t        assert region.shape == region_shape, \"all corner regions must have the same shape\"\n    76\t        blanks = np.argwhere(region == bg)\n    77\t        assert len(blanks) == 1, \"each corner region must have exactly one blank\"\n    78\t\n    79\t        counts_by_region.append(Counter(map(int, region[region != bg].reshape(-1))))\n    80\t        local_r, local_c = map(int, blanks[0])\n    81\t        blank_positions.append((row_slice.start + local_r, col_slice.start + local_c))\n    82\t\n    83\t    target_counts: Counter[int] = Counter()\n    84\t    for counts in counts_by_region:\n    85\t        for color, count in counts.items():\n    86\t            target_counts[color] = max(target_counts[color], count)\n    87\t    assert sum(target_counts.values()) == region_area, \"completed region multiset must be unique\"\n    88\t\n    89\t    out = g.copy()\n    90\t    for counts, (row, col) in zip(counts_by_region, blank_positions):\n    91\t        missing = target_counts - counts\n    92\t        assert len(missing) == 1, \"each blank must have exactly one matching fill color\"\n    93\t        fill_color, fill_count = next(iter(missing.items()))\n    94\t        assert fill_count == 1, \"each corner region must need one pixel of the fill color\"\n    95\t        out[row, col] = fill_color\n    96\t\n    97\t    return out\n    98\t\n    99\t# --------------- generator (o5x) ---------------\n   100\t# Canvas/palette bounds.\n   101\tGRID_HALF_MIN = 2\n   102\tGRID_HALF_MAX = 6\n   103\tCOLOR_COUNT = 10\n   104\tMIN_TARGET_COLORS = 3\n   105\tMAX_NON_BG_COLORS = COLOR_COUNT - 1\n   106\t# Layout probabilities and constraints.\n   107\tPREFERRED_GRID_HALF = (2, 2)\n   108\tPREFERRED_GRID_PROB = 0.65\n   109\tQUADRANT_COUNT = 4\n   110\tSEPARATOR_WIDTH = 1\n   111\tBG_DOMINANCE_MARGIN = 1\n   112\t# Retry limit.\n   113\tMAX_GENERATION_ATTEMPTS = 300\n   114\t\n   115\tdef _gen_bounded_composition(total: int, parts: int, max_each: int) -> list[int] | None:\n   116\t    if parts <= 0 or total < parts or total > parts * max_each:\n   117\t        return None\n   118\t\n   119\t    counts = []\n   120\t    remaining = total\n   121\t    for i in range(parts):\n   122\t        slots_left = parts - i - 1\n   123\t        lo = max(1, remaining - slots_left * max_each)\n   124\t        hi = min(max_each, remaining - slots_left)\n   125\t        counts.append(random.randint(lo, hi))\n   126\t        remaining -= counts[-1]\n   127\t\n   128\t    random.shuffle(counts)\n   129\t    return counts\n   130\t\n   131\t\n   132\tdef _gen_grid_options() -> list[tuple[int, int, list[int], int]]:\n   133\t    options = []\n   134\t    for k in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n   135\t        for m in range(GRID_HALF_MIN, GRID_HALF_MAX + 1):\n   136\t            area = k * m\n   137\t            bg_count = 2 * k + 2 * m + SEPARATOR_WIDTH + QUADRANT_COUNT\n   138\t            max_target_count = (bg_count - BG_DOMINANCE_MARGIN) // QUADRANT_COUNT\n   139\t            max_colors = min(MAX_NON_BG_COLORS, area)\n   140\t            valid_counts = [\n   141\t                c\n   142\t                for c in range(MIN_TARGET_COLORS, max_colors + 1)\n   143\t                if area <= c * max_target_count\n   144\t            ]\n   145\t            if valid_counts:\n   146\t                options.append((k, m, valid_counts, max_target_count))\n   147\t    return options\n   148\t\n   149\t\n   150\tdef _gen_pick_grid_option() -> tuple[int, int, list[int], int]:\n   151\t    options = _gen_grid_options()\n   152\t    if random.random() < PREFERRED_GRID_PROB:\n   153\t        preferred_k, preferred_m = PREFERRED_GRID_HALF\n   154\t        for option in options:\n   155\t            if option[0] == preferred_k and option[1] == preferred_m:\n   156\t                return option\n   157\t    return random.choice(options)\n   158\t\n   159\t\n   160\tdef _gen_quadrant_offsets(k: int, m: int) -> list[tuple[int, int]]:\n   161\t    sep = SEPARATOR_WIDTH\n   162\t    return [(0, 0), (0, m + sep), (k + sep, 0), (k + sep, m + sep)]\n   163\t\n   164\t\n   165\tdef _gen_missing_colors(non_bg_colors: list[int]) -> list[int]:\n   166\t    missing_colors = [random.choice(non_bg_colors) for _ in range(QUADRANT_COUNT)]\n   167\t    if len(set(missing_colors)) == 1:\n   168\t        alternatives = [c for c in non_bg_colors if c != missing_colors[0]]\n   169\t        missing_colors[-1] = random.choice(alternatives)\n   170\t    return missing_colors\n   171\t\n   172\t\n   173\tdef _gen_attempt() -> np.ndarray | None:\n   174\t    bg = random.randrange(COLOR_COUNT)\n   175\t    k, m, valid_color_counts, max_target_count = _gen_pick_grid_option()\n   176\t    area = k * m\n   177\t\n   178\t    color_count = random.choice(valid_color_counts)\n   179\t    non_bg_colors = random.sample([c for c in range(COLOR_COUNT) if c != bg], color_count)\n   180\t    target_counts = _gen_bounded_composition(area, color_count, max_target_count)\n   181\t    if target_counts is None:\n   182\t        return None\n   183\t\n   184\t    target_values = []\n   185\t    for color, count in zip(non_bg_colors, target_counts):\n   186\t        target_values.extend([color] * count)\n   187\t\n   188\t    missing_colors = _gen_missing_colors(non_bg_colors)\n   189\t    out = np.full((2 * k + SEPARATOR_WIDTH, 2 * m + SEPARATOR_WIDTH), bg, dtype=int)\n   190\t    inp = out.copy()\n   191\t\n   192\t    for (r0, c0), missing_color in zip(_gen_quadrant_offsets(k, m), missing_colors):\n   193\t        values = target_values[:]\n   194\t        random.shuffle(values)\n   195\t        quadrant_out = np.array(values, dtype=int).reshape(k, m)\n   196\t\n   197\t        candidates = np.argwhere(quadrant_out == missing_color)\n   198\t        blank_r, blank_c = map(int, candidates[random.randrange(len(candidates))])\n   199\t        quadrant_in = quadrant_out.copy()\n   200\t        quadrant_in[blank_r, blank_c] = bg\n   201\t\n   202\t        out[r0 : r0 + k, c0 : c0 + m] = quadrant_out\n   203\t        inp[r0 : r0 + k, c0 : c0 + m] = quadrant_in\n   204\t\n   205\t    try:\n   206\t        if np.array_equal(main(inp), out):\n   207\t            return inp\n   208\t    except Exception:\n   209\t        return None\n   210\t    return None\n   211\t\n   212\t\n   213\tdef generate_input() -> np.ndarray:\n   214\t    for _ in range(MAX_GENERATION_ATTEMPTS):\n   215\t        grid = _gen_attempt()\n   216\t        if grid is not None:\n   217\t            return grid\n   218\t    raise RuntimeError(\"failed to generate a valid e3fe1151 input\")\n","exit_code":0,"status":"completed"}}
