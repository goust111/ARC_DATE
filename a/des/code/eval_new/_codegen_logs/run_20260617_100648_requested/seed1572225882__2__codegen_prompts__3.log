{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"nl -ba /home/lixinyu/snap/new/ARC_code/train/34cfa167.py | sed -n '1,260p'\"","aggregated_output":"     1\tfrom __future__ import annotations\n     2\t\n     3\timport numpy as np\n     4\t\n     5\tfrom arc_utils import bbox_h, bbox_w, find_components, get_bg\n     6\timport random\n     7\t\n     8\t\n     9\tdef _is_solid_rect(g: np.ndarray, comp: dict) -> bool:\n    10\t    r0, c0, r1, c1 = comp[\"bbox\"]\n    11\t    area = int((r1 - r0 + 1) * (c1 - c0 + 1))\n    12\t    return int(comp[\"area\"]) == area and bool(np.all(g[r0 : r1 + 1, c0 : c1 + 1] == int(comp[\"color\"])))\n    13\t\n    14\t\n    15\tdef _find_structure(g: np.ndarray, bg: int) -> tuple[dict, dict, list[dict], list[dict]]:\n    16\t    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format=\"dict\")\n    17\t    rects = [comp for comp in comps if _is_solid_rect(g, comp)]\n    18\t\n    19\t    candidates: list[tuple[dict, dict, list[dict], list[dict]]] = []\n    20\t    for color in {int(comp[\"color\"]) for comp in rects}:\n    21\t        same_color = [comp for comp in rects if int(comp[\"color\"]) == color]\n    22\t        for i, a in enumerate(same_color):\n    23\t            for b in same_color[i + 1 :]:\n    24\t                if bbox_h(a[\"bbox\"]) != bbox_h(b[\"bbox\"]) or bbox_w(a[\"bbox\"]) != bbox_w(b[\"bbox\"]):\n    25\t                    continue\n    26\t\n    27\t                ar0, ac0, _ar1, _ac1 = a[\"bbox\"]\n    28\t                br0, bc0, _br1, _bc1 = b[\"bbox\"]\n    29\t                if ar0 < br0 and ac0 < bc0:\n    30\t                    source, dest = a, b\n    31\t                elif br0 < ar0 and bc0 < ac0:\n    32\t                    source, dest = b, a\n    33\t                else:\n    34\t                    continue\n    35\t\n    36\t                sr0, sc0, sr1, sc1 = source[\"bbox\"]\n    37\t                dr0, dc0, _dr1, _dc1 = dest[\"bbox\"]\n    38\t                right = [\n    39\t                    comp\n    40\t                    for comp in rects\n    41\t                    if int(comp[\"color\"]) != color\n    42\t                    and comp[\"bbox\"][0] == sr0\n    43\t                    and comp[\"bbox\"][2] == sr1\n    44\t                    and comp[\"bbox\"][1] == comp[\"bbox\"][3]\n    45\t                    and sc1 < comp[\"bbox\"][1] < dc0\n    46\t                ]\n    47\t                below = [\n    48\t                    comp\n    49\t                    for comp in rects\n    50\t                    if int(comp[\"color\"]) != color\n    51\t                    and comp[\"bbox\"][1] == sc0\n    52\t                    and comp[\"bbox\"][3] == sc1\n    53\t                    and comp[\"bbox\"][0] == comp[\"bbox\"][2]\n    54\t                    and sr1 < comp[\"bbox\"][0] < dr0\n    55\t                ]\n    56\t\n    57\t                right_with_offsets = sorted(\n    58\t                    ((int(comp[\"bbox\"][1] - sc1), comp) for comp in right),\n    59\t                    key=lambda item: item[0],\n    60\t                )\n    61\t                below_with_offsets = sorted(\n    62\t                    ((int(comp[\"bbox\"][0] - sr1), comp) for comp in below),\n    63\t                    key=lambda item: item[0],\n    64\t                )\n    65\t                if len(right_with_offsets) == 2 and len(below_with_offsets) == 2:\n    66\t                    right_offsets = [offset for offset, _comp in right_with_offsets]\n    67\t                    below_offsets = [offset for offset, _comp in below_with_offsets]\n    68\t                    if right_offsets == below_offsets and right_offsets[0] == 1:\n    69\t                        candidates.append(\n    70\t                            (\n    71\t                                source,\n    72\t                                dest,\n    73\t                                [comp for _offset, comp in right_with_offsets],\n    74\t                                [comp for _offset, comp in below_with_offsets],\n    75\t                            )\n    76\t                        )\n    77\t\n    78\t    assert len(candidates) == 1, \"expected one anchor pair with matching right and below controls\"\n    79\t    return candidates[0]\n    80\t\n    81\t\n    82\tdef _paint(out: np.ndarray, bg: int, r: int, c: int, color: int) -> None:\n    83\t    assert int(out[r, c]) in {int(bg), int(color)}, \"paint target must be empty or already matching\"\n    84\t    out[r, c] = int(color)\n    85\t\n    86\t\n    87\tdef _paint_rect(out: np.ndarray, bg: int, r0: int, c0: int, r1: int, c1: int, color: int) -> None:\n    88\t    for r in range(int(r0), int(r1) + 1):\n    89\t        for c in range(int(c0), int(c1) + 1):\n    90\t            _paint(out, bg, r, c, color)\n    91\t\n    92\t\n    93\tdef main(grid: np.ndarray) -> np.ndarray:\n    94\t    \"\"\"\n    95\t    Complete a four-corner framed rectangle from one decorated anchor rectangle and its diagonal mate.\n    96\t\n    97\t    Input structure:\n    98\t    - The background is the dominant color.\n    99\t    - Two same-color solid rectangular anchors of the same size sit on opposite\n   100\t      diagonal corners, with the first anchor above-left of the second.\n   101\t    - The upper-left anchor has two one-cell-thick vertical control bars to its\n   102\t      right and two one-cell-thick horizontal control bars below it.\n   103\t\n   104\t    Rule:\n   105\t    - Copy the anchor rectangle into the two missing corners of the implied\n   106\t      larger rectangle.\n   107\t    - Repeat the right-side control bars horizontally between the left and right\n   108\t      anchors, using their spacing as the period, and draw the outer top and\n   109\t      bottom borders in the first right-control color.\n   110\t    - Repeat the below-side control bars vertically between the top and bottom\n   111\t      anchors, using the same period, and draw the outer left and right borders\n   112\t      in the first below-control color.\n   113\t\n   114\t    Key insight: The small control bars are the first two ticks of two periodic\n   115\t    frame patterns; the diagonal anchor supplies the opposite corner and the\n   116\t    missing two anchor copies.\n   117\t    \"\"\"\n   118\t    g = np.asarray(grid, dtype=int)\n   119\t    bg = get_bg(g)\n   120\t    source, dest, right_controls, below_controls = _find_structure(g, bg)\n   121\t\n   122\t    sr0, sc0, sr1, sc1 = source[\"bbox\"]\n   123\t    dr0, dc0, dr1, dc1 = dest[\"bbox\"]\n   124\t    anchor_color = int(source[\"color\"])\n   125\t    assert int(dest[\"color\"]) == anchor_color, \"anchor colors must match\"\n   126\t    assert bbox_h(source[\"bbox\"]) == bbox_h(dest[\"bbox\"]), \"anchor heights must match\"\n   127\t    assert bbox_w(source[\"bbox\"]) == bbox_w(dest[\"bbox\"]), \"anchor widths must match\"\n   128\t    assert sr0 > 0 and sc0 > 0, \"upper-left anchor must have space for outer frame\"\n   129\t    assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], \"lower-right anchor must have space for outer frame\"\n   130\t\n   131\t    right_offsets = [int(comp[\"bbox\"][1] - sc1) for comp in right_controls]\n   132\t    below_offsets = [int(comp[\"bbox\"][0] - sr1) for comp in below_controls]\n   133\t    assert right_offsets == below_offsets and right_offsets[0] == 1, \"control offsets must match from the anchor edge\"\n   134\t    step = int(right_offsets[1] - right_offsets[0])\n   135\t    assert step > 0, \"control bars must be separated\"\n   136\t    period = 2 * step\n   137\t    assert (dc0 - 1 - sc1 - right_offsets[0]) % period == 0, \"right frame must close next to the destination anchor\"\n   138\t    assert (dr0 - 1 - sr1 - below_offsets[0]) % period == 0, \"below frame must close next to the destination anchor\"\n   139\t\n   140\t    right_colors = [int(comp[\"color\"]) for comp in right_controls]\n   141\t    below_colors = [int(comp[\"color\"]) for comp in below_controls]\n   142\t    out = g.copy()\n   143\t\n   144\t    _paint_rect(out, bg, sr0, dc0, sr1, dc1, anchor_color)\n   145\t    _paint_rect(out, bg, dr0, sc0, dr1, sc1, anchor_color)\n   146\t\n   147\t    first_c = int(sc1 + right_offsets[0])\n   148\t    last_c = int(dc0 - 1)\n   149\t    for c in range(first_c, last_c + 1):\n   150\t        offset = int(c - sc1)\n   151\t        if (offset - right_offsets[0]) % period == 0:\n   152\t            color = right_colors[0]\n   153\t        elif (offset - right_offsets[1]) % period == 0:\n   154\t            color = right_colors[1]\n   155\t        else:\n   156\t            continue\n   157\t        _paint_rect(out, bg, sr0, c, sr1, c, color)\n   158\t        _paint_rect(out, bg, dr0, c, dr1, c, color)\n   159\t\n   160\t    _paint_rect(out, bg, sr0 - 1, first_c, sr0 - 1, last_c, right_colors[0])\n   161\t    _paint_rect(out, bg, dr1 + 1, first_c, dr1 + 1, last_c, right_colors[0])\n   162\t\n   163\t    first_r = int(sr1 + below_offsets[0])\n   164\t    last_r = int(dr0 - 1)\n   165\t    left_c = int(sc0 - 1)\n   166\t    right_c = int(dc1 + 1)\n   167\t    for r in range(first_r, last_r + 1):\n   168\t        _paint(out, bg, r, left_c, below_colors[0])\n   169\t        _paint(out, bg, r, right_c, below_colors[0])\n   170\t\n   171\t        offset = int(r - sr1)\n   172\t        if (offset - below_offsets[0]) % period == 0:\n   173\t            _paint_rect(out, bg, r, left_c, r, sc1, below_colors[0])\n   174\t            _paint_rect(out, bg, r, dc0, r, right_c, below_colors[0])\n   175\t        elif (offset - below_offsets[1]) % period == 0:\n   176\t            _paint_rect(out, bg, r, sc0, r, sc1, below_colors[1])\n   177\t            _paint_rect(out, bg, r, dc0, r, dc1, below_colors[1])\n   178\t\n   179\t    return out\n   180\t\n   181\t# --------------- generator (att2, o5x) ---------------\n   182\t\n   183\t# Color sampling.\n   184\tCOLOR_COUNT, NON_BG_COLOR_COUNT = 10, 4\n   185\t\n   186\t# Anchor/repetition geometry.\n   187\tANCHOR_SIZE_RANGE = (1, 5)\n   188\tREPEAT_COUNT_RANGE = (2, 5)\n   189\tCONTROL_OFFSETS = (1, 3)\n   190\tFRAME_PERIOD, DEST_ANCHOR_GAP, STRUCTURE_FIXED_PAD = 4, 2, 3\n   191\t\n   192\t# Canvas/margins.\n   193\tCANVAS_MIN_SIZE, CANVAS_MAX_SIZE = 16, 30\n   194\tMARGIN_CHOICES = range(4)\n   195\tMIN_TOTAL_MARGIN, SOURCE_OUTER_MARGIN = 1, 1\n   196\t\n   197\t# Retry.\n   198\tMAX_GENERATION_ATTEMPTS = 300\n   199\t\n   200\t\n   201\tdef _gen_paint_rect(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int, color: int) -> None:\n   202\t    grid[r0 : r1 + 1, c0 : c1 + 1] = int(color)\n   203\t\n   204\t\n   205\tdef _choose_margins(struct_len: int) -> tuple[int, int]:\n   206\t    pairs = [\n   207\t        (before, after)\n   208\t        for before in MARGIN_CHOICES\n   209\t        for after in MARGIN_CHOICES\n   210\t        if MIN_TOTAL_MARGIN <= before + after\n   211\t        and CANVAS_MIN_SIZE <= struct_len + before + after <= CANVAS_MAX_SIZE\n   212\t    ]\n   213\t    return pairs[int(np.random.randint(len(pairs)))]\n   214\t\n   215\t\n   216\tdef _build_output(\n   217\t    rows: int,\n   218\t    cols: int,\n   219\t    bg: int,\n   220\t    anchor_color: int,\n   221\t    right1: int,\n   222\t    right2: int,\n   223\t    below1: int,\n   224\t    sr0: int,\n   225\t    sc0: int,\n   226\t    s: int,\n   227\t    nh: int,\n   228\t    nv: int,\n   229\t) -> tuple[np.ndarray, tuple[int, int, int, int, int, int, int, int]]:\n   230\t    out = np.full((rows, cols), int(bg), dtype=int)\n   231\t    sr1, sc1 = sr0 + s - 1, sc0 + s - 1\n   232\t    dr0 = sr1 + FRAME_PERIOD * nv + DEST_ANCHOR_GAP\n   233\t    dc0 = sc1 + FRAME_PERIOD * nh + DEST_ANCHOR_GAP\n   234\t    dr1, dc1 = dr0 + s - 1, dc0 + s - 1\n   235\t\n   236\t    for r0, c0 in ((sr0, sc0), (sr0, dc0), (dr0, sc0), (dr0, dc0)):\n   237\t        _gen_paint_rect(out, r0, c0, r0 + s - 1, c0 + s - 1, anchor_color)\n   238\t\n   239\t    first_c, last_c = sc1 + CONTROL_OFFSETS[0], dc0 - 1\n   240\t    for c in range(first_c, last_c + 1):\n   241\t        offset = c - sc1\n   242\t        if (offset - CONTROL_OFFSETS[0]) % FRAME_PERIOD == 0:\n   243\t            color = right1\n   244\t        elif (offset - CONTROL_OFFSETS[1]) % FRAME_PERIOD == 0:\n   245\t            color = right2\n   246\t        else:\n   247\t            continue\n   248\t        _gen_paint_rect(out, sr0, c, sr1, c, color)\n   249\t        _gen_paint_rect(out, dr0, c, dr1, c, color)\n   250\t    _gen_paint_rect(out, sr0 - 1, first_c, sr0 - 1, last_c, right1)\n   251\t    _gen_paint_rect(out, dr1 + 1, first_c, dr1 + 1, last_c, right1)\n   252\t\n   253\t    first_r, last_r = sr1 + CONTROL_OFFSETS[0], dr0 - 1\n   254\t    left_c, right_c = sc0 - 1, dc1 + 1\n   255\t    for r in range(first_r, last_r + 1):\n   256\t        out[r, left_c] = below1\n   257\t        out[r, right_c] = below1\n   258\t        offset = r - sr1\n   259\t        if (offset - CONTROL_OFFSETS[0]) % FRAME_PERIOD == 0:\n   260\t            _gen_paint_rect(out, r, left_c, r, sc1, below1)\n","exit_code":0,"status":"completed"}}
