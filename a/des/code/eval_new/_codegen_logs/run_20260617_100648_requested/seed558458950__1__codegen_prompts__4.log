{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/a/des/code/eval_new/seed558458950/1/4.py\"","aggregated_output":"\"\"\"Fill each closed region with a seed-keyed tile pattern anchored at the seed.\nInput structure:\n- Background color is black (0). Some 4-connected regions are enclosed by connected grey walls.\n- Inside each closed region is exactly one non-black, non-grey seed pixel; each seed color is unique.\n- One side of the grid contains several small framed texture sample boxes with a grey border.\n- A sample box has a 2x2 or 3x3 repeating texture in its interior and its top-left interior pixel\n  is a color tag matching a region seed color.\n\nRule:\n- Locate all rectangular grey frame components (width and height >= 3), recover the texture pattern inside each\n  frame, and build a mapping from the frame's top-left interior color tag to the texture tile.\n- Flood-fill all background components that do not touch the grid boundary; each is an enclosed region.\n- For each enclosed region, find the single adjacent non-black, non-grey seed pixel.\n- Replace every pixel of the region (including the seed) with the mapped tiled texture, using the seed coordinate\n  as the (0,0) phase alignment: seed_position maps to texture tile row/col 0/0.\n- Keep all existing grey borders and the texture sample strip unchanged.\n\nKey insight:\n- The solution needs two independent matches: color matching from seed to sample legend and positional matching from\n  seed pixel to tile phase, so the same texture can appear with different offsets across regions.\n\"\"\"\n\nfrom collections import deque\nfrom typing import Dict, Iterable, List, Optional, Set, Tuple\n\nimport numpy as np\n\n\ndef _neighbors(r: int, c: int, h: int, w: int) -> Iterable[Tuple[int, int]]:\n    if r > 0:\n        yield r - 1, c\n    if r + 1 < h:\n        yield r + 1, c\n    if c > 0:\n        yield r, c - 1\n    if c + 1 < w:\n        yield r, c + 1\n\n\ndef _flood_components(mask: np.ndarray) -> Iterable[Tuple[List[Tuple[int, int]], Tuple[int, int, int, int]]]:\n    h, w = mask.shape\n    visited = np.zeros((h, w), dtype=bool)\n    for sr in range(h):\n        for sc in range(w):\n            if not mask[sr, sc] or visited[sr, sc]:\n                continue\n            q: deque[Tuple[int, int]] = deque([(sr, sc)])\n            visited[sr, sc] = True\n            comp: List[Tuple[int, int]] = []\n            min_r, max_r = sr, sr\n            min_c, max_c = sc, sc\n            while q:\n                r, c = q.popleft()\n                comp.append((r, c))\n                if r < min_r:\n                    min_r = r\n                if r > max_r:\n                    max_r = r\n                if c < min_c:\n                    min_c = c\n                if c > max_c:\n                    max_c = c\n                for nr, nc in _neighbors(r, c, h, w):\n                    if mask[nr, nc] and not visited[nr, nc]:\n                        visited[nr, nc] = True\n                        q.append((nr, nc))\n            yield comp, (min_r, max_r, min_c, max_c)\n\n\ndef _is_rectangle_border(\n    grid: np.ndarray,\n    color: int,\n    min_r: int,\n    max_r: int,\n    min_c: int,\n    max_c: int,\n    comp_size: int,\n) -> bool:\n    h = max_r - min_r + 1\n    w = max_c - min_c + 1\n    if h < 3 or w < 3:\n        return False\n    if comp_size != 2 * (h + w - 2):\n        return False\n    sub = grid[min_r : max_r + 1, min_c : max_c + 1]\n    if not np.all(sub[0, :] == color):\n        return False\n    if not np.all(sub[-1, :] == color):\n        return False\n    if not np.all(sub[:, 0] == color):\n        return False\n    if not np.all(sub[:, -1] == color):\n        return False\n    if h > 2 and w > 2:\n        if np.any(sub[1:-1, 1:-1] == color):\n            return False\n    return True\n\n\ndef _extract_templates(\n    grid: np.ndarray, bg: int\n) -> Tuple[Dict[int, np.ndarray], List[Tuple[int, int, int, int]]]:\n    colors = np.unique(grid)\n    frame_candidates: List[Tuple[int, int, int, int, int]] = []\n    for color in colors:\n        if int(color) == bg:\n            continue\n        mask = grid == color\n        for comp, (min_r, max_r, min_c, max_c) in _flood_components(mask):\n            if _is_rectangle_border(grid, int(color), min_r, max_r, min_c, max_c, len(comp)):\n                frame_candidates.append((int(color), min_r, max_r, min_c, max_c))\n\n    if not frame_candidates:\n        return {}, []\n\n    # Keep only rectangles on one side of the grid; if none qualify, keep all.\n    h, w = grid.shape\n    side_filtered: List[Tuple[int, int, int, int, int]] = []\n    for color, min_r, max_r, min_c, max_c in frame_candidates:\n        d_top = min_r\n        d_bottom = h - 1 - max_r\n        d_left = min_c\n        d_right = w - 1 - max_c\n        if min(d_top, d_bottom, d_left, d_right) <= 1:\n            side_filtered.append((color, min_r, max_r, min_c, max_c))\n\n    candidates = side_filtered if side_filtered else frame_candidates\n\n    templates: Dict[int, np.ndarray] = {}\n    valid_frames: List[Tuple[int, int, int, int]] = []\n    for color, min_r, max_r, min_c, max_c in candidates:\n        inner = grid[min_r + 1 : max_r, min_c + 1 : max_c]\n        if inner.size == 0:\n            continue\n        tag = int(inner[0, 0])\n        if tag == bg or tag == color:\n            continue\n        tile = _infer_tile(inner, tag, bg, color)\n        if tile is None:\n            continue\n        if tag not in templates:\n            templates[tag] = tile\n            valid_frames.append((min_r, max_r, min_c, max_c))\n\n    return templates, valid_frames\n\n\ndef _infer_tile(\n    inner: np.ndarray, tag_color: int, bg: int, frame_color: int\n) -> Optional[np.ndarray]:\n    h, w = inner.shape\n    if h <= 0 or w <= 0:\n        return None\n    if tag_color == bg or tag_color == frame_color:\n        return None\n\n    def _perfect_period(size: int) -> Optional[np.ndarray]:\n        if h % size != 0 or w % size != 0:\n            return None\n        tile = inner[:size, :size]\n        rep_h = h // size\n        rep_w = w // size\n        rep = np.tile(tile, (rep_h, rep_w))\n        if np.array_equal(inner, rep):\n            return tile\n        return None\n\n    tile = _perfect_period(2)\n    if tile is not None:\n        return tile\n    tile = _perfect_period(3)\n    if tile is not None:\n        return tile\n\n    if h <= 3 and w <= 3:\n        return inner.copy()\n    # Fallback: choose the smaller mismatch tile size to stay near the intended 2x2 or 3x3 structure.\n    best = None\n    best_err = 1e9\n    for size in (2, 3):\n        if h < size or w < size:\n            continue\n        tile = inner[:size, :size]\n        rep_h = int(np.ceil(h / size))\n        rep_w = int(np.ceil(w / size))\n        rep = np.tile(tile, (rep_h, rep_w))[:h, :w]\n        err = float(np.mean(rep != inner))\n        if err < best_err:\n            best_err = err\n            best = tile.copy()\n    return best\n\n\ndef _collect_enclosed_background_regions(\n    grid: np.ndarray, bg: int\n) -> List[Set[Tuple[int, int]]]:\n    mask = grid == bg\n    h, w = grid.shape\n    regions: List[Set[Tuple[int, int]]] = []\n    visited = np.zeros((h, w), dtype=bool)\n    for sr in range(h):\n        for sc in range(w):\n            if not mask[sr, sc] or visited[sr, sc]:\n                continue\n            q: deque[Tuple[int, int]] = deque([(sr, sc)])\n            visited[sr, sc] = True\n            comp: Set[Tuple[int, int]] = set()\n            touches_border = sr == 0 or sr == h - 1 or sc == 0 or sc == w - 1\n            while q:\n                r, c = q.popleft()\n                comp.add((r, c))\n                if r == 0 or r == h - 1 or c == 0 or c == w - 1:\n                    touches_border = True\n                for nr, nc in _neighbors(r, c, h, w):\n                    if mask[nr, nc] and not visited[nr, nc]:\n                        visited[nr, nc] = True\n                        q.append((nr, nc))\n            if not touches_border:\n                regions.append(comp)\n    return regions\n\n\ndef _find_seed_for_region(\n    grid: np.ndarray,\n    region: Set[Tuple[int, int]],\n    bg: int,\n    wall_colors: Tuple[Set[int], int],\n    valid_tags: Set[int],\n) -> Optional[Tuple[int, int, int]]:\n    grey_set, grey = wall_colors\n    h, w = grid.shape\n    for r, c in region:\n        for nr, nc in _neighbors(r, c, h, w):\n            color = int(grid[nr, nc])\n            if color in valid_tags and color != bg and color not in grey_set and color != grey:\n                return nr, nc, color\n    return None\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    inp = np.array(grid, dtype=int)\n    if inp.ndim != 2:\n        raise ValueError(\"main expects a 2D grid\")\n\n    bg = 0\n    templates, _ = _extract_templates(inp, bg)\n    if not templates:\n        return inp.copy()\n\n    out = inp.copy()\n    regions = _collect_enclosed_background_regions(inp, bg)\n    valid_tags = set(templates.keys())\n    # Treat the template frame color as wall; fallback to all non-bg colors if no match.\n    wall_colors = (set(np.unique(inp).tolist()), int(next(iter(templates.values())).__class__ is np.ndarray))\n    for region in regions:\n        found = _find_seed_for_region(inp, region, bg, (valid_tags, int(-1)), valid_tags)\n        if found is None:\n            continue\n        sr, sc, tag = found\n        tile = templates[tag]\n","exit_code":0,"status":"completed"}}
