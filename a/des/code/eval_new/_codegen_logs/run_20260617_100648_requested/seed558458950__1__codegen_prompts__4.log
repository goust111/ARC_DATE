{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '260,520p' /home/lixinyu/snap/a/des/code/eval_new/seed558458950/1/4.py\"","aggregated_output":"        tile = templates[tag]\n        th, tw = tile.shape\n        for r, c in region:\n            out[r, c] = tile[(r - sr) % th, (c - sc) % tw]\n        # Seed pixel is normally outside background component, cover it as well.\n        out[sr, sc] = tile[0, 0]\n\n    return out\n\n\ndef _draw_rect_frame(\n    grid: np.ndarray,\n    y0: int,\n    y1: int,\n    x0: int,\n    x1: int,\n    wall: int,\n) -> None:\n    grid[y0, x0 : x1 + 1] = wall\n    grid[y1, x0 : x1 + 1] = wall\n    grid[y0 : y1 + 1, x0] = wall\n    grid[y0 : y1 + 1, x1] = wall\n\n\ndef _tile_repeat(tile: np.ndarray, h: int, w: int) -> np.ndarray:\n    rep_h = int(np.ceil(h / tile.shape[0]))\n    rep_w = int(np.ceil(w / tile.shape[1]))\n    return np.tile(tile, (rep_h, rep_w))[:h, :w]\n\n\ndef _pick_distinct_colors(rng: np.random.Generator, k: int) -> List[int]:\n    pool = [1, 2, 3, 4, 5, 6, 8, 9, 10, 11, 12, 13, 14, 15]\n    if k > len(pool):\n        k = len(pool)\n    perm = rng.permutation(pool)\n    return [int(c) for c in perm[:k]]\n\n\ndef _is_free(\n    occ: np.ndarray, y0: int, y1: int, x0: int, x1: int, margin: int = 1\n) -> bool:\n    h, w = occ.shape\n    y0 = max(0, y0 - margin)\n    x0 = max(0, x0 - margin)\n    y1 = min(h - 1, y1 + margin)\n    x1 = min(w - 1, x1 + margin)\n    return not np.any(occ[y0 : y1 + 1, x0 : x1 + 1])\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n    h = int(rng.integers(20, 30))\n    w = int(rng.integers(20, 30))\n    bg = 0\n    wall = 7\n    grid = np.full((h, w), bg, dtype=int)\n    occ = np.zeros((h, w), dtype=bool)\n\n    side = rng.choice(np.array([\"top\", \"right\", \"bottom\", \"left\"]))\n    num_templates = int(rng.integers(2, 5))\n    num_templates = min(num_templates, 4)\n\n    template_colors = _pick_distinct_colors(rng, num_templates)\n    template_meta: List[Tuple[int, int, int, int, int, int]] = []\n    if side in (\"top\", \"bottom\"):\n        x = 1\n        y = 0 if side == \"top\" else h - 1\n    else:\n        y = 1\n        x = 0 if side == \"left\" else w - 1\n\n    used_templates = 0\n    for i in range(num_templates):\n        base = int(rng.choice(np.array([2, 3])))\n        rep = int(rng.integers(1, 3))\n        inner_h = base * rep\n        inner_w = base * rep\n        frame_h = inner_h + 2\n        frame_w = inner_w + 2\n        if side in (\"top\", \"bottom\"):\n            if x + frame_w + 1 >= w:\n                break\n            y0 = y if side == \"top\" else y - frame_h\n            if y0 < 0 or y0 + frame_h > h:\n                break\n            x0, x1 = x, x + frame_w - 1\n            y1 = y0 + frame_h - 1\n            x = x1 + 2\n        else:\n            if y + frame_h + 1 >= h:\n                break\n            x0 = x if side == \"left\" else x - frame_w\n            if x0 < 0 or x0 + frame_w > w:\n                break\n            y0, y1 = y, y + frame_h - 1\n            x1 = x0 + frame_w - 1\n            y = y1 + 2\n\n        if x0 < 0 or x1 >= w or y0 < 0 or y1 >= h:\n            continue\n\n        _draw_rect_frame(grid, y0, y1, x0, x1, wall)\n        occ[y0 : y1 + 1, x0 : x1 + 1] = True\n\n        tag = template_colors[i]\n        tile = np.fromiter((int(rng.choice(template_colors)) for _ in range(base * base)), dtype=int).reshape((base, base))\n        tile[0, 0] = tag\n        while tile[0, 0] != tag:\n            tile[0, 0] = tag\n\n        # Fill interior by repeated tile (size may exceed 2/3 multiples).\n        inner = _tile_repeat(tile, inner_h, inner_w)\n        grid[y0 + 1 : y1, x0 + 1 : x1] = inner\n        occ[y0 + 1 : y1, x0 + 1 : x1] = True\n        template_meta.append((tag, y0, y1, x0, x1, frame_h))\n        used_templates += 1\n\n    if used_templates == 0:\n        return grid\n\n    template_colors = template_colors[:used_templates]\n\n    # Create closed regions with unique seed colors.\n    num_regions = int(rng.integers(1, used_templates + 1))\n    region_colors = _pick_distinct_colors(rng, num_regions)\n    if num_regions > used_templates:\n        num_regions = used_templates\n        region_colors = region_colors[:num_regions]\n        template_colors = template_colors[:num_regions]\n\n    attempts = 0\n    for i in range(num_regions):\n        if attempts > 3000:\n            break\n        seed_color = template_colors[i]\n        inner_h = int(rng.integers(3, 8))\n        inner_w = int(rng.integers(3, 8))\n        if side in (\"top\", \"bottom\"):\n            y_lo = 1\n            y_hi = h - inner_h - 3\n            x_lo = 1\n            x_hi = w - inner_w - 1\n            if side == \"top\":\n                y_lo = min(h // 2, max(1, y_hi))\n            else:\n                y_hi = max(inner_h + 2, h // 2 - 1) if side == \"bottom\" else h - inner_h - 3\n        else:\n            y_lo = 1\n            y_hi = h - inner_h - 1\n            x_lo = 1\n            x_hi = w - inner_w - 1\n            if side == \"left\":\n                x_lo = template_colors.__len__() + 2\n            else:\n                x_hi = w - inner_w - 2 - template_colors.__len__()\n        found = False\n        for _ in range(200):\n            attempts += 1\n            ry = int(rng.integers(y_lo, max(y_lo + 1, y_hi)))\n            rx = int(rng.integers(x_lo, max(x_lo + 1, x_hi)))\n            y0 = max(0, ry - 1)\n            x0 = max(0, rx - 1)\n            y1 = y0 + inner_h + 1\n            x1 = x0 + inner_w + 1\n            if y1 >= h - 1 or x1 >= w - 1:\n                continue\n            if not _is_free(occ, y0, y1, x0, x1, margin=1):\n                continue\n            # Draw region border and seed.\n            _draw_rect_frame(grid, y0, y1, x0, x1, wall)\n            occ[y0 : y1 + 1, x0 : x1 + 1] = True\n            sr = int(rng.integers(y0 + 1, y1))\n            sc = int(rng.integers(x0 + 1, x1))\n            grid[sr, sc] = seed_color\n            found = True\n            break\n        if not found:\n            continue\n\n    return grid\n\n","exit_code":0,"status":"completed"}}
