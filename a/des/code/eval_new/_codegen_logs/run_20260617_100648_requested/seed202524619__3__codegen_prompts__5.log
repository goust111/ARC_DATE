ted[r, c] = True\n            pts = []\n            while stack:\n                cr, cc = stack.pop()\n                pts.append((cr, cc))\n                for dr, dc in dirs:\n                    nr, nc = cr + dr, cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not visited[nr, nc]:\n                        visited[nr, nc] = True\n                        stack.append((nr, nc))\n            comps.append(pts)\n    return comps\n\n\ndef _component_bbox(pts):\n    rs = [p[0] for p in pts]\n    cs = [p[1] for p in pts]\n    r0, r1 = min(rs), max(rs)\n    c0, c1 = min(cs), max(cs)\n    return r0, c0, r1, c1\n\n\ndef _component_patch(grid: np.ndarray, pts):\n    r0, c0, r1, c1 = _component_bbox(pts)\n    h = r1 - r0 + 1\n    w = c1 - c0 + 1\n    patch = np.zeros((h, w), dtype=grid.dtype)\n    mask = np.zeros((h, w), dtype=bool)\n    for r, c in pts:\n        val = grid[r, c]\n        patch[r - r0, c - c0] = val\n        if val \"'!= BG:\n            mask[r - r0, c - c0] = True\n    return patch, mask\n\n\ndef _find_frames(grid: np.ndarray):\n    h, w = grid.shape\n    frames = []\n    is_border = np.zeros_like(grid, dtype=bool)\n\n    for comp in _connected_components(grid != BG):\n        first = comp[0]\n        color = int(grid[first])\n        if color == BG:\n            continue\n\n        if any(grid[r, c] != color for r, c in comp):\n            continue\n\n        r0, c0, r1, c1 = _component_bbox(comp)\n        hh = r1 - r0 + 1\n        ww = c1 - c0 + 1\n        if hh < 3 or ww < 3:\n            continue\n        if len(comp) != 2 * (hh + ww) - 4:\n            continue\n        if not (r0 == 0 or c0 == 0 or r1 == h - 1 or c1 == w - 1):\n            continue\n\n        comp_set = set(comp)\n        good = True\n\n        for rr in range(r0, r1 + 1):\n            if grid[rr, c0] != color or (rr, c0) not in comp_set:\n                good = False\n                break\n            if grid[rr, c1] != color or (rr, c1) not in comp_set:\n                good = False\n                break\n        if not good:\n            continue\n\n        for cc in range(c0, c1 + 1):\n            if grid[r0, cc] != color or (r0, cc) not in comp_set:\n                good = False\n                break\n            if grid[r1, cc] != color or (r1, cc) not in comp_set:\n                good = False\n                break\n        if not good:\n            continue\n\n        for rr in range(r0 + 1, r1):\n            for cc in range(c0 + 1, c1):\n                if grid[rr, cc] == color:\n                    good = False\n                    break\n            if not good:\n                break\n\n        if not good:\n            continue\n\n        frame = {\n            \"r0\": r0,\n            \"c0\": c0,\n            \"r1\": r1,\n            \"c1\": c1,\n            \"color\": color,\n            \"marker\": None,\n            \"border\": comp,\n        }\n        frames.append(frame)\n        for rr, cc in comp:\n            is_border[rr, cc] = True\n\n    return frames, is_border\n\n\ndef _component_inside(grid: np.ndarray, sr: int, sc: int, r0: int, c0: int, r1: int, c1: int):\n    if not (r0 < sr < r1 and c0 < sc < c1):\n        return []\n    if grid[sr, sc] == BG:\n        return []\n\n    h, w = grid.shape\n    visited = np.zeros((h, w), dtype=bool)\n    stack = [(sr, sc)]\n    visited[sr, sc] = True\n    pts = []\n\n    while stack:\n        r, c = stack.pop()\n        pts.append((r, c))\n        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n            nr, nc = r + dr, c + dc\n            if not (r0 < nr < r1 and c0 < nc < c1):\n                continue\n            if visited[nr, nc] or grid[nr, nc] == BG:\n                continue\n            visited[nr, nc] = True\n            stack.append((nr, nc))\n\n    return pts\n\n\ndef _frame_marker(grid: np.ndarray, frame):\n    r0, c0, r1, c1 = frame[\"r0\"], frame[\"c0\"], frame[\"r1\"], frame[\"c1\"]\n    if r0 + 1 >= r1 or c0 + 1 >= c1:\n        return None\n\n    start = None\n    if grid[r0 + 1, c0 + 1] != BG:\n        start = (r0 + 1, c0 + 1)\n    else:\n        for rr in range(r0 + 1, r1):\n            for cc in range(c0 + 1, c1):\n                if grid[rr, cc] != BG:\n                    start = (rr, cc)\n                    break\n            if start is not None:\n                break\n\n    if start is None:\n        return None\n\n    pts = _component_inside(grid, start[0], start[1], r0, c0, r1, c1)\n    if not pts:\n        return None\n    patch, mask = _component_patch(grid, pts)\n    return {\n        \"points\": pts,\n        \"patch\": patch,\n        \"mask\": mask,\n        \"bbox\": _component_bbox(pts),\n        \"type\": _symmetry_class(mask),\n    }\n\n\ndef _random_transformed_mask(mask: np.ndarray, target_type: str, rng: np.random.Generator):\n    variants = []\n    for k in range(4):\n        m = np.rot90(mask, k)\n        variants.append(m)\n        variants.append(np.fliplr(m))\n        variants.append(np.flipud(m))\n\n    seen = set()\n    valid = []\n    for m in variants:\n        key = m.tobytes()\n        if key in seen:\n            continue\n        seen.add(key)\n        if _symmetry_class(m) == target_type:\n            valid.append(m)\n\n    if not valid:\n        return mask.astype(np.uint8)\n\n    return valid[int(rng.integers(0, len(valid)))]\n\n\ndef _paint_shape(mask: np.ndarray, rng: np.random.Generator) -> tuple:\n    coords = np.argwhere(mask)\n    h, w = mask.shape\n    patch = np.zeros((h, w), dtype=np.int64)\n    if len(coords) == 0:\n        return patch, np.zeros((h, w), dtype=bool)\n\n    colors = rng.choice(_OBJECT_COLORS, size=len(coords), replace=True)\n    if len(coords) > 1 and np.all(colors == colors[0]):\n        colors[1] = _OBJECT_COLORS[(np.where(_OBJECT_COLORS == colors[0])[0][0] + 1) % len(_OBJECT_COLORS)]\n\n    for (rr, cc), col in zip(coords, colors):\n        patch[rr, cc] = int(col)\n\n    return patch, (patch != BG)\n\n\ndef _rand_in_range_inclusive(rng: np.random.Generator, lo: int, hi: int) -> int:\n    if lo == hi:\n        return lo\n    return int(rng.integers(lo, hi + 1))\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Sort small disconnected objects into edge boxes by their shape symmetry type.\nInput structure:\n- bg is black.\n- Several 4-connected colored objects of area 2~6 sit away from the border.\n- Several rectangular frames are drawn on the border; each frame has one top-left interior sample pattern indicating a symmetry type.\nRule:\n- Ignore object colors and compute symmetry of each object mask over 4-connected components outside frames: only-horizontal, only-vertical, or neither.\n- Decode each frame'\"'s type from its top-left marker component with the same symmetry test.\n- For each type, copy matching objects into that frame in ascending area order, left-to-right with exactly one black column between objects; keep original color and shape.\n- Clear all original object pixels outside frames to black.\nKey insight:\n- The grouping key is shape symmetry of the masked object, while color is decorative; frame markers are the only keys for matching each group.\\\"\\\"\\\"\n    h, w = grid.shape\n    frames, is_border = _find_frames(grid)\n\n    for frame in frames:\n        frame[\\\"marker\\\"] = _frame_marker(grid, frame)\n\n    is_marker = np.zeros_like(grid, dtype=bool)\n    for frame in frames:\n        marker = frame[\\\"marker\\\"]\n        if marker is None:\n            continue\n        for rr, cc in marker[\\\"points\\\"]:\n            is_marker[rr, cc] = True\n\n    object_cells = (grid \"'!= BG) & (~is_border) & (~is_marker)\n    objects = _connected_components(object_cells)\n\n    grouped = {\n        \"horizontal\": [],\n        \"vertical\": [],\n        \"neither\": [],\n    }\n\n    for comp in objects:\n        area = len(comp)\n        if area < 2 or area > 6:\n            continue\n        patch, mask = _component_patch(grid, comp)\n        cls = _symmetry_class(mask)\n        if cls not in grouped:\n            continue\n        grouped[cls].append((area, patch, mask))\n\n    for k in grouped:\n        grouped[k].sort(key=lambda it: it[0])\n\n    type_to_frame = {}\n    for frame in frames:\n        marker = frame[\"marker\"]\n        if marker is None or marker[\"type\"] == \"both\":\n            continue\n        if marker[\"type\"] in (\"horizontal\", \"vertical\", \"neither\"):\n            type_to_frame.setdefault(marker[\"type\"], frame)\n\n    out = np.zeros_like(grid)\n    for frame in frames:\n        r0, c0, r1, c1, color = frame[\"r0\"], frame[\"c0\"], frame[\"r1\"], frame[\"c1\"], frame[\"color\"]\n        out[r0, c0 : c1 + 1] = color\n        out[r1, c0 : c1 + 1] = color\n        out[r0 : r1 + 1, c0] = color\n        out[r0 : r1 + 1, c1] = color\n        marker = frame[\"marker\"]\n        if marker is not None:\n            patch = marker[\"patch\"]\n            ph, pw = patch.shape\n            mr0, mc0 = marker[\"bbox\"][0], marker[\"bbox\"][1]\n            for rr in range(ph):\n                for cc in range(pw):\n                    val = patch[rr, cc]\n                    if val != BG:\n                        out[mr0 + rr, mc0 + cc] = val\n\n    for typ, lst in grouped.items():\n        frame = type_to_frame.get(typ)\n        if frame is None or not lst:\n            continue\n\n        y = frame[\"r0\"] + 1\n        x = frame[\"c0\"] + 1\n        marker = frame[\"marker\"]\n        if marker is not None:\n            x = max(x, marker[\"bbox\"][3] + 2)\n\n        for _, patch, mask in lst:\n            ph, pw = patch.shape\n            if y + ph > frame[\"r1\"]:\n                break\n            if x + pw > frame[\"c1\"]:\n                break\n            out[y : y + ph, x : x + pw][mask] = patch[mask]\n            x += pw + 1\n\n    return out\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n    types = [\"horizontal\", \"vertical\", \"neither\"]\n\n    for _ in range(250):\n        k = int(rng.choice([2, 3]))\n        order = np.array(types)\n        rng.shuffle(order)\n        active = list(order[:k])\n\n        object_counts = {t: 1 for t in active}\n        if k == 2:\n            if rng.random() < 0.6:\n                object_counts[rng.choice(active)] += 1\n            if rng.random() < 0.2:\n                object_counts[rng.choice(active)] += 1\n        else:\n            if rng.random() < 0.45:\n                object_counts[rng.choice(active)] += 1\n\n        objects = []\n        frame_specs = {}\n        for t in active:\n            marker_mask = _random_transformed_mask(_MARKER_TEMPLATES[t], t, rng)\n            marker_color = int(rng.choice(_MARKER_COLORS))\n            marker_patch, marker_mask_bool = _paint_shape(marker_mask, rng)\n            marker_patch[marker_patch == BG] = marker_color\n            marker_obj = {\n                \"type\": t,\n                \"patch\": marker_patch,\n                \"mask\": marker_mask_bool,\n            }\n\n            obj_list = []\n            for _ in range(object_counts[t]):\n                base = _random_transformed_mask(rng.choice(_OBJECT_TEMPLATES[t]), t, rng)\n                patch, omask = _paint_shape(base, rng)\n                obj_list.append({\"patch\": patch, \"mask\": omask, \"shape\": base})\n\n            widths = [o[\"patch\"].shape[1] for o in obj_list]\n            need_inner = marker_mask.shape[1] + 1 + sum(widths) + max(0, len(widths) - 1)\n            frame_width = need_inner + int(rng.integers(1, 3))\n            frame_specs[t] = {\n                \"width\": int(frame_width),\n                \"count\": len(obj_list),\n                \"objects\": obj_list,\n                \"marker\": marker_obj,\n                \"marker_color\": marker_color,\n            }\n            objects.extend(obj_list)\n\n        if any(spec[\"width\"] < 5 for spec in frame_specs.values()):\n            continue\n\n        total_span = sum(spec[\"width\"] + 1 for spec in frame_specs.values()) - 1\n        if total_span > 30:\n            continue\n\n        active_order = active.copy()\n        rng.shuffle(active_order)\n        max_h = max(max(spec[\"marker\"][\"patch\"].shape[0], max((o[\"patch\"].shape[0] for o in spec[\"objects\"])) ) for spec in frame_specs.values() for spec in [spec])\n        max_obj_h = int(max_h)\n        h_limit = 30\n        hmin = FRAME_HEIGHT + 2 + max_obj_h\n        h = int(rng.integers(max(hmin, 12), h_limit - 4 + 1))\n        w = int(rng.integers(total_span + 1, 31))\n        if w > 30 or h > 30:\n            continue\n\n        frames = []\n        x = 0\n        for t in active_order:\n            fw = frame_specs[t][\"width\"]\n            if fw < 6:\n                fw = 6\n            c0 = x\n            c1 = c0 + fw - 1\n            if c1 >= w:\n                break\n            frames.append({\n                \"type\": t,\n                \"r0\": 0,\n                \"r1\": FRAME_HEIGHT - 1,\n                \"c0\": c0,\n                \"c1\": c1,\n                \"color\": int(rng.choice(_FRAME_COLORS)),\n                \"marker\": frame_specs[t][\"marker\"],\n                \"marker_color\": frame_specs[t][\"marker_color\"],\n            })\n            x = c1 + 2\n\n        if len(frames) != len(active_order):\n            continue\n\n        occ = np.zeros((h, w), dtype=bool)\n        grid = np.zeros((h, w), dtype=np.int64)\n\n        for fr in frames:\n            r0, c0, r1, c1 = fr[\"r0\"], fr[\"c0\"], fr[\"r1\"], fr[\"c1\"]\n            col = fr[\"color\"]\n            occ[r0, c0 : c1 + 1] = True\n            occ[r1, c0 : c1 + 1] = True\n            occ[r0 : r1 + 1, c0] = True\n            occ[r0 : r1 + 1, c1] = True\n\n            grid[r0, c0 : c1 + 1] = col\n            grid[r1, c0 : c1 + 1] = col\n            grid[r0 : r1 + 1, c0] = col\n            grid[r0 : r1 + 1, c1] = col\n\n            marker = fr[\"marker\"]\n            mp = marker[\"patch\"]\n            mr, mc = marker[\"patch\"].shape\n            start_r = r0 + 1\n            start_c = c0 + 1\n            if start_c + mc > c1 or start_r + mr > r1:\n                break\n            placed = False\n            for rr in range(mr):\n                for cc in range(mc):\n                    val = mp[rr, cc]\n                    if val != BG:\n                        if occ[start_r + rr, start_c + cc]:\n                            placed = True\n                            break\n                        occ[start_r + rr, start_c + cc] = True\n                        grid[start_r + rr, start_c + cc] = int(val)\n                if placed:\n                    break\n            if placed:\n                break\n\n        if any(fr[\"r1\"] >= h or fr[\"c1\"] >= w for fr in frames):\n            continue\n        if any(any(fr[\"c0\"] <= 0 for fr in frames) for _ in [None]):\n            pass\n\n        all_objs = []\n        for fr in frames:\n            fr_spec = frame_specs[fr[\"type\"]]\n            for o in fr_spec[\"objects\"]:\n                all_objs.append(o)\n\n        rng.shuffle(all_objs)\n\n        for obj in all_objs:\n            ph, pw = obj[\"patch\"].shape\n            min_r = FRAME_HEIGHT + 1\n            if h - ph < min_r:\n                break\n\n            placed = False\n            for _ in range(200):\n                rr = int(rng.integers(min_r, h - ph + 1))\n                cc = int(rng.integers(0, w - pw + 1))\n                rr0, rr1 = max(0, rr - 1), min(h, rr + ph + 1)\n                cc0, cc1 = max(0, cc - 1), min(w, cc + pw + 1)\n                if np.any(occ[rr0:rr1, cc0:cc1]):\n                    continue\n\n                grid[rr : rr + ph, cc : cc + pw][obj[\"mask\"]] = obj[\"patch\"][obj[\"mask\"]]\n                occ[rr : rr + ph, cc : cc + pw] |= obj[\"mask\"]\n                placed = True\n                break\n\n            if not placed:\n                break\n        else:\n            # additional guard: