{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"cat > /home/lixinyu/snap/a/des/code/eval_new/seed558458950/2/1.py <<'PY'\n\\\"\\\"\\\"Grow each seed-directed rectangular frame outward through a keyed directional legend.\n\nInput structure:\n- The background is black (0).\n- Inside the grid are several disjoint closed, 1-pixel-thick rectangular frames (non-black colors), each containing exactly one interior seed pixel of another color.\n- Along the border, a legend lists seed colors: each entry has a color block and a nearby 3-cell grey L-shaped arrow.\n- The arrow direction maps that seed color to a growth direction among up, down, left, right.\n\nRule:\n- Locate every closed rectangular frame by verifying a perimeter-only 4-neighbor component and detect its single interior seed color.\n- Read the frame's seed color in the legend to get the growth direction.\n- Open the entire non-corner segment on the corresponding frame side by setting those pixels to black.\n- Remove the seed pixel (set it to black).\n- Create a new hollow contour outside the frame in the seed color: the side perpendicular to growth has the same length as the opened side, while the side parallel to growth has half the original frame size in that growth direction (floor).\n- Only draw the new contour; do not recolor other pixels.\n\nKey insight:\n- Seed colors are lookup keys, not behavior colors: the legend maps each seed color to a direction.\n- Frame geometry uniquely determines opening location and copied contour size.\n\\\"\\\"\\\"\n\nfrom __future__ import annotations\n\nimport random\nfrom collections import deque\nfrom typing import Dict, Iterable, List, Sequence, Set, Tuple\n\nimport numpy as np\n\n\nBG = 0\nGREY = 9\n\nFRAME_COLORS: Sequence[int] = (1, 2, 3, 4)\nSEED_COLORS: Sequence[int] = (5, 6, 7, 8)\nDIRECTIONS = (\\\"up\\\", \\\"down\\\", \\\"left\\\", \\\"right\\\")\n\n\ndef _neighbors4(r: int, c: int, h: int, w: int) -> Iterable[Tuple[int, int]]:\n    if r > 0:\n        yield r - 1, c\n    if r + 1 < h:\n        yield r + 1, c\n    if c > 0:\n        yield r, c - 1\n    if c + 1 < w:\n        yield r, c + 1\n\n\ndef _legend_arrow_offsets(direction: str) -> List[Tuple[int, int]]:\n    if direction == \\\"right\\\":\n        return [(0, 1), (0, 2), (-1, 2)]\n    if direction == \\\"left\\\":\n        return [(0, -1), (0, -2), (-1, -2)]\n    if direction == \\\"down\\\":\n        return [(1, 0), (2, 0), (2, -1)]\n    if direction == \\\"up\\\":\n        return [(-1, 0), (-2, 0), (-2, -1)]\n    raise ValueError(direction)\n\n\ndef _draw_rect_outline(grid: np.ndarray, color: int, r0: int, r1: int, c0: int, c1: int) -> None:\n    grid[r0, c0 : c1 + 1] = color\n    grid[r1, c0 : c1 + 1] = color\n    grid[r0 : r1 + 1, c0] = color\n    grid[r0 : r1 + 1, c1] = color\n\n\ndef _mark_rect_outline(mask: np.ndarray, r0: int, r1: int, c0: int, c1: int) -> None:\n    mask[r0, c0 : c1 + 1] = True\n    mask[r1, c0 : c1 + 1] = True\n    mask[r0 : r1 + 1, c0] = True\n    mask[r0 : r1 + 1, c1] = True\n\n\ndef _find_legend(grid: np.ndarray) -> Dict[int, str]:\n    h, w = grid.shape\n    mapping: Dict[int, str] = {}\n\n    for r in range(h):\n        for c in range(w):\n            if not (r == 0 or c == 0 or r == h - 1 or c == w - 1):\n                continue\n\n            color = int(grid[r, c])\n            if color in (BG, GREY):\n                continue\n            if color in mapping:\n                continue\n\n            for direction in DIRECTIONS:\n                offsets = _legend_arrow_offsets(direction)\n                ok = True\n                for dr, dc in offsets:\n                    rr = r + dr\n                    cc = c + dc\n                    if not (0 <= rr < h and 0 <= cc < w):\n                        ok = False\n                        break\n                    if int(grid[rr, cc]) \"'!= GREY:\n                        ok = False\n                        break\n                if ok:\n                    mapping[color] = direction\n                    break\n\n    return mapping\n\n\ndef _connected_components(grid: np.ndarray) -> List[Set[Tuple[int, int]]]:\n    h, w = grid.shape\n    visited = np.zeros((h, w), dtype=bool)\n    comps: List[Set[Tuple[int, int]]] = []\n\n    for i in range(h):\n        for j in range(w):\n            v = int(grid[i, j])\n            if v == BG or v == GREY or visited[i, j]:\n                continue\n\n            q = deque([(i, j)])\n            visited[i, j] = True\n            comp: Set[Tuple[int, int]] = {(i, j)}\n\n            while q:\n                r, c = q.popleft()\n                for rr, cc in _neighbors4(r, c, h, w):\n                    if visited[rr, cc]:\n                        continue\n                    if int(grid[rr, cc]) == BG or int(grid[rr, cc]) == GREY:\n                        continue\n                    visited[rr, cc] = True\n                    q.append((rr, cc))\n                    comp.add((rr, cc))\n\n            comps.append(comp)\n\n    return comps\n\n\ndef _iter_perimeter_points(r0: int, c0: int, r1: int, c1: int) -> Iterable[Tuple[int, int]]:\n    for cc in range(c0, c1 + 1):\n        yield r0, cc\n        yield r1, cc\n    for rr in range(r0 + 1, r1):\n        yield rr, c0\n        yield rr, c1\n\n\ndef _rect_from_component(grid: np.ndarray, comp: Set[Tuple[int, int]]) -> Tuple[int, int, int, int] | None:\n    rs = [p[0] for p in comp]\n    cs = [p[1] for p in comp]\n    r0, r1 = min(rs), max(rs)\n    c0, c1 = min(cs), max(cs)\n    h = r1 - r0 + 1\n    w = c1 - c0 + 1\n\n    if h < 3 or w < 3:\n        return None\n\n    if len(comp) != 2 * (h + w) - 4:\n        return None\n\n    perimeter = set(_iter_perimeter_points(r0, c0, r1, c1))\n    if comp != perimeter:\n        return None\n\n    if (0 in (r0, c0)) or (0 in (r1, c1)):\n        # legend should be on edge, and we do not treat edge-touching frames as candidates.\n        return None\n\n    for rr in range(r0 + 1, r1):\n        for cc in range(c0 + 1, c1):\n            if int(grid[rr, cc]) != BG:\n                return None\n\n    return r0, c0, r1, c1\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    h, w = grid.shape\n    out = np.array(grid, copy=True)\n    legend = _find_legend(grid)\n\n    comps = _connected_components(grid)\n    for comp in comps:\n        rect = _rect_from_component(grid, comp)\n        if rect is None:\n            continue\n\n        r0, c0, r1, c1 = rect\n        inner = [\n            (r, c)\n            for r in range(r0 + 1, r1)\n            for c in range(c0 + 1, c1)\n            if int(grid[r, c]) != BG\n        ]\n        if len(inner) != 1:\n            continue\n\n        seed_r, seed_c = inner[0]\n        seed_color = int(grid[seed_r, seed_c])\n        direction = legend.get(seed_color)\n        if direction is None:\n            continue\n\n        height = r1 - r0 + 1\n        width = c1 - c0 + 1\n\n        # 1) erase the opening in the matching side\n        if direction == \"right\":\n            for rr in range(r0 + 1, r1):\n                out[rr, c1] = BG\n        elif direction == \"left\":\n            for rr in range(r0 + 1, r1):\n                out[rr, c0] = BG\n        elif direction == \"down\":\n            for cc in range(c0 + 1, c1):\n                out[r1, cc] = BG\n        else:  # up\n            for cc in range(c0 + 1, c1):\n                out[r0, cc] = BG\n\n        # 2) remove seed pixel\n        out[seed_r, seed_c] = BG\n\n        # 3) grow a scaled copy using seed color as contour color\n        if direction in (\"right\", \"left\"):\n            copy_h = width - 2\n            copy_w = max(1, height // 2)\n\n            if direction == \"right\":\n                nr0, nr1 = r0 + 1, r1 - 1\n                nc0, nc1 = c1 + 1, c1 + copy_w\n            else:\n                nr0, nr1 = r0 + 1, r1 - 1\n                nc1, nc0 = c0 - 1, c0 - copy_w\n\n            if nc0 < 0 or nc1 >= w or nr0 < 0 or nr1 >= h or nc0 > nc1:\n                continue\n            _draw_rect_outline(out, seed_color, nr0, nr1, nc0, nc1)\n\n        else:\n            copy_w = width - 2\n            copy_h = max(1, height // 2)\n\n            if direction == \"down\":\n                nr0, nr1 = r1 + 1, r1 + copy_h\n                nc0, nc1 = c0 + 1, c1 - 1\n            else:\n                nr1, nr0 = r0 - 1, r0 - copy_h\n                nc0, nc1 = c0 + 1, c1 - 1\n\n            if nc0 < 0 or nc1 >= w or nr0 < 0 or nr1 >= h or nr0 > nr1:\n                continue\n            _draw_rect_outline(out, seed_color, nr0, nr1, nc0, nc1)\n\n    return out\n\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n\n    for _ in range(4000):\n        h = rng.randint(14, 30)\n        w = rng.randint(14, 30)\n        if h < 14 or w < 14:\n            continue\n\n        grid = np.full((h, w), BG, dtype=np.int64)\n        occupied = np.zeros((h, w), dtype=bool)\n\n        object_count = rng.randint(1, 4)\n        dirs = [rng.choice(DIRECTIONS) for _ in range(object_count)]\n\n        frame_pool = list(FRAME_COLORS)\n        seed_pool = list(SEED_COLORS)\n        rng.shuffle(frame_pool)\n        rng.shuffle(seed_pool)\n\n        if object_count > len(frame_pool) or object_count > len(seed_pool):\n            continue\n\n        frame_colors = frame_pool[:object_count]\n        seed_colors = seed_pool[:object_count]\n\n        plans = [\n            {\n                \"frame_color\": frame_colors[i],\n                \"seed_color\": seed_colors[i],\n                \"dir\": dirs[i],\n            }\n            for i in range(object_count)\n        ]\n\n        # Legend: one color block and a 3-cell grey L-shape keyed by direction.\n        def mark_occupied(cells: Sequence[Tuple[int, int]]) -> bool:\n            return any(\n                not (0 <= rr < h and 0 <= cc < w) or occupied[rr, cc]\n                for rr, cc in cells\n            )\n\n        success_legend = True\n        for p in plans:\n            direction = p[\"dir\"]\n            color = p[\"seed_color\"]\n\n            if direction == \"right\":\n                candidates = list(range(1, h - 1))\n                rng.shuffle(candidates)\n                placed = False\n                for r in candidates:\n                    cells = [(r, 0), (r, 1), (r, 2), (r - 1, 2)]\n                    if mark_occupied(cells):\n                        continue\n                    for rr, cc in cells:\n                        grid[rr, cc] = color if cc == 0 else GREY\n                        occupied[rr, cc] = True\n                    p[\"legend_anchor\"] = (r, 0)\n                    placed = True\n                    break\n\n            elif direction == \"left\":\n                candidates = list(range(1, h - 1))\n                rng.shuffle(candidates)\n                placed = False\n                for r in candidates:\n                    cells = [(r, w - 1), (r, w - 2), (r, w - 3), (r - 1, w - 3)]\n                    if mark_occupied(cells):\n                        continue\n                    for rr, cc in cells:\n                        grid[rr, cc] = color if cc == w - 1 else GREY\n                        occupied[rr, cc] = True\n                    p[\"legend_anchor\"] = (r, w - 1)\n                    placed = True\n                    break\n\n            elif direction == \"down\":\n                candidates = list(range(1, w - 1))\n                rng.shuffle(candidates)\n                placed = False\n                for c in candidates:\n                    cells = [(0, c), (1, c), (2, c), (2, c - 1)]\n                    if mark_occupied(cells):\n                        continue\n                    for rr, cc in cells:\n                        grid[rr, cc] = color if rr == 0 else GREY\n                        occupied[rr, cc] = True\n                    p[\"legend_anchor\"] = (0, c)\n                    placed = True\n                    break\n\n            else:  # up\n                candidates = list(range(1, w - 1))\n                rng.shuffle(candidates)\n                placed = False\n                for c in candidates:\n                    cells = [(h - 1, c), (h - 2, c), (h - 3, c), (h - 3, c - 1)]\n                    if mark_occupied(cells):\n                        continue\n                    for rr, cc in cells:\n                        grid[rr, cc] = color if rr == h - 1 else GREY\n                        occupied[rr, cc] = True\n                    p[\"legend_anchor\"] = (h - 1, c)\n                    placed = True\n                    break\n\n            if not placed:\n                success_legend = False\n                break\n\n        if not success_legend:\n            continue\n\n        # Build final-shape occupancy to prevent overlaps between frame and grown copy.\n        possible = True\n        for p in plans:\n            direction = p[\"dir\"]\n            frame_color = p[\"frame_color\"]\n            seed_color = p[\"seed_color\"]\n\n            # Draw each frame+seed and a predicted grown copy.\n            trial = 0\n            while trial < 300:\n                trial += 1\n\n                if direction in (\"right\", \"left\"):\n                    h_min = 5\n                    h_max = min(11, h - 4)\n                    if h_max < h_min:\n                        break\n                    rect_h = rng.randint(h_min, h_max)\n                    copy_w = max(1, rect_h // 2)\n                    w_max = min(11, w - copy_w - 2)\n                    if w_max < 5:\n                        break\n                    rect_w = rng.randint(5, w_max)\n\n                    if direction == \"right\":\n                        r0_min, r0_max = 1, h - rect_h - 1\n                        c0_min = 1\n                        c0_max = w - rect_w - copy_w - 1\n                    else:\n                        r0_min, r0_max = 1, h - rect_h - 1\n                        c0_min = copy_w + 1\n                        c0_max = w - rect_w - 1\n\n                else:\n                    w_min = 5\n                    w_max = min(11, w - 2)\n                    if w_max < w_min:\n                        break\n                    rect_w = rng.randint(w_min, w_max)\n                    copy_h = max(1, rect_h // 2)\n                    h_max = min(11, h - copy_h - 2)\n                    if h_max < 5:\n                        break\n                    rect_h = rng.randint(5, h_max)\n\n                    if direction == \"down\":\n                        r0_min = 1\n                        r0_max = h - rect_h - copy_h - 1\n                        c0_min = 1\n                        c0_max = w - rect_w - 1\n                    else:\n                        r0_min = copy_h + 1\n                        r0_max = h - rect_h - 1\n                        c0_min = 1\n                        c0_max = w - rect_w - 1\n\n                if r0_min > r0_max or c0_min > c0_max:\n                    break\n\n                r0 = rng.randint(r0_min, r0_max)\n                c0 = rng.randint(c0_min, c0_max)\n                r1 = r0 + rect_h - 1\n                c1 = c0 + rect_w - 1\n\n                if direction in (\"right\", \"left\"):\n                    copy_w = max(1, rect_h // 2)\n                    if direction == \"right\":\n                        nr0, nr1 = r0 + 1, r1 - 1\n                        nc0, nc1 = c1 + 1, c1 + copy_w\n                    else:\n                        nr0, nr1 = r0 + 1, r1 - 1\n                        nc1, nc0 = c0 - 1, c0 - copy_w\n                    if nc0 < 0 or nc1 >= w:\n                        continue\n\n                else:\n                    copy_h = max(1, rect_h // 2)\n                    if direction == \"down\":\n                        nr0, nr1 = r1 + 1, r1 + copy_h\n                        nc0, nc1 = c0 + 1, c1 - 1\n                    else:\n                        nr1, nr0 = r0 - 1, r0 - copy_h\n                        nc0, nc1 = c0 + 1, c1 - 1\n                    if nr0 < 0 or nr1 >= h:\n                        continue\n\n                if not (nr0 <= nr1 and nc0 <= nc1):\n                    continue\n\n                temp = np.zeros((h, w), dtype=bool)\n                _mark_rect_outline(temp, r0, r1, c0, c1)\n\n                # opening segment (will be erased)\n                if direction == \"right\":\n                    temp[r0 + 1 : r1, c1] = True\n                    # keep seed location reserved\n                    seed_r = r0 + 1\n                    seed_c = c0 + 1\n                elif direction == \"left\":\n                    temp[r0 + 1 : r1, c0] = True\n                    seed_r = r0 + 1\n                    seed_c = c0 + 1\n                elif direction == \"down\":\n                    temp[r1, c0 + 1 : c1] = True\n                    seed_r = r0 + 1\n                    seed_c = c0 + 1\n                else:\n                    temp[r0, c0 + 1 : c1] = True\n                    seed_r = r0 + 1\n                    seed_c = c0 + 1\n\n                temp[seed_r, seed_c] = True\n                _mark_rect_outline(temp, nr0, nr1, nc0, nc1)\n\n                if np.any(occupied & temp):\n                    continue\n\n                # Commit object\n                occupied[temp] = True\n                _draw_rect_outline(grid, frame_color, r0, r1, c0, c1)\n                grid[seed_r, seed_c] = seed_color\n                break\n            else:\n                possible = False\n                break\n\n        if not possible:\n            continue\n\n        # Final validation: at least one closed frame exists and every rectangle has a mapped legend color.\n        # This avoids degenerate rare retries from accidental placement failure.\n        valid_frames = 0\n        comps = _connected_components(grid)\n        for comp in comps:\n            rect = _rect_from_component(grid, comp)\n            if rect is not None:\n                valid_frames += 1\n        if valid_frames == 0:\n            continue\n\n        return grid\n\n    raise RuntimeError(\"generate_input failed to satisfy constraints\")\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"cat > /home/lixinyu/snap/a/des/code/eval_new/seed558458950/2/1.py <<'PY'\n\\\"\\\"\\\"Grow each seed-directed rectangular frame outward through a keyed directional legend.\n\nInput structure:\n- The background is black (0).\n- Inside the grid are several disjoint closed, 1-pixel-thick rectangular frames (non-black colors), each containing exactly one interior seed pixel of another color.\n- Along the border, a legend lists seed colors: each entry has a color block and a nearby 3-cell grey L-shaped arrow.\n- The arrow direction maps that seed color to a growth direction among up, down, left, right.\n\nRule:\n- Locate every closed rectangular frame by verifying a perimeter-only 4-neighbor component and detect its single interior seed color.\n- Read the frame's seed color in the legend to get the growth direction.\n- Open the entire non-corner segment on the corresponding frame side by setting those pixels to black.\n- Remove the seed pixel (set it to black).\n- Create a new hollow contour outside the frame in the seed color: the side perpendicular to growth has the same length as the opened side, while the side parallel to growth has half the original frame size in that growth direction (floor).\n- Only draw the new contour; do not recolor other pixels.\n\nKey insight:\n- Seed colors are lookup keys, not behavior colors: the legend maps each seed color to a direction.\n- Frame geometry uniquely determines opening location and copied contour size.\n\\\"\\\"\\\"\n\nfrom __future__ import annotations\n\nimport random\nfrom collections import deque\nfrom typing import Dict, Iterable, List, Sequence, Set, Tuple\n\nimport numpy as np\n\n\nBG = 0\nGREY = 9\n\nFRAME_COLORS: Sequence[int] = (1, 2, 3, 4)\nSEED_COLORS: Sequence[int] = (5, 6, 7, 8)\nDIRECTIONS = (\\\"up\\\", \\\"down\\\", \\\"left\\\", \\\"right\\\")\n\n\ndef _neighbors4(r: int, c: int, h: int, w: int) -> Iterable[Tuple[int, int]]:\n    if r > 0:\n        yield r - 1, c\n    if r + 1 < h:\n        yield r + 1, c\n    if c > 0:\n        yield r, c - 1\n    if c + 1 < w:\n        yield r, c + 1\n\n\ndef _legend_arrow_offsets(direction: str) -> List[Tuple[int, int]]:\n    if direction == \\\"right\\\":\n        return [(0, 1), (0, 2), (-1, 2)]\n    if direction == \\\"left\\\":\n        return [(0, -1), (0, -2), (-1, -2)]\n    if direction == \\\"down\\\":\n        return [(1, 0), (2, 0), (2, -1)]\n    if direction == \\\"up\\\":\n        return [(-1, 0), (-2, 0), (-2, -1)]\n    raise ValueError(direction)\n\n\ndef _draw_rect_outline(grid: np.ndarray, color: int, r0: int, r1: int, c0: int, c1: int) -> None:\n    grid[r0, c0 : c1 + 1] = color\n    grid[r1, c0 : c1 + 1] = color\n    grid[r0 : r1 + 1, c0] = color\n    grid[r0 : r1 + 1, c1] = color\n\n\ndef _mark_rect_outline(mask: np.ndarray, r0: int, r1: int, c0: int, c1: int) -> None:\n    mask[r0, c0 : c1 + 1] = True\n    mask[r1, c0 : c1 + 1] = True\n    mask[r0 : r1 + 1, c0] = True\n    mask[r0 : r1 + 1, c1] = True\n\n\ndef _find_legend(grid: np.ndarray) -> Dict[int, str]:\n    h, w = grid.shape\n    mapping: Dict[int, str] = {}\n\n    for r in range(h):\n        for c in range(w):\n            if not (r == 0 or c == 0 or r == h - 1 or c == w - 1):\n                continue\n\n            color = int(grid[r, c])\n            if color in (BG, GREY):\n                continue\n            if color in mapping:\n                continue\n\n            for direction in DIRECTIONS:\n                offsets = _legend_arrow_offsets(direction)\n                ok = True\n                for dr, dc in offsets:\n                    rr = r + dr\n                    cc = c + dc\n                    if not (0 <= rr < h and 0 <= cc < w):\n                        ok = False\n                        break\n                    if int(grid[rr, cc]) \"'!= GREY:\n                        ok = False\n                        break\n                if ok:\n                    mapping[color] = direction\n                    break\n\n    return mapping\n\n\ndef _connected_components(grid: np.ndarray) -> List[Set[Tuple[int, int]]]:\n    h, w = grid.shape\n    visited = np.zeros((h, w), dtype=bool)\n    comps: List[Set[Tuple[int, int]]] = []\n\n    for i in range(h):\n        for j in range(w):\n            v = int(grid[i, j])\n            if v == BG or v == GREY or visited[i, j]:\n                continue\n\n            q = deque([(i, j)])\n            visited[i, j] = True\n            comp: Set[Tuple[int, int]] = {(i, j)}\n\n            while q:\n                r, c = q.popleft()\n                for rr, cc in _neighbors4(r, c, h, w):\n                    if visited[rr, cc]:\n                        continue\n                    if int(grid[rr, cc]) == BG or int(grid[rr, cc]) == GREY:\n                        continue\n                    visited[rr, cc] = True\n                    q.append((rr, cc))\n                    comp.add((rr, cc))\n\n            comps.append(comp)\n\n    return comps\n\n\ndef _iter_perimeter_points(r0: int, c0: int, r1: int, c1: int) -> Iterable[Tuple[int, int]]:\n    for cc in range(c0, c1 + 1):\n        yield r0, cc\n        yield r1, cc\n    for rr in range(r0 + 1, r1):\n        yield rr, c0\n        yield rr, c1\n\n\ndef _rect_from_component(grid: np.ndarray, comp: Set[Tuple[int, int]]) -> Tuple[int, int, int, int] | None:\n    rs = [p[0] for p in comp]\n    cs = [p[1] for p in comp]\n    r0, r1 = min(rs), max(rs)\n    c0, c1 = min(cs), max(cs)\n    h = r1 - r0 + 1\n    w = c1 - c0 + 1\n\n    if h < 3 or w < 3:\n        return None\n\n    if len(comp) != 2 * (h + w) - 4:\n        return None\n\n    perimeter = set(_iter_perimeter_points(r0, c0, r1, c1))\n    if comp != perimeter:\n        return None\n\n    if (0 in (r0, c0)) or (0 in (r1, c1)):\n        # legend should be on edge, and we do not treat edge-touching frames as candidates.\n        return None\n\n    for rr in range(r0 + 1, r1):\n        for cc in range(c0 + 1, c1):\n            if int(grid[rr, cc]) != BG:\n                return None\n\n    return r0, c0, r1, c1\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    h, w = grid.shape\n    out = np.array(grid, copy=True)\n    legend = _find_legend(grid)\n\n    comps = _connected_components(grid)\n    for comp in comps:\n        rect = _rect_from_component(grid, comp)\n        if rect is None:\n            continue\n\n        r0, c0, r1, c1 = rect\n        inner = [\n            (r, c)\n            for r in range(r0 + 1, r1)\n            for c in range(c0 + 1, c1)\n            if int(grid[r, c]) != BG\n        ]\n        if len(inner) != 1:\n            continue\n\n        seed_r, seed_c = inner[0]\n        seed_color = int(grid[seed_r, seed_c])\n        direction = legend.get(seed_color)\n        if direction is None:\n            continue\n\n        height = r1 - r0 + 1\n        width = c1 - c0 + 1\n\n        # 1) erase the opening in the matching side\n        if direction == \"right\":\n            for rr in range(r0 + 1, r1):\n                out[rr, c1] = BG\n        elif direction == \"left\":\n            for rr in range(r0 + 1, r1):\n                out[rr, c0] = BG\n        elif direction == \"down\":\n            for cc in range(c0 + 1, c1):\n                out[r1, cc] = BG\n        else:  # up\n            for cc in range(c0 + 1, c1):\n                out[r0, cc] = BG\n\n        # 2) remove seed pixel\n        out[seed_r, seed_c] = BG\n\n        # 3) grow a scaled copy using seed color as contour color\n        if direction in (\"right\", \"left\"):\n            copy_h = width - 2\n            copy_w = max(1, height // 2)\n\n            if direction == \"right\":\n                nr0, nr1 = r0 + 1, r1 - 1\n                nc0, nc1 = c1 + 1, c1 + copy_w\n            else:\n                nr0, nr1 = r0 + 1, r1 - 1\n                nc1, nc0 = c0 - 1, c0 - copy_w\n\n            if nc0 < 0 or nc1 >= w or nr0 < 0 or nr1 >= h or nc0 > nc1:\n                continue\n            _draw_rect_outline(out, seed_color, nr0, nr1, nc0, nc1)\n\n        else:\n            copy_w = width - 2\n            copy_h = max(1, height // 2)\n\n            if direction == \"down\":\n                nr0, nr1 = r1 + 1, r1 + copy_h\n                nc0, nc1 = c0 + 1, c1 - 1\n            else:\n                nr1, nr0 = r0 - 1, r0 - copy_h\n                nc0, nc1 = c0 + 1, c1 - 1\n\n            if nc0 < 0 or nc1 >= w or nr0 < 0 or nr1 >= h or nr0 > nr1:\n                continue\n            _draw_rect_outline(out, seed_color, nr0, nr1, nc0, nc1)\n\n    return out\n\n\ndef generate_input() -> np.ndarray:\n    rng = random.Random()\n\n    for _ in range(4000):\n        h = rng.randint(14, 30)\n        w = rng.randint(14, 30)\n        if h < 14 or w < 14:\n            continue\n\n        grid = np.full((h, w), BG, dtype=np.int64)\n        occupied = np.zeros((h, w), dtype=bool)\n\n        object_count = rng.randint(1, 4)\n        dirs = [rng.choice(DIRECTIONS) for _ in range(object_count)]\n\n        frame_pool = list(FRAME_COLORS)\n        seed_pool = list(SEED_COLORS)\n        rng.shuffle(frame_pool)\n        rng.shuffle(seed_pool)\n\n        if object_count > len(frame_pool) or object_count > len(seed_pool):\n            continue\n\n        frame_colors = frame_pool[:object_count]\n        seed_colors = seed_pool[:object_count]\n\n        plans = [\n            {\n                \"frame_color\": frame_colors[i],\n                \"seed_color\": seed_colors[i],\n                \"dir\": dirs[i],\n            }\n            for i in range(object_count)\n        ]\n\n        # Legend: one color block and a 3-cell grey L-shape keyed by direction.\n        def mark_occupied(cells: Sequence[Tuple[int, int]]) -> bool:\n            return any(\n                not (0 <= rr < h and 0 <= cc < w) or occupied[rr, cc]\n                for rr, cc in cells\n            )\n\n        success_legend = True\n        for p in plans:\n            direction = p[\"dir\"]\n            color = p[\"seed_color\"]\n\n            if direction == \"right\":\n                candidates = list(range(1, h - 1))\n                rng.shuffle(candidates)\n                placed = False\n                for r in candidates:\n                    cells = [(r, 0), (r, 1), (r, 2), (r - 1, 2)]\n                    if mark_occupied(cells):\n                        continue\n                    for rr, cc in cells:\n                        grid[rr, cc] = color if cc == 0 else GREY\n                        occupied[rr, cc] = True\n                    p[\"legend_anchor\"] = (r, 0)\n                    placed = True\n                    break\n\n            elif direction == \"left\":\n                candidates = list(range(1, h - 1))\n                rng.shuffle(candidates)\n                placed = False\n                for r in candidates:\n                    cells = [(r, w - 1), (r, w - 2), (r, w - 3), (r - 1, w - 3)]\n                    if mark_occupied(cells):\n                        continue\n                    for rr, cc in cells:\n                        grid[rr, cc] = color if cc == w - 1 else GREY\n                        occupied[rr, cc] = True\n                    p[\"legend_anchor\"] = (r, w - 1)\n                    placed = True\n                    break\n\n            elif direction == \"down\":\n                candidates = list(range(1, w - 1))\n                rng.shuffle(candidates)\n                placed = False\n                for c in candidates:\n                    cells = [(0, c), (1, c), (2, c), (2, c - 1)]\n                    if mark_occupied(cells):\n                        continue\n                    for rr, cc in cells:\n                        grid[rr, cc] = color if rr == 0 else GREY\n                        occupied[rr, cc] = True\n                    p[\"legend_anchor\"] = (0, c)\n                    placed = True\n                    break\n\n            else:  # up\n                candidates = list(range(1, w - 1))\n                rng.shuffle(candidates)\n                placed = False\n                for c in candidates:\n                    cells = [(h - 1, c), (h - 2, c), (h - 3, c), (h - 3, c - 1)]\n                    if mark_occupied(cells):\n                        continue\n                    for rr, cc in cells:\n                        grid[rr, cc] = color if rr == h - 1 else GREY\n                        occupied[rr, cc] = True\n                    p[\"legend_anchor\"] = (h - 1, c)\n                    placed = True\n                    break\n\n            if not placed:\n                success_legend = False\n                break\n\n        if not success_legend:\n            continue\n\n        # Build final-shape occupancy to prevent overlaps between frame and grown copy.\n        possible = True\n        for p in plans:\n            direction = p[\"dir\"]\n            frame_color = p[\"frame_color\"]\n            seed_color = p[\"seed_color\"]\n\n            # Draw each frame+seed and a predicted grown copy.\n            trial = 0\n            while trial < 300:\n                trial += 1\n\n                if direction in (\"right\", \"left\"):\n                    h_min = 5\n                    h_max = min(11, h - 4)\n                    if h_max < h_min:\n                        break\n                    rect_h = rng.randint(h_min, h_max)\n                    copy_w = max(1, rect_h // 2)\n                    w_max = min(11, w - copy_w - 2)\n                    if w_max < 5:\n                        break\n                    rect_w = rng.randint(5, w_max)\n\n                    if direction == \"right\":\n                        r0_min, r0_max = 1, h - rect_h - 1\n                        c0_min = 1\n                        c0_max = w - rect_w - copy_w - 1\n                    else:\n                        r0_min, r0_max = 1, h - rect_h - 1\n                        c0_min = copy_w + 1\n                        c0_max = w - rect_w - 1\n\n                else:\n                    w_min = 5\n                    w_max = min(11, w - 2)\n                    if w_max < w_min:\n                        break\n                    rect_w = rng.randint(w_min, w_max)\n                    copy_h = max(1, rect_h // 2)\n                    h_max = min(11, h - copy_h - 2)\n                    if h_max < 5:\n                        break\n                    rect_h = rng.randint(5, h_max)\n\n                    if direction == \"down\":\n                        r0_min = 1\n                        r0_max = h - rect_h - copy_h - 1\n                        c0_min = 1\n                        c0_max = w - rect_w - 1\n                    else:\n                        r0_min = copy_h + 1\n                        r0_max = h - rect_h - 1\n                        c0_min = 1\n                        c0_max = w - rect_w - 1\n\n                if r0_min > r0_max or c0_min > c0_max:\n                    break\n\n                r0 = rng.randint(r0_min, r0_max)\n                c0 = rng.randint(c0_min, c0_max)\n                r1 = r0 + rect_h - 1\n                c1 = c0 + rect_w - 1\n\n                if direction in (\"right\", \"left\"):\n                    copy_w = max(1, rect_h // 2)\n                    if direction == \"right\":\n                        nr0, nr1 = r0 + 1, r1 - 1\n                        nc0, nc1 = c1 + 1, c1 + copy_w\n                    else:\n                        nr0, nr1 = r0 + 1, r1 - 1\n                        nc1, nc0 = c0 - 1, c0 - copy_w\n                    if nc0 < 0 or nc1 >= w:\n                        continue\n\n                else:\n                    copy_h = max(1, rect_h // 2)\n                    if direction == \"down\":\n                        nr0, nr1 = r1 + 1, r1 + copy_h\n                        nc0, nc1 = c0 + 1, c1 - 1\n                    else:\n                        nr1, nr0 = r0 - 1, r0 - copy_h\n                        nc0, nc1 = c0 + 1, c1 - 1\n                    if nr0 < 0 or nr1 >= h:\n                        continue\n\n                if not (nr0 <= nr1 and nc0 <= nc1):\n                    continue\n\n                temp = np.zeros((h, w), dtype=bool)\n                _mark_rect_outline(temp, r0, r1, c0, c1)\n\n                # opening segment (will be erased)\n                if direction == \"right\":\n                    temp[r0 + 1 : r1, c1] = True\n                    # keep seed location reserved\n                    seed_r = r0 + 1\n                    seed_c = c0 + 1\n                elif direction == \"left\":\n                    temp[r0 + 1 : r1, c0] = True\n                    seed_r = r0 + 1\n                    seed_c = c0 + 1\n                elif direction == \"down\":\n                    temp[r1, c0 + 1 : c1] = True\n                    seed_r = r0 + 1\n                    seed_c = c0 + 1\n                else:\n                    temp[r0, c0 + 1 : c1] = True\n                    seed_r = r0 + 1\n                    seed_c = c0 + 1\n\n                temp[seed_r, seed_c] = True\n                _mark_rect_outline(temp, nr0, nr1, nc0, nc1)\n\n                if np.any(occupied & temp):\n                    continue\n\n                # Commit object\n                occupied[temp] = True\n                _draw_rect_outline(grid, frame_color, r0, r1, c0, c1)\n                grid[seed_r, seed_c] = seed_color\n                break\n            else:\n                possible = False\n                break\n\n        if not possible:\n            continue\n\n        # Final validation: at least one closed frame exists and every rectangle has a mapped legend color.\n        # This avoids degenerate rare retries from accidental placement failure.\n        valid_frames = 0\n        comps = _connected_components(grid)\n        for comp in comps:\n            rect = _rect_from_component(grid, comp)\n            if rect is not None:\n                valid_frames += 1\n        if valid_frames == 0:\n            continue\n\n        return grid\n\n    raise RuntimeError(\"generate_input failed to satisfy constraints\")\nPY'","aggregated_output":"","exit_code":0,"status":"completed"}}
