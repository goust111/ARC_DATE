{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/train/7e576d6e.py\"","aggregated_output":"from __future__ import annotations\n\nimport numpy as np\n\nfrom arc_utils import components_mask, get_bg\nimport random\n\n\ndef _color_counts(g: np.ndarray) -> dict[int, int]:\n    vals, counts = np.unique(g, return_counts=True)\n    return {int(v): int(n) for v, n in zip(vals, counts)}\n\n\ndef _roles(g: np.ndarray) -> tuple[int, int, int, int]:\n    bg = get_bg(g)\n    counts = _color_counts(g)\n    colors = [c for c in counts if c != bg]\n    assert len(colors) == 3, \"expected wall, door, and marker colors\"\n\n    marker_colors = [c for c in colors if counts[c] == 2]\n    assert len(marker_colors) == 1, \"expected exactly two marker pixels\"\n    path_color = marker_colors[0]\n\n    remaining = [c for c in colors if c != path_color]\n    areas = {c: counts[c] for c in remaining}\n    door_area = min(areas.values())\n    wall_area = max(areas.values())\n    door_colors = [c for c in remaining if counts[c] == door_area]\n    wall_colors = [c for c in remaining if counts[c] == wall_area]\n    assert len(door_colors) == 1 and len(wall_colors) == 1\n    assert door_area < wall_area, \"door color must be the smaller non-marker object set\"\n    return int(bg), int(path_color), int(door_colors[0]), int(wall_colors[0])\n\n\ndef _door_centers(g: np.ndarray, door_color: int) -> tuple[str, list[tuple[int, int]]]:\n    comps = components_mask(g == int(door_color), connectivity=4)\n    assert comps, \"expected door segments\"\n\n    orientations: list[str] = []\n    centers: list[tuple[int, int]] = []\n    for coords in comps:\n        assert coords.shape[0] == 3, \"each door segment is three pixels long\"\n        r0, c0 = coords.min(axis=0)\n        r1, c1 = coords.max(axis=0)\n        height = int(r1 - r0 + 1)\n        width = int(c1 - c0 + 1)\n        if height == 3 and width == 1:\n            orientations.append(\"vertical\")\n            centers.append((int(r0 + 1), int(c0)))\n        elif height == 1 and width == 3:\n            orientations.append(\"horizontal\")\n            centers.append((int(r0), int(c0 + 1)))\n        else:\n            raise AssertionError(\"door segments must be straight length-3 bars\")\n\n    assert len(set(orientations)) == 1, \"all doors must share an orientation\"\n    return orientations[0], centers\n\n\ndef _paint_segment(\n    out: np.ndarray,\n    start: tuple[int, int],\n    end: tuple[int, int],\n    color: int,\n    allowed: set[int],\n) -> None:\n    r0, c0 = map(int, start)\n    r1, c1 = map(int, end)\n    assert r0 == r1 or c0 == c1, \"path segments must be orthogonal\"\n    height, width = out.shape\n    assert 0 <= r0 < height and 0 <= r1 < height\n    assert 0 <= c0 < width and 0 <= c1 < width\n\n    if r0 == r1:\n        for c in range(min(c0, c1), max(c0, c1) + 1):\n            assert int(out[r0, c]) in allowed, \"path may only cover bg, doors, or markers\"\n            out[r0, c] = int(color)\n    else:\n        for r in range(min(r0, r1), max(r0, r1) + 1):\n            assert int(out[r, c0]) in allowed, \"path may only cover bg, doors, or markers\"\n            out[r, c0] = int(color)\n\n\ndef _markers(g: np.ndarray, path_color: int) -> list[tuple[int, int]]:\n    coords = np.argwhere(g == int(path_color))\n    assert coords.shape[0] == 2, \"expected two marker pixels\"\n    return [tuple(map(int, coord)) for coord in coords]\n\n\ndef _solve_vertical_walls(\n    g: np.ndarray,\n    centers: list[tuple[int, int]],\n    markers: list[tuple[int, int]],\n    bg: int,\n    path_color: int,\n    door_color: int,\n    wall_color: int,\n) -> np.ndarray:\n    out = g.copy()\n    centers = sorted(centers, key=lambda p: p[1])\n    wall_cols = sorted(set(map(int, np.argwhere(g == int(wall_color))[:, 1])))\n    assert len(wall_cols) == len(centers), \"each vertical wall must have one door\"\n    assert [c for _r, c in centers] == wall_cols\n    for _r, c in centers:\n        assert np.all(np.isin(g[:, c], [wall_color, door_color]))\n\n    start, end = sorted(markers, key=lambda p: p[1])\n    assert start[1] < centers[0][1] and end[1] > centers[-1][1]\n\n    allowed = {int(bg), int(path_color), int(door_color)}\n    cur = start\n    for door_r, door_c in centers:\n        approach = (cur[0], door_c - 1)\n        _paint_segment(out, cur, approach, path_color, allowed)\n        _paint_segment(out, approach, (door_r, door_c - 1), path_color, allowed)\n        _paint_segment(out, (door_r, door_c - 1), (door_r, door_c), path_color, allowed)\n        cur = (door_r, door_c)\n\n    _paint_segment(out, cur, (cur[0], end[1]), path_color, allowed)\n    _paint_segment(out, (cur[0], end[1]), end, path_color, allowed)\n    return out\n\n\ndef _solve_horizontal_walls(\n    g: np.ndarray,\n    centers: list[tuple[int, int]],\n    markers: list[tuple[int, int]],\n    bg: int,\n    path_color: int,\n    door_color: int,\n    wall_color: int,\n) -> np.ndarray:\n    out = g.copy()\n    centers = sorted(centers, key=lambda p: p[0])\n    wall_rows = sorted(set(map(int, np.argwhere(g == int(wall_color))[:, 0])))\n    assert len(wall_rows) == len(centers), \"each horizontal wall must have one door\"\n    assert [r for r, _c in centers] == wall_rows\n    for r, _c in centers:\n        assert np.all(np.isin(g[r, :], [wall_color, door_color]))\n\n    start, end = sorted(markers, key=lambda p: p[0])\n    assert start[0] < centers[0][0] and end[0] > centers[-1][0]\n\n    allowed = {int(bg), int(path_color), int(door_color)}\n    cur = start\n    for door_r, door_c in centers:\n        approach = (door_r - 1, cur[1])\n        _paint_segment(out, cur, approach, path_color, allowed)\n        _paint_segment(out, approach, (door_r - 1, door_c), path_color, allowed)\n        _paint_segment(out, (door_r - 1, door_c), (door_r, door_c), path_color, allowed)\n        cur = (door_r, door_c)\n\n    _paint_segment(out, cur, (end[0], cur[1]), path_color, allowed)\n    _paint_segment(out, (end[0], cur[1]), end, path_color, allowed)\n    return out\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Draw the marker-colored route through the centers of all doors in the parallel wall maze.\n\n    Input structure:\n    - The grid has a background, parallel full-span walls, one three-pixel door\n      segment in each wall, and two marker pixels sharing a color.\n    - Walls are either all vertical or all horizontal, and the markers are on\n      opposite outer sides of the wall set.\n\n    Rule:\n    - Keep the scene unchanged except for the route.\n    - Visit the door centers in wall order from the upper/left marker side to\n      the lower/right marker side.\n    - In each corridor, draw an orthogonal path to the cell just before the next\n      wall, move along that wall to the door center, cross the center, and\n      continue to the next corridor; after the last door, connect to the other\n      marker.\n\n    Key insight:\n    - The three-pixel door segments mark the only crossing points through a set\n      of parallel walls, so the output is the corridor path threaded through\n      those centers.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    bg, path_color, door_color, wall_color = _roles(g)\n    orientation, centers = _door_centers(g, door_color)\n    markers = _markers(g, path_color)\n\n    if orientation == \"vertical\":\n        return _solve_vertical_walls(g, centers, markers, bg, path_color, door_color, wall_color)\n    assert orientation == \"horizontal\"\n    return _solve_horizontal_walls(g, centers, markers, bg, path_color, door_color, wall_color)\n\n# --------------- generator (att1) ---------------\n\n# Canvas and color role sampling.\nGRID_H = 30\nGRID_W = 30\nCOLOR_POOL = range(10)\nN_ROLE_COLORS = 4\n\n# Parallel wall and door geometry.\nORIENTATIONS = (\"vertical\", \"horizontal\")\nWALL_COUNT_RANGE = (3, 4)\nWALL_POS_LO = 4\nWALL_POS_HI_MARGIN = 5\nWALL_MIN_GAP = 2\nDOOR_CENTER_LO = 3\nDOOR_CENTER_HI_MARGIN = 4\n\n# Marker placement and retry budget.\nMARKER_EDGE_RANGE = (1, 3)\nMARKER_FREE_LO = 1\nMARKER_FREE_HI_MARGIN = 2\nGEN_RETRIES = 300\n\n\ndef _place_positions(n: int, lo: int, hi: int, min_gap: int, rng: random.Random) -> list[int] | None:\n    \"\"\"Place n positions in [lo..hi] with pairwise gap >= min_gap between consecutive sorted positions.\"\"\"\n    needed = n + (n - 1) * min_gap\n    span = hi - lo + 1\n    if span < needed:\n        return None\n    compressed_span = span - (n - 1) * min_gap\n    picks = sorted(rng.sample(range(compressed_span), n))\n    return [lo + picks[i] + i * min_gap for i in range(n)]\n\n\ndef _sample_wall_layout(orientation: str, n_walls: int, rng: random.Random):\n    \"\"\"Return wall positions and per-wall door centers for the chosen orientation.\"\"\"\n    wall_axis, door_axis = (GRID_W, GRID_H) if orientation == \"vertical\" else (GRID_H, GRID_W)\n    walls = _place_positions(\n        n_walls,\n        lo=WALL_POS_LO,\n        hi=wall_axis - WALL_POS_HI_MARGIN,\n        min_gap=WALL_MIN_GAP,\n        rng=rng,\n    )\n    if walls is None:\n        return None\n    doors = [rng.randint(DOOR_CENTER_LO, door_axis - DOOR_CENTER_HI_MARGIN) for _ in range(n_walls)]\n    return walls, doors\n\n\ndef _sample_markers(orientation: str, rng: random.Random) -> tuple[tuple[int, int], tuple[int, int]]:\n    \"\"\"Sample start/end markers on opposite outer corridors.\"\"\"\n    edge_lo, edge_hi = MARKER_EDGE_RANGE\n    if orientation == \"vertical\":\n        start_col = rng.randint(edge_lo, edge_hi)\n        start_row = rng.randint(MARKER_FREE_LO, GRID_H - MARKER_FREE_HI_MARGIN)\n        end_col = rng.randint(GRID_W - edge_hi - 1, GRID_W - edge_lo - 1)\n        end_row = rng.randint(MARKER_FREE_LO, GRID_H - MARKER_FREE_HI_MARGIN)\n    else:\n        start_row = rng.randint(edge_lo, edge_hi)\n        start_col = rng.randint(MARKER_FREE_LO, GRID_W - MARKER_FREE_HI_MARGIN)\n        end_row = rng.randint(GRID_H - edge_hi - 1, GRID_H - edge_lo - 1)\n        end_col = rng.randint(MARKER_FREE_LO, GRID_W - MARKER_FREE_HI_MARGIN)\n    return (start_row, start_col), (end_row, end_col)\n\n\ndef _render_grid(\n    orientation, bg, wall_color, door_color, marker_color, walls, doors, start, end\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/36a08778.py\"","aggregated_output":"from __future__ import annotations\nfrom collections import Counter, deque\nimport numpy as np\nfrom arc_utils import STRUCT8, components_mask\nimport random\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Simulate water falling from top-edge sources, pooling on shelves, and cascading off edges.\n\n    Input structure:\n    - bg = most common color; water = rarest non-bg; shelf = other non-bg.\n    - Sources: water clusters touching top row. Shelves: horizontal segments.\n\n    Rule:\n    - Water falls down from sources, painting bg cells as water.\n    - On hitting a shelf, it spreads across the shelf span plus one cell past each end.\n    - From those overflow positions, water resumes falling independently.\n\n    Key insight: Each shelf splits a stream into two at its edges, creating a branching waterfall tree.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    cnt = Counter(map(int, g.flatten()))\n    bg = int(cnt.most_common(1)[0][0])\n    non = [int(c) for c in cnt.keys() if int(c) != int(bg)]\n    assert not (not non)\n    water = int(min(non, key=lambda c: (int(cnt[int(c)]), int(c))))\n    other = [int(c) for c in non if int(c) != int(water)]\n    assert not (not other)\n    shelf = int(other[0])\n\n    out = g.copy()\n\n    # sources: 8-connected components of water that touch the top edge; start from their bottommost row\n    sources: list[tuple[int, int]] = []\n    for coords in components_mask(g == int(water), connectivity=8):\n        if coords.size == 0:\n            continue\n        if not bool((coords[:, 0] == 0).any()):\n            continue\n        rmax = int(coords[:, 0].max())\n        cols = sorted({int(c) for r, c in coords if int(r) == int(rmax)})\n        for c in cols:\n            sources.append((int(rmax), int(c)))\n\n    # shelf segments (from original grid g)\n    shelf_segs: list[list[tuple[int, int]]] = [[] for _ in range(H)]\n    for r in range(H):\n        c = 0\n        while c < W:\n            if int(g[int(r), int(c)]) != int(shelf):\n                c += 1\n                continue\n            c0 = int(c)\n            while c + 1 < W and int(g[int(r), int(c + 1)]) == int(shelf):\n                c += 1\n            shelf_segs[int(r)].append((int(c0), int(c)))\n            c += 1\n\n    def find_shelf_seg(r: int, c: int) -> tuple[int, int] | None:\n        for a, b in shelf_segs[int(r)]:\n            if int(a) <= int(c) <= int(b):\n                return (int(a), int(b))\n        return None\n\n    def spread_limits(row: int, start_col: int, min_col: int, max_col: int) -> tuple[int, int]:\n        \"\"\"\n        Expand horizontally only through contiguous bg cells on the current row.\n\n        This prevents water from \"jumping\" over blockers that sit on the spread row.\n        \"\"\"\n        left = int(start_col)\n        while left - 1 >= int(min_col) and int(g[int(row), int(left - 1)]) == int(bg):\n            left -= 1\n\n        right = int(start_col)\n        while right + 1 <= int(max_col) and int(g[int(row), int(right + 1)]) == int(bg):\n            right += 1\n\n        return (int(left), int(right))\n\n    seen: set[tuple[int, int]] = set()\n    q = deque((int(r), int(c)) for r, c in sources)\n\n    while q:\n        r, c = q.popleft()\n        if (int(r), int(c)) in seen:\n            continue\n        seen.add((int(r), int(c)))\n\n        rr, cc = int(r), int(c)\n        out[rr, cc] = int(water)\n\n        while True:\n            nr = int(rr + 1)\n            if nr >= H:\n                break\n            below = int(g[int(nr), int(cc)])\n\n            if below == int(shelf):\n                seg = find_shelf_seg(nr, cc)\n                if seg is None:\n                    break\n                a, b = seg\n                left_bound = int(max(0, int(a - 1)))\n                right_bound = int(min(int(W - 1), int(b + 1)))\n                left, right = spread_limits(rr, cc, left_bound, right_bound)\n                for x in range(left, right + 1):\n                    if int(g[int(rr), int(x)]) == int(bg):\n                        out[int(rr), int(x)] = int(water)\n                for nc in {left, right}:\n                    if int(nc) != int(cc):\n                        q.append((int(rr), int(nc)))\n                break\n\n            rr = nr\n            out[int(rr), int(cc)] = int(water)\n\n    return out\n\n# --------------- generator (cascade tree top-down construction) ---------------\n\ndef _gen_attempt() -> np.ndarray | None:\n    \"\"\"Single attempt to generate a valid input for the waterfall cascade task.\"\"\"\n    BG, WATER, SHELF = 7, 6, 2\n\n    H = random.randint(8, 30)\n    W = random.randint(5, 30)\n\n    num_sources = random.choice([1, 2]) if W >= 14 else 1\n    if num_sources == 2:\n        src1 = random.randint(0, W - 8)\n        src2 = random.randint(src1 + 7, W - 1)\n        source_cols = [src1, src2]\n    else:\n        source_cols = [random.randint(0, W - 1)]\n\n    # Track cells reserved for shelf\n    shelf_cells: set[tuple[int, int]] = set()\n    # Cells that must remain bg (overflow positions, fall paths, source positions)\n    reserved_bg: set[tuple[int, int]] = set()\n\n    # Reserve source positions\n    for sc in source_cols:\n        reserved_bg.add((0, sc))\n        reserved_bg.add((1, sc))\n\n    all_shelves: list[tuple[int, int, int]] = []  # (row, a, b)\n\n    def try_add_shelf(r: int, a: int, b: int, is_cascade: bool = False) -> bool:\n        \"\"\"Try to add a shelf segment. Check no conflict with existing shelves or reserved bg cells.\"\"\"\n        cells = [(r, c) for c in range(a, b + 1)]\n        for cell in cells:\n            if cell in shelf_cells or cell in reserved_bg:\n                return False\n        for cell in cells:\n            shelf_cells.add(cell)\n        all_shelves.append((r, a, b))\n        return True\n\n    def reserve_overflow_and_fall(spread_row: int, left: int, right: int, incoming_col: int):\n        \"\"\"Reserve overflow positions and their fall paths as must-be-bg.\"\"\"\n        for nc in {left, right}:\n            if nc != incoming_col:\n                # The overflow position itself must be bg\n                reserved_bg.add((spread_row, nc))\n                # Fall path below must be bg until next shelf or grid bottom\n                # We'll just reserve the overflow position for now;\n                # fall path conflicts are handled by checking during shelf placement\n\n    max_depth = random.randint(2, 5)\n    if H < max_depth * 2 + 3:\n        max_depth = max(2, (H - 3) // 2)\n\n    # Build cascade tree top-down\n    # Each stream: (current_row, col, depth)\n    streams: list[tuple[int, int, int]] = [(1, sc, 0) for sc in source_cols]\n    cascade_shelves: list[tuple[int, int, int]] = []\n    processed = set()\n\n    while streams:\n        next_streams = []\n        random.shuffle(streams)\n        for (row, col, depth) in streams:\n            if (row, col) in processed:\n                continue\n            processed.add((row, col))\n\n            if depth >= max_depth or row + 2 >= H:\n                continue\n\n            min_shelf_row = row + 2\n            max_shelf_row = min(H - 1, row + 8)\n            if min_shelf_row > max_shelf_row:\n                continue\n\n            # Try a few times to place a shelf\n            placed = False\n            for _try in range(10):\n                shelf_row = random.randint(min_shelf_row, max_shelf_row)\n                spread_row = shelf_row - 1\n                if spread_row <= row:\n                    continue\n\n                # Check fall path from (row+1, col) to (shelf_row-1, col) is clear\n                blocked = False\n                for r_check in range(row + 1, shelf_row):\n                    if (r_check, col) in shelf_cells:\n                        blocked = True\n                        break\n                if blocked:\n                    continue\n\n                # Generate shelf segment containing col\n                shelf_len = random.randint(2, min(8, W))\n                max_start = col\n                min_start = max(0, col - shelf_len + 1)\n                if min_start > max_start:\n                    continue\n                a = random.randint(min_start, max_start)\n                b = min(a + shelf_len - 1, W - 1)\n\n                # Check shelf cells don't conflict\n                conflict = False\n                for c in range(a, b + 1):\n                    if (shelf_row, c) in shelf_cells or (shelf_row, c) in reserved_bg:\n                        conflict = True\n                        break\n                if conflict:\n                    continue\n\n                # Compute overflow positions\n                left = max(0, a - 1)\n                right = min(W - 1, b + 1)\n\n                # Check overflow positions on spread row are not shelf\n                overflow_ok = True\n                for nc in {left, right}:\n                    if nc != col:\n                        if (spread_row, nc) in shelf_cells:\n                            overflow_ok = False\n                            break\n                if not overflow_ok:\n                    continue\n\n                # Add the shelf\n                if not try_add_shelf(shelf_row, a, b, is_cascade=True):\n                    continue\n\n                cascade_shelves.append((shelf_row, a, b))\n\n                # Reserve overflow positions and fall path cells as bg\n                reserve_overflow_and_fall(spread_row, left, right, col)\n\n                # Reserve the fall path from current position to shelf\n                for r_res in range(row + 1, shelf_row):\n                    reserved_bg.add((r_res, col))\n\n                # Add new streams from overflow\n","exit_code":0,"status":"completed"}}
