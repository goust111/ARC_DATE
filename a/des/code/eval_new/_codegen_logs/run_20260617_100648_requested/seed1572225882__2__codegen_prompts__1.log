{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"bash -lc 'cat > /home/lixinyu/snap/a/des/code/eval_new/seed1572225882/2/1.py <<\\\"PY\\\"\n\\\"\\\"\\\"Fill framed regions by deriving each region color from seed statistics, then leak a ray from its gap.\n\nInput structure:\n- 背景为 black(0)。\n- 每个区域由单像素灰色(默认5)矩形边框围成，边框恰有一个缺口像素。\n- 区域内部主要是 black，夹杂若干不同颜色的单像素种子点，种子位于边框内而边框上。\n\nRule:\n- 对每个灰框区域，统计内部种子颜色的频次。颜色种类数记为 K，出现次数恰为 K 的颜色为候选填充色；若有多个候选，选择离缺口位置最近的那个颜色。\n- 将该区域内部所有 black 像素改为该填充色（种子颜色保持不变）。\n- 从缺口处沿缺口外侧方向发射宽 1 像素射线，射线颜色为填充色，并一直延伸到边界外或再次遇到灰框像素；多个射线按区域从上到下、从左到右顺序绘制，后绘制覆盖先绘制。\n\nKey insight:\n- 仅凭缺口无法得到射线颜色，必须先通过“颜色种类数 K 与出现次数 K 的颜色”这一步反推每个区域的代表色，再依据缺口方向画射线。\n\\\"\\\"\\\"\n\nfrom __future__ import annotations\n\nfrom collections import deque\nfrom collections.abc import Iterable\nfrom typing import Dict, List, Optional, Tuple\n\nimport numpy as np\n\nBG_COLOR = 0\nDEFAULT_FRAME_COLOR = 5\nSEED_PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]\n\n\ndef _frame_candidates(grid: np.ndarray, frame_color: int) -> List[Tuple[int, int, int, int, Tuple[int, int]]]:\n    h, w = grid.shape\n    mask = grid == frame_color\n    visited = np.zeros_like(mask, dtype=bool)\n    candidates: List[Tuple[int, int, int, int, Tuple[int, int]]] = []\n\n    for sr in range(h):\n        for sc in range(w):\n            if not mask[sr, sc] or visited[sr, sc]:\n                continue\n\n            q = deque([(sr, sc)])\n            visited[sr, sc] = True\n            coords = [(sr, sc)]\n\n            while q:\n                r, c = q.popleft()\n                if r > 0 and mask[r - 1, c] and not visited[r - 1, c]:\n                    visited[r - 1, c] = True\n                    q.append((r - 1, c))\n                    coords.append((r - 1, c))\n                if r + 1 < h and mask[r + 1, c] and not visited[r + 1, c]:\n                    visited[r + 1, c] = True\n                    q.append((r + 1, c))\n                    coords.append((r + 1, c))\n                if c > 0 and mask[r, c - 1] and not visited[r, c - 1]:\n                    visited[r, c - 1] = True\n                    q.append((r, c - 1))\n                    coords.append((r, c - 1))\n                if c + 1 < w and mask[r, c + 1] and not visited[r, c + 1]:\n                    visited[r, c + 1] = True\n                    q.append((r, c + 1))\n                    coords.append((r, c + 1))\n\n            rs = [r for r, _ in coords]\n            cs = [c for _, c in coords]\n            r0, r1 = min(rs), max(rs)\n            c0, c1 = min(cs), max(cs)\n            height = r1 - r0 + 1\n            width = c1 - c0 + 1\n            if height < 3 or width < 3:\n                continue\n\n            expected: set[tuple[int, int]] = set()\n            for c in range(c0, c1 + 1):\n                expected.add((r0, c))\n                expected.add((r1, c))\n            for r in range(r0 + 1, r1):\n                expected.add((r, c0))\n                expected.add((r, c1))\n\n            coord_set = set(coords)\n            if len(coord_set - expected) > 0:\n                continue\n\n            missing = expected - coord_set\n            if len(missing) \"'!= 1:\n                continue\n\n            (gr, gc) = next(iter(missing))\n            if (gr in (r0, r1) and gc in (c0, c1)):\n                continue\n\n            candidates.append((r0, c0, r1, c1, (gr, gc)))\n\n    return candidates\n\n\ndef _select_fill_color(grid: np.ndarray, region: Tuple[int, int, int, int], opening: Tuple[int, int], frame_color: int) -> Optional[int]:\n    r0, c0, r1, c1 = region\n    seed_positions: Dict[int, List[Tuple[int, int]]] = {}\n\n    for r in range(r0 + 1, r1):\n        for c in range(c0 + 1, c1):\n            v = int(grid[r, c])\n            if v == BG_COLOR or v == frame_color:\n                continue\n            seed_positions.setdefault(v, []).append((r, c))\n\n    if not seed_positions:\n        return None\n\n    k = len(seed_positions)\n    candidates = [color for color, pos in seed_positions.items() if len(pos) == k]\n    if candidates:\n        if len(candidates) == 1:\n            return candidates[0]\n\n        gr, gc = opening\n        best = candidates[0]\n        best_dist = abs(seed_positions[best][0][0] - gr) + abs(seed_positions[best][0][1] - gc)\n        for color in candidates[1:]:\n            dist = min(abs(r - gr) + abs(c - gc) for r, c in seed_positions[color])\n            if dist < best_dist or (dist == best_dist and color < best):\n                best = color\n                best_dist = dist\n        return best\n\n    # Fallback: if no count==K color exists, keep the most frequent internal color.\n    best = next(iter(seed_positions.items()))\n    for color, pos in seed_positions.items():\n        if len(pos) > len(best[1]) or (len(pos) == len(best[1]) and color < best[0]):\n            best = (color, pos)\n    return best[0]\n\n\ndef _ray_direction(r0: int, c0: int, r1: int, c1: int, opening: Tuple[int, int]) -> Tuple[int, int]:\n    gr, gc = opening\n    if gr == r0:\n        return -1, 0\n    if gr == r1:\n        return 1, 0\n    if gc == c0:\n        return 0, -1\n    return 0, 1\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    grid_np = np.asarray(grid)\n    out = grid_np.copy()\n    if grid_np.ndim != 2:\n        return out\n\n    colors, counts = np.unique(grid_np, return_counts=True)\n    non_bg = colors != BG_COLOR\n    if not np.any(non_bg):\n        return out\n    frame_color = int(colors[non_bg][int(np.argmax(counts[non_bg]))])\n\n    regions = _frame_candidates(out, frame_color)\n    regions.sort(key=lambda item: (item[0], item[1]))  # top to bottom, left to right\n\n    for r0, c0, r1, c1, opening in regions:\n        fill_color = _select_fill_color(out, (r0, c0, r1, c1), opening, frame_color)\n        if fill_color is None:\n            continue\n\n        for r in range(r0 + 1, r1):\n            for c in range(c0 + 1, c1):\n                if out[r, c] == BG_COLOR:\n                    out[r, c] = fill_color\n\n        dr, dc = _ray_direction(r0, c0, r1, c1, opening)\n        rr, cc = opening\n        h, w = out.shape\n        while 0 <= rr < h and 0 <= cc < w:\n            if out[rr, cc] == frame_color:\n                break\n            out[rr, cc] = fill_color\n            rr += dr\n            cc += dc\n\n    return out\n\n\ndef _set_if_available(\n    arr: np.ndarray,\n    positions: Iterable[Tuple[int, int]],\n    value: int,\n    occupied: np.ndarray,\n    blocked: Optional[np.ndarray] = None,\n) -> None:\n    h, w = arr.shape\n    for r, c in positions:\n        if 0 <= r < h and 0 <= c < w:\n            arr[r, c] = value\n            if blocked is not None:\n                blocked[r, c] = True\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n    target_frame = DEFAULT_FRAME_COLOR\n    for _ in range(80):\n        h = int(rng.integers(14, 30))\n        w = int(rng.integers(14, 30))\n        grid = np.full((h, w), BG_COLOR, dtype=np.int64)\n        blocked = np.zeros_like(grid, dtype=bool)\n\n        target_regions = int(rng.integers(1, 5))\n        placed = 0\n\n        for _ in range(target_regions):\n            for _ in range(120):\n                ih = int(rng.integers(2, 8))\n                iw = int(rng.integers(2, 8))\n                fh = ih + 2\n                fw = iw + 2\n                if fh > h - 1 or fw > w - 1:\n                    continue\n\n                r0 = int(rng.integers(1, h - fh))\n                c0 = int(rng.integers(1, w - fw))\n                r1 = r0 + fh - 1\n                c1 = c0 + fw - 1\n\n                r_min = max(0, r0 - 1)\n                r_max = min(h, r1 + 2)\n                c_min = max(0, c0 - 1)\n                c_max = min(w, c1 + 2)\n                if blocked[r_min:r_max, c_min:c_max].any():\n                    continue\n\n                open_dir = int(rng.integers(4))\n                if open_dir == 0:  # top\n                    gr = r0\n                    gc = int(rng.integers(c0 + 1, c1))\n                elif open_dir == 1:  # bottom\n                    gr = r1\n                    gc = int(rng.integers(c0 + 1, c1))\n                elif open_dir == 2:  # left\n                    gr = int(rng.integers(r0 + 1, r1))\n                    gc = c0\n                else:  # right\n                    gr = int(rng.integers(r0 + 1, r1))\n                    gc = c1\n\n                # Draw rectangular frame with one missing pixel.\n                for c in range(c0, c1 + 1):\n                    if not (r0 == gr and c == gc):\n                        grid[r0, c] = target_frame\n                    if not (r1 == gr and c == gc):\n                        grid[r1, c] = target_frame\n                for r in range(r0 + 1, r1):\n                    if not (r == gr and c0 == gc):\n                        grid[r, c0] = target_frame\n                    if not (r == gr and c1 == gc):\n                        grid[r, c1] = target_frame\n\n                interior: List[Tuple[int, int]] = [\n                    (r, c)\n                    for r in range(r0 + 1, r1)\n                    for c in range(c0 + 1, c1)\n                ]\n\n                if len(interior) < 4:\n                    continue\n\n                interior_size = len(interior)\n                max_k = min(3, interior_size // 2)\n                if max_k < 1:\n                    continue\n\n                for _ in range(40):\n                    k = int(rng.integers(1, max_k + 1))\n                    colors = rng.choice(SEED_PALETTE, size=k, replace=False)\n\n                    tie = k > 1 and rng.random() < 0.5\n                    counts: Dict[int, int] = {}\n                    if tie:\n                        cA, cB = int(colors[0]), int(colors[1])\n                        counts[cA] = k\n                        counts[cB] = k\n                        for c in colors[2:]:\n                            cand = 1\n                            while True:\n                                cand = int(rng.integers(1, 4))\n                                if cand != k:\n                                    break\n                            counts[int(c)] = cand\n                    else:\n                        counts[int(colors[0])] = k\n                        for c in colors[1:]:\n                            cand = int(rng.integers(1, 4))\n                            if cand == k:\n                                cand = 3 if k != 3 else 2\n                            counts[int(c)] = cand\n\n                    total = sum(counts.values())\n                    if total <= interior_size:\n                        break\n\n                else:\n                    continue\n\n                rng.shuffle(interior)\n                if sum(counts.values()) > len(interior):\n                    continue\n\n                # Put tie colors with controlled near/far order to trigger deterministic distance-based tie-break.\n                remaining = interior.copy()\n                if tie and k > 1:\n                    by_dist = sorted(remaining, key=lambda p: abs(p[0] - gr) + abs(p[1] - gc))\n                    near = by_dist[0]\n                    far = by_dist[-1]\n                    remaining = [p for p in remaining if p != near and p != far]\n                    # place cA and cB with the closest/ farthest constraints\n                    ordered_colors = [int(colors[0]), int(colors[1])] + [int(c) for c in colors[2:]]\n                else:\n                    ordered_colors = [int(c) for c in colors]\n\n                for color in ordered_colors:\n                    need = counts[color]\n                    forced = None\n\n                    if tie and k > 1 and color == int(colors[0]) and need > 0:\n                        forced = near\n                        need -= 1\n                    if tie and k > 1 and color == int(colors[1]) and need > 0:\n                        forced = far\n                        need -= 1\n\n                    if need > len(remaining):\n                        break\n\n                    picks = []\n                    if forced is not None:\n                        picks.append(forced)\n                    if need > 0:\n                        idx = rng.choice(len(remaining), size=need, replace=False)\n                        if np.isscalar(idx):\n                            idx = [int(idx)]\n                        else:\n                            idx = idx.tolist()\n                        for i in sorted(idx, reverse=True):\n                            picks.append(remaining[i])\n                            del remaining[i]\n\n                    for rr, cc in picks:\n                        grid[rr, cc] = color\n                else:\n                    pass\n\n                blocked[r0:r1 + 1, c0:c1 + 1] = True\n                placed += 1\n                break\n\n        if placed >= 1:\n            return grid\n\n    # Fallback: build one small valid instance to avoid pathological generation failure.\n    grid = np.zeros((18, 18), dtype=np.int64)\n    r0, c0 = 5, 5\n    ih, iw = 4, 5\n    r1, c1 = r0 + ih + 1, c0 + iw + 1\n    for c in range(c0, c1 + 1):\n        grid[r0, c] = target_frame\n        grid[r1, c] = target_frame\n    for r in range(r0 + 1, r1):\n        grid[r, c0] = target_frame\n        grid[r, c1] = target_frame\n    grid[r0, c0 + 2] = BG_COLOR\n    grid[r0 + 1, c0 + 2] = 1\n    grid[r0 + 2, c0 + 3] = 2\n    return grid\n\n\nif __name__ == \"__main__\":\n    sample = generate_input()\n    print(sample)\n    print(main(sample))\nPY'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"bash -lc 'cat > /home/lixinyu/snap/a/des/code/eval_new/seed1572225882/2/1.py <<\\\"PY\\\"\n\\\"\\\"\\\"Fill framed regions by deriving each region color from seed statistics, then leak a ray from its gap.\n\nInput structure:\n- 背景为 black(0)。\n- 每个区域由单像素灰色(默认5)矩形边框围成，边框恰有一个缺口像素。\n- 区域内部主要是 black，夹杂若干不同颜色的单像素种子点，种子位于边框内而边框上。\n\nRule:\n- 对每个灰框区域，统计内部种子颜色的频次。颜色种类数记为 K，出现次数恰为 K 的颜色为候选填充色；若有多个候选，选择离缺口位置最近的那个颜色。\n- 将该区域内部所有 black 像素改为该填充色（种子颜色保持不变）。\n- 从缺口处沿缺口外侧方向发射宽 1 像素射线，射线颜色为填充色，并一直延伸到边界外或再次遇到灰框像素；多个射线按区域从上到下、从左到右顺序绘制，后绘制覆盖先绘制。\n\nKey insight:\n- 仅凭缺口无法得到射线颜色，必须先通过“颜色种类数 K 与出现次数 K 的颜色”这一步反推每个区域的代表色，再依据缺口方向画射线。\n\\\"\\\"\\\"\n\nfrom __future__ import annotations\n\nfrom collections import deque\nfrom collections.abc import Iterable\nfrom typing import Dict, List, Optional, Tuple\n\nimport numpy as np\n\nBG_COLOR = 0\nDEFAULT_FRAME_COLOR = 5\nSEED_PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]\n\n\ndef _frame_candidates(grid: np.ndarray, frame_color: int) -> List[Tuple[int, int, int, int, Tuple[int, int]]]:\n    h, w = grid.shape\n    mask = grid == frame_color\n    visited = np.zeros_like(mask, dtype=bool)\n    candidates: List[Tuple[int, int, int, int, Tuple[int, int]]] = []\n\n    for sr in range(h):\n        for sc in range(w):\n            if not mask[sr, sc] or visited[sr, sc]:\n                continue\n\n            q = deque([(sr, sc)])\n            visited[sr, sc] = True\n            coords = [(sr, sc)]\n\n            while q:\n                r, c = q.popleft()\n                if r > 0 and mask[r - 1, c] and not visited[r - 1, c]:\n                    visited[r - 1, c] = True\n                    q.append((r - 1, c))\n                    coords.append((r - 1, c))\n                if r + 1 < h and mask[r + 1, c] and not visited[r + 1, c]:\n                    visited[r + 1, c] = True\n                    q.append((r + 1, c))\n                    coords.append((r + 1, c))\n                if c > 0 and mask[r, c - 1] and not visited[r, c - 1]:\n                    visited[r, c - 1] = True\n                    q.append((r, c - 1))\n                    coords.append((r, c - 1))\n                if c + 1 < w and mask[r, c + 1] and not visited[r, c + 1]:\n                    visited[r, c + 1] = True\n                    q.append((r, c + 1))\n                    coords.append((r, c + 1))\n\n            rs = [r for r, _ in coords]\n            cs = [c for _, c in coords]\n            r0, r1 = min(rs), max(rs)\n            c0, c1 = min(cs), max(cs)\n            height = r1 - r0 + 1\n            width = c1 - c0 + 1\n            if height < 3 or width < 3:\n                continue\n\n            expected: set[tuple[int, int]] = set()\n            for c in range(c0, c1 + 1):\n                expected.add((r0, c))\n                expected.add((r1, c))\n            for r in range(r0 + 1, r1):\n                expected.add((r, c0))\n                expected.add((r, c1))\n\n            coord_set = set(coords)\n            if len(coord_set - expected) > 0:\n                continue\n\n            missing = expected - coord_set\n            if len(missing) \"'!= 1:\n                continue\n\n            (gr, gc) = next(iter(missing))\n            if (gr in (r0, r1) and gc in (c0, c1)):\n                continue\n\n            candidates.append((r0, c0, r1, c1, (gr, gc)))\n\n    return candidates\n\n\ndef _select_fill_color(grid: np.ndarray, region: Tuple[int, int, int, int], opening: Tuple[int, int], frame_color: int) -> Optional[int]:\n    r0, c0, r1, c1 = region\n    seed_positions: Dict[int, List[Tuple[int, int]]] = {}\n\n    for r in range(r0 + 1, r1):\n        for c in range(c0 + 1, c1):\n            v = int(grid[r, c])\n            if v == BG_COLOR or v == frame_color:\n                continue\n            seed_positions.setdefault(v, []).append((r, c))\n\n    if not seed_positions:\n        return None\n\n    k = len(seed_positions)\n    candidates = [color for color, pos in seed_positions.items() if len(pos) == k]\n    if candidates:\n        if len(candidates) == 1:\n            return candidates[0]\n\n        gr, gc = opening\n        best = candidates[0]\n        best_dist = abs(seed_positions[best][0][0] - gr) + abs(seed_positions[best][0][1] - gc)\n        for color in candidates[1:]:\n            dist = min(abs(r - gr) + abs(c - gc) for r, c in seed_positions[color])\n            if dist < best_dist or (dist == best_dist and color < best):\n                best = color\n                best_dist = dist\n        return best\n\n    # Fallback: if no count==K color exists, keep the most frequent internal color.\n    best = next(iter(seed_positions.items()))\n    for color, pos in seed_positions.items():\n        if len(pos) > len(best[1]) or (len(pos) == len(best[1]) and color < best[0]):\n            best = (color, pos)\n    return best[0]\n\n\ndef _ray_direction(r0: int, c0: int, r1: int, c1: int, opening: Tuple[int, int]) -> Tuple[int, int]:\n    gr, gc = opening\n    if gr == r0:\n        return -1, 0\n    if gr == r1:\n        return 1, 0\n    if gc == c0:\n        return 0, -1\n    return 0, 1\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    grid_np = np.asarray(grid)\n    out = grid_np.copy()\n    if grid_np.ndim != 2:\n        return out\n\n    colors, counts = np.unique(grid_np, return_counts=True)\n    non_bg = colors != BG_COLOR\n    if not np.any(non_bg):\n        return out\n    frame_color = int(colors[non_bg][int(np.argmax(counts[non_bg]))])\n\n    regions = _frame_candidates(out, frame_color)\n    regions.sort(key=lambda item: (item[0], item[1]))  # top to bottom, left to right\n\n    for r0, c0, r1, c1, opening in regions:\n        fill_color = _select_fill_color(out, (r0, c0, r1, c1), opening, frame_color)\n        if fill_color is None:\n            continue\n\n        for r in range(r0 + 1, r1):\n            for c in range(c0 + 1, c1):\n                if out[r, c] == BG_COLOR:\n                    out[r, c] = fill_color\n\n        dr, dc = _ray_direction(r0, c0, r1, c1, opening)\n        rr, cc = opening\n        h, w = out.shape\n        while 0 <= rr < h and 0 <= cc < w:\n            if out[rr, cc] == frame_color:\n                break\n            out[rr, cc] = fill_color\n            rr += dr\n            cc += dc\n\n    return out\n\n\ndef _set_if_available(\n    arr: np.ndarray,\n    positions: Iterable[Tuple[int, int]],\n    value: int,\n    occupied: np.ndarray,\n    blocked: Optional[np.ndarray] = None,\n) -> None:\n    h, w = arr.shape\n    for r, c in positions:\n        if 0 <= r < h and 0 <= c < w:\n            arr[r, c] = value\n            if blocked is not None:\n                blocked[r, c] = True\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n    target_frame = DEFAULT_FRAME_COLOR\n    for _ in range(80):\n        h = int(rng.integers(14, 30))\n        w = int(rng.integers(14, 30))\n        grid = np.full((h, w), BG_COLOR, dtype=np.int64)\n        blocked = np.zeros_like(grid, dtype=bool)\n\n        target_regions = int(rng.integers(1, 5))\n        placed = 0\n\n        for _ in range(target_regions):\n            for _ in range(120):\n                ih = int(rng.integers(2, 8))\n                iw = int(rng.integers(2, 8))\n                fh = ih + 2\n                fw = iw + 2\n                if fh > h - 1 or fw > w - 1:\n                    continue\n\n                r0 = int(rng.integers(1, h - fh))\n                c0 = int(rng.integers(1, w - fw))\n                r1 = r0 + fh - 1\n                c1 = c0 + fw - 1\n\n                r_min = max(0, r0 - 1)\n                r_max = min(h, r1 + 2)\n                c_min = max(0, c0 - 1)\n                c_max = min(w, c1 + 2)\n                if blocked[r_min:r_max, c_min:c_max].any():\n                    continue\n\n                open_dir = int(rng.integers(4))\n                if open_dir == 0:  # top\n                    gr = r0\n                    gc = int(rng.integers(c0 + 1, c1))\n                elif open_dir == 1:  # bottom\n                    gr = r1\n                    gc = int(rng.integers(c0 + 1, c1))\n                elif open_dir == 2:  # left\n                    gr = int(rng.integers(r0 + 1, r1))\n                    gc = c0\n                else:  # right\n                    gr = int(rng.integers(r0 + 1, r1))\n                    gc = c1\n\n                # Draw rectangular frame with one missing pixel.\n                for c in range(c0, c1 + 1):\n                    if not (r0 == gr and c == gc):\n                        grid[r0, c] = target_frame\n                    if not (r1 == gr and c == gc):\n                        grid[r1, c] = target_frame\n                for r in range(r0 + 1, r1):\n                    if not (r == gr and c0 == gc):\n                        grid[r, c0] = target_frame\n                    if not (r == gr and c1 == gc):\n                        grid[r, c1] = target_frame\n\n                interior: List[Tuple[int, int]] = [\n                    (r, c)\n                    for r in range(r0 + 1, r1)\n                    for c in range(c0 + 1, c1)\n                ]\n\n                if len(interior) < 4:\n                    continue\n\n                interior_size = len(interior)\n                max_k = min(3, interior_size // 2)\n                if max_k < 1:\n                    continue\n\n                for _ in range(40):\n                    k = int(rng.integers(1, max_k + 1))\n                    colors = rng.choice(SEED_PALETTE, size=k, replace=False)\n\n                    tie = k > 1 and rng.random() < 0.5\n                    counts: Dict[int, int] = {}\n                    if tie:\n                        cA, cB = int(colors[0]), int(colors[1])\n                        counts[cA] = k\n                        counts[cB] = k\n                        for c in colors[2:]:\n                            cand = 1\n                            while True:\n                                cand = int(rng.integers(1, 4))\n                                if cand != k:\n                                    break\n                            counts[int(c)] = cand\n                    else:\n                        counts[int(colors[0])] = k\n                        for c in colors[1:]:\n                            cand = int(rng.integers(1, 4))\n                            if cand == k:\n                                cand = 3 if k != 3 else 2\n                            counts[int(c)] = cand\n\n                    total = sum(counts.values())\n                    if total <= interior_size:\n                        break\n\n                else:\n                    continue\n\n                rng.shuffle(interior)\n                if sum(counts.values()) > len(interior):\n                    continue\n\n                # Put tie colors with controlled near/far order to trigger deterministic distance-based tie-break.\n                remaining = interior.copy()\n                if tie and k > 1:\n                    by_dist = sorted(remaining, key=lambda p: abs(p[0] - gr) + abs(p[1] - gc))\n                    near = by_dist[0]\n                    far = by_dist[-1]\n                    remaining = [p for p in remaining if p != near and p != far]\n                    # place cA and cB with the closest/ farthest constraints\n                    ordered_colors = [int(colors[0]), int(colors[1])] + [int(c) for c in colors[2:]]\n                else:\n                    ordered_colors = [int(c) for c in colors]\n\n                for color in ordered_colors:\n                    need = counts[color]\n                    forced = None\n\n                    if tie and k > 1 and color == int(colors[0]) and need > 0:\n                        forced = near\n                        need -= 1\n                    if tie and k > 1 and color == int(colors[1]) and need > 0:\n                        forced = far\n                        need -= 1\n\n                    if need > len(remaining):\n                        break\n\n                    picks = []\n                    if forced is not None:\n                        picks.append(forced)\n                    if need > 0:\n                        idx = rng.choice(len(remaining), size=need, replace=False)\n                        if np.isscalar(idx):\n                            idx = [int(idx)]\n                        else:\n                            idx = idx.tolist()\n                        for i in sorted(idx, reverse=True):\n                            picks.append(remaining[i])\n                            del remaining[i]\n\n                    for rr, cc in picks:\n                        grid[rr, cc] = color\n                else:\n                    pass\n\n                blocked[r0:r1 + 1, c0:c1 + 1] = True\n                placed += 1\n                break\n\n        if placed >= 1:\n            return grid\n\n    # Fallback: build one small valid instance to avoid pathological generation failure.\n    grid = np.zeros((18, 18), dtype=np.int64)\n    r0, c0 = 5, 5\n    ih, iw = 4, 5\n    r1, c1 = r0 + ih + 1, c0 + iw + 1\n    for c in range(c0, c1 + 1):\n        grid[r0, c] = target_frame\n        grid[r1, c] = target_frame\n    for r in range(r0 + 1, r1):\n        grid[r, c0] = target_frame\n        grid[r, c1] = target_frame\n    grid[r0, c0 + 2] = BG_COLOR\n    grid[r0 + 1, c0 + 2] = 1\n    grid[r0 + 2, c0 + 3] = 2\n    return grid\n\n\nif __name__ == \"__main__\":\n    sample = generate_input()\n    print(sample)\n    print(main(sample))\nPY'\"'\"","aggregated_output":"","exit_code":0,"status":"completed"}}
