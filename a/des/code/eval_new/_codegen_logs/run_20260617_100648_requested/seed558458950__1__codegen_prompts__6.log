{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"cat > /home/lixinyu/snap/a/des/code/eval_new/seed558458950/1/6.py <<'PY'\nimport numpy as np\nfrom collections import Counter, deque\n\n\nBACKGROUND = 0\nWALL_COLOR = 5\nARROW_COLOR = 2\n\nDIRS_4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\nDIRS_8 = DIRS_4 + [(1, 1), (1, -1), (-1, 1), (-1, -1)]\n\nARROW_TEMPLATES = {\n    (0, 1): frozenset([(0, 0), (1, 1), (2, 0)]),  # >\n    (0, -1): frozenset([(0, 1), (1, 0), (2, 1)]),  # <\n    (1, 0): frozenset([(0, 0), (0, 2), (1, 1)]),  # v\n    (-1, 0): frozenset([(1, 0), (1, 2), (0, 1)]),  # \"'^\n}\n\n\ndef _components(grid: np.ndarray, color: int, dirs=DIRS_4):\n    h, w = grid.shape\n    visited = np.zeros_like(grid, dtype=bool)\n    comps = []\n    for rr in range(h):\n        for cc in range(w):\n            if visited[rr, cc] or grid[rr, cc] != color:\n                continue\n            q = deque([(rr, cc)])\n            visited[rr, cc] = True\n            comp = []\n            while q:\n                r, c = q.popleft()\n                comp.append((r, c))\n                for dr, dc in dirs:\n                    nr = r + dr\n                    nc = c + dc\n                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and grid[nr, nc] == color:\n                        visited[nr, nc] = True\n                        q.append((nr, nc))\n            comps.append(comp)\n    return comps\n\n\ndef _bbox(cells):\n    rs = [r for r, _ in cells]\n    cs = [c for _, c in cells]\n    min_r, max_r = min(rs), max(rs)\n    min_c, max_c = min(cs), max(cs)\n    return min_r, max_r, min_c, max_c\n\n\ndef _norm_shape(cells):\n    min_r, max_r, min_c, max_c = _bbox(cells)\n    return frozenset((r - min_r, c - min_c) for r, c in cells)\n\n\ndef _is_solid_square(cells):\n    min_r, max_r, min_c, max_c = _bbox(cells)\n    h = max_r - min_r + 1\n    w = max_c - min_c + 1\n    if h not in (2, 3) or w not in (2, 3) or h != w:\n        return False, None\n    area = h * w\n    if len(cells) != area:\n        return False, None\n    return True, h\n\n\ndef _is_straight_line(cells):\n    min_r, max_r, min_c, max_c = _bbox(cells)\n    h = max_r - min_r + 1\n    w = max_c - min_c + 1\n    if len(cells) == 1:\n        return False, None\n    if h == 1 and w == len(cells):\n        return True, '\"'h'\n    if w == 1 and h == len(cells):\n        return True, 'v'\n    return False, None\n\n\ndef _get_background(grid: np.ndarray):\n    flat = grid.reshape(-1)\n    counts = Counter(flat.tolist())\n    return counts.most_common(1)[0][0]\n\n\ndef _find_arrow_components(grid, bg_color):\n    h, w = grid.shape\n    arrows = []\n    for color in np.unique(grid):\n        if color == bg_color:\n            continue\n        comps = _components(grid, int(color), dirs=DIRS_8)\n        for comp in comps:\n            if len(comp) \"'!= 3:\n                continue\n            shape = _norm_shape(comp)\n            for d, template in ARROW_TEMPLATES.items():\n                if shape == template:\n                    arrows.append(\n                        {\n                            '\"'color': int(color),\n                            'dir': d,\n                            'cells': comp,\n                            'bbox': _bbox(comp),\n                        }\n                    )\n                    break\n    return arrows\n\n\ndef _find_wall_color(grid, bg_color):\n    best_color = None\n    best_components = []\n    best_len = 0\n\n    for color in np.unique(grid):\n        color = int(color)\n        if color == bg_color:\n            continue\n        total_len = 0\n        line_cells = []\n        for comp in _components(grid, color, dirs=DIRS_4):\n            ok, orient = _is_straight_line(comp)\n            if ok and len(comp) >= 2:\n                total_len += len(comp)\n                line_cells.extend(comp)\n        if total_len > best_len:\n            best_len = total_len\n            best_color = color\n            best_components = line_cells\n    if best_color is None:\n        return None, set()\n    return best_color, set(best_components)\n\n\ndef _measure_to_wall(grid, source, dirv, wall_cells, bg):\n    min_r, max_r, min_c, max_c = source['bbox']\n    h, w = grid.shape\n    dr, dc = dirv\n    hits = []\n\n    if (dr, dc) == (0, 1):\n        for rr in range(min_r, max_r + 1):\n            c = max_c + 1\n            d = 0\n            while 0 <= c < w and grid[rr, c] == bg:\n                d += 1\n                c += 1\n            if 0 <= c < w and (rr, c) in wall_cells:\n                hits.append((d, rr, c))\n    elif (dr, dc) == (0, -1):\n        for rr in range(min_r, max_r + 1):\n            c = min_c - 1\n            d = 0\n            while 0 <= c < w and grid[rr, c] == bg:\n                d += 1\n                c -= 1\n            if 0 <= c < w and (rr, c) in wall_cells:\n                hits.append((d, rr, c))\n    elif (dr, dc) == (1, 0):\n        for cc in range(min_c, max_c + 1):\n            r = max_r + 1\n            d = 0\n            while 0 <= r < h and grid[r, cc] == bg:\n                d += 1\n                r += 1\n            if 0 <= r < h and (r, cc) in wall_cells:\n                hits.append((d, r, cc))\n    else:\n        for cc in range(min_c, max_c + 1):\n            r = min_r - 1\n            d = 0\n            while 0 <= r < h and grid[r, cc] == bg:\n                d += 1\n                r -= 1\n            if 0 <= r < h and (r, cc) in wall_cells:\n                hits.append((d, r, cc))\n\n    if not hits:\n        return None\n    best = min(x[0] for x in hits)\n    near_hits = [(r, c) for d, r, c in hits if d == best]\n    return {\n        'dist': best,\n        'hits': near_hits,\n    }\n\n\ndef _arrow_matches_source(source, arrow, dirv):\n    src_min_r, src_max_r, src_min_c, src_max_c = source['bbox']\n    a_min_r, a_max_r, a_min_c, a_max_c = arrow['bbox']\n    gap_r1 = src_min_r - a_max_r\n    gap_r2 = a_min_r - src_max_r\n    gap_c1 = src_min_c - a_max_c\n    gap_c2 = a_min_c - src_max_c\n\n    if dirv == (0, 1):\n        if arrow['dir'] \"'!= dirv:\n            return False\n        if gap_c1 not in (1, 2):\n            return False\n        if a_max_r < src_min_r or a_min_r > src_max_r:\n            return False\n        return True\n\n    if dirv == (0, -1):\n        if arrow['\"'dir'] \"'!= dirv:\n            return False\n        if gap_c2 not in (1, 2):\n            return False\n        if a_max_r < src_min_r or a_min_r > src_max_r:\n            return False\n        return True\n\n    if dirv == (1, 0):\n        if arrow['\"'dir'] \"'!= dirv:\n            return False\n        if gap_r2 not in (1, 2):\n            return False\n        if a_max_c < src_min_c or a_min_c > src_max_c:\n            return False\n        return True\n\n    if dirv == (-1, 0):\n        if arrow['\"'dir'] \"'!= dirv:\n            return False\n        if gap_r1 not in (1, 2):\n            return False\n        if a_max_c < src_min_c or a_min_c > src_max_c:\n            return False\n        return True\n\n    return False\n\n\ndef _paint_scaled_projection(out, source, dirv, dist_info, scale):\n    h, w = out.shape\n    min_r, max_r, min_c, max_c = source['\"'bbox']\n    src_h = max_r - min_r + 1\n    src_w = max_c - min_c + 1\n    color = source['color']\n\n    tgt_h = src_h * scale\n    tgt_w = src_w * scale\n\n    if not dist_info['hits']:\n        return\n    # choose one anchored wall pixel\n    wall_r, wall_c = dist_info['hits'][0]\n\n    if dirv == (0, 1):\n        dst_c = wall_c + 1\n        dst_r = int(round((min_r + max_r) / 2 - (tgt_h - 1) / 2))\n    elif dirv == (0, -1):\n        dst_c = wall_c - tgt_w\n        dst_r = int(round((min_r + max_r) / 2 - (tgt_h - 1) / 2))\n    elif dirv == (1, 0):\n        dst_r = wall_r + 1\n        dst_c = int(round((min_c + max_c) / 2 - (tgt_w - 1) / 2))\n    else:\n        dst_r = wall_r - tgt_h\n        dst_c = int(round((min_c + max_c) / 2 - (tgt_w - 1) / 2))\n\n    if dst_r < 0 or dst_c < 0 or dst_r + tgt_h > h or dst_c + tgt_w > w:\n        return\n\n    for rr in range(min_r, max_r + 1):\n        for cc in range(min_c, max_c + 1):\n            sr = (rr - min_r) * scale\n            sc = (cc - min_c) * scale\n            for dr in range(scale):\n                for dc in range(scale):\n                    out[dst_r + sr + dr, dst_c + sc + dc] = color\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \\\"\\\"\\\"Project source patches across walls according to arrow direction and gap distance.\n\nInput structure:\n- Background is black and dominant.\n- One or more gray straight horizontal/vertical wall line segments are present.\n- Small 2x2 or 3x3 monochrome source patches sit on one side of a wall.\n- A red 3-pixel triangular arrow is adjacent to each source patch, on the side opposite the wall, and points toward the wall.\n\nRule:\nFind each valid source patch, identify its arrow direction, then measure D as the number of background cells from its nearest edge to the first gray wall cell in that direction. If D<=2, draw a 1x copy; if D is 3 or 4 draw a 2x copy; if D>=5 draw a 3x copy. Paint the scaled copy on the wall’s opposite side (through the wall), touching the wall and centered in the perpendicular axis. Keep source patches, arrows and wall pixels unchanged.\n\nKey insight:\nDirection comes from the red marker, while scale is determined by the measured free-space distance, and the copy is positioned by wall-touching placement with perpendicular centering.\\\"\\\"\\\"\n\n    grid = np.array(grid, dtype=np.int64)\n    h, w = grid.shape\n    out = grid.copy()\n\n    bg = _get_background(grid)\n    arrows = _find_arrow_components(grid, bg)\n    if not arrows:\n        return out\n\n    wall_color, wall_cells = _find_wall_color(grid, bg)\n    if wall_color is None:\n        return out\n\n    # source candidates are solid 2x2 or 3x3 monochrome blocks.\n    sources = []\n    for color in np.unique(grid):\n        color = int(color)\n        if color in (bg, wall_color, ARROW_COLOR):\n            continue\n        for comp in _components(grid, color, dirs=DIRS_4):\n            ok, sz = _is_solid_square(comp)\n            if ok:\n                sources.append({'color': color, 'cells': comp, 'bbox': _bbox(comp), 'size': sz})\n\n    for source in sources:\n        best = []\n        for dirv in ((0, 1), (0, -1), (1, 0), (-1, 0)):\n            arrows_dir = [a for a in arrows if a['dir'] == dirv]\n            if not arrows_dir:\n                continue\n            if not any(_arrow_matches_source(source, a, dirv) for a in arrows_dir):\n                continue\n            dist = _measure_to_wall(grid, source, dirv, wall_cells, bg)\n            if dist is None:\n                continue\n            best.append((dist['dist'], dirv, dist))\n\n        if not best:\n            continue\n\n        # choose the nearest match for this source\n        best.sort(key=lambda x: x[0])\n        dist, dirv, dist_info = best[0]\n        if dist <= 2:\n            scale = 1\n        elif dist <= 4:\n            scale = 2\n        else:\n            scale = 3\n        _paint_scaled_projection(out, source, dirv, dist_info, scale)\n\n    return out\n\n\ndef _all_clear(grid, used, cells):\n    h, w = grid.shape\n    for r, c in cells:\n        if not (0 <= r < h and 0 <= c < w):\n            return False\n        if used[r, c]:\n            return False\n    return True\n\n\ndef _draw_cells(grid, used, cells, color):\n    for r, c in cells:\n        grid[r, c] = color\n        used[r, c] = True\n\n\ndef _paint_source_square(grid, used, top, left, size, color):\n    cells = [(r, c) for r in range(top, top + size) for c in range(left, left + size)]\n    if not _all_clear(grid, used, cells):\n        return None\n    _draw_cells(grid, used, cells, color)\n    return cells\n\n\ndef _paint_wall_segment(grid, used, fixed_row, start, length, orientation, color):\n    if orientation == 'h':\n        if start < 0 or start + length > grid.shape[1] or fixed_row < 0 or fixed_row >= grid.shape[0]:\n            return None\n        cells = [(fixed_row, start + i) for i in range(length)]\n    else:\n        if start < 0 or start + length > grid.shape[0] or fixed_row < 0 or fixed_row >= grid.shape[1]:\n            return None\n        cells = [(start + i, fixed_row) for i in range(length)]\n\n    if not _all_clear(grid, used, cells):\n        return None\n    _draw_cells(grid, used, cells, color)\n    return cells\n\n\ndef _paint_arrow(grid, used, anchor_r, anchor_c, shape, color=ARROW_COLOR):\n    cells = [(anchor_r + dr, anchor_c + dc) for dr, dc in shape]\n    if not _all_clear(grid, used, cells):\n        return None\n    _draw_cells(grid, used, cells, color)\n    return cells\n\n\ndef _scale_from_distance(rng: np.random.Generator, distance):\n    if distance <= 2:\n        return 1\n    if distance <= 4:\n        return 2\n    return 3\n\n\ndef generate_input() -> np.ndarray:\n    \\\"\\\"\\\"Randomly sample valid wall-arrow-pattern instances with varied scale-distance cases.\\\"\\\"\\\"\n    rng = np.random.default_rng()\n    directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n    palette = [1, 3, 4, 6, 7, 8, 9]\n\n    for _ in range(100):\n        h = int(rng.integers(14, 27))\n        w = int(rng.integers(14, 27))\n        grid = np.full((h, w), BACKGROUND, dtype=np.int64)\n        used = np.zeros((h, w), dtype=bool)\n\n        pair_count = int(rng.integers(1, 4))\n        placed = 0\n\n        for p in range(pair_count):\n            color = palette[p % len(palette)]\n            for _ in range(500):\n                dirv = directions[int(rng.integers(0, 4))]\n\n                branch = int(rng.integers(0, 3))\n                if branch == 0:\n                    dist = int(rng.integers(0, 3))\n                elif branch == 1:\n                    dist = int(rng.integers(3, 5))\n                else:\n                    dist = int(rng.integers(5, 8))\n\n                scale = _scale_from_distance(rng, dist)\n                size = int(rng.choice([2, 3]))\n                src_cells = []\n                wall_cells = []\n                arrow_cells = []\n\n                if dirv == (0, 1):  # source left, wall right, arrow left\n                    tgt_w = size * scale\n                    # horizontal row with arrow height 3\n                    if h < 3 or w < (size + 1 + dist + 1 + tgt_w + 2):\n                        continue\n\n                    src_top = int(rng.integers(0, h - 2))\n                    # ensure arrow and source fit\n                    if src_top > h - 3:\n                        continue\n                    src_left = int(rng.integers(2, w - (size + dist + 1 + tgt_w + 1)))\n\n                    wall_col = src_left + size + dist\n                    wall_row = src_top\n                    wall_len = size\n\n                    wall_cells = _paint_wall_segment(\n                        grid,\n                        used,\n                        wall_col,\n                        wall_row,\n                        wall_len,\n                        'v',\n                        WALL_COLOR,\n                    )\n                    if wall_cells is None:\n                        continue\n\n                    src_cells = _paint_source_square(\n                        grid,\n                        used,\n                        src_top,\n                        src_left,\n                        size,\n                        color,\n                    )\n                    if src_cells is None:\n                        continue\n\n                    arrow_cells = _paint_arrow(\n                        grid,\n                        used,\n                        src_top,\n                        src_left - 2,\n                        ARROW_TEMPLATES[(0, 1)],\n                        ARROW_COLOR,\n                    )\n                    if arrow_cells is None:\n                        continue\n\n                    # guard projection would stay in grid\n                    center_r = (src_top + src_top + size - 1) / 2\n                    dest_r = int(round(center_r - (size * scale - 1) / 2))\n                    dest_c = wall_col + 1\n                    if dest_r < 0 or dest_r + size * scale > h or dest_c + tgt_w > w:\n                        # rollback\n                        for rr, cc in wall_cells + src_cells + arrow_cells:\n                            grid[rr, cc] = BACKGROUND\n                            used[rr, cc] = False\n                        continue\n\n                elif dirv == (0, -1):  # source right, wall left, arrow right\n                    tgt_w = size * scale\n                    if h < 3 or w < (size + 1 + dist + 1 + tgt_w + 2):\n                        continue\n\n                    src_top = int(rng.integers(0, h - 2))\n                    if src_top > h - 3:\n                        continue\n                    src_left = int(rng.integers(0, w - size))\n                    if src_left + size + 2 + dist + 1 + tgt_w >= w:\n                        continue\n\n                    wall_col = src_left - dist - 1\n                    if wall_col < 0:\n                        continue\n                    wall_row = src_top\n                    wall_len = size\n\n                    wall_cells = _paint_wall_segment(\n                        grid,\n                        used,\n                        wall_col,\n                        wall_row,\n                        wall_len,\n                        'v',\n                        WALL_COLOR,\n                    )\n                    if wall_cells is None:\n                        continue\n\n                    src_cells = _paint_source_square(\n                        grid,\n                        used,\n                        src_top,\n                        src_left,\n                        size,\n                        color,\n                    )\n                    if src_cells is None:\n                        continue\n\n                    arrow_cells = _paint_arrow(\n                        grid,\n                        used,\n                        src_top,\n                        src_left + size,\n                        ARROW_TEMPLATES[(0, -1)],\n                        ARROW_COLOR,\n                    )\n                    if arrow_cells is None:\n                        continue\n\n                    center_r = (src_top + src_top + size - 1) / 2\n                    dest_r = int(round(center_r - (size * scale - 1) / 2))\n                    dest_c = wall_col - tgt_w\n                    if dest_r < 0 or dest_r + size * scale > h or dest_c < 0:\n                        for rr, cc in wall_cells + src_cells + arrow_cells:\n                            grid[rr, cc] = BACKGROUND\n                            used[rr, cc] = False\n                        continue\n\n                elif dirv == (1, 0):  # source up, wall down, arrow up\n                    tgt_h = size * scale\n                    if w < 3 or h < (size + 1 + dist + 1 + tgt_h + 1):\n                        continue\n\n                    src_left = int(rng.integers(0, w - 2))\n                    if src_left > w - 3:\n                        continue\n                    src_top = int(rng.integers(1, h - size))\n\n                    wall_row = src_top + size + dist\n                    if wall_row >= h:\n                        continue\n                    wall_col = src_left\n                    wall_len = size\n\n                    wall_cells = _paint_wall_segment(\n                        grid,\n                        used,\n                        wall_row,\n                        wall_col,\n                        wall_len,\n                        'h',\n                        WALL_COLOR,\n                    )\n                    if wall_cells is None:\n                        continue\n\n                    src_cells = _paint_source_square(\n                        grid,\n                        used,\n                        src_top,\n                        src_left,\n                        size,\n                        color,\n                    )\n                    if src_cells is None:\n                        continue\n\n                    arrow_cells = _paint_arrow(\n                        grid,\n                        used,\n                        src_top - 1,\n                        src_left,\n                        ARROW_TEMPLATES[(1, 0)],\n                        ARROW_COLOR,\n                    )\n                    if arrow_cells is None:\n                        continue\n\n                    center_c = (src_left + src_left + size - 1) / 2\n                    dest_r = wall_row + 1\n                    dest_c = int(round(center_c - (size * scale - 1) / 2))\n                    if dest_c < 0 or dest_c + size * scale > w or dest_r + tgt_h > h:\n                        for rr, cc in wall_cells + src_cells + arrow_cells:\n                            grid[rr, cc] = BACKGROUND\n                            used[rr, cc] = False\n                        continue\n\n                else:  # dirv == (-1, 0), source down, wall up, arrow down\n                    tgt_h = size * scale\n                    if w < 3 or h < (size + 1 + dist + 1 + tgt_h + 1):\n                        continue\n\n                    src_left = int(rng.integers(0, w - 2))\n                    if src_left > w - 3:\n                        continue\n                    src_top = int(rng.integers(0, h - size - 1))\n                    if src_top <= dist:\n                        continue\n\n                    wall_row = src_top - dist - 1\n                    if wall_row < 0:\n                        continue\n                    wall_col = src_left\n                    wall_len = size\n\n                    wall_cells = _paint_wall_segment(\n                        grid,\n                        used,\n                        wall_row,\n                        wall_col,\n                        wall_len,\n                        'h',\n                        WALL_COLOR,\n                    )\n                    if wall_cells is None:\n                        continue\n\n                    src_cells = _paint_source_square(\n                        grid,\n                        used,\n                        src_top,\n                        src_left,\n                        size,\n                        color,\n                    )\n                    if src_cells is None:\n                        continue\n\n                    arrow_cells = _paint_arrow(\n                        grid,\n                        used,\n                        src_top + size - 1,\n                        src_left,\n                        ARROW_TEMPLATES[(-1, 0)],\n                        ARROW_COLOR,\n                    )\n                    if arrow_cells is None:\n                        continue\n\n                    center_c = (src_left + src_left + size - 1) / 2\n                    dest_r = wall_row - tgt_h\n                    dest_c = int(round(center_c - (size * scale - 1) / 2))\n                    if dest_r < 0 or dest_c < 0 or dest_c + size * scale > w:\n                        for rr, cc in wall_cells + src_cells + arrow_cells:\n                            grid[rr, cc] = BACKGROUND\n                            used[rr, cc] = False\n                        continue\n\n                # pair successfully placed\n                placed += 1\n                break\n\n        if placed >= 1:\n            return grid\n\n    # fallback\n    return np.full((20, 20), BACKGROUND, dtype=np.int64)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"cat > /home/lixinyu/snap/a/des/code/eval_new/seed558458950/1/6.py <<'PY'\nimport numpy as np\nfrom collections import Counter, deque\n\n\nBACKGROUND = 0\nWALL_COLOR = 5\nARROW_COLOR = 2\n\nDIRS_4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\nDIRS_8 = DIRS_4 + [(1, 1), (1, -1), (-1, 1), (-1, -1)]\n\nARROW_TEMPLATES = {\n    (0, 1): frozenset([(0, 0), (1, 1), (2, 0)]),  # >\n    (0, -1): frozenset([(0, 1), (1, 0), (2, 1)]),  # <\n    (1, 0): frozenset([(0, 0), (0, 2), (1, 1)]),  # v\n    (-1, 0): frozenset([(1, 0), (1, 2), (0, 1)]),  # \"'^\n}\n\n\ndef _components(grid: np.ndarray, color: int, dirs=DIRS_4):\n    h, w = grid.shape\n    visited = np.zeros_like(grid, dtype=bool)\n    comps = []\n    for rr in range(h):\n        for cc in range(w):\n            if visited[rr, cc] or grid[rr, cc] != color:\n                continue\n            q = deque([(rr, cc)])\n            visited[rr, cc] = True\n            comp = []\n            while q:\n                r, c = q.popleft()\n                comp.append((r, c))\n                for dr, dc in dirs:\n                    nr = r + dr\n                    nc = c + dc\n                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and grid[nr, nc] == color:\n                        visited[nr, nc] = True\n                        q.append((nr, nc))\n            comps.append(comp)\n    return comps\n\n\ndef _bbox(cells):\n    rs = [r for r, _ in cells]\n    cs = [c for _, c in cells]\n    min_r, max_r = min(rs), max(rs)\n    min_c, max_c = min(cs), max(cs)\n    return min_r, max_r, min_c, max_c\n\n\ndef _norm_shape(cells):\n    min_r, max_r, min_c, max_c = _bbox(cells)\n    return frozenset((r - min_r, c - min_c) for r, c in cells)\n\n\ndef _is_solid_square(cells):\n    min_r, max_r, min_c, max_c = _bbox(cells)\n    h = max_r - min_r + 1\n    w = max_c - min_c + 1\n    if h not in (2, 3) or w not in (2, 3) or h != w:\n        return False, None\n    area = h * w\n    if len(cells) != area:\n        return False, None\n    return True, h\n\n\ndef _is_straight_line(cells):\n    min_r, max_r, min_c, max_c = _bbox(cells)\n    h = max_r - min_r + 1\n    w = max_c - min_c + 1\n    if len(cells) == 1:\n        return False, None\n    if h == 1 and w == len(cells):\n        return True, '\"'h'\n    if w == 1 and h == len(cells):\n        return True, 'v'\n    return False, None\n\n\ndef _get_background(grid: np.ndarray):\n    flat = grid.reshape(-1)\n    counts = Counter(flat.tolist())\n    return counts.most_common(1)[0][0]\n\n\ndef _find_arrow_components(grid, bg_color):\n    h, w = grid.shape\n    arrows = []\n    for color in np.unique(grid):\n        if color == bg_color:\n            continue\n        comps = _components(grid, int(color), dirs=DIRS_8)\n        for comp in comps:\n            if len(comp) \"'!= 3:\n                continue\n            shape = _norm_shape(comp)\n            for d, template in ARROW_TEMPLATES.items():\n                if shape == template:\n                    arrows.append(\n                        {\n                            '\"'color': int(color),\n                            'dir': d,\n                            'cells': comp,\n                            'bbox': _bbox(comp),\n                        }\n                    )\n                    break\n    return arrows\n\n\ndef _find_wall_color(grid, bg_color):\n    best_color = None\n    best_components = []\n    best_len = 0\n\n    for color in np.unique(grid):\n        color = int(color)\n        if color == bg_color:\n            continue\n        total_len = 0\n        line_cells = []\n        for comp in _components(grid, color, dirs=DIRS_4):\n            ok, orient = _is_straight_line(comp)\n            if ok and len(comp) >= 2:\n                total_len += len(comp)\n                line_cells.extend(comp)\n        if total_len > best_len:\n            best_len = total_len\n            best_color = color\n            best_components = line_cells\n    if best_color is None:\n        return None, set()\n    return best_color, set(best_components)\n\n\ndef _measure_to_wall(grid, source, dirv, wall_cells, bg):\n    min_r, max_r, min_c, max_c = source['bbox']\n    h, w = grid.shape\n    dr, dc = dirv\n    hits = []\n\n    if (dr, dc) == (0, 1):\n        for rr in range(min_r, max_r + 1):\n            c = max_c + 1\n            d = 0\n            while 0 <= c < w and grid[rr, c] == bg:\n                d += 1\n                c += 1\n            if 0 <= c < w and (rr, c) in wall_cells:\n                hits.append((d, rr, c))\n    elif (dr, dc) == (0, -1):\n        for rr in range(min_r, max_r + 1):\n            c = min_c - 1\n            d = 0\n            while 0 <= c < w and grid[rr, c] == bg:\n                d += 1\n                c -= 1\n            if 0 <= c < w and (rr, c) in wall_cells:\n                hits.append((d, rr, c))\n    elif (dr, dc) == (1, 0):\n        for cc in range(min_c, max_c + 1):\n            r = max_r + 1\n            d = 0\n            while 0 <= r < h and grid[r, cc] == bg:\n                d += 1\n                r += 1\n            if 0 <= r < h and (r, cc) in wall_cells:\n                hits.append((d, r, cc))\n    else:\n        for cc in range(min_c, max_c + 1):\n            r = min_r - 1\n            d = 0\n            while 0 <= r < h and grid[r, cc] == bg:\n                d += 1\n                r -= 1\n            if 0 <= r < h and (r, cc) in wall_cells:\n                hits.append((d, r, cc))\n\n    if not hits:\n        return None\n    best = min(x[0] for x in hits)\n    near_hits = [(r, c) for d, r, c in hits if d == best]\n    return {\n        'dist': best,\n        'hits': near_hits,\n    }\n\n\ndef _arrow_matches_source(source, arrow, dirv):\n    src_min_r, src_max_r, src_min_c, src_max_c = source['bbox']\n    a_min_r, a_max_r, a_min_c, a_max_c = arrow['bbox']\n    gap_r1 = src_min_r - a_max_r\n    gap_r2 = a_min_r - src_max_r\n    gap_c1 = src_min_c - a_max_c\n    gap_c2 = a_min_c - src_max_c\n\n    if dirv == (0, 1):\n        if arrow['dir'] \"'!= dirv:\n            return False\n        if gap_c1 not in (1, 2):\n            return False\n        if a_max_r < src_min_r or a_min_r > src_max_r:\n            return False\n        return True\n\n    if dirv == (0, -1):\n        if arrow['\"'dir'] \"'!= dirv:\n            return False\n        if gap_c2 not in (1, 2):\n            return False\n        if a_max_r < src_min_r or a_min_r > src_max_r:\n            return False\n        return True\n\n    if dirv == (1, 0):\n        if arrow['\"'dir'] \"'!= dirv:\n            return False\n        if gap_r2 not in (1, 2):\n            return False\n        if a_max_c < src_min_c or a_min_c > src_max_c:\n            return False\n        return True\n\n    if dirv == (-1, 0):\n        if arrow['\"'dir'] \"'!= dirv:\n            return False\n        if gap_r1 not in (1, 2):\n            return False\n        if a_max_c < src_min_c or a_min_c > src_max_c:\n            return False\n        return True\n\n    return False\n\n\ndef _paint_scaled_projection(out, source, dirv, dist_info, scale):\n    h, w = out.shape\n    min_r, max_r, min_c, max_c = source['\"'bbox']\n    src_h = max_r - min_r + 1\n    src_w = max_c - min_c + 1\n    color = source['color']\n\n    tgt_h = src_h * scale\n    tgt_w = src_w * scale\n\n    if not dist_info['hits']:\n        return\n    # choose one anchored wall pixel\n    wall_r, wall_c = dist_info['hits'][0]\n\n    if dirv == (0, 1):\n        dst_c = wall_c + 1\n        dst_r = int(round((min_r + max_r) / 2 - (tgt_h - 1) / 2))\n    elif dirv == (0, -1):\n        dst_c = wall_c - tgt_w\n        dst_r = int(round((min_r + max_r) / 2 - (tgt_h - 1) / 2))\n    elif dirv == (1, 0):\n        dst_r = wall_r + 1\n        dst_c = int(round((min_c + max_c) / 2 - (tgt_w - 1) / 2))\n    else:\n        dst_r = wall_r - tgt_h\n        dst_c = int(round((min_c + max_c) / 2 - (tgt_w - 1) / 2))\n\n    if dst_r < 0 or dst_c < 0 or dst_r + tgt_h > h or dst_c + tgt_w > w:\n        return\n\n    for rr in range(min_r, max_r + 1):\n        for cc in range(min_c, max_c + 1):\n            sr = (rr - min_r) * scale\n            sc = (cc - min_c) * scale\n            for dr in range(scale):\n                for dc in range(scale):\n                    out[dst_r + sr + dr, dst_c + sc + dc] = color\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \\\"\\\"\\\"Project source patches across walls according to arrow direction and gap distance.\n\nInput structure:\n- Background is black and dominant.\n- One or more gray straight horizontal/vertical wall line segments are present.\n- Small 2x2 or 3x3 monochrome source patches sit on one side of a wall.\n- A red 3-pixel triangular arrow is adjacent to each source patch, on the side opposite the wall, and points toward the wall.\n\nRule:\nFind each valid source patch, identify its arrow direction, then measure D as the number of background cells from its nearest edge to the first gray wall cell in that direction. If D<=2, draw a 1x copy; if D is 3 or 4 draw a 2x copy; if D>=5 draw a 3x copy. Paint the scaled copy on the wall’s opposite side (through the wall), touching the wall and centered in the perpendicular axis. Keep source patches, arrows and wall pixels unchanged.\n\nKey insight:\nDirection comes from the red marker, while scale is determined by the measured free-space distance, and the copy is positioned by wall-touching placement with perpendicular centering.\\\"\\\"\\\"\n\n    grid = np.array(grid, dtype=np.int64)\n    h, w = grid.shape\n    out = grid.copy()\n\n    bg = _get_background(grid)\n    arrows = _find_arrow_components(grid, bg)\n    if not arrows:\n        return out\n\n    wall_color, wall_cells = _find_wall_color(grid, bg)\n    if wall_color is None:\n        return out\n\n    # source candidates are solid 2x2 or 3x3 monochrome blocks.\n    sources = []\n    for color in np.unique(grid):\n        color = int(color)\n        if color in (bg, wall_color, ARROW_COLOR):\n            continue\n        for comp in _components(grid, color, dirs=DIRS_4):\n            ok, sz = _is_solid_square(comp)\n            if ok:\n                sources.append({'color': color, 'cells': comp, 'bbox': _bbox(comp), 'size': sz})\n\n    for source in sources:\n        best = []\n        for dirv in ((0, 1), (0, -1), (1, 0), (-1, 0)):\n            arrows_dir = [a for a in arrows if a['dir'] == dirv]\n            if not arrows_dir:\n                continue\n            if not any(_arrow_matches_source(source, a, dirv) for a in arrows_dir):\n                continue\n            dist = _measure_to_wall(grid, source, dirv, wall_cells, bg)\n            if dist is None:\n                continue\n            best.append((dist['dist'], dirv, dist))\n\n        if not best:\n            continue\n\n        # choose the nearest match for this source\n        best.sort(key=lambda x: x[0])\n        dist, dirv, dist_info = best[0]\n        if dist <= 2:\n            scale = 1\n        elif dist <= 4:\n            scale = 2\n        else:\n            scale = 3\n        _paint_scaled_projection(out, source, dirv, dist_info, scale)\n\n    return out\n\n\ndef _all_clear(grid, used, cells):\n    h, w = grid.shape\n    for r, c in cells:\n        if not (0 <= r < h and 0 <= c < w):\n            return False\n        if used[r, c]:\n            return False\n    return True\n\n\ndef _draw_cells(grid, used, cells, color):\n    for r, c in cells:\n        grid[r, c] = color\n        used[r, c] = True\n\n\ndef _paint_source_square(grid, used, top, left, size, color):\n    cells = [(r, c) for r in range(top, top + size) for c in range(left, left + size)]\n    if not _all_clear(grid, used, cells):\n        return None\n    _draw_cells(grid, used, cells, color)\n    return cells\n\n\ndef _paint_wall_segment(grid, used, fixed_row, start, length, orientation, color):\n    if orientation == 'h':\n        if start < 0 or start + length > grid.shape[1] or fixed_row < 0 or fixed_row >= grid.shape[0]:\n            return None\n        cells = [(fixed_row, start + i) for i in range(length)]\n    else:\n        if start < 0 or start + length > grid.shape[0] or fixed_row < 0 or fixed_row >= grid.shape[1]:\n            return None\n        cells = [(start + i, fixed_row) for i in range(length)]\n\n    if not _all_clear(grid, used, cells):\n        return None\n    _draw_cells(grid, used, cells, color)\n    return cells\n\n\ndef _paint_arrow(grid, used, anchor_r, anchor_c, shape, color=ARROW_COLOR):\n    cells = [(anchor_r + dr, anchor_c + dc) for dr, dc in shape]\n    if not _all_clear(grid, used, cells):\n        return None\n    _draw_cells(grid, used, cells, color)\n    return cells\n\n\ndef _scale_from_distance(rng: np.random.Generator, distance):\n    if distance <= 2:\n        return 1\n    if distance <= 4:\n        return 2\n    return 3\n\n\ndef generate_input() -> np.ndarray:\n    \\\"\\\"\\\"Randomly sample valid wall-arrow-pattern instances with varied scale-distance cases.\\\"\\\"\\\"\n    rng = np.random.default_rng()\n    directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n    palette = [1, 3, 4, 6, 7, 8, 9]\n\n    for _ in range(100):\n        h = int(rng.integers(14, 27))\n        w = int(rng.integers(14, 27))\n        grid = np.full((h, w), BACKGROUND, dtype=np.int64)\n        used = np.zeros((h, w), dtype=bool)\n\n        pair_count = int(rng.integers(1, 4))\n        placed = 0\n\n        for p in range(pair_count):\n            color = palette[p % len(palette)]\n            for _ in range(500):\n                dirv = directions[int(rng.integers(0, 4))]\n\n                branch = int(rng.integers(0, 3))\n                if branch == 0:\n                    dist = int(rng.integers(0, 3))\n                elif branch == 1:\n                    dist = int(rng.integers(3, 5))\n                else:\n                    dist = int(rng.integers(5, 8))\n\n                scale = _scale_from_distance(rng, dist)\n                size = int(rng.choice([2, 3]))\n                src_cells = []\n                wall_cells = []\n                arrow_cells = []\n\n                if dirv == (0, 1):  # source left, wall right, arrow left\n                    tgt_w = size * scale\n                    # horizontal row with arrow height 3\n                    if h < 3 or w < (size + 1 + dist + 1 + tgt_w + 2):\n                        continue\n\n                    src_top = int(rng.integers(0, h - 2))\n                    # ensure arrow and source fit\n                    if src_top > h - 3:\n                        continue\n                    src_left = int(rng.integers(2, w - (size + dist + 1 + tgt_w + 1)))\n\n                    wall_col = src_left + size + dist\n                    wall_row = src_top\n                    wall_len = size\n\n                    wall_cells = _paint_wall_segment(\n                        grid,\n                        used,\n                        wall_col,\n                        wall_row,\n                        wall_len,\n                        'v',\n                        WALL_COLOR,\n                    )\n                    if wall_cells is None:\n                        continue\n\n                    src_cells = _paint_source_square(\n                        grid,\n                        used,\n                        src_top,\n                        src_left,\n                        size,\n                        color,\n                    )\n                    if src_cells is None:\n                        continue\n\n                    arrow_cells = _paint_arrow(\n                        grid,\n                        used,\n                        src_top,\n                        src_left - 2,\n                        ARROW_TEMPLATES[(0, 1)],\n                        ARROW_COLOR,\n                    )\n                    if arrow_cells is None:\n                        continue\n\n                    # guard projection would stay in grid\n                    center_r = (src_top + src_top + size - 1) / 2\n                    dest_r = int(round(center_r - (size * scale - 1) / 2))\n                    dest_c = wall_col + 1\n                    if dest_r < 0 or dest_r + size * scale > h or dest_c + tgt_w > w:\n                        # rollback\n                        for rr, cc in wall_cells + src_cells + arrow_cells:\n                            grid[rr, cc] = BACKGROUND\n                            used[rr, cc] = False\n                        continue\n\n                elif dirv == (0, -1):  # source right, wall left, arrow right\n                    tgt_w = size * scale\n                    if h < 3 or w < (size + 1 + dist + 1 + tgt_w + 2):\n                        continue\n\n                    src_top = int(rng.integers(0, h - 2))\n                    if src_top > h - 3:\n                        continue\n                    src_left = int(rng.integers(0, w - size))\n                    if src_left + size + 2 + dist + 1 + tgt_w >= w:\n                        continue\n\n                    wall_col = src_left - dist - 1\n                    if wall_col < 0:\n                        continue\n                    wall_row = src_top\n                    wall_len = size\n\n                    wall_cells = _paint_wall_segment(\n                        grid,\n                        used,\n                        wall_col,\n                        wall_row,\n                        wall_len,\n                        'v',\n                        WALL_COLOR,\n                    )\n                    if wall_cells is None:\n                        continue\n\n                    src_cells = _paint_source_square(\n                        grid,\n                        used,\n                        src_top,\n                        src_left,\n                        size,\n                        color,\n                    )\n                    if src_cells is None:\n                        continue\n\n                    arrow_cells = _paint_arrow(\n                        grid,\n                        used,\n                        src_top,\n                        src_left + size,\n                        ARROW_TEMPLATES[(0, -1)],\n                        ARROW_COLOR,\n                    )\n                    if arrow_cells is None:\n                        continue\n\n                    center_r = (src_top + src_top + size - 1) / 2\n                    dest_r = int(round(center_r - (size * scale - 1) / 2))\n                    dest_c = wall_col - tgt_w\n                    if dest_r < 0 or dest_r + size * scale > h or dest_c < 0:\n                        for rr, cc in wall_cells + src_cells + arrow_cells:\n                            grid[rr, cc] = BACKGROUND\n                            used[rr, cc] = False\n                        continue\n\n                elif dirv == (1, 0):  # source up, wall down, arrow up\n                    tgt_h = size * scale\n                    if w < 3 or h < (size + 1 + dist + 1 + tgt_h + 1):\n                        continue\n\n                    src_left = int(rng.integers(0, w - 2))\n                    if src_left > w - 3:\n                        continue\n                    src_top = int(rng.integers(1, h - size))\n\n                    wall_row = src_top + size + dist\n                    if wall_row >= h:\n                        continue\n                    wall_col = src_left\n                    wall_len = size\n\n                    wall_cells = _paint_wall_segment(\n                        grid,\n                        used,\n                        wall_row,\n                        wall_col,\n                        wall_len,\n                        'h',\n                        WALL_COLOR,\n                    )\n                    if wall_cells is None:\n                        continue\n\n                    src_cells = _paint_source_square(\n                        grid,\n                        used,\n                        src_top,\n                        src_left,\n                        size,\n                        color,\n                    )\n                    if src_cells is None:\n                        continue\n\n                    arrow_cells = _paint_arrow(\n                        grid,\n                        used,\n                        src_top - 1,\n                        src_left,\n                        ARROW_TEMPLATES[(1, 0)],\n                        ARROW_COLOR,\n                    )\n                    if arrow_cells is None:\n                        continue\n\n                    center_c = (src_left + src_left + size - 1) / 2\n                    dest_r = wall_row + 1\n                    dest_c = int(round(center_c - (size * scale - 1) / 2))\n                    if dest_c < 0 or dest_c + size * scale > w or dest_r + tgt_h > h:\n                        for rr, cc in wall_cells + src_cells + arrow_cells:\n                            grid[rr, cc] = BACKGROUND\n                            used[rr, cc] = False\n                        continue\n\n                else:  # dirv == (-1, 0), source down, wall up, arrow down\n                    tgt_h = size * scale\n                    if w < 3 or h < (size + 1 + dist + 1 + tgt_h + 1):\n                        continue\n\n                    src_left = int(rng.integers(0, w - 2))\n                    if src_left > w - 3:\n                        continue\n                    src_top = int(rng.integers(0, h - size - 1))\n                    if src_top <= dist:\n                        continue\n\n                    wall_row = src_top - dist - 1\n                    if wall_row < 0:\n                        continue\n                    wall_col = src_left\n                    wall_len = size\n\n                    wall_cells = _paint_wall_segment(\n                        grid,\n                        used,\n                        wall_row,\n                        wall_col,\n                        wall_len,\n                        'h',\n                        WALL_COLOR,\n                    )\n                    if wall_cells is None:\n                        continue\n\n                    src_cells = _paint_source_square(\n                        grid,\n                        used,\n                        src_top,\n                        src_left,\n                        size,\n                        color,\n                    )\n                    if src_cells is None:\n                        continue\n\n                    arrow_cells = _paint_arrow(\n                        grid,\n                        used,\n                        src_top + size - 1,\n                        src_left,\n                        ARROW_TEMPLATES[(-1, 0)],\n                        ARROW_COLOR,\n                    )\n                    if arrow_cells is None:\n                        continue\n\n                    center_c = (src_left + src_left + size - 1) / 2\n                    dest_r = wall_row - tgt_h\n                    dest_c = int(round(center_c - (size * scale - 1) / 2))\n                    if dest_r < 0 or dest_c < 0 or dest_c + size * scale > w:\n                        for rr, cc in wall_cells + src_cells + arrow_cells:\n                            grid[rr, cc] = BACKGROUND\n                            used[rr, cc] = False\n                        continue\n\n                # pair successfully placed\n                placed += 1\n                break\n\n        if placed >= 1:\n            return grid\n\n    # fallback\n    return np.full((20, 20), BACKGROUND, dtype=np.int64)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
