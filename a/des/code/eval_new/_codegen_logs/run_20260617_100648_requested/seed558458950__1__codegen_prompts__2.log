return (r, c + 1)\n\n\ndef _place_hole(grid, template_mask, shape, rng, side):\n    h, w = grid.shape\n    shape_set = set(shape)\n    top, bottom, left, right = _bounding_box(shape_set)\n    sh = bottom - top + 1\n    sw = right - left + 1\n\n    base_r_candidates = []\n    base_c_candidates = []\n    for r0 in range(h):\n        for c0 in range(w):\n            base_r_candidates.append(r0)\n            base_c_candidates.append(c0)\n\n    r_lim0, r_lim1 = int(np.min(np.where(template_mask)[0])) + 1, int(np.max(np.where(template_mask)[0])) - 1\n    c_lim0, c_lim1 = int(np.min(np.where(template_mask)[1])) + 1, int(np.max(np.where(template_mask)[1])) - 1\n\n    tries = 0\n    while tries < 250:\n        tries += 1\n        tx = int(rng.integers(r_lim0, max(r_lim0 + 1, r_lim1 - sh + 2)))\n        ty = int(rng.integers(c_lim0, max(c_lim0 + 1, c_lim1 - sw + 2)))\n        translated = set()\n        ok = True\n        for r, c in shape_set:\n            tr, tc = r - top + tx, c - left + ty\n            if not (0 <= tr < h and 0 <= tc < w):\n                ok = False\n                break\n            if not template_mask[tr, tc]:\n                ok = False\n                break\n            translated.add((tr, tc))\n        if not ok:\n            continue\n        anchor = _choose_anchor(shape_set, side)\n        if anchor is None:\n            continue\n        ar, ac = anchor\n        ar, ac = ar - top + tx, ac - left + ty\n\n        if not (0 <= ar < h and 0 <= ac < w):\n            continue\n        if not template_mask[ar, ac]:\n            continue\n        if grid[ar, ac] != 1:\n            continue\n        for tr, tc in translated:\n            if grid[tr, tc] != 1:\n                ok = False\n                break\n            grid[tr, tc] = 0\n        if not ok:\n            continue\n        grid[ar, ac] = 2\n        return translated\n    return None\n\n\ndef _place_piece(grid, available, shape, color, red):\n    h, w = grid.shape\n    shape_set = set(shape)\n    rs = [r for r, _ in shape_set]\n    cs = [c for _, c in shape_set]\n    sh = max(rs) - min(rs) + 1\n    sw = max(cs) - min(cs) + 1\n    side = random.randrange(4)\n\n    tries = 0\n    while tries < 400:\n        tries += 1\n        tx = int(np.random.default_rng().integers(0, h - sh + 1))\n        ty = int(np.random.default_rng().integers(0, w - sw + 1))\n        translated = {(r - min(rs) + tx, c - min(cs) + ty) for r, c in shape_set}\n        if any(not available[r, c] for r, c in translated):\n            continue\n        if any(grid[r, c] != 0 for r, c in translated):\n            continue\n\n        anchor = _choose_anchor(shape_set, side)\n        if anchor is None:\n            continue\n        ar, ac = anchor\n        ar, ac = ar - min(rs) + tx, ac - min(cs) + ty\n        if not (0 <= ar < h and 0 <= ac < w):\n            continue\n        if not available[ar, ac] or grid[ar, ac] != 0:\n            continue\n\n        for rr, cc in translated:\n            grid[rr, cc] = color\n        grid[ar, ac] = red\n        return translated\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n\n    for _ in range(300):\n        H = int(rng.integers(20, 31))\n        W = int(rng.integers(20, 31))\n\n        bg = 0\n        grey = 1\n        red = 2\n\n        t_h = int(rng.integers(10, H - 5))\n        t_w = int(rng.integers(10, W - 5))\n        if t_h < 8 or t_w < 8:\n            continue\n\n        top = int(rng.integers(2, max(3, H - t_h - 1)))\n        left = int(rng.integers(2, max(3, W - t_w - 1)))\n        bottom = top + t_h\n        right = left + t_w\n\n        if bottom >= H - 1 or right >= W - 1:\n            continue\n\n        grid = np.full((H, W), bg, dtype=np.int64)\n        template_mask = np.zeros((H, W), dtype=bool)\n        template_mask[top:bottom, left:right] = True\n\n        hole_count = int(rng.integers(2, 5))\n        hole_shapes = []\n        hole_cells = []\n\n        base_rotation_candidates = [(0, 1, 2, 3)]\n        for _ in range(hole_count):\n            placed = False\n            existing_rots = {tuple(sorted(c)) for shape in hole_shapes for c in _shape_rotations(shape)}\n\n            for _ in range(200):\n                size = int(rng.integers(5, 13))\n                shape = _random_shape(size, rng)\n                shape_norm = set(shape)\n                rots = {tuple(sorted(sig)) for sig in _shape_rotations(shape_norm)}\n                if rots & existing_rots:\n                    continue\n\n                side = random.randrange(4)\n                placed_cells = _place_hole(grid, template_mask.copy(), shape_norm, rng, side)\n                if placed_cells is None:\n                    continue\n\n                hole_shapes.append(shape_norm)\n                hole_cells.append(placed_cells)\n                placed = True\n                break\n\n            if not placed:\n                break\n\n        if len(hole_shapes) != hole_count:\n            continue\n\n        grid[template_mask] = grey\n\n        # keep template ring clear for anchor cells that will replace template interior with red\n        outside = np.ones((H, W), dtype=bool)\n        outside[max(0, top - 1):min(H, bottom + 2), max(0, left - 1):min(W, right + 2)] = False\n\n        colors = list(range(3, 3 + hole_count + 6))\n        random.shuffle(colors)\n        piece_colors = colors[:hole_count]\n\n        ok = True\n        for idx, hole_shape in enumerate(hole_shapes):\n            piece_rot = random.randrange(4)\n            rotated = {_rotate_coord(p, piece_rot) for p in hole_shape}\n            rot_shape = {_norm_shape(rotated)}  # one-item set for direct translation\n\n            # convert back to set coords\n            piece_cells = set(rotated)\n            placed = False\n            for _ in range(300):\n                # choose translation in available background outside template margin\n                pts = list(piece_cells)\n                rs = [r for r, _ in pts]\n                cs = [c for _, c in pts]\n                sh = max(rs) - min(rs) + 1\n                sw = max(cs) - min(cs) + 1\n                tx = int(rng.integers(0, H - sh + 1))\n                ty = int(rng.integers(0, W - sw + 1))\n                translated = {(r - min(rs) + tx, c - min(cs) + ty) for r, c in piece_cells}\n\n                if any(grid[r, c] != bg or not outside[r, c] for r, c in translated):\n                    continue\n\n                side = random.randrange(4)\n                anchor = _choose_anchor(piece_cells, side)\n                if anchor is None:\n                    continue\n                ar, ac = anchor\n                ar, ac = ar - min(rs) + tx, ac - min(cs) + ty\n\n                if not (0 <= ar < H and 0 <= ac < W):\n                    continue\n                if grid[ar, ac] != bg or not outside[ar, ac]:\n                    continue\n\n                for r, c in translated:\n                    grid[r, c] = piece_colors[idx]\n                grid[ar, ac] = red\n\n                # mark unavailable\n                for r, c in translated:\n                    outside[r, c] = False\n                outside[ar, ac] = False\n                placed = True\n                break\n\n            if not placed:\n                ok = False\n                break\n\n        if not ok:\n            continue\n\n        try:\n            out = main(grid)\n        except Exception:\n            continue\n\n        if out.shape != grid.shape:\n            continue\n\n        if out.ndim != 2 or max(out.shape) > 30:\n            continue\n\n        return grid\n\n    # fallback deterministic valid 20x20 sample\n    base = np.zeros((20, 20), dtype=np.int64)\n    base[4:16, 4:16] = 1\n    base[7:9, 9] = 0\n    base[9, 7:9] = 2\n    base[5, 8] = 2\n    base[12, 12] = 2\n    base[2:4, 2:6] = 3\n    base[1, 3] = 2\n    return base\n","exit_code":0,"status":"completed"}}
