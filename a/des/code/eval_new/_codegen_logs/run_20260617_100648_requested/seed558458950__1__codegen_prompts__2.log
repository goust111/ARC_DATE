te_mask[ar, ac] or grid[ar, ac] != grey:\n                        continue\n\n                    for r, c in cells:\n                        grid[r, c] = bg\n                    grid[ar, ac] = red\n                    hole_templates.append(shape)\n                    selected_rot_signatures.update(_shape_rotations(shape))\n                    placed = True\n                    break\n\n                if placed:\n                    break\n\n            if not placed:\n                break\n\n        if len(hole_templates) != hole_count:\n            continue\n\n        grid[template_mask] = grey\n        outside = np.ones((H, W), dtype=bool)\n        outside[max(0, top - 1):min(H, bottom + 2), max(0, left - 1):min(W, right + 2)] = False\n\n        color_pool = [c for c in range(3, 20)]\n        rng.shuffle(color_pool)\n        piece_colors = color_pool[:hole_count]\n\n        ok = True\n        for idx, shape in enumerate(hole_templates):\n            piece_color = piece_colors[idx]\n            rot = int(rng.integers(0, 4))\n            piece_shape = {_rotate_coord(p, rot) for p in shape}\n            min_r = min(r for r, _ in piece_shape)\n            min_c = min(c for _, c in piece_shape)\n            rs = [r - min_r for r, _ in piece_shape]\n            cs = [c - min_c for _, c in piece_shape]\n            norm_shape = {(r, c) for r, c in zip(rs, cs)}\n\n            side = int(rng.integers(0, 4))\n            anchor = _choose_anchor(norm_shape, side)\n            if anchor is None:\n                ok = False\n                break\n\n            candidates = []\n            h_s = max(r for r, _ in norm_shape)\n            w_s = max(c for _, c in norm_shape)\n            for tr in range(H - h_s):\n                for tc in range(W - w_s):\n                    cells = {(r + tr, c + tc) for r, c in norm_shape}\n                    if any(not outside[r, c] for r, c in cells):\n                        continue\n                    if any(grid[r, c] != bg for r, c in cells):\n                        continue\n                    ar = anchor[0] + tr\n                    ac = anchor[1] + tc\n                    if not (0 <= ar < H and 0 <= ac < W):\n                        continue\n                    if not outside[ar, ac] or grid[ar, ac] != bg:\n                        continue\n                    candidates.append((cells, (ar, ac)))\n\n            if not candidates:\n                ok = False\n                break\n\n            cells, (ar, ac) = random.choice(candidates)\n            for r, c in cells:\n                grid[r, c] = piece_color\n            grid[ar, ac] = red\n            for r, c in cells:\n                outside[r, c] = False\n            outside[ar, ac] = False\n\n        if not ok:\n            continue\n\n        try:\n            _ = main(grid)\n        except Exception:\n            continue\n\n        return grid\n\n    # deterministic fallback sample\n    g = np.full((22, 22), 0, dtype=np.int64)\n    g[4:18, 4:18] = 1\n    # two holes\n    g[8:11, 8] = 0\n    g[8, 9] = 2\n    g[11:13, 14:16] = 0\n    g[12, 16] = 2\n    # two fragments outside\n    g[2:5, 1:3] = 3\n    g[1, 2] = 2\n    g[2:5, 0:1] = 4\n    g[1, 0] = 2\n    return g\n","exit_code":0,"status":"completed"}}
