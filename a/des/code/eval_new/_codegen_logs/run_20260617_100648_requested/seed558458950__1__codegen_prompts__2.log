{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"cat > /home/lixinyu/snap/a/des/code/eval_new/seed558458950/1/2.py <<'PY'\nimport random\nfrom collections import deque\nimport numpy as np\n\n\ndef _most_common_color(grid: np.ndarray) -> int:\n    values, counts = np.unique(grid, return_counts=True)\n    return int(values[int(np.argmax(counts))])\n\n\ndef _connected_components(mask: np.ndarray):\n    h, w = mask.shape\n    visited = np.zeros((h, w), dtype=bool)\n    comps = []\n    for r0 in range(h):\n        for c0 in range(w):\n            if not mask[r0, c0] or visited[r0, c0]:\n                continue\n            q = deque([(r0, c0)])\n            visited[r0, c0] = True\n            comp = []\n            while q:\n                r, c = q.popleft()\n                comp.append((r, c))\n                if r > 0 and mask[r - 1, c] and not visited[r - 1, c]:\n                    visited[r - 1, c] = True\n                    q.append((r - 1, c))\n                if r + 1 < h and mask[r + 1, c] and not visited[r + 1, c]:\n                    visited[r + 1, c] = True\n                    q.append((r + 1, c))\n                if c > 0 and mask[r, c - 1] and not visited[r, c - 1]:\n                    visited[r, c - 1] = True\n                    q.append((r, c - 1))\n                if c + 1 < w and mask[r, c + 1] and not visited[r, c + 1]:\n                    visited[r, c + 1] = True\n                    q.append((r, c + 1))\n            comps.append(comp)\n    return comps\n\n\ndef _touches_border(cells, h, w):\n    return any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in cells)\n\n\ndef _norm_shape(cells):\n    arr = np.array(cells, dtype=int)\n    if len(arr) == 0:\n        return tuple()\n    r0, c0 = int(arr[:, 0].min()), int(arr[:, 1].min())\n    normed = [(int(r - r0), int(c - c0)) for r, c in arr]\n    return tuple(sorted(normed))\n\n\ndef _rotate_coord(coord, k):\n    r, c = coord\n    k %= 4\n    if k == 0:\n        return (r, c)\n    if k == 1:\n        return (c, -r)\n    if k == 2:\n        return (-r, -c)\n    return (-c, r)\n\n\ndef _shape_rotations(cells):\n    arr = list(cells)\n    rots = []\n    for k in range(4):\n        rots.append(_norm_shape(_rotate_coord(p, k) for p in arr))\n    return tuple(rots)\n\n\ndef _rotate_side(side, k):\n    # 0 top, 1 right, 2 bottom, 3 left\n    return (int(side) + int(k)) % 4\n\n\ndef _side_from_anchor(shape_set, anchor):\n    ar, ac = anchor\n    counts = [0, 0, 0, 0]\n    for r, c in shape_set:\n        if ar == r - 1 and ac == c:\n            counts[0] += 1\n        elif ar == r + 1 and ac == c:\n            counts[2] += 1\n        elif ar == r and ac == c - 1:\n            counts[1] += 1\n        elif ar == r and ac == c + 1:\n            counts[3] += 1\n    best = max(counts)\n    if best == 0:\n        return None\n    for idx in (0, 2, 3, 1):\n        if counts[idx] == best:\n            return idx\n    return None\n\n\ndef _infer_marker_color(grid, bg_color):\n    colors = [int(v) for v in np.unique(grid)]\n    candidates = []\n    h, w = grid.shape\n\n    for color in colors:\n        if color == bg_color:\n            continue\n        mask = grid == color\n        comps = _connected_components(mask)\n        if not comps:\n            continue\n        if any(len(c) \"'!= 1 for c in comps):\n            continue\n        if len(comps) < 2:\n            continue\n\n        marker_like = 0\n        for r, c in np.argwhere(mask):\n            r, c = int(r), int(c)\n            cnt = 0\n            if r > 0 and grid[r - 1, c] != color:\n                cnt += 1\n            if r + 1 < h and grid[r + 1, c] != color:\n                cnt += 1\n            if c > 0 and grid[r, c - 1] != color:\n                cnt += 1\n            if c + 1 < w and grid[r, c + 1] != color:\n                cnt += 1\n            if cnt >= 2:\n                marker_like += 1\n\n        if marker_like >= len(comps):\n            candidates.append((marker_like, len(comps), color))\n\n    if not candidates:\n        fallback = [c for c in colors if c != bg_color]\n        if not fallback:\n            return bg_color\n        return int(fallback[0])\n\n    candidates.sort(reverse=True)\n    return int(candidates[0][2])\n\n\ndef _find_template_color(grid, bg_color, red_color, enclosed_bg):\n    h, w = grid.shape\n    colors = [int(c) for c in np.unique(grid) if c not in (bg_color, red_color)]\n    scores = []\n\n    for color in colors:\n        comps = _connected_components(grid == color)\n        if not comps:\n            continue\n        main_comp = max(comps, key=len)\n        main_set = set(main_comp)\n        if len(main_comp) < 3:\n            continue\n\n        touches = 0\n        for hole in enclosed_bg:\n            hs = set(hole)\n            found = False\n            for r, c in main_set:\n                if found:\n                    break\n                if r > 0 and (r - 1, c) in hs:\n                    found = True\n                elif r + 1 < h and (r + 1, c) in hs:\n                    found = True\n                elif c > 0 and (r, c - 1) in hs:\n                    found = True\n                elif c + 1 < w and (r, c + 1) in hs:\n                    found = True\n            if found:\n                touches += 1\n\n        score = touches * 1000 + len(main_comp)\n        scores.append((score, len(main_comp), color))\n\n    if not scores:\n        vals = [int(v) for v in np.unique(grid)]\n        for v in vals:\n            if v not in (bg_color, red_color):\n                return v\n        return bg_color\n    scores.sort(reverse=True)\n    return int(scores[0][2])\n\n\ndef _collect_holes(grid, bg_color, red_color):\n    h, w = grid.shape\n    holes = []\n    enclosed = []\n    for comp in _connected_components(grid == bg_color):\n        if comp and not _touches_border(comp, h, w):\n            enclosed.append(comp)\n\n    for comp in enclosed:\n        shape_set = set(comp)\n        anchors = set()\n        for r, c in comp:\n            if r > 0 and grid[r - 1, c] == red_color:\n                anchors.add((r - 1, c))\n            if r + 1 < h and grid[r + 1, c] == red_color:\n                anchors.add((r + 1, c))\n            if c > 0 and grid[r, c - 1] == red_color:\n                anchors.add((r, c - 1))\n            if c + 1 < w and grid[r, c + 1] == red_color:\n                anchors.add((r, c + 1))\n        if not anchors:\n            continue\n        anchor = next(iter(anchors))\n        side = _side_from_anchor(shape_set, anchor)\n        if side is None:\n            continue\n        holes.append({\n            \"cells\": comp,\n            \"sig\": _norm_shape(comp),\n            \"side\": side,\n            \"anchor\": anchor,\n        })\n    return holes\n\n\ndef _collect_pieces(grid, bg_color, red_color, template_color):\n    pieces = []\n    h, w = grid.shape\n    for color in [int(v) for v in np.unique(grid) if v not in (bg_color, red_color, template_color)]:\n        for comp in _connected_components(grid == color):\n            if not comp:\n                continue\n            shape_set = set(comp)\n            anchors = set()\n            for r, c in comp:\n                if r > 0 and grid[r - 1, c] == red_color:\n                    anchors.add((r - 1, c))\n                if r + 1 < h and grid[r + 1, c] == red_color:\n                    anchors.add((r + 1, c))\n                if c > 0 and grid[r, c - 1] == red_color:\n                    anchors.add((r, c - 1))\n                if c + 1 < w and grid[r, c + 1] == red_color:\n                    anchors.add((r, c + 1))\n            if len(anchors) != 1:\n                continue\n            anchor = next(iter(anchors))\n            side = _side_from_anchor(shape_set, anchor)\n            if side is None:\n                continue\n            pieces.append(\n                {\n                    \"color\": color,\n                    \"cells\": comp,\n                    \"anchor\": anchor,\n                    \"side\": side,\n                    \"sig\": _norm_shape(comp),\n                    \"rots\": _shape_rotations(shape_set),\n                }\n            )\n    return pieces\n\n\ndef _find_assignment(holes, pieces):\n    if not holes or not pieces:\n        return {}\n\n    h_to_p = []\n    for hi, hole in enumerate(holes):\n        options = []\n        for pi, piece in enumerate(pieces):\n            for k, psig in enumerate(piece['\"'rots']):\n                if psig == hole['sig'] and _rotate_side(piece['side'], k) == hole['side']:\n                    options.append(pi)\n                    break\n        h_to_p.append((hi, options))\n\n    h_to_p.sort(key=lambda x: len(x[1]))\n    used = [False] * len(pieces)\n    match = {}\n\n    def dfs(pos):\n        if pos == len(h_to_p):\n            return True\n        hi, opts = h_to_p[pos]\n        if not opts:\n            return False\n        for pi in opts:\n            if used[pi]:\n                continue\n            used[pi] = True\n            match[hi] = pi\n            if dfs(pos + 1):\n                return True\n            used[pi] = False\n            match.pop(hi, None)\n        return False\n\n    if dfs(0):\n        return match\n    return {}\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \\\"\\\"\\\"Place scattered pieces into matching template holes after angle alignment via anchor side.\nInput structure:\n- bg is the dominant color.\n- A large grey template is placed on the grid; its interior has several closed bg holes.\n- Each hole has one red anchor pixel on a hole boundary at one of four sides.\n- Outside the template are scattered monochrome fragments; each fragment has one red anchor.\n- The fragment body (without red) matches a hole shape up to 0/90/180/270 rotation.\nRule:\n- Detect enclosed bg holes, their red anchor pixels, and red anchor side on each hole boundary.\n- Detect all candidate fragments by body shape and anchor side, and match each hole by shape under rotation.\n- Use anchor-side consistency to pick the proper orientation so fragment and hole anchor lie on the same relative side.\n- Fill each matched hole with the fragment color, keep the red anchor as red, and keep the template unchanged.\n- Remove the original fragment cells and fragment anchors from their old positions.\nKey insight:\n- Hole identity comes from shape matching, while the anchor-side relation removes rotational ambiguity.\n\\\"\\\"\\\"\n\n    if grid.ndim \"'!= 2:\n        return grid.copy()\n\n    h, w = grid.shape\n    out = np.array(grid, copy=True)\n    bg = _most_common_color(grid)\n    red = _infer_marker_color(grid, bg)\n\n    holes = _collect_holes(grid, bg, red)\n    if not holes:\n        return out\n\n    enclosed = [hcomp['\"'cells'] for hcomp in holes]\n    template = _find_template_color(grid, bg, red, enclosed)\n    pieces = _collect_pieces(grid, bg, red, template)\n    if not pieces:\n        return out\n\n    # remove fragment bodies and their old red anchors\n    for p in pieces:\n        for r, c in p['cells']:\n            out[r, c] = bg\n        ar, ac = p['anchor']\n        if out[ar, ac] == red:\n            out[ar, ac] = bg\n\n    assignment = _find_assignment(holes, pieces)\n\n    for hi, piece_idx in assignment.items():\n        hole = holes[hi]\n        piece = pieces[piece_idx]\n        color = piece['color']\n        for r, c in hole['cells']:\n            out[r, c] = color\n        ar, ac = hole['anchor']\n        out[ar, ac] = red\n\n    return out\n\n\n# -------------------- generator helpers --------------------\n\ndef _random_shape(size, rng):\n    cells = {(0, 0)}\n    frontier = [(0, 0)]\n    while len(cells) < size:\n        r, c = frontier[rng.integers(0, len(frontier))]\n        dr, dc = rng.choice([(1, 0), (-1, 0), (0, 1), (0, -1)])\n        nr, nc = int(r + dr), int(c + dc)\n        if (nr, nc) not in cells:\n            cells.add((nr, nc))\n            frontier.append((nr, nc))\n    return cells\n\n\ndef _bounding_box(cells):\n    arr = np.array(cells, dtype=int)\n    return int(arr[:, 0].min()), int(arr[:, 0].max()), int(arr[:, 1].min()), int(arr[:, 1].max())\n\n\ndef _shape_cells_to_set(shape, rot, tx, ty):\n    arr = set()\n    for r, c in shape:\n        rr, cc = _rotate_coord((r, c), rot)\n        arr.add((rr + tx, cc + ty))\n    r0 = min(r for r, _ in arr)\n    c0 = min(c for _, c in arr)\n    return {(r - r0, c - c0) for r, c in arr}, (r0, c0)\n\n\ndef _choose_anchor(shape, side):\n    rs = [r for r, _ in shape]\n    cs = [c for _, c in shape]\n    top = min(rs)\n    bottom = max(rs)\n    left = min(cs)\n    right = max(cs)\n\n    if side == 0:\n        cand = [(r, c) for r, c in shape if r == top]\n        if not cand:\n            return None\n        r, c = random.choice(cand)\n        return (r - 1, c)\n    if side == 2:\n        cand = [(r, c) for r, c in shape if r == bottom]\n        if not cand:\n            return None\n        r, c = random.choice(cand)\n        return (r + 1, c)\n    if side == 3:\n        cand = [(r, c) for r, c in shape if c == left]\n        if not cand:\n            return None\n        r, c = random.choice(cand)\n        return (r, c - 1)\n    cand = [(r, c) for r, c in shape if c == right]\n    if not cand:\n        return None\n    r, c = random.choice(cand)\n    return (r, c + 1)\n\n\ndef _place_hole(grid, template_mask, shape, rng, side):\n    h, w = grid.shape\n    shape_set = set(shape)\n    top, bottom, left, right = _bounding_box(shape_set)\n    sh = bottom - top + 1\n    sw = right - left + 1\n\n    base_r_candidates = []\n    base_c_candidates = []\n    for r0 in range(h):\n        for c0 in range(w):\n            base_r_candidates.append(r0)\n            base_c_candidates.append(c0)\n\n    r_lim0, r_lim1 = int(np.min(np.where(template_mask)[0])) + 1, int(np.max(np.where(template_mask)[0])) - 1\n    c_lim0, c_lim1 = int(np.min(np.where(template_mask)[1])) + 1, int(np.max(np.where(template_mask)[1])) - 1\n\n    tries = 0\n    while tries < 250:\n        tries += 1\n        tx = int(rng.integers(r_lim0, max(r_lim0 + 1, r_lim1 - sh + 2)))\n        ty = int(rng.integers(c_lim0, max(c_lim0 + 1, c_lim1 - sw + 2)))\n        translated = set()\n        ok = True\n        for r, c in shape_set:\n            tr, tc = r - top + tx, c - left + ty\n            if not (0 <= tr < h and 0 <= tc < w):\n                ok = False\n                break\n            if not template_mask[tr, tc]:\n                ok = False\n                break\n            translated.add((tr, tc))\n        if not ok:\n            continue\n        anchor = _choose_anchor(shape_set, side)\n        if anchor is None:\n            continue\n        ar, ac = anchor\n        ar, ac = ar - top + tx, ac - left + ty\n\n        if not (0 <= ar < h and 0 <= ac < w):\n            continue\n        if not template_mask[ar, ac]:\n            continue\n        if grid[ar, ac] \"'!= 1:\n            continue\n        for tr, tc in translated:\n            if grid[tr, tc] != 1:\n                ok = False\n                break\n            grid[tr, tc] = 0\n        if not ok:\n            continue\n        grid[ar, ac] = 2\n        return translated\n    return None\n\n\ndef _place_piece(grid, available, shape, color, red):\n    h, w = grid.shape\n    shape_set = set(shape)\n    rs = [r for r, _ in shape_set]\n    cs = [c for _, c in shape_set]\n    sh = max(rs) - min(rs) + 1\n    sw = max(cs) - min(cs) + 1\n    side = random.randrange(4)\n\n    tries = 0\n    while tries < 400:\n        tries += 1\n        tx = int(np.random.default_rng().integers(0, h - sh + 1))\n        ty = int(np.random.default_rng().integers(0, w - sw + 1))\n        translated = {(r - min(rs) + tx, c - min(cs) + ty) for r, c in shape_set}\n        if any(not available[r, c] for r, c in translated):\n            continue\n        if any(grid[r, c] != 0 for r, c in translated):\n            continue\n\n        anchor = _choose_anchor(shape_set, side)\n        if anchor is None:\n            continue\n        ar, ac = anchor\n        ar, ac = ar - min(rs) + tx, ac - min(cs) + ty\n        if not (0 <= ar < h and 0 <= ac < w):\n            continue\n        if not available[ar, ac] or grid[ar, ac] != 0:\n            continue\n\n        for rr, cc in translated:\n            grid[rr, cc] = color\n        grid[ar, ac] = red\n        return translated\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n\n    for _ in range(300):\n        H = int(rng.integers(20, 31))\n        W = int(rng.integers(20, 31))\n\n        bg = 0\n        grey = 1\n        red = 2\n\n        t_h = int(rng.integers(10, H - 5))\n        t_w = int(rng.integers(10, W - 5))\n        if t_h < 8 or t_w < 8:\n            continue\n\n        top = int(rng.integers(2, max(3, H - t_h - 1)))\n        left = int(rng.integers(2, max(3, W - t_w - 1)))\n        bottom = top + t_h\n        right = left + t_w\n\n        if bottom >= H - 1 or right >= W - 1:\n            continue\n\n        grid = np.full((H, W), bg, dtype=np.int64)\n        template_mask = np.zeros((H, W), dtype=bool)\n        template_mask[top:bottom, left:right] = True\n\n        hole_count = int(rng.integers(2, 5))\n        hole_shapes = []\n        hole_cells = []\n\n        base_rotation_candidates = [(0, 1, 2, 3)]\n        for _ in range(hole_count):\n            placed = False\n            existing_rots = {tuple(sorted(c)) for shape in hole_shapes for c in _shape_rotations(shape)}\n\n            for _ in range(200):\n                size = int(rng.integers(5, 13))\n                shape = _random_shape(size, rng)\n                shape_norm = set(shape)\n                rots = {tuple(sorted(sig)) for sig in _shape_rotations(shape_norm)}\n                if rots & existing_rots:\n                    continue\n\n                side = random.randrange(4)\n                placed_cells = _place_hole(grid, template_mask.copy(), shape_norm, rng, side)\n                if placed_cells is None:\n                    continue\n\n                hole_shapes.append(shape_norm)\n                hole_cells.append(placed_cells)\n                placed = True\n                break\n\n            if not placed:\n                break\n\n        if len(hole_shapes) != hole_count:\n            continue\n\n        grid[template_mask] = grey\n\n        # keep template ring clear for anchor cells that will replace template interior with red\n        outside = np.ones((H, W), dtype=bool)\n        outside[max(0, top - 1):min(H, bottom + 2), max(0, left - 1):min(W, right + 2)] = False\n\n        colors = list(range(3, 3 + hole_count + 6))\n        random.shuffle(colors)\n        piece_colors = colors[:hole_count]\n\n        ok = True\n        for idx, hole_shape in enumerate(hole_shapes):\n            piece_rot = random.randrange(4)\n            rotated = {_rotate_coord(p, piece_rot) for p in hole_shape}\n            rot_shape = {_norm_shape(rotated)}  # one-item set for direct translation\n\n            # convert back to set coords\n            piece_cells = set(rotated)\n            placed = False\n            for _ in range(300):\n                # choose translation in available background outside template margin\n                pts = list(piece_cells)\n                rs = [r for r, _ in pts]\n                cs = [c for _, c in pts]\n                sh = max(rs) - min(rs) + 1\n                sw = max(cs) - min(cs) + 1\n                tx = int(rng.integers(0, H - sh + 1))\n                ty = int(rng.integers(0, W - sw + 1))\n                translated = {(r - min(rs) + tx, c - min(cs) + ty) for r, c in piece_cells}\n\n                if any(grid[r, c] != bg or not outside[r, c] for r, c in translated):\n                    continue\n\n                side = random.randrange(4)\n                anchor = _choose_anchor(piece_cells, side)\n                if anchor is None:\n                    continue\n                ar, ac = anchor\n                ar, ac = ar - min(rs) + tx, ac - min(cs) + ty\n\n                if not (0 <= ar < H and 0 <= ac < W):\n                    continue\n                if grid[ar, ac] != bg or not outside[ar, ac]:\n                    continue\n\n                for r, c in translated:\n                    grid[r, c] = piece_colors[idx]\n                grid[ar, ac] = red\n\n                # mark unavailable\n                for r, c in translated:\n                    outside[r, c] = False\n                outside[ar, ac] = False\n                placed = True\n                break\n\n            if not placed:\n                ok = False\n                break\n\n        if not ok:\n            continue\n\n        try:\n            out = main(grid)\n        except Exception:\n            continue\n\n        if out.shape != grid.shape:\n            continue\n\n        if out.ndim != 2 or max(out.shape) > 30:\n            continue\n\n        return grid\n\n    # fallback deterministic valid 20x20 sample\n    base = np.zeros((20, 20), dtype=np.int64)\n    base[4:16, 4:16] = 1\n    base[7:9, 9] = 0\n    base[9, 7:9] = 2\n    base[5, 8] = 2\n    base[12, 12] = 2\n    base[2:4, 2:6] = 3\n    base[1, 3] = 2\n    return base\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"cat > /home/lixinyu/snap/a/des/code/eval_new/seed558458950/1/2.py <<'PY'\nimport random\nfrom collections import deque\nimport numpy as np\n\n\ndef _most_common_color(grid: np.ndarray) -> int:\n    values, counts = np.unique(grid, return_counts=True)\n    return int(values[int(np.argmax(counts))])\n\n\ndef _connected_components(mask: np.ndarray):\n    h, w = mask.shape\n    visited = np.zeros((h, w), dtype=bool)\n    comps = []\n    for r0 in range(h):\n        for c0 in range(w):\n            if not mask[r0, c0] or visited[r0, c0]:\n                continue\n            q = deque([(r0, c0)])\n            visited[r0, c0] = True\n            comp = []\n            while q:\n                r, c = q.popleft()\n                comp.append((r, c))\n                if r > 0 and mask[r - 1, c] and not visited[r - 1, c]:\n                    visited[r - 1, c] = True\n                    q.append((r - 1, c))\n                if r + 1 < h and mask[r + 1, c] and not visited[r + 1, c]:\n                    visited[r + 1, c] = True\n                    q.append((r + 1, c))\n                if c > 0 and mask[r, c - 1] and not visited[r, c - 1]:\n                    visited[r, c - 1] = True\n                    q.append((r, c - 1))\n                if c + 1 < w and mask[r, c + 1] and not visited[r, c + 1]:\n                    visited[r, c + 1] = True\n                    q.append((r, c + 1))\n            comps.append(comp)\n    return comps\n\n\ndef _touches_border(cells, h, w):\n    return any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in cells)\n\n\ndef _norm_shape(cells):\n    arr = np.array(cells, dtype=int)\n    if len(arr) == 0:\n        return tuple()\n    r0, c0 = int(arr[:, 0].min()), int(arr[:, 1].min())\n    normed = [(int(r - r0), int(c - c0)) for r, c in arr]\n    return tuple(sorted(normed))\n\n\ndef _rotate_coord(coord, k):\n    r, c = coord\n    k %= 4\n    if k == 0:\n        return (r, c)\n    if k == 1:\n        return (c, -r)\n    if k == 2:\n        return (-r, -c)\n    return (-c, r)\n\n\ndef _shape_rotations(cells):\n    arr = list(cells)\n    rots = []\n    for k in range(4):\n        rots.append(_norm_shape(_rotate_coord(p, k) for p in arr))\n    return tuple(rots)\n\n\ndef _rotate_side(side, k):\n    # 0 top, 1 right, 2 bottom, 3 left\n    return (int(side) + int(k)) % 4\n\n\ndef _side_from_anchor(shape_set, anchor):\n    ar, ac = anchor\n    counts = [0, 0, 0, 0]\n    for r, c in shape_set:\n        if ar == r - 1 and ac == c:\n            counts[0] += 1\n        elif ar == r + 1 and ac == c:\n            counts[2] += 1\n        elif ar == r and ac == c - 1:\n            counts[1] += 1\n        elif ar == r and ac == c + 1:\n            counts[3] += 1\n    best = max(counts)\n    if best == 0:\n        return None\n    for idx in (0, 2, 3, 1):\n        if counts[idx] == best:\n            return idx\n    return None\n\n\ndef _infer_marker_color(grid, bg_color):\n    colors = [int(v) for v in np.unique(grid)]\n    candidates = []\n    h, w = grid.shape\n\n    for color in colors:\n        if color == bg_color:\n            continue\n        mask = grid == color\n        comps = _connected_components(mask)\n        if not comps:\n            continue\n        if any(len(c) \"'!= 1 for c in comps):\n            continue\n        if len(comps) < 2:\n            continue\n\n        marker_like = 0\n        for r, c in np.argwhere(mask):\n            r, c = int(r), int(c)\n            cnt = 0\n            if r > 0 and grid[r - 1, c] != color:\n                cnt += 1\n            if r + 1 < h and grid[r + 1, c] != color:\n                cnt += 1\n            if c > 0 and grid[r, c - 1] != color:\n                cnt += 1\n            if c + 1 < w and grid[r, c + 1] != color:\n                cnt += 1\n            if cnt >= 2:\n                marker_like += 1\n\n        if marker_like >= len(comps):\n            candidates.append((marker_like, len(comps), color))\n\n    if not candidates:\n        fallback = [c for c in colors if c != bg_color]\n        if not fallback:\n            return bg_color\n        return int(fallback[0])\n\n    candidates.sort(reverse=True)\n    return int(candidates[0][2])\n\n\ndef _find_template_color(grid, bg_color, red_color, enclosed_bg):\n    h, w = grid.shape\n    colors = [int(c) for c in np.unique(grid) if c not in (bg_color, red_color)]\n    scores = []\n\n    for color in colors:\n        comps = _connected_components(grid == color)\n        if not comps:\n            continue\n        main_comp = max(comps, key=len)\n        main_set = set(main_comp)\n        if len(main_comp) < 3:\n            continue\n\n        touches = 0\n        for hole in enclosed_bg:\n            hs = set(hole)\n            found = False\n            for r, c in main_set:\n                if found:\n                    break\n                if r > 0 and (r - 1, c) in hs:\n                    found = True\n                elif r + 1 < h and (r + 1, c) in hs:\n                    found = True\n                elif c > 0 and (r, c - 1) in hs:\n                    found = True\n                elif c + 1 < w and (r, c + 1) in hs:\n                    found = True\n            if found:\n                touches += 1\n\n        score = touches * 1000 + len(main_comp)\n        scores.append((score, len(main_comp), color))\n\n    if not scores:\n        vals = [int(v) for v in np.unique(grid)]\n        for v in vals:\n            if v not in (bg_color, red_color):\n                return v\n        return bg_color\n    scores.sort(reverse=True)\n    return int(scores[0][2])\n\n\ndef _collect_holes(grid, bg_color, red_color):\n    h, w = grid.shape\n    holes = []\n    enclosed = []\n    for comp in _connected_components(grid == bg_color):\n        if comp and not _touches_border(comp, h, w):\n            enclosed.append(comp)\n\n    for comp in enclosed:\n        shape_set = set(comp)\n        anchors = set()\n        for r, c in comp:\n            if r > 0 and grid[r - 1, c] == red_color:\n                anchors.add((r - 1, c))\n            if r + 1 < h and grid[r + 1, c] == red_color:\n                anchors.add((r + 1, c))\n            if c > 0 and grid[r, c - 1] == red_color:\n                anchors.add((r, c - 1))\n            if c + 1 < w and grid[r, c + 1] == red_color:\n                anchors.add((r, c + 1))\n        if not anchors:\n            continue\n        anchor = next(iter(anchors))\n        side = _side_from_anchor(shape_set, anchor)\n        if side is None:\n            continue\n        holes.append({\n            \"cells\": comp,\n            \"sig\": _norm_shape(comp),\n            \"side\": side,\n            \"anchor\": anchor,\n        })\n    return holes\n\n\ndef _collect_pieces(grid, bg_color, red_color, template_color):\n    pieces = []\n    h, w = grid.shape\n    for color in [int(v) for v in np.unique(grid) if v not in (bg_color, red_color, template_color)]:\n        for comp in _connected_components(grid == color):\n            if not comp:\n                continue\n            shape_set = set(comp)\n            anchors = set()\n            for r, c in comp:\n                if r > 0 and grid[r - 1, c] == red_color:\n                    anchors.add((r - 1, c))\n                if r + 1 < h and grid[r + 1, c] == red_color:\n                    anchors.add((r + 1, c))\n                if c > 0 and grid[r, c - 1] == red_color:\n                    anchors.add((r, c - 1))\n                if c + 1 < w and grid[r, c + 1] == red_color:\n                    anchors.add((r, c + 1))\n            if len(anchors) != 1:\n                continue\n            anchor = next(iter(anchors))\n            side = _side_from_anchor(shape_set, anchor)\n            if side is None:\n                continue\n            pieces.append(\n                {\n                    \"color\": color,\n                    \"cells\": comp,\n                    \"anchor\": anchor,\n                    \"side\": side,\n                    \"sig\": _norm_shape(comp),\n                    \"rots\": _shape_rotations(shape_set),\n                }\n            )\n    return pieces\n\n\ndef _find_assignment(holes, pieces):\n    if not holes or not pieces:\n        return {}\n\n    h_to_p = []\n    for hi, hole in enumerate(holes):\n        options = []\n        for pi, piece in enumerate(pieces):\n            for k, psig in enumerate(piece['\"'rots']):\n                if psig == hole['sig'] and _rotate_side(piece['side'], k) == hole['side']:\n                    options.append(pi)\n                    break\n        h_to_p.append((hi, options))\n\n    h_to_p.sort(key=lambda x: len(x[1]))\n    used = [False] * len(pieces)\n    match = {}\n\n    def dfs(pos):\n        if pos == len(h_to_p):\n            return True\n        hi, opts = h_to_p[pos]\n        if not opts:\n            return False\n        for pi in opts:\n            if used[pi]:\n                continue\n            used[pi] = True\n            match[hi] = pi\n            if dfs(pos + 1):\n                return True\n            used[pi] = False\n            match.pop(hi, None)\n        return False\n\n    if dfs(0):\n        return match\n    return {}\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \\\"\\\"\\\"Place scattered pieces into matching template holes after angle alignment via anchor side.\nInput structure:\n- bg is the dominant color.\n- A large grey template is placed on the grid; its interior has several closed bg holes.\n- Each hole has one red anchor pixel on a hole boundary at one of four sides.\n- Outside the template are scattered monochrome fragments; each fragment has one red anchor.\n- The fragment body (without red) matches a hole shape up to 0/90/180/270 rotation.\nRule:\n- Detect enclosed bg holes, their red anchor pixels, and red anchor side on each hole boundary.\n- Detect all candidate fragments by body shape and anchor side, and match each hole by shape under rotation.\n- Use anchor-side consistency to pick the proper orientation so fragment and hole anchor lie on the same relative side.\n- Fill each matched hole with the fragment color, keep the red anchor as red, and keep the template unchanged.\n- Remove the original fragment cells and fragment anchors from their old positions.\nKey insight:\n- Hole identity comes from shape matching, while the anchor-side relation removes rotational ambiguity.\n\\\"\\\"\\\"\n\n    if grid.ndim \"'!= 2:\n        return grid.copy()\n\n    h, w = grid.shape\n    out = np.array(grid, copy=True)\n    bg = _most_common_color(grid)\n    red = _infer_marker_color(grid, bg)\n\n    holes = _collect_holes(grid, bg, red)\n    if not holes:\n        return out\n\n    enclosed = [hcomp['\"'cells'] for hcomp in holes]\n    template = _find_template_color(grid, bg, red, enclosed)\n    pieces = _collect_pieces(grid, bg, red, template)\n    if not pieces:\n        return out\n\n    # remove fragment bodies and their old red anchors\n    for p in pieces:\n        for r, c in p['cells']:\n            out[r, c] = bg\n        ar, ac = p['anchor']\n        if out[ar, ac] == red:\n            out[ar, ac] = bg\n\n    assignment = _find_assignment(holes, pieces)\n\n    for hi, piece_idx in assignment.items():\n        hole = holes[hi]\n        piece = pieces[piece_idx]\n        color = piece['color']\n        for r, c in hole['cells']:\n            out[r, c] = color\n        ar, ac = hole['anchor']\n        out[ar, ac] = red\n\n    return out\n\n\n# -------------------- generator helpers --------------------\n\ndef _random_shape(size, rng):\n    cells = {(0, 0)}\n    frontier = [(0, 0)]\n    while len(cells) < size:\n        r, c = frontier[rng.integers(0, len(frontier))]\n        dr, dc = rng.choice([(1, 0), (-1, 0), (0, 1), (0, -1)])\n        nr, nc = int(r + dr), int(c + dc)\n        if (nr, nc) not in cells:\n            cells.add((nr, nc))\n            frontier.append((nr, nc))\n    return cells\n\n\ndef _bounding_box(cells):\n    arr = np.array(cells, dtype=int)\n    return int(arr[:, 0].min()), int(arr[:, 0].max()), int(arr[:, 1].min()), int(arr[:, 1].max())\n\n\ndef _shape_cells_to_set(shape, rot, tx, ty):\n    arr = set()\n    for r, c in shape:\n        rr, cc = _rotate_coord((r, c), rot)\n        arr.add((rr + tx, cc + ty))\n    r0 = min(r for r, _ in arr)\n    c0 = min(c for _, c in arr)\n    return {(r - r0, c - c0) for r, c in arr}, (r0, c0)\n\n\ndef _choose_anchor(shape, side):\n    rs = [r for r, _ in shape]\n    cs = [c for _, c in shape]\n    top = min(rs)\n    bottom = max(rs)\n    left = min(cs)\n    right = max(cs)\n\n    if side == 0:\n        cand = [(r, c) for r, c in shape if r == top]\n        if not cand:\n            return None\n        r, c = random.choice(cand)\n        return (r - 1, c)\n    if side == 2:\n        cand = [(r, c) for r, c in shape if r == bottom]\n        if not cand:\n            return None\n        r, c = random.choice(cand)\n        return (r + 1, c)\n    if side == 3:\n        cand = [(r, c) for r, c in shape if c == left]\n        if not cand:\n            return None\n        r, c = random.choice(cand)\n        return (r, c - 1)\n    cand = [(r, c) for r, c in shape if c == right]\n    if not cand:\n        return None\n    r, c = random.choice(cand)\n    return (r, c + 1)\n\n\ndef _place_hole(grid, template_mask, shape, rng, side):\n    h, w = grid.shape\n    shape_set = set(shape)\n    top, bottom, left, right = _bounding_box(shape_set)\n    sh = bottom - top + 1\n    sw = right - left + 1\n\n    base_r_candidates = []\n    base_c_candidates = []\n    for r0 in range(h):\n        for c0 in range(w):\n            base_r_candidates.append(r0)\n            base_c_candidates.append(c0)\n\n    r_lim0, r_lim1 = int(np.min(np.where(template_mask)[0])) + 1, int(np.max(np.where(template_mask)[0])) - 1\n    c_lim0, c_lim1 = int(np.min(np.where(template_mask)[1])) + 1, int(np.max(np.where(template_mask)[1])) - 1\n\n    tries = 0\n    while tries < 250:\n        tries += 1\n        tx = int(rng.integers(r_lim0, max(r_lim0 + 1, r_lim1 - sh + 2)))\n        ty = int(rng.integers(c_lim0, max(c_lim0 + 1, c_lim1 - sw + 2)))\n        translated = set()\n        ok = True\n        for r, c in shape_set:\n            tr, tc = r - top + tx, c - left + ty\n            if not (0 <= tr < h and 0 <= tc < w):\n                ok = False\n                break\n            if not template_mask[tr, tc]:\n                ok = False\n                break\n            translated.add((tr, tc))\n        if not ok:\n            continue\n        anchor = _choose_anchor(shape_set, side)\n        if anchor is None:\n            continue\n        ar, ac = anchor\n        ar, ac = ar - top + tx, ac - left + ty\n\n        if not (0 <= ar < h and 0 <= ac < w):\n            continue\n        if not template_mask[ar, ac]:\n            continue\n        if grid[ar, ac] \"'!= 1:\n            continue\n        for tr, tc in translated:\n            if grid[tr, tc] != 1:\n                ok = False\n                break\n            grid[tr, tc] = 0\n        if not ok:\n            continue\n        grid[ar, ac] = 2\n        return translated\n    return None\n\n\ndef _place_piece(grid, available, shape, color, red):\n    h, w = grid.shape\n    shape_set = set(shape)\n    rs = [r for r, _ in shape_set]\n    cs = [c for _, c in shape_set]\n    sh = max(rs) - min(rs) + 1\n    sw = max(cs) - min(cs) + 1\n    side = random.randrange(4)\n\n    tries = 0\n    while tries < 400:\n        tries += 1\n        tx = int(np.random.default_rng().integers(0, h - sh + 1))\n        ty = int(np.random.default_rng().integers(0, w - sw + 1))\n        translated = {(r - min(rs) + tx, c - min(cs) + ty) for r, c in shape_set}\n        if any(not available[r, c] for r, c in translated):\n            continue\n        if any(grid[r, c] != 0 for r, c in translated):\n            continue\n\n        anchor = _choose_anchor(shape_set, side)\n        if anchor is None:\n            continue\n        ar, ac = anchor\n        ar, ac = ar - min(rs) + tx, ac - min(cs) + ty\n        if not (0 <= ar < h and 0 <= ac < w):\n            continue\n        if not available[ar, ac] or grid[ar, ac] != 0:\n            continue\n\n        for rr, cc in translated:\n            grid[rr, cc] = color\n        grid[ar, ac] = red\n        return translated\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n\n    for _ in range(300):\n        H = int(rng.integers(20, 31))\n        W = int(rng.integers(20, 31))\n\n        bg = 0\n        grey = 1\n        red = 2\n\n        t_h = int(rng.integers(10, H - 5))\n        t_w = int(rng.integers(10, W - 5))\n        if t_h < 8 or t_w < 8:\n            continue\n\n        top = int(rng.integers(2, max(3, H - t_h - 1)))\n        left = int(rng.integers(2, max(3, W - t_w - 1)))\n        bottom = top + t_h\n        right = left + t_w\n\n        if bottom >= H - 1 or right >= W - 1:\n            continue\n\n        grid = np.full((H, W), bg, dtype=np.int64)\n        template_mask = np.zeros((H, W), dtype=bool)\n        template_mask[top:bottom, left:right] = True\n\n        hole_count = int(rng.integers(2, 5))\n        hole_shapes = []\n        hole_cells = []\n\n        base_rotation_candidates = [(0, 1, 2, 3)]\n        for _ in range(hole_count):\n            placed = False\n            existing_rots = {tuple(sorted(c)) for shape in hole_shapes for c in _shape_rotations(shape)}\n\n            for _ in range(200):\n                size = int(rng.integers(5, 13))\n                shape = _random_shape(size, rng)\n                shape_norm = set(shape)\n                rots = {tuple(sorted(sig)) for sig in _shape_rotations(shape_norm)}\n                if rots & existing_rots:\n                    continue\n\n                side = random.randrange(4)\n                placed_cells = _place_hole(grid, template_mask.copy(), shape_norm, rng, side)\n                if placed_cells is None:\n                    continue\n\n                hole_shapes.append(shape_norm)\n                hole_cells.append(placed_cells)\n                placed = True\n                break\n\n            if not placed:\n                break\n\n        if len(hole_shapes) != hole_count:\n            continue\n\n        grid[template_mask] = grey\n\n        # keep template ring clear for anchor cells that will replace template interior with red\n        outside = np.ones((H, W), dtype=bool)\n        outside[max(0, top - 1):min(H, bottom + 2), max(0, left - 1):min(W, right + 2)] = False\n\n        colors = list(range(3, 3 + hole_count + 6))\n        random.shuffle(colors)\n        piece_colors = colors[:hole_count]\n\n        ok = True\n        for idx, hole_shape in enumerate(hole_shapes):\n            piece_rot = random.randrange(4)\n            rotated = {_rotate_coord(p, piece_rot) for p in hole_shape}\n            rot_shape = {_norm_shape(rotated)}  # one-item set for direct translation\n\n            # convert back to set coords\n            piece_cells = set(rotated)\n            placed = False\n            for _ in range(300):\n                # choose translation in available background outside template margin\n                pts = list(piece_cells)\n                rs = [r for r, _ in pts]\n                cs = [c for _, c in pts]\n                sh = max(rs) - min(rs) + 1\n                sw = max(cs) - min(cs) + 1\n                tx = int(rng.integers(0, H - sh + 1))\n                ty = int(rng.integers(0, W - sw + 1))\n                translated = {(r - min(rs) + tx, c - min(cs) + ty) for r, c in piece_cells}\n\n                if any(grid[r, c] != bg or not outside[r, c] for r, c in translated):\n                    continue\n\n                side = random.randrange(4)\n                anchor = _choose_anchor(piece_cells, side)\n                if anchor is None:\n                    continue\n                ar, ac = anchor\n                ar, ac = ar - min(rs) + tx, ac - min(cs) + ty\n\n                if not (0 <= ar < H and 0 <= ac < W):\n                    continue\n                if grid[ar, ac] != bg or not outside[ar, ac]:\n                    continue\n\n                for r, c in translated:\n                    grid[r, c] = piece_colors[idx]\n                grid[ar, ac] = red\n\n                # mark unavailable\n                for r, c in translated:\n                    outside[r, c] = False\n                outside[ar, ac] = False\n                placed = True\n                break\n\n            if not placed:\n                ok = False\n                break\n\n        if not ok:\n            continue\n\n        try:\n            out = main(grid)\n        except Exception:\n            continue\n\n        if out.shape != grid.shape:\n            continue\n\n        if out.ndim != 2 or max(out.shape) > 30:\n            continue\n\n        return grid\n\n    # fallback deterministic valid 20x20 sample\n    base = np.zeros((20, 20), dtype=np.int64)\n    base[4:16, 4:16] = 1\n    base[7:9, 9] = 0\n    base[9, 7:9] = 2\n    base[5, 8] = 2\n    base[12, 12] = 2\n    base[2:4, 2:6] = 3\n    base[1, 3] = 2\n    return base\nPY'","aggregated_output":"","exit_code":0,"status":"completed"}}
