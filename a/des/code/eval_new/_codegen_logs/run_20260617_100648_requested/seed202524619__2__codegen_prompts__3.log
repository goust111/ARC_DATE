        if (band_line, c) in comp_set\n                    }\n                    marker_pixels = {\n                        (marker_line, c)\n                        for c in range(left - 1, left + 4)\n                        if (marker_line, c) in comp_set\n                    }\n                else:\n                    band_pixels = {\n                        (r, band_line)\n                        for r in range(top - 1, top + 4)\n                        if (r, band_line) in comp_set\n                    }\n                    marker_pixels = {\n                        (r, marker_line)\n                        if (r, marker_line) in comp_set\n                        else None\n                        for r in range(top - 1, top + 4)\n                    }\n                    marker_pixels = {p for p in marker_pixels if p is not None}\n\n                if not band_pixels:\n                    continue\n                if len(band_pixels) > 4:\n                    continue\n\n                band_color = {grid[r, c] for r, c in band_pixels}\n                if len(band_color) \"'!= 1:\n                    continue\n                band_color = next(iter(band_color))\n                if band_color == bg:\n                    continue\n\n                if len(marker_pixels) != 1:\n                    continue\n                marker = next(iter(marker_pixels))\n                marker_color = int(grid[marker[0], marker[1]])\n                if marker_color != band_color:\n                    continue\n\n                if grow_dir in (\"down\", \"up\"):\n                    band_axis = sorted(c for _, c in band_pixels)\n                    marker_axis = [marker[1]]\n                    band_len = len(band_axis)\n                    if band_len < 1 or band_len > 4:\n                        continue\n                    if not _is_contiguous(band_axis):\n                        continue\n                else:\n                    band_axis = sorted(r for r, _ in b