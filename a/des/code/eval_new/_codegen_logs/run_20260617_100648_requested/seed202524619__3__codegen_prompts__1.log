from __future__ import annotations

import random
from collections import deque
from typing import Iterable

import numpy as np


BG = 0
FRAME_COLOR = 7
DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))

_SIDE_TO_ROT = {
    "up": 0,
    "right": 3,
    "down": 2,
    "left": 1,
}



def _bbox_of_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    return int(r0), int(c0), int(r1), int(c1)


def _connected_components(mask: np.ndarray) -> list[np.ndarray]:
    h, w = mask.shape
    visited = np.zeros_like(mask, dtype=bool)
    comps: list[np.ndarray] = []
    for r0 in range(h):
        for c0 in range(w):
            if not bool(mask[r0, c0]) or visited[r0, c0]:
                continue
            q = deque([(int(r0), int(c0))])
            visited[r0, c0] = True
            pts: list[tuple[int, int]] = []
            while q:
                r, c = q.popleft()
                pts.append((r, c))
                for dr, dc in DIRS4:
                    nr, nc = r + dr, c + dc
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not visited[nr, nc]:
                        visited[nr, nc] = True
                        q.append((nr, nc))
            comps.append(np.array(pts, dtype=int))
    return comps


def _is_rect_frame(comp: np.ndarray) -> tuple[int, int, int, int] | None:
    if comp.size == 0:
        return None
    h = int(comp.shape[0])
    if h < 4:
        return None

    r0, c0, r1, c1 = _bbox_of_coords(comp)
    hh = r1 - r0 + 1
    ww = c1 - c0 + 1
    if hh < 3 or ww < 3:
        return None

    if h != (2 * (hh + ww) - 4):
        return None

    comp_set = {tuple(pt) for pt in comp}
    for c in range(c0, c1 + 1):
        if (r0, c) not in comp_set or (r1, c) not in comp_set:
            return None
    for r in range(r0 + 1, r1):
        if (r, c0) not in comp_set or (r, c1) not in comp_set:
            return None
    return r0, c0, r1, c1


def _marker_side(r0: int, c0: int, r1: int, c1: int, mr: int, mc: int) -> str | None:
    inner_top = r0 + 1
    inner_bottom = r1 - 1
    inner_left = c0 + 1
    inner_right = c1 - 1

    if mr == inner_top and inner_left + 1 <= mc <= inner_right - 1:
        return "up"
    if mr == inner_bottom and inner_left + 1 <= mc <= inner_right - 1:
        return "down"
    if mc == inner_left and inner_top + 1 <= mr <= inner_bottom - 1:
        return "left"
    if mc == inner_right and inner_top + 1 <= mr <= inner_bottom - 1:
        return "right"
    return None


def _mask_from_component(comp: np.ndarray) -> np.ndarray:
    r0, c0, r1, c1 = _bbox_of_coords(comp)
    h = r1 - r0 + 1
    w = c1 - c0 + 1
    out = np.zeros((h, w), dtype=bool)
    for r, c in comp:
        out[int(r) - r0, int(c) - c0] = True
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fill each framed black interior with its matching external stamp, rotated by the marker wall side.

    Input structure:
    - bg = 0.
    - One frame-border color draws several closed 1-pixel rectangular walls; their interiors are black.
    - Every frame interior contains exactly one single marker pixel: its color chooses which external stamp is used.
    - The marker lies one cell away from exactly one inner wall (not at frame corners) and its position encodes rotation.
    - Outside frames, each stamp component is monochrome and color-matched to one marker.

    Rule:
    - Detect the frame-border color and all rectangular frame components.
    - For each frame, find its interior marker color and matching external stamp component.
    - Rotate the stamp: marker on top wall→0°, right wall→clockwise 90°, bottom wall→180°, left wall→counter-clockwise 90°.
    - Remove all non-bg non-frame pixels in output, then paste each rotated stamp centered in the frame interior (using the marker color).

    Key insight:
    - A marker pixel carries both keys: one color for identity matching and one wall-side for geometric orientation.
    """
    g = np.asarray(grid, dtype=int)
    h, w = map(int, g.shape)
    assert g.ndim == 2

    bg = int(BG)

    non_bg_colors = [c for c in map(int, np.unique(g)) if c != bg]
    frame_candidates: dict[int, list[np.ndarray]] = {}
    for col in non_bg_colors:
        comps = _connected_components(g == col)
        frames: list[np.ndarray] = []
        for comp in comps:
            if _is_rect_frame(comp) is not None:
                frames.append(comp)
        if frames:
            frame_candidates[int(col)] = frames

    assert frame_candidates, "no rectangular frame component found"
    frame_color = max(frame_candidates, key=lambda c: sum(int(x.shape[0]) for x in frame_candidates[c]))
    frame_comps = frame_candidates[int(frame_color)]
    assert frame_comps, "frame color exists but has no rectangular frame"

    out = g.copy()
    out[(out != bg) & (out != frame_color)] = bg

    for comp in frame_comps:
        frame_box = _is_rect_frame(comp)
        assert frame_box is not None
        fr0, fc0, fr1, fc1 = frame_box

        markers: list[tuple[int, int, int]] = []
        for rr in range(fr0 + 1, fr1):
            for cc in range(fc0 + 1, fc1):
                v = int(g[rr, cc])
                if v != bg and v != frame_color:
                    markers.append((rr, cc, v))

        assert len(markers) == 1, "each frame must contain exactly one marker"
        mr, mc, mcol = markers[0]

        side = _marker_side(fr0, fc0, fr1, fc1, int(mr), int(mc))
        assert side is not None, "marker must be on a single interior wall side"

        color_mask = g == mcol
        color_comps = _connected_components(color_mask)
        assert color_comps, "marker color should have components"

        stamp_comp: np.ndarray | None = None
        for cpts in color_comps:
            if cpts.shape[0] <= 1:
                continue
            comp_set = {tuple(map(int, p)) for p in cpts}
            if (int(mr), int(mc)) not in comp_set:
                stamp_comp = cpts
                break
        assert stamp_comp is not None, "missing external stamp for marker color"

        stamp = _mask_from_component(stamp_comp)
        stamp = np.rot90(stamp, _SIDE_TO_ROT[side])

        ih = fr1 - fr0 - 1
        iw = fc1 - fc0 - 1
        sh, sw = stamp.shape
        assert sh <= ih and sw <= iw, "stamp must fit frame interior"

        top = fr0 + 1 + (ih - sh) // 2
        left = fc0 + 1 + (iw - sw) // 2

        # keep the deterministic geometry from the rule (centered placement)
        sr = mr - fr0 - 1 - (ih - sh) // 2
        sc = mc - fc0 - 1 - (iw - sw) // 2
        assert 0 <= int(sr) < sh and 0 <= int(sc) < sw, "marker must be covered by centered stamp"
        assert stamp[int(sr), int(sc)]

        stamp_coords = np.argwhere(stamp)
        for r0, c0 in stamp_coords:
            out[int(top + r0), int(left + c0)] = int(mcol)

    return out


def _random_connected_mask(h: int, w: int, min_cells: int) -> np.ndarray:
    "Generate a connected binary mask on (h,w) with a non-zero cell count."
    area = h * w
    target = random.randint(min_cells, max(min_cells, area))

    cells: set[tuple[int, int]] = set()
    start = (random.randrange(h), random.randrange(w))
    cells.add(start)

    while len(cells) < target:
        rr, cc = random.choice(tuple(cells))
        dr, dc = random.choice(DIRS4)
        nr, nc = rr + dr, cc + dc
        if 0 <= nr < h and 0 <= nc < w:
            cells.add((nr, nc))

        if len(cells) >= area:
            break

    out = np.zeros((h, w), dtype=bool)
    for rr, cc in cells:
        out[rr, cc] = True
    return out


def _full_row_connected_mask(h: int, w: int) -> np.ndarray:
    "Generate a connected h x w mask that visits every row at least once."
    assert h >= 3 and w >= 2

    cells: set[tuple[int, int]] = set()
    c = random.randrange(w)
    cells.add((0, c))
    for rr in range(1, h):
        c_next = random.randrange(w)
        cells.add((rr, c))
        step = 1 if c_next > c else -1
        for cc in range(c + step, c_next + step, step):
            cells.add((rr, cc))
        c = c_next

    # add extra cells for irregularity
    base = len(cells)
    extra_target = random.randint(0, max(0, h * w - base - 1))
    while len(cells) < base + extra_target:
        rr, cc = random.choice(tuple(cells))
        dr, dc = random.choice(DIRS4)
        nr, nc = rr + dr, cc + dc
        if 0 <= nr < h and 0 <= nc < w:
            cells.add((nr, nc))

    out = np.zeros((h, w), dtype=bool)
    for rr, cc in cells:
        out[rr, cc] = True
    return out


def _to_orientations(mask: np.ndarray) -> list[np.ndarray]:
    out = []
    for k in range(4):
        r = np.rot90(mask, k)
        out.append(r)
        out.append(np.fliplr(r))
    return out


def _is_asym(mask: np.ndarray) -> bool:
    keys: set[bytes] = set()
    for v in _to_orientations(mask):
        keys.add(v.tobytes())
    # require enough distinct orientations to avoid ambiguous rotations
    return len(keys) >= 7


def _build_stamp_with_full_rows(height: int, width: int) -> np.ndarray:
    "Return a connected stamp mask that spans every row."
    stamp = _full_row_connected_mask(height, width)
    if stamp.sum() < 4:
        return None
    # avoid too tiny/ambiguous shapes
    for _ in range(8):
        if _is_asym(stamp):
            return stamp
        # regenerate if symmetric
        stamp = _full_row_connected_mask(height, width)
    return None


def _place_rectangular_frame(
    grid: np.ndarray,
    occupied: np.ndarray,
    side_lengths: tuple[int, int],
    tries: int = 80,
) -> tuple[int, int, int, int] | None:
    h, w = side_lengths
    H, W = grid.shape
    if H < h + 2 or W < w + 2:
        return None

    for _ in range(tries):
        r0 = random.randint(0, H - h)
        c0 = random.randint(0, W - w)

        r1, c1 = r0 + h, c0 + w
        top = max(0, r0 - 1)
        left = max(0, c0 - 1)
        bottom = min(H, r1 + 1)
        right = min(W, c1 + 1)
        if occupied[top:bottom, left:right].any():
            continue

        grid[r0, c0:c1] = FRAME_COLOR
        grid[r1 - 1, c0:c1] = FRAME_COLOR
        grid[r0:r1, c0] = FRAME_COLOR
        grid[r0:r1, c1 - 1] = FRAME_COLOR

        occupied[r0:r1, c0:c1] = True
        return r0, c0, r1 - r0, c1 - c0

    return None


def _can_place_mask(
    free: np.ndarray,
    mask: np.ndarray,
    tr: int,
    tc: int,
    cells: np.ndarray,
) -> bool:
    for r, c in cells:
        if not free[tr + int(r), tc + int(c)]:
            return False
    return True


def _put_mask(
    grid: np.ndarray,
    free: np.ndarray,
    color: int,
    tr: int,
    tc: int,
    cells: np.ndarray,
) -> None:
    for r, c in cells:
        rr, cc = int(tr + r), int(tc + c)
        grid[rr, cc] = int(color)
        free[rr, cc] = False


def generate_input() -> np.ndarray:
    """
    Randomly generate ARC-style inputs for this task.
    """
    max_attempts = 200
    for _ in range(max_attempts):
        H = random.randint(18, 28)
        W = random.randint(18, 28)
        n_frames = random.randint(2, 4)

        color_pool = [c for c in range(1, 10) if c != FRAME_COLOR and c != BG]
        if len(color_pool) < n_frames:
            continue
        marker_colors = random.sample(color_pool, n_frames)

        inp = np.full((H, W), BG, dtype=int)
        occupied = np.zeros((H, W), dtype=bool)

        frame_infos: list[dict[str, object]] = []
        frame_rects = []

        inner_sizes = random.randint(4, 7)

        for idx in range(n_frames):
            side = random.choice(("up", "right", "down", "left"))
            inner_h = random.randint(4, 7)
            inner_w = random.randint(4, 7)
            outer_h = inner_h + 2
            outer_w = inner_w + 2

            rect = _place_rectangular_frame(inp, occupied, (outer_h, outer_w))
            if rect is None:
                break
            fr0, fc0, fh, fw = rect
            fr1 = fr0 + fh
            fc1 = fc0 + fw
            inner_h = fh - 2
            inner_w = fw - 2

            if side in ("up", "down"):
                stamp_h = inner_h
                stamp_w = random.randint(3, inner_w)
                base = _build_stamp_with_full_rows(stamp_h, stamp_w)
                if base is None:
                    break
                stamp = _mask_from_shape(base)
                start_row = 0
                start_col = (inner_w - stamp_w) // 2
                possible_cols = [
                    c for c in range(start_col, start_col + stamp.shape[1]) if 1 <= c <= inner_w - 2
                ]
                if not possible_cols:
                    break
                local_c = random.choice(possible_cols)
                local_r = 0 if side == "up" else inner_h - 1
            else:
                stamp_w = inner_w
                h_candidate = random.randint(3, inner_h)
                base = np.rot90(_build_stamp_with_full_rows(stamp_w, h_candidate))
                if base is None:
                    break
                stamp = _mask_from_shape(base)
                start_row = (inner_h - h_candidate) // 2
                start_col = 0
                possible_rows = [
                    r for r in range(start_row, start_row + stamp.shape[0]) if 1 <= r <= inner_h - 2
                ]
                if not possible_rows:
                    break
                local_r = random.choice(possible_rows)
                local_c = 0 if side == "left" else inner_w - 1

            if not _is_asym(stamp):
                break

            marker_local_row = local_r
            marker_local_col = local_c
            marker_r = fr0 + 1 + marker_local_row
            marker_c = fc0 + 1 + marker_local_col
            if not (0 <= marker_r < H and 0 <= marker_c < W):
                break

            marker_color = marker_colors[idx]
            inp[marker_r, marker_c] = marker_color

            frame_infos.append(
                {
                    "frame": (fr0, fc0, fr1 - 1, fc1 - 1),
                    "side": side,
                    "color": marker_color,
                    "stamp": stamp,
                    "inner": (inner_h, inner_w),
                    "local_marker": (marker_local_row, marker_local_col),
                }
            )
            frame_rects.append((fr0, fc0, fr1 - 1, fc1 - 1))
        else:
            if len(frame_infos) != n_frames:
                continue

            # place external stamps in free area
            free = ~occupied
            free &= inp == BG
            success = True

            for info in frame_infos:
                color = info["color"]
                stamp = info["stamp"]
                mask_cells = np.argwhere(stamp)
                sh, sw = stamp.shape
                placed = False
                for _ in range(160):
                    tr = random.randint(0, H - sh)
                    tc = random.randint(0, W - sw)
                    if not _can_place_mask(free, stamp, tr, tc, mask_cells):
                        continue
                    _put_mask(inp, free, int(color), tr, tc, mask_cells)
                    placed = True
                    break

                if not placed:
                    success = False
                    break

            if not success:
                continue

            try:
                out = main(inp)
            except Exception:
                continue

            if out.shape[0] > 30 or out.shape[1] > 30:
                continue
            if np.array_equal(main(inp), out):
                return inp
    raise RuntimeError("failed to generate valid input for stamp-frame task")


def _mask_from_shape(mask: np.ndarray) -> np.ndarray:
    "Normalize a boolean mask to at least 2x2 non-empty and return a compact copy."
    assert mask.ndim == 2
    if not bool(mask.any()):
        return np.zeros((1, 1), dtype=bool)

    rows = np.where(mask.any(axis=1))[0]
    cols = np.where(mask.any(axis=0))[0]
    r0, r1 = int(rows.min()), int(rows.max())
    c0, c1 = int(cols.min()), int(cols.max())
    return mask[r0 : r1 + 1, c0 : c1 + 1]

