{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nimport numpy as np\nfrom importlib.machinery import SourceFileLoader\nfrom pathlib import Path\nmod = SourceFileLoader('new_arc_task', str(Path('/home/lixinyu/snap/a/des/code/eval_new/seed202524619/3/1.py'))).load_module()\n\ninp = mod.generate_input()\nprint('shape', inp.shape)\n# inspect\nBG = 0\nFRAME = 7\ncoords = np.argwhere(inp == FRAME)\nprint('frame cells', len(coords))\n\ndef is_rect(comp):\n    if comp.size==0:return None\n    r0,c0 = comp.min(axis=0); r1,c1 = comp.max(axis=0)\n    h=r1-r0+1; w=c1-c0+1\n    if comp.shape[0] \"'!= 2*(h+w)-4: return None\n    s={tuple(p) for p in comp}\n    for c in range(c0,c1+1):\n        if (r0,c) not in s or (r1,c) not in s: return None\n    for r in range(r0+1,r1):\n        if (r,c0) not in s or (r,c1) not in s: return None\n    return (r0,c0,r1,c1)\n\nmask = inp==FRAME\n# brute component\nfrom collections import deque\nH,W=inp.shape\nvis=np.zeros_like(mask,bool)\ncomps=[]\nfor r in range(H):\n  for c in range(W):\n    if not mask[r,c] or vis[r,c]: continue\n    q=deque([(r,c)]); vis[r,c]=True; comp=[]\n    while q:\n      x,y=q.popleft(); comp.append((x,y))\n      for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:\n        nx,ny=x+dx,y+dy\n        if 0<=nx<H and 0<=ny<W and mask[nx,ny] and not vis[nx,ny]: vis[nx,ny]=True; q.append((nx,ny))\n    comps.append(np.array(comp))\n\nframe_boxes=[]\nfor comp in comps:\n    fb=is_rect(comp)\n    if fb is not None: frame_boxes.append(fb)\nprint('\"'frames', len(frame_boxes), frame_boxes)\nfor fr0,fc0,fr1,fc1 in frame_boxes:\n    ih=fr1-fr0-1; iw=fc1-fc0-1\n    markers=[]\n    for r in range(fr0+1,fr1):\n        for c in range(fc0+1,fc1):\n            v=int(inp[r,c])\n            if v\"'!=BG and v!=FRAME:\n                markers.append((r,c,v))\n    print('\"'frame',fr0,fc0,fr1,fc1,'ihwi',ih,iw,'markers',markers)\n    if len(markers)\"'!=1:\n        continue