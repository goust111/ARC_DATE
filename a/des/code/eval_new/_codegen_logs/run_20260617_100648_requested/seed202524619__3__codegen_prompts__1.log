nd paste each rotated stamp centered in the frame interior using that color.\n\n    Key insight:\n    - A marker has two meanings at once: the color selects which stamp to use, while its wall-side selects orientation.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    assert g.ndim == 2\n    bg = int(BG)\n\n    # detect frame color and all rectangular frame components\n    frame_candidates: dict[int, list[np.ndarray]] = {}\n    for color in [int(c) for c in np.unique(g) if int(c) != bg]:\n        for comp in _connected_components(g == color):\n            frame_box = _is_rect_frame(comp)\n            if frame_box is not None:\n                frame_candidates.setdefault(color, []).append(comp)\n\n    assert frame_candidates, \"no rectangular frame component found\"\n    frame_color = max(frame_candidates, key=lambda c: len(frame_candidates[c]))\n    frame_comps = frame_candidates[frame_color]\n\n    out = g.copy()\n    out[(out != bg) & (out != frame_color)] = bg\n\n    for comp in frame_comps:\n        fr0, fc0, fr1, fc1 = _is_rect_frame(comp)\n        ih = fr1 - fr0 - 1\n        iw = fc1 - fc0 - 1\n        assert ih >= 3 and iw >= 3\n\n        markers: list[tuple[int, int, int]] = []\n        for r in range(fr0 + 1, fr1):\n            for c in range(fc0 + 1, fc1):\n                v = int(g[r, c])\n                if v != bg and v != frame_color:\n                    markers.append((r, c, v))\n\n        assert len(markers) == 1, \"each frame must contain one marker\"\n        mr, mc, mcol = markers[0]\n\n        side = _marker_side(fr0, fc0, fr1, fc1, mr, mc)\n        assert side is not None, \"marker must touch one interior wall\"\n\n        color_comps = _connected_components(g == mcol)\n        assert color_comps, \"missing marker color\"\n        stamp_comp: np.ndarray | None = None\n        for c in color_comps:\n            if len(c) <= 1:\n                continue\n            if not any((mr == rr and mc == cc) for rr, cc in c):\n                stamp_comp = c\n                break\n        assert stamp_comp is not None, \"missing external stamp component\"\n\n        stamp = _mask_from_component(stamp_comp)\n        stamp = np.rot90(stamp, ROT_BY_SIDE[side])\n\n        sh, sw = map(int, stamp.shape)\n        assert sh <= ih and sw <= iw, \"stamp bigger than frame interior\"\n\n        top = fr0 + 1 + (ih - sh) // 2\n        left = fc0 + 1 + (iw - sw) // 2\n\n        marker_sr = (mr - (fr0 + 1)) - (ih - sh) // 2\n        marker_sc = (mc - (fc0 + 1)) - (iw - sw) // 2\n        assert 0 <= int(marker_sr) < sh and 0 <= int(marker_sc) < sw, \"marker not covered by centered stamp\"\n        assert bool(stamp[int(marker_sr), int(marker_sc)]), \"centered stamp must cover marker\"\n\n        for sr, sc in np.argwhere(stamp):\n            out[int(top + sr), int(left + sc)] = mcol\n\n    return out\n\n\ndef _component_to_mask(cells: list[tuple[int, int]]) -> np.ndarray:\n    r0 = min(r for r, _ in cells)\n    r1 = max(r for r, _ in cells)\n    c0 = min(c for _, c in cells)\n    c1 = max(c for _, c in cells)\n    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)\n    for r, c in cells:\n        out[r - r0, c - c0] = True\n    return out\n\n\ndef _build_stamp_with_full_rows(h: int, w: int) -> np.ndarray:\n    cells: set[tuple[int, int]] = set()\n    c = random.randrange(w)\n    cells.add((0, c))\n\n    for r in range(1, h):\n        next_c = random.randrange(w)\n        cells.add((r, c))\n        step = 1 if next_c > c else -1\n        for cc in range(c + step, next_c + step, step):\n            cells.add((r, cc))\n        c = next_c\n\n    base = len(cells)\n    target = random.randint(base, h * w)\n    while len(cells) < target:\n        r0, c0 = random.choice(tuple(cells))\n        dr, dc = random.choice(DIRS4)\n        nr, nc = r0 + dr, c0 + dc\n        if 0 <= nr < h and 0 <= nc < w:\n            cells.add((nr, nc))\n\n    return _component_to_mask(list(cells))\n\n\ndef _all_orientations(mask: np.ndarray) -> list[np.ndarray]:\n    out = []\n    for k in range(4):\n        r = np.rot90(mask, k)\n        out.append(r)\n        out.append(np.fliplr(r))\n    return out\n\n\ndef _is_asymmetric(mask: np.ndarray) -> bool:\n    keys = { (m.shape, m.tobytes()) for m in _all_orientations(mask) }\n    return len(keys) >= 7\n\n\ndef _place_frame(used: np.ndarray, grid: np.ndarray, h: int, w: int) -> tuple[int, int, int, int] | None:\n    H, W = grid.shape\n    if h >= H or w >= W:\n        return None\n\n    for _ in range(140):\n        r0 = random.randint(0, H - h)\n        c0 = random.randint(0, W - w)\n        r1 = r0 + h\n        c1 = c0 + w\n\n        top = max(0, r0 - 1)\n        left = max(0, c0 - 1)\n        bottom = min(H, r1 + 1)\n        right = min(W, c1 + 1)\n        if used[top:bottom, left:right].any():\n            continue\n\n        grid[r0, c0:c1] = FRAME_COLOR\n        grid[r1 - 1, c0:c1] = FRAME_COLOR\n        grid[r0:r1, c0] = FRAME_COLOR\n        grid[r0:r1, c1 - 1] = FRAME_COLOR\n        used[r0:r1, c0:c1] = True\n        return r0, c0, r1, c1\n\n    return None\n\n\ndef _can_place(free: np.ndarray, cells: np.ndarray, tr: int, tc: int) -> bool:\n    for r, c in cells:\n        if not free[int(tr + r), int(tc + c)]:\n            return False\n    return True\n\n\ndef _paint_mask(grid: np.ndarray, free: np.ndarray, color: int, tr: int, tc: int, cells: np.ndarray) -> None:\n    for r, c in cells:\n        rr = int(tr + r)\n        cc = int(tc + c)\n        grid[rr, cc] = int(color)\n        free[rr, cc] = False\n\n\ndef _build_frame_info(fr0: int, fc0: int, fr1: int, fc1: int, side: str, color: int) -> dict[str, object] | None:\n    ih = fr1 - fr0 - 1\n    iw = fc1 - fc0 - 1\n    assert ih >= 4 and iw >= 4\n\n    if side in (\"up\", \"down\"):\n        stamp_h = ih\n        stamp_w = random.randint(3, iw)\n        for _ in range(40):\n            stamp = _build_stamp_with_full_rows(stamp_h, stamp_w)\n            if not _is_asymmetric(stamp):\n                continue\n            start_row = (ih - stamp_h) // 2\n            start_col = (iw - stamp.shape[1]) // 2\n            marker_row = 0 if side == \"up\" else ih - 1\n            marker_cols = [\n                c for c in range(start_col, start_col + stamp.shape[1]) if 1 <= c <= iw - 2\n            ]\n            if not marker_cols:\n                continue\n            marker_col = random.choice(marker_cols)\n            marker_r = fr0 + 1 + marker_row\n            marker_c = fc0 + 1 + marker_col\n            return {\"stamp\": stamp, \"marker\": (marker_r, marker_c), \"color\": color}\n        return None\n\n    stamp_w = iw\n    stamp_h = random.randint(3, ih)\n    for _ in range(40):\n        stamp = np.rot90(_build_stamp_with_full_rows(stamp_w, stamp_h), 1)\n        if not _is_asymmetric(stamp):\n            continue\n        start_row = (ih - stamp.shape[0]) // 2\n        start_col = (iw - stamp.shape[1]) // 2\n        marker_col = 0 if side == \"left\" else iw - 1\n        marker_rows = [\n            r for r in range(start_row, start_row + stamp.shape[0]) if 1 <= r <= ih - 2\n        ]\n        if not marker_rows:\n            continue\n        marker_row = random.choice(marker_rows)\n        marker_r = fr0 + 1 + marker_row\n        marker_c = fc0 + 1 + marker_col\n        return {\"stamp\": stamp, \"marker\": (marker_r, marker_c), \"color\": color}\n\n    return None\n\n\ndef generate_input() -> np.ndarray:\n    \"\"\"\n    Generate valid random inputs: random number of frames, random marker orientations, and random asymmetric stamps.\n    \"\"\"\n    for _ in range(350):\n        H = random.randint(18, 30)\n        W = random.randint(18, 30)\n        n_frames = random.randint(2, 4)\n\n        color_pool = [c for c in range(1, 10) if c != BG and c != FRAME_COLOR]\n        if len(color_pool) < n_frames:\n            continue\n        marker_colors = random.sample(color_pool, n_frames)\n\n        grid = np.full((H, W), BG, dtype=int)\n        used = np.zeros((H, W), dtype=bool)\n\n        frame_infos: list[dict[str, object]] = []\n        for i in range(n_frames):\n            side = random.choice(SIDES)\n            ih = random.randint(4, 7)\n            iw = random.randint(4, 7)\n            rect = _place_frame(used, grid, ih + 2, iw + 2)\n            if rect is None:\n                break\n\n            fr0, fc0, fr1, fc1 = rect\n            info = _build_frame_info(fr0, fc0, fr1, fc1, side, marker_colors[i])\n            if info is None:\n                break\n\n            marker_r, marker_c = info[\"marker\"]\n            if grid[marker_r, marker_c] != BG:\n                break\n            grid[marker_r, marker_c] = marker_colors[i]\n            frame_infos.append(info | {\"side\": side})\n        else:\n            if len(frame_infos) != n_frames:\n                continue\n\n            free = (grid == BG) & (~used)\n            placed_all = True\n            for info in frame_infos:\n                color = int(info[\"color\"])\n                stamp = info[\"stamp\"]\n                cells = np.argwhere(stamp)\n                sh, sw = stamp.shape\n                placed = False\n                for _ in range(180):\n                    tr = random.randint(0, H - sh)\n                    tc = random.randint(0, W - sw)\n                    if not _can_place(free, cells, tr, tc):\n                        continue\n                    _paint_mask(grid, free, color, tr, tc, cells)\n                    placed = True\n                    break\n                if not placed:\n                    placed_all = False\n                    break\n\n            if not placed_all:\n                continue\n\n            try:\n                _ = main(grid)\n            except Exception:\n                continue\n\n            return grid\n\n    raise RuntimeError(\"failed to generate valid input\")\nPY'","aggregated_output":"","exit_code":0,"status":"completed"}}
