{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom importlib.machinery import SourceFileLoader\nimport numpy as np\nfrom collections import deque\nmod = SourceFileLoader('new_arc_task', '/home/lixinyu/snap/a/des/code/eval_new/seed202524619/3/1.py').load_module()\n\ng = mod.generate_input()\nBG = 0\nFRAME = 7\nH, W = g.shape\n\ndef comps(mask):\n    vis = np.zeros_like(mask, dtype=bool)\n    out = []\n    for r in range(H):\n        for c in range(W):\n            if not mask[r,c] or vis[r,c]:\n                continue\n            q = deque([(r,c)])\n            vis[r,c] = True\n            cells = []\n            while q:\n                x,y = q.popleft()\n                cells.append((x,y))\n                for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:\n                    nx,ny = x+dx,y+dy\n                    if 0<=nx<H and 0<=ny<W and mask[nx,ny] and not vis[nx,ny]:\n                        vis[nx,ny] = True\n                        q.append((nx,ny))\n            out.append(np.array(cells,dtype=int))\n    return out\n\nframe_comps = []\nfor comp in comps(g == FRAME):\n    r0,c0 = comp.min(axis=0)\n    r1,c1 = comp.max(axis=0)\n    h = r1-r0+1\n    w = c1-c0+1\n    if comp.shape[0] == 2*(h+w)-4:\n        frame_comps.append((r0,c0,r1,c1))\n\nfor fr0,fc0,fr1,fc1 in frame_comps:\n    ih, iw = fr1-fr0-1, fc1-fc0-1\n    markers = []\n    for r in range(fr0+1, fr1):\n        for c in range(fc0+1, fc1):\n            v = int(g[r,c])\n            if v \"'!= BG and v != FRAME:\n                markers.append((r,c,v))\n\n    print('\"'frame', (fr0,fc0,fr1,fc1), 'ihw', ih, iw, 'markers', markers)\n    if len(markers)\"'!=1:\n        print('\"'  invalid markers')\n        continue\n    mr,mc,mcol = markers[0]\n    for comp in comps(g == mcol):\n        if len(comp) <= 1:\n            continue\n        if any((int(r)==mr and int(c)==mc) for r,c in comp):\n            continue\n        r0,c0 = comp.min(axis=0)\n        r1,c1 = comp.max(axis=0)\n        sh, sw = r1-r0+1, c1-c0+1\n        print('  ext stamp candidate color',mcol,'shape',sh,sw,'size',len(comp),'fit',sh<=ih and sw<=iw,'bbox', (r0,c0,r1,c1))\n        print('   cols range',c0,c1)\n        print('   marker side check', 'down' if mr==fr1-1 else 'other')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
