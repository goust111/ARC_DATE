{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"cat <<'PY' > /home/lixinyu/snap/a/des/code/eval_new/seed558458950/4/2.py\nimport random\nfrom collections import deque\n\nimport numpy as np\n\n\ndef _most_common_color(grid: np.ndarray) -> int:\n    colors, counts = np.unique(grid, return_counts=True)\n    return int(colors[int(np.argmax(counts))])\n\n\ndef _component_mask(mask: np.ndarray):\n    h, w = mask.shape\n    visited = np.zeros_like(mask, dtype=bool)\n    labels = -np.ones((h, w), dtype=int)\n    comps = []\n    dirs = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\n    for r in range(h):\n        for c in range(w):\n            if not mask[r, c] or visited[r, c]:\n                continue\n            cid = len(comps)\n            q = deque([(r, c)])\n            visited[r, c] = True\n            cells = []\n            touches_border = False\n            min_r, min_c = r, c\n            max_r, max_c = r, c\n\n            while q:\n                cr, cc = q.popleft()\n                cells.append((cr, cc))\n                if cr == 0 or cc == 0 or cr == h - 1 or cc == w - 1:\n                    touches_border = True\n                min_r = min(min_r, cr)\n                min_c = min(min_c, cc)\n                max_r = max(max_r, cr)\n                max_c = max(max_c, cc)\n\n                for dr, dc in dirs:\n                    nr, nc = cr + dr, cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not visited[nr, nc]:\n                        visited[nr, nc] = True\n                        q.append((nr, nc))\n\n            for rr, cc in cells:\n                labels[rr, cc] = cid\n\n            comps.append(\n                {\n                    \\\"pixels\\\": cells,\n                    \\\"size\\\": len(cells),\n                    \\\"touches_border\\\": touches_border,\n                    \\\"bbox\\\": (min_r, min_c, max_r, max_c),\n                }\n            )\n\n    return labels, comps\n\n\ndef _is_solid_rectangle(cells: list[tuple[int, int]], h: int, w: int, min_r: int, min_c: int, max_r: int, max_c: int) -> bool:\n    if not cells:\n        return False\n    if (max_r - min_r + 1) * (max_c - min_c + 1) \"'!= len(cells):\n        return False\n    if not (0 <= min_r < h and 0 <= min_c < w and 0 <= max_r < h and 0 <= max_c < w):\n        return False\n    return True\n\n\ndef _touches_border(cells: list[tuple[int, int]], h: int, w: int) -> bool:\n    for r, c in cells:\n        if r == 0 or c == 0 or r == h - 1 or c == w - 1:\n            return True\n    return False\n\n\ndef _find_marker_component(grid: np.ndarray, bg: int):\n    h, w = grid.shape\n    visited = np.zeros_like(grid, dtype=bool)\n    marker_info = None\n\n    for r in range(h):\n        for c in range(w):\n            color = int(grid[r, c])\n            if color == bg or visited[r, c]:\n                continue\n\n            q = deque([(r, c)])\n            visited[r, c] = True\n            cells = []\n            min_r, min_c = r, c\n            max_r, max_c = r, c\n\n            while q:\n                cr, cc = q.popleft()\n                cells.append((cr, cc))\n                min_r = min(min_r, cr)\n                min_c = min(min_c, cc)\n                max_r = max(max_r, cr)\n                max_c = max(max_c, cc)\n                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nr, nc = cr + dr, cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and int(grid[nr, nc]) == color:\n                        visited[nr, nc] = True\n                        q.append((nr, nc))\n\n            bbox_h = max_r - min_r + 1\n            bbox_w = max_c - min_c + 1\n            area = (max_r - min_r + 1) * (max_c - min_c + 1)\n            touches = _touches_border(cells, h, w)\n            solid_rect = _is_solid_rectangle(cells, h, w, min_r, min_c, max_r, max_c)\n\n            if touches and solid_rect:\n                # marker is usually small; choose the smallest valid edge-rectangle.\n                if marker_info is None or area < marker_info[\"area\"]:\n                    marker_info = {\n                        \"color\": color,\n                        \"bbox\": (min_r, min_c, max_r, max_c),\n                        \"height\": bbox_h,\n                        \"width\": bbox_w,\n                        \"area\": area,\n                    }\n\n    return marker_info\n\n\ndef _can_escape_to_border(\n    start: tuple[int, int],\n    blocked: np.ndarray,\n    h: int,\n    w: int,\n) -> bool:\n    sr, sc = start\n    if blocked[sr, sc]:\n        return False\n\n    q = deque([(sr, sc)])\n    vis = np.zeros((h, w), dtype=bool)\n    vis[sr, sc] = True\n\n    while q:\n        r, c = q.popleft()\n        if r == 0 or c == 0 or r == h - 1 or c == w - 1:\n            return True\n\n        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n            nr, nc = r + dr, c + dc\n            if not (0 <= nr < h and 0 <= nc < w):\n                continue\n            if blocked[nr, nc] or vis[nr, nc]:\n                continue\n            vis[nr, nc] = True\n            q.append((nr, nc))\n\n    return False\n\n\ndef _collect_ring_components(grid: np.ndarray, bg: int, marker_color: int):\n    h, w = grid.shape\n    mask = (grid != bg) & (grid != marker_color)\n    comps = []\n    visited = np.zeros_like(mask, dtype=bool)\n    dirs = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\n    for r in range(h):\n        for c in range(w):\n            if not mask[r, c] or visited[r, c]:\n                continue\n            q = deque([(r, c)])\n            visited[r, c] = True\n            pixels = []\n            min_r, min_c = r, c\n            max_r, max_c = r, c\n            colors = set()\n\n            while q:\n                cr, cc = q.popleft()\n                pixels.append((cr, cc))\n                color = int(grid[cr, cc])\n                colors.add(color)\n                min_r = min(min_r, cr)\n                min_c = min(min_c, cc)\n                max_r = max(max_r, cr)\n                max_c = max(max_c, cc)\n                for dr, dc in dirs:\n                    nr, nc = cr + dr, cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not visited[nr, nc]:\n                        visited[nr, nc] = True\n                        q.append((nr, nc))\n\n            if len(colors) != 1:\n                continue\n            color = colors.pop()\n\n            comps.append(\n                {\n                    \"color\": color,\n                    \"pixels\": pixels,\n                    \"bbox\": (min_r, min_c, max_r, max_c),\n                    \"touches_border\": _touches_border(pixels, h, w),\n                }\n            )\n\n    return comps\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Transform nested loop nesting into nested rectangular frames.\nInput structure:\n- bg is the most common color.\n- Several single-color closed 1-pixel-wide loop components are present in the interior.\n- One small gray marker rectangle sits on the grid border and encodes border thickness.\n- Non-bg colors are background, loops, and marker; only loops define nesting levels.\nRule:\n- Find the marker rectangle; its width (x extent) is used as horizontal border thickness and its height (y extent) as vertical thickness.\n- Compute each loop'\"'s nesting level by how many other loop components strictly contain it.\n- Map level 1 (outermost) to level N (innermost) loop colors to concentric rectangle frames.\n- Adjacent frames are separated by 1 background pixel and the innermost frame is solid-filled with its own color.\nKey insight:\n- The exact loop geometry is irrelevant; only the topological containment order among loop boundaries matters.\n\\\"\\\"\\\"\n    grid = np.asarray(grid)\n    h, w = grid.shape\n\n    if h == 0 or w == 0:\n        return np.array([[0]], dtype=int)\n\n    bg = _most_common_color(grid)\n\n    marker = _find_marker_component(grid, bg)\n    if marker is None:\n        return grid.copy()\n\n    marker_color = marker[\\\"color\\\"]\n    # Horizontal thickness is marker width; vertical thickness is marker height.\n    frame_w = int(marker[\\\"width\\\"])\n    frame_h = int(marker[\\\"height\\\"])\n    frame_w = max(1, frame_w)\n    frame_h = max(1, frame_h)\n\n    # Extract loop components (excluding background and marker color).\n    rings = _collect_ring_components(grid, bg, marker_color)\n    if not rings:\n        return grid.copy()\n\n    # Compute bg component ids to select inside-adjacent bg for each loop.\n    _, bg_comps = _component_mask(grid == bg)\n    bg_label = np.zeros_like(grid, dtype=int)\n    # Re-label once for fast lookups.\n    bg_label[:] = -1\n    for idx, comp in enumerate(bg_comps):\n        for rr, cc in comp[\\\"pixels\\\"]:\n            bg_label[rr, cc] = idx\n\n    ring_inside_ref = [None] * len(rings)\n    for i, ring in enumerate(rings):\n        refs = []\n        for r, c in ring[\\\"pixels\\\"]:\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < h and 0 <= nc < w and grid[nr, nc] == bg:\n                    refs.append((nr, nc))\n\n        chosen = None\n        for rr, cc in refs:\n            lid = bg_label[rr, cc]\n            if lid >= 0 and not bg_comps[lid][\\\"touches_border\\\"]:\n                chosen = (rr, cc)\n                break\n\n        if chosen is None and refs:\n            chosen = refs[0]\n\n        ring_inside_ref[i] = chosen\n\n    levels = []\n    for i, ring in enumerate(rings):\n        # Block only this loop to test topological containment of other ref points.\n        blocked = np.zeros_like(grid, dtype=bool)\n        for rr, cc in ring[\\\"pixels\\\"]:\n            blocked[rr, cc] = True\n\n        encl_count = 0\n        for j, ref in enumerate(ring_inside_ref):\n            if j == i or ref is None:\n                continue\n            if not _can_escape_to_border(ref, blocked, h, w):\n                encl_count += 1\n\n        level = encl_count + 1\n        levels.append((level, ring[\\\"color\\\"]))\n\n    # Build level -> color mapping; keep one color per level, prefer outer to inner order.\n    levels.sort(key=lambda t: t[0])\n    level_to_color = {}\n    for lv, color in levels:\n        if lv not in level_to_color:\n            level_to_color[lv] = color\n\n    if not level_to_color:\n        return grid.copy()\n\n    ordered_levels = sorted(level_to_color.items(), key=lambda t: t[0])\n\n    # Start from innermost as a 1-cell solid, then expand outward.\n    core = np.full((1, 1), ordered_levels[-1][1], dtype=grid.dtype)\n    for idx in range(len(ordered_levels) - 2, -1, -1):\n        color = ordered_levels[idx][1]\n        out_h = core.shape[0] + 2 * frame_h + 2\n        out_w = core.shape[1] + 2 * frame_w + 2\n        out = np.full((out_h, out_w), bg, dtype=grid.dtype)\n\n        out[:frame_h, :] = color\n        out[-frame_h:, :] = color\n        out[:, :frame_w] = color\n        out[:, -frame_w:] = color\n\n        rr = frame_h + 1\n        cc = frame_w + 1\n        out[rr : rr + core.shape[0], cc : cc + core.shape[1]] = core\n        core = out\n\n    return core\n\n\ndef _draw_rect_loop(grid: np.ndarray, r1: int, c1: int, r2: int, c2: int, color: int) -> None:\n    for c in range(c1, c2 + 1):\n        grid[r1, c] = color\n        grid[r2, c] = color\n    for r in range(r1 + 1, r2):\n        grid[r, c1] = color\n        grid[r, c2] = color\n\n\ndef _place_marker(\n    grid: np.ndarray,\n    marker_color: int,\n    marker_h: int,\n    marker_w: int,\n) -> None:\n    h, w = grid.shape\n    marker_h = max(1, min(marker_h, h))\n    marker_w = max(1, min(marker_w, w))\n\n    side = random.randint(0, 3)  # 0 top, 1 bottom, 2 left, 3 right\n    if side == 0:\n        row = 0\n        col = random.randint(0, max(0, w - marker_w))\n        col = min(col, w - marker_w)\n        grid[row : row + marker_h, col : col + marker_w] = marker_color\n    elif side == 1:\n        row = h - marker_h\n        col = random.randint(0, max(0, w - marker_w))\n        col = min(col, w - marker_w)\n        grid[row : row + marker_h, col : col + marker_w] = marker_color\n    elif side == 2:\n        col = 0\n        row = random.randint(0, max(0, h - marker_h))\n        row = min(row, h - marker_h)\n        grid[row : row + marker_h, col : col + marker_w] = marker_color\n    else:\n        col = w - marker_w\n        row = random.randint(0, max(0, h - marker_h))\n        row = min(row, h - marker_h)\n        grid[row : row + marker_h, col : col + marker_w] = marker_color\n\n\ndef generate_input() -> np.ndarray:\n    while True:\n        layers = random.randint(2, 4)\n\n        if layers == 4:\n            max_mark = 3\n        elif layers == 3:\n            max_mark = 4\n        else:\n            max_mark = 5\n\n        marker_w = random.randint(1, max_mark)\n        marker_h = random.randint(1, max_mark)\n        # Keep shape varied; avoid all-equal too often.\n        if random.random() < 0.5 and marker_w < max_mark:\n            marker_w += 1 if random.random() < 0.5 else 0\n        marker_w = max(1, min(marker_w, max_mark))\n        if random.random() < 0.5 and marker_h < max_mark:\n            marker_h += 1 if random.random() < 0.5 else 0\n        marker_h = max(1, min(marker_h, max_mark))\n\n        # Build nested loop sizes (outer -> inner), preserving strong gap between levels.\n        min_outer = 5 + 4 * (layers - 1)\n        outer_h = random.randint(min_outer, 30)\n        outer_w = random.randint(min_outer, 30)\n\n        heights = [outer_h]\n        widths = [outer_w]\n        for _ in range(1, layers):\n            prev_h = heights[-1]\n            prev_w = widths[-1]\n            max_dec_h = (prev_h - 5) // 2\n            max_dec_w = (prev_w - 5) // 2\n            max_dec_h = max(2, min(4, max_dec_h))\n            max_dec_w = max(2, min(4, max_dec_w))\n            dec_h = random.randint(2, max_dec_h)\n            dec_w = random.randint(2, max_dec_w)\n            heights.append(prev_h - 2 * dec_h)\n            widths.append(prev_w - 2 * dec_w)\n\n        if min(heights[-1], widths[-1]) < 5:\n            continue\n\n        outer_top = random.randint(1, 3)\n        outer_left = random.randint(1, 3)\n        extra_bottom = random.randint(2, 4)\n        extra_right = random.randint(2, 4)\n\n        H = outer_top + outer_h + extra_bottom\n        W = outer_left + outer_w + extra_right\n        if H > 30 or W > 30:\n            continue\n\n        # Marker must be on edge, and loops remain inward.\n        if H < marker_h + 2 or W < marker_w + 2:\n            continue\n\n        # Keep loops clearly away from border.\n        if outer_top <= marker_h and outer_left <= marker_w:\n            pass\n\n        palette = [1, 2, 3, 4, 5, 6, 7, 8, 9]\n        if 0 in palette:\n            palette.remove(0)\n        marker_color = 9\n        colors = [c for c in palette if c \"'!= marker_color]\n        if len(colors) < layers:\n            continue\n\n        random.shuffle(colors)\n        layer_colors = colors[:layers]\n\n        # Construct concentric loop sizes with possibly small geometric perturbation.\n        g = np.full((H, W), 0, dtype=np.int64)\n\n        for idx in range(layers):\n            i = idx\n            h_i = heights[i]\n            w_i = widths[i]\n            top = outer_top + (outer_h - h_i) // 2\n            left = outer_left + (outer_w - w_i) // 2\n            bottom = top + h_i - 1\n            right = left + w_i - 1\n            if top < 0 or left < 0 or bottom >= H or right >= W:\n                continue\n\n            color = layer_colors[idx]\n            _draw_rect_loop(g, top, left, bottom, right, color)\n\n            # Irregularity branches: inward spike not crossing neighboring ring.\n            if random.random() < 0.5 and h_i > 9 and w_i > 9:\n                for _ in range(random.randint(1, 2)):\n                    side = random.choice(\"TBLR\")\n                    if side == \"T\":\n                        c = random.randint(left + 1, right - 1)\n                        depth = random.randint(1, 2)\n                        for d in range(1, depth + 1):\n                            if top + d <= bottom - 1:\n                                g[top + d, c] = color\n                    elif side == \"B\":\n                        c = random.randint(left + 1, right - 1)\n                        depth = random.randint(1, 2)\n                        for d in range(1, depth + 1):\n                            if bottom - d >= top + 1:\n                                g[bottom - d, c] = color\n                    elif side == \"L\":\n                        r = random.randint(top + 1, bottom - 1)\n                        depth = random.randint(1, 2)\n                        for d in range(1, depth + 1):\n                            if left + d <= right - 1:\n                                g[r, left + d] = color\n                    else:\n                        r = random.randint(top + 1, bottom - 1)\n                        depth = random.randint(1, 2)\n                        for d in range(1, depth + 1):\n                            if right - d >= left + 1:\n                                g[r, right - d] = color\n\n        _place_marker(g, marker_color, marker_h, marker_w)\n\n        # Ensure marker color does not collide with ring colors.\n        if marker_color in layer_colors:\n            continue\n\n        # Validate non-bg component chain quickly for generator stability.\n        # Each ring must be at least one-cell thick and not touching border.\n        ring_pixels = g != 0\n        ring_pixels = ring_pixels & (g != marker_color)\n        comps = _component_mask(ring_pixels)[1]\n        if len(comps) != layers:\n            continue\n\n        # Keep enough margin so detector can always find enclosed bg.\n        valid = True\n        for comp in comps:\n            touches = False\n            for rr, cc in comp[\"pixels\"]:\n                if rr == 0 or cc == 0 or rr == H - 1 or cc == W - 1:\n                    touches = True\n                    break\n            if touches:\n                valid = False\n                break\n        if not valid:\n            continue\n\n        return g.astype(np.int64)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"cat <<'PY' > /home/lixinyu/snap/a/des/code/eval_new/seed558458950/4/2.py\nimport random\nfrom collections import deque\n\nimport numpy as np\n\n\ndef _most_common_color(grid: np.ndarray) -> int:\n    colors, counts = np.unique(grid, return_counts=True)\n    return int(colors[int(np.argmax(counts))])\n\n\ndef _component_mask(mask: np.ndarray):\n    h, w = mask.shape\n    visited = np.zeros_like(mask, dtype=bool)\n    labels = -np.ones((h, w), dtype=int)\n    comps = []\n    dirs = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\n    for r in range(h):\n        for c in range(w):\n            if not mask[r, c] or visited[r, c]:\n                continue\n            cid = len(comps)\n            q = deque([(r, c)])\n            visited[r, c] = True\n            cells = []\n            touches_border = False\n            min_r, min_c = r, c\n            max_r, max_c = r, c\n\n            while q:\n                cr, cc = q.popleft()\n                cells.append((cr, cc))\n                if cr == 0 or cc == 0 or cr == h - 1 or cc == w - 1:\n                    touches_border = True\n                min_r = min(min_r, cr)\n                min_c = min(min_c, cc)\n                max_r = max(max_r, cr)\n                max_c = max(max_c, cc)\n\n                for dr, dc in dirs:\n                    nr, nc = cr + dr, cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not visited[nr, nc]:\n                        visited[nr, nc] = True\n                        q.append((nr, nc))\n\n            for rr, cc in cells:\n                labels[rr, cc] = cid\n\n            comps.append(\n                {\n                    \\\"pixels\\\": cells,\n                    \\\"size\\\": len(cells),\n                    \\\"touches_border\\\": touches_border,\n                    \\\"bbox\\\": (min_r, min_c, max_r, max_c),\n                }\n            )\n\n    return labels, comps\n\n\ndef _is_solid_rectangle(cells: list[tuple[int, int]], h: int, w: int, min_r: int, min_c: int, max_r: int, max_c: int) -> bool:\n    if not cells:\n        return False\n    if (max_r - min_r + 1) * (max_c - min_c + 1) \"'!= len(cells):\n        return False\n    if not (0 <= min_r < h and 0 <= min_c < w and 0 <= max_r < h and 0 <= max_c < w):\n        return False\n    return True\n\n\ndef _touches_border(cells: list[tuple[int, int]], h: int, w: int) -> bool:\n    for r, c in cells:\n        if r == 0 or c == 0 or r == h - 1 or c == w - 1:\n            return True\n    return False\n\n\ndef _find_marker_component(grid: np.ndarray, bg: int):\n    h, w = grid.shape\n    visited = np.zeros_like(grid, dtype=bool)\n    marker_info = None\n\n    for r in range(h):\n        for c in range(w):\n            color = int(grid[r, c])\n            if color == bg or visited[r, c]:\n                continue\n\n            q = deque([(r, c)])\n            visited[r, c] = True\n            cells = []\n            min_r, min_c = r, c\n            max_r, max_c = r, c\n\n            while q:\n                cr, cc = q.popleft()\n                cells.append((cr, cc))\n                min_r = min(min_r, cr)\n                min_c = min(min_c, cc)\n                max_r = max(max_r, cr)\n                max_c = max(max_c, cc)\n                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nr, nc = cr + dr, cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and int(grid[nr, nc]) == color:\n                        visited[nr, nc] = True\n                        q.append((nr, nc))\n\n            bbox_h = max_r - min_r + 1\n            bbox_w = max_c - min_c + 1\n            area = (max_r - min_r + 1) * (max_c - min_c + 1)\n            touches = _touches_border(cells, h, w)\n            solid_rect = _is_solid_rectangle(cells, h, w, min_r, min_c, max_r, max_c)\n\n            if touches and solid_rect:\n                # marker is usually small; choose the smallest valid edge-rectangle.\n                if marker_info is None or area < marker_info[\"area\"]:\n                    marker_info = {\n                        \"color\": color,\n                        \"bbox\": (min_r, min_c, max_r, max_c),\n                        \"height\": bbox_h,\n                        \"width\": bbox_w,\n                        \"area\": area,\n                    }\n\n    return marker_info\n\n\ndef _can_escape_to_border(\n    start: tuple[int, int],\n    blocked: np.ndarray,\n    h: int,\n    w: int,\n) -> bool:\n    sr, sc = start\n    if blocked[sr, sc]:\n        return False\n\n    q = deque([(sr, sc)])\n    vis = np.zeros((h, w), dtype=bool)\n    vis[sr, sc] = True\n\n    while q:\n        r, c = q.popleft()\n        if r == 0 or c == 0 or r == h - 1 or c == w - 1:\n            return True\n\n        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n            nr, nc = r + dr, c + dc\n            if not (0 <= nr < h and 0 <= nc < w):\n                continue\n            if blocked[nr, nc] or vis[nr, nc]:\n                continue\n            vis[nr, nc] = True\n            q.append((nr, nc))\n\n    return False\n\n\ndef _collect_ring_components(grid: np.ndarray, bg: int, marker_color: int):\n    h, w = grid.shape\n    mask = (grid != bg) & (grid != marker_color)\n    comps = []\n    visited = np.zeros_like(mask, dtype=bool)\n    dirs = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\n    for r in range(h):\n        for c in range(w):\n            if not mask[r, c] or visited[r, c]:\n                continue\n            q = deque([(r, c)])\n            visited[r, c] = True\n            pixels = []\n            min_r, min_c = r, c\n            max_r, max_c = r, c\n            colors = set()\n\n            while q:\n                cr, cc = q.popleft()\n                pixels.append((cr, cc))\n                color = int(grid[cr, cc])\n                colors.add(color)\n                min_r = min(min_r, cr)\n                min_c = min(min_c, cc)\n                max_r = max(max_r, cr)\n                max_c = max(max_c, cc)\n                for dr, dc in dirs:\n                    nr, nc = cr + dr, cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not visited[nr, nc]:\n                        visited[nr, nc] = True\n                        q.append((nr, nc))\n\n            if len(colors) != 1:\n                continue\n            color = colors.pop()\n\n            comps.append(\n                {\n                    \"color\": color,\n                    \"pixels\": pixels,\n                    \"bbox\": (min_r, min_c, max_r, max_c),\n                    \"touches_border\": _touches_border(pixels, h, w),\n                }\n            )\n\n    return comps\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Transform nested loop nesting into nested rectangular frames.\nInput structure:\n- bg is the most common color.\n- Several single-color closed 1-pixel-wide loop components are present in the interior.\n- One small gray marker rectangle sits on the grid border and encodes border thickness.\n- Non-bg colors are background, loops, and marker; only loops define nesting levels.\nRule:\n- Find the marker rectangle; its width (x extent) is used as horizontal border thickness and its height (y extent) as vertical thickness.\n- Compute each loop'\"'s nesting level by how many other loop components strictly contain it.\n- Map level 1 (outermost) to level N (innermost) loop colors to concentric rectangle frames.\n- Adjacent frames are separated by 1 background pixel and the innermost frame is solid-filled with its own color.\nKey insight:\n- The exact loop geometry is irrelevant; only the topological containment order among loop boundaries matters.\n\\\"\\\"\\\"\n    grid = np.asarray(grid)\n    h, w = grid.shape\n\n    if h == 0 or w == 0:\n        return np.array([[0]], dtype=int)\n\n    bg = _most_common_color(grid)\n\n    marker = _find_marker_component(grid, bg)\n    if marker is None:\n        return grid.copy()\n\n    marker_color = marker[\\\"color\\\"]\n    # Horizontal thickness is marker width; vertical thickness is marker height.\n    frame_w = int(marker[\\\"width\\\"])\n    frame_h = int(marker[\\\"height\\\"])\n    frame_w = max(1, frame_w)\n    frame_h = max(1, frame_h)\n\n    # Extract loop components (excluding background and marker color).\n    rings = _collect_ring_components(grid, bg, marker_color)\n    if not rings:\n        return grid.copy()\n\n    # Compute bg component ids to select inside-adjacent bg for each loop.\n    _, bg_comps = _component_mask(grid == bg)\n    bg_label = np.zeros_like(grid, dtype=int)\n    # Re-label once for fast lookups.\n    bg_label[:] = -1\n    for idx, comp in enumerate(bg_comps):\n        for rr, cc in comp[\\\"pixels\\\"]:\n            bg_label[rr, cc] = idx\n\n    ring_inside_ref = [None] * len(rings)\n    for i, ring in enumerate(rings):\n        refs = []\n        for r, c in ring[\\\"pixels\\\"]:\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < h and 0 <= nc < w and grid[nr, nc] == bg:\n                    refs.append((nr, nc))\n\n        chosen = None\n        for rr, cc in refs:\n            lid = bg_label[rr, cc]\n            if lid >= 0 and not bg_comps[lid][\\\"touches_border\\\"]:\n                chosen = (rr, cc)\n                break\n\n        if chosen is None and refs:\n            chosen = refs[0]\n\n        ring_inside_ref[i] = chosen\n\n    levels = []\n    for i, ring in enumerate(rings):\n        # Block only this loop to test topological containment of other ref points.\n        blocked = np.zeros_like(grid, dtype=bool)\n        for rr, cc in ring[\\\"pixels\\\"]:\n            blocked[rr, cc] = True\n\n        encl_count = 0\n        for j, ref in enumerate(ring_inside_ref):\n            if j == i or ref is None:\n                continue\n            if not _can_escape_to_border(ref, blocked, h, w):\n                encl_count += 1\n\n        level = encl_count + 1\n        levels.append((level, ring[\\\"color\\\"]))\n\n    # Build level -> color mapping; keep one color per level, prefer outer to inner order.\n    levels.sort(key=lambda t: t[0])\n    level_to_color = {}\n    for lv, color in levels:\n        if lv not in level_to_color:\n            level_to_color[lv] = color\n\n    if not level_to_color:\n        return grid.copy()\n\n    ordered_levels = sorted(level_to_color.items(), key=lambda t: t[0])\n\n    # Start from innermost as a 1-cell solid, then expand outward.\n    core = np.full((1, 1), ordered_levels[-1][1], dtype=grid.dtype)\n    for idx in range(len(ordered_levels) - 2, -1, -1):\n        color = ordered_levels[idx][1]\n        out_h = core.shape[0] + 2 * frame_h + 2\n        out_w = core.shape[1] + 2 * frame_w + 2\n        out = np.full((out_h, out_w), bg, dtype=grid.dtype)\n\n        out[:frame_h, :] = color\n        out[-frame_h:, :] = color\n        out[:, :frame_w] = color\n        out[:, -frame_w:] = color\n\n        rr = frame_h + 1\n        cc = frame_w + 1\n        out[rr : rr + core.shape[0], cc : cc + core.shape[1]] = core\n        core = out\n\n    return core\n\n\ndef _draw_rect_loop(grid: np.ndarray, r1: int, c1: int, r2: int, c2: int, color: int) -> None:\n    for c in range(c1, c2 + 1):\n        grid[r1, c] = color\n        grid[r2, c] = color\n    for r in range(r1 + 1, r2):\n        grid[r, c1] = color\n        grid[r, c2] = color\n\n\ndef _place_marker(\n    grid: np.ndarray,\n    marker_color: int,\n    marker_h: int,\n    marker_w: int,\n) -> None:\n    h, w = grid.shape\n    marker_h = max(1, min(marker_h, h))\n    marker_w = max(1, min(marker_w, w))\n\n    side = random.randint(0, 3)  # 0 top, 1 bottom, 2 left, 3 right\n    if side == 0:\n        row = 0\n        col = random.randint(0, max(0, w - marker_w))\n        col = min(col, w - marker_w)\n        grid[row : row + marker_h, col : col + marker_w] = marker_color\n    elif side == 1:\n        row = h - marker_h\n        col = random.randint(0, max(0, w - marker_w))\n        col = min(col, w - marker_w)\n        grid[row : row + marker_h, col : col + marker_w] = marker_color\n    elif side == 2:\n        col = 0\n        row = random.randint(0, max(0, h - marker_h))\n        row = min(row, h - marker_h)\n        grid[row : row + marker_h, col : col + marker_w] = marker_color\n    else:\n        col = w - marker_w\n        row = random.randint(0, max(0, h - marker_h))\n        row = min(row, h - marker_h)\n        grid[row : row + marker_h, col : col + marker_w] = marker_color\n\n\ndef generate_input() -> np.ndarray:\n    while True:\n        layers = random.randint(2, 4)\n\n        if layers == 4:\n            max_mark = 3\n        elif layers == 3:\n            max_mark = 4\n        else:\n            max_mark = 5\n\n        marker_w = random.randint(1, max_mark)\n        marker_h = random.randint(1, max_mark)\n        # Keep shape varied; avoid all-equal too often.\n        if random.random() < 0.5 and marker_w < max_mark:\n            marker_w += 1 if random.random() < 0.5 else 0\n        marker_w = max(1, min(marker_w, max_mark))\n        if random.random() < 0.5 and marker_h < max_mark:\n            marker_h += 1 if random.random() < 0.5 else 0\n        marker_h = max(1, min(marker_h, max_mark))\n\n        # Build nested loop sizes (outer -> inner), preserving strong gap between levels.\n        min_outer = 5 + 4 * (layers - 1)\n        outer_h = random.randint(min_outer, 30)\n        outer_w = random.randint(min_outer, 30)\n\n        heights = [outer_h]\n        widths = [outer_w]\n        for _ in range(1, layers):\n            prev_h = heights[-1]\n            prev_w = widths[-1]\n            max_dec_h = (prev_h - 5) // 2\n            max_dec_w = (prev_w - 5) // 2\n            max_dec_h = max(2, min(4, max_dec_h))\n            max_dec_w = max(2, min(4, max_dec_w))\n            dec_h = random.randint(2, max_dec_h)\n            dec_w = random.randint(2, max_dec_w)\n            heights.append(prev_h - 2 * dec_h)\n            widths.append(prev_w - 2 * dec_w)\n\n        if min(heights[-1], widths[-1]) < 5:\n            continue\n\n        outer_top = random.randint(1, 3)\n        outer_left = random.randint(1, 3)\n        extra_bottom = random.randint(2, 4)\n        extra_right = random.randint(2, 4)\n\n        H = outer_top + outer_h + extra_bottom\n        W = outer_left + outer_w + extra_right\n        if H > 30 or W > 30:\n            continue\n\n        # Marker must be on edge, and loops remain inward.\n        if H < marker_h + 2 or W < marker_w + 2:\n            continue\n\n        # Keep loops clearly away from border.\n        if outer_top <= marker_h and outer_left <= marker_w:\n            pass\n\n        palette = [1, 2, 3, 4, 5, 6, 7, 8, 9]\n        if 0 in palette:\n            palette.remove(0)\n        marker_color = 9\n        colors = [c for c in palette if c \"'!= marker_color]\n        if len(colors) < layers:\n            continue\n\n        random.shuffle(colors)\n        layer_colors = colors[:layers]\n\n        # Construct concentric loop sizes with possibly small geometric perturbation.\n        g = np.full((H, W), 0, dtype=np.int64)\n\n        for idx in range(layers):\n            i = idx\n            h_i = heights[i]\n            w_i = widths[i]\n            top = outer_top + (outer_h - h_i) // 2\n            left = outer_left + (outer_w - w_i) // 2\n            bottom = top + h_i - 1\n            right = left + w_i - 1\n            if top < 0 or left < 0 or bottom >= H or right >= W:\n                continue\n\n            color = layer_colors[idx]\n            _draw_rect_loop(g, top, left, bottom, right, color)\n\n            # Irregularity branches: inward spike not crossing neighboring ring.\n            if random.random() < 0.5 and h_i > 9 and w_i > 9:\n                for _ in range(random.randint(1, 2)):\n                    side = random.choice(\"TBLR\")\n                    if side == \"T\":\n                        c = random.randint(left + 1, right - 1)\n                        depth = random.randint(1, 2)\n                        for d in range(1, depth + 1):\n                            if top + d <= bottom - 1:\n                                g[top + d, c] = color\n                    elif side == \"B\":\n                        c = random.randint(left + 1, right - 1)\n                        depth = random.randint(1, 2)\n                        for d in range(1, depth + 1):\n                            if bottom - d >= top + 1:\n                                g[bottom - d, c] = color\n                    elif side == \"L\":\n                        r = random.randint(top + 1, bottom - 1)\n                        depth = random.randint(1, 2)\n                        for d in range(1, depth + 1):\n                            if left + d <= right - 1:\n                                g[r, left + d] = color\n                    else:\n                        r = random.randint(top + 1, bottom - 1)\n                        depth = random.randint(1, 2)\n                        for d in range(1, depth + 1):\n                            if right - d >= left + 1:\n                                g[r, right - d] = color\n\n        _place_marker(g, marker_color, marker_h, marker_w)\n\n        # Ensure marker color does not collide with ring colors.\n        if marker_color in layer_colors:\n            continue\n\n        # Validate non-bg component chain quickly for generator stability.\n        # Each ring must be at least one-cell thick and not touching border.\n        ring_pixels = g != 0\n        ring_pixels = ring_pixels & (g != marker_color)\n        comps = _component_mask(ring_pixels)[1]\n        if len(comps) != layers:\n            continue\n\n        # Keep enough margin so detector can always find enclosed bg.\n        valid = True\n        for comp in comps:\n            touches = False\n            for rr, cc in comp[\"pixels\"]:\n                if rr == 0 or cc == 0 or rr == H - 1 or cc == W - 1:\n                    touches = True\n                    break\n            if touches:\n                valid = False\n                break\n        if not valid:\n            continue\n\n        return g.astype(np.int64)\nPY'","aggregated_output":"","exit_code":0,"status":"completed"}}
