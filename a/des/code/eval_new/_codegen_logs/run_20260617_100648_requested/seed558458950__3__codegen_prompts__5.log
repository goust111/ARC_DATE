in(H, W) < 24:\n            n_obj = min(n_obj, 2)\n\n        objects = []\n        reserved = []\n        used = set()\n        success = True\n\n        for _obj_i in range(n_obj):\n            h = random.randint(5, 7)\n            w = random.randint(5, 7)\n            ori = random.choice((\"H\", \"V\"))\n\n            hole = []\n            for _ in range(80):\n                hole = _random_hole(random, h, w)\n                if hole:\n                    break\n            if not hole:\n                success = False\n                break\n\n            y_min = pad\n            y_max = H - h - pad\n            x_min = pad\n            x_max = W - w - pad\n            if y_max < y_min or x_max < x_min:\n                success = False\n                break\n\n            placed = False\n            for _ in range(260):\n                y = random.randint(y_min, y_max)\n                x = random.randint(x_min, x_max)\n                local = (y - pad, y + h - 1 + pad, x - pad, x + w - 1 + pad)\n\n                conflict = False\n                for prev in reserved:\n                    if _rect_intersects(local, prev):\n                        conflict = True\n                        break\n                if conflict:\n                    continue\n\n                used_main = random.choice([c for c in palette if c not in used] or palette)\n                used_sec = random.choice([c for c in palette if c != used_main])\n                used.update([used_main, used_sec])\n\n                objects.append(\n                    {\n                        \"r\": y,\n                        \"c\": x,\n                        \"h\": h,\n                        \"w\": w,\n                        \"ori\": ori,\n                        \"main\": used_main,\n                        \"sec\": used_sec,\n                        \"hole\": hole,\n                    }\n                )\n                reserved.append(local)\n                placed = True\n                break\n\n            if not placed:\n                success = False\n                break\n\n        if not success:\n            continue\n\n        grid = np.zeros((H, W), dtype=int)\n\n        for obj in objects:\n            r, c, h, w = obj[\"r\"], obj[\"c\"], obj[\"h\"], obj[\"w\"]\n            main_col = obj[\"main\"]\n            sec_col = obj[\"sec\"]\n            ori = obj[\"ori\"]\n            start = random.randint(0, 1)\n\n            if ori == \"H\":\n                for rr in range(h):\n                    col = main_col if ((rr + start) % 2 == 0) else sec_col\n                    grid[r + rr, c : c + w] = col\n            else:\n                for cc in range(w):\n                    col = main_col if ((cc + start) % 2 == 0) else sec_col\n                    grid[r : r + h, c + cc] = col\n\n            for rr, cc in obj[\"hole\"]:\n                grid[r + rr, c + cc] = 0\n\n        return grid\n\n    # Fallback: always-valid single object to avoid hard failure.\n    H = W = 20\n    grid = np.zeros((H, W), dtype=int)\n    h, w = 5, 5\n    r, c = 6, 7\n    for rr in range(h):\n        col = 1 if rr % 2 == 0 else 2\n        grid[r + rr, c : c + w] = col\n    for cc in range(2):\n        grid[r + 2, c + cc + 1] = 0\n    return grid\nPY'","aggregated_output":"","exit_code":0,"status":"completed"}}
