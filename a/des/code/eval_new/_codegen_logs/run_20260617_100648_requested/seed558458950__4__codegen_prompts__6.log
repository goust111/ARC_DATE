{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"cat > /home/lixinyu/snap/a/des/code/eval_new/seed558458950/4/6.py <<'PY'\nimport numpy as np\nfrom collections import deque\n\n\ndef _all_components(grid):\n    h, w = grid.shape\n    visited = np.zeros((h, w), dtype=bool)\n    comps = {}\n    dirs = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\n    for r in range(h):\n        for c in range(w):\n            if visited[r, c]:\n                continue\n            color = int(grid[r, c])\n            q = deque([(r, c)])\n            visited[r, c] = True\n            comp = []\n\n            while q:\n                cr, cc = q.popleft()\n                comp.append((cr, cc))\n                for dr, dc in dirs:\n                    nr, nc = cr + dr, cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and int(grid[nr, nc]) == color:\n                        visited[nr, nc] = True\n                        q.append((nr, nc))\n            comps.setdefault(color, []).append(comp)\n\n    return comps\n\n\ndef _normalize(shape):\n    if not shape:\n        return frozenset()\n    rows = [p[0] for p in shape]\n    cols = [p[1] for p in shape]\n    min_r = min(rows)\n    min_c = min(cols)\n    return frozenset((r - min_r, c - min_c) for r, c in shape)\n\n\ndef _shape_bbox(shape):\n    if not shape:\n        return 0, 0, 0, 0\n    rs = [r for r, _ in shape]\n    cs = [c for _, c in shape]\n    return min(rs), max(rs), min(cs), max(cs)\n\n\ndef _rotate_shape(shape, k):\n    k = k % 4\n    pts = list(shape)\n    if k == 0:\n        rot = pts\n    elif k == 1:\n        rot = [(c, -r) for r, c in pts]\n    elif k == 2:\n        rot = [(-r, -c) for r, c in pts]\n    else:\n        rot = [(-c, r) for r, c in pts]\n    return _normalize(rot)\n\n\ndef _shape_variants(shape):\n    out = []\n    seen = set()\n    current = shape\n    for k in range(4):\n        current = _rotate_shape(shape, k)\n        if current not in seen:\n            seen.add(current)\n            out.append(current)\n    return out\n\n\ndef _detect_containers(grid, bg):\n    comps = _all_components(grid)\n    containers = []\n\n    for color, color_comps in comps.items():\n        if color == bg:\n            continue\n        for comp in color_comps:\n            if len(comp) < 8:\n                continue\n            r_set = set(comp)\n            rs = [r for r, _ in comp]\n            cs = [c for _, c in comp]\n            r0, r1 = min(rs), max(rs)\n            c0, c1 = min(cs), max(cs)\n            h = r1 - r0 + 1\n            w = c1 - c0 + 1\n            if h < 4 or w < 4:\n                continue\n\n            on_perimeter = True\n            for r, c in comp:\n                if r0 < r < r1 and c0 < c < c1:\n                    on_perimeter = False\n                    break\n            if not on_perimeter:\n                continue\n\n            gap_side = None\n            gap_indices = None\n            gap_abs = None\n            valid = True\n\n            for side in (\\\"top\\\", \\\"bottom\\\", \\\"left\\\", \\\"right\\\"):\n                if side == \\\"top\\\":\n                    inds = [c for c in range(c0, c1 + 1) if (r0, c) not in r_set]\n                elif side == \\\"bottom\\\":\n                    inds = [c for c in range(c0, c1 + 1) if (r1, c) not in r_set]\n                elif side == \\\"left\\\":\n                    inds = [r for r in range(r0, r1 + 1) if (r, c0) not in r_set]\n                else:\n                    inds = [r for r in range(r0, r1 + 1) if (r, c1) not in r_set]\n\n                if len(inds) == 0:\n                    continue\n                if len(inds) > 3:\n                    valid = False\n                    break\n                if inds[0] + len(inds) - 1 \"'!= inds[-1]:\n                    valid = False\n                    break\n\n                if gap_side is not None:\n                    valid = False\n                    break\n\n                gap_side = side\n                gap_indices = inds\n                if side in (\"top\", \"bottom\"):\n                    gap_abs = [(r0, c) for c in inds]\n                else:\n                    gap_abs = [(r, c0) for r in inds] if side == \"left\" else [(r, c1) for r in inds]\n\n            if not valid or gap_side is None:\n                continue\n\n            containers.append({\n                \"color\": color,\n                \"bbox\": (r0, r1, c0, c1),\n                \"gap_side\": gap_side,\n                \"gap_indices\": gap_indices,\n                \"gap_cells\": gap_abs,\n            })\n\n    return containers\n\n\ndef _extract_keyhole(grid, bg, container):\n    r0, r1, c0, c1 = container[\"bbox\"]\n    side = container[\"gap_side\"]\n    gap_indices = container[\"gap_indices\"]\n\n    inside_r0, inside_r1 = r0 + 1, r1 - 1\n    inside_c0, inside_c1 = c0 + 1, c1 - 1\n    if inside_r0 > inside_r1 or inside_c0 > inside_c1:\n        return frozenset()\n\n    if side == \"top\":\n        seeds = [(inside_r0, c0 + 1 + c) for c in gap_indices]\n        drs = ((1, 0), (-1, 0), (0, 1), (0, -1))\n    elif side == \"bottom\":\n        seeds = [(inside_r1, c0 + 1 + c) for c in gap_indices]\n        drs = ((1, 0), (-1, 0), (0, 1), (0, -1))\n    elif side == \"left\":\n        seeds = [(r0 + 1 + r, inside_c0) for r in gap_indices]\n        drs = ((1, 0), (-1, 0), (0, 1), (0, -1))\n    else:\n        seeds = [(r0 + 1 + r, inside_c1) for r in gap_indices]\n        drs = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\n    h, w = grid.shape\n    q = deque()\n    seen = set()\n    for sr, sc in seeds:\n        if inside_r0 <= sr <= inside_r1 and inside_c0 <= sc <= inside_c1 and int(grid[sr, sc]) == bg:\n            q.append((sr, sc))\n            seen.add((sr, sc))\n\n    while q:\n        r, c = q.popleft()\n        for dr, dc in drs:\n            nr, nc = r + dr, c + dc\n            if nr < inside_r0 or nr > inside_r1 or nc < inside_c0 or nc > inside_c1:\n                continue\n            if (nr, nc) in seen:\n                continue\n            if int(grid[nr, nc]) != bg:\n                continue\n            seen.add((nr, nc))\n            q.append((nr, nc))\n\n    return _normalize(seen)\n\n\ndef _count_ticks(grid, container, bg):\n    r0, r1, c0, c1 = container[\"bbox\"]\n    gap = container[\"gap_indices\"]\n    h, w = grid.shape\n    side = container[\"gap_side\"]\n\n    if side == \"top\":\n        line_r = r0 - 1\n        if line_r < 0:\n            return 1\n        scan_coords = [(line_r, c) for c in range(c0, c1 + 1)]\n        anchor_start, anchor_end = min(gap), max(gap)\n    elif side == \"bottom\":\n        line_r = r1 + 1\n        if line_r >= h:\n            return 1\n        scan_coords = [(line_r, c) for c in range(c0, c1 + 1)]\n        anchor_start, anchor_end = min(gap), max(gap)\n    elif side == \"left\":\n        line_c = c0 - 1\n        if line_c < 0:\n            return 1\n        scan_coords = [(r, line_c) for r in range(r0, r1 + 1)]\n        anchor_start, anchor_end = min(gap), max(gap)\n    else:\n        line_c = c1 + 1\n        if line_c >= w:\n            return 1\n        scan_coords = [(r, line_c) for r in range(r0, r1 + 1)]\n        anchor_start, anchor_end = min(gap), max(gap)\n\n    runs = []\n    i = 0\n    while i < len(scan_coords):\n        r, c = scan_coords[i]\n        color = int(grid[r, c])\n        if color == bg:\n            i += 1\n            continue\n        j = i + 1\n        while j < len(scan_coords):\n            rr, cc = scan_coords[j]\n            if int(grid[rr, cc]) != color:\n                break\n            j += 1\n        length = j - i\n        if 1 <= length <= 4:\n            pos_start = scan_coords[i][1] if side in (\"top\", \"bottom\") else scan_coords[i][0]\n            pos_end = scan_coords[j - 1][1] if side in (\"top\", \"bottom\") else scan_coords[j - 1][0]\n            runs.append((color, pos_start, pos_end, length))\n        i = j\n\n    if not runs:\n        return 1\n\n    best = None\n    best_key = None\n    for color, pos_start, pos_end, length in runs:\n        if pos_end < anchor_start:\n            dist = anchor_start - pos_end\n        elif pos_start > anchor_end:\n            dist = pos_start - anchor_end\n        else:\n            dist = 0\n\n        key = (dist, -length)\n        if best is None or key > best:\n            best = key\n            best_key = length\n\n    return max(1, min(4, best_key))\n\n\ndef _candidate_keys(grid, bg, frame_color):\n    comps = _all_components(grid)\n    candidates = []\n    for color, color_comps in comps.items():\n        if color in (bg, frame_color):\n            continue\n        for comp in color_comps:\n            if 3 <= len(comp) <= 8:\n                candidates.append({\"color\": color, \"coords\": comp})\n    return candidates\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Insert each matched key into its matching keyhole, shifted by tick depth.\n\n    Input structure:\n    Background is the most frequent color. Large one-pixel-thick gray frames define containers. Each container has one gap of 1-3 background pixels on one frame side, with background connected inside as its keyhole. A short run of marker pixels sits on the exterior side-adjacent to that side to encode insertion depth (1-4). Candidate keys are small connected monochrome components placed outside the containers.\n\n    Rule:\n    For each detected container, derive the keyhole shape by flood-filling background cells connected from the gap inward. Find the key whose shape matches the keyhole under 0/90/180/270 rotation. Read the gap side to get insertion direction and count the adjacent marker run N on that same side. Place the matched key in its matched orientation, shifted by N-1 pixels into the container along the insertion axis from its normalized keyhole position, clear the original key pixels to background, and keep frames and markers unchanged.\n\n    Key insight:\n    Identify and match shapes first (positive key shape vs negative keyhole shape), then use side-specific marker count to determine a deterministic orthogonal insertion depth.\n    \"\"\"\n    g = np.asarray(grid)\n    if g.ndim != 2:\n        return g.copy()\n\n    g = g.astype(int)\n    out = g.copy()\n    bg = int(np.bincount(g.ravel()).argmax())\n\n    containers = _detect_containers(g, bg)\n    if not containers:\n        return out\n\n    comp_index = {}\n    for color, color_comps in _all_components(g).items():\n        comp_index.setdefault(color, []).extend(color_comps)\n\n    frame_color = containers[0][\"color\"]\n    keys = _candidate_keys(g, bg, frame_color)\n    used = [False] * len(keys)\n\n    for container in containers:\n        hole = _extract_keyhole(g, bg, container)\n        if not hole:\n            continue\n\n        hole_min = (min(r for r, _ in hole), min(c for _, c in hole))\n        if hole_min[0] is None:\n            continue\n        tick_n = _count_ticks(g, container, bg)\n        side = container[\"gap_side\"]\n        if side == \"top\":\n            dir_r, dir_c = 1, 0\n        elif side == \"bottom\":\n            dir_r, dir_c = -1, 0\n        elif side == \"left\":\n            dir_r, dir_c = 0, 1\n        else:\n            dir_r, dir_c = 0, -1\n\n        matched = None\n        for idx, key in enumerate(keys):\n            if used[idx]:\n                continue\n            norm_key = _normalize(key[\"coords\"])\n            for rot in _shape_variants(norm_key):\n                if rot == hole:\n                    matched = (idx, rot)\n                    break\n            if matched is not None:\n                break\n\n        if matched is None:\n            continue\n\n        kidx, rot_shape = matched\n        used[kidx] = True\n\n        for r, c in keys[kidx][\"coords\"]:\n            out[r, c] = bg\n\n        shift_r = hole_min[0] + (tick_n - 1) * dir_r\n        shift_c = hole_min[1] + (tick_n - 1) * dir_c\n        for rr, cc in rot_shape:\n            nr = shift_r + rr\n            nc = shift_c + cc\n            if 0 <= nr < out.shape[0] and 0 <= nc < out.shape[1]:\n                out[nr, nc] = keys[kidx][\"color\"]\n\n    return out\n\n\ndef _random_polyomino_3x3(rng, size=None):\n    if size is None:\n        size = int(rng.integers(3, 9))\n\n    cells = {(1, 1)}\n    moves = ((1, 0), (-1, 0), (0, 1), (0, -1))\n    while len(cells) < size:\n        r, c = rng.choice(tuple(cells))\n        dr, dc = moves[int(rng.integers(0, 4))]\n        nr, nc = r + dr, c + dc\n        if 0 <= nr <= 2 and 0 <= nc <= 2:\n            cells.add((nr, nc))\n    return list(cells)\n\n\ndef _place_shape(grid, occupied, shape, color, x_min, y_min, x_max, y_max):\n    h, w = grid.shape\n    if x_min > x_max or y_min > y_max:\n        return False\n\n    shape = _normalize(shape)\n    rs = [p[0] for p in shape]\n    cs = [p[1] for p in shape]\n    sh = max(rs) + 1\n    sw = max(cs) + 1\n\n    for _ in range(400):\n        r0 = int(np.random.default_rng().integers(y_min, y_max - sh + 2))\n        c0 = int(np.random.default_rng().integers(x_min, x_max - sw + 2))\n        ok = True\n        for dr, dc in shape:\n            r = r0 + dr\n            c = c0 + dc\n            if occupied[r, c] or int(grid[r, c]) != 0:\n                ok = False\n                break\n        if not ok:\n            continue\n\n        for dr, dc in shape:\n            r = r0 + dr\n            c = c0 + dc\n            occupied[r, c] = True\n            grid[r, c] = color\n        return True\n\n    return False\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n\n    bg = 0\n    frame = 7\n    mark = 9\n    palette = [1, 2, 3, 4, 5, 6, 8, 10, 11, 12, 13, 14, 15]\n    rng.shuffle(palette)\n    palette_ptr = 0\n\n    h = int(rng.integers(16, 28))\n    w = int(rng.integers(22, 30))\n    grid = np.full((h, w), bg, dtype=int)\n\n    num_containers = int(rng.integers(1, 4))\n\n    occupied = np.zeros((h, w), dtype=bool)\n\n    containers = []\n    container_specs = []\n    used_shapes = set()\n    container_band_end = max(5, w // 2 - 3)\n\n    for idx in range(num_containers):\n        placed = False\n        side = int(rng.integers(4))\n        gap_side = (\"top\", \"right\", \"bottom\", \"left\")[side]\n\n        for _ in range(350):\n            cw = int(rng.integers(6, 10))\n            ch = int(rng.integers(6, 10))\n\n            y0_min = 1\n            y0_max = h - ch - 2\n            x0_max = min(w - cw - 2, container_band_end - cw + 1)\n            x0_min = 1\n\n            if gap_side == \"top\":\n                y0_min = 1\n            elif gap_side == \"bottom\":\n                y0_max = h - ch - 2\n            elif gap_side == \"left\":\n                x0_min = 1\n            else:\n                x0_max = min(x0_max, w - cw - 2)\n\n            if x0_max < x0_min or y0_max < y0_min:\n                # relax constraints and retry in another attempt\n                x0_min = 1\n                x0_max = w - cw - 2\n                if gap_side == \"top\":\n                    y0_min = 1\n                elif gap_side == \"bottom\":\n                    y0_max = h - ch - 2\n                else:\n                    y0_max = h - ch - 2\n\n            if x0_max < x0_min or y0_max < y0_min:\n                continue\n\n            r0 = int(rng.integers(y0_min, y0_max + 1))\n            c0 = int(rng.integers(x0_min, x0_max + 1))\n            r1, c1 = r0 + ch - 1, c0 + cw - 1\n\n            if gap_side == \"left\" and c0 == 0:\n                continue\n            if gap_side == \"top\" and r0 == 0:\n                continue\n            if gap_side == \"bottom\" and r1 + 1 >= h:\n                continue\n            if gap_side == \"right\" and c1 + 1 >= w:\n                continue\n\n            if np.any(occupied[r0 - 1 : r1 + 2, c0 - 1 : c1 + 2]):\n                continue\n\n            # Build a random cavity shape that is always <=3x3 so gap width is naturally <=3.\n            base = _random_polyomino_3x3(rng)\n            base_norm = _normalize(base)\n            shape_id = min(_shape_variants(base_norm))\n            if shape_id in used_shapes:\n                continue\n            used_shapes.add(shape_id)\n\n            hole_rot = int(rng.integers(0, 4))\n            hole_shape = _rotate_shape(base_norm, hole_rot)\n            if not hole_shape:\n                continue\n\n            r_min, r_max, c_min, c_max = _shape_bbox(hole_shape)\n            shape_h = r_max - r_min + 1\n            shape_w = c_max - c_min + 1\n            ih, iw = ch - 2, cw - 2\n            if shape_h > ih or shape_w > iw:\n                continue\n\n            if gap_side == \"top\":\n                dr0 = 0\n                dc0 = rng.integers(0, iw - shape_w + 1)\n            elif gap_side == \"bottom\":\n                dr0 = ih - shape_h\n                dc0 = rng.integers(0, iw - shape_w + 1)\n            elif gap_side == \"left\":\n                dr0 = rng.integers(0, ih - shape_h + 1)\n                dc0 = 0\n            else:\n                dr0 = rng.integers(0, ih - shape_h + 1)\n                dc0 = iw - shape_w\n\n            interior_cells = [(r0 + 1 + dr0 + r, c0 + 1 + dc0 + c) for r, c in hole_shape]\n\n            if any(not (0 <= rr < h and 0 <= cc < w) for rr, cc in interior_cells):\n                continue\n            if any(occupied[rr, cc] for rr, cc in interior_cells):\n                continue\n\n            # Determine gap cells from hole mouth cells on the border side.\n            if gap_side == \"top\":\n                gap_abs = sorted({cc for rr, cc in interior_cells if rr == r0 + 1})\n            elif gap_side == \"bottom\":\n                gap_abs = sorted({cc for rr, cc in interior_cells if rr == r1 - 1})\n            elif gap_side == \"left\":\n                gap_abs = sorted({rr for rr, cc in interior_cells if cc == c0 + 1})\n            else:\n                gap_abs = sorted({rr for rr, cc in interior_cells if cc == c1 - 1})\n\n            if not gap_abs:\n                continue\n            if len(gap_abs) > 3:\n                continue\n\n            # Draw frame.\n            for c in range(c0, c1 + 1):\n                if not (gap_side == \"top\" and c in gap_abs):\n                    grid[r0, c] = frame\n                if not (gap_side == \"bottom\" and c in gap_abs):\n                    grid[r1, c] = frame\n            for r in range(r0, r1 + 1):\n                if not (gap_side == \"left\" and r in gap_abs):\n                    grid[r, c0] = frame\n                if not (gap_side == \"right\" and r in gap_abs):\n                    grid[r, c1] = frame\n\n            for rr, cc in interior_cells:\n                grid[rr, cc] = bg\n\n            # Tick marks on outer side; keep 1..4.\n            tick_n = int(rng.integers(1, 5))\n            if gap_side == \"top\":\n                row = r0 - 1\n                tstart = max(c0 + 1, min(gap_abs[0], c1 - tick_n + 1))\n                for cc in range(tstart, min(tstart + tick_n, c1)):\n                    grid[row, cc] = mark\n            elif gap_side == \"bottom\":\n                row = r1 + 1\n                tstart = max(c0 + 1, min(gap_abs[0], c1 - tick_n + 1))\n                for cc in range(tstart, min(tstart + tick_n, c1)):\n                    grid[row, cc] = mark\n            elif gap_side == \"left\":\n                col = c0 - 1\n                tstart = max(r0 + 1, min(gap_abs[0], r1 - tick_n + 1))\n                for rr in range(tstart, min(tstart + tick_n, r1)):\n                    grid[rr, col] = mark\n            else:\n                col = c1 + 1\n                tstart = max(r0 + 1, min(gap_abs[0], r1 - tick_n + 1))\n                for rr in range(tstart, min(tstart + tick_n, r1)):\n                    grid[rr, col] = mark\n\n            # mark occupancy (only structural cells so key area stays available).\n            occupied[r0 - 1 : r1 + 2, c0 - 1 : c1 + 2] = True\n\n            key_rot = int(rng.integers(0, 4))\n            key_shape = _rotate_shape(base_norm, key_rot)\n\n            key_color = palette[palette_ptr % len(palette)]\n            palette_ptr += 1\n\n            containers.append({\n                \"bbox\": (r0, r1, c0, c1),\n                \"key_shape\": key_shape,\n                \"key_color\": key_color,\n                \"gap\": gap_abs,\n            })\n            container_specs.append((key_shape, key_color))\n            placed = True\n            break\n\n        if not placed:\n            # Fallback weak placement: keep generating smaller container to avoid deadlock.\n            cw = 6\n            ch = 6\n            c0 = 1 + idx * 2\n            r0 = 1 + idx * 2\n            r1, c1 = min(h - 2, r0 + ch - 1), min(w - 2, c0 + cw - 1)\n            for c in range(c0, c1 + 1):\n                grid[r0, c] = frame\n                grid[r1, c] = frame\n            for r in range(r0, r1 + 1):\n                grid[r, c0] = frame\n                grid[r, c1] = frame\n            occupied[r0 - 1 : r1 + 2, c0 - 1 : c1 + 2] = True\n\n    if not containers:\n        # deterministic minimal fallback\n        c0, r0 = 5, 5\n        cw, ch = 8, 8\n        r1, c1 = r0 + ch - 1, c0 + cw - 1\n        for c in range(c0, c1 + 1):\n            grid[r0, c] = frame\n            grid[r1, c] = frame\n        for r in range(r0, r1 + 1):\n            grid[r, c0] = frame\n            grid[r, c1] = frame\n        gap_side = \"top\"\n        for c in (c0 + 2, c0 + 3):\n            grid[r0, c] = bg\n            grid[r0 - 1, c] = mark\n        key_shape = frozenset({(0, 0), (1, 0), (2, 0)})\n        key_color = palette[0]\n        container_specs.append((key_shape, key_color))\n        containers.append({\"bbox\": (r0, r1, c0, c1)})\n\n    # Place matching keys and a few distractors on the right side.\n    right_band = max(w // 2, max(c[\"bbox\"][3] for c in containers) + 3)\n    if right_band >= w - 4:\n        right_band = max(1, w // 2)\n\n    for key_shape, key_color in container_specs:\n        _place_shape(\n            grid,\n            occupied,\n            key_shape,\n            key_color,\n            max(1, right_band),\n            1,\n            w - 2,\n            h - 2,\n        )\n\n    extra_keys = int(rng.integers(0, 3))\n    for _ in range(extra_keys):\n        for _ in range(40):\n            size = int(rng.integers(3, 9))\n            base = _random_polyomino_3x3(rng, size=size)\n            base = _normalize(base)\n            shape_id = min(_shape_variants(base))\n            if shape_id in used_shapes:\n                continue\n            used_shapes.add(shape_id)\n            rot = int(rng.integers(0, 4))\n            shape = _rotate_shape(base, rot)\n            key_color = palette[palette_ptr % len(palette)]\n            palette_ptr += 1\n            placed = _place_shape(\n                grid,\n                occupied,\n                shape,\n                key_color,\n                max(1, right_band),\n                1,\n                w - 2,\n                h - 2,\n            )\n            if placed:\n                break\n\n    return grid\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"cat > /home/lixinyu/snap/a/des/code/eval_new/seed558458950/4/6.py <<'PY'\nimport numpy as np\nfrom collections import deque\n\n\ndef _all_components(grid):\n    h, w = grid.shape\n    visited = np.zeros((h, w), dtype=bool)\n    comps = {}\n    dirs = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\n    for r in range(h):\n        for c in range(w):\n            if visited[r, c]:\n                continue\n            color = int(grid[r, c])\n            q = deque([(r, c)])\n            visited[r, c] = True\n            comp = []\n\n            while q:\n                cr, cc = q.popleft()\n                comp.append((cr, cc))\n                for dr, dc in dirs:\n                    nr, nc = cr + dr, cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and int(grid[nr, nc]) == color:\n                        visited[nr, nc] = True\n                        q.append((nr, nc))\n            comps.setdefault(color, []).append(comp)\n\n    return comps\n\n\ndef _normalize(shape):\n    if not shape:\n        return frozenset()\n    rows = [p[0] for p in shape]\n    cols = [p[1] for p in shape]\n    min_r = min(rows)\n    min_c = min(cols)\n    return frozenset((r - min_r, c - min_c) for r, c in shape)\n\n\ndef _shape_bbox(shape):\n    if not shape:\n        return 0, 0, 0, 0\n    rs = [r for r, _ in shape]\n    cs = [c for _, c in shape]\n    return min(rs), max(rs), min(cs), max(cs)\n\n\ndef _rotate_shape(shape, k):\n    k = k % 4\n    pts = list(shape)\n    if k == 0:\n        rot = pts\n    elif k == 1:\n        rot = [(c, -r) for r, c in pts]\n    elif k == 2:\n        rot = [(-r, -c) for r, c in pts]\n    else:\n        rot = [(-c, r) for r, c in pts]\n    return _normalize(rot)\n\n\ndef _shape_variants(shape):\n    out = []\n    seen = set()\n    current = shape\n    for k in range(4):\n        current = _rotate_shape(shape, k)\n        if current not in seen:\n            seen.add(current)\n            out.append(current)\n    return out\n\n\ndef _detect_containers(grid, bg):\n    comps = _all_components(grid)\n    containers = []\n\n    for color, color_comps in comps.items():\n        if color == bg:\n            continue\n        for comp in color_comps:\n            if len(comp) < 8:\n                continue\n            r_set = set(comp)\n            rs = [r for r, _ in comp]\n            cs = [c for _, c in comp]\n            r0, r1 = min(rs), max(rs)\n            c0, c1 = min(cs), max(cs)\n            h = r1 - r0 + 1\n            w = c1 - c0 + 1\n            if h < 4 or w < 4:\n                continue\n\n            on_perimeter = True\n            for r, c in comp:\n                if r0 < r < r1 and c0 < c < c1:\n                    on_perimeter = False\n                    break\n            if not on_perimeter:\n                continue\n\n            gap_side = None\n            gap_indices = None\n            gap_abs = None\n            valid = True\n\n            for side in (\\\"top\\\", \\\"bottom\\\", \\\"left\\\", \\\"right\\\"):\n                if side == \\\"top\\\":\n                    inds = [c for c in range(c0, c1 + 1) if (r0, c) not in r_set]\n                elif side == \\\"bottom\\\":\n                    inds = [c for c in range(c0, c1 + 1) if (r1, c) not in r_set]\n                elif side == \\\"left\\\":\n                    inds = [r for r in range(r0, r1 + 1) if (r, c0) not in r_set]\n                else:\n                    inds = [r for r in range(r0, r1 + 1) if (r, c1) not in r_set]\n\n                if len(inds) == 0:\n                    continue\n                if len(inds) > 3:\n                    valid = False\n                    break\n                if inds[0] + len(inds) - 1 \"'!= inds[-1]:\n                    valid = False\n                    break\n\n                if gap_side is not None:\n                    valid = False\n                    break\n\n                gap_side = side\n                gap_indices = inds\n                if side in (\"top\", \"bottom\"):\n                    gap_abs = [(r0, c) for c in inds]\n                else:\n                    gap_abs = [(r, c0) for r in inds] if side == \"left\" else [(r, c1) for r in inds]\n\n            if not valid or gap_side is None:\n                continue\n\n            containers.append({\n                \"color\": color,\n                \"bbox\": (r0, r1, c0, c1),\n                \"gap_side\": gap_side,\n                \"gap_indices\": gap_indices,\n                \"gap_cells\": gap_abs,\n            })\n\n    return containers\n\n\ndef _extract_keyhole(grid, bg, container):\n    r0, r1, c0, c1 = container[\"bbox\"]\n    side = container[\"gap_side\"]\n    gap_indices = container[\"gap_indices\"]\n\n    inside_r0, inside_r1 = r0 + 1, r1 - 1\n    inside_c0, inside_c1 = c0 + 1, c1 - 1\n    if inside_r0 > inside_r1 or inside_c0 > inside_c1:\n        return frozenset()\n\n    if side == \"top\":\n        seeds = [(inside_r0, c0 + 1 + c) for c in gap_indices]\n        drs = ((1, 0), (-1, 0), (0, 1), (0, -1))\n    elif side == \"bottom\":\n        seeds = [(inside_r1, c0 + 1 + c) for c in gap_indices]\n        drs = ((1, 0), (-1, 0), (0, 1), (0, -1))\n    elif side == \"left\":\n        seeds = [(r0 + 1 + r, inside_c0) for r in gap_indices]\n        drs = ((1, 0), (-1, 0), (0, 1), (0, -1))\n    else:\n        seeds = [(r0 + 1 + r, inside_c1) for r in gap_indices]\n        drs = ((1, 0), (-1, 0), (0, 1), (0, -1))\n\n    h, w = grid.shape\n    q = deque()\n    seen = set()\n    for sr, sc in seeds:\n        if inside_r0 <= sr <= inside_r1 and inside_c0 <= sc <= inside_c1 and int(grid[sr, sc]) == bg:\n            q.append((sr, sc))\n            seen.add((sr, sc))\n\n    while q:\n        r, c = q.popleft()\n        for dr, dc in drs:\n            nr, nc = r + dr, c + dc\n            if nr < inside_r0 or nr > inside_r1 or nc < inside_c0 or nc > inside_c1:\n                continue\n            if (nr, nc) in seen:\n                continue\n            if int(grid[nr, nc]) != bg:\n                continue\n            seen.add((nr, nc))\n            q.append((nr, nc))\n\n    return _normalize(seen)\n\n\ndef _count_ticks(grid, container, bg):\n    r0, r1, c0, c1 = container[\"bbox\"]\n    gap = container[\"gap_indices\"]\n    h, w = grid.shape\n    side = container[\"gap_side\"]\n\n    if side == \"top\":\n        line_r = r0 - 1\n        if line_r < 0:\n            return 1\n        scan_coords = [(line_r, c) for c in range(c0, c1 + 1)]\n        anchor_start, anchor_end = min(gap), max(gap)\n    elif side == \"bottom\":\n        line_r = r1 + 1\n        if line_r >= h:\n            return 1\n        scan_coords = [(line_r, c) for c in range(c0, c1 + 1)]\n        anchor_start, anchor_end = min(gap), max(gap)\n    elif side == \"left\":\n        line_c = c0 - 1\n        if line_c < 0:\n            return 1\n        scan_coords = [(r, line_c) for r in range(r0, r1 + 1)]\n        anchor_start, anchor_end = min(gap), max(gap)\n    else:\n        line_c = c1 + 1\n        if line_c >= w:\n            return 1\n        scan_coords = [(r, line_c) for r in range(r0, r1 + 1)]\n        anchor_start, anchor_end = min(gap), max(gap)\n\n    runs = []\n    i = 0\n    while i < len(scan_coords):\n        r, c = scan_coords[i]\n        color = int(grid[r, c])\n        if color == bg:\n            i += 1\n            continue\n        j = i + 1\n        while j < len(scan_coords):\n            rr, cc = scan_coords[j]\n            if int(grid[rr, cc]) != color:\n                break\n            j += 1\n        length = j - i\n        if 1 <= length <= 4:\n            pos_start = scan_coords[i][1] if side in (\"top\", \"bottom\") else scan_coords[i][0]\n            pos_end = scan_coords[j - 1][1] if side in (\"top\", \"bottom\") else scan_coords[j - 1][0]\n            runs.append((color, pos_start, pos_end, length))\n        i = j\n\n    if not runs:\n        return 1\n\n    best = None\n    best_key = None\n    for color, pos_start, pos_end, length in runs:\n        if pos_end < anchor_start:\n            dist = anchor_start - pos_end\n        elif pos_start > anchor_end:\n            dist = pos_start - anchor_end\n        else:\n            dist = 0\n\n        key = (dist, -length)\n        if best is None or key > best:\n            best = key\n            best_key = length\n\n    return max(1, min(4, best_key))\n\n\ndef _candidate_keys(grid, bg, frame_color):\n    comps = _all_components(grid)\n    candidates = []\n    for color, color_comps in comps.items():\n        if color in (bg, frame_color):\n            continue\n        for comp in color_comps:\n            if 3 <= len(comp) <= 8:\n                candidates.append({\"color\": color, \"coords\": comp})\n    return candidates\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"Insert each matched key into its matching keyhole, shifted by tick depth.\n\n    Input structure:\n    Background is the most frequent color. Large one-pixel-thick gray frames define containers. Each container has one gap of 1-3 background pixels on one frame side, with background connected inside as its keyhole. A short run of marker pixels sits on the exterior side-adjacent to that side to encode insertion depth (1-4). Candidate keys are small connected monochrome components placed outside the containers.\n\n    Rule:\n    For each detected container, derive the keyhole shape by flood-filling background cells connected from the gap inward. Find the key whose shape matches the keyhole under 0/90/180/270 rotation. Read the gap side to get insertion direction and count the adjacent marker run N on that same side. Place the matched key in its matched orientation, shifted by N-1 pixels into the container along the insertion axis from its normalized keyhole position, clear the original key pixels to background, and keep frames and markers unchanged.\n\n    Key insight:\n    Identify and match shapes first (positive key shape vs negative keyhole shape), then use side-specific marker count to determine a deterministic orthogonal insertion depth.\n    \"\"\"\n    g = np.asarray(grid)\n    if g.ndim != 2:\n        return g.copy()\n\n    g = g.astype(int)\n    out = g.copy()\n    bg = int(np.bincount(g.ravel()).argmax())\n\n    containers = _detect_containers(g, bg)\n    if not containers:\n        return out\n\n    comp_index = {}\n    for color, color_comps in _all_components(g).items():\n        comp_index.setdefault(color, []).extend(color_comps)\n\n    frame_color = containers[0][\"color\"]\n    keys = _candidate_keys(g, bg, frame_color)\n    used = [False] * len(keys)\n\n    for container in containers:\n        hole = _extract_keyhole(g, bg, container)\n        if not hole:\n            continue\n\n        hole_min = (min(r for r, _ in hole), min(c for _, c in hole))\n        if hole_min[0] is None:\n            continue\n        tick_n = _count_ticks(g, container, bg)\n        side = container[\"gap_side\"]\n        if side == \"top\":\n            dir_r, dir_c = 1, 0\n        elif side == \"bottom\":\n            dir_r, dir_c = -1, 0\n        elif side == \"left\":\n            dir_r, dir_c = 0, 1\n        else:\n            dir_r, dir_c = 0, -1\n\n        matched = None\n        for idx, key in enumerate(keys):\n            if used[idx]:\n                continue\n            norm_key = _normalize(key[\"coords\"])\n            for rot in _shape_variants(norm_key):\n                if rot == hole:\n                    matched = (idx, rot)\n                    break\n            if matched is not None:\n                break\n\n        if matched is None:\n            continue\n\n        kidx, rot_shape = matched\n        used[kidx] = True\n\n        for r, c in keys[kidx][\"coords\"]:\n            out[r, c] = bg\n\n        shift_r = hole_min[0] + (tick_n - 1) * dir_r\n        shift_c = hole_min[1] + (tick_n - 1) * dir_c\n        for rr, cc in rot_shape:\n            nr = shift_r + rr\n            nc = shift_c + cc\n            if 0 <= nr < out.shape[0] and 0 <= nc < out.shape[1]:\n                out[nr, nc] = keys[kidx][\"color\"]\n\n    return out\n\n\ndef _random_polyomino_3x3(rng, size=None):\n    if size is None:\n        size = int(rng.integers(3, 9))\n\n    cells = {(1, 1)}\n    moves = ((1, 0), (-1, 0), (0, 1), (0, -1))\n    while len(cells) < size:\n        r, c = rng.choice(tuple(cells))\n        dr, dc = moves[int(rng.integers(0, 4))]\n        nr, nc = r + dr, c + dc\n        if 0 <= nr <= 2 and 0 <= nc <= 2:\n            cells.add((nr, nc))\n    return list(cells)\n\n\ndef _place_shape(grid, occupied, shape, color, x_min, y_min, x_max, y_max):\n    h, w = grid.shape\n    if x_min > x_max or y_min > y_max:\n        return False\n\n    shape = _normalize(shape)\n    rs = [p[0] for p in shape]\n    cs = [p[1] for p in shape]\n    sh = max(rs) + 1\n    sw = max(cs) + 1\n\n    for _ in range(400):\n        r0 = int(np.random.default_rng().integers(y_min, y_max - sh + 2))\n        c0 = int(np.random.default_rng().integers(x_min, x_max - sw + 2))\n        ok = True\n        for dr, dc in shape:\n            r = r0 + dr\n            c = c0 + dc\n            if occupied[r, c] or int(grid[r, c]) != 0:\n                ok = False\n                break\n        if not ok:\n            continue\n\n        for dr, dc in shape:\n            r = r0 + dr\n            c = c0 + dc\n            occupied[r, c] = True\n            grid[r, c] = color\n        return True\n\n    return False\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n\n    bg = 0\n    frame = 7\n    mark = 9\n    palette = [1, 2, 3, 4, 5, 6, 8, 10, 11, 12, 13, 14, 15]\n    rng.shuffle(palette)\n    palette_ptr = 0\n\n    h = int(rng.integers(16, 28))\n    w = int(rng.integers(22, 30))\n    grid = np.full((h, w), bg, dtype=int)\n\n    num_containers = int(rng.integers(1, 4))\n\n    occupied = np.zeros((h, w), dtype=bool)\n\n    containers = []\n    container_specs = []\n    used_shapes = set()\n    container_band_end = max(5, w // 2 - 3)\n\n    for idx in range(num_containers):\n        placed = False\n        side = int(rng.integers(4))\n        gap_side = (\"top\", \"right\", \"bottom\", \"left\")[side]\n\n        for _ in range(350):\n            cw = int(rng.integers(6, 10))\n            ch = int(rng.integers(6, 10))\n\n            y0_min = 1\n            y0_max = h - ch - 2\n            x0_max = min(w - cw - 2, container_band_end - cw + 1)\n            x0_min = 1\n\n            if gap_side == \"top\":\n                y0_min = 1\n            elif gap_side == \"bottom\":\n                y0_max = h - ch - 2\n            elif gap_side == \"left\":\n                x0_min = 1\n            else:\n                x0_max = min(x0_max, w - cw - 2)\n\n            if x0_max < x0_min or y0_max < y0_min:\n                # relax constraints and retry in another attempt\n                x0_min = 1\n                x0_max = w - cw - 2\n                if gap_side == \"top\":\n                    y0_min = 1\n                elif gap_side == \"bottom\":\n                    y0_max = h - ch - 2\n                else:\n                    y0_max = h - ch - 2\n\n            if x0_max < x0_min or y0_max < y0_min:\n                continue\n\n            r0 = int(rng.integers(y0_min, y0_max + 1))\n            c0 = int(rng.integers(x0_min, x0_max + 1))\n            r1, c1 = r0 + ch - 1, c0 + cw - 1\n\n            if gap_side == \"left\" and c0 == 0:\n                continue\n            if gap_side == \"top\" and r0 == 0:\n                continue\n            if gap_side == \"bottom\" and r1 + 1 >= h:\n                continue\n            if gap_side == \"right\" and c1 + 1 >= w:\n                continue\n\n            if np.any(occupied[r0 - 1 : r1 + 2, c0 - 1 : c1 + 2]):\n                continue\n\n            # Build a random cavity shape that is always <=3x3 so gap width is naturally <=3.\n            base = _random_polyomino_3x3(rng)\n            base_norm = _normalize(base)\n            shape_id = min(_shape_variants(base_norm))\n            if shape_id in used_shapes:\n                continue\n            used_shapes.add(shape_id)\n\n            hole_rot = int(rng.integers(0, 4))\n            hole_shape = _rotate_shape(base_norm, hole_rot)\n            if not hole_shape:\n                continue\n\n            r_min, r_max, c_min, c_max = _shape_bbox(hole_shape)\n            shape_h = r_max - r_min + 1\n            shape_w = c_max - c_min + 1\n            ih, iw = ch - 2, cw - 2\n            if shape_h > ih or shape_w > iw:\n                continue\n\n            if gap_side == \"top\":\n                dr0 = 0\n                dc0 = rng.integers(0, iw - shape_w + 1)\n            elif gap_side == \"bottom\":\n                dr0 = ih - shape_h\n                dc0 = rng.integers(0, iw - shape_w + 1)\n            elif gap_side == \"left\":\n                dr0 = rng.integers(0, ih - shape_h + 1)\n                dc0 = 0\n            else:\n                dr0 = rng.integers(0, ih - shape_h + 1)\n                dc0 = iw - shape_w\n\n            interior_cells = [(r0 + 1 + dr0 + r, c0 + 1 + dc0 + c) for r, c in hole_shape]\n\n            if any(not (0 <= rr < h and 0 <= cc < w) for rr, cc in interior_cells):\n                continue\n            if any(occupied[rr, cc] for rr, cc in interior_cells):\n                continue\n\n            # Determine gap cells from hole mouth cells on the border side.\n            if gap_side == \"top\":\n                gap_abs = sorted({cc for rr, cc in interior_cells if rr == r0 + 1})\n            elif gap_side == \"bottom\":\n                gap_abs = sorted({cc for rr, cc in interior_cells if rr == r1 - 1})\n            elif gap_side == \"left\":\n                gap_abs = sorted({rr for rr, cc in interior_cells if cc == c0 + 1})\n            else:\n                gap_abs = sorted({rr for rr, cc in interior_cells if cc == c1 - 1})\n\n            if not gap_abs:\n                continue\n            if len(gap_abs) > 3:\n                continue\n\n            # Draw frame.\n            for c in range(c0, c1 + 1):\n                if not (gap_side == \"top\" and c in gap_abs):\n                    grid[r0, c] = frame\n                if not (gap_side == \"bottom\" and c in gap_abs):\n                    grid[r1, c] = frame\n            for r in range(r0, r1 + 1):\n                if not (gap_side == \"left\" and r in gap_abs):\n                    grid[r, c0] = frame\n                if not (gap_side == \"right\" and r in gap_abs):\n                    grid[r, c1] = frame\n\n            for rr, cc in interior_cells:\n                grid[rr, cc] = bg\n\n            # Tick marks on outer side; keep 1..4.\n            tick_n = int(rng.integers(1, 5))\n            if gap_side == \"top\":\n                row = r0 - 1\n                tstart = max(c0 + 1, min(gap_abs[0], c1 - tick_n + 1))\n                for cc in range(tstart, min(tstart + tick_n, c1)):\n                    grid[row, cc] = mark\n            elif gap_side == \"bottom\":\n                row = r1 + 1\n                tstart = max(c0 + 1, min(gap_abs[0], c1 - tick_n + 1))\n                for cc in range(tstart, min(tstart + tick_n, c1)):\n                    grid[row, cc] = mark\n            elif gap_side == \"left\":\n                col = c0 - 1\n                tstart = max(r0 + 1, min(gap_abs[0], r1 - tick_n + 1))\n                for rr in range(tstart, min(tstart + tick_n, r1)):\n                    grid[rr, col] = mark\n            else:\n                col = c1 + 1\n                tstart = max(r0 + 1, min(gap_abs[0], r1 - tick_n + 1))\n                for rr in range(tstart, min(tstart + tick_n, r1)):\n                    grid[rr, col] = mark\n\n            # mark occupancy (only structural cells so key area stays available).\n            occupied[r0 - 1 : r1 + 2, c0 - 1 : c1 + 2] = True\n\n            key_rot = int(rng.integers(0, 4))\n            key_shape = _rotate_shape(base_norm, key_rot)\n\n            key_color = palette[palette_ptr % len(palette)]\n            palette_ptr += 1\n\n            containers.append({\n                \"bbox\": (r0, r1, c0, c1),\n                \"key_shape\": key_shape,\n                \"key_color\": key_color,\n                \"gap\": gap_abs,\n            })\n            container_specs.append((key_shape, key_color))\n            placed = True\n            break\n\n        if not placed:\n            # Fallback weak placement: keep generating smaller container to avoid deadlock.\n            cw = 6\n            ch = 6\n            c0 = 1 + idx * 2\n            r0 = 1 + idx * 2\n            r1, c1 = min(h - 2, r0 + ch - 1), min(w - 2, c0 + cw - 1)\n            for c in range(c0, c1 + 1):\n                grid[r0, c] = frame\n                grid[r1, c] = frame\n            for r in range(r0, r1 + 1):\n                grid[r, c0] = frame\n                grid[r, c1] = frame\n            occupied[r0 - 1 : r1 + 2, c0 - 1 : c1 + 2] = True\n\n    if not containers:\n        # deterministic minimal fallback\n        c0, r0 = 5, 5\n        cw, ch = 8, 8\n        r1, c1 = r0 + ch - 1, c0 + cw - 1\n        for c in range(c0, c1 + 1):\n            grid[r0, c] = frame\n            grid[r1, c] = frame\n        for r in range(r0, r1 + 1):\n            grid[r, c0] = frame\n            grid[r, c1] = frame\n        gap_side = \"top\"\n        for c in (c0 + 2, c0 + 3):\n            grid[r0, c] = bg\n            grid[r0 - 1, c] = mark\n        key_shape = frozenset({(0, 0), (1, 0), (2, 0)})\n        key_color = palette[0]\n        container_specs.append((key_shape, key_color))\n        containers.append({\"bbox\": (r0, r1, c0, c1)})\n\n    # Place matching keys and a few distractors on the right side.\n    right_band = max(w // 2, max(c[\"bbox\"][3] for c in containers) + 3)\n    if right_band >= w - 4:\n        right_band = max(1, w // 2)\n\n    for key_shape, key_color in container_specs:\n        _place_shape(\n            grid,\n            occupied,\n            key_shape,\n            key_color,\n            max(1, right_band),\n            1,\n            w - 2,\n            h - 2,\n        )\n\n    extra_keys = int(rng.integers(0, 3))\n    for _ in range(extra_keys):\n        for _ in range(40):\n            size = int(rng.integers(3, 9))\n            base = _random_polyomino_3x3(rng, size=size)\n            base = _normalize(base)\n            shape_id = min(_shape_variants(base))\n            if shape_id in used_shapes:\n                continue\n            used_shapes.add(shape_id)\n            rot = int(rng.integers(0, 4))\n            shape = _rotate_shape(base, rot)\n            key_color = palette[palette_ptr % len(palette)]\n            palette_ptr += 1\n            placed = _place_shape(\n                grid,\n                occupied,\n                shape,\n                key_color,\n                max(1, right_band),\n                1,\n                w - 2,\n                h - 2,\n            )\n            if placed:\n                break\n\n    return grid\nPY'","aggregated_output":"","exit_code":0,"status":"completed"}}
