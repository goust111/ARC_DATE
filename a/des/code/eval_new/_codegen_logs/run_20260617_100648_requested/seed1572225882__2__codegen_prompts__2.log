  cells.append((bottom,xc))\n    # left side up\n    for yy in range(bottom-1,top-1,-1):\n        cells.append((yy,left))\n\n    inmask=inside_from_path(cells,H,W)\n    print('cells count',sum(map(sum,inmask)), 'wall',len(cells))\n    # print slices with symbols\n    for r in range(top,top+h+1):\n        s=''\n        for c in range(left,right+1):\n            if (r,c) in set(cells):\n                s+='#'\n            elif inmask[r,c]:\n                s+='.'\n            else:\n                s+=' '\n        print(s)\n    # check interior includes some cells in notch row top+d-1 etc\n    print('rows around notch')\n    for r in range(top,top+d+1):\n        print(r, ''.join('#' if (r,c) in set(cells) else '.' if inmask[r,c] else ' ' for c in range(x0,x1+1)))\n\ntest()\nPY\"","aggregated_output":"cells count 85 wall 51\n###   ######\n#.#   #....#\n#.#   #....#\n#.#####....#\n#..........#\n#..........#\n#..........#\n#..........#\n#..........#\n#..........#\n#..........#\n############\n            \nrows around notch\n4 #   #\n5 #   #\n6 #   #\n7 #####\n","exit_code":0,"status":"completed"}}
