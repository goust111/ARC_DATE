{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"mkdir -p /home/lixinyu/snap/a/des/code/eval_new/seed558458950/5 && cat > /home/lixinyu/snap/a/des/code/eval_new/seed558458950/5/5.py <<'PY'\n\\\"\\\"\\\"Transfer room contents through colored valves on gray separators.\n\nInput structure:\n- The background is the most frequent color in the grid.\n- 1-cell-thick gray walls form a rectangular partition into axis-aligned rooms.\n- Each room interior is either empty (background) or filled with exactly one other color.\n- Shared wall positions may contain valve pixels: non-background, non-gray colors that connect exactly two adjacent rooms.\n\nRule:\n- Find each room as a connected component of non-wall, non-valve cells and read its current fill color (background if no colored fill).\n- For every valve, find its two adjacent rooms. If exactly one room's fill color equals the valve color, that room exports its color to the other room.\n- All exports happen simultaneously: every source room becomes background, every destination room takes the color that appears most often among incoming transfers; ties keep the first such color encountered deterministically.\n- Walls and valve pixels are preserved.\n\nKey insight:\nValve color does not mark the destination; it marks the source room color, so transfer direction and final multi-source conflicts must be resolved by counting active incoming valves per target room.\n\\\"\\\"\\\"\n\nfrom __future__ import annotations\n\nfrom collections import deque\nfrom typing import Dict, Iterable, List, Set, Tuple\n\nimport numpy as np\n\n\nBG_COLOR = 0\nWALL_COLOR = 7\n\n\ndef _infer_colors(grid: np.ndarray) -> Tuple[int, int]:\n    values, counts = np.unique(grid, return_counts=True)\n    bg = int(values[int(np.argmax(counts))])\n\n    counts_by_color: Dict[int, int] = {\n        int(v): int(c) for v, c in zip(values, counts) if int(v) \"'!= bg\n    }\n\n    if not counts_by_color:\n        return bg, bg\n\n    if WALL_COLOR != bg and WALL_COLOR in counts_by_color:\n        wall_count = counts_by_color[WALL_COLOR]\n        largest = max(counts_by_color.values())\n        if wall_count == largest or wall_count >= 0.45 * largest:\n            return bg, WALL_COLOR\n\n    total = grid.size\n    min_area = max(3, int(max(4, total * 0.03)))\n    candidates = [c for c, cnt in counts_by_color.items() if cnt >= min_area]\n    if not candidates:\n        candidates = list(counts_by_color.keys())\n\n    def pair_ratio(color: int) -> float:\n        mask = grid == color\n        area = int(mask.sum())\n        if area <= 1:\n            return float(\"inf\")\n        pairs = int(np.sum(mask[:-1, :] & mask[1:, :]) + np.sum(mask[:, :-1] & mask[:, 1:]))\n        return pairs / area\n\n    wall = min(\n        candidates,\n        key=lambda c: (pair_ratio(c), -counts_by_color.get(c, 0)),\n    )\n    return bg, int(wall)\n\n\ndef _find_valve_candidates(grid: np.ndarray, bg: int, wall: int) -> List[Tuple[int, int]]:\n    h, w = grid.shape\n    mask_not_wall_or_bg = np.logical_and(grid != wall, grid != bg)\n    idx = np.argwhere(mask_not_wall_or_bg)\n    valves: List[Tuple[int, int]] = []\n\n    for r, c in idx:\n        if r == 0 or c == 0 or r == h - 1 or c == w - 1:\n            continue\n\n        up = grid[r - 1, c]\n        down = grid[r + 1, c]\n        left = grid[r, c - 1]\n        right = grid[r, c + 1]\n\n        up_room = up != wall\n        down_room = down != wall\n        left_room = left != wall\n        right_room = right != wall\n\n        cond_h = up_room and down_room\n        cond_v = left_room and right_room\n        if cond_h ''^ cond_v and (up_room or down_room or left_room or right_room):\n            valves.append((int(r), int(c)))\n\n    return valves\n\n\ndef _label_rooms(grid: np.ndarray, blocked: np.ndarray) -> Tuple[np.ndarray, Dict[int, np.ndarray]]:\n    h, w = grid.shape\n    comp = -np.ones((h, w), dtype=np.int32)\n    rooms: Dict[int, List[Tuple[int, int]]] = {}\n    current = 0\n\n    for r in range(h):\n        for c in range(w):\n            if blocked[r, c] or comp[r, c] != -1:\n                continue\n\n            q = deque([(r, c)])\n            comp[r, c] = current\n            room_cells: List[Tuple[int, int]] = []\n\n            while q:\n                cr, cc = q.popleft()\n                room_cells.append((cr, cc))\n                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nr, nc = cr + dr, cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and not blocked[nr, nc] and comp[nr, nc] == -1:\n                        comp[nr, nc] = current\n                        q.append((nr, nc))\n\n            rooms[current] = np.array(room_cells, dtype=np.int32)\n            current += 1\n\n    return comp, rooms\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    inp = np.asarray(grid)\n    if inp.ndim != 2:\n        return inp.copy()\n\n    h, w = inp.shape\n    if h == 0 or w == 0:\n        return inp.copy()\n\n    bg, wall = _infer_colors(inp)\n\n    wall_mask = inp == wall\n\n    valve_candidates = _find_valve_candidates(inp, bg, wall)\n    valve_set: Set[Tuple[int, int]] = set((int(r), int(c)) for r, c in valve_candidates)\n\n    blocked = wall_mask.copy()\n    for vr, vc in valve_set:\n        blocked[vr, vc] = True\n\n    comp, rooms = _label_rooms(inp, blocked)\n    if not rooms:\n        return inp.copy()\n\n    room_colors: Dict[int, int] = {}\n    for rid, cells in rooms.items():\n        vals, cnts = np.unique(inp[tuple(zip(*cells))], return_counts=True)\n        non_bg_idx = [i for i, v in enumerate(vals) if int(v) != bg]\n        if non_bg_idx:\n            # If data is valid, there should be one room-color component; still robust to noise by max count.\n            room_colors[rid] = int(vals[non_bg_idx[np.argmax(cnts[non_bg_idx])]])\n        else:\n            room_colors[rid] = bg\n\n    incoming: Dict[int, Dict[int, int]] = {rid: {} for rid in rooms}\n    source_rooms: Set[int] = set()\n\n    for vr, vc in valve_candidates:\n        valve_color = int(inp[vr, vc])\n        adj_ids: Set[int] = set()\n\n        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n            nr, nc = vr + dr, vc + dc\n            if not (0 <= nr < h and 0 <= nc < w):\n                continue\n            if blocked[nr, nc]:\n                continue\n            adj_ids.add(int(comp[nr, nc]))\n\n        if len(adj_ids) != 2:\n            continue\n\n        a, b = tuple(adj_ids)\n        ca = room_colors[a]\n        cb = room_colors[b]\n\n        if ca == valve_color and cb != valve_color:\n            source_rooms.add(a)\n            incoming[b][valve_color] = incoming[b].get(valve_color, 0) + 1\n        elif cb == valve_color and ca != valve_color:\n            source_rooms.add(b)\n            incoming[a][valve_color] = incoming[a].get(valve_color, 0) + 1\n\n    out = np.array(inp, copy=True)\n    for rid, cells in rooms.items():\n        final_color = room_colors[rid]\n\n        if incoming[rid]:\n            counts = incoming[rid]\n            max_cnt = max(counts.values())\n            winner = -1\n            for col, cnt in counts.items():\n                if cnt == max_cnt:\n                    winner = col\n                    break\n            final_color = winner\n        elif rid in source_rooms:\n            final_color = bg\n\n        if final_color == room_colors[rid]:\n            continue\n\n        rows = cells[:, 0]\n        cols = cells[:, 1]\n        out[rows, cols] = final_color\n\n    return out\n\n\ndef _empty_room() -> int:\n    return BG_COLOR\n\n\ndef _paint_room(\n    grid: np.ndarray,\n    room_top: int,\n    room_left: int,\n    room_bottom: int,\n    room_right: int,\n    color: int,\n) -> None:\n    grid[room_top:room_right, room_left:room_bottom] = color\n\n\ndef _collect_boundaries(\n    row_cuts: List[int],\n    col_cuts: List[int],\n    room_rows: int,\n    room_cols: int,\n) -> List[Dict[str, object]]:\n    boundaries: List[Dict[str, object]] = []\n    for i in range(room_rows):\n        for j in range(room_cols - 1):\n            x = col_cuts[j + 1]\n            y0 = row_cuts[i] + 1\n            y1 = row_cuts[i + 1] - 1\n            candidates: List[Tuple[int, int]] = [(y, x) for y in range(y0, y1 + 1)]\n            if candidates:\n                boundaries.append(\n                    {\n                        \"rooms\": ((i, j), (i, j + 1)),\n                        \"coords\": candidates,\n                        \"used\": [],\n                    }\n                )\n\n    for i in range(room_rows - 1):\n        for j in range(room_cols):\n            y = row_cuts[i + 1]\n            x0 = col_cuts[j] + 1\n            x1 = col_cuts[j + 1] - 1\n            candidates = [(y, x) for x in range(x0, x1 + 1)]\n            if candidates:\n                boundaries.append(\n                    {\n                        \"rooms\": ((i, j), (i + 1, j)),\n                        \"coords\": candidates,\n                        \"used\": [],\n                    }\n                )\n\n    return boundaries\n\n\ndef generate_input() -> np.ndarray:\n    rng = np.random.default_rng()\n\n    palette = [1, 2, 3, 4, 5, 6, 8, 9, 10, 11]\n\n    while True:\n        room_rows = int(rng.integers(2, 5))\n        room_cols = int(rng.integers(2, 5))\n\n        row_h = [int(rng.integers(2, 5)) for _ in range(room_rows)]\n        col_w = [int(rng.integers(2, 5)) for _ in range(room_cols)]\n\n        h = sum(row_h) + room_rows + 1\n        w = sum(col_w) + room_cols + 1\n        if h > 30 or w > 30:\n            continue\n\n        row_cuts = [0]\n        for hh in row_h:\n            row_cuts.append(row_cuts[-1] + 1 + hh)\n        col_cuts = [0]\n        for ww in col_w:\n            col_cuts.append(col_cuts[-1] + 1 + ww)\n\n        if row_cuts[-1] != h - 1 or col_cuts[-1] != w - 1:\n            continue\n\n        grid = np.full((h, w), BG_COLOR, dtype=np.int32)\n\n        for rr in row_cuts:\n            grid[int(rr), :] = WALL_COLOR\n        for cc in col_cuts:\n            grid[:, int(cc)] = WALL_COLOR\n\n        room_color: Dict[Tuple[int, int], int] = {}\n        room_order = [(i, j) for i in range(room_rows) for j in range(room_cols)]\n\n        target_filled = int(max(2, min(len(room_order), int(rng.integers(2, max(3, room_rows * room_cols - 1)))))\n        \n        shuffled = room_order.copy()\n        rng.shuffle(shuffled)\n        filled_rooms = set(tuple(r) for r in shuffled[:target_filled])\n\n        available_colors = palette.copy()\n        rng.shuffle(available_colors)\n        color_idx = 0\n\n        for pos in room_order:\n            if pos in filled_rooms:\n                if color_idx >= len(available_colors):\n                    color_idx = 0\n                    rng.shuffle(available_colors)\n                room_color[pos] = int(available_colors[color_idx])\n                color_idx += 1\n            else:\n                room_color[pos] = BG_COLOR\n\n        # keep at least two different non-background colors\n        used = [c for c in room_color.values() if c != BG_COLOR]\n        if len(set(used)) < 2 and len(used) >= 2:\n            c = used[0]\n            for key in room_order:\n                if room_color[key] == c:\n                    room_color[key] = (c % 11) + 1 if (c % 11) + 1 != WALL_COLOR else 1\n                    break\n\n        if not used:\n            continue\n\n        for i in range(room_rows):\n            r0 = row_cuts[i] + 1\n            r1 = row_cuts[i + 1]\n            for j in range(room_cols):\n                c0 = col_cuts[j] + 1\n                c1 = col_cuts[j + 1]\n                _paint_room(grid, r0, c0, r1, c1, room_color[(i, j)])\n\n        boundaries = _collect_boundaries(row_cuts, col_cuts, room_rows, room_cols)\n\n        # Build helper structures for fast room lookup.\n        room_neighbors: Dict[Tuple[int, int], List[int]] = {key: [] for key in room_order}\n        for bi, b in enumerate(boundaries):\n            (a, b_room) = b[\"rooms\"]\n            room_neighbors[a].append(bi)\n            room_neighbors[b_room].append(bi)\n\n        content_colors = sorted(set(v for v in room_color.values() if v != BG_COLOR))\n        if not content_colors:\n            continue\n\n        used_coords: Set[Tuple[int, int]] = set()\n        all_rooms: Dict[Tuple[int, int], int] = {k: v for k, v in room_color.items()}\n\n        for bi, b in enumerate(boundaries):\n            (a, b_room) = b[\"rooms\"]\n            ra = all_rooms[a]\n            rb = all_rooms[b_room]\n            options: List[str] = []\n            if ra != BG_COLOR and ra != rb:\n                options.append(\"A\")  # valve color equals room a -> moves A -> B\n            if rb != BG_COLOR and rb != ra:\n                options.append(\"B\")  # valve color equals room b -> moves B -> A\n\n            inactive_candidates = [cc for cc in content_colors if cc not in (ra, rb)]\n            if inactive_candidates:\n                options.append(\"N\")\n\n            if not options:\n                continue\n\n            if rng.random() >= 0.72:\n                continue\n\n            branch = rng.choice(options)\n            if branch == \"A\":\n                valve_color = ra\n            elif branch == \"B\":\n                valve_color = rb\n            else:\n                valve_color = int(rng.choice(inactive_candidates))\n\n            candidates = [coord for coord in b[\"coords\"] if tuple(coord) not in used_coords]\n            if not candidates:\n                continue\n            vr, vc = tuple(candidates[int(rng.integers(0, len(candidates)))])\n            grid[vr, vc] = valve_color\n            used_coords.add((vr, vc))\n            b[\"used\"].append((vr, vc))\n\n        # add a dedicated conflict case with probability: same empty room can receive multiple colors\n        if rng.random() < 0.65:\n            empty_targets = [pos for pos in room_order if room_color[pos] == BG_COLOR and len(room_neighbors[pos]) >= 3]\n            if empty_targets:\n                tgt = empty_targets[int(rng.integers(0, len(empty_targets)))]\n                neigh_cols = []\n                for bi in room_neighbors[tgt]:\n                    a, b_room = boundaries[bi][\"rooms\"]\n                    if a == tgt:\n                        src = b_room\n                    else:\n                        src = a\n                    src_color = all_rooms[src]\n                    if src_color != BG_COLOR:\n                        neigh_cols.append((src_color, bi))\n                distinct: Dict[int, List[int]] = {}\n                for c, bi in neigh_cols:\n                    distinct.setdefault(c, []).append(bi)\n\n                if len(distinct) >= 2:\n                    colors = list(distinct.keys())\n                    rng.shuffle(colors)\n                    c1, c2 = colors[0], colors[1]\n\n                    added: Dict[int, int] = {}\n\n                    for c_src, bi in ((c1, distinct[c1][0]), (c2, distinct[c2][0])):\n                        boundary = boundaries[bi]\n                        candidates = [coord for coord in boundary[\"coords\"] if tuple(coord) not in used_coords]\n                        if candidates:\n                            vr, vc = tuple(candidates[int(rng.integers(0, len(candidates)))])\n                            grid[vr, vc] = c_src\n                            used_coords.add((vr, vc))\n                            added[c_src] = added.get(c_src, 0) + 1\n\n                    if c1 in added and c2 in added and (added[c1] == added[c2]):\n                        bi_candidates = [bi for bi in distinct[c1] if (grid[boundaries[bi][\"coords\"][0][0], boundaries[bi][\"coords\"][0][1]] == WALL_COLOR or True)]\n                        if bi_candidates:\n                            bi = bi_candidates[0]\n                            boundary = boundaries[bi]\n                            candidates = [coord for coord in boundary[\"coords\"] if tuple(coord) not in used_coords]\n                            if candidates:\n                                vr, vc = tuple(candidates[int(rng.integers(0, len(candidates)))])\n                                grid[vr, vc] = c1\n                                used_coords.add((vr, vc))\n\n        # ensure at least one valve exists\n        if not np.any(np.isin(np.unique(grid), content_colors).astype(int)):\n            continue\n\n        return np.asarray(grid, dtype=np.int32)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
