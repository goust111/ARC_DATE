e==color).tolist())\n    ok=mod._place_fragment_outside(rng, grid, used, base, forbid)\n    print('placed',ok)\n\n# Analyze if this grid can be solved by main.\nprint('frame_bbox', (r0,c0,r1,c1))\nprint('anchors_by_color',anchors_by_color)\nprint('non-bg count', int((grid\"'!=mod._BG).sum()), '\"'outside?', int(((grid\"'!=mod._BG) & (~forbid)).sum()))\n\n# run helper functions from main logic manually\ng=grid\nbg = mod._get_bg(g)\nfc,bbox=mod._detect_frame(g)\nprint('\"'detected frame_color',fc,'bbox',bbox)\nanchors=mod._collect_anchor_cells(g,bg,bbox)\nprint('anchor cells collected', {k:len(v) for k,v in anchors.items()})\nfr=mod._get_bg(g)\n\ngmask=(g\"'!=bg) & (~np.zeros_like(g,dtype=bool))\n# reconstruct frame mask\nr0,c0,r1,c1=bbox\nframe_mask=np.zeros(g.shape,dtype=bool)\nframe_mask[r0,c0:c1+1]=True; frame_mask[r1,c0:c1+1]=True; frame_mask[r0:r1+1,c0]=True; frame_mask[r0:r1+1,c1]=True\nfragment_mask=(g!=bg)&(~frame_mask)\nfor col,pts in anchors.items():\n    for r,c in pts:\n        fragment_mask[r,c]=False\nprint('\"'components count', end=' ')\ncomp_count=0\nfor comp in mod.components_mask(fragment_mask, connectivity=4):\n    comp_count +=1\nprint(comp_count)\nfor comp in mod.components_mask(fragment_mask, connectivity=4):\n    comp=np.asarray(comp,dtype=int)\n    comp_set={(int(r),int(c)) for r,c in comp.tolist()}\n    b=mod._boundary_colors(g, comp, comp_set)\n    matches=[c for c in b if c in anchors]\n    print('component size',len(comp), 'boundary',sorted(b), 'matches',matches)\n    if len(matches)==1:\n        iface=int(matches[0])\n        piece=mod._crop_piece(g, comp, bg)\n        place=mod._place_piece_inside(piece, iface, set(map(tuple,anchors[iface])), r0+1,c0+1,r1-1,c1-1,bg,np.zeros_like(g,dtype=bool))\n        print(' iface',iface,'place',place is not None)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
