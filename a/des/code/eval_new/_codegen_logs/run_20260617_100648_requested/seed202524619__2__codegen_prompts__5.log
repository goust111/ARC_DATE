{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/2c181942.py\"","aggregated_output":"from __future__ import annotations\nimport random\nimport numpy as np\nfrom arc_utils import STRUCT8, bbox_coords, get_bg, label_mask, paste, random_free_location\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Attach monochrome sprites to the matching sides of a central hollow square.\n\n    Input structure:\n    - bg = background. A hollow NxN square (hub) with bg corners/interior and four differently-colored edges (top, bottom, left, right).\n    - 2-4 monochrome sprites scattered on the grid, each matching one hub edge color.\n\n    Rule:\n    - For each hub edge color, find the matching sprite outside the hub.\n    - Rotate the sprite (0/90/180/270°) so its contact edge has exactly N-2 contiguous cells aligned with the hub side, and the rotated sprite is mirror-symmetric along the contact-edge axis (UD for left/right, LR for top/bottom).\n    - Translate it to adjoin that hub side. \n    - Clear everything else to bg; output is hub + attached sprites only.\n\n    Key insight: Each edge color uniquely pairs a sprite to a side; symmetry along the contact-edge axis disambiguates the correct rotation.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    def _find_hub():\n        best = None  # (score, (r,c,n), (top,bot,left,right))\n        for n in range(3, 7):\n            for r in range(0, int(H - n + 1)):\n                for c in range(0, int(W - n + 1)):\n                    # corners must be bg\n                    if (\n                        int(g[int(r), int(c)]) != int(bg)\n                        or int(g[int(r), int(c + n - 1)]) != int(bg)\n                        or int(g[int(r + n - 1), int(c)]) != int(bg)\n                        or int(g[int(r + n - 1), int(c + n - 1)]) != int(bg)\n                    ):\n                        continue\n                    inner = g[int(r + 1) : int(r + n - 1), int(c + 1) : int(c + n - 1)]\n                    if not bool((inner == int(bg)).all()):\n                        continue\n\n                    top = g[int(r), int(c + 1) : int(c + n - 1)]\n                    bot = g[int(r + n - 1), int(c + 1) : int(c + n - 1)]\n                    left = g[int(r + 1) : int(r + n - 1), int(c)]\n                    right = g[int(r + 1) : int(r + n - 1), int(c + n - 1)]\n\n                    if bool((top == int(bg)).any()) or bool((bot == int(bg)).any()) or bool((left == int(bg)).any()) or bool((right == int(bg)).any()):\n                        continue\n                    if (\n                        len(set(map(int, top))) != 1\n                        or len(set(map(int, bot))) != 1\n                        or len(set(map(int, left))) != 1\n                        or len(set(map(int, right))) != 1\n                    ):\n                        continue\n\n                    cr = float(r + (n - 1) / 2)\n                    cc = float(c + (n - 1) / 2)\n                    score = abs(float(cr - (H - 1) / 2)) + abs(float(cc - (W - 1) / 2))\n                    cand = (\n                        float(score),\n                        (int(r), int(c), int(n)),\n                        (int(top[0]), int(bot[0]), int(left[0]), int(right[0])),\n                    )\n                    if best is None or float(cand[0]) < float(best[0]):\n                        best = cand\n        return best\n\n    hub = _find_hub()\n    assert not (hub is None)\n\n    _score, (r, c, n), (top_col, bot_col, left_col, right_col) = hub\n    hub_mask = np.zeros((H, W), dtype=bool)\n    hub_mask[int(r) : int(r + n), int(c) : int(c + n)] = True\n\n    out = np.full_like(g, int(bg))\n    out[int(r) : int(r + n), int(c) : int(c + n)] = g[int(r) : int(r + n), int(c) : int(c + n)]\n\n    target = int(n - 2)  # length of the hub edge segment (excluding corners)\n\n    def _crop_to_mask(arr: np.ndarray, mask: np.ndarray) -> tuple[np.ndarray, np.ndarray]:\n        pts = np.argwhere(mask)\n        r0, c0, r1, c1 = bbox_coords(pts)\n        return arr[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1], mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]\n\n    def _edge_segment(mask: np.ndarray, side: str):\n        pts = np.argwhere(mask)\n        if pts.size == 0:\n            return None\n        if side == \"top\":\n            rr = int(pts[:, 0].min())\n            cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])\n            return (\"h\", int(rr), cols)\n        if side == \"bot\":\n            rr = int(pts[:, 0].max())\n            cols = sorted(int(x) for x in pts[pts[:, 0] == rr][:, 1])\n            return (\"h\", int(rr), cols)\n        if side == \"left\":\n            cc = int(pts[:, 1].min())\n            rows = sorted(int(x) for x in pts[pts[:, 1] == cc][:, 0])\n            return (\"v\", int(cc), rows)\n        if side == \"right\":\n            cc = int(pts[:, 1].max())\n            rows = sorted(int(x) for x in pts[pts[:, 1] == cc][:, 0])\n            return (\"v\", int(cc), rows)\n        return None\n\n    def _is_contig(seq: list[int]) -> bool:\n        return bool(seq) and all(int(seq[i]) + 1 == int(seq[i + 1]) for i in range(len(seq) - 1))\n\n    # desired attachment geometry: adjacent (touching) the hub side segment\n    segs = {\n        \"top\": (int(top_col), (\"bot\", int(r - 1), list(range(int(c + 1), int(c + n - 1))))),\n        \"bot\": (int(bot_col), (\"top\", int(r + n), list(range(int(c + 1), int(c + n - 1))))),\n        \"left\": (int(left_col), (\"right\", int(c - 1), list(range(int(r + 1), int(r + n - 1))))),\n        \"right\": (int(right_col), (\"left\", int(c + n), list(range(int(r + 1), int(r + n - 1))))),\n    }\n\n    for _side, (col, (need_edge, fixed, span)) in segs.items():\n        col = int(col)\n        m = (g == int(col)) & (~hub_mask)\n        if not bool(m.any()):\n            continue\n\n        # Sprites can be only diagonally connected (e.g. V-shapes), so extract with 8-connectivity.\n        labc, nc = label_mask(m, connectivity=8)\n        best_id = None\n        best_sz = -1\n        for cid in range(1, int(nc) + 1):\n            sz = int((labc == int(cid)).sum())\n            if sz > best_sz:\n                best_sz = sz\n                best_id = int(cid)\n        if best_id is None or best_sz <= 0:\n            continue\n\n        spr_mask = labc == int(best_id)\n        spr_arr = g.copy()\n        spr_arr[~spr_mask] = int(bg)\n        spr_arr, spr_mask = _crop_to_mask(spr_arr, spr_mask)\n\n        found = None  # (a, msk, dr, dc)\n        for krot in range(4):\n            a = np.rot90(spr_arr, int(krot))\n            msk = np.rot90(spr_mask, int(krot))\n            a, msk = _crop_to_mask(a, msk)\n\n            # Attached sprite must be mirror-symmetric along the contact edge axis\n            if need_edge in (\"left\", \"right\"):\n                if not bool(np.array_equal(msk, np.flipud(msk))):\n                    continue\n            else:\n                if not bool(np.array_equal(msk, np.fliplr(msk))):\n                    continue\n\n            seg = _edge_segment(msk, need_edge)\n            if seg is None:\n                continue\n\n            if need_edge in (\"left\", \"right\"):\n                _typ, edge_c, rows = seg\n                if len(rows) != int(target) or not _is_contig(rows):\n                    continue\n                dr = int(span[0] - rows[0])\n                dc = int(fixed - edge_c)\n            else:\n                _typ, edge_r, cols = seg\n                if len(cols) != int(target) or not _is_contig(cols):\n                    continue\n                dr = int(fixed - edge_r)\n                dc = int(span[0] - cols[0])\n\n            placed = {(int(rr + dr), int(cc2 + dc)) for rr, cc2 in np.argwhere(msk)}\n            if any(not (0 <= R < H and 0 <= C < W) for R, C in placed):\n                continue\n\n            # ensure no conflicts with already-drawn hub (or previously placed sprites)\n            ok = True\n            for R, C in placed:\n                val = int(a[int(R - dr), int(C - dc)])\n                if val == int(bg):\n                    continue\n                if int(out[int(R), int(C)]) != int(bg) and int(out[int(R), int(C)]) != val:\n                    ok = False\n                    break\n            if not ok:\n                continue\n\n            found = (a, msk, int(dr), int(dc))\n            break\n\n        if found is None:\n            continue\n\n        a, msk, dr, dc = found\n        paste(out, a, int(dr), int(dc), mask=msk, overwrite=True, clip=True)\n\n    return out\n\n\n# ---------------------------------------------------------------------------\n# Generator\n# ---------------------------------------------------------------------------\n\nfrom scipy.ndimage import label as _label\n\ndef _make_sprite_mask(edge_len: int, side: str, rng: random.Random) -> np.ndarray | None:\n    \"\"\"\n    Constructively build a sprite mask in the attached orientation for `side`.\n    The mask is bool, 8-connected, has the correct symmetry and contact-edge length,\n    and exactly 1 rotation (out of 4) is a valid attachment for any hub side.\n\n    Strategy: build in canonical \"left-attach\" frame (flipud symmetric, contact on right col),\n    then rotate to the target side.\n    \"\"\"\n    # Build in \"left-attach\" frame: h rows, w cols.\n    # Right column = contact edge with exactly `edge_len` contiguous filled cells.\n    # flipud symmetric (rows mirror top-to-bottom).\n    # h > w ensures not square, breaking 90-degree rotation ambiguity.\n    # Also ensure NOT fliplr symmetric to prevent the complementary side matching.\n    e = edge_len  # = 2 for N=4\n    h = rng.choice([3, 4])  # height: 3 or 4 (must be > e to break symmetry)\n    w = rng.randint(2, 4)   # width: 2-4 (cols including the contact column)\n\n    half_h = (h + 1) // 2  # rows to decide (rest mirrored vertically)\n\n    for _attempt in range(100):\n        grid = np.zeros((h, w), dtype=bool)\n\n        # Contact edge: rightmost column, middle `e` rows filled, rest empty.\n        # For flipud symmetry with h=3 or h=4 and e=2:\n        #   h=3: rows 0,2 empty; row 1 filled -> only 1 contiguous. No good.\n        #   Actually for h=4, e=2: rows 1,2 filled (symmetric pair). Contact = [F,T,T,F]\n        #   For h=3, e=2: rows 0,2 mirrored. If row 0=T, row 2=T, row 1=T -> 3 contig.\n        #                  If row 0=F, row 2=F, row 1=T -> 1 contig. Not enough.\n        #                  Need to allow row0=T,row1=T,row2=T -> 3 != e.\n        # So for h=3, e=2 the rightmost col can't have exactly 2 contiguous cells\n        # with flipud symmetry. Let me think differently.\n\n        # The contact edge doesn't have to span the full height. It's the N-2 contiguous\n        # cells on the attachment side. For \"left-attach\", the solver checks the RIGHT edge\n        # of the cropped sprite: exactly e contiguous filled cells.\n\n        # Build each row from right to left. Rightmost col is the contact column.\n        # For flipud symmetry, row[i] mirrors row[h-1-i].\n        # Decide top half, mirror to bottom.\n\n        for ri in range(half_h):\n            mirror_ri = h - 1 - ri\n            for ci in range(w):\n                if ci == w - 1:\n                    # Contact column: fill rows that form the contiguous e-block\n                    # Place the e-block centered. For h=4,e=2: rows 1,2. For h=3,e=2: impossible with strict flipud.\n                    # Instead: just decide freely and check later\n                    val = rng.random() < 0.5\n                else:\n                    val = rng.random() < 0.5\n                grid[ri, ci] = val\n                grid[mirror_ri, ci] = val\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/291dc1e1.py\"","aggregated_output":"from __future__ import annotations\nimport numpy as np\nfrom arc_utils import bbox_coords, components_mask, crop_bbox, get_bg, paste, random_free_location\nfrom arc_utils import paste\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Reorder and stack rectangles by proximity to two colored edge lines.\n\n    Input structure:\n    - bg = most common color.\n    - Two edge lines (h + v) meet at a corner marked by a unique color.\n    - \"Blue\" line is color 1 if present, else the longer line; other is \"red.\"\n    - Solid rectangles in the interior.\n\n    Rule:\n    - Sort rectangles by (distance to blue edge, distance to red edge).\n    - If the blue edge is vertical, rotate each rectangle 90° CCW.\n    - Stack top-to-bottom, centered horizontally.\n\n    Key insight: Edge-line colors encode a coordinate system; proximity to each axis determines stacking order and rotation.\n    \"\"\"\n    g = np.array(grid, dtype=int)\n    H, W = g.shape\n    bg = int(get_bg(g))\n\n    # --- locate the marked corner ---\n    corners = [(0, 0), (0, int(W - 1)), (int(H - 1), 0), (int(H - 1), int(W - 1))]\n    corner = None\n    for r, c in corners:\n        if int(g[r, c]) == int(bg):\n            continue\n        nbr = []\n        if r == 0:\n            nbr.append(int(g[r + 1, c]))\n        if r == H - 1:\n            nbr.append(int(g[r - 1, c]))\n        if c == 0:\n            nbr.append(int(g[r, c + 1]))\n        if c == W - 1:\n            nbr.append(int(g[r, c - 1]))\n        if nbr and all(int(n) != int(g[r, c]) for n in nbr):\n            corner = (int(r), int(c))\n            break\n    assert corner is not None\n\n    cr, cc = map(int, corner)\n    marker = int(g[cr, cc])\n\n    # --- line colors adjacent to the corner ---\n    hstep = 1 if cc == 0 else -1\n    vstep = 1 if cr == 0 else -1\n    hcol = int(g[cr, cc + hstep])\n    vcol = int(g[cr + vstep, cc])\n\n    # Choose \"blue\" line color.\n    if hcol == 1 or vcol == 1:\n        blue_col = 1\n        red_col = int(vcol if hcol == 1 else hcol)\n    else:\n        # Fallback: longer line is blue.\n        hlen = 0\n        c = int(cc + hstep)\n        while 0 <= c < W and int(g[cr, c]) == int(hcol):\n            hlen += 1\n            c += int(hstep)\n        vlen = 0\n        r = int(cr + vstep)\n        while 0 <= r < H and int(g[r, cc]) == int(vcol):\n            vlen += 1\n            r += int(vstep)\n        if vlen >= hlen:\n            blue_col = int(vcol)\n            red_col = int(hcol)\n        else:\n            blue_col = int(hcol)\n            red_col = int(vcol)\n\n    blue_orient = \"h\" if int(hcol) == int(blue_col) else \"v\"\n    red_orient = \"h\" if int(hcol) == int(red_col) else \"v\"\n\n    # --- mask out the two edge lines (entire corner row + col) ---\n    line_mask = np.zeros((H, W), dtype=bool)\n    line_mask[cr, :] = True\n    line_mask[:, cc] = True\n\n    # --- extract solid rectangles (no bg inside bbox) ---\n    mask = (g != int(bg)) & (~line_mask) & (g != int(marker))\n    rects = []\n    for coords in components_mask(mask, connectivity=4):\n        if coords.size == 0:\n            continue\n        b = bbox_coords(coords)\n        sub = crop_bbox(g, b)\n        if bool((sub == int(bg)).any()):\n            continue\n        rects.append({\"box\": tuple(map(int, b)), \"arr\": sub.copy()})\n\n    assert not (not rects)\n\n    def dist_to_edge(rect: dict, orient: str, edge_idx: int) -> int:\n        r0, c0, r1, c1 = map(int, rect[\"box\"])\n        if orient == \"v\":\n            col = int(edge_idx)\n            if int(c0) > col:\n                return int(c0 - col - 1)\n            if int(c1) < col:\n                return int(col - c1 - 1)\n            return 0\n        row = int(edge_idx)\n        if int(r0) > row:\n            return int(r0 - row - 1)\n        if int(r1) < row:\n            return int(row - r1 - 1)\n        return 0\n\n    blue_edge_idx = int(cc if blue_orient == \"v\" else cr)\n    red_edge_idx = int(cc if red_orient == \"v\" else cr)\n\n    def along_from_corner(rect: dict, orient: str) -> int:\n        r0, c0, r1, c1 = map(int, rect[\"box\"])\n        if orient == \"v\":\n            return int(r0 if cr == 0 else -r1)\n        return int(c0 if cc == 0 else -c1)\n\n    for rct in rects:\n        rct[\"db\"] = int(dist_to_edge(rct, blue_orient, blue_edge_idx))\n        rct[\"dr\"] = int(dist_to_edge(rct, red_orient, red_edge_idx))\n\n    rects.sort(\n        key=lambda r: (\n            int(r[\"db\"]),\n            int(r[\"dr\"]),\n            along_from_corner(r, blue_orient),\n            along_from_corner(r, red_orient),\n        )\n    )\n\n    # Rotate all rectangles if blue edge is vertical.\n    seq = []\n    for rct in rects:\n        a = rct[\"arr\"]\n        if blue_orient == \"v\":\n            a = np.rot90(a, k=1)  # CCW\n        seq.append(a)\n\n    outW = int(max(int(a.shape[1]) for a in seq))\n    outH = int(sum(int(a.shape[0]) for a in seq))\n    out = np.full((outH, outW), int(bg), dtype=int)\n\n    out_r = 0\n    for a in seq:\n        h, w = map(int, a.shape)\n        out_c = int((outW - w) // 2)\n        paste(out, a, int(out_r), int(out_c))\n        out_r += int(h)\n\n    return out\n\n# --------------- generator (attempt 3, Codex) ---------------\n\nBG = 8\nBLUE = 1\nRED = 2\nMARKER = 0\nDOMINANT_COLORS = np.array([3, 4, 5, 6, 7, 9], dtype=int)\nMINORITY_COLORS = np.array([1, 2, 3, 4, 5, 6, 7, 9], dtype=int)\n\n\ndef _transform(grid: np.ndarray, blue_orient: str, corner: str) -> np.ndarray:\n    if blue_orient == \"h\":\n        if corner == \"tl\":\n            return grid\n        if corner == \"tr\":\n            return np.fliplr(grid)\n        if corner == \"bl\":\n            return np.flipud(grid)\n        return np.rot90(grid, 2)\n\n    base = np.rot90(grid, 1)\n    if corner == \"bl\":\n        return base\n    if corner == \"tl\":\n        return np.flipud(base)\n    if corner == \"tr\":\n        return np.rot90(grid, 3)\n    return np.flipud(np.rot90(grid, 3))\n\n\ndef _distribute_band_widths(count: int, used_target: int) -> list[int]:\n    extra_units = (used_target - (4 * count - 2)) // 2\n    order = np.random.permutation(count)\n    units = np.zeros(count, dtype=int)\n    remaining = int(extra_units)\n    for i, idx in enumerate(order):\n        slots_left = count - i - 1\n        lo = max(0, remaining - 3 * slots_left)\n        hi = min(3, remaining)\n        take = int(np.random.randint(lo, hi + 1))\n        units[int(idx)] = take\n        remaining -= take\n    return [2 + 2 * int(u) for u in units]\n\n\ndef _sprinkle_minorities(patch: np.ndarray, dominant: int) -> np.ndarray:\n    area = int(patch.size)\n    if area < 8 or np.random.rand() < 0.6:\n        return patch\n\n    max_minor = min(3, area // 4)\n    if max_minor < 2:\n        return patch\n\n    n_minor = int(np.random.randint(2, max_minor + 1))\n    n_colors = int(np.random.randint(1, min(2, n_minor) + 1))\n    minority_choices = [int(c) for c in MINORITY_COLORS if int(c) != dominant]\n    colors = np.random.choice(minority_choices, size=n_colors, replace=False)\n    cells = np.random.choice(area, size=n_minor, replace=False)\n    flat = patch.reshape(-1)\n    for idx, cell in enumerate(cells):\n        flat[int(cell)] = int(colors[idx % n_colors])\n    return patch\n\n\ndef _build_canonical() -> np.ndarray:\n    long_dim = int(np.random.randint(9, 29))\n    options = []\n    for trailing in (1, 2):\n        max_used = long_dim - 2 - trailing\n        if max_used < 6 or max_used % 2:\n            continue\n        max_count = min(5, (max_used + 2) // 4)\n        pairs = []\n        for a in range(2, max_count + 1):\n            for b in range(2, max_count + 1):\n                if a + b > 9:\n                    continue\n                eligible = []\n                if max_used <= 10 * a - 2:\n                    eligible.append(0)\n                if max_used <= 10 * b - 2:\n                    eligible.append(1)\n                if eligible:\n                    pairs.append((a, b, eligible))\n        if pairs:\n            options.append((max_used, pairs))\n\n    max_used, pairs = options[int(np.random.randint(len(options)))]\n    n0, n1, eligible = pairs[int(np.random.randint(len(pairs)))]\n    max_band = int(np.random.choice(eligible))\n    max0 = min(max_used, 10 * n0 - 2)\n    max1 = min(max_used, 10 * n1 - 2)\n    used0 = int(max_used if max_band == 0 else np.random.choice(np.arange(4 * n0 - 2, max0 + 1, 2)))\n    used1 = int(max_used if max_band == 1 else np.random.choice(np.arange(4 * n1 - 2, max1 + 1, 2)))\n    band0 = _distribute_band_widths(n0, used0)\n    band1 = _distribute_band_widths(n1, used1)\n\n    grid = np.full((8, long_dim), BG, dtype=int)\n    grid[0, :] = BLUE\n    grid[:, 0] = RED\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /home/lixinyu/snap/new/ARC_code/eval/88e364bc.py\"","aggregated_output":"import numpy as np\n\nfrom arc_utils import bbox_coords, components_mask, get_bg, neighbors4\n\n\ndef _legend_directions(g: np.ndarray, bg: int) -> dict[int, tuple[int, int]]:\n    \"\"\"\n    Detect legend blocks on the border.\n\n    A legend is a border-touching non-background component whose most common color is the legend\n    background `C` (and also the region border color it controls). The legend contains at least\n    two additional colors: a \"center\" color (more frequent) and an \"indicator\" color (less frequent).\n\n    The movement direction for regions with border color `C` is:\n      sign(centroid(indicator) - centroid(center))\n    \"\"\"\n    h, w = g.shape\n    non_bg = g != bg\n    best: dict[int, tuple[int, tuple[int, int]]] = {}\n    for pts in components_mask(non_bg, connectivity=4):\n        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue\n        # Legends are filled rectangles on the border.\n        r0, c0, r1, c1 = bbox_coords(pts)\n        area = (r1 - r0 + 1) * (c1 - c0 + 1)\n        if area != len(pts):\n            continue\n\n        counts: dict[int, int] = {}\n        for r, c in pts:\n            v = int(g[r, c])\n            counts[v] = counts.get(v, 0) + 1\n        if len(counts) != 3:\n            continue\n\n        bg_col = max(counts, key=counts.get)\n        others = [(cnt, col) for col, cnt in counts.items() if col != bg_col]\n        if len(others) < 2:\n            continue\n        others.sort()  # ascending by count\n        if others[0][0] == others[1][0]:\n            # Tie: choose center as the color closer to the rectangle center.\n            rc = np.array([(r0 + r1) / 2.0, (c0 + c1) / 2.0])\n            cols = [others[0][1], others[1][1]]\n            cents = []\n            for col in cols:\n                pts_col = np.array([(r, c) for r, c in pts if int(g[r, c]) == col], dtype=float)\n                cents.append((np.sum((pts_col.mean(axis=0) - rc) ** 2), col))\n            cents.sort()\n            center_col = cents[0][1]\n            indicator_col = cents[1][1]\n        else:\n            indicator_col = others[0][1]\n            center_col = others[-1][1]\n\n        center = [(r, c) for r, c in pts if int(g[r, c]) == center_col]\n        indic = [(r, c) for r, c in pts if int(g[r, c]) == indicator_col]\n        if not center or not indic:\n            continue\n\n        cc = np.mean(np.array(center, dtype=float), axis=0)\n        ci = np.mean(np.array(indic, dtype=float), axis=0)\n        vr, vc = (ci - cc).tolist()\n        dr = 0 if abs(vr) < 1e-6 else (1 if vr > 0 else -1)\n        dc = 0 if abs(vc) < 1e-6 else (1 if vc > 0 else -1)\n        if dr == 0 and dc == 0:\n            continue\n\n        prev = best.get(bg_col)\n        if prev is None or len(pts) > prev[0]:\n            best[bg_col] = (len(pts), (dr, dc))\n\n    return {k: v for k, (_, v) in best.items()}\n\n\ndef _slide_points(region_set: set[tuple[int, int]], points: list[tuple[int, int]], dr: int, dc: int) -> list[tuple[int, int]]:\n    if not points:\n        return []\n    # Process from the far end (closest to destination boundary) inward.\n    points_sorted = sorted(points, key=lambda p: (dr * p[0] + dc * p[1], p[0], p[1]), reverse=True)\n    occupied = set()\n    out_pts = []\n    for r0, c0 in points_sorted:\n        r, c = r0, c0\n        while True:\n            nr, nc = r + dr, c + dc\n            if (nr, nc) not in region_set:\n                break\n            # For diagonal steps, disallow \"corner cutting\": both orthogonal intermediates must be inside the region.\n            if dr != 0 and dc != 0:\n                if (r + dr, c) not in region_set or (r, c + dc) not in region_set:\n                    break\n            if (nr, nc) in occupied:\n                break\n            r, c = nr, nc\n        occupied.add((r, c))\n        out_pts.append((r, c))\n    return out_pts\n\n\ndef main(grid: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.\n\n    Input structure:\n    - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.\n    - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.\n\n    Rule:\n    - For each enclosed region, identify its border color C and look up the legend with fill color C.\n    - The direction from the legend's center dot to its indicator dot gives the slide direction.\n    - All yellow pixels in that region slide in that direction, stacking against the far wall.\n\n    Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.\n    \"\"\"\n    g = np.asarray(grid, dtype=int)\n    h, w = g.shape\n    bg = get_bg(g)\n\n    mover = 4  # yellow in ARC\n    dirs = _legend_directions(g, bg)\n    assert dirs, \"legend_directions must find at least one legend; grid should always have border legends\"\n\n    passable = (g == bg) | (g == mover)\n    out = g.copy()\n\n    # Find enclosed passable regions (not connected to the outer border).\n    for pts in components_mask(passable, connectivity=4):\n        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):\n            continue  # outside background\n\n        movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]\n        if not movers:\n            continue\n\n        # Determine this region's border color by counting adjacent wall colors.\n        border_counts: dict[int, int] = {}\n        pset = {(int(r), int(c)) for r, c in pts}\n        for r, c in pts:\n            for nr, nc in neighbors4(r, c):\n                if not (0 <= nr < h and 0 <= nc < w):\n                    continue\n                if (nr, nc) in pset:\n                    continue\n                v = int(g[nr, nc])\n                if v == bg or v == mover:\n                    continue\n                border_counts[v] = border_counts.get(v, 0) + 1\n        if not border_counts:\n            continue\n        border_col = max(border_counts, key=border_counts.get)\n        if border_col not in dirs:\n            continue\n        dr, dc = dirs[border_col]\n\n        # Clear old movers.\n        for r, c in movers:\n            out[r, c] = bg\n\n        # Slide and repaint.\n        new_pts = _slide_points(pset, movers, dr, dc)\n        for r, c in new_pts:\n            out[r, c] = mover\n\n    return out\n\n# --------------- generator (claude-att1) ---------------\n\n\"\"\"Generator for task 88e364bc (slide yellow in walled regions by legend arrows).\"\"\"\nimport random\nimport numpy as np\n\nfrom arc_utils import label_mask, neighbors4, paste\n\n# ── Configuration ─────────────────────────────────────────────────\nGRID_H, GRID_W = 20, 20\n\n# Legend\nCARDINAL_DIRS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\nDIAGONAL_DIRS = [(1, 1), (1, -1), (-1, 1), (-1, -1)]\nCORNERS = ['TL', 'TR', 'BL', 'BR']\nWALL_COLOR_CHOICES = [3, 5, 6, 7, 8, 9]  # non-{0 bg, 1 center, 2 indicator, 4 yellow}\nCARDINAL_PROB = 0.5                        # probability each legend is cardinal (vs diagonal)\nLEGEND_BUFFER = 1                          # cells of padding around legend patches\n\n# Regions\nREGIONS_PER_COLOR = (1, 3)                 # min, max regions per wall color\nMAX_TOTAL_REGIONS = 4                      # hard cap to fit in 20x20\nREGION_SIZE_BOUNDS = {                     # {n_regions: (min_size, max_size)}\n    1: (15, 85), 2: (15, 55), 3: (12, 35), 4: (12, 25),\n}\nBLOB_GROW_RETRIES = 25                     # attempts to grow a valid blob per region\n\n# Yellows\nYELLOWS_PER_REGION = [1, 2]                # choices per region\nMAX_SLIDE_STEPS = 5                        # reverse-slide distance range [1, MAX]\n\n# Outer loop\nGEN_RETRIES = 300                          # max attempts in generate_input()\n\n\n# ── Legend patches ────────────────────────────────────────────────\n\ndef _legend_5x5(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"5x5 cardinal legend. Canonical direction: (0, +1) right.\"\"\"\n    g = np.full((5, 5), fill, dtype=int)\n    g[1, 1] = 1; g[1, 2] = 1; g[1, 3] = 2\n    g[3, 1] = 1; g[3, 2] = 1; g[3, 3] = 2\n    rot = {(0, 1): 0, (-1, 0): 1, (0, -1): 2, (1, 0): 3}\n    return np.rot90(g, rot[(dr, dc)])\n\n\ndef _legend_6x7(fill: int, dr: int, dc: int) -> np.ndarray:\n    \"\"\"6x7 diagonal legend. Canonical direction: (+1, +1) down-right.\"\"\"\n    g = np.full((6, 7), fill, dtype=int)\n    g[1, 3] = 1\n    g[2, 1] = 1; g[2, 4] = 1\n    g[3, 2] = 1; g[3, 5] = 2\n    g[4, 3] = 2\n    if (dr, dc) == (1, 1): return g\n    if (dr, dc) == (-1, 1): return np.flipud(g)\n    if (dr, dc) == (1, -1): return np.fliplr(g)\n    if (dr, dc) == (-1, -1): return np.rot90(g, 2)\n    raise ValueError((dr, dc))\n\n\ndef _corner_origin(corner: str, h: int, w: int, ph: int, pw: int) -> tuple[int, int]:\n    \"\"\"Top-left coordinate for a patch placed at the given grid corner.\"\"\"\n    if corner == 'TL': return 0, 0\n    if corner == 'TR': return 0, w - pw\n    if corner == 'BL': return h - ph, 0\n    if corner == 'BR': return h - ph, w - pw\n    raise ValueError(corner)\n\n\n# ── Blob growing / topology ──────────────────────────────────────\n\ndef _grow_blob(canvas_mask: np.ndarray, seed: tuple[int, int], target_size: int,\n               rng: random.Random) -> set[tuple[int, int]] | None:\n    \"\"\"Random-walk growth of a 4-connected blob on free cells.\"\"\"\n    h, w = canvas_mask.shape\n    sr, sc = seed\n    if not canvas_mask[sr, sc]:\n        return None\n    blob = {(sr, sc)}\n    frontier = []\n    def push_neighbors(r, c):\n        for nr, nc in neighbors4(r, c):\n            if 0 <= nr < h and 0 <= nc < w and canvas_mask[nr, nc] and (nr, nc) not in blob:\n                frontier.append((nr, nc))\n    push_neighbors(sr, sc)\n    while len(blob) < target_size and frontier:\n        idx = rng.randrange(len(frontier))\n        r, c = frontier.pop(idx)\n        if (r, c) in blob or not canvas_mask[r, c]:\n            continue\n        blob.add((r, c))\n        push_neighbors(r, c)\n    if len(blob) < target_size:\n        return None\n","exit_code":0,"status":"completed"}}
