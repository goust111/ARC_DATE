olor, pos in anchors_by_color.items():\n            base = None\n            for _ in range(80):\n                cand = mod._random_fragment_template(rng, len(pos), color, mod._ACCENT_POOL)\n                cand = np.rot90(cand, rng.randrange(4))\n                if mod._count_color_boundary_cells(cand, int(color)) == len(pos):\n                    base = cand\n                    break\n            if base is None:\n                ok = False\n                break\n            if not mod._place_fragment_outside(rng, grid, used, base, forbidden):\n                ok = False\n                break\n\n        if ok:\n            try:\n                out = mod.main(grid)\n            except Exception as e:\n                # debug this seed once\n                print('\"'seed', seed, 'reason', type(e).__name__, e)\n                print('frame', (r0, c0, r1, c1), 'piece_colors', piece_colors)\n                bg = mod._get_bg(grid)\n                fc,bbox = mod._detect_frame(grid)\n                anchors = mod._collect_anchor_cells(grid,bg,bbox)\n                anchors = {k:v for k,v in anchors.items() if 1 < len(v) < 4}\n                print('anchors', {k:len(v) for k,v in anchors.items()})\n                \n                # components diagnostics\n                r0, c0, r1, c1 = bbox\n                frame_mask=np.zeros_like(grid,dtype=bool)\n                frame_mask[r0, c0:c1+1] = True\n                frame_mask[r1, c0:c1+1] = True\n                frame_mask[r0:r1+1, c0] = True\n                frame_mask[r0:r1+1, c1] = True\n                fragment_mask = (grid \"'!= bg) & (~frame_mask)\n                for col, pts in anchors.items():\n                    for r, c in pts:\n                        fragment_mask[int(r), int(c)] = False\n                for comp in mod.components_mask(fragment_mask, connectivity=4):\n                    comp = np.asarray(comp)\n                    colors = sorted(set(int(grid[r,c]) for r,c in comp))\n                    comp_set = {(int(r),int(c)) for r,c in comp}\n                    bcolors = mod._boundary_colors(grid, comp, comp_set)\n                    matches = [c for c in colors if c in anchors]\n                    print('\"' comp size', len(comp), 'colors', colors, 'boundary', sorted(bcolors), 'matches', matches)\n                    if len(matches)==1:\n                        iface = matches[0]\n                        piece = mod._crop_piece(grid, comp, bg)\n                        res = mod._place_piece_inside(piece, iface, set(anchors[iface]), r0+1,c0+1,r1-1,c1-1,bg, np.zeros_like(grid,dtype=bool))\n                        print('  place', iface, res is not None)\n                break\nprint('done')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
