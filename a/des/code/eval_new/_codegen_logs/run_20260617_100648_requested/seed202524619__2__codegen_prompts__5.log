{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, numpy as np\nfrom importlib.machinery import SourceFileLoader\nfrom collections import Counter\nmod = SourceFileLoader('m', '/home/lixinyu/snap/a/des/code/eval_new/seed202524619/2/5.py').load_module()\n\n\ndef one(seed):\n    rng = random.Random(seed)\n    H = int(rng.randint(16,30)); W = int(rng.randint(16,30))\n    grid = np.full((H, W), mod._BG, dtype=int)\n    max_frame_h=min(H-4,24); max_frame_w=min(W-4,24)\n    if max_frame_h < 9 or max_frame_w < 9:\n        return 'frame_limit'\n    frame_h = int(rng.randint(9,max_frame_h)); frame_w = int(rng.randint(9,max_frame_w))\n    r0 = int(rng.randint(2,H-frame_h-1)); c0 = int(rng.randint(2,W-frame_w-1))\n    r1,c1=r0+frame_h-1,c0+frame_w-1\n    if r1 >= H or c1 >= W or frame_h < 9 or frame_w < 9:\n        return 'frame_bad'\n    mod._paint_frame(grid,r0,c0,r1,c1)\n    used_anchor_colors=list(mod._ANCHOR_POOL); rng.shuffle(used_anchor_colors)\n    piece_count = int(rng.choice([2,2,3,3,4]))\n    piece_colors = used_anchor_colors[:piece_count]\n\n    anchors_by_color={}\n    used_anchor_cells=set()\n    sides=[\\\"top\\\",\\\"bottom\\\",\\\"left\\\",\\\"right\\\"]\n    for color in piece_colors:\n        side=rng.choice(sides)\n        count=int(rng.choice([2,3]))\n        pos = mod._anchor_positions_for_side(rng, side,(r0,c0,r1,c1),count)\n        if len(pos)\"'!=count:\n            return '\"'anchor_slots'\n        if any((int(r),int(c)) in used_anchor_cells for r,c in pos):\n            return 'anchor_overlap'\n        anchors_by_color[int(color)] = pos\n        used_anchor_cells.update((int(r),int(c)) for r,c in pos)\n        for r,c in pos:\n            grid[int(r), int(c)] = int(color)\n\n    forbidden=np.zeros((H,W),dtype=bool)\n    fr0=max(0,r0-1); fr1=min(H-1,r1+1); fc0=max(0,c0-1); fc1=min(W-1,c1+1)\n    forbidden[fr0:fr1+1,fc0:fc1+1]=True\n    used=np.zeros((H,W),dtype=bool)\n    used[r0:r1+1,c0:c1+1]=True\n\n    for color,pos in anchors_by_color.items():\n        base=None\n        for _ in range(80):\n            cand = mod._random_fragment_template(rng,len(pos),color,mod._ACCENT_POOL)\n            cand = np.rot90(cand, rng.randrange(4))\n            if mod._count_color_boundary_cells(cand,int(color)) == len(pos):\n                base = cand\n                break\n        if base is None:\n            return 'boundary_fail'\n        if not mod._place_fragment_outside(rng, grid, used, base, forbidden):\n            return 'place_fragment'\n\n    if not np.any((grid \"'!= mod._BG) & (~forbidden)):\n        return '\"'no_outer'\n\n    try:\n        mod.main(grid)\n    except Exception as e:\n        return f'main_err:{type(e).__name__}:{e}'\n\n    if grid.shape \"'!= (H,W):\n        return '\"'shape_bad'\n    return 'ok'\n\ncounter=Counter()\nfor seed in range(2000):\n    r = one(seed)\n    counter[r]+=1\n    if r=='ok':\n        print('first ok',seed)\n        break\nprint(counter.most_common(10))\nprint('ok',counter['ok'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
