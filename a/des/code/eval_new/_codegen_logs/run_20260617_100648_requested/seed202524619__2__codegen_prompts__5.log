372\t    frame_bbox: tuple[int, int, int, int],\n   373\t    count: int,\n   374\t) -> list[tuple[int, int]]:\n   375\t    r0, c0, r1, c1 = frame_bbox\n   376\t    if side == \"top\":\n   377\t        max_start = max(c0 + 1, c1 - 1 - count)\n   378\t        if max_start < c0 + 1:\n   379\t            return []\n   380\t        c = rng.randint(c0 + 1, max_start)\n   381\t        return [(r0 + 1, int(c + i)) for i in range(count)]\n   382\t    if side == \"bottom\":\n   383\t        max_start = max(c0 + 1, c1 - 1 - count)\n   384\t        if max_start < c0 + 1:\n   385\t            return []\n   386\t        c = rng.randint(c0 + 1, max_start)\n   387\t        return [(r1 - 1, int(c + i)) for i in range(count)]\n   388\t    if side == \"left\":\n   389\t        max_start = max(r0 + 1, r1 - 1 - count)\n   390\t        if max_start < r0 + 1:\n   391\t            return []\n   392\t        r = rng.randint(r0 + 1, max_start)\n   393\t        return [(int(r + i), c0 + 1) for i in range(count)]\n   394\t    if side == \"right\":\n   395\t        max_start = max(r0 + 1, r1 - 1 - count)\n   396\t        if max_start < r0 + 1:\n   397\t            return []\n   398\t        r = rng.randint(r0 + 1, max_start)\n   399\t        return [(int(r + i), c1 - 1) for i in range(count)]\n   400\t    raise ValueError(side)\n   401\t\n   402\t\n   403\tdef _random_fragment_template(\n   404\t    rng: random.Random,\n   405\t    anchor_len: int,\n   406\t    anchor_color: int,\n   407\t    accent_colors: tuple[int, ...],\n   408\t) -> np.ndarray:\n   409\t    h = rng.randint(3, 6)\n   410\t    w = rng.randint(max(3, anchor_len + 1), 7)\n   411\t    w = max(anchor_len + 2, w)\n   412\t\n   413\t    top_start = rng.randint(1, w - anchor_len - 1)\n   414\t    anchor_cols = list(range(top_start, top_start + anchor_len))\n   415\t\n   416\t    template = np.full((h, w), _BG, dtype=int)\n   417\t    template[0, anchor_cols] = anchor_color\n   418\t\n   419\t    cells: set[tuple[int, int]] = set((0