ontinue\n   191\t\n   192\t        fill_local = np.argwhere(cand != int(bg))\n   193\t        ph, pw = cand.shape\n   194\t\n   195\t        # Ensure piece can possibly fit in interior.\n   196\t        if ph > ir1 - ir0 + 1 or pw > ic1 - ic0 + 1:\n   197\t            continue\n   198\t\n   199\t        for tr in range(ir0, ir1 - ph + 2):\n   200\t            for tc in range(ic0, ic1 - pw + 2):\n   201\t                final_cells = [(int(r + tr), int(c + tc)) for r, c in fill_local]\n   202\t                ok = True\n   203\t                for fr, fc in final_cells:\n   204\t                    if occupied[fr, fc]:\n   205\t                        ok = False\n   206\t                        break\n   207\t                if not ok:\n   208\t                    continue\n   209\t\n   210\t                touched: set[tuple[int, int]] = set()\n   211\t                all_matched = True\n   212\t                for r, c in anchors_local:\n   213\t                    ar, ac = int(r) + tr, int(c) + tc\n   214\t                    matched_here = False\n   215\t                    for dr, dc in _NEIGHBORS4:\n   216\t                        nr, nc = ar + dr, ac + dc\n   217\t                        if (int(nr), int(nc)) in wall_anchors:\n   218\t                            touched.add((int(nr), int(nc)))\n   219\t                            matched_here = True\n   220\t                    if not matched_here:\n   221\t                        all_matched = False\n   222\t                        break\n   223\t\n   224\t                if not all_matched:\n   225\t                    continue\n   226\t                if touched != wall_anchors:\n   227\t                    continue\n   228\t\n   229\t                return cand, tr, tc\n   230\t\n   231\t    return None\n   232\t\n   233\t\n   234\tdef main(grid: np.ndarray) -> np.ndarray:\n   235\t    \"\"\"Insert irregular colored fragments into a hollow frame by anchor-matching its wall colors.\n   236\t\n   237\t    In