{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random, numpy as np\nfrom importlib.machinery import SourceFileLoader\n\nmod = SourceFileLoader('m', '/home/lixinyu/snap/a/des/code/eval_new/seed202524619/2/5.py').load_module()\n\nseed = 0\nrng = random.Random(seed)\nH = int(rng.randint(16,30)); W = int(rng.randint(16,30))\ngrid = np.full((H, W), mod._BG, dtype=int)\nmax_frame_h = min(H-4,24); max_frame_w = min(W-4,24)\nframe_h = int(rng.randint(9,max_frame_h)); frame_w = int(rng.randint(9,max_frame_w))\nr0=int(rng.randint(2,H-frame_h-1)); c0=int(rng.randint(2,W-frame_w-1))\nr1,c1=r0+frame_h-1,c0+frame_w-1\nmod._paint_frame(grid,r0,c0,r1,c1)\nused_anchor_colors=list(mod._ANCHOR_POOL); rng.shuffle(used_anchor_colors)\npiece_count = int(rng.choice([2,2,3,3,4]))\npiece_colors=used_anchor_colors[:piece_count]\nanchors_by_color={}\nused_anchor_cells=set()\nfor color in piece_colors:\n    side=rng.choice([\\\"top\\\",\\\"bottom\\\",\\\"left\\\",\\\"right\\\"])\n    count=int(rng.choice([2,3]))\n    pos = mod._anchor_positions_for_side(rng, side, (r0,c0,r1,c1), count)\n    for r,c in pos:\n        grid[r,c]=color\n    anchors_by_color[color]=pos\n    used_anchor_cells.update(pos)\n\nforbidden=np.zeros((H,W),dtype=bool)\nfr0=max(0,r0-1); fr1=min(H-1,r1+1); fc0=max(0,c0-1); fc1=min(W-1,c1+1)\nforbidden[fr0:fr1+1,fc0:fc1+1]=True\nused=np.zeros((H,W),dtype=bool)\nused[r0:r1+1,c0:c1+1]=True\n\nprint('frame', (r0,c0,r1,c1), 'piece_colors', piece_colors)\nprint('anchors', {k:len(v) for k,v in anchors_by_color.items()})\n\npieces = []\nfor color,pos in anchors_by_color.items():\n    chosen=None\n    for _ in range(80):\n        cand = mod._random_fragment_template(rng,len(pos),color,mod._ACCENT_POOL)\n        cand = np.rot90(cand,rng.randrange(4))\n        if mod._count_color_boundary_cells(cand, int(color)) == len(pos):\n            chosen = cand\n            break\n    if chosen is None:\n        print('no boundary piece for', color)\n        continue\n    print('color',color,'piece shape', chosen.shape,'anchor boundary',mod._count_color_boundary_cells(chosen,color),'local anchors',np.argwhere(chosen==int(color)).tolist())\n    pieces.append((color, chosen))\n    mod._place_fragment_outside(rng, grid, used, chosen, forbidden)\n\n# now inspect main internals\nbg=mod._get_bg(grid)\ntry:\n    fc,bbox=mod._detect_frame(grid)\nexcept Exception as e:\n    print('detect fail', e)\n    raise\nprint('detected frame',fc,bbox)\nanchors = mod._collect_anchor_cells(grid, bg, bbox)\nanchors={k:[tuple(x) for x in v] for k,v in anchors.items() if 1 < len(v) <4}\nprint('anchors used', {k:len(v) for k,v in anchors.items()})\nframe_mask=np.zeros_like(grid,dtype=bool)\nfr0,fc0,fr1,fc1=bbox\nframe_mask[fr0,fc0:fc1+1]=True; frame_mask[fr1,fc0:fc1+1]=True; frame_mask[fr0:fr1+1,fc0]=True; frame_mask[fr0:fr1+1,fc1]=True\nfragment_mask=(grid\"'!=bg)&(~frame_mask)\nfor c,pts in anchors.items():\n    for r,c2 in pts:\n        fragment_mask[int(r), int(c2)] = False\nfor comp in mod.components_mask(fragment_mask, connectivity=4):\n    comp=np.asarray(comp)\n    comp_set={(int(r),int(c)) for r,c in comp}\n    colors=set(int(grid[r,c]) for r,c in comp)\n    b=mod._boundary_colors(grid, comp, comp_set)\n    matches=[x for x in colors if x in anchors]\n    print('\"'comp',len(comp),'colors',sorted(colors),'boundary',sorted(b),'matches',sorted(matches))\n    for c in matches:\n        wall=set(anchors[c])\n        res = mod._place_piece_inside(mod._crop_piece(grid,comp,bg), c, wall, bbox[0]+1,bbox[1]+1,bbox[2]-1,bbox[3]-1,bg,np.zeros_like(grid,dtype=bool))\n        print('  iface',c,'place',res is not None)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
