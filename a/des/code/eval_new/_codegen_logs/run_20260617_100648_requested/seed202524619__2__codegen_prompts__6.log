for t in towers], r,c):\n                continue\n            color=random.choice(tower_colors)\n            towers.append({'r':r,'c':c,'color':int(color),'base':mod._BASE_COLOR})\n            placed=True\n            break\n        if not placed:\n            break\n\n    inp=np.full((play_h+1, play_w), mod._BG_COLOR, dtype=int)\n    for t in towers:\n        r=t['r']; c=t['c']\n        inp[r-1:r+2,c-1:c+2]=mod._BASE_COLOR\n        inp[r,c]=t['color']\n    inp[play_h,:]=mod._build_legend_row(play_w, legend_map, mod._BG_COLOR)\n\n    play=inp[:-1,:]\n    try:\n        found=mod._find_towers(play, mod._most_common_color(play))\n    except AssertionError as e:\n        print('trial',trial,'failure',str(e))\n        print('shape',play.shape,'bg',mod._most_common_color(play))\n        print('tower_colors',tower_colors)\n        print('pairs',known,unknown_pair)\n        print('tower count',len(towers))\n        # print centers and nearby map\n        for t in towers:\n            r=t['r'];c=t['c']\n            print('tower',r,c,t['color'])\n        # print candidate centers from detection quickly\n        h,w=play.shape\n        det=[]\n        for r in range(1,h-1):\n            for c in range(1,w-1):\n                if int(play[r,c])==mod._most_common_color(play):\n                    continue\n                patch=play[r-1:r+2,c-1:c+2]\n                if int(patch[1,1])==int(patch[0,0]):\n                    continue\n                base=int(patch[0,0])\n                m=np.ones((3,3),dtype=bool)\n                m[1,1]=False\n                if np.any(patch[m]\"'!=base):\n                    continue\n                det.append((r,c,int(play[r,c]),int(base),int(patch[0,0])))\n        print('\"'detected',len(det),det)\n        break\nelse:\n    print('no failure in 200')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
