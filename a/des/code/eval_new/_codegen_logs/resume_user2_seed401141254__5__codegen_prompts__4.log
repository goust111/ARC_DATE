+        dc = 0 if c0 == c1 else (1 if c1 > c0 else -1)
+        steps = max(abs(r1 - r0), abs(c1 - c0))
+        for step in range(steps + 1):
+            cell = (r0 + dr * step, c0 + dc * step)
+            if not cells or cell != cells[-1]:
+                cells.append(cell)
