+
+def _build_chain_scene(rng: random.Random) -> np.ndarray | None:
+    x_0 = rng.randint(5, 6)
+    x_2 = x_0 + rng.randint(8, 10)
+    x_4 = x_0 + rng.randint(3, 5)
