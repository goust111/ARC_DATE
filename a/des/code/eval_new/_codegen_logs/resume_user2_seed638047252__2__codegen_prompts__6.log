+    return expanded
+
+
+def _room_walls(
+    bbox: tuple[int, int, int, int], door_positions: set[tuple[int, int]]
+) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    walls: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        walls.add((r0, c))
+        walls.add((r1, c))
+    for r in range(r0 + 1, r1):
+        walls.add((r, c0))
+        walls.add((r, c1))
