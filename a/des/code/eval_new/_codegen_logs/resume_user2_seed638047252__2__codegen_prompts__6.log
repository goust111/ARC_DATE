+            irr = r - odr
+            icc = c - odc
+            orr = r + odr
+            occ = c + odc
+            if not (0 <= orr < h and 0 <= occ < w):
+                return None
+            if int(grid[irr, icc]) != bg:
+                return None
+            if int(grid[orr, occ]) == bg:
+                return None
+            doors.append(
