+        return "top"
+    if r == r1 and c0 < c < c1:
+        return "bottom"
+    if c == c0 and r0 < r < r1:
+        return "left"
+    if c == c1 and r0 < r < r1:
+        return "right"
+    return None
+
+
+def _path_cells_in_room(
+    bbox: tuple[int, int, int, int], door_pos: tuple[int, int], length: int
+) -> list[tuple[int, int]]:
