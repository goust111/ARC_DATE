+                return None
+            expected_bg.add((r, c))
+
+    doors: list[dict[str, object]] = []
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            on_border = r in (r0, r1) or c in (c0, c1)
+            if not on_border:
+                continue
+            is_corner = r in (r0, r1) and c in (c0, c1)
+            val = int(grid[r, c])
+            if is_corner:
+                if val != wall:
+                    return None
+                continue
+            if val == wall:
