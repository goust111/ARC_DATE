+import numpy as np
+
+
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+BG = 0
+BASE = 5
+PIECE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+GRID_H_RANGE = (16, 24)
+GRID_W_RANGE = (18, 30)
+PIECE_COUNT_RANGE = (3, 5)
