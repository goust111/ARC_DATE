+def _find_base(grid: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int], dict[int, int]]:
+    h, w = grid.shape
+    best = None
+    for color in map(int, np.unique(grid)):
+        if color == bg:
+            continue
+        for comp in _components(grid == color):
+            r0, c0, r1, c1 = _bbox(comp)
+            height = r1 - r0 + 1
+            width = c1 - c0 + 1
