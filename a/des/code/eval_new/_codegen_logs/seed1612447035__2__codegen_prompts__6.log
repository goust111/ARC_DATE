+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((int(cr), int(cc)))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _normalize(coords: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    r0 = min(r for r, _ in coords)
+    c0 = min(c for _, c in coords)
+    return {(r - r0, c - c0) for r, c in coords}
+
+
+def _mask_from_coords(coords: set[tuple[int, int]]) -> np.ndarray:
+    norm = _normalize(coords)
+    h = 1 + max(r for r, _ in norm)
+    w = 1 + max(c for _, c in norm)
+    patch = np.zeros((h, w), dtype=bool)
+    for r, c in norm:
+        patch[r, c] = True
+    return patch
