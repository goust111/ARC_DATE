+def _bottom_midpoint(coords: list[tuple[int, int]]) -> int:
+    bottom = max(r for r, _ in coords)
+    bottom_cols = [c for r, c in coords if r == bottom]
+    mid2 = min(bottom_cols) + max(bottom_cols)
