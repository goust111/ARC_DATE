+        pair_options = []
+        for col_a in usable:
+            for gap in range(1, max_gap + 1):
+                for sign in (-1, 1):
+                    col_b = col_a + sign * gap
+                    if col_b in usable and col_b != col_a:
+                        pair_options.append((col_a, col_b))
+        if not pair_options:
+            return None
+
+        for _ in range(120):
