+    wrapped = np.full((room_h, room_w), BLACK, dtype=int)
+    wrapped[0, :] = frame_color
+    wrapped[-1, :] = frame_color
+    wrapped[:, 0] = frame_color
+    wrapped[:, -1] = frame_color
+    wrapped[1:-1, 1:-1] = room
