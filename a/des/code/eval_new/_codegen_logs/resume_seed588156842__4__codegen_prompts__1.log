+    if h < 5 or w < 5:
+        return False
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return bool(np.all((patch == color) == border))
+
+
+def _find_room(panel: np.ndarray) -> tuple[tuple[int, int, int, int], int]:
