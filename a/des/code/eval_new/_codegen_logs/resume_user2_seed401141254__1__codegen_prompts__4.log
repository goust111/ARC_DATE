+    windows = []
+    per_side_positions: dict[str, list[int]] = {side: [] for side in ("top", "bottom", "left", "right")}
+
+    def add_window(side: str, r: int, c: int, marker_r: int, marker_c: int) -> bool:
+        if not (0 <= marker_r < grid.shape[0] and 0 <= marker_c < grid.shape[1]):
+            return False
