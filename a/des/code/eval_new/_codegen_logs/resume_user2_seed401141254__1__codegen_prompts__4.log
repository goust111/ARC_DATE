+    for side, pos in windows:
+        if side == "top":
+            rendered_windows.append(("top", (top, left + pos)))
+        elif side == "bottom":
+            rendered_windows.append(("bottom", (bottom, left + pos)))
+        elif side == "left":
+            rendered_windows.append(("left", (top + pos, left)))
+        else:
+            rendered_windows.append(("right", (top + pos, right)))
