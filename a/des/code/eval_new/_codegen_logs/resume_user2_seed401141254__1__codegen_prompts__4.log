+
+def _find_rooms(grid: np.ndarray, bg: int, wall: int) -> list[dict]:
+    wall_cells = [tuple(map(int, cell)) for cell in np.argwhere(grid == wall)]
+    wall_set = set(wall_cells)
+    rooms: dict[tuple[int, int, int, int], dict] = {}
