+        add(vertical_side, col)
+        add(horizontal_side, row)
+
+    candidates = []
+    for side in ("top", "bottom"):
+        for pos in range(1, interior_w + 1):
+            candidates.append((side, pos))
+    for side in ("left", "right"):
