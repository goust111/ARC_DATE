+        grid[marker_r, marker_c] = color
+
+
+def _room_signature(top: int, left: int, interior_h: int, interior_w: int, windows: list[tuple[str, int]]) -> dict:
+    bottom = top + interior_h + 1
+    right = left + interior_w + 1
