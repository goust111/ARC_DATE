+    if side == "left":
+        return (0, 1)
+    if side == "right":
+        return (0, -1)
+    raise ValueError(side)
+
+
+def _valid_room_candidate(
+    grid: np.ndarray, bg: int, wall: int, r0: int, c0: int, r1: int, c1: int
