+    used_vertical: set[int] = set()
+    used_horizontal: set[int] = set()
+
+    def add(side: str, pos: int) -> None:
+        chosen.append((side, pos))
+        if side in ("top", "bottom"):
+            used_vertical.add(pos)
+        else:
