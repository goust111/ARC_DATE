+    for c in range(c0 + 1, c1):
+        value = int(grid[r0, c])
+        if value not in (bg, wall):
+            return None
+        if value == bg and not add_window("top", r0, c, r0 - 1, c):
+            return None
+
+    for c in range(c0 + 1, c1):
+        value = int(grid[r1, c])
