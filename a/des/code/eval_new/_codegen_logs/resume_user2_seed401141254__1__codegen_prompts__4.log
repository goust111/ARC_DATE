+
+    if force_cross:
+        vertical_side = rng.choice(["top", "bottom"])
+        horizontal_side = rng.choice(["left", "right"])
+
+        row_choices = (
+            list(range(1, min(count, interior_h) + 1))
+            if vertical_side == "top"
+            else list(range(max(1, interior_h - count + 1), interior_h + 1))
+        )
+        col_choices = (
