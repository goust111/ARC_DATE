+        w = rng.randint(w_min, GRID_W_RANGE[1])
+        rects = _sample_rectangles(rng, h, w, heights, widths)
+        if rects is None or not _pairwise_geometry_ok(rects):
+            continue
+
+        for idx, rect in enumerate(rects):
