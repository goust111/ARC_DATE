+            continue
+        try:
+            actual = main(inp)
+        except Exception:
+            continue
+        if not np.array_equal(actual, out):
+            continue
+        if np.array_equal(inp, out):
+            continue
+        return inp
+
+    return None
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input: failed to produce a valid sample")

