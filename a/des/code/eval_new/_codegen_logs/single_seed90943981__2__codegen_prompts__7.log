+    heights, widths = sizes
+
+    h_min = max(max(heights) + 2, GRID_H_RANGE[0])
+    w_min = max(max(widths) + 2, GRID_W_RANGE[0])
+    if h_min > GRID_H_RANGE[1] or w_min > GRID_W_RANGE[1]:
+        return None
+
