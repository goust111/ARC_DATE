+def _corner_from_marker(
+    marker_pos: tuple[int, int], bbox: tuple[int, int, int, int]
+) -> str | None:
+    r, c = marker_pos
+    r0, c0, r1, c1 = bbox
+    if (r, c) == (r0, c0):
+        return "TL"
+    if (r, c) == (r0, c1):
+        return "TR"
+    if (r, c) == (r1, c1):
+        return "BR"
+    if (r, c) == (r1, c0):
+        return "BL"
+    return None
