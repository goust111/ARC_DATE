+                continue
+
+            top = random.randint(1, h - box_h - 1)
+            left = random.randint(1, w - box_w - 1)
+            bbox = (top, left, top + box_h - 1, left + box_w - 1)
+            padded = (bbox[0] - 1, bbox[1] - 1, bbox[2] + 1, bbox[3] + 1)
