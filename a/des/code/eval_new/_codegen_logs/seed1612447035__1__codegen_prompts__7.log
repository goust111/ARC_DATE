+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+    out = g.copy()
+    items = _scene_items(g)
+
+    for item in items:
+        r0, c0, r1, c1 = item["bbox"]
+        out[r0 : r1 + 1, c0 : c1 + 1] = bg
+
+    h, w = g.shape
+    for item in items:
+        r0, c0, r1, c1 = item["bbox"]
+        dr, dc = item["shift"]
