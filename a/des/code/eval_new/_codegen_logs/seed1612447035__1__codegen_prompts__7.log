+                    counts[value] = counts.get(value, 0) + 1
+            if sorted(counts.values()) != [1, 7]:
+                continue
+
+            special_color = next(color for color, count in counts.items() if count == 1)
+            special_cells = [
+                (dr, dc)
+                for dr in range(3)
+                for dc in range(3)
