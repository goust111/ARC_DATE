+        for _ in range(200):
+            orientation = random.choice(("h", "v"))
+            axis_limit = w if orientation == "h" else h
+            min_len = max(GEN_MIN_RAIL_LEN, axis_limit // 2)
+            max_len = axis_limit - 2
+            if min_len > max_len:
+                continue
+            length = random.randint(min_len, max_len)
