+
+def get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _boxes_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return not (ar1 < br0 or br1 < ar0 or ac1 < bc0 or bc1 < ac0)
+
+
+def _connected_components(
+    grid: np.ndarray, bg: int, ignore: np.ndarray | None = None
+) -> list[dict[str, object]]:
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    if ignore is None:
+        ignore = np.zeros((h, w), dtype=bool)
+
+    components: list[dict[str, object]] = []
+    for r in range(h):
+        for c in range(w):
+            if visited[r, c] or ignore[r, c]:
+                continue
+            color = int(grid[r, c])
+            if color == bg:
+                continue
+
+            q = deque([(r, c)])
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in CARDINAL_OFFSETS:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if visited[nr, nc] or ignore[nr, nc]:
+                        continue
+                    if int(grid[nr, nc]) != color:
+                        continue
+                    visited[nr, nc] = True
+                    q.append((nr, nc))
+
+            components.append({"color": color, "coords": coords})
+    return components
+
+
+def _detect_sliders(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    h, w = grid.shape
+    sliders: list[dict[str, object]] = []
+    for r0 in range(h - 2):
+        for c0 in range(w - 2):
+            block = grid[r0 : r0 + 3, c0 : c0 + 3]
+            if np.any(block == bg):
+                continue
+
+            counts: dict[int, int] = {}
+            for dr in range(3):
+                for dc in range(3):
+                    if dr == 1 and dc == 1:
+                        continue
+                    value = int(block[dr, dc])
+                    counts[value] = counts.get(value, 0) + 1
+            if sorted(counts.values()) != [1, 7]:
+                continue
+
+            special_color = next(color for color, count in counts.items() if count == 1)
+            special_cells = [
+                (dr, dc)
+                for dr in range(3)
+                for dc in range(3)
+                if (dr, dc) != (1, 1) and int(block[dr, dc]) == special_color
+            ]
+            if len(special_cells) != 1:
+                continue
+            dr, dc = special_cells[0][0] - 1, special_cells[0][1] - 1
+            if abs(dr) + abs(dc) != 1:
+                continue
+
+            sliders.append(
+                {
+                    "bbox": (r0, c0, r0 + 2, c0 + 2),
+                    "center": (r0 + 1, c0 + 1),
+                    "center_color": int(block[1, 1]),
+                    "direction": (dr, dc),
+                    "block": block.copy(),
+                }
+            )
