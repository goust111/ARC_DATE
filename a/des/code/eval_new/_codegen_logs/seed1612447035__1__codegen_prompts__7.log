+    for item in items:
+        r0, c0, r1, c1 = item["bbox"]
+        out[r0 : r1 + 1, c0 : c1 + 1] = bg
+
+    h, w = g.shape
+    for item in items:
+        r0, c0, r1, c1 = item["bbox"]
+        dr, dc = item["shift"]
+        nr0 = r0 + dr
+        nc0 = c0 + dc
+        nr1 = r1 + dr
+        nc1 = c1 + dc
+        assert 0 <= nr0 <= nr1 < h and 0 <= nc0 <= nc1 < w
+        out[nr0 : nr1 + 1, nc0 : nc1 + 1] = item["block"]
+
+    return out
