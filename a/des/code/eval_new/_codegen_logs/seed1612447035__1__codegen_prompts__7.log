+import random
+from collections import deque
+
+import numpy as np
+
+
+CARDINAL_OFFSETS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+ALL_COLORS = tuple(range(10))
+GEN_RETRIES = 400
+GEN_HEIGHT_RANGE = (18, 30)
+GEN_WIDTH_RANGE = (18, 30)
+GEN_MIN_RAIL_LEN = 6
