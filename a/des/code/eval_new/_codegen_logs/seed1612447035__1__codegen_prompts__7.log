+def _connected_components(
+    grid: np.ndarray, bg: int, ignore: np.ndarray | None = None
+) -> list[dict[str, object]]:
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    if ignore is None:
+        ignore = np.zeros((h, w), dtype=bool)
+
+    components: list[dict[str, object]] = []
+    for r in range(h):
+        for c in range(w):
+            if visited[r, c] or ignore[r, c]:
+                continue
+            color = int(grid[r, c])
+            if color == bg:
+                continue
+
+            q = deque([(r, c)])
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in CARDINAL_OFFSETS:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if visited[nr, nc] or ignore[nr, nc]:
+                        continue
+                    if int(grid[nr, nc]) != color:
+                        continue
+                    visited[nr, nc] = True
+                    q.append((nr, nc))
+
+            components.append({"color": color, "coords": coords})
+    return components
