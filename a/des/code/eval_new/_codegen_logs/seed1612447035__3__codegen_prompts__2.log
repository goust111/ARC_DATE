+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in ORTHO4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            rows = [p[0] for p in coords]
+            cols = [p[1] for p in coords]
+            comps.append(
+                {
+                    "color": color,
+                    "coords": tuple(sorted(coords)),
+                    "area": len(coords),
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                }
+            )
+    return comps
+
+
+def _is_portal(comp: dict) -> bool:
+    r0, c0, r1, c1 = map(int, comp["bbox"])
+    area = int(comp["area"])
+    coords = set(comp["coords"])
+    if r0 == r1 and area >= 3 and area == c1 - c0 + 1:
+        return all((r0, cc) in coords for cc in range(c0, c1 + 1))
+    if c0 == c1 and area >= 3 and area == r1 - r0 + 1:
+        return all((rr, c0) in coords for rr in range(r0, r1 + 1))
