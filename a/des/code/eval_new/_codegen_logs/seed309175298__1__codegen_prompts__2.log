                                        tuple(cur),
                                        before,
                                        after,
                                        pad_before,
                                        pad_after,
                                        total,
                                )
                            )
            return
        for sep in AXIS_SEPARATOR_OPTIONS:
            rec_seps(i + 1, cur + [sep], slots)

    rec_slots(0, [])
    return options


