+
+def _choose_fragment_layout(inner_h: int, inner_w: int, sides: list[str]) -> dict[str, dict] | None:
+    for _ in range(PATCH_RETRIES):
+        order = sides[:]
+        random.shuffle(order)
+        occ = np.zeros((inner_h, inner_w), dtype=bool)
