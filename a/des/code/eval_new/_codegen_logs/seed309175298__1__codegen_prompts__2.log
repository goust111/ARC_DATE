+        inner_w = random.randint(*INNER_WIDTH_RANGE)
+        n_frag = random.randint(*FRAGMENT_COUNT_RANGE)
+        sides = random.sample(DIRECTIONS, n_frag)
+        layout = _choose_fragment_layout(inner_h, inner_w, sides)
