+    if side == "top":
+        return r0 + 1, c0 + 1 + (inner_w - sw) // 2
+    if side == "bottom":
+        return r1 - sh, c0 + 1 + (inner_w - sw) // 2
+    if side == "left":
+        return r0 + 1 + (inner_h - sh) // 2, c0 + 1
+    if side == "right":
+        return r0 + 1 + (inner_h - sh) // 2, c1 - sw
+    raise AssertionError(f"unknown side: {side}")
