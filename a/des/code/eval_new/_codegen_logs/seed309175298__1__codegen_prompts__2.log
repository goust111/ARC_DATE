+
+def _inner_dock_origin(side: str, shape: np.ndarray, inner_h: int, inner_w: int) -> tuple[int, int]:
+    sh, sw = shape.shape
+    if side == "top":
+        return 0, (inner_w - sw) // 2
+    if side == "bottom":
+        return inner_h - sh, (inner_w - sw) // 2
