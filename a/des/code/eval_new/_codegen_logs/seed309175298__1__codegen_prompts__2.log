+    r0, c0, r1, c1 = map(int, frame_bbox)
+    sh, sw = map(int, frag_shape)
+    inner_h = r1 - r0 - 1
+    inner_w = c1 - c0 - 1
+    assert 1 <= sh <= inner_h and 1 <= sw <= inner_w
