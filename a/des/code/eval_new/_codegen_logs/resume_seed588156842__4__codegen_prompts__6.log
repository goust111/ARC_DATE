+import numpy as np
+
+
+AZURE = 8
+GREY = 5
+BLACK = 0
+
+TYPE_H = "horizontal"
+TYPE_V = "vertical"
+TYPE_R = "rot90"
+TYPE_C = "central"
+TYPES = (TYPE_H, TYPE_V, TYPE_R, TYPE_C)
+
+CONTENT_SIZE_CHOICES = (4, 5)
+PUZZLE_ROW_CHOICES = (1, 2)
+COL_COUNT = 4
+MARKER_POOL = [1, 2, 3, 4, 6, 7, 9]
+PATTERN_POOL = [1, 2, 3, 4, 6, 7, 9]
+ICON_COLOR = BLACK
