+    grid[:, 0] = GREY
+    grid[:, -1] = GREY
+    for row in range(1, total_rows):
+        sep = row * cell_size + row
+        grid[sep, :] = GREY
+    for col in range(1, COL_COUNT):
+        sep = col * cell_size + col
+        grid[:, sep] = GREY
+
+    marker_colors = rng.choice(MARKER_POOL, size=4, replace=False).tolist()
+    marker_perm = rng.permutation(4).tolist()
