+    if kind == TYPE_V:
+        return r, size - 1 - c
+    if kind == TYPE_R:
+        return c, size - 1 - r
+    if kind == TYPE_C:
+        return size - 1 - r, size - 1 - c
+    raise ValueError(f"unknown symmetry type: {kind}")
