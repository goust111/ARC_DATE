+    if kind == TYPE_R:
+        return c, size - 1 - r
+    if kind == TYPE_C:
+        return size - 1 - r, size - 1 - c
+    raise ValueError(f"unknown symmetry type: {kind}")
+
+
+def _apply_transform(mask: np.ndarray, kind: str) -> np.ndarray:
+    if kind == TYPE_H:
+        return np.flipud(mask)
+    if kind == TYPE_V:
+        return np.fliplr(mask)
+    if kind == TYPE_R:
