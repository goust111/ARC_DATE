+GREY = 5
+BLACK = 0
+
+TYPE_H = "horizontal"
+TYPE_V = "vertical"
+TYPE_R = "rot90"
+TYPE_C = "central"
+TYPES = (TYPE_H, TYPE_V, TYPE_R, TYPE_C)
+TYPE_PRIORITY = {
+    TYPE_R: 0,
+    TYPE_H: 1,
+    TYPE_V: 2,
+    TYPE_C: 3,
