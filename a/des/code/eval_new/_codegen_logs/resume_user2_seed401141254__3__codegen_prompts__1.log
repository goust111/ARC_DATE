+def _outer_border_color(cell: np.ndarray) -> int | None:
+    border = np.concatenate([cell[0], cell[-1], cell[1:-1, 0], cell[1:-1, -1]])
+    values = np.unique(border)
+    if len(values) != 1:
+        return None
+    return int(values[0])
