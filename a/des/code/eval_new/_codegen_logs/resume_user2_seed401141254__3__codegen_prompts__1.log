+    frames: list[tuple[int, tuple[int, int, int, int]]],
+    truth_patterns: dict[int, np.ndarray],
+) -> np.ndarray:
+    out = grid.copy()
+    for color, box in frames:
+        r0, c0, r1, c1 = box
+        tile = _tile_pattern(truth_patterns[color], r1 - r0 - 2, c1 - c0 - 2)
+        out[r0 + 1 : r1 - 1, c0 + 1 : c1 - 1] = tile
+    return out
+
