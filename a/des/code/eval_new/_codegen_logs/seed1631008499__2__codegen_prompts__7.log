+        mask = _crop_mask(mask)
+        if mask.shape[0] < MIN_INNER_SIZE or mask.shape[1] < MIN_INNER_SIZE:
+            continue
+        if int(mask.sum()) < MIN_INNER_AREA:
+            continue
