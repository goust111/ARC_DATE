+                assert color != BG
+                bottom_edges.append((r + 1, c, color))
+            if c > 0 and not region[r, c - 1]:
+                color = int(g[r, c - 1])
+                assert color != BG
+                left_edges.append((r, c - 1, color))
+            if c + 1 < w and not region[r, c + 1]:
