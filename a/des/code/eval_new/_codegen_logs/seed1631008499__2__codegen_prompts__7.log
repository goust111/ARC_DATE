+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+YELLOW = 4
+PALETTE = (1, 2, 3, 5, 6, 7, 8, 9)
+
+MAX_GENERATION_ATTEMPTS = 400
+OBJECT_PLACEMENT_ATTEMPTS = 100
+SHAPE_ATTEMPTS = 120
+MAX_NOTCHES = 3
+MIN_INNER_SIZE = 3
+MIN_INNER_AREA = 8
