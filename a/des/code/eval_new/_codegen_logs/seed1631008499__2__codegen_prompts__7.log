+def _place_patch(grid: np.ndarray, reserved: np.ndarray, patch: np.ndarray) -> bool:
+    h, w = grid.shape
+    ph, pw = patch.shape
+    candidates = [(r, c) for r in range(h - ph + 1) for c in range(w - pw + 1)]
+    random.shuffle(candidates)
