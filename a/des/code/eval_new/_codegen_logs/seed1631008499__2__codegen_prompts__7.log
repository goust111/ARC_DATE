+    for r, c in cells:
+        rows.setdefault(int(r), []).append(int(c))
+
+    runs: list[list[tuple[int, int]]] = []
+    for r, cols in rows.items():
+        cols.sort()
+        start = prev = cols[0]
+        for c in cols[1:]:
