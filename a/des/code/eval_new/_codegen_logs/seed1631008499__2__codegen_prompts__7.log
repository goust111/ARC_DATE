+
+def _sample_shape(max_size: int) -> np.ndarray | None:
+    for _ in range(SHAPE_ATTEMPTS):
+        h = random.randint(MIN_INNER_SIZE, max_size)
+        w = random.randint(MIN_INNER_SIZE, max_size)
