+        top_row = min(r for r, _c, _color in top_edges)
+        bottom_row = max(r for r, _c, _color in bottom_edges)
+        left_col = min(c for _r, c, _color in left_edges)
+        right_col = max(c for _r, c, _color in right_edges)
