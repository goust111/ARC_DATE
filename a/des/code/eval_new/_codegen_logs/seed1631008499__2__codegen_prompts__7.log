+        row = run[0][0]
+        if row == top_row:
+            color = top_color
+        elif row == bottom_row:
+            color = bottom_color
+        else:
+            color = _choose_color()
+        for cell in run:
+            horizontal_colors[cell] = color
+
+    for run in _group_vertical_runs(vertical):
+        col = run[0][1]
+        if col == left_col:
+            color = left_color
+        elif col == right_col:
+            color = right_color
+        else:
+            color = _choose_color()
+        for cell in run:
+            vertical_colors[cell] = color
