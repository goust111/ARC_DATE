+    n = len(vals)
+    i = 0
+    entries: list[tuple[int, int, int]] = []
+    used_positions: list[int] = []
+    while i < n:
+        while i < n and vals[i] == bg:
+            i += 1
+        if i >= n:
+            break
+        if i + 3 >= n:
+            return None
