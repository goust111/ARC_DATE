+SHAPE_TEMPLATES = (
+    _pattern(("##",)),
+    _pattern(("###",)),
+    _pattern(("#.", "##")),
+    _pattern(("####",)),
+    _pattern(("##", "##")),
+    _pattern(("#..", "###")),
+    _pattern(("###", ".#.")),
+    _pattern(("##.", ".##")),
