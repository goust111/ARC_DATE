+    divider = _find_divider_color(grid)
+    row_lines = np.flatnonzero(np.all(grid == divider, axis=1))
+    col_lines = np.flatnonzero(np.all(grid == divider, axis=0))
+    if len(row_lines) < 2 or len(col_lines) < 2:
