+def _spans_from_lines(lines: list[int]) -> list[tuple[int, int]]:
+    spans = []
+    for a, b in zip(lines, lines[1:]):
+        if b - a >= 2:
+            spans.append((int(a + 1), int(b - 1)))
+    if not spans:
+        raise ValueError("no room spans found")
+    return spans
