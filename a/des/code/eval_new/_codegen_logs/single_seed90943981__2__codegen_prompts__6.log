+
+    def dfs(path: list[tuple[int, int]], used: set[tuple[int, int]]) -> list[tuple[int, int]] | None:
+        if len(path) == length:
+            return list(path)
+        options = _room_neighbors(path[-1], rows, cols)
+        random.shuffle(options)
+        for nxt in options:
