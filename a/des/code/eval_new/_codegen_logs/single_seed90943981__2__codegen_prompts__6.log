            rooms[(ri, ci)] = {
                "bbox": (r0, r1, c0, c1),
                "exit": DIR_FROM_VEC[direction],
                "source_color": source_color,
            }

    doors: dict[tuple[int, int], list[tuple[int, int]]] = {}
    for ri, (r0, r1) in enumerate(row_spans):
