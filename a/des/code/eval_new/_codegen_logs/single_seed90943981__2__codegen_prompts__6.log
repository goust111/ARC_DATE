+def _room_neighbors(room: tuple[int, int], rows: int, cols: int) -> list[tuple[int, int]]:
+    ri, ci = room
+    out = []
+    if ri > 0:
+        out.append((ri - 1, ci))
+    if ri + 1 < rows:
+        out.append((ri + 1, ci))
+    if ci > 0:
+        out.append((ri, ci - 1))
+    if ci + 1 < cols:
+        out.append((ri, ci + 1))
+    return out
