+def _parse_rooms(grid: np.ndarray) -> tuple[dict[tuple[int, int], dict], dict[tuple[int, int], list[tuple[int, int]]], int]:
+    g = np.asarray(grid, dtype=int)
+    bg = _bg_color(g)
