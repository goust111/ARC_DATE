+            flag_color = None
+            for color, count in counts.items():
+                if count != 2:
+                    continue
+                pts = [pos for pos, col in markers if col == color]
+                if abs(pts[0][0] - pts[1][0]) + abs(pts[0][1] - pts[1][1]) == 1:
