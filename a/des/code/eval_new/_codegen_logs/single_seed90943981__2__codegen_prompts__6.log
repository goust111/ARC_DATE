+            flag_pts = [pos for pos, col in markers if col == flag_color]
+            p0, p1 = flag_pts
+            b0 = _boundary_sides(p0[0], p0[1], r0, r1, c0, c1)
+            b1 = _boundary_sides(p1[0], p1[1], r0, r1, c0, c1)
