+
+def _neighbor(room: tuple[int, int], direction: str) -> tuple[int, int]:
+    ri, ci = room
+    dr, dc = DIRS[direction]
+    return (ri + dr, ci + dc)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
