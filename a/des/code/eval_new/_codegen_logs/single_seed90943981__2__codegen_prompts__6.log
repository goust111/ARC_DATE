+            if ri + 1 < len(row_spans):
+                wall_r = wall_rows[ri + 1]
+                pts = [(wall_r, c) for c in range(c0, c1 + 1) if int(g[wall_r, c]) != wall]
+                room_doors["down"] = pts
+            if ci > 0:
+                wall_c = wall_cols[ci]
+                pts = [(r, wall_c) for r in range(r0, r1 + 1) if int(g[r, wall_c]) != wall]
