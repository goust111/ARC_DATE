+        out.append((ri - 1, ci))
+    if ri + 1 < rows:
+        out.append((ri + 1, ci))
+    if ci > 0:
+        out.append((ri, ci - 1))
+    if ci + 1 < cols:
+        out.append((ri, ci + 1))
