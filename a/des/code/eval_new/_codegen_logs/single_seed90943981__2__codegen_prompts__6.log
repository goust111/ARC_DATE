+        flag = (r1 - 1, c)
+    elif direction == "down":
+        c = random.randint(c0 + 1, c1 - 1)
+        pole = (r0, c)
+        flag = (r0 + 1, c)
+    elif direction == "left":
+        r = random.randint(r0 + 1, r1 - 1)
+        pole = (r, c1)
+        flag = (r, c1 - 1)
+    else:
+        r = random.randint(r0 + 1, r1 - 1)
+        pole = (r, c0)
+        flag = (r, c0 + 1)
+    grid[pole] = color
+    grid[flag] = color
+    return pole, flag
