+    if len(path) < 3:
+        return []
+
+    step_dirs = [(b[0] - a[0], b[1] - a[1]) for a, b in zip(path, path[1:])]
+    turns: list[str] = []
+    for prev_dir, next_dir in zip(step_dirs, step_dirs[1:]):
+        a = DIR_INDEX[prev_dir]
+        b = DIR_INDEX[next_dir]
+        if a == b:
+            continue
+        diff = (b - a) % 4
