+    h, w = mask.shape
+    out = mask.copy()
+    for r, c in np.argwhere(mask):
+        for rr in range(max(0, r - 1), min(h, r + 2)):
+            for cc in range(max(0, c - 1), min(w, c + 2)):
+                out[rr, cc] = True
+    return out
+
