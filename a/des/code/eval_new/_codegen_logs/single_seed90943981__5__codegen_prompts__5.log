def find_frame(g):
    pts=np.argwhere(g==GREY)
    if len(pts)==0:
        raise ValueError('no frame')
    r0,c0=pts.min(axis=0)
    r1,c1=pts.max(axis=0)
    r0=int(r0);c0=int(c0);r1=int(r1);c1=int(c1)
    for r in range(r0,r1+1):
