+        assert len(nxt) == 1, "path traversal must stay unambiguous"
+        prev, cur = cur, nxt[0]
+        path.append(cur)
+
+    assert len(path) == len(cell_set), "path traversal must visit every cell exactly once"
+    return path
+
+
