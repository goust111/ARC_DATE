+    counts = _group_component_counts(grid, FRAME)
+    if sorted(counts.values()) != sorted(depths):
+        return None
+    if len(counts) != num_groups:
+        return None
+    outer_areas = []
+    for color in counts:
+        infos = [_component_info(grid, color, coords) for coords in _components_of_color(grid, color)]
