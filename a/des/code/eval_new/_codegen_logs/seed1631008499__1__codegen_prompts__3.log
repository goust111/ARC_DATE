+    ordered_groups: list[tuple[tuple[int, int, int, int, int], int, list[dict[str, object]]]] = []
+    for color, infos in groups.items():
+        infos.sort(
+            key=lambda info: (
+                -int(info["bbox_area"]),
+                -int(info["h"]),
+                -int(info["w"]),
+                int(info["bbox"][0]),
+                int(info["bbox"][1]),
+            )
+        )
+        outer = infos[0]
+        ordered_groups.append(
