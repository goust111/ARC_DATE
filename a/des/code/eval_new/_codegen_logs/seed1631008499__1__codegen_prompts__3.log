+def _paint_mask(grid: np.ndarray, mask: np.ndarray, color: int, r0: int, c0: int) -> None:
+    sub = grid[r0 : r0 + mask.shape[0], c0 : c0 + mask.shape[1]]
+    sub[mask] = int(color)
