+    if not bool((out[0, :] == FRAME).all() and (out[-1, :] == FRAME).all()):
+        return None
+    if not bool((out[:, 0] == FRAME).all() and (out[:, -1] == FRAME).all()):
+        return None
+    present_out = set(map(int, np.unique(out))) - {BG, FRAME}
+    if present_out != set(counts):
