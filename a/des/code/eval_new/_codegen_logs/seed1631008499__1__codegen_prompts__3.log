+    comps: list[list[tuple[int, int]]] = []
+    for r0 in range(h):
+        for c0 in range(w):
+            if seen[r0, c0] or int(grid[r0, c0]) != int(color):
+                continue
+            seen[r0, c0] = True
+            stack = [(int(r0), int(c0))]
+            comp: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                comp.append((int(r), int(c)))
+                for rr, cc in _neighbors4(int(r), int(c)):
