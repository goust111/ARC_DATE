+def _is_connected(mask: np.ndarray) -> bool:
+    points = list(zip(*np.where(mask), strict=False))
+    if not points:
+        return False
+    seen = {points[0]}
+    stack = [points[0]]
+    h, w = mask.shape
+    while stack:
+        r, c = stack.pop()
+        for rr, cc in _neighbors4(int(r), int(c)):
+            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and (rr, cc) not in seen:
+                seen.add((rr, cc))
