+            if not bool((patch[0, :] == color).all() and (patch[-1, :] == color).all()):
+                continue
+            if not bool((patch[:, 0] == color).all() and (patch[:, -1] == color).all()):
+                continue
+            if h > 2 and not bool((patch[1:-1, 1:-1] == BG).all()):
+                continue
+            cand = (h, (int(r0), int(c0), int(r1), int(c1)))
+            if best is None or cand[0] > best[0]:
