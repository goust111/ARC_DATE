+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+
+    visible = set(map(int, np.unique(actual))) - {_GEN_BG}
+    if len(visible) < min(3, rect_count):
+        return None
+
+    return grid
+
