+def _adjacent_stamp(coord: tuple[int, int], stamps: list[dict[str, object]]) -> int | None:
+    r, c = coord
+    hits: list[int] = []
+    for idx, stamp in enumerate(stamps):
+        for sr, sc in stamp["cells"]:
+            if abs(sr - r) + abs(sc - c) == 1:
+                hits.append(idx)
+                break
+    if len(hits) == 1:
+        return hits[0]
+    return None
+
