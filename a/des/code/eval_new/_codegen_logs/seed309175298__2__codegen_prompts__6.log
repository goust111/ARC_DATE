+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+MAROON = 9
+
+STAMP_COLORS = (BLUE, RED, YELLOW, ORANGE)
+NEXT_COLOR = {
+    RED: ORANGE,
+    ORANGE: YELLOW,
+    YELLOW: BLUE,
+    BLUE: RED,
+}
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+GRID_H_RANGE = (16, 30)
+GRID_W_RANGE = (16, 30)
+COMBO_COUNT_OPTIONS = (1, 2, 3)
+SEGMENT_COUNT_OPTIONS = (1, 2, 3)
+SEGMENT_LEN_RANGE = (2, 6)
+GEN_RETRIES = 400
+PLACE_RETRIES = 120
+HALO = 1
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    for dr, dc in DIR4:
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            yield rr, cc
+
+
+def _mask_components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _mono_components(grid: np.ndarray, colors: tuple[int, ...]) -> list[tuple[int, list[tuple[int, int]]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    allowed = set(colors)
+    comps: list[tuple[int, list[tuple[int, int]]]] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color not in allowed or bool(seen[r, c]):
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if not bool(seen[nr, nc]) and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append((color, pts))
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_stamps(grid: np.ndarray) -> list[dict[str, object]]:
+    stamps: list[dict[str, object]] = []
+    for color, pts in _mono_components(grid, STAMP_COLORS):
+        if len(pts) != 4:
+            continue
+        r0, c0, r1, c1 = _bbox(pts)
+        if r1 - r0 != 1 or c1 - c0 != 1:
+            continue
+        cell_set = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
+        if set(pts) != cell_set:
+            continue
+        stamps.append(
+            {
+                "color": int(color),
+                "top_left": (int(r0), int(c0)),
+                "cells": cell_set,
+            }
+        )
+    return stamps
+
