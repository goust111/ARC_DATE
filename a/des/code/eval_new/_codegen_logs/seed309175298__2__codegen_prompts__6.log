+def _find_endpoint_mask(grid: np.ndarray, stamp_cells: set[tuple[int, int]]) -> np.ndarray:
+    h, w = grid.shape
+    endpoint_mask = np.zeros((h, w), dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color not in STAMP_COLORS or (r, c) in stamp_cells:
+                continue
