+BG = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+MAROON = 9
+
+STAMP_COLORS = (BLUE, RED, YELLOW, ORANGE)
+NEXT_COLOR = {
+    RED: ORANGE,
+    ORANGE: YELLOW,
+    YELLOW: BLUE,
+    BLUE: RED,
