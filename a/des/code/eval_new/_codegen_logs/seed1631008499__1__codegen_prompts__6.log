+GREY = 5
+COLOR_POOL = tuple(color for color in range(10) if color not in (BG, GREY))
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_ATTEMPTS = 400
+PLACE_ATTEMPTS = 300
