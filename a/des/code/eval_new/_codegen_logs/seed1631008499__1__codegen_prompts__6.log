+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and not boundary_mask[nr, nc] and not exterior[nr, nc]:
+                exterior[nr, nc] = True
+                q.append((int(nr), int(nc)))
