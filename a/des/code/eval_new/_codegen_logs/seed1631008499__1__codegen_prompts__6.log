+def _place_distractors(inp: np.ndarray, out: np.ndarray, count: int) -> bool:
+    segments = _extract_segments(inp)
+    endpoints = [tuple(endpoint) for seg in segments for endpoint in seg["endpoints"]]
+    h, w = inp.shape
