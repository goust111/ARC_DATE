+    h, w = inp.shape
+    cell_set = set(cells)
+    for r, c in cells:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        if int(inp[r, c]) != BG or int(out[r, c]) != BG:
+            return False
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cell_set and int(inp[nr, nc]) != BG:
+                return False
