+    eligible = {seg_id for seg_id, count in degree.items() if count == 2}
+    comps: list[set[int]] = []
+    seen: set[int] = set()
+    for seg_id in sorted(eligible):
+        if seg_id in seen:
+            continue
+        q = deque([int(seg_id)])
+        seen.add(int(seg_id))
+        comp: set[int] = set()
