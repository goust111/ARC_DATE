+def _eligible_segment_components(segment_count: int, connectors: list[dict]) -> list[set[int]]:
+    degree = Counter()
+    adj = [set() for _ in range(segment_count)]
+    for conn in connectors:
+        a, b = conn["segments"]
+        degree[int(a)] += 1
+        degree[int(b)] += 1
+        adj[int(a)].add(int(b))
+        adj[int(b)].add(int(a))
