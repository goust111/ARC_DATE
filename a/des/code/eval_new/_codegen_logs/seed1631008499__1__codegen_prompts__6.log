+    if not valid_counts:
+        return None
+    count = random.choice(valid_counts)
+    remaining = edge_len - count - 1
+    parts: list[int] = []
+    for idx in range(count):
+        left = count - idx - 1
+        lo = max(3, remaining - 8 * left)
+        hi = min(8, remaining - 3 * left)
+        if lo > hi:
+            return None
+        part = random.randint(lo, hi)
+        parts.append(int(part))
+        remaining -= int(part)
+    if remaining != 0:
