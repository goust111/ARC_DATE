+            if int(g[r, c]) != BG:
+                continue
+            vertical_gap = (
+                int(g[r - 1, c]) == WALL
+                and int(g[r + 1, c]) == WALL
+                and int(g[r, c - 1]) != WALL
+                and int(g[r, c + 1]) != WALL
+            )
+            horizontal_gap = (
+                int(g[r, c - 1]) == WALL
+                and int(g[r, c + 1]) == WALL
+                and int(g[r - 1, c]) != WALL
+                and int(g[r + 1, c]) != WALL
