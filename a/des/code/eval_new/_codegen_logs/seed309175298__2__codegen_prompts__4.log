+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+AZURE = 8
+MAROON = 9
+
+INSTRUCTION_COLORS = [RED, BLUE, YELLOW, ORANGE, MAGENTA, AZURE]
+CANVAS_SIZE = 30
+MAX_GENERATION_ATTEMPTS = 400
