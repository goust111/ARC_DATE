+                seen[r - 1, c] = True
+                stack.append((r - 1, c))
+            if r + 1 < height and mask[r + 1, c] and not seen[r + 1, c]:
+                seen[r + 1, c] = True
+                stack.append((r + 1, c))
+            if c > 0 and mask[r, c - 1] and not seen[r, c - 1]:
+                seen[r, c - 1] = True
+                stack.append((r, c - 1))
+            if c + 1 < width and mask[r, c + 1] and not seen[r, c + 1]:
