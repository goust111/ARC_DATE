+        reverse=True,
+    )
+
+    for idx in order:
+        spec = specs[idx]
+        height = int(spec["outer_h"])
+        width = int(spec["outer_w"])
+
+        if mode == "tl":
+            r_lo = marker[0] + 2
+            c_lo = marker[1] + 2
+            r_hi = CANVAS_SIZE - height
+            c_hi = CANVAS_SIZE - width
+        else:
