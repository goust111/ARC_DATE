+        "layers": layers,
+        "seq_len": seq_len,
+        "seq_colors": seq_colors,
+        "inner_h": inner_h,
+        "inner_w": inner_w,
+        "left_pad": left_pad,
+        "outer_h": outer_h,
+        "outer_w": outer_w,
+    }
