+
+    groups: list[list[dict]] = []
+    assigned: set[int] = set()
+    for outer_idx in sorted(outer_indices, key=lambda i: rings[i]["bbox"]):
+        outer_box = rings[outer_idx]["bbox"]
+        member_indices = [
