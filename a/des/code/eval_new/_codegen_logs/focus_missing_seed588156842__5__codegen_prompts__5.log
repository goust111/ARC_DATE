+    canvases: list[dict[str, object]] = []
+    for color in colors:
+        placed = False
+        for _ in range(250):
+            if rng.random() < 0.45:
+                side = int(rng.integers(4, 8))
+                rect_h = side
+                rect_w = side
+            else:
+                rect_h = int(rng.integers(4, 8))
+                rect_w = int(rng.integers(4, 8))
+            if rect_h + 2 >= h or rect_w + 2 >= w:
+                continue
+            r0 = int(rng.integers(1, h - rect_h))
+            c0 = int(rng.integers(1, w - rect_w))
+            r1 = r0 + rect_h - 1
+            c1 = c0 + rect_w - 1
