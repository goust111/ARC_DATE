+        if base is None:
+            continue
+
+        bg = Counter(map(int, base.ravel())).most_common(1)[0][0]
+        used = set(map(int, np.unique(base)))
+        available = [color for color in PALETTE if color not in used and color != RED]
+        pairs = _choose_pairs(base)
