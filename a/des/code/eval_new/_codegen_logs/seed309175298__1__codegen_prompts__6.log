+            inp[marker] = RED
+
+        out = _expected_output(base, pairs, intruder_colors)
+        if Counter(map(int, inp.ravel())).most_common(1)[0][0] != bg:
+            continue
+        if not np.array_equal(main(inp), out):
+            continue
