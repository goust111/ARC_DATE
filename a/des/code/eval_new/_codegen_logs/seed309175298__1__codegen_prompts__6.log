+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+RED = 2
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PALETTE = tuple(range(10))
+GENERATION_ATTEMPTS = 400
+
+
+def _mirror_col(width: int, col: int) -> int:
+    return width - 1 - col
+
+
+def _neighbors4(r: int, c: int, height: int, width: int):
+    for dr, dc in DIRS4:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < height and 0 <= nc < width:
+            yield nr, nc
+
+
+def _blob_mask(height: int, width: int, size: int) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    start = (random.randrange(height), random.randrange(width))
+    mask[start] = True
+    frontier = {start}
+
+    while int(mask.sum()) < size:
+        cell = random.choice(tuple(frontier))
+        frontier.remove(cell)
+        r, c = cell
+        options = []
+        for nr, nc in _neighbors4(r, c, height, width):
+            if not mask[nr, nc]:
+                options.append((nr, nc))
+        if not options:
+            frontier.update(tuple(map(int, rc)) for rc in np.argwhere(mask))
+            continue
+        pick = random.choice(options)
+        mask[pick] = True
+        frontier.add(pick)
+        frontier.add(cell)
+
+    if random.random() < 0.5:
+        mask = np.flipud(mask)
+    if random.random() < 0.5:
+        mask = np.fliplr(mask)
+    return mask.copy()
