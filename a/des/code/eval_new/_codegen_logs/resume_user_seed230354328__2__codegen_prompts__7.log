+def _parse_palette(row: np.ndarray) -> dict[int, list[int]]:
+    mapping: dict[int, list[int]] = {}
+    cur: list[int] = []
+    for v in map(int, row):
+        if v in (BG, GREY):
+            if len(cur) >= 2:
+                mapping[cur[0]] = cur[:]
+            cur = []
+        else:
+            cur.append(v)
+    if len(cur) >= 2:
+        mapping[cur[0]] = cur[:]
+    return mapping
