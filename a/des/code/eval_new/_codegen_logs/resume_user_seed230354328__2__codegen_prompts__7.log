+            if any((rr, cc) in chosen for rr, cc in _neighbors4(nr, nc)):
+                continue
+            candidates.append((nr, nc))
+        if not candidates:
+            return None
+        pick = random.choice(candidates)
+        reserved.add(pick)
+        chosen.append(pick)
+    return chosen
