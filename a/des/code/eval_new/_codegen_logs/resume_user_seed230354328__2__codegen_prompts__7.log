+def _order_path(cells: list[tuple[int, int]], h: int, w: int) -> list[tuple[int, int]]:
+    pts = set(cells)
+    deg = {
+        p: sum((nr, nc) in pts for nr, nc in _neighbors4(*p))
+        for p in pts
