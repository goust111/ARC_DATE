+def _validate_generated(grid: np.ndarray, expected_paths: int) -> bool:
+    h, w = grid.shape
+    if h > 30 or w > 30:
+        return False
+    palette = _parse_palette(grid[-1, :])
+    upper = grid[:-1, :]
