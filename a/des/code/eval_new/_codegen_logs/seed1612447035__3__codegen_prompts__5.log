 180: def _init_scene(H: int, W: int) -> tuple[np.ndarray, int, list[int], set[tuple[int, int]]]:
 181:     grid = np.full((H, W), GEN_BG, dtype=int)
 182:     c0 = random.randint(0, W - MARKER_SIZE)
 183:     num_stops = random.randint(*STOP_COUNT_RANGE)
 184:     positions = list(range(MARKER_SIZE))
 185:     random.shuffle(positions)
 186:     stop_positions = sorted(positions[:num_stops])
 187:     marker = np.full((MARKER_SIZE, MARKER_SIZE), GEN_PASS, dtype=int)
 188:     for j in stop_positions:
 189:         marker[MARKER_SIZE - 1, j] = GEN_STOP
 190:     grid[0:MARKER_SIZE, c0:c0 + MARKER_SIZE] = marker
 191:     obstacle_pixels: set[tuple[int, int]] = set()
 192:     for j in stop_positions:
 193:         col = c0 + j
 194:         first_obs_row = random.randint(MIN_STOP_OBSTACLE_ROW, H - 1)
 195:         grid[first_obs_row, col] = GEN_OBSTACLE
 196:         obstacle_pixels.add((first_obs_row, col))
 197:     return grid, c0, stop_positions, obstacle_pixels
