 250:     frame_h = hrow_positions[-1] + 1
 251:     frame_w = vcol_positions[-1] + 1
 252:     walls = np.zeros((frame_h, frame_w), dtype=bool)
 253:     for r in hrow_positions:
 254:         walls[r, :] = True
 255:     for c in vcol_positions:
 256:         walls[:, c] = True
 257: 
 258:     cells_to_merge = total_cells - target_rooms
