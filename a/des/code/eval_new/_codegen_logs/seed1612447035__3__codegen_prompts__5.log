  85: def main(grid: np.ndarray) -> np.ndarray:
  86:     """Drop the columns of the top marker downward, stopping blue-ended columns on grey obstacles and letting maroon-ended columns pass to the bottom.
  87: 
  88:     Input structure
  89:     - The background is the dominant color.
  90:     - The most numerous non-background color forms stationary grey obstacle pixels.
  91:     - The other two colors form a single 3x3 top-edge marker whose top two rows
  92:       are maroon and whose bottom row contains maroon or blue control pixels.
  93: 
  94:     Rule
  95:     - Erase the top marker.
  96:     - Treat each marker column as a vertical drop retaining its three colors.
  97:     - A column whose bottom control pixel is blue stops immediately above the
  98:       first grey pixel below that column, or bottom-aligns if none exists.
  99:     - Contiguous maroon-ended columns pass through obstacles and bottom-align;
 100:       if such a run has a clear down-right slide from a grey ledge, shift the
 101:       run one column right before bottom-aligning.
 102:     - When a maroon-ended drop lands through a grey bar on the bottom edge, clear
 103:       the rest of the marker-width gap in that bottom bar.
 104: 
 105:     Key insight
 106:     - The bottom row of the top marker is a control strip: blue cells mean
 107:       "stick to the first obstacle," while maroon cells mean "fall through."
 108:     """
 109:     g = np.asarray(grid, dtype=int)
 110:     H = g.shape[0]
 111:     bg = int(get_bg(g))
 112: 
 113:     non_bg = colors_present(g, exclude={bg})
 114:     assert len(non_bg) == 3, "expected obstacle color plus two marker colors"
 115:     obstacle = _unique_largest_count_color(g, non_bg)
 116:     marker_colors = [color for color in non_bg if color != obstacle]
 117:     assert len(marker_colors) == 2, "expected exactly two marker colors"
 118: 
 119:     r0, c0, r1, c1 = _marker_bbox(g, marker_colors)
 120:     marker = g[r0 : r1 + 1, c0 : c1 + 1]
 121:     marker_h, marker_w = marker.shape
 122:     assert (marker_h, marker_w) == (3, 3), "expected a 3x3 marker"
 123:     assert np.all(np.isin(marker, marker_colors)), "marker bbox must contain only marker colors"
 124: 
 125:     pass_color = int(marker[0, 0])
 126:     assert np.all(marker[:2, :] == pass_color), "top two marker rows must be the pass-through color"
 127:     stop_colors = [color for color in marker_colors if color != pass_color]
 128:     assert len(stop_colors) == 1, "expected one stop color"
 129:     stop_color = stop_colors[0]
 130: 
 131:     out = g.copy()
 132:     out[r0 : r1 + 1, c0 : c1 + 1] = bg
 133:     base = out.copy()
 134: 
 135:     pass_columns: list[int] = []
 136:     for j in range(marker_w):
 137:         c = c0 + j
 138:         stack = marker[:, j]
 139:         bottom_control = int(stack[-1])
 140: 
 141:         if bottom_control == stop_color:
 142:             obstacles_below = np.flatnonzero(base[r1 + 1 :, c] == obstacle)
 143:             if len(obstacles_below):
 144:                 floor_r = int(r1 + 1 + obstacles_below[0])
 145:                 top_r = floor_r - marker_h
 146:             else:
 147:                 top_r = H - marker_h
 148:             assert top_r >= 0, "stopped column must fit above its obstacle"
 149:             out[top_r : top_r + marker_h, c] = stack
 150:         else:
 151:             assert bottom_control == pass_color, "bottom control must be one of the marker colors"
 152:             pass_columns.append(j)
 153: 
 154:     for start_j, end_j in _runs(pass_columns):
 155:         source_cols = list(range(c0 + start_j, c0 + end_j + 1))
 156:         shift = 1 if _can_slide_right(base, obstacle, bg, source_cols, r1, marker_h) else 0
 157:         top_r = H - marker_h
 158: 
 159:         for j in range(start_j, end_j + 1):
 160:             c = c0 + j + shift
 161:             _clear_bottom_edge_gap(base, out, obstacle, bg, c, marker_w)
 162:             out[top_r : top_r + marker_h, c] = marker[:, j]
 163: 
 164:     return out
