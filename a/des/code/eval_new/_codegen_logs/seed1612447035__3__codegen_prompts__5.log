+def _components4_by_color(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if seen[r, c] or color == bg:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = cr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(g[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            pts = np.array(coords, dtype=int)
+            r0, c0 = pts.min(axis=0)
+            r1, c1 = pts.max(axis=0)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": pts,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(len(coords)),
+                }
+            )
+    return comps
+
+
+def _ring_info(comp: dict) -> dict | None:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 3 or w < 3:
+        return None
+
+    mask = np.zeros((h, w), dtype=bool)
+    coords = comp["coords"]
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+
+    if np.any(mask & ~border):
+        return None
+
+    missing = border & ~mask
+    if int(missing.sum()) != 1:
+        return None
+
+    gap_r, gap_c = map(int, np.argwhere(missing)[0])
+    if gap_r == 0 and 0 < gap_c < w - 1:
+        side = "top"
+        if gap_c not in {w // 2, (w - 1) // 2}:
+            return None
+    elif gap_r == h - 1 and 0 < gap_c < w - 1:
+        side = "bottom"
+        if gap_c not in {w // 2, (w - 1) // 2}:
+            return None
+    elif gap_c == 0 and 0 < gap_r < h - 1:
+        side = "left"
+        if gap_r not in {h // 2, (h - 1) // 2}:
+            return None
+    elif gap_c == w - 1 and 0 < gap_r < h - 1:
+        side = "right"
+        if gap_r not in {h // 2, (h - 1) // 2}:
