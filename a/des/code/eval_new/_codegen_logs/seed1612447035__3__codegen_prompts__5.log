 234:     if min_gap * n_row_gaps > max_h - 1 or min_gap * n_col_gaps > max_w - 1:
 235:         return None
 236: 
 237:     row_gaps = _random_gaps(n_row_gaps, min_gap, max_gap, max_h - 1)
