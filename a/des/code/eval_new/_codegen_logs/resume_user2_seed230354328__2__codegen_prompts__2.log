+    for comp in _components_by_color(g):
+        parsed = _parse_arrow(comp["cells"], int(comp["color"]))
+        if parsed is None:
+            other_cells.update(comp["cells"])
+            continue
+        parsed["id"] = len(arrows)
+        arrows.append(parsed)
+        arrow_cells.update(parsed["cells"])
