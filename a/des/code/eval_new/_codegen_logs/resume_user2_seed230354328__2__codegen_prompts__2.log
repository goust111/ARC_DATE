+def _dilate4(cells: set[Coord], shape: tuple[int, int]) -> set[Coord]:
+    out: set[Coord] = set()
+    for cell in cells:
+        if _in_bounds(shape, cell):
+            out.add(cell)
+        for nbr in _neighbors4(cell):
+            if _in_bounds(shape, nbr):
