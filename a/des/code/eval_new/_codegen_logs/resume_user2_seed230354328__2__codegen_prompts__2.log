+GRID_W_RANGE = (14, 25)
+CHAIN_COUNT_RANGE = (2, 4)
+CHAIN_LEN_RANGE = (1, 4)
+RELAY_GAP_RANGE = (2, 6)
+BOUNDARY_STEPS_RANGE = (2, 7)
+OBSTACLE_GAP_RANGE = (2, 6)
