+        "relay_counts": [int(trace["relay_count"]) for trace in traces],
+        "directions": {tuple(map(int, arrow["dir"])) for arrow in scene["arrows"]},
+    }
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
