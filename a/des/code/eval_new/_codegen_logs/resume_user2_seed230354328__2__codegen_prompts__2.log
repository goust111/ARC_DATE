+        if max(metrics["relay_counts"]) < 1:
+            continue
+        if len(metrics["directions"]) < 2:
+            continue
+
+        out = main(grid)
+        if np.array_equal(grid, out):
+            continue
+
+        return grid
+
+    raise RuntimeError("failed to generate a valid arrow-relay scene")

