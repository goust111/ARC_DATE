def _touching_edges(cells: tuple[tuple[int, int], ...], h: int, w: int) -> set[str]:
    edges: set[str] = set()
    for r, c in cells:
        if r == 0:
            edges.add("top")
        if r == h - 1:
            edges.add("bottom")
        if c == 0:
            edges.add("left")
        if c == w - 1:
            edges.add("right")
    return edges


def _bbox(cells: tuple[tuple[int, int], ...]) -> tuple[int, int, int, int]:
    rows = [r for r, _ in cells]
