+    payload_map = {tuple(item["cell"]): int(item["color"]) for item in payloads}
+    return {
+        "grid": g,
+        "arrows": arrows,
+        "slot_to_arrow": slot_to_arrow,
+        "arrow_cells": arrow_cells,
+        "payloads": payloads,
+        "payload_map": payload_map,
+        "obstacle_cells": obstacle_cells,
+    }
