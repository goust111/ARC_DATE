            c1 = int(cols.max())
            assert np.all(mask[:, c0 : c1 + 1].any(axis=0)), "vertical slide keeps a fixed full column span"
            width = int(c1 - c0 + 1)
            assert area % width == 0
            height = int(area // width)
            if direction == "up":
                r0 = int(rows.min())
            else:
                r0 = int(rows.max()) - height + 1

        out[mask] = BG
        out[r0 : r0 + height, c0 : c0 + width] = int(color)

    return out


