+                if geom is None:
+                    continue
+                arrow_cells = set(geom["cells"])
+                if any(
+                    cell in halo
+                    or cell in scene_halo
+                    or cell in reserved
+                    or cell in scene_reserved
+                    or cell in scene_slots
+                    for cell in arrow_cells
+                ):
+                    continue
+                placed = geom
+                break
+            if placed is None:
+                ok = False
+                break
