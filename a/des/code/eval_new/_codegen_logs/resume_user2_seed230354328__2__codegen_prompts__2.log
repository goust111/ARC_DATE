+        elif terminal_mode == "obstacle":
+            gap = random.randint(*OBSTACLE_GAP_RANGE)
+            path_cells = _ray_cells(emit, last_dir, gap)
+            obstacle = _add(emit, last_dir, gap)
+            if not path_cells or not _in_bounds(shape, obstacle):
