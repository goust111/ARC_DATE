+    counts_in_order: list[int] = []
+    for row_idx in range(len(line_rows) - 1):
+        rr = slice(line_rows[row_idx] + 1, line_rows[row_idx + 1])
+        left = sub[rr, line_cols[0] + 1 : line_cols[1]]
+        right = sub[rr, line_cols[1] + 1 : line_cols[2]]
