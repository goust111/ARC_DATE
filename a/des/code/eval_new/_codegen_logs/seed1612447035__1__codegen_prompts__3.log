+            grid[inner_r + dr, left_c + dc] = int(dot_color)
+        right_cell = grid[inner_r : inner_r + cell_size, right_c : right_c + cell_size]
+        pattern = patterns[count]
+        mask = pattern != int(bg)
+        right_cell[mask] = pattern[mask]
