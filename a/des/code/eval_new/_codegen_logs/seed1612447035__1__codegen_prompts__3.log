+def _draw_legend(
+    grid: np.ndarray,
+    top: int,
+    left: int,
+    bg: int,
+    line_color: int,
+    dot_color: int,
+    cell_size: int,
+    counts: list[int],
+    patterns: dict[int, np.ndarray],
+) -> None:
