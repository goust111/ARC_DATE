+    line_cols = [c for c in range(sub.shape[1]) if np.all(sub[:, c] == int(line_color))]
+    if len(line_rows) < 4 or len(line_cols) != 3:
+        return None
+    if line_rows[0] != 0 or line_rows[-1] != sub.shape[0] - 1:
