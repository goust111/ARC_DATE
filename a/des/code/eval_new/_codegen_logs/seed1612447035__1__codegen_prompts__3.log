+        legend_top,
+        legend_left,
+        bg,
+        line_color,
+        cell_size,
+        counts,
+        patterns,  # type: ignore[arg-type]
+    )
+    _draw_legend(
+        expected,
+        legend_top,
+        legend_left,
+        bg,
+        line_color,
+        cell_size,
+        counts,
+        patterns,  # type: ignore[arg-type]
+    )
