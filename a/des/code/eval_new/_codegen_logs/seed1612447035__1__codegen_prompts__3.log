+        inner = g[r0 + 1 : r1, c0 + 1 : c1]
+        key = int(np.count_nonzero(inner != int(bg)))
+        assert key in mapping, "every dice face count must appear in the legend"
+        out[r0 + 1 : r1, c0 + 1 : c1] = np.asarray(mapping[key], dtype=int)
+
+    return out
