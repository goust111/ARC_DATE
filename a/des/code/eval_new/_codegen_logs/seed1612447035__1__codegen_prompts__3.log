+    grid[top + 1 : top + 1 + cell_size, left + 1 : left + 1 + cell_size] = int(bg)
+    for dr, dc in _random_dots(cell_size, count):
+        grid[top + 1 + dr, left + 1 + dc] = int(dot_color)
