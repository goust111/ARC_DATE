+def _pip_pool(size: int) -> list[tuple[int, int]]:
+    raw = [
+        (0, 0),
+        (0, size - 1),
+        (size - 1, 0),
+        (size - 1, size - 1),
+        (size // 2, size // 2),
+        (0, size // 2),
+        (size // 2, 0),
+        (size // 2, size - 1),
+        (size - 1, size // 2),
+        (1, 1),
+        (1, size - 2),
+        (size - 2, 1),
+        (size - 2, size - 2),
+    ]
+    seen: set[tuple[int, int]] = set()
+    pool: list[tuple[int, int]] = []
+    for r, c in raw:
+        if 0 <= r < size and 0 <= c < size and (r, c) not in seen:
+            seen.add((r, c))
+            pool.append((int(r), int(c)))
+    return pool
+
