+        (size // 2, 0),
+        (size // 2, size - 1),
+        (size - 1, size // 2),
+        (1, 1),
+        (1, size - 2),
+        (size - 2, 1),
+        (size - 2, size - 2),
+    ]
+    seen: set[tuple[int, int]] = set()
+    pool: list[tuple[int, int]] = []
+    for r, c in raw:
