+        (rr == cc),
+        (rr + cc == size - 1),
+        (rr == cc) | (rr + cc == size - 1),
+        (rr == size - 1) | (cc == 0),
+        (rr == 0) | (cc == size - 1),
+        (rr == 0) | (cc == 0) | (rr == size - 1),
+        ((rr <= mid) & (cc == 0)) | (rr == mid),
+        ((cc <= mid) & (rr == size - 1)) | (cc == mid),
