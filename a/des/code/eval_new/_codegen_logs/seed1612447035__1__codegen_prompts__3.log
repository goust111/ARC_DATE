+    occupied = np.zeros((h, w), dtype=bool)
+
+    legend_top = random.randint(0, min(1, h - legend_h))
+    legend_left = random.randint(0, min(1, w - legend_w))
+    if not _can_place(occupied, legend_top, legend_left, legend_h, legend_w, pad=1):
+        return None
+    _draw_legend(
