+            int(item["bbox"][0]),
+            int(item["bbox"][1]),
+            -(
+                (int(item["bbox"][2]) - int(item["bbox"][0]) + 1)
+                * (int(item["bbox"][3]) - int(item["bbox"][1]) + 1)
+            ),
+        )
+    )
+    return candidates[0]
