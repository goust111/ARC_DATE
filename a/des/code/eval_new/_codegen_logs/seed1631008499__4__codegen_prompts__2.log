+BG = 0
+PIPE = 5
+SOURCE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+GRID_MIN = 20
+GRID_MAX = 28
+TOTAL_SOURCES_RANGE = (3, 5)
+LINE_COUNT_RANGE = (2, 4)
+SPACING = 3
+LEFT_MARGIN = 4
+BOTTOM_MARGIN = 4
+GEN_RETRIES = 400
