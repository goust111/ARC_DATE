+
+def _sample_spaced(count: int, lo: int, hi: int, gap: int) -> list[int] | None:
+    if lo > hi:
+        return None
+    values = list(range(lo, hi + 1))
+    chosen: list[int] = []
+    for _ in range(count):
+        options = [value for value in values if all(abs(value - other) >= gap for other in chosen)]
