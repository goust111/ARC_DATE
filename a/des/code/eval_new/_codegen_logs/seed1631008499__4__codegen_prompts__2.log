+def _is_full_2x2(cells: list[tuple[int, int]]) -> bool:
+    if len(cells) != 4:
+        return False
+    r0, c0, r1, c1 = _bbox(cells)
+    if (r1 - r0 + 1, c1 - c0 + 1) != (2, 2):
