+        elif side == "left":
+            grid[r0 + 1 : r1, c0 + 1] = seed_color
+        else:
+            grid[r0 + 1 : r1, c1 - 1] = seed_color
+
+    return grid
+
+
+def _expected_output(inp: np.ndarray, specs: list[dict]) -> np.ndarray:
+    out = inp.copy()
+    for spec in specs:
