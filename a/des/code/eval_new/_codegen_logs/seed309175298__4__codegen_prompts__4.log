+                if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1] and int(grid[nr, nc]) == AZURE:
+                    marker_cells.add((nr, nc))
+        infos.append(
+            {
+                "color": color,
+                "length": len(path_cells),
+                "markers": len(marker_cells),
+                "sort_key": (min(bc for _br, bc in blocks), min(br for br, _bc in blocks)),
