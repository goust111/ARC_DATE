+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    canvas = _find_canvas(g)
+    infos = _extract_paths(g)
+
+    r0, c0, r1, c1 = canvas
+    inner_h = r1 - r0 - 1
+    inner_w = c1 - c0 - 1
