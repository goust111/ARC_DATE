+            and int(grid[r + 1, c]) == color
+            and int(grid[r, c + 1]) == color
+            and int(grid[r + 1, c + 1]) == color
+        ):
+            tops.add((r, c))
+    blocks = sorted(tops)
+    assert len(blocks) == 2, f"expected two 2x2 endpoint blocks for color {color}, got {blocks}"
+    return blocks
+
+
+def _extract_paths(grid: np.ndarray) -> list[dict]:
+    infos: list[dict] = []
