+    out = np.full_like(g, BG)
+    out[r0 : r1 + 1, c0] = GREY
+    out[r0 : r1 + 1, c1] = GREY
+    out[r0, c0 : c1 + 1] = GREY
+    out[r1, c0 : c1 + 1] = GREY
+
+    for idx, info in enumerate(infos):
+        row = r0 + 1 + idx
+        start = c0 + 1
+        length = int(info["length"])
+        azure_len = min(int(info["markers"]), length)
+        if azure_len:
+            out[row, start : start + azure_len] = AZURE
+        if azure_len < length:
+            out[row, start + azure_len : start + length] = int(info["color"])
