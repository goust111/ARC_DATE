+def _room_neighbors(room: tuple[int, int], n_rows: int, n_cols: int) -> list[tuple[int, int]]:
+    r, c = room
+    neighbors = []
+    if r > 0:
+        neighbors.append((r - 1, c))
+    if r + 1 < n_rows:
+        neighbors.append((r + 1, c))
+    if c > 0:
+        neighbors.append((r, c - 1))
+    if c + 1 < n_cols:
