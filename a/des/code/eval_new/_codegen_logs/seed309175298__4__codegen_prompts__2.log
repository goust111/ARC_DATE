+    room_boxes0, wall_rows0, wall_cols0, struct_h, struct_w = _layout_rooms(row_sizes, col_sizes, 0, 0)
+    max_top = GEN_MAX_SIDE - struct_h
+    max_left = GEN_MAX_SIDE - struct_w
