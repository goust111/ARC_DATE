+from __future__ import annotations
+
+from collections import deque
+from dataclasses import dataclass
+
+import numpy as np
+from numpy.random import default_rng
+
+
+BLACK = 0
+GREY = 5
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+OPEN_SIDES = ("top", "bottom", "left", "right")
+
+GEN_RETRIES = 400
+PLACEMENT_RETRIES = 240
+MASK_RETRIES = 120
+
+
+@dataclass(frozen=True)
+class Container:
+    top: int
+    left: int
+    height: int
+    width: int
+    open_side: str
+    marker_color: int
+    marker_local: tuple[int, int]
+    coords: np.ndarray
+
+
+@dataclass(frozen=True)
+class Stamp:
+    color: int
+    top: int
+    left: int
+    mask: np.ndarray
+    coords: np.ndarray
+
+
+def _neighbors(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _wall_mask(height: int, width: int, open_side: str) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    if open_side == "top":
+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[-1, :] = True
+    elif open_side == "bottom":
+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[0, :] = True
+    elif open_side == "left":
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, -1] = True
+    elif open_side == "right":
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, 0] = True
+    else:
+        raise ValueError(open_side)
+    return mask
+
+
+def _inner_wall_mask(height: int, width: int, open_side: str) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    if open_side == "top":
+        mask[1:-1, 0] = True
+        mask[1:-1, -1] = True
+        mask[-1, 1:-1] = True
+    elif open_side == "bottom":
+        mask[0, 1:-1] = True
+        mask[1:-1, 0] = True
+        mask[1:-1, -1] = True
+    elif open_side == "left":
+        mask[0, 1:-1] = True
+        mask[-1, 1:-1] = True
+        mask[1:-1, -1] = True
+    elif open_side == "right":
+        mask[0, 1:-1] = True
+        mask[-1, 1:-1] = True
+        mask[1:-1, 0] = True
+    else:
+        raise ValueError(open_side)
+    return mask
+
+
+def _component_mask(coords: np.ndarray, top: int, left: int, height: int, width: int) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    mask[coords[:, 0] - top, coords[:, 1] - left] = True
+    return mask
+
+
+def _find_components(
+    grid: np.ndarray,
+    *,
+    monochromatic: bool,
+    ignore: np.ndarray | None = None,
+) -> list[np.ndarray]:
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    if ignore is None:
+        ignore = np.zeros((h, w), dtype=bool)
