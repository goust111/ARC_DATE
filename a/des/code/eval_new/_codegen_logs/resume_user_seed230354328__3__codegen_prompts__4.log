+            _mark_rect(occupied, reserve)
+            spec["container_top"] = top
+            spec["container_left"] = left
+            placed = True
+            break
+        if not placed:
+            return None
+
+    for spec in specs:
+        stamp_h, stamp_w = spec["stamp_mask"].shape
