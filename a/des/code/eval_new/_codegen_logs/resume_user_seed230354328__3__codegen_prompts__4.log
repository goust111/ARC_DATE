+from numpy.random import default_rng
+
+
+BLACK = 0
+GREY = 5
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+OPEN_SIDES = ("top", "bottom", "left", "right")
+
+GEN_RETRIES = 400
+PLACEMENT_RETRIES = 240
+MASK_RETRIES = 120
