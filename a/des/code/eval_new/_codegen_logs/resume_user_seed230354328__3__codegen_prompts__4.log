+def _neighbors(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _wall_mask(height: int, width: int, open_side: str) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    if open_side == "top":
+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[-1, :] = True
+    elif open_side == "bottom":
+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[0, :] = True
+    elif open_side == "left":
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, -1] = True
+    elif open_side == "right":
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, 0] = True
+    else:
+        raise ValueError(open_side)
+    return mask
+
+
+def _inner_wall_mask(height: int, width: int, open_side: str) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    if open_side == "top":
+        mask[1:-1, 0] = True
+        mask[1:-1, -1] = True
+        mask[-1, 1:-1] = True
+    elif open_side == "bottom":
+        mask[0, 1:-1] = True
+        mask[1:-1, 0] = True
+        mask[1:-1, -1] = True
+    elif open_side == "left":
+        mask[0, 1:-1] = True
+        mask[-1, 1:-1] = True
+        mask[1:-1, -1] = True
+    elif open_side == "right":
+        mask[0, 1:-1] = True
+        mask[-1, 1:-1] = True
+        mask[1:-1, 0] = True
+    else:
+        raise ValueError(open_side)
+    return mask
+
