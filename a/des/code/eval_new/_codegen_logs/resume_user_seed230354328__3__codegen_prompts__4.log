+        mask[:, -1] = True
+        mask[-1, :] = True
+    elif open_side == "bottom":
+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[0, :] = True
+    elif open_side == "left":
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, -1] = True
+    elif open_side == "right":
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, 0] = True
+    else:
+        raise ValueError(open_side)
+    return mask
+
+
+def _inner_wall_mask(height: int, width: int, open_side: str) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    if open_side == "top":
