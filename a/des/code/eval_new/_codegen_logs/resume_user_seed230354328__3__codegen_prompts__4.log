+def _component_mask(coords: np.ndarray, top: int, left: int, height: int, width: int) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    mask[coords[:, 0] - top, coords[:, 1] - left] = True
+    return mask
+
