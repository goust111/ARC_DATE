+        canvas[slot_top + 3, slot_left + 6] = ARROW
+    elif orient == "left":
+        canvas[slot_top + 3, slot_left + 0] = ARROW
+    elif orient == "up":
+        canvas[slot_top + 0, slot_left + 3] = ARROW
+    elif orient == "down":
+        canvas[slot_top + 6, slot_left + 3] = ARROW
+    else:
