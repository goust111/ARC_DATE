MAX_MASK_SIDE = 5
BORDER = 1
PANEL_COUNT = 4
SEPARATOR_COLOR = 5
BACKGROUND_COLOR = 0
CLIP_LAST_COL_PROB = 0.2

# Binary mask sampling.
MASK_FILL_MIN = 0.4
MASK_FILL_MAX = 0.8
MIN_ACTUAL_FILL = 0.3
MAX_ACTUAL_FILL = 1.0

