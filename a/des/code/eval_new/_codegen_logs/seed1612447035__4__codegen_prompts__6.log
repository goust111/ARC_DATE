+                occupied[lower_coords[:, 0], lower_coords[:, 1]] = True
+                upper_coords = _drop_piece(_place_shape(upper, 0, probe_center + int(offset)), occupied, probe_ground)
+                width = _contact_width(lower_coords, upper_coords)
+                if width == 0:
