from collections import Counter, defaultdict, deque

import numpy as np


_RNG = np.random.default_rng()

_BG = 0
_GROUND = 5
_PIECE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
_GEN_RETRIES = 400
_PAIR_OFFSETS = (-3, -2, 2, 3)
_INPUT_SEPARATION = (
