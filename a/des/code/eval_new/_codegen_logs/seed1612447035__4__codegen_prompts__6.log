+    }
+
+
+def _sample_groups() -> list[dict]:
+    trigger_kind = str(_RNG.choice(("trigger_upper", "trigger_lower")))
+    nontrigger_kind = str(_RNG.choice(("equal_wide", "narrow")))
+    groups = [_pair_group(trigger_kind), _pair_group(nontrigger_kind)]
