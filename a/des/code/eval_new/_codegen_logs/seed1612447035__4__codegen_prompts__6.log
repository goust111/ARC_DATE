+
+
+def _mode_color(values: np.ndarray) -> int:
+    counts = np.bincount(np.asarray(values, dtype=int).ravel(), minlength=10)
+    return int(np.argmax(counts))
+
+
+def _shape_from_rows(name: str, rows: tuple[str, ...]) -> dict:
