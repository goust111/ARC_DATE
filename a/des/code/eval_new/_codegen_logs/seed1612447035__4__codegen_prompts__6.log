+            pieces.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "area": int(arr.shape[0]),
+                    "bbox": (r0, c0, r1, c1),
+                    "center_col": int((c0 + c1) // 2),
+                }
+            )
