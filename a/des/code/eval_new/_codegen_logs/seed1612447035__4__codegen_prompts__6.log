+
+def _contact_width(a: np.ndarray, b: np.ndarray) -> int:
+    aset = {(int(r), int(c)) for r, c in a}
+    bset = {(int(r), int(c)) for r, c in b}
+    cols = set()
+    for r, c in aset:
+        if (int(r) + 1, int(c)) in bset or (int(r) - 1, int(c)) in bset:
