+                return None
+            dropped = _drop_piece(_place_shape(shape, 0, marker_col), occupied, ground_r)
+            occupied[dropped[:, 0], dropped[:, 1]] = True
+            specs.append(
+                {
+                    "shape": shape,
+                    "color": int(color_pool[color_i]),
+                    "marker_col": marker_col,
+                    "final_coords": dropped,
+                }
+            )
+            color_i += 1
+    return specs
+
