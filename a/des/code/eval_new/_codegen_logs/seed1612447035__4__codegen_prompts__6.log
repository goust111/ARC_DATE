+            if int(tmp[i]["area"]) < int(tmp[j]["area"]):
+                proposals[i].append((int(tmp[j]["area"]), int(tmp[j]["color"])))
+            else:
+                proposals[j].append((int(tmp[i]["area"]), int(tmp[i]["color"])))
