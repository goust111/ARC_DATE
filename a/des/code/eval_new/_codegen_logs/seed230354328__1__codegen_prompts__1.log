+    placed_rooms = []
+    room_order = sorted(room_specs, key=lambda spec: -int(spec["room_patch"].shape[0] * spec["room_patch"].shape[1]))
+    for spec in room_order:
+        patch = spec["room_patch"]
+        positions = _find_positions(occupied, patch.shape, padding=1)
+        if not positions:
