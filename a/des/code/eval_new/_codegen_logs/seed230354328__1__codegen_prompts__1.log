+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid key-lock ARC input")

