+    ((0, 0), (0, 1), (1, 0), (1, 1)),  # top-left
+    ((0, 1), (0, 2), (1, 1), (1, 2)),  # top-right
+    ((1, 1), (1, 2), (2, 1), (2, 2)),  # bottom-right
+    ((1, 0), (1, 1), (2, 0), (2, 1)),  # bottom-left
