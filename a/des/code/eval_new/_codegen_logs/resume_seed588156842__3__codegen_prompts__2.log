+            for nr, nc in _neighbors4(int(r), int(c), g.shape[0], g.shape[1]):
+                deg += int(mask[nr, nc])
+            total += deg
+        return total
+
+    return int(max(cands, key=score))
+
+
+def _classify_marker(coords: list[tuple[int, int]]) -> str:
