+        if not placed:
+            continue
+
+        counts = Counter(int(v) for v in grid.ravel())
+        non_bg_counts = {color: count for color, count in counts.items() if color != BG}
+        if PATH not in non_bg_counts:
+            continue
+        if non_bg_counts[PATH] != max(non_bg_counts.values()):
