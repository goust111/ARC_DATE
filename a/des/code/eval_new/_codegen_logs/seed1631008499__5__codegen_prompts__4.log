+
+def _bbox_of_color(grid: np.ndarray, color: int) -> tuple[int, int, int, int]:
+    coords = np.argwhere(grid == color)
+    assert coords.size > 0, f"missing color {color}"
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return r0, c0, r1, c1
+
