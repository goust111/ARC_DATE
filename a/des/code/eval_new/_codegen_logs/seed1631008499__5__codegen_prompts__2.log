+    return _assemble_output([segments[color] for color in order])
+
+
+def _normalize_shape(line_cells: list[tuple[int, int]], connector: tuple[int, int]) -> dict:
+    all_cells = line_cells + [connector]
+    min_r = min(r for r, _ in all_cells)
