+def _is_straight_line(coords: list[tuple[int, int]]) -> bool:
+    rows = sorted({r for r, _ in coords})
+    cols = sorted({c for _, c in coords})
+    if len(rows) == 1:
+        return cols == list(range(cols[0], cols[-1] + 1))
+    if len(cols) == 1:
+        return rows == list(range(rows[0], rows[-1] + 1))
+    return False
+
