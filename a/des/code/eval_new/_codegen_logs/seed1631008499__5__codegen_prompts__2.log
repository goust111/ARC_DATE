+    if in_bounds(neg_cell) and int(grid[neg_cell]) not in (BG, TURN):
+        candidates.append((-1, neg_cell))
+    if in_bounds(pos_cell) and int(grid[pos_cell]) not in (BG, TURN):
+        candidates.append((1, pos_cell))
