                "length": random.randint(MIN_LENGTH, MAX_LENGTH),
                "sign": random.choice((-1, 1)),
                "next_color": int(colors[(i + 1) % count]),
            }
        )
    try:
        _assemble_output(segments)
    except AssertionError:
        return None
    return segments


