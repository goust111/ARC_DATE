+    norm_all = norm_line + [norm_connector]
+    return {
+        "line": norm_line,
+        "connector": norm_connector,
+        "all": norm_all,
+        "height": max(r for r, _ in norm_all) + 1,
+        "width": max(c for _, c in norm_all) + 1,
+    }
+
+
+def _input_shape(axis: str, length: int, sign: int) -> dict:
+    if axis == "h":
