+    out = np.full_like(g, bg)
+    out[g == frame_color] = frame_color
+    for pi, (si, _rot) in assignment.items():
+        color = int(pieces[pi]["color"])
+        coords = slots[si]["coords"]
+        out[coords[:, 0], coords[:, 1]] = color
+    return out
