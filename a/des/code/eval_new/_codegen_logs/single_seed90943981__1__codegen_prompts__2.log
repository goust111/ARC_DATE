+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _normalize_mask(mask: np.ndarray) -> np.ndarray:
+    assert bool(mask.any())
