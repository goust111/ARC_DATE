+    mid_r = box_h // 2
+    mid_c = box_w // 2
+
+    if top > 0:
+        mask[0, mid_c] = True
+    else:
+        mask[1, mid_c] = False
+
+    if right > 0:
+        mask[mid_r, box_w - 1] = True
+    else:
+        mask[mid_r, box_w - 2] = False
+
+    if bottom > 0:
