+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+PIECE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+MAX_GENERATION_ATTEMPTS = 400
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GRID_CHOICES = ((2, 2), (2, 3), (3, 2))
