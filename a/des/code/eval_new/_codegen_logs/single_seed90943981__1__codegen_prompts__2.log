+    blocked[
+        max(0, board_r - 1) : min(H, board_r + board.shape[0] + 1),
+        max(0, board_c - 1) : min(W, board_c + board.shape[1] + 1),
+    ] = True
+
+    piece_positions: dict[int, tuple[int, int]] = {}
+    for spec in piece_specs:
