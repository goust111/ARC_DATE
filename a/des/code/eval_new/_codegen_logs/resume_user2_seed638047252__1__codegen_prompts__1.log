+def _dilate4(mask: np.ndarray) -> np.ndarray:
+    out = np.zeros_like(mask, dtype=bool)
+    out[1:, :] |= mask[:-1, :]
+    out[:-1, :] |= mask[1:, :]
+    out[:, 1:] |= mask[:, :-1]
+    out[:, :-1] |= mask[:, 1:]
+    return out
+
