+        mask[r, c] = True
+    mask = _trim_mask(mask)
+    if not _is_connected(mask) or _has_hole(mask):
+        return None
+    return mask
+
+
+def _random_region_mask() -> np.ndarray | None:
+    factories = (_rect_mask, _notched_mask, _union_rects_mask, _polyomino_mask)
+    for _ in range(80):
