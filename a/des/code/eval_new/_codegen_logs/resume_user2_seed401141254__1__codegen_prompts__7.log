+        visible = np.zeros((h, w), dtype=bool)
+        _fill_rect(visible, core, True)  # type: ignore[arg-type]
+        try:
+            inferred = _infer_bbox_from_masks(visible, blockers)
+        except AssertionError:
+            continue
