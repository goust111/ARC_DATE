+        depths = []
+        for c in range(w):
+            d = 0
+            while d < h and bool(mask[d, c]):
+                d += 1
+            if bool(mask[d:, c].any()):
+                return None
+            depths.append(int(d))
+        return tuple(depths)
+    if side == "bottom":
