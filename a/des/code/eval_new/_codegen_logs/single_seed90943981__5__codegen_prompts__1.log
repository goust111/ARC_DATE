+        mask = np.zeros((max_depth, len(depths)), dtype=bool)
+        for c, d in enumerate(depths):
+            mask[:d, c] = True
+        return mask
+    if side == "bottom":
+        mask = np.zeros((max_depth, len(depths)), dtype=bool)
+        for c, d in enumerate(depths):
+            mask[max_depth - d :, c] = True
