+def _paste(grid: np.ndarray, patch: np.ndarray, top: int, left: int, bg: int) -> None:
+    ph, pw = patch.shape
+    window = grid[top : top + ph, left : left + pw]
+    mask = patch != int(bg)
+    window[mask] = patch[mask]
