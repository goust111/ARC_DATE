+    if side == "left":
+        mask = np.zeros((len(depths), max_depth), dtype=bool)
+        for r, d in enumerate(depths):
+            mask[r, :d] = True
+        return mask
+    mask = np.zeros((len(depths), max_depth), dtype=bool)
+    for r, d in enumerate(depths):
+        mask[r, max_depth - d :] = True
