+        "bottom": _side_profile(mask, "top"),
+        "left": _side_profile(mask, "right"),
+        "right": _side_profile(mask, "left"),
+    }
+    mirrors = {
+        "top": np.flipud(mask),
+        "bottom": np.flipud(mask),
+        "left": np.fliplr(mask),
+        "right": np.fliplr(mask),
+    }
