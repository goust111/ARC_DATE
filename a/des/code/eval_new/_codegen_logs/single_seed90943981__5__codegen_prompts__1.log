+        return None
+    if not np.array_equal(missing, np.arange(missing[0], missing[-1] + 1)):
+        return None
+    if bool(interior[: missing[0]].all()) and bool(interior[missing[-1] + 1 :].all()):
+        return int(missing[0] + 1), int(missing[-1] + 2)
+    return None
