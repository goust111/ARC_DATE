+def _extract_objects(grid: np.ndarray) -> tuple[list[dict], list[dict], int]:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    structures: list[dict] = []
+    pieces: list[dict] = []
