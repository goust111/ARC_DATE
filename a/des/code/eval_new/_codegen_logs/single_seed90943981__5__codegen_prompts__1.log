+
+def _side_profile(mask: np.ndarray, side: str) -> tuple[int, ...] | None:
+    h, w = mask.shape
+    if side == "top":
+        if not bool(mask[0].all()):
+            return None
+        depths = []
+        for c in range(w):
+            d = 0
+            while d < h and bool(mask[d, c]):
+                d += 1
+            if bool(mask[d:, c].any()):
+                return None
+            depths.append(int(d))
+        return tuple(depths)
+    if side == "bottom":
+        if not bool(mask[-1].all()):
+            return None
+        depths = []
+        for c in range(w):
+            d = 0
+            while d < h and bool(mask[h - 1 - d, c]):
+                d += 1
+            if bool(mask[: h - d, c].any()):
+                return None
+            depths.append(int(d))
+        return tuple(depths)
+    if side == "left":
+        if not bool(mask[:, 0].all()):
+            return None
+        depths = []
+        for r in range(h):
+            d = 0
+            while d < w and bool(mask[r, d]):
+                d += 1
+            if bool(mask[r, d:].any()):
+                return None
+            depths.append(int(d))
+        return tuple(depths)
+    if not bool(mask[:, -1].all()):
+        return None
+    depths = []
+    for r in range(h):
+        d = 0
+        while d < w and bool(mask[r, w - 1 - d]):
+            d += 1
+        if bool(mask[r, : w - d].any()):
