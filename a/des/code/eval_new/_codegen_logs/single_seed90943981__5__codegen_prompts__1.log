+    for r, c in coords:
+        if r == 0:
+            out.add("top")
+        if r == h - 1:
+            out.add("bottom")
+        if c == 0:
+            out.add("left")
+        if c == w - 1:
+            out.add("right")
+    return out
+
+
+def _gap_interval(edge_has_color: np.ndarray) -> tuple[int, int] | None:
+    if edge_has_color.size < 3 or not bool(edge_has_color[0]) or not bool(edge_has_color[-1]):
+        return None
+    interior = edge_has_color[1:-1]
