+    order = sorted(range(len(structures)), key=lambda idx: (len(candidates[idx]), structures[idx]["bbox"][0], structures[idx]["bbox"][1]))
+    used: set[int] = set()
+    assign: dict[int, int] = {}
+
+    def dfs(k: int) -> bool:
+        if k == len(order):
+            return True
+        si = order[k]
+        for pi in candidates[si]:
+            if pi in used:
+                continue
+            used.add(pi)
+            assign[si] = pi
+            if dfs(k + 1):
