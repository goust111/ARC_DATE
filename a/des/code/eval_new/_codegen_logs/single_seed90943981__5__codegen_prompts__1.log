+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+SIDES = ("top", "bottom", "left", "right")
+OPPOSITE = {"top": "bottom", "bottom": "top", "left": "right", "right": "left"}
+PALETTE = list(range(1, 10))
+
+GEN_RETRIES = 300
+PLACE_RETRIES = 300
+GRID_H_RANGE = (20, 30)
+GRID_W_RANGE = (20, 30)
+NUM_STRUCTURES_CHOICES = [2, 3, 3]
+DEPTH_MAX_CHOICES = [3, 4, 5]
+GAP_SPAN_RANGE = (2, 5)
+HOLE_SPAN_RANGE = (2, 5)
+MARGIN_RANGE = (1, 3)
+PADDING = 2
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((int(rr), int(cc)))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _tight_mask_and_origin(coords: list[tuple[int, int]]) -> tuple[np.ndarray, tuple[int, int]]:
+    r0, c0, r1, c1 = _bbox(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
+    return mask, (int(r0), int(c0))
+
+
+def _touch_sides(coords: list[tuple[int, int]], h: int, w: int) -> set[str]:
