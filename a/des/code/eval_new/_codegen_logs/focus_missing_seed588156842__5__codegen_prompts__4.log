+    if not np.any(empty):
+        return False
+    h, w = empty.shape
+    for comp in _components(empty):
+        if not np.any(comp[:, 0] == 0) and not np.any(comp[:, 0] == h - 1) and not np.any(comp[:, 1] == 0) and not np.any(comp[:, 1] == w - 1):
