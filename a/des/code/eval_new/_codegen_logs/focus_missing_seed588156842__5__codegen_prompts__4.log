+            sub = g[r0 : r1 + 1, c0 : c1 + 1]
+            hole_mask = sub == bg
+            if not np.any(hole_mask):
+                continue
+            if np.any(hole_mask[0, :]) or np.any(hole_mask[-1, :]) or np.any(hole_mask[:, 0]) or np.any(hole_mask[:, -1]):
