+            r0, c0, r1, c1 = _bbox(comp)
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            mask[comp[:, 0] - r0, comp[:, 1] - c0] = True
+            stamps.append({"color": color, "variants": _dihedral_signatures(mask)})
