+    sigs: set[tuple[tuple[int, int], ...]] = set()
+    for k in range(4):
+        rot = np.rot90(base, k)
+        sigs.add(_shape_signature(rot))
+        sigs.add(_shape_signature(np.fliplr(rot)))
+    return sigs
