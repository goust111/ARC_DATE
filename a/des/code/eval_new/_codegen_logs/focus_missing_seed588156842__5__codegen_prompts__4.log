+import math
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+STAMP_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+GEN_RETRIES = 400
+SHAPE_RETRIES = 300
+PLACEMENT_RETRIES = 80
