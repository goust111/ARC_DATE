+    order = sorted(range(len(stamps)), key=lambda idx: len(options[idx]))
+    used: set[int] = set()
+    assignment: dict[int, int] = {}
+
+    def dfs(pos: int) -> bool:
+        if pos == len(order):
+            return True
+        s_idx = order[pos]
+        for w_idx in options[s_idx]:
+            if w_idx in used:
+                continue
+            used.add(w_idx)
+            assignment[s_idx] = w_idx
+            if dfs(pos + 1):
