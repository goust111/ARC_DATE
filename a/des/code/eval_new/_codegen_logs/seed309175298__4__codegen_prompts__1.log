+    gap_lo, gap_hi = frame["gap_span"]  # type: ignore[misc]
+    side = frame["side"]  # type: ignore[assignment]
+    if side == "top":
+        inp[r0, gap_lo : gap_hi + 1] = BLACK
+    elif side == "bottom":
+        inp[r1, gap_lo : gap_hi + 1] = BLACK
+    elif side == "left":
+        inp[gap_lo : gap_hi + 1, c0] = BLACK
+    else:
