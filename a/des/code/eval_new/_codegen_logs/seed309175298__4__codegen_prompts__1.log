+            total_c0 = random.randint(0, w - total_w)
+            frame_r0 = total_r0 + inner_h if side == "top" else total_r0
+            frame_c0 = total_c0
+        else:
+            if inner_h < max(seed_count, gap_width):
+                continue
+            total_h = inner_h + 2
+            total_w = inner_w + (inner_w + 2)
