+    inp = np.full(shape, BLACK, dtype=int)
+    for frame in frames:
+        _draw_frame(inp, frame)
+    out = inp.copy()
+    for frame in sorted(frames, key=lambda f: f["bbox"]):  # type: ignore[index]
