+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+MAGENTA = 6
+ORANGE = 7
+AZURE = 8
+MAROON = 9
+
+FRAME_COLOR = GRAY
+END_COLOR = MAROON
+SEED_COLORS = (BLUE, RED, GREEN, YELLOW, MAGENTA, ORANGE, AZURE)
+
+SIDES = ("top", "bottom", "left", "right")
+GAP_WIDTHS = (2, 3)
+GRID_H_RANGE = (18, 30)
+GRID_W_RANGE = (18, 30)
+FRAME_COUNT_RANGE = (1, 3)
+INTERIOR_H_RANGE = (3, 7)
+INTERIOR_W_RANGE = (3, 7)
+PLACEMENT_RETRIES = 200
+GEN_RETRIES = 400
