+    reserved: set[tuple[int, int]] = set()
+    anchors: list[dict] = []
+    mandatory_specs = [("top", "down"), ("bottom", "up"), ("left", "right"), ("right", "left")]
+    color_schedule = _anchor_color_schedule(rng, colors, len(mandatory_specs) + len(_extra_specs(rng)))
