+def _random_shape(rng: random.Random) -> list[tuple[int, int]]:
+    for _ in range(300):
+        target = rng.randint(4, 7)
+        cells = {(0, 0)}
+        while len(cells) < target:
+            frontier = []
+            for r, c in cells:
