+
+
+def _paint_spec(
+    total_h: int,
+    total_w: int,
+    top: np.ndarray,
+    sep: int,
+    anchors: list[dict],
+) -> np.ndarray:
+    grid = np.full((total_h, total_w), BG, dtype=int)
+    grid[: top.shape[0], : top.shape[1]] = top
+    grid[sep, :] = GREY
+    for anchor in anchors:
