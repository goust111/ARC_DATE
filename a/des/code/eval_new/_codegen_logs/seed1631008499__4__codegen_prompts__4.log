+
+def _shape_unique_extremes(cells: list[tuple[int, int]]) -> bool:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return (
+        rows.count(min(rows)) == 1
+        and rows.count(max(rows)) == 1
+        and cols.count(min(cols)) == 1
+        and cols.count(max(cols)) == 1
+    )
+
