+def _candidate_anchor_positions(
+    shape: list[tuple[int, int]],
+    direction: str,
+    edge: str,
+    canvas_h: int,
+    canvas_w: int,
+) -> list[tuple[int, int]]:
+    ar, ac = _extreme_anchor(shape, direction)
