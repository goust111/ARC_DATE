+    for anchor in sorted(anchors, key=lambda item: (int(item["r"]), int(item["c"]))):
+        color = int(anchor["color"])
+        direction = str(anchor["direction"])
+        shape = stamps[color]
+        ar, ac = _extreme_anchor(shape, direction)
+        for sr, sc in shape:
