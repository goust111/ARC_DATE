+def _find_separator(grid: np.ndarray, bg: int) -> int:
+    rows = [
+        r
+        for r in range(grid.shape[0])
+        if int(grid[r, 0]) != bg and np.all(grid[r] == grid[r, 0])
+    ]
+    assert len(rows) == 1, "expected exactly one solid separator row"
+    return int(rows[0])
