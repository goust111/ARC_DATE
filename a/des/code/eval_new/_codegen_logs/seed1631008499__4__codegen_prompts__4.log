+    for idx, (edge, direction) in enumerate(full_specs):
+        chosen = _choose_anchor(
+            rng,
+            canvas_origin,
+            canvas_shape,
+            reserved,
+            shapes[int(color_schedule[idx])],
+            int(color_schedule[idx]),
