+    cols = [c for _, c in cells]
+    r0 = min(rows)
+    c0 = min(cols)
+    return sorted((int(r - r0), int(c - c0)) for r, c in cells)
+
+
+def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
