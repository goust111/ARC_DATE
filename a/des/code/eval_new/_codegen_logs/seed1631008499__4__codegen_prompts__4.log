+        cands = [(r, c) for r, c in cells if r == best]
+    elif direction == "down":
+        best = min(r for r, _ in cells)
+        cands = [(r, c) for r, c in cells if r == best]
+    elif direction == "left":
+        best = max(c for _, c in cells)
+        cands = [(r, c) for r, c in cells if c == best]
+    else:
