+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+AZURE = 8
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+DIR_FROM_DELTA = {v: k for k, v in DIRS.items()}
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
