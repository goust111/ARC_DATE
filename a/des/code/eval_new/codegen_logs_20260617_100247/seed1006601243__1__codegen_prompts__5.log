+    assert counts, "expected non-background content"
+    canvas_color = max(counts, key=counts.get)
+    canvas_pts = np.argwhere(g == canvas_color)
+    assert canvas_pts.size, "canvas color must be present"
+    bbox = _bbox(canvas_pts)
+    r0, c0, r1, c1 = bbox
