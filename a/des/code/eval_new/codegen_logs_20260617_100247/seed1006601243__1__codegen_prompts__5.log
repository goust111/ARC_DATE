+def _find_order_bar(
+    grid: np.ndarray,
+    bg: int,
+    canvas_color: int,
+    canvas_bbox: tuple[int, int, int, int],
+) -> tuple[list[int], str]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    r0, c0, r1, c1 = canvas_bbox
+    candidates: list[tuple[int, list[int], str]] = []
