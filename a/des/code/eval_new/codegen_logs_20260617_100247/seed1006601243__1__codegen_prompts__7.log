+    ring_mask = (g != BG) & (g != INDICATOR)
+    ring_comps = _components(ring_mask)
+    indicator_comps = _components(g == INDICATOR)
+    unused_indicators = [list(comp) for comp in indicator_comps]
+
+    for ring in ring_comps:
