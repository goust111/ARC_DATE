+            return None
+        objects.append(built)
+
+    placed = _place_objects(rng, objects)
+    if placed is None:
+        return None
+    inp, expected = placed
+
+    if inp.ndim != 2 or max(inp.shape) > 30:
+        return None
+    if expected.ndim != 2 or max(expected.shape) > 30:
+        return None
+    try:
