+    r0 = max(0, int(rows.min()) - int(rng.integers(0, 3)))
+    c0 = max(0, int(cols.min()) - int(rng.integers(0, 3)))
+    r1 = min(FULL_CANVAS - 1, int(rows.max()) + int(rng.integers(0, 3)))
+    c1 = min(FULL_CANVAS - 1, int(cols.max()) + int(rng.integers(0, 3)))
