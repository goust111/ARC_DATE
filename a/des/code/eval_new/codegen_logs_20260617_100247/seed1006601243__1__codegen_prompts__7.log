+def _gen_attempt() -> np.ndarray | None:
+    rng = np.random.default_rng()
+    n_objects = int(rng.integers(1, 4))
+    track_palette = [1, 2, 3, 4, 6, 7, 8, 9]
+    track_colors = [int(x) for x in rng.choice(track_palette, size=n_objects, replace=False)]
