+        while stack:
+            r, c = stack.pop()
+            coords.append((r, c))
+            for dr, dc in deltas:
+                rr = r + dr
+                cc = c + dc
+                if 0 <= rr < height and 0 <= cc < width and mask[rr, cc] and not seen[rr, cc]:
