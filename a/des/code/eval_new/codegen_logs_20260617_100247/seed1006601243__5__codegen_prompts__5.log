+    if kind == "h":
+        out[:, 0] = 2 * axis - arr[:, 0]
+        out[:, 1] = arr[:, 1]
+    elif kind == "v":
+        out[:, 0] = arr[:, 0]
+        out[:, 1] = 2 * axis - arr[:, 1]
+    elif kind == "d1":
+        out[:, 0] = arr[:, 1] + axis
+        out[:, 1] = arr[:, 0] - axis
+    else:
