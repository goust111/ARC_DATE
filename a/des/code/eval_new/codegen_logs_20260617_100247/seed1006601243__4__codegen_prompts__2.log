import itertools, numpy as np

def connected(mask):
    pts=[tuple(p) for p in np.argwhere(mask)]
    if not pts: return False
    seen={pts[0]}
    stack=[pts[0]]
    H,W=mask.shape
    while stack:
        r,c=stack.pop()
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and mask[nr,nc] and (nr,nc) not in seen:
