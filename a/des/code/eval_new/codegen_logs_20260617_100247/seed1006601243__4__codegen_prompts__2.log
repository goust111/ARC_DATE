+FRAME_GAP = 1
+FRAME_CAPACITY_MAX = 3
+COUNT_TRIPLES = [
+    (a, b, c)
+    for a in range(1, FRAME_CAPACITY_MAX + 1)
+    for b in range(1, FRAME_CAPACITY_MAX + 1)
+    for c in range(1, FRAME_CAPACITY_MAX + 1)
