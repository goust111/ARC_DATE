            q = p.copy()
            q[(p == a) & m] = b
            q[(p == b) & m] = a
            p = q
        for rr, cc in np.argwhere(m):
            r = int(r0 + rr)
            c = int(c0 + cc)
            out[r, c] = int(p[rr, cc])
            placed_global[r, c] = True
            placed_grp[r, c] = True

    return out

