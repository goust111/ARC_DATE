+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+STRUCTURE_COLORS = (5, 6, 8)
+GRID_RANGE = (16, 30)
+OBJECT_COUNT_RANGE = (1, 4)
+FRAME_SIDE_RANGE = (4, 9)
+GENERATION_ATTEMPTS = 400
+PLACEMENT_ATTEMPTS = 200
+RESERVE_MARGIN = 1
+SEED_TIE_BIAS = 0.45
+QUADRANTS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _frame_mask(shape: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _is_rectangular_frame(frame_mask: np.ndarray, bbox: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = bbox
+    sub = frame_mask[r0 : r1 + 1, c0 : c1 + 1]
+    h, w = sub.shape
+    if h < 3 or w < 3:
+        return False
+    return bool(np.array_equal(sub, _frame_mask((h, w))))
+
+
+def _draw_frame(grid: np.ndarray, bbox: tuple[int, int, int, int], color: int) -> None:
+    r0, c0, r1, c1 = bbox
+    grid[r0, c0 : c1 + 1] = color
+    grid[r1, c0 : c1 + 1] = color
+    grid[r0 : r1 + 1, c0] = color
+    grid[r0 : r1 + 1, c1] = color
+
+
+def _quadrant_sign(seed_r: int, seed_c: int, bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    dr = -1 if 2 * seed_r <= r0 + r1 else 1
+    dc = -1 if 2 * seed_c <= c0 + c1 else 1
+    return dr, dc
+
+
+def _copy_bbox(
+    bbox: tuple[int, int, int, int],
+    dr: int,
+    dc: int,
+) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = bbox
+    src_h = r1 - r0 + 1
+    src_w = c1 - c0 + 1
+    copy_h = src_h // 2
+    copy_w = src_w // 2
+    assert copy_h >= 1 and copy_w >= 1
+
+    if dr < 0:
+        nr1 = r0 - 1
+        nr0 = nr1 - copy_h + 1
+    else:
+        nr0 = r1 + 1
+        nr1 = nr0 + copy_h - 1
+
+    if dc < 0:
+        nc1 = c0 - 1
+        nc0 = nc1 - copy_w + 1
+    else:
+        nc0 = c1 + 1
+        nc1 = nc0 + copy_w - 1
+
+    return nr0, nc0, nr1, nc1
+
+
+def _reserve_rect(mask: np.ndarray, bbox: tuple[int, int, int, int], margin: int) -> None:
+    h, w = mask.shape
+    r0, c0, r1, c1 = bbox
+    rr0 = max(0, r0 - margin)
+    cc0 = max(0, c0 - margin)
+    rr1 = min(h - 1, r1 + margin)
+    cc1 = min(w - 1, c1 + margin)
+    mask[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+
+
+def _valid_seed_positions(
+    bbox: tuple[int, int, int, int],
+    dr: int,
+    dc: int,
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    r0, c0, r1, c1 = bbox
+    positions: list[tuple[int, int]] = []
+    tie_positions: list[tuple[int, int]] = []
+    for r in range(r0 + 1, r1):
+        for c in range(c0 + 1, c1):
+            qdr, qdc = _quadrant_sign(r, c, bbox)
+            if (qdr, qdc) != (dr, dc):
