+            first = first.T
+            second = second.T
+        if random.random() < 0.5:
+            first, second = second, first
+        mask_a = _crop_mask(first)
+        mask_b = _crop_mask(second)
+        if _assembly_options(_mask_key(mask_a), _mask_key(mask_b)) == ((side, side),):
