+
+BG = 0
+FOREGROUND_COLORS = tuple(range(1, 10))
+MAX_GENERATION_ATTEMPTS = 400
+MAX_GRID_SIZE = 30
+ROW_COUNT_CHOICES = (2, 3)
+ROW_GAP_RANGE = (1, 3)
+COL_GAP_RANGE = (1, 3)
+MARGIN_RANGE = (1, 4)
+MAX_OUTER_SIDE_BY_COUNT = {2: 21, 3: 19, 4: 15}
