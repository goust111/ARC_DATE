    return out, patches


def _gen_attempt() -> np.ndarray | None:
    count = random.choice(OBJECT_COUNT_CHOICES)
    l_choices = list(L_COUNTS_BY_OBJECT_COUNT[count])
    random.shuffle(l_choices)

    sizes = list(_FRAME_SIZES)
    random.shuffle(sizes)
