+            comps.append({"color": color, "mask": mask, "area": int(mask.sum())})
+    return comps
+
+
+def _mask_key(mask: np.ndarray) -> tuple[int, int, bytes]:
+    mask = np.asarray(mask, dtype=bool)
+    return int(mask.shape[0]), int(mask.shape[1]), mask.tobytes()
+
+
+def _mask_from_key(key: tuple[int, int, bytes]) -> np.ndarray:
+    h, w, data = key
+    return np.frombuffer(data, dtype=bool).reshape((h, w)).copy()
+
+
+def _transform_keys(mask: np.ndarray) -> tuple[tuple[int, int, bytes], ...]:
+    base = _crop_mask(np.asarray(mask, dtype=bool))
+    seen: set[tuple[int, int, bytes]] = set()
+    out: list[tuple[int, int, bytes]] = []
+    for rot in range(4):
+        spun = np.rot90(base, rot)
+        for flip in (False, True):
+            transformed = np.fliplr(spun) if flip else spun
+            key = _mask_key(_crop_mask(transformed))
+            if key not in seen:
+                seen.add(key)
+                out.append(key)
+    return tuple(out)
+
+
+@lru_cache(maxsize=None)
+def _assembly_options(
+    key_a: tuple[int, int, bytes], key_b: tuple[int, int, bytes]
+) -> tuple[tuple[int, int], ...]:
+    mask_a = _mask_from_key(key_a)
+    mask_b = _mask_from_key(key_b)
+    options: set[tuple[int, int]] = set()
+
+    for ta_key in _transform_keys(mask_a):
+        ta = _mask_from_key(ta_key)
+        coords_a = {tuple(map(int, xy)) for xy in np.argwhere(ta)}
+        h1, w1 = map(int, ta.shape)
+        for tb_key in _transform_keys(mask_b):
+            tb = _mask_from_key(tb_key)
+            coords_b = [tuple(map(int, xy)) for xy in np.argwhere(tb)]
+            h2, w2 = map(int, tb.shape)
+            for dr in range(-h2, h1 + 1):
+                for dc in range(-w2, w1 + 1):
+                    shifted = {(r + dr, c + dc) for r, c in coords_b}
+                    if coords_a & shifted:
+                        continue
+                    union = coords_a | shifted
+                    rows = [r for r, _ in union]
+                    cols = [c for _, c in union]
+                    rect_h = max(rows) - min(rows) + 1
+                    rect_w = max(cols) - min(cols) + 1
+                    if len(union) != rect_h * rect_w:
+                        continue
+                    options.add((max(rect_h, rect_w), min(rect_h, rect_w)))
