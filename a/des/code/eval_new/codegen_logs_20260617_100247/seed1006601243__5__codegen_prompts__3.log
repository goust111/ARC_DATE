029: def main(grid: np.ndarray) -> np.ndarray:
030:     """
031:     Pack the non-background rows from three separated panels into one panel, scanning panels right-to-left.
032: 
033:     Input structure:
034:     - A rectangular grid contains three equal-size panels separated by two full-height divider columns.
035:     - The background is the dominant color; divider pixels use a color that appears only in the divider columns.
036: 
037:     Rule:
038:     - Read panels from right to left, and within each panel read rows from top to bottom.
039:     - Keep each row that contains any non-background pixel, discarding all-background rows.
040:     - Place the kept rows at the bottom of a single panel-shaped output, padding above with background rows.
041: 
042:     Key insight:
043:     - The task is row packing: the divider columns mark independent panels, and only the occupied rows are moved.
044:     """
045:     g = np.asarray(grid, dtype=int)
046:     H, W = g.shape
047:     bg = int(get_bg(g))
048: 
049:     s0, s1 = _separator_columns(g, bg)
050:     panel_w = int(s0)
051:     assert H == panel_w
052: 
053:     panels = [
054:         g[:, :s0],
055:         g[:, s0 + 1 : s1],
056:         g[:, s1 + 1 :],
057:     ]
058:     rows: list[np.ndarray] = []
059:     for panel in reversed(panels):
060:         assert panel.shape == (H, panel_w)
061:         for r in range(H):
062:             row = panel[r, :]
063:             if bool(np.any(row != bg)):
064:                 rows.append(row.copy())
065: 
066:     assert 0 < len(rows) <= H
067:     for i in range(len(rows) - 1):
068:         cols_a = set(int(c) for c in range(panel_w) if int(rows[i][c]) != bg)
069:         cols_b = set(int(c) for c in range(panel_w) if int(rows[i + 1][c]) != bg)
070:         assert cols_a & cols_b, "consecutive non-bg rows must share at least one column"
071:     out = np.full((H, panel_w), bg, dtype=int)
072:     out[H - len(rows) :, :] = np.asarray(rows, dtype=int)
073:     return out
