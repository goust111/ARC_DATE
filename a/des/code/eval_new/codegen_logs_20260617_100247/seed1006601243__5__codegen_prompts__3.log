054:     col_starts = sorted({b[1] for b in slot_bboxes})
055:     assert len(slot_bboxes) == len(row_starts) * len(col_starts), (
056:         "expected a complete rectangular array of slots"
057:     )
058: 
059:     slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}
060:     assert len(slot_by_anchor) == len(slot_bboxes), "slot anchors must be unique"
061: 
062:     out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)
063:     for out_r, r0 in enumerate(row_starts):
