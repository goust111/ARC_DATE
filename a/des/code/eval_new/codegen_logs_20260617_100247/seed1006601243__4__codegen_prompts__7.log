+def _component_size(mask: np.ndarray) -> int:
+    points = np.argwhere(mask)
+    if points.size == 0:
+        return 0
+    seen = {tuple(map(int, points[0]))}
+    stack = [tuple(map(int, points[0]))]
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
