+def _enumerate_cargo_masks() -> tuple[np.ndarray, ...]:
+    masks = []
+    for bits in range(1 << (CARGO_SIZE * CARGO_SIZE)):
+        cells = np.array([(bits >> i) & 1 for i in range(CARGO_SIZE * CARGO_SIZE)], dtype=bool)
+        mask = cells.reshape(CARGO_SIZE, CARGO_SIZE)
+        area = int(mask.sum())
