+CARGO_SIZE = 3
+GAP = 1
+CENTER_OFFSET = 2
+SIDE_REACH = GAP + CARGO_SIZE
+RESERVED_SPAN = FRAME_SIZE + 2 * SIDE_REACH
+
+BG_COLOR = 0
+FRAME_COLOR = 9
