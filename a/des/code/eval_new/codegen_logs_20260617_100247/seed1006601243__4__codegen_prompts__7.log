+def _is_connected(mask: np.ndarray) -> bool:
+    return int(mask.sum()) == _component_size(mask)
+
+
+def _all_rotations_distinct(mask: np.ndarray) -> bool:
+    keys = {np.rot90(mask, k).tobytes() for k in range(4)}
+    return len(keys) == 4
