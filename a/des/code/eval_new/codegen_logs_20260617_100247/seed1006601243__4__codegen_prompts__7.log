+        cargo_r, cargo_c = _cargo_top_left(frame_r, frame_c, side)
+        out[cargo_r : cargo_r + CARGO_SIZE, cargo_c : cargo_c + CARGO_SIZE] = BG_COLOR
+        inner_r = frame_r + CENTER_OFFSET
+        inner_c = frame_c + CENTER_OFFSET
