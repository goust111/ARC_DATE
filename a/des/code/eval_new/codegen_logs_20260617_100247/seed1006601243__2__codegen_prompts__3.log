+    if r == h - 1 and h > 1 and int(grid[h - 2, c]) == color:
+        candidates.append((r, c, -1, 0))
+    if c == 0 and w > 1 and int(grid[r, 1]) == color:
+        candidates.append((r, c, 0, 1))
+    if c == w - 1 and w > 1 and int(grid[r, w - 2]) == color:
+        candidates.append((r, c, 0, -1))
