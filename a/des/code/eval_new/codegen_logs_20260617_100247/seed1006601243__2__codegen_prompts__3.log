+    w: int,
+    horizontal_rows: Sequence[int],
+    vertical_cols: Sequence[int],
+) -> List[PathSpec] | None:
+    for _ in range(50):
+        specs: List[PathSpec] = []
+        used = set()
+        ok = True
+
+        for row in horizontal_rows:
+            if random.random() < 0.5:
+                spec = (int(row), 0, 0, 1)
+            else:
+                spec = (int(row), w - 1, 0, -1)
+            cells = {(spec[0], spec[1]), (spec[0] + spec[2], spec[1] + spec[3])}
+            if used & cells:
