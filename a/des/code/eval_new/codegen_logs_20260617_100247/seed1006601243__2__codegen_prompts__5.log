+                        stack.append((nr, nc))
+            groups[color].append(_piece_from_coords(coords))
+    return groups
+
+
+def _candidate_rectangle_dims(total_area: int, pieces: list[dict[str, object]]) -> list[tuple[int, int]]:
+    dims: list[tuple[int, int]] = []
+    for h in range(1, int(total_area ** 0.5) + 1):
+        if total_area % h:
