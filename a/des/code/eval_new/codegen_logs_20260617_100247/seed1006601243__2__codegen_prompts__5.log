+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    r0, c0 = min(rows), min(cols)
+    h = max(rows) - r0 + 1
+    w = max(cols) - c0 + 1
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in coords:
+        mask[int(r - r0), int(c - c0)] = True
