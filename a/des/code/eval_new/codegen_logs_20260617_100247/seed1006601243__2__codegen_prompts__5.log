+# Generator constraints.
+MIN_PIECE_AREA = 3
+RECT_H_RANGE = (3, 7)  # inclusive low, exclusive high
+RECT_W_RANGE = (3, 9)
+MAX_RECT_AREA = 24
+GROUP_RETRIES = 120
+SAMPLE_RETRIES = 400
+PLACEMENT_RETRIES = 300
