+    if sum(int(piece["area"]) for piece in pieces) != int(H * W):
+        return 0
+
+    candidates: list[list[int]] = []
+    for piece in pieces:
+        piece_h = int(piece["h"])
+        piece_w = int(piece["w"])
+        masks = []
+        for top in range(int(H - piece_h + 1)):
