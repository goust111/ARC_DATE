+def _piece_from_coords(coords: Iterable[tuple[int, int]]) -> dict[str, object]:
+    mask = _normalize_coords(coords)
+    return {
+        "mask": mask,
+        "coords": _coords_from_mask(mask),
+        "area": int(mask.sum()),
+        "h": int(mask.shape[0]),
+        "w": int(mask.shape[1]),
+    }
