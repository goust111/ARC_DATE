+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+
+PRIMARY_COLORS = (RED, BLUE, YELLOW)
+VISIBLE_WIRE_COLORS = {RED, BLUE, YELLOW, GREEN, MAGENTA, ORANGE}
+MIX_MAP = {
+    frozenset((RED, BLUE)): MAGENTA,
+    frozenset((RED, YELLOW)): ORANGE,
+    frozenset((BLUE, YELLOW)): GREEN,
+}
