+def _side_cells(r0: int, c0: int) -> dict[str, list[tuple[int, int]]]:
+    return {
+        "up": [(r0 - 1, c0), (r0 - 1, c0 + 1)],
+        "down": [(r0 + 2, c0), (r0 + 2, c0 + 1)],
+        "left": [(r0, c0 - 1), (r0 + 1, c0 - 1)],
+        "right": [(r0, c0 + 2), (r0 + 1, c0 + 2)],
+    }
