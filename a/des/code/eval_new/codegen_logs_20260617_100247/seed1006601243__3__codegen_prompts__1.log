+                "color": int(color),
+                "template": template,
+                "anchor_mask": anchor_mask,
+                "fill_mask": fill_mask,
+                "frame_h": size + 2,
+                "frame_w": size + 2,
+                "template_h": size,
+                "template_w": size,
+            }
+        )
