+        seeds = [
+            (0, rng.randrange(size)),
+            (size - 1, rng.randrange(size)),
+            (rng.randrange(size), 0),
+            (rng.randrange(size), size - 1),
+            (rng.randrange(size), rng.randrange(size)),
