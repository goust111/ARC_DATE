+    if not np.array_equal(main(inp), out):
+        return None
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        built = _build_instance(rng)
+        if built is not None:
+            inp, _ = built
+            return inp
+    raise RuntimeError("generate_input: exhausted attempts")

