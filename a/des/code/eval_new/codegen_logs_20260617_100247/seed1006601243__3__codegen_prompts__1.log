+BG = 0
+CANVAS_LIMIT = 30
+GEN_RETRIES = 400
+OBJECT_COUNT_CHOICES = (1, 2, 3)
+INTERIOR_SIZE_RANGE = (4, 7)
+FRAME_COLORS = (5, 6, 7, 8)
+COLOR_POOL = tuple(range(1, 10))
