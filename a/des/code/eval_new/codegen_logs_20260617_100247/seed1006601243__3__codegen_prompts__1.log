+            if len(inner_colors) != 1:
+                continue
+            inner_color = next(iter(inner_colors))
+            anchor_mask = inner == inner_color
+            frames.append(
+                {
+                    "bbox": (r0, c0, r1, c1),
+                    "inner_color": int(inner_color),
+                    "anchor_mask": anchor_mask,
