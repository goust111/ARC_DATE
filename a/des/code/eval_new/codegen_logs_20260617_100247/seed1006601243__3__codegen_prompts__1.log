+    canvas[top + h + 1, left : left + w + 2] = frame_color
+    canvas[top : top + h + 2, left] = frame_color
+    canvas[top : top + h + 2, left + w + 1] = frame_color
+    canvas[top + 1 : top + h + 1, left + 1 : left + w + 1][anchor_mask] = inner_color
+
+
