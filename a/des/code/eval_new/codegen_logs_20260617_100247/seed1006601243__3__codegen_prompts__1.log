+        matches: list[np.ndarray] = []
+        seen = set()
+        for k in range(4):
+            rotated = np.rot90(template, k)
+            if rotated.shape != anchor_mask.shape:
+                continue
+            if np.all(rotated[anchor_mask]):
+                key = _rotation_key(rotated)
+                if key in seen:
+                    continue
+                seen.add(key)
+                matches.append(rotated)
