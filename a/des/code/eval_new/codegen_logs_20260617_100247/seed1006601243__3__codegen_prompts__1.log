+        for r, c in seeds:
+            mask[r, c] = True
+
+        while int(mask.sum()) < target:
+            cells = np.argwhere(mask)
+            if rng.random() < 0.82:
+                cr, cc = map(int, cells[rng.randrange(len(cells))])
+                dr, dc = rng.choice(DIRS8)
+                nr, nc = cr + dr, cc + dc
+            else:
+                nr, nc = rng.randrange(size), rng.randrange(size)
+            if 0 <= nr < size and 0 <= nc < size:
