+        assert len(matches) == 1, f"rotation not uniquely determined for color {color}"
+        fill_mask = matches[0]
+        r0, c0, r1, c1 = frame["bbox"]
+        inner = out[r0 + 1 : r1, c0 + 1 : c1]
+        inner[:] = BG
+        inner[fill_mask] = color
+
+    return out
