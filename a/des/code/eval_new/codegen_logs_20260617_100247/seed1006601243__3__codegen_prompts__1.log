+    frame_color = rng.choice(FRAME_COLORS)
+    template_colors = rng.sample([c for c in COLOR_POOL if c != frame_color], n_objects)
+
+    specs: list[dict[str, object]] = []
+    dims: list[tuple[int, int]] = []
+    for color in template_colors:
