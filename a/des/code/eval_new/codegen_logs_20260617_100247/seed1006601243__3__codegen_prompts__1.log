+    left_margin = rng.randint(0, min(3, c0))
+    bottom_margin = rng.randint(0, min(3, CANVAS_LIMIT - 1 - r1))
+    right_margin = rng.randint(0, min(3, CANVAS_LIMIT - 1 - c1))
