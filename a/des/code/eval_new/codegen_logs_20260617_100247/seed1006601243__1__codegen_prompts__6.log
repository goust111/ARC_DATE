+        if max_c0 < 1:
+            return None
+        if prev_c0 is None:
+            c0 = rng.randint(1, max_c0)
+        else:
+            lo = max(1, prev_c0 - 4)
+            hi = min(max_c0, prev_c0 + 4)
+            if lo > hi:
+                return None
+            c0 = rng.randint(lo, hi)
+        positions.append((row, c0, outer_h, outer_w))
+        row += outer_h + rng.randint(1, 3)
