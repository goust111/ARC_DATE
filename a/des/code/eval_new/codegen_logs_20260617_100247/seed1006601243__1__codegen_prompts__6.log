+def _overlap_with_next(specs: list[ContainerSpec], index: int) -> list[int]:
+    source = specs[index]
+    target = specs[index + 1]
+    lo = max(source.c0 + 1, target.c0 + 1)
+    hi = min(source.c1 - 1, target.c1 - 1)
+    if lo > hi:
