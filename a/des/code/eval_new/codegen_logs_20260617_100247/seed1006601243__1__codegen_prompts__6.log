+from __future__ import annotations
+
+import random
+from dataclasses import dataclass
+
+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+GEN_RETRIES = 600
+
+
+@dataclass
+class Container:
+    r0: int
+    c0: int
+    r1: int
+    c1: int
+    border_color: int
+    gap_cols: tuple[int, ...]
+    stacks: list[list[int]]
+
+    @property
+    def inner_h(self) -> int:
+        return self.r1 - self.r0 - 1
+
+    @property
+    def inner_w(self) -> int:
+        return self.c1 - self.c0 - 1
+
+
+@dataclass
+class ContainerSpec:
+    r0: int
+    c0: int
+    outer_h: int
+    outer_w: int
+    border_color: int
+    liquid_color: int
+    gap_cols: tuple[int, ...]
+    heights: list[int]
+
+    @property
+    def r1(self) -> int:
+        return self.r0 + self.outer_h - 1
+
+    @property
+    def c1(self) -> int:
+        return self.c0 + self.outer_w - 1
+
+    @property
+    def inner_h(self) -> int:
+        return self.outer_h - 2
+
+    @property
+    def inner_w(self) -> int:
+        return self.outer_w - 2
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _extract_container(grid: np.ndarray, color: int, comp: list[tuple[int, int]]) -> Container | None:
+    rows = [r for r, _ in comp]
+    cols = [c for _, c in comp]
+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return None
+
+    gap_cols = [c for c in range(c0 + 1, c1) if int(grid[r1, c]) == BG]
+    if gap_cols:
+        expected_gap = list(range(gap_cols[0], gap_cols[-1] + 1))
+        if gap_cols != expected_gap:
+            return None
+    for c in range(c0 + 1, c1):
+        val = int(grid[r1, c])
+        if val not in (BG, color):
+            return None
+
+    expected: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        expected.add((r0, c))
+    for r in range(r0 + 1, r1 + 1):
+        expected.add((r, c0))
+        expected.add((r, c1))
+    for c in range(c0 + 1, c1):
+        if c not in gap_cols:
+            expected.add((r1, c))
+    if set(comp) != expected:
+        return None
+
+    if np.any(grid[r0 + 1 : r1, c0 + 1 : c1] == color):
+        return None
+
+    stacks: list[list[int]] = []
+    for c in range(c0 + 1, c1):
+        stack: list[int] = []
+        for r in range(r1 - 1, r0, -1):
+            val = int(grid[r, c])
+            if val == BG:
+                continue
+            if val == color:
+                return None
+            stack.append(val)
+        stacks.append(stack)
+
+    return Container(r0, c0, r1, c1, color, tuple(gap_cols), stacks)
+
+
+def _find_containers(grid: np.ndarray) -> list[Container]:
+    containers: list[Container] = []
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != BG):
+        for comp in _components(grid == color):
+            container = _extract_container(grid, color, comp)
+            if container is not None:
+                containers.append(container)
