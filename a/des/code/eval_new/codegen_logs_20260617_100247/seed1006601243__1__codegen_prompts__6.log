+            must_have_liquid=must_have_liquid,
+            must_fill_gap=bool(gap_cols),
+            keep_non_gap=bool(gap_cols) and spec.inner_w > len(gap_cols),
+        )
+        specs.append(
+            ContainerSpec(
+                r0=spec.r0,
+                c0=spec.c0,
+                outer_h=spec.outer_h,
+                outer_w=spec.outer_w,
+                border_color=spec.border_color,
