+            left = piece_left + cc * (inner_w + gap_x)
+            slots.append((int(top), int(left)))
+    return slots
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rng = RNG
+    piece_count = int(rng.integers(2, 5))
+    inner_h = int(rng.integers(4, 8))
