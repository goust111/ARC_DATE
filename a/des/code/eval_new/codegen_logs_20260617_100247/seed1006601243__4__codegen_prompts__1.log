+    mapping = _extract_legend(g)
+    rooms = _find_rooms(g[:-3, :])
+
+    out = g.copy()
+    for room in rooms:
+        rows = room[:, 0]
+        cols = room[:, 1]
+        r0 = int(rows.min())
+        c0 = int(cols.min())
