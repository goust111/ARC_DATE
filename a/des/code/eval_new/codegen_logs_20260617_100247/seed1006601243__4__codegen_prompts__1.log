+    cur = top
+    for height in row_heights:
+        cur += height + 1
+        row_walls.append(cur)
+
+    col_walls = [left]
+    cur = left
+    for width in col_widths:
+        cur += width + 1
+        col_walls.append(cur)
+
+    rooms: list[tuple[int, int, int, int]] = []
+    for i in range(len(row_heights)):
