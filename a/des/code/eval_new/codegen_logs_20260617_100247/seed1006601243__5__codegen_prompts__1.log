+        grid = _render_input(h, w, seed_cells, blocks)
+        planned_sequence = [
+            (block["base_color"], block["direction"], block["length"]) for block in blocks
+        ]
+        if _validate_generated_case(grid, planned_sequence, planned, first_start):
