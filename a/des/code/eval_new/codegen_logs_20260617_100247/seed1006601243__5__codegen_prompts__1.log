+    for direction, length in zip(directions, lengths):
+        dr, dc = direction
+        end = (current[0] + dr * length, current[1] + dc * length)
+        steps.append(
+            {
+                "start": current,
+                "end": end,
+                "direction": direction,
+                "length": length,
+            }
+        )
+        current = end
+    return steps
