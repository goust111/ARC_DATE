+                w=w,
+                anchor=anchor,
+                location_sides=location_sides,
+                grow_side=grow_side,
+                length=length,
+                occupied=occupied,
+            )
+            if not candidates:
+                ok = False
+                break
+            chosen = rng.choice(candidates)
+            bbox = chosen["bbox"]
+            markers = _marker_cells(bbox, length, rng)
+            block = {
+                "bbox": bbox,
+                "pin": chosen["pin"],
+                "direction": SIDE_TO_DIR[grow_side],
+                "length": length,
+                "base_color": color,
+                "markers": markers,
+            }
+            blocks.append(block)
