+def _sample_blocks(
+    h: int,
+    w: int,
+    seed_cells: set[tuple[int, int]],
+    path_cells: set[tuple[int, int]],
+    anchors: list[tuple[int, int]],
+    directions: list[tuple[int, int]],
+    lengths: list[int],
+    first_side: str,
+    rng: random.Random,
+) -> list[dict] | None:
