from __future__ import annotations

import random
from collections import deque

import numpy as np


BLACK = 0
GREEN = 3
YELLOW = 4
GREY = 5

DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
SIDE_TO_DIR = {
    "up": (-1, 0),
    "down": (1, 0),
    "left": (0, -1),
    "right": (0, 1),
}
DIR_TO_SIDE = {value: key for key, value in SIDE_TO_DIR.items()}
BASE_COLORS = [1, 2, 6, 7, 8, 9]

GRID_RANGE = (18, 28)
STEP_COUNT_RANGE = (3, 5)
STEP_LENGTH_RANGE = (1, 4)
BLOCK_DIMS = [
    (2, 2),
    (2, 3),
    (3, 2),
    (2, 4),
    (4, 2),
    (3, 3),
    (3, 4),
    (4, 3),
]
BLOCK_GAPS = [2, 3, 4]
ANCHOR_MARGIN = 4
GEN_ATTEMPTS = 400
PATH_ATTEMPTS = 120
PLACEMENT_ATTEMPTS = 80


SEED_PATTERNS = [
    {
        "cells": {(0, 0)},
        "anchors": {"up": (0, 0), "down": (0, 0), "left": (0, 0), "right": (0, 0)},
    },
    {
        "cells": {(0, 0), (0, 1)},
        "anchors": {"left": (0, 0), "right": (0, 1)},
    },
    {
        "cells": {(0, 0), (1, 0)},
        "anchors": {"up": (0, 0), "down": (1, 0)},
    },
    {
        "cells": {(0, 0), (0, 1), (0, 2)},
        "anchors": {"left": (0, 0), "right": (0, 2)},
    },
    {
        "cells": {(0, 0), (1, 0), (2, 0)},
        "anchors": {"up": (0, 0), "down": (2, 0)},
    },
    {
        "cells": {(0, 0), (1, 0), (1, 1)},
        "anchors": {"up": (0, 0), "right": (1, 1)},
    },
    {
        "cells": {(0, 0), (0, 1), (1, 0)},
        "anchors": {"right": (0, 1), "down": (1, 0)},
    },
    {
        "cells": {(0, 0), (0, 1), (1, 1)},
        "anchors": {"left": (0, 0), "down": (1, 1)},
    },
    {
        "cells": {(0, 1), (1, 0), (1, 1)},
        "anchors": {"up": (0, 1), "left": (1, 0)},
    },
]


def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]


def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    h, w = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    comps: list[list[tuple[int, int]]] = []
