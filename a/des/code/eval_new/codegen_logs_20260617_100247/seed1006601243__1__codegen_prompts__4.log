+import numpy as np
+
+
+BG = 0
+DIGIT_COLOR = 1
+WALL = 5
+LEGEND_WIDTH = 7
+
+DIGIT_SHAPES = {
+    1: (
+        (0, 1),
+        (1, 0), (1, 1),
+        (2, 1),
+        (3, 1),
+        (4, 0), (4, 1), (4, 2),
