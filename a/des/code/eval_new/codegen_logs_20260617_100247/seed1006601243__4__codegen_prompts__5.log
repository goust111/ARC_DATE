+    out = np.array(g, dtype=int).copy()
+    for r0, c0, r1, c1, majority, minority in frames:
+        out[r0, c0 : c1 + 1] = minority
+        out[r1, c0 : c1 + 1] = minority
+        out[r0 : r1 + 1, c0] = minority
+        out[r0 : r1 + 1, c1] = minority
