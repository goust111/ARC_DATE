+    side_min = min(GRID_SIDE_MAX, GRID_BASE_MIN + GRID_GROWTH_PER_FRAME * (frame_count - 1))
+    height = random.randint(side_min, GRID_SIDE_MAX)
+    width = random.randint(side_min, GRID_SIDE_MAX)
