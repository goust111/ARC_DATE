+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in neighbors:
+                    nr, nc = rr + dr, cc + dc
+                    if not _in_bounds(h, w, nr, nc):
+                        continue
+                    if not mask[nr, nc] or seen[nr, nc]:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
