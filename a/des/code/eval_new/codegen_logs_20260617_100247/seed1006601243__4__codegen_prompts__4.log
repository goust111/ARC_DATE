+    if direction == "down":
+        return [(pattern_r0 + 3, pattern_c0 + dc) for dc in range(3)]
+    if direction == "left":
+        return [(pattern_r0 + dr, pattern_c0 - 1) for dr in range(3)]
+    return [(pattern_r0 + dr, pattern_c0 + 3) for dr in range(3)]
