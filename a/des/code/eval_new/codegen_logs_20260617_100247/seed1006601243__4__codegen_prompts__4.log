+def _assemble_input(top_h: int, bottom_h: int, width: int, stamps: list[dict], anchors: dict[int, tuple[int, int]]) -> np.ndarray:
+    grid = np.full((top_h + 1 + bottom_h, width), BG, dtype=int)
