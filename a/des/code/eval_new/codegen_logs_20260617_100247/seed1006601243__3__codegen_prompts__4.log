+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+RNG = np.random.default_rng()
+
+MAX_SIDE = 30
+MASTER_SIDE = 30
+GEN_ATTEMPTS = 400
+PLACEMENT_ATTEMPTS = 250
+MIN_GROUP_GAP = 1
+MIN_EDGE_MARGIN = 1
+LAYER_OPTIONS = (1, 2, 3, 4)
+GROUP_COUNT_OPTIONS = (2, 3)
+PATTERN_DIM_OPTIONS = (
+    (3, 4),
+    (4, 3),
+    (3, 5),
+    (5, 3),
+    (4, 5),
+    (5, 4),
+)
