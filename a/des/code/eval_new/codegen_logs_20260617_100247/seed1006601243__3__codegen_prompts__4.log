+        r0, c0, r1, c1 = map(int, frame["bbox"])
+        inner = g[r0 + 1 : r1, c0 + 1 : c1]
+        out[r0 + 1 : r1, c0 + 1 : c1] = _apply_flip_sequence(inner, depth)
+
+    return out
