+    parents = _parent_indices(frames)
+    child_count = [0] * len(frames)
+    for parent in parents:
+        if parent != -1:
+            child_count[parent] += 1
+
+    out = g.copy()
+    for idx, frame in enumerate(frames):
+        if child_count[idx] != 0:
+            continue
+        depth = 1
+        parent = parents[idx]
+        while parent != -1:
+            depth += 1
+            parent = parents[parent]
