+def _d4_variant_count(arr: np.ndarray) -> int:
+    cur = arr
+    keys: set[tuple[tuple[int, int], bytes]] = set()
+    for _ in range(4):
+        keys.add((tuple(map(int, cur.shape)), cur.tobytes()))
+        flip = np.fliplr(cur)
+        keys.add((tuple(map(int, flip.shape)), flip.tobytes()))
+        cur = np.rot90(cur)
+    return len(keys)
