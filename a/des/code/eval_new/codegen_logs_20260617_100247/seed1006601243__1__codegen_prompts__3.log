+    return False
+
+
+def _block_candidates(grid: np.ndarray, used_blocks: np.ndarray) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    out: list[tuple[int, int]] = []
+    for r in range(BOARD_TOP, h - 1):
+        for c in range(0, w - 1):
