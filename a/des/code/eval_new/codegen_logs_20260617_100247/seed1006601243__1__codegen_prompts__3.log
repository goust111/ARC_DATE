+
+def _place_blocks(grid: np.ndarray, colors: list[int]) -> dict[int, tuple[int, int]] | None:
+    used_blocks = np.zeros_like(grid, dtype=bool)
+    positions: dict[int, tuple[int, int]] = {}
+    for color in colors:
