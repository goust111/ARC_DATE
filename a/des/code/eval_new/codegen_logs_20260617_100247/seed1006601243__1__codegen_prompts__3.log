+def _obstacle_score(grid: np.ndarray, top: int, left: int) -> tuple[int, int]:
+    h, w = grid.shape
+    margin = min(top - BOARD_TOP, h - (top + 2), left, w - (left + 2))
+    ring = [
+        (top - 1, left),
+        (top - 1, left + 1),
+        (top + 2, left),
+        (top + 2, left + 1),
+        (top, left - 1),
+        (top + 1, left - 1),
+        (top, left + 2),
+        (top + 1, left + 2),
