+            "orientation": "v",
+            "line_offset": cut,
+            "bbox_h": height,
+            "bbox_w": width + 1,
+            "input_local": input_cells,
+            "output_local": whole,
+        }
+
+    return None
+
+
+def _sample_untouched_shape() -> dict[str, object] | None:
+    for _ in range(120):
