+DIR8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if dr or dc]
+
+
+def _component_count(cells: set[tuple[int, int]]) -> int:
+    if not cells:
+        return 0
+
+    remaining = set(cells)
+    count = 0
+    while remaining:
+        count += 1
+        stack = [remaining.pop()]
+        while stack:
+            r, c = stack.pop()
