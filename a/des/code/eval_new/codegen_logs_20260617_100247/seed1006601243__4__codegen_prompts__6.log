+            (1, 0),
+            (0, 1),
+            (1, 1),
+            (2, 0),
+            (0, 2),
+            (2, 1),
+            (1, 2),
+        ]
+    )
+
+
+def _build_scene() -> tuple[np.ndarray, np.ndarray] | None:
+    h_count, v_count = _choose_line_pattern()
+    height = random.randint(max(16, 11 + 4 * h_count), 28)
+    width = random.randint(max(16, 11 + 4 * v_count), 28)
