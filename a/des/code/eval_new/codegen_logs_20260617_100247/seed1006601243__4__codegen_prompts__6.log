+    for line_c in vertical:
+        inp[0, line_c] = YELLOW
+        inp[height - 1, line_c] = YELLOW
+
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        scene = _build_scene()
+        if scene is None:
+            continue
+        inp, out = scene
+        if np.array_equal(main(inp), out):
