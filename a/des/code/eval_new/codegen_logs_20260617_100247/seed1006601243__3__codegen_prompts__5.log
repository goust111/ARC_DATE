+        if far_max_r0 < 1:
+            continue
+        far_r0 = int(rng.integers(1, far_max_r0 + 1))
+        far_c0 = int(target_front_col - int(shape_far["front"][1]))
+        near_c0 = int(target_front_col - int(shape_near["front"][1]))
+        if not _can_place(placed, far_r0, far_c0, shape_far, h, w):
+            continue
