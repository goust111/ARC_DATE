+            "r0": int(r0),
+            "c0": int(c0),
+            "box": _bbox_with_padding(int(r0), int(c0), int(shape["height"]), int(shape["width"])),
+        }
+    return None
+
+
+def _place_random_seed(
+    rng: np.random.Generator,
+    placed: list[dict[str, object]],
+    shape: dict[str, object],
+    h: int,
+    w: int,
+) -> dict[str, object] | None:
