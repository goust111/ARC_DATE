+        far_info = {
+            "shape": shape_far,
+            "r0": int(far_r0),
+            "c0": int(far_c0),
+            "box": _bbox_with_padding(int(far_r0), int(far_c0), int(shape_far["height"]), int(shape_far["width"])),
+        }
+        if not _can_place(placed + [far_info], near_r0, near_c0, shape_near, h, w):
