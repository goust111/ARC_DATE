+def _normalize_shape(coords: tuple[tuple[int, int], ...] | list[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    rows = [int(r) for r, _ in coords]
+    cols = [int(c) for _, c in coords]
+    r0 = min(rows)
+    c0 = min(cols)
