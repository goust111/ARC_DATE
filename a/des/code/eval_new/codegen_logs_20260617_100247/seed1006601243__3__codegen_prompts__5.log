+    low, high = _front_col_range(shape, w)
+    for _ in range(80):
+        side = "left" if int(rng.integers(2)) == 0 else "right"
+        if side == "left":
+            t_low = low
+            t_high = min(high, int(shape["height"]) - 1)
+        else:
+            t_low = max(low, w - int(shape["height"]))
+            t_high = high
+        if t_low > t_high:
