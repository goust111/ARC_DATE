+def _bottom_front(shape: tuple[tuple[int, int], ...]) -> tuple[int, int] | None:
+    max_r = max(r for r, _ in shape)
+    frontier = [(r, c) for r, c in shape if r == max_r]
+    if len(frontier) != 1:
