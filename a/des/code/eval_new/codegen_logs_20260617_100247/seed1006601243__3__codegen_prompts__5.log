+        return shapes
+    return None
+
+
+def _random_r0(rng: np.random.Generator, shape: dict[str, object], h: int) -> int | None:
+    max_r0 = int(h - int(shape["height"]) - int(shape["width"]) - 1)
+    if max_r0 < 1:
+        return None
+    return int(rng.integers(1, max_r0 + 1))
