+
+def _place_collinear_pair(
+    rng: np.random.Generator,
+    placed: list[dict[str, object]],
+    shape_far: dict[str, object],
+    shape_near: dict[str, object],
+    h: int,
+    w: int,
+) -> tuple[dict[str, object], dict[str, object]] | None:
