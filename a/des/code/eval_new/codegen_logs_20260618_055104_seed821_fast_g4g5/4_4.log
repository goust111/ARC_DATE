import numpy as np
from typing import List, Tuple


Cell = Tuple[int, int]


def _most_frequent_color(grid: np.ndarray) -> int:
    \"\"\"Return the most frequent color in the full grid.\"\"\"
    flat = np.ravel(grid)
    counts = np.bincount(flat.astype(np.int64))
    return int(np.argmax(counts))


def _extract_palette(grid: np.ndarray, background: int) -> List[int]:
    \"\"\"Read palette colors from the bottom row, left to right.\"\"\"
    bottom = grid[-1]
    palette = [int(v) for v in bottom if int(v) "'!= background]
    return palette


def _connected_components(mask: np.ndarray) -> List[List[Cell]]:
    """Find 4-connected components in a boolean mask."""
    h, w = mask.shape
    visited = np.zeros((h, w), dtype=bool)
    components: List[List[Cell]] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or visited[r, c]:
                continue
            stack: List[Cell] = [(r, c)]
            visited[r, c] = True
            comp: List[Cell] = []

            while stack:
                y, x = stack.pop()
                comp.append((y, x))
                if y > 0 and mask[y - 1, x] and not visited[y - 1, x]:
                    visited[y - 1, x] = True
                    stack.append((y - 1, x))
                if y + 1 < h and mask[y + 1, x] and not visited[y + 1, x]:
                    visited[y + 1, x] = True
                    stack.append((y + 1, x))
                if x > 0 and mask[y, x - 1] and not visited[y, x - 1]:
                    visited[y, x - 1] = True
                    stack.append((y, x - 1))
                if x + 1 < w and mask[y, x + 1] and not visited[y, x + 1]:
                    visited[y, x + 1] = True
                    stack.append((y, x + 1))

            components.append(comp)
    return components


def main(grid: np.ndarray) -> np.ndarray:
    """ARC recolor-sort solver for scale-homologous shapes.

    Input
    -----
    grid : np.ndarray
        A 2D integer ARC grid where the background is the most frequent color and
        the bottom row stores the palette colors separated by background pixels.

    Output
    ------
    np.ndarray
        The solved grid where the K detected non-background connected components
        above the palette row are recolored by ascending area and the palette row
        is replaced by the background color.

    Algorithm
    ---------
    1) Find background as mode color.
    2) Read palette colors from the bottom row, left to right.
    3) Find 4-connected non-background components above the last row.
    4) Sort components by area and recolor them to palette order.
    5) Set the last row to background.

    Complexity
    ---------
    O(H * W) time and O(H * W) space.
    """
    grid = np.asarray(grid)
    h, w = grid.shape
    background = _most_frequent_color(grid)
    palette = _extract_palette(grid, background)

    result = np.array(grid, copy=True)

    non_bg = grid[: h - 1] != background
    components = _connected_components(non_bg)
    components.sort(key=len)

    for color, comp in zip(palette, components):
        for y, x in comp:
            result[y, x] = color

    if h > 0:
        result[h - 1, :] = background
    return result


def _random_connected_mask(rng: np.random.Generator) -> np.ndarray:
    """Generate a small random connected boolean mask."""
    target_cells = int(rng.integers(5, 11))
    active = {(0, 0)}
    frontier = [(0, 0)]

    while len(active) < target_cells:
        y, x = frontier[int(rng.integers(0, len(frontier)))]
        candidates = []
        if (y - 1, x) not in active:
            candidates.append((y - 1, x))
        if (y + 1, x) not in active:
            candidates.append((y + 1, x))
        if (y, x - 1) not in active:
            candidates.append((y, x - 1))
        if (y, x + 1) not in active:
            candidates.append((y, x + 1))

        if not candidates:
            y, x = tuple(rng.choice(list(active)))
            continue

        ny, nx = candidates[int(rng.integers(0, len(candidates)))]
        active.add((ny, nx))
        frontier.append((ny, nx))

    ys, xs = zip(*active)
    ys = np.array(ys, dtype=int)
    xs = np.array(xs, dtype=int)
    ys -= ys.min()
    xs -= xs.min()
    mask = np.zeros((ys.max() + 1, xs.max() + 1), dtype=bool)
    mask[ys, xs] = True
    return mask


def _scaled_mask(mask: np.ndarray, factor: int) -> np.ndarray:
    h, w = mask.shape
    scaled = np.zeros((h * factor, w * factor), dtype=bool)
    ys, xs = np.where(mask)
    for y, x in zip(ys, xs):
        scaled[y * factor:(y + 1) * factor, x * factor:(x + 1) * factor] = True
    return scaled


def generate_input() -> np.ndarray:
    """Create one random but valid ARC-style instance (grid size <= 30)."""
    rng = np.random.default_rng()
    while True:
        # choose a background and palette size
        background = int(rng.integers(0, 10))
        k = int(rng.integers(2, 6))

        base = _random_connected_mask(rng)
        max_scale = min(5, k)
        scales = np.array(sorted(rng.choice(np.arange(1, 7), size=k, replace=False)), dtype=int)

        req_h = int(base.shape[0] * scales.max()) + 4
        req_w = int(base.shape[1] * scales.max()) + 4
        min_w = max(req_w, 2 * k + 1)
        if req_h > 30 or min_w > 30:
            continue

        h = int(rng.integers(req_h, 31))
        w = int(rng.integers(min_w, 31))

        grid = np.full((h, w), fill_value=background, dtype=int)
        used = np.zeros((h - 1, w), dtype=bool)

        shape_masks = [_scaled_mask(base, s) for s in scales]
        shape_colors = list(rng.integers(0, 10, size=k))

        placed = True
        for mask, color in sorted(
            zip(shape_masks, shape_colors),
            key=lambda item: item[0].size,
            reverse=True,
        ):
            mh, mw = mask.shape
            candidates = []
            for _ in range(400):
                y = int(rng.integers(0, h - 1 - mh + 1))
                x = int(rng.integers(0, w - mw + 1))
                window = used[y : y + mh, x : x + mw]
                if np.any(window & mask):
                    continue
                candidates.append((y, x, window))
                break
            if not candidates:
                placed = False
                break

            y, x, window = candidates[0]
            used[y : y + mh, x : x + mw] |= mask
            region = grid[y : y + mh, x : x + mw]
            region[mask] = color

        if not placed:
            continue

        palette_colors = list(int(c) for c in rng.choice([c for c in range(10) if c != background], size=k, replace=False))
        start = int(rng.integers(0, w - (2 * k - 1) + 1))
        for i, color in enumerate(palette_colors):
            grid[h - 1, start + 2 * i] = color

        return grid.astype(int)
