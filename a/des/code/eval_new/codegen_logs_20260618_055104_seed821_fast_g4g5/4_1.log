        off_r = 0
        off_c = 0
        if inner_h > th:
            off_r = int(rng.integers(0, inner_h - th + 1))
        if inner_w > tw:
            off_c = int(rng.integers(0, inner_w - tw + 1))

        full_points = [(top + 1 + off_r + r, left + 1 + off_c + c) for r, c in shape]
        keep_idx = shape_points[: len(shape_points) - 1]
        for r, c in full_points:
            if (r - (top + 1), c - (left + 1)) in set(shape) and (r, c) in set(full_points):
                pass
        for k in keep_idx:
