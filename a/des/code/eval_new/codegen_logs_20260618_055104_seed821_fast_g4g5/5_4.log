MAROON = 9
ORANGE = 11
SIGNAL_COLORS = {MAROON, ORANGE}
RESERVED_COLORS = {BG, GRAY, YELLOW} | SIGNAL_COLORS


def _neighbors4(h: int, w: int, r: int, c: int) -> Iterable[Tuple[int, int]]:
    \"\"\"Yield 4-neighbours for a cell inside the bounds.\"\"\"
