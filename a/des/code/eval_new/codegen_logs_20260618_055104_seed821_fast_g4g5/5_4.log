        if not can_set(sr + dr, sc + dc) or not (0 <= sr + 3 * dr < h and 0 <= sc + 3 * dc < w):
            continue
        cells = place_segment(sr, sc, chain_colors[0], dir_idx, int(rng.integers(3, 7)))
        if cells is None:
