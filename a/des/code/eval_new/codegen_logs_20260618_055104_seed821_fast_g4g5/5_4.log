import numpy as np
from collections import deque
from typing import Dict, Iterable, List, Optional, Set, Tuple

BG = 0
YELLOW = 10
GRAY = 5
MAROON = 9
ORANGE = 11
SIGNAL_COLORS = {MAROON, ORANGE}
RESERVED_COLORS = {BG, GRAY, YELLOW} | SIGNAL_COLORS


def _neighbors4(h: int, w: int, r: int, c: int) -> Iterable[Tuple[int, int]]:
    \"\"\"Yield 4-neighbour coordinates inside a grid.\"\"\"
    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
        nr, nc = r + dr, c + dc
        if 0 <= nr < h and 0 <= nc < w:
            yield nr, nc


def _decode_legend(grid: np.ndarray) -> Tuple[Dict[int, int], Optional[List[Tuple[int, int]]]]:
    \"\"\"Decode 2x2 corner legend into lamp->path-color mapping.

    Returns:
      - dict: mapping from lamp color to path color.
      - None or list of cells: 2x2 legend cell coordinates.
    \"\"\"
    h, w = grid.shape
    if h < 2 or w < 2:
        return {}, None

    candidates = []
    corners = [(0, 0), (0, w - 2), (h - 2, 0), (h - 2, w - 2)]
    for r0, c0 in corners:
        rows = [((r0, c0), (r0, c0 + 1)), ((r0 + 1, c0), (r0 + 1, c0 + 1))]
        row_pairs = []
        ok = True
        for (r_a, c_a), (r_b, c_b) in rows:
            a = int(grid[r_a, c_a])
            b = int(grid[r_b, c_b])
            if a in SIGNAL_COLORS and b not in RESERVED_COLORS:
                row_pairs.append((a, b))
            elif b in SIGNAL_COLORS and a not in RESERVED_COLORS:
                row_pairs.append((b, a))
            else:
                ok = False
                break
        if not ok:
            continue
        mapping = {lamp: path for lamp, path in row_pairs}
        score = 0
        for lamp in mapping:
            if lamp in SIGNAL_COLORS:
                score += 1
        candidates.append((score, r0, c0, mapping, {(r0, c0), (r0, c0 + 1), (r0 + 1, c0), (r0 + 1, c0 + 1)}))

    if not candidates:
        return {}, None

    candidates.sort(reverse=True, key=lambda x: x[0])
    _, r0, c0, mapping, cells = candidates[0]
    return mapping, list(cells)


def _collect_components(grid: np.ndarray, path_colors: Set[int]):
    \"\"\"Collect connected path segments per color.

    Returns a dict:
      color -> list of components
      each component is dict(id, color, cells:set, endpoints:list, cell_set:set)
    \"\"\"
    h, w = grid.shape
    used = np.zeros((h, w), dtype=bool)
    components: Dict[int, List[Dict[str, object]]] = {}

    for r in range(h):
        for c in range(w):
            color = int(grid[r, c])
            if color not in path_colors or used[r, c]:
                continue
            queue = deque([(r, c)])
            used[r, c] = True
            cells: List[Tuple[int, int]] = []

            while queue:
                cr, cc = queue.popleft()
                cells.append((cr, cc))
                for nr, nc in _neighbors4(h, w, cr, cc):
                    if used[nr, nc]:
                        continue
                    if int(grid[nr, nc]) "'!= color:
                        continue
                    used[nr, nc] = True
                    queue.append((nr, nc))

            cell_set = set(cells)
            endpoints: List[Tuple[int, int]] = []
            for cr, cc in cells:
                degree = 0
                for nr, nc in _neighbors4(h, w, cr, cc):
                    if (nr, nc) in cell_set:
                        degree += 1
                if degree <= 1:
                    endpoints.append((cr, cc))

            comp_id = (color, len(components.get(color, [])))
            component = {
                "id": comp_id,
                "color": color,
                "cells": cell_set,
                "cell_set": cell_set,
                "endpoints": endpoints,
            }
            components.setdefault(color, []).append(component)

    return components


def _component_of_pixel(components: Dict[int, List[Dict[str, object]]], r: int, c: int, color: int) -> Optional[Dict[str, object]]:
    if color not in components:
        return None
    for comp in components[color]:
        if (r, c) in comp["cell_set"]:  # type: ignore[index]
            return comp
    return None


def _other_endpoint(endpoints: List[Tuple[int, int]], origin: Tuple[int, int]) -> Tuple[int, int]:
    if not endpoints:
        return origin
    if len(endpoints) == 1:
        return endpoints[0]
    if origin in endpoints:
        return endpoints[0] if endpoints[1] == origin else endpoints[1]
    return endpoints[0]


def _bfs_bridge(
    grid: np.ndarray,
    start: Tuple[int, int],
    target: Tuple[int, int],
    path_mask: np.ndarray,
    max_steps: int = 64,
) -> Optional[List[Tuple[int, int]]]:
    """Find a short path from start to target through non-path cells.

    Allowed cells: background and signal pixels. Target pixel is always allowed.
    """
    if start == target:
        return [start]

    h, w = grid.shape
    sr, sc = start
    tr, tc = target
    q = deque([start])
    parent: Dict[Tuple[int, int], Tuple[int, int]] = {}
    visited = {start}

    while q:
        cr, cc = q.popleft()
        dist = abs(cr - sr) + abs(cc - sc)
        if dist > max_steps:
            continue
        for nr, nc in _neighbors4(h, w, cr, cc):
            if (nr, nc) in visited:
                continue
            if (nr, nc) != target and path_mask[nr, nc]:
                continue
            cell = int(grid[nr, nc])
            if (nr, nc) != target and cell != BG and cell not in SIGNAL_COLORS:
                continue
            visited.add((nr, nc))
            parent[(nr, nc)] = (cr, cc)
            if (nr, nc) == target:
                path = [(nr, nc)]
                while path[-1] != start:
                    path.append(parent[path[-1]])
                return path[::-1]
            q.append((nr, nc))

    return None


def main(grid: np.ndarray) -> np.ndarray:
    """Solve the traffic-lights path joining puzzle.

    Parameters
        grid: ARC color integer numpy array.
    Returns
        numpy.ndarray with unlinked segments removed, connected segments kept,
        bridges painted gray, and legend cleared.
    Algorithm
        (1) decode legend for lamp->path-color mapping;
        (2) build connected components for all non-reserved colors;
        (3) follow from Yellow to trace linked segments via lamps and bridge-fill.
    """
    inp = np.array(grid, copy=True)
    h, w = inp.shape

    mapping, legend_cells = _decode_legend(inp)
    if not mapping:
        return np.zeros((h, w), dtype=int)

    all_colors = set(int(x) for x in np.unique(inp))
    path_colors = all_colors - RESERVED_COLORS
    components = _collect_components(inp, path_colors)

    # Locate Yellow starting endpoint.
    yellow_positions = np.argwhere(inp == YELLOW)
    if len(yellow_positions) == 0:
        return np.zeros((h, w), dtype=int)
    sr, sc = map(int, yellow_positions[0])

    start_component = None
    start_neighbor = None
    for nr, nc in _neighbors4(h, w, sr, sc):
        color = int(inp[nr, nc])
        if color not in path_colors:
            continue
        comp = _component_of_pixel(components, nr, nc, color)
        if comp is not None:
            start_component = comp
            start_neighbor = (nr, nc)
            break

    if start_component is None or start_neighbor is None:
        return np.zeros((h, w), dtype=int)

    # Build initial output canvas.
    out = np.zeros((h, w), dtype=int)
    for r, c in start_component["cells"]:  # type: ignore[index]
        out[r, c] = int(start_component["color"])  # type: ignore[index]

    # Keep the yellow marker as the start color.
    out[sr, sc] = int(start_component["color"])  # type: ignore[index]

    visited_components: Set[Tuple[int, int]] = {start_component["id"]}  # type: ignore[index]
    path_mask = np.zeros((h, w), dtype=bool)
    for r, c in start_component["cells"]:  # type: ignore[index]
        path_mask[r, c] = True
    path_mask[sr, sc] = True

    start_endpoints = start_component["endpoints"]  # type: ignore[index]
    if (sr, sc) in start_endpoints:
        start_endpoints = [pt for pt in start_endpoints if pt != (sr, sc)]
    current_endpoint = _other_endpoint(start_endpoints, start_neighbor)

    visited_steps = 0
    while visited_steps < 64:
        visited_steps += 1

        # Read signal color around current endpoint and map to next path color.
        candidate_signals: List[Tuple[int, int]] = []
        for nr, nc in _neighbors4(h, w, *current_endpoint):
            cell = int(inp[nr, nc])
            if cell in mapping:
                candidate_signals.append((cell, (nr, nc)))

        if not candidate_signals:
            break

        best: Optional[Tuple[int, List[Tuple[int, int]], Dict[str, object]]] = None
        for lamp_color, _ in candidate_signals:
            target_color = mapping[lamp_color]
            if target_color not in components:
                continue
            for comp in components[target_color]:
                comp_id = comp["id"]  # type: ignore[index]
                if comp_id in visited_components:
                    continue

                for endpoint in comp["endpoints"]:  # type: ignore[index]
                    # Bridge can only attach to a segment endpoint.
                    path = _bfs_bridge(inp, current_endpoint, endpoint, path_mask)
                    if path is None:
                        continue

                    bridge_len = len(path)
                    if best is None or bridge_len < best[0]:
                        best = (bridge_len, path, comp)

        if best is None:
            break

        _, bridge, nxt_comp = best
        # Paint bridge pixels (excluding endpoints).
        for rr, cc in bridge:
            if (rr, cc) == current_endpoint or (rr, cc) in nxt_comp["cell_set"]:  # type: ignore[index]
                continue
            if inp[rr, cc] == BG and out[rr, cc] == BG:
                out[rr, cc] = GRAY

        # Add the next segment.
        for rr, cc in nxt_comp["cells"]:  # type: ignore[index]
            col = int(nxt_comp["color"])  # type: ignore[index]
            out[rr, cc] = col
            path_mask[rr, cc] = True

        target_endpoint = tuple(bridge[-1])
        next_end = _other_endpoint(nxt_comp["endpoints"], target_endpoint)  # type: ignore[index]
        current_endpoint = next_end
        visited_components.add(nxt_comp["id"])  # type: ignore[index]

    # Legend removed explicitly.
    if legend_cells is not None:
        for rr, cc in legend_cells:
            out[rr, cc] = BG

    return out


def generate_input() -> np.ndarray:
    """Generate a random valid input instance.

    The generator creates:
    - a 2x2 corner legend;
    - a colored chain from Yellow through connected 1-pixel-wide segments;
    - random extra unlinked segments as distractors.
    """

    rng = np.random.default_rng()
    h = int(rng.integers(12, 25))
    w = int(rng.integers(12, 25))
    grid = np.zeros((h, w), dtype=int)
    occupied = np.zeros((h, w), dtype=bool)

    color_pool = [2, 3, 4, 6, 7, 8, 12, 13, 14, 15]
    rng.shuffle(color_pool)
    path_a, path_b = color_pool[0], color_pool[1]

    # Legend in a random corner, two rows lamp->path.
    legend_corner = int(rng.integers(4))
    corners = [(0, 0), (0, w - 2), (h - 2, 0), (h - 2, w - 2)]
    r0, c0 = corners[legend_corner]
    lamp_a, lamp_b = MAROON, ORANGE
    if rng.random() < 0.5:
        lamp_a, lamp_b = lamp_b, lamp_a

    if rng.random() < 0.5:
        grid[r0, c0] = lamp_a
        grid[r0, c0 + 1] = path_a
        grid[r0 + 1, c0] = lamp_b
        grid[r0 + 1, c0 + 1] = path_b
    else:
        grid[r0, c0] = path_a
        grid[r0, c0 + 1] = lamp_a
        grid[r0 + 1, c0] = path_b
        grid[r0 + 1, c0 + 1] = lamp_b

    for rr in range(r0, r0 + 2):
        for cc in range(c0, c0 + 2):
            occupied[rr, cc] = True

    mapping = {
        lamp_a: path_a,
        lamp_b: path_b,
    }

    def can_set(rr: int, cc: int) -> bool:
        return 0 <= rr < h and 0 <= cc < w and not occupied[rr, cc]

    chain_colors = [path_a, path_b, path_a, path_b]

    # Place first segment with Yellow at one endpoint.
    dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]

    def place_segment(start_r: int, start_c: int, color: int, dir_idx: int, length: int) -> Optional[List[Tuple[int, int]]]:
        dr, dc = dirs[dir_idx]
        cells: List[Tuple[int, int]] = []
        for k in range(1, length + 1):
            rr = start_r + dr * k
            cc = start_c + dc * k
            if not can_set(rr, cc):
                return None
            if grid[rr, cc] != BG:
                return None
            cells.append((rr, cc))

        grid[start_r + dr, start_c + dc : start_c + dc + 1]
        for rr, cc in cells:
            grid[rr, cc] = color
            occupied[rr, cc] = True
        return cells

    def place_decoy_segment(color: int) -> bool:
        for _ in range(200):
            dr, dc = dirs[int(rng.integers(4))]
            length = int(rng.integers(2, 7))
            sr = int(rng.integers(1, h - 1))
            sc = int(rng.integers(1, w - 1))
