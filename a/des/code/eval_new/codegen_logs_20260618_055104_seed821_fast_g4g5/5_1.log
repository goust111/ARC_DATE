\"\"\"Separator-wall sprite filling for ARC-like grids.

Input
-----
A 2D integer ndarray representing an ARC grid where
- the most frequent color is background,
- one rectangular monochrome frame encloses the active area,
- inside the frame are single-color straight walls,
- and outside are exactly two sprites per wall color.

Output
------
A copy of the grid cropped to the frame bbox, preserving frame and walls,
with each pair of external sprites inserted into the corresponding cavity:
larger sprite on the upper/left side, smaller on the lower/right side,
rotated 0/90° so its long axis matches the wall orientation.

Idea
----
1) Locate background, frame color, and frame bounding box by connected-component
   compactness on the outer rectangle border shape.
2) For each non-frame color, pick the component inside the frame as the wall,
   and the two components outside as sprites.
3) Orient sprites by 0°/90° to satisfy wall alignment, sort by area, and
   paste upper/left then lower/right at the side touching the wall with centered
   alignment.
4) Remove everything outside the frame bbox and return cropped frame area.

Complexity
----------
All operations are linear in pixel count plus per-color component traversals.
For 30x30 inputs, runtime is negligible.
\"\"\"

from __future__ import annotations

import numpy as np
from collections import deque
from typing import Dict, Iterable, List, Optional, Sequence, Tuple


def _most_frequent_color(grid: np.ndarray) -> int:
    values, counts = np.unique(grid, return_counts=True)
    return int(values[int(np.argmax(counts))])


def _connected_components(mask: np.ndarray) -> List[np.ndarray]:
    \"\"\"Return 4-connected components as Nx2 int arrays [row, col].\"\"\"
    h, w = mask.shape
    visited = np.zeros((h, w), dtype=bool)
    comps: List[np.ndarray] = []
    dirs = ((1, 0), (-1, 0), (0, 1), (0, -1))

    for sr in range(h):
        row = mask[sr]
        for sc in np.where(row)[0]:
            if visited[sr, sc]:
                continue
            q = deque([(sr, sc)])
            visited[sr, sc] = True
            cells: List[Tuple[int, int]] = []
            while q:
                r, c = q.popleft()
                cells.append((r, c))
                for dr, dc in dirs:
                    nr, nc = r + dr, c + dc
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not visited[nr, nc]:
                        visited[nr, nc] = True
                        q.append((nr, nc))
            comps.append(np.asarray(cells, dtype=np.int16))

    return comps


def _bbox(component: np.ndarray) -> Tuple[int, int, int, int]:
    rows = component[:, 0]
    cols = component[:, 1]
    return int(rows.min()), int(rows.max()), int(cols.min()), int(cols.max())


def _detect_frame(
    grid: np.ndarray,
    bg: int,
) -> Optional[Tuple[int, int, int, int, np.ndarray]]:
    \"\"\"Return (frame_color, r0, r1, c0, c1) or None.\"\"\"
    h, w = grid.shape
    colors = [int(c) for c in np.unique(grid) if c "'!= bg]
    best: Optional[Tuple[float, int, Tuple[int, int, int, int], np.ndarray]] = None

    for color in colors:
        for comp in _connected_components(grid == color):
            if len(comp) < 8:
                continue
            r0, r1, c0, c1 = _bbox(comp)
            hh = r1 - r0 + 1
            ww = c1 - c0 + 1
            if hh < 4 or ww < 4:
                continue
            area = int(len(comp))
            expected = 2 * (hh + ww) - 4
            if expected <= 0:
                continue

            rows = comp[:, 0]
            cols = comp[:, 1]
            border_ratio = np.mean((rows == r0) | (rows == r1) | (cols == c0) | (cols == c1))
            fill_ratio = area / expected

            # good frame candidates sit mostly on bbox border and near one-loop size
            if border_ratio < 0.45:
                continue

            score = 0.85 * fill_ratio + 0.15 * border_ratio + 0.01 * expected
            if best is None or score > best[0]:
                best = (score, color, (r0, r1, c0, c1), comp)

    if best is None:
        return None

    _, color, (r0, r1, c0, c1), comp = best

    # If frame is not fully visible or touches border, keep best even if noisy.
    # Ensure the frame color itself is treated as a single loop-like component.
    hmargin = r0 > 0 and r1 < h - 1 and c0 > 0 and c1 < w - 1
    if not hmargin:
        return None
    return int(color), r0, r1, c0, c1


def _choose_wall_component(
    comps: Sequence[np.ndarray],
    frame_r0: int,
    frame_r1: int,
    frame_c0: int,
    frame_c1: int,
) -> Optional[np.ndarray]:
    wall_candidate = None
    best_score = -1.0

    for comp in comps:
        if len(comp) < 2:
            continue
        r0, r1, c0, c1 = _bbox(comp)
        # inside-frame components only
        if not np.any(
            (comp[:, 0] > frame_r0)
            & (comp[:, 0] < frame_r1)
            & (comp[:, 1] > frame_c0)
            & (comp[:, 1] < frame_c1)
        ):
            continue

        hh = r1 - r0 + 1
        ww = c1 - c0 + 1
        if hh == 0 or ww == 0:
            continue
        # Prefer long thin segments. A wall usually lies near straight.
        ratio = max(ww / max(1, hh), hh / max(1, ww))
        extent = ww + hh
        score = float(len(comp)) * ratio + 0.1 * extent
        if score > best_score:
            best_score = score
            wall_candidate = comp

    return wall_candidate


def _component_mask(component: np.ndarray) -> np.ndarray:
    r0, r1, c0, c1 = _bbox(component)
    h = r1 - r0 + 1
    w = c1 - c0 + 1
    out = np.zeros((h, w), dtype=bool)
    rr = component[:, 0] - r0
    cc = component[:, 1] - c0
    out[rr, cc] = True
    return out


def _rotate_for_wall(sprite: np.ndarray, orientation: str) -> np.ndarray:
    """Rotate only 0° or 90° clockwise so long axis matches wall axis."""
    h, w = sprite.shape
    if orientation == "H":
        if w < h:
            return np.rot90(sprite, k=-1)
    else:  # vertical
        if h < w:
            return np.rot90(sprite, k=-1)
    return sprite


def _paint_sprite(
    out: np.ndarray,
    sprite_mask: np.ndarray,
    top: int,
    left: int,
    color: int,
    bg: int,
    frame_color: int,
) -> bool:
    h, w = sprite_mask.shape
    H, W = out.shape
    if top < 0 or left < 0 or top + h > H or left + w > W:
        return False

    region = out[top : top + h, left : left + w]
    # Only place on empty interior pixels.
    if np.any(region[sprite_mask] != bg):
        return False

    region[sprite_mask] = color
    return True


def main(grid: np.ndarray) -> np.ndarray:
    """Fill framed wall cavities with matching color sprites.

    Input
    -----
    `grid` is an integer ndarray (H×W) using ARC palette indices.

    Output
    ------
    Returns the frame bounding box subgrid containing frame, walls and placed sprites,
    with outside sprites removed.

    Process
    -------
    1) Identify bg and frame.
    2) Remove everything outside frame bbox.
    3) For each non-bg/non-frame color, identify wall component inside the frame
       and two external sprite components.
    4) Orient sprites by wall direction and place: upper/left side gets larger area,
       lower/right gets smaller area.

    Assumptions
    -----------
    Colors are integers; components are small enough (grid <= 30 in our dataset).
    """
    g = np.asarray(grid, dtype=np.int64)
    if g.size == 0:
        return g.copy()

    bg = _most_frequent_color(g)
    frame = _detect_frame(g, bg)
    if frame is None:
        return g.copy()

    frame_color, fr0, fr1, fc0, fc1 = frame
    out = g.copy()

    # Remove all pixels outside the frame bbox first.
    out[:fr0, :] = bg
    out[fr1 + 1 :, :] = bg
    out[:, :fc0] = bg
    out[:, fc1 + 1 :] = bg

    inner_r0, inner_r1 = fr0 + 1, fr1 - 1
    inner_c0, inner_c1 = fc0 + 1, fc1 - 1
    if inner_r0 > inner_r1 or inner_c0 > inner_c1:
        return out[fr0 : fr1 + 1, fc0 : fc1 + 1]

    colors = [int(c) for c in np.unique(g) if c not in (bg, frame_color)]
    for color in colors:
        comps = _connected_components(g == color)
        if not comps:
            continue

        wall = _choose_wall_component(comps, fr0, fr1, fc0, fc1)
        if wall is None:
            continue

        wall_r0, wall_r1, wall_c0, wall_c1 = _bbox(wall)
        wall_h = wall_r1 - wall_r0 + 1
        wall_w = wall_c1 - wall_c0 + 1
        orientation = "H" if wall_w >= wall_h else "V"

        sprites = [
            c
            for c in comps
            if not np.any(
                (c[:, 0] > fr0)
                & (c[:, 0] < fr1)
                & (c[:, 1] > fc0)
                & (c[:, 1] < fc1)
            )
        ]

        if len(sprites) < 2:
            continue
        sprites = sorted(sprites, key=len, reverse=True)[:2]

        for idx, sprite_comp in enumerate(sprites):
            sprite = _component_mask(sprite_comp)
            sprite = _rotate_for_wall(sprite, orientation)
            sh, sw = sprite.shape

            if orientation == "H":
                if idx == 0:
                    top = wall_r0 - sh
                else:
                    top = wall_r1 + 1

                # centered in wall span
                wall_mid = (wall_c0 + wall_c1) / 2.0
                left = int(round(wall_mid - sw / 2.0))
                left = max(inner_c0, min(left, inner_c1 - sw + 1))

            else:
                if idx == 0:
                    left = wall_c0 - sw
                else:
                    left = wall_c1 + 1

                wall_mid = (wall_r0 + wall_r1) / 2.0
                top = int(round(wall_mid - sh / 2.0))
                top = max(inner_r0, min(top, inner_r1 - sh + 1))

            if top < inner_r0 or top + sh - 1 > inner_r1 or left < inner_c0 or left + sw - 1 > inner_c1:
                # not enough space for this sprite in this cavity.
                continue

            _paint_sprite(out, sprite, top, left, color, bg, frame_color)

    return out[fr0 : fr1 + 1, fc0 : fc1 + 1]


def _random_connected_mask(rng: np.random.Generator, min_cells: int, max_cells: int) -> np.ndarray:
    target = int(rng.integers(min_cells, max_cells + 1))
    target = max(1, target)

    pts = [(0, 0)]
    frontier = [(0, 0)]
    while len(pts) < target:
        r, c = frontier[int(rng.integers(0, len(frontier)))]
        dr, dc = [
            (1, 0),
            (-1, 0),
            (0, 1),
            (0, -1),
        ][int(rng.integers(0, 4))]
        nr, nc = r + dr, c + dc
        if (nr, nc) not in pts:
            pts.append((nr, nc))
            frontier.append((nr, nc))

    rr = np.array([p[0] for p in pts], dtype=int)
    cc = np.array([p[1] for p in pts], dtype=int)
    rr -= rr.min()
    cc -= cc.min()
    mask = np.zeros((rr.max() + 1, cc.max() + 1), dtype=bool)
    mask[rr, cc] = True
    return mask


def _place_outside_sprite(
    grid: np.ndarray,
    rng: np.random.Generator,
    color: int,
    sprite: np.ndarray,
    allowed_rows: Sequence[int],
    allowed_cols: Sequence[int],
    bg: int,
) -> bool:
    if not allowed_rows or not allowed_cols:
        return False

    h, w = grid.shape
    sh, sw = sprite.shape
    if sh >= h or sw >= w:
        return False

    for _ in range(600):
        r0 = int(rng.choice(allowed_rows))
        c0 = int(rng.choice(allowed_cols))
        if r0 + sh > h or c0 + sw > w:
            continue

        region = grid[r0 : r0 + sh, c0 : c0 + sw]
        if np.any(region != bg):
            continue

        # separate same-color sprites by at least 1-cell gap (optional quality constraint)
        r1 = max(0, r0 - 1)
        r2 = min(h, r0 + sh + 1)
        c1 = max(0, c0 - 1)
        c2 = min(w, c0 + sw + 1)
        halo = grid[r1:r2, c1:c2]
        if np.any(halo == color):
            continue

        region[sprite] = color
        return True

    return False


def generate_input() -> np.ndarray:
    """Generate a random valid instance with size <= 30."""
    rng = np.random.default_rng()

    for _ in range(800):
        h = int(rng.integers(20, 30))
        w = int(rng.integers(20, 30))

        bg = int(rng.integers(0, 10))
        frame_color = int(rng.integers(0, 10))
        while frame_color == bg:
            frame_color = int(rng.integers(0, 10))

        grid = np.full((h, w), bg, dtype=np.int64)

        # Keep frame away from edges.
        frame_h = int(rng.integers(11, min(19, h - 4)))
        frame_w = int(rng.integers(11, min(19, w - 4)))
        fr0 = int(rng.integers(2, h - frame_h - 1))
        fc0 = int(rng.integers(2, w - frame_w - 1))
        fr1 = fr0 + frame_h - 1
        fc1 = fc0 + frame_w - 1
        if fr1 >= h - 1 or fc1 >= w - 1:
            continue

        # Draw frame rectangle
        grid[fr0, fc0 : fc1 + 1] = frame_color
        grid[fr1, fc0 : fc1 + 1] = frame_color
        grid[fr0 : fr1 + 1, fc0] = frame_color
        grid[fr0 : fr1 + 1, fc1] = frame_color

        n_walls = int(rng.integers(1, 4))
        wall_ori = int(rng.integers(0, 2))  # 0: horizontal, 1: vertical

        inner_r0, inner_r1 = fr0 + 1, fr1 - 1
        inner_c0, inner_c1 = fc0 + 1, fc1 - 1

        used_rows: List[int] = []
        used_cols: List[int] = []
        wall_specs = []
        palette = [c for c in range(12) if c not in (bg, frame_color)]
        if len(palette) < n_walls:
            continue
        rng.shuffle(palette)

        success = True
        for i in range(n_walls):
            color = palette[i]

            if wall_ori == 0:
                rows = [r for r in range(inner_r0 + 1, inner_r1) if r not in used_rows]
                if not rows:
                    success = False
                    break
                r = int(rng.choice(rows))
                used_rows.append(r)
                grid[r, inner_c0 : inner_c1 + 1] = color
                wall_specs.append((color, "H", r, inner_c0, inner_c1, r, r))
            else:
                cols = [c for c in range(inner_c0 + 1, inner_c1) if c not in used_cols]
                if not cols:
                    success = False
                    break
                c = int(rng.choice(cols))
                used_cols.append(c)
                grid[inner_r0 : inner_r1 + 1, c] = color
                wall_specs.append((color, "V", c, inner_r0, inner_r1, c, c))

        if not success:
            continue

        # Add two connected same-color sprites for each wall color, one larger.
        for color, ori, wall_pos, a, b, c_start, c_end in wall_specs:
            if ori == "H":
                top_candidates = list(range(1, fr0))
                bot_candidates = list(range(fr1 + 1, h - 1))
                row_pool = [top_candidates, bot_candidates]
            else:
                left_candidates = list(range(1, fc0))
                right_candidates = list(range(fc1 + 1, w - 1))
                col_pool = [left_candidates, right_candidates]

            sizes = [
                int(rng.integers(8, 16)),
                int(rng.integers(3, 9)),
            ]
            if sizes[0] < sizes[1]:
                sizes[0], sizes[1] = sizes[1], sizes[0]

            for si, size in enumerate(sizes):
                sprite_mask = _random_connected_mask(rng, 3, size)

                if ori == "H":
                    rows = top_candidates if si == 0 else bot_candidates
                    if not rows:
                        rows = [r for r in range(0, h)]
                    allowed_rows = rows
                    allowed_cols = list(range(1, w - 1))
                else:
                    cols = left_candidates if si == 0 else right_candidates
                    if not cols:
                        cols = [c for c in range(0, w)]
                    allowed_cols = cols
                    allowed_rows = list(range(1, h - 1))

                if not _place_outside_sprite(
                    grid,
                    rng,
                    color,
                    sprite_mask,
                    allowed_rows,
                    allowed_cols,
                    bg,
                ):
                    success = False
                    break

            if not success:
                break

        if success:
            return grid.astype(np.int64)

    # deterministic fallback
    g = np.full((20, 20), 0, dtype=np.int64)
    g[2:17, 2] = g[2:17, 17] = g[2, 2:18] = g[16, 2:18] = 5
    g[9, 3:17] = 1
    g[2:17, 9] = 2
    g[0:2, 3:5] = 1
    g[17:19, 12:15] = 1
    return g


if __name__ == "__main__":
    sample = generate_input()
    _out = main(sample)
    print(sample.shape, _out.shape, _out.dtype)
