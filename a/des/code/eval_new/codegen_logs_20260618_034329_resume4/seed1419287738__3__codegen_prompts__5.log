def _sample_entity_mask(axis: str) -> np.ndarray | None:
    for _ in range(MASK_RETRIES):
        if axis == "horizontal":
            height = random.randint(2, 5)
            width = random.randint(2, 4)
        else:
            height = random.randint(2, 4)
            width = random.randint(2, 5)

        min_cells = max(4, height + width - 2)
        max_cells = height * width - 1
        if min_cells > max_cells:
            continue
        target = random.randint(min_cells, max_cells)

        cells = {(random.randrange(height), random.randrange(width))}
        while len(cells) < target:
            frontier = set()
            for r, c in cells:
                for nr, nc in _neighbors4(r, c):
                    if 0 <= nr < height and 0 <= nc < width and (nr, nc) not in cells:
                        frontier.add((nr, nc))
            if not frontier:
                break
            cells.add(random.choice(tuple(frontier)))

        if len(cells) != target:
            continue

        mask = np.zeros((height, width), dtype=bool)
        for r, c in cells:
            mask[r, c] = True
        mask = _crop_mask(mask)

        if mask.shape[0] < 2 or mask.shape[1] < 2:
            continue
        if int(mask.sum()) < 4 or bool(mask.all()):
            continue
        if axis == "horizontal" and _stretch_match(np.ones((mask.shape[0], 1), dtype=bool), mask, axis):
            continue
        if axis == "vertical" and _stretch_match(np.ones((1, mask.shape[1]), dtype=bool), mask, axis):
            continue
        if any(_stretch_match(_crop_mask(mask[:, i : i + 1]), mask, axis) for i in range(mask.shape[1] if axis == "horizontal" else 1)):
            continue
        return mask
    return None


def _is_self_stretched(mask: np.ndarray, axis: str) -> bool:
    if axis == "horizontal":
        for factor in STRETCH_FACTORS:
            if mask.shape[1] % factor != 0:
                continue
            small = mask[:, ::factor]
            if _stretch_match(small, mask, axis):
                return True
    else:
        for factor in STRETCH_FACTORS:
            if mask.shape[0] % factor != 0:
                continue
            small = mask[::factor, :]
            if _stretch_match(small, mask, axis):
                return True
    return False


def _stretch_mask(mask: np.ndarray, axis: str, factor: int) -> np.ndarray:
    stretch_axis = 1 if axis == "horizontal" else 0
    return np.repeat(mask, factor, axis=stretch_axis)


def _choose_canvas(axis: str, pair_count: int) -> tuple[int, int]:
