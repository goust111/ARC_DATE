+
+def _room_doors(
+    row_boxes: list[tuple[int, int]],
+    col_boxes: list[tuple[int, int]],
+    rng: random.Random,
+):
+    n_room_rows = len(row_boxes)
+    n_room_cols = len(col_boxes)
+    horiz_rows = []
+    for r0, r1 in row_boxes:
+        if r1 - r0 + 1 >= 3:
