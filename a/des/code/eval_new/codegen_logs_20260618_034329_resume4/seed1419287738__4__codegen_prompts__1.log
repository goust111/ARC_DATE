+
+def _vine_path(grid: np.ndarray, start: tuple[int, int], direction: tuple[int, int], wall: int):
+    h, w = grid.shape
+    r, c = start
+    dr, dc = direction
+    t = 0
+    out = []
+    while True:
+        r += dr
+        c += dc
+        t += 1
+        if not (0 <= r < h and 0 <= c < w):
+            break
