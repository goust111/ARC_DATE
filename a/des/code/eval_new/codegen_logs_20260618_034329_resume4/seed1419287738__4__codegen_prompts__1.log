+                    "room": sc["room"],
+                    "direction": sc["direction"],
+                    "want_tie": sc["want_tie"],
+                    "start": start,
+                    "path": path,
+                    "path_set": set(path),
+                    "crosses_gap": any(cell in gap_set for cell in path),
+                }
+            )
