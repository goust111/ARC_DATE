+def _direction_from_bbox(r: int, c: int, bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, r1, c0, c1 = bbox
+    left = c - c0
+    right = c1 - c
+    up = r - r0
+    down = r1 - r
+    if min(left, right) <= min(up, down):
+        return (0, -1) if left <= right else (0, 1)
+    return (-1, 0) if up <= down else (1, 0)
