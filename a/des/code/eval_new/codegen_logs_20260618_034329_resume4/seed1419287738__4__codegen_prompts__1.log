+    for (r1, c1), (r2, c2) in zip(path, path[1:]):
+        if r1 == r2:
+            rr = r1
+            left = min(c1, c2)
+            wall_c = col_boxes[left][1] + 1
+            gap_r = horiz_rows[rr]
+            gaps.append((gap_r, wall_c))
