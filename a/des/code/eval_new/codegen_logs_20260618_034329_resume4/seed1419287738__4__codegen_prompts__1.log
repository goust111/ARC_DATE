+
+BG = 0
+WALL = 5
+SEED_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+COLOR_NAME_RANK = {
+    1: 1,  # blue
+    8: 2,  # cyan
+    3: 3,  # green
+    6: 4,  # magenta
+    7: 5,  # orange
+    2: 6,  # red
