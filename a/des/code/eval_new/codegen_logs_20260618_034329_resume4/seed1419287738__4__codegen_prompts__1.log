+    g = np.asarray(grid, dtype=int)
+    if g.ndim != 2:
+        raise ValueError("expected a 2D grid")
+    bg = _mode(g)
+    others = g[g != bg]
+    if others.size == 0:
+        return g.copy()
+    wall = _mode(others)
+    return _apply_vines(g, bg, wall)
