+        color = int(grid[sr, sc])
+        direction = _direction_from_bbox(sr, sc, rooms[room_idx]["bbox"])
+        for r, c, t in _vine_path(grid, (sr, sc), direction, wall):
+            if int(grid[r, c]) != bg:
