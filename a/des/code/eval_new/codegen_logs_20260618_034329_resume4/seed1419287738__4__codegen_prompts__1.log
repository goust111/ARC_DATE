        r0, c0, r1, c1 = rects.pop(i)
        axes = ('h',) * can_h + ('v',) * can_v
        axis = rng.choice(axes)

        if axis == 'h':
            rr = rng.randint(r0 + MIN_REGION_DIM, r1 - MIN_REGION_DIM)
            wall_mask[rr, c0:c1 + 1] = 1
