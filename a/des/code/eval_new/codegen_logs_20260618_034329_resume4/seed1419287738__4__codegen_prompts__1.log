+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not mask[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _seal_walls(grid: np.ndarray, bg: int, wall: int) -> np.ndarray:
+    h, w = grid.shape
+    sealed = grid == wall
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if int(grid[r, c]) != bg:
+                continue
+            horiz = bool(sealed[r, c - 1] and sealed[r, c + 1])
+            vert = bool(sealed[r - 1, c] and sealed[r + 1, c])
+            if horiz or vert:
+                sealed[r, c] = True
+    return sealed
+
+
+def _room_data(grid: np.ndarray, bg: int, wall: int):
+    sealed = _seal_walls(grid, bg, wall)
+    mask = ~sealed
+    label = -np.ones(grid.shape, dtype=int)
+    rooms = []
+    for idx, pts in enumerate(_components(mask)):
+        rs = [r for r, _ in pts]
+        cs = [c for _, c in pts]
+        r0, r1 = min(rs), max(rs)
+        c0, c1 = min(cs), max(cs)
+        for r, c in pts:
+            label[r, c] = idx
+        rooms.append(
+            {
+                "bbox": (r0, r1, c0, c1),
+                "cells": pts,
+                "set": set(pts),
+            }
+        )
+    return rooms, label
