+    rooms, labels = _room_data(grid, bg, wall)
+    seeds = [tuple(map(int, rc)) for rc in np.argwhere((grid != bg) & (grid != wall))]
+    best: dict[tuple[int, int], tuple[int, int, int]] = {}
+    for sr, sc in seeds:
+        room_idx = int(labels[sr, sc])
+        if room_idx < 0:
