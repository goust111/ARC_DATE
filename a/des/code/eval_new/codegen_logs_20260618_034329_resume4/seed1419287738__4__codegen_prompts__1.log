+
+
+def _disjoint_option(option, chosen):
+    for prev in chosen:
+        if option["room"] == prev["room"]:
+            return False
+        if option["start"] in prev["path_set"] or prev["start"] in option["path_set"]:
+            return False
+        if option["path_set"] & prev["path_set"]:
