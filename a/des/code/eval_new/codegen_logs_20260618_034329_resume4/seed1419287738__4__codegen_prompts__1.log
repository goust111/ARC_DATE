+def _local_direction(local_r: int, local_c: int, h: int, w: int) -> str:
+    left = local_c
+    right = w - 1 - local_c
+    up = local_r
+    down = h - 1 - local_r
+    if min(left, right) <= min(up, down):
+        return "left" if left <= right else "right"
+    return "up" if up <= down else "down"
