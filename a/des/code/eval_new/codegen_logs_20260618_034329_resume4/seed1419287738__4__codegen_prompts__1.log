+    room_infos = {}
+    for rr, (r0, r1) in enumerate(row_boxes):
+        for cc, (c0, c1) in enumerate(col_boxes):
+            room_infos[(rr, cc)] = {"bbox": (r0, r1, c0, c1)}
+
+    scenarios = _scenario_pool(room_infos, doors)
+    if not scenarios:
+        return None
+    chosen = _choose_scenarios(scenarios, len(room_infos), rng)
+    if len(chosen) < 2:
+        return None
+
+    rng.shuffle(SEED_COLORS)
+    seeds = []
+    used_cells = set()
+    for color, spec in zip(SEED_COLORS, chosen):
+        cells = [cell for cell in spec["cells"] if cell not in used_cells]
+        if not cells:
+            return None
+        cell = rng.choice(cells)
+        used_cells.add(cell)
+        grid[cell] = color
+        seeds.append(cell)
+
+    traces = _trace_cells(grid, seeds, BG, WALL)
+    all_cells = []
+    for cells in traces.values():
+        all_cells.extend(cells)
+    if len(all_cells) != len(set(all_cells)):
+        return None
+
+    lengths = [len(cells) for cells in traces.values()]
+    if min(lengths) < 1:
+        return None
+
+    crosses_gap = 0
+    for cells in traces.values():
+        if any(cell in gaps for cell in cells):
+            crosses_gap += 1
+    if crosses_gap == 0:
+        return None
+    if crosses_gap == len(seeds):
+        return None
+
+    tie_present = False
+    pass_present = False
+    stop_present = False
+    for sr, sc in seeds:
+        room_idx = int(_room_data(grid, BG, WALL)[1][sr, sc])
+        bbox = _room_data(grid, BG, WALL)[0][room_idx]["bbox"]
+        direction = _direction_from_bbox(sr, sc, bbox)
