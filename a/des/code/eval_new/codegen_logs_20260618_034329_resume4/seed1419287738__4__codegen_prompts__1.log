+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+SEED_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+COLOR_NAME_RANK = {
+    1: 1,  # blue
+    8: 2,  # cyan
+    3: 3,  # green
+    6: 4,  # magenta
+    7: 5,  # orange
+    2: 6,  # red
+    4: 7,  # yellow
+    9: 8,  # brown
+}
+
+GEN_RETRIES = 400
+
+
+def _mode(values: np.ndarray) -> int:
+    vals = np.asarray(values, dtype=int).ravel()
+    return int(Counter(vals.tolist()).most_common(1)[0][0])
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not mask[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _seal_walls(grid: np.ndarray, bg: int, wall: int) -> np.ndarray:
+    h, w = grid.shape
+    sealed = grid == wall
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if int(grid[r, c]) != bg:
+                continue
+            horiz = bool(sealed[r, c - 1] and sealed[r, c + 1])
+            vert = bool(sealed[r - 1, c] and sealed[r + 1, c])
+            if horiz or vert:
+                sealed[r, c] = True
+    return sealed
+
+
+def _room_data(grid: np.ndarray, bg: int, wall: int):
+    sealed = _seal_walls(grid, bg, wall)
+    mask = ~sealed
+    label = -np.ones(grid.shape, dtype=int)
+    rooms = []
+    for idx, pts in enumerate(_components(mask)):
+        rs = [r for r, _ in pts]
+        cs = [c for _, c in pts]
+        r0, r1 = min(rs), max(rs)
+        c0, c1 = min(cs), max(cs)
+        for r, c in pts:
+            label[r, c] = idx
+        rooms.append(
+            {
+                "bbox": (r0, r1, c0, c1),
+                "cells": pts,
+                "set": set(pts),
+            }
+        )
+    return rooms, label
+
+
+def _direction_from_bbox(r: int, c: int, bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, r1, c0, c1 = bbox
+    left = c - c0
+    right = c1 - c
+    up = r - r0
+    down = r1 - r
+    if min(left, right) <= min(up, down):
+        return (0, -1) if left <= right else (0, 1)
+    return (-1, 0) if up <= down else (1, 0)
+
+
+def _vine_path(grid: np.ndarray, start: tuple[int, int], direction: tuple[int, int], wall: int):
+    h, w = grid.shape
+    r, c = start
+    dr, dc = direction
+    t = 0
+    out = []
+    while True:
