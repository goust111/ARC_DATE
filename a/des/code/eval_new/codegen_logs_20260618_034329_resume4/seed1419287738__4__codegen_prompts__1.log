+        down = bbox[1] - sr
+        if min(left, right) == min(up, down) and direction[0] == 0:
+            tie_present = True
+        cells = traces[int(grid[sr, sc])]
+        if any(cell in gaps for cell in cells):
+            pass_present = True
+        else:
+            stop_present = True
+    if not pass_present or not stop_present:
+        return None
+    if rng.random() < 0.5 and not tie_present:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        rng = random.Random()
+        grid = _build_candidate(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input failed after retries")

