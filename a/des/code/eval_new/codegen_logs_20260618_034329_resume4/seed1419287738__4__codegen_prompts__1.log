+    chosen = []
+    used_rooms = set()
+    for pred in needs:
+        candidates = [sc for sc in scenarios if sc["room"] not in used_rooms and pred(sc)]
+        if not candidates:
+            continue
+        sc = rng.choice(candidates)
+        chosen.append(sc)
+        used_rooms.add(sc["room"])
+
+    remaining = [sc for sc in scenarios if sc["room"] not in used_rooms]
+    rng.shuffle(remaining)
+    for sc in remaining:
+        if len(chosen) >= seed_count:
+            break
+        chosen.append(sc)
+        used_rooms.add(sc["room"])
+    return chosen
+
+
+def _trace_cells(
+    grid: np.ndarray,
+    seeds: list[tuple[int, int]],
+    bg: int,
+    wall: int,
+):
+    rooms, labels = _room_data(grid, bg, wall)
