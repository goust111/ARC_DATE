+
+    grid = np.full((h, w), BG, dtype=int)
+    row_boxes, col_boxes = _room_boxes(row_heights, col_widths)
+
+    wall_rows = [0] + [r1 + 1 for _, r1 in row_boxes]
+    wall_cols = [0] + [c1 + 1 for _, c1 in col_boxes]
+    for rr in wall_rows:
+        grid[rr, :] = WALL
+    for cc in wall_cols:
+        grid[:, cc] = WALL
