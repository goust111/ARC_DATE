+def _room_data(grid: np.ndarray, bg: int, wall: int):
+    sealed = _seal_walls(grid, bg, wall)
+    mask = ~sealed
+    label = -np.ones(grid.shape, dtype=int)
+    rooms = []
+    for idx, pts in enumerate(_components(mask)):
+        rs = [r for r, _ in pts]
+        cs = [c for _, c in pts]
+        r0, r1 = min(rs), max(rs)
+        c0, c1 = min(cs), max(cs)
+        for r, c in pts:
+            label[r, c] = idx
+        rooms.append(
+            {
+                "bbox": (r0, r1, c0, c1),
+                "cells": pts,
+                "set": set(pts),
+            }
+        )
