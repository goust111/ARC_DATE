+    if corner == "tr":
+        return 0, w - width, 1, w - 1
+    if corner == "bl":
+        return h - 2, 0, h - 1, width - 1
+    if corner == "br":
+        return h - 2, w - width, h - 1, w - 1
+    raise ValueError(corner)
