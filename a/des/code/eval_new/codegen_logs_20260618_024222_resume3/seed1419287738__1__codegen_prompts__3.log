+    best_rank = np.full(shape, len(priority), dtype=int)
+    best_color = np.full(shape, BLACK, dtype=int)
+    contributors = {}
+    wall_stop = False
+
+    def claim(r, c, color):
+        contributors.setdefault((r, c), set()).add(color)
+        if rank[color] < best_rank[r, c]:
+            best_rank[r, c] = rank[color]
