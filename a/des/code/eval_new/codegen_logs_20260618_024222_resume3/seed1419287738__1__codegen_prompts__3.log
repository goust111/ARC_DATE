    offsets = _build_layer_offsets(n, ring_count)
    if offsets is None:
        return None

    grid = _render_scene(n, bg, ring_colors, offsets)
    if not _add_noise(grid, bg, ring_colors, offsets):
        return None

    try:
        if not np.array_equal(main(grid), expected_output):
            return None
    except Exception:
        return None
    return grid


