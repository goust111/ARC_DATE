+    assert 2 <= len(best) <= 3, "expected a 2- or 3-layer nested frame chain"
+    return best
+
+
+def _apply_operation(pattern: np.ndarray, op_index: int, color: int, bg: int) -> np.ndarray:
+    out = np.asarray(pattern, dtype=int)
