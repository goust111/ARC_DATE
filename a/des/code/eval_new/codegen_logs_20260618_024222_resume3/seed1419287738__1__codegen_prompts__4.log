+    mapping = {
+        border: int(_pick(rng, [color for color in _COLOR_POOL if color != border]))
+        for border in border_colors
+    }
+    palette_pairs = [(border, mapping[border]) for border in border_colors]
+    rng.shuffle(palette_pairs)
