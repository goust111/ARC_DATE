+            board = np.where((rr + cc + phase) % 2 == 0, accent, _BG)
+        elif kind == "diag3":
+            phase = int(rng.integers(3))
+            board = np.where((rr + 2 * cc + phase) % 3 == 0, _BG, accent)
+        else:
