+        kind = _pick(rng, ("checker", "vstripe", "hstripe", "mesh"))
+        if kind == "checker":
+            phase = int(rng.integers(2))
+            board = np.where((rr + cc + phase) % 2 == 0, a, b)
+        elif kind == "vstripe":
+            phase = int(rng.integers(2))
+            board = np.where((cc + phase) % 2 == 0, a, b)
+        elif kind == "hstripe":
