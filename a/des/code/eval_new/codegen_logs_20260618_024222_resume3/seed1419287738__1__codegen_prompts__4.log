+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(_GEN_RETRIES):
+        grid = _generate_case(rng)
+        if grid is not None:
+            return grid
