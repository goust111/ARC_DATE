+    corner: str,
+    pairs: list[tuple[int, int]],
+) -> tuple[int, int, int, int]:
+    h, w = grid.shape
+    n = len(pairs)
+    if corner == "top_left":
+        rows = list(range(n))
+        c0 = 0
+    elif corner == "top_right":
+        rows = list(range(n))
+        c0 = w - 2
+    elif corner == "bottom_left":
+        rows = list(range(h - n, h))
+        c0 = 0
+    else:
+        rows = list(range(h - n, h))
+        c0 = w - 2
+
+    for row, (left, right) in zip(rows, pairs, strict=False):
