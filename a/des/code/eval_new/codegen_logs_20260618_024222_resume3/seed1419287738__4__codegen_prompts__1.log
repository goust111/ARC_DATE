    br = r0 if row_from == 0 else r1
    bc = c0 if col_from == 0 else c1

    colors = rng.sample(marker_pool, n)
    return [(start_d + k, col, br + dr * (start_d + k), bc + dc * (start_d + k))
            for k, col in enumerate(colors)]


