+    inner_mask = _slot_mask_to_pixel_mask(slot_mask)
+    h, w = inner_mask.shape
+    obj = np.full((h + 2, w + 2), BG, dtype=int)
+    obj[0, :] = border_color
+    obj[-1, :] = border_color
+    obj[:, 0] = border_color
+    obj[:, -1] = border_color
