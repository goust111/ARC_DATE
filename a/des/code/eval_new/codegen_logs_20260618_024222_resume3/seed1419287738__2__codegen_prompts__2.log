+    elif side == "left":
+        if dc != c0 or dr != (r0 + r1) // 2 or ((r1 - r0 + 1) % 2) != 1:
+            return None
+        if dc == 0 or int(grid[dr, dc - 1]) != int(bg) or int(grid[dr, dc + 1]) == int(WALL):
