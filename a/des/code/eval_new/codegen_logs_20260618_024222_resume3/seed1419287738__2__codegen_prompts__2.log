+        place_index += 1
+        spec["pos"] = (int(rr), int(cc))
+        inp[rr : rr + spec["patch"].shape[0], cc : cc + spec["patch"].shape[1]] = spec["patch"]
+
+        kr, kc = placements[place_index]
+        place_index += 1
