+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 8
+WALL = 5
+HIDDEN = 9
+COLOR_POOL = [0, 1, 2, 3, 4, 6, 7]
+MAX_GENERATION_ATTEMPTS = 300
