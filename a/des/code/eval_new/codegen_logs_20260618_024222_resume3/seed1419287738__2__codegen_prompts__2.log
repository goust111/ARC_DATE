+def _validate_room(
+    grid: np.ndarray,
+    bg: int,
+    door_pos: tuple[int, int],
+    side: str,
+    bbox: tuple[int, int, int, int],
+) -> dict | None:
+    h, w = grid.shape
+    r0, c0, r1, c1 = map(int, bbox)
+    dr, dc = map(int, door_pos)
+
+    if not (0 <= r0 < r1 < h and 0 <= c0 < c1 < w):
+        return None
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return None
+
+    if side == "top":
+        if dr != r0 or dc != (c0 + c1) // 2 or ((c1 - c0 + 1) % 2) != 1:
