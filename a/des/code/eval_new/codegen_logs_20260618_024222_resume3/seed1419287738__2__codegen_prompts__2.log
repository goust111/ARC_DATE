+    return None
+
+
+def _room_patch(room_h: int, room_w: int, side: str, door_color: int, pattern: np.ndarray) -> np.ndarray:
+    patch = np.full((room_h, room_w), BG, dtype=int)
+    patch[0, :] = WALL
+    patch[-1, :] = WALL
