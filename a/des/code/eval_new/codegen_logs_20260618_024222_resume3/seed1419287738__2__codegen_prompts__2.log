+
+    return {
+        "color": int(grid[dr, dc]),
+        "door": (int(dr), int(dc)),
+        "side": side,
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+    }
+
+
+def _room_from_door(grid: np.ndarray, bg: int, door_pos: tuple[int, int]) -> dict | None:
+    r, c = map(int, door_pos)
+    h, w = grid.shape
+    if not (0 < r < h - 1 and 0 < c < w - 1):
+        return None
