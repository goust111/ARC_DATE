+    unique_rooms: list[dict] = []
+    for room in rooms:
+        if room["door"] not in seen_doors:
+            seen_doors.add(room["door"])
+            unique_rooms.append(room)
+
+    for room in unique_rooms:
+        color = int(room["color"])
+        r0, c0, r1, c1 = map(int, room["bbox"])
+        dr, dc = map(int, room["door"])
