+# --------------- generator helpers ---------------
+
+_GRID_MIN = 22
+_GRID_MAX = 30
+_INNER_DIMS = [(3, 3), (3, 4), (4, 3), (4, 4), (3, 5), (5, 3)]
+_CONTAINER_COUNT_CHOICES = (2, 3)
+_CLUSTER_RETRIES = 150
+_GEN_RETRIES = 300
+_PATCH_MARGIN = 8
+_GAP_CHOICES = (1, 2)
