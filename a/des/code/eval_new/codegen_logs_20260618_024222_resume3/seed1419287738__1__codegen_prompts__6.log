+def _polyline_cells(points: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    for idx, (a, b) in enumerate(zip(points, points[1:])):
+        segment = _line_points(a, b)
