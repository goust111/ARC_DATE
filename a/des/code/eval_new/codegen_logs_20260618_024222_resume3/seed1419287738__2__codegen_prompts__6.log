        min(GEN_TOTAL_WIDTH_RANGE[1], max_width * block_count),
    )
    options = [
        widths
        for widths in itertools.product(range(min_width, max_width + 1), repeat=block_count)
        if sum(widths) == total
    ]
    return list(random.choice(options))


