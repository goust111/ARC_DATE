+    outside_counts: dict[int, int] = {sources[kind]: 0 for kind in KINDS}
+    for kind in KINDS:
+        count = rng.randint(1, 3)
+        color = sources[kind]
+        for _ in range(count):
+            shape = _make_object_shape(rng)
