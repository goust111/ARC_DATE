+            sh = max(r for r, _ in shape) + 1
+            sw = max(c for _, c in shape) + 1
+            placed = False
+            for _ in range(PLACE_RETRIES):
+                r0 = rng.randint(1, h - sh - 1)
+                c0 = rng.randint(1, w - sw - 1)
+                cells = [(r0 + dr, c0 + dc) for dr, dc in shape]
+                if not _placeable(blocked, cells):
