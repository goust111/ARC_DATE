+
+def _rotate_cells(cells: Iterable[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    return _normalize_cells((c, -r) for r, c in cells)
+
+
+def _reflect_cells(cells: Iterable[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
