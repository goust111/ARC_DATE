+
+
+def _make_object_shape(rng: random.Random) -> tuple[tuple[int, int], ...]:
+    for _ in range(OBJECT_RETRIES):
+        target_area = rng.randint(2, 6)
+        cells = {(0, 0)}
+        while len(cells) < target_area:
+            frontier = set()
