+
+def _paste(canvas: np.ndarray, asset: np.ndarray, top: int, left: int) -> None:
+    h, w = asset.shape
+    sub = canvas[top : top + h, left : left + w]
+    mask = asset != BG
+    assert not np.any(sub[mask] != BG), "assets must not overlap"
+    sub[mask] = asset[mask]
