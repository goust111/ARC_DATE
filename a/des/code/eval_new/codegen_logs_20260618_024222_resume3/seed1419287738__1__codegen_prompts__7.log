+        padded_inner = np.zeros((inner_h + 2, inner_w + 2), dtype=bool)
+        padded_inner[1:-1, 1:-1] = inner
+        border = _dilate8(padded_inner) & (~padded_inner)
+        if len(_components(border)) != 1:
