import numpy as np

def dil8(mask):
    h,w=mask.shape
    out=np.zeros_like(mask,bool)
    for dr in (-1,0,1):
        for dc in (-1,0,1):
            rs=max(0,dr); re=min(h,h+dr)
            cs=max(0,dc); ce=min(w,w+dc)
            out[rs:re, cs:ce] |= mask[rs-dr:re-dr, cs-dc:ce-dc]
    return out

def outside(blocked):
    h,w=blocked.shape
    seen=np.zeros_like(blocked,bool)
    st=[]
    for r in range(h):
        for c in (0,w-1):
            if not blocked[r,c] and not seen[r,c]:
                seen[r,c]=1; st.append((r,c))
    for c in range(w):
        for r in (0,h-1):
            if not blocked[r,c] and not seen[r,c]:
                seen[r,c]=1; st.append((r,c))
    while st:
        r,c=st.pop()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<h and 0<=nc<w and not blocked[nr,nc] and not seen[nr,nc]:
                seen[nr,nc]=1; st.append((nr,nc))
    return ~blocked & ~seen

for shape in ['rect','bite']:
    h,w=4,5
    inner=np.ones((h,w),bool)
    if shape=='bite':
        inner[:2,-2:]=0
    pad=np.zeros((h+2,w+2),bool)
    pad[1:-1,1:-1]=inner
    border=dil8(pad)&~pad
    rec=outside(border)
    print(shape, np.array_equal(rec,pad))
    print(rec.astype(int))
