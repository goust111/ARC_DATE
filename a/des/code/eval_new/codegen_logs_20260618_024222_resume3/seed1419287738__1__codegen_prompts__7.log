+
+def _sample_row_groups(n: int) -> list[list[int]]:
+    options = {
+        2: [[2], [1, 1]],
+        3: [[3], [2, 1], [1, 2]],
+        4: [[4], [2, 2], [3, 1], [1, 3]],
+    }[n]
