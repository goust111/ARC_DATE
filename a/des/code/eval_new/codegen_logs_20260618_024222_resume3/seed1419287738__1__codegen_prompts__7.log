    return remaining_w >= RECT_W_RANGE[0]


def _build_overlap_rects(avail_h, avail_w, plain_w, near_rows, near_cols, marked_bases, marker_color, pairs):
    if not _has_overlap_width_budget(avail_w, plain_w):
