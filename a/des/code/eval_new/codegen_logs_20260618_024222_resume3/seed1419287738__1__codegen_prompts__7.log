+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.asarray(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    out = np.zeros((h, w), dtype=bool)
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            r0 = max(0, dr)
+            r1 = min(h, h + dr)
+            c0 = max(0, dc)
+            c1 = min(w, w + dc)
+            out[r0:r1, c0:c1] |= mask[r0 - dr : r1 - dr, c0 - dc : c1 - dc]
+    return out
+
+
+def _enclosed_region(blocked: np.ndarray) -> np.ndarray:
+    blocked = np.asarray(blocked, dtype=bool)
+    h, w = blocked.shape
+    seen = np.zeros((h, w), dtype=bool)
+    stack: list[tuple[int, int]] = []
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if not blocked[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not blocked[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and not blocked[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                stack.append((nr, nc))
+    return (~blocked) & (~seen)
+
+
+def _find_separator(grid: np.ndarray) -> tuple[int, int]:
+    rows = [
+        r
+        for r in range(grid.shape[0])
+        if int(grid[r, 0]) != BG and np.all(grid[r, :] == grid[r, 0])
+    ]
+    assert len(rows) == 1, "expected exactly one full-width separator row"
+    sep_r = int(rows[0])
+    return sep_r, int(grid[sep_r, 0])
+
+
+def _marker_direction(marker_rc: tuple[int, int], interior: np.ndarray) -> str:
+    r, c = marker_rc
+    h, w = interior.shape
+    hits: list[str] = []
+    if r + 1 < h and interior[r + 1, c]:
+        hits.append("top")
+    if r - 1 >= 0 and interior[r - 1, c]:
+        hits.append("bottom")
+    if c + 1 < w and interior[r, c + 1]:
+        hits.append("left")
+    if c - 1 >= 0 and interior[r, c - 1]:
+        hits.append("right")
+    assert len(hits) == 1, "marker must face exactly one interior direction"
+    return hits[0]
