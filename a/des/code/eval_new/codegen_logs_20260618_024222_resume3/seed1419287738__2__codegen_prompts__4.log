+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+AZURE = 8
+MAROON = 9
+
+TOWER_COLORS = [BLUE, RED, GREEN, ORANGE]
+DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MIX_MAP = {
+    frozenset((RED, BLUE)): MAGENTA,
+    frozenset((RED, GREEN)): YELLOW,
+    frozenset((BLUE, GREEN)): AZURE,
+}
+GEN_RETRIES = 400
+EXTRA_TOWER_TRIES = 80
