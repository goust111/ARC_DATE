+def _scenario_targets() -> list[tuple[str, object]]:
+    return [
+        ("pair", (RED, BLUE)),
+        ("pair", (RED, GREEN)),
+        ("pair", (BLUE, GREEN)),
+        ("other_pair", None),
+        ("triple", None),
