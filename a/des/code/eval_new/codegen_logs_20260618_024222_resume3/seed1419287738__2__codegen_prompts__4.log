+def _resolve_cell_color(ray_count: int, colors: set[int]) -> int | None:
+    if ray_count <= 0 or not colors:
+        return None
+    if len(colors) == 1:
+        return next(iter(colors))
+    if ray_count == 2 and len(colors) == 2:
