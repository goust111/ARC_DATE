+def _path_to_cross(pos: tuple[int, int], direction: tuple[int, int], cross: tuple[int, int]) -> set[tuple[int, int]]:
+    r, c = pos
+    dr, dc = direction
+    rr = r + 2 * dr
+    cc = c + 2 * dc
+    cells: set[tuple[int, int]] = set()
+    while True:
+        cells.add((rr, cc))
+        if (rr, cc) == cross:
+            return cells
+        rr += dr
+        cc += dc
