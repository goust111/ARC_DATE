+
+def _scenario_targets() -> list[tuple[str, object]]:
+    return [
+        ("pair", (RED, BLUE)),
+        ("pair", (RED, GREEN)),
+        ("pair", (BLUE, GREEN)),
+        ("other_pair", None),
+        ("triple", None),
+    ]
+
+
+def _choose_other_pair(rng: random.Random) -> tuple[int, int]:
+    return rng.choice([(ORANGE, RED), (ORANGE, BLUE), (ORANGE, GREEN)])
