+    nutrient_color: int,
+) -> tuple[dict, set[tuple[int, int]]] | None:
+    for _ in range(POT_RETRIES):
+        outer_h = rng.randint(*OUTER_H_RANGE)
+        outer_w = rng.randint(*OUTER_W_RANGE)
