+                "c0": c0,
+                "outer_h": outer_h,
+                "outer_w": outer_w,
+                "side": side,
+                "gap": gap,
+                "step": step,
+                "seed_color": seed_color,
+                "nutrient_color": nutrient_color,
+                "seed_pos": seed_pos,
+                "nutrient_positions": nutrient_positions,
+                "length": length,
+            }
