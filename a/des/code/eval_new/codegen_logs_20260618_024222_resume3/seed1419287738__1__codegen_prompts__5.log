+def _reserve_cells(
+    height: int,
+    width: int,
+    r0: int,
+    c0: int,
+    outer_h: int,
+    outer_w: int,
+    gap: tuple[int, int],
+    step: tuple[int, int],
+) -> set[tuple[int, int]]:
