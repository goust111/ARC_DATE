+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in points]
+    cols = [c for _, c in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _border_cells(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    pts = [(r0, c) for c in range(c0, c1 + 1)]
+    pts.extend((r, c1) for r in range(r0 + 1, r1))
+    pts.extend((r1, c) for c in range(c1, c0 - 1, -1))
+    pts.extend((r, c0) for r in range(r1 - 1, r0, -1))
+    return pts
+
+
+def _gap_step(
+    r0: int, c0: int, r1: int, c1: int, gap: tuple[int, int]
+) -> tuple[int, int] | None:
+    r, c = gap
+    if r == r0 and c0 < c < c1:
+        return (-1, 0)
+    if r == r1 and c0 < c < c1:
+        return (1, 0)
+    if c == c0 and r0 < r < r1:
+        return (0, -1)
+    if c == c1 and r0 < r < r1:
+        return (0, 1)
+    return None
+
+
+def _read_pot(window: np.ndarray) -> tuple[int, int, int] | None:
