+
+_BG = 0
+_COLOR_POOL = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+_GRID_H_RANGE = (20, 31)
+_GRID_W_RANGE = (20, 31)
+_FRAME_COUNT_CHOICES = (2, 3)
+_FRAME_INTERIORS = [
+    (2, 4),
+    (4, 2),
+    (2, 5),
+    (5, 2),
+    (2, 6),
+    (6, 2),
+    (3, 4),
