+
+
+def _build_group_specs(rng: np.random.Generator) -> list[dict] | None:
+    group_count = int(rng.choice(_FRAME_COUNT_CHOICES))
+    colors = [int(v) for v in rng.choice(_COLOR_POOL, size=group_count, replace=False)]
