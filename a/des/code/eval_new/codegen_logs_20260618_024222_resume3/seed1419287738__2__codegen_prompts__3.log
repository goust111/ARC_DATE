+    for i, color in enumerate(colors):
+        dims = list(_FRAME_INTERIORS)
+        rng.shuffle(dims)
+        spec = None
+        for inner_h, inner_w in dims:
+            chosen = _choose_partition(inner_h, inner_w, tie_flags[i], rng)
+            if chosen is None:
