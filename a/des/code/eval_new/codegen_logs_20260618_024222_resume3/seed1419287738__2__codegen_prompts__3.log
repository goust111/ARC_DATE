+        if not candidates:
+            failed.add(key)
+            return None
+
+        order = list(range(len(candidates)))
+        rng.shuffle(order)
+        order.sort(key=lambda i: candidates[i][2], reverse=True)
+        for i in order:
+            next_occ, piece_mask, _score = candidates[i]
+            tail = rec(next_occ, idx + 1)
+            if tail is not None:
