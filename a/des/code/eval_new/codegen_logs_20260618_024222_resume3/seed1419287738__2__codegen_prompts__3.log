+def _frame_border_cells(top: int, left: int, inner_h: int, inner_w: int) -> list[tuple[int, int]]:
+    r0, c0 = top, left
+    r1 = top + inner_h + 1
+    c1 = left + inner_w + 1
+    cells: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        cells.append((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        cells.append((r, c1))
+    return cells
