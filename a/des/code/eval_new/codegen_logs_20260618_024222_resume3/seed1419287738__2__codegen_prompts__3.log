+def _mark_rect(blocked: np.ndarray, r0: int, c0: int, r1: int, c1: int) -> None:
+    h, w = blocked.shape
+    rr0 = max(0, r0)
+    cc0 = max(0, c0)
+    rr1 = min(h - 1, r1)
+    cc1 = min(w - 1, c1)
+    blocked[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
