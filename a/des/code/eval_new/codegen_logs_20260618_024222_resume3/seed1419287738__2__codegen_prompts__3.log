+import numpy as np
+
+
+_N4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+_RNG = np.random.default_rng()
+
+_BG = 0
+_COLOR_POOL = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+_GRID_H_RANGE = (20, 31)
+_GRID_W_RANGE = (20, 31)
