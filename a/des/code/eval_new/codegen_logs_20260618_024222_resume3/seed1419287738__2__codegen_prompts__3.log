+    for r0 in range(h - outer_h + 1):
+        for c0 in range(w - outer_w + 1):
+            rr0 = max(0, r0 - 1)
+            cc0 = max(0, c0 - 1)
+            rr1 = min(h, r0 + outer_h + 1)
+            cc1 = min(w, c0 + outer_w + 1)
+            if np.any(blocked[rr0:rr1, cc0:cc1]):
