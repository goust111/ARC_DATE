+    return candidates
+
+
+def _mark_fragment(blocked: np.ndarray, top: int, left: int, piece_mask: np.ndarray) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    h, w = blocked.shape
+    for rr, cc in np.argwhere(piece_mask):
+        r = top + int(rr)
+        c = left + int(cc)
+        cells.append((r, c))
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
