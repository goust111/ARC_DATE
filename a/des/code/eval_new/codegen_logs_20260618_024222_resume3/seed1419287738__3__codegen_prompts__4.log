+        left = int(grid[r, 0])
+        right = int(grid[r, w - 1])
+        if left != channel and right == channel:
+            markers[int(r)] = left
+        elif right != channel and left == channel:
+            markers[int(r)] = right
+        else:
+            raise AssertionError(f"horizontal channel row {r} must have exactly one edge marker")
+    return markers
+
