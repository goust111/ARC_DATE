+    return candidates[0]
+
+
+def _consistent_orders(
+    legend: np.ndarray,
+    row_colors: list[int],
+    col_colors: list[int],
+    clues: list[tuple[int, int, int]],
+    max_solutions: int | None = None,
+) -> list[tuple[tuple[int, ...], tuple[int, ...]]]:
