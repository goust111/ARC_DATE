    # stable id
    node_list = list(nodes.items())
    node_ids = {pos: i for i, (pos, _) in enumerate(node_list)}
    node_positions = [pos for pos, _ in node_list]
    node_colors = [color for _, color in node_list]
    return node_positions, node_colors, node_ids


def _grey_component_map(grid: np.ndarray):
    h, w = grid.shape
    comp_map = -np.ones((h, w), dtype=int)
    mask = grid == GREY
    visited = np.zeros_like(mask, dtype=bool)

    comps = []
    for r0 in range(h):
        for c0 in range(w):
            if not mask[r0, c0] or visited[r0, c0]:
                continue
            cid = len(comps)
            q = deque([(r0, c0)])
            visited[r0, c0] = True
            cells = []
            while q:
                r, c = q.popleft()
                cells.append((r, c))
                comp_map[r, c] = cid
                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nr, nc = r + dr, c + dc
                    if _in_bounds(nr, nc, h, w) and mask[nr, nc] and not visited[nr, nc]:
                        visited[nr, nc] = True
                        q.append((nr, nc))
            comps.append(cells)
    return comp_map, comps


def main(grid: np.ndarray) -> np.ndarray:
    """
    1) Input
    -------------
    Read a numpy integer ARC grid, where black=0, gray=5 marks graph edges, and an orange
    framed rules panel encodes neighbor-color replacement rules.

    2) Structure extraction
    -----------------------
    Detect the orange rule panel, extract rules, then detect all 2x2 non-background nodes
    and build gray-edge connected components to form node adjacency.

    3) Rule evaluation
    ------------------
    For each node, collect direct neighbor colors via gray edges and apply the first
    matching rule in panel order: (A,B)->C if A and B are both present.

    4) Output
    ----------
    Return a new grid with only node 2x2 blocks recolored (or unchanged), while edges and
    the rules panel stay exactly the same size/shape as input.
    """

    grid = np.asarray(grid)
    h, w = grid.shape

    panel = _find_rule_panel(grid)
    rules = _parse_panel_rules(grid)

    node_positions, node_colors, node_ids = _extract_nodes(grid, panel)
    if not node_positions:
        return np.array(grid, copy=True)

    comp_map, _ = _grey_component_map(grid)
    comp_touch = defaultdict(set)

    for pos, nid in node_ids.items():
        r0, c0 = pos
        r1, c1 = r0 + 1, c0 + 1

        candidates = []
        for c in (c0, c1):
            if r0 - 1 >= 0:
                candidates.append((r0 - 1, c))
            if r1 + 1 < h:
                candidates.append((r1 + 1, c))
        for r in (r0, r1):
            if c0 - 1 >= 0:
                candidates.append((r, c0 - 1))
            if c1 + 1 < w:
                candidates.append((r, c1 + 1))

        for rr, cc in candidates:
            cid = comp_map[rr, cc]
            if cid >= 0:
                comp_touch[cid].add(nid)

    graph = [set() for _ in node_positions]
    for node_set in comp_touch.values():
        if len(node_set) == 2:
            a, b = sorted(node_set)
            graph[a].add(b)
            graph[b].add(a)
        elif len(node_set) > 2:
            ids = list(node_set)
            for i in range(len(ids)):
                for j in range(i + 1, len(ids)):
                    u, v = ids[i], ids[j]
                    graph[u].add(v)
                    graph[v].add(u)

    out = np.array(grid, copy=True)
    for idx, (r0, c0) in enumerate(node_positions):
        neigh_colors = {node_colors[n] for n in graph[idx]}

        new_color = node_colors[idx]
        for a, b, c in rules:
            if a in neigh_colors and b in neigh_colors:
                new_color = c
                break

        out[r0 : r0 + 2, c0 : c0 + 2] = new_color

    return out


def _draw_horizontal_edge(grid: np.ndarray, c1: int, c2: int, r: int):
    if c1 > c2:
        c1, c2 = c2, c1
    for c in range(c1, c2 + 1):
        grid[r, c] = GREY


def _draw_vertical_edge(grid: np.ndarray, r1: int, r2: int, c: int):
    if r1 > r2:
        r1, r2 = r2, r1
    for rr in range(r1, r2 + 1):
        grid[rr, c] = GREY


def generate_input() -> np.ndarray:
    """
    1) Sample layout
    --------------
    Randomly choose a small lattice of 2x2 nodes and random spacing.

    2) Draw structure
    -----------------
    Place node blocks, then connect random right/down neighbors with 1-pixel gray lines.

    3) Draw rules panel
    -------------------
    Place an orange rectangle panel and fill several rows with (A,B)->C encoded rows.

    4) Return
    --------
    Return an integer numpy grid within 30x30, always suitable for ARC-style parsing.
    """

    rng = random.Random()

    node_palette = [1, 2, 3, 4, 6, 8, 9, 10]

    rows = rng.randint(2, 4)
    cols = rng.randint(2, 4)
    gap = rng.randint(1, 3)
    node_w = cols * 2 + (cols - 1) * gap
    node_h = rows * 2 + (rows - 1) * gap

    rule_count = rng.randint(2, min(6, max(1, rows * cols)))
    panel_h = rule_count + 2
    panel_w = 7

    if node_w + panel_w + 4 <= 30:
        h = max(node_h + 2, panel_h + 2)
        w = node_w + panel_w + 4
        panel_right = True
    else:
        h = node_h + panel_h + 3
        w = max(node_w + 2, panel_w + 2)
        panel_right = False

    h = min(30, max(10, h))
    w = min(30, max(10, w))

    grid = np.zeros((h, w), dtype=np.int32)

    origin_r = 1
    origin_c = 1
    node_positions = []
    node_colors = {}

    idx = 0
    for ri in range(rows):
        for ci in range(cols):
            r = origin_r + ri * (2 + gap)
            c = origin_c + ci * (2 + gap)
            if r + 1 >= h or c + 1 >= w:
                continue
            color = rng.choice(node_palette)
            grid[r : r + 2, c : c + 2] = color
            node_positions.append((ri, ci, r, c, idx))
            node_colors[idx] = color
            idx += 1

    if not node_positions:
        return grid

    # Build random adjacency on grid lattice.
    edges = set()
    for _, _, _, _, i in node_positions:
        node_positions_by_rc = {(ri, ci): i for ri, ci, _, _, i in node_positions}
    for ri, ci, r, c, i in node_positions:
        right = node_positions_by_rc.get((ri, ci + 1))
        down = node_positions_by_rc.get((ri + 1, ci))
        if right is not None and rng.random() < 0.7:
            edges.add((i, right))
        if down is not None and rng.random() < 0.7:
            edges.add((i, down))

    # Make sure no node stays fully isolated unless layout is tiny.
    degrees = defaultdict(int)
    for u, v in edges:
        degrees[u] += 1
        degrees[v] += 1

    for _, _, _, _, i in node_positions:
        if degrees[i] == 0 and len(node_positions) > 1:
            candidates = [j for _, _, _, _, j in node_positions if j != i]
            best = rng.choice(candidates)
            a = min(i, best)
            b = max(i, best)
            edges.add((a, b))

    by_id = {i: (r, c) for _, _, r, c, i in node_positions}
    for u, v in edges:
        r1, c1 = by_id[u]
        r2, c2 = by_id[v]
        if r1 == r2:
            row = min(r1, r2) + 1
            c_start = c1 + 2
            c_end = c2 - 1
            _draw_horizontal_edge(grid, c_start, c_end, row)
        else:
            col = c1 + 1
            r_start = r1 + 2
            r_end = r2 - 1
            _draw_vertical_edge(grid, r_start, r_end, col)

    # Place panel.
    if panel_right and origin_c + cols * (2 + gap) + panel_w + 2 < w:
        pr0 = 1
        pc0 = origin_c + cols * (2 + gap) + 1
    else:
        pr0 = origin_r + rows * (2 + gap) + 1
        pc0 = 1
        if pr0 + panel_h >= h:
            pr0 = 1

    pr1 = min(h - 1, pr0 + panel_h - 1)
    pc1 = min(w - 1, pc0 + panel_w - 1)

    if pr1 - pr0 < 1 or pc1 - pc0 < 1:
        return grid

    # Orange frame
    grid[pr0, pc0 : pc1 + 1] = ORANGE
    grid[pr1, pc0 : pc1 + 1] = ORANGE
    grid[pr0 : pr1 + 1, pc0] = ORANGE
    grid[pr0 : pr1 + 1, pc1] = ORANGE

    used_rule_rows = []
    for r in range(rule_count):
        rr = pr0 + 1 + r
        a, b, c = (rng.choice(node_palette) for _ in range(3))
        if a == b:
            b = rng.choice([x for x in node_palette if x != a])
        grid[rr, pc0 + 1] = a
        grid[rr, pc0 + 2] = b
        grid[rr, pc0 + 3] = BG
        grid[rr, pc0 + 4] = c
        used_rule_rows.append((a, b, c))

    return grid


if __name__ == "__main__":
    g = generate_input()
    out = main(g)
    print(g.shape, out.shape)
