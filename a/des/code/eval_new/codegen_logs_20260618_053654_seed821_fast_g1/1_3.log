import numpy as np
from collections import deque
from itertools import permutations


def _share_coord(a, b):
    return a[0] == b[0] or a[1] == b[1]


def _draw_straight_line(arr, color, p0, p1):
    r0, c0 = p0
    r1, c1 = p1
    if r0 == r1:
        r = r0
        lo, hi = (c0, c1) if c0 <= c1 else (c1, c0)
        arr[r, lo : hi + 1] = color
        return
    if c0 == c1:
        c = c0
        lo, hi = (r0, r1) if r0 <= r1 else (r1, r0)
        arr[lo : hi + 1, c] = color


def _extract_segments(grid, color):
    mask = grid == color
    visited = np.zeros_like(mask, dtype=bool)
    segments = []
    h, w = grid.shape

    for r in range(h):
        for c in range(w):
            if not mask[r, c] or visited[r, c]:
                continue

            queue = deque([(r, c)])
            visited[r, c] = True
            cells = []
            while queue:
                cr, cc = queue.popleft()
                cells.append((cr, cc))
                if cr > 0 and mask[cr - 1, cc] and not visited[cr - 1, cc]:
                    visited[cr - 1, cc] = True
                    queue.append((cr - 1, cc))
                if cr + 1 < h and mask[cr + 1, cc] and not visited[cr + 1, cc]:
                    visited[cr + 1, cc] = True
                    queue.append((cr + 1, cc))
                if cc > 0 and mask[cr, cc - 1] and not visited[cr, cc - 1]:
                    visited[cr, cc - 1] = True
                    queue.append((cr, cc - 1))
                if cc + 1 < w and mask[cr, cc + 1] and not visited[cr, cc + 1]:
                    visited[cr, cc + 1] = True
                    queue.append((cr, cc + 1))

            rows = [x for x, _ in cells]
            cols = [y for _, y in cells]
            if len(cells) < 2:
                continue
            min_r, max_r = min(rows), max(rows)
            min_c, max_c = min(cols), max(cols)
            if len(set(rows)) == 1:
                segments.append({\"ends\": ((rows[0], min_c), (rows[0], max_c)), \"color\": color})
            elif len(set(cols)) == 1:
                segments.append({\"ends\": ((min_r, cols[0]), (max_r, cols[0])), \"color\": color})

    return segments


def _find_cycle(segments):
    if len(segments) < 3:
        return None

    n = len(segments)
    ends = np.array([seg[\"ends\"] for seg in segments], dtype=int)

    def dfs(pos, perm, first_seg, first_in_pt, prev_out, assignment):
        if pos == n:
            if _share_coord(prev_out, tuple(first_in_pt)):
                return assignment
            return None

        seg = perm[pos]
        a, b = ends[seg]
        p0 = tuple(a.tolist())
        p1 = tuple(b.tolist())

        for in_idx, in_pt in ((0, p0), (1, p1)):
            if not _share_coord(prev_out, in_pt):
                continue
            out_idx = 1 - in_idx
            out_pt = p1 if out_idx == 1 else p0
            assignment[seg] = (in_idx, out_idx)
            result = dfs(pos + 1, perm, first_seg, first_in_pt, out_pt, assignment)
            if result is not None:
                return result
            del assignment[seg]

        return None

    for perm in permutations(range(n)):
        first_seg = perm[0]
        first_ends = ends[first_seg]
        p0 = tuple(first_ends[0].tolist())
        p1 = tuple(first_ends[1].tolist())
        for first_in in (0, 1):
            first_out = 1 - first_in
            in_pt = p0 if first_in == 0 else p1
            out_pt = p1 if first_out == 1 else p0
            assignment = {first_seg: (first_in, first_out)}
            result = dfs(1, perm, first_seg, in_pt, out_pt, assignment)
            if result is not None:
                ordered = [perm[i] for i in range(n)]
                return ordered, result

    return None


def _fill_inside_color(arr, color):
    mask = arr == color
    if not np.any(mask):
        return

    rows = np.where(mask)[0]
    cols = np.where(mask)[1]
    h, w = arr.shape
    r0 = max(0, int(rows.min()) - 1)
    r1 = min(h - 1, int(rows.max()) + 1)
    c0 = max(0, int(cols.min()) - 1)
    c1 = min(w - 1, int(cols.max()) + 1)

    wall = arr "'!= 0
