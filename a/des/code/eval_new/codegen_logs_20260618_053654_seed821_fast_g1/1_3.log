                continue
            out_idx = 1 - in_idx
            out_pt = s0 if out_idx == 0 else s1
            assignment[seg] = (in_idx, out_idx)
            out = backtrack(pos + 1, perm, first_seg, first_in_point, out_pt, assignment)
            if out is not None:
