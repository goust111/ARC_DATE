            q.append((r, c + 1))

    fill_mask = (arr == 0) & ~visited
    fill_mask &= np.logical_and.reduce((np.arange(h)[:, None] >= r0, np.arange(h)[:, None] <= r1, np.ones((h, w), dtype=bool), np.ones((h, w), dtype=bool)))
    fill_mask &= np.logical_and.reduce((np.ones((h, w), dtype=bool), np.ones((h, w), dtype=bool), np.arange(w)[None, :] >= c0, np.arange(w)[None, :] <= c1))

