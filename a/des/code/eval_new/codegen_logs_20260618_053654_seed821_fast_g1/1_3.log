            visited[r, c] = True
            comp = []
            while queue:
                cr, cc = queue.popleft()
                comp.append((cr, cc))
                if cr > 0 and mask[cr - 1, cc] and not visited[cr - 1, cc]:
                    visited[cr - 1, cc] = True
