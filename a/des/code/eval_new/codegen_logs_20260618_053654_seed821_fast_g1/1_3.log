        return [(r0, c) for c in range(c_start, c_end + 1)]
    c = c0
    r_start, r_end = (r0, r1) if r0 <= r1 else (r1, r0)
    return [(r, c) for r in range(r_start, r_end + 1)]


def _can_place(grid, candidate_cells):
    h, w = grid.shape
    for r, c in candidate_cells:
        for dr in (-1, 0, 1):
            for dc in (-1, 0, 1):
                rr = r + dr
                cc = c + dc
                if 0 <= rr < h and 0 <= cc < w and grid[rr, cc] != 0:
                    return False
    return True


def _shift_segments(segments, dr, dc):
    moved = []
    for (r0, c0), (r1, c1) in segments:
        moved.append(((r0 + dr, c0 + dc), (r1 + dr, c1 + dc)))
    return moved


def _build_shape_segments(count, rng):
    if count == 3:
        top = 0
        right = int(rng.integers(4, 9))
        far = right + int(rng.integers(3, 7))
        depth = int(rng.integers(3, 8))
        return [
            ((top, 0), (top, right)),
            ((top + 1, right), (top + depth, right)),
            ((top + depth, 0), (top + depth, far)),
        ]

    if count == 4:
        top = 0
        x1 = int(rng.integers(3, 7))
        x2 = x1 + int(rng.integers(2, 5))
        depth = int(rng.integers(4, 8))
        return [
            ((top, 0), (top, x2)),
            ((top + 1, x2), (top + depth, x2)),
            ((top + depth, x1), (top + depth, x2)),
            ((top + 1, x1), (top + depth, x1)),
        ]

    # count == 5
    top = 0
    right = int(rng.integers(4, 9))
    depth = int(rng.integers(4, 8))
    left = 1
    return [
        ((top, 0), (top, right)),
        ((top + 1, right), (top + depth, right)),
        ((top + depth, left), (top + depth, right)),
        ((top + 1, left), (top + depth, left)),
        ((top + 1, 0), (top + 1, left)),
    ]


def generate_input() -> np.ndarray:
    """Random ARC-style input generator for this task."""

    rng = np.random.default_rng()
    h = int(rng.integers(20, 31))
    w = int(rng.integers(20, 31))
    grid = np.zeros((h, w), dtype=np.int32)

    color_pool = [1, 2, 3, 4, 5, 6, 7, 8, 9]
    num_colors = int(rng.integers(1, 4))
    selected = color_pool[:num_colors]

    for color in selected:
        placed = False
        for _ in range(200):
            k = int(rng.integers(3, 6))
            segments = _build_shape_segments(k, rng)
            rng.shuffle(segments)

            candidate = []
            for seg in segments:
                candidate.extend(_segment_cells(seg))
            rs = [p[0] for p in candidate]
            cs = [p[1] for p in candidate]
            min_r, min_c = min(rs), min(cs)

            if not _can_place(grid, _segment_cells(((0, 0), (0, 0)))):
                return grid

            max_r = h - (max(rs) - min_r) - 3
            max_c = w - (max(cs) - min_c) - 3
            if max_r < 2 or max_c < 2:
                continue

            dr = int(rng.integers(1, max_r + 1))
            dc = int(rng.integers(1, max_c + 1))
            moved = _shift_segments(segments, dr - min_r, dc - min_c)

            moved_cells = []
            for seg in moved:
                moved_cells.extend(_segment_cells(seg))

            if not _can_place(grid, moved_cells):
                continue

            for seg in moved:
                _draw_straight_line(grid, color, *seg)
            placed = True
            break

        if not placed:
            # fallback: put a tiny safe 2-cell segment
            rr = int(rng.integers(1, h - 1))
            cc = int(rng.integers(1, w - 2))
            if _can_place(grid, [(rr, cc), (rr, cc + 1)]):
                _draw_straight_line(grid, color, (rr, cc), (rr, cc + 1))

    return grid


def main(grid: np.ndarray) -> np.ndarray:
    """Task intent.

    - Identify same-color straight segments and reconstruct their cyclic connection order.
    - Add missing orthogonal connectors between matched endpoints for each color.
    - Fill all background cells enclosed by each color'"'s closed boundary.

    Input/Output.
    - Input: integer ARC grid with black background 0 and finite color groups (one color per puzzle object).
    - Output: same shape ndarray where each group's missing edges are restored and enclosed regions filled.

    Core idea.
    - For each color, extract connected components; each component is expected to be one straight segment.
    - Try all permutations and endpoint orientations, keeping only cycles where consecutive segments share row or column.
    - Draw connectors for the found cycle and flood fill the background area not reachable from the cycle bbox border.

    Returns.
    - An integer ndarray with only background, reconstructed segment lines, and interior fills for every color.
    \"\"\"

    result = np.array(grid, copy=True)
    colors = [int(c) for c in np.unique(result) if c "'!= 0]

    for color in colors:
        segments = _extract_segments(result, color)
        if len(segments) < 3:
            continue

        found = _find_cycle(segments)
        if found is None:
            continue

        order, endpoint_map = found
        n = len(order)

        for i in range(n):
            cur = segments[order[i]]
            nxt = segments[order[(i + 1) % n]]
            cur_out = cur["ends"][endpoint_map[order[i]][1]]
            next_in = nxt["ends"][endpoint_map[order[(i + 1) % n]][0]]
            _draw_straight_line(result, color, cur_out, next_in)

        _fill_inside_color(result, color)

    return result
