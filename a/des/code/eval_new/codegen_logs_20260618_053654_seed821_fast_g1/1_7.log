import random
from collections import defaultdict, deque

import numpy as np


BG = 0
GREY = 5
ORANGE = 7


def _in_bounds(r: int, c: int, h: int, w: int) -> bool:
    return 0 <= r < h and 0 <= c < w


def _extract_components(mask: np.ndarray):
    h, w = mask.shape
    visited = np.zeros_like(mask, dtype=bool)
    comps = []

    for r0 in range(h):
        for c0 in range(w):
            if not mask[r0, c0] or visited[r0, c0]:
                continue
            q = deque([(r0, c0)])
            visited[r0, c0] = True
            cells = []
            while q:
                r, c = q.popleft()
                cells.append((r, c))
                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nr, nc = r + dr, c + dc
                    if _in_bounds(nr, nc, h, w) and mask[nr, nc] and not visited[nr, nc]:
                        visited[nr, nc] = True
                        q.append((nr, nc))
            comps.append(cells)
    return comps


def _find_rule_panel(grid: np.ndarray):
    h, w = grid.shape
    orange_mask = grid == ORANGE
    comps = _extract_components(orange_mask)
    candidates = []

    for cells in comps:
        rs = [p[0] for p in cells]
        cs = [p[1] for p in cells]
        r0, r1 = min(rs), max(rs)
        c0, c1 = min(cs), max(cs)
        hh = r1 - r0 + 1
        ww = c1 - c0 + 1

        if hh < 3 or ww < 3:
            continue

        # Expect a 1-pixel-wide rectangular frame.
        expected = 2 * (hh + ww) - 4
        if len(cells) != expected:
            continue

        ok = True
        for c in range(c0, c1 + 1):
            if grid[r0, c] != ORANGE or grid[r1, c] != ORANGE:
                ok = False
                break
        if not ok:
            continue

        for r in range(r0 + 1, r1):
            if grid[r, c0] != ORANGE or grid[r, r0 == r0 and c1 if False else c1] != ORANGE:
                # above line is intentional placeholder to keep loop body readable in Python
                pass

        for r in range(r0 + 1, r1):
            if grid[r, c0] != ORANGE or grid[r, c1] != ORANGE:
                ok = False
                break

        if not ok:
            continue

        candidates.append((r0, r1, c0, c1, len(cells)))

    if not candidates:
        return None
    candidates.sort(key=lambda t: (t[4], -(t[1] - t[0]) * (t[3] - t[2])), reverse=True)
    r0, r1, c0, c1, _ = candidates[0]
    return r0, r1, c0, c1


def _parse_panel_rules(grid: np.ndarray):
    panel = _find_rule_panel(grid)
    if panel is None:
        return []

    pr0, pr1, pc0, pc1 = panel
    rules = []

    def _is_rule_color(v: int) -> bool:
        return v != BG and v != GREY and v != ORANGE

    for r in range(pr0 + 1, pr1):
        row = grid[r, pc0 + 1 : pc1]
        for c in range(len(row) - 3):
            a, b, gap, out = row[c], row[c + 1], row[c + 2], row[c + 3]
            if _is_rule_color(int(a)) and _is_rule_color(int(b)) and _is_rule_color(int(out)) and gap == BG:
                if row[c - 1] == BG if c - 1 >= 0 else True:
                    if c + 4 >= len(row) or row[c + 4] == BG:
                        rules.append((int(a), int(b), int(out)))
                        break
    return rules


def _extract_nodes(grid: np.ndarray, panel):
    h, w = grid.shape
    node_mask = (grid != BG) & (grid != GREY)

    if panel is not None:
        pr0, pr1, pc0, pc1 = panel
        node_mask[pr0:pr1 + 1, pc0:pc1 + 1] = False

    comps = _extract_components(node_mask)

    nodes = {}
    for cell in comps:
        if len(cell) != 4:
            continue
        rs = [p[0] for p in cell]
        cs = [p[1] for p in cell]
        r0, r1 = min(rs), max(rs)
        c0, c1 = min(cs), max(cs)
        if r1 - r0 != 1 or c1 - c0 != 1:
            continue
        color = int(grid[r0, c0])
        if any(grid[r, c] != color for r, c in cell):
            continue
        nodes[(r0, c0)] = color

    # stable id
    node_list = list(nodes.items())
    node_ids = {pos: i for i, (pos, _) in enumerate(node_list)}
    node_positions = [pos for pos, _ in node_list]
    node_colors = [color for _, color in node_list]
    return node_positions, node_colors, node_ids


def _grey_component_map(grid: np.ndarray):
    h, w = grid.shape
    comp_map = -np.ones((h, w), dtype=int)
    mask = grid == GREY
    visited = np.zeros_like(mask, dtype=bool)

    comps = []
    for r0 in range(h):
        for c0 in range(w):
            if not mask[r0, c0] or visited[r0, c0]:
                continue
            cid = len(comps)
            q = deque([(r0, c0)])
            visited[r0, c0] = True
            cells = []
            while q:
                r, c = q.popleft()
                cells.append((r, c))
                comp_map[r, c] = cid
                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nr, nc = r + dr, c + dc
                    if _in_bounds(nr, nc, h, w) and mask[nr, nc] and not visited[nr, nc]:
                        visited[nr, nc] = True
                        q.append((nr, nc))
            comps.append(cells)
    return comp_map, comps


def main(grid: np.ndarray) -> np.ndarray:
    """
    1) Input
    -------------
    Read a numpy integer ARC grid, where black=0, gray=5 marks graph edges, and an orange
    framed rules panel encodes neighbor-color replacement rules.

    2) Structure extraction
    -----------------------
    Detect the orange rule panel, extract rules, then detect all 2x2 non-background nodes
    and build gray-edge connected components to form node adjacency.

    3) Rule evaluation
    ------------------
    For each node, collect direct neighbor colors via gray edges and apply the first
    matching rule in panel order: (A,B)->C if A and B are both present.

    4) Output
    ----------
    Return a new grid with only node 2x2 blocks recolored (or unchanged), while edges and
    the rules panel stay exactly the same size/shape as input.
    """

    grid = np.asarray(grid)
    h, w = grid.shape

    panel = _find_rule_panel(grid)
    rules = _parse_panel_rules(grid)

    node_positions, node_colors, node_ids = _extract_nodes(grid, panel)
    if not node_positions:
        return np.array(grid, copy=True)

    comp_map, _ = _grey_component_map(grid)
    comp_touch = defaultdict(set)

    for pos, nid in node_ids.items():
        r0, c0 = pos
        r1, c1 = r0 + 1, c0 + 1

        candidates = []
        for c in (c0, c1):
            if r0 - 1 >= 0:
                candidates.append((r0 - 1, c))
            if r1 + 1 < h:
                candidates.append((r1 + 1, c))
        for r in (r0, r1):
            if c0 - 1 >= 0:
                candidates.append((r, c0 - 1))
            if c1 + 1 < w:
                candidates.append((r, c1 + 1))

        for rr, cc in candidates:
            cid = comp_map[rr, cc]
            if cid >= 0:
                comp_touch[cid].add(nid)

    graph = [set() for _ in node_positions]
    for node_set in comp_touch.values():
        if len(node_set) == 2:
            a, b = sorted(node_set)
            graph[a].add(b)
            graph[b].add(a)
        elif len(node_set) > 2:
            ids = list(node_set)
            for i in range(len(ids)):
                for j in range(i + 1, len(ids)):
                    u, v = ids[i], ids[j]
                    graph[u].add(v)
                    graph[v].add(u)

    out = np.array(grid, copy=True)
    for idx, (r0, c0) in enumerate(node_positions):
        neigh_colors = {node_colors[n] for n in graph[idx]}

        new_color = node_colors[idx]
        for a, b, c in rules:
            if a in neigh_colors and b in neigh_colors:
                new_color = c
                break

        out[r0 : r0 + 2, c0 : c0 + 2] = new_color

    return out


