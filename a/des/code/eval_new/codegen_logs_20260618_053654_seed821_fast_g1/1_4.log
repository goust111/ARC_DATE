            dist = abs(tpl["center"] - bar["center"])
            if dist < best_dist:
                best_dist = dist
                best_idx = i
        if best_idx == -1:
            continue
        used.add(best_idx)
        pairs.append((sorted_templates[best_idx], bar))

        if len(used) == len(sorted_templates):
            break

    return pairs


