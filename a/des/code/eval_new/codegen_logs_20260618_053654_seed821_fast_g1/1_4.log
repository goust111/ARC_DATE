def _is_l_shape(cells: Iterable[Tuple[int, int]]) -> bool:
    cells = tuple(cells)
    if len(cells) != 3:
        return False
    s = set(cells)
    degrees: List[int] = []
    for r, c in cells:
        deg = 0
        for dr, dc in DIRS:
            if (r + dr, c + dc) in s:
                deg += 1
        degrees.append(deg)
    degrees.sort()
    return degrees == [1, 1, 2]


def _is_frame_component(
    comp: Dict,
    comp_id: np.ndarray,
    grid: np.ndarray,
    bg: int,
) -> bool:
    cid = comp["id"]
    r1, r2, c1, c2 = comp["bbox"]
    h = r2 - r1 + 1
    w = c2 - c1 + 1

    if h < 3 or w < 3:
        return False

    expected_border = 2 * (h + w) - 4
    if comp["size"] != expected_border:
        return False

    # Border must be fully occupied by this component and non-bg.
    for c in range(c1, c2 + 1):
        if grid[r1, c] == bg or comp_id[r1, c] != cid:
            return False
        if grid[r2, c] == bg or comp_id[r2, c] != cid:
            return False
    for r in range(r1 + 1, r2):
        if grid[r, c1] == bg or comp_id[r, c1] != cid:
            return False
        if grid[r, c2] == bg or comp_id[r, c2] != cid:
            return False

    # Interior must be bg.
    if h > 2 and w > 2:
        for r in range(r1 + 1, r2):
            if np.any(grid[r, c1 + 1 : c2] != bg):
                return False

    return True


def _frame_info(comp: Dict, grid: np.ndarray) -> Dict:
    colors = [int(grid[r, c]) for r, c in comp["cells"]]
    cnt = Counter(colors)
    dom_color, _ = cnt.most_common(1)[0]
    maroon = sum(v for color, v in cnt.items() if color != dom_color)
    r1, r2, c1, c2 = comp["bbox"]

    return {
        "id": comp["id"],
        "bbox": comp["bbox"],
        "inner_h": (r2 - r1 - 1),
        "inner_w": (c2 - c1 - 1),
        "maroon_count": maroon,
        "dominant_color": dom_color,
    }


def _bbox_dims(comp: Dict) -> Tuple[int, int]:
    r1, r2, c1, c2 = comp["bbox"]
    return c2 - c1 + 1, r2 - r1 + 1

def _first_frame_hit_for_cell(
    start: Tuple[int, int],
    direction: int,
    grid: np.ndarray,
    comp_id: np.ndarray,
    frame_ids: set,
    bg: int,
) -> int:
    h, w = grid.shape
    dr, dc = DIRS[direction]
    r, c = start
    nr, nc = r + dr, c + dc
    while 0 <= nr < h and 0 <= nc < w:
        cell_color = int(grid[nr, nc])
        if cell_color == bg:
            nr, nc = nr + dr, nc + dc
            continue

        fid = int(comp_id[nr, nc])
        if fid in frame_ids:
            return fid
        return -1

    return -1


def _frame_repeat_count(
    frame: Dict,
    src_w: int,
    src_h: int,
    direction: int,
) -> int:
    inner_w = frame["inner_w"]
    inner_h = frame["inner_h"]

    if direction in (0, 1):
        if inner_h != src_h:
            return 0
        if inner_w % src_w != 0:
            return 0
        return inner_w // src_w

    if direction in (2, 3):
        if inner_w != src_w:
            return 0
        if inner_h % src_h != 0:
            return 0
        return inner_h // src_h


