import numpy as np
from collections import Counter, deque
from typing import Dict, Iterable, List, Tuple


DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
DIR_NAMES = ("up", "down", "left", "right")


def _connected_components(grid: np.ndarray, bg: int) -> Tuple[List[Dict], np.ndarray]:
    h, w = grid.shape
    comp_id = -np.ones((h, w), dtype=np.int32)
    comps: List[Dict] = []
    cid = 0

    for r in range(h):
        for c in range(w):
            if grid[r, c] == bg or comp_id[r, c] != -1:
                continue

            q = deque([(r, c)])
            comp_id[r, c] = cid
            cells: List[Tuple[int, int]] = []
            colors = set()
            min_r = min_c = 10**9
            max_r = max_c = -1

            while q:
                cr, cc = q.popleft()
                cells.append((cr, cc))
                color = int(grid[cr, cc])
                colors.add(color)
                min_r = min(min_r, cr)
                max_r = max(max_r, cr)
                min_c = min(min_c, cc)
                max_c = max(max_c, cc)

                for dr, dc in DIRS:
                    nr, nc = cr + dr, cc + dc
                    if (
                        0 <= nr < h
                        and 0 <= nc < w
                        and comp_id[nr, nc] == -1
                        and grid[nr, nc] != bg
                    ):
                        comp_id[nr, nc] = cid
                        q.append((nr, nc))

            comps.append(
                {
                    "id": cid,
                    "cells": tuple(cells),
                    "size": len(cells),
                    "colors": colors,
                    "color": next(iter(colors)) if len(colors) == 1 else None,
                    "bbox": (min_r, max_r, min_c, max_c),
                }
            )
            cid += 1

    return comps, comp_id


