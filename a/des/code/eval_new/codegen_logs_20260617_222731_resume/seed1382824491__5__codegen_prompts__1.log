+    layer_colors: list[int] = []
+    max_layers = min(3, min(h, w) // 2)
+    for inset in range(max_layers + 1):
+        coords = _perimeter_coords(h, w, inset)
+        values = {int(sub[rr, cc]) for rr, cc in coords}
+        if len(values) != 1:
