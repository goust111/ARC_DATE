+import numpy as np
+
+
+BG = 0
+GREY = 5
+RING = [2, 7, 4, 3, 8, 1, 6, 9]  # red, orange, yellow, green, azure, blue, magenta, maroon
+RING_INDEX = {color: idx for idx, color in enumerate(RING)}
+MAX_SIDE = 30
+GEN_RETRIES = 400
