+def _crop_mask(points: list[tuple[int, int]], bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in points:
+        mask[r - r0, c - c0] = True
+    return mask
