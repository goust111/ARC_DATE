+def _perimeter_coords(h: int, w: int, inset: int) -> list[tuple[int, int]]:
+    r0 = inset
+    c0 = inset
+    r1 = h - 1 - inset
+    c1 = w - 1 - inset
+    coords: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        coords.append((r0, c))
+        if r1 != r0:
+            coords.append((r1, c))
+    for r in range(r0 + 1, r1):
