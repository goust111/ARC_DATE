+        sides = _compartment_sides(abs_compartments[comp_idx], (fr0, fc0, fr1, fc1))
+        usable = [side for side in sides if side not in used_sides]
+        if not usable:
+            return None
+        side = random.choice(usable)
+        used_sides.add(side)
+        along = random.choice(sides[side])
+        if side == "top":
+            dr, dc = fr0, along
+        elif side == "bottom":
+            dr, dc = fr1, along
+        elif side == "left":
+            dr, dc = along, fc0
+        else:
