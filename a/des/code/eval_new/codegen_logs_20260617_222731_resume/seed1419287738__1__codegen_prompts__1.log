+    rows = [r for r, _ in content]
+    cols = [c for _, c in content]
+    dr, dc = release_dir
+    if dr < 0:
+        return (r0 - 1) - max(rows), 0
+    if dr > 0:
+        return (r1 + 1) - min(rows), 0
+    if dc < 0:
+        return 0, (c0 - 1) - max(cols)
+    if dc > 0:
+        return 0, (c1 + 1) - min(cols)
+    raise AssertionError("release direction must be cardinal")
