 192: def _frame_positions(size: int, patch_shape: tuple[int, int]) -> list[tuple[int, int]]:
 193:     positions: list[tuple[int, int]] = []
 194:     for r in range(_GRID_SHAPE[0] - size + 1):
 195:         for c in range(_GRID_SHAPE[1] - size + 1):
 196:             frame_bbox = (r, c, r + size - 1, c + size - 1)
 197:             if _outside_locations(frame_bbox, patch_shape):
 198:                 positions.append((r, c))
 199:     return positions
