 167: # Sprite color pool and source masks.
 168: _SPRITE_COLORS = tuple(c for c in range(_COLOR_COUNT) if c not in {_BG, _FRAME_COLOR})
 169: _SPRITE_SINGLE = np.ones((1, 1), dtype=bool)
