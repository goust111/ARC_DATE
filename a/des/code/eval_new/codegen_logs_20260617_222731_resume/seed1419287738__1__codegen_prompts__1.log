 204:     grid[r0 : r1 + 1, c1] = color
 205:     grid[r0, c0 : c1 + 1] = color
 206:     grid[r1, c0 : c1 + 1] = color
 207: 
 208: def _sample_sprite(size: int) -> np.ndarray:
 209:     return _SPRITE_SINGLE.copy() if size == _SINGLE_PIXEL_FRAME_SIZE else random.choice(_SPRITE_PATTERNS_2X2).copy()
 210: 
 211: def _sample_case() -> tuple[int, int, np.ndarray]:
 212:     sprite_color = random.choice(_SPRITE_COLORS)
 213:     size = random.randint(_FRAME_SIZE_MIN, _FRAME_SIZE_MAX)
 214:     return sprite_color, size, _sample_sprite(size)
