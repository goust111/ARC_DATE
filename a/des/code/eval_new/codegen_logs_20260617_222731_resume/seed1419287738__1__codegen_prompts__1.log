+
+
+def _isolated_key_spots(
+    sub: np.ndarray, comp_box: tuple[int, int, int, int], occupied: set[tuple[int, int]]
+) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = comp_box
+    spots = []
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            if (r, c) in occupied or int(sub[r, c]) != BG:
