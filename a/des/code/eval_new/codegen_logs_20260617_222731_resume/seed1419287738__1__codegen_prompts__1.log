 178: def _outside_locations(
 179:     frame_bbox: tuple[int, int, int, int], patch_shape: tuple[int, int]
 180: ) -> list[tuple[int, int]]:
 181:     fr0, fc0, fr1, fc1 = frame_bbox
 182:     ph, pw = patch_shape
 183:     locations: list[tuple[int, int]] = []
 184:     for r in range(_GRID_SHAPE[0] - ph + 1):
 185:         for c in range(_GRID_SHAPE[1] - pw + 1):
 186:             pr0, pc0, pr1, pc1 = r, c, r + ph - 1, c + pw - 1
 187:             separated = pr1 < fr0 or pr0 > fr1 or pc1 < fc0 or pc0 > fc1
 188:             if separated:
 189:                 locations.append((r, c))
 190:     return locations
