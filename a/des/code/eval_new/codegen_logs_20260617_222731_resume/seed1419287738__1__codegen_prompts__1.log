+        comps = [
+            (1, 1, wall_row - 1, wall_col - 1),
+            (1, wall_col + 1, wall_row - 1, w - 2),
+            (wall_row + 1, 1, h - 2, wall_col - 1),
+            (wall_row + 1, wall_col + 1, h - 2, w - 2),
