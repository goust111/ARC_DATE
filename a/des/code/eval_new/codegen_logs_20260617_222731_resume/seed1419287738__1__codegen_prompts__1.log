+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _flood_compartment(g: np.ndarray, bbox: tuple[int, int, int, int], start: tuple[int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    sr, sc = start
+    assert r0 < sr < r1 and c0 < sc < c1, "door must look into frame interior"
+    assert int(g[sr, sc]) != GREY, "door-adjacent interior cell cannot be a wall"
+    q = deque([(sr, sc)])
+    seen = {start}
+    pts = [start]
+    while q:
+        cr, cc = q.popleft()
+        for dr, dc in DIRS4:
+            nr, nc = cr + dr, cc + dc
+            if not (r0 < nr < r1 and c0 < nc < c1):
+                continue
+            if int(g[nr, nc]) == GREY or (nr, nc) in seen:
+                continue
+            seen.add((nr, nc))
+            pts.append((nr, nc))
+            q.append((nr, nc))
+    return pts
