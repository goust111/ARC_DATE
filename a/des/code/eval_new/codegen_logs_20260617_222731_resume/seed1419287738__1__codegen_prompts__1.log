+def _frame_geometry(scheme: str) -> tuple[int, int, list[tuple[int, int, int, int]], list[tuple[int, int, int, int]]]:
+    if scheme == "v":
+        h, w = random.choice([7, 8, 9]), 9
+        wall_col = w // 2
+        walls = [(1, wall_col, h - 2, wall_col)]
+        comps = [(1, 1, h - 2, wall_col - 1), (1, wall_col + 1, h - 2, w - 2)]
