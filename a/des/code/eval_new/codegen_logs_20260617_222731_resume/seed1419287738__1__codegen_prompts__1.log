+def _door_info(r: int, c: int, bbox: tuple[int, int, int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    if r == r0:
+        return (-1, 0), (r + 1, c)
+    if r == r1:
+        return (1, 0), (r - 1, c)
+    if c == c0:
+        return (0, -1), (r, c + 1)
+    if c == c1:
+        return (0, 1), (r, c - 1)
