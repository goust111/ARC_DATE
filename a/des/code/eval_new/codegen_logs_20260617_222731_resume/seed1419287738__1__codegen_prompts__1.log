+    abs_compartments = []
+    for wr0, wc0, wr1, wc1 in walls:
+        sub[fr0 + wr0 : fr0 + wr1 + 1, fc0 + wc0 : fc0 + wc1 + 1] = GREY
+    for cr0, cc0, cr1, cc1 in compartments:
