+BG = 0
+GREY = 5
+FILL_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GEN_ATTEMPTS = 400
+COLOR_ATTEMPTS = 600
+LATTICE_H_RANGE = (4, 6)
+LATTICE_W_RANGE = (4, 6)
+CELL_SIZE_CHOICES = (2, 3)
+MARGIN_CHOICES = (1, 2)
