+    cols = coords[:, 1]
+    r0, r1 = int(rows.min()), int(rows.max())
+    c0, c1 = int(cols.min()), int(cols.max())
+    area = int(coords.shape[0])
+    return area == (r1 - r0 + 1) * (c1 - c0 + 1)
