+def _infer_marker_color(grid: np.ndarray, bg: int) -> int:
+    h, w = grid.shape
+    candidates: List[int] = []
+    for color in map(int, np.unique(grid)):
+        if color == bg:
+            continue
+        coords = np.argwhere(grid == color)
+        if coords.shape[0] < 2:
+            continue
+        ok = True
+        for r, c in coords:
+            rr, cc = int(r), int(c)
+            if rr + 1 >= h:
+                ok = False
+                break
+            below = int(grid[rr + 1, cc])
+            if below in (bg, color):
+                ok = False
