+
+
+def _branch_caps(root_cols: Sequence[int], index: int) -> Tuple[int, int]:
+    left_cap = MAX_BRANCH_LEN
+    right_cap = MAX_BRANCH_LEN
+    if index > 0:
+        left_cap = min(left_cap, max(0, (root_cols[index] - root_cols[index - 1] - 2) // 2))
