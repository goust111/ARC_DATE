+def _frame_info(coords: list[tuple[int, int]]) -> tuple[tuple[int, int, int, int], tuple[int, int]] | None:
+    pts = np.asarray(coords, dtype=int)
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
