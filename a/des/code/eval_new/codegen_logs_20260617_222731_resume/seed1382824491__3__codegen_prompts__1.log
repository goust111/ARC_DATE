+
+def _seed_coords_in_frame(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    interior = grid[r0 + 1 : r1, c0 + 1 : c1]
