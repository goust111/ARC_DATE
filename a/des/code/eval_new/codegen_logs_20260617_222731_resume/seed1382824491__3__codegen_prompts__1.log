+        border_set.add((r, c0))
+        border_set.add((r, c1))
+    for c in range(c0, c1 + 1):
+        border_set.add((r0, c))
+        border_set.add((r1, c))
+
+    if not coord_set <= border_set:
+        return None
+    missing = list(border_set - coord_set)
+    if len(missing) != 1:
+        return None
+    gap = missing[0]
