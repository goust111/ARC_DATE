+
+    expected = _build_output(rects)
+    if expected.shape[0] > MAX_GRID or expected.shape[1] > MAX_GRID:
+        return None
+
+    inp = _build_input(rects)
+    if inp is None:
+        return None
+    if not np.array_equal(main(inp), expected):
