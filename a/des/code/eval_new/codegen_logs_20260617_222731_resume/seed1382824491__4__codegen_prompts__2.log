+    for color, comps in by_color.items():
+        if len(comps) < 2:
+            continue
+        if not all(_solid_rectangle_component(comp) for comp in comps):
+            continue
+        merged = np.concatenate(comps, axis=0)
+        r0, c0, r1, c1 = _bbox(merged)
