+    out_w = int(max(width for _area, _height, width, _color in rects))
+    out = np.full((out_h, out_w), BG, dtype=int)
+
+    r0 = 0
+    for _area, height, width, color in rects:
+        out[r0 : r0 + height, :width] = int(color)
+        r0 += int(height)
