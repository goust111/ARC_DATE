    colors = rng.choice(COLOR_POOL, size=N_COLORS, replace=False).tolist()
    counts = _sample_ranked_counts(rng)
    if counts is None:
        return None

    pixels = np.repeat(colors, counts)
    rng.shuffle(pixels)
    return pixels.astype(int, copy=False).reshape(GRID_SHAPE)


