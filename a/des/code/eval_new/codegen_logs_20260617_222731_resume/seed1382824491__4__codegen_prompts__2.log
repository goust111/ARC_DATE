+        height, width = _reconstruct_pair(sprite_a, sprite_b)
+        rects.append((height * width, height, width, color))
+
+    if not rects:
+        raise ValueError("no reconstructable pairs found")
+
+    rects.sort(key=lambda item: (-item[0], -item[1], -item[2], item[3]))
