+
+
+def _make_staircase(length: int, low: int, high: int) -> list[int]:
+    cur = int(_RNG.integers(low, high + 1))
+    sign = int(_RNG.choice([-1, 1]))
+    boundary: list[int] = []
+    while len(boundary) < length:
