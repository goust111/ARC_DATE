+
+def _paint(grid: np.ndarray, sprite: np.ndarray, r0: int, c0: int) -> None:
+    mask = sprite != BG
+    sub = grid[r0 : r0 + sprite.shape[0], c0 : c0 + sprite.shape[1]]
+    sub[mask] = sprite[mask]
