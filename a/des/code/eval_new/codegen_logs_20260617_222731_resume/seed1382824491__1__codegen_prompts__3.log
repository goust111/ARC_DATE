+
+def _arrow_rows_right(g: np.ndarray) -> list[int]:
+    h, w = g.shape
+    if h < 3 or w < 2:
+        return []
+    return [
+        r
+        for r in range(1, h - 1)
+        if int(g[r, w - 1]) == GREY and int(g[r - 1, w - 2]) == GREY and int(g[r + 1, w - 2]) == GREY
