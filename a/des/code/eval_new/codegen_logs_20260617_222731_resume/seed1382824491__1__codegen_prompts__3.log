+            rect_w = random.randint(*EXTRA_RECT_WIDTH_RANGE)
+            r0 = random.randint(2, h - rect_h - 2)
+            c0 = random.randint(2, w - rect_w - 2)
+            r1 = r0 + rect_h - 1
+            c1 = c0 + rect_w - 1
