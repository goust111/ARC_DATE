+def _arrow_rows_left(g: np.ndarray) -> list[int]:
+    h, w = g.shape
+    if h < 3 or w < 2:
+        return []
+    return [
+        r
+        for r in range(1, h - 1)
+        if int(g[r, 0]) == GREY and int(g[r - 1, 1]) == GREY and int(g[r + 1, 1]) == GREY
