+
+def _gen_attempt() -> np.ndarray | None:
+    direction = random.choice(("left", "right", "top", "bottom"))
+    base_h = random.randint(*GRID_HEIGHT_RANGE)
+    base_w = random.randint(*GRID_WIDTH_RANGE)
