    cells=set(cells)
    pts=set()
    for r,c in cells:
        pts.add((2*r+1,2*c+1))
        if (r+1,c) in cells:
            pts.add((2*r+2,2*c+1))
        if (r,c+1) in cells:
            pts.add((2*r+1,2*c+2))
    return pts

