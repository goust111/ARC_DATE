+    for r in range(rows):
+        for c in range(cols):
+            cell = (int(r), int(c))
+            if cell in seen:
+                continue
+            ref = _reflect_cell(cell, int(rows), int(cols))
+            seen.add(cell)
+            seen.add(ref)
+            orbits.append((cell, ref))
