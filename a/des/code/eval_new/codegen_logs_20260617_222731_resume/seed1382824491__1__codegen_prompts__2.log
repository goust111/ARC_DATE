+
+BLACK = 0
+GREY = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+FRAME_CHOICES = ((4, 4), (4, 6), (6, 4), (6, 6))
+MAX_GEN_ATTEMPTS = 300
