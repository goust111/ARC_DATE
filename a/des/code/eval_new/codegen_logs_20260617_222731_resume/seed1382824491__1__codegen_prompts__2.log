import random
from collections import deque
import numpy as np

BLACK=0
GREY=5
NEI=((1,0),(-1,0),(0,1),(0,-1))


def label(mask):
    h,w=mask.shape
    lab=np.zeros((h,w),dtype=int)
    cid=0
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or lab[r,c]:
                continue
            cid+=1
            dq=deque([(r,c)])
            lab[r,c]=cid
            while dq:
                x,y=dq.popleft()
                for dx,dy in NEI:
                    nx,ny=x+dx,y+dy
                    if 0<=nx<h and 0<=ny<w and mask[nx,ny] and not lab[nx,ny]:
                        lab[nx,ny]=cid
                        dq.append((nx,ny))
    return lab,cid


def refl(cell,rows,cols):
    r,c=cell
    return rows-1-r, cols-1-c

def boundary_seed_orbits(rows,cols):
    out=[]; seen=set()
    for r in range(rows):
        for c in range(cols):
            on_tb = r in (0, rows-1)
            on_lr = c in (0, cols-1)
            if on_tb + on_lr "'!= 1:
                continue
            cell=(r,c); ref=refl(cell,rows,cols)
            if cell in seen or ref in seen or cell==ref:
                continue
            seen.add(cell); seen.add(ref)
            out.append((cell,ref))
    return out

def all_orbits(rows,cols):
    out=[]; seen=set()
    for r in range(rows):
        for c in range(cols):
            cell=(r,c); ref=refl(cell,rows,cols)
            if cell in seen:
                continue
            seen.add(cell); seen.add(ref)
            out.append((cell,ref))
    return out

def touches(cell, region):
    r,c=cell
    for dr,dc in NEI:
        if (r+dr,c+dc) in region:
            return True
    return False

def choose_seeds(rows,cols,pair_count,rng):
    orbits=boundary_seed_orbits(rows,cols)
    for _ in range(200):
        chosen=rng.sample(orbits,pair_count)
        seeds=[x for orb in chosen for x in orb]
        ok=True
        for i,a in enumerate(seeds):
            for b in seeds[i+1:]:
                if abs(a[0]-b[0])+abs(a[1]-b[1]) < 2:
                    ok=False
        if ok:
            return chosen
    return rng.sample(orbits,pair_count)

def grow(rows,cols,pair_count,rng):
    seeds=choose_seeds(rows,cols,pair_count,rng)
    A=[{orb[0]} for orb in seeds]
    B=[{orb[1]} for orb in seeds]
    seed_cells={cell for orb in seeds for cell in orb}
    unassigned=[orb for orb in all_orbits(rows,cols) if orb[0] not in seed_cells and orb[1] not in seed_cells]

    def assign(orbit,i,side):
        u,v=orbit
        if side==0:
            A[i].add(u); B[i].add(v)
        else:
            B[i].add(u); A[i].add(v)
        unassigned.remove(orbit)

    order=list(range(pair_count))
    rng.shuffle(order)
    for i in order:
        choices=[]
        for orb in list(unassigned):
            u,_=orb
            if touches(u,A[i]):
                choices.append((orb,0))
            if touches(u,B[i]):
                choices.append((orb,1))
        if not choices:
            return None
        orb,side=rng.choice(choices)
        assign(orb,i,side)

    while unassigned:
        frontier=[]
        for orb in list(unassigned):
            u,_=orb
            sides=[]
            for i in range(pair_count):
                if touches(u,A[i]):
                    sides.append((i,0))
                if touches(u,B[i]):
                    sides.append((i,1))
            if sides:
                frontier.append((orb,sides))
        if not frontier:
            return None
        orb,sides=rng.choice(frontier)
        weights=[]
        for i,_ in sides:
            weights.append(1/max(1,len(A[i])))
        total=sum(weights)
        x=rng.random()*total
        acc=0.0
        idx=0
        for j,w in enumerate(weights):
            acc+=w
            if x<=acc:
                idx=j; break
        i,side=sides[idx]
        assign(orb,i,side)

    return [A[i] for i in range(pair_count)] + [B[i] for i in range(pair_count)], [orb[0] for orb in seeds] + [orb[1] for orb in seeds]


