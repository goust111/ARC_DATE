+        v_box = _expand_box(_affected_box(v_spec), h, w)
+        h_box = _expand_box(_affected_box(h_spec), h, w)
+        if any(_boxes_overlap(v_box, other) or _boxes_overlap(h_box, other) for other in blocked_boxes):
