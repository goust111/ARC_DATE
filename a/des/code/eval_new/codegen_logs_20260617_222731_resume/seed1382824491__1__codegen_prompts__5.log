+            r0, r1 = mirror["start"], mirror["end"]
+            left_count = int(np.count_nonzero(valid_source[r0 : r1 + 1, :col]))
+            right_count = int(np.count_nonzero(valid_source[r0 : r1 + 1, col + 1 :]))
