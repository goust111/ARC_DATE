+
+        v_pixels = _sample_source_pixels(v_spec, mapped_colors, unmapped_color)
+        h_pixels = _sample_source_pixels(h_spec, mapped_colors, unmapped_color)
+        if v_pixels is None or h_pixels is None:
+            continue
