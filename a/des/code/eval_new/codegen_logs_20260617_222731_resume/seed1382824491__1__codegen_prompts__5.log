+                continue
+            use_left = right_count == 0 or left_count >= right_count
+
+            if use_left:
+                src_pts = np.argwhere(valid_source[r0 : r1 + 1, :col])
+                for rr_rel, cc in src_pts:
+                    rr = int(rr_rel + r0)
+                    src_c = int(cc)
