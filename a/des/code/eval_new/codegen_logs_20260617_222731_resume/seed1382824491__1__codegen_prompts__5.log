+def _monochrome_components(g: np.ndarray, blocked: np.ndarray) -> list[dict[str, object]]:
+    h, w = g.shape
+    visited = np.zeros((h, w), dtype=bool)
+    comps: list[dict[str, object]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if visited[r, c] or blocked[r, c] or int(g[r, c]) == BG:
+                continue
+
+            color = int(g[r, c])
+            stack = [(r, c)]
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc]:
+                        if not blocked[nr, nc] and int(g[nr, nc]) == color:
+                            visited[nr, nc] = True
+                            stack.append((nr, nc))
+
+            rows = [rr for rr, _cc in coords]
+            cols = [cc for _rr, cc in coords]
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "r0": min(rows),
+                    "r1": max(rows),
+                    "c0": min(cols),
+                    "c1": max(cols),
+                }
+            )
+    return comps
+
