+def _source_rect(spec: dict[str, object]) -> tuple[int, int, int, int]:
+    if spec["orient"] == "v":
+        row0, row1 = int(spec["start"]), int(spec["end"])
+        col = int(spec["fixed"])
+        depth = int(spec["depth"])
+        if spec["side"] == "left":
+            return row0, col - depth, row1, col - 1
+        return row0, col + 1, row1, col + depth
