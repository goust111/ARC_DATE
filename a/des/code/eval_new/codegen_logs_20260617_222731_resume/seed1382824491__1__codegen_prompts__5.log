+def _overlap_specs(
+    h: int,
+    w: int,
+    mirror_colors: list[int],
+    mapped_colors: list[int],
+    unmapped_color: int,
+    blocked_boxes: list[tuple[int, int, int, int]],
+) -> list[dict[str, object]] | None:
+    for _ in range(PLACEMENT_ATTEMPTS):
