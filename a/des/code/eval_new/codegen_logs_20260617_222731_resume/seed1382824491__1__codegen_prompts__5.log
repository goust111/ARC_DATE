+    for i, (src, dst) in enumerate(pairs):
+        rr = 2 * i if corner in {"tl", "tr"} else h - 1 - 2 * i
+        grid[rr, c0] = int(src)
+        grid[rr, c1] = int(dst)
+        mask[rr, c0] = True
+        mask[rr, c1] = True
