+            second_in = _absolute_cells(second_spec, (0, 1 + slide), include_marker=True)
+            first_out = _absolute_cells(first_spec, (0, -1), include_marker=False)
+            second_out = _absolute_cells(second_spec, (0, 1), include_marker=False)
+        else:
