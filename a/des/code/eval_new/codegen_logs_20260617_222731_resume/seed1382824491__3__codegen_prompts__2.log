+    else:
+        cols_ud = []
+
+    if not axes:
+        return None
+
+    return {
+        "mask": mask,
+        "cells": [tuple(map(int, rc)) for rc in np.argwhere(mask)],
+        "key": _mask_key(mask),
+        "axes": tuple(axes),
+        "h_attach_rows": rows_lr,
+        "v_attach_cols": cols_ud,
+    }
+
+
+RAW_TEMPLATES = (
+    ("11",),
+    ("111",),
+    ("1", "1"),
+    ("1", "1", "1"),
+    ("11", "11"),
+    ("111", "010"),
+    ("010", "111"),
+    ("010", "111", "010"),
+    ("101", "111"),
+    ("111", "101"),
+    ("10", "11", "10"),
+    ("01", "11", "01"),
+    ("11", "01", "11"),
+    ("11", "10", "11"),
+    ("010", "110", "010"),
+    ("010", "011", "010"),
+)
+
+TEMPLATES = [tpl for tpl in (_build_template(rows) for rows in RAW_TEMPLATES) if tpl is not None]
+
