+            second_in = _absolute_cells(second_spec, (1 + slide, 0), include_marker=True)
+            first_out = _absolute_cells(first_spec, (-1, 0), include_marker=False)
+            second_out = _absolute_cells(second_spec, (1, 0), include_marker=False)
