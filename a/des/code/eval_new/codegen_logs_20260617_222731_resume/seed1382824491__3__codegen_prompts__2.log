+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+AZURE = 8
+RED = 2
+MAROON = 9
+YELLOW = 4
+SPECIAL_COLORS = {AZURE, RED, MAROON, YELLOW}
+FRAGMENT_COLORS = (0, 1, 3, 5, 6, 7)
+
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_ATTEMPTS = 500
+PAIR_ATTEMPTS = 200
