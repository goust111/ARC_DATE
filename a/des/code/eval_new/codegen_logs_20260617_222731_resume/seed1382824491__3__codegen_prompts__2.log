+
+def _mask_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    start = tuple(map(int, coords[0]))
+    queue = deque([start])
+    seen[start] = True
+    count = 0
+    while queue:
+        r, c = queue.popleft()
+        count += 1
