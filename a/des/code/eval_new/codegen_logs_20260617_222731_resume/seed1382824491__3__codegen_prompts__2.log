+    rightish: dict,
+) -> None:
+    ra, ca = map(int, leftish["marker"])
+    rb, cb = map(int, rightish["marker"])
+
+    if ra == rb:
+        assert ca != cb
+        if ca > cb:
+            leftish, rightish = rightish, leftish
+            ra, ca = map(int, leftish["marker"])
+            rb, cb = map(int, rightish["marker"])
+        gap = int(cb - ca)
+        assert gap >= 2 and gap % 2 == 0
+        center = (int(ra), int((ca + cb) // 2))
+        shift = int((gap - 2) // 2)
+        delta_a = (0, shift)
+        delta_b = (0, -shift)
+    else:
+        assert ca == cb
+        if ra > rb:
+            leftish, rightish = rightish, leftish
+            ra, ca = map(int, leftish["marker"])
+            rb, cb = map(int, rightish["marker"])
+        gap = int(rb - ra)
+        assert gap >= 2 and gap % 2 == 0
+        center = (int((ra + rb) // 2), int(ca))
+        shift = int((gap - 2) // 2)
+        delta_a = (shift, 0)
+        delta_b = (-shift, 0)
