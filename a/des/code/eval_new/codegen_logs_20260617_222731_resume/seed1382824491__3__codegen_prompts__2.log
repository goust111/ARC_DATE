+    second = {"cells": [(r + 1, c) for r, c in cells], "marker": (0, attach_col)}
+    return first, second
+
+
+def _absolute_cells(spec: dict, marker_pos: tuple[int, int], include_marker: bool) -> list[tuple[int, int]]:
+    mr, mc = map(int, spec["marker"])
+    gr, gc = map(int, marker_pos)
