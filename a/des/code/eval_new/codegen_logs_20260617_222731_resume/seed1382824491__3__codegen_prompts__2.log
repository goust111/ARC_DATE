+    start = tuple(map(int, coords[0]))
+    queue = deque([start])
+    seen[start] = True
+    count = 0
+    while queue:
+        r, c = queue.popleft()
+        count += 1
+        for dr, dc in NEIGHBORS4:
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                queue.append((rr, cc))
+    return count == int(mask.sum())
+
+
+def _build_template(rows: tuple[str, ...]) -> dict | None:
+    mask = _mask_from_rows(rows)
+    area = int(mask.sum())
+    if not (2 <= area <= 5) or not _mask_connected(mask):
+        return None
+
+    axes: list[str] = []
+    if np.array_equal(mask, np.fliplr(mask)):
+        rows_lr = [r for r in range(mask.shape[0]) if mask[r, 0] and mask[r, -1]]
+        if rows_lr:
+            axes.append("h")
+    else:
+        rows_lr = []
+
+    if np.array_equal(mask, np.flipud(mask)):
+        cols_ud = [c for c in range(mask.shape[1]) if mask[0, c] and mask[-1, c]]
+        if cols_ud:
+            axes.append("v")
+    else:
+        cols_ud = []
+
+    if not axes:
+        return None
+
+    return {
+        "mask": mask,
+        "cells": [tuple(map(int, rc)) for rc in np.argwhere(mask)],
+        "key": _mask_key(mask),
+        "axes": tuple(axes),
+        "h_attach_rows": rows_lr,
+        "v_attach_cols": cols_ud,
+    }
+
+
+RAW_TEMPLATES = (
+    ("11",),
+    ("111",),
+    ("1", "1"),
+    ("1", "1", "1"),
+    ("11", "11"),
+    ("111", "010"),
+    ("010", "111"),
+    ("010", "111", "010"),
+    ("101", "111"),
+    ("111", "101"),
+    ("10", "11", "10"),
+    ("01", "11", "01"),
+    ("11", "01", "11"),
+    ("11", "10", "11"),
+    ("010", "110", "010"),
+    ("010", "011", "010"),
+)
+
+TEMPLATES = [tpl for tpl in (_build_template(rows) for rows in RAW_TEMPLATES) if tpl is not None]
+
+
+def _build_fragment_specs(template: dict, axis: str) -> tuple[dict, dict]:
+    mask = template["mask"]
+    cells = template["cells"]
+    h, w = mask.shape
+
+    if axis == "h":
+        attach_row = random.choice(template["h_attach_rows"])
+        first = {"cells": cells, "marker": (attach_row, w)}
+        second = {"cells": [(r, c + 1) for r, c in cells], "marker": (attach_row, 0)}
+        return first, second
