+        min_r2, max_r2, min_c2, max_c2 = _coords_bounds(output_rel)
+        min_r = min(min_r1, min_r2)
+        max_r = max(max_r1, max_r2)
+        min_c = min(min_c1, min_c2)
+        max_c = max(max_c1, max_c2)
+
+        row_lo = -min_r
+        row_hi = h - 1 - max_r
+        col_lo = -min_c
+        col_hi = w - 1 - max_c
+        if row_lo > row_hi or col_lo > col_hi:
