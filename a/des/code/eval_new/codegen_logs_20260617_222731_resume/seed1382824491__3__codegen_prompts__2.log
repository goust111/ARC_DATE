+
+def _background_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r0 in range(h):
+        for c0 in range(w):
+            if seen[r0, c0] or int(g[r0, c0]) == int(bg):
+                continue
+            queue = deque([(r0, c0)])
+            seen[r0, c0] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                r, c = queue.popleft()
+                coords.append((r, c))
+                for dr, dc in NEIGHBORS4:
+                    rr, cc = r + dr, c + dc
+                    if 0 <= rr < h and 0 <= cc < w and not seen[rr, cc] and int(g[rr, cc]) != int(bg):
+                        seen[rr, cc] = True
+                        queue.append((rr, cc))
+            arr = np.array(coords, dtype=int)
+            r_min = int(arr[:, 0].min())
+            r_max = int(arr[:, 0].max())
+            c_min = int(arr[:, 1].min())
+            c_max = int(arr[:, 1].max())
+            comps.append(
+                {
+                    "coords": arr,
+                    "bbox": (r_min, c_min, r_max, c_max),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def _tight_mask(coords: list[tuple[int, int]] | np.ndarray) -> np.ndarray:
+    arr = np.array(coords, dtype=int)
+    r_min = int(arr[:, 0].min())
+    r_max = int(arr[:, 0].max())
+    c_min = int(arr[:, 1].min())
+    c_max = int(arr[:, 1].max())
+    mask = np.zeros((r_max - r_min + 1, c_max - c_min + 1), dtype=bool)
+    mask[arr[:, 0] - r_min, arr[:, 1] - c_min] = True
+    return mask
