+            c_min = int(arr[:, 1].min())
+            c_max = int(arr[:, 1].max())
+            comps.append(
+                {
+                    "coords": arr,
+                    "bbox": (r_min, c_min, r_max, c_max),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
