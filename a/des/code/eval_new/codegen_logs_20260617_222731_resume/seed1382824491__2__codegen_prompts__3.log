+        assert seg_a["orientation"] != seg_b["orientation"], "corner must join perpendicular segments"
+        out[r, c] = _corner_fill_color(seg_a, seg_b)
+        endpoint_use_count[pt_a] += 1
+        endpoint_use_count[pt_b] += 1
