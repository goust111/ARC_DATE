+
+    colors = random.sample(range(1, 10), total_segments)
+    grid_h = max(offset[0] + shape[0] for offset, shape in zip(offsets, shapes)) + 1
+    grid_w = max(offset[1] + shape[1] for offset, shape in zip(offsets, shapes)) + 1
