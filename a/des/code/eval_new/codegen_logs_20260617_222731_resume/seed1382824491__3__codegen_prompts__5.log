+def _sample_marker_indices(length: int, count: int, shift: int) -> list[int] | None:
+    for _ in range(200):
+        picks = sorted(int(x) for x in _RNG.choice(length, size=count, replace=False))
+        moved = sorted((idx + shift) % length for idx in picks)
+        if picks != moved:
+            return picks
+    return None
+
