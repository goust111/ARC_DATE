+def _candidate_left_cols(width: int, fold_col: int) -> list[int]:
+    cols = []
+    for c_left in range(1, fold_col + 1):
+        c_right = 2 * fold_col + 1 - c_left
+        if 1 <= c_right <= width - 2:
+            cols.append(c_left)
+    return cols
