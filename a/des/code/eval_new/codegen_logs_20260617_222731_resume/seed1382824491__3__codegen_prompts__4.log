+    h = len(stacks)
+    w = len(stacks[0])
+    assert 0 <= fold_row < h - 1
+
+    min_row = min(0, 2 * fold_row + 2 - h)
+    out_h = fold_row - min_row + 1
+    out = [[[] for _ in range(w)] for _ in range(out_h)]
