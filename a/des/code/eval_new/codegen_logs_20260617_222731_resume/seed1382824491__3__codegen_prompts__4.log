+    frame_color = random.choice(CANVAS_COLORS)
+    interior_colors = [color for color in CANVAS_COLORS if color != frame_color]
+
+    canvas[0, :] = frame_color
+    canvas[-1, :] = frame_color
+    canvas[:, 0] = frame_color
+    canvas[:, -1] = frame_color
+    occupied = canvas != BG
+
+    random.shuffle(interior_colors)
+    if branch == "both":
