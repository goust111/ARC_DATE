+def _candidate_top_rows(height: int, fold_row: int) -> list[int]:
+    rows = []
+    for r_top in range(1, fold_row + 1):
+        r_bottom = 2 * fold_row + 1 - r_top
+        if 1 <= r_bottom <= height - 2:
+            rows.append(r_top)
+    return rows
