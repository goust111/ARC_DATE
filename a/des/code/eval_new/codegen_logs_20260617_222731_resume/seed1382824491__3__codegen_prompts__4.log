+        for r, c in cells:
+            canvas[r, c] = color
+            occupied[r, c] = True
+        return True
+    return False
+
+
+def _build_canvas(
+    height: int, width: int, fold_col: int | None, fold_row: int | None, branch: str
+) -> np.ndarray | None:
