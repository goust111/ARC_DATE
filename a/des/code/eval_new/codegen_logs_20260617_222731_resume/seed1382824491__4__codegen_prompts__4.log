+def _segment_orientation(mask: np.ndarray, r: int, c: int) -> str | None:
+    h, w = mask.shape
+    left = c > 0 and mask[r, c - 1]
+    right = c + 1 < w and mask[r, c + 1]
+    up = r > 0 and mask[r - 1, c]
+    down = r + 1 < h and mask[r + 1, c]
+    horiz = left or right
+    vert = up or down
