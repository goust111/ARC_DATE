+                r1 += 1
+            segment = []
+            for rr in range(r0, r1 + 1):
+                assert _segment_orientation(path_mask, rr, c) in {"v", "s"}
+                visited[rr, c] = True
+                segment.append((rr, c))
+            segments.append(segment)
