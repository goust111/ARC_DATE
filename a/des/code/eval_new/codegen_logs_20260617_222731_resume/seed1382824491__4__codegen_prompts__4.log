+
+    path_mask = _build_path_mask(grid.shape, max_len, path_left)
+    if path_mask is None:
+        return None
+    grid[path_mask] = path_color
+
+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+
+    if out.shape != grid.shape:
+        return None
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
