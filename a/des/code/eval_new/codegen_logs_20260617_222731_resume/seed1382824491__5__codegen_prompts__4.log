+def _propagate(adjacency: list[set[int]], seeds: dict[int, int]) -> list[int | None]:
+    labels: list[int | None] = [None] * len(adjacency)
+    frontier: list[int] = []
+    for room_id, color in seeds.items():
+        labels[room_id] = int(color)
