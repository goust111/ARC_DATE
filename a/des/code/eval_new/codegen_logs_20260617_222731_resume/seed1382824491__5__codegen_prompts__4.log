+    max_seed_count = min(4, room_count - 1)
+    if max_seed_count < 1:
+        return None
+    if mode == "conflict":
+        seed_count = random.randint(2, max_seed_count)
+    elif mode == "no_conflict" and random.random() < 0.45:
+        seed_count = 1
+    else:
+        seed_count = random.randint(1, min(3, max_seed_count))
