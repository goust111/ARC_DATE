+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+LINE = 5
+CONFLICT = 9
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8)
+GEN_ATTEMPTS = 400
