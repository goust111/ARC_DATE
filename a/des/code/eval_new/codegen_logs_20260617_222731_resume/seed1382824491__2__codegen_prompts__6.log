+    shapes: list[dict[str, object]],
+    separator_col: int,
+    bg: int,
+) -> np.ndarray:
+    height, width = grid.shape
+    canvas_left = int(separator_col + 1)
+    canvas_right = int(width - 1)
+    canvas_row_sum = int(height - 1)
+    canvas_col_sum = int(canvas_left + canvas_right)
