+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors(r: int, c: int, height: int, width: int, connectivity: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+        rr = int(r + dr)
+        cc = int(c + dc)
+        if 0 <= rr < height and 0 <= cc < width:
+            out.append((rr, cc))
+    if connectivity == 8:
+        for dr, dc in ((1, 1), (1, -1), (-1, 1), (-1, -1)):
+            rr = int(r + dr)
+            cc = int(c + dc)
+            if 0 <= rr < height and 0 <= cc < width:
+                out.append((rr, cc))
+    return out
+
+
+def _find_monochrome_components(
+    grid: np.ndarray,
+    mask: np.ndarray,
+    connectivity: int,
+) -> list[dict[str, object]]:
+    height, width = grid.shape
+    visited = np.zeros((height, width), dtype=bool)
+    comps: list[dict[str, object]] = []
+
+    for r in range(height):
+        for c in range(width):
+            if visited[r, c] or not bool(mask[r, c]):
+                continue
+
+            color = int(grid[r, c])
+            stack = [(int(r), int(c))]
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
+
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((int(cr), int(cc)))
+                for nr, nc in _neighbors(cr, cc, height, width, connectivity):
+                    if visited[nr, nc] or not bool(mask[nr, nc]):
+                        continue
+                    if int(grid[nr, nc]) != color:
+                        continue
+                    visited[nr, nc] = True
+                    stack.append((int(nr), int(nc)))
