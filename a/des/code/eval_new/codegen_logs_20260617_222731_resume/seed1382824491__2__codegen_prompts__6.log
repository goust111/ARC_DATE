+    r0, c0, r1, c1 = bbox
+    return int(r0 + r1), int(c0 + c1)
+
+
+def _arrow_tip_col(comp: dict[str, object]) -> int:
+    coords = np.asarray(comp["coords"], dtype=int)
+    counts: dict[int, int] = {}
+    for _r, c in coords:
