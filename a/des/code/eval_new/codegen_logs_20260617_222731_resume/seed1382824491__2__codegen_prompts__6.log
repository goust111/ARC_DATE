+def _find_separator(grid: np.ndarray, bg: int) -> tuple[int, int]:
+    height, width = grid.shape
+    candidates: list[tuple[int, int]] = []
+    for c in range(1, width - 1):
+        value = int(grid[0, c])
+        if value == bg:
+            continue
+        if not np.all(grid[:, c] == value):
+            continue
+        if not np.all(grid[:, c + 1 :] == bg):
