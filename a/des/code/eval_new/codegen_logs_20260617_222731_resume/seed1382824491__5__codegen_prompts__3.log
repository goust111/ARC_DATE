+        r0, c0, _, _ = fence["bbox"]
+        top = int(r0 + 1 + (fence["cavity_h"] - sh) // 2)
+        left = int(c0 + 1 + (fence["cavity_w"] - sw) // 2)
+        out[top : top + sh, left : left + sw][rotated] = int(fence["color"])
