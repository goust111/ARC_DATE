+        rotated = np.rot90(seed["mask"], k=int(fence["rotation_k"]))
+        sh, sw = map(int, rotated.shape)
+        assert sh <= fence["cavity_h"] and sw <= fence["cavity_w"], "rotated seed must fit inside the fence cavity"
