+
+
+_RNG = np.random.default_rng()
+_GRID_MIN = 20
+_GRID_MAX = 30
+_PAIR_OPTIONS = (2, 3, 4)
+_COLOR_POOL = tuple(range(1, 10))
+_CAVITY_OPTIONS = {
+    16: ((4, 4),),
+    20: ((4, 5), (5, 4)),
+    24: ((4, 6), (6, 4)),
+    25: ((5, 5),),
