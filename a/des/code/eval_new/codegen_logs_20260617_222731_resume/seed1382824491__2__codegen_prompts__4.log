+    ("split", "intersect"): {"split_events": 1, "yellow_count": 1},
+    ("nonsplit", "block"): {"prism_stops_no_split": 1, "tower_stops": 1},
+    ("chain", "absorb"): {"max_depth": 2, "absorber_stops": 1},
+    ("split", "nonsplit", "intersect"): {
+        "split_events": 1,
+        "prism_stops_no_split": 1,
+        "yellow_count": 1,
