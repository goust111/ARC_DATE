+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    mask = np.asarray(grid == color, dtype=bool)
+    height, width = map(int, mask.shape)
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+
+    for r in range(height):
+        for c in range(width):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while queue:
+                cr, cc = queue.popleft()
+                cells.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < height and 0 <= nc < width and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append(np.asarray(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _is_frame_component(coords: np.ndarray) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    if height < 3 or width < 3:
+        return False
+    if int(coords.shape[0]) != 2 * (height + width) - 4:
+        return False
+    cells = {(int(r), int(c)) for r, c in coords}
+    for c in range(c0, c1 + 1):
+        if (r0, c) not in cells or (r1, c) not in cells:
+            return False
+    for r in range(r0, r1 + 1):
+        if (r, c0) not in cells or (r, c1) not in cells:
+            return False
+    return True
