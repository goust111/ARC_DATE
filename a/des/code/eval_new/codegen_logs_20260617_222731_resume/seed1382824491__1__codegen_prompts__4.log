+    height, width = map(int, allowed.shape)
+    cells = []
+    for dr, dc in shape:
+        rr = r0 + dr
+        cc = c0 + dc
+        if not (0 <= rr < height and 0 <= cc < width):
+            return False
+        if not allowed[rr, cc]:
+            return False
+        cells.append((rr, cc))
+    for rr, cc in cells:
+        for nr in range(rr - 1, rr + 2):
+            for nc in range(cc - 1, cc + 2):
+                if 0 <= nr < height and 0 <= nc < width and occupied[nr, nc]:
