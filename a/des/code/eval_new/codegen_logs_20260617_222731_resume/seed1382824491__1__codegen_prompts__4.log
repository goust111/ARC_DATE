+    max_top = min(OUTER_PADDING_RANGE[1], 30 - outer_h)
+    max_left = min(OUTER_PADDING_RANGE[1], 30 - outer_w)
+    if max_top < OUTER_PADDING_RANGE[0] or max_left < OUTER_PADDING_RANGE[0]:
