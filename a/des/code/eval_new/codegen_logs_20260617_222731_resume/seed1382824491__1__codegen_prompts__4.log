+    row = 0
+    for idx, layer in enumerate(layers):
+        height, width = map(int, layer.shape)
+        out[row : row + height, :width] = layer
+        row += height
+        if idx + 1 < len(layers):
+            out[row, :] = int(frame_colors[idx])
+            row += 1
+    return out
