+    open_edges = [key for key, open_ in edge_status.items() if open_]
+    open_lock_assignment: dict[tuple[int, int], int] = {}
+    seed_colors = chosen_keys[:]
+    rng.shuffle(seed_colors)
+    for i, key in enumerate(open_edges):
