+
+    path_edge_keys = {_edge_key(room_path[i], room_path[i + 1]) for i in range(len(room_path) - 1)}
+    off_path_rooms = [room_id for room_id in range(num_rooms) if room_id not in set(room_path)]
+    if not off_path_rooms:
