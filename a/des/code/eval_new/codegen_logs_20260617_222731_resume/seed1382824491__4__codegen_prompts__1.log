+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+_DIR_TO_ROT = {"up": 0, "right": 3, "down": 2, "left": 1}
+_DIRECTIONS = ("up", "right", "down", "left")
+
+# Default-up legend templates. Each one is connected, asymmetric, and spans
+# the full 3x3 tile so the cropped patch preserves the intended rotation cue.
+_PATTERN_LIBRARY = (
+    np.array([[0, 1, 0], [1, 1, 1], [1, 1, 1]], dtype=bool),
+    np.array([[0, 1, 0], [1, 1, 1], [1, 0, 1]], dtype=bool),
+    np.array([[0, 1, 0], [1, 1, 1], [1, 1, 0]], dtype=bool),
+)
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < h:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < w:
+        out.append((r, c + 1))
+    return out
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = map(int, grid.shape)
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            seen[r, c] = True
+            stack = [(r, c)]
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            r0, c0 = arr.min(axis=0)
+            r1, c1 = arr.max(axis=0)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def _frame_info(grid: np.ndarray, comp: dict) -> dict | None:
+    color = int(comp["color"])
+    r0, c0, r1, c1 = map(int, comp["bbox"])
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1] == color
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+
+    if int(sub.sum()) != int(border.sum()) - 1:
+        return None
+    if bool(np.any(sub & ~border)):
+        return None
+
+    missing = np.argwhere(border & ~sub)
+    if int(missing.shape[0]) != 1:
+        return None
+    mr, mc = map(int, missing[0])
+    if (mr in (0, h - 1)) and (mc in (0, w - 1)):
+        return None
+
+    if mr == 0:
+        direction = "up"
+    elif mr == h - 1:
+        direction = "down"
+    elif mc == 0:
+        direction = "left"
+    else:
+        direction = "right"
+
+    return {
+        "color": color,
+        "bbox": (r0, c0, r1, c1),
+        "direction": direction,
+        "area": int(comp["area"]),
