+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
