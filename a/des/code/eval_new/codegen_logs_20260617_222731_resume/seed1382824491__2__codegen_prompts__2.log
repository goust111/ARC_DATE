+        return [(0, left + w // 2 - 1), (0, left + w // 2)]
+    if edge == "bottom":
+        return [(top + h - 1, left + w // 2 - 1), (top + h - 1, left + w // 2)]
+    if edge == "left":
+        return [(top + h // 2 - 1, 0), (top + h // 2, 0)]
+    if edge == "right":
+        return [(top + h // 2 - 1, left + w - 1), (top + h // 2, left + w - 1)]
+    raise ValueError(edge)
