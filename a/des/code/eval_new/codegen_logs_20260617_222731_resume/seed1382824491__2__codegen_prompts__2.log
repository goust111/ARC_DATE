+def _unique_fragment_pairing(fragments: list[dict[str, object]]) -> list[tuple[int, int]]:
+    n = len(fragments)
+    assert n % 2 == 0 and n > 0
+    compat = [[False] * n for _ in range(n)]
+    for i in range(n):
