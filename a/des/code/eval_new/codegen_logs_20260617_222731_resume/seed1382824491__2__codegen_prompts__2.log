+import numpy as np
+
+
+BG = 0
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+EDGES = ("top", "bottom", "left", "right")
+ARC_MAX = 30
+GEN_ATTEMPTS = 400
