import numpy as np


def cycle(h,w):
    if h % 2 == 0:
        path=[(0,0)]
        for c in range(1,w):
            path.append((0,c))
        for r in range(1,h):
            if r % 2 == 1:
                for c in range(w-1,0,-1):
                    path.append((r,c))
            else:
