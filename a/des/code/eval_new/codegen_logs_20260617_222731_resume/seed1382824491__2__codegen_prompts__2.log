+        signatures.add(sig)
+
+        pair_defs.append({
+            "edge": edge,
+            "height": height,
+            "width": width,
+            "mask_a": mask_a,
+            "mask_b": mask_b,
+            "color_a": colors[color_idx],
+            "color_b": colors[color_idx + 1],
