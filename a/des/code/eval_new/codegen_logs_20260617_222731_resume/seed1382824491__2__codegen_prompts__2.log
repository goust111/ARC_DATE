+def _monotone_path(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = start
+    er, ec = end
+    row_steps = [1 if er > r else -1] * abs(er - r)
+    col_steps = [1 if ec > c else -1] * abs(ec - c)
+    steps = [("r", step) for step in row_steps] + [("c", step) for step in col_steps]
+    random.shuffle(steps)
+
+    path = [(r, c)]
+    for axis, step in steps:
+        if axis == "r":
+            r += step
+        else:
+            c += step
+        path.append((r, c))
+    assert path[-1] == end
+    return path
+
+
+def _valid_partition(mask: np.ndarray) -> bool:
+    comp = ~mask
+    if int(mask.sum()) == 0 or int(comp.sum()) == 0:
+        return False
+    return _is_connected(mask) and _is_connected(comp) and _touches_all_sides(mask) and _touches_all_sides(comp)
+
+
+def _adjacent_false_cells(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    cells: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            if bool(mask[r, c]):
+                continue
+            for dr, dc in DIRS4:
+                nr, nc = r + dr, c + dc
+                if _in_bounds(mask.shape, nr, nc) and bool(mask[nr, nc]):
+                    cells.append((r, c))
+                    break
+    random.shuffle(cells)
+    return cells
