@@ -0,0 +1,623 @@
+from __future__ import annotations
+
+import random
+from collections import deque
+from functools import lru_cache
+
+import numpy as np
+
+
+BG = 0
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+EDGES = ("top", "bottom", "left", "right")
+ARC_MAX = 30
+GEN_ATTEMPTS = 400
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _bool_components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[list[tuple[int, int]]] = []
+
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        seen[r, c] = True
+        queue = deque([(r, c)])
+        coords: list[tuple[int, int]] = []
+        while queue:
+            rr, cc = queue.popleft()
+            coords.append((rr, cc))
+            for dr, dc in DIRS4:
+                nr, nc = rr + dr, cc + dc
+                if _in_bounds(mask.shape, nr, nc) and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+        components.append(coords)
+    return components
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    cells = int(mask.sum())
+    if cells == 0:
+        return False
+    return len(_bool_components(mask)) == 1
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _touches_all_sides(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any())
+
+
+def _component_record(grid: np.ndarray, coords: list[tuple[int, int]]) -> dict[str, object]:
+    r0, c0, r1, c1 = _bbox(coords)
