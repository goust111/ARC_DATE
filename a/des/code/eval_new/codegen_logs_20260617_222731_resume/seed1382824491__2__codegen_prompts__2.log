+        return None
+
+    if not np.array_equal(actual, expected):
+        return None
+
+    solved_fragments, solved_pairs = _solved_pair_specs(inp)
+    if len(solved_fragments) != pair_count * 2 or len(solved_pairs) != pair_count:
+        return None
+
+    return inp
+
+
+def generate_input() -> np.ndarray:
