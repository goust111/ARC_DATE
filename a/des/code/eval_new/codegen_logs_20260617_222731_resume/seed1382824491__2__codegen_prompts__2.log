+def _canonical_pair_signature(mask_a: np.ndarray, mask_b: np.ndarray) -> tuple[int, int, bytes]:
+    a = mask_a.astype(np.uint8).tobytes()
+    b = mask_b.astype(np.uint8).tobytes()
+    return mask_a.shape[0], mask_a.shape[1], min(a, b)
