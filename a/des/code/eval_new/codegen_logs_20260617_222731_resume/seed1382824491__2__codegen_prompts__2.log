+
+def _bool_components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[list[tuple[int, int]]] = []
+
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        seen[r, c] = True
+        queue = deque([(r, c)])
+        coords: list[tuple[int, int]] = []
+        while queue:
+            rr, cc = queue.popleft()
+            coords.append((rr, cc))
+            for dr, dc in DIRS4:
+                nr, nc = rr + dr, cc + dc
+                if _in_bounds(mask.shape, nr, nc) and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+        components.append(coords)
+    return components
