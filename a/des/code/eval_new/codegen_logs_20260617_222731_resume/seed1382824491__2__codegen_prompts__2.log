+def _mark_rect(occupied: np.ndarray, top: int, left: int, height: int, width: int, margin: int = 0) -> None:
+    h, w = occupied.shape
+    r0 = max(0, top - margin)
+    c0 = max(0, left - margin)
+    r1 = min(h, top + height + margin)
+    c1 = min(w, left + width + margin)
+    occupied[r0:r1, c0:c1] = True
