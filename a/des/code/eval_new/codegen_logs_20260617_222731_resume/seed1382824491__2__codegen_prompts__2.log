+    @lru_cache(maxsize=None)
+    def search(remaining: tuple[int, ...]) -> tuple[tuple[tuple[int, int], ...], ...]:
+        if not remaining:
+            return ((),)
+        i = remaining[0]
+        solutions: list[tuple[tuple[int, int], ...]] = []
+        rem_set = set(remaining)
+        for j in remaining[1:]:
+            if not compat[i][j]:
