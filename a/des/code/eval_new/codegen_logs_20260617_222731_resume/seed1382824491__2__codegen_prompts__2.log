+def _assembly_for_pair(a: dict[str, object], b: dict[str, object]) -> np.ndarray:
+    ma = np.asarray(a["mask"], dtype=bool)
+    mb = np.asarray(b["mask"], dtype=bool)
+    rect = np.full(ma.shape, BG, dtype=int)
+    rect[ma] = int(a["color"])
+    rect[mb] = int(b["color"])
+    assert np.all(rect != BG)
+    return rect
