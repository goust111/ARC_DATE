+def _generate_complementary_masks(h: int, w: int) -> tuple[np.ndarray, np.ndarray] | None:
+    side_orders = [
+        ("top", "right", "bottom", "left"),
+        ("top", "left", "bottom", "right"),
+        ("left", "top", "right", "bottom"),
+        ("left", "bottom", "right", "top"),
+        ("bottom", "right", "top", "left"),
+        ("bottom", "left", "top", "right"),
+        ("right", "top", "left", "bottom"),
+        ("right", "bottom", "left", "top"),
+    ]
+
+    for _ in range(250):
+        anchors = {
+            "top": (0, random.randint(1, w - 2)),
+            "bottom": (h - 1, random.randint(1, w - 2)),
+            "left": (random.randint(1, h - 2), 0),
+            "right": (random.randint(1, h - 2), w - 1),
+        }
+        order = random.choice(side_orders)
+        cells: set[tuple[int, int]] = {anchors[order[0]]}
+        for side_a, side_b in zip(order, order[1:]):
+            cells.update(_monotone_path(anchors[side_a], anchors[side_b]))
+
+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in cells:
+            mask[r, c] = True
+        if not _valid_partition(mask):
+            continue
+
+        for _ in range(random.randint(0, max(2, (h * w) // 5))):
+            placed = False
+            for r, c in _adjacent_false_cells(mask):
+                trial = mask.copy()
+                trial[r, c] = True
+                if _valid_partition(trial):
+                    mask = trial
+                    placed = True
+                    break
+            if not placed:
+                break
+
+        if random.random() < 0.5:
+            mask = ~mask
+        comp = ~mask
+        if min(int(mask.sum()), int(comp.sum())) < 4:
+            continue
+        if _valid_partition(mask):
+            return mask, comp
+    return None
