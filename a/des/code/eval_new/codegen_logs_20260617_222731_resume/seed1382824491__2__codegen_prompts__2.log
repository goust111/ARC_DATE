+    h, w = rect_shape
+    gh, gw = grid_shape
+    (r1, c1), (r2, c2) = marker_cells
+    if edge == "top":
+        return 0, (c1 + c2 - w + 1) // 2
+    if edge == "bottom":
+        return gh - h, (c1 + c2 - w + 1) // 2
+    if edge == "left":
+        return (r1 + r2 - h + 1) // 2, 0
+    if edge == "right":
+        return (r1 + r2 - h + 1) // 2, gw - w
