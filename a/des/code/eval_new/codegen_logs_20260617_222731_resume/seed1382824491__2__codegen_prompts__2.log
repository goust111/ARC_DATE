+            elif edge == "left":
+                cells = [(start + offset, 0), (start + offset + 1, 0)]
+            else:
+                cells = [(start + offset, w - 1), (start + offset + 1, w - 1)]
+            colors = tuple(int(grid[r, c]) for r, c in cells)
+            specs.append({"edge": edge, "cells": cells, "colors": colors})
