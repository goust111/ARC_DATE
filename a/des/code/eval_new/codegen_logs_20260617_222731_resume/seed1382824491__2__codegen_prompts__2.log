        for r in range(h-2,0,-1):
            path.append((r,0))
        return path
    if w % 2 == 0:
        t=cycle(w,h)
        return [(c,r) for r,c in t]
    raise ValueError


def touch(mask):
    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

