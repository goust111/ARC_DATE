+def _edge_runs(values: np.ndarray) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    i = 0
+    n = len(values)
+    while i < n:
+        if int(values[i]) == BG:
+            i += 1
+            continue
+        j = i
+        while j < n and int(values[j]) != BG:
+            j += 1
