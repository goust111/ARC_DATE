import random
from collections import deque
import numpy as np

DIRS=[(1,0),(-1,0),(0,1),(0,-1)]

def comp_count(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,bool)
    cnt=0
    for r,c in np.argwhere(mask):
        r=int(r); c=int(c)
        if seen[r,c]: continue
        cnt+=1
        dq=deque([(r,c)]); seen[r,c]=True
        while dq:
            rr,cc=dq.popleft()
            for dr,dc in DIRS:
                nr,nc=rr+dr,cc+dc
                if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                    seen[nr,nc]=True; dq.append((nr,nc))
    return cnt

def side_count(mask):
    return sum([mask[0].any(), mask[-1].any(), mask[:,0].any(), mask[:,-1].any()])

def score(mask):
    comp=~mask
    if not mask.any() or not comp.any():
        return -999
    return side_count(mask)+side_count(comp)-3*(comp_count(mask)-1)-3*(comp_count(comp)-1)-abs(mask.sum()-comp.sum())*0.02

def search(h,w,steps=20000,restarts=20):
    best=None; bests=-999
    for _ in range(restarts):
        mask=np.random.rand(h,w) < 0.5
        cur=score(mask)
        temp=2.0
        for step in range(steps):
            r=random.randrange(h); c=random.randrange(w)
            # keep both colors present
            if mask[r,c] and mask.sum()==1: continue
            if (not mask[r,c]) and (~mask).sum()==1: continue
            mask[r,c]=~mask[r,c]
            nxt=score(mask)
            if nxt >= cur or random.random() < np.exp((nxt-cur)/temp):
                cur=nxt
            else:
                mask[r,c]=~mask[r,c]
            temp*=0.9997
            if cur > bests:
                bests=cur; best=mask.copy()
            comp=~mask
            if cur >= 8 and comp_count(mask)==1 and comp_count(comp)==1 and side_count(mask)==4 and side_count(comp)==4:
                return mask
    return best

for h,w in [(5,6),(6,6),(7,8),(8,5),(9,9)]:
    res=search(h,w,steps=8000,restarts=10)
    comp=~res
    print('shape',h,w,'sides',side_count(res),side_count(comp),'cc',comp_count(res),comp_count(comp))
    print(res.astype(int))
    print()
