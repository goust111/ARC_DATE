def _growth_cells(frame: dict[str, object], seed: tuple[int, int, int]) -> list[tuple[int, int, int]]:
    r0, c0, r1, c1 = frame["bbox"]  # type: ignore[misc]
    side = frame["side"]  # type: ignore[assignment]
    depth = int(frame["depth"])
