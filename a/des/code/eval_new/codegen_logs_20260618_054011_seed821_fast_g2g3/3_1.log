+def _extract_templates(arr: np.ndarray):
+    h, w = arr.shape
+    visited = np.zeros((h, w), dtype=bool)
+    templates = []
+    dirs = ((1, 0), (-1, 0), (0, 1), (0, -1))
+    for r in range(h):
+        for c in range(w):
+            if arr[r, c] == 0 or visited[r, c]:
+                continue
+
+            queue = deque([(r, c)])
+            visited[r, c] = True
+            comp = []
+            has_grey = False
+            while queue:
+                cr, cc = queue.popleft()
+                comp.append((cr, cc))
+                if arr[cr, cc] == 5:
+                    has_grey = True
+                for dr, dc in dirs:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and arr[nr, nc] != 0:
+                        visited[nr, nc] = True
+                        queue.append((nr, nc))
