def _bfs_shortest_path(
    grid: np.ndarray,
    start: Tuple[int, int],
    goal: Tuple[int, int],
    blocked: np.ndarray,
    rng: np.random.Generator,
) -> Optional[list[Tuple[int, int]]]:
    h, w = grid.shape
    if start == goal:
        return [start]

    q = deque([start])
    parent: Dict[Tuple[int, int], Optional[Tuple[int, int]]] = {start: None}
    while q:
        r, c = q.popleft()
        dirs = list(DIR_LIST)
        rng.shuffle(dirs)
        for dr, dc in dirs:
            nr, nc = r + dr, c + dc
            if not _in_bounds(h, w, nr, nc):
                continue
            if blocked[nr, nc] and (nr, nc) != goal:
                continue
            if (nr, nc) in parent:
                continue
            parent[(nr, nc)] = (r, c)
            if (nr, nc) == goal:
                q.clear()
                break
            q.append((nr, nc))

    if goal not in parent:
        return None

    path: list[Tuple[int, int]] = []
    cur: Optional[Tuple[int, int]] = goal
    while cur is not None:
        path.append(cur)
        cur = parent[cur]
    path.reverse()
    return path


