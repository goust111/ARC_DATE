    occupied[:, blue_col] = True

    total_area = int(rng.choice(np.array([8, 10, 12, 14, 16, 18, 20], dtype=int)))
    half_area = total_area // 2
    factors: list[tuple[int, int]] = []
    for side_r in range(2, total_area + 1):
        if total_area % side_r != 0:
