import numpy as np
import importlib.util
from pathlib import Path

path = Path('/home/lixinyu/snap/a/des/code/eval_new/seed821694699/3/2.py')
spec = importlib.util.spec_from_file_location('p2', path)
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

for i in range(200):
    g = mod.generate_input()
    rr, bc = mod._find_separators(g)
    if rr is None or bc is None:
        continue
    markers = mod._marker_colors(g, rr, bc)
    marker_set = set(markers)
    pieces = mod._piece_components(g, marker_set)
    pairs=[]
    used=[False]*len(pieces)
    for a, pa in enumerate(pieces):
        if used[a]:
            continue
        sig = mod._complement_signature(pa)
        for b in range(a+1,len(pieces)):
            if used[b]:
                continue
            if pieces[b]['key']==sig:
                used[a]=used[b]=True
                pairs.append((a,b))
                break
    o = mod.main(g)
    nz = int(np.count_nonzero(o))
    if nz:
        print('found', i, g.shape, len(pieces), len(pairs), nz, 'pairs', pairs)
        break
else:
    print('no nonzero in loop')
