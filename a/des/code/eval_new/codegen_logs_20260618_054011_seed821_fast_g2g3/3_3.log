                for r in rng.choice(right_pos, size=k, replace=False):
                    occ[r, c1] = BLACK

            grid = occ
            placed = True
            break

        if placed and int(rng.integers(0, 2)) == 1:
            # extra variation: reuse one room's key when free space remains
            pass

    return grid


if __name__ == "__main__":
    sample = generate_input()
    solved = main(sample)
    print("grid", sample.shape, "changed", int(np.sum(sample != solved)))

