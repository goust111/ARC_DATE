  83: def _bounded_composition(total: int, parts: int, *, upper: int) -> list[int] | None:
  84:     """Sample positive bounded parts summing to total, or None if impossible."""
  85:     if parts == 0:
  86:         return [] if total == 0 else None
  87:     if not (parts <= total <= parts * upper):
  88:         return None
  89:     values = []
  90:     remaining = total
  91:     for i in range(parts):
  92:         slots = parts - i - 1
  93:         lo = max(1, remaining - slots * upper)
  94:         hi = min(upper, remaining - slots)
  95:         value = random.randint(lo, hi)
  96:         values.append(value)
  97:         remaining -= value
  98:     random.shuffle(values)
  99:     return values
