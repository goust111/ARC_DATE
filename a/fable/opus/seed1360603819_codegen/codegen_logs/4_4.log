+def _is_frame_component(points: list[tuple[int, int]]) -> tuple[bool, tuple[int, int, int, int] | None]:
+    r0, c0, r1, c1 = _bbox(points)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False, None
+    border = set()
+    for r in range(r0, r1 + 1):
+        border.add((r, c0))
+        border.add((r, c1))
+    for c in range(c0, c1 + 1):
+        border.add((r0, c))
+        border.add((r1, c))
+    point_set = set(points)
+    if point_set != border:
+        return False, None
+    return True, (r0, c0, r1, c1)
