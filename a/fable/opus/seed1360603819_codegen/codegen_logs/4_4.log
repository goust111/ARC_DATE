+def _merge_centered(masks: list[np.ndarray]) -> np.ndarray:
+    out_h = max(mask.shape[0] for mask in masks)
+    out_w = max(mask.shape[1] for mask in masks)
+    merged = np.zeros((out_h, out_w), dtype=bool)
+    for mask in masks:
+        h, w = mask.shape
+        r0 = (out_h - h) // 2
+        c0 = (out_w - w) // 2
+        merged[r0 : r0 + h, c0 : c0 + w] |= mask
+    return merged
+
