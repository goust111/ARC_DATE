+            grid[r0, c0 : c0 + ow] = GREY
+            grid[r0 + oh - 1, c0 : c0 + ow] = GREY
+            grid[r0 : r0 + oh, c0] = GREY
+            grid[r0 : r0 + oh, c0 + ow - 1] = GREY
