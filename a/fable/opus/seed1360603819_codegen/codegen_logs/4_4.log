+    ordered = sorted(
+        rects,
+        key=lambda rect: (int(rect["shape"].shape[0]) + 2) * (int(rect["shape"].shape[1]) + 2),
+        reverse=True,
+    )
+
+    for rect in ordered:
+        shape = rect["shape"]
+        fill = int(rect["fill"])
+        oh = int(shape.shape[0]) + 2
+        ow = int(shape.shape[1]) + 2
+        placed = False
+        for _ in range(250):
