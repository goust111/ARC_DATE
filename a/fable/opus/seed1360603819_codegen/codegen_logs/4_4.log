+                return None
+            r0 = rng.randint(2, grid_h - oh - 1)
+            c0 = rng.randint(1, grid_w - ow - 1)
+            rr0 = max(0, r0 - 1)
+            rr1 = min(grid_h, r0 + oh + 1)
+            cc0 = max(0, c0 - 1)
+            cc1 = min(grid_w, c0 + ow + 1)
+            if busy[rr0:rr1, cc0:cc1].any():
+                continue
