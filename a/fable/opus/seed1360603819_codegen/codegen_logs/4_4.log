+    member_views = []
+    for mask in groups[merge_holes]:
+        canvas = np.zeros_like(merged)
+        mh, mw = mask.shape
+        r0 = (merged.shape[0] - mh) // 2
+        c0 = (merged.shape[1] - mw) // 2
