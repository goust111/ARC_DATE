+def _sort_key(comp: dict[str, object], direction: str) -> tuple[int, int]:
+    r0, c0, r1, c1 = comp["bbox"]  # type: ignore[misc]
+    if direction == "up":
+        return int(r0), int(c0)
+    if direction == "down":
+        return -int(r1), int(c0)
+    if direction == "left":
