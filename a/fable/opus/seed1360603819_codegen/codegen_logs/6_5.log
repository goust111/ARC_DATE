+    cursor = 1 + gaps[0]
+    for idx in range(count):
+        starts.append(cursor)
+        cursor += GEN_BAND_SPAN
+        if idx + 1 < count:
+            cursor += GEN_BAND_GAP + gaps[idx + 1]
+    return starts
