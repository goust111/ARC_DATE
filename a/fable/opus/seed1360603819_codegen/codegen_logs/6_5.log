+            {
+                "target_color": int(g[marker]),
+                "direction": direction,
+                "marker": marker,
+                "arrow_cells": tuple(cells),
+            }
+        )
+
+    instructions.sort(key=lambda inst: (inst["marker"][0], inst["marker"][1]))  # type: ignore[index]
+    return instructions
