+def _find_instructions(grid: np.ndarray) -> list[dict[str, object]]:
+    g = np.asarray(grid, dtype=int)
+    components = _find_components(g, exclude_colors={BLACK, GREY})
+    instructions: list[dict[str, object]] = []
+
+    for comp in components:
+        if int(comp["area"]) != 3:
+            continue
