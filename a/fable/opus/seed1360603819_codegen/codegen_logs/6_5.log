+def _band_starts(length: int, count: int) -> list[int] | None:
+    required = count * GEN_BAND_SPAN + (count - 1) * GEN_BAND_GAP
+    if required > length:
+        return None
+    slack = length - required
+    gaps = [0] * (count + 1)
+    for _ in range(slack):
