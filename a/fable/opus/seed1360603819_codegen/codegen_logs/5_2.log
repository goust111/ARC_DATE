+    out = g.copy()
+    for k, frame_id in enumerate(order):
+        donor_id = order[(k + 1) % len(order)]
+        new_color = int(frames[donor_id]["color"])
+        r0, c0, r1, c1 = frames[frame_id]["bbox"]
+        interior = out[r0 + 1 : r1, c0 + 1 : c1]
+        interior[frames[frame_id]["mask"]] = new_color
