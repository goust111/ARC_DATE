+def _paste_patch(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
+    target = grid[r0 : r0 + h, c0 : c0 + w]
+    assert target.shape == patch.shape
+    assert np.all(target == BLACK)
+    target[:] = patch
