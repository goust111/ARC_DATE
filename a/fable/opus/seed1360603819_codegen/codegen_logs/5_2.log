+def _row_groups(patches: list[np.ndarray]) -> list[list[int]]:
+    order = sorted(range(len(patches)), key=lambda idx: int(patches[idx].shape[1]), reverse=True)
+    if len(patches) == 4:
+        rows = [order[::2], order[1::2]]
+        for row in rows:
+            random.shuffle(row)
+        if random.random() < 0.5:
