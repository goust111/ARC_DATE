+    patch = np.full((interior.shape[0] + 2, interior.shape[1] + 2), BLACK, dtype=int)
+    patch[0, :] = RED
+    patch[-1, :] = RED
+    patch[:, 0] = RED
+    patch[:, -1] = RED
+    patch[1:-1, 1:-1] = interior
