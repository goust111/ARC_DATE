+    if hole_count >= 4 and mask.shape[0] > mask.shape[1]:
+        mask = mask.T
+    elif hole_count == 3 and mask.shape[0] > mask.shape[1] and random.random() < 0.75:
+        mask = mask.T
+    elif random.random() < 0.45:
+        mask = mask.T
+    if random.random() < 0.5:
+        mask = np.flipud(mask)
