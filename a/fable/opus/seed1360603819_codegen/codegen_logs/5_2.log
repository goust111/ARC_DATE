+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _build_candidate()
+        try:
+            out = main(grid)
+        except Exception:
+            continue
+        assert out.shape == grid.shape
+        return grid
+    raise RuntimeError("failed to generate a valid ARC instance")

