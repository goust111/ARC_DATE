+
+def _make_frame_patch(hole_count: int, color: int) -> np.ndarray:
+    blob = _build_blob(hole_count)
+    bh, bw = blob.shape
+    pad_top = random.randint(1, 2)
+    pad_bottom = random.randint(1, 2)
+    pad_left = random.randint(1, 2)
+    pad_right = random.randint(1, 2)
