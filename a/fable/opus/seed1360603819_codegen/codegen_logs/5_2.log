+    mask = np.zeros((height, width), dtype=bool)
+    mask[:, 0] = True
+
+    ring_boxes = []
+    row = 0
+    for i, ((rh, rw), branch) in enumerate(zip(ring_sizes, branches, strict=False)):
+        col = 1 + branch
+        _draw_ring(mask, row, col, rh, rw)
+        bridge_row = row + rh // 2
+        mask[bridge_row, : col + 1] = True
