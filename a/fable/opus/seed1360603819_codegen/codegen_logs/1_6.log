+def _line_cells(shape: tuple[int, int], orientation: str, line_id: int) -> list[tuple[int, int]]:
+    h, w = shape
+    cells: list[tuple[int, int]] = []
+    if orientation == NWSE:
+        for r in range(h):
+            c = r - line_id
+            if 0 <= c < w:
+                cells.append((r, c))
+    else:
+        for r in range(h):
+            c = line_id - r
+            if 0 <= c < w:
+                cells.append((r, c))
+    return cells
+
+
+def _all_line_ids(shape: tuple[int, int], orientation: str, min_length: int) -> list[int]:
+    h, w = shape
