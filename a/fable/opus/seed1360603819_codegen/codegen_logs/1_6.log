+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _orientation_steps(orientation: str) -> tuple[tuple[int, int], tuple[int, int]]:
+    if orientation == NWSE:
+        return (-1, -1), (1, 1)
+    if orientation == NESW:
+        return (-1, 1), (1, -1)
