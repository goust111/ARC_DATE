+def _line_intersection(shape: tuple[int, int], nwse_id: int, nesw_id: int) -> tuple[int, int] | None:
+    if (nwse_id + nesw_id) % 2 != 0:
+        return None
+    r = (nwse_id + nesw_id) // 2
+    c = (nesw_id - nwse_id) // 2
+    if _in_bounds(shape, r, c):
+        return (r, c)
+    return None
