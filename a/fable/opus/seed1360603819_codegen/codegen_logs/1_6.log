+        segments.append(segment)
+        used_lines[minor_orientation].add(int(segment["line_id"]))
+        occupied.update(segment["cells"])
+
+    grid = _build_grid(shape, segments)
+    if not _scene_is_valid(grid, major_orientation):
+        return None
+    return grid
