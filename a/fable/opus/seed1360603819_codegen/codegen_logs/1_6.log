+        candidates = range(-(w - 1), h)
+    else:
+        candidates = range(h + w - 1)
+    for line_id in candidates:
+        if len(_line_cells(shape, orientation, line_id)) >= min_length:
+            ids.append(line_id)
+    return ids
+
