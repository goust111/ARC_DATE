+    for arrow in arrows:
+        head_r, head_c = map(int, arrow["head"])
+        dr, dc = map(int, arrow["direction"])
+        color = int(arrow["color"])
+        rank = int(rank_by_color[color])
+        arrow_stats = {
+            "color": color,
+            "rank": rank,
+            "head": (head_r, head_c),
+            "lane_paints": [],
+            "lane_reasons": [],
+        }
