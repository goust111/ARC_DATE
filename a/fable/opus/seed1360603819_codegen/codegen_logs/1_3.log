+        return True
+    return False
+
+
+def _place_blocker_arrow(
+    rng: np.random.Generator,
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    shooter: dict,
+    color: int,
+    rank: int,
+) -> dict | None:
