+    head_r, head_c = shooter["head"]
+    dr, dc = shooter["direction"]
+    lane = (0, 0)
+    start = (int(head_r + dr), int(head_c + dc))
+    max_dist = _distance_to_boundary(start, shooter["direction"], height, width)
+    if max_dist < 4:
+        return None
