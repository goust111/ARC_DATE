+    lane = offsets[int(rng.integers(len(offsets)))]
+    start = (int(head_r + lane[0] + dr), int(head_c + lane[1] + dc))
+    max_dist = _distance_to_boundary(start, shooter["direction"], height, width)
+    if max_dist < 4:
+        return False
