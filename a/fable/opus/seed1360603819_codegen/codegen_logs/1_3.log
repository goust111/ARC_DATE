+    if "ray" in reasons:
+        return False
+    if "edge" not in reasons:
+        return False
+    if mode == "wall" and "wall" not in reasons:
+        return False
+    if mode == "object" and "object" not in reasons:
+        return False
+
+    if int(np.count_nonzero(out != grid)) < 8:
+        return False
