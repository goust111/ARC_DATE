+    ordered = sorted(totals.items(), key=lambda item: -item[1])
+    return {int(color): idx + 1 for idx, (color, _total) in enumerate(ordered)}
+
+
+def _bundle_offsets(rank: int, tail_side: tuple[int, int]) -> list[tuple[int, int]]:
+    offsets = [(0, 0)]
+    step = 1
+    tr, tc = tail_side
