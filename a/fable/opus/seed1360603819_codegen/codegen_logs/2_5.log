+
+
+def _make_pattern(shape_mask: np.ndarray, with_holes: bool, rng: random.Random) -> np.ndarray:
+    holes = _sample_holes(shape_mask, rng) if with_holes else np.zeros_like(shape_mask, dtype=bool)
