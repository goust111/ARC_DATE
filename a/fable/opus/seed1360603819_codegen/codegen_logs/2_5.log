+        return holes
+
+    rng.shuffle(coords)
+    hole_count = rng.randint(1, min(4, len(coords)))
+    holes[coords[0][0], coords[0][1]] = True
+
+    frontier = [coords[0]]
+    while int(holes.sum()) < hole_count:
+        neighbors: list[tuple[int, int]] = []
+        for rr, cc in frontier:
+            for dr, dc in CARDINALS:
+                nr = rr + dr
+                nc = cc + dc
