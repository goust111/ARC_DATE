+
+
+def _sample_holes(shape_mask: np.ndarray, rng: random.Random) -> np.ndarray:
+    interior = _interior_cells(shape_mask)
+    holes = np.zeros_like(shape_mask, dtype=bool)
+    coords = [tuple(x) for x in np.argwhere(interior)]
+    if not coords:
