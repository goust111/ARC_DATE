+MIN_LINE_LENGTH = 3
+MAX_GENERATION_ATTEMPTS = 400
+LINE_PLACEMENT_ATTEMPTS = 200
+SCENE_ATTEMPTS = 120
+MAX_CROSSINGS_PER_SCENE = 6
