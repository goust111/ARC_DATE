+    if orientation == "v":
+        return _make_cells(random.randrange(H - length + 1), random.randrange(W), orientation, length)
+    if orientation == "d1":
+        return _make_cells(random.randrange(H - length + 1), random.randrange(W - length + 1), orientation, length)
