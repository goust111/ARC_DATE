+    out, cover = _render_output(H, W, lines)
+    inp = _render_input(H, W, lines, cover)
+    if min(_visible_counts(inp, lines)) < 2:
+        return None
+    if len(_extract_lines(inp)) != line_count:
+        return None
+    if not np.array_equal(main(inp), out):
+        return None
+    return inp, out
