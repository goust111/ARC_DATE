+        r, c = random.choice(crossing_cells)
+        ids = cover[(r, c)]
+        top_idx = max(ids, key=lambda idx: int(lines[idx]["length"]))
+        non_top = [idx for idx in ids if idx != top_idx]
+        chosen = random.choice(non_top)
+        inp[r, c] = int(lines[chosen]["color"])
+
+    return inp
