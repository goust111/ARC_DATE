+    second = _place_line(H, W, orientations[1], lengths[1], lines, used_supports, must_cross=True)
+    if second is None:
+        return None
+    lines.append(second)
+    used_supports.add((second["orientation"], _support_id(second["cells"], second["orientation"])))
