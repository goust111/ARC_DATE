+BG = 0
+PALETTE = tuple(range(1, 10))
+ORIENTATIONS = ("h", "v", "d1", "d2")
+STEPS = {
+    "h": (0, 1),
+    "v": (1, 0),
+    "d1": (1, 1),
+    "d2": (1, -1),
