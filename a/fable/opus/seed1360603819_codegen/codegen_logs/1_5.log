+        left = random.randint(0, panel_w - sw)
+        cells = _abs_cells(local, top, left)
+        tl = _top_left(cells)
+        if tl in used_top_lefts or cells & occupied:
+            continue
+        return cells
+    return None
+
+
+def _place_overlap_pair(
+    panel_h: int,
+    panel_w: int,
