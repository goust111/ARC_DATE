+def _render_input(template: np.ndarray, roles: list[dict]) -> np.ndarray:
+    panels = []
+    for panel_idx in range(EARLY_PANEL_COUNT):
+        panel = template.copy()
+        for role in roles:
+            if panel_idx in role["panels"]:
+                panel[role["mask"]] = role["color"]
+        panels.append(panel)
+    panels.append(template.copy())
