+
+
+def _place_overlap_pair(
+    panel_h: int,
+    panel_w: int,
+    used_top_lefts: set[tuple[int, int]],
+) -> tuple[set[tuple[int, int]], set[tuple[int, int]]] | None:
+    for _ in range(OVERLAP_RETRIES):
+        local_a = _random_shape_cells()
+        local_b = _random_shape_cells()
