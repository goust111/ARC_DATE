+def _make_body_mask(hole_count: int, tail_side: str, rng: random.Random) -> np.ndarray:
+    for _ in range(200):
+        core_h = rng.choice([5, 7])
+        core_w = rng.choice([5, 7])
+        candidates = [(r, c) for r in range(1, core_h - 1, 2) for c in range(1, core_w - 1, 2)]
