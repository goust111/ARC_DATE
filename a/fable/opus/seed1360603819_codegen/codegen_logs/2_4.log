  12: 
  13:     Input structure:
  14:     - The top row is the upper background color and the bottom row is the
  15:       floor color.
  16:     - A single non-background, non-floor object touches exactly one vertical
  17:       grid edge and rests immediately above the first solid floor row.
  18: 
  19:     Rule:
  20:     - Clear the source object to the upper background color.
  21:     - Repaint each object row on the opposite side: the first three relative
  22:       rows keep the edge alignment, and each lower row shifts one more pixel
  23:       inward from that side.
  24:     - On the first floor row, repaint the traversed side-to-object segment
  25:       maroon, stopping just before the final outer bottom support pixel.
  26: 
  27:     Key insight:
  28:     - The side of the source object gives the horizontal direction, while the
  29:       row index inside the object gives the one-cell-per-row diagonal shear.
  30:     """
  31:     g = np.asarray(grid, dtype=int)
  32:     assert g.ndim == 2, "grid must be two-dimensional"
  33:     height, width = g.shape
  34: 
  35:     top_colors = np.unique(g[0])
  36:     bottom_colors = np.unique(g[-1])
  37:     assert len(top_colors) == 1, "top row must be a uniform background"
  38:     assert len(bottom_colors) == 1, "bottom row must be a uniform floor"
  39:     bg = int(top_colors[0])
  40:     floor = int(bottom_colors[0])
  41:     assert bg != floor, "background and floor colors must differ"
  42: 
  43:     colors = set(map(int, np.unique(g)))
  44:     assert len(colors) == 3, "expected exactly background, floor, and one object color"
  45:     object_colors = colors - {bg, floor}
  46:     assert len(object_colors) == 1, "expected one moving object color"
  47:     obj = object_colors.pop()
  48: 
  49:     full_floor_rows = np.where(np.all(g == floor, axis=1))[0]
  50:     assert len(full_floor_rows) > 0, "expected a solid floor row"
  51:     floor_row = int(full_floor_rows[0])
  52:     assert 0 < floor_row < height, "floor row must be inside the grid"
  53:     assert np.all(g[floor_row:] == floor), "floor must be a solid bottom band"
  54: 
  55:     obj_coords = np.argwhere(g == obj)
  56:     assert len(obj_coords) > 0, "expected a moving object"
  57:     r0, c0, r1, c1 = bbox_coords(obj_coords)
  58:     object_width = c1 - c0 + 1
  59:     assert r1 == floor_row - 1, "object must rest directly above the floor"
  60:     assert (c0 == 0) ^ (c1 == width - 1), "object must touch exactly one side edge"
  61:     assert np.all(g[:floor_row][g[:floor_row] != obj] == bg), "upper region must contain only bg and object"
  62: 
  63:     moving_right = c0 == 0
  64:     out = g.copy()
  65:     out[g == obj] = bg
  66: 
  67:     for r in range(r0, r1 + 1):
  68:         rel_r = r - r0
  69:         rel_cols = np.where(g[r, c0 : c1 + 1] == obj)[0]
  70:         assert len(rel_cols) > 0, "every object bbox row must contain object pixels"
  71: 
  72:         inward_shift = max(0, rel_r - 2)
  73:         if moving_right:
  74:             start_col = width - object_width - inward_shift
  75:         else:
  76:             start_col = inward_shift
  77:         dst_cols = start_col + rel_cols
  78:         assert int(dst_cols.min()) >= 0 and int(dst_cols.max()) < width, "moved object must fit in the grid"
  79:         out[r, dst_cols] = obj
  80: 
  81:     bottom_rel_cols = np.where(g[r1, c0 : c1 + 1] == obj)[0]
  82:     bottom_shift = max(0, r1 - r0 - 2)
  83:     bottom_start = width - object_width - bottom_shift if moving_right else bottom_shift
  84:     final_bottom_cols = bottom_start + bottom_rel_cols
  85:     trail_color = Color.MAROON
  86:     assert int(trail_color) not in colors, "trail color must be new"
  87:     if moving_right:
  88:         trail_end = int(final_bottom_cols.max()) - 1
  89:         assert trail_end >= 0, "trail must cover at least one floor pixel"
  90:         out[floor_row, : trail_end + 1] = int(trail_color)
  91:     else:
  92:         trail_start = int(final_bottom_cols.min()) + 1
  93:         assert trail_start < width, "trail must cover at least one floor pixel"
  94:         out[floor_row, trail_start:] = int(trail_color)
  95: 
  96:     return out

