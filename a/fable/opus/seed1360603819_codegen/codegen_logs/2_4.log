  37: def main(grid: np.ndarray) -> np.ndarray:
  38:     """
  39:     Transfer sprites from red-marked lanes to green-marked lanes, recoloring and stacking.
  40: 
  41:     Input structure:
  42:     - bg = most common color. Red (2) and green (3) thin bars define vertical lanes.
  43:     - Each lane contains repeated identical monochrome sprites in an evenly spaced vertical grid.
  44: 
  45:     Rule:
  46:     - Each red lane's sprites turn grey (5); their count transfers to the nearest green lane.
  47:     - New sprites fill empty lattice slots bottom-up, using the source shape recolored to the destination lane's sprite color.
  48:     - All marker bars are removed.
  49: 
  50:     Key insight: Sprite count is conserved across lanes — red sprites become grey, and equally many new sprites stack into the green lane's regular grid.
  51:     """
  52:     g = np.asarray(grid, dtype=int)
  53:     h, w = g.shape
  54:     bg = get_bg(g)
  55: 
  56:     red_markers = _find_marker_bars(g, 2)
  57:     green_markers = _find_marker_bars(g, 3)
  58:     assert red_markers and green_markers, "expected both red and green marker bars to be present"
  59: 
  60:     # Build destination lane state per green marker.
  61:     green_state = {}
  62:     for gm in green_markers:
  63:         _, dst_c0, _, dst_c1 = bbox_coords(np.array(gm))
  64:         dst_cols = range(dst_c0, dst_c1 + 1)
  65:         dst_set = set(gm)
  66:         dst_comps = _single_color_components_in_cols(g, dst_cols, bg)
  67:         dst_comps = [[p for p in pts if p not in dst_set] for pts in dst_comps]
  68:         dst_comps = [pts for pts in dst_comps if pts]
  69:         if not dst_comps:
  70:             continue
  71: 
  72:         dst_sz = max(len(p) for p in dst_comps if len(p) != len(gm))
  73:         dst_sprites = [p for p in dst_comps if len(p) == dst_sz]
  74:         if not dst_sprites:
  75:             continue
  76: 
  77:         dst_sprites_sorted = []
  78:         for pts in dst_sprites:
  79:             rmin = min(r for r, _ in pts)
  80:             cmin = min(c for _, c in pts)
  81:             dst_sprites_sorted.append((rmin, cmin, pts))
  82:         dst_sprites_sorted.sort()
  83:         dst_color = int(g[dst_sprites_sorted[0][2][0][0], dst_sprites_sorted[0][2][0][1]])
  84: 
  85:         tops = sorted({rmin for rmin, _cmin, _pts in dst_sprites_sorted})
  86:         if len(tops) >= 2:
  87:             diffs = [b - a for a, b in zip(tops, tops[1:]) if b - a > 0]
  88:             period = int(np.gcd.reduce(diffs)) if diffs else 4
  89:         else:
  90:             r0, c0, r1, c1 = bbox_coords(np.array(dst_sprites_sorted[0][2]))
  91:             period = (r1 - r0 + 1) + 1
  92: 
  93:         gc = (dst_c0 + dst_c1) / 2.0
  94:         green_state[id(gm)] = {
  95:             "marker": gm,
  96:             "center": gc,
  97:             "dst_color": dst_color,
  98:             "period": period,
  99:             "occupied": set(tops),
 100:             "bottom0": max(tops),
 101:         }
 102: 
 103:     assert green_state, "expected at least one green lane with valid sprites"
 104: 
 105:     out = g.copy()
 106: 
 107:     for rm in red_markers:
 108:         _, src_c0, _, src_c1 = bbox_coords(np.array(rm))
 109:         src_cols = range(src_c0, src_c1 + 1)
 110:         src_set = set(rm)
 111:         src_comps = _single_color_components_in_cols(g, src_cols, bg)
 112:         src_comps = [[p for p in pts if p not in src_set] for pts in src_comps]
 113:         src_comps = [pts for pts in src_comps if pts]
 114:         if not src_comps:
 115:             continue
 116: 
 117:         src_sz = max(len(p) for p in src_comps if len(p) != len(rm))
 118:         src_sprites = [p for p in src_comps if len(p) == src_sz]
 119:         if not src_sprites:
 120:             continue
 121: 
 122:         # Grey out all source sprites.
 123:         for pts in src_sprites:
 124:             for r, c in pts:
 125:                 out[r, c] = 5
 126: 
 127:         # Nearest green lane by x-center.
 128:         rc = (src_c0 + src_c1) / 2.0
 129:         best = min(green_state.values(), key=lambda st: abs(st["center"] - rc))
 130: 
 131:         # Source template (top-most sprite), shifted horizontally to the destination lane center.
 132:         src_sprites_sorted = []
 133:         for pts in src_sprites:
 134:             rmin = min(r for r, _ in pts)
 135:             cmin = min(c for _, c in pts)
 136:             src_sprites_sorted.append((rmin, cmin, pts))
 137:         src_sprites_sorted.sort()
 138:         src_ref_r0, _src_ref_c0, src_ref_pts = src_sprites_sorted[0]
 139: 
 140:         dc_shift = int(round(best["center"] - rc))
 141:         src_offsets = [(r - src_ref_r0, c + dc_shift) for r, c in src_ref_pts]
 142:         sprite_h = max(dr for dr, _c in src_offsets) + 1
 143: 
 144:         # Place as many sprites as removed, filling empty slots from the bottom upward.
 145:         n_new = len(src_sprites)
 146:         placed = 0
 147:         k = 0
 148:         while placed < n_new:
 149:             new_top = best["bottom0"] - k * best["period"]
 150:             k += 1
 151:             if new_top < 0 or new_top + sprite_h > h:
 152:                 if new_top < 0:
 153:                     break
 154:                 continue
 155:             if new_top in best["occupied"]:
 156:                 continue
 157:             ok = True
 158:             for dr, c in src_offsets:
 159:                 rr = new_top + dr
 160:                 if not (0 <= rr < h and 0 <= c < w):
 161:                     ok = False
 162:                     break
 163:                 if int(out[rr, c]) != bg:
 164:                     ok = False
 165:                     break
 166:             if not ok:
 167:                 continue
 168:             for dr, c in src_offsets:
 169:                 out[new_top + dr, c] = best["dst_color"]
 170:             best["occupied"].add(new_top)
 171:             placed += 1
 172: 
 173:     # Remove all marker bars.
 174:     for rm in red_markers:
 175:         for r, c in rm:
 176:             out[r, c] = bg
 177:     for gm in green_markers:
 178:         for r, c in gm:
 179:             out[r, c] = bg
 180: 
 181:     return out

