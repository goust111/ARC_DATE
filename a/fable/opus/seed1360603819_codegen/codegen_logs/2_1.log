+    bot_r0 = mid_r0 + heights[1] + gap2
+    frames = [
+        (top_r0, c0, top_r0 + heights[0] - 1, c0 + stack_w - 1),
+        (mid_r0, c0, mid_r0 + heights[1] - 1, c0 + stack_w - 1),
+        (bot_r0, c0, bot_r0 + heights[2] - 1, c0 + stack_w - 1),
+    ]
