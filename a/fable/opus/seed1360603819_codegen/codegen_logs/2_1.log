+def _place_vertical_stack(h: int, w: int, rng: random.Random) -> list[tuple[int, int, int, int]] | None:
+    heights = [rng.randint(3, 5) for _ in range(3)]
+    gap1 = rng.randint(2, 4)
+    gap2 = rng.randint(2, 4)
+    total_h = sum(heights) + gap1 + gap2
+    if total_h > h - 4:
