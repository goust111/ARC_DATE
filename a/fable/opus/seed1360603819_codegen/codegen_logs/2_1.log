+            [3, 2, 1, 0, 0],
+            [4, 2, 1, 0, 0],
+        ]
+    elif frame_count == 4:
+        profiles = [
+            [4, 3, 2, 1],
+            [3, 2, 1, 0],
+            [4, 2, 1, 0],
