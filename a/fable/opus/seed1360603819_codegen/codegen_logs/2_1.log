+def _choose_targets(side_coords: list[dict[str, list[int]]], rng: random.Random) -> list[int] | None:
+    capacities = [sum(1 for side in SIDES if coords[side]) for coords in side_coords]
+    frame_count = len(capacities)
+
+    if frame_count >= 5:
+        profiles = [
