+        else:
+            sc0 = rng.randint(c0 + stack_w + 2, w - side_w - 3)
+        rect = (sr0, sc0, sr0 + side_h - 1, sc0 + side_w - 1)
+        if _can_place(rect, frames, h, w):
+            frames.append(rect)
