+        if not (r1 + 1 < pr0 or pr1 + 1 < r0 or c1 + 1 < pc0 or pc1 + 1 < c0):
+            return False
+    return True
+
+
+def _place_independent(h: int, w: int, rng: random.Random) -> list[tuple[int, int, int, int]] | None:
