+    for _ in range(80):
+        if overlap:
+            sr0 = rng.randint(mid_r0, max(mid_r0, min(bot_r0 + heights[2] - side_h, h - side_h - 3)))
+        else:
+            if rng.random() < 0.5:
+                upper_limit = top_r0 - side_h - 2
