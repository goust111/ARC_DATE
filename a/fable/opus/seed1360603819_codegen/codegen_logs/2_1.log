+    for r in sources["left"]:
+        candidates = [idx for idx, frame in enumerate(frames) if int(frame["r0"]) <= r <= int(frame["r1"])]
+        if candidates:
+            hit = min(candidates, key=lambda idx: int(frames[idx]["c0"]))
+            illuminated[hit].add("left")
