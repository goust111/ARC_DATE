+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+MAGENTA = 6
+AZURE = 8
+
+LEGEND_COLORS = (RED, GREEN, YELLOW, MAGENTA)
+SIDES = ("top", "bottom", "left", "right")
+GEN_RETRIES = 400
