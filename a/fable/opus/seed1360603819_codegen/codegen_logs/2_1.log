+def _place_horizontal_stack(h: int, w: int, rng: random.Random) -> list[tuple[int, int, int, int]] | None:
+    widths = [rng.randint(3, 6) for _ in range(3)]
+    gap1 = rng.randint(2, 4)
+    gap2 = rng.randint(2, 4)
