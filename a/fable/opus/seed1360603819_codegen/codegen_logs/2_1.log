+def _illuminated_sides(
+    frames: list[dict[str, int | tuple[int, int, int, int]]],
+    h: int,
+    w: int,
+    sources: dict[str, list[int]],
+) -> list[set[str]]:
+    illuminated = [set() for _ in frames]
