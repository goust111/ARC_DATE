+        return None
+    if side != "bottom" and not np.all(patch[-1, 1:-1] == color):
+        return None
+    if side != "left" and not np.all(patch[1:-1, 0] == color):
+        return None
+    if side != "right" and not np.all(patch[1:-1, -1] == color):
+        return None
