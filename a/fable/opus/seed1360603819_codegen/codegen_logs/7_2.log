+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(pts)
+    return comps
+
+
+def _bbox(pts: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in pts]
+    cols = [c for _, c in pts]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _count_inner_zero_components(patch: np.ndarray) -> int:
+    zero = patch == BG
+    count = 0
+    for comp in _components(zero):
+        if all(0 < r < patch.shape[0] - 1 and 0 < c < patch.shape[1] - 1 for r, c in comp):
+            count += 1
+    return count
