+def _choose_separated_cells(
+    cells: list[tuple[int, int]], count: int, rng: random.Random
+) -> list[tuple[int, int]] | None:
+    for _ in range(80):
+        order = cells[:]
+        rng.shuffle(order)
+        chosen: list[tuple[int, int]] = []
+        for r, c in order:
+            if all(abs(r - rr) > 1 or abs(c - cc) > 1 for rr, cc in chosen):
+                chosen.append((r, c))
+                if len(chosen) == count:
+                    return chosen
