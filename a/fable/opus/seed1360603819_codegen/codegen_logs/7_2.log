+def _paste_nonzero(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    sub = grid[r0 : r0 + patch.shape[0], c0 : c0 + patch.shape[1]]
+    mask = patch != BG
+    sub[mask] = patch[mask]
+
