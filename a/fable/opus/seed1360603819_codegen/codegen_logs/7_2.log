+        gaps = rng.sample(list(range(1, ch + 1)), gap_count)
+        patch[gaps, 0] = BG
+    elif side == "right":
+        gaps = rng.sample(list(range(1, ch + 1)), gap_count)
+        patch[gaps, -1] = BG
+    elif side == "top":
+        gaps = rng.sample(list(range(1, cw + 1)), gap_count)
+        patch[0, gaps] = BG
+    else:
+        gaps = rng.sample(list(range(1, cw + 1)), gap_count)
+        patch[-1, gaps] = BG
