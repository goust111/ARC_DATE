+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME_COLOR = 5
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+SIDES = ("left", "right", "top", "bottom")
+OPPOSITE_SIDE = {"left": "right", "right": "left", "top": "bottom", "bottom": "top"}
+STAMP_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+GEN_ATTEMPTS = 400
