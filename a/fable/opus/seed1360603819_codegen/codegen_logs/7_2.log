+) -> tuple[int, int] | None:
+    h, w = patch.shape
+    origins = [
+        (r, c)
+        for r in range(1, grid.shape[0] - h)
+        for c in range(1, grid.shape[1] - w)
+    ]
+    rng.shuffle(origins)
+    for r0, c0 in origins:
+        if _can_place(occ, r0, c0, h, w, pad):
+            _paste_nonzero(grid, patch, r0, c0)
+            _mark_occ(occ, r0, c0, h, w, pad)
+            return r0, c0
+    return None
+
