+            row_starts = list(range(0, ch, sh))
+        else:
+            start = ch - ((ch + sh - 1) // sh) * sh
+            row_starts = list(range(start, ch, sh))
+        for r0 in row_starts:
+            for c0 in col_starts:
+                rr0 = max(0, r0)
+                cc0 = max(0, c0)
+                rr1 = min(ch, r0 + sh)
+                cc1 = min(cw, c0 + sw)
+                out[rr0:rr1, cc0:cc1] = patch[rr0 - r0 : rr1 - r0, cc0 - c0 : cc1 - c0]
