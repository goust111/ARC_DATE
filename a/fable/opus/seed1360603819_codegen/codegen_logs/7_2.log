+    if np.any((patch != BG) & (patch != color)):
+        return None
+    if np.any(patch[1:-1, 1:-1] != BG):
+        return None
+    if not (
+        patch[0, 0] == color
+        and patch[0, -1] == color
+        and patch[-1, 0] == color
+        and patch[-1, -1] == color
