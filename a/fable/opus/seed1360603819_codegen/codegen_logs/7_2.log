+def _direction_effective(stamp: np.ndarray, cavity_shape: tuple[int, int], side: str) -> bool:
+    return not np.array_equal(
+        _tile_patch(stamp, cavity_shape, side),
+        _tile_patch(stamp, cavity_shape, OPPOSITE_SIDE[side]),
