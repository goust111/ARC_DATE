+
+    def ok(cell: tuple[int, int]) -> bool:
+        return all(max(abs(cell[0] - other[0]), abs(cell[1] - other[1])) > 1 for other in chosen.values())
+
+    def dfs(idx: int) -> bool:
+        if idx == len(order):
+            return True
+        depth = int(order[idx])
+        for cell in candidates[depth]:
+            if not ok(cell):
+                continue
+            chosen[depth] = cell
+            if dfs(idx + 1):
+                return True
+            del chosen[depth]
+        return False
+
+    return chosen if dfs(0) else None
+
