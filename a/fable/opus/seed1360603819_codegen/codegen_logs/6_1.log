# Canvas/palette bounds.
GRID_HALF_MIN = 2
GRID_HALF_MAX = 6
COLOR_COUNT = 10
MIN_TARGET_COLORS = 3
MAX_NON_BG_COLORS = COLOR_COUNT - 1
