+
+BLACK = 0
+GREY = 5
+MARKER_COLORS = (2, 3, 4, 8, 9)  # red, green, yellow, azure, maroon
+LAYOUT_OPTIONS = ((1, 2), (2, 1), (1, 3), (3, 1), (2, 2), (2, 3), (3, 2))
