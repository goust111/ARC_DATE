+    return {(r, cc) for cc in range(c, w)}
+
+
+def _draw_ring(grid: np.ndarray, box: tuple[int, int, int, int]) -> None:
+    r0, c0, r1, c1 = box
+    grid[r0 : r1 + 1, c0 : c1 + 1] = BLACK
