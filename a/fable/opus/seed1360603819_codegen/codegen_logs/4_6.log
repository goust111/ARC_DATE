+        out[seed_r, seed_c] = BLACK
+        if side == "top":
+            new_r, new_c = r0 + 1, seed_c
+        elif side == "bottom":
+            new_r, new_c = r1 - 1, seed_c
+        elif side == "left":
+            new_r, new_c = seed_r, c0 + 1
+        else:
+            new_r, new_c = seed_r, c1 - 1
