+COLOR_POOL = [1, 2, 3, 4, 7, 8, 9]
+BRANCHES = [
+    ("top", "left"),
+    ("top", "right"),
+    ("bottom", "left"),
+    ("bottom", "right"),
+    ("left", "top"),
+    ("left", "bottom"),
+    ("right", "top"),
+    ("right", "bottom"),
+]
