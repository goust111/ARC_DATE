+    out = g.copy()
+    for frame in frames:
+        r0, c0, r1, c1 = _bbox(frame)
+        assert r1 - r0 >= 4 and c1 - c0 >= 4, "frame must have a nontrivial interior"
+        side, gap_cells = _gap_info(g, r0, c0, r1, c1)
+        seed_r, seed_c, seed_color = _seed_info(g, r0, c0, r1, c1)
