+def _preferred_cols(width: int, c0: int, c1: int, prefer: str) -> list[int]:
+    cols = []
+    for c in range(int(c0 + 2), int(c1 - 1)):
+        if _horizontal_side(width, c, break_ties=False) == prefer:
