+def _horizontal_side(width: int, col: int, *, break_ties: bool) -> str | None:
+    left_dist = _axis_distance(int(col), (0, 1))
+    right_dist = _axis_distance(int(col), (int(width - 2), int(width - 1)))
+    if left_dist < right_dist:
