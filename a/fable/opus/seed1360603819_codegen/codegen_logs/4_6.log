+def _draw_corner_palettes(grid: np.ndarray, corners: dict[str, int]) -> None:
+    grid[:2, :2] = int(corners["tl"])
+    grid[:2, -2:] = int(corners["tr"])
+    grid[-2:, :2] = int(corners["bl"])
+    grid[-2:, -2:] = int(corners["br"])
+
+
+def _draw_box(
+    grid: np.ndarray,
+    r0: int,
+    c0: int,
+    r1: int,
+    c1: int,
+    gap_cells: list[tuple[int, int]],
