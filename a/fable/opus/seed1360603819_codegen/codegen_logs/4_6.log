+def _build_expected(
+    inp: np.ndarray, specs: list[dict[str, object]], corners: dict[str, int]
+) -> np.ndarray:
+    out = inp.copy()
+    h, w = out.shape
+    for spec in specs:
+        r0 = int(spec["r0"])
+        c0 = int(spec["c0"])
+        r1 = int(spec["r1"])
+        c1 = int(spec["c1"])
+        side = str(spec["side"])
+        seed_r = int(spec["seed_r"])
+        seed_c = int(spec["seed_c"])
+        seed_color = int(spec["seed_color"])
