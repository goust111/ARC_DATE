+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(int(r), int(c))]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((int(cr), int(cc)))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _corner_colors(grid: np.ndarray) -> dict[str, int]:
+    patches = {
+        "tl": grid[:2, :2],
+        "tr": grid[:2, -2:],
+        "bl": grid[-2:, :2],
+        "br": grid[-2:, -2:],
+    }
+    colors: dict[str, int] = {}
+    for key, patch in patches.items():
+        vals = np.unique(patch)
+        assert len(vals) == 1, f"corner palette {key} must be uniform"
+        colors[key] = int(vals[0])
+    return colors
+
+
+def _axis_distance(index: int, anchors: tuple[int, int]) -> int:
+    return min(abs(int(index) - int(anchor)) for anchor in anchors)
+
