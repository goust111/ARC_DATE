+def _seed_info(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int) -> tuple[int, int, int]:
+    seeds: list[tuple[int, int, int]] = []
+    for r in range(int(r0 + 1), int(r1)):
+        for c in range(int(c0 + 1), int(c1)):
