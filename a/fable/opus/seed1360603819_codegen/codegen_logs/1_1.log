+def _region_is_free(occupied: np.ndarray, r: int, c: int, h: int, w: int, pad: int) -> bool:
+    r0 = max(0, r - pad)
+    c0 = max(0, c - pad)
+    r1 = min(occupied.shape[0], r + h + pad)
+    c1 = min(occupied.shape[1], c + w + pad)
+    return not bool(occupied[r0:r1, c0:c1].any())
