+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    divider = _divider_row(g)
+    mapping = _legend_mapping(g[:divider, :])
+
+    out = g.copy()
+    lower = g[divider + 1 :, :]
+    grey_objects = []
+    for coords in _components(lower == GREY):
+        r0, c0, r1, c1 = _bbox(coords)
+        grey_objects.append(
+            {
+                "coords": coords,
+                "area": int(coords.shape[0]),
+                "bbox": (r0, c0, r1, c1),
+            }
+        )
