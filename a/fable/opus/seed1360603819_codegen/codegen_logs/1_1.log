+def _divider_row(grid: np.ndarray) -> int:
+    rows = [r for r in range(grid.shape[0]) if np.all(grid[r] == GREY)]
+    assert rows, "expected a full-width grey divider row"
+    for r in rows:
+        if np.any(grid[:r] == MAROON) and np.any(grid[r + 1 :] == GREY):
+            return int(r)
+    return int(rows[0])
