+            return anchor_top, anchor_left, top, left, side, gap, boundary
+    return None
+
+
+def _scatter_positions(
+    anchor_top: int,
+    anchor_left: int,
+    boundary: tuple[int, int],
+    direction: tuple[int, int],
+    gap: int,
+) -> list[tuple[int, int]]:
