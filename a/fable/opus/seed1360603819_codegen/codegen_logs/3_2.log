        _mark_box(blocked, r0, c0, r1, c1)

    for copy_top, copy_left in _copy_positions(square_top, square_left, side, direction, (h, w)):
        r0, c0, r1, c1 = _inflate_box(copy_top, copy_left, copy_top + side - 1, copy_left + side - 1, (h, w))
        _mark_box(blocked, r0, c0, r1, c1)

