+
+def _find_anchor_bbox(grid: np.ndarray) -> tuple[int, int, int, int]:
+    h, w = grid.shape
+    candidates: list[tuple[int, int, int, int]] = []
+    for r0 in range(h - 2):
+        for c0 in range(w - 2):
+            if np.all(grid[r0 : r0 + 3, c0 : c0 + 3] == MAGENTA):
+                candidates.append((r0, c0, r0 + 2, c0 + 2))
