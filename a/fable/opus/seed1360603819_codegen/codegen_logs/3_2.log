+    stack = [start]
+    seen = {start}
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if not _in_bounds(grid.shape, nr, nc):
+                continue
+            if (nr, nc) in seen or int(grid[nr, nc]) != color:
