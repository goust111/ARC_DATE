+    assert len(uniq) == 1, "signal ray must be uniquely determined"
+    return uniq[0]
+
+
+def _component_from(
+    grid: np.ndarray, start: tuple[int, int]
+) -> tuple[int, set[tuple[int, int]]]:
+    color = int(grid[start])
+    assert color not in (BG, MAGENTA)
