    grid: np.ndarray,
    moat: np.ndarray,
    blocked: np.ndarray,
    colors: list[int],
) -> bool:
    h, w = grid.shape
    count = random.randint(2, min(5, len(colors)))
    placed = 0
    for color in colors[:count]:
        success = False
        for _ in range(120):
            side = random.randint(2, min(4, h - 2, w - 2))
            top = random.randint(0, h - side)
            left = random.randint(0, w - side)
            if not _can_place(moat, top, left, side):
                continue
