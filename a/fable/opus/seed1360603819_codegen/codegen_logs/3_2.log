+    moat = np.zeros((h, w), dtype=bool)
+
+    total_square_colors = random.randint(3, 6)
+    colors = random.sample(NON_SIGNAL_COLORS, total_square_colors)
+    hit_color = colors[0]
+    distractor_colors = colors[1:]
