+def _paint_periodic_copies(
+    out: np.ndarray,
+    square: tuple[int, int, int, int, int],
+    direction: tuple[int, int],
+    *,
+    bg: int,
+) -> None:
+    r0, c0, r1, c1, color = square
+    dr, dc = direction
+    side = r1 - r0 + 1
+    step = side
+    k = 1
+    while True:
+        nr0 = r0 + dr * step * k
+        nc0 = c0 + dc * step * k
+        nr1 = nr0 + side - 1
+        nc1 = nc0 + side - 1
