+            anchor_left = hit_c - gap * direction[1] - boundary[1]
+            if anchor_top < 0 or anchor_left < 0 or anchor_top + 2 >= h or anchor_left + 2 >= w:
+                continue
+
+            anchor_r1 = anchor_top + 2
+            anchor_c1 = anchor_left + 2
+            if not (
+                anchor_r1 < top
