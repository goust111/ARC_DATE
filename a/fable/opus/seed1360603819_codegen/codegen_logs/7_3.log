+DIR_TO_MASK = {
+    "up": frozenset({(0, 1), (1, 0), (1, 2)}),
+    "down": frozenset({(1, 0), (1, 2), (2, 1)}),
+    "left": frozenset({(0, 1), (1, 0), (2, 1)}),
+    "right": frozenset({(0, 1), (1, 2), (2, 1)}),
