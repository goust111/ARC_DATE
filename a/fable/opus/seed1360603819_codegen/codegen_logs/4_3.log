+
+    for info in _parse_polylines(g):
+        path = info["path"]
+        branch_color = int(info["wall_color"])
+        branches: list[dict] = []
+        corner_idx = 0
+        for i in range(1, len(path) - 1):
+            in_dir = (path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1])
