+            out_dir = (path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1])
+            if in_dir != out_dir:
+                corners += 1
+        assert corners >= 2, "each polyline must contain at least two corners"
+
+        parsed.append(
+            {
+                "path": path,
+                "wall_side": wall_side,
+                "wall_color": SIDE_TO_COLOR[wall_side],
+            }
+        )
