+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append((color, np.array(coords, dtype=int)))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _prune_arrow(coords: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
