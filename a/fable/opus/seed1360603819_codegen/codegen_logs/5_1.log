 184:         if edge in HORIZONTAL_EDGES:
 185:             or0 = cr0 if edge == 'top' else cr1 - oh + 1
 186:             or1 = or0 + oh - 1
 187:             lo, hi = cc0 + 1, cc1 - ow  # avoid touching perpendicular edges
 188:         else:
 189:             oc0 = cc0 if edge == 'left' else cc1 - ow + 1
 190:             oc1 = oc0 + ow - 1
 191:             lo, hi = cr0 + 1, cr1 - oh  # avoid touching perpendicular edges
 192:         if hi < lo:
 193:             continue
 194:         v = random.randint(lo, hi)
 195:         if edge in HORIZONTAL_EDGES:
 196:             oc0, oc1 = v, v + ow - 1
 197:         else:
