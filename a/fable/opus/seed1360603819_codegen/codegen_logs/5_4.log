+    c0 = max(0, int(pts[:, 1].min()) - margin)
+    r1 = min(grid.shape[0] - 1, int(pts[:, 0].max()) + margin)
+    c1 = min(grid.shape[1] - 1, int(pts[:, 1].max()) + margin)
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
