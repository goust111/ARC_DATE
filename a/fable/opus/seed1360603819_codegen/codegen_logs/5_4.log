+    elif edge == "top":
+        r0 = 1
+        c0 = random.randint(1, w - seed_w - 2)
+        offset = random.randint(0, seed_w - 1)
+        start = (r0 + seed_h, c0 + offset)
+    else:
+        r0 = h - seed_h - 2
+        c0 = random.randint(1, w - seed_w - 2)
