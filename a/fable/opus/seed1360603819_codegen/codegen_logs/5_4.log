+def _is_simple_path(path: list[tuple[int, int]]) -> bool:
+    cells = set(path)
+    endpoints = 0
+    for r, c in path:
+        degree = sum((nr, nc) in cells for nr, nc in _neighbors4(r, c))
+        if degree == 1:
+            endpoints += 1
+        elif degree != 2:
+            return False
+    return endpoints == 2
