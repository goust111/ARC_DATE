+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+AZURE = 8
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 9)
+ORTHO = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+EDGES = ("top", "bottom", "left", "right")
