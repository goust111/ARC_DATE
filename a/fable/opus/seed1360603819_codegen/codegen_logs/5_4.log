+def _halo(cells: set[tuple[int, int]], shape: tuple[int, int]) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for nr, nc in _neighbors4(r, c):
+            if _in_bounds(shape, nr, nc) and (nr, nc) not in cells:
+                out.add((nr, nc))
+    return out
