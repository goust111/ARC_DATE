+    return border, full
+
+
+def _place_seed(h: int, w: int, seed_h: int, seed_w: int, edge: str) -> tuple[set[tuple[int, int]], tuple[int, int]]:
+    if edge == "left":
+        r0 = random.randint(1, h - seed_h - 2)
