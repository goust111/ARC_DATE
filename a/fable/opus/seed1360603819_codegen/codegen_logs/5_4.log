+def _place_frame(h: int, w: int, frame_h: int, frame_w: int, edge: str) -> tuple[set[tuple[int, int]], set[tuple[int, int]], tuple[int, int]]:
+    if edge == "left":
+        r0 = random.randint(1, h - frame_h - 2)
