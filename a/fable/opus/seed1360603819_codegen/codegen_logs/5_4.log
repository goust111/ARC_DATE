+        seed_color = None
+        frame_idx = None
+
+        for ep in endpoints:
+            r, c = ep
+            seed_neighbors = set()
+            frame_neighbors = set()
+            for nr, nc in _neighbors4(r, c):
+                if not _in_bounds(g.shape, nr, nc):
+                    continue
+                val = int(g[nr, nc])
+                if val == AZURE:
