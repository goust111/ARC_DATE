+    elif edge == "right":
+        r0 = random.randint(1, h - frame_h - 2)
+        c0 = w - frame_w - 2
+        offset = random.randint(1, frame_h - 2)
+        end = (r0 + offset, c0 - 1)
+    elif edge == "top":
+        r0 = 1
+        c0 = random.randint(1, w - frame_w - 2)
+        offset = random.randint(1, frame_w - 2)
+        end = (r0 + frame_h, c0 + offset)
+    else:
