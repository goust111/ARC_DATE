+GRID_MIN = 22
+GRID_MAX = 30
+OBJECT_COUNT_CHOICES = (2, 3, 4)
+PATCH_H_RANGE = (10, 14)
+PATCH_W_RANGE = (10, 14)
+SEED_H_RANGE = (2, 4)
+SEED_W_RANGE = (2, 4)
+FRAME_INNER_RANGE = (2, 4)
+MOTIF_ATTEMPTS = 120
+PLACEMENT_ATTEMPTS = 120
+GENERATE_ATTEMPTS = 300
