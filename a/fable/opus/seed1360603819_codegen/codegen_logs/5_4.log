+        if path is None or len(path) < 5:
+            continue
+        if not _is_simple_path(path):
+            continue
+        if any(not _in_bounds(shape, r, c) for r, c in path):
+            continue
+        if any(blocked[r, c] for r, c in path[1:-1]):
+            continue
+        if any(blocked[r, c] for r, c in (path[0], path[-1])):
+            continue
