+    best_score = -float("inf")
+    vec_norm = math.hypot(dr, dc)
+    for idx, (rr, cc) in enumerate(DIRECTIONS):
+        score = (dr * rr + dc * cc) / (vec_norm * math.hypot(rr, cc))
+        if score > best_score + 1e-12:
