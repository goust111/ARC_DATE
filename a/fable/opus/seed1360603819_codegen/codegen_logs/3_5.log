+
+
+def _sample_pattern() -> tuple[tuple[int, int], list[tuple[int, int]], list[int], dict[int, int]] | None:
+    plain_h = random.randint(*PLAIN_H_RANGE)
+    plain_w = random.randint(*PLAIN_W_RANGE)
