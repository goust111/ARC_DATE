    if place_top:
        patch[:row0, cc0:cc1] = color
    else:
        patch[row0 + patch.shape[0] - row0 - ext :, cc0:cc1] = color


def _build_object_patch(color: int, hole_count: int) -> np.ndarray | None:
    for _ in range(PATCH_RETRIES):
        core_h = random.randint(5, 8 + hole_count)
